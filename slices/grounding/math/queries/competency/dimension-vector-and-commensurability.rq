# Competency question: "What is the dimension of this quantity, and what is it
# commensurable with?"  Commensurability is DERIVED, not asserted: two quantities are
# commensurable exactly when they carry the same dimension (equal dimension vectors),
# so the query computes the commensurability class by matching math:hasDimension
# rather than reading an asserted edge. Scoped to the fixture namespace so the answer
# is exactly the two ordered pairs of the energy quantities {kineticEnergyQ ↔
# restEnergyQ}; the mass quantity has no commensurable peer and does not appear.
PREFIX math: <https://blackcatinformatics.ca/math/>

SELECT ?quantity ?dimension ?commensurate WHERE {
    ?quantity a math:Quantity ;
              math:hasDimension ?dimension .
    ?commensurate a math:Quantity ;
                  math:hasDimension ?dimension .
    FILTER(?quantity != ?commensurate)
    FILTER(STRSTARTS(STR(?quantity), "http://example.org/math/"))
}
ORDER BY ?quantity ?commensurate
