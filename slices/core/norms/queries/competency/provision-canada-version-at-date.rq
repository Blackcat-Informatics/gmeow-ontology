# Competency question: "Which version of the pinned federal definition governs on each side of
# its amendment boundary?"
#
# The two dates are the day before and the day of the amendment's material date. A version
# governs at a date when it has begun by that date and no end event dated by that date is
# recorded.

PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?asOf ?version WHERE {
    VALUES ?asOf { "2014-03-31"^^xsd:date "2014-04-01"^^xsd:date }
    ?version gmeow:versionOf <https://blackcatinformatics.ca/gmeow/examples/norms/provision-canada/actDefinition> ;
        gmeow:versionBeganBy ?began .
    ?began gmeow:eventTime ?beganAt .
    FILTER(?beganAt <= ?asOf)
    FILTER NOT EXISTS {
        ?version gmeow:versionEndedBy ?ended .
        OPTIONAL { ?ended gmeow:eventTime ?endedAt }
        FILTER(!BOUND(?endedAt) || ?endedAt <= ?asOf)
    }
}
