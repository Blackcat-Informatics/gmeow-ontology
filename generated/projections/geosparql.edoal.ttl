@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/geosparql>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:CoordinateObservation ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri geo:Geometry ;
        ] ;
        align:relation "<=" ;
        edoal:transformation [
            rdfs:seeAlso gmeow:fnLatLongToWktPoint ;
        ] ;
        rdfs:label "CoordinateObservation coordinateResult → geo:Geometry with WKT POINT"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:CoordinateObservation ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri geo:hasGeometry ;
            ] ;
            align:relation "<=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnRetagWkt ;
            ] ;
            rdfs:label "CoordinateObservation geometryResult → geo:hasGeometry with WKT"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:GeoCoordinates ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri geo:Geometry ;
            ] ;
            align:relation "<=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnLatLongToWktPoint ;
            ] ;
            rdfs:label "latitude + longitude → geo:Geometry with WKT POINT"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:Pose ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri geo:Geometry ;
            ] ;
            align:relation "<=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnPosePositionToWktPoint ;
            ] ;
            rdfs:label "pose position (lat/long) → geo:Geometry with WKT POINT"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:asGeoJSON ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri geo:asGeoJSON ;
            ] ;
            align:relation "=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnRetagGeoJson ;
            ] ;
            rdfs:label "asGeoJSON literal → geo:asGeoJSON retagged geo:geoJSONLiteral"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:asWKT ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri geo:asWKT ;
            ] ;
            align:relation "=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnRetagWkt ;
            ] ;
            rdfs:label "asWKT literal → geo:asWKT retagged geo:wktLiteral"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:coarsenTo ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri geo:Geometry ;
            ] ;
            align:relation "<=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnCoarsenToGranularityGeoJson ;
            ] ;
            rdfs:label "coarsenTo → enclosing-region GeoJSON (privacy generalization)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:coarsenTo ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri geo:Geometry ;
            ] ;
            align:relation "<=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnCoarsenToGranularity ;
            ] ;
            rdfs:label "coarsenTo → enclosing-region WKT POINT (privacy generalization)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:coarsenTo ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri geo:Geometry ;
            ] ;
            align:relation "<=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnCoarsenToGranularity ;
            ] ;
            rdfs:label "coarsenTo → enclosing-region WKT geometry (privacy generalization)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasCentroid ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri geo:hasCentroid ;
            ] ;
            align:relation "=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnRetagWkt ;
            ] ;
            rdfs:label "hasCentroid geometry → geo:hasCentroid with WKT"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "geosparql" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → geosparql (EDOAL)"@en .
