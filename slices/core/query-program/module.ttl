@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:QueryProgramGraph
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Program Graph"@x-gmeow-english ;
    skos:definition "A finite, explicitly bounded graph describing a consumer-owned query operation and its nodes. Its declaration requests no native execution."@x-gmeow-english ;
    gmeow:useWhen "Use for query program graph with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:QueryProgramGraph ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:QueryProgramNode
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Program Node"@x-gmeow-english ;
    skos:definition "One operation description in a query graph, with explicit effect classification and dependency stratum. It is not an execution occurrence."@x-gmeow-english ;
    gmeow:useWhen "Use for query program node with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:QueryProgramNode ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:RankedQueryList
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Ranked Query List"@x-gmeow-english ;
    skos:definition "An attributed query answer carrying source-ranked candidate entries. Ranks are the source-supplied positive integers; equal ranks remain tied and are never renumbered by serialization order."@x-gmeow-english ;
    gmeow:useWhen "Use for ranked query list with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:RankedQueryList ."@x-gmeow-english ;
    logic:subClassOf gmeow:QueryAnswer .

gmeow:RankedQueryEntry
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Ranked Query Entry"@x-gmeow-english ;
    skos:definition "One candidate occurrence in one ranked list, retaining its rank and a unique source-scoped tie key. Repeated candidate identities within a list are forbidden."@x-gmeow-english ;
    gmeow:useWhen "Use for ranked query entry with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:RankedQueryEntry ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:ReciprocalRankFusion
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Fixed-Point Reciprocal Rank Fusion"@x-gmeow-english ;
    skos:definition "A query-node description combining selected ranked lists by integer-quantized reciprocal ranks, preserving every per-list contribution. Quantization rounds down before summation."@x-gmeow-english ;
    gmeow:useWhen "Use for fixed-point reciprocal rank fusion with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:ReciprocalRankFusion ."@x-gmeow-english ;
    logic:subClassOf gmeow:QueryProgramNode .

gmeow:FusionContribution
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Fusion Contribution"@x-gmeow-english ;
    skos:definition "The nonnegative integer contribution of exactly one selected ranked entry to one fusion occurrence. It is a retrieval score, never epistemic confidence."@x-gmeow-english ;
    gmeow:useWhen "Use for query fusion contribution with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:FusionContribution ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:QueryFusionScore
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Fusion Score"@x-gmeow-english ;
    skos:definition "A candidate score for one fusion, with a finite complete fold over that candidate’s contributions. Equal scores remain tied."@x-gmeow-english ;
    gmeow:useWhen "Use for query fusion score with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:QueryFusionScore ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:QueryScoreFoldStep
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Score Fold Step"@x-gmeow-english ;
    skos:definition "A numbered partial sum within one candidate score. Step zero is zero; each successor adds exactly one previously unused contribution."@x-gmeow-english ;
    gmeow:useWhen "Use for query score fold step with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:QueryScoreFoldStep ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:QueryLedgerMerge
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Ledger Merge"@x-gmeow-english ;
    skos:definition "A query-node description taking the identity-preserving union of candidates and loss records from selected answers. It does not repair or waive any loss."@x-gmeow-english ;
    gmeow:useWhen "Use for query ledger merge with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:QueryLedgerMerge ."@x-gmeow-english ;
    logic:subClassOf gmeow:QueryProgramNode .

gmeow:QueryVerdictChoice
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Verdict Choice"@x-gmeow-english ;
    skos:definition "A query-node description comparing a bound answer-axis value with an expected value. Missing or unknown values select an explicit unknown branch."@x-gmeow-english ;
    gmeow:useWhen "Use for query verdict choice with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:QueryVerdictChoice ."@x-gmeow-english ;
    logic:subClassOf gmeow:QueryProgramNode .

gmeow:QueryNodeExecution
    a logic:Event , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Node Execution"@x-gmeow-english ;
    skos:definition "A consumer-reported occurrence of executing a query node. Selected branches and measured iteration outcomes belong to occurrences, not reusable operation descriptions."@x-gmeow-english ;
    gmeow:useWhen "Use for query node execution with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:QueryNodeExecution ."@x-gmeow-english ;
    logic:subClassOf gmeow:Activity .

gmeow:ConvergentQueryIteration
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Convergent Query Iteration"@x-gmeow-english ;
    skos:definition "A query-node description of finite monotone set expansion to equality, under a stratified feedback contract. The body is a pure query node; convergence is separate from a budget stop."@x-gmeow-english ;
    gmeow:useWhen "Use for convergent query iteration with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:ConvergentQueryIteration ."@x-gmeow-english ;
    logic:subClassOf gmeow:QueryProgramNode .

gmeow:QueryIterationState
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Iteration State"@x-gmeow-english ;
    skos:definition "A finite candidate set after a measured number of body executions in one iteration run. State zero is the seed before any body execution."@x-gmeow-english ;
    gmeow:useWhen "Use for query iteration state with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:QueryIterationState ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:SparqlSelectionLeaf
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "SPARQL Selection Leaf"@x-gmeow-english ;
    skos:definition "A query node describing a well-formed SPARQL SELECT over a declared dataset and context, with explicit input and output descriptors. It authorizes no update or external effect."@x-gmeow-english ;
    gmeow:useWhen "Use for sparql selection leaf with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record a gmeow:SparqlSelectionLeaf ."@x-gmeow-english ;
    logic:subClassOf gmeow:QueryProgramNode .

gmeow:queryGraphNode
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query graph node"@x-gmeow-english ;
    skos:definition "A node explicitly inside this finite graph. Membership bounds every dependency and sink obligation."@x-gmeow-english ;
    gmeow:useWhen "Use for query graph node with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record gmeow:queryGraphNode ex:value ."@x-gmeow-english ;
    logic:domain gmeow:QueryProgramGraph ;
    logic:range gmeow:QueryProgramNode .

gmeow:queryGraphEdge
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query graph edge"@x-gmeow-english ;
    skos:definition "A reified dataflow edge in this graph; flowFrom is producer and flowTo is consumer."@x-gmeow-english ;
    gmeow:useWhen "Use for query graph edge with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record gmeow:queryGraphEdge ex:value ."@x-gmeow-english ;
    logic:domain gmeow:QueryProgramGraph ;
    logic:range logic:DataFlowEdge .

gmeow:queryNodeEffectful
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query node has effects"@x-gmeow-english ;
    skos:definition "Explicit classification of whether the node performs external effects. False is required evidence of purity, not a default."@x-gmeow-english ;
    gmeow:useWhen "Use for query node has effects with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "Explicit classification of whether the node performs external effects. False is required evidence of purity, not a default. Example declaration: gmeow:queryNodeEffectful rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ."@x-gmeow-english ;
    logic:domain gmeow:QueryProgramNode ;
    logic:range xsd:boolean .

gmeow:queryGraphSink
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query graph sink"@x-gmeow-english ;
    skos:definition "A designated terminal node of this graph. Several sinks are allowed; every effectful node must be one."@x-gmeow-english ;
    gmeow:useWhen "Use for query graph sink with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record gmeow:queryGraphSink ex:value ."@x-gmeow-english ;
    logic:domain gmeow:QueryProgramGraph ;
    logic:range gmeow:QueryProgramNode .

gmeow:queryNodeStratum
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query node stratum"@x-gmeow-english ;
    skos:definition "The nonnegative dependency stratum of this node within its graph. Strata are not time or execution order."@x-gmeow-english ;
    gmeow:useWhen "Use for query node stratum with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "The nonnegative dependency stratum of this node within its graph. Strata are not time or execution order. Example declaration: gmeow:queryNodeStratum rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ."@x-gmeow-english ;
    logic:domain gmeow:QueryProgramNode ;
    logic:range xsd:nonNegativeInteger .

gmeow:queryEdgeMonotone
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query edge is monotone"@x-gmeow-english ;
    skos:definition "True identifies positive monotone dataflow; false identifies a negative or nonmonotone dependency requiring a strictly lower producer stratum."@x-gmeow-english ;
    gmeow:useWhen "Use for query edge is monotone with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "True identifies positive monotone dataflow; false identifies a negative or nonmonotone dependency requiring a strictly lower producer stratum. Example declaration: gmeow:queryEdgeMonotone rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ."@x-gmeow-english ;
    logic:domain logic:DataFlowEdge ;
    logic:range xsd:boolean .

gmeow:queryCandidate
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query answer candidate"@x-gmeow-english ;
    skos:definition "A candidate identity retained by an answer, state or declared finite universe. Membership does not assert truth or confidence."@x-gmeow-english ;
    gmeow:useWhen "Use for query answer candidate with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record gmeow:queryCandidate ex:value ."@x-gmeow-english ;
    logic:range logic:Thing .

gmeow:rankedQueryEntry
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "ranked query entry"@x-gmeow-english ;
    skos:definition "An entry in this ranked list; each candidate occurs at most once in the list."@x-gmeow-english ;
    gmeow:useWhen "Use for ranked query entry with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record gmeow:rankedQueryEntry ex:value ."@x-gmeow-english ;
    logic:domain gmeow:RankedQueryList ;
    logic:range gmeow:RankedQueryEntry .

gmeow:rankedEntryCandidate
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "ranked entry candidate"@x-gmeow-english ;
    skos:definition "The exact candidate identified by a ranked entry."@x-gmeow-english ;
    gmeow:useWhen "Use for ranked entry candidate with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record gmeow:rankedEntryCandidate ex:value ."@x-gmeow-english ;
    logic:domain gmeow:RankedQueryEntry ;
    logic:range logic:Thing .

gmeow:queryInputRank
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query input rank"@x-gmeow-english ;
    skos:definition "The source-supplied positive rank used unchanged in reciprocal fusion. Equal ranks remain tied; omitted earlier rows do not renumber retained ranks."@x-gmeow-english ;
    gmeow:useWhen "Use for query input rank with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "The source-supplied positive rank used unchanged in reciprocal fusion. Equal ranks remain tied; omitted earlier rows do not renumber retained ranks. Example declaration: gmeow:queryInputRank rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ."@x-gmeow-english ;
    logic:domain gmeow:RankedQueryEntry ;
    logic:range xsd:positiveInteger .

gmeow:queryTieKey
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query tie ordering key"@x-gmeow-english ;
    skos:definition "A unique source-supplied string within its input list; codepoint order supplies deterministic ordering only among equal ranks. It is not a global candidate key."@x-gmeow-english ;
    gmeow:useWhen "Use for query tie ordering key with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "A unique source-supplied string within its input list; codepoint order supplies deterministic ordering only among equal ranks. It is not a global candidate key. Example declaration: gmeow:queryTieKey rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ."@x-gmeow-english ;
    logic:domain gmeow:RankedQueryEntry ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:string xsd:token ) ] .

gmeow:fusionInput
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query fusion input"@x-gmeow-english ;
    skos:definition "One selected ranked-list occurrence; an unavailable family is a loss, not an invented empty input."@x-gmeow-english ;
    gmeow:useWhen "Use for query fusion input with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record gmeow:fusionInput ex:value ."@x-gmeow-english ;
    logic:domain gmeow:ReciprocalRankFusion ;
