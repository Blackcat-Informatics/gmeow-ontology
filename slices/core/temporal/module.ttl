gmeow:timeScaleUT1
    a gmeow:TimeScale ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    rdfs:label "Universal Time 1 (UT1)"@x-gmeow-english ;
    skos:definition "Earth-rotation-based time scale; the basis for civil-time solar alignment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:timeScaleUTC
    a gmeow:TimeScale ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    rdfs:label "Coordinated Universal Time (UTC)"@x-gmeow-english ;
    skos:definition "Civil atomic time scale with leap seconds."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:validFrom
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    rdfs:label "valid from"@x-gmeow-english ;
    rdfs:range xsd:dateTime ;
    skos:definition "The instant from which the annotated statement is asserted to hold."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernStandpoints ,
        gmeow:concernStatementMetadata ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:validUntil
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    rdfs:label "valid until"@x-gmeow-english ;
    rdfs:range xsd:dateTime ;
    skos:definition "The instant until which the annotated statement is asserted to hold."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernDisclosure ,
        gmeow:concernStandpoints ,
        gmeow:concernStatementMetadata ;
    gmeow:graphBoxRole gmeow:boxRBox .

<https://blackcatinformatics.ca/gmeow/slices/temporal>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "Cross-cutting temporal facility (the OWL-Time superset layer): time intervals, instants, temporal reference frames, named periods, temporal measurements, and reified time-scoped relations, reused by every slice for facts that hold over a period (mailbox residence, address/role tenure, etc.). Lighter cases use the validFrom/validUntil RDF-star annotation properties."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    rdfs:label "GMEOW Temporal Module"@x-gmeow-english ;
    skos:definition "The GMEOW Temporal Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Declarative constraint axioms (core slices) — the closed-world
# cardinality / class / datatype obligations the hand-authored shapes.ttl
# NodeShapes state, authored here once as OWL restriction axioms and PROJECTED
# to generated/shapes/validation-shapes.ttl by derive_validation_shapes
# (Principle 17). A restriction carrying both owl:*Cardinality and
# owl:allValuesFrom lowers to the paired sh:minCount/maxCount + sh:class /
# sh:datatype property shape. The cross-node / value-range / disjunctive
# (sh:sparql, sh:or, numeric range, node-shape) conditions have no OWL
# antecedent and remain the procedural fragment .
# =========================================================================== #

gmeow:TemporalFrame rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:frameTimeScale ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:TimeScale ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:frameRealm ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:FrameRealm ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:frameKind ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:FrameKind ] .

# Closed-world cardinality axiom backing the hand-authored core observation
# method well-formedness shape (a temporal measurement records exactly one method).
gmeow:TemporalMeasurement rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:observationMethod ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:ObservationMethod ] .

# exact-one minCount restoration: min-qualified sibling restrictions
# restoring sh:minCount for the reasoner-safe max-qualified exact-one antecedents.
<https://blackcatinformatics.ca/gmeow/TemporalMeasurement> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/observationMethod> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/gmeow/ObservationMethod> ] .
<https://blackcatinformatics.ca/gmeow/TemporalFrame> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/frameTimeScale> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/gmeow/TimeScale> ] .
<https://blackcatinformatics.ca/gmeow/TemporalFrame> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/frameRealm> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/gmeow/FrameRealm> ] .
<https://blackcatinformatics.ca/gmeow/TemporalFrame> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/frameKind> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/gmeow/FrameKind> ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/TemporalMeasurement> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/observationMethod> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/DatingMethod> ] .
<https://blackcatinformatics.ca/gmeow/TemporalMeasurement> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/observedFeature> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/TemporalMeasurement> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/vantage> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/TemporalMeasurement> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/observationMethod" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/TemporalMeasurement> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/observedFeature" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/TemporalMeasurement> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/vantage" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .

# --- Wave B1 shape-drain: temporal-measurement cardinality + date/age disjunction ---
# gmeow:TemporalMeasurementShape — exactly one observed feature and one dating method (a
# gmeow:DatingMethod); at least one vantage (rides the migrated existence closure).
gmeow:TemporalMeasurement logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:observedFeature ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:observationMethod ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:DatingMethod ] .

# A TemporalMeasurement carries either a gmeow:measuredAge or a gmeow:measuredDate (or both) —
# the disjunctive-requiredness image of the retired gmeow:TemporalMeasurementShape node-level sh:or.
gmeow:TemporalMeasurementDateOrAgeConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Temporal measurement date-or-age constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:TemporalMeasurement has gmeow:measuredAge (a decimal) or gmeow:measuredDate (a gmeow:Instant), or both; the value-kind of each alternative rides the property range axioms."@x-gmeow-english ;
    logic:formalizes gmeow:TemporalMeasurementShape ;
    logic:onClass gmeow:TemporalMeasurement ;
    logic:anyOf gmeow:measuredAge , gmeow:measuredDate ;
    logic:message "A TemporalMeasurement must have either gmeow:measuredAge or gmeow:measuredDate (or both)." .

# gmeow:CoreObservationMethodShape / gmeow:TemporalMeasurementShape exactly-one method: the plain
# sh:maxCount 1 (owl:onClass owl:Thing degrades to it) alongside the DatingMethod-qualified bound.
gmeow:TemporalMeasurement logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:observationMethod ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] .

# gmeow:CoreObservationMethodShape target gmeow:TemporalMeasurement: its method is also an
# gmeow:ObservationMethod (gmeow:DatingMethod ⊑ gmeow:ObservationMethod), so the value-class the
# core-observation shape requires is carried alongside the finer DatingMethod bound.
gmeow:TemporalMeasurement logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:observationMethod ; logic:allValuesFrom gmeow:ObservationMethod ] .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:duringIntervalFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    rdfs:label "duringInterval is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:duringInterval is functional: a gmeow:TimeScopedRelation is delimited by exactly one gmeow:TimeInterval, since a relation true across two disjoint spans is two distinct scoped situations rather than one situation bearing two scopes."@x-gmeow-english ;
    logic:characterizes gmeow:duringInterval ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:duringInterval ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:duringInterval names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:duringInterval, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:duringIntervalFunctionality logic:characterizes gmeow:duringInterval ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:edtfValueFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    rdfs:label "edtfValue is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:edtfValue is functional: an instant or interval has at most one EDTF expression of its own value, since a second EDTF string would state a competing value for the same point rather than an alternate label for it."@x-gmeow-english ;
    logic:characterizes gmeow:edtfValue ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:edtfValue ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:edtfValue names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:edtfValue, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:edtfValueFunctionality logic:characterizes gmeow:edtfValue ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:endedAtTimeFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    rdfs:label "endedAtTime is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:endedAtTime is functional: a gmeow:TimeInterval closes at a single instant, since two distinct end timestamps would describe two different intervals and an open interval omits the value entirely rather than carrying several."@x-gmeow-english ;
    logic:characterizes gmeow:endedAtTime ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:endedAtTime ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:endedAtTime names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:endedAtTime, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:endedAtTimeFunctionality logic:characterizes gmeow:endedAtTime ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:frameCalendarSystemFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    rdfs:label "frameCalendarSystem is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:frameCalendarSystem is functional: a gmeow:TemporalFrame reckons its dates in at most one gmeow:CalendarSystem, since a frame that mixed Gregorian and Hebrew reckoning would be two frames rather than one (the property is optional for scale-only frames but never multi-valued)."@x-gmeow-english ;
    logic:characterizes gmeow:frameCalendarSystem ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:frameCalendarSystem ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:frameCalendarSystem names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:frameCalendarSystem, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:frameCalendarSystemFunctionality logic:characterizes gmeow:frameCalendarSystem ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:frameReferencePositionFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    rdfs:label "frameReferencePosition is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:frameReferencePosition is functional: a gmeow:TemporalFrame is anchored to at most one gmeow:ReferencePosition, since a single frame cannot fix its time to two timezones or observatories at once, so a second locus makes a second frame (the property is optional for position-independent frames but never multi-valued)."@x-gmeow-english ;
    logic:characterizes gmeow:frameReferencePosition ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:frameReferencePosition ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:frameReferencePosition names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
