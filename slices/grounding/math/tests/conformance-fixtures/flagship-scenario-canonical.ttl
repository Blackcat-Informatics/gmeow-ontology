#
# Well-formed: a gmeow:FlagshipScenario binding all realizing/enforcing artifacts —
# a worked example, a competency question, a producer, a counter-example, and an enforcing
# failure class that IS a math:MathConformanceFailure subclass (math:WrongE8WeylOrder,
# resolved against module.ttl). Passes the math: slice's thin math:FlagshipScenarioShape
# (its failure-range sh:sparql) and the shared gmeow:FlagshipScenarioShape's cardinalities,
# so it validates with no findings.
# Bound by ex:ecFlagshipCanonical.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:wiredScenario a math:FlagshipScenario ;
    gmeow:demonstratedByExample "examples/e8-symmetry.ttl" ;
    gmeow:demonstratedByCompetency <https://blackcatinformatics.ca/gmeow/examples/math/tests/cqE8RootSystem> ;
    gmeow:demonstratedByProducer "math::producers::e8_weyl_order" ;
    gmeow:guardedByCounterExample "tests/counter-examples/e8-wrong-weyl-order.ttl" ;
    gmeow:enforcesFailureClass math:WrongE8WeylOrder .
