# Which tags appear through acts eligible for display under the supplied flags?
# The off-topic act is retained and withheld under its explicit flag.
# Both coequal Jaguar acts appear with their shared applicability interval.
# The gmeow:cqDataFile overlay supplies this scene to the asserted lane.

PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX ex:    <https://blackcatinformatics.ca/gmeow/examples/tags/>

SELECT ?tag WHERE {
    ?act a gmeow:Tagging ;
        gmeow:taggingTagged ex:photo ;
        gmeow:taggingTag    ?tag .
    FILTER NOT EXISTS { ?act gmeow:displayable false }
}
ORDER BY ?tag
