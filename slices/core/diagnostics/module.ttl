@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:DiagnosticSeverity
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Diagnostic Severity"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The grade of a diagnostic — an open value vocabulary spanning error (gate-failing), warning, note, and info: gmeow:severityError, gmeow:severityWarning, gmeow:severityNote, gmeow:severityInfo. Members are individuals, never subclasses (Principle 9); deployments add grades without schema change. Mirrors the SARIF level and the Rust gmeow_diagnostics::Severity enum."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingSeverity gmeow:severityError ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid subclassing it to add a grade (the members are individuals) and avoid conflating the grade with the rule code (gmeow:findingCode) or the human message (gmeow:findingMessage)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded DiagnosticSeverity individuals from a gmeow:Finding via gmeow:findingSeverity; map them to SARIF levels (error→error, warning→warning, note/info→note) in the projection layer, not by axiom."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary for a finding's verdict grade — the closed-by-convention set (error, warning, note, info) a gmeow:Finding declares through gmeow:findingSeverity."@x-gmeow-english .

gmeow:Finding
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Finding"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:findingSeverity ;
            owl:someValuesFrom gmeow:DiagnosticSeverity ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:findingCode ;
            owl:someValuesFrom xsd:string ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:findingMessage ;
            owl:someValuesFrom xsd:string ;
        ] ;
    skos:definition "A single diagnostic — a validation violation, lint warning, reasoning divergence, or external-tool failure — modelled as a specialization of gmeow:Observation, the universal claim construct. The producing tool is the gmeow:vantage (no diagnostic is privileged; a finding is one tool's perspectival claim, Principle 9), the offending statement or construct is the gmeow:observedFeature (reached via gmeow:findingLocation), and the verdict is a gmeow:DiagnosticSeverity reached via gmeow:findingSeverity. A Finding is the gmeow: RDF projection of one Rust gmeow_diagnostics::Finding; it is never the canonical source (that stays in Rust so it can report on an unparsable graph), only one projection beside SARIF, JSON, HTML, and CLI."@x-gmeow-english ;
    skos:example "ex:f1 a gmeow:Finding ; gmeow:findingSeverity gmeow:severityError ; gmeow:findingCode \"shacl.MinCount\" ; gmeow:vantage ex:shaclTool ."@x-gmeow-english ;
    skos:scopeNote "Finding ⊑ Observation is a real rdfs:subClassOf bridge (unlike the content-mode siblings elsewhere): a diagnostic genuinely IS an observation, so it inherits the vantage / observedFeature / observationResult roles and the EL mediation restrictions. logic:violation and the native↔oracle divergence-ledger entries are restricted Findings; the alignment cell records the equivalence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring Findings by hand as the source of truth — they are a projection of the Rust report, regenerated, never edited — and avoid using a Finding where a plain SARIF/CLI message suffices and no RDF query over diagnostics is needed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Project one Finding per Rust gmeow_diagnostics::Finding: bind gmeow:findingSeverity, gmeow:findingCode, gmeow:findingMessage, the producing tool via gmeow:vantage (and gmeow:findingTool for the flat name), and gmeow:findingLocation at the reified statement, hanging the GTS wire coordinates on the location node."@x-gmeow-english ;
    gmeow:useWhen "Use to record a diagnostic as a first-class, queryable RDF claim — when a validation/lint/reasoning verdict should ride in the graph (e.g. embedded in a .gts feedback bundle) so it can be joined against the ontology it describes."@x-gmeow-english .

gmeow:ValidationRule
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Validation Rule"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "A single enforced check the validator runs — the catalog entry a gmeow:Finding resolves to through its shared code. Where gmeow:Finding is one occurrence (a violation at a location), a ValidationRule is the standing definition: the code, the kind (gmeow:ruleCategory over the same logic:FindingCategory axis a finding carries), the default grade (gmeow:ruleSeverity), the SHACL shape it projects to (gmeow:enforcedByShape), the terms it governs (gmeow:appliesToTerm), and the prose it encodes (logic:formalizes, from which its skos:definition is generated). The rule definitions are the gmeow: RDF projection of the Rust validator's rule surface; individuals are generated from the reasoned graph, never authored by hand, so 'what GMEOW enforces' stays a projection of the axioms rather than a maintained list."@x-gmeow-english ;
    skos:example "ex:ruleRelatorMediation a gmeow:ValidationRule ; gmeow:ruleCode \"discipline/relator-mediation\" ; gmeow:ruleCategory logic:FindingModelingDisciplineViolation ; gmeow:ruleSeverity \"binding\" ."@x-gmeow-english ;
    skos:scopeNote "The enforced-check sibling of gmeow:Finding: they share the code space (a finding's gmeow:findingCode equals its rule's gmeow:ruleCode), but a ValidationRule is an InformationObject describing the check, not a gmeow:Observation about a datum. Distinct rule and finding properties keep the domains clean — asserting a finding property on a rule would wrongly entail the rule is an Observation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring ValidationRule individuals by hand as the source of truth — they are generated from the reasoned graph and the validator's rule surface — and avoid using one where a plain gmeow:Finding (one occurrence) is meant; the rule is the standing definition, the finding is the event."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Read it as the resolution target of a finding code: from a gmeow:Finding take gmeow:findingCode, look up the gmeow:ValidationRule with the equal gmeow:ruleCode, and surface its generated skos:definition, gmeow:enforcedByShape, gmeow:appliesToTerm, and logic:formalizes prose as 'what this code enforces'."@x-gmeow-english ;
    gmeow:useWhen "Use to record the definition of an enforced check as a first-class, queryable RDF entity — the machine-readable constraint catalog that lets a validator finding code resolve to what it enforces, which terms it governs, and the prose it formalizes."@x-gmeow-english .

gmeow:appliesToTerm
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "applies to term"@x-gmeow-english ;
    skos:definition "A bridge annotation from a gmeow:ValidationRule to a gmeow:/logic: term the rule governs: the class, property, or individual whose data or modelling the check constrains. Subject is a ValidationRule, object a governed term; an annotation property, never a reasoned axiom, so it carries no DL or EL profile weight and does not constrain the term. The catalog generator resolves the governed terms from the reasoned graph (the disjointness members, the mediated relator, the frame-carrier class), so a reader can ask 'which rules touch this term'."@x-gmeow-english ;
    skos:example "ex:ruleRelatorMediation gmeow:appliesToTerm gmeow:Commitment ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it to CONSTRAIN a term (that is the enforced shape or axiom, reached via gmeow:enforcedByShape / logic:formalizes) or to point at a datum occurrence (that is a finding's gmeow:findingLocation); appliesToTerm names the governed vocabulary, not the enforcement or the violation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point a ValidationRule at each gmeow:/logic: term it governs, as generated from the reasoned graph; render the reverse direction as 'rules that enforce something about this term' in the term's documentation."@x-gmeow-english ;
    gmeow:useWhen "Use to link an enforced check to the terms it governs so the constraint catalog can be read per-term as well as per-rule."@x-gmeow-english .

gmeow:enforcedByShape
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "enforced by shape"@x-gmeow-english ;
    skos:definition "A bridge annotation from a gmeow:ValidationRule to the SHACL sh:NodeShape or constraint component that operationalises it at validation time. Per Principle 17 the SHACL shape is a generated, lossy PROJECTION of the canonical logic: axiom (reached via logic:formalizes) — enforcedByShape names that projection, not the source, so a reader can jump from a finding code to the exact shape that fired. An annotation property crossing into the SHACL artifact; it carries no DL or EL weight."@x-gmeow-english ;
    skos:example "ex:ruleFrameCompleteness gmeow:enforcedByShape <https://blackcatinformatics.ca/gmeow/EventFrameRequirementShape> ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the shape as the source of the rule (the source is the logic: axiom via logic:formalizes; SHACL is its projection, Principle 17) and avoid pointing it at a term (that is gmeow:appliesToTerm); enforcedByShape names the enforcing projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point a ValidationRule at the generated SHACL shape/component that fires for its code, as resolved by the catalog generator; render it as the 'enforced by' link beside the logic: source."@x-gmeow-english ;
    gmeow:useWhen "Use to link an enforced check to the SHACL shape that realises it, so a finding code resolves to both its canonical logic: source and its concrete enforcing projection."@x-gmeow-english .

gmeow:findingCategory
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding category"@x-gmeow-english ;
    rdfs:range logic:FindingCategory ;
    skos:definition "The KIND of a finding — a logic:FindingCategory individual, an axis ORTHOGONAL to gmeow:findingSeverity, because not all findings are failures. Severity grades how loud; category names what kind: a data-shape violation, a modeling-discipline violation, a forbidden contradiction witness, a permitted (disclosed, coherent) epistemic conflict, an unsupported semantic feature, an incomplete check, a projection loss, or a policy warning. The gmeow: RDF projection of the Rust gmeow_diagnostics::FindingCategory; absent when a finding falls outside the taxonomy."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingCategory logic:FindingPermittedEpistemicConflict ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating it with gmeow:findingSeverity (a permitted epistemic conflict is category logic:FindingPermittedEpistemicConflict yet non-error severity) or with the rule code; the category is the orthogonal KIND, not the grade or the rule identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project the Rust finding's category as one logic:FindingCategory individual; consumers read it beside gmeow:findingSeverity to tell a disclosed, coherent conflict from a failing contradiction."@x-gmeow-english ;
    gmeow:useWhen "Use to record the KIND of a finding so a consumer can separate genuine failures from coherent-but-noteworthy findings — chiefly a permitted, disclosed contradiction under a glut-admitting reasoning contract."@x-gmeow-english .

gmeow:findingCode
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding code"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The stable rule identifier of a finding (e.g. \"shacl.MinCountConstraintComponent\", \"validate.error\") — the SARIF ruleId and the key by which findings are grouped and suppressed. Short and stable across runs."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingCode \"shacl.MinCount\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid putting the human message here (use gmeow:findingMessage) and avoid run-varying values; the code is the stable rule key."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set it to the Rust finding's code verbatim; it becomes the SARIF ruleId and participates in the partial-fingerprint dedup."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the stable rule code of a finding so consumers can group, route, and suppress by rule."@x-gmeow-english .

gmeow:findingHelpUri
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding help URI"@x-gmeow-english ;
    rdfs:range xsd:anyURI ;
    skos:definition "The help link for a finding's rule — the URI a reader follows to learn how to resolve or act on the diagnostic. The gmeow: RDF projection of the Rust rule's help_uri (gmeow_diagnostics::Rule.help_uri), the same link SARIF carries as the rule-level helpUri and the LSP diagnostic carries as codeDescription. Advisory (Severity::Note/Info) findings of the soft tier carry it most, pointing at the modeling guidance behind a recommendation."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingHelpUri \"https://blackcatinformatics.ca/gmeow/advice#sample\"^^xsd:anyURI ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid duplicating the human message here (use gmeow:findingMessage) and avoid run-varying values; the help URI is the stable, rule-level pointer to remediation guidance, not occurrence prose."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project it from the Rust rule's help_uri verbatim; render it as the SARIF rule helpUri and the LSP codeDescription.href so every surface offers the same 'learn more' link for the rule."@x-gmeow-english ;
    gmeow:useWhen "Use to carry a finding's 'learn more' link — chiefly on advisory findings whose deonticRecommendation points at modeling guidance."@x-gmeow-english .

gmeow:findingLocation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding location"@x-gmeow-english ;
    rdfs:subPropertyOf gmeow:observedFeature ;
    skos:definition "The statement or construct a finding concerns — its observed feature. A subproperty of gmeow:observedFeature, so a finding's location IS what its observation is about. The range is left intentionally open (like gmeow:observedFeature): the value is typically a reified RDF 1.2 statement (rdf:reifies <<( s p o )>>) whose node carries the GTS wire coordinates, but it may be any term, so no range is asserted in the core."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingLocation ex:stmt1 ."@x-gmeow-english ;
    skos:scopeNote "The location node is the natural carrier of the gmeow:gts* wire coordinates: hang gmeow:gtsQuadIndex / gmeow:gtsTermId / gmeow:gtsReifierId / gmeow:gtsFrameIndex / gmeow:gtsSegmentIndex on the reifier the finding points at, so a consumer resolves the diagnostic to an exact position inside the bundle, matching the SARIF logicalLocations of the same finding."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid constraining its range in the core (per-kind narrowing is SHACL's job) and avoid using it for the verdict (that is gmeow:findingSeverity); the location is WHAT the finding is about."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the Finding at the reified statement it concerns and hang the gmeow:gts* coordinates on that node; read it by inheritance through gmeow:observedFeature for generic 'all observations about this statement' queries."@x-gmeow-english ;
    gmeow:useWhen "Use to anchor a gmeow:Finding to the statement or term it diagnoses — typically the reified RDF 1.2 statement carrying the GTS wire coordinates."@x-gmeow-english .

gmeow:findingMessage
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding message"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The human-readable message of a finding — the one-line description shown in CLI, SARIF, and HTML. Distinct from gmeow:findingCode (the stable rule key): the message explains this occurrence, the code names the rule."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingMessage \"missing required skos:definition\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid overloading it with the rule key (use gmeow:findingCode) or the location text; the message is prose about this occurrence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set it to the Rust finding's message verbatim; render it as the SARIF result message text."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the human-readable explanation of a finding for display surfaces."@x-gmeow-english .

gmeow:findingSeverity
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding severity"@x-gmeow-english ;
    rdfs:range gmeow:DiagnosticSeverity ;
    rdfs:subPropertyOf gmeow:observationResult ;
    skos:definition "The verdict grade of a finding — a gmeow:DiagnosticSeverity individual. A subproperty of gmeow:observationResult: a finding's severity IS its observation result (the value the diagnostic observation produced), so generic observation-result consumers read it by inheritance."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingSeverity gmeow:severityWarning ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at anything outside the gmeow:DiagnosticSeverity vocabulary and avoid using it for the rule code or message; the result is the grade, not the identity of the rule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Bind one DiagnosticSeverity individual per Finding; read it by inheritance through gmeow:observationResult for cross-slice 'what did this observation conclude' queries."@x-gmeow-english ;
    gmeow:useWhen "Use to grade a gmeow:Finding — pointing it at exactly one gmeow:DiagnosticSeverity so SARIF level, CLI colour, and gate pass/fail all derive from one value."@x-gmeow-english .

gmeow:findingSuggestion
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding suggestion"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "A remediation suggestion attached to a finding — one line of advice on how to act on the diagnostic. A finding may carry several (each a distinct gmeow:findingSuggestion triple), rendered as a list in CLI/HTML, SARIF result properties, and the LSP message. The gmeow: RDF projection of the Rust gmeow_diagnostics::Finding.suggestions, sorted and deduplicated at normalization so the projection is deterministic. The advisory (Severity::Note/Info) soft tier carries these as its 'consider this instead' prose."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingSuggestion \"use gmeow:Kind for rigid sortals\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid overloading it with the verdict (that is gmeow:findingSeverity) or the rule key (gmeow:findingCode); a suggestion is actionable advice about this occurrence, not the finding's identity or grade."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project each Rust suggestion string as one gmeow:findingSuggestion in normalized (sorted, deduplicated) order; render the set as a suggestion list in CLI/HTML and as the SARIF result property gmeow.suggestions."@x-gmeow-english ;
    gmeow:useWhen "Use to carry one or more remediation suggestions on a finding — chiefly advisory findings recommending a better modeling choice."@x-gmeow-english .

gmeow:findingTool
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding tool"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The short name of the tool that produced a finding (e.g. \"shacl\", \"validate\", \"clippy\") — the flat 80% provenance surface. The richer provenance is gmeow:wasGeneratedBy a gmeow:ToolCall whose gmeow:usedTool is the validator agent (the agentic idiom, Principle 5); gmeow:findingTool is the cheap denormalized name, and the tool agent is also the finding's gmeow:vantage."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingTool \"shacl\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating it as the full provenance — the auditable record is the gmeow:ToolCall the finding gmeow:wasGeneratedBy — and avoid drift from the tool's gmeow:vantage agent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set it to the Rust finding's tool name; for full provenance also mint a gmeow:ToolCall and link the finding back with gmeow:wasGeneratedBy."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the producing tool's short name on a finding for cheap filtering and SARIF driver attribution."@x-gmeow-english .

gmeow:gtsFrameIndex
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "GTS frame index"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The GTS frame index locating the frame a finding concerns inside the bundle — a wire coordinate mirrored in the SARIF logicalLocation \"gts:frame\"."@x-gmeow-english ;
    skos:example "ex:stmt1 gmeow:gtsFrameIndex 1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting a frame index where no GTS bundle frame backs the finding."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Hang it on the node gmeow:findingLocation points at, matching the Rust Location.gts_frame_index."@x-gmeow-english ;
    gmeow:useWhen "Use on a finding's location node to pin the GTS frame index of the diagnosed content."@x-gmeow-english .

gmeow:gtsQuadIndex
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "GTS quad index"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The GTS quad index locating the quad a finding concerns inside the bundle's quad table — a wire coordinate mirrored in the SARIF logicalLocation \"gts:quad\"."@x-gmeow-english ;
    skos:example "ex:stmt1 gmeow:gtsQuadIndex 42 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting a quad index where no GTS bundle quad table backs the finding."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Hang it on the node gmeow:findingLocation points at, matching the Rust Location.gts_quad_index."@x-gmeow-english ;
    gmeow:useWhen "Use on a finding's location node to pin the GTS quad index of the statement diagnosed."@x-gmeow-english .

gmeow:gtsReifierId
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "GTS reifier id"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The GTS reifier-id locating the reifier a finding concerns — a wire coordinate mirrored in the SARIF logicalLocation \"gts:reifier\"."@x-gmeow-english ;
    skos:example "ex:stmt1 gmeow:gtsReifierId 3 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting a reifier id where no GTS bundle reifier backs the finding."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Hang it on the node gmeow:findingLocation points at, matching the Rust Location.gts_reifier_id."@x-gmeow-english ;
    gmeow:useWhen "Use on a finding's location node to pin the GTS reifier-id of the reified statement diagnosed."@x-gmeow-english .

# gmeow:gtsSegmentIndex is owned by the gts slice (functional, domain gmeow:GTSSegment;
# the index that, over the segment heads, IS a document's composite identity — spec §3.1).
# A finding's location node REFERENCES it as a wire coordinate ("the segment this finding
# concerns is at index N"); diagnostics does not redeclare it (single-owner invariant).

gmeow:gtsTermId
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "GTS term id"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The GTS term-id locating the term a finding concerns inside the bundle's term table — one of the wire coordinates that resolve a finding to an exact position, mirrored in the SARIF logicalLocation \"gts:term\"."@x-gmeow-english ;
    skos:example "ex:stmt1 gmeow:gtsTermId 7 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it where no GTS bundle backs the finding (file-based findings use line/column instead)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Hang it on the node gmeow:findingLocation points at, matching the value carried in the SARIF logicalLocation and the Rust Location.gts_term_id."@x-gmeow-english ;
    gmeow:useWhen "Use on a finding's location node to pin the GTS term-id of the term diagnosed."@x-gmeow-english .

gmeow:ruleCategory
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ValidationRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "rule category"@x-gmeow-english ;
    rdfs:range logic:FindingCategory ;
    skos:definition "The KIND of an enforced check — a logic:FindingCategory individual, the SAME axis a gmeow:Finding carries via gmeow:findingCategory, asserted here on the standing gmeow:ValidationRule rather than the occurrence. A rule's category is DERIVED by the catalog generator from the kind of axiom it enforces (a disjointness check is a data-shape/partition rule, a relator-mediation check a modeling-discipline rule, a frame check a frame-relativity rule), never hand-assigned. Distinct property from gmeow:findingCategory only because the domains differ (rule vs finding); the value vocabulary is shared, so a code's rule category and its findings' category agree by construction."@x-gmeow-english ;
    skos:example "ex:ruleRelatorMediation gmeow:ruleCategory logic:FindingModelingDisciplineViolation ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a parallel category vocabulary (reuse logic:FindingCategory, the finding axis) and avoid conflating it with gmeow:ruleSeverity (the grade) or gmeow:ruleCode (the identity); the category is the orthogonal KIND of check."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Have the catalog generator derive it from the enforced-axiom kind and project it as one logic:FindingCategory individual; consumers read it beside gmeow:ruleSeverity to group the catalog by kind."@x-gmeow-english ;
    gmeow:useWhen "Use to record the kind of an enforced check on its ValidationRule, over the same logic:FindingCategory axis its findings carry."@x-gmeow-english .

gmeow:ruleCode
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ValidationRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "rule code"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The stable identifier of an enforced check (e.g. \"discipline/relator-mediation\", \"frame-completeness\", \"shacl.MinCountConstraintComponent\") — the SAME string space as gmeow:findingCode, asserted on the standing gmeow:ValidationRule. It is the join key by which a finding resolves to its catalog entry: a gmeow:Finding's gmeow:findingCode equals exactly one ValidationRule's gmeow:ruleCode. Short and stable across runs; minted by the Rust check that emits it, never derived from the ontology."@x-gmeow-english ;
    skos:example "ex:ruleRelatorMediation gmeow:ruleCode \"discipline/relator-mediation\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid putting the human description here (that is the generated skos:definition) and avoid run-varying values; the code is the stable rule key that a finding's gmeow:findingCode matches."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set it to the validator's finding code verbatim so gmeow:findingCode = gmeow:ruleCode is the resolution join; the code also slugifies into the rule's gmeow:ruleHelpUri anchor."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the stable code of an enforced check on its ValidationRule so findings can resolve to their catalog entry by code."@x-gmeow-english .

gmeow:ruleHelpUri
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ValidationRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "rule help URI"@x-gmeow-english ;
    rdfs:range xsd:anyURI ;
    skos:definition "The canonical 'learn more' link of an enforced check — the constraint-catalog anchor a reader follows to see what the code enforces, which terms it governs, and the prose it formalizes. It is the rule-level source that a finding projects as gmeow:findingHelpUri (SARIF rule helpUri, LSP codeDescription): the same link, carried once on the standing rule. Deterministically the enforced-constraints catalog page anchored by the code's slug (path/dot separators to hyphens), so a validator finding code and its catalog entry never disagree."@x-gmeow-english ;
    skos:example "ex:ruleRelatorMediation gmeow:ruleHelpUri \"https://blackcatinformatics.ca/gmeow/docs/enforced-constraints#discipline-relator-mediation\"^^xsd:anyURI ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid duplicating the description here (that is skos:definition) and avoid run-varying values; the help URI is the stable, rule-level pointer to the catalog entry, computed from the code's slug."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project it from the shared slugify(code) so it equals the enforced-constraints page anchor for the code; a finding's gmeow:findingHelpUri is projected from the same value."@x-gmeow-english ;
    gmeow:useWhen "Use to carry an enforced check's stable catalog link on its ValidationRule, the rule-level source of every finding's help URI."@x-gmeow-english .

gmeow:severityError
    a gmeow:DiagnosticSeverity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "error"@x-gmeow-english ;
    skos:definition "The error grade — a gate-failing diagnostic: the report is not OK while any finding carries it. Maps to SARIF level \"error\"."@x-gmeow-english ;
    gmeow:gradeOrdinal 3 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:severityInfo
    a gmeow:DiagnosticSeverity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "info"@x-gmeow-english ;
    skos:definition "The info grade — an informational diagnostic. Maps to SARIF level \"note\" (SARIF has no distinct info level)."@x-gmeow-english ;
    gmeow:gradeOrdinal 0 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:severityNote
    a gmeow:DiagnosticSeverity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "note"@x-gmeow-english ;
    skos:definition "The note grade — an advisory diagnostic. Maps to SARIF level \"note\"."@x-gmeow-english ;
    gmeow:gradeOrdinal 1 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:severityWarning
    a gmeow:DiagnosticSeverity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "warning"@x-gmeow-english ;
    skos:definition "The warning grade — a non-gate-failing diagnostic worth surfacing. Maps to SARIF level \"warning\"."@x-gmeow-english ;
    gmeow:gradeOrdinal 2 ;
    gmeow:graphBoxRole gmeow:boxABox .

# ════════════════════════════════════════════════════════════════════════════
# The grading substrate — the truth-axis bilattice and the single gate morphism.
#
# A finding's GRADE is not a scalar severity: it is a point in the truth ordering
# ⊑_t, the product of three chains — gmeow:DiagnosticSeverity (Info ⊑ … ⊑ Error),
# gmeow:DiagnosticStandpoint (Advisory ⊑ Perspectival ⊑ Binding), and the
# gmeow:BlockingDisposition projection of the finding's logic:FindingCategory
# (Coherent ⊑ Blocking). Gate fatality is the principal up-set of ⊑_t. The single
# derivation rule logic:ruleGateFatalVerdict (in the logic slice) materializes
# gmeow:findingGateVerdict gmeow:gateFatal on exactly the up-set ↑(Error, Blocking,
# Binding), the RDF projection of the one Rust gmeow_errors::grade::gate() policy
# morphism; the diagnostics conformance lane proves the two agree over every grade.
# ════════════════════════════════════════════════════════════════════════════

gmeow:BlockingDisposition
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Blocking Disposition"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The gating PROJECTION of a finding's logic:FindingCategory — the two-element value space Coherent ⊑ Blocking (individuals gmeow:blockingCoherent, gmeow:blockingBlocking) that says whether a KIND of finding is a real failure or is surfaced but never gate-failing. Exactly the three failure kinds (logic:FindingDataShapeViolation, logic:FindingModelingDisciplineViolation, logic:FindingContradictionWitness) project to gmeow:blockingBlocking; the other seven — including the load-bearing logic:FindingPermittedEpistemicConflict, the non-blocking logic:FindingCorroboration, and the logic:FindingTransientChatter chatter kind — project to gmeow:blockingCoherent. Each category's projection is wired by gmeow:categoryBlocking, so the gate never inspects the category directly, only its Blocking image. Members are individuals, never subclasses (Principle 9). Mirrors the Rust gmeow_errors::grade::Blocking lattice and FindingCategory::blocking()."@x-gmeow-english ;
    skos:example "logic:FindingContradictionWitness gmeow:categoryBlocking gmeow:blockingBlocking ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating it with gmeow:findingSeverity (a Blocking category can still be a warning) or with the gate verdict (that is gmeow:GateVerdict, the meet of all three axes); the Blocking disposition is only the category's gating contribution, one of three axes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Wire each logic:FindingCategory to exactly one gmeow:BlockingDisposition through gmeow:categoryBlocking, matching FindingCategory::blocking(); the gate rule reads only this image, so a new category gates the moment its projection is wired."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary for the gating projection of a finding kind — whether the category is a Blocking failure or a Coherent, non-gating disclosure."@x-gmeow-english .

gmeow:DiagnosticStandpoint
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Diagnostic Standpoint"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    gmeow:groundsContextAxis logic:StandpointContextAxis ;
    skos:definition "The gating STRENGTH a finding is asserted from — the chain gmeow:standpointAdvisory ⊑ gmeow:standpointPerspectival ⊑ gmeow:standpointBinding, the third axis of the truth-ordering triple the gate reads. Only a gmeow:standpointBinding finding can contribute to gate fatality; an advisory finding never gates, whatever its severity — the never-gate guarantee falls out of the up-set construction, not a special case. An open value space, individuals never subclasses (Principle 9). Its grounding onto the standpoint index axis of the reasoning-context facet is asserted, not narrated (gmeow:groundsContextAxis). Mirrors the Rust gmeow_errors::grade::Standpoint chain."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingStandpoint gmeow:standpointBinding ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid subclassing it to add a tier (the members are individuals) and avoid conflating the standpoint with the severity (how loud) or the category (what kind); the standpoint is the gating strength — the only axis that lets a finding bind the gate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded DiagnosticStandpoint individuals from a gmeow:Finding via gmeow:findingStandpoint; a producer asserting a hard failure uses gmeow:standpointBinding, a perspectival observation gmeow:standpointPerspectival, and pure advice gmeow:standpointAdvisory."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary for a finding's gating strength — the standpoint axis of the truth ordering that decides whether the finding can reach the gate at all."@x-gmeow-english .

gmeow:GateVerdict
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Gate Verdict"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The verdict of the single gate morphism — the two-element chain gmeow:gateCollected ⊑ gmeow:gateFatal. A finding is gmeow:gateFatal iff its severity is gmeow:severityError AND its category projects to gmeow:blockingBlocking AND its standpoint is gmeow:standpointBinding: the principal up-set ↑(Error, Blocking, Binding), a meet of three monotone axis-maps, so any advisory-standpoint or Coherent-category finding is structurally unable to reach Fatal. The verdict is DERIVED, never asserted: gmeow:findingGateVerdict is materialized by logic:ruleGateFatalVerdict, the reasoner-side image of the one Rust gmeow_errors::grade::gate() policy morphism. Members are individuals, never subclasses (Principle 9). Mirrors gmeow_errors::grade::GateVerdict."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingGateVerdict gmeow:gateFatal ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting a gmeow:GateVerdict by hand (it is derived by logic:ruleGateFatalVerdict) and avoid reading it as a severity; the verdict is the meet of all three truth axes, not a fourth grade."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Read gmeow:findingGateVerdict off the reasoned graph — gmeow:gateFatal names a gate-failing finding, gmeow:gateCollected a surfaced-but-non-fatal one; never mint it, let the derivation compute it from the three axes."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary for the outcome of the gate — the single fatality decision every finding's grade folds to."@x-gmeow-english .

gmeow:categoryBlocking
    a owl:ObjectProperty ;
    rdfs:domain logic:FindingCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "category blocking"@x-gmeow-english ;
    rdfs:range gmeow:BlockingDisposition ;
    skos:definition "Wires a logic:FindingCategory to its gmeow:BlockingDisposition — the standing, asserted gating projection of the KIND. The three failure kinds map to gmeow:blockingBlocking, the other seven to gmeow:blockingCoherent, matching Rust FindingCategory::blocking(). The gate reads only this image, never the category directly, so the projection is the single point where 'which kinds are failures' is stated once and consumed by both the reasoner and every projection."@x-gmeow-english ;
    skos:example "logic:FindingPermittedEpistemicConflict gmeow:categoryBlocking gmeow:blockingCoherent ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting more than one gmeow:BlockingDisposition per category (the projection is functional) and avoid using it for the finding's severity or standpoint; categoryBlocking projects only the KIND's gating contribution."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one gmeow:categoryBlocking per logic:FindingCategory individual, mirroring FindingCategory::blocking(); the gate derivation joins a finding's gmeow:findingCategory to this projection to read the Blocking axis."@x-gmeow-english ;
    gmeow:useWhen "Use to state a finding kind's gating projection — whether a category is a Blocking failure or a Coherent, non-gating disclosure — as the single asserted source the gate consumes."@x-gmeow-english .

gmeow:findingGateVerdict
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding gate verdict"@x-gmeow-english ;
    rdfs:range gmeow:GateVerdict ;
    gmeow:enforcedByShape <https://blackcatinformatics.ca/gmeow/GateFatalUpsetShape> ;
    skos:definition "The gate verdict of a finding — a gmeow:GateVerdict individual, DERIVED by logic:ruleGateFatalVerdict, never asserted by hand. gmeow:gateFatal is materialized exactly for the principal up-set ↑(gmeow:severityError, gmeow:blockingBlocking, gmeow:standpointBinding) read off the finding's gmeow:findingSeverity, its gmeow:findingCategory's gmeow:categoryBlocking projection, and its gmeow:findingStandpoint; every other grade stays gmeow:gateCollected. It is the reasoner-derived RDF image of the single Rust gmeow_errors::grade::gate() policy morphism, and the diagnostics conformance lane proves the derived Fatal set equals gate()'s over every grade."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingGateVerdict gmeow:gateFatal ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand — it is derived; asserting gmeow:gateFatal directly would bypass the single gate morphism and could disagree with gate(). Avoid conflating it with gmeow:findingSeverity; the verdict is the meet of all three axes, not the severity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it off the reasoned graph after logic:ruleGateFatalVerdict has fired; a gate consumer treats gmeow:gateFatal as the report-not-OK condition and gmeow:gateCollected as surfaced-but-non-fatal."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the derived fatality verdict of a finding so a gate or SPARQL consumer can select the fatal findings without re-implementing the gate policy."@x-gmeow-english .

gmeow:findingStandpoint
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding standpoint"@x-gmeow-english ;
    rdfs:range gmeow:DiagnosticStandpoint ;
    skos:definition "The gating STRENGTH of a finding — a gmeow:DiagnosticStandpoint individual, the third axis of the truth-ordering triple (severity, blocking-projected category, standpoint) the gate reads. An advisory finding (gmeow:standpointAdvisory) never gates, whatever its severity or category; only a gmeow:standpointBinding finding can reach gmeow:gateFatal. Mirrors the standpoint field of the Rust gmeow_errors::grade::Grade."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingStandpoint gmeow:standpointBinding ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it outside the gmeow:DiagnosticStandpoint vocabulary and avoid conflating it with gmeow:findingSeverity (loudness) or gmeow:findingCategory (kind); the standpoint is the gating strength, the axis that decides whether a finding can bind the gate at all."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Bind one gmeow:DiagnosticStandpoint individual per Finding; the gate derivation reads it as the standpoint axis of the truth triple, requiring gmeow:standpointBinding for a fatal verdict."@x-gmeow-english ;
    gmeow:useWhen "Use to record a finding's gating strength — the standpoint from which its verdict is asserted — completing the truth-axis triple the gate morphism folds."@x-gmeow-english .

gmeow:blockingBlocking
    a gmeow:BlockingDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "blocking"@x-gmeow-english ;
    skos:definition "The Blocking projection value — the TOP of the gmeow:BlockingDisposition chain: a finding KIND that is a real failure and can contribute to gate fatality. The image of exactly the three failure categories logic:FindingDataShapeViolation, logic:FindingModelingDisciplineViolation, and logic:FindingContradictionWitness."@x-gmeow-english ;
    gmeow:gradeOrdinal 1 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:blockingCoherent
    a gmeow:BlockingDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "coherent"@x-gmeow-english ;
    skos:definition "The Blocking projection value — the BOTTOM of the gmeow:BlockingDisposition chain: a finding KIND that is surfaced but never a failure, structurally unable to reach gmeow:gateFatal. The image of the five non-failure categories, chiefly the load-bearing logic:FindingPermittedEpistemicConflict (a disclosed, coherent contradiction a glut-admitting contract permits)."@x-gmeow-english ;
    gmeow:gradeOrdinal 0 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gateCollected
    a gmeow:GateVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "collected"@x-gmeow-english ;
    skos:definition "The gate verdict — the BOTTOM of the gmeow:GateVerdict chain: a finding that is surfaced and collected but does NOT fail the gate. Every grade outside the principal up-set ↑(Error, Blocking, Binding) folds here; it is the default, non-derived-Fatal outcome."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gateFatal
    a gmeow:GateVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "fatal"@x-gmeow-english ;
    skos:definition "The gate verdict — the TOP of the gmeow:GateVerdict chain: a gate-failing finding, the report is not OK while any finding carries it. DERIVED by logic:ruleGateFatalVerdict on exactly the principal up-set ↑(gmeow:severityError, gmeow:blockingBlocking, gmeow:standpointBinding); never asserted by hand."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:standpointAdvisory
    a gmeow:DiagnosticStandpoint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "advisory"@x-gmeow-english ;
    skos:definition "The gating strength — the BOTTOM of the gmeow:DiagnosticStandpoint chain: a finding offered as advice, from which the gate can never derive a fatal verdict whatever the finding's severity. The soft-tier recommendation standpoint."@x-gmeow-english ;
    gmeow:gradeOrdinal 0 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:standpointBinding
    a gmeow:DiagnosticStandpoint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "binding"@x-gmeow-english ;
    skos:definition "The gating strength — the TOP of the gmeow:DiagnosticStandpoint chain: a finding asserted with binding authority, the only standpoint that can contribute to gmeow:gateFatal (alongside gmeow:severityError and a gmeow:blockingBlocking category)."@x-gmeow-english ;
    gmeow:gradeOrdinal 2 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:standpointPerspectival
    a gmeow:DiagnosticStandpoint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "perspectival"@x-gmeow-english ;
    skos:definition "The gating strength — the MIDDLE of the gmeow:DiagnosticStandpoint chain: a finding asserted as one perspective's claim, above advisory but below binding, so it too cannot reach gmeow:gateFatal (only gmeow:standpointBinding can)."@x-gmeow-english ;
    gmeow:gradeOrdinal 1 ;
    gmeow:graphBoxRole gmeow:boxABox .

# ── The gating projection of each logic:FindingCategory (FindingCategory::blocking()).
# The three failure kinds project to gmeow:blockingBlocking; the other six to
# gmeow:blockingCoherent. This is the single asserted source the gate rule reads.
logic:FindingDataShapeViolation gmeow:categoryBlocking gmeow:blockingBlocking .
logic:FindingModelingDisciplineViolation gmeow:categoryBlocking gmeow:blockingBlocking .
logic:FindingContradictionWitness gmeow:categoryBlocking gmeow:blockingBlocking .
logic:FindingPermittedEpistemicConflict gmeow:categoryBlocking gmeow:blockingCoherent .
logic:FindingUnsupportedSemanticFeature gmeow:categoryBlocking gmeow:blockingCoherent .
logic:FindingIncompleteCheck gmeow:categoryBlocking gmeow:blockingCoherent .
logic:FindingProjectionLoss gmeow:categoryBlocking gmeow:blockingCoherent .
logic:FindingPolicyWarning gmeow:categoryBlocking gmeow:blockingCoherent .
logic:FindingCorroboration gmeow:categoryBlocking gmeow:blockingCoherent .
logic:FindingTransientChatter gmeow:categoryBlocking gmeow:blockingCoherent .

# ── The MATH grounding of the truth-order chains (Principle 19): a monotone
# order-embedding of each ⊑-chain into (ℤ, ≤). The integer rank EMBEDS the poset
# numerically — ordering only, never a metric spacing (Principle 9). The one-way
# math bridge (math:integers math:formalizes gmeow:gradeOrdinal) is asserted in
# the math slice; here the ordinal is carried on each existing chain member. This
# is NOT a parallel gmeow:Grade subtree — it annotates the members already minted.
gmeow:gradeOrdinal
    a owl:DatatypeProperty ;
    rdfs:domain logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "grade ordinal"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The ordinal rank of a truth-order grade value on its ⊑-chain — the integer that embeds a diagnostics value chain (gmeow:DiagnosticSeverity Info<Note<Warning<Error, gmeow:DiagnosticStandpoint Advisory<Perspectival<Binding, gmeow:BlockingDisposition Coherent<Blocking) into (ℤ, ≤), monotone with the ⊑ order so a query can compare two grades on one axis numerically. This is the Principle-19 MATH grounding of the truth ordering: the well-ordered integers ℤ ground the numeric rank, recorded as the one-way bridge math:integers math:formalizes gmeow:gradeOrdinal in the math slice. It is NOT a parallel gmeow:Grade subtree — it annotates the EXISTING chain individuals."@x-gmeow-english ;
    skos:example "gmeow:severityError gmeow:gradeOrdinal 3 ."@x-gmeow-english ;
    skos:scopeNote "Ordering only, not a metric (Principle 9): gradeOrdinal fixes the ⊑-monotone sequence of each chain's members so a query can read 'stronger than' as an order-embedding into the integers; it asserts no equal spacing, no unit, and no cross-chain commensurability — the three axes meet at the gate as a meet, they are never summed."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading the rank as a magnitude, a confidence, or a cross-chain metric (the gate is the meet of three axes, not a sum of ordinals), and avoid asserting it on anything but a member of one of the three truth-order value chains."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assign each chain member one xsd:integer monotone with its position in the ⊑ chain (bottom lowest); read 'stronger than' as a rank comparison WITHIN one chain, leaving the fatality fold to logic:ruleGateFatalVerdict."@x-gmeow-english ;
    gmeow:useWhen "Use to order the named members of a diagnostics truth-order chain — the integer a query reads to compare two grades on the same axis, grounding the ⊑ order numerically (Principle 19)."@x-gmeow-english .

gmeow:groundsContextAxis
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "grounds context axis"@x-gmeow-english ;
    rdfs:range logic:ContextAxis ;
    skos:definition "Asserts that a diagnostics value vocabulary grounds one index axis of the multi-dimensional reasoning-context facet — the concrete domain value space that fills in a logic:ContextAxis. gmeow:DiagnosticStandpoint grounds logic:StandpointContextAxis: the standpoint a finding is asserted from IS a value on the standpoint index axis a reasoning result is relative to. Range logic:ContextAxis; the subject is the grounding value class (domain left open, stated in prose, so the same predicate grounds other axes as the substrate grows). An asserted grounding edge, replacing the earlier prose claim so the link is queryable rather than narrated."@x-gmeow-english ;
    skos:example "gmeow:DiagnosticStandpoint gmeow:groundsContextAxis logic:StandpointContextAxis ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it for the finding→standpoint assignment (that is gmeow:findingStandpoint) or for a reasoning contract's declared axes (that is logic:contextAxis); groundsContextAxis names which value vocabulary FILLS an axis, not which axes a contract carries."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point a diagnostics truth-order value class at the logic:ContextAxis it grounds; read it to resolve 'what value space indexes this context axis' from the reasoning core into the concrete diagnostics vocabulary."@x-gmeow-english ;
    gmeow:useWhen "Use to assert that a diagnostics value vocabulary grounds a reasoning-context index axis — chiefly gmeow:DiagnosticStandpoint grounding logic:StandpointContextAxis."@x-gmeow-english .

# ── The lang: prose grounding of the gate policy (Principle 19). The gate policy's
# localizable definition is carried as a first-class lang:UnanalyzedProse surface
# (the honest lang: status of an @x-gmeow-english prose field), situated in the
# English sign system, so the prose is a queryable surface rather than only a bare
# literal. gmeow:GateVerdict points at it through gmeow:proseSurface.
gmeow:proseSurface
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "prose surface"@x-gmeow-english ;
    rdfs:range lang:SurfaceForm ;
    skos:definition "Links a gmeow: term to the lang:SurfaceForm that carries its localizable prose — grounding the term's human-readable definition in the lang: form AST rather than leaving it a bare @x-gmeow-english literal. Range lang:SurfaceForm (domain left open, stated in prose); the surface situates the prose in a lang:SignSystem and declares its material identity, so 'the definition of this term' becomes a first-class, sign-system-situated surface. Introduced for the gate policy (gmeow:GateVerdict), the first gmeow: term whose prose is grounded in lang:."@x-gmeow-english ;
    skos:example "gmeow:GateVerdict gmeow:proseSurface gmeow:gatePolicyProse ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it to replace the term's own skos:definition (the surface CARRIES the localizable prose, it does not remove the SKOS annotation) or to point at an analyzed lang:Form above the surface stratum; proseSurface names the concrete prose surface, not its analysis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Mint one lang:UnanalyzedProse carrying the term's localizable definition through lang:surfaceText, situate it with lang:inSignSystem, and point the term at it through gmeow:proseSurface."@x-gmeow-english ;
    gmeow:useWhen "Use to ground a gmeow: term's localizable prose in the lang: layer — carrying the definition as a first-class, sign-system-situated surface a query can reach."@x-gmeow-english .

gmeow:gatePolicyProse
    a lang:UnanalyzedProse ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "gate policy prose"@x-gmeow-english ;
    lang:inSignSystem lang:english ;
    lang:analysisLevel lang:rawLevel ;
    lang:inScript lang:latinScript ;
    lang:unicodeNormalization "NFC" ;
    lang:collationLocale "und" ;
    lang:surfaceText "A finding is gate-fatal exactly when its severity is error, its category projects to blocking, and its standpoint is binding — the principal up-set of the truth ordering. Any advisory-standpoint or coherent-category finding is structurally unable to fail the gate, whatever its severity." ;
    skos:definition "The lang:UnanalyzedProse surface carrying the localizable definition of the gate policy (gmeow:GateVerdict): the up-set fatality rule stated as English prose, situated in the English sign system at raw analysis level. The honest lang: status of an @x-gmeow-english prose field made first-class, so the gate policy's prose is a queryable, sign-system-situated surface. gmeow:GateVerdict reaches it through gmeow:proseSurface. An unanalyzed-prose surface at lang:rawLevel: it does not lang:realize an analyzed form (a realized surface would be forbidden at raw level)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:GateVerdict gmeow:proseSurface gmeow:gatePolicyProse .

# ════════════════════════════════════════════════════════════════════════════
# Standing remediation and its occurrence projection.
#
# A rule carries authored fix guidance ONCE (gmeow:ruleRemediation); each finding
# of that rule projects it as gmeow:findingRemediation, the sibling of
# gmeow:findingSuggestion / gmeow:findingHelpUri. The prose is authored in the
# validator rule registry (crates/validate) and projected into the bundle, then
# rendered verbatim into SARIF fixes / JSON / human output, NEVER fabricated at
# render time (a render-time invention would be an unattributable claim).
# ════════════════════════════════════════════════════════════════════════════

gmeow:ruleRemediation
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ValidationRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "rule remediation"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The standing, rule-level remediation guidance of an enforced check — the prose that tells a reader how to fix a violation of the rule, authored in the validator rule registry (the `REMEDIATIONS` catalog of crates/validate) and projected into the bundle once on the gmeow:ValidationRule, then onto each of its findings as gmeow:findingRemediation. The sibling of gmeow:ruleHelpUri: where the help URI points OUT to the catalog, ruleRemediation carries the fix text IN. It is rendered verbatim into the SARIF result fixes, the flat JSON, and the human CLI/HTML output; it is NEVER fabricated at render time — a finding with no authored remediation carries none rather than an invented suggestion."@x-gmeow-english ;
    skos:example "ex:ruleRelatorMediation gmeow:ruleRemediation \"Introduce the mediating relator and attach both relata through gmeow:mediates.\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating it at render time (it is authored in the validator rule registry and projected into the bundle; a rule with no authored guidance carries no remediation) and avoid confusing it with gmeow:ruleHelpUri (the outward catalog link) or gmeow:ruleCode (the identity); ruleRemediation is the standing fix prose the rule's findings project."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Author it once in the validator rule registry as the fix guidance for the code, project it onto the gmeow:ValidationRule; project it further onto every gmeow:Finding of the rule as gmeow:findingRemediation, and render it as the SARIF fixes description, the JSON remediation field, and the CLI/HTML 'how to fix' line."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the standing fix guidance of an enforced check — authored in the validator rule registry and projected into the bundle onto its ValidationRule — the rule-level source every finding's remediation projects from."@x-gmeow-english .

gmeow:findingRemediation
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding remediation"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The occurrence projection of gmeow:ruleRemediation onto a finding — the fix guidance of the finding's rule, authored in the validator rule registry and projected into the bundle, carried on the gmeow:Finding so every surface (SARIF fixes, JSON, CLI, HTML) can render 'how to fix this' beside the message. The sibling of gmeow:findingSuggestion (occurrence advice) and gmeow:findingHelpUri (the rule's outward link): findingRemediation is the standing remediation prose resolved onto the occurrence. It is projected verbatim from the rule's gmeow:ruleRemediation, NEVER fabricated at render time; a finding whose rule authors no remediation carries none."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingRemediation \"Introduce the mediating relator and attach both relata through gmeow:mediates.\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing it at render time (project it from the rule's gmeow:ruleRemediation, never fabricate) and avoid conflating it with gmeow:findingSuggestion (per-occurrence advice) or gmeow:findingMessage (the description of what went wrong); findingRemediation is the projected fix guidance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project it onto a gmeow:Finding from the gmeow:ruleRemediation of the finding's rule (resolved by shared code); render it as the SARIF fixes description and the CLI/HTML remediation line beside gmeow:findingMessage."@x-gmeow-english ;
    gmeow:useWhen "Use to carry a finding's rule-level fix guidance on the occurrence so consumers render 'how to fix this' without re-resolving the rule."@x-gmeow-english .

# ════════════════════════════════════════════════════════════════════════════
# The advice-catalog projection: the recommendation tier.
#
# The advisory peer of gmeow:ValidationRule. Where a ValidationRule is the
# standing definition of an ENFORCED (compliance) check, a gmeow:AdviceEntry is
# the standing definition of a RECOMMENDATION harvested for one governed term:
# the verbatim avoidWhen (prohibition) / useWhen (conditional permission) /
# howToUse (positive directive) prose the term's realized advisory carriers
# (a logic:Constraint at logic:severity "Info", plus a logic:AdviceGuidance)
# formalize. Entries are a GENERATED projection of the reasoned/authored graph —
# each carries the term's OWN prose verbatim (the logic:message is gate-bound to
# the term's gmeow:avoidWhen by check_advice_message_prose_binding), never a
# hand-authored or render-time-invented recommendation. Every entry hangs
# beneath the gmeow: rule/family/advice ValidationRule via gmeow:documentedByRule,
# so the single advice.* finding family resolves to the advice section that
# documents it. The three prose predicates ARE the deontic-modality dimension
# (avoid=prohibition, use=permission, how=directive); no separate modality node
# is minted.
# ════════════════════════════════════════════════════════════════════════════

gmeow:AdviceEntry
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Advice Entry"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "A single catalog RECOMMENDATION — the advisory peer of gmeow:ValidationRule. Where a ValidationRule is the standing definition of an enforced (binding-or-advisory-severity) check, an AdviceEntry is the standing definition of the harvested advice for one governed term: the verbatim gmeow:adviceAvoidWhen (prohibition), gmeow:adviceUseWhen (conditional permission), and gmeow:adviceHowToUse (positive directive) prose that the term's realized advisory carriers formalize, plus gmeow:appliesToTerm / logic:formalizes back to that term and gmeow:documentedByRule to the advice.* family rule. AdviceEntry individuals are the gmeow: RDF projection of the reasoned graph's realized advice carriers — generated, never authored by hand, so the advice catalog stays a projection of the axioms rather than a maintained list; a term with no realized carrier gets no entry."@x-gmeow-english ;
    skos:example "ex:adviceEntity a gmeow:AdviceEntry ; gmeow:appliesToTerm gmeow:Entity ; gmeow:documentedByRule <https://blackcatinformatics.ca/gmeow/rule/family/advice> ; gmeow:adviceAvoidWhen \"Avoid typing an instance as a bare gmeow:Entity when a more specific sortal applies…\" ."@x-gmeow-english ;
    skos:scopeNote "The recommendation sibling of gmeow:ValidationRule: both are catalog entries, but a ValidationRule is an enforced check (its findings gate or warn) while an AdviceEntry documents non-gating advice (the advice.* Note tier that only recommends). Distinct class so the two deontic tiers — compliance and advice — render as distinct catalog sections while sharing the anchor authority. Its ⊑ gmeow:InformationObject is grounded in logic: (logic:subClassOf, which the pipeline lowers to rdfs:subClassOf on the OWL/RDFS projection) rather than hand-authored — giving parity with gmeow:ValidationRule ⊑ gmeow:InformationObject in the derived graph while adding no hand-authored rdfs subsumption residue, since the residue counter counts only rdfs:subClassOf asserted in source, never logic:subClassOf."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring AdviceEntry individuals by hand as the source of truth — they are generated from the reasoned graph's realized advice carriers — and avoid using one where a gmeow:ValidationRule (an enforced check) is meant; the AdviceEntry is a non-gating recommendation, not a check that fails the gate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Read it as the resolution target of the advice.* finding family: from a gmeow:Finding whose gmeow:findingCode begins 'advice.', land on the advice section (help URI anchor #advice-) and surface the AdviceEntry for the finding's governed term — its gmeow:adviceAvoidWhen / gmeow:adviceUseWhen / gmeow:adviceHowToUse prose as 'what this code recommends'."@x-gmeow-english ;
    gmeow:useWhen "Use to record the definition of a harvested recommendation as a first-class, queryable RDF entity — the machine-readable advice catalog that lets an advisory finding code resolve to the avoid/use/how-to prose it recommends for a governed term."@x-gmeow-english .

gmeow:documentedByRule
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AdviceEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "documented by rule"@x-gmeow-english ;
    rdfs:range gmeow:ValidationRule ;
    skos:definition "A bridge from a gmeow:AdviceEntry to the gmeow:ValidationRule that owns its finding family — in practice the advice.* family rule (gmeow: rule/family/advice) beneath which the entry is rendered. It makes the advice catalog navigable rule ↔ entry: from the advice family rule a reader reaches every recommendation it documents, and from an entry the reader reaches the finding-family whose codes resolve to it. Resolved by the catalog generator, never authored by hand."@x-gmeow-english ;
    skos:example "ex:adviceEntity gmeow:documentedByRule <https://blackcatinformatics.ca/gmeow/rule/family/advice> ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at a governed TERM (that is gmeow:appliesToTerm / logic:formalizes) or at a SHACL shape (that is gmeow:enforcedByShape); documentedByRule names the finding-family ValidationRule the recommendation hangs beneath, not the term it advises about."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point each generated AdviceEntry at the advice.* family gmeow:ValidationRule; render the entry as a sub-entry beneath that family rule so the single #advice- anchor heads the advice section and every advice.* finding code resolves there."@x-gmeow-english ;
    gmeow:useWhen "Use to link a harvested recommendation to the finding-family rule that documents it, so the advice catalog can be read rule-down (all advice of the family) as well as term-up."@x-gmeow-english .

gmeow:adviceAvoidWhen
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:AdviceEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "advice avoid when"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The catalog-side PROHIBITION prose of a gmeow:AdviceEntry — the verbatim gmeow:avoidWhen recommendation of the entry's governed term, projected from the realized advisory carrier's logic:message (which check_advice_message_prose_binding binds equal to the term's authored gmeow:avoidWhen). The advice peer of gmeow:ruleRemediation: where ruleRemediation carries an enforced rule's fix prose, adviceAvoidWhen carries a recommendation's 'avoid this when…' prose. Multi-valued (a term may bear several avoidWhen constraints); rendered verbatim into the advice section and the MCP advise recommendation, NEVER fabricated at render time — a term with no avoidWhen carrier carries none."@x-gmeow-english ;
    skos:example "ex:adviceEntity gmeow:adviceAvoidWhen \"Avoid typing an instance as a bare gmeow:Entity when a more specific sortal applies…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating it at render time (it is projected verbatim from the term's realized avoidWhen carrier; an entry with no avoidWhen carrier carries none) and avoid conflating it with gmeow:adviceHowToUse (the corrective directive) or gmeow:adviceUseWhen (the permission gate); adviceAvoidWhen is the prohibition leg."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project it onto a gmeow:AdviceEntry from the logic:message of each Info-severity logic:Constraint that formalizes the entry's term; render it as the 'Avoid when' line of the advice section and as the violated-prohibition leg of the MCP advise recommendation."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the prohibition (avoid-when) recommendation of a harvested advice entry, projected verbatim from the governed term's realized advisory carrier."@x-gmeow-english .

gmeow:adviceUseWhen
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:AdviceEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "advice use when"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The catalog-side CONDITIONAL-PERMISSION prose of a gmeow:AdviceEntry — the verbatim gmeow:useWhen recommendation of the entry's governed term, projected from the term's realized logic:AdviceGuidance carrier (which formalizes the term and surfaces its verbatim useWhen prose). The permission-gate peer of gmeow:adviceAvoidWhen: it tells a reader WHEN the governed term is the right choice. Multi-valued; rendered verbatim into the advice section and the MCP advise recommendation, NEVER fabricated — a term with no useWhen guidance carrier carries none."@x-gmeow-english ;
    skos:example "ex:adviceEntity gmeow:adviceUseWhen \"Use for a genuinely category-neutral resource where no more specific sortal applies…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating it at render time (it is projected verbatim from the term's realized logic:AdviceGuidance carrier; an entry with no useWhen guidance carries none) and avoid conflating it with gmeow:adviceAvoidWhen (the prohibition) or gmeow:adviceHowToUse (the directive); adviceUseWhen is the conditional-permission leg."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project it onto a gmeow:AdviceEntry from the useWhen prose of each logic:AdviceGuidance that formalizes the entry's term; render it as the 'Use when' line of the advice section and as the permission-gate leg of the MCP advise recommendation."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the conditional-permission (use-when) recommendation of a harvested advice entry, projected verbatim from the governed term's realized guidance carrier."@x-gmeow-english .

gmeow:adviceHowToUse
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:AdviceEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "advice how to use"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The catalog-side POSITIVE-DIRECTIVE prose of a gmeow:AdviceEntry — the verbatim gmeow:howToUse recommendation of the entry's governed term, projected from the term's own gmeow:howToUse annotation. The corrective-directive peer of gmeow:adviceAvoidWhen: where avoidWhen names the anti-pattern, howToUse names the correct enactment. In the MCP advise recommendation it is the sub-ideal repair (the secondary directive that becomes operative once the prohibition has been tripped — a contrary-to-duty shape). Multi-valued; rendered verbatim, NEVER fabricated — a term with no howToUse carries none."@x-gmeow-english ;
    skos:example "ex:adviceEntity gmeow:adviceHowToUse \"Type the instance with the most specific applicable sortal; reserve the unqualified gmeow:Entity for category-neutral resources…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating it at render time (it is projected verbatim from the term's gmeow:howToUse; an entry with no howToUse carries none) and avoid conflating it with gmeow:adviceAvoidWhen (the prohibition) or gmeow:adviceUseWhen (the permission gate); adviceHowToUse is the positive-directive leg."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project it onto a gmeow:AdviceEntry from the gmeow:howToUse annotation of the entry's governed term; render it as the 'How to use' line of the advice section and as the sub-ideal-repair leg of the MCP advise recommendation."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the positive-directive (how-to-use) recommendation of a harvested advice entry, projected verbatim from the governed term's gmeow:howToUse annotation."@x-gmeow-english .

# ════════════════════════════════════════════════════════════════════════════
# The witness provenance DAG and the cross-code join anchor.
#
# gmeow:findingAntecedent is a provenance edge up the witness DAG (this finding
# derives FROM that one); gmeow:findingAnchor is the cross-code join key: a
# content hash over (location, term role, focus) EXCLUDING code and category, so
# two DIFFERENT-code findings at the SAME source anchor share it — the join the
# same-fingerprint merge (which keys on code) structurally cannot make.
# ════════════════════════════════════════════════════════════════════════════

gmeow:findingHowToUse
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding how to use"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The occurrence projection of a finding's governing or documented term's gmeow:howToUse guidance onto the finding — the HOW-facet modeling recipe (companion properties, relators, statement metadata, or projection checks) carried on the gmeow:Finding so CLI/HTML/SARIF/LSP can render 'how to use this term' beside the message. Projected verbatim from the term's gmeow:howToUse in the bundle documentation graph, NEVER fabricated at render time; a finding whose governing/documented terms author no how-to-use guidance carries none."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingHowToUse \"Attach the mediating relator via gmeow:mediates before asserting the relationship.\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing it at render time (project it verbatim from the governing/documented term's gmeow:howToUse) and avoid conflating it with gmeow:findingRemediation (the rule's authored fix prose); findingHowToUse is the term's own usage recipe, not the rule's fix guidance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Join a finding's rule to its governing term (or fall back to a documented term) and project that term's gmeow:howToUse onto the finding as gmeow:findingHowToUse; render it as usage guidance beside the message."@x-gmeow-english ;
    gmeow:useWhen "Use to carry a finding's governing/documented term's HOW-facet usage guidance on the occurrence, so a consumer sees how the term is normally used without re-resolving the term."@x-gmeow-english .

gmeow:findingUseWhen
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding use when"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The occurrence projection of a finding's governing or documented term's gmeow:useWhen guidance onto the finding — the WHEN-facet modeling situation the term should be used in, carried on the gmeow:Finding. Projected verbatim from the term's gmeow:useWhen in the bundle documentation graph, NEVER fabricated at render time; a finding whose governing/documented terms author no use-when guidance carries none."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingUseWhen \"Use gmeow:Kind for rigid sortal categories.\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing it at render time (project it verbatim from the governing/documented term's gmeow:useWhen) and avoid conflating it with gmeow:findingRemediation (the rule's authored fix prose) or gmeow:findingHowToUse (the HOW facet); findingUseWhen is the term's WHEN-facet usage guidance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Join a finding's rule to its governing term (or fall back to a documented term) and project that term's gmeow:useWhen onto the finding as gmeow:findingUseWhen; render it beside the message."@x-gmeow-english ;
    gmeow:useWhen "Use to carry a finding's governing/documented term's WHEN-facet usage guidance on the occurrence, so a consumer sees the modeling situation the term is meant for without re-resolving the term."@x-gmeow-english .

gmeow:findingAvoidWhen
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding avoid when"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The occurrence projection of a finding's governing or documented term's gmeow:avoidWhen guidance onto the finding — the conditions under which the term should NOT be used (or should be promoted to a more precise construct), carried on the gmeow:Finding. Projected verbatim from the term's gmeow:avoidWhen in the bundle documentation graph, NEVER fabricated at render time; a finding whose governing/documented terms author no avoid-when guidance carries none."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingAvoidWhen \"Avoid gmeow:Kind for phase-sortals that change over the bearer's lifetime.\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing it at render time (project it verbatim from the governing/documented term's gmeow:avoidWhen) and avoid conflating it with gmeow:findingRemediation (the rule's authored fix prose) or gmeow:findingUseWhen (the positive WHEN facet); findingAvoidWhen is the term's negative-scope usage guidance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Join a finding's rule to its governing term (or fall back to a documented term) and project that term's gmeow:avoidWhen onto the finding as gmeow:findingAvoidWhen; render it beside the message."@x-gmeow-english ;
    gmeow:useWhen "Use to carry a finding's governing/documented term's negative-scope usage guidance on the occurrence, so a consumer sees when NOT to use the term without re-resolving it."@x-gmeow-english .

# ════════════════════════════════════════════════════════════════════════════
# The explain-skeleton derivation edge for a reasoned-quad finding.
#
# Distinct from gmeow:findingAntecedent (a finding-to-finding provenance edge
# keyed on fingerprint IRIs): gmeow:findingDerivedFromQuad points at the
# logic-world REASONED-QUAD reifier IRIs a finding's verdict derives from — the
# explain-skeleton citations the reasoner emits, never a finding-to-finding edge.
# ════════════════════════════════════════════════════════════════════════════

gmeow:findingDerivedFromQuad
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding derived from quad"@x-gmeow-english ;
    skos:definition "The logic-world quad-reifier IRIs a reasoned-quad finding's verdict derives FROM — the explain-skeleton cited IRIs of the reasoned quads that fired to produce the verdict. Distinct from gmeow:findingAntecedent (a finding-to-finding provenance edge keyed on fingerprint IRIs): findingDerivedFromQuad points at REASONED-QUAD reifier IRIs, never at another finding. Projected from the reasoner's explain skeleton, never fabricated at render time; empty for a finding that is not the outcome of a reasoning pass. The range is left open (like gmeow:findingAnchor): the value is a quad-reifier IRI, not a typed class in this slice."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingDerivedFromQuad <https://blackcatinformatics.ca/gmeow/quad/9f2c> ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at another finding (that is gmeow:findingAntecedent) and avoid fabricating it when no reasoning pass produced the verdict; findingDerivedFromQuad is the reasoner's own explain-skeleton citation, never an invented edge."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project each cited quad-reifier IRI from the reasoner's explain skeleton onto the finding as gmeow:findingDerivedFromQuad; render the set beside the finding as the reasoned-derivation citation."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the reasoner's explain-skeleton cited quad-reifier IRIs on a reasoned-quad finding, distinct from the finding-to-finding gmeow:findingAntecedent provenance edge."@x-gmeow-english .

gmeow:findingAntecedent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding antecedent"@x-gmeow-english ;
    rdfs:range gmeow:Finding ;
    skos:definition "A provenance-DAG edge from a witness finding to the finding it derives FROM — the object is the antecedent finding's fingerprint IRI. It records that this finding is a downstream witness of the antecedent (a contradiction witness derived from the data-shape violation that produced it, say), so the reasoner can join up the witness DAG for root-cause analysis. The edge is directed toward the cause; a childless finding up the chain is a root antecedent. Distinct from gmeow:findingLocation (WHERE the finding is) and gmeow:wasGeneratedBy (WHICH tool produced it): findingAntecedent is the finding→finding derivation lineage."@x-gmeow-english ;
    skos:example "ex:witnessF2 gmeow:findingAntecedent ex:causeF1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at a non-Finding (the object is another finding's fingerprint IRI, not a location or a tool) and avoid using it for the producing tool (that is gmeow:wasGeneratedBy); findingAntecedent is the witness-DAG derivation edge toward the cause."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point a downstream witness finding at each finding it derives from; a reasoner root-cause rule follows the edge transitively up to the childless root antecedent and joins findings that share it."@x-gmeow-english ;
    gmeow:useWhen "Use to record the derivation lineage between findings — the provenance-DAG edge that enables reasoner root-cause joins over the witness DAG."@x-gmeow-english .

gmeow:findingAnchor
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding anchor"@x-gmeow-english ;
    skos:definition "The source anchor of a finding — an IRI that is a content hash over (location, term role, focus) EXCLUDING the finding's code and category, so two findings with DIFFERENT codes at the SAME source position share one anchor. It is the join key for cross-node glut detection: the same-fingerprint merge keys on the code and therefore CANNOT see across codes, but the anchor deliberately drops the code, so a reasoner can join two different-code findings at one place and detect an opposing-polarity conflict the merge misses. The range is left open (like gmeow:findingLocation): the value is the anchor IRI, an opaque content hash, not a reified statement."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:findingAnchor <https://blackcatinformatics.ca/gmeow/anchor/9f2c> ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid folding the code or category into the anchor (that would make it a per-code fingerprint, defeating the cross-code join) and avoid conflating it with gmeow:findingLocation (the reified statement) — the anchor is the code-blind content hash two different-code findings at one place share."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Compute the anchor as a content hash over (location, term role, focus) with the code and category EXCLUDED, and point each finding at it; a cross-node-glut rule joins findings on shared gmeow:findingAnchor and compares their gmeow:findingCategory polarities."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the code-blind source anchor of a finding — the join key that lets cross-node glut detection see two different-code findings at the same place the same-fingerprint merge cannot."@x-gmeow-english .

# ════════════════════════════════════════════════════════════════════════════
# The chase-invented existential null (Skolem witness) and its head ordinal.
#
# gmeow:InventedWitness types the object of a reasoned head quad p(x, null) the
# native existential chase mints to discharge a C ⊑ ∃p.D obligation — a rigid,
# content-addressed Skolem witness (rule + existential ordinal + frontier
# binding), recognized also by the /skolem/ IRI prefix. It is NOT a
# gmeow:Finding: the certificate finding points at the null-minting head-quad
# reifier via gmeow:findingDerivedFromQuad (whose object IS the null), so the
# null↔firing-rule↔frontier link is ALREADY carried by the reifier/derivation
# plane and is never re-encoded here. gmeow:existentialOrdinal records which
# 0-based existential head variable of the firing rule the null fills.
# ════════════════════════════════════════════════════════════════════════════

gmeow:InventedWitness
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Invented Witness"@x-gmeow-english ;
    skos:definition "A chase-invented existential null — a Skolem witness the native existential chase mints to satisfy a C ⊑ ∃p.D obligation. It types the OBJECT of a reasoned head quad p(x, null): when the chase fires the existential rule for a frontier binding x, it invents a fresh witness null and writes p(x, null), and that null is a gmeow:InventedWitness. It is recognized also by the /skolem/ IRI prefix its content-addressed identity is minted under (firing rule + existential ordinal + frontier binding). It is a RIGID entity that supplies its OWN principle of identity — hence a logic:Kind, never a gmeow:Finding and never rdfs:subClassOf gmeow:Finding. Its presence in the reasoned graph and the diagnostics projection is the structured, queryable proof that the existential chase actually FIRED, not a bare assertion that an existential holds."@x-gmeow-english ;
    skos:example "<https://blackcatinformatics.ca/gmeow/skolem/9f2c> a gmeow:InventedWitness ."@x-gmeow-english ;
    skos:scopeNote "IN scope: the object of a chase-minted head quad p(x, null), recognized by the /skolem/ IRI prefix under which its content-addressed identity is minted — that recognition test is the whole of membership, nothing else qualifies. OUT of scope: an authored/hand-asserted individual of any other IRI shape (even one that happens to satisfy a C ⊑ ∃p.D obligation by coincidence); a blank node standing in for an existential in a non-chase context; and, most importantly, never a gmeow:Finding or rdfs:subClassOf gmeow:Finding — the witness is the reasoned OBJECT a certificate finding cites via gmeow:findingDerivedFromQuad, not a diagnostic in its own right."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand or onto an ordinary domain individual (it types ONLY a chase-minted Skolem null, recognized by the /skolem/ IRI prefix) and avoid making it a gmeow:Finding or rdfs:subClassOf gmeow:Finding — an invented witness is the reasoned object a finding cites, never a diagnostic in its own right."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type each chase-minted existential null as a gmeow:InventedWitness as the head quad p(x, null) is written; reach it back from the certificate gmeow:Finding through gmeow:findingDerivedFromQuad, which cites the null-minting head-quad reifier whose object IS the null, so the null's firing rule and frontier ride the existing reifier/derivation plane rather than being re-encoded here."@x-gmeow-english ;
    gmeow:useWhen "Use to mark the object of a reasoned head quad p(x, null) as a chase-invented existential null — the structured, queryable proof that the native existential chase fired to discharge a C ⊑ ∃p.D obligation."@x-gmeow-english .

gmeow:existentialOrdinal
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:InventedWitness ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "existential ordinal"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The 0-based existential head-variable ordinal a chase-invented null fills in its firing rule's head — WHICH existential of the rule's head this Skolem witness witnesses. A rule head may bind several existential variables (∃p.D, ∃q.E, …); the ordinal disambiguates which one this null discharges, and is one of the three components of the witness's content-addressed identity (firing rule + existential ordinal + frontier binding). Single-valued per gmeow:InventedWitness."@x-gmeow-english ;
    skos:example "<https://blackcatinformatics.ca/gmeow/skolem/9f2c> gmeow:existentialOrdinal \"0\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    skos:scopeNote "IN scope: the 0-based index of ONE existential head variable within the SPECIFIC firing rule that minted THIS witness — a purely local, per-rule-head coordinate. OUT of scope: it is NOT a global counter over every null the chase has ever minted (two witnesses from two different firing rules can legitimately share the same ordinal, e.g. both 0, because each indexes its own rule's head independently); it is NOT the witness's identity by itself (identity is the triple of firing rule + ordinal + frontier binding, never the ordinal alone); and it does NOT vary once minted — it is single-valued per gmeow:InventedWitness, fixed at mint time."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it as a global counter of minted nulls or as the null's identity on its own (it is ONE component of the content-addressed identity, alongside the firing rule and the frontier binding) and avoid a 1-based reading — the ordinal is 0-based over the firing rule's existential head variables."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Record on each gmeow:InventedWitness the 0-based index of the existential head variable it fills in its firing rule's head; join it with the firing rule and frontier binding (carried by the reifier the certificate finding cites via gmeow:findingDerivedFromQuad) to reconstruct which existential the null discharges."@x-gmeow-english ;
    gmeow:useWhen "Use to record which existential head-variable ordinal (0-based) a chase-invented null fills in its firing rule's head — the head-position component of the witness's content-addressed identity."@x-gmeow-english .

# ════════════════════════════════════════════════════════════════════════════
# The diagnostic meta-reasoning fold.
#
# gmeow:DiagnosticMetaRule tags a logic:Rule as a member of the fold the
# carrier-compose reasoner runs over the PROJECTED diagnostic graph: it discovers
# every rule of this type and applies it, so a new meta-finding (root-cause,
# cluster, cross-node glut, …) is added by authoring a new tagged rule with ZERO
# engine change. Root-cause, cluster, and cross-node-glut rules are its first
# members.
# ════════════════════════════════════════════════════════════════════════════

gmeow:DiagnosticMetaRule
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Diagnostic Meta-Rule"@x-gmeow-english ;
    rdfs:subClassOf logic:Rule ;
    skos:definition "The tag marking a logic:Rule as a member of the diagnostic meta-reasoning fold — the set of rules the carrier-compose reasoner discovers and runs over the PROJECTED diagnostic graph (the gmeow:Finding named graph), deriving meta-findings ABOUT the findings rather than about the data. Because membership is a type, the reasoner enumerates every gmeow:DiagnosticMetaRule and applies it: a new meta-finding kind — a new root-cause, cluster, or cross-node-glut derivation — is added by authoring a new tagged rule, with zero engine change. Its first members are the root-cause (gmeow:findingRootCause), cluster (gmeow:findingCluster / gmeow:clusterRoot), and cross-node-glut (gmeow:CrossNodeGlutWitness) rules."@x-gmeow-english ;
    skos:example "ex:ruleFindingRootCause a gmeow:DiagnosticMetaRule ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid tagging an ordinary data-level rule with it (the fold runs only over the projected diagnostic graph, deriving findings-about-findings) and avoid special-casing a meta-finding in the engine (author a new tagged rule instead); the tag IS the extension point."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type a logic:Rule that reasons over the projected diagnostic graph as a gmeow:DiagnosticMetaRule; the carrier-compose reasoner enumerates every such rule and runs it, so no wiring is needed beyond the type assertion."@x-gmeow-english ;
    gmeow:useWhen "Use to enrol a logic:Rule in the diagnostic meta-reasoning fold — the discovered-and-run set that derives root-cause, cluster, and cross-node-glut meta-findings over the projected diagnostic graph."@x-gmeow-english .

# ════════════════════════════════════════════════════════════════════════════
# The Belnap coherence polarity of a finding kind (FindingCategory::polarity()).
#
# REUSE of the existing logic: information vocabulary: gmeow:categoryPolarity
# wires each logic:FindingCategory to a value of the existing logic:InformationState
# Belnap value class (logic:InfoSupported / logic:InfoOpposed / logic:InfoNeither),
# NOT a parallel gmeow: polarity vocabulary. A witnessed defect is evidence a
# defect is present (Supported); a permitted epistemic conflict is evidence the
# apparent contradiction is coherent (Opposed); every other kind takes no
# coherence stance (Neither).
# ════════════════════════════════════════════════════════════════════════════

gmeow:categoryPolarity
    a owl:ObjectProperty ;
    rdfs:domain logic:FindingCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "category polarity"@x-gmeow-english ;
    rdfs:range logic:InformationState ;
    skos:definition "Wires a logic:FindingCategory to the Belnap coherence POLARITY its KIND asserts — a value of the EXISTING logic:InformationState Belnap value class, reused rather than re-minted. The three failure kinds (logic:FindingDataShapeViolation, logic:FindingModelingDisciplineViolation, logic:FindingContradictionWitness) map to logic:InfoSupported (evidence a defect is present); logic:FindingPermittedEpistemicConflict maps to logic:InfoOpposed (evidence the apparent contradiction is coherent); the other six (logic:FindingUnsupportedSemanticFeature, logic:FindingIncompleteCheck, logic:FindingProjectionLoss, logic:FindingPolicyWarning, logic:FindingCorroboration, logic:FindingTransientChatter) map to logic:InfoNeither (no coherence stance). It mirrors the Rust FindingCategory::polarity(); a cross-node-glut rule reads this projection to detect two findings at one anchor whose polarities OPPOSE. Distinct axis from gmeow:categoryBlocking (the gating projection): polarity is the coherence stance, blocking is the gate contribution."@x-gmeow-english ;
    skos:example "logic:FindingContradictionWitness gmeow:categoryPolarity logic:InfoSupported ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a parallel gmeow: polarity vocabulary (reuse the logic:InformationState Belnap values) and avoid conflating it with gmeow:categoryBlocking (the gating axis) or gmeow:findingSeverity (the grade); categoryPolarity is the coherence stance a kind of finding asserts."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one gmeow:categoryPolarity per logic:FindingCategory, mirroring FindingCategory::polarity(); a cross-node-glut meta-rule joins two findings on a shared gmeow:findingAnchor and flags a glut when their categories' polarities are opposing Belnap values."@x-gmeow-english ;
    gmeow:useWhen "Use to state a finding kind's Belnap coherence polarity — whether the kind asserts a defect is present (Supported), that the apparent contradiction is coherent (Opposed), or takes no stance (Neither) — reusing the logic:InformationState value class."@x-gmeow-english .

# ── The Belnap coherence POLARITY of each logic:FindingCategory (FindingCategory::polarity()).
# The three failure kinds project to logic:InfoSupported; the permitted-conflict kind to
# logic:InfoOpposed; the other five to logic:InfoNeither. This is the single asserted source
# a cross-node-glut rule reads to detect opposing-polarity findings at one anchor.
logic:FindingDataShapeViolation gmeow:categoryPolarity logic:InfoSupported .
logic:FindingModelingDisciplineViolation gmeow:categoryPolarity logic:InfoSupported .
logic:FindingContradictionWitness gmeow:categoryPolarity logic:InfoSupported .
logic:FindingPermittedEpistemicConflict gmeow:categoryPolarity logic:InfoOpposed .
logic:FindingUnsupportedSemanticFeature gmeow:categoryPolarity logic:InfoNeither .
logic:FindingIncompleteCheck gmeow:categoryPolarity logic:InfoNeither .
logic:FindingProjectionLoss gmeow:categoryPolarity logic:InfoNeither .
logic:FindingPolicyWarning gmeow:categoryPolarity logic:InfoNeither .
logic:FindingCorroboration gmeow:categoryPolarity logic:InfoNeither .
logic:FindingTransientChatter gmeow:categoryPolarity logic:InfoNeither .

# ════════════════════════════════════════════════════════════════════════════
# The reasoner-derived meta-findings.
#
# The following predicates and classes are asserted ONLY by the diagnostic
# meta-reasoning fold (gmeow:DiagnosticMetaRule), never authored by hand — exactly
# like gmeow:findingGateVerdict. Only their SCHEMA is authored here; instances are
# materialized by the reasoner over the projected diagnostic graph.
# ════════════════════════════════════════════════════════════════════════════

gmeow:findingRootCause
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding root cause"@x-gmeow-english ;
    rdfs:range gmeow:Finding ;
    skos:definition "The shared ROOT antecedent of a finding — a childless witness reached by following gmeow:findingAntecedent transitively up the witness DAG. Honestly the shared root antecedent, NOT a lowest-common-dominator: it names a root the finding derives from, without claiming that root is the unique nearest common cause. DERIVED by a diagnostic meta-rule (gmeow:DiagnosticMetaRule) over the projected diagnostic graph, never authored by hand; two findings sharing a gmeow:findingRootCause are grouped by gmeow:findingCluster."@x-gmeow-english ;
    skos:example "ex:witnessF3 gmeow:findingRootCause ex:rootF1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand (it is derived by a gmeow:DiagnosticMetaRule from gmeow:findingAntecedent) and avoid reading it as a lowest-common-dominator; it is honestly the shared root antecedent, not the unique nearest common cause."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it off the reasoned graph after the root-cause meta-rule has fired; it points at a childless root antecedent up the gmeow:findingAntecedent DAG, the value gmeow:findingCluster groups findings under."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the derived shared root antecedent of a finding so a consumer can group findings by common cause without re-walking the witness DAG."@x-gmeow-english .

gmeow:FindingCluster
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Finding Cluster"@x-gmeow-english ;
    skos:definition "A reasoner-minted grouping of findings that share one gmeow:findingRootCause — the readable 'N findings share root R' surface. DERIVED by a diagnostic meta-rule (gmeow:DiagnosticMetaRule) over the projected diagnostic graph, never authored by hand: its members are the findings linked to it by gmeow:findingCluster, and its shared root is carried by gmeow:clusterRoot. It exists to render root-cause grouping as a first-class, queryable node rather than a repeated per-finding annotation."@x-gmeow-english ;
    skos:example "ex:cluster1 a gmeow:FindingCluster ; gmeow:clusterRoot ex:rootF1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring a FindingCluster by hand (it is derived by a gmeow:DiagnosticMetaRule) and avoid using it where a single gmeow:findingRootCause edge suffices; the cluster is the readable grouping node for many findings under one root."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Read a FindingCluster off the reasoned graph: its gmeow:clusterRoot is the shared root and its members are the findings pointing at it through gmeow:findingCluster; render it as the 'N findings share root R' grouping."@x-gmeow-english ;
    gmeow:useWhen "Use as the reasoner-derived grouping node that gathers the findings sharing one root cause into a single readable surface."@x-gmeow-english .

gmeow:findingCluster
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding cluster"@x-gmeow-english ;
    rdfs:range gmeow:FindingCluster ;
    skos:definition "The membership edge from a finding to the gmeow:FindingCluster that gathers it with the other findings sharing its gmeow:findingRootCause — the 'this finding belongs to that group' link of the readable 'N findings share root R' surface. DERIVED by a diagnostic meta-rule (gmeow:DiagnosticMetaRule), never authored by hand; the cluster's shared root is reached from the cluster through gmeow:clusterRoot."@x-gmeow-english ;
    skos:example "ex:witnessF3 gmeow:findingCluster ex:cluster1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand (it is derived) and avoid pointing it at a raw root finding (that is the cluster's gmeow:clusterRoot); findingCluster names the finding's membership in a derived grouping node."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it off the reasoned graph to find the gmeow:FindingCluster a finding belongs to; follow the cluster's gmeow:clusterRoot for the shared root the group gathers under."@x-gmeow-english ;
    gmeow:useWhen "Use to carry a finding's membership in its derived root-cause cluster so a consumer can list every finding in one group."@x-gmeow-english .

gmeow:clusterRoot
    a owl:ObjectProperty ;
    rdfs:domain gmeow:FindingCluster ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "cluster root"@x-gmeow-english ;
    rdfs:range gmeow:Finding ;
    skos:definition "The shared root a gmeow:FindingCluster groups under — the single gmeow:findingRootCause every member of the cluster shares, carried once on the cluster node so the readable 'N findings share root R' surface names R exactly once. DERIVED by a diagnostic meta-rule (gmeow:DiagnosticMetaRule), never authored by hand; the members of the cluster reach it via gmeow:findingCluster and each member's gmeow:findingRootCause equals it."@x-gmeow-english ;
    skos:example "ex:cluster1 gmeow:clusterRoot ex:rootF1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand (it is derived) and avoid conflating it with a member's gmeow:findingRootCause (that is per-finding); clusterRoot is the one shared root carried on the grouping node."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it off the reasoned graph as the shared root of a gmeow:FindingCluster; it equals the gmeow:findingRootCause of every finding linked to the cluster by gmeow:findingCluster."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the shared root of a derived finding cluster once on the cluster node, the R in the 'N findings share root R' surface."@x-gmeow-english .

gmeow:CrossNodeGlutWitness
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Cross-Node Glut Witness"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Finding ;
    skos:definition "A reasoner-minted meta-finding recording a cross-node glut: two findings at ONE gmeow:findingAnchor whose logic:FindingCategory polarities (gmeow:categoryPolarity) OPPOSE — a Supported/Opposed clash the same-fingerprint merge cannot detect because the merge keys on the code, and the two conflicting findings carry different codes. It is itself a gmeow:Finding (so it carries its own gmeow:findingSeverity / gmeow:findingStandpoint grade and gmeow:findingCategory polarity) minted by a diagnostic meta-rule (gmeow:DiagnosticMetaRule), never authored by hand; it links to the two conflicting findings through gmeow:glutWitnessOf. The glut it witnesses is a coherence conflict SURFACED across codes, not a gate failure."@x-gmeow-english ;
    skos:example "ex:glut1 a gmeow:CrossNodeGlutWitness ; gmeow:glutWitnessOf ex:f1 , ex:f2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring it by hand (it is minted by a gmeow:DiagnosticMetaRule from opposing gmeow:categoryPolarity at one gmeow:findingAnchor) and avoid reading it as a gate failure; it is an informational cross-code coherence witness the same-fingerprint merge structurally misses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Read a CrossNodeGlutWitness off the reasoned graph: its two gmeow:glutWitnessOf links name the conflicting findings, and its own grade and polarity carry how the glut is surfaced; render it as a 'these two findings at one anchor disagree' note."@x-gmeow-english ;
    gmeow:useWhen "Use as the reasoner-derived meta-finding for a cross-node glut — two opposing-polarity findings at one anchor the same-fingerprint merge cannot detect across codes."@x-gmeow-english .

gmeow:glutWitnessOf
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CrossNodeGlutWitness ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "glut witness of"@x-gmeow-english ;
    rdfs:range gmeow:Finding ;
    skos:definition "Links a gmeow:CrossNodeGlutWitness to each of the two conflicting findings it witnesses — the findings at one shared gmeow:findingAnchor whose gmeow:categoryPolarity values oppose. A glut witness carries exactly two gmeow:glutWitnessOf edges, one per side of the coherence conflict. DERIVED by a diagnostic meta-rule (gmeow:DiagnosticMetaRule), never authored by hand."@x-gmeow-english ;
    skos:example "ex:glut1 gmeow:glutWitnessOf ex:f1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand (it is derived) and avoid pointing it at more or fewer than the two conflicting findings; glutWitnessOf names exactly the two opposing-polarity findings a cross-node glut witnesses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read the two gmeow:glutWitnessOf edges of a gmeow:CrossNodeGlutWitness off the reasoned graph to recover the conflicting findings; each points at a gmeow:Finding sharing the witness's anchor."@x-gmeow-english ;
    gmeow:useWhen "Use to link a cross-node glut witness to the two opposing-polarity findings it records, so a consumer can resolve the glut to its conflicting sides."@x-gmeow-english .

# ════════════════════════════════════════════════════════════════════════════
# The meta-reasoning helper vocabulary — the intermediate derived predicates and
# marker classes the gmeow:DiagnosticMetaRule fold produces and consumes.
#
# Like the reasoner-derived meta-findings above, these are asserted ONLY by the
# meta-reasoning fold (or, for gmeow:NonTrivialAnchor, by the diagnostics
# projection), never authored by hand. gmeow:findingTraces is the transitive
# closure of gmeow:findingAntecedent; gmeow:findingHasAntecedent (a self-edge on
# its own relation, not rdf:type) marks the non-root findings the root-cause NAF
# rule negates over; gmeow:NonTrivialAnchor
# is the projection-set guard that keeps the cross-node-glut join off the shared
# empty anchor of locationless findings; gmeow:crossNodeGlutWith is the derived
# edge form of a cross-node glut (a fresh witness node is not expressible in the
# reified-Horn chase, so the glut is carried as a directed edge from the
# Supported-polarity finding to the Opposed-polarity one); gmeow:RootFinding
# marks a finding that is some finding's derived root cause.
# ════════════════════════════════════════════════════════════════════════════

gmeow:findingTraces
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding traces"@x-gmeow-english ;
    rdfs:range gmeow:Finding ;
    skos:definition "The transitive closure of gmeow:findingAntecedent — the reachability edge from a finding to every antecedent it derives from, directly or through a chain of intermediate witnesses up the provenance DAG. DERIVED by the diagnostic meta-reasoning fold (gmeow:DiagnosticMetaRule) as two positive-Horn rules (a base case over gmeow:findingAntecedent and a recursive step), never authored by hand; it is the intermediate predicate the root-cause rule reads to reach a finding's childless root antecedent. Distinct from gmeow:findingAntecedent (the single-step edge): findingTraces is its reflexive-free transitive closure."@x-gmeow-english ;
    skos:example "ex:witnessF4 gmeow:findingTraces ex:rootF1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand (it is derived as the transitive closure of gmeow:findingAntecedent) and avoid conflating it with the single-step gmeow:findingAntecedent or with the terminal gmeow:findingRootCause; findingTraces reaches EVERY antecedent up the chain, not just the immediate one or the root."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it off the reasoned graph as 'every antecedent this finding derives from, transitively'; the root-cause meta-rule filters it to the antecedents that themselves have no antecedent."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the derived transitive reachability of a finding over the witness DAG — the intermediate the root-cause rule narrows to a childless root."@x-gmeow-english .

gmeow:findingHasAntecedent
    a owl:ObjectProperty ,
        owl:ReflexiveProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "finding has antecedent"@x-gmeow-english ;
    rdfs:range gmeow:Finding ;
    skos:definition "The derived positive marker that a finding carries at least one gmeow:findingAntecedent — a non-root finding up the witness DAG. DERIVED by a positive-Horn diagnostic meta-rule (gmeow:DiagnosticMetaRule) from the presence of any gmeow:findingAntecedent edge, carried as a self-edge (finding → itself) so it is a one-place membership marker on a dedicated relation, never authored by hand. It exists solely as the marker the stratified-negation root-cause rule negates over: a root antecedent is exactly a finding that is NOT a gmeow:findingHasAntecedent of itself, so 'has no antecedent of its own' becomes one closed-world negated body atom. It lives on its OWN relation (not rdf:type) precisely so the negation over it introduces no negative cycle through the type predicate the downstream marker rules derive."@x-gmeow-english ;
    skos:example "ex:witnessF2 gmeow:findingHasAntecedent ex:witnessF2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand (it is derived from the presence of a gmeow:findingAntecedent edge) and avoid reading the self-edge as a real antecedent (that is gmeow:findingAntecedent); findingHasAntecedent is the internal one-place marker the root-cause rule negates to find childless roots."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the meta-rule derive the self-edge from any gmeow:findingAntecedent edge; the root-cause rule uses its ABSENCE (negation as failure) to identify a childless root antecedent, on a dedicated relation that keeps the program stratified."@x-gmeow-english ;
    gmeow:useWhen "Use as the derived positive marker of a non-root finding, on its own relation, so 'is a root' can be expressed as its stratified negation without a type-predicate cycle."@x-gmeow-english .

gmeow:NonTrivialAnchor
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Non-Trivial Anchor"@x-gmeow-english ;
    skos:definition "The marker class of a gmeow:findingAnchor that carries a genuine source position — a path or focus — as opposed to the shared default anchor that locationless findings collapse onto. Set by the diagnostics PROJECTION on exactly the anchors computed from a real (location, term role, focus), never on the empty/default anchor. It is the guard the cross-node-glut meta-rule joins on: without it, every locationless finding would share one constant anchor and the glut rule would false-join unrelated opposing-polarity findings. The projection asserts it, the rule requires it, so the glut join fires only at anchors that name a real place."@x-gmeow-english ;
    skos:example "<https://blackcatinformatics.ca/gmeow/anchor/9f2c> a gmeow:NonTrivialAnchor ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it on the empty/default anchor (that would re-open the false-join the guard exists to close) and avoid reading it as a property of the finding; it types the ANCHOR node, marking that the anchor names a real source position."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Have the projection type each gmeow:findingAnchor computed from a real path or focus as a gmeow:NonTrivialAnchor, and leave the default anchor untyped; the cross-node-glut rule requires the type so it never fires on the shared empty anchor."@x-gmeow-english ;
    gmeow:useWhen "Use to mark a finding anchor that names a real source position, gating the cross-node-glut join off the shared default anchor of locationless findings."@x-gmeow-english .

gmeow:crossNodeGlutWith
    a owl:ObjectProperty ,
        owl:SymmetricProperty ;
    rdfs:domain gmeow:Finding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "cross-node glut with"@x-gmeow-english ;
    rdfs:range gmeow:Finding ;
    skos:definition "The derived edge form of a cross-node glut — links two findings at ONE non-trivial gmeow:findingAnchor whose logic:FindingCategory polarities (gmeow:categoryPolarity) OPPOSE (a Supported/Opposed Belnap clash), the coherence conflict the same-fingerprint merge cannot detect because it keys on the code and the two findings carry different codes. DERIVED by a positive-Horn diagnostic meta-rule (gmeow:DiagnosticMetaRule) from the shared anchor and opposing polarities, never authored by hand. It is the chase-expressible projection of the gmeow:CrossNodeGlutWitness meta-finding: because the reified-Horn chase cannot mint a fresh witness node, the glut is carried as this directed edge from the Supported-polarity finding toward the Opposed-polarity one; a consumer that needs a reified witness materializes a gmeow:CrossNodeGlutWitness from the edge downstream. The glut it records is an informational cross-code coherence conflict, never a gate failure."@x-gmeow-english ;
    skos:example "ex:f1 gmeow:crossNodeGlutWith ex:f2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand (it is derived from opposing gmeow:categoryPolarity at one gmeow:NonTrivialAnchor) and avoid reading it as a gate failure; it is the edge form of an informational cross-code glut the same-fingerprint merge structurally misses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it off the reasoned graph as 'these two findings at one anchor disagree in coherence polarity'; it is symmetric, and a projection may reify it into a gmeow:CrossNodeGlutWitness with two gmeow:glutWitnessOf edges for consumers that want a witness node."@x-gmeow-english ;
    gmeow:useWhen "Use as the reasoner-derived, chase-expressible record of a cross-node glut — two opposing-polarity findings at one non-trivial anchor the same-fingerprint merge cannot see across codes."@x-gmeow-english .

gmeow:RootFinding
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Root Finding"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Finding ;
    skos:definition "The derived class of a finding that is the gmeow:findingRootCause of at least one other finding — a childless root antecedent that some downstream witness derives from. DERIVED by a positive-Horn diagnostic meta-rule (gmeow:DiagnosticMetaRule) from the range of gmeow:findingRootCause, never authored by hand. It surfaces 'this finding is the root of a witness chain' as a queryable one-place marker so a consumer can list the root causes directly rather than collecting the range of gmeow:findingRootCause; it is stratified above the root-cause derivation and fires through the same class-based meta-rule discovery, demonstrating that a new meta-finding is added by authoring a tagged rule with no engine change."@x-gmeow-english ;
    skos:example "ex:rootF1 a gmeow:RootFinding ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring it by hand (it is derived from being some finding's gmeow:findingRootCause) and avoid reading it as a severity or a defect kind; it marks a finding's structural position as a witnessed root, nothing more."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Read it off the reasoned graph to list the root causes directly; the meta-rule derives it from the object position of gmeow:findingRootCause."@x-gmeow-english ;
    gmeow:useWhen "Use as the derived one-place marker of a witnessed root antecedent, the queryable head of the root-cause grouping."@x-gmeow-english .

# ════════════════════════════════════════════════════════════════════════════
# Reified conformance comparisons and per-corpus agreement tallies — the
# benchmark/finding-adjacent surface of the external-corpus grading fold. Each
# gmeow:ConformanceComparison reifies one native↔published verdict comparison
# and each gmeow:CorpusAgreementTally its per-corpus aggregate, riding in the
# graph/conformance named graph beside the divergence gmeow:Finding graph. The
# verdict values (logic:ConfConsistent/logic:ConfInconsistent/logic:ConfIncomplete)
# and the raw token stay in the logic: reasoning vocabulary; a gmeow:→logic:
# cross-slice reference is fine.
# ════════════════════════════════════════════════════════════════════════════

gmeow:VerdictLatticeRelation
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Verdict Lattice Relation"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The closed value class of how a native conformance verdict stands to a published one within the logic:ConformanceVerdict lattice — the reified qualitative outcome of one native↔published comparison. Its three named individuals are gmeow:VerdictEquivalent (the two verdicts coincide — an agreement), gmeow:VerdictWeaker (the native verdict is strictly less informative — the native-incomplete case, where logic:ConfIncomplete is the ⊤ join above the decided published verdict), and gmeow:VerdictIncomparable (two DISTINCT decided verdicts that share only the ⊤ join — a genuine disagreement). It is the RDF image of the DivergenceKind a conformance comparison receives: gmeow:VerdictEquivalent ↔ Agree, gmeow:VerdictWeaker ↔ DlGap (native `incomplete`), gmeow:VerdictIncomparable ↔ CorpusOnly. The set is closed, so a misspelt relation names no declared value and is rejected."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:VerdictEquivalent
    a owl:NamedIndividual ,
        gmeow:VerdictLatticeRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Verdict Equivalent"@x-gmeow-english ;
    skos:definition "The gmeow:VerdictLatticeRelation for a native verdict that coincides with the published one: native ≡ published in the logic:ConformanceVerdict lattice. The reified image of the Agree DivergenceKind — the qualitative outcome a corroborating conformance comparison carries, folded as a non-blocking logic:FindingCorroboration rather than dropped."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:VerdictWeaker
    a owl:NamedIndividual ,
        gmeow:VerdictLatticeRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Verdict Weaker"@x-gmeow-english ;
    skos:definition "The gmeow:VerdictLatticeRelation for a native verdict that is strictly LESS informative than the published one: the native path returned logic:ConfIncomplete — the least-informative join (⊤) — where the community source decided a verdict. The reified image of the DlGap DivergenceKind (native `incomplete`): an honest native coverage gap, kept strictly distinct from a disagreement between two decided verdicts."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:VerdictIncomparable
    a owl:NamedIndividual ,
        gmeow:VerdictLatticeRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Verdict Incomparable"@x-gmeow-english ;
    skos:definition "The gmeow:VerdictLatticeRelation for two DISTINCT decided verdicts that share only the least-informative join: the native path decided one informative meet-element (logic:ConfConsistent or logic:ConfInconsistent) and the community source decided the other. The reified image of the CorpusOnly DivergenceKind — a genuine native↔published disagreement, folded as a BLOCKING logic:FindingContradictionWitness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:ConformanceComparison
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Conformance Comparison"@x-gmeow-english ;
    skos:definition "A reified native↔published verdict comparison for a single external-corpus case in a single world — the folded, content-addressed individual that records one row of the conformance grading in the reasoned bundle, so EVERY comparison (agreement, coverage gap, or disagreement) is retained as first-class ontological data rather than only the divergent rows surviving as findings. It carries the case coordinates (gmeow:comparisonCorpus, gmeow:comparisonCase, gmeow:comparisonWorld), the two graded verdicts (gmeow:comparisonNativeVerdict and gmeow:comparisonPublishedVerdict, each a logic:ConformanceVerdict), the verbatim published token (logic:rawStatusToken) as provenance, and the derived gmeow:comparisonLatticeRelation classifying how the native verdict stands to the published one. Rides in the graph/conformance named graph beside the divergence gmeow:Finding graph it is the aggregate-preserving twin of."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:CorpusAgreementTally
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Corpus Agreement Tally"@x-gmeow-english ;
    skos:definition "One external corpus's aggregate native↔published tally — the folded, content-addressed individual that records a corpus's partition of graded comparisons into agree / corpus-only / dl-gap counts, so the reasoned bundle carries the per-corpus pass rate as first-class ontological data rather than only in the projected markdown dashboard. It carries gmeow:tallyCorpus (the corpus name), gmeow:tallyCases (the total graded), and the three partition counts gmeow:tallyAgree, gmeow:tallyCorpusOnly and gmeow:tallyDlGap, whose sum equals gmeow:tallyCases by construction. The aggregate twin of the per-case gmeow:ConformanceComparison individuals, riding in the same graph/conformance named graph."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:comparisonCorpus
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "comparison corpus"@x-gmeow-english ;
    skos:definition "The external-corpus name a gmeow:ConformanceComparison belongs to — the cases/external/<corpus>/ directory whose native↔published grading this comparison reifies. Domain gmeow:ConformanceComparison, range xsd:string (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:comparisonCase
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "comparison case"@x-gmeow-english ;
    skos:definition "The case id a gmeow:ConformanceComparison grades — the <case> subdirectory within its corpus, unique per corpus. Domain gmeow:ConformanceComparison, range xsd:string (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:comparisonWorld
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "comparison world"@x-gmeow-english ;
    skos:definition "The scoped world IRI a gmeow:ConformanceComparison's verdicts were decided in — the single world a committed external case scopes its premises to. Domain gmeow:ConformanceComparison, range xsd:string (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:comparisonNativeVerdict
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "comparison native verdict"@x-gmeow-english ;
    skos:definition "The logic:ConformanceVerdict the native reasoner decided for a gmeow:ConformanceComparison's case/world. Domain gmeow:ConformanceComparison, range logic:ConformanceVerdict (stated in prose) — the RDF image of the native runner's verdict-status token."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:comparisonPublishedVerdict
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "comparison published verdict"@x-gmeow-english ;
    skos:definition "The logic:ConformanceVerdict the community source published as the ground truth for a gmeow:ConformanceComparison's case/world. Domain gmeow:ConformanceComparison, range logic:ConformanceVerdict (stated in prose) — the coarse projection of the verbatim published token preserved alongside on logic:rawStatusToken."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:comparisonLatticeRelation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "comparison lattice relation"@x-gmeow-english ;
    skos:definition "The gmeow:VerdictLatticeRelation classifying how a gmeow:ConformanceComparison's native verdict stands to its published one, DERIVED from the two verdicts: coincident → gmeow:VerdictEquivalent, native logic:ConfIncomplete → gmeow:VerdictWeaker, two distinct decided verdicts → gmeow:VerdictIncomparable. Domain gmeow:ConformanceComparison, range gmeow:VerdictLatticeRelation (stated in prose) — the reified image of the comparison's DivergenceKind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:tallyCorpus
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "tally corpus"@x-gmeow-english ;
    skos:definition "The external-corpus name a gmeow:CorpusAgreementTally aggregates — the cases/external/<corpus>/ directory whose graded comparisons it partitions. Domain gmeow:CorpusAgreementTally, range xsd:string (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:tallyCases
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "tally cases"@x-gmeow-english ;
    skos:definition "The total graded native↔published comparisons in a gmeow:CorpusAgreementTally's corpus — the count gmeow:tallyAgree, gmeow:tallyCorpusOnly and gmeow:tallyDlGap partition. Domain gmeow:CorpusAgreementTally, range xsd:integer (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:tallyAgree
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "tally agree"@x-gmeow-english ;
    skos:definition "The number of comparisons in a gmeow:CorpusAgreementTally's corpus where the native verdict matched the published expected — the agreeing (gmeow:VerdictEquivalent) partition, folded as non-blocking corroboration. Domain gmeow:CorpusAgreementTally, range xsd:integer (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:tallyCorpusOnly
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "tally corpus-only"@x-gmeow-english ;
    skos:definition "The number of comparisons in a gmeow:CorpusAgreementTally's corpus the native path DECIDED but disagreed with the published expected — the disagreeing (gmeow:VerdictIncomparable) partition. Domain gmeow:CorpusAgreementTally, range xsd:integer (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:tallyDlGap
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "tally dl-gap"@x-gmeow-english ;
    skos:definition "The number of comparisons in a gmeow:CorpusAgreementTally's corpus the native path could not decide (native logic:ConfIncomplete) — the coverage-gap (gmeow:VerdictWeaker) partition, an honest native capability gap. Domain gmeow:CorpusAgreementTally, range xsd:integer (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ════════════════════════════════════════════════════════════════════════════
# Reified capability gaps — the ontology image of the Rust gmeow_logic::entail
# CapabilityGapShape taxonomy. Each gmeow:CapabilityGap reifies one committed
# divergence case the native reasoner honestly could not grade as a single
# refutation case (its gmeow:gapShape), riding in graph/conformance beside the
# gmeow:ConformanceComparison individuals above — the first-class ontological
# image of the agreement-matrix "Capability gaps (by shape)" breakdown.
# ════════════════════════════════════════════════════════════════════════════

gmeow:GapShape
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Gap Shape"@x-gmeow-english ;
    skos:definition "The closed value class of the structured reason a conformance conclusion could not be graded as a single refutation case — the RDF image of the Rust gmeow_logic::entail::CapabilityGapShape taxonomy. Its five named individuals are gmeow:GapShapeRoleAssertion, gmeow:GapShapeExistentialWitness, gmeow:GapShapeNativeCoverage, and gmeow:GapShapeMalformed (four genuine REASONER-FRAGMENT gaps — a conclusion shape the native DL fragment cannot soundly refute at all) and gmeow:GapShapeVendoringMultiGoal (NOT a reasoner-fragment gap — a VENDORING-FORMAT limit: dl_entails decides a conjunctive multi-triple conclusion perfectly well, as n independent refutations, but it cannot be frozen as one single-EDB consistency case). The set is closed, so a misspelt shape names no declared value and is rejected."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:GapShapeRoleAssertion
    a owl:NamedIndividual ,
        gmeow:GapShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Gap Shape Role Assertion"@x-gmeow-english ;
    skos:definition "The gmeow:GapShape for a conclusion that is a role / property assertion (a bare `a P b`, rdfs:subPropertyOf, domain/range, …): role negation is not EL-expressible, so the native DL fragment cannot refute it. A genuine reasoner-fragment gap."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:GapShapeExistentialWitness
    a owl:NamedIndividual ,
        gmeow:GapShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Gap Shape Existential Witness"@x-gmeow-english ;
    skos:definition "The gmeow:GapShape for a conclusion carrying a blank-node (existential) subject or object, which needs Skolem-witness semantics outside the ground-refutation fragment the native DL reasoner decides over. A genuine reasoner-fragment gap."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:GapShapeNativeCoverage
    a owl:NamedIndividual ,
        gmeow:GapShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Gap Shape Native Coverage"@x-gmeow-english ;
    skos:definition "The gmeow:GapShape for a conclusion the native DL engine reported a coverage gap on the reduced EDB for — it cannot honestly decide the reduction, distinct from a shape it refused up front. A genuine reasoner-fragment gap."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:GapShapeMalformed
    a owl:NamedIndividual ,
        gmeow:GapShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Gap Shape Malformed"@x-gmeow-english ;
    skos:definition "The gmeow:GapShape for a malformed conclusion triple (e.g. a literal where a class IRI is required), which the refutation calculus cannot normalize into a refutable shape. A genuine reasoner-fragment gap."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:GapShapeVendoringMultiGoal
    a owl:NamedIndividual ,
        gmeow:GapShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Gap Shape Vendoring Multi Goal"@x-gmeow-english ;
    skos:definition "The gmeow:GapShape for a conjunctive multi-triple conclusion. NOT a reasoner-fragment gap: the native reasoner CAN decide a conjunctive multi-triple conclusion via dl_entails (as n independent refutations); it is only that the frozen, single-input.nq vendoring format cannot freeze a conjunction as one single-EDB consistency case. A VENDORING-FORMAT limit, never a reasoner-fragment gap."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:isReasonerFragmentGap
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:GapShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "is reasoner fragment gap"@x-gmeow-english ;
    skos:definition "Whether a gmeow:GapShape is a genuine reasoner-fragment gap (a conclusion shape the native DL fragment cannot soundly refute at all) as opposed to a vendoring-format limit the reasoner itself can decide. Domain gmeow:GapShape, range xsd:boolean (stated in prose — an external-vocabulary rdfs:range is held out of the diagnostics slice's ungrounded-residue budget) — true for gmeow:GapShapeRoleAssertion, gmeow:GapShapeExistentialWitness, gmeow:GapShapeNativeCoverage, and gmeow:GapShapeMalformed; false for gmeow:GapShapeVendoringMultiGoal. The RDF image of gmeow_logic::entail::CapabilityGapShape::is_reasoner_fragment_gap."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:GapShapeRoleAssertion gmeow:isReasonerFragmentGap "true"^^xsd:boolean .

gmeow:GapShapeExistentialWitness gmeow:isReasonerFragmentGap "true"^^xsd:boolean .

gmeow:GapShapeNativeCoverage gmeow:isReasonerFragmentGap "true"^^xsd:boolean .

gmeow:GapShapeMalformed gmeow:isReasonerFragmentGap "true"^^xsd:boolean .

gmeow:GapShapeVendoringMultiGoal gmeow:isReasonerFragmentGap "false"^^xsd:boolean .

gmeow:CapabilityGap
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "Capability Gap"@x-gmeow-english ;
    skos:definition "A reified structured capability-gap case — one committed divergence case the native reasoner could not grade as a single refutation case — carrying its corpus (gmeow:capabilityGapCorpus), case (gmeow:capabilityGapCase), and structured shape (gmeow:gapShape). Rides in the graph/conformance named graph beside the divergence gmeow:Finding graph and the gmeow:ConformanceComparison individuals. The first-class ontological image of the agreement-matrix \"Capability gaps (by shape)\" breakdown."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:capabilityGapCorpus
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CapabilityGap ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "capability gap corpus"@x-gmeow-english ;
    skos:definition "The external-corpus name a gmeow:CapabilityGap belongs to — the cases/external/<corpus>/ directory the divergence case carrying this structured gap lives in. Domain gmeow:CapabilityGap, range xsd:string (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:capabilityGapCase
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CapabilityGap ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "capability gap case"@x-gmeow-english ;
    skos:definition "The case id a gmeow:CapabilityGap grades — the <case> subdirectory within its corpus, unique per corpus. Domain gmeow:CapabilityGap, range xsd:string (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:gapShape
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CapabilityGap ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "gap shape"@x-gmeow-english ;
    skos:definition "The gmeow:GapShape classifying why a gmeow:CapabilityGap's conclusion could not be graded as a single refutation case. Domain gmeow:CapabilityGap, range gmeow:GapShape (stated in prose) — the reified image of the case's wire gap_shape token."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

<https://blackcatinformatics.ca/gmeow/slices/diagnostics>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """The ontological face of the first-class diagnostics system.

DOCTRINE.
  * Finding IS an Observation (Principle 9): a diagnostic is not a new kind of thing but the universal claim construct applied to tooling. gmeow:Finding rdfs:subClassOf gmeow:Observation, so the tool is the gmeow:vantage (WHO observed), the offending statement is the gmeow:observedFeature (WHAT), and the severity is the gmeow:observationResult (the verdict). Generic 'all observations about X' queries find diagnostics for free.
  * Projection, not source (Principle 4): the canonical diagnostics model is the PyO3-free Rust gmeow_diagnostics::Report — it must report on a graph too broken to parse, so it cannot itself be RDF. This vocabulary is one PROJECTION of that report, a sibling of SARIF / flat JSON / HTML / CLI, materialized as a gmeow:graph/diagnostics named graph embedded in the feedback .gts bundle so the report rides with the data it describes and is SPARQL-queryable.
  * Located by wire coordinates: a finding's gmeow:findingLocation points at the reified statement it concerns (rdf:reifies <<( s p o )>> in the RDF 1.2 form); gmeow:gtsQuadIndex / gmeow:gtsTermId / gmeow:gtsReifierId / gmeow:gtsFrameIndex / gmeow:gtsSegmentIndex pin the exact position inside the GTS bundle, the same coordinates carried in SARIF logicalLocations.
  * Severity is a value, not a subclass (Principle 9): gmeow:DiagnosticSeverity is an open gufo:QualityValue vocabulary (error · warning · note · info), individuals never subclasses.
  * Tool provenance reuses agentic (Principle 5 / Principle 6): a finding is gmeow:wasGeneratedBy a gmeow:ToolCall whose gmeow:usedTool is the validator; gmeow:findingTool carries the tool's short name for the flat 80% surface. No forward output property."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "GMEOW Diagnostics Module"@x-gmeow-english ;
    skos:definition "The GMEOW Diagnostics Module — gmeow:Finding as a specialization of gmeow:Observation: a validation, lint, or reasoning diagnostic modelled as a reified observation about an RDF statement, with the tool as gmeow:vantage, the offending statement (located by GTS wire coordinates) as gmeow:observedFeature, and a gmeow:DiagnosticSeverity verdict as gmeow:observationResult. The gmeow: RDF projection of the Rust-owned Finding/Report engine model."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Declarative constraint axioms (core slices) — the closed-world
# cardinality / class / datatype obligations the hand-authored shapes.ttl
# NodeShapes state, authored here once as OWL restriction axioms and PROJECTED
# to generated/shapes/validation-shapes.ttl by derive_validation_shapes
# (Principle 17). A restriction carrying both owl:*Cardinality and
# owl:allValuesFrom lowers to the paired sh:minCount/maxCount + sh:class /
# sh:datatype property shape. The cross-node / value-range / disjunctive
# (sh:sparql, sh:or, numeric range, node-shape) conditions have no OWL
# antecedent and remain the procedural fragment .
# =========================================================================== #

gmeow:Finding rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:findingSeverity ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:DiagnosticSeverity ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:findingCode ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:findingMessage ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:string ] .

gmeow:CrossNodeGlutWitness rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:glutWitnessOf ; owl:maxQualifiedCardinality 2 ; owl:onClass gmeow:Finding ] .

# exact-one minCount restoration (issue #1194): min-qualified sibling restrictions
# restoring sh:minCount for the reasoner-safe max-qualified exact-one antecedents.
<https://blackcatinformatics.ca/gmeow/Finding> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/findingSeverity> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/gmeow/DiagnosticSeverity> ] .
<https://blackcatinformatics.ca/gmeow/Finding> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/findingCode> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onDataRange> <http://www.w3.org/2001/XMLSchema#string> ] .
<https://blackcatinformatics.ca/gmeow/Finding> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/findingMessage> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onDataRange> <http://www.w3.org/2001/XMLSchema#string> ] .
<https://blackcatinformatics.ca/gmeow/CrossNodeGlutWitness> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/glutWitnessOf> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "2"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/gmeow/Finding> ] .

# =========================================================================== #
# Gate-fatal up-set constraint (#1194): the procedural gmeow:GateFatalUpsetShape #
# migrated to a raw logic:Formula integrity tree projected to a                 #
# sh:SPARQLConstraint carrying a sh:SPARQLTarget. It formalizes                 #
# logic:ruleGateFatalVerdict (no targetClass), so its projected twin keys onto   #
# the same source-term the hand-authored shape did. A gmeow:Finding on the       #
# principal up-set ↑(severityError, blockingBlocking, standpointBinding) must     #
# carry the derived verdict gmeow:findingGateVerdict gmeow:gateFatal.            #
# =========================================================================== #

gmeow:GateFatalUpsetConstraint
    a logic:Constraint ;
    rdfs:label "Gate-fatal up-set constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (Principle 17): a gmeow:Finding on the principal gate-fatal up-set — severity gmeow:severityError, category projecting through gmeow:categoryBlocking to gmeow:blockingBlocking, and standpoint gmeow:standpointBinding — must carry the derived verdict gmeow:findingGateVerdict gmeow:gateFatal. A finding meeting the up-set antecedent but lacking the fatal verdict violates the SHACL image of logic:ruleGateFatalVerdict."@x-gmeow-english ;
    logic:formalizes logic:ruleGateFatalVerdict ;
    logic:severity "Violation" ;
    logic:message "A finding on the gate-fatal up-set (severity error, category projecting to blocking, standpoint binding) must carry gmeow:findingGateVerdict gmeow:gateFatal — the derived verdict of logic:ruleGateFatalVerdict is missing." ;
    logic:integrity logic:gateFatalForall .
logic:gateFatalForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:gateFatalImpl .
logic:gateFatalImpl a logic:Formula ; logic:antecedent logic:gateFatalTarget ; logic:consequent logic:gateFatalVerdict .
logic:gateFatalTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral """SELECT ?this WHERE {
    ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* <https://blackcatinformatics.ca/gmeow/Finding> .
    ?this <https://blackcatinformatics.ca/gmeow/findingSeverity> <https://blackcatinformatics.ca/gmeow/severityError> .
    ?this <https://blackcatinformatics.ca/gmeow/findingStandpoint> <https://blackcatinformatics.ca/gmeow/standpointBinding> .
    ?this <https://blackcatinformatics.ca/gmeow/findingCategory> ?cat .
    ?cat <https://blackcatinformatics.ca/gmeow/categoryBlocking> <https://blackcatinformatics.ca/gmeow/blockingBlocking> .
}""" ] .
logic:gateFatalVerdict a logic:Formula ; logic:relation gmeow:findingGateVerdict ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:gateFatal ] .

# =========================================================================== #
# Capability-gap fragment-classification constraint (#930): a closed-world      #
# integrity tree that makes gmeow:isReasonerFragmentGap LOAD-BEARING at         #
# reason/verify time. Every reified gmeow:CapabilityGap must reference (via      #
# gmeow:gapShape) a gmeow:GapShape that carries a gmeow:isReasonerFragmentGap    #
# boolean value; a gap whose gap-shape lacks the reasoner-fragment / vendoring- #
# format classification is incoherent and is a validation violation. Authored   #
# in logic: ONLY (no hand-authored sh:NodeShape); projected to a                 #
# sh:SPARQLConstraint carrying a sh:SPARQLTarget (no targetClass), formalizing   #
# gmeow:isReasonerFragmentGap. This is the SEMANTIC consumer that closes the     #
# dark-feature gap in which the boolean was read only by structural schema       #
# projection (LinkML/TS/GraphQL/Python). (Principle 17; design/LOGIC-VALIDATION.md.) #
# =========================================================================== #

gmeow:CapabilityGapFragmentClassificationConstraint
    a logic:Constraint ;
    rdfs:label "Capability-gap fragment-classification constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (Principle 17) that makes gmeow:isReasonerFragmentGap load-bearing at reason/verify time: every reified gmeow:CapabilityGap MUST reference via gmeow:gapShape a gmeow:GapShape that carries a gmeow:isReasonerFragmentGap boolean value. A capability gap whose gmeow:gapShape is absent, or whose gap-shape lacks the reasoner-fragment / vendoring-format classification, is incoherent — a divergence case the agreement matrix cannot partition — and is a validation violation. Adding a new gmeow:GapShape individual without the boolean (or mis-pointing a gmeow:CapabilityGap) therefore reddens the verify gate, closing the dark-feature gap in which the boolean was consumed only by structural schema projection (LinkML/TS/GraphQL/Python)."@x-gmeow-english ;
    logic:formalizes gmeow:isReasonerFragmentGap ;
    logic:severity "Violation" ;
    logic:message "A gmeow:CapabilityGap must reference via gmeow:gapShape a gmeow:GapShape carrying a gmeow:isReasonerFragmentGap boolean value — the reasoner-fragment classification consumed by this integrity guard is missing." ;
    logic:integrity logic:capabilityGapFragmentForall .
logic:capabilityGapFragmentForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:capabilityGapFragmentImpl .
logic:capabilityGapFragmentImpl a logic:Formula ; logic:antecedent logic:capabilityGapFragmentTarget ; logic:consequent logic:capabilityGapFragmentClassified .
logic:capabilityGapFragmentTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral """SELECT ?this WHERE {
    ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://blackcatinformatics.ca/gmeow/CapabilityGap> .
}""" ] .
logic:capabilityGapFragmentClassified a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "gs" ] ,
        [ logic:termIndex 1 ; logic:termVariable "frag" ] ;
    logic:exists logic:capabilityGapFragmentWitness .
logic:capabilityGapFragmentWitness a logic:Formula ;
    logic:and logic:capabilityGapFragmentHasShape , logic:capabilityGapFragmentShapeClassified .
logic:capabilityGapFragmentHasShape a logic:Formula ; logic:relation gmeow:gapShape ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "gs" ] .
logic:capabilityGapFragmentShapeClassified a logic:Formula ; logic:relation gmeow:isReasonerFragmentGap ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "gs" ] , [ logic:termIndex 1 ; logic:termVariable "frag" ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/CrossNodeGlutWitness> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/glutWitnessOf> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/Finding> ] .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:existentialOrdinalFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "existentialOrdinal is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:existentialOrdinal is functional: a chase-invented gmeow:InventedWitness discharges exactly one existential head-variable of its firing rule, so it carries a single 0-based ordinal that is one of the three components of its content-addressed identity."@x-gmeow-english ;
    logic:characterizes gmeow:existentialOrdinal ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:existentialOrdinal ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:existentialOrdinal names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:existentialOrdinal, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:existentialOrdinal and nothing else. It is not a definition of gmeow:existentialOrdinal (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:existentialOrdinalFunctionality logic:characterizes gmeow:existentialOrdinal ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:findingCodeFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "findingCode is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:findingCode is functional: a gmeow:Finding carries exactly one stable rule identifier, serving as its SARIF ruleId and the single key by which findings are grouped and suppressed."@x-gmeow-english ;
    logic:characterizes gmeow:findingCode ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:findingCode ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:findingCode names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:findingCode, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:findingCode and nothing else. It is not a definition of gmeow:findingCode (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:findingCodeFunctionality logic:characterizes gmeow:findingCode ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:findingMessageFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    rdfs:label "findingMessage is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:findingMessage is functional: a gmeow:Finding carries exactly one human-readable message describing that occurrence, distinct from its single stable code."@x-gmeow-english ;
    logic:characterizes gmeow:findingMessage ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:findingMessage ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:findingMessage names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:findingMessage, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:findingMessage and nothing else. It is not a definition of gmeow:findingMessage (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:findingMessageFunctionality logic:characterizes gmeow:findingMessage ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
