    logic:message "A tagDreamEligible assertion classifies an actual WorldAffordance catalog record. It preserves reported dream eligibility without granting permission or proving tool effects."@x-gmeow-english ;
    logic:formalizes gmeow:hasTag ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:hasTag ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:tagDreamEligible ] ] ; logic:consequent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:WorldAffordance ] ] ] ] .
