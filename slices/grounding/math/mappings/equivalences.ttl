    gmeow:confidence 1.0 ;
    gmeow:objectLabel "sigma-algebra" ;
    gmeow:comment "math:SigmaAlgebra is a collection of subsets closed under complement and countable union; wd:Q217357 (σ-algebra) is the same structure. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqMathLebesgueMeasure a gmeow:TermEquivalence ;
    gmeow:alignSubject math:LebesgueMeasure ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q827230 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "Lebesgue measure" ;
    gmeow:comment "math:LebesgueMeasure is the translation-invariant length/area/volume measure on ℝⁿ; wd:Q827230 (Lebesgue measure) is the same measure. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqMathCountingMeasure a gmeow:TermEquivalence ;
    gmeow:alignSubject math:CountingMeasure ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q247204 ;
