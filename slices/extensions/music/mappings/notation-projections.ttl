# --------------------------------------------------------------------------- #
# PROJECTION MAPPINGS — external surface vocabularies
# --------------------------------------------------------------------------- #

gmeow:mapSchemaMusicWork a gmeow:ProjectionMapping ;
    skos:definition "Project a GMEOW musical Work to schema.org MusicWork by reference (Principle 5)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "MusicalWork → schema:MusicComposition"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "work" ;
        gmeow:atom (
            [ gmeow:subjectVar "work" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:MusicalWork ] ) ;
        gmeow:edoalSource gmeow:MusicalWork ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ;
        gmeow:toClass schema:MusicComposition ;
        gmeow:edoalTarget schema:MusicComposition ; gmeow:edoalTargetKind "class" ;
        gmeow:lossyDrop "the WEMI spine collapses: Work, Expression, and Manifestation are flattened into one schema:MusicComposition; realization mode and notation frame are lost" ] .

gmeow:mapSchemaMusicRecording a gmeow:ProjectionMapping ;
    skos:definition "Project a GMEOW musical Recording to schema.org MusicRecording by reference (Principle 5)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "Recording → schema:MusicRecording"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "rec" ;
        gmeow:atom (
            [ gmeow:subjectVar "rec" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Recording ] ) ;
        gmeow:edoalSource gmeow:Recording ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ;
        gmeow:toClass schema:MusicRecording ;
        gmeow:edoalTarget schema:MusicRecording ; gmeow:edoalTargetKind "class" ;
        gmeow:lossyDrop "recording event provenance, take/overdub structure, and standpoint-indexed performance claims collapse to a flat schema:MusicRecording" ] .

gmeow:mapSchemaMusicAlbum a gmeow:ProjectionMapping ;
    skos:definition "Project a GMEOW musical Work/Release to schema.org MusicAlbum by reference (Principle 5)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "musical release Manifestation → schema:MusicAlbum"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "rel" ;
        gmeow:atom (
            [ gmeow:subjectVar "rel" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Manifestation ]
            [ gmeow:subjectVar "rel" ; gmeow:predicate gmeow:embodies ; gmeow:objectVar "expr" ]
            [ gmeow:subjectVar "expr" ; gmeow:predicate gmeow:realizes ; gmeow:objectVar "work" ]
            [ gmeow:subjectVar "work" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:MusicalWork ] ) ;
        gmeow:edoalSource gmeow:Manifestation ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ;
        gmeow:toClass schema:MusicAlbum ;
        gmeow:edoalTarget schema:MusicAlbum ; gmeow:edoalTargetKind "class" ;
        gmeow:lossyDrop "the WEMI spine collapses; track-level frame-relative content and declared losses are lost" ] .

gmeow:mapLRMooWork a gmeow:ProjectionMapping ;
    skos:definition "Project a GMEOW musical Work to IFLA LRMoo Work by reference (Principle 5)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "MusicalWork → LRMoo F1 Work"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "work" ;
        gmeow:atom (
            [ gmeow:subjectVar "work" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:MusicalWork ] ) ;
        gmeow:edoalSource gmeow:MusicalWork ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "lrmoo" ; gmeow:relation "<=" ;
        gmeow:toClass lrmoo:F1_Work ;
        gmeow:edoalTarget lrmoo:F1_Work ; gmeow:edoalTargetKind "class" ;
        gmeow:lossyDrop "GMEOW's frame-relative content, tuning systems, and declared losses have no LRMoo home" ] .

gmeow:mapLRMooExpression a gmeow:ProjectionMapping ;
    skos:definition "Project a GMEOW musical Expression to IFLA LRMoo Expression by reference (Principle 5)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "Expression → LRMoo F2 Expression"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "expr" ;
        gmeow:atom (
            [ gmeow:subjectVar "expr" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Expression ] ) ;
        gmeow:edoalSource gmeow:Expression ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "lrmoo" ; gmeow:relation "<=" ;
        gmeow:toClass lrmoo:F2_Expression ;
        gmeow:edoalTarget lrmoo:F2_Expression ; gmeow:edoalTargetKind "class" ;
        gmeow:lossyDrop "the notation-system reference frame and loss manifest are not part of LRMoo" ] .

gmeow:mapLRMooPerformance a gmeow:ProjectionMapping ;
    skos:definition "Project a GMEOW musical Performance to IFLA LRMoo Performance by reference (Principle 5)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "musical performance Event → LRMoo F31 Performance"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "perf" ;
        gmeow:atom (
            [ gmeow:subjectVar "perf" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Event ]
            [ gmeow:subjectVar "perf" ; gmeow:predicate gmeow:eventType ; gmeow:objectValue gmeow:eventTypeMusicalPerformance ] ) ;
        gmeow:edoalSource gmeow:eventTypeMusicalPerformance ; gmeow:edoalSourceKind "relation" ] ;
    gmeow:hasBinding [
        gmeow:profile "lrmoo" ; gmeow:relation "<=" ;
        gmeow:toClass lrmoo:F31_Performance ;
        gmeow:edoalTarget lrmoo:F31_Performance ; gmeow:edoalTargetKind "class" ;
        gmeow:lossyDrop "performance-as-expression-creation flattens improvisation and standpoint-indexed participation claims" ] .

gmeow:mapMusicOntologyWork a gmeow:ProjectionMapping ;
    skos:definition "Project a GMEOW musical Work to the Music Ontology Work by reference (Principle 5)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "MusicalWork → mo:MusicalWork"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "work" ;
        gmeow:atom (
            [ gmeow:subjectVar "work" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:MusicalWork ] ) ;
        gmeow:edoalSource gmeow:MusicalWork ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "mo" ; gmeow:relation "<=" ;
        gmeow:toClass mo:MusicalWork ;
        gmeow:edoalTarget mo:MusicalWork ; gmeow:edoalTargetKind "class" ;
        gmeow:lossyDrop "Music Ontology has no note-level model, no tuning frame, and a composition-first cultural bias" ] .

gmeow:mapPONWork a gmeow:ProjectionMapping ;
    skos:definition "Project a GMEOW musical Work to the Polifonia Ontology Network Work by reference (Principle 5)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "MusicalWork → PON Music Meta Work"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "work" ;
        gmeow:atom (
            [ gmeow:subjectVar "work" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:MusicalWork ] ) ;
        gmeow:edoalSource gmeow:MusicalWork ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "pon" ; gmeow:relation "<=" ;
        gmeow:toClass pon:Work ;
        gmeow:edoalTarget pon:Work ; gmeow:edoalTargetKind "class" ;
        gmeow:lossyDrop "PON's annotation model presumes Western categories and has no tuning math" ] .

gmeow:mapJAMSSegment a gmeow:ProjectionMapping ;
    skos:definition "Project a GMEOW MusicalSegment to a JAMS segment observation by reference (Principle 5)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "MusicalSegment analysis → JAMS segment annotation"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "claim" ;
        gmeow:atom (
            [ gmeow:subjectVar "claim" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:MusicAnalysisClaim ]
            [ gmeow:subjectVar "claim" ; gmeow:predicate gmeow:analysisProperty ; gmeow:objectValue gmeow:analysisPropertySegment ] ) ;
        gmeow:edoalSource gmeow:MusicAnalysisClaim ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "jams" ; gmeow:relation "<=" ;
        gmeow:toClass jams:Segment ;
        gmeow:edoalTarget jams:Segment ; gmeow:edoalTargetKind "class" ;
        gmeow:lossyDrop "JAMS annotations are audio-time anchored, not score-anchored; vantage and theory frame are lost" ] .
