#
# Conforming fixture: a STRONG-CYCLIC logic:Plan — valid canonically even though
# its control flow contains a recovery loop. The plan retries a flaky step until
# it succeeds (logic:StrongCyclicPlanSuccess: every fair execution reaches the
# goal in finitely many steps, allowing retried loops through recoverable
# failures). It is a well-formed logic:Plan (exactly one logic:planGoal, exactly
# one logic:planSuccessMode), so it satisfies logic:PlanShape with no findings.
#
# The loop (ex:cfProbeRecover then ex:cfRecoverProbe: stepProbe -> stepRecover ->
# stepProbe, a back-edge) is what places the plan OUTSIDE the certified acyclic DAG
# fragment. The plan reaches its flow graph through logic:planFlowEdge and runs
# logic:executedUnderContract logic:DagWorkflowContract, so under the DAG-workflow
# profile (logic:DagWorkflowResource) this plan resolves to `unsupported` with the
# offending cycle members named by logic:dagCycleWitness — but the plan stays valid
# canonically here, never silently truncated. That produced `unsupported` verdict is
# exercised end-to-end (the teleology evaluator emits it, pinned by the conformance
# case conformance/logic/cases/teleology/strong-cyclic-plan) and in the shared Rust
# certifier (crates/logic dag_profile::strong_cyclic_plan_vs_its_acyclic_projection).
#
# Bound by tests/example-conformance.ttl (ex:ecDagStrongCyclicPlan, gmeow:conforms).
# Self-contained: the harness loads logic/module.ttl + ONLY this file against
# logic/shapes.ttl.
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://example.org/lgc/> .

ex:goalDataIngested a gmeow:Goal ;
    rdfs:label "data ingested despite flaky fetch (fixture)"@en .

# The strong-cyclic plan: valid canonically, with a retry loop in its control flow.
# It reaches its flow graph through logic:planFlowEdge (so the cycle is reachable from
# the plan, not a free-standing island) and declares the DAG-workflow contract it is
# certified under.
ex:planResilientIngest a logic:Plan ;
    logic:planGoal ex:goalDataIngested ;
    logic:planSuccessMode logic:StrongCyclicPlanSuccess ;
    logic:executedUnderContract logic:DagWorkflowContract ;
    logic:planFlowEdge ex:cfProbeRecover , ex:cfRecoverProbe , ex:cfProbeCommit .

# The plan's steps (process nodes).
ex:stepProbe   a gmeow:Entity ; rdfs:label "probe source"@en .
ex:stepRecover a gmeow:Entity ; rdfs:label "recover and retry"@en .
ex:stepCommit  a gmeow:Entity ; rdfs:label "commit ingested data"@en .

# Control flow, as canonical reified flow-graph edges. The recovery loop is the
# cycle: probe -> recover -> probe (a back-edge), then probe -> commit on success.
ex:cfProbeRecover a logic:ControlFlowEdge ;
    logic:flowFrom ex:stepProbe ;
    logic:flowTo   ex:stepRecover .

ex:cfRecoverProbe a logic:ControlFlowEdge ;
    logic:flowFrom ex:stepRecover ;
    logic:flowTo   ex:stepProbe .

ex:cfProbeCommit a logic:ControlFlowEdge ;
    logic:flowFrom ex:stepProbe ;
    logic:flowTo   ex:stepCommit .
