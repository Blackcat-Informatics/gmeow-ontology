@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix logic:   <https://blackcatinformatics.ca/logic/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix schema:  <https://schema.org/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix pplan:   <http://purl.org/net/p-plan#> .
@prefix opmw:    <https://www.opmw.org/ontology/> .
@prefix bpmn:    <http://www.omg.org/spec/BPMN/20100524/MODEL#> .
@prefix ro_crate: <https://w3id.org/ro/crate/#> .
# Prescription / enactment / step alignments — GMEOW authoring source.
# Re-keyed from the retired process-model slice onto the canonical logic:
# spine: every target, confidence, justification and comment is preserved,
# because only the GMEOW-side term was retired, never the alignment.
# Compiled to mappings/gmeow-work-orchestration.sssom.tsv by `gmeow compile-mappings`.
# Projections live in dsl/mappings/projections/schema-org-procedures.ttl.
#
# NOTE: BPMN 2.0, CWL, WDL, RO-Crate Workflow-Run, and the workflow engines
# Airflow / Temporal / Nextflow do not publish canonical RDF ontologies with
# stable term IRIs; alignments to them are carried as skos:relatedMatch to
# informal concept URIs (by-reference logic:BridgeView lowerings of logic:Plan)
# and will be refined when stable vocabularies emerge.

gmeow:mapsetWorkOrchestration a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/work-orchestration" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Plan ⟂ execution de-conflation alignments to P-Plan, PROV-O, schema.org HowTo/Recipe, OPMW, OBI, BPMN, RO-Crate, the workflow engines Airflow / CWL / WDL / Temporal / Nextflow, and openEHR Task Planning (PROC). logic:Plan is a logic:Plan; every engine surface is a lossy by-reference lowering of that canonical process model (Principle 5). openEHR Task Planning is the higher-fidelity target — it carries loops and guarded branching — and its distinctive DLM constructs are subsumed natively (currency → logic:FreshnessGuard's logic:freshnessHorizon age axis AND time_window → its logic:freshnessWindow explicit valid-time-interval axis — both orthogonal axes of one guard, manual-notification → logic:NotificationWaitSchema, ISM linkage → logic:instantiatesPlan)." .

# --------------------------------------------------------------------------- #
# P-Plan — the closest peer model for plan / step / input / output / precedence
# --------------------------------------------------------------------------- #

logic:Plan skos:closeMatch pplan:Plan {|
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "P-Plan Plan; GMEOW Procedure is broader (includes recipes, CI, business processes)."
|} .

logic:ActionSchema skos:closeMatch pplan:Step {|
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "P-Plan Step; GMEOW ProcedureStep adds stepType values and subprocess composition."
|} .

logic:Enactment skos:closeMatch pplan:Activity {|
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "P-Plan Activity is the execution of a Step; GMEOW Execution is the event that enacts a Procedure or Step."
|} .

logic:precondition skos:closeMatch pplan:Input {|
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "P-Plan Input variable; GMEOW stepInput is a property pointing to any entity."
|} .

logic:effect skos:closeMatch pplan:Output {|
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "P-Plan Output variable; GMEOW stepOutput is a property pointing to any entity."
|} .

logic:ControlFlowEdge skos:relatedMatch pplan:precededBy {|
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "P-Plan precededBy is a direct property between steps; GMEOW ControlFlow is a reified relator."
|} .

# --------------------------------------------------------------------------- #
# PROV-O — prov:Plan and prov:Activity
# --------------------------------------------------------------------------- #

logic:Plan skos:closeMatch prov:Plan {|
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "PROV-O Plan; GMEOW Procedure is typed as InformationObject and carries step structure."
|} .

logic:Enactment skos:closeMatch prov:Activity {|
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "PROV-O Activity; GMEOW Execution is the event occurrence that enacts a plan."
|} .

logic:precondition skos:closeMatch prov:used {|
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "PROV-O used — an activity consumes an entity; GMEOW stepInput is the plan-level consumption."
|} .

logic:effect skos:closeMatch prov:wasGeneratedBy {|
    gmeow:sssomFile "gmeow-work-orchestration.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "PROV-O wasGeneratedBy — an entity is produced by an activity; GMEOW stepOutput is the plan-level production."
|} .

