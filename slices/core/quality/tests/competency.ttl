#
# Declarative competency question for the quality slice (crates/slicetest),
# migrated from test_qc_missing_definitions_is_empty. The QC check
# (queries/qc/missing-definitions.rq) asserts that every gmeow: owl:Class carries a
# skos:definition; a non-empty result is a failure, so the cell pins
# cqExpectRowCount 0. It runs in the default asserted lane (gmeow:reasoningNone) on
# purpose: reasoning must not be able to invent a definition, so the completeness
# guard is meaningful only over what is actually authored.
#
# This is the Gap-1 GOOD pattern preserved verbatim: the query is an OPEN
# universal over the namespace (a dynamic FILTER(STRSTARTS(...)) ASK over every
# present-or-future gmeow: class), NOT a finite VALUES blacklist — referencing the
# .rq keeps that dynamic universal intact.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/quality/tests/> .

ex:cqMissingDefinitions a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/qc/missing-definitions.rq" ;
    gmeow:cqRationale "Every gmeow: owl:Class must carry a skos:definition; the QC query that finds undefined classes must return the empty set over the asserted merged ontology." ;
    gmeow:cqResultShape ex:cqMissingDefinitionsShape ;
    gmeow:cqExpectRowCount 0 .

ex:cqMissingDefinitionsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "class" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ;
    logic:shapeRowCount 0 .

ex:cqAggregateRetainsProcedureValueAndTarget a gmeow:CompetencyQuestion ;
    gmeow:cqDataFile "examples/aggregate-and-categorical.ttl" ;
    gmeow:cqQuery """PREFIX g: <https://blackcatinformatics.ca/gmeow/>
PREFIX m: <https://blackcatinformatics.ca/math/>
SELECT ?procedure ?dimension ?target WHERE {
  ?assessment a g:AggregateQualityAssessment ; g:observationResult ?estimate .
  ?estimate a m:Estimate ; m:estimateValue ?value ; m:estimator ?procedure ; m:estimatedParameter ?target .
  ?procedure a m:Estimator . ?value a m:Quantity ; m:hasDimension ?dimension .
}""" ;
    gmeow:cqRationale "The held quality claim preserves its distinct estimate, declared procedure, dimensioned value and target without reducing the result to an ungrounded scalar." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:aggregateResultShape ;
    gmeow:cqExpectRow ex:aggregateResultRow .

ex:aggregateResultShape a logic:ResultShape ;
    logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn
      [ logic:columnVariable "procedure" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ],
      [ logic:columnVariable "dimension" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ],
      [ logic:columnVariable "target" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] .
ex:aggregateResultRow a gmeow:ExpectedRow ;
    gmeow:rowCell
      [ a gmeow:ExpectedCell ; gmeow:cellVar "procedure" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/examples/quality/aggregate/sampleMean> ],
      [ a gmeow:ExpectedCell ; gmeow:cellVar "dimension" ; gmeow:cellValueIri <https://blackcatinformatics.ca/math/dimensionless> ],
      [ a gmeow:ExpectedCell ; gmeow:cellVar "target" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/examples/quality/aggregate/populationMeanCompleteness> ] .

ex:cqQuantitativeResultCarriesDimensionAndValue a gmeow:CompetencyQuestion ;
    gmeow:cqDataFile "examples/dataset-completeness.ttl" ;
    gmeow:cqQuery """PREFIX g: <https://blackcatinformatics.ca/gmeow/>
PREFIX m: <https://blackcatinformatics.ca/math/>
SELECT ?dimension ?value WHERE {
  ?assessment a g:QuantitativeQualityAssessment ; g:observationResult ?result .
  ?result a m:Quantity ; m:hasDimension ?dimension ; m:quantityValue ?value .
}""" ;
    gmeow:cqRationale "A measured quality magnitude is a dimensioned quantity: the completeness ratio is dimensionless and its value is the quantity's own, not a bare number on the assessment." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:quantitativeResultShape ;
    gmeow:cqExpectRow ex:quantitativeResultRow .

ex:quantitativeResultShape a logic:ResultShape ;
    logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn
      [ logic:columnVariable "dimension" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ],
      [ logic:columnVariable "value" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ] .
ex:quantitativeResultRow a gmeow:ExpectedRow ;
    gmeow:rowCell
      [ a gmeow:ExpectedCell ; gmeow:cellVar "dimension" ; gmeow:cellValueIri <https://blackcatinformatics.ca/math/dimensionless> ],
      [ a gmeow:ExpectedCell ; gmeow:cellVar "value" ; gmeow:cellValueLiteral 0.985 ] .

ex:cqCategoricalVerdictIsNotAQuantity a gmeow:CompetencyQuestion ;
    gmeow:cqDataFile "examples/aggregate-and-categorical.ttl" ;
    gmeow:cqQuery """PREFIX g: <https://blackcatinformatics.ca/gmeow/>
PREFIX m: <https://blackcatinformatics.ca/math/>
SELECT ?verdict WHERE {
  ?assessment a g:QualityAssessment ; g:observationResult ?verdict .
  FILTER NOT EXISTS { ?verdict a m:Quantity }
}""" ;
    gmeow:cqRationale "A conformance verdict stays a legal result of the base quality assessment: it is not a quantity." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:categoricalVerdictShape ;
    gmeow:cqExpectRow ex:categoricalVerdictRow .

ex:categoricalVerdictShape a logic:ResultShape ;
    logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn
      [ logic:columnVariable "verdict" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] .
ex:categoricalVerdictRow a gmeow:ExpectedRow ;
    gmeow:rowCell
      [ a gmeow:ExpectedCell ; gmeow:cellVar "verdict" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/examples/quality/aggregate/conforms> ] .

ex:cqMultiDimensionReportKeepsEveryClassification a gmeow:CompetencyQuestion ;
    gmeow:cqDataFile "examples/multi-result-multi-dimension.ttl" ;
    gmeow:cqQuery """PREFIX g: <https://blackcatinformatics.ca/gmeow/>
SELECT ?dimension WHERE {
  ?assessment a g:QuantitativeQualityAssessment ; g:qualityDimension ?dimension .
}""" ;
    gmeow:cqRationale "Dimension classifications coexist on one assessment; a second classification never replaces or narrows the first." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:multiDimensionShape ;
    gmeow:cqExpectRow ex:multiDimensionPositional , ex:multiDimensionCompleteness .

ex:multiDimensionShape a logic:ResultShape ;
    logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn
      [ logic:columnVariable "dimension" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] .
ex:multiDimensionPositional a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dimension" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/qualityDimensionPositionalAccuracy> ] .
ex:multiDimensionCompleteness a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dimension" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/qualityDimensionCompleteness> ] .

ex:cqMultiResultReportKeepsEveryDimensionedQuantity a gmeow:CompetencyQuestion ;
    gmeow:cqDataFile "examples/multi-result-multi-dimension.ttl" ;
    gmeow:cqQuery """PREFIX g: <https://blackcatinformatics.ca/gmeow/>
PREFIX m: <https://blackcatinformatics.ca/math/>
SELECT ?physicalDimension WHERE {
  ?assessment a g:QuantitativeQualityAssessment ; g:observationResult ?result .
  ?result a m:Quantity ; m:hasDimension ?physicalDimension .
}""" ;
    gmeow:cqRationale "Each result of a multi-result report carries its own dimension: a length and a dimensionless ratio coexist without a fixed physical dimension imposed on the quality category." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:multiResultShape ;
    gmeow:cqExpectRow ex:multiResultLength , ex:multiResultRatio .

ex:multiResultShape a logic:ResultShape ;
    logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn
      [ logic:columnVariable "physicalDimension" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] .
ex:multiResultLength a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "physicalDimension" ; gmeow:cellValueIri <https://blackcatinformatics.ca/math/lengthDimension> ] .
ex:multiResultRatio a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "physicalDimension" ; gmeow:cellValueIri <https://blackcatinformatics.ca/math/dimensionless> ] .
