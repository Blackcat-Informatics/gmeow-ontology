@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/owl-time>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Property ;
            edoal:uri gmeow:endedAtTime ;
        ] ;
        align:entity2 [
            a edoal:Relation ;
            edoal:uri time:hasEnd ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.9"^^xsd:double ;
        rdfs:label "endedAtTime → time:hasEnd minted Instant"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:eventTime ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri time:hasTime ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "eventTime → time:hasTime minted Instant"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:startedAtTime ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri time:hasBeginning ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "startedAtTime → time:hasBeginning minted Instant"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "owl-time" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → owl-time (EDOAL)"@en .
