#
# Clean conformance fixture for math:ProbabilityScaleDisjointShape (Rule P2): a lawful
# math:OddsValue (odds of 3:1, value 3.0, outside [0, 1] as odds legitimately may be) that
# is NOT typed math:ProbabilityValue, and which recovers its probability through a declared
# math:ProbabilityScaleTransform rather than being conflated with it. Because it is not a
# math:ProbabilityValue it faces none of the probability-value gates, and math:OddsValue
# (a math:Quantity) carries no math: target shape. It MUST raise NO probability failure class.
# Positive counterpart of counter-examples/probability-scale-conflation.ttl.
# Bound by tests/example-conformance.ttl (ex:ecOddsValueDistinct).
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/math/> .

ex:threeToOneOdds a math:OddsValue ;
    math:quantityValue "3.0"^^xsd:decimal ;
    gmeow:hasReferenceFrame ex:forecastFrame .

# The scale recovers its probability by a DECLARED transform, never by being typed a probability.
ex:oddsToProbability a math:ProbabilityScaleTransform ;
    math:transformsToProbabilityValue ex:threeQuartersProbability .

ex:threeQuartersProbability a math:ProbabilityValue , math:RationalValue ;
    math:numerator 3 ;         # 3/4 = 0.75, the probability the 3:1 odds re-express
    math:denominator 4 ;
    gmeow:hasReferenceFrame ex:forecastFrame .

ex:forecastFrame a gmeow:ReferenceFrame .
<http://example.org/math/threeQuartersProbability> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/dimensionless> .
<http://example.org/math/threeToOneOdds> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/dimensionless> .
