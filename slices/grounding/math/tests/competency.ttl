    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "domain" ; gmeow:cellValueIri exf:coinSpace ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "measure" ; gmeow:cellValueIri exf:coinMeasure ] .

# === Q14 — dimension and derived commensurability class ==================== #

ex:cqDimensionAndCommensurability a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/dimension-vector-and-commensurability.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Each quantity reports its dimension and the quantities commensurable with it (same dimension, computed not asserted); over the fixture the answer is exactly the two ordered energy pairs {kineticEnergyQ ↔ restEnergyQ}; the mass quantity has no peer." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqCommensurabilityShape ;
    gmeow:cqExpectRow ex:rowKineticCommensurate , ex:rowRestCommensurate .

ex:cqCommensurabilityShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "quantity" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "dimension" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "commensurate" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
