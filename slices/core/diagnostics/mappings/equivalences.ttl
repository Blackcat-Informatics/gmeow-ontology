@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix earl: <http://www.w3.org/ns/earl#> .

# Term equivalences for the diagnostics domain — GMEOW authoring source.
# Compiled to mappings/gmeow-diagnostics.sssom.tsv by `gmeow compile-mappings`.
# Aligns the diagnostics slice to the W3C EARL (Evaluation And Report Language)
# vocabulary, the closest external standard for "a tool reports a result about a
# subject".

gmeow:mapsetDiagnostics a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-diagnostics.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/diagnostics" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Diagnostics-slice alignments to W3C EARL. The match is deliberately loose (skos:closeMatch, not equivalentClass): EARL models an earl:Assertion as a tuple (earl:assertedBy a tool, earl:subject a test subject, earl:result an earl:TestResult with an earl:outcome), whereas a gmeow:Finding is a reified gmeow:Observation (Principle 9) — the tool is the gmeow:vantage, the offending statement the gmeow:observedFeature, and the severity the gmeow:observationResult — and is itself one PROJECTION of the canonical Rust report, not a free-standing assertion record. EARL's outcome vocabulary (earl:passed/failed/cantTell) grades the TEST, while gmeow:DiagnosticSeverity grades the FINDING that a test produced, so the alignment of severity to outcome is loose. The internal logic:violation and the native↔oracle divergence-ledger entries are restricted Findings in the GMEOW namespace and so are documented in the slice guide rather than mapped here (this file aligns to external vocabularies only)." .

# --------------------------------------------------------------------------- #
# W3C EARL — Evaluation And Report Language
# --------------------------------------------------------------------------- #

gmeow:Finding skos:closeMatch earl:Assertion {|
    gmeow:sssomFile "gmeow-diagnostics.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "earl:Assertion is a tool's (assertedBy, subject, result) tuple; gmeow:Finding is a reified gmeow:Observation about a statement and one projection of the canonical Rust report. closeMatch, not equivalentClass."
|} .

gmeow:findingSeverity skos:closeMatch earl:outcome {|
    gmeow:sssomFile "gmeow-diagnostics.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "earl:outcome grades the TEST (passed/failed/cantTell); gmeow:findingSeverity grades the FINDING a test produced (error/warning/note/info). Related but not the same axis, so a loose closeMatch."
|} .
