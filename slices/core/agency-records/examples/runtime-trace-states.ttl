ex:dreamPhaseRoundCapReached a gmeow:Event ;
    gmeow:eventType gmeow:eventTypeTraceDreamPhaseRoundCapReached ;
    gmeow:subEventOf ex:episode .

# The source of each exact type claim is retained on its native reifier.

ex:roundClaim rdf:reifies <<( ex:round gmeow:eventType gmeow:eventTypeTraceRound )>> ;
    gmeow:accordingTo ex:runtime ;
    gmeow:wasAttributedTo ex:archiveWriter ;
    gmeow:wasDerivedFrom ex:traceSource .

