    skos:example "For example: ex:object gmeow:worldObjectKind gmeow:worldObjectKindInstrument ."@x-gmeow-english .

# Intrinsic source consistency for environment interaction records.

gmeow:WorldNoticeTopicKindConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "World notice topic kind constraint"@x-gmeow-english ;
    skos:definition "A supplied noticeKind belongs to a Message explicitly classified as messageKindWorldNotice; notice content is not a verified environment transition."@x-gmeow-english ;
    gmeow:useWhen "Use to keep notice topic and shared message-kind classification consistent."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using a topic to invent delivery or fulfillment evidence."@x-gmeow-english ;
    gmeow:howToUse "Check each noticeKind subject for the actual world-notice kind assertion."@x-gmeow-english ;
    skos:scopeNote "The binary property guard checks supplied topics without demanding a topic on every Message."@x-gmeow-english ;
    skos:example "For example: ex:notice a gmeow:Message ; gmeow:hasMessageKind gmeow:messageKindWorldNotice ; gmeow:noticeKind gmeow:noticeKindGiftOffered ."@x-gmeow-english ;
    logic:message "A supplied noticeKind belongs to a Message explicitly classified as messageKindWorldNotice; notice content is not a verified environment transition."@x-gmeow-english ;
    logic:formalizes gmeow:noticeKind ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "kind" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:noticeKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "kind" ] ] ; logic:consequent [ a logic:Formula ; logic:relation gmeow:hasMessageKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:messageKindWorldNotice ] ] ] ] .

gmeow:NoticeDeliveryContextConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Notice delivery context constraint"@x-gmeow-english ;
    skos:definition "Every noticeDeliveryState subject is either an actual world-notice Message or a notice-delivery Activity affecting an actual world-notice Message."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish the notice artifact from each delivery occurrence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid accepting an arbitrary Event or an attempt without its actual notice binding."@x-gmeow-english ;
    gmeow:howToUse "Check the binary property target against the Message branch or the typed delivery-Activity branch with affectsObject."@x-gmeow-english ;
    skos:scopeNote "The explicit law validates the anonymous union domain without inferring delivery from attempted state."@x-gmeow-english ;
    skos:example "For example: ex:attempt a gmeow:Activity ; gmeow:eventType gmeow:eventTypeWorldNotificationDelivery ; gmeow:affectsObject ex:notice ; gmeow:noticeDeliveryState gmeow:noticeDeliveryStateAttempted ."@x-gmeow-english ;
    logic:message "Every noticeDeliveryState subject is either an actual world-notice Message or a notice-delivery Activity affecting an actual world-notice Message."@x-gmeow-english ;
    logic:formalizes gmeow:noticeDeliveryState ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "state" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:noticeDeliveryState ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "state" ] ] ; logic:consequent [ a logic:Formula ; logic:or [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Message ] ] , [ a logic:Formula ; logic:relation gmeow:hasMessageKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:messageKindWorldNotice ] ] ] , [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Activity ] ] , [ a logic:Formula ; logic:relation gmeow:eventType ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:eventTypeWorldNotificationDelivery ] ] , [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "notice" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "notice" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Message ] ] , [ a logic:Formula ; logic:relation gmeow:hasMessageKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "notice" ] , [ logic:termIndex 1 ; logic:termIri gmeow:messageKindWorldNotice ] ] ] , [ a logic:Formula ; logic:relation gmeow:affectsObject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "notice" ] ] ] ] ] ] ] ] .

gmeow:EmbeddedPartWholeConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Embedded part whole constraint"@x-gmeow-english ;
    skos:definition "An embeddedPartRole subject retains actual partOf membership in an enclosing Entity; a role name alone cannot fabricate an enclosing object."@x-gmeow-english ;
    gmeow:useWhen "Use to require source parthood for a contextual embedded role."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating an unattached label as proof of actual object composition."@x-gmeow-english ;
    gmeow:howToUse "Join each role-bearing part to its supplied whole through partOf."@x-gmeow-english ;
    skos:scopeNote "Several enclosing contexts may coexist; this existence law supplies no unique or preferred whole."@x-gmeow-english ;
    skos:example "For example: ex:part a gmeow:Entity ; gmeow:partOf ex:object ; gmeow:embeddedPartRole gmeow:embeddedPartRoleForm ."@x-gmeow-english ;
    logic:message "An embeddedPartRole subject retains actual partOf membership in an enclosing Entity; a role name alone cannot fabricate an enclosing object."@x-gmeow-english ;
    logic:formalizes gmeow:embeddedPartRole ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "role" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:embeddedPartRole ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "role" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "whole" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "whole" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Entity ] ] , [ a logic:Formula ; logic:relation gmeow:partOf ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "whole" ] ] ] ] ] ] .

gmeow:GlanceTextLanguageConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Glance text language constraint"@x-gmeow-english ;
    skos:definition "Every supplied glanceText literal has a language tag, retaining any RDF 1.2 base direction without guessing a missing language."@x-gmeow-english ;
    gmeow:useWhen "Use to validate the language-bearing glance wording boundary."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid replacing the native language test with a plain xsd:string check."@x-gmeow-english ;
    gmeow:howToUse "Apply termHasLang to each value of the binary glanceText property guard."@x-gmeow-english ;
    skos:scopeNote "A missing language fails; the law does not rewrite text or remove its direction."@x-gmeow-english ;
    skos:example "For example: ex:object gmeow:glanceText \"A quiet blue box.\"@en ."@x-gmeow-english ;
    logic:message "Every supplied glanceText literal has a language tag, retaining any RDF 1.2 base direction without guessing a missing language."@x-gmeow-english ;
    logic:formalizes gmeow:glanceText ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "text" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:glanceText ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "text" ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termHasLang ; logic:argument [ logic:termIndex 0 ; logic:termVariable "text" ] ] ] ] .

gmeow:WorldAffordanceCatalogConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "World affordance catalog constraint"@x-gmeow-english ;
    skos:definition "A WorldAffordance is an actual entry of an InformationObject's action catalog and retains its supplied tool name. It does not stand in for execution."@x-gmeow-english ;
    gmeow:useWhen "Use to qualify a complete advertised action entry."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating an owner or tool name for incomplete source fragments."@x-gmeow-english ;
    gmeow:howToUse "Check the class target for an incoming affordsAction owner and its affordanceToolName field."@x-gmeow-english ;
    skos:scopeNote "Incomplete fragments can remain InformationObjects; the law does not manufacture a tool endpoint."@x-gmeow-english ;
    skos:example "For example: ex:objectRecord a gmeow:InformationObject ; gmeow:affordsAction ex:action . ex:action a gmeow:WorldAffordance ; gmeow:affordanceToolName \"inspect\" ."@x-gmeow-english ;
    logic:message "A WorldAffordance is an actual entry of an InformationObject's action catalog and retains its supplied tool name. It does not stand in for execution."@x-gmeow-english ;
    logic:formalizes gmeow:WorldAffordance ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:WorldAffordance ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "owner" ] , [ logic:termIndex 1 ; logic:termVariable "tool" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "owner" ] , [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] , [ a logic:Formula ; logic:relation gmeow:affordsAction ; logic:argument [ logic:termIndex 0 ; logic:termVariable "owner" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] ] , [ a logic:Formula ; logic:relation gmeow:affordanceToolName ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "tool" ] ] ] ] ] ] .

gmeow:AffordanceTargetScopeConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Affordance target scope constraint"@x-gmeow-english ;
    skos:definition "Every affordanceTarget belongs through hasPart to every actual catalog owner advertising that affordance, with at least one supplied owner. Targets cannot leak between object catalogs."@x-gmeow-english ;
    gmeow:useWhen "Use to validate the source's advertised action-to-part binding."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying a shared entry with one convenient owner's unrelated target."@x-gmeow-english ;
    gmeow:howToUse "Require an actual owner and check hasPart for all affordsAction owners of this entry."@x-gmeow-english ;
    skos:scopeNote "The binary target checks source structure, not whether an advertised tool executed successfully."@x-gmeow-english ;
    skos:example "For example: ex:record gmeow:affordsAction ex:action ; gmeow:hasPart ex:plate . ex:action gmeow:affordanceTarget ex:plate ."@x-gmeow-english ;
    logic:message "Every affordanceTarget belongs through hasPart to every actual catalog owner advertising that affordance, with at least one supplied owner. Targets cannot leak between object catalogs."@x-gmeow-english ;
    logic:formalizes gmeow:affordanceTarget ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "target" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:affordanceTarget ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "target" ] ] ; logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "owner" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "owner" ] , [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] , [ a logic:Formula ; logic:relation gmeow:affordsAction ; logic:argument [ logic:termIndex 0 ; logic:termVariable "owner" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] ] , [ a logic:Formula ; logic:relation gmeow:hasPart ; logic:argument [ logic:termIndex 0 ; logic:termVariable "owner" ] , [ logic:termIndex 1 ; logic:termVariable "target" ] ] ] ] , [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "owner" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:affordsAction ; logic:argument [ logic:termIndex 0 ; logic:termVariable "owner" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] ] ; logic:consequent [ a logic:Formula ; logic:relation gmeow:hasPart ; logic:argument [ logic:termIndex 0 ; logic:termVariable "owner" ] , [ logic:termIndex 1 ; logic:termVariable "target" ] ] ] ] ] ] ] .

gmeow:RecordedCognitionModeCarrierConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Recorded cognition mode carrier constraint"@x-gmeow-english ;
    skos:definition "Every cognitionModeAsRecorded subject is an InformationObject source record or an actual Desire, while the mode string remains unresolved."@x-gmeow-english ;
    gmeow:useWhen "Use to validate the source carrier of a recorded cognition-mode code."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid accepting arbitrary events or inferring an AwarenessMode from the string."@x-gmeow-english ;
    gmeow:howToUse "Check the binary property target against the two named carrier classes."@x-gmeow-english ;
    skos:scopeNote "This explicit check supplies anonymous-union subject admission without a mode parser."@x-gmeow-english ;
    skos:example "For example: ex:record a gmeow:InformationObject ; gmeow:cognitionModeAsRecorded \" dreaming  \" ."@x-gmeow-english ;
    logic:message "Every cognitionModeAsRecorded subject is an InformationObject source record or an actual Desire, while the mode string remains unresolved."@x-gmeow-english ;
    logic:formalizes gmeow:cognitionModeAsRecorded ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "code" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:cognitionModeAsRecorded ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "code" ] ] ; logic:consequent [ a logic:Formula ; logic:or [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Desire ] ] ] ] ] .

gmeow:ReadOnlyAffordanceTagConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Read-only affordance tag constraint"@x-gmeow-english ;
    skos:definition "A tagReadOnlyAction assertion classifies an actual WorldAffordance catalog record. It preserves reported read-only behavior without granting permission or proving tool effects."@x-gmeow-english ;
    gmeow:useWhen "Use to check the carrier of reported read-only behavior metadata."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a tag as an access decision, executable restriction or effect certificate."@x-gmeow-english ;
    gmeow:howToUse "Check the binary hasTag guard for tagReadOnlyAction and require its WorldAffordance subject."@x-gmeow-english ;
    skos:scopeNote "Other tags are unaffected and no global functionality or policy engine is introduced."@x-gmeow-english ;
    skos:example "For example: ex:action a gmeow:WorldAffordance ; gmeow:hasTag gmeow:tagReadOnlyAction ."@x-gmeow-english ;
    logic:message "A tagReadOnlyAction assertion classifies an actual WorldAffordance catalog record. It preserves reported read-only behavior without granting permission or proving tool effects."@x-gmeow-english ;
    logic:formalizes gmeow:hasTag ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:hasTag ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:tagReadOnlyAction ] ] ; logic:consequent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:WorldAffordance ] ] ] ] .

