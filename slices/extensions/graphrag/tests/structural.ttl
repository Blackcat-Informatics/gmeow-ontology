#
# Declarative structural assertions for the graphrag slice (Tier-B
# closeout). The repo-level test_ai_claims.py is fixture-driven ABox conformance
# (KEEP); these cells pin the slice's asserted-TBox spine fresh (MAXIMAL
# coverage, dogfooding). Each runs as a SPARQL ASK over the module graph
# (gmeow:scopeModule).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/graphrag/tests/> .

# --- 1. The retrieval information-object Kinds (MUST hold) --------------------
ex:saGraphRagKinds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:Corpus               a owl:Class , logic:Kind ; rdfs:subClassOf gmeow:InformationObject .
    gmeow:Community            a owl:Class , logic:Kind ; rdfs:subClassOf gmeow:InformationObject .
    gmeow:ExtractedEntity      a owl:Class , logic:Kind ; rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "The graph-RAG retrieval artifacts MUST be logic:Kind gmeow:InformationObjects (Corpus, Community, ExtractedEntity) — the core ai slice's gmeow:Embedding, gmeow:VectorIndex, and gmeow:RetrievalEvent are asserted in ai/tests/structural.ttl alongside the classes they now belong to." .

# --- 2. Index value vocabulary + seeds (MUST hold) ----------------------------
ex:saGraphRagValueVocabs a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:IndexAlgorithm a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
    gmeow:indexAlgorithmFlat a gmeow:IndexAlgorithm . gmeow:indexAlgorithmHnsw a gmeow:IndexAlgorithm .
    gmeow:indexAlgorithmIvf a gmeow:IndexAlgorithm .
}""" ;
    gmeow:saRationale "gmeow:IndexAlgorithm MUST be a QualityValue vocabulary with its seeds present: ANN index algorithms {flat, HNSW, IVF}. The core ai slice's gmeow:DistanceMetric seeds are asserted in ai/tests/structural.ttl." .

# --- 3. The single-valued retrieval edges' declared shapes (MUST hold) -------
ex:saGraphRagFunctionalEdges a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:relationshipSource a owl:ObjectProperty ; rdfs:domain gmeow:ExtractedRelationship ; rdfs:range gmeow:ExtractedEntity .
    gmeow:relationshipTarget a owl:ObjectProperty ; rdfs:domain gmeow:ExtractedRelationship ; rdfs:range gmeow:ExtractedEntity .
    gmeow:summarizesCommunity a owl:ObjectProperty ; rdfs:domain gmeow:CommunitySummary ; rdfs:range gmeow:Community .
    gmeow:indexAlgorithm a owl:ObjectProperty ; rdfs:domain gmeow:VectorIndex ; rdfs:range gmeow:IndexAlgorithm .
}""" ;
    gmeow:saRationale "The single-valued retrieval edges MUST carry their declared domains/ranges: an extracted relationship has one source and one target; a summary summarizes one community; a vector index uses one algorithm. Their single-valued (functional) characteristic is now asserted on the logic:PropertyCharacteristicAssertion carrier and enforced by the DL reasoner, not in the slice module. The core ai slice's gmeow:embeddingOf/gmeow:embeddingModel domain/range are asserted in ai/tests/structural.ttl." .

# --- 4. Value vocabulary is individuals, never subclasses (MUST-NOT hold) -----
ex:saGraphRagVocabsNotSubclassed a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    ?c rdfs:subClassOf ?vocab .
    VALUES ?vocab { gmeow:IndexAlgorithm }
    FILTER (?c != ?vocab)
}""" ;
    gmeow:saRationale "The QualityValue idiom: gmeow:IndexAlgorithm is a vocabulary of individuals, never per-value subclasses — the slice MUST NOT declare any subclass of it. New algorithms extend the vocabulary as individuals. The core ai slice's gmeow:DistanceMetric equivalent is asserted in ai/tests/structural.ttl." .

# --- Migrated from tests/test_ai_claims.py --------------------------------

# test_vectors_stay_outside_the_graph
ex:saVectorRefIsDatatypePropertyNoVectorValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:vectorRef a owl:DatatypeProperty .
}""" ;
    gmeow:saRationale "gmeow:vectorRef MUST be an owl:DatatypeProperty — vector payloads stay outside the graph and are referenced, not embedded (Principle 12)." .

ex:saNoVectorValueProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:vectorValue ?p ?o . }""" ;
    gmeow:saRationale "gmeow:vectorValue MUST NOT be declared in the graphrag module — the vector payload stays outside the graph; only gmeow:vectorRef is permitted." .

# test_extracted_descriptions_are_not_entities
ex:saExtractedDescriptionsAreInformationObjects a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ExtractedEntity a owl:Class ;
        rdfs:subClassOf gmeow:InformationObject .
    gmeow:ExtractedRelationship a owl:Class ;
        rdfs:subClassOf gmeow:InformationObject .
    gmeow:Community a owl:Class ;
        rdfs:subClassOf gmeow:InformationObject .
    gmeow:CommunitySummary a owl:Class ;
        rdfs:subClassOf gmeow:Summary .
}""" ;
    gmeow:saRationale "GraphRAG artifacts (ExtractedEntity, ExtractedRelationship, Community) MUST be subclasses of gmeow:InformationObject and CommunitySummary MUST subclass gmeow:Summary — they are descriptions ABOUT putative entities, not entities themselves (Principle 5)." .

# test_invocation_and_retrieval_are_activities (retrievalScore annotation-property half)
ex:saRetrievalScoreIsAnnotationProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:retrievalScore a owl:AnnotationProperty . }""" ;
    gmeow:saRationale "gmeow:retrievalScore MUST be an owl:AnnotationProperty — per-result relevance scores are statement-level annotations so competing scores coexist and the OWL downcast stays DL-clean (Principle 3, Principle 9)." .
