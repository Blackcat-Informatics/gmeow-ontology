gmeow:SessionVerificationEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/chat> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Session verification evidence constraint"@x-gmeow-english ;
    skos:definition "Supplied session-verification identifiers belong to an actual Observation retaining both session and sender strings, its feature, observer, method, held result and source evidence. This checks the recorded claim, not cryptographic authenticity."@x-gmeow-english ;
    gmeow:useWhen "Use to check the explicitly retained source-record contract."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring identity, delivery, verification or execution from missing source evidence."@x-gmeow-english ;
    gmeow:howToUse "Read the canonical formula against actual source identities and preserve competing attributed records."@x-gmeow-english ;
    skos:scopeNote "Independent source claims coexist. These declarations preserve evidence without authenticating the provider or executing its operation."@x-gmeow-english ;
    skos:example "Retain this source law: gmeow:SessionVerificationEvidenceConstraint logic:formalizes gmeow:sessionIdentity ."@x-gmeow-english ;
    logic:message "Supplied session-verification identifiers belong to an actual Observation retaining both session and sender strings, its feature, observer, method, held result and source evidence. This checks the recorded claim, not cryptographic authenticity."@x-gmeow-english ;
