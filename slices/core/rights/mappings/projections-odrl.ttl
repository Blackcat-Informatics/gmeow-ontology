# ODRL distinguishes a duty's consequence (odrl:consequence) from a prohibition's
# remedy (odrl:remedy); the projection keys on the rule type to emit the right one.
gmeow:mapOdrlConsequence a gmeow:ProjectionMapping ;
    rdfs:label "Duty consequence → odrl:consequence"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "r" ; gmeow:value "d" ;
        gmeow:atom (
            [ gmeow:subjectVar "r" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Duty ]
            [ gmeow:subjectVar "r" ; gmeow:predicate gmeow:ruleConsequence ; gmeow:objectVar "d" ] ) ;
        gmeow:edoalSource gmeow:ruleConsequence ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:toPredicate odrl:consequence ; gmeow:relation "<=" ; gmeow:confidence 0.7 ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:relatedMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ] .

gmeow:mapOdrlRemedy a gmeow:ProjectionMapping ;
    rdfs:label "Prohibition consequence → odrl:remedy"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "r" ; gmeow:value "d" ;
        gmeow:atom (
            [ gmeow:subjectVar "r" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Prohibition ]
            [ gmeow:subjectVar "r" ; gmeow:predicate gmeow:ruleConsequence ; gmeow:objectVar "d" ] ) ;
        gmeow:edoalSource gmeow:ruleConsequence ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:toPredicate odrl:remedy ; gmeow:relation "<=" ; gmeow:confidence 0.65 ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:relatedMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ] .

gmeow:mapOdrlAsset a gmeow:ProjectionMapping ;
    rdfs:label "governed asset → odrl:Asset"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "asset" ;
        gmeow:atom (
            [ gmeow:subjectVar "rs" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:RightsStatement ]
            [ gmeow:subjectVar "rs" ; gmeow:predicate gmeow:statementAbout ; gmeow:objectVar "asset" ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:relation "<=" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "asset" ; gmeow:tPred rdf:type ; gmeow:tObjValue odrl:Asset ] ) ] .

gmeow:mapOdrlParty a gmeow:ProjectionMapping ;
