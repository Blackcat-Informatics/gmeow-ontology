<https://blackcatinformatics.ca/logic/target/n3>
    a logic:ProjectionTarget ;
    rdfs:label "n3" ;
    gmeow:lossyDrop "N3 builtins used for arithmetic/string predicates where available" ,
        "actual: logic:Formula #0 [Nested+Quantified] (full first-order quantifier / connective tree) is not representable in N3; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: logic:Formula #1 [Nested+Quantified] (full first-order quantifier / connective tree) is not representable in N3; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: logic:Formula #2 [Disjunctive+Nested+Quantified] (full first-order quantifier / connective tree) is not representable in N3; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: logic:Formula #3 [Nested+Quantified+StrongNegation] (full first-order quantifier / connective tree) is not representable in N3; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: logic:Formula #4 [Disjunctive+Nested+Quantified] (full first-order quantifier / connective tree) is not representable in N3; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: logic:Formula #5 [Nested+Quantified+StrongNegation] (full first-order quantifier / connective tree) is not representable in N3; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: reasoning contract (an anonymous faceted contract) is not representable in N3; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:PositiveHornProfile) is not representable in N3; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:ProbabilisticProfile) is not representable in N3; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:ProceduralPrologProfile) is not representable in N3; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:StableModelProfile) is not representable in N3; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:StratifiedNAFProfile) is not representable in N3; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:WellFoundedProfile) is not representable in N3; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "modal context encoded as quoted graph arguments (may overgenerate)" ,
        "negation-as-failure guards are dropped; monotone log:implies cannot express a defeater, so a defeasible rule is over-approximated (CompleteOver) rather than emitting the guard as a positive antecedent" ;
    logic:complexityClass "semi-decidable" ;
    logic:preservationKind logic:CompleteOverApproximation .

<https://blackcatinformatics.ca/logic/target/nif:forms-and-sign-systems#sentAnchor>
    a logic:ProjectionTarget ;
    rdfs:label "nif:forms-and-sign-systems#sentAnchor" ;
    gmeow:lossyDrop "actual: offset fragility (declared): NIF/OA offsets [0,15) for anchor <https://blackcatinformatics.ca/gmeow/examples/lang/sentAnchor> bind to surface <https://blackcatinformatics.ca/gmeow/examples/lang/sentSurface> under offsetSpace=lang:codepointOffset, unicodeNormalization=NFC; re-encoding or re-normalizing that surface (NFC↔NFD, codepoint↔byte, a different encoding) shifts the addressed span so the offsets no longer address the same characters — this invalidation is by design, not carried into NIF" ,
        "actual: the lang:Form / lang:Sense / lang:Denotation strata above the surface are not carried into NIF (NIF addresses spans of a surface, not analyzed forms)" ;
    logic:complexityClass "n/a" ;
    logic:preservationKind logic:SoundUnderApproximation .

