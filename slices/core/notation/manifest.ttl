@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/notation>
    a gmeow:Slice ;
    rdfs:label "notation"@x-gmeow-english ;
    skos:definition "The notation slice of the GMEOW ontology (core tier): foundational symbolic-system and notation-projection classes, the NotationSystem and NotationProjectionProfile taxonomies, and the ProjectionLoss vocabulary. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/notation> ;
    dcterms:title "GMEOW Notation and Symbolic Systems Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/profiles> ,
        <https://blackcatinformatics.ca/gmeow/slices/language> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:sliceConsumer "Symbolic/notation systems for the language family and the music slice's lossy notation projections."@x-gmeow-english.
