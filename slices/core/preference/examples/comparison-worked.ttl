# SPDX-License-Identifier: CC-BY-4.0
#
# Pass-witness scene: the H0-lifts demonstrator — a LEGAL global winner.
# Two genuinely AGREEING evaluators both prefer A ≻ B under one comparison context.
# Because their per-vantage local orders GLUE, they extend to a gmeow:ConsensusSection
# (wrapping a math:GlobalSection, the H0 lift) that reconciles EVERY registered
# observation over the WHOLE base (F2), and the gmeow:DisagreementObstruction (the H1
# gluing obstruction) VANISHES and is discharged. Only under both conditions is a typed
# gmeow:PreferenceClaim with gmeow:assertsGlobalWinner true legal
# (gmeow:NoGlobalWinnerWithoutConsensusConstraint). A gmeow:ProjectionReceipt then binds
# gmeow:selectedCandidate A, and it is F1-legal because that selection is backed by the
# same discharged winner claim (gmeow:SelectedCandidateRequiresConsensusConstraint).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/preference/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# --- The closed candidate field ----------------------------------------------- #
ex:candA a gmeow:InformationObject ; rdfs:label "candidate A — the agreed-best draft"@en .
ex:candB a gmeow:InformationObject ; rdfs:label "candidate B — the runner-up draft"@en .

ex:candidates a gmeow:CandidateSet ;
    rdfs:label "the two edit candidates"@en ;
    gmeow:hasCandidate ex:candA , ex:candB .

# --- Two GENUINELY AGREEING evaluator vantages -------------------------------- #
ex:evalOne a gmeow:Standpoint ; rdfs:label "evaluator one"@en .
ex:evalTwo a gmeow:Standpoint ; rdfs:label "evaluator two"@en .

# --- The content-addressed context registering the whole (agreeing) base ------ #
ex:goalEdit a gmeow:Goal ; rdfs:label "select the strongest edit"@en .
ex:panel a gmeow:Standpoint ; rdfs:label "the editorial panel standpoint"@en .

ex:ctx a gmeow:ComparisonContext ;
    rdfs:label "editorial selection, 2026-Q3"@en ;
    gmeow:contextTask ex:goalEdit ;
    gmeow:contextStandpoint ex:panel ;
    gmeow:contentDigest "blake3:5e6f708192a3b4c5d6071829304a5b6c7d8e9f0a1b2c3d4e5f60718293a4b5c6" ;
    gmeow:registersObservation ex:obsOne , ex:obsTwo .

# --- Two reified, vantage-indexed observations that AGREE (both A ≻ B) --------- #
ex:featOne a gmeow:InformationObject ; rdfs:label "A vs B, per evaluator one"@en ;
    gmeow:hasPart ex:candA , ex:candB .
ex:obsOne a gmeow:PreferenceObservation ;
    rdfs:label "A ≻ B, per evaluator one"@en ;
    gmeow:vantage ex:evalOne ;
    gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featOne ;
    gmeow:observationPrefers ex:candA .

ex:featTwo a gmeow:InformationObject ; rdfs:label "A vs B, per evaluator two"@en ;
    gmeow:hasPart ex:candA , ex:candB .
ex:obsTwo a gmeow:PreferenceObservation ;
    rdfs:label "A ≻ B, per evaluator two"@en ;
    gmeow:vantage ex:evalTwo ;
    gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featTwo ;
    gmeow:observationPrefers ex:candA .

# --- The H0 lift: the local orders glue into a global section over the WHOLE base #
ex:complex a math:CellComplex ; rdfs:label "the preference cell complex over {A,B}"@en .
ex:sheaf a math:CellularSheaf ;
    rdfs:label "the preference sheaf (agreeing stalks glue)"@en ;
    math:sheafBaseComplex ex:complex ;
    math:connectionOfSheaf ex:prefConnection .
ex:prefConnection a math:Connection ; rdfs:label "the (flat) preference connection"@en .

ex:h0lift a math:GlobalSection ;
    rdfs:label "the H0 global section: one compatible order over the whole base"@en ;
    math:overSheaf ex:sheaf ;
    math:sectionRegion ex:complex .

ex:consensus a gmeow:ConsensusSection ;
    rdfs:label "the whole-base consensus (A over B, reconciling both vantages)"@en ;
    gmeow:consensusGlobalSection ex:h0lift ;
    gmeow:sectionContext ex:ctx ;
    gmeow:reconcilesObservation ex:obsOne , ex:obsTwo .

# --- The H1 obstruction is present but VANISHING and DISCHARGED ---------------- #
ex:h1class a math:GluingObstruction ;
    rdfs:label "the (vanishing) H1 gluing obstruction"@en ;
    math:obstructionOf ex:sheaf .
ex:obstruction a gmeow:DisagreementObstruction ;
    rdfs:label "the discharged disagreement obstruction (flat holonomy, glues)"@en ;
    gmeow:obstructionClass ex:h1class .

# --- The LEGAL global winner: a typed claim over a discharged whole-base consensus #
ex:claim a gmeow:PreferenceClaim ;
    rdfs:label "the panel's claim: A is the global winner"@en ;
    gmeow:vantage ex:panel ;
    gmeow:accordingTo ex:panel ;
    gmeow:assertsGlobalWinner true ;
    gmeow:extendsToConsensusSection ex:consensus ;
    gmeow:dischargesDisagreement ex:obstruction .

# --- The F1-legal projection: a selected candidate routed through that consensus  #
ex:receipt a gmeow:ProjectionReceipt ;
    rdfs:label "listwise projection selecting A, backed by the discharged claim"@en ;
    gmeow:projectionKind gmeow:projectionListwise ;
    gmeow:projectionSourceSet ex:candidates ;
    gmeow:projectionDeterminism gmeow:determinismDeterministic ;
    gmeow:tieBreakRule "lexicographic-by-iri" ;
    gmeow:selectedCandidate ex:candA ;
    logic:preservationKind logic:ExactPreservation ;
    gmeow:contentDigest "blake3:6f708192a3b4c5d6e7081930415a6b7c8d9e0f1a2b3c4d5e6f70819203a4b5c6" .
