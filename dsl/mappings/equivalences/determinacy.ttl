    gmeow:sssomFile "gmeow-determinacy.sssom.tsv" .

gmeow:eqDeterminacy006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:determinacyDisputed ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q18912752 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'disputed' sourcing qualifier; the closest structured external term for a contested/undecided value" ;
    gmeow:objectLabel "disputed" ;
    gmeow:sssomFile "gmeow-determinacy.sssom.tsv" .
