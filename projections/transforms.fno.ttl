@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix fno:     <https://w3id.org/function/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# FnO catalog of LANGUAGE TRANSFORMATIONS — transliteration, transcription and
# translation modelled as declarative functions. Unlike functions.fno.ttl (which
# describes GMEOW→external PROJECTION transforms), these are DOMAIN conversions:
# each names a system (Hepburn, Pinyin, ISO 233, IPA, …) and links it to the
# gmeow:TransliterationScheme value individual it realises, so a gmeow:romanization
# can record HOW it was derived (names module: gmeow:transliterationScheme). A
# consumable spec — NOT imported into the ontology and never reasoned over; the
# executable HOW (a real transliterator) is out of scope, intentionally pluggable.

<https://blackcatinformatics.ca/gmeow/projections/transforms>
    a owl:Ontology ;
    rdfs:label "GMEOW language transformation functions (FnO)"@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# --- Transliteration (script → script; reversible by design) ---------------- #

gmeow:fnRomanizeHepburn
    a fno:Function ;
    rdfs:label "Hepburn romanization (Japanese kana/kanji → Latin)"@en ;
    dcterms:description "Transliterates Japanese (kana, with kanji readings) to the Latin script per the Hepburn system (山田太郎 → \"Yamada Tarō\"). Realises gmeow:schemeHepburn. Reversible for kana; lossy for kanji (requires readings)."@en ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeHepburn .

gmeow:fnRomanizeKunrei
    a fno:Function ;
    rdfs:label "Kunrei-shiki romanization (Japanese → Latin)"@en ;
    dcterms:description "Transliterates Japanese kana to Latin per the ISO 3602 Kunrei-shiki system (a systematic alternative to Hepburn). Realises gmeow:schemeKunreiShiki. Reversible."@en ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeKunreiShiki .

gmeow:fnRomanizePinyin
    a fno:Function ;
    rdfs:label "Hanyu Pinyin romanization (Mandarin → Latin)"@en ;
    dcterms:description "Transliterates Mandarin Chinese to the Latin script with tone marks per Hanyu Pinyin (北京 → \"Běijīng\"). Realises gmeow:schemePinyin. Lossy without readings; tone-mark variants exist."@en ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemePinyin .

gmeow:fnRomanizeWadeGiles
    a fno:Function ;
    rdfs:label "Wade-Giles romanization (Mandarin → Latin)"@en ;
    dcterms:description "Transliterates Mandarin to Latin per the older Wade-Giles system (北京 → \"Pei-ching\"). Realises gmeow:schemeWadeGiles."@en ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeWadeGiles .

gmeow:fnRomanizeRevisedRomanization
    a fno:Function ;
    rdfs:label "Revised Romanization (Korean → Latin)"@en ;
    dcterms:description "Transliterates Korean Hangul to Latin per the Revised Romanization of Korean (서울 → \"Seoul\"). Realises gmeow:schemeRevisedRomanization."@en ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeRevisedRomanization .

gmeow:fnTransliterateISO233
    a fno:Function ;
    rdfs:label "ISO 233 transliteration (Arabic → Latin)"@en ;
    dcterms:description "Transliterates Arabic script to Latin per ISO 233. Realises gmeow:schemeISO233. Reversible (character-level)."@en ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeISO233 .

gmeow:fnTransliterateISO15919
    a fno:Function ;
    rdfs:label "ISO 15919 transliteration (Indic → Latin)"@en ;
    dcterms:description "Transliterates Brahmic/Indic scripts to Latin per ISO 15919. Realises gmeow:schemeISO15919. Reversible."@en ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeISO15919 .

# --- Transcription (→ phonetic representation; not reversible) --------------- #

gmeow:fnTranscribeIPA
    a fno:Function ;
    rdfs:label "IPA phonetic transcription"@en ;
    dcterms:description "Transcribes spoken/written language to the International Phonetic Alphabet — a phonetic representation, not a script transliteration (\"Yamada\" → /jamada/). Realises gmeow:schemeIPA. NOT reversible (phonetic, language-specific)."@en ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTranscribed ) ;
    rdfs:seeAlso gmeow:schemeIPA .

# --- Translation (language → language; meaning-preserving, lossy) ------------ #

gmeow:fnTranslate
    a fno:Function ;
    rdfs:label "translate (language → language)"@en ;
    dcterms:description "Translates an expression from a source language to a target language, preserving meaning rather than form. A translation relates two CO-EQUAL expressions (neither subordinate); it is not a transliteration and never a name-of-a-person operation. Lossy and context-dependent; the source and target languages are gmeow:Language inputs."@en ;
    fno:expects ( gmeow:pSourceText gmeow:pTargetLanguage ) ;
    fno:returns ( gmeow:oTranslated ) ;
    rdfs:seeAlso <https://www.wikidata.org/entity/Q7553> .

# --- Shared parameters / outputs (declarative; no bound executor) ----------- #

gmeow:pSourceText     a fno:Parameter ; fno:predicate gmeow:fullName ; fno:type rdfs:Literal ; fno:required true .
gmeow:pTargetLanguage a fno:Parameter ; fno:predicate gmeow:targetLanguage ; fno:type gmeow:Language ; fno:required true .
gmeow:oTransliterated a fno:Output ; fno:predicate gmeow:romanization ; fno:type rdfs:Literal .
gmeow:oTranscribed    a fno:Output ; fno:predicate gmeow:projectedTranscription ; fno:type rdfs:Literal .
gmeow:oTranslated     a fno:Output ; fno:predicate gmeow:projectedTranslation ; fno:type rdfs:Literal .
