#
# Well-formed math→logic: lowering: a truth-valued math:MathematicalExpression (the
# Pythagorean equation) that declares math:denotationKind math:denotesProposition,
# lowers to a logic:Formula through math:compilesToLogicFormula, and records its
# math:logicLoweringPreservation as logic:ExactPreservation. Conforms to
# math:LogicLoweringShape and validates with no findings. Bound by ex:ecLogicLoweringDeclared.
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <http://example.org/math/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

# A node whose only structured child is math:hasMathematicalSymbol IS a symbol reference —
# the concrete form the lowering has a production for. The abstract math:MathematicalExpression
# base carrying that edge is math:UnrecognizedExpressionType: structure present with no
# concrete form to interpret it.
ex:pythagoreanEq a math:SymbolReference ;
    rdfs:label "Pythagorean equation lowered to a logic: formula"@x-gmeow-english ;
    math:denotationKind math:denotesProposition ;
    math:compilesToLogicFormula ex:pythagoreanFormula ;
    math:logicLoweringPreservation logic:ExactPreservation ;
    math:hasMathematicalSymbol ex:pythagoreanEqSymbol .

ex:pythagoreanEqSymbol a math:MathematicalSymbol ;
    rdfs:label "the Pythagorean equation, as a named symbol"@x-gmeow-english .

ex:pythagoreanFormula a logic:Formula ;
    rdfs:label "Pythagorean logic: formula target of the lowering"@x-gmeow-english ;
    logic:relation ex:pythagoreanEqualityRelation ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] , [ logic:termIndex 2 ; logic:termVariable "c" ] .
