  <https://blackcatinformatics.ca/gmeow/openehr/bloodpressure/magnitude> <http://www.w3.org/2001/XMLSchema#decimal> MININCLUSIVE 0 MAXEXCLUSIVE 1000 ;
  <https://blackcatinformatics.ca/gmeow/openehr/bloodpressure/units> ["mm[Hg]"^^<http://www.w3.org/2001/XMLSchema#string>] ;
}

