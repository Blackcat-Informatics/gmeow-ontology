        [ a logic:TermCarrier ; logic:termIndex 4 ; logic:termIri logic:EffectIntended ] ,
        [ a logic:TermCarrier ; logic:termIndex 5 ; logic:termIri logic:EffectReceipted ] ,
        [ a logic:TermCarrier ; logic:termIndex 6 ; logic:termIri logic:EffectReconciled ] ,
        [ a logic:TermCarrier ; logic:termIndex 7 ; logic:termIri logic:EffectReconciling ] .

