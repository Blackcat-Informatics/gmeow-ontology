ex:saHasTrajectorySampleIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasTrajectorySample a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:hasTrajectorySample MUST be an owl:ObjectProperty." .

# --- 57. No preferred/primary stream terms (MUST-NOT) -------------------------
ex:saNoPreferredPrimaryStreamTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned {
        gmeow:primaryStream gmeow:preferredStream
        gmeow:primaryLocationStream gmeow:preferredLocationStream
    }
    VALUES ?t {
        owl:ObjectProperty owl:DatatypeProperty
        owl:AnnotationProperty owl:Class
    }
    ?banned a ?t .
}""" ;
    gmeow:saRationale "No preferred*/primary* stream selectors MUST NOT exist (Principle 9, co-equality)." .

# --- 58. Capacity/Occupancy/Utilization subclass Measurement (MUST) -----------
ex:saCapacityOccupancyUtilizationSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Capacity    a owl:Class ; rdfs:subClassOf gmeow:Measurement .
    gmeow:Occupancy   a owl:Class ; rdfs:subClassOf gmeow:Measurement .
    gmeow:Utilization a owl:Class ; rdfs:subClassOf gmeow:Measurement .
}""" ;
    gmeow:saRationale "gmeow:Capacity, Occupancy, and Utilization MUST be owl:Class and rdfs:subClassOf gmeow:Measurement." .

# --- 59. capacityOf with domain/range/subPropertyOf (MUST) --------------------
ex:saCapacityOfShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:capacityOf rdfs:domain gmeow:Capacity ;
        rdfs:range  gmeow:Location ;
        rdfs:subPropertyOf gmeow:observedFeature .
}""" ;
    gmeow:saRationale "gmeow:capacityOf MUST have domain Capacity, range Location, and rdfs:subPropertyOf observedFeature (its functionality is now carried by a logic:PropertyCharacteristicAssertion, DL-enforced)." .

# --- 60. occupancyOf with domain/range/subPropertyOf (MUST) -------------------
