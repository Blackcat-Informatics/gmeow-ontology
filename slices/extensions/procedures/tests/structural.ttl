# --- 10. Research inquiry properties exist with correct RDF types (MUST) -------
ex:saResearchInquiryProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:inquiryPriority    a owl:DatatypeProperty .
    gmeow:inquiryTheme       a owl:DatatypeProperty .
    gmeow:inquiryStatus      a owl:ObjectProperty .
    gmeow:resolvedByArtifact a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:inquiryPriority and gmeow:inquiryTheme MUST be owl:DatatypeProperty; gmeow:inquiryStatus and gmeow:resolvedByArtifact MUST be owl:ObjectProperty — these four constitute the research-inquiry profile of the procedures slice. Mirrors test_research_inquiry_has_priority_theme_status." .

# --- 11. subProcedureOf and hasSubProcedure are transitive and sub-properties (MUST) ---
ex:saSubprocedureComposition a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:subProcedureOf  a owl:TransitiveProperty ;
        rdfs:subPropertyOf gmeow:partOf .
    gmeow:hasSubProcedure a owl:TransitiveProperty ;
        rdfs:subPropertyOf gmeow:hasPart .
}""" ;
    gmeow:saRationale "gmeow:subProcedureOf and gmeow:hasSubProcedure MUST both be owl:TransitiveProperty and specialisations of the universal mereology spine (partOf / hasPart) — recursive subprocess composition. Mirrors test_subprocedure_composition." .

# --- 12. executesProcedure and executesStep are owl:ObjectProperty (MUST) ------
ex:saExecutionLinksProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:executesProcedure a owl:ObjectProperty .
    gmeow:executesStep      a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:executesProcedure and gmeow:executesStep MUST be owl:ObjectProperty — they bridge the execution side to its plan-level counterparts (plan ⟂ execution de-conflation). Mirrors test_execution_links_to_procedure_and_step." .

# --- 13. ControlFlow relator properties exist (MUST) --------------------------
ex:saControlFlowProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:flowSource a owl:ObjectProperty .
    gmeow:flowTarget a owl:ObjectProperty .
    gmeow:flowGuard  a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:flowSource, gmeow:flowTarget, and gmeow:flowGuard MUST all be owl:ObjectProperty — they constitute the internal structure of the ControlFlow relator. Mirrors test_control_flow_has_source_target." .

# --- 14. DataFlow relator properties exist (MUST) -----------------------------
ex:saDataFlowProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:dataFlowSource a owl:ObjectProperty .
    gmeow:dataFlowTarget a owl:ObjectProperty .
    gmeow:dataFlowEntity a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:dataFlowSource, gmeow:dataFlowTarget, and gmeow:dataFlowEntity MUST all be owl:ObjectProperty — they constitute the internal structure of the DataFlow relator. Mirrors test_data_flow_has_source_target_entity." .

# --- 15. The canonical procedure example carries its logic:Plan success criterion (MUST) ---
ex:saProcedureExamplePlanGoal a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:procedureIngestionCanonical logic:planGoal gmeow:goalCanonicalIngestion ;
        logic:planSuccessMode logic:StrongPlanSuccess .
}""" ;
    gmeow:saRationale "Re-seating gmeow:Procedure under logic:Plan means the worked example gmeow:procedureIngestionCanonical MUST carry its plan success criterion — logic:planGoal gmeow:goalCanonicalIngestion and logic:planSuccessMode logic:StrongPlanSuccess (every execution reaches the ingested state) — so the procedure-as-plan projection contract is pinned and cannot silently drift back to a goal-less spec." .
