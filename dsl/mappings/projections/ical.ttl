@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ical:  <http://www.w3.org/2002/12/cal/icaltzd#> .

# Projection mappings: GMEOW events → pure iCalendar (RFC 5545 RDF). Compiled to
# projections/ical.edoal.ttl + queries/projections/ical.rq by `gmeow
# compile-mappings`. Projection-grade and lossy by design: a reified, multi-source,
# fuzzy-dated, participation-lattice gmeow:Event collapses to a single flat VEVENT
# with one DTSTART/DTEND, a SUMMARY label, a LOCATION, and bare ATTENDEEs — the
# event's roles, periods, confidence, standpoints and sub-event tree are dropped.

# A crisp interval event → VEVENT with DTSTART/DTEND from the interval endpoints.
gmeow:mapIcalVeventInterval a gmeow:ProjectionMapping ;
    rdfs:label "Event + interval → iCalendar VEVENT (DTSTART/DTEND)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "event" ;
        gmeow:atom (
            [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:eventInterval ; gmeow:objectVar "iv" ]
            [ gmeow:subjectVar "iv" ; gmeow:predicate gmeow:startedAtTime ; gmeow:objectVar "start" ; gmeow:optional true ]
            [ gmeow:subjectVar "iv" ; gmeow:predicate gmeow:endedAtTime ; gmeow:objectVar "end" ; gmeow:optional true ]
            [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:eventLocation ; gmeow:objectVar "loc" ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "event" ; gmeow:tPred rdf:type ; gmeow:tObjValue ical:Vevent ]
            [ gmeow:tSubj "event" ; gmeow:tPred ical:dtstart ; gmeow:tObj "start" ]
            [ gmeow:tSubj "event" ; gmeow:tPred ical:dtend ; gmeow:tObj "end" ]
            [ gmeow:tSubj "event" ; gmeow:tPred ical:location ; gmeow:tObj "loc" ] ) ] .

# A point event → VEVENT with a single DTSTART (the instant). Precedence interval >
# point > fuzzy: this branch is EXCLUDED when the event also carries an interval or
# fuzzy bounds, so exactly one VEVENT time branch fires per event (a valid VEVENT
# has one DTSTART/DTEND).
gmeow:mapIcalVeventPoint a gmeow:ProjectionMapping ;
    rdfs:label "Event + point time → iCalendar VEVENT (DTSTART)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "event" ;
        gmeow:atom (
            [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:eventTime ; gmeow:objectVar "start" ]
            [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:eventLocation ; gmeow:objectVar "loc" ; gmeow:optional true ] ) ;
        gmeow:excludeWhen [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:eventInterval ; gmeow:objectVar "ivAny" ] ;
        gmeow:excludeWhen [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:earliestStart ; gmeow:objectVar "esAny" ] ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "event" ; gmeow:tPred rdf:type ; gmeow:tObjValue ical:Vevent ]
            [ gmeow:tSubj "event" ; gmeow:tPred ical:dtstart ; gmeow:tObj "start" ]
            [ gmeow:tSubj "event" ; gmeow:tPred ical:location ; gmeow:tObj "loc" ] ) ] .

# A fuzzy (circa) event → VEVENT spanning the earliest/latest bounds; the
# gmeow:temporalPrecision qualifier is dropped (iCal cannot carry it). Excluded when
# the event also carries a crisp interval or point time (lowest precedence).
gmeow:mapIcalVeventFuzzy a gmeow:ProjectionMapping ;
    rdfs:label "Fuzzy event bounds → iCalendar VEVENT (DTSTART/DTEND)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "event" ;
        gmeow:atom (
            [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:earliestStart ; gmeow:objectVar "start" ]
            [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:latestEnd ; gmeow:objectVar "end" ; gmeow:optional true ]
            [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:eventLocation ; gmeow:objectVar "loc" ; gmeow:optional true ] ) ;
        gmeow:excludeWhen [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:eventInterval ; gmeow:objectVar "ivAny" ] ;
        gmeow:excludeWhen [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:eventTime ; gmeow:objectVar "etAny" ] ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "event" ; gmeow:tPred rdf:type ; gmeow:tObjValue ical:Vevent ]
            [ gmeow:tSubj "event" ; gmeow:tPred ical:dtstart ; gmeow:tObj "start" ]
            [ gmeow:tSubj "event" ; gmeow:tPred ical:dtend ; gmeow:tObj "end" ]
            [ gmeow:tSubj "event" ; gmeow:tPred ical:location ; gmeow:tObj "loc" ] ) ] .

# Event type label → SUMMARY (the human-readable title; the open type vocab
# collapses to one label).
gmeow:mapIcalSummary a gmeow:ProjectionMapping ;
    rdfs:label "Event type label → iCalendar SUMMARY"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "event" ; gmeow:value "summary" ;
        gmeow:atom (
            [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:eventType ; gmeow:objectVar "et" ]
            [ gmeow:subjectVar "et" ; gmeow:predicate rdfs:label ; gmeow:objectVar "summary" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:toPredicate ical:summary ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnEventTypeToSummary ; gmeow:confidence 0.6 ;
        gmeow:lossyDrop "the event's full open type vocabulary collapses to one human-readable SUMMARY label" ] .

# Flat participant → ATTENDEE (the reified Participation's role/period/confidence
# are dropped; iCal ATTENDEE is a bare edge).
gmeow:mapIcalAttendee a gmeow:ProjectionMapping ;
    rdfs:label "hasParticipant → iCalendar ATTENDEE"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "event" ; gmeow:value "att" ;
        gmeow:atom ( [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:hasParticipant ; gmeow:objectVar "att" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:toPredicate ical:attendee ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnParticipantToAttendee ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "role / period / confidence / standpoint of the participation are dropped; the participant becomes a bare ATTENDEE" ] .

# Reified Participation → ATTENDEE (events whose participants are recorded only via
# the gmeow:Participation relator, not the flat shortcut, still get ATTENDEEs). The
# role/period/confidence/standpoint collapse; a superseded (displayable false)
# participation is suppressed (Principle 10).
gmeow:mapIcalAttendeeReified a gmeow:ProjectionMapping ;
    rdfs:label "Participation participant → iCalendar ATTENDEE"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "event" ; gmeow:value "att" ;
        gmeow:atom (
            [ gmeow:subjectVar "p" ; gmeow:predicate gmeow:participationEvent ; gmeow:objectVar "event" ]
            [ gmeow:subjectVar "p" ; gmeow:predicate gmeow:participationParticipant ; gmeow:objectVar "att" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "p" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:toPredicate ical:attendee ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnParticipationToEventRole ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "role / period / confidence / standpoint of the participation are dropped; the participant becomes a bare ATTENDEE" ] .

# =========================================================================== #
# Calendar / scheduling slice projections (#62)
# =========================================================================== #

# Task → VTODO (inherits VEVENT time/location via the Event superclass, adds
# DUE, PRIORITY, and STATUS).
gmeow:mapIcalVtodo a gmeow:ProjectionMapping ;
    rdfs:label "Task → iCalendar VTODO (DUE/PRIORITY/STATUS)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "task" ;
        gmeow:atom (
            [ gmeow:subjectVar "task" ; gmeow:predicate rdf:type ; gmeow:objectVar "type" ]
            [ gmeow:subjectVar "task" ; gmeow:predicate gmeow:taskDueDate ; gmeow:objectVar "due" ; gmeow:optional true ]
            [ gmeow:subjectVar "task" ; gmeow:predicate gmeow:taskPriority ; gmeow:objectVar "prio" ; gmeow:optional true ]
            [ gmeow:subjectVar "task" ; gmeow:predicate gmeow:taskStatus ; gmeow:objectVar "ts" ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "task" ; gmeow:tPred rdf:type ; gmeow:tObjValue ical:Vtodo ]
            [ gmeow:tSubj "task" ; gmeow:tPred ical:due ; gmeow:tObj "due" ]
            [ gmeow:tSubj "task" ; gmeow:tPred ical:priority ; gmeow:tObj "prio" ]
            [ gmeow:tSubj "task" ; gmeow:tPred ical:status ; gmeow:tObj "ts" ] ) ] .

# Reminder → VALARM (trigger + action). The action value vocabulary is projected
# to iCalendar ACTION text; standpoint/confidence are dropped.
gmeow:mapIcalValarm a gmeow:ProjectionMapping ;
    rdfs:label "Reminder → iCalendar VALARM (TRIGGER/ACTION)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "reminder" ;
        gmeow:atom (
            [ gmeow:subjectVar "reminder" ; gmeow:predicate gmeow:reminderTrigger ; gmeow:objectVar "trig" ]
            [ gmeow:subjectVar "reminder" ; gmeow:predicate gmeow:reminderAction ; gmeow:objectVar "act" ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "reminder" ; gmeow:tPred rdf:type ; gmeow:tObjValue ical:Valarm ]
            [ gmeow:tSubj "reminder" ; gmeow:tPred ical:trigger ; gmeow:tObj "trig" ]
            [ gmeow:tSubj "reminder" ; gmeow:tPred ical:action ; gmeow:tObj "act" ] ) ] .

# Availability slot → VFREEBUSY (start/end + FBTYPE). The agent and interval
# semantics collapse to a free-busy period.
gmeow:mapIcalVfreebusy a gmeow:ProjectionMapping ;
    rdfs:label "Availability → iCalendar VFREEBUSY (FBTYPE)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "avail" ;
        gmeow:atom (
            [ gmeow:subjectVar "avail" ; gmeow:predicate gmeow:availabilitySlot ; gmeow:objectVar "slot" ]
            [ gmeow:subjectVar "slot" ; gmeow:predicate gmeow:startedAtTime ; gmeow:objectVar "start" ]
            [ gmeow:subjectVar "slot" ; gmeow:predicate gmeow:endedAtTime ; gmeow:objectVar "end" ; gmeow:optional true ]
            [ gmeow:subjectVar "avail" ; gmeow:predicate gmeow:availabilityStatus ; gmeow:objectVar "fbtype" ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "avail" ; gmeow:tPred rdf:type ; gmeow:tObjValue ical:Vfreebusy ]
            [ gmeow:tSubj "avail" ; gmeow:tPred ical:dtstart ; gmeow:tObj "start" ]
            [ gmeow:tSubj "avail" ; gmeow:tPred ical:dtend ; gmeow:tObj "end" ]
            [ gmeow:tSubj "avail" ; gmeow:tPred ical:fbtype ; gmeow:tObj "fbtype" ] ) ] .

# TimeZone → VTIMEZONE (tzid). The full VTIMEZONE expansion (daylight/standard
# components) is a solver/projection concern; the ontology carries only the IRI.
gmeow:mapIcalVtimezone a gmeow:ProjectionMapping ;
    rdfs:label "TimeZone → iCalendar VTIMEZONE (TZID)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "tz" ;
        gmeow:atom (
            [ gmeow:subjectVar "tz" ; gmeow:predicate gmeow:timeZoneIanaId ; gmeow:objectVar "tzid" ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "tz" ; gmeow:tPred rdf:type ; gmeow:tObjValue ical:Vtimezone ]
            [ gmeow:tSubj "tz" ; gmeow:tPred ical:tzid ; gmeow:tObj "tzid" ] ) ] .

# EventInvitation PARTSTAT → iCalendar ATTENDEE with PARTSTAT parameter. The
# invitee and status are projected to a parameterized ATTENDEE; the organizer
# view and invitee view (invitationStatus vs rsvpStatus) may differ — the
# projection emits both as separate ATTENDEE lines or merges at the consumer.
gmeow:mapIcalInvitationPartstat a gmeow:ProjectionMapping ;
    rdfs:label "EventInvitation status → iCalendar ATTENDEE PARTSTAT"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "event" ; gmeow:value "att" ;
        gmeow:atom (
            [ gmeow:subjectVar "inv" ; gmeow:predicate gmeow:invitationEvent ; gmeow:objectVar "event" ]
            [ gmeow:subjectVar "inv" ; gmeow:predicate gmeow:invitationInvitee ; gmeow:objectVar "att" ]
            [ gmeow:subjectVar "inv" ; gmeow:predicate gmeow:invitationStatus ; gmeow:objectVar "st" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "event" ; gmeow:tPred ical:attendee ; gmeow:tObj "att" ] ) ;
        gmeow:confidence 0.7 ;
        gmeow:lossyDrop "the reified invitation (agreement/period/confidence/standpoint) collapses to a bare ATTENDEE with PARTSTAT" ] .

# Schedule recurrence rule → RRULE text. The structured rule is projected to the
# RFC 5545 RRULE string; any additional structured metadata is dropped.
gmeow:mapIcalRrule a gmeow:ProjectionMapping ;
    rdfs:label "RecurrenceRule text → iCalendar RRULE"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "rule" ; gmeow:value "rrule" ;
        gmeow:atom (
            [ gmeow:subjectVar "rule" ; gmeow:predicate gmeow:recurrenceRuleText ; gmeow:objectVar "rrule" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:toPredicate ical:rrule ; gmeow:relation "<=" ;
        gmeow:confidence 0.95 ;
        gmeow:lossyDrop "any structured metadata beyond the RFC 5545 text is dropped" ] .

# Calendar collection → VCALENDAR (tzid + members). The container projects to
# VCALENDAR with a PRODID and VERSION; members are projected as separate
# VEVENT/VTODO/VALARM components.
gmeow:mapIcalVcalendar a gmeow:ProjectionMapping ;
    rdfs:label "Calendar → iCalendar VCALENDAR (TZID)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "cal" ;
        gmeow:atom (
            [ gmeow:subjectVar "cal" ; gmeow:predicate rdf:type ; gmeow:objectVar "type" ]
            [ gmeow:subjectVar "cal" ; gmeow:predicate gmeow:calendarTimeZone ; gmeow:objectVar "tz" ; gmeow:optional true ]
            [ gmeow:subjectVar "tz" ; gmeow:predicate gmeow:timeZoneIanaId ; gmeow:objectVar "tzid" ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "ical" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "cal" ; gmeow:tPred rdf:type ; gmeow:tObjValue ical:Vcalendar ]
            [ gmeow:tSubj "cal" ; gmeow:tPred ical:tzid ; gmeow:tObj "tzid" ] ) ] .
