    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

gmeow:nameLanguage skos:closeMatch schema:inLanguage {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75
|} .

gmeow:nameLanguage skos:closeMatch wdt:P407 {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Wikidata 'language of work or name' (P407) — verified live against the Wikidata API"
|} .

# Endonym / exonym name purposes — co-equal toponym kinds (no privileged claimant).
gmeow:namePurposeEndonym skos:closeMatch wd:Q1266782 {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Wikidata 'endonym' (Q1266782) — verified live against the Wikidata API"
|} .

gmeow:namePurposeExonym skos:closeMatch wd:Q81639 {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Wikidata 'exonym' (Q81639) — verified live against the Wikidata API"
|} .

# OntoLex-Lemon alignments for names
gmeow:Appellation rdfs:subClassOf ontolex:LexicalEntry {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "GMEOW Appellation subclasses OntoLex LexicalEntry"
|} .

gmeow:nameLanguage skos:closeMatch lime:language {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "GMEOW nameLanguage close-matches LIME language"
|} .

gmeow:fullName skos:closeMatch ontolex:writtenRep {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW fullName close-matches OntoLex writtenRep"
|} .

# Cross-cutting multilingual labels — multilingual-label design. New bearer properties bridge to
# flat surface-vocabulary name/title literals by projection (Principle 5).

gmeow:hasOrganizationName skos:broadMatch schema:name {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "schema:name — downcast: an organization's structured name objects flatten to the schema:name literal in projection"
|} .

gmeow:hasOrganizationName skos:broadMatch vcard:organization-name {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "vcard:organization-name — downcast from structured OrganizationName to flat literal"
|} .

gmeow:hasOrganizationName skos:broadMatch foaf:name {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "foaf:name — downcast from structured OrganizationName to flat literal"
|} .

