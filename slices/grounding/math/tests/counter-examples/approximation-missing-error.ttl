#
# Counter-example for math:ApproximateValueShape: a math:ApproximateValue that
# names what it approximates but omits math:approximationError (sh:minCount 1),
# so validation MUST emit shacl.MinCountConstraintComponent (and no other finding).
# Bound by tests/example-conformance.ttl (ex:ecApproximationMissingError).
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <http://example.org/math/> .

ex:approxNoError a math:ApproximateValue ;
    math:approximates ex:exactThird .

ex:exactThird a math:RationalNumber ;
    math:inNumberSystem math:rationalNumbers ;
    math:isExact true .
