    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — lang surface blob"@x-gmeow-english ;
    skos:definition "The lifted linguistic-surface blob: one frame per @x-gmeow-english source literal over the document-scale threshold. SINK-FOLDED — assembled only at the terminal snapshot. It is primed by gmeow:dictGmeowCoreV1, the same dictionary gmeow:payloadSchemaLangProjectionsArchive selects: the two reps were the whole population of a retired linguistic dictionary that could not pay for its own in-band bytes over them (see the retirement note above), and they stay dictionary-compressed by riding the core dictionary instead."@x-gmeow-english ;
    gmeow:payloadSchemaId "lang-surface-blob" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ;
    gmeow:payloadSchemaDictionary gmeow:dictGmeowCoreV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

