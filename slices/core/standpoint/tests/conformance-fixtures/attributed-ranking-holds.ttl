#
# One standpoint ranked above another by one ranker, as an RDF 1.2 reified statement
# carrying both gmeow:accordingTo and gmeow:validFrom. Validated slice-scoped only.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/standpoint/tests/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:orthodoxy a gmeow:Standpoint .
ex:revisionists a gmeow:Standpoint .

ex:orthodoxy gmeow:moreEntrenchedThan ex:revisionists ~ ex:rankOrthodoxyOverRevisionists
    {| gmeow:accordingTo ex:editor ; gmeow:validFrom "2026-01-01T00:00:00Z"^^xsd:dateTime |} .
