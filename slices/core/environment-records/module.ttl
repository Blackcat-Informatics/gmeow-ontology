gmeow:StateViewHeadDefinitionLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "state view head definition"@x-gmeow-english ;
    skos:definition "Current state claims are exactly the retained members with no superseding member in the same view. Every concurrent head is retained; clocks and serialization order choose no winner."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency within the declared source scope."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this law executes a provider, verifies source bytes or grants disclosure permission."@x-gmeow-english ;
