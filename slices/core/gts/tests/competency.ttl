# =========================================================================== #
# 4. The reference graph: what does each medium-axis hop resolve into?        #
# =========================================================================== #

ex:cqMediumReferenceRanges a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/gts/queries/competency/medium-reference-ranges.rq" ;
    gmeow:cqRationale "Decoding a primed frame is a WALK: from the frame to its envelope, from the envelope to the dictionary and the registered schema, from the schema to the medium, from the medium to the codec and the judged losslessness crossing, and from the dictionary to the corpus a reviewer audits it against. Every hop in that walk has to land somewhere DECLARED, and this question is where the graph says what each hop's landing class is. If the answer is wrong the walk stops being total: a reference whose range nobody states can be satisfied by an untyped node, and an untyped node standing in for a medium leaves that rep's round-trip law unstated — the silent per-call decision this axis exists to delete. Two rows carry more than they look: gmeow:mediumCorrespondence resolves into a logic:Correspondence rather than a boolean, which is what makes 'this medium round-trips' a judged crossing with named endpoints instead of a flag nobody can discharge; and gmeow:corpusSelectsStageProduct resolves into a gmeow:PipelineStage, which is how the one sink-folded corpus reaches material that has no standalone archive to name." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:shapeMediumReferenceRanges ;
    gmeow:cqExpectRow
        ex:rowRange01 ,
        ex:rowRange02 ,
        ex:rowRange03 ,
        ex:rowRange04 ,
        ex:rowRange05 ,
        ex:rowRange06 ,
        ex:rowRange07 ,
        ex:rowRange08 ,
        ex:rowRange09 ,
        ex:rowRange10 ,
        ex:rowRange11 ,
        ex:rowRange12 ,
        ex:rowRange13 ,
        ex:rowRange14 ,
        ex:rowRange15 ,
        ex:rowRange16 ,
        ex:rowRange17 ,
        ex:rowRange18 ,
        ex:rowRange19 ,
        ex:rowRange20 .

ex:shapeMediumReferenceRanges a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "reference" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "resolvesTo" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowRange01 a gmeow:ExpectedRow ;
