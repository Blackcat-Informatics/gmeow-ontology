# --- languageTag → carrierTag: retract to carriers (LossyLens, NOT a section) - #
sup:langTagCarrier a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "supersession: gmeow:languageTag → lang:carrierTag"@x-gmeow-english ;
    skos:definition "The internal x-gmeow-* private-use tag: gmeow:languageTag survives only as lang:carrierTag on the three framework-authoring carrier varieties (lang:gmeowEnglish/gmeowFrench/gmeowMandarin). LossyLens, not a section: the per-language x-gmeow-* tags on the data-tier reference-catalog languages are DROPPED (the self-minted IRI is the identity), so the property does not recover its old per-language extent."@x-gmeow-english ;
    logic:supersededTerm gmeow:languageTag ;
    logic:supersedingTerm lang:carrierTag ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:LossyLens ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "false"^^xsd:boolean ;
    gmeow:graphBoxRole gmeow:boxABox .

# --- bcp47Tag → generated projection (LossyLens) --------------------------- #
sup:langBcp47Projection a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "supersession: gmeow:bcp47Tag (authored) → generated variety projection"@x-gmeow-english ;
    skos:definition "The authored gmeow:bcp47Tag property is removed; the tag is now GENERATED from lang:LanguageVariety structure (varietyOf parent ISO-639 notation + orthography script) and folded into the bundle. LossyLens: a flat tag carries no variety-relation structure, no diachronic history, and no orthography split — the projection is lossy by construction, the same judgment crates/lang-bridge/src/bcp47.rs carries per emission."@x-gmeow-english ;
    logic:supersededTerm gmeow:bcp47Tag ;
    logic:supersedingTerm lang:LanguageVariety ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:LossyLens ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "false"^^xsd:boolean ;
    gmeow:graphBoxRole gmeow:boxABox .

# --- transliterationScheme graft: retained + regrounded (AffineCorrespondence) #
