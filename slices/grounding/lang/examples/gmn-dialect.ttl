# Illustrative clean scene for the GMN dialect graft. Demonstrates the three
# working surfaces of the dialect: a codepoint-explicit glyph of the GMN script
# bound to the term it denotes through a full lang:Denotation record (with its
# symbol provenance carried by the citations vocabulary), a complete
# gmeow:GmnEnvelope with its full eight-field contract, and an honest GMN-2
# compaction that names its sources, its standpoint, and its validation-only
# correspondence — losslessness is always a judged logic:Correspondence,
# never a boolean flag.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/lang/> .

# --- A GMN glyph: codepoint-explicit, denotation-bound, citation-grounded ---- #
# The ⊑ glyph (U+2291) joins the GMN script's repertoire codepoint-explicitly.
# Its operator form denotes the subsumption relation through a full reified
# lang:Denotation record — the canonical fact the writer-projected gmeow:gmnGlyph
# convenience flattens. Symbol provenance is the citations vocabulary's job,
# carried on the glyph's SOURCE RECORD (an information object referencing the
# grapheme): a flat gmeow:cites edge to the standard DL notation source,
# promoted to a gmeow:CitationAct because the intent (the glyph conforms to
# standard DL notation) is worth typing.

gmeow:gmnScript lang:hasGrapheme ex:gSquareImageOfOrEqual .

ex:gSquareImageOfOrEqual
    a lang:Grapheme ;
    rdfs:label "square image of or equal to"@x-gmeow-english ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+2291" .

ex:subsumesOperatorForm
    a lang:WordForm ;
    rdfs:label "the GMN subsumption operator"@x-gmeow-english ;
    lang:inSignSystem gmeow:gmnModelNotation .

ex:denSubsumesOperator
    a lang:Denotation ;
    lang:denotedForm ex:subsumesOperatorForm ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget rdfs:subClassOf ;
    lang:denotationContext ex:gmnGlyphTableContext .

ex:gmnGlyphTableContext
    a gmeow:InformationObject ;
    rdfs:label "the GMN glyph-table context"@x-gmeow-english .

ex:glyphSourceRecordSquareImage
    a gmeow:InformationObject ;
    rdfs:label "glyph-table source record for ⊑"@x-gmeow-english ;
    gmeow:references ex:gSquareImageOfOrEqual ;
    gmeow:cites ex:dlNotationCanon .

ex:dlNotationCanon
    a gmeow:CreativeWork ;
    gmeow:title "The Description Logic Handbook"@x-gmeow-english .

ex:citeSquareImageGlyph
    a gmeow:CitationAct ;
    gmeow:citingEntity   ex:glyphSourceRecordSquareImage ;
    gmeow:citedEntity    ex:dlNotationCanon ;
    gmeow:citationIntent gmeow:intentConformsTo .

# --- A complete GMN envelope: the full eight-field contract ------------------ #
# One envelope per serialized GMN payload: the three dialect coordinates, the
# boundary ring, the asserting standpoint, the generating activity, the
# byte-exact digest, and the losslessness judgment — a logic:Correspondence.

ex:archiveKeeper a gmeow:Agent .
ex:nightlyGmnWrite a gmeow:Activity .

ex:corrNightlyEnvelope
    a logic:Correspondence ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:LossyLens ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic false .

ex:nightlyEnvelope
    a gmeow:GmnEnvelope ;
    gmeow:gmnSchemaVersion "1" ;
    gmeow:gmnDictionaryVersion "1" ;
    gmeow:gmnGlyphTableVersion "1" ;
    gmeow:gmnSecurityRing gmeow:gmnRingTrusted ;
    gmeow:accordingTo ex:archiveKeeper ;
    gmeow:wasGeneratedBy ex:nightlyGmnWrite ;
    gmeow:contentDigest "blake3:9c4b1d7e2f5a8c0b3e6d9f2a5c8b1e4d7a0c3f6b9e2d5a8c1b4e7d0a3c6f9b2e" ;
    gmeow:gmnEnvelopeCorrespondence ex:corrNightlyEnvelope .

# --- An honest GMN-2 compaction: provenance-linked, vantage-held ------------- #
# Compaction NEVER overwrites its sources: it is a reified NEW claim naming
# every source through gmeow:gmnCompacts and its holding standpoint through
# gmeow:vantage. Its correspondence carries the honest weak judgment —
# logic:ValidationOnly, logic:mnemomorphic false — because what a compaction
# keeps is a judgment call held on the compaction's own standpoint.

ex:sensorCrew a gmeow:Agent .
ex:summarizer a gmeow:Agent .

ex:claimGateOpenMonday a gmeow:StandpointClaim ;
    gmeow:vantage ex:sensorCrew .

ex:claimGateOpenTuesday a gmeow:StandpointClaim ;
    gmeow:vantage ex:sensorCrew .

ex:corrGateWeekCompaction
    a logic:Correspondence ;
    logic:preservationKind logic:ValidationOnly ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:BridgeView ;
    logic:hasDeterminacy logic:Vague ;
    logic:mnemomorphic false .

ex:compactionGateWeek
    a gmeow:GmnCompaction ;
    gmeow:gmnCompacts ex:claimGateOpenMonday , ex:claimGateOpenTuesday ;
    gmeow:vantage ex:summarizer ;
    lang:translationCorrespondence ex:corrGateWeekCompaction .
