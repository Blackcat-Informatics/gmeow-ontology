# Native verify QC — the load-bearing regression guard. Removing the strict
# gmeow:hasSkill rdfs:subPropertyOf gmeow:knowsAbout must NOT be silently
# reintroduced: this lane runs over the EL/DL closure, so a re-added subproperty
# axiom would expand into a materialized gmeow:knowsAbout edge and be caught here.
# The canonical source of a gmeow:knowsAbout edge is a declarative-familiarity
# logic:CognitiveAssessment (via the ladder projection) or a deeper rung; a skill
# is defeasible evidence only and never a source under the shipped reasoning.
#
# This returns a row → FAILURE when an agent both has a skill in a subject AND
# knows-about that same subject (asserted or in the EL/DL closure), yet nothing
# legitimately justifies the knowing-about (no deeper rung, no backing
# declarative-familiarity assessment — the canonical source of knows-about) — the
# signature of the forbidden hasSkill → knowsAbout entailment in the reasoned graph.

PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>

SELECT ?agent ?subject WHERE {
    ?agent gmeow:hasSkill ?subject .
    ?agent gmeow:knowsAbout ?subject .
    FILTER NOT EXISTS { ?agent gmeow:understands ?subject }
    FILTER NOT EXISTS { ?agent gmeow:hasMastered ?subject }
    FILTER NOT EXISTS {
        ?assessment logic:assessedAgent ?agent ;
                    logic:assessmentSubject ?subject ;
                    logic:assessmentDimension logic:dimensionDeclarativeFamiliarity .
    }
}
