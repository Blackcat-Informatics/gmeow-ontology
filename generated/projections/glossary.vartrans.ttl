    a ontolex:Form ;
    ontolex:writtenRep "Le plancher de score de l'axe de qualité de la prose requis pour mériter le palier Lié."@fr .

<http://example.org/lang/glossary-vartrans/form-tgt/eec998316b25c6c6>
    a ontolex:Form ;
    ontolex:writtenRep "Contrainte d'injectivité d'alias du dictionnaire GMN"@fr .

<http://example.org/lang/glossary-vartrans/form-tgt/eecb615683ac6f2d>
    a ontolex:Form ;
