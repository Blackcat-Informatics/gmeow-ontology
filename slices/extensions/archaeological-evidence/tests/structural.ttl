# --- 41. PhysicalCarrierType is an owl:Class, logic:AbstractIndividualType,
#         subClassOf logic:QualityValue (MUST) -----------------------------------
ex:saPhysicalCarrierTypeIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PhysicalCarrierType a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:PhysicalCarrierType MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue — the carrier classification is an open value vocabulary (individuals, never subclasses); new kinds are minted without ontology modification. Mirrors test_physical_carrier_type_value_vocabulary (class structure part)." .

# --- 42. Twelve PhysicalCarrierType seed individuals exist (MUST) -------------
ex:saPhysicalCarrierTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:carrierTablet         a gmeow:PhysicalCarrierType .
    gmeow:carrierOstracon       a gmeow:PhysicalCarrierType .
    gmeow:carrierSeal           a gmeow:PhysicalCarrierType .
    gmeow:carrierCoin           a gmeow:PhysicalCarrierType .
    gmeow:carrierManuscript     a gmeow:PhysicalCarrierType .
    gmeow:carrierWallInscription a gmeow:PhysicalCarrierType .
    gmeow:carrierStela          a gmeow:PhysicalCarrierType .
    gmeow:carrierPapyrus        a gmeow:PhysicalCarrierType .
    gmeow:carrierPotterySherd   a gmeow:PhysicalCarrierType .
    gmeow:carrierBone           a gmeow:PhysicalCarrierType .
    gmeow:carrierMetal          a gmeow:PhysicalCarrierType .
    gmeow:carrierWood           a gmeow:PhysicalCarrierType .
}""" ;
    gmeow:saRationale "All twelve PhysicalCarrierType seed individuals (tablet, ostracon, seal, coin, manuscript, wallInscription, stela, papyrus, potterySherd, bone, metal, wood) MUST be present as gmeow:PhysicalCarrierType instances. Mirrors test_physical_carrier_type_value_vocabulary (seed individuals part)." .
