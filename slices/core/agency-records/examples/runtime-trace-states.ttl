@prefix ex: <https://example.org/runtime-trace/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Generic illustrative source records. Loading this scene runs no model,
# tool, checkpoint, cache, screening procedure or recency policy.
ex:runtime a gmeow:SoftwareAgent .
ex:archiveWriter a gmeow:SoftwareAgent .
ex:reader a gmeow:Agent .
ex:model a gmeow:SoftwareAgent .
ex:tool a gmeow:SoftwareAgent .
ex:screen a gmeow:SoftwareAgent .
ex:episode a gmeow:Event .
ex:traceSource a gmeow:InformationObject ;
    gmeow:description "The source groups these reported occurrences in one runtime episode."@en ;
    gmeow:wasAttributedTo ex:runtime ;
    gmeow:recordedAt "2030-05-02T09:30:00Z"^^xsd:dateTime .

# These are separate source-reported occurrences, not inferred executions.

ex:round a gmeow:Event ;
    gmeow:eventType gmeow:eventTypeTraceRound ;
    gmeow:subEventOf ex:episode .

ex:turnStart a gmeow:Event ;
    gmeow:eventType gmeow:eventTypeTraceTurnStart ;
    gmeow:subEventOf ex:episode .

ex:turnOutput a gmeow:Event ;
    gmeow:eventType gmeow:eventTypeTraceTurnOutput ;
    gmeow:subEventOf ex:episode .

ex:modelRequest a gmeow:Event ;
