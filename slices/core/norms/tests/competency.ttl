#
# Declarative competency questions authored as slice-resident test-DSL data,
# executed by the native Rust slice-test harness (crates/slicetest) over the
# full merged ontology, asserted lane (gmeow:reasoningNone).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/norms/tests/> .

ex:cqDeonticValueVocabularies a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/norms/queries/competency/deontic-value-vocabularies.rq" ;
    gmeow:cqRationale "Norms are only interoperable across issuers if the deontic axes are VALUES rather than sortals: a consumer who subclasses gmeow:DeonticModality to add a local flavour of obligation, instead of attaching one of its individuals, forks the vocabulary and breaks every downstream join on modality and authority. GMEOW must answer 'which of these are value vocabularies?' from the logic:AbstractIndividualType typing in the graph, not from prose, so that retyping either one stops the question answering rather than silently changing what a norm means." ;
    gmeow:cqResultShape ex:cqDvvShape ;
    gmeow:cqExpectRow ex:cqDvvAuthority , ex:cqDvvModality .

ex:cqDvvShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "vocabulary" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:cqDvvAuthority a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vocabulary" ; gmeow:cellValueIri gmeow:AuthorityLevel ] .
ex:cqDvvModality a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vocabulary" ; gmeow:cellValueIri gmeow:DeonticModality ] .

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix wordtest: <https://example.org/natural-language-values/tests/> .
@prefix wordcase: <https://example.org/language-values/> .

wordtest:cqConditionWords a gmeow:CompetencyQuestion ;
    gmeow:cqDataFile "examples/language-values.ttl" ;
    gmeow:cqQuery "PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/> SELECT ?condition ?words WHERE { ?condition a gmeow:Condition ; gmeow:conditionText ?words . }" ;
    gmeow:cqRationale "Condition recall preserves original language, direction and an explicitly unspecified language without coercing any value to a plain string." ;
    gmeow:cqResultShape wordtest:conditionWordShape ;
    gmeow:cqExpectRow wordtest:englishRow, wordtest:arabicRow, wordtest:unspecifiedRow .
wordtest:conditionWordShape a logic:ResultShape ; logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn [ logic:columnVariable "condition" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ],
        [ logic:columnVariable "words" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ] .
wordtest:englishRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "condition" ; gmeow:cellValueIri wordcase:english ],
        [ a gmeow:ExpectedCell ; gmeow:cellVar "words" ; gmeow:cellValueLiteral "The requester consented."@en ] .
wordtest:arabicRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "condition" ; gmeow:cellValueIri wordcase:arabic ],
        [ a gmeow:ExpectedCell ; gmeow:cellVar "words" ; gmeow:cellValueLiteral "وافق صاحب الطلب."@ar--rtl ] .
wordtest:unspecifiedRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "condition" ; gmeow:cellValueIri wordcase:unspecified ],
        [ a gmeow:ExpectedCell ; gmeow:cellVar "words" ; gmeow:cellValueLiteral "Source words without a declared language." ] .

# --- Authority and later treatment of an identified legal proposition ---------------------------
@prefix exd: <https://blackcatinformatics.ca/gmeow/examples/norms/> .

ex:cqLegalReviewFlags a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/norms/queries/competency/legal-authority-review-flags.rq" ;
    gmeow:cqDataFile "examples/legal-authority-treatment.ttl" ;
    gmeow:cqRationale "A later decision flags one earlier reading only through an explicit proposition dependency. The reading of the earlier decision on jurisdictional questions is flagged; no citation, no later claim and no other reading is." ;
    gmeow:cqResultShape ex:cqLegalReadingShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:rowFlagJurisdiction .

ex:cqLegalUnflaggedReadings a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/norms/queries/competency/legal-authority-unflagged-readings.rq" ;
    gmeow:cqDataFile "examples/legal-authority-treatment.ttl" ;
    gmeow:cqRationale "The later decision cites the earlier decision at two paragraphs, yet only the revised proposition's reading is flagged. The reading on the jurisdictional boundaries between administrative bodies is cited, restated and left unflagged, so a citation alone neither erases an earlier decision nor reverses every result that cited it." ;
    gmeow:cqResultShape ex:cqLegalReadingShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:rowUnflaggedBoundaries .

ex:cqLegalReadingShape a logic:ResultShape ;
    logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn [ logic:columnVariable "reading" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] .

ex:rowFlagJurisdiction a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "reading" ; gmeow:cellValueIri exd:claimDunsmuirJurisdiction ] .
ex:rowUnflaggedBoundaries a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "reading" ; gmeow:cellValueIri exd:claimDunsmuirBoundaries ] .

ex:cqLegalBindingByOrder a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/norms/queries/competency/legal-authority-binding-by-order.rq" ;
    gmeow:cqDataFile "examples/legal-authority-treatment.ttl" ;
    gmeow:cqRationale "Binding force is a claim in one legal order. The flagged earlier reading keeps its binding record, the Gitanyow statement of its own supremacy binds in its own order, and the concurring claim and the unresolved section 35 claim are not returned, so no source supplies force it does not state." ;
    gmeow:cqResultShape ex:cqLegalBindingShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:rowBindPresumption , ex:rowBindNoCategory , ex:rowBindJurisdiction , ex:rowBindBoundaries , ex:rowBindAyookxw .

ex:cqLegalBindingShape a logic:ResultShape ;
    logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn
        [ logic:columnVariable "order" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "claim" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] .

ex:rowBindPresumption a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "order" ; gmeow:cellValueIri exd:canadianLegalOrder ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "claim" ; gmeow:cellValueIri exd:claimVavilovPresumption ] .
ex:rowBindNoCategory a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "order" ; gmeow:cellValueIri exd:canadianLegalOrder ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "claim" ; gmeow:cellValueIri exd:claimVavilovNoCategory ] .
ex:rowBindJurisdiction a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "order" ; gmeow:cellValueIri exd:canadianLegalOrder ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "claim" ; gmeow:cellValueIri exd:claimDunsmuirJurisdiction ] .
ex:rowBindBoundaries a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "order" ; gmeow:cellValueIri exd:canadianLegalOrder ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "claim" ; gmeow:cellValueIri exd:claimDunsmuirBoundaries ] .
ex:rowBindAyookxw a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "order" ; gmeow:cellValueIri exd:gitanyowAyookxw ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "claim" ; gmeow:cellValueIri exd:claimAyookxwSupreme ] .

ex:cqLegalCorrespondence a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/norms/queries/competency/legal-authority-correspondence.rq" ;
    gmeow:cqDataFile "examples/legal-authority-treatment.ttl" ;
    gmeow:cqRationale "The only link between the Gitanyow order and the Canadian order is a correspondence attributed to the Gitanyow Nation and scoped to its own preamble; neither order's interpretation is established by the other's source." ;
    gmeow:cqResultShape ex:cqLegalCorrespondenceShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:rowCorrespondence .

ex:cqLegalCorrespondenceShape a logic:ResultShape ;
    logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn
        [ logic:columnVariable "correspondence" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "fromOrder" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "toOrder" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "agent" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "scope" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] .

ex:rowCorrespondence a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "correspondence" ; gmeow:cellValueIri exd:correspondenceAyookxwSection35 ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "fromOrder" ; gmeow:cellValueIri exd:gitanyowAyookxw ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "toOrder" ; gmeow:cellValueIri exd:canadianLegalOrder ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "agent" ; gmeow:cellValueIri exd:gitanyowNation ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "scope" ; gmeow:cellValueIri exd:scopePreamble ] .

ex:cqLegalUnsupportedForce a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/norms/queries/competency/legal-authority-unsupported-force.rq" ;
    gmeow:cqDataFile "examples/legal-authority-treatment.ttl" ;
    gmeow:cqRationale "No correspondence carries force, and every binding or persuasive claim carries the pinpoint source and forum its force needs, so a recorded force is always backed by evidence." ;
    gmeow:cqResultShape ex:cqLegalUnsupportedShape ;
    gmeow:cqExpectRowCount 0 .

ex:cqLegalUnsupportedShape a logic:ResultShape ;
    logic:shapeCardinality logic:RowsCount ;
    logic:shapeRowCount 0 ;
    logic:declaresColumn [ logic:columnVariable "subject" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] .
