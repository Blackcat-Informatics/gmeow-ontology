ex:cqApprovalStatesRowApprovalViolated a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:ApprovalViolated ] .

ex:cqEffectProtocolPositions a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX logic: <https://blackcatinformatics.ca/logic/> SELECT ?term WHERE { ?term a logic:EffectProtocolPosition } ORDER BY ?term" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "An external effect walks eight positions, and the roster exists so that no-blind-retry is a readable position rather than a rule someone must remember. Attempted is the undetermined position — dispatched, no receipt — and it is separated from both intended and receipted precisely because the safe action differs in all three. Reconciling and reconciled, compensating and compensated are likewise kept apart: the in-flight position of a recovery is not its settled one, and collapsing them is how a half-finished compensation gets read as a finished one." ;
    gmeow:cqResultShape ex:cqKernelRosterShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:cqEffectProtocolPositionsRowEffectAbandoned , ex:cqEffectProtocolPositionsRowEffectAttempted , ex:cqEffectProtocolPositionsRowEffectCompensated , ex:cqEffectProtocolPositionsRowEffectCompensating , ex:cqEffectProtocolPositionsRowEffectIntended , ex:cqEffectProtocolPositionsRowEffectReceipted , ex:cqEffectProtocolPositionsRowEffectReconciled , ex:cqEffectProtocolPositionsRowEffectReconciling  .

ex:cqEffectProtocolPositionsRowEffectAbandoned a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:EffectAbandoned ] .
