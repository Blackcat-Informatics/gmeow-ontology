#
# Counter-example for math:ConnectedSpaceShape: a math:ConnectedSpace that does not declare
# math:isConnected (sh:minCount 1) — connectedness assumed from the type, not declared.
# Validation MUST emit shacl.MinCountConstraintComponent (math:UndeclaredTopologicalProperty).
# Bound by ex:ecConnectednessAssumed.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:assumedConnected a math:ConnectedSpace ;
    rdfs:label "a space whose connectedness is assumed, not declared"@x-gmeow-english .
