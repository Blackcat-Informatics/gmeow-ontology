    ] .

<https://blackcatinformatics.ca/gmeow/MitigationCountersPresenceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Mitigation> ;
