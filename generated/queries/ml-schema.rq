# Projection: GMEOW → pure ml-schema. GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT.
# Lossy and directional by design; drops: mls:executes carries only the run→implementation link; the gmeow deployment's artifact·host·endpoint·interval binding beyond the bare executable realization is not re-expressed by the flat mls:executes relation; gmeow:ModelDeployment is a relator binding artifact·service·host·endpoint·interval·operator·policy; mls:Implementation carries only the executable-realization framing — the service identity, host, endpoint, and serving interval drop; mls:Model is the learned-model output of a run; gmeow:ModelArtifact adds the content-digest and the distribution/versioning framing (aligned by reference to the software slice) that mls:Model does not carry; mls:Run is training/evaluation-centred (executes an implementation on data, producing a model); gmeow:RuntimeExecution is a serving occurrent within which gmeow:ModelInvocation events occur — the durable subject/tenure/attributed-provenance and the invocation sub-events drop.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX mls: <http://www.w3.org/ns/mls#>

CONSTRUCT {
    ?mlsExec mls:executes ?mlsImpl .
    ?mlsDeployment a mls:Implementation .
    ?mlsArtifact a mls:Model .
    ?mlsExecution a mls:Run .
}
WHERE {
    {
        ?mlsExec gmeow:executionOfDeployment ?mlsImpl .
        FILTER NOT EXISTS { ?mlsExec gmeow:displayable false . }
    }
    UNION {
        ?mlsDeployment a gmeow:ModelDeployment .
        FILTER NOT EXISTS { ?mlsDeployment gmeow:displayable false . }
    }
    UNION {
        ?mlsArtifact a gmeow:ModelArtifact .
        FILTER NOT EXISTS { ?mlsArtifact gmeow:displayable false . }
    }
    UNION {
        ?mlsExecution a gmeow:RuntimeExecution .
        FILTER NOT EXISTS { ?mlsExecution gmeow:displayable false . }
    }
}
