@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix esco: <http://data.europa.eu/esco/model#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:Role owl:equivalentClass org:Role {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

schema:OrganizationRole rdfs:subClassOf gmeow:Role {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:Membership owl:equivalentClass org:Membership {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:Occupation owl:equivalentClass schema:Occupation {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:Post owl:equivalentClass org:Post {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "post (seat independent of holder)"
|} .

gmeow:organizationTypeCompany skos:closeMatch org:FormalOrganization {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "company type value ≈ formal organization (lossy: not every formal org is a company)"
|} .

gmeow:organizationTypeCollaboration skos:closeMatch org:OrganizationalCollaboration {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "collaboration type value ≈ organizational collaboration"
|} .

gmeow:Occupation owl:equivalentClass esco:Occupation {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "ESCO occupation is ISCO-grounded; GMEOW Occupation is the superset"
|} .

gmeow:Identifier skos:closeMatch schema:PropertyValue {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the reified external-identifier record IS schema's PropertyValue bundle (propertyID/value/url/name); closeMatch — schema's PropertyValue is broader (any keyed value), the projection narrows to identifier records"
|} .

gmeow:Offering skos:closeMatch schema:Offer {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a commercial offering IS schema:Offer"
|} .

gmeow:ServiceOffering skos:closeMatch schema:Service {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a commercial service offering IS schema:Service"
|} .

gmeow:OpeningHoursSpecification skos:closeMatch schema:OpeningHoursSpecification {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "an opening-hours window IS schema:OpeningHoursSpecification"
|} .

gmeow:memberOf owl:equivalentProperty schema:memberOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:memberOf skos:closeMatch org:memberOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:hasMember skos:closeMatch org:member {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

gmeow:subOrganizationOf owl:equivalentProperty org:subOrganizationOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:subOrganizationOf owl:equivalentProperty schema:parentOrganization {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:postIn owl:equivalentProperty org:postIn {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:fillsPost skos:closeMatch org:holds {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "fillsPost links Membership→Post; org:holds links Agent→Post (different domain, close not equivalent)"
|} .

gmeow:hasSite skos:closeMatch org:hasSite {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "gmeow:hasSite has range gmeow:Location, while org:hasSite has range org:Site; no alignment of gmeow:Location to org:Site exists, so owl:equivalentProperty is too strong."
|} .

gmeow:predecessorOrganization skos:closeMatch org:originalOrganization {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "predecessorOrganization on Event ≈ originalOrganization on ChangeEvent"
|} .

gmeow:successorOrganization skos:closeMatch org:resultingOrganization {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "successorOrganization on Event ≈ resultingOrganization on ChangeEvent"
|} .

gmeow:organizationPurpose owl:equivalentProperty org:purpose {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:industryClassification skos:closeMatch org:classification {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "industryClassification carries open codes (NAICS/ISIC); org:classification is broader"
|} .

gmeow:membershipOrganization owl:equivalentProperty org:organization {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "the membership relator's organization leg"
|} .

gmeow:hasRole skos:exactMatch org:role {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the membership relator's role leg; gmeow's hasRole is broader (any role-bearing relator) — exactMatch on the shared membership use"
|} .

gmeow:identifierScheme skos:closeMatch schema:propertyID {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the identifier's scheme code IS schema:PropertyValue's propertyID"
|} .

