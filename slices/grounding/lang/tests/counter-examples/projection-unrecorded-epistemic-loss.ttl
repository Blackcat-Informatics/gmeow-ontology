# Counter-example: a lossy, form-view lang:ProjectionEmission (Lemon-family) over a
# lang:Lexeme that carries a gmeow:vantage (an epistemic stratum) but whose sole
# lang:unsupportedConstruct names an UNRELATED construct ("inflection-tables") — it
# flattens the epistemic layer yet enumerates none of it (fires
# lang:UnrecordedEpistemicLoss; the declared unsupported construct keeps
# lang:UndeclaredUnsupportedConstruct from also firing).

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

ex:lexemeSrc a lang:Lexeme ;
    gmeow:vantage ex:annotatorVantage .

ex:emEpistemic a lang:ProjectionEmission ;
    lang:projectionTargetName "OntoLex-Lemon" ;
    lang:projectsSource ex:lexemeSrc ;
    logic:preservationKind logic:SoundUnderApproximation ;
    lang:unsupportedConstruct "inflection-tables" .
