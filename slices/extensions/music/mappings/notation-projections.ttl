    gmeow:alignSubject gmeow:notationMIDI ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q80284 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "Wikidata 'MIDI' (Q80284)." ;
    gmeow:sssomFile "gmeow-music.sssom.tsv" .

