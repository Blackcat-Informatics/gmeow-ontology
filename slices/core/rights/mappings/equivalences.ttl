@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dc:      <http://purl.org/dc/elements/1.1/> .
@prefix schema:  <https://schema.org/> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix premis:  <http://www.loc.gov/premis/rdf/v3/> .
@prefix spdx:    <http://spdx.org/rdf/terms#> .
@prefix ma:      <http://www.w3.org/ns/ma-ont#> .

# Term equivalences for the rights / IP / trademark / licensing facility (rights facility) —
# GMEOW authoring source. Compiled to mappings/gmeow-rights.sssom.tsv by
# `gmeow compile-mappings`. All alignments are BY REFERENCE (Principle 5); GMEOW
# never imports an external axiom. This linkage layer ALSO declares every odrl:/cc:
# term the structural ODRL / CC REL projections emit (queries/projections/odrl.rq,
# cc.rq) — the structural templateAtoms cells carry no EDOAL cell of their own, so
# the no-drift gate confirms each emitted target term is aligned here.
# See docs/rights.md and docs/rights-mapping.md.

gmeow:mapsetRights a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/rights" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Rights / IP / trademark / licensing alignments (rights facility).
        MACHINE-READABLE RIGHTS: gmeow:RightsStatement is the canonical superset of an ODRL Policy / Set (W3C ODRL 2.2); gmeow:Permission / gmeow:Prohibition / gmeow:Duty are the odrl:Permission / odrl:Prohibition / odrl:Duty rule trio, and gmeow:ruleAction values (reproduce / distribute / derive / commercialize / attribute / share-alike / …) are the odrl:action vocabulary, exactMatch the CC REL permission/requirement/prohibition classes (cc:Reproduction, cc:DerivativeWorks, cc:Attribution, cc:ShareAlike, cc:CommercialUse). The full ODRL policy and CC REL licence are GENERATED projections (queries/projections/odrl.rq, cc.rq).
        LICENCE-IS-AGREEMENT: gmeow:License (⊑ gmeow:Agreement) closeMatch cc:License / odrl:Offer / dcterms:LicenseDocument; gmeow:hasLicense exactMatch dcterms:license, closeMatch schema:license / cc:license.
        ATTRIBUTION REUSE: gmeow:copyrightHolder / gmeow:trademarkHolder (⊑ gmeow:wasAttributedTo) exactMatch dcterms:rightsHolder, closeMatch schema:copyrightHolder; gmeow:attributionText closeMatch schema:creditText / cc:attributionName.
        COPYRIGHT STATUS: gmeow:CopyrightStatus values closeMatch the RightsStatements.org standardized statements (InC / NKC / CNE) and the CC public-domain mark; the facility relates to PREMIS 3 rights (premis:RightsStatement).
        DISTINCT FROM the ontology-alignment LinkPolicy (src/gmeow_tools/config.py): that governs whether an external vocabulary's AXIOMS may be copied INTO GMEOW; this facility governs the rights of the INSTANCES GMEOW describes. The gmeow:LicenseFamily value vocabulary is the ontology-side reflection of that classification, not a copy of it.""" ;
    gmeow:setTrailer "# REFUSED: no preferred / primary right (Principle 9) — coexisting rights statements are co-equal; GMEOW has no winner-selecting rights projection.\n# WIPO trademark concepts are linked via Wikidata (gmeow-wikidata.sssom.tsv: wd:Q167270 trademark, wd:P1716 brand) rather than a fabricated wipo: namespace IRI." .

# --- ODRL: the deontic policy model (every odrl: term the projection emits) --- #

gmeow:eqRights001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:RightsStatement ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:Policy ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ; gmeow:comment "a machine-readable rights statement is an ODRL Policy" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:RightsStatement ; gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject odrl:Set ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ; gmeow:comment "projected as an odrl:Set (the concrete, rule-bearing policy subclass)" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasRightsStatement ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:hasPolicy ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ; gmeow:comment "attaching a policy to an asset" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:statementAbout ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:target ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ; gmeow:comment "the asset a policy / rule governs" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ruleTarget ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:target ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ; gmeow:comment "the asset a single rule regulates" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasPermission ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:permission ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ; gmeow:comment "a policy's permission rule" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasProhibition ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:prohibition ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ; gmeow:comment "a policy's prohibition rule" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights008 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasDuty ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:obligation ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ; gmeow:comment "a policy-level duty / obligation" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights009 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasDuty ; gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject odrl:duty ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ; gmeow:comment "the permission-scoped duty form of an obligation" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights010 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Rule ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:Rule ; gmeow:justification semapv:ManualMappingCuration ;
