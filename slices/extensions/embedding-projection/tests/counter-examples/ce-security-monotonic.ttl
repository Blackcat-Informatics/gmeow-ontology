#
# CT7 counter-example (Don't): a projection whose disclosure sensitivity is BELOW its
# source's (source gmeow:sensitivityConfidential rank 2; projection
# gmeow:sensitivityPublic rank 0) with NO gmeow:DeclassificationAct authorizing the
# drop. Sensitivity silently degraded (P15 violation). Triggers security-monotonic.rq
# (→ ce:leakyProj).
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ce:    <https://blackcatinformatics.ca/gmeow/counter-examples/embedding-projection/> .

ce:secretPack a gmeow:InformationObject ;
    gmeow:contentDigest  "blake3:sec0000011112222333344445555666677778888999900001111222233334444" ;
    gmeow:hasSensitivity gmeow:sensitivityConfidential .

ce:leakyProj a gmeow:EmbeddingProjection ;
    gmeow:projectionSource       ce:secretPack ;
    gmeow:hasVectorSpaceContract ce:leakyVsc ;
    gmeow:hasSensitivity         gmeow:sensitivityPublic .
