gmeow:TraceMarkClass
    a logic:Class , logic:AbstractIndividualType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Trace mark class"@x-gmeow-english ;
    skos:definition "An open quality-value vocabulary for a curator’s trace-retention classification of an Annotation."@x-gmeow-english ;
    skos:scopeNote "Members are classification values, not EventTypes, event occurrences, confidence levels or a closed taxonomy. A classification belongs to the annotation and does not assert the target’s content or a globally preferred importance rank."@x-gmeow-english ;
    skos:example "A curator supplies a trace-retention category on an actual annotation while retaining its source target, motivation and attribution."@x-gmeow-english ;
    gmeow:useWhen "Use to type actual curator-supplied categories for trace-retention annotations."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid turning local category names into a universal enumeration, EventType subclasses, confidence or proof that an event occurred or traces were retained."@x-gmeow-english ;
    gmeow:howToUse "Type an actual classification value as TraceMarkClass and attach it through traceMarkClass to the actual Annotation. Preserve its target, motivation, curator attribution and source-specific meaning; mint additional values without imposing a preferred category."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:traceMarkClass
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "trace mark class"@x-gmeow-english ;
    skos:definition "The curator-supplied trace-retention classification of this Annotation."@x-gmeow-english ;
    skos:scopeNote "This optional, nonfunctional role permits coexisting attributed classifications. It does not require a category on every Annotation, identify the target with an Event or replace the existing target and motivation obligations."@x-gmeow-english ;
    skos:example "An actual source annotation retains the curator’s supplied category without inventing a missing annotation target or motivation."@x-gmeow-english ;
    gmeow:useWhen "Use when a curator explicitly classifies an actual annotation for trace retention."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring a category, event occurrence, successful trace join, finality, retention or permission to delete from an annotation or its absence."@x-gmeow-english ;
    gmeow:howToUse "Link only the actual supplied TraceMarkClass value and preserve the Annotation’s actual target, motivation, curator and standpoint. Do not select a default motivation, manufacture a body or use an Observation vantage to type the annotation."@x-gmeow-english ;
    logic:domain gmeow:Annotation ;
    logic:range gmeow:TraceMarkClass .

gmeow:traceMarkHighFrictionCorrection
    a gmeow:TraceMarkClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "high-friction correction trace class"@x-gmeow-english ;
    skos:definition "A curator’s trace-retention classification of a teller’s reading that one act, using the same tool and arguments, was tried again in an episode after an earlier attempt did not succeed."@x-gmeow-english ;
    skos:scopeNote "This value classifies the teller’s reading. It does not assert the underlying event, tool or argument equality, retry execution, truth, curator endorsement, an EventType or a confidence value."@x-gmeow-english ;
    skos:example "A curator classifies an annotation of a teller’s reported retry reading while leaving its actual attempt identities, evidence and interpretation on the source reading."@x-gmeow-english ;
    gmeow:useWhen "Use only when the curator actually supplies this trace-retention classification for the teller’s reading of an earlier unsuccessful attempt and a later retry of the same tool and arguments in an episode."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving the classification from repeated labels, matching argument spellings, missing success evidence or a bare failed event, or treating it as proof that the reading or correction occurred."@x-gmeow-english ;
    gmeow:howToUse "Reference this actual TraceMarkClass value through traceMarkClass on the source-backed Annotation. Retain the actual target, motivation, curator and teller attribution; keep the reading’s attempt, episode, tool, argument and outcome evidence without asserting it from the category alone."@x-gmeow-english .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/traceMarkClass" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:TraceMark
    a logic:Class , logic:SubKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Trace mark"@x-gmeow-english ;
    skos:definition "A curator's Annotation of an actual event record for trace retention, carrying classifications, source event placement and explicit packet-anchor evidence without trace content."@x-gmeow-english ;
    skos:scopeNote "The sole target is annotationTarget, an actual InformationObject record rather than an Event occurrence. Actual motivation, curator, event placement and complete TemporalFrame are required; supplied classifications coexist."@x-gmeow-english ;
    skos:example "A curator marks the supplied event record and retains its actual motivation, time interpretation and packet anchors separately from the recorder's trace bytes."@x-gmeow-english ;
    gmeow:useWhen "Use for an actual source-backed curator mark whose event record and required annotation context are supplied."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a target, motivation, curator, clock, classification, packet identity or finality commitment to complete a mark."@x-gmeow-english ;
    gmeow:howToUse "Retain the actual record through annotationTarget, supplied traceMarkClass values, curator attribution and source event placement in its actual frame. Supply anchors or explicit without-packet evidence; keep statement provenance separate."@x-gmeow-english ;
    logic:subClassOf gmeow:Annotation .

gmeow:TraceAnchor
    a logic:Class , logic:SubKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Trace anchor"@x-gmeow-english ;
    skos:definition "An InformationObject descriptor retaining one original source-packet digest and its actual source-profile interpretation for a trace recorder's join."@x-gmeow-english ;
    skos:scopeNote "Exactly one original xsd:hexBinary anchorPacket and actual anchorSourceProfile are required. Optional episode and round fields retain original scalar RDF terms without resolving them into Activity occurrences."@x-gmeow-english ;
    skos:example "A source-backed anchor retains its packet digest unchanged and names the actual declaration of digest construction and packet byte representation."@x-gmeow-english ;
    gmeow:useWhen "Use when the source supplies a packet digest and complete applicable interpretation for the selected anchor."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an algorithm from digest width, manufacturing a packet artifact, or treating a descriptor as a successful trace join or finality proof."@x-gmeow-english ;
    gmeow:howToUse "Keep the complete digest literal and actual profile on this anchor. Preserve any supplied episode or round term in its own scalar StructuredValue occurrence; inherit the existing scalar integrity laws."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:traceMarkAt
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "trace mark event placement"@x-gmeow-english ;
    skos:definition "The source-supplied temporal placement of the event described by this TraceMark's actual annotationTarget record."@x-gmeow-english ;
    skos:scopeNote "Exactly one original dateTime, date, gYearMonth or gYear literal per coherent mark, interpreted in its actual complete TemporalFrame. This is not mark creation or record transaction time."@x-gmeow-english ;
    skos:example "A mark retains the source's supplied date without inventing midnight, a timezone or a more precise event instant."@x-gmeow-english ;
    gmeow:useWhen "Use for the supplied placement of the described event at its actual source precision."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting recordedAt, marking time, Events' UTC default or a computed calendar conversion."@x-gmeow-english ;
    gmeow:howToUse "Preserve the source datatype, lexical form and timezone information; bind hasReferenceFrame to the actual complete TemporalFrame without reinterpreting the XSD datatype's calendar."@x-gmeow-english ;
    logic:domain gmeow:TraceMark ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/traceMarkAt" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:traceMarkAnchor
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "trace mark anchor"@x-gmeow-english ;
    skos:definition "An actual source-backed TraceAnchor supplied for this curator's TraceMark."@x-gmeow-english ;
    skos:scopeNote "Several anchors may coexist. Any anchor excludes an affirmative traceMarkWithoutPacket value; absence of anchors requires explicit affirmative without-packet evidence."@x-gmeow-english ;
    skos:example "One event-record mark retains the several actual packet anchors supplied for it."@x-gmeow-english ;
    gmeow:useWhen "Use only for an actual supplied anchor with its own packet digest and source interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid choosing one preferred packet, fabricating a missing anchor or deriving trace retention, finality or deletion permission from this link."@x-gmeow-english ;
    gmeow:howToUse "Link every actual TraceAnchor supplied for the mark, retaining each anchor's own required profile and optional source terms."@x-gmeow-english ;
    logic:domain gmeow:TraceMark ;
    logic:range gmeow:TraceAnchor .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/traceMarkAnchor" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:traceMarkWithoutPacket
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "trace mark without packet"@x-gmeow-english ;
    skos:definition "The supplied Boolean declaration of whether this TraceMark is held without a packet identity."@x-gmeow-english ;
    skos:scopeNote "Optional, at most one original xsd:boolean literal. True requires no anchors; false requires an actual anchor. Each lexical alias is admitted individually unchanged, without claiming simultaneous alias coexistence."@x-gmeow-english ;
    skos:example "An actual affirmative source flag records a mark held without packet identity; an omitted flag does not create that status."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly supplies this Boolean status for the mark."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid defaulting absence to false or true, treating false alone as an anchor, or confusing without-packet status with lost-mark give-up or finality."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original Boolean lexical form and datatype. Apply Boolean value comparison: individual true/1 and false/0 aliases retain their source identity and the same status meaning."@x-gmeow-english ;
    logic:domain gmeow:TraceMark ;
    logic:range xsd:boolean .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/traceMarkWithoutPacket" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:anchorPacket
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "anchor packet digest"@x-gmeow-english ;
    skos:definition "The original xsd:hexBinary digest supplied for the exact source-packet byte representation identified by this TraceAnchor's actual source profile."@x-gmeow-english ;
    skos:scopeNote "Exactly one original literal per coherent anchor. Its datatype supplies no digest algorithm, construction, preimage encoding, packet resource identity or verification receipt."@x-gmeow-english ;
    skos:example "An anchor keeps the supplied hexBinary literal intact beside the actual declaration explaining which packet bytes and digest construction it denotes."@x-gmeow-english ;
    gmeow:useWhen "Use when the original digest and full applicable source interpretation are both supplied."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an algorithm from width, retyping to an algorithm digest datatype, normalizing spelling or using the anchor descriptor's own contentDigest."@x-gmeow-english ;
    gmeow:howToUse "Retain the complete source literal unchanged and identify its actual construction and exact byte preimage through anchorSourceProfile. Do not compute or claim a verified trace join from these fields."@x-gmeow-english ;
    logic:domain gmeow:TraceAnchor ;
    logic:range xsd:hexBinary .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/anchorPacket" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:anchorSourceProfile
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "anchor source profile"@x-gmeow-english ;
    skos:definition "The actual InformationObject declaration providing this TraceAnchor's complete source-specific digest, packet-byte and selected episode/round interpretation."@x-gmeow-english ;
    skos:scopeNote "Exactly one actual applicable profile per coherent anchor. It identifies algorithm/construction, exact byte-preimage representation and selected field meanings; a name or typed link alone does not establish its content."@x-gmeow-english ;
    skos:example "The anchor names the actual source declaration explaining digest construction, packet encoding and any retained identifier or ordinal convention."@x-gmeow-english ;
    gmeow:useWhen "Use only for the full actual source declaration applicable to this anchor."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating a profile, borrowing a sibling anchor's interpretation, inferring defaults or treating a typed profile link as source authentication or execution."@x-gmeow-english ;
    gmeow:howToUse "Retain the actual supplied profile identity and evidence for its full applicable meaning. A selecting importer fails on missing or invalid interpretation; preserve raw incomplete evidence outside the normalized anchor role."@x-gmeow-english ;
    logic:domain gmeow:TraceAnchor ;
    logic:range gmeow:InformationObject .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/anchorSourceProfile" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:anchorEpisode
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "anchor episode evidence"@x-gmeow-english ;
    skos:definition "A scalar StructuredValue occurrence retaining the original source episode identifier term supplied for this TraceAnchor."@x-gmeow-english ;
    skos:scopeNote "Optional, at most one occurrence per coherent anchor. Its structuredTerm preserves the exact RDF term under the anchor's actual source profile, without inferring an Activity occurrence."@x-gmeow-english ;
    skos:example "An unresolved source episode IRI remains an IRI in structuredTerm rather than an invented episode event or string."@x-gmeow-english ;
    gmeow:useWhen "Use when the source supplies an episode identifier term with its actual profile interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid guessing episode identity, stringifying resources, inventing a missing field or admitting null/map/sequence as a scalar identifier."@x-gmeow-english ;
    gmeow:howToUse "Link the scalar occurrence with its original structuredTerm; inherit existing whole-term uniqueness and branch exclusivity. Keep any separately supplied resolved episode evidence distinct."@x-gmeow-english ;
    logic:domain gmeow:TraceAnchor ;
    logic:range gmeow:StructuredValue .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/anchorEpisode" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:anchorRound
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "anchor round evidence"@x-gmeow-english ;
    skos:definition "A scalar StructuredValue occurrence retaining the original source round identifier or ordinal term supplied for this TraceAnchor."@x-gmeow-english ;
    skos:scopeNote "Optional, at most one occurrence per coherent anchor. The actual source profile interprets its exact structuredTerm; no numeric datatype, ordinal base, chronology or Activity endpoint is guessed."@x-gmeow-english ;
    skos:example "A supplied round ordinal keeps its original typed literal while its source profile retains the actual numbering convention."@x-gmeow-english ;
    gmeow:useWhen "Use when an actual source round term and its applicable interpretation are supplied."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid converting an identifier to an integer, guessing zero-based or one-based numbering, inferring order or treating an omitted round as zero."@x-gmeow-english ;
    gmeow:howToUse "Retain the original RDF term in the linked scalar occurrence under the actual profile. Require its structuredTerm witness and reuse existing scalar integrity without retyping or numeric coercion."@x-gmeow-english ;
    logic:domain gmeow:TraceAnchor ;
    logic:range gmeow:StructuredValue .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/anchorRound" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:TraceMark logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:annotationTarget ; logic:allValuesFrom gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:traceMarkClass ; logic:allValuesFrom gmeow:TraceMarkClass ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:traceMarkAt ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:traceMarkAt ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:hasReferenceFrame ; logic:allValuesFrom gmeow:TemporalFrame ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:hasReferenceFrame ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:traceMarkAnchor ; logic:allValuesFrom gmeow:TraceAnchor ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:traceMarkWithoutPacket ; logic:allValuesFrom xsd:boolean ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:traceMarkWithoutPacket ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:wasAttributedTo ; logic:allValuesFrom gmeow:Agent ] .

[ a logic:ClosureEntry ; logic:onClass gmeow:TraceMark ; logic:closureKey "https://blackcatinformatics.ca/gmeow/annotationTarget" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:TraceMark ; logic:closureKey "https://blackcatinformatics.ca/gmeow/traceMarkClass" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:TraceMark ; logic:closureKey "https://blackcatinformatics.ca/gmeow/traceMarkAt" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:TraceMark ; logic:closureKey "https://blackcatinformatics.ca/gmeow/hasReferenceFrame" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:TraceMark ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasAttributedTo" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:TraceAnchor logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:anchorPacket ; logic:allValuesFrom xsd:hexBinary ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:anchorPacket ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:anchorSourceProfile ; logic:allValuesFrom gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:anchorSourceProfile ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:anchorEpisode ; logic:allValuesFrom gmeow:StructuredValue ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:anchorEpisode ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:anchorRound ; logic:allValuesFrom gmeow:StructuredValue ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:anchorRound ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .

[ a logic:ClosureEntry ; logic:onClass gmeow:TraceAnchor ; logic:closureKey "https://blackcatinformatics.ca/gmeow/anchorPacket" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:TraceAnchor ; logic:closureKey "https://blackcatinformatics.ca/gmeow/anchorSourceProfile" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:TraceMarkPacketPresenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Trace mark packet evidence presence"@x-gmeow-english ;
    skos:definition "Every TraceMark has an actual traceMarkAnchor or an explicitly supplied traceMarkWithoutPacket flag; neither may be silently omitted together."@x-gmeow-english ;
    skos:scopeNote "The two existence probes are atomic. A false flag still requires an anchor under its separate obligation, and an affirmative flag excludes anchors under the exclusivity law."@x-gmeow-english ;
    skos:example "A mark with neither anchor nor explicit flag fails instead of acquiring an invented without-packet status."@x-gmeow-english ;
    gmeow:useWhen "Use to check explicit packet evidence on actual TraceMark records."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating flag presence as an affirmative Boolean value, trace availability or completed recorder work."@x-gmeow-english ;
    gmeow:howToUse "Guard the actual TraceMark and require the disjunction of atomic anchor and flag witnesses, with separate Boolean-value laws and no default."@x-gmeow-english ;
    logic:formalizes gmeow:TraceMark ;
    logic:message "Every TraceMark has an actual traceMarkAnchor or an explicitly supplied traceMarkWithoutPacket flag; neither may be silently omitted together."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceMark" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceMark" ] , [ logic:termIndex 1 ; logic:termIri gmeow:TraceMark ] ] ;
            logic:consequent [ a logic:Formula ; logic:or [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceAnchor" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:traceMarkAnchor ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceMark" ] , [ logic:termIndex 1 ; logic:termVariable "presenceAnchor" ] ] ] ,
        [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceFlag" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:traceMarkWithoutPacket ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceMark" ] , [ logic:termIndex 1 ; logic:termVariable "presenceFlag" ] ] ] ] ] ] .

gmeow:TraceMarkPacketFalseConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Trace mark false flag anchor obligation"@x-gmeow-english ;
    skos:definition "A TraceMark with a supplied traceMarkWithoutPacket value equal to Boolean false has an actual traceMarkAnchor."@x-gmeow-english ;
    skos:scopeNote "Boolean value comparison admits each original false/0 alias unchanged. The required anchor witness is atomic; a false flag alone is incomplete evidence."@x-gmeow-english ;
    skos:example "A supplied false flag without an anchor fails; its lexical form is not rewritten to repair the mark."@x-gmeow-english ;
    gmeow:useWhen "Use to check the actual anchor required by a source-supplied false without-packet flag."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid matching only the spelling false, inventing an anchor or interpreting an absent flag as false."@x-gmeow-english ;
    gmeow:howToUse "Positively bind the actual mark and flag, compare through termEqual to a typed Boolean false, and require one atomic anchor existence probe."@x-gmeow-english ;
    logic:formalizes gmeow:traceMarkWithoutPacket ;
    logic:message "A TraceMark with a supplied traceMarkWithoutPacket value equal to Boolean false has an actual traceMarkAnchor."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "falseMark" ] , [ logic:termIndex 1 ; logic:termVariable "falseFlag" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "falseMark" ] , [ logic:termIndex 1 ; logic:termIri gmeow:TraceMark ] ] ,
        [ a logic:Formula ; logic:relation gmeow:traceMarkWithoutPacket ; logic:argument [ logic:termIndex 0 ; logic:termVariable "falseMark" ] , [ logic:termIndex 1 ; logic:termVariable "falseFlag" ] ] ,
        [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "falseFlag" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "falseAnchor" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:traceMarkAnchor ; logic:argument [ logic:termIndex 0 ; logic:termVariable "falseMark" ] , [ logic:termIndex 1 ; logic:termVariable "falseAnchor" ] ] ] ] ] .

gmeow:TraceMarkPacketExclusivityConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Trace mark affirmative flag exclusivity"@x-gmeow-english ;
    skos:definition "A TraceMark with a supplied traceMarkWithoutPacket value equal to Boolean true has no traceMarkAnchor."@x-gmeow-english ;
    skos:scopeNote "Boolean value comparison admits each original true/1 alias unchanged. This is explicit without-packet status, not a statement that no packet ever existed or a lost-mark give-up."@x-gmeow-english ;
    skos:example "A mark carrying both an affirmative flag and an actual anchor fails instead of silently selecting one interpretation."@x-gmeow-english ;
    gmeow:useWhen "Use to check the exclusion of anchors by an actual affirmative without-packet flag."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid matching only the spelling true, deleting contradictory evidence or deriving finality, frontier advancement or deletion permission."@x-gmeow-english ;
    gmeow:howToUse "Positively bind the mark and supplied flag, compare Boolean value through termEqual, and forbid atomic anchor existence without rewriting source data."@x-gmeow-english ;
    logic:formalizes gmeow:traceMarkWithoutPacket ;
    logic:message "A TraceMark with a supplied traceMarkWithoutPacket value equal to Boolean true has no traceMarkAnchor."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "affirmativeMark" ] , [ logic:termIndex 1 ; logic:termVariable "affirmativeFlag" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "affirmativeMark" ] , [ logic:termIndex 1 ; logic:termIri gmeow:TraceMark ] ] ,
        [ a logic:Formula ; logic:relation gmeow:traceMarkWithoutPacket ; logic:argument [ logic:termIndex 0 ; logic:termVariable "affirmativeMark" ] , [ logic:termIndex 1 ; logic:termVariable "affirmativeFlag" ] ] ,
        [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "affirmativeFlag" ] , [ logic:termIndex 1 ; logic:termLiteral "true" ; logic:termLiteralDatatype xsd:boolean ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "affirmativeAnchor" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:traceMarkAnchor ; logic:argument [ logic:termIndex 0 ; logic:termVariable "affirmativeMark" ] , [ logic:termIndex 1 ; logic:termVariable "affirmativeAnchor" ] ] ] ] ] ] .

gmeow:TraceAnchorScalarConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Trace anchor scalar evidence"@x-gmeow-english ;
    skos:definition "Every supplied anchorEpisode or anchorRound occurrence of a TraceAnchor has an original structuredTerm witness, inheriting existing scalar uniqueness and branch exclusivity."@x-gmeow-english ;
    skos:scopeNote "Both optional roles use independent positive guards and atomic term witnesses. No field is required when absent, and no map, sequence or null becomes a scalar identifier."@x-gmeow-english ;
    skos:example "A supplied occurrence with an original IRI term passes the presence obligation; an empty occurrence does not become a default episode or round."@x-gmeow-english ;
    gmeow:useWhen "Use to validate the actual scalar carriers selected for optional anchor episode and round evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid duplicating structuredTerm identity laws, stringifying original resources or treating a scalar witness as source authentication or resolved Activity identity."@x-gmeow-english ;
    gmeow:howToUse "For each actual optional role link, require an atomic structuredTerm witness with fresh local variables. Leave whole-term uniqueness and payload branch exclusivity to their existing owner."@x-gmeow-english ;
    logic:formalizes gmeow:anchorEpisode , gmeow:anchorRound ;
    logic:message "Every supplied anchorEpisode or anchorRound occurrence of a TraceAnchor has an original structuredTerm witness, inheriting existing scalar uniqueness and branch exclusivity."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "scalarAnchor" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "scalarAnchor" ] , [ logic:termIndex 1 ; logic:termIri gmeow:TraceAnchor ] ] ;
