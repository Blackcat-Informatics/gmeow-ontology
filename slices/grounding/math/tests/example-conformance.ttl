#
# Declarative example-conformance fixtures for the mathematics slice — the test-DSL
# twin of the SHACL shapes in slices/grounding/math/shapes.ttl ("this instance
# must validate, that counter-example must be rejected"). The harness
# (crates/slicetest run_conformance_cell) validates mathematics/module.ttl + the one
# bound gmeow:exampleFile against mathematics/shapes.ttl and compares finding codes.
#
# Each counter-example isolates ONE violation, so the (fixture, code) pair pins the
# specific constraint. The conforming fixtures live under tests/conformance-fixtures/
# and the counter-examples under tests/counter-examples/, so the global
# `make validate` gate never loads the intentional violations as data.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/math/tests/> .

# === Rule 1: a number declares its number system ============================ #

ex:ecNumberSituated a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/number-situated.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:RationalNumber situated in math:rationalNumbers with math:isExact true satisfies math:NumberSituatedShape and validates with no findings." .

ex:ecNumberMissingSystem a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/number-missing-system.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example omits math:inNumberSystem (sh:minCount 1 on math:NumberSituatedShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:UnsituatedNumber)." .

