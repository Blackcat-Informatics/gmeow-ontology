<https://blackcatinformatics.ca/gmeow/slices/sensory>
    a gmeow:Slice ;
    rdfs:label "sensory"@x-gmeow-english ;
    skos:definition "The sensory slice of the GMEOW ontology (extension tier): GMEOW Sensory Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> ;
    dcterms:title "GMEOW Sensory Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierExtension ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/math> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/places> ;
    gmeow:sliceConsumer "Sensory perception observations (the unified stance applied to senses)."@x-gmeow-english .
