# --- GMN alias dictionary (version 3) ----------------------------------------- #
# Version 2 remains immutable history. Version 3 duplicates every retained
# binding onto version-owned entry resources and adds the six mathematics keys
# admitted by the external-concept symbology audit. The current codebook points
# only at this table, so a reader never guesses across versions.

gmeow:gmnDictV3
    a owl:NamedIndividual , gmeow:GmnDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN dictionary (version 3)"@x-gmeow-english ;
    skos:definition "Dictionary version 3 of the GMN alias table: an immutable successor to version 2 that retains all 24 prior bindings on version-owned entries and adds `boundary`, `coboundary`, `ds`, `lcon`, `rev`, and `hlap` for the audited mathematics named keys."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:gmnDictionaryVersion "3" ;
    gmeow:gmnDictionaryEntry
        gmeow:gmnDictV3EntryEnvelope ,
        gmeow:gmnDictV3EntryCodebook ,
        gmeow:gmnDictV3EntryDenotation ,
        gmeow:gmnDictV3EntryTranslation ,
        gmeow:gmnDictV3EntryMorphemeBoundary ,
        gmeow:gmnDictV3EntryMathDivision ,
        gmeow:gmnDictV3EntryLogicForall ,
        gmeow:gmnDictV3EntryLogicExists ,
        gmeow:gmnDictV3EntryLogicAnd ,
        gmeow:gmnDictV3EntryLogicOr ,
        gmeow:gmnDictV3EntryLogicIff ,
        gmeow:gmnDictV3EntryModalNecessary ,
        gmeow:gmnDictV3EntryModalActual ,
        gmeow:gmnDictV3EntryModalPossible ,
        gmeow:gmnDictV3EntryModalCounterfactual ,
        gmeow:gmnDictV3EntryEvKindDirect ,
        gmeow:gmnDictV3EntryEvKindInstrumental ,
        gmeow:gmnDictV3EntryEvKindRemote ,
        gmeow:gmnDictV3EntryEvKindComputational ,
        gmeow:gmnDictV3EntryEvKindExpert ,
        gmeow:gmnDictV3EntryEvKindSurvey ,
        gmeow:gmnDictV3EntryEvKindStreaming ,
        gmeow:gmnDictV3EntryBoundaryOpen ,
        gmeow:gmnDictV3EntryBoundaryClosed ,
        gmeow:gmnDictV3EntryMathBoundaryOperator ,
        gmeow:gmnDictV3EntryMathCoboundaryOperator ,
        gmeow:gmnDictV3EntryMathDirectSum ,
        gmeow:gmnDictV3EntryMathLeftContraction ,
        gmeow:gmnDictV3EntryMathReversion ,
        gmeow:gmnDictV3EntryMathHodgeLaplacian .

gmeow:gmnDictV3EntryEnvelope
    a owl:NamedIndividual , gmeow:GmnDictionaryEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "dict-v3 entry: gmeow:GmnEnvelope to genv"@x-gmeow-english ;
    skos:definition "The version-3 alias binding for gmeow:GmnEnvelope: `genv`, retained unchanged from version 2."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:gmnDictionaryEntryTerm gmeow:GmnEnvelope ;
    gmeow:gmnDictionaryEntryAlias "genv" .

gmeow:gmnDictV3EntryCodebook
    a owl:NamedIndividual , gmeow:GmnDictionaryEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "dict-v3 entry: gmeow:GmnCodebook to gcb"@x-gmeow-english ;
