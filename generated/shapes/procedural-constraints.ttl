        sh:select """SELECT $this WHERE { ?sc <https://blackcatinformatics.ca/gmeow/profileSurfaceOf> $this . ?sc <https://blackcatinformatics.ca/gmeow/profileSurfaceKind> <https://blackcatinformatics.ca/gmeow/surfaceContainer> . ?sm <https://blackcatinformatics.ca/gmeow/profileSurfaceOf> $this . ?sm <https://blackcatinformatics.ca/gmeow/profileSurfaceKind> <https://blackcatinformatics.ca/gmeow/surfaceManifest> . ?sc <https://blackcatinformatics.ca/gmeow/recordsTargetTableDigest> ?x . ?sm <https://blackcatinformatics.ca/gmeow/recordsTargetTableDigest> ?y . FILTER ( ?x != ?y ) }""" ;
