@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/quality>
    a gmeow:Slice ;
    rdfs:label "quality"@x-gmeow-english ;
    dcterms:title "GMEOW Data Quality Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/core> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ;
    gmeow:sliceConsumer "Data-quality claims (DQV/ISO 19157) over any slice's instance data; the coverage gates."@x-gmeow-english .
