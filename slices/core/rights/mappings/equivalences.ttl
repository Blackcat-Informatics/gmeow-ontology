    gmeow:alignObject odrl:action ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ; gmeow:comment "the regulated action of a rule" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights015 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ruleAssignee ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:assignee ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ; gmeow:comment "the party a rule applies to" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights016 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:License ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:Offer ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ; gmeow:comment "a licence offered to recipients is an ODRL Offer" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights017 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:licensor ; gmeow:alignPredicate skos:closeMatch ;
