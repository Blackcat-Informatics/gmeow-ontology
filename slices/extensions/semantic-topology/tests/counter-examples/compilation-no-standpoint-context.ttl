#
# Counter-example for gmeow:CompilationContextConstraint (gmeow:CompilationMissingContext):
# a gmeow:ComplexCompilation that records BOTH its correspondence and its
# preservation/loss judgment and carries its possible-world and time-scope context, but
# omits its gmeow:compilationStandpoint. The ∀→(∃∧∃∧∃) SPARQL constraint MUST reject it
# with shacl.SPARQLConstraintComponent, and nothing else — every other required datum is
# present, so the missing standpoint is the sole violation.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/semantic-topology/tests/> .

ex:compilationBad a gmeow:ComplexCompilation ;
    gmeow:recordsCorrespondence ex:corr ;
    gmeow:recordsPreservation ex:pres ;
    gmeow:compilationWorld ex:w ;
    gmeow:compilationTimeScope ex:t .             # <-- but NO gmeow:compilationStandpoint

ex:corr a gmeow:CellSourceCorrespondence .
ex:pres a gmeow:CompilationPreservationRecord ;
    logic:preservationKind logic:ExactPreservation .
ex:w a logic:PossibleWorld .
ex:t a gmeow:TimeScopedRelation .
