# Supplied-value constraints and local record contracts.
gmeow:RecallScope logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:scopeSlot ; logic:allValuesFrom gmeow:AttentionSlot ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RecallScope ; logic:closureKey "https://blackcatinformatics.ca/gmeow/scopeSlot" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:RecallOperation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:recallSchema ; logic:allValuesFrom logic:ActionSchema ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RecallOperation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/recallSchema" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:RecallOperation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:recallSchema ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:ActionSchema ] .
