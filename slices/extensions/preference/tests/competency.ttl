#
# Declarative competency questions for the preference extension slice, executed by the native
# Rust slice-test harness over the full merged ontology, asserted lane (gmeow:reasoningNone).
# Each question overlays a pass-witness scene (gmeow:cqDataFile, slice-relative) and pins its
# rows exactly (RowsExact). Together they are the executable half of the slice's contract:
# ties, positive incomparability, and a Condorcet cycle are all first-class and queryable; a
# global winner (and an argmax selected candidate) is legal ONLY through a discharged whole-base
# consensus (the governing rule); every projection is content-addressed and discloses its loss;
# the hard and soft axes are orthogonal; a model-config delta is fully provenanced; the optimizer
# view is a projection; promotion defers activation; candidates seam to the Cl(12) geometry; and
# the slice composes its seven named sibling slices strictly by reference (Principle 16).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/preference/tests/> .
@prefix exd:   <https://blackcatinformatics.ca/gmeow/examples/preference/> .

# --- CQ / cq-ties: a within-vantage comparable tie -------------------------- #
ex:cqTies a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-ties.rq" ;
    gmeow:cqDataFile "examples/tie-cell.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqTiesShape ;
    gmeow:cqRationale "GMEOW must answer 'which candidates are tied?' A tie is a positively-asserted comparable indifference (gmeow:preferentiallyEquivalentWith), not an absent edge and not an incomparability; the tie-cell scene ties A and B, and the asserted answer is exactly that one pair." ;
    gmeow:cqExpectRow ex:cqTiesRow .
ex:cqTiesShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "a" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "b" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqTiesRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "a" ; gmeow:cellValueIri exd:candA ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "b" ; gmeow:cellValueIri exd:candB ] .

# --- CQ / cq-incomparability: a positive Pareto void ------------------------ #
ex:cqIncomparability a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-incomparability.rq" ;
    gmeow:cqDataFile "examples/pareto-incomparable.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqIncomparabilityShape ;
    gmeow:cqRationale "GMEOW must answer 'which candidates are genuinely incomparable?' The pareto-incomparable scene records X and Y as a POSITIVE gmeow:incomparableWith pair (a queryable Pareto void), and the asserted answer is exactly that one pair." ;
    gmeow:cqExpectRow ex:cqIncomparabilityRow .
ex:cqIncomparabilityShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "a" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "b" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqIncomparabilityRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "a" ; gmeow:cellValueIri exd:candX ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "b" ; gmeow:cellValueIri exd:candY ] .

# --- CQ / cq-cycle: the cross-vantage Condorcet 3-cycle --------------------- #
ex:cqCycle a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-cycle.rq" ;
    gmeow:cqDataFile "examples/condorcet-cycle.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqCycleShape ;
    gmeow:cqRationale "GMEOW must answer 'what are the vantage-indexed judgments that form the cycle?' The condorcet-cycle scene has three reified observations — A≻B, B≻C, C≻A — each carrying its own vantage; the asserted answer is exactly those three gmeow:observationPrefers edges, proving the cycle lives in coexisting observations (the legal H1 obstruction)." ;
    gmeow:cqExpectRow ex:cqCycleRow1 , ex:cqCycleRow2 , ex:cqCycleRow3 .
ex:cqCycleShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "observation" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "winner" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqCycleRow1 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "observation" ; gmeow:cellValueIri exd:obsAB ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "winner" ; gmeow:cellValueIri exd:candA ] .
ex:cqCycleRow2 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "observation" ; gmeow:cellValueIri exd:obsBC ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "winner" ; gmeow:cellValueIri exd:candB ] .
ex:cqCycleRow3 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "observation" ; gmeow:cellValueIri exd:obsCA ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "winner" ; gmeow:cellValueIri exd:candC ] .

# --- CQ / cq-cross-cell-legal-no-reversal (G3 cell-scoping): a cross-cell reversal is legal - #
ex:cqCrossCellLegalNoReversal a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-cross-cell-legal-no-reversal.rq" ;
    gmeow:cqDataFile "tests/data/cross-cell-legal-conflict.ttl" ;
    gmeow:cqExpectRowCount 0 ;
    gmeow:cqRationale "GMEOW must answer 'is a cross-vantage reversal across two cells legal, or does it trip the within-cell strict-order gate?' (FLAG-1, Principle 9). This is gmeow:VantageScopedStrictOrderConstraint's (G3) exact bad-pattern — a reversed reified gmeow:PreferenceEdge pair joined to a single cell's order. Over the cross-cell-legal-conflict scene (cell 1 prefers A≻B, cell 2 prefers B≻A, each edge under its OWN order) it returns EXACTLY ZERO rows: the reversed edges live under different orders, so they never meet within one cell and G3 does not fire. The same pattern returns a row on the within-cell-order-cycle scene, so a zero count here is probative — the executable proof that G3 is genuinely cell-scoped and the cross-vantage conflict is the legal H1 obstruction." .

# --- CQ / cq-pareto-frontier: the frontier is both non-dominated candidates - #
ex:cqParetoFrontier a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-pareto-frontier.rq" ;
    gmeow:cqDataFile "examples/pareto-incomparable.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqParetoFrontierShape ;
    gmeow:cqRationale "GMEOW must answer 'what is the Pareto frontier over the criteria?' The pareto-incomparable scene has two criteria; X wins latency and Y wins accuracy, so the frontier is BOTH candidates — the asserted answer is exactly these two rows, a real frontier rather than a one-row vacuity." ;
    gmeow:cqExpectRow ex:cqParetoFrontierRow1 , ex:cqParetoFrontierRow2 .
ex:cqParetoFrontierShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "criterion" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "frontierMember" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqParetoFrontierRow1 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "criterion" ; gmeow:cellValueIri exd:c1Latency ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "frontierMember" ; gmeow:cellValueIri exd:candX ] .
ex:cqParetoFrontierRow2 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "criterion" ; gmeow:cellValueIri exd:c2Accuracy ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "frontierMember" ; gmeow:cellValueIri exd:candY ] .

# --- CQ / cq-multi-evaluator: three co-equal vantages ----------------------- #
ex:cqMultiEvaluator a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-multi-evaluator.rq" ;
    gmeow:cqDataFile "examples/multi-evaluator-no-winner.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqMultiEvaluatorShape ;
    gmeow:cqRationale "GMEOW must answer 'which co-equal evaluator vantages registered observations?' The multi-evaluator scene has three total-ordering evaluators; the asserted answer is exactly the three vantages, proving conflicting evaluators coexist as co-equal cells (Principle 9)." ;
    gmeow:cqExpectRow ex:cqMultiEvaluatorRow1 , ex:cqMultiEvaluatorRow2 , ex:cqMultiEvaluatorRow3 .
ex:cqMultiEvaluatorShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "vantage" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqMultiEvaluatorRow1 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vantage" ; gmeow:cellValueIri exd:e1 ] .
ex:cqMultiEvaluatorRow2 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vantage" ; gmeow:cellValueIri exd:e2 ] .
ex:cqMultiEvaluatorRow3 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vantage" ; gmeow:cellValueIri exd:e3 ] .

# --- CQ / cq-global-winner-requires-consensus (GOVERNING) ------------------- #
ex:cqGlobalWinnerRequiresConsensus a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-global-winner-requires-consensus.rq" ;
    gmeow:cqDataFile "examples/comparison-worked.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqGlobalWinnerRequiresConsensusShape ;
    gmeow:cqRationale "GMEOW must answer 'when is a global winner legal?' Only as a gmeow:PreferenceClaim that asserts one AND extends to a typed gmeow:ConsensusSection AND discharges a typed gmeow:DisagreementObstruction. The comparison-worked scene has exactly one such discharged claim (the asserted one row); an undischarged scene like condorcet-cycle returns zero, which is the governing point." ;
    gmeow:cqExpectRow ex:cqGlobalWinnerRequiresConsensusRow .
ex:cqGlobalWinnerRequiresConsensusShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "claim" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "section" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "obstruction" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqGlobalWinnerRequiresConsensusRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "claim" ; gmeow:cellValueIri exd:claim ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "section" ; gmeow:cellValueIri exd:consensus ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "obstruction" ; gmeow:cellValueIri exd:obstruction ] .

# --- CQ / cq-projection-winner-requires-consensus (F1) ---------------------- #
ex:cqProjectionWinnerRequiresConsensus a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-projection-winner-requires-consensus.rq" ;
    gmeow:cqDataFile "tests/data/multi-context-winner.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqProjectionWinnerRequiresConsensusShape ;
    gmeow:cqRationale "GMEOW must answer 'is a projection's selected candidate backed by a discharged winner claim for THAT candidate?' (F1). The multi-context-winner fixture holds two independent contexts, each with a receipt selecting its own winner backed by its own discharged claim; the asserted answer is exactly two rows — each receipt paired with ITS OWN claim (receipt₁→claim₁, receipt₂→claim₂). A Cartesian-product query (the pre-fix bug) would return four rows, cross-pairing receipt₁ with claim₂; RowsExact=2 is therefore probative, not vacuous." ;
    gmeow:cqExpectRow ex:cqProjectionWinnerRequiresConsensusRow1 , ex:cqProjectionWinnerRequiresConsensusRow2 .
ex:cqProjectionWinnerRequiresConsensusShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "receipt" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "selected" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "claim" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqProjectionWinnerRequiresConsensusRow1 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:receipt1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "selected" ; gmeow:cellValueIri exd:candA1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "claim" ; gmeow:cellValueIri exd:claim1 ] .
ex:cqProjectionWinnerRequiresConsensusRow2 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:receipt2 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "selected" ; gmeow:cellValueIri exd:candA2 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "claim" ; gmeow:cellValueIri exd:claim2 ] .

# --- CQ / cq-deterministic-digest (F4) -------------------------------------- #
ex:cqDeterministicDigest a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-deterministic-digest.rq" ;
    gmeow:cqDataFile "examples/projection-receipts-worked.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqDeterministicDigestShape ;
    gmeow:cqRationale "GMEOW must answer 'is every projection content-addressed by a deterministic digest?' (F4). The projection-receipts-worked scene has five receipts, each carrying its blake3 gmeow:contentDigest identity; the asserted answer is exactly those five (receipt, digest) rows." ;
    gmeow:cqExpectRow ex:cqDeterministicDigestRow1 , ex:cqDeterministicDigestRow2 , ex:cqDeterministicDigestRow3 , ex:cqDeterministicDigestRow4 , ex:cqDeterministicDigestRow5 .
ex:cqDeterministicDigestShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "receipt" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "digest" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqDeterministicDigestRow1 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:recDag ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "digest" ; gmeow:cellValueLiteral "blake3:c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2" ] .
ex:cqDeterministicDigestRow2 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:recListwise ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "digest" ; gmeow:cellValueLiteral "blake3:b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1" ] .
ex:cqDeterministicDigestRow3 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:recPairwise ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "digest" ; gmeow:cellValueLiteral "blake3:a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90" ] .
ex:cqDeterministicDigestRow4 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:recPareto ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "digest" ; gmeow:cellValueLiteral "blake3:d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3" ] .
ex:cqDeterministicDigestRow5 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:recScalar ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "digest" ; gmeow:cellValueLiteral "blake3:e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4" ] .

# --- CQ / cq-hard-soft-orthogonal (AC3) ------------------------------------- #
ex:cqHardSoftOrthogonal a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-hard-soft-orthogonal.rq" ;
    gmeow:cqDataFile "examples/hard-fails-soft-high.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqHardSoftOrthogonalShape ;
    gmeow:cqRationale "GMEOW must answer 'can a hard failure coexist with a high soft score without being overridden?' The hard-fails-soft-high scene has one candidate carrying BOTH a hard gmeow:verdictNotHeld verdict and a soft assessment; the asserted answer is exactly that one candidate, proving the axes are structurally disjoint." ;
    gmeow:cqExpectRow ex:cqHardSoftOrthogonalRow .
ex:cqHardSoftOrthogonalShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "candidate" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "verdict" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "assessment" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqHardSoftOrthogonalRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "candidate" ; gmeow:cellValueIri exd:candH ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "verdict" ; gmeow:cellValueIri exd:vvHardH ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "assessment" ; gmeow:cellValueIri exd:assessH ] .

# --- CQ / cq-projection-receipt-discloses (AC4) ----------------------------- #
ex:cqProjectionReceiptDiscloses a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-projection-receipt-discloses.rq" ;
    gmeow:cqDataFile "examples/projection-receipts-worked.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqProjectionReceiptDisclosesShape ;
    gmeow:cqRationale "GMEOW must answer 'does every lossy projection name what it dropped?' The projection-receipts-worked scene has four lossy receipts, each disclosing a gmeow:DisclosedLossEntry naming the raw math:Relation it dropped; the exact pairwise receipt discloses nothing and does not appear. The asserted answer is exactly those four rows." ;
    gmeow:cqExpectRow ex:cqProjectionReceiptDisclosesRow1 , ex:cqProjectionReceiptDisclosesRow2 , ex:cqProjectionReceiptDisclosesRow3 , ex:cqProjectionReceiptDisclosesRow4 .
ex:cqProjectionReceiptDisclosesShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "receipt" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "lossEntry" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "droppedRelation" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqProjectionReceiptDisclosesRow1 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:recDag ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lossEntry" ; gmeow:cellValueIri exd:lossDag ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "droppedRelation" ; gmeow:cellValueIri exd:cyclicEdge ] .
ex:cqProjectionReceiptDisclosesRow2 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:recListwise ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lossEntry" ; gmeow:cellValueIri exd:lossListwise ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "droppedRelation" ; gmeow:cellValueIri exd:incompEdge ] .
ex:cqProjectionReceiptDisclosesRow3 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:recPareto ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lossEntry" ; gmeow:cellValueIri exd:lossPareto ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "droppedRelation" ; gmeow:cellValueIri exd:totalOrderEdge ] .
ex:cqProjectionReceiptDisclosesRow4 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "receipt" ; gmeow:cellValueIri exd:recScalar ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lossEntry" ; gmeow:cellValueIri exd:lossScalar ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "droppedRelation" ; gmeow:cellValueIri exd:tiedPairEdge ] .

# --- CQ / cq-model-delta-provenance (AC5) ----------------------------------- #
ex:cqModelDeltaProvenance a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-model-delta-provenance.rq" ;
    gmeow:cqDataFile "examples/model-delta-worked.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqModelDeltaProvenanceShape ;
    gmeow:cqRationale "GMEOW must answer 'what run produced a model/config delta and what data did it train on?' The model-delta-worked scene has one delta generated by a gmeow:PreferenceLearningEvent from a gmeow:DpoView dataset projection; the asserted answer is exactly that one provenance row." ;
    gmeow:cqExpectRow ex:cqModelDeltaProvenanceRow .
ex:cqModelDeltaProvenanceShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "delta" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "learningEvent" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "datasetProjection" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqModelDeltaProvenanceRow a gmeow:ExpectedRow ;
