        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "scope" ], [ logic:termIndex 2 ; logic:termVariable "record" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:RecurrenceReading ] ],
                [ a logic:Formula ; logic:relation gmeow:readingScope ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "scope" ] ],
