#
# Declarative structural assertions for the affect slice. Each assertion runs as
# a SPARQL ASK over affect/module.ttl under the native Rust slicetest harness.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/affect/tests/> .

ex:saEmotionIsModeKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Emotion a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:AffectiveMoment .
    gmeow:AffectiveMoment rdfs:subClassOf gmeow:MentalMoment .
    gmeow:emotionBearer rdfs:range gmeow:Agent .
}""" ;
    gmeow:saRationale "gmeow:Emotion MUST be a logic:Kind grafted under gmeow:AffectiveMoment (an affective member of the kernel gmeow:MentalMoment family), with gmeow:emotionBearer ranging over gmeow:Agent. Mode-ness is inherited via MentalMoment (logic:Mode); the reparent joins emotions to the agent-mental-life family." .

ex:saEmotionTypeNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:emotionType a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:emotionType MUST NOT be functional; blended emotions and rival traditions coexist." .

ex:saAffectiveElicitorTargetDistinct a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:affectiveElicitor a owl:ObjectProperty ;
        rdfs:domain gmeow:Emotion .
    gmeow:affectiveTarget a owl:ObjectProperty ;
        rdfs:domain gmeow:Emotion .
    FILTER (gmeow:affectiveElicitor != gmeow:affectiveTarget)
}""" ;
    gmeow:saRationale "An emotion's cause (gmeow:affectiveElicitor) and its aboutness (gmeow:affectiveTarget) MUST be distinct object properties on gmeow:Emotion — aboutness is not cause (the Ithkuil OBJ distinction)." .

ex:saElicitsIsInverseOfAffectiveElicitor a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:elicits a owl:ObjectProperty ;
        owl:inverseOf gmeow:affectiveElicitor ;
        rdfs:range gmeow:Emotion .
}""" ;
    gmeow:saRationale "gmeow:elicits is the trigger-to-emotion inverse of gmeow:affectiveElicitor (the emotion-to-trigger cause property); asserting the elicitor from the emotion side lets the trigger-rooted reading follow by inversion, mirroring the gmeow:partOf / gmeow:hasPart convention." .

# ── The occurrent (feeling) branch ────────────────────────────────────────────
# These are module-scoped (affect-local) facts; the cross-module transitive
# mode/experience cut (Experience ⊑ MentalProcess lives in mentation) is verified
# over the merged graph by the ex:cqModeExperienceCut competency ASK.

ex:saAffectiveExperienceIsOccurrent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:AffectiveExperience a owl:Class , logic:Event ;
        rdfs:subClassOf gmeow:Experience .
}""" ;
    gmeow:saRationale "gmeow:AffectiveExperience MUST be an OCCURRENT (logic:Event owl:Class) grafted under mentation's gmeow:Experience — the perdurant felt episode, the opposite stereotype from the endurant gmeow:Emotion mode it realizes." .

ex:saAffectiveExperiencePinsProcessType a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:AffectiveExperience rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty gmeow:mentalProcessType ;
        owl:hasValue gmeow:processAffectiveExperience ] .
}""" ;
    gmeow:saRationale "The kind is pinned as a VALUE, not a subclass (the gmeow:DreamReport idiom, Principle 9): every gmeow:AffectiveExperience carries gmeow:mentalProcessType gmeow:processAffectiveExperience via an owl:hasValue restriction — a restriction-pinned handle, not over-typing." .

ex:saProcessAffectiveExperienceIsMentalProcessType a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:processAffectiveExperience a gmeow:MentalProcessType . }""" ;
    gmeow:saRationale "gmeow:processAffectiveExperience MUST be a gmeow:MentalProcessType individual — a value extending mentation's process-type vocabulary from the affect slice (the gmeow:EventType idiom), never a subclass of gmeow:MentalProcess." .

ex:saFeltAffectRefinesRealizes a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:feltAffect a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:realizesMentalMoment ;
        rdfs:domain gmeow:AffectiveExperience ;
        rdfs:range gmeow:AffectiveMoment .
}""" ;
    gmeow:saRationale "gmeow:feltAffect MUST be the affect-scoped refinement of mentation's gmeow:realizesMentalMoment (domain narrowed to gmeow:AffectiveExperience, range to the endurant gmeow:AffectiveMoment mode) — the discoverable feeling bridge, mirroring gmeow:appraisalOf ⊑ gmeow:observedFeature." .

ex:saFeltAffectNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:feltAffect a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:feltAffect MUST NOT be functional — one felt episode may manifest several coexisting affective modes (a blended feeling), inheriting the non-functional character of gmeow:realizesMentalMoment." .

# ── The dimensional landscape (axes, scale profile, vector, composites, intensity) ──

ex:saCoreAffectDimensionSubOfAppraisal a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:CoreAffectDimension a owl:Class ;
        rdfs:subClassOf gmeow:AppraisalDimension .
    gmeow:dimensionValence a gmeow:CoreAffectDimension ;
        gmeow:dimensionFamily gmeow:familyCoreAffect .
    gmeow:dimensionAgency gmeow:dimensionFamily gmeow:familyAppraisal .
}""" ;
    gmeow:saRationale "The two axis families MUST be distinguished BOTH by type (gmeow:CoreAffectDimension ⊑ gmeow:AppraisalDimension) AND by the gmeow:dimensionFamily tag — valence is a core-affect axis, agency a cognitive appraisal axis. Belt and suspenders; the vocabulary stays open (Principle 9)." .

ex:saAppraisalValueRequiresProfile a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:appraisalScaleProfile a owl:ObjectProperty ;
        rdfs:domain gmeow:Appraisal ;
        rdfs:range gmeow:AffectScaleProfile .
    gmeow:AffectScaleProfile a owl:Class .
}""" ;
    gmeow:saRationale "The reshape MUST provide the framing property: gmeow:appraisalScaleProfile (Appraisal → gmeow:AffectScaleProfile) is how a dimensional reading declares the scale it is read against, replacing the removed bare-decimal floor (Principle 6/11). The SHACL AppraisalShape enforces its presence whenever gmeow:appraisalValue is asserted." .

ex:saVectorObservationGroupsCells a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:AffectVectorObservation a owl:Class ;
        rdfs:subClassOf gmeow:Observation .
    gmeow:vectorComponent a owl:ObjectProperty ;
        rdfs:domain gmeow:AffectVectorObservation ;
        rdfs:range gmeow:Appraisal .
    gmeow:vectorProfile rdfs:range gmeow:AffectScaleProfile .
}""" ;
    gmeow:saRationale "gmeow:AffectVectorObservation (⊑ gmeow:Observation, the reified-factored idiom) MUST group per-axis gmeow:Appraisal cells via gmeow:vectorComponent and name its basis via gmeow:vectorProfile — the queryable identity for a vector reading, one cell per axis preserved." .

ex:saCompositeConstituentNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:affectiveConstituent a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:affectiveConstituent MUST NOT be functional — a composite (schadenfreude, saudade) decomposes into SEVERAL constituents (a core vector plus differentiating relations); the SHACL AffectCompositeShape requires at least one (no unanalyzed primitives)." .

ex:saCompositeIsEmotion a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:AffectComposite a owl:Class ;
        rdfs:subClassOf gmeow:Emotion .
    gmeow:affectiveConstituent a owl:ObjectProperty ;
        rdfs:domain gmeow:AffectComposite .
}""" ;
    gmeow:saRationale "gmeow:AffectComposite MUST be a named gmeow:Emotion carrying its decomposition via gmeow:affectiveConstituent — modeling up compounds from axes and relations, never minting opaque primitives." .

ex:saDerivedIntensityIsObservation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:DerivedAffectIntensityObservation a owl:Class ;
        rdfs:subClassOf gmeow:Observation .
    gmeow:intensityBasis rdfs:range gmeow:AffectVectorObservation .
    gmeow:metricProfile rdfs:range gmeow:AffectScaleProfile .
    gmeow:fnAffectiveIntensity a gmeow:AffectFunction .
}""" ;
    gmeow:saRationale "Overall intensity is a DERIVED gmeow:Observation (⊑ gmeow:Observation) over a declared gmeow:intensityBasis under a declared gmeow:metricProfile, exposed via the named gmeow:fnAffectiveIntensity function — a computed view under a named metric (Principle 12), never a stored ground fact. The SHACL shape enforces the full basis/scale/weighting/norm declaration." .

# ── The evidence spine (attributed evidence, never inner-state truth) ──────────

ex:saClassifierOutputIsObservationNotEmotion a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:AffectClassifierOutput a owl:Class ;
        rdfs:subClassOf gmeow:Observation .
    gmeow:ModelInferenceRun a owl:Class .
    gmeow:supportsAffectiveClaim a owl:ObjectProperty ;
        rdfs:range gmeow:AffectiveClaim .
    gmeow:modelRevision a owl:DatatypeProperty .
}""" ;
    gmeow:saRationale "A classifier output MUST be a gmeow:Observation (evidence), produced by a gmeow:ModelInferenceRun, and it SUPPORTS a gmeow:AffectiveClaim (never entails it) — the evidence/claim boundary. Model provenance (gmeow:modelRevision) is a first-class datatype property; the SHACL shapes enforce completeness and the claim boundary." .

ex:saAffectVocabulariesAreOpen a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    { gmeow:EmotionType owl:oneOf ?x }
    UNION { gmeow:ScoreSemantics owl:oneOf ?x }
    UNION { gmeow:DimensionFamily owl:oneOf ?x }
    UNION { gmeow:ScalePolarity owl:oneOf ?x }
    UNION { gmeow:AppraisalDimension owl:oneOf ?x }
    UNION { gmeow:AestheticQuality owl:oneOf ?x }
}""" ;
    gmeow:saRationale "A closed enum anywhere in canonical affect is a hard fail (hard-fail rule 6): every affect value vocabulary — EmotionType, ScoreSemantics, DimensionFamily, ScalePolarity, AppraisalDimension, AestheticQuality — MUST stay an open individual vocabulary (logic:AbstractIndividualType ⊑ logic:QualityValue), NEVER an owl:oneOf enumeration. Closed sets are projection artifacts only." .

ex:saClassifierLabelNotEmotionType a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModuleAndExamples ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { ?label a gmeow:AffectClassifierLabel , gmeow:EmotionType . }""" ;
    gmeow:saRationale "No gmeow:AffectClassifierLabel (including the seeded GoEmotions/Ekman/SST-2/Cardiff labels and any example-loaded label) may ALSO be a gmeow:EmotionType — 'neutral' as an EmotionType is a hard fail (rule 3); labels are external identities, never canonical emotion vocabulary." .
