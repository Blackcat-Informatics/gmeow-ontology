gmeow:episodeLasted
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported duration of episode left"@x-gmeow-english ;
    skos:definition "The source-reported duration of the actual episode Activity named by episodeLeft in this EpisodeTransition report's supplied context. A source-computed span retains its actual derivation; GMEOW does not compute or verify timestamp subtraction."@x-gmeow-english ;
    gmeow:useWhen "Use when a source explicitly supplies a measured or computed duration for the episode reported as left."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a duration, episode endpoint, input claim, clock precision, epoch or timezone, or reading this value as time spent changing episodes."@x-gmeow-english ;
    gmeow:howToUse "Keep the exact literal, datatype, lexical form and units. On the exact duration assertion's native RDF 1.2 reifier, retain wasDerivedFrom for the documentary source, wasAttributedTo for the recorder and accordingTo for the declaring frame. For a source-computed span, preserve the supplied calculation and input roles with statedRationale and link only actual supplied inputs with wasDerivedFrom; create no missing input claims."@x-gmeow-english ;
    skos:scopeNote "Optional and nonfunctional. Missing values are unspecified; historical and competing attributed durations coexist. This relation requires no endpoint or input claim and establishes no computed timestamps, execution, completion, causal order or global current winner."@x-gmeow-english ;
    skos:example "A source supplies fifteen minutes for the episode named by episodeLeft; the report retains the supplied xsd:duration and its exact assertion provenance without deriving timestamps."@x-gmeow-english ;
    logic:domain gmeow:EpisodeTransition ;
    logic:range xsd:duration .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/episodeLasted" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:episodeTransition
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "episode transition attachment"@x-gmeow-english ;
    skos:definition "A source-supplied attachment from an actual episode-chain claim reifier to its episode-transition report."@x-gmeow-english ;
    gmeow:useWhen "Use when the source attaches a transition report to an actual native claim."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a chain predicate, quoted claim or endpoint correspondence."@x-gmeow-english ;
    gmeow:howToUse "Keep the actual rdf:reifies witness and exact assertion provenance; preserve any selected slot protocol."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional. Attachment neither asserts the quoted proposition nor executes a scheduler."@x-gmeow-english ;
    skos:example "An actual chain-claim reifier names its retained transition report."@x-gmeow-english ;
    logic:domain gmeow:InformationObject ;
    logic:range gmeow:EpisodeTransition .

gmeow:transitionCauseRule
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported causing rule specification"@x-gmeow-english ;
    skos:definition "An actual identified rule-specification record cited by the source as a transition’s causal basis."@x-gmeow-english ;
    gmeow:useWhen "Use for the source’s actual cited rule specification."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring a logic:Rule, program, rule firing or verified causality from citation."@x-gmeow-english ;
    gmeow:howToUse "Retain the identified specification and exact claim’s source and declaring frame; keep actual formalization separate."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional. A string or label alone does not supply an identified rule record."@x-gmeow-english ;
    skos:example "A transition report cites the actual policy specification supplied by its source."@x-gmeow-english ;
    logic:domain gmeow:EpisodeTransition ;
    logic:range gmeow:InformationObject .

gmeow:transitionCauseFact
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported causing fact claim"@x-gmeow-english ;
    skos:definition "An actual claim reifier cited by the source as a factual causal basis for a transition."@x-gmeow-english ;
    gmeow:useWhen "Use when a source identifies the exact factual claim it cites."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting the quotation, inventing a fact or treating citation as causal proof."@x-gmeow-english ;
    gmeow:howToUse "Retain that claim’s actual rdf:reifies witness and the causal association’s own source and frame."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional. The quoted proposition, recorder and reported causal basis remain distinct."@x-gmeow-english ;
    skos:example "A report cites a retained observation claim without asserting its quoted proposition."@x-gmeow-english ;
    logic:domain gmeow:EpisodeTransition ;
    logic:range gmeow:InformationObject .

gmeow:EpisodeInterlude
    a logic:Class, logic:SubKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:StructuredValue ;
    rdfs:label "Episode Interlude Occurrence"@x-gmeow-english ;
    skos:definition "A scalar payload occurrence belonging to one transition report, retaining an actual Activity and its report-local ordinal."@x-gmeow-english ;
    gmeow:useWhen "Use for each source-supplied interlude occurrence within a transition report."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid placing an ordinal on a shared Activity or inferring chronological or causal order."@x-gmeow-english ;
    gmeow:howToUse "Retain structuredTerm as the actual Activity and entryOrdinal as its zero-based position; use distinct occurrences for repetitions."@x-gmeow-english ;
    skos:scopeNote "One parent is required. Equal numeric ordinal aliases coexist without literal rewriting; positions need not be contiguous."@x-gmeow-english ;
    skos:example "The same Activity appears twice through distinct interlude occurrences at different positions."@x-gmeow-english .

