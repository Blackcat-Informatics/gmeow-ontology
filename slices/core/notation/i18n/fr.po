msgctxt "https://blackcatinformatics.ca/gmeow/NotationSystemSMuFLPatternConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "SMuFL codepoint pattern constraint"
msgstr "contrainte de motif des points de code SMuFL"

msgctxt "https://blackcatinformatics.ca/gmeow/NotationSystemSMuFLPatternConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A closed-world integrity constraint: every gmeow:smuflCodepoint value matches the SMuFL Unicode-codepoint pattern U+HHHH(HH)."
msgstr "Une contrainte d'intégrité en monde clos : chaque valeur de gmeow:smuflCodepoint respecte le motif de point de code Unicode SMuFL U+HHHH(HH)."

msgctxt "https://blackcatinformatics.ca/gmeow/NotationProjectionProfileLossOrParameterConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Notation projection profile loss-or-parameter constraint"
msgstr "contrainte « perte ou paramètre » d'un profil de projection de notation"

msgctxt "https://blackcatinformatics.ca/gmeow/NotationProjectionProfileLossOrParameterConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A closed-world requiredness constraint: a gmeow:NotationProjectionProfile must declare at least one gmeow:representableParameter or one gmeow:declaredLoss."
msgstr "Une contrainte d'obligation en monde clos : un gmeow:NotationProjectionProfile doit déclarer au moins un gmeow:representableParameter ou une gmeow:declaredLoss."
