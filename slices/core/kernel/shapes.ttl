@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .

# =========================================================================== #
# Consumer-advisory range shapes
#
# gmeow:useForConsumer / gmeow:avoidForConsumer are term-level advisory
# annotations whose value MUST be a declared gmeow:ProjectionContext individual
# (the OWL rdfs:range says so; this is the enforceable data-shape twin). A pure
# class-membership constraint over asserted triples, authored declaratively so it
# folds into gmeow.gts and is enforced by `make validate` (dogfooding). This is
# the sole enforcement of the range constraint: `sh:nodeKind sh:IRI` rejects
# blank-node/literal values and `sh:class gmeow:ProjectionContext` rejects any
# IRI that is not a declared ProjectionContext individual.
# =========================================================================== #

gmeow:UseForConsumerTargetShape
    a sh:NodeShape ;
    rdfs:label "useForConsumer range shape"@x-gmeow-english ;
    skos:definition "Every gmeow:useForConsumer value must be a declared gmeow:ProjectionContext individual."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/kernel> ;
    logic:formalizes gmeow:UseForConsumerTargetConstraint ;
    sh:targetSubjectsOf gmeow:useForConsumer ;
    sh:property [
        sh:path gmeow:useForConsumer ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:ProjectionContext ;
        sh:severity sh:Violation ;
        sh:message "gmeow:useForConsumer must point at a declared gmeow:ProjectionContext individual." ;
    ] .

gmeow:AvoidForConsumerTargetShape
    a sh:NodeShape ;
    rdfs:label "avoidForConsumer range shape"@x-gmeow-english ;
    skos:definition "Every gmeow:avoidForConsumer value must be a declared gmeow:ProjectionContext individual."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/kernel> ;
    logic:formalizes gmeow:AvoidForConsumerTargetConstraint ;
    sh:targetSubjectsOf gmeow:avoidForConsumer ;
    sh:property [
        sh:path gmeow:avoidForConsumer ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:ProjectionContext ;
        sh:severity sh:Violation ;
        sh:message "gmeow:avoidForConsumer must point at a declared gmeow:ProjectionContext individual." ;
    ] .
