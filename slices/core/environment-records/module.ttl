gmeow:WorldKindHierarchyAcyclicConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "world kind hierarchy acyclicity"@x-gmeow-english ;
    skos:definition "An everyday kind cannot reach itself through one or more broader-kind links. Multiple broader parents remain permitted."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency within the declared source scope."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this law executes a provider, verifies source bytes or grants disclosure permission."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact source evidence when diagnosing a violated obligation; never invent missing inputs."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:WorldKindHierarchyAcyclicConstraint logic:formalizes gmeow:worldObjectKindBroader ."@x-gmeow-english ;
    logic:formalizes gmeow:worldObjectKindBroader ;
    logic:message "An everyday kind cannot reach itself through one or more broader-kind links. Multiple broader parents remain permitted." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation rdf:type ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                    [ logic:termIndex 1 ; logic:termIri gmeow:WorldObjectKind ] ] ;
            logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ; logic:relation logic:transitiveReach ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:worldObjectKindBroader ],
                        [ logic:termIndex 2 ; logic:termVariable "this" ] ] ] ] ] .

gmeow:WorldStateSupersessionAcyclicConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "world state supersession acyclicity"@x-gmeow-english ;
    skos:definition "A state claim cannot causally replace itself through a nonempty supersession path. The law orders replacement edges rather than source clocks."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency within the declared source scope."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this law executes a provider, verifies source bytes or grants disclosure permission."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact source evidence when diagnosing a violated obligation; never invent missing inputs."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:WorldStateSupersessionAcyclicConstraint logic:formalizes gmeow:WorldObjectStateClaim ."@x-gmeow-english ;
    logic:formalizes gmeow:WorldObjectStateClaim ;
    logic:message "A state claim cannot causally replace itself through a nonempty supersession path. The law orders replacement edges rather than source clocks." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation rdf:type ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                    [ logic:termIndex 1 ; logic:termIri gmeow:WorldObjectStateClaim ] ] ;
            logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ; logic:relation logic:transitiveReach ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:supersedes ],
                        [ logic:termIndex 2 ; logic:termVariable "this" ] ] ] ] ] .

gmeow:WorldStateSupersessionScopeConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "world state supersession scope constraint"@x-gmeow-english ;
    skos:definition "A replaced state claim has the same object, provider, world and encoding profile as its successor. Different profiles or worlds require separate histories rather than a silent causal merge."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency within the declared source scope."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this law executes a provider, verifies source bytes or grants disclosure permission."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact source evidence when diagnosing a violated obligation; never invent missing inputs."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:WorldStateSupersessionScopeConstraint logic:formalizes gmeow:WorldObjectStateClaim ."@x-gmeow-english ;
    logic:formalizes gmeow:WorldObjectStateClaim ;
    logic:message "A replaced state claim has the same object, provider, world and encoding profile as its successor. Different profiles or worlds require separate histories rather than a silent causal merge." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "other" ], [ logic:termIndex 2 ; logic:termVariable "scope0" ], [ logic:termIndex 3 ; logic:termVariable "scope1" ], [ logic:termIndex 4 ; logic:termVariable "scope2" ], [ logic:termIndex 5 ; logic:termVariable "scope3" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:WorldObjectStateClaim ] ],
                [ a logic:Formula ; logic:relation gmeow:supersedes ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "other" ] ],
                [ a logic:Formula ; logic:relation gmeow:recordedWorldObject ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "scope0" ] ],
                [ a logic:Formula ; logic:relation gmeow:providerProgram ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "scope1" ] ],
                [ a logic:Formula ; logic:relation gmeow:providerWorld ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "scope2" ] ],
                [ a logic:Formula ; logic:relation gmeow:stateEncodingProfile ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "scope3" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:WorldObjectStateClaim ] ],
                [ a logic:Formula ; logic:relation gmeow:recordedWorldObject ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ],
                        [ logic:termIndex 1 ; logic:termVariable "scope0" ] ],
                [ a logic:Formula ; logic:relation gmeow:providerProgram ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ],
