    gmeow:saRationale "gmeow:methodStreaming MUST exist as an ObservationMethod. Mirrors test_streaming_method_exists." .

# --- 21. YAMATO quality stratification grounded in the observation spine (MUST) -
ex:saQualityStratificationGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Quality a owl:Class ; rdfs:subClassOf logic:Quality .
    gmeow:Magnitude a owl:Class .
    gmeow:GenericQuality a owl:Class .
    gmeow:bearer a owl:ObjectProperty , owl:FunctionalProperty .
    gmeow:observationOf a owl:ObjectProperty ; rdfs:subPropertyOf gmeow:observedFeature .
    gmeow:observedAt a owl:DatatypeProperty .
    gmeow:dimension a owl:ObjectProperty .
    gmeow:trueQuantity rdfs:subPropertyOf logic:trueQuantity .
    gmeow:unit rdfs:subPropertyOf logic:unit .
    gmeow:hasReferenceFrame rdfs:subPropertyOf logic:referenceFrame .
    gmeow:quantityValue rdfs:subPropertyOf logic:measuredValue .
    gmeow:pressure a gmeow:GenericQuality .
}""" ;
    gmeow:saRationale "The YAMATO quality stratification MUST be grounded in the observation spine: the persistent gmeow:Quality (subclass of logic:Quality) borne by gmeow:bearer, dated readings attached via gmeow:observationOf (a gmeow:observedFeature specialization) + gmeow:observedAt, the frame-independent gmeow:Magnitude with gmeow:dimension, and the measurement-seam lifts onto the logic: foundation (gmeow:trueQuantity / gmeow:unit / gmeow:hasReferenceFrame / gmeow:quantityValue) so a domain measurement fires logic:MeasurementFrameMissing when frameless (Principle 11). The legacy hasUnit property is fully retired in favour of gmeow:unit." .
