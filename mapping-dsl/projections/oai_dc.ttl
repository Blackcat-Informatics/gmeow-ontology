        gmeow:profile "oai_dc" ; gmeow:toPredicate dc:format ; gmeow:relation "<=" ; gmeow:confidence 0.6 ;
        gmeow:lossyDrop "extent/medium collapse to dc:format" ] .

gmeow:mapOaiDcAudience a gmeow:ProjectionMapping ;
    rdfs:label "audience → dc:description (no direct 15-element mapping)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "work" ; gmeow:value "desc" ;
        gmeow:atom ( [ gmeow:subjectVar "work" ; gmeow:predicate gmeow:audience ; gmeow:objectVar "desc" ] ) ;
        gmeow:edoalSource gmeow:audience ] ;
    gmeow:hasBinding [
        gmeow:profile "oai_dc" ; gmeow:toPredicate dc:description ; gmeow:relation "<=" ; gmeow:confidence 0.5 ;
        gmeow:lossyDrop "audience has no direct 15-element mapping; falls to dc:description" ] .

gmeow:mapOaiDcProvenance a gmeow:ProjectionMapping ;
    rdfs:label "provenance → dc:source (dumb-down)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "work" ; gmeow:value "src" ;
        gmeow:atom ( [ gmeow:subjectVar "work" ; gmeow:predicate gmeow:provenance ; gmeow:objectVar "src" ] ) ;
        gmeow:edoalSource gmeow:provenance ] ;
    gmeow:hasBinding [
        gmeow:profile "oai_dc" ; gmeow:toPredicate dc:source ; gmeow:relation "<=" ; gmeow:confidence 0.5 ;
        gmeow:lossyDrop "provenance falls to dc:source in the 15-element dumb-down" ] .

gmeow:mapOaiDcAccessRights a gmeow:ProjectionMapping ;
    rdfs:label "conditionsOfAccess → dc:rights (dumb-down)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "work" ; gmeow:value "rights" ;
        gmeow:atom ( [ gmeow:subjectVar "work" ; gmeow:predicate gmeow:conditionsOfAccess ; gmeow:objectVar "rights" ] ) ;
        gmeow:edoalSource gmeow:conditionsOfAccess ] ;
    gmeow:hasBinding [
        gmeow:profile "oai_dc" ; gmeow:toPredicate dc:rights ; gmeow:relation "<=" ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "license/rightsHolder/accessRights all collapse to dc:rights" ] .
