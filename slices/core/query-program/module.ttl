    skos:scopeNote "The class witness is supplied source evidence, not an instruction to create one or a requirement of one list per class."@x-gmeow-english ;
    skos:example "A selected-class obligation: gmeow:UnionSelectedListClassLaw logic:formalizes gmeow:rankedListClass ."@x-gmeow-english ;
    logic:formalizes gmeow:rankedListClass ;
