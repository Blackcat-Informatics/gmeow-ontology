# =========================================================================== #
# Orthographies (minted from the former usesWritingSystem bindings; the
# convention binding a sign system to a script — lang:orthographyFor + lang:usesScript).
# =========================================================================== #

gmeow:orthEnglishLatn a lang:Orthography ;
    rdfs:label "English Latin orthography"@x-gmeow-english ;
    skos:definition "The convention by which English is written in the Latin script."@x-gmeow-english ;
    lang:orthographyFor lang:english ;
    lang:usesScript lang:latinScript ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> .

