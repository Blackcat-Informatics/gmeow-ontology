#
# Declarative competency questions for the language slice (crates/slicetest): the
# bedrock questions the term surface must answer about the typed form AST. Each query
# runs over the merged ontology unioned with the shared fixture (gmeow:cqDataFile),
# and its expected rows are pinned exactly (logic:RowsExact).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/lang/tests/> .
@prefix exf:   <http://example.org/lang/> .

# === Q1 — explicitly unanalyzed surfaces =================================== #

ex:cqUnanalyzedSurfaces a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/lang/queries/competency/unanalyzed-surfaces.rq" ;
    gmeow:cqDataFile "tests/fixtures/forms.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A surface reports whether it is explicitly held as lang:UnanalyzedProse at lang:rawLevel; over the fixture the answer is exactly {rawSurface}, distinct from the parsed surface of the same text." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqUnanalyzedShape ;
    gmeow:cqExpectRow ex:rowRawSurface .

ex:cqUnanalyzedShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "surface" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowRawSurface a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "surface" ; gmeow:cellValueIri exf:rawSurface ] .

# === Q2 — constituents of a composed form in slot-index order ============== #

ex:cqConstituentsInOrder a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/lang/queries/competency/constituents-in-order.rq" ;
    gmeow:cqDataFile "tests/fixtures/forms.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A composed form reports its slot forms in lang:slotIndex order; over the fixture the answer for exf:cf is exactly its two constituents {cats (0), sleep (1)}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqConstituentsShape ;
    gmeow:cqExpectRow ex:rowConstituentCats , ex:rowConstituentSleep .

ex:cqConstituentsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "form" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowConstituentCats a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "form" ; gmeow:cellValueIri exf:wfCats ] .

ex:rowConstituentSleep a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "form" ; gmeow:cellValueIri exf:wfSleep ] .

# === Q3 — word forms with their lexeme and Number value ==================== #

ex:cqWordFormMorphology a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/lang/queries/competency/word-form-morphology.rq" ;
    gmeow:cqDataFile "tests/fixtures/forms.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A word form reports the lexeme it inflects and its typed Number value drawn from the feature inventory; over the fixture the answer is exactly {wfCats → (cat, Plur), wfSleep → (sleep, Plur)}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqMorphologyShape ;
    gmeow:cqExpectRow ex:rowMorphCats , ex:rowMorphSleep .

ex:cqMorphologyShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "wf" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "lex" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "val" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowMorphCats a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "wf" ; gmeow:cellValueIri exf:wfCats ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lex" ; gmeow:cellValueIri exf:lexCat ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "val" ; gmeow:cellValueIri lang:valPlur ] .

ex:rowMorphSleep a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "wf" ; gmeow:cellValueIri exf:wfSleep ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lex" ; gmeow:cellValueIri exf:lexSleep ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "val" ; gmeow:cellValueIri lang:valPlur ] .

# === Q4 (meaning) — forms holding more than one co-resident reading ========= #

ex:cqCoresidentReadings a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/lang/queries/competency/coresident-readings.rq" ;
    gmeow:cqDataFile "tests/conformance-fixtures/meaning-scope-ambiguity.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "An ambiguous form keeps every reading as first-class data; over the scope-ambiguity fixture the one sentence form carrying both the forall-exists and exists-forall readings is exactly {sent}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqCoresidentShape ;
    gmeow:cqExpectRow ex:rowCoresidentSent .

ex:cqCoresidentShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "form" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowCoresidentSent a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "form" ; gmeow:cellValueIri exf:sent ] .

# === Q5 (meaning) — forms denoting a logic:Formula (the declarative bridge) == #

ex:cqDenotationsToFormula a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/lang/queries/competency/denotations-to-formula.rq" ;
    gmeow:cqDataFile "tests/conformance-fixtures/meaning-cats-chase-mice.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A declarative sentence denotes a full-FOL logic:Formula through the one-way bridge; over the cats-chase-mice fixture the denoting form is exactly {sentCatsChaseMice}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqDenotationsToFormulaShape ;
    gmeow:cqExpectRow ex:rowDenotesFormula .

ex:cqDenotationsToFormulaShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "form" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowDenotesFormula a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "form" ; gmeow:cellValueIri exf:sentCatsChaseMice ] .

# === Q6 (meaning) — hypernymy resolved as logic: subsumption over denoted types = #

ex:cqHypernymyThroughBridge a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/lang/queries/competency/hypernymy-through-bridge.rq" ;
    gmeow:cqDataFile "tests/conformance-fixtures/meaning-sense-hypernymy.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The sense lattice is preserved as logic: linkage: two senses denote two logic:Types and their hypernymy IS the logic: subsumption over those types. Over the sense-hypernymy fixture the answer is exactly the (dog, animal) pair — reasoned in logic:, not a forked lang: edge." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqHypernymyShape ;
    gmeow:cqExpectRow ex:rowHypernymyDogAnimal .

ex:cqHypernymyShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "narrow" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "broad" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHypernymyDogAnimal a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "narrow" ; gmeow:cellValueIri exf:wfDog ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "broad" ; gmeow:cellValueIri exf:wfAnimal ] .

# === Q7 (translation) — projection loss against canon (the crossing loss ledger) = #

ex:cqProjectionLossAgainstCanon a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/lang/queries/competency/projection-loss-against-canon.rq" ;
    gmeow:cqDataFile "tests/conformance-fixtures/translation-french-english-pair.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A crossing between sign systems carries its adequacy on a logic:Correspondence, not as a silent Exact default; this query reads the loss ledger off the corpus. Over the French/English pair fixture the answer is exactly the two present crossings {unitCat, unitDog}, each carrying a NON-Exact logic:ValidationOnly judgment (string-level and machine-unanalyzed) on its Correspondence." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqProjectionLossShape ;
    gmeow:cqExpectRow ex:rowLossCat , ex:rowLossDog .

ex:cqProjectionLossShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "unit" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "preservation" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowLossCat a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "unit" ; gmeow:cellValueIri exf:unitCat ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "preservation" ; gmeow:cellValueIri logic:ValidationOnly ] .

ex:rowLossDog a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "unit" ; gmeow:cellValueIri exf:unitDog ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "preservation" ; gmeow:cellValueIri logic:ValidationOnly ] .

# === Q8 (GMN) — the four judged dialect-level crossings ===================== #
# Runs directly over the merged ontology (no cqDataFile): the GMN dialect
# doctrine lives in the module itself, so the answer is measured off the
# module's own four crossing individuals.

ex:cqGmnLevelCorrespondences a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/lang/queries/competency/gmn-level-correspondences.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Which preservation judgment does each GMN level crossing carry? Every crossing between dialect levels is a lang:TranslationUnit carrying its law-spine on exactly one logic:Correspondence, never asserted flat; the answer is exactly the four module crossings — the two GMN-0 encodings (GTS, N-Quads) as ExactPreservation with a retained mnemomorphic witness, GMN-0 → GMN-1 as SoundUnderApproximation with none, and GMN-1 → GMN-2 as ValidationOnly with none." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqGmnLevelShape ;
    gmeow:cqExpectRow ex:rowGmnCrossGmnToCompacted , ex:rowGmnCrossNormalToGmn ,
        ex:rowGmnCrossNormalToGts , ex:rowGmnCrossNormalToNQuads .

ex:cqGmnLevelShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "unit" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "corr" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "preservation" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "mnemomorphic" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowGmnCrossGmnToCompacted a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "unit" ; gmeow:cellValueIri gmeow:gmnUnitGmnToCompacted ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corr" ; gmeow:cellValueIri gmeow:gmnCorrGmnToCompacted ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "preservation" ; gmeow:cellValueIri logic:ValidationOnly ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "mnemomorphic" ; gmeow:cellValueLiteral "false" ] .

ex:rowGmnCrossNormalToGmn a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "unit" ; gmeow:cellValueIri gmeow:gmnUnitNormalToGmn ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corr" ; gmeow:cellValueIri gmeow:gmnCorrNormalToGmn ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "preservation" ; gmeow:cellValueIri logic:SoundUnderApproximation ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "mnemomorphic" ; gmeow:cellValueLiteral "false" ] .

ex:rowGmnCrossNormalToGts a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "unit" ; gmeow:cellValueIri gmeow:gmnUnitNormalToGts ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corr" ; gmeow:cellValueIri gmeow:gmnCorrNormalToGts ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "preservation" ; gmeow:cellValueIri logic:ExactPreservation ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "mnemomorphic" ; gmeow:cellValueLiteral "true" ] .

ex:rowGmnCrossNormalToNQuads a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "unit" ; gmeow:cellValueIri gmeow:gmnUnitNormalToNQuads ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corr" ; gmeow:cellValueIri gmeow:gmnCorrNormalToNQuads ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "preservation" ; gmeow:cellValueIri logic:ExactPreservation ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "mnemomorphic" ; gmeow:cellValueLiteral "true" ] .

# === Q9 (GMN) — the ten record-initial sigil roles and their glyphs ========= #

ex:cqGmnSigilRoles a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/lang/queries/competency/gmn-sigil-roles.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Which record-initial sigil opens each GMN record role? The codebook's sigil inventory is queryable data: the complete answer is exactly the ten seeded gmeow:GmnSigilRole individuals, each naming its concrete glyph through gmeow:gmnSigilGlyph — claim @c, evidence @e, standpoint @s, process @p, proof @π, defeater @d, modal @m, math @μ, lang-AST @λ, logic @ℒ." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqGmnSigilShape ;
    gmeow:cqExpectRow ex:rowGmnSigilClaim , ex:rowGmnSigilEvidence , ex:rowGmnSigilStandpoint ,
        ex:rowGmnSigilProcess , ex:rowGmnSigilProof , ex:rowGmnSigilDefeater ,
        ex:rowGmnSigilModal , ex:rowGmnSigilMath , ex:rowGmnSigilLangAst , ex:rowGmnSigilLogic .

ex:cqGmnSigilShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "role" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "glyph" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowGmnSigilClaim a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:gmnSigilClaim ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "glyph" ; gmeow:cellValueLiteral "@c" ] .

ex:rowGmnSigilEvidence a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:gmnSigilEvidence ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "glyph" ; gmeow:cellValueLiteral "@e" ] .

ex:rowGmnSigilStandpoint a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:gmnSigilStandpoint ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "glyph" ; gmeow:cellValueLiteral "@s" ] .

ex:rowGmnSigilProcess a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:gmnSigilProcess ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "glyph" ; gmeow:cellValueLiteral "@p" ] .

ex:rowGmnSigilProof a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:gmnSigilProof ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "glyph" ; gmeow:cellValueLiteral "@π" ] .

ex:rowGmnSigilDefeater a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:gmnSigilDefeater ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "glyph" ; gmeow:cellValueLiteral "@d" ] .

ex:rowGmnSigilModal a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:gmnSigilModal ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "glyph" ; gmeow:cellValueLiteral "@m" ] .

ex:rowGmnSigilMath a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:gmnSigilMath ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "glyph" ; gmeow:cellValueLiteral "@μ" ] .

ex:rowGmnSigilLangAst a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:gmnSigilLangAst ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "glyph" ; gmeow:cellValueLiteral "@λ" ] .

ex:rowGmnSigilLogic a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:gmnSigilLogic ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "glyph" ; gmeow:cellValueLiteral "@ℒ" ] .

# === Q10 (GMN) — the version-policy ruling as queryable data ================ #

ex:cqGmnVersionPolicy a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/lang/queries/competency/gmn-version-policy.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "What is the current GMN dialect version and what does a conforming reader accept? The support-policy ruling is queryable data: the lineage gmeow:gmnDialectVersions carries gmeow:gmnAcceptWindow 1 (current major plus one prior), and version 1's standing is reified as two gmeow:VersionMembership relators — the answer is exactly gmeow:gmnVersionOne holding both the canonical and the latest role, each row carrying the window." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqGmnVersionShape ;
    gmeow:cqExpectRow ex:rowGmnVersionCanonical , ex:rowGmnVersionLatest .

ex:cqGmnVersionShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "version" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "role" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "window" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowGmnVersionCanonical a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "version" ; gmeow:cellValueIri gmeow:gmnVersionOne ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:roleCanonical ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "window" ; gmeow:cellValueLiteral "1" ] .

ex:rowGmnVersionLatest a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "version" ; gmeow:cellValueIri gmeow:gmnVersionOne ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "role" ; gmeow:cellValueIri gmeow:roleLatest ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "window" ; gmeow:cellValueLiteral "1" ] .
