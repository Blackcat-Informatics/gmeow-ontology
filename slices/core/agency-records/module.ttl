    gmeow:useWhen "Use when the source explicitly reports active self-commitment."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving commitmentActive solely from silence, missing timestamps or another status axis."@x-gmeow-english ;
    gmeow:howToUse "Attach commitmentActive through commitmentStatus, preserving the source attribution and time context."@x-gmeow-english ;
    skos:example "ex:record gmeow:commitmentStatus gmeow:commitmentActive ."@x-gmeow-english .

