@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/owl-time> a align:Alignment ;
    rdfs:label "GMEOW → owl-time (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "startedAtTime → time:hasBeginning minted Instant"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:startedAtTime ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri time:hasBeginning ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "endedAtTime → time:hasEnd minted Instant"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:endedAtTime ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri time:hasEnd ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "eventTime → time:hasTime minted Instant"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:eventTime ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri time:hasTime ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "owl-time" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
