% === Rules ===
hasMastered(?agent, ?subject, ?C) :-
    assessedAgent(?assessProc, ?agent, ?C),
    assessmentDimension(?assessProc, "https://blackcatinformatics.ca/logic/dimensionProceduralCompetence", ?C),
    assessmentLevel(?assessProc, ?levelProc, ?C),
    assessmentSubject(?assessProc, ?subject, ?C),
    assessedAgent(?assessTransfer, ?agent, ?C),
    assessmentDimension(?assessTransfer, "https://blackcatinformatics.ca/logic/dimensionTransfer", ?C),
    assessmentLevel(?assessTransfer, ?levelTransfer, ?C),
    assessmentSubject(?assessTransfer, ?subject, ?C),
    levelAtOrAbove(?levelProc, ?thresholdProc, ?C),
    levelAtOrAbove(?levelTransfer, ?thresholdTransfer, ?C),
    hasThresholdRow(?profile, ?rowProc, ?C),
    hasThresholdRow(?profile, ?rowTransfer, ?C),
    projectsLadderEdge(?rowProc, "https://blackcatinformatics.ca/gmeow/hasMastered", ?C),
    sourceDimension(?rowProc, "https://blackcatinformatics.ca/logic/dimensionProceduralCompetence", ?C),
    thresholdLevel(?rowProc, ?thresholdProc, ?C),
    projectsLadderEdge(?rowTransfer, "https://blackcatinformatics.ca/gmeow/hasMastered", ?C),
    sourceDimension(?rowTransfer, "https://blackcatinformatics.ca/logic/dimensionTransfer", ?C),
    thresholdLevel(?rowTransfer, ?thresholdTransfer, ?C).
isAwareOf(?agent, ?subject, ?C) :-
    assessedAgent(?assessment, ?agent, ?C),
    assessmentDimension(?assessment, ?dim, ?C),
    assessmentLevel(?assessment, ?level, ?C),
    assessmentSubject(?assessment, ?subject, ?C),
    levelAtOrAbove(?level, ?threshold, ?C),
    hasThresholdRow(?profile, ?row, ?C),
    projectsLadderEdge(?row, "https://blackcatinformatics.ca/gmeow/isAwareOf", ?C),
    sourceDimension(?row, ?dim, ?C),
    thresholdLevel(?row, ?threshold, ?C).
knowsAbout(?agent, ?subject, ?C) :-
    assessedAgent(?assessment, ?agent, ?C),
    assessmentDimension(?assessment, ?dim, ?C),
    assessmentLevel(?assessment, ?level, ?C),
    assessmentSubject(?assessment, ?subject, ?C),
    levelAtOrAbove(?level, ?threshold, ?C),
    hasThresholdRow(?profile, ?row, ?C),
    projectsLadderEdge(?row, "https://blackcatinformatics.ca/gmeow/knowsAbout", ?C),
    sourceDimension(?row, ?dim, ?C),
    thresholdLevel(?row, ?threshold, ?C).
memberOf(?agent, ?parent, ?C) :-
    memberOf(?agent, ?org, ?C),
    subOrganizationOf(?org, ?parent, ?C).
understands(?agent, ?subject, ?C) :-
    assessedAgent(?assessment, ?agent, ?C),
    assessmentDimension(?assessment, ?dim, ?C),
    assessmentLevel(?assessment, ?level, ?C),
    assessmentSubject(?assessment, ?subject, ?C),
    levelAtOrAbove(?level, ?threshold, ?C),
    hasThresholdRow(?profile, ?row, ?C),
    projectsLadderEdge(?row, "https://blackcatinformatics.ca/gmeow/understands", ?C),
    sourceDimension(?row, ?dim, ?C),
    thresholdLevel(?row, ?threshold, ?C).
observedFeature(?claim, ?position, ?C) :-
    standpointClaim(?tenure, ?claim, ?C),
    tenurePosition(?tenure, ?position, ?C).
vantage(?claim, ?standpoint, ?C) :-
    standpointClaim(?tenure, ?claim, ?C),
    tenureStandpoint(?tenure, ?standpoint, ?C).
indirectContributor(?entity, ?agent, ?C) :-
    wasAssociatedWith(?activity, ?agent, ?C),
    wasGeneratedBy(?entity, ?activity, ?C).
crossNodeGlutWith(?f1, ?f2, ?C) :-
    type(?anchor, "https://blackcatinformatics.ca/gmeow/NonTrivialAnchor", ?C),
    categoryPolarity(?category1, "https://blackcatinformatics.ca/logic/InfoSupported", ?C),
    categoryPolarity(?category2, "https://blackcatinformatics.ca/logic/InfoOpposed", ?C),
    findingAnchor(?f1, ?anchor, ?C),
    findingCategory(?f1, ?category1, ?C),
    findingAnchor(?f2, ?anchor, ?C),
    findingCategory(?f2, ?category2, ?C),
    ?f1 != ?f2.
findingCluster(?finding, ?root, ?C) :-
    findingRootCause(?finding, ?root, ?C).
findingGateVerdict(?finding, "https://blackcatinformatics.ca/gmeow/gateFatal", ?C) :-
    categoryBlocking(?category, "https://blackcatinformatics.ca/gmeow/blockingBlocking", ?C),
    findingCategory(?finding, ?category, ?C),
    findingSeverity(?finding, "https://blackcatinformatics.ca/gmeow/severityError", ?C),
    findingStandpoint(?finding, "https://blackcatinformatics.ca/gmeow/standpointBinding", ?C).
findingHasAntecedent(?finding, ?finding, ?C) :-
    findingAntecedent(?finding, ?antecedent, ?C).
findingRootCause(?finding, ?root, ?C) :-
    findingTraces(?finding, ?root, ?C),
    not findingHasAntecedent(?root, ?root, ?C).
findingTraces(?finding, ?antecedent, ?C) :-
    findingAntecedent(?finding, ?antecedent, ?C).
findingTraces(?finding, ?root, ?C) :-
    findingAntecedent(?finding, ?intermediate, ?C),
    findingTraces(?intermediate, ?root, ?C).
instantiatesWork(?item, ?work, ?C) :-
    realizes(?expression, ?work, ?C),
    exemplifies(?item, ?manifestation, ?C),
    embodies(?manifestation, ?expression, ?C).
type(?root, "https://blackcatinformatics.ca/gmeow/FindingCluster", ?C) :-
    findingRootCause(?finding, ?root, ?C).
type(?root, "https://blackcatinformatics.ca/gmeow/RootFinding", ?C) :-
    findingRootCause(?finding, ?root, ?C).
clusterRoot(?root, ?root, ?C) :-
    findingRootCause(?finding, ?root, ?C).
