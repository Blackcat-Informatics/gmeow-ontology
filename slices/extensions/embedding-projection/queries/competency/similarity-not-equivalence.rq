# CT5 — similarity is not equivalence (violation finder; EMPTY over valid data). A
# gmeow:SimilarityObservation illegitimately PROMOTED to a logical identity —
# canonical identity/equivalence or their OWL views, in either direction. A pairwise similarity
# CLAIM is logic:Vague and never an entailment; the overclaim counter-example makes
# this non-empty, the clean scene keeps it empty.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>

SELECT DISTINCT ?obs WHERE {
  ?obs a gmeow:SimilarityObservation .
  VALUES ?identity { logic:sameAs logic:equivalentClass owl:sameAs owl:equivalentClass }
  {
    { ?obs ?identity ?x } UNION { ?x ?identity ?obs }
  }
}
ORDER BY ?obs
