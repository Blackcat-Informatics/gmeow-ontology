@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .

gmeow:CodecClass
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Codec Class"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The capability class of a transform codec — encode, compress, or encrypt (spec §8). Determines the degradation path when the capability is missing: unknown-codec or missing-key opacity."@x-gmeow-english ;
    skos:example "gmeow:codecClassEncrypt a gmeow:CodecClass ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting classes as subclasses (they are individuals) and avoid using this to name a concrete codec; it is the capability category, while gmeow:TransformCodec names the algorithm."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded classes (encode, compress, encrypt) from a codec via gmeow:codecClass; encrypt-class codecs degrade to missing-key opacity, the others to unknown-codec opacity when a reader lacks the library."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary for codec capability classes — the small set (encode, compress, encrypt) that determines whether a missing capability yields unknown-codec or missing-key opacity."@x-gmeow-english .

gmeow:GTSCompaction
    a logic:Event ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS Compaction"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Activity ;
    skos:definition "An activity that rewrites a GTS document's frame layout — e.g. into delivery order for streaming (spec §3.2) or into a snapshot. Compaction re-authors only the ORDERING: content claims (ordinary quads, including signed statement-level claims) are rewrite-invariant by construction; transport claims over the source chain become detached evidence about the source document. The compacted document gmeow:wasGeneratedBy the compaction and gmeow:wasDerivedFrom the source document, whose segment heads remain citable through gmeow:gtsHeadId. Evidence-profile documents SHOULD NOT be compacted (see shapes); sealing the source verbatim as a nested GTS blob preserves its attestation intact."@x-gmeow-english ;
    skos:example "ex:streamPack gmeow:wasGeneratedBy ex:compact1 . ex:compact1 a gmeow:GTSCompaction ; gmeow:wasDerivedFrom ex:bundle ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for any activity that changes content claims (compaction touches only ordering) and for evidence-profile sources, where re-authoring would detach the third-party transport attestation — seal those verbatim as a nested blob instead."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Link the output with gmeow:wasGeneratedBy and the source with gmeow:wasDerivedFrom; keep the source's segment heads citable through gmeow:gtsHeadId so the old transport claims survive as detached evidence about the source document."@x-gmeow-english ;
    gmeow:useWhen "Use to record that a document was re-laid-out from a source — into streaming delivery order or a snapshot — so the new ordering is traceable to its origin while the carried content stays rewrite-invariant."@x-gmeow-english .

gmeow:GTSDocument
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS Document"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Manifestation ;
    skos:definition "A single-file Graph Transport Substrate artifact (docs/GTS-SPEC.md): a CBOR Sequence of one or more append-only segments carrying an RDF 1.2 graph and any content-addressed binaries it references. A Manifestation in the WEMI sense — the packaged, shippable embodiment. Its composite identity is the ORDERED list of its segments' chain heads (spec §3.1); byte-concatenation of valid documents is a valid document, so a document's segment list grows by append, never by rewrite."@x-gmeow-english ;
    skos:example "ex:bundle a gmeow:GTSDocument ; gmeow:gtsSegment ex:seg0 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a single log within the file (use gmeow:GTSSegment) and for the content claims the document carries (those are ordinary quads); the document is the transport envelope, never the truth of its payload."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Link its ordered segments with gmeow:gtsSegment and read its composite identity off the segment heads (gmeow:gtsHeadId taken in gmeow:gtsSegmentIndex order); record production and compaction lineage with gmeow:wasGeneratedBy / gmeow:wasDerivedFrom rather than on the segments."@x-gmeow-english ;
    gmeow:useWhen "Use to model a whole shippable GTS file as a first-class entity — when you need to talk about the package itself (its segment list, its composite identity, its provenance) rather than the individual frames or the graph it carries."@x-gmeow-english .

gmeow:GTSProfile
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS Profile"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "A named GTS profile (spec §13) — a purpose and requirement set a segment declares. An OPEN value vocabulary (individuals, never subclasses): extensions add their own profiles (e.g. a music package) without touching this module (Principle 9)."@x-gmeow-english ;
    skos:example "ex:musicPackage a gmeow:GTSProfile ; rdfs:label \"music-package profile\"@en ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting profiles as subclasses (they are individuals on an open axis) and avoid using a profile to carry per-frame codec or signer detail; the profile names the requirement set, not the wire format."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Reference a seeded profile individual from a segment via gmeow:gtsProfile, or add a new gmeow:GTSProfile individual in an extension slice; a document's effective profile is the derived union of its segments'."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary for a segment's purpose-and-requirements declaration, or when an extension needs to mint a new packaging profile without editing the core module."@x-gmeow-english .

gmeow:GTSSegment
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS Segment"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Manifestation ;
    skos:definition "One complete header-plus-frames log inside a GTS document — the unit of independent integrity (spec §3.1): a segment has its own genesis hash, its own id/prev chain, its own profile, its own transform catalog, and its own signers. Segments compose by concatenation and never vouch for one another; a third-party segment keeps its third-party attestation. Itself a Manifestation: a segment is a complete, independently shippable artifact."@x-gmeow-english ;
    skos:example "ex:seg0 a gmeow:GTSSegment ; gmeow:gtsSegmentOf ex:bundle ; gmeow:gtsHeadId \"blake3:9f2c…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the whole file (use gmeow:GTSDocument) and for a single frame; never make one segment vouch for another — each keeps its own attestation by design."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Place it in its document with gmeow:gtsSegmentOf, order it with gmeow:gtsSegmentIndex, commit its history with gmeow:gtsHeadId, declare its purpose with gmeow:gtsProfile, and attach signatures as gmeow:hasSignature / gmeow:Attestation whose attestedSubject is this segment."@x-gmeow-english ;
    gmeow:useWhen "Use for one independently-verifiable log within a document — the unit that carries its own chain, profile, codec catalog, and signers, and the subject a transport Attestation vouches for."@x-gmeow-english .

gmeow:OpacityReason
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Opacity Reason"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "Why a frame is opaque to a given reader (spec §7.6) — a missing capability or damage. An open value vocabulary; opacity is vantage-relative, so the reason is a fact about a reader-frame pair, not about the bytes."@x-gmeow-english ;
    skos:example "gmeow:opacityMissingKey a gmeow:OpacityReason ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting reasons as subclasses (they are individuals) and avoid reading a reason as a property of the bytes; it is true of a reader-frame pair, so the same frame may carry no reason at all for a recipient who can decode it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference a seeded reason from a frame via gmeow:opacityReason; pair gmeow:opacityMissingKey with gmeow:sealedRecipient to name the agents for whom the frame is transparent."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary naming why a frame is opaque to a reader — unknown codec, missing key, or damage — the required reason that keeps opacity distinguishable from data loss."@x-gmeow-english .

gmeow:OpaqueFrame
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Opaque Frame"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "A sealed or undecodable region of a GTS segment, surfaced by the reader as a first-class object rather than dropped (spec §7.6): an encrypted frame the reader holds no key for, a frame using a codec the reader lacks, or a damaged frame. Opacity is VANTAGE-RELATIVE epistemic state, not a property of the bytes — the same frame is transparent to a recipient holding the key (standpoint/privacy, Principle 9). The frame's bytes remain present, hash-linked, and chain-verifiable."@x-gmeow-english ;
    skos:example "ex:frame7 a gmeow:OpaqueFrame ; gmeow:opaqueFrameIn ex:seg0 ; gmeow:opacityReason gmeow:opacityMissingKey ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting opacity as a property of the bytes themselves — it is vantage-relative, true only for the describing reader; do not use it for a frame the reader decoded successfully, nor as a privacy classification (that is the kernel sensitivity/disclosure axes)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Anchor it to its segment with gmeow:opaqueFrameIn, state the required gmeow:opacityReason, and for sealed frames list the agents who can decrypt it with gmeow:sealedRecipient so the vantage-relativity is explicit."@x-gmeow-english ;
    gmeow:useWhen "Use when a reader surfaces a frame it cannot decode — sealed without a key, using an unknown codec, or damaged — so the gap is described rather than silently dropped, preserving the chain."@x-gmeow-english .

gmeow:TransformCodec
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Transform Codec"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "A payload transform from the durable GTS catalog (spec §8): a named, stackable codec separating structure durability (CBOR + the spec, forever) from density and confidentiality (swappable codecs). An OPEN value vocabulary tagged by gmeow:codecClass."@x-gmeow-english ;
    skos:example "ex:codecBrotli a gmeow:TransformCodec ; gmeow:codecClass gmeow:codecClassCompress ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting codecs as subclasses (they are individuals) and avoid conflating the transform with the structural format; CBOR and the spec are the durable substrate, codecs are the swappable density/confidentiality layer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Reference a codec from a segment via gmeow:usesTransformCodec and tag every codec with gmeow:codecClass so readers can anticipate the missing-capability degradation path."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary for a payload transform a segment declares in its catalog, or when adding a new codec to the durable catalog as an individual."@x-gmeow-english .

gmeow:codecBase64
    a gmeow:TransformCodec ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "base64 codec"@x-gmeow-english ;
    skos:definition "RFC 4648 base64 re-encoding, for payloads that must transit text-only channels."@x-gmeow-english ;
    gmeow:codecClass gmeow:codecClassEncode ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:codecBase85
    a gmeow:TransformCodec ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "base85 codec"@x-gmeow-english ;
    skos:definition "base85 (Ascii85/Z85-family) re-encoding — denser than base64 for text-only channels."@x-gmeow-english ;
    gmeow:codecClass gmeow:codecClassEncode ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:codecClass
    a owl:ObjectProperty ;
    rdfs:domain gmeow:TransformCodec ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "codec class"@x-gmeow-english ;
    rdfs:range gmeow:CodecClass ;
    skos:definition "The capability class of a transform codec (spec §8): what a reader must hold to reverse it — a library (encode, compress) or a key (encrypt)."@x-gmeow-english ;
    skos:example "ex:codecBrotli gmeow:codecClass gmeow:codecClassCompress ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting more than one class per codec (it is functional) and avoid using it to name the specific algorithm; the class is the capability category, not the codec identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point each gmeow:TransformCodec at one gmeow:CodecClass (encode, compress, or encrypt); readers use it to decide whether a missing capability yields an unknown-codec or a missing-key gmeow:OpaqueFrame."@x-gmeow-english ;
    gmeow:useWhen "Use to tag a transform codec with the capability a reader must hold to reverse it, so the degradation path — unknown-codec vs missing-key opacity — is derivable before decoding."@x-gmeow-english .

gmeow:codecClassCompress
    a gmeow:CodecClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "compress"@x-gmeow-english ;
    skos:definition "A lossless compression transform (gzip, zstd, lzma2): reversal needs only a library."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:codecClassEncode
    a gmeow:CodecClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "encode"@x-gmeow-english ;
    skos:definition "A reversible re-encoding (identity, base64, base85): reversal needs only a library; no information is hidden or removed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:codecClassEncrypt
    a gmeow:CodecClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "encrypt"@x-gmeow-english ;
    skos:definition "A confidentiality transform (COSE encryption): reversal needs a key; without one the frame degrades to missing-key opacity for that reader."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:codecCoseEncrypt0
    a gmeow:TransformCodec ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "COSE Encrypt0 codec"@x-gmeow-english ;
    skos:definition "RFC 9052 COSE_Encrypt0 sealing: the payload is encrypted to declared recipients; readers without a key see a missing-key opaque frame."@x-gmeow-english ;
    gmeow:codecClass gmeow:codecClassEncrypt ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:codecGzip
    a gmeow:TransformCodec ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "gzip codec"@x-gmeow-english ;
    skos:definition "RFC 1952 gzip compression."@x-gmeow-english ;
    gmeow:codecClass gmeow:codecClassCompress ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:codecIdentity
    a gmeow:TransformCodec ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "identity codec"@x-gmeow-english ;
    skos:definition "The identity transform: payload bytes pass through unchanged."@x-gmeow-english ;
    gmeow:codecClass gmeow:codecClassEncode ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:codecLzma2
    a gmeow:TransformCodec ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "lzma2 codec"@x-gmeow-english ;
    skos:definition "LZMA2 (xz) compression — higher ratio, slower, for archival density."@x-gmeow-english ;
    gmeow:codecClass gmeow:codecClassCompress ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:codecZstd
    a gmeow:TransformCodec ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "zstd codec"@x-gmeow-english ;
    skos:definition "RFC 8878 Zstandard compression — the GTS workhorse compressor."@x-gmeow-english ;
    gmeow:codecClass gmeow:codecClassCompress ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsHeadId
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:GTSSegment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS head id"@x-gmeow-english ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf gmeow:versionFingerprint ;
    skos:definition "The chain head of a segment — the content-id of its last frame, written 'blake3:<hex>'. Transitively commits to the segment's entire history (spec §9.1), making it a version fingerprint of the segment rather than a digest of its bytes: hence a subproperty of gmeow:versionFingerprint, distinct from gmeow:contentDigest (which is byte-exact identity and applies to the file or a blob as a whole). Functional: a segment has exactly one head. It is also the key of a gmeow:GTSSegment (carried by the logic:KeyAssertion gmeow:gtsSegmentHeadKey): the head is a BLAKE3 content-id committing transitively to the segment's whole frame history, so two distinct segments sharing a head would be a full-history BLAKE3 collision — impossible by construction; the head therefore uniquely identifies its segment (content-addressing IS the identity). The datatype key is carried by a logic:KeyAssertion (the logic: analogue of owl:hasKey, OWL 2 DL) rather than an inverse-functional characteristic (which on a datatype property would be OWL 2 Full)."@x-gmeow-english ;
    skos:example "ex:seg0 gmeow:gtsHeadId \"blake3:9f2c4e…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for byte-exact identity of the file or a blob (use gmeow:contentDigest) and avoid asserting more than one head per segment; the head is functional and commits transitively to the chain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Record the last frame's content-id as 'blake3:<hex>'; order heads by gmeow:gtsSegmentIndex to form the document's identity, and keep the head on a derived-from source so old transport claims stay citable after compaction."@x-gmeow-english ;
    gmeow:useWhen "Use to commit to a segment's entire history with a single chain head — the version-fingerprint identity used to cite a segment, build a document's composite identity, or keep a compaction source citable."@x-gmeow-english .

gmeow:gtsProfile
    a owl:ObjectProperty ;
    rdfs:domain gmeow:GTSSegment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS profile"@x-gmeow-english ;
    rdfs:range gmeow:GTSProfile ;
    skos:definition "The declared profile of a segment (spec §13) — a value vocabulary individual naming the segment's purpose and requirement set. Functional per segment; a multi-segment DOCUMENT's effective requirement set is the union of its segments' profiles (spec §3.1) and is derived, never asserted."@x-gmeow-english ;
    skos:example "ex:seg0 gmeow:gtsProfile gmeow:gtsProfileDist ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting a profile on the whole document (the document's effective profile is the derived union of its segments') and avoid declaring more than one per segment; the property is functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point the segment at one gmeow:GTSProfile individual; for a multi-segment document, compute the effective requirement set as the union of segment profiles rather than asserting it, and let extensions mint new profile individuals without editing this module."@x-gmeow-english ;
    gmeow:useWhen "Use to declare a segment's purpose and requirement set — distribution snapshot, evidence exhibit, ai-package, bundle, and so on — so readers know which reader contract the segment expects."@x-gmeow-english .

gmeow:gtsProfileAiPackage
    a gmeow:GTSProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "ai-package profile"@x-gmeow-english ;
    skos:definition "Agent-memory package profile: grounded knowledge plus provenance and standpoints, packaged for AI-agent consumption — the GMEOW dogfood profile."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProfileBundle
    a gmeow:GTSProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "bundle profile"@x-gmeow-english ;
    skos:definition "Composition profile: a document whose payloads include nested, independently sealed GTS documents (matryoshka, spec §12.1)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProfileDist
    a gmeow:GTSProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dist profile"@x-gmeow-english ;
    skos:definition "Distribution snapshot profile: a statement-complete, reasoned graph packaged for consumption — the shipping form of an ontology or dataset."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProfileEvidence
    a gmeow:GTSProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "evidence profile"@x-gmeow-english ;
    skos:definition "Evidentiary profile: every frame signed, chain of custody preserved; the package is an attestation-bearing exhibit. Compaction is contraindicated (see shapes) — re-authoring the ordering would detach the third-party transport attestation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxCBox ,
        gmeow:boxConfigBox .

gmeow:gtsProfileGeneric
    a gmeow:GTSProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "generic profile"@x-gmeow-english ;
    skos:definition "The default GTS profile: no requirements beyond the baseline reader contract."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProfileImage
    a gmeow:GTSProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "image profile"@x-gmeow-english ;
    skos:definition "Media-carriage profile: content-addressed media blobs with graph-side descriptions and progressive (catalog-before-bytes) delivery ordering (spec §3.2)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProfileOpaque
    a gmeow:GTSProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "opaque profile"@x-gmeow-english ;
    skos:definition "Selective-disclosure profile: substantive payloads sealed to named recipients; the describing reader sees structure, signers, and recipients but not content."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsSegment
    a owl:ObjectProperty ;
    rdfs:domain gmeow:GTSDocument ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS segment"@x-gmeow-english ;
    rdfs:range gmeow:GTSSegment ;
    owl:inverseOf gmeow:gtsSegmentOf ;
    skos:definition "A segment of this GTS document — the inverse of gmeow:gtsSegmentOf. Non-functional: a document holds one or more segments, ordered by gmeow:gtsSegmentIndex."@x-gmeow-english ;
    skos:example "ex:bundle gmeow:gtsSegment ex:seg0, ex:seg1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid relying on it for segment order (that is gmeow:gtsSegmentIndex) and avoid asserting it directly when minting a segment; prefer stating gmeow:gtsSegmentOf and reading this as its inverse."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Assert gmeow:gtsSegmentOf from each segment and read gmeow:gtsSegment as the inverse; pair with gmeow:gtsSegmentIndex to recover the file order that fixes the document's composite identity."@x-gmeow-english ;
    gmeow:useWhen "Use in document-rooted projections and traversals — when enumerating a document's segments from the document side is the natural direction to state or query."@x-gmeow-english .

gmeow:gtsSegmentIndex
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:GTSSegment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS segment index"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The zero-based position of a segment within its document's file order. The ordered list of segment heads — gmeow:gtsHeadId taken in gmeow:gtsSegmentIndex order — IS the document's composite identity (spec §3.1)."@x-gmeow-english ;
    skos:example "ex:seg0 gmeow:gtsSegmentIndex 0 . ex:seg1 gmeow:gtsSegmentIndex 1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid as a stable name or version commitment (use gmeow:gtsHeadId) and avoid leaving gaps or duplicates within a document; the indices are a dense zero-based sequence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Assign each segment a non-negative integer index in append order; read gmeow:gtsHeadId in index order to recover the ordered head list that IS the document's identity."@x-gmeow-english ;
    gmeow:useWhen "Use to fix a segment's place in its document's append-only file order — the index that, taken over the segment heads, reconstructs the document's composite identity."@x-gmeow-english .

gmeow:gtsSegmentOf
    a owl:ObjectProperty ;
    rdfs:domain gmeow:GTSSegment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS segment of"@x-gmeow-english ;
    rdfs:range gmeow:GTSDocument ;
    rdfs:subPropertyOf gmeow:partOf ;
    skos:definition "The GTS document a segment is part of. Functional: a segment instance belongs to one document (the same bytes appearing in another file are a different segment instance of the same content). A subproperty of gmeow:partOf, so disclosure coarsening walks it by default."@x-gmeow-english ;
    skos:example "ex:seg0 gmeow:gtsSegmentOf ex:bundle ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reusing one segment instance across documents (it is functional — the same bytes elsewhere are a distinct instance) and avoid asserting the document-rooted direction here (use gmeow:gtsSegment for that)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point the segment at its single document; the inverse gmeow:gtsSegment and the generic gmeow:partOf follow automatically, so generic part/whole consumers and disclosure coarsening walk it without extra assertion."@x-gmeow-english ;
    gmeow:useWhen "Use to assert which document a segment belongs to — the segment-rooted direction of the document/segment parthood, the natural one to state when minting a segment."@x-gmeow-english .

gmeow:opacityDamaged
    a gmeow:OpacityReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "damaged"@x-gmeow-english ;
    skos:definition "The frame failed its self-hash check or its payload would not decode — content corruption, detected and surfaced rather than dropped."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:opacityMissingKey
    a gmeow:OpacityReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "missing key"@x-gmeow-english ;
    skos:definition "The frame is sealed with an encrypt-class codec and the reader holds no key for it; the declared recipients (gmeow:sealedRecipient) can decrypt it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:opacityReason
    a owl:ObjectProperty ;
    rdfs:domain gmeow:OpaqueFrame ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "opacity reason"@x-gmeow-english ;
    rdfs:range gmeow:OpacityReason ;
    skos:definition "Why a frame is opaque to the describing reader (spec §7.6): an encrypt-class codec without a key, a codec the reader lacks, or damage. Functional and REQUIRED (see shapes): opacity without a stated reason is indistinguishable from data loss."@x-gmeow-english ;
    skos:example "ex:frame7 gmeow:opacityReason gmeow:opacityMissingKey ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid omitting it on any opaque frame and avoid stacking several reasons (it is functional — one reason per reader-frame pair); the reason is relative to the describing reader, not a property of the bytes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the gmeow:OpaqueFrame at exactly one gmeow:OpacityReason; for missing-key opacity, pair it with gmeow:sealedRecipient to name the agents for whom the frame is not opaque at all."@x-gmeow-english ;
    gmeow:useWhen "Use whenever a frame is surfaced as opaque — it is required, because a stated reason (missing key, unknown codec, damage) is what distinguishes a deliberately sealed or unreadable frame from silent data loss."@x-gmeow-english .

gmeow:opacityUnknownCodec
    a gmeow:OpacityReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "unknown codec"@x-gmeow-english ;
    skos:definition "The frame's transform chain names a codec the reader has no library for."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:opaqueFrameIn
    a owl:ObjectProperty ;
    rdfs:domain gmeow:OpaqueFrame ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "opaque frame in"@x-gmeow-english ;
    rdfs:range gmeow:GTSSegment ;
    rdfs:subPropertyOf gmeow:partOf ;
    skos:definition "The GTS segment an opaque frame belongs to. Functional: a frame occupies one position in one segment's chain."@x-gmeow-english ;
    skos:example "ex:frame7 gmeow:opaqueFrameIn ex:seg0 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing one frame at several segments (it is functional — a frame holds one position in one chain) and avoid using it for transparent frames, which need no opacity record."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point the gmeow:OpaqueFrame at its segment; as a subproperty of gmeow:partOf the frame is part of the segment for generic consumers, and you then state its required gmeow:opacityReason."@x-gmeow-english ;
    gmeow:useWhen "Use to anchor an opaque frame to the single segment whose chain it occupies — so the undecodable region is located within transport structure rather than floating free."@x-gmeow-english .

gmeow:sealedRecipient
    a owl:ObjectProperty ;
    rdfs:domain gmeow:OpaqueFrame ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "sealed recipient"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "An agent for whom a sealed (encrypted) opaque frame is decryptable — the frame's declared audience (spec §9.3 recipients). Non-functional: a frame may be sealed to several recipients. The vantage-relativity of opacity made explicit: for these agents the frame is not opaque at all."@x-gmeow-english ;
    skos:example "ex:frame7 gmeow:sealedRecipient ex:lillith, ex:auditor ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for frames opaque through an unknown codec or damage (no recipient resolves those) and avoid treating it as an access-control grant; it describes who can decode, not a privacy-disclosure decision (that is the kernel sensitivity/disclosure axes)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "List one or more gmeow:Agent recipients on a frame whose gmeow:opacityReason is gmeow:opacityMissingKey; the same frame stays opaque to every reader not on the list."@x-gmeow-english ;
    gmeow:useWhen "Use on a sealed (encrypt-class) opaque frame to name the agents who hold a key and can decrypt it — making explicit that opacity is vantage-relative and the frame is transparent to them."@x-gmeow-english .

gmeow:usesTransformCodec
    a owl:ObjectProperty ;
    rdfs:domain gmeow:GTSSegment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "uses transform codec"@x-gmeow-english ;
    rdfs:range gmeow:TransformCodec ;
    skos:definition "A transform codec declared in a segment's catalog and used by at least one of its frames (spec §8). Non-functional: payloads carry stackable codec chains."@x-gmeow-english ;
    skos:example "ex:seg0 gmeow:usesTransformCodec gmeow:codecZstd, gmeow:codecCoseEncrypt0 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating it as a single codec per segment (payloads stack chains, so it is non-functional) and avoid using it to describe a single frame's exact codec stack; it is the segment-level catalog-in-use."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "List each gmeow:TransformCodec the segment uses; read each codec's gmeow:codecClass to anticipate the degradation path — unknown-codec or missing-key opacity — when a capability is absent."@x-gmeow-english ;
    gmeow:useWhen "Use to record which catalog codecs a segment's frames actually employ — so a reader can tell, before decoding, which libraries or keys it must hold to read the segment."@x-gmeow-english .

<https://blackcatinformatics.ca/gmeow/slices/gts>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Transport/packaging vocabulary so GMEOW can DESCRIBE and dogfood its own
transport: a GTS file (docs/GTS-SPEC.md) as a first-class entity — its segments, profiles,
chain heads, transform codecs, opaque (sealed/undecodable) frames, and compaction lineage.

MODEL BOUNDARIES (Principles 1, 9, 12).
- GTS gives TRANSPORT claims (these bytes, this order, this chain); GMEOW gives CONTENT
  claims (this statement is true, according to whom). A frame signature or head commitment
  is an Attestation whose attestedSubject is a GTSSegment; it proves bytes/order/signer key
  control, never the truth of the carried statements.
- Compaction re-authors only the ORDERING: content claims ride as ordinary quads and are
  rewrite-invariant by construction; transport claims over the old chain become detached
  evidence about the source document, cited through the compaction's derivation lineage.
- Fold semantics, codec reversal, hash verification, and signature checking live in the
  solver layer (the gts engines); this module only describes their artifacts and outcomes.

REUSE (no parallel mechanisms — GTS transport design).
- Byte identity of blobs and files     -> gmeow:contentDigest (sources).
- Chain-head identity of a segment     -> gmeow:gtsHeadId, a versionFingerprint (versions).
- Frame/head signatures, signers       -> gmeow:hasSignature / gmeow:Attestation (attestation).
- Compaction and production lineage    -> gmeow:wasGeneratedBy / wasDerivedFrom (provenance).
- Suppress frames                      -> gmeow:displayable (kernel, P10) — suppression is a
  display overlay, never erasure, in the format AND in the ontology.
- annot-frame standpoints              -> gmeow:accordingTo / standpointModality (standpoint).
- Media payloads                       -> gmeow:MediaObject (documents) carried as blobs."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GMEOW GTS Transport Module"@x-gmeow-english ;
    skos:definition "The GMEOW GTS Transport Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Declarative constraint axioms — the closed-world cardinality / class /
# datatype / pattern obligations of the slice, authored here ONCE as OWL
# restriction axioms and PROJECTED to generated/shapes/validation-shapes.ttl by
# derive_validation_shapes (Principle 17). This module is the single source of
# truth: the slice ships NO hand-authored shapes.ttl (docs/MIGRATING-SHAPES-TO-
# LOGIC.md). A restriction carrying both owl:*Cardinality and owl:allValuesFrom
# lowers to the paired sh:minCount/maxCount + sh:class / sh:datatype property
# shape. The cross-node / disjunctive (sh:sparql) conditions have no OWL
# antecedent and are authored as logic:Constraints below.
# =========================================================================== #

gmeow:OpaqueFrame logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:opacityReason ; logic:allValuesFrom gmeow:OpacityReason ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:opaqueFrameIn ; logic:allValuesFrom gmeow:GTSSegment ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:OpaqueFrame ; logic:closureKey "https://blackcatinformatics.ca/gmeow/opacityReason" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:OpaqueFrame ; logic:closureKey "https://blackcatinformatics.ca/gmeow/opaqueFrameIn" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:GTSSegment rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:gtsHeadId ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:gtsSegmentIndex ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:gtsProfile ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:GTSProfile ] .

# A chain head is written 'blake3:<64 lowercase hex>' — the lexical form of the
# content-id the whole segment history commits to. A free-form head is
# indistinguishable from a truncated or foreign digest, so the shape of the string
# is part of the claim.
#
# The obligation is stated ONCE, as logic:GtsHeadIdCanonicalConstraint above: a
# class-scoped logic:StringPatternConstraint (logic:onClass gmeow:GTSSegment,
# logic:valuePath gmeow:gtsHeadId). Being class-scoped it lowers BOTH ways from that
# single record — declaratively to a sh:pattern component on the derived
# gmeow:GTSSegment node shape, and procedurally to its sh:sparql twin.
#
# There is deliberately NO owl:withRestrictions datarange beside it. A datatype facet
# is the only OTHER thing the shape deriver reads for a pattern, but authoring one is
# not free: a LIVE pattern facet is outside the fragment the native reasoner decides
# (XSD's regular-expression dialect is not the host engine's, so refute::datatype
# withholds rather than guess), and one undecided facet family makes `make
# reason-verify` refuse a consistency verdict for the WHOLE ontology. Deriving the
# component from the logic: constraint keeps the obligation, keeps one authored
# source, and leaves the reasoned closure in-fragment.

# exact-one minCount restoration: min-qualified sibling restrictions
# restoring sh:minCount for the reasoner-safe max-qualified exact-one antecedents.
<https://blackcatinformatics.ca/gmeow/GTSSegment> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/gtsHeadId> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onDataRange> <http://www.w3.org/2001/XMLSchema#string> ] .
<https://blackcatinformatics.ca/gmeow/GTSSegment> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/gtsSegmentIndex> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onDataRange> <http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ] .
<https://blackcatinformatics.ca/gmeow/GTSSegment> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/gtsProfile> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/gmeow/GTSProfile> ] .

# =========================================================================== #
# Procedural constraints — the two cross-node conditions with no OWL           #
# antecedent, authored as canonical logic:Constraints (Principle 17) and       #
# lowered to sh:SPARQLConstraint node shapes in                                #
# generated/shapes/procedural-constraints.ttl. They are the SOLE authority for #
# these checks: the hand-authored shapes.ttl that once carried them is retired #
# (equivalence proved by crates/logic-compile/tests/shape_migration_           #
# equivalence.rs, which validates a pass/fail witness pair against the real    #
# projection of each record).                                                  #
# =========================================================================== #

logic:SealedFrameRecipientConstraint
    a logic:GuardedImplicationConstraint ;
    rdfs:label "Sealed-frame recipient constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a missing-key gmeow:OpaqueFrame names at least one gmeow:sealedRecipient — opacity is vantage-relative, so sealed content carries a declared audience (GTS spec §9.3)."@x-gmeow-english ;
    logic:onClass gmeow:OpaqueFrame ;
    logic:trigger gmeow:opacityReason ;
    logic:triggerValue gmeow:opacityMissingKey ;
    logic:requires gmeow:sealedRecipient ;
    logic:formalizes gmeow:SealedFrameRecipientShape ;
    logic:message "A missing-key opaque frame must name at least one gmeow:sealedRecipient — sealed content has a declared audience." .

logic:EvidenceCompactionConstraint
    a logic:Constraint ;
    rdfs:label "Evidence-profile compaction constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity warning: an evidence-profile gmeow:GTSDocument should not be generated by a gmeow:GTSCompaction — compaction re-authors the segment ordering and detaches the third-party transport attestation (GTS spec §12.1)."@x-gmeow-english ;
    logic:severity "Warning" ;
    logic:formalizes gmeow:EvidenceCompactionShape ;
    logic:message "An evidence-profile GTS document should not be generated by a GTSCompaction — compaction re-authors the ordering and detaches third-party transport attestation." ;
    logic:integrity logic:evcForall .
logic:evcForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:evcImpl .
logic:evcImpl a logic:Formula ; logic:antecedent logic:evcGuard ; logic:consequent logic:evcNot .
logic:evcGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:GTSDocument ] .
logic:evcNot a logic:Formula ; logic:not logic:evcEx .
logic:evcEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "segment" ] , [ logic:termIndex 1 ; logic:termVariable "activity" ] ;
    logic:exists logic:evcBody .
logic:evcBody a logic:Formula ; logic:and logic:evcSegOf , logic:evcProfile , logic:evcGenBy , logic:evcCompaction .
logic:evcSegOf a logic:Formula ; logic:relation gmeow:gtsSegmentOf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "segment" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:evcProfile a logic:Formula ; logic:relation gmeow:gtsProfile ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "segment" ] , [ logic:termIndex 1 ; logic:termIri gmeow:gtsProfileEvidence ] .
logic:evcGenBy a logic:Formula ; logic:relation gmeow:wasGeneratedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "activity" ] .
logic:evcCompaction a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "activity" ] , [ logic:termIndex 1 ; logic:termIri gmeow:GTSCompaction ] .

# =========================================================================== #
# GTS head-id canonical pattern constraint: the sh:pattern residue of          #
# gmeow:GTSSegmentShape (spec §9.1) has no OWL antecedent (regex is out of     #
# EL), so it grounds as a string-pattern residue, matching the idiom already   #
# used for lang:GmnCodepointCanonicalConstraint (the U+XXXX codepoint pattern).#
# =========================================================================== #

gmeow:GtsHeadIdCanonicalConstraint
    a logic:StringPatternConstraint ;
    rdfs:label "GTS head-id canonical pattern constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:gtsHeadId value must be canonical — the literal 'blake3:' prefix followed by exactly 64 lowercase hex digits (GTS spec §3.1, §9.1)."@x-gmeow-english ;
    logic:onClass gmeow:GTSSegment ;
    logic:valuePath gmeow:gtsHeadId ;
    logic:stringOp "regexRequired" ;
    logic:stringPattern "^blake3:[0-9a-f]{64}$" ;
    logic:formalizes gmeow:GTSSegmentShape ;
    logic:message "A gmeow:gtsHeadId value must match '^blake3:[0-9a-f]{64}$' — the canonical blake3 content-id form." .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/GTSSegment> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/gtsHeadId> ; owl:someValuesFrom <http://www.w3.org/2001/XMLSchema#string> ] .
<https://blackcatinformatics.ca/gmeow/GTSSegment> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/gtsProfile> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/GTSProfile> ] .
<https://blackcatinformatics.ca/gmeow/GTSSegment> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/gtsSegmentIndex> ; owl:someValuesFrom <http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ] .

# =========================================================================== #
# THE MEDIUM AXIS — a medium is a lawful (encode, decode) PAIR                 #
# =========================================================================== #
#
# A gmeow:Medium is NOT a zstd configuration record. It is a section/retraction
# pair (enc, dec) with dec ∘ enc = id on a DECLARED content domain, and it
# carries that claim as a logic:Correspondence (gmeow:mediumCorrespondence),
# never as a boolean "lossless" flag. gmeow:ZstdDictMedium is the zstd
# specialization; the medium's identity is the LAW, the codec/level/dictionary
# are its coordinates.
#
# The medium axis and the GMN DIALECT axis share NO vocabulary: nothing here is
# a gmeow:gmn* term, and nothing here re-mints a dialect coordinate. A medium
# governs the bytes of a frame's payload; a dialect governs the notation of a
# document.
#
# AUTHORED vs GENERATED is a deliberate class split. gmeow:CompressionDictionary
# is the AUTHORED definition (id, version, strategy family, corpus);
# gmeow:CompressionDictionaryRealization is the GENERATED realization (content
# digest, byte length, zstd Dictionary_ID, measured strategy, measured target
# length) and lives in the build-time graph/medium-registry, never authored by
# hand. Requiring a content digest on an AUTHORED individual would be an
# unsatisfiable obligation — the digest is a build product, and a definition that
# cannot exist before its own realization is a modelling error, not a strict
# contract.
#
# Every declarative obligation below is authored in the CANONICAL logic:
# restriction vocabulary (logic:subClassOf / logic:Restriction / logic:onProperty
# / logic:onClass / logic:allValuesFrom). The rdfs:/owl: spelling is the derived
# PROJECTION of these axioms, not a second source: authoring it by hand here
# would be ungrounded structural residue against this slice's projection-vocabulary
# ceiling. The slice ships NO shapes.ttl (docs/MIGRATING-SHAPES-TO-LOGIC.md).

gmeow:CompressionDictionary
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Compression Dictionary"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The AUTHORED definition of a zstd compression dictionary: its stable id (gmeow:dictionaryId), its version (gmeow:dictionaryVersion), the strategy family it is built under (gmeow:dictionaryStrategy), the target dictionary size (gmeow:dictionaryTargetLength), and the gmeow:DictionaryCorpus it trains over (gmeow:trainsOverCorpus). AUTHORED FIELDS ONLY — deliberately no content digest, no byte length, and no zstd Dictionary_ID: those are build products and live on gmeow:CompressionDictionaryRealization. A cardinality obligation requiring a digest on an authored individual would be UNSATISFIABLE (the digest cannot exist before the dictionary is trained), so the definition/realization split is what keeps every declared obligation on both classes discharged rather than aspirational. A dictionary is version-pinned: a dictionary id without its version does not identify a decodable dictionary, because a zstd dictionary is a verbatim substring table of its training corpus and two versions of the same id share no guarantee."@x-gmeow-english ;
    skos:example "gmeow:dictGmeowCoreV1 a gmeow:CompressionDictionary ; gmeow:dictionaryId \"gmeow-core-v1\" ; gmeow:trainsOverCorpus gmeow:corpusGmeowCoreV1 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this class covers the AUTHORED coordinates of one (id, version) dictionary and nothing a build produces. It does not cover the trained bytes, their digest, their length, or their zstd Dictionary_ID (all gmeow:CompressionDictionaryRealization), it does not cover the material trained over (that is the gmeow:DictionaryCorpus it points at), and it does not cover whether the dictionary earns the bytes it costs (that is gmeow:MediumDictionaryEffectMeasurement) — widening it to hold a measured field would make its own cardinality obligations unsatisfiable rather than merely redundant."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid asserting a content digest, byte length, or zstd Dictionary_ID here (those are gmeow:CompressionDictionaryRealization fields, produced by the build) and avoid minting a dictionary with no gmeow:trainsOverCorpus — an untrained dictionary id names nothing a decoder can resolve."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Mint one individual per (id, version) pair carrying exactly one gmeow:dictionaryId, one gmeow:dictionaryVersion, one gmeow:dictionaryStrategy, one gmeow:dictionaryTargetLength, and one gmeow:trainsOverCorpus; the build emits the matching gmeow:CompressionDictionaryRealization and links it back with gmeow:realizesDictionary."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare a dictionary the bundle ships — the authored half of the definition/realization split, the half a human writes and a review can read without running the build."@x-gmeow-english .

gmeow:CompressionDictionaryRealization
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Compression Dictionary Realization"@x-gmeow-english ;
    logic:subClassOf gmeow:Manifestation ;
    skos:definition "The GENERATED realization of a gmeow:CompressionDictionary: the trained bytes and everything measurable only after training — gmeow:dictionaryContentDigest (byte-exact identity), gmeow:dictionaryByteLength, the zstd Dictionary_ID the frame header cites (gmeow:zstdDictionaryId), and the three MEASURED facts about the run that produced them: gmeow:measuredDictionaryStrategy, gmeow:measuredDictionaryTargetLength, and gmeow:measuredCorpusSampleCount. Those three carry their OWN predicates rather than repeating the authored gmeow:dictionaryStrategy / gmeow:dictionaryTargetLength: the authored pair is the DECLARED target a human writes down, the measured pair is the committed-sweep winner the build actually trained at, and spelling both with one predicate left a divergence between them nowhere to be recorded. It lives in the build-time graph/medium-registry named graph and is NEVER hand-authored; a hand-written realization would be a second source of truth for bytes the build already owns. A Manifestation in the WEMI sense: the packaged, shippable embodiment of the authored definition it gmeow:realizesDictionary."@x-gmeow-english ;
    skos:example "ex:realCoreV1 a gmeow:CompressionDictionaryRealization ; gmeow:realizesDictionary gmeow:dictGmeowCoreV1 ; gmeow:dictionaryContentDigest \"blake3:9f2c…\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this class covers ONE build's trained bytes for ONE authored definition — the fields that exist only after training. It is not the declaration those bytes answer to (gmeow:CompressionDictionary), not the verdict on whether shipping them is worthwhile (gmeow:MediumDictionaryEffectMeasurement, which prices the DEFINITION over a declared population), and not the per-frame record of a payload primed with them (gmeow:MediumEnvelope). Hand-authoring one would put a second source of truth beside bytes the build already owns."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid authoring one by hand (it is a build product of the medium-registry pass) and avoid using it where the authored definition is meant — a realization is bytes, gmeow:CompressionDictionary is the declaration those bytes answer to."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Read it from graph/medium-registry; follow gmeow:realizesDictionary back to the authored gmeow:CompressionDictionary and compare gmeow:dictionaryVersion — a realization whose version its definition no longer declares is an orphaned emission (gmeow:MediumDictionaryRegression)."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to describe the trained bytes of a shipped dictionary — the measured half of the definition/realization split, the half only the build can fill in."@x-gmeow-english .

gmeow:DictionaryCorpus
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Dictionary Corpus"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The DECLARATIVE selector naming the sample set a gmeow:CompressionDictionary trains over: blob representations (gmeow:corpusSelectsBlobRep), named graphs (gmeow:corpusSelectsGraph), repository path prefixes (gmeow:corpusSelectsPathPrefix), and pipeline stage products (gmeow:corpusSelectsStageProduct). A selector, never a materialized file list: the corpus is re-resolved on every build, so a new archive member joins its dictionary's corpus without an authoring edit. EVERY shipped corpus is BUNDLE-INTERNAL — it selects only material the bundle itself already carries. An ARCHIVE-BACKED corpus is resolved under the declared gmeow:CorpusTrainingSplit before it reaches the trainer: the split withholds a content-addressed share of the archive's members, so the tar the dictionary is later evaluated over contains members it never trained on."@x-gmeow-english ;
    skos:example "gmeow:corpusGmeowCoreV1 a gmeow:DictionaryCorpus ; gmeow:corpusSelectsBlobRep \"cells-archive\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this class covers the SELECTOR — the declarative statement of which bundle-internal material is in scope for training — and nothing about the resolution of it. It does not cover how many samples a build actually handed the trainer (gmeow:measuredCorpusSampleCount), the identity of that resolution (gmeow:measuredCorpusDigest), or which share of it is withheld from the trainer (gmeow:CorpusTrainingSplit). Enumerating concrete files here would turn a re-resolvable selector into a frozen manifest."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid selecting anything outside the bundle — most importantly a user's runtime store — and avoid enumerating concrete files: a corpus is a selector re-resolved per build, not a frozen manifest."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Mint one corpus per dictionary and give it at least one selector; a dictionary points at it with gmeow:trainsOverCorpus, and the trainer resolves the selectors against the carrier at build time."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare, as data, WHICH bundle-internal material a dictionary is trained on — so the training set is reviewable, re-resolvable, and provably bundle-internal."@x-gmeow-english .

gmeow:CorpusTrainingSplit
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Corpus Training Split"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The DECLARED rule that partitions an archive-backed gmeow:DictionaryCorpus into the members a dictionary is TRAINED on and the members it is HELD OUT from. It exists because an archive-backed corpus selects an archive's members while the frame the dictionary is evaluated over is the TAR OF THOSE MEMBERS: trained on all of them, such a dictionary would be scored on bytes it had memorised. The rule is a STRIDE over the corpus's members ranked by their OWN CONTENT DIGEST — one member in every gmeow:splitHeldOutStride, at position gmeow:splitHeldOutOffset within each stride, is withheld — so the partition is reproducible from the corpus alone, without a manifest, by anyone: nothing about the archive's order, its member names, or the build machine enters it. A stride over RANKS rather than over digest VALUES is what makes properness a theorem instead of a probability, which matters because the shipped claim corpus is four members and a residue rule would hold nothing out of it most of the time. Exactly ONE individual governs EVERY archive-backed corpus: a per-corpus knob would be a per-dictionary carve-out with extra steps, since the dictionary whose evaluation most needs an unseen member is exactly the one whose author would be tempted to widen its own training set. Two declared splits are a HARD FAIL (which members a dictionary never saw would have two answers), and so is a corpus whose archive population the split does not partition — nothing held out would evaluate a dictionary on the bytes it memorised, and nothing trained would leave it with no dictionary at all."@x-gmeow-english ;
    skos:example "gmeow:corpusTrainingSplitV1 a gmeow:CorpusTrainingSplit ; gmeow:splitHeldOutStride 8 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this class covers the single train/hold-out PARTITION RULE over archive-backed corpora and nothing else. It does not say what a corpus contains (gmeow:DictionaryCorpus does), does not name the body of bytes a reading was priced over (gmeow:MediumMeasurementPopulation does), and is not a claim that a dictionary-effect evaluation is held out — the evaluated frame still carries the trained members, and only the withheld share is unseen."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid declaring a second one (the split is ONE rule over EVERY archive-backed corpus), avoid keying it on anything but member CONTENT — a member NAME, an archive order, or a build-machine value would make the partition unreproducible — and avoid reading the split as evidence that the EVALUATION is held out: the frame is mostly training material, and only the held-out share is unseen."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Declare exactly one individual carrying one gmeow:splitHeldOutStride and one gmeow:splitHeldOutOffset; the trainer applies it once to the union of a corpus's gmeow:corpusSelectsBlobRep resolutions, and the resulting held-out cardinality is recorded beside every dictionary-effect reading."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to state, as data, which share of an archive-backed corpus a dictionary is never trained on — the fact that makes 'the evaluation includes members this dictionary never saw' a checkable claim rather than a hope."@x-gmeow-english .

gmeow:DictionaryStrategy
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Dictionary Strategy"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "The family a compression dictionary is built under — trained (the zstd COVER/fastCover trainer), raw-content (a hand-chosen byte prefix used verbatim as the dictionary), or term-table (a dictionary synthesized from the ontology's own term vocabulary). An OPEN value vocabulary (individuals, never subclasses). The strategy is BOTH an authored intent on gmeow:CompressionDictionary (through gmeow:dictionaryStrategy) and a MEASURED fact on gmeow:CompressionDictionaryRealization (through gmeow:measuredDictionaryStrategy): a build that trained at a strategy other than the declared one must say so, because the three produce different decode-side expectations."@x-gmeow-english ;
    skos:example "gmeow:dictStrategyTrained a gmeow:DictionaryStrategy ."@x-gmeow-english ;
    skos:scopeNote "Scope: this vocabulary covers the BUILD-FAMILY axis of a dictionary — how its bytes were arrived at — and no other coordinate. It does not carry the requested or achieved size (gmeow:dictionaryTargetLength, gmeow:dictionaryByteLength), the codec that later consumes the dictionary (gmeow:TransformCodec), or the medium that primes with it. A member is referenced from two different predicates, one authored and one measured, and the vocabulary itself takes no position on which of the two a given assertion is."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid minting strategies as subclasses (they are individuals on an open axis) and avoid reading the authored strategy as the measured one — a realization states what the trainer ACTUALLY produced, under its own gmeow:measuredDictionaryStrategy."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Reference a seeded strategy individual from a gmeow:CompressionDictionary through gmeow:dictionaryStrategy (intent) and from its gmeow:CompressionDictionaryRealization through gmeow:measuredDictionaryStrategy (measurement)."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use as the value vocabulary for how a dictionary was built, on both the authored declaration and the generated realization."@x-gmeow-english .

gmeow:MediumDictionaryEffectMeasurement
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Medium Dictionary Effect Measurement"@x-gmeow-english ;
    logic:subClassOf gmeow:Measurement ;
    skos:definition "The GENERATED reading of whether one shipped gmeow:CompressionDictionary PAYS FOR ITSELF over one declared gmeow:MediumMeasurementPopulation. It records a two-part (minimum-description-length) code — gmeow:measurementBytesOnDisk for the population's frames encoded through the dictionary, plus gmeow:measurementDictionaryInBandBytes for the dictionary's own bytes as the population actually carries them, summing to gmeow:measurementTwoPartCodeBytes — against gmeow:measurementBytesOnDiskBaseline, the SAME frames encoded through the declared no-dictionary medium gmeow:mediumProfileBaselineL12. The dictionary wins only when the two-part code is STRICTLY smaller: charging a dictionary its own in-band bytes is what keeps the criterion non-vacuous where the training corpus and the evaluated frame overlap, which for the archive-backed dictionaries they largely do (the corpus selects an archive's members, the evaluated frame is the tar of those members). The overlap is PARTIAL rather than total: every archive-backed corpus is resolved under gmeow:corpusTrainingSplitV1, which withholds one member in eight — chosen by that member's own content digest — from the trainer while leaving it in the evaluated frame, so every such reading is scored partly on members its dictionary never saw. Read that claim exactly: the FRAME is not held out (most of its bytes are training material), and nothing here is evidence that a dictionary would help on material outside the bundle, because the population a bundle dictionary primes IS the bundle's own frames. It lives in the build-time graph/medium-measurement named graph — never graph/medium-registry, which says what the dictionaries ARE rather than what they DO — and is never hand-authored."@x-gmeow-english ;
    skos:example "ex:effectCoreV1 a gmeow:MediumDictionaryEffectMeasurement ; gmeow:measuresDictionary gmeow:dictGmeowCoreV1 ; gmeow:measurementPopulation gmeow:mediumPopulationEmittedBlobFrames ."@x-gmeow-english ;
    skos:scopeNote "Scope: this class covers ONE (dictionary, population) two-part-code reading and nothing wider. It is not a benchmark of the codec, not the medium's losslessness judgment (that is the logic:Correspondence reached through gmeow:mediumCorrespondence), not a description of the dictionary's bytes (gmeow:CompressionDictionaryRealization), and not a generalization claim: it prices the bundle's own frames, so it says nothing about material outside the bundle."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid authoring one by hand (it is a build product of the terminal emission), avoid comparing readings taken over DIFFERENT gmeow:MediumMeasurementPopulation values (they are measured on different chains and are not commensurable), and avoid reading the recorded gain as evidence of generalization — most of the evaluated frame is training material, and only the share gmeow:corpusTrainingSplitV1 withholds is unseen."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Read it from graph/medium-measurement (or from its committed projection generated/medium/dictionary-effect.ttl); follow gmeow:measuresDictionary back to the authored gmeow:CompressionDictionary, read gmeow:measurementPopulation to learn which body of bytes was priced, and re-derive the bounded gain fraction from the recorded counts rather than trusting the reported quantity."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to state, as checkable data rather than as a claim, that a shipped dictionary earns the in-band bytes every consumer downloads with it."@x-gmeow-english .

gmeow:MediumMeasurementPopulation
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Medium Measurement Population"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "The DECLARED body of bytes a gmeow:MediumDictionaryEffectMeasurement was taken over. A value vocabulary (individuals, never subclasses) because the populations are open-ended, and a first-class coordinate rather than prose because the two shipped populations are measured on different chains: gmeow:mediumPopulationEmittedBlobFrames prices frames THIS build writes into gmeow.gts, while gmeow:mediumPopulationRuntimeStoreSegments prices files a CONSUMER writes with the shipped header entry, where the dictionary's cost is paid per segment header rather than once per artifact. Two readings under different populations are not commensurable, so a reader that could not tell them apart would compare numbers that do not compare."@x-gmeow-english ;
    skos:example "gmeow:mediumPopulationEmittedBlobFrames a gmeow:MediumMeasurementPopulation ."@x-gmeow-english ;
    skos:scopeNote "Scope: this vocabulary covers WHICH body of bytes a reading was taken over, and nothing about the reading itself. It does not record how many frames were priced (gmeow:measurementEvaluatedFrameCount), what they cost (the reading's own byte counts), or which samples the dictionary trained on (gmeow:DictionaryCorpus). Its whole job is to keep two incommensurable readings from being compared as though they were one series."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid minting populations as subclasses (they are individuals on an open axis) and avoid summing or ranking readings across two populations."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Reference exactly one seeded population individual from every gmeow:MediumDictionaryEffectMeasurement through gmeow:measurementPopulation."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use as the value vocabulary naming WHICH bytes a dictionary-effect reading priced."@x-gmeow-english .

gmeow:DigestStratum
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Digest Stratum"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "The named sub-payload a gmeow:strataDigest is taken over. It exists because the snapshot frame's own medium envelope is SELF-REFERENTIAL: snapshot_content_id() is a BLAKE3 digest over the ENTIRE snapshot payload, which folds the very graph the envelope lives in, so writing that digest into the envelope changes the payload it digests. A naive iterate-until-stable fixpoint does NOT converge — BLAKE3 is not a contraction, so successive passes wander rather than settle. Stratifying the digest fixes it: the envelope's gmeow:strataDigest is taken over a stratum that EXCLUDES the medium-envelope subgraph, so pass one emits the payload without the envelope, pass two adds the envelope carrying the pass-one stratum digest, and the stratum digest is unchanged by that addition — the emission provably converges in exactly two passes. An OPEN value vocabulary (individuals, never subclasses)."@x-gmeow-english ;
    skos:example "gmeow:stratumPayloadExcludingMediumEnvelope a gmeow:DigestStratum ."@x-gmeow-english ;
    skos:scopeNote "Scope: this vocabulary covers the NAMED REGION a stratified digest commits to, never the digest value and never the artifact's identity. The value is gmeow:strataDigest and the whole-artifact identity is gmeow:contentDigest; a stratum is neither. It is also not a medium coordinate — two envelopes over different media may name the same stratum, because the region is a property of the payload layout rather than of the encoding."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid treating a stratum digest as the artifact's byte identity (that is gmeow:contentDigest, which the envelope projects verbatim from the frame) and avoid inventing a stratum that includes the medium-envelope subgraph — that is exactly the non-convergent self-reference the stratum exists to break."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Name the stratum on the envelope with gmeow:envelopeDigestStratum and put the digest of exactly that stratum in gmeow:strataDigest; keep gmeow:contentDigest carrying the frame's own in-band identity unchanged beside it."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to say WHICH region a stratum digest commits to — required whenever the digest-bearing record is itself inside the region a whole-payload digest would cover."@x-gmeow-english .

gmeow:Medium
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Medium"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "A lawful (encode, decode) PAIR — a section/retraction (enc, dec) with dec ∘ enc = id on a DECLARED content domain — not a codec configuration record. The law is the medium's identity; the codec (gmeow:mediumCodec), level, dictionary, and composition chain are its coordinates. The losslessness claim rides on gmeow:mediumCorrespondence as a logic:Correspondence carrying an identity preservation judgment (logic:SectionRetraction + logic:ExactPreservation), NEVER a boolean flag: 'this medium round-trips' is a judged crossing with named endpoints and an executed discharge, exactly as a translation crossing is. An OPEN value vocabulary: media are individuals, so a deployment adds a medium without touching this module (Principle 9). A medium also declares the reader capability it demands (gmeow:requiresReaderCapability), because raising the reader contract is a property of the deliverable (Principle 13), never a silent assumption."@x-gmeow-english ;
    skos:example "gmeow:mediumProfileDistL12 a gmeow:Medium , gmeow:ZstdDictMedium ; gmeow:mediumCodec gmeow:codecZstdRsyncable ; gmeow:mediumCorrespondence gmeow:mediumCorrDistL12 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this class covers the lawful (encode, decode) PAIR and the coordinates that pick it out. It is not the codec alone (gmeow:TransformCodec names an algorithm, and several media may share one), not a GTS profile (gmeow:GTSProfile names a segment's purpose and requirement set, not a byte transform), and not the per-frame record of what a payload was written through (gmeow:MediumEnvelope). The round-trip claim is not stored here either: it lives on the correspondence the medium points at."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid modelling a medium as a settings bag with a lossless boolean (the judgment is the gmeow:mediumCorrespondence), avoid minting media as subclasses (they are individuals on an open axis), and avoid letting a frame fall through to 'no medium' — absence of a dictionary is a NAMED medium (gmeow:mediumProfileBaselineL12), never an unstated default."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Mint a medium individual typed gmeow:Medium AND its specialization (gmeow:ZstdDictMedium for a zstd medium) — the registry is read closed-world, so a medium that declares only the specialization is not a DECLARED gmeow:Medium for the assignments that must resolve to one — carrying exactly one gmeow:mediumCodec, one gmeow:mediumSourceKind, and one gmeow:mediumCorrespondence; declare every reader capability it demands with gmeow:requiresReaderCapability, and model a stacked codec chain with gmeow:mediumComposedOf rather than a flattened codec string."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use whenever bytes cross the encode/decode boundary and the round-trip must be a CLAIM someone can check — the named, judged pair a frame's payload was written through."@x-gmeow-english .

gmeow:MediumEnvelope
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Medium Envelope"@x-gmeow-english ;
    logic:subClassOf gmeow:AttestationArtifact ;
    skos:definition "The RDF PROJECTION of the medium facts a frame ALREADY carries in band — never a second copy, and never an independently recomputed one. An envelope names the dictionary the payload was primed with (gmeow:envelopeDictionary), the registered payload schema of the blob (gmeow:envelopeSchema), the byte-exact identity the frame itself states (gmeow:contentDigest, projected verbatim from the frame's in-band pub.digest / snapshot_content_id — reused from attestation, never recomputed and stored), the medium the bytes were written through (gmeow:envelopeMedium), the frame it describes (gmeow:envelopePayloadFrame), and the stratified digest pair (gmeow:envelopeDigestStratum + gmeow:strataDigest) that makes the SELF-REFERENTIAL snapshot envelope converge in exactly two passes. SIX of the seven fields are unconditionally exactly-one: a projection missing a coordinate is not a weaker projection, it is a different claim. The seventh, gmeow:envelopeDictionary, is exactly-one IFF the envelope's medium declares a dictionary at all (logic:MediumEnvelopeDictionaryConstraint) and at-most-one always — an unconditional obligation there would make the explicitly dictionary-LESS gmeow:mediumProfileBaselineL12 inexpressible as an envelope, and 'no dictionary' is that medium's selection rather than a missing coordinate. Its failure classes are HARD FAILS — an envelope that cannot resolve its dictionary, its schema, or its digest refuses, and never falls back to dictionary-less decode."@x-gmeow-english ;
    skos:example "ex:env a gmeow:MediumEnvelope ; gmeow:envelopeSchema gmeow:payloadSchemaCellsArchive ; gmeow:envelopeMedium gmeow:mediumProfileDistL12 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this class covers the PROJECTION of the medium facts one frame already carries in band — a read of the wire, made queryable. It is not the authored assignment that decided those facts (gmeow:PayloadSchema, with gmeow:payloadSchemaMedium and gmeow:payloadSchemaDictionary), not a place to store settings the frame does not carry, and not the medium itself. Deriving the assignment from an envelope would make the governing rule a product of the emission it governs."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid recomputing and storing a digest here (project the frame's in-band digest verbatim — an independently computed value is a second source that can silently disagree), avoid using it as a place to STORE medium settings the frame does not carry, and avoid omitting any field its medium makes obligatory (all six unconditional ones always, plus gmeow:envelopeDictionary whenever the medium declares a dictionary set)."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Emit one envelope per medium-encoded frame, projecting each field off the frame; set gmeow:envelopeDigestStratum to the stratum the gmeow:strataDigest covers and keep gmeow:contentDigest carrying the frame's own identity, so the stratum digest is an ADDITION to the total witness rather than a replacement."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to make a frame's medium facts QUERYABLE in the graph — so a consumer can ask which dictionary, schema, and medium a blob needs without decoding it first."@x-gmeow-english .

gmeow:MediumSourceKind
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Medium Source Kind"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "How a medium resolves the dictionary for a given payload: per-rep (each registered gmeow:PayloadSchema selects its own dictionary from the medium's declared set), header-dict (one dictionary declared in the segment header and used by every frame), or whole-artifact (the medium is applied to the finished artifact as a unit, with no per-frame dictionary selection). An OPEN value vocabulary (individuals, never subclasses). The source kind is what makes the rep-to-medium assignment TOTAL and derivable rather than a per-call decision."@x-gmeow-english ;
    skos:example "gmeow:mediumSourcePerRep a gmeow:MediumSourceKind ."@x-gmeow-english ;
    skos:scopeNote "Scope: this vocabulary covers HOW a medium resolves a dictionary, and nothing more. It does not bound WHICH dictionaries the medium may prime with (gmeow:mediumDictionary does) and does not name the one a given registered rep selects (gmeow:payloadSchemaDictionary does): the kind is the rule, and the set and the selection are its operands."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid minting source kinds as subclasses (they are individuals) and avoid leaving a medium without one — an unstated resolution rule is exactly the silent per-call decision the medium axis exists to remove."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Reference a seeded source-kind individual from a medium via gmeow:mediumSourceKind; a per-rep medium must also declare, through gmeow:mediumDictionary, the dictionary set its reps select from."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use as the value vocabulary for a medium's dictionary-resolution rule — the fact that turns 'which dictionary applies here' into a derivation rather than a lookup by convention."@x-gmeow-english .

gmeow:GtsProducer
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS Producer"@x-gmeow-english ;
    logic:subClassOf gmeow:SocialObject ;
    skos:definition "A reified row of the producer-to-medium map: one production site that AUTHORS GMEOW GTS bytes, and the gmeow:Medium it writes through. It carries the production source file(s) it governs (gmeow:producerCallSite) and exactly one gmeow:producerMedium; the medium's own gmeow:mediumSourceKind then selects which declared-media audit branch applies to what that site emits. A producer is an AUTHORSHIP site, not a reader: a file that validates a header or decodes a frame writes nothing and is not one. It exists because the medium audit is a three-way split, and a split is a TOTAL FUNCTION over producers only if every producer is in its domain — a producer with no row would have no branch, so it would be audited by nothing while the split still looked complete. A repo-static census enumerates every production call of a mandated-profile authorship door and HARD-fails on a call site no row claims, and on a row that claims no call site."@x-gmeow-english ;
    skos:example "gmeow:gtsProducerDistBundle a gmeow:GtsProducer ; gmeow:producerCallSite \"crates/pipeline/src/stages/carrier.rs\" ; gmeow:producerMedium gmeow:mediumProfileDistL12 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this class covers one row of the production-site-to-medium map: the source files that AUTHOR GMEOW GTS bytes, and the medium they write through. It is not the build stage that runs them (gmeow:PipelineStage), not the artifact they emit, and not a reader of GTS — a file that validates or reads a header authors nothing and must not be listed. The resolution rule is not restated here either; it is read through the medium's own gmeow:mediumSourceKind."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid redeclaring gmeow:mediumSourceKind on the producer (the medium already states it, and two copies could disagree about the same artifact), avoid a row with several gmeow:producerMedium values (a site writes through one medium), and avoid leaving a row in place after its file is renamed — a stale call site classifies nothing while making the map look complete."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Mint one individual per production source file that calls a mandated-profile authorship door, list that file in gmeow:producerCallSite, and point gmeow:producerMedium at the medium it writes through; adding an authorship call in Rust means adding its row here in the same change."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare, as data, which medium a production GTS-authoring site writes through — the fact that makes the declared-media audit's branch selection derivable rather than assumed."@x-gmeow-english .

gmeow:PayloadSchema
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Payload Schema"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "The REGISTERED schema-id vocabulary of the blob channel: exactly one individual per blob representation the carrier can emit, plus one for the snapshot wire schema. Its whole purpose is to make an UNREGISTERED rep a genuine production hard fail (gmeow:MediumUnknownSchema) rather than a value derivable from the frame — if the schema id were merely read back off the frame, a new archive would decode as 'some unknown blob' instead of refusing, and its medium assignment would be silently undefined. Each individual carries its stable wire label in gmeow:payloadSchemaId; that literal is the exact rep string the carrier writes, so the registry and the emitter cannot drift. It is ALSO where the rep-to-medium assignment is AUTHORED — gmeow:payloadSchemaMedium (exactly one) and, under a per-rep medium, gmeow:payloadSchemaDictionary — which is what makes that assignment total over emittable reps by construction: every rep the carrier can write already has a schema here, so no payload can reach the wire with an undeclared medium. An OPEN value vocabulary (individuals, never subclasses)."@x-gmeow-english ;
    skos:example "gmeow:payloadSchemaCellsArchive a gmeow:PayloadSchema ; gmeow:payloadSchemaId \"cells-archive\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this vocabulary covers the CLOSED REGISTRY of emittable wire reps and the authored medium/dictionary assignment attached to each. It is not a structural schema for what is inside the payload — no SHACL shape, JSON Schema, or CBOR grammar lives here, only the rep label and its assignment — and it is not read back off an emitted frame: gmeow:envelopeSchema resolves AGAINST this registry, never the reverse."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid emitting a blob whose rep has no gmeow:PayloadSchema individual (that is gmeow:MediumUnknownSchema, a hard fail — register the schema first), avoid minting schemas as subclasses, and avoid reusing one schema individual for two distinct wire reps."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Mint one individual per carrier rep, set gmeow:payloadSchemaId to the exact wire label, assign its gmeow:payloadSchemaMedium (and, under a per-rep medium, its gmeow:payloadSchemaDictionary), and reference it from a gmeow:MediumEnvelope through gmeow:envelopeSchema; adding a new archive to the carrier means adding its schema AND its assignment here in the same change."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use as the closed registry a payload rep must resolve against before it can be given a medium — the vocabulary that turns an unknown blob into a refusal instead of a guess."@x-gmeow-english .

gmeow:ZstdDictMedium
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "Zstd Dictionary Medium"@x-gmeow-english ;
    logic:subClassOf gmeow:Medium ;
    skos:definition "The zstd specialization of gmeow:Medium: a lawful (encode, decode) pair realized by a zstd-family codec at a declared compression level (gmeow:mediumZstdLevel) with an OPTIONAL dictionary set (gmeow:mediumDictionary). Optional means EXPLICITLY DECLARED, not absent: the dictionary-less medium is itself a named individual (gmeow:mediumProfileBaselineL12), so 'no dictionary' is a selection a frame makes, never a hole it falls into. The level is part of the declared medium because a level change is a byte-level change to every artifact the medium produces."@x-gmeow-english ;
    skos:example "gmeow:mediumProfileBaselineL12 a gmeow:Medium , gmeow:ZstdDictMedium ; gmeow:mediumZstdLevel 12 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this class covers the zstd-specific COORDINATES a medium adds — the declared level and the bounded dictionary set. It does not restate or replace the medium law (that stays on gmeow:mediumCorrespondence, inherited from gmeow:Medium), does not describe the dictionary itself (gmeow:CompressionDictionary), and must not be used for a medium realized by a non-zstd codec, whose level space and dictionary semantics are not these."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid treating an absent gmeow:mediumDictionary as 'unknown' (it is the declared no-dictionary selection of that medium) and avoid varying the level per call — the level is declared on the medium precisely so it cannot drift per invocation."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Mint the medium with one gmeow:mediumCodec from the zstd family, one gmeow:mediumZstdLevel, one gmeow:mediumSourceKind, and — for a per-rep medium — every gmeow:mediumDictionary its reps may select."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use for a zstd-realized medium, dictionary-primed or explicitly dictionary-less."@x-gmeow-english .

# --- Medium properties ------------------------------------------------------ #

gmeow:corpusSelectsBlobRep
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "corpus selects blob rep"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "A blob representation label whose members a dictionary corpus trains over — the exact wire rep string the carrier writes (matching a gmeow:payloadSchemaId). Non-functional: a corpus may draw on several archives. It selects the whole archive, not an individual member of it. Bundle-internal by construction: a rep names material the bundle already carries."@x-gmeow-english ;
    skos:example "gmeow:corpusGmeowCoreV1 gmeow:corpusSelectsBlobRep \"cells-archive\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property selects a whole ARCHIVE by its wire rep label, and nothing narrower or wider. It does not name a single member of that archive, does not select RDF quads (gmeow:corpusSelectsGraph), source files (gmeow:corpusSelectsPathPrefix), or a stage product (gmeow:corpusSelectsStageProduct), and it is not the rep-to-medium assignment: the same label appears as a gmeow:payloadSchemaId on the registry for an unrelated purpose."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid a rep label with no registered gmeow:PayloadSchema (the corpus would select an archive nothing is allowed to emit) and avoid using it to name a single member — it selects the whole archive."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "List each archive rep the corpus draws samples from; the trainer resolves the label against the carrier's blob channel at build time."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use when a dictionary's training material is a whole blob archive the carrier already folds."@x-gmeow-english .

gmeow:corpusSelectsGraph
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "corpus selects graph"@x-gmeow-english ;
    skos:definition "A named-graph IRI whose serialized quads a dictionary corpus trains over. The range is the IRI of a carrier named graph, not a class (stated in prose, like gmeow:attachesGraph). Non-functional: a corpus may draw on several graphs."@x-gmeow-english ;
    skos:example "gmeow:corpusGmeowMemoryHotV1 gmeow:corpusSelectsGraph <https://blackcatinformatics.ca/gmeow/graph/authoring-briefs> ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property selects the serialized quads of ONE carrier named graph. It does not select packed archive bytes (gmeow:corpusSelectsBlobRep), a region of the source tree (gmeow:corpusSelectsPathPrefix), or a stage's in-memory product (gmeow:corpusSelectsStageProduct), and it does not fix a serialization anyone else must reproduce — the trainer serializes deterministically for training input alone."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid naming a graph the bundle does not carry, and avoid using it for a blob archive (that is gmeow:corpusSelectsBlobRep) — this selects RDF quads, not packed bytes."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "List each carrier named graph the corpus draws samples from; the trainer serializes the graph deterministically before sampling so the training input is reproducible."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use when a dictionary's training material is RDF the bundle carries as a named graph."@x-gmeow-english .

gmeow:corpusSelectsPathPrefix
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "corpus selects path prefix"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "A repository-relative path prefix whose files a dictionary corpus trains over. Non-functional: a corpus may draw on several prefixes. A prefix, not a file list — a new file under the prefix joins the training set without an authoring edit."@x-gmeow-english ;
    skos:example "gmeow:corpusGmeowCoreV1 gmeow:corpusSelectsPathPrefix \"slices/core/\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property selects AUTHORED SOURCE files by repository-relative prefix. It does not select anything the build generates, does not reach outside the repository tree the bundle is built from, and it is not the archive selector (gmeow:corpusSelectsBlobRep) even where an archive happens to be tarred from files under the same prefix — one names bytes on the wire, the other names files in the tree."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid a prefix outside the repository tree the bundle is built from — most importantly a user home directory — and avoid enumerating individual files."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "List each source-tree prefix the corpus draws samples from, in sorted order, so the resolved training set is deterministic."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use when a dictionary's training material is a region of the authored source tree."@x-gmeow-english .

gmeow:corpusSelectsStageProduct
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "corpus selects stage product"@x-gmeow-english ;
    rdfs:range gmeow:PipelineStage ;
    skos:definition "A gmeow:PipelineStage whose PRODUCT a dictionary corpus trains over — the routing used when the material a dictionary needs is not reachable as a standalone archive because the archive is SINK-FOLDED (assembled only at the terminal snapshot). The reasoning reports and the lang surface blob are exactly that case: gmeow:stage-archive-blobs owns the eight ordinary archive reps, but reasoning-archive and lang-surface-blob are folded by the sink, so their dictionaries select the producing stage's product instead of a rep label. Non-functional."@x-gmeow-english ;
    skos:example "gmeow:corpusGmeowProoftraceV1 gmeow:corpusSelectsStageProduct gmeow:stage-reason ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property is the routing for SINK-FOLDED material — training input that exists only as a stage's in-memory product because its archive is assembled at the terminal. It does not name a file a stage writes to disk, does not select material that already has an archive rep (prefer gmeow:corpusSelectsBlobRep, the narrower and more checkable selector), and it is not a pipeline dataflow declaration: the stage's own gmeow:dataflowConsumes remains the DAG edge."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid using it for material that IS reachable as an archive rep (prefer gmeow:corpusSelectsBlobRep — a rep label is the narrower, more checkable selector) and avoid naming a stage whose product the dictionary trainer does not run after."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Name the producing gmeow:PipelineStage; the trainer reads that stage's in-memory product rather than waiting for a folded archive that only exists at the sink."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use when the training material is sink-folded and therefore has no mid-DAG archive rep to select."@x-gmeow-english .

gmeow:dictionaryByteLength
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CompressionDictionaryRealization ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dictionary byte length"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The MEASURED byte length of a trained dictionary — a realization field, never an authored one. Distinct from gmeow:dictionaryTargetLength, which on the authored definition is the size REQUESTED of the trainer: a trainer may return fewer bytes than asked for, and the gap between the two is the honest record of that."@x-gmeow-english ;
    skos:example "ex:realCoreV1 gmeow:dictionaryByteLength 110592 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property records what the trainer RETURNED, on the realization only. It is not what was asked for (the authored gmeow:dictionaryTargetLength) and not what the build ran at (gmeow:measuredDictionaryTargetLength). The gap between a target and this value is the honest record of a trainer that returned less than requested, so collapsing the three would erase exactly the discrepancy they exist to show."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid asserting it on a gmeow:CompressionDictionary (the authored definition cannot know it) and avoid conflating it with the requested gmeow:dictionaryTargetLength."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Emit it from the medium-registry pass beside gmeow:dictionaryContentDigest; compare it against the definition's gmeow:dictionaryTargetLength to see what the trainer actually returned."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to record how large a trained dictionary actually is."@x-gmeow-english .

gmeow:dictionaryContentDigest
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CompressionDictionaryRealization ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dictionary content digest"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The byte-exact identity of a TRAINED dictionary, written 'blake3:<hex>' — a realization field. It is deliberately NOT gmeow:contentDigest reused: gmeow:contentDigest identifies the artifact a record is ABOUT, while this identifies the dictionary the record's artifact was primed WITH, and collapsing them would make an envelope's own identity indistinguishable from its dictionary's. A decoder that holds a dictionary whose digest differs from the one the frame cites raises gmeow:MediumDigestMismatch and refuses; it never retries dictionary-less."@x-gmeow-english ;
    skos:example "ex:realCoreV1 gmeow:dictionaryContentDigest \"blake3:9f2c4e…\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property identifies the DICTIONARY BYTES a payload was primed with. It is not gmeow:contentDigest, which identifies the artifact a record is about; it is not gmeow:strataDigest, which commits to a named sub-payload of that artifact; and it is not the numeric wire identity the frame header cites (gmeow:zstdDictionaryId). A reader compares it before priming, never as a diagnosis after a failed decode."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid asserting it on an authored gmeow:CompressionDictionary (an unsatisfiable obligation — the digest is a build product) and avoid substituting it for gmeow:contentDigest, which identifies the artifact rather than its priming dictionary."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Emit it from the medium-registry pass as 'blake3:<hex>'; a decoder compares it against the dictionary it holds before attempting a primed decode."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to pin exactly which trained dictionary bytes a primed decode requires."@x-gmeow-english .

gmeow:dictionaryId
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dictionary id"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The stable, human-readable id of an authored compression dictionary (e.g. \"gmeow-core-v1\"). Functional: one id per definition. An id alone does NOT identify decodable bytes — it must be read with gmeow:dictionaryVersion, because a zstd dictionary is a verbatim substring table of its corpus and two versions of one id share no compatibility guarantee."@x-gmeow-english ;
    skos:example "gmeow:dictGmeowCoreV1 gmeow:dictionaryId \"gmeow-core-v1\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property carries the human-readable NAME of an authored dictionary, and never a complete identity on its own — it must be read with gmeow:dictionaryVersion. It is not the numeric zstd Dictionary_ID the frame header cites (gmeow:zstdDictionaryId, a realization field) and not the byte-exact identity of trained bytes (gmeow:dictionaryContentDigest)."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid treating the id as version-free identity (always pair it with gmeow:dictionaryVersion) and avoid the raw zstd Dictionary_ID here — that numeric header field is gmeow:zstdDictionaryId on the realization."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one id per authored dictionary and cite it with its version wherever a frame declares which dictionary it needs."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to name an authored dictionary in a form a human reads and a decoder resolves."@x-gmeow-english .

gmeow:dictionaryStrategy
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dictionary strategy"@x-gmeow-english ;
    rdfs:range gmeow:DictionaryStrategy ;
    skos:definition "The strategy family a dictionary is built under. On a gmeow:CompressionDictionary it is the authored INTENT; on a gmeow:CompressionDictionaryRealization it is the MEASURED outcome (domain stated in prose, since asserting one would type both classes alike). Functional per subject. A realization whose measured strategy differs from its definition's intent is an honest record of a trainer fallback, not a silent success."@x-gmeow-english ;
    skos:example "gmeow:dictGmeowCoreV1 gmeow:dictionaryStrategy gmeow:dictStrategyTrained ."@x-gmeow-english ;
    skos:scopeNote "Scope: on an authored gmeow:CompressionDictionary this property carries the DECLARED intent and nothing more. It is not the strategy a build executed: the realization records that under its own gmeow:measuredDictionaryStrategy, and the two are separate predicates precisely so a trainer that ran under a different winner has somewhere to say so. It is also not the size axis (gmeow:dictionaryTargetLength) or the training material (gmeow:trainsOverCorpus)."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid asserting several strategies on one subject (it is functional) and avoid copying the authored intent onto the realization without measuring it — the point of carrying it twice is that the two can disagree."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point the authored dictionary at the intended strategy and the emitted realization at the strategy the trainer actually used."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to record how a dictionary is meant to be built, and separately how it actually was."@x-gmeow-english .

gmeow:dictionaryTargetLength
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dictionary target length"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The dictionary size in bytes REQUESTED of the trainer on a gmeow:CompressionDictionary, and the size the trainer reports having targeted on a gmeow:CompressionDictionaryRealization (domain stated in prose). Functional per subject. It is a request, not a measurement: the achieved size is gmeow:dictionaryByteLength."@x-gmeow-english ;
    skos:example "gmeow:dictGmeowCoreV1 gmeow:dictionaryTargetLength \"65536\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property carries a REQUEST — the size the trainer is asked for. It is not the size returned (gmeow:dictionaryByteLength) and not the size the committed sweep actually ran at (gmeow:measuredDictionaryTargetLength). Reading it as an achieved measurement would report a number no build necessarily produced."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid reading it as the achieved size (that is gmeow:dictionaryByteLength) and avoid asserting several per subject."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Assert the requested size on the authored dictionary; the medium-registry pass repeats the targeted size on the realization beside the achieved gmeow:dictionaryByteLength."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare how large a dictionary should be trained, so the request is reviewable independently of the result."@x-gmeow-english .

gmeow:dictionaryVersion
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dictionary version"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The version coordinate of a compression dictionary, carried on BOTH the authored gmeow:CompressionDictionary and the generated gmeow:CompressionDictionaryRealization (domain stated in prose) so an emitted realization can be checked against the definition it claims to realize. Functional per subject. Versions are never interchangeable: a dictionary is a verbatim substring table of its training corpus, so decoding a frame primed with version N against version N+1 produces garbage, not degraded output — hence gmeow:MediumDictionaryRegression, which fires when an emitted version is no longer retained by any authored definition."@x-gmeow-english ;
    skos:example "gmeow:dictGmeowCoreV1 gmeow:dictionaryVersion \"1\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property carries the version COORDINATE only, on both halves of the definition/realization split, so the two can be compared. It is not a compatibility statement — versions of one id share no guarantee — and it is not an ordering a consumer may resolve by taking the newest: a frame primed with version N is readable only with version N."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid retiring a version any shipped realization still cites (that orphans every artifact primed with it) and avoid asserting several versions on one subject."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Assert one version per definition and repeat it on each realization; the retention constraint compares the two and hard-fails on a dropped version."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to pin which generation of a dictionary id a frame or a realization is bound to."@x-gmeow-english .

gmeow:envelopeDictionary
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MediumEnvelope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "envelope dictionary"@x-gmeow-english ;
    rdfs:range gmeow:CompressionDictionary ;
    skos:definition "The compression dictionary a medium envelope's payload was primed with — PROJECTED from the dict_id the frame already carries in band, never chosen at projection time. AT MOST one per envelope always — a payload primed with two dictionaries is incoherent — and exactly one whenever the envelope's gmeow:envelopeMedium declares a dictionary set (logic:MediumEnvelopeDictionaryConstraint), because a payload primed with an unstated dictionary is undecodable. Under the explicitly dictionary-less gmeow:mediumProfileBaselineL12 its absence is that medium's SELECTION, not an omission. Its range is read closed-world through gmeow:envelopeDictionaryRangeClosure, so the derived envelope shape carries sh:class and an unregistered dictionary raises gmeow:MediumUnknownDictionary — a hard fail, never a fallback to dictionary-less decode."@x-gmeow-english ;
    skos:example "ex:env gmeow:envelopeDictionary gmeow:dictGmeowCoreV1 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property records what a frame WAS primed with, projected from its in-band dict_id. It is not the authored requirement for that rep (gmeow:payloadSchemaDictionary states what a rep MUST be primed with, and the emitter refuses when the two disagree) and not the bound set a medium permits (gmeow:mediumDictionary). Its absence under a dictionary-less medium is that medium's selection, not a gap to be filled in later."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid omitting it on a dictionary-primed envelope (that is gmeow:MediumUndeclaredDictionary) and avoid pointing it at anything but a registered gmeow:CompressionDictionary."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project the frame's in-band dict_id onto the matching gmeow:CompressionDictionary individual; a decoder resolves it before priming and refuses if it does not resolve."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to make a frame's priming dictionary queryable in the graph without decoding the frame."@x-gmeow-english .

gmeow:envelopeDigestStratum
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MediumEnvelope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "envelope digest stratum"@x-gmeow-english ;
    rdfs:range gmeow:DigestStratum ;
    skos:definition "Names the sub-payload the envelope's gmeow:strataDigest is taken over. For the SNAPSHOT envelope that stratum is gmeow:stratumPayloadExcludingMediumEnvelope — the payload MINUS the medium-envelope subgraph — because snapshot_content_id() digests the entire payload including the graph the envelope lives in, so a whole-payload digest written into the envelope changes what it digests and an iterate-until-stable fixpoint does not converge (BLAKE3 is not a contraction). Stratifying makes the emission converge in EXACTLY two passes: pass one digests the stratum, pass two writes the envelope, and adding the envelope cannot change a digest taken over a region that excludes it. Exactly one per envelope: a digest whose region is unstated is uncheckable."@x-gmeow-english ;
    skos:example "ex:env gmeow:envelopeDigestStratum gmeow:stratumPayloadExcludingMediumEnvelope ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property names the REGION only. The digest value is gmeow:strataDigest and the artifact's own identity is gmeow:contentDigest; asserting either of those without this one leaves an uncheckable claim, and naming a region that contains the envelope reintroduces the self-reference the stratum exists to break."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid naming a stratum that includes the medium-envelope subgraph on a self-referential envelope (the emission would not converge) and avoid omitting it while asserting gmeow:strataDigest."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set it to the stratum the emitter actually digested and keep gmeow:contentDigest carrying the frame's own in-band identity — the stratum digest is an ADDITION to the total witness, never a replacement for it."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use whenever a digest-bearing record sits inside the region a whole-payload digest would cover."@x-gmeow-english .

gmeow:envelopeMedium
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MediumEnvelope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "envelope medium"@x-gmeow-english ;
    rdfs:range gmeow:Medium ;
    skos:definition "The gmeow:Medium the envelope's payload bytes were written through — the (encode, decode) pair whose law the payload relies on. Exactly one per envelope. Together with gmeow:envelopeSchema it makes the rep-to-medium assignment a FUNCTION: every registered payload schema resolves to exactly one declared medium (logic:MediumSchemaMediumFunctionalityConstraint), so 'which medium applies to this rep' is derivable rather than conventional."@x-gmeow-english ;
    skos:example "ex:env gmeow:envelopeMedium gmeow:mediumProfileDistL12 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property projects the medium a frame's bytes WERE written through. It is not where the rep-to-medium assignment is authored (that is gmeow:payloadSchemaMedium, on the registry) and not the round-trip judgment itself, which a reader reaches by following the medium to gmeow:mediumCorrespondence."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid leaving it unstated (a payload with no declared medium has no round-trip claim at all) and avoid letting two envelopes over the same gmeow:envelopeSchema name different media — the rep-to-medium map is a function."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Project the medium the emitter selected; readers follow it to gmeow:mediumCorrespondence for the losslessness judgment and to gmeow:requiresReaderCapability for the reader contract."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to state which lawful encode/decode pair a frame's bytes were produced by."@x-gmeow-english .

gmeow:envelopePayloadFrame
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MediumEnvelope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "envelope payload frame"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "The GTS frame whose payload the envelope projects — the anchor that keeps the envelope a description OF something rather than a free-floating settings record. Exactly one per envelope. When the reader cannot decode that frame the envelope's claims stand as evidence about an opaque region: the frame is surfaced as a gmeow:OpaqueFrame carrying gmeow:opacityUnknownCodec, and the medium axis names that same situation gmeow:MediumOpaqueFrame rather than modelling a disjoint failure set."@x-gmeow-english ;
    skos:example "ex:env gmeow:envelopePayloadFrame ex:frame7 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property anchors an envelope to the ONE frame it describes, and carries nothing about that frame's content, codec, or readability. A frame the reader cannot decode is described with the existing gmeow:OpaqueFrame and gmeow:opacityReason vocabulary rather than by weakening this link; an envelope with no frame is a settings record, not a description of anything."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid pointing one envelope at several frames (it is exactly-one — an envelope describes one payload) and avoid minting an envelope with no frame at all."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Anchor the envelope to the frame it was projected from; for an undecodable frame pair it with the existing gmeow:OpaqueFrame / gmeow:opacityReason vocabulary rather than inventing a medium-local opacity record."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to bind a medium envelope to the single frame whose payload it describes."@x-gmeow-english .

gmeow:envelopeSchema
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MediumEnvelope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "envelope schema"@x-gmeow-english ;
    rdfs:range gmeow:PayloadSchema ;
    skos:definition "The registered gmeow:PayloadSchema of the blob the envelope describes — the wire rep, resolved against the closed registry rather than read back off the frame as an opaque string. Exactly one per envelope. Its range is read closed-world through gmeow:envelopeSchemaRangeClosure, so the derived envelope shape carries sh:class and an UNREGISTERED rep raises gmeow:MediumUnknownSchema: a hard production failure, never a decodable-but-unclassified blob."@x-gmeow-english ;
    skos:example "ex:env gmeow:envelopeSchema gmeow:payloadSchemaCellsArchive ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property resolves a frame's rep against the CLOSED registry. It does not store the rep string itself — the literal lives on the registry side as gmeow:payloadSchemaId — and it is not the authored assignment attached to that schema: an envelope reads the registry, it never defines it."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid pointing it at a rep string with no registered individual (register the schema in the same change that adds the archive) and avoid asserting several schemas per envelope."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Resolve the frame's rep label against gmeow:payloadSchemaId and point at the matching individual; the rep-to-medium function is keyed on this value."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to state, against the closed registry, what KIND of payload a medium-encoded frame carries."@x-gmeow-english .

gmeow:mediumCodec
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Medium ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "medium codec"@x-gmeow-english ;
    rdfs:range gmeow:TransformCodec ;
    skos:definition "The gmeow:TransformCodec that REALIZES a medium's (encode, decode) pair. Exactly one per medium: a medium with two codecs is two media, and a stacked chain is modelled with gmeow:mediumComposedOf rather than by listing codecs. The codec is a coordinate of the medium, not its identity — the identity is the law on gmeow:mediumCorrespondence."@x-gmeow-english ;
    skos:example "gmeow:mediumProfileDistL12 gmeow:mediumCodec gmeow:codecZstdRsyncable ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property names the ALGORITHM that realizes a medium, one per medium. It is not the medium's identity — two media may share this codec and differ in level, dictionary set, or source kind — not a chain (gmeow:mediumComposedOf models stacking), and not the capability contract the codec implies, which gmeow:requiresReaderCapability states explicitly rather than leaving a reader to infer."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid listing several codecs to express a chain (use gmeow:mediumComposedOf) and avoid treating the codec as the medium's identity — two media may share a codec and differ in level, dictionary set, or source kind."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point each medium at exactly one catalog codec; read the codec's gmeow:codecClass to anticipate the missing-capability degradation path."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to name the algorithm a medium's encode/decode pair is realized by."@x-gmeow-english .

gmeow:mediumComposedOf
    a owl:ObjectProperty ;
    logic:subPropertyOf gmeow:hasPart ;
    rdfs:domain gmeow:Medium ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "medium composed of"@x-gmeow-english ;
    rdfs:range gmeow:Medium ;
    skos:definition "A component medium of a composite one — the ontological model of the GTS transform chain (spec §8's \"x\" composition). Composition is FIRST-CLASS: the chain is a graph of media, each carrying its own law, not a flattened codec string a reader has to re-parse. Composition of section/retraction pairs is itself a section/retraction pair, which is why the composite's gmeow:mediumCorrespondence is derivable rather than independently asserted. Non-functional and ordered by the underlying chain; a subproperty of gmeow:hasPart, so generic part/whole consumers walk it without extra assertion."@x-gmeow-english ;
    skos:example "ex:mediumZstdThenBase64 gmeow:mediumComposedOf gmeow:mediumProfileBaselineL12 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property models COMPOSITION of media, so each component keeps its own citable law and its own coordinates. It is not a flattened codec string, not a substitute for gmeow:mediumCodec (which names the algorithm at a single level), and not a place to assert a fresh preservation judgment for the composite — that judgment is derived by composing the components', never authored independently."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid flattening a chain into one codec string (the component laws stop being citable) and avoid composing media whose content domains do not meet — the composite's law is only as good as the join."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "List each component medium of a composite; derive the composite's preservation judgment by composing the components' rather than asserting a fresh one."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to model a stacked transform chain as media composed of media."@x-gmeow-english .

gmeow:mediumCorrespondence
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Medium ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "medium correspondence"@x-gmeow-english ;
    rdfs:range logic:Correspondence ;
    skos:definition "Relates a medium to the single logic:Correspondence carrying its losslessness judgment — the law-spine of dec ∘ enc = id on the declared content domain. There is NO boolean lossless flag, and round-tripping is not asserted as a bare property of the medium itself: whether the medium round-trips is the logic:morphismClass (logic:SectionRetraction), the logic:preservationKind (logic:ExactPreservation — identity), and the executed lens-law discharge on that correspondence, exactly as gmeow:gmnEnvelopeCorrespondence attaches a GMN envelope to its crossing. Exactly one per medium; its range is read closed-world through gmeow:mediumCorrespondenceRangeClosure so the derived medium shape carries sh:class."@x-gmeow-english ;
    skos:example "gmeow:mediumProfileDistL12 gmeow:mediumCorrespondence gmeow:mediumCorrDistL12 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property carries the medium's ROUND-TRIP LAW as a judged crossing. It is not a lossless flag and must not be summarized as one; it is not a measurement of how well the medium compresses (that is gmeow:MediumDictionaryEffectMeasurement); and it says nothing about whether a given reader can execute the decode, which is the business of gmeow:requiresReaderCapability."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid carrying a losslessness boolean on the medium (the judgment lives on the correspondence) and avoid pointing it at an untyped node standing in for a logic:Correspondence."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Mint one logic:Correspondence per medium with named logic:sourceEndpoint / logic:targetEndpoint and an explicit morphism class, morphism kind, and preservation kind, then point the medium at it."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to attach a medium's round-trip claim to a judged, dischargeable crossing instead of asserting it as a flag."@x-gmeow-english .

gmeow:mediumDictionary
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ZstdDictMedium ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "medium dictionary"@x-gmeow-english ;
    rdfs:range gmeow:CompressionDictionary ;
    skos:definition "A compression dictionary a zstd medium may prime with. Non-functional: a per-rep medium declares the whole SET its registered payload schemas select from, so the selection is bounded by declaration rather than open at call time. ABSENCE is meaningful and explicit: gmeow:mediumProfileBaselineL12 declares none, and that IS its selection — 'no dictionary' is a named medium, never an unstated default a frame falls into."@x-gmeow-english ;
    skos:example "gmeow:mediumProfileDistL12 gmeow:mediumDictionary gmeow:dictGmeowCoreV1 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property BOUNDS the set a zstd medium may prime with, and selects nothing. Which dictionary a particular rep uses is authored on the registry (gmeow:payloadSchemaDictionary); what a particular frame was actually primed with is projected on its envelope (gmeow:envelopeDictionary). An empty set on a deliberately dictionary-less medium is a declaration, not an unknown to be resolved."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid priming a frame with a dictionary its medium does not declare (the medium's declared set is the bound) and avoid reading an absent value as 'unknown' rather than 'declared none'."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "List every dictionary a per-rep medium's schemas may select; leave it empty on a deliberately dictionary-less medium and say so in that medium's definition."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to bound which dictionaries a zstd medium is allowed to prime with."@x-gmeow-english .

gmeow:measuredCorpusDigest
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CompressionDictionaryRealization ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measured corpus digest"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The identity of the WHOLE corpus this build resolved for the dictionary — held-out members included — written in the canonical blake3:<64 lowercase hex> form: every resolved sample's own digest, one per line in canonical digest order, hashed again. Exactly one per realization. It exists because a gmeow:DictionaryCorpus is a SELECTOR re-resolved on every build, so an archive that gains or loses one member moves the corpus while the committed sweep evidence sits still; recording the identity is what lets the build REFUSE (gmeow:MediumCorpusDrift) instead of grading itself against numbers taken over different material. Held-out members are inside the digest deliberately: the sweep's argmin depends on the whole frame, so a held-out member that changed would leave the training set alone while moving the bytes every grid cell was scored over. It is over the samples' DIGESTS rather than over their concatenated bytes so the value costs bounded memory on a corpus whose members run to hundreds of megabytes, and so a reader who prints one member's digest can see it in this one's input."@x-gmeow-english ;
    skos:example "ex:realCoreV1 gmeow:measuredCorpusDigest \"blake3:1f0a…\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property identifies the WHOLE corpus resolution of one build, held-out members included, so committed evidence can be pinned to it. It is not the size of that resolution (gmeow:measuredCorpusSampleCount, which counts the training side only), not the dictionary's own byte identity (gmeow:dictionaryContentDigest), and not a value an author may edit to make a stale table agree — that would assert an identity nothing measured."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid asserting it on the authored gmeow:CompressionDictionary (a corpus identity is a build product — the declaration is the SELECTOR, not the resolution), avoid writing it in any form but blake3:<64 lowercase hex> (a free-form digest could never match the corpus it claims to identify), and avoid computing it over the training side alone — the held-out members are part of what the evaluation ran on."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Read it off the realization in graph/medium-registry and compare it against the corpus_digest column of bench/medium-baseline.json; equality is what makes the committed evidence a statement about the shipped bytes rather than about a sweep nobody re-ran."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to pin a dictionary's shipped bytes and its committed evidence to the exact corpus resolution that produced them."@x-gmeow-english .

gmeow:measuredCorpusSampleCount
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CompressionDictionaryRealization ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measured corpus sample count"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "How many samples the TRAINER was actually handed on THIS build: the dictionary's declared gmeow:DictionaryCorpus resolved, MINUS the archive members the declared gmeow:CorpusTrainingSplit holds out. Measured rather than authored, because a corpus is a SELECTOR re-resolved on every build: its cardinality is a product, not a declaration. Exactly one per realization. It is recorded because the dictionary-effect reading is only interpretable beside it — a two-part code over a corpus of ten samples and one over ten thousand say different things about the same number of bytes. It is the TRAINING side alone; the identity of the whole resolution, held-out members included, is gmeow:measuredCorpusDigest."@x-gmeow-english ;
    skos:example "ex:realCoreV1 gmeow:measuredCorpusSampleCount 4213 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property counts the TRAINING side of one build's resolution — the corpus minus what the split withholds. It is not the corpus's full cardinality, not the count carried on a dictionary-effect reading (gmeow:measurementCorpusSampleCount restates this fact where the reading is read), and not the number of frames a reading priced (gmeow:measurementEvaluatedFrameCount)."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid authoring it on the gmeow:CompressionDictionary (a corpus is a selector, so its size is not something a human can declare in advance), avoid re-deriving it downstream (the producer's count is the one the shipped bytes correspond to), and avoid reading it as the size of the corpus — it is the size of the training side of the declared split."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it off the realization in graph/medium-registry beside the content digest; carry it into any reading of gmeow:MediumDictionaryEffectMeasurement for the same dictionary."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to record the size of the training set a shipped dictionary was actually built from."@x-gmeow-english .

gmeow:measuredDictionaryStrategy
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CompressionDictionaryRealization ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measured dictionary strategy"@x-gmeow-english ;
    rdfs:range gmeow:DictionaryStrategy ;
    skos:definition "The gmeow:DictionaryStrategy the build ACTUALLY trained under — the committed sweep's winning cell, not the authored intent. Exactly one per realization. It is a DIFFERENT predicate from the authored gmeow:dictionaryStrategy on purpose: that one states what a human declared, this one states what ran, and while both are usually the same a build that trained under a different winner must be able to say so. Spelling both with one predicate made a definition and a realization indistinguishable to a reader and left the divergence with nowhere to live."@x-gmeow-english ;
    skos:example "ex:realCoreV1 gmeow:measuredDictionaryStrategy gmeow:dictStrategyTrained ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property records what the BUILD RAN — the committed sweep's winning cell — on the realization only. It is not the authored declaration (gmeow:dictionaryStrategy), and a difference between the two is a reportable finding about the declaration rather than a defect in the bytes. Assuming the two agree is exactly the assumption the separate predicate exists to prevent."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid asserting it on the authored gmeow:CompressionDictionary (use gmeow:dictionaryStrategy there) and avoid assuming it equals the declaration — the whole point of the split is that the two can differ and be seen to."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it off the realization in graph/medium-registry and compare it with the authored gmeow:dictionaryStrategy of the definition it gmeow:realizesDictionary; a difference is a reportable finding about the declaration, never a defect in the bytes."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to record which dictionary strategy a build executed, separately from the one it was asked for."@x-gmeow-english .

gmeow:measuredDictionaryTargetLength
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CompressionDictionaryRealization ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measured dictionary target length"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The target dictionary size, in bytes, the trainer was ACTUALLY given — the committed sweep's argmin. Exactly one per realization, and distinct from the authored gmeow:dictionaryTargetLength for the same reason gmeow:measuredDictionaryStrategy is distinct from gmeow:dictionaryStrategy: the authored value is the DECLARED target a human wrote down, this one is what the build ran at. It is NOT gmeow:dictionaryByteLength, which is what the trainer actually returned and may be under the target."@x-gmeow-english ;
    skos:example "ex:realCoreV1 gmeow:measuredDictionaryTargetLength 65536 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property records the target the build ACTUALLY trained at. It is neither the authored request (gmeow:dictionaryTargetLength) nor the size the trainer returned (gmeow:dictionaryByteLength): a target is what the winning sweep cell asked for, a byte length is what came back, and all three values may differ on one dictionary."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid asserting it on the authored gmeow:CompressionDictionary (use gmeow:dictionaryTargetLength there) and avoid confusing it with gmeow:dictionaryByteLength — a target is a request, a byte length is a result."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it off the realization in graph/medium-registry and compare it with the authored gmeow:dictionaryTargetLength; a difference means the declaration has drifted from the measured argmin and is a reportable finding, never something the build silently overwrites."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to record the dictionary size a build actually trained at, separately from the size it was asked for."@x-gmeow-english .

gmeow:measurementBytesOnDisk
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:MediumDictionaryEffectMeasurement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measurement bytes on disk"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The measured population's frames encoded THROUGH the dictionary, in bytes, NOT counting the dictionary's own in-band bytes (those are gmeow:measurementDictionaryInBandBytes, and the sum of the two is gmeow:measurementTwoPartCodeBytes). Splitting the two terms is what makes the reading auditable: a dictionary that shrinks its frames while costing more than it saves is visible as two numbers and invisible as one."@x-gmeow-english ;
    skos:example "ex:effectCoreV1 gmeow:measurementBytesOnDisk 1048576 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property is the DATA half of the two-part code — the population's frames encoded through the dictionary, with the dictionary's own bytes excluded. It is not the total (gmeow:measurementTwoPartCodeBytes, which adds gmeow:measurementDictionaryInBandBytes to it) and not the counterfactual (gmeow:measurementBytesOnDiskBaseline, the same frames with no dictionary at all). Comparing it directly against the baseline would omit the term the criterion turns on."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid folding the dictionary's own bytes into this value — that collapses the two-part code into one number and hides the term the criterion turns on."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Add it to gmeow:measurementDictionaryInBandBytes and compare the sum against gmeow:measurementBytesOnDiskBaseline; a dictionary earns its place only when the sum is strictly smaller."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to record the data half of a dictionary's two-part code."@x-gmeow-english .

gmeow:measurementBytesOnDiskBaseline
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:MediumDictionaryEffectMeasurement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measurement bytes on disk baseline"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The SAME frames of the SAME population encoded through the declared no-dictionary medium gmeow:mediumProfileBaselineL12 — the counterfactual the two-part code is judged against. It is measured on the mandated chain, never on a cheaper proxy codec: a number produced by a codec the bundle does not write would describe bytes nobody ever ships."@x-gmeow-english ;
    skos:example "ex:effectCoreV1 gmeow:measurementBytesOnDiskBaseline 1150000 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property is the NO-DICTIONARY counterfactual for the same frames, taken on the same mandated chain. It is not the dictionary-primed data half (gmeow:measurementBytesOnDisk) and not the total it is judged against (gmeow:measurementTwoPartCodeBytes); it carries no dictionary cost because there is no dictionary in it, and a baseline over different frames, a different codec, or a different level compares nothing."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid comparing against a baseline taken over a different frame set, a different codec, or a different level — the counterfactual is only meaningful when everything but the dictionary is held fixed."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it beside gmeow:measurementTwoPartCodeBytes; the dictionary wins iff the two-part code is strictly less."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to record the no-dictionary counterfactual a dictionary-effect reading is judged against."@x-gmeow-english .

gmeow:measurementCorpusSampleCount
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:MediumDictionaryEffectMeasurement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measurement corpus sample count"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "How many samples the measured dictionary was TRAINED over, carried onto the reading so the train/test relationship is legible without a second lookup. For the archive-backed dictionaries the training corpus is the archive's members MINUS the share gmeow:corpusTrainingSplitV1 withholds, while the evaluated frame is the tar of ALL of them, so this count and gmeow:measurementEvaluatedFrameCount describe PARTLY OVERLAPPING material — recorded, never papered over."@x-gmeow-english ;
    skos:example "ex:effectCoreV1 gmeow:measurementCorpusSampleCount 4213 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property carries the training-set size ONTO the reading, so the train/test overlap is legible without a second lookup. It is the same fact the realization records as gmeow:measuredCorpusSampleCount, restated where it is read, and it is not the number of frames priced (gmeow:measurementEvaluatedFrameCount). A large value here is not evidence of generalization."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid reading a large sample count as evidence of generalization — the two-part code is a non-vacuity argument, not a held-out one."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it beside gmeow:measurementEvaluatedFrameCount to see the shape of the train/test overlap the reading was taken under."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to record the size of the training set behind a dictionary-effect reading."@x-gmeow-english .

gmeow:measurementDictionaryInBandBytes
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:MediumDictionaryEffectMeasurement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measurement dictionary in-band bytes"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The dictionary's OWN bytes as the measured population actually carries them — not one copy per dictionary in general: a bundle pins each dictionary in a single segment header, while an append-only runtime store re-pins the whole dictionary once PER SEGMENT HEADER. This is the model half of the two-part code and the term that makes the criterion non-vacuous: without it, any dictionary that shrank a frame by a byte would 'win', including one whose in-band cost dwarfs the saving."@x-gmeow-english ;
    skos:example "ex:effectCoreV1 gmeow:measurementDictionaryInBandBytes 65536 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property is the MODEL half of the two-part code — what a consumer pays for the dictionary itself, counted as the measured population actually carries it. It is not the frames (gmeow:measurementBytesOnDisk), not the sum (gmeow:measurementTwoPartCodeBytes), and not a per-artifact constant: an append-only runtime store re-pins the whole dictionary in every segment header, so one dictionary costs more there than in a bundle."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid assuming one copy per artifact for a runtime store (each segment header re-pins the whole dictionary) and avoid omitting the term to make a dictionary look better."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Count the dictionary's bytes once per in-band \"dct\" occurrence in the measured artifact and add the total to gmeow:measurementBytesOnDisk."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to record the model half of a dictionary's two-part code — what a consumer pays for the dictionary itself."@x-gmeow-english .

gmeow:measurementEvaluatedFrameCount
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:MediumDictionaryEffectMeasurement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measurement evaluated frame count"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "How many frames of the declared population the reading priced. It exists so the population is VISIBLE rather than implied — in particular so the deliberate exclusion of the snapshot frame from gmeow:mediumPopulationEmittedBlobFrames is legible in the data. That exclusion is not tidiness: the measurement lands inside the snapshot payload, so the snapshot's own compressed length is a function of the numbers being recorded, and including it would make the reading self-referential."@x-gmeow-english ;
    skos:example "ex:effectCoreV1 gmeow:measurementEvaluatedFrameCount 9 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property counts FRAMES PRICED, making the extent of the declared population visible. It is not the number of frames the bundle carries, not the training-sample count beside it (gmeow:measurementCorpusSampleCount), and not itself the population: gmeow:measurementPopulation names which frames, this says only how many."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid comparing two readings whose frame counts differ without saying why, and avoid reading the count as the number of frames the BUNDLE carries — a population is a declared subset."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it to learn how many frames a reading covers, and read gmeow:measurementPopulation to learn which ones."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to make the extent of a dictionary-effect reading's population explicit."@x-gmeow-english .

gmeow:measurementPopulation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MediumDictionaryEffectMeasurement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measurement population"@x-gmeow-english ;
    rdfs:range gmeow:MediumMeasurementPopulation ;
    skos:definition "The declared gmeow:MediumMeasurementPopulation a dictionary-effect reading was taken over. Exactly one per reading, and mandatory: two readings under different populations are measured on different chains and are not commensurable, so a reading that did not name its population would invite exactly the comparison it cannot support."@x-gmeow-english ;
    skos:example "ex:effectCoreV1 gmeow:measurementPopulation gmeow:mediumPopulationEmittedBlobFrames ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property names WHICH declared body of bytes a reading priced, and is the grouping key readings must share before they may be compared. It does not say how many frames that was (gmeow:measurementEvaluatedFrameCount) and does not identify the training material — that is reached through gmeow:measuresDictionary and the dictionary's own corpus."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid omitting it, and avoid naming two populations on one reading — a reading prices one body of bytes."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point every gmeow:MediumDictionaryEffectMeasurement at exactly one seeded population individual, and group readings by it before comparing."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to name which declared body of bytes a dictionary-effect reading priced."@x-gmeow-english .

gmeow:measurementTwoPartCodeBytes
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:MediumDictionaryEffectMeasurement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measurement two-part code bytes"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "gmeow:measurementBytesOnDisk + gmeow:measurementDictionaryInBandBytes — the WHOLE code a consumer pays to hold this dictionary and the frames it primes. It is carried explicitly rather than left to be derived so the criterion a reader checks (strictly less than gmeow:measurementBytesOnDiskBaseline) is one comparison rather than an arithmetic step a reader might skip. There is no tolerance band and no threshold: a tie is a loss, because a dictionary that saves nothing still raises the reader's capability contract."@x-gmeow-english ;
    skos:example "ex:effectCoreV1 gmeow:measurementTwoPartCodeBytes 1114112 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property is the SUM the criterion is checked on: gmeow:measurementBytesOnDisk plus gmeow:measurementDictionaryInBandBytes. It is not either component alone and not the baseline it is compared against (gmeow:measurementBytesOnDiskBaseline). It is carried explicitly rather than derived so the check is one comparison, and it admits no tolerance band — a tie is a loss, because a dictionary that saves nothing still raises the reader's capability contract."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid recording a value that is not the sum of its two components (a reader re-derives it) and avoid softening the strict comparison into a percentage threshold."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Compare it against gmeow:measurementBytesOnDiskBaseline; strictly smaller means the dictionary pays for itself on that population."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to record the whole minimum-description-length code a shipped dictionary costs."@x-gmeow-english .

gmeow:measuresDictionary
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MediumDictionaryEffectMeasurement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "measures dictionary"@x-gmeow-english ;
    rdfs:range gmeow:CompressionDictionary ;
    skos:definition "The AUTHORED gmeow:CompressionDictionary a dictionary-effect reading prices. Exactly one per reading. It points at the DEFINITION rather than at a gmeow:CompressionDictionaryRealization because the reading is about whether the declaration deserves to ship at all, and that question outlives any single build's bytes; the realization is reachable from the definition through gmeow:realizesDictionary when the concrete bytes matter."@x-gmeow-english ;
    skos:example "ex:effectCoreV1 gmeow:measuresDictionary gmeow:dictGmeowCoreV1 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property names the AUTHORED dictionary a reading is about — the declaration, because the question a reading answers is whether that declaration deserves to ship at all. It is not a link to any single build's bytes (reach those from the definition through gmeow:realizesDictionary) and not the medium the priced frames were written through."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid pointing it at a realization (the reading judges the declaration) and avoid a reading that names no dictionary — it would price bytes attributable to nothing."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point every gmeow:MediumDictionaryEffectMeasurement at the authored dictionary it prices; it is the same individual gmeow:observedFeature carries, spelled with a domain-specific name so a medium-axis consumer finds it without walking the generic observation role."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to name which shipped dictionary a dictionary-effect reading is about."@x-gmeow-english .

gmeow:producerCallSite
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "producer call site"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "A repo-relative production source path that authors GMEOW GTS bytes through a mandated-profile authorship door. A stable path string, not localizable prose. Non-functional: one producer may govern several files that write the same artifact through the same medium. The repo-static producer census reads exactly this literal, so a path that names no production authorship site is a stale row and HARD-fails."@x-gmeow-english ;
    skos:example "gmeow:gtsProducerDistBundle gmeow:producerCallSite \"crates/pipeline/src/stages/carrier.rs\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property lists PRODUCTION AUTHORSHIP paths only — files that write GMEOW GTS bytes. It is not a test path, not a file that merely reads or validates GTS, and not a Rust symbol or stage name: the repo-static census matches this literal against the source tree, so a stale path classifies nothing while leaving the map looking complete."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid listing a test file (a producer is production code), avoid listing a file that only READS an artifact (validating or reading a header is not authorship), and avoid leaving a path in place after a rename."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "List the repo-relative path of each production file whose authorship calls this producer governs, exactly as the census spells it (slash-separated, from the repository root)."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to bind a producer row to the production code it classifies, so the producer-to-medium map can be censused against the source rather than trusted."@x-gmeow-english .

gmeow:producerMedium
    a owl:ObjectProperty ;
    rdfs:domain gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "producer medium"@x-gmeow-english ;
    rdfs:range gmeow:Medium ;
    skos:definition "The gmeow:Medium a production GTS-authoring site writes through. Exactly one per producer: a site that wrote through two media would leave its declared-media audit branch underivable, which is the per-call decision the medium axis removes. The audit branch is resolved THROUGH this medium's gmeow:mediumSourceKind rather than redeclared on the producer, so the resolution rule has exactly one source."@x-gmeow-english ;
    skos:example "gmeow:gtsProducerRuntimeStores gmeow:producerMedium gmeow:mediumProfileStoreL12 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property binds a production site to exactly ONE medium. It does not carry the resolution rule (read the medium's gmeow:mediumSourceKind), does not name the artifact written, and does not extend to a site that only reads GTS. A producer with two media would leave its audit branch underivable, which is the per-call decision the medium axis removes."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid naming a medium the slice does not declare and avoid asserting several per producer — an artifact is written through one medium, and there is nothing to pick between two."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point each producer at exactly one declared medium; the audit branch follows from that medium's gmeow:mediumSourceKind."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare which medium a production authorship site writes through."@x-gmeow-english .

gmeow:mediumSourceKind
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Medium ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "medium source kind"@x-gmeow-english ;
    rdfs:range gmeow:MediumSourceKind ;
    skos:definition "How a medium resolves the dictionary for a given payload — per-rep, header-dict, or whole-artifact. Exactly one per medium: an unstated resolution rule is the silent per-call decision the medium axis exists to remove. It carries the RULE, not the dictionary set the rule ranges over (gmeow:mediumDictionary)."@x-gmeow-english ;
    skos:example "gmeow:mediumProfileDistL12 gmeow:mediumSourceKind gmeow:mediumSourcePerRep ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property carries a medium's RESOLUTION RULE, one per medium. It is not the dictionary set the rule ranges over (gmeow:mediumDictionary), not the per-rep selection the rule licenses (gmeow:payloadSchemaDictionary), and it must not be restated on a gmeow:GtsProducer: a producer resolves its audit branch by following its medium to this value, so a second copy could disagree about one artifact."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid omitting it and avoid declaring several kinds on one medium — a medium resolves dictionaries exactly one way."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point each medium at exactly one seeded source-kind individual; a per-rep medium must also declare its gmeow:mediumDictionary set."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare a medium's dictionary-resolution rule as data."@x-gmeow-english .

gmeow:mediumZstdLevel
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ZstdDictMedium ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "medium zstd level"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The declared zstd compression level of a zstd medium. Exactly one per medium, and xsd:integer rather than a non-negative type because the zstd level space includes negative fast levels. The level is DECLARED on the medium — not passed per call — because changing it changes every byte the medium produces, which would silently invalidate byte-comparison gates over the artifacts it wrote."@x-gmeow-english ;
    skos:example "gmeow:mediumProfileDistL12 gmeow:mediumZstdLevel 12 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property pins the compression LEVEL on the medium, where it cannot drift per invocation — a different level is a different medium, not a different call. It is neither a hint nor a default a producer may override, and it is not a quality claim: the level says nothing about whether the round trip holds, which is the business of gmeow:mediumCorrespondence."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid choosing a level per invocation (declare a new medium instead) and avoid asserting several levels on one medium."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one level per zstd medium; a producer reads it from the medium rather than holding its own default."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to pin the compression level a zstd medium encodes at."@x-gmeow-english .

gmeow:payloadSchemaId
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema id"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The stable wire label of a registered payload schema — the EXACT blob representation string the carrier writes (\"cells-archive\", \"diagnostics:nodes\", \"gmeow:report/shacl/sarif\", …). Functional: one label per schema, one schema per label. It is the join key between the ontology registry and the emitter's representation constants, so a rep added in Rust without a schema minted here is caught rather than shipped."@x-gmeow-english ;
    skos:example "gmeow:payloadSchemaCellsArchive gmeow:payloadSchemaId \"cells-archive\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property carries the exact WIRE LABEL of a registered schema, byte-identical to the emitter's representation constant, because it is the join key between registry and carrier. It is not a display name and must not be decorated or abbreviated; it is also not the corpus selector that spells the same string (gmeow:corpusSelectsBlobRep), which names training material rather than a registry entry."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid a decorated or abbreviated label (it must be byte-identical to the emitted rep) and avoid two schemas sharing one label."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Set it to the emitter's representation constant verbatim; the registry-agreement test enumerates the carrier's constants against these literals."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to bind a registered schema individual to the wire rep string it stands for."@x-gmeow-english .

gmeow:payloadSchemaDictionary
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema dictionary"@x-gmeow-english ;
    rdfs:range gmeow:CompressionDictionary ;
    skos:definition "The AUTHORED per-rep dictionary selection: which gmeow:CompressionDictionary out of its medium's declared gmeow:mediumDictionary bound a registered payload schema's payloads are primed with. This is the selection gmeow:mediumSourcePerRep names — 'each registered gmeow:PayloadSchema selects its own dictionary' — written down as data rather than resolved by convention at encode time. AT MOST ONE per schema, and present exactly when the schema's gmeow:payloadSchemaMedium declares a non-empty dictionary set: under the explicitly dictionary-less gmeow:mediumProfileBaselineL12 its ABSENCE is the selection, not an omission. It is the AUTHORED half of what a gmeow:MediumEnvelope's gmeow:envelopeDictionary projects: the envelope states what a frame WAS primed with, this states what its rep MUST be primed with, and the emitter refuses when the two disagree."@x-gmeow-english ;
    skos:example "gmeow:payloadSchemaCellsArchive gmeow:payloadSchemaDictionary gmeow:dictGmeowCoreV1 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property is the AUTHORED per-rep selection — which dictionary a rep's payloads MUST be primed with. It is not the bound the medium sets (gmeow:mediumDictionary lists what is permissible) and not the observation of what a frame was primed with (gmeow:envelopeDictionary projects that off the wire); the emitter refuses when the authored selection and the projected fact disagree. Its absence under the dictionary-less baseline medium is the selection."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid naming a dictionary the schema's gmeow:payloadSchemaMedium does not declare (the medium's gmeow:mediumDictionary set is the bound), avoid asserting several per schema, and avoid asserting one at all on a schema assigned the dictionary-less gmeow:mediumProfileBaselineL12."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Assert it beside gmeow:payloadSchemaMedium on every schema whose assigned medium declares a dictionary set; the medium pass reads the pair as the rep-to-medium assignment and projects it onto each emitted frame's gmeow:MediumEnvelope."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare, per registered payload rep, which shipped dictionary primes it — the authored selection that makes the rep-to-dictionary map total and reviewable without running the build."@x-gmeow-english .

gmeow:payloadSchemaMedium
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema medium"@x-gmeow-english ;
    rdfs:range gmeow:Medium ;
    skos:definition "The AUTHORED rep-to-medium assignment: the gmeow:Medium every payload of a registered gmeow:PayloadSchema is written through. EXACTLY ONE per schema, which is what makes the assignment TOTAL over emittable reps by construction — every rep already has a registered schema, so no payload can fall through to an undeclared medium. It is deliberately authored HERE rather than read back off a gmeow:MediumEnvelope: an envelope is the PROJECTION of an emitted frame, so treating it as the assignment's source would make the assignment a product of the emission it is supposed to govern, and a rep that happened not to be emitted this run would have no medium at all. Its range is read closed-world through gmeow:payloadSchemaMediumRangeClosure."@x-gmeow-english ;
    skos:example "gmeow:payloadSchemaCellsArchive gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property is where the rep-to-medium assignment is AUTHORED, exactly once per registered rep. It is not read back from an emitted gmeow:MediumEnvelope — an envelope is a projection of an emission, so sourcing the rule there would leave a rep that happened not to be emitted this run with no medium at all — and it is not the dictionary half of the assignment (gmeow:payloadSchemaDictionary)."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid leaving it off any registered schema (that is gmeow:MediumUndeclaredDictionary — the assignment is total, so a missing row is a missing declaration), avoid asserting several per schema, and avoid deriving it from an emitted gmeow:MediumEnvelope."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one medium per registered schema in the same change that mints the schema; the medium pass reads it (with gmeow:payloadSchemaDictionary) as the whole rep-to-medium assignment and projects it onto every emitted frame's envelope."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare, per registered payload rep, the lawful encode/decode pair its bytes are written through — the authored assignment the whole medium axis is keyed on."@x-gmeow-english .

gmeow:realizesDictionary
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CompressionDictionaryRealization ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "realizes dictionary"@x-gmeow-english ;
    rdfs:range gmeow:CompressionDictionary ;
    skos:definition "Relates a generated gmeow:CompressionDictionaryRealization to the AUTHORED gmeow:CompressionDictionary it realizes — the join that keeps the definition/realization split from becoming two unrelated registries. Exactly one per realization. It is what makes the retention obligation checkable: a realization whose gmeow:dictionaryVersion its definition no longer declares is an ORPHANED emission (gmeow:MediumDictionaryRegression), because every artifact primed with that version is now undecodable rather than merely deprecated."@x-gmeow-english ;
    skos:example "ex:realCoreV1 gmeow:realizesDictionary gmeow:dictGmeowCoreV1 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property is the JOIN between generated bytes and the authored declaration they answer to, one definition per realization. It is not itself a version claim — the versions are compared by following it, and a realization whose version the definition no longer declares is an orphaned emission — and it must not point at a second definition, which would leave the retention comparison with two answers."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid emitting a realization with no definition to point at (an unowned dictionary is undecodable by construction) and avoid pointing one realization at several definitions."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Emit it from the medium-registry pass alongside the measured fields; the retention constraint follows it back to compare versions."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to bind trained dictionary bytes to the authored declaration they answer to."@x-gmeow-english .

gmeow:requiresReaderCapability
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Medium ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "requires reader capability"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "A capability a reader MUST hold to decode payloads written through this medium. Non-functional: a medium may raise the contract on several axes at once. GTS spec §8.4 makes zstd-rsyncable NON-baseline, so the shipped bundle already demands a non-baseline reader, and dictionary priming raises the contract again — a reader with a zstd library but no dictionary support cannot read a primed frame at all. Principle 13 makes that a DECLARED property of the deliverable rather than a discovery a consumer makes at decode time: a reader compares its own capabilities against this list before starting, and a missing capability surfaces as gmeow:MediumOpaqueFrame (the medium-axis name for the existing gmeow:opacityUnknownCodec situation), never as a silent degraded decode."@x-gmeow-english ;
    skos:example "gmeow:mediumProfileDistL12 gmeow:requiresReaderCapability \"zstd-dictionary\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property declares what a READER must be able to do, on the medium, before anything is decoded. It is not a description of what the encoder did (gmeow:mediumCodec, gmeow:mediumZstdLevel) and not a claim about any particular reader. A reader lacking a listed capability surfaces gmeow:MediumOpaqueFrame rather than degrading, so omitting an entry does not make a payload more portable, only its failure less legible."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid leaving a non-baseline requirement undeclared (silently raising the reader contract is exactly what Principle 13 forbids) and avoid listing capabilities the medium does not actually need."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "List every non-baseline capability the medium demands, in sorted order; a consumer intersects the list with its own capabilities before decoding."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare, on the deliverable, exactly what a reader must be able to do to read it."@x-gmeow-english .

gmeow:splitHeldOutOffset
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CorpusTrainingSplit ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "split held-out offset"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "Which position within each stride is the HELD-OUT one: a member whose content-digest rank is congruent to this value modulo gmeow:splitHeldOutStride is never handed to the trainer, while the frame the dictionary is evaluated over still carries it. Exactly one per gmeow:CorpusTrainingSplit. An offset at or above the stride is a HARD FAIL — no rank could ever land on it, so the split would hold nothing out while still claiming to."@x-gmeow-english ;
    skos:example "gmeow:corpusTrainingSplitV1 gmeow:splitHeldOutOffset 0 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property picks WHICH position inside each stride is withheld, and means nothing without gmeow:splitHeldOutStride, which fixes how wide a stride is. It is not a member index, not a count of held-out members, and not a knob for moving a chosen file across the boundary: the partition is keyed on content, so choosing an offset to admit particular bytes defeats the rule it implements."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid a value at or above gmeow:splitHeldOutStride (no rank could land on it) and avoid changing it to move a specific member across the boundary — the split is a rule about content, not a way to choose which bytes a dictionary gets to see."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Declare it once beside gmeow:splitHeldOutStride; the pair is the whole rule, and a reader who can print a corpus's member digests can reproduce either side of the partition."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to name which position of the declared stride is the held-out one."@x-gmeow-english .

gmeow:splitHeldOutStride
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CorpusTrainingSplit ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "split held-out stride"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "How often a member is held out, counted over the corpus's archive members RANKED BY THEIR OWN CONTENT DIGEST: one member in every gmeow:splitHeldOutStride is withheld from the trainer. Exactly one per gmeow:CorpusTrainingSplit. A stride over RANKS rather than over digest values is deliberate and is what makes properness a THEOREM: a residue rule (digest mod 8 = 0) holds nothing out of a four-member corpus most of the time, and the shipped claim corpus is exactly four members, so on most builds such a split would silently do nothing — which is the failure it exists to prevent. Ranking holds out exactly ceil(n / stride) members for a corpus of n. A stride below 2 is a HARD FAIL: it holds out every member and leaves no training set at all."@x-gmeow-english ;
    skos:example "gmeow:corpusTrainingSplitV1 gmeow:splitHeldOutStride 8 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property sets HOW OFTEN a member is withheld, counted over content-digest RANKS rather than digest values, which is what makes the partition proper for a corpus of any size. It is not the position within the stride (gmeow:splitHeldOutOffset) and not a per-corpus setting: one value governs every archive-backed corpus, so raising it past the smallest corpus's member count is a hard fail rather than a local trade-off."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid a value below 2 (it does not leave a training set) and avoid raising it past the member count of the smallest archive-backed corpus — a corpus the split cannot partition is a hard fail, not a quietly self-measured dictionary."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Declare it once on the single gmeow:CorpusTrainingSplit individual; every archive-backed corpus is resolved under it, and the resulting held-out cardinality is recorded per dictionary in bench/medium-baseline.json."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare, as data, what share of an archive-backed corpus is withheld from training."@x-gmeow-english .

gmeow:strataDigest
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:MediumEnvelope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "strata digest"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The digest of the sub-payload named by gmeow:envelopeDigestStratum, written 'blake3:<hex>'. Exactly one per envelope. It is deliberately NOT a subproperty of gmeow:contentDigest: contentDigest is byte-exact identity of the WHOLE artifact, and a consumer that treated a stratum digest as whole-artifact identity would compare unequal things. The two coexist on every envelope — gmeow:contentDigest carries snapshot_content_id() verbatim, so the stratum digest is a strict ADDITION to the total witness, never a replacement for it. Without the stratum the snapshot envelope would be self-referential and its emission would not converge."@x-gmeow-english ;
    skos:example "ex:env gmeow:strataDigest \"blake3:9f2c4e…\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property carries the digest VALUE for the region gmeow:envelopeDigestStratum names. It is not artifact identity, and it is deliberately not a subproperty of gmeow:contentDigest, which the same envelope carries verbatim from the frame: a consumer that used this in place of that would compare a sub-payload against a whole artifact and find them unequal for the wrong reason."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid asserting it without gmeow:envelopeDigestStratum (a digest with no stated region is uncheckable) and avoid using it in place of gmeow:contentDigest for artifact identity."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Compute it over exactly the named stratum in the first emission pass and write it in the second; keep gmeow:contentDigest beside it carrying the frame's own in-band digest."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to commit to a sub-payload whose digest a whole-payload digest cannot stably express."@x-gmeow-english .

gmeow:trainsOverCorpus
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "trains over corpus"@x-gmeow-english ;
    rdfs:range gmeow:DictionaryCorpus ;
    skos:definition "The gmeow:DictionaryCorpus a compression dictionary trains over. Exactly one per dictionary: a dictionary trained over two independently-declared corpora has no reviewable training set, and the corpus is where the bundle-internal guarantee is stated and checked. It names the DECLARED material, not the resolution: what the trainer was actually handed is recorded on the realization (gmeow:measuredCorpusSampleCount, gmeow:measuredCorpusDigest). Its range is read closed-world through gmeow:trainsOverCorpusRangeClosure so the derived dictionary shape carries sh:class."@x-gmeow-english ;
    skos:example "gmeow:dictGmeowCoreV1 gmeow:trainsOverCorpus gmeow:corpusGmeowCoreV1 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property binds a dictionary to exactly ONE declared corpus. It does not carry the corpus's contents (the selectors live on the gmeow:DictionaryCorpus), does not describe the resolution the trainer actually saw (gmeow:measuredCorpusSampleCount, gmeow:measuredCorpusDigest), and does not name the split applied to it — the split is a single global rule, never a per-dictionary attachment."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid minting a dictionary with no corpus (its training set would be undeclared) and avoid attaching several corpora — widen the single corpus's selectors instead."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point each dictionary at exactly one corpus and put every selector on that corpus; the trainer resolves the selectors against the carrier at build time."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to declare which corpus a dictionary is trained from."@x-gmeow-english .

gmeow:zstdDictionaryId
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CompressionDictionaryRealization ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "zstd Dictionary_ID"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The numeric Dictionary_ID the trained dictionary carries in its own header and that a zstd frame cites (RFC 8878 §3.1.1) — a realization field, produced by the trainer. Distinct from gmeow:dictionaryId, which is the authored human-readable name: the wire cites the number, a reviewer reads the name, and only the realization can bind the two."@x-gmeow-english ;
    skos:example "ex:realCoreV1 gmeow:zstdDictionaryId 2118436947 ."@x-gmeow-english ;
    skos:scopeNote "Scope: this property carries the NUMERIC on-wire dictionary identity from the trained dictionary's own header. It is not the authored human-readable name (gmeow:dictionaryId) and not a byte-exact identity (gmeow:dictionaryContentDigest): a 32-bit header field does not identify bytes, it only routes a frame to a candidate. It cannot be authored, because the trainer assigns it."@x-gmeow-english ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:avoidWhen "Avoid asserting it on an authored gmeow:CompressionDictionary (the trainer assigns it) and avoid conflating it with the human-readable gmeow:dictionaryId."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernGTSPackaging ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Emit it from the medium-registry pass; a decoder reading a frame's Dictionary_ID resolves it here to reach the authored definition and its corpus."@x-gmeow-english ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:useWhen "Use to bind the on-wire numeric dictionary identity to the ontology's named dictionary."@x-gmeow-english .

# --- Value-vocabulary individuals ------------------------------------------- #

gmeow:codecZstdRsyncable
    a gmeow:TransformCodec ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "zstd-rsyncable codec"@x-gmeow-english ;
    skos:definition "RFC 8878 Zstandard compression in rsyncable mode: content-defined block boundaries so a local edit perturbs only nearby blocks and delta transfer stays cheap. GTS spec §8.4 classifies it as NON-baseline, so a segment using it raises the reader contract (declared with gmeow:requiresReaderCapability, never assumed)."@x-gmeow-english ;
    gmeow:codecClass gmeow:codecClassCompress ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictStrategyRawContent
    a gmeow:DictionaryStrategy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "raw content"@x-gmeow-english ;
    skos:definition "The dictionary is a chosen byte range used verbatim as content, with no trainer pass — the honest record when a corpus is too small for the COVER trainer to beat raw content."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictStrategyTermTable
    a gmeow:DictionaryStrategy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "term table"@x-gmeow-english ;
    skos:definition "The dictionary is synthesized from the ontology's own term vocabulary — IRIs, prefixes, and predicate names in frequency order — rather than sampled from serialized payloads."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictStrategyTrained
    a gmeow:DictionaryStrategy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "trained"@x-gmeow-english ;
    skos:definition "The dictionary is produced by the zstd COVER / fastCover trainer over the declared corpus — the default strategy for a corpus large enough to train on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:mediumSourceHeaderDict
    a gmeow:MediumSourceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "header dictionary"@x-gmeow-english ;
    skos:definition "One dictionary is declared in the segment header and every frame of the segment primes with it — the whole-segment resolution rule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:mediumSourcePerRep
    a gmeow:MediumSourceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "per rep"@x-gmeow-english ;
    skos:definition "Each registered gmeow:PayloadSchema selects its own dictionary from the medium's declared gmeow:mediumDictionary set — the resolution rule that makes the rep-to-dictionary map total and derivable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:mediumSourceWholeArtifact
    a gmeow:MediumSourceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "whole artifact"@x-gmeow-english ;
    skos:definition "The medium applies to the finished artifact as a unit with no per-frame dictionary selection — the rule a whole-artifact producer and the runtime store use."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:stratumPayloadExcludingMediumEnvelope
    a gmeow:DigestStratum ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload excluding the medium-envelope subgraph"@x-gmeow-english ;
    skos:definition "The snapshot payload MINUS the medium-envelope subgraph. The stratum the snapshot envelope's gmeow:strataDigest is taken over: because the digest's region excludes the envelope, adding the envelope cannot change the digest, so a two-pass emission (digest the stratum, then write the envelope) provably reaches a fixed point in exactly two passes — where a whole-payload digest would not converge at all."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:stratumWholePayload
    a gmeow:DigestStratum ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "whole payload"@x-gmeow-english ;
    skos:definition "The entire frame payload. Legal only for an envelope that is NOT itself carried inside the payload it digests — a non-self-referential frame, where no stratification is needed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

# --- The two declared media ------------------------------------------------- #
# Each medium DECLARES BOTH gmeow:ZstdDictMedium and gmeow:Medium.
#
# The subsumption gmeow:ZstdDictMedium ⊑ gmeow:Medium is authored ONCE, canonically,
# as the logic:subClassOf axiom on the class; it is deliberately NOT restated as
# rdfs:subClassOf, which would be a second source of truth for an axiom logic: already
# owns. But the medium registry is read CLOSED-WORLD — the logic:ClosureEntry records
# below turn the gmeow:Medium range of gmeow:payloadSchemaMedium (and the class-qualified
# gmeow:producerMedium obligation) into a validation obligation whose words are "a
# DECLARED gmeow:Medium, never an untyped node standing in for one". A closed-world
# reading asks what an individual DECLARES, never what a reasoner could derive about it,
# so each medium says it.
#
# The general type is therefore an ASSERTION OF THE ENTAILMENT, never an alternative to
# the axis: dropping the zstd specialization would lose the level/dictionary coordinates
# its own shape enforces, and dropping the general type would leave every rep-to-medium
# and producer-to-medium assignment unresolvable against the very obligation that
# assignment exists to discharge. gmeow_pipeline::medium::registry::read_media already
# reads the UNION of both spellings for exactly this reason.

gmeow:mediumProfileBaselineL12
    a gmeow:Medium ,
        gmeow:ZstdDictMedium ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "baseline medium — zstd-rsyncable level 12, no dictionary"@x-gmeow-english ;
    skos:definition "The EXPLICITLY DECLARED no-dictionary medium: zstd-rsyncable at level 12 with an empty gmeow:mediumDictionary set. It exists to make the rep-to-medium assignment TOTAL — 'no dictionary' is a named selection a producer makes, not an absence a frame falls through into, so there is no state in which a payload has no declared medium. LEGAL for whole-artifact producers and for the runtime store, whose payloads are written once and never re-primed. ILLEGAL for the gmeow:gtsProfileDist profile: a distribution snapshot is the shipped deliverable, its reps are exactly the ones the shipped dictionaries were trained for, and emitting it unprimed silently discards the density the dictionaries exist to provide while still demanding the same non-baseline reader."@x-gmeow-english ;
    gmeow:mediumCodec gmeow:codecZstdRsyncable ;
    gmeow:mediumZstdLevel 12 ;
    gmeow:mediumSourceKind gmeow:mediumSourceWholeArtifact ;
    gmeow:mediumCorrespondence gmeow:mediumCorrBaselineL12 ;
    gmeow:requiresReaderCapability "zstd-rsyncable" ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:mediumProfileDistL12
    a gmeow:Medium ,
        gmeow:ZstdDictMedium ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dist medium — zstd-rsyncable level 12, dictionary-primed"@x-gmeow-english ;
    skos:definition "The MANDATED dictionary-primed production medium: zstd-rsyncable at level 12, resolving a dictionary per registered gmeow:PayloadSchema from the shipped dictionary inventory. It is the medium the gmeow:gtsProfileDist distribution snapshot is written through; gmeow:mediumProfileBaselineL12 is illegal there. It demands two non-baseline reader capabilities — rsyncable framing (GTS spec §8.4) and dictionary priming — and declares both, because raising the reader contract is a property of the deliverable (Principle 13), never a discovery a consumer makes mid-decode."@x-gmeow-english ;
    gmeow:mediumCodec gmeow:codecZstdRsyncable ;
    gmeow:mediumZstdLevel 12 ;
    gmeow:mediumSourceKind gmeow:mediumSourcePerRep ;
    gmeow:mediumCorrespondence gmeow:mediumCorrDistL12 ;
    gmeow:requiresReaderCapability "zstd-dictionary" ,
        "zstd-rsyncable" ;
    gmeow:mediumDictionary
        gmeow:dictGmeowCoreV1 ,
        gmeow:dictGmeowLangAstV1 ,
        gmeow:dictGmeowLogicV1 ,
        gmeow:dictGmeowMemoryCompactV1 ,
        gmeow:dictGmeowMemoryHotV1 ,
        gmeow:dictGmeowProoftraceV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:mediumProfileStoreL12
    a gmeow:Medium ,
        gmeow:ZstdDictMedium ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "store medium — zstd-rsyncable level 12, header-pinned dictionary"@x-gmeow-english ;
    skos:definition "The medium the APPEND-ONLY RUNTIME STORES are written through: zstd-rsyncable at level 12, resolving its dictionary from the entry the SEGMENT HEADER pins (gmeow:mediumSourceHeaderDict) rather than per registered payload schema. A store carries no gmeow:PayloadSchema registry and no graph/medium-registry — it cites bundle dictionaries by id, obtained from the shipped pack's in-band \"dct\" map — so a per-rep rule would be unresolvable there and the dictionary-less gmeow:mediumProfileBaselineL12 would silently discard the priming an agent-memory record most benefits from (a few hundred bytes of claim against a shared vocabulary). Its gmeow:mediumDictionary bound is exactly the two memory dictionaries: a store primed with a dictionary the bundle does not ship could never be re-primed by a consumer holding only that bundle."@x-gmeow-english ;
    gmeow:mediumCodec gmeow:codecZstdRsyncable ;
    gmeow:mediumZstdLevel 12 ;
    gmeow:mediumSourceKind gmeow:mediumSourceHeaderDict ;
    gmeow:mediumCorrespondence gmeow:mediumCorrStoreL12 ;
    gmeow:requiresReaderCapability "zstd-dictionary" ,
        "zstd-rsyncable" ;
    gmeow:mediumDictionary gmeow:dictGmeowMemoryCompactV1 ,
        gmeow:dictGmeowMemoryHotV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

# --- The declared dictionary-effect populations ------------------------------ #
# Two, and no third: the bundle this build writes, and the runtime store a
# consumer writes. They are measured on different chains and their in-band
# dictionary cost is paid differently (once per artifact vs once per segment
# header), so a reading MUST name which one it priced.

gmeow:mediumPopulationEmittedBlobFrames
    a gmeow:MediumMeasurementPopulation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "population — emitted blob frames"@x-gmeow-english ;
    skos:definition "Every payload-bearing BLOB frame the terminal emission authors into gmeow.gts, grouped by the dictionary its gmeow:PayloadSchema selects. The SNAPSHOT frame is DECLARED-excluded: the dictionary-effect measurement is folded into the snapshot payload, so that frame's compressed length is a function of the very numbers being recorded, and pricing it would make the reading self-referential. The exclusion is a THEOREM, not a concession, and the gmeow:envelopeDigestStratum two-pass fixpoint cannot repair it: that fixpoint converges because gmeow:strataDigest is taken over a REGION (gmeow:stratumPayloadExcludingMediumEnvelope) that excludes the records being added, so adding them cannot move the digest. gmeow:measurementBytesOnDisk has no such region — it is the compressed length of the WHOLE frame, and compression is not additive over regions, so no proper sub-region's compressed length equals the frame's; a 'payload minus the measurement subgraph' length would be a number produced by a codec the bundle does not write, which gmeow:measurementBytesOnDiskBaseline already forbids for the same reason. It is also MOOT for the inventory: gmeow:payloadSchemaDictionary is maxQualifiedCardinality 1 and gmeow:payloadSchemaSnapshotWire binds gmeow:dictGmeowCoreV1, so admitting the snapshot frame could only move that one dictionary's numbers and could never give any other dictionary a frame. A frame assigned the dictionary-less gmeow:mediumProfileBaselineL12 belongs to no dictionary's population — it has no dictionary to pay for. The dictionary's in-band cost is counted ONCE here, because a pack pins each dictionary in a single segment header."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:mediumPopulationRuntimeStoreSegments
    a gmeow:MediumMeasurementPopulation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "population — runtime store segments"@x-gmeow-english ;
    skos:definition "The append-only runtime store files a CONSUMER writes with a dictionary obtained from the shipped pack's in-band \"dct\" map, replayed over a declared, bundle-derived corpus through the real store-write paths. The dictionary's in-band cost is counted ONCE PER SEGMENT HEADER, not once per file: a store that opened a header per record would re-pin the whole dictionary each time, so whether a store dictionary pays for itself is a pure function of the record count. The corpus cardinality is therefore recorded beside every reading. Its byte counts are a projection of the committed bench/medium-baseline.json evidence rather than a per-build measurement, because a runtime store's records carry a wall clock and are not a function of the build; the LIVE gate over real store files is the whole-bundle medium test."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

# --- The producer→medium map (one row per production authorship site) -------- #
# The declared-media audit dispatches on gmeow:mediumSourceKind, so the split is a
# TOTAL FUNCTION over producers only if every production site that authors GMEOW
# GTS bytes has a row here. `crates/validate`'s Seal C censuses every production
# call of a mandated-profile authorship door and HARD-fails a call site no row
# claims — and a row that claims no call site. Without that census, "a producer
# with no declared kind is a hard fail" would only ever fire on a fixture.

gmeow:gtsProducerDistBundle
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the distribution bundle"@x-gmeow-english ;
    skos:definition "The terminal carrier that emits generated/dist/gmeow.gts. It is the ONLY producer that writes through a per-rep medium, because it is the only one that carries a gmeow:PayloadSchema registry and a graph/medium-registry for a reader to resolve reps against."@x-gmeow-english ;
    gmeow:producerCallSite "crates/pipeline/src/stages/carrier.rs" ;
    gmeow:producerMedium gmeow:mediumProfileDistL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProducerRuntimeStores
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the append-only runtime stores"@x-gmeow-english ;
    skos:definition "The MCP agent-memory, conjecture-library and compaction lanes. They carry no graph/medium-registry — they cite bundle dictionaries by id, read out of the shipped pack's in-band \"dct\" map — so they resolve their dictionary from the segment header, which is what gmeow:mediumProfileStoreL12 declares."@x-gmeow-english ;
    gmeow:producerCallSite "crates/mcp/src/lib.rs" ;
    gmeow:producerMedium gmeow:mediumProfileStoreL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProducerRuntimeStoreSegments
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the runtime store segment boundary"@x-gmeow-english ;
    skos:definition "The storage backend that opens a runtime store's segment when the store's tail does not already pin the medium the server resolved. A segment declares exactly ONE codec catalog, so a store whose tail predates the current medium needs a boundary before anything is appended into it; without one the appended record names a catalog that tail never declared and the store stops reconstructing. It authors a segment HEADER only — the records themselves are written by gmeow:gtsProducerRuntimeStores through the same gmeow:mediumProfileStoreL12."@x-gmeow-english ;
    gmeow:producerCallSite "crates/mcp/src/storage.rs" ;
    gmeow:producerMedium gmeow:mediumProfileStoreL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProducerFeedbackBundle
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the feedback bundle"@x-gmeow-english ;
    skos:definition "The gmeow-dev feedback bundle: a small, self-contained artifact assembled from a session's findings. It carries no payload-schema registry, so the whole artifact is written through one declared medium."@x-gmeow-english ;
    gmeow:producerCallSite "crates/gmeow-dev-cli/src/feedback_bundle.rs" ;
    gmeow:producerMedium gmeow:mediumProfileBaselineL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProducerMathBundle
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the math bundle"@x-gmeow-english ;
    skos:definition "The math producer's on-demand bundle. A whole-artifact deliverable with no rep registry of its own, so one declared medium governs every frame."@x-gmeow-english ;
    gmeow:producerCallSite "crates/math/src/lib.rs" ;
    gmeow:producerMedium gmeow:mediumProfileBaselineL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProducerMusicBundle
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the music bundle"@x-gmeow-english ;
    skos:definition "The music producer's on-demand bundle, the twin of the math one: a whole-artifact deliverable governed by a single declared medium."@x-gmeow-english ;
    gmeow:producerCallSite "crates/music/src/lib.rs" ;
    gmeow:producerMedium gmeow:mediumProfileBaselineL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProducerConvertExit
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the convert --to gts exit"@x-gmeow-english ;
    skos:definition "The transformed-consumer-output door: `gmeow convert --to gts` serializes a frozen carrier straight to GTS bytes. The output describes whatever the consumer handed in, so it carries no registry of its own and one declared medium governs the whole artifact."@x-gmeow-english ;
    gmeow:producerCallSite "crates/transcode/src/lib.rs" ;
    gmeow:producerMedium gmeow:mediumProfileBaselineL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProducerTransformOutput
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the MAXIMAL(G) transform output"@x-gmeow-english ;
    skos:definition "The native MAXIMAL(G) transform's GTS emission. Its output is a single saturated graph with no blob-rep registry, so one declared medium governs it end to end."@x-gmeow-english ;
    gmeow:producerCallSite "crates/pipeline/src/transform.rs" ;
    gmeow:producerMedium gmeow:mediumProfileBaselineL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProducerCorrespondenceLowering
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the correspondence lowering"@x-gmeow-english ;
    skos:definition "The correspondence-lowering stage's GTS emission of a single lowered alignment graph. A whole-artifact product with no rep registry."@x-gmeow-english ;
    gmeow:producerCallSite "crates/pipeline/src/stages/correspondence_lower.rs" ;
    gmeow:producerMedium gmeow:mediumProfileBaselineL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProducerDocsMeasure
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the docs byte measurement"@x-gmeow-english ;
    skos:definition "The docs-distribution byte measurement, which emits candidate bundles solely to weigh them. Its bytes are never shipped — but it is still a production authorship site, and a producer whose output is discarded is exactly the kind of site an exemption list would quietly swallow, so it declares its medium like any other."@x-gmeow-english ;
    gmeow:producerCallSite "crates/pipeline/src/docs_measure.rs" ;
    gmeow:producerMedium gmeow:mediumProfileBaselineL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:gtsProducerReleaseBundle
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the signed release bundle"@x-gmeow-english ;
    skos:definition "The release lane's signed re-emission. It re-authors an already-assembled carrier under a signing key rather than re-running the terminal's rep→medium assignment, so it is a whole-artifact producer: one medium governs the artifact it signs."@x-gmeow-english ;
    gmeow:producerCallSite "crates/pipeline/src/stages/release.rs" ;
    gmeow:producerMedium gmeow:mediumProfileBaselineL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

# --- The losslessness correspondences (meta-level; graph/correspondence-laws) - #
# Each medium's dec ∘ enc = id claim is a judged crossing, never a boolean. The
# rung is logic:SectionRetraction (put ∘ get = id_S on the declared content
# domain — the encoded byte space need not be recovered pointwise, so the top
# logic:Isomorphism rung would overclaim), the relation is logic:Subsumes, and
# the preservation judgment is IDENTITY (logic:ExactPreservation). Each carries a
# get-leg witness whose derived put is discharged by EXECUTION in the
# authored-correspondence gate, so the rung is a checked witness rather than a
# prose claim. These records are meta-level: the pipeline re-projects every
# authored logic:Correspondence into the graph/correspondence-laws named graph
# with its executed lens-law verdicts attached, OUTSIDE object-level closure.
# Both endpoints are internal gmeow: terms — this is the medium's OWN round-trip
# law, not a grounding to an external formalism (external grounding is owned by
# logic:/lang:/math: alone, docs/GROUNDING.md), so no competing grounding is
# minted here and the zstd/GTS-SPEC references stay prose citations.

gmeow:mediumCorrBaselineL12
    a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "baseline-L12 medium losslessness correspondence"@x-gmeow-english ;
    skos:definition "The judged crossing realized by gmeow:mediumProfileBaselineL12: decoding an unprimed zstd-rsyncable level-12 payload recovers the declared content domain exactly (dec ∘ enc = id). The preservation judgment is identity; the rung is a section/retraction because the recovery claim is over the CONTENT domain, not over every byte string the codec could emit."@x-gmeow-english ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint gmeow:PayloadSchema ;
    logic:targetEndpoint gmeow:MediumEnvelope ;
    logic:morphismClass logic:SectionRetraction ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true ;
    logic:getLeg gmeow:mediumCorrBaselineL12Get .

gmeow:mediumCorrBaselineL12Get
    a logic:TransactionProgram ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "baseline medium get leg"@x-gmeow-english ;
    skos:definition "The get leg of the dictionary-less baseline medium's round-trip lens: the transaction program that reads a payload back out of a frame written through gmeow:mediumProfileBaselineL12. It names the recovery half of the correspondence, so the medium's exactness claim is carried by a program rather than asserted in prose."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:path gmeow:mediumCorrBaselineL12Step .

gmeow:mediumCorrDistL12
    a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dist-L12 medium losslessness correspondence"@x-gmeow-english ;
    skos:definition "The judged crossing realized by gmeow:mediumProfileDistL12: decoding a dictionary-primed zstd-rsyncable level-12 payload, with the dictionary the frame declares, recovers the declared content domain exactly (dec ∘ enc = id). Priming changes the CODE, never the content: the same content domain is recovered, which is why the preservation judgment is identity and the dictionary appears as a coordinate of the crossing rather than as a caveat on it. The claim is conditional on holding the cited dictionary — a decoder that cannot resolve it raises gmeow:MediumUnknownDictionary and refuses, so the law is never silently weakened to a dictionary-less decode."@x-gmeow-english ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint gmeow:PayloadSchema ;
    logic:targetEndpoint gmeow:MediumEnvelope ;
    logic:morphismClass logic:SectionRetraction ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true ;
    logic:getLeg gmeow:mediumCorrDistL12Get .

gmeow:mediumCorrDistL12Get
    a logic:TransactionProgram ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dist medium get leg"@x-gmeow-english ;
    skos:definition "The get leg of the mandated distribution medium's round-trip lens: the transaction program that reads a payload back out of a dictionary-primed frame written through gmeow:mediumProfileDistL12. Priming changes the bytes but not the recovered payload, which is exactly what this leg makes checkable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:path gmeow:mediumCorrDistL12Step .

gmeow:mediumCorrStoreL12
    a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "store-L12 medium losslessness correspondence"@x-gmeow-english ;
    skos:definition "The judged crossing realized by gmeow:mediumProfileStoreL12: decoding a payload primed with the dictionary the SEGMENT HEADER pins recovers the declared content domain exactly (dec ∘ enc = id). It differs from gmeow:mediumCorrDistL12 only in where the dictionary is resolved from — one entry per segment rather than one per registered payload schema — which is why it is a separate judged crossing rather than a caveat on that one: a store carries no gmeow:PayloadSchema registry, so its recovery claim is conditional on the segment header alone."@x-gmeow-english ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint gmeow:PayloadSchema ;
    logic:targetEndpoint gmeow:MediumEnvelope ;
    logic:morphismClass logic:SectionRetraction ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true ;
    logic:getLeg gmeow:mediumCorrStoreL12Get .

gmeow:mediumCorrStoreL12Get
    a logic:TransactionProgram ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "store medium get leg"@x-gmeow-english ;
    skos:definition "The get leg of the append-only store medium's round-trip lens: the transaction program that reads a record back out of a segment written through the runtime store profile. A store is appended to over its whole life, so its recovery leg is what keeps every earlier record readable after a later append."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:path gmeow:mediumCorrStoreL12Step .

# --- The seven shipped dictionaries and their corpora ------------------------ #
# The governing rule, which every entry below satisfies and which decided the one
# term the inventory does NOT carry:
#
#   A gmeow:CompressionDictionary is justified by the FRAME SET it primes, and it
#   must PAY FOR ITS OWN IN-BAND BYTES on that set. Topical importance is not a
#   justification, and neither is a slice name.
#
# The inventory was first drafted from SLICE NAMES, which is why three drafts were
# measured over frame sets that did not exist yet. The answer for two of them was to
# BUILD the frame set the name claimed, not to drop the term:
#
#   * "gmeow-lang-ast-v1" was measured over ~264 KB — the projection tree plus the
#     document-scale surface literals — and lost by 3,684 B. The two largest lang:
#     deliverables were not in that population at all: the ISO-30042 TBX termbase
#     and the glossary table (~18 MB together) rode the general opaque archive, so
#     the core dictionary primed the very natural-language term inventory a
#     linguistic dictionary exists for. They are projections of the SAME reviewed
#     .po fold as the rest of the family, produced by the SAME export leaf, and they
#     were already opaque byte projections — so they now ride
#     gmeow:payloadSchemaLangProjectionsArchive with their family, and the dictionary
#     is measured over the population its name always claimed.
#   * "gmeow-claims-v1" was measured over ONE ~9 KB frame (the yaml-ld-archive) and
#     coded it at 12,020 B against an 8,953 B no-dictionary baseline — no cell of the
#     grid can pay for a dictionary over a population that small. The statement
#     layer's own two byte projections (~274 KB of reifier IRIs, annotation-coat
#     predicates and standpoint qualifiers) were sitting on the general opaque
#     archive, byte-decorated and therefore already travelling as bytes. They now
#     ride gmeow:payloadSchemaStatementsArchive, and the claim dictionary is measured
#     over the claim corpus's whole frame set.
#
# In both cases NOTHING that was a graph became bytes: the queryable
# lang:ProjectionEmission, graph/lang-glossary-corpus and graph/statements semantics
# ride their named graphs exactly as before, and only the MEDIUM ASSIGNMENT of bytes
# that were already bytes changed. The measurement is the adjudicator either way —
# gmeow_pipeline::medium::sweep::check_dictionaries_pay_for_themselves hard-fails the
# build for a dictionary that does not clear the two-part code, and there is no
# exemption, allowlist or carve-out for any dictionary in the inventory.
#
# WHY THERE IS NO "gmeow-math-v1". This one is not a measurement that came out badly;
# it is a THEOREM, and the premises are these:
#
#   (1) A frame's dictionary is a function on the FRAME. gmeow:payloadSchemaDictionary
#       is maxQualifiedCardinality 1 (see the restriction below), and the composer's
#       FrameSlot::Snapshot is singular by TYPE and by construction — purrdf's
#       gts_compose has exactly one add_frame_with_options("snapshot", …) call.
#   (2) Every math: named graph is UNIONED INTO THE SNAPSHOT PAYLOAD. By (1) that is
#       one frame, and it already binds gmeow:dictGmeowCoreV1 through
#       gmeow:payloadSchemaSnapshotWire. A second dictionary on part of it is not
#       merely unhelpful — it is unrepresentable.
#   (3) The escape used for lang: and claims: — give the family its own BYTE rep — is
#       unavailable, because there is no mathematical byte family to give. The archive
#       fold's sources are dsl/mappings/**, the per-slice mappings/ and tests/ trees,
#       and the shape surfaces; slices/grounding/math/** reaches the bundle ONLY as
#       parsed RDF in the fold.
#   (4) Manufacturing one would be forbidden anyway. De-folding a named graph into
#       bytes trades queryable structure for compression, and carrying it BOTH ways
#       violates carry-exactly-once (PIPELINE_SPINE §5, Constitution §18) and the
#       rep-class disjointness the superset gate enforces.
#
# THEREFORE the mathematical content is primed, IN FULL, by gmeow-core-v1, and is
# fully SPARQL-able off the fold. No compression and no ontological use is lost — the
# absent term is the absence of a SECOND name for a frame that already has one, which
# is why this costs nothing against MAXIMAL INFORMATION FLOW.
#
# Every entry below names at least one gmeow:PayloadSchema through
# gmeow:payloadSchemaDictionary, or is bound by a gmeow:mediumSourceHeaderDict medium
# whose frames a CONSUMER writes.
#
# EVERY corpus is BUNDLE-INTERNAL. The two memory dictionaries train on the
# BUNDLE-SHIPPED claim corpora (generated/statements/*, the authoring packets),
# never on a user's runtime ~/.gmeow/memory.gts, for three independent reasons,
# each sufficient on its own: (1) PRIVACY — a zstd dictionary contains VERBATIM
# SUBSTRINGS of its training corpus, so training on live user memory would bake
# private claim fragments into a published bundle; (2) AVAILABILITY — a fresh
# install has an empty store, so a build that needed one would hard-fail on the
# machine that most needs the dictionary; (3) PROJECTION PURITY — the bundle must
# be a projection of the repository, and a dictionary trained on out-of-tree data
# is not one. The memory dictionaries are therefore priming aids derived from the
# SHAPE of shipped claims, not from any user's content.

# The ONE held-out split every archive-backed corpus above is resolved under.
# An archive-backed corpus selects an archive's MEMBERS while the frame its
# dictionary is evaluated over is the TAR of those members, so training on all of
# them would score the dictionary on bytes it had memorised. One member in eight —
# every 8th in canonical content-digest order, so the partition is reproducible from
# the corpus alone and cannot be steered per dictionary — is withheld from the
# trainer and left in the evaluated frame.
#
# What that buys, exactly: every archive-backed reading is scored partly on members
# its dictionary never saw. What it does NOT buy: the frame is not held out (most of
# its bytes ARE training material), and nothing here says a dictionary generalises to
# material outside the bundle — the population a bundle dictionary primes IS the
# bundle's own frames, so no experiment here could.
gmeow:corpusTrainingSplitV1
    a gmeow:CorpusTrainingSplit ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "corpus training split v1"@x-gmeow-english ;
    skos:definition "The shipped held-out split: rank a corpus's archive members by their own canonical blake3: digest and withhold every 8th, starting at rank 0. It governs EVERY archive-backed gmeow:DictionaryCorpus uniformly; there is no per-dictionary variant and no exemption. One in eight rather than a larger share leaves the trainer the repeated structure a dictionary exists to capture, and the rank-stride form guarantees that even the four-member claim corpus holds exactly one member out — a value-residue rule would have held nothing out of it on most builds."@x-gmeow-english ;
    gmeow:splitHeldOutStride "8"^^xsd:nonNegativeInteger ;
    gmeow:splitHeldOutOffset "0"^^xsd:nonNegativeInteger ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:corpusGmeowCoreV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "core corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal core-tier corpus: the cell/projection TTL sources the carrier folds as cells-archive, plus the authored core slice tree. Bundle-internal — the archive rep is owned by gmeow:stage-archive-blobs and the prefix is in-repo."@x-gmeow-english ;
    gmeow:corpusSelectsBlobRep "cells-archive" ;
    gmeow:corpusSelectsPathPrefix "slices/core/" ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:corpusGmeowLangAstV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "lang AST corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal LINGUISTIC corpus: the whole lang: deliverable family the carrier folds as lang-projections-archive — the EBNF/ABNF/GBNF/Lark grammars, the GMN1 example corpus, the CoNLL-U readings, the TEI XML, the SEMAF AMR, the Web-Annotation JSON-LD, the ISO-30042 TBX termbase and the human-readable glossary table — plus the authored lang: slice tree, whose form, grammar, and rendering vocabulary dominates their byte profile. Bundle-internal: the archive rep is owned by gmeow:stage-archive-blobs and the prefix is in-repo."@x-gmeow-english ;
    gmeow:corpusSelectsBlobRep "lang-projections-archive" ;
    gmeow:corpusSelectsPathPrefix "slices/grounding/lang/" ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:corpusGmeowLogicV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "logic corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal logic corpus: the compiled logic/DL projection surface the carrier folds as axioms-archive, plus the authored logic: slice tree. Bundle-internal — the archive rep is owned by gmeow:stage-archive-blobs and the prefix is in-repo."@x-gmeow-english ;
    gmeow:corpusSelectsBlobRep "axioms-archive" ;
    gmeow:corpusSelectsPathPrefix "slices/grounding/logic/" ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:corpusGmeowMemoryCompactV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "compact memory corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal SMALL-STORE memory corpus: the shipped authoring-packet graph and its committed projection. It trains on BUNDLE-SHIPPED claim material, NEVER on a user's runtime ~/.gmeow/memory.gts — a zstd dictionary carries verbatim substrings of its corpus, so training on live user memory would publish private claim fragments in the bundle, would hard-fail on a fresh install whose store is empty, and would not be a projection of the repository. What the dictionary learns is the SHAPE of shipped claims, not anyone's content."@x-gmeow-english ;
    gmeow:corpusSelectsGraph <https://blackcatinformatics.ca/gmeow/graph/authoring-briefs> ;
    gmeow:corpusSelectsPathPrefix "generated/briefs/" ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:corpusGmeowMemoryHotV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "hot memory corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal HOT-PATH memory corpus: the shipped statement projection plus the authoring-packet graph. It trains on BUNDLE-SHIPPED claim material, NEVER on a user's runtime ~/.gmeow/memory.gts — a zstd dictionary carries verbatim substrings of its corpus, so training on live user memory would publish private claim fragments in the bundle, would hard-fail on a fresh install whose store is empty, and would not be a projection of the repository. What the dictionary learns is the SHAPE of shipped claims, not anyone's content."@x-gmeow-english ;
    gmeow:corpusSelectsGraph <https://blackcatinformatics.ca/gmeow/graph/authoring-briefs> ;
    gmeow:corpusSelectsPathPrefix "generated/statements/" ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:corpusGmeowProoftraceV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "proof-trace corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal reasoning-report corpus. The reasoning archive (reasoning-archive) is SINK-FOLDED — it is assembled only at the terminal snapshot — so this corpus selects gmeow:stage-reason's product directly, which carries the explanations and the DL/EL ledger mid-DAG where the trainer runs."@x-gmeow-english ;
    gmeow:corpusSelectsStageProduct gmeow:stage-reason ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictGmeowCoreV1
    a gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "gmeow-core-v1 dictionary"@x-gmeow-english ;
    skos:definition "The shipped dictionary for core-tier payloads: the gmeow: namespace stem, the SKOS/RDFS annotation predicates, and the core class and property names dominate their byte profile. It is the WIDEST population of the shipped inventory — the cells / generated-opaque / mappings / queries / schemas / tests / models-python archives, the snapshot wire schema, and the mathematical named graphs that ride inside it — and it is re-swept over exactly the frame set it holds rather than assumed to survive a change to that set."@x-gmeow-english ;
    gmeow:dictionaryId "gmeow-core-v1" ;
    gmeow:dictionaryVersion "1" ;
    gmeow:dictionaryStrategy gmeow:dictStrategyTrained ;
    gmeow:dictionaryTargetLength "65536"^^xsd:nonNegativeInteger ;
    gmeow:trainsOverCorpus gmeow:corpusGmeowCoreV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictGmeowLangAstV1
    a gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "gmeow-lang-ast-v1 dictionary"@x-gmeow-english ;
    skos:definition "The shipped dictionary for linguistic-surface payloads: lang: form, grammar, and rendering structures plus the natural-language term inventory dominate their byte profile. It primes gmeow:payloadSchemaLangProjectionsArchive — the whole lang: deliverable family, terminology surfaces included — and gmeow:payloadSchemaLangSurfaceBlob, the document-scale English literals."@x-gmeow-english ;
    gmeow:dictionaryId "gmeow-lang-ast-v1" ;
    gmeow:dictionaryVersion "1" ;
    gmeow:dictionaryStrategy gmeow:dictStrategyTrained ;
    gmeow:dictionaryTargetLength "65536"^^xsd:nonNegativeInteger ;
    gmeow:trainsOverCorpus gmeow:corpusGmeowLangAstV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictGmeowLogicV1
    a gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "gmeow-logic-v1 dictionary"@x-gmeow-english ;
    skos:definition "The shipped dictionary for compiled logic payloads: logic: formula, restriction, and constraint structures plus the DL projection vocabulary dominate their byte profile."@x-gmeow-english ;
    gmeow:dictionaryId "gmeow-logic-v1" ;
    gmeow:dictionaryVersion "1" ;
    gmeow:dictionaryStrategy gmeow:dictStrategyTrained ;
    gmeow:dictionaryTargetLength "65536"^^xsd:nonNegativeInteger ;
    gmeow:trainsOverCorpus gmeow:corpusGmeowLogicV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictGmeowMemoryCompactV1
    a gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "gmeow-memory-compact-v1 dictionary"@x-gmeow-english ;
    skos:definition "The shipped SMALL-STORE memory dictionary, built by the COVER trainer at the smallest gridded target length. The training point is the MEASURED two-part-code argmin over the committed sweep, not a prior about what a compact store can support: the earlier term-table declaration rested on the expectation that too few bytes are available for the trainer to beat the ontology's own term vocabulary, and the sweep falsified it — the trained dictionary codes the same runtime-store population in fewer total bytes, its own in-band bytes included. Trained ONLY on bundle-shipped claim material (see gmeow:corpusGmeowMemoryCompactV1) — never on a user's runtime store."@x-gmeow-english ;
    gmeow:dictionaryId "gmeow-memory-compact-v1" ;
    gmeow:dictionaryVersion "1" ;
    gmeow:dictionaryStrategy gmeow:dictStrategyTrained ;
    gmeow:dictionaryTargetLength "4096"^^xsd:nonNegativeInteger ;
    gmeow:trainsOverCorpus gmeow:corpusGmeowMemoryCompactV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictGmeowMemoryHotV1
    a gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "gmeow-memory-hot-v1 dictionary"@x-gmeow-english ;
    skos:definition "The shipped HOT-PATH memory dictionary for frequently rewritten agent-memory segments. Trained ONLY on bundle-shipped claim material (see gmeow:corpusGmeowMemoryHotV1) — never on a user's runtime store; what it learns is the SHAPE of shipped claims, not anyone's content."@x-gmeow-english ;
    gmeow:dictionaryId "gmeow-memory-hot-v1" ;
    gmeow:dictionaryVersion "1" ;
    gmeow:dictionaryStrategy gmeow:dictStrategyTrained ;
    gmeow:dictionaryTargetLength "4096"^^xsd:nonNegativeInteger ;
    gmeow:trainsOverCorpus gmeow:corpusGmeowMemoryHotV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictGmeowProoftraceV1
    a gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "gmeow-prooftrace-v1 dictionary"@x-gmeow-english ;
    skos:definition "The shipped dictionary for reasoning-report payloads: explanation step records, rule identifiers, and the DL/EL crosscheck ledger dominate their byte profile."@x-gmeow-english ;
    gmeow:dictionaryId "gmeow-prooftrace-v1" ;
    gmeow:dictionaryVersion "1" ;
    gmeow:dictionaryStrategy gmeow:dictStrategyTrained ;
    gmeow:dictionaryTargetLength "65536"^^xsd:nonNegativeInteger ;
    gmeow:trainsOverCorpus gmeow:corpusGmeowProoftraceV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

# --- The registered payload-schema vocabulary ------------------------------- #
# ONE individual per blob representation the carrier can emit, plus one for the
# snapshot wire schema. This registry is the reason an UNREGISTERED rep is a
# genuine production hard fail (gmeow:MediumUnknownSchema) instead of a value a
# reader derives from the frame: a rep read back as an opaque string would decode
# as "some blob" and its medium assignment would be undefined, so the registry —
# not the frame — is the authority. gmeow:payloadSchemaId carries the EXACT wire
# label the emitter writes, and the registry-agreement test enumerates the
# carrier's representation constants against these literals, so adding an archive
# in Rust without registering its schema here reds.

gmeow:payloadSchemaAxiomsArchive
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — axioms archive"@x-gmeow-english ;
    skos:definition "The compiled logic/DL projection surface, keyed by repo-relative path."@x-gmeow-english ;
    gmeow:payloadSchemaId "axioms-archive" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ;
    gmeow:payloadSchemaDictionary gmeow:dictGmeowLogicV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:payloadSchemaCellsArchive
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — cells archive"@x-gmeow-english ;
    skos:definition "The cell/projection TTL sources, keyed by repo-relative path."@x-gmeow-english ;
    gmeow:payloadSchemaId "cells-archive" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ;
    gmeow:payloadSchemaDictionary gmeow:dictGmeowCoreV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:payloadSchemaDiagnosticsNodes
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — diagnostics nodes"@x-gmeow-english ;
    skos:definition "A diagnostics producer's forward-projected run-ledger nodes (raw JSON, not a tar). Build-time only: absent from a shipped gmeow.gts, but still a rep the carrier can emit and therefore a registered schema."@x-gmeow-english ;
    gmeow:payloadSchemaId "diagnostics:nodes" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ;
    gmeow:payloadSchemaDictionary gmeow:dictGmeowLogicV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:payloadSchemaDocsBook
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — docs book"@x-gmeow-english ;
    skos:definition "The mdbook source tree, every member prefixed with the English internal tag."@x-gmeow-english ;
    gmeow:payloadSchemaId "docs-book" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ;
