# Synthetic coverage fixture for the locations building block. The worked
# "112 Westbourne Rd, Spruce Grove, Alberta, Canada" example: a nested,
# QID-bearing place hierarchy (each level a first-class gmeow:Place chained by
# containedInPlace), a precise point + WKT geometry on the premises, a room
# inside the building, a decomposed postal address bridged by addressPlace, an
# online (virtual) location, and two storage locations (cloud + physical disk,
# the disk sited at the room). No RDF-star (the coverage parser can't read << >>).

@prefix ex:     <https://example.org/loc/> .
@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:    <http://www.opengis.net/ont/geosparql#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix wd:     <http://www.wikidata.org/entity/> .
@prefix tgn:    <http://vocab.getty.edu/tgn/> .

# Nested, QID-bearing place hierarchy (country ⊃ region ⊃ city ⊃ premises ⊃ room).
ex:canada a gmeow:Place ;
    gmeow:placeType gmeow:placeTypeCountry ;
    gmeow:timezone "America/Edmonton" ;
    gmeow:hasPlaceName ex:canadaEn , ex:canadaDe ;
    gmeow:authorityLink wd:Q16 ;
    skos:exactMatch wd:Q16 .

# Co-equal toponyms via gmeow:hasPlaceName (the retired flat alternateName's
# structured replacement). A NameUsage naming a Place is inferred gmeow:PlaceNaming.
ex:canadaEn a gmeow:PlaceName ;
    gmeow:fullName "Canada"@en ; gmeow:nameLanguage ex:langEn ;
    gmeow:namePurpose gmeow:namePurposeEndonym ; gmeow:displayable true .
ex:canadaDe a gmeow:PlaceName ;
    gmeow:fullName "Kanada"@de ; gmeow:nameLanguage ex:langDe ;
    gmeow:namePurpose gmeow:namePurposeExonym ; gmeow:displayable true .
ex:canadaNamingDe a gmeow:NameUsage ;
    gmeow:usageNamed ex:canada ;
    gmeow:usageAppellation ex:canadaDe ;
    gmeow:usageRegister gmeow:registerFormal ;
    gmeow:usageAuthority ex:germanCartography .

ex:germanCartography a gmeow:Organization .
ex:langEn a gmeow:Language ; gmeow:languageCode "en" .
ex:langDe a gmeow:Language ; gmeow:languageCode "de" .

ex:alberta a gmeow:Place ;
    gmeow:placeType gmeow:placeTypeRegion ;
    gmeow:containedInPlace ex:canada ;
    skos:exactMatch wd:Q1951 .

ex:spruceGrove a gmeow:Place ;
    gmeow:placeType gmeow:placeTypeCity ;
    gmeow:containedInPlace ex:alberta ;
    gmeow:authorityLink tgn:7013364 .

ex:westbourne112 a gmeow:Place ;
    gmeow:placeType gmeow:placeTypePremises ;
    gmeow:containedInPlace ex:spruceGrove ;
    gmeow:hasCoordinates ex:wbCoords ;
    gmeow:hasGeometry ex:wbGeo ;
    gmeow:hasPlaceName ex:wb112Name .

ex:wb112Name a gmeow:PlaceName ;
    gmeow:fullName "112 Westbourne Road"@en ; gmeow:nameLanguage ex:langEn ;
    gmeow:displayable true .

ex:homeOffice a gmeow:Place ;
    gmeow:placeType gmeow:placeTypeRoom ;
    gmeow:containedInPlace ex:westbourne112 .

ex:wbCoords a gmeow:GeoCoordinates ;
    gmeow:latitude 53.544972 ;
    gmeow:longitude -113.924398 ;
    gmeow:elevation 645.0 .

# Data may carry the geo:wktLiteral tag even though the OWL range is rdfs:Literal.
ex:wbGeo a gmeow:Geometry ;
    gmeow:asWKT "POINT(-113.924398 53.544972)"^^geo:wktLiteral .

# Decomposed postal address (surface form) bridged to the resolved premises.
ex:addr a gmeow:PostalAddress ;
    gmeow:streetAddress "112 Westbourne Rd" ;
    gmeow:addressLocality "Spruce Grove" ;
    gmeow:addressRegion "AB" ;
    gmeow:postalCode "T7X 0A1" ;
    gmeow:countryCode "CA" ;
    gmeow:addressPlace ex:westbourne112 .

# A virtual location (online meeting).
ex:standup a gmeow:VirtualLocation ;
    gmeow:accessUrl "https://example.zoom.us/j/123456"^^xsd:anyURI ;
    gmeow:virtualPlatform "Zoom" .

# Storage locations: a cloud service (holds an import source) and a physical
# disk sited at the home-office room.
ex:drive a gmeow:StorageLocation ;
    gmeow:storageMedium gmeow:storageMediumCloudService ;
    gmeow:storageService "Google Drive" ;
    gmeow:storagePath "/Contacts/backup.vcf" .

ex:hdd a gmeow:StorageLocation ;
    gmeow:storageMedium gmeow:storageMediumPhysicalDisk ;
    gmeow:storageService "local" ;
    gmeow:physicalPlace ex:homeOffice .

ex:vcardSource a gmeow:Source ;
    gmeow:storedIn ex:drive .

ex:patrick a gmeow:Person ;
    gmeow:locatedAt ex:westbourne112 ;
    gmeow:hasContactPoint ex:addr .

# Pose / Orientation coverage (#78): a drone with quaternion orientation and a
# telescope with Euler-angle orientation. Both share the same WGS84 frame for
# simplicity; in production each pose points at its own ReferenceFrame profile.
ex:wgs84Frame a gmeow:ReferenceFrame ;
    gmeow:frameRealm gmeow:frameRealmTerrestrial ;
    gmeow:frameKind gmeow:frameKindGeodetic ;
    gmeow:hasAxis gmeow:axisLatitude, gmeow:axisLongitude, gmeow:axisElevation ;
    gmeow:dimensionCount 3 ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyExact .

ex:drone a gmeow:PhysicalObject ;
    gmeow:hasPose ex:dronePose .

ex:dronePose a gmeow:Pose ;
    gmeow:poseFrame ex:wgs84Frame ;
    gmeow:hasPosePosition ex:dronePosition ;
    gmeow:hasPoseOrientation ex:droneOrientation .

ex:dronePosition a gmeow:GeoCoordinates ;
    gmeow:latitude 53.544900 ;
    gmeow:longitude -113.924400 ;
    gmeow:elevation 650.0 ;
    gmeow:coordinateFrame ex:wgs84Frame .

ex:droneOrientation a gmeow:Orientation ;
    gmeow:quaternionX 0.0 ;
    gmeow:quaternionY 0.0 ;
    gmeow:quaternionZ 0.70710678 ;
    gmeow:quaternionW 0.70710678 .

ex:telescope a gmeow:PhysicalObject ;
    gmeow:hasPose ex:telescopePose .

ex:telescopePose a gmeow:Pose ;
    gmeow:poseFrame ex:wgs84Frame ;
    gmeow:hasPosePosition ex:telescopePosition ;
    gmeow:hasPoseOrientation ex:telescopeOrientation .

ex:telescopePosition a gmeow:GeoCoordinates ;
    gmeow:latitude 53.544950 ;
    gmeow:longitude -113.924350 ;
    gmeow:elevation 648.0 ;
    gmeow:coordinateFrame ex:wgs84Frame .

ex:telescopeOrientation a gmeow:Orientation ;
    gmeow:yaw 45.0 ;
    gmeow:pitch 10.0 ;
    gmeow:roll 0.0 ;
    gmeow:eulerOrder "ZYX" .

# --------------------------------------------------------------------------- #
# Issue #98 — BOT building-topology fixture data (building ⊃ floor ⊃ room)
# --------------------------------------------------------------------------- #

ex:officeBuilding a gmeow:Place ;
    gmeow:placeType gmeow:placeTypeBuilding ;
    gmeow:hasCoordinates ex:buildingCoords ;
    gmeow:hasPlaceName ex:officeBuildingName .

ex:officeBuildingName a gmeow:PlaceName ;
    gmeow:fullName "Acme Tower"@en ; gmeow:nameLanguage ex:langEn ;
    gmeow:displayable true .

ex:buildingCoords a gmeow:GeoCoordinates ;
    gmeow:latitude 51.5074 ;
    gmeow:longitude -0.1278 .

ex:secondFloor a gmeow:Place ;
    gmeow:placeType gmeow:placeTypeFloor ;
    gmeow:containedInPlace ex:officeBuilding .

ex:cornerOffice a gmeow:Place ;
    gmeow:placeType gmeow:placeTypeRoom ;
    gmeow:containedInPlace ex:secondFloor .
