}""" ;
    gmeow:saRationale """gmeow:resentMessageId MUST be a DatatypeProperty on EmailMessage ranging over Literal and MUST NOT be functional because multiple resent blocks are possible.""" .

ex:saThreadSubjectDatatypePropertyOnThread a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
