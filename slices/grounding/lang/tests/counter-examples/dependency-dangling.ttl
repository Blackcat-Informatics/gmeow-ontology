# Counter-example: a dependency head reference pointing into a different analysis (fires lang:DanglingDependency / shacl.SPARQLConstraintComponent).

@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:a1 a lang:Analysis .
ex:a2 a lang:Analysis .
ex:s0 a lang:FormSlot ; lang:inAnalysis ex:a1 ; lang:slotForm ex:w0 ; lang:dependsOn ex:s1 .
ex:s1 a lang:FormSlot ; lang:inAnalysis ex:a2 ; lang:slotForm ex:w1 .
ex:w0 a lang:WordForm ; lang:inSignSystem ex:english .
ex:w1 a lang:WordForm ; lang:inSignSystem ex:english .
