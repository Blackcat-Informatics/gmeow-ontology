@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:list-functions
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) — DO NOT EDIT. Six primitive rdf:List operations (listLength, listGet, listIndexOf, listSlice, listConcat, listContains) declared as FnO, all executable as native SPARQL custom functions (gmeow:list*). The scalar readers — listContains, listLength, listGet, listIndexOf — resolve via a recursive rdf:first/rdf:rest walk with arithmetic builtins (conformance case goal-rdf-list-functions). The list-constructing operations (listSlice, listConcat) invent a fresh rdf:List: the engine mints the new cells and surfaces them in CONSTRUCT output or the SELECT auxiliary graph."@en ;
    rdfs:label "GMEOW first-class RDF list functions (FnO)"@en .

gmeow:listConcat
    a fno:Function ;
    rdfs:label "list concat"@en ;
    skos:definition "A new rdf:List that is the concatenation of two rdf:Lists (the members of the first followed by the members of the second). Constructs a new list (value invention): the native SPARQL engine mints the fresh rdf:first/rdf:rest cells and surfaces them in CONSTRUCT output or the SELECT auxiliary graph."@en ;
    fno:expects ( gmeow:pListA gmeow:pListB ) ;
    fno:returns ( gmeow:oListConcat ) .

gmeow:listContains
    a fno:Function ;
    rdfs:label "list contains"@en ;
    skos:definition "True when a value is a member of an rdf:List, false otherwise. Membership is term-exact: a value matches a member by RDF term identity (lexical form and datatype), not by SPARQL value-space, so 1 (xsd:integer) does not match 1 (xsd:decimal). Executably backed by the reasoning layer: a recursive rdf:first/rdf:rest membership walk under ProceduralPrologProfile (conformance case goal-rdf-list-functions)."@en ;
    fno:expects ( gmeow:pList gmeow:pValue ) ;
    fno:returns ( gmeow:oListContains ) .

gmeow:listGet
    a fno:Function ;
    rdfs:label "list get"@en ;
    skos:definition "The member of an rdf:List at a zero-based index (the nth rdf:first along the chain). Executably backed by the reasoning layer: a recursive walk with index arithmetic under ProceduralPrologProfile (conformance case goal-rdf-list-functions)."@en ;
    fno:expects ( gmeow:pList gmeow:pIndex ) ;
    fno:returns ( gmeow:oListGet ) .

gmeow:listIndexOf
    a fno:Function ;
    rdfs:label "list index of"@en ;
    skos:definition "The zero-based index of the first occurrence of a value in an rdf:List, or absent when the value is not a member. Membership is term-exact: a value matches a member by RDF term identity (lexical form and datatype), not by SPARQL value-space, so 1 (xsd:integer) does not match 1 (xsd:decimal). Executably backed by the reasoning layer: a recursive walk with count arithmetic under ProceduralPrologProfile (conformance case goal-rdf-list-functions)."@en ;
    fno:expects ( gmeow:pList gmeow:pValue ) ;
    fno:returns ( gmeow:oListIndexOf ) .

gmeow:listLength
    a fno:Function ;
    rdfs:label "list length"@en ;
    skos:definition "The number of members in an rdf:List (the length of the rdf:first/rdf:rest chain to rdf:nil). Executably backed by the reasoning layer: a recursive rdf:rest walk with arithmetic builtins under ProceduralPrologProfile (conformance case goal-rdf-list-functions)."@en ;
    fno:expects ( gmeow:pList ) ;
    fno:returns ( gmeow:oListLength ) .

gmeow:listSlice
    a fno:Function ;
    rdfs:label "list slice"@en ;
    skos:definition "A new rdf:List of the members in the half-open index range [start, end) of an rdf:List (indices clamped to the list bounds; an out-of-range or inverted range yields rdf:nil). Constructs a new list (value invention): the native SPARQL engine mints the fresh rdf:first/rdf:rest cells and surfaces them in CONSTRUCT output or the SELECT auxiliary graph."@en ;
    fno:expects ( gmeow:pList gmeow:pSliceStart gmeow:pSliceEnd ) ;
    fno:returns ( gmeow:oListSlice ) .

gmeow:oListConcat
    a fno:Output ;
    rdfs:label "list concat result"@en ;
    skos:definition "The result of gmeow:listConcat."@en ;
    fno:type rdf:List .

gmeow:oListContains
    a fno:Output ;
    rdfs:label "list contains result"@en ;
    skos:definition "The result of gmeow:listContains."@en ;
    fno:type xsd:boolean .

gmeow:oListGet
    a fno:Output ;
    rdfs:label "list get result"@en ;
    skos:definition "The result of gmeow:listGet."@en ;
    fno:type rdfs:Resource .

gmeow:oListIndexOf
    a fno:Output ;
    rdfs:label "list index of result"@en ;
    skos:definition "The result of gmeow:listIndexOf."@en ;
    fno:type xsd:integer .

gmeow:oListLength
    a fno:Output ;
    rdfs:label "list length result"@en ;
    skos:definition "The result of gmeow:listLength."@en ;
    fno:type xsd:integer .

gmeow:oListSlice
    a fno:Output ;
    rdfs:label "list slice result"@en ;
    skos:definition "The result of gmeow:listSlice."@en ;
    fno:type rdf:List .

gmeow:pIndex
    a fno:Parameter ;
    rdfs:label "index"@en ;
    skos:definition "A zero-based position into an rdf:List."@en ;
    fno:required true ;
    fno:type xsd:integer .

gmeow:pList
    a fno:Parameter ;
    rdfs:label "list"@en ;
    skos:definition "The input rdf:List the operation reads."@en ;
    fno:required true ;
    fno:type rdf:List .

gmeow:pListA
    a fno:Parameter ;
    rdfs:label "first list"@en ;
    skos:definition "The first (left) rdf:List of a concatenation."@en ;
    fno:required true ;
    fno:type rdf:List .

gmeow:pListB
    a fno:Parameter ;
    rdfs:label "second list"@en ;
    skos:definition "The second (right) rdf:List of a concatenation."@en ;
    fno:required true ;
    fno:type rdf:List .

gmeow:pSliceEnd
    a fno:Parameter ;
    rdfs:label "slice end"@en ;
    skos:definition "The exclusive zero-based end index of a slice."@en ;
    fno:required true ;
    fno:type xsd:integer .

gmeow:pSliceStart
    a fno:Parameter ;
    rdfs:label "slice start"@en ;
    skos:definition "The inclusive zero-based start index of a slice."@en ;
    fno:required true ;
    fno:type xsd:integer .

gmeow:pValue
    a fno:Parameter ;
    rdfs:label "value"@en ;
    skos:definition "A value to locate as a member of an rdf:List."@en ;
    fno:required true ;
    fno:type rdfs:Resource .
