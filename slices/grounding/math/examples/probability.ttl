#
# A single coherent worked scene over the whole probability seam of the mathematics
# design set (design/MATHEMATICS-PROBABILITY.md): a weather forecast wired to a small
# Bayesian "sprinkler" net. It instantiates the Kolmogorov spine (probability spaces with
# their three components, each SYMBOLIC or generative), a framed probability value held by
# an observation, a normal distribution with its correctly-factored mean/stddev
# parameterization, EVERY reasoning-facing dependency model (full independence, joint
# table, Bayesian network, factor graph, Markov kernel, stochastic process) each
# structurally complete and each lowering into the logic: probability-model requirement,
# a LIVE logic:probabilityModel reference from a logic:World into one of those models, the
# first-class Bayesian update chain (prior / likelihood / posterior) with an MCMC run and
# its trustworthiness diagnostics, and the lawful probability-SCALE transforms (odds /
# log-odds → probability). Every instance is well-formed, so it raises ZERO probability
# (P1–P11) or projection findings and passes the closed-world JSON-Schema example sweep;
# it is the in-bundle demonstration of the distributions + dependency-model → logic:
# lowering seam.

@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/math/> .

# =========================================================================== #
# 1. The Kolmogorov spine — three probability spaces, each component symbolic   #
#    or generative but never absent (Rule P4), exercising all three σ-algebra   #
#    variants (Borel, power-set, product).                                      #
# =========================================================================== #

# Ω = tomorrow's rainfall amount on ℝ≥0, ℱ = the Borel σ-algebra of the real line,
# P = a probability measure of total mass one over the underlying measurable space.
ex:weatherSpace a math:ProbabilitySpace ;
    rdfs:label "tomorrow's rainfall probability space"@x-gmeow-english ;
    math:sampleSpace ex:rainfallOutcomes ;
    math:eventSigmaAlgebra ex:rainfallBorel ;
    math:probabilityMeasure ex:weatherMeasure .

ex:rainfallOutcomes a math:SymbolicSampleSpace ;      # ℝ≥0, named symbolically, not enumerated
    rdfs:label "rainfall-amount sample space (ℝ≥0 mm)"@x-gmeow-english .

ex:rainfallBorel a math:BorelSigmaAlgebra ;           # ℱ, given by its generator
    rdfs:label "Borel σ-algebra of the rainfall line"@x-gmeow-english .

ex:weatherMeasure a math:ProbabilityMeasure ;         # P, a measure of total mass one
    rdfs:label "forecast probability measure"@x-gmeow-english ;
    math:measureOn ex:weatherMeasurableSpace ;
    math:totalMass 1 .

ex:weatherMeasurableSpace a math:MeasurableSpace .

# Ω = the discrete sprinkler state {on, off}, ℱ = the power-set σ-algebra 2^Ω (every
# subset measurable), P = a probability mass measure of total mass one.
ex:sprinklerSpace a math:ProbabilitySpace ;
    rdfs:label "sprinkler-state probability space"@x-gmeow-english ;
    math:sampleSpace ex:sprinklerOutcomes ;
    math:eventSigmaAlgebra ex:sprinklerPowerSet ;
    math:probabilityMeasure ex:sprinklerMeasure .

ex:sprinklerOutcomes a math:SymbolicSampleSpace ;     # {on, off}
    rdfs:label "sprinkler-state sample space {on, off}"@x-gmeow-english .

ex:sprinklerPowerSet a math:PowerSetSigmaAlgebra ;    # ℱ = 2^Ω, the discrete algebra
    rdfs:label "power-set σ-algebra of the sprinkler states"@x-gmeow-english .

ex:sprinklerMeasure a math:ProbabilityMeasure ;
    rdfs:label "sprinkler probability mass measure"@x-gmeow-english ;
    math:measureOn ex:sprinklerMeasurableSpace ;
    math:totalMass 1 .

ex:sprinklerMeasurableSpace a math:MeasurableSpace .

# The JOINT rain×sprinkler space, ℱ = the product σ-algebra generated by the measurable
# rectangles of the two factor spaces — the measure-theoretic ground of the joint table.
ex:jointSpace a math:ProbabilitySpace ;
    rdfs:label "joint rain×sprinkler probability space"@x-gmeow-english ;
    math:sampleSpace ex:jointOutcomes ;
    math:eventSigmaAlgebra ex:jointProductAlgebra ;
    math:probabilityMeasure ex:jointMeasure .

ex:jointOutcomes a math:SymbolicSampleSpace ;         # Ω_rain × Ω_sprinkler
    rdfs:label "joint rain×sprinkler sample space"@x-gmeow-english .

ex:jointProductAlgebra a math:ProductSigmaAlgebra ;   # ℱ_rain ⊗ ℱ_sprinkler
    rdfs:label "product σ-algebra of the joint space"@x-gmeow-english .

ex:jointMeasure a math:ProbabilityMeasure ;
    rdfs:label "joint probability measure"@x-gmeow-english ;
    math:measureOn ex:jointMeasurableSpace ;
    math:totalMass 1 .

ex:jointMeasurableSpace a math:MeasurableSpace .

# A probability event — a measurable SET OF OUTCOMES (not an occurrent, so it is NOT typed
# logic:Event: Rule P11) — situated in its space by math:eventInSpace.
ex:forecastRainEvent a math:ProbabilityEvent ;
    rdfs:label "the rain event-set {rainfall > 0}"@x-gmeow-english ;
    math:eventInSpace ex:weatherSpace .

# =========================================================================== #
# 2. A framed probability value (Rules P1 + P3), held by an observation with a  #
#    vantage — the charter's pRainTomorrow, a quantity object, never a bare     #
#    literal.                                                                    #
# =========================================================================== #

ex:pRainTomorrow a math:Quantity , math:ProbabilityValue ;
    rdfs:label "P(rain tomorrow) = 0.72"@x-gmeow-english ;
    math:quantityValue "0.72"^^xsd:decimal ;               # in the closed unit interval [0,1] (P1)
    gmeow:hasReferenceFrame ex:weatherForecastProbabilityFrame ;   # names its frame (P3)
    gmeow:isResultOf ex:forecastRun .

# Anchors the value to the event it quantifies (math:probabilityOfEvent, domain
# math:ProbabilityEvent, range math:ProbabilityValue): P(rain tomorrow) = 0.72 IS the
# forecast-run's probability of the rain event-set declared in §1.
ex:forecastRainEvent math:probabilityOfEvent ex:pRainTomorrow .

ex:weatherForecastProbabilityFrame a gmeow:ReferenceFrame ;
    rdfs:label "weather-forecast probability frame"@x-gmeow-english .

ex:forecastRun a gmeow:Activity ;
    rdfs:label "numerical weather-prediction run of 2026-07-10"@x-gmeow-english ;
    gmeow:eventTemporalFrame ex:utcFrame .

ex:forecastProbabilityObservation a gmeow:Observation ;
    rdfs:label "the forecast model's P(rain) claim"@x-gmeow-english ;
    gmeow:vantage ex:weatherModelV17 ;
    gmeow:observedFeature ex:forecastRainEvent ;
    gmeow:observationResult ex:pRainTomorrow ;
    gmeow:observationType gmeow:observationTypeDerived .

ex:weatherModelV17 a gmeow:SoftwareAgent ;
    rdfs:label "forecast model v17"@x-gmeow-english .

ex:utcFrame a gmeow:ReferenceFrame ;
    rdfs:label "UTC temporal frame"@x-gmeow-english .

# =========================================================================== #
# 3. A normal distribution with its mandatory, correctly-factored mean/stddev   #
#    parameterization (Rules P5, P6a, P6b, P7). The random variable declares its #
#    domain, codomain, and its distribution context.                            #
# =========================================================================== #

ex:rainfallAmount a math:RandomVariable ;
    rdfs:label "tomorrow's rainfall amount X (mm)"@x-gmeow-english ;
    math:randomVariableDomain ex:weatherMeasurableSpace ;
    math:randomVariableCodomain ex:realValuesSet ;
    math:hasDistribution ex:rainfallNormal .

ex:realValuesSet a math:Set ;
    rdfs:label "the real values"@x-gmeow-english .

ex:rainfallNormal a math:Distribution ;
    rdfs:label "rainfall ~ Normal(μ, σ)"@x-gmeow-english ;
    math:distributionFamily ex:normalFamily ;                       # names its family (P6a)
    math:distributionParameterization ex:meanStddevParameterization ; # names its parameterization (P6b)
    math:hasSupport ex:rainfallSupport ;
    math:hasDistributionParameter ex:muParam , ex:sigmaParam .

ex:normalFamily a math:DistributionFamily ;
    rdfs:label "normal (Gaussian) family"@x-gmeow-english .

ex:rainfallSupport a math:DistributionSupport ;
    rdfs:label "support of the rainfall normal (ℝ)"@x-gmeow-english .

# The parameterization declares exactly which two roles the normal-by-mean-and-stddev
# convention requires; the distribution supplies each EXACTLY ONCE (P7).
ex:meanStddevParameterization a math:DistributionParameterization ;
    rdfs:label "normal mean/stddev parameterization"@x-gmeow-english ;
    math:requiresParameterRole ex:meanRole , ex:stddevRole .

ex:meanRole a math:DistributionParameterRole ;
    rdfs:label "location (mean μ) role"@x-gmeow-english ;
    math:roleWithinParameterization ex:meanStddevParameterization .

# The scale role is standard deviation, not variance/rate/precision: it demands a strictly
# positive magnitude, checked by the native math:DistributionParameterConstraint gate.
ex:stddevRole a math:DistributionParameterRole ;
    rdfs:label "scale (standard deviation σ) role"@x-gmeow-english ;
    math:roleWithinParameterization ex:meanStddevParameterization ;
    math:requiresPositiveValue true .

ex:muParam a math:DistributionParameter ;
    rdfs:label "μ = 12 mm"@x-gmeow-english ;
    math:parameterRole ex:meanRole ;
    math:parameterQuantity ex:muQuantity .

ex:sigmaParam a math:DistributionParameter ;
    rdfs:label "σ = 4.5 mm"@x-gmeow-english ;
    math:parameterRole ex:stddevRole ;
    math:parameterQuantity ex:sigmaQuantity .

ex:muQuantity a math:Quantity ;
    math:quantityValue "12.0"^^xsd:decimal .

ex:sigmaQuantity a math:Quantity ;
    math:quantityValue "4.5"^^xsd:decimal .          # strictly positive: satisfies the stddev role

# =========================================================================== #
# 4. Every reasoning-facing dependency model, each STRUCTURALLY COMPLETE, so    #
#    neither math:IncompleteDependencyModel nor math:ExactPreservationViolated  #
#    fires. Each class carries its logic: lowering at the TBox level             #
#    (math:probabilityModelLowering), so referencing one is a declared crossing. #
# =========================================================================== #

# (a) Full independence — the season and a sprinkler fault are asserted marginally
# independent, and the claim is standpoint-scoped to the model it holds in.
ex:independenceModel a math:FullIndependenceModel ;
    rdfs:label "prior full-independence model"@x-gmeow-english ;
    logic:preservationKind logic:ExactPreservation .

ex:seasonSprinklerIndependence a math:IndependenceAssertion ;
    rdfs:label "season ⫫ sprinkler-fault (prior)"@x-gmeow-english ;
    math:independenceSubject ex:drySeasonEvent ;
    math:independentOf ex:sprinklerFaultEvent ;
    math:independenceHoldsInModel ex:independenceModel .

ex:drySeasonEvent a math:ProbabilityEvent .
ex:sprinklerFaultEvent a math:ProbabilityEvent .

# (b) A joint probability table — the 2×2 rain×sprinkler distribution, its four
# logic:jointOutcome rows summing to EXACTLY one (3/10 + 2/10 + 4/10 + 1/10 = 1).
ex:rainSprinklerJoint a math:JointProbabilityTable ;
    rdfs:label "rain×sprinkler joint table"@x-gmeow-english ;
    logic:jointOutcome ex:joRainOn , ex:joRainOff , ex:joDryOn , ex:joDryOff .

ex:joRainOn  logic:jointProbability 0.3 .    # rain ∧ sprinkler-on
ex:joRainOff logic:jointProbability 0.2 .    # rain ∧ sprinkler-off
ex:joDryOn   logic:jointProbability 0.4 .    # dry  ∧ sprinkler-on
ex:joDryOff  logic:jointProbability 0.1 .    # dry  ∧ sprinkler-off

# (c) A Bayesian network — the sprinkler DAG (season → rain, season → sprinkler,
# rain → wet-grass, sprinkler → wet-grass), naming its dependency graph.
ex:sprinklerNet a math:BayesianNetwork ;
    rdfs:label "sprinkler Bayesian network"@x-gmeow-english ;
    math:dependencyGraph ex:sprinklerDag ;
    logic:preservationKind logic:ExactPreservation .

ex:sprinklerDag a math:MathematicalObject ;
    rdfs:label "sprinkler DAG (season→rain, season→sprinkler, rain/sprinkler→wet grass)"@x-gmeow-english .

# (d) A factor graph — the same joint as a product of factors, naming its structure.
ex:sprinklerFactorGraph a math:FactorGraph ;
    rdfs:label "sprinkler factor graph"@x-gmeow-english ;
    math:dependencyGraph ex:sprinklerFactorStructure .

ex:sprinklerFactorStructure a math:MathematicalObject ;
    rdfs:label "bipartite variable/factor structure"@x-gmeow-english .

# (e) A Markov kernel — the day-to-day weather transition, declaring BOTH its domain
# and codomain measurable spaces (kernel totality; P-gate Gate 4).
ex:weatherTransitionKernel a math:MarkovKernel ;
    rdfs:label "today→tomorrow weather transition kernel"@x-gmeow-english ;
    math:kernelDomain ex:todayWeatherSpace ;
    math:kernelCodomain ex:tomorrowWeatherSpace .

ex:todayWeatherSpace a math:MeasurableSpace .
ex:tomorrowWeatherSpace a math:MeasurableSpace .

# (f) A stochastic process — the indexed family {X_t} of daily rainfall variables whose
# transition structure the kernel above carries.
ex:dailyRainfallProcess a math:StochasticProcess ;
    rdfs:label "daily rainfall process {X_t}"@x-gmeow-english .

# =========================================================================== #
# 5. The LIVE logic: seam triple — a logic:World references its probability model  #
#    through logic:probabilityModel. The Bayesian network's TYPE carries the      #
#    declared lowering, so math:MissingProbabilityModelLowering does NOT fire.     #
#    This is the in-bundle logic:probabilityModel reference.                       #
# =========================================================================== #

ex:forecastWorld a logic:World ;
    rdfs:label "the forecast reasoning world"@x-gmeow-english ;
    logic:probabilityModel ex:sprinklerNet .

# =========================================================================== #
# 6. The first-class Bayesian update chain and its MCMC trustworthiness           #
#    diagnostics — prior / likelihood / posterior linked, the posterior sampled   #
#    by an MCMC run whose health is answerable (R-hat, ESS, divergences).          #
# =========================================================================== #

ex:rainRatePrior a math:PriorDistribution ;
    rdfs:label "Beta prior over the rain rate"@x-gmeow-english ;
    math:distributionFamily ex:betaFamily .

ex:rainRateLikelihood a math:LikelihoodFunction ;
    rdfs:label "L(θ) = P(observed wet days | θ)"@x-gmeow-english .

ex:rainRatePosterior a math:PosteriorDistribution ;
    rdfs:label "posterior over the rain rate"@x-gmeow-english ;
    math:distributionFamily ex:betaFamily ;
    math:hasPrior ex:rainRatePrior ;
    math:hasLikelihood ex:rainRateLikelihood .

ex:betaFamily a math:DistributionFamily ;
    rdfs:label "beta family"@x-gmeow-english .

# The update itself names its prior, likelihood, and the posterior it produces.
ex:rainRateUpdate a math:MathematicalObject ;
    rdfs:label "Bayesian rain-rate update"@x-gmeow-english ;
    math:hasPrior ex:rainRatePrior ;
    math:hasLikelihood ex:rainRateLikelihood ;
    math:hasPosterior ex:rainRatePosterior .

# The posterior is SAMPLED, not closed-form: an MCMC run (a process, a gmeow:Activity)
# draws a posterior sample, and its trustworthiness is answerable through the diagnostics.
ex:rainRateMcmc a math:MCMCRun ;
    rdfs:label "NUTS sampler run for the rain-rate posterior"@x-gmeow-english ;
    gmeow:eventTemporalFrame ex:utcFrame .

ex:rainRatePosteriorSample a math:PosteriorSample ;
    rdfs:label "4000 draws approximating the posterior"@x-gmeow-english ;
    gmeow:wasGeneratedBy ex:rainRateMcmc .

ex:rainRateRHat a math:RHat ;
    rdfs:label "R̂ = 1.001 (chains mixed)"@x-gmeow-english ;
    gmeow:wasGeneratedBy ex:rainRateMcmc .

ex:rainRateEss a math:EffectiveSampleSize ;
    rdfs:label "effective sample size ≈ 3200"@x-gmeow-english ;
    gmeow:wasGeneratedBy ex:rainRateMcmc .

ex:rainRateDivergences a math:DivergenceDiagnostic ;
    rdfs:label "0 divergent transitions"@x-gmeow-english ;
    gmeow:wasGeneratedBy ex:rainRateMcmc .

# A conditional probability P(rain | wet grass) and a conditional-independence assertion
# rain ⫫ sprinkler | season name their conditioning context (Rules P8, P9).
ex:pRainGivenWetGrass a math:ConditionalProbability ;
    rdfs:label "P(rain | wet grass)"@x-gmeow-english ;
    math:conditionalOn ex:wetGrassEvent .

ex:wetGrassEvent a math:ProbabilityEvent .

ex:rainSprinklerCondIndep a math:ConditionalIndependenceAssertion ;
    rdfs:label "rain ⫫ sprinkler | season"@x-gmeow-english ;
    math:independenceSubject ex:forecastRainEvent ;
    math:independentOf ex:sprinklerFaultEvent ;
    math:independentGiven ex:drySeasonEvent ;
    # Independence is a standpoint-scoped claim, never a bare fact of the graph
    # (Rule): it names the dependency model it holds in — the sprinkler Bayesian
    # network of §4(c), the modeled branch this conditional claim is scoped to.
    math:independenceHoldsInModel ex:sprinklerNet .

# =========================================================================== #
# 7. Lawful probability-SCALE transforms — odds and log-odds are NOT             #
#    probabilities (never typed math:ProbabilityValue, so ScaleConflation does   #
#    not fire); a math:ProbabilityScaleTransform recovers the probability they    #
#    re-express (Rule P2).                                                        #
# =========================================================================== #

# 3:1 odds — value 3.0, legitimately outside [0,1] because it is odds, not a probability.
ex:rainOdds a math:OddsValue ;
    rdfs:label "rain odds 3:1"@x-gmeow-english ;
    math:quantityValue "3.0"^^xsd:decimal ;
    gmeow:hasReferenceFrame ex:weatherForecastProbabilityFrame .

# The logit log(p/(1−p)) = ln 3 ≈ 1.0986, on the whole real line.
ex:rainLogOdds a math:LogOddsValue ;
    rdfs:label "rain log-odds ln 3"@x-gmeow-english ;
    math:quantityValue "1.0986"^^xsd:decimal ;
    gmeow:hasReferenceFrame ex:weatherForecastProbabilityFrame .

# The declared transform recovers the probability 3/4 the 3:1 odds re-express.
ex:oddsToProbability a math:ProbabilityScaleTransform ;
    rdfs:label "3:1 odds → P = 0.75"@x-gmeow-english ;
    math:transformsToProbabilityValue ex:pRainFromOdds .

ex:pRainFromOdds a math:Quantity , math:ProbabilityValue ;
    rdfs:label "P = 0.75 (recovered from 3:1 odds)"@x-gmeow-english ;
    math:quantityValue "0.75"^^xsd:decimal ;              # in [0,1] (P1)
    gmeow:hasReferenceFrame ex:weatherForecastProbabilityFrame .

# Anchors the recovered value to the same rain event the odds themselves re-express
# (math:probabilityOfEvent) — a second, scale-transformed estimate of P(rain), not an
# unanchored bare quantity.
ex:forecastRainEvent math:probabilityOfEvent ex:pRainFromOdds .
<https://blackcatinformatics.ca/gmeow/examples/math/muQuantity> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/lengthDimension> .
<https://blackcatinformatics.ca/gmeow/examples/math/pRainFromOdds> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/dimensionless> .
<https://blackcatinformatics.ca/gmeow/examples/math/pRainTomorrow> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/dimensionless> .
<https://blackcatinformatics.ca/gmeow/examples/math/rainLogOdds> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/dimensionless> .
<https://blackcatinformatics.ca/gmeow/examples/math/rainOdds> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/dimensionless> .
<https://blackcatinformatics.ca/gmeow/examples/math/sigmaQuantity> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/lengthDimension> .
