# --------------------------------------------------------------------------- #
# PAV — Provenance, Authoring and Versioning
# --------------------------------------------------------------------------- #

@prefix pav: <http://purl.org/pav/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .

# PAV specializes PROV-O for authorship, curation and digital creation.
# GMEOW captures these as Contribution relators; the flat properties below
# are the lossy shortcut equivalents.

gmeow:contributor skos:closeMatch pav:contributedBy {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "PAV contributedBy is a flat property; GMEOW contributor is the relator player."
|} .

gmeow:datePublished skos:closeMatch pav:authoredOn {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "PAV authoredOn is content-authorship date; GMEOW datePublished is the manifestation release date."
|} .

gmeow:hasAuthor skos:closeMatch foaf:made {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "linkage row declaring the foaf projection's made inverse (work-to-agent vs agent-to-work — close, deliberately not strong; the projection emits the inverse template, PROV activity alignment phase 3)"
|} .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:requires skos:closeMatch dcterms:requires {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "DCTerms requires — a related resource that is required by the described resource"
|} .

gmeow:isRequiredBy skos:closeMatch dcterms:isRequiredBy {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "DCTerms isRequiredBy — a related resource that requires the described resource"
|} .

gmeow:hasVersion skos:closeMatch dcterms:hasVersion {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "DCTerms hasVersion — a related resource that is a version of the described resource"
|} .

gmeow:conformsTo skos:closeMatch dcterms:conformsTo {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "DCTerms conformsTo — an established standard to which the described resource conforms"
|} .

gmeow:medium skos:closeMatch dcterms:medium {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "DCTerms medium — the material or physical carrier of a creative work"
|} .

gmeow:audience skos:closeMatch dcterms:audience {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "DCTerms audience — the intended audience of a creative work"
|} .

gmeow:hasManifestationFormat skos:closeMatch dcterms:format {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "DCTerms format — the file format, physical medium, or dimensions of the resource. GMEOW hasManifestationFormat covers the physical/digital carrier aspect; extent covers the size/duration aspect."
|} .

gmeow:hasAuthor owl:equivalentProperty schema:author {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:hasAuthor skos:closeMatch foaf:maker {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:hasContributor skos:closeMatch doap:developer {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7
|} .

