# Domain mapping-instance annotations; the profile pattern and binding remain in the DSL.
gmeow:mapSchemaStructuralCaption
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    rdfs:label "structural caption to schema description"@x-gmeow-english ;
    skos:definition "The schema profile retains a structural segment's caption as a description, with an explicit loss of its caption role rather than media-file classification."@x-gmeow-english ;
    gmeow:useWhen "Use when a structural content caption must survive the schema profile."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid projecting a structural caption as evidence that its bearer is a MediaObject."@x-gmeow-english ;
    gmeow:howToUse "Retain the original GMEOW caption and its structural subject; disclose the role lost in the description view."@x-gmeow-english ;
    skos:example "A structural caption remains documentary: ex:figure gmeow:caption \"A bridge plan.\"@en ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox .
