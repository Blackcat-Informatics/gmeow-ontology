<https://blackcatinformatics.ca/logic/SatisfiedByBackedByEvaluationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/logic/SatisfiedByBackedByEvaluationShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Goal> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A conclusive gmeow:satisfiedBy edge must be backed by a vantage-scoped logic:GoalEvaluation (evaluatesGoal = this goal, evaluatedAgainst = the situation, satisfactionStatus = logic:Satisfied, goalEvaluationStatus = logic:GoalEvaluationCompleted). No backing evaluation under any vantage was found." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/satisfiedBy> ?situation . FILTER NOT EXISTS { ?eval <https://blackcatinformatics.ca/logic/evaluatesGoal> $this . ?eval <https://blackcatinformatics.ca/logic/evaluatedAgainst> ?situation . ?eval <https://blackcatinformatics.ca/logic/satisfactionStatus> <https://blackcatinformatics.ca/logic/Satisfied> . ?eval <https://blackcatinformatics.ca/logic/goalEvaluationStatus> <https://blackcatinformatics.ca/logic/GoalEvaluationCompleted> . } }""" ;
    ] .

<https://blackcatinformatics.ca/logic/SealedFrameRecipientConstraintProceduralConstraintShape>
