@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://blackcatinformatics.ca/logic/target/canonical-rdf12>
    a logic:ProjectionTarget ;
    rdfs:label "canonical-rdf12" ;
    logic:complexityClass "N/A (identity serialization)" ;
    logic:preservationKind logic:ExactPreservation .

<https://blackcatinformatics.ca/logic/target/datalog>
    a logic:ProjectionTarget ;
    rdfs:label "datalog" ;
    gmeow:lossyDrop "OWL class expressions not representable as Datalog atoms are dropped" ,
        "actual: reasoning contract (preset logic:PositiveHornProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:ProbabilisticProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:ProceduralPrologProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:StableModelProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:StratifiedNAFProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:WellFoundedProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "modal/world context flattened to predicate reification" ,
        "no existential rule heads (skolemisation not emitted)" ;
    logic:complexityClass "terminating/PTIME-data" ;
    logic:preservationKind logic:SoundUnderApproximation .

<https://blackcatinformatics.ca/logic/target/edoal:0051d4462bb2a37f>
    a logic:ProjectionTarget ;
    rdfs:label "edoal:0051d4462bb2a37f" ;
    gmeow:lossyDrop "EDOAL carries the get leg + relation + measure only" ,
        "actual: correspondence: mapBotAdjacentTo::bot" ,
        "actual: get-leg profile loss: only adjacencies between indoor topology kinds are projected" ,
        "actual: get-leg: the put leg is not carried by EDOAL" ,
        "actual: get-leg: world/standpoint scope is not carried by EDOAL" ,
        "the SOL caveats, the put leg, and world/standpoint scope are dropped" ;
    logic:complexityClass "N/A (alignment)" ;
    logic:preservationKind logic:SoundUnderApproximation .

