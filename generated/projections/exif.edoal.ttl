@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix exif: <http://www.w3.org/2003/12/exif/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/exif>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Property ;
            edoal:uri gmeow:captureTime ;
        ] ;
        align:entity2 [
            a edoal:Property ;
            edoal:uri exif:dateTime ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.9"^^xsd:double ;
        rdfs:label "captureTime → exif:dateTime"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:imageOrientation ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri exif:orientation ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "imageOrientation → exif:orientation"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:pixelHeight ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri exif:height ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "pixelHeight → exif:height"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:pixelWidth ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri exif:width ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "pixelWidth → exif:width"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "exif" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → exif (EDOAL)"@en .
