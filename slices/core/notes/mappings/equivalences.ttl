@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Term equivalences for the notes & annotation domain (annotation target span) — GMEOW authoring source.
# Compiled to mappings/gmeow-notes.sssom.tsv by `gmeow compile-mappings`.
# Alignments are BY REFERENCE (Principle 5); GMEOW never imports an external axiom.

gmeow:mapsetNotes a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/notes" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Notes & annotation alignments (annotation target span).
        W3C Web Annotation: GMEOW Annotation is a relator with provenance, confidence, temporal scope and suppression; oa:Annotation is a flatter body/target/motivation construct — closeMatch, not exactMatch.
        schema.org: GMEOW Note/Comment are information objects with full provenance; schema:NoteDigitalDocument / schema:Comment are flat document types — closeMatch.
        ActivityStreams: as:Note is a flat social-media note; GMEOW Note carries the full provenance stack — closeMatch.
        SIOC: sioc:Post / sioc:Reply are community-discussion items; GMEOW Comment is a reply note with threading — closeMatch.
        FOAF: foaf:maker is the flat authorship shortcut; GMEOW uses reified Participation / wasAttributedTo — closeMatch.""" .

# --- W3C Web Annotation ---------------------------------------------------- #

gmeow:Annotation skos:closeMatch oa:Annotation {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW Annotation is a relator with provenance/confidence/temporal scope/suppression; oa:Annotation is a flatter body/target/motivation construct"
|} .

gmeow:annotationBody skos:closeMatch oa:hasBody {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "The note body of the annotation; oa:hasBody may also be a textual body or SpecificResource"
|} .

gmeow:annotationTarget skos:closeMatch oa:hasTarget {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:annotationMotivation skos:closeMatch oa:motivatedBy {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:noteAuthor skos:closeMatch dcterms:creator {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Flat authorship shortcut; the heavy case uses reified Participation / wasAttributedTo"
|} .

# --- schema.org ------------------------------------------------------------ #

gmeow:Note skos:closeMatch schema:NoteDigitalDocument {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW Note is an information object with full provenance; schema:NoteDigitalDocument is a flat document type"
|} .

gmeow:Comment skos:closeMatch schema:Comment {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW Comment is a threaded reply note; schema:Comment is a flat comment type"
|} .

gmeow:mentions skos:closeMatch schema:mentions {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:noteContent skos:closeMatch schema:text {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW noteContent is the full note text; schema:text is the flat content property"
|} .

gmeow:commentParent skos:closeMatch schema:parentItem {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "GMEOW commentParent points to the parent annotation/comment; schema:parentItem is the flat parent item reference"
|} .

# --- ActivityStreams ------------------------------------------------------- #

gmeow:Note skos:closeMatch as:Note {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "GMEOW Note carries full provenance; as:Note is a flat social-media note type"
|} .

gmeow:noteContent skos:closeMatch as:content {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW noteContent is the full note text; as:content is the flat ActivityStreams content property"
|} .

# --- SIOC ------------------------------------------------------------------ #

gmeow:Comment skos:closeMatch sioc:Post {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "GMEOW Comment is a reply note with threading; sioc:Post is a generic community post"
|} .

gmeow:commentParent skos:closeMatch sioc:reply_of {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:hasReply skos:closeMatch sioc:has_reply {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "hasReply is transitive; sioc:has_reply is the direct reply link"
|} .

# --- FOAF / PROV ----------------------------------------------------------- #

gmeow:noteAuthor skos:closeMatch foaf:maker {|
    gmeow:sssomFile "gmeow-notes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Flat authorship shortcut; the heavy case uses reified Participation / prov:wasAttributedTo"
|} .
