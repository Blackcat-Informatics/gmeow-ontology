    gmeow:saRationale "ExecutionStatus seed values MUST NOT be owl:Class — overtyping execution statuses as subclasses is banned (Principle 9, #226). Mirrors test_execution_status_values_are_individuals (mustNot arm)." .

# --- 9a. BranchConditionType seed individuals are typed gmeow:BranchConditionType (MUST) ---
ex:saBranchConditionTypeValuesAreIndividuals a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:branchConditionIf       a gmeow:BranchConditionType .
    gmeow:branchConditionSwitch   a gmeow:BranchConditionType .
    gmeow:branchConditionLoop     a gmeow:BranchConditionType .
    gmeow:branchConditionParallel a gmeow:BranchConditionType .
}""" ;
    gmeow:saRationale "All four BranchConditionType seed individuals MUST be typed gmeow:BranchConditionType — guard condition kinds are an open value vocabulary of individuals, never subclasses (Principle 9, #226). Mirrors test_branch_condition_type_values_are_individuals (must arm)." .

