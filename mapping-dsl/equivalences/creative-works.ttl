    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "LRMoo F1 Work — aligned by reference, not axiom import." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw013 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Expression ;
