#
# Counter-example for logic:FormalizationCandidateShape: a FormalizationCandidate
# with NO logic:candidateCategory. logic:candidateCategory has sh:minCount 1,
# so validation MUST emit shacl.MinCountConstraintComponent (and no other finding).
# Bound by tests/example-conformance.ttl (ex:ecCandidateMissingCategory).
# Lives under tests/ (NOT examples/) so the global make validate gate does not
# reject it.
# The source hash commits to the exact UTF-8 skos:definition lexical text of
# logic:properPartOf in logic/module.ttl, without a final newline.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://example.org/lgc/> .

ex:contractEL a logic:ReasoningContract ;
    rdfs:label "EL profile (fixture)"@en .

ex:candidateMissingCategory a logic:FormalizationCandidate ;
    logic:candidateSourceHash "0b42321ddeb1371a834e5063caae94def5bc35c9f7eaef5f91d217185b495621"^^gmeow:sha256Digest ;
    logic:candidateExtractionProvenance "logic-foundation-charter §Greenfield features"^^xsd:string ;
    logic:candidateScope "logic:properPartOf over the endurant spine"^^xsd:string ;
    logic:candidateContract ex:contractEL ;
    logic:candidateLifecycle logic:CandidateProposed ;
    logic:candidateProjectionBehavior logic:SoundUnderApproximation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating .
