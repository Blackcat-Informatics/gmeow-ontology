logic:corrOnDataRangeGrounding
    a logic:GroundingCorrespondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "logic:onDataRange to W3C OWL onDataRange grounding"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint logic:onDataRange ;
    logic:targetEndpoint <http://www.w3.org/2002/07/owl#onDataRange> ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
