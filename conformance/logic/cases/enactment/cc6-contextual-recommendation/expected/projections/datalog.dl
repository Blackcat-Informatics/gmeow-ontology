methodStep(?method, ?step, ?C) :-
    first(?cell, ?step, ?C),
    methodYieldCell(?method, ?cell, ?C).
methodYieldCell(?method, ?cell, ?C) :-
    methodYields(?method, ?cell, ?C).
methodYieldCell(?method, ?next, ?C) :-
    rest(?cell, ?next, ?C),
    methodYieldCell(?method, ?cell, ?C).
refinementRejectedOnApproval(?step, ?entry, ?C) :-
    entryAction(?entry, ?step, ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/ApprovalCreated", ?C).
refinementRejectedOnCapability(?step, ?capability, ?C) :-
    gapBlockedStep(?gap, ?step, ?C),
    proposalBlockedStep(?proposal, ?step, ?C),
    proposalMissingCapability(?proposal, ?capability, ?C).
refinementRejectedOnPrecondition(?step, ?situation, ?C) :-
    gateVerdict(?probe, "https://blackcatinformatics.ca/logic/GateDenied", ?C),
    probesSchema(?probe, ?step, ?C),
    precondition(?step, ?situation, ?C).
refinementRejectedOnResource(?step, ?lease, ?C) :-
