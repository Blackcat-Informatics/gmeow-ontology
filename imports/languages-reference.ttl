# Natural Languages
# =========================================================================== #

gmeow:langEnglish a gmeow:Language ;
    rdfs:label "English"@x-gmeow-english ;
    skos:definition "A West Germanic language originating in England, now a global lingua franca."@x-gmeow-english ;
    gmeow:languageTag "x-gmeow-english" ;
    gmeow:bcp47Tag "en"^^xsd:language ;
    gmeow:languageCode "en" ;
    gmeow:languageCode "eng" ;
    gmeow:languageOrigin gmeow:originNatural ;
    gmeow:languageModality gmeow:modalitySpoken, gmeow:modalityWritten ;
    gmeow:languageStatus gmeow:statusLiving ;
    gmeow:usesWritingSystem gmeow:wsLatin ;
    gmeow:hasAppellation gmeow:appEnglishGlossonym ;
    skos:exactMatch wd:Q1860 ;
    skos:exactMatch <http://lexvo.org/id/iso639-3/eng> ;
    skos:exactMatch <https://glottolog.org/resource/languoid/id/stan1293> ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> .

gmeow:appEnglishGlossonym a gmeow:Appellation ;
    gmeow:fullName "English"@x-gmeow-english ;
    gmeow:nameLanguage gmeow:langEnglish ;
    gmeow:namePurpose gmeow:namePurposeGlossonym ;
    gmeow:displayable true .

gmeow:langGerman a gmeow:Language ;
    rdfs:label "German"@x-gmeow-english ;
    skos:definition "A West Germanic language mainly spoken in Central Europe."@x-gmeow-english ;
    gmeow:languageTag "x-gmeow-german" ;
    gmeow:bcp47Tag "de"^^xsd:language ;
    gmeow:languageCode "de" ;
    gmeow:languageCode "deu" ;
    gmeow:languageOrigin gmeow:originNatural ;
    gmeow:languageModality gmeow:modalitySpoken, gmeow:modalityWritten ;
    gmeow:languageStatus gmeow:statusLiving ;
    gmeow:usesWritingSystem gmeow:wsLatin ;
    gmeow:hasAppellation gmeow:appGermanEndonym, gmeow:appGermanExonym ;
    skos:exactMatch wd:Q188 ;
    skos:exactMatch <http://lexvo.org/id/iso639-3/deu> ;
    skos:exactMatch <https://glottolog.org/resource/languoid/id/stan1295> ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> .

gmeow:appGermanEndonym a gmeow:Appellation ;
    gmeow:fullName "Deutsch"@x-gmeow-german ;
    gmeow:nameLanguage gmeow:langGerman ;
    gmeow:namePurpose gmeow:namePurposeEndonym ;
    gmeow:displayable true .

gmeow:appGermanExonym a gmeow:Appellation ;
    gmeow:fullName "German"@x-gmeow-german ;
    gmeow:nameLanguage gmeow:langGerman ;
    gmeow:namePurpose gmeow:namePurposeExonym ;
    gmeow:displayable true .

gmeow:langSpanish a gmeow:Language ;
    rdfs:label "Spanish"@x-gmeow-english ;
    skos:definition "A Romance language originating in the Iberian Peninsula, now spoken globally."@x-gmeow-english ;
    gmeow:languageTag "x-gmeow-spanish" ;
    gmeow:bcp47Tag "es"^^xsd:language ;
    gmeow:languageCode "es" ;
    gmeow:languageCode "spa" ;
    gmeow:languageOrigin gmeow:originNatural ;
    gmeow:languageModality gmeow:modalitySpoken, gmeow:modalityWritten ;
    gmeow:languageStatus gmeow:statusLiving ;
    gmeow:usesWritingSystem gmeow:wsLatin ;
    gmeow:hasAppellation gmeow:appSpanishEndonym, gmeow:appSpanishExonym ;
    skos:exactMatch wd:Q1321 ;
    skos:exactMatch <http://lexvo.org/id/iso639-3/spa> ;
    skos:exactMatch <https://glottolog.org/resource/languoid/id/stan1288> ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> .

gmeow:appSpanishEndonym a gmeow:Appellation ;
