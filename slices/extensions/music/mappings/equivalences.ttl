|} .

# --------------------------------------------------------------------------- #
# External vocabularies — performance events & participation (performance events and participation)
# --------------------------------------------------------------------------- #

gmeow:PerformanceParticipation skos:closeMatch prov:Association {|
    gmeow:sssomFile "gmeow-music.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "PROV-O Association is the generic qualified participation idiom."
|} .

gmeow:performanceOf skos:closeMatch mo:performance_of {|
    gmeow:sssomFile "gmeow-music.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Music Ontology mo:performance_of relates a performance event to the musical work performed."
|} .

gmeow:rolePerformer skos:closeMatch schema:performer {|
    gmeow:sssomFile "gmeow-music.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema.org performer — already bridged from the events slice; repeated here for the music alignment set."
|} .

