# Well-formed Participation fixture. Every subject satisfies the events SHACL
# shapes: a Participation mediates exactly one event and at least one participant;
# the event carries a type; a participation whose validity ended is retained with no display flag
# and draws no suppression warning. `SHACL validation` MUST conform.

@prefix ex:    <https://example.org/shapes/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:birth a gmeow:LifeEvent , gmeow:Event ;
    gmeow:eventType gmeow:eventTypeBirth ;
    gmeow:eventTime "1990-04-12T00:00:00Z"^^xsd:dateTime .

ex:sam a gmeow:Entity .
ex:wrongMidwife a gmeow:Entity .

ex:bornPart a gmeow:Participation ;
    gmeow:participationEvent ex:birth ;
    gmeow:participationParticipant ex:sam ;
    gmeow:participationRole gmeow:roleParticipantPrincipal .

# A participation whose validity ended. It is retained and carries no display flag:
# an ended validity interval is not a reason to hide a record (Principle 10).
ex:correctedPart a gmeow:Participation ;
    gmeow:participationEvent ex:birth ;
    gmeow:participationParticipant ex:wrongMidwife ;
    gmeow:participationRole gmeow:roleWitness ;
    gmeow:validUntil "1991-01-01T00:00:00Z"^^xsd:dateTime .
