# --- 3a. genderValue and expressionValue are functional ObjectProperties (MUST)
ex:saValuePropertiesFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:genderValue    a owl:ObjectProperty , owl:FunctionalProperty .
    gmeow:expressionValue a owl:ObjectProperty , owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:genderValue and gmeow:expressionValue MUST be owl:ObjectProperty and owl:FunctionalProperty (functional per facet). Mirrors test_value_properties_are_functional_facets_nonfunctional (positive half)." .

# --- 3b. hasGenderIdentity is a non-functional ObjectProperty (MUST) ---------
ex:saHasGenderIdentityShape a gmeow:StructuralAssertion ;
