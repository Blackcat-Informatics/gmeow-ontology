@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .

# Projection mappings: GMEOW rights -> schema.org rights and IP terms.
# Authored in the rights slice and consumed by the registered mappings generator.
# The Copyright relator flattens to schema.org's flat copyright terms;
# hasLicense projects to schema:license; attributionText projects to
# schema:creditText; Mark projects to schema:Brand; and access/licence-page/usage
# fields expose the lightweight schema.org discovery surface.

gmeow:mapSchemaLicense a gmeow:ProjectionMapping ;
    rdfs:label "hasLicense → schema:license"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "work" ; gmeow:value "lic" ;
        gmeow:atom ( [ gmeow:subjectVar "work" ; gmeow:predicate gmeow:hasLicense ; gmeow:objectVar "lic" ] ) ;
        gmeow:edoalSource gmeow:hasLicense ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:license ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:edoalTargetKind "relation" ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:closeMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ] .

gmeow:mapSchemaCopyrightHolder a gmeow:ProjectionMapping ;
    rdfs:label "Copyright relator holder → schema:copyrightHolder (flatten)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "cw" ; gmeow:value "holder" ;
        gmeow:atom (
            [ gmeow:subjectVar "cw" ; gmeow:predicate gmeow:hasCopyright ; gmeow:objectVar "cr" ]
            [ gmeow:subjectVar "cr" ; gmeow:predicate gmeow:copyrightHolder ; gmeow:objectVar "holder" ] ) ;
        gmeow:edoalSource gmeow:copyrightHolder ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:copyrightHolder ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:edoalTargetKind "relation" ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:closeMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
        gmeow:lossyDrop "the Copyright relator (year, notice, status) collapses to a flat schema:copyrightHolder edge" ] .

gmeow:mapSchemaCopyrightYear a gmeow:ProjectionMapping ;
    rdfs:label "Copyright relator year → schema:copyrightYear (flatten)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "cw" ; gmeow:value "yr" ;
        gmeow:atom (
            [ gmeow:subjectVar "cw" ; gmeow:predicate gmeow:hasCopyright ; gmeow:objectVar "cr" ]
            [ gmeow:subjectVar "cr" ; gmeow:predicate gmeow:copyrightYear ; gmeow:objectVar "yr" ] ) ;
        gmeow:edoalSource gmeow:copyrightYear ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:copyrightYear ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:closeMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
        gmeow:lossyDrop "the Copyright relator (holder, notice, status) collapses to a flat schema:copyrightYear edge" ] .

gmeow:mapSchemaCopyrightNotice a gmeow:ProjectionMapping ;
    rdfs:label "Copyright relator notice → schema:copyrightNotice (flatten)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "cw" ; gmeow:value "notice" ;
        gmeow:atom (
            [ gmeow:subjectVar "cw" ; gmeow:predicate gmeow:hasCopyright ; gmeow:objectVar "cr" ]
            [ gmeow:subjectVar "cr" ; gmeow:predicate gmeow:copyrightNotice ; gmeow:objectVar "notice" ] ) ;
        gmeow:edoalSource gmeow:copyrightNotice ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:copyrightNotice ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:closeMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
        gmeow:lossyDrop "the structured Copyright relator (holder, year, status) collapses to a flat schema:copyrightNotice edge" ] .

gmeow:mapSchemaCreditText a gmeow:ProjectionMapping ;
    rdfs:label "attributionText → schema:creditText"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "credit" ;
        gmeow:atom ( [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:attributionText ; gmeow:objectVar "credit" ] ) ;
        gmeow:edoalSource gmeow:attributionText ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:creditText ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:closeMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ] .

gmeow:mapSchemaBrand a gmeow:ProjectionMapping ;
    rdfs:label "Mark → schema:Brand"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "mark" ;
        gmeow:atom ( [ gmeow:subjectVar "mark" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Mark ] ) ;
        gmeow:edoalSource gmeow:Mark ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toClass schema:Brand ; gmeow:relation "<=" ; gmeow:confidence 0.8 ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:closeMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ] .

gmeow:mapSchemaIsAccessibleForFree a gmeow:ProjectionMapping ;
    rdfs:label "isAccessibleForFree → schema:isAccessibleForFree"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "free" ;
        gmeow:atom ( [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:isAccessibleForFree ; gmeow:objectVar "free" ] ) ;
        gmeow:edoalSource gmeow:isAccessibleForFree ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:isAccessibleForFree ; gmeow:relation "=" ; gmeow:confidence 0.95 ; gmeow:mnemomorphic true ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:exactMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ] .

