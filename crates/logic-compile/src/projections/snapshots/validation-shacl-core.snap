---
source: crates/logic-compile/src/projections/tests.rs
expression: shacl.content
---
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/test/validation-full-surface/A-shape> a sh:NodeShape ;
    <http://www.w3.org/2000/01/rdf-schema#label> "Full-surface validation shape A" ;
    sh:targetClass <https://example.org/test/validation-full-surface/A> ;
    sh:property [ sh:path <https://example.org/test/validation-full-surface/p-in> ; sh:minCount 0 ; sh:maxCount 3 ; sh:in ( <https://example.org/test/validation-full-surface/v1> "bonjour"@fr "typed"^^<http://www.w3.org/2001/XMLSchema#token> ) ] ;
    sh:property [ sh:path [ sh:inversePath <https://example.org/test/validation-full-surface/p-inv> ] ; sh:minCount 0 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path <https://example.org/test/validation-full-surface/p-opt> ; sh:in ( <https://example.org/test/validation-full-surface/low> <https://example.org/test/validation-full-surface/high> ) ; sh:minInclusive 0 ; sh:maxInclusive 2 ] ;
    sh:property [ sh:path <https://example.org/test/validation-full-surface/p-mixed> ; sh:minInclusive "2020-01-01T00:00:00Z"^^xsd:dateTime ; sh:languageIn ( "en" "fr" ) ; sh:pattern "^[A-Z]" ; sh:flags "i" ; sh:severity sh:Warning ] ;
    sh:property [ sh:path <https://example.org/test/validation-full-surface/p-bignum> ; sh:datatype <http://www.w3.org/2001/XMLSchema#decimal> ; sh:minInclusive 10000000000000000 ] ;
    sh:property [ sh:path <https://example.org/test/validation-full-surface/p-scalar> ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype <http://www.w3.org/2001/XMLSchema#string> ; sh:maxLength 64 ; sh:minLength 2 ] ;
    sh:property [ sh:path <https://example.org/test/validation-full-surface/p-logical> ; sh:hasValue <https://example.org/test/validation-full-surface/fixed> ; sh:not [ sh:class <https://example.org/test/validation-full-surface/Disjoint> ] ; sh:qualifiedValueShape [ sh:class <https://example.org/test/validation-full-surface/Q> ] ; sh:qualifiedMinCount 1 ; sh:message "p-logical must satisfy the qualified value shape" ] ;
    sh:property [ sh:path <https://example.org/test/validation-full-surface/p-numeric> ; sh:datatype <http://www.w3.org/2001/XMLSchema#decimal> ; sh:minInclusive 0 ; sh:maxExclusive 10 ] .

<https://example.org/test/validation-full-surface/D-shape> a sh:NodeShape ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this <https://example.org/test/validation-full-surface/kind> <https://example.org/test/validation-full-surface/SpecialKind> }""" ] ;
    sh:property [ sh:path <https://example.org/test/validation-full-surface/p-d> ; sh:minCount 1 ; sh:class <https://example.org/test/validation-full-surface/DTarget> ] .

<https://example.org/test/validation-full-surface/E-shape> a sh:NodeShape ;
    sh:targetClass <https://example.org/test/validation-full-surface/E> ;
    sh:property [ sh:path <https://example.org/test/validation-full-surface/p-e> ; sh:nodeKind sh:IRI ; sh:reifierShape <https://example.org/test/validation-full-surface/E-reifier-shape> ; sh:reificationRequired true ] .

<https://example.org/test/validation-full-surface/p-domain-shape> a sh:NodeShape ;
    sh:targetSubjectsOf <https://example.org/test/validation-full-surface/p-domain> ;
    sh:class <https://example.org/test/validation-full-surface/DomainClass> ;
    sh:not [ sh:class <https://example.org/test/validation-full-surface/ExcludedClass> ] .

<https://example.org/test/validation-full-surface/p-range-shape> a sh:NodeShape ;
    sh:targetObjectsOf <https://example.org/test/validation-full-surface/p-range> ;
    sh:datatype <http://www.w3.org/2001/XMLSchema#anyURI> .
