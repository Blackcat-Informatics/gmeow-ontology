        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A discourse-time frame anchors via gmeow:discourseTimeOf and a story-time frame via gmeow:storyTimeOf — never the other anchor." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/narrativeTimeAxis> <https://blackcatinformatics.ca/gmeow/axisStoryTime> . $this <https://blackcatinformatics.ca/gmeow/discourseTimeOf> ?x . }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/NarrativeTimeFrameAxisConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/NarrativeTimeFrame> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/NarrativeTimeFrameShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/NarrativeTimeFrame> ;
    sh:sparql [
