gmeow:Event logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:eventReason ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( xsd:string rdf:langString rdf:dirLangString ) ] ] .

gmeow:engineContract
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "engine contract"@x-gmeow-english ;
    skos:definition "The exact source engine-contract identifier governing a recorded event. Preserve all code points and spacing; the identifier alone supplies neither an implemented contract nor an execution receipt."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly supplies this relation and its context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing missing source bindings or inferring execution and success from this record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep the supplied xsd:string or xsd:token engine-contract identifier on the recorded Event with its source attribution. Retain any actual contract artifact or execution evidence separately."@x-gmeow-english ;
    skos:scopeNote "Preserve the supplied lexical form and datatype: verbatim xsd:string and explicitly supplied xsd:token are admitted. Do not normalize whitespace, retype a string or infer token typing. These declarations do not install a token lexical checker. Naming a contract does not authenticate its implementation or establish that an event executed under it."@x-gmeow-english ;
    skos:example "ex:record gmeow:engineContract \"source-value\" ."@x-gmeow-english ;
    logic:domain gmeow:Event ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:string xsd:token ) ] .

