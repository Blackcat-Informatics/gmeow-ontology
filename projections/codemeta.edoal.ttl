@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix codemeta: <https://codemeta.github.io/terms/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://blackcatinformatics.ca/gmeow/projections/codemeta> a align:Alignment ;
    rdfs:label "GMEOW → codemeta (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "contentDigest → codemeta:identifier"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:contentDigest ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri codemeta:identifier ] ;
            align:relation "=" ],
        [ a align:Cell ;
            rdfs:label "projectLicense → codemeta:license"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:projectLicense ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri codemeta:license ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "Package → codemeta:SoftwareSourceCode (package-as-product)"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Package ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri codemeta:SoftwareSourceCode ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "hasRepository → codemeta:codeRepository"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasRepository ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri codemeta:codeRepository ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "SoftwareProduct → codemeta:SoftwareSourceCode"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:SoftwareProduct ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri codemeta:SoftwareSourceCode ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "releaseVersion → codemeta:softwareVersion"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:releaseVersion ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri codemeta:softwareVersion ] ;
            align:relation "=" ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "codemeta" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@en .
