#
# Conforming fixture for logic:ActionSchemaShape — a well-formed
# logic:ActionSchema carrying the two REQUIRED facets (logic:precondition and
# logic:capability) plus several optional facets, including two
# logic:nondeterministicOutcome values (multi-valued) and one logic:effect /
# logic:observation. Bound by tests/example-conformance.ttl
# (ex:ecActionSchemaWellformed, gmeow:conforms). Self-contained: the harness
# loads logic/module.ttl + ONLY this file against logic/shapes.ttl.
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://example.org/lgc/> .

ex:schemaIgnite a logic:ActionSchema ;
    rdfs:label "ignite the main engine (fixture)"@en ;
    logic:precondition ex:situationFuelled ;
    logic:capability ex:capabilityFlightControl ;
    logic:effect ex:situationThrusting ;
    logic:observation ex:observationChamberPressure ;
    logic:nondeterministicOutcome ex:outcomeNominalBurn ;
    logic:nondeterministicOutcome ex:outcomeHardStart .
