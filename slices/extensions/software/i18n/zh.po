msgctxt "https://blackcatinformatics.ca/gmeow/tagName|http://www.w3.org/2004/02/skos/core#example"
msgid "The source record names gmeow:tagName explicitly."
msgstr "来源记录显式命名 gmeow:tagName。"


msgctxt "https://blackcatinformatics.ca/gmeow/tagTarget|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring object completeness, ownership or successful Git execution from tagTarget alone."
msgstr "避免仅从 tagTarget 推断对象完备性、所有权或 Git 执行成功。"


msgctxt "https://blackcatinformatics.ca/gmeow/tagTarget|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit tagTarget value with its source and observation scope."
