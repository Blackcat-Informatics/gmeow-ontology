gmeow:FoundNothingFieldUniquenessConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Found-nothing field uniqueness constraint"@x-gmeow-english ;
    skos:definition "A foundNothing report has one count, input scope, vantage and generating activity; independent executions or vantages retain distinct reports."@x-gmeow-english ;
    gmeow:useWhen "Use to check the declared binding or numeric boundary on its own supplied reading record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this intrinsic law as an executed reader, authenticated receipt or digest verification."@x-gmeow-english ;
    gmeow:howToUse "Retain actual source values and evaluate the canonical law in the selected interpretation."@x-gmeow-english ;
    skos:scopeNote "The conditional uniqueness law applies only to explicit foundNothing reports, not to all observations or provenance relationships."@x-gmeow-english ;
    skos:example "gmeow:FoundNothingFieldUniquenessConstraint logic:formalizes gmeow:foundNothing ."@x-gmeow-english ;
    logic:formalizes gmeow:foundNothing ; logic:message "A foundNothing report has one count, input scope, vantage and generating activity; independent executions or vantages retain distinct reports."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "count" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:foundNothing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "count" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "field" ] , [ logic:termIndex 1 ; logic:termVariable "left" ] , [ logic:termIndex 2 ; logic:termVariable "right" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:foundNothing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "count" ] ] , [ a logic:Formula ; logic:relation logic:termIn ; logic:argument [ logic:termIndex 0 ; logic:termVariable "field" ] , [ logic:termIndex 1 ; logic:termIri gmeow:foundNothing ] , [ logic:termIndex 2 ; logic:termIri gmeow:readingScope ] , [ logic:termIndex 3 ; logic:termIri gmeow:vantage ] , [ logic:termIndex 4 ; logic:termIri gmeow:wasGeneratedBy ] ] , [ a logic:Formula ; logic:relation logic:linkVia ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "field" ] , [ logic:termIndex 2 ; logic:termVariable "left" ] ] , [ a logic:Formula ; logic:relation logic:linkVia ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "field" ] , [ logic:termIndex 2 ; logic:termVariable "right" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "left" ] , [ logic:termIndex 1 ; logic:termVariable "right" ] ] ] ] ] ] .

gmeow:FoundNothingReportIdentityConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Found-nothing report identity constraint"@x-gmeow-english ;
    skos:definition "The same generating activity, input scope and reader identify one foundNothing report; a later execution has its own activity and report."@x-gmeow-english ;
    gmeow:useWhen "Use to check the declared binding or numeric boundary on its own supplied reading record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this intrinsic law as an executed reader, authenticated receipt or digest verification."@x-gmeow-english ;
    gmeow:howToUse "Retain actual source values and evaluate the canonical law in the selected interpretation."@x-gmeow-english ;
    skos:scopeNote "This prevents duplicate reports for one selected computation without collapsing reports from different executions or readers."@x-gmeow-english ;
    skos:example "gmeow:FoundNothingReportIdentityConstraint logic:formalizes gmeow:foundNothing ."@x-gmeow-english ;
    logic:formalizes gmeow:foundNothing ; logic:message "The same generating activity, input scope and reader identify one foundNothing report; a later execution has its own activity and report."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "other" ] , [ logic:termIndex 2 ; logic:termVariable "leftCount" ] , [ logic:termIndex 3 ; logic:termVariable "rightCount" ] , [ logic:termIndex 4 ; logic:termVariable "scope" ] , [ logic:termIndex 5 ; logic:termVariable "reader" ] , [ logic:termIndex 6 ; logic:termVariable "activity" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:foundNothing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "leftCount" ] ] , [ a logic:Formula ; logic:relation gmeow:foundNothing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "rightCount" ] ] , [ a logic:Formula ; logic:relation gmeow:readingScope ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "scope" ] ] , [ a logic:Formula ; logic:relation gmeow:readingScope ; logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "scope" ] ] , [ a logic:Formula ; logic:relation gmeow:vantage ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "reader" ] ] , [ a logic:Formula ; logic:relation gmeow:vantage ; logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "reader" ] ] , [ a logic:Formula ; logic:relation gmeow:wasGeneratedBy ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "activity" ] ] , [ a logic:Formula ; logic:relation gmeow:wasGeneratedBy ; logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "activity" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "other" ] ] ] ] .



gmeow:FoundNothingExactCountConstraint
    a logic:AggregateConstraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Found-nothing exact input count constraint"@x-gmeow-english ;
    skos:definition "The foundNothing value equals the number of distinct wasDerivedFrom input records retained on that report; two-way scope/evidence laws bind precisely the same declared scope roster."@x-gmeow-english ;
    gmeow:useWhen "Use to check the reported count against its own distinct retained RDF terms."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid counting neighboring reports, repeated visits or decoded literal values."@x-gmeow-english ;
    gmeow:howToUse "Retain the binding and empty-group evidence laws alongside this aggregate."@x-gmeow-english ;
    skos:scopeNote "The positive-input triple creates aggregate groups; the separate zero/positive evidence law covers the empty group. Repeated visits do not increase a distinct-record count."@x-gmeow-english ;
    skos:example "gmeow:FoundNothingExactCountConstraint logic:formalizes gmeow:foundNothing ."@x-gmeow-english ;
    logic:formalizes gmeow:foundNothing ; logic:message "The foundNothing value equals the number of distinct wasDerivedFrom input records retained on that report; two-way scope/evidence laws bind precisely the same declared scope roster."@x-gmeow-english ;
    logic:onClass gmeow:Refinement ; logic:aggFunction "COUNT" ; logic:aggDistinct true ; logic:aggPath gmeow:wasDerivedFrom ; logic:aggComparator "=" ; logic:aggCompareTo gmeow:foundNothing .


# Explicit range reading does not require fields on unrelated records.
[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/foundNothing" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:ContactReading
    a logic:Class, logic:SubKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Contact Reading"@x-gmeow-english ;
    skos:definition "An observer’s record-derived reading of a being the holder can address, with that being as observedFeature and the named, versioned reading process as vantage."@x-gmeow-english ;
    skos:scopeNote "The holder’s records supply evidence; the holder and the reading process are distinct roles. This is the observer’s reading, never automatically the being’s or holder’s claim."@x-gmeow-english ;
    skos:example "A versioned observer reads actual holder records and reports an addressable being’s recorded name and contact kind while the holder’s stated rules decide no relationship ring."@x-gmeow-english ;
    gmeow:useWhen "Use for an observer-derived contact entry grounded in actual records about a being the holder can address."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using ContactPoint for this reading, making its selected name globally preferred, inferring a Person or Agent from correspondence alone, or guessing a relationship ring."@x-gmeow-english ;
    gmeow:howToUse "Name the actual being through observedFeature and the named, versioned observer through vantage. Retain source records through wasDerivedFrom and any supplied ReadingScope; keep the holder distinct and preserve earlier names and attributed readings."@x-gmeow-english ;
    logic:subClassOf gmeow:Refinement .

gmeow:contactName
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "contact name as read"@x-gmeow-english ;
    skos:definition "The name selected by this ContactReading as the latest name given to the being in the holder’s supplied records, within their actual source scope and chronology. Earlier names remain aliases."@x-gmeow-english ;
    skos:scopeNote "Current is local to the supplied records and this attributed reading, not a globally preferred name. Missing chronology or unresolved ties do not authorize a fabricated winner."@x-gmeow-english ;
    skos:example "A later source record supplies a new name while the earlier recorded names remain available as aliases."@x-gmeow-english ;
    gmeow:useWhen "Use when the reading actually selects the name most recently supplied within the holder’s recorded source context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid choosing a primary name for the being, deleting aliases, inventing source order or language, or inferring identity from equal name strings."@x-gmeow-english ;
    gmeow:howToUse "Keep the supplied literal on the ContactReading, preserving lexical form, datatype, actual language and RDF 1.2 direction. Retain earlier names in their source-backed name records without automatically asserting the reading as the being’s claim."@x-gmeow-english ;
    logic:domain gmeow:ContactReading ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:string rdf:langString rdf:dirLangString ) ] .

gmeow:ContactKind
    a logic:Class, logic:AbstractIndividualType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Contact Kind"@x-gmeow-english ;
    skos:definition "An open value vocabulary for the kind of addressable being reported by a ContactReading, including inner agent and correspondent readings."@x-gmeow-english ;
    skos:scopeNote "These values classify the observer’s reading. They do not replace entity identity or infer a Person or Agent type from message attribution alone."@x-gmeow-english ;
    skos:example "A reading reports the supplied correspondent classification without deciding what kind of real-world being the correspondent is."@x-gmeow-english ;
    gmeow:useWhen "Use as the value axis for an explicitly reported contact-kind reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid modelling the values as subclasses of ContactReading or treating the axis as authenticated identity, personhood or message authorship."@x-gmeow-english ;
    gmeow:howToUse "Reference an actual value through contactKind on the reading. Extend the open vocabulary with attributed values without imposing a global winner."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:contactKind
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "contact kind as read"@x-gmeow-english ;
    skos:definition "Relates a ContactReading to its supplied ContactKind value, retaining the observer’s classification of the addressable being."@x-gmeow-english ;
    skos:scopeNote "The relation is optional and nonfunctional. Supplied classifications retain their attribution; absence does not select a kind."@x-gmeow-english ;
    skos:example "The observer records contactKindCorrespondent because the holder’s conversations attribute a message to the being."@x-gmeow-english ;
    gmeow:useWhen "Use when an actual ContactKind classification is supplied for this reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring a kind from missing fields or using the value to type the observed being automatically as Person or Agent."@x-gmeow-english ;
    gmeow:howToUse "Attach the supplied value to the ContactReading and preserve source and viewpoint on the exact statement. Keep the actual being in observedFeature."@x-gmeow-english ;
    logic:domain gmeow:ContactReading ;
    logic:range gmeow:ContactKind .

gmeow:contactKindInnerAgent
    a gmeow:ContactKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "inner agent contact"@x-gmeow-english ;
    skos:definition "The reading classifies the addressable being as an agent within the holder’s own environment."@x-gmeow-english ;
    skos:scopeNote "This is a supplied contact classification, not discovery of an agent, proof of identity or permission to communicate."@x-gmeow-english ;
    skos:example "The source reading identifies the being as an agent within the holder’s environment."@x-gmeow-english ;
    gmeow:useWhen "Use when the reading explicitly supplies the inner-agent contact classification."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing an environment, holder, agent identity or authenticated address from this value alone."@x-gmeow-english ;
    gmeow:howToUse "Reference this value through contactKind on the actual reading and retain its source context."@x-gmeow-english .

gmeow:contactKindCorrespondent
    a gmeow:ContactKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "correspondent contact"@x-gmeow-english ;
    skos:definition "The reading records only that a message in the holder’s conversations is attributed to the being; it reads nothing further about what that being is."@x-gmeow-english ;
    skos:scopeNote "Message attribution alone supplies no Person or Agent type, verified authorship, independent identity or relationship ring."@x-gmeow-english ;
    skos:example "A conversation record attributes a message to a named correspondent while its real-world nature remains unknown."@x-gmeow-english ;
    gmeow:useWhen "Use when actual conversation records attribute a message to the being; retain any independently supplied classification separately."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this value as proof of a human sender, an autonomous agent, a legal person or an authenticated message author."@x-gmeow-english ;
    gmeow:howToUse "Reference this value through contactKind and retain the actual conversation evidence without inferring a stronger being type."@x-gmeow-english .

gmeow:ContactRingOutcome
    a logic:Class, logic:AbstractIndividualType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Contact Ring Outcome"@x-gmeow-english ;
    skos:definition "An open value vocabulary reporting whether the holder’s stated relationship classification rules decide a ring for the being in this ContactReading."@x-gmeow-english ;
    skos:scopeNote "This outcome axis is distinct from the overall refinementOutcome and from any actual ring identity. It does not execute the rules or prescribe a universal relationship scale."@x-gmeow-english ;
    skos:example "The contact’s name is read from records, while the reported ring outcome remains undecided under the holder’s stated rules."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve an explicitly reported relationship-ring decision outcome for this contact reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using this vocabulary as ring membership, audience-ring rank, intimacy measurement or a default outcome for missing data."@x-gmeow-english ;
    gmeow:howToUse "Reference the supplied value through contactRingOutcome. Retain actual source and rule context without inventing a ring or claiming rule execution."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:contactRingOutcome
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "contact ring outcome"@x-gmeow-english ;
    skos:definition "Relates a ContactReading to the supplied ContactRingOutcome reported under the holder’s stated relationship classification rules."@x-gmeow-english ;
    skos:scopeNote "The relation is optional and nonfunctional. Missing outcome data is not undecided, and a reported outcome does not itself identify a ring."@x-gmeow-english ;
    skos:example "A reading explicitly reports contactRingUndecided and states no relationship ring."@x-gmeow-english ;
    gmeow:useWhen "Use when the source reading actually reports whether the holder’s stated rules decide a ring."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid filling absence with undecided, guessing a ring, or treating the outcome as evidence that the ontology ran the holder’s rules."@x-gmeow-english ;
    gmeow:howToUse "Attach the supplied value to the ContactReading and attribute the exact statement. Keep any independently supplied ring evidence under its own actual contract."@x-gmeow-english ;
    logic:domain gmeow:ContactReading ;
    logic:range gmeow:ContactRingOutcome .

gmeow:contactRingStated
    a gmeow:ContactRingOutcome ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "relationship ring stated"@x-gmeow-english ;
    skos:definition "The reading reports that the holder’s stated classification rules decide a relationship ring for the being."@x-gmeow-english ;
    skos:scopeNote "This value reports the decision outcome, not the ring’s identity, universal correctness or an executed rule calculation."@x-gmeow-english ;
    skos:example "The source reading reports a stated ring decision under the holder’s rules and retains its actual evidence separately."@x-gmeow-english ;
    gmeow:useWhen "Use when the reading explicitly reports a ring decided by the holder’s stated rules."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a ring label, rank, membership or rule set from this outcome alone."@x-gmeow-english ;
    gmeow:howToUse "Reference this value through contactRingOutcome and preserve the source’s actual decision context."@x-gmeow-english .

gmeow:contactRingUndecided
    a gmeow:ContactRingOutcome ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "relationship ring undecided"@x-gmeow-english ;
    skos:definition "The holder’s stated classification rules decide no relationship ring for the being in this reading; the reading states none and guesses none."@x-gmeow-english ;
    skos:scopeNote "Undecided is an explicit reported outcome, not missing data, a guessed ring, a negative relationship or failure of every other contact field."@x-gmeow-english ;
    skos:example "A reading retains the supplied name and correspondent kind but reports that the stated rules decide no ring."@x-gmeow-english ;
    gmeow:useWhen "Use only when the source reading explicitly reports that the holder’s stated rules decide no ring."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring this value from absent rules or outcome data, naming a fallback ring, or turning uncertainty into an asserted relationship."@x-gmeow-english ;
    gmeow:howToUse "Reference this value through contactRingOutcome, retain the actual decision context and leave the relationship ring unstated."@x-gmeow-english .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/contactName" ; logic:closureValue logic:ClosedWorldClosure ] .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/contactKind" ; logic:closureValue logic:ClosedWorldClosure ] .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/contactRingOutcome" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:habitPresenceCount
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported presence count"@x-gmeow-english ;
    skos:definition "The source-reported number of situations in this HabitFigure’s selected population in which the holder was in the designated activity, whoever chose it, retained as a math:Quantity."@x-gmeow-english ;
    skos:scopeNote "At most one Quantity fills this optional role. Situations are counted under the source’s declared grouping; habitMember Activity occurrences do not define the count or its denominator."@x-gmeow-english ;
    skos:example "A reading retains a supplied count of situations where the holder was in an activity that someone else had chosen."@x-gmeow-english ;
    gmeow:useWhen "Use for an actual reported count of situations where the holder was in the designated activity, independently of who chose it."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting chosen acts, Activity membership or an invented missing-value zero, or inferring preference, a denominator equality or an inequality between counts."@x-gmeow-english ;
    gmeow:howToUse "Link the actual Quantity and retain the original xsd:nonNegativeInteger on math:quantityValue with math:dimensionless and one complete actual counting frame. Preserve this reading’s holder, activity designation, DayPart, TemporalFrame, input scope and declared situation grouping as the count’s interpretation context."@x-gmeow-english ;
    logic:domain gmeow:HabitFigure ;
    logic:range math:Quantity .

gmeow:habitOfferedCount
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported offered count"@x-gmeow-english ;
    skos:definition "The source-reported number of situations in this HabitFigure’s selected population in which the guidance in force offered the designated activity to the holder, retained as a math:Quantity."@x-gmeow-english ;
    skos:scopeNote "At most one Quantity fills this optional role. The source’s situation grouping and guidance in force determine its interpretation; an offered activity need not have been chosen or performed."@x-gmeow-english ;
    skos:example "A reading retains a supplied count of situations where the guidance offered an activity, including situations where the holder did something else."@x-gmeow-english ;
    gmeow:useWhen "Use for an actual reported count of situations where the guidance in force offered the designated activity."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an offer from a chosen or performed act, treating missing guidance evidence as zero, or inventing a denominator relationship to other counts."@x-gmeow-english ;
    gmeow:howToUse "Link the actual Quantity with its original xsd:nonNegativeInteger, dimensionless dimension and one complete actual counting frame. Retain the holder, activity designation, DayPart, TemporalFrame, input scope, situation grouping and actual guidance in force; the temporal frame alone does not supply this counting interpretation."@x-gmeow-english ;
    logic:domain gmeow:HabitFigure ;
    logic:range math:Quantity .

gmeow:HabitCountValueConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Habit count value constraint"@x-gmeow-english ;
    skos:definition "Each Quantity supplied through habitPresenceCount or habitOfferedCount on a HabitFigure has a valid xsd:nonNegativeInteger magnitude, one numeric value, only the dimensionless dimension and exactly one typed ReferenceFrame."@x-gmeow-english ;
    skos:scopeNote "Neither count role is required. Equivalent retained lexical aliases may coexist under numeric value equality. Existing frame obligations apply; source truth, population, grouping and counting interpretation remain evidence obligations."@x-gmeow-english ;
    skos:example "A HabitFigure may omit both roles; when a presence count is supplied, its actual Quantity must satisfy the same magnitude, dimension and frame obligations as an offered count."@x-gmeow-english ;
    gmeow:useWhen "Use to validate actual supplied presence and offered count quantities without requiring either role."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid manufacturing a count, zero, dimension or frame, imposing count inequalities, or using habitMember size as a hidden denominator."@x-gmeow-english ;
    gmeow:howToUse "Apply the outer HabitFigure guard and each independent positive count guard, preserve original literals and validate both roles with the same canonical obligations. Retain actual source evidence for their distinct situation-counting meanings."@x-gmeow-english ;
    logic:formalizes gmeow:HabitFigure , gmeow:habitPresenceCount , gmeow:habitOfferedCount ;
    logic:message "Each Quantity supplied through habitPresenceCount or habitOfferedCount on a HabitFigure has a valid xsd:nonNegativeInteger magnitude, one numeric value, only the dimensionless dimension and exactly one typed ReferenceFrame."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "report" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termIri gmeow:HabitFigure ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceMagnitudeQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:habitPresenceCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "presenceMagnitudeQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceMagnitude" ] ;
        logic:exists [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceMagnitudeQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceMagnitude" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceTypedQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceTypedValue" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:habitPresenceCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "presenceTypedQuantity" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceTypedQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceTypedValue" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:termSameComponent ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceTypedValue" ], [ logic:termIndex 1 ; logic:termIri logic:componentDatatype ], [ logic:termIndex 2 ; logic:termIri xsd:nonNegativeInteger ], [ logic:termIndex 3 ; logic:termIri logic:componentWhole ] ],
                [ a logic:Formula ; logic:relation logic:termIsFiniteNumeric ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceTypedValue" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceFirstValue" ], [ logic:termIndex 2 ; logic:termVariable "presenceSecondValue" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:habitPresenceCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "presenceEqualQuantity" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceFirstValue" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceSecondValue" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceFirstValue" ], [ logic:termIndex 1 ; logic:termVariable "presenceSecondValue" ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceDimensionQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:habitPresenceCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "presenceDimensionQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceDimension" ] ;
        logic:exists [ a logic:Formula ; logic:relation math:hasDimension ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceDimension" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceOnlyDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceOnlyDimension" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:habitPresenceCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "presenceOnlyDimensionQuantity" ] ],
                [ a logic:Formula ; logic:relation math:hasDimension ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceOnlyDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceOnlyDimension" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceOnlyDimension" ], [ logic:termIndex 1 ; logic:termIri math:dimensionless ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceFrameQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:habitPresenceCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "presenceFrameQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceFrame" ] ;
        logic:exists [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceFrame" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceTypedFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceTypedFrame" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:habitPresenceCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "presenceTypedFrameQuantity" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceTypedFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceTypedFrame" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceTypedFrame" ], [ logic:termIndex 1 ; logic:termIri gmeow:ReferenceFrame ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presenceUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceFirstFrame" ], [ logic:termIndex 2 ; logic:termVariable "presenceSecondFrame" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:habitPresenceCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "presenceUniqueFrameQuantity" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceFirstFrame" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "presenceSecondFrame" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "presenceFirstFrame" ], [ logic:termIndex 1 ; logic:termVariable "presenceSecondFrame" ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredMagnitudeQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:habitOfferedCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "offeredMagnitudeQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredMagnitude" ] ;
        logic:exists [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredMagnitudeQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredMagnitude" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredTypedQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredTypedValue" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:habitOfferedCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "offeredTypedQuantity" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredTypedQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredTypedValue" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:termSameComponent ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredTypedValue" ], [ logic:termIndex 1 ; logic:termIri logic:componentDatatype ], [ logic:termIndex 2 ; logic:termIri xsd:nonNegativeInteger ], [ logic:termIndex 3 ; logic:termIri logic:componentWhole ] ],
                [ a logic:Formula ; logic:relation logic:termIsFiniteNumeric ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredTypedValue" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredFirstValue" ], [ logic:termIndex 2 ; logic:termVariable "offeredSecondValue" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:habitOfferedCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "offeredEqualQuantity" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredFirstValue" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredSecondValue" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredFirstValue" ], [ logic:termIndex 1 ; logic:termVariable "offeredSecondValue" ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredDimensionQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:habitOfferedCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "offeredDimensionQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredDimension" ] ;
        logic:exists [ a logic:Formula ; logic:relation math:hasDimension ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredDimension" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredOnlyDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredOnlyDimension" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:habitOfferedCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "offeredOnlyDimensionQuantity" ] ],
                [ a logic:Formula ; logic:relation math:hasDimension ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredOnlyDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredOnlyDimension" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredOnlyDimension" ], [ logic:termIndex 1 ; logic:termIri math:dimensionless ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredFrameQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:habitOfferedCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "offeredFrameQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredFrame" ] ;
        logic:exists [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredFrame" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredTypedFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredTypedFrame" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:habitOfferedCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "offeredTypedFrameQuantity" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredTypedFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredTypedFrame" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredTypedFrame" ], [ logic:termIndex 1 ; logic:termIri gmeow:ReferenceFrame ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "offeredUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredFirstFrame" ], [ logic:termIndex 2 ; logic:termVariable "offeredSecondFrame" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:habitOfferedCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "offeredUniqueFrameQuantity" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredFirstFrame" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "offeredSecondFrame" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "offeredFirstFrame" ], [ logic:termIndex 1 ; logic:termVariable "offeredSecondFrame" ] ] ] ] ] ] ] .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/habitPresenceCount" ; logic:closureValue logic:ClosedWorldClosure ] .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/habitOfferedCount" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:HabitFigure logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:habitPresenceCount ; logic:allValuesFrom math:Quantity ],
    [ a logic:Restriction ; logic:onProperty gmeow:habitPresenceCount ; logic:maxQualifiedCardinality 1 ; logic:onClass math:Quantity ],
    [ a logic:Restriction ; logic:onProperty gmeow:habitOfferedCount ; logic:allValuesFrom math:Quantity ],
    [ a logic:Restriction ; logic:onProperty gmeow:habitOfferedCount ; logic:maxQualifiedCardinality 1 ; logic:onClass math:Quantity ] .

gmeow:HighFrictionCorrection
    a logic:Class , logic:SubKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "High-friction correction reading"@x-gmeow-english ;
    skos:definition "A named teller’s source-derived Refinement that an actual earlier unsuccessful ToolCall was followed in one episode by a distinct retry of the same tool and reported argument interpretation."@x-gmeow-english ;
    skos:scopeNote "observedFeature is the earlier ToolCall; frictionCorrection is the later one. Actual receipts, positive unsuccessful-outcome and order evidence, scope, vantage and the selected immutable rule remain required. The reading is not the agent’s claim or a truth, equality, success or execution certificate."@x-gmeow-english ;
    skos:example "A teller retains two actual attempts and their receipts as its retry reading without asserting that the correction succeeded."@x-gmeow-english ;
    gmeow:useWhen "Use for an actual attributed reading of a later retry after positive source evidence that an earlier attempt did not succeed."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing events, treating missing success as failure, equating tool labels or opaque payloads, or replacing source receipts with episode or call events in the input roster."@x-gmeow-english ;
    gmeow:howToUse "Bind the actual earlier feature, later correction, episode, tool, retained argument evidence, readingScope, vantage, refinementOutcome and frictionRule. Retain the actual receipt fields supporting the unsuccessful outcome and reported order; validate structural consistency without claiming to execute the reader’s interpretation."@x-gmeow-english ;
    logic:subClassOf gmeow:Refinement .

gmeow:frictionEpisode
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "correction reading episode"@x-gmeow-english ;
    skos:definition "The actual episode Activity within which this reading places both its earlier attempt and later correction attempt."@x-gmeow-english ;
    skos:scopeNote "Exactly one episode is required per reading. It is surrounding context, not the observedFeature, a receipt artifact or a newly invented Episode class."@x-gmeow-english ;
    skos:example "Both retained ToolCalls belong to the same actual episode, directly or through a source-identified round."@x-gmeow-english ;
    gmeow:useWhen "Use for the actual episode occurrence selected by the teller."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid targeting a transition report, a receipt, a label or a guessed episode node."@x-gmeow-english ;
    gmeow:howToUse "Link one actual Activity and retain the source-supported containment of each attempt; keep the earlier ToolCall as observedFeature."@x-gmeow-english ;
    logic:domain gmeow:HighFrictionCorrection ;
    logic:range gmeow:Activity .

gmeow:frictionTool
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "correction reading tool"@x-gmeow-english ;
    skos:definition "The actual SoftwareAgent tool identity shared by the two ToolCalls selected in this correction reading."@x-gmeow-english ;
    skos:scopeNote "Exactly one tool is required per reading. The role does not specialize usedTool and does not make the reading a ToolCall; matching names do not establish identity."@x-gmeow-english ;
    skos:example "The source identifies the same actual tool agent on both attempts and on the reading."@x-gmeow-english ;
    gmeow:useWhen "Use when the actual tool identity is retained, rather than only its label."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid resolving tools from equal spellings or assigning the teller as the called tool."@x-gmeow-english ;
    gmeow:howToUse "Link the actual SoftwareAgent and check agreement with each selected call’s actual usedTool value."@x-gmeow-english ;
    logic:domain gmeow:HighFrictionCorrection ;
    logic:range gmeow:SoftwareAgent .

gmeow:frictionArguments
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "correction reading arguments"@x-gmeow-english ;
    skos:definition "The retained StructuredValue argument payload occurrence the teller uses as its reported grouping basis for the earlier attempt."@x-gmeow-english ;
    skos:scopeNote "Exactly one evidence occurrence is required. It retains an actual opaque literal or structured representation; it is not an independently computed semantic signature or proof that both calls’ arguments are equivalent."@x-gmeow-english ;
    skos:example "A scalar StructuredValue keeps the earlier call’s original opaque literal while the later call retains its own original payload."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the actual argument evidence selected by the teller’s declared interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid parsing, normalizing, hashing or equating payloads without the actual declared method, or inventing null, an empty map or a default representation."@x-gmeow-english ;
    gmeow:howToUse "Reuse an actual toolArgumentsStructured occurrence or retain the exact opaque toolArguments literal through structuredTerm on a source-identified scalar occurrence. Preserve both calls’ original evidence and the selected rule; no semantic comparator is executed here."@x-gmeow-english ;
    logic:domain gmeow:HighFrictionCorrection ;
    logic:range gmeow:StructuredValue .

gmeow:frictionCorrection
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "later correction attempt"@x-gmeow-english ;
    skos:definition "The distinct actual later ToolCall that this reading reports as another attempt of the earlier feature’s tool and argument act."@x-gmeow-english ;
    skos:scopeNote "Exactly one later attempt is required. The relation records the teller’s retry and order interpretation; it neither asserts later success nor adds an Allen BEFORE gap relation."@x-gmeow-english ;
    skos:example "The source reading selects a later retry without reporting its eventual outcome."@x-gmeow-english ;
    gmeow:useWhen "Use for the actual later attempt selected after positive evidence of the earlier unsuccessful attempt."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a correction text, a rule artifact, the earlier call itself, or a fabricated successful event."@x-gmeow-english ;
    gmeow:howToUse "Link the distinct actual ToolCall and retain its source receipts, argument evidence, episode containment and reported order separately from the reading’s clock."@x-gmeow-english ;
    logic:domain gmeow:HighFrictionCorrection ;
    logic:range gmeow:ToolCall .

gmeow:frictionAt
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "attempt temporal placement"@x-gmeow-english ;
    skos:definition "The source-supplied temporal placement of a ToolCall attempt, specializing eventTime at the source’s actual precision."@x-gmeow-english ;
    skos:scopeNote "This optional, nonfunctional attempt property admits xsd:dateTime, xsd:date, xsd:gYearMonth or xsd:gYear. It is not the reading or recording clock and introduces no new timezone or frame default beyond the existing Events contract."@x-gmeow-english ;
    skos:example "An attempt retains the source’s day placement without padding it to midnight."@x-gmeow-english ;
    gmeow:useWhen "Use when the source supplies an actual attempt time or coarse placement."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid copying the teller’s clock, inventing missing precision or inferring order from incomparable placements."@x-gmeow-english ;
    gmeow:howToUse "Attach the original literal to the actual ToolCall and preserve datatype, lexical form, timezone and the actual eventTemporalFrame contract. Keep the reading’s own time separate; no chronology comparator is executed."@x-gmeow-english ;
    logic:domain gmeow:ToolCall ;
    logic:subPropertyOf gmeow:eventTime ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] .

gmeow:frictionWithin
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "attempt containment"@x-gmeow-english ;
    skos:definition "The actual round or episode Activity containing a ToolCall attempt, specializing subEventOf."@x-gmeow-english ;
    skos:scopeNote "The role is optional on ToolCall generally and has no single-container maximum. Both selected attempts require actual containment in the reading’s episode, directly or through an actual trace round."@x-gmeow-english ;
    skos:example "A source-identified round contains the attempt and is itself part of the selected episode."@x-gmeow-english ;
    gmeow:useWhen "Use for actual source-supported event containment of an attempt."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a receipt’s storage location, a matching label, mere temporal co-location or a guessed round or episode."@x-gmeow-english ;
    gmeow:howToUse "Link each selected ToolCall to its actual episode or an actual eventTypeTraceRound Activity belonging to that episode. Preserve the source’s part-whole evidence and do not infer scheduler execution."@x-gmeow-english ;
    logic:domain gmeow:ToolCall ;
    logic:subPropertyOf gmeow:subEventOf ;
    logic:range gmeow:Activity .

gmeow:frictionAttemptCount
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported correction attempt count"@x-gmeow-english ;
    skos:definition "The source-reported count of distinct attempts the teller groups with the earlier attempt in this episode and input scope under its selected rule."@x-gmeow-english ;
    skos:scopeNote "This optional role has at most one Quantity. A supplied count is at least two because its declared population includes the required witnesses; it is an annotation, never confidence or a graph-node count."@x-gmeow-english ;
    skos:example "A reading retains its supplied count and declared population without recomputing it from receipt membership."@x-gmeow-english ;
    gmeow:useWhen "Use only for an actual reported count over this reading’s declared attempt population."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a missing value, zero, population, confidence or equality with the number of receipts or ToolCall nodes."@x-gmeow-english ;
    gmeow:howToUse "Link an actual math:Quantity retaining original xsd:nonNegativeInteger magnitudes, one numeric value, math:dimensionless and one complete actual counting frame. Preserve role, episode, witnesses, tool, argument grouping, scope, rule and outcome interpretation; enforce the witness minimum of two without synthesizing it."@x-gmeow-english ;
    logic:domain gmeow:HighFrictionCorrection ;
    logic:range math:Quantity .

gmeow:frictionUnsucceededCount
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported unsuccessful correction attempt count"@x-gmeow-english ;
    skos:definition "The source-reported count of unsuccessful attempts in this reading’s same declared attempt population under the selected outcome interpretation."@x-gmeow-english ;
    skos:scopeNote "This optional role has at most one Quantity. A supplied count is at least one because its declared population includes the required witnesses; it is an annotation, never confidence or a graph-node count."@x-gmeow-english ;
    skos:example "A reading retains its supplied count and declared population without recomputing it from receipt membership."@x-gmeow-english ;
    gmeow:useWhen "Use only for an actual reported count over this reading’s declared attempt population."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a missing value, zero, population, confidence or equality with the number of receipts or ToolCall nodes."@x-gmeow-english ;
    gmeow:howToUse "Link an actual math:Quantity retaining original xsd:nonNegativeInteger magnitudes, one numeric value, math:dimensionless and one complete actual counting frame. Preserve role, episode, witnesses, tool, argument grouping, scope, rule and outcome interpretation; enforce the witness minimum of one without synthesizing it."@x-gmeow-english ;
    logic:domain gmeow:HighFrictionCorrection ;
    logic:range math:Quantity .

gmeow:frictionRule
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "correction reading rule release"@x-gmeow-english ;
    skos:definition "The actual immutable ReadingRule parameter release selected for this correction reading, retained as a derivation input."@x-gmeow-english ;
    skos:scopeNote "Exactly one release is required per reading. It carries all four supplied friction parameters and the existing version/provenance metadata, independently of the process vantage and other derivation inputs."@x-gmeow-english ;
    skos:example "A reading explicitly selects the actual reviewed release rather than guessing it from field spellings."@x-gmeow-english ;
    gmeow:useWhen "Use to identify the actual parameter release used by this reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a mutable rule, a bare version token, an executable logic:Rule substitution or mixing parameters from unrelated releases."@x-gmeow-english ;
    gmeow:howToUse "Link the actual ReadingRule with its required lineage, versionLabel, contentDigest and attribution and all four token parameters. The wasDerivedFrom relation follows by subproperty; preserve actual receipt inputs separately and do not infer execution."@x-gmeow-english ;
    logic:domain gmeow:HighFrictionCorrection ;
    logic:subPropertyOf gmeow:wasDerivedFrom ;
    logic:range gmeow:ReadingRule .

gmeow:HighFrictionCorrectionBindingsConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "High-friction correction bindings constraint"@x-gmeow-english ;
    skos:definition "A HighFrictionCorrection retains distinct earlier and later calls, consistent actual tool identities, a nonempty roster of actual receipt inputs and actual episode containment, with each call’s supplied argument evidence."@x-gmeow-english ;
    skos:scopeNote "The law checks retained references and intrinsic consistency. Positive unsuccessful-outcome and reported-order evidence remains mandatory source content under the selected rule; no receipt lookup, semantic argument comparison, chronology engine or truth certificate is claimed."@x-gmeow-english ;
    skos:example "A rule release is retained separately from a nonempty receipt roster; a missing outcome does not become a failure."@x-gmeow-english ;
    gmeow:useWhen "Use to validate the intrinsic bindings of an actual attributed correction reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a valid graph as proof that the reader ran, the source is true, the arguments are semantically equal or the later attempt succeeded."@x-gmeow-english ;
    gmeow:howToUse "Apply each independent positive guard to actual supplied calls, receipts, scope and containers. Retain original fields and source attribution for the claimed unsuccessful outcome and later retry; diagnose absent required evidence without fabricating it."@x-gmeow-english ;
    logic:formalizes gmeow:HighFrictionCorrection, gmeow:frictionCorrection, gmeow:frictionTool, gmeow:frictionArguments, gmeow:frictionWithin, gmeow:readingScope ;
    logic:message "A HighFrictionCorrection retains distinct earlier and later calls, consistent actual tool identities, a nonempty roster of actual receipt inputs and actual episode containment, with each call’s supplied argument evidence."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "bindingReport" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "bindingReport" ], [ logic:termIndex 1 ; logic:termIri gmeow:HighFrictionCorrection ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "distinctEarlier" ], [ logic:termIndex 1 ; logic:termVariable "distinctLater" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:observedFeature ; logic:argument [ logic:termIndex 0 ; logic:termVariable "bindingReport" ], [ logic:termIndex 1 ; logic:termVariable "distinctEarlier" ] ],
