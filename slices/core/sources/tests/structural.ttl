#
# Declarative structural assertions for the sources slice (Tier-B
# closeout). The slice already carries competency.ttl; this adds its small but
# real TBox shape (content-addressing vs audit-location vs mtime). No migratable
# pytest existed. Each runs as a SPARQL ASK over the module graph
# (gmeow:scopeModule).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/sources/tests/> .

# --- 1. The three source/carrier properties (MUST hold) ----------------------
ex:saSourcePropertyShapes a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:contentDigest a owl:DatatypeProperty ; rdfs:range ?digestRange .
    ?digestRange owl:unionOf ( gmeow:blake3_256Digest gmeow:sha256Digest gmeow:md5Digest ) .
    gmeow:sourceLocation  a owl:DatatypeProperty ; rdfs:domain gmeow:CreativeWork ; rdfs:range rdfs:Literal .
    gmeow:sourceModifiedAt a owl:DatatypeProperty ; rdfs:domain gmeow:CreativeWork ; rdfs:range xsd:dateTime .
}""" ;
    gmeow:saRationale "The carrier-metadata properties MUST hold their shapes: gmeow:contentDigest (by-content identity, a literal hash), gmeow:sourceLocation (audit-only path/URL on a CreativeWork), and gmeow:sourceModifiedAt (a CreativeWork mtime, terminus-ante-quem on recording)." .

# --- 2. contentDigest is domain-free (MUST-NOT hold) -------------------------
ex:saContentDigestDomainFree a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:contentDigest rdfs:domain ?d . }""" ;
    gmeow:saRationale "gmeow:contentDigest MUST NOT declare an rdfs:domain: it is deliberately domain-free, applying to any content-addressable artifact (creative work, source file, commit, distribution) — by-content identity is universal, not tied to one class." .

# --- 3. The source properties are NOT functional (MUST-NOT hold) -------------
ex:saSourcePropertiesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    VALUES ?p { gmeow:contentDigest gmeow:sourceLocation gmeow:sourceModifiedAt }
    ?rec logic:characterizes ?p ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "None of the three carrier properties MUST be functional: an artifact may carry digests under several algorithms, and copies/syncs of identical bytes may report different locations and mtimes — all must coexist rather than force an inconsistency. VALUES ranges over the closed set of three properties the slice declares." .

# --- Source snapshot (Principles 2, 4 and 7) ----------------------------------
# A snapshot is a copy (gmeow:Item), not a new work, expression or manifestation,
# and it reuses the existing digest and live-address properties.
ex:saSourceSnapshotShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SourceSnapshot (rdfs:subClassOf|logic:subClassOf) gmeow:Item .
    gmeow:retrievedAt (rdfs:domain|logic:domain) gmeow:SourceSnapshot .
    gmeow:immutableAddress (rdfs:domain|logic:domain) gmeow:SourceSnapshot .
}""" ;
    gmeow:saRationale "A source snapshot is placed in the document layering as one particular copy and carries its own retrieval instant and immutable address; the digest and the live address stay on gmeow:contentDigest and gmeow:sourceLocation." .

ex:saSourceSnapshotNotWork a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?tier { gmeow:Work gmeow:Expression gmeow:Manifestation }
    gmeow:SourceSnapshot (rdfs:subClassOf|logic:subClassOf) ?tier .
}""" ;
    gmeow:saRationale "A snapshot MUST NOT be declared a Work, Expression or Manifestation directly: it is a copy of a manifestation, never a new work." .

ex:saSourceSnapshotRequired a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    [] a logic:ClosureEntry ; logic:onClass gmeow:SourceSnapshot ; logic:closureKey "https://blackcatinformatics.ca/gmeow/contentDigest" .
    [] a logic:ClosureEntry ; logic:onClass gmeow:SourceSnapshot ; logic:closureKey "https://blackcatinformatics.ca/gmeow/retrievedAt" .
    [] a logic:ClosureEntry ; logic:onClass gmeow:SourceSnapshot ; logic:closureKey "https://blackcatinformatics.ca/gmeow/sourceLocation" .
    [] a logic:ClosureEntry ; logic:onClass gmeow:SourceSnapshot ; logic:closureKey "https://blackcatinformatics.ca/gmeow/immutableAddress" .
}""" ;
    gmeow:saRationale "A failed retrieval is not a snapshot: the digest, retrieval instant, retrieval address and immutable address are each a closed-world requirement on gmeow:SourceSnapshot." .
