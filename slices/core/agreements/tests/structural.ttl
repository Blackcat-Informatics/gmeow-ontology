#
# Declarative structural assertions for the agreements slice. Each assertion runs
# as a SPARQL ASK over agreements/module.ttl under the native Rust slicetest
# harness.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/agreements/tests/> .

ex:saAgreementIsRelatorKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Agreement a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:Agreement MUST be an owl:Class typed logic:Kind and a subclass of logic:Relator -- agreements are reified commitment-grounding relationships. Mirrors the agreement side of the former employment cross-slice grounding guard." .

ex:saFoundedOnLinksRelatorToAgreement a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:foundedOn a owl:ObjectProperty ;
        rdfs:domain logic:Relator ;
        rdfs:range gmeow:Agreement .
}""" ;
    gmeow:saRationale "gmeow:foundedOn MUST link any logic:Relator to the gmeow:Agreement that grounds it. Replaces the stale pytest check that still expected gufo:Relator." .
