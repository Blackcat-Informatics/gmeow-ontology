@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo:   <http://www.opengis.net/ont/geosparql#> .

# Projection mappings: GMEOW → pure GeoSPARQL. WKT datatype retag + lat/long→POINT
# combine + Feature/sfWithin. Compiled to projections/geosparql.edoal.ttl +
# queries/projections/geosparql.rq by `gmeow compile-mappings`.

gmeow:mapGeoFeature a gmeow:ProjectionMapping ;
    rdfs:label "Place → geo:Feature"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom ( [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ] ) ] ;
    gmeow:hasBinding [ gmeow:profile "geosparql" ; gmeow:toClass geo:Feature ; gmeow:relation "=" ] .

gmeow:mapGeoWktRetag a gmeow:ProjectionMapping ;
    rdfs:label "asWKT literal → geo:asWKT retagged geo:wktLiteral"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:hasGeometry ; gmeow:objectVar "g" ]
            [ gmeow:subjectVar "g" ; gmeow:predicate gmeow:asWKT ; gmeow:objectVar "wkt" ] ) ;
        gmeow:bind [ gmeow:bindVar "wktTagged" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opStrDatatype ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "wkt" ] ) ]
                geo:wktLiteral ) ] ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "anyLvl" ] ;
        gmeow:edoalSource gmeow:asWKT ; gmeow:edoalSourceKind "relation" ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "=" ;
        gmeow:edoalTarget geo:asWKT ; gmeow:edoalTargetKind "property" ;
        gmeow:transform gmeow:fnRetagWkt ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred geo:hasGeometry ; gmeow:tObj "g" ]
            [ gmeow:tSubj "g" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Geometry ]
            [ gmeow:tSubj "g" ; gmeow:tPred geo:asWKT ; gmeow:tObj "wktTagged" ] ) ] .

gmeow:mapGeoWktCoarsened a gmeow:ProjectionMapping ;
    rdfs:label "coarsenTo → enclosing-region WKT geometry (privacy generalization)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "lvl" ]
            [ gmeow:subjectVar "place" ; gmeow:path [ a gmeow:OneOrMorePath ; gmeow:pathStep gmeow:containedInPlace ] ; gmeow:objectVar "coarse" ]
            [ gmeow:subjectVar "coarse" ; gmeow:predicate gmeow:hasGranularity ; gmeow:objectVar "lvl" ]
            [ gmeow:subjectVar "coarse" ; gmeow:predicate gmeow:hasGeometry ; gmeow:objectVar "sourceGeom" ]
            [ gmeow:subjectVar "sourceGeom" ; gmeow:predicate gmeow:asWKT ; gmeow:objectVar "wkt" ] ) ;
        gmeow:mint [ gmeow:bindVar "coarseGeom" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "place" ] ) ]
                    "-geom-coarsened-wkt" ) ] ) ] ] ;
        gmeow:bind [ gmeow:bindVar "wktTagged" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opStrDatatype ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "wkt" ] ) ]
                geo:wktLiteral ) ] ] ;
        gmeow:edoalSource gmeow:coarsenTo ; gmeow:edoalSourceKind "relation" ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "<=" ;
        gmeow:edoalTarget geo:Geometry ; gmeow:edoalTargetKind "class" ;
        gmeow:transform gmeow:fnCoarsenToGranularity ;
        gmeow:lossyDrop "precise WKT geometry coarsened to the enclosing region at gmeow:coarsenTo level (privacy generalization, P10)" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred geo:hasGeometry ; gmeow:tObj "coarseGeom" ]
            [ gmeow:tSubj "coarseGeom" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Geometry ]
            [ gmeow:tSubj "coarseGeom" ; gmeow:tPred geo:asWKT ; gmeow:tObj "wktTagged" ] ) ] .

gmeow:mapGeoPoint a gmeow:ProjectionMapping ;
    rdfs:label "latitude + longitude → geo:Geometry with WKT POINT"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:hasCoordinates ; gmeow:objectVar "c" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:latitude ; gmeow:objectVar "lat" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:longitude ; gmeow:objectVar "lon" ] ) ;
        gmeow:mint [ gmeow:bindVar "ptGeom" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "place" ] ) ]
                    "-geom" ) ] ) ] ] ;
        gmeow:bind [ gmeow:bindVar "pointWkt" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opStrDatatype ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    "POINT("
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "lon" ] ) ]
                    " "
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "lat" ] ) ]
                    ")" ) ]
                geo:wktLiteral ) ] ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "anyLvl" ] ;
        gmeow:edoalSource gmeow:GeoCoordinates ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "<=" ;
        gmeow:edoalTarget geo:Geometry ; gmeow:edoalTargetKind "class" ;
        gmeow:transform gmeow:fnLatLongToWktPoint ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred geo:hasGeometry ; gmeow:tObj "ptGeom" ]
            [ gmeow:tSubj "ptGeom" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Geometry ]
            [ gmeow:tSubj "ptGeom" ; gmeow:tPred geo:asWKT ; gmeow:tObj "pointWkt" ] ) ] .

# Disclosure control by generalization (#72, CONSTITUTION P10): when a place carries
# gmeow:coarsenTo a target level, emit the coordinates of the enclosing ancestor at
# that level (reached by gmeow:containedInPlace+) INSTEAD of the precise point — the
# complementary branch to mapGeoPoint (which is suppressed under the same trigger).
# A coarser region rather than exact coordinates, never deletion.
gmeow:mapGeoPointCoarsened a gmeow:ProjectionMapping ;
    rdfs:label "coarsenTo → enclosing-region WKT POINT (privacy generalization)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "lvl" ]
            [ gmeow:subjectVar "place" ; gmeow:path [ a gmeow:OneOrMorePath ; gmeow:pathStep gmeow:containedInPlace ] ; gmeow:objectVar "coarse" ]
            [ gmeow:subjectVar "coarse" ; gmeow:predicate gmeow:hasGranularity ; gmeow:objectVar "lvl" ]
            [ gmeow:subjectVar "coarse" ; gmeow:predicate gmeow:hasCoordinates ; gmeow:objectVar "c" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:latitude ; gmeow:objectVar "lat" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:longitude ; gmeow:objectVar "lon" ] ) ;
        gmeow:mint [ gmeow:bindVar "ptGeom" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "place" ] ) ]
                    "-geom-coarsened" ) ] ) ] ] ;
        gmeow:bind [ gmeow:bindVar "pointWkt" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opStrDatatype ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    "POINT("
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "lon" ] ) ]
                    " "
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "lat" ] ) ]
                    ")" ) ]
                geo:wktLiteral ) ] ] ;
        gmeow:edoalSource gmeow:coarsenTo ; gmeow:edoalSourceKind "relation" ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "<=" ;
        gmeow:edoalTarget geo:Geometry ; gmeow:edoalTargetKind "class" ;
        gmeow:transform gmeow:fnCoarsenToGranularity ;
        gmeow:lossyDrop "precise coordinates coarsened to the enclosing region at gmeow:coarsenTo level (privacy generalization, P10)" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred geo:hasGeometry ; gmeow:tObj "ptGeom" ]
            [ gmeow:tSubj "ptGeom" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Geometry ]
            [ gmeow:tSubj "ptGeom" ; gmeow:tPred geo:asWKT ; gmeow:tObj "pointWkt" ] ) ] .

gmeow:mapGeoPosePoint a gmeow:ProjectionMapping ;
    rdfs:label "pose position (lat/long) → geo:Geometry with WKT POINT"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "entity" ;
        gmeow:atom (
            [ gmeow:subjectVar "entity" ; gmeow:predicate gmeow:hasPose ; gmeow:objectVar "pose" ]
            [ gmeow:subjectVar "pose" ; gmeow:predicate gmeow:hasPosePosition ; gmeow:objectVar "c" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:latitude ; gmeow:objectVar "lat" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:longitude ; gmeow:objectVar "lon" ] ) ;
        gmeow:mint [ gmeow:bindVar "ptGeom" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "entity" ] ) ]
                    "-pose-geom" ) ] ) ] ] ;
        gmeow:bind [ gmeow:bindVar "pointWkt" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opStrDatatype ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    "POINT("
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "lon" ] ) ]
                    " "
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "lat" ] ) ]
                    ")" ) ]
                geo:wktLiteral ) ] ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "entity" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "anyLvl" ] ;
        gmeow:edoalSource gmeow:Pose ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "<=" ;
        gmeow:edoalTarget geo:Geometry ; gmeow:edoalTargetKind "class" ;
        gmeow:transform gmeow:fnPosePositionToWktPoint ;
        gmeow:lossyDrop "orientation component dropped; GeoSPARQL 1.0/1.1 has no pose model" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "entity" ; gmeow:tPred geo:hasGeometry ; gmeow:tObj "ptGeom" ]
            [ gmeow:tSubj "ptGeom" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Geometry ]
            [ gmeow:tSubj "ptGeom" ; gmeow:tPred geo:asWKT ; gmeow:tObj "pointWkt" ] ) ] .

gmeow:mapGeoWithin a gmeow:ProjectionMapping ;
    rdfs:label "containedInPlace → geo:sfWithin"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ; gmeow:value "parent" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:containedInPlace ; gmeow:objectVar "parent" ] ) ] ;
    gmeow:hasBinding [ gmeow:profile "geosparql" ; gmeow:toPredicate geo:sfWithin ; gmeow:relation "=" ] .

gmeow:mapGeoContains a gmeow:ProjectionMapping ;
    rdfs:label "containsPlace → geo:sfContains"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "parent" ; gmeow:value "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "parent" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "parent" ; gmeow:predicate gmeow:containsPlace ; gmeow:objectVar "place" ] ) ] ;
    gmeow:hasBinding [ gmeow:profile "geosparql" ; gmeow:toPredicate geo:sfContains ; gmeow:relation "=" ] .

# GeoJSON projections (#82) — mirror the WKT retag + coarsened branches.

gmeow:mapGeoJson a gmeow:ProjectionMapping ;
    rdfs:label "asGeoJSON literal → geo:asGeoJSON retagged geo:geoJSONLiteral"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:hasGeometry ; gmeow:objectVar "g" ]
            [ gmeow:subjectVar "g" ; gmeow:predicate gmeow:asGeoJSON ; gmeow:objectVar "gj" ] ) ;
        gmeow:bind [ gmeow:bindVar "gjTagged" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opStrDatatype ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "gj" ] ) ]
                geo:geoJSONLiteral ) ] ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "anyLvl" ] ;
        gmeow:edoalSource gmeow:asGeoJSON ; gmeow:edoalSourceKind "relation" ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "=" ;
        gmeow:edoalTarget geo:asGeoJSON ; gmeow:edoalTargetKind "property" ;
        gmeow:transform gmeow:fnRetagGeoJson ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred geo:hasGeometry ; gmeow:tObj "g" ]
            [ gmeow:tSubj "g" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Geometry ]
            [ gmeow:tSubj "g" ; gmeow:tPred geo:asGeoJSON ; gmeow:tObj "gjTagged" ] ) ] .

gmeow:mapGeoJsonCoarsened a gmeow:ProjectionMapping ;
    rdfs:label "coarsenTo → enclosing-region GeoJSON (privacy generalization)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "lvl" ]
            [ gmeow:subjectVar "place" ; gmeow:path [ a gmeow:OneOrMorePath ; gmeow:pathStep gmeow:containedInPlace ] ; gmeow:objectVar "coarse" ]
            [ gmeow:subjectVar "coarse" ; gmeow:predicate gmeow:hasGranularity ; gmeow:objectVar "lvl" ]
            [ gmeow:subjectVar "coarse" ; gmeow:predicate gmeow:hasGeometry ; gmeow:objectVar "sourceGeom" ]
            [ gmeow:subjectVar "sourceGeom" ; gmeow:predicate gmeow:asGeoJSON ; gmeow:objectVar "gj" ] ) ;
        gmeow:mint [ gmeow:bindVar "coarseGeom" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "place" ] ) ]
                    "-geom-coarsened-geojson" ) ] ) ] ] ;
        gmeow:bind [ gmeow:bindVar "gjTagged" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opStrDatatype ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "gj" ] ) ]
                geo:geoJSONLiteral ) ] ] ;
        gmeow:edoalSource gmeow:coarsenTo ; gmeow:edoalSourceKind "relation" ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "<=" ;
        gmeow:edoalTarget geo:Geometry ; gmeow:edoalTargetKind "class" ;
        gmeow:transform gmeow:fnCoarsenToGranularityGeoJson ;
        gmeow:lossyDrop "precise GeoJSON geometry coarsened to the enclosing region at gmeow:coarsenTo level (privacy generalization, P10)" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred geo:hasGeometry ; gmeow:tObj "coarseGeom" ]
            [ gmeow:tSubj "coarseGeom" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Geometry ]
            [ gmeow:tSubj "coarseGeom" ; gmeow:tPred geo:asGeoJSON ; gmeow:tObj "gjTagged" ] ) ] .

# Trajectory → geo:Feature (the spatial path is a feature; individual samples
# project via mapGeoPosePositionToWktPoint). Continuous LineString interpolation
# is a solver-layer concern (Principle 12).
gmeow:mapGeoTrajectory a gmeow:ProjectionMapping ;
    rdfs:label "Trajectory → geo:Feature"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "traj" ;
        gmeow:atom (
            [ gmeow:subjectVar "traj" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Trajectory ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "<=" ;
        gmeow:lossyDrop "trajectory samples (LocationStates), temporal scope, reference frame, and interpolation method are dropped in pure GeoSPARQL; only the feature identity is retained. The sample geometries project separately via mapGeoPosePositionToWktPoint." ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "traj" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Feature ] ) ] .

# Centroid projection (#101) — gmeow:hasCentroid → geo:hasCentroid
gmeow:mapGeoCentroid a gmeow:ProjectionMapping ;
    rdfs:label "hasCentroid geometry → geo:hasCentroid with WKT"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:hasCentroid ; gmeow:objectVar "g_centroid" ]
            [ gmeow:subjectVar "g_centroid" ; gmeow:predicate gmeow:asWKT ; gmeow:objectVar "wkt" ] ) ;
        gmeow:bind [ gmeow:bindVar "wktTagged_centroid" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opStrDatatype ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "wkt" ] ) ]
                geo:wktLiteral ) ] ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "anyLvl" ] ;
        gmeow:edoalSource gmeow:hasCentroid ; gmeow:edoalSourceKind "relation" ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "=" ;
        gmeow:edoalTarget geo:hasCentroid ; gmeow:edoalTargetKind "property" ;
        gmeow:transform gmeow:fnRetagWkt ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred geo:hasCentroid ; gmeow:tObj "g_centroid" ]
            [ gmeow:tSubj "g_centroid" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Geometry ]
            [ gmeow:tSubj "g_centroid" ; gmeow:tPred geo:asWKT ; gmeow:tObj "wktTagged_centroid" ] ) ] .

# --------------------------------------------------------------------------- #
# Issue #125 — CoordinateObservation projections to GeoSPARQL
# --------------------------------------------------------------------------- #
# These project the reified observation path (Place → CoordinateObservation →
# result) to GeoSPARQL, complementing the flat shortcut projections above.
# Both branches respect coarsenTo suppression and displayable false on the
# observation (Principle 10).
# --------------------------------------------------------------------------- #

# CoordinateObservation with coordinateResult (GeoCoordinates) → WKT POINT
gmeow:mapGeoCoordinateObservation a gmeow:ProjectionMapping ;
    rdfs:label "CoordinateObservation coordinateResult → geo:Geometry with WKT POINT"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:hasCoordinateObservation ; gmeow:objectVar "obs" ]
            [ gmeow:subjectVar "obs" ; gmeow:predicate gmeow:coordinateResult ; gmeow:objectVar "c" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:latitude ; gmeow:objectVar "lat" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:longitude ; gmeow:objectVar "lon" ] ) ;
        gmeow:mint [ gmeow:bindVar "ptGeom" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "obs" ] ) ]
                    "-geom" ) ] ) ] ] ;
        gmeow:bind [ gmeow:bindVar "pointWkt" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opStrDatatype ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    "POINT("
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "lon" ] ) ]
                    " "
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "lat" ] ) ]
                    ")" ) ]
                geo:wktLiteral ) ] ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "anyLvl" ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "obs" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:CoordinateObservation ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "<=" ;
        gmeow:edoalTarget geo:Geometry ; gmeow:edoalTargetKind "class" ;
        gmeow:transform gmeow:fnLatLongToWktPoint ;
        gmeow:lossyDrop "the CoordinateObservation relator (vantage, confidence, reference frame, temporal scope) is dropped; only the WKT point survives" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred geo:hasGeometry ; gmeow:tObj "ptGeom" ]
            [ gmeow:tSubj "ptGeom" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Geometry ]
            [ gmeow:tSubj "ptGeom" ; gmeow:tPred geo:asWKT ; gmeow:tObj "pointWkt" ] ) ] .

# CoordinateObservation with geometryResult (Geometry) → WKT retag
gmeow:mapGeoGeometryObservation a gmeow:ProjectionMapping ;
    rdfs:label "CoordinateObservation geometryResult → geo:hasGeometry with WKT"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:hasCoordinateObservation ; gmeow:objectVar "obs" ]
            [ gmeow:subjectVar "obs" ; gmeow:predicate gmeow:geometryResult ; gmeow:objectVar "g" ]
            [ gmeow:subjectVar "g" ; gmeow:predicate gmeow:asWKT ; gmeow:objectVar "wkt" ] ) ;
        gmeow:bind [ gmeow:bindVar "wktTagged" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opStrDatatype ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "wkt" ] ) ]
                geo:wktLiteral ) ] ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "anyLvl" ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "obs" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:CoordinateObservation ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "geosparql" ; gmeow:relation "=" ;
        gmeow:edoalTarget geo:hasGeometry ; gmeow:edoalTargetKind "property" ;
        gmeow:transform gmeow:fnRetagWkt ;
        gmeow:lossyDrop "the CoordinateObservation relator (vantage, confidence, reference frame, temporal scope) is dropped; only the WKT geometry survives" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred geo:hasGeometry ; gmeow:tObj "g" ]
            [ gmeow:tSubj "g" ; gmeow:tPred rdf:type ; gmeow:tObjValue geo:Geometry ]
            [ gmeow:tSubj "g" ; gmeow:tPred geo:asWKT ; gmeow:tObj "wktTagged" ] ) ] .
