    skos:definition "Grounding correspondence: the canonical logic:allValuesFrom term is projected to the W3C OWL allValuesFrom construct as an exact structural rename — a logic:Isomorphism under a logic:InstitutionMorphism carrying logic:ExactPreservation."@x-gmeow-english .

logic:corrHasValueGrounding
    a logic:GroundingCorrespondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "logic:hasValue to W3C OWL hasValue grounding"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
