# --- Wave B1 shape-drain: image depiction / region / scene-edge cardinality + range grounding ---
# gmeow:DepictionUsageShape — exactly one depicted subject, one image, one depiction context. The
# retired shape also carried sh:class gmeow:Entity on gmeow:depictionSubject; that closed-world
# class check is a data-soundness casualty (Tier-1 SHACL runs without inference, and a conformant
# depicted subject is typed with its specific sortal — a gmeow:Person, gmeow:Place — not the
# redundant explicit gmeow:Entity the guidance forbids), so only the exactly-one cardinality is
# closed-world here; the range stays the open-world rdfs:range on gmeow:depictionSubject.
gmeow:DepictionUsage logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:depictionImage ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:depictionContext ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:depictionSubject ; logic:minQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:depictionSubject ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .

# gmeow:ImageRegionShape — a region of exactly one MediaObject with exactly one selector.
gmeow:ImageRegion logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:regionOf ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:regionSelector ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .

# gmeow:RegionSelectorShape — exactly one selector type and exactly one literal selector value.
gmeow:RegionSelector logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:selectorType ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:selectorValue ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .

# gmeow:SceneGraphEdgeShape — exactly one subject region, object region, and relation; at most one
# confidence in [0.0, 1.0]. The bounded numeric range is validation-only (no OWL faceted-datatype
# axiom the native reasoner can decide once a literal is asserted).
gmeow:SceneGraphEdge logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:sceneSubject ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:sceneObject ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:sceneRelation ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:sceneConfidence ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] .

gmeow:SceneGraphEdgeConfidenceRangeConstraint
    a logic:ValueRangeConstraint ;
    rdfs:label "Scene graph edge confidence range constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/images> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A validation-only integrity constraint: when present, gmeow:sceneConfidence on a gmeow:SceneGraphEdge is a decimal in the closed interval [0.0, 1.0]."@x-gmeow-english ;
    logic:formalizes gmeow:SceneGraphEdgeShape ;
    logic:onClass gmeow:SceneGraphEdge ;
    logic:valuePath gmeow:sceneConfidence ;
    logic:minInclusiveBound 0.0 ;
    logic:maxInclusiveBound 1.0 ;
    logic:message "When present, gmeow:sceneConfidence must be a decimal in [0.0, 1.0]." .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects OWL FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:depictionContextFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/images> ;
    rdfs:label "depictionContext is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:depictionContext is functional: a gmeow:DepictionUsage relator records exactly one context — the single work, family, childhood, portrait, or candid setting in which the image depicts its subject. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:depictionContext ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:depictionContext ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:depictionContext names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:depictionContext, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:depictionContext and nothing else. It is not a definition of gmeow:depictionContext (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:depictionContextFunctionality logic:characterizes gmeow:depictionContext ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
