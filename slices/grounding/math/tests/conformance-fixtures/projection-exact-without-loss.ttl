@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex: <http://example.org/math/> .

# Internal consistency of the judgment; not a measured codec round-trip proof.
ex:consistentProjection a math:ProjectionRecord ;
    math:projectionSource ex:quantity ;
    math:projectionTargetName "declared quantity view" ;
    logic:preservationKind logic:ExactPreservation .
