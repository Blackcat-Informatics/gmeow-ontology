gmeow:WeightedFusionPartialSumContextLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "weighted fusion partial sum context law"@x-gmeow-english ;
    skos:definition "Every partial-total Quantity linked by an owned step has the exact frame of its owning applied score."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the selected quantitative context onto derived mathematical witnesses."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid adding reportedFusionScoreProfile merely for witness context, inferring reporting from witness use alone or treating equal values as frame equivalence."@x-gmeow-english ;
    gmeow:howToUse "Follow the application, applied score and owned step to its total, bind both frames and compare the resources."@x-gmeow-english ;
    skos:scopeNote "Explicit dimensionless dimension is local to QueryWeightedPartialSum. Its profile context follows the score and application without deriving a source-reported profile edge from witness use."@x-gmeow-english ;
    skos:example "Fictional scoped example: A fictional shared total can serve compatible steps with the same frame, but fails when one owning score has a different frame."@x-gmeow-english ;
    logic:formalizes gmeow:QueryWeightedFusionApplication ;
    logic:message "Every partial-total Quantity linked by an owned step has the exact frame of its owning applied score." ;
    logic:integrity [ a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "b57_f" ], [ logic:termIndex 2 ; logic:termVariable "b57_g" ], [ logic:termIndex 3 ; logic:termVariable "b57_q" ], [ logic:termIndex 4 ; logic:termVariable "b57_s" ], [ logic:termIndex 5 ; logic:termVariable "b57_t" ] ;
    logic:forall [ a logic:Formula ;
        logic:antecedent [ a logic:Formula ;
            logic:relation rdf:type ;
            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryWeightedFusionApplication ] ] ;
        logic:consequent [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ;
                logic:and [ a logic:Formula ;
                    logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryWeightedFusionApplication ] ],
                [ a logic:Formula ;
                    logic:relation gmeow:weightedFusionScore ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "b57_s" ] ],
                [ a logic:Formula ;
                    logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "b57_s" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryAppliedFusionScore ] ],
                [ a logic:Formula ;
                    logic:relation gmeow:weightedScoreFoldStep ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "b57_s" ], [ logic:termIndex 1 ; logic:termVariable "b57_t" ] ],
                [ a logic:Formula ;
                    logic:relation gmeow:weightedStepTotal ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "b57_t" ], [ logic:termIndex 1 ; logic:termVariable "b57_q" ] ],
                [ a logic:Formula ;
                    logic:relation gmeow:hasReferenceFrame ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "b57_s" ], [ logic:termIndex 1 ; logic:termVariable "b57_f" ] ],
                [ a logic:Formula ;
                    logic:relation gmeow:hasReferenceFrame ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "b57_q" ], [ logic:termIndex 1 ; logic:termVariable "b57_g" ] ] ] ;
            logic:consequent [ a logic:Formula ;
                logic:relation logic:termEqual ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "b57_f" ], [ logic:termIndex 1 ; logic:termVariable "b57_g" ] ] ] ] ] .

gmeow:WeightedFusionCoefficientOwnerPresenceLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "weighted fusion coefficient owner presence law"@x-gmeow-english ;
    skos:definition "Every typed applied coefficient has at least one typed incoming weighted application owner."@x-gmeow-english ;
    gmeow:useWhen "Use to prevent context-free applied coefficient records without forbidding compatible sharing."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid imposing unique inverse coefficient ownership or accepting an isolated applied carrier."@x-gmeow-english ;
    gmeow:howToUse "Require an incoming weightedFusionCoefficient edge from a typed reported application."@x-gmeow-english ;
    skos:scopeNote "Every owning application separately enforces class, ordinal, mode, fit and frame compatibility; sharing does not merge applications."@x-gmeow-english ;
    skos:example "Fictional scoped example: A fictional fully coordinated coefficient with no application owner fails this applied-account contract."@x-gmeow-english ;
    logic:formalizes gmeow:QueryAppliedFusionCoefficient ;
    logic:message "Every typed applied coefficient has at least one typed incoming weighted application owner." ;
    logic:integrity [ a logic:Formula ;
