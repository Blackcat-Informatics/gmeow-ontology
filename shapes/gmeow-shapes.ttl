@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

# SHACL shapes for the GMEOW vocabulary. The SPARQL target restricts each shape
# to GMEOW-namespaced terms so imported gUFO/peer-schema terms are not flagged.

gmeow:GmeowClassShape
    a sh:NodeShape ;
    rdfs:label "GMEOW class completeness shape" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <http://www.w3.org/2002/07/owl#Class> .
                FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
            }
        """ ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW class must carry at least one rdfs:label." ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW class must carry a skos:definition." ;
    ] ;
    sh:property [
        sh:path rdfs:isDefinedBy ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Every GMEOW class should declare rdfs:isDefinedBy the ontology." ;
    ] .

gmeow:GmeowPropertyShape
    a sh:NodeShape ;
    rdfs:label "GMEOW property completeness shape" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a ?t .
                FILTER(?t IN (
                    <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#DatatypeProperty>
                ))
                FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
            }
        """ ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW property must carry at least one rdfs:label." ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW property must carry a skos:definition." ;
    ] .

# --------------------------------------------------------------------------- #
# Names building block — inclusivity + anti-colonial data shapes. These target
# instance data (gmeow:PersonName individuals), so they are dormant when
# validating the term graph (the TBox has no instances) and enforce when a data
# graph is checked against these shapes.
# --------------------------------------------------------------------------- #

# A name must carry content, but a SURNAME is never required — mononyms and
# non-Western naming systems are first-class. Satisfied by a full name or any
# typed part.
gmeow:AppellationHasContentShape
    a sh:NodeShape ;
    rdfs:label "Appellation content shape (no required surname)" ;
    sh:targetClass gmeow:Appellation ;
    sh:or (
        [ sh:path gmeow:fullName ; sh:minCount 1 ]
        [ sh:path gmeow:hasNamePart ; sh:minCount 1 ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "An appellation must have a gmeow:fullName or at least one name part; a surname is never required (mononyms are valid)." .

# Deadnames and superseded names must be suppressed from display by default.
gmeow:DeadnameSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Deadname / superseded suppression shape" ;
    sh:targetClass gmeow:PersonName ;
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "A superseded name or deadname should set gmeow:displayable false." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/namePurpose> ?p .
                FILTER(?p IN (
                    <https://blackcatinformatics.ca/gmeow/namePurposeDeadname>,
                    <https://blackcatinformatics.ca/gmeow/namePurposeSuperseded>
                ))
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# =========================================================================== #
# Hybrid OWL+SHACL closed-world data shapes (#39, epic #35).
#
# These shapes are the CLOSED-WORLD counterpart of the phase-2 (#38) open-world
# OWL 2 EL axioms. A relator carries `owl:someValuesFrom` so the reasoner can
# *classify* it ("a GenderIdentity points at SOME Gender"); SHACL adds the
# cardinality the reasoner deliberately cannot enforce under the open-world
# assumption ("...at EXACTLY one Gender"). OWL infers; SHACL validates
# (Knublauch, "SHACL and OWL Compared"). Like the names shapes above, all of
# these target INSTANCE DATA, so they stay dormant when `gmeow validate` checks
# the term graph (the TBox has no instances) and bite only when a data graph is
# validated against them. See docs/reasoning.md for the full division of labour.
# =========================================================================== #

# --------------------------------------------------------------------------- #
# (a) Relator well-formedness — closed-world cardinality (CONSTITUTION P7/P8).
# Each facet relator mediates its value via EXACTLY ONE path: the value property
# is functional per facet, but OWL functionality does not REJECT a second value
# (it infers the two are owl:sameAs). SHACL minCount/maxCount enforces it.
# --------------------------------------------------------------------------- #

gmeow:GenderIdentityFacetShape
    a sh:NodeShape ;
    rdfs:label "GenderIdentity well-formedness shape" ;
    sh:targetClass gmeow:GenderIdentity ;
    sh:property [
        sh:path gmeow:genderValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A GenderIdentity facet must point at exactly one gmeow:Gender value (gmeow:genderValue)." ;
    ] .

gmeow:GenderExpressionFacetShape
    a sh:NodeShape ;
    rdfs:label "GenderExpression well-formedness shape" ;
    sh:targetClass gmeow:GenderExpression ;
    sh:property [
        sh:path gmeow:expressionValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A GenderExpression facet must point at exactly one gmeow:GenderExpressionStyle value (gmeow:expressionValue)." ;
    ] .

gmeow:SexualOrientationFacetShape
    a sh:NodeShape ;
    rdfs:label "SexualOrientation well-formedness shape" ;
    sh:targetClass gmeow:SexualOrientation ;
    sh:property [
        sh:path gmeow:sexualOrientationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A SexualOrientation facet must point at exactly one gmeow:SexualOrientationValue (gmeow:sexualOrientationValue)." ;
    ] .

gmeow:RomanticOrientationFacetShape
    a sh:NodeShape ;
    rdfs:label "RomanticOrientation well-formedness shape" ;
    sh:targetClass gmeow:RomanticOrientation ;
    sh:property [
        sh:path gmeow:romanticOrientationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A RomanticOrientation facet must point at exactly one gmeow:RomanticOrientationValue (gmeow:romanticOrientationValue)." ;
    ] .

# The NameUsage relator binds {who is named} × {which appellation}; both relata
# are required and single-valued per usage (a distinct usage is minted per
# audience/register). Audience, register and period stay optional.
gmeow:NameUsageShape
    a sh:NodeShape ;
    rdfs:label "NameUsage well-formedness shape" ;
    sh:targetClass gmeow:NameUsage ;
    sh:property [
        sh:path gmeow:usageNamed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A NameUsage must name exactly one entity (gmeow:usageNamed)." ;
    ] ;
    sh:property [
        sh:path gmeow:usageAppellation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A NameUsage must use exactly one appellation (gmeow:usageAppellation)." ;
    ] .

# A name-usage that names a gmeow:Place is an inferred gmeow:PlaceNaming
# (≡ NameUsage ⊓ ∃usageNamed.Place). Its appellation SHOULD be a gmeow:PlaceName.
# Warning, not Violation, and expressed over the data (not the inferred type) so it
# fires without OWL classification: open-world, a source may type the name later.
gmeow:PlaceNamingAppellationShape
    a sh:NodeShape ;
    rdfs:label "PlaceNaming appellation-kind shape" ;
    sh:targetClass gmeow:NameUsage ;
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "A name-usage that names a gmeow:Place (an inferred gmeow:PlaceNaming) should bind a gmeow:PlaceName via gmeow:usageAppellation." ;
        sh:select """
            SELECT $this WHERE {
                $this gmeow:usageNamed ?place .
                ?place a gmeow:Place .
                $this gmeow:usageAppellation ?app .
                FILTER NOT EXISTS { ?app a gmeow:PlaceName }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# (b) Suppression / display contract (CONSTITUTION P10 — suppression, never
# erasure). The IdentityFacet sibling of DeadnameSuppressionShape: a facet that
# has been superseded (it carries gmeow:validUntil) must be suppressed from
# display (gmeow:displayable false) rather than deleted. Warning, like the
# deadname shape — a source may legitimately lag on setting the flag.
# --------------------------------------------------------------------------- #

# Targets the four concrete IdentityFacet axes directly (not the abstract base):
# a closed-world data check runs without subclass inference, so an instance typed
# only as gmeow:GenderIdentity would not match a gmeow:IdentityFacet target.
gmeow:SupersededFacetSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Superseded identity-facet suppression shape" ;
    sh:targetClass gmeow:GenderIdentity ;
    sh:targetClass gmeow:GenderExpression ;
    sh:targetClass gmeow:SexualOrientation ;
    sh:targetClass gmeow:RomanticOrientation ;
    sh:severity sh:Warning ;   # NodeShape-level so pyshacl honors it (a source may lag the flag)
    sh:sparql [
        sh:message "A superseded identity facet (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/validUntil> ?until .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# (c) Orthogonality data-check (CONSTITUTION P9 — anti-overtyping). The
# closed-world counterpart of the 7-axis owl:AllDisjointClasses matrix: it
# catches an individual placed in two disjoint identity axes WITHOUT a reasoner
# (HermiT proves the same as an inconsistency — see
# tests/test_reasoning_entailments.py::test_two_axis_individual_is_inconsistent).
# --------------------------------------------------------------------------- #

gmeow:IdentityAxisOrthogonalityShape
    a sh:NodeShape ;
    rdfs:label "Identity-axis orthogonality data-check" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a ?axis .
                FILTER(?axis IN (
                    <https://blackcatinformatics.ca/gmeow/GenderIdentity>,
                    <https://blackcatinformatics.ca/gmeow/GenderExpression>,
                    <https://blackcatinformatics.ca/gmeow/SexAssignedAtBirth>,
                    <https://blackcatinformatics.ca/gmeow/SexualOrientation>,
                    <https://blackcatinformatics.ca/gmeow/RomanticOrientation>,
                    <https://blackcatinformatics.ca/gmeow/PronounSet>,
                    <https://blackcatinformatics.ca/gmeow/Honorific>
                ))
            }
        """ ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "An individual may fill at most one identity axis; these seven axes are orthogonal and disjoint (no overtyping)." ;
        sh:select """
            SELECT $this WHERE {
                $this a ?a , ?b .
                FILTER(STR(?a) < STR(?b))   # ordered pair: one result per violation, not two
                FILTER(?a IN (
                    <https://blackcatinformatics.ca/gmeow/GenderIdentity>,
                    <https://blackcatinformatics.ca/gmeow/GenderExpression>,
                    <https://blackcatinformatics.ca/gmeow/SexAssignedAtBirth>,
                    <https://blackcatinformatics.ca/gmeow/SexualOrientation>,
                    <https://blackcatinformatics.ca/gmeow/RomanticOrientation>,
                    <https://blackcatinformatics.ca/gmeow/PronounSet>,
                    <https://blackcatinformatics.ca/gmeow/Honorific>
                ))
                FILTER(?b IN (
                    <https://blackcatinformatics.ca/gmeow/GenderIdentity>,
                    <https://blackcatinformatics.ca/gmeow/GenderExpression>,
                    <https://blackcatinformatics.ca/gmeow/SexAssignedAtBirth>,
                    <https://blackcatinformatics.ca/gmeow/SexualOrientation>,
                    <https://blackcatinformatics.ca/gmeow/RomanticOrientation>,
                    <https://blackcatinformatics.ca/gmeow/PronounSet>,
                    <https://blackcatinformatics.ca/gmeow/Honorific>
                ))
            }
        """ ;
    ] .

# =========================================================================== #
# Standpoint / contested-claims data shapes (#43). The OWL-infers / SHACL-
# validates split applies: SHACL only ever REJECTS closed-world malformations,
# so "contradictory standpoint claims are allowed" is NOT a shape — it is proven
# by a passing positive fixture (tests/test_standpoint.py). The marker shape
# below records that intent where a reader looks; it enforces nothing. All other
# shapes here target INSTANCE DATA and stay dormant on the TBox term graph.
# =========================================================================== #

# (a) Coexistence is explicitly permitted — a documented NO-OP marker (no target,
# no constraint). Contradictory gmeow:accordingTo-scoped claims over the same
# subject/predicate are co-equal and must NOT be flagged; there is deliberately
# no shape constraining their coexistence (Principle 9 — no single slot to win).
gmeow:StandpointCoexistenceShape
    a sh:NodeShape ;
    rdfs:label "Standpoint coexistence marker (no-op)" ;
    rdfs:comment "Documentation only — asserts and enforces nothing. Contradictory gmeow:accordingTo-scoped claims over the same subject/predicate are explicitly permitted and are NOT a violation (Principle 9). Coexistence is proven by the positive fixture in tests/test_standpoint.py, not by a SHACL constraint, because the OWL-infers / SHACL-validates split means SHACL only rejects malformations." .

# (b) StandpointTenure well-formedness — closed-world cardinality. Mirrors
# NameUsageShape; the OWL EL someValuesFrom in standpoint.ttl classifies, SHACL
# enforces "exactly one standpoint".
gmeow:StandpointTenureShape
    a sh:NodeShape ;
    rdfs:label "StandpointTenure well-formedness shape" ;
    sh:targetClass gmeow:StandpointTenure ;
    sh:property [
        sh:path gmeow:tenureStandpoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A StandpointTenure must record exactly one standpoint (gmeow:tenureStandpoint)." ;
    ] .

# (c) No preferred / primary claim (Principle 9). Fires on any GMEOW-namespace
# predicate whose local name begins with "primary" / "preferred" — the forward
# guard against ever re-creating the single winning slot the edit war is fought
# over (the data-graph twin of the statement-DSL no_preferred_rank lint and the
# term-absence test). No such term exists today, so this is dormant.
gmeow:NoPreferredClaimShape
    a sh:NodeShape ;
    rdfs:label "No preferred / primary claim shape" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this ?p ?o .
                FILTER(STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/primary")
                    || STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/preferred"))
            }
        """ ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "No claim may be marked preferred/primary; standpoint-indexed claims are co-equal — there is no single slot to win (Principle 9)." ;
        sh:select """
            SELECT $this WHERE {
                $this ?p ?o .
                FILTER(STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/primary")
                    || STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/preferred"))
            }
        """ ;
    ] .

# (d) Withdrawn-standpoint suppression (Principle 10 — suppression, never
# erasure). The StandpointTenure sibling of SupersededFacetSuppressionShape: a
# tenure whose interval has ended (a withdrawn position) should set
# gmeow:displayable false rather than be deleted. Warning — a source may lag.
gmeow:WithdrawnStandpointSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Withdrawn standpoint suppression shape" ;
    sh:targetClass gmeow:StandpointTenure ;
    sh:severity sh:Warning ;   # NodeShape-level so pyshacl honors it (a source may lag the flag)
    sh:sparql [
        sh:message "A withdrawn standpoint (a StandpointTenure whose interval has ended) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/duringInterval> ?iv .
                ?iv <https://blackcatinformatics.ca/gmeow/endedAtTime> ?end .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Events module (#41). Closed-world well-formedness for the universal event +
# its Participation relator; the standpoint coexistence / no-preferred-claim
# guards (StandpointCoexistenceShape, NoPreferredClaimShape) are generic and
# already cover contested eventType / participationRole claims.
# --------------------------------------------------------------------------- #

# A Participation must mediate exactly one event and at least one participant —
# the closed-world counterpart of the EL someValuesFrom mediation axiom in
# events.ttl (mirrors gmeow:NameUsageShape).
gmeow:ParticipationHasPlayersShape
    a sh:NodeShape ;
    rdfs:label "Participation well-formedness shape" ;
    sh:targetClass gmeow:Participation ;
    sh:property [
        sh:path gmeow:participationEvent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Participation must be part of exactly one event (gmeow:participationEvent)." ;
    ] ;
    sh:property [
        sh:path gmeow:participationParticipant ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Participation must have at least one participant (gmeow:participationParticipant)." ;
    ] .

# An event should carry at least a type or some temporal placement — otherwise it
# is an unanchored occurrence. Warning (a stub event may be fleshed out later).
gmeow:EventHasTypeOrTimeShape
    a sh:NodeShape ;
    rdfs:label "Event has type or time shape" ;
    sh:targetClass gmeow:Event ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:path gmeow:eventType ; sh:minCount 1 ]
        [ sh:path gmeow:eventTime ; sh:minCount 1 ]
        [ sh:path gmeow:eventInterval ; sh:minCount 1 ]
        [ sh:path gmeow:earliestStart ; sh:minCount 1 ]
        [ sh:path gmeow:latestEnd ; sh:minCount 1 ]
    ) ;
    sh:message "An event should carry at least a gmeow:eventType or a temporal placement (gmeow:eventTime / eventInterval / earliestStart / latestEnd)." .

# Suppression, never erasure (Principle 10): a superseded participation claim — a
# corrected participant, role, or date carried on a Participation that has ended
# (gmeow:validUntil) — should set gmeow:displayable false rather than be deleted.
# The events sibling of SupersededFacetSuppressionShape. Warning (a source may lag).
gmeow:CorrectedEventSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Corrected / superseded participation suppression shape" ;
    sh:targetClass gmeow:Participation ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A superseded participation (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/validUntil> ?until .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Rights / IP module (#21). Closed-world well-formedness for the rights relators
# (the SHACL counterpart of the EL someValuesFrom mediation axioms in rights.ttl),
# plus an expired-right suppression warning (Principle 10). The generic
# NoPreferredClaimShape already forbids any preferred / primary right (Principle 9).
# --------------------------------------------------------------------------- #

# A RightsStatement governs exactly one asset (mirrors the someValuesFrom on
# gmeow:statementAbout).
gmeow:RightsStatementShape
    a sh:NodeShape ;
    rdfs:label "RightsStatement well-formedness shape" ;
    sh:targetClass gmeow:RightsStatement ;
    sh:property [
        sh:path gmeow:statementAbout ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A RightsStatement must govern exactly one asset (gmeow:statementAbout)." ;
    ] .

# Every deontic rule regulates exactly one action (mirrors the someValuesFrom on
# gmeow:ruleAction). Targets the concrete rule kinds directly — pyshacl does not
# infer subclass membership, so targeting the abstract gmeow:Rule would miss
# instances typed only as Permission / Prohibition / Duty.
gmeow:RuleHasActionShape
    a sh:NodeShape ;
    rdfs:label "Rule well-formedness shape" ;
    sh:targetClass gmeow:Permission ;
    sh:targetClass gmeow:Prohibition ;
    sh:targetClass gmeow:Duty ;
    sh:property [
        sh:path gmeow:ruleAction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A rule (Permission / Prohibition / Duty) must regulate exactly one action (gmeow:ruleAction)." ;
    ] .

# A Copyright relator mediates exactly one work and at least one holder.
gmeow:CopyrightShape
    a sh:NodeShape ;
    rdfs:label "Copyright well-formedness shape" ;
    sh:targetClass gmeow:Copyright ;
    sh:property [
        sh:path gmeow:copyrightWork ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Copyright must be about exactly one work (gmeow:copyrightWork)." ;
    ] ;
    sh:property [
        sh:path gmeow:copyrightHolder ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Copyright must have at least one holder (gmeow:copyrightHolder)." ;
    ] .

# A Licence is granted by at least one licensor (its other parties / work are
# optional — a blanket or open licence need not name a licensee).
gmeow:LicenseShape
    a sh:NodeShape ;
    rdfs:label "License well-formedness shape" ;
    sh:targetClass gmeow:License ;
    sh:property [
        sh:path gmeow:licensor ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A License must name at least one licensor (gmeow:licensor)." ;
    ] .

# A Trademark mediates exactly one mark and at least one holder.
gmeow:TrademarkShape
    a sh:NodeShape ;
    rdfs:label "Trademark well-formedness shape" ;
    sh:targetClass gmeow:Trademark ;
    sh:property [
        sh:path gmeow:trademarkMark ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Trademark must be about exactly one mark (gmeow:trademarkMark)." ;
    ] ;
    sh:property [
        sh:path gmeow:trademarkHolder ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Trademark must have at least one holder (gmeow:trademarkHolder)." ;
    ] .

# Suppression, never erasure (Principle 10): an expired / cancelled trademark
# should set gmeow:displayable false rather than be deleted. Warning (a source
# may lag the status change).
gmeow:ExpiredTrademarkSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Expired / cancelled trademark suppression shape" ;
    sh:targetClass gmeow:Trademark ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "An expired or cancelled trademark should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/trademarkStatus> ?st .
                FILTER( ?st IN (
                    <https://blackcatinformatics.ca/gmeow/trademarkStatusExpired>,
                    <https://blackcatinformatics.ca/gmeow/trademarkStatusCancelled> ) )
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# Constraint algebra well-formedness (#21) — the SHACL counterpart of the EL
# someValuesFrom mediation axioms on gmeow:AtomicConstraint / gmeow:LogicalConstraint.
gmeow:AtomicConstraintShape
    a sh:NodeShape ;
    rdfs:label "Atomic constraint well-formedness shape" ;
    sh:targetClass gmeow:AtomicConstraint ;
    sh:property [
        sh:path gmeow:leftOperand ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
        sh:message "An atomic constraint must have exactly one gmeow:leftOperand." ;
    ] ;
    sh:property [
        sh:path gmeow:constraintOperator ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
        sh:message "An atomic constraint must have exactly one gmeow:constraintOperator." ;
    ] ;
    # Exactly one right-hand side: a literal value XOR an IRI reference.
    sh:xone (
        [ sh:property [ sh:path gmeow:rightOperand ;
            sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
            sh:message "An atomic constraint must have exactly one gmeow:rightOperand when no reference is given." ] ]
        [ sh:property [ sh:path gmeow:rightOperandReference ;
            sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
            sh:message "An atomic constraint must have exactly one gmeow:rightOperandReference when no literal value is given." ] ]
    ) .

gmeow:LogicalConstraintShape
    a sh:NodeShape ;
    rdfs:label "Logical constraint well-formedness shape" ;
    sh:targetClass gmeow:LogicalConstraint ;
    sh:property [
        sh:path gmeow:constraintLogic ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
        sh:message "A logical constraint must have exactly one gmeow:constraintLogic operator." ;
    ] ;
    sh:property [
        sh:path gmeow:logicConstraintMember ;
        sh:minCount 2 ; sh:severity sh:Violation ;
        sh:message "A logical constraint must combine at least two member constraints." ;
    ] .

gmeow:InternalLanguageTagShape
    a sh:NodeShape ;
    rdfs:label "GMEOW internal language tag validation shape" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT DISTINCT ?this WHERE {
                ?this ?p ?value .
                FILTER (STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/"))
                FILTER (isLiteral(?value) && lang(?value) != "")
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Literals in GMEOW must use the 'x-gmeow-' private-use prefix for language tags." ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this ?p ?value .
                FILTER (STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/"))
                FILTER (isLiteral(?value) && lang(?value) != "" && !regex(lang(?value), "^x-gmeow-[a-z0-9\\\\-]+$"))
            }
        """ ;
    ] .
