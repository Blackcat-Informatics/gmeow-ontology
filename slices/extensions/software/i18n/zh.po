msgid "annotated tag target"
msgstr "附注标签目标"


msgctxt "https://blackcatinformatics.ca/gmeow/tagTarget|http://www.w3.org/2004/02/skos/core#definition"
msgid "The immediate object named by an annotated tag. It may be a blob, tree, commit or another tag; it is not silently peeled to a commit."
msgstr "附注标签命名的直接对象，可为 blob、树、提交或另一标签；不会被暗中剥离为提交。"


msgctxt "https://blackcatinformatics.ca/gmeow/tagTarget|http://www.w3.org/2004/02/skos/core#example"
msgid "The source record names gmeow:tagTarget explicitly."
msgstr "来源记录显式命名 gmeow:tagTarget。"


msgctxt "https://blackcatinformatics.ca/gmeow/taggerIdentity|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring object completeness, ownership or successful Git execution from taggerIdentity alone."
