@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/sioc> a align:Alignment ;
    rdfs:label "GMEOW → sioc (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "Thread → sioc:Container"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Thread ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri sioc:Thread ] ;
            align:relation "=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "partOfThread → sioc:has_container"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:partOfThread ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri sioc:has_container ] ;
            align:relation "=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "from-address holder → sioc:has_creator"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:from ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri sioc:has_creator ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ],
        [ a align:Cell ;
            rdfs:label "EmailMessage → sioc:Post"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:EmailMessage ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri sioc:Post ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "inReplyTo → sioc:reply_of"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:inReplyTo ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri sioc:reply_of ] ;
            align:relation "=" ;
            edoal:measure 9.5e-01 ],
        [ a align:Cell ;
            rdfs:label "OnlineAccount → sioc:UserAccount + account_of"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:holdsAccount ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri sioc:account_of ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "sioc" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
