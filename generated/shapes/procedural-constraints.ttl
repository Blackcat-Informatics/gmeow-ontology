<https://blackcatinformatics.ca/gmeow/JournalEntryBalanceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/JournalEntryBalancedShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/JournalEntry> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "The sum of debit postings must equal the sum of credit postings for each currency in a JournalEntry." ;
        sh:select """SELECT $this WHERE { { SELECT $this ?group (SUM(?debitVal) AS ?sumDebits) (SUM(?creditVal) AS ?sumCredits) WHERE { $this <https://blackcatinformatics.ca/gmeow/journalEntryPostings> ?posting . ?posting <https://blackcatinformatics.ca/gmeow/postingAmount> ?amount ; <https://blackcatinformatics.ca/gmeow/postingDirection> ?direction . ?amount <https://blackcatinformatics.ca/gmeow/monetaryValue> ?val ; <https://blackcatinformatics.ca/gmeow/currency> ?group . BIND(IF(?direction = <https://blackcatinformatics.ca/gmeow/postingDirectionDebit>, ?val, 0) AS ?debitVal) BIND(IF(?direction = <https://blackcatinformatics.ca/gmeow/postingDirectionCredit>, ?val, 0) AS ?creditVal) } GROUP BY $this ?group } FILTER(?sumDebits != ?sumCredits) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/JournalEntryPostingsCountConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/JournalEntryHasPostingsShape> ;
