#
# Declarative structural assertions for the procedures slice (#226) — the slice-resident
# test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants formerly hand-written in
# tests/test_procedures.py. Each assertion runs as a SPARQL ASK over the procedures
# module graph (gmeow:scopeModule) under the native Rust harness (crates/slicetest).
# Procedures is NOT yet #694-migrated, so class stereotypes remain gufo:
# (gufo:Kind, gufo:EventType, gufo:AbstractIndividualType, gufo:QualityValue), not logic:.
#
# RETAINED in pytest (not migratable here):
#   test_ingestion_procedure_has_six_steps — counts g.objects() for hasProcedureStep;
#     a numeric / cardinality count that cannot be expressed as a module-scoped ASK.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest→DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/procedures/tests/> .

# --- 1. Procedure is an owl:Class typed gufo:Kind and subclass of InformationObject (MUST) ---
ex:saProcedureIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Procedure a owl:Class , gufo:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:Procedure MUST be an owl:Class typed gufo:Kind and a subclass of gmeow:InformationObject — a procedure is the prescriptive-spec (plan) side of the plan ⟂ execution de-conflation (#226). Mirrors test_procedure_is_information_object." .

# --- 2. ProcedureStep is an owl:Class typed gufo:Kind and subclass of InformationObject (MUST) ---
ex:saProcedureStepIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ProcedureStep a owl:Class , gufo:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:ProcedureStep MUST be an owl:Class typed gufo:Kind and a subclass of gmeow:InformationObject — procedure steps are plan-level specifications, not execution occurrences (#226). Mirrors test_procedure_step_is_information_object." .

# --- 3. Execution is an owl:Class typed gufo:EventType and subclass of Event (MUST) ---
ex:saExecutionIsEvent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Execution a owl:Class , gufo:EventType ;
        rdfs:subClassOf gmeow:Event .
}""" ;
    gmeow:saRationale "gmeow:Execution MUST be an owl:Class typed gufo:EventType and a subclass of gmeow:Event — an execution is the occurrence (plan ⟂ execution de-conflation) that enacts a Procedure (#226). Mirrors test_execution_is_event." .

# --- 4. ControlFlow is an owl:Class typed gufo:Kind and subclass of gufo:Relator (MUST) ---
ex:saControlFlowIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ControlFlow a owl:Class , gufo:Kind ;
        rdfs:subClassOf gufo:Relator .
}""" ;
    gmeow:saRationale "gmeow:ControlFlow MUST be an owl:Class typed gufo:Kind and a subclass of gufo:Relator — control-flow is a reified relator connecting two ProcedureSteps following the Participation idiom (#226). Mirrors test_control_flow_is_relator." .

# --- 5. DataFlow is an owl:Class typed gufo:Kind and subclass of gufo:Relator (MUST) ---
ex:saDataFlowIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:DataFlow a owl:Class , gufo:Kind ;
        rdfs:subClassOf gufo:Relator .
}""" ;
    gmeow:saRationale "gmeow:DataFlow MUST be an owl:Class typed gufo:Kind and a subclass of gufo:Relator — data-flow is a reified relator carrying entities between ProcedureSteps (#226). Mirrors test_data_flow_is_relator." .

# --- 6a. ProcedureType seed individuals are typed gmeow:ProcedureType (MUST) ---
ex:saProcedureTypeValuesAreIndividuals a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:procedureTypeRecipe          a gmeow:ProcedureType .
    gmeow:procedureTypeLabProtocol     a gmeow:ProcedureType .
    gmeow:procedureTypeDataPipeline    a gmeow:ProcedureType .
    gmeow:procedureTypeAgentFlow       a gmeow:ProcedureType .
    gmeow:procedureTypeCiBuild         a gmeow:ProcedureType .
    gmeow:procedureTypeBusinessProcess a gmeow:ProcedureType .
    gmeow:procedureTypeResearchPlan    a gmeow:ProcedureType .
    gmeow:procedureTypeIngestion       a gmeow:ProcedureType .
}""" ;
    gmeow:saRationale "All eight ProcedureType seed individuals MUST be typed gmeow:ProcedureType — the procedure kind is an open value vocabulary of individuals, never subclasses (Principle 9, #226). Mirrors test_procedure_type_values_are_individuals (must arm)." .

# --- 6b. ProcedureType seed individuals are NOT owl:Class (MUST-NOT) -----------
ex:saProcedureTypeValuesNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?v {
        gmeow:procedureTypeRecipe
        gmeow:procedureTypeLabProtocol
        gmeow:procedureTypeDataPipeline
        gmeow:procedureTypeAgentFlow
        gmeow:procedureTypeCiBuild
        gmeow:procedureTypeBusinessProcess
        gmeow:procedureTypeResearchPlan
        gmeow:procedureTypeIngestion
    }
    ?v a owl:Class .
}""" ;
    gmeow:saRationale "ProcedureType seed values MUST NOT be owl:Class — overtyping the procedure kind as subclasses is banned (Principle 9, #226). Mirrors test_procedure_type_values_are_individuals (mustNot arm)." .

# --- 7a. StepType seed individuals are typed gmeow:StepType (MUST) -------------
ex:saStepTypeValuesAreIndividuals a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:stepTypeAtomic     a gmeow:StepType .
    gmeow:stepTypeStart      a gmeow:StepType .
    gmeow:stepTypeEnd        a gmeow:StepType .
    gmeow:stepTypeBranch     a gmeow:StepType .
    gmeow:stepTypeSubprocess a gmeow:StepType .
    gmeow:stepTypeParallel   a gmeow:StepType .
}""" ;
    gmeow:saRationale "All six StepType seed individuals MUST be typed gmeow:StepType — step kinds are an open value vocabulary of individuals, never subclasses (Principle 9, #226). Mirrors test_step_type_values_are_individuals (must arm)." .

# --- 7b. StepType seed individuals are NOT owl:Class (MUST-NOT) ----------------
ex:saStepTypeValuesNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?v {
        gmeow:stepTypeAtomic
        gmeow:stepTypeStart
        gmeow:stepTypeEnd
        gmeow:stepTypeBranch
        gmeow:stepTypeSubprocess
        gmeow:stepTypeParallel
    }
    ?v a owl:Class .
}""" ;
    gmeow:saRationale "StepType seed values MUST NOT be owl:Class — overtyping step kinds as subclasses is banned (Principle 9, #226). Mirrors test_step_type_values_are_individuals (mustNot arm)." .

# --- 8a. ExecutionStatus seed individuals are typed gmeow:ExecutionStatus (MUST) ---
ex:saExecutionStatusValuesAreIndividuals a gmeow:StructuralAssertion ;
