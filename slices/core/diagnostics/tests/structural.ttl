#
# Declarative structural assertions for the diagnostics slice — the
# slice-resident test-DSL twin of the MUST / MUST-NOT invariants formerly
# hand-written in tests/test_diagnostics.py. Authored as gmeow: ontology data
# so the same annotation discipline and the native Rust harness
# (crates/slicetest) drive the test, not ad-hoc Python. Each assertion
# runs as a SPARQL ASK over the module graph (gmeow:scopeModule). A positive
# universal over a fixed term set is a single MUST with a conjunctive pattern
# (all conjuncts must match); a negative universal ("no property carries this
# characteristic") is a MUST-NOT over a VALUES set or explicit list.
#
# The annotation-completeness test (formerly test_annotation_completeness)
# and the graphBoxRole-coverage test (formerly test_graph_box_role_coverage)
# are both covered by the global `make validate` SHACL gate
# (shapes/gmeow-shapes.ttl: GmeowClassShape + GmeowPropertyShape + GmeowDatatypeShape
# enforce rdfs:label / skos:definition / rdfs:isDefinedBy / gmeow:graphBoxRole
# on every gmeow:-namespaced class and property). Verified 2026-06-22: deleting
# gmeow:Finding's rdfs:label caused make validate to emit "error Every GMEOW
# class must carry at least one rdfs:label." and exit non-zero. The
# graphBoxRole shape (sh:path gmeow:graphBoxRole, min-count 1) is wired
# alongside the label shapes in the same file, so both are enforced together.
# Both pytest functions are therefore deleted rather than migrated.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/diagnostics/tests/> .

# --- 1a. Finding is an owl:Class and a logic:SubKind (MUST hold) ---------------
ex:saFindingIsSubKindOwlClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Finding a owl:Class , logic:SubKind ;
        rdfs:subClassOf gmeow:Observation .
}""" ;
    gmeow:saRationale "gmeow:Finding MUST be an owl:Class, a logic:SubKind (inheriting Observation's identity principle — the OntoUML MixIden rule forbids a Kind specializing a Kind), and rdfs:subClassOf gmeow:Observation (a diagnostic IS an observation, Principle 9)." .

# --- 1b. Finding is NOT a logic:Kind (MUST-NOT hold) --------------------------
ex:saFindingNotKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
ASK {
    gmeow:Finding rdf:type logic:Kind .
}""" ;
    gmeow:saRationale "gmeow:Finding MUST NOT be typed logic:Kind — gmeow:Observation already is a Kind; a Kind specializing a Kind is the OntoUML MixIden identity conflict. Finding inherits the identity principle via SubKind." .

# --- 2a. findingSeverity ⊑ observationResult and ranges DiagnosticSeverity ----
ex:saFindingSeveritySubPropertyAndRange a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:findingSeverity rdfs:subPropertyOf gmeow:observationResult ;
        rdfs:range gmeow:DiagnosticSeverity .
}""" ;
    gmeow:saRationale "gmeow:findingSeverity MUST be rdfs:subPropertyOf gmeow:observationResult and MUST carry rdfs:range gmeow:DiagnosticSeverity (the closed severity vocabulary)." .

# --- 2b. findingLocation ⊑ observedFeature (MUST hold) -----------------------
ex:saFindingLocationSubProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:findingLocation rdfs:subPropertyOf gmeow:observedFeature .
}""" ;
    gmeow:saRationale "gmeow:findingLocation MUST be rdfs:subPropertyOf gmeow:observedFeature — a finding's location IS what the observation is about, enabling generic 'observations about X' queries by inheritance." .

# --- 2c. findingLocation has open range: NO rdfs:range (MUST-NOT hold) --------
ex:saFindingLocationOpenRange a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:findingLocation rdfs:range ?r . }""" ;
    gmeow:saRationale "gmeow:findingLocation MUST NOT declare an rdfs:range — per-kind narrowing is SHACL's job; the location may point at any term (typically a reified RDF 1.2 statement node carrying GTS wire coordinates)." .

# --- 3a. DiagnosticSeverity is an owl:Class and a logic:AbstractIndividualType --
ex:saDiagnosticSeverityIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:DiagnosticSeverity a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:DiagnosticSeverity MUST be an owl:Class, a logic:AbstractIndividualType, and rdfs:subClassOf logic:QualityValue — the value-vocabulary genus. Severity is a quality value, not a subclass hierarchy." .

# --- 3b. All four severity individuals are typed DiagnosticSeverity (MUST) ----
ex:saSeverityIndividualsSeeded a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:severityError   a gmeow:DiagnosticSeverity .
    gmeow:severityWarning a gmeow:DiagnosticSeverity .
    gmeow:severityNote    a gmeow:DiagnosticSeverity .
    gmeow:severityInfo    a gmeow:DiagnosticSeverity .
}""" ;
    gmeow:saRationale "All four severity grade individuals (severityError, severityWarning, severityNote, severityInfo) MUST be typed gmeow:DiagnosticSeverity — the closed-by-convention value vocabulary (Principle 9)." .

# --- 3c. Severity grade individuals are NOT owl:Class (MUST-NOT hold) --------
ex:saSeverityIndividualsNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
ASK {
    VALUES ?indiv { gmeow:severityError gmeow:severityWarning gmeow:severityNote gmeow:severityInfo }
    ?indiv rdf:type owl:Class .
}""" ;
    gmeow:saRationale "None of the four severity grade individuals may be typed owl:Class — grades are individuals, never subclasses (Principle 9)." .

# --- 4. Wire-coordinate datatype properties range over nonNegativeInteger -----
ex:saWireCoordinatesAreDatatype a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:gtsTermId     a owl:DatatypeProperty ; rdfs:range xsd:nonNegativeInteger .
    gmeow:gtsQuadIndex  a owl:DatatypeProperty ; rdfs:range xsd:nonNegativeInteger .
    gmeow:gtsReifierId  a owl:DatatypeProperty ; rdfs:range xsd:nonNegativeInteger .
    gmeow:gtsFrameIndex a owl:DatatypeProperty ; rdfs:range xsd:nonNegativeInteger .
}""" ;
    gmeow:saRationale "All four diagnostics-owned GTS wire coordinate properties (gtsTermId, gtsQuadIndex, gtsReifierId, gtsFrameIndex) MUST be owl:DatatypeProperty and MUST range over xsd:nonNegativeInteger (wire indices are always non-negative)." .

# --- 5. No truth/resolution bits (MUST-NOT hold) -----------------------------
ex:saNoTruthOrResolutionBits a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    VALUES ?forbidden { gmeow:isTrue gmeow:isFalse gmeow:isResolved gmeow:findingOutcome }
    { ?forbidden ?p ?o . }
    UNION { ?s ?forbidden ?o . }
    UNION { ?s ?p ?forbidden . }
}""" ;
    gmeow:saRationale "The diagnostics slice is a projection of the Rust-owned canonical report and MUST NOT mint truth or resolution bits (isTrue, isFalse, isResolved, findingOutcome). None of the forbidden terms may appear in any subject, predicate, or object position." .

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix wordtest: <https://example.org/natural-language-values/tests/> .

wordtest:sadiagnosticsWords a gmeow:StructuralAssertion ;
    gmeow:saScope gmeow:scopeModule ; gmeow:saPolarity gmeow:must ;
    gmeow:saPattern "PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/> PREFIX logic: <https://blackcatinformatics.ca/logic/> PREFIX lang: <https://blackcatinformatics.ca/lang/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX owl: <http://www.w3.org/2002/07/owl#> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> ASK { gmeow:findingMessage (logic:range|rdfs:range) rdfs:Literal . gmeow:Finding (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:findingMessage ; (logic:allValuesFrom|owl:allValuesFrom) ?values0_0 ] . ?values0_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:findingSuggestion (logic:range|rdfs:range) rdfs:Literal . gmeow:Finding (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:findingSuggestion ; (logic:allValuesFrom|owl:allValuesFrom) ?values1_0 ] . ?values1_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:ruleRemediation (logic:range|rdfs:range) rdfs:Literal . gmeow:ValidationRule (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:ruleRemediation ; (logic:allValuesFrom|owl:allValuesFrom) ?values2_0 ] . ?values2_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:findingRemediation (logic:range|rdfs:range) rdfs:Literal . gmeow:Finding (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:findingRemediation ; (logic:allValuesFrom|owl:allValuesFrom) ?values3_0 ] . ?values3_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:adviceAvoidWhen (logic:range|rdfs:range) rdfs:Literal . gmeow:AdviceEntry (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:adviceAvoidWhen ; (logic:allValuesFrom|owl:allValuesFrom) ?values4_0 ] . ?values4_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:adviceUseWhen (logic:range|rdfs:range) rdfs:Literal . gmeow:AdviceEntry (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:adviceUseWhen ; (logic:allValuesFrom|owl:allValuesFrom) ?values5_0 ] . ?values5_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:adviceHowToUse (logic:range|rdfs:range) rdfs:Literal . gmeow:AdviceEntry (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:adviceHowToUse ; (logic:allValuesFrom|owl:allValuesFrom) ?values6_0 ] . ?values6_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:findingHowToUse (logic:range|rdfs:range) rdfs:Literal . gmeow:Finding (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:findingHowToUse ; (logic:allValuesFrom|owl:allValuesFrom) ?values7_0 ] . ?values7_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:findingUseWhen (logic:range|rdfs:range) rdfs:Literal . gmeow:Finding (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:findingUseWhen ; (logic:allValuesFrom|owl:allValuesFrom) ?values8_0 ] . ?values8_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:findingAvoidWhen (logic:range|rdfs:range) rdfs:Literal . gmeow:Finding (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:findingAvoidWhen ; (logic:allValuesFrom|owl:allValuesFrom) ?values9_0 ] . ?values9_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . }" ;
    gmeow:saRationale "Natural-language fields admit unspecified, language-tagged and directional text through canonical value restrictions, without closing subject domains." .
