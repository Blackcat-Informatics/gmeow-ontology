msgctxt "https://blackcatinformatics.ca/gmeow/GitRepositoryHasOneObjectFormatConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "One Git repository selects one object format; conflicting selections do not define a mixed format."
msgstr "一个 Git 仓库选择一个对象格式；冲突选择不定义混合格式。"


msgctxt "https://blackcatinformatics.ca/gmeow/GitRepositoryHasOneObjectFormatConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "The source record is governed by gmeow:GitRepositoryHasOneObjectFormatConstraint."
msgstr "来源记录受 gmeow:GitRepositoryHasOneObjectFormatConstraint 约束。"


msgctxt "https://blackcatinformatics.ca/gmeow/ParentOccurrenceHasReifiedTupleConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating ParentOccurrenceHasReifiedTupleConstraint as a traversal, hashing or Git execution certificate."
msgstr "避免将 ParentOccurrenceHasReifiedTupleConstraint 视为遍历、哈希或 Git 执行证书。"


