#
# Declarative structural assertions for the names slice -- the slice-resident
# test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants formerly
# hand-written in tests/test_names.py. Each assertion runs as a SPARQL ASK
# over the names module graph (gmeow:scopeModule) under the native Rust
# slicetest harness (crates/slicetest).
#
# Names IS migrated: class stereotypes are logic: (logic:Kind,
# logic:SubKind, logic:AbstractIndividualType), NOT gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_place_naming_is_defined_class -- traverses OWL intersection lists
#     using rdflib Collection; the equivalentClass body is an anonymous blank
#     node structure that is not faithfully testable as a single ASK without
#     re-encoding the anonymous restriction inline. Retained to avoid false
#     confidence from a weaker ASK.
#   test_seeded_pronoun_sets_have_five_forms -- iterates over a 21-item
#     _DECLINABLE_PRONOUN_ANCHORS tuple checking per-anchor label presence
#     and all five pronoun forms; a dynamic numeric sweep over live ABox data.
#   test_pronoun_name_only_value_exists -- checks label presence via
#     graph.value() and five-form absence on non-specifying stances
#     (_NON_SPECIFYING_PRONOUNS tuple); ABox / numeric live-data checks.
#   test_contested_name_usage_coexists -- SHACL validation on a fixture file;
#     ExampleConformance, not a structural TBox assertion.
#   test_no_preferred_or_primary_name_term_extended -- dynamic sweep over
#     a banned-name list checking ObjectProperty / DatatypeProperty /
#     AnnotationProperty / Class types; equivalent mustNot cells already
#     provided by saNoPreferredOrPrimaryNameTerm (cell 30) which covers
#     the full set of banned IRIs.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/names/tests/> .

# --- 1. Appellation subclasses InformationObject (MUST) -----------------------
ex:saAppellationSubclassInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Appellation a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:Appellation MUST be an owl:Class typed logic:Kind and subclass of gmeow:InformationObject -- the universal name-object umbrella (anti-colonial design, co-equality doctrine)." .

# --- 3. NameUsage subclasses logic:Relator (MUST) ----------------------------
ex:saNameUsageSubclassRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NameUsage rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:NameUsage MUST be rdfs:subClassOf logic:Relator -- stereotype namespace is logic: (migrated, not gufo:)." .

# --- 4. Constitutive NameUsage roles are ObjectProperties (MUST) -------------
ex:saNameUsageConstitutiveRolesFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:usageNamed              a owl:ObjectProperty .
    gmeow:usageAppellation        a owl:ObjectProperty .
    gmeow:usageRelationshipScope  a owl:ObjectProperty .
    gmeow:usageRegister           a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:usageNamed, usageAppellation, usageRelationshipScope, and usageRegister MUST all be owl:ObjectProperty -- constitutive relator roles (one usage = one named entity, one appellation, one scope, one register)." .

# --- 5. Perspectival NameUsage roles are ObjectProperties (MUST) -------------
ex:saNameUsagePerspectivalRolesObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:usageNamer    a owl:ObjectProperty .
    gmeow:usageAudience a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:usageNamer and usageAudience MUST be owl:ObjectProperty." .

# --- 6. Perspectival roles are NOT functional (MUST-NOT) ---------------------
ex:saNameUsagePerspectivalRolesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p { gmeow:usageNamer gmeow:usageAudience }
    ?rec logic:characterizes ?p ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "gmeow:usageNamer and gmeow:usageAudience MUST NOT be owl:FunctionalProperty -- namer and audience are shared/perspectival; a usage may have several namers or be broadcast to several audiences (Principle 9)." .

# --- 7. hasName subPropertyOf hasAppellation with PersonName range (MUST) ----
ex:saHasNameSubpropertyAndRange a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasName rdfs:subPropertyOf gmeow:hasAppellation ;
        rdfs:range gmeow:PersonName .
}""" ;
    gmeow:saRationale "gmeow:hasName MUST be rdfs:subPropertyOf gmeow:hasAppellation with rdfs:range gmeow:PersonName -- re-homed from genealogy; hasName is the person-scoped naming spine." .

# --- 8. hasPlaceName is a full subproperty graft (MUST) ----------------------
ex:saHasPlaceNameSubproperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasPlaceName a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:hasAppellation ;
        rdfs:domain gmeow:Place ;
        rdfs:range gmeow:PlaceName .
}""" ;
    gmeow:saRationale "gmeow:hasPlaceName MUST be an owl:ObjectProperty rdfs:subPropertyOf gmeow:hasAppellation with domain gmeow:Place and range gmeow:PlaceName -- place-scoped specialization replacing the retired flat alternateName." .

# --- 9. PlaceNaming is an owl:Class subclassing NameUsage (MUST) -------------
ex:saPlaceNamingIsClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PlaceNaming a owl:Class ;
        rdfs:subClassOf gmeow:NameUsage .
}""" ;
    gmeow:saRationale "gmeow:PlaceNaming MUST be an owl:Class and rdfs:subClassOf gmeow:NameUsage -- the DEFINED specialization (Principle 6, no parallel relator). The full equivalentClass definition check is retained as a separate structural check (anonymous blank-node structure)." .

# --- 10. usageAuthority is a non-functional ObjectProperty to Agent (MUST) ---
ex:saUsageAuthorityObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:usageAuthority a owl:ObjectProperty ;
        rdfs:domain gmeow:NameUsage ;
        rdfs:range gmeow:Agent .
}""" ;
    gmeow:saRationale "gmeow:usageAuthority MUST be an owl:ObjectProperty with domain gmeow:NameUsage and range gmeow:Agent -- toponymic / naming authority, non-functional (competing authorities coexist, Principle 9)." .

# --- 11. usageAuthority is NOT functional (MUST-NOT) ------------------------
ex:saUsageAuthorityNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { ?rec logic:characterizes gmeow:usageAuthority ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:usageAuthority MUST NOT be owl:FunctionalProperty -- joint or competing naming authorities coexist with no privileged claimant (anti-colonial, Principle 9)." .

# --- 12. nameLanguage is an ObjectProperty to Language (MUST) ----------------
ex:saNameLanguageFunctionalObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:nameLanguage a owl:ObjectProperty ;
        rdfs:range gmeow:Language .
}""" ;
    gmeow:saRationale "gmeow:nameLanguage MUST be owl:ObjectProperty with rdfs:range gmeow:Language -- Language is always first-class (never a bare BCP-47 literal)." .

# --- 13. nameLanguage is NOT a DatatypeProperty (MUST-NOT) -------------------
ex:saNameLanguageNotDatatypeProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:nameLanguage a owl:DatatypeProperty . }""" ;
    gmeow:saRationale "gmeow:nameLanguage MUST NOT be owl:DatatypeProperty -- Language is always a first-class gmeow:Language individual, never a bare BCP-47 literal tag." .

# --- 14. Endonym and exonym are NamePurpose value individuals (MUST) ---------
ex:saEndonymExonymAreNamePurposeValues a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:namePurposeEndonym a gmeow:NamePurpose .
    gmeow:namePurposeExonym  a gmeow:NamePurpose .
}""" ;
    gmeow:saRationale "gmeow:namePurposeEndonym and gmeow:namePurposeExonym MUST be gmeow:NamePurpose individuals -- co-equal toponym purposes (value individuals), never a preferred-vs-alternate pair (Principle 9, anti-colonial)." .

# --- 15. NamePartType subclasses logic:QualityValue (MUST) -------------------
ex:saNamePartTypeSubclassQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NamePartType rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:NamePartType MUST be rdfs:subClassOf logic:QualityValue -- name-part kinds are an open value vocabulary of individuals (migrated: logic: not gufo:)." .

# --- 16. namePartType is an ObjectProperty (MUST) ----------------------------
ex:saNamePartTypePropertyFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:namePartType a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:namePartType MUST be an owl:ObjectProperty." .

# --- 17. Seven NamePartType multi-cultural seed individuals exist (MUST) ------
ex:saNamePartTypeSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:namePartGiven          a gmeow:NamePartType .
    gmeow:namePartSurname        a gmeow:NamePartType .
    gmeow:namePartPatronymic     a gmeow:NamePartType .
    gmeow:namePartNisba          a gmeow:NamePartType .
    gmeow:namePartMononym        a gmeow:NamePartType .
    gmeow:namePartPaternalSurname a gmeow:NamePartType .
    gmeow:namePartExtension      a gmeow:NamePartType .
}""" ;
    gmeow:saRationale "The seven multi-cultural NamePartType seed individuals (given, surname, patronymic, nisba, mononym, paternal surname, extension) MUST exist as gmeow:NamePartType individuals." .

# --- 18. Rejected per-kind subclasses must NOT exist as OWL classes ----------
ex:saNoPerKindSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?c { gmeow:GivenName gmeow:Surname gmeow:Patronymic gmeow:Mononym }
    ?c a owl:Class .
}""" ;
    gmeow:saRationale "The rejected flat-subclass names (GivenName, Surname, Patronymic, Mononym) MUST NOT exist as owl:Class -- name-part kinds are value individuals, not subclass trees (greenfield, no-backwards-compat)." .

# --- 19. NamePurpose subclasses logic:QualityValue (MUST) --------------------
ex:saNamePurposeSubclassQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:NamePurpose rdfs:subClassOf logic:QualityValue . }""" ;
    gmeow:saRationale "gmeow:NamePurpose MUST be rdfs:subClassOf logic:QualityValue -- flat value vocabulary (migrated)." .

# --- 20. NamePurpose sample seeds exist (MUST) --------------------------------
ex:saNamePurposeSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:namePurposeLegal  a gmeow:NamePurpose .
    gmeow:namePurposeChosen a gmeow:NamePurpose .
}""" ;
    gmeow:saRationale "gmeow:namePurposeLegal and gmeow:namePurposeChosen MUST exist as gmeow:NamePurpose individuals -- mandatory seeds for the purpose vocabulary." .

# --- 21. NameRegister subclasses logic:QualityValue (MUST) -------------------
ex:saNameRegisterSubclassQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:NameRegister rdfs:subClassOf logic:QualityValue . }""" ;
    gmeow:saRationale "gmeow:NameRegister MUST be rdfs:subClassOf logic:QualityValue -- open register value vocabulary (migrated)." .

# --- 22. NameRegister sample seeds exist (MUST) ------------------------------
ex:saNameRegisterSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:registerFormal   a gmeow:NameRegister .
    gmeow:registerIntimate a gmeow:NameRegister .
}""" ;
    gmeow:saRationale "gmeow:registerFormal and gmeow:registerIntimate MUST exist as gmeow:NameRegister individuals." .

# --- 23. Honorific subclasses logic:QualityValue (MUST) ----------------------
ex:saHonorificSubclassQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:Honorific rdfs:subClassOf logic:QualityValue . }""" ;
    gmeow:saRationale "gmeow:Honorific MUST be rdfs:subClassOf logic:QualityValue -- open address-title value vocabulary (migrated)." .

# --- 24. Honorific sample seeds exist (MUST) ---------------------------------
ex:saHonorificSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:honorificMx  a gmeow:Honorific .
    gmeow:honorificDr  a gmeow:Honorific .
    gmeow:honorificSan a gmeow:Honorific .
}""" ;
    gmeow:saRationale "gmeow:honorificMx, honorificDr, and honorificSan MUST exist as gmeow:Honorific individuals." .

# --- 25. PronounSet subclasses InformationObject (MUST) ----------------------
ex:saPronounSetSubclassInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:PronounSet rdfs:subClassOf gmeow:InformationObject . }""" ;
    gmeow:saRationale "gmeow:PronounSet MUST be rdfs:subClassOf gmeow:InformationObject -- a structured artifact (five pronoun forms), not a flat value space like the other vocabs." .

# --- 26. PronounSet sample seeds exist (MUST) --------------------------------
ex:saPronounSetSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:pronounSheHer  a gmeow:PronounSet .
    gmeow:pronounTheyThem a gmeow:PronounSet .
    gmeow:pronounXeXem   a gmeow:PronounSet .
    gmeow:pronounFaeFaer a gmeow:PronounSet .
    gmeow:pronounZeZir   a gmeow:PronounSet .
}""" ;
    gmeow:saRationale "The five PronounSet sample seeds (she/her, they/them, xe/xem, fae/faer, ze/zir) MUST exist as gmeow:PronounSet individuals." .

# --- 27. Five pronoun form properties are DatatypeProperties (MUST) ----------
ex:saPronounFormPropertiesFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:pronounSubject              a owl:DatatypeProperty .
    gmeow:pronounObject               a owl:DatatypeProperty .
    gmeow:pronounPossessiveDeterminer a owl:DatatypeProperty .
    gmeow:pronounPossessive           a owl:DatatypeProperty .
    gmeow:pronounReflexive            a owl:DatatypeProperty .
}""" ;
    gmeow:saRationale "All five pronoun form properties (subject, object, possessive determiner, possessive, reflexive) MUST be owl:DatatypeProperty." .

# --- 28. they/them set fills all five forms (MUST) ---------------------------
ex:saTheyThemFiveFormsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
ASK {
    gmeow:pronounTheyThem gmeow:pronounSubject ?sub .
    gmeow:pronounTheyThem gmeow:pronounObject ?obj .
    gmeow:pronounTheyThem gmeow:pronounPossessiveDeterminer ?pd .
    gmeow:pronounTheyThem gmeow:pronounPossessive ?pp .
    gmeow:pronounTheyThem gmeow:pronounReflexive ?refl .
}""" ;
    gmeow:saRationale "gmeow:pronounTheyThem MUST carry all five pronoun form values -- the canonical 'they' paradigm verifies the full-five-forms requirement." .

# --- 29. hasPronounSet ranges over PronounSet (MUST) -------------------------
ex:saHasPronounSetRangePronounSet a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:hasPronounSet rdfs:range gmeow:PronounSet . }""" ;
    gmeow:saRationale "gmeow:hasPronounSet MUST have rdfs:range gmeow:PronounSet." .

# --- 30. honorific ranges over Honorific (MUST) ------------------------------
ex:saHonorificRangeHonorific a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:honorific rdfs:range gmeow:Honorific . }""" ;
    gmeow:saRationale "gmeow:honorific MUST have rdfs:range gmeow:Honorific." .

# --- 31. No preferred/primary/canonical name terms exist (MUST-NOT) ----------
ex:saNoPreferredOrPrimaryNameTerm a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned {
        gmeow:preferredForDisplay gmeow:primaryName gmeow:canonicalName
        gmeow:isPrimaryName gmeow:preferredName
        gmeow:primaryAppellation gmeow:preferredAppellation
        gmeow:preferredUsage gmeow:preferredRank
    }
    { ?banned a owl:ObjectProperty }
    UNION { ?banned a owl:DatatypeProperty }
    UNION { ?banned a owl:AnnotationProperty }
    UNION { ?banned a owl:Class }
}""" ;
    gmeow:saRationale "None of the banned preferred/primary/canonical-name terms (preferredForDisplay, primaryName, canonicalName, isPrimaryName, preferredName, primaryAppellation, preferredAppellation, preferredUsage, preferredRank) MUST NOT exist as any OWL property or class -- co-equality is structural (anti-colonial tenet, Principle 9)." .

# --- 32. displayable is a non-functional DatatypeProperty (MUST) -------------
ex:saDisplayableIsDatatypeProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:displayable a owl:DatatypeProperty ;
        rdfs:range xsd:boolean .
}""" ;
    gmeow:saRationale "gmeow:displayable MUST be an owl:DatatypeProperty with rdfs:range xsd:boolean -- the only display-control in the model (suppression, not selection)." .

# --- 33. displayable is NOT functional (MUST-NOT) ----------------------------
ex:saDisplayableNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { ?rec logic:characterizes gmeow:displayable ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:displayable MUST NOT be owl:FunctionalProperty -- multi-source true/false claims must coexist rather than force a global OWL inconsistency (conflicts-coexist stance)." .

# --- 34. claimedMediaType and detectedMediaType are non-functional (MUST) -----
ex:saMediaTypePropertiesAreDatatype a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:claimedMediaType  a owl:DatatypeProperty ;
        rdfs:domain gmeow:Filename .
    gmeow:detectedMediaType a owl:DatatypeProperty ;
        rdfs:domain gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:claimedMediaType (domain Filename) and gmeow:detectedMediaType (domain InformationObject) MUST both be owl:DatatypeProperty -- claim vs. reality, coexisting non-functional." .

# --- 35. Neither media-type property is functional (MUST-NOT) ----------------
ex:saMediaTypePropertiesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p { gmeow:claimedMediaType gmeow:detectedMediaType }
    ?rec logic:characterizes ?p ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "gmeow:claimedMediaType and gmeow:detectedMediaType MUST NOT be owl:FunctionalProperty -- a mismatch is coexisting claims, not an inconsistency." .

# --- 36. No disjointness between the two media-type properties (MUST-NOT) ----
ex:saNoMediaTypeDisjointness a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:claimedMediaType owl:propertyDisjointWith gmeow:detectedMediaType .
}""" ;
    gmeow:saRationale "gmeow:claimedMediaType MUST NOT be owl:propertyDisjointWith gmeow:detectedMediaType -- benign aliasing must not make the graph inconsistent." .

# --- 37. Flat name-part properties must not exist (MUST-NOT) -----------------
ex:saNoFlatNamePartProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p {
        gmeow:givenName gmeow:familyName
        gmeow:givenNamePart gmeow:surnamePart gmeow:nameType
    }
    { ?p a owl:DatatypeProperty } UNION { ?p a owl:ObjectProperty }
}""" ;
    gmeow:saRationale "The retired flat literal duplicates (givenName, familyName, givenNamePart, surnamePart, nameType) MUST NOT exist as DatatypeProperty or ObjectProperty -- greenfield: name components are ALWAYS the typed gmeow:NamePart." .

# --- 38. PersonName is under Appellation, NOT InformationObject directly ------
ex:saPersonNameUnderAppellation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PersonName a owl:Class ;
        rdfs:subClassOf gmeow:Appellation .
}""" ;
    gmeow:saRationale "gmeow:PersonName MUST be an owl:Class rdfs:subClassOf gmeow:Appellation -- re-homed from genealogy; declared exactly once." .

# --- 39. PersonName is NOT directly under InformationObject (MUST-NOT) -------
ex:saPersonNameNotDirectlyUnderInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PersonName rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:PersonName MUST NOT be asserted rdfs:subClassOf gmeow:InformationObject directly -- it was re-homed under gmeow:Appellation; a direct InformationObject link would be a double-definition regression." .

# --- 40. usageAudience is not bridged to accordingTo (MUST-NOT) --------------
ex:saAudienceNotSubpropertyAccordingTo a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:usageAudience rdfs:subPropertyOf gmeow:accordingTo . }""" ;
    gmeow:saRationale "gmeow:usageAudience MUST NOT be rdfs:subPropertyOf gmeow:accordingTo -- social scope and standpoint frame are orthogonal axes (the audience/standpoint distinction)." .

# --- 41. usageAudience and accordingTo are not equivalent (MUST-NOT) ---------
ex:saAudienceNotEquivalentAccordingTo a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:usageAudience owl:equivalentProperty gmeow:accordingTo . }""" ;
    gmeow:saRationale "gmeow:usageAudience MUST NOT be owl:equivalentProperty gmeow:accordingTo -- the audience/standpoint distinction is fundamental." .

# --- 42. hasOrganizationName is a full subproperty graft (MUST) ---------------
ex:saHasOrganizationNameSubproperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasOrganizationName a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:hasAppellation ;
        rdfs:domain gmeow:Organization ;
        rdfs:range gmeow:OrganizationName .
}""" ;
    gmeow:saRationale "gmeow:hasOrganizationName MUST be an owl:ObjectProperty rdfs:subPropertyOf gmeow:hasAppellation with domain gmeow:Organization and range gmeow:OrganizationName -- organization-scoped mirror of hasName." .

# --- 44. hasAgreementName is a full subproperty graft (MUST) -----------------
ex:saHasAgreementNameSubproperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasAgreementName a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:hasAppellation ;
        rdfs:domain gmeow:Agreement ;
        rdfs:range gmeow:AgreementName .
}""" ;
    gmeow:saRationale "gmeow:hasAgreementName MUST be an owl:ObjectProperty rdfs:subPropertyOf gmeow:hasAppellation with domain gmeow:Agreement and range gmeow:AgreementName -- agreement-scoped specialization." .

# --- 46. hasSoftwareName domain is NOT SoftwareProject (MUST-NOT) ------------
ex:saHasSoftwareNameNotDomainSoftwareProject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:hasSoftwareName rdfs:domain gmeow:SoftwareProject . }""" ;
    gmeow:saRationale "gmeow:hasSoftwareName MUST NOT have rdfs:domain gmeow:SoftwareProject -- domain is inherited from hasAppellation (Entity) so both projects and products can bear software names." .

# --- 47. nameLanguage has domain Appellation (MUST) --------------------------
ex:saNameLanguageDomainAppellation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:nameLanguage rdfs:domain gmeow:Appellation . }""" ;
    gmeow:saRationale "gmeow:nameLanguage MUST have rdfs:domain gmeow:Appellation -- declared on the superclass so all subclasses inherit it." .

# --- 48. Register spine lives in names core (MUST) ---------------------------
ex:saRegisterSpineLivesInNamesCore a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Register a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
    gmeow:NameRegister rdfs:subClassOf gmeow:Register .
    gmeow:registerFormal a gmeow:NameRegister .
}""" ;
    gmeow:saRationale "gmeow:Register MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue in the names-core slice; gmeow:NameRegister MUST specialize it; and the seed gmeow:registerFormal MUST be a gmeow:NameRegister." .

# --- 49. PlaceName is a SubKind subclass of Appellation (MUST) ----------------
ex:saPlaceNameIsSubKindAppellation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PlaceName a owl:Class , logic:SubKind ;
        rdfs:subClassOf gmeow:Appellation .
}""" ;
    gmeow:saRationale "gmeow:PlaceName MUST be an owl:Class typed logic:SubKind and a subclass of gmeow:Appellation -- the structured replacement for the retired flat alternateName." .

# --- 50. The retired alternateName literal property does NOT exist (MUST-NOT) -
ex:saAlternateNameRetired a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?t { owl:DatatypeProperty owl:ObjectProperty }
    gmeow:alternateName a ?t .
}""" ;
    gmeow:saRationale "The retired flat gmeow:alternateName MUST NOT exist as an owl:DatatypeProperty or owl:ObjectProperty -- place naming is carried by gmeow:hasPlaceName -> gmeow:PlaceName (greenfield, Principle 6)." .

# --- 51. hasNamePart specializes the universal hasPart spine (MUST) ------------
ex:saHasNamePartSpecializesHasPart a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasNamePart rdfs:subPropertyOf gmeow:hasPart .
}""" ;
    gmeow:saRationale "gmeow:hasNamePart MUST be rdfs:subPropertyOf gmeow:hasPart -- name decomposition specializes the universal has-part spine." .

# --- 52. appellationDenotation is the lang:Denotation graft seam (MUST) --------
#     Task-4 floor: the naming→referent bridge is grounded in the lang: layer.
ex:saAppellationDenotationGraft a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX lang: <https://blackcatinformatics.ca/lang/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:appellationDenotation a owl:ObjectProperty ;
        rdfs:domain gmeow:Appellation ;
        rdfs:range lang:Denotation .
}""" ;
    gmeow:saRationale "gmeow:appellationDenotation MUST be an owl:ObjectProperty with domain gmeow:Appellation and range lang:Denotation -- the Task-4 floor graft (Principle 19): an appellation's form denotes its bearer through a reified lang:Denotation, so the names slice reuses the lang: reference corner rather than minting a local meaning record." .

# --- 53. nameScript is regrounded onto lang:Script (MUST) ---------------------
#     Task-4 REGROUNDING: nameScript migrates from a bare ISO 15924 literal to a
#     first-class lang:Script object property.
ex:saNameScriptRegroundedToLangScript a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX lang: <https://blackcatinformatics.ca/lang/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:nameScript a owl:ObjectProperty ;
        rdfs:domain gmeow:Appellation ;
        rdfs:range lang:Script .
}""" ;
    gmeow:saRationale "gmeow:nameScript MUST be an owl:ObjectProperty with domain gmeow:Appellation and range lang:Script -- regrounded (Principle 19) from a bare ISO 15924 literal onto the first-class lang:Script individual, whose code rides skos:notation, so script identity is shared with the writing-system / notation graft." .

# --- 54. nameScript is NOT a DatatypeProperty (MUST-NOT) ----------------------
ex:saNameScriptNotDatatypeProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:nameScript a owl:DatatypeProperty . }""" ;
    gmeow:saRationale "gmeow:nameScript MUST NOT be an owl:DatatypeProperty -- the bare ISO 15924 literal carrier is retired under the lang: graft; script is always a first-class lang:Script individual, never an opaque code string." .
