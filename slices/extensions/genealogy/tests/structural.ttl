#
# Declarative structural assertions for the genealogy slice -- the
# slice-resident test-DSL twin of the asserted-TBox MUST invariants formerly
# hand-written in tests/test_genealogy.py. Each assertion runs as a SPARQL ASK
# over the genealogy module graph (gmeow:scopeModule) under the native Rust
# slicetest harness (crates/slicetest).
#
# Genealogy is migrated: class stereotypes are logic: (logic:SubKind,
# logic:Relator), not gufo:.
#
# KinRelationship bridges (relationshipParent / relationshipChild / hasPartner
# subPropertyOf observedFeature) are home-local here and are migrated in cells
# 4-6 below; the observations structural.ttl cell 7 deferred them here
# explicitly.
#
# The whole-ontology negative sweeps and the SHACL fixture-conformance + ABox
# checks now live natively in crates/validate/tests/conformance_cases/conformance_genealogy.rs
# (former_event_subclasses_are_not_reintroduced and
# no_preferred_or_primary_genealogy_term via GraphStore::ontology(); the
# contested/withdrawn conform cases + GraphStore ABox twins over
# coverage/genealogy-contested.ttl).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/genealogy/tests/> .

# --- 1. Family is a logic:SubKind owl:Class subclassing gmeow:Group (MUST) ----
ex:saFamilyIsSubKindGroup a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Family a owl:Class , logic:SubKind ;
        rdfs:subClassOf gmeow:Group .
}""" ;
    gmeow:saRationale "gmeow:Family MUST be an owl:Class typed logic:SubKind and a subclass of gmeow:Group -- a Family is a SubKind of Group (kinship group of persons related by descent, marriage, or adoption)." .

# --- 2. KinRelationship is a logic:SubKind subclassing logic:Relator (MUST) ---
ex:saKinRelationshipIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:KinRelationship a owl:Class , logic:SubKind ;
        rdfs:subClassOf logic:Relator ;
        rdfs:subClassOf gmeow:Observation .
}""" ;
    gmeow:saRationale "gmeow:KinRelationship MUST be an owl:Class typed logic:SubKind with rdfs:subClassOf logic:Relator and gmeow:Observation -- the observation-spine bridge makes kinship a reified claim-from-a-vantage." .

# --- 3. ParentChildRelationship subclasses KinRelationship (MUST) ------------
ex:saParentChildRelationshipIsKinRelationship a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ParentChildRelationship a owl:Class , logic:SubKind ;
        rdfs:subClassOf gmeow:KinRelationship .
}""" ;
    gmeow:saRationale "gmeow:ParentChildRelationship MUST be an owl:Class typed logic:SubKind and a subclass of gmeow:KinRelationship -- the typed specialisation of a kin bond that carries a parent and a child role." .

# --- 4. relationshipParent subPropertyOf observedFeature (MUST) --
ex:saRelationshipParentBridge a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:relationshipParent a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:observedFeature ;
        rdfs:domain gmeow:ParentChildRelationship ;
        rdfs:range gmeow:Person .
}""" ;
    gmeow:saRationale "gmeow:relationshipParent MUST be an owl:ObjectProperty with rdfs:subPropertyOf gmeow:observedFeature, domain ParentChildRelationship, and range Person -- the parent role exposes the parent as an observation feature so the universal query path sees it." .

# --- 5. relationshipChild subPropertyOf observedFeature (MUST) ---
ex:saRelationshipChildBridge a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:relationshipChild a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:observedFeature ;
        rdfs:domain gmeow:ParentChildRelationship ;
        rdfs:range gmeow:Person .
}""" ;
    gmeow:saRationale "gmeow:relationshipChild MUST be an owl:ObjectProperty with rdfs:subPropertyOf gmeow:observedFeature, domain ParentChildRelationship, and range Person -- symmetrical to relationshipParent; exposes the child end as an observation feature." .

# --- 6. hasPartner subPropertyOf observedFeature (MUST) ----------------------
ex:saHasPartnerBridge a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasPartner a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:observedFeature ;
        rdfs:domain gmeow:CoupleRelationship ;
        rdfs:range gmeow:Person .
}""" ;
    gmeow:saRationale "gmeow:hasPartner MUST be an owl:ObjectProperty with rdfs:subPropertyOf gmeow:observedFeature, domain CoupleRelationship, and range Person -- partners are co-observed features of the couple observation so the universal query path sees them; non-functional because a couple has two partners." .

# --- 7. Genealogy kinship properties are subproperties of connectsTo (MUST) ---
ex:saGenealogySubpropertiesOfConnectsTo a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasSpouse  rdfs:subPropertyOf gmeow:connectsTo .
    gmeow:hasSibling rdfs:subPropertyOf gmeow:connectsTo .
    gmeow:hasParent  rdfs:subPropertyOf gmeow:connectsTo .
    gmeow:hasChild   rdfs:subPropertyOf gmeow:connectsTo .
}""" ;
    gmeow:saRationale "gmeow:hasSpouse, hasSibling, hasParent, and hasChild MUST each be rdfs:subPropertyOf gmeow:connectsTo -- kinship links are specializations of the universal connectivity spine." .
