# Disclosure control by generalization (#72, P10) + granularity axis (#79) — by reference.
gmeow:eqProperties055 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:coarsenTo ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject dpv:Generalisation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "DPV Generalisation (reduce granularity/precision by grouping or rounding) — the privacy-technique counterpart of the gmeow:coarsenTo projection-time directive; the seam to PRIV-GEN (#73)" ;
    gmeow:sssomFile "gmeow-properties.sssom.tsv" .

gmeow:eqProperties056 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:coarserThan ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject skos:broader ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "SKOS broader — the generic hierarchical-order counterpart of the granularity-level ordering gmeow:coarserThan" ;
    gmeow:sssomFile "gmeow-properties.sssom.tsv" .
