-                    Node::Iri(i) => ShapeValue::Iri(i),
-                    Node::Lit(literal) => ShapeValue::Literal(literal),
-                    _ => return None,
-                };
-                Some(ConstraintComponent::Not(Box::new(
-                    ConstraintComponent::HasValue(sv),
-                )))
