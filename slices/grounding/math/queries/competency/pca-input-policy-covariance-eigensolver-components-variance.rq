# Competency question: "What input, centering policy, covariance operator, and
# eigensolver produced these principal components, and what variance do they
# explain?" Exercises the hard rule that a math:PCAAnalysis declares its inputs,
# policy, and outputs. Scoped to the fixture namespace so the answer is exactly
# {pca -> resid, meanCentered, cov, svd, pc1, ev1}.
PREFIX math: <https://blackcatinformatics.ca/math/>

SELECT ?analysis ?input ?centering ?covariance ?eigensolver ?component ?variance WHERE {
    ?analysis a math:PCAAnalysis ;
              math:analysisInput ?input ;
              math:centeringPolicy ?centering ;
              math:covarianceOperator ?covariance ;
              math:eigensolver ?eigensolver ;
              math:principalComponent ?component ;
              math:explainedVarianceRatio ?variance .
    FILTER(STRSTARTS(STR(?analysis), "http://example.org/math/"))
}
ORDER BY ?analysis ?component
