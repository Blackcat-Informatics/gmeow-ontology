msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeWorldNotificationRecorded|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Classify the actual Event or Activity with eventType eventTypeWorldNotificationRecorded; attribute the exact source statement."
msgstr "Classer l’Event ou l’Activity réel avec eventType eventTypeWorldNotificationRecorded ; attribuer l’énoncé source exact."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeWorldNotificationRecorded|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This is an EventType value for world notice recorded, not an occurrence or an executable operation."
msgstr "Il s’agit d’une valeur EventType pour « avis du monde enregistré », non d’une occurrence ni d’une opération exécutable."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeWorldNotificationRecorded|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:occurrence a gmeow:Event ; gmeow:eventType gmeow:eventTypeWorldNotificationRecorded ."
msgstr "Par exemple : ex:occurrence a gmeow:Event ; gmeow:eventType gmeow:eventTypeWorldNotificationRecorded ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeWorldNotificationDelivery|http://www.w3.org/2000/01/rdf-schema#label"
msgid "world notice delivery occurrence"
msgstr "occurrence de livraison d’avis du monde"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeWorldNotificationDelivery|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reports a notice-delivery occurrence, which may be an attempt or actual delivery."
msgstr "La source rapporte une occurrence de livraison d’avis, pouvant être tentative ou livraison réelle."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeWorldNotificationDelivery|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the recorded world notice delivery occurrence."
msgstr "À employer pour une occurrence enregistrée de livraison d’avis du monde."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeWorldNotificationDelivery|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Retain noticeDeliveryState separately; the event kind alone does not prove receipt."
msgstr "Conserver noticeDeliveryState séparément ; le type d’événement seul ne prouve pas la réception."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeWorldNotificationDelivery|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Classify the actual Event or Activity with eventType eventTypeWorldNotificationDelivery; attribute the exact source statement."
msgstr "Classer l’Event ou l’Activity réel avec eventType eventTypeWorldNotificationDelivery ; attribuer l’énoncé source exact."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeWorldNotificationDelivery|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This is an EventType value for world notice delivery occurrence, not an occurrence or an executable operation."
msgstr "Il s’agit d’une valeur EventType pour « occurrence de livraison d’avis du monde », non d’une occurrence ni d’une opération exécutable."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeWorldNotificationDelivery|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:occurrence a gmeow:Event ; gmeow:eventType gmeow:eventTypeWorldNotificationDelivery ."
msgstr "Par exemple : ex:occurrence a gmeow:Event ; gmeow:eventType gmeow:eventTypeWorldNotificationDelivery ."

msgctxt "https://blackcatinformatics.ca/gmeow/messageKindWorldNotice|http://www.w3.org/2000/01/rdf-schema#label"
msgid "world notice message"
msgstr "message d’avis du monde"

msgctxt "https://blackcatinformatics.ca/gmeow/messageKindWorldNotice|http://www.w3.org/2004/02/skos/core#definition"
msgid "A communicative notice intended by an environment for an agent within it. The Message kind records purpose without asserting dispatch or receipt."
msgstr "Avis communicatif destiné par un environnement à un agent qui s’y trouve. Ce type Message enregistre le but sans affirmer envoi ni réception."

msgctxt "https://blackcatinformatics.ca/gmeow/messageKindWorldNotice|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for a retained environment notice, including one not yet sent."
msgstr "À employer pour un avis d’environnement conservé, même non encore envoyé."

msgctxt "https://blackcatinformatics.ca/gmeow/messageKindWorldNotice|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating a notice artifact as its delivery Event or as proof of its content."
msgstr "Éviter de traiter l’artefact d’avis comme son Event de livraison ou une preuve de son contenu."

msgctxt "https://blackcatinformatics.ca/gmeow/messageKindWorldNotice|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Classify the actual Message through hasMessageKind and retain noticeKind and delivery reports independently."
msgstr "Classer le Message réel par hasMessageKind et conserver séparément noticeKind et rapports de livraison."

msgctxt "https://blackcatinformatics.ca/gmeow/messageKindWorldNotice|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This kind overlaps other MessageKind values without forcing email semantics."
msgstr "Ce type peut recouper d’autres valeurs MessageKind sans imposer de sémantique de courriel."

msgctxt "https://blackcatinformatics.ca/gmeow/messageKindWorldNotice|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:notice a gmeow:Message ; gmeow:hasMessageKind gmeow:messageKindWorldNotice ."
msgstr "Par exemple : ex:notice a gmeow:Message ; gmeow:hasMessageKind gmeow:messageKindWorldNotice ."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeKind|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Notice Kind"
msgstr "Type d’avis"

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeKind|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary for the reported topic of an environment notice."
msgstr "Vocabulaire ouvert du sujet rapporté d’un avis d’environnement."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeKind|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify notice kind values supplied by a source."
msgstr "À employer pour classer les valeurs « Type d’avis » fournies par une source."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeKind|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid replacing NoticeKind individuals with event or object subclasses."
msgstr "Éviter de remplacer les individus NoticeKind par des sous-classes d’événement ou d’objet."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeKind|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach a typed value through noticeKind; keep independent attributed classifications."
msgstr "Joindre une valeur typée par noticeKind ; conserver les classifications attribuées indépendantes."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeKind|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "The notice kind vocabulary stays open; absence supplies no default member."
msgstr "Le vocabulaire « Type d’avis » reste ouvert ; l’absence ne fournit aucun membre par défaut."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeKind|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:localValue a gmeow:NoticeKind ."
msgstr "Par exemple : ex:localValue a gmeow:NoticeKind ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKind|http://www.w3.org/2000/01/rdf-schema#label"
msgid "notice kind"
msgstr "type d’avis"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKind|http://www.w3.org/2004/02/skos/core#definition"
msgid "Relates a Message notice to its source-reported environment topic."
msgstr "Relie un Message d’avis à son sujet d’environnement rapporté."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKind|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the topic of an actual environment notice."
msgstr "À employer pour le sujet d’un avis réel d’environnement."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKind|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating notice content as verified fulfillment, recovery or delivery."
msgstr "Éviter de traiter le contenu d’avis comme satisfaction, rétablissement ou livraison vérifiés."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKind|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Classify the Message with hasMessageKind messageKindWorldNotice and retain supplied NoticeKind values."
msgstr "Classer le Message par hasMessageKind messageKindWorldNotice et conserver les NoticeKind fournis."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKind|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Topics may overlap; no preferred topic or missing-field default is supplied."
msgstr "Les sujets peuvent se recouper ; aucun sujet préféré ni défaut de champ absent n’est fourni."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKind|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:notice a gmeow:Message ; gmeow:hasMessageKind gmeow:messageKindWorldNotice ; gmeow:noticeKind gmeow:noticeKindGiftOffered ."
msgstr "Par exemple : ex:notice a gmeow:Message ; gmeow:hasMessageKind gmeow:messageKindWorldNotice ; gmeow:noticeKind gmeow:noticeKindGiftOffered ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindGiftOffered|http://www.w3.org/2000/01/rdf-schema#label"
msgid "gift offered notice"
msgstr "avis de cadeau offert"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindGiftOffered|http://www.w3.org/2004/02/skos/core#definition"
msgid "The notice reports a gift offered to an agent."
msgstr "L’avis rapporte un cadeau offert à un agent."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindGiftOffered|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit gift offered notice classification."
msgstr "À employer pour la classification explicite « avis de cadeau offert » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindGiftOffered|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "An offer is not acceptance, possession or completed delivery."
msgstr "Une offre n’est ni acceptation, ni possession, ni livraison achevée."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindGiftOffered|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeKind individual through noticeKind, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeKind par noticeKind, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindGiftOffered|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This gift offered notice value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « avis de cadeau offert » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindGiftOffered|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeKind gmeow:noticeKindGiftOffered ."
msgstr "Par exemple : ex:record gmeow:noticeKind gmeow:noticeKindGiftOffered ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestCreated|http://www.w3.org/2000/01/rdf-schema#label"
msgid "request created notice"
msgstr "avis de demande créée"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestCreated|http://www.w3.org/2004/02/skos/core#definition"
msgid "The notice reports recording an agent's request."
msgstr "L’avis rapporte l’enregistrement d’une demande de l’agent."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestCreated|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit request created notice classification."
msgstr "À employer pour la classification explicite « avis de demande créée » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestCreated|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Request recording does not establish fulfillment or a commitment to act."
msgstr "Enregistrer une demande n’établit ni exécution ni engagement à agir."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestCreated|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeKind individual through noticeKind, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeKind par noticeKind, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestCreated|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This request created notice value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « avis de demande créée » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestCreated|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeKind gmeow:noticeKindRequestCreated ."
msgstr "Par exemple : ex:record gmeow:noticeKind gmeow:noticeKindRequestCreated ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestFulfilled|http://www.w3.org/2000/01/rdf-schema#label"
msgid "request fulfilled notice"
msgstr "avis de demande satisfaite"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestFulfilled|http://www.w3.org/2004/02/skos/core#definition"
msgid "The notice reports fulfillment of an agent's request."
msgstr "L’avis rapporte la satisfaction d’une demande de l’agent."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestFulfilled|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit request fulfilled notice classification."
msgstr "À employer pour la classification explicite « avis de demande satisfaite » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestFulfilled|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Keep the notice separate from actual RequestFulfillment and criterion evidence."
msgstr "Séparer l’avis du RequestFulfillment réel et des preuves de critères."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestFulfilled|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeKind individual through noticeKind, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeKind par noticeKind, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestFulfilled|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This request fulfilled notice value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « avis de demande satisfaite » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestFulfilled|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeKind gmeow:noticeKindRequestFulfilled ."
msgstr "Par exemple : ex:record gmeow:noticeKind gmeow:noticeKindRequestFulfilled ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestWithdrawn|http://www.w3.org/2000/01/rdf-schema#label"
msgid "request withdrawn notice"
msgstr "avis de demande retirée"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestWithdrawn|http://www.w3.org/2004/02/skos/core#definition"
msgid "The notice reports withdrawal of an agent's request."
msgstr "L’avis rapporte le retrait d’une demande de l’agent."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestWithdrawn|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit request withdrawn notice classification."
msgstr "À employer pour la classification explicite « avis de demande retirée » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestWithdrawn|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Withdrawal preserves the original request and does not prove the requested work never occurred."
msgstr "Le retrait conserve la demande originale et ne prouve pas que le travail n’a jamais eu lieu."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestWithdrawn|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeKind individual through noticeKind, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeKind par noticeKind, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestWithdrawn|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This request withdrawn notice value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « avis de demande retirée » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestWithdrawn|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeKind gmeow:noticeKindRequestWithdrawn ."
msgstr "Par exemple : ex:record gmeow:noticeKind gmeow:noticeKindRequestWithdrawn ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldDegraded|http://www.w3.org/2000/01/rdf-schema#label"
msgid "world degraded notice"
msgstr "avis de monde dégradé"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldDegraded|http://www.w3.org/2004/02/skos/core#definition"
msgid "The notice reports degradation of the environment."
msgstr "L’avis rapporte une dégradation de l’environnement."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldDegraded|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit world degraded notice classification."
msgstr "À employer pour la classification explicite « avis de monde dégradé » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldDegraded|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "The notice is not itself the environment transition or a verified health measurement."
msgstr "L’avis n’est ni la transition d’environnement ni une mesure de santé vérifiée."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldDegraded|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeKind individual through noticeKind, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeKind par noticeKind, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldDegraded|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This world degraded notice value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « avis de monde dégradé » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldDegraded|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeKind gmeow:noticeKindWorldDegraded ."
msgstr "Par exemple : ex:record gmeow:noticeKind gmeow:noticeKindWorldDegraded ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldRecovered|http://www.w3.org/2000/01/rdf-schema#label"
msgid "world recovered notice"
msgstr "avis de monde rétabli"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldRecovered|http://www.w3.org/2004/02/skos/core#definition"
msgid "The notice reports recovery from a degraded environment state."
msgstr "L’avis rapporte un rétablissement après un état dégradé de l’environnement."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldRecovered|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit world recovered notice classification."
msgstr "À employer pour la classification explicite « avis de monde rétabli » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldRecovered|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Retain the source's recovery claim without inferring permanent health."
msgstr "Conserver le rétablissement rapporté sans déduire de santé permanente."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldRecovered|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeKind individual through noticeKind, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeKind par noticeKind, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldRecovered|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This world recovered notice value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « avis de monde rétabli » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindWorldRecovered|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeKind gmeow:noticeKindWorldRecovered ."
msgstr "Par exemple : ex:record gmeow:noticeKind gmeow:noticeKindWorldRecovered ."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeDeliveryState|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Notice Delivery State"
msgstr "État de livraison d’avis"

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeDeliveryState|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary for a notice's or one delivery attempt's reported recipient-reaching state."
msgstr "Vocabulaire ouvert de l’état rapporté d’acheminement au destinataire d’un avis ou d’une tentative."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeDeliveryState|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify notice delivery state values supplied by a source."
msgstr "À employer pour classer les valeurs « État de livraison d’avis » fournies par une source."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeDeliveryState|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid replacing NoticeDeliveryState individuals with event or object subclasses."
msgstr "Éviter de remplacer les individus NoticeDeliveryState par des sous-classes d’événement ou d’objet."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeDeliveryState|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach a typed value through noticeDeliveryState; keep independent attributed classifications."
msgstr "Joindre une valeur typée par noticeDeliveryState ; conserver les classifications attribuées indépendantes."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeDeliveryState|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "The notice delivery state vocabulary stays open; absence supplies no default member."
msgstr "Le vocabulaire « État de livraison d’avis » reste ouvert ; l’absence ne fournit aucun membre par défaut."

msgctxt "https://blackcatinformatics.ca/gmeow/NoticeDeliveryState|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:localValue a gmeow:NoticeDeliveryState ."
msgstr "Par exemple : ex:localValue a gmeow:NoticeDeliveryState ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryState|http://www.w3.org/2000/01/rdf-schema#label"
msgid "notice delivery state"
msgstr "état de livraison d’avis"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryState|http://www.w3.org/2004/02/skos/core#definition"
msgid "The reported recipient-reaching state of a notice Message or one actual delivery Activity, keeping separate attempts distinct."
msgstr "État rapporté d’acheminement d’un Message d’avis ou d’une Activity de livraison réelle, distinguant les tentatives."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryState|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for an explicit delivery report, including explicit uncertainty."
msgstr "À employer pour un rapport explicite de livraison, y compris l’incertitude explicite."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryState|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid applying one attempt's result to all attempts or inferring delivery from event typing."
msgstr "Éviter d’appliquer le résultat d’une tentative à toutes ou de déduire la livraison du type d’événement."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryState|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Use a Message notice or a delivery Activity linked by affectsObject to the actual notice."
msgstr "Employer un Message d’avis ou une Activity de livraison reliée par affectsObject à l’avis réel."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryState|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "A property-guarded native law checks the union carrier and attempt binding; no seed value is a default."
msgstr "Une loi native à garde de propriété contrôle le porteur union et le lien de tentative ; aucune valeur initiale n’est par défaut."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryState|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:delivery a gmeow:Activity ; gmeow:eventType gmeow:eventTypeWorldNotificationDelivery ; gmeow:affectsObject ex:notice ; gmeow:noticeDeliveryState gmeow:noticeDeliveryStateAttempted ."
msgstr "Par exemple : ex:delivery a gmeow:Activity ; gmeow:eventType gmeow:eventTypeWorldNotificationDelivery ; gmeow:affectsObject ex:notice ; gmeow:noticeDeliveryState gmeow:noticeDeliveryStateAttempted ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|http://www.w3.org/2000/01/rdf-schema#label"
msgid "notice delivery pending"
msgstr "livraison d’avis en attente"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reports the notice not yet delivered in this delivery context."
msgstr "La source rapporte l’avis non encore livré dans ce contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit notice delivery pending classification."
msgstr "À employer pour la classification explicite « livraison d’avis en attente » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Pending does not mean no attempt ever occurred or that later delivery is guaranteed."
msgstr "En attente ne signifie ni absence de toute tentative ni livraison ultérieure garantie."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeDeliveryState individual through noticeDeliveryState, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeDeliveryState par noticeDeliveryState, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This notice delivery pending value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « livraison d’avis en attente » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStatePending ."
msgstr "Par exemple : ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStatePending ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|http://www.w3.org/2000/01/rdf-schema#label"
msgid "notice delivery attempted"
msgstr "livraison d’avis tentée"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reports a notice-delivery attempt."
msgstr "La source rapporte une tentative de livraison d’avis."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit notice delivery attempted classification."
msgstr "À employer pour la classification explicite « livraison d’avis tentée » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Attempted is distinct from delivered, failed and unknown delivery."
msgstr "Une tentative diffère d’une livraison, d’un échec et d’une livraison inconnue."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeDeliveryState individual through noticeDeliveryState, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeDeliveryState par noticeDeliveryState, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This notice delivery attempted value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « livraison d’avis tentée » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStateAttempted ."
msgstr "Par exemple : ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStateAttempted ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDelivered|http://www.w3.org/2000/01/rdf-schema#label"
msgid "notice delivered"
msgstr "avis livré"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDelivered|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reports the notice reaching its intended recipient."
msgstr "La source rapporte que l’avis a atteint son destinataire prévu."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDelivered|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit notice delivered classification."
msgstr "À employer pour la classification explicite « avis livré » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDelivered|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Delivery does not prove reading, comprehension, authentication or all-attempt success."
msgstr "La livraison ne prouve ni lecture, ni compréhension, ni authentification, ni réussite de toutes les tentatives."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDelivered|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeDeliveryState individual through noticeDeliveryState, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeDeliveryState par noticeDeliveryState, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDelivered|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This notice delivered value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « avis livré » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDelivered|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStateDelivered ."
msgstr "Par exemple : ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStateDelivered ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateFailed|http://www.w3.org/2000/01/rdf-schema#label"
msgid "notice delivery failed"
msgstr "livraison d’avis échouée"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateFailed|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reports that this notice delivery did not reach its recipient."
msgstr "La source rapporte que cette livraison d’avis n’a pas atteint son destinataire."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateFailed|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit notice delivery failed classification."
msgstr "À employer pour la classification explicite « livraison d’avis échouée » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateFailed|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "A failed attempt does not erase an independently delivered attempt."
msgstr "Une tentative échouée n’efface pas une tentative indépendante livrée."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateFailed|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeDeliveryState individual through noticeDeliveryState, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeDeliveryState par noticeDeliveryState, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateFailed|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This notice delivery failed value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « livraison d’avis échouée » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateFailed|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStateFailed ."
msgstr "Par exemple : ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStateFailed ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDeliveryUncertain|http://www.w3.org/2000/01/rdf-schema#label"
msgid "notice delivery uncertain"
msgstr "livraison d’avis incertaine"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDeliveryUncertain|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source explicitly reports uncertainty about whether this notice delivery reached its recipient."
msgstr "La source rapporte explicitement l’incertitude sur l’arrivée de cette livraison d’avis."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDeliveryUncertain|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit notice delivery uncertain classification."
msgstr "À employer pour la classification explicite « livraison d’avis incertaine » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDeliveryUncertain|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Explicit uncertainty is a supplied state; a missing field must not be filled with it."
msgstr "L’incertitude explicite est un état fourni ; un champ absent ne doit pas en être rempli."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDeliveryUncertain|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeDeliveryState individual through noticeDeliveryState, retaining the exact claim's source context."
msgstr "Référencer cet individu NoticeDeliveryState par noticeDeliveryState, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDeliveryUncertain|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This notice delivery uncertain value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « livraison d’avis incertaine » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDeliveryUncertain|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStateDeliveryUncertain ."
msgstr "Par exemple : ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStateDeliveryUncertain ."

msgctxt "https://blackcatinformatics.ca/gmeow/EnvironmentStatus|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Environment Status"
msgstr "État de santé de l’environnement"

msgctxt "https://blackcatinformatics.ca/gmeow/EnvironmentStatus|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary for source-reported environment health under its local operating expectations."
msgstr "Vocabulaire ouvert de santé d’environnement rapportée selon les attentes locales de fonctionnement."

msgctxt "https://blackcatinformatics.ca/gmeow/EnvironmentStatus|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify environment status values supplied by a source."
msgstr "À employer pour classer les valeurs « État de santé de l’environnement » fournies par une source."

msgctxt "https://blackcatinformatics.ca/gmeow/EnvironmentStatus|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid replacing EnvironmentStatus individuals with event or object subclasses."
msgstr "Éviter de remplacer les individus EnvironmentStatus par des sous-classes d’événement ou d’objet."

msgctxt "https://blackcatinformatics.ca/gmeow/EnvironmentStatus|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach a typed value through stateTo; keep independent attributed classifications."
msgstr "Joindre une valeur typée par stateTo ; conserver les classifications attribuées indépendantes."

msgctxt "https://blackcatinformatics.ca/gmeow/EnvironmentStatus|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "The environment status vocabulary stays open; absence supplies no default member."
msgstr "Le vocabulaire « État de santé de l’environnement » reste ouvert ; l’absence ne fournit aucun membre par défaut."

msgctxt "https://blackcatinformatics.ca/gmeow/EnvironmentStatus|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:localValue a gmeow:EnvironmentStatus ."
msgstr "Par exemple : ex:localValue a gmeow:EnvironmentStatus ."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusHealthy|http://www.w3.org/2000/01/rdf-schema#label"
msgid "environment healthy"
msgstr "environnement sain"

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusHealthy|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reports the environment working according to its local expectations."
msgstr "La source rapporte un environnement fonctionnant selon ses attentes locales."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusHealthy|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit environment healthy classification."
msgstr "À employer pour la classification explicite « environnement sain » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusHealthy|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Healthy is source-scoped and supplies no permanent or universal availability guarantee."
msgstr "La bonne santé est bornée par la source et ne garantit aucune disponibilité permanente ou universelle."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusHealthy|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this EnvironmentStatus individual through stateTo, retaining the exact claim's source context."
msgstr "Référencer cet individu EnvironmentStatus par stateTo, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusHealthy|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This environment healthy value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « environnement sain » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusHealthy|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:stateTo gmeow:environmentStatusHealthy ."
msgstr "Par exemple : ex:record gmeow:stateTo gmeow:environmentStatusHealthy ."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusDegraded|http://www.w3.org/2000/01/rdf-schema#label"
msgid "environment degraded"
msgstr "environnement dégradé"

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusDegraded|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reports the environment working poorly relative to its local expectations."
msgstr "La source rapporte un environnement fonctionnant mal selon ses attentes locales."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusDegraded|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit environment degraded classification."
msgstr "À employer pour la classification explicite « environnement dégradé » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusDegraded|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Degraded does not imply total failure or identify a failed provider by itself."
msgstr "La dégradation n’implique pas une panne totale et n’identifie pas seule un fournisseur défaillant."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusDegraded|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this EnvironmentStatus individual through stateTo, retaining the exact claim's source context."
msgstr "Référencer cet individu EnvironmentStatus par stateTo, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusDegraded|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This environment degraded value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « environnement dégradé » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/environmentStatusDegraded|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:stateTo gmeow:environmentStatusDegraded ."
msgstr "Par exemple : ex:record gmeow:stateTo gmeow:environmentStatusDegraded ."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionFrom|http://www.w3.org/2000/01/rdf-schema#label"
msgid "attention from"
msgstr "attention depuis"

msgctxt "https://blackcatinformatics.ca/gmeow/attentionFrom|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source-reported entity attention left during an Event."
msgstr "Entité que l’attention a quittée lors d’un Event selon la source."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionFrom|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the supplied departing focus of an attention transition."
msgstr "À employer pour le foyer quitté fourni d’une transition d’attention."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionFrom|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid substituting a movement's eventFromLocation for an attention endpoint."
msgstr "Éviter de substituer eventFromLocation d’un déplacement à une extrémité d’attention."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionFrom|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Point the actual Event to the previous Entity and attribute the claim."
msgstr "Relier l’Event réel à l’Entity précédente et attribuer l’énoncé."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionFrom|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Departure alone invents no destination or physical movement."
msgstr "Le départ seul n’invente ni destination ni déplacement physique."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionFrom|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:transition a gmeow:Event ; gmeow:attentionFrom ex:previousFocus ."
msgstr "Par exemple : ex:transition a gmeow:Event ; gmeow:attentionFrom ex:previousFocus ."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionTo|http://www.w3.org/2000/01/rdf-schema#label"
msgid "attention to"
msgstr "attention vers"

msgctxt "https://blackcatinformatics.ca/gmeow/attentionTo|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source-reported entity attention turned to during an Event."
msgstr "Entité vers laquelle l’attention s’est tournée lors d’un Event selon la source."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionTo|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the supplied arriving focus of an attention transition."
msgstr "À employer pour le foyer atteint fourni d’une transition d’attention."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionTo|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid substituting a movement's eventToLocation for an attention endpoint."
msgstr "Éviter de substituer eventToLocation d’un déplacement à une extrémité d’attention."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionTo|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Point the actual Event to the supplied next Entity without inventing the previous focus."
msgstr "Relier l’Event réel à l’Entity suivante fournie sans inventer le foyer précédent."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionTo|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "A focus endpoint proves neither physical location nor successful comprehension."
msgstr "Une extrémité d’attention ne prouve ni lieu physique ni compréhension réussie."

msgctxt "https://blackcatinformatics.ca/gmeow/attentionTo|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:transition a gmeow:Event ; gmeow:attentionTo ex:nextFocus ."
msgstr "Par exemple : ex:transition a gmeow:Event ; gmeow:attentionTo ex:nextFocus ."

msgctxt "https://blackcatinformatics.ca/gmeow/stateFrom|http://www.w3.org/2000/01/rdf-schema#label"
msgid "state from"
msgstr "état quitté"

msgctxt "https://blackcatinformatics.ca/gmeow/stateFrom|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source-reported quality-value state a transition Event left."
msgstr "État de valeur qualitative qu’un Event de transition a quitté selon la source."

msgctxt "https://blackcatinformatics.ca/gmeow/stateFrom|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for a transition's supplied previous state value."
msgstr "À employer pour la valeur d’état antérieur fournie d’une transition."

msgctxt "https://blackcatinformatics.ca/gmeow/stateFrom|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid mixing textual codes or affected objects with the QualityValue state axis."
msgstr "Éviter de mêler codes textuels ou objets affectés à l’axe d’état QualityValue."

msgctxt "https://blackcatinformatics.ca/gmeow/stateFrom|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Link Event to the actual logic:QualityValue individual it left."
msgstr "Relier l’Event à l’individu logic:QualityValue réel qu’il a quitté."

msgctxt "https://blackcatinformatics.ca/gmeow/stateFrom|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "A from-state infers neither its successor nor a universal state machine."
msgstr "Un état quitté ne déduit ni successeur ni machine d’états universelle."

msgctxt "https://blackcatinformatics.ca/gmeow/stateFrom|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:transition a gmeow:Event ; gmeow:stateFrom gmeow:environmentStatusDegraded ."
msgstr "Par exemple : ex:transition a gmeow:Event ; gmeow:stateFrom gmeow:environmentStatusDegraded ."

msgctxt "https://blackcatinformatics.ca/gmeow/stateTo|http://www.w3.org/2000/01/rdf-schema#label"
msgid "state to"
msgstr "état atteint"

msgctxt "https://blackcatinformatics.ca/gmeow/stateTo|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source-reported quality-value state a transition Event entered."
msgstr "État de valeur qualitative qu’un Event de transition a atteint selon la source."

msgctxt "https://blackcatinformatics.ca/gmeow/stateTo|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for a transition's supplied destination state value."
msgstr "À employer pour la valeur d’état destination fournie d’une transition."

msgctxt "https://blackcatinformatics.ca/gmeow/stateTo|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating the endpoint as the globally current winning state."
msgstr "Éviter de traiter l’extrémité comme état courant gagnant global."

msgctxt "https://blackcatinformatics.ca/gmeow/stateTo|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Link Event to the supplied logic:QualityValue; retain time and attribution separately."
msgstr "Relier l’Event au logic:QualityValue fourni ; conserver séparément temps et attribution."

msgctxt "https://blackcatinformatics.ca/gmeow/stateTo|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "No previous state, successful transition or permanent health follows from this field."
msgstr "Ce champ ne déduit ni état précédent, ni transition réussie, ni santé permanente."

msgctxt "https://blackcatinformatics.ca/gmeow/stateTo|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:transition a gmeow:Event ; gmeow:stateTo gmeow:environmentStatusHealthy ."
msgstr "Par exemple : ex:transition a gmeow:Event ; gmeow:stateTo gmeow:environmentStatusHealthy ."

msgctxt "https://blackcatinformatics.ca/gmeow/affectsObject|http://www.w3.org/2000/01/rdf-schema#label"
msgid "affects object"
msgstr "affecte un objet"

msgctxt "https://blackcatinformatics.ca/gmeow/affectsObject|http://www.w3.org/2004/02/skos/core#definition"
msgid "Relates an environment Activity to an actual entity it touched, announced, changed, exposed or placed, without certifying intended effects."
msgstr "Relie une Activity d’environnement à une entité réelle touchée, annoncée, modifiée, exposée ou placée, sans certifier les effets prévus."

msgctxt "https://blackcatinformatics.ca/gmeow/affectsObject|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for an activity's supplied affected-object inventory."
msgstr "À employer pour l’inventaire fourni d’objets affectés d’une activité."

msgctxt "https://blackcatinformatics.ca/gmeow/affectsObject|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating affected objects as performers or the inventory as globally complete."
msgstr "Éviter de traiter les objets affectés comme acteurs ou l’inventaire comme globalement complet."

msgctxt "https://blackcatinformatics.ca/gmeow/affectsObject|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Link Activity to each supplied Entity; name its performing agent independently with wasAssociatedWith."
msgstr "Relier l’Activity à chaque Entity fournie ; nommer séparément son acteur par wasAssociatedWith."

msgctxt "https://blackcatinformatics.ca/gmeow/affectsObject|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "A notice-delivery Activity may affect its Message without turning the Message into an Event."
msgstr "Une Activity de livraison d’avis peut affecter son Message sans transformer celui-ci en Event."

msgctxt "https://blackcatinformatics.ca/gmeow/affectsObject|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:announcement a gmeow:Activity ; gmeow:affectsObject ex:box, ex:shelf ."
msgstr "Par exemple : ex:announcement a gmeow:Activity ; gmeow:affectsObject ex:box, ex:shelf ."

msgctxt "https://blackcatinformatics.ca/gmeow/WorldDetailKind|http://www.w3.org/2000/01/rdf-schema#label"
msgid "World Detail Kind"
msgstr "Type de détail du monde"

msgctxt "https://blackcatinformatics.ca/gmeow/WorldDetailKind|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary for what a retained environment-detail description concerns."
msgstr "Vocabulaire ouvert de ce que concerne une description conservée de détail d’environnement."

msgctxt "https://blackcatinformatics.ca/gmeow/WorldDetailKind|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify world detail kind values supplied by a source."
msgstr "À employer pour classer les valeurs « Type de détail du monde » fournies par une source."

msgctxt "https://blackcatinformatics.ca/gmeow/WorldDetailKind|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid replacing WorldDetailKind individuals with event or object subclasses."
msgstr "Éviter de remplacer les individus WorldDetailKind par des sous-classes d’événement ou d’objet."

msgctxt "https://blackcatinformatics.ca/gmeow/WorldDetailKind|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach a typed value through worldDetailKind; keep independent attributed classifications."
msgstr "Joindre une valeur typée par worldDetailKind ; conserver les classifications attribuées indépendantes."

msgctxt "https://blackcatinformatics.ca/gmeow/WorldDetailKind|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "The world detail kind vocabulary stays open; absence supplies no default member."
msgstr "Le vocabulaire « Type de détail du monde » reste ouvert ; l’absence ne fournit aucun membre par défaut."

msgctxt "https://blackcatinformatics.ca/gmeow/WorldDetailKind|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:localValue a gmeow:WorldDetailKind ."
msgstr "Par exemple : ex:localValue a gmeow:WorldDetailKind ."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKind|http://www.w3.org/2000/01/rdf-schema#label"
msgid "world detail kind"
msgstr "type de détail du monde"

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKind|http://www.w3.org/2004/02/skos/core#definition"
msgid "Classifies an InformationObject detail record by the aspect of its environment subject it describes."
msgstr "Classe un détail InformationObject selon l’aspect décrit de son sujet d’environnement."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKind|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use on the retained detail description, separate from its subject."
msgstr "À employer sur la description de détail conservée, distincte de son sujet."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKind|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid typing the creating Activity as a detail document."
msgstr "Éviter de typer l’Activity créatrice comme document de détail."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKind|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach supplied WorldDetailKind values and retain actual source derivation separately."
msgstr "Joindre les WorldDetailKind fournis et conserver séparément la dérivation source réelle."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKind|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Several aspects may coexist without identity resolution, aesthetic preference or legal membership."
msgstr "Plusieurs aspects peuvent coexister sans identité résolue, préférence esthétique ou appartenance juridique."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKind|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:detail a gmeow:InformationObject ; gmeow:worldDetailKind gmeow:worldDetailKindAesthetic ."
msgstr "Par exemple : ex:detail a gmeow:InformationObject ; gmeow:worldDetailKind gmeow:worldDetailKindAesthetic ."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindAesthetic|http://www.w3.org/2000/01/rdf-schema#label"
msgid "aesthetic world detail"
msgstr "détail esthétique du monde"

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindAesthetic|http://www.w3.org/2004/02/skos/core#definition"
msgid "The detail describes how something looks or feels in the represented environment."
msgstr "Le détail décrit l’apparence ou la sensation de quelque chose dans l’environnement représenté."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindAesthetic|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit aesthetic world detail classification."
msgstr "À employer pour la classification explicite « détail esthétique du monde » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindAesthetic|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Aesthetic description does not establish a preferred beauty judgment or physical material."
msgstr "La description esthétique n’établit ni jugement de beauté préféré ni matériau physique."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindAesthetic|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this WorldDetailKind individual through worldDetailKind, retaining the exact claim's source context."
msgstr "Référencer cet individu WorldDetailKind par worldDetailKind, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindAesthetic|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This aesthetic world detail value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « détail esthétique du monde » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindAesthetic|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:worldDetailKind gmeow:worldDetailKindAesthetic ."
msgstr "Par exemple : ex:record gmeow:worldDetailKind gmeow:worldDetailKindAesthetic ."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindIdentityDescription|http://www.w3.org/2000/01/rdf-schema#label"
msgid "identity-description world detail"
msgstr "détail descriptif d’identité du monde"

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindIdentityDescription|http://www.w3.org/2004/02/skos/core#definition"
msgid "The detail describes who or what an environment entity is."
msgstr "Le détail décrit qui ou ce qu’est une entité d’environnement."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindIdentityDescription|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit identity-description world detail classification."
msgstr "À employer pour la classification explicite « détail descriptif d’identité du monde » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindIdentityDescription|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Description text is not resolved identity, coreference or sameAs evidence."
msgstr "Le texte descriptif n’est ni identité résolue, ni coréférence, ni preuve sameAs."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindIdentityDescription|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this WorldDetailKind individual through worldDetailKind, retaining the exact claim's source context."
msgstr "Référencer cet individu WorldDetailKind par worldDetailKind, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindIdentityDescription|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This identity-description world detail value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « détail descriptif d’identité du monde » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindIdentityDescription|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:worldDetailKind gmeow:worldDetailKindIdentityDescription ."
msgstr "Par exemple : ex:record gmeow:worldDetailKind gmeow:worldDetailKindIdentityDescription ."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindOrganizationalReference|http://www.w3.org/2000/01/rdf-schema#label"
msgid "organizational-reference world detail"
msgstr "détail de référence organisationnelle du monde"

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindOrganizationalReference|http://www.w3.org/2004/02/skos/core#definition"
msgid "The detail describes where something belongs within the environment's organization."
msgstr "Le détail décrit où quelque chose appartient dans l’organisation de l’environnement."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindOrganizationalReference|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit organizational-reference world detail classification."
msgstr "À employer pour la classification explicite « détail de référence organisationnelle du monde » de la source."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindOrganizationalReference|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "This kind does not turn the described thing into an Organization or establish legal membership."
msgstr "Ce type ne transforme pas la chose en Organization et n’établit aucune appartenance juridique."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindOrganizationalReference|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this WorldDetailKind individual through worldDetailKind, retaining the exact claim's source context."
msgstr "Référencer cet individu WorldDetailKind par worldDetailKind, en conservant le contexte source de l’énoncé exact."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindOrganizationalReference|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This organizational-reference world detail value is not a default, an executable transition or a current-state winner."
msgstr "Cette valeur « détail de référence organisationnelle du monde » n’est ni valeur par défaut, ni transition exécutable, ni état courant gagnant."

msgctxt "https://blackcatinformatics.ca/gmeow/worldDetailKindOrganizationalReference|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:worldDetailKind gmeow:worldDetailKindOrganizationalReference ."
msgstr "Par exemple : ex:record gmeow:worldDetailKind gmeow:worldDetailKindOrganizationalReference ."

msgctxt "https://blackcatinformatics.ca/gmeow/EmbeddedPartRole|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Embedded Part Role"
msgstr "Rôle de partie intégrée"

msgctxt "https://blackcatinformatics.ca/gmeow/EmbeddedPartRole|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary for a part's source-reported role within its enclosing object, distinct from the part's intrinsic kind."
msgstr "Vocabulaire ouvert du rôle rapporté d’une partie dans l’objet qui l’inclut, distinct de son type intrinsèque."

msgctxt "https://blackcatinformatics.ca/gmeow/EmbeddedPartRole|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify embedded part role values supplied by a source."
msgstr "À employer pour classer les valeurs « Rôle de partie intégrée » fournies par une source."

msgctxt "https://blackcatinformatics.ca/gmeow/EmbeddedPartRole|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid replacing EmbeddedPartRole individuals with event or object subclasses."
msgstr "Éviter de remplacer les individus EmbeddedPartRole par des sous-classes d’événement ou d’objet."

msgctxt "https://blackcatinformatics.ca/gmeow/EmbeddedPartRole|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach a typed value through embeddedPartRole; keep independent attributed classifications."
msgstr "Joindre une valeur typée par embeddedPartRole ; conserver les classifications attribuées indépendantes."

msgctxt "https://blackcatinformatics.ca/gmeow/EmbeddedPartRole|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "The embedded part role vocabulary stays open; absence supplies no default member."
msgstr "Le vocabulaire « Rôle de partie intégrée » reste ouvert ; l’absence ne fournit aucun membre par défaut."

msgctxt "https://blackcatinformatics.ca/gmeow/EmbeddedPartRole|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:localValue a gmeow:EmbeddedPartRole ."
msgstr "Par exemple : ex:localValue a gmeow:EmbeddedPartRole ."

msgctxt "https://blackcatinformatics.ca/gmeow/embeddedPartRole|http://www.w3.org/2000/01/rdf-schema#label"
msgid "embedded part role"
msgstr "rôle de partie intégrée"

msgctxt "https://blackcatinformatics.ca/gmeow/embeddedPartRole|http://www.w3.org/2004/02/skos/core#definition"
msgid "A part's source-reported contextual role within an enclosing represented object, distinct from its intrinsic kind."
msgstr "Rôle contextuel rapporté d’une partie dans un objet représenté englobant, distinct de son type intrinsèque."

msgctxt "https://blackcatinformatics.ca/gmeow/embeddedPartRole|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when an actual part and its enclosing-object relationship are supplied."
msgstr "À employer lorsqu’une partie réelle et son lien à l’objet englobant sont fournis."

msgctxt "https://blackcatinformatics.ca/gmeow/embeddedPartRole|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing a whole from role wording or making one attributed role globally intrinsic."
msgstr "Éviter d’inventer un tout d’après le rôle ou de rendre un rôle attribué globalement intrinsèque."

msgctxt "https://blackcatinformatics.ca/gmeow/embeddedPartRole|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain partOf to the actual whole and attribute the exact role statement in that object's source context."
msgstr "Conserver partOf vers le tout réel et attribuer l’énoncé de rôle exact dans le contexte source de cet objet."

msgctxt "https://blackcatinformatics.ca/gmeow/embeddedPartRole|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Different enclosing contexts may assign different roles to one part without selecting a preferred role."
msgstr "Des contextes englobants différents peuvent attribuer divers rôles à une partie sans préférence."

msgctxt "https://blackcatinformatics.ca/gmeow/embeddedPartRole|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:plate a gmeow:Entity ; gmeow:partOf ex:object ; gmeow:embeddedPartRole gmeow:embeddedPartRoleMechanismPlate ."
msgstr "Par exemple : ex:plate a gmeow:Entity ; gmeow:partOf ex:object ; gmeow:embeddedPartRole gmeow:embeddedPartRoleMechanismPlate ."

msgctxt "https://blackcatinformatics.ca/gmeow/embeddedPartRoleForm|http://www.w3.org/2000/01/rdf-schema#label"
msgid "form part role"
msgstr "rôle de partie de forme"

