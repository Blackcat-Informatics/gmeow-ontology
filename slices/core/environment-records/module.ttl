    gmeow:howToUse "Attach worldObjectKindKintsugiVessel through worldObjectKind; let the declared broader-value chain supply only its documented ancestors."@x-gmeow-english ;
    skos:scopeNote "The direct broader value is worldObjectKindBowl; inherited classification remains inferred, not a new source assertion."@x-gmeow-english ;
    skos:example "For example: ex:object gmeow:worldObjectKind gmeow:worldObjectKindKintsugiVessel ."@x-gmeow-english ;
    gmeow:worldObjectKindBroader gmeow:worldObjectKindBowl .

gmeow:worldObjectKindWrittenRecord
    a logic:NamedIndividual, gmeow:WorldObjectKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "written record object"@x-gmeow-english ;
    skos:definition "A thing that keeps or displays a written account for reading in the environment."@x-gmeow-english ;
    gmeow:useWhen "Use for a source-classified written record object in an attributed world description."@x-gmeow-english ;
    gmeow:avoidWhen "The object-kind value does not type its bearer as CreativeWork or grant reading access."@x-gmeow-english ;
    gmeow:howToUse "Attach worldObjectKindWrittenRecord through worldObjectKind; let the declared broader-value chain supply only its documented ancestors."@x-gmeow-english ;
    skos:scopeNote "No additional broader value is asserted for worldObjectKindWrittenRecord; missing hierarchy is not invented."@x-gmeow-english ;
    skos:example "For example: ex:object gmeow:worldObjectKind gmeow:worldObjectKindWrittenRecord ."@x-gmeow-english .

gmeow:worldObjectKindDocumentCollection
    a logic:NamedIndividual, gmeow:WorldObjectKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "document collection object"@x-gmeow-english ;
