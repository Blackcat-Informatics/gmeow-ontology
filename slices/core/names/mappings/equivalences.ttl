    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:sssomFile "gmeow-names.sssom.tsv" .

gmeow:eqNames039 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:nameLanguage ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wdt:P407 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Wikidata 'language of work or name' (P407) — verified live against the Wikidata API" ;
    gmeow:sssomFile "gmeow-names.sssom.tsv" .

