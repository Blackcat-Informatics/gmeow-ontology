@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix vann:  <http://purl.org/vocab/vann/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/math>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    vann:preferredNamespacePrefix "math" ;
    vann:preferredNamespaceUri "https://blackcatinformatics.ca/math/" ;
    rdfs:comment "Grounding vocabulary for GMEOW Mathematics. The math: namespace <https://blackcatinformatics.ca/math/> is the grounding surface for the primitive mathematical objects — number systems and exactness, arithmetic, sets, and relations and functions — that every other mathematical charter quantifies, indexes, maps, and measures over. It is a peer of logic:; the intensional-set condition denotes a logic: formula and the preservation-polarity vocabulary is reused verbatim from the logic: loss ledger rather than re-minted. The object-layer parents (math:Set, math:Function, math:Operation, math:Relation, math:MathematicalExpression) are minted here as the ground the bedrock builds on."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "GMEOW Mathematics"@x-gmeow-english ;
    skos:definition "The GMEOW Mathematics module — home of the math: grounding vocabulary. Its single discipline is that exactness is explicit: a number declares the system it lives in (the containment tower ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ), an exact value and an approximation of it are distinct objects, and a named constant is an exact individual anchored to an external authority rather than a decimal literal. A set is given extensionally by its elements or intensionally by a condition that denotes a logic: formula, never both silently; a function declares its domain and codomain. The typed conformance-failure vocabulary (math:MathConformanceFailure and its subclasses) makes every well-formedness violation a queryable object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Number systems and exactness
# =========================================================================== #

math:Number
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Number"@x-gmeow-english ;
    skos:definition "A mathematical number: an abstract quantity that lives in a declared number system. Every math:Number situates itself in a math:NumberSystem through math:inNumberSystem — an unsituated number is ill-formed — and declares through math:isExact whether it is an exact value or the abstract counterpart that a math:ApproximateValue approximates. The five nested systems ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ are its principal subclasses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:NaturalNumber
    a owl:Class ;
    rdfs:subClassOf math:Integer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Natural Number"@x-gmeow-english ;
    skos:definition "A natural number (ℕ): a non-negative counting number. The innermost system of the containment tower ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ — every natural number is an integer, so this is a subclass of math:Integer. Situated in the math:naturalNumbers system."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Integer
    a owl:Class ;
    rdfs:subClassOf math:RationalNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Integer"@x-gmeow-english ;
    skos:definition "An integer (ℤ): a whole number, positive, negative, or zero. Every integer is a rational number (n = n/1), so this is a subclass of math:RationalNumber. Situated in the math:integers system."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RationalNumber
    a owl:Class ;
    rdfs:subClassOf math:RealNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Rational Number"@x-gmeow-english ;
    skos:definition "A rational number (ℚ): a ratio p/q of integers with q ≠ 0. Every rational number is a real number, so this is a subclass of math:RealNumber. Situated in the math:rationalNumbers system. A rational number is exact; its finite or repeating decimal is an approximation carried by a distinct math:ApproximateValue."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RealNumber
    a owl:Class ;
    rdfs:subClassOf math:ComplexNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Real Number"@x-gmeow-english ;
    skos:definition "A real number (ℝ): a point on the continuous number line, rational or irrational. Every real number is a complex number with zero imaginary part, so this is a subclass of math:ComplexNumber. Situated in the math:realNumbers system."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ComplexNumber
    a owl:Class ;
    rdfs:subClassOf math:Number ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Complex Number"@x-gmeow-english ;
    skos:definition "A complex number (ℂ): a value a + bi with real part a and imaginary part b. The outermost system of the containment tower; a subclass of math:Number. Situated in the math:complexNumbers system."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AlgebraicNumber
    a owl:Class ;
    rdfs:subClassOf math:ComplexNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Algebraic Number"@x-gmeow-english ;
    skos:definition "An algebraic number: a complex number that is a root of a non-zero polynomial with rational coefficients (for example √2 or the golden ratio). A subclass of math:ComplexNumber, cross-cutting the ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ tower — the algebraic numbers are closed under the field operations but are not one of the nested systems. Its complement within ℂ is the transcendental numbers."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:TranscendentalNumber
    a owl:Class ;
    rdfs:subClassOf math:ComplexNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Transcendental Number"@x-gmeow-english ;
    skos:definition "A transcendental number: a complex number that is not algebraic — not a root of any non-zero polynomial with rational coefficients (for example π and e). A subclass of math:ComplexNumber. Named transcendental constants such as π and e are exact math:MathematicalConstant individuals, never decimal literals."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MathematicalConstant
    a owl:Class ;
    rdfs:subClassOf math:Number ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Mathematical Constant"@x-gmeow-english ;
    skos:definition "A named mathematical constant: an exact number with a canonical identity, such as π, e, or the Euler–Mascheroni constant γ. A subclass of math:Number whose instances are exact individuals (math:isExact true) anchored to an external authority — a Wikidata QID and, where applicable, an OEIS or DLMF locator, recorded as a math: alignment. A constant is never given as a decimal literal; its decimal expansion belongs to a distinct math:ApproximateValue that math:approximates it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ApproximateValue
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Approximate Value"@x-gmeow-english ;
    skos:definition "A finite approximation of an exact number: a value that names, through math:approximates, the exact math:Number it stands in for and, through math:approximationError, how far it may deviate. It carries the concrete numeric literal (math:quantityValue) in a declared floating-point datatype (math:numericDatatype, subsuming xsd:double / xsd:float). An approximate value and the exact number it approximates are distinct objects and are never conflated — this is the object that holds the decimal so the exact number need not."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:NumberSystem
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Number System"@x-gmeow-english ;
    skos:definition "A number system: the domain a number is situated in — ℕ, ℤ, ℚ, ℝ, or ℂ. A subclass of math:Set — a number system IS the set of its numbers, so it can serve as the math:domain or math:codomain of a function (the complex plane ℂ is the domain of the gamma function). Its instances are the five named systems math:naturalNumbers, math:integers, math:rationalNumbers, math:realNumbers, and math:complexNumbers, ordered by math:subsystemOf into the containment tower ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ. A math:Number points at one through math:inNumberSystem."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Number-system individuals (the containment tower) ---------------------- #

math:naturalNumbers
    a owl:NamedIndividual , math:NumberSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "natural numbers (ℕ)"@x-gmeow-english ;
    skos:definition "The system of natural numbers ℕ — the non-negative counting numbers. The innermost system; math:subsystemOf math:integers."@x-gmeow-english ;
    math:subsystemOf math:integers .

math:integers
    a owl:NamedIndividual , math:NumberSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "integers (ℤ)"@x-gmeow-english ;
    skos:definition "The system of integers ℤ — the whole numbers. math:subsystemOf math:rationalNumbers."@x-gmeow-english ;
    math:subsystemOf math:rationalNumbers .

math:rationalNumbers
    a owl:NamedIndividual , math:NumberSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "rational numbers (ℚ)"@x-gmeow-english ;
    skos:definition "The system of rational numbers ℚ — ratios of integers. math:subsystemOf math:realNumbers."@x-gmeow-english ;
    math:subsystemOf math:realNumbers .

math:realNumbers
    a owl:NamedIndividual , math:NumberSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "real numbers (ℝ)"@x-gmeow-english ;
    skos:definition "The system of real numbers ℝ — the continuous number line. math:subsystemOf math:complexNumbers."@x-gmeow-english ;
    math:subsystemOf math:complexNumbers .

math:complexNumbers
    a owl:NamedIndividual , math:NumberSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "complex numbers (ℂ)"@x-gmeow-english ;
    skos:definition "The system of complex numbers ℂ — the outermost system of the containment tower. The top of the math:subsystemOf order."@x-gmeow-english .

# --- Named exact constants -------------------------------------------------- #

math:pi
    a owl:NamedIndividual , math:MathematicalConstant , math:TranscendentalNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "π"@x-gmeow-english ;
    skos:definition "The constant π: the exact ratio of a circle's circumference to its diameter, a transcendental real number. An exact individual (math:isExact true) situated in the real numbers; its external anchors (Wikidata, OEIS) are recorded as math: alignments. Its decimal expansion 3.14159… is a distinct math:ApproximateValue, never asserted on this individual."@x-gmeow-english ;
    math:inNumberSystem math:realNumbers ;
    math:isExact true .

math:eulerNumber
    a owl:NamedIndividual , math:MathematicalConstant , math:TranscendentalNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "e"@x-gmeow-english ;
    skos:definition "The constant e: the exact base of the natural logarithm, a transcendental real number. An exact individual (math:isExact true) situated in the real numbers; its external anchors (Wikidata, OEIS) are recorded as math: alignments. Its decimal expansion 2.71828… is a distinct math:ApproximateValue."@x-gmeow-english ;
    math:inNumberSystem math:realNumbers ;
    math:isExact true .

math:eulerMascheroni
    a owl:NamedIndividual , math:MathematicalConstant ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "γ"@x-gmeow-english ;
    skos:definition "The Euler–Mascheroni constant γ: the exact limiting difference between the harmonic series and the natural logarithm, a real number whose rationality is unknown. An exact individual (math:isExact true) situated in the real numbers; its external anchors (Wikidata, OEIS) are recorded as math: alignments. Its decimal expansion 0.57721… is a distinct math:ApproximateValue."@x-gmeow-english ;
    math:inNumberSystem math:realNumbers ;
    math:isExact true .

# =========================================================================== #
# Arithmetic (builds on the object-layer math:Operation and math:Expression)
# =========================================================================== #

math:Operation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Operation"@x-gmeow-english ;
    skos:definition "A mathematical operation: a map from operands to a result, applied within an expression. The object-layer parent that math:ArithmeticOperation specializes; richer structure (arity, operand structure preservation) belongs to the mathematical-core surface that this bedrock builds on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ArithmeticOperation
    a owl:Class ;
    rdfs:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Arithmetic Operation"@x-gmeow-english ;
    skos:definition "An arithmetic operation over numbers: addition, multiplication, exponentiation, and their inverses. A subclass of math:Operation; the concrete operators are named individuals (math:Addition, math:Multiplication, math:Exponentiation, math:Subtraction, math:Division, math:Root, math:Logarithm). Anchored externally to the OpenMath arith1 and nums1 content dictionaries. An arithmetic expression applies one such operator inside a math:ApplicationExpression."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MathematicalExpression
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Mathematical Expression"@x-gmeow-english ;
    skos:definition "The abstract root of the mathematical expression tree: a computable form is an abstract syntax tree, not a display string. The object-layer parent the bedrock references; the full expression grammar (literals, variables, indexed argument slots, binding and scope) belongs to the mathematical-core surface this bedrock builds on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ApplicationExpression
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Application Expression"@x-gmeow-english ;
    skos:definition "The application of an operator to operands: the expression node an arithmetic operation lowers to. Its single operator is named through math:operator; the indexed argument-slot machinery that fixes operand order belongs to the mathematical-core surface this bedrock builds on, and is deliberately not minted here."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:operator
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "operator"@x-gmeow-english ;
    skos:definition "The single operator a math:ApplicationExpression applies: relates an application to the math:Operation (for example a math:ArithmeticOperation individual) it invokes. Domain math:ApplicationExpression, range math:Operation (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Arithmetic operator individuals ---------------------------------------- #

math:Addition
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "addition"@x-gmeow-english ;
    skos:definition "The binary addition operator (+). Its inverse is math:Subtraction. OpenMath arith1 plus."@x-gmeow-english .

math:Subtraction
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "subtraction"@x-gmeow-english ;
    skos:definition "The binary subtraction operator (−), the inverse of math:Addition. OpenMath arith1 minus."@x-gmeow-english .

math:Multiplication
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "multiplication"@x-gmeow-english ;
    skos:definition "The binary multiplication operator (×). Its inverse is math:Division. OpenMath arith1 times."@x-gmeow-english .

math:Division
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "division"@x-gmeow-english ;
    skos:definition "The binary division operator (÷), the inverse of math:Multiplication. OpenMath arith1 divide."@x-gmeow-english .

math:Exponentiation
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exponentiation"@x-gmeow-english ;
    skos:definition "The exponentiation operator (a^b). Its inverses are math:Root (recovering the base) and math:Logarithm (recovering the exponent). OpenMath arith1 power."@x-gmeow-english .

math:Root
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "root"@x-gmeow-english ;
    skos:definition "The root operator (the b-th root of a), an inverse of math:Exponentiation that recovers the base. OpenMath arith1 root."@x-gmeow-english .

math:Logarithm
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "logarithm"@x-gmeow-english ;
    skos:definition "The logarithm operator (log_b of a), an inverse of math:Exponentiation that recovers the exponent. OpenMath transc1 log."@x-gmeow-english .

# =========================================================================== #
# Rendering seam — a mathematical expression realized as a notation form.
# math:ExpressionRendering grafts onto the general lang:Rendering theory rather
# than forking it: it is the lang:Rendering whose content is a mathematical
# expression and whose kind is lang:renderingNotation. A future projection
# target (MathML, LaTeX) reads lang:renderedContent, lang:renderingConvention,
# and lang:renderingPreservation off this class and emits a surface without
# re-shaping it. Preservation is the shared logic:PreservationKind carried on
# the rendering's logic:Correspondence, never a math: display grade.
# =========================================================================== #

math:ExpressionRendering
    a owl:Class ;
    rdfs:subClassOf lang:Rendering ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Expression Rendering"@x-gmeow-english ;
    skos:definition "A reified record of realizing a mathematical expression as a notation form: the lang:Rendering whose lang:renderedContent is a math:MathematicalExpression, whose lang:renderingKind is lang:renderingNotation, whose lang:renderingConvention names a mathematical notation system (the LaTeX, MathML, or OpenMath convention that fixes how the expression AST becomes a surface), and whose lang:renderingPreservation carries a logic:PreservationKind judging the crossing. It grafts onto the general lang:Rendering theory rather than forking it — no math: display class ladder and no math: preservation enum are minted. A projection target reads renderedContent, renderingConvention, and renderingPreservation directly off this record to emit MathML or LaTeX, which attaches later without re-shaping this class; the convenience shortcut math:rendersAs points at the expression whose reified rendering this is."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:rendersAs
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "renders as"@x-gmeow-english ;
    skos:definition "The convenience shortcut from a mathematical expression to the notation form it is rendered as. Domain math:MathematicalExpression, range lang:Form (stated in prose). The shortcut whose reified record is a math:ExpressionRendering: the rendering node carries the notation convention through lang:renderingConvention and the preservation judgment through lang:renderingPreservation, so math:rendersAs is a lossy read-off that names only the produced form, while the ExpressionRendering holds the full crossing."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# Sets and their construction
# =========================================================================== #

math:Set
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Set"@x-gmeow-english ;
    skos:definition "A mathematical set: a collection of distinct elements, given either extensionally (its members enumerated through math:hasElement — see math:FiniteSet) or intensionally (a defining condition through math:memberCondition — see math:SetBuilderExpression). A set is extensional or intensional, not silently both without a declared equality. Anchored externally to the OpenMath set1 content dictionary. The object-layer parent the bedrock builds on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FiniteSet
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Finite Set"@x-gmeow-english ;
    skos:definition "A set given extensionally by enumerating its finitely many elements through math:hasElement. Its cardinality (math:hasCardinality) is a finite math:Cardinality. The extensional counterpart of the intensional math:SetBuilderExpression."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SetBuilderExpression
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Set-Builder Expression"@x-gmeow-english ;
    skos:definition "A set given intensionally by a defining condition — the { x | φ(x) } form. Its condition is named through math:memberCondition and denotes a logic: formula, the denotation seam, never an opaque string. The intensional counterpart of the extensional math:FiniteSet."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Membership
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Membership"@x-gmeow-english ;
    skos:definition "A reified membership fact: that a particular element belongs to a particular set (x ∈ S). Reifying membership lets a claim of membership carry its own provenance or justification, distinct from the bare math:hasElement edge on an extensional set."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SetOperation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Set Operation"@x-gmeow-english ;
    skos:definition "An operation constructing a set from operand sets — union, intersection, difference, or complement. Its operands are named through math:setOperationOn. The complement construction is the distinguished subclass math:Complement, which additionally names its ambient space through math:ambientSpace and its complement-semantics through math:complementSemantics; an unqualified complement is ill-formed. math:PowerSet and math:CartesianProduct are distinguished constructions with their own classes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Complement
    a owl:Class ;
    rdfs:subClassOf math:SetOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Complement"@x-gmeow-english ;
    skos:definition "The complement construction: the elements of an ambient space not in S, under a declared notion of complement. A subclass of math:SetOperation that always names its ambient space through math:ambientSpace and which notion of complement it uses through math:complementSemantics (set-theoretic U ∖ S, orthogonal S⊥, complex-linear, topological, or quotient/cokernel) — a complement is relative to an ambient space under a semantics, so an unqualified complement (missing either) is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PowerSet
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Power Set"@x-gmeow-english ;
    skos:definition "The power set 𝒫(S): the set of all subsets of a base set, named through math:setOperationOn. Itself a set, so a subclass of math:Set. For a finite base of cardinality n its cardinality is 2ⁿ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CartesianProduct
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cartesian Product"@x-gmeow-english ;
    skos:definition "The Cartesian product A × B: the set of ordered pairs drawn from operand sets named through math:setOperationOn. Itself a set, so a subclass of math:Set. A math:Relation is a subset of a Cartesian product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Cardinality
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cardinality"@x-gmeow-english ;
    skos:definition "The size of a set: a finite count, ℵ₀ (countably infinite), 𝔠 (the cardinality of the continuum), or a larger cardinal. A set names its size through math:hasCardinality. The distinguished infinite cardinals are the individuals math:cardinalityFinite, math:alephNull, and math:continuum."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:cardinalityFinite
    a owl:NamedIndividual , math:Cardinality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "finite"@x-gmeow-english ;
    skos:definition "The cardinality class of any finite set — a set in bijection with some natural number n. The exact count may additionally be carried as a math:quantityValue."@x-gmeow-english .

math:alephNull
    a owl:NamedIndividual , math:Cardinality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "ℵ₀"@x-gmeow-english ;
    skos:definition "The cardinality ℵ₀ of a countably infinite set — a set in bijection with ℕ, such as ℤ or ℚ."@x-gmeow-english .

math:continuum
    a owl:NamedIndividual , math:Cardinality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "𝔠"@x-gmeow-english ;
    skos:definition "The cardinality 𝔠 of the continuum — the cardinality of ℝ, equal to 2^ℵ₀."@x-gmeow-english .

# =========================================================================== #
# Relations and functions
# =========================================================================== #

math:Relation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Relation"@x-gmeow-english ;
    skos:definition "A mathematical relation: a subset of a Cartesian product of a domain and a codomain. The object-layer parent of math:Function — a function is a relation with the functional property declared. Anchored externally to the OpenMath relation1 content dictionary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Function
    a owl:Class ;
    rdfs:subClassOf math:Relation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Function"@x-gmeow-english ;
    skos:definition "A function: a relation that assigns to each element of its domain exactly one element of its codomain. Every function declares its math:domain and math:codomain — a function without them is ill-formed — and may declare its math:image. Injectivity, surjectivity, and bijectivity are declared, checkable booleans (math:isInjective, math:isSurjective, math:isBijective), not assumed. Anchored externally to the OpenMath fns1 content dictionary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FunctionSpace
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Function Space"@x-gmeow-english ;
    skos:definition "The set of all functions from a fixed domain to a fixed codomain — the exponential object Bᴬ. Itself a set, so a subclass of math:Set."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:InjectiveFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Injective Function"@x-gmeow-english ;
    skos:definition "A convenience projection of the class of functions with math:isInjective true — an injection, mapping distinct domain elements to distinct codomain elements. The canonical checkable bearer is the boolean math:isInjective; this subclass is a projection over it, not an independent carrier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SurjectiveFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Surjective Function"@x-gmeow-english ;
    skos:definition "A convenience projection of the class of functions with math:isSurjective true — a surjection, whose image is the whole codomain. The canonical checkable bearer is the boolean math:isSurjective; this subclass is a projection over it, not an independent carrier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BijectiveFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Bijective Function"@x-gmeow-english ;
    skos:definition "A convenience projection of the class of functions with math:isBijective true — a bijection, both injective and surjective, hence invertible through math:inverseFunction. The canonical checkable bearer is the boolean math:isBijective; this subclass is a projection over it, not an independent carrier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PartialFunction
    a owl:Class ;
    rdfs:subClassOf math:Relation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Partial Function"@x-gmeow-english ;
    skos:definition "A partial function: a relation that assigns at most one codomain element to each domain element, defined only on a subset of its declared domain. A subclass of math:Relation rather than math:Function, because it is not total on its domain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Conformance-failure vocabulary (typed, queryable violation objects)
# =========================================================================== #

math:MathConformanceFailure
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Math Conformance Failure"@x-gmeow-english ;
    skos:definition "The parent of the math: well-formedness failure vocabulary: a violation is itself a typed, queryable object rather than a log line. Each subclass names one bedrock hard rule, and the SHACL shape enforcing that rule points at its failure class through gmeow:enforcesFailureClass. Conformance enforces well-formedness and preservation, never mathematical or empirical truth."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnsituatedNumber
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unsituated Number"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Number does not declare the math:NumberSystem it belongs to. Every number situates itself in ℕ, ℤ, ℚ, ℝ, or ℂ; an unsituated number is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ExactApproximateConflation
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Exact–Approximate Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ApproximateValue fails to keep an approximation distinct from the exact value — it does not name, through math:approximates, the exact number it stands in for, or does not declare its math:approximationError. An exact number and an approximation of it are distinct objects."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ConstantAsDecimalLiteral
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Constant as Decimal Literal"@x-gmeow-english ;
    skos:definition "The failure raised when a math:MathematicalConstant is given as a decimal literal — it carries a raw math:quantityValue directly instead of being an exact individual. A constant's decimal expansion belongs to a distinct math:ApproximateValue that math:approximates it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:StringOnlyMemberCondition
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "String-Only Member Condition"@x-gmeow-english ;
    skos:definition "The failure raised when a math:SetBuilderExpression names its math:memberCondition as an opaque literal instead of denoting a logic: formula. The intensional condition is the denotation seam; it must denote a formula, never a string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnqualifiedComplement
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unqualified Complement"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Complement does not name its ambient space through math:ambientSpace or its complement-semantics through math:complementSemantics. A complement is relative to an ambient space under a declared notion of complement (set-theoretic, orthogonal, complex-linear, topological, or quotient); a complement missing either is ambiguous and ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AmbiguousSetExtent
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ambiguous Set Extent"@x-gmeow-english ;
    skos:definition "The failure raised when a set is given both extensionally (math:hasElement) and intensionally (math:memberCondition) without a declared equality. A set is extensional or intensional, not silently both."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnframedFunction
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unframed Function"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Function does not declare both its math:domain and its math:codomain. A function without its frame is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Properties
# =========================================================================== #

# --- Number and exactness properties ---------------------------------------- #

math:inNumberSystem
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "in number system"@x-gmeow-english ;
    skos:definition "Situates a number in the system it belongs to. Domain math:Number, range math:NumberSystem (stated in prose). Every math:Number declares exactly one — an unsituated number is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:subsystemOf
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "subsystem of"@x-gmeow-english ;
    skos:definition "Orders the number systems by containment: math:naturalNumbers ⊑ math:integers ⊑ math:rationalNumbers ⊑ math:realNumbers ⊑ math:complexNumbers. Domain and range math:NumberSystem (stated in prose). Transitive, so the whole ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ tower is entailed from the adjacent links."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isExact
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is exact"@x-gmeow-english ;
    skos:definition "Declares whether a number is an exact value (true) or the abstract value a math:ApproximateValue approximates. Domain math:Number, range xsd:boolean (stated in prose). A math:MathematicalConstant is always exact."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:approximates
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "approximates"@x-gmeow-english ;
    skos:definition "Names the exact number that an approximation stands in for. Domain math:ApproximateValue, range math:Number (stated in prose). The approximation and the exact number are distinct objects and are never conflated."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:approximationError
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "approximation error"@x-gmeow-english ;
    skos:definition "The magnitude by which an approximation may deviate from the exact value it approximates — an absolute error bound. Domain math:ApproximateValue, range a numeric literal (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:numericDatatype
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "numeric datatype"@x-gmeow-english ;
    skos:definition "Names the canonical RDF datatype in which an approximate value's literal is carried — subsuming the IEEE-754 datatypes xsd:double and xsd:float directly rather than re-minting them. Domain math:ApproximateValue, range an rdfs:Datatype (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:quantityValue
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "quantity value"@x-gmeow-english ;
    skos:definition "The concrete numeric literal a value carries — the floating-point or decimal expansion of a math:ApproximateValue, or the finite count of a cardinality. Domain math:ApproximateValue or math:Cardinality, range a numeric literal (stated in prose). A math:MathematicalConstant never carries this directly; its decimal belongs to a distinct math:ApproximateValue."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Set properties --------------------------------------------------------- #

math:hasElement
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has element"@x-gmeow-english ;
    skos:definition "The canonical extensional membership carrier: relates a set to one of its enumerated members (x ∈ S). Domain math:Set, range any math:MathematicalObject (stated in prose). A math:FiniteSet is given extensionally by its math:hasElement edges."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:memberCondition
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "member condition"@x-gmeow-english ;
    skos:definition "Names the defining condition of an intensional set — the φ in { x | φ(x) }. Domain math:Set (in practice a math:SetBuilderExpression), range a logic: formula (stated in prose). The value denotes a logic: formula, the denotation seam, and is never an opaque literal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:subsetOf
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "subset of"@x-gmeow-english ;
    skos:definition "Relates a set to a set that contains all of its elements (A ⊆ B). Domain and range math:Set (stated in prose). Transitive: A ⊆ B and B ⊆ C entail A ⊆ C. Reflexivity and antisymmetry hold mathematically but are documented in prose, not asserted as OWL characteristics, to keep the term profile-clean."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:setOperationOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "set operation on"@x-gmeow-english ;
    skos:definition "Relates a set-construction (a math:SetOperation, math:PowerSet, or math:CartesianProduct) to an operand set it is built from. Domain math:SetOperation or its siblings, range math:Set (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:ambientSpace
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "ambient space"@x-gmeow-english ;
    skos:definition "Names the ambient space a math:Complement is taken relative to (the U in a complement of S within U). Domain math:Complement, range a math:Set, math:VectorSpace, math:TopologicalSpace, or math:FunctionSpace (stated in prose) — the ambient space generalizes the set-theoretic case to the orthogonal, complex-linear, topological, and quotient cases the math:complementSemantics distinguishes. A complement without an ambient space is ill-formed (math:UnqualifiedComplement). Generalizes the earlier set-only complement predicate: a complement is relative to an ambient space, and which space and which semantics must both be named."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:complementSemantics
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "complement semantics"@x-gmeow-english ;
    skos:definition "Names which notion of complement a math:Complement uses: a math:ComplementSemantics individual — set-theoretic (U ∖ S), orthogonal (S⊥ in an inner-product space), complex-linear (a complementary subspace), topological (the closed complement of an open set), or quotient/cokernel. Domain math:Complement, range math:ComplementSemantics (stated in prose). 'The complement of X' without a named semantics is ambiguous and ill-formed (math:UnqualifiedComplement) — the flagship-adjacent 'complex complement' hazard the charter forbids."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:ComplementSemantics
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Complement Semantics"@x-gmeow-english ;
    skos:definition "The notion of complement a math:Complement uses: one of math:setTheoreticComplement, math:orthogonalComplement, math:complexLinearComplement, math:topologicalComplement, or math:quotientComplement. A complement names exactly one through math:complementSemantics; the same ambient object admits several inequivalent complements, so the semantics must be declared."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:setTheoreticComplement
    a owl:NamedIndividual , math:ComplementSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "set-theoretic (U ∖ S)"@x-gmeow-english ;
    skos:definition "The set-theoretic complement Sᶜ = U ∖ S: the elements of the ambient set U not in S. The elementary case; the ambient space is a math:Set."@x-gmeow-english .

math:orthogonalComplement
    a owl:NamedIndividual , math:ComplementSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "orthogonal (S⊥)"@x-gmeow-english ;
    skos:definition "The orthogonal complement S⊥ = {v : ⟨v, s⟩ = 0 ∀s ∈ S} in an inner-product space. The ambient space is a math:VectorSpace with an inner product; realized in the linear-algebra charter."@x-gmeow-english .

math:complexLinearComplement
    a owl:NamedIndividual , math:ComplementSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "complex-linear"@x-gmeow-english ;
    skos:definition "A complex-linear complement: a subspace W with V = S ⊕ W over ℂ, not canonical without further structure. The 'complex complement' hazard — ambiguous unless the ambient space and this semantics are named."@x-gmeow-english .

math:topologicalComplement
    a owl:NamedIndividual , math:ComplementSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "topological (closed complement)"@x-gmeow-english ;
    skos:definition "The topological complement: the closed complement X ∖ U of an open set U in a math:TopologicalSpace (a math:ClosedSet). Distinct from the set-theoretic complement in carrying the topology."@x-gmeow-english .

math:quotientComplement
    a owl:NamedIndividual , math:ComplementSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "quotient / cokernel"@x-gmeow-english ;
    skos:definition "A quotient/cokernel complement: the quotient V/S rather than a chosen complementary subspace, canonical where a direct-sum complement is not. The ambient space is the total object; the complement is its cokernel."@x-gmeow-english .

math:hasCardinality
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has cardinality"@x-gmeow-english ;
    skos:definition "Names the size of a set. Domain math:Set, range math:Cardinality (stated in prose). A finite set names math:cardinalityFinite and may additionally carry its exact count as a math:quantityValue."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Function properties ---------------------------------------------------- #

math:domain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "domain"@x-gmeow-english ;
    skos:definition "The source set of a function or relation — the set its inputs are drawn from. Domain math:Relation, range math:Set (stated in prose). Every math:Function declares one; a function without a domain is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:codomain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "codomain"@x-gmeow-english ;
    skos:definition "The target set of a function or relation — the set its outputs land in. Domain math:Relation, range math:Set (stated in prose). Every math:Function declares one; a function without a codomain is ill-formed. The codomain is the declared target, distinct from the math:image actually attained."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:image
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "image"@x-gmeow-english ;
    skos:definition "The set of values a function actually attains — the subset of the codomain that is the range of the map. Domain math:Function, range math:Set (stated in prose). A function is surjective exactly when its image equals its codomain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isInjective
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is injective"@x-gmeow-english ;
    skos:definition "Declares whether a function is injective — distinct inputs map to distinct outputs. Domain math:Function, range xsd:boolean (stated in prose). The canonical checkable bearer of injectivity, of which math:InjectiveFunction is a convenience projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isSurjective
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is surjective"@x-gmeow-english ;
    skos:definition "Declares whether a function is surjective — its image is the whole codomain. Domain math:Function, range xsd:boolean (stated in prose). The canonical checkable bearer of surjectivity, of which math:SurjectiveFunction is a convenience projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isBijective
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is bijective"@x-gmeow-english ;
    skos:definition "Declares whether a function is bijective — both injective and surjective, hence invertible. Domain math:Function, range xsd:boolean (stated in prose). The canonical checkable bearer of bijectivity, of which math:BijectiveFunction is a convenience projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:functionComposition
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "function composition"@x-gmeow-english ;
    skos:definition "Relates a composite function g ∘ f to a function it is built from. Domain and range math:Function (stated in prose). Composition is non-commutative (g ∘ f ≠ f ∘ g in general), so this order-agnostic super-property — which holds of either component — is refined by math:compositionOuter and math:compositionInner, through which the order-bearing decomposition is asserted. Composition is well-formed when the codomain of the inner function is the domain of the outer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:compositionOuter
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:functionComposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "composition outer"@x-gmeow-english ;
    skos:definition "Relates a composite function g ∘ f to its outer (left) component g — the function applied second, whose math:domain is the math:codomain of the inner component. The order-bearing refinement of math:functionComposition that, together with math:compositionInner, preserves the non-commutative order of composition so g ∘ f is never confused with f ∘ g. Domain and range math:Function (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:compositionInner
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:functionComposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "composition inner"@x-gmeow-english ;
    skos:definition "Relates a composite function g ∘ f to its inner (right) component f — the function applied first, whose math:codomain is the math:domain of the outer component. The order-bearing refinement of math:functionComposition that, together with math:compositionOuter, preserves the non-commutative order of composition so g ∘ f is never confused with f ∘ g. Domain and range math:Function (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:inverseFunction
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "inverse function"@x-gmeow-english ;
    skos:definition "Relates a function to its inverse f⁻¹, defined exactly when the function is bijective. Domain and range math:Function (stated in prose). The relation is symmetric mathematically (the inverse of f⁻¹ is f), documented in prose rather than asserted as an OWL characteristic to keep the term profile-clean."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Bridge and enforcement annotation properties --------------------------- #

math:formalizes
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "formalizes"@x-gmeow-english ;
    skos:definition "A bridge annotation from a math: grounding term to the gmeow: domain concept it formalizes, so the domain term's documentation can surface the formalization without the domain slice ever asserting a math: triple. Subject a math: term, object a gmeow: term, both stated in prose; an annotation property, never a reasoned axiom, so it carries no DL or EL profile weight."@x-gmeow-english .

math:definingLaw
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "defining law"@x-gmeow-english ;
    skos:definition "The machine-readable backing edge relating a declared property concept to the logic:Formula defining law, or the loss-ledger boundary record (logic:expressivenessBoundary), that grounds it. The law-backing audit requires every concept carrying it to resolve to a real logic:Formula or a recorded boundary — never a bare type or a dangling reference. Its presence is the marker of a concept that must be grounded, so the invariant is open: a new grounded property joins it by carrying math:definingLaw, with no list to maintain. An annotation property (its subjects are classes and individuals, so it is DL-clean exactly like rdfs:seeAlso), never a reasoned axiom."@x-gmeow-english .

# =========================================================================== #
# Algebra — the algebraic-structure hierarchy (ALGEBRA charter)
#
# A structure declares its operations and laws; a map between structures declares
# what it preserves. The laws are logic: formulas (math: expresses, logic: owns
# reasoning): a math:Axiom denotes a logic: formula reached through math:satisfiesAxiom,
# never an opaque string. The hierarchy is subsumption — an AbelianGroup is a Group
# that additionally satisfies a commutativity axiom.
# =========================================================================== #

# --- Object-layer parents the charter builds on --------------------------- #

math:Morphism
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Morphism"@x-gmeow-english ;
    skos:definition "A structure-preserving map between mathematical objects: the object-layer parent of math:Homomorphism. Deliberately NOT a subclass of math:Function — a morphism's math:domain and math:codomain range over math:AlgebraicStructure (or another object), not a bare math:Set, so the set-typed function-framing gate never targets it. What a morphism preserves is declared through math:preservesStructure and its preservation law; richer categorical structure (composition, identity morphisms) belongs to a downstream category charter and is deliberately not minted here."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Axiom
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Axiom"@x-gmeow-english ;
    skos:definition "A stated law a structure satisfies — associativity, commutativity, an identity or inverse law, distributivity. An axiom denotes a logic: formula (the denotation seam, reached in the worked examples as a resource typed both math:Axiom and logic:Formula), never an opaque string: math: expresses the law and logic: owns reasoning over it. A math:AlgebraicStructure names the axioms it satisfies through math:satisfiesAxiom; the object-layer parent the algebra hierarchy builds on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AlgebraicStructure
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Algebraic Structure"@x-gmeow-english ;
    skos:definition "A set equipped with operations satisfying stated axioms: a math:underlyingSet, one or more math:structureOperation, an identity/inverse where they exist, and the math:satisfiesAxiom laws it obeys. A group is not a labelled set — a math:Group asserted without an operation and axioms is ill-formed. The root of the algebraic hierarchy math:Magma … math:Field; substructures are related through math:substructureOf."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Magma
    a owl:Class ;
    rdfs:subClassOf math:AlgebraicStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Magma"@x-gmeow-english ;
    skos:definition "A set with a single closed binary math:structureOperation and no further axioms: the weakest algebraic structure, a subclass of math:AlgebraicStructure. A math:Semigroup is a magma whose operation is associative."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Semigroup
    a owl:Class ;
    rdfs:subClassOf math:Magma ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Semigroup"@x-gmeow-english ;
    skos:definition "A math:Magma whose binary operation is associative — it satisfies the associativity axiom (∀a,b,c: (a·b)·c = a·(b·c)) through math:satisfiesAxiom. A subclass of math:Magma; a math:Monoid is a semigroup with an identity element."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Monoid
    a owl:Class ;
    rdfs:subClassOf math:Semigroup ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Monoid"@x-gmeow-english ;
    skos:definition "A math:Semigroup with a two-sided identity element (∀a: a·e = e·a = a), named through math:identityElement. A subclass of math:Semigroup; a math:Group is a monoid in which every element has an inverse."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Group
    a owl:Class ;
    rdfs:subClassOf math:Monoid ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Group"@x-gmeow-english ;
    skos:definition "A math:Monoid in which every element has a two-sided inverse (∀a ∃a⁻¹: a·a⁻¹ = a⁻¹·a = e), the inverse reached through math:inverseOperation. A subclass of math:Monoid — the central structure of symmetry, of which a math:AutomorphismGroup and a math:WeylGroup are instances. A math:AbelianGroup is a group whose operation additionally commutes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AbelianGroup
    a owl:Class ;
    rdfs:subClassOf math:Group ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Abelian Group"@x-gmeow-english ;
    skos:definition "A math:Group whose operation is commutative (∀a,b: a·b = b·a) — it additionally satisfies the commutativity axiom through math:satisfiesAxiom. A subclass of math:Group; the additive group of a math:Ring is abelian."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Ring
    a owl:Class ;
    rdfs:subClassOf math:AlgebraicStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ring"@x-gmeow-english ;
    skos:definition "A set with two operations — an abelian additive group and an associative multiplication that distributes over addition (∀a,b,c: a·(b+c) = a·b + a·c) — carried as two math:structureOperation with the distributivity axiom through math:satisfiesAxiom. A subclass of math:AlgebraicStructure; a math:CommutativeRing is a ring whose multiplication commutes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CommutativeRing
    a owl:Class ;
    rdfs:subClassOf math:Ring ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Commutative Ring"@x-gmeow-english ;
    skos:definition "A math:Ring whose multiplication commutes (∀a,b: a·b = b·a). A subclass of math:Ring; a math:Field is a commutative ring whose non-zero elements form a group under multiplication, and a math:PolynomialRing is a commutative ring of polynomials."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Field
    a owl:Class ;
    rdfs:subClassOf math:CommutativeRing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Field"@x-gmeow-english ;
    skos:definition "A math:CommutativeRing whose non-zero elements form an abelian group under multiplication — every non-zero element has a multiplicative inverse. A subclass of math:CommutativeRing; ℚ, ℝ, ℂ and the finite fields are fields, the ground over which a math:VectorSpace and Shamir secret sharing are defined."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Module
    a owl:Class ;
    rdfs:subClassOf math:AlgebraicStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Module"@x-gmeow-english ;
    skos:definition "An abelian group with a compatible scalar action of a math:Ring — the generalization of a vector space to scalars from a ring rather than a field. A subclass of math:AlgebraicStructure; a math:VectorSpace is a module over a field."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VectorSpace
    a owl:Class ;
    rdfs:subClassOf math:Module ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vector Space"@x-gmeow-english ;
    skos:definition "A math:Module whose scalars form a math:Field: an abelian group of vectors with a scalar action satisfying the vector-space axioms. A subclass of math:Module — the setting of linear algebra, on which a math:GroupRepresentation realizes a group as linear maps."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Algebra
    a owl:Class ;
    rdfs:subClassOf math:Module ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Algebra"@x-gmeow-english ;
    skos:definition "A math:Module equipped with a bilinear multiplication of its elements — a ring-and-module structure over a base ring, such as a math:LieAlgebra or a matrix algebra. A subclass of math:Module; the vector-space-with-multiplication that carries a Lie bracket in the E8 flagship."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PolynomialRing
    a owl:Class ;
    rdfs:subClassOf math:CommutativeRing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Polynomial Ring"@x-gmeow-english ;
    skos:definition "The commutative ring R[x] of polynomials in one or more indeterminates over a base ring R. A subclass of math:CommutativeRing; the ring a math:Ideal is taken in, and the ring a lattice-based homomorphic-encryption scheme and Shamir secret sharing operate over."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Ideal
    a owl:Class ;
    rdfs:subClassOf math:AlgebraicStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ideal"@x-gmeow-english ;
    skos:definition "A subset of a math:Ring closed under addition and under multiplication by any ring element — the kernel of a ring homomorphism is an ideal, and quotienting a ring by an ideal yields a math:Quotient ring. A subclass of math:AlgebraicStructure, related to its ambient ring through math:substructureOf; the modulus structure a lattice-based encryption scheme reduces against."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Structure properties -------------------------------------------------- #

math:underlyingSet
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "underlying set"@x-gmeow-english ;
    skos:definition "Names the carrier set of an algebraic structure — the elements the operations act on. Domain math:AlgebraicStructure, range math:Set (stated in prose). Every math:AlgebraicStructure declares one; a structure without a carrier is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:structureOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "structure operation"@x-gmeow-english ;
    skos:definition "Names a binary (or n-ary) operation of an algebraic structure — the group operation, or a ring's addition and multiplication. Domain math:AlgebraicStructure, range math:Operation (stated in prose). A ring carries two such operations; a structure with none is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:identityElement
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "identity element"@x-gmeow-english ;
    skos:definition "Names the two-sided identity of a monoid operation (the e with a·e = e·a = a). Domain math:Monoid or a richer structure, range an element of the math:underlyingSet (stated in prose). A math:Group inherits it from math:Monoid."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:inverseOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "inverse operation"@x-gmeow-english ;
    skos:definition "Names the unary inverse map of a group (a ↦ a⁻¹ with a·a⁻¹ = e). Domain math:Group, range math:Operation (stated in prose). The existence of inverses is what distinguishes a math:Group from a math:Monoid."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:satisfiesAxiom
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "satisfies axiom"@x-gmeow-english ;
    skos:definition "Relates an algebraic structure to a math:Axiom it obeys — associativity, commutativity, distributivity. Domain math:AlgebraicStructure, range math:Axiom (stated in prose). The axiom denotes a logic: formula the logic: reasoner owns: math: declares that the structure satisfies the law, logic: reasons over it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:satisfiesDistributivity
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:satisfiesAxiom ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "satisfies distributivity"@x-gmeow-english ;
    skos:definition "Names the distributivity axiom a math:Ring satisfies — multiplication distributes over addition (a·(b+c) = a·b + a·c), the law that makes a two-operation structure a ring rather than two unrelated groups. Domain math:Ring, range a math:Axiom denoting a logic: formula (stated in prose). A refinement of math:satisfiesAxiom: a ring must name a distributivity law specifically, not merely some axiom. A ring without distributivity is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:substructureOf
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "substructure of"@x-gmeow-english ;
    skos:definition "Relates an algebraic structure to a structure of the same kind that contains it and shares its operations — a subgroup within a group, an ideal within a ring. Domain and range math:AlgebraicStructure (stated in prose). Transitive: a subgroup of a subgroup is a subgroup. The kernel of a homomorphism is a math:substructureOf its domain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:preservesStructure
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "preserves structure"@x-gmeow-english ;
    skos:definition "Relates a math:Morphism to a structural feature it preserves — the object-layer primitive that math:preservedOperation refines for homomorphisms. Domain math:Morphism, range an operation or axiom (stated in prose). What a map preserves is declared, not assumed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Structure conformance failure ----------------------------------------- #

math:IncompleteAlgebraicStructure
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Algebraic Structure"@x-gmeow-english ;
    skos:definition "The failure raised when a math:AlgebraicStructure does not declare its constituting parts — a math:underlyingSet, at least one math:structureOperation, and at least one math:satisfiesAxiom law. A group is a set with an operation satisfying stated axioms; a structure asserted without them is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:NonDistributiveRing
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Non-Distributive Ring"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Ring does not declare, through math:satisfiesDistributivity, the distributivity law that ties its two operations together. Distributivity (a·(b+c) = a·b + a·c) is what makes a set with an addition and a multiplication a ring rather than two unrelated groups; a ring asserted without it is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Algebra — structure-preserving maps (homomorphisms) and the quotient/kernel
#
# A homomorphism is a map with a declared preserved operation and a preservation
# law that is a logic: formula (math: expresses, logic: reasons). A symmetry group
# IS an automorphism group; that identity is what makes E8's Weyl action, det, and
# a homomorphic-encryption scheme the same kind of object.
# =========================================================================== #

math:Homomorphism
    a owl:Class ;
    rdfs:subClassOf math:Morphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Homomorphism"@x-gmeow-english ;
    skos:definition "A structure-preserving map between algebraic structures of the same kind: it names, through math:preservedOperation, the operation it carries and, through math:preservationLaw, the logic: formula stating that carrying (φ(a·b) = φ(a)·φ(b)). A subclass of math:Morphism; its math:domain and math:codomain are math:AlgebraicStructure. math:kernel and math:image are first-class. A homomorphism asserted without a preserved operation and law is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GroupHomomorphism
    a owl:Class ;
    rdfs:subClassOf math:Homomorphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Group Homomorphism"@x-gmeow-english ;
    skos:definition "A homomorphism between groups: it preserves the single group operation (φ(a·b) = φ(a)·φ(b)), and its math:kernel is a normal subgroup of the domain. A subclass of math:Homomorphism; the determinant map det: GLₙ → ℝ* is one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RingHomomorphism
    a owl:Class ;
    rdfs:subClassOf math:Homomorphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ring Homomorphism"@x-gmeow-english ;
    skos:definition "A homomorphism between rings: it preserves both addition and multiplication, so it carries two preservation laws, and its math:kernel is an ideal. A subclass of math:Homomorphism; a homomorphic-encryption scheme is a (partial or full) ring homomorphism."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Isomorphism
    a owl:Class ;
    rdfs:subClassOf math:Homomorphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Isomorphism"@x-gmeow-english ;
    skos:definition "A bijective homomorphism — a structure-preserving map with a structure-preserving inverse, so its domain and codomain are the same structure up to relabelling. A subclass of math:Homomorphism; two structures are isomorphic exactly when a declared math:Isomorphism relates them."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Automorphism
    a owl:Class ;
    rdfs:subClassOf math:Isomorphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Automorphism"@x-gmeow-english ;
    skos:definition "An isomorphism of a structure with itself — a symmetry. A subclass of math:Isomorphism whose math:domain and math:codomain are the same structure. The automorphisms of a structure form a math:AutomorphismGroup under composition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AutomorphismGroup
    a owl:Class ;
    rdfs:subClassOf math:Group ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Automorphism Group"@x-gmeow-english ;
    skos:definition "The group of all automorphisms of a structure under composition — the symmetries of that structure. A subclass of math:Group: a symmetry group IS an automorphism group, the identity that makes E8's math:WeylGroup and every symmetry expressible with the same machinery as det and a homomorphic-encryption scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Quotient
    a owl:Class ;
    rdfs:subClassOf math:AlgebraicStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Quotient"@x-gmeow-english ;
    skos:definition "The quotient structure G/N of a structure by a substructure that is compatible with its operation (a normal subgroup, or an ideal) — the structure whose elements are the cosets of N. A subclass of math:AlgebraicStructure. The first isomorphism theorem states G/ker φ ≅ image φ, authored as a logic: formula the reasoner owns."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Homomorphism properties ----------------------------------------------- #

math:preservedOperation
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:preservesStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "preserved operation"@x-gmeow-english ;
    skos:definition "Names an operation a homomorphism carries from domain to codomain (φ(a·b) = φ(a)·φ(b)). Domain math:Homomorphism, range math:Operation (stated in prose). A group homomorphism names one; a ring homomorphism names two (addition and multiplication). The order-agnostic refinement of math:preservesStructure. A homomorphism without a preserved operation is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:preservationLaw
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "preservation law"@x-gmeow-english ;
    skos:definition "Names the law a homomorphism (or a homomorphic-encryption scheme) preserves, as a logic: formula — φ(a·b) = φ(a)·φ(b), or Dec(E(a) ⊗ E(b)) = a ⊕ b. Domain math:Homomorphism, range a logic: formula (stated in prose). The value denotes a logic: formula (the denotation seam, a resource), never an opaque string: math: declares the law and logic: owns reasoning over it. A homomorphism without a preservation law is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:kernel
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "kernel"@x-gmeow-english ;
    skos:definition "Names the kernel of a homomorphism — the substructure of the domain mapped to the identity (for a group homomorphism a normal subgroup, for a ring homomorphism an ideal). Domain math:Homomorphism, range math:AlgebraicStructure (stated in prose). The kernel is a math:substructureOf the domain; the first isomorphism theorem relates it to the math:image through a math:Quotient."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:normalSubgroupOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:substructureOf ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "normal subgroup of"@x-gmeow-english ;
    skos:definition "Relates a normal subgroup to the group that contains it (gNg⁻¹ = N for all g) — the kind of subgroup one can quotient by. Domain and range math:Group (stated in prose); a refinement of math:substructureOf. Not transitive: A ◁ B and B ◁ C do not imply A ◁ C — in A₄ the Klein four-group V₄ ◁ A₄ and a two-element subgroup H ◁ V₄, yet H is not normal in A₄. The math:kernel of a group homomorphism is a math:normalSubgroupOf its domain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Homomorphism conformance failures ------------------------------------- #

math:UnderspecifiedHomomorphism
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Homomorphism"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Homomorphism does not declare both the operation it carries (math:preservedOperation) and its preservation law (math:preservationLaw). A map is a homomorphism only by declaring what it preserves and the law of that preservation; a homomorphism asserted without them is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:StringOnlyPreservationLaw
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "String-Only Preservation Law"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Homomorphism gives its math:preservationLaw as an opaque literal instead of denoting a logic: formula. The preservation law is the denotation seam to logic: reasoning; it must denote a formula (a resource), never a string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnanchoredAutomorphismGroup
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unanchored Automorphism Group"@x-gmeow-english ;
    skos:definition "The failure raised when a math:AutomorphismGroup does not declare, through math:automorphismGroupOf, the structure whose symmetries it collects. Every automorphism group is the symmetry group OF some structure — the invariant that makes E8's Weyl group the symmetry of the E8 root system rather than a free-floating group; an automorphism group asserted without its anchoring structure is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Algebra — group actions, Lie theory, and root systems (the E8 flagship)
#
# A group action is how a symmetry group acts on the thing it is a symmetry of; its
# action law is a logic: formula. A Lie group and its Lie algebra carry a root system
# with a Cartan matrix, Dynkin diagram, and Weyl group (the symmetry group of the root
# system, an automorphism group). E8 is the flagship: 240 roots, rank 8, Weyl order
# 696,729,600.
# =========================================================================== #

math:GroupAction
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Group Action"@x-gmeow-english ;
    skos:definition "An action of a math:Group on a set — a map assigning to each group element a transformation of the set, compatibly with the group operation ((g·h)·x = g·(h·x), e·x = x). It names the group and the set it math:actsOn, and its action law is a logic: formula. A group action is the mechanism of symmetry: the Weyl group of a root system acts on the roots."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LieGroup
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lie Group"@x-gmeow-english ;
    skos:definition "A group that is also a smooth manifold, with smooth group operations (its group-ness stated in prose to keep the profile clean). It carries a math:RootSystem through math:hasRootSystem and a math:LieAlgebra as its infinitesimal structure. E8 is the 248-dimensional exceptional simple Lie group."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LieAlgebra
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lie Algebra"@x-gmeow-english ;
    skos:definition "The infinitesimal structure of a math:LieGroup: a vector space with an alternating bilinear bracket satisfying the Jacobi identity (its algebra-ness stated in prose). It carries the same math:RootSystem as its Lie group. The E8 Lie algebra is the 248-dimensional exceptional simple Lie algebra."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RootSystem
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Root System"@x-gmeow-english ;
    skos:definition "A finite configuration of vectors (roots) in a Euclidean space satisfying the root-system axioms — the combinatorial heart of a semisimple Lie group. It declares its math:rootSystemRank, a math:CartanMatrix, a math:DynkinDiagram, and a math:WeylGroup (the symmetry group of the roots), and may carry its math:hasSimpleRoot base and math:rootCount. E8's root system has 240 roots in rank 8."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SimpleRoot
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Simple Root"@x-gmeow-english ;
    skos:definition "A root in the chosen base of a math:RootSystem — a basis of positive roots from which every root is a non-negative or non-positive integer combination. Reached through math:hasSimpleRoot. E8 has 8 simple roots, one per node of its Dynkin diagram."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CartanMatrix
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cartan Matrix"@x-gmeow-english ;
    skos:definition "The integer matrix of pairwise Cartan integers of a root system's simple roots — it encodes the whole root system up to isomorphism. Reached through math:cartanMatrix. E8's is the 8×8 Cartan matrix of the E8 Dynkin diagram."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DynkinDiagram
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dynkin Diagram"@x-gmeow-english ;
    skos:definition "The graph encoding a root system's simple roots and their angles — the pictorial classification datum of semisimple Lie algebras. Reached through math:dynkinDiagram. E8's is the 8-node Dynkin diagram of the exceptional series."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:WeylGroup
    a owl:Class ;
    rdfs:subClassOf math:AutomorphismGroup ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Weyl Group"@x-gmeow-english ;
    skos:definition "The group generated by the reflections in the hyperplanes orthogonal to a root system's roots — the symmetry group of the root system, and so a math:AutomorphismGroup (hence a math:Group) that math:actsOn the roots. Reached through math:weylGroup. E8's Weyl group has order 696,729,600."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Lattice
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lattice"@x-gmeow-english ;
    skos:definition "A discrete subgroup of a real vector space that spans it — a regular grid of points closed under addition. The E8 lattice is the densest lattice packing in 8 dimensions; lattices are also the hardness substrate of lattice-based homomorphic encryption. (The order-theoretic lattice is a distinct notion, named elsewhere.)"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GroupRepresentation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Group Representation"@x-gmeow-english ;
    skos:definition "A homomorphism from a group into the general linear group of a math:VectorSpace — a realization of the abstract group as linear transformations. It names the group it is a math:representationOf. E8's 248-dimensional adjoint representation acts on its own Lie algebra."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Group-action and Lie/root-system properties --------------------------- #

math:actsOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "acts on"@x-gmeow-english ;
    skos:definition "Relates a math:GroupAction (or a group acting) to the set or structure it acts on. Domain math:GroupAction or math:Group, range math:Set or math:AlgebraicStructure (stated in prose). A math:WeylGroup math:actsOn the roots of its math:RootSystem."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:automorphismGroupOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "automorphism group of"@x-gmeow-english ;
    skos:definition "Relates a math:AutomorphismGroup to the structure whose symmetries it collects — an automorphism group is always the symmetry group OF something. Domain math:AutomorphismGroup, range math:AlgebraicStructure or math:RootSystem (stated in prose). A math:WeylGroup math:automorphismGroupOf its root system: W(E8) is the automorphism group of the E8 root system. This is the invariant that makes a symmetry group anchored — an automorphism group declared without the structure it is the symmetry of is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasRootSystem
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has root system"@x-gmeow-english ;
    skos:definition "Relates a math:LieGroup or math:LieAlgebra to its math:RootSystem. Domain math:LieGroup or math:LieAlgebra, range math:RootSystem (stated in prose). A semisimple Lie group without a root system is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasSimpleRoot
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has simple root"@x-gmeow-english ;
    skos:definition "Relates a math:RootSystem to a math:SimpleRoot in its chosen base. Domain math:RootSystem, range math:SimpleRoot (stated in prose). E8 has eight."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:cartanMatrix
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "cartan matrix"@x-gmeow-english ;
    skos:definition "Relates a math:RootSystem to its math:CartanMatrix. Domain math:RootSystem, range math:CartanMatrix (stated in prose). A root system declares one; it encodes the system up to isomorphism."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:dynkinDiagram
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dynkin diagram"@x-gmeow-english ;
    skos:definition "Relates a math:RootSystem to its math:DynkinDiagram. Domain math:RootSystem, range math:DynkinDiagram (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:weylGroup
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "weyl group"@x-gmeow-english ;
    skos:definition "Relates a math:RootSystem to its math:WeylGroup — the symmetry group of the roots. Domain math:RootSystem, range math:WeylGroup (stated in prose). A root system declares one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:rootSystemRank
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "root system rank"@x-gmeow-english ;
    skos:definition "The rank of a math:RootSystem — the dimension of the space it spans, equal to the number of simple roots. Domain math:RootSystem, range a non-negative integer (stated in prose). E8 has rank 8."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:rootCount
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "root count"@x-gmeow-english ;
    skos:definition "The number of roots in a math:RootSystem — a validatable invariant of the system. Domain math:RootSystem, range a non-negative integer (stated in prose). E8 has 240 roots."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:groupOrder
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "group order"@x-gmeow-english ;
    skos:definition "The order (number of elements) of a finite math:Group — a validatable invariant. Domain math:Group, range a positive integer (stated in prose). E8's math:WeylGroup has order 696,729,600."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:representationOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "representation of"@x-gmeow-english ;
    skos:definition "Relates a math:GroupRepresentation to the math:Group it represents as linear maps. Domain math:GroupRepresentation, range math:Group (stated in prose). E8's adjoint representation is a math:representationOf E8."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Lie conformance failure ----------------------------------------------- #

math:IncompleteLieStructure
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Lie Structure"@x-gmeow-english ;
    skos:definition "The failure raised when a math:LieGroup does not declare its math:hasRootSystem, or a math:RootSystem does not declare its math:cartanMatrix, math:weylGroup, and math:rootSystemRank. The root-system data is what makes a Lie structure expressible and its symmetry an automorphism group; a Lie structure asserted without it is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:WrongE8WeylOrder
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Wrong E8 Weyl Order"@x-gmeow-english ;
    skos:definition "The failure raised when a math:RootSystem carries the E8 fingerprint (240 roots in rank 8) yet declares a math:weylGroup whose math:groupOrder is not 696,729,600 — the true order of W(E8). The flagship's numbers are a validatable invariant, not decoration: a root system claiming to be E8 with a corrupted Weyl order is ill-formed, and the gate rejects it rather than trusting the value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Algebra — homomorphic encryption (the HE flagship) and secret sharing
#
# Homomorphic encryption is a ring homomorphism whose preservation law
# (Dec(E(a) ⊗ E(b)) = a ⊕ b) is exactly what makes it useful — a logic: formula over
# the ring/lattice structure. It names the operation it is homomorphic over, its
# lattice-hardness assumption, and its noise model; encrypt/evaluate/decrypt are
# activities. The purest exercise of the one-way math: → logic: bridge.
# =========================================================================== #

math:EncryptionScheme
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Encryption Scheme"@x-gmeow-english ;
    skos:definition "A scheme mapping plaintexts to ciphertexts under a key, with encrypt and decrypt operations. The parent of math:HomomorphicEncryptionScheme; an ordinary scheme need not preserve any algebraic operation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:HomomorphicEncryptionScheme
    a owl:Class ;
    rdfs:subClassOf math:EncryptionScheme , math:RingHomomorphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Homomorphic Encryption Scheme"@x-gmeow-english ;
    skos:definition "An encryption scheme that is (partially or fully) a math:RingHomomorphism — computation on ciphertexts corresponds to computation on plaintexts. It names the operation it is math:homomorphicOver, its math:securityAssumption (a math:LatticeHardnessAssumption), and its math:noiseModel; its math:preservationLaw is Dec(E(a) ⊗ E(b)) = a ⊕ b as a logic: formula; and its encrypt/evaluate/decrypt steps are gmeow:Activity processes. Both a math:EncryptionScheme and a math:RingHomomorphism — the same map+law object as det and the Weyl action."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LatticeHardnessAssumption
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lattice Hardness Assumption"@x-gmeow-english ;
    skos:definition "A computational-hardness assumption over lattices on which a scheme's security rests — Learning With Errors (LWE) or its ring variant (RLWE). Its instances are math:learningWithErrors and math:ringLearningWithErrors. A homomorphic-encryption scheme names one through math:securityAssumption."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:learningWithErrors
    a owl:NamedIndividual , math:LatticeHardnessAssumption ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Learning With Errors (LWE)"@x-gmeow-english ;
    skos:definition "The Learning With Errors problem: recovering a secret from noisy linear equations mod q, conjectured hard even for quantum computers. The hardness assumption of many lattice-based schemes."@x-gmeow-english .

math:ringLearningWithErrors
    a owl:NamedIndividual , math:LatticeHardnessAssumption ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ring Learning With Errors (RLWE)"@x-gmeow-english ;
    skos:definition "The ring variant of Learning With Errors, over a math:PolynomialRing — more efficient and the basis of most practical homomorphic-encryption schemes."@x-gmeow-english .

# --- Homomorphic-encryption properties ------------------------------------- #

math:homomorphicOver
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:preservedOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homomorphic over"@x-gmeow-english ;
    skos:definition "Names the ring operation a homomorphic-encryption scheme carries from plaintext to ciphertext — the operation the homomorphic property holds for. Domain math:HomomorphicEncryptionScheme, range math:Operation (stated in prose). A refinement of math:preservedOperation: being homomorphic over an operation is preserving it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:securityAssumption
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "security assumption"@x-gmeow-english ;
    skos:definition "Names the hardness assumption a scheme's security rests on. Domain math:EncryptionScheme, range math:LatticeHardnessAssumption (stated in prose). A homomorphic-encryption scheme without a stated hardness assumption is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:noiseModel
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "noise model"@x-gmeow-english ;
    skos:definition "Names the noise-growth model of a lattice-based scheme — noise accumulates with each homomorphic operation and must stay below a decryption threshold. Domain math:HomomorphicEncryptionScheme, range a noise-model object (stated in prose). A homomorphic scheme without a noise model is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:encryptOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "encrypt operation"@x-gmeow-english ;
    skos:definition "Relates an encryption scheme to its encryption process — a gmeow:Activity mapping plaintext to ciphertext. Domain math:EncryptionScheme, range gmeow:Activity (stated in prose). The process, not the result or the claim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:evaluateOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "evaluate operation"@x-gmeow-english ;
    skos:definition "Relates a homomorphic-encryption scheme to its homomorphic-evaluation process — a gmeow:Activity computing on ciphertexts. Domain math:HomomorphicEncryptionScheme, range gmeow:Activity (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:decryptOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "decrypt operation"@x-gmeow-english ;
    skos:definition "Relates an encryption scheme to its decryption process — a gmeow:Activity mapping ciphertext back to plaintext. Domain math:EncryptionScheme, range gmeow:Activity (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Homomorphic-encryption conformance failure ---------------------------- #

math:UnderspecifiedEncryptionScheme
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Encryption Scheme"@x-gmeow-english ;
    skos:definition "The failure raised when a math:HomomorphicEncryptionScheme does not declare the operation it is math:homomorphicOver, its math:securityAssumption, and its math:noiseModel. These are what make the homomorphic claim meaningful and its security stateable; a scheme asserted without them is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Dogfooding — algebra grounds GMEOW's own domain concepts (math:formalizes)
#
# The one-way bridge (Principle 19): a math: term formalizes a gmeow: domain concept,
# surfaced in the domain term's documentation without the domain slice asserting any
# math: triple. This makes algebra grounding for the rest of the ontology, not a
# math island.
# =========================================================================== #

math:Lattice math:formalizes gmeow:tuningSystemJustIntonation .

# The well-ordered integers ℤ ground the diagnostics grade ordinal (Principle 19):
# gmeow:gradeOrdinal is a monotone order-embedding of each diagnostics truth-order
# ⊑-chain (severity, standpoint, blocking) into (ℤ, ≤), so the numeric rank embeds
# the poset without claiming a metric spacing.
math:integers math:formalizes gmeow:gradeOrdinal .

# =========================================================================== #
# Measure, integration, and dimension (MEASURE-AND-DIMENSION charter)
#
# Two jobs meet here. Measure and integration give probability its foundation
# — a probability measure is a measure of total mass one, so the probability
# charter specializes this vocabulary rather than duplicating it. Dimension is
# the cross-cutting invariant: every quantity carries a dimension (an element of
# the ℚ-vector space over the seven SI base dimensions) and dimensional
# homogeneity is a reasoned hard-fail, not asserted data.
# =========================================================================== #

# --- Measurable spaces, measures, and integration --------------------------- #

math:MeasurableSpace
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Measurable Space"@x-gmeow-english ;
    skos:definition "A measurable space (X, Σ): a set X together with a σ-algebra Σ of its measurable subsets. Names its underlying set and its σ-algebra through math:measurableSpaceOf. The domain a math:Measure assigns mass over and the domain a math:Integral integrates over; shared with the probability charter, where a probability space is a measurable space carrying a probability measure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SigmaAlgebra
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "σ-Algebra"@x-gmeow-english ;
    skos:definition "A σ-algebra over a set: a collection of subsets closed under complement and countable union (and hence countable intersection), containing the whole set. The measurable sets of a math:MeasurableSpace — the events a math:Measure can assign mass to. Shared with the probability charter, where the σ-algebra is the event space of a probability space."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Measure
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Measure"@x-gmeow-english ;
    skos:definition "A measure μ: a countably-additive assignment of non-negative extended-real mass to the measurable sets of a math:MeasurableSpace. Names the space it acts on through math:measureOn and its total mass through math:totalMass — which may be a finite non-negative number or math:PositiveInfinity (a σ-finite measure such as a math:LebesgueMeasure on the line, or a math:CountingMeasure on an infinite set, has infinite total mass). The general object every mass-bearing construction specializes: a math:ProbabilityMeasure is a measure of total mass one, and a math:Integral integrates a math:MeasurableFunction against a measure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LebesgueMeasure
    a owl:Class ;
    rdfs:subClassOf math:Measure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lebesgue Measure"@x-gmeow-english ;
    skos:definition "The Lebesgue measure: the canonical translation-invariant measure on ℝⁿ that assigns to an interval its length (area, volume). A subclass of math:Measure; the continuous counterpart of the discrete math:CountingMeasure. Its total mass over an unbounded space is math:PositiveInfinity, though it is σ-finite. Integration against it recovers the ordinary Riemann integral where that exists."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CountingMeasure
    a owl:Class ;
    rdfs:subClassOf math:Measure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Counting Measure"@x-gmeow-english ;
    skos:definition "The counting measure: the measure that assigns to a set the number of its elements. A subclass of math:Measure; the discrete counterpart of the continuous math:LebesgueMeasure. Its total mass over an infinite set is math:PositiveInfinity. Integration against it turns an integral into a sum, unifying the continuous and discrete cases under one math:Integral object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProbabilityMeasure
    a owl:Class ;
    rdfs:subClassOf math:Measure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability Measure"@x-gmeow-english ;
    skos:definition "A probability measure: a math:Measure of total mass one (math:totalMass 1). The probability bridge — the probability charter specializes this class rather than re-minting it, so a probability space is a math:MeasurableSpace carrying a probability measure and an expectation is a math:Integral against it. A probability measure that does not have total mass one is ill-formed (math:ProbabilityMeasureMassViolation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MeasurableFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Measurable Function"@x-gmeow-english ;
    skos:definition "A measurable function: a function between measurable spaces under which the preimage of every measurable set is measurable. A subclass of math:Function, so it declares its math:domain and math:codomain. The integrand of a math:Integral is a measurable function; density and mass functions in the probability charter are measurable functions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Integral
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Integral"@x-gmeow-english ;
    skos:definition "An integral ∫_D f dμ as a first-class object: the application of a math:IntegrationOperator naming its integrand (math:integrand, a math:MeasurableFunction), its domain (math:integrationDomain, a math:MeasurableSpace or measurable set), and the measure it integrates against (math:withRespectTo, a math:Measure). It carries the dimension of its result through math:hasDimension; the homogeneity gate checks that this equals the integrand's dimension combined with the measure's. An expectation in the probability charter is an integral against a probability measure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IntegrationOperator
    a owl:Class ;
    rdfs:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Integration Operator"@x-gmeow-english ;
    skos:definition "The integration operator ∫ · dμ: a binder over the integration variable that a math:Integral applies. A subclass of math:Operation; because it binds the integration variable it is a binding form (a binder in the sense of the mathematical-expression surface this bedrock builds on), which is why an integral is a first-class expression object rather than a display string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PositiveInfinity
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "+∞"@x-gmeow-english ;
    skos:definition "Positive infinity as an extended-real value: the total mass of a σ-finite but non-finite measure such as a math:LebesgueMeasure on the line or a math:CountingMeasure on an infinite set. A math:totalMass is either a finite non-negative number or this individual; it is the extended-real point that makes an infinite measure declarable without a finite literal."@x-gmeow-english .

# --- Dimension — the cross-cutting invariant -------------------------------- #

math:Dimension
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimension"@x-gmeow-english ;
    skos:definition "A physical dimension: an element of the ℚ-vector space over the seven SI base dimensions (length, mass, time, electric current, thermodynamic temperature, amount of substance, luminous intensity). Product of dimensions adds their exponent vectors, a power scalar-multiplies, math:dimensionless is the identity, and two dimensions are equal exactly when their exponent vectors are equal — the derived math:commensurableWith relation. Exponents are exact rationals (ℚ, admitting fractional dimensions such as T^(−1/2)), never floating-point. A math:Quantity carries its dimension through math:hasDimension."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BaseDimension
    a owl:Class ;
    rdfs:subClassOf math:Dimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Base Dimension"@x-gmeow-english ;
    skos:definition "One of the seven SI base dimensions — a generator of the ℚ-vector space of dimensions. The seven individuals are math:lengthDimension (L), math:massDimension (M), math:timeDimension (T), math:electricCurrentDimension (I), math:temperatureDimension (Θ), math:amountOfSubstanceDimension (N), and math:luminousIntensityDimension (J). A base dimension is a basis vector; it carries no math:baseDimensionExponent list because it is itself a generator, not a product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DerivedDimension
    a owl:Class ;
    rdfs:subClassOf math:Dimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Derived Dimension"@x-gmeow-english ;
    skos:definition "A dimension expressed as a product of powers of the base dimensions — velocity L·T⁻¹, energy M·L²·T⁻², and so on. It records that product as a set of math:DimensionExponent cells through math:baseDimensionExponent (one edge per base dimension it involves), each naming a math:BaseDimension (math:exponentOfDimension) and an exact-rational power (math:exponentNumerator over math:exponentDenominator). The cells are an unordered set — a product commutes — so no list order is imposed. Its human-readable math:dimensionVector string is a computed projection of that structured set, never an independent source."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Dimensionless
    a owl:Class ;
    rdfs:subClassOf math:Dimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimensionless"@x-gmeow-english ;
    skos:definition "The dimensionless quantity: the identity element of the dimension vector space, whose exponent vector is zero on every base dimension. A ratio of commensurable quantities, a probability, a correlation, and an angle are all math:dimensionless. The distinguished individual is math:dimensionless."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DimensionalExpression
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimensional Expression"@x-gmeow-english ;
    skos:definition "An expression whose operands must be dimensionally homogeneous — an addition, a subtraction, an equation, or a comparison, where every operand must share one dimension. Names its operands through math:homogeneousOperand (at least two). The homogeneity gate collects the dimensions of the operands and raises math:DimensionalInhomogeneity if they are not all equal. This is the first-class carrier of the homogeneity invariant; the full expression grammar (indexed argument slots) belongs to the mathematical-core surface this bedrock builds on, which will refine this class."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Quantity
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Quantity"@x-gmeow-english ;
    skos:definition "A dimensioned quantity: a value that carries a math:Dimension through math:hasDimension and, where measured, a unit (gmeow:unit, aligned to QUDT / OM 2) that realizes that dimension and a numeric magnitude (math:quantityValue). Every quantity carries a dimension — an undimensioned quantity is ill-formed (math:UndimensionedQuantity). Units live within a dimension; two quantities are comparable exactly when their dimensions are equal (math:commensurableWith)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DimensionExponent
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimension Exponent"@x-gmeow-english ;
    skos:definition "One (base dimension, exact-rational power) cell of a derived dimension's product form: it names the math:BaseDimension it raises (math:exponentOfDimension) and the power, as an exact rational, through math:exponentNumerator over math:exponentDenominator (denominator non-zero). The cells named by a math:DerivedDimension's math:baseDimensionExponent edges together give its exponent vector over the seven base dimensions. Rational, not decimal, so equality of dimensions is exact."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Base-dimension individuals (the ℚ⁷ generators) ------------------------- #

math:lengthDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "length (L)"@x-gmeow-english ;
    skos:definition "The SI base dimension of length, L — realized by the metre. A generator of the dimension vector space."@x-gmeow-english .

math:massDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "mass (M)"@x-gmeow-english ;
    skos:definition "The SI base dimension of mass, M — realized by the kilogram. A generator of the dimension vector space."@x-gmeow-english .

math:timeDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "time (T)"@x-gmeow-english ;
    skos:definition "The SI base dimension of time, T — realized by the second. A generator of the dimension vector space."@x-gmeow-english .

math:electricCurrentDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "electric current (I)"@x-gmeow-english ;
    skos:definition "The SI base dimension of electric current, I — realized by the ampere. A generator of the dimension vector space."@x-gmeow-english .

math:temperatureDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "thermodynamic temperature (Θ)"@x-gmeow-english ;
    skos:definition "The SI base dimension of thermodynamic temperature, Θ — realized by the kelvin. A generator of the dimension vector space."@x-gmeow-english .

math:amountOfSubstanceDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "amount of substance (N)"@x-gmeow-english ;
    skos:definition "The SI base dimension of amount of substance, N — realized by the mole. A generator of the dimension vector space."@x-gmeow-english .

math:luminousIntensityDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "luminous intensity (J)"@x-gmeow-english ;
    skos:definition "The SI base dimension of luminous intensity, J — realized by the candela. A generator of the dimension vector space."@x-gmeow-english .

math:dimensionless
    a owl:NamedIndividual , math:Dimensionless ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dimensionless (1)"@x-gmeow-english ;
    skos:definition "The dimensionless dimension: the zero vector, the identity of the dimension vector space. The dimension of a ratio of commensurable quantities, a probability, a correlation, or an angle."@x-gmeow-english .

# --- Measure and dimension failure classes ---------------------------------- #

math:IncompleteMeasure
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Measure"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Measure does not declare the measurable space it acts on (math:measureOn) or its total mass (math:totalMass, a finite non-negative number or math:PositiveInfinity). A measure without its space and mass is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProbabilityMeasureMassViolation
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability-Measure Mass Violation"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ProbabilityMeasure does not have math:totalMass one. A probability measure is exactly a measure of total mass one; any other total mass is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteIntegral
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Integral"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Integral does not name its integrand (math:integrand), its domain (math:integrationDomain), and the measure it integrates against (math:withRespectTo). An integral missing any of the three is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UndimensionedQuantity
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Undimensioned Quantity"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Quantity does not carry a math:Dimension through math:hasDimension. Every quantity carries a dimension; an undimensioned quantity is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MalformedDimension
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Malformed Dimension"@x-gmeow-english ;
    skos:definition "The failure raised when a dimension is structurally ill-formed: a math:DerivedDimension with no math:baseDimensionExponent list, an exponent cell whose math:exponentOfDimension is not a math:BaseDimension (so the exponent vector is undefined or cyclic), an exponent missing its numerator or denominator, or a math:dimensionVector string that does not match the canonical render of the structured exponent list (a divergent second source). Also raised when a math:DimensionalExpression carries fewer than two math:homogeneousOperand."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DimensionalInhomogeneity
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimensional Inhomogeneity"@x-gmeow-english ;
    skos:definition "The failure raised when an expression is dimensionally inhomogeneous: the operands of a math:DimensionalExpression do not all share one dimension, or a math:Integral's declared result dimension does not equal its integrand's dimension combined with its measure's. This is the no-optionality posture applied to dimensions — a dimensionally inhomogeneous expression is ill-formed. It is a reasoned gate, computed exactly from the rational exponent vectors of the ℚ-vector space of dimensions, not asserted data — this is GMEOW's differentiator over unit vocabularies that record conversions as data rather than deriving homogeneity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Measure properties ----------------------------------------------------- #

math:measurableSpaceOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "measurable space of"@x-gmeow-english ;
    skos:definition "Relates a math:MeasurableSpace to its underlying set or its σ-algebra — the components (X, Σ) that constitute it. Domain math:MeasurableSpace, range math:Set or math:SigmaAlgebra (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:measureOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "measure on"@x-gmeow-english ;
    skos:definition "Names the math:MeasurableSpace a measure assigns mass over. Domain math:Measure, range math:MeasurableSpace (stated in prose). Every math:Measure declares one; a measure without its space is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:totalMass
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "total mass"@x-gmeow-english ;
    skos:definition "The total mass a measure assigns to its whole space — a finite non-negative number or the extended-real math:PositiveInfinity. Domain math:Measure, range a non-negative numeric literal or math:PositiveInfinity (stated in prose). It is an rdf:Property, not an owl:ObjectProperty or owl:DatatypeProperty, precisely because its range spans both a datatype literal (the finite mass) and an individual (math:PositiveInfinity): neither DL property kind admits both, so the honest RDF supertype carries the extended-real range without a DL contradiction. A math:ProbabilityMeasure has total mass one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:integrand
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "integrand"@x-gmeow-english ;
    skos:definition "Names the math:MeasurableFunction a math:Integral integrates — the f in ∫_D f dμ. Domain math:Integral, range math:MeasurableFunction (stated in prose). Every integral names one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:integrationDomain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "integration domain"@x-gmeow-english ;
    skos:definition "Names the domain a math:Integral integrates over — the D in ∫_D f dμ, a math:MeasurableSpace or measurable set. Domain math:Integral, range math:MeasurableSpace or math:Set (stated in prose). Every integral names one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:withRespectTo
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "with respect to"@x-gmeow-english ;
    skos:definition "Names the math:Measure a math:Integral integrates against — the μ in ∫_D f dμ. Domain math:Integral, range math:Measure (stated in prose). Every integral names exactly one; it is the single measure property of an integral (an expectation integrates against a probability measure). The homogeneity gate combines the integrand's dimension with this measure's to check the integral's declared result dimension."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Dimension properties --------------------------------------------------- #

math:hasDimension
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has dimension"@x-gmeow-english ;
    skos:definition "Names the math:Dimension a quantity, integral, or dimensioned object carries. Domain math:Quantity (or another dimensioned object such as a math:Integral), range math:Dimension (stated in prose). Every math:Quantity declares exactly one — an undimensioned quantity is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:dimensionVector
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dimension vector"@x-gmeow-english ;
    skos:definition "The human-readable canonical rendering of a dimension's exponent vector, for example \"M·L2·T-2\" for energy. Domain math:Dimension, range xsd:string (stated in prose). A computed projection of the structured math:baseDimensionExponent list, never an independent authored source: where present it must match the canonical render of the structured exponents, or the dimension is malformed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:baseDimensionExponent
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "base dimension exponent"@x-gmeow-english ;
    skos:definition "Relates a math:DerivedDimension to one math:DimensionExponent cell of its product form over the base dimensions — one such edge per base dimension involved (an unordered set, since a product commutes). Domain math:DerivedDimension, range math:DimensionExponent (stated in prose). A base dimension carries no such edge — it is a generator, not a product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:exponentOfDimension
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exponent of dimension"@x-gmeow-english ;
    skos:definition "Names the math:BaseDimension that a math:DimensionExponent cell raises to a power. Domain math:DimensionExponent, range math:BaseDimension only (stated in prose) — never a derived dimension, so the exponent vector is well-defined and acyclic by construction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:exponentNumerator
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exponent numerator"@x-gmeow-english ;
    skos:definition "The numerator of the exact-rational power a math:DimensionExponent raises its base dimension to. Domain math:DimensionExponent, range xsd:integer (stated in prose). Together with math:exponentDenominator it gives an exact math:RationalNumber power — ℚ, admitting fractional dimensions such as T^(−1/2) — never a floating-point or decimal approximation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:exponentDenominator
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exponent denominator"@x-gmeow-english ;
    skos:definition "The denominator of the exact-rational power a math:DimensionExponent raises its base dimension to. Domain math:DimensionExponent, range xsd:integer (stated in prose), non-zero. Together with math:exponentNumerator it gives an exact math:RationalNumber power; a whole-number exponent uses denominator one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:commensurableWith
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "commensurable with"@x-gmeow-english ;
    skos:definition "Relates two quantities that share one dimension — the equivalence relation of equal dimension vectors, under which they can be added, compared, or subtracted. Domain and range math:Quantity (stated in prose). This relation is derived, not asserted: it is computed as the kernel-equivalence of the dimension map (quantities whose exact-rational exponent vectors are equal), so its reflexivity, symmetry, and transitivity are properties of the derivation, carried by no OWL characteristic (symmetric properties are outside the EL profile) — the competency query reads the computed equivalence classes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:homogeneousOperand
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homogeneous operand"@x-gmeow-english ;
    skos:definition "Relates a math:DimensionalExpression to one of the operands that must share its single dimension — a summand of an addition, a side of an equation, a term of a comparison. Domain math:DimensionalExpression, range a dimensioned object (a math:Quantity or another dimensioned expression) (stated in prose). An expression carries at least two; the homogeneity gate raises math:DimensionalInhomogeneity when their dimensions are not all equal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# The dimensional-homogeneity invariant as first-order logic: laws, and the
# native ℚ⁷ validator declared as their exact executable lowering
# (MEASURE-AND-DIMENSION — the charter's distinguished reasoned gate)
#
# math:DimensionalInhomogeneity is not a bare Rust side-channel: the invariant
# the native validator (crates/validate check_math_dimension_invariants)
# computes from the exact-rational ℚ⁷ exponent vectors is authored HERE as real
# logic:Formula first-order ASTs — math: expresses the law, logic: owns
# reasoning over it, exactly as the ALGEBRA preservation laws do. The validator
# is then declared as the LOWERING of these laws, carrying
# logic:preservationKind logic:ExactPreservation in the same loss ledger every
# other GMEOW lowering rides (Principle 17; no new preservation vocabulary is
# minted). The relation atoms are reified as logic:Type individuals per the
# HiLog reflection (logic:relation ranges over logic:Type), exactly as the det
# law reifies matMul/det; where a first-class math: property already names the
# relation, the reflection carries an rdfs:seeAlso back to it, so no near-synonym
# property is minted.
# =========================================================================== #

# --- Reified relation atoms (HiLog reflection of the dimension predicates) --- #

math:homogeneousOperandRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homogeneousOperand(E,o) ⟺ o is a homogeneous operand of expression E"@x-gmeow-english ;
    rdfs:seeAlso math:homogeneousOperand ;
    skos:definition "The HiLog reflection of math:homogeneousOperand as a binary relation individual, so the homogeneity law can predicate over it inside a logic:Formula atom. It reflects the existing property (rdfs:seeAlso), keeping the object level first-order rather than minting a second relation."@x-gmeow-english .

math:hasDimensionRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "hasDimension(x,d) ⟺ dimensioned object x carries dimension d"@x-gmeow-english ;
    rdfs:seeAlso math:hasDimension ;
    skos:definition "The HiLog reflection of math:hasDimension as a binary relation individual, so a law can predicate 'x carries dimension d' inside a logic:Formula atom. Reflects the existing property (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:integrandRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "integrand(I,f) ⟺ f is the integrand of integral I"@x-gmeow-english ;
    rdfs:seeAlso math:integrand ;
    skos:definition "The HiLog reflection of math:integrand as a binary relation individual, so the integral-composition law can predicate over it inside a logic:Formula atom. Reflects the existing property (rdfs:seeAlso)."@x-gmeow-english .

math:withRespectToRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "withRespectTo(I,μ) ⟺ μ is the measure integral I integrates against"@x-gmeow-english ;
    rdfs:seeAlso math:withRespectTo ;
    skos:definition "The HiLog reflection of math:withRespectTo as a binary relation individual, so the integral-composition law can predicate over it inside a logic:Formula atom. Reflects the existing property (rdfs:seeAlso)."@x-gmeow-english .

math:dimensionEqualityRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dimEqual(d1,d2) ⟺ dimensions d1 and d2 have equal ℚ⁷ exponent vectors"@x-gmeow-english ;
    rdfs:seeAlso math:commensurableWith ;
    skos:definition "The dimension-level equality relation the homogeneity law concludes: dimEqual(d1,d2) holds exactly when d1 and d2 have identical exact-rational exponent vectors over the seven SI base dimensions — the derived commensurability the native validator computes by exact rational arithmetic. It is the dimension-carrier of the same equivalence math:commensurableWith carries at the quantity level (rdfs:seeAlso); a HiLog reflection individual, not a first-class asserted property (the equality is derived, never authored)."@x-gmeow-english .

math:dimensionProductRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dimProduct(dA,dB,dC) ⟺ dC's exponent vector is dA's ⊕ dB's"@x-gmeow-english ;
    skos:definition "The dimension-product relation the integral-composition law concludes: dimProduct(dA,dB,dC) holds exactly when dC's exact-rational exponent vector is the vector sum of dA's and dB's — a product of dimensions adds exponent vectors in the ℚ-vector space of dimensions. A HiLog reflection individual over which the law predicates 'result = integrand ⊕ measure'; the native validator discharges it by exact rational vector addition."@x-gmeow-english .

# --- Law 1: dimensional homogeneity ----------------------------------------- #
# ∀E,o1,o2,d1,d2: homogeneousOperand(E,o1) ∧ homogeneousOperand(E,o2)
#                 ∧ hasDimension(o1,d1) ∧ hasDimension(o2,d2) → dimEqual(d1,d2)
# Any two homogeneous operands of a dimensional expression carry equal dimensions
# (equal ℚ⁷ exponent vectors). Its executable lowering is the native validator's
# homogeneity branch, which raises math:DimensionalInhomogeneity on any violation.

math:dimensionalHomogeneityLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dimensional homogeneity: an expression's operands share one dimension"@x-gmeow-english ;
    skos:definition "The homogeneity invariant of a math:DimensionalExpression as a universally-quantified first-order logic:Formula: for any two math:homogeneousOperand operands of the same expression, their carried dimensions have equal ℚ⁷ exponent vectors (dimEqual). math: expresses the law; logic: owns reasoning over it; the native validator is its exact executable lowering (math:dimensionalHomogeneityLowering)."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "E" ] ,
        [ logic:termIndex 1 ; logic:termVariable "o1" ] ,
        [ logic:termIndex 2 ; logic:termVariable "o2" ] ,
        [ logic:termIndex 3 ; logic:termVariable "d1" ] ,
        [ logic:termIndex 4 ; logic:termVariable "d2" ] ;
    logic:forall math:dimHomImpl .

math:dimHomImpl a logic:Formula ;
    logic:antecedent math:dimHomAnte ;
    logic:consequent math:dimHomCons .

math:dimHomAnte a logic:Formula ;
    logic:and math:dimHomA1 , math:dimHomA2 , math:dimHomA3 , math:dimHomA4 .

math:dimHomA1 a logic:Formula ; logic:relation math:homogeneousOperandRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "E" ] , [ logic:termIndex 1 ; logic:termVariable "o1" ] .
math:dimHomA2 a logic:Formula ; logic:relation math:homogeneousOperandRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "E" ] , [ logic:termIndex 1 ; logic:termVariable "o2" ] .
math:dimHomA3 a logic:Formula ; logic:relation math:hasDimensionRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "o1" ] , [ logic:termIndex 1 ; logic:termVariable "d1" ] .
math:dimHomA4 a logic:Formula ; logic:relation math:hasDimensionRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "o2" ] , [ logic:termIndex 1 ; logic:termVariable "d2" ] .

math:dimHomCons a logic:Formula ; logic:relation math:dimensionEqualityRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "d1" ] , [ logic:termIndex 1 ; logic:termVariable "d2" ] .

# --- Law 2: integral dimensional composition -------------------------------- #
# ∀I,f,μ,dR,dF,dM: integrand(I,f) ∧ withRespectTo(I,μ) ∧ hasDimension(I,dR)
#                 ∧ hasDimension(f,dF) ∧ hasDimension(μ,dM) → dimProduct(dF,dM,dR)
# An integral's declared result dimension is its integrand's dimension composed
# (⊕, exponent-vector addition) with its measure's. Its executable lowering is the
# native validator's integral branch, which raises math:DimensionalInhomogeneity
# when dim(result) ≠ dim(integrand) ⊕ dim(measure).

math:integralDimensionCompositionLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "integral composition: dim(result) = dim(integrand) ⊕ dim(measure)"@x-gmeow-english ;
    skos:definition "The dimensional-composition invariant of a math:Integral as a universally-quantified first-order logic:Formula: for an integral with integrand f (math:integrand) and measure μ (math:withRespectTo), the integral's declared result dimension equals f's dimension composed with μ's (dimProduct — exponent-vector addition in the ℚ-vector space). math: expresses the law; logic: owns reasoning over it; the native validator is its exact executable lowering (math:dimensionalHomogeneityLowering)."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "I" ] ,
        [ logic:termIndex 1 ; logic:termVariable "f" ] ,
        [ logic:termIndex 2 ; logic:termVariable "mu" ] ,
        [ logic:termIndex 3 ; logic:termVariable "dR" ] ,
        [ logic:termIndex 4 ; logic:termVariable "dF" ] ,
        [ logic:termIndex 5 ; logic:termVariable "dM" ] ;
    logic:forall math:intCompImpl .

math:intCompImpl a logic:Formula ;
    logic:antecedent math:intCompAnte ;
    logic:consequent math:intCompCons .

math:intCompAnte a logic:Formula ;
    logic:and math:intCompA1 , math:intCompA2 , math:intCompA3 , math:intCompA4 , math:intCompA5 .

math:intCompA1 a logic:Formula ; logic:relation math:integrandRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "I" ] , [ logic:termIndex 1 ; logic:termVariable "f" ] .
math:intCompA2 a logic:Formula ; logic:relation math:withRespectToRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "I" ] , [ logic:termIndex 1 ; logic:termVariable "mu" ] .
math:intCompA3 a logic:Formula ; logic:relation math:hasDimensionRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "I" ] , [ logic:termIndex 1 ; logic:termVariable "dR" ] .
math:intCompA4 a logic:Formula ; logic:relation math:hasDimensionRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "dF" ] .
math:intCompA5 a logic:Formula ; logic:relation math:hasDimensionRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mu" ] , [ logic:termIndex 1 ; logic:termVariable "dM" ] .

math:intCompCons a logic:Formula ; logic:relation math:dimensionProductRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "dF" ] , [ logic:termIndex 1 ; logic:termVariable "dM" ] , [ logic:termIndex 2 ; logic:termVariable "dR" ] .

# --- The native validator declared as the laws' exact executable lowering --- #
# The loss-ledger record: the native ℚ⁷ dimensional validator is the executable
# lowering of the two logic: laws above. Because it computes each dimension's
# exact-rational exponent vector and decides dimEqual / dimProduct by exact
# rational arithmetic — never rounding, never a divergent asserted label — it
# neither misses a genuine inhomogeneity nor invents a spurious one: it yields
# exactly the answers the canonical laws entail, hence logic:ExactPreservation
# (the same polarity vocabulary every other GMEOW lowering carries). A violation
# raises the typed failure math:DimensionalInhomogeneity.

math:dimensionalHomogeneityLowering
    a gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "native ℚ⁷ validator: exact lowering of the dimensional-homogeneity laws"@x-gmeow-english ;
    skos:definition "The declaration that the native dimensional-homogeneity validator (the check computing dimensions' exact-rational ℚ⁷ exponent vectors) is the executable lowering of math:dimensionalHomogeneityLaw and math:integralDimensionCompositionLaw. It decides the laws' dimEqual and dimProduct conclusions by exact rational arithmetic over the exponent vectors, so it neither misses a genuine inhomogeneity nor reports a spurious one — it yields exactly the answers the canonical laws entail. Hence logic:preservationKind logic:ExactPreservation, reusing the existing loss-ledger polarity vocabulary (Principle 17, no near-synonym minted). A violation raises the typed failure class math:DimensionalInhomogeneity. The laws are the source, the native gate the enforcement, and this record their preservation judgment in the loss ledger."@x-gmeow-english ;
    logic:preservationKind logic:ExactPreservation ;
    rdfs:seeAlso math:dimensionalHomogeneityLaw ,
        math:integralDimensionCompositionLaw ,
        math:DimensionalInhomogeneity .

# =========================================================================== #
# Mathematical-core binder AST (EXPRESSIONS charter — the subset the
# analysis-and-geometry charter consumes)
#
# Calculus operators (d/dx, ∂, ∫, ∑, lim) are binders over the expression AST,
# not display strings (MATHEMATICS-EXPRESSIONS.md §Expression AST layer). A
# math:BindingExpression is an application-shaped node: it names its binder
# operator through math:operator, its body through indexed math:argumentSlot
# cells, and the variable it binds through math:boundVariable. Binding is modeled
# with an explicit declaration/occurrence split so nested and shadowed binders —
# mixed partials ∂²/∂x∂y, a sum ∑ᵢ(xᵢ + ∑ᵢ yᵢ) whose inner i shadows the outer —
# are checkable: a math:VariableDeclaration is a variable's identity within a
# scope and a math:VariableOccurrence is a use site resolving to exactly one
# declaration, making α-equivalence a graph isomorphism rather than a string
# match. Any expression that crosses into reasoning declares what it denotes
# (math:denotationKind) and how it lowers (math:compilesToLogicTerm/Formula/Type)
# with a recorded preservation polarity — the seam that keeps the mathematical
# surface from silently becoming a logic: assertion. Bedrock landed
# math:ApplicationExpression + math:operator and deferred this surface; the
# analysis-and-geometry charter is its first consumer and lands exactly the
# subset its binders need, using the canonical reserved names (no near-synonyms).
# =========================================================================== #

# --- Expression AST: argument slots and the binding form -------------------- #

math:ArgumentSlot
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Argument Slot"@x-gmeow-english ;
    skos:definition "One indexed operand position of a math:ApplicationExpression or math:BindingExpression: it carries exactly one integer math:slotIndex and exactly one math:slotExpression. Operand order is carried by these slots, not by RDF list ordering — swapping two slots' expressions is a different expression, so non-commutative operators (matrix product, function composition, subtraction, the body of a binder) are order-safe. Slot indexes are unique within one application; strict canonical mode additionally requires them zero-based and contiguous. A slot missing its index or expression is ill-formed (math:MalformedArgumentSlot)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BindingExpression
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Binding Expression"@x-gmeow-english ;
    skos:definition "A binder: the expression node that binds a variable over a body. Application-shaped — it names its binder operator through math:operator (a math:Operation individual such as the differentiation, integration, summation, or limit binder), its body through indexed math:argumentSlot cells, and the math:VariableDeclaration it introduces through math:boundVariable. It binds math:VariableOccurrence use sites through math:bindsOccurrence, never glyphs, so nested and shadowed binders are checkable. The single binding form d/dx, ∂, ∫, ∑, and lim all specialize: a math:Derivative, a math:Limit, a math:Series, and a math:Integral are binding expressions, so no per-operator binder machinery is minted. A binder without a bound variable and a body is ill-formed (math:MalformedBindingExpression)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VariableExpression
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Variable Expression"@x-gmeow-english ;
    skos:definition "A variable used inside an expression: an expression node standing for one math:VariableOccurrence (math:variableOccurrence). Its occurrence is either bound by a math:BindingExpression or resolves to a math:FreeVariableDeclaration; there is no implicit free variable. This is the leaf of the AST where a bound or free variable enters a formula."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VariableDeclaration
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Variable Declaration"@x-gmeow-english ;
    skos:definition "The identity of a variable within a scope — the binding site's referent. Introduced by a math:BindingExpression through math:boundVariable, or standing alone as a math:FreeVariableDeclaration carrying a declared type/domain context. Every math:VariableOccurrence points at exactly one declaration through math:declaredVariable, so α-equivalence (same structure up to renaming of declarations) is a graph isomorphism over declarations rather than a string comparison. Two binders that reuse the glyph i introduce two distinct declarations."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FreeVariableDeclaration
    a owl:Class ;
    rdfs:subClassOf math:VariableDeclaration ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Free Variable Declaration"@x-gmeow-english ;
    skos:definition "A variable declaration not introduced by a binder: a free variable, standing alone with a declared type and domain context. The explicit marker that a variable occurrence is free — there is no implicit free variable, so an occurrence is either bound by a math:BindingExpression or resolves to a math:FreeVariableDeclaration with its type/domain declared."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VariableOccurrence
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Variable Occurrence"@x-gmeow-english ;
    skos:definition "A use site of a variable within an expression scope: it names the math:VariableDeclaration it refers to through math:declaredVariable and the scope it occurs in through math:occursInScope. A binder binds occurrences (math:bindsOccurrence), not glyphs, so an occurrence in the body of two nested binders that reuse a glyph resolves to exactly one of the two declarations. An occurrence that resolves to no declaration and is not marked free is ill-formed (math:UnscopedVariableOccurrence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DenotationKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Denotation Kind"@x-gmeow-english ;
    skos:definition "What a math:MathematicalExpression denotes when it crosses into reasoning: one of math:denotesObject (a mathematical object/value → a logic: term), math:denotesProposition (a proposition → a logic: formula), math:denotesType (a type/sort → a logic: type), math:denotesOperator (a function/relation/operator → a logic: predicate or function symbol), or math:denotesProof (a proof-term → a logic: proof object). The AST is not a second logic: an expression declares its denotation kind and its lowering so the mathematical surface and the reasoning surface compose instead of duplicating."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Denotation-kind individuals (the five lowering targets) ---------------- #

math:denotesObject
    a owl:NamedIndividual , math:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotes object / value"@x-gmeow-english ;
    skos:definition "The denotation kind of an expression standing for a mathematical object or value — a number, a limit, a definite integral, a tensor. It lowers to a logic: term through math:compilesToLogicTerm. The default kind of a computed value expression."@x-gmeow-english .

math:denotesProposition
    a owl:NamedIndividual , math:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotes proposition / formula"@x-gmeow-english ;
    skos:definition "The denotation kind of a truth-valued expression — an equation, an inequality, a convergence claim ∀ε∃δ. It lowers to a logic: formula through math:compilesToLogicFormula. A truth-valued expression does not become a logic: assertion until this kind and its lowering preservation are declared; silent promotion is forbidden (math:UndeclaredLogicLowering)."@x-gmeow-english .

math:denotesType
    a owl:NamedIndividual , math:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotes type / sort"@x-gmeow-english ;
    skos:definition "The denotation kind of an expression standing for a type, class, or sort — a function space, a manifold's structure kind. It lowers to a logic: type through math:compilesToLogicType."@x-gmeow-english .

math:denotesOperator
    a owl:NamedIndividual , math:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotes operator / function / relation"@x-gmeow-english ;
    skos:definition "The denotation kind of an expression standing for a function, relation, or operator — the differentiation operator, a continuous map. It lowers to a logic: predicate or function symbol."@x-gmeow-english .

math:denotesProof
    a owl:NamedIndividual , math:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotes proof / proof-term"@x-gmeow-english ;
    skos:definition "The denotation kind of an expression standing for a proof or proof-term. It lowers to a logic: proof object. The rarest kind, used where a proof term is carried as structured content rather than as prose."@x-gmeow-english .

# --- Binder-operator individuals (the binder symbols) ----------------------- #

math:differentiationBinder
    a owl:NamedIndividual , math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "d/dx (differentiation binder)"@x-gmeow-english ;
    skos:definition "The differentiation binder d/dx: the math:operator a math:Derivative binding expression applies, binding the variable of differentiation over the body it differentiates. Anchored to the OpenMath calculus1 diff symbol."@x-gmeow-english .

math:partialDifferentiationBinder
    a owl:NamedIndividual , math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "∂ (partial-differentiation binder)"@x-gmeow-english ;
    skos:definition "The partial-differentiation binder ∂: the math:operator a math:PartialDerivative binding expression applies, binding one variable while others are held. Mixed partials ∂²/∂x∂y are nested binding expressions, each with its own math:VariableDeclaration. Anchored to the OpenMath calculus1 partialdiff symbol."@x-gmeow-english .

math:summationBinder
    a owl:NamedIndividual , math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "∑ (summation binder)"@x-gmeow-english ;
    skos:definition "The summation binder ∑: the math:operator a math:Series binding expression applies, binding the summation index over the summand. A shadowed index ∑ᵢ(xᵢ + ∑ᵢ yᵢ) introduces two distinct math:VariableDeclarations. Anchored to the OpenMath arith1 sum symbol."@x-gmeow-english .

math:limitBinder
    a owl:NamedIndividual , math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "lim (limit binder)"@x-gmeow-english ;
    skos:definition "The limit binder lim: the math:operator a math:Limit binding expression applies, binding the variable that approaches the limit point over the body. Anchored to the OpenMath calculus1 limit symbol."@x-gmeow-english .

# --- Integration binder retrofit (∫ is a binding expression) ---------------- #

math:Integral rdfs:subClassOf math:BindingExpression .

# --- Binder AST conformance failures ---------------------------------------- #

math:MalformedArgumentSlot
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Malformed Argument Slot"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ArgumentSlot does not carry exactly one math:slotIndex and exactly one math:slotExpression, or when two slots of one application share an index. Operand order is carried by unique indexed slots; a slot missing its index or expression, or a duplicated index, is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnscopedVariableOccurrence
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unscoped Variable Occurrence"@x-gmeow-english ;
    skos:definition "The failure raised when a math:VariableOccurrence neither resolves to a math:VariableDeclaration through math:declaredVariable nor is marked free through a math:FreeVariableDeclaration. There is no implicit free variable; an occurrence that binds to nothing is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MalformedBindingExpression
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Malformed Binding Expression"@x-gmeow-english ;
    skos:definition "The failure raised when a math:BindingExpression does not name the math:VariableDeclaration it binds through math:boundVariable, or does not name its body through math:argumentSlot. A binder binds a variable over a body; a binder missing either is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UndeclaredLogicLowering
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Undeclared Logic Lowering"@x-gmeow-english ;
    skos:definition "The failure raised when a truth-valued math:MathematicalExpression is lowered into logic: (math:compilesToLogicFormula) without declaring its math:denotationKind and its math:logicLoweringPreservation. Silent promotion of a mathematical expression to a logical assertion is forbidden — an equation is a denotable object until something declares it a proposition and lowers it, with recorded preservation, into the reasoning layer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Binder AST properties -------------------------------------------------- #

math:argumentSlot
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "argument slot"@x-gmeow-english ;
    skos:definition "Relates a math:ApplicationExpression or math:BindingExpression to one math:ArgumentSlot carrying an indexed operand (or, for a binder, the body). Domain a math:ApplicationExpression or math:BindingExpression, range math:ArgumentSlot (stated in prose). Operand order is carried by the slots' math:slotIndex, never by RDF list ordering."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:slotIndex
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "slot index"@x-gmeow-english ;
    skos:definition "The integer position of a math:ArgumentSlot within its application — the operand order. Domain math:ArgumentSlot, range xsd:nonNegativeInteger (stated in prose). Unique within one application; strict canonical mode requires the indexes zero-based and contiguous. A slot without exactly one index is ill-formed (math:MalformedArgumentSlot)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:slotExpression
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "slot expression"@x-gmeow-english ;
    skos:definition "The math:MathematicalExpression filling one math:ArgumentSlot — the operand, or the body of a binder. Domain math:ArgumentSlot, range math:MathematicalExpression (stated in prose). Every slot names exactly one; a slot without an expression is ill-formed (math:MalformedArgumentSlot)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:boundVariable
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "bound variable"@x-gmeow-english ;
    skos:definition "Relates a math:BindingExpression to the math:VariableDeclaration it introduces and binds — the variable of differentiation, integration, summation, or the limit. Domain math:BindingExpression, range math:VariableDeclaration (stated in prose). Every binder names exactly one bound variable's declaration; a binder without one is ill-formed (math:MalformedBindingExpression). This is the edge through which a binder introduces its variable's scoped identity, over which its bound math:VariableOccurrence use sites resolve."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:bindsOccurrence
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "binds occurrence"@x-gmeow-english ;
    skos:definition "Relates a math:BindingExpression to a math:VariableOccurrence it binds — a use site of its bound variable within its body. Domain math:BindingExpression, range math:VariableOccurrence (stated in prose). A binder binds occurrences, not glyphs, so under nesting and shadowing each occurrence resolves to exactly one binder."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:declaredVariable
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "declared variable"@x-gmeow-english ;
    skos:definition "Relates a math:VariableOccurrence to the math:VariableDeclaration it refers to — the binding site or free declaration that gives the occurrence its identity. Domain math:VariableOccurrence, range math:VariableDeclaration (stated in prose). Every occurrence resolves to exactly one declaration; an occurrence resolving to none and not marked free is ill-formed (math:UnscopedVariableOccurrence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:occursInScope
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "occurs in scope"@x-gmeow-english ;
    skos:definition "Relates a math:VariableOccurrence to the math:MathematicalExpression scope it occurs in — the binding expression or sub-expression whose body contains the use site. Domain math:VariableOccurrence, range math:MathematicalExpression (stated in prose). Scope is what makes shadowing resolvable: an occurrence in the innermost scope binds to the innermost declaration of its glyph."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:variableOccurrence
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "variable occurrence"@x-gmeow-english ;
    skos:definition "Relates a math:VariableExpression leaf to the math:VariableOccurrence it stands for. Domain math:VariableExpression, range math:VariableOccurrence (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:denotationKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotation kind"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalExpression to the math:DenotationKind naming what it denotes when it crosses into reasoning — object/value, proposition, type, operator, or proof. Domain math:MathematicalExpression, range math:DenotationKind (stated in prose). A truth-valued expression declares this before lowering to a logic: formula; an undeclared lowering is ill-formed (math:UndeclaredLogicLowering)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:compilesToLogicTerm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "compiles to logic: term"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalExpression that denotes an object/value to the logic: term it lowers to. Domain math:MathematicalExpression (math:denotationKind math:denotesObject), range a logic: term (stated in prose). The explicit, preservation-judged map that keeps the mathematical AST from re-implementing the logic: IR."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:compilesToLogicFormula
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "compiles to logic: formula"@x-gmeow-english ;
    skos:definition "Relates a truth-valued math:MathematicalExpression to the logic:Formula it lowers to. Domain math:MathematicalExpression (math:denotationKind math:denotesProposition), range logic:Formula (stated in prose). Present only with a declared math:denotationKind and math:logicLoweringPreservation; silent promotion to a logical assertion is forbidden (math:UndeclaredLogicLowering)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:compilesToLogicType
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "compiles to logic: type"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalExpression that denotes a type/sort to the logic: type it lowers to. Domain math:MathematicalExpression (math:denotationKind math:denotesType), range a logic: type (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:logicLoweringPreservation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "logic lowering preservation"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalExpression to the preservation polarity of its lowering into logic:, reusing the shared loss-ledger vocabulary (logic:preservationKind values such as logic:ExactPreservation, logic:SoundUnderApproximation, logic:CompleteOverApproximation). Domain math:MathematicalExpression, range a logic:preservationKind value (stated in prose). No near-synonym is minted — mathematics lowering loss is queryable in the same ledger as every other GMEOW projection (Principle 17)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# Calculus and analysis (ANALYSIS-AND-GEOMETRY charter)
#
# Limits, derivatives, integrals (∫ reused from the measure charter), series,
# sequences, and special functions. Every operator here is a binder over the
# expression AST: a math:Derivative, math:Limit, and math:Series are
# math:BindingExpressions applying the differentiation, limit, and summation
# binders (math:differentiationBinder, math:limitBinder, math:summationBinder),
# so the calculus surface reuses the single binding form rather than minting
# per-operator machinery. A derivative names what it differentiates, with respect
# to which variable, at which order; a limit names its expression and its limit
# point (and, where it matters, its direction/mode); a series/sequence carries a
# math:Convergence with its mode. Special functions are first-class individuals
# aligned to DLMF and OpenMath (calculus1/transc1), not new OWL classes.
# =========================================================================== #

# --- Calculus binders and analysis objects ---------------------------------- #

math:Derivative
    a owl:Class ;
    rdfs:subClassOf math:BindingExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Derivative"@x-gmeow-english ;
    skos:definition "The derivative d/dx f of an expression as a first-class binding expression: it applies the math:differentiationBinder (math:operator), names what it differentiates through math:derivativeOf, the variable of differentiation through math:withRespectToVariable (a math:VariableDeclaration it binds), and its order through math:derivativeOrder. A derivative is a map of function spaces, not the string 'dy/dx'. A derivative missing what it differentiates, its variable, or its order is ill-formed (math:UnderspecifiedDerivative)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PartialDerivative
    a owl:Class ;
    rdfs:subClassOf math:Derivative ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Partial Derivative"@x-gmeow-english ;
    skos:definition "A partial derivative ∂f/∂x: a math:Derivative that applies the math:partialDifferentiationBinder, differentiating with respect to one variable while others are held. Mixed partials ∂²f/∂x∂y are nested partial derivatives, each binding its own math:VariableDeclaration, so order and shadowing are explicit. A subclass of math:Derivative; it declares the same what/variable/order frame."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DifferentialOperator
    a owl:Class ;
    rdfs:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Differential Operator"@x-gmeow-english ;
    skos:definition "A differential operator: a map of function spaces built from derivatives — the gradient ∇, the Laplacian Δ, a linear ODE operator. A subclass of math:Operation whose action is differentiation; the math:differentiationBinder is the elementary case it composes. Distinguished from a single math:Derivative, which is one application of the differentiation binder to one expression."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Limit
    a owl:Class ;
    rdfs:subClassOf math:BindingExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Limit"@x-gmeow-english ;
    skos:definition "The limit lim_{x→a} f(x) as a first-class binding expression: it applies the math:limitBinder (math:operator), names the expression whose limit is taken through math:limitOf, the limit point a through math:limitPoint, and — where it matters — the direction/mode through math:limitMode (from the left, from the right, or two-sided). A limit missing its expression or its limit point is ill-formed (math:UnderspecifiedLimit); the mode is optional because a two-sided limit has no direction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LimitMode
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Limit Mode"@x-gmeow-english ;
    skos:definition "The direction in which a math:Limit approaches its limit point: one of math:limitFromLeft (x → a⁻), math:limitFromRight (x → a⁺), or math:limitTwoSided (x → a). A one-sided limit declares its side; a two-sided limit either declares math:limitTwoSided or omits the mode, since it has no direction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Sequence
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Sequence"@x-gmeow-english ;
    skos:definition "A sequence (aₙ): an indexed family, a math:Function whose math:domain is a subset of ℕ. It carries a math:Convergence through math:hasConvergence naming what it converges to and in which mode. A subclass of math:Function, so it declares its domain and codomain; a sequence asserted to converge without a math:Convergence naming the mode is ill-formed (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Series
    a owl:Class ;
    rdfs:subClassOf math:BindingExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Series"@x-gmeow-english ;
    skos:definition "A series ∑ aₙ as a first-class binding expression: it applies the math:summationBinder (math:operator), names its general term through math:seriesTerm (the summand, a body indexed by the bound summation math:VariableDeclaration), and carries a math:Convergence through math:hasConvergence naming what it converges to and in which mode (absolute, conditional, …). A series asserted to converge without a math:Convergence naming the mode is ill-formed (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Convergence
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Convergence"@x-gmeow-english ;
    skos:definition "The convergence of a sequence or series: names what it converges to through math:convergesTo and the mode through math:convergenceMode (pointwise, uniform, absolute, conditional, in-measure, almost-everywhere, in-Lᵖ-norm, in-distribution). Convergence in which mode is a declared property, not an assumption — 'the series converges' is meaningless without the mode. A convergence without a mode is ill-formed (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ConvergenceMode
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Convergence Mode"@x-gmeow-english ;
    skos:definition "The mode in which a sequence or series converges: one of math:pointwiseConvergence, math:uniformConvergence, math:absoluteConvergence, math:conditionalConvergence, math:inMeasureConvergence, math:almostEverywhereConvergence, math:inLpNormConvergence, or math:inDistributionConvergence. The mode is what distinguishes weak from strong convergence and is required on every math:Convergence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SpecialFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Special Function"@x-gmeow-english ;
    skos:definition "A special function: a named function of analysis — the gamma function Γ, the Riemann zeta function ζ, the Bessel functions, the error function erf — whose identity is the GMEOW individual, aligned to a DLMF equation ID and an OpenMath transc1/calculus1 symbol, not a rendering. The named functions are first-class individuals (math:gammaFunction, math:riemannZeta, …), not per-function OWL subclasses. A subclass of math:Function, so each declares its domain and codomain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Limit-mode individuals ------------------------------------------------- #

math:limitFromLeft
    a owl:NamedIndividual , math:LimitMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "from the left (x → a⁻)"@x-gmeow-english ;
    skos:definition "The one-sided limit from below: x approaches a through values less than a."@x-gmeow-english .

math:limitFromRight
    a owl:NamedIndividual , math:LimitMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "from the right (x → a⁺)"@x-gmeow-english ;
    skos:definition "The one-sided limit from above: x approaches a through values greater than a."@x-gmeow-english .

math:limitTwoSided
    a owl:NamedIndividual , math:LimitMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "two-sided (x → a)"@x-gmeow-english ;
    skos:definition "The two-sided limit: x approaches a from both sides, requiring the left and right limits to agree. The default when a math:Limit omits its mode."@x-gmeow-english .

# --- Convergence-mode individuals (the full enumeration) -------------------- #

math:pointwiseConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "pointwise"@x-gmeow-english ;
    skos:definition "Pointwise convergence: fₙ(x) → f(x) at each point x separately. The weakest of the function-convergence modes."@x-gmeow-english .

math:uniformConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "uniform"@x-gmeow-english ;
    skos:definition "Uniform convergence: sup_x |fₙ(x) − f(x)| → 0, one rate for all points. Stronger than pointwise; preserves continuity of the limit."@x-gmeow-english .

math:absoluteConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "absolute"@x-gmeow-english ;
    skos:definition "Absolute convergence of a series: ∑ |aₙ| converges. Implies convergence and permits reordering without changing the sum."@x-gmeow-english .

math:conditionalConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "conditional"@x-gmeow-english ;
    skos:definition "Conditional convergence of a series: ∑ aₙ converges but ∑ |aₙ| diverges. Reordering can change the sum (Riemann rearrangement)."@x-gmeow-english .

math:inMeasureConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "in measure"@x-gmeow-english ;
    skos:definition "Convergence in measure: for every ε, the measure of {x : |fₙ(x) − f(x)| ≥ ε} → 0. A measure-theoretic mode, weaker than almost-everywhere on a finite measure space."@x-gmeow-english .

math:almostEverywhereConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "almost everywhere"@x-gmeow-english ;
    skos:definition "Almost-everywhere convergence: fₙ(x) → f(x) for all x outside a set of measure zero. The measure-theoretic strengthening of pointwise."@x-gmeow-english .

math:inLpNormConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "in Lᵖ norm"@x-gmeow-english ;
    skos:definition "Convergence in Lᵖ norm: ‖fₙ − f‖_p → 0. The mode of the Banach spaces Lᵖ; L² convergence (mean-square) is the Hilbert-space case."@x-gmeow-english .

math:inDistributionConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "in distribution"@x-gmeow-english ;
    skos:definition "Convergence in distribution (weak convergence of measures): the distribution functions converge at every continuity point. The probabilistic mode underlying the central limit theorem; shared with the probability charter."@x-gmeow-english .

# --- Special-function individuals (DLMF/OpenMath anchored in mappings) ------- #

math:gammaFunction
    a owl:NamedIndividual , math:SpecialFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Γ (gamma function)"@x-gmeow-english ;
    math:domain math:complexNumbers ;
    math:codomain math:complexNumbers ;
    skos:definition "The gamma function Γ(z): the analytic continuation of the factorial, Γ(n) = (n−1)!. Aligned to DLMF chapter 5 and OpenMath transc1; its identity is this individual, not a rendering."@x-gmeow-english .

math:riemannZeta
    a owl:NamedIndividual , math:SpecialFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "ζ (Riemann zeta function)"@x-gmeow-english ;
    math:domain math:complexNumbers ;
    math:codomain math:complexNumbers ;
    skos:definition "The Riemann zeta function ζ(s) = ∑ n⁻ˢ (Re s > 1), analytically continued. Aligned to DLMF chapter 25 and Wikidata; the subject of the Riemann hypothesis."@x-gmeow-english .

math:besselJ
    a owl:NamedIndividual , math:SpecialFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Jₙ (Bessel function, first kind)"@x-gmeow-english ;
    math:domain math:realNumbers ;
    math:codomain math:realNumbers ;
    skos:definition "The Bessel function of the first kind Jₙ(x): a solution of Bessel's equation regular at the origin. Aligned to DLMF chapter 10."@x-gmeow-english .

math:besselY
    a owl:NamedIndividual , math:SpecialFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Yₙ (Bessel function, second kind)"@x-gmeow-english ;
    math:domain math:realNumbers ;
    math:codomain math:realNumbers ;
    skos:definition "The Bessel function of the second kind Yₙ(x): a solution of Bessel's equation singular at the origin. Aligned to DLMF chapter 10."@x-gmeow-english .

math:errorFunction
    a owl:NamedIndividual , math:SpecialFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "erf (error function)"@x-gmeow-english ;
    math:domain math:realNumbers ;
    math:codomain math:realNumbers ;
    skos:definition "The error function erf(x) = (2/√π) ∫₀ˣ e^(−t²) dt: the Gaussian integral central to probability. Aligned to DLMF chapter 7 and OpenMath transc1."@x-gmeow-english .

# --- Calculus conformance failures ------------------------------------------ #

math:UnderspecifiedDerivative
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Derivative"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Derivative does not name what it differentiates (math:derivativeOf), the variable of differentiation (math:withRespectToVariable), and its order (math:derivativeOrder). A derivative that does not say what, with respect to which variable, and at what order is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnderspecifiedLimit
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Limit"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Limit does not name the expression whose limit is taken (math:limitOf) and its limit point (math:limitPoint). A limit that does not say of what and at which point is ill-formed; its direction/mode is optional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnderspecifiedConvergence
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Convergence"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Series or math:Sequence carries a math:Convergence that does not name what it converges to (math:convergesTo) and the mode (math:convergenceMode). 'It converges' is meaningless without the mode; a convergence without a mode is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Calculus properties ---------------------------------------------------- #

math:derivativeOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "derivative of"@x-gmeow-english ;
    skos:definition "Relates a math:Derivative to the math:MathematicalExpression (or math:Function) it differentiates. Domain math:Derivative, range math:MathematicalExpression (stated in prose). Every derivative names exactly one; a derivative without it is ill-formed (math:UnderspecifiedDerivative)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:withRespectToVariable
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "with respect to variable"@x-gmeow-english ;
    skos:definition "Relates a math:Derivative to the math:VariableDeclaration it differentiates with respect to — the bound variable of the differentiation binder. Domain math:Derivative, range math:VariableDeclaration (stated in prose). Every derivative names exactly one; a derivative without it is ill-formed (math:UnderspecifiedDerivative)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:derivativeOrder
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "derivative order"@x-gmeow-english ;
    skos:definition "The order of a math:Derivative — 1 for f′, 2 for f″, and so on. Domain math:Derivative, range xsd:positiveInteger (stated in prose). Every derivative names exactly one; a derivative without an order is ill-formed (math:UnderspecifiedDerivative)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:limitOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "limit of"@x-gmeow-english ;
    skos:definition "Relates a math:Limit to the math:MathematicalExpression whose limit is taken. Domain math:Limit, range math:MathematicalExpression (stated in prose). Every limit names exactly one; a limit without it is ill-formed (math:UnderspecifiedLimit)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:limitPoint
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "limit point"@x-gmeow-english ;
    skos:definition "Relates a math:Limit to the point its variable approaches — a math:Number, math:PositiveInfinity, or a point of a space. Domain math:Limit, range a math:Number or point (stated in prose). Every limit names exactly one; a limit without a point is ill-formed (math:UnderspecifiedLimit)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:limitMode
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "limit mode"@x-gmeow-english ;
    skos:definition "Relates a math:Limit to its math:LimitMode — the direction of approach (from the left, from the right, two-sided). Domain math:Limit, range math:LimitMode (stated in prose). Optional: a two-sided limit has no direction, so a limit may omit the mode. Where a one-sided limit is meant, the side is declared, never assumed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:seriesTerm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "series term"@x-gmeow-english ;
    skos:definition "Relates a math:Series to its general term aₙ — the summand, a math:MathematicalExpression indexed by the bound summation variable. Domain math:Series, range math:MathematicalExpression (stated in prose). Every series names its general term."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasConvergence
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has convergence"@x-gmeow-english ;
    skos:definition "Relates a math:Series or math:Sequence to the math:Convergence describing what it converges to and in which mode. Domain a math:Series or math:Sequence, range math:Convergence (stated in prose). A series/sequence asserted to converge names its convergence; the mode is required (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:convergesTo
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "converges to"@x-gmeow-english ;
    skos:definition "Relates a math:Convergence to the value or expression its sequence/series converges to — a math:Number, a limit function, or a distribution. Domain math:Convergence, range a math:MathematicalObject or value (stated in prose). Every convergence names what it converges to."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:convergenceMode
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "convergence mode"@x-gmeow-english ;
    skos:definition "Relates a math:Convergence to its math:ConvergenceMode — pointwise, uniform, absolute, conditional, in-measure, almost-everywhere, in-Lᵖ-norm, or in-distribution. Domain math:Convergence, range math:ConvergenceMode (stated in prose). The mode is required; convergence without a declared mode is ill-formed (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# Topology (ANALYSIS-AND-GEOMETRY charter)
#
# A topological space is given by its open sets (or a basis); continuity is a
# declared property of a map (preimages of open sets are open), never an
# assumption; compactness, connectedness, and the separation axioms are
# first-class declared properties, not entailments of a bare type. Maps lower
# onto the landed math:Morphism: a math:ContinuousMap is a morphism of spaces and
# a math:Homeomorphism is an iso. Homotopy and homology give the algebraic-
# topology bridge — a math:HomologyGroup is a math:AbelianGroup (ALGEBRA charter),
# so a homology-group individual carries the full abelian-group frame. Little
# external ontology exists, so the depth is authored and cited (mathlib/AFP). The
# defining law that continuity is not assumed — the preimage of an open set is
# open — is authored as a first-order logic:Formula (math:continuityLaw), the
# exemplar witness that "declared, not assumed" predicates over real structure.
# =========================================================================== #

# --- Topological spaces and their open/closed sets -------------------------- #

math:TopologicalSpace
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Topological Space"@x-gmeow-english ;
    skos:definition "A topological space (X, τ): a set X together with a topology τ — its collection of open sets, closed under arbitrary union and finite intersection and containing ∅ and X. Given by its open sets (or a basis) through math:hasOpenSet. The object over which continuity, compactness, connectedness, and the separation axioms are defined; a math:MetricSpace and a manifold's underlying space are topological spaces."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:OpenSet
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Open Set"@x-gmeow-english ;
    skos:definition "An open set of a math:TopologicalSpace: a member of the space's topology τ. A subclass of math:Set. Continuity is defined by open sets (preimages of open sets are open), and a math:Neighbourhood of a point contains an open set containing the point."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ClosedSet
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Closed Set"@x-gmeow-english ;
    skos:definition "A closed set of a math:TopologicalSpace: the complement of a math:OpenSet within the space (a math:Complement whose math:complementSemantics is topological). A subclass of math:Set. Closed under finite union and arbitrary intersection, dual to the open sets."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Neighbourhood
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Neighbourhood"@x-gmeow-english ;
    skos:definition "A neighbourhood of a point in a math:TopologicalSpace: a set containing an open set that contains the point. A subclass of math:Set. Neighbourhoods are the local structure the separation axioms (math:separationAxiom, e.g. Hausdorff) quantify over."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ContinuousMap
    a owl:Class ;
    rdfs:subClassOf math:Morphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Continuous Map"@x-gmeow-english ;
    rdfs:seeAlso math:continuityLaw ;
    math:definingLaw math:continuityLaw ;
    skos:definition "A continuous map between topological spaces: a map under which the preimage of every open set is open. A subclass of math:Morphism (a structure-preserving map of spaces, its math:sourceObject and math:targetObject the two topological spaces), and it declares its continuity through math:isContinuous — continuity is declared, not assumed (an undeclared continuity is ill-formed, math:UndeclaredTopologicalProperty). The structure it preserves is the topology, whose defining law is math:continuityLaw (preimages of open sets are open), referenced through math:preservesStructure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Homeomorphism
    a owl:Class ;
    rdfs:subClassOf math:ContinuousMap ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Homeomorphism"@x-gmeow-english ;
    skos:definition "A homeomorphism: a continuous map with a continuous inverse — an isomorphism in the category of topological spaces. A subclass of math:ContinuousMap; two spaces related by a homeomorphism are topologically the same. A chart's coordinate map is a homeomorphism onto its image."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CompactSpace
    a owl:Class ;
    rdfs:subClassOf math:TopologicalSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Compact Space"@x-gmeow-english ;
    rdfs:seeAlso math:compactnessBoundary ;
    math:definingLaw math:compactnessBoundary ;
    skos:definition "A compact topological space: one in which every open cover has a finite subcover. A subclass of math:TopologicalSpace that declares its compactness through math:isCompact — compactness is declared, not assumed (an undeclared compactness is ill-formed, math:UndeclaredTopologicalProperty). Unlike math:ConnectedSpace, whose defining law math:connectednessLaw is a first-order logic:Formula, compactness is genuinely second-order (it quantifies over open covers and appeals to finiteness) and so is backed not by a first-order law but by the honest recorded boundary math:compactnessBoundary (logic:expressivenessBoundary logic:SecondOrder, logic:preservationKind logic:Unsupported), referenced through math:preservesStructure. Compactness is the topological generalization of closed-and-bounded (Heine–Borel) and is preserved by continuous images."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ConnectedSpace
    a owl:Class ;
    rdfs:subClassOf math:TopologicalSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Connected Space"@x-gmeow-english ;
    rdfs:seeAlso math:connectednessLaw ;
    math:definingLaw math:connectednessLaw ;
    skos:definition "A connected topological space: one that is not the union of two disjoint non-empty open sets. A subclass of math:TopologicalSpace that declares its connectedness through math:isConnected — connectedness is declared, not assumed (an undeclared connectedness is ill-formed, math:UndeclaredTopologicalProperty). The structure it preserves is the topology's connectedness, whose defining law is math:connectednessLaw (no splitting into two disjoint non-empty open sets covering the space), referenced through math:preservesStructure. Connectedness is preserved by continuous images (the intermediate value theorem is its avatar on ℝ)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Homotopy
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Homotopy"@x-gmeow-english ;
    skos:definition "A homotopy between two continuous maps: a continuous deformation H: X×[0,1] → Y from one map to the other. Two spaces are homotopy-equivalent (math:homotopyEquivalentTo) when maps between them compose to maps homotopic to the identities. Homotopy equivalence is coarser than homeomorphism and is the equivalence algebraic topology's invariants (homotopy and math:HomologyGroup) respect."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:HomologyGroup
    a owl:Class ;
    rdfs:subClassOf math:AbelianGroup ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Homology Group"@x-gmeow-english ;
    skos:definition "A homology group Hₙ(X): an abelian group functorially assigned to a topological space, counting n-dimensional holes. A subclass of math:AbelianGroup (ALGEBRA charter), so a homology-group individual carries the full algebraic-structure frame — its underlying set, its abelian operation, and its axioms — like any other abelian group. The algebraic-topology bridge: homotopy-equivalent spaces have isomorphic homology groups. The homology functor itself (the assignment X ↦ Hₙ(X)) belongs to a downstream category charter and is not minted here."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Topology conformance failure ------------------------------------------- #

math:UndeclaredTopologicalProperty
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Undeclared Topological Property"@x-gmeow-english ;
    skos:definition "The failure raised when a topological property is assumed rather than declared: a math:ContinuousMap without math:isContinuous, a math:CompactSpace without math:isCompact, or a math:ConnectedSpace without math:isConnected. Continuity, connectedness, and the T0–T4 separation axioms are each backed by a real first-order defining law (math:continuityLaw, math:connectednessLaw, math:t0SeparationLaw … math:normalitySeparationLaw); compactness, being genuinely second-order (a finite subcover over an arbitrary family is not first-order axiomatizable), is backed instead by an honest recorded boundary (math:compactnessBoundary, logic:expressivenessBoundary logic:SecondOrder). Every listed property is therefore backed by a law or a recorded boundary, never a bare type. This gate enforces declaration discipline — that the property is declared, not silently assumed — not satisfaction of the law against a model (no logic:Formula model-checker is in scope)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Topology properties ---------------------------------------------------- #

math:hasOpenSet
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has open set"@x-gmeow-english ;
    skos:definition "Relates a math:TopologicalSpace to a math:OpenSet of its topology (or a basis element). Domain math:TopologicalSpace, range math:OpenSet (stated in prose). A space is given by its open sets; continuity is defined by them."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isContinuous
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is continuous"@x-gmeow-english ;
    skos:definition "Declares whether a map is continuous — the preimage of every open set is open (math:continuityLaw). Domain math:ContinuousMap, range xsd:boolean (stated in prose). The canonical checkable bearer of continuity; continuity is declared here, not assumed from the math:ContinuousMap type (an undeclared continuity is ill-formed, math:UndeclaredTopologicalProperty)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:separationAxiom
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "separation axiom"@x-gmeow-english ;
    skos:definition "Relates a math:TopologicalSpace to a separation axiom it satisfies — T0, T1, T2 (Hausdorff), T3, T4. Domain math:TopologicalSpace, range a math:SeparationAxiom individual (stated in prose). The separation axioms grade how finely neighbourhoods distinguish points; math:hausdorffSeparation (T2) is the one manifolds require. Each axiom in the family is backed by a first-order defining law — math:t0SeparationLaw, math:t1SeparationLaw, math:hausdorffLaw, math:regularitySeparationLaw, math:normalitySeparationLaw — so a separation axiom is a real quantified statement over the reified point/open-set/closed-set signature, not a bare token."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isCompact
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is compact"@x-gmeow-english ;
    rdfs:seeAlso math:compactnessBoundary ;
    skos:definition "Declares whether a space is compact — every open cover has a finite subcover. Domain math:CompactSpace (or math:TopologicalSpace), range xsd:boolean (stated in prose). Compactness is declared, not assumed from the type (an undeclared compactness is ill-formed, math:UndeclaredTopologicalProperty). The declaration is backed not by a first-order law but by the honest recorded second-order boundary math:compactnessBoundary — compactness genuinely exceeds first-order logic (open covers plus finiteness), so the boundary is carried in the loss ledger (logic:preservationKind logic:Unsupported), never faked as a first-order logic:Formula."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isConnected
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is connected"@x-gmeow-english ;
    rdfs:seeAlso math:connectednessLaw ;
    skos:definition "Declares whether a space is connected — not the union of two disjoint non-empty open sets (math:connectednessLaw). Domain math:ConnectedSpace (or math:TopologicalSpace), range xsd:boolean (stated in prose). The canonical checkable bearer of connectedness; connectedness is declared here, not assumed from the math:ConnectedSpace type (an undeclared connectedness is ill-formed, math:UndeclaredTopologicalProperty)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:homotopyEquivalentTo
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homotopy equivalent to"@x-gmeow-english ;
    skos:definition "Relates a math:TopologicalSpace to another it is homotopy-equivalent to — there are maps between them composing to maps homotopic to the identities. Domain and range math:TopologicalSpace (stated in prose). Symmetric mathematically; homotopy-equivalent spaces share homotopy and math:HomologyGroup invariants."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Separation-axiom individuals ------------------------------------------- #

math:SeparationAxiom
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Separation Axiom"@x-gmeow-english ;
    skos:definition "A separation axiom of a topological space: math:t0Separation, math:t1Separation, math:hausdorffSeparation (T2), math:t3Separation, or math:t4Separation, graded by how finely neighbourhoods separate points. A math:TopologicalSpace names those it satisfies through math:separationAxiom."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:hausdorffSeparation
    a owl:NamedIndividual , math:SeparationAxiom ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hausdorff (T2)"@x-gmeow-english ;
    rdfs:seeAlso math:hausdorffLaw ;
    math:definingLaw math:hausdorffLaw ;
    skos:definition "The Hausdorff separation axiom T2: any two distinct points have disjoint neighbourhoods. The separation a manifold's underlying space requires so limits are unique. Its defining law is math:hausdorffLaw (rdfs:seeAlso)."@x-gmeow-english .

math:t0Separation
    a owl:NamedIndividual , math:SeparationAxiom ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "T0 (Kolmogorov)"@x-gmeow-english ;
    rdfs:seeAlso math:t0SeparationLaw ;
    math:definingLaw math:t0SeparationLaw ;
    skos:definition "The T0 separation axiom: any two distinct points are topologically distinguishable (some open set contains one but not the other). Its defining law is math:t0SeparationLaw (rdfs:seeAlso)."@x-gmeow-english .

math:t1Separation
    a owl:NamedIndividual , math:SeparationAxiom ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "T1 (Fréchet)"@x-gmeow-english ;
    rdfs:seeAlso math:t1SeparationLaw ;
    math:definingLaw math:t1SeparationLaw ;
    skos:definition "The T1 separation axiom: for any two distinct points each has a neighbourhood not containing the other; equivalently, singletons are closed. Its defining law is math:t1SeparationLaw (rdfs:seeAlso)."@x-gmeow-english .

math:t3Separation
    a owl:NamedIndividual , math:SeparationAxiom ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "T3 (regular)"@x-gmeow-english ;
    rdfs:seeAlso math:regularitySeparationLaw ;
    math:definingLaw math:regularitySeparationLaw ;
    skos:definition "The T3 separation axiom (regularity): a point and a closed set not containing it have disjoint open neighbourhoods (with T1, a regular space). Its defining law is math:regularitySeparationLaw (rdfs:seeAlso)."@x-gmeow-english .

math:t4Separation
    a owl:NamedIndividual , math:SeparationAxiom ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "T4 (normal)"@x-gmeow-english ;
    rdfs:seeAlso math:normalitySeparationLaw ;
    math:definingLaw math:normalitySeparationLaw ;
    skos:definition "The T4 separation axiom (normality): any two disjoint closed sets have disjoint open neighbourhoods (with T1, a normal space). Its defining law is math:normalitySeparationLaw (rdfs:seeAlso)."@x-gmeow-english .

# --- Reified relation atoms for the continuity law (HiLog reflection) -------- #

math:isContinuousRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "continuous(f) ⟺ map f is continuous"@x-gmeow-english ;
    rdfs:seeAlso math:isContinuous ;
    skos:definition "The HiLog reflection of continuity as a unary relation individual, so the continuity law can predicate 'f is continuous' inside a logic:Formula atom. Reflects the existing math:isContinuous declaration (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:openSetRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "openSet(V) ⟺ V is an open set of its space"@x-gmeow-english ;
    rdfs:seeAlso math:hasOpenSet ;
    skos:definition "The HiLog reflection of open-set membership as a unary relation individual, so the continuity law can predicate 'V is open' inside a logic:Formula atom. Reflects math:hasOpenSet / the math:OpenSet type (rdfs:seeAlso)."@x-gmeow-english .

math:preimageRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "preimage(U,f,V) ⟺ U is the f-preimage f⁻¹(V) of V"@x-gmeow-english ;
    skos:definition "The preimage relation the continuity law quantifies over: preimage(U,f,V) holds exactly when U is the preimage f⁻¹(V) = {x : f(x) ∈ V}. A HiLog relation individual over which the law states 'the preimage of an open set is open'; no first-class asserted property is minted, because the preimage is a derived construction, not authored data."@x-gmeow-english .

# --- Reified relation atoms for the connectedness law (HiLog reflection) ----- #

math:isConnectedRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "connected(X) ⟺ space X is connected"@x-gmeow-english ;
    rdfs:seeAlso math:isConnected ;
    skos:definition "The HiLog reflection of connectedness as a unary relation individual, so the connectedness law can predicate 'X is connected' inside a logic:Formula atom. Reflects the existing math:isConnected declaration (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:disjointRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "disjoint(U,V) ⟺ U and V share no element"@x-gmeow-english ;
    skos:definition "The disjointness relation the connectedness law quantifies over: disjoint(U,V) holds exactly when U ∩ V = ∅. A HiLog relation individual over which the law states the two open sets of a splitting are disjoint; no first-class asserted property is minted, because disjointness is a derived construction over set membership, not authored data."@x-gmeow-english .

math:nonEmptyRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "nonEmpty(U) ⟺ U has an element"@x-gmeow-english ;
    skos:definition "The non-emptiness relation the connectedness law quantifies over: nonEmpty(U) holds exactly when ∃x ∈ U. A HiLog relation individual over which the law requires each half of a splitting to be inhabited; no first-class asserted property is minted, because non-emptiness is a derived construction over set membership, not authored data."@x-gmeow-english .

math:coversSpaceRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "coversSpace(U,V,X) ⟺ U ∪ V = X"@x-gmeow-english ;
    skos:definition "The covering relation the connectedness law quantifies over: coversSpace(U,V,X) holds exactly when U ∪ V equals the whole space X. A ternary HiLog relation individual over which the law states the two open sets of a splitting cover the space; no first-class asserted property is minted, because covering is a derived construction over union and equality, not authored data."@x-gmeow-english .

# --- Law: continuity — the preimage of an open set is open ------------------- #
# ∀f,U,V: isContinuous(f) ∧ openSet(V) ∧ preimage(U,f,V) → openSet(U)
# The defining law of a math:ContinuousMap, authored as a first-order logic:Formula
# exactly as the algebra and measure charters author their hard laws. It is the
# exemplar that "continuity is declared, not assumed" predicates over real
# structure: a continuous map references this law through math:preservesStructure,
# and the SHACL gate requires math:isContinuous to be present.

math:continuityLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "continuity: the preimage of an open set is open"@x-gmeow-english ;
    skos:definition "The defining law of continuity as a universally-quantified first-order logic:Formula: for a continuous map f, if V is an open set and U is the preimage f⁻¹(V), then U is open. math: expresses the law; logic: owns reasoning over it. It is the structure a math:ContinuousMap preserves (math:preservesStructure), so continuity is backed by a real law rather than a bare boolean."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "f" ] ,
        [ logic:termIndex 1 ; logic:termVariable "U" ] ,
        [ logic:termIndex 2 ; logic:termVariable "V" ] ;
    logic:forall math:continuityImpl .

math:continuityImpl a logic:Formula ;
    logic:antecedent math:continuityAnte ;
    logic:consequent math:continuityCons .

math:continuityAnte a logic:Formula ;
    logic:and math:continuityA1 , math:continuityA2 , math:continuityA3 .

math:continuityA1 a logic:Formula ; logic:relation math:isContinuousRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] .
math:continuityA2 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "V" ] .
math:continuityA3 a logic:Formula ; logic:relation math:preimageRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] , [ logic:termIndex 1 ; logic:termVariable "f" ] , [ logic:termIndex 2 ; logic:termVariable "V" ] .

math:continuityCons a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] .

# --- Law: connectedness — no splitting into two disjoint non-empty open sets - #
# ∀X: isConnected(X) → ¬∃U,V: openSet(U) ∧ openSet(V) ∧ nonEmpty(U) ∧ nonEmpty(V)
#                              ∧ disjoint(U,V) ∧ coversSpace(U,V,X)
# The defining law of a math:ConnectedSpace, authored as a first-order logic:Formula
# exactly as the continuity law above. Connectedness is the negation of the
# existence of a separation: a connected space cannot be written as the union of
# two disjoint non-empty open sets. A connected space references this law through
# math:preservesStructure, and the SHACL gate requires math:isConnected to be present.

math:connectednessLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "connectedness: a connected space is not two disjoint non-empty open sets covering it"@x-gmeow-english ;
    skos:definition "The defining law of connectedness as a universally-quantified first-order logic:Formula over the reified point/open-set signature: for a connected space X, there do not exist two open sets U and V that are non-empty, disjoint, and together cover X. math: expresses the law; logic: owns reasoning over it. It is the structure a math:ConnectedSpace preserves (math:preservesStructure), so connectedness is backed by a real law rather than a bare boolean."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "X" ] ;
    logic:forall math:connectednessImpl .

math:connectednessImpl a logic:Formula ;
    logic:antecedent math:connectednessAnte ;
    logic:consequent math:connectednessCons .

math:connectednessAnte a logic:Formula ; logic:relation math:isConnectedRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "X" ] .

math:connectednessCons a logic:Formula ;
    logic:not math:connectednessSplit .

math:connectednessSplit a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "U" ] ,
        [ logic:termIndex 1 ; logic:termVariable "V" ] ;
    logic:exists math:connectednessSplitBody .

math:connectednessSplitBody a logic:Formula ;
    logic:and math:cnA1 , math:cnA2 , math:cnA3 , math:cnA4 , math:cnA5 , math:cnA6 .

math:cnA1 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] .
math:cnA2 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "V" ] .
math:cnA3 a logic:Formula ; logic:relation math:nonEmptyRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] .
math:cnA4 a logic:Formula ; logic:relation math:nonEmptyRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "V" ] .
math:cnA5 a logic:Formula ; logic:relation math:disjointRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] , [ logic:termIndex 1 ; logic:termVariable "V" ] .
math:cnA6 a logic:Formula ; logic:relation math:coversSpaceRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] , [ logic:termIndex 1 ; logic:termVariable "V" ] , [ logic:termIndex 2 ; logic:termVariable "X" ] .

# --- Boundary: compactness — an honest recorded second-order boundary --------- #
# Compactness ("every open cover has a finite subcover") is genuinely SECOND-ORDER:
# it ∀-quantifies over open COVERS (families of open sets) AND requires a FINITE
# subfamily. Finiteness is not first-order axiomatizable (FOL compactness theorem),
# so — unlike math:continuityLaw/math:connectednessLaw, which ARE first-order —
# compactness has NO first-order logic:Formula to author. It is recorded here as an
# honest loss-ledger boundary carrying logic:expressivenessBoundary logic:SecondOrder
# and logic:preservationKind logic:Unsupported, never faked as a first-order formula.
# math:CompactSpace references it through math:preservesStructure (see the fixture),
# and the SHACL gate still requires math:isCompact to be present.

math:compactnessBoundary
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "compactness: an honest recorded second-order boundary (no first-order formula)"@x-gmeow-english ;
    logic:expressivenessBoundary logic:SecondOrder ;
    logic:preservationKind logic:Unsupported ;
    skos:definition "The loss-ledger boundary record backing math:CompactSpace/math:isCompact: compactness ('every open cover has a finite subcover') is genuinely second-order — it ∀-quantifies over open COVERS (families of open sets) AND requires a FINITE subfamily. HiLog reflection could reify the covers, but finiteness is not first-order axiomatizable (the FOL compactness theorem), so a first-order witness would be an unsound uninterpreted predicate. Hence compactness is carried as an honest boundary (logic:expressivenessBoundary logic:SecondOrder, logic:preservationKind logic:Unsupported), residue disclosed in the ledger and never silent prose (Principle 17). Contrast its siblings math:continuityLaw and math:connectednessLaw, which ARE first-order logic:Formula laws."@x-gmeow-english .

# --- Reified relation atoms for the separation-axiom laws (HiLog reflection) - #

math:membershipRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "member(x,U) ⟺ x ∈ U"@x-gmeow-english ;
    rdfs:seeAlso math:hasElement ;
    skos:definition "The membership relation the separation-axiom laws quantify over: member(x,U) holds exactly when the point x is an element of the set U. A HiLog relation individual so the laws can predicate 'x lies in the open set U' inside a logic:Formula atom. Reflects math:hasElement (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:pointOfRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "pointOf(x,X) ⟺ x is a point of space X"@x-gmeow-english ;
    skos:definition "The point-of-space relation the separation-axiom laws quantify over: pointOf(x,X) holds exactly when x is a point of the topological space X. A HiLog relation individual over which the laws range their points; no first-class asserted property is minted, because no point-of-space property exists in the ontology — a point is a derived element of a space's underlying set, not authored data."@x-gmeow-english .

math:distinctPointsRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "distinct(x,y) ⟺ x ≠ y"@x-gmeow-english ;
    skos:definition "The distinctness relation the separation-axiom laws quantify over: distinct(x,y) holds exactly when the points x and y are not equal. A HiLog relation individual so the laws can require the two separated points to differ; no first-class asserted property is minted, and no logic: equality/inequality relation atom exists for first-order formula use (logic:distinctBody / logic:distinctnessRole are rule-guards, not formula atoms), so distinctness is a derived atom — equality is genuinely first-order here."@x-gmeow-english .

math:closedSetRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "closedSet(C) ⟺ C is a math:ClosedSet"@x-gmeow-english ;
    rdfs:seeAlso math:ClosedSet ;
    skos:definition "The HiLog reflection of closed-set membership as a unary relation individual, so the regularity and normality laws can predicate 'C is closed' inside a logic:Formula atom. Reflects the math:ClosedSet type (rdfs:seeAlso)."@x-gmeow-english .

math:supersetRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "superset(V,C) ⟺ C ⊆ V"@x-gmeow-english ;
    rdfs:seeAlso math:subsetOf ;
    skos:definition "The containment relation the regularity and normality laws quantify over: superset(V,C) holds exactly when the closed set C is a subset of the open set V (V ⊇ C). A HiLog relation individual so the laws can require an open neighbourhood to engulf a closed set. Reflects math:subsetOf (rdfs:seeAlso), read with its arguments in superset order."@x-gmeow-english .

# --- Law: T0 (Kolmogorov) — distinct points are topologically distinguishable  #
# ∀x,y: pointOf(x,X) ∧ pointOf(y,X) ∧ distinct(x,y)
#        → ∃U: openSet(U) ∧ ( (member(x,U) ∧ ¬member(y,U)) ∨ (member(y,U) ∧ ¬member(x,U)) )
# The defining law of math:t0Separation, authored as a first-order logic:Formula
# over the reified point/open-set signature exactly as the continuity and
# connectedness laws above. Some open set contains one point but not the other.

math:t0SeparationLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "T0 (Kolmogorov): distinct points are topologically distinguishable"@x-gmeow-english ;
    skos:definition "The defining law of the T0 separation axiom as a universally-quantified first-order logic:Formula over the reified point/open-set signature: for any two distinct points x and y of a space X, there is an open set containing one but not the other. math: expresses the law; logic: owns reasoning over it. A math:TopologicalSpace names it through math:separationAxiom / rdfs:seeAlso math:t0Separation."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "x" ] ,
        [ logic:termIndex 1 ; logic:termVariable "y" ] ;
    logic:forall math:t0Impl .

math:t0Impl a logic:Formula ;
    logic:antecedent math:t0Ante ;
    logic:consequent math:t0Cons .

math:t0Ante a logic:Formula ;
    logic:and math:t0A1 , math:t0A2 , math:t0A3 .

math:t0A1 a logic:Formula ; logic:relation math:pointOfRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "X" ] .
math:t0A2 a logic:Formula ; logic:relation math:pointOfRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "y" ] , [ logic:termIndex 1 ; logic:termVariable "X" ] .
math:t0A3 a logic:Formula ; logic:relation math:distinctPointsRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] .

math:t0Cons a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "U" ] ;
    logic:exists math:t0Witness .

math:t0Witness a logic:Formula ;
    logic:and math:t0W1 , math:t0Split .

math:t0W1 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] .

math:t0Split a logic:Formula ;
    logic:or math:t0SplitX , math:t0SplitY .

math:t0SplitX a logic:Formula ;
    logic:and math:t0MemX , math:t0NotMemY .
math:t0SplitY a logic:Formula ;
    logic:and math:t0MemY , math:t0NotMemX .

math:t0MemX a logic:Formula ; logic:relation math:membershipRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "U" ] .
math:t0MemY a logic:Formula ; logic:relation math:membershipRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "y" ] , [ logic:termIndex 1 ; logic:termVariable "U" ] .
math:t0NotMemY a logic:Formula ;
    logic:not math:t0MemY .
math:t0NotMemX a logic:Formula ;
    logic:not math:t0MemX .

# --- Law: T1 (Fréchet) — each of two distinct points has a nbhd excluding the other #
# ∀x,y: pointOf(x,X) ∧ pointOf(y,X) ∧ distinct(x,y)
#        → ∃U: openSet(U) ∧ member(x,U) ∧ ¬member(y,U)
# The defining law of math:t1Separation, a first-order logic:Formula over the
# reified point/open-set signature. Stronger than T0: the distinguishing open set
# can always be chosen around x (by symmetry over the pair, around either point).

math:t1SeparationLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "T1 (Fréchet): a distinct point has an open neighbourhood excluding the other"@x-gmeow-english ;
    skos:definition "The defining law of the T1 separation axiom as a universally-quantified first-order logic:Formula over the reified point/open-set signature: for any two distinct points x and y of a space X, there is an open set containing x but not y. math: expresses the law; logic: owns reasoning over it. A math:TopologicalSpace names it through math:separationAxiom / rdfs:seeAlso math:t1Separation."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "x" ] ,
        [ logic:termIndex 1 ; logic:termVariable "y" ] ;
    logic:forall math:t1Impl .

math:t1Impl a logic:Formula ;
    logic:antecedent math:t1Ante ;
    logic:consequent math:t1Cons .

math:t1Ante a logic:Formula ;
    logic:and math:t1A1 , math:t1A2 , math:t1A3 .

math:t1A1 a logic:Formula ; logic:relation math:pointOfRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "X" ] .
math:t1A2 a logic:Formula ; logic:relation math:pointOfRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "y" ] , [ logic:termIndex 1 ; logic:termVariable "X" ] .
math:t1A3 a logic:Formula ; logic:relation math:distinctPointsRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] .

math:t1Cons a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "U" ] ;
    logic:exists math:t1Witness .

math:t1Witness a logic:Formula ;
    logic:and math:t1W1 , math:t1MemX , math:t1NotMemY .

math:t1W1 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] .
math:t1MemX a logic:Formula ; logic:relation math:membershipRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "U" ] .
math:t1NotMemY a logic:Formula ;
    logic:not math:t1NotMemYBody .
math:t1NotMemYBody a logic:Formula ; logic:relation math:membershipRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "y" ] , [ logic:termIndex 1 ; logic:termVariable "U" ] .

# --- Law: T2 (Hausdorff) — distinct points have disjoint open neighbourhoods --- #
# ∀x,y: pointOf(x,X) ∧ pointOf(y,X) ∧ distinct(x,y)
#        → ∃U,V: openSet(U) ∧ openSet(V) ∧ member(x,U) ∧ member(y,V) ∧ disjoint(U,V)
# The defining law of math:hausdorffSeparation, a first-order logic:Formula over
# the reified point/open-set signature. The separation a manifold's underlying
# space requires so limits are unique.

math:hausdorffLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "T2 (Hausdorff): distinct points have disjoint open neighbourhoods"@x-gmeow-english ;
    skos:definition "The defining law of the Hausdorff (T2) separation axiom as a universally-quantified first-order logic:Formula over the reified point/open-set signature: for any two distinct points x and y of a space X, there exist disjoint open sets U and V with x in U and y in V. math: expresses the law; logic: owns reasoning over it. A math:TopologicalSpace names it through math:separationAxiom / rdfs:seeAlso math:hausdorffSeparation, and this is the law a Hausdorff space references through math:preservesStructure."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "x" ] ,
        [ logic:termIndex 1 ; logic:termVariable "y" ] ;
    logic:forall math:hausImpl .

math:hausImpl a logic:Formula ;
    logic:antecedent math:hausAnte ;
    logic:consequent math:hausCons .

math:hausAnte a logic:Formula ;
    logic:and math:hausA1 , math:hausA2 , math:hausA3 .

math:hausA1 a logic:Formula ; logic:relation math:pointOfRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "X" ] .
math:hausA2 a logic:Formula ; logic:relation math:pointOfRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "y" ] , [ logic:termIndex 1 ; logic:termVariable "X" ] .
math:hausA3 a logic:Formula ; logic:relation math:distinctPointsRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] .

math:hausCons a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "U" ] ,
        [ logic:termIndex 1 ; logic:termVariable "V" ] ;
    logic:exists math:hausWitness .

math:hausWitness a logic:Formula ;
    logic:and math:hausW1 , math:hausW2 , math:hausMemX , math:hausMemY , math:hausDisjoint .

math:hausW1 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] .
math:hausW2 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "V" ] .
math:hausMemX a logic:Formula ; logic:relation math:membershipRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "U" ] .
math:hausMemY a logic:Formula ; logic:relation math:membershipRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "y" ] , [ logic:termIndex 1 ; logic:termVariable "V" ] .
math:hausDisjoint a logic:Formula ; logic:relation math:disjointRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] , [ logic:termIndex 1 ; logic:termVariable "V" ] .

# --- Law: T3 (regularity) — a point and a disjoint closed set separate ------- #
# ∀x,C: pointOf(x,X) ∧ closedSet(C) ∧ ¬member(x,C)
#        → ∃U,V: openSet(U) ∧ openSet(V) ∧ member(x,U) ∧ superset(V,C) ∧ disjoint(U,V)
# The defining law of math:t3Separation, a first-order logic:Formula over the
# reified point/open-set/closed-set signature. A point off a closed set and the
# closed set can be engulfed in disjoint open neighbourhoods.

math:regularitySeparationLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "T3 (regularity): a point and a disjoint closed set have disjoint open neighbourhoods"@x-gmeow-english ;
    skos:definition "The defining law of the T3 separation axiom (regularity) as a universally-quantified first-order logic:Formula over the reified point/open-set/closed-set signature: for a point x not in a closed set C of a space X, there exist disjoint open sets U and V with x in U and C contained in V. math: expresses the law; logic: owns reasoning over it. A math:TopologicalSpace names it through math:separationAxiom / rdfs:seeAlso math:t3Separation."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "x" ] ,
        [ logic:termIndex 1 ; logic:termVariable "C" ] ;
    logic:forall math:t3Impl .

math:t3Impl a logic:Formula ;
    logic:antecedent math:t3Ante ;
    logic:consequent math:t3Cons .

math:t3Ante a logic:Formula ;
    logic:and math:t3A1 , math:t3A2 , math:t3A3 .

math:t3A1 a logic:Formula ; logic:relation math:pointOfRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "X" ] .
math:t3A2 a logic:Formula ; logic:relation math:closedSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "C" ] .
math:t3A3 a logic:Formula ;
    logic:not math:t3A3Body .
math:t3A3Body a logic:Formula ; logic:relation math:membershipRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "C" ] .

math:t3Cons a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "U" ] ,
        [ logic:termIndex 1 ; logic:termVariable "V" ] ;
    logic:exists math:t3Witness .

math:t3Witness a logic:Formula ;
    logic:and math:t3W1 , math:t3W2 , math:t3MemX , math:t3Super , math:t3Disjoint .

math:t3W1 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] .
math:t3W2 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "V" ] .
math:t3MemX a logic:Formula ; logic:relation math:membershipRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "U" ] .
math:t3Super a logic:Formula ; logic:relation math:supersetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "V" ] , [ logic:termIndex 1 ; logic:termVariable "C" ] .
math:t3Disjoint a logic:Formula ; logic:relation math:disjointRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] , [ logic:termIndex 1 ; logic:termVariable "V" ] .

# --- Law: T4 (normality) — two disjoint closed sets separate ----------------- #
# ∀C,D: closedSet(C) ∧ closedSet(D) ∧ disjoint(C,D)
#        → ∃U,V: openSet(U) ∧ openSet(V) ∧ superset(U,C) ∧ superset(V,D) ∧ disjoint(U,V)
# The defining law of math:t4Separation, a first-order logic:Formula over the
# reified open-set/closed-set signature. Any two disjoint closed sets can be
# engulfed in disjoint open neighbourhoods (Urysohn's lemma lives above this).

math:normalitySeparationLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "T4 (normality): disjoint closed sets have disjoint open neighbourhoods"@x-gmeow-english ;
    skos:definition "The defining law of the T4 separation axiom (normality) as a universally-quantified first-order logic:Formula over the reified open-set/closed-set signature: for any two disjoint closed sets C and D, there exist disjoint open sets U and V with C contained in U and D contained in V. math: expresses the law; logic: owns reasoning over it. A math:TopologicalSpace names it through math:separationAxiom / rdfs:seeAlso math:t4Separation."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "C" ] ,
        [ logic:termIndex 1 ; logic:termVariable "D" ] ;
    logic:forall math:t4Impl .

math:t4Impl a logic:Formula ;
    logic:antecedent math:t4Ante ;
    logic:consequent math:t4Cons .

math:t4Ante a logic:Formula ;
    logic:and math:t4A1 , math:t4A2 , math:t4A3 .

math:t4A1 a logic:Formula ; logic:relation math:closedSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "C" ] .
math:t4A2 a logic:Formula ; logic:relation math:closedSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "D" ] .
math:t4A3 a logic:Formula ; logic:relation math:disjointRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "C" ] , [ logic:termIndex 1 ; logic:termVariable "D" ] .

math:t4Cons a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "U" ] ,
        [ logic:termIndex 1 ; logic:termVariable "V" ] ;
    logic:exists math:t4Witness .

math:t4Witness a logic:Formula ;
    logic:and math:t4W1 , math:t4W2 , math:t4SuperC , math:t4SuperD , math:t4Disjoint .

math:t4W1 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] .
math:t4W2 a logic:Formula ; logic:relation math:openSetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "V" ] .
math:t4SuperC a logic:Formula ; logic:relation math:supersetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] , [ logic:termIndex 1 ; logic:termVariable "C" ] .
math:t4SuperD a logic:Formula ; logic:relation math:supersetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "V" ] , [ logic:termIndex 1 ; logic:termVariable "D" ] .
math:t4Disjoint a logic:Formula ; logic:relation math:disjointRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "U" ] , [ logic:termIndex 1 ; logic:termVariable "V" ] .

# =========================================================================== #
# Differential geometry and manifolds (ANALYSIS-AND-GEOMETRY charter)
#
# A manifold declares its dimension and its structure kind (topological, smooth,
# complex, Riemannian, Lorentzian) — a manifold without both is ill-formed. A
# chart names its domain, coordinate map, and target coordinate space; an atlas
# is a covering family of charts with their transition maps φᵢ∘φⱼ⁻¹ (reusing the
# landed math:functionComposition). A metric tensor (Riemannian or Lorentzian) is
# a tensor field carrying a structured signature (p,q). The Lorentzian metric is
# the math object a physics slice needs for spacetime, and it stays here on the
# math side of the boundary — spacetime, worldlines, and SR/GR are physics.
# =========================================================================== #

# --- Manifolds and their structure kind ------------------------------------- #

math:Manifold
    a owl:Class ;
    rdfs:subClassOf math:TopologicalSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Manifold"@x-gmeow-english ;
    skos:definition "A manifold: a topological space locally homeomorphic to ℝⁿ, Hausdorff and second-countable, covered by a math:Atlas of charts. A subclass of math:TopologicalSpace. It declares both its dimension through math:manifoldDimension and its structure kind through math:manifoldStructureKind (topological, smooth, complex, Riemannian, Lorentzian) — a manifold missing either is ill-formed (math:UnderspecifiedManifold)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SmoothManifold
    a owl:Class ;
    rdfs:subClassOf math:Manifold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Smooth Manifold"@x-gmeow-english ;
    skos:definition "A smooth (C^∞) manifold: a manifold whose atlas has smooth transition maps, so differentiation is well-defined. A subclass of math:Manifold; its math:manifoldStructureKind is math:smoothStructure. The setting for tangent spaces, tensor fields, and differential geometry."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ComplexManifold
    a owl:Class ;
    rdfs:subClassOf math:SmoothManifold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Complex Manifold"@x-gmeow-english ;
    skos:definition "A complex manifold: a manifold with holomorphic transition maps, locally modeled on ℂⁿ. A subclass of math:SmoothManifold (a complex structure refines a smooth one); its math:manifoldStructureKind is math:complexStructure. Its real dimension is twice its complex dimension."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RiemannianManifold
    a owl:Class ;
    rdfs:subClassOf math:SmoothManifold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Riemannian Manifold"@x-gmeow-english ;
    skos:definition "A Riemannian manifold: a smooth manifold with a positive-definite math:MetricTensor giving lengths and angles. A subclass of math:SmoothManifold; its math:manifoldStructureKind is math:riemannianStructure and its metric's math:metricSignature is (n, 0). The setting of curvature, geodesics, and classical differential geometry."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LorentzianManifold
    a owl:Class ;
    rdfs:subClassOf math:SmoothManifold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lorentzian Manifold"@x-gmeow-english ;
    skos:definition "A Lorentzian manifold: a smooth manifold with a metric tensor of signature (1, n−1) (or (n−1, 1)) — one timelike and n−1 spacelike directions. A subclass of math:SmoothManifold (a pseudo-Riemannian manifold, sibling to math:RiemannianManifold, not a subclass of it since the metric is indefinite); its math:manifoldStructureKind is math:lorentzianStructure. The math object a physics slice builds spacetime on — the metric and manifold stay here on the math side; spacetime, worldlines, and proper time are physics."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ManifoldStructureKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Manifold Structure Kind"@x-gmeow-english ;
    skos:definition "The structure kind a manifold carries: one of math:topologicalStructure, math:smoothStructure, math:complexStructure, math:riemannianStructure, or math:lorentzianStructure. A manifold declares exactly one through math:manifoldStructureKind; the kind fixes what is well-defined on it (continuity only, differentiation, holomorphy, a definite or indefinite metric)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Structure-kind individuals --------------------------------------------- #

math:topologicalStructure
    a owl:NamedIndividual , math:ManifoldStructureKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "topological"@x-gmeow-english ;
    skos:definition "The topological structure kind: a manifold with only a topology — continuity is well-defined, differentiation is not. The weakest structure a math:Manifold can declare."@x-gmeow-english .

math:smoothStructure
    a owl:NamedIndividual , math:ManifoldStructureKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "smooth"@x-gmeow-english ;
    skos:definition "The smooth (C^∞) structure kind: a manifold with smooth transition maps, on which differentiation, tangent spaces, and tensor fields are well-defined."@x-gmeow-english .

math:complexStructure
    a owl:NamedIndividual , math:ManifoldStructureKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "complex"@x-gmeow-english ;
    skos:definition "The complex structure kind: a manifold with holomorphic transition maps, locally modeled on ℂⁿ."@x-gmeow-english .

math:riemannianStructure
    a owl:NamedIndividual , math:ManifoldStructureKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Riemannian"@x-gmeow-english ;
    skos:definition "The Riemannian structure kind: a smooth manifold with a positive-definite metric tensor (signature (n, 0)) giving lengths and angles."@x-gmeow-english .

math:lorentzianStructure
    a owl:NamedIndividual , math:ManifoldStructureKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lorentzian"@x-gmeow-english ;
    skos:definition "The Lorentzian structure kind: a smooth manifold with an indefinite metric tensor of signature (1, n−1) — one timelike direction. The structure spacetime requires; it stays math-side."@x-gmeow-english .

# --- Charts, atlases, and coordinate maps ----------------------------------- #

math:Chart
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Chart"@x-gmeow-english ;
    skos:definition "A chart (coordinate patch) on a manifold: it names the region it covers through math:chartDomain, the math:CoordinateMap taking that region to coordinates through math:coordinateMap, and the target coordinate space (ℝⁿ or ℂⁿ) through math:targetCoordinateSpace. A chart missing its domain, coordinate map, or target space is ill-formed (math:UnderspecifiedChart). Its coordinate map is a homeomorphism onto its image, and the target space's dimension must match the manifold's (math:DimensionMismatch)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Atlas
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Atlas"@x-gmeow-english ;
    skos:definition "An atlas of a manifold: a covering family of charts (math:hasChart) whose domains cover the manifold, together with the transition maps φᵢ∘φⱼ⁻¹ on chart overlaps (math:transitionMap, reusing the landed math:functionComposition to express the composite). The transition maps' regularity (continuous, smooth, holomorphic) is what fixes the manifold's structure kind — the real mathematical content of an atlas, not just a bag of charts."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CoordinateMap
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Coordinate Map"@x-gmeow-english ;
    skos:definition "A coordinate map of a chart: a homeomorphism from the chart's domain onto an open subset of the target coordinate space, assigning coordinates to points. A subclass of math:Function, so it declares its math:domain (the chart region) and math:codomain (the coordinate space). Transition maps between charts are compositions of coordinate maps and their inverses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Tangent spaces, tensor fields, and metrics ----------------------------- #

math:TangentSpace
    a owl:Class ;
    rdfs:subClassOf math:VectorSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Tangent Space"@x-gmeow-english ;
    skos:definition "The tangent space T_pM at a point p of a manifold M: the vector space of tangent vectors at that point. A subclass of math:VectorSpace; it names its base point through math:tangentSpaceAt and its manifold through math:tangentSpaceOf, and its math:spaceDimension equals the manifold's math:manifoldDimension (math:DimensionMismatch otherwise). Tensor fields are sections over the tangent bundle — the disjoint union of the tangent spaces."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:TensorField
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Tensor Field"@x-gmeow-english ;
    skos:definition "A tensor field on a manifold: an assignment of a tensor to each point, a section of a tensor bundle over the tangent spaces. Names the manifold it lives on through math:tensorFieldOn. A math:MetricTensor is the distinguished tensor field giving the geometry; vector fields and differential forms are other tensor fields."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MetricTensor
    a owl:Class ;
    rdfs:subClassOf math:TensorField ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Metric Tensor"@x-gmeow-english ;
    skos:definition "A metric tensor g: a symmetric bilinear form on each tangent space giving lengths and angles. A subclass of math:TensorField carrying a structured math:metricSignature (p, q) through math:metricSignature — positive-definite (q = 0) for a math:RiemannianManifold, indefinite with one timelike direction (p or q = 1) for a math:LorentzianManifold. The Lorentzian metric is the math object a physics slice needs for spacetime and stays math-side."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MetricSignature
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Metric Signature"@x-gmeow-english ;
    skos:definition "The signature (p, q) of a math:MetricTensor: the count of positive (math:signaturePositive) and negative (math:signatureNegative) eigenvalues of the metric. Structured, not an opaque string — Riemannian is (n, 0), Lorentzian is (1, n−1) or (n−1, 1), so 'exactly one timelike direction' is checkable against the manifold's structure kind. The sum p + q equals the manifold's dimension."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Geometry conformance failures ------------------------------------------ #

math:UnderspecifiedManifold
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Manifold"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Manifold does not declare both its dimension (math:manifoldDimension) and its structure kind (math:manifoldStructureKind). A manifold that does not say how many dimensions and which structure it carries is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnderspecifiedChart
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Chart"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Chart does not name its domain (math:chartDomain), its coordinate map (math:coordinateMap), and its target coordinate space (math:targetCoordinateSpace). A chart that does not say what it covers, how it coordinatizes, and into which space is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DimensionMismatch
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimension Mismatch"@x-gmeow-english ;
    skos:definition "The failure raised when a geometric dimension does not agree: a math:Chart on an n-manifold whose math:targetCoordinateSpace does not have dimension n, a math:TangentSpace whose math:spaceDimension differs from its manifold's math:manifoldDimension, or a math:MetricSignature whose p + q does not equal the manifold's dimension. The analysis-geometry analogue of dimensional homogeneity — a silent-error class the charter forbids."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Geometry properties ---------------------------------------------------- #

math:manifoldDimension
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "manifold dimension"@x-gmeow-english ;
    skos:definition "The dimension of a math:Manifold — the n such that it is locally homeomorphic to ℝⁿ. Domain math:Manifold, range xsd:nonNegativeInteger (stated in prose). Every manifold declares exactly one; a manifold without a dimension is ill-formed (math:UnderspecifiedManifold). A chart's target space and a tangent space must match it (math:DimensionMismatch)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:manifoldStructureKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "manifold structure kind"@x-gmeow-english ;
    skos:definition "Relates a math:Manifold to the math:ManifoldStructureKind it carries — topological, smooth, complex, Riemannian, or Lorentzian. Domain math:Manifold, range math:ManifoldStructureKind (stated in prose). Every manifold declares exactly one; a manifold without a structure kind is ill-formed (math:UnderspecifiedManifold)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:spaceDimension
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "space dimension"@x-gmeow-english ;
    skos:definition "The dimension of a coordinate space, vector space, or math:TangentSpace — distinct from the physical math:hasDimension (an SI dimension). Domain a math:Set or math:VectorSpace serving as a coordinate/tangent space, range xsd:nonNegativeInteger (stated in prose). A chart's math:targetCoordinateSpace and a math:TangentSpace carry it; it must equal the manifold's math:manifoldDimension (math:DimensionMismatch)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasChart
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has chart"@x-gmeow-english ;
    skos:definition "Relates a math:Manifold or math:Atlas to a math:Chart covering part of it. Domain a math:Manifold or math:Atlas, range math:Chart (stated in prose). An atlas is the covering family of charts named through this property."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:chartDomain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "chart domain"@x-gmeow-english ;
    skos:definition "Relates a math:Chart to the region of the manifold it covers — an open subset, or the whole manifold for a global chart. Domain math:Chart, range a math:TopologicalSpace or math:OpenSet (stated in prose). Every chart names exactly one; a chart without it is ill-formed (math:UnderspecifiedChart)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:coordinateMap
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "coordinate map"@x-gmeow-english ;
    skos:definition "Relates a math:Chart to its math:CoordinateMap — the homeomorphism assigning coordinates to points of its domain. Domain math:Chart, range math:CoordinateMap (stated in prose). Every chart names exactly one; a chart without it is ill-formed (math:UnderspecifiedChart)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:targetCoordinateSpace
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "target coordinate space"@x-gmeow-english ;
    skos:definition "Relates a math:Chart to the coordinate space its map lands in — ℝⁿ for a real manifold, ℂⁿ for a complex one, carrying its math:spaceDimension. Domain math:Chart, range a math:Set or math:VectorSpace (stated in prose). Every chart names exactly one; its dimension must equal the manifold's (math:DimensionMismatch); a chart without it is ill-formed (math:UnderspecifiedChart)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:transitionMap
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "transition map"@x-gmeow-english ;
    skos:definition "Relates a math:Atlas to a transition map φᵢ∘φⱼ⁻¹ on a chart overlap — a math:Function expressed as a composition (math:functionComposition / math:compositionOuter / math:compositionInner) of one chart's coordinate map with another's inverse. Domain math:Atlas, range math:Function (stated in prose). The transition maps' regularity fixes the manifold's structure kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:metricTensor
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "metric tensor"@x-gmeow-english ;
    skos:definition "Relates a math:RiemannianManifold or math:LorentzianManifold to its math:MetricTensor. Domain a math:Manifold, range math:MetricTensor (stated in prose). The metric gives the manifold its lengths, angles, and — for a Lorentzian metric — its causal structure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:tensorFieldOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "tensor field on"@x-gmeow-english ;
    skos:definition "Relates a math:TensorField to the math:Manifold it is a field on. Domain math:TensorField, range math:Manifold (stated in prose). Every tensor field names the manifold it lives over."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:tangentSpaceAt
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "tangent space at"@x-gmeow-english ;
    skos:definition "Relates a math:TangentSpace to the point of the manifold it is the tangent space at — the p in T_pM. Domain math:TangentSpace, range a point (stated in prose). A tangent space is at a point; naming it makes the tangent bundle's fibres explicit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:tangentSpaceOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "tangent space of"@x-gmeow-english ;
    skos:definition "Relates a math:TangentSpace to the math:Manifold it is a tangent space of. Domain math:TangentSpace, range math:Manifold (stated in prose). Its math:spaceDimension must equal that manifold's math:manifoldDimension (math:DimensionMismatch)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:metricSignature
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "metric signature"@x-gmeow-english ;
    skos:definition "Relates a math:MetricTensor to its math:MetricSignature (p, q). Domain math:MetricTensor, range math:MetricSignature (stated in prose). Structured, not an opaque string, so a Lorentzian metric's 'exactly one timelike direction' is checkable against the manifold's structure kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:signaturePositive
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "signature positive"@x-gmeow-english ;
    skos:definition "The count p of positive eigenvalues (spacelike directions in the +−−− convention) of a math:MetricSignature. Domain math:MetricSignature, range xsd:nonNegativeInteger (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:signatureNegative
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "signature negative"@x-gmeow-english ;
    skos:definition "The count q of negative eigenvalues (timelike directions in the +−−− convention) of a math:MetricSignature. Domain math:MetricSignature, range xsd:nonNegativeInteger (stated in prose). A Lorentzian signature has exactly one negative (or, dually, exactly one positive) — the timelike direction spacetime is built on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# Linear algebra, learning, and representation (LINEAR-ALGEBRA-AND-LEARNING
# charter)
#
# The operational objects of data and AI: matrices as linear maps, inner-product
# spaces and their orthogonal complements, decompositions (eigen, SVD, PCA) as
# named analyses that declare inputs / policy / outputs, embeddings as maps into
# latent spaces, and a neural network as a tensor computational graph reusing the
# expression AST wholesale. Its discipline: a decomposition or embedding declares
# its inputs, its policy, and its outputs — and any MEANING read off a residual or
# a latent dimension is a claim from a vantage (a gmeow:Observation carrying a
# gmeow:vantage and a result), never an intrinsic property of the vector
# (math:ResidualMeaningAsProperty). math:OrthogonalComplement realizes the
# geometry charter's complement contract (math:ambientSpace +
# math:complementSemantics math:orthogonalComplement + math:definedByInnerProduct).
# The tensor computation graph reuses math:ApplicationExpression + math:ArgumentSlot
# so the inherited application/slot gates bite; the AI's reflection on that
# structure ("these dimensions encode X") is carried at the logic: metalevel
# (logic:MetaLevelFormula), self-reference without paradox across grounding layers.
# =========================================================================== #

# --- The universal object-layer root ---------------------------------------- #
# math:MathematicalObject is the top of the object layer — the universal type an
# element, a value, a vector, a decomposition, or a learned object inhabits. The
# bedrock already ranges over it (math:hasElement, math:convergesTo) and the
# analysis examples type points and limits with it; it is declared here as the
# explicit root those references assume.

math:MathematicalObject
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Mathematical Object"@x-gmeow-english ;
    skos:definition "The universal object-layer root: any object mathematics quantifies, indexes, maps, or measures over — an element, a value, a vector, a decomposition, a learned object. The top type the bedrock ranges over (math:hasElement, math:convergesTo) and the ground the specialized object classes (math:Basis, math:Rank, math:Eigendecomposition, math:PrincipalComponent, math:WeightTensor, and the rest) build on. Distinct from the expression layer (math:MathematicalExpression) and the relation/function layer, which name what denotes or maps rather than what is denoted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Inner-product spaces, subspaces, and decompositions -------------------- #

math:InnerProductSpace
    a owl:Class ;
    rdfs:subClassOf math:VectorSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Inner Product Space"@x-gmeow-english ;
    skos:definition "A vector space equipped with an inner product — a math:VectorSpace carrying a math:innerProduct that assigns lengths and angles, so orthogonality and orthogonal complements are defined. A subclass of math:VectorSpace; the complex case carries a math:HermitianInnerProduct. It names the inner product it carries through math:innerProduct."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:HermitianInnerProduct
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hermitian Inner Product"@x-gmeow-english ;
    skos:definition "A conjugate-symmetric, positive-definite sesquilinear form on a complex vector space — the inner product ⟨·,·⟩ of the complex case, linear in one argument and conjugate-linear in the other. A subclass of math:MathematicalObject carried by a math:InnerProductSpace through math:innerProduct; it is the structure that defines a math:OrthogonalComplement in the complex (S⊥) case (math:definedByInnerProduct)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Subspace
    a owl:Class ;
    rdfs:subClassOf math:VectorSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Subspace"@x-gmeow-english ;
    skos:definition "A vector subspace: a subset of a vector space closed under addition and scalar multiplication, itself a math:VectorSpace. A subclass of math:VectorSpace naming the space it sits in through math:subspaceOf. The embedded image of an embedding and the residual of a projection are subspaces; a math:OrthogonalComplement is the subspace orthogonal to one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:OrthogonalComplement
    a owl:Class ;
    rdfs:subClassOf math:Complement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Orthogonal Complement"@x-gmeow-english ;
    skos:definition "The orthogonal complement S⊥ of a subspace S within an inner-product space — the vectors orthogonal to every vector of S under a declared inner product. A subclass of math:Complement that realizes the geometry charter's complement contract: it names its math:ambientSpace, sets math:complementSemantics math:orthogonalComplement, and additionally is math:definedByInnerProduct (the math:HermitianInnerProduct in the complex case), so 'the orthogonal complement' is never ambiguous. An orthogonal complement not naming its inner product is ill-formed (math:UnqualifiedOrthogonalComplement)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Basis
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Basis"@x-gmeow-english ;
    skos:definition "A basis of a vector space: a linearly independent set that spans it, so every vector has unique coordinates. A subclass of math:MathematicalObject named by a space through math:hasBasis. An orthonormal basis is the eigenvector set of a self-adjoint operator; a math:PrincipalComponent set is the basis PCA selects."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LinearMap
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Linear Map"@x-gmeow-english ;
    skos:definition "A linear map (linear transformation) between vector spaces — a math:Function preserving addition and scalar multiplication. A subclass of math:Function; a matrix (its object-layer representation) realizes one relative to chosen bases. Its math:Rank measures the dimension of its image; a math:CovarianceOperator and the weight action of a neural layer are linear maps."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Rank
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Rank"@x-gmeow-english ;
    skos:definition "The rank of a math:LinearMap — the dimension of its image, a non-negative integer invariant. A subclass of math:MathematicalObject carrying its value through math:rankValue. It bounds how much of the source a map preserves and is the count of non-zero singular values of a math:SingularValueDecomposition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Eigendecomposition
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Eigendecomposition"@x-gmeow-english ;
    skos:definition "The eigendecomposition of a linear operator: a first-class object with declared operands and outputs, factoring the operator into its math:eigenvalue / math:eigenvector pairs (A = QΛQ⁻¹). A subclass of math:MathematicalObject. Externally anchored to the OpenMath linalgeig content dictionary. The spectral decomposition of a math:CovarianceOperator is what a math:PCAAnalysis reads its components off."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SingularValueDecomposition
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Singular Value Decomposition"@x-gmeow-english ;
    skos:definition "The singular value decomposition of a linear map: a first-class object factoring it as A = UΣV* with declared math:singularValue outputs and left/right singular vectors. A subclass of math:MathematicalObject. GMEOW-original in structure (no external ontology models SVD); the count of non-zero singular values is the math:Rank, and a randomized SVD is a common math:eigensolver for PCA."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CovarianceOperator
    a owl:Class ;
    rdfs:subClassOf math:LinearMap ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Covariance Operator"@x-gmeow-english ;
    skos:definition "The covariance operator of a centered data distribution — a self-adjoint, positive-semidefinite linear map whose spectral decomposition yields the principal directions. A subclass of math:LinearMap. A math:PCAAnalysis names the math:CovarianceOperator it decomposes through math:covarianceOperator; its eigenvectors are the loadings and its eigenvalues the explained variances."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PrincipalComponent
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Principal Component"@x-gmeow-english ;
    skos:definition "A principal component: one orthonormal direction of maximal remaining variance produced by a math:PCAAnalysis — an eigenvector of the math:CovarianceOperator. A subclass of math:MathematicalObject, named by an analysis through math:principalComponent, carrying a math:LoadingVector (its coefficients) and explaining a share of variance (math:ExplainedVariance). Its MEANING is never an intrinsic property: what a component encodes is a math:ResidualInterpretationClaim held from a vantage."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:innerProduct
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "inner product"@x-gmeow-english ;
    skos:definition "Relates a math:InnerProductSpace to the inner product it carries — a math:HermitianInnerProduct in the complex case. Domain math:InnerProductSpace, range a math:HermitianInnerProduct or a real inner-product structure (stated in prose). The inner product is what makes orthogonality, and hence a math:OrthogonalComplement, well-defined."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:subspaceOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "subspace of"@x-gmeow-english ;
    skos:definition "Relates a math:Subspace to the vector space it is a subspace of. Domain math:Subspace, range math:VectorSpace (stated in prose). The ambient space a subspace sits in, and against which its orthogonal complement is taken."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:orthogonalComplementOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "orthogonal complement of"@x-gmeow-english ;
    skos:definition "Relates a math:OrthogonalComplement to the subspace S it is the orthogonal complement of (S⊥ of S). Domain math:OrthogonalComplement, range math:Subspace (stated in prose). Distinct from the ambient space (math:ambientSpace, the enclosing inner-product space) — the complement is orthogonal to this subspace within that ambient space."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:definedByInnerProduct
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "defined by inner product"@x-gmeow-english ;
    skos:definition "Relates a math:OrthogonalComplement to the inner product that defines orthogonality for it — the math:HermitianInnerProduct in the complex case. Domain math:OrthogonalComplement, range a math:HermitianInnerProduct or real inner-product structure (stated in prose). An orthogonal complement without a named inner product is ambiguous and ill-formed (math:UnqualifiedOrthogonalComplement)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasBasis
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has basis"@x-gmeow-english ;
    skos:definition "Relates a math:VectorSpace to a math:Basis of it. Domain math:VectorSpace, range math:Basis (stated in prose). A space may carry several bases; the principal-component basis is the one PCA selects for maximal variance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:rankValue
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "rank value"@x-gmeow-english ;
    skos:definition "The non-negative-integer value of a math:Rank — the dimension of the image of the linear map it is the rank of. Domain math:Rank, range xsd:nonNegativeInteger (stated in prose; SHACL enforces xsd:integer with minInclusive 0)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:eigenvalue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "eigenvalue"@x-gmeow-english ;
    skos:definition "Relates a math:Eigendecomposition to one of its eigenvalues λ (Av = λv) — a math:Number, possibly complex. Domain math:Eigendecomposition, range math:Number (stated in prose; modeled as an object, not a bare literal, because eigenvalues may be complex and situated). Paired with a math:eigenvector."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:eigenvector
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "eigenvector"@x-gmeow-english ;
    skos:definition "Relates a math:Eigendecomposition to one of its eigenvectors v (Av = λv). Domain math:Eigendecomposition, range a vector (a math:MathematicalObject in a math:VectorSpace) (stated in prose). The eigenvectors of a math:CovarianceOperator are the principal directions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:singularValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "singular value"@x-gmeow-english ;
    skos:definition "Relates a math:SingularValueDecomposition to one of its singular values σ ≥ 0 (the diagonal of Σ). Domain math:SingularValueDecomposition, range a non-negative math:Number (stated in prose). The count of non-zero singular values is the math:Rank."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Bilinear forms, matrices, norms, and exact numeric carriers ------------ #
# The reusable numeric layer of the linear-algebra charter: a bilinear form and its
# symmetric case, the matrix (and symmetric / Gram matrix) that represents a form in
# a basis, the coordinate vector, and the norm and distance a positive-definite
# symmetric form induces (‖x‖ = √⟨x,x⟩). The coordinates are carried EXACTLY: a
# math:RationalValue is a numerator/denominator integer pair (never a decimal — the
# decimal belongs to a math:ApproximateValue), so a norm √(xᵀGx) grounded on a
# math:GramMatrix of rational entries is exact by construction. These frame classes
# are reused, not re-minted: math:MetricTensor is the tangent-space instance of the
# math:SymmetricBilinearForm idiom, and math:InnerProductSpace remains the frame the
# math:innerProduct is carried on.

math:BilinearForm
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Bilinear Form"@x-gmeow-english ;
    skos:definition "A bilinear form B on a vector space: a map B(·, ·) that is linear in each argument separately. A subclass of math:MathematicalObject. Its definiteness (math:definiteness) records whether it is positive-definite, positive-semidefinite, indefinite, or negative-definite; represented in a math:Basis it becomes a math:Matrix. An inner product is a positive-definite symmetric (or Hermitian) bilinear form; the symmetric case is math:SymmetricBilinearForm."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SymmetricBilinearForm
    a owl:Class ;
    rdfs:subClassOf math:BilinearForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Symmetric Bilinear Form"@x-gmeow-english ;
    skos:definition "A symmetric bilinear form: a math:BilinearForm B with B(x, y) = B(y, x). A subclass of math:BilinearForm. Represented in a basis it is a math:SymmetricMatrix (a math:GramMatrix); when positive-definite it induces a math:Norm and a metric math:Distance. A math:MetricTensor is the tangent-space instance of this idiom — a symmetric bilinear form on each tangent space giving lengths and angles — so the geometry charter's metric and this numeric layer share one notion of a symmetric form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Matrix
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Matrix"@x-gmeow-english ;
    skos:definition "A matrix: a rectangular array of scalars representing a math:LinearMap or a math:BilinearForm relative to a chosen math:Basis. A subclass of math:MathematicalObject carrying its scalars as indexed math:MatrixEntry cells through math:hasEntry (each a math:atRow / math:atColumn / math:entryValue triple over an exact math:RationalValue) and, where relevant, its math:definiteness. The specialized math:CartanMatrix (integer Cartan matrix of a root system) and math:DatasetMatrix (a data frame held by reference) are their own classes and are not reparented here."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SymmetricMatrix
    a owl:Class ;
    rdfs:subClassOf math:Matrix ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Symmetric Matrix"@x-gmeow-english ;
    skos:definition "A symmetric matrix: a square math:Matrix equal to its transpose (Aᵢⱼ = Aⱼᵢ). A subclass of math:Matrix; the matrix of a math:SymmetricBilinearForm in a basis. Its symmetry is checkable on its math:MatrixEntry cells (every entry has a transpose entry of equal value); a math:GramMatrix is the distinguished symmetric matrix of an inner-product-defining form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GramMatrix
    a owl:Class ;
    rdfs:subClassOf math:SymmetricMatrix ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Gram Matrix"@x-gmeow-english ;
    skos:definition "A Gram matrix G: the math:SymmetricMatrix of a math:SymmetricBilinearForm in a math:Basis, Gᵢⱼ = B(eᵢ, eⱼ). A subclass of math:SymmetricMatrix that names the form it represents through math:representsForm and the basis it is taken in through math:inBasis. When the form is positive-definite the Gram matrix is positive-definite and the quadratic form xᵀGx is a squared norm; the affect-intensity norm √(xᵀGx) is grounded on such a Gram matrix of exact math:RationalValue entries."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Vector
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vector"@x-gmeow-english ;
    skos:definition "A coordinate vector: an element of a math:VectorSpace given by its coordinates relative to a math:Basis. A subclass of math:MathematicalObject carrying its coordinates as indexed math:VectorComponent cells through math:hasComponent (each a math:atIndex / math:componentValue pair over an exact math:RationalValue) and naming its basis through math:inBasis. The x in the quadratic form xᵀGx is such a vector."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Norm
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Norm"@x-gmeow-english ;
    skos:definition "A norm ‖·‖: the length function induced by a positive-definite math:SymmetricBilinearForm, ‖x‖ = √⟨x, x⟩ = √(xᵀGx). A subclass of math:MathematicalObject that names the form inducing it through math:inducedByForm. A norm is well-defined only when its form is positive-definite (a math:NonPositiveDefiniteNorm otherwise); it induces a metric math:Distance d(x, y) = ‖x − y‖."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Distance
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Distance"@x-gmeow-english ;
    skos:definition "A metric distance: the value d(x, y) = ‖x − y‖ of the metric induced by a math:Norm. A subclass of math:MathematicalObject that names the norm giving it through math:inducedByNorm. It is the length of the difference vector under the norm; the norm-induced metric satisfies the metric axioms because the norm comes from a positive-definite form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DefinitenessKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Definiteness Kind"@x-gmeow-english ;
    skos:definition "The definiteness of a math:BilinearForm or math:Matrix: one of math:positiveDefinite, math:positiveSemidefinite, math:indefinite, or math:negativeDefinite. An open value vocabulary (individuals, never owl:oneOf), named through math:definiteness. Positive-definiteness is the condition under which a symmetric form induces a genuine math:Norm; the sign structure is the object-layer counterpart of a math:MetricSignature."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RationalValue
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Rational Value"@x-gmeow-english ;
    skos:definition "An exact rational carrier: a concrete p/q value held as a math:numerator and math:denominator integer pair (math:denominator ≠ 0). A subclass of math:MathematicalObject. It realizes the ℚ coordinate that the tower's math:RationalNumber describes abstractly, and — unlike math:ApproximateValue, which carries a decimal literal — it carries NO decimal: 1/4 is the pair (1, 4), never 0.25. Matrix entries and vector components of the exact numeric layer are math:RationalValue, so xᵀGx and the norm √(xᵀGx) are computed exactly."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VectorComponent
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vector Component"@x-gmeow-english ;
    skos:definition "An indexed component of a math:Vector: the cell pairing a position math:atIndex (a zero-based non-negative integer) with a math:componentValue (an exact math:RationalValue). A subclass of math:MathematicalObject named by a vector through math:hasComponent. The component-at-index model keeps coordinates exact and inspectable rather than inlining a decimal tuple."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MatrixEntry
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Matrix Entry"@x-gmeow-english ;
    skos:definition "An indexed entry of a math:Matrix: the cell pairing a position math:atRow and math:atColumn (zero-based non-negative integers) with a math:entryValue (an exact math:RationalValue). A subclass of math:MathematicalObject named by a matrix through math:hasEntry. The row/column/value model makes a matrix's symmetry checkable entry-by-entry (a math:SymmetricMatrix's transpose entries carry equal value)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Numeric-layer conformance failures ------------------------------------- #

math:ZeroDenominator
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Zero Denominator"@x-gmeow-english ;
    skos:definition "The failure raised when a math:RationalValue declares a math:denominator of 0. Zero is not a valid denominator — p/0 is not a rational value — so the exact carrier is ill-formed. The object-layer analogue of the dimension-exponent zero-denominator rule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:NonPositiveDefiniteNorm
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Non-Positive-Definite Norm"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Norm is induced (math:inducedByForm) by a symmetric bilinear form whose math:definiteness is not math:positiveDefinite. ‖x‖ = √⟨x, x⟩ is a genuine norm only for a positive-definite form; a norm resting on an indefinite or semidefinite form is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AsymmetricGramMatrix
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Asymmetric Gram Matrix"@x-gmeow-english ;
    skos:definition "The failure raised when a math:GramMatrix carries a math:MatrixEntry with no transpose entry of equal value — an entry at (row, column) whose (column, row) mate is absent or carries a different math:entryValue. A Gram matrix is the matrix of a symmetric form and must be symmetric; a non-symmetric one is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Definiteness value individuals (open vocabulary) ----------------------- #

math:positiveDefinite
    a owl:NamedIndividual , math:DefinitenessKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "positive-definite"@x-gmeow-english ;
    skos:definition "Positive-definite: xᵀAx > 0 for every non-zero x. The definiteness under which a symmetric bilinear form is an inner product and induces a math:Norm; the object-layer counterpart of a Riemannian metric signature (n, 0)."@x-gmeow-english .

math:positiveSemidefinite
    a owl:NamedIndividual , math:DefinitenessKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "positive-semidefinite"@x-gmeow-english ;
    skos:definition "Positive-semidefinite: xᵀAx ≥ 0 for every x, with equality possible for some non-zero x. A math:CovarianceOperator is positive-semidefinite; it induces a seminorm, not a norm."@x-gmeow-english .

math:indefinite
    a owl:NamedIndividual , math:DefinitenessKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "indefinite"@x-gmeow-english ;
    skos:definition "Indefinite: xᵀAx takes both positive and negative values. A Lorentzian metric is indefinite; an indefinite form does not induce a norm."@x-gmeow-english .

math:negativeDefinite
    a owl:NamedIndividual , math:DefinitenessKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "negative-definite"@x-gmeow-english ;
    skos:definition "Negative-definite: xᵀAx < 0 for every non-zero x — the negation of a positive-definite form. It induces a norm on the negated form, not on itself."@x-gmeow-english .

# --- Numeric-layer object properties ---------------------------------------- #

math:inducedByForm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "induced by form"@x-gmeow-english ;
    skos:definition "Relates a math:Norm to the math:SymmetricBilinearForm that induces it (‖x‖ = √⟨x, x⟩). Domain math:Norm, range math:SymmetricBilinearForm (stated in prose). The form must be positive-definite for the norm to be well-defined (math:NonPositiveDefiniteNorm otherwise)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:inducedByNorm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "induced by norm"@x-gmeow-english ;
    skos:definition "Relates a math:Distance to the math:Norm that induces its metric (d(x, y) = ‖x − y‖). Domain math:Distance, range math:Norm (stated in prose). The norm-induced metric is the distance function of the length structure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:representsForm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "represents form"@x-gmeow-english ;
    skos:definition "Relates a math:GramMatrix to the math:SymmetricBilinearForm it is the matrix of in a basis (Gᵢⱼ = B(eᵢ, eⱼ)). Domain math:GramMatrix, range math:SymmetricBilinearForm (stated in prose). Paired with math:inBasis — the matrix represents THIS form in THAT basis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:inBasis
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "in basis"@x-gmeow-english ;
    skos:definition "Relates a math:GramMatrix or a math:Vector to the math:Basis its entries or coordinates are taken relative to. Domain a math:GramMatrix or math:Vector, range math:Basis (stated in prose). Coordinates and matrix entries are basis-relative; naming the basis makes the representation unambiguous."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:definiteness
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "definiteness"@x-gmeow-english ;
    skos:definition "Relates a math:BilinearForm or math:Matrix to its math:DefinitenessKind — positive-definite, positive-semidefinite, indefinite, or negative-definite. Domain a math:BilinearForm or math:Matrix, range math:DefinitenessKind (stated in prose). Positive-definiteness is the precondition for inducing a math:Norm."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasComponent
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has component"@x-gmeow-english ;
    skos:definition "Relates a math:Vector to one of its indexed math:VectorComponent cells. Domain math:Vector, range math:VectorComponent (stated in prose). Each component carries a math:atIndex position and a math:componentValue; the vector is the family of its components."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:componentValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "component value"@x-gmeow-english ;
    skos:definition "Relates a math:VectorComponent to the exact math:RationalValue at its index. Domain math:VectorComponent, range math:RationalValue (stated in prose). Single-valued (documented in prose, not an OWL characteristic — the math profile is EL-clean) — a component has exactly one value. The value is exact (a numerator/denominator pair), never a decimal literal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasEntry
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has entry"@x-gmeow-english ;
    skos:definition "Relates a math:Matrix to one of its indexed math:MatrixEntry cells. Domain math:Matrix, range math:MatrixEntry (stated in prose). Each entry carries a math:atRow, a math:atColumn, and a math:entryValue; the matrix is the family of its entries, and its symmetry is checkable across transpose entries."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:entryValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "entry value"@x-gmeow-english ;
    skos:definition "Relates a math:MatrixEntry to the exact math:RationalValue at its row/column position. Domain math:MatrixEntry, range math:RationalValue (stated in prose). Single-valued (documented in prose, not an OWL characteristic — the math profile is EL-clean) — an entry has exactly one value. The value is exact (a numerator/denominator pair), never a decimal literal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Numeric-layer datatype properties -------------------------------------- #

math:numerator
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "numerator"@x-gmeow-english ;
    skos:definition "The integer numerator p of a math:RationalValue p/q. Domain math:RationalValue, range xsd:integer (stated in prose). Single-valued (documented in prose, not an OWL characteristic — the math profile is EL-clean) — a rational value has exactly one numerator. Carried as an exact integer, never a decimal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:denominator
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denominator"@x-gmeow-english ;
    skos:definition "The integer denominator q of a math:RationalValue p/q. Domain math:RationalValue, range xsd:integer (stated in prose; SHACL forbids the value 0). Single-valued (documented in prose, not an OWL characteristic — the math profile is EL-clean) — a rational value has exactly one denominator. A zero denominator is ill-formed (math:ZeroDenominator)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:atIndex
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "at index"@x-gmeow-english ;
    skos:definition "The zero-based position of a math:VectorComponent within its vector. Domain math:VectorComponent, range xsd:nonNegativeInteger (stated in prose). Single-valued (documented in prose, not an OWL characteristic — the math profile is EL-clean) — a component sits at exactly one index."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:atRow
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "at row"@x-gmeow-english ;
    skos:definition "The zero-based row index of a math:MatrixEntry. Domain math:MatrixEntry, range xsd:nonNegativeInteger (stated in prose). Single-valued (documented in prose, not an OWL characteristic — the math profile is EL-clean) — an entry sits in exactly one row. Paired with math:atColumn to place the entry, so a symmetric matrix's transpose entries are identifiable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:atColumn
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "at column"@x-gmeow-english ;
    skos:definition "The zero-based column index of a math:MatrixEntry. Domain math:MatrixEntry, range xsd:nonNegativeInteger (stated in prose). Single-valued (documented in prose, not an OWL characteristic — the math profile is EL-clean) — an entry sits in exactly one column. Paired with math:atRow to place the entry."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- PCA and the KG-projection flagship ------------------------------------- #

math:PCAAnalysis
    a owl:Class ;
    rdfs:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "PCA Analysis"@x-gmeow-english ;
    skos:definition "A principal-component analysis: the analysis PROCESS that decomposes a centered, scaled input into orthogonal directions of maximal variance. A subclass of gmeow:Activity (an analysis is a process, distinct from its result objects and from any claim about them). It declares its math:analysisInput, its math:centeringPolicy and math:scalingPolicy, the math:CovarianceOperator it decomposes (math:covarianceOperator), the math:eigensolver used, and its outputs — math:principalComponent, math:loadingVector, math:scoreVector, math:explainedVarianceRatio, and its math:residualSubspace. A PCA missing any of these declared roles is ill-formed (math:IncompletePCAAnalysis)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LoadingVector
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Loading Vector"@x-gmeow-english ;
    skos:definition "A loading vector: the coefficients of a math:PrincipalComponent in the original coordinates — how each input feature contributes to the component. A subclass of math:MathematicalObject named by a PCA through math:loadingVector. Loadings are the eigenvectors of the math:CovarianceOperator; their INTERPRETATION is a math:ResidualInterpretationClaim, not an intrinsic property."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ScoreVector
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Score Vector"@x-gmeow-english ;
    skos:definition "A score vector: the coordinates of a data point projected onto the principal components — the representation of a sample in the PCA basis. A subclass of math:MathematicalObject named by a PCA through math:scoreVector. Scores are inputs projected through the loadings."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ExplainedVariance
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Explained Variance"@x-gmeow-english ;
    skos:definition "The share of total variance a math:PrincipalComponent accounts for — the component's eigenvalue over the trace, a ratio in [0, 1]. A subclass of math:MathematicalObject named by a PCA through math:explainedVarianceRatio; the ratios across retained components measure how much structure the projection keeps."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProjectionResidual
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Projection Residual"@x-gmeow-english ;
    skos:definition "The residual of a projection: what a subspace projection leaves behind — the component of the data orthogonal to the retained subspace. A subclass of math:MathematicalObject; the residual subspace of a PCA is named through math:residualSubspace and is often a math:OrthogonalComplement. Its MEANING — what the residual encodes — is a math:ResidualInterpretationClaim held from a vantage, never a property stamped on the residual."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ResidualInterpretationClaim
    a owl:Class ;
    rdfs:subClassOf gmeow:Observation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Residual Interpretation Claim"@x-gmeow-english ;
    skos:definition "The claim of what a math:ProjectionResidual, a math:PrincipalComponent, or a latent dimension MEANS — 'this direction encodes X'. A subclass of gmeow:Observation: semantic meaning read off geometry is inference from a standpoint, so it carries a gmeow:vantage (whose frame), a gmeow:observedFeature (which residual/component/dimension), and a gmeow:observationResult (the grounded conclusion, typically a logic:MetaLevelFormula), never an intrinsic property of the vector. A meaning asserted without its vantage is ill-formed (math:ResidualMeaningAsProperty); and no direct meaning property is minted, so a meaning is representable only through this claim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CenteringPolicy
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Centering Policy"@x-gmeow-english ;
    skos:definition "The centering policy of a math:PCAAnalysis: whether the input is mean-centered before decomposition — one of math:meanCentered or math:uncentered. A value vocabulary (individuals, never subclasses); a PCA names exactly one through math:centeringPolicy, because the covariance a PCA decomposes depends on it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:meanCentered
    a owl:NamedIndividual , math:CenteringPolicy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "mean centered"@x-gmeow-english ;
    skos:definition "The mean-centered policy: each feature's mean is subtracted before decomposition, so the covariance operator is about the centroid. The standard PCA policy."@x-gmeow-english .

math:uncentered
    a owl:NamedIndividual , math:CenteringPolicy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "uncentered"@x-gmeow-english ;
    skos:definition "The uncentered policy: the decomposition is taken about the origin without subtracting the mean — a distinct analysis (uncentered PCA / second-moment decomposition), so the policy must be declared, not assumed."@x-gmeow-english .

math:ScalingPolicy
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Scaling Policy"@x-gmeow-english ;
    skos:definition "The scaling policy of a math:PCAAnalysis: whether features are standardized to unit variance before decomposition — one of math:unitVariance or math:unscaled. A value vocabulary (individuals, never subclasses); a PCA names exactly one through math:scalingPolicy, because standardizing changes which directions carry the variance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:unitVariance
    a owl:NamedIndividual , math:ScalingPolicy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "unit variance"@x-gmeow-english ;
    skos:definition "The unit-variance policy: each feature is scaled to unit standard deviation (correlation-matrix PCA), so features on different scales contribute comparably."@x-gmeow-english .

math:unscaled
    a owl:NamedIndividual , math:ScalingPolicy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "unscaled"@x-gmeow-english ;
    skos:definition "The unscaled policy: features keep their original units (covariance-matrix PCA), so high-variance features dominate the leading components — a distinct analysis, declared rather than assumed."@x-gmeow-english .

math:analysisInput
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "analysis input"@x-gmeow-english ;
    skos:definition "Relates a math:PCAAnalysis to the object it decomposes — a data matrix, a subspace, or a residual subspace. Domain math:PCAAnalysis, range a math:MathematicalObject (a matrix, math:Subspace, or math:OrthogonalComplement) (stated in prose). The declared input of the analysis; an analysis without its input is ill-formed (math:IncompletePCAAnalysis)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:centeringPolicy
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "centering policy"@x-gmeow-english ;
    skos:definition "Relates a math:PCAAnalysis to its math:CenteringPolicy. Domain math:PCAAnalysis, range math:CenteringPolicy (stated in prose). Every PCA declares exactly one; the covariance it decomposes depends on it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:scalingPolicy
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "scaling policy"@x-gmeow-english ;
    skos:definition "Relates a math:PCAAnalysis to its math:ScalingPolicy. Domain math:PCAAnalysis, range math:ScalingPolicy (stated in prose). Every PCA declares exactly one; standardizing to unit variance changes which directions carry the variance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:covarianceOperator
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "covariance operator"@x-gmeow-english ;
    skos:definition "Relates a math:PCAAnalysis to the math:CovarianceOperator it decomposes. Domain math:PCAAnalysis, range math:CovarianceOperator (stated in prose). The operator whose spectral decomposition yields the principal components; a PCA without it is ill-formed (math:IncompletePCAAnalysis)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:eigensolver
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "eigensolver"@x-gmeow-english ;
    skos:definition "Relates a math:PCAAnalysis to the solver used to compute the decomposition — for example a full eigendecomposition or a randomized math:SingularValueDecomposition. Domain math:PCAAnalysis, range a math:Eigendecomposition, math:SingularValueDecomposition, or named solver (stated in prose). The declared method; an analysis without it is ill-formed (math:IncompletePCAAnalysis)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:principalComponent
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "principal component"@x-gmeow-english ;
    skos:definition "Relates a math:PCAAnalysis to one of the math:PrincipalComponent directions it produces. Domain math:PCAAnalysis, range math:PrincipalComponent (stated in prose). The declared component outputs; a PCA producing none is ill-formed (math:IncompletePCAAnalysis)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:loadingVector
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "loading vector"@x-gmeow-english ;
    skos:definition "Relates a math:PCAAnalysis to a math:LoadingVector it produces — the coefficients of a component in the original features. Domain math:PCAAnalysis, range math:LoadingVector (stated in prose). A declared output of the analysis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:scoreVector
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "score vector"@x-gmeow-english ;
    skos:definition "Relates a math:PCAAnalysis to a math:ScoreVector it produces — a data point's coordinates in the principal-component basis. Domain math:PCAAnalysis, range math:ScoreVector (stated in prose). A declared output of the analysis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:explainedVarianceRatio
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "explained variance ratio"@x-gmeow-english ;
    skos:definition "Relates a math:PCAAnalysis to a math:ExplainedVariance it produces — the share of total variance a component accounts for. Domain math:PCAAnalysis, range math:ExplainedVariance (stated in prose). A declared output of the analysis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:residualSubspace
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "residual subspace"@x-gmeow-english ;
    skos:definition "Relates a math:PCAAnalysis to its math:ProjectionResidual or the residual subspace left after retaining the leading components — often a math:OrthogonalComplement. Domain math:PCAAnalysis, range a math:ProjectionResidual, math:Subspace, or math:OrthogonalComplement (stated in prose). A declared output; what the residual MEANS is a math:ResidualInterpretationClaim, not a property of the subspace."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Learning, embeddings, and latent spaces -------------------------------- #

math:LearnedModel
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Learned Model"@x-gmeow-english ;
    skos:definition "A learned model: a parameterized map fitted by solving a math:OptimizationProblem — the trained artifact an embedding or a classifier is. A subclass of math:MathematicalObject; a math:Embedding names the model producing it through math:embeddingModel, and a neural model's forward structure is a math:TensorComputationGraph with weights in a math:ParameterSpace."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LossFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Loss Function"@x-gmeow-english ;
    skos:definition "A loss (objective) function: the scalar-valued map a math:OptimizationProblem minimizes — the discrepancy between prediction and target. A subclass of math:Function; named by an optimization problem through math:objectiveFunction. Its gradient is the calculus charter's derivative machinery."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:OptimizationProblem
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Optimization Problem"@x-gmeow-english ;
    skos:definition "An optimization problem: the SPECIFICATION training solves — minimize a math:objectiveFunction (a math:LossFunction) subject to declared math:constraint(s). A subclass of math:MathematicalObject (the problem is the spec; the training run that solves it is a gmeow:Activity). GMEOW-original in structure; the objective's gradient is the calculus charter's derivatives."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Embedding
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Embedding"@x-gmeow-english ;
    skos:definition "An embedding: a map from a source object into a target latent space that preserves chosen structure. A subclass of math:Function naming its math:embeddingSource, its math:targetSpace, its math:embeddingFunction, and the math:embeddingModel that produced it. An embedding missing any of these is ill-formed (math:UnderspecifiedEmbedding)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:KnowledgeGraphEmbedding
    a owl:Class ;
    rdfs:subClassOf math:Embedding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Knowledge Graph Embedding"@x-gmeow-english ;
    skos:definition "A knowledge-graph embedding: an embedding that maps the nodes and relations of a graph into a math:LatentSpace so that graph structure becomes latent geometry. A subclass of math:Embedding whose math:embeddingSource is a graph and whose math:targetSpace is a latent (often complex) space — the source of the KG-projection / PCA-of-residuals flagship."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LatentSpace
    a owl:Class ;
    rdfs:subClassOf math:VectorSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Latent Space"@x-gmeow-english ;
    skos:definition "A latent (representation) space: the target vector space an embedding maps into, whose coordinates are learned rather than given. A subclass of math:VectorSpace; its dimensions are math:EmbeddingDimension objects. What a latent dimension MEANS is GMEOW-original territory (no external ontology) and is a math:ResidualInterpretationClaim held from a vantage, not an intrinsic property."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:EmbeddingDimension
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Embedding Dimension"@x-gmeow-english ;
    skos:definition "One coordinate axis of a math:LatentSpace — a single latent dimension of an embedding. A subclass of math:MathematicalObject related to its space through math:latentDimensionOf. GMEOW-original; its interpretation ('this axis encodes sentiment') is a math:ResidualInterpretationClaim, never a property of the axis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:embeddingSource
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "embedding source"@x-gmeow-english ;
    skos:definition "Relates a math:Embedding to the object it embeds — a graph, a corpus, a set of entities. Domain math:Embedding, range a math:MathematicalObject or graph (stated in prose). The declared source; an embedding without it is ill-formed (math:UnderspecifiedEmbedding)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:targetSpace
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "target space"@x-gmeow-english ;
    skos:definition "Relates a math:Embedding to the math:LatentSpace it maps into. Domain math:Embedding, range math:LatentSpace or math:VectorSpace (stated in prose). The declared target; an embedding without it is ill-formed (math:UnderspecifiedEmbedding)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:embeddingFunction
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "embedding function"@x-gmeow-english ;
    skos:definition "Relates a math:Embedding to the math:Function realizing the map from source elements to target vectors. Domain math:Embedding, range math:Function (stated in prose). The declared map; an embedding without it is ill-formed (math:UnderspecifiedEmbedding)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:embeddingModel
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "embedding model"@x-gmeow-english ;
    skos:definition "Relates a math:Embedding to the math:LearnedModel that produced it. Domain math:Embedding, range math:LearnedModel (stated in prose). The declared model; an embedding without it is ill-formed (math:UnderspecifiedEmbedding)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:objectiveFunction
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "objective function"@x-gmeow-english ;
    skos:definition "Relates a math:OptimizationProblem to the math:LossFunction it minimizes. Domain math:OptimizationProblem, range math:LossFunction (stated in prose). The declared objective the problem optimizes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:constraint
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "constraint"@x-gmeow-english ;
    skos:definition "Relates a math:OptimizationProblem to a constraint restricting its feasible set — for example a norm bound or an orthogonality condition, denoting a logic: formula where truth-valued. Domain math:OptimizationProblem, range a constraint object or logic: formula (stated in prose). Constraints scope the optimization; they are declared, not implicit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:latentDimensionOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "latent dimension of"@x-gmeow-english ;
    skos:definition "Relates a math:EmbeddingDimension to the math:LatentSpace it is an axis of. Domain math:EmbeddingDimension, range math:LatentSpace (stated in prose). Names which latent space a dimension belongs to; its meaning remains a vantage-held claim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Filtrations, persistence, and stability-calibrated credence ------------- #
# The topological read of an embedding: filter the embedded image by a real-valued
# threshold, watch which features (math:HomologyGroup generators) are born and die
# across the filtration, and turn the PERSISTENCE of a feature — how long it survives
# — into a calibrated logic:confidence on a latent-meaning claim. This is the
# topological sibling of the status-quo embedding-similarity signal: the credence a
# latent direction MEANS something can be derived from nearest-neighbour similarity
# (math:similarityDerivedCredence) OR from the persistence of the topological feature
# that direction realizes (math:persistenceDerivedCredence). The calibration is not a
# free number: the Cohen-Steiner–Edelsbrunner–Harer stability theorem
# (math:bottleneckStabilityTheorem) bounds how much a persistence diagram can move
# under a perturbation of the underlying function, so a persistence-derived credence is
# a warranted quantity, not a heuristic. Filtration classes reuse math:TopologicalSpace
# and math:HomologyGroup from the topology charter and math:subsetOf for the nesting;
# the credence rides the SAME math:ResidualInterpretationClaim surface the PCA-of-
# residuals flagship uses, carrying logic:confidence (never logic:probability).

math:Filtration
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Filtration"@x-gmeow-english ;
    skos:definition "A filtration (Kε): a monotone family of substructures of an ambient object indexed by a real-valued threshold ε, such that a smaller threshold's structure is contained in a larger one's — for thresholds ε₁ ≤ ε₂ the stage at ε₁ satisfies Kε₁ math:subsetOf Kε₂ (the containment is the EXISTING transitive math:subsetOf, not a new order relation). A subclass of math:MathematicalObject. It names the object it filters through math:filtrationAmbient, the index quantity kind through math:filtrationIndexKind (the dimension the threshold ε ranges over — a distance/scale/density), and its stages through math:hasFiltrationStage, each a math:FiltrationStage pairing a threshold with the substructure present at it. The nesting law that ε₁ ≤ ε₂ entails containment is authored as the first-order logic:Formula math:filtrationMonotonicityLaw; the SHACL gate enforces only the structural presence of stages (a filtration naming no stage, or a stage missing its threshold or structure, is ill-formed, math:UnderspecifiedFiltration). The persistence of a feature across a filtration is a math:PersistenceLifetime."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FiltrationStage
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Filtration Stage"@x-gmeow-english ;
    skos:definition "One stage of a math:Filtration: a (threshold, substructure) cell naming the real-valued threshold ε it sits at through math:filtrationThreshold (a gmeow:Quantity) and the substructure present at that threshold through math:stageStructure (a math:TopologicalSpace — the sub-space Kε of the ambient object at ε). A subclass of math:MathematicalObject; a filtration names its stages through math:hasFiltrationStage. Stages are ordered by their thresholds, and the monotonicity law math:filtrationMonotonicityLaw requires the structure at a lower threshold to be a math:subsetOf the structure at a higher one. A stage missing its threshold or its structure is ill-formed (math:UnderspecifiedFiltration)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PersistenceLifetime
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Persistence Lifetime"@x-gmeow-english ;
    skos:definition "The birth–death interval of a single topological feature across a math:Filtration: the range of thresholds over which one math:HomologyGroup generator (a hole of some dimension) exists. A subclass of math:MathematicalObject. It names the filtration it is read over through math:overFiltration, the feature it tracks through math:persistenceFeature (a math:HomologyGroup generator), the threshold at which the feature appears through math:bornAt (a gmeow:Quantity), and the threshold at which it disappears through math:diesAt. Its persistence value is death − birth; a long-lived feature is signal, a short-lived one is noise. An ESSENTIAL feature never dies within the filtration, so its math:diesAt is the individual math:PositiveInfinity rather than a finite threshold — exactly as math:totalMass ranges over a finite value or math:PositiveInfinity, which is why math:diesAt is a bare rdf:Property. A lifetime missing its birth or death is ill-formed (math:UnderspecifiedPersistenceLifetime)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CredenceDerivationKind
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Credence Derivation Kind"@x-gmeow-english ;
    skos:definition "The kind of evidence a credence on a latent-meaning claim is derived from — the axis that names WHICH signal produced a logic:confidence. A value vocabulary (individuals, never subclasses): its two members are math:similarityDerivedCredence (credence from embedding-space similarity/nearest-neighbour search, the status-quo signal) and math:persistenceDerivedCredence (credence from the topological persistence of the feature the latent direction realizes, warranted by math:bottleneckStabilityTheorem). A math:StabilityCalibrationRecord names exactly one through math:credenceDerivationKind, so which evidence a confidence rests on is queryable rather than implicit. Minting the axis with BOTH siblings — rather than a lone persistence individual — keeps the two credence sources one system, not two parallel ones."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:similarityDerivedCredence
    a owl:NamedIndividual , math:CredenceDerivationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "similarity-derived credence"@x-gmeow-english ;
    skos:definition "The credence-derivation kind naming the status-quo signal: a confidence derived from similarity in the embedding space — nearest-neighbour retrieval, cosine similarity, or clustering density in a math:LatentSpace. It is a geometric proximity signal, calibrated against distances rather than topological survival; the sibling math:persistenceDerivedCredence derives the same kind of confidence from the persistence of a topological feature instead."@x-gmeow-english .

math:persistenceDerivedCredence
    a owl:NamedIndividual , math:CredenceDerivationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "persistence-derived credence"@x-gmeow-english ;
    skos:definition "The credence-derivation kind naming the topological signal: a confidence derived from the math:PersistenceLifetime of a feature across a math:Filtration — how long a math:HomologyGroup generator survives (death − birth) is turned into a logic:confidence on the latent-meaning claim that feature supports. Unlike a bare heuristic, this credence is warranted: the Cohen-Steiner–Edelsbrunner–Harer bottleneck stability theorem (math:bottleneckStabilityTheorem) bounds how far the persistence diagram — and hence the derived credence — can move under a perturbation of the underlying function, which is what a math:StabilityCalibrationRecord records. The topological sibling of math:similarityDerivedCredence over the same math:ResidualInterpretationClaim surface."@x-gmeow-english .

math:computationalTopologyTheory
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "computational topology (persistence theory)"@x-gmeow-english ;
    skos:definition "The named, versioned theory context under which math:bottleneckStabilityTheorem holds its theorem role: the theory of persistent homology and its stability results as developed in computational topology (Edelsbrunner–Harer, Computational Topology: An Introduction, and the stability line originating with Cohen-Steiner–Edelsbrunner–Harer 2007). A theorem's status is theory-relative (math:roleInTheory), so the stability bound is stated as a theorem IN this theory, never as an unconditional global truth bit."@x-gmeow-english .

math:cohenSteinerEdelsbrunnerHarer2007
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cohen-Steiner, Edelsbrunner & Harer (2007), Stability of Persistence Diagrams"@x-gmeow-english ;
    skos:definition "The external warrant standing in for an in-graph math:Proof of math:bottleneckStabilityTheorem: Cohen-Steiner, D., Edelsbrunner, H., & Harer, J. (2007). Stability of Persistence Diagrams. Discrete & Computational Geometry, 37(1), 103–120. The published proof that the persistence-diagram map is 1-Lipschitz in the bottleneck distance — the attested basis on which the theorem discharges the theorem-is-not-a-truth-bit gate."@x-gmeow-english .

math:bottleneckStabilityTheorem
    a math:Theorem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "bottleneck stability of persistence diagrams"@x-gmeow-english ;
    math:statementRole math:roleTheorem ;
    math:roleInTheory math:computationalTopologyTheory ;
    math:externalWarrant math:cohenSteinerEdelsbrunnerHarer2007 ;
    skos:definition "The bottleneck stability theorem for persistence diagrams (Cohen-Steiner–Edelsbrunner–Harer 2007): for tame real-valued functions f, g on a common topological space, the bottleneck distance between their persistence diagrams is bounded by the supremum-norm distance of the functions — d_B(Dgm(f), Dgm(g)) ≤ ‖f − g‖_∞ — i.e. the persistence-diagram map is 1-Lipschitz. A math:Theorem held under math:computationalTopologyTheory (math:roleInTheory) and warranted by the published proof (math:externalWarrant math:cohenSteinerEdelsbrunnerHarer2007), so its theorem-hood is a theory-scoped, warranted role, not a truth bit read off the type. Corollary (kept, and correct by the triangle inequality on the two independently-bounded endpoints): a single feature's persistence value, death − birth, can shift by at most 2‖f − g‖_∞ under such a perturbation, since |Δbirth| ≤ ‖f − g‖_∞ and |Δdeath| ≤ ‖f − g‖_∞ give |Δ(death − birth)| ≤ 2‖f − g‖_∞. This is the guarantee a math:StabilityCalibrationRecord cites through math:stabilityGuarantee to warrant a math:persistenceDerivedCredence. (No Wasserstein-distance bound is asserted here: the Wasserstein stability of persistence diagrams needs extra tameness/finiteness hypotheses that this statement does not verify, so it is deliberately left out.)"@x-gmeow-english .

math:UnderspecifiedFiltration
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Filtration"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Filtration or one of its stages is not structurally complete: a filtration declaring no math:hasFiltrationStage, or a math:FiltrationStage missing its math:filtrationThreshold or its math:stageStructure. A filtration is a family of substructures indexed by a threshold; one without stages, or a stage that names neither where it sits nor what is present there, is ill-formed. This gate enforces STRUCTURAL PRESENCE only — the monotonicity of the family (ε₁ ≤ ε₂ ⇒ containment) is carried by the first-order law math:filtrationMonotonicityLaw, not by this SHACL gate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnderspecifiedPersistenceLifetime
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Persistence Lifetime"@x-gmeow-english ;
    skos:definition "The failure raised when a math:PersistenceLifetime does not declare both endpoints of its birth–death interval: it is missing its math:bornAt (the threshold the feature appears at) or its math:diesAt (the threshold it disappears at — a finite gmeow:Quantity, or math:PositiveInfinity for an essential feature that never dies within the filtration). A lifetime is the interval death − birth; one missing either endpoint has no persistence value and is ill-formed. Omitting math:diesAt entirely is a violation even for an essential feature — the death must be stated as math:PositiveInfinity, never left absent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UngroundedStabilityCalibration
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ungrounded Stability Calibration"@x-gmeow-english ;
    skos:definition "The failure raised when a math:StabilityCalibrationRecord does not carry the evidence and warrant a calibrated credence rests on: it is missing its math:calibrationEvidence (the math:PersistenceLifetime whose persistence produced the credence), its math:credenceDerivationKind (which signal the credence derives from), or its math:stabilityGuarantee (the theorem bounding how far the persistence — and hence the credence — can move under perturbation). A persistence-derived credence with no evidence, no declared derivation kind, or no stability guarantee is an unwarranted number rather than a calibrated one, and is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:StabilityCalibrationRecord
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Stability Calibration Record"@x-gmeow-english ;
    skos:definition "The derivation record that warrants a credence: it ties the persistence evidence, the derivation kind, and the stability guarantee to the logic:confidence a latent-meaning claim carries. A subclass of math:MathematicalObject naming its evidence through math:calibrationEvidence (a math:PersistenceLifetime), the kind of credence it produces through math:credenceDerivationKind (typically math:persistenceDerivedCredence), and the theorem underwriting the calibration through math:stabilityGuarantee (math:bottleneckStabilityTheorem — the bottleneck bound that a small perturbation of the underlying function moves the persistence, and hence the credence, by a bounded amount). The credence itself lands on the held claim, a math:ResidualInterpretationClaim carrying logic:confidence (never logic:probability); the claim references the record through gmeow:wasDerivedFrom, so a consumer can trace a confidence back to the filtration, the birth/death thresholds, and the guarantee that calibrated it. A record missing its evidence, derivation kind, or guarantee is ill-formed (math:UngroundedStabilityCalibration)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:hasFiltrationStage
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has filtration stage"@x-gmeow-english ;
    skos:definition "Relates a math:Filtration to one of its math:FiltrationStage cells — a (threshold, substructure) pair of the indexed family. Domain math:Filtration, range math:FiltrationStage (stated in prose). A filtration is given by its stages; one declaring no stage is ill-formed (math:UnderspecifiedFiltration)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:filtrationThreshold
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "filtration threshold"@x-gmeow-english ;
    skos:definition "Relates a math:FiltrationStage to the real-valued threshold ε it sits at — the index value of the stage in the filtration. Domain math:FiltrationStage, range gmeow:Quantity (stated in prose). Every stage names exactly one; a stage without its threshold is ill-formed (math:UnderspecifiedFiltration). The monotonicity law math:filtrationMonotonicityLaw orders stages by this threshold."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:stageStructure
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "stage structure"@x-gmeow-english ;
    skos:definition "Relates a math:FiltrationStage to the substructure present at its threshold — the sub-space Kε of the filtered object at ε. Domain math:FiltrationStage, range math:TopologicalSpace (stated in prose). Every stage names exactly one; a stage without its structure is ill-formed (math:UnderspecifiedFiltration). The structure at a lower threshold is a math:subsetOf the structure at a higher one (math:filtrationMonotonicityLaw)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:filtrationIndexKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "filtration index kind"@x-gmeow-english ;
    skos:definition "Relates a math:Filtration to the quantity kind its threshold ε ranges over — the dimension of the index, such as a distance/scale (a math:Dimension) for a Vietoris–Rips or Čech filtration or a density for a sublevel-set filtration. Domain math:Filtration, range a math:Dimension or quantity kind (stated in prose). Names what the threshold measures, so two filtrations' thresholds are only comparable when their index kinds agree."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:filtrationAmbient
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "filtration ambient"@x-gmeow-english ;
    skos:definition "Relates a math:Filtration to the ambient object it filters — the point cloud, embedded image, or space whose substructures the stages are. Domain math:Filtration, range math:MathematicalObject (stated in prose, e.g. the image of a math:Embedding into a math:LatentSpace). The object the family of substructures lives in."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:overFiltration
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "over filtration"@x-gmeow-english ;
    skos:definition "Relates a math:PersistenceLifetime to the math:Filtration it is read over — the indexed family across which the feature is born and dies. Domain math:PersistenceLifetime, range math:Filtration (stated in prose). A lifetime is always relative to a filtration; its birth and death thresholds are index values of that filtration."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:persistenceFeature
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "persistence feature"@x-gmeow-english ;
    skos:definition "Relates a math:PersistenceLifetime to the topological feature it tracks — a math:HomologyGroup generator (a connected component, loop, or higher-dimensional void) whose birth and death the lifetime records. Domain math:PersistenceLifetime, range math:HomologyGroup (stated in prose). The feature whose survival across the filtration is the persistence signal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:bornAt
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "born at"@x-gmeow-english ;
    skos:definition "Relates a math:PersistenceLifetime to the threshold at which its feature appears in the filtration — the birth ε of the feature. Domain math:PersistenceLifetime, range gmeow:Quantity (stated in prose). Every lifetime names exactly one birth; a lifetime without it is ill-formed (math:UnderspecifiedPersistenceLifetime). Birth is always a finite threshold (a feature is born when it first appears); the death (math:diesAt) may be finite or math:PositiveInfinity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:diesAt
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dies at"@x-gmeow-english ;
    skos:definition "Relates a math:PersistenceLifetime to the threshold at which its feature disappears — the death ε of the feature, or math:PositiveInfinity for an ESSENTIAL feature that never dies within the filtration. Domain math:PersistenceLifetime, range a gmeow:Quantity (the finite death threshold) or the individual math:PositiveInfinity (stated in prose). It is an rdf:Property, not an owl:ObjectProperty or owl:DatatypeProperty, precisely because its range spans both a finite quantity individual and the extended-real math:PositiveInfinity — the same extended-real modelling math:totalMass uses, so the honest RDF supertype carries both without a DL contradiction. A lifetime missing its death entirely is ill-formed (math:UnderspecifiedPersistenceLifetime): even an essential feature must state math:PositiveInfinity rather than omit the death."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:credenceDerivationKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "credence derivation kind"@x-gmeow-english ;
    skos:definition "Relates a math:StabilityCalibrationRecord to the math:CredenceDerivationKind it produces — math:similarityDerivedCredence or math:persistenceDerivedCredence. Domain math:StabilityCalibrationRecord, range math:CredenceDerivationKind (stated in prose). Every record names exactly one, so which signal a calibrated logic:confidence rests on is queryable; a record without it is ill-formed (math:UngroundedStabilityCalibration)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:calibrationEvidence
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "calibration evidence"@x-gmeow-english ;
    skos:definition "Relates a math:StabilityCalibrationRecord to the math:PersistenceLifetime whose persistence (death − birth) produced the calibrated credence — the evidence the confidence rests on. Domain math:StabilityCalibrationRecord, range math:PersistenceLifetime (stated in prose). Every record names at least one; a record with no evidence is an unwarranted number and is ill-formed (math:UngroundedStabilityCalibration)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:stabilityGuarantee
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "stability guarantee"@x-gmeow-english ;
    skos:definition "Relates a math:StabilityCalibrationRecord to the math:Theorem underwriting its calibration — the stability result bounding how far the persistence, and hence the derived credence, can move under a perturbation of the underlying function (math:bottleneckStabilityTheorem, the 1-Lipschitz bottleneck bound). Domain math:StabilityCalibrationRecord, range math:Theorem (stated in prose). The warrant that turns a persistence-derived credence from a heuristic into a bounded quantity; a record without it is ill-formed (math:UngroundedStabilityCalibration)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Reified relation atoms for the filtration-monotonicity law (HiLog) ------ #

math:hasFiltrationStageRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "hasStage(K,s) ⟺ s is a stage of filtration K"@x-gmeow-english ;
    rdfs:seeAlso math:hasFiltrationStage ;
    skos:definition "The HiLog reflection of stage membership as a binary relation individual, so the filtration-monotonicity law can predicate 's is a stage of K' inside a logic:Formula atom. Reflects the existing math:hasFiltrationStage declaration (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:filtrationThresholdRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "thresholdOf(s,e) ⟺ stage s sits at threshold e"@x-gmeow-english ;
    rdfs:seeAlso math:filtrationThreshold ;
    skos:definition "The HiLog reflection of a stage's threshold as a binary relation individual, so the filtration-monotonicity law can predicate 'stage s sits at threshold e' inside a logic:Formula atom. Reflects the existing math:filtrationThreshold declaration (rdfs:seeAlso)."@x-gmeow-english .

math:stageStructureRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "structureOf(s,A) ⟺ stage s carries substructure A"@x-gmeow-english ;
    rdfs:seeAlso math:stageStructure ;
    skos:definition "The HiLog reflection of a stage's substructure as a binary relation individual, so the filtration-monotonicity law can predicate 'stage s carries substructure A' inside a logic:Formula atom. Reflects the existing math:stageStructure declaration (rdfs:seeAlso)."@x-gmeow-english .

math:thresholdOrderRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "leq(e1,e2) ⟺ ε₁ ≤ ε₂ on the index"@x-gmeow-english ;
    skos:definition "The threshold-order relation the filtration-monotonicity law quantifies over: leq(e1,e2) holds exactly when ε₁ ≤ ε₂ in the filtration's real-valued index. A binary HiLog relation individual over which the law states 'a smaller threshold's structure is contained in a larger one's'; no first-class asserted property is minted, because the order is the numeric order on the index quantity, a derived comparison rather than authored data."@x-gmeow-english .

math:subsetRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "subset(A,B) ⟺ A ⊆ B"@x-gmeow-english ;
    rdfs:seeAlso math:subsetOf ;
    skos:definition "The HiLog reflection of containment as a binary relation individual in the natural subset order, so the filtration-monotonicity law can state its consequent 'A ⊆ B' inside a logic:Formula atom. Reflects the existing transitive math:subsetOf declaration (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

# --- Law: filtration monotonicity — ε₁ ≤ ε₂ entails containment -------------- #
# ∀K,s1,s2,e1,e2,A,B: hasStage(K,s1) ∧ hasStage(K,s2) ∧ thresholdOf(s1,e1)
#   ∧ thresholdOf(s2,e2) ∧ structureOf(s1,A) ∧ structureOf(s2,B) ∧ leq(e1,e2)
#   → subset(A,B)
# The defining law of a math:Filtration, authored as a first-order logic:Formula
# exactly as math:continuityLaw and math:connectednessLaw author their hard laws.
# It is the monotonicity a filtration preserves: the substructure at a lower
# threshold is contained in the substructure at a higher one. The SHACL gate
# enforces only the structural presence of stages (math:UnderspecifiedFiltration);
# this law carries the ordering content that a presence gate cannot express.

math:filtrationMonotonicityLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "filtration monotonicity: a smaller threshold's structure is contained in a larger one's"@x-gmeow-english ;
    skos:definition "The defining law of a math:Filtration as a universally-quantified first-order logic:Formula over the reified stage/threshold/structure signature: for a filtration K with stages s₁ and s₂ at thresholds ε₁ and ε₂ carrying substructures A and B, if ε₁ ≤ ε₂ then A math:subsetOf B. math: expresses the law; logic: owns reasoning over it. It is the monotonicity a filtration carries — the family of substructures grows with the threshold — and it is the ordering content the structural presence gate (math:UnderspecifiedFiltration) cannot express, so it is authored as a real law rather than left implicit. A sibling of math:continuityLaw and math:connectednessLaw in the same first-order style."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "K" ] ,
        [ logic:termIndex 1 ; logic:termVariable "s1" ] ,
        [ logic:termIndex 2 ; logic:termVariable "s2" ] ,
        [ logic:termIndex 3 ; logic:termVariable "e1" ] ,
        [ logic:termIndex 4 ; logic:termVariable "e2" ] ,
        [ logic:termIndex 5 ; logic:termVariable "A" ] ,
        [ logic:termIndex 6 ; logic:termVariable "B" ] ;
    logic:forall math:filtrationMonotonicityImpl .

math:filtrationMonotonicityImpl a logic:Formula ;
    logic:antecedent math:filtrationMonotonicityAnte ;
    logic:consequent math:filtrationMonotonicityCons .

math:filtrationMonotonicityAnte a logic:Formula ;
    logic:and math:fmA1 , math:fmA2 , math:fmA3 , math:fmA4 , math:fmA5 , math:fmA6 , math:fmA7 .

math:fmA1 a logic:Formula ; logic:relation math:hasFiltrationStageRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "K" ] , [ logic:termIndex 1 ; logic:termVariable "s1" ] .
math:fmA2 a logic:Formula ; logic:relation math:hasFiltrationStageRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "K" ] , [ logic:termIndex 1 ; logic:termVariable "s2" ] .
math:fmA3 a logic:Formula ; logic:relation math:filtrationThresholdRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s1" ] , [ logic:termIndex 1 ; logic:termVariable "e1" ] .
math:fmA4 a logic:Formula ; logic:relation math:filtrationThresholdRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s2" ] , [ logic:termIndex 1 ; logic:termVariable "e2" ] .
math:fmA5 a logic:Formula ; logic:relation math:stageStructureRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s1" ] , [ logic:termIndex 1 ; logic:termVariable "A" ] .
math:fmA6 a logic:Formula ; logic:relation math:stageStructureRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s2" ] , [ logic:termIndex 1 ; logic:termVariable "B" ] .
math:fmA7 a logic:Formula ; logic:relation math:thresholdOrderRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "e1" ] , [ logic:termIndex 1 ; logic:termVariable "e2" ] .

math:filtrationMonotonicityCons a logic:Formula ; logic:relation math:subsetRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "A" ] , [ logic:termIndex 1 ; logic:termVariable "B" ] .

# --- An AI describing its own structure — the self-structure flagship -------- #

math:TensorComputationGraph
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Tensor Computation Graph"@x-gmeow-english ;
    skos:definition "A neural network's forward pass AS a mathematical object: an expression graph whose nodes are math:ApplicationExpressions over tensor operators (math:matrixProduct, math:tensorContraction, math:AttentionOperation as a bilinear form), whose leaves are math:WeightTensors in a math:ParameterSpace, and whose structure is the architecture. A subclass of math:MathematicalObject naming its math:computationNode(s); it reuses the expression AST wholesale (the nodes are math:ApplicationExpression with indexed math:ArgumentSlot operands), so the application/slot gates apply unchanged. A graph declaring no computation node is ill-formed (math:MalformedTensorComputationGraph). The AI's reflection on this structure is carried at the logic: metalevel, not in math:."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:NeuralLayer
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Neural Layer"@x-gmeow-english ;
    skos:definition "One layer of a math:TensorComputationGraph — a stage applying a math:WeightTensor (via a linear map) followed by a math:ActivationFunction. A subclass of math:MathematicalObject; a math:WeightTensor names the layer it is the weight of through math:weightOf. Layers compose into the architecture the graph represents (math:architectureOf)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:WeightTensor
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Weight Tensor"@x-gmeow-english ;
    skos:definition "A weight tensor: the learned parameters of a math:NeuralLayer — a leaf of the math:TensorComputationGraph living in a declared math:ParameterSpace. A subclass of math:MathematicalObject naming its layer through math:weightOf and the parameter space it lives in through math:inParameterSpace. A weight tensor without a declared parameter space is ill-formed (math:UnframedWeightTensor)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ActivationFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Activation Function"@x-gmeow-english ;
    skos:definition "A nonlinear activation applied elementwise in a math:NeuralLayer — ReLU, GELU, softmax, and the like. A subclass of math:Function; the nonlinearity that makes a stack of linear maps expressive. Applied as an operator inside the tensor computation graph's expression nodes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AttentionOperation
    a owl:Class ;
    rdfs:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Attention Operation"@x-gmeow-english ;
    skos:definition "The attention operation as a mathematical operator: a bilinear form over query, key, and value tensors producing a context-weighted combination (softmax(QKᵀ/√d)V). A subclass of math:Operation, so it is applied inside a math:ApplicationExpression with indexed math:ArgumentSlot operands (the Q/K/V positions) exactly like any other operator — no parallel machinery. The core operator of transformer architectures."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ParameterSpace
    a owl:Class ;
    rdfs:subClassOf math:VectorSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Parameter Space"@x-gmeow-english ;
    skos:definition "The parameter space of a model — the high-dimensional vector space its math:WeightTensors live in, over which the math:OptimizationProblem searches. A subclass of math:VectorSpace named by a weight tensor through math:inParameterSpace and by a model or graph through math:parameterSpaceOf. Training is a trajectory through this space."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:matrixProduct
    a owl:NamedIndividual , math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "matrix product"@x-gmeow-english ;
    skos:definition "The matrix-product operator (matmul): the non-commutative multiplication of two matrices/tensors along a shared axis, applied inside a math:ApplicationExpression with two indexed math:ArgumentSlot operands. The workhorse operator of a tensor computation graph."@x-gmeow-english .

math:tensorContraction
    a owl:NamedIndividual , math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "tensor contraction"@x-gmeow-english ;
    skos:definition "The tensor-contraction operator: summation over paired indices of one or more tensors (the general einsum operation matrix product specializes), applied inside a math:ApplicationExpression over indexed math:ArgumentSlot operands."@x-gmeow-english .

math:computationNode
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "computation node"@x-gmeow-english ;
    skos:definition "Relates a math:TensorComputationGraph to one of its nodes — a math:ApplicationExpression applying a tensor operator to indexed operands. Domain math:TensorComputationGraph, range math:ApplicationExpression (stated in prose). Reusing the expression AST means the node inherits the application/slot well-formedness gates; a graph with no computation node is ill-formed (math:MalformedTensorComputationGraph)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:tensorOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "tensor operation"@x-gmeow-english ;
    skos:definition "Relates a computation node to the tensor operator it applies — math:matrixProduct, math:tensorContraction, a math:AttentionOperation, or a math:ActivationFunction. Domain math:ApplicationExpression (a tensor node), range math:Operation (stated in prose). The operator is carried through math:operator on the application; this property names the tensor-specific operators the graph draws on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:weightOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "weight of"@x-gmeow-english ;
    skos:definition "Relates a math:WeightTensor to the math:NeuralLayer it parameterizes. Domain math:WeightTensor, range math:NeuralLayer (stated in prose). Names which layer a weight tensor belongs to."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:parameterSpaceOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "parameter space of"@x-gmeow-english ;
    skos:definition "Relates a math:ParameterSpace to the math:LearnedModel or math:TensorComputationGraph whose parameters it holds. Domain math:ParameterSpace, range a math:LearnedModel or math:TensorComputationGraph (stated in prose). The whole model's parameters form one space the optimization searches."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:architectureOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "architecture of"@x-gmeow-english ;
    skos:definition "Relates a math:TensorComputationGraph to the math:LearnedModel whose architecture it is — the structural description of the model's forward computation. Domain math:TensorComputationGraph, range math:LearnedModel (stated in prose). The graph IS the architecture; this names the model it describes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:inParameterSpace
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "in parameter space"@x-gmeow-english ;
    skos:definition "Relates a math:WeightTensor to the math:ParameterSpace it lives in. Domain math:WeightTensor, range math:ParameterSpace (stated in prose). Weights live in a declared parameter space; a weight tensor without one is ill-formed (math:UnframedWeightTensor)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Conformance-failure classes (LINEAR-ALGEBRA-AND-LEARNING) --------------- #

math:UnqualifiedOrthogonalComplement
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unqualified Orthogonal Complement"@x-gmeow-english ;
    skos:definition "The failure raised when a math:OrthogonalComplement does not name the inner product that defines its orthogonality through math:definedByInnerProduct. An orthogonal complement realizes the complement contract (ambient space and semantics from math:Complement) and additionally names its inner product; missing it, 'the orthogonal complement' is ambiguous and ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompletePCAAnalysis
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete PCA Analysis"@x-gmeow-english ;
    skos:definition "The failure raised when a math:PCAAnalysis does not declare its inputs, policy, and outputs — its math:analysisInput, math:centeringPolicy, math:scalingPolicy, math:covarianceOperator, math:eigensolver, math:principalComponent, math:loadingVector, math:scoreVector, math:explainedVarianceRatio, and math:residualSubspace. A decomposition that hides its inputs or outputs is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ResidualMeaningAsProperty
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Residual Meaning as Property"@x-gmeow-english ;
    skos:definition "The failure raised when the MEANING of a residual subspace, a principal component, or a latent dimension is asserted as an intrinsic property rather than held as a math:ResidualInterpretationClaim (a gmeow:Observation with a gmeow:vantage and a result). Semantic meaning read off geometry is inference from a standpoint; a meaning claim missing its vantage — or a meaning stamped directly on the vector — is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnderspecifiedEmbedding
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Embedding"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Embedding does not name its math:embeddingSource, math:targetSpace, math:embeddingFunction, or math:embeddingModel. An embedding is a declared map from a named source into a named latent space by a named function and model; missing any, it is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MalformedTensorComputationGraph
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Malformed Tensor Computation Graph"@x-gmeow-english ;
    skos:definition "The failure raised when a math:TensorComputationGraph declares no math:computationNode, or a node is not a well-formed math:ApplicationExpression over indexed math:ArgumentSlot operands. The graph reuses the expression AST wholesale, so a node with more than one operator or a malformed slot raises the inherited application/slot failures; a graph with no nodes is malformed here."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnframedWeightTensor
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unframed Weight Tensor"@x-gmeow-english ;
    skos:definition "The failure raised when a math:WeightTensor does not name the math:ParameterSpace it lives in through math:inParameterSpace. Weights live in a declared parameter space over which optimization searches; a weight tensor without one is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ApplicationOperatorCardinality
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Application Operator Cardinality"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ApplicationExpression does not apply exactly one math:operator — zero operators leave the application undefined, two or more make it ambiguous which operator is applied. Every application (a tensor computation node or an arithmetic application) names the single operator it invokes through math:operator; the sibling binder AST (math:BindingExpression) is not an application and is exempt."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- The ingestion bridges — front-ends that lift external artifacts ---------- #
# A bridge is the mnemomorphic put leg of a logic:Correspondence: GMEOW is the
# source S, the external artifact the view V; get (down-projection) is the future
# math->external projection, put (up-projection) IS the lift. Running a leg backward
# is the calculus's named anti-pattern; a lawful put comes from a retained
# mnemomorphic witness (math:parseSource, marked logic:loadBearing). Each bridge run
# is a gmeow:Activity that carries the process-layer in-band witness through the
# reused logic:instantiatesSchema / logic:instantiatesPlan back-references, ties its
# produced math: codomain back through gmeow:wasGeneratedBy, routes computation to
# logic: through the existing math:compilesToLogicFormula / math:compilesToLogicTerm,
# and hard-fails (math:UnliftableIngest) on anything it cannot lift.

math:IngestRun
    a owl:Class ;
    rdfs:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ingest Run"@x-gmeow-english ;
    skos:definition "A bridge run: the executed occurrence of the up-projection (put) leg of a logic:Correspondence that lifts an external artifact into the grounding layers, splitting mathematical/structural content into math: and computation into logic:. A subclass of gmeow:Activity — the process half of the process / result / claim separation — abstracting the three concrete bridges (math:RIngestRun, math:ONNXIngestRun, math:ProofIngestRun). It retains its source as a math:parseSource witness (the in-band mnemomorphic complement, marked logic:loadBearing, that discharges put after get equals identity), carries the process-layer in-band witness through logic:instantiatesSchema and logic:instantiatesPlan, and ties each produced math: object back through gmeow:wasGeneratedBy. A run that retains a source but lifts no structured math: codomain and enumerates no residue is ill-formed (math:UnliftableIngest)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RIngestRun
    a owl:Class ;
    rdfs:subClassOf math:IngestRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "R Ingest Run"@x-gmeow-english ;
    skos:definition "The R bridge run: an ingest run that lifts an R script's mathematical and statistical content into math: and its computation into logic:. Data frames lift to math:DatasetMatrix (held by reference), a model formula (the ~ operator, a binder not a string) to a math:ModelFormula, lm/glm/lmer to a math:StatisticalModel / math:FittedModel, distribution calls to a math:Distribution, and the broom tidy/glance/augment triple to math:Estimate / math:FittedModel / math:Residual; control flow and general computation route to logic:. Its correspondence's assertable rung is a lossy lens on the non-injective fit, climbing to section on the formula/data/coefficient sub-fragment recorded by the mnemomorphic witness. Anchored externally by reference to the R language and the broom vocabulary; no R ontology exists — the lifter is an authored Rust front-end."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ONNXIngestRun
    a owl:Class ;
    rdfs:subClassOf math:IngestRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "ONNX Ingest Run"@x-gmeow-english ;
    skos:definition "The ONNX bridge run: an ingest run that lifts a model graph into a math:TensorComputationGraph — ONNX node protos to tensor-operator math:ApplicationExpressions, initializers to math:WeightTensors in a math:ParameterSpace, graph inputs/outputs to typed tensor slots, and metadata to provenance. The result is exactly the self-structure object of the learning charter, so an AI can describe its own architecture by lifting its own ONNX export; its correspondence's aspired rung is section/retraction (the structure fully recovers). ONNX (Apache-2.0) is the interchange anchor by reference; the meaning of the architecture is authored, not in ONNX."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProofIngestRun
    a owl:Class ;
    rdfs:subClassOf math:IngestRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Proof Ingest Run"@x-gmeow-english ;
    skos:definition "The proof-as-process bridge run: an ingest run that lifts a proof-assistant declaration dependency DAG into a math:ProofDependencyGraph and the math: proof layer (math:Proof / math:ProofStep / math:dependsOnAxiom), framing the proof effort as a goal-decomposed process — each lemma a logic:GoalExpression sub-goal (kind logic:AchievementGoal) reached through math:provesGoal, each step an action, and the QED a math:FormalVerificationResult result object grounded by a gmeow:Observation. Its correspondence's aspired rung is section/retraction (the DAG recovers from the lift and witness). Anchored externally by reference to mathlib, Metamath (CC0), and TPTP/TSTP; GMEOW's workflow is the executable shape of the proof search."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:parseSource
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "parse source"@x-gmeow-english ;
    skos:definition "Relates a math:IngestRun to the in-band source witness it retains — the mnemomorphic complement that lets the up-projection (put) leg recover the source rather than synthesize a plausible one. Domain math:IngestRun; range the retained source witness, a structured node marked logic:loadBearing true and carrying enough of the source to recover what the lift did not map (never a bare droppable string — an opaque blob is the amnesic case), stated in prose. The witness is why 'retain the source' is a law (the Mnemomorphism gate), not a decoration."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:ingestCorrespondence
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "ingest correspondence"@x-gmeow-english ;
    skos:definition "Relates a math:IngestRun to the single logic:Correspondence node it carries — THE attachment point of the lift's law-spine. Domain math:IngestRun, range logic:Correspondence (stated in prose). Everything about the lift that is a law rather than a facet lives on that Correspondence: its logic:morphismClass (the ordered law-spine rung), logic:preservationKind, logic:mnemomorphic witness flag, logic:correspondenceRelation, logic:hasDeterminacy, and any logic:LawClaim with its logic:DischargeVerdict. math: never shadows those properties; it only points at the node that holds them, exactly as the language slice's lang:translationCorrespondence attaches a translation unit to its crossing. A bridge run carries exactly one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- R-bridge codomain: statistical objects (STATISTICS-charter vocabulary) --- #

math:StatisticalModel
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Statistical Model"@x-gmeow-english ;
    skos:definition "A statistical model: a family of probability distributions (with a math:ModelFormula specification and declared assumptions) posited to have generated data. A subclass of math:MathematicalObject; when bound to concrete data by fitting it becomes a math:FittedModel. The specification names its structure through math:modelFormula; the model is the process-independent object an R lm/glm/lmer call lifts into."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FittedModel
    a owl:Class ;
    rdfs:subClassOf math:StatisticalModel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Fitted Model"@x-gmeow-english ;
    skos:definition "A fitted model: a math:StatisticalModel bound to concrete data through math:fittedToData and specified by a math:modelFormula — the trained artifact an lm/glm/lmer fit produces, from which math:Estimate coefficients and math:Residual values are read. A fitted model missing its data or its specification is ill-formed (math:UnfittedModel). The R broom glance triple lifts a model's summary statistics onto this object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ModelFormula
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Model Formula"@x-gmeow-english ;
    skos:definition "A model formula: the structured specification a math:StatisticalModel relates a response to its terms by — the R y ~ x1 + x2 form lifted as a math:BindingExpression AST (the ~ is a binder over indexed math:ArgumentSlot operands, never a string), so the response, terms, interactions, and offsets are inspectable structure. A subclass of math:MathematicalExpression; carried by math:modelFormula."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DatasetMatrix
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dataset Matrix"@x-gmeow-english ;
    skos:definition "A dataset matrix: the data a math:FittedModel is fitted to (math:fittedToData), framed by name and structure but held BY REFERENCE — a blob reference and origin, never the payload bytes inlined (the project's blob-by-reference doctrine). A subclass of math:MathematicalObject; an R data frame lifts to this object, which names and frames the data without embedding it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Distribution
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Distribution"@x-gmeow-english ;
    skos:definition "A probability distribution: a law assigning probabilities over outcomes, named by its family through math:distributionFamily (normal, binomial, Poisson, …) and parameterized. A subclass of math:MathematicalObject; an R rnorm/dbinom/… call lifts to this object with its family and parameterization, distinct from the math:ProbabilityMeasure it induces."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Estimate
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Estimate"@x-gmeow-english ;
    skos:definition "An estimate: a produced value that estimates an estimand (math:estimatesEstimand) and, where relevant, a model parameter (math:estimatedParameter), carrying its value (math:estimateValue) and the estimator that produced it (math:estimator). A subclass of math:MathematicalObject and the structured result object of the process / result / claim separation — neither the analysis activity nor the held claim. The R broom tidy triple lifts model coefficients onto these objects."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Residual
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Residual"@x-gmeow-english ;
    skos:definition "A residual: the difference between an observed value and the value a math:FittedModel predicts, related to the fit it is a residual of through math:residualOf. A subclass of math:MathematicalObject; the R broom augment triple lifts per-observation residuals onto these objects. Its statistical MEANING, if read, is a vantage-held gmeow:Observation, never an intrinsic property of the number."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:modelFormula
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "model formula"@x-gmeow-english ;
    skos:definition "Relates a math:StatisticalModel or math:FittedModel to its math:ModelFormula specification. Domain a math:StatisticalModel, range math:ModelFormula (stated in prose). The specification is a math:BindingExpression AST, never a string; a fitted model without one is ill-formed (math:UnfittedModel)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:fittedToData
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "fitted to data"@x-gmeow-english ;
    skos:definition "Relates a math:FittedModel to the math:DatasetMatrix it was fitted to. Domain math:FittedModel, range math:DatasetMatrix (stated in prose). Reserved for math:FittedModel — it is the data binding that distinguishes a fitted model from an unbound math:StatisticalModel, never attached to an estimate; a fitted model without it is ill-formed (math:UnfittedModel)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:estimatesEstimand
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "estimates estimand"@x-gmeow-english ;
    skos:definition "Relates a math:Estimate to the estimand — the target quantity — it estimates. Domain math:Estimate, range the estimand it targets (stated in prose). An estimate references its estimand and/or its estimated parameter and its estimator; missing them it is underspecified."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:estimatedParameter
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "estimated parameter"@x-gmeow-english ;
    skos:definition "Relates a math:Estimate to the model parameter it estimates, where the estimand is a parameter of a math:StatisticalModel. Domain math:Estimate, range the model parameter (stated in prose). The companion of math:estimatesEstimand for model-based estimation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:estimateValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "estimate value"@x-gmeow-english ;
    skos:definition "Relates a math:Estimate to the value it carries — a math:Quantity or number. Domain math:Estimate, range the estimated value (stated in prose). The produced value, distinct from the estimand it estimates and the estimator that produced it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:estimator
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "estimator"@x-gmeow-english ;
    skos:definition "Relates a math:Estimate to the estimator — the rule or procedure — that produced it (ordinary least squares, maximum likelihood, …). Domain math:Estimate, range the estimator (stated in prose). An estimate names its estimator so the produced value is never a bare number without its act."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:residualOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "residual of"@x-gmeow-english ;
    skos:definition "Relates a math:Residual to the math:FittedModel it is a residual of. Domain math:Residual, range math:FittedModel (stated in prose). Names which fit an observed-minus-predicted difference belongs to."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:distributionFamily
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "distribution family"@x-gmeow-english ;
    skos:definition "Relates a math:Distribution to the family it belongs to — normal, binomial, Poisson, and the rest. Domain math:Distribution, range the distribution family (stated in prose). A distribution names its family and its parameterization; missing the family it is underspecified."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Proof-bridge codomain: the proof layer (EXPRESSIONS-charter vocabulary) -- #

math:ProofDependencyGraph
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Proof Dependency Graph"@x-gmeow-english ;
    skos:definition "A proof dependency graph: the declaration dependency DAG a proof-assistant library exposes — mathlib's declaration graph, Metamath's axiom-to-theorem DAG, a TPTP/TSTP proof-step DAG — lifted as a math: object. A subclass of math:MathematicalObject naming the math:Proof it underlies; the DAG's recoverability from the lift and its witness is why a math:ProofIngestRun's aspired correspondence rung is section/retraction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Proof
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Proof"@x-gmeow-english ;
    skos:definition "A proof: a structured derivation establishing a statement (math:provesStatement) through a sequence of math:ProofStep actions, depending on axioms through math:dependsOnAxiom. A subclass of math:MathematicalObject; as a process the proof effort is goal-decomposed (each lemma a logic:GoalExpression sub-goal reached through math:provesGoal), and its successful checking is a math:FormalVerificationResult grounded by a gmeow:Observation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProofStep
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Proof Step"@x-gmeow-english ;
    skos:definition "A proof step: one inference action of a math:Proof, drawing conclusions (math:hasConclusion) from premises (math:hasPremise). A subclass of math:MathematicalObject; steps compose into the proof reached through math:proofStep, each an action in the goal-decomposed process a math:ProofIngestRun frames."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FormalVerificationResult
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    owl:disjointWith gmeow:Observation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Formal Verification Result"@x-gmeow-english ;
    skos:definition "A formal verification result: the structured RESULT OBJECT of checking a math:Proof — the QED verdict a proof assistant returns. A subclass of math:MathematicalObject, NOT a gmeow:Observation: it is the result object of the process / result / claim separation, and the held verdict is a separate gmeow:Observation naming the checker as gmeow:vantage, the result through gmeow:observationResult, and the run through gmeow:wasGeneratedBy. None is typed as another; a result object roled as the claim is ill-formed (math:ResultRoleConflation), and a result not grounded by such an observation is ill-formed (math:UngroundedVerificationResult)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:dependsOnAxiom
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "depends on axiom"@x-gmeow-english ;
    skos:definition "Relates a math:Proof or math:ProofStep to a math:Axiom it depends on. Domain a math:Proof or math:ProofStep, range math:Axiom (stated in prose). The axiom dependencies are what a proof dependency DAG records, so a theorem's foundations are first-class and queryable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:provesStatement
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "proves statement"@x-gmeow-english ;
    skos:definition "Relates a math:Proof to the statement it establishes. Domain math:Proof, range the statement proved (stated in prose). The statement is asserted under a theory context, not as unconditional truth; the proof is the derivation that establishes it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:proofStep
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "proof step"@x-gmeow-english ;
    skos:definition "Relates a math:Proof to one of its math:ProofStep actions. Domain math:Proof, range math:ProofStep (stated in prose). Steps compose into the derivation; each is an action in the goal-decomposed process a math:ProofIngestRun frames."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasPremise
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has premise"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalStatement or math:ProofStep to a premise it draws on. Domain a math:MathematicalStatement or math:ProofStep, range the premise (a statement or prior result, stated in prose). The companion of math:hasConclusion; a statement states its conclusion under premises, and an inference goes from premises to conclusions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasConclusion
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has conclusion"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalStatement or math:ProofStep to the conclusion it draws. Domain a math:MathematicalStatement or math:ProofStep, range the conclusion (an expression or statement, stated in prose). The companion of math:hasPremise; a statement asserts its conclusion under premises, and the conclusion of one step may be a premise of a later one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:provesGoal
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "proves goal"@x-gmeow-english ;
    skos:definition "Relates a math:Proof or math:ProofStep to the logic:GoalExpression sub-goal it discharges — binding the proof layer to logic:'s teleology so a complex proof is a goal-decomposed process. Domain a math:Proof or math:ProofStep, range logic:GoalExpression (stated in prose). Each lemma is a logic:GoalExpression whose logic:goalExpressionKind is logic:AchievementGoal (the target first obtains) — the kind is a value carried by the property, never a class the goal is typed with."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# The statement-role layer — theorem-hood is a role under a theory, not a bit
#
# A theorem label is not a truth bit. A math:MathematicalStatement states a
# conclusion under premises, depends on axioms under a versioned theory, and holds
# its status (theorem, lemma, conjecture, …) as a math:statementRole scoped to a
# named theory through math:roleInTheory — so "a theorem in Euclidean geometry v2"
# is a theory-relative claim, never an unconditional global fact. The flat classes
# math:Theorem, math:Lemma, and the rest are retained as convenience PROJECTIONS
# (shaped subclasses for consumers that want a flat type), never as the canonical
# bearer of truth. Verification splits three ways: a math:ProofCheckActivity is the
# occurrent run, a math:FormalVerificationResult is the structured result object, and
# a gmeow:Observation with the checker as gmeow:vantage is the held claim — none is
# typed as another.
# =========================================================================== #

math:MathematicalStatement
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Mathematical Statement"@x-gmeow-english ;
    skos:definition "The canonical bearer of statement-hood: a mathematical assertion that states a conclusion (math:hasConclusion) under premises (math:hasPremise), depends on axioms (math:dependsOnAxiom) under a named, versioned theory (math:roleInTheory), and is proved by a math:Proof (via math:provesStatement) or backed by a declared external warrant (math:externalWarrant). A subclass of math:MathematicalObject. Its epistemic status is NOT a truth bit read off its type: theorem-hood, lemma-hood, and the rest are carried as a math:statementRole scoped to a theory, never as an unconditional global fact — so a consumer can never read a bare type as 'proved, everywhere, unconditionally'. The flat classes math:Theorem, math:Lemma, math:Corollary, math:Conjecture, and math:DefinitionStatement are convenience projections of this class + its role, retained for consumers wanting a flat type, never the canonical truth bearer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:statementRole
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "statement role"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalStatement to the math:StatementRole it holds — the canonical carrier of theorem-hood, lemma-hood, conjecture-hood, and the rest AS A ROLE rather than a bare class assertion. Domain math:MathematicalStatement, range math:StatementRole (a value individual, stated in prose). The role holds math:roleInTheory a named, versioned theory, so the status is theory- and standpoint-relative: 'this statement is a theorem in Euclidean geometry v2' is a scoped claim, not a global truth bit. The flat math:Theorem/math:Lemma/… projections are generated from this role, never the other way round."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:StatementRole
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Statement Role"@x-gmeow-english ;
    skos:definition "The closed value class of the epistemic ROLE a math:MathematicalStatement holds under a theory — theorem-hood as a role, not a truth bit. Its six named individuals are math:roleTheorem (a proved conclusion, held under a theory with a proof or external warrant), math:roleLemma (an auxiliary result proved en route to a larger theorem), math:roleCorollary (a result following readily from a theorem), math:roleConjecture (a candidate held under active test, not yet proved or refuted), math:roleAxiom (a stated law taken as a foundation of the theory rather than derived within it), and math:roleDefinition (a statement introducing a term or notion, true by stipulation). A statement names exactly one through math:statementRole, and the role holds math:roleInTheory a named, versioned theory; the status is theory-relative, so the same statement may carry different roles under different theories. The set is closed; a misspelt role names no declared value and is rejected rather than silently accepted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:roleTheorem
    a owl:NamedIndividual , math:StatementRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "theorem role"@x-gmeow-english ;
    skos:definition "The theorem role: a math:MathematicalStatement held as a proved conclusion under a named, versioned theory (math:roleInTheory), warranted by a math:Proof (math:provesStatement) or a declared external warrant (math:externalWarrant). Theorem-hood is this role scoped to a theory, never a truth bit read off a bare type."@x-gmeow-english .

math:roleLemma
    a owl:NamedIndividual , math:StatementRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "lemma role"@x-gmeow-english ;
    skos:definition "The lemma role: an auxiliary proved result held under a theory en route to a larger theorem — a math:MathematicalStatement whose role is subsidiary in the theory's exposition, not a lesser kind of truth. Each lemma is a logic:GoalExpression sub-goal a proof discharges."@x-gmeow-english .

math:roleCorollary
    a owl:NamedIndividual , math:StatementRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "corollary role"@x-gmeow-english ;
    skos:definition "The corollary role: a math:MathematicalStatement following readily from a theorem already established under the same theory — the role marks the derivational proximity, held under the theory like any other proved conclusion."@x-gmeow-english .

math:roleConjecture
    a owl:NamedIndividual , math:StatementRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "conjecture role"@x-gmeow-english ;
    skos:definition "The conjecture role: a math:MathematicalStatement held as a candidate under active epistemic test within a theory — not yet proved or refuted. A math:Conjecture carrying this role links through math:conjectureUnderTest to the logic:Conjecture that formalizes it for runtime KB testing; a refutation is carried structurally by a math:hasCounterexample witness."@x-gmeow-english .

math:roleAxiom
    a owl:NamedIndividual , math:StatementRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "axiom role"@x-gmeow-english ;
    skos:definition "The axiom role: a math:MathematicalStatement taken as a foundation of its theory rather than derived within it — held as a stated law under math:roleInTheory, warranting no proof because it is the theory's starting point. Distinct from math:Axiom, which is the object-layer law an algebraic structure satisfies; this is the statement-role a foundational assertion holds within a theory."@x-gmeow-english .

math:roleDefinition
    a owl:NamedIndividual , math:StatementRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "definition role"@x-gmeow-english ;
    skos:definition "The definition role: a math:MathematicalStatement introducing a term or notion, true by stipulation within its theory rather than by proof — held under math:roleInTheory, warranting no proof because it fixes usage rather than asserting a derived fact."@x-gmeow-english .

math:roleInTheory
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "role in theory"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalStatement to the named, versioned theory its math:statementRole holds in — the theory individual (an axiom system at a stated version, e.g. Euclidean geometry v2), stated in prose. Single-valued: a statement's role is scoped to one theory context, so 'this is a theorem' is always 'a theorem IN this theory version', never an unconditional global fact. This is precisely what makes theorem-hood theory-relative rather than a truth bit; a theorem claim with no theory context is ill-formed (math:UngroundedTheoremClaim)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:externalWarrant
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "external warrant"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalStatement to a declared external warrant that stands in for an in-graph math:Proof — a cited published proof, a proof-assistant library entry, or another attested basis for the claim, stated in prose. Domain math:MathematicalStatement. A theorem claim discharges the theorem-is-not-a-truth-bit gate through EITHER a math:Proof (via math:provesStatement) OR a declared external warrant; a theorem with a theory context but neither is ill-formed (math:UngroundedTheoremClaim)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Convenience projections — flat subclasses of the role, never the truth --- #
# Retained as PROJECTIONS ONLY: shaped subclasses of math:MathematicalStatement
# generated from the role for consumers that want a flat type. They are never the
# canonical bearer of truth — the canonical carrier is math:statementRole scoped by
# math:roleInTheory. (math:Axiom and math:Proof already exist and are not redefined.)

math:Theorem
    a owl:Class ;
    rdfs:subClassOf math:MathematicalStatement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Theorem"@x-gmeow-english ;
    skos:definition "A convenience PROJECTION of a math:MathematicalStatement carrying math:statementRole math:roleTheorem — a flat type for consumers that want one, NEVER the canonical bearer of truth. The canonical carrier of theorem-hood is the role scoped by math:roleInTheory; a bare `a math:Theorem` must still carry a theory context and either a math:Proof or a declared external warrant, because the type alone is not a truth bit (a bare theorem with no theory context is math:UngroundedTheoremClaim)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Lemma
    a owl:Class ;
    rdfs:subClassOf math:MathematicalStatement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lemma"@x-gmeow-english ;
    skos:definition "A convenience PROJECTION of a math:MathematicalStatement carrying math:statementRole math:roleLemma — a flat type for consumers that want one, never the canonical bearer of truth. The canonical carrier is the role scoped by math:roleInTheory; the flat type is generated from the role, not the other way round."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Corollary
    a owl:Class ;
    rdfs:subClassOf math:MathematicalStatement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Corollary"@x-gmeow-english ;
    skos:definition "A convenience PROJECTION of a math:MathematicalStatement carrying math:statementRole math:roleCorollary — a flat type for consumers that want one, never the canonical bearer of truth. The canonical carrier is the role scoped by math:roleInTheory; the flat type is generated from the role."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Conjecture
    a owl:Class ;
    rdfs:subClassOf math:MathematicalStatement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Conjecture"@x-gmeow-english ;
    skos:definition "A convenience PROJECTION of a math:MathematicalStatement carrying math:statementRole math:roleConjecture — a candidate held under active test, not yet proved or refuted, never the canonical bearer of truth. The canonical carrier is the role scoped by math:roleInTheory. A math:Conjecture is the STATEMENT-layer object; it links through math:conjectureUnderTest to the logic:Conjecture (the runtime-testable candidate) that formalizes it for KB testing, and a refutation is carried structurally by a math:hasCounterexample witness corresponding to the logic:ContradictionWitness the refutation exposes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DefinitionStatement
    a owl:Class ;
    rdfs:subClassOf math:MathematicalStatement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Definition Statement"@x-gmeow-english ;
    skos:definition "A convenience PROJECTION of a math:MathematicalStatement carrying math:statementRole math:roleDefinition — a statement introducing a term or notion, true by stipulation within its theory, never the canonical bearer of truth. The canonical carrier is the role scoped by math:roleInTheory. Named math:DefinitionStatement (not math:Definition) so it never collides with the object-layer notion of a definition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Refutation as structure — a conjecture carries its counterexample -------- #

math:Counterexample
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Counterexample"@x-gmeow-english ;
    skos:definition "A first-class mathematical object that refutes a math:MathematicalStatement — a witness instance falsifying a conjectured universal, attached through math:hasCounterexample. A subclass of math:MathematicalObject, so a refuted conjecture carries its refutation STRUCTURALLY rather than merely flipping a status flag. The same witness node is what the logic: refutation exposes as a logic:ContradictionWitness (the two-projection witness): math: names the mathematical counterexample object, logic: owns the runtime contradiction it constitutes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:hasCounterexample
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has counterexample"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalStatement to a math:Counterexample that refutes it. Domain math:MathematicalStatement, range math:Counterexample. A refuted conjecture carries its refutation structurally through this edge; the counterexample corresponds to the logic:ContradictionWitness the logic: refutation exposes, so this property may point at the SAME witness node the two-projection witness names — math: as the counterexample object, logic: as the runtime contradiction — never a duplicated or shadowed structure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Math→logic bridge (strictly one-way; logic never depends on math) -------- #

math:conjectureUnderTest
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "conjecture under test"@x-gmeow-english ;
    skos:definition "Relates a math:Conjecture (the statement-layer mathematical object) to the logic:Conjecture (the runtime-testable candidate formula under active epistemic test) that formalizes it for knowledge-base testing. Domain math:Conjecture, range logic:Conjecture. This is a math→logic edge — permitted because math: is last in the acyclic grounding-layer dependency order; the reverse logic→math edge is FORBIDDEN, so logic: never depends on math:. The mathematical statement supplies the human-facing conjecture; the logic:Conjecture carries the standpoint-scoped verdict, the negation-symmetric test, and the logic:ContradictionWitness a refutation exposes (which the statement re-exposes structurally as a math:hasCounterexample witness)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Proof method and the three-object verification split -------------------- #

math:ProofMethod
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Proof Method"@x-gmeow-english ;
    skos:definition "The method a math:Proof uses to establish its statement — direct proof, proof by contradiction, induction, construction, and the rest. A subclass of math:MathematicalObject naming the shape of the derivation a proof follows (math:usesProofMethod). The method is a first-class object, not an opaque label, so a proof's strategy is queryable alongside its steps and axiom dependencies."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:usesProofMethod
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "uses proof method"@x-gmeow-english ;
    skos:definition "Relates a math:Proof to the math:ProofMethod it follows — direct, by contradiction, by induction, by construction. Domain math:Proof, range math:ProofMethod (stated in prose). The declared strategy of the derivation, queryable alongside its math:proofStep sequence and math:dependsOnAxiom foundations."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:ProofCheckActivity
    a owl:Class ;
    rdfs:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Proof Check Activity"@x-gmeow-english ;
    skos:definition "The occurrent RUN of checking a math:Proof — a proof-assistant execution (Coq, Lean, Isabelle, Metamath) that consumes a proof (math:usedProof). A subclass of gmeow:Activity: the PROCESS half of the process / result / claim separation. The engine it ran under is named as the gmeow:vantage of the grounding gmeow:Observation and through math:verifiedByEngine on the result object. It is NEVER typed as its own result object (a math:FormalVerificationResult) nor as the held claim (a gmeow:Observation); the run produces the result object (tied back through gmeow:wasGeneratedBy) and the observation grounds the verdict from the checker's vantage. A process typed as an observation is ill-formed (math:ProcessObservationConflation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:usedProof
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "used proof"@x-gmeow-english ;
    skos:definition "Relates a math:ProofCheckActivity to the math:Proof it checked. Domain math:ProofCheckActivity, range math:Proof (stated in prose). The proof the run consumed; the run's verdict is a separate math:FormalVerificationResult held by a gmeow:Observation naming the checker as gmeow:vantage."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:verifiedByEngine
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "verified by engine"@x-gmeow-english ;
    skos:definition "Relates a math:FormalVerificationResult (or the math:Proof it concerns) to the verification engine that produced it — a proof assistant or checker, a gmeow: software agent / standpoint, stated in prose. The engine is the gmeow:vantage of the grounding gmeow:Observation: 'verified' always answers BY WHOM, so a bare 'verified' with no engine is not a claim but a decoration. The result object carries this pointer; the held verdict remains a separate observation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:verificationResult
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "verification result"@x-gmeow-english ;
    skos:definition "Relates a math:FormalVerificationResult to its math:VerificationOutcome — the structured verdict the checker returned (passed, failed, unknown). Domain math:FormalVerificationResult, range math:VerificationOutcome (stated in prose). The outcome is carried on the RESULT OBJECT; the held claim that this outcome obtains is a separate gmeow:Observation with the checker as gmeow:vantage, so the outcome value is never asserted as a free-floating truth."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:VerificationOutcome
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Verification Outcome"@x-gmeow-english ;
    skos:definition "The closed value class of the verdict a math:FormalVerificationResult carries through math:verificationResult. Its three named individuals are math:verificationPassed (the checker accepted the proof), math:verificationFailed (the checker rejected it), and math:verificationUnknown (the check was inconclusive — budget-exhausted, timed out, or hit an unsupported construct). A result names exactly one; the set is closed, so a misspelt outcome names no declared value and is rejected. The outcome is a value on the result object, never the held claim — that is a separate gmeow:Observation with the checker as gmeow:vantage."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:verificationPassed
    a owl:NamedIndividual , math:VerificationOutcome ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "verification passed"@x-gmeow-english ;
    skos:definition "The passed outcome: the proof checker accepted the math:Proof — the QED verdict. Carried on the math:FormalVerificationResult; the claim that it obtains is held from the checker's vantage by a separate gmeow:Observation."@x-gmeow-english .

math:verificationFailed
    a owl:NamedIndividual , math:VerificationOutcome ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "verification failed"@x-gmeow-english ;
    skos:definition "The failed outcome: the proof checker rejected the math:Proof — a gap, an unmet obligation, or an inconsistency. Carried on the math:FormalVerificationResult; the claim that it obtains is held from the checker's vantage by a separate gmeow:Observation."@x-gmeow-english .

math:verificationUnknown
    a owl:NamedIndividual , math:VerificationOutcome ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "verification unknown"@x-gmeow-english ;
    skos:definition "The inconclusive outcome: the check neither accepted nor rejected — budget-exhausted, timed out, or hit an unsupported construct, mirroring logic:ObligationUnknown. Carried on the math:FormalVerificationResult; never collapsed into a bare failure, because 'not proved' is not 'refuted'."@x-gmeow-english .

# --- The theorem-is-not-a-truth-bit failure class ---------------------------- #

math:UngroundedTheoremClaim
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ungrounded Theorem Claim"@x-gmeow-english ;
    skos:definition "The failure raised when a theorem claim is stated as a truth bit rather than a theory-scoped, warranted claim: a math:Theorem (or a math:MathematicalStatement carrying math:statementRole math:roleTheorem) that lacks a theory context (math:roleInTheory), or that carries a theory context but neither a math:Proof (via math:provesStatement) nor a declared math:externalWarrant. A bare `a math:Theorem` with no theory context is ill-formed: theorem-hood is a role held under a named, versioned theory with a proof or external warrant, never a fact read off the type. Primary gate: the SHACL requirement (math:TheoremGroundingShape) that a theorem carry math:roleInTheory and a proof-or-warrant."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Process / observation disjointness (process is never the claim) --------- #
# The OWL-axiom gate backing math:ProcessObservationConflation: an inference or
# analysis process is a gmeow:Activity and is NEVER typed as a gmeow:Observation —
# the process half of the process / result / claim separation. Mirrors the
# language slice's lang:InterpretationAct owl:disjointWith gmeow:Observation; the
# native DL coherence gate reads the disjointness directly, forcing any individual
# typed both a bridge/analysis process and an observation to owl:Nothing.
math:IngestRun owl:disjointWith gmeow:Observation .
math:PCAAnalysis owl:disjointWith gmeow:Observation .
math:ProofCheckActivity owl:disjointWith gmeow:Observation .

# --- Bridge failure classes -------------------------------------------------- #

math:UnliftableIngest
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unliftable Ingest"@x-gmeow-english ;
    skos:definition "The failure raised when a math:IngestRun's lift is unsupported or silently partial — it retains a math:parseSource but produces no structured math: codomain, or drops residue that is neither carried in the correspondence's mnemomorphic witness nor enumerated as an unsupported construct. It is the process-layer projection of the correspondence calculus's Overclaim and Mnemomorphism verdict (get non-injective and no witness — the logic:ObligationViolated / unsupported outcome), reusing the shared logic: discharge vocabulary. A bridge hard-fails on the unliftable; it never emits a degraded or string-valued placeholder, because 'for any input' is a universality bar, not a best-effort aspiration."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UngroundedIngestRun
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ungrounded Ingest Run"@x-gmeow-english ;
    skos:definition "The failure raised when a math:IngestRun does not retain its source witness through math:parseSource, or does not carry the process-layer in-band witness through logic:instantiatesSchema and logic:instantiatesPlan. A bridge run without its retained source and schema/plan witness cannot support the lawful put leg — the lift would be a backward-execution guess, not a mnemomorphic recovery — so it is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UngroundedVerificationResult
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ungrounded Verification Result"@x-gmeow-english ;
    skos:definition "The failure raised when a math:FormalVerificationResult is not grounded by a gmeow:Observation carrying a gmeow:vantage — the result object stated as unconditional truth rather than a verdict held from the checker's standpoint. A verification result is the structured result object; the held claim is a separate observation with the checker as vantage and the run as gmeow:wasGeneratedBy. A result roled as its own claim, or lacking a grounding observation, is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnfittedModel
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unfitted Model"@x-gmeow-english ;
    skos:definition "The failure raised when a math:FittedModel does not reference the data it was fitted to through math:fittedToData or the specification it fits through math:modelFormula. A fitted model is a math:StatisticalModel bound to concrete data by a declared specification; missing either, it is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ResultRoleConflation
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Result Role Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when a structured result object — a math:FormalVerificationResult, an estimate, a p-value, a posterior — is roled as the held claim it stands for: typed as, or asserted to BE, the gmeow:Observation that holds the verdict, rather than remaining the result object of the process / result / claim separation. A result object is what a checking or estimation process returns; the held claim is a SEPARATE gmeow:Observation naming the checker as gmeow:vantage, the result through gmeow:observationResult, and the run through gmeow:wasGeneratedBy. Roling the result object as its own claim — collapsing the three-way separation of process, result object, and observation-borne claim into a single conflated node — is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProcessObservationConflation
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Process Observation Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when an inference or analysis process — a gmeow:Activity such as a math:IngestRun or a math:PCAAnalysis — is typed as a gmeow:Observation, collapsing the process half of the process / result / claim separation into the held claim. A process is the executed occurrence that produces result objects and grounds claims; it is NEVER the observation that holds a claim about what it produced. Primary gate: the OWL disjointness of the math process classes and gmeow:Observation (mirroring the language slice's lang:InterpretationAct owl:disjointWith gmeow:Observation) — an individual typed BOTH a bridge or analysis process and an observation is forced to owl:Nothing by the native DL coherence gate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UngroundedResultClaim
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ungrounded Result Claim"@x-gmeow-english ;
    skos:definition "The failure raised when a held statistical or probabilistic result claim — that an estimate, a p-value, a posterior, a component's meaning, or a verdict holds — is stated without a gmeow:Observation carrying a gmeow:vantage, so the claim floats free of the standpoint that holds it. The claim leg of the process / result / claim separation is a gmeow:Observation naming its gmeow:vantage (whose frame), its gmeow:observedFeature (which result), and its gmeow:observationResult (the grounded conclusion); a result claim asserted as an unconditional property rather than a vantage-held observation is ill-formed. Primary gate: the SHACL Core requirement that a held result claim carry a gmeow:vantage (math:ResidualInterpretationClaimShape)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Flagship acceptance manifest — the mathematics grounding layer's depth bar as a typed contract
#
# The mathematics grounding layer's depth is defined by five flagship acceptance
# scenarios (E8 symmetry, homomorphic encryption, proofs-as-process, the universal
# R → math: bridge, and an AI describing its own structure). The acceptance-manifest
# vocabulary itself is HOISTED to the shared gmeow: test-DSL vocabulary: a
# gmeow:FlagshipScenario (bound through gmeow:demonstratedByExample /
# gmeow:demonstratedByCompetency / gmeow:demonstratedByProducer /
# gmeow:guardedByCounterExample and gmeow:enforcesFailureClass) reifies each scenario as a
# typed, queryable object shared across grounding slices. This slice contributes only its
# own unwired-flagship failure, rooted in BOTH the shared marker and the math:
# conformance-failure lattice.
# =========================================================================== #

math:UnwiredFlagshipScenario
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unwired Flagship Scenario"@x-gmeow-english ;
    skos:definition "The failure raised when a gmeow:FlagshipScenario in the mathematics grounding layer is not fully wired: it is missing its worked example (gmeow:demonstratedByExample), its competency question (gmeow:demonstratedByCompetency), its producer (gmeow:demonstratedByProducer), its counter-example (gmeow:guardedByCounterExample), or its enforcing failure class (gmeow:enforcesFailureClass); or the class it names as enforcing is not a math:MathConformanceFailure subclass. The depth bar is a contract, not a suggestion: an acceptance scenario that does not bind all realizing/enforcing artifacts cannot claim the scenario is met, and the gate rejects it. This layer's concrete realization of the shared gmeow:UnwiredFlagshipScenario marker (enforced uniformly by the shared gmeow:FlagshipScenarioShape), and a subclass of math:MathConformanceFailure, so it is a typed, queryable object in this layer's own failure lattice."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Declarative constraint axioms (grounding slices) — the closed-world cardinality/
# class/datatype/value obligations that the hand-authored shapes.ttl NodeShapes
# state are authored here once as OWL restriction axioms and PROJECTED to
# generated/shapes/validation-shapes.ttl by derive_validation_shapes (Principle
# 17). A restriction carrying both owl:*Cardinality and owl:allValuesFrom lowers
# to the paired sh:minCount/maxCount + sh:class/sh:datatype/sh:nodeKind property
# shape. owl:allValuesFrom owl:Thing projects to sh:nodeKind sh:BlankNodeOrIRI
# (the "a present value is a resource, not a literal" obligation). Genuinely
# cross-node / value-negation / numeric-range conditions have no OWL antecedent
# and stay as the procedural sh:sparql constraint fragment.
# =========================================================================== #

math:Number rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:inNumberSystem ; owl:maxQualifiedCardinality 1 ; owl:onClass math:NumberSystem ] .

math:ApproximateValue rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:approximates ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Number ] ,
    [ a owl:Restriction ; owl:onProperty math:approximationError ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

# math:isExact must be true, and math:totalMass must be 1 (math:ProbabilityMeasure), are
# VALUE-EQUALITY constraints authored with owl:hasValue: the frontend term model now carries
# the literal datatype, so a typed owl:hasValue true / owl:hasValue 1 derives a typed
# sh:hasValue that equals the typed value on every well-formed individual and rejects the
# counter-example. The absence obligation math:quantityValue maxQualifiedCardinality 0
# (onClass owl:Thing, which also catches the constant-as-decimal counter-example) is
# authored alongside.
math:MathematicalConstant rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:isExact ; owl:hasValue true ] ,
    [ a owl:Restriction ; owl:onProperty math:quantityValue ; owl:maxQualifiedCardinality 0 ; owl:onClass owl:Thing ] .

math:SetBuilderExpression rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:memberCondition ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:Complement rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:ambientSpace ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:complementSemantics ; owl:maxQualifiedCardinality 1 ; owl:onClass math:ComplementSemantics ] .

math:Function rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:domain ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Set ] ,
    [ a owl:Restriction ; owl:onProperty math:codomain ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Set ] .

math:AlgebraicStructure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:underlyingSet ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Set ] ,
    [ a owl:Restriction ; owl:onProperty math:structureOperation ; owl:minQualifiedCardinality 1 ; owl:onClass math:Operation ] ,
    [ a owl:Restriction ; owl:onProperty math:satisfiesAxiom ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:Homomorphism rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:preservedOperation ; owl:minQualifiedCardinality 1 ; owl:onClass math:Operation ] ,
    [ a owl:Restriction ; owl:onProperty math:preservationLaw ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:LieGroup rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:hasRootSystem ; owl:minQualifiedCardinality 1 ; owl:onClass math:RootSystem ] .

math:RootSystem rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:cartanMatrix ; owl:minQualifiedCardinality 1 ; owl:onClass math:CartanMatrix ] ,
    [ a owl:Restriction ; owl:onProperty math:weylGroup ; owl:minQualifiedCardinality 1 ; owl:onClass math:WeylGroup ] ,
    [ a owl:Restriction ; owl:onProperty math:rootSystemRank ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:AutomorphismGroup rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:automorphismGroupOf ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:HomomorphicEncryptionScheme rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:homomorphicOver ; owl:minQualifiedCardinality 1 ; owl:onClass math:Operation ] ,
    [ a owl:Restriction ; owl:onProperty math:securityAssumption ; owl:minQualifiedCardinality 1 ; owl:onClass math:LatticeHardnessAssumption ] ,
    [ a owl:Restriction ; owl:onProperty math:noiseModel ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:Ring rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:satisfiesDistributivity ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:Measure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:measureOn ; owl:maxQualifiedCardinality 1 ; owl:onClass math:MeasurableSpace ] ,
    [ a owl:Restriction ; owl:onProperty math:totalMass ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

# A probability measure is exactly a measure of total mass one — a typed value-equality
# obligation on the inherited math:totalMass, derived to sh:hasValue 1.
math:ProbabilityMeasure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:totalMass ; owl:hasValue 1 ] .

math:Integral rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:integrand ; owl:maxQualifiedCardinality 1 ; owl:onClass math:MeasurableFunction ] ,
    [ a owl:Restriction ; owl:onProperty math:integrationDomain ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:withRespectTo ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Measure ] .

math:Quantity rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:hasDimension ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Dimension ] .

math:DerivedDimension rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:baseDimensionExponent ; owl:minQualifiedCardinality 1 ; owl:onClass math:DimensionExponent ] .

math:DimensionExponent rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:exponentOfDimension ; owl:maxQualifiedCardinality 1 ; owl:onClass math:BaseDimension ] ,
    [ a owl:Restriction ; owl:onProperty math:exponentNumerator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty math:exponentDenominator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] .

math:DimensionalExpression rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:homogeneousOperand ; owl:minQualifiedCardinality 2 ; owl:onClass owl:Thing ] .

math:ArgumentSlot rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:slotIndex ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty math:slotExpression ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:ApplicationExpression rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:operator ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:BindingExpression rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:boundVariable ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:argumentSlot ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:VariableOccurrence rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:declaredVariable ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:Derivative rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:derivativeOf ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:withRespectToVariable ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:derivativeOrder ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] .

math:Limit rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:limitOf ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:limitPoint ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:Convergence rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:convergesTo ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:convergenceMode ; owl:maxQualifiedCardinality 1 ; owl:onClass math:ConvergenceMode ] .

math:Series rdfs:subClassOf
