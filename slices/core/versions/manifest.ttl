@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/versions>
    a gmeow:Slice ;
    rdfs:label "versions"@x-gmeow-english ;
    skos:definition "The versions slice of the GMEOW ontology (core tier): GMEOW Versions Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    dcterms:title "GMEOW Versions Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:sliceConsumer "Version lineage for software, languages, creative works, and the ontology's own releases."@x-gmeow-english .
