msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|http://www.w3.org/2000/01/rdf-schema#label"
msgid "commitment origin"
msgstr "origine de l’engagement"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source's verbatim wording for the origin of a self-commitment. It is a source claim, distinct from structured adoption provenance and contractual authority."
msgstr "Formulation source textuelle de l’origine d’un engagement envers soi. Cette déclaration est distincte de la provenance structurée d’adoption et de l’autorité contractuelle."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "Éviter d’inventer des liens source absents ou de déduire exécution et réussite de ce seul enregistrement."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|https://blackcatinformatics.ca/gmeow/howToUse"
