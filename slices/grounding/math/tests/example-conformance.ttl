ex:ecCredibleIntervalIncomplete a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/credible-interval-incomplete.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example is a math:CredibleInterval naming its math:hasPosterior context but omitting math:credibleMass (sh:minCount 1 on math:IncompleteCredibleIntervalShape); its posterior arm stays satisfied, its posterior is a well-formed family-named math:PosteriorDistribution so no distribution gate fires, and it is no math:ConfidenceInterval, so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:IncompleteCredibleInterval)." .

# === Inference and results: a confidence interval is never a credible interval (Rule I3) === #

ex:ecIntervalKindsDistinct a gmeow:ExampleConformance ;
