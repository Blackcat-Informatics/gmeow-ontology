<https://blackcatinformatics.ca/gmeow/slices/recall-context>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:sliceTier gmeow:tierCore ;
    rdfs:label "recall context"@x-gmeow-english ;
    skos:definition "Context-plan recall parameters, immutable attention-slot claims, record-specific exclusions, recall activities and asker verdicts."@x-gmeow-english ;
    dcterms:title "GMEOW Recall Context Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Agent memory services retaining contextual recall plans, pointer histories, selected records and attributed feedback without weakening execution contracts."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceDependsOn <https://blackcatinformatics.ca/gmeow/slices/logic>,
        <https://blackcatinformatics.ca/gmeow/slices/math>,
        <https://blackcatinformatics.ca/gmeow/slices/kernel>,
        <https://blackcatinformatics.ca/gmeow/slices/standpoint>,
        <https://blackcatinformatics.ca/gmeow/slices/inquiry>,
        <https://blackcatinformatics.ca/gmeow/slices/observations>,
        <https://blackcatinformatics.ca/gmeow/slices/ai>,
        <https://blackcatinformatics.ca/gmeow/slices/events>,
        <https://blackcatinformatics.ca/gmeow/slices/coreference>,
        <https://blackcatinformatics.ca/gmeow/slices/provenance> .
