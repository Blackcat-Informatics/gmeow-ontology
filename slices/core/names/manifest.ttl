<https://blackcatinformatics.ca/gmeow/slices/names>
    a gmeow:Slice ;
    rdfs:label "names"@x-gmeow-english ;
    skos:definition "The names slice of the GMEOW ontology (core tier): GMEOW Names Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/names> ;
    dcterms:title "GMEOW Names Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/agreements> ,
        <https://blackcatinformatics.ca/gmeow/slices/contacts> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/entities> ,
        <https://blackcatinformatics.ca/gmeow/slices/events> ,
        <https://blackcatinformatics.ca/gmeow/slices/language> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/places> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:sliceConsumer "Every named entity (P9 anti-colonial naming); the mail corpus; display-safety projections."@x-gmeow-english .
