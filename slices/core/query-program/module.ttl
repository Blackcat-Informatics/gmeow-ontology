gmeow:QueryFusionActivationAccount
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Fusion Activation Account"@x-gmeow-english ;
    skos:definition "A complete reported activation and call-start snapshot account for one actual weighted-fusion application, retaining actual selection, the nonempty selected-vault roster and every original candidate’s found-vault scope."@x-gmeow-english ;
    gmeow:useWhen "Use to associate actual reported activation evidence with the existing weighted application and answer without inventing another source call."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid importing an incomplete roster as empty, reconstructing it from read versions or treating wire snapshot absence as proof that a live vault had no first snapshot."@x-gmeow-english ;
    gmeow:howToUse "Link from the existing application through fusionActivationAccount; supply activationEnabled, the complete nonempty activationVaultRecord collection and one activationCandidateRecord per original applied score."@x-gmeow-english ;
    skos:scopeNote "The same captured snapshot list feeds native scoring and the returned union. Explicit first-snapshot absence requires actual live-at-capture and absence-reason evidence; missing proof fails this selected import. A successful empty candidate union still has a nonempty roster."@x-gmeow-english ;
    skos:example "Fictional scoped fragment: ex:call gmeow:fusionActivationAccount ex:account . The existing application, its original answer and the complete account bindings are omitted."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:QueryCandidateActivationRecord
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Candidate Activation Record"@x-gmeow-english ;
    skos:definition "A descriptive record for one original applied score’s nonempty actual found-vault scope and its aggregate activation Quantity exactly when the actual application selected activation."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the candidate-specific aggregation scope independently of the whole selected-call snapshot roster."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid duplicating the original candidate identity, inventing per-vault activation components or treating a disabled wire zero as measured data."@x-gmeow-english ;
    gmeow:howToUse "Supply activationAppliedScore and the complete nonempty activationFoundVault collection; supply reportedActivationValue exactly when the owner account’s activationEnabled is true."@x-gmeow-english ;
    skos:scopeNote "Each record has exactly one account owner, and its score belongs to that account’s existing application. The original candidate follows appliedScoreCandidate. Record identity is descriptive graph identity, not a native serialized identifier."@x-gmeow-english ;
    skos:example "Fictional scoped fragment: ex:row a gmeow:QueryCandidateActivationRecord ; gmeow:activationAppliedScore ex:score ; gmeow:activationFoundVault ex:vaultRecord . The owner and any enabled reported value are omitted."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:QueryVaultSnapshotRecord
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Vault Snapshot Record"@x-gmeow-english ;
    skos:definition "One actual selected-call vault’s reported call-start snapshot state, retaining its supplied vault identity and either a present snapshot identity with held count or evidenced live-at-capture first-snapshot absence."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve every selected vault, including vaults outside a particular candidate’s found-vault subset."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting raw wire None, a retired service, a budget-skipped read or a later current read as sufficient first-snapshot-absence evidence."@x-gmeow-english ;
    gmeow:howToUse "Supply activationVaultIdentity and activationSnapshotPresent; true requires activationSnapshotIdentity and activationSnapshotHeld, while qualified false forbids both."@x-gmeow-english ;
    skos:scopeNote "Each typed record has one account owner and is unique there by decoded vault bytes. False requires actual capture liveness and absence-reason evidence; unavailable evidence fails import. Present held count zero remains present."@x-gmeow-english ;
    skos:example "Fictional scoped fragment: ex:vaultRecord a gmeow:QueryVaultSnapshotRecord ; gmeow:activationSnapshotPresent false . The required vault identity, owner and actual live-at-capture absence evidence are omitted."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:QueryReportedActivation
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Reported Activation"@x-gmeow-english ;
    skos:definition "An enabled source-reported aggregate activation ranking-signal Quantity with an unsigned-long magnitude, explicit dimension and complete applicable reference frame."@x-gmeow-english ;
    gmeow:useWhen "Use for the actual aggregate returned for a candidate when activation was selected, including a genuinely reported zero."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating disabled wire zero as an observation, using a confidence or probability interpretation, or certifying native saturation from the reported aggregate."@x-gmeow-english ;
    gmeow:howToUse "Supply math:quantityValue typed xsd:unsignedLong, math:hasDimension and hasReferenceFrame, and link through reportedActivationValue from an owned candidate record."@x-gmeow-english ;
    skos:scopeNote "Values within one account share the exact dimension and frame resources. The API supplies neither mathematical context object; source or adapter justification is required. Compatible sharing is legal, and neither the fusion-score nor held-count frame is imposed."@x-gmeow-english ;
    skos:example "Fictional scoped fragment: ex:activation a gmeow:QueryReportedActivation ; math:quantityValue \"0\"^^xsd:unsignedLong . Its actual enabled source context, dimension, complete frame and incoming record are omitted."@x-gmeow-english ;
    logic:subClassOf math:Quantity .

gmeow:QuerySnapshotHeldCount
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Snapshot Held Count"@x-gmeow-english ;
    skos:definition "An actual present activation snapshot’s held-activation count Quantity with an unsigned-long magnitude, explicit dimension and complete applicable reference frame."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the actual held count paired with a supplied present snapshot identity."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating held count as a candidate activation component, graph watermark, timestamp, candidate cardinality or confidence guarantee."@x-gmeow-english ;
    gmeow:howToUse "Supply math:quantityValue typed xsd:unsignedLong, math:hasDimension and hasReferenceFrame; reference the Quantity through activationSnapshotHeld from a present owned snapshot record."@x-gmeow-english ;
    skos:scopeNote "Zero is legal when actually supplied for a present snapshot. Compatible records may share a coordinated count Quantity. Its interpretation is justified independently of aggregate activation and fusion scores; no cross-vault held-count comparison or common frame is imposed."@x-gmeow-english ;
    skos:example "Fictional scoped fragment: ex:held a gmeow:QuerySnapshotHeldCount ; math:quantityValue \"0\"^^xsd:unsignedLong . The present snapshot record, dimension and complete applicable frame are omitted."@x-gmeow-english ;
    logic:subClassOf math:Quantity .

gmeow:fusionActivationAccount
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "fusion activation account"@x-gmeow-english ;
    skos:definition "The at-most-one complete reported activation and snapshot account selected on an existing actual weighted-fusion application."@x-gmeow-english ;
    gmeow:useWhen "Use to enrich the same application and answer that already retain weighted scores and original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid creating a second execution or native answer merely to describe activation or later applied order."@x-gmeow-english ;
    gmeow:howToUse "Reference a complete QueryFusionActivationAccount on the actual QueryWeightedFusionApplication."@x-gmeow-english ;
    skos:scopeNote "Existing applications need not select this account. Once selected, every account obligation is mandatory; partial evidence cannot populate a weaker success branch."@x-gmeow-english ;
    skos:example "Fictional scoped fragment: ex:call gmeow:fusionActivationAccount ex:account . Other required account bindings and source admission evidence are omitted."@x-gmeow-english ;
    logic:domain gmeow:QueryWeightedFusionApplication ; logic:range gmeow:QueryFusionActivationAccount .

gmeow:activationEnabled
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "activation selected"@x-gmeow-english ;
    skos:definition "The required typed Boolean retaining whether the actual source call selected activation as a comparison key."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish actual selected aggregate observations from the source’s inactive constant-zero branch."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring selection from an aggregate value, a digest alone or missing source input."@x-gmeow-english ;
    gmeow:howToUse "Supply the actual call-input xsd:boolean; true requires each candidate record’s reported aggregate and false forbids that Quantity edge."@x-gmeow-english ;
    skos:scopeNote "Legal Boolean lexical variants compare by value. The future applied-policy account must agree with this actual selection; disabling activation does not remove the source snapshot roster."@x-gmeow-english ;
    skos:example "Fictional scoped fragment: ex:account gmeow:activationEnabled false . Other required account bindings and source admission evidence are omitted."@x-gmeow-english ;
    logic:domain gmeow:QueryFusionActivationAccount ; logic:range xsd:boolean .

gmeow:activationCandidateRecord
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
