#
# Declarative structural assertions for the music slice. Each assertion runs as a
# SPARQL ASK over music/module.ttl under the native Rust slicetest harness.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/music/tests/> .

ex:saMusicValueVocabsUseLogicQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:TuningSystemKind      a owl:Class ; rdfs:subClassOf logic:QualityValue .
    gmeow:PitchCollectionKind   a owl:Class ; rdfs:subClassOf logic:QualityValue .
    gmeow:CollectionMemberRole  a owl:Class ; rdfs:subClassOf logic:QualityValue .
    gmeow:InstrumentModification a owl:Class ; rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "Music value-vocabulary classes MUST be subclasses of logic:QualityValue. Replaces stale gufo:QualityValue assertions for tuning, pitch collection, collection-member role, and instrument modification." .

ex:saPitchSpellingSystemIsInformationObjectKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PitchSpellingSystem a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:PitchSpellingSystem MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject." .

ex:saMusicRelatorClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:InstrumentConfiguration a owl:Class ;
        rdfs:subClassOf logic:Relator .
    gmeow:PitchCollectionMembership a owl:Class ;
        rdfs:subClassOf logic:Relator .
    gmeow:PitchSpelling a owl:Class ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "The music configuration and pitch-relation classes MUST be logic:Relator subclasses. Replaces stale gufo:Relator assertions." .

ex:saPerformanceParticipationIsParticipationSubKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PerformanceParticipation a owl:Class , logic:SubKind ;
        rdfs:subClassOf gmeow:Participation .
}""" ;
    gmeow:saRationale "gmeow:PerformanceParticipation MUST be a logic:SubKind of gmeow:Participation. Replaces the stale gufo:SubKind assertion." .

ex:saTimbreDescriptorValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:TimbreDescriptor a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:TimbreDescriptor MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue. Replaces stale gufo:AbstractIndividualType/QualityValue assertions." .

ex:saTimbreDescriptorSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:timbreDescriptorBright  a gmeow:TimbreDescriptor .
    gmeow:timbreDescriptorDark    a gmeow:TimbreDescriptor .
    gmeow:timbreDescriptorBreathy a gmeow:TimbreDescriptor .
    gmeow:timbreDescriptorGritty  a gmeow:TimbreDescriptor .
    gmeow:timbreDescriptorHollow  a gmeow:TimbreDescriptor .
}""" ;
    gmeow:saRationale "The five seed timbre descriptors (bright, dark, breathy, gritty, hollow) MUST exist as gmeow:TimbreDescriptor individuals — the open value vocabulary needs its canonical starting set." .

ex:saTimbreObservationResultProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:timbreObservationResult a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:timbreObservationResult MUST be an owl:ObjectProperty — an Observation assigns a timbre descriptor to the observed ToneEvent; the single-value functionality now lives on the logic: PropertyCharacteristicAssertion carrier and is DL-enforced." .

# ── W1 frame-relativity fidelity guards (CONSTITUTION P11) ─────────────────────
# The śruti-22 Raga Yaman port is frame-relative to gmeow:tuningSystemShruti22.
# These positive guards pin that port so it cannot silently regress when the
# Expression frame-requirement shape migrates severity (Warning→Violation): the
# canonical content must ALREADY carry its frames, independent of the shape's grade.

ex:saYamanExpressionsCarryShruti22Frame a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:fixtureRagaYamanImprovised1975 a gmeow:Expression ;
        gmeow:hasReferenceFrame gmeow:tuningSystemShruti22 .
    gmeow:fixtureRagaYamanOralExpression a gmeow:Expression ;
        gmeow:hasReferenceFrame gmeow:tuningSystemShruti22 .
    gmeow:fixtureRagaYamanPerformed1960 a gmeow:Expression ;
        gmeow:hasReferenceFrame gmeow:tuningSystemShruti22 .
    gmeow:fixtureRagaYamanPerformed1980 a gmeow:Expression ;
        gmeow:hasReferenceFrame gmeow:tuningSystemShruti22 .
}""" ;
    gmeow:saRationale "The four Raga Yaman Expressions (oral, performed 1960, improvised 1975, performed 1980) MUST each carry gmeow:hasReferenceFrame gmeow:tuningSystemShruti22 — the śruti-22 port is frame-relative (P11) and its Expressions must satisfy the frame requirement by their own content, not by the shape's severity." .

ex:saTuningSystemShruti22Exists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:tuningSystemShruti22 a gmeow:TuningSystem ;
        gmeow:degreeCount "22"^^xsd:nonNegativeInteger .
}""" ;
    gmeow:saRationale "gmeow:tuningSystemShruti22 MUST exist as a gmeow:TuningSystem with gmeow:degreeCount 22 — the frame the Yaman Expressions and pitch values are relative to; the target of the frame reference must itself be the well-formed 22-degree śruti system." .

ex:saYamanMembersAreShruti22Pitches a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?membership gmeow:membershipCollection gmeow:pitchCollectionYamanRaga ;
        gmeow:membershipPitch ?pitch .
    FILTER NOT EXISTS {
        ?pitch a gmeow:PitchValue ;
            gmeow:hasTuningFrame gmeow:tuningSystemShruti22 .
    }
}""" ;
    gmeow:saRationale "NO membership of gmeow:pitchCollectionYamanRaga may resolve (via gmeow:membershipPitch) to anything other than a gmeow:PitchValue whose gmeow:hasTuningFrame is gmeow:tuningSystemShruti22 — a dynamic universal (FILTER NOT EXISTS over the type+frame pattern, not a hand-listed pitch set), so a Yaman member added with a missing or wrong tuning frame trips it." .

# Projection accounting ranges over the actual value inventories, so adding a
# parameter or notation system cannot silently escape coverage.

ex:saNotationProjectionInventoriesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?profile a gmeow:NotationProjectionProfile .
    ?parameter a gmeow:MusicalParameter .
    ?loss a gmeow:ProjectionLoss .
    ?system a gmeow:NotationSystem .
}""" ;
    gmeow:saRationale "Music projection accounting requires nonempty profile, parameter, loss and notation-system inventories; universal checks must not pass on an absent inventory." .

ex:saNotationProfilesAccountForEveryParameter a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?profile a gmeow:NotationProjectionProfile .
    ?parameter a gmeow:MusicalParameter .
    FILTER NOT EXISTS { ?profile gmeow:representableParameter ?parameter }
    FILTER NOT EXISTS {
        ?profile gmeow:declaredLoss ?loss .
        ?loss gmeow:accountsForParameter ?parameter .
    }
}""" ;
    gmeow:saFailWitness "tests/counter-examples/notation-profile-silent-omission.ttl" ;
    gmeow:saRationale "Every music parameter must be representable or accounted for by a loss declared on that exact profile. A loss declared on another profile cannot excuse a silent omission." .

ex:saProjectionLossesAccountForParameters a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?loss a gmeow:ProjectionLoss .
    FILTER NOT EXISTS {
        ?loss gmeow:accountsForParameter ?parameter .
        ?parameter a gmeow:MusicalParameter .
    }
}""" ;
    gmeow:saFailWitness "tests/counter-examples/projection-loss-without-parameter.ttl" ;
    gmeow:saRationale "Every declared ProjectionLoss must account for at least one typed MusicalParameter; an orphan loss cannot stand in for an information-loss account." .

ex:saNotationSystemsHaveProjectionProfiles a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?system a gmeow:NotationSystem .
    FILTER NOT EXISTS {
        ?profile a gmeow:NotationProjectionProfile ;
            gmeow:notationSystemOf ?system .
    }
}""" ;
    gmeow:saFailWitness "tests/counter-examples/notation-system-without-profile.ttl" ;
    gmeow:saRationale "Every notation system must have a typed projection profile; a bare notationSystemOf edge from an unrelated subject is not a profile." .

ex:saNotationSystemsHaveOnlyOneProjectionProfile a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?system a gmeow:NotationSystem .
    ?first a gmeow:NotationProjectionProfile ; gmeow:notationSystemOf ?system .
    ?second a gmeow:NotationProjectionProfile ; gmeow:notationSystemOf ?system .
    FILTER (?first != ?second)
}""" ;
    gmeow:saFailWitness "tests/counter-examples/notation-system-with-duplicate-profiles.ttl" ;
    gmeow:saRationale "A notation system has exactly one projection profile, so competing profile identities cannot silently supply different loss manifests for the same system." .

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix wordtest: <https://example.org/natural-language-values/tests/> .

wordtest:samusicWords a gmeow:StructuralAssertion ;
    gmeow:saScope gmeow:scopeModule ; gmeow:saPolarity gmeow:must ;
    gmeow:saPattern "PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/> PREFIX logic: <https://blackcatinformatics.ca/logic/> PREFIX lang: <https://blackcatinformatics.ca/lang/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX owl: <http://www.w3.org/2002/07/owl#> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> ASK { gmeow:decisionSequence (logic:range|rdfs:range) rdfs:Literal . gmeow:PerformanceDecision (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:decisionSequence ; (logic:allValuesFrom|owl:allValuesFrom) ?values0_0 ] . ?values0_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . }" ;
    gmeow:saRationale "Natural-language fields admit unspecified, language-tagged and directional text through canonical value restrictions, without closing subject domains." .
