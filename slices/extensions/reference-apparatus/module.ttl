    logic:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "notation as recorded"@x-gmeow-english ;
    skos:definition "The source's exact notation name or code. The spelling alone neither identifies a MathematicalNotation convention nor proves a rendering preserves meaning."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this explicit part of the source structure or apparatus with its original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."@x-gmeow-english ;
