    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "ev" ] .

# Closed-world roster of the delta's mandatory legs (F2-style closure).
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaBaseArtifact" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaTokenizer" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaCodebook" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaDatasetProjection" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaSelectionQuery" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaPromptIdentity" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaRubricIdentity" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaEngine" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaOptimizer" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaSeed" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelConfigDelta ; logic:closureKey "https://blackcatinformatics.ca/gmeow/deltaEvaluationEvidence" ; logic:closureValue logic:ClosedWorldClosure ] .

# =========================================================================== #
# Geometric seam — candidates bind by reference to the Cl(12)/E8/4096-d         #
# substrate (user-directed session scope). All math: terms are grounding.       #
# =========================================================================== #

gmeow:candidateGeometry
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "candidate geometry"@x-gmeow-english ;
    rdfs:range math:Multivector ;
    skos:definition "Binds a candidate to its representation as a math:Multivector (grounding) in a declared math:CliffordAlgebra — the geometric seam to the consumer's Cl(12)-bundle-over-E8 substrate, referenced by content digest. The preference math:CellularSheaf's math:SheafStalks are those Clifford fibers, and the base math:CellComplex is organized by an E8 math:RootSystem / math:Lattice / math:WeylGroup. When present, gmeow:GeometricBindingConstraint enforces the Cl(12)/4096-d consistency (signaturePositive + signatureNegative = 12 AND spaceDimension = 4096). It REUSES the shipped Clifford/E8 grounding; no geometry is re-minted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:geometryAlgebra
    a owl:ObjectProperty ;
    rdfs:domain math:Multivector ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "geometry algebra"@x-gmeow-english ;
    rdfs:range math:CliffordAlgebra ;
    skos:definition "Relates a candidate's math:Multivector to the math:CliffordAlgebra it lives in — the declared Clifford algebra whose math:metricSignature (p, q) and math:spaceDimension the gmeow:GeometricBindingConstraint reads. A minted binding over the shipped grounding terms; it names WHICH algebra a candidate's geometry inhabits, not a new algebra."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:GeometricBindingConstraint
    a logic:Constraint ;
    rdfs:label "Geometric binding constraint (Cl(12) over 4096-d)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (mirroring math:MetricSignatureDimensionConstraint): when a candidate declares gmeow:candidateGeometry, the declared math:CliffordAlgebra's math:metricSignature must satisfy math:signaturePositive + math:signatureNegative = 12 AND the algebra's math:spaceDimension must equal 4096 (= 2^12, the exact Cl(12) carrier dimension). A signature or carrier dimension that miscounts the substrate is a silent-error class the seam forbids (gmeow:GeometryDimensionMismatch). A ∀→(¬∃ signature-mismatch ∧ ¬∃ dimension-mismatch) formula over the grounding math: terms, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:candidateGeometry ;
    gmeow:enforcesFailureClass gmeow:GeometryDimensionMismatch ;
    logic:severity "Violation" ;
    logic:message "A candidate's gmeow:candidateGeometry math:CliffordAlgebra must carry math:signaturePositive + math:signatureNegative = 12 and math:spaceDimension = 4096 (Cl(12) over 4096-d); a mismatch is gmeow:GeometryDimensionMismatch." ;
    logic:integrity gmeow:gbcForall .
gmeow:gbcForall a logic:Formula ;
    rdfs:label "gbcForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): binds ?this, ?mv and requires gmeow:candidateGeometry(?this, ?mv) → gmeow:gbcNoSigBad ∧ gmeow:gbcNoDimBad."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "mv" ] ;
    logic:forall gmeow:gbcImpl .
gmeow:gbcImpl a logic:Formula ;
    rdfs:label "gbcImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): when gmeow:candidateGeometry(?this, ?mv) holds, requires ¬[gmeow:gbcSigEx] ∧ ¬[gmeow:gbcDimEx]."@x-gmeow-english ; logic:antecedent gmeow:gbcGuard ; logic:consequent gmeow:gbcOk .
gmeow:gbcGuard a logic:Formula ;
    rdfs:label "gbcGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:candidateGeometry atom ('candidate geometry') of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): relates ?this, ?mv."@x-gmeow-english ; logic:relation gmeow:candidateGeometry ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "mv" ] .
gmeow:gbcOk a logic:Formula ;
    rdfs:label "gbcOk (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): conjoins ¬[gmeow:gbcSigEx] ∧ ¬[gmeow:gbcDimEx]."@x-gmeow-english ; logic:and gmeow:gbcNoSigBad , gmeow:gbcNoDimBad .
# ¬∃ signature mismatch: p + q ≠ 12
gmeow:gbcNoSigBad a logic:Formula ;
    rdfs:label "gbcNoSigBad (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The negation within gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): holds only when it is NOT the case that ∃?alg,?sig,?p,?q,?s. gmeow:geometryAlgebra(?mv, ?alg) ∧ math:metricSignature(?alg, ?sig) ∧ math:signaturePositive(?sig, ?p) ∧ math:signatureNegative(?sig, ?q) ∧ ?s = ?p + ?q ∧ ?s ≠ '12'."@x-gmeow-english ; logic:not gmeow:gbcSigEx .
gmeow:gbcSigEx a logic:Formula ;
    rdfs:label "gbcSigEx (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): quantifies ?alg, ?sig, ?p, ?q, ?s and requires gmeow:geometryAlgebra(?mv, ?alg) ∧ math:metricSignature(?alg, ?sig) ∧ math:signaturePositive(?sig, ?p) ∧ math:signatureNegative(?sig, ?q) ∧ ?s = ?p + ?q ∧ ?s ≠ '12'."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "alg" ] , [ logic:termIndex 1 ; logic:termVariable "sig" ] , [ logic:termIndex 2 ; logic:termVariable "p" ] , [ logic:termIndex 3 ; logic:termVariable "q" ] , [ logic:termIndex 4 ; logic:termVariable "s" ] ;
    logic:exists gmeow:gbcSigBody .
gmeow:gbcSigBody a logic:Formula ;
    rdfs:label "gbcSigBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): conjoins gmeow:geometryAlgebra(?mv, ?alg) ∧ math:metricSignature(?alg, ?sig) ∧ math:signaturePositive(?sig, ?p) ∧ math:signatureNegative(?sig, ?q) ∧ ?s = ?p + ?q ∧ ?s ≠ '12'."@x-gmeow-english ; logic:and gmeow:gbcSigAlg , gmeow:gbcSigSig , gmeow:gbcSigP , gmeow:gbcSigQ , gmeow:gbcSigSum , gmeow:gbcSigNot12 .
gmeow:gbcSigAlg a logic:Formula ;
    rdfs:label "gbcSigAlg (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:geometryAlgebra atom ('geometry algebra') of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): relates ?mv, ?alg."@x-gmeow-english ; logic:relation gmeow:geometryAlgebra ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mv" ] , [ logic:termIndex 1 ; logic:termVariable "alg" ] .
gmeow:gbcSigSig a logic:Formula ;
    rdfs:label "gbcSigSig (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The math:metricSignature atom of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): relates ?alg, ?sig."@x-gmeow-english ; logic:relation math:metricSignature ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "alg" ] , [ logic:termIndex 1 ; logic:termVariable "sig" ] .
gmeow:gbcSigP a logic:Formula ;
    rdfs:label "gbcSigP (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The math:signaturePositive atom of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): relates ?sig, ?p."@x-gmeow-english ; logic:relation math:signaturePositive ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sig" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .
gmeow:gbcSigQ a logic:Formula ;
    rdfs:label "gbcSigQ (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The math:signatureNegative atom of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): relates ?sig, ?q."@x-gmeow-english ; logic:relation math:signatureNegative ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sig" ] , [ logic:termIndex 1 ; logic:termVariable "q" ] .
gmeow:gbcSigSum a logic:Formula ;
    rdfs:label "gbcSigSum (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The arithmetic sum atom of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): binds ?s to the sum ?p + ?q."@x-gmeow-english ; logic:relation logic:termSum ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] , [ logic:termIndex 2 ; logic:termVariable "q" ] .
gmeow:gbcSigNot12 a logic:Formula ;
    rdfs:label "gbcSigNot12 (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The inequality atom of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): asserts ?s and '12' are distinct, the witness that closes the violation pattern."@x-gmeow-english ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s" ] , [ logic:termIndex 1 ; logic:termLiteral "12" ; logic:termLiteralDatatype xsd:integer ] .
# ¬∃ carrier-dimension mismatch: spaceDimension ≠ 4096
gmeow:gbcNoDimBad a logic:Formula ;
    rdfs:label "gbcNoDimBad (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The negation within gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): holds only when it is NOT the case that ∃?alg2,?d. gmeow:geometryAlgebra(?mv, ?alg2) ∧ math:spaceDimension(?alg2, ?d) ∧ ?d ≠ '4096'."@x-gmeow-english ; logic:not gmeow:gbcDimEx .
gmeow:gbcDimEx a logic:Formula ;
    rdfs:label "gbcDimEx (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): quantifies ?alg2, ?d and requires gmeow:geometryAlgebra(?mv, ?alg2) ∧ math:spaceDimension(?alg2, ?d) ∧ ?d ≠ '4096'."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "alg2" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] ;
    logic:exists gmeow:gbcDimBody .
gmeow:gbcDimBody a logic:Formula ;
    rdfs:label "gbcDimBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): conjoins gmeow:geometryAlgebra(?mv, ?alg2) ∧ math:spaceDimension(?alg2, ?d) ∧ ?d ≠ '4096'."@x-gmeow-english ; logic:and gmeow:gbcDimAlg , gmeow:gbcDimSD , gmeow:gbcDimNot4096 .
gmeow:gbcDimAlg a logic:Formula ;
    rdfs:label "gbcDimAlg (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:geometryAlgebra atom ('geometry algebra') of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): relates ?mv, ?alg2."@x-gmeow-english ; logic:relation gmeow:geometryAlgebra ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mv" ] , [ logic:termIndex 1 ; logic:termVariable "alg2" ] .
gmeow:gbcDimSD a logic:Formula ;
    rdfs:label "gbcDimSD (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The math:spaceDimension atom of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): relates ?alg2, ?d."@x-gmeow-english ; logic:relation math:spaceDimension ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "alg2" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
gmeow:gbcDimNot4096 a logic:Formula ;
    rdfs:label "gbcDimNot4096 (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The inequality atom of gmeow:GeometricBindingConstraint (the Cl(12)/4096-d geometric binding gate): asserts ?d and '4096' are distinct, the witness that closes the violation pattern."@x-gmeow-english ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "d" ] , [ logic:termIndex 1 ; logic:termLiteral "4096" ; logic:termLiteralDatatype xsd:integer ] .

gmeow:GeometryDimensionMismatch
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Geometry Dimension Mismatch"@x-gmeow-english ;
    logic:subClassOf gmeow:PreferenceConformanceFailure ;
    skos:definition "The failure raised when a candidate's declared math:CliffordAlgebra miscounts the Cl(12)/4096-d substrate (signaturePositive + signatureNegative ≠ 12, or spaceDimension ≠ 4096). Enforced by gmeow:GeometricBindingConstraint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Lifecycle receipts + the authoritative consumer improvement gate (AC6)       #
# Promotion grants no activation authority; activation requires a held          #
# gmeow:ConsumerImprovementGate verdict.                                        #
# =========================================================================== #

gmeow:LifecycleReceipt
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Lifecycle Receipt"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "A record of a lifecycle decision about a learned change: a promotion, rejection, rollback, or evaluation (gmeow:receiptKind), attributed via the EXISTING provenance (gmeow:wasGeneratedBy / gmeow:wasAssociatedWith). A promotion RECOMMENDS and cites evidence; it grants NO activation authority (gmeow:PromotionNotActivationConstraint) — activation of a deployment requires a held gmeow:ConsumerImprovementGate verdict (gmeow:ActivationAuthorityConstraint), which is authoritative. It is NOT the gmeow:ModelConfigDelta it decides about and NOT the consumer gate itself."@x-gmeow-english ;
    skos:example "ex:receipt1 a gmeow:PromotionReceipt ; gmeow:receiptKind gmeow:receiptKindPromotion ; gmeow:wasDerivedFrom ex:delta1 ; gmeow:groundedIn ex:span1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid attaching an activation-granting edge to a promotion receipt (promotion ≠ activation authority — gmeow:PromotionNotActivationConstraint) and avoid treating a promotion as sufficient to activate; the consumer improvement gate is authoritative."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the decision gmeow:LifecycleReceipt (or a subtype), classify it with gmeow:receiptKind, attribute it with the existing provenance, and cite its evidence with gmeow:groundedIn; defer activation to a held gmeow:ConsumerImprovementGate."@x-gmeow-english ;
    gmeow:useWhen "Use for a promotion/rejection/rollback/evaluation decision about a learned model/config change — a recommendation that defers activation authority to the consumer gate."@x-gmeow-english .

gmeow:ReceiptKind
    a logic:AbstractIndividualType , owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Receipt Kind"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "The closed vocabulary of lifecycle-decision kinds a gmeow:LifecycleReceipt draws from — promotion, rejection, rollback, evaluation. A value class whose members are minted individuals (Principle 9)."@x-gmeow-english ;
    skos:example "gmeow:receiptKindPromotion a gmeow:ReceiptKind ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a receipt-kind SUBCLASS of gmeow:LifecycleReceipt where a value suffices; the four subclasses exist for typed querying, the kind value for the axis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference a gmeow:ReceiptKind individual from a gmeow:LifecycleReceipt via gmeow:receiptKind."@x-gmeow-english ;
    gmeow:useWhen "Use as the lifecycle-decision value axis a gmeow:LifecycleReceipt draws from."@x-gmeow-english .

gmeow:receiptKindPromotion a owl:NamedIndividual , gmeow:ReceiptKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "promotion"@x-gmeow-english ;
    skos:definition "A promotion decision: recommends a change advance, granting no activation authority."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .
gmeow:receiptKindRejection a owl:NamedIndividual , gmeow:ReceiptKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "rejection"@x-gmeow-english ;
    skos:definition "A rejection decision: recommends a change not advance."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .
gmeow:receiptKindRollback a owl:NamedIndividual , gmeow:ReceiptKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "rollback"@x-gmeow-english ;
    skos:definition "A rollback decision: recommends reverting a previously advanced change."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .
gmeow:receiptKindEvaluation a owl:NamedIndividual , gmeow:ReceiptKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "evaluation"@x-gmeow-english ;
    skos:definition "An evaluation decision: records an assessment without recommending advance or revert."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .

gmeow:receiptKind
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain gmeow:LifecycleReceipt ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "receipt kind"@x-gmeow-english ;
    rdfs:range gmeow:ReceiptKind ;
    skos:definition "Relates a gmeow:LifecycleReceipt to its gmeow:ReceiptKind. Functional: one receipt is one decision kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:PromotionReceipt a logic:SubKind , owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "Promotion Receipt"@x-gmeow-english ;
    logic:subClassOf gmeow:LifecycleReceipt ;
    skos:definition "A gmeow:LifecycleReceipt that RECOMMENDS a change advance and cites its evidence, granting NO activation authority (gmeow:PromotionNotActivationConstraint). The receipt a consumer weighs, never the act that activates."@x-gmeow-english ;
    skos:example "ex:pr1 a gmeow:PromotionReceipt ; gmeow:receiptKind gmeow:receiptKindPromotion ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid attaching gmeow:grantsActivation to a promotion receipt; promotion is a recommendation, not an activation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the advance recommendation gmeow:PromotionReceipt, cite its evidence, and defer activation to a held gmeow:ConsumerImprovementGate."@x-gmeow-english ;
    gmeow:useWhen "Use for a promotion recommendation that defers activation authority to the consumer gate."@x-gmeow-english .
gmeow:RejectionReceipt a logic:SubKind , owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "Rejection Receipt"@x-gmeow-english ;
    logic:subClassOf gmeow:LifecycleReceipt ;
    skos:definition "A gmeow:LifecycleReceipt that recommends a change NOT advance, citing its evidence."@x-gmeow-english ;
    skos:example "ex:rj1 a gmeow:RejectionReceipt ; gmeow:receiptKind gmeow:receiptKindRejection ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using a rejection receipt to delete the change record; supersede, never erase (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the non-advance recommendation gmeow:RejectionReceipt and cite its evidence."@x-gmeow-english ;
    gmeow:useWhen "Use for a rejection recommendation about a learned change."@x-gmeow-english .
gmeow:RollbackReceipt a logic:SubKind , owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "Rollback Receipt"@x-gmeow-english ;
    logic:subClassOf gmeow:LifecycleReceipt ;
    skos:definition "A gmeow:LifecycleReceipt that recommends reverting a previously advanced change, citing its evidence."@x-gmeow-english ;
    skos:example "ex:rb1 a gmeow:RollbackReceipt ; gmeow:receiptKind gmeow:receiptKindRollback ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a rollback that erases the prior receipt; the lifecycle is an audit trail (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the revert recommendation gmeow:RollbackReceipt and cite its evidence."@x-gmeow-english ;
    gmeow:useWhen "Use for a rollback recommendation reverting a previously advanced change."@x-gmeow-english .
gmeow:EvaluationReceipt a logic:SubKind , owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "Evaluation Receipt"@x-gmeow-english ;
    logic:subClassOf gmeow:LifecycleReceipt ;
    skos:definition "A gmeow:LifecycleReceipt that records an assessment of a change without recommending advance or revert."@x-gmeow-english ;
    skos:example "ex:er1 a gmeow:EvaluationReceipt ; gmeow:receiptKind gmeow:receiptKindEvaluation ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading an evaluation receipt as a promotion; it recommends nothing, it assesses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the assessment gmeow:EvaluationReceipt and cite its evidence."@x-gmeow-english ;
    gmeow:useWhen "Use for an assessment of a learned change that recommends neither advance nor revert."@x-gmeow-english .

gmeow:ConsumerImprovementGate
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Consumer Improvement Gate"@x-gmeow-english ;
    logic:subClassOf gmeow:Observation ;
    skos:definition "The AUTHORITATIVE gate a deployment activation depends on: a gmeow:Observation whose held verdict (gmeow:gateVerdict gmeow:verdictHeld) is the explicit act that ALONE permits activation of a learned change (the embedding-projection gmeow:DeclassificationAct pattern — an activation never happens implicitly). A promotion receipt is a recommendation; only a held consumer improvement gate authorizes activation (gmeow:ActivationAuthorityConstraint). It is NOT a gmeow:PromotionReceipt (a recommendation) and NOT the activation act itself: it is the authoritative verdict that gates it."@x-gmeow-english ;
    skos:example "ex:gate1 a gmeow:ConsumerImprovementGate ; gmeow:vantage ex:consumerTelemetry ; gmeow:gateVerdict gmeow:verdictHeld ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a promotion receipt as an activation authority (only a held gmeow:ConsumerImprovementGate is authoritative) and avoid an unattributed gate; it is a vantage-attributed observation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the authoritative gate gmeow:ConsumerImprovementGate, attribute it with gmeow:vantage, carry its verdict with gmeow:gateVerdict, and require a held verdict before any activation edge is asserted."@x-gmeow-english ;
    gmeow:useWhen "Use for the authoritative consumer-improvement verdict whose held value alone permits activation of a learned change."@x-gmeow-english .

gmeow:gateVerdict
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain gmeow:ConsumerImprovementGate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "gate verdict"@x-gmeow-english ;
    rdfs:range logic:QualityValue ;
    skos:definition "Relates a gmeow:ConsumerImprovementGate to its verdict value — typed to the core logic:QualityValue, REUSING the norms gmeow:EvaluationVerdict vocabulary (gmeow:verdictHeld / gmeow:verdictNotHeld) at the instance level. Functional: one gate, one verdict. Only gmeow:verdictHeld authorizes activation (gmeow:ActivationAuthorityConstraint)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:grantsActivation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "grants activation"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "The activation-granting edge: a resource asserting that a deployment (model-serving gmeow:ModelDeployment, referenced at the instance level only — typed here to the core gmeow:InformationObject, never a range axiom onto the extension, Principle 16) is activated. It is FORBIDDEN on a gmeow:PromotionReceipt (gmeow:PromotionNotActivationConstraint) and, wherever asserted, MUST be backed by a held gmeow:ConsumerImprovementGate (gmeow:ActivationAuthorityConstraint) — a promotion alone is insufficient."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:activationAuthorizedBy
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "activation authorized by"@x-gmeow-english ;
    rdfs:range gmeow:ConsumerImprovementGate ;
    skos:definition "Relates an activation (a resource carrying gmeow:grantsActivation) to the gmeow:ConsumerImprovementGate that authorizes it — the authoritative held verdict the activation-authority gate requires. An activation with no held gate is unauthorized (gmeow:ActivationAuthorityConstraint)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# AC6 — promotion grants no activation.
gmeow:PromotionNotActivationConstraint
    a logic:ForbiddenPatternConstraint ;
    rdfs:label "Promotion not activation constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world forbidden-pattern constraint (AC6): a gmeow:PromotionReceipt must NOT carry gmeow:grantsActivation — a promotion recommends, it never activates. Expands to ∀this. gmeow:PromotionReceipt(this) → ¬∃d. gmeow:grantsActivation(this,d)."@x-gmeow-english ;
    logic:onClass gmeow:PromotionReceipt ;
    logic:forbiddenPredicate gmeow:grantsActivation ;
    logic:formalizes gmeow:PromotionReceipt ;
    logic:severity "Violation" ;
    logic:message "A gmeow:PromotionReceipt must not carry gmeow:grantsActivation; promotion grants no activation authority (AC6)." .

# AC6 — any activation must be authorized by a held consumer improvement gate.
gmeow:ActivationAuthorityConstraint
    a logic:Constraint ;
    rdfs:label "Activation authority constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC6): any resource asserting gmeow:grantsActivation MUST be gmeow:activationAuthorizedBy a resource typed gmeow:ConsumerImprovementGate whose gmeow:gateVerdict is gmeow:verdictHeld — a promotion receipt alone is insufficient; only a held consumer improvement gate authorizes activation. A ∀→∃ formula, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:grantsActivation ;
    logic:severity "Violation" ;
    logic:message "Any gmeow:grantsActivation must be gmeow:activationAuthorizedBy a gmeow:ConsumerImprovementGate whose gmeow:gateVerdict is gmeow:verdictHeld; a promotion alone cannot authorize activation (AC6)." ;
    logic:integrity gmeow:aacForall .
gmeow:aacForall a logic:Formula ;
    rdfs:label "aacForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:ActivationAuthorityConstraint (AC6, activation authority): binds ?this and requires ∃?dep. gmeow:grantsActivation(?this, ?dep) → ∃?gate. gmeow:aacBody."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:aacImpl .
gmeow:aacImpl a logic:Formula ;
    rdfs:label "aacImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:ActivationAuthorityConstraint (AC6, activation authority): when ∃?dep. gmeow:grantsActivation(?this, ?dep) holds, requires ∃?gate. gmeow:activationAuthorizedBy(?this, ?gate) ∧ ?gate is a gmeow:ConsumerImprovementGate ∧ gmeow:gateVerdict(?gate, gmeow:verdictHeld)."@x-gmeow-english ; logic:antecedent gmeow:aacGuard ; logic:consequent gmeow:aacExists .
gmeow:aacGuard a logic:Formula ;
    rdfs:label "aacGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:ActivationAuthorityConstraint (AC6, activation authority): quantifies ?dep and requires gmeow:grantsActivation(?this, ?dep)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "dep" ] ;
    logic:exists gmeow:aacGrants .
gmeow:aacGrants a logic:Formula ;
    rdfs:label "aacGrants (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:grantsActivation atom ('grants activation') of gmeow:ActivationAuthorityConstraint (AC6, activation authority): relates ?this, ?dep."@x-gmeow-english ; logic:relation gmeow:grantsActivation ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "dep" ] .
gmeow:aacExists a logic:Formula ;
    rdfs:label "aacExists (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:ActivationAuthorityConstraint (AC6, activation authority): quantifies ?gate and requires gmeow:activationAuthorizedBy(?this, ?gate) ∧ ?gate is a gmeow:ConsumerImprovementGate ∧ gmeow:gateVerdict(?gate, gmeow:verdictHeld)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "gate" ] ;
    logic:exists gmeow:aacBody .
gmeow:aacBody a logic:Formula ;
    rdfs:label "aacBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:ActivationAuthorityConstraint (AC6, activation authority): conjoins gmeow:activationAuthorizedBy(?this, ?gate) ∧ ?gate is a gmeow:ConsumerImprovementGate ∧ gmeow:gateVerdict(?gate, gmeow:verdictHeld)."@x-gmeow-english ; logic:and gmeow:aacAuth , gmeow:aacGateType , gmeow:aacHeld .
gmeow:aacAuth a logic:Formula ;
    rdfs:label "aacAuth (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:activationAuthorizedBy atom ('activation authorized by') of gmeow:ActivationAuthorityConstraint (AC6, activation authority): relates ?this, ?gate."@x-gmeow-english ; logic:relation gmeow:activationAuthorizedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "gate" ] .
gmeow:aacGateType a logic:Formula ;
    rdfs:label "aacGateType (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:ActivationAuthorityConstraint (AC6, activation authority): asserts ?gate is a gmeow:ConsumerImprovementGate."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "gate" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ConsumerImprovementGate ] .
gmeow:aacHeld a logic:Formula ;
    rdfs:label "aacHeld (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:gateVerdict atom ('gate verdict') of gmeow:ActivationAuthorityConstraint (AC6, activation authority): relates ?gate, gmeow:verdictHeld."@x-gmeow-english ; logic:relation gmeow:gateVerdict ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "gate" ] , [ logic:termIndex 1 ; logic:termIri gmeow:verdictHeld ] .

# =========================================================================== #
# TASK 7 (module part) — anti-preferredRank / context-required gates           #
# (The tests/structural.ttl bans and mappings/equivalences.ttl alignments are   #
# separate files.)                                                             #
# =========================================================================== #

# A preference observation must carry its comparison context (mandatory leg).
gmeow:PreferenceContextRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Preference context required constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC2): every gmeow:PreferenceObservation MUST carry a gmeow:comparisonContext — a context-free preference is exactly the forbidden universal winner (Principle 9). Expands to ∀this. gmeow:PreferenceObservation(this) → ∃ gmeow:comparisonContext, backed by a closed-world logic:ClosureEntry over gmeow:comparisonContext."@x-gmeow-english ;
    logic:onClass gmeow:PreferenceObservation ;
    logic:anyOf gmeow:comparisonContext ;
    logic:formalizes gmeow:PreferenceObservation ;
    logic:severity "Violation" ;
    logic:message "A gmeow:PreferenceObservation must carry a gmeow:comparisonContext; a context-free preference is the forbidden universal winner (Principle 9)." .

[ a logic:ClosureEntry ; logic:onClass gmeow:PreferenceObservation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/comparisonContext" ; logic:closureValue logic:ClosedWorldClosure ] .

# The candidate-set roster is closed-world (membership is complete, not open).
[ a logic:ClosureEntry ; logic:onClass gmeow:CandidateSet ; logic:closureKey "https://blackcatinformatics.ca/gmeow/hasCandidate" ; logic:closureValue logic:ClosedWorldClosure ] .

# The consensus section's registered vantage base is closed-world (F2).
[ a logic:ClosureEntry ; logic:onClass gmeow:ComparisonContext ; logic:closureKey "https://blackcatinformatics.ca/gmeow/registersObservation" ; logic:closureValue logic:ClosedWorldClosure ] .

# A lossy projection preservation record names its expressiveness boundary.
gmeow:PreservationBoundaryConstraint
    a logic:Constraint ;
    rdfs:label "Preservation boundary constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:ProjectionPreservationRecord whose logic:preservationKind is anything OTHER than logic:ExactPreservation MUST name a logic:ExpressivenessBoundary through logic:expressivenessBoundary — a record claiming less than exact preservation without naming what it dropped is an honesty gap the loss ledger forbids (Principle 17). A ∀→∃ formula, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:ProjectionPreservationRecord ;
    logic:severity "Violation" ;
    logic:message "A gmeow:ProjectionPreservationRecord whose logic:preservationKind is not logic:ExactPreservation must name a logic:ExpressivenessBoundary through logic:expressivenessBoundary." ;
    logic:integrity gmeow:pbcForall .
gmeow:pbcForall a logic:Formula ;
    rdfs:label "pbcForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:PreservationBoundaryConstraint (the preservation-boundary honesty gate): binds ?this and requires ?this is a gmeow:ProjectionPreservationRecord ∧ gmeow:pbcLossy → ∃?b. logic:expressivenessBoundary(?this, ?b)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:pbcImpl .
gmeow:pbcImpl a logic:Formula ;
    rdfs:label "pbcImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:PreservationBoundaryConstraint (the preservation-boundary honesty gate): when ?this is a gmeow:ProjectionPreservationRecord ∧ ∃?k. gmeow:pbcLossyBody holds, requires ∃?b. logic:expressivenessBoundary(?this, ?b)."@x-gmeow-english ; logic:antecedent gmeow:pbcGuard ; logic:consequent gmeow:pbcExists .
gmeow:pbcGuard a logic:Formula ;
    rdfs:label "pbcGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:PreservationBoundaryConstraint (the preservation-boundary honesty gate): conjoins ?this is a gmeow:ProjectionPreservationRecord ∧ ∃?k. gmeow:pbcLossyBody."@x-gmeow-english ; logic:and gmeow:pbcType , gmeow:pbcLossy .
gmeow:pbcType a logic:Formula ;
    rdfs:label "pbcType (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:PreservationBoundaryConstraint (the preservation-boundary honesty gate): asserts ?this is a gmeow:ProjectionPreservationRecord."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ProjectionPreservationRecord ] .
gmeow:pbcLossy a logic:Formula ;
    rdfs:label "pbcLossy (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:PreservationBoundaryConstraint (the preservation-boundary honesty gate): quantifies ?k and requires logic:preservationKind(?this, ?k) ∧ ?k ≠ logic:ExactPreservation."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "k" ] ;
    logic:exists gmeow:pbcLossyBody .
gmeow:pbcLossyBody a logic:Formula ;
    rdfs:label "pbcLossyBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:PreservationBoundaryConstraint (the preservation-boundary honesty gate): conjoins logic:preservationKind(?this, ?k) ∧ ?k ≠ logic:ExactPreservation."@x-gmeow-english ; logic:and gmeow:pbcKind , gmeow:pbcNotExact .
gmeow:pbcKind a logic:Formula ;
    rdfs:label "pbcKind (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The logic:preservationKind atom of gmeow:PreservationBoundaryConstraint (the preservation-boundary honesty gate): relates ?this, ?k."@x-gmeow-english ; logic:relation logic:preservationKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "k" ] .
gmeow:pbcNotExact a logic:Formula ;
    rdfs:label "pbcNotExact (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The inequality atom of gmeow:PreservationBoundaryConstraint (the preservation-boundary honesty gate): asserts ?k and logic:ExactPreservation are distinct, the witness that closes the violation pattern."@x-gmeow-english ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "k" ] , [ logic:termIndex 1 ; logic:termIri logic:ExactPreservation ] .
gmeow:pbcExists a logic:Formula ;
    rdfs:label "pbcExists (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:PreservationBoundaryConstraint (the preservation-boundary honesty gate): quantifies ?b and requires logic:expressivenessBoundary(?this, ?b)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "b" ] ;
    logic:exists gmeow:pbcAtom .
gmeow:pbcAtom a logic:Formula ;
    rdfs:label "pbcAtom (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The logic:expressivenessBoundary atom of gmeow:PreservationBoundaryConstraint (the preservation-boundary honesty gate): relates ?this, ?b."@x-gmeow-english ; logic:relation logic:expressivenessBoundary ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .

# The governing anti-context-free-winner gate is the whole-base consensus gate;
# this forbidden-pattern gate additionally bans a naked context-free winner flag
# on any resource that is not a gmeow:PreferenceClaim (the only construct that may
# carry it under a discharged consensus).
gmeow:ForbidContextFreeWinnerConstraint
    a logic:ForbiddenPatternConstraint ;
    rdfs:label "Forbid context-free winner constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world forbidden-pattern constraint (AC2): a gmeow:CandidateSet must NOT carry gmeow:assertsGlobalWinner — a global winner is never a property of the field itself, only of a gmeow:PreferenceClaim under a discharged whole-base consensus. Binding the winner flag on the candidate set (or any non-claim resource) is the context-free winner Principle 9 forbids. Expands to ∀this. gmeow:CandidateSet(this) → ¬∃w. gmeow:assertsGlobalWinner(this,w)."@x-gmeow-english ;
    logic:onClass gmeow:CandidateSet ;
    logic:forbiddenPredicate gmeow:assertsGlobalWinner ;
    logic:formalizes gmeow:CandidateSet ;
    logic:severity "Violation" ;
    logic:message "A gmeow:CandidateSet must not carry gmeow:assertsGlobalWinner; a global winner is a discharged gmeow:PreferenceClaim, never a property of the field (Principle 9)." .

# =========================================================================== #
# The slice ontology header                                                    #
# =========================================================================== #

<https://blackcatinformatics.ca/gmeow/slices/preference>
    a owl:Ontology ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "GMEOW Preference Module"@x-gmeow-english ;
    rdfs:comment "The extension mints ONLY bridge terms (Principle 19): it COMPOSES the shipped math: sheaf/Clifford/E8/connection objects (math:CellComplex, math:CellularSheaf, math:SheafStalk, math:LocalSection, math:GlobalSection/H0, math:GluingObstruction/H1, math:connectionOfSheaf/math:Holonomy, math:Relation, math:Multivector/math:CliffordAlgebra/math:MetricSignature, math:RootSystem/math:Lattice/math:WeylGroup), the logic: loss ledger and property-characteristic carrier (logic:preservationKind, logic:expressivenessBoundary, logic:PropertyCharacteristicAssertion, the strict-order/symmetry markers), and the core candidate/observation/standpoint/evidence/provenance spine — grounding NOTHING itself and hand-authoring no shapes (the pipeline derives them). Compiled RDF 1.2 preference INSTANCE data lives in the consumer lillith_decodes; this slice is the vocabulary."@x-gmeow-english ;
    skos:definition "The preference consumer extension: it records a CONTEXTUAL comparison over a complete candidate set as a gmeow:vantage-indexed, defeasible, proof-carrying gmeow:PreferenceObservation; compiles the vantage-indexed orders into a math:CellComplex carried by a math:CellularSheaf; certifies a global winner IFF the per-vantage orders glue into a math:GlobalSection (H0) over the whole base AND discharge the math:GluingObstruction (H1); wraps every derived ranking as a lossy, disclosed, content-addressed gmeow:ProjectionReceipt; binds content-addressed model/config deltas over the full identity tuple; seams candidates by reference to the Cl(12)/E8/4096-d substrate; and keeps promotion strictly separate from activation authority. Its governing rule: a preference is NEVER automatically a global winner."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

