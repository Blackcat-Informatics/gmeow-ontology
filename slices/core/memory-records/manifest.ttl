<https://blackcatinformatics.ca/gmeow/slices/memory-records>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:sliceTier gmeow:tierCore ;
    rdfs:label "memory records"@x-gmeow-english ;
    skos:definition "Memory prose, lasting bank identities, review decisions, summary anchors, runtime-kept appraisals and external historical curation evidence."@x-gmeow-english ;
    dcterms:title "GMEOW Memory Records Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Agent memory adapters preserving revision lineage, audience scope and attributed source evidence."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceDependsOn <https://blackcatinformatics.ca/gmeow/slices/logic>,
        <https://blackcatinformatics.ca/gmeow/slices/kernel>,
        <https://blackcatinformatics.ca/gmeow/slices/entities>,
        <https://blackcatinformatics.ca/gmeow/slices/observations>,
        <https://blackcatinformatics.ca/gmeow/slices/ai>,
        <https://blackcatinformatics.ca/gmeow/slices/provenance>,
        <https://blackcatinformatics.ca/gmeow/slices/sources>,
        <https://blackcatinformatics.ca/gmeow/slices/events>,
        <https://blackcatinformatics.ca/gmeow/slices/coreference>,
        <https://blackcatinformatics.ca/gmeow/slices/documents>,
        <https://blackcatinformatics.ca/gmeow/slices/standpoint> .
