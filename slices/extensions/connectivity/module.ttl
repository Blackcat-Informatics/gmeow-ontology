@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:Connection
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "Connection"@x-gmeow-english ;
    logic:mediates gmeow:connectionSource ,
        gmeow:connectionTarget ;
    rdfs:subClassOf logic:Relator ;
    skos:definition "A reified traversable link between two entities, able to bear its own period, cost, weight, bandwidth, confidence, and standpoint. The flat shortcut is gmeow:connectsTo; promote to Connection when metadata matters."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Route
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "Route"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Entity ;
    skos:definition "A traversable path through a graph of connected entities — a named, typed sequence of linked nodes with a defined start and end. Models transport lines, network paths, citation chains, social paths, and dependency chains. The actual path geometry, ordering, and cost are computed by the solver layer (Principle 12), not asserted as triples."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:RouteKind
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "Route Kind"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of a route — transit line, flight path, walking path, citation chain, network path, social path, dependency chain. An open value vocabulary (individuals, never subclasses) per Principle 9."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:connectionSource
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Connection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "connection source"@x-gmeow-english ;
    rdfs:range owl:Thing ;
    skos:definition "The source of a reified Connection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

gmeow:connectionTarget
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Connection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "connection target"@x-gmeow-english ;
    rdfs:range owl:Thing ;
    skos:definition "The target of a reified Connection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasRoute
    a owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "has route"@x-gmeow-english ;
    rdfs:range gmeow:Route ;
    skos:definition "Relates a thing to a route that starts from, ends at, or passes through it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasRouteSegment
    a owl:ObjectProperty ,
        owl:TransitiveProperty ;
    rdfs:domain gmeow:Route ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "has route segment"@x-gmeow-english ;
    rdfs:range gmeow:Route ;
    rdfs:subPropertyOf gmeow:hasPart ;
    skos:definition "A sub-route that is part of a larger route. A specialization of the universal gmeow:hasPart spine."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:referenceFrameNetworkGraph
    a gmeow:ReferenceFrame ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "Network Graph Reference Frame"@x-gmeow-english ;
    skos:definition "The network graph reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindGrid ;
    gmeow:frameRealm gmeow:frameRealmVirtual ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:hasAxis gmeow:axisScalar ;
    gmeow:hasMetricKind gmeow:metricGraphHops ;
    gmeow:requiresHost false .

gmeow:routeEnd
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Route ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "route end"@x-gmeow-english ;
    rdfs:range owl:Thing ;
    skos:definition "The end of a route."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:routeKind
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Route ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "route kind"@x-gmeow-english ;
    rdfs:range gmeow:RouteKind ;
    skos:definition "The kind of a route (a RouteKind individual)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:routeKindAccessible
    a gmeow:RouteKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "accessible route"@x-gmeow-english ;
    skos:definition "A route computed to satisfy a set of accessibility needs. The actual path is determined by the solver layer (Principle 12), not asserted in OWL."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:routeKindCitation
    a gmeow:RouteKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "citation chain"@x-gmeow-english ;
    skos:definition "The citation route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:routeKindDependency
    a gmeow:RouteKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "dependency chain"@x-gmeow-english ;
    skos:definition "The dependency route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:routeKindFlight
    a gmeow:RouteKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "flight path"@x-gmeow-english ;
    skos:definition "The flight route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:routeKindNetwork
    a gmeow:RouteKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "network path"@x-gmeow-english ;
    skos:definition "The network route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:routeKindSocial
    a gmeow:RouteKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "social path"@x-gmeow-english ;
    skos:definition "The social route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:routeKindTransit
    a gmeow:RouteKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "transit route"@x-gmeow-english ;
    skos:definition "The transit route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:routeKindWalking
    a gmeow:RouteKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "walking route"@x-gmeow-english ;
    skos:definition "The walking route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:routeStart
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Route ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "route start"@x-gmeow-english ;
    rdfs:range owl:Thing ;
    skos:definition "The start of a route."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:routeVia
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Route ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "route via"@x-gmeow-english ;
    rdfs:range owl:Thing ;
    skos:definition "An intermediate point that a route passes through. The order of via points is computed by the solver layer (Principle 12), not asserted in the OWL core."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

<https://blackcatinformatics.ca/gmeow/slices/connectivity>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "Universal connectivity, network, and routing constructs — traversable links, reified connections, and route paths. Distinct from mereology (partOf) and RCC-8 adjacency. Part of the Location-as-reference-frame design."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "GMEOW Connectivity Module"@x-gmeow-english ;
    skos:definition "The GMEOW Connectivity Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:connectionSourceFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "connectionSource is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:connectionSource is functional: a reified Connection has exactly one source endpoint, so a link departing from several things is several Connections rather than one Connection with many sources."@x-gmeow-english ;
    logic:characterizes gmeow:connectionSource ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:connectionSource ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:connectionSource names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:connectionSource, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:connectionSourceFunctionality logic:characterizes gmeow:connectionSource ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:connectionTargetFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "connectionTarget is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:connectionTarget is functional: a reified Connection has exactly one target endpoint, so a link arriving at several things is several Connections rather than one Connection with many targets."@x-gmeow-english ;
    logic:characterizes gmeow:connectionTarget ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:connectionTarget ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:connectionTarget names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:connectionTarget, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:connectionTargetFunctionality logic:characterizes gmeow:connectionTarget ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:routeEndFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "routeEnd is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:routeEnd is functional: a route terminates at exactly one end node, the single destination that closes the path."@x-gmeow-english ;
    logic:characterizes gmeow:routeEnd ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:routeEnd ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:routeEnd names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:routeEnd, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:routeEndFunctionality logic:characterizes gmeow:routeEnd ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:routeKindFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "routeKind is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:routeKind is functional: a route is classified by exactly one RouteKind value, the single domain (transit, flight, citation, dependency, and so on) in which its path is traversed."@x-gmeow-english ;
    logic:characterizes gmeow:routeKind ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:routeKind ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:routeKind names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:routeKind, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:routeKindFunctionality logic:characterizes gmeow:routeKind ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:routeStartFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/connectivity> ;
    rdfs:label "routeStart is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:routeStart is functional: a route originates at exactly one start node, the single point from which the path departs."@x-gmeow-english ;
    logic:characterizes gmeow:routeStart ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:routeStart ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:routeStart names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:routeStart, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:routeStartFunctionality logic:characterizes gmeow:routeStart ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .