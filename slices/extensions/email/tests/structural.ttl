PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:messageIdGenerated a owl:DatatypeProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range xsd:boolean .
}""" ;
    gmeow:saRationale """gmeow:messageIdGenerated MUST be a DatatypeProperty on EmailMessage ranging over xsd:boolean.""" .

