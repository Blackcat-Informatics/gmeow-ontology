    gmeow:saRationale """gmeow:threadSubject MUST be a DatatypeProperty on Thread ranging over Literal.""" .

ex:saSubjectPrefixDatatypePropertyOnEmailMessage a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:subjectPrefix a owl:DatatypeProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range rdfs:Literal .
    FILTER NOT EXISTS { gmeow:subjectPrefix a owl:FunctionalProperty }
}""" ;
    gmeow:saRationale """gmeow:subjectPrefix MUST be a DatatypeProperty on EmailMessage ranging over Literal and MUST NOT be functional because nested prefixes may coexist.""" .

ex:saNoEmailVariantSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    { gmeow:EmailMessageVariant a owl:Class . }
    UNION
    { gmeow:CanonicalEmailMessage a owl:Class . }
}""" ;
    gmeow:saRationale """Canonical/variant status MUST be modeled via roles, not email-specific subclasses.""" .

ex:saHasPatchDiffObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasPatchDiff a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:hasBodyPart ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range gmeow:EmailPatchDiff .
    FILTER NOT EXISTS { gmeow:hasPatchDiff a owl:FunctionalProperty }
}""" ;
    gmeow:saRationale """gmeow:hasPatchDiff MUST be an ObjectProperty, subproperty of gmeow:hasBodyPart, from EmailMessage to EmailPatchDiff, and MUST NOT be functional.""" .

