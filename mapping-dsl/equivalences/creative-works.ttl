gmeow:eqCw016 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventTypeWorkConception ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject lrmoo:F27_Work_Conception ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "LRMoo F27 Work Conception ≈ GMEOW event type value." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw017 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventTypeExpressionCreation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject lrmoo:F28_Expression_Creation ;
    gmeow:justification semapv:ManualMappingCuration ;
