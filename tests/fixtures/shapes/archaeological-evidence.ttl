# SHACL-valid fixture for archaeological evidence (#173).
# Demonstrates layer separation and competing claims.

@prefix ex:    <https://example.org/arch/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix lang:   <https://blackcatinformatics.ca/lang/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix time:  <http://www.w3.org/2006/time#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# --- Standpoints ------------------------------------------------------------- #

ex:standpoint-epigrapher-a  a gmeow:Standpoint ; gmeow:sharpens gmeow:universalStandpoint .
ex:standpoint-epigrapher-b  a gmeow:Standpoint ; gmeow:sharpens gmeow:universalStandpoint .
ex:standpoint-excavator-x   a gmeow:Standpoint ; gmeow:sharpens gmeow:universalStandpoint .

# --- Physical carrier: a clay tablet ----------------------------------------- #

ex:tablet1 a gmeow:PhysicalObject ;
    gmeow:carrierType gmeow:carrierTablet .

# --- Sign-bearing inscription ------------------------------------------------ #

ex:inscription1 a gmeow:Inscription ;
    gmeow:inscriptionCarrier ex:tablet1 .

# --- Two competing readings -------------------------------------------------- #

ex:readingA a gmeow:LexicalForm ;
    gmeow:formRepresentation "𒀭" ;
    gmeow:formType gmeow:formWritten .

ex:readingB a gmeow:LexicalForm ;
    gmeow:formRepresentation "𒀭𒈹" ;
    gmeow:formType gmeow:formWritten .

ex:inscriptionReadingA a gmeow:InscriptionReading ;
    gmeow:readingOf ex:inscription1 ;
    gmeow:readingResult ex:readingA ;
    gmeow:vantage ex:standpoint-epigrapher-a ;
    gmeow:confidence 0.75 .

ex:inscriptionReadingB a gmeow:InscriptionReading ;
    gmeow:readingOf ex:inscription1 ;
    gmeow:readingResult ex:readingB ;
    gmeow:vantage ex:standpoint-epigrapher-b ;
    gmeow:confidence 0.60 .

# --- Transliteration --------------------------------------------------------- #

ex:transliterationResult a gmeow:LexicalForm ;
    gmeow:formRepresentation "an" ;
    gmeow:formType gmeow:formTransliterated ;
    gmeow:formTransliterationScheme gmeow:schemeHepburn .

ex:transliteration1 a gmeow:InscriptionTransliteration ;
    gmeow:transliterationOf ex:inscription1 ;
    gmeow:transliterationResult ex:transliterationResult ;
    gmeow:vantage ex:standpoint-epigrapher-a ;
    gmeow:confidence 0.80 .

# --- Translation ------------------------------------------------------------- #

ex:translationResult a gmeow:LexicalForm ;
    gmeow:formRepresentation "god" ;
    gmeow:formType gmeow:formTranslated .

ex:translation1 a gmeow:InscriptionTranslation ;
    gmeow:translationOf ex:inscription1 ;
    gmeow:translationResult ex:translationResult ;
    gmeow:vantage ex:standpoint-epigrapher-a ;
    gmeow:confidence 0.70 .

# --- Find context ------------------------------------------------------------ #

ex:findSpot a gmeow:Place .

ex:excavationEvent a gmeow:Event .

ex:dating1 a gmeow:TemporalMeasurement ;
    gmeow:vantage ex:standpoint-excavator-x ;
    gmeow:observedFeature ex:tablet1 ;
    gmeow:measurementMethod gmeow:datingMethodStratigraphicCorrelation ;
    gmeow:measuredAge "3200"^^xsd:decimal ;
    gmeow:unit <http://qudt.org/vocab/unit/YR> ;
    gmeow:hasReferenceFrame gmeow:temporalFrameBeforePresent ;
    gmeow:measurementUncertainty "100"^^xsd:decimal .

ex:findContext1 a gmeow:ArchaeologicalFindContext ;
    gmeow:findContextTarget ex:tablet1 ;
    gmeow:findContextPlace ex:findSpot ;
    gmeow:findContextDating ex:dating1 ;
    gmeow:findContextEvent ex:excavationEvent ;
    gmeow:vantage ex:standpoint-excavator-x ;
    gmeow:confidence 0.90 .

# --- Competing script/language attributions ---------------------------------- #

ex:sumerian a gmeow:Language ; gmeow:languageCode "sux" .
ex:akkadian a gmeow:Language ; gmeow:languageCode "akk" .

ex:cuneiform a lang:Script ; skos:notation "Xsux"^^xsd:string .

ex:attributionA a gmeow:ScriptLanguageAttribution ;
    gmeow:attributionTarget ex:inscription1 ;
    gmeow:attributedLanguage ex:sumerian ;
    gmeow:attributedScript ex:cuneiform ;
    gmeow:vantage ex:standpoint-epigrapher-a ;
    gmeow:confidence 0.85 .

ex:attributionB a gmeow:ScriptLanguageAttribution ;
    gmeow:attributionTarget ex:inscription1 ;
    gmeow:attributedLanguage ex:akkadian ;
    gmeow:attributedScript ex:cuneiform ;
    gmeow:vantage ex:standpoint-epigrapher-b ;
    gmeow:confidence 0.60 .

# --- Undeciphered / uncertain case ------------------------------------------- #

ex:linearA a gmeow:NotationSystem ;
    gmeow:symbolicSystemKind gmeow:symbolicKindEncoding .

ex:undecipheredAttribution a gmeow:ScriptLanguageAttribution ;
    gmeow:attributionTarget ex:inscription1 ;
    gmeow:attributedNotation ex:linearA ;
    gmeow:hasDeterminacy gmeow:determinacyDisputed ;
    gmeow:vantage ex:standpoint-epigrapher-a ;
    gmeow:confidence 0.40 .

# --- UsageAttestation hook to carrier ---------------------------------------- #

ex:sourceArchive a gmeow:CreativeWork ;
    gmeow:sourceLocation "https://example.org/archive/tablet-1" .

ex:carrierAttestation a gmeow:UsageAttestation ;
    gmeow:attestedForm ex:readingA ;
    gmeow:attestedInSource ex:sourceArchive ;
    gmeow:attestedOnCarrier ex:tablet1 ;
    gmeow:confidence 0.90 .

# --- EtymologicalDerivation using inscription evidence ----------------------- #

ex:ancestorWord a gmeow:LexicalItem ;
    gmeow:lexicalItemLanguage ex:sumerian .

ex:descendantWord a gmeow:LexicalItem ;
    gmeow:lexicalItemLanguage ex:akkadian .

ex:derivation1 a gmeow:EtymologicalDerivation ;
    gmeow:etymonSource ex:ancestorWord ;
    gmeow:derivationTarget ex:descendantWord ;
    gmeow:derivationKind gmeow:derivationBorrowing ;
    gmeow:derivationEvidence ex:carrierAttestation ;
    gmeow:confidence 0.65 .
