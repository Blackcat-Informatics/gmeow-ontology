@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix vcardx: <https://blackcatinformatics.ca/vcard-ext/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/vcard>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Relation ;
            edoal:compose ( [
                a edoal:Relation ;
                edoal:inverse [
                    a edoal:Relation ;
                    edoal:uri gmeow:membershipMember ;
                ] ;
            ] [
                a edoal:Relation ;
                edoal:uri gmeow:hasRole ;
            ] [
                a edoal:Relation ;
                edoal:or ( [
                    a edoal:Relation ;
                    edoal:uri rdfs:label ;
                ] [
                    a edoal:Relation ;
                    edoal:uri gmeow:name ;
                ] ) ;
            ] ) ;
        ] ;
        align:entity2 [
            a edoal:Property ;
            edoal:uri vcard:title ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.9"^^xsd:double ;
        edoal:transformation [
            rdfs:seeAlso gmeow:fnMembershipToJobTitle ;
        ] ;
        rdfs:label "Membership Role → vcard:title"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:compose ( [
                    a edoal:Relation ;
                    edoal:inverse [
                        a edoal:Relation ;
                        edoal:uri gmeow:participationParticipant ;
                    ] ;
                ] [
                    a edoal:Relation ;
                    edoal:uri gmeow:participationEvent ;
                ] [
                    a edoal:Relation ;
                    edoal:uri gmeow:eventTime ;
                ] ) ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri vcard:bday ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.95"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnBirthEventToDate ;
            ] ;
            rdfs:label "Birth life-event date → vcard:bday"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:PostalAddress ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri vcard:Address ;
            ] ;
            align:relation "=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnComposeAddress ;
            ] ;
            rdfs:label "PostalAddress → vcard:Address (component rename + composed vcard:label)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:description ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri vcard:note ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            rdfs:label "gmeow:description → vcard:note"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:fullName ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri vcard:fn ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnSelectDisplayName ;
            ] ;
            rdfs:label "displayable fullName → vcard:fn"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasContactPoint ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri vcard:hasEmail ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "contact-point email address → vcard:hasEmail"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasContactPoint ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri vcard:hasInstantMessage ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "contact-point IM handle → vcard:hasInstantMessage"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasContactPoint ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri vcard:hasTelephone ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "contact-point telephone number → vcard:hasTelephone"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasName ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri vcard:nickname ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnNicknameName ;
            ] ;
            rdfs:label "nickname-purpose PersonName → vcard:nickname"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasPronounSet ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri vcardx:pronouns ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnPronounSetToText ;
            ] ;
            rdfs:label "PronounSet five forms → vCard PRONOUNS display text (RFC 9554 extension)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasWebPage ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri vcard:hasURL ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnWebPageToUrl ;
            ] ;
            rdfs:label "hasWebPage → vcard:hasURL (the WebPage IRI)"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "vcard" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → vcard (EDOAL)"@en .
