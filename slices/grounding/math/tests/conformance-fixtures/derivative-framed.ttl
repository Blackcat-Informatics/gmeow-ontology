#
# Well-formed: a derivative naming what it differentiates, its variable, and its
# order. Conforms to math:DerivativeShape. Bound by ex:ecDerivativeFramed.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:velocity a math:Derivative ;
    math:operator math:differentiationBinder ;
    math:derivativeOf ex:positionFn ;
    math:withRespectToVariable ex:timeDecl ;
    math:derivativeOrder 1 .

ex:positionFn a math:MathematicalExpression .
ex:timeDecl a math:VariableDeclaration .
