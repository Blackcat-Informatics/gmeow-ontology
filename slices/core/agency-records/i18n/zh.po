msgctxt "https://blackcatinformatics.ca/gmeow/receiptOperation|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:receiptOperation ex:target ."
msgstr "ex:record gmeow:receiptOperation ex:target ."

msgctxt "https://blackcatinformatics.ca/gmeow/receiptArtifact|http://www.w3.org/2000/01/rdf-schema#label"
msgid "receipt artifact"
msgstr "回执制品"

msgctxt "https://blackcatinformatics.ca/gmeow/receiptArtifact|http://www.w3.org/2004/02/skos/core#definition"
msgid "The artifact or exact version on which the recorded operation acted, not the activity’s result envelope."
msgstr "已记录操作作用的制品或确切版本，而非活动结果信封。"

msgctxt "https://blackcatinformatics.ca/gmeow/receiptArtifact|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve the source’s receipt artifact relation."
msgstr "用于保留来源的回执制品关系。"

msgctxt "https://blackcatinformatics.ca/gmeow/receiptArtifact|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing a receiptArtifact target from a different lifecycle or status axis."
msgstr "避免从另一生命周期或状态维度虚构 receiptArtifact 目标。"

msgctxt "https://blackcatinformatics.ca/gmeow/receiptArtifact|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference the source-supported receiptArtifact target and retain independently attributed alternatives."
msgstr "引用来源支持的 receiptArtifact 目标，并保留独立归属的其他解释。"

msgctxt "https://blackcatinformatics.ca/gmeow/receiptArtifact|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:receiptArtifact ex:target ."
msgstr "ex:record gmeow:receiptArtifact ex:target ."

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcome|http://www.w3.org/2000/01/rdf-schema#label"
msgid "invocation outcome"
msgstr "调用结果关联"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcome|http://www.w3.org/2004/02/skos/core#definition"
msgid "A source-reported outcome of a model invocation, separate from artifact completion and error text."
msgstr "来源报告的模型调用结果，区别于制品完成状态及错误文本。"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcome|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve the source’s invocation outcome relation."
msgstr "用于保留来源的调用结果关联关系。"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcome|https://blackcatinformatics.ca/gmeow/avoidWhen"
