#
# Well-formed: a series naming its general term and carrying a convergence with a
# declared mode — and, as a math:BindingExpression, the math:VariableDeclaration it
# binds (the summation index) and its body through an indexed math:argumentSlot.
# Conforms to math:SeriesShape, math:ConvergenceShape, and math:BindingExpressionShape.
# Bound by ex:ecSeriesConvergent.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:zetaSeries a math:Series ;
    math:operator math:summationBinder ;
    math:seriesTerm ex:zetaTerm ;
    math:hasConvergence ex:zetaConvergence ;
    math:boundVariable ex:seriesIndexDecl ;
    math:argumentSlot ex:zetaSeriesSlot0 .

ex:zetaSeriesSlot0 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression ex:zetaTerm .

ex:seriesIndexDecl a math:VariableDeclaration .
# The series term is named, not decomposed: a math:SymbolReference resolving to a SYMBOL is the
# concrete form for that. The abstract math:MathematicalExpression base names no form and
# carries no structural identity (math:UnrecognizedExpressionType).
ex:zetaTerm a math:SymbolReference ; math:hasMathematicalSymbol ex:zetaTermSymbol .
ex:zetaTermSymbol a math:MathematicalSymbol .
ex:zetaConvergence a math:Convergence ;
    math:convergesTo ex:zetaValue ;
    math:convergenceMode math:absoluteConvergence .

ex:zetaValue a math:MathematicalObject .
