    gmeow:gmnAsciiFallback "pi" ;
    gmeow:gmnSpokenLabel "pi" ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionAdoptedGlyph ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisTokenCost ;
    gmeow:gmnDispositionRationale "π and pi each cost one pinned cl100k_base token; the conventional exact-constant sign wins without a token penalty and remains scoped to @μ." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenMathPi ;
    gmeow:cites gmeow:gmnOpenMathWork , gmeow:gmnUnicodeMathWork ;
    gmeow:graphBoxRole gmeow:boxABox .

