<https://blackcatinformatics.ca/gmeow/slices/graphrag>
    a gmeow:Slice ;
    rdfs:label "graphrag"@x-gmeow-english ;
    skos:definition "The graphrag slice of the GMEOW ontology (extension tier): GMEOW GraphRAG Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    dcterms:title "GMEOW GraphRAG Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierExtension ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/entities> ,
        <https://blackcatinformatics.ca/gmeow/slices/provenance> ,
        <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    gmeow:sliceConsumer "Project Lillith — a GraphRAG deployment whose corpus, embeddings, indexes, retrievals, and derived entity graph must be auditable provenance, not pipeline internals (P15)."@x-gmeow-english .
