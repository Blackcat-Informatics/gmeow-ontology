    gmeow:enforcesFailureClass math:UnderspecifiedConvergence .

math:Sequence rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:hasConvergence ; owl:minQualifiedCardinality 1 ; owl:onClass math:Convergence ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedConvergence .

math:ContinuousMap rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:isContinuous ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:boolean ] ;
    gmeow:enforcesFailureClass math:UndeclaredTopologicalProperty .

math:CompactSpace rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:isCompact ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:boolean ] ;
    gmeow:enforcesFailureClass math:UndeclaredTopologicalProperty .

math:ConnectedSpace rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:isConnected ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:boolean ] ;
