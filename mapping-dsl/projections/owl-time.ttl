@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix time:  <http://www.w3.org/2006/time#> .

# Projection mappings: GMEOW events → pure OWL-Time interval relations (W3C Time
# Ontology). Compiled to projections/owl-time.edoal.ttl + queries/projections/
# owl-time.rq by `gmeow compile-mappings`. The 13 Allen relations GMEOW carries
# between gmeow:Event occurrences are emitted as OWL-Time's interval* relations — an
# OWL-Time-aware reasoner then treats the events as their temporal extents
# (time:ProperInterval) and runs interval-algebra inference. Lossy: the events'
# participation lattice, types, locations and standpoints are dropped; only the
# qualitative temporal ordering survives. Each mapping uses DISTINCT variable names
# so its CONSTRUCT template fires only for its own WHERE branch.

gmeow:mapTimeBefore a gmeow:ProjectionMapping ;
    rdfs:label "before → time:intervalBefore"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "beforeA" ;
        gmeow:atom ( [ gmeow:subjectVar "beforeA" ; gmeow:predicate gmeow:before ; gmeow:objectVar "beforeB" ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "owl-time" ; gmeow:relation "<=" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "beforeA" ; gmeow:tPred time:intervalBefore ; gmeow:tObj "beforeB" ] ) ] .

