gmeow:gtsProducerMathBundle
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the math bundle"@x-gmeow-english ;
    skos:definition "The math producer's on-demand bundle. A whole-artifact deliverable with no rep registry of its own, so one declared medium governs every frame."@x-gmeow-english ;
    gmeow:producerCallSite "crates/math/src/lib.rs" ;
