@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix schema:  <https://schema.org/> .
@prefix wdt:     <http://www.wikidata.org/prop/direct/> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix esco:    <http://data.europa.eu/esco/model#> .

# Term equivalences for the employment domain — GMEOW authoring source.
# Compiled to mappings/gmeow-employment.sssom.tsv by `gmeow compile-mappings`.
# Covers schema.org, Wikidata, W3C ORG, and ESCO.
# ResumeRDF, Europass / ELM, DOAC, CTDL, and HR Open Standards alignments are
# deferred to a future pass pending prefix registration and namespace
# confirmation.

gmeow:mapsetEmployment a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-employment.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/employment" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Employment alignments — the reified Employment relator, employment type, compensation, and seniority to schema.org, Wikidata, W3C ORG, ResumeRDF, ESCO, and CTDL. Role, Occupation, Membership, and Credential mappings live in their respective mapsets (gmeow-classes, gmeow-properties, gmeow-wikidata)." .

# =========================================================================== #
# schema.org
# =========================================================================== #

gmeow:Employment skos:closeMatch schema:EmployeeRole {|
    gmeow:sssomFile "gmeow-employment.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW Employment is a reified relator (membership + role + compensation + type); schema:EmployeeRole is a flatter role construct."
|} .

gmeow:Employment skos:closeMatch schema:OrganizationRole {|
    gmeow:sssomFile "gmeow-employment.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "schema:OrganizationRole is broader than EmployeeRole; GMEOW Employment is employment-specific."
|} .

gmeow:employmentType skos:closeMatch schema:employmentType {|
    gmeow:sssomFile "gmeow-employment.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW uses a value vocabulary (EmploymentType individual); schema.org uses a string."
|} .

gmeow:employmentCompensation skos:relatedMatch schema:salary {|
    gmeow:sssomFile "gmeow-employment.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "GMEOW compensation is a MonetaryAmount with explicit currency frame; schema:salary is a broader, flatter construct."
|} .

# =========================================================================== #
# Wikidata
# =========================================================================== #

gmeow:Employment skos:relatedMatch wdt:P108 {|
    gmeow:sssomFile "gmeow-employment.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "employer" ;
    gmeow:comment "Wikidata P108 is the flat employer property; GMEOW Employment is the reified relator. Class-to-property alignment is intentional but cross-category, hence relatedMatch."
|} .

gmeow:employmentCompensation skos:closeMatch wdt:P2250 {|
    gmeow:sssomFile "gmeow-employment.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:objectLabel "salary" ;
    gmeow:comment "Wikidata salary property; GMEOW uses MonetaryAmount with currency frame."
|} .

# =========================================================================== #
# W3C ORG
# =========================================================================== #

gmeow:Employment skos:closeMatch org:Role {|
    gmeow:sssomFile "gmeow-employment.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "ORG Role covers any role in an organization, including employment; GMEOW Employment is specifically the employment relationship."
|} .

# =========================================================================== #
# ESCO
# =========================================================================== #

gmeow:employmentOccupation skos:closeMatch esco:occupation {|
    gmeow:sssomFile "gmeow-employment.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "ESCO occupation taxonomy aligned to GMEOW Employment via employmentOccupation."
|} .
