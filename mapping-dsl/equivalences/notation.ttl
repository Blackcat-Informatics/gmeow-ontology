@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix schema:  <https://schema.org/> .
@prefix wd:      <http://www.wikidata.org/entity/> .
@prefix wdt:     <http://www.wikidata.org/prop/direct/> .

# Term equivalences for the notation and symbolic systems domain — GMEOW authoring source.
# Compiled to mappings/gmeow-notation.sssom.tsv by `gmeow compile-mappings`.
#
# Boundary note: SymbolicSystem and NotationSystem are GMEOW-specific constructs
# that do not map cleanly to surface vocabularies. schema.org has no dedicated
# class for notation systems; SKOS has no direct equivalent. The mappings below
# are broad-brush alignments for discovery, not equivalence claims.

gmeow:mapsetNotation a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-notation.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/notation" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Notation and symbolic system alignments — SKOS, schema.org, Wikidata.
    gmeow:SymbolicSystem and gmeow:NotationSystem are registry-independent, first-class
    information objects. No maintained external vocabulary covers them faithfully;
    the mappings here are broad-brush discovery links. Domain-specific notations
    (mathematical, musical, cryptographic) are aligned to Wikidata items by reference.
    The reified gmeow:NotationSystemUsage relator is canonical — no 1:1 SSSOM claim
    exists for it.""" .

# SymbolicSystem — broad umbrella
gmeow:eqNotation001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SymbolicSystem ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject schema:DefinedTermSet ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "schema.org DefinedTermSet is a set of defined terms — broader and flatter than SymbolicSystem, but the closest surface concept." ;
    gmeow:sssomFile "gmeow-notation.sssom.tsv" .

gmeow:eqNotation002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SymbolicSystem ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q80071 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "Wikidata 'symbol' (Q80071) — the general concept of a symbol, not a specific system; related match only." ;
    gmeow:sssomFile "gmeow-notation.sssom.tsv" .

# NotationSystem — structured symbol system
gmeow:eqNotation003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:NotationSystem ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q2001982 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Wikidata 'notation' (Q2001982) — a system of symbols to represent facts or quantities; a close related match." ;
    gmeow:sssomFile "gmeow-notation.sssom.tsv" .

# WritingSystem — already mapped in languages.ttl; bridge here for completeness
gmeow:eqNotation004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:WritingSystem ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q8192 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Duplicate of languages mapping for boundary clarity: WritingSystem ↔ Wikidata 'writing system' (Q8192)." ;
    gmeow:sssomFile "gmeow-notation.sssom.tsv" .

# Mathematical notation
gmeow:eqNotation005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:symbolicKindMathematical ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q1140046 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Mathematical notation (Wikidata Q1140046)." ;
    gmeow:sssomFile "gmeow-notation.sssom.tsv" .

# Musical notation
gmeow:eqNotation006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:symbolicKindMusical ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q233861 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Musical notation (Wikidata Q233861)." ;
    gmeow:sssomFile "gmeow-notation.sssom.tsv" .

# Stenography / shorthand
gmeow:eqNotation007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:symbolicKindStenographic ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q181066 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Shorthand / stenography (Wikidata Q181066)." ;
    gmeow:sssomFile "gmeow-notation.sssom.tsv" .

# Cryptography
gmeow:eqNotation008 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:symbolicKindCryptographic ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q8789 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Cryptography (Wikidata Q8789) — broader than notation, but the closest match." ;
    gmeow:sssomFile "gmeow-notation.sssom.tsv" .
