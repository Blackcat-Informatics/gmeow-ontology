@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <https://example.org/inquiry-wording/> .

ex:keys a gmeow:Question ;
    rdfs:label "Keys question"@x-gmeow-english ;
    gmeow:questionType gmeow:typeWh ;
    gmeow:questionText "Where are the keys?"@x-gmeow-english,
                       "In which place are the keys?"@x-gmeow-english--ltr .
