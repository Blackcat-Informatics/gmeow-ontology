      <termEntry id="c-8aa1b04ba0a7af29">
        <langSet xml:lang="en">
          <tig>
            <term>GMEOW Rights &amp; IP Module</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Module GMEOW Droits et propriété intellectuelle</term>
