-        // of time — see `reasoning_tool!`.
-        let entry: (&'static str, ToolHandler) = if $segments.serves(name) {
-            (
-                name,
-                Box::new(|s: &McpServer, a: &Value| s.$method(a)) as ToolHandler,
-            )
-        } else {
