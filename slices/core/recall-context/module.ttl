@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:prescriptionKindContextPlan
    a logic:PrescriptionKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "context plan"@x-gmeow-english ;
    skos:definition "A prescription kind whose precomposed recall operations assemble context when a condition on the agent’s situation holds. The agent does not choose these steps at run time."@x-gmeow-english ;
    gmeow:useWhen "Use to record context plan within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from prescriptionKindContextPlan alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit prescriptionKindContextPlan value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:prescriptionKindContextPlan explicitly."@x-gmeow-english .

gmeow:RecallScope
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:label "Recall Scope"@x-gmeow-english ;
    skos:definition "A recall scope specification anchored to an identified attention slot, describing which related records an operation requests."@x-gmeow-english ;
    gmeow:useWhen "Use to record Recall Scope within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from RecallScope alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit RecallScope value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:RecallScope explicitly."@x-gmeow-english .

gmeow:RecallDepth
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf logic:QualityValue ;
    rdfs:label "Recall Depth"@x-gmeow-english ;
    skos:definition "An open vocabulary of explicitly selected retrieval capability profiles. Selecting a depth requires its declared capabilities; absence never selects a weaker profile."@x-gmeow-english ;
    gmeow:useWhen "Use to record Recall Depth within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from RecallDepth alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit RecallDepth value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:RecallDepth explicitly."@x-gmeow-english .

gmeow:recallDepthQuick
    a gmeow:RecallDepth ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "quick recall depth"@x-gmeow-english ;
    skos:definition "The selected profile recalls attended and recent records through lexical retrieval only."@x-gmeow-english ;
    gmeow:useWhen "Use to record quick recall depth within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallDepthQuick alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallDepthQuick value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallDepthQuick explicitly."@x-gmeow-english .

gmeow:recallDepthOrdinary
    a gmeow:RecallDepth ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "ordinary recall depth"@x-gmeow-english ;
    skos:definition "The selected profile searches every declared surface with lexical and nearest-neighbour retrieval and reranking."@x-gmeow-english ;
    gmeow:useWhen "Use to record ordinary recall depth within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallDepthOrdinary alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallDepthOrdinary value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallDepthOrdinary explicitly."@x-gmeow-english .

gmeow:recallDepthDeep
    a gmeow:RecallDepth ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "deep recall depth"@x-gmeow-english ;
    skos:definition "The selected profile includes ordinary recall followed by link expansion and distant-band retrieval; it promises no particular answer."@x-gmeow-english ;
    gmeow:useWhen "Use to record deep recall depth within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallDepthDeep alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallDepthDeep value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallDepthDeep explicitly."@x-gmeow-english .

gmeow:RecollectionForm
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf logic:QualityValue ;
    rdfs:label "Recollection Form"@x-gmeow-english ;
    skos:definition "An open vocabulary describing how recalled material is presented, independently of retrieval depth and confidence."@x-gmeow-english ;
    gmeow:useWhen "Use to record Recollection Form within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from RecollectionForm alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit RecollectionForm value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:RecollectionForm explicitly."@x-gmeow-english .

gmeow:recollectionFormVerbatim
    a gmeow:RecollectionForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "verbatim recollection form"@x-gmeow-english ;
    skos:definition "Present the retained source wording verbatim with its provenance; verbatim does not assert truth."@x-gmeow-english ;
    gmeow:useWhen "Use to record verbatim recollection form within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recollectionFormVerbatim alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recollectionFormVerbatim value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recollectionFormVerbatim explicitly."@x-gmeow-english .

gmeow:recollectionFormSummaryHandle
    a gmeow:RecollectionForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "summary and handle recollection form"@x-gmeow-english ;
    skos:definition "Present a short attributed summary and a resolvable handle to the original record, retaining the original rather than replacing it."@x-gmeow-english ;
    gmeow:useWhen "Use to record summary and handle recollection form within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recollectionFormSummaryHandle alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recollectionFormSummaryHandle value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recollectionFormSummaryHandle explicitly."@x-gmeow-english .

gmeow:RecallOperation
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf logic:ActionSchema , gmeow:InformationObject ;
    rdfs:label "Recall Operation"@x-gmeow-english ;
    skos:definition "One plan-local recall operation schema with its own allocation identity and parameters. Reusing a template twice requires two operation records, each carrying its own share."@x-gmeow-english ;
    gmeow:useWhen "Use to record Recall Operation within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from RecallOperation alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit RecallOperation value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:RecallOperation explicitly."@x-gmeow-english .

gmeow:RecallBudget
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:label "Recall Budget"@x-gmeow-english ;
    skos:definition "A finite plan-local allocation roster whose operation records share one enactment’s token budget. It is not the enactment or a second plan."@x-gmeow-english ;
    gmeow:useWhen "Use to record Recall Budget within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from RecallBudget alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit RecallBudget value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:RecallBudget explicitly."@x-gmeow-english .

gmeow:AttentionSlot
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:label "Attention Slot"@x-gmeow-english ;
    skos:definition "The continuing identity of one agent’s named attention slot. A slot is not a history position and is not itself the record it points to."@x-gmeow-english ;
    gmeow:useWhen "Use to record Attention Slot within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from AttentionSlot alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit AttentionSlot value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:AttentionSlot explicitly."@x-gmeow-english .

gmeow:SlotPosition
    a logic:SubKind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:State ;
    rdfs:label "Slot Position"@x-gmeow-english ;
    skos:definition "An immutable position in one attention slot’s history, holding a pointer to an existing record. It specializes State as a path position rather than a mutable slot."@x-gmeow-english ;
    gmeow:useWhen "Use to record Slot Position within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from SlotPosition alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit SlotPosition value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:SlotPosition explicitly."@x-gmeow-english .

gmeow:SlotAssignmentClaim
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:label "Slot Assignment Claim"@x-gmeow-english ;
    skos:definition "An attributed RDF 1.2 reifier of one slotState assertion. Successor claims name the claims they supersede; records and historical claims are retained."@x-gmeow-english ;
    gmeow:useWhen "Use to record Slot Assignment Claim within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from SlotAssignmentClaim alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit SlotAssignmentClaim value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:SlotAssignmentClaim explicitly."@x-gmeow-english .

gmeow:RecallAnswer
    a logic:Event , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:Activity ;
    rdfs:label "Recall Answer"@x-gmeow-english ;
    skos:definition "The recall activity answering a cue, parenting its retrieval activities and retaining selected records, outcome and completeness. It is not the question or a claim that the returned material is true."@x-gmeow-english ;
    gmeow:useWhen "Use to record Recall Answer within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from RecallAnswer alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit RecallAnswer value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:RecallAnswer explicitly."@x-gmeow-english .

gmeow:RecallOutcome
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf logic:QualityValue ;
    rdfs:label "Recall Outcome"@x-gmeow-english ;
    skos:definition "An open vocabulary of reported recall outcomes, separate from the asker’s judgement and the truth of recalled content."@x-gmeow-english ;
    gmeow:useWhen "Use to record Recall Outcome within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from RecallOutcome alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit RecallOutcome value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:RecallOutcome explicitly."@x-gmeow-english .

gmeow:recallOutcomeRecollections
    a gmeow:RecallOutcome ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "recollections returned"@x-gmeow-english ;
    skos:definition "The recall returned one or more records. This outcome alone does not assert complete search."@x-gmeow-english ;
    gmeow:useWhen "Use to record recollections returned within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallOutcomeRecollections alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallOutcomeRecollections value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallOutcomeRecollections explicitly."@x-gmeow-english .

gmeow:recallOutcomeEmptyComplete
    a gmeow:RecallOutcome ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "complete empty recall"@x-gmeow-english ;
    skos:definition "The declared scope was completely searched and no records were returned. This does not prove absence outside that scope."@x-gmeow-english ;
    gmeow:useWhen "Use to record complete empty recall within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallOutcomeEmptyComplete alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallOutcomeEmptyComplete value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallOutcomeEmptyComplete explicitly."@x-gmeow-english .

gmeow:recallOutcomeDeadline
    a gmeow:RecallOutcome ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "recall deadline reached"@x-gmeow-english ;
    skos:definition "The recall reached its deadline before completing the declared search; already selected records remain retained."@x-gmeow-english ;
    gmeow:useWhen "Use to record recall deadline reached within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallOutcomeDeadline alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallOutcomeDeadline value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallOutcomeDeadline explicitly."@x-gmeow-english .

gmeow:recallOutcomePartial
    a gmeow:RecallOutcome ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "incomplete search"@x-gmeow-english ;
    skos:definition "Some declared search scope was not searched. This is distinct from a complete empty result."@x-gmeow-english ;
    gmeow:useWhen "Use to record incomplete search within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallOutcomePartial alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallOutcomePartial value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallOutcomePartial explicitly."@x-gmeow-english .

gmeow:RecallVerdict
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:label "Recall Verdict"@x-gmeow-english ;
    skos:definition "The asker’s attributed judgement of one recall answer, preserving its exact words independently of search completeness."@x-gmeow-english ;
    gmeow:useWhen "Use to record Recall Verdict within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from RecallVerdict alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit RecallVerdict value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:RecallVerdict explicitly."@x-gmeow-english .

gmeow:RecallVerdictValue
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf logic:QualityValue ;
    rdfs:label "Recall Verdict Value"@x-gmeow-english ;
    skos:definition "An open vocabulary for the asker’s found, partly, not-found or wrong judgement. These values neither rank people nor determine objective truth."@x-gmeow-english ;
    gmeow:useWhen "Use to record Recall Verdict Value within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from RecallVerdictValue alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit RecallVerdictValue value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:RecallVerdictValue explicitly."@x-gmeow-english .

gmeow:recallVerdictFound
    a gmeow:RecallVerdictValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "found recall verdict"@x-gmeow-english ;
    skos:definition "The asker reports that the recall answer found what they sought."@x-gmeow-english ;
    gmeow:useWhen "Use to record found recall verdict within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallVerdictFound alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallVerdictFound value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallVerdictFound explicitly."@x-gmeow-english .

gmeow:recallVerdictPartly
    a gmeow:RecallVerdictValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "partly found recall verdict"@x-gmeow-english ;
    skos:definition "The asker reports that the recall answer found only part of what they sought."@x-gmeow-english ;
    gmeow:useWhen "Use to record partly found recall verdict within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallVerdictPartly alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallVerdictPartly value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallVerdictPartly explicitly."@x-gmeow-english .

gmeow:recallVerdictNotFound
    a gmeow:RecallVerdictValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "not-found recall verdict"@x-gmeow-english ;
    skos:definition "The asker reports that the recall answer did not find what they sought, without asserting complete search."@x-gmeow-english ;
    gmeow:useWhen "Use to record not-found recall verdict within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallVerdictNotFound alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallVerdictNotFound value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallVerdictNotFound explicitly."@x-gmeow-english .

gmeow:recallVerdictWrong
    a gmeow:RecallVerdictValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "wrong recall verdict"@x-gmeow-english ;
    skos:definition "The asker judges the recall answer to be wrong; this remains that asker’s attributed judgement."@x-gmeow-english ;
    gmeow:useWhen "Use to record wrong recall verdict within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from recallVerdictWrong alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit recallVerdictWrong value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:recallVerdictWrong explicitly."@x-gmeow-english .

gmeow:contextPlanCondition
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    logic:domain logic:Plan ;
    logic:range logic:Situation ;
    rdfs:label "context plan condition"@x-gmeow-english ;
    skos:definition "The situation condition under which a precomposed context plan is selected, without asserting that it currently obtains."@x-gmeow-english ;
    gmeow:useWhen "Use to record context plan condition within an attributed recall context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring successful execution, access permission or a preferred claim from contextPlanCondition alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the explicit contextPlanCondition value with its source, scope and record identity."@x-gmeow-english ;
    skos:example "The record names gmeow:contextPlanCondition explicitly."@x-gmeow-english .

gmeow:recallScope
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    logic:domain logic:ActionSchema ;
    logic:range gmeow:RecallScope ;
    rdfs:label "recall scope"@x-gmeow-english ;
    skos:definition "The explicit record scope requested by this recall schema, anchored through its scope slot."@x-gmeow-english ;
    gmeow:useWhen "Use to record recall scope within an attributed recall context."@x-gmeow-english ;
