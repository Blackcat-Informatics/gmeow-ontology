+fn admission_of(text: &str) -> SourceAdmission {
+    let theory = PreparedLogicSource::new(&parse_turtle(text))
+        .unwrap()
+        .into_compiled(None)
+        .unwrap();
+    SourceAdmission::classical_fof(&theory, SourceSelection::all_classical_roots(&theory))
