+        let error = super::closure::admit_leaf(&address, &leaf.bytes, &worlds).unwrap_err();
+        assert!(
+            error
+                .message()
+                .contains("outside the authenticated world catalog"),
+            "{error}"
+        );
+    }
 }
 
