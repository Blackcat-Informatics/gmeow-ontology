    [ a owl:Restriction ; owl:onProperty math:targetSpace ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:embeddingFunction ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:embeddingModel ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

