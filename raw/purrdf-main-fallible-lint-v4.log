+    diagnostic.inner_mut().observed = Some(gmeow_errors::Slot::typed(
+        serde_json::to_string(inputs).expect("input identities serialize"),
+        "https://blackcatinformatics.ca/gmeow/SelectedInputIdentitiesJson",
+    ));
+    diagnostic
