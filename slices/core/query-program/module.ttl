logic:argument [ logic:termIndex 0 ; logic:termVariable "rightOwner" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ] ] ;
logic:consequent [ a logic:Formula ;
logic:relation logic:termEqual ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "leftOwner" ], [ logic:termIndex 1 ; logic:termVariable "rightOwner" ] ] ] ] ] ] .

gmeow:QueryRerankPositionUniquenessLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank position uniqueness law"@x-gmeow-english ;
    skos:definition "Within one rerank answer, equal reported output positions identify the same entry, and equal original union positions separately identify the same entry. Source positions remain unique without renumbering."@x-gmeow-english ;
