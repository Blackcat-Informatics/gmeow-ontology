    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:not gmeow:rocEx .
gmeow:rocEx a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "raw-math-result witness existential"@x-gmeow-english ;
    skos:definition "The forbidden-witness existential of gmeow:ResultObjectConflationConstraint: a result ?r the computation produces whose type ?k is in the math: namespace — the conflation the negation rules out."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "r" ] ,
