@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .

@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix mo: <http://purl.org/ontology/mo/> .
@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix mimo: <http://www.mimo-db.eu/InstrumentsKeywords/> .
@prefix mbz: <https://musicbrainz.org/> .
@prefix discogs: <https://www.discogs.com/> .

# Music slice alignments.
# Compiled to mappings/gmeow-music.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetMusic a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-music.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/music" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Music extension alignments to external music ontologies, symbolic encoding standards, and Wikidata. All bridges are by reference (Principle 5)." .

# --------------------------------------------------------------------------- #
# Wikidata — pitch / tuning terms (pitch frames)
# --------------------------------------------------------------------------- #

gmeow:eqMu001 a gmeow:TermEquivalence ;
    rdfs:label "TuningSystem ↔ Wikidata Q723441"@x-gmeow-english ;
    skos:definition "Maps the GMEOW TuningSystem class to Wikidata 'musical tuning' (Q723441). The Wikidata sense is broader than the GMEOW reference-frame view."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    gmeow:alignSubject gmeow:TuningSystem ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q723441 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Wikidata 'musical tuning' (Q723441) — broader than the GMEOW reference-frame view." ;
    gmeow:sssomFile "gmeow-music.sssom.tsv" .

