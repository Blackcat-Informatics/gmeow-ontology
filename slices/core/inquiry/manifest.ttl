@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/inquiry>
    a gmeow:Slice ;
    rdfs:label "inquiry"@x-gmeow-english ;
    skos:definition "The inquiry slice of the GMEOW ontology (core tier): GMEOW Inquiry Module — erotetic content, introducing gmeow:Question as the third content sibling of gmeow:Proposition (assertoric) and gmeow:Goal (optative), individuated by its answerhood condition rather than a truth- or satisfaction-condition. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inquiry> ;
    dcterms:title "GMEOW Inquiry Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/epistemics> ,
        <https://blackcatinformatics.ca/gmeow/slices/standpoint> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:sliceProfile "claims" , "memory" ;
    gmeow:sliceConsumer "Agent memory of open problems / what it is trying to find out (Principle 14); recall surfaces open inquiries; abduction answers typeWhy questions; the metacognition slice's known-unknowns mint Questions; loaded-question detection bridges the deception slice."@x-gmeow-english .
