ex:ecGmnEnvelopeMissingField a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/gmn-envelope-missing-field.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.QualifiedMinCountConstraintComponent" ;
    gmeow:conformanceRationale "The gmeow:GmnEnvelope omits exactly one of its nine contract fields — the gmeow:gmnSecurityRing boundary ring — so validation MUST emit shacl.QualifiedMinCountConstraintComponent and NO other finding (lang:GmnMissingEnvelopeField); the other eight fields are present. The ring obligation is a CLASS-QUALIFIED one on the derived gmeow:GmnEnvelope-shape (sh:qualifiedValueShape [ sh:class gmeow:GmnSecurityRing ] with sh:qualifiedMinCount 1), so its absence is reported as a qualified minimum rather than a bare sh:minCount." .

ex:ecGmnEnvelopeDictionaryVersionPlural a gmeow:ExampleConformance ;
