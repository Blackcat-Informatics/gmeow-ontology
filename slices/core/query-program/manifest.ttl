<https://blackcatinformatics.ca/gmeow/slices/query-program>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:sliceTier gmeow:tierCore ;
    rdfs:label "query program"@x-gmeow-english ;
    skos:definition "Canonical descriptions and evidence records for consumer-owned query graphs, fusion, loss-preserving merge, verdict choice and stratified feedback."@x-gmeow-english ;
    dcterms:title "GMEOW Query Program Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Governed query stores and memory retrieval adapters describing their program graphs and source-reported outcomes."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceDependsOn <https://blackcatinformatics.ca/gmeow/slices/logic>,
        <https://blackcatinformatics.ca/gmeow/slices/kernel>,
        <https://blackcatinformatics.ca/gmeow/slices/documents>,
