    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "controlPointTimePositionNumerator is functional"@x-gmeow-english ;
