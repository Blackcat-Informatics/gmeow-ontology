@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/org> a align:Alignment ;
    rdfs:label "GMEOW → org (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "memberOf → org:memberOf"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:memberOf ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri org:memberOf ] ;
            align:relation "=" ;
            edoal:measure 9.5e-01 ],
        [ a align:Cell ;
            rdfs:label "Membership relator → org:Membership (member/organization/role)"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Membership ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri org:Membership ] ;
            align:relation "=" ;
            edoal:measure 9.5e-01 ],
        [ a align:Cell ;
            rdfs:label "Organization → org:FormalOrganization"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Organization ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri org:FormalOrganization ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "Role → org:Role"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Role ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri org:Role ] ;
            align:relation "=" ;
            edoal:measure 9.5e-01 ],
        [ a align:Cell ;
            rdfs:label "subOrganizationOf → org:subOrganizationOf"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:subOrganizationOf ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri org:subOrganizationOf ] ;
            align:relation "=" ;
            edoal:measure 9.5e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "org" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
