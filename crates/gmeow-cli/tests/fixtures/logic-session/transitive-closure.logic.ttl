# A finite positive binary Datalog program: the reflexive-free transitive closure
# `reach` over an `edge` relation. This is squarely inside the incrementally-certified
# fragment the ReasoningSession façade maintains, so every `apply` over it is a genuine
# incremental `Applied` operation (never a routed full rebuild).
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://example.org/session/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# reach(?x, ?y) :- edge(?x, ?y) .
_:rule5f66aa70S3_x a logic:TermCarrier ; logic:termVariable "x" .
_:rule5f66aa70S3_y a logic:TermCarrier ; logic:termVariable "y" .
ex:reachBase a logic:Rule ;
    logic:head [ rdf:reifies <<( _:rule5f66aa70S3_x ex:reach _:rule5f66aa70S3_y )>> ] ;
    logic:body [ rdf:reifies <<( _:rule5f66aa70S3_x ex:edge _:rule5f66aa70S3_y )>> ] .

# reach(?x, ?z) :- edge(?x, ?y), reach(?y, ?z) .
_:rule5f66aa70S4_x a logic:TermCarrier ; logic:termVariable "x" .
_:rule5f66aa70S4_z a logic:TermCarrier ; logic:termVariable "z" .
_:rule5f66aa70S4_y a logic:TermCarrier ; logic:termVariable "y" .
ex:reachStep a logic:Rule ;
    logic:head [ rdf:reifies <<( _:rule5f66aa70S4_x ex:reach _:rule5f66aa70S4_z )>> ] ;
    logic:body [ rdf:reifies <<( _:rule5f66aa70S4_x ex:edge _:rule5f66aa70S4_y )>> ] ,
               [ rdf:reifies <<( _:rule5f66aa70S4_y ex:reach _:rule5f66aa70S4_z )>> ] .
