    gmeow:avoidWhen "Avoid treating every dream record as DreamReport, actual Experience or proof that a dream occurred."@x-gmeow-english ;
    gmeow:howToUse "Supply actual lens/domain, state/solitude anchor, source dream-kind role and source order/frame without creating missing entries."@x-gmeow-english ;
    skos:scopeNote "The request selects retained records, not a dream-generation or phenomenal-character verdict."@x-gmeow-english ;
    skos:example "Dream entries remain records in the supplied view without being retyped as experiences."@x-gmeow-english .

gmeow:recallScopeHolderMood
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
