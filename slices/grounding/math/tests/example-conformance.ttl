# Topology: continuity declared, not assumed.
ex:ecContinuousMapDeclared a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/continuous-map-declared.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:ContinuousMap declaring math:isContinuous satisfies math:ContinuousMapShape and validates with no findings." .

ex:ecMapContinuityAssumed a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/map-continuity-assumed.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example omits math:isContinuous on a math:ContinuousMap (sh:minCount 1 on math:ContinuousMapShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:UndeclaredTopologicalProperty)." .

# Geometry: manifold framing and chart dimension-consistency.
ex:ecManifoldStructured a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/manifold-structured.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:SmoothManifold declaring math:manifoldDimension and math:manifoldStructureKind satisfies math:ManifoldShape and validates with no findings." .

ex:ecManifoldMissingStructureKind a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/manifold-missing-structure-kind.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example omits math:manifoldStructureKind on a math:Manifold that declares its dimension (sh:minCount 1 on math:ManifoldShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:UnderspecifiedManifold)." .

ex:ecChartConsistent a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/chart-dimension-consistent.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:Chart naming its domain, coordinate map, and target space, whose target math:spaceDimension equals its manifold's math:manifoldDimension, satisfies math:ChartShape and math:ChartDimensionShape and validates with no findings." .

ex:ecChartDimensionMismatch a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/chart-dimension-mismatch.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.SPARQLConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example's chart maps a dimension-2 manifold into a dimension-3 target (the SPARQL constraint of math:ChartDimensionShape); every property is present so only the dimension gate bites, and validation MUST emit shacl.SPARQLConstraintComponent and NO other finding (math:DimensionMismatch)." .

ex:ecMetricSignatureConsistent a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/metric-signature-consistent.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A Lorentzian 4-manifold whose math:MetricTensor carries a math:MetricSignature of (3, 1) — math:signaturePositive + math:signatureNegative = 4 equals math:manifoldDimension and exactly one direction is timelike — satisfies math:MetricSignatureDimensionShape and validates with no findings." .

ex:ecMetricSignatureDimensionMismatch a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/metric-signature-dimension-mismatch.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.SPARQLConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example's metric signature (3, 2) sums to 5 on a dimension-4 manifold (the p + q SPARQL constraint of math:MetricSignatureDimensionShape), so validation MUST emit shacl.SPARQLConstraintComponent (math:DimensionMismatch)." .

# Algebraic topology: a homology group is a fully-framed abelian group.
ex:ecHomologyGroupFramed a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/homology-group-framed.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:HomologyGroup — a subclass of math:AbelianGroup — declaring its math:underlyingSet, math:structureOperation, and a math:satisfiesAxiom satisfies the inherited math:AlgebraicStructureShape and validates with no findings." .
