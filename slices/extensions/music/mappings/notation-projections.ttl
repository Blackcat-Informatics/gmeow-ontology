    rdfs:label "MEI ↔ Wikidata Q6808199"@x-gmeow-english ;
    skos:definition "Maps the GMEOW MEI notation individual to Wikidata 'Music Encoding Initiative' (Q6808199)."@x-gmeow-english ;
