@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix bibframe: <http://id.loc.gov/ontologies/bibframe/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Creative-works WEMI spine alignments.
# Compiled to mappings/gmeow-creative-works.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetCreativeWorks a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/creative-works" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "WEMI spine alignments to FRBRcore, FaBiO, LRMoo, CIDOC-CRM, BIBFRAME, schema.org, and Wikidata. GMEOW rebuilds the distinction natively and bridges by reference (Principle 5)." .

# --------------------------------------------------------------------------- #
# FRBRcore — the canonical WEMI vocabulary
# --------------------------------------------------------------------------- #

gmeow:eqCw001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Work ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject frbr:Work ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "FRBR Work — abstract intellectual creation." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Expression ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject frbr:Expression ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "FRBR Expression — realization in language/notation." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Manifestation ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject frbr:Manifestation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "FRBR Manifestation — edition/format/release." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Item ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject frbr:Item ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "FRBR Item — single exemplar." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:realizes ;
    gmeow:alignPredicate owl:equivalentProperty ;
    gmeow:alignObject frbr:realization ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "Expression realizes Work." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:embodies ;
    gmeow:alignPredicate owl:equivalentProperty ;
    gmeow:alignObject frbr:embodiment ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "Manifestation embodies Expression." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:exemplifies ;
    gmeow:alignPredicate owl:equivalentProperty ;
    gmeow:alignObject frbr:exemplar ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "Item exemplifies Manifestation." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

# --------------------------------------------------------------------------- #
# FaBiO — SPAR ontologies for scholarly works
# --------------------------------------------------------------------------- #

gmeow:eqCw008 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Work ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject fabio:Work ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "FaBiO Work is scholarly-publication-scoped; GMEOW Work is universal." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw009 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Expression ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject fabio:Expression ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "FaBiO Expression is scholarly-scoped." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw010 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Manifestation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject fabio:Manifestation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "FaBiO Manifestation is scholarly-scoped." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw011 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Item ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject fabio:Item ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "FaBiO Item is scholarly-scoped." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

