gmeow:QueryRerankEntryUniquenessLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank entry uniqueness law"@x-gmeow-english ;
    skos:definition "Two entries of one rerank answer naming the same original candidate must be the same occurrence resource. Together with complete candidate accounting, this gives one outcome occurrence per input candidate."@x-gmeow-english ;
    gmeow:useWhen "Use to reject duplicate outcome occurrences for one candidate within a result."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid applying this within-answer identity rule to candidates retained by different answers or to shared quantitative score resources."@x-gmeow-english ;
    gmeow:howToUse "Bind two entries of the same answer and their common rerankEntryCandidate, then compare entry identities through logic:termEqual."@x-gmeow-english ;
    skos:scopeNote "Equal score values or passages do not identify different candidates, and the same candidate may have another occurrence in another result."@x-gmeow-english ;
    skos:example "One occurrence for one candidate: ex:answer gmeow:rerankEntry ex:e . ex:e gmeow:rerankEntryCandidate ex:c ."@x-gmeow-english ;
    logic:formalizes gmeow:rerankEntry ;
    logic:message "Two entries of one rerank answer naming the same original candidate must be the same occurrence resource. Together with complete candidate accounting, this gives one outcome occurrence per input candidate." ;
    logic:integrity [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "left" ], [ logic:termIndex 2 ; logic:termVariable "right" ], [ logic:termIndex 3 ; logic:termVariable "candidate" ] ;
logic:forall [ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryRerankAnswer ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankEntry ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "left" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankEntry ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "right" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankEntryCandidate ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "left" ], [ logic:termIndex 1 ; logic:termVariable "candidate" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankEntryCandidate ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "right" ], [ logic:termIndex 1 ; logic:termVariable "candidate" ] ] ] ;
logic:consequent [ a logic:Formula ;
logic:relation logic:termEqual ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "left" ], [ logic:termIndex 1 ; logic:termVariable "right" ] ] ] ] .

gmeow:QueryRerankEntryOwnerLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank entry owner law"@x-gmeow-english ;
    skos:definition "Every rerank entry belongs to exactly one rerank answer. Its source and output positions are local to that answer’s sequences, so another answer requires a separate occurrence."@x-gmeow-english ;
    gmeow:useWhen "Use to prevent one outcome occurrence from borrowing two result or original-input contexts."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid imposing unique inverse ownership on candidate identities, score quantities, authority records or retained losses."@x-gmeow-english ;
    gmeow:howToUse "Require a fresh existing typed answer owner and compare any pair of answer links to the entry through logic:termEqual."@x-gmeow-english ;
    skos:scopeNote "The Formula uses one outer universal, a joined owner existential and a guarded owner-pair implication. It introduces no positive nested universal and no global ownership rule beyond entries."@x-gmeow-english ;
    skos:example "A single owning sequence: ex:answer gmeow:rerankEntry ex:e . ex:e a gmeow:QueryRerankEntry ."@x-gmeow-english ;
    logic:formalizes gmeow:QueryRerankEntry ;
    logic:message "Every rerank entry belongs to exactly one rerank answer. Its source and output positions are local to that answer’s sequences, so another answer requires a separate occurrence." ;
    logic:integrity [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "leftOwner" ], [ logic:termIndex 2 ; logic:termVariable "rightOwner" ] ;
