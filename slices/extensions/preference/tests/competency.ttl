# --- CQ / cq-cross-slice-compose-semantic-topology -------------------------- #
ex:cqCrossSliceComposeSemanticTopology a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-cross-slice-compose-semantic-topology.rq" ;
    gmeow:cqDataFile "tests/data/multi-context-winner.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqCrossSliceComposeSemanticTopologyShape ;
    gmeow:cqRationale "GMEOW must answer 'does the preference slice reuse the semantic-topology H0/H1 gluing picture by reference?' (Principle 16, the gmeow:DisagreementObstruction ~ gmeow:TopologyClaim twin). The multi-context-winner fixture holds two independent claims, each binding its own gmeow:ConsensusSection wrapping a math:GlobalSection (H0) and its own gmeow:DisagreementObstruction wrapping a math:GluingObstruction (H1). Joined through the shared claim, the asserted answer is exactly two rows (consensus₁/obstruction₁, consensus₂/obstruction₂). A Cartesian-product query (the pre-fix bug) would cross-pair consensus₁ with obstruction₂ and return four rows; RowsExact=2 is therefore probative." ;
    gmeow:cqExpectRow ex:cqCrossSliceComposeSemanticTopologyRow1 , ex:cqCrossSliceComposeSemanticTopologyRow2 .
ex:cqCrossSliceComposeSemanticTopologyShape a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "consensus" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "globalSection" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "obstruction" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn [ logic:columnVariable "gluingObstruction" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqCrossSliceComposeSemanticTopologyRow1 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "consensus" ; gmeow:cellValueIri exd:consensus1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "globalSection" ; gmeow:cellValueIri exd:h0a ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "obstruction" ; gmeow:cellValueIri exd:obstruction1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "gluingObstruction" ; gmeow:cellValueIri exd:h1a ] .
ex:cqCrossSliceComposeSemanticTopologyRow2 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "consensus" ; gmeow:cellValueIri exd:consensus2 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "globalSection" ; gmeow:cellValueIri exd:h0b ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "obstruction" ; gmeow:cellValueIri exd:obstruction2 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "gluingObstruction" ; gmeow:cellValueIri exd:h1b ] .
