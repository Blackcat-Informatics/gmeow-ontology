#
# Fail-witness for ex:saNoSecondBudget: a local step limit, whose exhaustion the
# engine would never see, making any completeness claim against it unfounded.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

gmeow:frontierMaxSteps a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/work-orchestration> .
