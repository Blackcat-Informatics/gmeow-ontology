{
  "$defs": {
    "diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "note"
      ],
      "type": "object"
    },
    "entailment": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "type": "string"
        },
        "premises": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule": {
          "type": "string"
        }
      },
      "required": [
        "rule",
        "conclusion",
        "premises"
      ],
      "type": "object"
    },
    "fixture": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "body"
      ],
      "type": "object"
    },
    "loss": {
      "additionalProperties": false,
      "properties": {
        "preservation": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "target",
        "preservation"
      ],
      "type": "object"
    }
  },
  "$id": "https://blackcatinformatics.ca/gmeow/schemas/card.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The neutral, pre-resolved term card the docs `card.json` member and the live MCP `doc_card format=json` tool serialize.",
  "properties": {
    "aligns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "avoid_for_consumer": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "avoid_when": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "box_roles": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "category": {
      "description": "The vocabulary category (Class, Property, Individual, Datatype, Term).",
      "type": "string"
    },
    "definition": {
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "type": "array"
    },
    "domain": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "entailments": {
      "items": {
        "$ref": "#/$defs/entailment"
      },
      "type": "array"
    },
    "examples": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "fixtures_do": {
      "items": {
        "$ref": "#/$defs/fixture"
      },
      "type": "array"
    },
    "fixtures_dont": {
      "items": {
        "$ref": "#/$defs/fixture"
      },
      "type": "array"
    },
    "how_to_use": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "iri": {
      "description": "The full term IRI.",
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "logic_stereotypes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "loss": {
      "items": {
        "$ref": "#/$defs/loss"
      },
      "type": "array"
    },
    "parents": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "python_model": {
      "description": "The importable dotted path gmeow_models.<slice>.<Class> of the generated Pydantic model for a class term (the term→model link).",
      "type": "string"
    },
    "python_snippet": {
      "description": "A compact Pydantic import + model_validate snippet for a class term.",
      "type": "string"
    },
    "range": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "related_terms": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "scope_notes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "slice": {
      "type": "string"
    },
    "use_for_consumer": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "use_when": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "category",
    "iri"
  ],
  "title": "GMEOW term card",
  "type": "object"
}
