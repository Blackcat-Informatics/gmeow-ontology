      <termEntry id="c-35148337d18ef49f">
        <langSet xml:lang="en">
          <tig>
            <term>The failure raised when a cellular sheaf lacks its base complex, stalks, or restriction maps.</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>L'échec levé quand un faisceau manque son complexe de base, ses germes ou ses restrictions.</term>
