# Gate 5 (ambiguity survives the pipeline): "saw her duck" enters an engine
# interpretation act that produces TWO co-resident readings — reading A analyses
# "duck" as the bird (a nominal head), reading B as the crouch action (a verbal
# head) — each a DISTINCT lang:ComposedForm scoped to its own lang:Analysis, with
# its own gmeow:vantage and lang:denotationContext. NEITHER is selected as
# lang:resolvedReading: there is no silent winner. The interpretation act names its
# engine through lang:interpretationEngine, so each produced reading is a vantage-
# held claim (never unattributed structure). No stage collapses the two readings.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

ex:english a lang:SignSystem .

# The surface "saw her duck" and its two co-resident structural analyses.
ex:sawHerDuck a lang:UnanalyzedProse ; lang:inSignSystem ex:english ;
    lang:surfaceText "saw her duck" ; lang:inScript ex:latin ;
    lang:unicodeNormalization "NFC" ; lang:collationLocale "en" ;
    lang:analysisLevel lang:rawLevel .

# Reading A: "duck" is the waterfowl — the parse scoped to analysis "duck-as-bird".
ex:analysisBird a lang:Analysis .
ex:formBird a lang:ComposedForm ; lang:inSignSystem ex:english ;
    lang:inAnalysis ex:analysisBird .

# Reading B: "duck" is the crouch action — the parse scoped to analysis "duck-as-crouch".
ex:analysisCrouch a lang:Analysis .
ex:formCrouch a lang:ComposedForm ; lang:inSignSystem ex:english ;
    lang:inAnalysis ex:analysisCrouch .

# The engine's two vantage-held readings — each holds its own denotation context.
ex:readingBird a lang:Reading ; lang:readingOf ex:formBird ;
    gmeow:vantage ex:engineVantage ;
    lang:denotationContext ex:ctx ;
    logic:confidence "0.55"^^xsd:double .
ex:readingCrouch a lang:Reading ; lang:readingOf ex:formCrouch ;
    gmeow:vantage ex:engineVantage ;
    lang:denotationContext ex:ctx ;
    logic:confidence "0.45"^^xsd:double .

# The engine run: an interpretation act attributing both readings to the engine.
# It selects NO lang:resolvedReading — the ambiguity is the shape of the data.
ex:act a lang:InterpretationAct ;
    lang:interpretedForm ex:sawHerDuck ;
    lang:interpretationEngine ex:udParser ;
    lang:producedReading ex:readingBird , ex:readingCrouch .
