gmeow:queryAdmissionContract
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query admission contract"@x-gmeow-english ;
    skos:definition "The explicitly selected consumer admission contract for a graph or feedback description, not evidence that execution occurred."@x-gmeow-english ;
    gmeow:useWhen "Use for query admission contract with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "ex:record gmeow:queryAdmissionContract ex:value ."@x-gmeow-english ;
    logic:range logic:ReasoningContract .

gmeow:fusionTieOrder
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query fusion stable tie order"@x-gmeow-english ;
    skos:definition "A source-stable nonnegative ordinal, unique within the fusion output. Equal-score candidates are displayed in ascending ordinal without changing their equal scores."@x-gmeow-english ;
    gmeow:useWhen "Use for query fusion stable tie order with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "A source-stable nonnegative ordinal, unique within the fusion output. Equal-score candidates are displayed in ascending ordinal without changing their equal scores. Example declaration: gmeow:fusionTieOrder rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ."@x-gmeow-english ;
    logic:domain gmeow:QueryFusionScore ;
    logic:range xsd:nonNegativeInteger .

gmeow:QueryProgramGraph logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:queryAdmissionContract ; logic:allValuesFrom logic:ReasoningContract ], [ a logic:Restriction ; logic:onProperty gmeow:queryAdmissionContract ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:ReasoningContract ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryProgramGraph ; logic:closureKey "https://blackcatinformatics.ca/gmeow/queryAdmissionContract" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryFusionScore logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:fusionTieOrder ; logic:allValuesFrom xsd:nonNegativeInteger ], [ a logic:Restriction ; logic:onProperty gmeow:fusionTieOrder ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:nonNegativeInteger ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryFusionScore ; logic:closureKey "https://blackcatinformatics.ca/gmeow/fusionTieOrder" ; logic:closureValue logic:ClosedWorldClosure ] .
