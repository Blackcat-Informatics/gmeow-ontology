WHERE {
    {
        ?claim a gmeow:StandpointClaim .
        ?claim gmeow:vantage ?model .
        ?model a gmeow:SoftwareAgent .
        OPTIONAL { ?claim rdfs:label ?text . }
        OPTIONAL { ?claim gmeow:groundedIn ?span . }
        OPTIONAL { ?span gmeow:spanOfChunk ?chunk . }
        OPTIONAL { ?chunk gmeow:chunkOf ?source . }
        FILTER NOT EXISTS { ?claim gmeow:displayable false . }
        FILTER NOT EXISTS { ?model gmeow:displayable false . }
    }
