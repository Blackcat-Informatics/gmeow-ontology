# General finite-complex layer: the correct general-CW ∂∘∂ = 0 conformance —
# for every codimension-2 pair (coface, far-face), the finite signed SUM
# Σ_b [coface:b]·[b:far] over all intermediate cells b must equal 0. Authored as the
# sanctioned logic:JoinAggregateConstraint (P9): a two-leg join over math:CellIncidence
# records (coface → intermediate via incidenceCoface/incidenceFace, then intermediate →
# far), the PRODUCT of the two integer math:incidenceSign leaves SUMMED and GROUPED BY
# (coface, far), the invariant SUM = 0. Aggregates xsd:integer signs exactly via SPARQL
# SUM, never a decimal. Lowers to a SELECT $this ?far … GROUP BY $this ?far HAVING(SUM ≠ 0)
# sh:SPARQLConstraint. Covers general CW complexes (no diamond assumption).
math:GeneralBoundarySquareZeroConstraint
    a logic:JoinAggregateConstraint ;
    rdfs:label "General boundary square-zero constraint (finite signed sum over CW cells)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The general-CW executable form of ∂∘∂ = 0: for every codimension-2 pair (coface c, far-face a), the finite signed sum Σ_b [c:b]·[b:a] of incidence-sign products over the intermediate cells b must be 0. Authored as a logic:JoinAggregateConstraint over a two-leg math:CellIncidence join (c → b → a), aggregating the exact xsd:integer math:incidenceSign product with SUM grouped by (c, a) and the invariant = 0; a group whose signed sum is non-zero breaks ∂∘∂ = 0 (math:BrokenBoundarySquareZero). Unlike math:BoundarySquareZeroConstraint (the regular/simplicial diamond), this makes NO two-intermediate assumption and so is the correct conformance check on a general CW complex; the universal class law is the honest boundary math:cellBoundarySumBoundary."@x-gmeow-english ;
    logic:onClass math:Cell ;
    logic:aggFunction "SUM" ;
    logic:aggComparator "=" ;
    logic:aggThreshold 0 ;
    logic:joinPath (
        [ logic:legRecordType math:CellIncidence ; logic:legSource math:incidenceCoface ; logic:legTarget math:incidenceFace ; logic:legValue math:incidenceSign ]
        [ logic:legRecordType math:CellIncidence ; logic:legSource math:incidenceCoface ; logic:legTarget math:incidenceFace ; logic:legValue math:incidenceSign ]
    ) ;
    logic:formalizes math:BoundaryOperator ;
    gmeow:enforcesFailureClass math:BrokenBoundarySquareZero ;
    logic:message "For every codimension-2 pair (coface, far-face) the finite signed sum Σ_b [c:b]·[b:a] over intermediate cells must be 0; a non-zero group sum breaks ∂∘∂ = 0 on a general CW complex (math:BrokenBoundarySquareZero)." .

# Adjunction enforcement (B.3): δ = ∂* at the sign level — a boundary incidence and its
# transpose coboundary incidence (math:adjointIncidence) must carry EQUAL signs. A
# cross-node equality formula; a linked transpose pair with disagreeing signs is a broken
# adjunction (math:BrokenBoundaryCoboundaryAdjunction). Projected to a sh:SPARQLConstraint.
math:BoundaryCoboundaryAdjunctionConstraint
    a logic:Constraint ;
    rdfs:label "Boundary/coboundary adjunction constraint (δ = ∂*)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint enforcing the boundary/coboundary adjunction δ = ∂* at the sign level: a boundary math:CellIncidence and its transpose coboundary math:CellIncidence (linked by math:adjointIncidence) must carry the SAME ±1 math:incidenceSign — the transpose entry equals the original. A linked transpose pair whose signs disagree witnesses a broken adjunction (math:BrokenBoundaryCoboundaryAdjunction), the failure the math:HodgeLaplacian L = δδ* + δ*δ cannot tolerate. The machine law is math:boundaryCoboundaryAdjunctionLaw."@x-gmeow-english ;
    logic:formalizes math:AdjunctionSignShape ;
    gmeow:enforcesFailureClass math:BrokenBoundaryCoboundaryAdjunction ;
    logic:message "A boundary math:CellIncidence and its math:adjointIncidence coboundary transpose must carry equal math:incidenceSign values (δ = ∂*); disagreeing signs break the adjunction (math:BrokenBoundaryCoboundaryAdjunction)." ;
    logic:integrity math:bcaForall .
math:bcaForall a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "i" ] ,
        [ logic:termIndex 1 ; logic:termVariable "j" ] ,
        [ logic:termIndex 2 ; logic:termVariable "s" ] ,
        [ logic:termIndex 3 ; logic:termVariable "t" ] ;
    logic:forall math:bcaImpl .
math:bcaImpl a logic:Formula ; logic:antecedent math:bcaGuard ; logic:consequent math:bcaEq .
math:bcaGuard a logic:Formula ;
    logic:and math:bcaAdj , math:bcaSignI , math:bcaSignJ .
math:bcaAdj a logic:Formula ; logic:relation math:adjointIncidence ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "i" ] , [ logic:termIndex 1 ; logic:termVariable "j" ] .
math:bcaSignI a logic:Formula ; logic:relation math:incidenceSign ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "i" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
math:bcaSignJ a logic:Formula ; logic:relation math:incidenceSign ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "j" ] , [ logic:termIndex 1 ; logic:termVariable "t" ] .
math:bcaEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s" ] , [ logic:termIndex 1 ; logic:termVariable "t" ] .

# Global-vs-local non-conflation: a math:GlobalSection's math:sectionRegion must be
# the WHOLE base of its math:overSheaf. A cross-node equality formula over (this, sheaf, base,
# region): if the section names a sheaf whose base is B and its own region is R, then R = B; a
# section typed global but scoped to a proper subcomplex R ≠ B is misscoped
# (math:MisscopedSection). Projected to a sh:SPARQLConstraint (shacl.SPARQLConstraintComponent).
math:MisscopedSectionConstraint
    a logic:Constraint ;
    rdfs:label "Misscoped global-section constraint (region = whole base)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint enforcing that a math:GlobalSection is scoped to the ENTIRE base: for a global section with math:overSheaf S, math:sheafBaseComplex(S) = B, and math:sectionRegion R, the region R must equal the base B. A global section whose region is a proper subcomplex R ≠ B conflates the H⁰ global reading with a local datum and is ill-formed (math:MisscopedSection). The missing-frame case (no region at all) is the separate declarative frame math:IncompleteGlobalSection; this constraint is the wrong-scope, region-present half."@x-gmeow-english ;
    logic:formalizes math:GlobalSection ;
    gmeow:enforcesFailureClass math:MisscopedSection ;
    logic:severity "Violation" ;
    logic:message "A math:GlobalSection's math:sectionRegion must equal the whole math:sheafBaseComplex of its math:overSheaf; a global section scoped to a proper subcomplex conflates H⁰ globality with a local datum and is ill-formed (math:MisscopedSection)." ;
    logic:integrity math:mscForall .
math:mscForall a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termVariable "sheaf" ] ,
        [ logic:termIndex 2 ; logic:termVariable "base" ] ,
        [ logic:termIndex 3 ; logic:termVariable "region" ] ;
    logic:forall math:mscImpl .
math:mscImpl a logic:Formula ; logic:antecedent math:mscGuard ; logic:consequent math:mscEq .
math:mscGuard a logic:Formula ;
    logic:and math:mscType , math:mscOver , math:mscBase , math:mscRegion .
math:mscType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:GlobalSection ] .
math:mscOver a logic:Formula ; logic:relation math:overSheaf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sheaf" ] .
math:mscBase a logic:Formula ; logic:relation math:sheafBaseComplex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sheaf" ] , [ logic:termIndex 1 ; logic:termVariable "base" ] .
math:mscRegion a logic:Formula ; logic:relation math:sectionRegion ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "region" ] .
math:mscEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "region" ] , [ logic:termIndex 1 ; logic:termVariable "base" ] .

# Gluing executability: a math:GlobalSection restricts CONSISTENTLY along every
# math:SheafRestrictionMap of its sheaf. A per-restriction-map cross-node equality formula
# (NOT an aggregation, in the style of math:BoundaryCoboundaryAdjunctionConstraint): for a
# global section with math:overSheaf S, a restriction map r of S with math:sourceObject stalk
# ss and math:targetObject stalk ts carrying exact integer math:stalkValue vs and vt, and r's
# declared math:RestrictionImage recording that r sends INPUT vs to OUTPUT vimg, the general
# cellular-sheaf gluing condition requires vimg = vt — restriction(sourceValue) = targetValue,
# of which raw vs = vt is only the identity-map special case (the map's action is APPLIED to
# the source value via the reified math:RestrictionImage before comparison, never compared
# raw). A declared assignment whose transported value disagrees with the target is the
# executable H¹ obstruction — the local data do not glue (math:SectionGluingInconsistency). A
# section that declares no stalk values, or a map that declares no matching
# math:RestrictionImage for the exact value actually assigned, glues vacuously (the antecedent
# join has nothing to bind). Projected to a sh:SPARQLConstraint (shacl.SPARQLConstraintComponent).
math:SectionGluingConsistencyConstraint
    a logic:Constraint ;
    rdfs:label "Global-section gluing-consistency constraint (H¹ obstruction, executable)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint making the H¹ gluing obstruction executable: a math:GlobalSection with math:overSheaf S must, along every math:SheafRestrictionMap r of S with source stalk ss (math:sourceObject) and target stalk ts (math:targetObject), have r's declared math:RestrictionImage of the section's exact integer math:stalkValue vs at ss agree with the section's math:stalkValue vt at ts — the general gluing condition restriction(vs) = vt (vimg = vt), APPLYING the map's action rather than comparing vs and vt raw (raw equality is only the identity/constant-transport special case, e.g. a math:ConstantSheaf). A per-restriction-map equality (never an aggregation): a single map whose declared image of the source value disagrees with the declared target value witnesses that consistent-looking local data fail to glue into a global truth (math:SectionGluingInconsistency), the executable reading of the first sheaf cohomology math:GluingObstruction. A section declaring no stalk values, or a map declaring no math:RestrictionImage matching the exact source value assigned, glues vacuously. Modelled on math:BoundaryCoboundaryAdjunctionConstraint (a cross-node sign/value equality), not on an aggregation like math:GeneralBoundarySquareZeroConstraint."@x-gmeow-english ;
    logic:formalizes math:GlobalSection ;
    gmeow:enforcesFailureClass math:SectionGluingInconsistency ;
    logic:severity "Violation" ;
    logic:message "A math:GlobalSection must restrict consistently along every math:SheafRestrictionMap of its sheaf — applying the map's declared math:RestrictionImage to the exact integer math:stalkValue at its math:sourceObject stalk must agree with the math:stalkValue at its math:targetObject stalk; a declared assignment whose transported value disagrees with the target does not glue and is ill-formed (math:SectionGluingInconsistency)." ;
    logic:integrity math:sgcForall .
math:sgcForall a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termVariable "sheaf" ] ,
        [ logic:termIndex 2 ; logic:termVariable "rmap" ] ,
        [ logic:termIndex 3 ; logic:termVariable "ss" ] ,
        [ logic:termIndex 4 ; logic:termVariable "ts" ] ,
        [ logic:termIndex 5 ; logic:termVariable "vs" ] ,
        [ logic:termIndex 6 ; logic:termVariable "vt" ] ,
        [ logic:termIndex 7 ; logic:termVariable "img" ] ,
        [ logic:termIndex 8 ; logic:termVariable "vimg" ] ;
    logic:forall math:sgcImpl .
math:sgcImpl a logic:Formula ; logic:antecedent math:sgcGuard ; logic:consequent math:sgcEq .
math:sgcGuard a logic:Formula ;
    logic:and math:sgcType , math:sgcOver , math:sgcRmap , math:sgcSrc , math:sgcTgt , math:sgcVs , math:sgcVt , math:sgcImg , math:sgcImgSrc , math:sgcImgTgt .
math:sgcType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:GlobalSection ] .
math:sgcOver a logic:Formula ; logic:relation math:overSheaf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sheaf" ] .
math:sgcRmap a logic:Formula ; logic:relation math:restrictionMap ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sheaf" ] , [ logic:termIndex 1 ; logic:termVariable "rmap" ] .
math:sgcSrc a logic:Formula ; logic:relation math:sourceObject ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "rmap" ] , [ logic:termIndex 1 ; logic:termVariable "ss" ] .
math:sgcTgt a logic:Formula ; logic:relation math:targetObject ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "rmap" ] , [ logic:termIndex 1 ; logic:termVariable "ts" ] .
math:sgcVs a logic:Formula ; logic:relation math:stalkValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "ss" ] , [ logic:termIndex 1 ; logic:termVariable "vs" ] .
math:sgcVt a logic:Formula ; logic:relation math:stalkValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "ts" ] , [ logic:termIndex 1 ; logic:termVariable "vt" ] .
math:sgcImg a logic:Formula ; logic:relation math:restrictionImage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "rmap" ] , [ logic:termIndex 1 ; logic:termVariable "img" ] .
math:sgcImgSrc a logic:Formula ; logic:relation math:imageSourceValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "img" ] , [ logic:termIndex 1 ; logic:termVariable "vs" ] .
math:sgcImgTgt a logic:Formula ; logic:relation math:imageTargetValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "img" ] , [ logic:termIndex 1 ; logic:termVariable "vimg" ] .
math:sgcEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vimg" ] , [ logic:termIndex 1 ; logic:termVariable "vt" ] .

# Non-collapse: a math:MultiparameterFiltration must NOT
# silently degrade to one parameter. A guarded existence formula (in the style of
# math:BoundarySquareZeroConstraint's positive existential consequent): for a
# multiparameter filtration, THERE MUST EXIST a stage carrying a math:multiIndex;
# a filtration whose every stage is a bare one-parameter math:filtrationThreshold
# has no multi-index at all and has collapsed to one parameter
# (math:CollapsedMultiparameterFiltration). Projected to a sh:SPARQLConstraint
# (shacl.SPARQLConstraintComponent). The missing-poset/missing-stage case is the
# separate declarative frame math:IncompleteMultiparameterFiltration.
math:CollapsedMultiparameterFiltrationConstraint
    a logic:Constraint ;
    rdfs:label "Collapsed-multiparameter-filtration constraint (a stage must carry a multi-index)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint enforcing non-collapse of a math:MultiparameterFiltration: for every multiparameter filtration that already has at least one math:hasFiltrationStage, there MUST exist a math:hasFiltrationStage whose math:multiIndex names a tuple in the parameter poset. A filtration whose stages carry only a single real math:filtrationThreshold and no math:multiIndex has collapsed to the one-parameter case (math:CollapsedMultiparameterFiltration). A positive existential consequent modelled on math:BoundarySquareZeroConstraint; the missing-frame case (no poset, no stage) is math:IncompleteMultiparameterFiltration. This constraint only applies once at least one stage exists; a filtration with zero stages is exclusively covered by math:IncompleteMultiparameterFiltration — the guard's own stage-existence conjunct keeps this constraint from vacuously double-firing on a zero-stage filtration."@x-gmeow-english ;
    logic:formalizes math:MultiparameterFiltration ;
    gmeow:enforcesFailureClass math:CollapsedMultiparameterFiltration ;
    logic:severity "Violation" ;
    logic:message "A math:MultiparameterFiltration that already has at least one math:hasFiltrationStage must have one carrying a math:multiIndex tuple; a filtration whose every stage is a bare one-parameter math:filtrationThreshold has collapsed to one parameter (math:CollapsedMultiparameterFiltration). This constraint only applies once at least one stage exists; a filtration with zero stages is exclusively covered by math:IncompleteMultiparameterFiltration." ;
    logic:integrity math:cmfForall .
math:cmfForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:cmfImpl .
math:cmfImpl a logic:Formula ; logic:antecedent math:cmfGuard ; logic:consequent math:cmfExists .
math:cmfGuard a logic:Formula ; logic:and math:cmfTypeGuard , math:cmfStageExistsGuard .
math:cmfTypeGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:MultiparameterFiltration ] .
math:cmfStageExistsGuard a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "anyStage" ] ;
    logic:exists math:cmfStageExistsAtom .
math:cmfStageExistsAtom a logic:Formula ; logic:relation math:hasFiltrationStage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "anyStage" ] .
math:cmfExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "stage" ] , [ logic:termIndex 1 ; logic:termVariable "mi" ] ;
    logic:exists math:cmfBody .
math:cmfBody a logic:Formula ; logic:and math:cmfA1 , math:cmfA2 .
math:cmfA1 a logic:Formula ; logic:relation math:hasFiltrationStage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "stage" ] .
math:cmfA2 a logic:Formula ; logic:relation math:multiIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "stage" ] , [ logic:termIndex 1 ; logic:termVariable "mi" ] .

# Stage index presence: every math:FiltrationStage must sit at SOME index — either the
# single real math:filtrationThreshold of a one-parameter math:Filtration OR the
# math:multiIndex tuple of a math:MultiparameterFiltration. A stage carries one XOR the
# other by design (a multiparameter stage carries a math:multiIndex INSTEAD of a real
# threshold), so the FiltrationStage frame cannot unconditionally require the threshold;
# a stage carrying NEITHER names no position in any index and is ill-formed. A guarded
# disjunctive-existence formula (∀ stage → ∃ threshold ∨ ∃ multi-index), projected to a
# sh:SPARQLConstraint (shacl.SPARQLConstraintComponent). The missing-substructure and
# no-stage cases stay the separate declarative math:UnderspecifiedFiltration frame.
math:StageIndexPresenceConstraint
    a logic:Constraint ;
    rdfs:label "Stage index-presence constraint (a stage carries a threshold or a multi-index)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every math:FiltrationStage must name its position in the filtration's index — either a single real math:filtrationThreshold (a one-parameter math:Filtration stage) OR a math:multiIndex tuple (a math:MultiparameterFiltration stage). A stage carries one XOR the other: a multiparameter stage carries a math:multiIndex INSTEAD of a threshold, so the math:FiltrationStage frame cannot unconditionally require the threshold; a stage carrying NEITHER sits at no index and is ill-formed (math:UnderspecifiedFiltration). A guarded disjunctive-existence formula (∀ stage → ∃ threshold ∨ ∃ multi-index) modelled on math:ascZeroOrPredecessor's disjunctive consequent, projected to a sh:SPARQLConstraint. The missing-substructure and no-stage cases are the separate declarative math:UnderspecifiedFiltration frame."@x-gmeow-english ;
    logic:formalizes math:FiltrationStage ;
    gmeow:enforcesFailureClass math:UnderspecifiedFiltration ;
    logic:severity "Violation" ;
    logic:message "A math:FiltrationStage must carry either a math:filtrationThreshold (a one-parameter index) or a math:multiIndex (a multiparameter index tuple); a stage carrying neither names no position in the filtration and is ill-formed (math:UnderspecifiedFiltration)." ;
    logic:integrity math:sipForall .
math:sipForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:sipImpl .
math:sipImpl a logic:Formula ; logic:antecedent math:sipGuard ; logic:consequent math:sipOr .
math:sipGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:FiltrationStage ] .
math:sipOr a logic:Formula ; logic:or math:sipHasThreshold , math:sipHasMultiIndex .
math:sipHasThreshold a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "thr" ] ;
    logic:exists math:sipThresholdAtom .
math:sipThresholdAtom a logic:Formula ; logic:relation math:filtrationThreshold ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "thr" ] .
math:sipHasMultiIndex a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "mi" ] ;
    logic:exists math:sipMultiIndexAtom .
math:sipMultiIndexAtom a logic:Formula ; logic:relation math:multiIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "mi" ] .

# Diagonal degeneracy: a 2-index whose two coordinates are functionally
# dependent — the diagonal (t, t) — is genuinely one-parametric despite the 2-tuple. A
# cross-node "NOT EXISTS a bad witness" formula (in the style of math:ChartDimensionConstraint):
# a stage's math:multiIndex must NOT carry two components at DISTINCT indices sharing the same
# math:componentValue. A shared coordinate value across distinct positions witnesses the
# diagonal collapse (math:DiagonalDegenerateFiltration). Projected to a sh:SPARQLConstraint
# (shacl.SPARQLConstraintComponent).
math:DiagonalDegenerateFiltrationConstraint
    a logic:Constraint ;
    rdfs:label "Diagonal-degenerate-filtration constraint (multi-index coordinates must not be functionally dependent)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint forbidding a diagonal-degenerate math:MultiparameterFiltration: a stage's math:multiIndex math:Vector must NOT carry two math:hasComponent cells at DISTINCT math:atIndex positions whose math:componentValue is the SAME node — a (t, t) diagonal index that reindexes a single parameter and is genuinely one-parametric despite the 2-tuple (math:DiagonalDegenerateFiltration). A NOT-EXISTS cross-node equality modelled on math:ChartDimensionConstraint; subtler than math:CollapsedMultiparameterFiltration (there the multi-index is absent, here present but degenerate)."@x-gmeow-english ;
    logic:formalizes math:MultiparameterFiltration ;
    gmeow:enforcesFailureClass math:DiagonalDegenerateFiltration ;
    logic:severity "Violation" ;
    logic:message "A math:MultiparameterFiltration stage's math:multiIndex must not carry two components at distinct indices sharing the same math:componentValue; a diagonal (t, t) index is functionally dependent and genuinely one-parametric (math:DiagonalDegenerateFiltration)." ;
    logic:integrity math:ddfForall .
math:ddfForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:ddfImpl .
math:ddfImpl a logic:Formula ; logic:antecedent math:ddfGuard ; logic:consequent math:ddfNot .
math:ddfGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:MultiparameterFiltration ] .
math:ddfNot a logic:Formula ; logic:not math:ddfExists .
math:ddfExists a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "stage" ] ,
        [ logic:termIndex 1 ; logic:termVariable "mi" ] ,
        [ logic:termIndex 2 ; logic:termVariable "c1" ] ,
        [ logic:termIndex 3 ; logic:termVariable "c2" ] ,
        [ logic:termIndex 4 ; logic:termVariable "i1" ] ,
        [ logic:termIndex 5 ; logic:termVariable "i2" ] ,
        [ logic:termIndex 6 ; logic:termVariable "val" ] ;
    logic:exists math:ddfBody .
math:ddfBody a logic:Formula ;
    logic:and math:ddfStage , math:ddfMi , math:ddfC1 , math:ddfC2 , math:ddfI1 , math:ddfI2 , math:ddfDistinct , math:ddfV1 , math:ddfV2 .
math:ddfStage a logic:Formula ; logic:relation math:hasFiltrationStage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "stage" ] .
math:ddfMi a logic:Formula ; logic:relation math:multiIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "stage" ] , [ logic:termIndex 1 ; logic:termVariable "mi" ] .
math:ddfC1 a logic:Formula ; logic:relation math:hasComponent ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mi" ] , [ logic:termIndex 1 ; logic:termVariable "c1" ] .
math:ddfC2 a logic:Formula ; logic:relation math:hasComponent ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mi" ] , [ logic:termIndex 1 ; logic:termVariable "c2" ] .
math:ddfI1 a logic:Formula ; logic:relation math:atIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c1" ] , [ logic:termIndex 1 ; logic:termVariable "i1" ] .
math:ddfI2 a logic:Formula ; logic:relation math:atIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c2" ] , [ logic:termIndex 1 ; logic:termVariable "i2" ] .
math:ddfDistinct a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "i1" ] , [ logic:termIndex 1 ; logic:termVariable "i2" ] .
math:ddfV1 a logic:Formula ; logic:relation math:componentValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c1" ] , [ logic:termIndex 1 ; logic:termVariable "val" ] .
math:ddfV2 a logic:Formula ; logic:relation math:componentValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c2" ] , [ logic:termIndex 1 ; logic:termVariable "val" ] .

# General functional dependence: math:DiagonalDegenerateFiltrationConstraint above only
# catches the LITERAL diagonal (t, t) — two components of ONE stage sharing the same
# math:componentValue node. It is blind to (t, 2t), (t, t+1), or any other coordinate pair
# that is a function of the other but never literally equal: two DISTINCT stages of such a
# family always differ at BOTH positions together, never at one position alone. So the
# general guard is a POSITIVE coordinate-independence WITNESS requirement (in the style of
# math:CollapsedMultiparameterFiltrationConstraint's guarded existence): whenever a
# math:MultiparameterFiltration has at least two DISTINCT math:hasFiltrationStage cells,
# there MUST exist two stages whose math:multiIndex VARIES at one math:atIndex position
# (distinct math:componentValue there) while holding the OTHER position FIXED (the SAME
# math:componentValue node there) — an incomparability/antichain witness proving both
# parameters are actually live. No functionally-dependent family can ever produce such a
# witness (holding one coordinate fixed forces the other fixed too), so its absence among
# ≥ 2 declared stages witnesses degeneracy (math:DiagonalDegenerateFiltration) exactly as
# surely as the literal-diagonal case. A filtration with fewer than two stages cannot be
# tested either way and stays inert (as does math:DiagonalDegenerateFiltrationConstraint's
# own single-stage check, which remains the ONLY guard able to catch a one-stage diagonal).
# Projected to a sh:SPARQLConstraint (shacl.SPARQLConstraintComponent).
math:MultiparameterFunctionalDependenceConstraint
    a logic:Constraint ;
    rdfs:label "Multiparameter functional-dependence constraint (a coordinate-independence witness is required)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint requiring a math:MultiparameterFiltration to DEMONSTRATE its coordinate independence through its declared stages, rather than only ruling out the literal (t, t) diagonal. Functional dependence t₂ = f(t₁) is not decidable from a finite set of stage samples — any two index points are consistent with some function through them — so this is authored honestly as a declaration-completeness check: whenever a filtration has at least two distinct math:hasFiltrationStage cells, there MUST exist two stages whose math:multiIndex vectors share the SAME math:componentValue node at one math:atIndex position (a coordinate held fixed) while carrying distinct math:componentValue nodes at another (a coordinate varied) — the fix-one-vary-another witness proving at least one coordinate moves free of another. A degenerate family sampled only along a curve t₂ = f(t₁) — e.g. (t, 2t) or (t, t+1) — never fixes one coordinate while moving the other, so it cannot exhibit the witness and fires math:DiagonalDegenerateFiltration; a genuine grid such as (1,2), (1,3), (2,3) exhibits it. The witness compares math:componentValue by NODE identity, so equal coordinates across stages must reuse the same value node (the convention the multiparameter fixtures already follow). The literal single-stage diagonal (t, t) is the separate math:DiagonalDegenerateFiltrationConstraint (checkable from one stage alone); this is its cross-stage complement, and general functional-dependence detection beyond the fixed-coordinate witness is the honest boundary math:multiparameterDependenceBoundary."@x-gmeow-english ;
    logic:formalizes math:MultiparameterFiltration ;
    gmeow:enforcesFailureClass math:DiagonalDegenerateFiltration ;
    logic:severity "Violation" ;
    logic:message "A math:MultiparameterFiltration with two or more declared stages must exhibit a fix-one-vary-another witness — two stages sharing the same math:componentValue node at one math:atIndex position while differing at another; its absence means the declared stages are consistent with a functional dependence t₂ = f(t₁) and have not shown the filtration genuinely multi-parametric (math:DiagonalDegenerateFiltration)." ;
    logic:integrity math:mfdForall .
math:mfdForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:mfdImpl .
math:mfdImpl a logic:Formula ; logic:antecedent math:mfdGuard ; logic:consequent math:mfdWitness .

# Guard: this is a math:MultiparameterFiltration AND has at least two distinct stages —
# without the stage-count gate, a legitimately single-stage filtration (which cannot possibly
# exhibit a two-stage witness) would be misflagged.
math:mfdGuard a logic:Formula ; logic:and math:mfdType , math:mfdTwoStages .
math:mfdType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:MultiparameterFiltration ] .
math:mfdTwoStages a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "gs1" ] , [ logic:termIndex 1 ; logic:termVariable "gs2" ] ;
    logic:exists math:mfdTwoStagesBody .
math:mfdTwoStagesBody a logic:Formula ;
    logic:and math:mfdG1 , math:mfdG2 , math:mfdGDistinct .
math:mfdG1 a logic:Formula ; logic:relation math:hasFiltrationStage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "gs1" ] .
math:mfdG2 a logic:Formula ; logic:relation math:hasFiltrationStage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "gs2" ] .
math:mfdGDistinct a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "gs1" ] , [ logic:termIndex 1 ; logic:termVariable "gs2" ] .

# Consequent: the positive existential coordinate-independence witness itself.
math:mfdWitness a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "stage1" ] ,
        [ logic:termIndex 1 ; logic:termVariable "stage2" ] ,
        [ logic:termIndex 2 ; logic:termVariable "mi1" ] ,
        [ logic:termIndex 3 ; logic:termVariable "mi2" ] ,
        [ logic:termIndex 4 ; logic:termVariable "cVary1" ] ,
        [ logic:termIndex 5 ; logic:termVariable "cVary2" ] ,
        [ logic:termIndex 6 ; logic:termVariable "cFixed1" ] ,
        [ logic:termIndex 7 ; logic:termVariable "cFixed2" ] ,
        [ logic:termIndex 8 ; logic:termVariable "iVary" ] ,
        [ logic:termIndex 9 ; logic:termVariable "iFixed" ] ,
        [ logic:termIndex 10 ; logic:termVariable "vVary1" ] ,
        [ logic:termIndex 11 ; logic:termVariable "vVary2" ] ,
        [ logic:termIndex 12 ; logic:termVariable "vFixed" ] ;
    logic:exists math:mfdWitnessBody .
math:mfdWitnessBody a logic:Formula ;
    logic:and math:mfdW01 , math:mfdW02 , math:mfdW03 , math:mfdW04 , math:mfdW05 , math:mfdW06 ,
        math:mfdW07 , math:mfdW08 , math:mfdW09 , math:mfdW10 , math:mfdW11 , math:mfdW12 ,
        math:mfdW13 , math:mfdW14 , math:mfdW15 , math:mfdW16 , math:mfdW17 , math:mfdW18 , math:mfdW19 .
math:mfdW01 a logic:Formula ; logic:relation math:hasFiltrationStage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "stage1" ] .
math:mfdW02 a logic:Formula ; logic:relation math:hasFiltrationStage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "stage2" ] .
math:mfdW03 a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "stage1" ] , [ logic:termIndex 1 ; logic:termVariable "stage2" ] .
math:mfdW04 a logic:Formula ; logic:relation math:multiIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "stage1" ] , [ logic:termIndex 1 ; logic:termVariable "mi1" ] .
math:mfdW05 a logic:Formula ; logic:relation math:multiIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "stage2" ] , [ logic:termIndex 1 ; logic:termVariable "mi2" ] .
math:mfdW06 a logic:Formula ; logic:relation math:hasComponent ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mi1" ] , [ logic:termIndex 1 ; logic:termVariable "cVary1" ] .
math:mfdW07 a logic:Formula ; logic:relation math:atIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "cVary1" ] , [ logic:termIndex 1 ; logic:termVariable "iVary" ] .
math:mfdW08 a logic:Formula ; logic:relation math:componentValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "cVary1" ] , [ logic:termIndex 1 ; logic:termVariable "vVary1" ] .
math:mfdW09 a logic:Formula ; logic:relation math:hasComponent ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mi2" ] , [ logic:termIndex 1 ; logic:termVariable "cVary2" ] .
math:mfdW10 a logic:Formula ; logic:relation math:atIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "cVary2" ] , [ logic:termIndex 1 ; logic:termVariable "iVary" ] .
math:mfdW11 a logic:Formula ; logic:relation math:componentValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "cVary2" ] , [ logic:termIndex 1 ; logic:termVariable "vVary2" ] .
math:mfdW12 a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vVary1" ] , [ logic:termIndex 1 ; logic:termVariable "vVary2" ] .
math:mfdW13 a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "iVary" ] , [ logic:termIndex 1 ; logic:termVariable "iFixed" ] .
math:mfdW14 a logic:Formula ; logic:relation math:hasComponent ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mi1" ] , [ logic:termIndex 1 ; logic:termVariable "cFixed1" ] .
math:mfdW15 a logic:Formula ; logic:relation math:atIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "cFixed1" ] , [ logic:termIndex 1 ; logic:termVariable "iFixed" ] .
math:mfdW16 a logic:Formula ; logic:relation math:componentValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "cFixed1" ] , [ logic:termIndex 1 ; logic:termVariable "vFixed" ] .
math:mfdW17 a logic:Formula ; logic:relation math:hasComponent ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mi2" ] , [ logic:termIndex 1 ; logic:termVariable "cFixed2" ] .
math:mfdW18 a logic:Formula ; logic:relation math:atIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "cFixed2" ] , [ logic:termIndex 1 ; logic:termVariable "iFixed" ] .
math:mfdW19 a logic:Formula ; logic:relation math:componentValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "cFixed2" ] , [ logic:termIndex 1 ; logic:termVariable "vFixed" ] .

# The honest residue of the non-collapse guard: general functional-dependence detection
# t₂ = f(t₁) is not decidable from finitely many stage samples, so it is recorded as a
# boundary rather than faked as an unsound first-order predicate.
math:multiparameterDependenceBoundary
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "general multiparameter functional-dependence detection (t₂ = f(t₁) from finite samples): an honest recorded boundary"@x-gmeow-english ;
    logic:expressivenessBoundary logic:SecondOrder ;
    logic:preservationKind logic:Unsupported ;
    skos:definition "The loss-ledger boundary record backing the non-collapse guard for math:MultiparameterFiltration. Deciding whether a filtration's second coordinate is a function of the first — t₂ = f(t₁) for an ARBITRARY f — from its finitely many declared math:hasFiltrationStage samples is not first-order decidable: any finite set of index points is consistent with some function through them, so no first-order witness separates a genuinely two-parameter family from one secretly sampled along a curve. Two executable checks cover the decidable cases: math:DiagonalDegenerateFiltrationConstraint catches the literal single-stage diagonal (t, t), and math:MultiparameterFunctionalDependenceConstraint requires the declared stages to DEMONSTRATE independence through a fix-one-vary-another witness (its absence flags samples consistent with a dependence). What stays here is only the undecidable general case — detecting an arbitrary latent f no declaration exposes — so this record is the honest mathematical residue, not a scope dodge. A sibling of math:cellBoundarySumBoundary and math:smoothnessBoundary."@x-gmeow-english .

# Zigzag non-degeneracy: a math:ZigzagDiagram must declare at least one
# math:backwardArrow, or it has collapsed to forward-only single-parameter persistence. A
# guarded existence formula (positive consequent, like math:BoundarySquareZeroConstraint):
# for a zigzag diagram THERE MUST EXIST a math:zigzagArrow whose math:arrowDirection is
# math:backwardArrow. A forward-only diagram is degenerate (math:DegenerateZigzagDiagram).
# Projected to a sh:SPARQLConstraint (shacl.SPARQLConstraintComponent).
math:DegenerateZigzagDiagramConstraint
    a logic:Constraint ;
    rdfs:label "Degenerate-zigzag-diagram constraint (a backward arrow must exist)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint enforcing that a math:ZigzagDiagram is genuinely bidirectional: there MUST exist a math:zigzagArrow whose math:arrowDirection is math:backwardArrow. A diagram whose every arrow is a math:forwardArrow has collapsed to ordinary forward-only single-parameter persistence and is degenerate (math:DegenerateZigzagDiagram) — the backward arrow is exactly what distinguishes a zigzag from a filtration. A positive existential consequent modelled on math:BoundarySquareZeroConstraint."@x-gmeow-english ;
    logic:formalizes math:ZigzagDiagram ;
    gmeow:enforcesFailureClass math:DegenerateZigzagDiagram ;
    logic:severity "Violation" ;
    logic:message "A math:ZigzagDiagram must declare at least one math:zigzagArrow whose math:arrowDirection is math:backwardArrow; a forward-only diagram has collapsed to single-parameter persistence and is degenerate (math:DegenerateZigzagDiagram)." ;
    logic:integrity math:dzdForall .
math:dzdForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:dzdImpl .
math:dzdImpl a logic:Formula ; logic:antecedent math:dzdGuard ; logic:consequent math:dzdExists .
math:dzdGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:ZigzagDiagram ] .
math:dzdExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "arr" ] ;
    logic:exists math:dzdBody .
math:dzdBody a logic:Formula ; logic:and math:dzdArrow , math:dzdBackward .
math:dzdArrow a logic:Formula ; logic:relation math:zigzagArrow ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "arr" ] .
math:dzdBackward a logic:Formula ; logic:relation math:arrowDirection ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "arr" ] , [ logic:termIndex 1 ; logic:termIri math:backwardArrow ] .

# A math:DimensionExponent's math:exponentDenominator must be non-zero: a zero
# denominator is not a rational power (a forbidden pinned-value pattern — the
# focus must not carry math:exponentDenominator 0). The pinned value also lowers
# declaratively onto the projected math:DimensionExponent class shape as
# sh:not [ sh:hasValue 0 ] on the path (shacl.NotConstraintComponent) — the
# decidable, validation-only home of the retired OWL value-complement antecedent.
math:DimensionExponentDenominatorNonZeroConstraint
    a logic:ForbiddenPatternConstraint ;
    logic:onClass math:DimensionExponent ;
    logic:forbiddenPredicate math:exponentDenominator ;
    logic:forbiddenValue "0"^^xsd:integer ;
    logic:formalizes math:DimensionExponent ;
    logic:message "A math:DimensionExponent must declare a non-zero integer math:exponentDenominator; a zero denominator is not a rational power (math:MalformedDimension)." ;
    # Bound to its failure class: without this the constraint rejects ANONYMOUSLY — the
    # violation carries no typed identity, so a conformance cell can only pin the SHACL
    # component code and every SPARQL-derived gate shares one of those.
    gmeow:enforcesFailureClass math:MalformedDimension .

# A math:MeasureEvaluation's math:measureResult must be non-negative: a measure
# assigns non-negative extended-real mass, so μ(A) is a finite non-negative number
# or math:PositiveInfinity, NEVER the negative pole math:NegativeInfinity (a forbidden
# pinned-value pattern — the focus must not carry math:measureResult math:NegativeInfinity,
# the individual the logic:forbiddenValue sugar pins because it is an IRI value).
math:MeasureResultNonNegativeConstraint
    a logic:ForbiddenPatternConstraint ;
    logic:onClass math:MeasureEvaluation ;
    logic:forbiddenPredicate math:measureResult ;
    logic:forbiddenValue math:NegativeInfinity ;
    logic:formalizes math:MeasureEvaluation ;
    gmeow:enforcesFailureClass math:UnderspecifiedMeasureEvaluation ;
    logic:message "A math:MeasureEvaluation's math:measureResult must be a finite non-negative number or math:PositiveInfinity; a measure is non-negative, so the negative pole math:NegativeInfinity is not a mass (math:MalformedExtendedReal or math:UnderspecifiedMeasureEvaluation)." .

# A math:RationalValue's math:denominator must be non-zero: p/0 is undefined
# (math:ZeroDenominator). The exact twin of the dimension-exponent record above,
# on the object-layer exact-rational carrier: the pinned value lowers
# declaratively onto the projected math:RationalValue class shape as
# sh:not [ sh:hasValue 0 ] on the path (shacl.NotConstraintComponent), and the
# expanded constraint's sh:SPARQLConstraint selects any rational carrying
# math:denominator 0.
math:RationalValueDenominatorNonZeroConstraint
    a logic:ForbiddenPatternConstraint ;
    logic:onClass math:RationalValue ;
    logic:forbiddenPredicate math:denominator ;
    logic:forbiddenValue "0"^^xsd:integer ;
    logic:formalizes math:RationalValue ;
    logic:message "A math:RationalValue must declare a non-zero math:denominator; a zero denominator is not a rational value (math:ZeroDenominator)." ;
    # Bound to its failure class: without this the constraint rejects ANONYMOUSLY — the
    # violation carries no typed identity, so a conformance cell can only pin the SHACL
    # component code and every SPARQL-derived gate shares one of those.
    gmeow:enforcesFailureClass math:ZeroDenominator .

# The three lower-bounded integer paths, as validation-only value-range records
# (never OWL faceted-datatype antecedents: the native reasoner carries no datatype
# value-space reasoning, so a facet is undecidable in the reasoning core the moment a
# literal is asserted on the constrained path — e.g. the example producers assert
# math:slotIndex throughout the bundle). Each lowers declaratively onto its class's
# projected shape as sh:minInclusive (the exact component the legacy facet carried);
# the sh:datatype / cardinality siblings stay as ordinary decidable OWL restrictions.

# An argument slot's position is zero-based: a negative math:slotIndex is not a
# position in an operand list.
math:ArgumentSlotIndexNonNegativeConstraint
    a logic:ValueRangeConstraint ;
    logic:onClass math:ArgumentSlot ;
    logic:valuePath math:slotIndex ;
    logic:minInclusiveBound 0 ;
    logic:formalizes math:ArgumentSlot ;
    logic:message "A math:ArgumentSlot's math:slotIndex must be a non-negative integer (zero-based operand position); a negative index is ill-formed (math:MalformedArgumentSlot)." .

# A derivative's order is at least one: a zeroth derivative is the function itself,
# never a math:Derivative record.
math:DerivativeOrderPositiveConstraint
    a logic:ValueRangeConstraint ;
    logic:onClass math:Derivative ;
    logic:valuePath math:derivativeOrder ;
    logic:minInclusiveBound 1 ;
    logic:formalizes math:Derivative ;
    logic:message "A math:Derivative's math:derivativeOrder must be a positive integer (a zeroth derivative is the function itself, not a derivative record); an order below one is ill-formed (math:UnderspecifiedDerivative)." .

# A manifold's dimension is non-negative: a negative dimension names no manifold.
math:ManifoldDimensionNonNegativeConstraint
    a logic:ValueRangeConstraint ;
    logic:onClass math:Manifold ;
    logic:valuePath math:manifoldDimension ;
    logic:minInclusiveBound 0 ;
    logic:formalizes math:Manifold ;
    logic:message "A math:Manifold's math:manifoldDimension must be a non-negative integer; a negative dimension names no manifold (math:UnderspecifiedManifold)." .

# A math:Homomorphism's math:preservationLaw must be a resource denoting a logic:
# formula (a blank node or IRI), not an opaque literal string (a path node-kind
# constraint).
math:PreservationLawNodeKindConstraint
    a logic:PathNodeKindConstraint ;
    logic:onClass math:Homomorphism ;
    logic:valuePath math:preservationLaw ;
    logic:nodeKind "BlankNodeOrIRI" ;
    logic:formalizes math:PreservationLawShape ;
    gmeow:enforcesFailureClass math:StringOnlyPreservationLaw ;
    logic:message "A math:Homomorphism must name its math:preservationLaw as a resource denoting a logic: formula, not an opaque literal string (math:StringOnlyPreservationLaw)." .

# =========================================================================== #
# Procedural constraints authored as raw logic:Formula integrity trees — the   #
# compound closed-world checks whose violation is a finding, lowered to a       #
# sh:SPARQLConstraint. Each carries logic:formalizes so its projected twin      #
# keys onto the same domain source-term as the hand-authored SHACL it replaces. #
# =========================================================================== #

# A math:Theorem must be warranted by either an in-graph math:Proof (some
# resource math:provesStatement it) or a declared math:externalWarrant; a
# theorem asserted with neither is an unwarranted truth-bit claim. The proof arm
# is an inverse existence and the warrant arm a direct one, joined by a
# disjunction — beyond any single sugar, so authored as a raw formula.
math:TheoremWarrantConstraint
    a logic:Constraint ;
    rdfs:label "Theorem warrant constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a math:Theorem must be warranted by an in-graph math:Proof that math:provesStatement it, or by a declared math:externalWarrant; a theorem with neither is an ungrounded truth-bit claim."@x-gmeow-english ;
    logic:formalizes math:TheoremGroundingShape ;
    gmeow:enforcesFailureClass math:UngroundedTheoremClaim ;
    logic:message "A math:Theorem must be warranted by either an in-graph math:Proof (some resource math:provesStatement it) or a declared math:externalWarrant; a theorem asserted with neither is an unwarranted truth-bit claim (math:UngroundedTheoremClaim)." ;
    logic:integrity math:twForall .
math:twForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:twImpl .
math:twImpl a logic:Formula ; logic:antecedent math:twGuard ; logic:consequent math:twOr .
math:twGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:Theorem ] .
math:twOr a logic:Formula ; logic:or math:twProof , math:twWarrant .
math:twProof a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] ;
    logic:exists math:twProofAtom .
math:twProofAtom a logic:Formula ; logic:relation math:provesStatement ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
math:twWarrant a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "w" ] ;
    logic:exists math:twWarrantAtom .
math:twWarrantAtom a logic:Formula ; logic:relation math:externalWarrant ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "w" ] .

# A math:Chart's math:targetCoordinateSpace has the same math:spaceDimension as
# its manifold's math:manifoldDimension; a chart into a wrong-dimensional space is
# a math:DimensionMismatch. A cross-node numeric inequality — a raw formula.
math:ChartDimensionMatchConstraint
    a logic:Constraint ;
    rdfs:label "Chart dimension-match constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a math:Chart's target coordinate space dimension equals its manifold's dimension."@x-gmeow-english ;
    logic:formalizes math:ChartDimensionShape ;
    gmeow:enforcesFailureClass math:DimensionMismatch ;
    logic:message "A math:Chart's target coordinate space dimension does not equal its manifold's dimension (math:DimensionMismatch)." ;
    logic:integrity math:cdForall .
math:cdForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:cdImpl .
math:cdImpl a logic:Formula ; logic:antecedent math:cdGuard ; logic:consequent math:cdNot .
math:cdGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:Chart ] .
math:cdNot a logic:Formula ; logic:not math:cdExists .
math:cdExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "m" ] ,
                             [ logic:termIndex 1 ; logic:termVariable "md" ] ,
                             [ logic:termIndex 2 ; logic:termVariable "t" ] ,
                             [ logic:termIndex 3 ; logic:termVariable "sd" ] ;
    logic:exists math:cdBody .
math:cdBody a logic:Formula ; logic:and math:cdA1 , math:cdA2 , math:cdA3 , math:cdA4 , math:cdA5 .
math:cdA1 a logic:Formula ; logic:relation math:hasChart ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "m" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
math:cdA2 a logic:Formula ; logic:relation math:manifoldDimension ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "m" ] , [ logic:termIndex 1 ; logic:termVariable "md" ] .
math:cdA3 a logic:Formula ; logic:relation math:targetCoordinateSpace ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "t" ] .
math:cdA4 a logic:Formula ; logic:relation math:spaceDimension ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "t" ] , [ logic:termIndex 1 ; logic:termVariable "sd" ] .
math:cdA5 a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "md" ] , [ logic:termIndex 1 ; logic:termVariable "sd" ] .

# A math:MathematicalExpression that participates in checking, normalization,
# evaluation, or content-projection — carrying a math:normalForm,
# math:compilesToLogicFormula, or math:expressionType edge — must also carry at
# least one structured-child edge (math:argumentSlot, math:boundVariable,
# math:hasMathematicalSymbol, or math:literalValue); an expression carrying none
# of the four is represented only by a string. The obligation is CONDITIONAL on
# one of three alternative triggering edges rather than unconditional over the
# whole class, so no single class-scoped OWL/RDFS restriction (EL-safe or
# otherwise) can express it — a restriction binds unconditionally to every
# instance of its class, never "if property A, B, or C, then property D, E, F,
# or G". This is exactly the shape SHACL Core cannot express either (an
# sh:or gated by another sh:or is a SHACL-SPARQL-shaped obligation), so it is
# authored as a raw logic:Formula projecting to sh:SPARQLConstraint, mirroring
# math:TheoremWarrantConstraint's guard/or-of-exists shape.
math:StringOnlyComputableExpressionConstraint
    a logic:Constraint ;
    rdfs:label "String-only computable expression constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a math:MathematicalExpression carrying a math:normalForm, math:compilesToLogicFormula, or math:expressionType edge must also carry at least one of math:argumentSlot, math:boundVariable, math:hasMathematicalSymbol, or math:literalValue; an expression with none of the four is represented only by a string (math:StringOnlyComputableExpression)."@x-gmeow-english ;
    logic:formalizes math:StringOnlyComputableExpressionShape ;
    gmeow:enforcesFailureClass math:StringOnlyComputableExpression ;
    logic:severity "Violation" ;
    logic:message "A math:MathematicalExpression carrying a math:normalForm, math:compilesToLogicFormula, or math:expressionType edge must also carry at least one structured-child edge (math:argumentSlot, math:boundVariable, math:hasMathematicalSymbol, or math:literalValue); an expression represented only by a string is ill-formed (math:StringOnlyComputableExpression)." ;
    logic:integrity math:sceForall .
math:sceForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:sceImpl .
math:sceImpl a logic:Formula ; logic:antecedent math:sceGuard ; logic:consequent math:sceOr .
math:sceGuard a logic:Formula ; logic:and math:sceTypeGuard , math:sceTrigger .
math:sceTypeGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:MathematicalExpression ] .
math:sceTrigger a logic:Formula ; logic:or math:sceTrigNormalForm , math:sceTrigLogicFormula , math:sceTrigExprType .
math:sceTrigNormalForm a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "nf" ] ;
    logic:exists math:sceTrigNormalFormAtom .
math:sceTrigNormalFormAtom a logic:Formula ; logic:relation math:normalForm ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "nf" ] .
math:sceTrigLogicFormula a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "lf" ] ;
    logic:exists math:sceTrigLogicFormulaAtom .
math:sceTrigLogicFormulaAtom a logic:Formula ; logic:relation math:compilesToLogicFormula ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "lf" ] .
math:sceTrigExprType a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "et" ] ;
    logic:exists math:sceTrigExprTypeAtom .
math:sceTrigExprTypeAtom a logic:Formula ; logic:relation math:expressionType ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "et" ] .
math:sceOr a logic:Formula ; logic:or math:sceHasArgSlot , math:sceHasBoundVar , math:sceHasSymbol , math:sceHasLiteral .
math:sceHasArgSlot a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "slot" ] ;
    logic:exists math:sceHasArgSlotAtom .
math:sceHasArgSlotAtom a logic:Formula ; logic:relation math:argumentSlot ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "slot" ] .
math:sceHasBoundVar a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "bv" ] ;
    logic:exists math:sceHasBoundVarAtom .
math:sceHasBoundVarAtom a logic:Formula ; logic:relation math:boundVariable ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "bv" ] .
math:sceHasSymbol a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "sym" ] ;
    logic:exists math:sceHasSymbolAtom .
math:sceHasSymbolAtom a logic:Formula ; logic:relation math:hasMathematicalSymbol ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sym" ] .
math:sceHasLiteral a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "lit" ] ;
    logic:exists math:sceHasLiteralAtom .
math:sceHasLiteralAtom a logic:Formula ; logic:relation math:literalValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "lit" ] .

# A math:MathematicalStatement's epistemic role (math:statementRole) is always
# held under a named, versioned theory: math:roleInTheory is asserted on the
# SAME statement subject that carries the role (see e.g. the bottleneck
# stability theorem example, which carries both math:statementRole and
# math:roleInTheory on one node) — a role individual such as math:roleTheorem is
# a shared, closed-world value individual and cannot itself carry a
# per-statement theory context. A statement that names a role but no theory is
# unscoped. Guarded by type and by the statementRole edge (both quantified in
# one forall, mirroring math:ArgumentSlotContiguityConstraint's ascAllSlots
# double-quantifier idiom), requiring existence of math:roleInTheory.
math:UnscopedStatementRoleConstraint
    a logic:Constraint ;
    rdfs:label "Unscoped statement-role constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a math:MathematicalStatement that carries a math:statementRole must also carry a math:roleInTheory; a statement with a role but no theory context is unscoped (math:UnscopedStatementRole)."@x-gmeow-english ;
    logic:formalizes math:UnscopedStatementRoleShape ;
    gmeow:enforcesFailureClass math:UnscopedStatementRole ;
    logic:severity "Violation" ;
    logic:message "A math:MathematicalStatement that carries a math:statementRole must also carry a math:roleInTheory; a statement with a role but no theory context is unscoped (math:UnscopedStatementRole)." ;
    logic:integrity math:usrForall .
math:usrForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termVariable "role" ] ;
    logic:forall math:usrImpl .
math:usrImpl a logic:Formula ; logic:antecedent math:usrGuard ; logic:consequent math:usrExists .
math:usrGuard a logic:Formula ; logic:and math:usrTypeGuard , math:usrRoleAtom .
math:usrTypeGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:MathematicalStatement ] .
math:usrRoleAtom a logic:Formula ; logic:relation math:statementRole ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "role" ] .
math:usrExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "theory" ] ;
    logic:exists math:usrTheoryAtom .
math:usrTheoryAtom a logic:Formula ; logic:relation math:roleInTheory ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "theory" ] .

# Every math:normalForm edge (source, target) must have a node TYPED
# math:NormalizationDeclaration naming that SAME pair through
# math:normalizes/math:normalizesTo — the attributed reason FOR the edge, never a
# replacement for it. A guard/exists shape, mirroring
# math:FormalVerificationResultVantageGroundingConstraint's fvrGuard/fvrExists idiom, with
# the guard a direct relation atom (math:normalForm) rather than an rdf:type atom, as
# math:ExtendedRealValueConstraint's erGuard does for math:extendedRealValue below. The
# existential body itself DOES carry an rdf:type atom (math:unfDeclType, mirroring
# math:pvfTestType's identical shape further down in this file) so that ANY node merely
# carrying the two mediating edges — never mind whether it is actually declared a
# math:NormalizationDeclaration — can no longer discharge this gate; only a genuine
# declaration can.
math:UndeclaredNormalFormConstraint
    a logic:Constraint ;
    rdfs:label "Undeclared normal-form constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every math:normalForm edge from a source expression to a target expression must have a node TYPED math:NormalizationDeclaration naming that SAME pair (math:normalizes the source, math:normalizesTo the target); a math:normalForm edge with no matching, correctly-typed declaration is undeclared (math:UndeclaredNormalForm)."@x-gmeow-english ;
    logic:formalizes math:UndeclaredNormalFormShape ;
    gmeow:enforcesFailureClass math:UndeclaredNormalForm ;
    logic:severity "Violation" ;
    logic:message "Every math:normalForm edge (source, target) must have a node typed math:NormalizationDeclaration naming that same pair through math:normalizes and math:normalizesTo; an edge with no matching, correctly-typed declaration is undeclared (math:UndeclaredNormalForm)." ;
    logic:integrity math:unfForall .
math:unfForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "target" ] ;
    logic:forall math:unfImpl .
math:unfImpl a logic:Formula ; logic:antecedent math:unfGuard ; logic:consequent math:unfExists .
math:unfGuard a logic:Formula ; logic:relation math:normalForm ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "target" ] .
math:unfExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "decl" ] ;
    logic:exists math:unfBody .
math:unfBody a logic:Formula ; logic:and math:unfDeclType , math:unfDeclSource , math:unfDeclTarget .
math:unfDeclType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "decl" ] , [ logic:termIndex 1 ; logic:termIri math:NormalizationDeclaration ] .
math:unfDeclSource a logic:Formula ; logic:relation math:normalizes ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "decl" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
math:unfDeclTarget a logic:Formula ; logic:relation math:normalizesTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "decl" ] , [ logic:termIndex 1 ; logic:termVariable "target" ] .

# A math:NormalizationDeclaration held at math:structuralNormalization requires its
# math:normalizes source and math:normalizesTo target to carry EQUAL math:structuralKey
# values. Missing either key is folded into the SAME violation: the existential witness
# the consequent requires (a source key, a target key, and their equality) simply has none
# to find, so no separate disjunction is needed for the missing-key case (a deliberate
# judgment call — mirroring how math:RiemannianSignatureConstraint's rieExists idiom
# conjoins several existence atoms with the property they must jointly satisfy).
math:FalseStructuralNormalizationClaimConstraint
    a logic:Constraint ;
    rdfs:label "False structural-normalization claim constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a math:NormalizationDeclaration held at math:structuralNormalization requires its math:normalizes source and math:normalizesTo target to carry EQUAL math:structuralKey values. A mismatch is a false claim; so is either end carrying no math:structuralKey at all, since the existential witness the constraint requires (a source key, a target key, and their equality) simply has none to find — a structural claim is checked directly against the computed digests, never asserted on faith."@x-gmeow-english ;
    logic:formalizes math:FalseStructuralNormalizationClaimShape ;
    gmeow:enforcesFailureClass math:FalseStructuralNormalizationClaim ;
    logic:severity "Violation" ;
    logic:message "A math:NormalizationDeclaration held at math:structuralNormalization must have its math:normalizes source and math:normalizesTo target carry equal math:structuralKey values; a mismatch, or either end missing its key, is a false structural-normalization claim (math:FalseStructuralNormalizationClaim)." ;
    logic:integrity math:fsnForall .
math:fsnForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:fsnImpl .
math:fsnImpl a logic:Formula ; logic:antecedent math:fsnGuard ; logic:consequent math:fsnExists .
math:fsnGuard a logic:Formula ; logic:and math:fsnTypeGuard , math:fsnStrengthGuard .
math:fsnTypeGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:NormalizationDeclaration ] .
math:fsnStrengthGuard a logic:Formula ; logic:relation math:normalizationStrength ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:structuralNormalization ] .
math:fsnExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "src" ] , [ logic:termIndex 1 ; logic:termVariable "tgt" ] ,
        [ logic:termIndex 2 ; logic:termVariable "srcKey" ] , [ logic:termIndex 3 ; logic:termVariable "tgtKey" ] ;
    logic:exists math:fsnBody .
math:fsnBody a logic:Formula ; logic:and math:fsnSrc , math:fsnTgt , math:fsnSrcKey , math:fsnTgtKey , math:fsnKeyEqual .
math:fsnSrc a logic:Formula ; logic:relation math:normalizes ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "src" ] .
math:fsnTgt a logic:Formula ; logic:relation math:normalizesTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "tgt" ] .
math:fsnSrcKey a logic:Formula ; logic:relation math:structuralKey ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "src" ] , [ logic:termIndex 1 ; logic:termVariable "srcKey" ] .
math:fsnTgtKey a logic:Formula ; logic:relation math:structuralKey ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "tgt" ] , [ logic:termIndex 1 ; logic:termVariable "tgtKey" ] .
math:fsnKeyEqual a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "srcKey" ] , [ logic:termIndex 1 ; logic:termVariable "tgtKey" ] .

# A math:NormalizationDeclaration held at any strength OTHER than
# math:structuralNormalization must carry a math:normalizationProcedure, AND be named by a
# gmeow:Observation (via gmeow:observationResult) that itself carries a gmeow:vantage, AND
# carry a logic:preservationKind — the SAME attribution shape
# math:FormalVerificationResultVantageGroundingConstraint requires of a
# math:FormalVerificationResult, extended with the procedure and preservation-kind atoms a
# normalization claim additionally owes. The "coarser than structural" guard is a single
# logic:termDistinct atom against math:structuralNormalization rather than an enumerated
# disjunction over the other three rungs, since the ladder may grow no further named rungs
# without touching this formula.
math:UnattributedNormalizationConstraint
    a logic:Constraint ;
    rdfs:label "Unattributed normalization constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a math:NormalizationDeclaration held at any math:NormalizationStrength coarser than math:structuralNormalization must carry a math:normalizationProcedure, must be named by a gmeow:Observation (through gmeow:observationResult) that itself carries a gmeow:vantage, and must carry a logic:preservationKind; a coarser-than-structural claim missing any of the three is unattributed (math:UnattributedNormalization)."@x-gmeow-english ;
    logic:formalizes math:UnattributedNormalizationShape ;
    gmeow:enforcesFailureClass math:UnattributedNormalization ;
    logic:severity "Violation" ;
    logic:message "A math:NormalizationDeclaration held at any strength coarser than math:structuralNormalization must carry a math:normalizationProcedure, be named by a gmeow:Observation (via gmeow:observationResult) that carries a gmeow:vantage, and carry a logic:preservationKind; missing any of the three is unattributed (math:UnattributedNormalization)." ;
    logic:integrity math:uanForall .
math:uanForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "str" ] ;
    logic:forall math:uanImpl .
math:uanImpl a logic:Formula ; logic:antecedent math:uanGuard ; logic:consequent math:uanExists .
math:uanGuard a logic:Formula ; logic:and math:uanTypeGuard , math:uanStrengthGuard , math:uanNotStructural .
math:uanTypeGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:NormalizationDeclaration ] .
math:uanStrengthGuard a logic:Formula ; logic:relation math:normalizationStrength ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "str" ] .
math:uanNotStructural a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "str" ] , [ logic:termIndex 1 ; logic:termIri math:structuralNormalization ] .
math:uanExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "proc" ] ,
        [ logic:termIndex 1 ; logic:termVariable "obs" ] ,
        [ logic:termIndex 2 ; logic:termVariable "vantage" ] ,
        [ logic:termIndex 3 ; logic:termVariable "pres" ] ;
    logic:exists math:uanBody .
math:uanBody a logic:Formula ; logic:and math:uanProc , math:uanObsResult , math:uanObsVantage , math:uanPres .
math:uanProc a logic:Formula ; logic:relation math:normalizationProcedure ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "proc" ] .
math:uanObsResult a logic:Formula ; logic:relation gmeow:observationResult ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "obs" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
math:uanObsVantage a logic:Formula ; logic:relation gmeow:vantage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "obs" ] , [ logic:termIndex 1 ; logic:termVariable "vantage" ] .
math:uanPres a logic:Formula ; logic:relation logic:preservationKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "pres" ] .

# A signed-extended-real slot (math:extendedRealValue) holds a value on the extended real
# line ℝ̄ = ℝ ∪ {−∞, +∞}: a finite numeric literal of either sign, or one of the two poles
# math:PositiveInfinity / math:NegativeInfinity. The strongest cleanly-expressible logic:
# form is "the object is a LITERAL (its finite-numeric branch) OR is one of the two poles":
# a literal-nodekind allowance (logic:termIsLiteral) joined by logic:or to a two-member
# value-set membership (logic:termIn) over the poles. This catches a non-literal object (an
# IRI or blank node) that is neither pole — the math:MalformedExtendedReal case. No single
# sugar fits the literal-OR-one-of-two-individuals disjunction, so it is a raw formula, and
# the guard math:extendedRealValue(?s, this) puts the slot value (this) in object position
# so the projected twin targets sh:targetObjectsOf math:extendedRealValue.
math:ExtendedRealValueConstraint
    a logic:Constraint ;
    rdfs:label "Signed extended-real value constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: the object of math:extendedRealValue — a value on the extended real line ℝ̄ = ℝ ∪ {−∞, +∞} — is a literal (its finite numeric branch) or one of the two poles math:PositiveInfinity / math:NegativeInfinity; a non-literal object that is neither pole is not a point of ℝ̄."@x-gmeow-english ;
    gmeow:enforcesFailureClass math:MalformedExtendedReal ;
    logic:formalizes math:extendedRealValue ;
    logic:message "The object of math:extendedRealValue must be a finite numeric literal, math:PositiveInfinity, or math:NegativeInfinity; a non-literal value (an IRI or blank node) that is neither pole is not a point of the extended real line ℝ̄ (math:MalformedExtendedReal)." ;
    logic:integrity math:erForall .
math:erForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ,
                             [ logic:termIndex 1 ; logic:termVariable "s" ] ;
    logic:forall math:erImpl .
math:erImpl a logic:Formula ; logic:antecedent math:erGuard ; logic:consequent math:erDisj .
math:erGuard a logic:Formula ; logic:relation math:extendedRealValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
math:erDisj a logic:Formula ; logic:or math:erLiteral , math:erPole .
math:erLiteral a logic:Formula ; logic:relation logic:termIsLiteral ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] .
math:erPole a logic:Formula ; logic:relation logic:termIn ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
                   [ logic:termIndex 1 ; logic:termIri math:PositiveInfinity ] ,
                   [ logic:termIndex 2 ; logic:termIri math:NegativeInfinity ] .

# A math:LimitResult's math:limitResultValue must AGREE with its math:limitOutcome:
# a math:convergesFinitely result carries a finite (literal) value; a
# math:divergesToPositiveInfinity result's value is the pole math:PositiveInfinity and a
# math:divergesToNegativeInfinity result's value is math:NegativeInfinity; a
# math:divergesWithoutLimit result carries NO value at all. A conjunction of four
# outcome-guarded implications over the result node — a raw formula, since no single
# sugar fits the literal-vs-pole-vs-absent case analysis. Each pole branch is an
# existential (logic:exists) requiring the value to be present and equal to the pole
# (the singleton logic:termIn membership committed by math:erPole above), the finite
# branch requires the value to be a literal (logic:termIsLiteral, as math:erLiteral),
# and the no-limit branch forbids any value (logic:not over an existential, as
# math:cdNot). The max-one math:limitResultValue cardinality makes "the value is P"
# and "some value is P" coincide, so the existential is exact.
math:LimitResultOutcomeValueConstraint
    a logic:Constraint ;
    rdfs:label "Limit-result outcome/value agreement constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a math:LimitResult's math:limitResultValue agrees with its math:limitOutcome — a finite (literal) value for math:convergesFinitely, math:PositiveInfinity for math:divergesToPositiveInfinity, math:NegativeInfinity for math:divergesToNegativeInfinity, and no value at all for math:divergesWithoutLimit."@x-gmeow-english ;
    gmeow:enforcesFailureClass math:UnderspecifiedLimitResult ;
    logic:formalizes math:LimitResult ;
    logic:message "A math:LimitResult's math:limitResultValue must agree with its math:limitOutcome: a finite numeric literal for math:convergesFinitely, math:PositiveInfinity for math:divergesToPositiveInfinity, math:NegativeInfinity for math:divergesToNegativeInfinity, and no value for math:divergesWithoutLimit; a value that disagrees with the declared outcome is ill-formed (math:UnderspecifiedLimitResult)." ;
    logic:integrity math:lrvForall .
math:lrvForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:lrvImpl .
math:lrvImpl a logic:Formula ; logic:antecedent math:lrvGuard ; logic:consequent math:lrvCases .
math:lrvGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:LimitResult ] .
math:lrvCases a logic:Formula ; logic:and math:lrvFinite , math:lrvPosInf , math:lrvNegInf , math:lrvNoLimit .

# convergesFinitely ⟹ ∃ v ( limitResultValue(this, v) ∧ v is a literal )
math:lrvFinite a logic:Formula ; logic:antecedent math:lrvFiniteGuard ; logic:consequent math:lrvFiniteExists .
math:lrvFiniteGuard a logic:Formula ; logic:relation math:limitOutcome ;
