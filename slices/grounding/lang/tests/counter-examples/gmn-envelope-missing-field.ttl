# Counter-example: a gmeow:GmnEnvelope missing exactly ONE of its nine contract fields —
# the boundary ring (gmeow:gmnSecurityRing) is absent (fires lang:GmnMissingEnvelopeField
# via sh:qualifiedMinCount 1 on the derived gmeow:GmnEnvelope-shape). The other eight fields are all
# present and well-formed, so exactly the one MinCount finding is emitted.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

ex:archiveTeam a gmeow:Agent .
ex:gmnWriterRun a gmeow:Activity .

ex:corrEnvelope a logic:Correspondence ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:SectionRetraction ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true .

# The ring is missing: an envelope whose payload was never admitted under a boundary ring.
ex:envelopeNoRing a gmeow:GmnEnvelope ;
    gmeow:gmnSchemaVersion "1" ;
    gmeow:gmnDictionaryVersion "3" ;
    gmeow:gmnGlyphTableVersion "2" ;
    gmeow:accordingTo ex:archiveTeam ;
    gmeow:wasGeneratedBy ex:gmnWriterRun ;
    gmeow:contentDigest "blake3:0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e" ;
    gmeow:gmnCodebookDigest "blake3:f93d8b8380cb11f90800342edd0867193d8d6006b5f7c033dee2f3db66c9ae43" ;
    gmeow:gmnEnvelopeCorrespondence ex:corrEnvelope .
