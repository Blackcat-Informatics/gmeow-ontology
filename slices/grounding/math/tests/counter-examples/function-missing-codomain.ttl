#
# Counter-example for math:FunctionFramingShape: a math:Function that declares its
# math:domain but omits its math:codomain (sh:minCount 1), so validation MUST emit
# shacl.MinCountConstraintComponent (and no other finding).
# Bound by tests/example-conformance.ttl (ex:ecFunctionMissingCodomain).
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <http://example.org/math/> .

ex:unframedFunction a math:Function ;
    math:domain ex:domainSet .

ex:domainSet a math:Set .
