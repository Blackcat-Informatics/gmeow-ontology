@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix vann:  <http://purl.org/vocab/vann/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/math>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    vann:preferredNamespacePrefix "math" ;
    vann:preferredNamespaceUri "https://blackcatinformatics.ca/math/" ;
    rdfs:comment "Grounding vocabulary for GMEOW Mathematics. The math: namespace <https://blackcatinformatics.ca/math/> is the grounding surface for the primitive mathematical objects — number systems and exactness, arithmetic, sets, and relations and functions — that every other mathematical charter quantifies, indexes, maps, and measures over. It is a peer of logic:; the intensional-set condition denotes a logic: formula and the preservation-polarity vocabulary is reused verbatim from the logic: loss ledger rather than re-minted. The object-layer parents (math:Set, math:Function, math:Operation, math:Relation, math:MathematicalExpression) are minted here as the ground the bedrock builds on."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "GMEOW Mathematics"@x-gmeow-english ;
    skos:definition "The GMEOW Mathematics module — home of the math: grounding vocabulary. Its single discipline is that exactness is explicit: a number declares the system it lives in (the containment tower ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ), an exact value and an approximation of it are distinct objects, and a named constant is an exact individual anchored to an external authority rather than a decimal literal. A set is given extensionally by its elements or intensionally by a condition that denotes a logic: formula, never both silently; a function declares its domain and codomain. The typed conformance-failure vocabulary (math:MathConformanceFailure and its subclasses) makes every well-formedness violation a queryable object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Number systems and exactness
# =========================================================================== #

math:Number
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Number"@x-gmeow-english ;
    skos:definition "A mathematical number: an abstract quantity that lives in a declared number system. Every math:Number situates itself in a math:NumberSystem through math:inNumberSystem — an unsituated number is ill-formed — and declares through math:isExact whether it is an exact value or the abstract counterpart that a math:ApproximateValue approximates. The five nested systems ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ are its principal subclasses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:NaturalNumber
    a owl:Class ;
    rdfs:subClassOf math:Integer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Natural Number"@x-gmeow-english ;
    skos:definition "A natural number (ℕ): a non-negative counting number. The innermost system of the containment tower ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ — every natural number is an integer, so this is a subclass of math:Integer. Situated in the math:naturalNumbers system."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Integer
    a owl:Class ;
    rdfs:subClassOf math:RationalNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Integer"@x-gmeow-english ;
    skos:definition "An integer (ℤ): a whole number, positive, negative, or zero. Every integer is a rational number (n = n/1), so this is a subclass of math:RationalNumber. Situated in the math:integers system."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RationalNumber
    a owl:Class ;
    rdfs:subClassOf math:RealNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Rational Number"@x-gmeow-english ;
    skos:definition "A rational number (ℚ): a ratio p/q of integers with q ≠ 0. Every rational number is a real number, so this is a subclass of math:RealNumber. Situated in the math:rationalNumbers system. A rational number is exact; its finite or repeating decimal is an approximation carried by a distinct math:ApproximateValue."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RealNumber
    a owl:Class ;
    rdfs:subClassOf math:ComplexNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Real Number"@x-gmeow-english ;
    skos:definition "A real number (ℝ): a point on the continuous number line, rational or irrational. Every real number is a complex number with zero imaginary part, so this is a subclass of math:ComplexNumber. Situated in the math:realNumbers system."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ComplexNumber
    a owl:Class ;
    rdfs:subClassOf math:Number ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Complex Number"@x-gmeow-english ;
    skos:definition "A complex number (ℂ): a value a + bi with real part a and imaginary part b. The outermost system of the containment tower; a subclass of math:Number. Situated in the math:complexNumbers system."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AlgebraicNumber
    a owl:Class ;
    rdfs:subClassOf math:ComplexNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Algebraic Number"@x-gmeow-english ;
    skos:definition "An algebraic number: a complex number that is a root of a non-zero polynomial with rational coefficients (for example √2 or the golden ratio). A subclass of math:ComplexNumber, cross-cutting the ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ tower — the algebraic numbers are closed under the field operations but are not one of the nested systems. Its complement within ℂ is the transcendental numbers."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:TranscendentalNumber
    a owl:Class ;
    rdfs:subClassOf math:ComplexNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Transcendental Number"@x-gmeow-english ;
    skos:definition "A transcendental number: a complex number that is not algebraic — not a root of any non-zero polynomial with rational coefficients (for example π and e). A subclass of math:ComplexNumber. Named transcendental constants such as π and e are exact math:MathematicalConstant individuals, never decimal literals."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MathematicalConstant
    a owl:Class ;
    rdfs:subClassOf math:Number ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Mathematical Constant"@x-gmeow-english ;
    skos:definition "A named mathematical constant: an exact number with a canonical identity, such as π, e, or the Euler–Mascheroni constant γ. A subclass of math:Number whose instances are exact individuals (math:isExact true) anchored to an external authority — a Wikidata QID and, where applicable, an OEIS or DLMF locator, recorded as a math: alignment. A constant is never given as a decimal literal; its decimal expansion belongs to a distinct math:ApproximateValue that math:approximates it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ApproximateValue
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Approximate Value"@x-gmeow-english ;
    skos:definition "A finite approximation of an exact number: a value that names, through math:approximates, the exact math:Number it stands in for and, through math:approximationError, how far it may deviate. It carries the concrete numeric literal (math:quantityValue) in a declared floating-point datatype (math:numericDatatype, subsuming xsd:double / xsd:float). An approximate value and the exact number it approximates are distinct objects and are never conflated — this is the object that holds the decimal so the exact number need not."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:NumberSystem
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Number System"@x-gmeow-english ;
    skos:definition "A number system: the domain a number is situated in — ℕ, ℤ, ℚ, ℝ, or ℂ. A subclass of math:Set — a number system IS the set of its numbers, so it can serve as the math:domain or math:codomain of a function (the complex plane ℂ is the domain of the gamma function). Its instances are the five named systems math:naturalNumbers, math:integers, math:rationalNumbers, math:realNumbers, and math:complexNumbers, ordered by math:subsystemOf into the containment tower ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ. A math:Number points at one through math:inNumberSystem."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Number-system individuals (the containment tower) ---------------------- #

math:naturalNumbers
    a owl:NamedIndividual , math:NumberSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "natural numbers (ℕ)"@x-gmeow-english ;
    skos:definition "The system of natural numbers ℕ — the non-negative counting numbers. The innermost system; math:subsystemOf math:integers."@x-gmeow-english ;
    math:subsystemOf math:integers .

math:integers
    a owl:NamedIndividual , math:NumberSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "integers (ℤ)"@x-gmeow-english ;
    skos:definition "The system of integers ℤ — the whole numbers. math:subsystemOf math:rationalNumbers."@x-gmeow-english ;
    math:subsystemOf math:rationalNumbers .

math:rationalNumbers
    a owl:NamedIndividual , math:NumberSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "rational numbers (ℚ)"@x-gmeow-english ;
    skos:definition "The system of rational numbers ℚ — ratios of integers. math:subsystemOf math:realNumbers."@x-gmeow-english ;
    math:subsystemOf math:realNumbers .

math:realNumbers
    a owl:NamedIndividual , math:NumberSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "real numbers (ℝ)"@x-gmeow-english ;
    skos:definition "The system of real numbers ℝ — the continuous number line. math:subsystemOf math:complexNumbers."@x-gmeow-english ;
    math:subsystemOf math:complexNumbers .

math:complexNumbers
    a owl:NamedIndividual , math:NumberSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "complex numbers (ℂ)"@x-gmeow-english ;
    skos:definition "The system of complex numbers ℂ — the outermost system of the containment tower. The top of the math:subsystemOf order."@x-gmeow-english .

# --- Named exact constants -------------------------------------------------- #

math:pi
    a owl:NamedIndividual , math:MathematicalConstant , math:TranscendentalNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "π"@x-gmeow-english ;
    skos:definition "The constant π: the exact ratio of a circle's circumference to its diameter, a transcendental real number. An exact individual (math:isExact true) situated in the real numbers; its external anchors (Wikidata, OEIS) are recorded as math: alignments. Its decimal expansion 3.14159… is a distinct math:ApproximateValue, never asserted on this individual."@x-gmeow-english ;
    math:inNumberSystem math:realNumbers ;
    math:isExact true .

math:eulerNumber
    a owl:NamedIndividual , math:MathematicalConstant , math:TranscendentalNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "e"@x-gmeow-english ;
    skos:definition "The constant e: the exact base of the natural logarithm, a transcendental real number. An exact individual (math:isExact true) situated in the real numbers; its external anchors (Wikidata, OEIS) are recorded as math: alignments. Its decimal expansion 2.71828… is a distinct math:ApproximateValue."@x-gmeow-english ;
    math:inNumberSystem math:realNumbers ;
    math:isExact true .

math:eulerMascheroni
    a owl:NamedIndividual , math:MathematicalConstant ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "γ"@x-gmeow-english ;
    skos:definition "The Euler–Mascheroni constant γ: the exact limiting difference between the harmonic series and the natural logarithm, a real number whose rationality is unknown. An exact individual (math:isExact true) situated in the real numbers; its external anchors (Wikidata, OEIS) are recorded as math: alignments. Its decimal expansion 0.57721… is a distinct math:ApproximateValue."@x-gmeow-english ;
    math:inNumberSystem math:realNumbers ;
    math:isExact true .

# =========================================================================== #
# Arithmetic (builds on the object-layer math:Operation and math:Expression)
# =========================================================================== #

math:Operation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Operation"@x-gmeow-english ;
    skos:definition "A mathematical operation: a map from operands to a result, applied within an expression. The object-layer parent that math:ArithmeticOperation specializes; richer structure (arity, operand structure preservation) belongs to the mathematical-core surface that this bedrock builds on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ArithmeticOperation
    a owl:Class ;
    rdfs:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Arithmetic Operation"@x-gmeow-english ;
    skos:definition "An arithmetic operation over numbers: addition, multiplication, exponentiation, and their inverses. A subclass of math:Operation; the concrete operators are named individuals (math:Addition, math:Multiplication, math:Exponentiation, math:Subtraction, math:Division, math:Root, math:Logarithm). Anchored externally to the OpenMath arith1 and nums1 content dictionaries. An arithmetic expression applies one such operator inside a math:ApplicationExpression."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MathematicalExpression
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Mathematical Expression"@x-gmeow-english ;
    skos:definition "The abstract root of the mathematical expression tree: a computable form is an abstract syntax tree, not a display string. The object-layer parent the bedrock references; the full expression grammar (literals, variables, indexed argument slots, binding and scope) belongs to the mathematical-core surface this bedrock builds on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ApplicationExpression
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Application Expression"@x-gmeow-english ;
    skos:definition "The application of an operator to operands: the expression node an arithmetic operation lowers to. Its single operator is named through math:operator; the indexed argument-slot machinery that fixes operand order belongs to the mathematical-core surface this bedrock builds on, and is deliberately not minted here."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:operator
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "operator"@x-gmeow-english ;
    skos:definition "The single operator a math:ApplicationExpression applies: relates an application to the math:Operation (for example a math:ArithmeticOperation individual) it invokes. Domain math:ApplicationExpression, range math:Operation (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Arithmetic operator individuals ---------------------------------------- #

math:Addition
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "addition"@x-gmeow-english ;
    skos:definition "The binary addition operator (+). Its inverse is math:Subtraction. OpenMath arith1 plus."@x-gmeow-english .

math:Subtraction
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "subtraction"@x-gmeow-english ;
    skos:definition "The binary subtraction operator (−), the inverse of math:Addition. OpenMath arith1 minus."@x-gmeow-english .

math:Multiplication
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "multiplication"@x-gmeow-english ;
    skos:definition "The binary multiplication operator (×). Its inverse is math:Division. OpenMath arith1 times."@x-gmeow-english .

math:Division
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "division"@x-gmeow-english ;
    skos:definition "The binary division operator (÷), the inverse of math:Multiplication. OpenMath arith1 divide."@x-gmeow-english .

math:Exponentiation
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exponentiation"@x-gmeow-english ;
    skos:definition "The exponentiation operator (a^b). Its inverses are math:Root (recovering the base) and math:Logarithm (recovering the exponent). OpenMath arith1 power."@x-gmeow-english .

math:Root
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "root"@x-gmeow-english ;
    skos:definition "The root operator (the b-th root of a), an inverse of math:Exponentiation that recovers the base. OpenMath arith1 root."@x-gmeow-english .

math:Logarithm
    a owl:NamedIndividual , math:ArithmeticOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "logarithm"@x-gmeow-english ;
    skos:definition "The logarithm operator (log_b of a), an inverse of math:Exponentiation that recovers the exponent. OpenMath transc1 log."@x-gmeow-english .

# =========================================================================== #
# Sets and their construction
# =========================================================================== #

math:Set
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Set"@x-gmeow-english ;
    skos:definition "A mathematical set: a collection of distinct elements, given either extensionally (its members enumerated through math:hasElement — see math:FiniteSet) or intensionally (a defining condition through math:memberCondition — see math:SetBuilderExpression). A set is extensional or intensional, not silently both without a declared equality. Anchored externally to the OpenMath set1 content dictionary. The object-layer parent the bedrock builds on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FiniteSet
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Finite Set"@x-gmeow-english ;
    skos:definition "A set given extensionally by enumerating its finitely many elements through math:hasElement. Its cardinality (math:hasCardinality) is a finite math:Cardinality. The extensional counterpart of the intensional math:SetBuilderExpression."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SetBuilderExpression
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Set-Builder Expression"@x-gmeow-english ;
    skos:definition "A set given intensionally by a defining condition — the { x | φ(x) } form. Its condition is named through math:memberCondition and denotes a logic: formula, the denotation seam, never an opaque string. The intensional counterpart of the extensional math:FiniteSet."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Membership
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Membership"@x-gmeow-english ;
    skos:definition "A reified membership fact: that a particular element belongs to a particular set (x ∈ S). Reifying membership lets a claim of membership carry its own provenance or justification, distinct from the bare math:hasElement edge on an extensional set."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SetOperation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Set Operation"@x-gmeow-english ;
    skos:definition "An operation constructing a set from operand sets — union, intersection, difference, or complement. Its operands are named through math:setOperationOn. The complement construction is the distinguished subclass math:Complement, which additionally names its ambient set through math:complementWithin; an unqualified complement is ill-formed. math:PowerSet and math:CartesianProduct are distinguished constructions with their own classes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Complement
    a owl:Class ;
    rdfs:subClassOf math:SetOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Complement"@x-gmeow-english ;
    skos:definition "The complement construction Sᶜ = U ∖ S: the set of elements of an ambient set U that are not in S. A subclass of math:SetOperation that always names its ambient set through math:complementWithin — a complement is relative to an ambient set, so an unqualified complement is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PowerSet
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Power Set"@x-gmeow-english ;
    skos:definition "The power set 𝒫(S): the set of all subsets of a base set, named through math:setOperationOn. Itself a set, so a subclass of math:Set. For a finite base of cardinality n its cardinality is 2ⁿ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CartesianProduct
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cartesian Product"@x-gmeow-english ;
    skos:definition "The Cartesian product A × B: the set of ordered pairs drawn from operand sets named through math:setOperationOn. Itself a set, so a subclass of math:Set. A math:Relation is a subset of a Cartesian product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Cardinality
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cardinality"@x-gmeow-english ;
    skos:definition "The size of a set: a finite count, ℵ₀ (countably infinite), 𝔠 (the cardinality of the continuum), or a larger cardinal. A set names its size through math:hasCardinality. The distinguished infinite cardinals are the individuals math:cardinalityFinite, math:alephNull, and math:continuum."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:cardinalityFinite
    a owl:NamedIndividual , math:Cardinality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "finite"@x-gmeow-english ;
    skos:definition "The cardinality class of any finite set — a set in bijection with some natural number n. The exact count may additionally be carried as a math:quantityValue."@x-gmeow-english .

math:alephNull
    a owl:NamedIndividual , math:Cardinality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "ℵ₀"@x-gmeow-english ;
    skos:definition "The cardinality ℵ₀ of a countably infinite set — a set in bijection with ℕ, such as ℤ or ℚ."@x-gmeow-english .

math:continuum
    a owl:NamedIndividual , math:Cardinality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "𝔠"@x-gmeow-english ;
    skos:definition "The cardinality 𝔠 of the continuum — the cardinality of ℝ, equal to 2^ℵ₀."@x-gmeow-english .

# =========================================================================== #
# Relations and functions
# =========================================================================== #

math:Relation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Relation"@x-gmeow-english ;
    skos:definition "A mathematical relation: a subset of a Cartesian product of a domain and a codomain. The object-layer parent of math:Function — a function is a relation with the functional property declared. Anchored externally to the OpenMath relation1 content dictionary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Function
    a owl:Class ;
    rdfs:subClassOf math:Relation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Function"@x-gmeow-english ;
    skos:definition "A function: a relation that assigns to each element of its domain exactly one element of its codomain. Every function declares its math:domain and math:codomain — a function without them is ill-formed — and may declare its math:image. Injectivity, surjectivity, and bijectivity are declared, checkable booleans (math:isInjective, math:isSurjective, math:isBijective), not assumed. Anchored externally to the OpenMath fns1 content dictionary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FunctionSpace
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Function Space"@x-gmeow-english ;
    skos:definition "The set of all functions from a fixed domain to a fixed codomain — the exponential object Bᴬ. Itself a set, so a subclass of math:Set."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:InjectiveFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Injective Function"@x-gmeow-english ;
    skos:definition "A convenience projection of the class of functions with math:isInjective true — an injection, mapping distinct domain elements to distinct codomain elements. The canonical checkable bearer is the boolean math:isInjective; this subclass is a projection over it, not an independent carrier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SurjectiveFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Surjective Function"@x-gmeow-english ;
    skos:definition "A convenience projection of the class of functions with math:isSurjective true — a surjection, whose image is the whole codomain. The canonical checkable bearer is the boolean math:isSurjective; this subclass is a projection over it, not an independent carrier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BijectiveFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Bijective Function"@x-gmeow-english ;
    skos:definition "A convenience projection of the class of functions with math:isBijective true — a bijection, both injective and surjective, hence invertible through math:inverseFunction. The canonical checkable bearer is the boolean math:isBijective; this subclass is a projection over it, not an independent carrier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PartialFunction
    a owl:Class ;
    rdfs:subClassOf math:Relation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Partial Function"@x-gmeow-english ;
    skos:definition "A partial function: a relation that assigns at most one codomain element to each domain element, defined only on a subset of its declared domain. A subclass of math:Relation rather than math:Function, because it is not total on its domain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Conformance-failure vocabulary (typed, queryable violation objects)
# =========================================================================== #

math:MathConformanceFailure
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Math Conformance Failure"@x-gmeow-english ;
    skos:definition "The parent of the math: well-formedness failure vocabulary: a violation is itself a typed, queryable object rather than a log line. Each subclass names one bedrock hard rule, and the SHACL shape enforcing that rule points at its failure class through math:enforcesFailureClass. Conformance enforces well-formedness and preservation, never mathematical or empirical truth."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnsituatedNumber
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unsituated Number"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Number does not declare the math:NumberSystem it belongs to. Every number situates itself in ℕ, ℤ, ℚ, ℝ, or ℂ; an unsituated number is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ExactApproximateConflation
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Exact–Approximate Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ApproximateValue fails to keep an approximation distinct from the exact value — it does not name, through math:approximates, the exact number it stands in for, or does not declare its math:approximationError. An exact number and an approximation of it are distinct objects."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ConstantAsDecimalLiteral
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Constant as Decimal Literal"@x-gmeow-english ;
    skos:definition "The failure raised when a math:MathematicalConstant is given as a decimal literal — it carries a raw math:quantityValue directly instead of being an exact individual. A constant's decimal expansion belongs to a distinct math:ApproximateValue that math:approximates it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:StringOnlyMemberCondition
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "String-Only Member Condition"@x-gmeow-english ;
    skos:definition "The failure raised when a math:SetBuilderExpression names its math:memberCondition as an opaque literal instead of denoting a logic: formula. The intensional condition is the denotation seam; it must denote a formula, never a string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnqualifiedComplement
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unqualified Complement"@x-gmeow-english ;
    skos:definition "The failure raised when a complement math:SetOperation does not name its ambient set through math:complementWithin. A complement is relative to an ambient set; an unqualified complement is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AmbiguousSetExtent
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ambiguous Set Extent"@x-gmeow-english ;
    skos:definition "The failure raised when a set is given both extensionally (math:hasElement) and intensionally (math:memberCondition) without a declared equality. A set is extensional or intensional, not silently both."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnframedFunction
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unframed Function"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Function does not declare both its math:domain and its math:codomain. A function without its frame is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Properties
# =========================================================================== #

# --- Number and exactness properties ---------------------------------------- #

math:inNumberSystem
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "in number system"@x-gmeow-english ;
    skos:definition "Situates a number in the system it belongs to. Domain math:Number, range math:NumberSystem (stated in prose). Every math:Number declares exactly one — an unsituated number is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:subsystemOf
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "subsystem of"@x-gmeow-english ;
    skos:definition "Orders the number systems by containment: math:naturalNumbers ⊑ math:integers ⊑ math:rationalNumbers ⊑ math:realNumbers ⊑ math:complexNumbers. Domain and range math:NumberSystem (stated in prose). Transitive, so the whole ℕ ⊂ ℤ ⊂ ℚ ⊂ ℝ ⊂ ℂ tower is entailed from the adjacent links."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isExact
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is exact"@x-gmeow-english ;
    skos:definition "Declares whether a number is an exact value (true) or the abstract value a math:ApproximateValue approximates. Domain math:Number, range xsd:boolean (stated in prose). A math:MathematicalConstant is always exact."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:approximates
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "approximates"@x-gmeow-english ;
    skos:definition "Names the exact number that an approximation stands in for. Domain math:ApproximateValue, range math:Number (stated in prose). The approximation and the exact number are distinct objects and are never conflated."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:approximationError
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "approximation error"@x-gmeow-english ;
    skos:definition "The magnitude by which an approximation may deviate from the exact value it approximates — an absolute error bound. Domain math:ApproximateValue, range a numeric literal (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:numericDatatype
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "numeric datatype"@x-gmeow-english ;
    skos:definition "Names the canonical RDF datatype in which an approximate value's literal is carried — subsuming the IEEE-754 datatypes xsd:double and xsd:float directly rather than re-minting them. Domain math:ApproximateValue, range an rdfs:Datatype (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:quantityValue
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "quantity value"@x-gmeow-english ;
    skos:definition "The concrete numeric literal a value carries — the floating-point or decimal expansion of a math:ApproximateValue, or the finite count of a cardinality. Domain math:ApproximateValue or math:Cardinality, range a numeric literal (stated in prose). A math:MathematicalConstant never carries this directly; its decimal belongs to a distinct math:ApproximateValue."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Set properties --------------------------------------------------------- #

math:hasElement
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has element"@x-gmeow-english ;
    skos:definition "The canonical extensional membership carrier: relates a set to one of its enumerated members (x ∈ S). Domain math:Set, range any math:MathematicalObject (stated in prose). A math:FiniteSet is given extensionally by its math:hasElement edges."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:memberCondition
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "member condition"@x-gmeow-english ;
    skos:definition "Names the defining condition of an intensional set — the φ in { x | φ(x) }. Domain math:Set (in practice a math:SetBuilderExpression), range a logic: formula (stated in prose). The value denotes a logic: formula, the denotation seam, and is never an opaque literal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:subsetOf
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "subset of"@x-gmeow-english ;
    skos:definition "Relates a set to a set that contains all of its elements (A ⊆ B). Domain and range math:Set (stated in prose). Transitive: A ⊆ B and B ⊆ C entail A ⊆ C. Reflexivity and antisymmetry hold mathematically but are documented in prose, not asserted as OWL characteristics, to keep the term profile-clean."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:setOperationOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "set operation on"@x-gmeow-english ;
    skos:definition "Relates a set-construction (a math:SetOperation, math:PowerSet, or math:CartesianProduct) to an operand set it is built from. Domain math:SetOperation or its siblings, range math:Set (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:complementWithin
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "complement within"@x-gmeow-english ;
    skos:definition "Names the ambient set a complement is taken relative to (the U in Sᶜ = U ∖ S). Domain a complement math:SetOperation, range math:Set (stated in prose). A complement without an ambient set is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasCardinality
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has cardinality"@x-gmeow-english ;
    skos:definition "Names the size of a set. Domain math:Set, range math:Cardinality (stated in prose). A finite set names math:cardinalityFinite and may additionally carry its exact count as a math:quantityValue."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Function properties ---------------------------------------------------- #

math:domain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "domain"@x-gmeow-english ;
    skos:definition "The source set of a function or relation — the set its inputs are drawn from. Domain math:Relation, range math:Set (stated in prose). Every math:Function declares one; a function without a domain is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:codomain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "codomain"@x-gmeow-english ;
    skos:definition "The target set of a function or relation — the set its outputs land in. Domain math:Relation, range math:Set (stated in prose). Every math:Function declares one; a function without a codomain is ill-formed. The codomain is the declared target, distinct from the math:image actually attained."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:image
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "image"@x-gmeow-english ;
    skos:definition "The set of values a function actually attains — the subset of the codomain that is the range of the map. Domain math:Function, range math:Set (stated in prose). A function is surjective exactly when its image equals its codomain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isInjective
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is injective"@x-gmeow-english ;
    skos:definition "Declares whether a function is injective — distinct inputs map to distinct outputs. Domain math:Function, range xsd:boolean (stated in prose). The canonical checkable bearer of injectivity, of which math:InjectiveFunction is a convenience projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isSurjective
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is surjective"@x-gmeow-english ;
    skos:definition "Declares whether a function is surjective — its image is the whole codomain. Domain math:Function, range xsd:boolean (stated in prose). The canonical checkable bearer of surjectivity, of which math:SurjectiveFunction is a convenience projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:isBijective
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "is bijective"@x-gmeow-english ;
    skos:definition "Declares whether a function is bijective — both injective and surjective, hence invertible. Domain math:Function, range xsd:boolean (stated in prose). The canonical checkable bearer of bijectivity, of which math:BijectiveFunction is a convenience projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:functionComposition
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "function composition"@x-gmeow-english ;
    skos:definition "Relates a composite function g ∘ f to a function it is built from. Domain and range math:Function (stated in prose). Composition is non-commutative (g ∘ f ≠ f ∘ g in general), so this order-agnostic super-property — which holds of either component — is refined by math:compositionOuter and math:compositionInner, through which the order-bearing decomposition is asserted. Composition is well-formed when the codomain of the inner function is the domain of the outer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:compositionOuter
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:functionComposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "composition outer"@x-gmeow-english ;
    skos:definition "Relates a composite function g ∘ f to its outer (left) component g — the function applied second, whose math:domain is the math:codomain of the inner component. The order-bearing refinement of math:functionComposition that, together with math:compositionInner, preserves the non-commutative order of composition so g ∘ f is never confused with f ∘ g. Domain and range math:Function (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:compositionInner
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:functionComposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "composition inner"@x-gmeow-english ;
    skos:definition "Relates a composite function g ∘ f to its inner (right) component f — the function applied first, whose math:codomain is the math:domain of the outer component. The order-bearing refinement of math:functionComposition that, together with math:compositionOuter, preserves the non-commutative order of composition so g ∘ f is never confused with f ∘ g. Domain and range math:Function (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:inverseFunction
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "inverse function"@x-gmeow-english ;
    skos:definition "Relates a function to its inverse f⁻¹, defined exactly when the function is bijective. Domain and range math:Function (stated in prose). The relation is symmetric mathematically (the inverse of f⁻¹ is f), documented in prose rather than asserted as an OWL characteristic to keep the term profile-clean."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Bridge and enforcement annotation properties --------------------------- #

math:formalizes
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "formalizes"@x-gmeow-english ;
    skos:definition "A bridge annotation from a math: grounding term to the gmeow: domain concept it formalizes, so the domain term's documentation can surface the formalization without the domain slice ever asserting a math: triple. Subject a math: term, object a gmeow: term, both stated in prose; an annotation property, never a reasoned axiom, so it carries no DL or EL profile weight."@x-gmeow-english .

math:enforcesFailureClass
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "enforces failure class"@x-gmeow-english ;
    skos:definition "Links a SHACL shape to the math:MathConformanceFailure subclass it enforces, so the machine-checked gate and the typed failure vocabulary are cross-referenced: a query can move from a shape to the named failure it raises and back. An annotation property, carried on the shape, never a reasoned axiom."@x-gmeow-english .

# =========================================================================== #
# Algebra — the algebraic-structure hierarchy (ALGEBRA charter)
#
# A structure declares its operations and laws; a map between structures declares
# what it preserves. The laws are logic: formulas (math: expresses, logic: owns
# reasoning): a math:Axiom denotes a logic: formula reached through math:satisfiesAxiom,
# never an opaque string. The hierarchy is subsumption — an AbelianGroup is a Group
# that additionally satisfies a commutativity axiom.
# =========================================================================== #

# --- Object-layer parents the charter builds on --------------------------- #

math:Morphism
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Morphism"@x-gmeow-english ;
    skos:definition "A structure-preserving map between mathematical objects: the object-layer parent of math:Homomorphism. Deliberately NOT a subclass of math:Function — a morphism's math:domain and math:codomain range over math:AlgebraicStructure (or another object), not a bare math:Set, so the set-typed function-framing gate never targets it. What a morphism preserves is declared through math:preservesStructure and its preservation law; richer categorical structure (composition, identity morphisms) belongs to a downstream category charter and is deliberately not minted here."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Axiom
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Axiom"@x-gmeow-english ;
    skos:definition "A stated law a structure satisfies — associativity, commutativity, an identity or inverse law, distributivity. An axiom denotes a logic: formula (the denotation seam, reached in the worked examples as a resource typed both math:Axiom and logic:Formula), never an opaque string: math: expresses the law and logic: owns reasoning over it. A math:AlgebraicStructure names the axioms it satisfies through math:satisfiesAxiom; the object-layer parent the algebra hierarchy builds on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AlgebraicStructure
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Algebraic Structure"@x-gmeow-english ;
    skos:definition "A set equipped with operations satisfying stated axioms: a math:underlyingSet, one or more math:structureOperation, an identity/inverse where they exist, and the math:satisfiesAxiom laws it obeys. A group is not a labelled set — a math:Group asserted without an operation and axioms is ill-formed. The root of the algebraic hierarchy math:Magma … math:Field; substructures are related through math:substructureOf."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Magma
    a owl:Class ;
    rdfs:subClassOf math:AlgebraicStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Magma"@x-gmeow-english ;
    skos:definition "A set with a single closed binary math:structureOperation and no further axioms: the weakest algebraic structure, a subclass of math:AlgebraicStructure. A math:Semigroup is a magma whose operation is associative."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Semigroup
    a owl:Class ;
    rdfs:subClassOf math:Magma ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Semigroup"@x-gmeow-english ;
    skos:definition "A math:Magma whose binary operation is associative — it satisfies the associativity axiom (∀a,b,c: (a·b)·c = a·(b·c)) through math:satisfiesAxiom. A subclass of math:Magma; a math:Monoid is a semigroup with an identity element."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Monoid
    a owl:Class ;
    rdfs:subClassOf math:Semigroup ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Monoid"@x-gmeow-english ;
    skos:definition "A math:Semigroup with a two-sided identity element (∀a: a·e = e·a = a), named through math:identityElement. A subclass of math:Semigroup; a math:Group is a monoid in which every element has an inverse."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Group
    a owl:Class ;
    rdfs:subClassOf math:Monoid ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Group"@x-gmeow-english ;
    skos:definition "A math:Monoid in which every element has a two-sided inverse (∀a ∃a⁻¹: a·a⁻¹ = a⁻¹·a = e), the inverse reached through math:inverseOperation. A subclass of math:Monoid — the central structure of symmetry, of which a math:AutomorphismGroup and a math:WeylGroup are instances. A math:AbelianGroup is a group whose operation additionally commutes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AbelianGroup
    a owl:Class ;
    rdfs:subClassOf math:Group ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Abelian Group"@x-gmeow-english ;
    skos:definition "A math:Group whose operation is commutative (∀a,b: a·b = b·a) — it additionally satisfies the commutativity axiom through math:satisfiesAxiom. A subclass of math:Group; the additive group of a math:Ring is abelian."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Ring
    a owl:Class ;
    rdfs:subClassOf math:AlgebraicStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ring"@x-gmeow-english ;
    skos:definition "A set with two operations — an abelian additive group and an associative multiplication that distributes over addition (∀a,b,c: a·(b+c) = a·b + a·c) — carried as two math:structureOperation with the distributivity axiom through math:satisfiesAxiom. A subclass of math:AlgebraicStructure; a math:CommutativeRing is a ring whose multiplication commutes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CommutativeRing
    a owl:Class ;
    rdfs:subClassOf math:Ring ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Commutative Ring"@x-gmeow-english ;
    skos:definition "A math:Ring whose multiplication commutes (∀a,b: a·b = b·a). A subclass of math:Ring; a math:Field is a commutative ring whose non-zero elements form a group under multiplication, and a math:PolynomialRing is a commutative ring of polynomials."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Field
    a owl:Class ;
    rdfs:subClassOf math:CommutativeRing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Field"@x-gmeow-english ;
    skos:definition "A math:CommutativeRing whose non-zero elements form an abelian group under multiplication — every non-zero element has a multiplicative inverse. A subclass of math:CommutativeRing; ℚ, ℝ, ℂ and the finite fields are fields, the ground over which a math:VectorSpace and Shamir secret sharing are defined."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Module
    a owl:Class ;
    rdfs:subClassOf math:AlgebraicStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Module"@x-gmeow-english ;
    skos:definition "An abelian group with a compatible scalar action of a math:Ring — the generalization of a vector space to scalars from a ring rather than a field. A subclass of math:AlgebraicStructure; a math:VectorSpace is a module over a field."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VectorSpace
    a owl:Class ;
    rdfs:subClassOf math:Module ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vector Space"@x-gmeow-english ;
    skos:definition "A math:Module whose scalars form a math:Field: an abelian group of vectors with a scalar action satisfying the vector-space axioms. A subclass of math:Module — the setting of linear algebra, on which a math:GroupRepresentation realizes a group as linear maps."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Algebra
    a owl:Class ;
    rdfs:subClassOf math:Module ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Algebra"@x-gmeow-english ;
    skos:definition "A math:Module equipped with a bilinear multiplication of its elements — a ring-and-module structure over a base ring, such as a math:LieAlgebra or a matrix algebra. A subclass of math:Module; the vector-space-with-multiplication that carries a Lie bracket in the E8 flagship."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PolynomialRing
    a owl:Class ;
    rdfs:subClassOf math:CommutativeRing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Polynomial Ring"@x-gmeow-english ;
    skos:definition "The commutative ring R[x] of polynomials in one or more indeterminates over a base ring R. A subclass of math:CommutativeRing; the ring a math:Ideal is taken in, and the ring a lattice-based homomorphic-encryption scheme and Shamir secret sharing operate over."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Ideal
    a owl:Class ;
    rdfs:subClassOf math:AlgebraicStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ideal"@x-gmeow-english ;
    skos:definition "A subset of a math:Ring closed under addition and under multiplication by any ring element — the kernel of a ring homomorphism is an ideal, and quotienting a ring by an ideal yields a math:Quotient ring. A subclass of math:AlgebraicStructure, related to its ambient ring through math:substructureOf; the modulus structure a lattice-based encryption scheme reduces against."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Structure properties -------------------------------------------------- #

math:underlyingSet
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "underlying set"@x-gmeow-english ;
    skos:definition "Names the carrier set of an algebraic structure — the elements the operations act on. Domain math:AlgebraicStructure, range math:Set (stated in prose). Every math:AlgebraicStructure declares one; a structure without a carrier is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:structureOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "structure operation"@x-gmeow-english ;
    skos:definition "Names a binary (or n-ary) operation of an algebraic structure — the group operation, or a ring's addition and multiplication. Domain math:AlgebraicStructure, range math:Operation (stated in prose). A ring carries two such operations; a structure with none is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:identityElement
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "identity element"@x-gmeow-english ;
    skos:definition "Names the two-sided identity of a monoid operation (the e with a·e = e·a = a). Domain math:Monoid or a richer structure, range an element of the math:underlyingSet (stated in prose). A math:Group inherits it from math:Monoid."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:inverseOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "inverse operation"@x-gmeow-english ;
    skos:definition "Names the unary inverse map of a group (a ↦ a⁻¹ with a·a⁻¹ = e). Domain math:Group, range math:Operation (stated in prose). The existence of inverses is what distinguishes a math:Group from a math:Monoid."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:satisfiesAxiom
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "satisfies axiom"@x-gmeow-english ;
    skos:definition "Relates an algebraic structure to a math:Axiom it obeys — associativity, commutativity, distributivity. Domain math:AlgebraicStructure, range math:Axiom (stated in prose). The axiom denotes a logic: formula the logic: reasoner owns: math: declares that the structure satisfies the law, logic: reasons over it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:satisfiesDistributivity
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:satisfiesAxiom ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "satisfies distributivity"@x-gmeow-english ;
    skos:definition "Names the distributivity axiom a math:Ring satisfies — multiplication distributes over addition (a·(b+c) = a·b + a·c), the law that makes a two-operation structure a ring rather than two unrelated groups. Domain math:Ring, range a math:Axiom denoting a logic: formula (stated in prose). A refinement of math:satisfiesAxiom: a ring must name a distributivity law specifically, not merely some axiom. A ring without distributivity is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:substructureOf
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "substructure of"@x-gmeow-english ;
    skos:definition "Relates an algebraic structure to a structure of the same kind that contains it and shares its operations — a subgroup within a group, an ideal within a ring. Domain and range math:AlgebraicStructure (stated in prose). Transitive: a subgroup of a subgroup is a subgroup. The kernel of a homomorphism is a math:substructureOf its domain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:preservesStructure
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "preserves structure"@x-gmeow-english ;
    skos:definition "Relates a math:Morphism to a structural feature it preserves — the object-layer primitive that math:preservedOperation refines for homomorphisms. Domain math:Morphism, range an operation or axiom (stated in prose). What a map preserves is declared, not assumed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Structure conformance failure ----------------------------------------- #

math:IncompleteAlgebraicStructure
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Algebraic Structure"@x-gmeow-english ;
    skos:definition "The failure raised when a math:AlgebraicStructure does not declare its constituting parts — a math:underlyingSet, at least one math:structureOperation, and at least one math:satisfiesAxiom law. A group is a set with an operation satisfying stated axioms; a structure asserted without them is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:NonDistributiveRing
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Non-Distributive Ring"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Ring does not declare, through math:satisfiesDistributivity, the distributivity law that ties its two operations together. Distributivity (a·(b+c) = a·b + a·c) is what makes a set with an addition and a multiplication a ring rather than two unrelated groups; a ring asserted without it is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Algebra — structure-preserving maps (homomorphisms) and the quotient/kernel
#
# A homomorphism is a map with a declared preserved operation and a preservation
# law that is a logic: formula (math: expresses, logic: reasons). A symmetry group
# IS an automorphism group; that identity is what makes E8's Weyl action, det, and
# a homomorphic-encryption scheme the same kind of object.
# =========================================================================== #

math:Homomorphism
    a owl:Class ;
    rdfs:subClassOf math:Morphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Homomorphism"@x-gmeow-english ;
    skos:definition "A structure-preserving map between algebraic structures of the same kind: it names, through math:preservedOperation, the operation it carries and, through math:preservationLaw, the logic: formula stating that carrying (φ(a·b) = φ(a)·φ(b)). A subclass of math:Morphism; its math:domain and math:codomain are math:AlgebraicStructure. math:kernel and math:image are first-class. A homomorphism asserted without a preserved operation and law is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GroupHomomorphism
    a owl:Class ;
    rdfs:subClassOf math:Homomorphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Group Homomorphism"@x-gmeow-english ;
    skos:definition "A homomorphism between groups: it preserves the single group operation (φ(a·b) = φ(a)·φ(b)), and its math:kernel is a normal subgroup of the domain. A subclass of math:Homomorphism; the determinant map det: GLₙ → ℝ* is one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RingHomomorphism
    a owl:Class ;
    rdfs:subClassOf math:Homomorphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ring Homomorphism"@x-gmeow-english ;
    skos:definition "A homomorphism between rings: it preserves both addition and multiplication, so it carries two preservation laws, and its math:kernel is an ideal. A subclass of math:Homomorphism; a homomorphic-encryption scheme is a (partial or full) ring homomorphism."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Isomorphism
    a owl:Class ;
    rdfs:subClassOf math:Homomorphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Isomorphism"@x-gmeow-english ;
    skos:definition "A bijective homomorphism — a structure-preserving map with a structure-preserving inverse, so its domain and codomain are the same structure up to relabelling. A subclass of math:Homomorphism; two structures are isomorphic exactly when a declared math:Isomorphism relates them."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Automorphism
    a owl:Class ;
    rdfs:subClassOf math:Isomorphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Automorphism"@x-gmeow-english ;
    skos:definition "An isomorphism of a structure with itself — a symmetry. A subclass of math:Isomorphism whose math:domain and math:codomain are the same structure. The automorphisms of a structure form a math:AutomorphismGroup under composition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AutomorphismGroup
    a owl:Class ;
    rdfs:subClassOf math:Group ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Automorphism Group"@x-gmeow-english ;
    skos:definition "The group of all automorphisms of a structure under composition — the symmetries of that structure. A subclass of math:Group: a symmetry group IS an automorphism group, the identity that makes E8's math:WeylGroup and every symmetry expressible with the same machinery as det and a homomorphic-encryption scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Quotient
    a owl:Class ;
    rdfs:subClassOf math:AlgebraicStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Quotient"@x-gmeow-english ;
    skos:definition "The quotient structure G/N of a structure by a substructure that is compatible with its operation (a normal subgroup, or an ideal) — the structure whose elements are the cosets of N. A subclass of math:AlgebraicStructure. The first isomorphism theorem states G/ker φ ≅ image φ, authored as a logic: formula the reasoner owns."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Homomorphism properties ----------------------------------------------- #

math:preservedOperation
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:preservesStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "preserved operation"@x-gmeow-english ;
    skos:definition "Names an operation a homomorphism carries from domain to codomain (φ(a·b) = φ(a)·φ(b)). Domain math:Homomorphism, range math:Operation (stated in prose). A group homomorphism names one; a ring homomorphism names two (addition and multiplication). The order-agnostic refinement of math:preservesStructure. A homomorphism without a preserved operation is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:preservationLaw
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "preservation law"@x-gmeow-english ;
    skos:definition "Names the law a homomorphism (or a homomorphic-encryption scheme) preserves, as a logic: formula — φ(a·b) = φ(a)·φ(b), or Dec(E(a) ⊗ E(b)) = a ⊕ b. Domain math:Homomorphism, range a logic: formula (stated in prose). The value denotes a logic: formula (the denotation seam, a resource), never an opaque string: math: declares the law and logic: owns reasoning over it. A homomorphism without a preservation law is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:kernel
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "kernel"@x-gmeow-english ;
    skos:definition "Names the kernel of a homomorphism — the substructure of the domain mapped to the identity (for a group homomorphism a normal subgroup, for a ring homomorphism an ideal). Domain math:Homomorphism, range math:AlgebraicStructure (stated in prose). The kernel is a math:substructureOf the domain; the first isomorphism theorem relates it to the math:image through a math:Quotient."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:normalSubgroupOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:substructureOf ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "normal subgroup of"@x-gmeow-english ;
    skos:definition "Relates a normal subgroup to the group that contains it (gNg⁻¹ = N for all g) — the kind of subgroup one can quotient by. Domain and range math:Group (stated in prose); a refinement of math:substructureOf. Not transitive: A ◁ B and B ◁ C do not imply A ◁ C — in A₄ the Klein four-group V₄ ◁ A₄ and a two-element subgroup H ◁ V₄, yet H is not normal in A₄. The math:kernel of a group homomorphism is a math:normalSubgroupOf its domain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Homomorphism conformance failures ------------------------------------- #

math:UnderspecifiedHomomorphism
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Homomorphism"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Homomorphism does not declare both the operation it carries (math:preservedOperation) and its preservation law (math:preservationLaw). A map is a homomorphism only by declaring what it preserves and the law of that preservation; a homomorphism asserted without them is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:StringOnlyPreservationLaw
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "String-Only Preservation Law"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Homomorphism gives its math:preservationLaw as an opaque literal instead of denoting a logic: formula. The preservation law is the denotation seam to logic: reasoning; it must denote a formula (a resource), never a string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnanchoredAutomorphismGroup
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unanchored Automorphism Group"@x-gmeow-english ;
    skos:definition "The failure raised when a math:AutomorphismGroup does not declare, through math:automorphismGroupOf, the structure whose symmetries it collects. Every automorphism group is the symmetry group OF some structure — the invariant that makes E8's Weyl group the symmetry of the E8 root system rather than a free-floating group; an automorphism group asserted without its anchoring structure is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Algebra — group actions, Lie theory, and root systems (the E8 flagship)
#
# A group action is how a symmetry group acts on the thing it is a symmetry of; its
# action law is a logic: formula. A Lie group and its Lie algebra carry a root system
# with a Cartan matrix, Dynkin diagram, and Weyl group (the symmetry group of the root
# system, an automorphism group). E8 is the flagship: 240 roots, rank 8, Weyl order
# 696,729,600.
# =========================================================================== #

math:GroupAction
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Group Action"@x-gmeow-english ;
    skos:definition "An action of a math:Group on a set — a map assigning to each group element a transformation of the set, compatibly with the group operation ((g·h)·x = g·(h·x), e·x = x). It names the group and the set it math:actsOn, and its action law is a logic: formula. A group action is the mechanism of symmetry: the Weyl group of a root system acts on the roots."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LieGroup
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lie Group"@x-gmeow-english ;
    skos:definition "A group that is also a smooth manifold, with smooth group operations (its group-ness stated in prose to keep the profile clean). It carries a math:RootSystem through math:hasRootSystem and a math:LieAlgebra as its infinitesimal structure. E8 is the 248-dimensional exceptional simple Lie group."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LieAlgebra
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lie Algebra"@x-gmeow-english ;
    skos:definition "The infinitesimal structure of a math:LieGroup: a vector space with an alternating bilinear bracket satisfying the Jacobi identity (its algebra-ness stated in prose). It carries the same math:RootSystem as its Lie group. The E8 Lie algebra is the 248-dimensional exceptional simple Lie algebra."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RootSystem
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Root System"@x-gmeow-english ;
    skos:definition "A finite configuration of vectors (roots) in a Euclidean space satisfying the root-system axioms — the combinatorial heart of a semisimple Lie group. It declares its math:rootSystemRank, a math:CartanMatrix, a math:DynkinDiagram, and a math:WeylGroup (the symmetry group of the roots), and may carry its math:hasSimpleRoot base and math:rootCount. E8's root system has 240 roots in rank 8."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SimpleRoot
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Simple Root"@x-gmeow-english ;
    skos:definition "A root in the chosen base of a math:RootSystem — a basis of positive roots from which every root is a non-negative or non-positive integer combination. Reached through math:hasSimpleRoot. E8 has 8 simple roots, one per node of its Dynkin diagram."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CartanMatrix
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cartan Matrix"@x-gmeow-english ;
    skos:definition "The integer matrix of pairwise Cartan integers of a root system's simple roots — it encodes the whole root system up to isomorphism. Reached through math:cartanMatrix. E8's is the 8×8 Cartan matrix of the E8 Dynkin diagram."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DynkinDiagram
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dynkin Diagram"@x-gmeow-english ;
    skos:definition "The graph encoding a root system's simple roots and their angles — the pictorial classification datum of semisimple Lie algebras. Reached through math:dynkinDiagram. E8's is the 8-node Dynkin diagram of the exceptional series."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:WeylGroup
    a owl:Class ;
    rdfs:subClassOf math:AutomorphismGroup ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Weyl Group"@x-gmeow-english ;
    skos:definition "The group generated by the reflections in the hyperplanes orthogonal to a root system's roots — the symmetry group of the root system, and so a math:AutomorphismGroup (hence a math:Group) that math:actsOn the roots. Reached through math:weylGroup. E8's Weyl group has order 696,729,600."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Lattice
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lattice"@x-gmeow-english ;
    skos:definition "A discrete subgroup of a real vector space that spans it — a regular grid of points closed under addition. The E8 lattice is the densest lattice packing in 8 dimensions; lattices are also the hardness substrate of lattice-based homomorphic encryption. (The order-theoretic lattice is a distinct notion, named elsewhere.)"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GroupRepresentation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Group Representation"@x-gmeow-english ;
    skos:definition "A homomorphism from a group into the general linear group of a math:VectorSpace — a realization of the abstract group as linear transformations. It names the group it is a math:representationOf. E8's 248-dimensional adjoint representation acts on its own Lie algebra."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Group-action and Lie/root-system properties --------------------------- #

math:actsOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "acts on"@x-gmeow-english ;
    skos:definition "Relates a math:GroupAction (or a group acting) to the set or structure it acts on. Domain math:GroupAction or math:Group, range math:Set or math:AlgebraicStructure (stated in prose). A math:WeylGroup math:actsOn the roots of its math:RootSystem."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:automorphismGroupOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "automorphism group of"@x-gmeow-english ;
    skos:definition "Relates a math:AutomorphismGroup to the structure whose symmetries it collects — an automorphism group is always the symmetry group OF something. Domain math:AutomorphismGroup, range math:AlgebraicStructure or math:RootSystem (stated in prose). A math:WeylGroup math:automorphismGroupOf its root system: W(E8) is the automorphism group of the E8 root system. This is the invariant that makes a symmetry group anchored — an automorphism group declared without the structure it is the symmetry of is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasRootSystem
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has root system"@x-gmeow-english ;
    skos:definition "Relates a math:LieGroup or math:LieAlgebra to its math:RootSystem. Domain math:LieGroup or math:LieAlgebra, range math:RootSystem (stated in prose). A semisimple Lie group without a root system is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasSimpleRoot
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has simple root"@x-gmeow-english ;
    skos:definition "Relates a math:RootSystem to a math:SimpleRoot in its chosen base. Domain math:RootSystem, range math:SimpleRoot (stated in prose). E8 has eight."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:cartanMatrix
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "cartan matrix"@x-gmeow-english ;
    skos:definition "Relates a math:RootSystem to its math:CartanMatrix. Domain math:RootSystem, range math:CartanMatrix (stated in prose). A root system declares one; it encodes the system up to isomorphism."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:dynkinDiagram
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dynkin diagram"@x-gmeow-english ;
    skos:definition "Relates a math:RootSystem to its math:DynkinDiagram. Domain math:RootSystem, range math:DynkinDiagram (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:weylGroup
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "weyl group"@x-gmeow-english ;
    skos:definition "Relates a math:RootSystem to its math:WeylGroup — the symmetry group of the roots. Domain math:RootSystem, range math:WeylGroup (stated in prose). A root system declares one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:rootSystemRank
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "root system rank"@x-gmeow-english ;
    skos:definition "The rank of a math:RootSystem — the dimension of the space it spans, equal to the number of simple roots. Domain math:RootSystem, range a non-negative integer (stated in prose). E8 has rank 8."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:rootCount
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "root count"@x-gmeow-english ;
    skos:definition "The number of roots in a math:RootSystem — a validatable invariant of the system. Domain math:RootSystem, range a non-negative integer (stated in prose). E8 has 240 roots."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:groupOrder
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "group order"@x-gmeow-english ;
    skos:definition "The order (number of elements) of a finite math:Group — a validatable invariant. Domain math:Group, range a positive integer (stated in prose). E8's math:WeylGroup has order 696,729,600."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:representationOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "representation of"@x-gmeow-english ;
    skos:definition "Relates a math:GroupRepresentation to the math:Group it represents as linear maps. Domain math:GroupRepresentation, range math:Group (stated in prose). E8's adjoint representation is a math:representationOf E8."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Lie conformance failure ----------------------------------------------- #

math:IncompleteLieStructure
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Lie Structure"@x-gmeow-english ;
    skos:definition "The failure raised when a math:LieGroup does not declare its math:hasRootSystem, or a math:RootSystem does not declare its math:cartanMatrix, math:weylGroup, and math:rootSystemRank. The root-system data is what makes a Lie structure expressible and its symmetry an automorphism group; a Lie structure asserted without it is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:WrongE8WeylOrder
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Wrong E8 Weyl Order"@x-gmeow-english ;
    skos:definition "The failure raised when a math:RootSystem carries the E8 fingerprint (240 roots in rank 8) yet declares a math:weylGroup whose math:groupOrder is not 696,729,600 — the true order of W(E8). The flagship's numbers are a validatable invariant, not decoration: a root system claiming to be E8 with a corrupted Weyl order is ill-formed, and the gate rejects it rather than trusting the value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Algebra — homomorphic encryption (the HE flagship) and secret sharing
#
# Homomorphic encryption is a ring homomorphism whose preservation law
# (Dec(E(a) ⊗ E(b)) = a ⊕ b) is exactly what makes it useful — a logic: formula over
# the ring/lattice structure. It names the operation it is homomorphic over, its
# lattice-hardness assumption, and its noise model; encrypt/evaluate/decrypt are
# activities. The purest exercise of the one-way math: → logic: bridge.
# =========================================================================== #

math:EncryptionScheme
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Encryption Scheme"@x-gmeow-english ;
    skos:definition "A scheme mapping plaintexts to ciphertexts under a key, with encrypt and decrypt operations. The parent of math:HomomorphicEncryptionScheme; an ordinary scheme need not preserve any algebraic operation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:HomomorphicEncryptionScheme
    a owl:Class ;
    rdfs:subClassOf math:EncryptionScheme , math:RingHomomorphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Homomorphic Encryption Scheme"@x-gmeow-english ;
    skos:definition "An encryption scheme that is (partially or fully) a math:RingHomomorphism — computation on ciphertexts corresponds to computation on plaintexts. It names the operation it is math:homomorphicOver, its math:securityAssumption (a math:LatticeHardnessAssumption), and its math:noiseModel; its math:preservationLaw is Dec(E(a) ⊗ E(b)) = a ⊕ b as a logic: formula; and its encrypt/evaluate/decrypt steps are gmeow:Activity processes. Both a math:EncryptionScheme and a math:RingHomomorphism — the same map+law object as det and the Weyl action."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LatticeHardnessAssumption
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lattice Hardness Assumption"@x-gmeow-english ;
    skos:definition "A computational-hardness assumption over lattices on which a scheme's security rests — Learning With Errors (LWE) or its ring variant (RLWE). Its instances are math:learningWithErrors and math:ringLearningWithErrors. A homomorphic-encryption scheme names one through math:securityAssumption."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:learningWithErrors
    a owl:NamedIndividual , math:LatticeHardnessAssumption ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Learning With Errors (LWE)"@x-gmeow-english ;
    skos:definition "The Learning With Errors problem: recovering a secret from noisy linear equations mod q, conjectured hard even for quantum computers. The hardness assumption of many lattice-based schemes."@x-gmeow-english .

math:ringLearningWithErrors
    a owl:NamedIndividual , math:LatticeHardnessAssumption ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ring Learning With Errors (RLWE)"@x-gmeow-english ;
    skos:definition "The ring variant of Learning With Errors, over a math:PolynomialRing — more efficient and the basis of most practical homomorphic-encryption schemes."@x-gmeow-english .

# --- Homomorphic-encryption properties ------------------------------------- #

math:homomorphicOver
    a owl:ObjectProperty ;
    rdfs:subPropertyOf math:preservedOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homomorphic over"@x-gmeow-english ;
    skos:definition "Names the ring operation a homomorphic-encryption scheme carries from plaintext to ciphertext — the operation the homomorphic property holds for. Domain math:HomomorphicEncryptionScheme, range math:Operation (stated in prose). A refinement of math:preservedOperation: being homomorphic over an operation is preserving it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:securityAssumption
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "security assumption"@x-gmeow-english ;
    skos:definition "Names the hardness assumption a scheme's security rests on. Domain math:EncryptionScheme, range math:LatticeHardnessAssumption (stated in prose). A homomorphic-encryption scheme without a stated hardness assumption is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:noiseModel
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "noise model"@x-gmeow-english ;
    skos:definition "Names the noise-growth model of a lattice-based scheme — noise accumulates with each homomorphic operation and must stay below a decryption threshold. Domain math:HomomorphicEncryptionScheme, range a noise-model object (stated in prose). A homomorphic scheme without a noise model is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:encryptOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "encrypt operation"@x-gmeow-english ;
    skos:definition "Relates an encryption scheme to its encryption process — a gmeow:Activity mapping plaintext to ciphertext. Domain math:EncryptionScheme, range gmeow:Activity (stated in prose). The process, not the result or the claim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:evaluateOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "evaluate operation"@x-gmeow-english ;
    skos:definition "Relates a homomorphic-encryption scheme to its homomorphic-evaluation process — a gmeow:Activity computing on ciphertexts. Domain math:HomomorphicEncryptionScheme, range gmeow:Activity (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:decryptOperation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "decrypt operation"@x-gmeow-english ;
    skos:definition "Relates an encryption scheme to its decryption process — a gmeow:Activity mapping ciphertext back to plaintext. Domain math:EncryptionScheme, range gmeow:Activity (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Homomorphic-encryption conformance failure ---------------------------- #

math:UnderspecifiedEncryptionScheme
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Encryption Scheme"@x-gmeow-english ;
    skos:definition "The failure raised when a math:HomomorphicEncryptionScheme does not declare the operation it is math:homomorphicOver, its math:securityAssumption, and its math:noiseModel. These are what make the homomorphic claim meaningful and its security stateable; a scheme asserted without them is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Dogfooding — algebra grounds GMEOW's own domain concepts (math:formalizes)
#
# The one-way bridge (Principle 19): a math: term formalizes a gmeow: domain concept,
# surfaced in the domain term's documentation without the domain slice asserting any
# math: triple. This makes algebra grounding for the rest of the ontology, not a
# math island.
# =========================================================================== #

math:Lattice math:formalizes gmeow:tuningSystemJustIntonation .

# =========================================================================== #
# Measure, integration, and dimension (MEASURE-AND-DIMENSION charter)
#
# Two jobs meet here. Measure and integration give probability its foundation
# — a probability measure is a measure of total mass one, so the probability
# charter specializes this vocabulary rather than duplicating it. Dimension is
# the cross-cutting invariant: every quantity carries a dimension (an element of
# the ℚ-vector space over the seven SI base dimensions) and dimensional
# homogeneity is a reasoned hard-fail, not asserted data.
# =========================================================================== #

# --- Measurable spaces, measures, and integration --------------------------- #

math:MeasurableSpace
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Measurable Space"@x-gmeow-english ;
    skos:definition "A measurable space (X, Σ): a set X together with a σ-algebra Σ of its measurable subsets. Names its underlying set and its σ-algebra through math:measurableSpaceOf. The domain a math:Measure assigns mass over and the domain a math:Integral integrates over; shared with the probability charter, where a probability space is a measurable space carrying a probability measure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SigmaAlgebra
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "σ-Algebra"@x-gmeow-english ;
    skos:definition "A σ-algebra over a set: a collection of subsets closed under complement and countable union (and hence countable intersection), containing the whole set. The measurable sets of a math:MeasurableSpace — the events a math:Measure can assign mass to. Shared with the probability charter, where the σ-algebra is the event space of a probability space."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Measure
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Measure"@x-gmeow-english ;
    skos:definition "A measure μ: a countably-additive assignment of non-negative extended-real mass to the measurable sets of a math:MeasurableSpace. Names the space it acts on through math:measureOn and its total mass through math:totalMass — which may be a finite non-negative number or math:PositiveInfinity (a σ-finite measure such as a math:LebesgueMeasure on the line, or a math:CountingMeasure on an infinite set, has infinite total mass). The general object every mass-bearing construction specializes: a math:ProbabilityMeasure is a measure of total mass one, and a math:Integral integrates a math:MeasurableFunction against a measure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LebesgueMeasure
    a owl:Class ;
    rdfs:subClassOf math:Measure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Lebesgue Measure"@x-gmeow-english ;
    skos:definition "The Lebesgue measure: the canonical translation-invariant measure on ℝⁿ that assigns to an interval its length (area, volume). A subclass of math:Measure; the continuous counterpart of the discrete math:CountingMeasure. Its total mass over an unbounded space is math:PositiveInfinity, though it is σ-finite. Integration against it recovers the ordinary Riemann integral where that exists."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CountingMeasure
    a owl:Class ;
    rdfs:subClassOf math:Measure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Counting Measure"@x-gmeow-english ;
    skos:definition "The counting measure: the measure that assigns to a set the number of its elements. A subclass of math:Measure; the discrete counterpart of the continuous math:LebesgueMeasure. Its total mass over an infinite set is math:PositiveInfinity. Integration against it turns an integral into a sum, unifying the continuous and discrete cases under one math:Integral object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProbabilityMeasure
    a owl:Class ;
    rdfs:subClassOf math:Measure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability Measure"@x-gmeow-english ;
    skos:definition "A probability measure: a math:Measure of total mass one (math:totalMass 1). The probability bridge — the probability charter specializes this class rather than re-minting it, so a probability space is a math:MeasurableSpace carrying a probability measure and an expectation is a math:Integral against it. A probability measure that does not have total mass one is ill-formed (math:ProbabilityMeasureMassViolation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MeasurableFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Measurable Function"@x-gmeow-english ;
    skos:definition "A measurable function: a function between measurable spaces under which the preimage of every measurable set is measurable. A subclass of math:Function, so it declares its math:domain and math:codomain. The integrand of a math:Integral is a measurable function; density and mass functions in the probability charter are measurable functions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Integral
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Integral"@x-gmeow-english ;
    skos:definition "An integral ∫_D f dμ as a first-class object: the application of a math:IntegrationOperator naming its integrand (math:integrand, a math:MeasurableFunction), its domain (math:integrationDomain, a math:MeasurableSpace or measurable set), and the measure it integrates against (math:withRespectTo, a math:Measure). It carries the dimension of its result through math:hasDimension; the homogeneity gate checks that this equals the integrand's dimension combined with the measure's. An expectation in the probability charter is an integral against a probability measure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IntegrationOperator
    a owl:Class ;
    rdfs:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Integration Operator"@x-gmeow-english ;
    skos:definition "The integration operator ∫ · dμ: a binder over the integration variable that a math:Integral applies. A subclass of math:Operation; because it binds the integration variable it is a binding form (a binder in the sense of the mathematical-expression surface this bedrock builds on), which is why an integral is a first-class expression object rather than a display string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PositiveInfinity
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "+∞"@x-gmeow-english ;
    skos:definition "Positive infinity as an extended-real value: the total mass of a σ-finite but non-finite measure such as a math:LebesgueMeasure on the line or a math:CountingMeasure on an infinite set. A math:totalMass is either a finite non-negative number or this individual; it is the extended-real point that makes an infinite measure declarable without a finite literal."@x-gmeow-english .

# --- Dimension — the cross-cutting invariant -------------------------------- #

math:Dimension
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimension"@x-gmeow-english ;
    skos:definition "A physical dimension: an element of the ℚ-vector space over the seven SI base dimensions (length, mass, time, electric current, thermodynamic temperature, amount of substance, luminous intensity). Product of dimensions adds their exponent vectors, a power scalar-multiplies, math:dimensionless is the identity, and two dimensions are equal exactly when their exponent vectors are equal — the derived math:commensurableWith relation. Exponents are exact rationals (ℚ, admitting fractional dimensions such as T^(−1/2)), never floating-point. A math:Quantity carries its dimension through math:hasDimension."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BaseDimension
    a owl:Class ;
    rdfs:subClassOf math:Dimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Base Dimension"@x-gmeow-english ;
    skos:definition "One of the seven SI base dimensions — a generator of the ℚ-vector space of dimensions. The seven individuals are math:lengthDimension (L), math:massDimension (M), math:timeDimension (T), math:electricCurrentDimension (I), math:temperatureDimension (Θ), math:amountOfSubstanceDimension (N), and math:luminousIntensityDimension (J). A base dimension is a basis vector; it carries no math:baseDimensionExponent list because it is itself a generator, not a product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DerivedDimension
    a owl:Class ;
    rdfs:subClassOf math:Dimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Derived Dimension"@x-gmeow-english ;
    skos:definition "A dimension expressed as a product of powers of the base dimensions — velocity L·T⁻¹, energy M·L²·T⁻², and so on. It records that product as a set of math:DimensionExponent cells through math:baseDimensionExponent (one edge per base dimension it involves), each naming a math:BaseDimension (math:exponentOfDimension) and an exact-rational power (math:exponentNumerator over math:exponentDenominator). The cells are an unordered set — a product commutes — so no list order is imposed. Its human-readable math:dimensionVector string is a computed projection of that structured set, never an independent source."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Dimensionless
    a owl:Class ;
    rdfs:subClassOf math:Dimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimensionless"@x-gmeow-english ;
    skos:definition "The dimensionless quantity: the identity element of the dimension vector space, whose exponent vector is zero on every base dimension. A ratio of commensurable quantities, a probability, a correlation, and an angle are all math:dimensionless. The distinguished individual is math:dimensionless."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DimensionalExpression
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimensional Expression"@x-gmeow-english ;
    skos:definition "An expression whose operands must be dimensionally homogeneous — an addition, a subtraction, an equation, or a comparison, where every operand must share one dimension. Names its operands through math:homogeneousOperand (at least two). The homogeneity gate collects the dimensions of the operands and raises math:DimensionalInhomogeneity if they are not all equal. This is the first-class carrier of the homogeneity invariant; the full expression grammar (indexed argument slots) belongs to the mathematical-core surface this bedrock builds on, which will refine this class."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Quantity
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Quantity"@x-gmeow-english ;
    skos:definition "A dimensioned quantity: a value that carries a math:Dimension through math:hasDimension and, where measured, a unit (gmeow:unit, aligned to QUDT / OM 2) that realizes that dimension and a numeric magnitude (math:quantityValue). Every quantity carries a dimension — an undimensioned quantity is ill-formed (math:UndimensionedQuantity). Units live within a dimension; two quantities are comparable exactly when their dimensions are equal (math:commensurableWith)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DimensionExponent
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimension Exponent"@x-gmeow-english ;
    skos:definition "One (base dimension, exact-rational power) cell of a derived dimension's product form: it names the math:BaseDimension it raises (math:exponentOfDimension) and the power, as an exact rational, through math:exponentNumerator over math:exponentDenominator (denominator non-zero). The cells named by a math:DerivedDimension's math:baseDimensionExponent edges together give its exponent vector over the seven base dimensions. Rational, not decimal, so equality of dimensions is exact."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Base-dimension individuals (the ℚ⁷ generators) ------------------------- #

math:lengthDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "length (L)"@x-gmeow-english ;
    skos:definition "The SI base dimension of length, L — realized by the metre. A generator of the dimension vector space."@x-gmeow-english .

math:massDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "mass (M)"@x-gmeow-english ;
    skos:definition "The SI base dimension of mass, M — realized by the kilogram. A generator of the dimension vector space."@x-gmeow-english .

math:timeDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "time (T)"@x-gmeow-english ;
    skos:definition "The SI base dimension of time, T — realized by the second. A generator of the dimension vector space."@x-gmeow-english .

math:electricCurrentDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "electric current (I)"@x-gmeow-english ;
    skos:definition "The SI base dimension of electric current, I — realized by the ampere. A generator of the dimension vector space."@x-gmeow-english .

math:temperatureDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "thermodynamic temperature (Θ)"@x-gmeow-english ;
    skos:definition "The SI base dimension of thermodynamic temperature, Θ — realized by the kelvin. A generator of the dimension vector space."@x-gmeow-english .

math:amountOfSubstanceDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "amount of substance (N)"@x-gmeow-english ;
    skos:definition "The SI base dimension of amount of substance, N — realized by the mole. A generator of the dimension vector space."@x-gmeow-english .

math:luminousIntensityDimension
    a owl:NamedIndividual , math:BaseDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "luminous intensity (J)"@x-gmeow-english ;
    skos:definition "The SI base dimension of luminous intensity, J — realized by the candela. A generator of the dimension vector space."@x-gmeow-english .

math:dimensionless
    a owl:NamedIndividual , math:Dimensionless ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dimensionless (1)"@x-gmeow-english ;
    skos:definition "The dimensionless dimension: the zero vector, the identity of the dimension vector space. The dimension of a ratio of commensurable quantities, a probability, a correlation, or an angle."@x-gmeow-english .

# --- Measure and dimension failure classes ---------------------------------- #

math:IncompleteMeasure
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Measure"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Measure does not declare the measurable space it acts on (math:measureOn) or its total mass (math:totalMass, a finite non-negative number or math:PositiveInfinity). A measure without its space and mass is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProbabilityMeasureMassViolation
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability-Measure Mass Violation"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ProbabilityMeasure does not have math:totalMass one. A probability measure is exactly a measure of total mass one; any other total mass is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteIntegral
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Integral"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Integral does not name its integrand (math:integrand), its domain (math:integrationDomain), and the measure it integrates against (math:withRespectTo). An integral missing any of the three is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UndimensionedQuantity
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Undimensioned Quantity"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Quantity does not carry a math:Dimension through math:hasDimension. Every quantity carries a dimension; an undimensioned quantity is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MalformedDimension
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Malformed Dimension"@x-gmeow-english ;
    skos:definition "The failure raised when a dimension is structurally ill-formed: a math:DerivedDimension with no math:baseDimensionExponent list, an exponent cell whose math:exponentOfDimension is not a math:BaseDimension (so the exponent vector is undefined or cyclic), an exponent missing its numerator or denominator, or a math:dimensionVector string that does not match the canonical render of the structured exponent list (a divergent second source). Also raised when a math:DimensionalExpression carries fewer than two math:homogeneousOperand."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DimensionalInhomogeneity
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimensional Inhomogeneity"@x-gmeow-english ;
    skos:definition "The failure raised when an expression is dimensionally inhomogeneous: the operands of a math:DimensionalExpression do not all share one dimension, or a math:Integral's declared result dimension does not equal its integrand's dimension combined with its measure's. This is the no-optionality posture applied to dimensions — a dimensionally inhomogeneous expression is ill-formed. It is a reasoned gate, computed exactly from the rational exponent vectors of the ℚ-vector space of dimensions, not asserted data — this is GMEOW's differentiator over unit vocabularies that record conversions as data rather than deriving homogeneity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Measure properties ----------------------------------------------------- #

math:measurableSpaceOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "measurable space of"@x-gmeow-english ;
    skos:definition "Relates a math:MeasurableSpace to its underlying set or its σ-algebra — the components (X, Σ) that constitute it. Domain math:MeasurableSpace, range math:Set or math:SigmaAlgebra (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:measureOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "measure on"@x-gmeow-english ;
    skos:definition "Names the math:MeasurableSpace a measure assigns mass over. Domain math:Measure, range math:MeasurableSpace (stated in prose). Every math:Measure declares one; a measure without its space is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:totalMass
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "total mass"@x-gmeow-english ;
    skos:definition "The total mass a measure assigns to its whole space — a finite non-negative number or the extended-real math:PositiveInfinity. Domain math:Measure, range a non-negative numeric literal or math:PositiveInfinity (stated in prose). It is an rdf:Property, not an owl:ObjectProperty or owl:DatatypeProperty, precisely because its range spans both a datatype literal (the finite mass) and an individual (math:PositiveInfinity): neither DL property kind admits both, so the honest RDF supertype carries the extended-real range without a DL contradiction. A math:ProbabilityMeasure has total mass one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:integrand
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "integrand"@x-gmeow-english ;
    skos:definition "Names the math:MeasurableFunction a math:Integral integrates — the f in ∫_D f dμ. Domain math:Integral, range math:MeasurableFunction (stated in prose). Every integral names one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:integrationDomain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "integration domain"@x-gmeow-english ;
    skos:definition "Names the domain a math:Integral integrates over — the D in ∫_D f dμ, a math:MeasurableSpace or measurable set. Domain math:Integral, range math:MeasurableSpace or math:Set (stated in prose). Every integral names one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:withRespectTo
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "with respect to"@x-gmeow-english ;
    skos:definition "Names the math:Measure a math:Integral integrates against — the μ in ∫_D f dμ. Domain math:Integral, range math:Measure (stated in prose). Every integral names exactly one; it is the single measure property of an integral (an expectation integrates against a probability measure). The homogeneity gate combines the integrand's dimension with this measure's to check the integral's declared result dimension."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Dimension properties --------------------------------------------------- #

math:hasDimension
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has dimension"@x-gmeow-english ;
    skos:definition "Names the math:Dimension a quantity, integral, or dimensioned object carries. Domain math:Quantity (or another dimensioned object such as a math:Integral), range math:Dimension (stated in prose). Every math:Quantity declares exactly one — an undimensioned quantity is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:dimensionVector
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dimension vector"@x-gmeow-english ;
    skos:definition "The human-readable canonical rendering of a dimension's exponent vector, for example \"M·L2·T-2\" for energy. Domain math:Dimension, range xsd:string (stated in prose). A computed projection of the structured math:baseDimensionExponent list, never an independent authored source: where present it must match the canonical render of the structured exponents, or the dimension is malformed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:baseDimensionExponent
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "base dimension exponent"@x-gmeow-english ;
    skos:definition "Relates a math:DerivedDimension to one math:DimensionExponent cell of its product form over the base dimensions — one such edge per base dimension involved (an unordered set, since a product commutes). Domain math:DerivedDimension, range math:DimensionExponent (stated in prose). A base dimension carries no such edge — it is a generator, not a product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:exponentOfDimension
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exponent of dimension"@x-gmeow-english ;
    skos:definition "Names the math:BaseDimension that a math:DimensionExponent cell raises to a power. Domain math:DimensionExponent, range math:BaseDimension only (stated in prose) — never a derived dimension, so the exponent vector is well-defined and acyclic by construction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:exponentNumerator
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exponent numerator"@x-gmeow-english ;
    skos:definition "The numerator of the exact-rational power a math:DimensionExponent raises its base dimension to. Domain math:DimensionExponent, range xsd:integer (stated in prose). Together with math:exponentDenominator it gives an exact math:RationalNumber power — ℚ, admitting fractional dimensions such as T^(−1/2) — never a floating-point or decimal approximation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:exponentDenominator
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exponent denominator"@x-gmeow-english ;
    skos:definition "The denominator of the exact-rational power a math:DimensionExponent raises its base dimension to. Domain math:DimensionExponent, range xsd:integer (stated in prose), non-zero. Together with math:exponentNumerator it gives an exact math:RationalNumber power; a whole-number exponent uses denominator one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:commensurableWith
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "commensurable with"@x-gmeow-english ;
    skos:definition "Relates two quantities that share one dimension — the equivalence relation of equal dimension vectors, under which they can be added, compared, or subtracted. Domain and range math:Quantity (stated in prose). This relation is derived, not asserted: it is computed as the kernel-equivalence of the dimension map (quantities whose exact-rational exponent vectors are equal), so its reflexivity, symmetry, and transitivity are properties of the derivation, carried by no OWL characteristic (symmetric properties are outside the EL profile) — the competency query reads the computed equivalence classes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:homogeneousOperand
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homogeneous operand"@x-gmeow-english ;
    skos:definition "Relates a math:DimensionalExpression to one of the operands that must share its single dimension — a summand of an addition, a side of an equation, a term of a comparison. Domain math:DimensionalExpression, range a dimensioned object (a math:Quantity or another dimensioned expression) (stated in prose). An expression carries at least two; the homogeneity gate raises math:DimensionalInhomogeneity when their dimensions are not all equal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# The dimensional-homogeneity invariant as first-order logic: laws, and the
# native ℚ⁷ validator declared as their exact executable lowering
# (MEASURE-AND-DIMENSION — the charter's distinguished reasoned gate)
#
# math:DimensionalInhomogeneity is not a bare Rust side-channel: the invariant
# the native validator (crates/validate check_math_dimension_invariants)
# computes from the exact-rational ℚ⁷ exponent vectors is authored HERE as real
# logic:Formula first-order ASTs — math: expresses the law, logic: owns
# reasoning over it, exactly as the ALGEBRA preservation laws do. The validator
# is then declared as the LOWERING of these laws, carrying
# logic:preservationKind logic:ExactPreservation in the same loss ledger every
# other GMEOW lowering rides (Principle 17; no new preservation vocabulary is
# minted). The relation atoms are reified as logic:Type individuals per the
# HiLog reflection (logic:relation ranges over logic:Type), exactly as the det
# law reifies matMul/det; where a first-class math: property already names the
# relation, the reflection carries an rdfs:seeAlso back to it, so no near-synonym
# property is minted.
# =========================================================================== #

# --- Reified relation atoms (HiLog reflection of the dimension predicates) --- #

math:homogeneousOperandRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homogeneousOperand(E,o) ⟺ o is a homogeneous operand of expression E"@x-gmeow-english ;
    rdfs:seeAlso math:homogeneousOperand ;
    skos:definition "The HiLog reflection of math:homogeneousOperand as a binary relation individual, so the homogeneity law can predicate over it inside a logic:Formula atom. It reflects the existing property (rdfs:seeAlso), keeping the object level first-order rather than minting a second relation."@x-gmeow-english .

math:hasDimensionRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "hasDimension(x,d) ⟺ dimensioned object x carries dimension d"@x-gmeow-english ;
    rdfs:seeAlso math:hasDimension ;
    skos:definition "The HiLog reflection of math:hasDimension as a binary relation individual, so a law can predicate 'x carries dimension d' inside a logic:Formula atom. Reflects the existing property (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:integrandRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "integrand(I,f) ⟺ f is the integrand of integral I"@x-gmeow-english ;
    rdfs:seeAlso math:integrand ;
    skos:definition "The HiLog reflection of math:integrand as a binary relation individual, so the integral-composition law can predicate over it inside a logic:Formula atom. Reflects the existing property (rdfs:seeAlso)."@x-gmeow-english .

math:withRespectToRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "withRespectTo(I,μ) ⟺ μ is the measure integral I integrates against"@x-gmeow-english ;
    rdfs:seeAlso math:withRespectTo ;
    skos:definition "The HiLog reflection of math:withRespectTo as a binary relation individual, so the integral-composition law can predicate over it inside a logic:Formula atom. Reflects the existing property (rdfs:seeAlso)."@x-gmeow-english .

math:dimensionEqualityRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dimEqual(d1,d2) ⟺ dimensions d1 and d2 have equal ℚ⁷ exponent vectors"@x-gmeow-english ;
    rdfs:seeAlso math:commensurableWith ;
    skos:definition "The dimension-level equality relation the homogeneity law concludes: dimEqual(d1,d2) holds exactly when d1 and d2 have identical exact-rational exponent vectors over the seven SI base dimensions — the derived commensurability the native validator computes by exact rational arithmetic. It is the dimension-carrier of the same equivalence math:commensurableWith carries at the quantity level (rdfs:seeAlso); a HiLog reflection individual, not a first-class asserted property (the equality is derived, never authored)."@x-gmeow-english .

math:dimensionProductRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dimProduct(dA,dB,dC) ⟺ dC's exponent vector is dA's ⊕ dB's"@x-gmeow-english ;
    skos:definition "The dimension-product relation the integral-composition law concludes: dimProduct(dA,dB,dC) holds exactly when dC's exact-rational exponent vector is the vector sum of dA's and dB's — a product of dimensions adds exponent vectors in the ℚ-vector space of dimensions. A HiLog reflection individual over which the law predicates 'result = integrand ⊕ measure'; the native validator discharges it by exact rational vector addition."@x-gmeow-english .

# --- Law 1: dimensional homogeneity ----------------------------------------- #
# ∀E,o1,o2,d1,d2: homogeneousOperand(E,o1) ∧ homogeneousOperand(E,o2)
#                 ∧ hasDimension(o1,d1) ∧ hasDimension(o2,d2) → dimEqual(d1,d2)
# Any two homogeneous operands of a dimensional expression carry equal dimensions
# (equal ℚ⁷ exponent vectors). Its executable lowering is the native validator's
# homogeneity branch, which raises math:DimensionalInhomogeneity on any violation.

math:dimensionalHomogeneityLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dimensional homogeneity: an expression's operands share one dimension"@x-gmeow-english ;
    skos:definition "The homogeneity invariant of a math:DimensionalExpression as a universally-quantified first-order logic:Formula: for any two math:homogeneousOperand operands of the same expression, their carried dimensions have equal ℚ⁷ exponent vectors (dimEqual). math: expresses the law; logic: owns reasoning over it; the native validator is its exact executable lowering (math:dimensionalHomogeneityLowering)."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "E" ] ,
        [ logic:termIndex 1 ; logic:termVariable "o1" ] ,
        [ logic:termIndex 2 ; logic:termVariable "o2" ] ,
        [ logic:termIndex 3 ; logic:termVariable "d1" ] ,
        [ logic:termIndex 4 ; logic:termVariable "d2" ] ;
    logic:forall math:dimHomImpl .

math:dimHomImpl a logic:Formula ;
    logic:antecedent math:dimHomAnte ;
    logic:consequent math:dimHomCons .

math:dimHomAnte a logic:Formula ;
    logic:and math:dimHomA1 , math:dimHomA2 , math:dimHomA3 , math:dimHomA4 .

math:dimHomA1 a logic:Formula ; logic:relation math:homogeneousOperandRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "E" ] , [ logic:termIndex 1 ; logic:termVariable "o1" ] .
math:dimHomA2 a logic:Formula ; logic:relation math:homogeneousOperandRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "E" ] , [ logic:termIndex 1 ; logic:termVariable "o2" ] .
math:dimHomA3 a logic:Formula ; logic:relation math:hasDimensionRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "o1" ] , [ logic:termIndex 1 ; logic:termVariable "d1" ] .
math:dimHomA4 a logic:Formula ; logic:relation math:hasDimensionRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "o2" ] , [ logic:termIndex 1 ; logic:termVariable "d2" ] .

math:dimHomCons a logic:Formula ; logic:relation math:dimensionEqualityRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "d1" ] , [ logic:termIndex 1 ; logic:termVariable "d2" ] .

# --- Law 2: integral dimensional composition -------------------------------- #
# ∀I,f,μ,dR,dF,dM: integrand(I,f) ∧ withRespectTo(I,μ) ∧ hasDimension(I,dR)
#                 ∧ hasDimension(f,dF) ∧ hasDimension(μ,dM) → dimProduct(dF,dM,dR)
# An integral's declared result dimension is its integrand's dimension composed
# (⊕, exponent-vector addition) with its measure's. Its executable lowering is the
# native validator's integral branch, which raises math:DimensionalInhomogeneity
# when dim(result) ≠ dim(integrand) ⊕ dim(measure).

math:integralDimensionCompositionLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "integral composition: dim(result) = dim(integrand) ⊕ dim(measure)"@x-gmeow-english ;
    skos:definition "The dimensional-composition invariant of a math:Integral as a universally-quantified first-order logic:Formula: for an integral with integrand f (math:integrand) and measure μ (math:withRespectTo), the integral's declared result dimension equals f's dimension composed with μ's (dimProduct — exponent-vector addition in the ℚ-vector space). math: expresses the law; logic: owns reasoning over it; the native validator is its exact executable lowering (math:dimensionalHomogeneityLowering)."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "I" ] ,
        [ logic:termIndex 1 ; logic:termVariable "f" ] ,
        [ logic:termIndex 2 ; logic:termVariable "mu" ] ,
        [ logic:termIndex 3 ; logic:termVariable "dR" ] ,
        [ logic:termIndex 4 ; logic:termVariable "dF" ] ,
        [ logic:termIndex 5 ; logic:termVariable "dM" ] ;
    logic:forall math:intCompImpl .

math:intCompImpl a logic:Formula ;
    logic:antecedent math:intCompAnte ;
    logic:consequent math:intCompCons .

math:intCompAnte a logic:Formula ;
    logic:and math:intCompA1 , math:intCompA2 , math:intCompA3 , math:intCompA4 , math:intCompA5 .

math:intCompA1 a logic:Formula ; logic:relation math:integrandRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "I" ] , [ logic:termIndex 1 ; logic:termVariable "f" ] .
math:intCompA2 a logic:Formula ; logic:relation math:withRespectToRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "I" ] , [ logic:termIndex 1 ; logic:termVariable "mu" ] .
math:intCompA3 a logic:Formula ; logic:relation math:hasDimensionRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "I" ] , [ logic:termIndex 1 ; logic:termVariable "dR" ] .
math:intCompA4 a logic:Formula ; logic:relation math:hasDimensionRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "dF" ] .
math:intCompA5 a logic:Formula ; logic:relation math:hasDimensionRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mu" ] , [ logic:termIndex 1 ; logic:termVariable "dM" ] .

math:intCompCons a logic:Formula ; logic:relation math:dimensionProductRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "dF" ] , [ logic:termIndex 1 ; logic:termVariable "dM" ] , [ logic:termIndex 2 ; logic:termVariable "dR" ] .

# --- The native validator declared as the laws' exact executable lowering --- #
# The loss-ledger record: the native ℚ⁷ dimensional validator is the executable
# lowering of the two logic: laws above. Because it computes each dimension's
# exact-rational exponent vector and decides dimEqual / dimProduct by exact
# rational arithmetic — never rounding, never a divergent asserted label — it
# neither misses a genuine inhomogeneity nor invents a spurious one: it yields
# exactly the answers the canonical laws entail, hence logic:ExactPreservation
# (the same polarity vocabulary every other GMEOW lowering carries). A violation
# raises the typed failure math:DimensionalInhomogeneity.

math:dimensionalHomogeneityLowering
    a gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "native ℚ⁷ validator: exact lowering of the dimensional-homogeneity laws"@x-gmeow-english ;
    skos:definition "The declaration that the native dimensional-homogeneity validator (the check computing dimensions' exact-rational ℚ⁷ exponent vectors) is the executable lowering of math:dimensionalHomogeneityLaw and math:integralDimensionCompositionLaw. It decides the laws' dimEqual and dimProduct conclusions by exact rational arithmetic over the exponent vectors, so it neither misses a genuine inhomogeneity nor reports a spurious one — it yields exactly the answers the canonical laws entail. Hence logic:preservationKind logic:ExactPreservation, reusing the existing loss-ledger polarity vocabulary (Principle 17, no near-synonym minted). A violation raises the typed failure class math:DimensionalInhomogeneity. The laws are the source, the native gate the enforcement, and this record their preservation judgment in the loss ledger."@x-gmeow-english ;
    logic:preservationKind logic:ExactPreservation ;
    rdfs:seeAlso math:dimensionalHomogeneityLaw ,
        math:integralDimensionCompositionLaw ,
        math:DimensionalInhomogeneity .

# =========================================================================== #
# Mathematical-core binder AST (EXPRESSIONS charter — the subset the
# analysis-and-geometry charter consumes)
#
# Calculus operators (d/dx, ∂, ∫, ∑, lim) are binders over the expression AST,
# not display strings (MATHEMATICS-EXPRESSIONS.md §Expression AST layer). A
# math:BindingExpression is an application-shaped node: it names its binder
# operator through math:operator, its body through indexed math:argumentSlot
# cells, and the variable it binds through math:boundVariable. Binding is modeled
# with an explicit declaration/occurrence split so nested and shadowed binders —
# mixed partials ∂²/∂x∂y, a sum ∑ᵢ(xᵢ + ∑ᵢ yᵢ) whose inner i shadows the outer —
# are checkable: a math:VariableDeclaration is a variable's identity within a
# scope and a math:VariableOccurrence is a use site resolving to exactly one
# declaration, making α-equivalence a graph isomorphism rather than a string
# match. Any expression that crosses into reasoning declares what it denotes
# (math:denotationKind) and how it lowers (math:compilesToLogicTerm/Formula/Type)
# with a recorded preservation polarity — the seam that keeps the mathematical
# surface from silently becoming a logic: assertion. Bedrock landed
# math:ApplicationExpression + math:operator and deferred this surface; the
# analysis-and-geometry charter is its first consumer and lands exactly the
# subset its binders need, using the canonical reserved names (no near-synonyms).
# =========================================================================== #

# --- Expression AST: argument slots and the binding form -------------------- #

math:ArgumentSlot
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Argument Slot"@x-gmeow-english ;
    skos:definition "One indexed operand position of a math:ApplicationExpression or math:BindingExpression: it carries exactly one integer math:slotIndex and exactly one math:slotExpression. Operand order is carried by these slots, not by RDF list ordering — swapping two slots' expressions is a different expression, so non-commutative operators (matrix product, function composition, subtraction, the body of a binder) are order-safe. Slot indexes are unique within one application; strict canonical mode additionally requires them zero-based and contiguous. A slot missing its index or expression is ill-formed (math:MalformedArgumentSlot)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BindingExpression
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Binding Expression"@x-gmeow-english ;
    skos:definition "A binder: the expression node that binds a variable over a body. Application-shaped — it names its binder operator through math:operator (a math:Operation individual such as the differentiation, integration, summation, or limit binder), its body through indexed math:argumentSlot cells, and the math:VariableDeclaration it introduces through math:boundVariable. It binds math:VariableOccurrence use sites through math:bindsOccurrence, never glyphs, so nested and shadowed binders are checkable. The single binding form d/dx, ∂, ∫, ∑, and lim all specialize: a math:Derivative, a math:Limit, a math:Series, and a math:Integral are binding expressions, so no per-operator binder machinery is minted. A binder without a bound variable and a body is ill-formed (math:MalformedBindingExpression)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VariableExpression
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Variable Expression"@x-gmeow-english ;
    skos:definition "A variable used inside an expression: an expression node standing for one math:VariableOccurrence (math:variableOccurrence). Its occurrence is either bound by a math:BindingExpression or resolves to a math:FreeVariableDeclaration; there is no implicit free variable. This is the leaf of the AST where a bound or free variable enters a formula."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VariableDeclaration
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Variable Declaration"@x-gmeow-english ;
    skos:definition "The identity of a variable within a scope — the binding site's referent. Introduced by a math:BindingExpression through math:boundVariable, or standing alone as a math:FreeVariableDeclaration carrying a declared type/domain context. Every math:VariableOccurrence points at exactly one declaration through math:declaredVariable, so α-equivalence (same structure up to renaming of declarations) is a graph isomorphism over declarations rather than a string comparison. Two binders that reuse the glyph i introduce two distinct declarations."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FreeVariableDeclaration
    a owl:Class ;
    rdfs:subClassOf math:VariableDeclaration ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Free Variable Declaration"@x-gmeow-english ;
    skos:definition "A variable declaration not introduced by a binder: a free variable, standing alone with a declared type and domain context. The explicit marker that a variable occurrence is free — there is no implicit free variable, so an occurrence is either bound by a math:BindingExpression or resolves to a math:FreeVariableDeclaration with its type/domain declared."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VariableOccurrence
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Variable Occurrence"@x-gmeow-english ;
    skos:definition "A use site of a variable within an expression scope: it names the math:VariableDeclaration it refers to through math:declaredVariable and the scope it occurs in through math:occursInScope. A binder binds occurrences (math:bindsOccurrence), not glyphs, so an occurrence in the body of two nested binders that reuse a glyph resolves to exactly one of the two declarations. An occurrence that resolves to no declaration and is not marked free is ill-formed (math:UnscopedVariableOccurrence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DenotationKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Denotation Kind"@x-gmeow-english ;
    skos:definition "What a math:MathematicalExpression denotes when it crosses into reasoning: one of math:denotesObject (a mathematical object/value → a logic: term), math:denotesProposition (a proposition → a logic: formula), math:denotesType (a type/sort → a logic: type), math:denotesOperator (a function/relation/operator → a logic: predicate or function symbol), or math:denotesProof (a proof-term → a logic: proof object). The AST is not a second logic: an expression declares its denotation kind and its lowering so the mathematical surface and the reasoning surface compose instead of duplicating."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Denotation-kind individuals (the five lowering targets) ---------------- #

math:denotesObject
    a owl:NamedIndividual , math:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotes object / value"@x-gmeow-english ;
    skos:definition "The denotation kind of an expression standing for a mathematical object or value — a number, a limit, a definite integral, a tensor. It lowers to a logic: term through math:compilesToLogicTerm. The default kind of a computed value expression."@x-gmeow-english .

math:denotesProposition
    a owl:NamedIndividual , math:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotes proposition / formula"@x-gmeow-english ;
    skos:definition "The denotation kind of a truth-valued expression — an equation, an inequality, a convergence claim ∀ε∃δ. It lowers to a logic: formula through math:compilesToLogicFormula. A truth-valued expression does not become a logic: assertion until this kind and its lowering preservation are declared; silent promotion is forbidden (math:UndeclaredLogicLowering)."@x-gmeow-english .

math:denotesType
    a owl:NamedIndividual , math:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotes type / sort"@x-gmeow-english ;
    skos:definition "The denotation kind of an expression standing for a type, class, or sort — a function space, a manifold's structure kind. It lowers to a logic: type through math:compilesToLogicType."@x-gmeow-english .

math:denotesOperator
    a owl:NamedIndividual , math:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotes operator / function / relation"@x-gmeow-english ;
    skos:definition "The denotation kind of an expression standing for a function, relation, or operator — the differentiation operator, a continuous map. It lowers to a logic: predicate or function symbol."@x-gmeow-english .

math:denotesProof
    a owl:NamedIndividual , math:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotes proof / proof-term"@x-gmeow-english ;
    skos:definition "The denotation kind of an expression standing for a proof or proof-term. It lowers to a logic: proof object. The rarest kind, used where a proof term is carried as structured content rather than as prose."@x-gmeow-english .

# --- Binder-operator individuals (the binder symbols) ----------------------- #

math:differentiationBinder
    a owl:NamedIndividual , math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "d/dx (differentiation binder)"@x-gmeow-english ;
    skos:definition "The differentiation binder d/dx: the math:operator a math:Derivative binding expression applies, binding the variable of differentiation over the body it differentiates. Anchored to the OpenMath calculus1 diff symbol."@x-gmeow-english .

math:partialDifferentiationBinder
    a owl:NamedIndividual , math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "∂ (partial-differentiation binder)"@x-gmeow-english ;
    skos:definition "The partial-differentiation binder ∂: the math:operator a math:PartialDerivative binding expression applies, binding one variable while others are held. Mixed partials ∂²/∂x∂y are nested binding expressions, each with its own math:VariableDeclaration. Anchored to the OpenMath calculus1 partialdiff symbol."@x-gmeow-english .

math:summationBinder
    a owl:NamedIndividual , math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "∑ (summation binder)"@x-gmeow-english ;
    skos:definition "The summation binder ∑: the math:operator a math:Series binding expression applies, binding the summation index over the summand. A shadowed index ∑ᵢ(xᵢ + ∑ᵢ yᵢ) introduces two distinct math:VariableDeclarations. Anchored to the OpenMath arith1 sum symbol."@x-gmeow-english .

math:limitBinder
    a owl:NamedIndividual , math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "lim (limit binder)"@x-gmeow-english ;
    skos:definition "The limit binder lim: the math:operator a math:Limit binding expression applies, binding the variable that approaches the limit point over the body. Anchored to the OpenMath calculus1 limit symbol."@x-gmeow-english .

# --- Integration binder retrofit (∫ is a binding expression) ---------------- #

math:Integral rdfs:subClassOf math:BindingExpression .

# --- Binder AST conformance failures ---------------------------------------- #

math:MalformedArgumentSlot
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Malformed Argument Slot"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ArgumentSlot does not carry exactly one math:slotIndex and exactly one math:slotExpression, or when two slots of one application share an index. Operand order is carried by unique indexed slots; a slot missing its index or expression, or a duplicated index, is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnscopedVariableOccurrence
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unscoped Variable Occurrence"@x-gmeow-english ;
    skos:definition "The failure raised when a math:VariableOccurrence neither resolves to a math:VariableDeclaration through math:declaredVariable nor is marked free through a math:FreeVariableDeclaration. There is no implicit free variable; an occurrence that binds to nothing is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MalformedBindingExpression
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Malformed Binding Expression"@x-gmeow-english ;
    skos:definition "The failure raised when a math:BindingExpression does not name the math:VariableDeclaration it binds through math:boundVariable, or does not name its body through math:argumentSlot. A binder binds a variable over a body; a binder missing either is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UndeclaredLogicLowering
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Undeclared Logic Lowering"@x-gmeow-english ;
    skos:definition "The failure raised when a truth-valued math:MathematicalExpression is lowered into logic: (math:compilesToLogicFormula) without declaring its math:denotationKind and its math:logicLoweringPreservation. Silent promotion of a mathematical expression to a logical assertion is forbidden — an equation is a denotable object until something declares it a proposition and lowers it, with recorded preservation, into the reasoning layer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Binder AST properties -------------------------------------------------- #

math:argumentSlot
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "argument slot"@x-gmeow-english ;
    skos:definition "Relates a math:ApplicationExpression or math:BindingExpression to one math:ArgumentSlot carrying an indexed operand (or, for a binder, the body). Domain a math:ApplicationExpression or math:BindingExpression, range math:ArgumentSlot (stated in prose). Operand order is carried by the slots' math:slotIndex, never by RDF list ordering."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:slotIndex
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "slot index"@x-gmeow-english ;
    skos:definition "The integer position of a math:ArgumentSlot within its application — the operand order. Domain math:ArgumentSlot, range xsd:nonNegativeInteger (stated in prose). Unique within one application; strict canonical mode requires the indexes zero-based and contiguous. A slot without exactly one index is ill-formed (math:MalformedArgumentSlot)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:slotExpression
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "slot expression"@x-gmeow-english ;
    skos:definition "The math:MathematicalExpression filling one math:ArgumentSlot — the operand, or the body of a binder. Domain math:ArgumentSlot, range math:MathematicalExpression (stated in prose). Every slot names exactly one; a slot without an expression is ill-formed (math:MalformedArgumentSlot)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:boundVariable
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "bound variable"@x-gmeow-english ;
    skos:definition "Relates a math:BindingExpression to the math:VariableDeclaration it introduces and binds — the variable of differentiation, integration, summation, or the limit. Domain math:BindingExpression, range math:VariableDeclaration (stated in prose). Every binder names exactly one bound variable's declaration; a binder without one is ill-formed (math:MalformedBindingExpression). This is the edge through which a binder introduces its variable's scoped identity, over which its bound math:VariableOccurrence use sites resolve."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:bindsOccurrence
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "binds occurrence"@x-gmeow-english ;
    skos:definition "Relates a math:BindingExpression to a math:VariableOccurrence it binds — a use site of its bound variable within its body. Domain math:BindingExpression, range math:VariableOccurrence (stated in prose). A binder binds occurrences, not glyphs, so under nesting and shadowing each occurrence resolves to exactly one binder."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:declaredVariable
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "declared variable"@x-gmeow-english ;
    skos:definition "Relates a math:VariableOccurrence to the math:VariableDeclaration it refers to — the binding site or free declaration that gives the occurrence its identity. Domain math:VariableOccurrence, range math:VariableDeclaration (stated in prose). Every occurrence resolves to exactly one declaration; an occurrence resolving to none and not marked free is ill-formed (math:UnscopedVariableOccurrence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:occursInScope
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "occurs in scope"@x-gmeow-english ;
    skos:definition "Relates a math:VariableOccurrence to the math:MathematicalExpression scope it occurs in — the binding expression or sub-expression whose body contains the use site. Domain math:VariableOccurrence, range math:MathematicalExpression (stated in prose). Scope is what makes shadowing resolvable: an occurrence in the innermost scope binds to the innermost declaration of its glyph."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:variableOccurrence
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "variable occurrence"@x-gmeow-english ;
    skos:definition "Relates a math:VariableExpression leaf to the math:VariableOccurrence it stands for. Domain math:VariableExpression, range math:VariableOccurrence (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:denotationKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "denotation kind"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalExpression to the math:DenotationKind naming what it denotes when it crosses into reasoning — object/value, proposition, type, operator, or proof. Domain math:MathematicalExpression, range math:DenotationKind (stated in prose). A truth-valued expression declares this before lowering to a logic: formula; an undeclared lowering is ill-formed (math:UndeclaredLogicLowering)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:compilesToLogicTerm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "compiles to logic: term"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalExpression that denotes an object/value to the logic: term it lowers to. Domain math:MathematicalExpression (math:denotationKind math:denotesObject), range a logic: term (stated in prose). The explicit, preservation-judged map that keeps the mathematical AST from re-implementing the logic: IR."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:compilesToLogicFormula
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "compiles to logic: formula"@x-gmeow-english ;
    skos:definition "Relates a truth-valued math:MathematicalExpression to the logic:Formula it lowers to. Domain math:MathematicalExpression (math:denotationKind math:denotesProposition), range logic:Formula (stated in prose). Present only with a declared math:denotationKind and math:logicLoweringPreservation; silent promotion to a logical assertion is forbidden (math:UndeclaredLogicLowering)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:compilesToLogicType
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "compiles to logic: type"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalExpression that denotes a type/sort to the logic: type it lowers to. Domain math:MathematicalExpression (math:denotationKind math:denotesType), range a logic: type (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:logicLoweringPreservation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "logic lowering preservation"@x-gmeow-english ;
    skos:definition "Relates a math:MathematicalExpression to the preservation polarity of its lowering into logic:, reusing the shared loss-ledger vocabulary (logic:preservationKind values such as logic:ExactPreservation, logic:SoundUnderApproximation, logic:CompleteOverApproximation). Domain math:MathematicalExpression, range a logic:preservationKind value (stated in prose). No near-synonym is minted — mathematics lowering loss is queryable in the same ledger as every other GMEOW projection (Principle 17)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# Calculus and analysis (ANALYSIS-AND-GEOMETRY charter)
#
# Limits, derivatives, integrals (∫ reused from the measure charter), series,
# sequences, and special functions. Every operator here is a binder over the
# expression AST: a math:Derivative, math:Limit, and math:Series are
# math:BindingExpressions applying the differentiation, limit, and summation
# binders (math:differentiationBinder, math:limitBinder, math:summationBinder),
# so the calculus surface reuses the single binding form rather than minting
# per-operator machinery. A derivative names what it differentiates, with respect
# to which variable, at which order; a limit names its expression and its limit
# point (and, where it matters, its direction/mode); a series/sequence carries a
# math:Convergence with its mode. Special functions are first-class individuals
# aligned to DLMF and OpenMath (calculus1/transc1), not new OWL classes.
# =========================================================================== #

# --- Calculus binders and analysis objects ---------------------------------- #

math:Derivative
    a owl:Class ;
    rdfs:subClassOf math:BindingExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Derivative"@x-gmeow-english ;
    skos:definition "The derivative d/dx f of an expression as a first-class binding expression: it applies the math:differentiationBinder (math:operator), names what it differentiates through math:derivativeOf, the variable of differentiation through math:withRespectToVariable (a math:VariableDeclaration it binds), and its order through math:derivativeOrder. A derivative is a map of function spaces, not the string 'dy/dx'. A derivative missing what it differentiates, its variable, or its order is ill-formed (math:UnderspecifiedDerivative)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PartialDerivative
    a owl:Class ;
    rdfs:subClassOf math:Derivative ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Partial Derivative"@x-gmeow-english ;
    skos:definition "A partial derivative ∂f/∂x: a math:Derivative that applies the math:partialDifferentiationBinder, differentiating with respect to one variable while others are held. Mixed partials ∂²f/∂x∂y are nested partial derivatives, each binding its own math:VariableDeclaration, so order and shadowing are explicit. A subclass of math:Derivative; it declares the same what/variable/order frame."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DifferentialOperator
    a owl:Class ;
    rdfs:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Differential Operator"@x-gmeow-english ;
    skos:definition "A differential operator: a map of function spaces built from derivatives — the gradient ∇, the Laplacian Δ, a linear ODE operator. A subclass of math:Operation whose action is differentiation; the math:differentiationBinder is the elementary case it composes. Distinguished from a single math:Derivative, which is one application of the differentiation binder to one expression."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Limit
    a owl:Class ;
    rdfs:subClassOf math:BindingExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Limit"@x-gmeow-english ;
    skos:definition "The limit lim_{x→a} f(x) as a first-class binding expression: it applies the math:limitBinder (math:operator), names the expression whose limit is taken through math:limitOf, the limit point a through math:limitPoint, and — where it matters — the direction/mode through math:limitMode (from the left, from the right, or two-sided). A limit missing its expression or its limit point is ill-formed (math:UnderspecifiedLimit); the mode is optional because a two-sided limit has no direction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LimitMode
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Limit Mode"@x-gmeow-english ;
    skos:definition "The direction in which a math:Limit approaches its limit point: one of math:limitFromLeft (x → a⁻), math:limitFromRight (x → a⁺), or math:limitTwoSided (x → a). A one-sided limit declares its side; a two-sided limit either declares math:limitTwoSided or omits the mode, since it has no direction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Sequence
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Sequence"@x-gmeow-english ;
    skos:definition "A sequence (aₙ): an indexed family, a math:Function whose math:domain is a subset of ℕ. It carries a math:Convergence through math:hasConvergence naming what it converges to and in which mode. A subclass of math:Function, so it declares its domain and codomain; a sequence asserted to converge without a math:Convergence naming the mode is ill-formed (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Series
    a owl:Class ;
    rdfs:subClassOf math:BindingExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Series"@x-gmeow-english ;
    skos:definition "A series ∑ aₙ as a first-class binding expression: it applies the math:summationBinder (math:operator), names its general term through math:seriesTerm (the summand, a body indexed by the bound summation math:VariableDeclaration), and carries a math:Convergence through math:hasConvergence naming what it converges to and in which mode (absolute, conditional, …). A series asserted to converge without a math:Convergence naming the mode is ill-formed (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Convergence
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Convergence"@x-gmeow-english ;
    skos:definition "The convergence of a sequence or series: names what it converges to through math:convergesTo and the mode through math:convergenceMode (pointwise, uniform, absolute, conditional, in-measure, almost-everywhere, in-Lᵖ-norm, in-distribution). Convergence in which mode is a declared property, not an assumption — 'the series converges' is meaningless without the mode. A convergence without a mode is ill-formed (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ConvergenceMode
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Convergence Mode"@x-gmeow-english ;
    skos:definition "The mode in which a sequence or series converges: one of math:pointwiseConvergence, math:uniformConvergence, math:absoluteConvergence, math:conditionalConvergence, math:inMeasureConvergence, math:almostEverywhereConvergence, math:inLpNormConvergence, or math:inDistributionConvergence. The mode is what distinguishes weak from strong convergence and is required on every math:Convergence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SpecialFunction
    a owl:Class ;
    rdfs:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Special Function"@x-gmeow-english ;
    skos:definition "A special function: a named function of analysis — the gamma function Γ, the Riemann zeta function ζ, the Bessel functions, the error function erf — whose identity is the GMEOW individual, aligned to a DLMF equation ID and an OpenMath transc1/calculus1 symbol, not a rendering. The named functions are first-class individuals (math:gammaFunction, math:riemannZeta, …), not per-function OWL subclasses. A subclass of math:Function, so each declares its domain and codomain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Limit-mode individuals ------------------------------------------------- #

math:limitFromLeft
    a owl:NamedIndividual , math:LimitMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "from the left (x → a⁻)"@x-gmeow-english ;
    skos:definition "The one-sided limit from below: x approaches a through values less than a."@x-gmeow-english .

math:limitFromRight
    a owl:NamedIndividual , math:LimitMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "from the right (x → a⁺)"@x-gmeow-english ;
    skos:definition "The one-sided limit from above: x approaches a through values greater than a."@x-gmeow-english .

math:limitTwoSided
    a owl:NamedIndividual , math:LimitMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "two-sided (x → a)"@x-gmeow-english ;
    skos:definition "The two-sided limit: x approaches a from both sides, requiring the left and right limits to agree. The default when a math:Limit omits its mode."@x-gmeow-english .

# --- Convergence-mode individuals (the full enumeration) -------------------- #

math:pointwiseConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "pointwise"@x-gmeow-english ;
    skos:definition "Pointwise convergence: fₙ(x) → f(x) at each point x separately. The weakest of the function-convergence modes."@x-gmeow-english .

math:uniformConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "uniform"@x-gmeow-english ;
    skos:definition "Uniform convergence: sup_x |fₙ(x) − f(x)| → 0, one rate for all points. Stronger than pointwise; preserves continuity of the limit."@x-gmeow-english .

math:absoluteConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "absolute"@x-gmeow-english ;
    skos:definition "Absolute convergence of a series: ∑ |aₙ| converges. Implies convergence and permits reordering without changing the sum."@x-gmeow-english .

math:conditionalConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "conditional"@x-gmeow-english ;
    skos:definition "Conditional convergence of a series: ∑ aₙ converges but ∑ |aₙ| diverges. Reordering can change the sum (Riemann rearrangement)."@x-gmeow-english .

math:inMeasureConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "in measure"@x-gmeow-english ;
    skos:definition "Convergence in measure: for every ε, the measure of {x : |fₙ(x) − f(x)| ≥ ε} → 0. A measure-theoretic mode, weaker than almost-everywhere on a finite measure space."@x-gmeow-english .

math:almostEverywhereConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "almost everywhere"@x-gmeow-english ;
    skos:definition "Almost-everywhere convergence: fₙ(x) → f(x) for all x outside a set of measure zero. The measure-theoretic strengthening of pointwise."@x-gmeow-english .

math:inLpNormConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "in Lᵖ norm"@x-gmeow-english ;
    skos:definition "Convergence in Lᵖ norm: ‖fₙ − f‖_p → 0. The mode of the Banach spaces Lᵖ; L² convergence (mean-square) is the Hilbert-space case."@x-gmeow-english .

math:inDistributionConvergence
    a owl:NamedIndividual , math:ConvergenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "in distribution"@x-gmeow-english ;
    skos:definition "Convergence in distribution (weak convergence of measures): the distribution functions converge at every continuity point. The probabilistic mode underlying the central limit theorem; shared with the probability charter."@x-gmeow-english .

# --- Special-function individuals (DLMF/OpenMath anchored in mappings) ------- #

math:gammaFunction
    a owl:NamedIndividual , math:SpecialFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Γ (gamma function)"@x-gmeow-english ;
    math:domain math:complexNumbers ;
    math:codomain math:complexNumbers ;
    skos:definition "The gamma function Γ(z): the analytic continuation of the factorial, Γ(n) = (n−1)!. Aligned to DLMF chapter 5 and OpenMath transc1; its identity is this individual, not a rendering."@x-gmeow-english .

math:riemannZeta
    a owl:NamedIndividual , math:SpecialFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "ζ (Riemann zeta function)"@x-gmeow-english ;
    math:domain math:complexNumbers ;
    math:codomain math:complexNumbers ;
    skos:definition "The Riemann zeta function ζ(s) = ∑ n⁻ˢ (Re s > 1), analytically continued. Aligned to DLMF chapter 25 and Wikidata; the subject of the Riemann hypothesis."@x-gmeow-english .

math:besselJ
    a owl:NamedIndividual , math:SpecialFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Jₙ (Bessel function, first kind)"@x-gmeow-english ;
    math:domain math:realNumbers ;
    math:codomain math:realNumbers ;
    skos:definition "The Bessel function of the first kind Jₙ(x): a solution of Bessel's equation regular at the origin. Aligned to DLMF chapter 10."@x-gmeow-english .

math:besselY
    a owl:NamedIndividual , math:SpecialFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Yₙ (Bessel function, second kind)"@x-gmeow-english ;
    math:domain math:realNumbers ;
    math:codomain math:realNumbers ;
    skos:definition "The Bessel function of the second kind Yₙ(x): a solution of Bessel's equation singular at the origin. Aligned to DLMF chapter 10."@x-gmeow-english .

math:errorFunction
    a owl:NamedIndividual , math:SpecialFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "erf (error function)"@x-gmeow-english ;
    math:domain math:realNumbers ;
    math:codomain math:realNumbers ;
    skos:definition "The error function erf(x) = (2/√π) ∫₀ˣ e^(−t²) dt: the Gaussian integral central to probability. Aligned to DLMF chapter 7 and OpenMath transc1."@x-gmeow-english .

# --- Calculus conformance failures ------------------------------------------ #

math:UnderspecifiedDerivative
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Derivative"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Derivative does not name what it differentiates (math:derivativeOf), the variable of differentiation (math:withRespectToVariable), and its order (math:derivativeOrder). A derivative that does not say what, with respect to which variable, and at what order is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnderspecifiedLimit
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Limit"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Limit does not name the expression whose limit is taken (math:limitOf) and its limit point (math:limitPoint). A limit that does not say of what and at which point is ill-formed; its direction/mode is optional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnderspecifiedConvergence
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Convergence"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Series or math:Sequence carries a math:Convergence that does not name what it converges to (math:convergesTo) and the mode (math:convergenceMode). 'It converges' is meaningless without the mode; a convergence without a mode is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Calculus properties ---------------------------------------------------- #

math:derivativeOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "derivative of"@x-gmeow-english ;
    skos:definition "Relates a math:Derivative to the math:MathematicalExpression (or math:Function) it differentiates. Domain math:Derivative, range math:MathematicalExpression (stated in prose). Every derivative names exactly one; a derivative without it is ill-formed (math:UnderspecifiedDerivative)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:withRespectToVariable
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "with respect to variable"@x-gmeow-english ;
    skos:definition "Relates a math:Derivative to the math:VariableDeclaration it differentiates with respect to — the bound variable of the differentiation binder. Domain math:Derivative, range math:VariableDeclaration (stated in prose). Every derivative names exactly one; a derivative without it is ill-formed (math:UnderspecifiedDerivative)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:derivativeOrder
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "derivative order"@x-gmeow-english ;
    skos:definition "The order of a math:Derivative — 1 for f′, 2 for f″, and so on. Domain math:Derivative, range xsd:positiveInteger (stated in prose). Every derivative names exactly one; a derivative without an order is ill-formed (math:UnderspecifiedDerivative)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:limitOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "limit of"@x-gmeow-english ;
    skos:definition "Relates a math:Limit to the math:MathematicalExpression whose limit is taken. Domain math:Limit, range math:MathematicalExpression (stated in prose). Every limit names exactly one; a limit without it is ill-formed (math:UnderspecifiedLimit)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:limitPoint
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "limit point"@x-gmeow-english ;
    skos:definition "Relates a math:Limit to the point its variable approaches — a math:Number, math:PositiveInfinity, or a point of a space. Domain math:Limit, range a math:Number or point (stated in prose). Every limit names exactly one; a limit without a point is ill-formed (math:UnderspecifiedLimit)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:limitMode
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "limit mode"@x-gmeow-english ;
    skos:definition "Relates a math:Limit to its math:LimitMode — the direction of approach (from the left, from the right, two-sided). Domain math:Limit, range math:LimitMode (stated in prose). Optional: a two-sided limit has no direction, so a limit may omit the mode. Where a one-sided limit is meant, the side is declared, never assumed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:seriesTerm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "series term"@x-gmeow-english ;
    skos:definition "Relates a math:Series to its general term aₙ — the summand, a math:MathematicalExpression indexed by the bound summation variable. Domain math:Series, range math:MathematicalExpression (stated in prose). Every series names its general term."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasConvergence
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has convergence"@x-gmeow-english ;
    skos:definition "Relates a math:Series or math:Sequence to the math:Convergence describing what it converges to and in which mode. Domain a math:Series or math:Sequence, range math:Convergence (stated in prose). A series/sequence asserted to converge names its convergence; the mode is required (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:convergesTo
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "converges to"@x-gmeow-english ;
    skos:definition "Relates a math:Convergence to the value or expression its sequence/series converges to — a math:Number, a limit function, or a distribution. Domain math:Convergence, range a math:MathematicalObject or value (stated in prose). Every convergence names what it converges to."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:convergenceMode
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "convergence mode"@x-gmeow-english ;
    skos:definition "Relates a math:Convergence to its math:ConvergenceMode — pointwise, uniform, absolute, conditional, in-measure, almost-everywhere, in-Lᵖ-norm, or in-distribution. Domain math:Convergence, range math:ConvergenceMode (stated in prose). The mode is required; convergence without a declared mode is ill-formed (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
