# =========================================================================== #
# STATISTICS TERM-SURFACE SATURATION — per-term competency coverage.           #
# The questions below saturate the statistics vocabulary: every class, object  #
# property, the one rdf:Property, and the six math:Sidedness individuals is the #
# pinned answer of a GENUINE enumeration/structure question. Taxonomy questions #
# (SATQ1–4) run over the merged ontology directly (no cqDataFile); the rest run #
# over a worked-example fixture unioned in by gmeow:cqDataFile. All are         #
# reasoning-free (gmeow:reasoningNone) and pinned exactly (logic:RowsExact).    #
# =========================================================================== #

# === SATQ1 — which result kinds are frequentist ============================= #

ex:cqStatisticsFrequentistResultKinds a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-frequentist-result-kinds.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The frequentist result vocabulary made enumerable: each frequentist inference result is asserted a DIRECT rdfs:subClassOf math:FrequentistResult in module.ttl, so the reasoning-free query walks the asserted edge with no closure. Over the merged ontology the answer is exactly the six frequentist result kinds {math:PValue, math:StatisticalPower, math:TypeIErrorRate, math:TypeIIErrorRate, math:ConfidenceInterval, math:ConfidenceRegion}; adding or mistyping a frequentist result would break this exact-match gate." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsFrequentistResultKindsShape ;
    gmeow:cqExpectRow ex:rowFreqPValue , ex:rowFreqStatisticalPower , ex:rowFreqTypeIErrorRate ,
        ex:rowFreqTypeIIErrorRate , ex:rowFreqConfidenceInterval , ex:rowFreqConfidenceRegion .

ex:cqStatisticsFrequentistResultKindsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "kind" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowFreqPValue a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:PValue ] .
ex:rowFreqStatisticalPower a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:StatisticalPower ] .
ex:rowFreqTypeIErrorRate a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:TypeIErrorRate ] .
ex:rowFreqTypeIIErrorRate a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:TypeIIErrorRate ] .
ex:rowFreqConfidenceInterval a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:ConfidenceInterval ] .
ex:rowFreqConfidenceRegion a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:ConfidenceRegion ] .

