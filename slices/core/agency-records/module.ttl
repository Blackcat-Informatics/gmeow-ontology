    gmeow:avoidWhen "Avoid inventing missing source bindings or inferring execution and success from this record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."@x-gmeow-english ;
    skos:scopeNote "Source evidence and configuration remain distinct. Competing attributed records may coexist without a preferred claim."@x-gmeow-english ;
    skos:example "ex:record gmeow:auditText \"source-value\" ."@x-gmeow-english ;
    logic:domain gmeow:ToolCall ;
    logic:range rdfs:Literal .

gmeow:ToolCall logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:auditText ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( xsd:string rdf:langString rdf:dirLangString ) ] ] .

