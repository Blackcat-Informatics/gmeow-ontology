ex:movesFrontierLabel a logic:Formula ;
    rdfs:label "The 16 positions the FrontierLabel axis ranges over"@x-gmeow-english ;
    logic:relation logic:FrontierLabel ;
    logic:argument
        [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termIri logic:FrontierBlockedCapabilityOrResource ] ,
        [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri logic:FrontierBlockedPrecondition ] ,
        [ a logic:TermCarrier ; logic:termIndex 2 ; logic:termIri logic:FrontierCancelled ] ,
        [ a logic:TermCarrier ; logic:termIndex 3 ; logic:termIri logic:FrontierCancelledWithInFlightEffects ] ,
        [ a logic:TermCarrier ; logic:termIndex 4 ; logic:termIri logic:FrontierCompensationEligible ] ,
        [ a logic:TermCarrier ; logic:termIndex 5 ; logic:termIri logic:FrontierCompensationFailedForwardCommitted ] ,
        [ a logic:TermCarrier ; logic:termIndex 6 ; logic:termIri logic:FrontierCompensationRequired ] ,
        [ a logic:TermCarrier ; logic:termIndex 7 ; logic:termIri logic:FrontierCompleted ] ,
        [ a logic:TermCarrier ; logic:termIndex 8 ; logic:termIri logic:FrontierMutuallyExclusive ] ,
        [ a logic:TermCarrier ; logic:termIndex 9 ; logic:termIri logic:FrontierReadyApprovalRequired ] ,
        [ a logic:TermCarrier ; logic:termIndex 10 ; logic:termIri logic:FrontierReadyAuthorized ] ,
        [ a logic:TermCarrier ; logic:termIndex 11 ; logic:termIri logic:FrontierReconciliationImpossible ] ,
        [ a logic:TermCarrier ; logic:termIndex 12 ; logic:termIri logic:FrontierReconciliationRequired ] ,
        [ a logic:TermCarrier ; logic:termIndex 13 ; logic:termIri logic:FrontierSkippedWithTypedReason ] ,
        [ a logic:TermCarrier ; logic:termIndex 14 ; logic:termIri logic:FrontierTerminallyFailed ] ,
        [ a logic:TermCarrier ; logic:termIndex 15 ; logic:termIri logic:FrontierWaitingOnEventTimeOrInput ] .

