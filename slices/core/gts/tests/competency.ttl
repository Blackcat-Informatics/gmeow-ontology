# =========================================================================== #
# 5. Which selector kinds does each shipped dictionary's corpus actually use?  #
# =========================================================================== #

ex:cqDictionaryCorpusSelectors a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/gts/queries/competency/dictionary-corpus-selectors.rq" ;
    gmeow:cqRationale "A zstd dictionary is a verbatim substring table of its training corpus, so 'what did this dictionary train on?' is a PRIVACY and a REPRODUCIBILITY question, not a tuning detail — it is the question that establishes that the two memory dictionaries learn the shape of BUNDLE-SHIPPED claims and never a user's runtime store. The query joins the four selector kinds from the disjunctive-requiredness constraint that DECLARES them rather than listing them inline, so the answer stays honest in both directions: a fifth selector minted with no corpus using it, or a corpus reaching through a predicate the constraint does not admit, changes this result instead of slipping past. The row set also shows the two routings the axis needs and why: an archive-rep selector names material some stage tars, while the proof-trace corpus must select a STAGE PRODUCT because its archive is sink-folded and does not exist as a standalone rep at the moment the trainer runs. Get this wrong and a corpus resolves to nothing — which is not a smaller training set, it is a dictionary trained on nothing while every downstream measurement keeps reporting a number." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:shapeDictionaryCorpusSelectors ;
    gmeow:cqExpectRow
        ex:rowSelector02 ,
        ex:rowSelector03 ,
        ex:rowSelector04 ,
        ex:rowSelector05 ,
        ex:rowSelector06 ,
        ex:rowSelector07 ,
        ex:rowSelector08 ,
        ex:rowSelector09 ,
        ex:rowSelector10 ,
        ex:rowSelector11 ,
        ex:rowSelector12 .

ex:shapeDictionaryCorpusSelectors a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "dictionary" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "corpus" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "selector" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowSelector02 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dictionary" ; gmeow:cellValueIri gmeow:dictGmeowCoreV1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corpus" ; gmeow:cellValueIri gmeow:corpusGmeowCoreV1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "selector" ; gmeow:cellValueIri gmeow:corpusSelectsBlobRep ] .
ex:rowSelector03 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dictionary" ; gmeow:cellValueIri gmeow:dictGmeowCoreV1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corpus" ; gmeow:cellValueIri gmeow:corpusGmeowCoreV1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "selector" ; gmeow:cellValueIri gmeow:corpusSelectsPathPrefix ] .
