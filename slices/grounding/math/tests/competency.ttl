    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-hypothesis-kinds.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The hypothesis taxonomy made enumerable: a math:NullHypothesis and a math:AlternativeHypothesis are both asserted DIRECT rdfs:subClassOf the abstract math:Hypothesis in module.ttl, so the query names both leaf kinds AND the parent they specialize. Over the merged ontology the answer is exactly {math:NullHypothesis → math:Hypothesis, math:AlternativeHypothesis → math:Hypothesis}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsHypothesisKindsShape ;
    gmeow:cqExpectRow ex:rowHypNull , ex:rowHypAlternative .

