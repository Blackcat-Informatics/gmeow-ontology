                        logic:exists [ a logic:Formula ; logic:relation gmeow:structuredTerm ; logic:argument [ logic:termIndex 0 ; logic:termVariable "interludeOccurrence" ] , [ logic:termIndex 1 ; logic:termVariable "i3Payload" ] ] ] ] ,
