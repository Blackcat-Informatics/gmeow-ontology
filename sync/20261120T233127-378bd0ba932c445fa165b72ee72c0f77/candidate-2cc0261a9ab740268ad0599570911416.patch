+                        Value::Text("native-execution-receipt".into()),
+                    ),
+                    (
+                        Value::Text("mt".into()),
+                        Value::Text("application/cbor".into()),
+                    ),
+                ])),
+                ..Default::default()
+            },
+        )
+        .unwrap();
+    history.extend(repeated.into_bytes());
+    assert!(
