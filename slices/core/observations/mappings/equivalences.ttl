    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# QB — RDF Data Cube

gmeow:eqObs054 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SensoryObservation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject qb:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "QB Observation is contextual — a SensoryObservation becomes a QB Observation when it is part of a qb:DataSet / qb:Slice. The alignment is closeMatch with context note." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# OM — Ontology of Units of Measure (complementing existing QUDT alignment)

gmeow:eqObs055 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:unit ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject om:hasUnit ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OM models om:hasUnit as the property relating a measure to its om:Unit; gmeow:unit is the parallel property edge (a quantity to its unit IRI), so the alignment stays property-to-property. GMEOW unit points to QUDT by default, with OM as an alternative by reference." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# --------------------------------------------------------------------------- #
