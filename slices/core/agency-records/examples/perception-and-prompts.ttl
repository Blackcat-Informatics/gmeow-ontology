@prefix ex: <https://example.org/perception-and-prompts/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# All identities and assertions below belong to this hypothetical source scene.
# Source-local EventType values add no canonical coats or original source facts.
# Every scene assertion has its exact native reifier and independent source/frame.
# Shared words retain wording; holderWords alone reports its words not kept.
# unspecifiedWords has no text or retention tag; unknownPromptAct has no prompt bit.
# The opaque prompt IRI deliberately has no invented type, kind or holder triples.
# The source string spaces and explicit token datatypes remain unchanged.
# Neither range declarations nor this illustration execute holder isolation.

ex:holderA rdf:type gmeow:Agent .
ex:holderA rdfs:label "First source-identified hearer and actor"@en .
ex:holderB rdf:type gmeow:Agent .
ex:holderB rdfs:label "Second source-identified hearer"@en .
ex:speaker rdf:type gmeow:Agent .
ex:speaker rdfs:label "Attributed speaker"@en .
ex:voice rdf:type gmeow:Agent .
ex:voice rdfs:label "Actual stand-in utterance producer"@en .
ex:seenActor rdf:type gmeow:Agent .
ex:seenActor rdfs:label "Source-identified actor of the seen act"@en .
ex:recorder rdf:type gmeow:SoftwareAgent .
ex:recorder rdf:type gmeow:Agent .
ex:recorder rdfs:label "Recording importer"@en .
ex:writerA rdf:type gmeow:Agent .
ex:writerA rdfs:label "First declaring source frame"@en .
ex:writerB rdf:type gmeow:Agent .
ex:writerB rdfs:label "Second declaring source frame"@en .
ex:sourceA rdf:type gmeow:InformationObject .
ex:sourceA rdfs:label "First hypothetical source account"@en .
ex:sourceB rdf:type gmeow:InformationObject .
ex:sourceB rdfs:label "Second hypothetical source account"@en .
ex:courtyard rdf:type gmeow:Place .
ex:courtyard rdfs:label "Place explicitly named by the hypothetical source"@en .
ex:observedActKind rdf:type gmeow:EventType .
ex:observedActKind rdfs:label "Observed act kind declared only by this hypothetical source"@en .
ex:resultingActKind rdf:type gmeow:EventType .
ex:resultingActKind rdfs:label "Resulting act kind declared only by this hypothetical source"@en .
ex:sharedWords rdf:type gmeow:Message .
ex:sharedWords rdfs:label "Message content heard through two receptions"@en .
ex:holderWords rdf:type gmeow:Message .
ex:holderWords rdfs:label "Separate holder-specific heard-word record without retained wording"@en .
ex:unspecifiedWords rdf:type gmeow:Message .
ex:unspecifiedWords rdfs:label "Message with no supplied wording or retention assessment"@en .
ex:hearingA rdf:type gmeow:Activity .
ex:hearingA rdfs:label "First hearing occurrence"@en .
ex:hearingB rdf:type gmeow:Activity .
ex:hearingB rdfs:label "Independent hearing occurrence for the same content"@en .
ex:seeingA rdf:type gmeow:Activity .
ex:seeingA rdfs:label "Seeing occurrence of the first holder"@en .
ex:observedAct rdf:type gmeow:Activity .
ex:observedAct rdfs:label "Actual seen act separate from the seeing occurrence"@en .
ex:resultingAct rdf:type gmeow:Activity .
ex:resultingAct rdfs:label "Act reported as prompted by the holder's hearing and seeing"@en .
ex:opaqueReferenceAct rdf:type gmeow:Activity .
ex:opaqueReferenceAct rdfs:label "Act retaining an opaque prompt reference and unresolved alias"@en .
ex:unpromptedAct rdf:type gmeow:Activity .
ex:unpromptedAct rdfs:label "Act explicitly assessed as unprompted"@en .
ex:deniedUnpromptedAct rdf:type gmeow:Activity .
ex:deniedUnpromptedAct rdfs:label "Act explicitly denied the unprompted assessment"@en .
ex:unknownPromptAct rdf:type gmeow:Activity .
ex:unknownPromptAct rdfs:label "Act with no supplied prompt assessment"@en .
ex:disputedAct rdf:type gmeow:Activity .
ex:disputedAct rdfs:label "Act with competing source-attributed assessments"@en .
ex:hearingWithoutWords rdf:type gmeow:Activity .
ex:hearingWithoutWords rdfs:label "Hearing whose holder-specific words were not kept"@en .
ex:hearingUnspecifiedWords rdf:type gmeow:Activity .
ex:hearingUnspecifiedWords rdfs:label "Hearing with no supplied word-retention assessment"@en .
ex:sharedWords gmeow:wasAttributedTo ex:speaker .
ex:sharedWords gmeow:saidOnBehalfBy ex:voice .
ex:sharedWords gmeow:utteranceText "The gate is open."@en .
ex:hearingA gmeow:eventType gmeow:eventTypeAgentHeard .
ex:hearingA gmeow:wasAssociatedWith ex:holderA .
ex:hearingA gmeow:heardMessage ex:sharedWords .
ex:hearingA gmeow:receivedViaCode " room relay " .
ex:hearingB gmeow:eventType gmeow:eventTypeAgentHeard .
ex:hearingB gmeow:wasAssociatedWith ex:holderB .
ex:hearingB gmeow:heardMessage ex:sharedWords .
ex:hearingB gmeow:receivedViaCode "relay"^^xsd:token .
ex:seeingA gmeow:eventType gmeow:eventTypeAgentSaw .
ex:seeingA gmeow:wasAssociatedWith ex:holderA .
ex:seeingA gmeow:sawAct ex:observedAct .
ex:observedAct gmeow:eventType ex:observedActKind .
ex:observedAct gmeow:wasAssociatedWith ex:seenActor .
ex:observedAct gmeow:eventLocation ex:courtyard .
ex:resultingAct gmeow:eventType ex:resultingActKind .
ex:resultingAct gmeow:wasAssociatedWith ex:holderA .
ex:resultingAct gmeow:promptedBy ex:hearingA .
ex:resultingAct gmeow:promptedBy ex:seeingA .
ex:opaqueReferenceAct gmeow:eventType ex:resultingActKind .
ex:opaqueReferenceAct gmeow:wasAssociatedWith ex:holderA .
ex:opaqueReferenceAct gmeow:promptedBy <https://example.org/source-memory/prompt-8> .
ex:opaqueReferenceAct gmeow:promptedByAlias "source:heard-8"^^xsd:token .
ex:opaqueReferenceAct gmeow:promptedByAlias " local alias 8 " .
ex:unpromptedAct gmeow:eventType ex:resultingActKind .
ex:unpromptedAct gmeow:wasAssociatedWith ex:holderA .
ex:unpromptedAct gmeow:actUnprompted true .
ex:deniedUnpromptedAct gmeow:eventType ex:resultingActKind .
ex:deniedUnpromptedAct gmeow:wasAssociatedWith ex:holderA .
ex:deniedUnpromptedAct gmeow:actUnprompted false .
ex:unknownPromptAct gmeow:eventType ex:resultingActKind .
ex:unknownPromptAct gmeow:wasAssociatedWith ex:holderA .
ex:disputedAct gmeow:eventType ex:resultingActKind .
ex:disputedAct gmeow:wasAssociatedWith ex:holderA .
ex:disputedAct gmeow:actUnprompted true .
ex:disputedAct gmeow:actUnprompted false .
ex:hearingWithoutWords gmeow:eventType gmeow:eventTypeAgentHeard .
ex:hearingWithoutWords gmeow:wasAssociatedWith ex:holderA .
ex:hearingWithoutWords gmeow:heardMessage ex:holderWords .
ex:holderWords gmeow:wasAttributedTo ex:speaker .
ex:holderWords gmeow:hasTag gmeow:tagWordsNotKept .
ex:hearingUnspecifiedWords gmeow:eventType gmeow:eventTypeAgentHeard .
ex:hearingUnspecifiedWords gmeow:wasAssociatedWith ex:holderA .
ex:hearingUnspecifiedWords gmeow:heardMessage ex:unspecifiedWords .
ex:unspecifiedWords gmeow:wasAttributedTo ex:speaker .

# Exact asserted statement identities; metadata never propagates to neighbors.

ex:statement001 rdf:reifies <<( ex:holderA rdf:type gmeow:Agent )>> ;
    gmeow:wasDerivedFrom ex:sourceA ;
    gmeow:wasAttributedTo ex:recorder ;
    gmeow:accordingTo ex:writerA .

ex:statement002 rdf:reifies <<( ex:holderA rdfs:label "First source-identified hearer and actor"@en )>> ;
