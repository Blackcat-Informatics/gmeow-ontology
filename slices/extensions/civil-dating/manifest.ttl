@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/civil-dating>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/civil-dating> ;
    gmeow:sliceTier gmeow:tierExtension ;
    rdfs:label "Civil dating"@x-gmeow-english ;
    skos:definition "Source-attributed civil-day expressions and event dating observations with explicit calendar frames and preserved source literals."@x-gmeow-english ;
    dcterms:title "Civil dating evidence"@x-gmeow-english ;
    gmeow:sliceConsumer "Event archives and source record importers retaining civil-day assertions without inventing clock times."@x-gmeow-english ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic>,
        <https://blackcatinformatics.ca/gmeow/slices/lang>,
        <https://blackcatinformatics.ca/gmeow/slices/kernel>,
        <https://blackcatinformatics.ca/gmeow/slices/temporal>,
        <https://blackcatinformatics.ca/gmeow/slices/observations>,
        <https://blackcatinformatics.ca/gmeow/slices/events>,
        <https://blackcatinformatics.ca/gmeow/slices/places> .
