    skos:definition "Genre is a value vocabulary / first-class Kind; no subclasses are allowed (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    logic:formalizes gmeow:GenreNoSubclassConstraint ;
    sh:targetNode gmeow:Genre ;
    sh:sparql [
        sh:select """
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this
            WHERE {
                ?sub rdfs:subClassOf $this .
                FILTER (?sub != $this)
            }
        """ ;
        sh:message "Genre must not be subclassed (Principle 9)." ;
    ] .
