# Competency question: "Does a version whose beginning event carries no material date govern a
# matter at a date?"
#
# The boundary has no gmeow:eventTime. It cannot establish the beginning of the amended version
# or place the earlier version's end after the matter's date. No version is asserted to govern.

PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?asOf ?version WHERE {
    VALUES ?asOf { "2012-01-01"^^xsd:date }
    ?version gmeow:versionOf <https://blackcatinformatics.ca/gmeow/examples/norms/provision/sec7> ;
        gmeow:versionBeganBy ?began .
    ?began gmeow:eventTime ?beganAt .
    FILTER(?beganAt <= ?asOf)
    FILTER NOT EXISTS {
        ?version gmeow:versionEndedBy ?ended .
        OPTIONAL { ?ended gmeow:eventTime ?endedAt }
        FILTER(!BOUND(?endedAt) || ?endedAt <= ?asOf)
    }
}
