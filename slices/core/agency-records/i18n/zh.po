msgctxt "https://blackcatinformatics.ca/gmeow/auditText|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:auditText \"source-value\" ."
msgstr "ex:record gmeow:auditText \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|http://www.w3.org/2000/01/rdf-schema#label"
msgid "commitment text"
msgstr "自我承诺文本"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|http://www.w3.org/2004/02/skos/core#definition"
msgid "The self-commitment wording of an intention, verbatim. It records the agent's own commitment without manufacturing another party, contractual Commitment or achieved goal."
msgstr "意图的逐字自我承诺措辞。它记录智能体自身承诺，不虚构其他参与方、契约性 Commitment 或已达成目标。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "用于来源明确提供此关系及其情境时。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "避免虚构缺失的来源绑定，或仅凭此记录推断执行和成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."
msgstr "保留实际来源值、身份和归属；保持提供的措辞、语言和方向。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Source evidence and configuration remain distinct. Competing attributed records may coexist without a preferred claim."
msgstr "来源证据与配置保持区分。相互竞争且注明归属的记录可并存，不设优先主张。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:commitmentText \"source-value\" ."
msgstr "ex:record gmeow:commitmentText \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|http://www.w3.org/2000/01/rdf-schema#label"
msgid "commitment origin"
msgstr "自我承诺来源措辞"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source's verbatim wording for the origin of a self-commitment. It is a source claim, distinct from structured adoption provenance and contractual authority."
msgstr "来源对自我承诺起源的逐字措辞。这是来源主张，区别于结构化采纳来源和契约权威。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "用于来源明确提供此关系及其情境时。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "避免虚构缺失的来源绑定，或仅凭此记录推断执行和成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."
msgstr "保留实际来源值、身份和归属；保持提供的措辞、语言和方向。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Source evidence and configuration remain distinct. Competing attributed records may coexist without a preferred claim."
msgstr "来源证据与配置保持区分。相互竞争且注明归属的记录可并存，不设优先主张。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:commitmentOrigin \"source-value\" ."
msgstr "ex:record gmeow:commitmentOrigin \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|http://www.w3.org/2000/01/rdf-schema#label"
msgid "release reason"
msgstr "解除承诺理由"

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|http://www.w3.org/2004/02/skos/core#definition"
msgid "The verbatim source reason a self-commitment was released, attached to its closed IntentionTenure. Retain the actual interval end and history rather than erasing the intention or inventing an end date."
msgstr "自我承诺被解除的逐字来源理由，附在已关闭的 IntentionTenure 上。保留真实区间终点和历史，不删除意图，也不虚构结束日期。"

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "用于来源明确提供此关系及其情境时。"

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "避免虚构缺失的来源绑定，或仅凭此记录推断执行和成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."
msgstr "保留实际来源值、身份和归属；保持提供的措辞、语言和方向。"

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Source evidence and configuration remain distinct. Competing attributed records may coexist without a preferred claim."
msgstr "来源证据与配置保持区分。相互竞争且注明归属的记录可并存，不设优先主张。"

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:releaseReason \"source-value\" ."
msgstr "ex:record gmeow:releaseReason \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Goal condition occurrence constraint"
msgstr "目标条件出现项约束"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "Each linked condition occurrence retains its source prose, exact local key, zero-based ordinal and a configured verifier of the same goal with that exact key; no executable goal expression is manufactured."
msgstr "每个关联条件出现项保留来源文字、精确局部键、从零开始的位置，以及同一目标中使用该精确键的配置验证描述符；不得虚构可执行目标表达式。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of hasSatisfactionCondition."
msgstr "用于强制执行 hasSatisfactionCondition 的来源证据义务。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying this law with invented source values or fallback prose."
msgstr "避免使用虚构来源值或后备文字满足此法则。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the actual source bindings expressed by this canonical formula."
msgstr "保留此规范公式表达的实际来源绑定。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This law constrains supplied records; it neither runs a verifier nor authenticates an external source."
msgstr "此法则约束已提供的记录；既不运行验证器，也不认证外部来源。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:GoalConditionOccurrenceConstraint logic:formalizes gmeow:hasSatisfactionCondition ."
msgstr "gmeow:GoalConditionOccurrenceConstraint logic:formalizes gmeow:hasSatisfactionCondition ."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Goal verifier condition binding constraint"
msgstr "目标验证描述符条件绑定约束"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A configured goal verifier names an actual condition of that same goal through the identical source key."
msgstr "配置的目标验证描述符通过相同来源键指明同一目标的实际条件。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of hasConditionVerifier."
msgstr "用于强制执行 hasConditionVerifier 的来源证据义务。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying this law with invented source values or fallback prose."
msgstr "避免使用虚构来源值或后备文字满足此法则。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the actual source bindings expressed by this canonical formula."
msgstr "保留此规范公式表达的实际来源绑定。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This law constrains supplied records; it neither runs a verifier nor authenticates an external source."
msgstr "此法则约束已提供的记录；既不运行验证器，也不认证外部来源。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:GoalVerifierConditionBindingConstraint logic:formalizes gmeow:hasConditionVerifier ."
msgstr "gmeow:GoalVerifierConditionBindingConstraint logic:formalizes gmeow:hasConditionVerifier ."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalEvaluationConditionBindingConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Goal evaluation condition binding constraint"
msgstr "目标评估条件绑定约束"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalEvaluationConditionBindingConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A keyed goal evaluation identifies its actual evaluated goal and a matching configured verifier and condition within that goal."
msgstr "带条件键的目标评估标识实际被评估目标，以及该目标内匹配的配置验证描述符和条件。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalEvaluationConditionBindingConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of conditionKey."
msgstr "用于强制执行 conditionKey 的来源证据义务。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalEvaluationConditionBindingConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying this law with invented source values or fallback prose."
msgstr "避免使用虚构来源值或后备文字满足此法则。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalEvaluationConditionBindingConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the actual source bindings expressed by this canonical formula."
msgstr "保留此规范公式表达的实际来源绑定。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalEvaluationConditionBindingConstraint|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This law constrains supplied records; it neither runs a verifier nor authenticates an external source."
msgstr "此法则约束已提供的记录；既不运行验证器，也不认证外部来源。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalEvaluationConditionBindingConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:GoalEvaluationConditionBindingConstraint logic:formalizes gmeow:conditionKey ."
msgstr "gmeow:GoalEvaluationConditionBindingConstraint logic:formalizes gmeow:conditionKey ."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionKeyUniquenessConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Goal condition key uniqueness constraint"
msgstr "目标条件键唯一性约束"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionKeyUniquenessConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A source key identifies one condition occurrence within one goal, without identifying conditions across goals."
msgstr "来源键在同一目标内标识一个条件出现项，不据此跨目标识别条件。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionKeyUniquenessConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of hasSatisfactionCondition."
msgstr "用于强制执行 hasSatisfactionCondition 的来源证据义务。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionKeyUniquenessConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying this law with invented source values or fallback prose."
msgstr "避免使用虚构来源值或后备文字满足此法则。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionKeyUniquenessConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the actual source bindings expressed by this canonical formula."
msgstr "保留此规范公式表达的实际来源绑定。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionKeyUniquenessConstraint|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This law constrains supplied records; it neither runs a verifier nor authenticates an external source."
msgstr "此法则约束已提供的记录；既不运行验证器，也不认证外部来源。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionKeyUniquenessConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:GoalConditionKeyUniquenessConstraint logic:formalizes gmeow:hasSatisfactionCondition ."
msgstr "gmeow:GoalConditionKeyUniquenessConstraint logic:formalizes gmeow:hasSatisfactionCondition ."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOrdinalUniquenessConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Goal condition ordinal uniqueness constraint"
msgstr "目标条件序位唯一性约束"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOrdinalUniquenessConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A zero-based position identifies one condition occurrence within one goal's ordered condition sequence."
msgstr "从零开始的位置在同一目标的有序条件序列内标识一个条件出现项。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOrdinalUniquenessConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of hasSatisfactionCondition."
msgstr "用于强制执行 hasSatisfactionCondition 的来源证据义务。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOrdinalUniquenessConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying this law with invented source values or fallback prose."
msgstr "避免使用虚构来源值或后备文字满足此法则。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOrdinalUniquenessConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the actual source bindings expressed by this canonical formula."
msgstr "保留此规范公式表达的实际来源绑定。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOrdinalUniquenessConstraint|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This law constrains supplied records; it neither runs a verifier nor authenticates an external source."
msgstr "此法则约束已提供的记录；既不运行验证器，也不认证外部来源。"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOrdinalUniquenessConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:GoalConditionOrdinalUniquenessConstraint logic:formalizes gmeow:hasSatisfactionCondition ."
msgstr "gmeow:GoalConditionOrdinalUniquenessConstraint logic:formalizes gmeow:hasSatisfactionCondition ."

msgctxt "https://blackcatinformatics.ca/gmeow/ExpectedStatementReifierConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Expected statement reifier constraint"
msgstr "预期陈述重述绑定约束"

msgctxt "https://blackcatinformatics.ca/gmeow/ExpectedStatementReifierConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "Each expectedStatement shares its exact native triple term with explicit rdf:reifies on the descriptor; quotation is not assertion or a generic triple-term validator."
msgstr "每个 expectedStatement 与描述符上显式 rdf:reifies 共享精确原生三元组项；引用不等于断言，也不是通用三元组项验证器。"

msgctxt "https://blackcatinformatics.ca/gmeow/ExpectedStatementReifierConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of expectedStatement."
msgstr "用于强制执行 expectedStatement 的来源证据义务。"

msgctxt "https://blackcatinformatics.ca/gmeow/ExpectedStatementReifierConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying this law with invented source values or fallback prose."
msgstr "避免使用虚构来源值或后备文字满足此法则。"

msgctxt "https://blackcatinformatics.ca/gmeow/ExpectedStatementReifierConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the actual source bindings expressed by this canonical formula."
msgstr "保留此规范公式表达的实际来源绑定。"

msgctxt "https://blackcatinformatics.ca/gmeow/ExpectedStatementReifierConstraint|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This law constrains supplied records; it neither runs a verifier nor authenticates an external source."
msgstr "此法则约束已提供的记录；既不运行验证器，也不认证外部来源。"

msgctxt "https://blackcatinformatics.ca/gmeow/ExpectedStatementReifierConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:ExpectedStatementReifierConstraint logic:formalizes gmeow:expectedStatement ."
msgstr "gmeow:ExpectedStatementReifierConstraint logic:formalizes gmeow:expectedStatement ."

msgctxt "https://blackcatinformatics.ca/gmeow/FollowedProsePlanConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Followed prose plan constraint"
msgstr "遵循文字计划约束"

msgctxt "https://blackcatinformatics.ca/gmeow/FollowedProsePlanConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A followed prose plan is retained on an attempt-start event and carries actual planText, without introducing an executable Plan."
msgstr "遵循的文字计划保留在尝试开始事件上，承载真实 planText，而不引入可执行 Plan。"

msgctxt "https://blackcatinformatics.ca/gmeow/FollowedProsePlanConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of followedPlan."
msgstr "用于强制执行 followedPlan 的来源证据义务。"

msgctxt "https://blackcatinformatics.ca/gmeow/FollowedProsePlanConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying this law with invented source values or fallback prose."
msgstr "避免使用虚构来源值或后备文字满足此法则。"

msgctxt "https://blackcatinformatics.ca/gmeow/FollowedProsePlanConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the actual source bindings expressed by this canonical formula."
msgstr "保留此规范公式表达的实际来源绑定。"

msgctxt "https://blackcatinformatics.ca/gmeow/FollowedProsePlanConstraint|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This law constrains supplied records; it neither runs a verifier nor authenticates an external source."
msgstr "此法则约束已提供的记录；既不运行验证器，也不认证外部来源。"

msgctxt "https://blackcatinformatics.ca/gmeow/FollowedProsePlanConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:FollowedProsePlanConstraint logic:formalizes gmeow:followedPlan ."
msgstr "gmeow:FollowedProsePlanConstraint logic:formalizes gmeow:followedPlan ."

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptSummaryPhaseConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Attempt summary phase constraint"
msgstr "尝试总结阶段约束"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptSummaryPhaseConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source text belongs to an actual attempt-finish event; it supplies neither a goal verdict nor a later execution."
msgstr "来源文本属于真实尝试结束事件，不提供目标判定或后续执行。"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptSummaryPhaseConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of attemptSummary."
msgstr "用于强制执行 attemptSummary 的来源证据义务。"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptSummaryPhaseConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying this law with invented source values or fallback prose."
msgstr "避免使用虚构来源值或后备文字满足此法则。"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptSummaryPhaseConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the actual source bindings expressed by this canonical formula."
msgstr "保留此规范公式表达的实际来源绑定。"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptSummaryPhaseConstraint|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This law constrains supplied records; it neither runs a verifier nor authenticates an external source."
msgstr "此法则约束已提供的记录；既不运行验证器，也不认证外部来源。"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptSummaryPhaseConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:AttemptSummaryPhaseConstraint logic:formalizes gmeow:attemptSummary ."
msgstr "gmeow:AttemptSummaryPhaseConstraint logic:formalizes gmeow:attemptSummary ."

msgctxt "https://blackcatinformatics.ca/gmeow/BodyCausePhaseConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Body cause phase constraint"
msgstr "运行体停止原因阶段约束"

msgctxt "https://blackcatinformatics.ca/gmeow/BodyCausePhaseConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source text belongs to an actual attempt-finish event; it supplies neither a goal verdict nor a later execution."
msgstr "来源文本属于真实尝试结束事件，不提供目标判定或后续执行。"

msgctxt "https://blackcatinformatics.ca/gmeow/BodyCausePhaseConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of bodyCause."
msgstr "用于强制执行 bodyCause 的来源证据义务。"

msgctxt "https://blackcatinformatics.ca/gmeow/BodyCausePhaseConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying this law with invented source values or fallback prose."
