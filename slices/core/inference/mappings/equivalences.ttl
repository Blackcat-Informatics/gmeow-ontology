@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix wd:     <http://www.wikidata.org/entity/> .


# Term equivalences for the inference facility (Peirce's tetrad) — GMEOW
# authoring source. Compiled to mappings/gmeow-inference.sssom.tsv by
# `gmeow compile-mappings`. All alignments are BY REFERENCE (Principle 5); GMEOW
# never imports an external axiom. Wikidata QIDs curl-verified 2026-06-15.
# See slices/core/inference/docs.md.

gmeow:mapsetInference a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/inference" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Inference / Peirce's tetrad alignments.
        PROV-O: an occurrent gmeow:InferenceProcess is a prov:Activity; gmeow:inferredFrom realises prov:wasDerivedFrom (the conclusion is derived from its premises); a conclusion gmeow:StandpointClaim is a prov:Entity (aligned in the deception/observations sets).
        CRMinf: gmeow:InferenceProcess aligns to I5_Inference_Making (the inference-making event); the endurant gmeow:InferenceCommitment aligns to I1_Argumentation (the structured argument); gmeow:StandpointModality reuses I6_Belief_Value (aligned in the deception set).
        Wikidata: the four gmeow:InferenceMode values map to the reasoning concepts deductive (Q484284) / inductive (Q484511) / abductive (Q308495) reasoning and analogy (Q185816); gmeow:InferenceProcess relates to 'inference' (Q408386); the defeasibility machinery (gmeow:Attack) relates to 'defeasible reasoning' (Q840067).
        BY PROSE ONLY (no stable resolvable RDF namespace suitable for SSSOM rows): Peirce's original tetrad (CP 2.619ff); Toulmin's warrant/backing/rebuttal model (gmeow:warrant, gmeow:Attack); Gentner's Structure-Mapping Engine / systematicity principle (gmeow:Analogy, gmeow:systematicity); Pollock's rebutting/undercutting defeater distinction, now the three-way typed gmeow:AttackKind (undermine/undercut/rebut); AIF / ASPIC+ / Dung abstract argumentation (gmeow:Argument, gmeow:Attack, gmeow:Support, gmeow:ArgumentEvaluation), referenced for the solver-layer acceptability function but lacking a stable SSSOM-suitable namespace.""" .

# PROV-O — the reasoning episode is an activity; derivation links premises to conclusion.
gmeow:InferenceProcess skos:relatedMatch prov:Activity {|
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "an occurrent inference episode is a provenance activity; the epistemic/Peircean semantics are GMEOW-specific and not entailed by PROV-O"
|} .

gmeow:inferredFrom skos:closeMatch prov:wasDerivedFrom {|
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "gmeow:inferredFrom (conclusion-claim to premise) is the epistemic face of prov:wasDerivedFrom; GMEOW adds the inference mode and defeasibility PROV-O does not carry"
|} .

# CRMinf — inference making (event) and argumentation (structure).
gmeow:InferenceProcess skos:closeMatch crminf:I5_Inference_Making {|
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "the occurrent gmeow:InferenceProcess is CRMinf's I5 Inference Making — the reasoning event that produces a belief"
|} .

gmeow:InferenceCommitment skos:closeMatch crminf:I1_Argumentation {|
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "the endurant gmeow:InferenceCommitment (premises, conclusion, warrant, defeaters) is CRMinf's I1 Argumentation; acceptability is computed externally (Principle 12)"
|} .

# Wikidata — Peirce's tetrad (the four InferenceMode values).
gmeow:modeDeduction skos:closeMatch wd:Q484284 {|
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'deductive reasoning' (Q484284) — reasoning from premises understood to be true to a necessarily-true conclusion"
|} .

gmeow:modeInduction skos:closeMatch wd:Q484511 {|
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'inductive reasoning' (Q484511) — reasoning in which a body of observations is synthesised into a general principle"
|} .

gmeow:modeAbduction skos:closeMatch wd:Q308495 {|
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'abductive reasoning' (Q308495) — logical inference seeking the best (most likely) explanation for an observation"
|} .

gmeow:modeAnalogical skos:closeMatch wd:Q185816 {|
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata 'analogy' (Q185816) — inference or argument from one particular to another. GMEOW grounds the transfer in Gentner structure-mapping (gmeow:Analogy / gmeow:systematicity), which the bare concept does not entail"
|} .

# Wikidata — the umbrella concept and the defeasibility machinery.
gmeow:InferenceProcess skos:relatedMatch wd:Q408386 {|
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Wikidata 'inference' (Q408386) — the act or process of deriving logical conclusions from premises; related to the occurrent gmeow:InferenceProcess that carries it out"
|} .

gmeow:Attack skos:relatedMatch wd:Q840067 {|
    gmeow:sssomFile "gmeow-inference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "Wikidata 'defeasible reasoning' (Q840067) — reasoning that is rationally compelling but not deductively valid; gmeow:Attack is the typed structural conflict (undermine/undercut/rebut) that makes inductive/abductive/analogical inference defeasible"
|} .
