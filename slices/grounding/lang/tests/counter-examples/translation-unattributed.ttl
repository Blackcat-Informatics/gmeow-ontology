# Counter-example (ONE violation): a lang:TranslationUnit that declares no
# lang:translationMethod (sh:minCount 1 on lang:TranslationAttributionShape) →
# lang:UnattributedTranslation. Whether a crossing was made by a human, a machine, or a
# compositional rule run is provenance the crossing must carry. Both forms and the single
# carried logic:Correspondence are present and the surfaces are fully-marked UnanalyzedProse
# with a weak (logic:ValidationOnly) judgment, so ONLY the MinCount finding fires; the
# machine-attribution SPARQL branch cannot match (the method is absent, not methodMachine).

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:french a lang:SignSystem .
ex:latin a lang:Script .

ex:src a lang:UnanalyzedProse ; lang:inSignSystem ex:english ;
    lang:surfaceText "the cat" ; lang:inScript ex:latin ;
    lang:unicodeNormalization "NFC" ; lang:collationLocale "en" ;
    lang:analysisLevel lang:rawLevel .
ex:tgt a lang:UnanalyzedProse ; lang:inSignSystem ex:french ;
    lang:surfaceText "le chat" ; lang:inScript ex:latin ;
    lang:unicodeNormalization "NFC" ; lang:collationLocale "fr" ;
    lang:analysisLevel lang:rawLevel .

ex:corr a logic:Correspondence ;
    logic:preservationKind logic:ValidationOnly ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:AffineCorrespondence ;
    logic:hasDeterminacy logic:Vague ;
    logic:mnemomorphic false .

ex:unitNoMethod a lang:TranslationUnit ;
    lang:translationSource ex:src ;
    lang:translationTarget ex:tgt ;
    lang:translationCorrespondence ex:corr .
