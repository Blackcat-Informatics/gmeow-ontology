@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/creative-works>
    a owl:Ontology ;
    rdfs:label "GMEOW Creative Works Module"@x-gmeow-english ;
    skos:definition "The GMEOW Creative Works Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> ;
    rdfs:comment """The WEMI spine for creative and intellectual works — Work, Expression,
Manifestation, Item — reconstructed from native GMEOW primitives (frame-relativity,
reified events, relators, standpoints) and bridged to FRBR/LRMoo/CIDOC/schema.org
by reference (Principle 5), never by axiom import.

DOCTRINE.
  * The four tiers are gufo:Kinds with distinct identity criteria (Work=abstract
    content, Expression=language/notation frame, Manifestation=edition/format,
    Item=single copy); CreativeWork is the gufo:Category umbrella over them.
  * Expression variance is carried by gmeow:hasReferenceFrame (language, script,
    notation, arrangement) — never a subclass taxonomy (Principle 9).
  * Creation is a reified gmeow:Event with an eventType value — no Event subclasses
    (Principle 12).
  * Contribution is a reified gmeow:Relator with flat shortcuts for the 80% case
    (flat-first, reify-on-demand).
  * Format, role, genre, and medium are open value vocabularies (individuals),
    never subclasses (Principle 9).
  * No primary/privileged title or edition (Principle 9); suppressed titles and
    withdrawn standpoints use gmeow:displayable false (Principle 10).
  * Complex lineage (translations-as-versions, collected volumes, withdrawn
    releases) reuses the generic VersionSet / VersionMembership machinery (#161)."""@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# CORE CLASSES — the WEMI spine
# =========================================================================== #
# gmeow:CreativeWork is defined in documents.ttl (the original home) and
# promoted to a gufo:Category by the #208 refactor. It is NOT redeclared here
# to avoid duplicate-definition drift (Principle 4).

gmeow:Work
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:CreativeWork ;
    rdfs:label "Work"@x-gmeow-english ;
    skos:definition "A distinct abstract intellectual or artistic creation, independent of any language, notation, edition, or copy — the story, the composition, the visual conception. The most abstract tier of the WEMI spine; realized through one or more gmeow:Expression. Identity changes when the creative content itself differs."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Expression
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:CreativeWork ;
    rdfs:label "Expression"@x-gmeow-english ;
    skos:definition "A realization of a gmeow:Work in a specific language, script, notation, or arrangement. The original-language text, a translation, and an audiobook narration are distinct Expressions of one Work. The realizing language/notation is carried as a reference frame (gmeow:hasReferenceFrame), not as a subclass. Identity changes when the language, notation, or arrangement differs."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Manifestation
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:CreativeWork ;
    rdfs:label "Manifestation"@x-gmeow-english ;
    skos:definition "A concrete edition, format, or release that embodies a gmeow:Expression — a rights-bearing publication artifact (the 2003 Penguin paperback, the 2011 Kindle EPUB). gmeow:BookRelease, gmeow:SerialInstallment, gmeow:MediaObject, and gmeow:WebPage are specializations. Identity changes when the publication/format/edition differs."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Item
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:CreativeWork ;
    rdfs:label "Item"@x-gmeow-english ;
    skos:definition "A single exemplar of a gmeow:Manifestation — one copy. An InformationObject; a physical copy is linked via gmeow:hasCarrier to a gmeow:PhysicalObject, keeping informational identity distinct from the physical carrier. Library circulation/holdings detail is out of scope for this base (carrier hook only). Identity changes when you hold a different physical or digital copy."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# SPINE RELATIONS — FRBR R-relations, native GMEOW idiom
# =========================================================================== #

gmeow:realizes
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Expression ;
    rdfs:range gmeow:Work ;
    rdfs:label "realizes"@x-gmeow-english ;
    skos:definition "Relates an Expression to the Work it realizes. Non-functional: an omnibus or aggregate Expression may realize multiple Works (e.g. an anthology). Inverse of gmeow:realizedThrough."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:realizedThrough
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:realizes ;
    rdfs:domain gmeow:Work ;
    rdfs:range gmeow:Expression ;
    rdfs:label "realized through"@x-gmeow-english ;
    skos:definition "Relates a Work to an Expression that realizes it. Non-functional: a Work may have many Expressions (translations, arrangements, narrations). Inverse of gmeow:realizes."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:embodies
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Manifestation ;
    rdfs:range gmeow:Expression ;
    rdfs:label "embodies"@x-gmeow-english ;
    skos:definition "Relates a Manifestation to the Expression it embodies. Non-functional: a collected edition may embody multiple Expressions. Inverse of gmeow:embodiedIn."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:embodiedIn
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:embodies ;
    rdfs:domain gmeow:Expression ;
    rdfs:range gmeow:Manifestation ;
    rdfs:label "embodied in"@x-gmeow-english ;
    skos:definition "Relates an Expression to a Manifestation that embodies it. Non-functional: an Expression may be embodied in many Manifestations (hardcover, paperback, EPUB). Inverse of gmeow:embodies."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:exemplifies
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Item ;
    rdfs:range gmeow:Manifestation ;
    rdfs:label "exemplifies"@x-gmeow-english ;
    skos:definition "Relates an Item to the Manifestation it exemplifies. Non-functional: a single Item may exemplify multiple Manifestations when catalogued as a bound volume. Inverse of gmeow:exemplifiedBy."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:exemplifiedBy
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:exemplifies ;
    rdfs:domain gmeow:Manifestation ;
    rdfs:range gmeow:Item ;
    rdfs:label "exemplified by"@x-gmeow-english ;
    skos:definition "Relates a Manifestation to an Item that exemplifies it. Non-functional: a Manifestation may have many Items (copies). Inverse of gmeow:exemplifies."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasCarrier
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Item ;
    rdfs:range gmeow:PhysicalObject ;
    rdfs:label "has carrier"@x-gmeow-english ;
    skos:definition "Relates an Item to the PhysicalObject that carries it — a printed book, a vinyl disc, a sculpture. Optional: a born-digital Item may have no carrier, or its carrier may be a server object modelled as a PhysicalObject. Keeps informational identity (the Item) distinct from physical substrate (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# CONTRIBUTION RELATOR — flat-first, reify-on-demand
# =========================================================================== #

gmeow:Contribution
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Contribution"@x-gmeow-english ;
    skos:definition "A reified relator binding a contributor (Agent), a contribution target (a Work, Expression, Manifestation, or Item), a contribution role, and an optional degree, carrying provenance, period, and confidence. THE universal credit construct; creative authorship, CRediT research roles, and mapping/software authorship are all Contributions. Flat shortcuts (gmeow:hasAuthor, gmeow:hasTranslator, …) cover the 80% query case."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:contributor
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Contribution ;
    rdfs:range gmeow:Agent ;
    rdfs:label "contributor"@x-gmeow-english ;
    skos:definition "The agent that contributed to the target in this Contribution. Functional per relator: one contributor per Contribution."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:contributionTarget
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Contribution ;
    rdfs:range gmeow:CreativeWork ;
    rdfs:label "contribution target"@x-gmeow-english ;
    skos:definition "The creative-work target of this Contribution — a Work, Expression, Manifestation, or Item. Functional per relator: one target per Contribution."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:contributionRole
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Contribution ;
    rdfs:range gmeow:ContributionRole ;
    rdfs:label "contribution role"@x-gmeow-english ;
    skos:definition "The role the contributor played in this Contribution — a value from the open gmeow:ContributionRole vocabulary. Functional per relator: one role per Contribution."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:contributionDegree
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Contribution ;
    rdfs:range gmeow:ContributionDegree ;
    rdfs:label "contribution degree"@x-gmeow-english ;
    skos:definition "The degree or weight of the contribution — lead, equal, or supporting. Optional (≤1 per Contribution). A value from the open gmeow:ContributionDegree vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasContributor
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range gmeow:Agent ;
    rdfs:label "has contributor"@x-gmeow-english ;
    skos:definition "Relates a creative work to an agent that contributed to it — the flat 80%-case shortcut. Non-functional: a work may have many contributors. Promote to a gmeow:Contribution node when the role, period, confidence, or evidence of the contribution must be recorded."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasAuthor
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasContributor ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range gmeow:Agent ;
    rdfs:label "has author"@x-gmeow-english ;
    skos:definition "Relates a creative work to an agent chiefly responsible for creating its intellectual content. A flat shortcut subproperty of gmeow:hasContributor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasTranslator
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasContributor ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range gmeow:Agent ;
    rdfs:label "has translator"@x-gmeow-english ;
    skos:definition "Relates a creative work to an agent that translated it into another language or notation. A flat shortcut subproperty of gmeow:hasContributor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasIllustrator
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasContributor ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range gmeow:Agent ;
    rdfs:label "has illustrator"@x-gmeow-english ;
    skos:definition "Relates a creative work to an agent that contributed visual illustrations. A flat shortcut subproperty of gmeow:hasContributor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasNarrator
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasContributor ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range gmeow:Agent ;
    rdfs:label "has narrator"@x-gmeow-english ;
    skos:definition "Relates a creative work to an agent that narrated or performed an audiobook, podcast, or other spoken-word rendition. A flat shortcut subproperty of gmeow:hasContributor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasEditor
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasContributor ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range gmeow:Agent ;
    rdfs:label "has editor"@x-gmeow-english ;
    skos:definition "Relates a creative work to an agent that edited, compiled, or curated its content. A flat shortcut subproperty of gmeow:hasContributor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# AXIOMATIZED DOCTRINE — relator mediation for Contribution
# =========================================================================== #

gmeow:Contribution rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:contributor ; owl:someValuesFrom gmeow:Agent ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:contributionTarget ; owl:someValuesFrom gmeow:CreativeWork ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:contributionRole ; owl:someValuesFrom gmeow:ContributionRole ] .

# =========================================================================== #
# OPEN VALUE VOCABULARIES — individuals, never subclasses (Principle 9)
# =========================================================================== #

gmeow:CreativeWorkType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Creative Work Type"@x-gmeow-english ;
    skos:definition "The kind of a creative work — a VALUE vocabulary (individuals, never subclasses) characterizing a gmeow:Work. Literary, musical, visual, and software are examples; the set is open."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:ContributionRole
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Contribution Role"@x-gmeow-english ;
    skos:definition "The role an agent played in contributing to a creative work — a VALUE vocabulary (individuals, never subclasses). Author, editor, translator, illustrator, narrator, composer, performer, director, photographer, and cover-artist are examples; the set is open."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:ManifestationFormat
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Manifestation Format"@x-gmeow-english ;
    skos:definition "The physical or digital format of a Manifestation — a VALUE vocabulary (individuals, never subclasses). Hardcover, paperback, EPUB, PDF, audiobook, vinyl, and web-page are examples; the set is open."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasManifestationFormat
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Manifestation ;
    rdfs:range gmeow:ManifestationFormat ;
    rdfs:label "has manifestation format"@x-gmeow-english ;
    skos:definition "The physical or digital format of this manifestation — hardcover, EPUB, audiobook, web serial, etc. A value from the open gmeow:ManifestationFormat vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:CarrierMedium
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Carrier Medium"@x-gmeow-english ;
    skos:definition "The medium of a physical carrier — a VALUE vocabulary (individuals, never subclasses). Print, e-ink file, optical disc, and server object are examples; the set is open."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# CreativeWorkType seeds
# --------------------------------------------------------------------------- #

gmeow:workTypeLiterary        a gmeow:CreativeWorkType ; rdfs:label "literary"@x-gmeow-english ;        skos:definition "A work of literature — fiction, poetry, drama, or literary non-fiction."@x-gmeow-english .
gmeow:workTypeLiterary rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeWritten         a gmeow:CreativeWorkType ; rdfs:label "written"@x-gmeow-english ;         skos:definition "A primarily written work — scholarly, journalistic, or technical."@x-gmeow-english .
gmeow:workTypeWritten rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeNarrative       a gmeow:CreativeWorkType ; rdfs:label "narrative"@x-gmeow-english ;       skos:definition "A work whose primary content is a story or narrative."@x-gmeow-english .
gmeow:workTypeNarrative rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeMusical         a gmeow:CreativeWorkType ; rdfs:label "musical"@x-gmeow-english ;         skos:definition "A work of music — a song, symphony, or composition."@x-gmeow-english .
gmeow:workTypeMusical rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeComposedMusical a gmeow:CreativeWorkType ; rdfs:label "composed musical"@x-gmeow-english ; skos:definition "A notated musical work — a score, sheet music, or composition in written form."@x-gmeow-english .
gmeow:workTypeComposedMusical rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeVisual          a gmeow:CreativeWorkType ; rdfs:label "visual"@x-gmeow-english ;          skos:definition "A visual artwork — a painting, drawing, or digital image."@x-gmeow-english .
gmeow:workTypeVisual rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypePhotographic    a gmeow:CreativeWorkType ; rdfs:label "photographic"@x-gmeow-english ;    skos:definition "A photographic work — a still photograph or photo essay."@x-gmeow-english .
gmeow:workTypePhotographic rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeAudiovisual     a gmeow:CreativeWorkType ; rdfs:label "audiovisual"@x-gmeow-english ;     skos:definition "A work combining moving images and sound — a film, television program, or video."@x-gmeow-english .
gmeow:workTypeAudiovisual rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeFilm            a gmeow:CreativeWorkType ; rdfs:label "film"@x-gmeow-english ;            skos:definition "A cinematic work — a feature film, short film, or documentary."@x-gmeow-english .
gmeow:workTypeFilm rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeChoreographic   a gmeow:CreativeWorkType ; rdfs:label "choreographic"@x-gmeow-english ;  skos:definition "A choreographic work — a dance piece or movement composition."@x-gmeow-english .
gmeow:workTypeChoreographic rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeCartographic    a gmeow:CreativeWorkType ; rdfs:label "cartographic"@x-gmeow-english ;  skos:definition "A cartographic work — a map, atlas, or geospatial representation."@x-gmeow-english .
gmeow:workTypeCartographic rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeSoftware        a gmeow:CreativeWorkType ; rdfs:label "software"@x-gmeow-english ;        skos:definition "A software work — a program, library, or application."@x-gmeow-english .
gmeow:workTypeSoftware rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:workTypeDataset         a gmeow:CreativeWorkType ; rdfs:label "dataset"@x-gmeow-english ;         skos:definition "A dataset work — a structured collection of data published as a unit."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# ContributionRole seeds
# --------------------------------------------------------------------------- #
gmeow:workTypeDataset rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .

gmeow:roleAuthor              a gmeow:ContributionRole ; rdfs:label "author"@x-gmeow-english ;              skos:definition "The creator of the intellectual content of a work."@x-gmeow-english .
gmeow:roleAuthor rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleEditor              a gmeow:ContributionRole ; rdfs:label "editor"@x-gmeow-english ;              skos:definition "An agent who edited, compiled, or curated the content."@x-gmeow-english .
gmeow:roleEditor rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleTranslator          a gmeow:ContributionRole ; rdfs:label "translator"@x-gmeow-english ;          skos:definition "An agent who translated the work into another language or notation."@x-gmeow-english .
gmeow:roleTranslator rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleIllustrator         a gmeow:ContributionRole ; rdfs:label "illustrator"@x-gmeow-english ;         skos:definition "An agent who contributed visual illustrations."@x-gmeow-english .
gmeow:roleIllustrator rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleNarrator            a gmeow:ContributionRole ; rdfs:label "narrator"@x-gmeow-english ;            skos:definition "An agent who narrated or performed a spoken-word rendition."@x-gmeow-english .
gmeow:roleNarrator rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleComposer            a gmeow:ContributionRole ; rdfs:label "composer"@x-gmeow-english ;            skos:definition "An agent who composed the musical content."@x-gmeow-english .
gmeow:roleComposer rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleDirector            a gmeow:ContributionRole ; rdfs:label "director"@x-gmeow-english ;            skos:definition "An agent who directed a film, theatre, or choreographic production."@x-gmeow-english .
gmeow:roleDirector rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:rolePhotographer        a gmeow:ContributionRole ; rdfs:label "photographer"@x-gmeow-english ;        skos:definition "An agent who created photographic content."@x-gmeow-english .
gmeow:rolePhotographer rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleCoverArtist         a gmeow:ContributionRole ; rdfs:label "cover artist"@x-gmeow-english ;        skos:definition "An agent who created cover art for a manifestation."@x-gmeow-english .
gmeow:roleCoverArtist rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleLetterer            a gmeow:ContributionRole ; rdfs:label "letterer"@x-gmeow-english ;            skos:definition "An agent who lettered or calligraphed text in a visual work."@x-gmeow-english .
gmeow:roleLetterer rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleLLMAssistedEditor   a gmeow:ContributionRole ; rdfs:label "LLM-assisted editor"@x-gmeow-english ; skos:definition "An agent who edited with substantial assistance from a large language model."@x-gmeow-english .

# CRediT roles (NISO Z39.104-2022) — bridged by reference, not imported
gmeow:roleLLMAssistedEditor rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleConceptualization     a gmeow:ContributionRole ; rdfs:label "conceptualization"@x-gmeow-english ;     skos:definition "Ideas, formulation or evolution of overarching research goals and aims."@x-gmeow-english .
gmeow:roleConceptualization rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleDataCuration          a gmeow:ContributionRole ; rdfs:label "data curation"@x-gmeow-english ;          skos:definition "Management activities to annotate, scrub data and maintain research data."@x-gmeow-english .
gmeow:roleDataCuration rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleFormalAnalysis        a gmeow:ContributionRole ; rdfs:label "formal analysis"@x-gmeow-english ;        skos:definition "Application of statistical, mathematical, computational, or other formal techniques to analyse or synthesize study data."@x-gmeow-english .
gmeow:roleFormalAnalysis rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleFundingAcquisition    a gmeow:ContributionRole ; rdfs:label "funding acquisition"@x-gmeow-english ;    skos:definition "Acquisition of the financial support for the project leading to this publication."@x-gmeow-english .
gmeow:roleFundingAcquisition rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleInvestigation         a gmeow:ContributionRole ; rdfs:label "investigation"@x-gmeow-english ;         skos:definition "Conducting a research and investigation process, specifically performing the experiments, or data/evidence collection."@x-gmeow-english .
gmeow:roleInvestigation rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleMethodology           a gmeow:ContributionRole ; rdfs:label "methodology"@x-gmeow-english ;           skos:definition "Development or design of methodology; creation of models."@x-gmeow-english .
gmeow:roleMethodology rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleProjectAdministration a gmeow:ContributionRole ; rdfs:label "project administration"@x-gmeow-english ; skos:definition "Management and coordination responsibility for the research activity planning and execution."@x-gmeow-english .
gmeow:roleProjectAdministration rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleResources             a gmeow:ContributionRole ; rdfs:label "resources"@x-gmeow-english ;              skos:definition "Provision of study materials, reagents, materials, patients, laboratory samples, animals, instrumentation, computing resources, or other analysis tools."@x-gmeow-english .
gmeow:roleResources rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleSoftware              a gmeow:ContributionRole ; rdfs:label "software"@x-gmeow-english ;              skos:definition "Programming, software development; designing computer programs; implementation of the computer code and supporting algorithms."@x-gmeow-english .
gmeow:roleSoftware rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleSupervision           a gmeow:ContributionRole ; rdfs:label "supervision"@x-gmeow-english ;            skos:definition "Oversight and leadership responsibility for the research activity planning and execution, including mentorship external to the core team."@x-gmeow-english .
gmeow:roleSupervision rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleValidation            a gmeow:ContributionRole ; rdfs:label "validation"@x-gmeow-english ;             skos:definition "Verification, whether as a part of the activity or separate, of the overall replication/reproducibility of results/experiments and other research outputs."@x-gmeow-english .
gmeow:roleValidation rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleVisualization         a gmeow:ContributionRole ; rdfs:label "visualization"@x-gmeow-english ;          skos:definition "Preparation, creation and/or presentation of the published work, specifically visualization/data presentation."@x-gmeow-english .
gmeow:roleVisualization rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleWritingOriginalDraft  a gmeow:ContributionRole ; rdfs:label "writing – original draft"@x-gmeow-english ;  skos:definition "Creation and/or presentation of the published work, specifically writing the initial draft."@x-gmeow-english .
gmeow:roleWritingOriginalDraft rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleWritingReviewEditing  a gmeow:ContributionRole ; rdfs:label "writing – review & editing"@x-gmeow-english ;  skos:definition "Critical review, commentary or revision – including pre- or post-publication stages."@x-gmeow-english .

# Software-specific contribution roles (open vocabulary seeds)
gmeow:roleWritingReviewEditing rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleSoftwareMaintainer  a gmeow:ContributionRole ; rdfs:label "software maintainer"@x-gmeow-english ;  skos:definition "An agent with ongoing responsibility for a software project — triaging issues, reviewing contributions, and cutting releases."@x-gmeow-english .
gmeow:roleSoftwareMaintainer rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleSoftwareDeveloper   a gmeow:ContributionRole ; rdfs:label "software developer"@x-gmeow-english ;   skos:definition "An agent who writes code, fixes bugs, or implements features in a software project."@x-gmeow-english .
gmeow:roleSoftwareDeveloper rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleCodeReviewer        a gmeow:ContributionRole ; rdfs:label "code reviewer"@x-gmeow-english ;         skos:definition "An agent who reviews code changes for quality, correctness, and policy compliance before merge."@x-gmeow-english .
gmeow:roleCodeReviewer rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleReleaser            a gmeow:ContributionRole ; rdfs:label "releaser"@x-gmeow-english ;             skos:definition "An agent who cuts and publishes software releases."@x-gmeow-english .
gmeow:roleReleaser rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleSecurityContact     a gmeow:ContributionRole ; rdfs:label "security contact"@x-gmeow-english ;     skos:definition "An agent responsible for receiving and handling security vulnerability reports."@x-gmeow-english .
gmeow:roleSecurityContact rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleBotContributor      a gmeow:ContributionRole ; rdfs:label "bot contributor"@x-gmeow-english ;      skos:definition "An automated bot or CI agent that contributes to a project — e.g. dependency updates, formatting bots."@x-gmeow-english .
gmeow:roleBotContributor rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/creative-works> .
gmeow:roleAIAssistant         a gmeow:ContributionRole ; rdfs:label "AI assistant"@x-gmeow-english ;         skos:definition "An AI system that assists in creating or editing software — attributed and confidence-weighted, never ground truth (Principle 9)."@x-gmeow-english .

