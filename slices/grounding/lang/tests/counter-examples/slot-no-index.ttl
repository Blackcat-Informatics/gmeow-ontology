# Counter-example: a composed form whose indexed slots are contiguous (0, 1) but one lang:FormSlot declares no lang:slotIndex at all (fires lang:NonContiguousSlots / shacl.MinCountConstraintComponent).

@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:cf a lang:ComposedForm ; lang:inSignSystem ex:english ; lang:formSlot ex:s0 , ex:s1 , ex:sx .
ex:s0 a lang:FormSlot ; lang:slotIndex 0 ; lang:slotForm ex:w0 .
ex:s1 a lang:FormSlot ; lang:slotIndex 1 ; lang:slotForm ex:w1 .
ex:sx a lang:FormSlot ; lang:slotForm ex:wx .
ex:w0 a lang:WordForm ; lang:inSignSystem ex:english .
ex:w1 a lang:WordForm ; lang:inSignSystem ex:english .
ex:wx a lang:WordForm ; lang:inSignSystem ex:english .
