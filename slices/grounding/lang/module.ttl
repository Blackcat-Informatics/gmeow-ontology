gmeow:gmnGlyphMathMultiplication
    a lang:Grapheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN multiplication glyph"@x-gmeow-english ;
    skos:definition "The NFC × grapheme (U+00D7) in the @μ scope, adopted as the executable GMN sign for binary math:Multiplication."@x-gmeow-english ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+00D7" ;
    gmeow:gmnGlyphTokenCost gmeow:gmnTokenCostOne ;
    gmeow:gmnSigilScope gmeow:gmnSigilMath ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnFormMathMultiplication
    a lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
