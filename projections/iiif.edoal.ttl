@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix iiif: <http://iiif.io/api/presentation/3#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/iiif> a align:Alignment ;
    rdfs:label "GMEOW → iiif (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "MediaObject → iiif:Canvas (with width/height)"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:MediaObject ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri iiif:Canvas ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "ImageRegion → iiif:Annotation (with selector)"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:ImageRegion ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri iiif:Annotation ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "iiif" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@en .
