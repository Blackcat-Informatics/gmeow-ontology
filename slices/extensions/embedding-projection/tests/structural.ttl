#
# Structural assertions for the embedding-projection slice (crates/slicetest): the
# boundary / non-duplication invariants expressed as SPARQL ASK patterns over the
# slice module (and, for the RDF-1.2-only sweep, the module + examples). These
# complement the Rust structural harness (crates/validate/tests/
# conformance_embedding_projection.rs), which additionally checks non-duplication of
# reused terms against the merged ontology and predicate purity.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ep:    <https://blackcatinformatics.ca/gmeow/examples/embedding-projection/tests/> .

# F1 boundary axiom: a similarity observation is NEVER a retrieval event.
ep:saObservationRetrievalDisjoint a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saRationale "gmeow:SimilarityObservation must be logic:disjointWith gmeow:RetrievalEvent (AC2 non-duplication); the boundary axiom is authored in the canonical logic: grounding form (Principle 17)." ;
    gmeow:saPattern """
        PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
        PREFIX logic: <https://blackcatinformatics.ca/logic/>
        ASK { gmeow:SimilarityObservation logic:disjointWith gmeow:RetrievalEvent }
    """ .

# F1 boundary axiom: an EmbeddingProjection AGGREGATES embeddings, it is not a
# subclass of gmeow:Embedding.
ep:saProjectionNotSubclassEmbedding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saRationale "gmeow:EmbeddingProjection must NOT be logic:subClassOf gmeow:Embedding — it aggregates via gmeow:aggregatesEmbedding (AC2); subsumption is authored in the canonical logic: grounding form (Principle 17)." ;
    gmeow:saPattern """
        PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
        PREFIX logic: <https://blackcatinformatics.ca/logic/>
        ASK { gmeow:EmbeddingProjection logic:subClassOf gmeow:Embedding }
    """ .

# CT11: no banned legacy RDF-1.1 container vocabulary in the module or its examples.
ep:saNoLegacyRdfContainers a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModuleAndExamples ;
    gmeow:saRationale "The slice module and its examples must be RDF-1.2-only: no rdf:Bag/rdf:Seq/rdf:Alt/rdf:li and no rdf:_N container-membership predicate (CT11)." ;
    gmeow:saPattern """
        PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
        ASK {
          { ?s a rdf:Bag } UNION { ?s a rdf:Seq } UNION { ?s a rdf:Alt } UNION { ?s rdf:li ?o }
          UNION { ?s ?p ?o . FILTER(STRSTARTS(STR(?p), "http://www.w3.org/1999/02/22-rdf-syntax-ns#_")) }
        }
    """ .

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix wordtest: <https://example.org/natural-language-values/tests/> .

wordtest:saembedding_projectionWords a gmeow:StructuralAssertion ;
    gmeow:saScope gmeow:scopeModule ; gmeow:saPolarity gmeow:must ;
    gmeow:saPattern "PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/> PREFIX logic: <https://blackcatinformatics.ca/logic/> PREFIX lang: <https://blackcatinformatics.ca/lang/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> PREFIX owl: <http://www.w3.org/2002/07/owl#> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> ASK { gmeow:externalRole (logic:range|rdfs:range) rdfs:Literal . gmeow:ExternalBinding (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:externalRole ; (logic:allValuesFrom|owl:allValuesFrom) ?values0_0 ] . ?values0_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:indexLossContract (logic:range|rdfs:range) rdfs:Literal . gmeow:DerivedVectorIndex (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:indexLossContract ; (logic:allValuesFrom|owl:allValuesFrom) ?values1_0 ] . ?values1_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:queryContext (logic:range|rdfs:range) rdfs:Literal . gmeow:SimilarityObservation (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:queryContext ; (logic:allValuesFrom|owl:allValuesFrom) ?values2_0 ] . ?values2_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . }" ;
    gmeow:saRationale "Natural-language fields admit unspecified, language-tagged and directional text through canonical value restrictions, without closing subject domains." .
