# =========================================================================== #
# Meaning-stratum alignments — the Frege triangle, denotation, interpretation.
# Every external IRI is curl-validated (Principle 5): the Wikidata QIDs resolve
# to the named concepts and the OntoLex-Lemon terms resolve in the OntoLex
# ontology. GMEOW meaning terms are the local source of truth; senses,
# denotations, and speech-act structure bottom out in logic:, and OntoLex is the
# lexicon-interchange projection target — closeMatch, never identity.
# =========================================================================== #

# --- lang:Sense → Wikidata word sense + OntoLex LexicalSense ---------------- #

gmeow:eqLangSenseWikidata a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:Sense ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q1570700 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "word sense" ;
    gmeow:comment "lang:Sense is a lexicalized way of meaning; wd:Q1570700 (word sense — one of the meanings of a word) is the same notion at the lexical level. A concept-scoped match, so skos:closeMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqLangSenseOntolex a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:Sense ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ontolex:LexicalSense ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "ontolex:LexicalSense" ;
    gmeow:comment "lang:Sense is what an OntoLex ontolex:LexicalSense approximates — a lexical unit's meaning as a reified sense. GMEOW senses attach through lang:senseOf and bottom out in logic:; OntoLex is the lexicon-interchange projection. closeMatch, not identity." ;
    gmeow:sssomFile "gmeow-ontolex.sssom.tsv" .

gmeow:eqLangLexicalConceptOntolex a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:LexicalConcept ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ontolex:LexicalConcept ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "ontolex:LexicalConcept" ;
    gmeow:comment "lang:LexicalConcept is the synset a set of synonymous senses evoke — the OntoLex ontolex:LexicalConcept peer. closeMatch, not identity." ;
    gmeow:sssomFile "gmeow-ontolex.sssom.tsv" .

gmeow:eqLangEvokesOntolex a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:evokes ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ontolex:evokes ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "ontolex:evokes" ;
    gmeow:comment "lang:evokes relates a sense to the lexical concept it evokes — the OntoLex ontolex:evokes peer. closeMatch." ;
    gmeow:sssomFile "gmeow-ontolex.sssom.tsv" .

# --- lang:Denotation → Wikidata denotation ---------------------------------- #

gmeow:eqLangDenotation a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:Denotation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q1189753 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "denotation" ;
    gmeow:comment "lang:Denotation is the reified record of what a form means; wd:Q1189753 (denotation — the literal meaning of a sign) is the semiotic notion GMEOW reifies. A concept-scoped match, so skos:closeMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

# --- lang:CommunicativeAct / Force → Wikidata speech act / illocution ------- #

gmeow:eqLangCommunicativeAct a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:CommunicativeAct ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q25481968 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "speech act" ;
    gmeow:comment "lang:CommunicativeAct records what a use of a form does; wd:Q25481968 (speech act — an utterance that serves a performative function) is the same notion. A concept-scoped match, so skos:closeMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqLangCommunicativeForce a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:CommunicativeForce ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q1599204 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "illocutionary act" ;
    gmeow:comment "lang:CommunicativeForce is the illocutionary force of a communicative act; wd:Q1599204 (illocutionary act, coined by J. L. Austin) is the same category. A concept-scoped match, so skos:closeMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

# --- lang:IndexicalAnchor → Wikidata deixis (related phenomenon) ------------ #

gmeow:eqLangIndexicalAnchor a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:IndexicalAnchor ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q340015 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "deixis" ;
    gmeow:comment "lang:IndexicalAnchor is the deictic centre an interpretation act resolves indexicals against; wd:Q340015 (deixis) is the phenomenon it anchors. A related notion rather than identity, so skos:relatedMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

# --- lang:CompositionRule → compositionality + Montague grammar ------------- #

gmeow:eqLangCompositionRule a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:CompositionRule ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q936559 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "principle of compositionality" ;
    gmeow:comment "lang:CompositionRule is a rule of the compositional program building a composed denotation from its constituents; wd:Q936559 (principle of compositionality) is the principle it realizes. A concept-scoped match, so skos:closeMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqLangCompositionRuleMontague a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:CompositionRule ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q3272938 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "Montague grammar" ;
    gmeow:comment "The Montagovian program (wd:Q3272938, Montague grammar) is the compositional-semantics framework lang:CompositionRule draws its fragment from. A related framework rather than identity, so skos:relatedMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

# --- lang:presupposes / lang:corefersWith → Wikidata concepts --------------- #

gmeow:eqLangPresupposes a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:presupposes ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q1076131 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "presupposition" ;
    gmeow:comment "lang:presupposes relates a form to the content it presupposes; wd:Q1076131 (presupposition — assumed context surrounding an utterance) is the phenomenon. A related notion (a property vs a concept), so skos:relatedMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqLangCorefersWith a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:corefersWith ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q63087 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "coreference" ;
    gmeow:comment "lang:corefersWith links two referring expressions naming one discourse referent; wd:Q63087 (coreference — when two or more expressions refer to the same thing) is the same relation. A concept-scoped match, so skos:closeMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .
