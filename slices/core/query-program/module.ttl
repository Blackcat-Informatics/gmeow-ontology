    skos:scopeNote "This law permits an empty input with empty output collections. Candidate uniqueness remains a separate occurrence obligation."@x-gmeow-english ;
    skos:example "One retained candidate: ex:union gmeow:queryCandidate ex:c . ex:answer gmeow:queryCandidate ex:c ; gmeow:rerankEntry ex:e . ex:e gmeow:rerankEntryCandidate ex:c ."@x-gmeow-english ;
