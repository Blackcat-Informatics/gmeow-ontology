# =========================================================================== #
# CANONICAL logic:Constraints migrated from music shapes.ttl (issue #1194)
# =========================================================================== #

gmeow:MusicalParameterNoSubclassConstraint
    a logic:Constraint ;
    rdfs:label "Musical parameter no-subclass constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "MusicalParameter is a value vocabulary: no subclasses allowed (Principle 9)."@x-gmeow-english ;
    logic:formalizes gmeow:MusicalParameter ;
    logic:message "MusicalParameter must not be subclassed (Principle 9)." ;
    logic:integrity logic:mpNoSubForall .
logic:mpNoSubForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:mpNoSubImpl .
logic:mpNoSubImpl a logic:Formula ; logic:antecedent logic:mpNoSubTarget ; logic:consequent logic:mpNoSubPhi .
logic:mpNoSubTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
                   [ logic:termIndex 1 ; logic:termLiteral "SELECT ?this WHERE { VALUES ?this { <https://blackcatinformatics.ca/gmeow/MusicalParameter> } }" ] .
logic:mpNoSubPhi a logic:Formula ; logic:not logic:mpNoSubEx .
logic:mpNoSubEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "sub" ] ;
    logic:exists logic:mpNoSubBody .
logic:mpNoSubBody a logic:Formula ; logic:and logic:mpNoSubEdge , logic:mpNoSubDistinct .
logic:mpNoSubEdge a logic:Formula ; logic:relation <http://www.w3.org/2000/01/rdf-schema#subClassOf> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sub" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:mpNoSubDistinct a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sub" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .

gmeow:DeterminationStatusNoSubclassConstraint
    a logic:Constraint ;
    rdfs:label "Determination status no-subclass constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "DeterminationStatus is a value vocabulary: no subclasses allowed (Principle 9)."@x-gmeow-english ;
    logic:formalizes gmeow:DeterminationStatus ;
    logic:message "DeterminationStatus must not be subclassed (Principle 9)." ;
    logic:integrity logic:dsNoSubForall .
logic:dsNoSubForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:dsNoSubImpl .
logic:dsNoSubImpl a logic:Formula ; logic:antecedent logic:dsNoSubTarget ; logic:consequent logic:dsNoSubPhi .
logic:dsNoSubTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
                   [ logic:termIndex 1 ; logic:termLiteral "SELECT ?this WHERE { VALUES ?this { <https://blackcatinformatics.ca/gmeow/DeterminationStatus> } }" ] .
logic:dsNoSubPhi a logic:Formula ; logic:not logic:dsNoSubEx .
logic:dsNoSubEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "sub" ] ;
    logic:exists logic:dsNoSubBody .
