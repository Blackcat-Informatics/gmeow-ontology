    logic:targetEndpoint nif:referenceContext ;
    logic:morphismClass logic:AffineCorrespondence ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly
|} .

lang:SurfaceAnchor skos:closeMatch oa:TextPositionSelector {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-lang-web-annotation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "The selector is an exchange representation of the native anchor; source attachment is modeled at a different node in Web Annotation." ;
    logic:sourceEndpoint lang:SurfaceAnchor ;
    logic:targetEndpoint oa:TextPositionSelector ;
    logic:morphismClass logic:AffineCorrespondence ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly
|} .

lang:anchorStart skos:closeMatch oa:start {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-lang-web-annotation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    logic:sourceEndpoint lang:anchorStart ;
    logic:targetEndpoint oa:start ;
    logic:morphismClass logic:AffineCorrespondence ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly
|} .

lang:anchorEnd skos:closeMatch oa:end {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-lang-web-annotation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    logic:sourceEndpoint lang:anchorEnd ;
    logic:targetEndpoint oa:end ;
    logic:morphismClass logic:AffineCorrespondence ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly
|} .

lang:anchorSource skos:relatedMatch oa:hasSource {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-lang-web-annotation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Web Annotation places hasSource on the SpecificResource rather than directly on the TextPositionSelector, so this is relatedMatch only." ;
    logic:sourceEndpoint lang:anchorSource ;
    logic:targetEndpoint oa:hasSource ;
    logic:morphismClass logic:AffineCorrespondence ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly
|} .
