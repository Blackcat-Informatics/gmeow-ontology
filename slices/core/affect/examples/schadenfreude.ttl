# Worked example: MODEL UP, don't mint. Schadenfreude is not an opaque primitive —
# it is positive core affect whose ELICITOR is another agent's goal-incongruent
# outcome, with an other-directed AGENCY structure and a deservingness/NORM flavour.
# The named composite carries its declared decomposition, plus a derived intensity
# (a view under a named metric, never a stored fact).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/affect/tests/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

ex:observer a gmeow:Person ; rdfs:label "the observer"@en .
ex:rivalSetback rdfs:label "the rival's self-inflicted, deserved setback"@en .

# The declared scale the readings are framed against.
ex:padUnitScale a gmeow:AffectScaleProfile ;
    rdfs:label "PAD unit scale"@en ;
    gmeow:profileRangeMin -1.0 ;
    gmeow:profileRangeMax 1.0 ;
    gmeow:profileMidpoint 0.0 ;
    gmeow:profilePolarity gmeow:polarityBipolar .

# The named composite — a gmeow:Emotion (⊑) that carries its decomposition.
ex:schadenfreude a gmeow:AffectComposite ;
    rdfs:label "the observer's schadenfreude"@en ;
    gmeow:emotionBearer ex:observer ;
    gmeow:emotionType gmeow:emotionSchadenfreude ;
    gmeow:affectiveElicitor ex:rivalSetback ;
    gmeow:affectiveConstituent
        ex:sfCoreVector ,
        ex:sfAgencyCell ,
        ex:sfNormCell .

# The core-affect vector signature: positive valence, moderate arousal.
ex:sfCoreVector a gmeow:AffectVectorObservation ;
    gmeow:vantage ex:observer ;
    gmeow:observedFeature ex:schadenfreude ;
    gmeow:vectorProfile ex:padUnitScale ;
    gmeow:vectorComponent ex:sfValenceCell , ex:sfArousalCell .

ex:sfValenceCell a gmeow:Appraisal ;
    gmeow:vantage ex:observer ;
    gmeow:appraisalOf ex:schadenfreude ;
    gmeow:appraisalDimension gmeow:dimensionValence ;
    gmeow:appraisalValue 0.7 ;
    gmeow:appraisalScaleProfile ex:padUnitScale .

ex:sfArousalCell a gmeow:Appraisal ;
    gmeow:vantage ex:observer ;
    gmeow:appraisalOf ex:schadenfreude ;
    gmeow:appraisalDimension gmeow:dimensionArousal ;
    gmeow:appraisalValue 0.4 ;
    gmeow:appraisalScaleProfile ex:padUnitScale .

# The differentiating appraisal relations: other-directed agency, deserved (norm).
ex:sfAgencyCell a gmeow:Appraisal ;
    gmeow:vantage ex:observer ;
    gmeow:appraisalOf ex:rivalSetback ;
    gmeow:appraisalDimension gmeow:dimensionAgency ;
    gmeow:appraisalValue -1.0 ;
    gmeow:appraisalScaleProfile ex:padUnitScale .

ex:sfNormCell a gmeow:Appraisal ;
    gmeow:vantage ex:observer ;
    gmeow:appraisalOf ex:rivalSetback ;
    gmeow:appraisalDimension gmeow:dimensionNormCompatibility ;
    gmeow:appraisalValue 0.8 ;
    gmeow:appraisalScaleProfile ex:padUnitScale .

# Overall intensity as a DERIVED view under a named non-L² metric — never stored raw.
ex:sfIntensity a gmeow:DerivedAffectIntensityObservation ;
    gmeow:vantage ex:observer ;
    gmeow:observedFeature ex:schadenfreude ;
    gmeow:intensityBasis ex:sfCoreVector ;
    gmeow:metricProfile ex:padUnitScale ;
    gmeow:weightingPolicy "equal-weight core-affect axes" ;
    gmeow:normFunction "weighted metric-tensor norm (non-L2, basis is non-orthogonal)" ;
    gmeow:derivedByFunction gmeow:fnAffectiveIntensity .
