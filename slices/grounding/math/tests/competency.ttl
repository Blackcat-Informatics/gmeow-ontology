# The Hodge-decomposition coverage individual carries its own fully-framed
# cellular sheaf (cov:hodgeSheaf), which the reusable frame query legitimately
# finds alongside cov:cellularSheaf; its row is part of the exact expected set.
ex:rowCoverageHodgeStalk a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sheaf" ; gmeow:cellValueIri cov:hodgeSheaf ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "base" ; gmeow:cellValueIri cov:hodgeComplex ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "stalk" ; gmeow:cellValueIri cov:hodgeStalk ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "restriction" ; gmeow:cellValueIri cov:hodgeRestriction ] .

ex:cqGlobalSectionFrame a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/global-section-frame.rq" ;
    gmeow:cqDataFile "examples/global-section.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A global section exposes its carrier sheaf (math:overSheaf) and the whole base complex it globalises over (math:sectionRegion) as separate reusable data — the H⁰ frame that makes global-versus-local scope inspectable." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqGlobalSectionFrameShape ;
    gmeow:cqExpectRow ex:rowGlobalSectionFrame .

ex:cqGlobalSectionFrameShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "section" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "sheaf" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "region" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowGlobalSectionFrame a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "section" ; gmeow:cellValueIri exgs:global ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sheaf" ; gmeow:cellValueIri exgs:sheaf ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "region" ; gmeow:cellValueIri exgs:base ] .

ex:cqGluingObstructionFrame a gmeow:CompetencyQuestion ;
