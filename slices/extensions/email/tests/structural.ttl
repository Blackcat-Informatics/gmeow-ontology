    FILTER NOT EXISTS { gmeow:displayName rdfs:domain gmeow:EmailAddress }
}""" ;
    gmeow:saRationale """gmeow:displayName MUST be scoped to MessageParticipant and MUST NOT be declared with domain EmailAddress.""" .

