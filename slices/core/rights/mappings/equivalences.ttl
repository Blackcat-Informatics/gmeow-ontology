gmeow:eqRights008 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasDuty ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:obligation ; gmeow:justification semapv:ManualMappingCuration ;
