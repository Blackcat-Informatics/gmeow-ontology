#
# N4 - a receipt with no attempt behind it, asserting an outcome nobody caused. This
# is the shape a fabricated or mis-imported effect record takes.
# MUST trip logic:ReceiptRequiresAttemptConstraint.

@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/logic/tests/> .

ex:receiptNoAttempt a logic:ExternalEffectReceipt ;
    rdfs:label "a receipt reporting on no attempt"@en .
