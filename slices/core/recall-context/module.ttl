    logic:formalizes gmeow:slotPointer ;
    logic:message "A slot pointer names an existing record by IRI. Runtime resolution remains a consumer obligation; an IRI-shape check does not prove availability." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "record" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:slotPointer ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "record" ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termIsIri ; logic:argument [ logic:termIndex 0 ; logic:termVariable "record" ] ] ] ] .

gmeow:RecallEmptyCompleteConstraint
    a logic:Constraint ;
