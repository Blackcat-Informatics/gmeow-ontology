TS { $this <https://blackcatinformatics.ca/logic/and> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/antecedent> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/exists> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/iff> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/not> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/or> ?v6 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/relation> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/logic/iff> ?v4 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/and> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/antecedent> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/exists> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/forall> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/not> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/or> ?v6 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/relation> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/logic/not> ?v5 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/and> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/antecedent> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/exists> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/forall> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/iff> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/or> ?v6 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/relation> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/logic/or> ?v6 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/and> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/antecedent> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/exists> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/forall> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/iff> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/not> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/relation> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/logic/relation> ?v7 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/and> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/antecedent> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/exists> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/forall> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/iff> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/not> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/or> ?v6 . } } } }""" ;
    ] .

<https://blackcatinformatics.ca/logic/FreshnessGuardWindowBoundsConstraintProceduralConstraintShape>
