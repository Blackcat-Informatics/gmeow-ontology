gmeow:budgetEstimatedMillicents
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "estimated budget millicents"@x-gmeow-english ;
    skos:definition "The ledger's estimated cost retained as a math:Quantity counting millicent units. One millicent is exactly 1/100000 of the declared currency's major unit; the original magnitude is xsd:nonNegativeInteger."@x-gmeow-english ;
    skos:scopeNote "Optional and at most one Quantity per coherent BudgetReading cost counter; a supplied zero differs from absence. This is the source's table-based estimate, not a measurement, verified bill, payment or confidence. The fixed unit factor implies no legal minor-unit exponent or performed conversion."@x-gmeow-english ;
    skos:example "A ledger report retains its supplied estimated-cost quantity, declared currency-major-unit basis and actual price-table releases without inventing their values or identities."@x-gmeow-english ;
    gmeow:useWhen "Use when the ledger actually supplies an estimated millicent cost with its declared currency and pricing interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a parallel integer slot, decimal coercion, a default currency or table, inferred cost from request counts, or silently dropping a present cost whose interpretation is incomplete."@x-gmeow-english ;
    gmeow:howToUse "Link the actual Quantity; preserve its original valid finite nonnegative integer magnitude on math:quantityValue, math:dimensionless for the unit count and one actual complete reporting frame. Retain budgetCostCurrency and every budgetCostPriceTable separately with the actual ledger, day, spender and schema context."@x-gmeow-english ;
    logic:domain gmeow:BudgetReading ;
    logic:range math:Quantity .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/budgetEstimatedMillicents" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:budgetCostCurrency
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "budget cost currency basis"@x-gmeow-english ;
    skos:definition "The actual currency ReferenceFrame explicitly declared as the major-unit basis of this BudgetReading's estimated millicent cost."@x-gmeow-english ;
    skos:scopeNote "One coherent supplied cost has one major-unit basis. The frame must be complete, scalar, currency-realm and one-dimensional. A currency code alone establishes neither its denomination nor a legal minor-unit exponent, and this role does not infer MonetaryAmount."@x-gmeow-english ;
    skos:example "A source declares its actual currency-major-unit frame; the report preserves that declaration rather than choosing a currency from a code-shaped label."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the actual explicitly declared major-unit currency basis of a supplied budget estimate."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring USD, a cent frame, currency conversion, frame identity from matching codes or missing axes and other frame components."@x-gmeow-english ;
    gmeow:howToUse "Reference the actual complete ReferenceFrame whose supplied meaning supports the major-unit declaration. Keep its source attribution and original currency metadata; existing Places obligations govern its real axis, determinacy and other components. Do not manufacture a frame to satisfy the role."@x-gmeow-english ;
    logic:domain gmeow:BudgetReading ;
    logic:range gmeow:ReferenceFrame .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/budgetCostCurrency" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:budgetCostPriceTable
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "budget cost price table"@x-gmeow-english ;
    skos:definition "An actual price-table InformationObject release that the ledger declares as a basis for this BudgetReading's estimated cost, with its retained source pricing interpretation."@x-gmeow-english ;
    skos:scopeNote "At least one declared release is required when cost is supplied; all actual releases are retained without a maximum. This source declaration authenticates neither the table nor its actual use, rates, arithmetic or resulting bill."@x-gmeow-english ;
    skos:example "A report cites each actual declared table release and preserves its supplied interpretation without synthesizing a composite table or a missing version."@x-gmeow-english ;
    gmeow:useWhen "Use for the table releases actually declared by the ledger for its estimated-cost reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid selecting a current or cheapest table, inventing a digest or release label, assuming a rate formula, or replacing the actual source table identity with a guessed name."@x-gmeow-english ;
    gmeow:howToUse "Retain each actual source-identified release and the ledger's declared pricing interpretation. Preserve original version, digest and attribution metadata only when supplied. A source cost lacking its actual table context remains an explicitly incomplete interpretation, not a silent omission or default."@x-gmeow-english ;
    logic:domain gmeow:BudgetReading ;
    logic:range gmeow:InformationObject .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/budgetCostPriceTable" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:BudgetReading logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:budgetEstimatedMillicents ; logic:allValuesFrom math:Quantity ] ,
