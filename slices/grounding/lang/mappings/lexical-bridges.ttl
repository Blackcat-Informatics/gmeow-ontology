lang:hypernymy skos:relatedMatch wn:hypernym {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-lang-wordnet-schema.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "The WordNet schema term is a synset-relation kind while lang:hypernymy belongs to the broader native sense-relation inventory." ;
    logic:sourceEndpoint lang:hypernymy ;
    logic:targetEndpoint wn:hypernym ;
    logic:morphismClass logic:AffineCorrespondence ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly
|} .

lang:hyponymy skos:relatedMatch wn:hyponym {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-lang-wordnet-schema.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
