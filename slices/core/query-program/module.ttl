gmeow:QueryRerank
    a logic:SubKind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Rerank"@x-gmeow-english ;
    skos:definition "A query-operation description retaining an original candidate union and an attributed rerank answer under an explicitly selected finite reported score profile. It describes the operation without asserting that an execution occurred."@x-gmeow-english ;
    gmeow:useWhen "Use to describe a rerank stage that accounts for every original candidate and preserves its original union evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the description as a provider invocation, filtering operation or replacement for the original class-ranked lists."@x-gmeow-english ;
    gmeow:howToUse "Supply one rerankInput, one rerankOutput and rerankScoreProfile rerankFiniteFloatProfile, together with the inherited node effect and stratum declarations."@x-gmeow-english ;
    skos:scopeNote "The selected contract retains supplied outcomes and positions. It checks scored-before-unscored grouping and unscored-tail order, without certifying the source’s floating-point sort algorithm."@x-gmeow-english ;
    skos:example "A declared stage: ex:stage a gmeow:QueryRerank ; gmeow:rerankInput ex:union ; gmeow:rerankOutput ex:answer ; gmeow:rerankScoreProfile gmeow:rerankFiniteFloatProfile ."@x-gmeow-english ;
    logic:subClassOf gmeow:QueryProgramNode .

gmeow:QueryRerankAnswer
    a logic:SubKind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Rerank Answer"@x-gmeow-english ;
    skos:definition "An attributed supplied rerank result retaining its original QueryUnionAnswer, exactly one outcome occurrence per original candidate, reported source and output positions, and all original losses with any additional stage losses."@x-gmeow-english ;
    gmeow:useWhen "Use to retain a complete account of the scored and unscored candidates reported by a selected rerank stage."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid discarding unscored candidates, replacing original class ranks with a global rank or inferring completeness from an empty ledger."@x-gmeow-english ;
    gmeow:howToUse "Retain rerankedUnion, the explicit rerankScoreProfile, every rerankEntry and queryCandidate, and the inherited query and loss-ledger coordinates."@x-gmeow-english ;
    skos:scopeNote "A scored entry requires an answer authority matching the score’s own authority record. An all-unscored answer may omit authority, and an empty input admits an empty result collection."@x-gmeow-english ;
    skos:example "A supplied result: ex:answer a gmeow:QueryRerankAnswer ; gmeow:rerankedUnion ex:union ; gmeow:rerankScoreProfile gmeow:rerankFiniteFloatProfile ; gmeow:rerankEntry ex:entry ."@x-gmeow-english ;
    logic:subClassOf gmeow:QueryAnswer .

gmeow:QueryRerankEntry
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Rerank Entry"@x-gmeow-english ;
    skos:definition "One candidate outcome occurrence belonging to exactly one rerank answer. It retains that candidate’s original union position and reported output position, with either a finite score and winning passage or an explicit structured unscored cause."@x-gmeow-english ;
    gmeow:useWhen "Use for an answer-local occurrence that keeps one candidate’s outcome and positions together."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid sharing the occurrence between answers or attaching both a score and an unscored cause to it."@x-gmeow-english ;
    gmeow:howToUse "Supply rerankEntryCandidate, rerankInputPosition and entryOrdinal; link it from its answer and choose exactly one scored or unscored branch."@x-gmeow-english ;
    skos:scopeNote "Positions are nonnegative source-supplied sequence coordinates, not class ranks or global identity. Other answers use separate occurrences even when candidate or score resources are shared."@x-gmeow-english ;
    skos:example "A scored occurrence: ex:entry a gmeow:QueryRerankEntry ; gmeow:rerankEntryCandidate ex:candidate ; gmeow:rerankInputPosition \"3\"^^xsd:nonNegativeInteger ; gmeow:entryOrdinal \"0\"^^xsd:nonNegativeInteger ; gmeow:rerankScore ex:score ; gmeow:rerankWinningPassage \"retained passage\" ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:rerankFiniteFloatProfile
    a logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "finite reported float rerank profile"@x-gmeow-english ;
    skos:definition "The explicit profile value selecting a rerank account whose scored outcomes use the finite reported IEEE 754 single precision QueryRerankScore contract, while preserving every original candidate and explicit unscored outcome."@x-gmeow-english ;
    gmeow:useWhen "Use as the selected rerankScoreProfile value on a rerank operation and its reported answer."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring profile selection from a node name, score presence or provider wording, or silently admitting nonfinite source scores."@x-gmeow-english ;
    gmeow:howToUse "Assert this value explicitly on both QueryRerank and QueryRerankAnswer through rerankScoreProfile."@x-gmeow-english ;
    skos:scopeNote "The profile requires finite score context and full outcome accounting. It supplies no automatic default, provider execution, float-comparator proof or completeness value."@x-gmeow-english ;
    skos:example "An explicit selection: ex:answer gmeow:rerankScoreProfile gmeow:rerankFiniteFloatProfile ."@x-gmeow-english .

gmeow:rerankInput
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "rerank input union"@x-gmeow-english ;
    skos:definition "The original QueryUnionAnswer selected as the declared input of a QueryRerank operation. Its candidate identities, retained class lists and loss records remain source evidence beside the reranked outcomes."@x-gmeow-english ;
    gmeow:useWhen "Use to bind the original union consumed by a declared rerank stage."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting a filtered candidate subset or replacing original class-list occurrences with a newly ranked list."@x-gmeow-english ;
    gmeow:howToUse "Link one original QueryUnionAnswer; require the operation’s output answer to retain that same resource through rerankedUnion."@x-gmeow-english ;
    skos:scopeNote "This operation-input declaration is distinct from the answer’s retained original-input evidence and does not itself assert an execution occurrence."@x-gmeow-english ;
    skos:example "A declared original input: ex:stage gmeow:rerankInput ex:union ."@x-gmeow-english ;
    logic:domain gmeow:QueryRerank ; logic:range gmeow:QueryUnionAnswer .

gmeow:rerankOutput
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "rerank output answer"@x-gmeow-english ;
    skos:definition "The attributed QueryRerankAnswer reported as the output of a QueryRerank operation description. The answer retains the operation’s original input union and its complete candidate outcome account."@x-gmeow-english ;
    gmeow:useWhen "Use to associate a declared rerank stage with its supplied result record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid linking a ranked input list, bare score or filtered candidate set as the full rerank answer."@x-gmeow-english ;
    gmeow:howToUse "Link one QueryRerankAnswer and retain its original union, explicit profile, candidate entries and loss ledger."@x-gmeow-english ;
    skos:scopeNote "The edge supplies no provider invocation, execution time, score authenticity or inferred result status."@x-gmeow-english ;
    skos:example "A supplied output association: ex:stage gmeow:rerankOutput ex:answer ."@x-gmeow-english ;
    logic:domain gmeow:QueryRerank ; logic:range gmeow:QueryRerankAnswer .

gmeow:rerankedUnion
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reranked original union"@x-gmeow-english ;
    skos:definition "The same original QueryUnionAnswer retained by a supplied rerank answer, preserving access to its class-list resources, original class entry occurrences, candidate identities and losses."@x-gmeow-english ;
    gmeow:useWhen "Use to retain original union evidence directly on a rerank result, including a standalone supplied answer."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid copying original entries into a global ranking or treating source union sequence order as merit."@x-gmeow-english ;
    gmeow:howToUse "Link the original union resource and preserve all of its candidates and loss identities in the result account."@x-gmeow-english ;
    skos:scopeNote "When the answer is a QueryRerank output, this resource must equal the operation’s rerankInput. Original ranks and tie keys remain on their original class-list entries."@x-gmeow-english ;
    skos:example "A retained original resource: ex:answer gmeow:rerankedUnion ex:union ."@x-gmeow-english ;
    logic:domain gmeow:QueryRerankAnswer ; logic:range gmeow:QueryUnionAnswer .

gmeow:rerankEntry
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "rerank result entry"@x-gmeow-english ;
    skos:definition "One answer-local candidate outcome occurrence retained by a QueryRerankAnswer. The collection contains exactly one entry per original union candidate, including candidates that were not scored."@x-gmeow-english ;
    gmeow:useWhen "Use to expose all reported candidate outcomes and their source and output positions."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid omitting failed or unscored rows, repeating a candidate within one answer or sharing one occurrence between answer sequences."@x-gmeow-english ;
    gmeow:howToUse "Link each QueryRerankEntry from its single owning answer and retain its candidate, positions and selected outcome branch."@x-gmeow-english ;
    skos:scopeNote "An empty input union permits no entries. Entry collection membership itself imposes no contiguous indices or floating-point score sort."@x-gmeow-english ;
    skos:example "Two retained outcomes: ex:answer gmeow:rerankEntry ex:scoredEntry, ex:unscoredEntry ."@x-gmeow-english ;
    logic:domain gmeow:QueryRerankAnswer ; logic:range gmeow:QueryRerankEntry .

gmeow:rerankEntryCandidate
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "rerank entry candidate"@x-gmeow-english ;
    skos:definition "The exact original union candidate identity named by one rerank entry. Every input candidate has one such occurrence, and no entry names a candidate outside the retained original union."@x-gmeow-english ;
    gmeow:useWhen "Use to join a reported outcome to the original candidate without deriving identity from its passage or numeric score."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting replacement candidates, identifying candidates by output position or interpreting membership as truth or confidence."@x-gmeow-english ;
    gmeow:howToUse "Reference one original candidate resource on the entry and preserve the same identity in input and output queryCandidate membership."@x-gmeow-english ;
    skos:scopeNote "The candidate may occur in several original class lists or separate rerank answers; only the outcome occurrence is local to one answer."@x-gmeow-english ;
    skos:example "A retained candidate identity: ex:entry gmeow:rerankEntryCandidate ex:candidate ."@x-gmeow-english ;
    logic:domain gmeow:QueryRerankEntry ; logic:range logic:Thing .

gmeow:rerankInputPosition
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "rerank original union position"@x-gmeow-english ;
    skos:definition "The supplied zero-based position of an entry’s candidate in the original union sequence. It preserves source sequence evidence independently of the entry’s reported output entryOrdinal."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the original union order needed to account for the unscored tail."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this coordinate as class rank, merit, global candidate identity or a reason to renumber retained rows."@x-gmeow-english ;
    gmeow:howToUse "Retain one xsd:nonNegativeInteger on each entry and keep input positions unique within its owning answer."@x-gmeow-english ;
    skos:scopeNote "No contiguous sequence or declared source count is inferred. Canonical order checks preserve this relative order among unscored entries only."@x-gmeow-english ;
    skos:example "A supplied original position: ex:entry gmeow:rerankInputPosition \"7\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    logic:domain gmeow:QueryRerankEntry ; logic:range xsd:nonNegativeInteger .

gmeow:rerankScore
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "rerank entry score"@x-gmeow-english ;
    skos:definition "The supplied finite QueryRerankScore of a scored candidate occurrence. This branch requires a retained winning passage and excludes a simultaneous structured unscored cause."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the reported quantitative outcome without moving its magnitude into an entry-local numeric property."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid replacing a nonfinite source score, treating the score as probability or using score presence to infer a successful provider execution."@x-gmeow-english ;
    gmeow:howToUse "Link one existing QueryRerankScore, retain rerankWinningPassage, and match that score’s rerankScoreAuthority to the answer’s actual authority record."@x-gmeow-english ;
    skos:scopeNote "The existing score contract owns magnitude, dimension, frame and authority context. The stage adds no duplicate finite-value law or floating-point sorting mechanism."@x-gmeow-english ;
    skos:example "A scored branch: ex:entry gmeow:rerankScore ex:score ; gmeow:rerankWinningPassage \"retained passage\" ."@x-gmeow-english ;
    logic:domain gmeow:QueryRerankEntry ; logic:range gmeow:QueryRerankScore .

gmeow:rerankWinningPassage
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "rerank winning passage"@x-gmeow-english ;
    skos:definition "The source-supplied best-scoring passage text retained beside a candidate’s reported rerank score. It is an xsd:string literal and is present exactly on the scored outcome branch."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve which supplied passage accompanied a candidate’s reported score."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a passage for an unscored candidate, declaring a language from plain text or treating retention as display authorization."@x-gmeow-english ;
    gmeow:howToUse "Copy the supplied passage into one xsd:string literal on the scored entry and retain its score separately through rerankScore."@x-gmeow-english ;
    skos:scopeNote "The carrier preserves text without re-running passage selection or proving that the provider evaluated every possible passage."@x-gmeow-english ;
    skos:example "A supplied winning passage: ex:entry gmeow:rerankWinningPassage \"A retained source passage.\" ."@x-gmeow-english ;
    logic:domain gmeow:QueryRerankEntry ; logic:range xsd:string ; logic:subPropertyOf lang:literalValue .

gmeow:rerankUnscoredDetail
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "rerank unscored detail"@x-gmeow-english ;
    skos:definition "The explicit source-reported structured cause of a candidate’s unscored outcome. It retains native structured values and record fields, excluding a simultaneous score or winning passage."@x-gmeow-english ;
    gmeow:useWhen "Use to account for a retained candidate that the source did not score."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid converting a supplied numeric score into this branch after profile rejection, stringifying structured causes or identifying every detail with an aggregate QueryLoss."@x-gmeow-english ;
    gmeow:howToUse "Link one actual StructuredValue and retain its source record tag, labelled fields and nested native values through the existing structured-value vocabulary."@x-gmeow-english ;
    skos:scopeNote "Actual loss records remain in the answer’s loss ledger. A typed unscored cause does not prove the candidate false, and its answer cannot report CompleteForFragment."@x-gmeow-english ;
    skos:example "An explicit unscored branch: ex:entry gmeow:rerankUnscoredDetail ex:detail ."@x-gmeow-english ;
    logic:domain gmeow:QueryRerankEntry ; logic:range gmeow:StructuredValue .

gmeow:rerankAuthority
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "rerank answer authority"@x-gmeow-english ;
    skos:definition "The supplied source scoring authority retained by a rerank answer. It is required whenever any entry is scored and must be the same authority record referenced by each retained score."@x-gmeow-english ;
    gmeow:useWhen "Use to retain answer-level source scoring identity and context alongside every candidate outcome."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring authority from score-kind wording, merging records from equal opaque bytes or requiring an invented authority for an all-unscored result."@x-gmeow-english ;
    gmeow:howToUse "Retain at most one supplied QueryRerankAuthority on the answer and bind every scored quantity to that actual record through rerankScoreAuthority."@x-gmeow-english ;
    skos:scopeNote "A supplied authority is legal even when all candidates are unscored. Its presence alone proves neither scoring success nor provider invocation."@x-gmeow-english ;
    skos:example "A supplied answer authority: ex:answer gmeow:rerankAuthority ex:authority ."@x-gmeow-english ;
    logic:domain gmeow:QueryRerankAnswer ; logic:range gmeow:QueryRerankAuthority .

gmeow:rerankScoreProfile
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "rerank score profile"@x-gmeow-english ;
    skos:definition "The explicit selected profile of a rerank operation description or attributed result. This stage contract requires the sole admitted value rerankFiniteFloatProfile on each."@x-gmeow-english ;
    gmeow:useWhen "Use to make finite reported score and full outcome-accounting obligations explicit on both operation and answer."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid silently defaulting the profile, selecting it from provider wording or treating a missing selection as a weaker supported result."@x-gmeow-english ;
    gmeow:howToUse "Assert exactly one rerankScoreProfile value on the QueryRerank node and its QueryRerankAnswer, choosing rerankFiniteFloatProfile."@x-gmeow-english ;
    skos:scopeNote "The selected value fixes mandatory evidence obligations without asserting native execution, score comparator equivalence or completeness."@x-gmeow-english ;
    skos:example "Explicit operation and result selection: ex:stage gmeow:rerankScoreProfile gmeow:rerankFiniteFloatProfile . ex:answer gmeow:rerankScoreProfile gmeow:rerankFiniteFloatProfile ."@x-gmeow-english ;
    logic:domain [ a logic:Class ; logic:unionOf ( gmeow:QueryRerank gmeow:QueryRerankAnswer ) ] ; logic:range logic:QualityValue .

gmeow:QueryRerankInputAgreementLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank input agreement law"@x-gmeow-english ;
    skos:definition "The answer named as a QueryRerank output retains the same original union resource that the operation declares through rerankInput. Reported original evidence cannot silently substitute another input."@x-gmeow-english ;
    gmeow:useWhen "Use to check agreement between a declared operation input and its result’s retained original union."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid matching inputs by candidate count, display label or equal scores rather than the actual union resource."@x-gmeow-english ;
    gmeow:howToUse "Bind the typed operation, rerankInput and rerankOutput, then require rerankedUnion from that answer to the bound input."@x-gmeow-english ;
    skos:scopeNote "Required single-valued input and original-union paths make conflicting source associations invalid without creating execution evidence."@x-gmeow-english ;
    skos:example "Matching original evidence: ex:stage gmeow:rerankInput ex:union ; gmeow:rerankOutput ex:answer . ex:answer gmeow:rerankedUnion ex:union ."@x-gmeow-english ;
    logic:formalizes gmeow:rerankInput ;
    logic:message "The answer named as a QueryRerank output retains the same original union resource that the operation declares through rerankInput. Reported original evidence cannot silently substitute another input." ;
