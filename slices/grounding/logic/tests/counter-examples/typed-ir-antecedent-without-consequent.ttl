@prefix ex: <https://blackcatinformatics.ca/gmeow/examples/logic/tests/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .

# The implication constructor is selected by antecedent, but its ordered second operand is absent.
ex:missingConsequent
    a logic:Formula ;
    logic:antecedent ex:validAntecedent .

ex:validAntecedent
    a logic:Formula ;
    logic:relation ex:predicate .
