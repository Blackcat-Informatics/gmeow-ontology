# =========================================================================== #
# Measure, integration, and dimension alignments
#
# Measure-theory and integration concepts anchor to Wikidata (the identity hub —
# CC0). The quantity/unit/dimension grounding aligns to QUDT (CC-BY-4.0) for units,
# quantity kinds, and dimension vectors, to the BIPM SI Digital Framework (D-SI PIDs,
# CC-BY-3.0-IGO — the authoritative SI anchor, cited not re-minted), and to OM 2
# (CC-BY-4.0 — align, don't spine). QUDT/D-SI/OM 2 objects are authored as full IRIs
# by reference (the OEIS precedent): the alignment is a skos:*Match that copies no
# axiom, so it is license-safe and needs no prefix registration. Every object IRI is
# curl-validated: the Wikidata QIDs by label, the QUDT/D-SI IRIs by HTTP 200, and the
# OM 2 entities by their resolvable /page/ view (the canonical /resource/ IRI is the
# RDF identity the OM 2 server does not content-negotiate).
# =========================================================================== #

# --- Measure and integration → Wikidata (identity) ------------------------- #

gmeow:eqMathMeasure a gmeow:TermEquivalence ;
    gmeow:alignSubject math:Measure ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q192276 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "measure" ;
    gmeow:comment "math:Measure is the measure-theory measure — a countably-additive assignment of non-negative extended-real mass; wd:Q192276 (measure) is the same concept, a generalization of length, area, volume, and integral. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqMathMeasurableSpace a gmeow:TermEquivalence ;
    gmeow:alignSubject math:MeasurableSpace ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q3058218 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "measurable space" ;
    gmeow:comment "math:MeasurableSpace is a set with a σ-algebra; wd:Q3058218 (measurable space) is the same pairing on which a measure can be defined. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

