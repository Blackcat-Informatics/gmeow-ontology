      <termEntry id="c-1f042790a8638901">
        <langSet xml:lang="en">
          <tig>
            <term>provenance-honesty floor — Exemplified</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>plancher d'honnêteté de provenance — Exemplifié</term>
