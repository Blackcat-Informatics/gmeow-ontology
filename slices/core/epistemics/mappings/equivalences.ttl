@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix iao:    <http://purl.obolibrary.org/obo/IAO_> .
@prefix sumo:   <https://www.ontologyportal.org/SUMO.owl#> .
@prefix wd:     <http://www.wikidata.org/entity/> .
@prefix cito: <http://purl.org/spar/cito/> .

# Term equivalences for the epistemics slice — GMEOW authoring source.
# Compiled to mappings/gmeow-epistemics.sssom.tsv by `gmeow compile-mappings`.
# All alignments are BY REFERENCE (Principle 5); GMEOW never imports an external axiom.
# Wikidata QIDs verified by entity page 2026-06-17: Q108163 (proposition) retained;
# Q446151 and Q9081 from the issue did not match the intended concepts and are dropped.

gmeow:mapsetEpistemics a gmeow:MappingSet ;
    rdfs:label "epistemics mapping set"@x-gmeow-english ;
    skos:definition "The SSSOM mapping set for the epistemics slice — aligns propositional attitudes, doxastic states, and the lightweight justification hook to external upper ontologies and concept schemes."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    gmeow:sssomFile "gmeow-epistemics.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/epistemics" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Epistemics slice alignments (Principle 5 — by reference only).
        AXIOMATIC GROUNDING: gmeow:DoxasticState is a gufo:Kind subclass of gmeow:MentalMoment,
        and gmeow:MentalMoment is itself a named gufo:Category under gufo:IntrinsicMode (kernel slice);
        this grounding is documented in the set comment rather than asserted as a mapping row.
        CRMinf: gmeow:DoxasticState aligns to I2_Belief; gmeow:Proposition to I4_Proposition_Set;
        gmeow:basesBeliefOn (the basing edge of the five-way justification split) aligns to crminf:J2_concluded_that.
        I5_Inference_Making is referenced in prose only as the related CRMinf inference-making act;
        SUMO: gmeow:believes and gmeow:knowsThat are related by reference to SUMO believes / knows,
        with an explicit note that GMEOW knowsThat is NON-FACTIVE.
        Wikidata: gmeow:Proposition → Q108163 (proposition). Q446151 and Q9081 from the issue did not
        match the intended concepts on entity-page inspection and are left unaligned.
        IAO: gmeow:Proposition is a relatedMatch to IAO information content entity (IAO_0000030).
        ATOMIC belief edges and AIF S-/RA-nodes are referenced in prose only; no stable, resolvable
        RDF namespace suitable for SSSOM rows is available.
        gmeow:claimModality is already aligned to crminf:J5_holds_to_be in the standpoint slice and is
        not duplicated here. gmeow:credence and gmeow:accepts have no canonical RDF vocabulary and are
        left unaligned. Epistemic-modal operators (KK/S4/S5/KD45) belong to the logic: slice profiles.""" .

# Axiomatic grounding — DoxasticState is already gufo:IntrinsicMode via MentalMoment.
# Documented in the set comment; no mapping row needed.

# CRMinf — DoxasticState as a (temporal) belief held by an agent.
gmeow:DoxasticState skos:closeMatch crminf:I2_Belief {|
    gmeow:sssomFile "gmeow-epistemics.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "gmeow:DoxasticState is an endurant mental moment (gufo:IntrinsicMode); crminf:I2_Belief is a temporal entity — close but not co-extensional"
|} .

# CRMinf — Proposition as a proposition set / the content of a belief.
gmeow:Proposition skos:relatedMatch crminf:I4_Proposition_Set {|
    gmeow:sssomFile "gmeow-epistemics.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "gmeow:Proposition is a single truth-apt content; crminf:I4_Proposition_Set is a set of such contents"
|} .

# IAO — Proposition as information content entity.
gmeow:Proposition skos:relatedMatch iao:0000030 {|
    gmeow:sssomFile "gmeow-epistemics.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "gmeow:Proposition is a socially-constructed, truth-apt content; IAO_0000030 is the broader information content entity class"
|} .

# Wikidata — Proposition.
gmeow:Proposition skos:relatedMatch wd:Q108163 {|
    gmeow:sssomFile "gmeow-epistemics.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata Q108163 'proposition' — entity-page verified 2026-06-17"
|} .

# SUMO / Wikidata — believes.
gmeow:believes skos:relatedMatch sumo:believes {|
    gmeow:sssomFile "gmeow-epistemics.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "SUMO believes is conceptually adjacent; GMEOW believes is non-factive, standpoint-indexed, and open-range. ATOMIC belief edges are referenced in prose only (no stable RDF namespace)"
|} .

# SUMO / Wikidata — knowsThat (non-factive).
gmeow:knowsThat skos:relatedMatch sumo:knows {|
    gmeow:sssomFile "gmeow-epistemics.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.4 ;
    gmeow:comment "SUMO knows is typically factive; GMEOW knowsThat is explicitly non-factive — relatedMatch only. Wikidata Q9081 from the issue did not resolve to a relevant concept and is dropped"
|} .

# CRMinf — basesBeliefOn as the inverse-side conclusion hook of an inference-making act.
gmeow:basesBeliefOn skos:relatedMatch crminf:J2_concluded_that {|
    gmeow:sssomFile "gmeow-epistemics.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "J2_concluded_that relates an inference-making act to the belief it concludes; gmeow:basesBeliefOn (the ground a belief is actually founded on) inverts the direction of support"
|} .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:ClaimEvaluation skos:closeMatch crminf:I5_Inference_Making {|
    gmeow:sssomFile "gmeow-claims.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "crminf:I5_Inference_Making is the activity of concluding a new belief from existing ones; a gmeow:ClaimEvaluation assesses a target claim token and expresses its verdict — the same inference-making act, broadened to any standpoint-indexed assessment"
|} .

gmeow:supportsClaim skos:relatedMatch cito:supports {|
    gmeow:sssomFile "gmeow-claims.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "cito:supports is a work-to-work citation intent; gmeow:supportsClaim is a claim-to-claim-token argumentation edge — same support epistemics, different carrier"
|} .

gmeow:attacksClaim skos:relatedMatch cito:disputes {|
    gmeow:sssomFile "gmeow-claims.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "cito:disputes at the claim-to-claim-token level: gmeow:attacksClaim is the attack pole of the bipolar argumentation over claim tokens"
|} .
