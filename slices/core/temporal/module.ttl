gmeow:datingMethodRadiocarbon skos:definition "The radiocarbon dating method — a scientific technique used to estimate the age of an object, stratum, or event."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> .
gmeow:datingMethodDendrochronology                   a gmeow:DatingMethod ; rdfs:label "dendrochronology"@x-gmeow-english .
gmeow:datingMethodDendrochronology skos:definition "The dendrochronology dating method — a scientific technique used to estimate the age of an object, stratum, or event."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> .
gmeow:datingMethodThermoluminescence                 a gmeow:DatingMethod ; rdfs:label "thermoluminescence"@x-gmeow-english .
gmeow:datingMethodThermoluminescence skos:definition "The thermoluminescence dating method — a scientific technique used to estimate the age of an object, stratum, or event."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> .
