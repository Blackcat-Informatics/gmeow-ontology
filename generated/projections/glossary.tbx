      <termEntry id="c-e9bef4e80a6f1207">
        <langSet xml:lang="en">
          <tig>
            <term>left generator</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>générateur gauche</term>
