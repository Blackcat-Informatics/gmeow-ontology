@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ontouml: <https://w3id.org/ontouml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .

# The logic stereotype meta-classes and their OntoUML stereotype counterparts form
# invertible class-renaming correspondences. The OntoUML vocabulary is referenced,
# never vendored; the native correspondence frontend derives the law and preservation
# claims, while the same authored cells lower to SSSOM exact-match rows.

gmeow:eqOntoUml001 a gmeow:ProjectionMapping, logic:GroundingCorrespondence ;
    rdfs:label "logic:Kind = ontouml:kind"@x-gmeow-english ;
    gmeow:justification semapv:ManualMappingCuration ; gmeow:objectLabel "kind" ;
    gmeow:comment "The OntoUML «kind» stereotype: a rigid, identity-providing sortal — the counterpart of logic:Kind." ;
    logic:sourceEndpoint logic:Kind ; logic:targetEndpoint ontouml:kind ;
    logic:morphismClass logic:WellBehavedLens ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:SoundUnderApproximation ;
    gmeow:hasMappingPattern [ gmeow:anchor "x" ; gmeow:atom ( [ gmeow:subjectVar "x" ; gmeow:predicate rdf:type ; gmeow:objectValue logic:Kind ] ) ; gmeow:edoalSource logic:Kind ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [ gmeow:profile "ontouml" ; gmeow:toClass ontouml:kind ; gmeow:relation "=" ; gmeow:confidence 1.0 ; gmeow:mnemomorphic true ; gmeow:emitSssom true ; gmeow:sssomPredicate skos:exactMatch ; gmeow:sssomFile "gmeow-ontouml.sssom.tsv" ] .

