    skos:example "Retain this source meaning: ex:record gmeow:cellRow 0 ."@x-gmeow-english .

gmeow:cellColumn
    a logic:DatatypeProperty ;
    logic:domain gmeow:TableCell ;
    logic:range xsd:integer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "source cell column"@x-gmeow-english ;
    skos:definition "The source column index of a documentary cell under its table's explicit tableIndexOrigin. Identical indices in distinct tables do not identify the same cell."@x-gmeow-english ;
