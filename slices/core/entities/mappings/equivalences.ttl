@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gedcom: <http://www.w3.org/2000/10/swap/pim/gedcom#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema: <https://schema.org/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:Person owl:equivalentClass schema:Person {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "person"
|} .

gmeow:Person owl:equivalentClass foaf:Person {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "person"
|} .

gmeow:Person owl:equivalentClass gedcom:Individual {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "genealogical individual is a person"
|} .

gmeow:Organization owl:equivalentClass schema:Organization {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:Organization owl:equivalentClass foaf:Organization {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

org:FormalOrganization rdfs:subClassOf gmeow:Organization {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "formal org is an organization"
|} .

gmeow:Group owl:equivalentClass foaf:Group {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:description skos:closeMatch dcterms:description {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:name owl:equivalentProperty schema:name {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:name owl:equivalentProperty foaf:name {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:name skos:closeMatch vcard:fn {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:description owl:equivalentProperty schema:description {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:description skos:closeMatch dcterms:description {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:description skos:closeMatch vcard:note {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

gmeow:hasWebPage skos:closeMatch schema:url {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

gmeow:hasWebPage skos:closeMatch foaf:homepage {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

gmeow:Person skos:exactMatch wd:Q5 {|
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:objectLabel "human"
|} .

gmeow:Organization skos:exactMatch wd:Q43229 {|
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "organization"
|} .

gmeow:Group skos:closeMatch wd:Q874405 {|
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:objectLabel "social group" ;
    gmeow:comment "Wikidata 'social group' is broader than GMEOW Group (which includes non-social collectives). Directional lossy projection."
|} .
