        gmeow:lossyDrop "the article's title doubles as its headline (schema.org's article idiom)" ] .

gmeow:mapSchemaSubjectOf a gmeow:ProjectionMapping ;
    rdfs:label "isAbout inverse → schema:subjectOf"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "subjWork" ; gmeow:value "subjTopic" ;
        gmeow:atom ( [ gmeow:subjectVar "subjWork" ; gmeow:predicate gmeow:isAbout ; gmeow:objectVar "subjTopic" ] ) ;
        gmeow:edoalSource gmeow:isAbout ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:subjectOf ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the inverse reading: the topic gains subjectOf pointing back at the work" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "subjTopic" ; gmeow:tPred schema:subjectOf ; gmeow:tObj "subjWork" ] ) ] .

gmeow:mapSchemaAffiliation a gmeow:ProjectionMapping ;
    rdfs:label "Person memberOf → schema:affiliation"@x-gmeow-english ;
    gmeow:hasMappingPattern [
