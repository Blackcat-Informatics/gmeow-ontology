    logic:formalizes gmeow:CurationEpoch ;
    logic:message "The externally described successor ledger wasGeneratedBy the historical epoch and wasDerivedFrom its named predecessor. Documentary evidence itself does not generate the earlier historical act." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "predecessor" ], [ logic:termIndex 2 ; logic:termVariable "successor" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:CurationEpoch ] ],
                [ a logic:Formula ; logic:relation gmeow:epochPredecessor ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "predecessor" ] ],
                [ a logic:Formula ; logic:relation gmeow:epochSuccessor ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "successor" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation gmeow:wasGeneratedBy ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "successor" ],
                        [ logic:termIndex 1 ; logic:termVariable "this" ] ],
                [ a logic:Formula ; logic:relation gmeow:wasDerivedFrom ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "successor" ],
                        [ logic:termIndex 1 ; logic:termVariable "predecessor" ] ] ] ] ] .

