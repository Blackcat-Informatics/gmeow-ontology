#
# Worked example: a slice-quality report IS a bundle of quality observations.
# Each per-axis grade is a gmeow:QualityAssessment (a gmeow:Observation subclass)
# whose assessedEntity is the target slice, whose assessmentAxis is the rubric axis
# it measured, whose qualityDimension is that axis's emitted dimension, and whose
# observationResult is a math:Quantity grade —
# the same measurement bundle (method, vantage, dimensioned result) as any other
# GMEOW observation, never a bare number. This scene includes the epistemically
# hard case: the translation-coverage grade is genuinely CONTESTED (a bare parallel
# French literal exists but carries no audited translation record), carried honestly
# as a low grade rather than smoothed over.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/slice-quality-rubric/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# --- The target under assessment: an example slice being scored. ---------------
ex:targetSlice a gmeow:Dataset ;
    gmeow:title "Example domain slice under a slice-quality pass"@x-gmeow-english .

ex:advisor a gmeow:Organization ;
    gmeow:name "The gmeow-dev slice-quality advisor"@x-gmeow-english .

# --- A per-axis grade: grounding measured Maximal as a normalized ratio. --------
ex:groundingGrade a gmeow:QualityAssessment ;
    gmeow:assessedEntity    ex:targetSlice ;
    gmeow:assessmentAxis    gmeow:axisMaximalGrounding ;
    gmeow:qualityDimension  gmeow:qualityDimensionGrounding ;
    gmeow:observationMethod gmeow:methodComputationalModel ;
    gmeow:vantage           ex:advisor ;
    gmeow:observationResult ex:groundingScore .

ex:groundingScore a math:Quantity ;
    math:hasDimension math:dimensionless ;
    math:quantityValue "0.97"^^xsd:decimal .

# --- The epistemically hard case: translation coverage is CONTESTED and low. ----
# A bare parallel French literal exists but carries no audited translation record,
# so the slice's French "coverage" is genuinely contested — the report records the
# honest low grade rather than pretending completeness.
ex:translationGrade a gmeow:QualityAssessment ;
    gmeow:assessedEntity    ex:targetSlice ;
    gmeow:assessmentAxis    gmeow:axisTranslationCoverage ;
    gmeow:qualityDimension  gmeow:qualityDimensionTranslationCoverage ;
    gmeow:observationMethod gmeow:methodComputationalModel ;
    gmeow:vantage           ex:advisor ;
    gmeow:observationResult ex:translationScore .

ex:translationScore a math:Quantity ;
    math:hasDimension math:dimensionless ;
    math:quantityValue "0.42"^^xsd:decimal .

# --- The roll-up: the unweighted lattice meet, which names NO single axis. ------
# It spans every axis, so it carries neither gmeow:assessmentAxis nor
# gmeow:qualityDimension; its grade is the least of the per-axis grades above.
ex:rollupGrade a gmeow:QualityAssessment ;
    gmeow:assessedEntity    ex:targetSlice ;
    gmeow:observationMethod gmeow:methodComputationalModel ;
    gmeow:vantage           ex:advisor ;
    gmeow:observationResult ex:rollupScore .

ex:rollupScore a math:Quantity ;
    math:hasDimension math:dimensionless ;
    math:quantityValue "0.42"^^xsd:decimal .

# --- The record schema the three grades above instantiate. ---------------------
# gmeow:assessmentAxis is a DESCRIPTOR of the grade record, not a presentation
# detail: a reader who has only the record must still recover which axis produced
# the score. gmeow:qualityDimension is listed beside it and cannot replace it —
# sixteen axes publish under twelve dimensions, so the dimension does not
# determine the axis. The roll-up above conforms to the same profile with the two
# axis-keyed descriptors absent, which is why neither is required.
ex:profilePerAxisGradeRecord a gmeow:Profile ;
    rdfs:label "Per-axis slice-quality grade record"@x-gmeow-english ;
    skos:definition "The closed descriptor schema of one slice-quality grade record: the entity graded, the rubric axis measured, the ISO dimension that axis publishes under, and the dimensioned result. A roll-up grade instantiates the same schema with the axis and dimension descriptors absent, because the lattice meet spans every axis and names none."@x-gmeow-english ;
    gmeow:profileAppliesTo   gmeow:QualityAssessment ;
    gmeow:profileDescriptor  gmeow:assessedEntity , gmeow:assessmentAxis ,
                             gmeow:qualityDimension , gmeow:observationResult ;
    gmeow:profileOpenValue   gmeow:QualityAxis , gmeow:QualityDimension .

ex:groundingGrade   gmeow:hasProfile ex:profilePerAxisGradeRecord .
ex:translationGrade gmeow:hasProfile ex:profilePerAxisGradeRecord .
ex:rollupGrade      gmeow:hasProfile ex:profilePerAxisGradeRecord .
