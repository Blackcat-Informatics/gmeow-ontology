@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/accounts>
    a gmeow:Slice ;
    rdfs:label "accounts"@x-gmeow-english ;
    skos:definition "The accounts slice of the GMEOW ontology (core tier): GMEOW Accounts Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accounts> ;
    dcterms:title "GMEOW Accounts Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ;
    gmeow:sliceConsumer "Online accounts for the mail corpus, email delivery, and finance; the PaymentMethod value vocabulary for finance and organization."@x-gmeow-english .
