# SPDX-License-Identifier: CC-BY-4.0
#
# Declarative structural assertions for the standpoint slice -- the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_standpoint.py. Each assertion runs as a
# SPARQL ASK over the standpoint module graph (gmeow:scopeModule) under the
# native Rust slicetest harness (crates/slicetest).
#
# Standpoint IS migrated: class stereotypes are logic: (logic:Kind,
# logic:AbstractIndividualType, logic:Situation), NOT gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_modality_value_vocab_spans_belief_values -- uses g.subjects() on the
#     MERGED graph with set equality (== {5 IRIs}); would silently narrow scope.
#   test_three_axes_are_orthogonal -- accordingTo is in standpoint, but
#     wasAttributedTo + confidence are subjects in the provenance slice; a
#     scopeModule cell would miss those cross-slice triple patterns.
#   test_contested_places_cannot_force_inconsistency -- gmeow:containedInPlace
#     and gmeow:Place are subjects in the places slice, not the standpoint
#     module; a scopeModule cell would silently miss them.
#   test_vantage_semantically_subsumes_according_to -- reads skos:scopeNote
#     text dynamically and asserts English-string content; not a TBox triple.
#   test_vantage_recognises_observer_as_standpoint -- reads skos:definition
#     text dynamically; not a TBox triple.
#   test_according_to_references_vantage_as_reified_counterpart -- reads
#     skos:definition text dynamically; not a TBox triple.
#   test_no_preferred_or_primary_term_is_declared -- whole-ontology sweep via
#     g.subjects(); scoping to module would silently narrow the guard.
#   test_crimea_pair_coexists_in_the_dsl -- uses the native statement OWL downcast;
#     generated-artifact DSL check, not a module-scoped TBox assertion.
#   test_two_clocks_stay_distinct -- uses the native statement OWL downcast; same reason.
#   test_rdf12_artifact_carries_the_standpoint_axis -- reads committed file
#     content; generated-artifact check, not a TBox assertion.
#   test_coexistence_fixture_conforms -- SHACL validation call; ExampleConformance.
#   test_preferred_claim_is_flagged -- SHACL validation call; ExampleConformance.
#   test_withdrawn_standpoint_warning_does_not_fail -- SHACL validation call.
#   test_no_frame_collapsing_projection_exists -- filesystem .exists() check.
#   test_standpoint_owl2_projection_emits_tool_compatible_labels -- runs a
#     SPARQL query over a coverage fixture; projection check.
#   test_crminf_projection_is_at_least_as_expressive -- SPARQL query on
#     fixture; projection check.
#   test_prov_projection_attributes_every_standpoint -- SPARQL query on
#     fixture; projection check.
#   test_oa_projection_annotates_each_claim -- SPARQL query on fixture.
#   test_schema_projection_emits_per_standpoint_claims -- SPARQL query.
#   test_standpoint_tenure_generates_claim_restriction -- walks blank-node
#     restriction lists via g.objects() + g.items(); bnode structure is not
#     expressible as a simple module-scoped ASK.
#   test_standpoint_crminf_projection_from_standpoint_claim_reified -- SPARQL
#     query on fixture; projection check.
#   test_standpoint_crminf_projection_from_standpoint_claim_entity -- SPARQL
#     query on fixture; projection check.
#   test_standpoint_schema_projection_from_standpoint_claim_entity -- SPARQL
#     query on fixture; projection check.
#   test_bbc_projection_exists -- filesystem .exists() check.
#   test_bbc_projection_emits_news_event -- SPARQL query on fixture.
#   test_variety_coexistence_fixture_conforms -- SHACL validation call.
#   test_etymology_coexistence_fixture_conforms -- SHACL validation call.
#   test_standpoint_claim_maps_to_crminf_i5 -- load_mappings() call;
#     generated-artifact SSSOM check.
#   test_standpoint_claim_maps_to_iao_assertion -- load_mappings() call.
#   test_standpoint_claim_maps_to_oa_annotation -- load_mappings() call.
#   test_standpoint_maps_to_iptc_assertor -- load_mappings() call.
#   test_claim_modality_maps_to_sosa_has_result -- load_mappings() call.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/standpoint/tests/> .

# --- 1. accordingTo is an owl:AnnotationProperty (MUST) -----------------------
ex:saAccordingToIsAnnotationProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:accordingTo a owl:AnnotationProperty . }""" ;
    gmeow:saRationale "gmeow:accordingTo MUST be an owl:AnnotationProperty -- the standpoint axis stays OWL 2 DL (no ObjectProperty downcast), so the generated OWL downcast is DL-clean and accordingTo is a legal statement-DSL annProperty (Principle 3)." .

# --- 2. standpointModality is an owl:AnnotationProperty (MUST) ----------------
ex:saStandpointModalityIsAnnotationProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:standpointModality a owl:AnnotationProperty . }""" ;
    gmeow:saRationale "gmeow:standpointModality MUST be an owl:AnnotationProperty -- annotation-property placement is what makes the statement-DSL annotation form DL-clean (Principle 3)." .

# --- 3. Standpoint is a logic:Kind subclass of Entity (MUST) ------------------
ex:saStandpointIsKindEntity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Standpoint a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:Standpoint MUST be an owl:Class typed logic:Kind and a subclass of gmeow:Entity -- a named perspective is an endurant kind, not a mode or relator." .

# --- 4. StandpointTenure is a logic:Situation subclass of TimeScopedRelation --
ex:saStandpointTenureIsSituationTimeScopedRelation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:StandpointTenure a owl:Class , logic:Situation ;
        rdfs:subClassOf gmeow:TimeScopedRelation .
}""" ;
    gmeow:saRationale "gmeow:StandpointTenure MUST be an owl:Class typed logic:Situation and a subclass of gmeow:TimeScopedRelation -- the time-scoped recognition/withdrawal situation (Principle 10)." .

# --- 5. tenureStandpoint has domain StandpointTenure and range Standpoint ------
ex:saTenureStandpointShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:tenureStandpoint a owl:ObjectProperty ;
        rdfs:domain gmeow:StandpointTenure ;
        rdfs:range gmeow:Standpoint .
}""" ;
    gmeow:saRationale "gmeow:tenureStandpoint MUST be an owl:ObjectProperty with domain gmeow:StandpointTenure and range gmeow:Standpoint -- bridges the time-scoped situation to the named frame it records." .

# --- 7. sharpens is a TransitiveProperty (MUST) --------------------------------
ex:saSharpenIsTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:sharpens a owl:TransitiveProperty . }""" ;
    gmeow:saRationale "gmeow:sharpens MUST be owl:TransitiveProperty -- the standpoint refinement/subsumption relation is transitive by definition; transitivity closes the precisification poset." .

# --- 8. universalStandpoint is a Standpoint individual (MUST) -----------------
ex:saUniversalStandpointIsStandpoint a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:universalStandpoint a gmeow:Standpoint . }""" ;
    gmeow:saRationale "gmeow:universalStandpoint MUST be typed gmeow:Standpoint -- the top of the sharpens poset, the explicit-universal frame (unindexed statements default to gmeow:unspecifiedStandpoint)." .

# --- 9. Five StandpointModality seed individuals exist (MUST) -----------------
ex:saStandpointModalitySeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:unequivocal  a gmeow:StandpointModality .
    gmeow:probable     a gmeow:StandpointModality .
    gmeow:conceivable  a gmeow:StandpointModality .
    gmeow:refuted      a gmeow:StandpointModality .
    gmeow:bullshit     a gmeow:StandpointModality .
}""" ;
    gmeow:saRationale "All five gmeow:StandpointModality seed individuals (unequivocal, probable, conceivable, refuted, bullshit) MUST exist -- they span the Standpoint-Logic box/diamond plus CRMinf true/false/probable/possible plus the Frankfurt bullshit modality." .

# --- 10. No sixth StandpointModality individual exists (MUST-NOT) -------------
ex:saNoExtraStandpointModality a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?x a gmeow:StandpointModality .
    FILTER (?x NOT IN (
        gmeow:unequivocal, gmeow:probable, gmeow:conceivable,
        gmeow:refuted, gmeow:bullshit
    ))
}""" ;
    gmeow:saRationale "No sixth gmeow:StandpointModality individual MUST NOT exist -- the five-value vocabulary is closed by design (any extension would require an ontology revision, not a data assertion)." .

# --- 11. StandpointModality is a logic:AbstractIndividualType QualityValue ----
ex:saStandpointModalityIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:StandpointModality a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:StandpointModality MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- a closed value vocabulary of abstract individuals (the GranularityLevel pattern, belief-value edition). Guards the DL-clean disjointness from gmeow:Entity." .

# --- 12. standpointClaim is an ObjectProperty (MUST) -------------------------
ex:saStandpointClaimPropertyShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:standpointClaim a owl:ObjectProperty ;
        rdfs:domain gmeow:StandpointTenure ;
        rdfs:range gmeow:StandpointClaim .
}""" ;
    gmeow:saRationale "gmeow:standpointClaim MUST be an owl:ObjectProperty with domain gmeow:StandpointTenure and range gmeow:StandpointClaim -- a tenure generates the standpoint-claim observation." .

# --- 13. claimModality is an ObjectProperty (MUST) ---------------------------
ex:saClaimModalityPropertyShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:claimModality a owl:ObjectProperty ;
        rdfs:domain gmeow:StandpointClaim ;
        rdfs:range gmeow:StandpointModality .
}""" ;
    gmeow:saRationale "gmeow:claimModality MUST be an owl:ObjectProperty with domain gmeow:StandpointClaim and range gmeow:StandpointModality -- a standpoint claim carries its belief-value." .

# --- 14. claimModality is NOT a subPropertyOf observationResult (MUST-NOT) ----
ex:saClaimModalityNotSubpropertyObservationResult a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:claimModality rdfs:subPropertyOf gmeow:observationResult . }""" ;
    gmeow:saRationale "gmeow:claimModality MUST NOT be rdfs:subPropertyOf gmeow:observationResult -- StandpointModality (a logic:QualityValue / abstract individual) is disjoint from gmeow:Entity (a logic:Endurant) in the DL profile; the semantic equivalence is documented, not axiomatised (the claimModality precedent)." .

# === Factored claim modality: six orthogonal axes + lossless projection ===

# --- 15. Six axis value-classes are logic:AbstractIndividualType QualityValue (MUST) ---
ex:saSixAxisValueClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Polarity          a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
    gmeow:ModalForce        a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
    gmeow:CredenceLevel     a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
    gmeow:AssertoricForce   a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
    gmeow:TruthDirectedness a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
    gmeow:SupportStatus     a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "All six factored claim-modality axis value-classes MUST be owl:Class typed logic:AbstractIndividualType and subclasses of logic:QualityValue -- closed value vocabularies of abstract individuals, DL-clean and disjoint from gmeow:Entity, mirroring gmeow:StandpointModality." .

# --- 16. Polarity value individuals exist (MUST) ------------------------------
ex:saPolarityValues a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:polarityAffirm  a gmeow:Polarity .
    gmeow:polarityDeny    a gmeow:Polarity .
    gmeow:polaritySuspend a gmeow:Polarity .
}""" ;
    gmeow:saRationale "The three gmeow:Polarity values (affirm/deny/suspend) MUST exist -- the polarity axis; gmeow:polarityDeny is the canonical carrier of the legacy refuted (frame-relative denial, Principle 9)." .

# --- 17. ModalForce value individuals exist (MUST) ---------------------------
ex:saModalForceValues a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:modalForceNecessary      a gmeow:ModalForce .
    gmeow:modalForceActual         a gmeow:ModalForce .
    gmeow:modalForcePossible       a gmeow:ModalForce .
    gmeow:modalForceCounterfactual a gmeow:ModalForce .
}""" ;
    gmeow:saRationale "The four gmeow:ModalForce values (necessary/actual/possible/counterfactual) MUST exist -- the alethic Standpoint-Logic box/diamond register, kept distinct from credence and confidence." .

# --- 18. CredenceLevel value individuals exist (MUST) ------------------------
ex:saCredenceLevelValues a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:credenceCertain     a gmeow:CredenceLevel .
    gmeow:credenceLikely      a gmeow:CredenceLevel .
    gmeow:credencePossible    a gmeow:CredenceLevel .
    gmeow:credenceUnspecified a gmeow:CredenceLevel .
}""" ;
    gmeow:saRationale "The four gmeow:CredenceLevel bands (certain/likely/possible/unspecified) MUST exist -- the qualitative band the lossless projection keys on, paired with the numeric gmeow:claimCredence." .

# --- 19. AssertoricForce value individuals exist (MUST) ----------------------
ex:saAssertoricForceValues a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:assertoricAssert     a gmeow:AssertoricForce .
    gmeow:assertoricConjecture a gmeow:AssertoricForce .
    gmeow:assertoricAssume     a gmeow:AssertoricForce .
    gmeow:assertoricRetract    a gmeow:AssertoricForce .
}""" ;
    gmeow:saRationale "The four gmeow:AssertoricForce values (assert/conjecture/assume/retract) MUST exist -- the speech-act force axis; gmeow:assertoricRetract closes a withdrawn assertion without erasure (Principle 10)." .

# --- 20. TruthDirectedness value individuals exist (MUST) --------------------
ex:saTruthDirectednessValues a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:truthAimed       a gmeow:TruthDirectedness .
    gmeow:truthIndifferent a gmeow:TruthDirectedness .
    gmeow:truthStrategic   a gmeow:TruthDirectedness .
}""" ;
    gmeow:saRationale "The three gmeow:TruthDirectedness values (truth-aimed/indifferent/strategic) MUST exist -- gmeow:truthIndifferent is the canonical carrier of the legacy bullshit (Frankfurt indifference, NOT a truth value)." .

# --- 21. SupportStatus value individuals exist (MUST) -----------------------
ex:saSupportStatusValues a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:supportSupported a gmeow:SupportStatus .
    gmeow:supportOpposed   a gmeow:SupportStatus .
    gmeow:supportBoth      a gmeow:SupportStatus .
    gmeow:supportNeither   a gmeow:SupportStatus .
}""" ;
    gmeow:saRationale "The four gmeow:SupportStatus values (supported/opposed/both/neither) MUST exist -- the Belnap evidential axis; gmeow:supportBoth (glut) is admissible. Self-contained gmeow vocabulary aligned by prose to logic:InformationState." .

# --- 22. Seven annotation twins are owl:AnnotationProperty with correct range (MUST) ---
ex:saAxisAnnotationTwins a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:standpointPolarity          a owl:AnnotationProperty ; rdfs:range gmeow:Polarity .
    gmeow:standpointModalForce        a owl:AnnotationProperty ; rdfs:range gmeow:ModalForce .
    gmeow:standpointCredence          a owl:AnnotationProperty ; rdfs:range xsd:decimal .
    gmeow:standpointCredenceLevel     a owl:AnnotationProperty ; rdfs:range gmeow:CredenceLevel .
    gmeow:standpointAssertoricForce   a owl:AnnotationProperty ; rdfs:range gmeow:AssertoricForce .
    gmeow:standpointTruthDirectedness a owl:AnnotationProperty ; rdfs:range gmeow:TruthDirectedness .
    gmeow:standpointSupportStatus     a owl:AnnotationProperty ; rdfs:range gmeow:SupportStatus .
}""" ;
    gmeow:saRationale "The seven flattened-statement annotation twins MUST be owl:AnnotationProperty with the matching axis range -- DL-clean annotation form mirroring gmeow:standpointModality; standpointCredence ranges xsd:decimal." .

# --- 23. Six reified object twins are ObjectProperty domain StandpointClaim (MUST) ---
ex:saAxisReifiedObjectTwins a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:claimPolarity          a owl:ObjectProperty ; rdfs:domain gmeow:StandpointClaim ; rdfs:range gmeow:Polarity .
    gmeow:claimModalForce        a owl:ObjectProperty ; rdfs:domain gmeow:StandpointClaim ; rdfs:range gmeow:ModalForce .
    gmeow:claimCredenceLevel     a owl:ObjectProperty ; rdfs:domain gmeow:StandpointClaim ; rdfs:range gmeow:CredenceLevel .
    gmeow:claimAssertoricForce   a owl:ObjectProperty ; rdfs:domain gmeow:StandpointClaim ; rdfs:range gmeow:AssertoricForce .
    gmeow:claimTruthDirectedness a owl:ObjectProperty ; rdfs:domain gmeow:StandpointClaim ; rdfs:range gmeow:TruthDirectedness .
    gmeow:claimSupportStatus     a owl:ObjectProperty ; rdfs:domain gmeow:StandpointClaim ; rdfs:range gmeow:SupportStatus .
}""" ;
    gmeow:saRationale "The six reified object twins MUST be owl:ObjectProperty with domain gmeow:StandpointClaim and the matching axis range -- the StandpointClaim authoring form mirroring gmeow:claimModality." .

# --- 24. claimCredence is a DatatypeProperty range xsd:decimal (MUST) ---
ex:saClaimCredenceDatatypeShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:claimCredence a owl:DatatypeProperty ;
        rdfs:domain gmeow:StandpointClaim ;
        rdfs:range xsd:decimal .
}""" ;
    gmeow:saRationale "gmeow:claimCredence MUST be an owl:DatatypeProperty with domain gmeow:StandpointClaim and range xsd:decimal -- the precise numeric credence surface (0..1), paired with the qualitative gmeow:claimCredenceLevel the projection keys on." .

# --- 25. Reified axis twins are NOT subPropertyOf observationResult (MUST-NOT) ---
ex:saAxisTwinsNotSubpropertyObservationResult a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    ?p rdfs:subPropertyOf gmeow:observationResult .
    FILTER (?p IN (
        gmeow:claimPolarity, gmeow:claimModalForce, gmeow:claimCredence,
        gmeow:claimCredenceLevel, gmeow:claimAssertoricForce,
        gmeow:claimTruthDirectedness, gmeow:claimSupportStatus
    ))
}""" ;
    gmeow:saRationale "No reified axis twin MUST be rdfs:subPropertyOf gmeow:observationResult -- the axis value-classes (logic:QualityValue) are disjoint from gmeow:Entity in the DL profile; the equivalence is documented, not axiomatised (the claimModality precedent)." .

# --- 26a. CredenceLevel vocabulary is exactly four individuals — no fifth band (MUST-NOT) ---
# The closed four-band vocabulary (certain/likely/possible/unspecified) is the
# authoritative projection surface for the decimal-to-band bucketing thresholds.
# A fifth CredenceLevel individual would mean an undeclared threshold interval and must
# not exist — any extension requires an ontology revision, not a data assertion.
ex:saNoExtraCredenceLevel a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?x a gmeow:CredenceLevel .
    FILTER (?x NOT IN (
        gmeow:credenceCertain, gmeow:credenceLikely,
        gmeow:credencePossible, gmeow:credenceUnspecified
    ))
}""" ;
    gmeow:saRationale "No fifth gmeow:CredenceLevel individual MUST NOT exist — the four-band vocabulary (certain/likely/possible/unspecified) is closed by design; each band maps to a canonical decimal threshold range (certain [0.9,1.0], likely [0.5,0.9), possible [0.0,0.5), unspecified = no decimal). An additional band would require an ontology revision to assign it a threshold interval, not a data assertion. Mirrors the pattern of the StandpointModality closed-set cell." .

# --- 26. Each legacy modality value keeps its typing AND carries its full six-axis bundle (MUST, augment-not-replace) ---
ex:saLegacyModalityDecomposesToAxis a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:unequivocal a gmeow:StandpointModality ;
        gmeow:decomposesToAxis gmeow:polarityAffirm , gmeow:modalForceNecessary , gmeow:credenceCertain , gmeow:assertoricAssert , gmeow:truthAimed , gmeow:supportSupported .
    gmeow:probable a gmeow:StandpointModality ;
        gmeow:decomposesToAxis gmeow:polarityAffirm , gmeow:modalForceActual , gmeow:credenceLikely , gmeow:assertoricConjecture , gmeow:truthAimed , gmeow:supportSupported .
    gmeow:conceivable a gmeow:StandpointModality ;
        gmeow:decomposesToAxis gmeow:polaritySuspend , gmeow:modalForcePossible , gmeow:credencePossible , gmeow:assertoricAssume , gmeow:truthAimed , gmeow:supportNeither .
    gmeow:refuted a gmeow:StandpointModality ;
        gmeow:decomposesToAxis gmeow:polarityDeny , gmeow:modalForceNecessary , gmeow:credenceCertain , gmeow:assertoricAssert , gmeow:truthAimed , gmeow:supportOpposed .
    gmeow:bullshit a gmeow:StandpointModality ;
        gmeow:decomposesToAxis gmeow:polarityAffirm , gmeow:modalForceActual , gmeow:credenceUnspecified , gmeow:assertoricAssert , gmeow:truthIndifferent , gmeow:supportNeither .
}""" ;
    gmeow:saRationale "Each of the five legacy gmeow:StandpointModality values MUST retain its gmeow:StandpointModality typing AND carry its canonical six-axis gmeow:decomposesToAxis bundle -- augment-not-replace: the legacy surface stays the lossless projection target, and these bundles are the declarative source the Rust round-trip (crates/slice/src/standpoint_modality.rs) cross-checks. bullshit=truthIndifferent (not a truth value); refuted=polarityDeny+supportOpposed (frame-relative, Principle 9)." .

# --- 27. Scenario is a logic:Kind subclass of Entity (MUST) -------------------
ex:saScenarioIsKindEntity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Scenario a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:Scenario MUST be an owl:Class typed logic:Kind and a subclass of gmeow:Entity -- a hypothesized situation under consideration, one of the distinct typed contexts of the context algebra, kept apart from logic:PossibleWorld and gmeow:Standpoint." .

# --- 28. State is a logic:Kind subclass of Entity (MUST) ----------------------
ex:saStateIsKindEntity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:State a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:State MUST be an owl:Class typed logic:Kind and a subclass of gmeow:Entity -- one state of affairs along a logic:Path (the position a logic:Situation realizes), distinct from logic:Situation (the reified snapshot)." .

# --- 29. unspecifiedStandpoint is a Standpoint individual (MUST) --------------
ex:saUnspecifiedStandpointIsStandpoint a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:unspecifiedStandpoint a gmeow:Standpoint . }""" ;
    gmeow:saRationale "gmeow:unspecifiedStandpoint MUST be typed gmeow:Standpoint -- the default-of-silence frame an unindexed statement is held in (unspecified, not universal); the sibling of gmeow:universalStandpoint." .

# --- 30. unspecifiedStandpoint sits outside the sharpens poset (MUST-NOT) -----
ex:saUnspecifiedStandpointOutsidePoset a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    { ?x gmeow:sharpens gmeow:unspecifiedStandpoint . }
    UNION
    { gmeow:unspecifiedStandpoint gmeow:sharpens ?y . }
}""" ;
    gmeow:saRationale "gmeow:unspecifiedStandpoint MUST NOT be the top of the sharpens poset nor sharpen anything -- silence sits outside the refinement order and licenses no propagation; only gmeow:universalStandpoint is the explicit-universal top that every standpoint sharpens." .

# --- 31. unspecifiedStandpoint is distinct from universalStandpoint (MUST-NOT) ---
ex:saUnspecifiedNotSameAsUniversal a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    { gmeow:unspecifiedStandpoint owl:sameAs gmeow:universalStandpoint . }
    UNION
    { gmeow:universalStandpoint owl:sameAs gmeow:unspecifiedStandpoint . }
}""" ;
    gmeow:saRationale "gmeow:unspecifiedStandpoint MUST NOT be owl:sameAs gmeow:universalStandpoint -- the central 'unspecified, not universal' distinction: the default-of-silence and the explicit-universal top are distinct frames; conflating them re-introduces the silent-universality collapse." .
