@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sioc:  <http://rdfs.org/sioc/ns#> .

# Email and syndicated-posting projections to SIOC. Thread and direct-reply
# projections are owned by the shared messaging slice. Email-specific authorship
# resolves a From address to its contact-point holder rather than its string.

gmeow:mapSiocPost a gmeow:ProjectionMapping ;
    rdfs:label "EmailMessage → sioc:Post"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "smsg" ;
        gmeow:atom ( [ gmeow:subjectVar "smsg" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:EmailMessage ] ) ;
        gmeow:edoalSource gmeow:EmailMessage ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "sioc" ; gmeow:toClass sioc:Post ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "RFC 5322 header structure (cc/bcc, address vs agent) flattens to SIOC's post model" ] .




# Authorship: the From ADDRESS resolves to the agent holding it as a contact
# point — SIOC's creator is the agent, never the mailbox string.
gmeow:mapSiocHasCreator a gmeow:ProjectionMapping ;
    rdfs:label "from-address holder → sioc:has_creator"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "samsg" ; gmeow:value "sauthor" ;
        gmeow:atom (
            [ gmeow:subjectVar "samsg" ; gmeow:predicate gmeow:from ; gmeow:objectVar "saddr" ]
            [ gmeow:subjectVar "sauthor" ; gmeow:predicate gmeow:hasContactPoint ; gmeow:objectVar "saddr" ] ) ;
        gmeow:edoalSource gmeow:from ] ;
    gmeow:hasBinding [
        gmeow:profile "sioc" ; gmeow:toPredicate sioc:has_creator ; gmeow:relation "<=" ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "the address-vs-agent distinction collapses: the contact-point holder is read as the creator" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "samsg" ; gmeow:tPred sioc:has_creator ; gmeow:tObj "sauthor" ] ) ] .

gmeow:mapSiocUserAccount a gmeow:ProjectionMapping ;
    rdfs:label "OnlineAccount → sioc:UserAccount + account_of"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "sagent" ; gmeow:value "sacct" ;
        gmeow:atom ( [ gmeow:subjectVar "sagent" ; gmeow:predicate gmeow:holdsAccount ; gmeow:objectVar "sacct" ] ) ;
        gmeow:edoalSource gmeow:holdsAccount ] ;
    gmeow:hasBinding [
        gmeow:profile "sioc" ; gmeow:toPredicate sioc:account_of ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "every held online account over-types as a SIOC user account" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "sacct" ; gmeow:tPred rdf:type ; gmeow:tObjValue sioc:UserAccount ]
            [ gmeow:tSubj "sacct" ; gmeow:tPred sioc:account_of ; gmeow:tObj "sagent" ] ) ] .


# Topic, display name and source-location projections.

# NOT mnemomorphic: the source pattern uses `stMsg a gmeow:EmailMessage` as a
# selection GUARD, but sioc:topic carries no email-hood — a bare sioc:topic edge
# cannot recover the EmailMessage type, so a CompleteOver put would FABRICATE it.
# The put leg stays Unsupported (the honest floor); recovering it would need a
# co-authored ingest claim, not a witness.
gmeow:mapSiocTopic a gmeow:ProjectionMapping ;
    rdfs:label "message isAbout → sioc:topic"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "stMsg" ; gmeow:value "stTopic" ;
        gmeow:atom (
            [ gmeow:subjectVar "stMsg" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:EmailMessage ]
            [ gmeow:subjectVar "stMsg" ; gmeow:predicate gmeow:isAbout ; gmeow:objectVar "stTopic" ] ) ;
        gmeow:edoalSource gmeow:isAbout ] ;
    gmeow:hasBinding [ gmeow:profile "sioc" ; gmeow:toPredicate sioc:topic ; gmeow:relation "=" ; gmeow:confidence 0.9 ] .

gmeow:mapSiocName a gmeow:ProjectionMapping ;
    rdfs:label "accountName → sioc:name (the account display name)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "snAcct" ; gmeow:value "snName" ;
        gmeow:atom ( [ gmeow:subjectVar "snAcct" ; gmeow:predicate gmeow:accountName ; gmeow:objectVar "snName" ] ) ;
        gmeow:edoalSource gmeow:accountName ] ;
    gmeow:hasBinding [ gmeow:profile "sioc" ; gmeow:toPredicate sioc:name ; gmeow:relation "<=" ; gmeow:confidence 0.85 ] .

gmeow:mapSiocLink a gmeow:ProjectionMapping ;
    rdfs:label "message sourceLocation → sioc:link"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "slMsg" ; gmeow:value "slUrl" ;
        gmeow:atom (
            [ gmeow:subjectVar "slMsg" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:EmailMessage ]
            [ gmeow:subjectVar "slMsg" ; gmeow:predicate gmeow:sourceLocation ; gmeow:objectVar "slUrl" ] ) ;
        gmeow:edoalSource gmeow:sourceLocation ] ;
    gmeow:hasBinding [ gmeow:profile "sioc" ; gmeow:toPredicate sioc:link ; gmeow:relation "<=" ; gmeow:confidence 0.85 ] .

# --------------------------------------------------------------------------- #
# Syndicated postings are online-community content: a FeedPosting projects to
# sioc:Post, and a share or repost retains its shared-content link.
# --------------------------------------------------------------------------- #

gmeow:mapSiocFeedPost a gmeow:ProjectionMapping ;
    rdfs:label "FeedPosting → sioc:Post"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "sfp" ;
        gmeow:atom ( [ gmeow:subjectVar "sfp" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:FeedPosting ] ) ;
        gmeow:edoalSource gmeow:FeedPosting ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "sioc" ; gmeow:toClass sioc:Post ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the open posting-kind value (social/blog/microblog) flattens to SIOC's single Post class" ] .

gmeow:mapSiocLinksTo a gmeow:ProjectionMapping ;
    rdfs:label "sharesContent → sioc:links_to"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "slt" ; gmeow:value "sltShared" ;
        gmeow:atom ( [ gmeow:subjectVar "slt" ; gmeow:predicate gmeow:sharesContent ; gmeow:objectVar "sltShared" ] ) ;
        gmeow:edoalSource gmeow:sharesContent ] ;
    gmeow:hasBinding [ gmeow:profile "sioc" ; gmeow:toPredicate sioc:links_to ; gmeow:relation "<=" ; gmeow:confidence 0.85 ] .
