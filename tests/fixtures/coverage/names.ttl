# Synthetic coverage fixture for the names building block. Centrepiece: the
# project owner's two CO-EQUAL full names — "Patrick Colm Audley" and "欧德理" —
# neither marked primary, neither a romanization of the other, each self-asserted
# (gmeow:wasAttributedTo the person himself = top authority). Plus a worked set
# exercising every term: the context-dependent "Aunt Genny" vs "Mrs Smith"
# NameUsage relator; a chosen name with a suppressed deadname; a custom pronoun
# set; a Spanish double surname; an Arabic ism/nasab/nisba decomposition; a
# mononym; a Filename whose extension claims a type the bytes contradict; and a
# place with co-equal endonym/exonym toponyms whose name-usages are INFERRED to be
# gmeow:PlaceNaming. Language is always a first-class gmeow:Language (never a
# literal tag): gmeow:nameLanguage points at a Language individual.
# No RDF-star (the coverage parser can't read << >>); temporality/provenance use
# the reified path (NameUsage + TimeInterval, wasAttributedTo).

@prefix ex:     <https://example.org/names/> .
@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# --- First-class languages (gmeow:nameLanguage is an object property → Language) #
# Registry-INDEPENDENT: the IRI is identity, gmeow:languageCode is an OPTIONAL tag.

ex:langEn  a gmeow:Language ; gmeow:languageTag "x-gmeow-english" ; gmeow:bcp47Tag "en"^^xsd:language ; gmeow:languageCode "en" .
ex:langZh  a gmeow:Language ; gmeow:languageTag "x-gmeow-chinese" ; gmeow:bcp47Tag "zh"^^xsd:language ; gmeow:languageCode "zh" .
ex:langFr  a gmeow:Language ; gmeow:languageTag "x-gmeow-french" ; gmeow:bcp47Tag "fr"^^xsd:language ; gmeow:languageCode "fr" .
ex:langJa  a gmeow:Language ; gmeow:languageTag "x-gmeow-japanese" ; gmeow:bcp47Tag "ja"^^xsd:language ; gmeow:languageCode "ja" .
ex:langEs  a gmeow:Language ; gmeow:languageTag "x-gmeow-spanish" ; gmeow:bcp47Tag "es"^^xsd:language ; gmeow:languageCode "es" .
ex:langKo  a gmeow:Language ; gmeow:languageTag "x-gmeow-korean" ; gmeow:bcp47Tag "ko"^^xsd:language ; gmeow:languageCode "ko" .
ex:langBan a gmeow:Language ; gmeow:languageTag "x-gmeow-balinese" ; gmeow:bcp47Tag "ban"^^xsd:language ; gmeow:languageCode "ban" .
ex:langLa  a gmeow:Language ; gmeow:languageTag "x-gmeow-latin" ; gmeow:bcp47Tag "la"^^xsd:language ; gmeow:languageCode "la" .
ex:langDe  a gmeow:Language ; gmeow:languageTag "x-gmeow-german" ; gmeow:bcp47Tag "de"^^xsd:language ; gmeow:languageCode "de" .
ex:langId  a gmeow:Language ; gmeow:languageTag "x-gmeow-indonesian" ; gmeow:bcp47Tag "id"^^xsd:language ; gmeow:languageCode "id" .

# --- Co-equal multilingual names (anti-colonial centrepiece) ---------------- #

ex:patrick a gmeow:Person ;
    gmeow:hasName ex:nameLatin , ex:nameHan ;
    gmeow:hasPronounSet gmeow:pronounHeHim ;
    gmeow:honorific gmeow:honorificMx .

# Latin-script name — co-equal, NOT canonical.
ex:nameLatin a gmeow:PersonName ;
    gmeow:fullName "Patrick Colm Audley"@x-gmeow-english ;
    gmeow:nameLanguage ex:langEn ;
    gmeow:namePurpose gmeow:namePurposeLegal ;
    gmeow:displayable true ;
    gmeow:hasNamePart ex:plGiven , ex:plMiddle , ex:plSurname ;
    gmeow:wasAttributedTo ex:patrick .

ex:plGiven a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGiven ; gmeow:partText "Patrick" ; gmeow:partOrder 0 .
ex:plMiddle a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartMiddle ; gmeow:partText "Colm" ; gmeow:partOrder 1 .
ex:plSurname a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartSurname ; gmeow:partText "Audley" ; gmeow:partOrder 2 .

# Mandarin name — a CO-EQUAL full name: family-first (姓 欧 → 名 德理), chosen and
# meaningful, NOT a romanization or alternate of the Latin name. The pinyin
# is the romanization of THIS name only.
ex:nameHan a gmeow:PersonName ;
    gmeow:fullName "欧德理"@x-gmeow-chinese ;
    gmeow:nameLanguage ex:langZh ;
    gmeow:nameScript "Hans" ;
    gmeow:romanization "Ōu Délǐ"@x-gmeow-chinese-latn ;
    gmeow:namePurpose gmeow:namePurposeChosen ;
    gmeow:displayable true ;
    gmeow:hasNamePart ex:hanSurname , ex:hanGiven ;
    gmeow:wasAttributedTo ex:patrick .

ex:hanSurname a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartSurname ; gmeow:partText "欧"@x-gmeow-chinese ; gmeow:partOrder 0 .
ex:hanGiven a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGiven ; gmeow:partText "德理"@x-gmeow-chinese ; gmeow:partOrder 1 .

# --- Context-dependent naming: "Mrs Smith" (students) vs "Aunt Genny" (family) #

ex:genny a gmeow:Person ;
    gmeow:hasName ex:gennyLegal , ex:gennyMrs , ex:gennyAunt ;
    gmeow:honorific gmeow:honorificMrs .

ex:gennyLegal a gmeow:PersonName ;
    gmeow:fullName "Genevieve Smith"@x-gmeow-english ; gmeow:namePurpose gmeow:namePurposeLegal ; gmeow:displayable true .
ex:gennyMrs a gmeow:PersonName ;
    gmeow:fullName "Mrs Smith"@x-gmeow-english ; gmeow:namePurpose gmeow:namePurposeProfessional ; gmeow:displayable true .
ex:gennyAunt a gmeow:PersonName ;
    gmeow:fullName "Aunt Genny"@x-gmeow-english ; gmeow:namePurpose gmeow:namePurposeNickname ; gmeow:displayable true .

ex:usageStudents a gmeow:NameUsage ;
    gmeow:usageNamed ex:genny ;
    gmeow:usageAppellation ex:gennyMrs ;
    gmeow:usageRegister gmeow:registerFormal ;
    gmeow:usageAudience ex:students ;
    gmeow:usageInterval ex:teachingYears .

ex:usageFamily a gmeow:NameUsage ;
    gmeow:usageNamed ex:genny ;
    gmeow:usageAppellation ex:gennyAunt ;
    gmeow:usageRegister gmeow:registerIntimate ;
    gmeow:usageRelationshipScope ex:auntNieceTie .

ex:teachingYears a gmeow:TimeInterval ;
    gmeow:startedAtTime "1998-09-01T00:00:00Z"^^xsd:dateTime .
ex:auntNieceTie a gmeow:InterpersonalRelationship ;
    gmeow:relationshipParty ex:genny , ex:niece .
ex:students a gmeow:Group .
ex:niece a gmeow:Person .

# --- Transition: chosen name displayed, deadname recorded but suppressed ----- #

ex:alex a gmeow:Person ;
    gmeow:hasName ex:alexChosen , ex:alexFormer ;
    gmeow:hasPronounSet ex:faeSet ;
    gmeow:honorific gmeow:honorificMx .

ex:alexChosen a gmeow:PersonName ;
    gmeow:fullName "Alex Rivera"@x-gmeow-english ;
    gmeow:namePurpose gmeow:namePurposeLegal ;
    gmeow:displayable true ;
    gmeow:hasNamePart ex:arGiven , ex:arSurname .

ex:arGiven a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGiven ;
    gmeow:partText "Alex"@x-gmeow-english ;
    gmeow:partOrder 0 .

ex:arSurname a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartSurname ;
    gmeow:partText "Rivera"@x-gmeow-english ;
    gmeow:partOrder 1 .

ex:alexFormer a gmeow:PersonName ;
    gmeow:fullName "[suppressed former name]"@x-gmeow-english ;
    gmeow:namePurpose gmeow:namePurposeDeadname ;
    gmeow:displayable false ;
    gmeow:conferredByEvent ex:alexNameChange .

ex:alexNameChange a gmeow:LifeEvent ; gmeow:eventType gmeow:eventTypeNameChange .

# A custom pronoun set, expressed by filling the five forms (sex/gender-independent).
ex:faeSet a gmeow:PronounSet ;
    gmeow:pronounSubject "fae" ; gmeow:pronounObject "faer" ;
    gmeow:pronounPossessiveDeterminer "faer" ; gmeow:pronounPossessive "faers" ;
    gmeow:pronounReflexive "faerself" .

# --- Spanish double surname ------------------------------------------------- #

ex:jose a gmeow:Person ; gmeow:hasName ex:joseName .
ex:joseName a gmeow:PersonName ;
    gmeow:fullName "José García Pérez"@x-gmeow-spanish ; gmeow:nameLanguage ex:langEs ;
    gmeow:hasNamePart ex:joseGiven , ex:josePat , ex:joseMat .
ex:joseGiven a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGiven ; gmeow:partText "José"@x-gmeow-spanish ; gmeow:partOrder 0 .
ex:josePat a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartPaternalSurname ; gmeow:partText "García"@x-gmeow-spanish ; gmeow:partOrder 1 .
ex:joseMat a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartMaternalSurname ; gmeow:partText "Pérez"@x-gmeow-spanish ; gmeow:partOrder 2 .

# --- Arabic ism / nasab / nisba decomposition ------------------------------- #

ex:alkhwarizmi a gmeow:Person ; gmeow:hasName ex:akName .
ex:akName a gmeow:PersonName ;
    gmeow:fullName "Muhammad ibn Musa al-Khwarizmi"@x-gmeow-english ;
    gmeow:hasNamePart ex:akIsm , ex:akNasab , ex:akNisba .
ex:akIsm a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartIsm ; gmeow:partText "Muhammad" ; gmeow:partOrder 0 .
ex:akNasab a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartNasab ; gmeow:partText "ibn Musa" ; gmeow:partOrder 1 .
ex:akNisba a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartNisba ; gmeow:partText "al-Khwarizmi" ; gmeow:partOrder 2 .

# --- East-Asian generation name (surname + generation marker + personal) ---- #

ex:lin a gmeow:Person ; gmeow:hasName ex:linName .
ex:linName a gmeow:PersonName ;
    gmeow:fullName "林文豪"@x-gmeow-chinese ; gmeow:nameLanguage ex:langZh ; gmeow:nameScript "Hans" ;
    gmeow:romanization "Lín Wénháo"@x-gmeow-chinese-latn ;
    gmeow:hasNamePart ex:linSurname , ex:linGen , ex:linGiven .
ex:linSurname a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartSurname ; gmeow:partText "林"@x-gmeow-chinese ; gmeow:partOrder 0 .
ex:linGen a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGenerationName ; gmeow:partText "文"@x-gmeow-chinese ; gmeow:partOrder 1 ;
    gmeow:partExpansion "generation marker shared by same-generation kin" .
ex:linGiven a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGiven ; gmeow:partText "豪"@x-gmeow-chinese ; gmeow:partOrder 2 .

# --- Korean clan name (bon-gwan) — not in the rendered surface order -------- #

ex:kim a gmeow:Person ; gmeow:hasName ex:kimName .
ex:kimName a gmeow:PersonName ;
    gmeow:fullName "김민준"@x-gmeow-korean ; gmeow:nameLanguage ex:langKo ; gmeow:nameScript "Hang" ;
    gmeow:hasNamePart ex:kimSurname , ex:kimGiven , ex:kimClan .
ex:kimSurname a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartSurname ; gmeow:partText "김"@x-gmeow-korean ; gmeow:partOrder 0 .
ex:kimGiven a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGiven ; gmeow:partText "민준"@x-gmeow-korean ; gmeow:partOrder 1 .
ex:kimClan a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartClanName ; gmeow:partText "김해"@x-gmeow-korean ;
    gmeow:partExpansion "Gimhae (clan seat / bon-gwan)" .

# --- Balinese birth-order name ---------------------------------------------- #

ex:wayan a gmeow:Person ; gmeow:hasName ex:wayanName .
ex:wayanName a gmeow:PersonName ;
    gmeow:fullName "Wayan Sukerta"@x-gmeow-balinese ; gmeow:nameLanguage ex:langBan ;
    gmeow:hasNamePart ex:wayanBirth , ex:wayanGiven .
ex:wayanBirth a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartBirthOrderName ; gmeow:partText "Wayan"@x-gmeow-balinese ; gmeow:partOrder 0 ;
    gmeow:partExpansion "first-born" .
ex:wayanGiven a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGiven ; gmeow:partText "Sukerta"@x-gmeow-balinese ; gmeow:partOrder 1 .

# --- Roman tria/quattuor nomina (historical genealogy) ---------------------- #

ex:scipio a gmeow:Person ; gmeow:hasName ex:scipioName .
ex:scipioName a gmeow:PersonName ;
    gmeow:fullName "Publius Cornelius Scipio Africanus"@x-gmeow-latin ; gmeow:nameLanguage ex:langLa ;
    gmeow:hasNamePart ex:scPrae , ex:scNomen , ex:scCognomen , ex:scAgnomen .
ex:scPrae a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartPraenomen ; gmeow:partText "Publius"@x-gmeow-latin ; gmeow:partOrder 0 .
ex:scNomen a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartNomen ; gmeow:partText "Cornelius"@x-gmeow-latin ; gmeow:partOrder 1 .
ex:scCognomen a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartCognomen ; gmeow:partText "Scipio"@x-gmeow-latin ; gmeow:partOrder 2 .
ex:scAgnomen a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartAgnomen ; gmeow:partText "Africanus"@x-gmeow-latin ; gmeow:partOrder 3 .

# --- House/estate name (Germanic Hofname) + a teknonym --------------------- #

ex:hans a gmeow:Person ; gmeow:hasName ex:hansName .
ex:hansName a gmeow:PersonName ;
    gmeow:fullName "Müllers Hans"@x-gmeow-german ; gmeow:nameLanguage ex:langDe ;
    gmeow:hasNamePart ex:hansHouse , ex:hansGiven .
ex:hansHouse a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartHouseName ; gmeow:partText "Müllers"@x-gmeow-german ; gmeow:partOrder 0 ;
    gmeow:partExpansion "of the Müller farm" .
ex:hansGiven a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGiven ; gmeow:partText "Hans"@x-gmeow-german ; gmeow:partOrder 1 .

ex:ibuSari a gmeow:Person ; gmeow:hasName ex:ibuSariName .
ex:ibuSariName a gmeow:PersonName ;
    gmeow:fullName "Ibu Sari"@x-gmeow-indonesian ; gmeow:nameLanguage ex:langId ;
    gmeow:hasNamePart ex:teknonymPart .
ex:teknonymPart a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartTeknonym ; gmeow:partText "Ibu Sari"@x-gmeow-indonesian ; gmeow:partOrder 0 ;
    gmeow:partExpansion "mother of Sari" .

# --- Mononym (no surname required) ------------------------------------------ #

ex:plato a gmeow:Person ; gmeow:hasName ex:platoName .
ex:platoName a gmeow:PersonName ;
    gmeow:fullName "Plato"@x-gmeow-english ; gmeow:hasNamePart ex:platoMono .
ex:platoMono a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartMononym ; gmeow:partText "Plato" ; gmeow:partOrder 0 .

# --- Stacked generational markers: "Charles Beaumont Sr. III" --------------- #
# Two DISTINCT generational parts — a suffix (Sr.) and an ordinal (III / "the
# Third") — kept apart by type, with partOrder preserving the rendered order.

ex:charles a gmeow:Person ; gmeow:hasName ex:charlesName .
ex:charlesName a gmeow:PersonName ;
    gmeow:fullName "Charles Beaumont Sr. III"@x-gmeow-english ;
    gmeow:hasNamePart ex:cbGiven , ex:cbSurname , ex:cbSenior , ex:cbThird .
ex:cbGiven a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGiven ; gmeow:partText "Charles" ; gmeow:partOrder 0 .
ex:cbSurname a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartSurname ; gmeow:partText "Beaumont" ; gmeow:partOrder 1 .
ex:cbSenior a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGenerationalSuffix ; gmeow:partText "Sr." ; gmeow:partOrder 2 .
ex:cbThird a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartGenerationalOrdinal ;
    gmeow:partText "III" ; gmeow:partExpansion "the Third" ; gmeow:partOrder 3 .

# --- Filename claim-vs-reality (the extension lies) ------------------------- #

ex:invoiceFile a gmeow:Filename ;
    gmeow:fullName "invoice.pdf" ;
    gmeow:claimedMediaType "application/pdf" ;
    gmeow:detectedMediaType "application/zip" ;
    gmeow:hasNamePart ex:invStem , ex:invExt .
ex:invStem a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartStem ; gmeow:partText "invoice" ; gmeow:partOrder 0 .
ex:invExt a gmeow:NamePart ;
    gmeow:namePartType gmeow:namePartExtension ; gmeow:partText "pdf" ; gmeow:partOrder 1 .

# --- Organization appellation ----------------------------------------------- #

ex:orgName a gmeow:OrganizationName ;
    gmeow:fullName "Blackcat Informatics Inc."@x-gmeow-english ; gmeow:namePurpose gmeow:namePurposeLegal .

# --- Place naming: co-equal endonym/exonym toponyms + inferred PlaceNaming --- #
# A name-usage whose usageNamed is a gmeow:Place is INFERRED to be a
# gmeow:PlaceNaming (≡ NameUsage ⊓ ∃usageNamed.Place) — the reasoner classifies it;
# nothing is asserted. The names are CO-EQUAL (no primary); the historical name is
# suppressed (displayable false), not deleted. hasPlaceName replaces the retired
# flat alternateName literal.

ex:munichCity a gmeow:Place ;
    gmeow:hasPlaceName ex:munichEndonym , ex:munichExonym , ex:munichHistorical .

ex:munichEndonym a gmeow:PlaceName ;
    gmeow:fullName "München"@x-gmeow-german ; gmeow:nameLanguage ex:langDe ; gmeow:nameScript "Latn" ;
    gmeow:namePurpose gmeow:namePurposeEndonym ; gmeow:displayable true .
ex:munichExonym a gmeow:PlaceName ;
    gmeow:fullName "Munich"@x-gmeow-english ; gmeow:nameLanguage ex:langEn ; gmeow:nameScript "Latn" ;
    gmeow:namePurpose gmeow:namePurposeExonym ; gmeow:displayable true .
ex:munichHistorical a gmeow:PlaceName ;
    gmeow:fullName "Munichen"@x-gmeow-latin ; gmeow:nameLanguage ex:langLa ;
    gmeow:namePurpose gmeow:namePurposeSuperseded ; gmeow:displayable false .

# Endonym usage — sanctioned by a toponymic authority (gmeow:usageAuthority).
ex:munichEndonymUsage a gmeow:NameUsage ;
    gmeow:usageNamed ex:munichCity ;
    gmeow:usageAppellation ex:munichEndonym ;
    gmeow:usageRegister gmeow:registerFormal ;
    gmeow:usageAuthority ex:bavarianAuthority ;
    gmeow:usageAudience ex:germanSpeakers .
# Exonym usage — same place, co-equal English name, different audience.
ex:munichExonymUsage a gmeow:NameUsage ;
    gmeow:usageNamed ex:munichCity ;
    gmeow:usageAppellation ex:munichExonym ;
    gmeow:usageRegister gmeow:registerFormal ;
    gmeow:usageAudience ex:englishSpeakers .

ex:bavarianAuthority a gmeow:Organization ;
    gmeow:hasOrganizationName ex:orgNameEn , ex:orgNameFr .

ex:orgNameEn a gmeow:OrganizationName ;
    gmeow:fullName "Blackcat Informatics Inc."@x-gmeow-english ;
    gmeow:nameLanguage ex:langEn ; gmeow:nameScript "Latn" ;
    gmeow:namePurpose gmeow:namePurposeLegal ; gmeow:displayable true .

ex:orgNameFr a gmeow:OrganizationName ;
    gmeow:fullName "Informatique Blackcat Inc."@x-gmeow-french ;
    gmeow:nameLanguage ex:langFr ; gmeow:nameScript "Latn" ;
    gmeow:namePurpose gmeow:namePurposeExonym ; gmeow:displayable true .

# --- CreativeWork title: co-equal multilingual (issue #97) ------------------ #

ex:doc a gmeow:Document ;
    gmeow:hasTitle ex:titleEn , ex:titleJa .

ex:titleEn a gmeow:CreativeWorkTitle ;
    gmeow:fullName "The Art of Naming"@x-gmeow-english ;
    gmeow:nameLanguage ex:langEn ; gmeow:nameScript "Latn" ;
    gmeow:displayable true .

ex:titleJa a gmeow:CreativeWorkTitle ;
    gmeow:fullName "命名の芸術"@x-gmeow-japanese ;
    gmeow:nameLanguage ex:langJa ; gmeow:nameScript "Hani" ;
    gmeow:romanization "Meimei no Geijutsu"@x-gmeow-japanese-latn ;
    gmeow:transliterationScheme gmeow:schemeHepburn ;
    gmeow:displayable true .

# --- Agreement name: multilingual legal instrument (issue #97) ---------------- #

ex:contract a gmeow:Contract ;
    gmeow:hasAgreementName ex:contractNameEn , ex:contractNameDe .

ex:contractNameEn a gmeow:AgreementName ;
    gmeow:fullName "Service Agreement"@x-gmeow-english ;
    gmeow:nameLanguage ex:langEn ; gmeow:nameScript "Latn" ;
    gmeow:displayable true .

ex:contractNameDe a gmeow:AgreementName ;
    gmeow:fullName "Dienstleistungsvertrag"@x-gmeow-german ;
    gmeow:nameLanguage ex:langDe ; gmeow:nameScript "Latn" ;
    gmeow:displayable true .

# --- Software name: localized product name (issue #97) ------------------------ #

ex:app a gmeow:SoftwareProject ;
    gmeow:hasSoftwareName ex:appNameEn , ex:appNameZh .

ex:appNameEn a gmeow:SoftwareName ;
    gmeow:fullName "GMEOW Toolkit"@x-gmeow-english ;
    gmeow:nameLanguage ex:langEn ; gmeow:nameScript "Latn" ;
    gmeow:displayable true .

ex:appNameZh a gmeow:SoftwareName ;
    gmeow:fullName "喵本体工具包"@x-gmeow-chinese ;
    gmeow:nameLanguage ex:langZh ; gmeow:nameScript "Hans" ;
    gmeow:romanization "Miāo Běntǐ Gōngjùbāo"@x-gmeow-chinese-latn ;
    gmeow:transliterationScheme gmeow:schemePinyin ;
    gmeow:displayable true .

ex:germanSpeakers a gmeow:Group .
ex:englishSpeakers a gmeow:Group .
