# --- The relations that point at the kernel's own law objects ----------------
ex:cqLawObjectReferentsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "lawKind" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "term" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:cqLawObjectReferents a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX logic: <https://blackcatinformatics.ca/logic/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?lawKind ?term WHERE { VALUES ?lawKind { logic:Constraint logic:Formula } ?term rdfs:range ?lawKind } ORDER BY ?lawKind ?term" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Laws are data in this slice, so relations can point AT them, and this roster is what that buys. Seventeen relations reach a formula — the connectives and quantifiers that build one, plus the four that attach a finished formula to something that uses it: a constraint's integrity condition, an axis transition law's admitted relation, a method's applicability guard and a reasoning program's query. Exactly ONE relation reaches a constraint, and that asymmetry is the point: a formula is a reusable term, whereas a constraint is a named enforcement, so the only edge that needs to name one is the violation record saying which law it breached. A second such relation would let one violation blame two laws with no way to say which check actually failed." ;
    gmeow:cqResultShape ex:cqLawObjectReferentsShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:cqLawObjectReferentsRowConstraintviolatedLaw , ex:cqLawObjectReferentsRowFormulaand , ex:cqLawObjectReferentsRowFormulaantecedent , ex:cqLawObjectReferentsRowFormulaclause , ex:cqLawObjectReferentsRowFormulacompletenessFormula , ex:cqLawObjectReferentsRowFormulaconsequent , ex:cqLawObjectReferentsRowFormulaexists , ex:cqLawObjectReferentsRowFormulaforall , ex:cqLawObjectReferentsRowFormulahasFormula , ex:cqLawObjectReferentsRowFormulaiff , ex:cqLawObjectReferentsRowFormulaintegrity , ex:cqLawObjectReferentsRowFormulalawAdmits , ex:cqLawObjectReferentsRowFormulamethodApplicability , ex:cqLawObjectReferentsRowFormulanot , ex:cqLawObjectReferentsRowFormulaor , ex:cqLawObjectReferentsRowFormulaprogramQuery , ex:cqLawObjectReferentsRowFormularecoveryTransform , ex:cqLawObjectReferentsRowFormulaverdictProbe  .

ex:cqLawObjectReferentsRowConstraintviolatedLaw a gmeow:ExpectedRow ;
