gmeow:subEventOf skos:closeMatch schema:superEvent {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "X subEventOf Y ↔ X schema:superEvent Y (the super event of X is Y)"
|} .

gmeow:hasSubEvent skos:closeMatch schema:subEvent {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:hasSubEvent skos:closeMatch crm:P9_consists_of {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "CIDOC P9 consists of — event mereology"
|} .

# --------------------------------------------------------------------------- #
# Participant-role value individuals → external role properties / classes.
# These are gufo:QualityValue VALUES; closeMatch records a value↔property/class
# correspondence (a role value plays the part of the external role predicate).
# --------------------------------------------------------------------------- #

gmeow:ParticipantRole skos:relatedMatch sem:RoleType {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "the open role value vocabulary ≈ SEM role-type space"
|} .

gmeow:roleParticipantPrincipal skos:closeMatch bio:principal {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "principal-role value ↔ BIO principal property — generalizes the former gmeow:hasPrincipal subproperty"
|} .

gmeow:roleWitness skos:closeMatch bio:witness {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "witness-role value ↔ BIO witness property — generalizes the former gmeow:hasWitness subproperty"
|} .

gmeow:roleOfficiant skos:closeMatch bio:officiator {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "officiant-role value ↔ BIO officiator property — generalizes the former gmeow:hasOfficiant subproperty"
|} .

