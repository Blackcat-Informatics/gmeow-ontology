#
# Worked example — a minimal three-stage pipeline showing the spine shape the
# gmeow-pipeline loader validates: an authored-source load (holding
# gmeow:sourceOrigin), a reasoning stage (which requires the exclusive
# gmeow:engineResource), and the single serialization exit (holding
# gmeow:sinkCapability — the gts narrow waist). A stage that gmeow:requiresResource
# the engine serializes against any other stage competing for it; the Rust impl's
# resources() and capabilities() must agree with these declarations or the loader
# HARD-fails (and exactly one stage may hold gmeow:sinkCapability).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/pipeline/> .

# A gmeow:Pipeline IS a logic:Plan, so it carries the plan's success criterion: a
# goal (logic:planGoal) and a success mode (logic:planSuccessMode). The acyclic
# dataflow closure is certified under the DAG-workflow profile.
ex:goalMinimalBundle a gmeow:Goal .

ex:minimalBuild a gmeow:Pipeline ;
    logic:planGoal ex:goalMinimalBundle ;
    logic:planSuccessMode logic:StrongPlanSuccess ;
    logic:executedUnderContract logic:DagWorkflowContract ;
    gmeow:hasStage ex:load , ex:reason , ex:sink .

# Each stage IS a logic:ActionSchema, so it carries the two REQUIRED action-theory
# facets: logic:precondition (the situation gate — its inputs are available) and
# logic:capability (the executional precondition — the bound Rust Stage can run),
# both shared individuals from the pipeline module.
ex:load a gmeow:PipelineStage ;
    gmeow:hasCapability gmeow:sourceOrigin ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageStability gmeow:stabilityStablePrefix ;
    gmeow:stageCacheDisposition gmeow:cachePersistentContribution ;
    gmeow:stageImpl "source_load" .

ex:reason a gmeow:PipelineStage ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageStability gmeow:stabilityStablePrefix ;
    gmeow:stageCacheDisposition gmeow:cacheRecomputeAggregate ;
    gmeow:stageImpl "reason" ;
    gmeow:dataflowConsumes ex:load ;
    gmeow:requiresResource gmeow:engineResource .

ex:sink a gmeow:PipelineStage ;
    gmeow:hasCapability gmeow:sinkCapability ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageStability gmeow:stabilityStablePrefix ;
    gmeow:stageCacheDisposition gmeow:cachePersistentContribution ;
    gmeow:stageImpl "gts_sink" ;
    gmeow:dataflowConsumes ex:reason ;
    gmeow:producesFormat "gts" .
