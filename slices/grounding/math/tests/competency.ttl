    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "a" ; gmeow:cellValueIri exf:structA ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "b" ; gmeow:cellValueIri exf:structB ] .

# === Q12 — measure: space, total mass, and whether it is a probability measure #

ex:cqMeasureSpaceAndMass a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/measure-space-and-mass.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Each measure reports the measurable space it acts on, its total mass, and whether it is a probability measure; over the fixture the answer is exactly {coinMeasure → coinSpace, mass 1, a probability measure; lengthMeasure → lineSpace, mass +∞ (math:PositiveInfinity), not a probability measure}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqMeasureShape ;
    gmeow:cqExpectRow ex:rowCoinMeasure , ex:rowLengthMeasure .

ex:cqMeasureShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "measure" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "space" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "mass" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ,
        [ logic:columnVariable "isProbability" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowCoinMeasure a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "measure" ; gmeow:cellValueIri exf:coinMeasure ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "space" ; gmeow:cellValueIri exf:coinSpace ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "mass" ; gmeow:cellValueLiteral "1" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "isProbability" ; gmeow:cellValueLiteral "true" ] .

ex:rowLengthMeasure a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "measure" ; gmeow:cellValueIri exf:lengthMeasure ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "space" ; gmeow:cellValueIri exf:lineSpace ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "mass" ; gmeow:cellValueLiteral "https://blackcatinformatics.ca/math/PositiveInfinity" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "isProbability" ; gmeow:cellValueLiteral "false" ] .

