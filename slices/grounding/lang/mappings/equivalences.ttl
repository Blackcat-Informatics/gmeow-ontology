@prefix gmeow:     <https://blackcatinformatics.ca/gmeow/> .
@prefix lang:      <https://blackcatinformatics.ca/lang/> .
@prefix logic:     <https://blackcatinformatics.ca/logic/> .
@prefix skos:      <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv:    <https://w3id.org/semapv/vocab/> .
@prefix wd:        <http://www.wikidata.org/entity/> .
@prefix lexvo:     <http://lexvo.org/id/> .
@prefix glottolog: <https://glottolog.org/resource/languoid/id/> .
@prefix ontolex:   <http://www.w3.org/ns/lemon/ontolex#> .
@prefix ex:        <https://blackcatinformatics.ca/gmeow/examples/lang/> .

# Term equivalences (authored in-slice; source of alignment linkage).
#
# External identifiers name alignments, not identity: a GMEOW sign system, script,
# part of speech, or feature key aligns to Wikidata (the identity hub — CC0), to
# Glottolog (languoid genealogy — CC-BY 4.0), to Lexvo (the ISO 639 language-code
# and ISO 15924 script-code hub — CC-BY-SA 3.0), and to the IANA Language Subtag
# Registry (the BCP-47 authority — public IETF standard), but the GMEOW term
# remains the local source of truth. Each external standard carries its OWN
# first-class record — no single record double-counts two standards. Every object
# IRI is a real external entity, curl-validated (Principle 5): the Wikidata QIDs
# resolve to the named concepts, the Glottolog languoid resolves, the Lexvo
# ISO-code IRIs resolve, and the IANA registry resolves.
# Identity → skos:exactMatch; a genealogically-scoped or code-scoped companion →
# skos:closeMatch / skos:relatedMatch.

# --- SSSOM publication header for the BCP-47 / IANA mapping set -------------- #
# (Wikidata / Glottolog / Lexvo set headers live in dsl/mappings/mapping-sets.ttl;
# the IANA set is introduced here alongside its only linkage cell.)

gmeow:mapsetBcp47 a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-bcp47.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/bcp47" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "GMEOW sign-system → IANA Language Subtag Registry (BCP-47) alignments. A BCP-47 primary language subtag (e.g. \"en\") is registered by IANA (drawn from ISO 639); the registry resource is a code-scoped identifier, a related resource rather than identity (skos:relatedMatch). By reference, curl-validated." .

# --- English (a sign system) → Wikidata / Glottolog / ISO 639 / BCP-47 ------ #

gmeow:eqLangEnglishWikidata a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:english ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q1860 ;
    logic:sourceEndpoint lang:english ; logic:targetEndpoint wd:Q1860 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "English" ;
    gmeow:comment "lang:english is the English natural language; wd:Q1860 (English) is the same language. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    logic:morphismClass logic:WellBehavedLens ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:SoundUnderApproximation .

gmeow:eqLangEnglishGlottolog a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:english ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject glottolog:stan1293 ;
    logic:sourceEndpoint lang:english ; logic:targetEndpoint glottolog:stan1293 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "Standard English" ;
    gmeow:comment "glottolog:stan1293 (Standard English) is Glottolog's languoid for the standard variety; lang:english is the language more broadly, a close but not identical match, so skos:closeMatch." ;
    gmeow:sssomFile "gmeow-glottolog.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

gmeow:eqLangEnglishIso639 a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:english ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject lexvo:iso639-3/eng ;
    logic:sourceEndpoint lang:english ; logic:targetEndpoint lexvo:iso639-3/eng ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "eng (ISO 639-3)" ;
    gmeow:comment "lexvo:iso639-3/eng is the Lexvo resource for the ISO 639-3 code eng (ISO 639-1 en) — the ISO 639 language-code identity for English. A code-scoped identifier, a related resource rather than identity, so skos:relatedMatch." ;
    gmeow:sssomFile "gmeow-lexvo.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

gmeow:eqLangScriptWikidata a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:Script ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q8192 ;
    logic:sourceEndpoint lang:Script ; logic:targetEndpoint wd:Q8192 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "writing system" ;
    gmeow:comment "lang:Script is a first-class character repertoire (a script); wd:Q8192 (writing system) is Wikidata's class for a system of visual signs for writing. GMEOW distinguishes the bare repertoire (lang:Script) from the orthographic convention (lang:Orthography), so the match to the broader Wikidata class is close, not exact." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

gmeow:eqLangOrthographyWikidata a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:Orthography ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q43091 ;
    logic:sourceEndpoint lang:Orthography ; logic:targetEndpoint wd:Q43091 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "orthography" ;
    gmeow:comment "lang:Orthography is the sign-system→script writing convention (which script a sign system is written in, through lang:orthographyFor + lang:usesScript); wd:Q43091 (orthography) is Wikidata's class for the conventions of writing a language. A close match to the convention concept, distinct from the bare repertoire lang:Script." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

gmeow:eqLangEnglishBcp47 a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:english ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://www.iana.org/assignments/language-subtag-registry> ;
    logic:sourceEndpoint lang:english ; logic:targetEndpoint <https://www.iana.org/assignments/language-subtag-registry> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "en (BCP-47 primary language subtag)" ;
    gmeow:comment "The IANA Language Subtag Registry defines en as the BCP-47 primary language subtag for English (there is no per-subtag resolvable IRI; the registry is the authoritative resource). A code-scoped identifier, a related resource rather than identity, so skos:relatedMatch." ;
    gmeow:sssomFile "gmeow-bcp47.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

