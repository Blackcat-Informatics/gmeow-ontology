msgctxt "https://blackcatinformatics.ca/gmeow/AttentionSlot|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from AttentionSlot alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de AttentionSlot seul."

msgctxt "https://blackcatinformatics.ca/gmeow/AttentionSlot|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit AttentionSlot value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de AttentionSlot avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/AttentionSlot|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Attention Slot within an attributed recall context."
msgstr "Utiliser pour consigner Case attentionnelle dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/AttentionSlot|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Attention Slot"
msgstr "Case attentionnelle"

msgctxt "https://blackcatinformatics.ca/gmeow/AttentionSlot|http://www.w3.org/2004/02/skos/core#definition"
msgid "The continuing identity of one agent’s named attention slot. A slot is not a history position and is not itself the record it points to."
msgstr "Identité continue d’une case attentionnelle nommée d’un agent. Une case n’est ni une position historique ni le relevé qu’elle référence."

msgctxt "https://blackcatinformatics.ca/gmeow/AttentionSlot|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:AttentionSlot explicitly."
msgstr "Le relevé nomme explicitement gmeow:AttentionSlot."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallAnswer|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from RecallAnswer alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de RecallAnswer seul."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallAnswer|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit RecallAnswer value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de RecallAnswer avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallAnswer|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Recall Answer within an attributed recall context."
msgstr "Utiliser pour consigner Réponse de rappel dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallAnswer|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Recall Answer"
msgstr "Réponse de rappel"

msgctxt "https://blackcatinformatics.ca/gmeow/RecallAnswer|http://www.w3.org/2004/02/skos/core#definition"
msgid "The recall activity answering a cue, parenting its retrieval activities and retaining selected records, outcome and completeness. It is not the question or a claim that the returned material is true."
msgstr "Activité de rappel répondant à un indice, regroupant ses récupérations et conservant relevés sélectionnés, résultat et complétude. Ce n’est ni la question ni une affirmation de vérité des éléments retournés."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallAnswer|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:RecallAnswer explicitly."
msgstr "Le relevé nomme explicitement gmeow:RecallAnswer."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallBudget|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from RecallBudget alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de RecallBudget seul."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallBudget|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit RecallBudget value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de RecallBudget avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallBudget|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Recall Budget within an attributed recall context."
msgstr "Utiliser pour consigner Budget de rappel dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallBudget|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Recall Budget"
msgstr "Budget de rappel"

msgctxt "https://blackcatinformatics.ca/gmeow/RecallBudget|http://www.w3.org/2004/02/skos/core#definition"
msgid "A finite plan-local allocation roster whose operation records share one enactment’s token budget. It is not the enactment or a second plan."
msgstr "Liste finie d’allocations locale à un plan dont les opérations partagent le budget de jetons d’une exécution. Ce n’est ni l’exécution ni un second plan."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallBudget|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:RecallBudget explicitly."
msgstr "Le relevé nomme explicitement gmeow:RecallBudget."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallDepth|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from RecallDepth alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de RecallDepth seul."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallDepth|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit RecallDepth value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de RecallDepth avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallDepth|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Recall Depth within an attributed recall context."
msgstr "Utiliser pour consigner Profondeur de rappel dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallDepth|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Recall Depth"
msgstr "Profondeur de rappel"

msgctxt "https://blackcatinformatics.ca/gmeow/RecallDepth|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary of explicitly selected retrieval capability profiles. Selecting a depth requires its declared capabilities; absence never selects a weaker profile."
msgstr "Vocabulaire ouvert de profils de capacités de récupération explicitement sélectionnés. Sélectionner une profondeur exige ses capacités déclarées ; l’absence ne sélectionne jamais un profil plus faible."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallDepth|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:RecallDepth explicitly."
msgstr "Le relevé nomme explicitement gmeow:RecallDepth."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOperation|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from RecallOperation alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de RecallOperation seul."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOperation|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit RecallOperation value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de RecallOperation avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOperation|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Recall Operation within an attributed recall context."
msgstr "Utiliser pour consigner Opération de rappel dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOperation|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Recall Operation"
msgstr "Opération de rappel"

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOperation|http://www.w3.org/2004/02/skos/core#definition"
msgid "One plan-local recall operation schema with its own allocation identity and parameters. Reusing a template twice requires two operation records, each carrying its own share."
msgstr "Schéma d’opération de rappel local à un plan, avec identité d’allocation et paramètres propres. Deux usages d’un modèle exigent deux relevés d’opération portant chacun leur part."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOperation|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:RecallOperation explicitly."
msgstr "Le relevé nomme explicitement gmeow:RecallOperation."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOutcome|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from RecallOutcome alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de RecallOutcome seul."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOutcome|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit RecallOutcome value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de RecallOutcome avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOutcome|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Recall Outcome within an attributed recall context."
msgstr "Utiliser pour consigner Résultat de rappel dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOutcome|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Recall Outcome"
msgstr "Résultat de rappel"

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOutcome|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary of reported recall outcomes, separate from the asker’s judgement and the truth of recalled content."
msgstr "Vocabulaire ouvert des résultats de rappel rapportés, séparé du jugement du demandeur et de la vérité du contenu."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallOutcome|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:RecallOutcome explicitly."
msgstr "Le relevé nomme explicitement gmeow:RecallOutcome."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallScope|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from RecallScope alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de RecallScope seul."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallScope|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected specification and its source/request identity. Use SlotBoundRecallScope with actual scopeSlot anchors for the bound profile; shared parameterized scopes require their actual per-call state, packet or conversation/configuration inputs."
msgstr "Conserver la spécification sélectionnée et son identité de source ou de demande. Utiliser SlotBoundRecallScope avec des ancrages scopeSlot réels pour le profil lié ; les portées paramétrées partagées exigent leurs données réelles d’état, de paquet ou de conversation/configuration propres à l’appel."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallScope|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Recall Scope within an attributed recall context."
msgstr "Utiliser pour consigner Portée de rappel dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallScope|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Recall Scope"
msgstr "Portée de rappel"

msgctxt "https://blackcatinformatics.ca/gmeow/RecallScope|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open information-bearing specification of which records a recall operation requests under declared context bindings. Explicit attention-slot anchoring is the SlotBoundRecallScope profile."
msgstr "Une spécification ouverte porteuse d’information indiquant quels enregistrements une opération de rappel demande selon les liaisons de contexte déclarées. L’ancrage explicite dans des cases attentionnelles relève du profil SlotBoundRecallScope."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallScope|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:RecallScope explicitly."
msgstr "Le relevé nomme explicitement gmeow:RecallScope."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdictValue|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from RecallVerdictValue alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de RecallVerdictValue seul."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdictValue|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit RecallVerdictValue value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de RecallVerdictValue avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdictValue|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Recall Verdict Value within an attributed recall context."
msgstr "Utiliser pour consigner Valeur de verdict de rappel dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdictValue|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Recall Verdict Value"
msgstr "Valeur de verdict de rappel"

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdictValue|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary for the asker’s found, partly, not-found or wrong judgement. These values neither rank people nor determine objective truth."
msgstr "Vocabulaire ouvert du jugement trouvé, partiel, non trouvé ou erroné du demandeur. Ces valeurs ne classent pas les personnes et ne déterminent pas la vérité objective."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdictValue|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:RecallVerdictValue explicitly."
msgstr "Le relevé nomme explicitement gmeow:RecallVerdictValue."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdict|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from RecallVerdict alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de RecallVerdict seul."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdict|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit RecallVerdict value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de RecallVerdict avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdict|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Recall Verdict within an attributed recall context."
msgstr "Utiliser pour consigner Verdict de rappel dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdict|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Recall Verdict"
msgstr "Verdict de rappel"

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdict|http://www.w3.org/2004/02/skos/core#definition"
msgid "The asker’s attributed judgement of one recall answer, preserving its exact words independently of search completeness."
msgstr "Jugement attribué du demandeur sur une réponse de rappel, conservant ses mots exacts indépendamment de la complétude."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallVerdict|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:RecallVerdict explicitly."
msgstr "Le relevé nomme explicitement gmeow:RecallVerdict."

msgctxt "https://blackcatinformatics.ca/gmeow/RecalledRecordClaim|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from RecalledRecordClaim alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de RecalledRecordClaim seul."

msgctxt "https://blackcatinformatics.ca/gmeow/RecalledRecordClaim|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit RecalledRecordClaim value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de RecalledRecordClaim avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/RecalledRecordClaim|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Recalled Record Claim within an attributed recall context."
msgstr "Utiliser pour consigner Affirmation de relevé rappelé dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/RecalledRecordClaim|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Recalled Record Claim"
msgstr "Affirmation de relevé rappelé"

msgctxt "https://blackcatinformatics.ca/gmeow/RecalledRecordClaim|http://www.w3.org/2004/02/skos/core#definition"
msgid "An RDF 1.2 reifier of one recalledRecord assertion, retaining its answer-specific rank and attribution."
msgstr "Réificateur RDF 1.2 d’une assertion recalledRecord, conservant rang propre à la réponse et attribution."

msgctxt "https://blackcatinformatics.ca/gmeow/RecalledRecordClaim|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:RecalledRecordClaim explicitly."
msgstr "Le relevé nomme explicitement gmeow:RecalledRecordClaim."

msgctxt "https://blackcatinformatics.ca/gmeow/RecollectionForm|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from RecollectionForm alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de RecollectionForm seul."

msgctxt "https://blackcatinformatics.ca/gmeow/RecollectionForm|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit RecollectionForm value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de RecollectionForm avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/RecollectionForm|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Recollection Form within an attributed recall context."
msgstr "Utiliser pour consigner Forme de remémoration dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/RecollectionForm|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Recollection Form"
msgstr "Forme de remémoration"

msgctxt "https://blackcatinformatics.ca/gmeow/RecollectionForm|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary describing how recalled material is presented, independently of retrieval depth and confidence."
msgstr "Vocabulaire ouvert décrivant la présentation des éléments rappelés, indépendamment de la profondeur de récupération et de la confiance."

msgctxt "https://blackcatinformatics.ca/gmeow/RecollectionForm|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:RecollectionForm explicitly."
msgstr "Le relevé nomme explicitement gmeow:RecollectionForm."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotAssignmentClaim|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from SlotAssignmentClaim alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de SlotAssignmentClaim seul."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotAssignmentClaim|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit SlotAssignmentClaim value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de SlotAssignmentClaim avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotAssignmentClaim|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Slot Assignment Claim within an attributed recall context."
msgstr "Utiliser pour consigner Affirmation d’affectation de case dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotAssignmentClaim|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Slot Assignment Claim"
msgstr "Affirmation d’affectation de case"

msgctxt "https://blackcatinformatics.ca/gmeow/SlotAssignmentClaim|http://www.w3.org/2004/02/skos/core#definition"
msgid "An attributed RDF 1.2 reifier of one slotState assertion. Successor claims name the claims they supersede; records and historical claims are retained."
msgstr "Réificateur RDF 1.2 attribué d’une assertion slotState. Les affirmations suivantes nomment celles qu’elles remplacent ; relevés et affirmations historiques sont conservés."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotAssignmentClaim|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:SlotAssignmentClaim explicitly."
msgstr "Le relevé nomme explicitement gmeow:SlotAssignmentClaim."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotPosition|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from SlotPosition alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de SlotPosition seul."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotPosition|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit SlotPosition value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de SlotPosition avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotPosition|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record Slot Position within an attributed recall context."
msgstr "Utiliser pour consigner Position de case dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotPosition|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Slot Position"
msgstr "Position de case"

msgctxt "https://blackcatinformatics.ca/gmeow/SlotPosition|http://www.w3.org/2004/02/skos/core#definition"
msgid "An immutable position in one attention slot’s history, holding a pointer to an existing record. It specializes State as a path position rather than a mutable slot."
msgstr "Position immuable dans l’historique d’une case attentionnelle, portant un pointeur vers un relevé existant. Elle spécialise State comme position sur un chemin et non comme case mutable."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotPosition|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:SlotPosition explicitly."
msgstr "Le relevé nomme explicitement gmeow:SlotPosition."

msgctxt "https://blackcatinformatics.ca/gmeow/answerDepth|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from answerDepth alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de answerDepth seul."

msgctxt "https://blackcatinformatics.ca/gmeow/answerDepth|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit answerDepth value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de answerDepth avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/answerDepth|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record answer depth within an attributed recall context."
msgstr "Utiliser pour consigner profondeur de réponse dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/answerDepth|http://www.w3.org/2000/01/rdf-schema#label"
msgid "answer depth"
msgstr "profondeur de réponse"

msgctxt "https://blackcatinformatics.ca/gmeow/answerDepth|http://www.w3.org/2004/02/skos/core#definition"
msgid "The recall capability profile actually reported for this answer, distinct from the schema’s requested profile."
msgstr "Profil de capacités de rappel effectivement rapporté pour cette réponse, distinct du profil demandé par le schéma."

msgctxt "https://blackcatinformatics.ca/gmeow/answerDepth|http://www.w3.org/2004/02/skos/core#example"
msgid "The record names gmeow:answerDepth explicitly."
msgstr "Le relevé nomme explicitement gmeow:answerDepth."

msgctxt "https://blackcatinformatics.ca/gmeow/budgetForPlan|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring successful execution, access permission or a preferred claim from budgetForPlan alone."
msgstr "Éviter de déduire une exécution réussie, une permission d’accès ou une affirmation préférée de budgetForPlan seul."

msgctxt "https://blackcatinformatics.ca/gmeow/budgetForPlan|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit budgetForPlan value with its source, scope and record identity."
msgstr "Conserver la valeur explicite de budgetForPlan avec sa source, sa portée et l’identité du relevé."

msgctxt "https://blackcatinformatics.ca/gmeow/budgetForPlan|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record budget for plan within an attributed recall context."
msgstr "Utiliser pour consigner budget pour le plan dans un contexte de rappel attribué."

msgctxt "https://blackcatinformatics.ca/gmeow/budgetForPlan|http://www.w3.org/2000/01/rdf-schema#label"
msgid "budget for plan"
msgstr "budget pour le plan"

msgctxt "https://blackcatinformatics.ca/gmeow/budgetForPlan|http://www.w3.org/2004/02/skos/core#definition"
