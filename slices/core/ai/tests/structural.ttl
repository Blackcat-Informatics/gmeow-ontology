#
# Declarative structural assertions for the AI slice. Each assertion runs as a
# SPARQL ASK over ai/module.ttl under the native Rust slicetest harness.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/ai/tests/> .

ex:saMemoryItemIsClaimRole a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:MemoryItem a owl:Class , logic:Role ;
        logic:subClassOf gmeow:Observation .
}""" ;
    gmeow:saRationale "gmeow:MemoryItem MUST be a logic:Role on the universal Observation claim construct. Replaces the stale gufo:Role assertion." .

ex:saContradictionIsOpenClaimRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:Contradiction logic:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:Contradiction MUST be a logic:Relator surfacing claim conflict without choosing a winner. Replaces the stale gufo:Relator assertion." .

ex:saContradictsClaimRangeOpen a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:contradictsClaim rdfs:range ?range . }""" ;
    gmeow:saRationale "gmeow:contradictsClaim MUST NOT have an rdfs:range; the claim node form is intentionally open across StandpointClaims, Observations, and statement reifiers." .

# --- Migrated from tests/test_ai_claims.py --------------------------------

# test_extraction_methods_are_observation_methods
ex:saExtractionMethodsAreObservationMethods a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:methodLlmExtraction a gmeow:ObservationMethod .
    gmeow:methodNliDerivation a gmeow:ObservationMethod .
}""" ;
    gmeow:saRationale "The AI slice's extraction methods (methodLlmExtraction, methodNliDerivation) MUST be typed gmeow:ObservationMethod — claims are observations and their production method is observationMethod (Principle 9, unified observation stance)." .

# test_invocation_and_retrieval_are_activities (ModelInvocation half; RetrievalEvent half is below, both live in ai)
ex:saModelInvocationIsActivity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:ModelInvocation a owl:Class ;
        logic:subClassOf gmeow:Activity .
}""" ;
    gmeow:saRationale "gmeow:ModelInvocation MUST be an owl:Class subclass of gmeow:Activity — the model call is an occurrent activity whose outputs link back via wasGeneratedBy (Principle 5)." .

# --- Promoted from extensions/graphrag (shared vector/embedding primitives) --

# test_invocation_and_retrieval_are_activities (RetrievalEvent half; ModelInvocation half is above)
ex:saRetrievalEventIsActivity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:RetrievalEvent a owl:Class ;
        logic:subClassOf gmeow:Activity .
}""" ;
    gmeow:saRationale "gmeow:RetrievalEvent MUST be an owl:Class subclass of gmeow:Activity — a retrieval episode is an occurrent activity in the GraphRAG provenance chain, reused by any embedding consumer that runs retrieval." .

# The vector/embedding primitive Kinds (MUST hold)
ex:saVectorEmbeddingKinds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:Embedding            a owl:Class , logic:Kind ; logic:subClassOf gmeow:InformationObject .
    gmeow:VectorIndex          a owl:Class , logic:Kind ; logic:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "The shared vector/embedding primitives MUST be logic:Kind gmeow:InformationObjects — core-tier infrastructure reused by extensions/graphrag and extensions/embedding-projection alike, never redeclared per extension." .

# Distance-metric value vocabulary + seeds (MUST hold)
ex:saDistanceMetricValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:DistanceMetric a owl:Class , logic:AbstractIndividualType ; logic:subClassOf logic:QualityValue .
    gmeow:distanceMetricCosine a gmeow:DistanceMetric . gmeow:distanceMetricDotProduct a gmeow:DistanceMetric .
    gmeow:distanceMetricEuclidean a gmeow:DistanceMetric .
}""" ;
    gmeow:saRationale "gmeow:DistanceMetric MUST be a QualityValue vocabulary with its seeds present: distance metrics {cosine, dot-product, euclidean} — reused by both extensions/graphrag's retrieval substrate and extensions/embedding-projection's comparable vector spaces." .

# Distance-metric value vocabulary is individuals, never subclasses (MUST-NOT hold)
ex:saDistanceMetricNotSubclassed a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    { ?c logic:subClassOf gmeow:DistanceMetric }
    UNION
    { ?c rdfs:subClassOf gmeow:DistanceMetric }
    FILTER (?c != gmeow:DistanceMetric)
}""" ;
    gmeow:saRationale "The QualityValue idiom: gmeow:DistanceMetric is a vocabulary of individuals, never per-value subclasses — the slice MUST NOT declare any subclass of it. New metrics extend the vocabulary as individuals. Both the canonical logic:subClassOf spelling and its rdfs:subClassOf projection are ruled out, so the prohibition cannot be evaded by choosing a surface." .

# The single-valued embedding edges' declared shapes (MUST hold)
ex:saEmbeddingFunctionalEdges a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:embeddingOf a owl:ObjectProperty ; rdfs:domain gmeow:Embedding ; rdfs:range gmeow:InformationObject .
    gmeow:embeddingModel a owl:ObjectProperty ; rdfs:domain gmeow:Embedding ; rdfs:range gmeow:SoftwareAgent .
}""" ;
    gmeow:saRationale "The single-valued embedding edges MUST carry their declared domains/ranges: an embedding embeds one object and one model. Their single-valued (functional) characteristic is asserted on the logic:PropertyCharacteristicAssertion carrier and enforced by the DL reasoner, not in the slice module." .
