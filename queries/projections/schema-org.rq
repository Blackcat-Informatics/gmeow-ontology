# Projection: GMEOW → pure schema-org. GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: GMEOW AccessibilityFacet individuals are emitted as IRIs; schema.org expects specific text tokens (wheelchairAccessible, stepFreeAccess, etc.). The consumer must map IRIs to tokens.; GMEOW AccessibilityFacet individuals are emitted as IRIs; schema.org expects specific text tokens (flashingHazard, motionSimulationHazard, soundHazard, etc.). The consumer must map IRIs to tokens.; the typed stepInput collapses to a flat schema:supply edge; the typed stepInput collapses to a flat schema:tool edge when the input is a physical object; the typed stepOutput collapses to a flat schema:result edge; schema.org has no plan/execution de-conflation; the Execution is projected as a flat Action; precise coordinates coarsened to the enclosing region at gmeow:coarsenTo level (privacy generalization, P10); the specialized GMEOW parthood subproperty, if any, is collapsed to generic schema:isPartOf; the specialized GMEOW whole-to-part subproperty, if any, is collapsed to generic schema:hasPart; authority provenance, confidence, standpoint, and exact-vs-close match distinction collapse to a schema.org identity URL; skos:closeMatch authority links are not emitted; projection frame = endonym-preferred; co-equal exonyms projected as schema:alternateName; non-displayable/superseded and competing-standpoint names dropped; exonym selection is locale-relative; competing-standpoint names and names with specific purposes dropped; the NetworkAddress frame, type, provenance, and standpoint are dropped; only the URL string survives; the postal reference frame (axes, topological kind, metric) is dropped; only the flat schema:PostalAddress component values survive; non-displayable names (deadnames) dropped; orientation + sexAssignedAtBirth dropped; sex/gender conflated; Glottocodes excluded; only 2-3 letter primary subtags; CEFR/ILR/ACTFL level and skill modality dropped; the birth Participation (role, period, confidence, standpoint) and fuzzy-date bounds are dropped; only the principal's birth instant survives as schema:birthDate; the Membership relator (organization, period, role, confidence, standpoint) collapses to a flat schema:jobTitle literal; contested membership claims are not distinguished; the subOrganizationOf hierarchy and any contested succession/standpoint claims collapse to a flat schema:department edge; the Participation's period / confidence / evidence / standpoint collapse to a flat schema:attendee edge; the Participation's period / confidence / evidence / standpoint collapse to a flat schema:performer edge; the Participation's period / confidence / evidence / standpoint collapse to a flat schema:organizer edge; the uncertainty band (gmeow:latestEnd) and the gmeow:temporalPrecision qualifier are dropped; only the earliest bound survives as a single schema:startDate; the Copyright relator (year, notice, status) collapses to a flat schema:copyrightHolder edge; the Copyright relator (holder, notice, status) collapses to a flat schema:copyrightYear edge; the structured Copyright relator (holder, year, status) collapses to a flat schema:copyrightNotice edge; GMEOW Route is domain-generic; schema:Trip is travel-specific. RouteKind, start, end, and via metadata are dropped.; the creation event's place, participants, and standpoint are dropped; only the instant survives as schema:foundingDate; the destruction event's place, participants, and standpoint are dropped; only the instant survives as schema:dissolutionDate; the Capacity relator (provenance, unit, temporal scope, standpoint) collapses to a flat schema:maximumAttendeeCapacity integer; non-displayable/superseded capacities are suppressed; restricted to gmeow:Place to avoid projecting byte capacities from StorageLocation; the Occupancy relator (provenance, unit, temporal scope, standpoint) collapses to a flat schema:occupancy integer; non-displayable/superseded occupancies are suppressed; restricted to gmeow:Place to avoid projecting byte occupancies from StorageLocation; the location's type distinction (Place vs VirtualLocation vs StorageLocation) is preserved by the target node's own rdf:type projection, but the locatedAt relation itself loses the structural subproperty (storedIn, physicalPlace); namePurpose (endonym/exonym/superseded) is ignored; every displayable name is emitted as schema:name. The consumer receives all co-equal claims without privileging.; the CoordinateObservation relator (vantage, confidence, reference frame, temporal scope) collapses to a flat schema:geo edge; non-displayable/superseded observations are suppressed; description withheld when entity is not explicitly eligible for consumerPublicSite; tag IRI lost; only label text emitted; displayable false tags suppressed; tagger, scheme, interval, confidence, provenance dropped; only tag label survives; standpoint, confidence, temporal scope, suppression state, aboutness, tagging dropped; Comment-specific typing collapsed to schema:NoteDigitalDocument (rdflib UNION limit).
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <https://schema.org/>

CONSTRUCT {
    ?place schema:accessibilityFeature ?featureFacet .
    ?place schema:accessibilityHazard ?hazardFacet .
    ?proc a schema:HowTo .
    ?recipe a schema:Recipe .
    ?step a schema:HowToStep .
    ?proc schema:step ?step .
    ?step schema:supply ?inp .
    ?step schema:tool ?tool .
    ?step schema:result ?out .
    ?exec a schema:Action .
    ?place a schema:Place .
    ?place schema:containedInPlace ?parent .
    ?place schema:geo ?coords .
    ?coords a schema:GeoCoordinates .
    ?coords schema:latitude ?lat .
    ?coords schema:longitude ?lon .
    ?coords schema:elevation ?elev .
    ?place schema:geo ?coarseGeo .
    ?coarseGeo a schema:GeoCoordinates .
    ?coarseGeo schema:latitude ?lat .
    ?coarseGeo schema:longitude ?lon .
    ?part schema:isPartOf ?whole .
    ?whole schema:hasPart ?part .
    ?ent schema:sameAs ?auth .
    ?place a ?ptClass .
    ?place schema:name ?endo .
    ?place schema:alternateName ?exo .
    ?place schema:name ?name .
    ?vl a schema:VirtualLocation .
    ?vl schema:url ?vurl .
    ?vl schema:url ?nval .
    ?holder schema:address ?addr .
    ?addr a schema:PostalAddress .
    ?addr schema:streetAddress ?street .
    ?addr schema:addressLocality ?locality .
    ?addr schema:addressRegion ?region .
    ?addr schema:postalCode ?pcode .
    ?addr schema:addressCountry ?ccode .
    ?ent schema:name ?_final_dispName .
    ?ent schema:givenName ?_final_given .
    ?ent schema:familyName ?_final_family .
    ?ent schema:gender ?genderLabel .
    ?ent schema:honorificPrefix ?honPrefix .
    ?ent schema:honorificSuffix ?honSuffix .
    ?lang a schema:Language .
    ?prog a schema:ComputerLanguage .
    ?lang schema:alternateName ?bcp47 .
    ?knower schema:knowsLanguage ?known .
    ?ent schema:url ?wp .
    ?ent schema:alternateName ?nick .
    ?person schema:birthDate ?bdate .
    ?member schema:jobTitle ?title .
    ?parent schema:department ?dept .
    ?attEvent schema:attendee ?attendee .
    ?perfEvent schema:performer ?performer .
    ?orgEvent schema:organizer ?organizer .
    ?event schema:startDate ?start .
    ?work schema:license ?lic .
    ?cw schema:copyrightHolder ?holder .
    ?cw schema:copyrightYear ?yr .
    ?cw schema:copyrightNotice ?notice .
    ?ent schema:creditText ?credit .
    ?mark a schema:Brand .
    ?ent schema:isAccessibleForFree ?free .
    ?ent schema:acquireLicensePage ?alp .
    ?ent schema:usageInfo ?ui .
    ?ent schema:conditionsOfAccess ?coa .
    ?route a schema:Trip .
    ?org schema:foundingDate ?fdate .
    ?org schema:dissolutionDate ?ddate .
    ?place schema:maximumAttendeeCapacity ?capVal .
    ?place schema:occupancy ?occVal .
    ?ent schema:location ?loc .
    ?place schema:name ?allName .
    ?ent schema:description ?_final_desc .
    ?ent schema:keywords ?kw .
    ?note a schema:NoteDigitalDocument .
    ?note schema:text ?content .
    ?note schema:author ?author .
    ?note schema:parentItem ?parent .
}
WHERE {
    {
        ?place gmeow:hasAccessibilityFeature ?featureFacet .
        FILTER NOT EXISTS { ?place gmeow:displayable false . }
    }
    UNION {
        ?place gmeow:hasBarrier ?hazardFacet .
        FILTER NOT EXISTS { ?place gmeow:displayable false . }
    }
    UNION {
        ?proc a gmeow:Procedure .
        OPTIONAL { ?proc gmeow:procedureType gmeow:procedureTypeRecipe . }
    }
    UNION {
        ?recipe a gmeow:Procedure .
        ?recipe gmeow:procedureType gmeow:procedureTypeRecipe .
    }
    UNION {
        ?step a gmeow:ProcedureStep .
    }
    UNION {
        ?proc gmeow:hasProcedureStep ?step .
    }
    UNION {
        ?step gmeow:stepInput ?inp .
    }
    UNION {
        ?step gmeow:stepInput ?tool .
        ?tool a gmeow:PhysicalObject .
    }
    UNION {
        ?step gmeow:stepOutput ?out .
    }
    UNION {
        ?exec a gmeow:Execution .
    }
    UNION {
        ?place a gmeow:Place .
        OPTIONAL { ?place gmeow:containedInPlace ?parent . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:hasCoordinates ?coords .
        OPTIONAL {
            ?coords gmeow:latitude ?lat .
        }
        OPTIONAL {
            ?coords gmeow:longitude ?lon .
        }
        OPTIONAL {
            ?coords gmeow:elevation ?elev .
        }
        FILTER NOT EXISTS { ?place gmeow:coarsenTo ?anyLvl . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:coarsenTo ?lvl .
        ?place gmeow:containedInPlace+ ?coarse .
        ?coarse gmeow:hasGranularity ?lvl .
        ?coarse gmeow:hasCoordinates ?ccoords .
        OPTIONAL {
            ?ccoords gmeow:latitude ?lat .
        }
        OPTIONAL {
            ?ccoords gmeow:longitude ?lon .
        }
        BIND ( IRI(CONCAT(STR(?place), "-geo-coarsened")) AS ?coarseGeo )
    }
    UNION {
        ?part ?partPredicate ?whole .
        ?partPredicate rdfs:subPropertyOf* gmeow:partOf .
    }
    UNION {
        ?whole ?hasPartPredicate ?part .
        ?hasPartPredicate rdfs:subPropertyOf* gmeow:hasPart .
    }
    UNION {
        ?ent gmeow:authorityLink ?auth .
        ?ent skos:exactMatch ?auth .
    }
    UNION {
        ?place gmeow:placeType ?pt .
        VALUES ( ?pt ?ptClass ) {
            ( gmeow:placeTypeCountry schema:Country )
            ( gmeow:placeTypeCity schema:City )
            ( gmeow:placeTypeAdministrativeArea schema:AdministrativeArea )
            ( gmeow:placeTypeRegion schema:AdministrativeArea )
        }
    }
    UNION {
        ?place gmeow:hasPlaceName ?pn .
        ?pn gmeow:namePurpose gmeow:namePurposeEndonym .
        ?pn gmeow:fullName ?endo .
        FILTER NOT EXISTS { ?pn gmeow:displayable false . }
    }
    UNION {
        ?place gmeow:hasPlaceName ?pnx .
        ?pnx gmeow:namePurpose gmeow:namePurposeExonym .
        ?pnx gmeow:fullName ?exo .
        FILTER NOT EXISTS { ?pnx gmeow:displayable false . }
    }
    UNION {
        ?place gmeow:hasPlaceName ?pn .
        ?pn gmeow:fullName ?name .
        FILTER NOT EXISTS { ?pn gmeow:displayable false . }
        FILTER NOT EXISTS { ?pn gmeow:namePurpose ?anyPurpose . }
    }
    UNION {
        ?vl a gmeow:VirtualLocation .
        OPTIONAL { ?vl gmeow:accessUrl ?vurl . }
    }
    UNION {
        ?vl a gmeow:VirtualLocation .
        ?vl gmeow:hasNetworkAddress ?na .
        ?na gmeow:networkAddressType gmeow:networkAddressTypeURL .
        ?na gmeow:networkAddressValue ?nval .
    }
    UNION {
        ?holder gmeow:hasContactPoint ?addr .
        ?addr a gmeow:PostalAddress .
        OPTIONAL { ?addr gmeow:streetAddress ?street . }
        OPTIONAL { ?addr gmeow:addressLocality ?locality . }
        OPTIONAL { ?addr gmeow:addressRegion ?region . }
        OPTIONAL { ?addr gmeow:postalCode ?pcode . }
        OPTIONAL { ?addr gmeow:countryCode ?ccode . }
    }
    UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName|gmeow:hasOrganizationName|gmeow:hasTitle|gmeow:hasAgreementName|gmeow:hasSoftwareName ?app .
        ?app gmeow:fullName ?dispName .
        FILTER NOT EXISTS { ?app gmeow:displayable false . }
        OPTIONAL {
            ?app gmeow:nameLanguage ?_lang .
            ?_lang gmeow:languageTag ?_intTag .
            FILTER(isLiteral(?dispName) && LANG(?dispName) = ?_intTag)
            ?_lang gmeow:bcp47Tag ?_extTag .
            OPTIONAL { ?app gmeow:nameScript ?_sc . }
        }
        BIND ( IF(BOUND(?_extTag), STRLANG(STR(?dispName), IF(BOUND(?_sc), CONCAT(STR(?_extTag), '-', ?_sc), STR(?_extTag))), ?dispName) AS ?_final_dispName )
    }
    UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName|gmeow:hasOrganizationName|gmeow:hasTitle|gmeow:hasAgreementName|gmeow:hasSoftwareName ?app .
        ?app gmeow:hasNamePart ?np .
        ?np gmeow:namePartType gmeow:namePartGiven .
        ?np gmeow:partText ?given .
        FILTER NOT EXISTS { ?app gmeow:displayable false . }
        OPTIONAL {
            ?app gmeow:nameLanguage ?_lang .
            ?_lang gmeow:languageTag ?_intTag .
            FILTER(isLiteral(?given) && LANG(?given) = ?_intTag)
            ?_lang gmeow:bcp47Tag ?_extTag .
            OPTIONAL { ?app gmeow:nameScript ?_sc . }
        }
        BIND ( IF(BOUND(?_extTag), STRLANG(STR(?given), IF(BOUND(?_sc), CONCAT(STR(?_extTag), '-', ?_sc), STR(?_extTag))), ?given) AS ?_final_given )
    }
    UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName|gmeow:hasOrganizationName|gmeow:hasTitle|gmeow:hasAgreementName|gmeow:hasSoftwareName ?app .
        ?app gmeow:hasNamePart ?np .
        ?np gmeow:namePartType gmeow:namePartSurname .
        ?np gmeow:partText ?family .
        FILTER NOT EXISTS { ?app gmeow:displayable false . }
        OPTIONAL {
            ?app gmeow:nameLanguage ?_lang .
            ?_lang gmeow:languageTag ?_intTag .
            FILTER(isLiteral(?family) && LANG(?family) = ?_intTag)
            ?_lang gmeow:bcp47Tag ?_extTag .
            OPTIONAL { ?app gmeow:nameScript ?_sc . }
        }
        BIND ( IF(BOUND(?_extTag), STRLANG(STR(?family), IF(BOUND(?_sc), CONCAT(STR(?_extTag), '-', ?_sc), STR(?_extTag))), ?family) AS ?_final_family )
    }
    UNION {
        ?ent gmeow:hasGenderIdentity ?gi .
        ?gi gmeow:genderValue ?gv .
        ?gv rdfs:label ?genderLabel .
        FILTER NOT EXISTS { ?gi gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:honorific ?h .
        ?h rdfs:label ?honPrefix .
        ?h gmeow:honorificPosition gmeow:honorificPositionPrefix .
    }
    UNION {
        ?ent gmeow:honorific ?h .
        ?h rdfs:label ?honSuffix .
        ?h gmeow:honorificPosition gmeow:honorificPositionSuffix .
    }
    UNION {
        ?lang rdf:type/rdfs:subClassOf* gmeow:Language .
    }
    UNION {
        ?prog a gmeow:ProgrammingLanguage .
    }
    UNION {
        ?lang rdf:type/rdfs:subClassOf* gmeow:Language .
        ?lang gmeow:languageCode ?code .
        OPTIONAL {
            ?lang gmeow:usesWritingSystem ?ws .
            ?ws gmeow:scriptCode ?sc .
        }
        BIND ( IF(BOUND(?sc), CONCAT(STR(?code), "-", STR(?sc)), STR(?code)) AS ?bcp47 )
        FILTER NOT EXISTS { ?lang rdf:type/rdfs:subClassOf* gmeow:FormalLanguage . }
        FILTER( regex(STR(?code), "^[a-zA-Z]{2,3}$") )
    }
    UNION {
        ?knower gmeow:knowsLanguage ?known .
    }
    UNION {
        ?prof a gmeow:LanguageProficiency .
        ?prof gmeow:proficiencyAgent ?knower .
        ?prof gmeow:proficiencyLanguage ?known .
    }
    UNION {
        ?ent gmeow:hasWebPage ?wp .
    }
    UNION {
        ?ent gmeow:hasName ?nname .
        ?nname gmeow:namePurpose gmeow:namePurposeNickname .
        ?nname gmeow:fullName ?nick .
        FILTER NOT EXISTS { ?nname gmeow:displayable false . }
    }
    UNION {
        ?birth gmeow:eventType gmeow:eventTypeBirth .
        ?p gmeow:participationEvent ?birth .
        ?p gmeow:participationRole gmeow:roleParticipantPrincipal .
        ?p gmeow:participationParticipant ?person .
        ?birth gmeow:eventTime ?bdate .
    }
    UNION {
        ?m a gmeow:Membership .
        ?m gmeow:membershipMember ?member .
        ?m gmeow:hasRole ?role .
        ?role rdfs:label|gmeow:name ?title .
    }
    UNION {
        ?dept gmeow:subOrganizationOf ?parent .
    }
    UNION {
        ?pAtt gmeow:participationEvent ?attEvent .
        ?pAtt gmeow:participationRole gmeow:roleAttendee .
        ?pAtt gmeow:participationParticipant ?attendee .
        FILTER NOT EXISTS { ?pAtt gmeow:displayable false . }
    }
    UNION {
        ?pPerf gmeow:participationEvent ?perfEvent .
        ?pPerf gmeow:participationRole gmeow:rolePerformer .
        ?pPerf gmeow:participationParticipant ?performer .
        FILTER NOT EXISTS { ?pPerf gmeow:displayable false . }
    }
    UNION {
        ?pOrg gmeow:participationEvent ?orgEvent .
        ?pOrg gmeow:participationRole gmeow:roleOrganizer .
        ?pOrg gmeow:participationParticipant ?organizer .
        FILTER NOT EXISTS { ?pOrg gmeow:displayable false . }
    }
    UNION {
        ?event gmeow:earliestStart ?start .
    }
    UNION {
        ?work gmeow:hasLicense ?lic .
    }
    UNION {
        ?cw gmeow:hasCopyright ?cr .
        ?cr gmeow:copyrightHolder ?holder .
    }
    UNION {
        ?cw gmeow:hasCopyright ?cr .
        ?cr gmeow:copyrightYear ?yr .
    }
    UNION {
        ?cw gmeow:hasCopyright ?cr .
        ?cr gmeow:copyrightNotice ?notice .
    }
    UNION {
        ?ent gmeow:attributionText ?credit .
    }
    UNION {
        ?mark a gmeow:Mark .
    }
    UNION {
        ?ent gmeow:isAccessibleForFree ?free .
    }
    UNION {
        ?ent gmeow:acquireLicensePage ?alp .
    }
    UNION {
        ?ent gmeow:usageInfo ?ui .
    }
    UNION {
        ?ent gmeow:conditionsOfAccess ?coa .
    }
    UNION {
        ?route a gmeow:Route .
    }
    UNION {
        ?org a gmeow:Organization .
        ?org gmeow:hasCreationEvent ?cevent .
        ?cevent gmeow:eventTime ?fdate .
    }
    UNION {
        ?org a gmeow:Organization .
        ?org gmeow:hasDestructionEvent ?devent .
        ?devent gmeow:eventTime ?ddate .
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:hasCapacity ?cap .
        ?cap gmeow:observationResult ?sq .
        ?sq gmeow:quantityValue ?capVal .
        FILTER NOT EXISTS { ?cap gmeow:displayable false . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:hasOccupancy ?occ .
        ?occ gmeow:observationResult ?sq2 .
        ?sq2 gmeow:quantityValue ?occVal .
        FILTER NOT EXISTS { ?occ gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:locatedAt ?loc .
    }
    UNION {
        ?place gmeow:hasPlaceName ?pn .
        ?pn gmeow:fullName ?allName .
        FILTER NOT EXISTS { ?pn gmeow:displayable false . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:hasCoordinateObservation ?obs .
        ?obs gmeow:coordinateResult ?coords .
        OPTIONAL {
            ?coords gmeow:latitude ?lat .
        }
        OPTIONAL {
            ?coords gmeow:longitude ?lon .
        }
        OPTIONAL {
            ?coords gmeow:elevation ?elev .
        }
        FILTER NOT EXISTS { ?place gmeow:coarsenTo ?anyLvl . }
        FILTER NOT EXISTS { ?obs gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:description ?desc .
        FILTER EXISTS { ?ent gmeow:eligibleForConsumer gmeow:consumerPublicSite . }
        OPTIONAL {
            ?_lang gmeow:languageTag ?_intTag .
            FILTER(isLiteral(?desc) && LANG(?desc) = ?_intTag)
            ?_lang gmeow:bcp47Tag ?_extTag .
        }
        BIND ( IF(BOUND(?_extTag), STRLANG(STR(?desc), STR(?_extTag)), ?desc) AS ?_final_desc )
    }
    UNION {
        ?ent gmeow:hasTag ?tag .
        ?tag rdfs:label ?kw .
        FILTER NOT EXISTS { ?tag gmeow:displayable false . }
    }
    UNION {
        ?tagging a gmeow:Tagging .
        ?tagging gmeow:taggingTagged ?ent .
        ?tagging gmeow:taggingTag ?tag .
        ?tag rdfs:label ?kw .
        FILTER NOT EXISTS { ?tagging gmeow:displayable false . }
        FILTER NOT EXISTS { ?tag gmeow:displayable false . }
    }
    UNION {
        ?note a gmeow:Note .
        OPTIONAL { ?note gmeow:noteContent ?content . }
        OPTIONAL { ?note gmeow:noteAuthor ?author . }
        OPTIONAL { ?note gmeow:commentParent ?parent . }
        FILTER NOT EXISTS { ?note gmeow:displayable false . }
    }
}
