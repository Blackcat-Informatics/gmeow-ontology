gmeow:SupportNotSelfConstraint
    a logic:CrossNodeConstraint ;
    rdfs:label "Support-not-self constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Support's gmeow:supportSource and gmeow:supportTarget never bind the same value — support is irreflexive."@x-gmeow-english ;
    logic:onClass gmeow:Support ;
    logic:roleA gmeow:supportSource ;
    logic:roleB gmeow:supportTarget ;
    logic:crossMode "differ" ;
    logic:formalizes gmeow:Support ;
    logic:message "A Support must not support itself (gmeow:supportSource = gmeow:supportTarget) — support is irreflexive." .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.
#   logic:RelatumDistinctnessAssertion — the two logic:distinctnessRole values must bind distinct relata on one focus node.
#   logic:ConditionalRangeAssertion — a named logic:conditionalRangeSelector value forces the constrained relatum's type.
#   logic:RoleCompositionExclusionAssertion — the two named roles must not stand in a whole/part composition.

gmeow:acceptanceStatusFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "acceptanceStatus is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:acceptanceStatus is functional: a gmeow:ArgumentEvaluation assigns its argument exactly one Dung label (in, out, or undecided), since one evaluation under one semantics settles on a single status and credulous multiplicity is carried by separate evaluations."@x-gmeow-english ;
    logic:characterizes gmeow:acceptanceStatus ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:acceptanceStatus ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:acceptanceStatus names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:acceptanceStatus, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:acceptanceStatusFunctionality logic:characterizes gmeow:acceptanceStatus ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
