# Source-attributed rationale and operation completion.

gmeow:statedRationale
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/record-metadata> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "stated rationale"@x-gmeow-english ;
    skos:definition "A source's verbatim stated reason for the record or claim bearing it. The wording is an attributed explanation, not a computed cause, independently verified fact or proof that the explanation is true."@x-gmeow-english ;
    gmeow:useWhen "Use when a source supplies a reason on an event, information record or exact statement reifier without a narrower applicable rationale relation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing an unstated reason, converting explanation text into causation or forcing its bearer into Entity through description."@x-gmeow-english ;
    gmeow:howToUse "Preserve exact text and supplied language or RDF 1.2 base direction. Keep writer and standpoint attribution on the original statement when supplied; specialized rationale statements retain their own source identity."@x-gmeow-english ;
    skos:scopeNote "The property has no domain or description superproperty and is nonfunctional. Untagged source strings and competing attributed explanations remain valid; an inferred general rationale is not a newly authored source assertion."@x-gmeow-english ;
    skos:example "An event keeps its stated reason: ex:event a gmeow:Event ; gmeow:statedRationale \"Wait for the remaining account.\"@en ."@x-gmeow-english ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:string rdf:langString rdf:dirLangString ) ] .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/statedRationale" ; logic:closureValue logic:ClosedWorldClosure ] .
