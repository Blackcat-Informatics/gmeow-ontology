math:lrvFiniteBody a logic:Formula ; logic:and math:lrvFiniteVal , math:lrvFiniteLit .
math:lrvFiniteVal a logic:Formula ; logic:relation math:limitResultValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "vf" ] .
math:lrvFiniteLit a logic:Formula ; logic:relation logic:termIsLiteral ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vf" ] .

# divergesToPositiveInfinity ⟹ ∃ v ( limitResultValue(this, v) ∧ v ∈ { math:PositiveInfinity } )
