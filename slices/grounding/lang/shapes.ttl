# SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
# SPDX-License-Identifier: CC-BY-4.0

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# =========================================================================== #
# Hard-rule gates for the lang: form AST. Each shape names the typed failure
# class it enforces through gmeow:enforcesFailureClass, cross-referencing the
# machine-checked gate with the queryable violation vocabulary in module.ttl.
# =========================================================================== #

lang:FormSituatedShape
    a sh:NodeShape ;
    rdfs:label "Form situatedness shape"@x-gmeow-english ;
    skos:definition "Every lang:Form names exactly one lang:SignSystem through lang:inSignSystem — a form with none or with two is ill-formed. Functionality is expressed as a SHACL cardinality bound rather than an OWL characteristic to keep the term profile EL-clean."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnsituatedForm ;
    sh:targetClass lang:Form ;
    sh:property [
        sh:path lang:inSignSystem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:SignSystem ;
        sh:severity sh:Violation ;
        sh:message "A lang:Form must name exactly one lang:SignSystem through lang:inSignSystem." ;
    ] .

lang:SurfaceAnalysisShape
    a sh:NodeShape ;
    rdfs:label "Surface analysis shape"@x-gmeow-english ;
    skos:definition "Every lang:SurfaceForm declares exactly one lang:AnalysisLevel, and its structure matches the declared level: a parsed surface realizes a lang:ComposedForm, a raw surface is typed lang:UnanalyzedProse, and no surface both realizes an analyzed form and is typed unanalyzed prose."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:MisdeclaredAnalysis ;
    sh:targetClass lang:SurfaceForm ;
    sh:property [
        sh:path lang:analysisLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:AnalysisLevel ;
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceForm must declare exactly one lang:AnalysisLevel." ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceForm's structure must match its declared analysis level (parsed realizes a composed form; raw is unanalyzed prose; never both)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                {
                    $this <https://blackcatinformatics.ca/lang/analysisLevel> <https://blackcatinformatics.ca/lang/parsedLevel> .
                    FILTER NOT EXISTS {
                        $this <https://blackcatinformatics.ca/lang/realizes> ?f .
                        ?f a <https://blackcatinformatics.ca/lang/ComposedForm> .
                    }
                } UNION {
                    $this <https://blackcatinformatics.ca/lang/analysisLevel> <https://blackcatinformatics.ca/lang/rawLevel> .
                    FILTER NOT EXISTS { $this a <https://blackcatinformatics.ca/lang/UnanalyzedProse> . }
                } UNION {
                    $this <https://blackcatinformatics.ca/lang/realizes> ?g .
                    $this a <https://blackcatinformatics.ca/lang/UnanalyzedProse> .
                }
            }
        """ ;
    ] .

lang:SlotIndexUniqueShape
    a sh:NodeShape ;
    rdfs:label "Slot index uniqueness shape"@x-gmeow-english ;
    skos:definition "Two lang:FormSlot individuals of one lang:ComposedForm never share a lang:slotIndex, so constituent order is unambiguous."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:DuplicateSlotIndex ;
    sh:targetClass lang:ComposedForm ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "Two form slots of one composed form share a slot index." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/lang/formSlot> ?s1 .
                $this <https://blackcatinformatics.ca/lang/formSlot> ?s2 .
                ?s1 <https://blackcatinformatics.ca/lang/slotIndex> ?i .
                ?s2 <https://blackcatinformatics.ca/lang/slotIndex> ?i .
                FILTER(?s1 != ?s2)
            }
        """ ;
    ] .

lang:SlotContiguityShape
    a sh:NodeShape ;
    rdfs:label "Slot contiguity shape"@x-gmeow-english ;
    skos:definition "A lang:ComposedForm's slot indexes are zero-based and contiguous, enforced unconditionally: the minimum index is 0 and the maximum index is the slot count minus one, so a gap (an index skipped) or a non-zero start is rejected. The native crates/validate structural_lint gate carries the same rule as the charter's designated Rust-validator primary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:NonContiguousSlots ;
    sh:targetClass lang:ComposedForm ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A composed form's slot indexes are not zero-based and contiguous." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                {
                    SELECT $this (COUNT(DISTINCT ?i) AS ?cnt) (MAX(?i) AS ?mx) (MIN(?i) AS ?mn) WHERE {
                        $this <https://blackcatinformatics.ca/lang/formSlot> ?s .
                        ?s <https://blackcatinformatics.ca/lang/slotIndex> ?i .
                    } GROUP BY $this
                }
                FILTER( ?mn != 0 || ( ?mx + 1 ) != ?cnt )
            }
        """ ;
    ] .

lang:SlotIndexPresentShape
    a sh:NodeShape ;
    rdfs:label "Slot index presence shape"@x-gmeow-english ;
    skos:definition "Every lang:FormSlot declares exactly one integer lang:slotIndex — a slot with no index cannot take its place in the contiguous constituent order, and the contiguity aggregation of lang:SlotContiguityShape would silently skip an index-less slot, so its presence is mandated by plain cardinality rather than left to the aggregate arithmetic."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:NonContiguousSlots ;
    sh:targetClass lang:FormSlot ;
    sh:property [
        sh:path lang:slotIndex ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Violation ;
        sh:message "A lang:FormSlot must declare exactly one integer lang:slotIndex." ;
    ] .

lang:DependencyIntegrityShape
    a sh:NodeShape ;
    rdfs:label "Dependency integrity shape"@x-gmeow-english ;
    skos:definition "A lang:dependsOn head reference stays within the lang:Analysis its slot belongs to and does not participate in a dependency cycle of any length."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:DanglingDependency ;
    sh:targetClass lang:FormSlot ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A dependency head reference leaves its analysis or forms a cycle." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                {
                    $this <https://blackcatinformatics.ca/lang/dependsOn> ?h .
                    $this <https://blackcatinformatics.ca/lang/inAnalysis> ?a .
                    FILTER NOT EXISTS { ?h <https://blackcatinformatics.ca/lang/inAnalysis> ?a . }
                } UNION {
                    $this <https://blackcatinformatics.ca/lang/dependsOn>+ $this .
                }
            }
        """ ;
    ] .

lang:TypedMorphologyShape
    a sh:NodeShape ;
    rdfs:label "Typed morphology shape"@x-gmeow-english ;
    skos:definition "A lang:MorphFeature draws its key and value from a feature inventory: exactly one lang:featureKey that is a lang:FeatureKey individual, and at least one lang:featureValue that is a lang:FeatureValue individual — never a bare string."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UntypedMorphology ;
    sh:targetClass lang:MorphFeature ;
    sh:property [
        sh:path lang:featureKey ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:FeatureKey ;
        sh:severity sh:Violation ;
        sh:message "A lang:MorphFeature must name exactly one lang:FeatureKey individual." ;
    ] ;
    sh:property [
        sh:path lang:featureValue ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:FeatureValue ;
        sh:severity sh:Violation ;
        sh:message "A lang:MorphFeature must name at least one lang:FeatureValue individual." ;
    ] .

lang:SurfaceMaterialShape
    a sh:NodeShape ;
    rdfs:label "Surface material identity shape"@x-gmeow-english ;
    skos:definition "A lang:SurfaceForm declares the material identity a stable hash needs: its text, script, Unicode normalization, and collation locale. A surface with an undeclared normalization is ill-formed for the candidateSourceHash discipline."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnhashableSurface ;
    sh:targetClass lang:SurfaceForm ;
    sh:or (
        [ sh:property [ sh:path lang:surfaceText ; sh:minCount 1 ; sh:severity sh:Violation ] ]
        [ sh:property [ sh:path lang:surfaceBlob ; sh:minCount 1 ; sh:severity sh:Violation ] ]
    ) ;
    sh:message "A lang:SurfaceForm must carry its bytes — inline through lang:surfaceText, or by reference through lang:surfaceBlob for a document-scale surface." ;
    sh:property [
        sh:path lang:inScript ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:Script ;
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceForm must declare its lang:inScript." ;
    ] ;
    sh:property [
        sh:path lang:unicodeNormalization ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceForm must declare its lang:unicodeNormalization." ;
    ] ;
    sh:property [
        sh:path lang:collationLocale ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceForm must declare its lang:collationLocale." ;
    ] .

lang:AnchorCompleteShape
    a sh:NodeShape ;
    rdfs:label "Anchor completeness shape"@x-gmeow-english ;
    skos:definition "A lang:SurfaceAnchor declares its source, start and end offsets, and offset space — an anchor without a source and a span in a declared offset space locates nothing."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnanchoredOffset ;
    sh:targetClass lang:SurfaceAnchor ;
    sh:property [
        sh:path lang:anchorSource ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceAnchor must declare its lang:anchorSource." ;
    ] ;
    sh:property [
        sh:path lang:anchorStart ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceAnchor must declare its lang:anchorStart." ;
    ] ;
    sh:property [
        sh:path lang:anchorEnd ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceAnchor must declare its lang:anchorEnd." ;
    ] ;
    sh:property [
        sh:path lang:offsetSpace ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:OffsetSpace ;
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceAnchor must declare its lang:offsetSpace." ;
    ] .

lang:SlotFormStructuralShape
    a sh:NodeShape ;
    rdfs:label "Slot-form structural shape"@x-gmeow-english ;
    skos:definition "A lang:slotForm holds a structured form resource, never a bare literal — a form that carries inferential weight is a structured object, not a string."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:StringOnlyForm ;
    sh:targetSubjectsOf lang:slotForm ;
    sh:property [
        sh:path lang:slotForm ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:severity sh:Violation ;
        sh:message "A lang:slotForm must be a form resource, not a literal." ;
    ] .

lang:RealizesStructuralShape
    a sh:NodeShape ;
    rdfs:label "Realizes structural shape"@x-gmeow-english ;
    skos:definition "A lang:realizes holds a structured form resource, never a bare literal."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:StringOnlyForm ;
    sh:targetSubjectsOf lang:realizes ;
    sh:property [
        sh:path lang:realizes ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:severity sh:Violation ;
        sh:message "A lang:realizes must point at a form resource, not a literal." ;
    ] .

lang:FormHeadStructuralShape
    a sh:NodeShape ;
    rdfs:label "Form-head structural shape"@x-gmeow-english ;
    skos:definition "A lang:formHead holds a structured form resource, never a bare literal."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:StringOnlyForm ;
    sh:targetSubjectsOf lang:formHead ;
    sh:property [
        sh:path lang:formHead ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:severity sh:Violation ;
        sh:message "A lang:formHead must point at a form resource, not a literal." ;
    ] .

lang:GraphemeGroundedShape
    a sh:NodeShape ;
    rdfs:label "Grapheme grounding shape"@x-gmeow-english ;
    skos:definition "A lang:Grapheme belongs to the repertoire of the lang:Script it declares: the script lists it through lang:hasGrapheme."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UngroundedGrapheme ;
    sh:targetClass lang:Grapheme ;
    sh:property [
        sh:path lang:inScript ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:Script ;
        sh:severity sh:Violation ;
        sh:message "A lang:Grapheme must declare exactly one lang:Script through lang:inScript." ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A grapheme is not in the repertoire of the script it declares." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/lang/inScript> ?s .
                FILTER NOT EXISTS { ?s <https://blackcatinformatics.ca/lang/hasGrapheme> $this . }
            }
        """ ;
    ] .

# =========================================================================== #
# Meaning-stratum gates. Each names its typed lang: failure class. The two
# disjointness twins (Frege, act/observation) are SECONDARY finding surfaces —
# the OWL DisjointClasses axioms in module.ttl are the primary gate — so the
# SHACL harness fires a code for the negative fixtures the DL reasoner catches.
# =========================================================================== #

lang:DenotationRecordShape
    a sh:NodeShape ;
    rdfs:label "Denotation record shape"@x-gmeow-english ;
    skos:definition "A lang:Denotation is a fully specified reified record: it names its form (lang:denotedForm), its kind (lang:denotationKind, a lang:DenotationKind individual), its target (lang:denotationTarget), and its context (lang:denotationContext). A meaning assignment is never a bare edge, and a context-free denotation is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnderspecifiedDenotation ;
    sh:targetClass lang:Denotation ;
    sh:property [
        sh:path lang:denotedForm ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:Form ;
        sh:severity sh:Violation ;
        sh:message "A lang:Denotation must name its lang:denotedForm." ;
    ] ;
    sh:property [
        sh:path lang:denotationKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:DenotationKind ;
        sh:severity sh:Violation ;
        sh:message "A lang:Denotation must name exactly one lang:denotationKind." ;
    ] ;
    sh:property [
        sh:path lang:denotationTarget ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:Denotation must name its lang:denotationTarget." ;
    ] ;
    sh:property [
        sh:path lang:denotationContext ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:Denotation must name its lang:denotationContext." ;
    ] .

lang:DenotationNonSurfaceShape
    a sh:NodeShape ;
    rdfs:label "Denotation non-surface shape"@x-gmeow-english ;
    skos:definition "A lang:Denotation attaches to a lang:Form that is not a lang:SurfaceForm — meaning attaches above the byte level, so a denotation hung on a surface form is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:SurfaceLevelDenotation ;
    sh:targetClass lang:Denotation ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A lang:Denotation attaches to a lang:SurfaceForm; meaning attaches above the byte level." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/lang/denotedForm> ?f .
                ?f a <https://blackcatinformatics.ca/lang/SurfaceForm> .
            }
        """ ;
    ] .

lang:AmbiguityRoutingShape
    a sh:NodeShape ;
    rdfs:label "Ambiguity routing shape"@x-gmeow-english ;
    skos:definition "Where a denotation's head lexeme has more than one recorded lang:Sense, the denotation routes through one via lang:viaSense — routing through the triangle is what prevents the record from silently resolving an ambiguity it never examined."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnroutedAmbiguousDenotation ;
    sh:targetClass lang:Denotation ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "The denoted form's head lexeme has more than one sense but the denotation omits lang:viaSense." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                {
                    SELECT $this (COUNT(DISTINCT ?s) AS ?n) WHERE {
                        $this <https://blackcatinformatics.ca/lang/denotedForm> ?f .
                        ?f <https://blackcatinformatics.ca/lang/lexemeOf> ?lex .
                        ?s <https://blackcatinformatics.ca/lang/senseOf> ?lex .
                    } GROUP BY $this
                }
                FILTER( ?n > 1 )
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/lang/viaSense> ?vs . }
            }
        """ ;
    ] .

lang:DenotationKindMatchShape
    a sh:NodeShape ;
    rdfs:label "Denotation kind-match shape"@x-gmeow-english ;
    skos:definition "A lang:denotationKind matches its target's type: denotesLogicFormula targets a logic:Formula, denotesLogicType a logic:Type, denotesLogicTerm a logic:Individual, denotesClass an owl:Class, and denotesByDescription a lang:Intension. The kind fixes the target's type."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:DenotationKindMismatch ;
    sh:targetClass lang:Denotation ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A denotation kind does not match its target's type." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                {
                    $this <https://blackcatinformatics.ca/lang/denotationKind> <https://blackcatinformatics.ca/lang/denotesLogicFormula> .
                    $this <https://blackcatinformatics.ca/lang/denotationTarget> ?t .
                    FILTER NOT EXISTS { ?t a <https://blackcatinformatics.ca/logic/Formula> . }
                } UNION {
                    $this <https://blackcatinformatics.ca/lang/denotationKind> <https://blackcatinformatics.ca/lang/denotesLogicType> .
                    $this <https://blackcatinformatics.ca/lang/denotationTarget> ?t .
                    FILTER NOT EXISTS { ?t a <https://blackcatinformatics.ca/logic/Type> . }
                } UNION {
                    $this <https://blackcatinformatics.ca/lang/denotationKind> <https://blackcatinformatics.ca/lang/denotesLogicTerm> .
                    $this <https://blackcatinformatics.ca/lang/denotationTarget> ?t .
                    FILTER NOT EXISTS { ?t a <https://blackcatinformatics.ca/logic/Individual> . }
                } UNION {
                    $this <https://blackcatinformatics.ca/lang/denotationKind> <https://blackcatinformatics.ca/lang/denotesClass> .
                    $this <https://blackcatinformatics.ca/lang/denotationTarget> ?t .
                    FILTER NOT EXISTS { ?t a <http://www.w3.org/2002/07/owl#Class> . }
                } UNION {
                    $this <https://blackcatinformatics.ca/lang/denotationKind> <https://blackcatinformatics.ca/lang/denotesByDescription> .
                    $this <https://blackcatinformatics.ca/lang/denotationTarget> ?t .
                    FILTER NOT EXISTS { ?t a <https://blackcatinformatics.ca/lang/Intension> . }
                }
            }
        """ ;
    ] .

lang:ReadingClaimGroundedShape
    a sh:NodeShape ;
    rdfs:label "Reading-claim grounded shape"@x-gmeow-english ;
    skos:definition "A gmeow:Observation that is a claim about a lang:Reading (through lang:aboutReading) names its gmeow:vantage — the claim that a reading is correct is a vantage-held observation, never a groundless assertion."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UngroundedReadingClaim ;
    sh:targetSubjectsOf lang:aboutReading ;
    sh:property [
        sh:path <https://blackcatinformatics.ca/gmeow/vantage> ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A reading-correctness claim must name its gmeow:vantage." ;
    ] .

lang:IndexicalAnchoredShape
    a sh:NodeShape ;
    rdfs:label "Indexical anchored shape"@x-gmeow-english ;
    skos:definition "An indexical denotation (lang:isIndexical true) is read by a lang:InterpretationAct that names a lang:IndexicalAnchor through lang:anchorsIndexical — an indexical form denotes only relative to an anchor, and an indexical denotation whose act names none is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnanchoredIndexical ;
    sh:targetClass lang:Denotation ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "An indexical denotation's interpretation act names no lang:IndexicalAnchor." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/lang/isIndexical> true .
                ?r <https://blackcatinformatics.ca/lang/denotation> $this .
                ?act <https://blackcatinformatics.ca/lang/producedReading> ?r .
                FILTER NOT EXISTS { ?act <https://blackcatinformatics.ca/lang/anchorsIndexical> ?a . }
            }
        """ ;
    ] .

lang:ConfidenceNotProbabilityShape
    a sh:NodeShape ;
    rdfs:label "Confidence-not-probability shape"@x-gmeow-english ;
    skos:definition "A reading-preference claim (a gmeow:Observation about a lang:Reading) that carries a logic:probability declares a logic:probabilityModel — a preference weight is a logic:confidence unless an actual probability model is present. Treating un-modelled confidence as a probability is the named failure this reuses from the logic: and math: siblings."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:ConfidenceAsProbability ;
    sh:targetSubjectsOf lang:aboutReading ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A reading claim carries a logic:probability with no declared logic:probabilityModel." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/logic/probability> ?p .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/probabilityModel> ?m . }
            }
        """ ;
    ] .

lang:FregeDisjointShape
    a sh:NodeShape ;
    rdfs:label "Frege disjointness shape"@x-gmeow-english ;
    skos:definition "A node is never typed as two corners of the Frege triangle (lang:Form, lang:Sense, lang:Denotation). A SECONDARY finding surface for the OWL disjointness that is the primary gate: string identity never implies form identity; form identity never implies sense identity; sense identity never implies co-reference."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:FregeConflation ;
    sh:targetClass lang:Sense , lang:Denotation ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A node is typed as two corners of the Frege triangle (form/sense/denotation)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                {
                    $this a <https://blackcatinformatics.ca/lang/Form> .
                    $this a <https://blackcatinformatics.ca/lang/Sense> .
                } UNION {
                    $this a <https://blackcatinformatics.ca/lang/Form> .
                    $this a <https://blackcatinformatics.ca/lang/Denotation> .
                } UNION {
                    $this a <https://blackcatinformatics.ca/lang/Sense> .
                    $this a <https://blackcatinformatics.ca/lang/Denotation> .
                }
            }
        """ ;
    ] .

lang:ActObservationDisjointShape
    a sh:NodeShape ;
    rdfs:label "Act–observation disjointness shape"@x-gmeow-english ;
    skos:definition "A lang:InterpretationAct is never typed as a gmeow:Observation. A SECONDARY finding surface for the OWL disjointness that is the primary gate: the interpretation act is the process, never the claim about its readings."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:ActObservationConflation ;
    sh:targetClass lang:InterpretationAct ;
    sh:not [
        a sh:NodeShape ;
        sh:class <https://blackcatinformatics.ca/gmeow/Observation> ;
    ] ;
    sh:message "A lang:InterpretationAct is typed as a gmeow:Observation; the act is not the claim." .

# =========================================================================== #
# Crossing-stratum gates (rendering, translation, paraphrase, transliteration).
# Each names its typed lang: failure class. The preservation and morphism class
# of every crossing lives on the carried logic:Correspondence, so these shapes
# enforce that the carrier is named and specified, never that lang: shadows the
# logic:preservationKind judgment. The primary lang:RenderingAsIdentity and the
# fabrication gates are native Rust gates; the shapes here are structural
# well-formedness surfaces.
# =========================================================================== #

lang:RenderingRecordShape
    a sh:NodeShape ;
    rdfs:label "Rendering record shape"@x-gmeow-english ;
    skos:definition "A lang:Rendering is a fully specified reified crossing: it names the content it renders (lang:renderedContent), the convention governing it (lang:renderingConvention), the preservation judgment carried on its logic:Correspondence (lang:renderingPreservation), and exactly one lang:renderingKind that is a lang:RenderingKind individual. A rendering that names neither what it renders, nor its convention, nor its kind realizes nothing inspectable."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnderspecifiedRendering ;
    sh:targetClass lang:Rendering ;
    sh:property [
        sh:path lang:renderedContent ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:Rendering must name the lang:renderedContent it renders." ;
    ] ;
    sh:property [
        sh:path lang:renderingConvention ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:Rendering must name the lang:renderingConvention governing it." ;
    ] ;
    sh:property [
        sh:path lang:renderingPreservation ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:Rendering must name its lang:renderingPreservation." ;
    ] ;
    sh:property [
        sh:path lang:renderingKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:RenderingKind ;
        sh:severity sh:Violation ;
        sh:message "A lang:Rendering must name exactly one lang:renderingKind individual." ;
    ] .

lang:RenderingNotIdentityShape
    a sh:NodeShape ;
    rdfs:label "Rendering non-identity shape"@x-gmeow-english ;
    skos:definition "A lang:Rendering never renders itself: a rendering realizes content as a distinct form, so a rendering that is its own lang:renderedContent is a crossing that never happened. A SECONDARY finding surface — the primary lang:RenderingAsIdentity enforcement (content and produced form being one node) is a native gate — so the SHACL harness still fires the self-reference case."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:RenderingAsIdentity ;
    sh:targetClass lang:Rendering ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A lang:Rendering is its own lang:renderedContent; a self-identical rendering is a crossing that never happened." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/lang/renderedContent> $this .
            }
        """ ;
    ] .

lang:TranslationUnitShape
    a sh:NodeShape ;
    rdfs:label "Translation unit shape"@x-gmeow-english ;
    skos:definition "A lang:TranslationUnit declares both forms of its crossing — its lang:translationSource and lang:translationTarget — and names the single logic:Correspondence carrying its law-spine through lang:translationCorrespondence. Requiring the carried correspondence is how the unit's preservation judgment is enforced structurally: the logic:preservationKind lives on that Correspondence, so a unit that names none carries no inspectable, judged crossing."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnderspecifiedTranslationUnit ;
    sh:targetClass lang:TranslationUnit ;
    sh:property [
        sh:path lang:translationSource ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:TranslationUnit must name its lang:translationSource." ;
    ] ;
    sh:property [
        sh:path lang:translationTarget ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:TranslationUnit must name its lang:translationTarget." ;
    ] ;
    sh:property [
        sh:path lang:translationCorrespondence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class logic:Correspondence ;
        sh:severity sh:Violation ;
        sh:message "A lang:TranslationUnit must carry exactly one logic:Correspondence through lang:translationCorrespondence." ;
    ] .

lang:UnmarkedSurfaceTranslationShape
    a sh:NodeShape ;
    rdfs:label "Unmarked surface translation shape"@x-gmeow-english ;
    skos:definition "A lang:TranslationUnit whose lang:translationSource or lang:translationTarget is a lang:SurfaceForm that realizes no analyzed form (no lang:realizes) is honest only if that surface is typed lang:UnanalyzedProse AND its carried logic:Correspondence carries the weakest preservation judgment (logic:Unsupported or logic:ValidationOnly). The gate fires when EITHER conjunct is absent: a surface-only side that is not typed lang:UnanalyzedProse, OR one whose logic:Correspondence claims a stronger-than-weakest preservation over that surface. Either way a strong crossing is claimed over an unmarked or unanalyzed surface — the fabrication risk this gate flags."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnmarkedSurfaceTranslation ;
    sh:targetClass lang:TranslationUnit ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A surface-only translation side realizes no analyzed form yet is not typed lang:UnanalyzedProse, or carries a stronger-than-weakest preservation judgment on its logic:Correspondence." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                {
                    # source surface realizes nothing yet is not typed unanalyzed prose
                    $this <https://blackcatinformatics.ca/lang/translationSource> ?s .
                    ?s a <https://blackcatinformatics.ca/lang/SurfaceForm> .
                    FILTER NOT EXISTS { ?s <https://blackcatinformatics.ca/lang/realizes> ?rf . }
                    FILTER NOT EXISTS { ?s a <https://blackcatinformatics.ca/lang/UnanalyzedProse> . }
                } UNION {
                    # source surface realizes nothing yet claims a stronger-than-weakest crossing
                    $this <https://blackcatinformatics.ca/lang/translationSource> ?s .
                    ?s a <https://blackcatinformatics.ca/lang/SurfaceForm> .
                    $this <https://blackcatinformatics.ca/lang/translationCorrespondence> ?c .
                    FILTER NOT EXISTS { ?s <https://blackcatinformatics.ca/lang/realizes> ?rf . }
                    FILTER NOT EXISTS { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/Unsupported> . }
                    FILTER NOT EXISTS { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/ValidationOnly> . }
                } UNION {
                    # target surface realizes nothing yet is not typed unanalyzed prose
                    $this <https://blackcatinformatics.ca/lang/translationTarget> ?t .
                    ?t a <https://blackcatinformatics.ca/lang/SurfaceForm> .
                    FILTER NOT EXISTS { ?t <https://blackcatinformatics.ca/lang/realizes> ?rf . }
                    FILTER NOT EXISTS { ?t a <https://blackcatinformatics.ca/lang/UnanalyzedProse> . }
                } UNION {
                    # target surface realizes nothing yet claims a stronger-than-weakest crossing
                    $this <https://blackcatinformatics.ca/lang/translationTarget> ?t .
                    ?t a <https://blackcatinformatics.ca/lang/SurfaceForm> .
                    $this <https://blackcatinformatics.ca/lang/translationCorrespondence> ?c .
                    FILTER NOT EXISTS { ?t <https://blackcatinformatics.ca/lang/realizes> ?rf . }
                    FILTER NOT EXISTS { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/Unsupported> . }
                    FILTER NOT EXISTS { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/ValidationOnly> . }
                }
            }
        """ ;
    ] .

lang:TranslationAttributionShape
    a sh:NodeShape ;
    rdfs:label "Translation attribution shape"@x-gmeow-english ;
    skos:definition "A lang:TranslationUnit names the lang:translationMethod that produced its crossing — a lang:TranslationMethod individual (human, machine, or compositional) — because whether a crossing was made by a human, a machine, or a compositional rule run is provenance the crossing must carry. Where the method is lang:methodMachine, the crossing further names the activity that generated it through gmeow:wasGeneratedBy: a machine translation with no generating activity hides what made it."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnattributedTranslation ;
    sh:targetClass lang:TranslationUnit ;
    sh:property [
        sh:path lang:translationMethod ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:TranslationMethod ;
        sh:severity sh:Violation ;
        sh:message "A lang:TranslationUnit must name its lang:translationMethod." ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A machine translation (lang:methodMachine) names no gmeow:wasGeneratedBy activity that produced it." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/lang/translationMethod> <https://blackcatinformatics.ca/lang/methodMachine> .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/wasGeneratedBy> ?a . }
            }
        """ ;
    ] .

lang:ParaphraseKindShape
    a sh:NodeShape ;
    rdfs:label "Paraphrase kind shape"@x-gmeow-english ;
    skos:definition "A lang:Paraphrase names exactly one lang:paraphraseSamenessKind — a lang:ParaphraseSamenessKind individual (same denotation, same sense, or same force and content). A paraphrase that declares no sameness kind claims an equivalence without saying which corner of the Frege triangle it holds fixed, smuggling in an equivalence without content."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UndeclaredParaphraseKind ;
    sh:targetClass lang:Paraphrase ;
    sh:property [
        sh:path lang:paraphraseSamenessKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class lang:ParaphraseSamenessKind ;
        sh:severity sh:Violation ;
        sh:message "A lang:Paraphrase must name exactly one lang:paraphraseSamenessKind individual." ;
    ] .

lang:TransliterationAnchorShape
    a sh:NodeShape ;
    rdfs:label "Transliteration anchor shape"@x-gmeow-english ;
    skos:definition "A lang:TransliterationMap declares the orthographies it maps between — its lang:transliterationSourceOrthography and lang:transliterationTargetOrthography — and the naming scheme it grafts through lang:transliterationScheme. A transliteration between undeclared orthographies, or with no named scheme, maps nothing reconstructible."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnanchoredTransliteration ;
    sh:targetClass lang:TransliterationMap ;
    sh:property [
        sh:path lang:transliterationSourceOrthography ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:TransliterationMap must declare its lang:transliterationSourceOrthography." ;
    ] ;
    sh:property [
        sh:path lang:transliterationTargetOrthography ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:TransliterationMap must declare its lang:transliterationTargetOrthography." ;
    ] ;
    sh:property [
        sh:path lang:transliterationScheme ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:TransliterationMap must declare its lang:transliterationScheme." ;
    ] .

lang:ProjectionEmissionDeclaredShape
    a sh:NodeShape ;
    rdfs:label "Projection emission declared shape"@x-gmeow-english ;
    skos:definition "Every lang:ProjectionEmission declares the target it lowers to through lang:projectionTargetName and the preservation kind of its crossing through logic:preservationKind — an emission with no preservation kind has entered the loss ledger with an undeclared judgment. Only this statically-checkable minimum is a SHACL shape; the join-requiring projection contract failures (undeclared unsupported constructs, unrecorded epistemic loss, projection-scoped silent disambiguation, and refuted exactness) are native Rust gates."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:MissingPreservationKind ;
    sh:targetClass lang:ProjectionEmission ;
    sh:property [
        sh:path logic:preservationKind ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:ProjectionEmission must declare its logic:preservationKind (reusing the logic: loss-ledger vocabulary verbatim)." ;
    ] ;
    sh:property [
        sh:path lang:projectionTargetName ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:ProjectionEmission must name the external target it lowers to through lang:projectionTargetName." ;
    ] .

# =========================================================================== #
# GMN dialect gates. Eight hard rules of the gmeow:gmn* graft, each naming its
# typed lang:Gmn* failure class. The five parser-tier rules (uncovered terms,
# canonical order, malformed numbers, undeclared dialect versions, grammar
# decodability) are the GMN parser/writer's, not SHACL's, so they have no
# shape here. The doctrine individuals in module.ttl (an empty gmeow:gmnScript,
# the four judged dialect crossings, the acceptance-window-1 lineage) validate
# against every gate below: presence constraints quantify over members that
# exist, and the overclaim gates reach a correspondence only through a
# migration or compaction link.
# =========================================================================== #

lang:GmnCodepointCanonicalShape
    a sh:NodeShape ;
    rdfs:label "GMN canonical codepoint shape"@x-gmeow-english ;
    skos:definition "Every gmeow:gmnCodepoints value is the canonical codepoint-explicit spelling: one or more space-separated \"U+XXXX\"-style groups of four to six uppercase hexadecimal digits. Targeted at every subject carrying gmeow:gmnCodepoints, so the rule reaches writer-projected glyph tables wherever they land."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnNonCanonicalCodepoint ;
    sh:targetSubjectsOf gmeow:gmnCodepoints ;
    sh:property [
        sh:path gmeow:gmnCodepoints ;
        sh:minCount 1 ;
        sh:pattern "^U\\+[0-9A-F]{4,6}( U\\+[0-9A-F]{4,6})*$" ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:gmnCodepoints value must be canonical: space-separated U+XXXX groups of 4-6 uppercase hex digits." ;
    ] .

lang:GmnScriptCodepointPresenceShape
    a sh:NodeShape ;
    rdfs:label "GMN script codepoint presence shape"@x-gmeow-english ;
    skos:definition "Every grapheme in the repertoire of gmeow:gmnScript carries a gmeow:gmnCodepoints spelling — the GMN glyph table is codepoint-explicit by rule. Targeted at the gmeow:gmnScript node itself and quantified over its lang:hasGrapheme members, so the doctrine script with an empty repertoire validates vacuously while any admitted glyph must name its codepoints."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnNonCanonicalCodepoint ;
    sh:targetNode gmeow:gmnScript ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A grapheme in the GMN script's repertoire carries no gmeow:gmnCodepoints spelling; the GMN glyph table is codepoint-explicit." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/lang/hasGrapheme> ?g .
                FILTER NOT EXISTS { ?g <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?cp . }
            }
        """ ;
    ] .

lang:GmnConfusableGlyphShape
    a sh:NodeShape ;
    rdfs:label "GMN confusable glyph shape"@x-gmeow-english ;
    skos:definition "No two distinct graphemes of gmeow:gmnScript are related by gmeow:gmnConfusableWith — the confusables blocklist of the GMN orthography over its seeded pairs. The seeded pairs are data-level anchors of the UTS #39 skeleton rule; the full skeleton computation belongs to the GMN validator, so this gate enforces exactly what the graph states: an admitted inventory never co-hosts a declared-confusable pair."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnConfusableGlyph ;
    sh:targetSubjectsOf gmeow:gmnConfusableWith ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "Two distinct graphemes of the GMN script are a declared gmeow:gmnConfusableWith pair; the orthography's confusables blocklist forbids co-resident confusables." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/gmnConfusableWith> ?g2 .
                $this <https://blackcatinformatics.ca/lang/inScript> <https://blackcatinformatics.ca/gmeow/gmnScript> .
                ?g2 <https://blackcatinformatics.ca/lang/inScript> <https://blackcatinformatics.ca/gmeow/gmnScript> .
                FILTER($this != ?g2)
            }
        """ ;
    ] .

lang:GmnGlyphCollisionShape
    a sh:NodeShape ;
    rdfs:label "GMN glyph collision shape"@x-gmeow-english ;
    skos:definition "No two distinct graphemes of one lang:Script share an identical gmeow:gmnCodepoints value unless BOTH are sigil-scoped: the record-initial sigil discipline (gmeow:gmnSigilScope on each glyph) is the single lawful cross-plane reuse — μ the math sigil versus μ the in-record measure symbol — and an unscoped collision is ambiguity in the glyph table itself."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnGlyphCollision ;
    sh:targetSubjectsOf gmeow:gmnCodepoints ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "Two distinct graphemes of one script share an identical gmeow:gmnCodepoints value without both carrying a gmeow:gmnSigilScope; unscoped glyph collisions are forbidden." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?cp .
                $this <https://blackcatinformatics.ca/lang/inScript> ?s .
                ?g2 <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?cp .
                ?g2 <https://blackcatinformatics.ca/lang/inScript> ?s .
                FILTER($this != ?g2)
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/gmnSigilScope> ?sc1 .
                    ?g2 <https://blackcatinformatics.ca/gmeow/gmnSigilScope> ?sc2 .
                }
            }
        """ ;
    ] .

lang:GmnEnvelopeContractShape
    a sh:NodeShape ;
    rdfs:label "GMN envelope contract shape"@x-gmeow-english ;
    skos:definition "Every gmeow:GmnEnvelope carries its full eight-field contract: the three dialect coordinates (gmeow:gmnSchemaVersion, gmeow:gmnDictionaryVersion, gmeow:gmnGlyphTableVersion), its boundary ring (gmeow:gmnSecurityRing), its asserting standpoint (gmeow:accordingTo), its generating activity (gmeow:wasGeneratedBy), its byte-exact identity (gmeow:contentDigest), and its losslessness judgment (gmeow:gmnEnvelopeCorrespondence — a logic:Correspondence, never a boolean flag)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnMissingEnvelopeField ;
    sh:targetClass gmeow:GmnEnvelope ;
    sh:property [
        sh:path gmeow:gmnSchemaVersion ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnEnvelope must pin its gmeow:gmnSchemaVersion." ;
    ] ;
    sh:property [
        sh:path gmeow:gmnDictionaryVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnEnvelope must pin exactly one gmeow:gmnDictionaryVersion — versions are pinned and non-interchangeable, never plural." ;
    ] ;
    sh:property [
        sh:path gmeow:gmnGlyphTableVersion ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnEnvelope must pin its gmeow:gmnGlyphTableVersion." ;
    ] ;
    sh:property [
        sh:path gmeow:gmnSecurityRing ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:GmnSecurityRing ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnEnvelope must declare exactly one gmeow:gmnSecurityRing." ;
    ] ;
    sh:property [
        sh:path gmeow:accordingTo ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnEnvelope must name its asserting standpoint through gmeow:accordingTo." ;
    ] ;
    sh:property [
        sh:path gmeow:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnEnvelope must name the activity that generated it through gmeow:wasGeneratedBy." ;
    ] ;
    sh:property [
        sh:path gmeow:contentDigest ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnEnvelope must carry its byte-exact gmeow:contentDigest." ;
    ] ;
    sh:property [
        sh:path gmeow:gmnEnvelopeCorrespondence ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class logic:Correspondence ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnEnvelope must point gmeow:gmnEnvelopeCorrespondence at the logic:Correspondence judging its crossing." ;
    ] .

# =========================================================================== #
# GMN dictionary alias-injectivity gate. The section-
# retraction witness gmeow:gmnCorrNormalToGmn now claims rests on the alias
# table being a genuine BIJECTION over its covered term set. Two entries of one
# gmeow:GmnDictionary aliasing two DIFFERENT terms with the SAME alias string
# would corrupt read-back silently (the reader cannot tell which term the
# alias names), so injectivity is a gated structural property, never merely
# asserted prose.
# =========================================================================== #

lang:GmnDictionaryAliasInjectivityShape
    a sh:NodeShape ;
    rdfs:label "GMN dictionary alias injectivity shape"@x-gmeow-english ;
    skos:definition "No two gmeow:GmnDictionaryEntry members of one gmeow:GmnDictionary bind two different gmeow:gmnDictionaryEntryTerm values to the same gmeow:gmnDictionaryEntryAlias string — the alias table is a bijection over its covered term set, per dictionary version."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnDictionaryAliasCollision ;
    sh:targetClass gmeow:GmnDictionary ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "Two entries of one GMN dictionary alias two different terms with the same alias string; the alias table is not injective." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntry> ?e1 .
                $this <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntry> ?e2 .
                ?e1 <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntryAlias> ?alias .
                ?e2 <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntryAlias> ?alias .
                ?e1 <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntryTerm> ?t1 .
                ?e2 <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntryTerm> ?t2 .
                FILTER(?e1 != ?e2)
                FILTER(?t1 != ?t2)
            }
        """ ;
    ] .

# =========================================================================== #
# GMN security-ring lattice gates. gmeow:gmnRingWithin is
# DERIVED (module.ttl, gmeow:ruleGmnRingWithinDerive) from a ring's AUTHORED
# (gmeow:gmnRingLevel, gmeow:gmnRingCompartment) coordinates. Gating the
# DERIVED relation for partial-order-ness would be a tautology (a derivation
# from a partial order is trivially one) — this shape gates the AUTHORED
# coordinates instead. The separate zero-authored-gmnRingWithin-triples gate
# lives in tests/structural.ttl (a StructuralAssertion, not SHACL), since it
# must inspect the ASSERTED graph specifically, before any reasoning
# materializes the derived edges.
# =========================================================================== #

lang:GmnRingLatticeWellFormedShape
    a sh:NodeShape ;
    rdfs:label "GMN ring lattice well-formedness shape"@x-gmeow-english ;
    skos:definition "Every gmeow:GmnSecurityRing carries exactly one gmeow:gmnRingLevel drawn from gmeow:GmnRingLevel, and every gmeow:gmnRingCompartment value it carries (zero or more; an empty set is well-formed) is a declared gmeow:GmnCompartment individual. This gates the AUTHORED lattice coordinates the gmeow:gmnRingWithin derivation reads from, never the derived relation itself."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnRingLatticeMalformed ;
    sh:targetClass gmeow:GmnSecurityRing ;
    sh:property [
        sh:path gmeow:gmnRingLevel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:GmnRingLevel ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnSecurityRing must carry exactly one gmeow:gmnRingLevel drawn from gmeow:GmnRingLevel." ;
    ] ;
    sh:property [
        sh:path gmeow:gmnRingCompartment ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:GmnCompartment ;
        sh:severity sh:Violation ;
        sh:message "Every gmeow:gmnRingCompartment value of a gmeow:GmnSecurityRing must be a declared gmeow:GmnCompartment individual." ;
    ] .

lang:GmnVersionOverclaimShape
    a sh:NodeShape ;
    rdfs:label "GMN version overclaim shape"@x-gmeow-english ;
    skos:definition "The GMN version machinery never claims more than its lineage discharges. A migration crossing (a subject of gmeow:gmnMigratesTo — the logic:Correspondence itself, or a lang:TranslationUnit carrying one) whose correspondence claims logic:mnemomorphic true is honest only over an additive bump: when the destination version's gmeow:VersionMembership carries a gmeow:versionScale other than gmeow:scaleMinor or gmeow:scaleTrivial, the scale's own classification says the change is not recoverable, so the recoverability witness is an overclaim. Separately, a gmeow:gmnAcceptWindow greater than 1 is silent tolerance, not judged migration."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnVersionOverclaim ;
    sh:targetSubjectsOf gmeow:gmnMigratesTo , gmeow:gmnAcceptWindow ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A GMN migration claims logic:mnemomorphic true over a stronger-than-additive version bump, or a gmeow:gmnAcceptWindow exceeds 1; the version machinery never claims more than its lineage discharges." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                {
                    $this <https://blackcatinformatics.ca/gmeow/gmnMigratesTo> ?v .
                    $this <https://blackcatinformatics.ca/logic/mnemomorphic> true .
                    ?m <https://blackcatinformatics.ca/gmeow/versionMember> ?v .
                    ?m <https://blackcatinformatics.ca/gmeow/versionScale> ?sc .
                    FILTER(?sc != <https://blackcatinformatics.ca/gmeow/scaleMinor> && ?sc != <https://blackcatinformatics.ca/gmeow/scaleTrivial>)
                } UNION {
                    $this <https://blackcatinformatics.ca/gmeow/gmnMigratesTo> ?v .
                    $this <https://blackcatinformatics.ca/lang/translationCorrespondence> ?c .
                    ?c <https://blackcatinformatics.ca/logic/mnemomorphic> true .
                    ?m <https://blackcatinformatics.ca/gmeow/versionMember> ?v .
                    ?m <https://blackcatinformatics.ca/gmeow/versionScale> ?sc .
                    FILTER(?sc != <https://blackcatinformatics.ca/gmeow/scaleMinor> && ?sc != <https://blackcatinformatics.ca/gmeow/scaleTrivial>)
                } UNION {
                    $this <https://blackcatinformatics.ca/gmeow/gmnAcceptWindow> ?w .
                    FILTER(?w > 1)
                }
            }
        """ ;
    ] .

lang:GmnCompactionProvenanceShape
    a sh:NodeShape ;
    rdfs:label "GMN compaction provenance shape"@x-gmeow-english ;
    skos:definition "Every gmeow:GmnCompaction is fully provenance-linked: at least one gmeow:gmnCompacts edge to a source it condenses, and the attributing gmeow:vantage its gmeow:StandpointClaim nature requires — the compaction is a reified NEW claim held from a standpoint, auditable exactly because its sources and its holder are named."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnCompactionWithoutProvenance ;
    sh:targetClass gmeow:GmnCompaction ;
    sh:property [
        sh:path gmeow:gmnCompacts ;
        sh:minCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnCompaction must name every source it condenses through gmeow:gmnCompacts." ;
    ] ;
    sh:property [
        sh:path gmeow:vantage ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnCompaction must name the standpoint holding it through gmeow:vantage (it is a gmeow:StandpointClaim)." ;
    ] .

lang:GmnCompactionOverclaimShape
    a sh:NodeShape ;
    rdfs:label "GMN compaction overclaim shape"@x-gmeow-english ;
    skos:definition "A gmeow:GmnCompaction's correspondence never claims a preservation stronger than logic:ValidationOnly: no logic:mnemomorphic true, no logic:ExactPreservation, no logic:SoundUnderApproximation. Compaction is get-leg-only (the GMN-1 → GMN-2 crossing gmeow:gmnCorrGmnToCompacted is a validation-only bridge view), so any logic:Correspondence the compaction record links — however the link is authored — must carry the honest weak judgment."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnCompactionOverclaim ;
    sh:targetClass gmeow:GmnCompaction ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnCompaction links a logic:Correspondence claiming mnemomorphic recoverability, exact preservation, or soundness under approximation; compaction is validation-only." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this ?link ?c .
                ?c a <https://blackcatinformatics.ca/logic/Correspondence> .
                {
                    ?c <https://blackcatinformatics.ca/logic/mnemomorphic> true .
                } UNION {
                    ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/ExactPreservation> .
                } UNION {
                    ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/SoundUnderApproximation> .
                }
            }
        """ ;
    ] .

# =========================================================================== #
# Linguistic symbology plane gates: coverage and imported-plane attribution   #
# =========================================================================== #

lang:GmnLangCoverageShape
    a sh:NodeShape ;
    rdfs:label "GMN linguistic coverage shape"@x-gmeow-english ;
    skos:definition "Every morphological lang:FeatureValue the GMN linguistic surface emits carries a disposition in the symbology plane: a lang:Denotation binds it to a glyph, a named key, or an imported alias. The denominator is derived — the shape quantifies over the lang:FeatureValue population by type, not over a hand-listed set — so a value added without a disposition is a silent gap the gate catches. Coverage is total by rule; an undispositioned value is lang:GmnUndispositionedTerm."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnUndispositionedTerm ;
    sh:targetClass lang:FeatureValue ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A lang:FeatureValue carries no lang:Denotation dispositioning it in the GMN symbology plane; coverage is total, so every emitted term is glyphed, alias-planed, or named-key-ruled." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                FILTER NOT EXISTS {
                    ?d a <https://blackcatinformatics.ca/lang/Denotation> .
                    ?d <https://blackcatinformatics.ca/lang/denotationTarget> $this .
                }
            }
        """ ;
    ] .

lang:GmnImportedPlaneAttributionShape
    a sh:NodeShape ;
    rdfs:label "GMN imported-plane attribution shape"@x-gmeow-english ;
    skos:definition "Every lang:GmnImportedPlane carries both its citation and its version: at least one gmeow:cites edge naming the source work and at least one dcterms:hasVersion literal pinning the edition. An external standard imported verbatim is meaningless without the source it cites and the edition it was drawn from; a plane missing either is lang:GmnUnattributedPlane."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnUnattributedPlane ;
    sh:targetClass lang:GmnImportedPlane ;
    sh:property [
        sh:path <https://blackcatinformatics.ca/gmeow/cites> ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:GmnImportedPlane must cite its source work through gmeow:cites." ;
    ] ;
    sh:property [
        sh:path <http://purl.org/dc/terms/hasVersion> ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A lang:GmnImportedPlane must pin its edition through dcterms:hasVersion." ;
    ] .

lang:GmnScriptGlyphCoverageShape
    a sh:NodeShape ;
    rdfs:label "GMN script-glyph token-cost coverage shape"@x-gmeow-english ;
    skos:definition "Every lang:Grapheme in the GMN script (lang:inScript gmeow:gmnScript) carries a measured token cost through gmeow:gmnGlyphTokenCost: the per-glyph feed the glyph-versus-named-key disposition is read off. The population is derived — the shape scopes to the gmeow:gmnScript repertoire by lang:inScript, not to a hand-listed set — so a glyph admitted to the shared inventory (an IPA grapheme, the `*` operator glyph) without its cost feed is a silent gap the gate catches, complementing the lang:FeatureValue coverage of lang:GmnLangCoverageShape. A GMN-script glyph with no gmeow:gmnGlyphTokenCost is lang:GmnUncostedScriptGlyph."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnUncostedScriptGlyph ;
    sh:targetClass lang:Grapheme ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A lang:Grapheme in the GMN script carries no gmeow:gmnGlyphTokenCost; the GMN glyph inventory is cost-covered by rule, so every admitted glyph carries its measured token-cost feed." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/lang/inScript> <https://blackcatinformatics.ca/gmeow/gmnScript> .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/gmnGlyphTokenCost> ?c .
                }
            }
        """ ;
    ] .

# =========================================================================== #
# Mentation <-> lang binding gate: gmeow:processExport                       #
# (mentation, core tier) crossings bind to the ring model. NOT one of the     #
# eight SHACL hard rules of the "GMN dialect gates" banner above --           #
# LANG-CONFORMANCE.md's rule count is unchanged; this is a separate           #
# cross-slice competency check, exercised over the live fixture pair in       #
# tests/conformance-fixtures/gmn-export-ring-bound.ttl (passes) and           #
# tests/counter-examples/gmn-export-crossing-no-ring.ttl (fires).             #
# =========================================================================== #

lang:GmnExportRingBindingShape
    a sh:NodeShape ;
    rdfs:label "GMN export-ring binding shape"@x-gmeow-english ;
    skos:definition "Every gmeow:GmnEnvelope generated by an activity typed gmeow:mentalProcessType gmeow:processExport (mentation's externalization/communication episode, the emit member of the train/audit/export triple) declares a gmeow:gmnSecurityRing. The binding runs through the envelope's existing gmeow:wasGeneratedBy provenance field — the 'generating activity' hook the eight-field contract already names — so mentation asserts no lang term and gains no gmeow:sliceDependsOn edge on lang; this slice alone reads the mentation individual its own envelope already points at. An export crossing a serialization boundary with an unringed envelope is exactly the disclosure gap this gate catches."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:GmnUnringedExportCrossing ;
    sh:targetClass gmeow:GmnEnvelope ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnEnvelope was generated by an activity typed gmeow:mentalProcessType gmeow:processExport but declares no gmeow:gmnSecurityRing; an export crossing a serialization boundary must bind to the ring model." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/wasGeneratedBy> ?act .
                ?act <https://blackcatinformatics.ca/gmeow/mentalProcessType> <https://blackcatinformatics.ca/gmeow/processExport> .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/gmnSecurityRing> ?ring . }
            }
        """ ;
    ] .

# =========================================================================== #
# Flagship acceptance manifest — the slice's thin failure-range gate
#
# The acceptance-manifest vocabulary is hoisted to gmeow: (gmeow:FlagshipScenario), and
# its shared cardinality wiring (an example, competency, producer, counter-example, and
# enforcing class, each exactly once) is carried by the shared gmeow:FlagshipScenarioShape
# in shapes/gmeow-shapes.ttl. This slice contributes ONLY the failure-range check: that a
# gmeow:FlagshipScenario's gmeow:enforcesFailureClass names a lang:LangConformanceFailure
# subclass — the slice-local part of the contract.
# =========================================================================== #

lang:FlagshipScenarioShape
    a sh:NodeShape ;
    rdfs:label "Flagship scenario failure-range shape"@x-gmeow-english ;
    skos:definition "The lang: slice's THIN failure-range gate for gmeow:FlagshipScenario: it checks only that the scenario's gmeow:enforcesFailureClass names a lang:LangConformanceFailure subclass — the typed failure its counter-example raises. The shared cardinality wiring (an example, a competency, a producer, a counter-example, and an enforcing class, each exactly once) is carried by the shared gmeow:FlagshipScenarioShape in shapes/gmeow-shapes.ttl; this slice contributes only the slice-namespaced failure-range check."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:enforcesFailureClass lang:UnwiredFlagshipScenario ;
    sh:targetClass gmeow:FlagshipScenario ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A gmeow:FlagshipScenario's gmeow:enforcesFailureClass must name a lang:LangConformanceFailure subclass — the typed failure its counter-example raises; naming a class that is not a conformance failure leaves the scenario unwired (lang:UnwiredFlagshipScenario)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/enforcesFailureClass> ?fc .
                FILTER NOT EXISTS {
                    ?fc <http://www.w3.org/2000/01/rdf-schema#subClassOf>+ <https://blackcatinformatics.ca/lang/LangConformanceFailure> .
                }
            }
        """ ;
    ] .
