@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix crmarc: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/crmarchaeo>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:Observation ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri crmarc:S4_Observation ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.85"^^xsd:double ;
        rdfs:label "Observation → crmarc:S4_Observation"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:ObservationalActivity ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri crmarc:A1_Excavation_Process_Unit ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.75"^^xsd:double ;
            rdfs:label "ObservationalActivity (excavation) → crmarc:A1_Excavation_Process_Unit"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:connectsTo ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri crmarc:AP11_has_physical_relation ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.6"^^xsd:double ;
            rdfs:label "connectsTo between Observations → crmarc:AP11_has_physical_relation"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "crmarchaeo" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → crmarchaeo (EDOAL)"@en .
