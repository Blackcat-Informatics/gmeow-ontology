<https://blackcatinformatics.ca/gmeow/slices/dreaming>
    a gmeow:Slice ;
    rdfs:label "dreaming"@x-gmeow-english ;
    skos:definition "The dreaming slice of the GMEOW ontology (extension tier): GMEOW Dreaming Module — a published composition over the experiential/mentation layer with no new primitives. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/dreaming> ;
    dcterms:title "GMEOW Dreaming Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierExtension ;
    gmeow:sliceProfile "dreaming" ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/mentation> ,
        <https://blackcatinformatics.ca/gmeow/slices/imagination> ;
    gmeow:sliceConsumer "AI offline generative replay, synthetic experience, and counterfactual rehearsal over agent memory (GTS ai-package), and human dream-journaling / sleep-research corpora. Part of the Mentation program."@x-gmeow-english .
