gmeow:QueryOrderCriterion logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:orderCriterionKind ; logic:allValuesFrom [ a logic:Class ; logic:oneOf ( gmeow:orderContentTier gmeow:orderFusedScore gmeow:orderActivation gmeow:orderSubjectTie ) ] ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryOrderCriterion ; logic:closureKey "https://blackcatinformatics.ca/gmeow/orderCriterionKind" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryOrderCriterion logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:orderCriterionKind ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:QualityValue ] .

gmeow:QueryOrderCriterion logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:orderDescending ; logic:allValuesFrom xsd:boolean ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryOrderCriterion ; logic:closureKey "https://blackcatinformatics.ca/gmeow/orderDescending" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryOrderCriterion logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:orderDescending ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange xsd:boolean ] .

gmeow:QueryPredicateTierBinding logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:tierBindingPredicate ; logic:allValuesFrom logic:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryPredicateTierBinding ; logic:closureKey "https://blackcatinformatics.ca/gmeow/tierBindingPredicate" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryPredicateTierBinding logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:tierBindingPredicate ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ] .

gmeow:QueryPredicateTierBinding logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:tierBindingOrdinal ; logic:allValuesFrom xsd:unsignedInt ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryPredicateTierBinding ; logic:closureKey "https://blackcatinformatics.ca/gmeow/tierBindingOrdinal" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryPredicateTierBinding logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:tierBindingOrdinal ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange xsd:unsignedInt ] .

gmeow:QueryOrderPolicy logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:orderCriterion ; logic:allValuesFrom gmeow:QueryOrderCriterion ] .

gmeow:QueryOrderCriterion logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:contentTierBinding ; logic:allValuesFrom gmeow:QueryPredicateTierBinding ] .
