# --- The losslessness correspondences (meta-level; graph/correspondence-laws) - #
# Each medium's dec ∘ enc = id claim is a judged crossing, never a boolean. The
# rung is logic:SectionRetraction (put ∘ get = id_S on the declared content
# domain — the encoded byte space need not be recovered pointwise, so the top
# logic:Isomorphism rung would overclaim), the relation is logic:Subsumes, and
# the preservation judgment is IDENTITY (logic:ExactPreservation). Each carries a
# get-leg witness whose derived put is discharged by EXECUTION in the
# authored-correspondence gate, so the rung is a checked witness rather than a
# prose claim. These records are meta-level: the pipeline re-projects every
# authored logic:Correspondence into the graph/correspondence-laws named graph
# with its executed lens-law verdicts attached, OUTSIDE object-level closure.
# Both endpoints are internal gmeow: terms — this is the medium's OWN round-trip
# law, not a grounding to an external formalism (external grounding is owned by
# logic:/lang:/math: alone, docs/GROUNDING.md), so no competing grounding is
# minted here and the zstd/GTS-SPEC references stay prose citations.

gmeow:mediumCorrBaselineL12
    a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "baseline-L12 medium losslessness correspondence"@x-gmeow-english ;
    skos:definition "The judged crossing realized by gmeow:mediumProfileBaselineL12: decoding an unprimed zstd-rsyncable level-12 payload recovers the declared content domain exactly (dec ∘ enc = id). The preservation judgment is identity; the rung is a section/retraction because the recovery claim is over the CONTENT domain, not over every byte string the codec could emit."@x-gmeow-english ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint gmeow:PayloadSchema ;
    logic:targetEndpoint gmeow:MediumEnvelope ;
    logic:morphismClass logic:SectionRetraction ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true ;
    logic:getLeg gmeow:mediumCorrBaselineL12Get .

gmeow:mediumCorrBaselineL12Get gmeow:path gmeow:mediumCorrBaselineL12Step .

gmeow:mediumCorrDistL12
    a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "dist-L12 medium losslessness correspondence"@x-gmeow-english ;
    skos:definition "The judged crossing realized by gmeow:mediumProfileDistL12: decoding a dictionary-primed zstd-rsyncable level-12 payload, with the dictionary the frame declares, recovers the declared content domain exactly (dec ∘ enc = id). Priming changes the CODE, never the content: the same content domain is recovered, which is why the preservation judgment is identity and the dictionary appears as a coordinate of the crossing rather than as a caveat on it. The claim is conditional on holding the cited dictionary — a decoder that cannot resolve it raises gmeow:MediumUnknownDictionary and refuses, so the law is never silently weakened to a dictionary-less decode."@x-gmeow-english ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint gmeow:PayloadSchema ;
    logic:targetEndpoint gmeow:MediumEnvelope ;
    logic:morphismClass logic:SectionRetraction ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true ;
    logic:getLeg gmeow:mediumCorrDistL12Get .

gmeow:mediumCorrDistL12Get gmeow:path gmeow:mediumCorrDistL12Step .

gmeow:mediumCorrStoreL12
    a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "store-L12 medium losslessness correspondence"@x-gmeow-english ;
    skos:definition "The judged crossing realized by gmeow:mediumProfileStoreL12: decoding a payload primed with the dictionary the SEGMENT HEADER pins recovers the declared content domain exactly (dec ∘ enc = id). It differs from gmeow:mediumCorrDistL12 only in where the dictionary is resolved from — one entry per segment rather than one per registered payload schema — which is why it is a separate judged crossing rather than a caveat on that one: a store carries no gmeow:PayloadSchema registry, so its recovery claim is conditional on the segment header alone."@x-gmeow-english ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint gmeow:PayloadSchema ;
    logic:targetEndpoint gmeow:MediumEnvelope ;
    logic:morphismClass logic:SectionRetraction ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true ;
    logic:getLeg gmeow:mediumCorrStoreL12Get .

gmeow:mediumCorrStoreL12Get gmeow:path gmeow:mediumCorrStoreL12Step .

# --- The five shipped dictionaries and their corpora ------------------------- #
# WHY FIVE. The inventory was first drafted from SLICE NAMES and carried eight
# entries. Three of them were retired by MEASUREMENT against the bundle's ACTUAL
# FRAME LAYOUT, and the three retirements agree on one rule:
#
#   A gmeow:CompressionDictionary is justified by the FRAME SET it primes, and it
#   must PAY FOR ITS OWN IN-BAND BYTES on that set. Slice topology is not frame
#   topology, and topical importance is not a justification.
#
# The three cases, each a different way for a slice-shaped dictionary to fail that
# rule:
#
#   * "gmeow-math-v1" primed ZERO frames. The mathematical content ships as named
#     graphs UNIONED INTO THE SNAPSHOT PAYLOAD, which is ONE frame already primed
#     in full by gmeow-core-v1, and a second dictionary cannot prime part of one
#     frame. It was trained, measured, pinned in the segment header, and projected
#     onto a committed .zdict that no payload ever cited.
#   * "gmeow-claims-v1" primed exactly ONE frame of roughly nine kilobytes (the
#     yaml-ld-archive). Its best cell on the whole (strategy × target-length) grid
#     coded that frame at 12,020 B against a no-dictionary baseline of 8,953 B:
#     with a population that small, the smallest dictionary the trainer will build
#     already costs more than the frame it primes.
#   * "gmeow-lang-ast-v1" primed THREE frames and still lost by 3,684 B at its best
#     cell — a real but far-too-small saving against its own in-band bytes.
#
# Retiring them is a CORRECTION, not a descope. NOT ONE FRAME LOSES COMPRESSION:
# gmeow:payloadSchemaYamlLdArchive, gmeow:payloadSchemaLangProjectionsArchive and
# gmeow:payloadSchemaLangSurfaceBlob are now primed by gmeow:dictGmeowCoreV1, which
# still pays for itself over the widened population it primes. Nothing is orphaned
# — no rep is left citing a retired id — and the bundle sheds the in-band bytes of
# two dictionaries that could not stand on their own. Every entry below names at
# least one gmeow:PayloadSchema through gmeow:payloadSchemaDictionary, or is bound
# by a gmeow:mediumSourceHeaderDict medium whose frames a CONSUMER writes.
#
# EVERY corpus is BUNDLE-INTERNAL. The two memory dictionaries train on the
# BUNDLE-SHIPPED claim corpora (generated/statements/*, the authoring packets),
# never on a user's runtime ~/.gmeow/memory.gts, for three independent reasons,
# each sufficient on its own: (1) PRIVACY — a zstd dictionary contains VERBATIM
# SUBSTRINGS of its training corpus, so training on live user memory would bake
# private claim fragments into a published bundle; (2) AVAILABILITY — a fresh
# install has an empty store, so a build that needed one would hard-fail on the
# machine that most needs the dictionary; (3) PROJECTION PURITY — the bundle must
# be a projection of the repository, and a dictionary trained on out-of-tree data
# is not one. The memory dictionaries are therefore priming aids derived from the
# SHAPE of shipped claims, not from any user's content.

gmeow:corpusGmeowCoreV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "core corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal core-tier corpus: the cell/projection TTL sources the carrier folds as cells-archive, plus the authored core slice tree. Bundle-internal — the archive rep is owned by gmeow:stage-archive-blobs and the prefix is in-repo."@x-gmeow-english ;
    gmeow:corpusSelectsBlobRep "cells-archive" ;
    gmeow:corpusSelectsPathPrefix "slices/core/" ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:corpusGmeowLogicV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "logic corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal logic corpus: the compiled logic/DL projection surface the carrier folds as axioms-archive, plus the authored logic: slice tree. Bundle-internal — the archive rep is owned by gmeow:stage-archive-blobs and the prefix is in-repo."@x-gmeow-english ;
    gmeow:corpusSelectsBlobRep "axioms-archive" ;
    gmeow:corpusSelectsPathPrefix "slices/grounding/logic/" ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:corpusGmeowMemoryCompactV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "compact memory corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal SMALL-STORE memory corpus: the shipped authoring-packet graph and its committed projection. It trains on BUNDLE-SHIPPED claim material, NEVER on a user's runtime ~/.gmeow/memory.gts — a zstd dictionary carries verbatim substrings of its corpus, so training on live user memory would publish private claim fragments in the bundle, would hard-fail on a fresh install whose store is empty, and would not be a projection of the repository. What the dictionary learns is the SHAPE of shipped claims, not anyone's content."@x-gmeow-english ;
    gmeow:corpusSelectsGraph <https://blackcatinformatics.ca/gmeow/graph/authoring-briefs> ;
    gmeow:corpusSelectsPathPrefix "generated/briefs/" ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:corpusGmeowMemoryHotV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "hot memory corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal HOT-PATH memory corpus: the shipped statement projection plus the authoring-packet graph. It trains on BUNDLE-SHIPPED claim material, NEVER on a user's runtime ~/.gmeow/memory.gts — a zstd dictionary carries verbatim substrings of its corpus, so training on live user memory would publish private claim fragments in the bundle, would hard-fail on a fresh install whose store is empty, and would not be a projection of the repository. What the dictionary learns is the SHAPE of shipped claims, not anyone's content."@x-gmeow-english ;
    gmeow:corpusSelectsGraph <https://blackcatinformatics.ca/gmeow/graph/authoring-briefs> ;
    gmeow:corpusSelectsPathPrefix "generated/statements/" ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:corpusGmeowProoftraceV1
    a gmeow:DictionaryCorpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "proof-trace corpus v1"@x-gmeow-english ;
    skos:definition "The bundle-internal reasoning-report corpus. The reasoning archive (reasoning-archive) is SINK-FOLDED — it is assembled only at the terminal snapshot — so this corpus selects gmeow:stage-reason's product directly, which carries the explanations and the DL/EL ledger mid-DAG where the trainer runs."@x-gmeow-english ;
    gmeow:corpusSelectsStageProduct gmeow:stage-reason ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictGmeowCoreV1
    a gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "gmeow-core-v1 dictionary"@x-gmeow-english ;
    skos:definition "The shipped dictionary for core-tier payloads: the gmeow: namespace stem, the SKOS/RDFS annotation predicates, and the core class and property names dominate their byte profile. It is the WIDEST population of the shipped inventory — the cells/generated/opaque archives plus the three reps whose slice-shaped dictionaries were retired for failing to pay for their own in-band bytes (gmeow:payloadSchemaYamlLdArchive, gmeow:payloadSchemaLangProjectionsArchive, gmeow:payloadSchemaLangSurfaceBlob) — and it was re-swept over exactly that widened frame set rather than assumed to survive absorbing it."@x-gmeow-english ;
    gmeow:dictionaryId "gmeow-core-v1" ;
    gmeow:dictionaryVersion "1" ;
    gmeow:dictionaryStrategy gmeow:dictStrategyTrained ;
    gmeow:dictionaryTargetLength 65536 ;
    gmeow:trainsOverCorpus gmeow:corpusGmeowCoreV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictGmeowLogicV1
    a gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "gmeow-logic-v1 dictionary"@x-gmeow-english ;
    skos:definition "The shipped dictionary for compiled logic payloads: logic: formula, restriction, and constraint structures plus the DL projection vocabulary dominate their byte profile."@x-gmeow-english ;
    gmeow:dictionaryId "gmeow-logic-v1" ;
    gmeow:dictionaryVersion "1" ;
    gmeow:dictionaryStrategy gmeow:dictStrategyTrained ;
    gmeow:dictionaryTargetLength 65536 ;
    gmeow:trainsOverCorpus gmeow:corpusGmeowLogicV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:dictGmeowMemoryCompactV1
    a gmeow:CompressionDictionary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "gmeow-memory-compact-v1 dictionary"@x-gmeow-english ;
    skos:definition "The shipped SMALL-STORE memory dictionary, built as a term table rather than a trained sample because a compact store offers too few bytes for the COVER trainer to beat the ontology's own term vocabulary. Trained ONLY on bundle-shipped claim material (see gmeow:corpusGmeowMemoryCompactV1) — never on a user's runtime store."@x-gmeow-english ;
    gmeow:dictionaryId "gmeow-memory-compact-v1" ;
    gmeow:dictionaryVersion "1" ;
    gmeow:dictionaryStrategy gmeow:dictStrategyTermTable ;
    gmeow:dictionaryTargetLength 16384 ;
    gmeow:trainsOverCorpus gmeow:corpusGmeowMemoryCompactV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

