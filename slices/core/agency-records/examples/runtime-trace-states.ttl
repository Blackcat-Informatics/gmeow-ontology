    gmeow:subEventOf ex:episode .

ex:toolResult a gmeow:Event ;
    gmeow:eventType gmeow:eventTypeTraceToolResult ;
    gmeow:subEventOf ex:episode .

ex:toolReceipt a gmeow:Event ;
