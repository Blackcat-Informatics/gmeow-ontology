      <termEntry id="c-88032116e6cb14e8">
        <langSet xml:lang="en">
          <tig>
            <term>Harmonic Component</term>
          </tig>
          <tig>
            <term>harmonic component</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Composante harmonique</term>
