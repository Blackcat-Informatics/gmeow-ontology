@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix vcardx: <https://blackcatinformatics.ca/vcard-ext/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/vcard> a align:Alignment ;
    rdfs:label "GMEOW → vcard (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "PostalAddress → vcard:Address (component rename + composed vcard:label)"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:PostalAddress ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri vcard:Address ] ;
            align:relation "=" ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnComposeAddress ] ],
        [ a align:Cell ;
            rdfs:label "Birth life-event date → vcard:bday"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:compose ( [ a edoal:Relation ;
                                edoal:inverse [ a edoal:Relation ;
                                        edoal:uri gmeow:participationParticipant ] ] [ a edoal:Relation ;
                                edoal:uri gmeow:participationEvent ] [ a edoal:Relation ;
                                edoal:uri gmeow:eventTime ] ) ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri vcard:bday ] ;
            align:relation "<=" ;
            edoal:measure 9.5e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnBirthEventToDate ] ],
        [ a align:Cell ;
            rdfs:label "displayable fullName → vcard:fn"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:fullName ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri vcard:fn ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnSelectDisplayName ] ],
        [ a align:Cell ;
            rdfs:label "contact-point email address → vcard:hasEmail"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasContactPoint ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri vcard:hasEmail ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "nickname-purpose PersonName → vcard:nickname"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasName ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri vcard:nickname ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnNicknameName ] ],
        [ a align:Cell ;
            rdfs:label "gmeow:description → vcard:note"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:description ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri vcard:note ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ],
        [ a align:Cell ;
            rdfs:label "PronounSet five forms → vCard PRONOUNS display text (RFC 9554 extension)"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasPronounSet ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri vcardx:pronouns ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnPronounSetToText ] ],
        [ a align:Cell ;
            rdfs:label "Membership Role → vcard:title"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:compose ( [ a edoal:Relation ;
                                edoal:inverse [ a edoal:Relation ;
                                        edoal:uri gmeow:membershipMember ] ] [ a edoal:Relation ;
                                edoal:uri gmeow:hasRole ] [ a edoal:Relation ;
                                edoal:or ( [ a edoal:Relation ;
                                            edoal:uri rdfs:label ] [ a edoal:Relation ;
                                            edoal:uri gmeow:name ] ) ] ) ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri vcard:title ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnMembershipToJobTitle ] ],
        [ a align:Cell ;
            rdfs:label "hasWebPage → vcard:hasURL (the WebPage IRI)"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasWebPage ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri vcard:hasURL ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnWebPageToUrl ] ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "vcard" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
