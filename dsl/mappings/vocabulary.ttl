# =============================================================================
# Migrated procedural + declarative constraints: the closed-world shapes from
# shapes/mapping-dsl-shapes.ttl, re-expressed as canonical logic: records
# (Principle 17). The authored shapes stay (additive); the sweep verifies.
#
# Two authoring regimes: the TOP-LEVEL typed cells
# (gmeow:DeclinedCorrespondence, gmeow:ProjectionMapping, gmeow:MappingSet,
# gmeow:ProjectionFunction, gmeow:OptionalGroup, the 7 property-path classes)
# are explicitly `a`-typed, so their requiredness is authored with
# logic:DisjunctiveRequirednessConstraint's logic:onClass. The STRUCTURAL
# blank-node children (gmeow:MappingPattern, gmeow:PatternAtom,
# gmeow:TemplateAtom, gmeow:ProfileBinding, Bind/Mint, gmeow:Expression,
# the ValueClassMap entry) are reached only by sh:targetSubjectsOf /
# sh:targetObjectsOf in the legacy shapes (typically untyped blank nodes), so
# their constraints are raw logic:Constraint records guarded by the anchoring
# property itself — the kernel gmeow:UseForConsumerTargetConstraint idiom.
# =============================================================================

# --- DeclinedCorrespondence ---------------------------------------------------- #

gmeow:DeclinedCorrespondenceTargetRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "DeclinedCorrespondence target requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:DeclinedCorrespondence must carry exactly one gmeow:declinedTarget."@x-gmeow-english ;
    logic:onClass gmeow:DeclinedCorrespondence ;
    logic:anyOf gmeow:declinedTarget ;
    logic:formalizes gmeow:DeclinedCorrespondence ;
    logic:message "declinedTarget must be a single spelled-out label"@x-gmeow-english .

gmeow:DeclinedCorrespondenceTargetPatternConstraint
    a logic:Constraint ;
    rdfs:label "DeclinedCorrespondence target pattern constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:declinedTarget value is at least 4 characters long, never the bare acronym EFO, and never a URI."@x-gmeow-english ;
    logic:formalizes gmeow:DeclinedCorrespondence ;
    logic:message "declinedTarget must be a single spelled-out label (never the bare acronym EFO, which collides with the Experimental Factor Ontology; never a URI, which would smuggle a dead IRI past Principle 5)"@x-gmeow-english ;
    logic:integrity logic:dctForall .
logic:dctForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] ;
    logic:forall logic:dctImpl .
logic:dctImpl a logic:Formula ; logic:antecedent logic:dctGuard ; logic:consequent logic:dctAnd .
logic:dctGuard a logic:Formula ; logic:and logic:dctType , logic:dctHas .
logic:dctType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:DeclinedCorrespondence ] .
logic:dctHas a logic:Formula ; logic:relation gmeow:declinedTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .
logic:dctAnd a logic:Formula ; logic:and logic:dctMinLen , logic:dctNotEfo , logic:dctNotUri .
logic:dctMinLen a logic:Formula ; logic:relation logic:termRegex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "v" ] , [ logic:termIndex 1 ; logic:termLiteral "^.{4,}" ] .
logic:dctNotEfo a logic:Formula ; logic:not logic:dctEfoMatch .
logic:dctEfoMatch a logic:Formula ; logic:relation logic:termRegex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "v" ] , [ logic:termIndex 1 ; logic:termLiteral "(?i)\\bEFO\\b" ] .
logic:dctNotUri a logic:Formula ; logic:not logic:dctUriMatch .
logic:dctUriMatch a logic:Formula ; logic:relation logic:termRegex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "v" ] , [ logic:termIndex 1 ; logic:termLiteral "^https?://" ] .

gmeow:DeclinedCorrespondenceIntendedRelationRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "DeclinedCorrespondence intended-relation requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:DeclinedCorrespondence must carry exactly one gmeow:intendedRelation."@x-gmeow-english ;
    logic:onClass gmeow:DeclinedCorrespondence ;
    logic:anyOf gmeow:intendedRelation ;
    logic:formalizes gmeow:DeclinedCorrespondence ;
    logic:message "DeclinedCorrespondence must have exactly one gmeow:intendedRelation (the SKOS relation a bridge would have used)"@x-gmeow-english .

gmeow:DeclinedCorrespondenceRationaleRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "DeclinedCorrespondence rationale requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:DeclinedCorrespondence must carry exactly one non-empty gmeow:declineRationale."@x-gmeow-english ;
    logic:onClass gmeow:DeclinedCorrespondence ;
    logic:anyOf gmeow:declineRationale ;
    logic:formalizes gmeow:DeclinedCorrespondence ;
    logic:message "DeclinedCorrespondence must have exactly one non-empty gmeow:declineRationale"@x-gmeow-english .

gmeow:DeclinedCorrespondenceNamespaceRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "DeclinedCorrespondence candidate-namespace requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:DeclinedCorrespondence must carry at least one gmeow:candidateNamespace."@x-gmeow-english ;
    logic:onClass gmeow:DeclinedCorrespondence ;
    logic:anyOf gmeow:candidateNamespace ;
    logic:formalizes gmeow:DeclinedCorrespondence ;
    logic:message "DeclinedCorrespondence must carry at least one gmeow:candidateNamespace (a probed base string, for a reproducible re-probe)"@x-gmeow-english .

gmeow:DeclinedCorrespondenceVerdictRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "DeclinedCorrespondence probe-verdict requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:DeclinedCorrespondence must carry exactly one gmeow:probeVerdict."@x-gmeow-english ;
    logic:onClass gmeow:DeclinedCorrespondence ;
    logic:anyOf gmeow:probeVerdict ;
    logic:formalizes gmeow:DeclinedCorrespondence ;
    logic:message "DeclinedCorrespondence must have exactly one gmeow:probeVerdict (the dated liveness finding)"@x-gmeow-english .

gmeow:DeclinedCorrespondenceRevisitRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "DeclinedCorrespondence revisit-condition requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:DeclinedCorrespondence must carry exactly one gmeow:revisitCondition."@x-gmeow-english ;
    logic:onClass gmeow:DeclinedCorrespondence ;
    logic:anyOf gmeow:revisitCondition ;
    logic:formalizes gmeow:DeclinedCorrespondence ;
    logic:message "DeclinedCorrespondence must have exactly one gmeow:revisitCondition"@x-gmeow-english .

gmeow:DeclinedCorrespondenceContentCarriedByRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "DeclinedCorrespondence content-carried-by requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:DeclinedCorrespondence must name at least one gmeow:contentCarriedBy witness term."@x-gmeow-english ;
    logic:onClass gmeow:DeclinedCorrespondence ;
    logic:anyOf gmeow:contentCarriedBy ;
    logic:formalizes gmeow:DeclinedCorrespondence ;
    logic:message "DeclinedCorrespondence must name at least one in-slice gmeow:contentCarriedBy witness term (the positive coverage that makes the decline safe)"@x-gmeow-english .

gmeow:DeclinedCorrespondencePreservationUnsupportedConstraint
    a logic:Constraint ;
    rdfs:label "DeclinedCorrespondence preservationKind fixed-value constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:DeclinedCorrespondence must carry logic:preservationKind logic:Unsupported."@x-gmeow-english ;
    logic:formalizes gmeow:DeclinedCorrespondence ;
    logic:message "DeclinedCorrespondence must carry logic:preservationKind logic:Unsupported (the honest 'cannot be expressed in the target' polarity)"@x-gmeow-english ;
    logic:integrity logic:dcpForall .
logic:dcpForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:dcpImpl .
logic:dcpImpl a logic:Formula ; logic:antecedent logic:dcpGuard ; logic:consequent logic:dcpHasValue .
logic:dcpGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:DeclinedCorrespondence ] .
logic:dcpHasValue a logic:Formula ; logic:relation logic:preservationKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri logic:Unsupported ] .

# --- ProjectionMapping --------------------------------------------------------- #

gmeow:ProjectionMapping logic:subClassOf [
    a logic:Restriction ;
    logic:onProperty rdfs:label ;
    logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ;
] .

gmeow:ProjectionMappingPatternRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "ProjectionMapping pattern requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:ProjectionMapping must carry exactly one gmeow:hasMappingPattern."@x-gmeow-english ;
    logic:onClass gmeow:ProjectionMapping ;
    logic:anyOf gmeow:hasMappingPattern ;
    logic:formalizes gmeow:ProjectionMapping ;
    logic:message "ProjectionMapping must have exactly one gmeow:hasMappingPattern"@x-gmeow-english .

gmeow:ProjectionMappingBindingRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "ProjectionMapping binding requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:ProjectionMapping must carry at least one gmeow:hasBinding."@x-gmeow-english ;
    logic:onClass gmeow:ProjectionMapping ;
    logic:anyOf gmeow:hasBinding ;
    logic:formalizes gmeow:ProjectionMapping ;
    logic:message "ProjectionMapping must have at least one gmeow:hasBinding"@x-gmeow-english .

