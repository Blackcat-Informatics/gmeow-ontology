# Class-local structural obligations preserve the existing owner sorts.
gmeow:MemoryItem logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:memoryText ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( rdf:langString rdf:dirLangString ) ] ] .
gmeow:Summary logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:summaryText ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( rdf:langString rdf:dirLangString ) ] ] .
gmeow:Summary logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:summaryAnchor ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( rdf:langString rdf:dirLangString ) ] ] .
gmeow:BodyDistillation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:distilledText ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( rdf:langString rdf:dirLangString ) ] ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BodyDistillation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/distilledText" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:BodyDistillation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:distillationFor ; logic:allValuesFrom gmeow:Agent ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BodyDistillation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/distillationFor" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:BodyDistillation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:wasAttributedTo ; logic:allValuesFrom gmeow:Agent ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BodyDistillation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasAttributedTo" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:BodyDistillation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:wasDerivedFrom ; logic:allValuesFrom logic:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BodyDistillation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasDerivedFrom" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:BodyDistillation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:distillationFor ; logic:allValuesFrom gmeow:Agent ] .
gmeow:BodyDistillation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:distillationFor ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:Agent ] .
gmeow:BankReview logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:reviewedRevision ; logic:allValuesFrom gmeow:MemoryItem ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BankReview ; logic:closureKey "https://blackcatinformatics.ca/gmeow/reviewedRevision" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:BankReview logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:reviewedRevision ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:MemoryItem ] .
gmeow:BankReview logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:readToEnd ; logic:allValuesFrom xsd:boolean ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BankReview ; logic:closureKey "https://blackcatinformatics.ca/gmeow/readToEnd" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:BankReview logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:readToEnd ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:boolean ] .
gmeow:BankReview logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:reviewDisposition ; logic:allValuesFrom gmeow:BankReviewDisposition ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BankReview ; logic:closureKey "https://blackcatinformatics.ca/gmeow/reviewDisposition" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:BankReview logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:wasAssociatedWith ; logic:allValuesFrom gmeow:Agent ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BankReview ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasAssociatedWith" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:BankReview logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:eventTime ; logic:allValuesFrom xsd:dateTime ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BankReview ; logic:closureKey "https://blackcatinformatics.ca/gmeow/eventTime" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:CurationEpoch logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:curationManifest ; logic:allValuesFrom gmeow:InformationObject ] .
