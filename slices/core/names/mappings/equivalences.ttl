# Pronoun linkage — Wikidata's 'personal pronoun set' model (verified live against
# the Wikidata API). closeMatch, not exactMatch: GMEOW carries the set's full
# declension (five forms for English), Wikidata's P6553 values are lexemes.
# broadMatch to the grammatical 'pronoun' concept is a hint, never materialized
# by saturation.
gmeow:PronounSet skos:closeMatch wd:Q65067284 {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Wikidata 'personal pronoun set' — third-person pronouns an individual wants used; its Sept-2025 RfC favours full-declension pronoun sets (modelling each set's forms, not a single lexeme), aligning with GMEOW's reified five-form English model"
|} .

gmeow:hasPronounSet skos:closeMatch wdt:P6553 {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Wikidata 'personal pronoun' property (P6553); lossy — its values are lexemes, GMEOW's range is the full five-form PronounSet"
|} .

gmeow:PronounSet skos:broadMatch wd:Q36224 {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "Wikidata 'pronoun' — broader grammatical category; a hint, not an equivalence"
|} .

# Place naming (place-naming design). A place's toponyms are co-equal gmeow:PlaceName
# appellations borne via gmeow:hasPlaceName; the time/audience/authority-scoped use
# is the DEFINED gmeow:PlaceNaming (≡ NameUsage ⊓ ∃usageNamed.Place). gmeow:PlaceName
# is CIDOC-CRM's E48 Place Name; the relator itself, like gmeow:NameUsage, has no
# clean external class (Principle 5 — bridge honestly, do not force one).

gmeow:PlaceName skos:closeMatch crm:E48_Place_Name {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "CIDOC-CRM E48 Place Name — the appellation borne by a place (CRM's E53 Place)"
|} .

gmeow:hasPlaceName skos:broadMatch gn:name {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "GeoNames gn:name — lossy: gn:name links a feature to a name LITERAL, gmeow:hasPlaceName to a structured PlaceName object"
|} .

gmeow:hasPlaceName skos:broadMatch schema:name {|
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "schema:name — downcast: a place's structured name objects flatten to the schema:name literal in projection (non-selected names → schema:alternateName)"
|} .

# nameLanguage now points at a first-class gmeow:Language (was a BCP-47 literal).
gmeow:nameLanguage skos:closeMatch dcterms:language {|
