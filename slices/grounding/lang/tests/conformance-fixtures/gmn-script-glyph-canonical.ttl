# Conforming GMN fixture: a canonical glyph table. One grapheme (⊑) in the GMN script
# carries a canonical codepoint-explicit spelling (gmeow:gmnCodepoints "U+2291") and its
# operator form is bound to a denoted term through a full lang:Denotation record. Two
# further glyphs demonstrate the ONE lawful codepoint reuse: they share "U+03BC" (μ) but
# BOTH carry a gmeow:gmnSigilScope, so the sigil-scoped exemption of
# lang:GmnGlyphCollisionShape holds and no collision fires. Every grapheme is grounded in
# the script's repertoire (lang:GraphemeGroundedShape) and every codepoint value is
# canonical (lang:GmnCodepointCanonicalShape / lang:GmnScriptCodepointPresenceShape).

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

# ── The ⊑ glyph, codepoint-explicit, in the GMN script's repertoire ─────────
gmeow:gmnScript lang:hasGrapheme ex:gSquareImage , ex:gMuSigil , ex:gMuMeasure .

ex:gSquareImage a lang:Grapheme ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+2291" .

# ── Its operator form denotes the subsumption relation through a Denotation ──
ex:squareImageForm a lang:WordForm ;
    lang:inSignSystem gmeow:gmnModelNotation .

ex:denSquareImage a lang:Denotation ;
    lang:denotedForm ex:squareImageForm ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget <http://www.w3.org/2000/01/rdf-schema#subClassOf> ;
    lang:denotationContext ex:gmnGlyphTableContext .

# ── The sigil-scoped exemption: two μ glyphs, one codepoint, both scoped ────
ex:gMuSigil a lang:Grapheme ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+03BC" ;
    gmeow:gmnSigilScope gmeow:gmnSigilMath .

ex:gMuMeasure a lang:Grapheme ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+03BC" ;
    gmeow:gmnSigilScope gmeow:gmnSigilLogic .
