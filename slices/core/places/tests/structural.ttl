# --- 85. ICRS, FK5, Galactic frames exist with celestial realm (MUST) ---------
ex:saIcrsFk5GalacticFrames a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:referenceFrameICRS a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmCelestial ;
        gmeow:hasMetricKind gmeow:metricGeodesic .
    gmeow:referenceFrameFK5 a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmCelestial ;
        gmeow:hasMetricKind gmeow:metricGeodesic .
    gmeow:referenceFrameGalactic a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmCelestial ;
        gmeow:hasMetricKind gmeow:metricGeodesic .
}""" ;
    gmeow:saRationale "ICRS, FK5, and Galactic reference frames MUST exist with celestial realm and geodesic metric." .

# --- 86. CelestialCoordinates has RA, Dec, epoch DatatypeProperties (MUST) ----
ex:saCelestialCoordsProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:rightAscension a owl:DatatypeProperty ;
        rdfs:domain gmeow:CelestialCoordinates .
    gmeow:declination a owl:DatatypeProperty ;
        rdfs:domain gmeow:CelestialCoordinates .
    gmeow:celestialEpoch a owl:DatatypeProperty ;
        rdfs:domain gmeow:CelestialCoordinates .
}""" ;
    gmeow:saRationale "gmeow:rightAscension, declination, and celestialEpoch MUST be DatatypeProperties with domain CelestialCoordinates." .

