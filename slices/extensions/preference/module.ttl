# F4 — same inputs ⇒ same digest: two receipts sharing source-set, kind, and
# tie-break rule must carry identical content digests.
gmeow:DeterministicDigestConstraint
    a logic:Constraint ;
    rdfs:label "Deterministic digest constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC4/F4): two gmeow:ProjectionReceipts with the SAME gmeow:projectionSourceSet, gmeow:projectionKind, and gmeow:tieBreakRule MUST carry the SAME gmeow:contentDigest — a genuine same-inputs⇒same-digest witness, not mere tie-break disclosure. (Fixture digest-consistency is the ontology's job; bit-reproducibility of the recomputation remains the consumer's, Principle 12.) A ∀→¬∃ formula testing two same-input receipts with distinct digests, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:ProjectionReceipt ;
    logic:severity "Violation" ;
    logic:message "Two gmeow:ProjectionReceipts sharing gmeow:projectionSourceSet, gmeow:projectionKind, and gmeow:tieBreakRule must carry the same gmeow:contentDigest (same inputs ⇒ same digest, F4)." ;
    logic:integrity gmeow:ddcForall .
gmeow:ddcForall a logic:Formula ;
    rdfs:label "ddcForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:DeterministicDigestConstraint (AC4/F4, deterministic digest): binds ?this and requires ?this is a gmeow:ProjectionReceipt → ¬[gmeow:ddcBad]."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:ddcImpl .
gmeow:ddcImpl a logic:Formula ;
    rdfs:label "ddcImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:DeterministicDigestConstraint (AC4/F4, deterministic digest): when ?this is a gmeow:ProjectionReceipt holds, requires ¬[∃?other,?ss,?pk,?tb,?d1,?d2. gmeow:ddcBadBody]."@x-gmeow-english ; logic:antecedent gmeow:ddcGuard ; logic:consequent gmeow:ddcNot .
gmeow:ddcGuard a logic:Formula ;
    rdfs:label "ddcGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:DeterministicDigestConstraint (AC4/F4, deterministic digest): asserts ?this is a gmeow:ProjectionReceipt."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ProjectionReceipt ] .
gmeow:ddcNot a logic:Formula ;
    rdfs:label "ddcNot (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The negation within gmeow:DeterministicDigestConstraint (AC4/F4, deterministic digest): holds only when it is NOT the case that ∃?other,?ss,?pk,?tb,?d1,?d2. ?other is a gmeow:ProjectionReceipt ∧ gmeow:projectionSourceSet(?this, ?ss) ∧ gmeow:projectionSourceSet(?other, ?ss) ∧ gmeow:projectionKind(?this, ?pk) ∧ gmeow:projectionKind(?other, ?pk) ∧ gmeow:tieBreakRule(?this, ?tb) ∧ gmeow:tieBreakRule(?other, ?tb) ∧ gmeow:contentDigest(?this, ?d1) ∧ gmeow:contentDigest(?other, ?d2) ∧ ?d1 ≠ ?d2."@x-gmeow-english ; logic:not gmeow:ddcBad .
gmeow:ddcBad a logic:Formula ;
    rdfs:label "ddcBad (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:DeterministicDigestConstraint (AC4/F4, deterministic digest): quantifies ?other, ?ss, ?pk, ?tb, ?d1, ?d2 and requires ?other is a gmeow:ProjectionReceipt ∧ gmeow:projectionSourceSet(?this, ?ss) ∧ gmeow:projectionSourceSet(?other, ?ss) ∧ gmeow:projectionKind(?this, ?pk) ∧ gmeow:projectionKind(?other, ?pk) ∧ gmeow:tieBreakRule(?this, ?tb) ∧ gmeow:tieBreakRule(?other, ?tb) ∧ gmeow:contentDigest(?this, ?d1) ∧ gmeow:contentDigest(?other, ?d2) ∧ ?d1 ≠ ?d2."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "ss" ] , [ logic:termIndex 2 ; logic:termVariable "pk" ] , [ logic:termIndex 3 ; logic:termVariable "tb" ] , [ logic:termIndex 4 ; logic:termVariable "d1" ] , [ logic:termIndex 5 ; logic:termVariable "d2" ] ;
    logic:exists gmeow:ddcBadBody .
gmeow:ddcBadBody a logic:Formula ;
    rdfs:label "ddcBadBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:DeterministicDigestConstraint (AC4/F4, deterministic digest): conjoins ?other is a gmeow:ProjectionReceipt ∧ gmeow:projectionSourceSet(?this, ?ss) ∧ gmeow:projectionSourceSet(?other, ?ss) ∧ gmeow:projectionKind(?this, ?pk) ∧ gmeow:projectionKind(?other, ?pk) ∧ gmeow:tieBreakRule(?this, ?tb) ∧ gmeow:tieBreakRule(?other, ?tb) ∧ gmeow:contentDigest(?this, ?d1) ∧ gmeow:contentDigest(?other, ?d2) ∧ ?d1 ≠ ?d2."@x-gmeow-english ;
    logic:and gmeow:ddcOtherType , gmeow:ddcSS1 , gmeow:ddcSS2 , gmeow:ddcPK1 , gmeow:ddcPK2 , gmeow:ddcTB1 , gmeow:ddcTB2 , gmeow:ddcD1 , gmeow:ddcD2 , gmeow:ddcDigestDiffer .
