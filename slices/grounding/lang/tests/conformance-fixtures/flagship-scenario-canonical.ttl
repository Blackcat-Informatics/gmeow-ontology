#
# Well-formed: a gmeow:FlagshipScenario binding all realizing/enforcing artifacts — a
# worked example, a competency question, a producer, a counter-example, and an enforcing
# failure class that IS a lang:LangConformanceFailure subclass (lang:UnderspecifiedDenotation,
# resolved against module.ttl). Conforms to the lang: slice's thin lang:FlagshipScenarioShape
# (its failure-range sh:sparql passes) and to the shared gmeow:FlagshipScenarioShape's
# cardinalities, so it validates with no findings.
# Bound by ex:ecFlagshipCanonical.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix ex:   <http://example.org/lang/> .

ex:wiredScenario a gmeow:FlagshipScenario ;
    gmeow:demonstratedByExample "tests/conformance-fixtures/meaning-cats-chase-mice.ttl" ;
    gmeow:demonstratedByCompetency <https://blackcatinformatics.ca/gmeow/examples/lang/tests/cqDenotationsToFormula> ;
    gmeow:demonstratedByProducer "pipeline::stages::lang_lowering::build_corpus" ;
    gmeow:guardedByCounterExample "tests/counter-examples/meaning-underspecified-denotation.ttl" ;
    gmeow:enforcesFailureClass lang:UnderspecifiedDenotation .
