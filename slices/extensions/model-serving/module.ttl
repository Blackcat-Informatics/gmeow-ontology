    skos:definition "The learned model has a distinct identity from its served artifact; every declared training problem names a typed LossFunction objective."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve artifact/model identity and validate explicitly declared training objectives."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid requiring training metadata when no training problem is declared."@x-gmeow-english ;
    gmeow:howToUse "Validate distinct model identity and every declared loss objective together with the inherited Function profile."@x-gmeow-english ;
    skos:scopeNote "Optional training problems are checked only when declared; the mathematical Function owner supplies loss domain and codomain requirements."@x-gmeow-english ;
    skos:example "ex:problem math:objectiveFunction ex:loss . ex:loss a math:LossFunction ; math:domain ex:pairs ; math:codomain ex:values ."@x-gmeow-english ;
    logic:formalizes gmeow:LearnedModelArtifact ; logic:message "The learned model has a distinct identity from its served artifact; every declared training problem names a typed LossFunction objective." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "a" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ], [ logic:termIndex 1 ; logic:termIri gmeow:LearnedModelArtifact ] ] ; logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "m" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ], [ logic:termIndex 1 ; logic:termIri gmeow:LearnedModelArtifact ] ], [ a logic:Formula ; logic:relation gmeow:artifactLearnedModel ; logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ], [ logic:termIndex 1 ; logic:termVariable "m" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termDistinct ; logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ], [ logic:termIndex 1 ; logic:termVariable "m" ] ] ] ], [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ], [ logic:termIndex 1 ; logic:termIri gmeow:LearnedModelArtifact ] ], [ a logic:Formula ; logic:relation gmeow:artifactTrainingProblem ; logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ], [ logic:termIndex 1 ; logic:termVariable "p" ] ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "loss" ] ; logic:exists [ a logic:Formula ; logic:relation math:objectiveFunction ; logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ], [ logic:termIndex 1 ; logic:termVariable "loss" ] ] ] ] ], [ a logic:Formula ; logic:quantifiedVariable [ 