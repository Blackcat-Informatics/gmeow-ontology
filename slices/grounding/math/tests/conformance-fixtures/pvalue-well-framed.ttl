#
# Clean conformance fixture for math:IllFramedPValueShape (Rule I1) and
# math:AlternativeSidednessValueShape (Rule I2): a math:PValue that carries its whole
# frame — a math:testStatistic (a math:Statistic), a math:nullHypothesis, a
# math:nullDistribution that is a PARAMETERIZED math:SamplingDistribution (a
# math:Distribution: normal family + mean/stddev parameterization, one
# math:DistributionParameter per required role, matching the probability.ttl idiom), a
# math:alternativeSidedness that IS one of the six lawful math:Sidedness individuals
# (math:twoSidedAlternative), and math:pValue → a FRAMED math:ProbabilityValue. Because
# every arm is present, the SPARQL frame gate stays SILENT; because the sidedness is
# lawful, the sh:in gate stays SATISFIED. The p-value's magnitude 3/100 is carried, per
# the exact-rational discipline, as a math:RationalValue with a gmeow:hasReferenceFrame,
# so its value satisfies math:ProbabilityValueRangeShape (0 ≤ 3/100 ≤ 1),
# math:ProbabilityValueFramedShape (a reference frame), math:ProbabilityScaleDisjointShape,
# and math:RationalValueShape. The null distribution is well-formed, so the P6a/P6b/P7
# distribution gates stay silent. It MUST raise NO failure class.
# Positive counterpart of counter-examples/pvalue-missing-sidedness.ttl.
# Bound by tests/example-conformance.ttl (ex:ecPValueWellFramed).
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <http://example.org/math/> .

ex:tTestPValue a math:PValue ;
    math:testStatistic ex:tStatistic ;
    math:nullHypothesis ex:noEffectNull ;
    math:nullDistribution ex:tNullDistribution ;
    math:alternativeSidedness math:twoSidedAlternative ;
    math:pValue ex:pValueMagnitude .

ex:tStatistic a math:Statistic .
ex:noEffectNull a math:NullHypothesis .

# The null distribution: the distribution of the statistic UNDER the null, a
# parameterized sampling distribution (a math:Distribution) with family + convention.
ex:tNullDistribution a math:SamplingDistribution ;
    math:distributionFamily ex:normalFamily ;
    math:distributionParameterization ex:meanStddevParameterization ;
    math:hasDistributionParameter ex:meanParam , ex:stddevParam .

ex:normalFamily a math:DistributionFamily .

ex:meanStddevParameterization a math:DistributionParameterization ;
    math:requiresParameterRole ex:meanRole , ex:stddevRole .

ex:meanRole a math:DistributionParameterRole .
ex:stddevRole a math:DistributionParameterRole .

ex:meanParam a math:DistributionParameter ;
    math:parameterRole ex:meanRole .

ex:stddevParam a math:DistributionParameter ;
    math:parameterRole ex:stddevRole .

# The p-value magnitude: a FRAMED probability value, exact 3/100 = 0.03 in [0, 1].
ex:pValueMagnitude a math:ProbabilityValue , math:RationalValue ;
    math:numerator 3 ;         # 3/100 = 0.03, within [0, 1]
    math:denominator 100 ;
    gmeow:hasReferenceFrame ex:samplingFrame .

ex:samplingFrame a gmeow:ReferenceFrame .
<http://example.org/math/pValueMagnitude> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/dimensionless> .
