    gmeow:referenceFrameURL  gmeow:parentFrame gmeow:referenceFrameInternet .
    gmeow:referenceFramePort gmeow:parentFrame gmeow:referenceFrameInternet .
    gmeow:referenceFrameBGP  gmeow:parentFrame gmeow:referenceFrameInternet .
}""" ;
    gmeow:saRationale "The seven network reference frames MUST have gmeow:parentFrame gmeow:referenceFrameInternet. Mirrors test_network_reference_frames_have_parent_frame." .

