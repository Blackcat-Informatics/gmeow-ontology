    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "criterion" ; gmeow:cellValueIri exd:c1Latency ] .
ex:cqCrossSliceComposeNormsRow2 a gmeow:ExpectedRow ;
