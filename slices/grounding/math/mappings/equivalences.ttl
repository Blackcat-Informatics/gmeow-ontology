    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "A001113" ;
    gmeow:comment "OEIS A001113 is the decimal expansion of e — a locator for the digits of math:eulerNumber, a related resource rather than the constant's identity, so skos:relatedMatch. Link-only (OEIS is CC BY-SA 4.0, aligned by reference)." ;
    gmeow:sssomFile "gmeow-oeis.sssom.tsv" .

gmeow:eqMathEulerMascheroniOeis a gmeow:TermEquivalence ;
    gmeow:alignSubject math:eulerMascheroni ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://oeis.org/A001620> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
