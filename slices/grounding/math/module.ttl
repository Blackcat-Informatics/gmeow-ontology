    [ a owl:Restriction ; owl:onProperty math:decomposesFlow ; owl:allValuesFrom math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:exactComponent ; owl:minQualifiedCardinality 1 ; owl:onClass math:ExactComponent ] ,
    [ a owl:Restriction ; owl:onProperty math:exactComponent ; owl:maxQualifiedCardinality 1 ; owl:onClass math:ExactComponent ] ,
    [ a owl:Restriction ; owl:onProperty math:exactComponent ; owl:allValuesFrom math:ExactComponent ] ,
    [ a owl:Restriction ; owl:onProperty math:coexactComponent ; owl:minQualifiedCardinality 1 ; owl:onClass math:CoexactComponent ] ,
    [ a owl:Restriction ; owl:onProperty math:coexactComponent ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CoexactComponent ] ,
    [ a owl:Restriction ; owl:onProperty math:coexactComponent ; owl:allValuesFrom math:CoexactComponent ] ,
    [ a owl:Restriction ; owl:onProperty math:harmonicComponent ; owl:minQualifiedCardinality 1 ; owl:onClass math:HarmonicComponent ] ,
    [ a owl:Restriction ; owl:onProperty math:harmonicComponent ; owl:maxQualifiedCardinality 1 ; owl:onClass math:HarmonicComponent ] ,
    [ a owl:Restriction ; owl:onProperty math:harmonicComponent ; owl:allValuesFrom math:HarmonicComponent ] ,
    [ a owl:Restriction ; owl:onProperty math:hodgeBoundaryOperator ; owl:minQualifiedCardinality 1 ; owl:onClass math:BoundaryOperator ] ,
    [ a owl:Restriction ; owl:onProperty math:hodgeBoundaryOperator ; owl:maxQualifiedCardinality 1 ; owl:onClass math:BoundaryOperator ] ,
    [ a owl:Restriction ; owl:onProperty math:hodgeBoundaryOperator ; owl:allValuesFrom math:BoundaryOperator ] ,
    [ a owl:Restriction ; owl:onProperty math:overSheaf ; owl:minQualifiedCardinality 1 ; owl:onClass math:CellularSheaf ] ,
    [ a owl:Restriction ; owl:onProperty math:overSheaf ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CellularSheaf ] ,
    [ a owl:Restriction ; owl:onProperty math:overSheaf ; owl:allValuesFrom math:CellularSheaf ] ,
