#[name("https://example.org/bench/rules/scc-path-base")]
<https://example.org/bench/path>(?s, ?o, ?w) :- <https://example.org/bench/edge>(?s, ?o, ?w) .
#[name("https://example.org/bench/rules/scc-path-step")]
<https://example.org/bench/path>(?s, ?o, ?w) :- <https://example.org/bench/edge>(?s, ?m, ?w), <https://example.org/bench/path>(?m, ?o, ?w) .
#[name("https://example.org/bench/rules/scc-same-component")]
<https://example.org/bench/same_component>(?s, ?o, ?w) :- <https://example.org/bench/path>(?s, ?o, ?w), <https://example.org/bench/path>(?o, ?s, ?w) .
