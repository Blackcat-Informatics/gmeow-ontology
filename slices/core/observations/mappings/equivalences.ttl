@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix iso19156: <http://www.isotc211.org/iso19156/> .
@prefix crmarc: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix om: <http://www.wurvoc.org/vocabularies/om-1.8/> .
@prefix oboe: <http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#> .
@prefix obi: <http://purl.obolibrary.org/obo/OBI_> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix obscore: <http://www.ivoa.net/rdf/ObsCore#> .
@prefix bbc: <http://www.bbc.co.uk/ontologies/news/> .
@prefix iptc: <http://iptc.org/std/NewsML-G2/> .
@prefix loinc: <http://loinc.org/rdf/> .
@prefix snomed: <http://snomed.info/id/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences for the observation domain — GMEOW authoring source.
# Compiled to mappings/gmeow-observations.sssom.tsv by `gmeow compile-mappings`.
# Aligns SOSA/SSN (W3C/OGC), PROV-O (W3C), CIDOC-CRM E13 (ISO 21127),
# O&M (ISO 19156), CRMarchaeo, OM (Ontology of Units of Measure), OBOE,
# PATO, OBI, and QB.

gmeow:mapsetObservations a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/observations" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Observation stack alignments: SOSA/SSN, PROV-O, CIDOC-CRM E13. The gmeow:vantage property has no direct SOSA counterpart (sosa:madeBySensor is device-centric, not standpoint-centric); the alignment is closeMatch with a note. math:Quantity and math:quantityValue are the sole quantity/value authorities; their SOSA, OM, IVOA, LOINC, and QUDT grounding correspondences are authored by the math slice in mappings/quantity-bridges.ttl, while this catalog owns observation qualifiers and domain roles. Added: StandpointClaim → sosa:Observation; Agent → sosa:Sensor (the observer/sensor/perceiver is a standpoint). Added (observation-spine bridge): IdentityFacet, NameUsage, RightsStatement, and KinRelationship → sosa:Observation (universal claim construct); facetSubject / facetVantage → sosa:hasFeatureOfInterest / sosa:madeBySensor. Added (stream-to-trajectory design): Stream → sosa:ObservationCollection; streamSample → sosa:hasMember; Agent → sosa:Platform; streamSensor → sosa:madeBySensor; streamInterval → sosa:phenomenonTime; Observation → sosa:Sampling. Added (spatial-measurement design): SpatialMeasurement and CoordinateObservation → sosa:Observation, iso19156:OM_Observation / OM_GeometryObservation, crmarc:S4_Observation; coordinateResult / geometryResult → sosa:hasResult. Added (sensory slice): Sensor → sosa:Sensor (precise alignment, superseding Agent broadMatch); SensorPlatform → sosa:Platform (precise alignment, superseding Agent relatedMatch); ObservableProperty → sosa:ObservableProperty; SensoryQuantity → sosa:Result; sensoryProperty → sosa:observedProperty; platformLocation → geo:location; Sensor → obi:device; observationMethod → oboe:Protocol / obi:assay; ObservableProperty → oboe:Characteristic / pato:quality; SensoryObservation → qb:Observation; unit → om:hasUnit.".

# --------------------------------------------------------------------------- #
# SOSA / SSN
# --------------------------------------------------------------------------- #

gmeow:Observation skos:closeMatch sosa:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:observedFeature skos:closeMatch sosa:hasFeatureOfInterest {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:observationResult skos:closeMatch sosa:hasResult {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:vantage skos:closeMatch sosa:madeBySensor {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "SOSA is device-centric; gmeow:vantage covers human standpoints, organizations, and sensors alike. CloseMatch with a note."
|} .

gmeow:observationMethod skos:closeMatch sosa:usedProcedure {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:ObservationMethod skos:closeMatch sosa:Procedure {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:Measurement skos:closeMatch sosa:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "A Measurement is a kind of Observation; SOSA does not distinguish them."
|} .

gmeow:StandpointClaim skos:closeMatch sosa:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "SOSA does not distinguish observation types; a standpoint claim is a kind of observation, and the standpoint-indexed statement realises sosa:Observation."
|} .

gmeow:Agent skos:broadMatch sosa:Sensor {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "An agent acting as vantage/observer/perceiver IS a standpoint (Principle 9). sosa:Sensor is device-centric and narrower; the alignment bridges the SOSA sensor concept to the broader GMEOW agent-as-standpoint doctrine."
|} .

# Added (observation-spine bridge) — universal claim construct: all relator subclasses align to SOSA.
gmeow:IdentityFacet skos:closeMatch sosa:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "SOSA does not distinguish observation types; an identity claim (gender, expression, orientation) is a kind of observation in the universal stack."
|} .

gmeow:NameUsage skos:closeMatch sosa:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "SOSA does not distinguish observation types; a naming claim is a kind of observation in the universal stack."
|} .

gmeow:RightsStatement skos:closeMatch sosa:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "SOSA does not distinguish observation types; a rights claim is a kind of observation in the universal stack."
|} .

gmeow:facetSubject skos:closeMatch sosa:hasFeatureOfInterest {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "facetSubject is the observedFeature of an identity claim; aligns to SOSA's feature of interest."
|} .

gmeow:facetVantage skos:closeMatch sosa:madeBySensor {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "facetVantage is the asserting agent of an identity claim; aligns to SOSA's sensor (device-centric, broader via broadMatch on Agent)."
|} .

# Added (stream-to-trajectory design) — SOSA streaming alignments

gmeow:Stream skos:closeMatch sosa:ObservationCollection {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "SOSA has no first-class Stream; ObservationCollection is the closest grouping construct."
|} .

gmeow:streamSample skos:closeMatch sosa:hasMember {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Stream sample is a member of the observation collection."
|} .


gmeow:streamSensor skos:closeMatch sosa:madeBySensor {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Per-stream vs per-observation sensor attribution."
|} .

gmeow:Observation skos:broadMatch sosa:Sampling {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "A sampling act is a kind of observation; GMEOW models it through observationTypeSampling."
|} .

gmeow:Agent skos:relatedMatch sosa:Platform {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "An agent hosting sensors can act as a platform (broader than the sosa:Sensor alignment in eqObs018)."
|} .

gmeow:streamInterval skos:closeMatch sosa:phenomenonTime {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Stream interval vs per-observation phenomenon time."
|} .

# --------------------------------------------------------------------------- #
# PROV-O
# --------------------------------------------------------------------------- #

gmeow:Observation skos:closeMatch prov:Entity {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "An Observation is a relator (gufo), but as a named individual it is also a prov:Entity that can be attributed, derived, and versioned."
|} .

gmeow:vantage skos:closeMatch prov:wasAttributedTo {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "prov:wasAttributedTo is a property, gmeow:vantage is a property; the alignment is on the semantic axis (who is responsible), not structural identity."
|} .

gmeow:observationResult skos:closeMatch prov:generated {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Inverse direction: prov:wasGeneratedBy links Entity to Activity; gmeow:observationResult links Observation to its result Entity. Semantic alignment, not structural identity."
|} .

# --------------------------------------------------------------------------- #
# CIDOC-CRM E13 Attribute Assignment
# --------------------------------------------------------------------------- #

gmeow:Observation skos:closeMatch crm:E13_Attribute_Assignment {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "CIDOC-CRM E13 Attribute Assignment is the closest CRM class for an observation: it is both the activity of assigning an attribute and, in GMEOW terms, the observation that results from such an activity. The event perspective is aligned to gmeow:ObservationalActivity in the events mapping set."
|} .

gmeow:observedFeature skos:closeMatch crm:P140_assigned_attribute_to {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:observationResult skos:closeMatch crm:P141_assigned {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:vantage skos:closeMatch crm:P14_carried_out_by {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "crm:P14 is event-centric; gmeow:vantage is relator-centric. Semantic alignment on 'who performed it'."
|} .

gmeow:observationMethod skos:closeMatch crm:P33_used_specific_technique {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

# --------------------------------------------------------------------------- #
# spatial-measurement design — SpatialMeasurement / CoordinateObservation alignments
# --------------------------------------------------------------------------- #

# SOSA

gmeow:SpatialMeasurement skos:closeMatch sosa:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "SOSA does not distinguish spatial measurement types; SpatialMeasurement is a kind of Observation."
|} .

gmeow:CoordinateObservation skos:closeMatch sosa:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "SOSA does not distinguish coordinate observation types; CoordinateObservation is a kind of Observation."
|} .

gmeow:coordinateResult skos:closeMatch sosa:hasResult {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "coordinateResult is the GeoCoordinates-specific subproperty of observationResult; aligns to SOSA's generic hasResult."
|} .

gmeow:geometryResult skos:closeMatch sosa:hasResult {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "geometryResult is the Geometry-specific subproperty of observationResult; aligns to SOSA's generic hasResult."
|} .

# O&M (ISO 19156)

gmeow:SpatialMeasurement skos:closeMatch iso19156:OM_Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "ISO 19156 O&M is the conceptual geographic standard that inspired SOSA/SSN. SpatialMeasurement aligns to the generic OM_Observation."
|} .

gmeow:CoordinateObservation skos:closeMatch iso19156:OM_GeometryObservation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "ISO 19156 O&M GeometryObservation is the closest O&M class for coordinate/geometry assignment."
|} .

# CRMarchaeo

gmeow:CoordinateObservation skos:closeMatch crmarc:S4_Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "CRMarchaeo S4 Observation covers stratigraphic and spatial observations in archaeological context."
|} .

# StandpointTenure observation design — StandpointClaim as Observation: claimModality maps to SOSA result.

gmeow:claimModality skos:closeMatch sosa:hasResult {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "the modality result of a standpoint claim is the SOSA result of the observation (StandpointTenure observation design)"
|} .

# --------------------------------------------------------------------------- #
# sensory slice — Sensory module alignments (SOSA/SSN, OBOE, PATO, OBI, OM, QB)
# (the sensory-owned SUBJECT alignments — Sensor/SensorPlatform/
# ObservableProperty/SensoryQuantity/sensoryProperty/platformLocation — are
# authored in slices/extensions/sensory/mappings/equivalences.ttl; only the
# observations-owned generic properties/classes this observation-stack design
# also touches remain here)
# --------------------------------------------------------------------------- #

# OBOE — Extensible Observation Ontology

gmeow:observationMethod skos:closeMatch oboe:Protocol {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "The procedure or protocol used to make an observation."
|} .

gmeow:observedFeature skos:closeMatch oboe:Entity {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "OBOE Entity is broader (any entity); GMEOW observedFeature is the specific entity whose property is being observed."
|} .

# OBI — Ontology for Biomedical Investigations

gmeow:observationMethod skos:closeMatch obi:0000070 {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "OBI assay (OBI:0000070) is a planned process with the objective to produce information about some evaluant. Aligns to the procedure/method of an observation."
|} .

# QB — RDF Data Cube

gmeow:SensoryObservation skos:closeMatch qb:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "QB Observation is contextual — a SensoryObservation becomes a QB Observation when it is part of a qb:DataSet / qb:Slice. The alignment is closeMatch with context note."
|} .

# OM — Ontology of Units of Measure (complementing existing QUDT alignment)

gmeow:unit skos:closeMatch om:hasUnit {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OM models om:hasUnit as the property relating a measure to its om:Unit; gmeow:unit is the parallel property edge (a quantity to its unit IRI), so the alignment stays property-to-property. GMEOW unit points to QUDT by default, with OM as an alternative by reference."
|} .

# --------------------------------------------------------------------------- #
# observation-linkage design / observation activity alignment comment — ObservationalActivity alignments (OBI, OBOE, QB).
# --------------------------------------------------------------------------- #

gmeow:ObservationalActivity skos:closeMatch obi:0000011 {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "OBI investigation (OBI:0000011) is a planned process with the objective to produce information about some evaluant — the closest OBI class for a structured observational activity such as a clinical trial or survey."
|} .

gmeow:Observation skos:closeMatch oboe:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OBOE Observation is the core observation construct in the Extensible Observation Ontology; GMEOW Observation unifies it with measurement, standpoint claim, and identity claim."
|} .

gmeow:ObservationalActivity skos:relatedMatch qb:DataSet {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "An ObservationalActivity that produces aggregate statistical data (e.g. a census) projects to an RDF Data Cube DataSet. Related match because the activity and the dataset are distinct: one generates the other."
|} .

# --------------------------------------------------------------------------- #
# archaeological-domain model — Domain-specific observation profiles
# --------------------------------------------------------------------------- #

# Archaeological — CRMarchaeo
gmeow:ObservationalActivity skos:relatedMatch crmarc:A1_Excavation_Process_Unit {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "CRMarchaeo A1 Excavation Process Unit is the closest class for an observational activity whose event type is excavation. Related match because A1 is specifically about destructive excavation, not any observational activity."
|} .

gmeow:Observation skos:closeMatch crmarc:S4_Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "CRMarchaeo S4 Observation is the closest CRM class for a stratigraphic or physical-layer observation."
|} .

gmeow:ObservedFeature skos:closeMatch crmarc:A2_Stratigraphic_Volume_Unit {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "CRMarchaeo A2 Stratigraphic Volume Unit is the physical layer being observed in an archaeological context."
|} .

# Astronomical — IVOA / ObsCore
gmeow:SensoryObservation skos:closeMatch obscore:ObsDataset {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "IVOA ObsCore ObsDataset is the closest class for an astronomical observation dataset."
|} .

gmeow:hasReferenceFrame skos:relatedMatch obscore:coordsys {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "IVOA ObsCore coordsys carries coordinate system metadata for celestial reference frames. Related match because GMEOW hasReferenceFrame is more general (spatial, temporal, and celestial frames)."
|} .

# Media / Journalism — BBC + IPTC + OA
gmeow:StandpointClaim skos:relatedMatch bbc:NewsEvent {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "BBC NewsEvent is a reported real-world event; GMEOW StandpointClaim generalises this to any standpoint-indexed claim, not only news."
|} .

gmeow:vantage skos:relatedMatch iptc:Assertor {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "IPTC Assertor is the person or organisation making the claim; GMEOW vantage is broader (human, machine, organisational, or sensor standpoint)."
|} .

gmeow:ObservationalActivity skos:relatedMatch iptc:NewsMessage {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "IPTC NewsMessage is the report container; GMEOW ObservationalActivity is broader than journalism (science, archaeology, clinical trials, etc.)."
|} .

gmeow:StandpointClaim skos:relatedMatch oa:Annotation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "Open Annotation Annotation is the closest W3C construct for a standpoint-indexed claim with body (the claim) and target (the observed feature). The projection layer provides the directional mapping to oa:hasBody / oa:hasTarget."
|} .

# Clinical — LOINC + SNOMED CT
gmeow:SensoryObservation skos:relatedMatch loinc:LabTest {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "LOINC LabTest is the closest LOINC class for a laboratory test observation. Related match because GMEOW SensoryObservation covers any sensory/perceptual observation, not only lab tests."
|} .

gmeow:ObservationMethod skos:closeMatch loinc:Method {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "LOINC Method describes how a laboratory test was performed; close match to GMEOW ObservationMethod in clinical contexts."
|} .

gmeow:ObservedFeature skos:relatedMatch snomed:116154003 {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "SNOMED CT Patient is the subject of a clinical observation. Related match because observedFeature is more general (any entity, not only patients)."
|} .

gmeow:SensoryObservation skos:relatedMatch snomed:404684003 {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "SNOMED CT ClinicalFinding is an observation interpreted as a diagnosis or finding."
|} .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:StandpointClaim skos:closeMatch schema:Claim {|
    gmeow:sssomFile "gmeow-ai.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "schema:Claim is the fact-check-markup claim; a StandpointClaim carries vantage/modality/confidence the schema.org term lacks — the projection emits text + appearance and NO reviewRating"
|} .

gmeow:StandpointClaim skos:closeMatch crminf:I2_Belief {|
    gmeow:sssomFile "gmeow-ai.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "CRMinf's belief (a proposition held by an agent) is the heritage-argumentation cousin of the standpoint-indexed claim; CRMinf adds inference-making machinery GMEOW keeps in the solver layer"
|} .

gmeow:StandpointClaim skos:relatedMatch np:Assertion {|
    gmeow:sssomFile "gmeow-ai.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "a nanopublication's assertion graph plays the claim-content role; nanopubs package assertion+provenance+pubinfo as named graphs where GMEOW uses RDF 1.2 statement annotations"
|} .

gmeow:StandpointClaim skos:closeMatch wd:Q2684591 {|
    gmeow:sssomFile "gmeow-ai.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata 'statement' — that which a true-or-false sentence asserts; curl-validated 2026-06-12"
|} .

gmeow:MonetaryAmount skos:closeMatch fibo-fnd-acc-cur:MonetaryAmount {|
    gmeow:sssomFile "gmeow-fibo.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a quantity of money expressed as a value in a currency"
|} .

gmeow:currency skos:closeMatch fibo-fnd-acc-cur:hasCurrency {|
    gmeow:sssomFile "gmeow-fibo.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "links a monetary amount to its currency frame (subproperty of hasReferenceFrame)"
|} .

gmeow:quantityUncertainty skos:closeMatch qudt:standardUncertainty {|
    gmeow:sssomFile "gmeow-qudt.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "QUDT's standard uncertainty is the estimated standard deviation of the mean; GMEOW's quantityUncertainty is the same concept, in the same unit as the quantity value."
|} .

gmeow:MonetaryAmount skos:closeMatch schema:MonetaryAmount {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a quantity of money; GMEOW makes the currency frame explicit via ReferenceFrame"
|} .

gmeow:monetaryValue skos:closeMatch schema:value {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "the numeric value of a monetary amount"
|} .

gmeow:currency skos:closeMatch schema:currency {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
