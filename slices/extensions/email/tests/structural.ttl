}""" ;
    gmeow:saRationale """gmeow:userAgent MUST be a DatatypeProperty with domain EmailMessage and range Literal.""" .

ex:saAutoSubmittedDatatypePropertyOnEmailMessage a gmeow:StructuralAssertion ;
