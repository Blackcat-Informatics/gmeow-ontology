#
# Well-formed: a math:Number situated in its number system and declaring exactness.
# Conforms to math:NumberSituatedShape. Bound by ex:ecNumberSituated.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <http://example.org/math/> .

ex:oneThird a math:RationalNumber ;
    math:inNumberSystem math:rationalNumbers ;
    math:isExact true .
