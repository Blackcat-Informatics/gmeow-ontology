}""" ;
    gmeow:saRationale "gmeow:VideoConference, ChatSpace, Website, SocialMediaPage MUST NOT exist as owl:Class -- permanently refactored to VirtualLocationType value individuals. Mirrors test_virtual_location_type_is_value_not_subclass (rejected part)." .

# --- 70. NetworkAddress grounding (MUST) --------------------------------------
ex:saNetworkAddressGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NetworkAddress       a owl:Class .
    gmeow:hasNetworkAddress    rdfs:domain gmeow:VirtualLocation ;
                               rdfs:range  gmeow:NetworkAddress .
    gmeow:networkAddressType   rdfs:domain gmeow:NetworkAddress ;
                               rdfs:range  gmeow:NetworkAddressType .
    gmeow:networkAddressValue  rdfs:domain gmeow:NetworkAddress .
    gmeow:networkAddressFrame  rdfs:domain gmeow:NetworkAddress ;
                               rdfs:range  gmeow:ReferenceFrame ;
                               a owl:FunctionalProperty ;
                               rdfs:subPropertyOf gmeow:hasReferenceFrame .
}""" ;
    gmeow:saRationale "NetworkAddress class and all core properties MUST be grounded as specified. Mirrors test_network_address_grounding." .

# --- 71. NetworkAddressType subclasses logic:QualityValue (MUST) --------------
ex:saNetworkAddressTypeIsQualityValue a gmeow:StructuralAssertion ;
