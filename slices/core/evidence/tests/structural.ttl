#
# Declarative structural assertions for the evidence slice (#224) -- the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_evidence.py. Each assertion runs as a
# SPARQL ASK over the evidence module graph (gmeow:scopeModule) under the
# native Rust slicetest harness (crates/slicetest).
#
# Evidence is NOT yet #694-migrated: class stereotypes remain gufo:
# (gufo:AbstractIndividualType, gufo:Category), not logic:.
#
# RETAINED in pytest (not migratable here):
#   test_self_private_evidence_triggers_warning -- run_shacl() call with
#     warning-text assertions; ExampleConformance, not a TBox assertion.
#   test_mixed_evidence_does_not_trigger_self_private_warning -- run_shacl()
#     call; ExampleConformance, not a structural TBox assertion.
#   test_notability_without_triad_triggers_violation -- run_shacl() call with
#     error-text assertions; ExampleConformance, not a TBox assertion.
#   test_notability_with_full_triad_passes -- run_shacl() call;
#     ExampleConformance, not a structural TBox assertion.
#   test_notability_false_does_not_require_triad -- run_shacl() call;
#     ExampleConformance, not a structural TBox assertion.
#   test_infoworld_citation_passes -- loads fixture + run_shacl(); multi-file
#     dynamic ABox check, not a module-scoped TBox assertion.
#   test_orgbook_citation_passes -- loads fixture + run_shacl(); multi-file
#     dynamic ABox check, not a module-scoped TBox assertion.
#   test_private_contract_triggers_self_private_warning -- loads fixture +
#     run_shacl(); multi-file dynamic ABox check, not a TBox assertion.
#   test_orgbook_notability_mutation_triggers_violation -- loads fixture,
#     mutates graph, run_shacl(); dynamic ABox mutation, not a TBox assertion.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest->DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/evidence/tests/> .

# --- 1. EvidenceClass is a gufo:AbstractIndividualType value vocabulary (MUST) -
ex:saEvidenceClassIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:EvidenceClass a gufo:AbstractIndividualType , owl:Class ;
        rdfs:subClassOf gufo:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:EvidenceClass MUST be an owl:Class typed gufo:AbstractIndividualType and a subclass of gufo:QualityValue -- the class is a value vocabulary (individuals, never subclasses; Principle 9). Mirrors test_evidence_class_is_value_vocabulary (superclass part)." .

# --- 2. All 17 EvidenceClass seed individuals exist (MUST) --------------------
ex:saEvidenceClassSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:evidenceVERIFIED              a gmeow:EvidenceClass .
    gmeow:evidenceSELF                  a gmeow:EvidenceClass .
    gmeow:evidenceANECDOTAL             a gmeow:EvidenceClass .
    gmeow:evidenceRUMOR                 a gmeow:EvidenceClass .
    gmeow:evidenceIndependentTradePress a gmeow:EvidenceClass .
    gmeow:evidencePublicRegistry        a gmeow:EvidenceClass .
    gmeow:evidenceLegalFiling           a gmeow:EvidenceClass .
    gmeow:evidenceOfficialSource        a gmeow:EvidenceClass .
    gmeow:evidenceSelfControlledSite    a gmeow:EvidenceClass .
    gmeow:evidencePrivateScan           a gmeow:EvidenceClass .
    gmeow:evidenceFamilyNarrative       a gmeow:EvidenceClass .
    gmeow:evidenceGeneratedReport       a gmeow:EvidenceClass .
    gmeow:evidenceOcrExtract            a gmeow:EvidenceClass .
    gmeow:evidenceRawArchive            a gmeow:EvidenceClass .
    gmeow:evidencePrivateCorrespondence a gmeow:EvidenceClass .
    gmeow:evidenceSourceCodeArchive     a gmeow:EvidenceClass .
    gmeow:evidenceNewspaperLead         a gmeow:EvidenceClass .
}""" ;
    gmeow:saRationale "All 17 EvidenceClass seed individuals MUST be present as gmeow:EvidenceClass instances -- they are the open value vocabulary for evidential warrant (Axis A). Mirrors test_evidence_class_is_value_vocabulary (seeds positive part)." .

# --- 3. EvidenceClass seeds are NOT typed owl:Class (MUST-NOT) ----------------
ex:saEvidenceClassSeedsNotOwlClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?seed {
        gmeow:evidenceVERIFIED
        gmeow:evidenceSELF
        gmeow:evidenceANECDOTAL
        gmeow:evidenceRUMOR
        gmeow:evidenceIndependentTradePress
        gmeow:evidencePublicRegistry
        gmeow:evidenceLegalFiling
        gmeow:evidenceOfficialSource
        gmeow:evidenceSelfControlledSite
        gmeow:evidencePrivateScan
        gmeow:evidenceFamilyNarrative
        gmeow:evidenceGeneratedReport
        gmeow:evidenceOcrExtract
        gmeow:evidenceRawArchive
        gmeow:evidencePrivateCorrespondence
        gmeow:evidenceSourceCodeArchive
        gmeow:evidenceNewspaperLead
    }
    ?seed a owl:Class .
}""" ;
    gmeow:saRationale "No EvidenceClass seed individual MUST be typed owl:Class -- evidence classes are individuals (value vocabulary), never subclasses; minting a seed as owl:Class would violate Principle 9. Mirrors test_evidence_class_is_value_vocabulary (seeds mustNot-owl:Class part)." .

# --- 4. SourceIndependence is a gufo:AbstractIndividualType value vocab (MUST) -
ex:saSourceIndependenceIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SourceIndependence a gufo:AbstractIndividualType , owl:Class ;
        rdfs:subClassOf gufo:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:SourceIndependence MUST be an owl:Class typed gufo:AbstractIndividualType and a subclass of gufo:QualityValue -- it is the Axis B independence value vocabulary (individuals, never subclasses; Principle 9). Mirrors test_source_independence_is_value_vocabulary (superclass part)." .

# --- 5. SourceIndependence seed individuals exist (MUST) ----------------------
ex:saSourceIndependenceSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:sourceIndependenceIndependent          a gmeow:SourceIndependence .
    gmeow:sourceIndependenceSelfOrIssuerOriginated a gmeow:SourceIndependence .
}""" ;
    gmeow:saRationale "Both SourceIndependence seed individuals (independent, self-or-issuer-originated) MUST exist. Mirrors test_source_independence_is_value_vocabulary (seeds positive part)." .

# --- 6. SourceIndependence seeds are NOT typed owl:Class (MUST-NOT) -----------
ex:saSourceIndependenceSeedsNotOwlClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?seed {
        gmeow:sourceIndependenceIndependent
        gmeow:sourceIndependenceSelfOrIssuerOriginated
    }
    ?seed a owl:Class .
}""" ;
    gmeow:saRationale "No SourceIndependence seed individual MUST be typed owl:Class -- the values are individuals, never subclasses (Principle 9). Mirrors test_source_independence_is_value_vocabulary (seeds mustNot-owl:Class part)." .

