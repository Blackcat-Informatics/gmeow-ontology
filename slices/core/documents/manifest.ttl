<https://blackcatinformatics.ca/gmeow/slices/documents>
    a gmeow:Slice ;
    rdfs:label "documents"@x-gmeow-english ;
    skos:definition "The documents slice of the GMEOW ontology (core tier): GMEOW Documents Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
