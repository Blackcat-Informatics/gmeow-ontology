gmeow:payloadSchemaDocsPrint
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — docs print"@x-gmeow-english ;
    skos:definition "The print documentation projection: the byte-reproducible PDF and its deterministic Typst source."@x-gmeow-english ;
    gmeow:payloadSchemaId "docs-print" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ;
    gmeow:payloadSchemaDictionary gmeow:dictGmeowCoreV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:payloadSchemaGeneratedOpaqueArchive
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — generated opaque archive"@x-gmeow-english ;
    skos:definition "The opaque generated-fanout archive: the committed generated/ byte projections the superset gate reconstructs the tree from."@x-gmeow-english ;
    gmeow:payloadSchemaId "generated-opaque-archive" ;
