# --- A topology claim carries an attributed status --------------------------- #
gmeow:TopologyClaimStatusConstraint
    a logic:Constraint ;
    rdfs:label "Topology claim attributed-status constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:TopologyClaim MUST carry an attributed status — a gmeow:vantage attribution naming the standpoint/agent the computed feature is claimed FROM (gmeow:vantage ⊑ gmeow:accordingTo). An unattributed topology claim is an anonymous assertion, exactly what the local-vs-global discipline forbids: a computed feature lands as a vantage-attributed, defeasible claim (gmeow:TopologyClaimMissingStatus). A cross-node ∀→∃ formula scoped to gmeow:TopologyClaim, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:TopologyClaim ;
    gmeow:enforcesFailureClass gmeow:TopologyClaimMissingStatus ;
    logic:severity "Violation" ;
    logic:message "A gmeow:TopologyClaim must carry an attributed status through gmeow:vantage (the standpoint or agent the feature is claimed from); an unattributed topology claim is an anonymous assertion (gmeow:TopologyClaimMissingStatus)." ;
    logic:integrity gmeow:tcsForall .
gmeow:tcsForall a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "Topology-claim attributed-status formula"@x-gmeow-english ;
    skos:definition "The top-level ∀→∃ integrity formula of gmeow:TopologyClaimStatusConstraint: every gmeow:TopologyClaim must carry an attributed status through gmeow:vantage."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:tcsImpl .
gmeow:tcsImpl a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "claim-carries-vantage implication"@x-gmeow-english ;
    skos:definition "The guard→consequent implication of gmeow:TopologyClaimStatusConstraint: if ?this is a gmeow:TopologyClaim then it must satisfy the vantage-attribution existential."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:antecedent gmeow:tcsGuard ; logic:consequent gmeow:tcsExists .
gmeow:tcsGuard a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "topology-claim type guard"@x-gmeow-english ;
    skos:definition "The rdf:type guard of gmeow:TopologyClaimStatusConstraint: binds ?this to a gmeow:TopologyClaim, scoping the implication to topology claims."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termIri gmeow:TopologyClaim ] .
gmeow:tcsExists a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "vantage-attribution existential"@x-gmeow-english ;
    skos:definition "The existential body of gmeow:TopologyClaimStatusConstraint: asserts a vantage ?v the claim is attributed from."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "v" ] ;
    logic:exists gmeow:tcsAtom .
gmeow:tcsAtom a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "vantage atom"@x-gmeow-english ;
    skos:definition "The gmeow:vantage atom of gmeow:TopologyClaimStatusConstraint: the claim ?this names the standpoint/agent vantage ?v it is claimed from."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:vantage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termVariable "v" ] .

# --- The governing invariant: no raw topology result asserted as global truth  #
# A gmeow:TopologyComputation carrying gmeow:assertsGlobalTruth true is well-formed
# ONLY when a gmeow:TopologyClaim wraps it (gmeow:claimForComputation), extends its
# local data to a math:GlobalSection (gmeow:extendsToGlobalSection), AND discharges
# the H¹ math:GluingObstruction (gmeow:dischargesObstruction). A ∀→∃(∧∧) formula.
gmeow:AssertedTopologyResultConstraint
    a logic:Constraint ;
    rdfs:label "Asserted-topology-result constraint (no global truth without a discharged claim)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The GOVERNING closed-world integrity constraint: a computed topological feature is NEVER automatically a global truth. A gmeow:TopologyComputation that asserts a global truth (gmeow:assertsGlobalTruth true) is well-formed ONLY when a gmeow:TopologyClaim discharges it — a resource TYPED gmeow:TopologyClaim (never any resource that merely happens to carry the three edges) whose gmeow:claimForComputation names this computation, which extends its local data to a math:GlobalSection (gmeow:extendsToGlobalSection, H⁰) AND discharges the H¹ math:GluingObstruction (gmeow:dischargesObstruction). A raw result asserted as global truth WITHOUT a genuinely typed claim wrapper and a discharged obstruction is the forbidden pattern: the feature is a math:LocalSection and global truth holds only when it lifts. A cross-node ∀→∃ (join) formula, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:TopologyComputation ;
    logic:severity "Violation" ;
    logic:message "A gmeow:TopologyComputation asserting a global truth (gmeow:assertsGlobalTruth true) must be discharged by a resource TYPED gmeow:TopologyClaim that gmeow:claimForComputation it, gmeow:extendsToGlobalSection, and gmeow:dischargesObstruction; a raw result asserted as global truth without a genuinely typed claim wrapper and a discharged H¹ gluing obstruction is forbidden — a computed feature is a math:LocalSection, not a global truth." ;
    logic:integrity gmeow:artForall .
gmeow:artForall a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "Asserted-topology-result formula"@x-gmeow-english ;
    skos:definition "The top-level, GOVERNING ∀→∃(∧∧) integrity formula of gmeow:AssertedTopologyResultConstraint: a gmeow:TopologyComputation asserting a global truth must be discharged by a genuinely typed gmeow:TopologyClaim that extends its local data to a math:GlobalSection and discharges the H¹ math:GluingObstruction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:artImpl .
gmeow:artImpl a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "asserted-global-truth-discharged implication"@x-gmeow-english ;
    skos:definition "The guard→consequent implication of gmeow:AssertedTopologyResultConstraint: a computation asserting global truth must satisfy the discharged-claim existential."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:antecedent gmeow:artGuard ; logic:consequent gmeow:artDischarged .
gmeow:artGuard a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "computation-asserts-global-truth guard"@x-gmeow-english ;
    skos:definition "The antecedent conjunction of gmeow:AssertedTopologyResultConstraint: ?this is a gmeow:TopologyComputation AND it carries gmeow:assertsGlobalTruth true."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:and gmeow:artType , gmeow:artAsserts .
gmeow:artType a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "computation type guard"@x-gmeow-english ;
    skos:definition "The rdf:type guard of gmeow:AssertedTopologyResultConstraint: binds ?this to a gmeow:TopologyComputation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termIri gmeow:TopologyComputation ] .
gmeow:artAsserts a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "asserts-global-truth atom"@x-gmeow-english ;
    skos:definition "The gmeow:assertsGlobalTruth atom of gmeow:AssertedTopologyResultConstraint: the computation ?this flags its result as an asserted global truth (boolean true)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:assertsGlobalTruth ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral "true" ; logic:termLiteralDatatype xsd:boolean ] .
gmeow:artDischarged a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "discharged-claim existential"@x-gmeow-english ;
    skos:definition "The consequent existential of gmeow:AssertedTopologyResultConstraint: asserts a claim ?c, an obstruction ?g, and a global section ?sec witnessing that the asserted global truth is legitimately discharged."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "c" ] ,
        [ logic:termIndex 1 ; logic:termVariable "g" ] ,
        [ logic:termIndex 2 ; logic:termVariable "sec" ] ;
    logic:exists gmeow:artBody .
gmeow:artBody a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "discharged-claim conjunction"@x-gmeow-english ;
    skos:definition "The conjunction of gmeow:AssertedTopologyResultConstraint's existential: ?c is a typed gmeow:TopologyClaim, is the claim for this computation, discharges the obstruction, AND extends to a global section — all four."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:and gmeow:artClaimType , gmeow:artClaimFor , gmeow:artDischarge , gmeow:artExtends .
gmeow:artClaimType a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "discharging-claim type atom"@x-gmeow-english ;
    skos:definition "The rdf:type atom of gmeow:AssertedTopologyResultConstraint: the discharging resource ?c must be TYPED gmeow:TopologyClaim, never a resource that merely carries the discharge edges."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termIri gmeow:TopologyClaim ] .
gmeow:artClaimFor a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "claim-for-computation atom"@x-gmeow-english ;
    skos:definition "The gmeow:claimForComputation atom of gmeow:AssertedTopologyResultConstraint: the claim ?c is the claim for this very computation ?this."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:claimForComputation ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
gmeow:artDischarge a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "discharges-obstruction atom"@x-gmeow-english ;
    skos:definition "The gmeow:dischargesObstruction atom of gmeow:AssertedTopologyResultConstraint: the claim ?c discharges the H¹ math:GluingObstruction ?g."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:dischargesObstruction ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termVariable "g" ] .
gmeow:artExtends a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "extends-to-global-section atom"@x-gmeow-english ;
    skos:definition "The gmeow:extendsToGlobalSection atom of gmeow:AssertedTopologyResultConstraint: the claim ?c extends its local data to the math:GlobalSection ?sec (the H⁰ lift)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:extendsToGlobalSection ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termVariable "sec" ] .

# --- a computation result must not be conflated with a raw math: object ------ #
# A gmeow:TopologyComputation must NOT point gmeow:producesResult at a node that is
# itself typed in the math: namespace — the result must be a gmeow:TopologyResult
# wrapper that REFERENCES the math: object through gmeow:resultArtifact. A ∀→¬∃
# formula using the math: namespace prefix test (like the shipped flagship gate).
gmeow:ResultObjectConflationConstraint
    a logic:Constraint ;
    rdfs:label "Result-object conflation constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint with TWO conjoined obligations: a gmeow:TopologyComputation's gmeow:producesResult value MUST be TYPED gmeow:TopologyResult (the wrapper is POSITIVELY required, not merely permitted — an untyped or unrelated resource does not satisfy it), AND it must NOT itself be typed in the math: namespace — a computation result that IS a raw math: object (a math:PersistenceDiagram, a math:BettiSummary, …) has conflated the consumer-side result with the pure mathematical referent (gmeow:ResultObjectConflation). The result must be a genuine gmeow:TopologyResult wrapper referencing the math: object through gmeow:resultArtifact. A cross-node ∀→(∃∧¬∃) formula — a positive existential requiring the wrapper's type, conjoined with a negative existential testing for the math: namespace prefix — projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:TopologyComputation ;
    gmeow:enforcesFailureClass gmeow:ResultObjectConflation ;
    logic:severity "Violation" ;
    logic:message "A gmeow:TopologyComputation's gmeow:producesResult value must be TYPED gmeow:TopologyResult and must NOT itself be typed in the math: namespace; an untyped result, or one conflated with a raw math: object, is gmeow:ResultObjectConflation." ;
    logic:integrity gmeow:rocForall .
gmeow:rocForall a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "Result-object-conflation formula"@x-gmeow-english ;
    skos:definition "The top-level ∀→(∃∧¬∃) integrity formula of gmeow:ResultObjectConflationConstraint: a gmeow:TopologyComputation's gmeow:producesResult value must be typed gmeow:TopologyResult and must not itself be typed in the math: namespace."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:rocImpl .
gmeow:rocImpl a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "result-wrapper-not-conflated implication"@x-gmeow-english ;
    skos:definition "The guard→consequent implication of gmeow:ResultObjectConflationConstraint: if ?this is a gmeow:TopologyComputation then its result must be a typed wrapper and not a raw math: object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:antecedent gmeow:rocGuard ; logic:consequent gmeow:rocConsequent .
gmeow:rocGuard a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "computation type guard"@x-gmeow-english ;
    skos:definition "The rdf:type guard of gmeow:ResultObjectConflationConstraint: binds ?this to a gmeow:TopologyComputation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termIri gmeow:TopologyComputation ] .
gmeow:rocConsequent a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "wrapper-required-and-not-raw conjunction"@x-gmeow-english ;
    skos:definition "The consequent conjunction of gmeow:ResultObjectConflationConstraint: the positive existential requiring a typed gmeow:TopologyResult wrapper, conjoined with the negative existential forbidding a math:-namespace result."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:and gmeow:rocRequired , gmeow:rocNot .
gmeow:rocRequired a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "typed-wrapper existential"@x-gmeow-english ;
    skos:definition "The positive existential of gmeow:ResultObjectConflationConstraint: asserts a result ?r the computation produces that is typed gmeow:TopologyResult."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
