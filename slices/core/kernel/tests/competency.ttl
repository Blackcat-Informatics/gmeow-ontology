#
# Declarative competency questions authored as slice-resident test-DSL data,
# executed by the native Rust slice-test harness (crates/slicetest) over the
# full merged ontology, asserted lane (gmeow:reasoningNone).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/kernel/tests/> .

ex:cqOpenValueVocabularies a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/kernel/queries/competency/open-value-vocabularies.rq" ;
    gmeow:cqRationale "Mistaking an open value vocabulary for a sortal is the classic modelling error the kernel exists to prevent: a consumer who subclasses gmeow:Determinacy instead of attaching one of its individuals forks the vocabulary and breaks every downstream join. GMEOW must therefore answer 'which kernel classes are value vocabularies?' FROM THE GRAPH — via the logic:AbstractIndividualType typing that says members are individuals, not subclasses — rather than from prose a reader may skip. Retyping any of these stops the question answering." ;
    gmeow:cqResultShape ex:cqOvvShape ;
    gmeow:cqExpectRow ex:cqOvvAboutness , ex:cqOvvDeterminacy , ex:cqOvvDisclosure , ex:cqOvvGranularity .

ex:cqOvvShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "vocabulary" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:cqOvvAboutness a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vocabulary" ; gmeow:cellValueIri gmeow:AboutnessMode ] .
ex:cqOvvDeterminacy a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vocabulary" ; gmeow:cellValueIri gmeow:Determinacy ] .
ex:cqOvvDisclosure a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vocabulary" ; gmeow:cellValueIri gmeow:DisclosurePolicy ] .
ex:cqOvvGranularity a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vocabulary" ; gmeow:cellValueIri gmeow:GranularityLevel ] .
