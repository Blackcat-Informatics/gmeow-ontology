@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

gmeow:QuantitativeQualityAssessment
    a logic:SubKind , logic:Class ;
    logic:subClassOf gmeow:QualityAssessment ,
        [ a logic:Restriction ; logic:onProperty gmeow:observationResult ; logic:allValuesFrom math:Quantity ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "Quantitative Quality Assessment"@x-gmeow-english ;
    skos:definition "A quality assessment whose results are dimensioned quantities. Each result is a math:Quantity with its own physical or dimensionless dimension; the assessment remains an observation, distinct from the quantities it reports."@x-gmeow-english ;
    gmeow:useWhen "Use for measured quality magnitudes such as positional error, temporal error or a completeness ratio."@x-gmeow-english ;
    gmeow:avoidWhen "Use the base QualityAssessment for categorical conformance verdicts and AggregateQualityAssessment for estimated aggregate scores."@x-gmeow-english ;
    gmeow:howToUse "Provide at least one observationResult typed math:Quantity, with math:hasDimension and the measured math:quantityValue. Keep units, frames, method and vantage on the ordinary observation substrate."@x-gmeow-english ;
    skos:scopeNote "QualityDimension remains an open vocabulary of individuals. No fixed physical dimension is imposed on a broad ISO quality category, and multiple results and dimension classifications remain permitted."@x-gmeow-english ;
    skos:example "ex:assessment a gmeow:QuantitativeQualityAssessment ; gmeow:observationResult ex:ratio . ex:ratio a math:Quantity ; math:hasDimension math:dimensionless ; math:quantityValue 0.985 ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AggregateQualityAssessment
    a logic:SubKind , logic:Class ;
    logic:subClassOf gmeow:QualityAssessment ,
        [ a logic:Restriction ; logic:onProperty gmeow:observationResult ; logic:allValuesFrom math:Estimate ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "Aggregate Quality Assessment"@x-gmeow-english ;
    skos:definition "A quality assessment reporting estimated aggregate scores as math:Estimate results. Every estimate names its target and estimator and carries dimensioned quantity values; the assessment, result, procedure and target remain distinct objects."@x-gmeow-english ;
    gmeow:useWhen "Use for an aggregate quality score produced by a declared estimator over data."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a direct quality measurement or a categorical verdict. An aggregate assessment is never itself a math:Estimate."@x-gmeow-english ;
    gmeow:howToUse "Link observationResult to each math:Estimate; provide math:estimateValue quantities, typed math:Estimator procedures through math:estimator, and math:estimatesEstimand or math:estimatedParameter targets."@x-gmeow-english ;
    skos:scopeNote "Each aggregate result retains its own estimator, target and dimensioned values. Coexisting results are not paired with dimension classifications by a Cartesian assumption."@x-gmeow-english ;
    skos:example "ex:assessment a gmeow:AggregateQualityAssessment ; gmeow:observationResult ex:estimate . ex:estimate a math:Estimate ; math:estimateValue ex:score ; math:estimator ex:procedure ; math:estimatedParameter ex:meanCompleteness ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

[ a logic:ClosureEntry ; logic:onClass gmeow:QuantitativeQualityAssessment ;
  logic:closureKey "https://blackcatinformatics.ca/gmeow/observationResult" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:AggregateQualityAssessment ;
  logic:closureKey "https://blackcatinformatics.ca/gmeow/observationResult" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:QualityAssessment
    a logic:SubKind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "Quality Assessment"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:assessedEntity ;
            logic:someValuesFrom gmeow:Entity ;
        ] ;
    skos:definition "A reified assessment of the quality of an entity or dataset, expressed as an observation about one or more quality dimensions. The result is typically a scalar quantity (accuracy in metres, a normalized dimensionless completeness ratio, etc.) or a categorical conformance statement, carrying its dimension, any applicable unit and reference frame, determinacy, and provenance in the same bundle as every other GMEOW measurement (Principle 11)."@x-gmeow-english ;
    skos:example "ex:posAcc a gmeow:QualityAssessment ; gmeow:assessedEntity ex:roadLayer ; gmeow:qualityDimension gmeow:qualityDimensionPositionalAccuracy ; gmeow:observationResult ex:fiveMetres ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for ordinary measurements that are not quality judgements (use a plain gmeow:Observation) and for epistemic certainty about a claim (that is gmeow:confidence, not a quality assessment)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the assessment as gmeow:QualityAssessment, name the subject with gmeow:assessedEntity, the dimension(s) with gmeow:qualityDimension, and the verdict with gmeow:observationResult; reuse the Observation stack's method, vantage, dimension, and any applicable unit and frame rather than minting quality-specific copies."@x-gmeow-english ;
    gmeow:useWhen "Use to record a quality verdict about an entity or dataset along one or more ISO 19157 dimensions — positional/temporal/thematic accuracy, completeness, consistency, or lineage — as a first-class observation carrying its own result, method, and provenance."@x-gmeow-english .

gmeow:QualityDimension
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "Quality Dimension"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An ISO 19157 data-quality dimension or lineage category — an open value vocabulary of individuals (never subclasses). New dimensions (e.g. a domain-specific 'semantic consistency' or 'usability') are added by minting fresh individuals, not by creating new classes (Principle 9)."@x-gmeow-english ;
    skos:example "ex:usability a gmeow:QualityDimension ; rdfs:label \"usability\"@en ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid creating per-dimension subclasses (dimensions are individuals), avoid using it for the assessment itself (that is gmeow:QualityAssessment), and do not confuse it with the physical generic-quality vocabulary gmeow:GenericQuality (pressure, length) — this is the ISO 19157 DATA-quality axis, not a physical quality kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded dimension individuals from an assessment; extend the axis for a domain-specific quality concern by minting a fresh gmeow:QualityDimension individual rather than a subclass."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary for the data-quality axis — the seeded ISO 19157 dimensions plus lineage, referenced from a QualityAssessment via gmeow:qualityDimension."@x-gmeow-english .

gmeow:assessedEntity
    a logic:ObjectProperty ;
    rdfs:domain gmeow:QualityAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "assessed entity"@x-gmeow-english ;
    rdfs:range gmeow:Entity ;
    rdfs:subPropertyOf gmeow:observedFeature ;
    skos:definition "The entity whose data quality is being assessed — the feature of interest of the quality observation. Sub-property of gmeow:observedFeature so generic consumers can query 'all observations about Alice' without knowing whether the claim is a name, a coordinate, or a quality assessment."@x-gmeow-english ;
    skos:example "ex:posAcc gmeow:assessedEntity ex:roadLayer ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the assessment's numeric verdict (that is gmeow:observationResult) and for non-quality observations, which use gmeow:observedFeature directly."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert gmeow:assessedEntity from the QualityAssessment to the subject entity; it specializes gmeow:observedFeature, so generic 'all observations about X' queries find it by inheritance."@x-gmeow-english ;
    gmeow:useWhen "Use on a QualityAssessment to name the entity or dataset whose quality is under evaluation — the quality observation's feature of interest."@x-gmeow-english .

gmeow:qualityDimension
    a logic:ObjectProperty ;
    rdfs:domain gmeow:QualityAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "quality dimension"@x-gmeow-english ;
    rdfs:range gmeow:QualityDimension ;
    skos:definition "The quality dimension under which this assessment is made. Non-functional: a single assessment may cover several dimensions (e.g. a report that evaluates both positional accuracy and completeness), and competing dimension classifications coexist rather than collapse (Principle 9)."@x-gmeow-english ;
    skos:example "ex:posAcc gmeow:qualityDimension gmeow:qualityDimensionCompleteness ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a new dimension class for an unlisted axis (add a gmeow:QualityDimension individual instead) and avoid forcing a single dimension when an assessment genuinely spans several — keep it non-functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point gmeow:qualityDimension at one or more gmeow:QualityDimension individuals; multiple dimensions on one assessment coexist, matching a report that grades several axes at once."@x-gmeow-english ;
    gmeow:useWhen "Use on a QualityAssessment to name the ISO 19157 dimension(s) it evaluates — positional, temporal, or thematic accuracy, completeness, consistency, or lineage."@x-gmeow-english .

gmeow:qualityDimensionCompleteness
    a gmeow:QualityDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "completeness"@x-gmeow-english ;
    skos:definition "Presence or absence of features and their attributes, including commission (excess data) and omission (missing data) (ISO 19157)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:qualityDimensionLineage
    a gmeow:QualityDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "lineage"@x-gmeow-english ;
    skos:definition "The history, source, and process steps that produced a dataset or entity — the provenance of the data viewed through a quality lens. In GMEOW the structural lineage is recorded by gmeow:wasGeneratedBy, gmeow:wasDerivedFrom, and gmeow:ImportActivity (provenance module); this dimension value marks a quality assessment that evaluates lineage completeness or correctness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:qualityDimensionLogicalConsistency
    a gmeow:QualityDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "logical consistency"@x-gmeow-english ;
    skos:definition "Degree of adherence to logical rules of data structure, attribution, and relationships, including domain consistency, format consistency, and topological consistency (ISO 19157)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:qualityDimensionPositionalAccuracy
    a gmeow:QualityDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "positional accuracy"@x-gmeow-english ;
    skos:definition "Closeness of the spatial position of a feature to its true position, including absolute accuracy, relative accuracy, and gridded data positional accuracy (ISO 19157)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:qualityDimensionTemporalAccuracy
    a gmeow:QualityDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "temporal accuracy"@x-gmeow-english ;
    skos:definition "Correctness of the temporal references of a feature (e.g. date, time, period) relative to the true temporal value (ISO 19157)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxCBox .

gmeow:qualityDimensionThematicAccuracy
    a gmeow:QualityDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "thematic accuracy"@x-gmeow-english ;
    skos:definition "Accuracy of quantitative and qualitative attribute values, including classification correctness and non-quantitative attribute correctness (ISO 19157)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:qualityDimensionTopologicalConsistency
    a gmeow:QualityDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "topological consistency"@x-gmeow-english ;
    skos:definition "Correctness of the explicitly encoded topological characteristics of a dataset, typically expressed as error counts or conformance to a topological rule set (ISO 19157)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

<https://blackcatinformatics.ca/gmeow/slices/quality>
    a logic:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Cross-cutting data-quality layer refining confidence and provenance across every realm. Quality assessments are reified observations about ISO 19157 dimensions (positional accuracy, temporal accuracy, thematic accuracy, completeness, logical consistency, topological consistency) plus lineage. Aligns W3C DQV and GeoDCAT-AP by reference; quality-metric computation lives in the solver layer (Principle 12).

QualityAssessment reuses the universal Observation stack: the assessed entity is the observedFeature, the quality result is the observationResult (a math:Quantity, a math:Estimate, or a categorical verdict), and the assessment method is the observationMethod. QuantitativeQualityAssessment and AggregateQualityAssessment select the corresponding required mathematical result contracts without narrowing categorical assessments."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "GMEOW Data Quality Module"@x-gmeow-english ;
    skos:definition "The GMEOW Data Quality Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# Aggregate obligations are scoped to the held assessment and each of its results.
# Anonymous formula nodes keep the law in one canonical integrity tree.
# Malformed-value witnesses have distinct names from presence witnesses so their
# scopes remain separate in the generated SPARQL validation view.
gmeow:AggregateQualityResultsConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/quality> ;
    rdfs:label "Aggregate quality results constraint"@x-gmeow-english ;
    skos:definition "Every result of an aggregate quality assessment carries at least one quantity value, at least one estimator procedure and an estimand or parameter target. Every supplied value and procedure has the required mathematical type; one valid value cannot conceal a malformed extra value."@x-gmeow-english ;
    gmeow:useWhen "Use to validate the mathematical result contract of every aggregate quality assessment."@x-gmeow-english ;
    gmeow:avoidWhen "Do not apply this aggregate contract to categorical quality verdicts or direct measured quantities."@x-gmeow-english ;
    gmeow:howToUse "Author complete math:Estimate results on AggregateQualityAssessment observations. The native integrity tree and its generated validation projection enforce the same scoped obligation."@x-gmeow-english ;
    skos:scopeNote "The mathematical quantity owner enforces dimensions. This law adds no quality-specific quantity, estimator or target vocabulary and never equates a result with its assessment."@x-gmeow-english ;
    skos:example "ex:estimate math:estimateValue ex:score ; math:estimator ex:procedure ; math:estimatedParameter ex:meanCompleteness . ex:score a math:Quantity . ex:procedure a math:Estimator ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes gmeow:AggregateQualityAssessment ;
    logic:message "Every aggregate quality result requires typed quantity values, typed estimator procedures and an estimand or parameter target." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "result" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:AggregateQualityAssessment ] ],
[ a logic:Formula ; logic:relation gmeow:observationResult ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "result" ] ] ] ; logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "value" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation math:estimateValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "result" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ],
[ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ], [ logic:termIndex 1 ; logic:termIri math:Quantity ] ] ] ],
[ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "invalidValue" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation math:estimateValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "result" ], [ logic:termIndex 1 ; logic:termVariable "invalidValue" ] ], [ a logic:Formula ; logic:not [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "invalidValue" ], [ logic:termIndex 1 ; logic:termIri math:Quantity ] ] ] ] ] ],
[ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "estimator" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation math:estimator ; logic:argument [ logic:termIndex 0 ; logic:termVariable "result" ], [ logic:termIndex 1 ; logic:termVariable "estimator" ] ],
[ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "estimator" ], [ logic:termIndex 1 ; logic:termIri math:Estimator ] ] ] ],
[ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "invalidEstimator" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation math:estimator ; logic:argument [ logic:termIndex 0 ; logic:termVariable "result" ], [ logic:termIndex 1 ; logic:termVariable "invalidEstimator" ] ], [ a logic:Formula ; logic:not [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "invalidEstimator" ], [ logic:termIndex 1 ; logic:termIri math:Estimator ] ] ] ] ] ],
[ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "target" ] ; logic:exists [ a logic:Formula ; logic:or [ a logic:Formula ; logic:relation math:estimatesEstimand ; logic:argument [ logic:termIndex 0 ; logic:termVariable "result" ], [ logic:termIndex 1 ; logic:termVariable "target" ] ],
[ a logic:Formula ; logic:relation math:estimatedParameter ; logic:argument [ logic:termIndex 0 ; logic:termVariable "result" ], [ logic:termIndex 1 ; logic:termVariable "target" ] ] ] ] ] ] ] .
