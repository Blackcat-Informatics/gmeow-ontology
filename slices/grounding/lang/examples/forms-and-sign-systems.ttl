# Illustrative clean scene for the lang: form AST. Demonstrates each construct
# under the global validation gate: a sign-system reference scene (English and
# French natural languages, Turtle as a formal language, the Latin script with a
# grapheme repertoire, an orthography), the worked "cats chase mice" composed
# form with a full constituency-and-dependency analysis over one parsed surface,
# a multiword-token form (French "du" spanning two syntactic words), and a covert
# form (the zero plural of "sheep").

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/lang/> .

# --- Sign-system reference scene -------------------------------------------- #

ex:english
    a lang:SignSystem ;
    rdfs:label "English"@x-gmeow-english ;
    lang:signSystemKind lang:naturalLanguageKind ;
    lang:modality lang:writtenModality ;
    lang:informalGloss "The English natural language, written in the Latin script." .

ex:french
    a lang:SignSystem ;
    rdfs:label "French"@x-gmeow-english ;
    lang:signSystemKind lang:naturalLanguageKind ;
    lang:modality lang:writtenModality ;
    skos:notation "fr"^^xsd:string ;
    lang:informalGloss "The French natural language, written in the Latin script. Its ISO 639 code fr is carried machine-readably as a skos:notation so the BCP-47 projection can generate a registry tag from variety structure." .

ex:turtle
    a lang:SignSystem ;
    rdfs:label "Turtle"@x-gmeow-english ;
    lang:signSystemKind lang:formalLanguageKind ;
    lang:modality lang:writtenModality ;
    lang:informalGloss "The W3C Turtle serialization, a formal language with an explicit grammar." .

ex:latinScript
    a lang:Script ;
    rdfs:label "Latin"@x-gmeow-english ;
    skos:notation "Latn"^^xsd:string ;
    lang:hasGrapheme ex:graphemeC , ex:graphemeA , ex:graphemeT , ex:graphemeS .

ex:graphemeC  a lang:Grapheme ; rdfs:label "c"@x-gmeow-english ; lang:inScript ex:latinScript .
ex:graphemeA  a lang:Grapheme ; rdfs:label "a"@x-gmeow-english ; lang:inScript ex:latinScript .
ex:graphemeT  a lang:Grapheme ; rdfs:label "t"@x-gmeow-english ; lang:inScript ex:latinScript .
ex:graphemeS  a lang:Grapheme ; rdfs:label "s"@x-gmeow-english ; lang:inScript ex:latinScript .

ex:englishLatinOrthography
    a lang:Orthography ;
    rdfs:label "English Latin orthography"@x-gmeow-english ;
    lang:orthographyFor ex:english ;
    lang:usesScript ex:latinScript .

ex:frenchLatinOrthography
    a lang:Orthography ;
    rdfs:label "French Latin orthography"@x-gmeow-english ;
    lang:orthographyFor ex:french ;
    lang:usesScript ex:latinScript .

ex:turtleGrammar
    a lang:Grammar ;
    rdfs:label "Turtle grammar"@x-gmeow-english ;
    lang:grammarFor ex:turtle ;
    lang:grammarFormalism lang:ebnfFormalism .

# --- A language variety whose BCP-47 tag is GENERATED, not asserted ---------- #
# Quebec French is a lang:LanguageVariety of French differentiated by the region
# subtag CA (carried machine-readably as a skos:notation). The BCP-47 projection
# GENERATES the tag "fr-CA" from this structure: the primary subtag fr from the
# lang:varietyOf parent's notation, the region CA from the variety's own notation,
# and the Latin script SUPPRESSED because it is French's default-orthography
# script. The tag is a projection of the variety, never its definition.

ex:quebecFrench
    a lang:LanguageVariety ;
    rdfs:label "Quebec French"@x-gmeow-english ;
    lang:varietyOf ex:french ;
    lang:signSystemKind lang:naturalLanguageKind ;
    lang:modality lang:writtenModality ;
    skos:notation "CA"^^xsd:string .

ex:quebecFrenchOrthography
    a lang:Orthography ;
    rdfs:label "Quebec French Latin orthography"@x-gmeow-english ;
    lang:orthographyFor ex:quebecFrench ;
    lang:usesScript ex:latinScript .

# --- Lexemes ---------------------------------------------------------------- #

ex:lexCat
    a lang:Lexeme ;
    rdfs:label "cat"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:partOfSpeech lang:noun .

ex:lexChase
    a lang:Lexeme ;
    rdfs:label "chase"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:partOfSpeech lang:verb .

ex:lexMouse
    a lang:Lexeme ;
    rdfs:label "mouse"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:partOfSpeech lang:noun .

# --- Senses (the middle Frege corner) — the alignment surface for Wikidata --- #
# lexemes/senses and WordNet/ILI. Each sense is a lexicalized way of meaning
# attached to its lexeme through lang:senseOf; the equivalences file aligns these
# to Wikidata L-ids/sense-ids and to WordNet synsets via a curl-verified Wikidata
# pivot — closeMatch, never identity (a synset is coarser than a GMEOW sense).

ex:senseCat
    a lang:Sense ;
    rdfs:label "the animal sense of 'cat'"@x-gmeow-english ;
    lang:senseOf ex:lexCat .

ex:senseChase
    a lang:Sense ;
    rdfs:label "the pursuit sense of 'chase'"@x-gmeow-english ;
    lang:senseOf ex:lexChase .

ex:senseMouse
    a lang:Sense ;
    rdfs:label "the rodent sense of 'mouse'"@x-gmeow-english ;
    lang:senseOf ex:lexMouse .

# --- Morph features --------------------------------------------------------- #

ex:featPlur
    a lang:MorphFeature ;
    lang:featureKey lang:featNumber ;
    lang:featureValue lang:valPlur .

ex:featPres
    a lang:MorphFeature ;
    lang:featureKey lang:featTense ;
    lang:featureValue lang:valPres .

# --- Word forms ------------------------------------------------------------- #

ex:wfCats
    a lang:WordForm ;
    rdfs:label "cats"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:inflectionOf ex:lexCat ;
    lang:morphFeature ex:featPlur .

ex:wfChase
    a lang:WordForm ;
    rdfs:label "chase"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:inflectionOf ex:lexChase ;
    lang:morphFeature ex:featPres .

ex:wfMice
    a lang:WordForm ;
    rdfs:label "mice"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:inflectionOf ex:lexMouse ;
    lang:morphFeature ex:featPlur .

# --- The composed form "cats chase mice" ------------------------------------ #

ex:analysisCatsChaseMice
    a lang:Analysis ;
    rdfs:label "parse of 'cats chase mice'"@x-gmeow-english .

ex:sentCatsChaseMice
    a lang:ComposedForm ;
    rdfs:label "cats chase mice"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:compositionLevel lang:sentenceLevel ;
    lang:inAnalysis ex:analysisCatsChaseMice ;
    lang:formHead ex:wfChase ;
    lang:formSlot ex:slotS0 , ex:slotS1 , ex:slotS2 .

ex:slotS0
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisCatsChaseMice ;
    lang:slotIndex 0 ;
    lang:slotForm ex:wfCats ;
    lang:slotRole lang:subjectRole ;
    lang:dependencyRelation lang:subjectRole ;
    lang:dependsOn ex:slotS1 .

ex:slotS1
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisCatsChaseMice ;
    lang:slotIndex 1 ;
    lang:slotForm ex:wfChase ;
    lang:slotRole lang:predicateRole .

ex:slotS2
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisCatsChaseMice ;
    lang:slotIndex 2 ;
    lang:slotForm ex:wfMice ;
    lang:slotRole lang:objectRole ;
    lang:dependencyRelation lang:objectRole ;
    lang:dependsOn ex:slotS1 .

ex:sentSurface
    a lang:SurfaceForm ;
    lang:inSignSystem ex:english ;
    lang:surfaceText "cats chase mice" ;
    lang:inScript ex:latinScript ;
    lang:encoding "UTF-8" ;
    lang:unicodeNormalization "NFC" ;
    lang:collationLocale "en" ;
    lang:analysisLevel lang:parsedLevel ;
    lang:realizes ex:sentCatsChaseMice ;
    lang:surfaceAnchor ex:sentAnchor .

ex:sentAnchor
    a lang:SurfaceAnchor ;
    lang:anchorSource ex:english ;
    lang:anchorStart 0 ;
    lang:anchorEnd 15 ;
    lang:offsetSpace lang:codepointOffset .

# --- Multiword token: French "du" = de + le --------------------------------- #

ex:owDu
    a lang:OrthographicWord ;
    rdfs:label "du"@x-gmeow-english ;
    lang:inSignSystem ex:french ;
    lang:spansWords ex:swDe , ex:swLe .

ex:swDe
    a lang:SyntacticWord ;
    rdfs:label "de"@x-gmeow-english ;
    lang:inSignSystem ex:french ;
    lang:tokenOf ex:owDu .

ex:swLe
    a lang:SyntacticWord ;
    rdfs:label "le"@x-gmeow-english ;
    lang:inSignSystem ex:french ;
    lang:tokenOf ex:owDu .

# --- Covert form: the zero plural of "sheep" -------------------------------- #

ex:covertSheepPlural
    a lang:CovertForm ;
    rdfs:label "zero plural morph of 'sheep'"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:morphFeature ex:featPlur .

# --- Meaning: the sentence denotes a logic:Formula (the SemAF/AMR surface) ---- #
# The composed form "cats chase mice" denotes a logic:Formula under a plain-
# assertion context. This is the meaning-annotation surface the SemAF/AMR
# projection lowers (a coarse AMR graph, program-dependent SoundUnder). The
# formula individual is typed logic:Formula so the denotation-kind match holds.

ex:formulaCatsChaseMice
    a logic:Formula .

ex:sentAssertion
    a lang:CommunicativeAct ;
    lang:performedOn ex:sentCatsChaseMice ;
    lang:communicativeForce lang:assertForce .

ex:denCatsChaseMice
    a lang:Denotation ;
    lang:denotedForm ex:sentCatsChaseMice ;
    lang:denotationKind lang:denotesLogicFormula ;
    lang:denotationTarget ex:formulaCatsChaseMice ;
    lang:denotationContext ex:ctxPlainAssertion ;
    lang:isIndexical false ;
    logic:preservationKind logic:ExactPreservation .

# --- Ambiguity held honestly: "I saw her duck" (two co-resident parses) ------ #
# The syntactically ambiguous form "I saw her duck" carries TWO co-resident
# lang:Analysis readings over ONE surface, neither collapsed into a silent
# winner. The two readings assign genuinely distinct dependency trees:
#   duck-as-bird:   "I saw [her duck]" — "duck" is the NOUN (the bird), the
#                    object of "saw"; "her" is a possessive modifier of "duck".
#   duck-as-crouch: "I saw her [duck]" — "duck" is the VERB (to crouch), a
#                    modifier event under "saw"; "her" is the object of "duck".
# The eight slots carry unique zero-based contiguous indexes (0..7) so the whole
# composed form satisfies slot-uniqueness and contiguity, while each reading is
# recovered by its own lang:inAnalysis scope. The CoNLL-U projection lowers this
# form to TWO co-resident reading artifacts (lang:emittedReadingCount = 2), never
# a single silently-chosen tree — the FS5 "ambiguity held honestly" surface.

ex:lexSee
    a lang:Lexeme ;
    rdfs:label "see"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:partOfSpeech lang:verb .

ex:lexDuckBird
    a lang:Lexeme ;
    rdfs:label "duck"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:partOfSpeech lang:noun .

ex:lexDuckCrouch
    a lang:Lexeme ;
    rdfs:label "duck"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:partOfSpeech lang:verb .

ex:featPast
    a lang:MorphFeature ;
    lang:featureKey lang:featTense ;
    lang:featureValue lang:valPast .

# Word forms shared across both readings ("I", "saw", "her") plus the two
# category-distinct forms of "duck". "I" and "her" have no lang:partOfSpeech
# individual in the framework's part-of-speech inventory (which carries only
# noun and verb), so their CoNLL-U UPOS is the Universal Dependencies "other"
# tag X — a faithful encoding, never a fabricated category.

ex:wfI
    a lang:WordForm ;
    rdfs:label "I"@x-gmeow-english ;
    lang:inSignSystem ex:english .

ex:wfSaw
    a lang:WordForm ;
    rdfs:label "saw"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:inflectionOf ex:lexSee ;
    lang:morphFeature ex:featPast .

ex:wfHer
    a lang:WordForm ;
    rdfs:label "her"@x-gmeow-english ;
    lang:inSignSystem ex:english .

ex:wfDuckNoun
    a lang:WordForm ;
    rdfs:label "duck"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:inflectionOf ex:lexDuckBird .

ex:wfDuckVerb
    a lang:WordForm ;
    rdfs:label "duck"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:inflectionOf ex:lexDuckCrouch .

ex:analysisDuckBird
    a lang:Analysis ;
    rdfs:label "parse of 'I saw her duck' (duck as the bird)"@x-gmeow-english .

ex:analysisDuckCrouch
    a lang:Analysis ;
    rdfs:label "parse of 'I saw her duck' (duck as the crouch)"@x-gmeow-english .

ex:sentSawHerDuck
    a lang:ComposedForm ;
    rdfs:label "I saw her duck"@x-gmeow-english ;
    lang:inSignSystem ex:english ;
    lang:compositionLevel lang:sentenceLevel ;
    lang:inAnalysis ex:analysisDuckBird , ex:analysisDuckCrouch ;
    lang:formHead ex:wfSaw ;
    lang:formSlot
        ex:slotBI , ex:slotBSaw , ex:slotBHer , ex:slotBDuck ,
        ex:slotCI , ex:slotCSaw , ex:slotCHer , ex:slotCDuck .

# Reading duck-as-bird (slot indexes 0..3): I saw [her duck]
ex:slotBI
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisDuckBird ;
    lang:slotIndex 0 ;
    lang:slotForm ex:wfI ;
    lang:slotRole lang:subjectRole ;
    lang:dependsOn ex:slotBSaw .

ex:slotBSaw
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisDuckBird ;
    lang:slotIndex 1 ;
    lang:slotForm ex:wfSaw ;
    lang:slotRole lang:predicateRole .

ex:slotBHer
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisDuckBird ;
    lang:slotIndex 2 ;
    lang:slotForm ex:wfHer ;
    lang:slotRole lang:modifierRole ;
    lang:dependsOn ex:slotBDuck .

ex:slotBDuck
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisDuckBird ;
    lang:slotIndex 3 ;
    lang:slotForm ex:wfDuckNoun ;
    lang:slotRole lang:objectRole ;
    lang:dependsOn ex:slotBSaw .

# Reading duck-as-crouch (slot indexes 4..7): I saw her [duck]
ex:slotCI
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisDuckCrouch ;
    lang:slotIndex 4 ;
    lang:slotForm ex:wfI ;
    lang:slotRole lang:subjectRole ;
    lang:dependsOn ex:slotCSaw .

ex:slotCSaw
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisDuckCrouch ;
    lang:slotIndex 5 ;
    lang:slotForm ex:wfSaw ;
    lang:slotRole lang:predicateRole .

ex:slotCHer
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisDuckCrouch ;
    lang:slotIndex 6 ;
    lang:slotForm ex:wfHer ;
    lang:slotRole lang:objectRole ;
    lang:dependsOn ex:slotCDuck .

ex:slotCDuck
    a lang:FormSlot ;
    lang:inAnalysis ex:analysisDuckCrouch ;
    lang:slotIndex 7 ;
    lang:slotForm ex:wfDuckVerb ;
    lang:slotRole lang:modifierRole ;
    lang:dependsOn ex:slotCSaw .
