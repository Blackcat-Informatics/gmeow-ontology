gmeow:conditionKey
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "condition key"@x-gmeow-english ;
    skos:definition "The exact source condition-evidence key on a goal evaluation. It joins a configured verifier and condition within the evaluated goal, preserving the original literal and datatype without token normalization."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly supplies this relation and its context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing missing source bindings or inferring execution and success from this record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep the supplied xsd:string or xsd:token key on the actual GoalEvaluation. Its condition, configured verifier and exact evidence citation retain the same complete literal, including datatype."@x-gmeow-english ;
    skos:scopeNote "Preserve the supplied lexical form and datatype: verbatim xsd:string and explicitly supplied xsd:token are admitted. Do not normalize whitespace, retype a string or infer token typing. These declarations do not install a token lexical checker. Existing same-goal and exact-citation laws remain in force; a matching key alone is not proof that a condition held."@x-gmeow-english ;
    skos:example "ex:record gmeow:conditionKey \"source-value\" ."@x-gmeow-english ;
    logic:domain logic:GoalEvaluation ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:string xsd:token ) ] .

