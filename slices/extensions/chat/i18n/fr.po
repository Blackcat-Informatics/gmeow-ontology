msgctxt "https://blackcatinformatics.ca/gmeow/reactionState|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain exact source values, their scope and attribution; preserve supplied language and base direction."
msgstr "Conserver les valeurs source exactes, leur portée et leur attribution ; préserver la langue et la direction de base fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionState|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Independent source claims coexist. These declarations preserve evidence without authenticating the provider or executing its operation."
msgstr "Les déclarations source indépendantes coexistent. Ces déclarations conservent les preuves sans authentifier le fournisseur ni exécuter son opération."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionState|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain the supplied value for gmeow:reactionState."
msgstr "Conserver la valeur fournie pour gmeow:reactionState."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionPlaced|http://www.w3.org/2000/01/rdf-schema#label"
msgid "reaction placed"
msgstr "réaction placée"

msgctxt "https://blackcatinformatics.ca/gmeow/reactionPlaced|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reports that the reaction was placed on its scoped target message. This value does not establish current presence across other events or standpoints."
msgstr "La source rapporte le placement de la réaction sur son message cible situé. Cette valeur n’établit pas sa présence actuelle parmi d’autres événements ou points de vue."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionPlaced|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this record or field."
msgstr "À employer lorsque la source fournit explicitement cet enregistrement ou ce champ."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionPlaced|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring identity, delivery, verification or execution from missing source evidence."
msgstr "Éviter de déduire identité, livraison, vérification ou exécution de preuves source manquantes."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionPlaced|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain exact source values, their scope and attribution; preserve supplied language and base direction."
msgstr "Conserver les valeurs source exactes, leur portée et leur attribution ; préserver la langue et la direction de base fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionPlaced|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Independent source claims coexist. These declarations preserve evidence without authenticating the provider or executing its operation."
msgstr "Les déclarations source indépendantes coexistent. Ces déclarations conservent les preuves sans authentifier le fournisseur ni exécuter son opération."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionPlaced|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain the supplied value for gmeow:reactionPlaced."
msgstr "Conserver la valeur fournie pour gmeow:reactionPlaced."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionRemoved|http://www.w3.org/2000/01/rdf-schema#label"
msgid "reaction removed"
msgstr "réaction retirée"

msgctxt "https://blackcatinformatics.ca/gmeow/reactionRemoved|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reports that the reaction was taken off its scoped target message. This does not erase the placement record or infer that another source agreed."
msgstr "La source rapporte le retrait de la réaction de son message cible situé. Cela n’efface pas le placement et n’implique pas l’accord d’une autre source."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionRemoved|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this record or field."
msgstr "À employer lorsque la source fournit explicitement cet enregistrement ou ce champ."

msgctxt "https://blackcatinformatics.ca/gmeow/reactionRemoved|https://blackcatinformatics.ca/gmeow/avoidWhen"
