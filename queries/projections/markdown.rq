# Projection: GMEOW → pure markdown. GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: ALL metadata dropped: standpoint, confidence, temporal scope, suppression, aboutness, tagging. Only the directed wikilink edge survives.; ALL metadata dropped: standpoint, confidence, temporal scope, suppression, aboutness, tagging. Only the undirected wikilink edge survives..
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>

CONSTRUCT {
    ?src gmeow:hasWikilink ?tgt .
    ?a gmeow:hasWikilink ?b .
}
WHERE {
    {
        ?src a gmeow:Note .
        ?src gmeow:mentions ?tgt .
        FILTER NOT EXISTS { ?src gmeow:displayable false . }
        FILTER NOT EXISTS { ?tgt gmeow:displayable false . }
    }
    UNION {
        ?a a gmeow:Note .
        ?a gmeow:relatedNote ?b .
        FILTER NOT EXISTS { ?a gmeow:displayable false . }
        FILTER NOT EXISTS { ?b gmeow:displayable false . }
    }
}
