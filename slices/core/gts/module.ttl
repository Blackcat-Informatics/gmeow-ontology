    rdfs:label "gmeow-memory-hot-v1 dictionary"@x-gmeow-english ;
    skos:definition "The shipped HOT-PATH memory dictionary for frequently rewritten agent-memory segments. Trained ONLY on bundle-shipped claim material (see gmeow:corpusGmeowMemoryHotV1) — never on a user's runtime store; what it learns is the SHAPE of shipped claims, not anyone's content."@x-gmeow-english ;
    gmeow:dictionaryId "gmeow-memory-hot-v1" ;
    gmeow:dictionaryVersion "1" ;
    gmeow:dictionaryStrategy gmeow:dictStrategyTrained ;
    gmeow:dictionaryTargetLength 4096 ;
    gmeow:trainsOverCorpus gmeow:corpusGmeowMemoryHotV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

