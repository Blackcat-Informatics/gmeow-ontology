    gmeow:graphBoxRole gmeow:boxABox .

gmeow:subProcedureOf
    a owl:ObjectProperty ,
        owl:TransitiveProperty ;
    rdfs:domain gmeow:Procedure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/procedures> ;
    rdfs:label "sub-procedure of"@x-gmeow-english ;
    rdfs:range gmeow:Procedure ;
    rdfs:subPropertyOf gmeow:partOf ;
    skos:definition "Relates a Procedure to a larger Procedure it is part of — subprocess composition. Transitive: a part of a part is a part. Specialisation of the universal gmeow:partOf spine. Non-simple, so kept out of all cardinality axioms."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

<https://blackcatinformatics.ca/gmeow/slices/procedures>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """The plan ⟂ execution slice: a prescriptive layer that de-conflates
procedures, recipes, protocols, and workflow definitions from the events that enact them.
Reuses the event stack (Execution ⊑ Event, Participation for agent/tool assignment), the
information-object stack (Procedure / ProcedureStep ⊑ InformationObject), and the temporal
stack (Allen relations over Execution occurrences). ControlFlow and DataFlow are reified
relators following the Participation idiom.

DOCTRINE.
  * Plan ⟂ execution: a Procedure is an InformationObject (prescriptive spec); an Execution
    is an Event (occurrence that enacts it). One recipe, many prepared meals; one protocol,
    many runs.
  * Type is a VALUE, not a class: ProcedureType / StepType / BranchConditionType /
    ExecutionStatus are open value vocabularies of individuals (Principle 9 — no overtyping).
  * Recursive composition: a ProcedureStep may reference a subprocess Procedure via
    gmeow:stepEnactsProcedure; subProcedureOf provides Procedure-to-Procedure mereology.
  * Step ordering at the plan level is via ControlFlow relators (with optional flowOrder);
    at the execution level, Allen relations (before, meets, …) order the actual Event
    occurrences (Principle 12 — compute outside the logic).
  * Branch guard evaluation is solver-side: the guard condition type is recorded as a
    BranchConditionType value on the ControlFlow relator; the actual evaluation stays in
    the solver / SHACL layer (Principle 12).
  * Flat-first, reify on demand: a flat gmeow:executionParticipant covers the 80% case;
    promote to a gmeow:Participation when role / period / confidence / evidence is needed.
  * Two seed profiles demonstrate the generalisation: an ingestion-process profile
    (superseding the "source-packet bundle" idea) and a research-inquiry profile
    (superseding the flat research-queue)."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/procedures> ;
    rdfs:label "GMEOW Procedures Module"@x-gmeow-english ;
    skos:definition "The GMEOW Procedures Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Migrated procedural constraints: closed-world Procedures shapes from  #
# shapes/gmeow-shapes.ttl lifted to logic: (Principle 17).                      #
# =========================================================================== #

# Projection of gmeow:ExecutionHasPlanShape.
gmeow:ExecutionHasPlanConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Execution has-plan constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/procedures> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:Execution references at least one gmeow:executesProcedure or gmeow:executesStep."@x-gmeow-english ;
    logic:onClass gmeow:Execution ;
    logic:anyOf gmeow:executesProcedure , gmeow:executesStep ;
    logic:formalizes gmeow:ExecutionHasPlanShape ;
    logic:message "An Execution must reference at least one Procedure (gmeow:executesProcedure) or ProcedureStep (gmeow:executesStep)." .

# Projection of gmeow:BranchHasOutgoingFlowsShape: a stepTypeBranch ProcedureStep
# must be the flowSource of two distinct ControlFlow relators.
gmeow:BranchHasOutgoingFlowsConstraint
    a logic:Constraint ;
    rdfs:label "Branch outgoing-flows constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/procedures> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:ProcedureStep whose gmeow:procedureStepType is gmeow:stepTypeBranch is the gmeow:flowSource of at least two distinct gmeow:ControlFlow relators."@x-gmeow-english ;
    logic:formalizes gmeow:BranchHasOutgoingFlowsShape ;
    logic:message "A ProcedureStep of type stepTypeBranch must be the source of at least two ControlFlow relators." ;
    logic:integrity logic:brofForall .
logic:brofForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:brofImpl .
logic:brofImpl a logic:Formula ; logic:antecedent logic:brofGuard ; logic:consequent logic:brofExists .
logic:brofGuard a logic:Formula ; logic:and logic:brofType , logic:brofBranch .
logic:brofType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ProcedureStep ] .
logic:brofBranch a logic:Formula ; logic:relation gmeow:procedureStepType ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:stepTypeBranch ] .
logic:brofExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "flow1" ] , [ logic:termIndex 1 ; logic:termVariable "flow2" ] ;
    logic:exists logic:brofBody .
logic:brofBody a logic:Formula ; logic:and logic:brofType1 , logic:brofSrc1 , logic:brofType2 , logic:brofSrc2 , logic:brofDistinct .
logic:brofType1 a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "flow1" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ControlFlow ] .
logic:brofSrc1 a logic:Formula ; logic:relation gmeow:flowSource ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "flow1" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:brofType2 a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "flow2" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ControlFlow ] .
logic:brofSrc2 a logic:Formula ; logic:relation gmeow:flowSource ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "flow2" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:brofDistinct a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "flow1" ] , [ logic:termIndex 1 ; logic:termVariable "flow2" ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/ControlFlow> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/flowSource> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/ProcedureStep> ] .
<https://blackcatinformatics.ca/gmeow/ControlFlow> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/flowTarget> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/ProcedureStep> ] .
<https://blackcatinformatics.ca/gmeow/DataFlow> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/dataFlowSource> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/ProcedureStep> ] .
<https://blackcatinformatics.ca/gmeow/DataFlow> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/dataFlowTarget> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/ProcedureStep> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ControlFlow> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/flowSource" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ControlFlow> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/flowTarget" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/DataFlow> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/dataFlowSource" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/DataFlow> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/dataFlowTarget" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .

# --- Wave B1 shape-drain: control-flow / data-flow source-target cardinality ---
# gmeow:ControlFlowHasSourceTargetShape — exactly one source step and one target step.
gmeow:ControlFlow logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:flowSource ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:flowTarget ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] .
# gmeow:DataFlowHasSourceTargetShape — exactly one source step and one target step.
gmeow:DataFlow logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:dataFlowSource ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:dataFlowTarget ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] .
