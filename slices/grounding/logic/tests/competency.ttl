ex:cqApprovalStates a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX logic: <https://blackcatinformatics.ca/logic/> SELECT ?term WHERE { ?term a logic:ApprovalState } ORDER BY ?term" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Approval is its own axis with eight positions, not a boolean. Null is the position of an action policy never gated, and it is genuinely different from discharged, which is the position of an action that WAS gated and has since been cleared: a surface that showed both as approved would report an ungated dispatch as an authorized one. Detached, released, expired, cancelled and violated then separate the ways an approval stops governing, and each licenses a different next move, which is why the roster refuses to fold them into a single revoked." ;
    gmeow:cqResultShape ex:cqKernelRosterShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:cqApprovalStatesRowApprovalCancelled , ex:cqApprovalStatesRowApprovalCreated , ex:cqApprovalStatesRowApprovalDetached , ex:cqApprovalStatesRowApprovalDischarged , ex:cqApprovalStatesRowApprovalExpired , ex:cqApprovalStatesRowApprovalNull , ex:cqApprovalStatesRowApprovalReleased , ex:cqApprovalStatesRowApprovalViolated  .

ex:cqApprovalStatesRowApprovalCancelled a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:ApprovalCancelled ] .
