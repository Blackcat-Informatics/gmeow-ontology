gmeow:gmnGlossPstDenotation
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of Leipzig PST"@x-gmeow-english ;
    skos:definition "The reified meaning assignment binding the Leipzig gloss PST to the past tense value lang:valPast."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:denotedForm gmeow:gmnGlossPst ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget lang:valPast ;
    lang:denotationContext gmeow:gmnLangGlyphContext .

