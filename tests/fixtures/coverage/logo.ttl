#
# Logo coverage fixture (#410 follow-through). An entity (the GMEOW ontology
# itself, as in the real site index) carrying an emblematic media object via
# gmeow:hasLogo — projects to schema:logo and foaf:logo. Mirrors the single
# residual schema term that closed the #34 schema-org parity gap.

@prefix ex:    <https://example.org/logo/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

ex:gmeow a gmeow:SoftwareProject ; rdfs:label "GMEOW"@en ;
    gmeow:hasLogo ex:logoImg , ex:oldLogo .

ex:logoImg a gmeow:MediaObject ; rdfs:label "GMEOW logo"@en .

# A superseded logo, retained but flagged non-displayable (P10: suppress, never
# delete). It must NOT project to public schema:logo / foaf:logo.
ex:oldLogo a gmeow:MediaObject ; rdfs:label "GMEOW logo (2024)"@en ;
    gmeow:displayable false .
