@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/gts>
    a gmeow:Slice ;
    rdfs:label "gts"@x-gmeow-english ;
    skos:definition "The gts slice of the GMEOW ontology (core tier): GMEOW GTS Transport Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    dcterms:title "GMEOW GTS Transport Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/creative-works> ,
        <https://blackcatinformatics.ca/gmeow/slices/versions> ,
        <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    gmeow:sliceConsumer "Describing and dogfooding GTS transport artifacts: packages, segments, profiles, chain heads, opaque frames, codecs, and compaction lineage (GTS transport design, docs/GTS-SPEC.md)."@x-gmeow-english.
