# Competency question: "Which version of the provision governs at each date?"
#
# The two dates sit on either side of the amendment's material date. A version governs at a date
# when it has begun by that date and no end event dated by that date is recorded. An end event
# with no date leaves the version's end unknown, so the version does not govern on the strength of
# that event.

PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?asOf ?version WHERE {
    VALUES ?asOf { "2010-05-31"^^xsd:date "2010-06-01"^^xsd:date }
    ?version gmeow:versionOf <https://blackcatinformatics.ca/gmeow/examples/norms/provision/sec5> ;
        gmeow:versionBeganBy ?began .
    ?began gmeow:eventTime ?beganAt .
    FILTER(?beganAt <= ?asOf)
    FILTER NOT EXISTS {
        ?version gmeow:versionEndedBy ?ended .
        OPTIONAL { ?ended gmeow:eventTime ?endedAt }
        FILTER(!BOUND(?endedAt) || ?endedAt <= ?asOf)
    }
}
