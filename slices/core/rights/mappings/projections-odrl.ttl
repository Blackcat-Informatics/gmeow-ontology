@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .

# Projection mappings: GMEOW rights → a pure W3C ODRL 2.2 policy (the machine-
# readable deontic target). Authored in the rights slice and consumed by the
# registered mappings generator. The gmeow:RightsStatement relator becomes an
# odrl:Set; its Permission / Prohibition / Duty rules become the odrl:permission /
# odrl:prohibition / odrl:obligation rule trio. Shared action-value cells below
# rewrite gmeow:RightsAction values to their exact odrl:action IRIs; rule-shell
# cells carry odrl:target (the governed asset) and odrl:assignee. A gmeow:License
# becomes an odrl:Offer with its odrl:assigner. Every emitted odrl: term is
# declared in slice-local equivalence or projection metadata, so the no-drift gate
# can verify the projection.

gmeow:mapOdrlPolicy a gmeow:ProjectionMapping ;
    rdfs:label "RightsStatement → odrl:Set"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "rs" ;
        gmeow:atom ( [ gmeow:subjectVar "rs" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:RightsStatement ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:relation "<=" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "rs" ; gmeow:tPred rdf:type ; gmeow:tObjValue odrl:Set ] ) ] .

gmeow:mapOdrlPermission a gmeow:ProjectionMapping ;
    rdfs:label "RightsStatement permission rule → odrl:permission"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "rs" ;
        gmeow:atom (
            [ gmeow:subjectVar "rs" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:RightsStatement ]
            [ gmeow:subjectVar "rs" ; gmeow:predicate gmeow:statementAbout ; gmeow:objectVar "asset" ]
            [ gmeow:subjectVar "rs" ; gmeow:predicate gmeow:hasPermission ; gmeow:objectVar "perm" ]
            [ gmeow:subjectVar "perm" ; gmeow:predicate gmeow:ruleAssignee ; gmeow:objectVar "permAssignee" ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "rs" ; gmeow:tPred odrl:permission ; gmeow:tObj "perm" ]
            [ gmeow:tSubj "perm" ; gmeow:tPred rdf:type ; gmeow:tObjValue odrl:Permission ]
            [ gmeow:tSubj "perm" ; gmeow:tPred odrl:target ; gmeow:tObj "asset" ]
            [ gmeow:tSubj "perm" ; gmeow:tPred odrl:assignee ; gmeow:tObj "permAssignee" ] ) ] .

gmeow:mapOdrlProhibition a gmeow:ProjectionMapping ;
    rdfs:label "RightsStatement prohibition rule → odrl:prohibition"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "rs" ;
        gmeow:atom (
            [ gmeow:subjectVar "rs" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:RightsStatement ]
            [ gmeow:subjectVar "rs" ; gmeow:predicate gmeow:statementAbout ; gmeow:objectVar "asset" ]
            [ gmeow:subjectVar "rs" ; gmeow:predicate gmeow:hasProhibition ; gmeow:objectVar "proh" ]
            [ gmeow:subjectVar "proh" ; gmeow:predicate gmeow:ruleAssignee ; gmeow:objectVar "prohAssignee" ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "rs" ; gmeow:tPred odrl:prohibition ; gmeow:tObj "proh" ]
            [ gmeow:tSubj "proh" ; gmeow:tPred rdf:type ; gmeow:tObjValue odrl:Prohibition ]
            [ gmeow:tSubj "proh" ; gmeow:tPred odrl:target ; gmeow:tObj "asset" ]
            [ gmeow:tSubj "proh" ; gmeow:tPred odrl:assignee ; gmeow:tObj "prohAssignee" ] ) ] .

gmeow:mapOdrlDuty a gmeow:ProjectionMapping ;
    rdfs:label "RightsStatement duty rule → odrl:obligation"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "rs" ;
        gmeow:atom (
            [ gmeow:subjectVar "rs" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:RightsStatement ]
            [ gmeow:subjectVar "rs" ; gmeow:predicate gmeow:statementAbout ; gmeow:objectVar "asset" ]
            [ gmeow:subjectVar "rs" ; gmeow:predicate gmeow:hasDuty ; gmeow:objectVar "dutyR" ]
            [ gmeow:subjectVar "dutyR" ; gmeow:predicate gmeow:ruleAssignee ; gmeow:objectVar "dutyAssignee" ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "rs" ; gmeow:tPred odrl:obligation ; gmeow:tObj "dutyR" ]
            [ gmeow:tSubj "dutyR" ; gmeow:tPred rdf:type ; gmeow:tObjValue odrl:Duty ]
            [ gmeow:tSubj "dutyR" ; gmeow:tPred odrl:target ; gmeow:tObj "asset" ]
            [ gmeow:tSubj "dutyR" ; gmeow:tPred odrl:assignee ; gmeow:tObj "dutyAssignee" ] ) ] .

# Shared action-value table. These cells rewrite GMEOW action individuals into
# ODRL action individuals for every rule node that carries gmeow:ruleAction. A
# guarded fallback below preserves GMEOW extension actions that have no exact
# ODRL action IRI, without duplicating the exact rewrites.

gmeow:mapOdrlActionExtensionPassthrough a gmeow:ProjectionMapping ;
    rdfs:label "Extension RightsAction passthrough → odrl:action"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "arExtension" ;
        gmeow:value "action" ;
        gmeow:atom ( [ gmeow:subjectVar "arExtension" ; gmeow:predicate gmeow:ruleAction ; gmeow:objectVar "action" ] ) ;
        gmeow:filter [
            gmeow:exprOp gmeow:opNot ;
            gmeow:exprArgs ( [
                gmeow:exprOp gmeow:opIn ;
                gmeow:exprArgs (
                    [ gmeow:exprVar "action" ]
                    gmeow:actionAcceptTracking
                    gmeow:actionAggregate
                    gmeow:actionAnnotate
                    gmeow:actionAnonymize
                    gmeow:actionArchive
                    gmeow:actionAttribute
                    gmeow:actionCommercialize
                    gmeow:actionCompensate
                    gmeow:actionConcurrentUse
                    gmeow:actionDelete
                    gmeow:actionDerive
                    gmeow:actionDigitize
                    gmeow:actionDisplay
                    gmeow:actionDistribute
                    gmeow:actionEnsureExclusivity
                    gmeow:actionExecute
                    gmeow:actionExtract
                    gmeow:actionGive
                    gmeow:actionGrantUse
                    gmeow:actionInclude
                    gmeow:actionIndex
                    gmeow:actionInform
                    gmeow:actionInstall
                    gmeow:actionLease
                    gmeow:actionLend
                    gmeow:actionModify
                    gmeow:actionMove
                    gmeow:actionNextPolicy
                    gmeow:actionObtainConsent
                    gmeow:actionPlay
                    gmeow:actionPresent
                    gmeow:actionPrint
                    gmeow:actionRead
                    gmeow:actionReproduce
                    gmeow:actionReviewPolicy
                    gmeow:actionSell
                    gmeow:actionShareAlike
                    gmeow:actionStream
                    gmeow:actionSynchronize
                    gmeow:actionTextToSpeech
                    gmeow:actionTransfer
                    gmeow:actionTransform
                    gmeow:actionTranslate
                    gmeow:actionUninstall
                    gmeow:actionUse
                    gmeow:actionWatermark ) ] ) ] ;
        gmeow:edoalSource gmeow:ruleAction ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ;
        gmeow:toPredicate odrl:action ;
        gmeow:relation "<=" ;
        gmeow:confidence 0.6 ;
        gmeow:lossyDrop "GMEOW extension RightsAction values with no exact ODRL action IRI are passed through under odrl:action; the rule remains machine-readable without fabricating a target vocabulary term" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "arExtension" ; gmeow:tPred odrl:action ; gmeow:tObj "action" ] ) ] .

gmeow:mapOdrlActionReproduce a gmeow:ProjectionMapping ;
    gmeow:hasMappingPattern [
        gmeow:anchor "arReproduce" ;
        gmeow:atom ( [ gmeow:subjectVar "arReproduce" ; gmeow:predicate gmeow:ruleAction ; gmeow:objectValue gmeow:actionReproduce ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:relation "=" ; gmeow:confidence 0.9 ; gmeow:mnemomorphic true ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:exactMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "arReproduce" ; gmeow:tPred odrl:action ; gmeow:tObjValue odrl:reproduce ] ) ] .

