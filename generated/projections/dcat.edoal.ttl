@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/dcat>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:Corpus ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri dcat:Dataset ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.85"^^xsd:double ;
        rdfs:label "gmeow:Corpus → dcat:Dataset"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:Dataset ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri dcat:Dataset ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "gmeow:Dataset → dcat:Dataset"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:ImportActivity ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri prov:Activity ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "ImportActivity + ingestedAt → prov:Activity + endedAtTime"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:contentDigest ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri spdx:checksumValue ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "corpusMember contentDigest → spdx:checksum node"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:corpusMember ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri dcat:distribution ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "corpusMember → dcat:distribution (member as Distribution)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:datePublished ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri dcterms:issued ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "Dataset datePublished → dcterms:issued"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:description ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri dcterms:description ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "Dataset description → dcterms:description"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasLicense ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri dcterms:license ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "Dataset hasLicense → dcterms:license"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasPart ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri dcat:distribution ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            rdfs:label "Dataset hasPart → dcat:distribution (part as Distribution)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:title ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri dcterms:title ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "Dataset title → dcterms:title"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:wasAttributedTo ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri prov:wasAttributedTo ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "wasAttributedTo → prov:wasAttributedTo"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:wasGeneratedBy ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri prov:wasGeneratedBy ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "wasGeneratedBy → prov:wasGeneratedBy"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "dcat" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → dcat (EDOAL)"@en .
