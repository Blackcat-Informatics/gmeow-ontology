# --- Wave B2 shape-drain: narrative-interior residue (logic: canon; project to generated/shapes) ---

# gmeow:MythShape — a Myth carries at most one gmeow:recurringRisk boolean (the path is not globally
# logic:functionalProperty; the sh:maxCount 1 rides a class-scoped max-qualified antecedent, onDataRange
# xsd:boolean degrading to the plain sh:maxCount 1 the oracle compares).
gmeow:Myth logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:recurringRisk ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:boolean ] .

# gmeow:MotifShape — a Motif must carry at least one rdfs:label (identity-bearing means nameable).
# rdfs:label is literal-valued, so the existence axiom ranges over rdfs:Literal (logic:allValuesFrom
# logic:Thing would derive sh:nodeKind sh:BlankNodeOrIRI and reject the literal label); the closure
# entry projects the sh:minCount 1. The at-most-one-per-language-tag facet rides the UniqueLang sugar.
gmeow:Motif logic:subClassOf
    [ a logic:Restriction ; logic:onProperty rdfs:label ; logic:allValuesFrom rdfs:Literal ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Motif ; logic:closureKey "http://www.w3.org/2000/01/rdf-schema#label" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:MotifLabelUniqueLangConstraint
    a logic:UniqueLangConstraint ;
    rdfs:label "Motif label unique-language constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Motif carries at most one rdfs:label per language tag (no two language-tagged labels share a tag)."@x-gmeow-english ;
    logic:onClass gmeow:Motif ;
    logic:valuePath rdfs:label ;
    logic:formalizes gmeow:MotifShape ;
    logic:message "A Motif must carry at least one rdfs:label, at most one per language tag — identity-bearing means nameable; an unnameable recurring unit is a tag." .

# gmeow:NarrativePositionShape — a NarrativePosition carries a gmeow:positionOrdinal or a
# gmeow:positionLabel (or both): a disjunctive-requiredness obligation over the two locators.
gmeow:NarrativePositionLocatorConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Narrative position locator constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:NarrativePosition carries at least one of gmeow:positionOrdinal or gmeow:positionLabel."@x-gmeow-english ;
    logic:onClass gmeow:NarrativePosition ;
    logic:anyOf gmeow:positionOrdinal , gmeow:positionLabel ;
    logic:formalizes gmeow:NarrativePositionShape ;
    logic:message "A NarrativePosition must carry a positionOrdinal or a positionLabel (or both)." .

# gmeow:NarrativeTimeFrameShape — the gmeow:narrativeTimeAxis value is one of the two declared axis
# individuals (discourse time or story time): a closed value set (logic:oneOf), projected declaratively
# to sh:in. The axis PRESENCE (sh:minCount 1) rides gmeow:NarrativeTimeFrameAxisConstraint; the
# logic:functionalProperty contract supplies the sh:maxCount 1.
gmeow:NarrativeTimeFrame logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:narrativeTimeAxis ; logic:allValuesFrom [ logic:oneOf ( gmeow:axisDiscourseTime gmeow:axisStoryTime ) ] ] .

# gmeow:CharacterArcShape — a CharacterArc reads exactly one gmeow:arcSubject and one gmeow:arcType.
# The at-least-one existence obligation is carried procedurally (mirroring gmeow:ArcSample's locator
# constraints) so the fixture-conformance corpus — which excludes the declarative validation-shape
# surface to avoid over-flagging open-world data — still catches a missing subject/type; the closure
# entries + logic:functionalProperty contract carry the same exactly-one bound to the production gate.
gmeow:CharacterArcSubjectConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Character arc subject-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:CharacterArc reads at least one gmeow:arcSubject."@x-gmeow-english ;
    logic:onClass gmeow:CharacterArc ;
    logic:anyOf gmeow:arcSubject ;
    logic:formalizes gmeow:CharacterArcShape ;
    logic:message "A CharacterArc must have exactly one gmeow:arcSubject." .

gmeow:CharacterArcTypeConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Character arc type-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
