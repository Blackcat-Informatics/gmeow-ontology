# NIF and Web Annotation anchors --------------------------------------------

gmeow:eqLangAnchorNif a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:SurfaceAnchor ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject nif:OffsetBasedString ;
    logic:sourceEndpoint lang:SurfaceAnchor ; logic:targetEndpoint nif:OffsetBasedString ;
    gmeow:justification semapv:ManualMappingCuration ; gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-lang-nif.sssom.tsv" ;
    gmeow:comment "A native anchor can be projected as a NIF offset-based string, subject to the selected offset unit and source text." ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

gmeow:eqLangSurfaceFormNif a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
