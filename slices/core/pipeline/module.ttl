@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .

# =========================================================================== #
# Module ontology header (the slice IRI).                                     #
# =========================================================================== #

<https://blackcatinformatics.ca/gmeow/slices/pipeline>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "GMEOW Pipeline Module"@x-gmeow-english ;
    skos:definition "The GMEOW Pipeline Module — the dogfooded build DAG: gmeow:Pipeline / gmeow:PipelineStage individuals describing the DAG-driven single-pass executor (crates/pipeline), read back by the loader so the build is a first-class ontological citizen. One gmeow:stage-gts-sink is the narrow-waist serialization exit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Classes — the dogfooded build graph.                                        #
# =========================================================================== #

gmeow:Pipeline
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Pipeline"@x-gmeow-english ;
    rdfs:subClassOf logic:Plan ,
        gmeow:SocialObject ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:hasStage ;
            owl:someValuesFrom gmeow:PipelineStage ;
        ] ;
    skos:definition "A directed acyclic graph of build stages — the project's own build, authored as data. A Pipeline IS a logic:Plan: the canonical process model of the build, whose steps (gmeow:PipelineStage members, gathered through gmeow:hasStage) invoke typed units of work and whose success criterion is the shippable bundle. It is the dogfooded consumer of the DAG-workflow profile (logic:DagWorkflowContract) — its gmeow:dataflowConsumes edges specialize the canonical logic:dataflowConsumes, and their acyclic closure is certified under logic:DagWorkflowResource, so the build is statically schedulable and complete-for-fragment. The gmeow-pipeline executor reads it back, validates the graph (acyclic, complete, exactly one stage holding gmeow:sinkCapability), and runs every stage single-pass over an in-memory RDF dataset. logic:Plan grounds in prose as a gmeow:SocialObject, so the Pipeline also asserts that sort directly: it exists by the project's own convention, a description, not a physical thing."@x-gmeow-english ;
    skos:example "gmeow:pipeline-build a gmeow:Pipeline ; gmeow:hasStage gmeow:stage-source-load ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:PipelineStage
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Pipeline Stage"@x-gmeow-english ;
    rdfs:subClassOf logic:ActionSchema ,
        gmeow:SocialObject ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:hasCapability ;
            owl:allValuesFrom gmeow:StageCapability ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:requiresResource ;
            owl:allValuesFrom gmeow:Resource ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:dataflowConsumes ;
            owl:allValuesFrom gmeow:PipelineStage ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:stageImpl ;
            owl:someValuesFrom xsd:string ;
        ] ;
    skos:definition "One node in a gmeow:Pipeline build graph: a logic:ActionSchema — a typed unit of work that consumes the products of the stages it gmeow:dataflowConsumes and produces one product, passed in memory to its consumers rather than re-parsed from disk. Its gmeow:stageImpl binds it to a Rust Stage implementation, and the scheduler reads its declarations rather than a kind enum: each gmeow:requiresResource it declares is a shared resource it must hold exclusively while running (the scheduler serializes stages that compete for the same resource), and each gmeow:hasCapability it holds names a role the executor acts on — gmeow:sinkCapability (the single serialization exit) or gmeow:sourceOrigin (the authored-source loader). Its typed dataflow rides reified gmeow:BuildDataFlow edges."@x-gmeow-english ;
    skos:example "gmeow:stage-reason a gmeow:PipelineStage ; gmeow:stageImpl \"reason\" ; gmeow:requiresResource gmeow:engineResource ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:StageCapability
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Stage Capability"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "A declared capability a build stage holds, read by the executor in place of a kind enum: gmeow:sinkCapability (the single serialization exit, the gts narrow waist — the loader HARD-fails unless exactly one stage holds it) and gmeow:sourceOrigin (the authored-source loader, whose products' provenance origin is Source). A stage holding no capability is a plain transform/validate/export leaf (Generated provenance, non-sink). Its members are individuals, held through gmeow:hasCapability."@x-gmeow-english ;
    skos:example "gmeow:stage-gts-sink gmeow:hasCapability gmeow:sinkCapability ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Resource
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Resource"@x-gmeow-english ;
    rdfs:subClassOf gmeow:SocialObject ;
    skos:definition "A shared execution resource a build stage must hold exclusively while it runs — declared through gmeow:requiresResource (a specialization of logic:actionResource). Two stages requiring the same resource compete for it (logic:competesForResource) and the scheduler serializes them; a stage requiring no resource runs in parallel within its topological level. The canonical example is the process-wide reasoning engine (gmeow:engineResource), whose mutable reasoning state is exclusive — modelled as a resource so serialization is a conflict the scheduler reads, not a hardcoded special case."@x-gmeow-english ;
    skos:example "gmeow:engineResource a gmeow:Resource ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:BuildDataFlow
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Build Data Flow"@x-gmeow-english ;
    rdfs:subClassOf logic:DataFlowEdge ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:buildFlowFrom ;
            owl:someValuesFrom gmeow:PipelineStage ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:buildFlowTo ;
            owl:someValuesFrom gmeow:PipelineStage ;
        ] ;
    skos:definition "A reified typed dataflow edge of the build graph — a specialization of the canonical logic:DataFlowEdge. It mediates a producer stage (logic:flowFrom) and a consumer stage (logic:flowTo) and names, through gmeow:flowEntity, the specific named-graph artifacts that flow on the edge. Where the bare gmeow:dataflowConsumes edge says only that a consumer depends on a producer's WHOLE product, a gmeow:BuildDataFlow refines that to the exact graphs the consumer reads, so the executor can key the consumer's cache on only those graphs' content digests — artifact-level incremental rebuild: a change to a graph the consumer does not read no longer re-runs it. A Relator mediating two distinct stage relata, satisfying the relator-mediation discipline."@x-gmeow-english ;
    skos:example "gmeow:pipeline-dataflow-reason-compile-logic a gmeow:BuildDataFlow ; logic:flowFrom gmeow:stage-compile-logic ; logic:flowTo gmeow:stage-reason ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Properties.                                                                 #
# =========================================================================== #

gmeow:hasStage
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "has stage"@x-gmeow-english ;
    rdfs:domain gmeow:Pipeline ;
    rdfs:range gmeow:PipelineStage ;
    skos:definition "Relates a gmeow:Pipeline to one of its member stages. Non-functional: a pipeline has many stages. The full membership defines the node set the executor validates and schedules."@x-gmeow-english ;
    skos:example "gmeow:pipeline-build gmeow:hasStage gmeow:stage-gts-sink ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:dataflowConsumes
    a owl:ObjectProperty ;
    rdfs:subPropertyOf logic:dataflowConsumes ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "dataflow consumes"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    rdfs:range gmeow:PipelineStage ;
    skos:definition "Relates a stage to an upstream stage whose product it reads. A specialization of the canonical logic:dataflowConsumes (consumer → producer) — so the build pipeline's dataflow is the same edge the DAG-workflow certifier reads, not a parallel one. The executor inverts it to schedule producers first. The transitive closure of gmeow:dataflowConsumes must be acyclic — the loader HARD-fails on a cycle (the logic:DagWorkflowResource certification). The Rust Stage's consumes() must agree with this declaration exactly (Rust/RDF agreement)."@x-gmeow-english ;
    skos:example "gmeow:stage-reason gmeow:dataflowConsumes gmeow:stage-statements ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:dataflowProduces
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:dataflowConsumes ;
    rdfs:subPropertyOf logic:dataflowProduces ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "dataflow produces"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    rdfs:range gmeow:PipelineStage ;
    skos:definition "The inverse of gmeow:dataflowConsumes: relates a stage to a downstream stage that reads its product. Declared for query convenience (a producer can enumerate its consumers); the canonical authored direction is gmeow:dataflowConsumes, so the inverse is normally left to be inferred rather than asserted."@x-gmeow-english ;
    skos:example "gmeow:stage-statements gmeow:dataflowProduces gmeow:stage-reason ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasCapability
    a owl:ObjectProperty ;
    rdfs:subPropertyOf logic:capability ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "has capability"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    rdfs:range gmeow:StageCapability ;
    skos:definition "Relates a stage to a gmeow:StageCapability it holds. A specialization of the canonical logic:capability action-theory facet. The executor reads these declarations instead of a kind enum: gmeow:sinkCapability marks the single narrow-waist exit (the loader HARD-fails unless exactly one stage holds it) and gmeow:sourceOrigin marks the authored-source loader (its products' provenance origin is Source). Non-functional — a stage may hold several capabilities. The Rust Stage's capabilities() must agree with this exactly (Rust/RDF agreement)."@x-gmeow-english ;
    skos:example "gmeow:stage-gts-sink gmeow:hasCapability gmeow:sinkCapability ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:stageImpl
    a owl:FunctionalProperty ,
        owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "stage impl"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    rdfs:range xsd:string ;
    skos:definition "The registry key binding a stage to its Rust Stage implementation in the gmeow-pipeline STAGE_REGISTRY. Exactly one per stage; the loader HARD-fails if the key resolves to no implementation. Stable across runs and language-neutral (an identifier, not localizable prose)."@x-gmeow-english ;
    skos:example "gmeow:stage-reason gmeow:stageImpl \"reason\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:producesFormat
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "produces format"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    rdfs:range xsd:string ;
    skos:definition "An output format tag a stage emits — typically on a gmeow:kindExportLeaf, which folds one artifact of this format into the bundle. Non-functional: a leaf may emit several formats. Stable identifiers (e.g. \"parquet\", \"linkml\"), not localizable prose."@x-gmeow-english ;
    skos:example "gmeow:stage-export-parquet gmeow:producesFormat \"parquet\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:requiresResource
    a owl:ObjectProperty ;
    rdfs:subPropertyOf logic:actionResource ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "requires resource"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    rdfs:range gmeow:Resource ;
    skos:definition "Relates a stage to a shared gmeow:Resource it must hold exclusively while it runs. A specialization of the canonical logic:actionResource action-theory facet: where two stages declare the same resource the supply is insufficient for both at once (logic:competesForResource), so the scheduler serializes them. Non-functional — a stage may require several resources. This is the declarative replacement for a hardcoded scheduler lock: any stage can declare any shared resource, and serialization falls out of the conflict rather than a special case. The Rust Stage's resources() must agree with this declaration exactly (Rust/RDF agreement)."@x-gmeow-english ;
    skos:example "gmeow:stage-reason gmeow:requiresResource gmeow:engineResource ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:buildFlowFrom
    a owl:ObjectProperty ;
    rdfs:subPropertyOf logic:flowFrom ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "build flow from"@x-gmeow-english ;
    rdfs:domain gmeow:BuildDataFlow ;
    rdfs:range gmeow:PipelineStage ;
    skos:definition "Relates a gmeow:BuildDataFlow edge to its producer stage — the source mediation leg, a specialization of the canonical logic:flowFrom. Paired with gmeow:buildFlowTo, the two ends that make the edge a well-formed relator."@x-gmeow-english ;
    skos:example "gmeow:pipeline-dataflow-reason-compile-logic gmeow:buildFlowFrom gmeow:stage-compile-logic ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:buildFlowTo
    a owl:ObjectProperty ;
    rdfs:subPropertyOf logic:flowTo ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "build flow to"@x-gmeow-english ;
    rdfs:domain gmeow:BuildDataFlow ;
    rdfs:range gmeow:PipelineStage ;
    skos:definition "Relates a gmeow:BuildDataFlow edge to its consumer stage — the target mediation leg, a specialization of the canonical logic:flowTo. Paired with gmeow:buildFlowFrom."@x-gmeow-english ;
    skos:example "gmeow:pipeline-dataflow-reason-compile-logic gmeow:buildFlowTo gmeow:stage-reason ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:flowEntity
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "flow entity"@x-gmeow-english ;
    rdfs:domain gmeow:BuildDataFlow ;
    skos:definition "Relates a gmeow:BuildDataFlow edge to a named graph (a flowing entity / artifact) it carries from the producer stage to the consumer stage. Multi-valued — an edge may carry several graphs. The consumer's cache key folds ONLY the content digests of the graphs named here, so a change to any other graph in the producer's product does not re-run the consumer (artifact-level incremental rebuild). The range is the IRI of a named graph in the producer's dataset, not a stage."@x-gmeow-english ;
    skos:example "gmeow:pipeline-dataflow-reason-compile-logic gmeow:flowEntity <https://blackcatinformatics.ca/gmeow/graph/logic> ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Stage attach declarations (contribution-declaration; PIPELINE_SPINE §3.3) ---

gmeow:attachesGraph
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "attaches graph"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    skos:definition "Relates a gmeow:PipelineStage to a named-graph IRI it ATTACHES to the in-memory carrier — a graph present in its output product bundle but NOT in its assembled input (its attach DELTA, PIPELINE_SPINE §3 rule 3). Multi-valued: a stage may attach several graphs (e.g. gmeow:stage-source-load attaches the seven self-description graphs; gmeow:stage-snapshot attaches the per-file fanout / EDOAL reconstruction graphs). The range is the IRI of a carrier named graph, not a stage. The Rust Stage's attaches_graphs() must agree with this declaration exactly (Rust/RDF agreement, proved at load), and the scheduler HARD-fails if the stage's actual run-time delta diverges from it in either direction (gmeow:attachesGraph is the run-verified contract, not documentation)."@x-gmeow-english ;
    skos:example "gmeow:stage-reason gmeow:attachesGraph <https://blackcatinformatics.ca/gmeow/graph/reasoning> ."@x-gmeow-english ;
    gmeow:useWhen "Declare a named graph a build stage contributes to the carrier, so the dependency order is derivable and the superset gate can map every output to its producer — and so the scheduler can verify at run time that the stage attaches exactly what it declares (no undeclared or unfulfilled attachment)."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT list a graph the stage merely carries forward from an upstream product (that is the upstream's attach, not this stage's — the delta subtracts the assembled input). Do NOT use it for the byte-artifact lane (logical paths) or blob-representation lanes; those are gmeow:attachesBlobRep."@x-gmeow-english ;
    gmeow:howToUse "Assert one gmeow:attachesGraph per named-graph IRI the stage's run adds beyond its inputs, matching the Rust impl's attaches_graphs(). Capture the set empirically from a full run's attach delta; a mismatch HARD-fails at load (AttachDeclMismatch) or at run time (AttachDrift)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:attachesBlobRep
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "attaches blob rep"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    rdfs:range xsd:string ;
    skos:definition "A blob-representation lane label a gmeow:PipelineStage ATTACHES to the carrier — a representation-keyed by-reference blob record (e.g. \"diagnostics:nodes\", \"spans:source-table\") whose (representation, content digest) identity is present in its output product but NOT in its assembled input (its blob-rep attach DELTA). Distinct producers may therefore each attach different content under the same shared lane label, as the compile, reason, and validation stages do for diagnostics:nodes. NOT the byte-artifact lane (logical paths) — only the representation-keyed blob lane the consumers read back by rep. Multi-valued. Stable identifier strings, not localizable prose. The Rust Stage's attaches_blob_reps() must agree exactly (Rust/RDF agreement) and the scheduler verifies the run-time delta (AttachDrift)."@x-gmeow-english ;
    skos:example "gmeow:stage-source-load gmeow:attachesBlobRep \"spans:source-table\" ."@x-gmeow-english ;
    gmeow:useWhen "Declare a representation-keyed blob a stage folds onto its product's by-reference lane (the diagnostics-nodes run-ledger contribution, the source-span table), so the run-time verification covers it."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT use it for named graphs (gmeow:attachesGraph) or for the byte-artifact lane; do NOT list a record whose representation and content digest the stage merely carries forward from an upstream (the delta subtracts that identity)."@x-gmeow-english ;
    gmeow:howToUse "Assert one gmeow:attachesBlobRep per representation label under which the stage adds a content-distinct record beyond its inputs, matching attaches_blob_reps(); captured empirically from a full run's blob-rep delta."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Fanout extraction map (path ↔ carrier representative, promoted to data) ----

gmeow:FanoutExtraction
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Fanout Extraction"@x-gmeow-english ;
    rdfs:subClassOf gmeow:SocialObject ;
    skos:definition "A reified row of the fanout generated-path ↔ carrier-representative map: how one committed generated/ path (or path family) is reconstructed from gmeow.gts, either as the fold of one named graph (the \"rdf-fanout\" / \"edoal\" families, PIPELINE_SPINE §6/§7) or as a byte-exact member of the inline generated-opaque archive blob (the \"opaque\" family). It carries the committed path matcher (gmeow:extractsPath + gmeow:extractsMatch, optionally gmeow:extractsSuffix), the reconstruction graph family (gmeow:extractsGraphFamily — how the per-file named-graph IRI derives from the path, or \"opaque\" for a blob member), and the serialization form whose fold equals the committed bytes (gmeow:extractsForm, or \"blob\" for an opaque member). Promoted from hard-coded Rust branches so the superset gate reads the map as data; the gate HARD-fails unless every reconstructed named-graph path resolves to exactly one non-opaque row and every opaque archive member resolves to exactly one opaque row — and every row is claimed (a bijection over each family — no path silently dropped from fanout). The rdf-fanout / edoal rows are AUTHORED here; the opaque rows are EMITTED by the carrier at build time (one per archive member, derived from the exact member set), never hand-authored."@x-gmeow-english ;
    skos:example "gmeow:fanout-evals-scores a gmeow:FanoutExtraction ; gmeow:extractsPath \"generated/evals/scores.ttl\" ; gmeow:extractsMatch \"exact\" ; gmeow:extractsGraphFamily \"rdf-fanout\" ; gmeow:extractsForm \"turtle\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:fanoutExtracts
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "fanout extracts"@x-gmeow-english ;
    rdfs:domain gmeow:Pipeline ;
    rdfs:range gmeow:FanoutExtraction ;
    skos:definition "Gathers the gmeow:FanoutExtraction rows of a gmeow:Pipeline — the complete path ↔ representative map the post-pipeline fanout phase and the superset gate read to reconstruct every committed generated/ RDF file from the bundle. Multi-valued; the whole set must be a bijection against the bundle's reconstruction graphs (the gate HARD-fails otherwise)."@x-gmeow-english ;
    skos:example "gmeow:pipeline-build gmeow:fanoutExtracts gmeow:fanout-evals-scores ."@x-gmeow-english ;
    gmeow:useWhen "Declare, as data, the reconstruction rule for a committed generated/ RDF path so the superset gate resolves it without a Rust branch."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT hand-author a row for an opaque / byte-decorated output carried as an inline archive blob member: the carrier emits those \"opaque\"-family rows automatically at build time (one per generated-opaque archive member, derived from the exact member set), so a hand-authored opaque row would double-declare a member and break the opaque bijection."@x-gmeow-english ;
    gmeow:howToUse "Add one gmeow:FanoutExtraction per named-graph-carried committed path (exact) or path family (prefix); the gate proves the rows are a bijection over the bundle's fanout/EDOAL reconstruction graphs."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extractsPath
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "extracts path"@x-gmeow-english ;
    rdfs:domain gmeow:FanoutExtraction ;
    rdfs:range xsd:string ;
    skos:definition "The committed repo-relative generated/ path (when gmeow:extractsMatch is \"exact\") or the directory-prefix (when \"prefix\") a fanout row reconstructs. A stable path string, not localizable prose."@x-gmeow-english ;
    skos:example "gmeow:fanout-evals-scores gmeow:extractsPath \"generated/evals/scores.ttl\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extractsMatch
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "extracts match"@x-gmeow-english ;
    rdfs:domain gmeow:FanoutExtraction ;
    rdfs:range xsd:string ;
    skos:definition "How gmeow:extractsPath matches a committed path: \"exact\" (the path equals gmeow:extractsPath) or \"prefix\" (the path starts with gmeow:extractsPath, optionally further constrained by gmeow:extractsSuffix). Exactly one per row."@x-gmeow-english ;
    skos:example "gmeow:fanout-profiles gmeow:extractsMatch \"prefix\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extractsSuffix
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "extracts suffix"@x-gmeow-english ;
    rdfs:domain gmeow:FanoutExtraction ;
    rdfs:range xsd:string ;
    skos:definition "An optional suffix filter refining a \"prefix\" match: the path must also end with this string. Used to distinguish the EDOAL projection family (generated/projections/*.edoal.ttl) from the plain RDF projections under the same directory. At most one per row."@x-gmeow-english ;
    skos:example "gmeow:fanout-edoal-projections gmeow:extractsSuffix \".edoal.ttl\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extractsGraphFamily
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "extracts graph family"@x-gmeow-english ;
    rdfs:domain gmeow:FanoutExtraction ;
    rdfs:range xsd:string ;
    skos:definition "The reconstruction family that fixes how the committed path is recovered from gmeow.gts: \"rdf-fanout\" (the named graph graph/fanout/<path-without-generated/>) or \"edoal\" (the named graph graph/projections/<stem>.edoal for generated/projections/<stem>.edoal.ttl) — the gate folds the named graph at that IRI to the committed bytes; or \"opaque\" (no reconstruction graph — the committed path rides as a byte-exact member of the inline generated-opaque archive blob, the byte-decorated / non-RDF fanout files). For the \"opaque\" family the row's gmeow:extractsForm is \"blob\", the match is always \"exact\", and the carrier emits one such row per archive member so the opaque blob inventory is declared as data and the superset gate bijection-checks it exactly as it does the RDF fanout graphs."@x-gmeow-english ;
    skos:example "gmeow:fanout-evals-scores gmeow:extractsGraphFamily \"rdf-fanout\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extractsForm
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "extracts form"@x-gmeow-english ;
    rdfs:domain gmeow:FanoutExtraction ;
    rdfs:range xsd:string ;
    skos:definition "The serialization form whose fold of the reconstruction named graph equals the committed bytes: \"turtle\" (canonical Turtle, no graph label), \"ntriples\" (RDFC-canonical N-Triples), \"nquads-self\" (RDFC N-Quads re-rooted into the file's OWN fanout graph IRI), or \"nquads-diagnostics\" (RDFC N-Quads re-rooted into the shared graph/diagnostics label). Fixed by the producing stage's emission; a wrong form yields a byte mismatch the gate catches. The value \"blob\" marks an \"opaque\"-family row: the committed path is not a named-graph fold at all but a byte-exact member of the inline generated-opaque archive, so the gate resolves it from the archive lane rather than folding a graph."@x-gmeow-english ;
    skos:example "gmeow:fanout-shacl-diagnostics gmeow:extractsForm \"nquads-diagnostics\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:expectsGeneratedOutput
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "expects generated output"@x-gmeow-english ;
    rdfs:domain gmeow:Pipeline ;
    rdfs:range xsd:string ;
    skos:definition "One committed non-terminal generated/ path the pipeline is REQUIRED to produce — an entry of the independently-authored expected-output completeness inventory. Unlike gmeow:fanoutExtracts (whose opaque rows the carrier EMITS, so they are self-consistent with what it produced), this inventory is HAND-AUTHORED, so it is a second, independent source: when a carrier change silently stops emitting a declared output, the reconstructed bundle shrinks but this inventory does not, and the superset gate HARD-fails (expected ⊆ produced). The terminal bundle (generated/dist/gmeow.gts) is EXCLUDED — a bundle is not a projection of itself. Multi-valued; the whole set is the complete non-terminal generated/ tree."@x-gmeow-english ;
    skos:example "gmeow:pipeline-build gmeow:expectsGeneratedOutput \"generated/catalog/constraint-catalog.nq\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# StageCapability value vocabulary (individuals).                             #
# =========================================================================== #

gmeow:sinkCapability
    a gmeow:StageCapability ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "sink capability"@x-gmeow-english ;
    skos:definition "The sole serialization exit — the gts narrow waist. Exactly one stage per pipeline holds it; that stage serializes the fully-folded bundle to gmeow.gts once. The loader HARD-fails unless precisely one stage holds gmeow:sinkCapability."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:sourceOrigin
    a gmeow:StageCapability ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "source origin"@x-gmeow-english ;
    skos:definition "The authored-source loader: the stage holding it parses authored sources (statement-DSL, slice modules, transitive imports) and so its emitted quads' provenance origin is Source (the root ontology and imports are distinguished at parse time). Every stage NOT holding it emits derived, provenance-Generated quads — the capability the executor reads in place of a source-load kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# =========================================================================== #
# Resource value vocabulary (individuals).                                    #
# =========================================================================== #

gmeow:engineResource
    a gmeow:Resource ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "reasoning engine"@x-gmeow-english ;
    skos:definition "The process-wide reasoning resource covering native EL/DL closure. A stage that gmeow:requiresResource it runs serialized against every other stage requiring it — the resource-conflict serialization that replaces the former derived engine-lock flag. The sole reasoning stage (gmeow:stage-reason) declares it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# =========================================================================== #
# Shared action-schema facets — every gmeow:PipelineStage IS a                 #
# logic:ActionSchema, so it carries the two REQUIRED action-theory facets      #
# (logic:precondition + logic:capability) the canonical process model gates    #
# on. These are genuinely shared across the build: every stage gates on its    #
# upstream products being available and demands the executor capability. They  #
# are declared via the canonical logic: facets (NOT gmeow:hasCapability), so   #
# the loader's capabilities() agreement ignores them — they are the action-    #
# theory model, not the executor's sink/source role declarations.             #
# =========================================================================== #

gmeow:stageInputsAvailable
    a logic:Situation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "stage inputs available"@x-gmeow-english ;
    skos:definition "The situation gate every gmeow:PipelineStage grounds on as a logic:ActionSchema: the products of the stages it gmeow:dataflowConsumes (and any raw source files it reads) are available in memory. The elementary state transition the stage's run effects applies only once this situation obtains — the shared logic:precondition of the build's action schemas."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:stageExecutorCapability
    a gmeow:StageCapability ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "stage executor capability"@x-gmeow-english ;
    skos:definition "The executional precondition on the actor every gmeow:PipelineStage carries as a logic:ActionSchema: the bound Rust Stage implementation (resolved through gmeow:stageImpl) is registered and runnable. Held by every stage via logic:capability (the canonical action-theory facet) — distinct from gmeow:hasCapability, which declares the sink/source ROLES the executor reads; this names the generic ability to execute, not a role."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# =========================================================================== #
# Typed dataflow edges (reified gmeow:BuildDataFlow) — artifact-level deps.    #
#                                                                             #
# Where a consumer reads only SPECIFIC named graphs of a producer's product,  #
# a reified edge records exactly which, so the executor keys that consumer's   #
# cache on those graphs' digests alone (artifact-level incremental rebuild).   #
# Gathered on the plan through logic:planFlowEdge.                             #
# =========================================================================== #

# stage-compile-logic reads ONLY the narrowed graph/logic-compile-inputs named graph of
# stage-source-load's product — a SOUND (denylist) narrowing of the whole authored corpus
# stripping every predicate family the compiler's five augmentation readers provably never
# read (documentation, alignment/mapping, foreign-domain example, and bibliographic metadata),
# so an edit that touches only those inert families leaves the narrowed graph's digest
# unchanged and skips the (expensive) compiler. The narrowing is the compiler's typed dataflow
# entity, and its soundness is guarded by a reader-output-identity test.
gmeow:pipeline-dataflow-compile-logic-source-load
    a gmeow:BuildDataFlow ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "dataflow: source-load → compile-logic"@x-gmeow-english ;
    skos:definition "The typed dataflow edge from gmeow:stage-source-load to gmeow:stage-compile-logic: the logic compiler's five augmentation readers read only the graph/logic-compile-inputs named graph of the source-load product — the SOUND denylist narrowing of the whole authored corpus (root ontology + slices + imports) with every provably-never-read predicate family removed (documentation, alignment/mapping, foreign-domain example, and bibliographic-metadata vocabularies), leaving only the OWL/RDFS/XSD restriction and logic:/gmeow: structural surface the readers consume. Records the artifact-level dependency so the compiler's cache key folds that one graph's digest rather than the whole authored file closure, so an edit that touches only the inert families leaves the narrowed graph unchanged and skips re-running the compiler."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:buildFlowFrom gmeow:stage-source-load ;
    gmeow:buildFlowTo gmeow:stage-compile-logic ;
    gmeow:flowEntity
        <https://blackcatinformatics.ca/gmeow/graph/logic-compile-inputs> .

# stage-reason reads ONLY the logic / relational-core named graphs of
# stage-compile-logic's product (the object-level EDB), never its meta-level
# correspondence graph, diagnostics, or projection serializations — so a change to
# those alone skips the (expensive) reasoner.
gmeow:pipeline-dataflow-reason-compile-logic
    a gmeow:BuildDataFlow ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "dataflow: compile-logic → reason"@x-gmeow-english ;
    skos:definition "The typed dataflow edge from gmeow:stage-compile-logic to gmeow:stage-reason: the reasoner reads only the logic and relational-core named graphs of the compile-logic product. The shipped correspondence graph is a meta-formula envelope and stays outside object-level closure. Records the artifact-level dependency so the reasoner's cache key folds those two graphs' digests rather than the whole compile-logic product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:buildFlowFrom gmeow:stage-compile-logic ;
    gmeow:buildFlowTo gmeow:stage-reason ;
    gmeow:flowEntity
        <https://blackcatinformatics.ca/gmeow/graph/logic> ,
        <https://blackcatinformatics.ca/gmeow/graph/relational-core> .

# stage-validate reads the validation-shape byte artifacts of stage-compile-logic's
# product (generated/shapes/validation-shapes.ttl + procedural-constraints.ttl —
# fresh union members, never a stale disk read). The edge is narrowed to the complete
# compiled carrier graph set: the program-level digest standing in for those projected
# artifacts, which keeps the validator's graph/diagnostics
# attachment a genuine delta (the compile-logic product carries a graph of the same
# name); the OPT constraint sources are declared as the validator's raw input files
# for byte-level cache soundness.
gmeow:pipeline-dataflow-validate-compile-logic
    a gmeow:BuildDataFlow ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "dataflow: compile-logic → validate"@x-gmeow-english ;
    skos:definition "The typed dataflow edge from gmeow:stage-compile-logic to gmeow:stage-validate: the validator reads the compile-logic product's projected validation-shape byte artifacts (the fresh generated/shapes union members), keyed by the complete logic, relational-core, and correspondence carrier graph set — the program-level digest those projections are functions of. The narrowing keeps the validator's graph/diagnostics attachment a genuine delta over its inputs while validation still covers the meta-level correspondence program."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:buildFlowFrom gmeow:stage-compile-logic ;
    gmeow:buildFlowTo gmeow:stage-validate ;
    gmeow:flowEntity
        <https://blackcatinformatics.ca/gmeow/graph/correspondence> ,
        <https://blackcatinformatics.ca/gmeow/graph/logic> ,
        <https://blackcatinformatics.ca/gmeow/graph/relational-core> .

# stage-goal-directed reads ONLY the graph/reasoning named graph of stage-reason's
# product (the typed Reasoning handle's backing graph): the reasoned rdfs:subClassOf
# closure's derived, non-EDB axioms are the subsort_edges the order-sorted
# math-subsort demonstrator's unification lattice is seeded from.
gmeow:pipeline-dataflow-goal-directed-reason
    a gmeow:BuildDataFlow ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "dataflow: reason → goal-directed"@x-gmeow-english ;
    skos:definition "The typed dataflow edge from gmeow:stage-reason to gmeow:stage-goal-directed: the goal-directed stage reads only the graph/reasoning named graph of the reason product — the typed Reasoning handle's backing graph, whose derived (non-EDB) rdfs:subClassOf axioms seed the order-sorted math-subsort demonstrator's unification lattice. Records the artifact-level dependency so the stage's cache key folds that one graph's digest rather than the whole reason product (its committed closure/explanations/ledger byte lanes)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:buildFlowFrom gmeow:stage-reason ;
    gmeow:buildFlowTo gmeow:stage-goal-directed ;
    gmeow:flowEntity
        <https://blackcatinformatics.ca/gmeow/graph/reasoning> .

# =========================================================================== #
# The canonical build DAG (gmeow:pipeline-build) — dogfooded as data.         #
#                                                                             #
# This IS the project's build graph: the gmeow-pipeline executor reads it     #
# back, binds each gmeow:stageImpl to a registered Rust Stage, validates it    #
# (acyclic, complete, exactly one sinkCapability holder), and runs it          #
# single-pass. The migrated meta:gate-generator-registry queries these stages. #
# Spine: source-load → (statements, mappings) → reason → gts-compose →         #
# {docs-render + export leaves} → gts-sink (the one serialization).            #
# =========================================================================== #

# The build plan's success criterion: a shippable gmeow.gts bundle carrying every
# committed artifact. As a logic:Plan, gmeow:pipeline-build declares this goal and
# its success mode, satisfying logic:PlanShape (the dogfooded process model).
gmeow:goalShippableBundle
    a gmeow:Goal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "shippable bundle goal"@x-gmeow-english ;
    skos:definition "The success criterion of the build plan: a shippable generated/dist/gmeow.gts that carries every committed artifact reconstructibly (the superset law of the pipeline spine). The gmeow:Goal gmeow:pipeline-build is arranged to reach."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:pipeline-build
    a gmeow:Pipeline ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "GMEOW build pipeline"@x-gmeow-english ;
    skos:definition "The canonical GMEOW build: the directed acyclic graph of stages the gmeow-pipeline executor runs to produce gmeow.gts and every committed artifact in one pass. The authoritative build graph, replacing the retired Python generator registry. As a logic:Plan it carries logic:planGoal (the shippable bundle) and logic:planSuccessMode logic:StrongPlanSuccess (the deterministic build reaches the goal on every execution), and runs logic:executedUnderContract the DAG-workflow profile, under which its acyclic dataflow closure is certified complete-for-fragment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:planGoal gmeow:goalShippableBundle ;
    logic:planSuccessMode logic:StrongPlanSuccess ;
    logic:executedUnderContract logic:DagWorkflowContract ;
    logic:planFlowEdge
        gmeow:pipeline-dataflow-compile-logic-source-load ,
        gmeow:pipeline-dataflow-reason-compile-logic ,
        gmeow:pipeline-dataflow-validate-compile-logic ,
        gmeow:pipeline-dataflow-goal-directed-reason ;
    gmeow:hasStage
        gmeow:stage-source-load ,
        gmeow:stage-statements ,
        gmeow:stage-compile-logic ,
        gmeow:stage-mappings ,
        gmeow:stage-math-producers ,
        gmeow:stage-slice-brief ,
        gmeow:stage-reason ,
        gmeow:stage-goal-directed ,
        gmeow:stage-gts-compose ,
        gmeow:stage-validate ,
        gmeow:stage-conformance ,
        gmeow:stage-constraint-catalog ,
        gmeow:stage-term-manifest ,
        gmeow:stage-docs-render ,
        gmeow:stage-snapshot ,
        gmeow:stage-export-schemas ,
        gmeow:stage-export-catalog ,
        gmeow:stage-export-profiles ,
        gmeow:stage-export-parquet ,
        gmeow:stage-export-export ,
        gmeow:stage-export-okf ,
        gmeow:stage-export-apache ,
        gmeow:stage-export-frame-shapes ,
        gmeow:stage-export-constraint-shapes ,
        gmeow:stage-export-governance-floors ,
        gmeow:stage-export-projection-ceilings ,
        gmeow:stage-export-result-shapes ,
        gmeow:stage-validate-result-shape-composition ,
        gmeow:stage-export-json-schema ,
        gmeow:stage-export-pydantic ,
        gmeow:stage-export-matrix ,
        gmeow:stage-export-metadata ,
        gmeow:stage-export-research-objects ,
        gmeow:stage-export-references ,
        gmeow:stage-export-evals ,
        gmeow:stage-export-bench ,
        gmeow:stage-export-cost-ledger ,
        gmeow:stage-export-agreement ,
        gmeow:stage-export-lpg ,
        gmeow:stage-export-yaml-ld ,
        gmeow:stage-gts-sink .

# ── Spine ──

gmeow:stage-source-load
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "source load"@x-gmeow-english ;
    skos:definition "Parse the statement-DSL, slice modules, and transitive imports into the initial in-memory dataset — the root of the build DAG."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "source_load" ;
    gmeow:hasCapability gmeow:sourceOrigin .

gmeow:stage-statements
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "statements"@x-gmeow-english ;
    skos:definition "Compile the RDF-1.2 statement lead and its OWL downcast from the loaded sources."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "statements" .

gmeow:stage-compile-logic
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "compile logic"@x-gmeow-english ;
    skos:definition "Run the logic: compiler (parse → canonical IR → projection back-ends) over the canonical logic source and emit every compiler product as a committed artifact: the seven projection serializations (canonical RDF 1.2 IR, OWL DL/EL, Datalog, N3, gUFO, and the projection-report loss ledger) plus the compile diagnostics rendered to JSON, SARIF, HTML, and gmeow:Finding RDF. The single in-DAG producer of the logic projection surface, so the loss ledger and compile diagnostics reach the bundle, docs, and SARIF instead of terminating on disk."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "compile_logic" ;
    gmeow:dataflowConsumes gmeow:stage-source-load .

gmeow:stage-mappings
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "mappings"@x-gmeow-english ;
    skos:definition "Compile the mapping-DSL into SSSOM, EDOAL, FnO, and SPARQL alignment artifacts, assemble the FINAL projection-report loss ledger over the union of the logic projection rows (consumed from the compile-logic stage) and the per-correspondence residue ledger the four alignment lowerings produce, and project the shape-grounding certificate ledger: every logic:formalizes record on the projected constraint surfaces (the procedural-constraint surface off the compile-logic product, the FOL-constraint surface off the constraint-shapes export leaf) has its preservation judgment re-derived by the certify/oracle machinery each regenerate and committed as generated/logic/shape-grounding-ledger.ttl."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "mappings" ;
    gmeow:dataflowConsumes gmeow:stage-compile-logic ,
        gmeow:stage-export-constraint-shapes .

gmeow:stage-math-producers
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "math-producers"@x-gmeow-english ;
    skos:definition "Run the seven native math: producers (gmeow_math::producers — five flagship producers, the probability-model seam producer, and the p-value tri-slice producer) and fold each producer's deterministic RDF graph into the carrier as its own bundle-internal named graph, so the native producer output ships in gmeow.gts (the shippable deliverable) rather than living only behind a test-side equality gate. A leaf compute stage: it consumes no upstream product — the producers compute from pinned in-code exact-arithmetic constants."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "math_producers" .

gmeow:stage-slice-brief
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "slice-brief"@x-gmeow-english ;
    skos:definition "Assemble a gmeow:AuthoringPacket for every in-repo slice batch — the term definitions and axioms, the bounded graph neighbourhood, the same-slice exemplar coats, and the cross-ontology / cross-lingual grounding cross-table — and fold the union into the carrier as the graph/authoring-briefs corpus, so the shippable authoring deliverable rides in gmeow.gts (and its fanout twin generated/briefs/authoring-packets.nt) rather than living only behind a test-side gate. It reads the authored slice sources (module, examples, tests, mappings, and i18n translation catalogs) directly and gates each same-slice exemplar on SHACL per-term conformance (a coat with any shape violation is never surfaced), ordering the conforming candidates by annotation completeness. The enforced shape union is FRESH: its generated/shapes/*.ttl members are read off THIS run's producer products — gmeow:stage-compile-logic (validation-shapes.ttl + procedural-constraints.ttl) and the three shape export leaves (result/frame/constraint-shapes.ttl) — never the previous run's committed files (the stale-disk-fold class); consuming those producers also orders this stage after they materialize generated/shapes, so the union enumeration never fires before that directory exists."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "slice-brief" ;
    gmeow:dataflowConsumes
        gmeow:stage-compile-logic ,
        gmeow:stage-export-constraint-shapes ,
        gmeow:stage-export-frame-shapes ,
        gmeow:stage-export-result-shapes .

gmeow:stage-reason
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "reason"@x-gmeow-english ;
    skos:definition "Compute the native EL/DL reasoned closure and logic materialization — the SOLE reasoning pass. It reasons ONCE over the object-level EDB (authored ontology + imports + statements + logic/relational-core, in the bundle's graph layout but WITHOUT mapping, correspondence, or report graphs). Mapping and correspondence are shipped meta-level ontology content, not object-level axiom sources. The single result both backs the bundle's graph/reasoning projection AND owns the committed artifacts (generated/logic/inferred-closure.rdf12.ttl, reasoning-explanations.rdf12.ttl, dl-el-crosscheck-report.ttl) — there is no separate full-fold export leaf. The run's content-addressed native contract is always projected as a gmeow:Finding into graph/diagnostics and the diagnostics:nodes cache lane, keeping that declared attachment total even when the EDB contains no existential obligation; every production existential program's world-scoped termination certificate joins it from the same reasoning run. The only lock-carrying stage: it runs under the process-wide reasoning engine lock."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "reason" ;
    gmeow:dataflowConsumes
        gmeow:stage-compile-logic ,
        gmeow:stage-source-load ,
        gmeow:stage-statements ;
    gmeow:producesFormat "rdf12-turtle" ;
    gmeow:requiresResource gmeow:engineResource .

gmeow:stage-goal-directed
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "goal directed"@x-gmeow-english ;
    skos:definition "Run the native proof-carrying full-FOL backward engine over the authored goal-directed demonstrator corpus and fold its checked answers into gmeow.gts — the production consumer that makes the backward engine non-dark. It compiles the authored logic:ReasoningProgram individuals (read off the stage-compile-logic product's typed Logic handle) through gmeow_logic::goal_directed::evaluate_reasoning_programs, seeding the order-sorted unification lattice from the reasoned rdfs:subClassOf closure (read off the stage-reason product's typed Reasoning handle's derived, non-EDB axioms — the math: subsort tower the order-sorted math-subsort demonstrator needs), validates every answer's Curry–Howard proof (a proof that does not re-derive its answer atom HARD-fails), and attaches the checked answers + content-addressed proof derivations as the graph/goal-directed named graph, which stage-snapshot folds into the bundle. The demonstrator corpus is a SET authored in slices/grounding/logic/examples/reasoning-programs.ttl, so appending a demonstrator reaches the bundle with no stage change. graph/goal-directed is bundle-internal, a sibling of graph/reasoning, excluded from the object-level EDB (it asserts derived answers, not axioms)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "goal_directed" ;
    gmeow:dataflowConsumes
        gmeow:stage-compile-logic ,
        gmeow:stage-reason .

gmeow:stage-gts-compose
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "gts compose"@x-gmeow-english ;
    skos:definition "Assemble the unified in-memory RdfBundle (dataset + provenance + unit catalog) every downstream leaf and the sink fold artifacts into."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "gts_compose" ;
    gmeow:dataflowConsumes
        gmeow:stage-mappings ,
        gmeow:stage-reason ,
        gmeow:stage-source-load ,
        gmeow:stage-statements .

gmeow:stage-validate
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "validate"@x-gmeow-english ;
    skos:definition "Run the Rust SHACL validator over the loaded authored validation graph and emit deterministic diagnostics projections (JSON, SARIF, HTML, and gmeow:Finding RDF) for the snapshot and generated diagnostics artifacts. The enforced shape union is FRESH: its generated/shapes/*.ttl members are read off THIS run's producer products — gmeow:stage-compile-logic (validation-shapes.ttl + procedural-constraints.ttl) and the three shape export leaves (result/frame/constraint-shapes.ttl) — never off the previous run's committed files (the stale-disk-fold class); only the authored shapes/*.ttl and slices/*/*/shapes.ttl half is read from disk."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "validate" ;
    gmeow:dataflowConsumes
        gmeow:stage-compile-logic ,
        gmeow:stage-export-constraint-shapes ,
        gmeow:stage-export-frame-shapes ,
        gmeow:stage-export-result-shapes ,
        gmeow:stage-source-load .

gmeow:stage-conformance
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "conformance"@x-gmeow-english ;
    skos:definition "Grade the committed external conformance corpus (the W3C OWL 2 / ORE cases under conformance/logic/cases/external) — each case's frozen native verdict against its published external verdict — and emit the divergences as a gmeow:Finding N-Quads graph. A source-reading stage with no upstream product; the snapshot stage folds its output into the graph/conformance named graph so a repo-free consumer reads every reasoner-vs-corpus divergence from the bundle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "conformance" .

gmeow:stage-docs-render
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "docs render"@x-gmeow-english ;
    skos:definition "Render the typed documentation model (crates/docs) over the composed dataset and fold the doc artifacts into the bundle. Consumes gmeow:stage-reason so the projected documentation graph carries the per-term native-reasoner status (gmeow:docReasoningStatus), gmeow:stage-validate + gmeow:stage-compile-logic so the model carries the diagnostics-to-term join digest driving the per-term 'Diagnostics you might hit' surface, gmeow:stage-mappings so the model carries the dynamic per-term projection-loss join digest driving the per-term 'how this term degrades under projection' surface, and gmeow:stage-export-json-schema so the model's per-term JSON-Schema/OpenAPI fragment digest reads THIS run's schema product in memory rather than lagging one regenerate behind on the committed generated/schemas/*.json (the stale-disk-fold class)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "docs_render" ;
    gmeow:dataflowConsumes gmeow:stage-compile-logic ,
        gmeow:stage-export-json-schema ,
        gmeow:stage-gts-compose ,
        gmeow:stage-mappings ,
        gmeow:stage-reason ,
        gmeow:stage-term-manifest ,
        gmeow:stage-validate .

gmeow:stage-constraint-catalog
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "constraint catalog"@x-gmeow-english ;
    skos:definition "Generate the machine-readable constraint catalog: one gmeow:ValidationRule individual per finding code the validator can emit, carrying the code, its default grade, a logic:FindingCategory derived from the enforcement kind, and its stable catalog help URI, enriched for the frame-completeness and relator-mediation disciplines with the governed terms and formalizing axiom resolved from the reasoned graph. Consumes gmeow:stage-reason so the catalog is a projection of the axioms — the 'what GMEOW enforces' surface — rather than a hand-maintained list."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "constraint_catalog" ;
    gmeow:dataflowConsumes gmeow:stage-reason .

gmeow:stage-term-manifest
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "term content manifest"@x-gmeow-english ;
    skos:definition "Generate the machine-readable term content manifest: one gmeow:definitionDigest per documented term — the RDFC-1.0-canonical blake3 content-address of the term's defining triples (its concise bounded description with the per-term provenance predicates excluded) — plus its first-seen gmeow:addedInVersion and a reified gmeow:hasChangelogEntry for every release whose digest diverged from the prior committed manifest. Consumes gmeow:stage-reason so it runs after the reasoned closure, mirroring the constraint-catalog leaf; the computed changelog drives the per-term change detection surfaced in the docs."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "term_manifest" ;
    gmeow:dataflowConsumes gmeow:stage-reason .

# ── Snapshot assembly (structured multi-named-graph dist bundle) ──

gmeow:stage-snapshot
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "snapshot"@x-gmeow-english ;
    skos:definition "Assemble the structured multi-named-graph dist snapshot (gmeow.gts bytes) in memory: the authored default graph plus the import closure, metadata, alignment, RDF 1.2 statement, slice-analysis, verify-attestation, and documentation metadata graph. Derived documentation payloads remain external and are regenerated by make sync SYNC_OUTPUTS=docs. Split from the sink so every fold-reading export leaf consumes THIS run's freshly-composed fold rather than re-reading the committed file from disk (the single-pass invariant)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "snapshot" ;
    gmeow:dataflowConsumes
        gmeow:stage-compile-logic ,
        gmeow:stage-conformance ,
        gmeow:stage-constraint-catalog ,
        gmeow:stage-docs-render ,
        gmeow:stage-export-evals ,
        gmeow:stage-export-json-schema ,
        gmeow:stage-export-profiles ,
        gmeow:stage-export-research-objects ,
        gmeow:stage-goal-directed ,
        gmeow:stage-gts-compose ,
        gmeow:stage-mappings ,
        gmeow:stage-math-producers ,
        gmeow:stage-reason ,
        gmeow:stage-slice-brief ,
        gmeow:stage-source-load ,
        gmeow:stage-statements ,
        gmeow:stage-term-manifest ,
        gmeow:stage-validate .

# ── Export leaves (parallel fan-out, each folds one artifact set) ──

gmeow:stage-export-json-schema
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: json schema"@x-gmeow-english ;
    skos:definition "Compile the SHACL shape union into a closed-world JSON Schema (draft 2020-12) and an OpenAPI 3.1 document via the native emitter (crates/shacl), retiring the LinkML-derived JSON Schema. A fresh-union leaf: it reads the AUTHORED shape files (shapes/*.ttl, slices/*/*/shapes.ttl) from disk and consumes the four generated-shape producers — gmeow:stage-compile-logic (validation-shapes.ttl + procedural-constraints.ttl), gmeow:stage-export-result-shapes, gmeow:stage-export-frame-shapes, and gmeow:stage-export-constraint-shapes — so the union's generated/shapes/*.ttl members are THIS run's product bytes, never the previous run's committed files (the stale-disk-fold class). The snapshot stage folds its fresh output into the schemas-archive blob."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "json_schema" ;
    gmeow:dataflowConsumes
        gmeow:stage-compile-logic ,
        gmeow:stage-export-constraint-shapes ,
        gmeow:stage-export-frame-shapes ,
        gmeow:stage-export-result-shapes ;
    gmeow:producesFormat "json-schema" .

gmeow:stage-export-pydantic
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: pydantic models"@x-gmeow-english ;
    skos:definition "Render the Pydantic v2 model package (gmeow_models/<slice>.py) — a functional documentation surface — from the same SHACL shape compilation the JSON-Schema leaf runs, joined with the documentation model for docstrings, so a model's model_json_schema() agrees with the packed JSON Schema by construction. A fresh-union leaf: it reads the AUTHORED shape files and the documentation sources from disk and consumes the same four generated-shape producers as the JSON-Schema leaf — gmeow:stage-compile-logic, gmeow:stage-export-result-shapes, gmeow:stage-export-frame-shapes, and gmeow:stage-export-constraint-shapes — so the union's generated/shapes/*.ttl members are THIS run's product bytes, never the previous run's committed files (the stale-disk-fold class). The sink folds its fresh output into the models-python blob and the package tree ships as the gmeow-ontology wheel source."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "pydantic" ;
    gmeow:dataflowConsumes
        gmeow:stage-compile-logic ,
        gmeow:stage-export-constraint-shapes ,
        gmeow:stage-export-frame-shapes ,
        gmeow:stage-export-result-shapes ;
    gmeow:producesFormat "pydantic" .

gmeow:stage-export-schemas
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: schemas"@x-gmeow-english ;
    skos:definition "Render the LinkML YAML, TypeScript declaration, and GraphQL SDL developer schema surfaces (plus the GraphQL canonical name map) via purrdf's native SHACL-derived emitters (purrdf::shapes::linkml/typescript/graphql), retiring the hand-rolled OWL→LinkML model. A fresh-union leaf: it reads the AUTHORED shape files from disk and consumes the same four generated-shape producers as the JSON-Schema/Pydantic leaves — gmeow:stage-compile-logic, gmeow:stage-export-result-shapes, gmeow:stage-export-frame-shapes, and gmeow:stage-export-constraint-shapes — so the union's generated/shapes/*.ttl members are THIS run's product bytes, never the previous run's committed files (the stale-disk-fold class), and the compiled `$defs` agree with the packed JSON Schema/Pydantic package by construction (the shared schema_compile builder). The sink folds its fresh output into REP_GENERATED."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "schemas" ;
    gmeow:dataflowConsumes
        gmeow:stage-compile-logic ,
        gmeow:stage-export-constraint-shapes ,
        gmeow:stage-export-frame-shapes ,
        gmeow:stage-export-result-shapes ;
    gmeow:producesFormat "linkml" .

gmeow:stage-export-catalog
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: catalog"@x-gmeow-english ;
    skos:definition "Emit the OWL import catalog (catalog-v001.xml) from the slice manifests."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "catalog" ;
    gmeow:producesFormat "catalog-xml" .

gmeow:stage-export-profiles
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: profiles"@x-gmeow-english ;
    skos:definition "Emit the dependency-closed named profile ontology documents from the slice manifests."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "profiles" ;
    gmeow:producesFormat "profile-ttl" .

gmeow:stage-export-parquet
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: parquet"@x-gmeow-english ;
    skos:definition "Project the WHOLE composed carrier (terms/quads/reifiers/annotations/blobs of every named graph, never scoped to one graph) to the five-table Parquet columnar form via purrdf's native columnar codec (purrdf::columnar::write), retiring gmeow's hand-rolled Arrow record-batch builders and parquet-crate writer. purrdf owns the dictionary encoding and the byte-deterministic Parquet Data Page V2 physical layout; the carrier's blob store is always empty (blob payloads live in the gts archive by reference, never the in-memory carrier). A fold-reading export leaf: reads the gmeow:stage-snapshot bundle directly, never the gts bytes (GTS is exit-only)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "parquet" ;
    gmeow:dataflowConsumes gmeow:stage-snapshot ;
    gmeow:producesFormat "parquet" .

gmeow:stage-export-export
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: flat views"@x-gmeow-english ;
    skos:definition "Emit the flattened export views: Markdown, JSONL, and llms.txt, plus the dataset/semantic-web tiers (N-Quads, TriG, statements JSONL, ShEx). The SKOS concept-scheme extract, OBO Graphs JSON, and CSVW package are purrdf's native RDF-1.2 projections (project_skos / project_obo_graphs / project_csvw_exact) rather than hand-rolled writers — gmeow owns only the scoping decision (the gmeow-namespace owl:Class taxonomy for SKOS/OBO Graphs; the default-graph TBox/ABox for CSVW) and the caller-owned semantic-role vocabulary, purrdf owns the encoding. CSVW now emits purrdf's generic, always-lossless RDF-1.2-in-CSV package (csvw-metadata.json + terms/quads/reifiers/annotations.csv) in place of the retired curated class/property/individual CSV tables. Consumes gmeow:stage-export-json-schema alongside the snapshot so the inlined llms-full.txt cards can gate a class's python_model link on whether the class actually names a $defs entry (never a fabricated link for an unmodeled class)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "export" ;
    gmeow:dataflowConsumes
        gmeow:stage-export-json-schema ,
        gmeow:stage-snapshot ;
    gmeow:producesFormat "csv" , "jsonl" , "markdown" , "llms-txt" .

gmeow:stage-export-okf
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: OKF"@x-gmeow-english ;
    skos:definition "Emit the Open Knowledge Format concept-document bundle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "okf" ;
    gmeow:dataflowConsumes gmeow:stage-snapshot ;
    gmeow:producesFormat "okf" .

gmeow:stage-export-apache
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: apache headers"@x-gmeow-english ;
    skos:definition "Emit the Apache-style license headers from the self-description template."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "apache" ;
    gmeow:producesFormat "asf-license" .

gmeow:stage-export-frame-shapes
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: frame shapes"@x-gmeow-english ;
    skos:definition "Generate SHACL from the gmeow:requiresFrame frame-relativity declarations."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "frame_shapes" ;
    gmeow:producesFormat "shacl" .

gmeow:stage-export-constraint-shapes
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: constraint shapes"@x-gmeow-english ;
    skos:definition "Project each logic: open-world FOL axiom (irreflexivity / acyclicity / relatum-distinctness / class-disjointness) to a SHACL sh:SPARQLConstraint node shape — the P4/P17 projection of the axioms otherwise hand-authored as sh:sparql constraints."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "constraint_shapes" ;
    gmeow:producesFormat "shacl" .

gmeow:stage-export-governance-floors
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: governance floors"@x-gmeow-english ;
    skos:definition "Project the ontology-resident slice-quality floor commitments (gmeow:AxisFloorCommitment per (slice, axis) measured-score floor, gmeow:SliceTierFloor per per-slice roll-up tier floor) to their two lossy governance TSVs under generated/governance/ — the P4/P17 projection of the floors otherwise hand-authored as governance/*.tsv. The ontology is canonical; a human raises a floor by editing the commitment individual, never the generated TSV."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "governance_floors" ;
    gmeow:producesFormat "governance-floors-tsv" .

gmeow:stage-export-projection-ceilings
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: projection ceilings"@x-gmeow-english ;
    skos:definition "Project the ontology-resident projection-vocabulary ratchet (gmeow:ProjectionCeilingCommitment per committed (slice, vocabulary) ungrounded-residue ceiling, gmeow:ProjectionVocabulary per guarded logic:-subsumable projection surface) to their two lossy TSVs under generated/governance/ — the P4/P17 projection of the ceiling ratchet otherwise hand-authored as governance/*.tsv. The ontology is canonical; a human LOWERS a ceiling by editing the commitment individual, never the generated TSV."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "projection_ceilings" ;
    gmeow:producesFormat "projection-ceilings-tsv" .

gmeow:stage-export-result-shapes
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: result shapes"@x-gmeow-english ;
    skos:definition "Project each canonical logic:ResultShape (declared on a competency question via gmeow:cqResultShape) to SHACL — the P4/P17 projection of the typed query-result contract."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "result_shapes" ;
    gmeow:producesFormat "shacl" .

gmeow:stage-validate-result-shape-composition
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "validate: result-shape composition"@x-gmeow-english ;
    skos:definition "Enforce the typed query-composition contract across competency questions: where a question declares it consumes another's result via gmeow:cqConsumes, the producer's gmeow:cqResultShape must satisfy the consumer's gmeow:cqInputShape (structural input→output compatibility). A mismatch hard-fails the build, so a composition that cannot type-check never ships."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "result_shape_composition" .

gmeow:stage-export-matrix
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: matrix"@x-gmeow-english ;
    skos:definition "Emit the CI compatibility matrix (Makefile.matrix)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "matrix" ;
    gmeow:producesFormat "makefile-matrix" .

gmeow:stage-export-metadata
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: metadata"@x-gmeow-english ;
    skos:definition "Emit the build-metadata files (BUILD.bazel and Sphinx metadata)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "metadata" ;
    gmeow:dataflowConsumes gmeow:stage-snapshot ;
    gmeow:producesFormat "bazel" .

gmeow:stage-export-research-objects
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: research objects"@x-gmeow-english ;
    skos:definition "Emit the RO-Crate research-object archives from the example inputs."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "research-objects" ;
    gmeow:producesFormat "ro-crate" ;
    gmeow:dataflowConsumes
        gmeow:stage-export-evals ,
        gmeow:stage-mappings .

gmeow:stage-export-references
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: references"@x-gmeow-english ;
    skos:definition "Emit the citation / reference index (gmeow-references.ttl)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "references" ;
    gmeow:producesFormat "references-ttl" .

gmeow:stage-export-evals
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: evals"@x-gmeow-english ;
    skos:definition "Emit the evaluation JSON / CSV report tables."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "evals" ;
    gmeow:producesFormat "evals-json" .

gmeow:stage-export-bench
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: bench"@x-gmeow-english ;
    skos:definition "Emit the committed perf leaderboard table."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "bench" ;
    gmeow:producesFormat "markdown" .

gmeow:stage-export-cost-ledger
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: cost ledger"@x-gmeow-english ;
    skos:definition "Emit the committed deterministic engine-cost ledger: a drift-gated Markdown projection of the committed cost/agreement baseline (bench/cost-baseline.json) — per-case consumed_steps, derived counts, peak-live bytes, decomposable cost vectors, and verdict-agreement, plus the per-corpus divergence-ledger tally. Integer counts and boolean verdicts only (no wall-clock, no peak-RSS, no total-allocation scalars); reproduced byte-for-byte from the committed baseline without running any benchmark."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "cost-ledger" ;
    gmeow:producesFormat "markdown" .

gmeow:stage-export-agreement
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: agreement matrix"@x-gmeow-english ;
    skos:definition "Emit the committed external-corpus agreement matrix: the per-corpus native-vs-published pass-rate benchmark. A projection of the single grade gmeow:stage-conformance ran — it reads the tallies attached to that stage's product rather than re-grading the corpus (the transform-once razor)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "agreement" ;
    gmeow:producesFormat "markdown" ;
    gmeow:dataflowConsumes gmeow:stage-conformance .

gmeow:stage-export-lpg
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: LPG"@x-gmeow-english ;
    skos:definition "Emit the labeled-property-graph artifacts — generic CSV, Neo4j Admin Import CSV, openCypher, and GraphML 1.0 — via purrdf's native LPG projections (project_lpg_csv/project_neo4j_csv/project_lpg_cypher/project_lpg_graphml), retiring gmeow's hand-rolled node/edge model and CSV/Cypher/GraphML writers. The projected view is the carrier's graph/statements named graph ONLY, scoped via purrdf's project_named_graph_full (plus the RDF-1.2 reifiers/annotations attached to those statements-graph triples) — the same business-layer typed-resource scope the retired hand-rolled emitter used, never the whole composed carrier. A fold-reading export leaf: reads the gmeow:stage-snapshot bundle directly, never the gts bytes (GTS is exit-only)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "lpg" ;
    gmeow:dataflowConsumes gmeow:stage-snapshot ;
    gmeow:producesFormat "lpg-csv" , "lpg-neo4j-csv" , "lpg-cypher" , "lpg-graphml" .

gmeow:stage-export-yaml-ld
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: yaml ld"@x-gmeow-english ;
    skos:definition "Emit the YAML-LD-star and JSON-LD-star serializations of the composed dataset by folding THIS run's snapshot."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "yaml_ld" ;
    gmeow:dataflowConsumes gmeow:stage-snapshot ;
    gmeow:producesFormat "yaml-ld" ;
    gmeow:producesFormat "json-ld" .

# ── The single serialization exit (the gts narrow waist) ──

gmeow:stage-gts-sink
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "gts sink"@x-gmeow-english ;
    skos:definition "The terminal gts ARCHIVE writer (the ONE canonical exit / narrow waist): serialize the assembled carrier to generated/dist/gmeow.gts. GTS is exit-only — produced here and nowhere else; every fold-reading export leaf reads the carrier dataset off the gmeow:stage-snapshot bundle, never these bytes. The carrier is taken off the snapshot bundle (no re-assembly — the razor: transform transport→form at most once), and the by-reference blob archives are folded in alongside it: the fresh JSON-Schema/OpenAPI (gmeow:stage-export-json-schema), the compiled axiom surface (gmeow:stage-compile-logic), the native reasoning reports (gmeow:stage-reason), the byte-decorated RDF 1.2 statement lanes (gmeow:stage-statements), and the SHACL diagnostics SARIF/findings (gmeow:stage-validate). The embedded executable-docs 'try it' surface reasons over the object-level EDB, whose authored self-description graphs ride on gmeow:stage-source-load (read, never re-loaded). The opaque fanout members (references, bench, agreement matrix, apache config, matrix, eval/research-object sidecars, metadata void/dcat, the LinkML/TypeScript/GraphQL developer schema surfaces) ride in from their producing export leaves — rendered once, in the leaf, never re-rendered in the terminal (the transform-once razor)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "gts_sink" ;
    gmeow:hasCapability gmeow:sinkCapability ;
    gmeow:dataflowConsumes
        gmeow:stage-snapshot ,
        gmeow:stage-source-load ,
        gmeow:stage-export-agreement ,
        gmeow:stage-export-apache ,
        gmeow:stage-export-bench ,
        gmeow:stage-export-cost-ledger ,
        gmeow:stage-export-evals ,
        gmeow:stage-export-frame-shapes ,
        gmeow:stage-export-json-schema ,
        gmeow:stage-export-pydantic ,
        gmeow:stage-export-matrix ,
        gmeow:stage-export-metadata ,
        gmeow:stage-export-references ,
        gmeow:stage-export-research-objects ,
        gmeow:stage-export-result-shapes ,
        gmeow:stage-export-schemas ,
        gmeow:stage-export-constraint-shapes ,
        gmeow:stage-export-governance-floors ,
        gmeow:stage-export-projection-ceilings ,
        gmeow:stage-compile-logic ,
        gmeow:stage-mappings ,
        gmeow:stage-reason ,
        gmeow:stage-statements ,
        gmeow:stage-validate .

# =========================================================================== #
# Stage attach declarations (gmeow:attachesGraph / gmeow:attachesBlobRep) —    #
# the named graphs / blob-rep lanes each stage contributes to the carrier as   #
# its delta. The Rust twin (stages/attach.rs) is the single Rust-side source;  #
# these triples mirror it and the dogfooding gate (tests/dag_dogfood.rs, via   #
# bind) HARD-fails on any divergence. Captured empirically from a full run's   #
# attach delta so the scheduler's global bidirectional AttachDrift check has    #
# zero false positives.                                                        #
# =========================================================================== #

gmeow:stage-source-load
    gmeow:attachesGraph
        <https://blackcatinformatics.ca/gmeow/graph/authored-default> ,
        <https://blackcatinformatics.ca/gmeow/graph/imports> ,
        <https://blackcatinformatics.ca/gmeow/graph/logic-compile-inputs> ,
        <https://blackcatinformatics.ca/gmeow/graph/metadata> ,
        <https://blackcatinformatics.ca/gmeow/graph/provenance> ,
        <https://blackcatinformatics.ca/gmeow/graph/quality-assessment> ,
        <https://blackcatinformatics.ca/gmeow/graph/slice-analysis> ,
        <https://blackcatinformatics.ca/gmeow/graph/verify> ;
    gmeow:attachesBlobRep "spans:source-table" .

