-/// The short human title of a maturity anchor (`Minimal` / `Basic` / `Full` /
-/// `Maximal`) for the health dashboard.
-fn anchor_title(anchor: crate::maturity::MaturityAnchor) -> String {
-    use crate::maturity::MaturityAnchor::*;
-    match anchor {
-        Minimal => "Minimal",
-        Basic => "Basic",
-        Full => "Full",
-        Maximal => "Maximal",
-    }
-    .to_owned()
