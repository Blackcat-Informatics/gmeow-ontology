@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:eqClasses040 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ContactPoint ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject schema:ContactPoint ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses041 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:PostalAddress ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject schema:PostalAddress ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses042 a gmeow:TermEquivalence ;
    gmeow:alignSubject vcard:Address ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject gmeow:PostalAddress ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqProperties004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:email ;
    gmeow:alignPredicate owl:equivalentProperty ;
    gmeow:alignObject schema:email ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:sssomFile "gmeow-properties.sssom.tsv" .

gmeow:eqProperties005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:email ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject foaf:mbox ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "foaf:mbox is an IRI; close not equivalent" ;
    gmeow:sssomFile "gmeow-properties.sssom.tsv" .

gmeow:eqProperties006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:email ;
    gmeow:alignPredicate skos:closeMatch ;
