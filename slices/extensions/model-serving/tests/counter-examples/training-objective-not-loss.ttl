#
# Failing control for gmeow:ArtifactTrainingObjectiveConstraint, objective-type part:
# the training problem names an objective that is a math:Function and not a
# math:LossFunction. The problem does name an objective and the artifact is distinct
# from its model, so the mistyped objective is the only defect.
# Bound by ex:ecTrainingObjectiveNotLoss.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/model-serving/tensor-controls/> .

ex:artifact a gmeow:LearnedModelArtifact ;
    gmeow:artifactLearnedModel ex:model ;
    gmeow:artifactTrainingProblem ex:problem .
ex:model a math:LearnedModel .
ex:problem a math:OptimizationProblem ; math:objectiveFunction ex:notLoss .
ex:notLoss a math:Function .
