# Synthetic email coverage fixture for the GMEOW email slice.
# A two-message thread with participants (schema.org surface vocab), an
# attachment, a mailbox, and a trust example (Authentication-Results + DKIM).
# There is no public RDF email corpus, so this hand-authored slice exercises the
# surface vocabularies a real importer would emit, plus the GMEOW-native trust
# terms, so `gmeow coverage` can measure email-term coverage.
#
# Also exercises the MessageParticipant relator: alice@example.org appears in
# msg1 From with display name "Alice Smith" and in msg2 To with display name
# "Dr. Alice Smith", demonstrating that displayName is scoped to the occurrence.

@prefix ex:     <https://example.org/mail/> .
@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix schema: <https://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:thread1
    a gmeow:Thread ;
    gmeow:threadSubject "Quarterly report" .

ex:thread2
    a gmeow:Thread ;
    gmeow:threadSubject "Meeting invitation" .

ex:msg1
    a schema:EmailMessage, gmeow:EmailMessage ;
    gmeow:rfcMessageId "<msg1@example.org>" ;
    gmeow:subject "Quarterly report" ;
    schema:sender ex:addrAlice ;
    schema:toRecipient ex:addrBob ;
    schema:dateSent "2026-06-01T10:00:00Z"^^xsd:dateTime ;
    gmeow:receivedAt "2026-06-01T10:00:03Z"^^xsd:dateTime ;
    gmeow:partOfThread ex:thread1 ;
    gmeow:residesIn ex:inbox ;
    gmeow:hasKeyword gmeow:keywordSeen ;
    gmeow:hasAuthenticationResult ex:auth1 ;
    gmeow:hasSignature ex:dkim1 ;
    gmeow:hasRelayHop ex:hop1 ;
    gmeow:hasMessageParticipant ex:mpAliceFrom1 ;
    gmeow:hasMessageParticipant ex:mpBobTo1 .

ex:msg2
    a schema:EmailMessage, gmeow:EmailMessage ;
    gmeow:rfcMessageId "<msg2@example.org>" ;
    gmeow:subject "Re: Quarterly report" ;
    gmeow:subjectPrefix "Re: " ;
    schema:sender ex:addrBob ;
    schema:toRecipient ex:addrAlice ;
    schema:dateSent "2026-06-01T14:30:00Z"^^xsd:dateTime ;
    gmeow:inReplyTo ex:msg1 ;
    gmeow:partOfThread ex:thread1 ;
    gmeow:residesIn ex:inbox ;
    schema:messageAttachment ex:att1 ;
    gmeow:hasAttachment ex:att1 ;
    gmeow:hasMessageParticipant ex:mpBobFrom2 ;
    gmeow:hasMessageParticipant ex:mpAliceTo2 .

ex:att1
    a gmeow:Attachment ;
    gmeow:filename "q2-report.pdf" ;
    gmeow:mediaType "application/pdf" .

# Derivation layer: a text extraction and an AI summary of the attachment.
ex:att1-text
    a gmeow:TextExtraction ;
    gmeow:wasDerivedFrom ex:att1 .

ex:att1-summary
    a gmeow:Summary ;
    gmeow:wasDerivedFrom ex:att1 ;
    gmeow:wasAttributedTo ex:summariser .

ex:inbox
    a gmeow:Mailbox ;
    gmeow:mailboxRole "inbox" ;
    gmeow:mailboxName "Inbox" ;
    gmeow:mailboxOfAccount ex:aliceAccount .

ex:aliceAccount a gmeow:OnlineAccount .

# Trust indicators.
ex:auth1
    a gmeow:AuthenticationResult ;
    gmeow:authMethod "dkim" ;
    gmeow:authResult "pass" ;
    gmeow:authServer "mx.example.org" .

ex:dkim1
    a gmeow:DKIMSignature ;
    gmeow:signingDomain "example.org" ;
    gmeow:signatureAlgorithm "rsa-sha256" ;
    gmeow:verificationStatus "verified" .

ex:hop1
    a gmeow:RelayHop ;
    gmeow:hopOrdinal 1 ;
    gmeow:relayFrom "smtp.sender.example" ;
    gmeow:relayBy "mx.example.org" ;
    gmeow:relayProtocol "ESMTPS" ;
    gmeow:relayAt "2026-06-01T10:00:02Z"^^xsd:dateTime .

# Message headers for participant occurrences.
ex:hdrFrom1
    a gmeow:MessageHeader ;
    gmeow:headerName "From" ;
    gmeow:headerValue "\"Alice Smith\" <alice@example.org>" .

ex:hdrTo1
    a gmeow:MessageHeader ;
    gmeow:headerName "To" ;
    gmeow:headerValue "\"Bob Jones\" <bob@example.com>" .

ex:hdrFrom2
    a gmeow:MessageHeader ;
    gmeow:headerName "From" ;
    gmeow:headerValue "\"Bob Jones\" <bob@example.com>" .

ex:hdrTo2
    a gmeow:MessageHeader ;
    gmeow:headerName "To" ;
    gmeow:headerValue "\"Dr. Alice Smith\" <alice@example.org>" .

# MessageParticipant occurrences — same address, different display names.
ex:mpAliceFrom1
    a gmeow:MessageParticipant ;
    gmeow:participantMessage ex:msg1 ;
    gmeow:participantAddress ex:addrAlice ;
    gmeow:participantRole gmeow:messageRoleFrom ;
    gmeow:participantHeader ex:hdrFrom1 ;
    gmeow:participantOrdinal 0 ;
    gmeow:displayName "Alice Smith" ;
    gmeow:rawAddressValue "\"Alice Smith\" <alice@example.org>" .

ex:mpBobTo1
    a gmeow:MessageParticipant ;
    gmeow:participantMessage ex:msg1 ;
    gmeow:participantAddress ex:addrBob ;
    gmeow:participantRole gmeow:messageRoleTo ;
    gmeow:participantHeader ex:hdrTo1 ;
    gmeow:participantOrdinal 0 ;
    gmeow:displayName "Bob Jones" ;
    gmeow:rawAddressValue "\"Bob Jones\" <bob@example.com>" .

ex:mpBobFrom2
    a gmeow:MessageParticipant ;
    gmeow:participantMessage ex:msg2 ;
    gmeow:participantAddress ex:addrBob ;
    gmeow:participantRole gmeow:messageRoleFrom ;
    gmeow:participantHeader ex:hdrFrom2 ;
    gmeow:participantOrdinal 0 ;
    gmeow:displayName "Bob Jones" ;
    gmeow:rawAddressValue "\"Bob Jones\" <bob@example.com>" .

ex:mpAliceTo2
    a gmeow:MessageParticipant ;
    gmeow:participantMessage ex:msg2 ;
    gmeow:participantAddress ex:addrAlice ;
    gmeow:participantRole gmeow:messageRoleTo ;
    gmeow:participantHeader ex:hdrTo2 ;
    gmeow:participantOrdinal 0 ;
    gmeow:displayName "Dr. Alice Smith" ;
    gmeow:rawAddressValue "\"Dr. Alice Smith\" <alice@example.org>" .

# Stable contact points with structured decomposition.
ex:addrAlice
    a gmeow:EmailAddress ;
    gmeow:addressValue "alice@example.org" ;
    gmeow:localPart "alice" ;
    gmeow:domainPart "example.org" ;
    gmeow:deliversToAccount ex:aliceAccount .

ex:addrBob
    a gmeow:EmailAddress ;
    gmeow:addressValue "bob@example.com" ;
    gmeow:localPart "bob" ;
    gmeow:domainPart "example.com" .

ex:summariser a gmeow:SoftwareAgent .

# --------------------------------------------------------------------------- #
# Behavioral metadata fixtures (issue #137)
# --------------------------------------------------------------------------- #

# A regular message that requests a read receipt.
ex:msg3
    a schema:EmailMessage, gmeow:EmailMessage ;
    gmeow:rfcMessageId "<msg3@example.org>" ;
    gmeow:subject "Meeting invitation" ;
    schema:sender ex:addrAlice ;
    schema:toRecipient ex:addrBob ;
    schema:dateSent "2026-06-02T09:00:00Z"^^xsd:dateTime ;
    gmeow:receivedAt "2026-06-02T09:00:01Z"^^xsd:dateTime ;
    gmeow:partOfThread ex:thread2 ;
    gmeow:residesIn ex:inbox ;
    gmeow:hasKeyword gmeow:keywordSeen ;
    gmeow:priority "1" ;
    gmeow:importance "high" ;
    gmeow:userAgent "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Thunderbird/128.0" ;
    gmeow:readReceiptRequested true ;
    gmeow:dispositionNotificationTo ex:addrAlice ;
    gmeow:hasMessageParticipant ex:mpAliceFrom3 ;
    gmeow:hasMessageParticipant ex:mpBobTo3 .

# A delivery status notification (bounce).
ex:msgDsn
    a schema:EmailMessage, gmeow:EmailMessage ;
    gmeow:rfcMessageId "<dsn-12345@mailer.example.net>" ;
    gmeow:subject "Delivery Status Notification (Failure)" ;
    schema:dateSent "2026-06-02T10:00:00Z"^^xsd:dateTime ;
    gmeow:receivedAt "2026-06-02T10:00:02Z"^^xsd:dateTime ;
    gmeow:residesIn ex:inbox ;
    gmeow:hasKeyword gmeow:keywordSeen ;
    gmeow:autoSubmitted "auto-generated" ;
    gmeow:precedence "bulk" ;
    gmeow:hasMessageKind gmeow:messageKindDeliveryStatusNotification ;
    gmeow:hasMessageKind gmeow:messageKindBounce ;
    gmeow:hasMessageKind gmeow:messageKindAutoGenerated ;
    gmeow:hasBodyPart ex:dsnPart1 ;
    gmeow:hasBodyPart ex:dsnPart2 .

ex:dsnPart1
    a gmeow:BodyPart ;
    gmeow:mediaType "text/plain" .

ex:dsnPart2
    a gmeow:BodyPart ;
    gmeow:mediaType "message/delivery-status" .

# An auto-generated out-of-office reply.
ex:msgAuto
    a schema:EmailMessage, gmeow:EmailMessage ;
    gmeow:rfcMessageId "<auto-67890@mailer.example.net>" ;
    gmeow:subject "Out of office" ;
    schema:dateSent "2026-06-02T11:00:00Z"^^xsd:dateTime ;
    gmeow:receivedAt "2026-06-02T11:00:01Z"^^xsd:dateTime ;
    gmeow:residesIn ex:inbox ;
    gmeow:hasKeyword gmeow:keywordSeen ;
    gmeow:autoSubmitted "auto-replied" ;
    gmeow:precedence "bulk" ;
    gmeow:userAgent "Microsoft Exchange" ;
    gmeow:hasMessageKind gmeow:messageKindAutoGenerated ;
    gmeow:sentBySoftware ex:exchangeAgent .

ex:exchangeAgent
    a gmeow:SoftwareAgent ;
    gmeow:name "Microsoft Exchange" .

# Headers for participant occurrences (msg3).
ex:hdrFrom3
    a gmeow:MessageHeader ;
    gmeow:headerName "From" ;
    gmeow:headerValue "\"Alice Smith\" <alice@example.org>" .

ex:hdrTo3
    a gmeow:MessageHeader ;
    gmeow:headerName "To" ;
    gmeow:headerValue "\"Bob Jones\" <bob@example.com>" .

# MessageParticipant occurrences for msg3.
ex:mpAliceFrom3
    a gmeow:MessageParticipant ;
    gmeow:participantMessage ex:msg3 ;
    gmeow:participantAddress ex:addrAlice ;
    gmeow:participantRole gmeow:messageRoleFrom ;
    gmeow:participantHeader ex:hdrFrom3 ;
    gmeow:participantOrdinal 0 ;
    gmeow:displayName "Alice Smith" ;
    gmeow:rawAddressValue "\"Alice Smith\" <alice@example.org>" .

ex:mpBobTo3
    a gmeow:MessageParticipant ;
    gmeow:participantMessage ex:msg3 ;
    gmeow:participantAddress ex:addrBob ;
    gmeow:participantRole gmeow:messageRoleTo ;
    gmeow:participantHeader ex:hdrTo3 ;
    gmeow:participantOrdinal 0 ;
    gmeow:displayName "Bob Jones" ;
    gmeow:rawAddressValue "\"Bob Jones\" <bob@example.com>" .
# --------------------------------------------------------------------------- #
# MIME body part metadata fixtures (issue #133)
# --------------------------------------------------------------------------- #

# A multipart/alternative message with plain-text and HTML body parts.
ex:msgMultipart
    a schema:EmailMessage, gmeow:EmailMessage ;
    gmeow:rfcMessageId "<multipart@example.org>" ;
    gmeow:subject "Multipart example" ;
    schema:sender ex:addrAlice ;
    schema:toRecipient ex:addrBob ;
    schema:dateSent "2026-06-03T09:00:00Z"^^xsd:dateTime ;
    gmeow:receivedAt "2026-06-03T09:00:01Z"^^xsd:dateTime ;
    gmeow:residesIn ex:inbox ;
    gmeow:hasKeyword gmeow:keywordSeen ;
    gmeow:hasBodyPart ex:multipartAlt ;
    gmeow:hasInlinePart ex:htmlPart .

ex:multipartAlt
    a gmeow:MultipartBodyPart ;
    gmeow:partId "1" ;
    gmeow:hasMultipartType gmeow:multipartTypeAlternative ;
    gmeow:hasPart ex:plainPart ;
    gmeow:hasPart ex:htmlPart .

ex:plainPart
    a gmeow:BodyPart ;
    gmeow:partId "1.1" ;
    gmeow:mediaType "text/plain" ;
    gmeow:charset "utf-8" ;
    gmeow:hasContentTransferEncoding gmeow:transferEncodingQuotedPrintable ;
    gmeow:hasContentDisposition gmeow:contentDispositionInline .

# Decoded plain text as a derived InformationObject.
ex:plainText
    a gmeow:TextExtraction ;
    gmeow:wasDerivedFrom ex:plainPart .

ex:htmlPart
    a gmeow:InlinePart ;
    gmeow:partId "1.2" ;
    gmeow:mediaType "text/html" ;
    gmeow:charset "utf-8" ;
    gmeow:contentId "<html-body@example.org>" ;
    gmeow:hasContentTransferEncoding gmeow:transferEncodingBase64 ;
    gmeow:hasContentDisposition gmeow:contentDispositionInline .

# Decoded HTML as a derived InformationObject.
ex:htmlText
    a gmeow:InformationObject ;
    gmeow:wasDerivedFrom ex:htmlPart .

# A message with an attachment, exercising disposition and encoding.
ex:msgWithAttachment
    a schema:EmailMessage, gmeow:EmailMessage ;
    gmeow:rfcMessageId "<attachment@example.org>" ;
    gmeow:subject "Document attached" ;
    schema:sender ex:addrBob ;
    schema:toRecipient ex:addrAlice ;
    schema:dateSent "2026-06-03T10:00:00Z"^^xsd:dateTime ;
    gmeow:receivedAt "2026-06-03T10:00:01Z"^^xsd:dateTime ;
    gmeow:residesIn ex:inbox ;
    gmeow:hasKeyword gmeow:keywordSeen ;
    gmeow:hasAttachment ex:att2 .

ex:att2
    a gmeow:Attachment ;
    gmeow:partId "2" ;
    gmeow:filename "image.png" ;
    gmeow:mediaType "image/png" ;
    gmeow:hasContentDisposition gmeow:contentDispositionAttachment ;
    gmeow:hasContentTransferEncoding gmeow:transferEncodingBase64 .

# A multipart/related message with an inline image referenced from HTML.
ex:msgRelated
    a schema:EmailMessage, gmeow:EmailMessage ;
    gmeow:rfcMessageId "<related@example.org>" ;
    gmeow:subject "Newsletter with inline image" ;
    schema:sender ex:addrAlice ;
    schema:toRecipient ex:addrBob ;
    schema:dateSent "2026-06-03T11:00:00Z"^^xsd:dateTime ;
    gmeow:receivedAt "2026-06-03T11:00:01Z"^^xsd:dateTime ;
    gmeow:residesIn ex:inbox ;
    gmeow:hasKeyword gmeow:keywordSeen ;
    gmeow:hasBodyPart ex:multipartRel ;
    gmeow:hasInlinePart ex:htmlPartRelated ;
    gmeow:hasInlinePart ex:inlineImage .

ex:multipartRel
    a gmeow:MultipartBodyPart ;
    gmeow:partId "1" ;
    gmeow:hasMultipartType gmeow:multipartTypeRelated ;
    gmeow:hasPart ex:htmlPartRelated ;
    gmeow:hasPart ex:inlineImage .

ex:htmlPartRelated
    a gmeow:InlinePart ;
    gmeow:partId "1.1" ;
    gmeow:mediaType "text/html" ;
    gmeow:charset "utf-8" ;
    gmeow:hasContentTransferEncoding gmeow:transferEncoding8bit ;
    gmeow:hasContentDisposition gmeow:contentDispositionInline .

ex:inlineImage
    a gmeow:InlinePart ;
    gmeow:partId "1.2" ;
    gmeow:mediaType "image/png" ;
    gmeow:contentId "<logo@example.org>" ;
    gmeow:hasContentTransferEncoding gmeow:transferEncodingBase64 ;
    gmeow:hasContentDisposition gmeow:contentDispositionInline .
