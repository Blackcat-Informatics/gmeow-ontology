|} .

gmeow:measurementUncertainty skos:relatedMatch crm:P90i_is_value_of {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "CIDOC value, used here for uncertainty band"
|} .

gmeow:measuredDate skos:closeMatch time:hasTime {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "measuredDate (the absolute-date result of a TemporalMeasurement) aligns to OWL-Time hasTime"
|} .

gmeow:measuredDate skos:closeMatch time:inXSDDateTimeStamp {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "measuredDate instant carrying an instantValue aligns to OWL-Time inXSDDateTimeStamp"
|} .

gmeow:DatingMethod skos:closeMatch dcterms:method {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
