# ── Closed value class: the eleven formalization categories ──────────────────────

logic:FormalizationCategory
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Formalization Category"@x-gmeow-english ;
    skos:definition "The closed eleven-member value class of the logic:candidateCategory facet: the kind of force a prose constraint was meant to carry. Its individuals are logic:CategoryEquivalenceDefinition, logic:CategoryNecessaryCondition, logic:CategorySufficientCondition, logic:CategoryIntegrityConstraint, logic:CategoryDerivationRule, logic:CategoryDefeasibleDefault, logic:CategoryTypicality, logic:CategoryRecommendation, logic:CategoryNonEntailmentObligation, logic:CategoryDeliberateOverlap and logic:CategoryDocumentationOnly. The set is closed and atomic (Principle 9: necessary and sufficient are two categories, not one), so a misspelt label names no declared category and is rejected rather than silently accepted (design/LOGIC-FOUNDATION.md, §Typed formalization governance)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:CategoryEquivalenceDefinition
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Equivalence Definition"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for prose stating the necessary-and-sufficient identity of a term — a definitional equivalence. Wire value `equivalence-definition`."@x-gmeow-english .

logic:CategoryNecessaryCondition
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Necessary Condition"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for prose stating a one-directional necessary condition (the term implies the condition). Wire value `necessary-condition`."@x-gmeow-english .

logic:CategorySufficientCondition
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Sufficient Condition"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for prose stating a one-directional sufficient condition (the condition implies the term). Wire value `sufficient-condition`."@x-gmeow-english .

logic:CategoryIntegrityConstraint
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Integrity Constraint"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for an integrity condition whose violation is a finding, not a derivation — a CBox constraint rather than a productive rule. Wire value `integrity-constraint`."@x-gmeow-english .

logic:CategoryDerivationRule
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Derivation Rule"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for a productive rule whose head is entailed — content that adds to the reasoned closure. Wire value `derivation-rule`."@x-gmeow-english .

logic:CategoryDefeasibleDefault
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Defeasible Default"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for defeasible content a more specific fact may override — default-logic force, distinct from plain typicality. Wire value `defeasible-default`."@x-gmeow-english .

logic:CategoryTypicality
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Typicality"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for generic, what-normally-holds content — kept distinct from logic:CategoryDefeasibleDefault, whose force is override rather than genericity. Wire value `typicality`."@x-gmeow-english .

logic:CategoryRecommendation
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Recommendation"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for advisory content that is never enforced — guidance carried but not reasoned over. Wire value `recommendation`."@x-gmeow-english .

logic:CategoryNonEntailmentObligation
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Non-Entailment Obligation"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for a deliberate non-assertion — prose recording a conclusion the foundation must never draw, realized as a logic:NonEntailmentObligation. Wire value `non-entailment-obligation`."@x-gmeow-english .

logic:CategoryDeliberateOverlap
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Deliberate Overlap"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for a mereological sharing fact deliberately admitted — an intended overlap rather than an accidental one. Wire value `deliberate-overlap`."@x-gmeow-english .

logic:CategoryDocumentationOnly
    a owl:NamedIndividual ,
        logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Documentation Only"@x-gmeow-english ;
    skos:definition "The logic:FormalizationCategory for explanatory prose that is NOT to be formalized at all — the category that records a deliberate decision to leave content unaxiomatized. Wire value `documentation-only`."@x-gmeow-english .

# ── Closed value class: the candidate lifecycle states ───────────────────────────

logic:CandidateLifecycleState
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Candidate Lifecycle State"@x-gmeow-english ;
    skos:definition "The closed value class of the logic:candidateLifecycle facet: the four-state machine a logic:FormalizationCandidate moves through. Its individuals are logic:CandidateProposed (entry; every extraction lands here), logic:CandidateUnderReview, logic:CandidateAccepted (canonical, axiom-bearing) and logic:CandidateRejected. logic:CandidateAccepted is reachable only through logic:CandidateUnderReview with a recorded logic:reviewedBy decision, never directly. The set is closed, so a misspelt state names no declared value and is rejected (design/LOGIC-FOUNDATION.md, §Typed formalization governance)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:CandidateProposed
    a owl:NamedIndividual ,
        logic:CandidateLifecycleState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Proposed"@x-gmeow-english ;
    skos:definition "The lifecycle entry state: a candidate freshly extracted and not yet reviewed. An LLM extraction ALWAYS enters here; it carries no canonical force. Wire value `proposed`."@x-gmeow-english .

logic:CandidateUnderReview
    a owl:NamedIndividual ,
        logic:CandidateLifecycleState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Under Review"@x-gmeow-english ;
    skos:definition "The lifecycle state of a candidate a reviewer is actively adjudicating — the mandatory waypoint between logic:CandidateProposed and logic:CandidateAccepted. Wire value `under-review`."@x-gmeow-english .

logic:CandidateAccepted
    a owl:NamedIndividual ,
        logic:CandidateLifecycleState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Accepted"@x-gmeow-english ;
    skos:definition "The canonical, axiom-bearing lifecycle state: a candidate a reviewer has promoted, reachable only through logic:CandidateUnderReview with a recorded logic:reviewedBy decision. A candidate asserted as accepted without that review is a checked governance violation, not a soft warning. Wire value `accepted`."@x-gmeow-english .

logic:CandidateRejected
    a owl:NamedIndividual ,
        logic:CandidateLifecycleState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Rejected"@x-gmeow-english ;
    skos:definition "The terminal lifecycle state for a candidate review declined to formalize — recorded rather than deleted, so the decision (and its negative case) is auditable. Wire value `rejected`."@x-gmeow-english .

# ── Closed value class: the five discharge conditions ────────────────────────────

logic:DischargeCondition
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Discharge Condition"@x-gmeow-english ;
    skos:definition "The closed five-member value class of the logic:obligationDischargeCondition facet: the condition under which a logic:NonEntailmentObligation's absence-of-proof is conclusively checkable. Its individuals are logic:DischargeCertifiedFragment, logic:DischargeFiniteClosure, logic:DischargeSyntacticReachability, logic:DischargeConservativeExtension and logic:DischargeBoundedCorpus. The foundation engine wires logic:DischargeSyntacticReachability and logic:DischargeFiniteClosure; the other three are named but not yet engine-backed, so an obligation declaring one of them is a hard error rather than a silent pass. The set is closed, so a misspelt condition names no declared value and is rejected (design/LOGIC-FOUNDATION.md, §Typed formalization governance)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:DischargeCertifiedFragment
    a owl:NamedIndividual ,
        logic:DischargeCondition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Certified Fragment"@x-gmeow-english ;
    skos:definition "The discharge condition holding when the check runs within a certified complete fragment (e.g. a Datalog stratum or EL profile over which the chase terminates and is complete). Named in the closed set but not yet engine-backed. Wire value `certified-fragment`."@x-gmeow-english .

logic:DischargeFiniteClosure
    a owl:NamedIndividual ,
        logic:DischargeCondition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Finite Closure"@x-gmeow-english ;
    skos:definition "The discharge condition holding when a finite materialized derivation graph is available and complete: the obligation is discharged by checking the forbidden predicate is absent from that closure. Engine-backed (the foundation chase over an adversarial fixture). Wire value `finite-closure`."@x-gmeow-english .

logic:DischargeSyntacticReachability
    a owl:NamedIndividual ,
        logic:DischargeCondition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Syntactic Reachability"@x-gmeow-english ;
    skos:definition "The discharge condition holding when a syntactic dependency/reachability analysis over the rule heads shows the forbidden predicate is unreachable — no rule head unifies with it, directly or through any chain of rule applications. Engine-backed (reachability over the foundation rule strata). Wire value `syntactic-reachability`."@x-gmeow-english .

logic:DischargeConservativeExtension
    a owl:NamedIndividual ,
        logic:DischargeCondition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Conservative Extension"@x-gmeow-english ;
    skos:definition "The discharge condition holding when a conservative-extension proof establishes the added axioms cannot introduce the forbidden conclusion. Named in the closed set but not yet engine-backed. Wire value `conservative-extension`."@x-gmeow-english .

logic:DischargeBoundedCorpus
    a owl:NamedIndividual ,
        logic:DischargeCondition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Bounded Corpus"@x-gmeow-english ;
    skos:definition "The discharge condition holding when the obligation is explicitly bounded to a declared corpus or mutation-test space and exhaustive checking within that bound is complete. Named in the closed set but not yet engine-backed. Wire value `bounded-corpus`."@x-gmeow-english .

# ── Closed value class: the discharge verdict ────────────────────────────────────

logic:DischargeVerdict
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Discharge Verdict"@x-gmeow-english ;
    skos:definition "The closed three-value class of the logic:obligationDischargeVerdict facet: the result an obligation check returns. Its individuals are logic:ObligationDischarged, logic:ObligationUnknown (carried forward, never 'proved absent') and logic:ObligationViolated. The set is closed, so a misspelt verdict names no declared value and is rejected (design/LOGIC-FOUNDATION.md, §Typed formalization governance)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:ObligationDischarged
    a owl:NamedIndividual ,
        logic:DischargeVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Discharged"@x-gmeow-english ;
    skos:definition "The discharge verdict for an obligation conclusively checked within its declared logic:DischargeCondition: the forbidden conclusion is provably not drawn within the stated fragment or bound. Wire value `discharged`."@x-gmeow-english .

logic:ObligationUnknown
    a owl:NamedIndividual ,
        logic:DischargeVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Unknown"@x-gmeow-english ;
    skos:definition "The discharge verdict outside any wired discharge condition: not 'proved absent' but not-yet-discharged, carried forward to the next evaluation cycle or stronger fragment. The honest verdict the semi-decidable canonical logic demands. Wire value `unknown`."@x-gmeow-english .

logic:ObligationViolated
    a owl:NamedIndividual ,
        logic:DischargeVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Violated"@x-gmeow-english ;
    skos:definition "The discharge verdict when the forbidden predicate IS reachable or present in the closure: the obligation is broken and the check is a hard error. Wire value `violated`."@x-gmeow-english .

# ── Closed value class: the semantic-risk class ──────────────────────────────────

logic:SemanticRiskClass
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Semantic Risk Class"@x-gmeow-english ;
    skos:definition "The closed value class of the logic:candidateSemanticRisk facet: how far a wrong formalization of a candidate would propagate, which makes the reviewer gate proportionate. Its individuals are logic:RiskCoreContaminating, logic:RiskProjectionOnly and logic:RiskAdvisory. The set is closed, so a misspelt class names no declared value and is rejected (design/LOGIC-FOUNDATION.md, §Typed formalization governance)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:RiskCoreContaminating
    a owl:NamedIndividual ,
        logic:SemanticRiskClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Core Contaminating"@x-gmeow-english ;
    skos:definition "The semantic-risk class for a candidate whose wrong formalization would corrupt the reasoned core — the highest risk, demanding the strictest review. Wire value `core-contaminating`."@x-gmeow-english .

logic:RiskProjectionOnly
    a owl:NamedIndividual ,
        logic:SemanticRiskClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Projection Only"@x-gmeow-english ;
    skos:definition "The semantic-risk class for a candidate whose blast radius is confined to a lossy projection surface, leaving the reasoned core intact. Wire value `projection-only`."@x-gmeow-english .

logic:RiskAdvisory
    a owl:NamedIndividual ,
        logic:SemanticRiskClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Advisory"@x-gmeow-english ;
    skos:definition "The semantic-risk class for a candidate with no entailment consequence at all — advisory content, the lightest review. Wire value `advisory`."@x-gmeow-english .

# ── Closed value class: the prose-field harvest source ───────────────────────────

logic:ProseField
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Prose Field"@x-gmeow-english ;
    skos:definition "The closed three-member value class of the logic:candidateSourceField facet: which annotation field of a term's prose a logic:FormalizationCandidate harvested its axiom from. Its individuals are logic:ProseFieldDefinition, logic:ProseFieldUseWhen and logic:ProseFieldAvoidWhen, each naming the annotation property it stands for via logic:proseFieldProperty (skos:definition, gmeow:useWhen and gmeow:avoidWhen respectively). The set is closed and atomic (Principle 9), so a misspelt field names no declared value and is rejected rather than silently accepted. Read with logic:candidateFormalizes (which term) it makes harvest coverage queryable in both directions — from a harvested axiom to the exact prose field it formalizes, and from a prose field to the axioms that formalize it (design/LOGIC-FOUNDATION.md, §Typed formalization governance)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:proseFieldProperty
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "prose field property"@x-gmeow-english ;
    skos:definition "Names the annotation property a logic:ProseField value stands for — the exact term-level field (skos:definition, gmeow:useWhen or gmeow:avoidWhen) whose prose a harvested candidate formalizes. An annotation property, so the closed logic:ProseField set links to the real field IRI without punning it into the reasoned core."@x-gmeow-english .

logic:ProseFieldDefinition
    a owl:NamedIndividual ,
        logic:ProseField ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Definition"@x-gmeow-english ;
    skos:definition "The logic:ProseField for a term's skos:definition — the definitional or descriptive prose a candidate formalized. Wire value `definition`."@x-gmeow-english ;
    logic:proseFieldProperty skos:definition .

logic:ProseFieldUseWhen
    a owl:NamedIndividual ,
        logic:ProseField ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Use When"@x-gmeow-english ;
    skos:definition "The logic:ProseField for a term's gmeow:useWhen — the applicability guidance a candidate formalized. Wire value `use-when`."@x-gmeow-english ;
    logic:proseFieldProperty gmeow:useWhen .

logic:ProseFieldAvoidWhen
    a owl:NamedIndividual ,
        logic:ProseField ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Avoid When"@x-gmeow-english ;
    skos:definition "The logic:ProseField for a term's gmeow:avoidWhen — the anti-pattern or non-applicability guidance a candidate formalized. Wire value `avoid-when`."@x-gmeow-english ;
    logic:proseFieldProperty gmeow:avoidWhen .

# ── Candidate carrier properties (RBox) ──────────────────────────────────────────

logic:candidateSourceHash
    a owl:DatatypeProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate source hash"@x-gmeow-english ;
    skos:definition "The content hash of the source text a logic:FormalizationCandidate was extracted from: the anchor that ties the candidate back to the exact prose it formalizes and detects drift if that prose changes. Single-valued, xsd:string. Domain logic:FormalizationCandidate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateExtractionProvenance
    a owl:DatatypeProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate extraction provenance"@x-gmeow-english ;
    skos:definition "The provenance of a candidate's extraction — what produced it (an extractor identifier, run, or model invocation reference). Records that an automated extraction is exactly that, so it enters at logic:CandidateProposed and earns no canonical force without review. Single-valued, xsd:string. Domain logic:FormalizationCandidate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateScope
    a owl:DatatypeProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate scope"@x-gmeow-english ;
    skos:definition "The intended scope of a candidate's axiom — the terms, slice, or context it is meant to constrain. Read together with logic:candidateContract (the reasoning semantics it is interpreted under). Single-valued, xsd:string. Domain logic:FormalizationCandidate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateContract
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range logic:ReasoningContract ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate contract"@x-gmeow-english ;
    skos:definition "Relates a logic:FormalizationCandidate to the logic:ReasoningContract (ME1) its proposed axiom would be interpreted under — the semantics that make 'sound' meaningful for it. Single-valued. Domain logic:FormalizationCandidate, range logic:ReasoningContract."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateCategory
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range logic:FormalizationCategory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate category"@x-gmeow-english ;
    skos:definition "Relates a logic:FormalizationCandidate to the logic:FormalizationCategory recording what kind of force its prose carried. Single-valued and REQUIRED: a candidate with no category resolving to the closed set is a hard governance error, never silently bucketed. Domain logic:FormalizationCandidate, range logic:FormalizationCategory."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateLifecycle
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range logic:CandidateLifecycleState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate lifecycle"@x-gmeow-english ;
    skos:definition "Relates a logic:FormalizationCandidate to its current logic:CandidateLifecycleState. Single-valued. logic:CandidateAccepted is the canonical state and is legitimate only with a recorded logic:reviewedBy decision. Domain logic:FormalizationCandidate, range logic:CandidateLifecycleState."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:reviewedBy
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "reviewed by"@x-gmeow-english ;
    skos:definition "Relates a logic:FormalizationCandidate to the reviewer decision that promoted it — a provenance/agent individual recording who reviewed it and when (range stated in prose, a reviewer provenance node, so the keystone gate is machine-auditable rather than trusting a free literal). Its presence is what a logic:CandidateAccepted candidate is checked against. Single-valued. Domain logic:FormalizationCandidate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidatePositiveCase
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate positive case"@x-gmeow-english ;
    skos:definition "Relates a logic:FormalizationCandidate to a positive competency case its proposed axiom must satisfy — a gmeow:CompetencyQuestion whose expected answer the axiom should produce (range gmeow:CompetencyQuestion, stated in prose). Domain logic:FormalizationCandidate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateNegativeCase
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate negative case"@x-gmeow-english ;
    skos:definition "Relates a logic:FormalizationCandidate to a negative case or countermodel — a gmeow:CompetencyQuestion the axiom must NOT satisfy, recording the boundary the formalization must respect (range gmeow:CompetencyQuestion, stated in prose). Domain logic:FormalizationCandidate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateNonEntailment
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range logic:NonEntailmentObligation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate non-entailment"@x-gmeow-english ;
    skos:definition "Relates a logic:FormalizationCandidate to a logic:NonEntailmentObligation its axiom is required to respect — the forbidden conclusion the formalization must not let the engine draw. Domain logic:FormalizationCandidate, range logic:NonEntailmentObligation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateProjectionBehavior
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range logic:PreservationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate projection behavior"@x-gmeow-english ;
    skos:definition "Relates a logic:FormalizationCandidate to the logic:PreservationKind its axiom would carry under projection — how faithfully it survives down-projection to OWL/Datalog/SHACL. Reuses the loss-ledger preservation polarity rather than minting a parallel note. Single-valued. Domain logic:FormalizationCandidate, range logic:PreservationKind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateSemanticRisk
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range logic:SemanticRiskClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate semantic risk"@x-gmeow-english ;
    skos:definition "Relates a logic:FormalizationCandidate to its logic:SemanticRiskClass — how far a wrong formalization would propagate, which sets how strict the reviewer gate must be. Single-valued. Domain logic:FormalizationCandidate, range logic:SemanticRiskClass."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateFormalizes
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate formalizes"@x-gmeow-english ;
    skos:definition "The harvest back-link: relates a logic:FormalizationCandidate to the prose-bearing term (a gmeow: or logic: term, stated in prose) whose constraint its axiom formalizes, read together with logic:candidateSourceField (which of that term's annotation fields — skos:definition, gmeow:useWhen or gmeow:avoidWhen). Where logic:candidateSourceHash anchors the candidate to its source text by hash and logic:candidateExtractionProvenance records what produced it, this names the exact ontology term the harvested axiom keeps coherent, so harvest coverage is queryable in both directions. Present exactly when the source IS a term's annotation field (a doc-section source stays recorded in provenance alone, never a fabricated term-link); single-valued. Distinct from logic:formalizes, which bridges a logic: term to a gmeow: concept and is never a reasoned axiom. Domain logic:FormalizationCandidate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateSourceField
    a owl:ObjectProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range logic:ProseField ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate source field"@x-gmeow-english ;
    skos:definition "Names which annotation field of the logic:candidateFormalizes term a candidate harvested — a logic:ProseField from the closed set (logic:ProseFieldDefinition, logic:ProseFieldUseWhen, logic:ProseFieldAvoidWhen). Together with logic:candidateFormalizes it pins the harvested axiom to the exact source triple. Co-present with logic:candidateFormalizes: a candidate carrying one of the pair without the other is a hard governance error (verify.harvest-link-paired), never a half-link. Single-valued. Domain logic:FormalizationCandidate, range logic:ProseField."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:candidateDeliberateNonAssertion
    a owl:DatatypeProperty ;
    rdfs:domain logic:FormalizationCandidate ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "candidate deliberate non-assertion"@x-gmeow-english ;
    skos:definition "Marks a logic:FormalizationCandidate as one of the ontology's deliberate-non-assertion boundaries — an intentional refusal to over-assert that the foundation commits to and is held against: a forbidden entailment carried by a logic:NonEntailmentObligation, an integrity constraint whose violation is a finding, or a deliberately preserved class overlap. Its role is enumerability: the marked set IS the deliberate-non-assertion report, and it deliberately cuts across logic:candidateCategory (a boundary may be a logic:CategoryNonEntailmentObligation, a logic:CategoryIntegrityConstraint or a logic:CategoryDeliberateOverlap), so the whole boundary set is queryable as one report rather than inferred from an overloaded category facet (an integrity-constraint boundary is not distinguishable from an ordinary integrity constraint by category alone). Present and true on exactly the guardrail candidates; single-valued, xsd:boolean. Domain logic:FormalizationCandidate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── Obligation carrier properties (RBox) ─────────────────────────────────────────

logic:obligationForbiddenPredicate
    a owl:DatatypeProperty ;
    rdfs:domain logic:NonEntailmentObligation ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "obligation forbidden predicate"@x-gmeow-english ;
    skos:definition "The IRI of the predicate a logic:NonEntailmentObligation forbids the closure from ever containing (and forbids any rule head from producing). The check reads this IRI, then either proves it unreachable over the rule strata (logic:DischargeSyntacticReachability) or absent from the materialized closure (logic:DischargeFiniteClosure). Single-valued, xsd:anyURI. Domain logic:NonEntailmentObligation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:obligationDischargeCondition
    a owl:ObjectProperty ;
    rdfs:domain logic:NonEntailmentObligation ;
    rdfs:range logic:DischargeCondition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "obligation discharge condition"@x-gmeow-english ;
    skos:definition "Relates a logic:NonEntailmentObligation to the logic:DischargeCondition under which its absence-of-proof is conclusively checkable. An obligation declaring a condition the engine does not wire (anything other than logic:DischargeSyntacticReachability or logic:DischargeFiniteClosure) is a hard error, never a silent pass. Domain logic:NonEntailmentObligation, range logic:DischargeCondition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:obligationDischargeVerdict
    a owl:ObjectProperty ;
    rdfs:domain logic:NonEntailmentObligation ;
    rdfs:range logic:DischargeVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "obligation discharge verdict"@x-gmeow-english ;
    skos:definition "Relates a logic:NonEntailmentObligation to the logic:DischargeVerdict the check returned — logic:ObligationDischarged, logic:ObligationUnknown or logic:ObligationViolated. Computed by the engine, not asserted by hand. Domain logic:NonEntailmentObligation, range logic:DischargeVerdict."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── The conjecture / anti-conjecture library (CBox) ──────────────────────────────
# The dynamic, testable specialization of the formalization-governance spine. A
# logic:Conjecture is a logic:FormalizationCandidate (so it carries all eight
# universal candidate carriers) whose positive/negative cases are ENGINE-PRODUCED
# rather than reviewer-asserted: a named, standpoint-scoped candidate formula under
# active epistemic test, phi tested symmetrically against not-phi. Its verdict is
# scoped to a reified standpoint (Principle 9: never a global-false verdict), its
# conclusiveness reuses the existing logic:DischargeVerdict value class, and its
# EPISTEMIC lifecycle (open / corroborated / refuted-in-standpoint / withdrawn) is
# ORTHOGONAL to the GOVERNANCE lifecycle it inherits from the candidate spine
# (proposed / under-review / accepted / rejected). Two symmetric promotion legs feed
# corroborated phi back as an axiom candidate and robustly-refuted phi forward as a
# logic:NonEntailmentObligation candidate; Lakatos refinement edges relate a weakened
# successor to the witness it now excludes; and a bounded corpus pre-order
# (logic:conjectureEntails) carries phi-entails-psi propagation. Normative in
# design/LOGIC-FOUNDATION.md, the conjecture-and-refutation section.

logic:Conjecture
    a owl:Class ;
    rdfs:subClassOf logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Conjecture"@x-gmeow-english ;
    skos:definition "A named, standpoint-scoped candidate formula under active epistemic test: the dynamic, testable specialization of the logic:FormalizationCandidate spine (rdfs:subClassOf logic:FormalizationCandidate). Because it subclasses the candidate, a conjecture carries all eight universal candidate carriers (logic:candidateSourceHash, logic:candidateExtractionProvenance, logic:candidateScope, logic:candidateContract, logic:candidateCategory, logic:candidateLifecycle, logic:candidateProjectionBehavior, logic:candidateSemanticRisk); what specializes it is that its positive/negative cases are ENGINE-PRODUCED (via a scoped reasoning run recorded through logic:verdictProvenance) rather than reviewer-asserted. Its verdict is always scoped to a single reified standpoint (logic:conjectureStandpoint, REQUIRED — Principle 9 refuses a global-false verdict), and it carries an EPISTEMIC lifecycle (logic:conjectureLifecycleState: open / corroborated / refuted-in-standpoint / withdrawn) ORTHOGONAL to the GOVERNANCE lifecycle it inherits from the candidate (logic:candidateLifecycle). Conclusiveness reuses the existing logic:DischargeVerdict value class (logic:conjectureDischargeVerdict), never a freshly minted notion: a conclusive independence carries logic:ObligationDischarged, a budget-exhausted or fragment-gap run carries logic:ObligationUnknown. The conjectured formula is tested symmetrically against its constructed strong negation as two INDEPENDENT legs — support for the formula (the standpoint's KB entails it) and support for its negation (the KB refutes it, decided by the inconsistency of asserting the formula) — so a KB that entails BOTH the formula AND its negation from one standpoint yields the Belnap glut logic:InfoBoth, a within-standpoint contradiction LOCALIZED to the candidate proposition (a genuine refutation still carrying a concrete logic:ContradictionWitness), whereas a KB contradictory for reasons UNRELATED to the candidate cannot host a meaningful test at all. A refutation names a concrete logic:ContradictionWitness, and the two symmetric promotion legs feed a corroborated formula back as a canonical-axiom candidate (logic:conjecturePromotionCandidate) and a robustly-refuted formula forward as a logic:NonEntailmentObligation candidate (logic:antiConjectureObligationCandidate) (design/LOGIC-FOUNDATION.md, the conjecture-and-refutation section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:conjectureFormula
    a owl:DatatypeProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conjecture formula"@x-gmeow-english ;
    skos:definition "The canonical, alpha-normalized identity of the conjectured formula: the content_key string of the full first-order AST (the alpha-normalized content identity from the full-FOL formula AST), so two conjectures that name the same formula up to bound-variable renaming share one key and cannot be double-counted. Single-valued, xsd:string. Domain logic:Conjecture."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:conjectureStandpoint
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conjecture standpoint"@x-gmeow-english ;
    skos:definition "Relates a logic:Conjecture to the reified standpoint its verdict is scoped to — a REQUIRED, single-valued IRI (a gmeow:Standpoint, stated in prose). Standpoint scoping here is REIFICATION, never a named graph: the verdict is 'the formula is refuted FROM THIS standpoint', never a global-false claim (Principle 9). A conjecture with no standpoint has an ill-scoped verdict and is a hard governance error (verify.conjecture-standpoint-scoped). Single-valued. Domain logic:Conjecture."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:VerdictProvenanceKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Verdict Provenance Kind"@x-gmeow-english ;
    skos:definition "The closed two-member value class of the logic:verdictProvenance facet: the one genuinely-new axis a logic:Conjecture adds over a plain logic:FormalizationCandidate — whether a candidate's positive/negative cases were ENGINE-PRODUCED by a scoped reasoning run or REVIEWER-ASSERTED by hand. Its individuals are logic:VerdictEngineProduced and logic:VerdictReviewerAsserted. The set is closed, so a misspelt provenance names no declared value and is rejected (design/LOGIC-FOUNDATION.md, the conjecture-and-refutation section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:VerdictEngineProduced
    a owl:NamedIndividual ,
        logic:VerdictProvenanceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Engine Produced"@x-gmeow-english ;
    skos:definition "The verdict-provenance value for a conjecture whose positive/negative cases were produced by a scoped reasoning run over the standpoint, not asserted by a reviewer: the defining mark of a logic:Conjecture against a plain logic:FormalizationCandidate. Wire value `engine-produced`."@x-gmeow-english .

logic:VerdictReviewerAsserted
    a owl:NamedIndividual ,
        logic:VerdictProvenanceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Reviewer Asserted"@x-gmeow-english ;
    skos:definition "The verdict-provenance value for cases a reviewer asserted by hand rather than an engine deriving — the plain-candidate default, retained on the closed set so a conjecture may honestly record a hand-adjudicated case (e.g. a withdrawal) without pretending it was engine-produced. Wire value `reviewer-asserted`."@x-gmeow-english .

logic:verdictProvenance
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range logic:VerdictProvenanceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "verdict provenance"@x-gmeow-english ;
    skos:definition "Relates a logic:Conjecture to the logic:VerdictProvenanceKind recording whether its cases were engine-produced or reviewer-asserted — the one genuinely-new axis the conjecture library adds over the candidate spine. Single-valued and REQUIRED. Domain logic:Conjecture, range logic:VerdictProvenanceKind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:ConjectureLifecycleState
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Conjecture Lifecycle State"@x-gmeow-english ;
    skos:definition "The closed four-member value class of the logic:conjectureLifecycleState facet: the EPISTEMIC state a logic:Conjecture occupies, ORTHOGONAL to the GOVERNANCE lifecycle (logic:CandidateLifecycleState) it inherits from the candidate spine — Principle 9 refuses to collapse two distinct axes into one. Its individuals are logic:ConjectureOpen, logic:ConjectureCorroborated, logic:ConjectureRefutedInStandpoint and logic:ConjectureWithdrawn, each projected from a Belnap truth-value origin (Supported becomes Corroborated; Opposed or Both becomes RefutedInStandpoint; Neither-conclusive becomes Open carrying logic:ObligationDischarged; Undetermined or BudgetExhausted becomes Open carrying logic:ObligationUnknown; Withdrawn is an author action, never engine-produced). The set is closed, so a misspelt state names no declared value and is rejected (design/LOGIC-FOUNDATION.md, the conjecture-and-refutation section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:ConjectureOpen
    a owl:NamedIndividual ,
        logic:ConjectureLifecycleState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Open"@x-gmeow-english ;
    skos:definition "The epistemic state of a conjecture whose symmetric formula / negation test was NOT conclusive in either direction: neither corroborated nor refuted. Two Belnap origins land here and are told apart by the carried logic:conjectureDischargeVerdict — a Neither-conclusive run (formula and negation both genuinely undecided within a complete fragment) carries logic:ObligationDischarged (conclusive independence), while an Undetermined or budget-exhausted run carries logic:ObligationUnknown (not proved absent, carried forward). A timeout NEVER reads as refuted. Wire value `open`."@x-gmeow-english .

logic:ConjectureCorroborated
    a owl:NamedIndividual ,
        logic:ConjectureLifecycleState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Corroborated"@x-gmeow-english ;
    skos:definition "The epistemic state of a conjecture whose formula was Supported (Belnap true) from its standpoint: the symmetric test found for the formula and no counterexample. Corroboration is provisional support, never proof — a corroborated formula becomes eligible for the positive promotion leg (logic:conjecturePromotionCandidate to a canonical-axiom candidate), still gated through review. Wire value `corroborated`."@x-gmeow-english .

logic:ConjectureRefutedInStandpoint
    a owl:NamedIndividual ,
        logic:ConjectureLifecycleState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Refuted In Standpoint"@x-gmeow-english ;
    skos:definition "The epistemic state of a conjecture whose formula was Opposed or Both (Belnap false or contradictory) from its standpoint: a concrete counterexample was found, forcing some individual to owl:Nothing. The refutation is scoped to the standpoint (Principle 9), never global-false, and MUST name a concrete logic:ContradictionWitness (logic:conjectureRefutationWitness, enforced by logic:ConjectureShape and verify.conjecture-refutation-witness-required). A robustly-refuted formula becomes eligible for the anti-conjecture promotion leg (logic:antiConjectureObligationCandidate to a logic:NonEntailmentObligation candidate forbidding the formula). Wire value `refuted-in-standpoint`."@x-gmeow-english .

logic:ConjectureWithdrawn
    a owl:NamedIndividual ,
        logic:ConjectureLifecycleState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Withdrawn"@x-gmeow-english ;
    skos:definition "The terminal epistemic state of a conjecture its author retired — a deliberate authoring action, NEVER an engine-produced verdict (a withdrawn conjecture carries logic:verdictProvenance logic:VerdictReviewerAsserted). Recorded rather than deleted, so the retirement and any partial evidence stay auditable. Distinct from refuted: withdrawal is a human decision to stop testing, not a found counterexample. Wire value `withdrawn`."@x-gmeow-english .

logic:conjectureLifecycleState
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range logic:ConjectureLifecycleState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conjecture lifecycle state"@x-gmeow-english ;
    skos:definition "Relates a logic:Conjecture to its current EPISTEMIC logic:ConjectureLifecycleState (open / corroborated / refuted-in-standpoint / withdrawn). Single-valued and REQUIRED. Orthogonal to logic:candidateLifecycle (the GOVERNANCE state inherited from the candidate spine): a conjecture may be governance-accepted yet epistemically open, so the two are never collapsed (Principle 9). Domain logic:Conjecture, range logic:ConjectureLifecycleState."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:withdrawalReason
    a owl:DatatypeProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "withdrawal reason"@x-gmeow-english ;
    skos:definition "The author's free-text rationale recorded when a logic:Conjecture is retired to logic:ConjectureWithdrawn — the human note explaining WHY testing stopped, carried on the compensating author-withdrawal segment appended to the append-only conjecture library. Distinct from a found counterexample (which a refutation names through logic:conjectureRefutationWitness): a withdrawal is a deliberate authoring decision to stop testing, so this reason is a reviewer-asserted datum (the withdrawal carries logic:verdictProvenance logic:VerdictReviewerAsserted), NEVER engine-produced. Optional and single-valued; present exactly when a withdrawal names a reason. Domain logic:Conjecture, range xsd:string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

logic:ContradictionWitness
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Contradiction Witness"@x-gmeow-english ;
    skos:definition "The RDF shape of the runtime refutation witness a conjecture test emits when it refutes the formula: the concrete counterexample that forced an individual to owl:Nothing. It names the offending individual (logic:witnessIndividual), the world IRI the contradiction was found in (logic:witnessWorld), and the set of premises that jointly entailed the contradiction (logic:witnessPremise, one serialized triple each, multi-valued). It is an ABox artifact — a produced fact about a specific reasoning run, not a constraint — and is present exactly when its conjecture is logic:ConjectureRefutedInStandpoint (design/LOGIC-FOUNDATION.md, the conjecture-and-refutation section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

logic:witnessIndividual
    a owl:DatatypeProperty ;
    rdfs:domain logic:ContradictionWitness ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "witness individual"@x-gmeow-english ;
    skos:definition "The individual a logic:ContradictionWitness records as forced to owl:Nothing — the entity whose type became unsatisfiable under the conjectured formula, identifying exactly where the contradiction bit. Single-valued, xsd:string (the individual's IRI as a string). Domain logic:ContradictionWitness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

logic:witnessWorld
    a owl:DatatypeProperty ;
    rdfs:domain logic:ContradictionWitness ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "witness world"@x-gmeow-english ;
    skos:definition "The world IRI the logic:ContradictionWitness was found in — the modal/context world within the conjecture's standpoint where the contradiction was realized, so the refutation stays world-scoped rather than asserted across all worlds. Single-valued, xsd:string (the world IRI as a string). Domain logic:ContradictionWitness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

logic:witnessPremise
    a owl:DatatypeProperty ;
    rdfs:domain logic:ContradictionWitness ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "witness premise"@x-gmeow-english ;
    skos:definition "A premise that participated in the contradiction a logic:ContradictionWitness records — one serialized triple (subject predicate object) per value, MULTI-valued because a refutation typically rests on several jointly-inconsistent facts. Together the premises are the minimal derivation the reader can replay to see why the formula is refuted from the standpoint. Multi-valued, xsd:string. Domain logic:ContradictionWitness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

logic:conjectureRefutationWitness
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range logic:ContradictionWitness ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conjecture refutation witness"@x-gmeow-english ;
    skos:definition "Relates a refuted logic:Conjecture to the logic:ContradictionWitness that refutes it — the concrete counterexample naming the individual forced to owl:Nothing, the world, and the premises. Present exactly when the conjecture is logic:ConjectureRefutedInStandpoint (a refuted conjecture with no witness is a hard error, logic:ConjectureShape and verify.conjecture-refutation-witness-required; a witness on a non-refuted conjecture is meaningless). Domain logic:Conjecture, range logic:ContradictionWitness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:conjectureVerdict
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conjecture verdict"@x-gmeow-english ;
    skos:definition "Relates a logic:Conjecture to the content-addressed reasoning-result node its verdict was read from — a logic:ReasoningResult (stated in prose) produced by the scoped reasoning run over the standpoint. Where logic:conjectureLifecycleState and logic:conjectureDischargeVerdict carry the projected epistemic verdict and conclusiveness, this links back to the full result graph the projection was computed from, so the verdict is auditable against its source run. Single-valued. Domain logic:Conjecture."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:conjectureDischargeVerdict
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range logic:DischargeVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conjecture discharge verdict"@x-gmeow-english ;
    skos:definition "Relates a logic:Conjecture to the logic:DischargeVerdict carrying its CONCLUSIVENESS — reusing the existing three-value obligation class rather than minting a parallel notion. logic:ObligationDischarged marks a conclusive result (a corroboration or a refutation within a complete fragment, or a conclusive independence for an open conjecture); logic:ObligationUnknown marks a budget-exhausted or fragment-gap run that is carried forward, never 'proved'. An open conjecture carrying logic:ObligationUnknown that is NOT in logic:ConjectureOpen is a hard error (verify.conjecture-open-if-inconclusive): a timeout may never read as refuted. Single-valued. Domain logic:Conjecture, range logic:DischargeVerdict."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:conjecturePromotionCandidate
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conjecture promotion candidate"@x-gmeow-english ;
    skos:definition "The POSITIVE promotion leg: relates a logic:ConjectureCorroborated conjecture to the logic:FormalizationCandidate proposing to promote its formula to a canonical axiom. The candidate still runs the ordinary reviewer gate (corroboration is provisional support, never proof), so a corroborated conjecture never becomes a canonical axiom by mere entailment. Present exactly when the conjecture is corroborated. Domain logic:Conjecture, range logic:FormalizationCandidate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:antiConjectureObligationCandidate
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range logic:NonEntailmentObligation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "anti-conjecture obligation candidate"@x-gmeow-english ;
    skos:definition "The symmetric anti-conjecture promotion leg: relates a robustly logic:ConjectureRefutedInStandpoint conjecture to a candidate logic:NonEntailmentObligation forbidding its formula — a refuted formula is not merely dropped, it becomes a first-class commitment that the foundation must NEVER draw it. Mirrors logic:conjecturePromotionCandidate (corroborated to axiom candidate) under negation (refuted to non-entailment candidate). Present exactly when the conjecture is refuted-in-standpoint. Domain logic:Conjecture, range logic:NonEntailmentObligation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:conjectureRefinedFrom
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range logic:Conjecture ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conjecture refined from"@x-gmeow-english ;
    skos:definition "The Lakatos refinement edge: relates a successor conjecture to the refuted conjecture it weakens — the 'monster-barring' move where a refuted conjecture is not abandoned but replaced by a strictly weaker successor that excludes the counterexample. Read together with logic:survivesCounterexample (the witness the successor now excludes). Domain logic:Conjecture, range logic:Conjecture."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:survivesCounterexample
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range logic:ContradictionWitness ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "survives counterexample"@x-gmeow-english ;
    skos:definition "The Lakatos survival edge: relates a refined successor conjecture to the logic:ContradictionWitness that refuted its predecessor and which the successor now EXCLUDES — the evidence that the refinement did real work, not just relabelled the claim. Paired with logic:conjectureRefinedFrom, it lets the corpus show a refinement chain where each successor demonstrably survives a witness that killed its parent. Domain logic:Conjecture, range logic:ContradictionWitness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:conjectureEntails
    a owl:ObjectProperty ;
    rdfs:domain logic:Conjecture ;
    rdfs:range logic:Conjecture ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conjecture entails"@x-gmeow-english ;
    skos:definition "The corpus entailment pre-order over conjectures: logic:conjectureEntails relates a formula phi to a formula psi it entails (phi models psi), so a refutation of psi propagates contrapositively to phi (if psi is refuted, phi cannot stand). The relation is a PRE-ORDER in intent (reflexive and transitive), but its full transitive closure is NOT materialized as a stored relation: the vocabulary carries each pairwise edge and the propagation competency query (conjecture-entails-propagation.rq) reasons over those edges directly, so contrapositive propagation is queryable without the corpus-wide closure being computed as a persisted extension. Each edge is itself a conjecture test (that phi genuinely entails psi), not a bare assertion. Domain logic:Conjecture, range logic:Conjecture."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox .

logic:ProjectionLoss
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Projection Loss"@x-gmeow-english ;
    skos:definition "An in-band declaration that a lossy projection dropped structure its source carried — emitted into the projected graph itself, never a sidecar. GTS stays lossless; loss is declared only at the exit gate (Principle 17 / Principle 4). A loss-aware SPARQL CONSTRUCT mints one when its template omits an RDF-1.2 reification layer that its WHERE matched, so a downstream consumer of the projection can see exactly what was shed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:lossCode
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "loss code"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The stable machine code of a logic:ProjectionLoss — reifier-layer-dropped, annotation-layer-dropped, or standpoint-scope-dropped — naming exactly which structure the projection shed. The codes are shared verbatim with the conversion loss ledger so in-band and contract-level loss declarations agree."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:lostReifies
    a owl:ObjectProperty ;
    rdfs:domain logic:ProjectionLoss ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "lost reifies"@x-gmeow-english ;
    skos:definition "Points from a logic:ProjectionLoss to the RDF-1.2 triple term whose reifier (and any annotations) the projection dropped, so a consumer can recover which statement lost its reification layer. The object is a quoted triple term; its range is intentionally left open (stated in prose) to keep the OWL down-projection DL-clean."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── The Correspondence calculus (the ninth node kind's spine) ─────────────────────
# Cross-ontology alignment as a first-class, law-bearing logic: object. A
# logic:Correspondence (declared above as the ninth logic:NodeKind) wraps a logic:Lens —
# its executable get/put core — in a meta-formula envelope: a typed
# logic:CorrespondenceRelation on an ordered lattice, an algebraic logic:MorphismClass on
# the ordered law-spine, the separated quantitative axes (logic:confidence,
# logic:evidenceStrength, logic:weight, logic:probability) plus logic:Determinacy, the
# claimed logic:LawClaim constraints (whose discharge reuses the logic:DischargeVerdict /
# logic:DischargeCondition vocabulary of the foundation), and a standpoint index. SSSOM,
# EDOAL, FnO, SPARQL CONSTRUCT and the OWL-alignment axioms are generated lowerings of this
# one object, never second sources (design/LOGIC-CORRESPONDENCE.md).

logic:Lens
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Lens"@x-gmeow-english ;
    skos:definition "The executable asymmetric core a logic:Correspondence wraps: a get / put leg pair between a rich source S and a derived view V, with get : S → V the down-projection and put : V × S → S the up-projection. GMEOW is always the source S and the external vocabulary the view V, so down-projection (GMEOW → external) is the get leg and up-projection (external → GMEOW) is the put leg. The view is the smaller, derived thing; put folds a possibly-fresh view back into the rich source, and the ingest-with-no-prior-state case (S empty) is exactly where a witness must travel in the view — the mnemomorphism a logic:Correspondence records with logic:mnemomorphic. Both legs are logic:TransactionProgram bodies over the path semantics of the transaction layer and logic:PathShape — no new pattern language is introduced. It is not the logic:Correspondence envelope, which separately carries the relation, quantitative axes, law claims, and standpoint (design/LOGIC-CORRESPONDENCE.md, the orientation-convention section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:GroundingCorrespondence
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Grounding Correspondence"@x-gmeow-english ;
    skos:definition "A logic:Correspondence owned by one of the three co-foundational grounding slices (logic:, math:, or lang:) and shipped as meta-level correspondence data in graph/correspondence-laws. Unlike an ordinary consumer mapping, every grounding correspondence explicitly declares its logic:morphismClass, logic:morphismKind, and logic:preservationKind, and names both related terms through logic:sourceEndpoint and logic:targetEndpoint. It remains outside object-level closure: external vocabularies are linked by reference and their TBoxes are never silently imported."@x-gmeow-english ;
    skos:example "ex:bridge a logic:GroundingCorrespondence ; logic:sourceEndpoint logic:Restriction ; logic:targetEndpoint owl:Restriction ."@x-gmeow-english ;
    skos:scopeNote "Grounding correspondences are shipped correspondence-law data; they do not import or canonize the external target vocabulary."@x-gmeow-english ;
    gmeow:useWhen "Use for a reviewed cross-vocabulary bridge whose source is owned by lang:, math:, or logic:."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for an ordinary domain projection or for a row whose external term is presented as the canonical source."@x-gmeow-english ;
    gmeow:howToUse "Name one grounding source and one external target, then declare the morphism class, morphism kind, and preservation kind explicitly."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:subClassOf [
        a owl:Restriction ; owl:onProperty gmeow:justification ;
        owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ;
    ] ,
    [
        a owl:Restriction ; owl:onProperty logic:sourceEndpoint ;
        owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ;
    ] ,
    [
        a owl:Restriction ; owl:onProperty logic:targetEndpoint ;
        owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ;
    ] ,
    [
        a owl:Restriction ; owl:onProperty logic:morphismClass ;
        owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ;
    ] ,
    [
        a owl:Restriction ; owl:onProperty logic:morphismClass ;
        owl:allValuesFrom [ owl:oneOf ( logic:Isomorphism logic:SectionRetraction logic:WellBehavedLens
            logic:LossyLens logic:Prism logic:AffineCorrespondence logic:BridgeView ) ] ;
    ] ,
    [
        a owl:Restriction ; owl:onProperty logic:morphismKind ;
        owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ;
    ] ,
    [
        a owl:Restriction ; owl:onProperty logic:morphismKind ;
        owl:allValuesFrom [ owl:oneOf ( logic:InstitutionMorphism logic:CommitmentShiftingBridge ) ] ;
    ] ,
    [
        a owl:Restriction ; owl:onProperty logic:preservationKind ;
        owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ;
    ] ,
    [
        a owl:Restriction ; owl:onProperty logic:preservationKind ;
        owl:allValuesFrom [ owl:oneOf ( logic:ExactPreservation logic:SoundUnderApproximation
            logic:CompleteOverApproximation logic:InconsistencyPreserving
            logic:InconsistencyReflecting logic:ValidationOnly logic:Unsupported ) ] ;
    ] .

# Migrated declarative requiredness (shapes/mapping-dsl-shapes.ttl
# logic:GroundingCorrespondenceShape, Principle 17): the six per-property
# ∃-requirements. The shape's compound sh:xone frontend-selection, the
# BridgeView/CommitmentShiftingBridge pairing sh:or, and the two sh:sparql
# endpoint-agreement / anti-equivalence checks are NOT re-authored here — they
# are a genuine multi-level disjunctive class-membership + cross-property
# equality expressiveness gap over an already-large, widely-shared module, left
# as an honest boundary for a follow-up pass rather than a fragile
# under-tested reproduction.
gmeow:GroundingCorrespondenceJustificationRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "GroundingCorrespondence justification requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a logic:GroundingCorrespondence must explicitly declare one IRI-valued gmeow:justification."@x-gmeow-english ;
    logic:onClass logic:GroundingCorrespondence ;
    logic:anyOf gmeow:justification ;
    logic:formalizes logic:GroundingCorrespondence ;
    logic:message "GroundingCorrespondence must explicitly declare one IRI-valued gmeow:justification"@x-gmeow-english .

gmeow:GroundingCorrespondenceSourceEndpointRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "GroundingCorrespondence source-endpoint requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a logic:GroundingCorrespondence must explicitly declare one IRI-valued logic:sourceEndpoint."@x-gmeow-english ;
    logic:onClass logic:GroundingCorrespondence ;
    logic:anyOf logic:sourceEndpoint ;
    logic:formalizes logic:GroundingCorrespondence ;
    logic:message "GroundingCorrespondence must explicitly declare one IRI-valued logic:sourceEndpoint"@x-gmeow-english .

gmeow:GroundingCorrespondenceTargetEndpointRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "GroundingCorrespondence target-endpoint requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a logic:GroundingCorrespondence must explicitly declare one IRI-valued logic:targetEndpoint."@x-gmeow-english ;
    logic:onClass logic:GroundingCorrespondence ;
    logic:anyOf logic:targetEndpoint ;
    logic:formalizes logic:GroundingCorrespondence ;
    logic:message "GroundingCorrespondence must explicitly declare one IRI-valued logic:targetEndpoint"@x-gmeow-english .

gmeow:GroundingCorrespondenceMorphismClassRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "GroundingCorrespondence morphismClass requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a logic:GroundingCorrespondence must explicitly declare one logic:morphismClass."@x-gmeow-english ;
    logic:onClass logic:GroundingCorrespondence ;
    logic:anyOf logic:morphismClass ;
    logic:formalizes logic:GroundingCorrespondence ;
    logic:message "GroundingCorrespondence must explicitly declare one logic:morphismClass"@x-gmeow-english .

gmeow:GroundingCorrespondenceMorphismKindRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "GroundingCorrespondence morphismKind requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a logic:GroundingCorrespondence must explicitly declare one logic:morphismKind."@x-gmeow-english ;
    logic:onClass logic:GroundingCorrespondence ;
    logic:anyOf logic:morphismKind ;
    logic:formalizes logic:GroundingCorrespondence ;
    logic:message "GroundingCorrespondence must explicitly declare one logic:morphismKind"@x-gmeow-english .

gmeow:GroundingCorrespondencePreservationKindRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "GroundingCorrespondence preservationKind requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a logic:GroundingCorrespondence must explicitly declare one logic:preservationKind."@x-gmeow-english ;
    logic:onClass logic:GroundingCorrespondence ;
    logic:anyOf logic:preservationKind ;
    logic:formalizes logic:GroundingCorrespondence ;
    logic:message "GroundingCorrespondence must explicitly declare one logic:preservationKind"@x-gmeow-english .

logic:CorrespondenceRelation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Correspondence Relation"@x-gmeow-english ;
    skos:definition "The typed, closed value class of a logic:Correspondence's relation, on an ordered lattice rather than a free string: logic:Equiv ⊐ { logic:Subsumes, logic:SubsumedBy } ⊐ logic:Overlaps ⊐ logic:RelatedMatch, with logic:Disjoint the negative pole. From one authored relation the compiler derives the SSSOM predicate, the EDOAL relation symbol and the OWL-alignment-axiom strength, so the generated alignment artifacts cannot drift apart. The set is closed, so a misspelt relation names no declared value and is rejected (design/LOGIC-CORRESPONDENCE.md, the relation-lattice section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Equiv
    a owl:NamedIndividual ,
        logic:CorrespondenceRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "equivalent"@x-gmeow-english ;
    skos:definition "The top of the correspondence-relation lattice: the source pattern and the view pattern denote one and the same extension. Lowers to sssom:exactMatch and (when the logic:MorphismClass and logic:LawClaim set support it) owl:equivalentClass; the strongest claim, never licensed for a commitment-shifting bridge."@x-gmeow-english .

logic:Subsumes
    a owl:NamedIndividual ,
        logic:CorrespondenceRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "subsumes"@x-gmeow-english ;
    skos:definition "The source pattern is broader than the view: every view instance is a source instance but not conversely. Lowers to sssom:broadMatch and an owl:subClassOf with the view as the subclass. One of the two mid-lattice directional relations under logic:Equiv."@x-gmeow-english .

logic:SubsumedBy
    a owl:NamedIndividual ,
        logic:CorrespondenceRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "subsumed by"@x-gmeow-english ;
    skos:definition "The source pattern is narrower than the view: every source instance is a view instance but not conversely. Lowers to sssom:narrowMatch and an owl:subClassOf with the source as the subclass. The converse direction of logic:Subsumes, the second mid-lattice relation under logic:Equiv."@x-gmeow-english .

logic:Overlaps
    a owl:NamedIndividual ,
        logic:CorrespondenceRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "overlaps"@x-gmeow-english ;
    skos:definition "Source and view share instances without either subsuming the other: a partial, caveated alignment. Lowers to sssom:closeMatch (an OWL equivalence is unsupported and the overclaim gate refuses one). Below the directional band, above logic:RelatedMatch. Distinct from the mereological relation logic:overlaps (shared parts of one whole); this is a relation between two aligned patterns."@x-gmeow-english .

logic:RelatedMatch
    a owl:NamedIndividual ,
        logic:CorrespondenceRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "related match"@x-gmeow-english ;
    skos:definition "The weakest positive relation: source and view are associated (curatorially relevant) but neither equivalent, subsuming nor reliably overlapping. Lowers to sssom:relatedMatch only; no logical alignment axiom is emitted. The floor of the positive lattice, above only the negative pole logic:Disjoint."@x-gmeow-english .

logic:Disjoint
    a owl:NamedIndividual ,
        logic:CorrespondenceRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "disjoint match"@x-gmeow-english ;
    skos:definition "The negative pole of the correspondence-relation lattice: source and view share no instances, an asserted non-alignment. Lowers to owl:disjointWith. Distinct from the mereological relation logic:disjoint (two entities sharing no part); this records that two aligned patterns are deliberately kept apart."@x-gmeow-english .

logic:MorphismClass
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Morphism Class"@x-gmeow-english ;
    skos:definition "The ordered law-spine of a logic:Correspondence: how much invertibility it may lawfully claim, where each rung caps the laws the correspondence may assert. From strongest to floor the seven rungs are logic:Isomorphism, logic:SectionRetraction, logic:WellBehavedLens, logic:LossyLens, logic:Prism, logic:AffineCorrespondence and logic:BridgeView. The spine fuses the profunctor-optic lattice with the categorical subobject notion; composition can only weaken the rung, never strengthen it, and a logic:mnemomorphic witness is what lets a correspondence climb it. The set is closed, so a misspelt class names no declared rung and is rejected (design/LOGIC-CORRESPONDENCE.md, the ordered-law-spine section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Isomorphism
    a owl:NamedIndividual ,
        logic:MorphismClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Isomorphism"@x-gmeow-english ;
    skos:definition "The top rung: an iso, get ∘ put = id and put ∘ get = id, a full round-trip in both directions. The only rung that licenses a confidence-1.0 equivalence. Caps: both round-trip laws claimable."@x-gmeow-english .

logic:SectionRetraction
    a owl:NamedIndividual ,
        logic:MorphismClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Section / Retraction"@x-gmeow-english ;
    skos:definition "Perfect subsumption: a split mono with put ∘ get = id_S and get ∘ put idempotent on V ⊕ complement. The source embeds losslessly into the view, the augmentation being S ∖ im(get) carried in the in-band complement. Caps: the section law (lossless source recovery), but not full bidirectional iso."@x-gmeow-english .

logic:WellBehavedLens
    a owl:NamedIndividual ,
        logic:MorphismClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Well-Behaved Lens"@x-gmeow-english ;
    skos:definition "An asymmetric lens: a structured-to-flat downcast with sound update. Caps: logic:GetPut and logic:PutGet claimable (logic:PutPut optional). The workhorse rung for a faithful but non-embedding projection."@x-gmeow-english .

logic:LossyLens
    a owl:NamedIndividual ,
        logic:MorphismClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Lossy Lens"@x-gmeow-english ;
    skos:definition "A lens with non-injective get: one direction is faithful but the inverse needs a witness, a co-authored put-with-claim, or declared defaults. Most schema.org / FOAF downcasts live here. Caps: a single faithful direction; the put leg may not claim recovery without a logic:mnemomorphic witness."@x-gmeow-english .

logic:Prism
    a owl:NamedIndividual ,
        logic:MorphismClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Prism"@x-gmeow-english ;
    skos:definition "A partial map S → V + S that matches and builds only on the in-focus case of a sum or optional: the optic for 'this correspondence applies when the source is of a particular variant, otherwise it passes through.' Caps: match / build laws on the in-focus case only. Paired with logic:AffineCorrespondence as the partial-alignment band below logic:LossyLens."@x-gmeow-english .

logic:AffineCorrespondence
    a owl:NamedIndividual ,
        logic:MorphismClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Affine Correspondence"@x-gmeow-english ;
    skos:definition "A co-projection onto a shared component: the 'similar but not quite' alignment, where source and view agree on a common part but neither embeds in the other. The companion of logic:Prism in the partial-alignment band — a Prism focuses an optional variant, an affine correspondence focuses a shared sub-structure. The correct rung for a logic:Vague logic:Determinacy target, NOT a low-confidence logic:Equiv. Caps: laws on the shared component only."@x-gmeow-english .

logic:BridgeView
    a owl:NamedIndividual ,
        logic:MorphismClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Bridge View"@x-gmeow-english ;
    skos:definition "The floor rung: a commitment-shifting comorphism with NO satisfaction-preservation claim — the alignment to BFO, DOLCE, SUMO or YAMATO. A bridge view carries logic:morphismKind logic:CommitmentShiftingBridge, and the loss ledger refuses to emit owl:equivalentClass for it. Caps: no preservation law; the alignment is a by-reference bridge, never an identity."@x-gmeow-english .

logic:MorphismKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Morphism Kind"@x-gmeow-english ;
    skos:definition "The closed two-value qualifier, orthogonal to the logic:MorphismClass rung, recording the institution-theoretic split between a satisfaction-preserving morphism (logic:InstitutionMorphism) and a commitment-shifting bridge (logic:CommitmentShiftingBridge). This is the distinction the foundation already draws between a truth-preserving down-projection and a by-reference bridge; the loss ledger refuses owl:equivalentClass for the bridge kind. The set is closed, so a misspelt kind names no declared value and is rejected (design/LOGIC-CORRESPONDENCE.md, the ordered-law-spine section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:InstitutionMorphism
    a owl:NamedIndividual ,
        logic:MorphismKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Institution Morphism"@x-gmeow-english ;
    skos:definition "A satisfaction-preserving morphism between theories presented as institutions: truth in the source maps to truth in the view, so logical alignment axioms (up to owl:equivalentClass when the rung allows) are licensed. The morphism kind of a faithful down-projection."@x-gmeow-english .

logic:CommitmentShiftingBridge
    a owl:NamedIndividual ,
        logic:MorphismKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Commitment-Shifting Bridge"@x-gmeow-english ;
    skos:definition "A bridge that shifts ontological commitment rather than preserving satisfaction: the kind borne by a logic:BridgeView alignment to a top-level ontology (BFO, DOLCE, SUMO, YAMATO). The loss ledger refuses to emit owl:equivalentClass for it; the bridge is adopted by reference (Principle 5), never as an identity collapse."@x-gmeow-english .

logic:Determinacy
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Determinacy"@x-gmeow-english ;
    skos:definition "The closed two-value axis recording whether the TARGET RELATIONSHIP a logic:Correspondence asserts is ontically crisp (logic:Crisp) or vague (logic:Vague). It is separate from logic:confidence: 'similar but not quite' is logic:Vague determinacy with a logic:AffineCorrespondence class, NOT a low-confidence logic:Equiv. Conflating the two destroys the distinction between an uncertain sharp claim and a confident fuzzy one. The set is closed, so a misspelt value names no declared determinacy and is rejected (design/LOGIC-CORRESPONDENCE.md, the quantitative-and-contextual-axes section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Crisp
    a owl:NamedIndividual ,
        logic:Determinacy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "crisp"@x-gmeow-english ;
    skos:definition "The target relationship is ontically sharp: the alignment either holds or does not, with no borderline cases. The determinacy of an equivalence or a clean subsumption."@x-gmeow-english .

logic:Vague
    a owl:NamedIndividual ,
        logic:Determinacy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "vague"@x-gmeow-english ;
    skos:definition "The target relationship is ontically fuzzy: it holds to a degree or only on a shared component, with genuine borderline cases. Paired with a logic:AffineCorrespondence class for the 'similar but not quite' alignment — vagueness in the world, not uncertainty in the curator."@x-gmeow-english .

logic:CorrespondenceLaw
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Correspondence Law"@x-gmeow-english ;
    skos:definition "The closed value class of the lens laws a logic:Correspondence can claim through a logic:LawClaim: logic:GetPut, logic:PutGet, logic:PutPut and logic:SectionLaw. Which laws are claimable is capped by the correspondence's logic:MorphismClass rung, and each claim carries a logic:DischargeVerdict. The set is closed, so a misspelt law names no declared value and is rejected (design/LOGIC-CORRESPONDENCE.md, the ninth-node-kind section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:GetPut
    a owl:NamedIndividual ,
        logic:CorrespondenceLaw ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "GetPut"@x-gmeow-english ;
    skos:definition "The lens law put(get(s), s) = s: getting a view from a source and immediately putting it back leaves the source unchanged. Claimable from the logic:WellBehavedLens rung upward; the acquisition-stability law."@x-gmeow-english .

logic:PutGet
    a owl:NamedIndividual ,
        logic:CorrespondenceLaw ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "PutGet"@x-gmeow-english ;
    skos:definition "The lens law get(put(v, s)) = v: putting a view into a source and reading it back yields exactly that view. Claimable from the logic:WellBehavedLens rung upward; the update-faithfulness law."@x-gmeow-english .

logic:PutPut
    a owl:NamedIndividual ,
        logic:CorrespondenceLaw ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "PutPut"@x-gmeow-english ;
    skos:definition "The very-well-behaved lens law put(v2, put(v1, s)) = put(v2, s): a later put overwrites an earlier one with no residue. Optional even at the logic:WellBehavedLens rung; claimed only by correspondences whose put leg is genuinely history-free."@x-gmeow-english .

logic:SectionLaw
    a owl:NamedIndividual ,
        logic:CorrespondenceLaw ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Section Law"@x-gmeow-english ;
    skos:definition "The perfect-subsumption law put ∘ get = id_S: the source is recovered exactly from its view because the in-band complement retained everything the retraction needs (a logic:mnemomorphic witness). Claimable only at the logic:SectionRetraction rung or above; the CI-checkable form of 'GMEOW perfectly subsumes this vocabulary.'"@x-gmeow-english .

logic:LawClaim
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Law Claim"@x-gmeow-english ;
    skos:definition "A claim that a logic:Correspondence satisfies a particular logic:CorrespondenceLaw (named by logic:lawClaimed), together with the discharge state of that claim: a logic:DischargeVerdict via logic:lawDischargeVerdict and, when applicable, the logic:DischargeCondition under which it was checked via logic:lawDischargeCondition. It reuses the foundation's executable discharge vocabulary rather than a parallel status enum: a law proved within a certified fragment is logic:ObligationDischarged under logic:DischargeCertifiedFragment; a refuted law is logic:ObligationViolated with its countermodel; an authored-but-unchecked or inconclusive law is logic:ObligationUnknown, carried forward. The overclaim gate fires when a correspondence claims a law its lowered legs do not satisfy (design/LOGIC-CORRESPONDENCE.md, the preservation-is-the-lens-law-framework section)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:RecoveryCase
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Recovery Case"@x-gmeow-english ;
    skos:definition "A first-class executable query-class case that decides whether a logic:Correspondence genuinely recovers its source. Its logic:recoveryTransform is an ordered universally quantified source-to-view logic:Formula. The native correspondence executor instantiates the complete source pattern, computes the declared view, derives the candidate inverse, and compares the recovered source graph with the original. A recovery case is neutral evidence rather than a positive assertion: it may discharge a genuine section/retraction or deliberately refute a lossy mapping by retaining a source distinction absent from the view. Every logic:mnemomorphic true correspondence that claims logic:SectionLaw requires executable complete recovery evidence: an atomic one-triple leg may synthesize its complete case, while a composite leg requires an authored logic:RecoveryCase. A structural inverse or a declared boolean alone is never proof (design/LOGIC-CORRESPONDENCE.md, genuine recovery cases)."@x-gmeow-english ;
    logic:formalizes logic:recoveryTransformValuesAreFormulae ;
    gmeow:graphBoxRole gmeow:boxTBox .

# Canonical value-type axiom for the OWL allValuesFrom projection below:
# every recovery-transform value attached to a RecoveryCase is a Formula.
logic:recoveryTransformValuesAreFormulae
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "recovery-transform values are formulae"@x-gmeow-english ;
    skos:definition "For every recovery case and transform value, if the case is a logic:RecoveryCase and bears that value through logic:recoveryTransform, then the value is a logic:Formula. This canonical first-order axiom grounds the OWL all-values-from projection used by validation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "case" ] ,
        [ logic:termIndex 1 ; logic:termVariable "transform" ] ;
    logic:forall logic:rtvfImplication .

logic:rtvfImplication
    a logic:Formula ;
    logic:antecedent logic:rtvfAntecedent ;
    logic:consequent logic:rtvfFormulaType .

logic:rtvfAntecedent
    a logic:Formula ;
    logic:and logic:rtvfCaseType , logic:rtvfTransform .

logic:rtvfCaseType
    a logic:Formula ;
    logic:relation rdf:type ;
    logic:argument
        [ logic:termIndex 0 ; logic:termVariable "case" ] ,
        [ logic:termIndex 1 ; logic:termIri logic:RecoveryCase ] .

logic:rtvfTransform
    a logic:Formula ;
    logic:relation logic:recoveryTransform ;
    logic:argument
        [ logic:termIndex 0 ; logic:termVariable "case" ] ,
        [ logic:termIndex 1 ; logic:termVariable "transform" ] .

logic:rtvfFormulaType
    a logic:Formula ;
    logic:relation rdf:type ;
    logic:argument
        [ logic:termIndex 0 ; logic:termVariable "transform" ] ,
        [ logic:termIndex 1 ; logic:termIri logic:Formula ] .

logic:Dialect
    a owl:Class ;
    rdfs:subClassOf logic:ConversionTarget ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Dialect"@x-gmeow-english ;
    skos:definition "A named sub-language of the canonical logic: IR, in the MLIR sense of a dialect with its own node verifiers and progressive lowering (not an LLVM-style substrate). The one F1 dialect is logic:RelationalCore, the logical-to-physical lowering waist between the full IR and the native execution engine."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:RelationalCore
    a owl:NamedIndividual ,
        logic:ConversionTarget ,
        logic:Dialect ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Relational Core"@x-gmeow-english ;
    skos:definition "The logical-to-physical lowering waist of the correspondence calculus: a first-class Datalog±-with-stratified-negation sub-language (with aggregation and existentials — the chase) between the full-FOL logic: IR and the native execution engine. Every execution strategy, the incremental layer and the semiring annotation that carries the quantitative axes target this one dialect, so a get leg compiles to a join plan and a put / chase to a semi-naive fixpoint with existentials over the same core (design/LOGIC-CORRESPONDENCE.md and design/LOGIC-IR.md, the IR-commitments section)."@x-gmeow-english .

logic:hasLens
    a owl:ObjectProperty ;
    rdfs:range logic:Lens ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "has lens"@x-gmeow-english ;
    skos:definition "Relates a logic:Correspondence to the logic:Lens that is its executable get / put core. Single-valued: each correspondence wraps exactly one lens, around which it adds the relation, axes, law claims and standpoint envelope. Range logic:Lens (domain stated in prose, matching the module's convention)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:getLeg
    a owl:ObjectProperty ;
    rdfs:domain logic:Lens ;
    rdfs:range logic:TransactionProgram ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "get leg"@x-gmeow-english ;
    skos:definition "Relates a logic:Lens to the logic:TransactionProgram that realizes its get leg — the down-projection get : S → V from the GMEOW source to the external view. Reuses the transaction layer's path semantics and logic:PathShape; no new pattern language. Domain logic:Lens, range logic:TransactionProgram."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:putLeg
    a owl:ObjectProperty ;
    rdfs:domain logic:Lens ;
    rdfs:range logic:TransactionProgram ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "put leg"@x-gmeow-english ;
    skos:definition "Relates a logic:Lens to the logic:TransactionProgram that realizes its put leg — the up-projection put : V × S → S folding a view back into the rich GMEOW source. A lawful put comes only from a logic:mnemomorphic witness or a co-authored put-with-claim; naive backward execution of the get leg is a candidate preimage, never a lawful put. Domain logic:Lens, range logic:TransactionProgram."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:sourceEndpoint
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "source endpoint"@x-gmeow-english ;
    skos:definition "Names the canonical source term or pattern related by a logic:Correspondence. This is an endpoint, not an executable logic:getLeg: a term-level correspondence can name both endpoints while carrying no transaction program. Single-valued when present and paired with exactly one logic:targetEndpoint."@x-gmeow-english ;
    skos:example "ex:bridge logic:sourceEndpoint logic:Restriction ."@x-gmeow-english ;
    skos:scopeNote "For external grounding bridges the source endpoint is always in lang:, math:, or logic:."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the rich canonical endpoint of a compiled correspondence."@x-gmeow-english ;
    gmeow:avoidWhen "Do not reverse this edge merely because an external vocabulary was encountered during ingest."@x-gmeow-english ;
    gmeow:howToUse "Attach exactly one source endpoint to the correspondence and pair it with one logic:targetEndpoint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:targetEndpoint
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "target endpoint"@x-gmeow-english ;
    skos:definition "Names the external view term or pattern related by a logic:Correspondence. This is an endpoint, not an executable logic:putLeg. Grounding correspondences use it to retain the exact gUFO, BFO, OBO, SUMO, OWL, or SHACL term in the shipped carrier without importing that target ontology."@x-gmeow-english ;
    skos:example "ex:bridge logic:targetEndpoint owl:Restriction ."@x-gmeow-english ;
    skos:scopeNote "The target endpoint identifies a view term by reference and confers no authority on its external TBox."@x-gmeow-english ;
    gmeow:useWhen "Use to name the external term or pattern produced by a grounding projection or bridge view."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use an external target as a replacement source for canonical grounding content."@x-gmeow-english ;
    gmeow:howToUse "Attach exactly one target endpoint and record any loss or commitment shift on the same correspondence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:correspondenceRelation
    a owl:ObjectProperty ;
    rdfs:range logic:CorrespondenceRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "correspondence relation"@x-gmeow-english ;
    skos:definition "Relates a logic:Correspondence to its logic:CorrespondenceRelation on the ordered lattice (equiv ⊐ subsumes / subsumedBy ⊐ overlaps ⊐ relatedMatch, disjoint the negative pole). The single authored relation from which the SSSOM predicate, EDOAL symbol and OWL-alignment strength are derived. Range logic:CorrespondenceRelation (domain stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:morphismClass
    a owl:ObjectProperty ;
    rdfs:range logic:MorphismClass ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "morphism class"@x-gmeow-english ;
    skos:definition "Relates a logic:Correspondence to its rung on the ordered law-spine (logic:MorphismClass), which caps the logic:CorrespondenceLaw values it may claim. Composition can only weaken this rung. Range logic:MorphismClass (domain stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:morphismKind
    a owl:ObjectProperty ;
    rdfs:range logic:MorphismKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "morphism kind"@x-gmeow-english ;
    skos:definition "Relates a logic:Correspondence to its logic:MorphismKind — the satisfaction-preserving / commitment-shifting split orthogonal to the rung. A logic:CommitmentShiftingBridge value makes the loss ledger refuse owl:equivalentClass. Range logic:MorphismKind (domain stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:supersededTerm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "superseded term"@x-gmeow-english ;
    skos:definition "Relates a supersession logic:Correspondence to the old term it records as superseded — the source endpoint of a greenfield migration crossing (e.g. a removed class or property the correspondence maps onto its replacement at a rung). Names the endpoint so the supersession ledger is queryable by the migrated-from term. Domain logic:Correspondence, range any term (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:supersedingTerm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "superseding term"@x-gmeow-english ;
    skos:definition "Relates a supersession logic:Correspondence to the replacement term it records as superseding the old one — the target endpoint of a greenfield migration crossing. Paired with logic:supersededTerm, it makes the correspondence's rung (logic:morphismClass) queryable per migrated term. Domain logic:Correspondence, range any term (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:hasDeterminacy
    a owl:ObjectProperty ;
    rdfs:range logic:Determinacy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "has determinacy"@x-gmeow-english ;
    skos:definition "Relates a logic:Correspondence to its logic:Determinacy — whether the target relationship is ontically logic:Crisp or logic:Vague. Kept separate from logic:confidence so a vague-but-confident alignment is not mis-recorded as a low-confidence equivalence. Range logic:Determinacy (domain stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:mnemomorphic
    a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "mnemomorphic"@x-gmeow-english ;
    skos:definition "Whether a logic:Correspondence's forward get leg retains a source witness — factoring through the graph of the correspondence so that put is obtained by projecting along the retained witness rather than synthesizing a plausible source. The bit is orthogonal to the logic:MorphismClass rung but is what lets a correspondence climb it: a retained witness is what discharges put ∘ get = id (the logic:SectionLaw), the dividing line between recoverable subsumption and reconstructed approximation. True or false (default false); a false value bars any section / retraction claim. Range xsd:boolean (domain left open, like logic:loadBearing)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:hasLawClaim
    a owl:ObjectProperty ;
    rdfs:range logic:LawClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "has law claim"@x-gmeow-english ;
    skos:definition "Relates a logic:Correspondence to a logic:LawClaim it makes — a claimed logic:CorrespondenceLaw with its discharge state. Multi-valued: a correspondence may claim several laws, each capped by its logic:MorphismClass rung. Range logic:LawClaim (domain stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:recoveryCase
    a owl:ObjectProperty ;
    rdfs:range logic:RecoveryCase ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "recovery case"@x-gmeow-english ;
    skos:definition "Relates a logic:Correspondence to one of the logic:RecoveryCase nodes whose complete source pattern is executed to decide its source-recovery claim. Multi-valued and conjunctive: every attached case must recover for a mnemomorphic Section Law to discharge; one countermodel refutes the claim. A lossy correspondence may attach a refuting case so changing only its rung or logic:mnemomorphic flag cannot manufacture a proof. Domain logic:Correspondence, range logic:RecoveryCase."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:recoveryTransform
    a owl:ObjectProperty ;
    rdfs:domain logic:RecoveryCase ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "recovery transform"@x-gmeow-english ;
    skos:definition "The exactly-one ordered source-to-view logic:Formula executed for a logic:RecoveryCase. The supported discharge fragment is a universally quantified implication whose antecedent and consequent are positive conjunctions of binary RDF atoms: the antecedent is the complete source graph pattern and the consequent is the projected view pattern. The order is semantic — reversing the implication changes which information must be recovered — while conjunction order remains immaterial under the formula's canonical identity. Domain logic:RecoveryCase, range logic:Formula."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:lawClaimed
    a owl:ObjectProperty ;
    rdfs:domain logic:LawClaim ;
    rdfs:range logic:CorrespondenceLaw ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "law claimed"@x-gmeow-english ;
    skos:definition "Relates a logic:LawClaim to the logic:CorrespondenceLaw it asserts (logic:GetPut, logic:PutGet, logic:PutPut or logic:SectionLaw). Domain logic:LawClaim, range logic:CorrespondenceLaw."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:lawDischargeVerdict
    a owl:ObjectProperty ;
    rdfs:domain logic:LawClaim ;
    rdfs:range logic:DischargeVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "law discharge verdict"@x-gmeow-english ;
    skos:definition "Relates a logic:LawClaim to the logic:DischargeVerdict its check returned — logic:ObligationDischarged, logic:ObligationUnknown or logic:ObligationViolated. Reuses the foundation's discharge-verdict value class (the law-claim analogue of logic:obligationDischargeVerdict, which is domain-locked to logic:NonEntailmentObligation): an unchecked or inconclusive law is logic:ObligationUnknown, never silently passed. Domain logic:LawClaim, range logic:DischargeVerdict."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:lawDischargeCondition
    a owl:ObjectProperty ;
    rdfs:domain logic:LawClaim ;
    rdfs:range logic:DischargeCondition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "law discharge condition"@x-gmeow-english ;
    skos:definition "Relates a logic:LawClaim to the logic:DischargeCondition under which its logic:lawDischargeVerdict is conclusively checkable (for example logic:DischargeCertifiedFragment for a law proved within a certified complete fragment). Optional: a law carrying logic:ObligationUnknown with no condition is an authored-but-unverified claim. Reuses the foundation's discharge-condition value class. Domain logic:LawClaim, range logic:DischargeCondition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── Cognitive assessment: the canonical multidimensional cognitive record ────────
# A reified, vantage-indexed, multidimensional assessment of how good some reasoning
# is or how capable a reasoner is. The single ordinal knowledge ladder of the
# cognition slice is a generated coarse view of this; the factored assessment is the
# canonical record. Normative in design/LOGIC-COGNITION.md.

logic:CognitiveAssessment
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Cognitive Assessment"@x-gmeow-english ;
    skos:definition "The canonical record of how good some reasoning is, or how capable a reasoner is: a reified, vantage-indexed node naming exactly one logic:AssessmentDimension and carrying its assessed agent (logic:assessedAgent), subject and granularity (logic:assessmentSubject with logic:subjectGranularity), task or context (logic:assessmentContext), scale and level (logic:assessmentScale with logic:assessmentLevel), evaluator and standpoint (logic:assessmentEvaluator, attributed via gmeow:accordingTo), evidence (logic:assessmentEvidence), method (logic:assessmentMethod), valid interval (carried by gmeow:duringInterval) and the strength with which the judgment itself is held (carried by logic:confidence). The dimensions vary independently, so a single ordinal familiarity-to-mastery scale collapses exactly the distinctions an assessment exists to draw; the construct keeps them factored. A self-assessment and an observer's assessment of the same agent are two coexisting records, never reconciled into one verdict, and because the node is reified an assessment is itself a subject another assessment can range over — an evaluation of the evaluator — with no new machinery. The convenient ordinal reading is the lossy coarse-ladder projection of this assessment, exactly as logic:AgencyAssessment projects the unary 'this holon is integral'; a reliability assessment is a logic:CognitiveAssessment on the reliability dimension over a series of runs, distinct from the single-run logic:ResultAssurance. Normative in design/LOGIC-COGNITION.md."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:AssessmentDimension
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Assessment Dimension"@x-gmeow-english ;
    skos:definition "The value-vocabulary class of the factored axis a logic:CognitiveAssessment judges, named via logic:assessmentDimension. An OPEN value vocabulary (individuals, never subclasses): a new dimension is a new individual rather than a reshaping of the construct, the same orthogonal-factorization discipline the foundation applies to claim modality and contextual scope. The dimensions vary independently — an assessment on one says nothing about another — and an assessment names exactly one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:SubjectGranularity
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Subject Granularity"@x-gmeow-english ;
    skos:definition "The value-vocabulary class of the grain of a logic:CognitiveAssessment's subject, named via logic:subjectGranularity: a single inference, a body of reasoning, a domain of competence, or the reasoner as a whole. An OPEN value vocabulary (individuals, never subclasses), since competence is judged at different grains and a new grain is a new individual."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:AssessmentLevel
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Assessment Level"@x-gmeow-english ;
    skos:definition "The value-vocabulary class of an ordinal level on an assessment's scale, the object of logic:assessmentLevel and logic:thresholdLevel when the scale is ordinal. An OPEN, ordered value vocabulary (logic:levelNone ≺ logic:levelEmerging ≺ logic:levelCompetent ≺ logic:levelStrong), ordered by logic:levelAtOrAbove so that 'a level at or above a threshold' is well-defined for the coarse-ladder projection without a numeric comparison (which would force a procedural profile). An assessment whose scale is continuous carries a literal logic:assessmentLevel instead; the ordinal levels are the projection scale."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:assessedAgent
    a owl:ObjectProperty ;
    rdfs:domain logic:CognitiveAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "assessed agent"@x-gmeow-english ;
    skos:definition "The agent role of a logic:CognitiveAssessment: whose cognition is judged. Range gmeow:Agent (stated in prose, matching the module's convention). A well-formedness existence guard — every projection rule re-binds it, so a malformed assessment naming no agent receives no ladder edge."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:assessmentSubject
    a owl:ObjectProperty ;
    rdfs:domain logic:CognitiveAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "assessment subject"@x-gmeow-english ;
    skos:definition "The subject role of a logic:CognitiveAssessment: what the assessment is about — a single inference, a body of reasoning, a domain of competence, or the agent as a whole. Its grain is carried by logic:subjectGranularity. Range is left open (stated in prose), since the subject may be reasoning, a domain entity, or the reasoner itself."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:subjectGranularity
    a owl:ObjectProperty ;
    rdfs:domain logic:CognitiveAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "subject granularity"@x-gmeow-english ;
    skos:definition "Relates a logic:CognitiveAssessment to the logic:SubjectGranularity individual recording the grain of its logic:assessmentSubject (inference, body-of-reasoning, domain, or agent). Range logic:SubjectGranularity (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:assessmentContext
    a owl:ObjectProperty ;
    rdfs:domain logic:CognitiveAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "assessment context"@x-gmeow-english ;
    skos:definition "The task or context a logic:CognitiveAssessment holds for, since competence is context-relative: the same agent may be competent on one task and not on another, so an assessment without a context underdetermines what it claims. Range is left open (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:assessmentDimension
    a owl:ObjectProperty ;
    rdfs:domain logic:CognitiveAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "assessment dimension"@x-gmeow-english ;
    skos:definition "The single factored axis a logic:CognitiveAssessment judges: a logic:AssessmentDimension individual. An assessment names exactly one; the dimensions vary independently. Range logic:AssessmentDimension (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:assessmentScale
    a owl:ObjectProperty ;
    rdfs:domain logic:CognitiveAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "assessment scale"@x-gmeow-english ;
    skos:definition "The named scale, ordinal or continuous, on which a logic:CognitiveAssessment's logic:assessmentLevel is read. Range is left open (stated in prose), since a scale may be the native ordinal logic:AssessmentLevel vocabulary or a foreign scale (Bloom's, SOLO, a Brier-scored continuous range)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:assessmentLevel
    a rdf:Property ;
    rdfs:domain logic:CognitiveAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "assessment level"@x-gmeow-english ;
    skos:definition "The value a logic:CognitiveAssessment takes on its logic:assessmentScale: an ordinal logic:AssessmentLevel individual when the scale is ordinal (the case the coarse-ladder projection reads), or a continuous literal otherwise (a Brier or logarithmic score on a continuous scale). Because the range spans both an individual and a literal it is a plain rdf:Property, not an owl:ObjectProperty (which could not carry the continuous literal) — the same open-range convention the module states in prose elsewhere."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:assessmentEvaluator
    a owl:ObjectProperty ;
    rdfs:domain logic:CognitiveAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "assessment evaluator"@x-gmeow-english ;
    skos:definition "Who holds the judgment of a logic:CognitiveAssessment: the standpoint is attributed via gmeow:accordingTo, so a self-assessment (evaluator = assessed agent) and an observer's assessment coexist as two records rather than collapsing into one verdict. Range gmeow:Agent (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:assessmentEvidence
    a owl:ObjectProperty ;
    rdfs:domain logic:CognitiveAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "assessment evidence"@x-gmeow-english ;
    skos:definition "The reasoning, observations, or recorded episode a logic:CognitiveAssessment rests on — the inference commitments it cites, the gmeow:ModelInvocation that produced the reasoning, the results it grades — so an assessment is auditable against the reasoning it judges rather than standing apart from it. Range is left open (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:assessmentMethod
    a owl:ObjectProperty ;
    rdfs:domain logic:CognitiveAssessment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "assessment method"@x-gmeow-english ;
    skos:definition "How the judgment of a logic:CognitiveAssessment was reached — a test, a review, a scoring rule applied to a forecast series, an introspective report. Range is left open (stated in prose), so the method may be a named procedure or a free description."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:levelAtOrAbove
    a owl:ObjectProperty ,
        owl:TransitiveProperty ;
    rdfs:domain logic:AssessmentLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "level at or above"@x-gmeow-english ;
    rdfs:range logic:AssessmentLevel ;
    skos:definition "Orders the ordinal assessment scale: relates a logic:AssessmentLevel to itself and to every level it surpasses (logic:levelStrong logic:levelAtOrAbove logic:levelCompetent). Reflexive-and-transitive on the levels, so the coarse-ladder projection can test 'the assessed level is at or above the threshold level' by a single body atom, with no numeric comparison (which would force a procedural profile). The full reflexive-transitive closure is asserted on the level individuals so the test needs no transitive computation in the rule engine."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# The eight factored dimensions of design §The factored dimensions, plus the
# separately-introduced reliability dimension of design §Result assurance and
# reasoner reliability are distinct — nine logic:AssessmentDimension individuals.

logic:dimensionAwareness
    a owl:NamedIndividual ,
        logic:AssessmentDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dimension: awareness"@x-gmeow-english ;
    skos:definition "The awareness dimension: whether the agent registers the subject at all. The shallowest factored axis; the source of the gmeow:isAwareOf rung of the coarse knowledge ladder under a declared threshold."@x-gmeow-english .

logic:dimensionDeclarativeFamiliarity
    a owl:NamedIndividual ,
        logic:AssessmentDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dimension: declarative familiarity"@x-gmeow-english ;
    skos:definition "The declarative-familiarity dimension: what the agent knows THAT — the facts it can state about the subject. The source of the gmeow:knowsAbout rung of the coarse knowledge ladder under a declared threshold."@x-gmeow-english .

logic:dimensionConceptualUnderstanding
    a owl:NamedIndividual ,
        logic:AssessmentDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dimension: conceptual understanding"@x-gmeow-english ;
    skos:definition "The conceptual-understanding dimension: whether the agent grasps WHY — the structure behind the facts, beyond reciting them. The source of the gmeow:understands rung of the coarse knowledge ladder under a declared threshold."@x-gmeow-english .

logic:dimensionProceduralCompetence
    a owl:NamedIndividual ,
        logic:AssessmentDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dimension: procedural competence"@x-gmeow-english ;
    skos:definition "The procedural-competence dimension: what the agent knows HOW to do — its working command of the subject. Read together with the transfer dimension, the source of the gmeow:hasMastered rung of the coarse knowledge ladder under a declared threshold."@x-gmeow-english .

logic:dimensionTransfer
    a owl:NamedIndividual ,
        logic:AssessmentDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dimension: transfer"@x-gmeow-english ;
    skos:definition "The transfer dimension: whether competence in one context carries to another — the axis a single ordinal ladder most conspicuously hides, since fluency in a narrow task says nothing about generalization. Read together with procedural competence, the source of the gmeow:hasMastered rung of the coarse knowledge ladder under a declared threshold."@x-gmeow-english .

logic:dimensionExplanatoryAbility
    a owl:NamedIndividual ,
        logic:AssessmentDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dimension: explanatory ability"@x-gmeow-english ;
    skos:definition "The explanatory-ability dimension: whether the agent can produce an account others can follow and check — the seam to the solver-layer gmeow:explanatoryScore and gmeow:systematicity measurements, which feed this dimension but are never asserted as reasoned axioms."@x-gmeow-english .

logic:dimensionCalibration
    a owl:NamedIndividual ,
        logic:AssessmentDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dimension: calibration"@x-gmeow-english ;
    skos:definition "The calibration dimension: whether the agent's confidence matches its accuracy. Assessed against an explicit forecast protocol (a forecast/outcome series, a scoring rule, a reference class and observation window), kept apart from a single logic:confidence value and from the metacognition vocabulary's qualitative gmeow:CalibrationStatus."@x-gmeow-english .

logic:dimensionMetacognition
    a owl:NamedIndividual ,
        logic:AssessmentDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dimension: metacognition"@x-gmeow-english ;
    skos:definition "The metacognition dimension: whether the agent models its own competence, including the limits of its own knowledge. Reads the metacognition vocabulary's second-order posture — gmeow:awareOfNotKnowing, gmeow:epistemicSelfTrust, and reflection that can defeat one's own inference — as its subject."@x-gmeow-english .

logic:dimensionReliability
    a owl:NamedIndividual ,
        logic:AssessmentDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dimension: reliability"@x-gmeow-english ;
    skos:definition "The reliability dimension: how dependably an agent or engine reasons as a disposition, relative to a reference class (a task, domain, or distribution) and read from MANY results with their expected or observed outcomes — a metric over the series (accuracy, soundness-violation rate, recall, calibration, robustness) across a stated interval. Distinct from the single-run logic:ResultAssurance: a reliable reasoner may correctly return a contradiction verdict on contradictory input, and a completed internally-supported result may still be wrong, so reliability is never read from one result's assurance. The dimension design §Result assurance and reasoner reliability are distinct introduces alongside the eight factored dimensions."@x-gmeow-english .

# Subject granularity — four grains at which competence is judged.

logic:granularityInference
    a owl:NamedIndividual ,
        logic:SubjectGranularity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "granularity: inference"@x-gmeow-english ;
    skos:definition "The finest grain of an assessment subject: a single inference — one logic:InferenceProcess or commitment being judged."@x-gmeow-english .

logic:granularityBodyOfReasoning
    a owl:NamedIndividual ,
        logic:SubjectGranularity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "granularity: body of reasoning"@x-gmeow-english ;
    skos:definition "An intermediate grain of an assessment subject: a connected body of reasoning — a derivation, a proof, an episode of inference — judged as a whole rather than one step."@x-gmeow-english .

logic:granularityDomain
    a owl:NamedIndividual ,
        logic:SubjectGranularity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "granularity: domain"@x-gmeow-english ;
    skos:definition "A broad grain of an assessment subject: a domain of competence — the agent's standing in a field rather than on any one episode."@x-gmeow-english .

logic:granularityAgent
    a owl:NamedIndividual ,
        logic:SubjectGranularity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "granularity: agent"@x-gmeow-english ;
    skos:definition "The coarsest grain of an assessment subject: the reasoner as a whole — the grain at which a reliability assessment of an agent or engine is made."@x-gmeow-english .

# The ordinal projection scale — four levels, reflexive-transitively ordered by
# logic:levelAtOrAbove so a threshold test is a single body atom.

logic:levelNone
    a owl:NamedIndividual ,
        logic:AssessmentLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "level: none"@x-gmeow-english ;
    skos:definition "The lowest ordinal assessment level: the dimension is not evidenced at all. Clears no ladder rung's threshold."@x-gmeow-english ;
    logic:levelAtOrAbove logic:levelNone .

logic:levelEmerging
    a owl:NamedIndividual ,
        logic:AssessmentLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "level: emerging"@x-gmeow-english ;
    skos:definition "The second ordinal assessment level: the dimension is weakly evidenced. Surpasses logic:levelNone on the logic:levelAtOrAbove order."@x-gmeow-english ;
    logic:levelAtOrAbove logic:levelEmerging ,
        logic:levelNone .

logic:levelCompetent
    a owl:NamedIndividual ,
        logic:AssessmentLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "level: competent"@x-gmeow-english ;
    skos:definition "The third ordinal assessment level: the dimension is solidly evidenced. Surpasses logic:levelEmerging and logic:levelNone on the logic:levelAtOrAbove order."@x-gmeow-english ;
    logic:levelAtOrAbove logic:levelCompetent ,
        logic:levelEmerging ,
        logic:levelNone .

logic:levelStrong
    a owl:NamedIndividual ,
        logic:AssessmentLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "level: strong"@x-gmeow-english ;
    skos:definition "The highest ordinal assessment level: the dimension is strongly evidenced. Surpasses every lower level on the logic:levelAtOrAbove order."@x-gmeow-english ;
    logic:levelAtOrAbove logic:levelStrong ,
        logic:levelCompetent ,
        logic:levelEmerging ,
        logic:levelNone .

# ── The coarse knowledge ladder as a generated projection ───────────────────────
# The cognition slice's gmeow:isAwareOf … gmeow:hasMastered ladder is a generated
# coarse VIEW of the multidimensional logic:CognitiveAssessment: each ladder edge
# instance is rule-materialized from assessments under a declared per-dimension
# threshold profile (logic:LadderProjectionProfile). The factored assessment stays
# the canonical record; the ladder is the readable ordinal projection. The shipped
# projection rules are positive Horn, so they materialize under the engine's default
# semantics and fold into gmeow.gts and the Datalog/N3 program projections.
# Normative in design/LOGIC-COGNITION.md §Projection to the coarse knowledge ladder.

logic:LadderProjectionProfile
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Ladder Projection Profile"@x-gmeow-english ;
    skos:definition "A declared per-dimension threshold profile governing the generated coarse projection of the multidimensional logic:CognitiveAssessment onto the gmeow:isAwareOf … gmeow:hasMastered knowledge ladder: a set of logic:DimensionThreshold rows (logic:hasThresholdRow), each binding a ladder edge to its source dimension and the minimum logic:AssessmentLevel an assessment must clear for the edge to be emitted. Making the thresholds an explicit profile keeps the ordinal chain a projection a consumer that needs one number can read, while the factored assessment stays canonical — the ladder never re-establishes mastery, understanding, knowledge and awareness as a single ordinal entailment chain in place of the independent dimensions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:DimensionThreshold
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Dimension Threshold"@x-gmeow-english ;
    skos:definition "One row of a logic:LadderProjectionProfile: a logic:projectsLadderEdge ladder property paired with the logic:sourceDimension it reads and the minimum logic:thresholdLevel an assessment on that dimension must clear (by the logic:levelAtOrAbove order) for the edge to be emitted. The gmeow:hasMastered rung is the only one with two rows — procedural competence and transfer — both of which must clear, so mastery of one narrow task no longer implies broad command of a subject."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:hasThresholdRow
    a owl:ObjectProperty ;
    rdfs:domain logic:LadderProjectionProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "has threshold row"@x-gmeow-english ;
    skos:definition "Relates a logic:LadderProjectionProfile to one of its logic:DimensionThreshold rows. Range logic:DimensionThreshold (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:projectsLadderEdge
    a owl:ObjectProperty ;
    rdfs:domain logic:DimensionThreshold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "projects ladder edge"@x-gmeow-english ;
    skos:definition "The ladder property a logic:DimensionThreshold row emits when its dimension clears its threshold: gmeow:isAwareOf, gmeow:knowsAbout, gmeow:understands or gmeow:hasMastered. Range is left open (the gmeow: ladder properties), stated in prose to keep the OWL down-projection clean."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:sourceDimension
    a owl:ObjectProperty ;
    rdfs:domain logic:DimensionThreshold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "source dimension"@x-gmeow-english ;
    skos:definition "The logic:AssessmentDimension a logic:DimensionThreshold row reads: the factored axis whose assessment level is tested against the row's logic:thresholdLevel. Range logic:AssessmentDimension (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:thresholdLevel
    a owl:ObjectProperty ;
    rdfs:domain logic:DimensionThreshold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "threshold level"@x-gmeow-english ;
    skos:definition "The minimum logic:AssessmentLevel an assessment on a row's logic:sourceDimension must reach — by the logic:levelAtOrAbove order — for the row's logic:projectsLadderEdge to be emitted. Range logic:AssessmentLevel (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# The shipped default profile: the threshold each ladder rung clears.

logic:defaultLadderProfile
    a owl:NamedIndividual ,
        logic:LadderProjectionProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "default ladder projection profile"@x-gmeow-english ;
    skos:definition "The shipped default logic:LadderProjectionProfile the coarse-ladder projection rules read: awareness ≥ emerging emits gmeow:isAwareOf, declarative familiarity ≥ competent emits gmeow:knowsAbout, conceptual understanding ≥ competent emits gmeow:understands, and procedural competence ≥ strong together with transfer ≥ strong emit gmeow:hasMastered."@x-gmeow-english ;
    logic:hasThresholdRow logic:ladderRowAwareness ,
        logic:ladderRowDeclarative ,
        logic:ladderRowConceptual ,
        logic:ladderRowProceduralMastery ,
        logic:ladderRowTransferMastery .

logic:ladderRowAwareness
    a owl:NamedIndividual ,
        logic:DimensionThreshold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "ladder row: awareness → is aware of"@x-gmeow-english ;
    skos:definition "The default-profile row emitting gmeow:isAwareOf when the awareness dimension reaches logic:levelEmerging."@x-gmeow-english ;
    logic:projectsLadderEdge gmeow:isAwareOf ;
    logic:sourceDimension logic:dimensionAwareness ;
    logic:thresholdLevel logic:levelEmerging .

logic:ladderRowDeclarative
    a owl:NamedIndividual ,
        logic:DimensionThreshold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "ladder row: declarative familiarity → knows about"@x-gmeow-english ;
    skos:definition "The default-profile row emitting gmeow:knowsAbout when the declarative-familiarity dimension reaches logic:levelCompetent."@x-gmeow-english ;
    logic:projectsLadderEdge gmeow:knowsAbout ;
    logic:sourceDimension logic:dimensionDeclarativeFamiliarity ;
    logic:thresholdLevel logic:levelCompetent .

logic:ladderRowConceptual
    a owl:NamedIndividual ,
        logic:DimensionThreshold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "ladder row: conceptual understanding → understands"@x-gmeow-english ;
    skos:definition "The default-profile row emitting gmeow:understands when the conceptual-understanding dimension reaches logic:levelCompetent."@x-gmeow-english ;
    logic:projectsLadderEdge gmeow:understands ;
    logic:sourceDimension logic:dimensionConceptualUnderstanding ;
    logic:thresholdLevel logic:levelCompetent .

logic:ladderRowProceduralMastery
    a owl:NamedIndividual ,
        logic:DimensionThreshold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "ladder row: procedural competence → has mastered"@x-gmeow-english ;
    skos:definition "The procedural half of the default-profile gmeow:hasMastered rung: procedural competence must reach logic:levelStrong. Read together with logic:ladderRowTransferMastery — both must clear for gmeow:hasMastered."@x-gmeow-english ;
    logic:projectsLadderEdge gmeow:hasMastered ;
    logic:sourceDimension logic:dimensionProceduralCompetence ;
    logic:thresholdLevel logic:levelStrong .

logic:ladderRowTransferMastery
    a owl:NamedIndividual ,
        logic:DimensionThreshold ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "ladder row: transfer → has mastered"@x-gmeow-english ;
    skos:definition "The transfer half of the default-profile gmeow:hasMastered rung: transfer must reach logic:levelStrong. Read together with logic:ladderRowProceduralMastery — both must clear for gmeow:hasMastered, so mastery of one narrow task never implies broad command."@x-gmeow-english ;
    logic:projectsLadderEdge gmeow:hasMastered ;
    logic:sourceDimension logic:dimensionTransfer ;
    logic:thresholdLevel logic:levelStrong .

# The four projection rules. The three single-dimension rungs read their dimension
# and threshold from the profile row; the gmeow:hasMastered rung conjoins the two
# rows (procedural AND transfer), so both halves must clear.

logic:ruleProjectIsAwareOf
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "project ladder edge: is aware of"@x-gmeow-english ;
    skos:definition "Emits gmeow:isAwareOf from an assessment whose dimension and level clear the gmeow:isAwareOf row of a logic:LadderProjectionProfile. Positive Horn; the threshold is read from the profile, not hard-coded."@x-gmeow-english ;
    logic:provenance logic:ruleProjectIsAwareOf ;
    logic:head [
        rdf:subject   "?agent" ;
        rdf:predicate gmeow:isAwareOf ;
        rdf:object    "?subject"
    ] ;
    logic:body [
        rdf:subject   "?profile" ;
        rdf:predicate logic:hasThresholdRow ;
        rdf:object    "?row"
    ] , [
        rdf:subject   "?row" ;
        rdf:predicate logic:projectsLadderEdge ;
        rdf:object    gmeow:isAwareOf
    ] , [
        rdf:subject   "?row" ;
        rdf:predicate logic:sourceDimension ;
        rdf:object    "?dim"
    ] , [
        rdf:subject   "?row" ;
        rdf:predicate logic:thresholdLevel ;
        rdf:object    "?threshold"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessmentDimension ;
        rdf:object    "?dim"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessedAgent ;
        rdf:object    "?agent"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessmentSubject ;
        rdf:object    "?subject"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessmentLevel ;
        rdf:object    "?level"
    ] , [
        rdf:subject   "?level" ;
        rdf:predicate logic:levelAtOrAbove ;
        rdf:object    "?threshold"
    ] .

logic:ruleProjectKnowsAbout
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "project ladder edge: knows about"@x-gmeow-english ;
    skos:definition "Emits gmeow:knowsAbout from an assessment whose dimension and level clear the gmeow:knowsAbout row of a logic:LadderProjectionProfile. Positive Horn; the threshold is read from the profile. The canonical source of a gmeow:knowsAbout edge — never gmeow:hasSkill."@x-gmeow-english ;
    logic:provenance logic:ruleProjectKnowsAbout ;
    logic:head [
        rdf:subject   "?agent" ;
        rdf:predicate gmeow:knowsAbout ;
        rdf:object    "?subject"
    ] ;
    logic:body [
        rdf:subject   "?profile" ;
        rdf:predicate logic:hasThresholdRow ;
        rdf:object    "?row"
    ] , [
        rdf:subject   "?row" ;
        rdf:predicate logic:projectsLadderEdge ;
        rdf:object    gmeow:knowsAbout
    ] , [
        rdf:subject   "?row" ;
        rdf:predicate logic:sourceDimension ;
        rdf:object    "?dim"
    ] , [
        rdf:subject   "?row" ;
        rdf:predicate logic:thresholdLevel ;
        rdf:object    "?threshold"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessmentDimension ;
        rdf:object    "?dim"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessedAgent ;
        rdf:object    "?agent"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessmentSubject ;
        rdf:object    "?subject"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessmentLevel ;
        rdf:object    "?level"
    ] , [
        rdf:subject   "?level" ;
        rdf:predicate logic:levelAtOrAbove ;
        rdf:object    "?threshold"
    ] .

logic:ruleProjectUnderstands
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "project ladder edge: understands"@x-gmeow-english ;
    skos:definition "Emits gmeow:understands from an assessment whose dimension and level clear the gmeow:understands row of a logic:LadderProjectionProfile. Positive Horn; the threshold is read from the profile."@x-gmeow-english ;
    logic:provenance logic:ruleProjectUnderstands ;
    logic:head [
        rdf:subject   "?agent" ;
        rdf:predicate gmeow:understands ;
        rdf:object    "?subject"
    ] ;
    logic:body [
        rdf:subject   "?profile" ;
        rdf:predicate logic:hasThresholdRow ;
        rdf:object    "?row"
    ] , [
        rdf:subject   "?row" ;
        rdf:predicate logic:projectsLadderEdge ;
        rdf:object    gmeow:understands
    ] , [
        rdf:subject   "?row" ;
        rdf:predicate logic:sourceDimension ;
        rdf:object    "?dim"
    ] , [
        rdf:subject   "?row" ;
        rdf:predicate logic:thresholdLevel ;
        rdf:object    "?threshold"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessmentDimension ;
        rdf:object    "?dim"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessedAgent ;
        rdf:object    "?agent"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessmentSubject ;
        rdf:object    "?subject"
    ] , [
        rdf:subject   "?assessment" ;
        rdf:predicate logic:assessmentLevel ;
        rdf:object    "?level"
    ] , [
        rdf:subject   "?level" ;
        rdf:predicate logic:levelAtOrAbove ;
        rdf:object    "?threshold"
    ] .

logic:ruleProjectHasMastered
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "project ladder edge: has mastered"@x-gmeow-english ;
    skos:definition "Emits gmeow:hasMastered only when BOTH a procedural-competence assessment and a transfer assessment of the same agent on the same subject clear their gmeow:hasMastered rows, where both rows belong to the SAME logic:LadderProjectionProfile. The two-row conjunction is why mastery of one narrow task no longer implies broad command — transfer must clear too — and the shared-profile join is why a procedural threshold from one profile can never be mixed with a transfer threshold from another. Positive Horn; thresholds read from the profile."@x-gmeow-english ;
    logic:provenance logic:ruleProjectHasMastered ;
    logic:head [
        rdf:subject   "?agent" ;
        rdf:predicate gmeow:hasMastered ;
        rdf:object    "?subject"
    ] ;
    logic:body [
        rdf:subject   "?profile" ;
        rdf:predicate logic:hasThresholdRow ;
        rdf:object    "?rowProc"
    ] , [
        rdf:subject   "?profile" ;
        rdf:predicate logic:hasThresholdRow ;
        rdf:object    "?rowTransfer"
    ] , [
        rdf:subject   "?rowProc" ;
        rdf:predicate logic:projectsLadderEdge ;
        rdf:object    gmeow:hasMastered
    ] , [
        rdf:subject   "?rowProc" ;
        rdf:predicate logic:sourceDimension ;
        rdf:object    logic:dimensionProceduralCompetence
    ] , [
        rdf:subject   "?rowProc" ;
        rdf:predicate logic:thresholdLevel ;
        rdf:object    "?thresholdProc"
    ] , [
        rdf:subject   "?assessProc" ;
        rdf:predicate logic:assessmentDimension ;
        rdf:object    logic:dimensionProceduralCompetence
    ] , [
        rdf:subject   "?assessProc" ;
        rdf:predicate logic:assessedAgent ;
        rdf:object    "?agent"
    ] , [
        rdf:subject   "?assessProc" ;
        rdf:predicate logic:assessmentSubject ;
        rdf:object    "?subject"
    ] , [
        rdf:subject   "?assessProc" ;
        rdf:predicate logic:assessmentLevel ;
        rdf:object    "?levelProc"
    ] , [
        rdf:subject   "?levelProc" ;
        rdf:predicate logic:levelAtOrAbove ;
        rdf:object    "?thresholdProc"
    ] , [
        rdf:subject   "?rowTransfer" ;
        rdf:predicate logic:projectsLadderEdge ;
        rdf:object    gmeow:hasMastered
    ] , [
        rdf:subject   "?rowTransfer" ;
        rdf:predicate logic:sourceDimension ;
        rdf:object    logic:dimensionTransfer
    ] , [
        rdf:subject   "?rowTransfer" ;
        rdf:predicate logic:thresholdLevel ;
        rdf:object    "?thresholdTransfer"
    ] , [
        rdf:subject   "?assessTransfer" ;
        rdf:predicate logic:assessmentDimension ;
        rdf:object    logic:dimensionTransfer
    ] , [
        rdf:subject   "?assessTransfer" ;
        rdf:predicate logic:assessedAgent ;
        rdf:object    "?agent"
    ] , [
        rdf:subject   "?assessTransfer" ;
        rdf:predicate logic:assessmentSubject ;
        rdf:object    "?subject"
    ] , [
        rdf:subject   "?assessTransfer" ;
        rdf:predicate logic:assessmentLevel ;
        rdf:object    "?levelTransfer"
    ] , [
        rdf:subject   "?levelTransfer" ;
        rdf:predicate logic:levelAtOrAbove ;
        rdf:object    "?thresholdTransfer"
    ] .

# ── Defeasible evidence: support that can come apart ────────────────────────────
# A first-class, reified declaration that one relation is DEFEASIBLE (defeater-
# blockable) evidence for another, never a strict entailment. The recast of
# expertise's gmeow:hasSkill → gmeow:knowsAbout: possessing a skill (tacit can-do)
# is defeasible evidence for knowing-about (descriptive, fact-level familiarity),
# the two coming apart (tacit competence with no articulable knowledge, and vice
# versa). Because the
# support is defeasible, the shipped reasoning NEVER materializes the supported
# edge from the evidence: gmeow:knowsAbout's only shipped source is the
# declarative-familiarity ladder projection, never gmeow:hasSkill. A consumer that
# opts into defeasible reasoning can draw the supported edge under a declared
# contract (demonstrated in the conformance corpus), defeated when the competence
# is purely tacit.
#
# NON-ENTAILMENT GUARD: the predicate-global logic:NonEntailmentObligation
# machinery cannot express "knowsAbout must not come FROM hasSkill", because
# gmeow:knowsAbout IS a legitimate rule head (the declarative-familiarity ladder
# projection) — a predicate-global obligation on it would resolve to
# logic:ObligationViolated, a hard error. The precise, strictly-stronger guard is
# the source-specific verification query that no gmeow:knowsAbout edge is derived
# whose only support is gmeow:hasSkill, enforced under make verify.

logic:DefeasibleEvidence
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Defeasible Evidence"@x-gmeow-english ;
    skos:definition "A reified declaration that one relation or fact (logic:evidenceProperty) is DEFEASIBLE — defeater-blockable — evidence for another (logic:evidenceFor), carrying its logic:defeasibleStrength, and explicitly NOT a strict entailment. The support can come apart: the evidence may hold while the supported claim fails (and conversely), so the engine never materializes the supported edge from the evidence under the default reasoning — only a consumer opting into defeasible reasoning under a declared contract draws it, defeated when a declared defeater holds. The central recast of any 'X is evidence for Y, not X entails Y' relationship; its first instance is gmeow:hasSkill as defeasible evidence for gmeow:knowsAbout."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:evidenceProperty
    a owl:ObjectProperty ;
    rdfs:domain logic:DefeasibleEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "evidence property"@x-gmeow-english ;
    skos:definition "The evidential relation a logic:DefeasibleEvidence declares to bear defeasibly on another — the 'from' side (e.g. gmeow:hasSkill). Range is left open (a property or a claim), stated in prose; the object is used by punning, the gmeow:pairsWith convention."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:evidenceFor
    a owl:ObjectProperty ;
    rdfs:domain logic:DefeasibleEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "evidence for"@x-gmeow-english ;
    skos:definition "The relation or claim a logic:DefeasibleEvidence defeasibly supports — the 'to' side (e.g. gmeow:knowsAbout). Defeasible support, never strict entailment: the supported edge is not materialized from the evidence under the default reasoning. Range is left open (a property or a claim), stated in prose."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:defeasibleStrength
    a owl:DatatypeProperty ;
    rdfs:domain logic:DefeasibleEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "defeasible strength"@x-gmeow-english ;
    skos:definition "A solver-layer measure of how strongly a logic:DefeasibleEvidence supports its logic:evidenceFor target before any defeater — a ranking annotation, never asserted as a reasoned axiom and never a probability. Range is left open (an ordinal label or a numeric weight), stated in prose."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:skillEvidenceForKnowsAbout
    a owl:NamedIndividual ,
        logic:DefeasibleEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "skill is defeasible evidence for knowing about"@x-gmeow-english ;
    skos:definition "The shipped declaration recasting expertise's former gmeow:hasSkill ⊑ gmeow:knowsAbout: possessing a skill in a subject is DEFEASIBLE evidence that the agent knows about it, not a strict subproperty entailment — tacit competence and descriptive, fact-level knowing-about come apart. The supported gmeow:knowsAbout edge is never materialized from gmeow:hasSkill under the default reasoning (its only shipped source is the declarative-familiarity ladder projection); a consumer opting into defeasible reasoning draws it, defeated when the competence is purely tacit."@x-gmeow-english ;
    logic:evidenceProperty gmeow:hasSkill ;
    logic:evidenceFor gmeow:knowsAbout ;
    logic:defeasibleStrength "moderate" .

# === Transaction layer: serial composition, concurrency, and anomalies =======
# The serial-conjunction combinator (a program operator typed APART from logical
# conjunction), the three separately-declared concurrency concerns kept apart
# (history criterion vs guarantee strength vs implementation mechanism), and the
# history-level serialization anomaly that is a finding, never a contradiction
# witness. Normative in design/LOGIC-TRANSACTION.md, §Concurrent transactions.

# --- Serial composition operator ---------------------------------------------

logic:SerialConjunction
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Serial Conjunction"@x-gmeow-english ;
    skos:definition "The serial-conjunction program combinator (⊗, 'do φ then ψ'): the path along which the program executes splits so that φ holds over a prefix and ψ holds over the remaining suffix. It is a PROGRAM combinator over the transaction layer's path semantics, typed APART from ordinary (at-a-state) logical conjunction — a program operator is never conflated with the logical connective that holds at a single state, matching the formula-versus-program operator typing of the IR. Its two operands are carried by logic:leftOperand (the prefix program) and logic:rightOperand (the suffix program). The base relations of the layer are elementary state transitions, this serial conjunction, and executional entailment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:leftOperand
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "left operand"@x-gmeow-english ;
    skos:definition "Relates a binary transaction-program combinator (for example a logic:SerialConjunction) to its left/prefix operand — the program that holds over the prefix of the executing path. Range a transaction-program node (stated in prose). Paired with logic:rightOperand."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:rightOperand
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "right operand"@x-gmeow-english ;
    skos:definition "Relates a binary transaction-program combinator (for example a logic:SerialConjunction) to its right/suffix operand — the program that holds over the suffix of the executing path. Range a transaction-program node (stated in prose). Paired with logic:leftOperand."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Branching, concurrent, iterative, and fallback combinators ---------------
# The four missing program combinators that complete the transaction layer's
# operator set as named in logic:Plan's definition and LOGIC-TELEOLOGY.md.
# Each is typed APART from the corresponding logical connective — a program
# operator is never confused with a formula connective — and mirrors
# logic:SerialConjunction exactly in structure and annotation style.
# Normative in design/LOGIC-TRANSACTION.md and design/LOGIC-TELEOLOGY.md.

logic:Choice
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Choice"@x-gmeow-english ;
    skos:definition "The guarded-choice program combinator: selects one of two sub-programs based on whether a guard situation holds at the current state. The left operand (logic:leftOperand) is executed when the guard holds; the right operand (logic:rightOperand) is executed when it does not. The guard is declared through logic:guardSituation, reusing the same property the conditional goal expression reads — a choice combinator is a PROGRAM operator that dispatches on a guard, typed APART from a conditional formula connective that holds at a single state. The two operands are binary, carried by logic:leftOperand and logic:rightOperand (the same properties logic:SerialConjunction uses). A plan whose branches are conditioned on what an earlier observation revealed is a POLICY — a reading of a plan, not a separate class — and its branches are resolved through logic:planBranch, logic:branchGuard, and logic:nextActionSchema; logic:Choice is the structural combinator that expresses the branching operator in the program body. Distinct from goal-level logic:DisjunctiveGoal, which evaluates a truth-at-a-state condition over sub-expressions, not a program that dispatches control to one of two sub-programs."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:ConcurrentComposition
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Concurrent Composition"@x-gmeow-english ;
    skos:definition "The concurrent-composition program combinator: two sub-programs advance together with their elementary steps interleaved over a shared path. The left sub-program is carried by logic:leftOperand and the right by logic:rightOperand. This is the COMPOSITION OPERATOR that states two programs run concurrently — it is DISTINCT from the three separately-declared concurrency correctness concerns the transaction layer keeps apart: (a) logic:SerializabilityCriterion is a correctness PROPERTY OF A HISTORY (conflict-serializability or view-serializability), (b) logic:IsolationLevel is the declared GUARANTEE STRENGTH a schedule must meet, and (c) logic:ConcurrencyControlProtocol is the IMPLEMENTATION MECHANISM enforcing that strength. ConcurrentComposition names the structural operator; whether the resulting history is serializable, what isolation is declared, and which protocol enforces it are separately-declared facets. A logic:ConcurrentHistory carries the conflict edges whose cycle structure logic:SerializationAnomaly detects; logic:ConcurrentComposition names the program that gives rise to such a history. Typed APART from ordinary (at-a-state) conjunction — concurrent programs advance over a shared path segment, while a conjunctive formula holds at a single state."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Iteration
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Iteration"@x-gmeow-english ;
    skos:definition "The iteration program combinator: repeats a body sub-program while a loop condition holds. The body is carried by logic:iterationBody and the loop condition by logic:iterationCondition. Binary left/right operand semantics do not fit iteration — a loop has a body and a separate condition, not two co-equal operands — so logic:iterationBody and logic:iterationCondition are minted as dedicated properties rather than repurposing logic:leftOperand / logic:rightOperand. A logic:Iteration is the program-level counterpart of the loop/retry structure logic:StrongCyclicPlanSuccess quantifies over: a strong-cyclic plan succeeds when every fair execution of a loop through recoverable failures terminates at the goal in finitely many steps. The loop condition is a situation type checked before each body execution; when it does not hold the iteration terminates. Typed APART from recursive goal structures and from plain goal decomposition, which carry satisfaction dependency rather than control flow."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:iterationBody
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "iteration body"@x-gmeow-english ;
    skos:definition "Relates a logic:Iteration combinator to the sub-program that constitutes its loop body — the program executed on each iteration pass. Domain logic:Iteration, range a transaction-program node (stated in prose). Paired with logic:iterationCondition, which carries the guard situation checked before each pass. Distinct from logic:leftOperand / logic:rightOperand (binary co-equal operands of serial, choice, concurrent, and fallback combinators): a loop body is not co-equal with a loop condition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:iterationCondition
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "iteration condition"@x-gmeow-english ;
    skos:definition "Relates a logic:Iteration combinator to the situation type that gates each pass of the loop body — the loop is executed while this situation obtains at the current state; when it does not hold the iteration terminates. Domain logic:Iteration, range logic:Situation (stated in prose). Paired with logic:iterationBody. Reuses the situation-type pattern of logic:guardSituation and logic:boundSituationType: the engine reads this against the current path state via logic:situationObtains."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:Fallback
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Fallback"@x-gmeow-english ;
    skos:definition "The fallback program combinator: attempts the primary sub-program (logic:leftOperand); if it fails (the primary executional entailment does not hold from the current state), executes the alternate sub-program (logic:rightOperand). It is a PROGRAM combinator over the transaction layer path semantics, typed APART from action-level logic:compensation: a compensation undoes the EFFECT of an action that ran and reached an outcome, recovering from a realized nondeterministic outcome branch, while logic:Fallback is a STRUCTURAL OPERATOR that routes control to an alternate path when the primary program cannot succeed from the current state. The two sub-programs are binary, carried by logic:leftOperand (the primary) and logic:rightOperand (the alternate), reusing the same properties logic:SerialConjunction and logic:Choice use. A plan strong-cyclic success through recoverable failures is the quantification-level counterpart: logic:Fallback is the operator that makes recovery structurally expressible in the program body."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Plan-to-path link (closing the four-link chain) -------------------------
# The chain intention -> plan -> action -> transaction-path is otherwise
# expressible through existing terms: gmeow:Intention carries its goal via
# gmeow:intentionGoal and motivates the action occurrence via gmeow:motivates;
# logic:Plan carries the same goal via logic:planGoal; the action occurrence
# (a gmeow:Event) links to its reusable type via logic:instantiatesSchema. The
# one genuine gap is relating a Plan to the specific Path along which it ran,
# which logic:executedAlongPath closes. It CONNECTS the plan and the path; it
# does NOT subsume either — a plan is the program, a path is the executed run.

logic:executedAlongPath
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "executed along path"@x-gmeow-english ;
    skos:definition "Relates a program run — a logic:Plan or a logic:TransactionOutcome — to the logic:Path along which it executed: the executed history that realizes the program. Domain logic:Plan or logic:TransactionOutcome, range logic:Path (stated in prose). This is the one link the four-notion chain intention -> plan -> action -> transaction-path did not already have: intention reaches its goal and action through gmeow:intentionGoal / gmeow:motivates, a logic:Plan reaches the same goal through logic:planGoal, and an action occurrence reaches its type through logic:instantiatesSchema, but no existing term tied a program to the run that executed it. It CONNECTS the program to its path but does NOT subsume either: a plan is the program (what is intended to be done), a path is the executed run (how state actually changed); the link records that this program ran along that history without conflating the two."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Canonical process model: the DAG-workflow profile + flow edges ----------
# The decidable, schedulable SHADOW of the canonical process model. A "DAG
# workflow" is NOT a kind of process but a statically-certified ACYCLIC fragment
# of logic:Plan, expressed as a Resource-facet value (logic:DagWorkflowResource)
# requested by a named contract (logic:DagWorkflowContract) — never a standalone
# class (design/LOGIC-CONTRACT.md, "Why a contract, not a profile"). The genuinely
# missing canonical edge is DATAFLOW: logic:dataflowConsumes is the binary
# dependency a DAG executor schedules over; logic:ControlFlowEdge /
# logic:DataFlowEdge are its reified FLOW-GRAPH form (the graph the acyclicity
# certifier runs Tarjan SCC over), complementary to — not a duplicate of — the
# structured-program combinators (logic:Choice, logic:Iteration,
# logic:ConcurrentComposition, logic:Fallback), which are the program-TREE form an
# interpreter walks. The DAG fragment excludes the loop combinator logic:Iteration
# (the program-level counterpart of logic:StrongCyclicPlanSuccess); a cyclic plan
# stays valid canonically but resolves to `unsupported` under the DAG profile,
# the offending edge disclosed by logic:dagCycleWitness — never silently truncated.

logic:dataflowConsumes
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dataflow consumes"@x-gmeow-english ;
    skos:definition "Relates a process node — a logic:Plan step, a pipeline stage, or a procedure step — to an upstream node whose product it reads: the canonical binary dataflow dependency, oriented consumer -> producer (an executor inverts it to schedule producers first). The transitive closure must be acyclic for the DAG-workflow profile (logic:DagWorkflowResource); a cycle takes the plan out of the certified acyclic fragment and is disclosed through logic:dagCycleWitness, never silently dropped. Domain and range a process node (stated in prose, matching the module's convention). The reified FLOW-GRAPH counterpart is logic:DataFlowEdge; downstream surfaces such as gmeow:dataflowConsumes specialize this property."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:dataflowProduces
    a owl:ObjectProperty ;
    owl:inverseOf logic:dataflowConsumes ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "dataflow produces"@x-gmeow-english ;
    skos:definition "The inverse of logic:dataflowConsumes: relates a process node to a downstream node that reads its product (producer -> consumer). The canonical authored direction is logic:dataflowConsumes, so this inverse is normally left to be inferred rather than asserted. Domain and range a process node (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:ControlFlowEdge
    a owl:Class ;
    rdfs:subClassOf logic:Relator ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Control-Flow Edge"@x-gmeow-english ;
    logic:mediates logic:flowFrom ,
        logic:flowTo ;
    skos:definition "A reified control-flow edge between two process nodes — the canonical FLOW-GRAPH form of control flow, mediating a source node (logic:flowFrom) and a target node (logic:flowTo). Complementary to, NOT a duplicate of, the structured-program combinators (logic:Choice, logic:Iteration, logic:ConcurrentComposition, logic:Fallback): the combinators are the program-TREE form an interpreter walks, while a logic:ControlFlowEdge is the binary-edge form the DAG-workflow acyclicity certifier runs Tarjan SCC over. A graph carrying a logic:Iteration loop edge (or any back-edge) is outside the DAG fragment. Downstream reified control-flow relators such as gmeow:ControlFlow specialize this class. A Relator mediating two distinct relata (its flowFrom and flowTo nodes), satisfying the relator-mediation discipline."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:DataFlowEdge
    a owl:Class ;
    rdfs:subClassOf logic:Relator ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Data-Flow Edge"@x-gmeow-english ;
    logic:mediates logic:flowFrom ,
        logic:flowTo ;
    skos:definition "A reified dataflow edge between two process nodes — the FLOW-GRAPH counterpart of the logic:dataflowConsumes property, mediating a source (producer) node via logic:flowFrom and a target (consumer) node via logic:flowTo. Use the property form (logic:dataflowConsumes) for a bare binary dependency and this reified form when an edge must carry its own attributes (the flowing entity, a guard, an order). Downstream reified dataflow relators such as gmeow:DataFlow specialize this class. A Relator mediating two distinct relata, satisfying the relator-mediation discipline."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:flowFrom
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "flow from"@x-gmeow-english ;
    skos:definition "Relates a reified flow edge (logic:ControlFlowEdge or logic:DataFlowEdge) to its source process node — the predecessor in a control-flow edge, the producer in a dataflow edge. Domain a flow edge, range a process node (stated in prose). Paired with logic:flowTo; the two mediation legs that make a flow edge a well-formed Relator."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:flowTo
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "flow to"@x-gmeow-english ;
    skos:definition "Relates a reified flow edge (logic:ControlFlowEdge or logic:DataFlowEdge) to its target process node — the successor in a control-flow edge, the consumer in a dataflow edge. Domain a flow edge, range a process node (stated in prose). Paired with logic:flowFrom."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:DagWorkflowResource
    a owl:NamedIndividual ,
        logic:ResourcePolicy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "DAG-Workflow Resource"@x-gmeow-english ;
    skos:definition "The resource execution policy of the DAG-workflow profile: it requires the plan's control/dataflow graph to be a loop-free (acyclic) DAG — no logic:Iteration and an acyclic logic:dataflowConsumes / flow-edge closure — so the schedule is a topological order with a hard termination guarantee, and the result reports logic:CompleteForFragment. Acyclicity is the universal structural guarantee certified here; a typed terminal discipline such as the build pipeline's single gmeow:kindSink is an additional per-surface constraint, not part of this graph-level certification. A specialization of the certified-fragment discipline of logic:CertifiedFragmentResource applied to process control flow rather than rule recursion; because resource is an execution policy holding independent properties together, a contract may carry both a DAG-workflow requirement and a budget at once. A plan outside the acyclic fragment is still valid canonically but resolves to `unsupported` under this policy, the offending edge disclosed by logic:dagCycleWitness — never silently truncated."@x-gmeow-english .

logic:DagWorkflowContract
    a owl:NamedIndividual ,
        logic:ReasoningContract ;
    logic:resourcePolicy logic:DagWorkflowResource ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "DAG-Workflow Contract"@x-gmeow-english ;
    skos:definition "The named ReasoningContract that requests the DAG-workflow resource policy (logic:resourcePolicy logic:DagWorkflowResource), under which a loop-free logic:Plan is topologically schedulable and complete-for-fragment. It is a CONTRACT (a standing request on the Resource facet), NOT a logic:ReasoningPreset: a preset bundles a model-semantics selection, whereas this fixes only the execution-discipline (Resource) facet — the contract-not-profile doctrine, applied so the resource discipline is a facet a contract requests, not a semantic profile. The dogfooded build pipeline runs logic:executedUnderContract this contract; a cyclic plan resolves to `unsupported` with its offending edge named rather than being approximated to a nearby supported semantics."@x-gmeow-english .

logic:dagCycleWitness
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "DAG cycle witness"@x-gmeow-english ;
    skos:definition "Relates an `unsupported` DAG-workflow verdict to a disclosed offending edge or cycle member — the back-edge or logic:Iteration that places a plan outside the certified acyclic fragment — MULTI-valued (a graph may carry several cycles). Mirrors the witness-disclosure discipline of logic:forbiddenViolationWitness: the certifier never silently truncates a cyclic plan, it surfaces exactly which edges break acyclicity while the plan stays valid under a non-DAG contract. Domain a reasoning result or coherence outcome carrying the `unsupported` evaluation status, range a flow edge or process node (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# The well-founded materializer's intra-engine phase plan — dogfooded as data. #
#                                                                             #
# This logic:Plan is the AUTHORED MODEL of the phase sequence the native       #
# well-founded-semantics evaluator runs per world in                          #
# crates/logic/src/wellfounded.rs (materialize()). It is the canonical-process #
# model applied ONE SCALE DOWN from the build pipeline (gmeow:pipeline-build): #
# where the pipeline is the inter-stage DAG, this plan is the intra-engine     #
# pass sequence of a single reasoning step. BOUNDARY (Principle 12,            #
# non-negotiable): this is authored SOURCE the parity test                     #
# crates/pipeline/tests/wellfounded_plan_parity.rs checks the Rust runtime     #
# against (gmeow_logic::WELL_FOUNDED_PHASES) — the reasoner NEVER parses this   #
# RDF at scheduling or runtime; the native loop is the runtime, the plan is    #
# its declared twin.                                                           #
#                                                                             #
# materialize() runs exactly three phases per world:                          #
#   1. wfMaterializeEdb   — seed the per-world EDB (world_edb_facts +          #
#                           echo_asserted + seed FactStore).                   #
#   2. wfResolveFixpoint  — the alternating fixpoint (van Gelder): the ITERATED #
#                           phase — loop { U = lmr(K); K2 = lmr(U); break when  #
#                           K2.key_set() == K.key_set() }. Modelled as a        #
#                           logic:Iteration whose logic:iterationCondition is   #
#                           the situation "the double-reduct fixpoint is not    #
#                           yet reached" (K2 != K).                             #
#   3. wfConstructModel   — final reduct against the well-founded model W,      #
#                           hard-fail on a partial model, emit derived rows.    #
#                                                                             #
# The phase order is the SerialConjunction (materialize ; (resolve ;          #
# construct)), reachable from the plan through logic:planBody. Because the     #
# middle phase is a logic:Iteration (a loop), this plan is OUTSIDE the         #
# certified acyclic DAG fragment BY CONSTRUCTION — that is correct and         #
# expected, so (unlike gmeow:pipeline-build) it does NOT run                    #
# logic:executedUnderContract logic:DagWorkflowContract.                       #
# =========================================================================== #

# Shared action-theory facets the three phase ActionSchemas carry to satisfy
# logic:ActionSchemaShape (logic:precondition + logic:capability are REQUIRED).
logic:wfWorldSeeded
    a logic:Situation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded world seeded"@x-gmeow-english ;
    skos:definition "The situation gate the well-founded materializer's phase action schemas ground on: the per-world store is selected and its asserted EDB facts are reachable (the sorted worlds list of crates/logic/src/wellfounded.rs materialize()). The shared logic:precondition of the three intra-engine phase schemas — the elementary phase transition applies only once a world is in scope."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

logic:wfReductEngineCapability
    a logic:EngineCapability ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded reduct-engine capability"@x-gmeow-english ;
    skos:definition "The executional precondition on the actor the well-founded materializer's phase action schemas carry as their logic:capability: the least-model-of-reduct engine (crate::rule_ir::least_model_of_reduct) is available to evaluate a reduct against a reference fact set. The generic ability the native engine must hold to run any of the three phases — distinct from logic:wfWorldSeeded, which is a precondition on the world state, not on the engine."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# The loop condition of the alternating-fixpoint phase: the double-reduct
# fixpoint is NOT YET reached (K2.key_set() != K.key_set()). The logic:Iteration
# runs its body while this situation obtains; when it ceases (K2 == K) the loop
# terminates and W = K is the well-founded model.
logic:wfFixpointNotReached
    a logic:Situation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded fixpoint not reached"@x-gmeow-english ;
    skos:definition "The loop-guard situation of the alternating-fixpoint phase: the double-reduct step has not yet converged — the new under-estimate K2 differs from the previous K by fact-key set (K2.key_set() != K.key_set() in crates/logic/src/wellfounded.rs). The logic:iterationCondition of logic:wfResolveLoop: the loop body re-runs while this obtains, and the iteration terminates when it ceases (K2 == K), at which point W = K is the well-founded model's set of true atoms."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# Phase 1 — seed the per-world EDB.
logic:wfMaterializeEdb
    a logic:ActionSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded materialize EDB"@x-gmeow-english ;
    skos:definition "Phase 1 of the well-founded materializer (crates/logic/src/wellfounded.rs materialize()): seed the per-world EDB — collect world_edb_facts, echo the asserted rows, and load them (sorted-key order) into the seed FactStore that the alternating fixpoint starts from. The first elementary phase transition of the intra-engine plan; its successor is the alternating-fixpoint resolution."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition logic:wfWorldSeeded ;
    logic:capability logic:wfReductEngineCapability .

# Phase 2 — the alternating fixpoint (the ITERATED phase).
logic:wfResolveFixpoint
    a logic:ActionSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded resolve fixpoint"@x-gmeow-english ;
    skos:definition "Phase 2 of the well-founded materializer (crates/logic/src/wellfounded.rs materialize()): the alternating fixpoint of van Gelder — the double-reduct step U = least_model_of_reduct(reference = K) then K2 = least_model_of_reduct(reference = U), repeated until K2 and K have the same fact-key set. The body of the logic:Iteration logic:wfResolveLoop; the loop runs while logic:wfFixpointNotReached obtains and converges on W = K, the well-founded model's set of true atoms. The single ITERATED phase of the plan — why the plan is outside the acyclic DAG fragment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition logic:wfWorldSeeded ;
    logic:capability logic:wfReductEngineCapability .

# Phase 3 — final reduct + emit.
logic:wfConstructModel
    a logic:ActionSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded construct model"@x-gmeow-english ;
    skos:definition "Phase 3 of the well-founded materializer (crates/logic/src/wellfounded.rs materialize()): the final reduct against the converged well-founded model W — least_model_of_reduct(reference = W), a HARD FAIL if the result's fact-key set differs from W (an undefined/partial model, unsupported in v1), then emit the derived non-EDB rows stamped with the world graph. The last elementary phase transition of the intra-engine plan."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition logic:wfWorldSeeded ;
    logic:capability logic:wfReductEngineCapability .

# The combinator tree (program form an interpreter walks).
#   wfResolveLoop      = Iteration(body = wfResolveFixpoint,
#                                  condition = wfFixpointNotReached)
#   wfResolveThenBuild = SerialConjunction(left = wfResolveLoop,
#                                          right = wfConstructModel)
#   wfPhaseSequence    = SerialConjunction(left = wfMaterializeEdb,
#                                          right = wfResolveThenBuild)
# Phase order, left-first: materialize ; (resolve* ; construct).
logic:wfResolveLoop
    a logic:Iteration ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded resolve loop"@x-gmeow-english ;
    skos:definition "The logic:Iteration combinator wrapping the alternating-fixpoint phase of the well-founded materializer: its logic:iterationBody is logic:wfResolveFixpoint (the double-reduct step) and its logic:iterationCondition is logic:wfFixpointNotReached (K2 != K). The loop is the program-level twin of the `loop { … break when K2.key_set() == K.key_set() }` of crates/logic/src/wellfounded.rs — the back-edge that places logic:wellFoundedMaterializerPlan outside the certified acyclic DAG fragment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:iterationBody logic:wfResolveFixpoint ;
    logic:iterationCondition logic:wfFixpointNotReached .

logic:wfResolveThenBuild
    a logic:SerialConjunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded resolve then build"@x-gmeow-english ;
    skos:definition "The inner logic:SerialConjunction of the well-founded materializer's phase plan: do the alternating-fixpoint loop (logic:leftOperand logic:wfResolveLoop), THEN construct the final model (logic:rightOperand logic:wfConstructModel). The suffix program of the plan's outer serial conjunction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:leftOperand logic:wfResolveLoop ;
    logic:rightOperand logic:wfConstructModel .

logic:wfPhaseSequence
    a logic:SerialConjunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded phase sequence"@x-gmeow-english ;
    skos:definition "The ROOT logic:SerialConjunction of the well-founded materializer's phase plan: do the EDB-seeding phase (logic:leftOperand logic:wfMaterializeEdb), THEN the resolve-then-build suffix (logic:rightOperand logic:wfResolveThenBuild). Walked left-first, the combinator tree yields the execution order materialize ; resolve* ; construct — the program twin of crates/logic/src/wellfounded.rs materialize() and of gmeow_logic::WELL_FOUNDED_PHASES. The program root logic:wellFoundedMaterializerPlan reaches it through logic:planBody."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:leftOperand logic:wfMaterializeEdb ;
    logic:rightOperand logic:wfResolveThenBuild .

# The plan's success criterion: the converged well-founded model emitted.
logic:goalWellFoundedModel
    a gmeow:Goal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded model goal"@x-gmeow-english ;
    skos:definition "The success criterion of the well-founded materializer's phase plan: the total (two-valued) well-founded model of the rules over every world is computed and its derived non-EDB rows emitted. The gmeow:Goal logic:wellFoundedMaterializerPlan is arranged to reach; a partial model is a hard failure, never a partial success."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# The plan: the authored twin of crates/logic/src/wellfounded.rs materialize().
logic:wellFoundedMaterializerPlan
    a logic:Plan ,
        gmeow:SocialObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "well-founded materializer plan"@x-gmeow-english ;
    skos:definition "The AUTHORED MODEL of the intra-engine phase sequence the native well-founded-semantics evaluator runs per world (crates/logic/src/wellfounded.rs materialize()): the canonical process model applied one scale down from the build pipeline (gmeow:pipeline-build) — an intra-engine pass sequence rather than an inter-stage DAG. Its logic:planBody is the root combinator logic:wfPhaseSequence, whose left-first walk yields the three phases materialize (logic:wfMaterializeEdb) ; resolve* (the logic:Iteration logic:wfResolveLoop over logic:wfResolveFixpoint, gated by logic:wfFixpointNotReached) ; construct (logic:wfConstructModel) — matching gmeow_logic::WELL_FOUNDED_PHASES. Because the middle phase is a logic:Iteration (a loop), this plan is OUTSIDE the certified acyclic DAG fragment by construction; that is correct and expected, so it does NOT run logic:executedUnderContract logic:DagWorkflowContract. Principle 12 BOUNDARY: this plan is authored SOURCE the parity gate crates/pipeline/tests/wellfounded_plan_parity.rs checks the Rust runtime against — the reasoner NEVER parses this RDF at scheduling or runtime; the native loop is the runtime, the plan is its declared twin. As a logic:Plan it asserts its own gmeow:SocialObject sort directly, the prose grounding of logic:Plan licensing no DL inference of it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:planBody logic:wfPhaseSequence ;
    logic:planGoal logic:goalWellFoundedModel ;
    logic:planSuccessMode logic:StrongPlanSuccess .

# --- Transaction outcome: the executional-entailment verdict surface ----------
# The recorded result of EXECUTING a transaction program (the combinators above)
# under executional entailment — the native engine's verdict, surfaced as quads
# so the success/failure decision and the executed path carry into the
# derivation graph rather than being discarded after evaluation.

logic:TransactionOutcome
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Transaction Outcome"@x-gmeow-english ;
    skos:definition "The recorded result of executing a transaction program from a start state under executional entailment: the program succeeds iff there exists a path from the start state along which it holds, and failure leaves the start state untouched. It carries logic:outcomeOfProgram (the program executed), logic:transactionStart (the state it started from), and logic:transactionSucceeds (the boolean verdict); on success it is linked by logic:executedAlongPath to the logic:Path of states the run traversed and the per-step support is recorded as supersession. Typed APART from logic:GoalEvaluation, which records at-a-state satisfaction of a goal, and from logic:PlanSuccessMode, which classifies a plan's success mode over its nondeterministic outcome set: a logic:TransactionOutcome records ONE concrete executed run's success or failure under executional entailment, not a satisfaction judgement and not a mode classification."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:outcomeOfProgram
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "outcome of program"@x-gmeow-english ;
    skos:definition "Relates a logic:TransactionOutcome to the transaction program whose execution it records — a transaction-program combinator node (logic:SerialConjunction, logic:Choice, logic:Fallback, or logic:Iteration). Domain logic:TransactionOutcome, range a transaction-program node (stated in prose). It ties the verdict back to the program that produced it without conflating the outcome (a run record) with the program (the structure that was run)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:transactionStart
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "transaction start"@x-gmeow-english ;
    skos:definition "Relates a logic:TransactionOutcome to the gmeow:State the program executed from — the start state of the executional-entailment run. Domain logic:TransactionOutcome, range gmeow:State (stated in prose). On failure the start state is left untouched (no successor is materialized); on success it is the first state of the logic:executedAlongPath path. The input side marks the executable program root with logic:transitionFromState; logic:transactionStart records, on the outcome, the start the verdict was computed from."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:transactionSucceeds
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "transaction succeeds"@x-gmeow-english ;
    skos:definition "The boolean executional-entailment verdict of a logic:TransactionOutcome: true iff there exists a path from logic:transactionStart along which the program holds, false otherwise. Domain logic:TransactionOutcome, range xsd:boolean (stated in prose). Kept distinct from goal satisfaction (logic:satisfactionStatus over a logic:GoalEvaluation) and from plan success mode (logic:planSuccessMode): it is the bare 'a path exists from the start' reading of the transaction layer, and a false verdict is honest total failure rather than a weak or partial success."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:executedHypotheticallyAs
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "executed hypothetically as"@x-gmeow-english ;
    skos:definition "The content-addressed witness (a digest) of a hypothetical (sandbox) transaction run: present on a logic:TransactionOutcome exactly when the program executed under logic:HypotheticalExecution, recording the identity of the discarded run whose verdict (logic:transactionSucceeds) was computed without committing its effects. The run's effect substrate — the executed logic:Path, the per-step logic:TransactionStep records, and the supersession quads — is intentionally ABSENT, because the sandbox operator tests without committing; this digest is therefore the sole standing trace that the run occurred and what it ranged over. Nothing is asserted to be erased, only never emitted, so suppression-never-erasure holds for free. Single-valued. Domain logic:TransactionOutcome, range xsd:string (stated in prose). The committed counterpart (logic:CommittedExecution) emits the full effect substrate and carries no such witness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Concurrency: three distinct, separately-declared concerns ----------------

logic:SerializabilityCriterion
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Serializability Criterion"@x-gmeow-english ;
    skos:definition "A correctness property OF A HISTORY — not a protocol and not a guarantee strength. The closed value class of serializability criteria for a concurrent transaction history. Its individuals are logic:ConflictSerializability (an equivalent serial order exists reachable with no swap of conflicting operations) and logic:ViewSerializability (some serial order has the same read-from and final-write relationships). The set is closed; a misspelt value is rejected. This is one of three distinct, separately-declared concurrency concerns that must NOT be conflated: a logic:SerializabilityCriterion is a property of a history, a logic:IsolationLevel is a declared guarantee strength, and a logic:ConcurrencyControlProtocol is an implementation mechanism — keeping them apart is required because they are not interchangeable and an implicit assumption about any one of them is a defect."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:ConflictSerializability
    a owl:NamedIndividual ,
        logic:SerializabilityCriterion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Conflict Serializability"@x-gmeow-english ;
    skos:definition "The logic:SerializabilityCriterion value satisfied when an equivalent serial order exists that is reachable from the history by swapping only non-conflicting operations — no swap of a pair of conflicting operations is required. A history property, not a protocol. Contrast logic:ViewSerializability."@x-gmeow-english .

logic:ViewSerializability
    a owl:NamedIndividual ,
        logic:SerializabilityCriterion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "View Serializability"@x-gmeow-english ;
    skos:definition "The logic:SerializabilityCriterion value satisfied when some serial order has the same read-from and final-write relationships as the history — equivalent on what each read observed and which write was last. A history property, not a protocol. Strictly weaker than logic:ConflictSerializability is not implied; the two are distinct criteria a history may satisfy."@x-gmeow-english .

logic:IsolationLevel
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Isolation Level"@x-gmeow-english ;
    skos:definition "The declared GUARANTEE STRENGTH a schedule must meet — not a history property and not an implementation mechanism. The closed value class spanning the standard isolation spectrum up to and including full serializability and opacity. Its individuals are logic:ReadUncommittedIsolation, logic:ReadCommittedIsolation, logic:RepeatableReadIsolation, logic:SnapshotIsolation, logic:SerializableIsolation, and logic:OpacityIsolation — the strongest, under which even aborted or in-flight transactions never observe an inconsistent state, strictly stronger than serializability. The set is closed; a misspelt value is rejected. This is one of three distinct, separately-declared concurrency concerns that must NOT be conflated: a logic:IsolationLevel is a guarantee strength, a logic:SerializabilityCriterion is a property of a history, and a logic:ConcurrencyControlProtocol is an implementation mechanism."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:ReadUncommittedIsolation
    a owl:NamedIndividual ,
        logic:IsolationLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Read Uncommitted Isolation"@x-gmeow-english ;
    skos:definition "The logic:IsolationLevel guarantee under which a transaction may observe uncommitted writes of others — the weakest level of the standard spectrum, admitting dirty reads."@x-gmeow-english .

logic:ReadCommittedIsolation
    a owl:NamedIndividual ,
        logic:IsolationLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Read Committed Isolation"@x-gmeow-english ;
    skos:definition "The logic:IsolationLevel guarantee under which a transaction observes only committed writes, but successive reads of the same item may differ — dirty reads excluded, non-repeatable reads still admitted."@x-gmeow-english .

logic:RepeatableReadIsolation
    a owl:NamedIndividual ,
        logic:IsolationLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Repeatable Read Isolation"@x-gmeow-english ;
    skos:definition "The logic:IsolationLevel guarantee under which re-reads of an item a transaction has read return the same value — non-repeatable reads excluded, phantom rows still admitted."@x-gmeow-english .

logic:SnapshotIsolation
    a owl:NamedIndividual ,
        logic:IsolationLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Snapshot Isolation"@x-gmeow-english ;
    skos:definition "The logic:IsolationLevel guarantee under which a transaction reads from a consistent snapshot taken at its start — strong against most anomalies yet still admitting write skew, so strictly weaker than logic:SerializableIsolation."@x-gmeow-english .

logic:SerializableIsolation
    a owl:NamedIndividual ,
        logic:IsolationLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Serializable Isolation"@x-gmeow-english ;
    skos:definition "The logic:IsolationLevel guarantee under which the schedule is equivalent to some serial execution of the committed transactions — full serializability. Strictly weaker than logic:OpacityIsolation, which additionally constrains aborted and in-flight transactions."@x-gmeow-english .

logic:OpacityIsolation
    a owl:NamedIndividual ,
        logic:IsolationLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Opacity Isolation"@x-gmeow-english ;
    skos:definition "The logic:IsolationLevel guarantee under which even aborted or in-flight transactions never observe an inconsistent state — the strongest level, STRICTLY STRONGER than serializability (logic:SerializableIsolation), which constrains only committed transactions. Engine note: under the committed-only, snapshot-isolation execution model of the native evaluator, no aborted or in-flight transactions arise; opacity's additional constraints are therefore vacuously satisfied, and the isolation-adequacy verdict for logic:OpacityIsolation coincides with that of logic:SerializableIsolation by construction — both are met exactly when the witnessed schedule is conflict-serializable."@x-gmeow-english .

logic:ConcurrencyControlProtocol
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Concurrency Control Protocol"@x-gmeow-english ;
    skos:definition "The IMPLEMENTATION MECHANISM that enforces a chosen isolation level — HOW a guarantee is achieved, never the guarantee itself. The closed value class of concurrency-control protocols. Its individuals are logic:StrictTwoPhaseLocking, logic:StrongStrictTwoPhaseLocking, logic:TimestampOrdering, logic:OptimisticValidation, and logic:MultiversionConcurrencyControl. The set is closed; a misspelt value is rejected. This is one of three distinct, separately-declared concurrency concerns that must NOT be conflated: a logic:ConcurrencyControlProtocol is a mechanism, a logic:SerializabilityCriterion is a property of a history, and a logic:IsolationLevel is a guarantee strength — a protocol is how a guarantee is achieved, it is never the guarantee itself."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:StrictTwoPhaseLocking
    a owl:NamedIndividual ,
        logic:ConcurrencyControlProtocol ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Strict Two-Phase Locking"@x-gmeow-english ;
    skos:definition "The logic:ConcurrencyControlProtocol that holds all EXCLUSIVE (write) locks until the transaction commits or aborts, preventing cascading aborts on writes. Contrast logic:StrongStrictTwoPhaseLocking, which additionally holds shared (read) locks to commit."@x-gmeow-english .

logic:StrongStrictTwoPhaseLocking
    a owl:NamedIndividual ,
        logic:ConcurrencyControlProtocol ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Strong Strict Two-Phase Locking"@x-gmeow-english ;
    skos:definition "The logic:ConcurrencyControlProtocol that holds ALL locks — both shared (read) and exclusive (write) — until commit or abort, yielding the strongest, strictest two-phase-locking discipline. The strong-strict variant the design names distinctly from the strict variant (logic:StrictTwoPhaseLocking), which releases shared locks earlier."@x-gmeow-english .

logic:TimestampOrdering
    a owl:NamedIndividual ,
        logic:ConcurrencyControlProtocol ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Timestamp Ordering"@x-gmeow-english ;
    skos:definition "The logic:ConcurrencyControlProtocol that assigns each transaction a timestamp and orders conflicting operations by it, aborting any operation that would violate the timestamp order. A mechanism, not a guarantee."@x-gmeow-english .

logic:OptimisticValidation
    a owl:NamedIndividual ,
        logic:ConcurrencyControlProtocol ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Optimistic Validation"@x-gmeow-english ;
    skos:definition "The logic:ConcurrencyControlProtocol that lets transactions run without locking and validates for conflicts at commit time, aborting and retrying on a detected conflict. A mechanism, not a guarantee."@x-gmeow-english .

logic:MultiversionConcurrencyControl
    a owl:NamedIndividual ,
        logic:ConcurrencyControlProtocol ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Multiversion Concurrency Control"@x-gmeow-english ;
    skos:definition "The logic:ConcurrencyControlProtocol under which each transaction reads from a consistent version snapshot taken at its start and writes new versions independently, so readers never block writers. Its strongest enforced guarantee is logic:SnapshotIsolation — it still admits WRITE SKEW and so does NOT enforce logic:SerializableIsolation, which is exactly why declaring it under a serializable-or-stronger level is inadequate. This engine realizes snapshot isolation by construction, so a multiversion run needs no lock or timestamp events. A mechanism, not a guarantee."@x-gmeow-english .

# --- Serialization anomaly: a finding, never a contradiction witness ----------

logic:SerializationAnomaly
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Serialization Anomaly"@x-gmeow-english ;
    skos:definition "A HISTORY-LEVEL finding: a pattern of conflicting operations, read-from edges, and happens-before arcs in a transaction history that admits no equivalent serial execution under the declared policy. Lost updates, write skew, and read/write anomalies are findings of this kind. It is DISTINCT from a contradiction witness (logic:contradictionWitness, which asserts ⊥ within a single state) and must NOT be modelled as one: the final state after a non-serializable schedule may be perfectly logically consistent while the schedule still has no equivalent serial execution, so a serialization anomaly is a property of the history, never a logical contradiction inside a state. It is surfaced as a finding with its dependency cycle or violated isolation level described; a non-serializable schedule is never silently linearized."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Concurrent history: the derived conflict graph + anomaly surface ----------
# The transaction history of a concurrent composition (logic:ConcurrentComposition)
# and the conflict-edge / criterion / finding vocabulary the native concurrent
# evaluator DERIVES from an interleaved run and the serialization-anomaly engine
# classifies. A history is a property bearer kept APART from the program that gives
# rise to it (the composition) and from the executional-entailment verdict (the
# outcome). Normative in design/LOGIC-TRANSACTION.md §Concurrent transactions.

logic:ConcurrentHistory
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Concurrent History"@x-gmeow-english ;
    skos:definition "The transaction history of a concurrent composition: the node that carries the logic:precedes conflict edges whose cycle structure logic:SerializationAnomaly classifies. The native concurrent evaluator DERIVES it from the interleaved execution of a logic:ConcurrentComposition's two legs (it may also be authored directly as a conflict graph). It is a HISTORY-LEVEL property bearer, kept DISTINCT from the logic:ConcurrentComposition PROGRAM that gives rise to it and from the logic:TransactionOutcome VERDICT of running that program — a history records which conflicting operations were ordered against which, not whether a path exists. Its serializability is judged against the logic:serializabilityCriterion it carries (default logic:ConflictSerializability); a cyclic conflict graph is surfaced as a logic:SerializationAnomaly finding, never silently linearized and never a logical contradiction within a state."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:precedes
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "precedes"@x-gmeow-english ;
    skos:definition "A conflict (precedence) edge in a logic:ConcurrentHistory: 'from precedes to' orders the conflicting operation of transaction 'from' before that of transaction 'to' in the witnessed schedule. Two operations conflict when they touch the same item and at least one writes it; the edge direction records which came first in the interleaving. Domain and range are transaction-program nodes (stated in prose). A CYCLE over logic:precedes is a serialization anomaly (logic:SerializationAnomaly) — between two transactions it requires edges in BOTH directions, the write-skew / lost-update shape — and is NEVER a logical contradiction (logic:contradictionWitness): it is a property of the history, not of any single state."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:serializabilityCriterion
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "serializability criterion"@x-gmeow-english ;
    skos:definition "Relates a logic:ConcurrentHistory to the logic:SerializabilityCriterion its schedule is classified against — logic:ConflictSerializability (the default when none is stated) or logic:ViewSerializability. Domain logic:ConcurrentHistory, range logic:SerializabilityCriterion (stated in prose). This is the history-property dimension only: it is kept SEPARATE from logic:IsolationLevel (a declared guarantee strength) and logic:ConcurrencyControlProtocol (an implementation mechanism), the two other concurrency concerns the layer never conflates. The criterion a detected anomaly violates is recorded on the finding through logic:violatedCriterion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:concurrentComposedFrom
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "concurrent composed from"@x-gmeow-english ;
    skos:definition "Relates a DERIVED logic:ConcurrentHistory to each of the two transaction-program operands (the logic:leftOperand and logic:rightOperand of the logic:ConcurrentComposition) whose interleaved elementary steps produced its conflict edges. Domain logic:ConcurrentHistory, range a transaction-program node (stated in prose); multi-valued (one link per operand). It is the audit trail from the history back to the authored sub-programs that gave rise to it, kept distinct from logic:precedes (an edge BETWEEN the transactions within the history) — this link points OUT to the programs, not between operations."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:derivedHistory
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "derived history"@x-gmeow-english ;
    skos:definition "Relates a logic:TransactionOutcome of a logic:ConcurrentComposition run to the logic:ConcurrentHistory the native evaluator derived from the interleaved execution of its two legs. Domain logic:TransactionOutcome, range logic:ConcurrentHistory (stated in prose). It SEPARATES the executional-entailment verdict (the outcome — does a path exist) from the derived concurrency surface (the history — how the conflicting operations were ordered and whether that ordering is serializable): a concurrent run records BOTH, linked by this property, so neither the verdict nor the serializability finding is conflated with the other."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:violatedCriterion
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "violated criterion"@x-gmeow-english ;
    skos:definition "Relates a logic:SerializationAnomaly finding to the logic:SerializabilityCriterion it violates — the criterion (logic:ConflictSerializability or logic:ViewSerializability) under which the history admits no equivalent serial execution. Domain logic:SerializationAnomaly, range logic:SerializabilityCriterion (stated in prose). It names WHICH history property the anomaly breaches; it does not assert a logical contradiction (the schedule's final state may be perfectly consistent), keeping the finding a property of the history rather than of any state."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:anomalyCycle
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "anomaly cycle"@x-gmeow-english ;
    skos:definition "The detected dependency cycle of a logic:SerializationAnomaly, rendered as the canonical sequence of transaction IRIs joined by ' -> ' (rotated to start at the lexicographically smallest member and closed back to it, so the same history always yields the same description). Domain logic:SerializationAnomaly, range xsd:string (stated in prose). It is a human-readable DESCRIPTION of the history-level finding — the conflict-graph cycle that has no equivalent serial order — never a claim of ⊥ within a state; a non-serializable schedule is surfaced with its cycle described here, never silently linearized."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- View-serializability: the read-from / final-write history surface ---------
# The native concurrent evaluator classifies the witnessed binary interleaving
# against logic:ViewSerializability as well as logic:ConflictSerializability, and
# DERIVES the read-from and happens-before edges that classification rests on.
# View-equivalence compares, across the witnessed schedule and the two serial
# orders of its two legs, which write each read observed (logic:readsFrom) and
# which transaction wrote each situation last. A conflict-serializable schedule is
# always view-serializable; a conflict-CYCLIC schedule may still be view-
# serializable (a blind-write history), so the two criteria are recorded
# independently through logic:satisfiesCriterion.

logic:readsFrom
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "reads from"@x-gmeow-english ;
    skos:definition "A read-dependency edge of a logic:ConcurrentHistory: 'reader readsFrom writer' records that the reading logic:TransactionStep observed, for a situation in its read set (its schema's logic:precondition), the value written by the writer logic:TransactionStep — the last step to write that situation before the reader in the witnessed interleaving. Domain and range logic:TransactionStep (stated in prose). Emitted only for CROSS-transaction read dependencies (a step reading from the OTHER leg's write), which is where the read-from relation can differ from a serial order and therefore where it carries view-serializability information; intra-leg read dependencies are fixed by the leg's own order and carry none. Together with logic:happensBefore it is the view-serializability surface, kept DISTINCT from logic:precedes, which is the transaction-level conflict edge over which conflict-serializability is decided."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:happensBefore
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "happens before"@x-gmeow-english ;
    skos:definition "A schedule-order edge of a logic:ConcurrentHistory: 'earlier happensBefore later' records that the earlier logic:TransactionStep is scheduled before the later one in the witnessed index-order interleaving AND the two conflict (they share a situation that at least one writes). Domain and range logic:TransactionStep (stated in prose). Emitted only for CROSS-transaction conflicting pairs — the schedule order between the two legs' operations that view- and conflict-serializability both read. It is the step-level witnessed-order companion to logic:readsFrom; it is kept DISTINCT from logic:precedes, which lifts conflict order to the TRANSACTION level for cycle detection, and from logic:temporallySucceeds, which orders the states of a single executed path rather than operations across legs."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:satisfiesCriterion
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "satisfies criterion"@x-gmeow-english ;
    skos:definition "Relates a logic:ConcurrentHistory to each logic:SerializabilityCriterion its witnessed schedule actually SATISFIES — the classification RESULT, as opposed to logic:serializabilityCriterion, which names the criterion the history is judged against. The native evaluator emits logic:ConflictSerializability when the logic:precedes conflict graph is acyclic and logic:ViewSerializability when the witnessed interleaving is view-equivalent to one of the two serial orders of its legs. Domain logic:ConcurrentHistory, range logic:SerializabilityCriterion (stated in prose); multi-valued. Because conflict-serializability is strictly stronger, a history that satisfies logic:ConflictSerializability always also satisfies logic:ViewSerializability; a conflict-CYCLIC history may satisfy logic:ViewSerializability alone. Absence of a criterion here is the honest record that the schedule does not satisfy it — the corresponding logic:SerializationAnomaly finding carries the violated criterion — never a silent linearization."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Protocol soundness: the isolation guarantee + control mechanism surface ---
# A logic:ConcurrencyControlProtocol is enforced by the protocol's OWN events —
# per-transaction timestamps and per-action lock acquire/release — which a run
# records so that "does this witnessed schedule respect the declared protocol?"
# is a polynomial WELL-FORMEDNESS classification of the schedule (Principle 12),
# never a search for a legal schedule (which would be NP-hard). The protocol is
# declared on the reasoning contract (logic:declaredProtocol); the verdict is
# recorded on the derived history (logic:protocolEnforced). A declared protocol
# whose required events are absent from the run is a HARD ERROR, never a silent
# pass — the run must carry the events its protocol is verified against.

logic:declaredProtocol
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "declared protocol"@x-gmeow-english ;
    skos:definition "Relates a logic:ReasoningContract to the logic:ConcurrencyControlProtocol its concurrent transactions are to be enforced under — the IMPLEMENTATION MECHANISM (strict / strong-strict two-phase locking, timestamp ordering, or optimistic validation) declared for the run. Domain logic:ReasoningContract, range logic:ConcurrencyControlProtocol (stated in prose); at most one per contract, from the closed protocol set (a value outside it is a hard error). It is kept DISTINCT from the guarantee strength the mechanism is meant to achieve (logic:declaredIsolationLevel) and from the history property it produces (logic:serializabilityCriterion): a protocol is HOW a guarantee is enforced, never the guarantee itself. The native evaluator classifies whether the witnessed schedule respects this protocol's discipline over the run's recorded protocol events and records the verdict as logic:protocolEnforced."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:transactionTimestamp
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "transaction timestamp"@x-gmeow-english ;
    skos:definition "The start-order timestamp assigned to a transaction (a concurrent-composition leg) under a timestamp-ordering protocol — the recorded event a logic:TimestampOrdering verification classifies the witnessed schedule against. Domain a transaction-program node (a logic:ConcurrentComposition leg), range xsd:integer (stated in prose); single-valued. Under logic:TimestampOrdering the schedule is well-formed iff every logic:precedes conflict edge runs from the earlier timestamp to the later one; a run declaring logic:TimestampOrdering that omits a leg's timestamp is a hard error. It is a recorded protocol EVENT — an input the classifier reads — not a derived verdict, and it is distinct from logic:temporallySucceeds, which orders the STATES of an executed path rather than the transactions of a schedule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:lockAcquired
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "lock acquired"@x-gmeow-english ;
    skos:definition "Records that the action a transaction step performs ACQUIRES an exclusive lock on a situation — a recorded event of a two-phase-locking protocol. Declared on the action schema (logic:ActionSchema) a step instantiates, range the locked situation (stated in prose); the native evaluator reads the acquire/release events in each leg's step order to classify the lock discipline. Under logic:StrictTwoPhaseLocking the schedule is well-formed iff each leg is two-phase (no acquire follows any release within the leg); under logic:StrongStrictTwoPhaseLocking, additionally, no lock is released before the leg's final (commit) step. It is a recorded protocol EVENT the classifier reads, kept distinct from logic:lockReleased (its releasing counterpart) and from the situation-validity vocabulary (logic:situationObtains), which is about what holds, not what is locked."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:lockReleased
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "lock released"@x-gmeow-english ;
    skos:definition "Records that the action a transaction step performs RELEASES its exclusive lock on a situation — the releasing counterpart of logic:lockAcquired and a recorded event of a two-phase-locking protocol. Declared on the action schema (logic:ActionSchema) a step instantiates, range the released situation (stated in prose). The native evaluator reads releases in each leg's step order: a release before any remaining acquire breaks the two-phase discipline (logic:StrictTwoPhaseLocking), and a release before the leg's final step breaks the held-to-commit discipline (logic:StrongStrictTwoPhaseLocking). It is a recorded protocol EVENT the classifier reads, never a derived verdict."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:protocolEnforced
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "protocol enforced"@x-gmeow-english ;
    skos:definition "The boolean verdict of classifying a logic:ConcurrentHistory's witnessed schedule against the logic:ConcurrencyControlProtocol its run declared (logic:declaredProtocol): true iff the schedule respects that protocol's discipline over the run's recorded protocol events (timestamps for logic:TimestampOrdering; lock acquire/release events for the two-phase-locking protocols; cross-leg read-write disjointness for logic:OptimisticValidation). Domain logic:ConcurrentHistory, range xsd:boolean (stated in prose); present only when a protocol is declared. A false verdict carries a human-readable logic:protocolViolationReason. This is HOW-a-guarantee-is-enforced verification, kept distinct from logic:satisfiesCriterion (the history property the schedule satisfies) and logic:isolationLevelAdequacy (whether the schedule meets a declared guarantee strength); a declared protocol whose required events are absent is a hard error, never a false-by-default."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:protocolViolationReason
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "protocol violation reason"@x-gmeow-english ;
    skos:definition "A human-readable description of WHY a logic:ConcurrentHistory's witnessed schedule fails the concurrency-control protocol its run declared — present exactly when logic:protocolEnforced is false. Domain logic:ConcurrentHistory, range xsd:string (stated in prose). It names the discipline the schedule breaks (a non-two-phase lock order, a lock released before commit, a conflict edge against timestamp order, or a cross-leg read-write conflict that optimistic validation would abort), so a protocol failure is surfaced with its cause rather than as a bare boolean. It is a description of a mechanism-level finding, never a claim of logical contradiction within a state."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Isolation-level adequacy: does the schedule meet the declared strength? ---
# A logic:IsolationLevel is a declared GUARANTEE STRENGTH; the native evaluator
# classifies whether a run's witnessed schedule MEETS it. The concurrent engine
# realizes snapshot isolation (each leg reads a consistent start snapshot and
# writes independently), so every level up to and including logic:SnapshotIsolation
# is met by construction; logic:SerializableIsolation and logic:OpacityIsolation
# are met only when the schedule is conflict-serializable (a write-skew cycle,
# which snapshot admits, fails them). The level is declared on the contract
# (logic:declaredIsolationLevel); the verdict is recorded on the history
# (logic:isolationLevelAdequacy).

logic:declaredIsolationLevel
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "declared isolation level"@x-gmeow-english ;
    skos:definition "Relates a logic:ReasoningContract to the logic:IsolationLevel guarantee strength its concurrent transactions must meet. Domain logic:ReasoningContract, range logic:IsolationLevel (stated in prose); at most one per contract, from the closed isolation-level set (a value outside it is a hard error). It is kept DISTINCT from logic:declaredProtocol (the mechanism that would enforce the level) and from logic:serializabilityCriterion (a history property): an isolation level is the guarantee STRENGTH required, neither the mechanism that achieves it nor the property a particular history happens to have. The native evaluator classifies whether the witnessed schedule meets this declared strength and records the result as logic:isolationLevelAdequacy."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:isolationLevelAdequacy
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "isolation level adequacy"@x-gmeow-english ;
    skos:definition "The boolean verdict of classifying a logic:ConcurrentHistory's witnessed schedule against the logic:IsolationLevel its run declared (logic:declaredIsolationLevel): true iff the schedule meets that declared guarantee strength. Domain logic:ConcurrentHistory, range xsd:boolean (stated in prose); present only when a level is declared. Because the concurrent evaluator realizes snapshot isolation, every level up to logic:SnapshotIsolation is adequate by construction; logic:SerializableIsolation and logic:OpacityIsolation are adequate iff the schedule is conflict-serializable — a write-skew cycle (which snapshot admits) is adequate for snapshot yet INADEQUATE for serializability. A false verdict carries a logic:isolationInadequacyReason. It is guarantee-strength adequacy, kept distinct from logic:protocolEnforced (mechanism soundness) and logic:satisfiesCriterion (the history property)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:isolationInadequacyReason
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "isolation inadequacy reason"@x-gmeow-english ;
    skos:definition "A human-readable description of WHY a logic:ConcurrentHistory's witnessed schedule fails to meet its declared logic:IsolationLevel — present exactly when logic:isolationLevelAdequacy is false. Domain logic:ConcurrentHistory, range xsd:string (stated in prose). In the snapshot-isolation model this is the case of a schedule that is not conflict-serializable (a write-skew or lost-update cycle) declared under logic:SerializableIsolation or logic:OpacityIsolation, and the reason names that: the schedule is not conflict-serializable, so it does not meet the declared strength. It is a guarantee-level finding, never a claim of logical contradiction within a state."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Protocol -> isolation-level adequacy: does the declared mechanism reach ---
# the declared strength? A logic:ConcurrencyControlProtocol is a mechanism and a
# logic:IsolationLevel a guarantee strength; a run declares each separately, so
# it may pair them incoherently. Each protocol has a guaranteed CEILING (the
# strongest level it enforces when respected): logic:MultiversionConcurrencyControl
# reaches logic:SnapshotIsolation (write skew remains), while the four
# serializability-strength protocols reach logic:SerializableIsolation (coincident
# with logic:OpacityIsolation for committed-only histories). The pairing is
# adequate iff the ceiling is at least the declared level. This is a consistency
# cross-check between two declarations, never an inference of one from the other.

logic:protocolLevelAdequacy
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "protocol level adequacy"@x-gmeow-english ;
    skos:definition "The boolean verdict of classifying whether the logic:ConcurrencyControlProtocol a run declares (logic:declaredProtocol) is strong enough to guarantee the logic:IsolationLevel it also declares (logic:declaredIsolationLevel): true iff the protocol's guaranteed ceiling level is at least the declared level. Domain logic:ConcurrentHistory, range xsd:boolean (stated in prose); present only when a run declares BOTH a protocol and a level — otherwise there is no pairing to judge. The guaranteed ceilings are logic:SnapshotIsolation for logic:MultiversionConcurrencyControl and logic:SerializableIsolation (coincident with logic:OpacityIsolation for committed-only histories) for logic:StrictTwoPhaseLocking, logic:StrongStrictTwoPhaseLocking, logic:TimestampOrdering, and logic:OptimisticValidation. The one inadequate pairing this vocabulary admits is logic:MultiversionConcurrencyControl declared under logic:SerializableIsolation or logic:OpacityIsolation, since its snapshot ceiling still admits write skew; a false verdict carries a logic:protocolLevelInadequacyReason. It is a CONSISTENCY CROSS-CHECK between two declarations — kept distinct from logic:protocolEnforced (whether the witnessed schedule respects the mechanism) and logic:isolationLevelAdequacy (whether the witnessed schedule meets the strength) — and never infers the level from the protocol nor the protocol from the level."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:protocolLevelInadequacyReason
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "protocol level inadequacy reason"@x-gmeow-english ;
    skos:definition "A human-readable description of WHY a run's declared logic:ConcurrencyControlProtocol cannot guarantee its declared logic:IsolationLevel — present exactly when logic:protocolLevelAdequacy is false. Domain logic:ConcurrentHistory, range xsd:string (stated in prose). In this vocabulary the case is logic:MultiversionConcurrencyControl declared under logic:SerializableIsolation or logic:OpacityIsolation, and the reason names it: the protocol's guaranteed ceiling is snapshot isolation, which admits write skew, so it does not reach the declared serializable-or-stronger level. It is a declaration-consistency finding, never a claim of logical contradiction within a state."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── The full first-order formula AST surface (TBox + RBox) ────────────────────
# The reified vocabulary the typed full-FOL formula core serializes into: a
# logic:Formula tree of quantifiers (logic:forall / logic:exists), connectives
# (logic:and / logic:or / logic:not / logic:antecedent+logic:consequent /
# logic:iff), and atomic predications (logic:relation over ordered term-carrier
# arguments). Horn+NAF rules remain the recognized sub-fragment carried by
# logic:Rule; this surface carries the formulas that exceed it. Relations are
# reified as logic:Type individuals (the HiLog reflection — see logic:instanceOf
# / logic:orderedType / logic:Type), so the object level stays first-order: there
# is no predicate-variable term.

logic:Formula
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Formula"@x-gmeow-english ;
    skos:definition "A first-order formula node: the reified AST node a non-Horn logic: statement compiles into. A logic:Formula is a quantifier (carrying logic:forall or logic:exists over a body and one or more logic:quantifiedVariable bindings), a connective (logic:and, logic:or, logic:not, logic:antecedent with logic:consequent, or logic:iff over sub-formulae), or an atomic predication (logic:relation over ordered logic:argument terms). It is the unified full-FOL core of which Horn+NAF derivation rules are a recognized sub-fragment; the canonical RDF 1.2 serialization round-trips it losslessly, while weaker projections carry any formula they cannot express as flagged unsupported residue."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Rule
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Rule"@x-gmeow-english ;
    skos:definition "A productive Horn or stratified-negation derivation whose logic:head is entailed when every positive logic:body atom holds, every logic:negatedBody atom is absent in its declared closure, and every guard succeeds. It is not a general logic:Formula or an integrity logic:Constraint: constructs outside the rule fragment remain formula trees and are carried as projection residue rather than approximated."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:TermCarrier
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Term Carrier"@x-gmeow-english ;
    skos:definition "An ordered slot in an atomic formula's logic:argument list, a function term's logic:argument list, or a quantifier's logic:quantifiedVariable block. It carries exactly one zero-based logic:termIndex and exactly one value kind: logic:termIri, logic:termVariable, logic:termLiteral, logic:termSequenceMarker, or logic:termApplication (a nested compound function term). It is not the term value itself; it is the RDF node that preserves the value's kind and position independently of triple order."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:FunctionTerm
    a owl:Class ;
    logic:subClassOf logic:ArgumentStructure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Function Term"@x-gmeow-english ;
    skos:definition "A compound function-term application node: a single reified function symbol (logic:functionSymbol, a logic:Type individual) applied to a non-empty, ordered list of logic:argument term-carriers, denoting a first-order term such as cons(H, T) or s(X). It mirrors the atomic-predication pattern (logic:relation over ordered logic:argument), but predicates a FUNCTION symbol producing a term rather than a relation producing a truth value; reifying the symbol as a logic:Type individual keeps the object level first-order, so there is no function-variable. An argument carrier may itself carry logic:termApplication, so a nested term such as cons(H, cons(1, nil)) round-trips. It is not itself a logic:Formula: it is a term, referenced from a carrier's logic:termApplication, never asserted as a sentence."@x-gmeow-english ;
    skos:example "cons(H, cons(1, nil)) is a logic:FunctionTerm whose logic:functionSymbol is ex:cons and whose second logic:argument carries logic:termApplication onto the inner cons(1, nil) function term."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a function term for a nullary constant; a 0-ary function symbol is an individual and is carried by logic:termIri, so an empty-argument function term would give one constant two spellings."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reify the function symbol as a logic:Type individual on logic:functionSymbol, place each operand in a zero-based logic:argument term-carrier, and reference the whole node from an argument carrier's logic:termApplication."@x-gmeow-english ;
    gmeow:useWhen "Use when an argument is itself a compound term built by applying a function symbol to sub-terms, rather than an IRI, variable, literal, or sequence marker."@x-gmeow-english .

logic:ArgumentStructure
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Argument Structure"@x-gmeow-english ;
    skos:definition "A node that applies a reified operator to an ordered list of logic:argument term-carriers: an atomic-predication logic:Formula (operator = logic:relation) or a logic:FunctionTerm (operator = logic:functionSymbol). It is the shared rdfs:domain of logic:argument, so the ordered argument-carrier machinery is reused across both without asserting that a function term is a formula or that a formula is a term."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:SequenceMarker
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Sequence Marker"@x-gmeow-english ;
    skos:definition "A variadic argument placeholder (the Common Logic '…x' form) that binds a sequence of terms rather than a single term, generalizing the fixed arity-three atom to predications of any arity. A term-carrier argument whose value is a logic:termSequenceMarker denotes one; keeping it a distinct kind stops a single-term variable from being mistaken for a sequence one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# ── The authored logic:ReasoningProgram surface (TBox + RBox) ─────────────────
# A general, mode-annotated authoring envelope over the EXISTING clause
# constructs above: logic:Formula atoms/Horn rules via logic:antecedent /
# logic:consequent, logic:not for negated body literals, and
# logic:termApplication / logic:FunctionTerm / logic:functionSymbol for
# compound terms. It mints no second clause language — a logic:ReasoningProgram
# is a named clause set plus a goal, evaluated under a selected strategy.

logic:ReasoningProgram
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Reasoning Program"@x-gmeow-english ;
    skos:definition "A named clause set evaluated under a selected strategy: the authored surface that drives the native reasoning engine directly from slice content. A logic:ReasoningProgram carries a set of logic:clause atoms — facts and Horn rules, the SAME logic:Formula clause shape the forward relational-core lane already consumes, so there is no separate clause language — exactly one logic:programQuery goal atom whose logic:termVariable term-carriers are the answer variables the engine binds, zero or more logic:verdictProbe atoms whose three-valued well-founded verdict is projected independently of the query's bindings, and exactly one logic:evaluationMode selecting the evaluation strategy. 'Backward' resolution is a STRATEGY over a clause set, not a kind of program: keeping the mode a selector on a shared clause set, rather than splitting programs into forward and backward kinds, is what lets the SAME authored clauses later be evaluated forward once a chase strategy is added, without re-authoring."@x-gmeow-english ;
    skos:example "A program with two logic:clause facts, a rule concluding path(X,Z) from edge(X,Y) and path(Y,Z), one logic:programQuery path(a, V), and logic:evaluationMode logic:BackwardEvaluation resolves V by goal-directed SLG-WFS backward resolution over the clause set."@x-gmeow-english ;
    gmeow:avoidWhen "Do not author a separate forward-only or backward-only program class; author one logic:ReasoningProgram and select the strategy on logic:evaluationMode, since the clause set itself is strategy-neutral."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Author one or more logic:clause facts/rules using the existing logic:Formula / logic:antecedent / logic:consequent / logic:not shape, attach exactly one logic:programQuery goal atom, optionally attach logic:verdictProbe atoms, and select exactly one logic:evaluationMode."@x-gmeow-english ;
    gmeow:useWhen "Use when a slice needs to author a normal logic program — a clause set plus a goal query — directly as data the native engine evaluates, rather than describing reasoning behavior only in prose."@x-gmeow-english .

logic:EvaluationMode
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Evaluation Mode"@x-gmeow-english ;
    skos:definition "The closed value class of the evaluation strategy a logic:ReasoningProgram selects via logic:evaluationMode — which procedure resolves the SAME authored clause set. Its sole individual today is logic:BackwardEvaluation, the goal-directed SLG-WFS backward-resolution strategy; the set is closed and a misspelt or otherwise-unrecognized value is rejected. A forward chase over the identical clause shape is a future member of this same closed set, not a competing program kind, which is why evaluation strategy is carried as a selector value rather than a class distinction on logic:ReasoningProgram."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:BackwardEvaluation
    a owl:NamedIndividual ,
        logic:EvaluationMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Backward Evaluation"@x-gmeow-english ;
    skos:definition "The logic:EvaluationMode value selecting goal-directed SLG-WFS backward resolution: subsumptive demand-driven answer keying (SLG tabling), structured-term unification over logic:FunctionTerm arguments, explicit proof objects for each derived answer, and three-valued well-founded negation for logic:not-negated body literals. The one evaluation strategy this vocabulary supports today; contrast a future forward-chase member of logic:EvaluationMode over the identical clause set."@x-gmeow-english .

logic:evaluationMode
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:ReasoningProgram ;
    rdfs:range logic:EvaluationMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "evaluation mode"@x-gmeow-english ;
    skos:definition "Relates a logic:ReasoningProgram to the single logic:EvaluationMode strategy it selects to resolve its clause set. Functional: a program selects exactly one strategy, never a mix. An unrecognized or unsupported mode value is a HARD FAIL at compile time — explicit feature selection under the closed logic:EvaluationMode set, never a silent fallback to a weaker or default strategy."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:clause
    a owl:ObjectProperty ;
    rdfs:domain logic:ReasoningProgram ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "clause"@x-gmeow-english ;
    skos:definition "Relates a logic:ReasoningProgram to each authored clause: an atomic fact or a Horn rule whose logic:antecedent body atoms entail its logic:consequent head, with any body atom optionally logic:not-negated. Reuses the SAME logic:Formula clause shape the forward relational-core lane already lowers from — there is no separate, program-specific clause language. Multi-valued; a program with no clauses is malformed (logic:ReasoningProgramClauseConstraint)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:programQuery
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:ReasoningProgram ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "program query"@x-gmeow-english ;
    skos:definition "Relates a logic:ReasoningProgram to the single goal atom it resolves against its clause set. Functional: a program declares exactly one goal (logic:ReasoningProgramQueryConstraint requires it; the owl:FunctionalProperty declaration caps it at one). The goal's logic:termVariable term-carriers are the answer variables the engine binds and returns, distinct from a logic:verdictProbe atom's three-valued verdict projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:verdictProbe
    a owl:ObjectProperty ;
    rdfs:domain logic:ReasoningProgram ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "verdict probe"@x-gmeow-english ;
    skos:definition "Relates a logic:ReasoningProgram to zero or more atoms whose three-valued (true/false/undefined) well-founded verdict is projected as a standalone win/move-style check, rather than an answer-variable binding. Distinct from logic:programQuery: a probe reports which of the three verdicts an atom carries under the well-founded model, while the query resolves variable bindings for its single goal. Multi-valued; a program may carry no probes at all."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:variableSort
    a owl:ObjectProperty ;
    rdfs:domain logic:TermCarrier ;
    rdfs:range owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "variable sort"@x-gmeow-english ;
    skos:definition "Assigns an order-sort to a variable term-carrier: the reasoned class (any math:, logic:, or domain-slice owl:Class, not only the numeric tower) the term-carrier's bound variable ranges over, consumed to build the order-sorted unification context a backward-resolution engine unifies structured terms under. It is ONE case of a general sort-assignment pattern, not a variable-only special case: logic:variableSort is the named extension point where a future logic:functionSort (assigning a rank/sort signature to a function symbol rather than a variable) slots in, so nothing here precludes rank-sorted compound terms later. It is not a value restriction on an ordinary OWL property; it is metadata the typed-IR frontend reads to seed sort-checked unification."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:hasFormula
    a owl:ObjectProperty ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "has formula"@x-gmeow-english ;
    skos:definition "Relates a program or container to a top-level logic:Formula it asserts. Top-level formulae are reached by this property; sub-formulae are reached by the connective and quantifier properties, so a formula referenced as another's component is not also a top-level assertion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:integrity
    a owl:ObjectProperty ;
    rdfs:domain logic:Constraint ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "integrity"@x-gmeow-english ;
    skos:definition "Relates a logic:Constraint to its closed-world integrity condition: the reified logic:Formula whose violation is a finding, not a derivation. Reuses the realized full-FOL formula core verbatim — the condition is an outer range-restricted universal (logic:forall over a bound focus) whose logic:antecedent guard names the class or predicate the focus ranges over and whose logic:consequent is the per-focus condition — so a constraint needs no bespoke shape DSL. The focus target (a class, or the subjects/objects of a predicate) is derived from that guard, never authored twice."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:severity
    a owl:DatatypeProperty ;
    rdfs:domain logic:Constraint ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "severity"@x-gmeow-english ;
    skos:definition "The severity a logic:Constraint violation reports at, as one of the SHACL local names 'Violation', 'Warning', or 'Info'. Absent means the SHACL default 'Violation'. Carried on the canonical constraint so the projected sh:SPARQLConstraint reproduces the authored sh:severity rather than re-deriving one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:message
    a owl:DatatypeProperty ;
    rdfs:domain logic:Constraint ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "message"@x-gmeow-english ;
    skos:definition "The advisory human-readable message a logic:Constraint violation attaches (projected to sh:message). Presentation-only and load-bearing-false: it carries no identity, so two constraints differing only in their message are the same constraint. Absent means no message."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --------------------------------------------------------------------------- #
# Compact constraint-sugar records + the aggregate-comparison satellite.
#
# A few authoring shortcuts the compiler EXPANDS into a canonical logic:Constraint
# + integrity logic:Formula, so an author never hand-writes a formula tree for the
# common closed-world patterns. Sugar is frontend-only: each record expands to
# exactly one logic:Constraint (carrying an honest reified FOL integrity + a
# required logic:formalizes), so there is one canonical home per authored
# constraint. The aggregate satellite carries a reduce-style comparison the
# realized FOL formula core has no node for, lowered to a GROUP BY/HAVING
# sh:SPARQLConstraint (design/LOGIC-VALIDATION.md).
# --------------------------------------------------------------------------- #

logic:ConstraintSugar
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Constraint Sugar"@x-gmeow-english ;
    skos:definition "An authoring descriptor that the logic frontend expands into one canonical logic:Constraint with a reified integrity formula. A constraint-sugar record names a closed validation pattern and its parameters; it is not itself a logic:Formula AST node, so formula constructor checks never mistake validation metadata for an object-level sentence."@x-gmeow-english ;
    skos:example "A logic:ChoiceGroupConstraint record can require exactly one of two predicates without being treated as either operand of the formula it compiles."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a sugar class when the integrity condition needs a formula shape the selected closed pattern cannot preserve."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Select the narrowest sugar subclass, provide its target and pattern parameters, and inspect the compiled logic:Constraint projection."@x-gmeow-english ;
    gmeow:useWhen "Use for a supported closed-world validation pattern whose canonical expansion is deterministic."@x-gmeow-english .

logic:ChoiceGroupConstraint
    a owl:Class ;
    rdfs:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Choice Group Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a choice-group cardinality constraint (P1): a logic:onClass target, a set of logic:choicePredicate predicates, and a logic:choiceMode ('exactly-one', 'at-most-one', or the 'exactly-one-of-N' alias of 'exactly-one'). The compiler expands it into a canonical logic:Constraint whose integrity is the XOR / at-most formula over the ∃-requiredness of each predicate. Frontend-only: it is not a new node kind, only an authoring shortcut."@x-gmeow-english ;
    skos:example "ex:contactChoice a logic:ChoiceGroupConstraint ; logic:onClass ex:Contact ; logic:choicePredicate ex:email, ex:phone ; logic:choiceMode \"exactly-one\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a choice group when several members may coexist and at least one, rather than exactly or at most one, is required."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Supply one target class, at least two choice predicates, and the exact cardinality mode the compiled XOR or at-most formula must enforce."@x-gmeow-english ;
    gmeow:useWhen "Use when a closed validation boundary permits exactly one or at most one member of a finite predicate group."@x-gmeow-english .

logic:GuardedImplicationConstraint
    a owl:Class ;
    rdfs:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Guarded Implication Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a guarded-implication constraint (P2): a logic:onClass target, a logic:trigger predicate (optionally pinned to a logic:triggerValue), and one or more logic:requires companion predicates. Expands to a canonical logic:Constraint ∀this. C(this) ∧ trigger(this, …) → ∃ companion. Frontend-only authoring shortcut."@x-gmeow-english ;
    skos:example "ex:datedApproval a logic:GuardedImplicationConstraint ; logic:onClass ex:Submission ; logic:trigger ex:approved ; logic:requires ex:approvalDate ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use guarded implication for an unconditional required property or for a trigger whose value needs an open-ended expression."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Name the target class, trigger predicate, optional trigger value, and every companion predicate whose existence the guard requires."@x-gmeow-english ;
    gmeow:useWhen "Use when the presence of a predicate, optionally at one fixed value, conditionally requires companion data."@x-gmeow-english .

logic:DisjunctiveRequirednessConstraint
    a owl:Class ;
    rdfs:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Disjunctive Requiredness Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a disjunctive-requiredness constraint (P3): a logic:onClass target and a set of logic:anyOf predicates, at least one of which is required. Expands to a canonical logic:Constraint ∀this. C(this) → (∃p1 ∨ … ∨ ∃pn). Frontend-only authoring shortcut."@x-gmeow-english ;
    skos:example "ex:contactRoute a logic:DisjunctiveRequirednessConstraint ; logic:onClass ex:Contact ; logic:anyOf ex:email, ex:phone ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use disjunctive requiredness when the alternatives are mutually exclusive; use a choice-group cardinality constraint instead."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Provide one target class and at least two alternative predicates; the compiled condition succeeds when any alternative has a value."@x-gmeow-english ;
    gmeow:useWhen "Use when a focus node must carry at least one of several substitutable properties and may legitimately carry more than one."@x-gmeow-english .

logic:PathValueTypeConstraint
    a owl:Class ;
    rdfs:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Path Value Type Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a path-value type-membership constraint (P4): a logic:onClass target, a logic:valuePath predicate, and a required logic:valueClass. Expands to a canonical logic:Constraint ∀this. C(this) → ∀v. P(this,v) → D(v). Frontend-only authoring shortcut."@x-gmeow-english ;
    skos:example "ex:memberType a logic:PathValueTypeConstraint ; logic:onClass ex:Team ; logic:valuePath ex:member ; logic:valueClass ex:Person ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a path-value type constraint to require that the path exist; it constrains every present value but does not add minimum cardinality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Name the focus class, one value path, and the class every object reached through that path must instantiate."@x-gmeow-english ;
    gmeow:useWhen "Use when all values of one direct predicate must belong to a declared class under closed-world validation."@x-gmeow-english .

logic:CrossNodeConstraint
    a owl:Class ;
    rdfs:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Cross Node Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a cross-node co-occurrence / inequality constraint (P5): a logic:onClass target and two roles (logic:roleA, logic:roleB) that must, per logic:crossMode, either 'co-occur' (be present together) or 'differ' (never bind the same value). Expands to a canonical logic:Constraint whose integrity is the bi-implication (co-occur) or the join + inequality (differ, via the logic:termEqual filter relation). Frontend-only authoring shortcut."@x-gmeow-english ;
    skos:example "ex:reviewRoles a logic:CrossNodeConstraint ; logic:onClass ex:Review ; logic:roleA ex:author ; logic:roleB ex:reviewer ; logic:crossMode \"differ\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a cross-node constraint for independent cardinalities; it compares the presence or values of two named roles on the same focus."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Provide the target class, two role predicates, and either co-occur or differ as the comparison mode."@x-gmeow-english ;
    gmeow:useWhen "Use when two roles must appear together or must never resolve to the same value."@x-gmeow-english .

logic:ForbiddenPatternConstraint
    a owl:Class ;
    rdfs:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Forbidden Pattern Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a forbidden-pattern constraint (P7): a logic:onClass target and a logic:forbiddenPredicate (optionally pinned to a logic:forbiddenValue). Expands to a canonical logic:Constraint ∀this. C(this) → ¬∃b. forbidden(this,b) (or the pinned-value form ¬ forbidden(this, value)). Frontend-only authoring shortcut."@x-gmeow-english ;
    skos:example "ex:noDeprecatedCode a logic:ForbiddenPatternConstraint ; logic:onClass ex:Submission ; logic:forbiddenPredicate ex:deprecatedCode ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a forbidden pattern to express an open-world negation claim; this is a closed validation prohibition over observed data."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Name the target class and forbidden predicate, adding a fixed forbidden value only when other values on that predicate remain legal."@x-gmeow-english ;
    gmeow:useWhen "Use when a focus must not carry a predicate at all or must exclude one specific predicate value."@x-gmeow-english .

logic:ValueRangeConstraint
    a owl:Class ;
    rdfs:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Value Range Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a numeric value-range constraint (P8): a logic:onClass target, a logic:valuePath predicate, and an inclusive lower (logic:minInclusiveBound) and/or upper (logic:maxInclusiveBound) literal bound every value on that path must satisfy. Expands to a canonical logic:Constraint ∀this,v. C(this) ∧ P(this,v) → min ≤ v ∧ v ≤ max and lowers declaratively to sh:minInclusive/sh:maxInclusive on the target class shape. It is the decidable, validation-only home of a bounded range — NOT an OWL faceted-datatype axiom, which the native reasoner cannot decide once a literal is asserted on the constrained path: it validates and never entails. Frontend-only authoring shortcut."@x-gmeow-english ;
    skos:example "ex:unitInterval a logic:ValueRangeConstraint ; logic:onClass ex:Probability ; logic:valuePath ex:magnitude ; logic:minInclusiveBound 0 ; logic:maxInclusiveBound 1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a value-range constraint for an exclusive endpoint, a string-length or pattern facet, or a comparison between two properties of one focus; those need the string-pattern or comparison forms."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Name the target class, the value path, and at least one inclusive literal bound; the compiled condition flags any value outside the closed interval."@x-gmeow-english ;
    gmeow:useWhen "Use when every numeric value of one direct predicate on a class must lie in a closed interval under closed-world validation."@x-gmeow-english .

logic:StringPatternConstraint
    a owl:Class ;
    rdfs:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "String Pattern Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a per-value string-pattern constraint: a logic:onClass target (optional — omitted, the guard is the value path's own presence), a logic:valuePath predicate, a logic:stringOp mode (regexRequired / regexForbidden / prefixRequired / prefixForbidden), and a literal logic:stringPattern every (or no) value on that path must satisfy. Expands to a canonical logic:Constraint carrying an honest reified FOL integrity using logic:termRegex / logic:termStrStarts, lowered to a sh:SPARQLConstraint — regex is out of the EL/OWL restriction fragment, so this stays procedural rather than a native declarative sh:pattern facet. Frontend-only authoring shortcut."@x-gmeow-english ;
    skos:example "ex:blake3Head a logic:StringPatternConstraint ; logic:onClass ex:Segment ; logic:valuePath ex:headId ; logic:stringOp \"regexRequired\" ; logic:stringPattern \"^blake3:[0-9a-f]{64}$\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it for a numeric bound (use logic:ValueRangeConstraint) or a fixed forbidden value (use logic:ForbiddenPatternConstraint); this is a regex/prefix test over every present value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Name the target class (or omit it for a domain-scoped guard), the value path, the string-op mode, and the literal pattern; the compiled condition flags any value failing the regex or prefix test."@x-gmeow-english ;
    gmeow:useWhen "Use when every (or no) value of one direct predicate must match a regex or share a required/forbidden prefix under closed-world validation — the canonical-identifier and codepoint-pattern idiom."@x-gmeow-english .

logic:UniqueLangConstraint
    a owl:Class ;
    logic:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Unique Language Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a per-property unique-language constraint: a logic:onClass target and a logic:valuePath predicate whose language-tagged literal values must each carry a DISTINCT language tag (no two values on that path share a tag). Expands declaratively to a sh:uniqueLang true property component on the target class node shape; a language-tagged prose predicate localizes at most once per language. Frontend-only authoring shortcut with no ShEx form (the uniqueLang facet is a disclosed ShEx drop)."@x-gmeow-english ;
    skos:example "ex:oneNamePerLang a logic:UniqueLangConstraint ; logic:onClass ex:Place ; logic:valuePath ex:localName ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it to cap total values (that is a cardinality restriction) or to constrain a non-language-tagged predicate; uniqueLang only bites language-tagged literals."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Name the target class and the localizable-prose value path; the derived sh:uniqueLang true flags any focus carrying two values that share a language tag."@x-gmeow-english ;
    gmeow:useWhen "Use when a language-tagged prose predicate on a class must localize at most once per language tag (the localizable-prose convention)."@x-gmeow-english .

logic:AggregateConstraint
    a owl:Class ;
    rdfs:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Aggregate Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for an aggregate-comparison constraint (P6): a logic:onClass target, an aggregate over a path (logic:aggFunction, optional logic:aggDistinct, logic:aggPath), a logic:aggComparator, and a logic:aggCompareTo right-hand side (a compared property IRI, or a literal). Expands to a canonical logic:Constraint carrying both the honest reified FOL integrity and a structured aggregate satellite, lowered to a SELECT $this … GROUP BY $this HAVING(…) sh:SPARQLConstraint. Frontend-only authoring shortcut."@x-gmeow-english ;
    skos:example "ex:minimumMembers a logic:AggregateConstraint ; logic:onClass ex:Team ; logic:aggFunction \"COUNT\" ; logic:aggPath ex:member ; logic:aggComparator \">=\" ; logic:aggCompareTo 2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use an aggregate constraint for a per-value condition that needs no grouping; use the narrower path-value or forbidden-pattern sugar."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Specify the target, aggregate function, path, comparator, and literal or property-valued right-hand side; request DISTINCT only when duplicate values must collapse."@x-gmeow-english ;
    gmeow:useWhen "Use when validity depends on COUNT, SUM, MIN, or MAX over the values reached by one predicate."@x-gmeow-english .

logic:JoinAggregateConstraint
    a owl:Class ;
    logic:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Join Aggregate Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a multi-hop-join product-aggregate constraint (P9): a logic:onClass focus, an ordered logic:joinPath of at least two logic:JoinLeg records (each a reified relation with a logic:legSource / logic:legTarget / logic:legValue predicate and an optional logic:legRecordType), a logic:aggFunction (SUM for ∂²), a logic:aggComparator invariant, and a fixed literal logic:aggThreshold. Each leg hops from an already-bound endpoint through a record to the next endpoint, chaining leg[k].target into leg[k+1].source (the shared join variable); the aggregate is applied to the PRODUCT of the joined leaf values, GROUPED BY the (focus, far-endpoint) tuple, and a violation fires when a group value fails the invariant. It GENERALIZES logic:AggregateConstraint from a single-predicate focus aggregate to a chained-join product aggregate, and is the sanctioned home of the general-CW ∂²=0 conformance check (a SUM of incidence-sign products over composable cells that must equal 0). Expands to a canonical logic:Constraint carrying both the honest reified FOL integrity and a structured join-aggregate satellite, lowered to a SELECT $this ?far … GROUP BY $this ?far HAVING(…) sh:SPARQLConstraint whose join order uses the incidence index and scales with the number of records, never cells². It is not a single-predicate aggregate (use logic:AggregateConstraint), not a derivation rule (a reduce head belongs on logic:aggregateFunction), and not a cartesian product over cells. Frontend-only authoring shortcut."@x-gmeow-english ;
    skos:example "ex:boundarySquareZero a logic:JoinAggregateConstraint ; logic:onClass ex:TopCell ; logic:aggFunction \"SUM\" ; logic:aggComparator \"=\" ; logic:aggThreshold 0 ; logic:joinPath ( [ logic:legRecordType ex:Incidence ; logic:legSource ex:incidenceCoface ; logic:legTarget ex:incidenceFace ; logic:legValue ex:incidenceSign ] [ logic:legRecordType ex:Incidence ; logic:legSource ex:incidenceCoface ; logic:legTarget ex:incidenceFace ; logic:legValue ex:incidenceSign ] ) ; logic:formalizes ex:BoundaryOperator ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a join-aggregate constraint for a single-predicate focus aggregate (use logic:AggregateConstraint) or for a per-value condition that needs no join; and do not use it to derive triples (a reduce head belongs on a logic:Rule)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Name the focus class, an ordered joinPath of two or more JoinLeg records whose target/source predicates chain the endpoints, the aggregate function, the invariant comparator, and the fixed literal threshold; each leg's legValue predicate carries the numeric leaf multiplied into the group product."@x-gmeow-english ;
    gmeow:useWhen "Use when validity depends on an aggregate (typically SUM) of a PRODUCT of leaf values gathered over a multi-hop JOIN and grouped by a pair of endpoints — most canonically the ∂²=0 boundary-composition law of a chain complex."@x-gmeow-english .

logic:JoinLeg
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Join Leg"@x-gmeow-english ;
    skos:definition "One hop (leg) of a logic:JoinAggregateConstraint's logic:joinPath: a reified relation record whose logic:legSource predicate reaches this leg's source endpoint, whose logic:legTarget predicate reaches its target endpoint, and whose logic:legValue predicate carries the numeric leaf value multiplied into the group product; an optional logic:legRecordType types the record for the index-anchored join. The legs are ORDERED (the list order is semantic) and chain leg[k].target into leg[k+1].source, so a leg is a hop specification, not a data record — it names the predicates the projected SPARQL joins on, never an incidence itself."@x-gmeow-english ;
    skos:example "[ logic:legRecordType ex:Incidence ; logic:legSource ex:incidenceCoface ; logic:legTarget ex:incidenceFace ; logic:legValue ex:incidenceSign ]"@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a JoinLeg outside a logic:joinPath list, and do not confuse it with the incidence record it describes: a leg names role/value PREDICATES, not endpoints or signs."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Give each leg exactly one logic:legSource, one logic:legTarget, and one logic:legValue predicate (and optionally one logic:legRecordType class); place the legs in composition order inside the joinPath rdf:List."@x-gmeow-english ;
    gmeow:useWhen "Use as a member of a logic:joinPath to declare one hop of a multi-hop join whose leaf value participates in the group product."@x-gmeow-english .

logic:AggregateBalanceConstraint
    a owl:Class ;
    logic:subClassOf logic:ConstraintSugar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Aggregate Balance Constraint"@x-gmeow-english ;
    skos:definition "Compact sugar for a double-entry balance constraint: a logic:onClass target whose postings (logic:balancePostingPredicate) are partitioned by a partition predicate (logic:balancePartitionPredicate) into a debit side (logic:balanceDebitValue) and a credit side (logic:balanceCreditValue), each posting's numeric amount is read via logic:balanceAmountNodePredicate then logic:balanceValuePredicate, and the group key via logic:balanceAmountNodePredicate then logic:balanceGroupPredicate; within every group the two partition-sums must be EQUAL. Generalizes the single-aggregate logic:AggregateConstraint to a partitioned two-sum equality over a value-key group. Expands to a canonical logic:Constraint carrying an honest reified FOL integrity plus a structured balance satellite, lowered to a SELECT $this … GROUP BY $this ?group HAVING(sumDebits != sumCredits) sh:SPARQLConstraint. Frontend-only authoring shortcut."@x-gmeow-english ;
    skos:example "ex:entryBalances a logic:AggregateBalanceConstraint ; logic:onClass ex:JournalEntry ; logic:balancePostingPredicate ex:posting ; logic:balancePartitionPredicate ex:direction ; logic:balanceDebitValue ex:debit ; logic:balanceCreditValue ex:credit ; logic:balanceAmountNodePredicate ex:amount ; logic:balanceValuePredicate ex:value ; logic:balanceGroupPredicate ex:currency ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it for a single aggregate compared to a constant (that is logic:AggregateConstraint) or when there is no debit/credit partition and per-currency grouping."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Name the target class, the posting predicate, the partition predicate and its two debit/credit values, the amount-node predicate, the numeric-value predicate, and the group-key predicate."@x-gmeow-english ;
    gmeow:useWhen "Use when validity requires that, per group, the sum of debit-partition amounts equals the sum of credit-partition amounts (double-entry bookkeeping)."@x-gmeow-english .

logic:balancePostingPredicate
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "balance posting predicate"@x-gmeow-english ;
    skos:definition "The predicate of a logic:AggregateBalanceConstraint from the focus to each posting aggregated in the balance ($this <posting> ?posting)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:balancePartitionPredicate
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "balance partition predicate"@x-gmeow-english ;
    skos:definition "The predicate of a logic:AggregateBalanceConstraint on a posting whose value selects its partition — the debit side (logic:balanceDebitValue) or the credit side (logic:balanceCreditValue)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:balanceDebitValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "balance debit value"@x-gmeow-english ;
    skos:definition "The logic:balancePartitionPredicate value marking a DEBIT posting in a logic:AggregateBalanceConstraint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:balanceCreditValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "balance credit value"@x-gmeow-english ;
    skos:definition "The logic:balancePartitionPredicate value marking a CREDIT posting in a logic:AggregateBalanceConstraint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:balanceAmountNodePredicate
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "balance amount node predicate"@x-gmeow-english ;
    skos:definition "The predicate of a logic:AggregateBalanceConstraint from a posting to its amount node (?posting <amountNode> ?amount); both the numeric value and the group key hang off this shared amount node, so a value and its group key are always read from the same amount."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:balanceValuePredicate
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "balance value predicate"@x-gmeow-english ;
    skos:definition "The predicate of a logic:AggregateBalanceConstraint from the amount node to its numeric value (?amount <value> ?val), the quantity summed per partition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:balanceGroupPredicate
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "balance group predicate"@x-gmeow-english ;
    skos:definition "The predicate of a logic:AggregateBalanceConstraint from the amount node to the group key (?amount <group> ?group); the balance equality is asserted per group (e.g. per currency)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:balancedByGroup
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "balanced by group"@x-gmeow-english ;
    skos:definition "The reified relation an expanded logic:AggregateBalanceConstraint carries as its honest FOL integrity: balancedByGroup(this, posting, partition, debit, credit, amountNode, value, group). The realized FOL formula core has no aggregate node, so this predication makes the double-entry-balance meaning complete in the FOL canon while the structured satellite drives the real GROUP BY/HAVING SPARQL projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termLangMatches
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term language matches"@x-gmeow-english ;
    skos:definition "A language-tag introspection relation the procedural-constraint SPARQL fragment lowers to a case-insensitive FILTER ( REGEX(LANG(x), 'pattern', 'i') ) over a bound term (rather than a triple pattern). It mirrors logic:termRegex but matches against the value's LANGUAGE TAG rather than its lexical form; it binds nothing, only tests the tag against a literal pattern."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termHasLang
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term has language tag"@x-gmeow-english ;
    skos:definition "A language-tag presence relation the procedural-constraint SPARQL fragment lowers to a unary FILTER ( LANG(x) != \"\" ) over a bound term. The companion to logic:termLangMatches: it restricts a language-tag check to genuinely tagged literals, so a plain or typed literal is never swept into a tag-pattern violation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
logic:onClass
    a owl:ObjectProperty ;
    rdfs:range owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "on class"@x-gmeow-english ;
    skos:definition "The class parameter of a canonical logic: construct. On compact constraint sugar it names the focus class whose instances the expanded logic:Constraint ranges over (rdf:type(this, C) becomes the range-restricting universal guard); on a qualified logic:Restriction it names the class whose values are counted. The latter use lowers to owl:onClass."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:choicePredicate
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "choice predicate"@x-gmeow-english ;
    skos:definition "A member predicate of a logic:ChoiceGroupConstraint's choice group. Multi-valued (at least two); the ∃-requiredness of each is combined per logic:choiceMode."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:choiceMode
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "choice mode"@x-gmeow-english ;
    skos:definition "The cardinality mode of a logic:ChoiceGroupConstraint: 'exactly-one', 'at-most-one', or 'exactly-one-of-N' (an alias of 'exactly-one')."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:trigger
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "trigger"@x-gmeow-english ;
    skos:definition "The trigger predicate of a logic:GuardedImplicationConstraint: the antecedent condition (optionally pinned to a logic:triggerValue) that, together with the target class, guards the required companion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:triggerValue
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "trigger value"@x-gmeow-english ;
    skos:definition "An optional fixed object value that pins a logic:GuardedImplicationConstraint's trigger to trigger(this, value) rather than the mere presence of the trigger predicate. An IRI or a literal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:requires
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "requires"@x-gmeow-english ;
    skos:definition "A required companion predicate of a logic:GuardedImplicationConstraint: when the guard holds, ∃ a value on this predicate is required. Multi-valued (a conjunction of existentials)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:anyOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "any of"@x-gmeow-english ;
    skos:definition "A member predicate of a logic:DisjunctiveRequirednessConstraint: at least one of the logic:anyOf predicates must have a value on the focus (a disjunction of existentials)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:valuePath
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "value path"@x-gmeow-english ;
    skos:definition "The path predicate of a logic:PathValueTypeConstraint: every value the focus carries on this predicate must be an instance of logic:valueClass."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:valueClass
    a owl:ObjectProperty ;
    rdfs:range owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "value class"@x-gmeow-english ;
    skos:definition "The required value class of a logic:PathValueTypeConstraint: the class every value on logic:valuePath must belong to."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:roleA
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "role A"@x-gmeow-english ;
    skos:definition "The first role predicate of a logic:CrossNodeConstraint (paired with logic:roleB under logic:crossMode)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:roleB
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "role B"@x-gmeow-english ;
    skos:definition "The second role predicate of a logic:CrossNodeConstraint (paired with logic:roleA under logic:crossMode)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:crossMode
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "cross mode"@x-gmeow-english ;
    skos:definition "The mode of a logic:CrossNodeConstraint: 'co-occur' (the two roles must be present together) or 'differ' (the two roles must never bind the same value)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:forbiddenPredicate
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "forbidden predicate"@x-gmeow-english ;
    skos:definition "The forbidden predicate of a logic:ForbiddenPatternConstraint: the focus must carry no value on this predicate (or, when logic:forbiddenValue is present, not that specific value)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:forbiddenValue
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "forbidden value"@x-gmeow-english ;
    skos:definition "An optional fixed object value that narrows a logic:ForbiddenPatternConstraint to forbid only forbiddenPredicate(this, value) rather than any value on the predicate. An IRI or a literal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:minInclusiveBound
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "min inclusive bound"@x-gmeow-english ;
    skos:definition "The inclusive lower literal bound of a logic:ValueRangeConstraint: every value on the constraint's logic:valuePath must be greater than or equal to this literal (projected to sh:minInclusive on the target class shape). At least one of the two inclusive bounds must be present."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:maxInclusiveBound
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "max inclusive bound"@x-gmeow-english ;
    skos:definition "The inclusive upper literal bound of a logic:ValueRangeConstraint: every value on the constraint's logic:valuePath must be less than or equal to this literal (projected to sh:maxInclusive on the target class shape). At least one of the two inclusive bounds must be present."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:aggFunction
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "aggregate (constraint) function"@x-gmeow-english ;
    skos:definition "The aggregate function of a logic:AggregateConstraint (COUNT, SUM, MIN, MAX) applied over logic:aggPath. Distinct from logic:aggregateFunction, which carries a reduce RULE's head aggregation; this drives a constraint's GROUP BY/HAVING violation SELECT."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:aggDistinct
    a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "aggregate distinct"@x-gmeow-english ;
    skos:definition "Whether a logic:AggregateConstraint aggregates over DISTINCT values (COUNT(DISTINCT ?x)). Absent means false."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:aggPath
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "aggregate path"@x-gmeow-english ;
    skos:definition "The predicate a logic:AggregateConstraint aggregates over the focus: the objects of $this <aggPath> ?x are the values logic:aggFunction is applied to."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:aggComparator
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "aggregate comparator"@x-gmeow-english ;
    skos:definition "The relational comparator of a logic:AggregateConstraint's invariant (=, !=, <, <=, >, >=; the Unicode ≠/≤/≥ are accepted). The projected sh:SPARQLConstraint HAVING uses the negation of this operator, because a sh:select returns the VIOLATING focus nodes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:aggCompareTo
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "aggregate compare to"@x-gmeow-english ;
    skos:definition "The right-hand side a logic:AggregateConstraint's aggregate is compared to: an IRI object is a compared PROPERTY of the focus ($this <prop> ?rhs), and a literal is a fixed comparison value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:joinPath
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "join path"@x-gmeow-english ;
    skos:definition "The ordered join specification of a logic:JoinAggregateConstraint: an rdf:List of at least two logic:JoinLeg records whose target/source predicates chain the endpoints (leg[k].target is the shared join variable leg[k+1].source re-binds). The list order is SEMANTIC — it is the composition order of the hops — so a joinPath is a traversal specification, not an unordered set of predicates; a single-element list is not a JOIN and is rejected."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:legRecordType
    a owl:ObjectProperty ;
    rdfs:range owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "leg record type"@x-gmeow-english ;
    skos:definition "The optional class typing the reified relation record a logic:JoinLeg traverses (e.g. an incidence-record class), emitted as an index-anchoring `?record a <Type>` triple in the projected join and a well-formedness guard. Optional: a leg with no logic:legRecordType is bound solely by its role and value predicates. It types the RECORD node, not the endpoints the leg connects."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:legSource
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "leg source predicate"@x-gmeow-english ;
    skos:definition "The predicate from a logic:JoinLeg's record to this leg's SOURCE endpoint (record → from). The first leg's source binds to the focus $this; every later leg's source binds to the preceding leg's logic:legTarget (the shared join variable). It names a role PREDICATE the projected SPARQL anchors the join on, never an endpoint node."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:legTarget
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "leg target predicate"@x-gmeow-english ;
    skos:definition "The predicate from a logic:JoinLeg's record to this leg's TARGET endpoint (record → to). The intermediate legs' targets are aggregated away (summed over); the LAST leg's target is the far endpoint of the (focus, far-endpoint) group key. It names a role PREDICATE the join binds the next endpoint on, never an endpoint node."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:legValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "leg value predicate"@x-gmeow-english ;
    skos:definition "The predicate from a logic:JoinLeg's record to the numeric leaf value multiplied into the group product (record → value). For the ∂² check it is the incidence sign; the projected SPARQL computes the PRODUCT of every leg's leaf value inside the aggregate. It names the value PREDICATE, not the value literal itself."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:aggThreshold
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "aggregate threshold"@x-gmeow-english ;
    skos:definition "The fixed literal value the group aggregate of a logic:JoinAggregateConstraint is tested against under logic:aggComparator (e.g. 0 for ∂²=0). Always a literal: the (focus, far-endpoint) group key already consumes the far endpoint, so unlike logic:aggCompareTo there is no per-focus property right-hand side. The projected sh:SPARQLConstraint HAVING negates the comparator, because a sh:select returns the VIOLATING groups."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termEqual
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term equal"@x-gmeow-english ;
    skos:definition "A comparison relation the procedural-constraint SPARQL fragment lowers to a FILTER ( ?a = ?b ) over two already-bound terms (rather than a triple pattern). Used by the cross-node inequality expansion; it binds nothing, only tests equality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termDistinct
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term distinct"@x-gmeow-english ;
    skos:definition "A comparison relation the procedural-constraint SPARQL fragment lowers to a FILTER ( ?a != ?b ) over two already-bound terms (rather than a triple pattern). The inequality peer of logic:termEqual; it binds nothing, only tests inequality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termIn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term in value set"@x-gmeow-english ;
    skos:definition "The variadic relation used inside a reified logic:Formula to test whether its first term is a member of the remaining finite value-set arguments. The SHACL lowering realizes it as an sh:in list and the procedural SPARQL lowering as FILTER IN; it binds no term and is never interpreted as an RDF membership assertion."@x-gmeow-english ;
    skos:example "ex:membershipGuard logic:termIn ex:status, ex:active, ex:pending ."@x-gmeow-english ;
    skos:scopeNote "Argument order is semantic: the tested term precedes the finite set of permitted values."@x-gmeow-english ;
    gmeow:useWhen "Use inside a reified validation formula for finite set membership."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use as an RDF container-membership or mereological relation."@x-gmeow-english ;
    gmeow:howToUse "Place the tested term first and the allowed constants in the remaining ordered argument carriers."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termRegex
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term regular expression"@x-gmeow-english ;
    skos:definition "The relation used inside a reified logic:Formula to test a term's lexical form against a regular-expression argument. It lowers to SPARQL REGEX and, with an explicit regex-dialect residue, to sh:pattern; it is not an exact-preservation claim because the regex dialects differ."@x-gmeow-english ;
    skos:example "ex:codeGuard logic:termRegex ex:code, \"^[A-Z]{2}$\" ."@x-gmeow-english ;
    skos:scopeNote "Regex syntax and flags remain target-dialect-sensitive projection residue."@x-gmeow-english ;
    gmeow:useWhen "Use when a validation formula tests the lexical form of a bound term."@x-gmeow-english ;
    gmeow:avoidWhen "Do not claim exact preservation across SPARQL and SHACL regex dialects without a dialect proof."@x-gmeow-english ;
    gmeow:howToUse "Supply the tested term and explicit pattern argument, retaining dialect information in the loss ledger."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:directType
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "direct type guard"@x-gmeow-english ;
    skos:definition "A guard-only relation inside a reified constraint formula selecting direct instances of a class while excluding instances reached only through subclasses. It is not a data-triple relation; the SHACL lowering consumes it to build a subclass-excluding sh:SPARQLTarget SELECT."@x-gmeow-english ;
    skos:example "ex:focusGuard logic:directType ex:focus, ex:ReviewedClaim ."@x-gmeow-english ;
    skos:scopeNote "Direct type means an asserted rdf:type at the focus node, excluding subclass-derived membership."@x-gmeow-english ;
    gmeow:useWhen "Use when a constraint must target direct instances rather than the full subclass closure."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use when ordinary entailment-aware class targeting is intended."@x-gmeow-english ;
    gmeow:howToUse "Bind the focus term and class term in the guard so the SHACL projection can emit a SPARQL target."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:sparqlTarget
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "SPARQL target guard"@x-gmeow-english ;
    skos:definition "A guard-only relation inside a reified constraint formula whose second argument carries the SELECT text defining a focus set. It is not a data-triple relation; the SHACL lowering consumes it as a first-class sh:SPARQLTarget and removes the guard from the violation body."@x-gmeow-english ;
    skos:example "ex:focusGuard logic:sparqlTarget ex:focus, \"SELECT ?this WHERE { ?this ex:reviewed true }\" ."@x-gmeow-english ;
    skos:scopeNote "The SELECT text defines focus selection only and is removed from the projected violation condition."@x-gmeow-english ;
    gmeow:useWhen "Use when a constraint's focus set requires a target query rather than a named target class."@x-gmeow-english ;
    gmeow:avoidWhen "Do not embed the violation test itself in this guard."@x-gmeow-english ;
    gmeow:howToUse "Provide a focus variable and SELECT text whose result can be lowered to sh:SPARQLTarget."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:aggregateComparison
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "aggregate comparison"@x-gmeow-english ;
    skos:definition "The reified relation an expanded logic:AggregateConstraint carries as its honest FOL integrity: aggregateComparison(this, function, distinct, path, comparator, rhs). The realized FOL formula core has no aggregate node, so this predication makes the aggregate meaning complete in the FOL canon while the structured satellite drives the real GROUP BY/HAVING SPARQL projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:joinAggregateComparison
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "join aggregate comparison"@x-gmeow-english ;
    skos:definition "The reified relation an expanded logic:JoinAggregateConstraint carries as its honest FOL integrity: joinAggregateComparison(this, function, comparator, threshold). The realized FOL formula core has neither an aggregate nor a join node, so this predication makes the multi-hop-join product-aggregate meaning complete in the FOL canon while the structured join-aggregate satellite (the ordered leg chain) drives the real multi-hop-join GROUP BY/HAVING SPARQL projection. It carries only the scalar core, not the leg chain, which lives in the satellite."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:forall
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:Formula ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "for all"@x-gmeow-english ;
    skos:definition "Relates a universal-quantifier logic:Formula to its body formula. The bound variables are carried by logic:quantifiedVariable; their block order is significant. Universal quantification ranges over individuals in the domain of discourse (the object level stays first-order). It is not iteration over RDF serialization order or a higher-order predicate binder."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:exists
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:Formula ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "exists"@x-gmeow-english ;
    skos:definition "Relates an existential-quantifier logic:Formula to its body formula. The bound variables are carried by logic:quantifiedVariable. Existential witnesses are Skolemized only at the evaluable-lowering layer; the AST node pins the binder and body, not the witness identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:and
    a owl:ObjectProperty ;
    rdfs:domain logic:Formula ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "and"@x-gmeow-english ;
    skos:definition "Relates a conjunction logic:Formula to each of its operand sub-formulae (multi-valued, two or more). Conjunction is commutative and associative, so the canonical identity flattens nested conjunctions and is insensitive to operand order. It is not serial composition of transaction programs, which has state-changing path semantics."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:or
    a owl:ObjectProperty ;
    rdfs:domain logic:Formula ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "or"@x-gmeow-english ;
    skos:definition "Relates a disjunction logic:Formula to each of its operand sub-formulae (multi-valued, two or more). Disjunction is commutative and associative, so the canonical identity flattens nested disjunctions and is insensitive to operand order. It is not a program-choice operator and does not select one branch for execution."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:not
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:Formula ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "not"@x-gmeow-english ;
    skos:definition "Relates a strong-negation logic:Formula to its single negated sub-formula. This is explicit (classical) negation and is kept distinct from negation-as-failure, which is a body-literal flag on a derivation rule (logic:negatedBody): the two are never conflated."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:antecedent
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:Formula ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "antecedent"@x-gmeow-english ;
    skos:definition "Relates a material-implication logic:Formula to its antecedent (the hypothesis). Paired with logic:consequent; the two name the implication's operands explicitly so the ordered, non-commutative reading never depends on serialization order."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:consequent
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:Formula ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "consequent"@x-gmeow-english ;
    skos:definition "Relates a material-implication logic:Formula to its consequent (the conclusion). Paired with logic:antecedent; their presence marks the node as an implication, distinct from the commutative logic:iff."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:iff
    a owl:ObjectProperty ;
    rdfs:domain logic:Formula ;
    rdfs:range logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "if and only if"@x-gmeow-english ;
    skos:definition "Relates a biconditional logic:Formula to each of its two operand sub-formulae. The biconditional is commutative, so the canonical identity is insensitive to which operand is which — unlike the ordered logic:antecedent / logic:consequent of an implication."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:relation
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:Formula ;
    rdfs:range logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "relation"@x-gmeow-english ;
    skos:definition "Relates an atomic-predication logic:Formula to the relation it predicates, over its ordered logic:argument terms. The relation is reified as a logic:Type individual per the HiLog reflection (see logic:instanceOf and logic:orderedType): predicating over a reified relation individual keeps the object level first-order rather than admitting a predicate variable, so no separate relation or predicate class is minted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:functionSymbol
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:FunctionTerm ;
    rdfs:range logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "function symbol"@x-gmeow-english ;
    skos:definition "Relates a logic:FunctionTerm to the single function symbol it applies, over its ordered logic:argument terms. The symbol is reified as a logic:Type individual, exactly mirroring how logic:relation reifies an atomic predication's relation (the HiLog reflection — see logic:instanceOf and logic:orderedType): applying a reified function-symbol individual keeps the object level first-order rather than admitting a function variable, so no separate function-symbol class is minted. Functional: a function term applies exactly one symbol."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:argument
    a owl:ObjectProperty ;
    rdfs:domain logic:ArgumentStructure ;
    rdfs:range logic:TermCarrier ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "argument"@x-gmeow-english ;
    skos:definition "Relates a logic:ArgumentStructure — an atomic-predication logic:Formula (over logic:relation) or a logic:FunctionTerm (over logic:functionSymbol) — to one of its argument term-carriers. The SAME property carries both, so a function term's operands reuse the predication argument machinery. Each carrier fixes its position with logic:termIndex and its value with exactly one term-value property (logic:termIri, logic:termVariable, logic:termLiteral, logic:termSequenceMarker, or logic:termApplication), so a variadic argument list — including sequence markers and nested compound function terms — round-trips with its order and term kinds intact. It is not a direct link to the term value and carries no ordering by triple position."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:quantifiedVariable
    a owl:ObjectProperty ;
    rdfs:domain logic:Formula ;
    rdfs:range logic:TermCarrier ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "quantified variable"@x-gmeow-english ;
    skos:definition "Relates a quantifier logic:Formula to one of its bound-variable term-carriers. Each carrier fixes its position in the binder block with logic:termIndex and its name with logic:termVariable; block order is significant, because bound-variable renaming preserves meaning but reordering a quantifier prefix does not."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termIri
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:TermCarrier ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term IRI"@x-gmeow-english ;
    skos:definition "Carries an IRI-constant term value on an argument term-carrier: the argument is an individual (or a reified relation or type) named by this IRI. One of the four mutually exclusive term-value properties; exactly one is present on each carrier. It is not a variable name, lexical literal, or sequence-marker string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termIndex
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:TermCarrier ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term index"@x-gmeow-english ;
    skos:definition "The zero-based ordinal of a term-carrier within its ordered list — an argument within an atomic predication, or a bound variable within a quantifier block. Fixing position explicitly makes the variadic, order-significant lists round-trip independent of RDF statement order. It is not an RDF statement position, which has no graph semantics."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termVariable
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:TermCarrier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term variable"@x-gmeow-english ;
    skos:definition "Carries a variable term value (the authored variable name, without a sigil) on a term-carrier: a single-term variable, bound by an enclosing quantifier or free. One of the four mutually exclusive term-value properties. It is not an IRI constant or a variadic sequence marker."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termLiteral
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:TermCarrier ;
    rdfs:range rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term literal"@x-gmeow-english ;
    skos:definition "Carries a data-literal term value (its lexical form) on an argument term-carrier; the term's datatype rides on the companion logic:termLiteralDatatype. One of the four mutually exclusive term-value properties. It is not an IRI constant, variable, or datatype declaration by itself."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termLiteralDatatype
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:TermCarrier ;
    rdfs:range rdfs:Datatype ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term literal datatype"@x-gmeow-english ;
    skos:definition "Carries the datatype IRI of a literal term value on an argument term-carrier that also bears logic:termLiteral. Absent for a plain literal. Held separately from the literal so the typed-literal term round-trips losslessly regardless of how an intermediate reader handles literal datatypes. It is not the lexical literal and cannot occur on a non-literal carrier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termSequenceMarker
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:TermCarrier ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term sequence marker"@x-gmeow-english ;
    skos:definition "Carries a sequence-marker term value (the authored marker name) on an argument term-carrier: the argument is a logic:SequenceMarker binding a sequence of terms rather than a single one. One of the five mutually exclusive term-value properties."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:termApplication
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain logic:TermCarrier ;
    rdfs:range logic:FunctionTerm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "term application"@x-gmeow-english ;
    skos:definition "Carries a compound function-term value on an argument term-carrier: the argument is the logic:FunctionTerm this property points at (a function symbol applied to ordered sub-terms), rather than a single atomic value. The fifth of the five mutually exclusive term-value properties; exactly one is present on each carrier. Because a logic:FunctionTerm's own logic:argument carriers may again bear logic:termApplication, a nested compound term round-trips recursively. It is not an IRI constant, variable, literal, or sequence marker — those are single-node values, while this points at a sub-tree."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# The ontology-level well-formedness surface mirrors the Rust frontend's typed checks. The
# choice constraints make constructor/value exclusivity executable in the projected validation
# graph; the paired implications make material implication indivisible; functional-property
# declarations above cap singleton values. Ordered-list uniqueness, contiguity, recursive-cycle
# rejection, and connective arity are checked by the Rust typed-IR parser because they compare a
# whole RDF subgraph rather than one focus property in isolation.

logic:FormulaConstructorConstraint
    a logic:ChoiceGroupConstraint ;
    logic:choiceMode "exactly-one" ;
    logic:choicePredicate logic:and ,
        logic:antecedent ,
        logic:exists ,
        logic:forall ,
        logic:iff ,
        logic:not ,
        logic:or ,
        logic:relation ;
    logic:formalizes logic:Formula ;
    logic:onClass logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Formula Constructor Constraint"@x-gmeow-english ;
    skos:definition "Requires every logic:Formula to select exactly one constructor family: atomic relation, strong negation, conjunction, disjunction, material implication (keyed by logic:antecedent), biconditional, universal quantification, or existential quantification. It does not choose among serialized operands; it prevents one node from having two incompatible logical meanings."@x-gmeow-english ;
    skos:example "A node with both logic:relation and logic:not violates this constraint because it cannot be both an atom and a negation."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use this constraint to limit how many operands a selected constructor carries; arity is a separate typed-IR invariant."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ;
    gmeow:howToUse "Validate every authored formula tree before lowering it; reject a focus node unless exactly one listed constructor predicate is present."@x-gmeow-english ;
    gmeow:useWhen "Use when validating canonical RDF formula trees before parsing, canonicalization, or projection."@x-gmeow-english .

logic:ImplicationConsequentConstraint
    a logic:GuardedImplicationConstraint ;
    logic:formalizes logic:Formula ;
    logic:onClass logic:Formula ;
    logic:requires logic:consequent ;
    logic:trigger logic:antecedent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Implication Consequent Constraint"@x-gmeow-english ;
    skos:definition "Requires a logic:Formula carrying logic:antecedent to carry logic:consequent as the ordered second operand of the same material implication. It is not a rule that derives a consequent; it is a structural integrity condition on the implication node."@x-gmeow-english ;
    skos:example "An implication node with an antecedent atom but no consequent formula violates this constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Do not read the required edge as logical modus ponens; it only completes the serialized constructor."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ;
    gmeow:howToUse "When logic:antecedent is present, require one resource-valued logic:consequent before constructing Formula::Implies."@x-gmeow-english ;
    gmeow:useWhen "Use when validating the ordered pair that encodes material implication."@x-gmeow-english .

logic:ImplicationAntecedentConstraint
    a logic:GuardedImplicationConstraint ;
    logic:formalizes logic:Formula ;
    logic:onClass logic:Formula ;
    logic:requires logic:antecedent ;
    logic:trigger logic:consequent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Implication Antecedent Constraint"@x-gmeow-english ;
    skos:definition "Requires a logic:Formula carrying logic:consequent to carry logic:antecedent as the ordered first operand of the same material implication. It is not an inverse entailment from conclusion to premise; it is the reverse structural completeness check for the serialized pair."@x-gmeow-english ;
    skos:example "A formula node with a consequent formula but no antecedent formula violates this constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use the constraint to infer that a consequent semantically entails its antecedent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ;
    gmeow:howToUse "When logic:consequent is present, require one resource-valued logic:antecedent before constructing Formula::Implies."@x-gmeow-english ;
    gmeow:useWhen "Use with logic:ImplicationConsequentConstraint to validate both halves of an implication."@x-gmeow-english .

logic:TermCarrierValueConstraint
    a logic:ChoiceGroupConstraint ;
    logic:choiceMode "exactly-one" ;
    logic:choicePredicate logic:termApplication ,
        logic:termIri ,
        logic:termLiteral ,
        logic:termSequenceMarker ,
        logic:termVariable ;
    logic:formalizes logic:TermCarrier ;
    logic:onClass logic:TermCarrier ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Term Carrier Value Constraint"@x-gmeow-english ;
    skos:definition "Requires every logic:TermCarrier to carry exactly one term-value kind: IRI, variable, literal, sequence marker, or compound function-term application. It does not constrain the carrier's ordinal; logic:termIndex and list-level contiguity are checked independently."@x-gmeow-english ;
    skos:example "A carrier with both logic:termIri ex:a and logic:termVariable 'a' violates this constraint even though the spellings resemble one another; a carrier with both logic:termApplication and logic:termVariable violates it too."@x-gmeow-english ;
    gmeow:avoidWhen "Do not collapse IRI, variable, literal, sequence-marker, and application values into a shared field; their kinds affect formula meaning."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ;
    gmeow:howToUse "Reject a carrier unless exactly one of the five term-value predicates has exactly one value."@x-gmeow-english ;
    gmeow:useWhen "Use whenever an RDF argument or quantifier-binding carrier is reconstructed as a typed IR term."@x-gmeow-english .

logic:FunctionSymbolConstraint
    a logic:GuardedImplicationConstraint ;
    logic:formalizes logic:FunctionTerm ;
    logic:onClass logic:FunctionTerm ;
    logic:requires logic:functionSymbol ;
    logic:trigger rdf:type ;
    logic:triggerValue logic:FunctionTerm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Function Symbol Constraint"@x-gmeow-english ;
    skos:definition "Requires every declared logic:FunctionTerm to carry a logic:functionSymbol. Paired with the owl:FunctionalProperty declaration on logic:functionSymbol (which caps it at one), it makes a function term bear EXACTLY one reified function symbol. It is not the argument-list check: a function term's operands are separate logic:argument term-carriers."@x-gmeow-english ;
    skos:example "A logic:FunctionTerm with two logic:argument carriers but no logic:functionSymbol violates this constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Do not infer a function symbol from an argument; a symbol-less function term is malformed, not defaulted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ;
    gmeow:howToUse "Require exactly one logic:Type-valued logic:functionSymbol on each function term before constructing Term::App."@x-gmeow-english ;
    gmeow:useWhen "Use when validating a compound function-term node reached through a carrier's logic:termApplication."@x-gmeow-english .

logic:FunctionTermArityConstraint
    a logic:GuardedImplicationConstraint ;
    logic:formalizes logic:FunctionTerm ;
    logic:onClass logic:FunctionTerm ;
    logic:requires logic:argument ;
    logic:trigger rdf:type ;
    logic:triggerValue logic:FunctionTerm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Function Term Arity Constraint"@x-gmeow-english ;
    skos:definition "Requires every declared logic:FunctionTerm to carry at least one logic:argument term-carrier: a nullary application is forbidden, because a 0-ary function symbol is a constant and belongs on a carrier's logic:termIri, so an empty-argument function term would give one constant two spellings. It is not the ordinal check: zero-based uniqueness and contiguity of the argument carriers are verified across all siblings by the typed-IR frontend."@x-gmeow-english ;
    skos:example "A logic:FunctionTerm with a logic:functionSymbol but no logic:argument violates this constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a function term to wrap a constant; carry the constant IRI directly on logic:termIri instead."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ;
    gmeow:howToUse "Require one or more logic:argument carriers on each function term, then validate the sibling index set as 0 through n minus 1."@x-gmeow-english ;
    gmeow:useWhen "Use when validating a compound function-term node reached through a carrier's logic:termApplication."@x-gmeow-english .

logic:ReasoningProgramClauseConstraint
    a logic:GuardedImplicationConstraint ;
    logic:formalizes logic:ReasoningProgram ;
    logic:onClass logic:ReasoningProgram ;
    logic:requires logic:clause ;
    logic:trigger rdf:type ;
    logic:triggerValue logic:ReasoningProgram ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Reasoning Program Clause Constraint"@x-gmeow-english ;
    skos:definition "Requires every declared logic:ReasoningProgram to carry at least one logic:clause. A program with no clauses has nothing to resolve its goal against and is malformed. It is not the query check: the required goal atom is validated separately by logic:ReasoningProgramQueryConstraint."@x-gmeow-english ;
    skos:example "A logic:ReasoningProgram with a logic:programQuery but no logic:clause violates this constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use this constraint to check clause well-formedness; each clause's own logic:Formula constructor-selection constraints apply independently."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ;
    gmeow:howToUse "Require one or more logic:Formula-valued logic:clause edges on each declared reasoning program before constructing its clause set."@x-gmeow-english ;
    gmeow:useWhen "Use when validating an authored logic:ReasoningProgram before compiling it to the native engine's clause set."@x-gmeow-english .

logic:ReasoningProgramQueryConstraint
    a logic:GuardedImplicationConstraint ;
    logic:formalizes logic:ReasoningProgram ;
    logic:onClass logic:ReasoningProgram ;
    logic:requires logic:programQuery ;
    logic:trigger rdf:type ;
    logic:triggerValue logic:ReasoningProgram ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Reasoning Program Query Constraint"@x-gmeow-english ;
    skos:definition "Requires every declared logic:ReasoningProgram to carry a logic:programQuery. Paired with the owl:FunctionalProperty declaration on logic:programQuery (which caps it at one), it makes a program bear EXACTLY one goal atom. It is not the clause-set check: a program's facts and rules are validated separately by logic:ReasoningProgramClauseConstraint."@x-gmeow-english ;
    skos:example "A logic:ReasoningProgram with logic:clause facts but no logic:programQuery violates this constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Do not infer a default goal from the clause set; a query-less program is malformed, not defaulted to some implicit answer atom."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ;
    gmeow:howToUse "Require exactly one logic:Formula-valued logic:programQuery on each declared reasoning program before constructing its goal."@x-gmeow-english ;
    gmeow:useWhen "Use when validating an authored logic:ReasoningProgram before compiling it to the native engine's goal resolution."@x-gmeow-english .

logic:TermCarrierIndexConstraint
    a logic:GuardedImplicationConstraint ;
    logic:formalizes logic:TermCarrier ;
    logic:onClass logic:TermCarrier ;
    logic:requires logic:termIndex ;
    logic:trigger rdf:type ;
    logic:triggerValue logic:TermCarrier ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Term Carrier Index Constraint"@x-gmeow-english ;
    skos:definition "Requires every declared logic:TermCarrier to carry a logic:termIndex. It is not the list-level ordering check: uniqueness and zero-based contiguity are verified across all sibling carriers by the typed-IR frontend."@x-gmeow-english ;
    skos:example "A logic:TermCarrier with logic:termVariable 'x' but no logic:termIndex violates this constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Do not infer an omitted index from RDF statement order, which has no semantic ordering."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ;
    gmeow:howToUse "Require one non-negative integer index on each carrier, then validate the sibling index set as 0 through n minus 1."@x-gmeow-english ;
    gmeow:useWhen "Use when validating ordered argument lists and quantifier binding blocks."@x-gmeow-english .

logic:LiteralDatatypeConstraint
    a logic:GuardedImplicationConstraint ;
    logic:formalizes logic:TermCarrier ;
    logic:onClass logic:TermCarrier ;
    logic:requires logic:termLiteral ;
    logic:trigger logic:termLiteralDatatype ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Literal Datatype Constraint"@x-gmeow-english ;
    skos:definition "Requires a carrier with logic:termLiteralDatatype to carry logic:termLiteral, so a datatype IRI can never float without the lexical literal it types. It does not require a datatype for every literal; absence denotes a plain literal."@x-gmeow-english ;
    skos:example "A carrier with logic:termLiteralDatatype xsd:integer but no logic:termLiteral violates this constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Do not attach logic:termLiteralDatatype to an IRI, variable, or sequence-marker carrier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ;
    gmeow:howToUse "Accept zero or one datatype IRI only on a carrier whose sole value kind is logic:termLiteral."@x-gmeow-english ;
    gmeow:useWhen "Use when reconstructing typed literal terms from their lexical and datatype components."@x-gmeow-english .

# ── Typed-IR exemplar annotation coat ────────────────────────────────────────
# These annotations teach the IR through decisions and executable examples. They are deliberately
# term-specific: no inventory prose and no generic "this term means X" placeholders.

logic:DischargeCondition
    skos:example "Use logic:DischargeFiniteClosure when a completed finite chase makes absence of the forbidden predicate decidable."@x-gmeow-english ;
    gmeow:avoidWhen "Do not claim a discharge condition merely because a search timed out or found no witness."@x-gmeow-english ;
    gmeow:howToUse "Select the narrowest condition the checker actually implements, and retain logic:ObligationUnknown outside that boundary."@x-gmeow-english ;
    gmeow:useWhen "Use to state why a non-entailment or law check can return a conclusive verdict."@x-gmeow-english .

logic:DischargeVerdict
    skos:example "A bounded check that exhausts its declared corpus without deriving the forbidden predicate returns logic:ObligationDischarged."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:ObligationDischarged as a synonym for 'not observed yet'."@x-gmeow-english ;
    gmeow:howToUse "Pair the verdict with the condition and evidence that delimit its conclusiveness."@x-gmeow-english ;
    gmeow:useWhen "Use for the three-way outcome of an executable obligation or lens-law discharge."@x-gmeow-english .

logic:Formula
    skos:example "The tree for every person knows someone is a logic:forall node whose body is a logic:exists node containing a logic:relation atom."@x-gmeow-english ;
    gmeow:avoidWhen "Do not encode a trivially Horn binary fact as a top-level formula; place it in the axiom or rule collection."@x-gmeow-english ;
    gmeow:howToUse "Choose one constructor family, link its sub-formulae, and place every argument or binding in an indexed logic:TermCarrier."@x-gmeow-english ;
    gmeow:useWhen "Use for first-order quantifier or connective structure that cannot live uniquely as a Horn fact or rule."@x-gmeow-english .

logic:FormulaShape
    skos:example "A formula containing logic:or receives logic:Disjunctive in a Horn projection's residue ledger."@x-gmeow-english ;
    gmeow:avoidWhen "Do not treat a formula-shape tag as an evaluation profile or as the formula's truth value."@x-gmeow-english ;
    gmeow:howToUse "Attach every applicable closed-set tag to the projection loss row for the unsupported formula."@x-gmeow-english ;
    gmeow:useWhen "Use to disclose which first-order construct exceeded a target fragment."@x-gmeow-english .

logic:Lens
    skos:example "ex:alignment logic:hasLens ex:roundTripLens . ex:roundTripLens logic:getLeg ex:downProjection ; logic:putLeg ex:upProjection ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not call an unpaired one-way transform a lens or infer put by naively reversing get."@x-gmeow-english ;
    gmeow:howToUse "Provide typed get and put transaction programs, then discharge only the laws their evidence supports."@x-gmeow-english ;
    gmeow:useWhen "Use as the executable bidirectional core of a logic:Correspondence."@x-gmeow-english .

logic:Module
    skos:example "A Common Logic theory named ex:geometry can import ex:orders while remaining in the same epistemic world."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a module IRI as a world, standpoint, provenance agent, or source document."@x-gmeow-english ;
    gmeow:howToUse "Assign statement reifiers with logic:inModule and connect theory dependencies with logic:imports."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve named-theory membership and import structure across Common Logic dialects."@x-gmeow-english .

logic:ModuleContextAxis
    skos:example "One result can be indexed simultaneously by ex:geometry as its module and ex:analystView as its standpoint."@x-gmeow-english ;
    gmeow:avoidWhen "Do not replace the world or standpoint axis with the module axis; the dimensions coexist."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:howToUse "Include this facet when a reasoning contract must preserve theory membership independently of epistemic context."@x-gmeow-english ;
    gmeow:useWhen "Use to declare module membership as one coordinate of the multi-axis context model."@x-gmeow-english .

logic:ProjectionTarget
    skos:example "A contract may request both logic:CanonicalProjection and logic:CommonLogicProjection for one canonical answer."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a projection target to select semantics or suppress unsupported canonical content."@x-gmeow-english ;
    gmeow:howToUse "Name each requested rendering surface and preserve a loss judgment for constructs it cannot express."@x-gmeow-english ;
    gmeow:useWhen "Use to request one or more output renderings from the same reasoning result."@x-gmeow-english .

logic:RelationalCore
    skos:example "A fixed-arity atom lowers to logic:instanceOf plus logic:naryArg0 through logic:naryArg2 before the native chase evaluates it."@x-gmeow-english ;
    gmeow:avoidWhen "Do not force disjunctive or genuinely variadic formula structure into the relational core."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:howToUse "Legalize the Horn-expressible fragment into typed rules and carry every illegal remainder with its preservation judgment."@x-gmeow-english ;
    gmeow:useWhen "Use as the stable logical-to-physical waist for chase, incremental, and semiring execution."@x-gmeow-english .

logic:Rule
    skos:example "A rule can derive ex:ancestor(x,z) from ex:parent(x,y) and ex:ancestor(y,z), with its variables bound positively in the body."@x-gmeow-english ;
    gmeow:avoidWhen "Do not encode disjunction, strong negation, or an unstratified negative cycle as a Horn rule."@x-gmeow-english ;
    gmeow:howToUse "Provide one head, the positive and optional stratified-negative body atoms, and any explicit guards or aggregate specification."@x-gmeow-english ;
    gmeow:useWhen "Use for productive Horn, existential-rule, or stratified-negation derivations."@x-gmeow-english .

logic:SequenceMarker
    skos:example "ex:restCarrier logic:termIndex 1 ; logic:termSequenceMarker \"rest\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Do not substitute a sequence marker for an ordinary variable that binds exactly one term."@x-gmeow-english ;
    gmeow:howToUse "Carry the marker name through logic:termSequenceMarker on a single indexed term carrier."@x-gmeow-english ;
    gmeow:useWhen "Use for a genuinely variadic argument sequence that fixed positional predicates cannot represent."@x-gmeow-english .

logic:TermCarrier
    skos:example "An atom's second argument can be represented by a carrier with logic:termIndex 1 and logic:termVariable 'object'."@x-gmeow-english ;
    gmeow:avoidWhen "Do not place two value kinds on one carrier or infer its position from Turtle serialization order."@x-gmeow-english ;
    gmeow:howToUse "Assign one contiguous zero-based index and one of the four exclusive term-value predicates."@x-gmeow-english ;
    gmeow:useWhen "Use for each ordered atom argument and each ordered quantifier binding."@x-gmeow-english .

logic:Type
    skos:example "logic:Kind is reified as a logic:Type so it can classify entity types through logic:instanceOf."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:Type as OWL punning or assume every OWL class participates in the deep-instantiation tower."@x-gmeow-english ;
    gmeow:howToUse "Reify a universal, state its order where needed, and connect its instances through logic:instanceOf."@x-gmeow-english ;
    gmeow:useWhen "Use when a universal must itself be quantified over, classified, or placed at a higher type order."@x-gmeow-english .

logic:and
    skos:example "A conjunction node can link the atoms ex:red(x) and ex:round(x) through two logic:and edges."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:and for serial program composition or with fewer than two operands."@x-gmeow-english ;
    gmeow:howToUse "Link at least two formula operands; canonicalization flattens nested conjunctions and sorts their keys."@x-gmeow-english ;
    gmeow:useWhen "Use when every operand formula must hold at the same logical point."@x-gmeow-english .

logic:antecedent
    skos:example "In person(x) implies mortal(x), the person atom is the sole logic:antecedent."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:antecedent without a paired logic:consequent or as an unordered biconditional operand."@x-gmeow-english ;
    gmeow:howToUse "Place exactly one hypothesis formula on the implication node and pair it with exactly one consequent."@x-gmeow-english ;
    gmeow:useWhen "Use for the ordered hypothesis side of material implication."@x-gmeow-english .

logic:argument
    skos:example "The atom ex:knows(alice,bob) uses carriers at indices 0 and 1 linked through logic:argument."@x-gmeow-english ;
    gmeow:avoidWhen "Do not link a raw term value directly or rely on RDF edge order to recover argument order."@x-gmeow-english ;
    gmeow:howToUse "Link each atomic formula to a logic:TermCarrier whose index set is unique and contiguous from zero."@x-gmeow-english ;
    gmeow:useWhen "Use to supply the ordered terms of a reified atomic predication."@x-gmeow-english .

logic:consequent
    skos:example "In person(x) implies mortal(x), the mortal atom is the sole logic:consequent."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:consequent without a paired logic:antecedent or treat it as a derived rule head."@x-gmeow-english ;
    gmeow:howToUse "Place exactly one conclusion formula on the implication node after its exactly one antecedent."@x-gmeow-english ;
    gmeow:useWhen "Use for the ordered conclusion side of material implication."@x-gmeow-english .

logic:exists
    skos:example "An existential node can bind y and point logic:exists to the atom ex:knows(x,y)."@x-gmeow-english ;
    gmeow:avoidWhen "Do not put a Skolem witness on the formula node or omit the indexed bound-variable block."@x-gmeow-english ;
    gmeow:howToUse "Link exactly one body formula and one or more contiguous logic:quantifiedVariable carriers."@x-gmeow-english ;
    gmeow:useWhen "Use when at least one assignment to the bound first-order variables must satisfy the body."@x-gmeow-english .

logic:forall
    skos:example "A universal node can bind x and point logic:forall to person(x) implies mortal(x)."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use an empty binder or read universal quantification as iteration over serialized RDF nodes."@x-gmeow-english ;
    gmeow:howToUse "Link exactly one body and declare every bound variable in a unique contiguous carrier block."@x-gmeow-english ;
    gmeow:useWhen "Use when the body must hold for every assignment to its first-order bound variables."@x-gmeow-english .

logic:iff
    skos:example "A definition can connect triangle(x) and polygonWithThreeSides(x) as the two logic:iff operands."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:iff with other than two operands or when only one implication direction is justified."@x-gmeow-english ;
    gmeow:howToUse "Link exactly two formula operands; canonicalization sorts them because the biconditional is commutative."@x-gmeow-english ;
    gmeow:useWhen "Use when each of two formulae materially implies the other."@x-gmeow-english .

logic:imports
    skos:example "ex:geometry logic:imports ex:orders makes the imported module's sentences visible in ex:geometry."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:imports for file inclusion, provenance, or cross-world accessibility."@x-gmeow-english ;
    gmeow:howToUse "Link the importing logic:Module to the imported module and let the module engine close the import graph."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve Common Logic theory importation."@x-gmeow-english .

logic:inModule
    skos:example "A reified axiom can carry logic:inModule ex:geometry without changing the standpoint under which it holds."@x-gmeow-english ;
    gmeow:avoidWhen "Do not attach logic:inModule as a substitute for source provenance or epistemic perspective."@x-gmeow-english ;
    gmeow:howToUse "Attach the edge to the statement reifier; omit it only for the explicit top-level unnamed module."@x-gmeow-english ;
    gmeow:useWhen "Use to index a sentence by the named theory that owns it."@x-gmeow-english .

logic:instanceOf
    skos:example "ex:Fido logic:instanceOf ex:Dog and ex:Dog logic:instanceOf logic:Kind form two levels of one deep-instantiation chain."@x-gmeow-english ;
    gmeow:avoidWhen "Do not replace ordinary rdf:type indiscriminately or assume distinct names denote distinct instances."@x-gmeow-english ;
    gmeow:howToUse "Relate an individual or reified type to its next-order type and check logic:orderedType coherence where orders are declared."@x-gmeow-english ;
    gmeow:useWhen "Use for first-order HiLog-style instantiation across one or more meta-levels."@x-gmeow-english .

logic:loadBearing
    skos:example "A witness needed to reconstruct a richer source is logic:loadBearing true, while a display hint is false."@x-gmeow-english ;
    gmeow:avoidWhen "Do not mark presentation prose as load-bearing or silently drop an annotation marked true."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set true only when inverse reconstruction or correctness depends on the annotation; otherwise use false or omit it."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish preservation-critical annotations from droppable display metadata."@x-gmeow-english .

logic:naryArg0
    skos:example "The lowering of ex:between(a,b,c) links its tuple reifier to a through logic:naryArg0."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:naryArg0 as an AST carrier or for any position other than zero."@x-gmeow-english ;
    gmeow:howToUse "Emit it with logic:instanceOf on the same content-addressed tuple reifier."@x-gmeow-english ;
    gmeow:useWhen "Use for the first flat-binary argument of a fixed-arity reified atom."@x-gmeow-english .

logic:naryArg1
    skos:example "The lowering of ex:between(a,b,c) links its tuple reifier to b through logic:naryArg1."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:naryArg1 for the first or third tuple position."@x-gmeow-english ;
    gmeow:howToUse "Emit exactly the second positional edge on the same reifier used by logic:naryArg0."@x-gmeow-english ;
    gmeow:useWhen "Use for the second flat-binary argument of a fixed-arity reified atom."@x-gmeow-english .

logic:naryArg2
    skos:example "The lowering of ex:between(a,b,c) links its tuple reifier to c through logic:naryArg2."@x-gmeow-english ;
    gmeow:avoidWhen "Do not emit logic:naryArg2 for a binary atom or reuse it for later positions."@x-gmeow-english ;
    gmeow:howToUse "Emit it only when a third fixed argument exists; extend the closed positional vocabulary for higher fixed arity."@x-gmeow-english ;
    gmeow:useWhen "Use for the third flat-binary argument of a fixed-arity reified atom."@x-gmeow-english .

logic:not
    skos:example "A formula node with logic:not ex:licensed represents the strong negation of the ex:licensed formula."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:not for closed-world negation-as-failure or with more than one operand."@x-gmeow-english ;
    gmeow:howToUse "Link exactly one formula operand and retain strong-negation residue when a target cannot express it."@x-gmeow-english ;
    gmeow:useWhen "Use for explicit classical negation inside the first-order formula tree."@x-gmeow-english .

logic:or
    skos:example "A covering formula can link ex:Cat(x), ex:Dog(x), and ex:Bird(x) through three logic:or edges."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use logic:or for program choice or with fewer than two operands."@x-gmeow-english ;
    gmeow:howToUse "Link at least two formula operands; canonicalization flattens nested disjunctions and sorts their keys."@x-gmeow-english ;
    gmeow:useWhen "Use when at least one operand formula must hold."@x-gmeow-english .

logic:quantifiedVariable
    skos:example "A two-variable quantifier links carriers at indices 0 and 1 with logic:termVariable values 'x' and 'y'."@x-gmeow-english ;
    gmeow:avoidWhen "Do not bind an IRI, literal, sequence marker, duplicate index, or gapped index through this property."@x-gmeow-english ;
    gmeow:howToUse "Link one or more logic:TermCarrier nodes whose sole values are variable names and whose indices are contiguous."@x-gmeow-english ;
    gmeow:useWhen "Use to declare the ordered binding block of logic:forall or logic:exists."@x-gmeow-english .

logic:relation
    skos:example "An atomic formula for ex:knows(alice,bob) carries ex:knows as its sole logic:relation."@x-gmeow-english ;
    gmeow:avoidWhen "Do not put a variable or literal in the relation slot or combine it with a connective constructor on the same formula."@x-gmeow-english ;
    gmeow:howToUse "Provide exactly one reified relation IRI and an ordered, non-empty logic:argument carrier list."@x-gmeow-english ;
    gmeow:useWhen "Use to mark a logic:Formula as an atomic predication."@x-gmeow-english .

logic:termIndex
    skos:example "The object argument of a binary atom uses logic:termIndex 1 after its subject argument at index 0."@x-gmeow-english ;
    gmeow:avoidWhen "Do not repeat an index, leave a gap, use a negative value, or infer position from RDF serialization."@x-gmeow-english ;
    gmeow:howToUse "Assign exactly one non-negative integer per carrier and validate siblings as the contiguous set 0 through n minus 1."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve argument and binder order independently of graph statement order."@x-gmeow-english .

logic:termIri
    skos:example "A constant argument naming ex:Alice is carried as logic:termIri ex:Alice."@x-gmeow-english ;
    gmeow:avoidWhen "Do not store a variable name, lexical literal, or sequence marker in logic:termIri."@x-gmeow-english ;
    gmeow:howToUse "Place exactly one IRI value on a carrier that has no other term-value property."@x-gmeow-english ;
    gmeow:useWhen "Use for an individual, reified type, or reified relation constant in a term position."@x-gmeow-english .

logic:termLiteral
    skos:example "The integer lexical value 42 is carried with logic:termLiteral '42' and logic:termLiteralDatatype xsd:integer."@x-gmeow-english ;
    gmeow:avoidWhen "Do not place an IRI or variable in the literal slot or attach two datatype IRIs."@x-gmeow-english ;
    gmeow:howToUse "Carry exactly one lexical literal and optionally one companion datatype IRI."@x-gmeow-english ;
    gmeow:useWhen "Use for a data literal appearing as an atomic formula argument."@x-gmeow-english .

logic:termLiteralDatatype
    skos:example "A carrier for the lexical value '2026-07-12' can use logic:termLiteralDatatype xsd:date."@x-gmeow-english ;
    gmeow:avoidWhen "Do not attach a datatype without logic:termLiteral or use a literal string in place of the datatype IRI."@x-gmeow-english ;
    gmeow:howToUse "Add at most one datatype IRI to a literal-valued carrier; omit it for a plain literal."@x-gmeow-english ;
    gmeow:useWhen "Use when the literal term's RDF datatype must round-trip explicitly."@x-gmeow-english .

logic:termSequenceMarker
    skos:example "A variadic carrier can use logic:termSequenceMarker 'rest' to bind the remaining argument sequence."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a sequence marker for one ordinary term or combine it with logic:termVariable."@x-gmeow-english ;
    gmeow:howToUse "Place exactly one non-empty marker name on an indexed carrier and disclose variadic residue to fixed-arity targets."@x-gmeow-english ;
    gmeow:useWhen "Use for the Common Logic sequence-variable form in a genuinely variadic atom."@x-gmeow-english .

logic:termVariable
    skos:example "A carrier with logic:termVariable 'person' represents the authored variable name without a question-mark sigil."@x-gmeow-english ;
    gmeow:avoidWhen "Do not include a surface sigil, use an empty name, or combine the variable with another term-value kind."@x-gmeow-english ;
    gmeow:howToUse "Store one non-empty authored name; the canonicalizer resolves bound names through the quantifier environment."@x-gmeow-english ;
    gmeow:useWhen "Use for a bound or free single-term variable in an argument or binder carrier."@x-gmeow-english .

# ── The evaluable n-ary reification vocabulary (flat-binary lowering) ─────────
# A fixed-arity n-ary atom Rel(a₀,…,aₙ) is realized in the binary relational core
# as a conjunction of ordinary binary atoms over a single content-addressed
# reifier node R — the standard n-ary-relations encoding under the HiLog
# reflection: logic:instanceOf(R, Rel) types the tuple by its reified relation
# individual, and each argument sits in a flat positional predicate
# logic:naryArg0 … logic:naryArgN. Unlike the two-level logic:argument /
# logic:termIndex Formula-AST carriers, these are flat binary predicates so every
# reified atom is directly evaluable by the binary chase. The reifier node R is a
# content-addressed IRI (a lowering-boundary artifact, not an authored term); a
# ground n-ary fact and every derivation of it share one R, giving identity and
# provenance parity with a binary derivation.

logic:naryArg0
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "n-ary argument 0"@x-gmeow-english ;
    skos:definition "Relates a reifier node to the term in argument position 0 of the n-ary tuple it reifies. The flat-binary positional predicate the evaluable lowering emits for the first argument of a fixed-arity n-ary atom Rel(a₀,…): logic:naryArg0(R, a₀) beside logic:instanceOf(R, Rel). Directly evaluable in the binary relational core; the zero-based position is fixed in the predicate itself so no separate index carrier is needed. It is not a logic:argument AST-carrier edge."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:naryArg1
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "n-ary argument 1"@x-gmeow-english ;
    skos:definition "Relates a reifier node to the term in argument position 1 of the n-ary tuple it reifies. The flat-binary positional predicate the evaluable lowering emits for the second argument of a fixed-arity n-ary atom; companion to logic:naryArg0. Directly evaluable in the binary relational core. It is not the first position and is not a logic:argument AST-carrier edge."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:naryArg2
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "n-ary argument 2"@x-gmeow-english ;
    skos:definition "Relates a reifier node to the term in argument position 2 of the n-ary tuple it reifies. The flat-binary positional predicate the evaluable lowering emits for the third argument of a fixed-arity n-ary atom; companion to logic:naryArg0 and logic:naryArg1. Directly evaluable in the binary relational core. The enumerated positional predicates run 0 … N for the maximum fixed arity in play (ternary here); a higher arity extends the closed set with the next positional predicate. It is not emitted for a binary atom and is not a logic:argument AST-carrier edge."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── The full-FOL residue shape vocabulary (loss-ledger disclosure) ────────────
# The closed value set a Horn-fragment projection target discloses when it cannot
# carry a logic:Formula: each tag names which first-order construct exceeds the
# Horn+NAF fragment, so the loss ledger states the kind of residue carried-and-
# flagged in the canonical logic: layer rather than emitting an opaque note.

logic:FormulaShape
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Formula Shape"@x-gmeow-english ;
    skos:definition "The closed class of first-order shape tags a Horn-fragment projection target discloses when it cannot represent a logic:Formula. Each individual names one construct that pushes a formula beyond the binary Horn+NAF fragment, so the loss ledger records which constructs were carried-and-flagged in the canonical logic: layer instead of one opaque note. The set is closed — its individuals are logic:Disjunctive, logic:Nested, logic:Quantified, logic:StrongNegation, and logic:Variadic — so a misspelt tag names no declared value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Disjunctive
    a owl:NamedIndividual ,
        logic:FormulaShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Disjunctive"@x-gmeow-english ;
    skos:definition "The residue shape tag for a formula in which a disjunction (logic:or) appears — a choice the single determinate body of a Horn rule cannot express. Disclosed when a Horn-fragment target carries such a formula as flagged unsupported residue."@x-gmeow-english .

logic:Nested
    a owl:NamedIndividual ,
        logic:FormulaShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Nested"@x-gmeow-english ;
    skos:definition "The residue shape tag for a formula that is a connective or quantifier tree rather than a flat predication — it carries logical structure (logic:and, logic:or, logic:not, an implication, logic:iff, or a quantifier) that the flat body of a Horn rule cannot hold. Disclosed when a Horn-fragment target carries such a formula as flagged unsupported residue."@x-gmeow-english .

logic:Quantified
    a owl:NamedIndividual ,
        logic:FormulaShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Quantified"@x-gmeow-english ;
    skos:definition "The residue shape tag for a formula in which an explicit quantifier (logic:forall or logic:exists) appears — quantification nested or alternating beyond the implicit universal closure of a Horn rule. Disclosed when a Horn-fragment target carries such a formula as flagged unsupported residue."@x-gmeow-english .

logic:StrongNegation
    a owl:NamedIndividual ,
        logic:FormulaShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Strong Negation"@x-gmeow-english ;
    skos:definition "The residue shape tag for a formula in which strong (explicit, classical) negation (logic:not) appears — distinct from negation-as-failure, which a Horn rule body already carries. Disclosed when a Horn-fragment target carries such a formula as flagged unsupported residue."@x-gmeow-english .

logic:Variadic
    a owl:NamedIndividual ,
        logic:FormulaShape ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Variadic"@x-gmeow-english ;
    skos:definition "The residue shape tag for an atomic predication whose argument arity is not the binary Horn shape: it carries a logic:SequenceMarker or a non-binary (unary or n-ary) argument list — the generalization beyond the fixed arity-three triple. Disclosed when a Horn-fragment target carries such a formula as flagged unsupported residue."@x-gmeow-english .

# ── The expressiveness-boundary axis (loss-ledger disclosure) ────────────────
# The closed value set naming which logical fragment a defining statement
# inhabits — the machine-readable first-order-vs-second-order axis of the loss
# ledger. Orthogonal to logic:PreservationKind (answer polarity) and to
# logic:FormulaShape (which first-order constructs a Horn target cannot carry):
# some statements (e.g. compactness's "every open cover has a finite subcover")
# genuinely exceed first-order logic altogether, and that boundary is recorded
# here as an honest ledger entry rather than faked as a first-order formula.

logic:ExpressivenessBoundary
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Expressiveness Boundary"@x-gmeow-english ;
    skos:definition "The closed class naming which logical fragment a defining statement inhabits — the machine-readable first-order-vs-second-order axis of the loss ledger, distinct from logic:PreservationKind (answer polarity) and logic:FormulaShape (first-order constructs a Horn target cannot carry). Its individuals are logic:FirstOrder and logic:SecondOrder; the set is closed, so a misspelt value names no declared boundary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:FirstOrder
    a owl:NamedIndividual ,
        logic:ExpressivenessBoundary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "First-Order"@x-gmeow-english ;
    skos:definition "The expressiveness boundary of a defining statement authorable as a first-order logic:Formula (∀/∃ over individuals of the reified signature). First-order mathematical laws — continuity, connectedness, the T0–T4 separation axioms — sit here; the grounding peers author them as logic:Formula objects at this boundary."@x-gmeow-english .

logic:SecondOrder
    a owl:NamedIndividual ,
        logic:ExpressivenessBoundary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Second-Order"@x-gmeow-english ;
    skos:definition "The expressiveness boundary of a defining statement that genuinely exceeds first-order logic — quantification over families/subsets or an appeal to finiteness (e.g. compactness's 'every open cover has a finite subcover'). Not authorable as a logic:Formula; carried in the loss ledger as an honest boundary with logic:preservationKind logic:Unsupported, never as a fake first-order formula."@x-gmeow-english .

logic:expressivenessBoundary
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "expressiveness boundary"@x-gmeow-english ;
    rdfs:range logic:ExpressivenessBoundary ;
    skos:definition "Relates a defining law or a loss-ledger boundary record to the logic:ExpressivenessBoundary its statement inhabits."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:formalizes
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "formalizes"@x-gmeow-english ;
    skos:definition "A bridge annotation from a logic: foundational term to the gmeow: domain concept it formalizes: the central reasoning vocabulary (argumentation semantics, Belnap information states) names the domain construct that mirrors it, so the domain term's documentation can surface the formalization without the domain slice ever asserting a logic: triple. Subject is a logic: term, object a gmeow: term, both stated in prose; an annotation property, never a reasoned axiom, so it carries no DL or EL profile weight."@x-gmeow-english .
vann:preferredNamespacePrefix
    a owl:AnnotationProperty .

vann:preferredNamespaceUri
    a owl:AnnotationProperty .

# ─────────────────────────────────────────────────────────────────────────────
# Foundational class-coverings. Each is a full-FOL logic:Formula disjunction
# ∀x. Whole(x) → (S₁(x) ∨ … ∨ Sₙ(x)); the canonical RDF 1.2 projection carries it
# exact, and the OWL projection lowers it to owl:unionOf (an exhaustive cover). The
# member disjointness is the separate owl:disjointWith axioms, never folded into the
# formula. Governance for each is the logic:FormalizationCandidate block below.
# ─────────────────────────────────────────────────────────────────────────────

# Covering: every gmeow:Entity is one of the four top sortals (Agent, InformationObject,
# PhysicalObject, SocialObject). A non-disjoint cover — the SocialObject ∩ InformationObject
# overlap is preserved, so this projects to owl:unionOf (not owl:disjointUnionOf).
logic:coverEntitySortals
    a logic:Formula ;
    logic:forall logic:coverEntitySortalsBody ;
    logic:quantifiedVariable logic:coverEntitySortalsVar .
logic:coverEntitySortalsVar
    logic:termIndex 0 ;
    logic:termVariable "x" .
logic:coverEntitySortalsBody
    a logic:Formula ;
    logic:antecedent logic:coverEntitySortalsAnte ;
    logic:consequent logic:coverEntitySortalsCons .
logic:coverEntitySortalsAnte
    a logic:Formula ;
    logic:relation gmeow:Entity ;
    logic:argument logic:coverEntitySortalsAnteArg .
logic:coverEntitySortalsAnteArg
    logic:termIndex 0 ;
    logic:termVariable "x" .
logic:coverEntitySortalsCons
    a logic:Formula ;
    logic:or logic:coverEntitySortalsAgent ,
        logic:coverEntitySortalsInfo ,
        logic:coverEntitySortalsPhysical ,
        logic:coverEntitySortalsSocial .
logic:coverEntitySortalsAgent
    a logic:Formula ;
    logic:relation gmeow:Agent ;
    logic:argument logic:coverEntitySortalsAgentArg .
logic:coverEntitySortalsAgentArg
    logic:termIndex 0 ;
    logic:termVariable "x" .
logic:coverEntitySortalsInfo
    a logic:Formula ;
    logic:relation gmeow:InformationObject ;
    logic:argument logic:coverEntitySortalsInfoArg .
logic:coverEntitySortalsInfoArg
    logic:termIndex 0 ;
    logic:termVariable "x" .
logic:coverEntitySortalsPhysical
    a logic:Formula ;
    logic:relation gmeow:PhysicalObject ;
    logic:argument logic:coverEntitySortalsPhysicalArg .
logic:coverEntitySortalsPhysicalArg
    logic:termIndex 0 ;
    logic:termVariable "x" .
logic:coverEntitySortalsSocial
    a logic:Formula ;
    logic:relation gmeow:SocialObject ;
    logic:argument logic:coverEntitySortalsSocialArg .
logic:coverEntitySortalsSocialArg
    logic:termIndex 0 ;
    logic:termVariable "x" .

# Covering: every logic:Object is individuated as exactly one of the three individuation
# kinds (Collection, Quantity, FunctionalComplex). The pairwise disjointness of the three
# is already asserted (their owl:disjointWith axioms); this covering supplies the
# exhaustiveness, completing the individuation partition of Objects. The stereotype
# meta-class partition (Kind/SubKind/Role/Phase/Category/Mixin/Relator) is a DISTINCT,
# meta-level partition owned by the logic:StereotypeCardinality discipline (foundation
# rules); this covering deliberately does not restate it, to avoid double-encoding.
logic:coverObjectIndividuation
    a logic:Formula ;
    logic:forall logic:coverObjectIndividuationBody ;
    logic:quantifiedVariable logic:coverObjectIndividuationVar .
logic:coverObjectIndividuationVar
    logic:termIndex 0 ;
    logic:termVariable "x" .
logic:coverObjectIndividuationBody
    a logic:Formula ;
    logic:antecedent logic:coverObjectIndividuationAnte ;
    logic:consequent logic:coverObjectIndividuationCons .
logic:coverObjectIndividuationAnte
    a logic:Formula ;
    logic:relation logic:Object ;
    logic:argument logic:coverObjectIndividuationAnteArg .
logic:coverObjectIndividuationAnteArg
    logic:termIndex 0 ;
    logic:termVariable "x" .
logic:coverObjectIndividuationCons
    a logic:Formula ;
    logic:or logic:coverObjectIndividuationCollection ,
        logic:coverObjectIndividuationQuantity ,
        logic:coverObjectIndividuationFunctionalComplex .
logic:coverObjectIndividuationCollection
    a logic:Formula ;
    logic:relation logic:Collection ;
    logic:argument logic:coverObjectIndividuationCollectionArg .
logic:coverObjectIndividuationCollectionArg
    logic:termIndex 0 ;
    logic:termVariable "x" .
logic:coverObjectIndividuationQuantity
    a logic:Formula ;
    logic:relation logic:Quantity ;
    logic:argument logic:coverObjectIndividuationQuantityArg .
logic:coverObjectIndividuationQuantityArg
    logic:termIndex 0 ;
    logic:termVariable "x" .
logic:coverObjectIndividuationFunctionalComplex
    a logic:Formula ;
    logic:relation logic:FunctionalComplex ;
    logic:argument logic:coverObjectIndividuationFunctionalComplexArg .
logic:coverObjectIndividuationFunctionalComplexArg
    logic:termIndex 0 ;
    logic:termVariable "x" .

# ─────────────────────────────────────────────────────────────────────────────
# Definitional axioms for the deception / standpoint / falsehood family.
# Four object-level full-FOL logic:Formula definitions, each logic:formalizes-linked
# to the gmeow: prose it encodes and paired with a reviewed logic:FormalizationCandidate
# (harvest back-link + drift-checked source hash). Each formula exceeds the monotone
# Horn+NAF fragment (nested existential, biconditional, strong negation), so it is
# realized ONLY in the OWL / full-FOL projection and disclosed in the loss ledger — the
# native StratifiedNAF chase does NOT enforce it (RiskProjectionOnly, mirroring the
# foundational class coverings). The intent-never-entailed guardrail is unaffected: none of these
# formulas is a productive rule and none carries gmeow:deceptiveIntentClaim, so
# logic:IntentNotFromDeceptionObligation's Arm A (no rule head) stays discharged.
# ─────────────────────────────────────────────────────────────────────────────

# ── Axiom 1: deception ⇒ a divergent held/projected doxastic pair (the gap IS the act) ──
# ∀e. eventType(e, eventTypeDeception) →
#     ∃h,p. heldStandpoint(e,h) ∧ projectedStandpoint(e,p)
#           ∧ DoxasticStandpointClaim(h) ∧ DoxasticStandpointClaim(p)
#           ∧ ¬∃m. (claimModality(h,m) ∧ claimModality(p,m))
# A NECESSARY condition, never a biconditional: a licensed-falsehood projection also has a
# held/projected gap yet is not deception (Axiom 3 carves it out), so the gap is necessary
# but not sufficient for deception.
logic:deceptionHeldProjectedDivergence
    a logic:Formula ;
    logic:formalizes gmeow:eventTypeDeception ;
    logic:forall logic:dhpdBody ;
    logic:quantifiedVariable logic:dhpdVarE .
logic:dhpdVarE
    logic:termIndex 0 ;
    logic:termVariable "e" .
logic:dhpdBody
    a logic:Formula ;
    logic:antecedent logic:dhpdAnte ;
    logic:consequent logic:dhpdCons .
logic:dhpdAnte
    a logic:Formula ;
    logic:relation gmeow:eventType ;
    logic:argument logic:dhpdAnteArgE , logic:dhpdAnteArgKind .
logic:dhpdAnteArgE
    logic:termIndex 0 ;
    logic:termVariable "e" .
logic:dhpdAnteArgKind
    logic:termIndex 1 ;
    logic:termIri gmeow:eventTypeDeception .
logic:dhpdCons
    a logic:Formula ;
    logic:exists logic:dhpdConsBody ;
    logic:quantifiedVariable logic:dhpdVarH , logic:dhpdVarP .
logic:dhpdVarH
    logic:termIndex 0 ;
    logic:termVariable "h" .
logic:dhpdVarP
    logic:termIndex 1 ;
    logic:termVariable "p" .
logic:dhpdConsBody
    a logic:Formula ;
    logic:and logic:dhpdHeld ,
        logic:dhpdProjected ,
        logic:dhpdHeldDox ,
        logic:dhpdProjectedDox ,
        logic:dhpdDivergent .
logic:dhpdHeld
    a logic:Formula ;
    logic:relation gmeow:heldStandpoint ;
    logic:argument logic:dhpdHeldArgE , logic:dhpdHeldArgH .
logic:dhpdHeldArgE
    logic:termIndex 0 ;
    logic:termVariable "e" .
logic:dhpdHeldArgH
    logic:termIndex 1 ;
    logic:termVariable "h" .
logic:dhpdProjected
    a logic:Formula ;
    logic:relation gmeow:projectedStandpoint ;
    logic:argument logic:dhpdProjectedArgE , logic:dhpdProjectedArgP .
logic:dhpdProjectedArgE
    logic:termIndex 0 ;
    logic:termVariable "e" .
logic:dhpdProjectedArgP
    logic:termIndex 1 ;
    logic:termVariable "p" .
logic:dhpdHeldDox
    a logic:Formula ;
    logic:relation gmeow:DoxasticStandpointClaim ;
    logic:argument logic:dhpdHeldDoxArg .
logic:dhpdHeldDoxArg
    logic:termIndex 0 ;
    logic:termVariable "h" .
logic:dhpdProjectedDox
    a logic:Formula ;
    logic:relation gmeow:DoxasticStandpointClaim ;
    logic:argument logic:dhpdProjectedDoxArg .
logic:dhpdProjectedDoxArg
    logic:termIndex 0 ;
    logic:termVariable "p" .
logic:dhpdDivergent
    a logic:Formula ;
    logic:not logic:dhpdShared .
logic:dhpdShared
    a logic:Formula ;
    logic:exists logic:dhpdSharedBody ;
    logic:quantifiedVariable logic:dhpdVarM .
logic:dhpdVarM
    logic:termIndex 0 ;
    logic:termVariable "m" .
logic:dhpdSharedBody
    a logic:Formula ;
    logic:and logic:dhpdHeldModality , logic:dhpdProjectedModality .
logic:dhpdHeldModality
    a logic:Formula ;
    logic:relation gmeow:claimModality ;
    logic:argument logic:dhpdHeldModalityArgH , logic:dhpdHeldModalityArgM .
logic:dhpdHeldModalityArgH
    logic:termIndex 0 ;
    logic:termVariable "h" .
logic:dhpdHeldModalityArgM
    logic:termIndex 1 ;
    logic:termVariable "m" .
logic:dhpdProjectedModality
    a logic:Formula ;
    logic:relation gmeow:claimModality ;
    logic:argument logic:dhpdProjectedModalityArgP , logic:dhpdProjectedModalityArgM .
logic:dhpdProjectedModalityArgP
    logic:termIndex 0 ;
    logic:termVariable "p" .
logic:dhpdProjectedModalityArgM
    logic:termIndex 1 ;
    logic:termVariable "m" .

# ── Axiom 2: falsehood ≡ a necessarily-denying standpoint claim (refuted, no isFalse flag) ──
# ∀c. claimModality(c, gmeow:refuted) ↔
#     (StandpointClaim(c) ∧ claimPolarity(c, gmeow:polarityDeny)
#      ∧ claimModalForce(c, gmeow:modalForceNecessary))
# An EQUIVALENCE definition: "falsehood = refuted StandpointClaim" made formal as the identity
# of the refuted modality with its canonical axis signature □¬ (deny + necessary). Frame-relative
# settled-false, never a global truth verdict — there is no isFalse flag; to be false-in-frame IS
# to hold a claim of this necessarily-denying modality.
logic:falsehoodIsRefutedClaim
    a logic:Formula ;
    logic:formalizes gmeow:refuted ;
    logic:forall logic:firBody ;
    logic:quantifiedVariable logic:firVarC .
logic:firVarC
    logic:termIndex 0 ;
    logic:termVariable "c" .
logic:firBody
    a logic:Formula ;
    logic:iff logic:firRefuted , logic:firSignature .
logic:firRefuted
    a logic:Formula ;
    logic:relation gmeow:claimModality ;
    logic:argument logic:firRefutedArgC , logic:firRefutedArgV .
logic:firRefutedArgC
    logic:termIndex 0 ;
    logic:termVariable "c" .
logic:firRefutedArgV
    logic:termIndex 1 ;
    logic:termIri gmeow:refuted .
logic:firSignature
    a logic:Formula ;
    logic:and logic:firClaim , logic:firPolarity , logic:firForce .
logic:firClaim
    a logic:Formula ;
    logic:relation gmeow:StandpointClaim ;
    logic:argument logic:firClaimArg .
logic:firClaimArg
    logic:termIndex 0 ;
    logic:termVariable "c" .
logic:firPolarity
    a logic:Formula ;
    logic:relation gmeow:claimPolarity ;
    logic:argument logic:firPolarityArgC , logic:firPolarityArgV .
logic:firPolarityArgC
    logic:termIndex 0 ;
    logic:termVariable "c" .
logic:firPolarityArgV
    logic:termIndex 1 ;
    logic:termIri gmeow:polarityDeny .
logic:firForce
    a logic:Formula ;
    logic:relation gmeow:claimModalForce ;
    logic:argument logic:firForceArgC , logic:firForceArgV .
logic:firForceArgC
    logic:termIndex 0 ;
    logic:termVariable "c" .
logic:firForceArgV
    logic:termIndex 1 ;
    logic:termIri gmeow:modalForceNecessary .

# ── Axiom 3: licensed falsehood ⊢ ¬deception (the fiction/satire safety partition) ──
# ∀e,c. (projectedStandpoint(e,c) ∧ claimVeridicality(c, gmeow:veridicalityLicensedFalsehood))
#       → ¬ eventType(e, gmeow:eventTypeDeception)
# The safety property: a socially-licensed non-truth-asserting projection (fiction, satire,
# sarcasm) is NOT deception, even though it too carries a held/projected gap. Composes with
# Axiom 1 to partition the gap into deception vs. licensed non-deception.
logic:licensedFalsehoodNotDeception
    a logic:Formula ;
    logic:formalizes gmeow:veridicalityLicensedFalsehood ;
    logic:forall logic:lfndBody ;
    logic:quantifiedVariable logic:lfndVarE , logic:lfndVarC .
logic:lfndVarE
    logic:termIndex 0 ;
    logic:termVariable "e" .
logic:lfndVarC
    logic:termIndex 1 ;
    logic:termVariable "c" .
logic:lfndBody
    a logic:Formula ;
    logic:antecedent logic:lfndAnte ;
    logic:consequent logic:lfndCons .
logic:lfndAnte
    a logic:Formula ;
    logic:and logic:lfndProjected , logic:lfndVeridicality .
logic:lfndProjected
    a logic:Formula ;
    logic:relation gmeow:projectedStandpoint ;
    logic:argument logic:lfndProjectedArgE , logic:lfndProjectedArgC .
logic:lfndProjectedArgE
    logic:termIndex 0 ;
    logic:termVariable "e" .
logic:lfndProjectedArgC
    logic:termIndex 1 ;
    logic:termVariable "c" .
logic:lfndVeridicality
    a logic:Formula ;
    logic:relation gmeow:claimVeridicality ;
    logic:argument logic:lfndVeridicalityArgC , logic:lfndVeridicalityArgV .
logic:lfndVeridicalityArgC
    logic:termIndex 0 ;
    logic:termVariable "c" .
logic:lfndVeridicalityArgV
    logic:termIndex 1 ;
    logic:termIri gmeow:veridicalityLicensedFalsehood .
logic:lfndCons
    a logic:Formula ;
    logic:not logic:lfndDeception .
logic:lfndDeception
    a logic:Formula ;
    logic:relation gmeow:eventType ;
    logic:argument logic:lfndDeceptionArgE , logic:lfndDeceptionArgKind .
logic:lfndDeceptionArgE
    logic:termIndex 0 ;
    logic:termVariable "e" .
logic:lfndDeceptionArgKind
    logic:termIndex 1 ;
    logic:termIri gmeow:eventTypeDeception .

# ── Axiom 4: the bullshit modality ≡ the truth-indifferent configuration (Frankfurt) ──
# ∀c. claimModality(c, gmeow:bullshit) ↔
#     (StandpointClaim(c) ∧ claimTruthDirectedness(c, gmeow:truthIndifferent))
# An EQUIVALENCE definition: bullshit is the stance held with indifference to truth — neither
# aimed at truth (as a sincere claim) nor at its negation (as a lie). truthIndifferent uniquely
# picks the bullshit modality among the five, so it is definitional, not merely necessary.
logic:bullshitTruthIndifference
    a logic:Formula ;
    logic:formalizes gmeow:bullshit ;
    logic:forall logic:btiBody ;
    logic:quantifiedVariable logic:btiVarC .
logic:btiVarC
    logic:termIndex 0 ;
    logic:termVariable "c" .
logic:btiBody
    a logic:Formula ;
    logic:iff logic:btiBullshit , logic:btiSignature .
logic:btiBullshit
    a logic:Formula ;
    logic:relation gmeow:claimModality ;
    logic:argument logic:btiBullshitArgC , logic:btiBullshitArgV .
logic:btiBullshitArgC
    logic:termIndex 0 ;
    logic:termVariable "c" .
logic:btiBullshitArgV
    logic:termIndex 1 ;
    logic:termIri gmeow:bullshit .
logic:btiSignature
    a logic:Formula ;
    logic:and logic:btiClaim , logic:btiTruth .
logic:btiClaim
    a logic:Formula ;
    logic:relation gmeow:StandpointClaim ;
    logic:argument logic:btiClaimArg .
logic:btiClaimArg
    logic:termIndex 0 ;
    logic:termVariable "c" .
logic:btiTruth
    a logic:Formula ;
    logic:relation gmeow:claimTruthDirectedness ;
    logic:argument logic:btiTruthArgC , logic:btiTruthArgV .
logic:btiTruthArgC
    logic:termIndex 0 ;
    logic:termVariable "c" .
logic:btiTruthArgV
    logic:termIndex 1 ;
    logic:termIri gmeow:truthIndifferent .

# ── Governance: reviewed FormalizationCandidates for the four axioms above ────────────
# Each harvests its axiom from exactly one prose field (logic:candidateSourceField) of the
# gmeow: term it formalizes; logic:candidateSourceHash is the sha256 of that field's
# @x-gmeow-english lexical text, so a later prose edit surfaces as drift under make verify.
# All four are realized in the OWL / full-FOL projection only (RiskProjectionOnly,
# SoundUnderApproximation) and disclosed in the loss ledger — the native monotone chase does
# not enforce a nested-existential, biconditional, or strong-negation head.

logic:cqDeceptionDivergenceHolds
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "deception divergence holds"@x-gmeow-english ;
    skos:definition "The positive competency case the deception-divergence necessary-condition must satisfy: a gmeow:Event of gmeow:eventTypeDeception that carries a gmeow:heldStandpoint and a gmeow:projectedStandpoint — both gmeow:DoxasticStandpointClaims — whose claim modalities differ satisfies the axiom. The held/projected gap is the deceptive act; the well-formed case the formula admits."@x-gmeow-english .
logic:cqDeceptionDivergenceGapRejected
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "deception without a divergent gap is rejected"@x-gmeow-english ;
    skos:definition "The negative countermodel the deception-divergence axiom must respect: a gmeow:Event typed gmeow:eventTypeDeception whose held and projected standpoints coincide (no divergent claim-state) violates the necessary condition in the OWL / full-FOL projection. HONEST SCOPE: the native monotone StratifiedNAF chase does NOT enforce this existential, negation-bearing condition, so the rejection is realized only in the projection and is disclosed in the loss ledger."@x-gmeow-english .
logic:candidateDeceptionHeldProjectedDivergence
    a owl:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "deception is a divergent held/projected gap"@x-gmeow-english ;
    skos:definition "The necessary-condition formalization candidate governing logic:deceptionHeldProjectedDivergence: every gmeow:eventTypeDeception event carries a gmeow:heldStandpoint and a gmeow:projectedStandpoint doxastic claim whose modalities diverge — the gap is the act, not a truth verdict. A necessary, not sufficient, condition (a licensed-falsehood projection also has a gap yet is not deception; see logic:candidateLicensedFalsehoodNotDeception). Realized in the OWL / full-FOL projection (nested existential with strong negation), non-monotone, disclosed in the loss ledger — NOT natively enforced. Harvested from gmeow:eventTypeDeception's skos:definition, so an edit to that prose surfaces as drift. Accepted through review with a positive case (logic:cqDeceptionDivergenceHolds) and a negative countermodel (logic:cqDeceptionDivergenceGapRejected)."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:b8643c1fb0583812f11a418b01244c78af2e5f97edc306479a6ae717dfcec391"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from gmeow:eventTypeDeception's skos:definition, which states that a deception projects a standpoint diverging from the one actually held (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "necessary condition: gmeow:eventTypeDeception ⇒ a divergent held/projected DoxasticStandpointClaim pair"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryNecessaryCondition ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidatePositiveCase logic:cqDeceptionDivergenceHolds ;
    logic:candidateNegativeCase logic:cqDeceptionDivergenceGapRejected ;
    logic:candidateProjectionBehavior logic:SoundUnderApproximation ;
    logic:candidateSemanticRisk logic:RiskProjectionOnly ;
    logic:candidateFormalizes gmeow:eventTypeDeception ;
    logic:candidateSourceField logic:ProseFieldDefinition .

