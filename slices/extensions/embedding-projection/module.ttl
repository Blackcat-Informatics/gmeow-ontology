@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math: <https://blackcatinformatics.ca/math/> .

# =========================================================================== #
# Classes                                                                     #
# =========================================================================== #

gmeow:DeclassificationAct
    a logic:Event ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Declassification Act"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Activity ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:declassifies ;
            owl:someValuesFrom gmeow:EmbeddingProjection ;
        ] ;
    skos:definition "The explicit, reviewable act that ALONE permits an embedding projection's disclosure sensitivity (gmeow:hasSensitivity) to sit below its source pack's — a reified gmeow:Activity, attributed by the EXISTING gmeow:wasGeneratedBy/gmeow:wasDerivedFrom provenance, that records WHO declassified WHAT and on what authority. Sensitivity never drops silently: absent a DeclassificationAct pointing at a projection, a projection inherits (never undercuts) its source's classification (P15). This is a disclosure-control act, NOT a get-leg determinism claim (gmeow:reproducibilityLevel) nor a correspondence-preservation judgment."@x-gmeow-english ;
    skos:example "ex:declass1 a gmeow:DeclassificationAct ; gmeow:declassifies ex:proj1 ; gmeow:wasGeneratedBy ex:reviewInvocation ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid lowering a projection's sensitivity below its source without a DeclassificationAct (silent capability degradation is forbidden — the review is the whole point) and avoid conflating it with regeneration determinism or correspondence preservation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint a gmeow:DeclassificationAct, point it at the projection with gmeow:declassifies, attribute it with the existing gmeow:wasGeneratedBy (the reviewing invocation) and gmeow:wasDerivedFrom (the source classification), and let the projection carry the lowered gmeow:hasSensitivity only in its scope."@x-gmeow-english ;
    gmeow:useWhen "Use to record the explicit human/agent review that authorizes a projection to be disclosed at a lower sensitivity than its source pack — the audit anchor for 'why is this projection public when its source is confidential?'."@x-gmeow-english .

gmeow:DerivedVectorIndex
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Derived Vector Index"@x-gmeow-english ;
    rdfs:subClassOf gmeow:VectorIndex ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:indexOfProjection ;
            owl:someValuesFrom gmeow:EmbeddingProjection ;
        ] ;
    skos:definition "A non-authoritative accelerator built OVER an exact embedding projection (gmeow:indexOfProjection) — a specialization of graphrag's gmeow:VectorIndex whose contents are a regenerable convenience, never a source of truth: the authoritative vectors live in the gmeow:EmbeddingProjection, and the index only speeds retrieval over them. Its approximation profile (gmeow:approximationRecall, gmeow:indexNondeterminism) is recorded so a retrieval's imperfection is auditable, and its build provenance rides the EXISTING gmeow:wasGeneratedBy."@x-gmeow-english ;
    skos:example "ex:idx1 a gmeow:DerivedVectorIndex ; gmeow:indexOfProjection ex:proj1 ; gmeow:indexAlgorithm gmeow:indexAlgorithmHnsw ; gmeow:approximationRecall ex:recall98 ; gmeow:indexNondeterminism true ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the index as authoritative (the projection is the source of truth — the index is a regenerable accelerator) and avoid omitting its approximation metadata when it is an approximate-nearest-neighbour structure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the built accelerator gmeow:DerivedVectorIndex, bind it to its projection with gmeow:indexOfProjection, carry its algorithm/parameters via the existing graphrag gmeow:indexAlgorithm/gmeow:indexParameters, and record its approximation profile with gmeow:approximationRecall and gmeow:indexNondeterminism."@x-gmeow-english ;
    gmeow:useWhen "Use for a retrieval accelerator built over one embedding projection — an ANN or flat index whose non-authoritative, regenerable status and approximation profile must stay explicit."@x-gmeow-english .

gmeow:EmbeddingProjection
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Embedding Projection"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:hasVectorSpaceContract ;
            owl:someValuesFrom gmeow:VectorSpaceContract ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:projectionSource ;
            owl:someValuesFrom gmeow:InformationObject ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:hasSensitivity ;
            owl:someValuesFrom gmeow:SensitivityLevel ;
        ] ;
    skos:definition "A generated, content-addressed, LOSSY pack-level projection over an exact source pack — the .purremb payload treated as first-class ontology content. It AGGREGATES graphrag's per-object gmeow:Embedding rows (via gmeow:aggregatesEmbedding) into one shippable, comparable pack under a single gmeow:VectorSpaceContract; it is deliberately NOT a subclass of gmeow:Embedding (an Embedding is one object's vector; a projection is the pack that gathers many), so the two are non-duplicative. It is lossy because the float payloads live outside the graph by reference (P12) and quantization/pooling discard information; it is content-addressed via the EXISTING gmeow:contentDigest, so 'which exact projection?' is answerable. Its source is bound by gmeow:projectionSource (an artifact carrying gmeow:contentDigest and, when a certified GTS artifact, gmeow:gtsHeadId); its disclosure sensitivity (gmeow:hasSensitivity) may sit below the source's ONLY under an explicit gmeow:DeclassificationAct."@x-gmeow-english ;
    skos:example "ex:proj1 a gmeow:EmbeddingProjection ; gmeow:hasVectorSpaceContract ex:vsc1 ; gmeow:projectionSource ex:pack1 ; gmeow:hasSensitivity gmeow:sensitivityInternal ; gmeow:contentDigest \"blake3:1f0c…\" ; gmeow:aggregatesEmbedding ex:emb1 , ex:emb2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid typing it as a gmeow:Embedding subclass or a single object's vector (it AGGREGATES many rows via gmeow:aggregatesEmbedding — the two constructs are non-duplicative) and avoid asserting a sensitivity below its source's without a gmeow:DeclassificationAct."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the pack gmeow:EmbeddingProjection, bind its comparability contract with gmeow:hasVectorSpaceContract, its source pack with gmeow:projectionSource, its disclosure classification with the existing gmeow:hasSensitivity, aggregate its rows with gmeow:aggregatesEmbedding, content-address it with the existing gmeow:contentDigest, and declare its get-leg determinism with gmeow:reproducibilityLevel."@x-gmeow-english ;
    gmeow:useWhen "Use for a whole embedding pack — the .purremb projection over one exact source pack — that must ship as auditable, content-addressed, sensitivity-guarded ontology content while aggregating (not replacing) graphrag's per-object gmeow:Embedding rows."@x-gmeow-english .

gmeow:NormalizationKind
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Normalization Kind"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An open value vocabulary of vector-normalization strategies applied when a projection is built (e.g. L2 normalization, none) — part of a gmeow:VectorSpaceContract because normalized and un-normalized vectors are not comparable under the same metric. Open like graphrag's gmeow:DistanceMetric/gmeow:IndexAlgorithm: a new strategy joins by minting an individual, never an owl:oneOf closure."@x-gmeow-english ;
    skos:example "ex:normalizationL2 a gmeow:NormalizationKind ; rdfs:label \"L2\"@x-gmeow-english ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a normalization-kind SUBCLASS of a contract (the kind is a value, P9) and avoid closing the vocabulary with owl:oneOf — it is open."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Add a new strategy as a gmeow:NormalizationKind individual with rdfs:label and skos:definition; reference it from a gmeow:VectorSpaceContract via gmeow:normalizationKind."@x-gmeow-english ;
    gmeow:useWhen "Use as the open value vocabulary for the normalization axis of a vector-space contract — the strategies gmeow:normalizationKind draws from; mint a fresh individual for one not seeded."@x-gmeow-english .

gmeow:PoolingKind
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Pooling Kind"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An open value vocabulary of token-to-sequence pooling strategies used to reduce a model's token embeddings to one vector (e.g. mean pooling, CLS-token, max pooling) — part of a gmeow:VectorSpaceContract because two projections that pool differently do not share a vector space even under one model. Open like graphrag's gmeow:DistanceMetric/gmeow:IndexAlgorithm: a new strategy joins by minting an individual, never an owl:oneOf closure."@x-gmeow-english ;
    skos:example "ex:poolingMean a gmeow:PoolingKind ; rdfs:label \"mean\"@x-gmeow-english ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a pooling-kind SUBCLASS of a contract (the kind is a value, P9) and avoid closing the vocabulary with owl:oneOf — it is open."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Add a new strategy as a gmeow:PoolingKind individual with rdfs:label and skos:definition; reference it from a gmeow:VectorSpaceContract via gmeow:poolingKind."@x-gmeow-english ;
    gmeow:useWhen "Use as the open value vocabulary for the pooling axis of a vector-space contract — the strategies gmeow:poolingKind draws from; mint a fresh individual for one not seeded."@x-gmeow-english .

gmeow:SimilarityObservation
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Similarity Observation"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ;
    skos:definition "An operational, ranked-retrieval observation: a PAIRWISE similarity CLAIM between two vectors over one gmeow:VectorSpaceContract under one gmeow:DistanceMetric — explicitly NOT equivalence, NOT entailment, NOT a truth judgment. It is distinct from graphrag's gmeow:retrievalScore (a statement annotation carrying ONE retrieval EVENT's relevance for one retrieved chunk): a SimilarityObservation is a standalone, attributable claim ABOUT two resources' vector proximity, not a per-triple score riding a gmeow:RetrievalEvent — the two are disjoint (see gmeow:SimilarityObservation owl:disjointWith gmeow:RetrievalEvent). Its determinacy is logic:Vague: numeric proximity is a graded, approximation-sensitive claim (the metric, the space, and the index's recall all bear on it), so it is an observation to be weighed, never a crisp fact (logic:Crisp)."@x-gmeow-english ;
    skos:example "ex:sim1 a gmeow:SimilarityObservation ; gmeow:overVectorSpace ex:vsc1 ; gmeow:withMetric gmeow:distanceMetricCosine ; gmeow:similarityScore ex:score091 ; gmeow:queryContext \"nearest neighbours of ex:docA\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading it as equivalence, entailment, or a retrieval-event score (it is a pairwise similarity CLAIM, disjoint from gmeow:RetrievalEvent) and avoid treating its score as crisp — its determinacy is logic:Vague."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint a gmeow:SimilarityObservation, ground its magnitude with gmeow:similarityScore (a math:Quantity), fix the space with gmeow:overVectorSpace and the metric with gmeow:withMetric, and record its query context with gmeow:queryContext; keep it separate from any gmeow:RetrievalEvent, whose per-chunk relevance rides gmeow:retrievalScore instead."@x-gmeow-english ;
    gmeow:useWhen "Use to record a standalone pairwise vector-similarity claim over a fixed vector space and metric — ranked retrieval as an attributable, weighable observation rather than an entailment or a retrieval-event annotation."@x-gmeow-english .

gmeow:VectorSpaceContract
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Vector Space Contract"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:contentDigest ;
            owl:someValuesFrom rdfs:Literal ;
        ] ;
    skos:definition "The complete comparability contract for a vector space: the model (REUSED gmeow:embeddingModel), dimensionality (REUSED gmeow:embeddingDimensions), metric (REUSED gmeow:distanceMetric), tokenizer (gmeow:tokenizerContract), preprocessing (gmeow:preprocessingContract), chunking (gmeow:chunkingContract), pooling (gmeow:poolingKind), normalization (gmeow:normalizationKind), dtype (gmeow:vectorDtype), and quantization (gmeow:quantizationContract) — everything under which two vectors are legitimately comparable. Its IDENTITY is the REUSED gmeow:contentDigest over the full contract: same vector space ⇔ same contract contentDigest. There is no separate vectorSpaceId — the digest IS the identity, so comparability is decidable by hash equality rather than by prose agreement."@x-gmeow-english ;
    skos:example "ex:vsc1 a gmeow:VectorSpaceContract ; gmeow:embeddingModel ex:bgeM3 ; gmeow:embeddingDimensions 1024 ; gmeow:distanceMetric gmeow:distanceMetricCosine ; gmeow:poolingKind ex:poolingMean ; gmeow:normalizationKind ex:normalizationL2 ; gmeow:vectorDtype \"float32\" ; gmeow:contentDigest \"blake3:9ab3…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a separate vectorSpaceId (the REUSED gmeow:contentDigest over the whole contract IS the identity — same space ⇔ same digest) and avoid comparing vectors across two contracts whose digests differ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the contract gmeow:VectorSpaceContract, fill its components (model/dimensions/metric reused from graphrag; tokenizer/preprocessing/chunking/pooling/normalization/dtype/quantization minted here), and content-address the whole with the existing gmeow:contentDigest — that digest is the space's identity and the join key for comparability."@x-gmeow-english ;
    gmeow:useWhen "Use to declare the full set of choices under which two vectors are comparable, identified by one content digest — so 'are these two projections in the same vector space?' reduces to a digest equality check."@x-gmeow-english .

gmeow:VectorTarget
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Vector Target"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:vectorTargetKind ;
            owl:someValuesFrom gmeow:VectorTargetKind ;
        ] ;
    skos:definition "A row→target binding inside an embedding projection: the record that one vector row embeds one exact target resource (gmeow:targetsResource), of a declared kind (gmeow:vectorTargetKind — a term, an RDF 1.2 statement, a document, a chunk, or a summary). It is the auditable link between an opaque vector slot and the ontology resource it stands for, so 'what does row N embed?' is answerable. The RDF 1.2 statement-term case is expressed at the instance layer with native reification, not a bespoke property (see gmeow:targetsResource)."@x-gmeow-english ;
    skos:example "ex:vt1 a gmeow:VectorTarget ; gmeow:vectorTargetKind gmeow:vectorTargetChunk ; gmeow:targetsResource ex:chunk42 ; gmeow:targetOrdinal 42 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using gmeow:targetOrdinal as identity (it is a non-identifying acceleration hint — the target resource is the identity) and avoid a bespoke property for the statement-term case (use native rdf:reifies at the instance layer)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint a gmeow:VectorTarget per vector row, classify it with gmeow:vectorTargetKind, bind its exact target with gmeow:targetsResource (or, for a statement term, an rdf:reifies quoted triple at the instance layer), and optionally carry a row ordinal with gmeow:targetOrdinal as an acceleration hint only."@x-gmeow-english ;
    gmeow:useWhen "Use to bind one vector row in a projection to the exact ontology resource it embeds — the audit record that turns an anonymous vector slot into a resolvable claim about a term, statement, document, chunk, or summary."@x-gmeow-english .

gmeow:VectorTargetKind
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Vector Target Kind"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An open value vocabulary of what a vector row embeds — the kind axis a gmeow:VectorTarget draws from (gmeow:vectorTargetTerm, gmeow:vectorTargetStatement, gmeow:vectorTargetDocument, gmeow:vectorTargetChunk, gmeow:vectorTargetSummary are the seeded individuals). Open like graphrag's gmeow:DistanceMetric/gmeow:IndexAlgorithm: a new target flavour joins by minting an individual, never an owl:oneOf closure."@x-gmeow-english ;
    skos:example "ex:vectorTargetChunk a gmeow:VectorTargetKind ; rdfs:label \"chunk\"@x-gmeow-english ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a target-kind SUBCLASS of gmeow:VectorTarget (the kind is a value, P9) and avoid closing the vocabulary with owl:oneOf — it is open."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Add a new target flavour as a gmeow:VectorTargetKind individual with rdfs:label and skos:definition; reference it from a gmeow:VectorTarget via gmeow:vectorTargetKind."@x-gmeow-english ;
    gmeow:useWhen "Use as the open value vocabulary for the target-flavour axis of a vector row — the kinds (term, statement, document, chunk, summary, …) that gmeow:vectorTargetKind draws from; mint a fresh individual for a flavour not seeded."@x-gmeow-english .

# =========================================================================== #
# Properties                                                                  #
# =========================================================================== #

gmeow:aggregatesEmbedding
    a owl:ObjectProperty ;
    rdfs:domain gmeow:EmbeddingProjection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "aggregates embedding"@x-gmeow-english ;
    rdfs:range gmeow:Embedding ;
    rdfs:subPropertyOf gmeow:hasPart ;
    skos:definition "Relates an embedding projection to one graphrag gmeow:Embedding row it gathers — the WITNESS that a gmeow:EmbeddingProjection is NOT a subclass of gmeow:Embedding but an AGGREGATE over many. Non-functional: a projection aggregates many rows, and one row may be gathered by several projections. This is the non-duplication seam between the pack-level projection here and graphrag's per-object embedding."@x-gmeow-english ;
    skos:example "ex:proj1 gmeow:aggregatesEmbedding ex:emb1 , ex:emb2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating aggregation as subsumption (the projection is not an Embedding — it collects Embeddings) and avoid making it functional; a projection gathers many rows."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert gmeow:aggregatesEmbedding from the projection to each graphrag gmeow:Embedding it packs; the relation, not a subclass edge, is how the projection relates to per-object vectors."@x-gmeow-english ;
    gmeow:useWhen "Use to gather graphrag's per-object gmeow:Embedding rows into a pack-level gmeow:EmbeddingProjection — the aggregation that keeps the two constructs non-duplicative."@x-gmeow-english .

gmeow:approximationRecall
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DerivedVectorIndex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "approximation recall"@x-gmeow-english ;
    rdfs:range math:Quantity ;
    skos:definition "The measured recall of a derived vector index against exact (flat) search over its projection — grounded as a math:Quantity (REUSED from grounding/math) so the accelerator's imperfection is an auditable number, not a marketing claim. A recall below 1 is honest: it says the index may miss true neighbours, which is why the index is a non-authoritative accelerator over the authoritative projection."@x-gmeow-english ;
    skos:example "ex:idx1 gmeow:approximationRecall ex:recall098 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it as a bare float (it is a math:Quantity) and avoid omitting it for an approximate-nearest-neighbour index — its recall is exactly the audit fact that makes the accelerator honest."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Bind gmeow:approximationRecall from a gmeow:DerivedVectorIndex to a math:Quantity carrying the measured recall against exact search over the same projection."@x-gmeow-english ;
    gmeow:useWhen "Use to record how faithfully a derived index reproduces exact search — the number that quantifies a retrieval's approximation error."@x-gmeow-english .

gmeow:chunkingContract
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:VectorSpaceContract ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "chunking contract"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "An opaque, content-addressable reference to the chunking configuration folded into a vector-space contract (a digest or a verbatim config string) — recorded because two projections chunked differently do not compare, even under one model. Its semantics stay in the solver layer (P12); the graph carries the reference that makes the space's identity complete."@x-gmeow-english ;
    skos:example "ex:vsc1 gmeow:chunkingContract \"blake3:c40a…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid unfolding the chunking algorithm's internals into the graph (P12 — carry the digest/config reference, not the implementation) and avoid dropping it from a contract; it is part of the space's identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:chunkingContract on a gmeow:VectorSpaceContract as a digest or verbatim config string; it folds into the contract's gmeow:contentDigest identity."@x-gmeow-english ;
    gmeow:useWhen "Use to pin the chunking configuration a vector space commits to — one of the comparability components a contract's digest covers."@x-gmeow-english .

gmeow:declassifies
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DeclassificationAct ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "declassifies"@x-gmeow-english ;
    rdfs:range gmeow:EmbeddingProjection ;
    skos:definition "Relates a gmeow:DeclassificationAct to the embedding projection whose disclosure sensitivity it authorizes below its source's. Presence of this edge is the ONLY warrant for a projection's gmeow:hasSensitivity to undercut its source pack's classification — no edge, no drop (P15)."@x-gmeow-english ;
    skos:example "ex:declass1 gmeow:declassifies ex:proj1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at anything but a gmeow:EmbeddingProjection and avoid treating a lowered sensitivity as valid without this edge — the act is the audit warrant."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert gmeow:declassifies from a gmeow:DeclassificationAct to the projection it reviews; the reviewing provenance rides the existing gmeow:wasGeneratedBy on the act."@x-gmeow-english ;
    gmeow:useWhen "Use to bind the reviewable declassification act to the exact projection it authorizes for lower-sensitivity disclosure."@x-gmeow-english .

gmeow:hasVectorSpaceContract
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:EmbeddingProjection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "has vector space contract"@x-gmeow-english ;
    rdfs:range gmeow:VectorSpaceContract ;
    skos:definition "The comparability contract a projection's vectors obey. Functional: a single projection commits to exactly one vector space — vectors under two contracts are two projections, never one, because they cannot be compared under one metric."@x-gmeow-english ;
    skos:example "ex:proj1 gmeow:hasVectorSpaceContract ex:vsc1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid binding one projection to two contracts (it is functional — differing spaces are differing projections) and avoid omitting it; a projection without a contract cannot be compared."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one gmeow:hasVectorSpaceContract from a gmeow:EmbeddingProjection to its gmeow:VectorSpaceContract; the contract's gmeow:contentDigest is the join key for cross-projection comparability."@x-gmeow-english ;
    gmeow:useWhen "Use to commit a projection to the single vector space under which its vectors are comparable."@x-gmeow-english .

gmeow:indexNondeterminism
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DerivedVectorIndex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "index nondeterminism"@x-gmeow-english ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a derived index's construction is nondeterministic — true when repeated builds over the same projection can yield structurally different indexes (parallel insertion order, randomized graph construction), so retrievals are not bit-reproducible even at fixed recall. Approximation metadata, alongside gmeow:approximationRecall: it warns that the accelerator, not the authoritative projection, is the source of any run-to-run variance."@x-gmeow-english ;
    skos:example "ex:idx1 gmeow:indexNondeterminism true ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading it as projection nondeterminism (the projection is authoritative and content-addressed — this flags only the accelerator) and avoid omitting it for a randomized-build index."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set gmeow:indexNondeterminism true on a gmeow:DerivedVectorIndex whose build is randomized or order-sensitive; leave it false for an exact/flat structure."@x-gmeow-english ;
    gmeow:useWhen "Use to flag that a derived index's build is nondeterministic — run-to-run retrieval variance traces to the accelerator, never the projection."@x-gmeow-english .

gmeow:indexOfProjection
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:DerivedVectorIndex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "index of projection"@x-gmeow-english ;
    rdfs:range gmeow:EmbeddingProjection ;
    skos:definition "The exact embedding projection a derived index accelerates. Functional: one index is built over exactly one projection — a federated accelerator spanning projections is several gmeow:DerivedVectorIndex individuals, so an index always resolves to the authoritative vectors it indexes."@x-gmeow-english ;
    skos:example "ex:idx1 gmeow:indexOfProjection ex:proj1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid binding one index to two projections (it is functional — a federated index is several individuals) and avoid leaving it unbound; a derived index must resolve to its authoritative projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one gmeow:indexOfProjection from a gmeow:DerivedVectorIndex to the gmeow:EmbeddingProjection it accelerates."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a derived accelerator to the exact projection whose vectors it indexes."@x-gmeow-english .

gmeow:normalizationKind
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:VectorSpaceContract ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "normalization kind"@x-gmeow-english ;
    rdfs:range gmeow:NormalizationKind ;
    skos:definition "The normalization strategy a vector-space contract commits to (open value vocabulary gmeow:NormalizationKind). Functional: a contract fixes one normalization — normalized and un-normalized vectors are not one space."@x-gmeow-english ;
    skos:example "ex:vsc1 gmeow:normalizationKind ex:normalizationL2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid two normalization kinds on one contract (it is functional) and avoid comparing normalized vectors against un-normalized ones under one metric."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point a gmeow:VectorSpaceContract at one gmeow:NormalizationKind individual with gmeow:normalizationKind; it folds into the contract's digest identity."@x-gmeow-english ;
    gmeow:useWhen "Use to fix the normalization component of a vector-space contract."@x-gmeow-english .

gmeow:overVectorSpace
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:SimilarityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "over vector space"@x-gmeow-english ;
    rdfs:range gmeow:VectorSpaceContract ;
    skos:definition "The vector-space contract a similarity observation is stated over. Functional: a similarity claim is meaningful only within one space — a proximity across two contracts is ill-formed, so the observation names exactly one gmeow:VectorSpaceContract."@x-gmeow-english ;
    skos:example "ex:sim1 gmeow:overVectorSpace ex:vsc1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid stating a similarity across two spaces (it is functional — proximity is contract-relative) and avoid omitting the space; a bare similarity number is uninterpretable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one gmeow:overVectorSpace from a gmeow:SimilarityObservation to the gmeow:VectorSpaceContract its vectors share."@x-gmeow-english ;
    gmeow:useWhen "Use to fix the vector space within which a similarity observation's proximity is meaningful."@x-gmeow-english .

gmeow:withMetric
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:SimilarityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "with metric"@x-gmeow-english ;
    rdfs:range gmeow:DistanceMetric ;
    skos:definition "The distance/similarity metric under which a gmeow:SimilarityObservation's proximity was computed — a reuse of graphrag's gmeow:DistanceMetric value vocabulary (gmeow:distanceMetricCosine, gmeow:distanceMetricDotProduct, …). It is the metric the OBSERVATION was stated under, which must match the metric its gmeow:overVectorSpace contract declares via gmeow:distanceMetric; recording it on the observation makes a proximity number self-describing (a cosine 0.9 and a dot-product 0.9 are not the same claim). Functional: one observation, one metric."@x-gmeow-english ;
    skos:example "ex:sim1 gmeow:withMetric gmeow:distanceMetricCosine ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid omitting it (a bare gmeow:similarityScore is uninterpretable without the metric) and avoid stating a metric that disagrees with the observation's gmeow:overVectorSpace contract's gmeow:distanceMetric."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one gmeow:withMetric from a gmeow:SimilarityObservation to a graphrag gmeow:DistanceMetric individual; it names the measure under which the proximity is a logic:Vague graded claim."@x-gmeow-english ;
    gmeow:useWhen "Use to record the metric a similarity proximity was computed under, so the score is self-describing."@x-gmeow-english .

gmeow:poolingKind
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:VectorSpaceContract ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "pooling kind"@x-gmeow-english ;
    rdfs:range gmeow:PoolingKind ;
    skos:definition "The token-to-sequence pooling strategy a vector-space contract commits to (open value vocabulary gmeow:PoolingKind). Functional: a contract fixes one pooling — differently-pooled vectors are not one space even under one model."@x-gmeow-english ;
    skos:example "ex:vsc1 gmeow:poolingKind ex:poolingMean ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid two pooling kinds on one contract (it is functional) and avoid comparing differently-pooled vectors as if they shared a space."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point a gmeow:VectorSpaceContract at one gmeow:PoolingKind individual with gmeow:poolingKind; it folds into the contract's digest identity."@x-gmeow-english ;
    gmeow:useWhen "Use to fix the pooling component of a vector-space contract."@x-gmeow-english .

gmeow:preprocessingContract
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:VectorSpaceContract ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "preprocessing contract"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "An opaque, content-addressable reference to the text-preprocessing configuration folded into a vector-space contract (a digest or verbatim config string) — case-folding, unicode normalization, whitespace handling — recorded because divergent preprocessing yields non-comparable vectors. Semantics stay in the solver layer (P12); the graph carries the reference."@x-gmeow-english ;
    skos:example "ex:vsc1 gmeow:preprocessingContract \"blake3:7d21…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid unfolding the preprocessing pipeline into the graph (P12) and avoid dropping it; it is part of the space's identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:preprocessingContract on a gmeow:VectorSpaceContract as a digest or verbatim config string; it folds into the contract's gmeow:contentDigest identity."@x-gmeow-english ;
    gmeow:useWhen "Use to pin the preprocessing configuration a vector space commits to — one of the comparability components a contract's digest covers."@x-gmeow-english .

gmeow:projectionSource
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:EmbeddingProjection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "projection source"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "The exact source artifact a projection is generated over — an information object carrying the EXISTING gmeow:contentDigest (its byte identity) and, when a certified GTS artifact, the EXISTING gmeow:gtsHeadId (its committed history). Functional: a projection is generated over exactly one source pack, so 'from which exact source?' resolves to one content-addressed artifact. The generation step itself rides the EXISTING gmeow:wasGeneratedBy provenance."@x-gmeow-english ;
    skos:example "ex:proj1 gmeow:projectionSource ex:pack1 . ex:pack1 gmeow:contentDigest \"blake3:aa02…\" ; gmeow:gtsHeadId \"g1t2…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at an uncontent-addressed source (the source must carry gmeow:contentDigest so the projection's provenance is verifiable) and avoid binding one projection to two sources; it is functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one gmeow:projectionSource from a gmeow:EmbeddingProjection to its source information object; rely on that source's existing gmeow:contentDigest and gmeow:gtsHeadId for byte and history identity."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a projection to the exact, content-addressed source pack it was generated over — the provenance anchor for 'which source did these vectors come from?'."@x-gmeow-english .

gmeow:quantizationContract
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:VectorSpaceContract ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "quantization contract"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "An opaque, content-addressable reference to the quantization configuration folded into a vector-space contract (a digest or verbatim config string) — product/scalar quantization, bit-width, calibration set — recorded because quantized vectors compare only under the same scheme, and quantization is a principal source of a projection's lossiness. Semantics stay in the solver layer (P12); the graph carries the reference."@x-gmeow-english ;
    skos:example "ex:vsc1 gmeow:quantizationContract \"blake3:be55…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid unfolding the quantization scheme into the graph (P12) and avoid dropping it; it is part of the space's identity and a driver of lossiness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:quantizationContract on a gmeow:VectorSpaceContract as a digest or verbatim config string; it folds into the contract's gmeow:contentDigest identity."@x-gmeow-english ;
    gmeow:useWhen "Use to pin the quantization configuration a vector space commits to — one of the comparability components a contract's digest covers."@x-gmeow-english .

gmeow:queryContext
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:SimilarityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "query context"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The query context of a similarity observation, recorded verbatim — the retrieval intent, filter, or comparison prompt under which the pairwise proximity was observed. Kept as text (P12) so the observation is interpretable after the fact without re-running the retrieval; distinct from graphrag's gmeow:forQuery, which is a gmeow:RetrievalEvent's query string."@x-gmeow-english ;
    skos:example "ex:sim1 gmeow:queryContext \"nearest neighbours of ex:docA under the internal bookshelf filter\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating it with graphrag's gmeow:forQuery (that is a retrieval EVENT's query; this is a similarity OBSERVATION's context) and avoid encoding structured filters as opaque blobs the graph cannot audit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:queryContext on a gmeow:SimilarityObservation as a verbatim context string; it records the intent under which the proximity was claimed."@x-gmeow-english ;
    gmeow:useWhen "Use to record the retrieval/comparison context a similarity observation was made under — the intent that makes the pairwise claim interpretable."@x-gmeow-english .

gmeow:reproducibilityLevel
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:EmbeddingProjection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "reproducibility level"@x-gmeow-english ;
    rdfs:range gmeow:ReproducibilityLevel ;
    skos:definition "The GET-LEG DETERMINISM of a projection: how faithfully re-running its generation reproduces the SAME vectors — one of gmeow:reproducibleExact (bit-identical on regeneration), gmeow:reproducibleWithinTolerance (identical up to a stated gmeow:reproducibilityTolerance), or gmeow:regenerableOnly (regenerable but not numerically reproducible). This is determinism of the get operation, DISTINCT from correspondence PRESERVATION (a grounding-law judgment about meaning-preserving translation): a projection can be perfectly preserving yet only regenerable, or bit-exact yet make no correspondence claim. A closed value set (owl:oneOf)."@x-gmeow-english ;
    skos:example "ex:proj1 gmeow:reproducibilityLevel gmeow:reproducibleWithinTolerance ; gmeow:reproducibilityTolerance ex:tol1e6 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading it as a correspondence-preservation judgment (this is get-leg determinism, a different axis entirely) and avoid a value outside the closed set gmeow:reproducibleExact/reproducibleWithinTolerance/regenerableOnly."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one gmeow:reproducibilityLevel on a gmeow:EmbeddingProjection from the closed set; when it is gmeow:reproducibleWithinTolerance, also carry gmeow:reproducibilityTolerance."@x-gmeow-english ;
    gmeow:useWhen "Use to declare how deterministically a projection regenerates its vectors — the get-leg determinism axis, orthogonal to correspondence preservation."@x-gmeow-english .

gmeow:reproducibilityTolerance
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:EmbeddingProjection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "reproducibility tolerance"@x-gmeow-english ;
    rdfs:range math:Quantity ;
    skos:definition "The numeric tolerance within which a gmeow:reproducibleWithinTolerance projection reproduces its vectors — grounded as a math:Quantity (REUSED from grounding/math), e.g. a max per-component absolute difference. REQUIRED exactly when gmeow:reproducibilityLevel is gmeow:reproducibleWithinTolerance (see the conditional requiredness axiom): a within-tolerance claim without a stated tolerance is uninterpretable."@x-gmeow-english ;
    skos:example "ex:proj1 gmeow:reproducibilityTolerance ex:tol1e6 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid stating a within-tolerance reproducibility level without this tolerance (the requiredness axiom rejects it) and avoid asserting it as a bare float; it is a math:Quantity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:reproducibilityTolerance as a math:Quantity on any gmeow:EmbeddingProjection whose gmeow:reproducibilityLevel is gmeow:reproducibleWithinTolerance."@x-gmeow-english ;
    gmeow:useWhen "Use to state the numeric bound under which a within-tolerance projection is deemed reproduced — the quantity that makes gmeow:reproducibleWithinTolerance checkable."@x-gmeow-english .

gmeow:similarityScore
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:SimilarityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "similarity score"@x-gmeow-english ;
    rdfs:range math:Quantity ;
    skos:definition "The magnitude of a similarity observation — grounded as a math:Quantity (REUSED from grounding/math) rather than a bare float, so its unit/metric context travels with it. It is the graded value of a PAIRWISE similarity CLAIM whose determinacy is logic:Vague; it is NOT graphrag's gmeow:retrievalScore (a statement annotation on a retrieval-event triple). Grounding the score as a quantity keeps 'how similar, under what metric?' answerable and weighable rather than treated as a crisp fact."@x-gmeow-english ;
    skos:example "ex:sim1 gmeow:similarityScore ex:score091 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it as a bare float (it is a math:Quantity) and avoid conflating it with graphrag's gmeow:retrievalScore, which annotates a retrieval EVENT's per-chunk relevance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Bind gmeow:similarityScore from a gmeow:SimilarityObservation to a math:Quantity; read it as a logic:Vague graded claim under the observation's gmeow:withMetric, never a crisp truth."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the graded magnitude of a pairwise similarity observation as an auditable quantity — the weighable value behind ranked retrieval."@x-gmeow-english .

gmeow:targetOrdinal
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:VectorTarget ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "target ordinal"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The row ordinal of a vector target within its projection — an ACCELERATION HINT ONLY, explicitly NON-IDENTIFYING: a row ordinal never provides semantic identity on its own (the identity is the target resource via gmeow:targetsResource plus the content-addressed projection). Recording it lets a consumer seek directly into the packed vector array without a scan, but two projections may reuse the same ordinal for different targets, so it must never be treated as a key."@x-gmeow-english ;
    skos:example "ex:vt1 gmeow:targetOrdinal 42 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using gmeow:targetOrdinal as identity or a join key (it is non-identifying — the target resource and the projection digest are the identity) and avoid assuming ordinals are stable across projections."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:targetOrdinal on a gmeow:VectorTarget purely as a seek hint into the packed array; resolve identity through gmeow:targetsResource, never the ordinal."@x-gmeow-english ;
    gmeow:useWhen "Use to record a vector row's position for direct array access — an acceleration hint that never stands in for identity."@x-gmeow-english .

gmeow:targetsResource
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:VectorTarget ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "targets resource"@x-gmeow-english ;
    skos:definition "The exact resource a vector row embeds — the IRI of the term, document, chunk, or summary the vector stands for. Its range is intentionally left OPEN (no rdfs:range) so it admits any embeddable resource without leaking one form's typing onto the others. The RDF 1.2 statement-term case (a vector over a reified statement) is NOT expressed with a bespoke property here: bind the gmeow:VectorTarget to the statement's reifier node, e.g. `ex:vt gmeow:targetsResource ex:stmtReifier` where `ex:stmtReifier` reifies the target triple. Authored ontology content uses the base-quad-foldable reification form (an rdf:Statement with rdf:subject/rdf:predicate/rdf:object) rather than a quoted-triple object, because a `<<( s p o )>>` object cannot ride the base-quad fold to gmeow.gts (see slices/core/standpoint and docs/MIGRATING-SHAPES-TO-LOGIC / LOGIC-VALIDATION); the native `rdf:reifies <<( )>>` form remains the runtime/query surface. Functional: one vector row embeds exactly one resource."@x-gmeow-english ;
    skos:example "ex:vt1 gmeow:targetsResource ex:chunk42 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting an rdfs:range on it (the range is left open so it admits terms, documents, chunks, summaries, and statement reifiers alike) and avoid inventing a bespoke statement-target property; point at the statement's reifier node for the statement case."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one gmeow:targetsResource from a gmeow:VectorTarget to the embedded resource; for a statement term, point it at an rdf:reifies quoted triple rather than minting a bespoke property."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a vector row to the exact resource it embeds — leaving the range open so any embeddable IRI, including a reified statement, is admissible."@x-gmeow-english .

gmeow:tokenizerContract
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:VectorSpaceContract ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "tokenizer contract"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "An opaque, content-addressable reference to the tokenizer configuration folded into a vector-space contract (a digest or verbatim config string) — recorded because a different tokenizer changes the vectors and breaks comparability even under one model. Semantics stay in the solver layer (P12); the graph carries the reference that completes the space's identity."@x-gmeow-english ;
    skos:example "ex:vsc1 gmeow:tokenizerContract \"blake3:3e90…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid unfolding the tokenizer's vocabulary/merges into the graph (P12) and avoid dropping it; it is part of the space's identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:tokenizerContract on a gmeow:VectorSpaceContract as a digest or verbatim config string; it folds into the contract's gmeow:contentDigest identity."@x-gmeow-english ;
    gmeow:useWhen "Use to pin the tokenizer configuration a vector space commits to — one of the comparability components a contract's digest covers."@x-gmeow-english .

gmeow:vectorDtype
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:VectorSpaceContract ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "vector dtype"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The element datatype of a projection's vectors as declared by its contract (e.g. \"float32\", \"float16\", \"int8\") — recorded because dtype bears on comparability and lossiness: an int8 space and a float32 space are not the same space. A verbatim string (P12); its numeric semantics stay in the solver layer."@x-gmeow-english ;
    skos:example "ex:vsc1 gmeow:vectorDtype \"float32\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid comparing vectors across differing dtypes as one space and avoid encoding it as anything but a verbatim dtype token."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:vectorDtype on a gmeow:VectorSpaceContract as a dtype token string; it folds into the contract's gmeow:contentDigest identity."@x-gmeow-english ;
    gmeow:useWhen "Use to declare the element datatype a vector space commits to — one of the comparability components a contract's digest covers."@x-gmeow-english .

gmeow:vectorTargetKind
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:VectorTarget ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "vector target kind"@x-gmeow-english ;
    rdfs:range gmeow:VectorTargetKind ;
    skos:definition "The kind of resource a vector target embeds (open value vocabulary gmeow:VectorTargetKind — term, statement, document, chunk, summary). Functional: one target is of one kind. Mirrors graphrag's gmeow:distanceMetric→gmeow:DistanceMetric pattern (a lowercase property naming a value from its CamelCase vocab class)."@x-gmeow-english ;
    skos:example "ex:vt1 gmeow:vectorTargetKind gmeow:vectorTargetChunk ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid two kinds on one target (it is functional) and avoid minting a kind SUBCLASS of gmeow:VectorTarget; the kind is a value (P9)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point a gmeow:VectorTarget at one gmeow:VectorTargetKind individual with gmeow:vectorTargetKind."@x-gmeow-english ;
    gmeow:useWhen "Use to classify what a vector row embeds — the target-flavour axis over the open gmeow:VectorTargetKind vocabulary."@x-gmeow-english .

# =========================================================================== #
# Value-vocabulary individuals (open vocabs) and closed-set members           #
# =========================================================================== #

gmeow:vectorTargetTerm
    a gmeow:VectorTargetKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "term"@x-gmeow-english ;
    skos:definition "A vector row embeds an ontology TERM (a class, property, or individual IRI)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:vectorTargetStatement
    a gmeow:VectorTargetKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "statement"@x-gmeow-english ;
    skos:definition "A vector row embeds an RDF 1.2 STATEMENT — bound at the instance layer via native rdf:reifies over a quoted triple (see gmeow:targetsResource)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:vectorTargetDocument
    a gmeow:VectorTargetKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "document"@x-gmeow-english ;
    skos:definition "A vector row embeds a whole DOCUMENT information object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:vectorTargetChunk
    a gmeow:VectorTargetKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "chunk"@x-gmeow-english ;
    skos:definition "A vector row embeds a retrieval-sized gmeow:Chunk (the graphrag/ai chunk kind)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:vectorTargetSummary
    a gmeow:VectorTargetKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "summary"@x-gmeow-english ;
    skos:definition "A vector row embeds a generated SUMMARY (e.g. a graphrag gmeow:CommunitySummary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:ReproducibilityLevel
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Reproducibility Level"@x-gmeow-english ;
    owl:equivalentClass [ a owl:Class ; owl:oneOf ( gmeow:reproducibleExact gmeow:reproducibleWithinTolerance gmeow:regenerableOnly ) ] ;
    skos:definition "The CLOSED value set of get-leg determinism levels a projection may declare via gmeow:reproducibilityLevel: exactly gmeow:reproducibleExact, gmeow:reproducibleWithinTolerance, and gmeow:regenerableOnly. Closed (owl:oneOf), unlike the OPEN kind vocabularies (gmeow:VectorTargetKind, gmeow:PoolingKind, gmeow:NormalizationKind): determinism admits no further levels."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:reproducibleExact
    a gmeow:ReproducibilityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "reproducible exact"@x-gmeow-english ;
    skos:definition "Get-leg determinism: regenerating the projection yields BIT-IDENTICAL vectors."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:reproducibleWithinTolerance
    a gmeow:ReproducibilityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "reproducible within tolerance"@x-gmeow-english ;
    skos:definition "Get-leg determinism: regenerating the projection yields vectors identical up to a stated gmeow:reproducibilityTolerance (required when this level is asserted)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:regenerableOnly
    a gmeow:ReproducibilityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "regenerable only"@x-gmeow-english ;
    skos:definition "Get-leg determinism: the projection can be regenerated but is NOT numerically reproducible (no bit-identity, no stated tolerance)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gtsProfilePurrEmb
    a gmeow:GTSProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "purremb profile"@x-gmeow-english ;
    skos:definition "The .purremb package profile: a content-addressed embedding-projection pack — its gmeow:VectorSpaceContract, gmeow:VectorTarget bindings, get-leg determinism, and disclosure sensitivity — packaged as auditable GTS ontology content beside the source it projects. The GMEOW dogfood profile for Project Lillith's bookshelf vectors."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

# =========================================================================== #
# Procedural constraints — supporting terms                                   #
# Terms the logic:Constraint ASTs below quantify over: the projection-header  #
# digest/head-id records, the pairwise-comparison endpoints, the disclosure   #
# total order, and the profile-surface container/manifest view.               #
# =========================================================================== #

gmeow:projectionSourceDigest
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:EmbeddingProjection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "projection source digest"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The source-pack content digest RECORDED in a projection's header at build time — the value the projection asserts its source had. It is checked against the resolved gmeow:projectionSource's EXISTING gmeow:contentDigest by gmeow:SourceDigestMatchConstraint: a recorded digest that disagrees with the live source is a HARD FAIL (the projection was built over different bytes than it now points at), never a silent reconciliation."@x-gmeow-english ;
    skos:example "ex:proj1 gmeow:projectionSourceDigest \"blake3:aa02…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating it as the projection's own digest (it records the SOURCE's digest as seen at build) and avoid omitting it on a projection whose provenance must be verifiable against a re-resolved source."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:projectionSourceDigest on a gmeow:EmbeddingProjection as the source digest recorded in its header; gmeow:SourceDigestMatchConstraint compares it to the resolved source's gmeow:contentDigest."@x-gmeow-english ;
    gmeow:useWhen "Use to record, in the projection header, the exact source-pack digest the projection was built over — the value checked for drift against the live source."@x-gmeow-english .

gmeow:projectionSourceGtsHeadId
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:EmbeddingProjection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "projection source GTS head id"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The certified GTS head id a projection PROPAGATES from a certified GTS source — the committed-history anchor carried forward into the projection header. gmeow:GtsHeadIdPropagationConstraint requires that when a gmeow:projectionSource carries the EXISTING gmeow:gtsHeadId, the projection propagates the SAME id here: a certified source's history must travel with its projection, never be dropped."@x-gmeow-english ;
    skos:example "ex:proj1 gmeow:projectionSourceGtsHeadId \"g1t2…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid propagating a head id that differs from the certified source's gmeow:gtsHeadId (the propagation constraint rejects it) and avoid dropping it when the source is a certified GTS artifact."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:projectionSourceGtsHeadId on a gmeow:EmbeddingProjection equal to the certified source's gmeow:gtsHeadId; the propagation constraint checks the equality."@x-gmeow-english ;
    gmeow:useWhen "Use to propagate a certified GTS source's committed-history head id into the projection header so the projection's lineage stays certifiable."@x-gmeow-english .

gmeow:comparesLeft
    a owl:ObjectProperty ;
    rdfs:domain gmeow:SimilarityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "compares left"@x-gmeow-english ;
    rdfs:range gmeow:EmbeddingProjection ;
    skos:definition "The left projection whose vector a pairwise gmeow:SimilarityObservation compares. Together with gmeow:comparesRight it names the two projections a similarity claim is made across; gmeow:CrossSpaceComparisonConstraint uses the pair to demand a justifying correspondence whenever their vector-space contracts differ."@x-gmeow-english ;
    skos:example "ex:sim1 gmeow:comparesLeft ex:projA ; gmeow:comparesRight ex:projB ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it for a within-space single-projection observation (it names the LEFT operand of a pairwise CROSS-projection comparison) and avoid leaving its gmeow:comparesRight partner unset."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert gmeow:comparesLeft from a gmeow:SimilarityObservation to the left gmeow:EmbeddingProjection; pair it with gmeow:comparesRight for the right operand."@x-gmeow-english ;
    gmeow:useWhen "Use to name the left projection of a pairwise similarity observation across two projections."@x-gmeow-english .

gmeow:comparesRight
    a owl:ObjectProperty ;
    rdfs:domain gmeow:SimilarityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "compares right"@x-gmeow-english ;
    rdfs:range gmeow:EmbeddingProjection ;
    skos:definition "The right projection whose vector a pairwise gmeow:SimilarityObservation compares. Together with gmeow:comparesLeft it names the two projections a similarity claim is made across; gmeow:CrossSpaceComparisonConstraint uses the pair to demand a justifying correspondence whenever their vector-space contracts differ."@x-gmeow-english ;
    skos:example "ex:sim1 gmeow:comparesLeft ex:projA ; gmeow:comparesRight ex:projB ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it for a within-space single-projection observation (it names the RIGHT operand of a pairwise CROSS-projection comparison) and avoid leaving its gmeow:comparesLeft partner unset."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert gmeow:comparesRight from a gmeow:SimilarityObservation to the right gmeow:EmbeddingProjection; pair it with gmeow:comparesLeft for the left operand."@x-gmeow-english ;
    gmeow:useWhen "Use to name the right projection of a pairwise similarity observation across two projections."@x-gmeow-english .

gmeow:sensitivityRank
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:SensitivityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "sensitivity rank"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The total-order rank of a REUSED kernel gmeow:SensitivityLevel — a monotone integer where a HIGHER rank is MORE sensitive. It exists so gmeow:SecurityMonotonicityConstraint can compare a projection's disclosure level against its source's numerically (logic:termGreater on the ranks) rather than by prose. It ranks the existing kernel levels; it does not redeclare them."@x-gmeow-english ;
    skos:example "gmeow:sensitivityInternal gmeow:sensitivityRank 1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading a higher rank as LESS sensitive (higher = more sensitive) and avoid minting ranks that break the total order the monotonicity constraint depends on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert gmeow:sensitivityRank on each kernel gmeow:SensitivityLevel individual as an ordered integer; gmeow:SecurityMonotonicityConstraint compares source and projection ranks with logic:termGreater."@x-gmeow-english ;
    gmeow:useWhen "Use to give the kernel sensitivity levels a numeric total order so disclosure monotonicity is a decidable rank comparison."@x-gmeow-english .

# Disclosure total order over the REUSED kernel gmeow:SensitivityLevel individuals
# (higher rank = more sensitive). These are ADDITIVE rank axioms on the existing
# kernel individuals — NOT re-declarations — establishing the order that
# gmeow:SecurityMonotonicityConstraint compares source against projection over.
gmeow:sensitivityPublic gmeow:sensitivityRank 0 .
gmeow:sensitivityInternal gmeow:sensitivityRank 1 .
gmeow:sensitivityConfidential gmeow:sensitivityRank 2 .
gmeow:sensitivityRestricted gmeow:sensitivityRank 3 .
gmeow:sensitivitySensitivePersonal gmeow:sensitivityRank 4 .

gmeow:ProfileSurface
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Profile Surface"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:profileSurfaceOf ;
            owl:someValuesFrom gmeow:EmbeddingProjection ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:profileSurfaceKind ;
            owl:someValuesFrom gmeow:ProfileSurfaceKind ;
        ] ;
    skos:definition "A view of an embedding projection that records the digests of the referents it shares with its siblings — either the container view (gmeow:surfaceContainer, the digests as the packaged .purremb container carries them) or the sidecar-manifest view (gmeow:surfaceManifest, the digests as the accompanying manifest declares them). The two views of one projection MUST agree on the source-pack, model-contract, and target-table digests (gmeow:ProfileSourceDigestAgreementConstraint and its siblings); disagreement is a HARD FAIL, never a heuristic reconciliation."@x-gmeow-english ;
    skos:example "ex:sc1 a gmeow:ProfileSurface ; gmeow:profileSurfaceOf ex:proj1 ; gmeow:profileSurfaceKind gmeow:surfaceContainer ; gmeow:recordsSourceDigest \"blake3:aa02…\" ; gmeow:recordsModelContractDigest \"blake3:9ab3…\" ; gmeow:recordsTargetTableDigest \"blake3:7d21…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it as the projection itself (it is a digest-recording VIEW of a projection) and avoid letting a container and a manifest surface of one projection disagree on any recorded digest — that is a hard fail."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type each digest-recording view gmeow:ProfileSurface, bind it to its projection with gmeow:profileSurfaceOf, classify it gmeow:surfaceContainer or gmeow:surfaceManifest with gmeow:profileSurfaceKind, and record the three shared-referent digests with gmeow:recordsSourceDigest, gmeow:recordsModelContractDigest, and gmeow:recordsTargetTableDigest."@x-gmeow-english ;
    gmeow:useWhen "Use for the container or sidecar-manifest view of a projection that records the shared-referent digests whose container/manifest agreement the profile-surface constraints enforce."@x-gmeow-english .

gmeow:ProfileSurfaceKind
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "Profile Surface Kind"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The value vocabulary of profile-surface views — gmeow:surfaceContainer (the packaged .purremb container) and gmeow:surfaceManifest (the accompanying sidecar manifest). Modelled like graphrag's gmeow:DistanceMetric: a value class whose members are minted individuals, not subclasses (P9)."@x-gmeow-english ;
    skos:example "gmeow:surfaceContainer a gmeow:ProfileSurfaceKind ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a surface-kind SUBCLASS of gmeow:ProfileSurface (the kind is a value, P9) and avoid conflating the container view with the manifest view — they are the two operands the agreement constraints compare."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference gmeow:surfaceContainer or gmeow:surfaceManifest from a gmeow:ProfileSurface via gmeow:profileSurfaceKind."@x-gmeow-english ;
    gmeow:useWhen "Use as the value axis distinguishing a projection's container view from its sidecar-manifest view."@x-gmeow-english .

gmeow:surfaceContainer
    a gmeow:ProfileSurfaceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "container"@x-gmeow-english ;
    skos:definition "The profile-surface view carried by the packaged .purremb container itself — the digests as the container records them."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:surfaceManifest
    a gmeow:ProfileSurfaceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "manifest"@x-gmeow-english ;
    skos:definition "The profile-surface view carried by the accompanying sidecar manifest — the digests as the manifest declares them, to be checked against the container's."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:profileSurfaceOf
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:ProfileSurface ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "profile surface of"@x-gmeow-english ;
    rdfs:range gmeow:EmbeddingProjection ;
    skos:definition "The embedding projection a profile surface is a view of. Functional: one surface views exactly one projection, so the container and manifest agreement constraints join two surfaces through the single projection they share."@x-gmeow-english ;
    skos:example "ex:sc1 gmeow:profileSurfaceOf ex:proj1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid binding one surface to two projections (it is functional) and avoid leaving it unset; a surface with no projection cannot participate in the agreement check."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert exactly one gmeow:profileSurfaceOf from a gmeow:ProfileSurface to the gmeow:EmbeddingProjection it views."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a profile surface to the projection whose shared-referent digests it records."@x-gmeow-english .

gmeow:profileSurfaceKind
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:ProfileSurface ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "profile surface kind"@x-gmeow-english ;
    rdfs:range gmeow:ProfileSurfaceKind ;
    skos:definition "Which view a profile surface is — gmeow:surfaceContainer or gmeow:surfaceManifest. Functional: a surface is one kind, so the agreement constraints can pick out the container operand and the manifest operand of a projection unambiguously."@x-gmeow-english ;
    skos:example "ex:sc1 gmeow:profileSurfaceKind gmeow:surfaceContainer ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid two kinds on one surface (it is functional) and avoid minting a kind SUBCLASS of gmeow:ProfileSurface; the kind is a value (P9)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point a gmeow:ProfileSurface at one gmeow:ProfileSurfaceKind individual with gmeow:profileSurfaceKind."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a profile surface as the container or the manifest view of its projection."@x-gmeow-english .

gmeow:recordsSourceDigest
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ProfileSurface ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "records source digest"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The source-pack digest a profile surface records for its projection. The container and manifest surfaces of one projection MUST record the same value (gmeow:ProfileSourceDigestAgreementConstraint); a disagreement is a HARD FAIL, never a heuristic reconciliation."@x-gmeow-english ;
    skos:example "ex:sc1 gmeow:recordsSourceDigest \"blake3:aa02…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid letting a container and a manifest surface record differing source digests (the agreement constraint reds it) and avoid omitting it on a surface that must be cross-checked."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:recordsSourceDigest on each gmeow:ProfileSurface; the container and manifest values are compared by gmeow:ProfileSourceDigestAgreementConstraint."@x-gmeow-english ;
    gmeow:useWhen "Use to record, on a profile surface, the source-pack digest whose container/manifest agreement must be enforced."@x-gmeow-english .

gmeow:recordsModelContractDigest
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ProfileSurface ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "records model contract digest"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The model/vector-space-contract digest a profile surface records for its projection. The container and manifest surfaces of one projection MUST record the same value (gmeow:ProfileModelContractAgreementConstraint); a disagreement is a HARD FAIL, never a heuristic reconciliation."@x-gmeow-english ;
    skos:example "ex:sc1 gmeow:recordsModelContractDigest \"blake3:9ab3…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid letting a container and a manifest surface record differing model-contract digests (the agreement constraint reds it) and avoid omitting it on a surface that must be cross-checked."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:recordsModelContractDigest on each gmeow:ProfileSurface; the container and manifest values are compared by gmeow:ProfileModelContractAgreementConstraint."@x-gmeow-english ;
    gmeow:useWhen "Use to record, on a profile surface, the model-contract digest whose container/manifest agreement must be enforced."@x-gmeow-english .

gmeow:recordsTargetTableDigest
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ProfileSurface ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    rdfs:label "records target table digest"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The target-table digest a profile surface records for its projection. The container and manifest surfaces of one projection MUST record the same value (gmeow:ProfileTargetTableAgreementConstraint); a disagreement is a HARD FAIL, never a heuristic reconciliation."@x-gmeow-english ;
    skos:example "ex:sc1 gmeow:recordsTargetTableDigest \"blake3:7d21…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid letting a container and a manifest surface record differing target-table digests (the agreement constraint reds it) and avoid omitting it on a surface that must be cross-checked."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Carry gmeow:recordsTargetTableDigest on each gmeow:ProfileSurface; the container and manifest values are compared by gmeow:ProfileTargetTableAgreementConstraint."@x-gmeow-english ;
    gmeow:useWhen "Use to record, on a profile surface, the target-table digest whose container/manifest agreement must be enforced."@x-gmeow-english .

# =========================================================================== #
# Procedural constraints — declarative requiredness (CT8, DerivedVectorIndex) #
# Purely existence → EL-safe OWL, NOT a procedural logic:Constraint. A derived #
# vector index requires its projection and a measured approximation-recall     #
# quantity (owl:someValuesFrom, projected to sh:minCount by Principle 17).      #
# =========================================================================== #

gmeow:DerivedVectorIndex rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:indexOfProjection ; owl:someValuesFrom gmeow:EmbeddingProjection ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:approximationRecall ; owl:someValuesFrom math:Quantity ] .

# =========================================================================== #
# Procedural constraints — logic:Constraint + logic:Formula ASTs              #
# Guarded closed-world integrity checks (Principle 17). Each logic:formalizes  #
# a generated gmeow:{Name}Shape (the greenfield convention of the deception /   #
# citations constraints: strip "Constraint", append "Shape"). Existence        #
# consequents lower to FILTER NOT EXISTS; the C4 disjunction to a logic:or of   #
# two logic:exists bodies (docs/MIGRATING-SHAPES-TO-LOGIC.md).                  #
# =========================================================================== #

# C1 (CT1): a projection's RECORDED source digest must equal the resolved
# source's live gmeow:contentDigest — else the projection was built over
# different bytes than it now points at.
gmeow:SourceDigestMatchConstraint
    a logic:Constraint ;
    rdfs:label "Source-digest match constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:EmbeddingProjection's recorded gmeow:projectionSourceDigest must equal the gmeow:contentDigest of its resolved gmeow:projectionSource. A mismatch is a HARD FAIL — the projection was built over bytes that differ from the source it now resolves to, so its provenance is invalid; the digests are never silently reconciled."@x-gmeow-english ;
    logic:formalizes gmeow:SourceDigestMatchShape ;
    logic:message "A projection's recorded source digest (gmeow:projectionSourceDigest) must equal the resolved source's gmeow:contentDigest — the projection was built over different bytes than its source now carries." ;
    logic:integrity gmeow:sdmcForall .
gmeow:sdmcForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "src" ] , [ logic:termIndex 2 ; logic:termVariable "d1" ] , [ logic:termIndex 3 ; logic:termVariable "d2" ] ;
    logic:forall gmeow:sdmcImpl .
gmeow:sdmcImpl a logic:Formula ; logic:antecedent gmeow:sdmcGuard ; logic:consequent gmeow:sdmcEq .
gmeow:sdmcGuard a logic:Formula ; logic:and gmeow:sdmcType , gmeow:sdmcRecorded , gmeow:sdmcSource , gmeow:sdmcResolved .
gmeow:sdmcType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termIri gmeow:EmbeddingProjection ] .
gmeow:sdmcRecorded a logic:Formula ; logic:relation gmeow:projectionSourceDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "d1" ] .
gmeow:sdmcSource a logic:Formula ; logic:relation gmeow:projectionSource ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "src" ] .
gmeow:sdmcResolved a logic:Formula ; logic:relation gmeow:contentDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "src" ] , [ logic:termIndex 1 ; logic:termVariable "d2" ] .
gmeow:sdmcEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "d1" ] , [ logic:termIndex 1 ; logic:termVariable "d2" ] .

# C2 (CT2/CT3): a cross-space similarity observation — one whose two projections'
# vector-space contracts have DISTINCT digests — requires a justifying
# logic:Correspondence between those contracts (existential consequent).
gmeow:CrossSpaceComparisonConstraint
    a logic:Constraint ;
    rdfs:label "Cross-space comparison constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:SimilarityObservation comparing two projections whose gmeow:hasVectorSpaceContract digests DIFFER requires a justifying logic:Correspondence whose logic:sourceEndpoint/logic:targetEndpoint are those two contracts. Same-digest (same-space) comparisons are exempt; a cross-space comparison with no correspondence is ill-formed — proximity across unrelated spaces is meaningless without the bridge."@x-gmeow-english ;
    logic:formalizes gmeow:CrossSpaceComparisonShape ;
    logic:message "A similarity observation across two DIFFERENT vector spaces (distinct contract digests) requires a justifying logic:Correspondence between the two gmeow:VectorSpaceContracts." ;
    logic:integrity gmeow:csccForall .
gmeow:csccForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "obs" ] , [ logic:termIndex 1 ; logic:termVariable "pL" ] , [ logic:termIndex 2 ; logic:termVariable "pR" ] , [ logic:termIndex 3 ; logic:termVariable "cL" ] , [ logic:termIndex 4 ; logic:termVariable "cR" ] , [ logic:termIndex 5 ; logic:termVariable "dL" ] , [ logic:termIndex 6 ; logic:termVariable "dR" ] ;
    logic:forall gmeow:csccImpl .
gmeow:csccImpl a logic:Formula ; logic:antecedent gmeow:csccGuard ; logic:consequent gmeow:csccExists .
gmeow:csccGuard a logic:Formula ; logic:and gmeow:csccType , gmeow:csccLeft , gmeow:csccRight , gmeow:csccContractL , gmeow:csccContractR , gmeow:csccDigestL , gmeow:csccDigestR , gmeow:csccDistinct .
gmeow:csccType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "obs" ] , [ logic:termIndex 1 ; logic:termIri gmeow:SimilarityObservation ] .
gmeow:csccLeft a logic:Formula ; logic:relation gmeow:comparesLeft ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "obs" ] , [ logic:termIndex 1 ; logic:termVariable "pL" ] .
gmeow:csccRight a logic:Formula ; logic:relation gmeow:comparesRight ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "obs" ] , [ logic:termIndex 1 ; logic:termVariable "pR" ] .
gmeow:csccContractL a logic:Formula ; logic:relation gmeow:hasVectorSpaceContract ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "pL" ] , [ logic:termIndex 1 ; logic:termVariable "cL" ] .
gmeow:csccContractR a logic:Formula ; logic:relation gmeow:hasVectorSpaceContract ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "pR" ] , [ logic:termIndex 1 ; logic:termVariable "cR" ] .
gmeow:csccDigestL a logic:Formula ; logic:relation gmeow:contentDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "cL" ] , [ logic:termIndex 1 ; logic:termVariable "dL" ] .
gmeow:csccDigestR a logic:Formula ; logic:relation gmeow:contentDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "cR" ] , [ logic:termIndex 1 ; logic:termVariable "dR" ] .
gmeow:csccDistinct a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "dL" ] , [ logic:termIndex 1 ; logic:termVariable "dR" ] .
gmeow:csccExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "corr" ] ;
    logic:exists gmeow:csccBody .
gmeow:csccBody a logic:Formula ; logic:and gmeow:csccCorrType , gmeow:csccSrc , gmeow:csccTgt .
gmeow:csccCorrType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "corr" ] , [ logic:termIndex 1 ; logic:termIri logic:Correspondence ] .
gmeow:csccSrc a logic:Formula ; logic:relation logic:sourceEndpoint ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "corr" ] , [ logic:termIndex 1 ; logic:termVariable "cL" ] .
gmeow:csccTgt a logic:Formula ; logic:relation logic:targetEndpoint ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "corr" ] , [ logic:termIndex 1 ; logic:termVariable "cR" ] .

# C3 (CT7): a projection whose disclosure sensitivity is WEAKER (lower rank) than
# its source's requires an explicit gmeow:DeclassificationAct (existential
# consequent) — sensitivity never drops silently (P15).
gmeow:SecurityMonotonicityConstraint
    a logic:Constraint ;
    rdfs:label "Security monotonicity constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: when a gmeow:EmbeddingProjection's sensitivity rank is LOWER than its gmeow:projectionSource's (the source is more sensitive, gmeow:sensitivityRank source > projection), an explicit gmeow:DeclassificationAct that gmeow:declassifies the projection must exist. Absent that reviewable act, a projection may never sit below its source's classification — disclosure sensitivity never degrades silently (P15)."@x-gmeow-english ;
    logic:formalizes gmeow:SecurityMonotonicityShape ;
    logic:message "A projection whose sensitivity is below its source's requires an explicit gmeow:DeclassificationAct declassifying it — sensitivity never drops silently (P15)." ;
    logic:integrity gmeow:smonForall .
gmeow:smonForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "ps" ] , [ logic:termIndex 2 ; logic:termVariable "pr" ] , [ logic:termIndex 3 ; logic:termVariable "src" ] , [ logic:termIndex 4 ; logic:termVariable "ss" ] , [ logic:termIndex 5 ; logic:termVariable "sr" ] ;
    logic:forall gmeow:smonImpl .
gmeow:smonImpl a logic:Formula ; logic:antecedent gmeow:smonGuard ; logic:consequent gmeow:smonExists .
gmeow:smonGuard a logic:Formula ; logic:and gmeow:smonType , gmeow:smonProjSens , gmeow:smonProjRank , gmeow:smonSource , gmeow:smonSrcSens , gmeow:smonSrcRank , gmeow:smonGt .
gmeow:smonType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termIri gmeow:EmbeddingProjection ] .
gmeow:smonProjSens a logic:Formula ; logic:relation gmeow:hasSensitivity ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "ps" ] .
gmeow:smonProjRank a logic:Formula ; logic:relation gmeow:sensitivityRank ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "ps" ] , [ logic:termIndex 1 ; logic:termVariable "pr" ] .
gmeow:smonSource a logic:Formula ; logic:relation gmeow:projectionSource ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "src" ] .
gmeow:smonSrcSens a logic:Formula ; logic:relation gmeow:hasSensitivity ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "src" ] , [ logic:termIndex 1 ; logic:termVariable "ss" ] .
gmeow:smonSrcRank a logic:Formula ; logic:relation gmeow:sensitivityRank ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "ss" ] , [ logic:termIndex 1 ; logic:termVariable "sr" ] .
gmeow:smonGt a logic:Formula ; logic:relation logic:termGreater ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sr" ] , [ logic:termIndex 1 ; logic:termVariable "pr" ] .
gmeow:smonExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "act" ] ;
    logic:exists gmeow:smonBody .
gmeow:smonBody a logic:Formula ; logic:and gmeow:smonActType , gmeow:smonDeclassifies .
gmeow:smonActType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "act" ] , [ logic:termIndex 1 ; logic:termIri gmeow:DeclassificationAct ] .
gmeow:smonDeclassifies a logic:Formula ; logic:relation gmeow:declassifies ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "act" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .

# C4 (CT4): a vector target must carry an EXACT identity — a gmeow:targetsResource
# OR a gmeow:contentDigest — never a bare gmeow:targetOrdinal (a non-identifying
# hint). The RDF 1.2 statement-term case is covered because such a target still
# uses gmeow:targetsResource pointing at the reifier. Consequent = logic:or of
# two logic:exists bodies.
gmeow:TargetExactIdentityConstraint
    a logic:Constraint ;
    rdfs:label "Target exact-identity constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:VectorTarget carries an EXACT identity — either a gmeow:targetsResource binding or its own gmeow:contentDigest — never only a gmeow:targetOrdinal, which is a non-identifying acceleration hint. The RDF 1.2 statement-term case is covered by the first disjunct: such a target still uses gmeow:targetsResource pointing at the rdf:reifies reifier, so it satisfies the exact-identity requirement. A bare ordinal with neither disjunct present is a violation."@x-gmeow-english ;
    logic:formalizes gmeow:TargetExactIdentityShape ;
    logic:message "A vector target must carry an exact identity — a gmeow:targetsResource or a gmeow:contentDigest — not just a non-identifying gmeow:targetOrdinal." ;
    logic:integrity gmeow:teicForall .
gmeow:teicForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "vt" ] ;
    logic:forall gmeow:teicImpl .
gmeow:teicImpl a logic:Formula ; logic:antecedent gmeow:teicType ; logic:consequent gmeow:teicOr .
gmeow:teicType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vt" ] , [ logic:termIndex 1 ; logic:termIri gmeow:VectorTarget ] .
gmeow:teicOr a logic:Formula ; logic:or gmeow:teicResExists , gmeow:teicDigExists .
gmeow:teicResExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "r" ] ;
    logic:exists gmeow:teicResAtom .
gmeow:teicResAtom a logic:Formula ; logic:relation gmeow:targetsResource ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vt" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] .
gmeow:teicDigExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] ;
    logic:exists gmeow:teicDigAtom .
gmeow:teicDigAtom a logic:Formula ; logic:relation gmeow:contentDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vt" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .

# C5a (CT10/R5): the container and manifest surfaces of one projection must
# record the SAME source-pack digest.
gmeow:ProfileSourceDigestAgreementConstraint
    a logic:Constraint ;
    rdfs:label "Profile source-digest agreement constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: for one gmeow:EmbeddingProjection, its gmeow:surfaceContainer and gmeow:surfaceManifest profile surfaces must record the SAME gmeow:recordsSourceDigest. Disagreement is a HARD FAIL — the container and its sidecar manifest describe different source packs — never a heuristic reconciliation of the two digests."@x-gmeow-english ;
    logic:formalizes gmeow:ProfileSourceDigestAgreementShape ;
    logic:message "A projection's container and manifest profile surfaces must record the same source-pack digest (gmeow:recordsSourceDigest) — disagreement is a hard fail." ;
    logic:integrity gmeow:psdaForall .
gmeow:psdaForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "proj" ] , [ logic:termIndex 1 ; logic:termVariable "sc" ] , [ logic:termIndex 2 ; logic:termVariable "sm" ] , [ logic:termIndex 3 ; logic:termVariable "x" ] , [ logic:termIndex 4 ; logic:termVariable "y" ] ;
    logic:forall gmeow:psdaImpl .
gmeow:psdaImpl a logic:Formula ; logic:antecedent gmeow:psdaGuard ; logic:consequent gmeow:psdaEq .
gmeow:psdaGuard a logic:Formula ; logic:and gmeow:psdaContainerOf , gmeow:psdaContainerKind , gmeow:psdaManifestOf , gmeow:psdaManifestKind , gmeow:psdaContainerDigest , gmeow:psdaManifestDigest .
gmeow:psdaContainerOf a logic:Formula ; logic:relation gmeow:profileSurfaceOf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sc" ] , [ logic:termIndex 1 ; logic:termVariable "proj" ] .
gmeow:psdaContainerKind a logic:Formula ; logic:relation gmeow:profileSurfaceKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sc" ] , [ logic:termIndex 1 ; logic:termIri gmeow:surfaceContainer ] .
gmeow:psdaManifestOf a logic:Formula ; logic:relation gmeow:profileSurfaceOf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sm" ] , [ logic:termIndex 1 ; logic:termVariable "proj" ] .
gmeow:psdaManifestKind a logic:Formula ; logic:relation gmeow:profileSurfaceKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sm" ] , [ logic:termIndex 1 ; logic:termIri gmeow:surfaceManifest ] .
gmeow:psdaContainerDigest a logic:Formula ; logic:relation gmeow:recordsSourceDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sc" ] , [ logic:termIndex 1 ; logic:termVariable "x" ] .
gmeow:psdaManifestDigest a logic:Formula ; logic:relation gmeow:recordsSourceDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sm" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] .
gmeow:psdaEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] .

# C5b (CT10/R5): the container and manifest surfaces of one projection must
# record the SAME model-contract digest.
gmeow:ProfileModelContractAgreementConstraint
    a logic:Constraint ;
    rdfs:label "Profile model-contract agreement constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: for one gmeow:EmbeddingProjection, its gmeow:surfaceContainer and gmeow:surfaceManifest profile surfaces must record the SAME gmeow:recordsModelContractDigest. Disagreement is a HARD FAIL — the container and its sidecar manifest describe different vector-space contracts — never a heuristic reconciliation of the two digests."@x-gmeow-english ;
    logic:formalizes gmeow:ProfileModelContractAgreementShape ;
    logic:message "A projection's container and manifest profile surfaces must record the same model-contract digest (gmeow:recordsModelContractDigest) — disagreement is a hard fail." ;
    logic:integrity gmeow:pmcaForall .
gmeow:pmcaForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "proj" ] , [ logic:termIndex 1 ; logic:termVariable "sc" ] , [ logic:termIndex 2 ; logic:termVariable "sm" ] , [ logic:termIndex 3 ; logic:termVariable "x" ] , [ logic:termIndex 4 ; logic:termVariable "y" ] ;
    logic:forall gmeow:pmcaImpl .
gmeow:pmcaImpl a logic:Formula ; logic:antecedent gmeow:pmcaGuard ; logic:consequent gmeow:pmcaEq .
gmeow:pmcaGuard a logic:Formula ; logic:and gmeow:pmcaContainerOf , gmeow:pmcaContainerKind , gmeow:pmcaManifestOf , gmeow:pmcaManifestKind , gmeow:pmcaContainerDigest , gmeow:pmcaManifestDigest .
gmeow:pmcaContainerOf a logic:Formula ; logic:relation gmeow:profileSurfaceOf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sc" ] , [ logic:termIndex 1 ; logic:termVariable "proj" ] .
gmeow:pmcaContainerKind a logic:Formula ; logic:relation gmeow:profileSurfaceKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sc" ] , [ logic:termIndex 1 ; logic:termIri gmeow:surfaceContainer ] .
gmeow:pmcaManifestOf a logic:Formula ; logic:relation gmeow:profileSurfaceOf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sm" ] , [ logic:termIndex 1 ; logic:termVariable "proj" ] .
gmeow:pmcaManifestKind a logic:Formula ; logic:relation gmeow:profileSurfaceKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sm" ] , [ logic:termIndex 1 ; logic:termIri gmeow:surfaceManifest ] .
gmeow:pmcaContainerDigest a logic:Formula ; logic:relation gmeow:recordsModelContractDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sc" ] , [ logic:termIndex 1 ; logic:termVariable "x" ] .
gmeow:pmcaManifestDigest a logic:Formula ; logic:relation gmeow:recordsModelContractDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sm" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] .
gmeow:pmcaEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] .

# C5c (CT10/R5): the container and manifest surfaces of one projection must
# record the SAME target-table digest.
gmeow:ProfileTargetTableAgreementConstraint
    a logic:Constraint ;
    rdfs:label "Profile target-table agreement constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: for one gmeow:EmbeddingProjection, its gmeow:surfaceContainer and gmeow:surfaceManifest profile surfaces must record the SAME gmeow:recordsTargetTableDigest. Disagreement is a HARD FAIL — the container and its sidecar manifest describe different target tables — never a heuristic reconciliation of the two digests."@x-gmeow-english ;
    logic:formalizes gmeow:ProfileTargetTableAgreementShape ;
    logic:message "A projection's container and manifest profile surfaces must record the same target-table digest (gmeow:recordsTargetTableDigest) — disagreement is a hard fail." ;
    logic:integrity gmeow:pttaForall .
gmeow:pttaForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "proj" ] , [ logic:termIndex 1 ; logic:termVariable "sc" ] , [ logic:termIndex 2 ; logic:termVariable "sm" ] , [ logic:termIndex 3 ; logic:termVariable "x" ] , [ logic:termIndex 4 ; logic:termVariable "y" ] ;
    logic:forall gmeow:pttaImpl .
gmeow:pttaImpl a logic:Formula ; logic:antecedent gmeow:pttaGuard ; logic:consequent gmeow:pttaEq .
gmeow:pttaGuard a logic:Formula ; logic:and gmeow:pttaContainerOf , gmeow:pttaContainerKind , gmeow:pttaManifestOf , gmeow:pttaManifestKind , gmeow:pttaContainerDigest , gmeow:pttaManifestDigest .
gmeow:pttaContainerOf a logic:Formula ; logic:relation gmeow:profileSurfaceOf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sc" ] , [ logic:termIndex 1 ; logic:termVariable "proj" ] .
gmeow:pttaContainerKind a logic:Formula ; logic:relation gmeow:profileSurfaceKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sc" ] , [ logic:termIndex 1 ; logic:termIri gmeow:surfaceContainer ] .
gmeow:pttaManifestOf a logic:Formula ; logic:relation gmeow:profileSurfaceOf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sm" ] , [ logic:termIndex 1 ; logic:termVariable "proj" ] .
gmeow:pttaManifestKind a logic:Formula ; logic:relation gmeow:profileSurfaceKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sm" ] , [ logic:termIndex 1 ; logic:termIri gmeow:surfaceManifest ] .
gmeow:pttaContainerDigest a logic:Formula ; logic:relation gmeow:recordsTargetTableDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sc" ] , [ logic:termIndex 1 ; logic:termVariable "x" ] .
gmeow:pttaManifestDigest a logic:Formula ; logic:relation gmeow:recordsTargetTableDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sm" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] .
gmeow:pttaEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] .

# C6 (R1): a certified source's gmeow:gtsHeadId must be PROPAGATED into the
# projection as gmeow:projectionSourceGtsHeadId with the SAME value (existential
# consequent with an equality atom).
gmeow:GtsHeadIdPropagationConstraint
    a logic:Constraint ;
    rdfs:label "GTS head-id propagation constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/embedding-projection> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: when a gmeow:EmbeddingProjection's gmeow:projectionSource carries a certified gmeow:gtsHeadId, the projection must propagate the SAME id via gmeow:projectionSourceGtsHeadId. A certified source's committed history must travel with its projection — it is never dropped, and a propagated id that differs from the source's is a violation."@x-gmeow-english ;
    logic:formalizes gmeow:GtsHeadIdPropagationShape ;
    logic:message "A certified source's gmeow:gtsHeadId must be propagated into the projection as an equal gmeow:projectionSourceGtsHeadId." ;
    logic:integrity gmeow:ghipForall .
gmeow:ghipForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "src" ] , [ logic:termIndex 2 ; logic:termVariable "h" ] ;
    logic:forall gmeow:ghipImpl .
gmeow:ghipImpl a logic:Formula ; logic:antecedent gmeow:ghipGuard ; logic:consequent gmeow:ghipExists .
gmeow:ghipGuard a logic:Formula ; logic:and gmeow:ghipType , gmeow:ghipSource , gmeow:ghipSrcHead .
gmeow:ghipType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termIri gmeow:EmbeddingProjection ] .
gmeow:ghipSource a logic:Formula ; logic:relation gmeow:projectionSource ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "src" ] .
gmeow:ghipSrcHead a logic:Formula ; logic:relation gmeow:gtsHeadId ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "src" ] , [ logic:termIndex 1 ; logic:termVariable "h" ] .
gmeow:ghipExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "h2" ] ;
    logic:exists gmeow:ghipBody .
gmeow:ghipBody a logic:Formula ; logic:and gmeow:ghipProp , gmeow:ghipEq .
gmeow:ghipProp a logic:Formula ; logic:relation gmeow:projectionSourceGtsHeadId ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "h2" ] .
gmeow:ghipEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "h" ] , [ logic:termIndex 1 ; logic:termVariable "h2" ] .

