#
# SHACL well-formedness shapes for the model-serving slice. These constrain
# INSTANCE data (the ABox); the stereotype / TBox invariants live in
# tests/structural.ttl. The gates realise the design's named invariants
# (INHABITED-RUNTIME-STACK.md): the deployment role-filler cardinalities and
# ranges, the deployment / awareness-subject disjointness (a deployment is a
# relator, never an Agent, so it can never be a gmeow:awarenessSubject — which
# ranges over gmeow:Agent), the ModelCard split (an artifact facet vs a service
# facet), and the session role-filler cardinalities. purrdf's sh:class is
# literal, so the disjointness is enforced with an explicit sh:not — never left
# to inference.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# =========================================================================== #
# ModelDeployment — one artifact, one service agent, one host; NEVER an Agent
# =========================================================================== #

gmeow:ModelDeploymentShape
    a sh:NodeShape ;
    rdfs:label "ModelDeployment well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:ModelDeployment: at most one gmeow:deploymentArtifact (a gmeow:ModelArtifact), one gmeow:deploymentService (a gmeow:SoftwareAgent), and one gmeow:deploymentHost (a gmeow:Entity); and — enforcing the awareness-subject-range invariant explicitly (purrdf sh:class is literal) — a gmeow:ModelDeployment is a logic:Relator and MUST NOT be a gmeow:Agent, so it can never be attached as a gmeow:awarenessSubject (which ranges over gmeow:Agent). The serving-mode gmeow:AwarenessTenure attaches to the deployment's gmeow:deploymentService SoftwareAgent instead."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    sh:targetClass gmeow:ModelDeployment ;
    sh:property [
        sh:path gmeow:deploymentArtifact ;
        sh:maxCount 1 ;
        sh:class gmeow:ModelArtifact ;
        sh:severity sh:Violation ;
        sh:message "A ModelDeployment realizes at most one gmeow:deploymentArtifact, and it must be a gmeow:ModelArtifact." ;
    ] ;
    sh:property [
        sh:path gmeow:deploymentService ;
        sh:maxCount 1 ;
        sh:class gmeow:SoftwareAgent ;
        sh:severity sh:Violation ;
        sh:message "A ModelDeployment presents at most one gmeow:deploymentService, and it must be a gmeow:SoftwareAgent." ;
    ] ;
    sh:property [
        sh:path gmeow:deploymentHost ;
        sh:maxCount 1 ;
        sh:class gmeow:Entity ;
        sh:severity sh:Violation ;
        sh:message "A ModelDeployment serves on at most one gmeow:deploymentHost, and it must be a gmeow:Entity." ;
    ] ;
    sh:not [
        sh:class gmeow:Agent ;
    ] ;
    sh:message "A gmeow:ModelDeployment is a logic:Relator and MUST NOT also be a gmeow:Agent — it cannot be a gmeow:awarenessSubject; attach the serving-mode gmeow:AwarenessTenure to the deployment's gmeow:deploymentService SoftwareAgent." ;
    sh:severity sh:Violation .

# =========================================================================== #
# ModelCard split — the artifact facet and the service facet are distinct
# =========================================================================== #

gmeow:ModelCardServingSplitShape
    a sh:NodeShape ;
    rdfs:label "ModelCard serving-split shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for the model-serving split of gmeow:ModelCard relations: gmeow:describesModelArtifact must target a gmeow:ModelArtifact and gmeow:describesModelService a gmeow:ModelDeployment. Together with the functional gmeow:describesModel (→ gmeow:SoftwareAgent) this keeps a served distribution from being inferred a SoftwareAgent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    sh:targetClass gmeow:ModelCard ;
    sh:property [
        sh:path gmeow:describesModelArtifact ;
        sh:class gmeow:ModelArtifact ;
        sh:severity sh:Violation ;
        sh:message "gmeow:describesModelArtifact must target a gmeow:ModelArtifact." ;
    ] ;
    sh:property [
        sh:path gmeow:describesModelService ;
        sh:class gmeow:ModelDeployment ;
        sh:severity sh:Violation ;
        sh:message "gmeow:describesModelService must target a gmeow:ModelDeployment." ;
    ] .

# =========================================================================== #
# AgentSession — at most one subject stage and one active configuration
# =========================================================================== #

gmeow:AgentSessionShape
    a sh:NodeShape ;
    rdfs:label "AgentSession well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:AgentSession: at most one gmeow:sessionSubjectStage and at most one gmeow:sessionConfiguration (the session is on behalf of a single subject stage under a single active configuration; both are open-range, so only cardinality is constrained here — the target typing is an instance-level concern of the agent-runtime profile)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    sh:targetClass gmeow:AgentSession ;
    sh:property [
        sh:path gmeow:sessionSubjectStage ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An AgentSession is on behalf of at most one gmeow:sessionSubjectStage." ;
    ] ;
    sh:property [
        sh:path gmeow:sessionConfiguration ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An AgentSession runs under at most one active gmeow:sessionConfiguration." ;
    ] .
