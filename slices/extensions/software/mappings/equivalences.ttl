@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix doap:    <http://usefulinc.com/ns/doap#> .
@prefix schema:  <https://schema.org/> .
@prefix spdx:    <http://spdx.org/rdf/terms#> .
@prefix codemeta: <https://codemeta.github.io/terms/#> .
@prefix forgefed: <https://forgefed.org/ns#> .
@prefix swh:     <https://www.softwareheritage.org/data-model/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Software five-facet de-conflation alignments.
# Compiled to mappings/gmeow-software.sssom.tsv by `gmeow compile-mappings`.
# Projections live in mapping-dsl/projections/software.ttl.
#
# NOTE: Software Heritage and RAiD do not publish standard RDF ontologies;
# alignments to them are carried as skos:closeMatch to informal concept URIs
# and will be refined when stable vocabularies emerge.

gmeow:mapsetSoftware a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/software" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Five-facet software de-conflation alignments to DOAP, schema.org, SPDX, CodeMeta, ForgeFed, and Software Heritage. GMEOW rebuilds the distinction natively and bridges by reference (Principle 5)." .

# --------------------------------------------------------------------------- #
# DOAP — lossy closeMatch because DOAP conflates project, product, repo, history
# --------------------------------------------------------------------------- #

gmeow:SoftwareProject skos:closeMatch doap:Project {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "DOAP conflates endeavour, product, repo and history; GMEOW SoftwareProject is the endeavour facet only."
|} .

gmeow:Repository skos:closeMatch doap:Repository {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "DOAP Repository ≈ GMEOW Repository (location facet)."
|} .

gmeow:Release skos:closeMatch doap:Version {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "DOAP Version conflates release event and version string; GMEOW Release is the event facet."
|} .

# --------------------------------------------------------------------------- #
# schema.org — lossy because it conflates source code, application, and project
# --------------------------------------------------------------------------- #

gmeow:SoftwareProduct skos:closeMatch schema:SoftwareSourceCode {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "schema.org conflates source code and application; GMEOW SoftwareProduct is the creative-work facet."
|} .

gmeow:SoftwareProduct skos:closeMatch schema:SoftwareApplication {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "schema.org SoftwareApplication is the deployed/runtime view; GMEOW SoftwareProduct is the abstract creative work."
|} .

gmeow:Repository skos:closeMatch schema:codeRepository {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema.org codeRepository is a URL literal; GMEOW Repository is a first-class entity."
|} .

# --------------------------------------------------------------------------- #
# SPDX — SBOM / package identity layer
# --------------------------------------------------------------------------- #

gmeow:Package skos:closeMatch spdx:Package {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "SPDX Package is the SBOM-level descriptor; GMEOW Package is the distributable unit."
|} .

gmeow:SourceFile skos:closeMatch spdx:File {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Direct correspondence: both are content-addressed files in a package."
|} .

# --------------------------------------------------------------------------- #
# CodeMeta — software metadata vocabulary (schema.org extension)
# --------------------------------------------------------------------------- #

gmeow:SoftwareProduct skos:closeMatch codemeta:SoftwareSourceCode {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "CodeMeta SoftwareSourceCode ≈ schema.org SoftwareSourceCode; GMEOW SoftwareProduct is the abstract creative work."
|} .

# --------------------------------------------------------------------------- #
# ForgeFed — federated forge vocabulary
# --------------------------------------------------------------------------- #

gmeow:Repository skos:closeMatch forgefed:Repository {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "ForgeFed Repository is the ActivityPub representation of a code repository."
|} .

gmeow:Commit skos:closeMatch forgefed:Commit {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "ForgeFed Commit is the federated representation of a VCS commit."
|} .

gmeow:Issue skos:closeMatch forgefed:Ticket {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "ForgeFed Ticket ≈ GMEOW Issue (both are tracked work items)."
|} .

# --------------------------------------------------------------------------- #
# Software Heritage — informal concept URIs (no standard RDF ontology published)
# --------------------------------------------------------------------------- #

gmeow:Blob skos:closeMatch swh:Content {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Software Heritage Content is content-addressed file content; GMEOW Blob is the raw content facet (bytes only, no name)."
|} .

gmeow:SourceFile skos:closeMatch swh:Content {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Software Heritage Content is also the closest match for GMEOW SourceFile, which adds the named-in-tree aspect on top of raw content."
|} .

gmeow:SourceTree skos:closeMatch swh:Directory {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Software Heritage Directory is a content-addressed tree of files and subdirectories; direct correspondence to GMEOW SourceTree."
|} .

gmeow:Commit skos:closeMatch swh:Revision {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Software Heritage Revision is a commit/revision with author, committer, timestamp, and tree; direct correspondence to GMEOW Commit."
|} .

gmeow:Release skos:closeMatch swh:Release {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Software Heritage Release is a named revision (tag); direct correspondence to GMEOW Release."
|} .

gmeow:Repository skos:closeMatch swh:Origin {|
    gmeow:sssomFile "gmeow-software.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Software Heritage Origin is a repository origin URL; GMEOW Repository is the location/hosting facet, which may carry additional metadata."
|} .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:SoftwareProject skos:closeMatch doap:Project {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7
|} .

schema:SoftwareSourceCode skos:closeMatch gmeow:SoftwareProduct {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

schema:SoftwareApplication skos:closeMatch gmeow:SoftwareProduct {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7
|} .

doap:GitRepository rdfs:subClassOf gmeow:Repository {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:SoftwareProject skos:closeMatch dcmitype:Software {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "A GMEOW SoftwareProject is a DCMI Software"
|} .

gmeow:hasRepository skos:closeMatch doap:repository {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:SoftwareProject skos:closeMatch wd:Q7397 {|
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:objectLabel "software"
|} .
