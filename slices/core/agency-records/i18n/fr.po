msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperationReceipt|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Artifact Operation Receipt"
msgstr "Activité consignée sur artefact"

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperationReceipt|http://www.w3.org/2004/02/skos/core#definition"
msgid "An artifact-operation activity occurrence retained as a receipt of what happened. It is an Activity subordinate to its attempt or ToolCall, not an information document masquerading as an event."
msgstr "Occurrence d’activité sur artefact conservée comme compte rendu de ce qui s’est passé. C’est une Activity subordonnée à sa tentative ou ToolCall, pas un document informationnel pris pour un événement."

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperationReceipt|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for a recorded creation, read or update operation within an attempt or tool call."
msgstr "Utiliser pour une opération enregistrée de création, lecture ou mise à jour dans une tentative ou un appel d’outil."

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperationReceipt|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating its result digest as the artifact’s own byte identity or as success."
msgstr "Éviter de traiter son empreinte de résultat comme l’identité des octets de l’artefact ou comme un succès."

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperationReceipt|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Bind receiptOperation and receiptArtifact, retain subEventOf context and supplied receiptTool or resultDigest."
msgstr "Lier receiptOperation et receiptArtifact, conserver le contexte subEventOf et les receiptTool ou resultDigest fournis."

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperationReceipt|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:operation a gmeow:ArtifactOperationReceipt ; gmeow:subEventOf ex:attempt ."
msgstr "ex:operation a gmeow:ArtifactOperationReceipt ; gmeow:subEventOf ex:attempt ."

msgctxt "https://blackcatinformatics.ca/gmeow/readArtifact|http://www.w3.org/2000/01/rdf-schema#label"
msgid "read artifact"
msgstr "a lu l’artefact"

msgctxt "https://blackcatinformatics.ca/gmeow/readArtifact|http://www.w3.org/2004/02/skos/core#definition"
msgid "Relates an activity to an information artifact or version it actually read. Reading does not assert that the artifact changed or that its content was accepted as true."
msgstr "Relie une activité à un artefact ou une version informationnelle réellement lu. La lecture n’affirme ni modification ni acceptation du contenu comme vrai."

msgctxt "https://blackcatinformatics.ca/gmeow/readArtifact|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain a read without inventing a write operation."
msgstr "Utiliser pour conserver une lecture sans inventer d’écriture."

msgctxt "https://blackcatinformatics.ca/gmeow/readArtifact|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid restricting read artifacts to published documents."
msgstr "Éviter de limiter les artefacts lus aux documents publiés."

msgctxt "https://blackcatinformatics.ca/gmeow/readArtifact|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference the actual InformationObject or version read; use separate records for later observations."
msgstr "Référencer l’InformationObject ou la version réellement lu ; utiliser des enregistrements distincts pour les observations ultérieures."

msgctxt "https://blackcatinformatics.ca/gmeow/readArtifact|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:read gmeow:readArtifact ex:artifact ."
msgstr "ex:read gmeow:readArtifact ex:artifact ."

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoal|http://www.w3.org/2000/01/rdf-schema#label"
msgid "conflicts with goal"
msgstr "entre en conflit avec le but"

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoal|http://www.w3.org/2004/02/skos/core#definition"
msgid "A recorded non-constitutive conflict between goals, such as competing demands on an agent’s time. The symmetric relation does not define either goal by its opposition and is not transitive."
msgstr "Conflit enregistré non constitutif entre buts, par exemple des demandes concurrentes sur le temps d’un agent. La relation symétrique ne définit aucun but par opposition et n’est pas transitive."

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoal|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for an attributed practical conflict between goals."
msgstr "Utiliser pour un conflit pratique attribué entre buts."

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoal|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid bridging this relation to constitutive counterGoal or inferring a global priority."
msgstr "Éviter de relier cette relation au counterGoal constitutif ou d’en déduire une priorité globale."

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoal|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Link the goals and retain standpoint and temporal scope on the statement when relevant."
msgstr "Relier les buts et conserver le point de vue et la portée temporelle sur l’énoncé si pertinent."

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoal|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:draftGoal gmeow:conflictsWithGoal ex:restGoal ."
msgstr "ex:draftGoal gmeow:conflictsWithGoal ex:restGoal ."

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoalSymmetry|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Goal conflict symmetry"
msgstr "Symétrie du conflit de buts"

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoalSymmetry|http://www.w3.org/2004/02/skos/core#definition"
msgid "Canonical symmetry of non-constitutive goal conflict, without a transitivity or constitutive-opposition claim."
msgstr "Symétrie canonique du conflit non constitutif de buts, sans affirmation de transitivité ni d’opposition constitutive."

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoalSymmetry|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to read the same recorded conflict in either direction."
msgstr "Utiliser pour lire le même conflit dans les deux sens."

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoalSymmetry|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid extending symmetry into conflict propagation along unrelated goals."
msgstr "Éviter d’étendre la symétrie en propagation du conflit entre buts sans lien."

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoalSymmetry|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Read the canonical characteristic on conflictsWithGoal."
msgstr "Lire la caractéristique canonique sur conflictsWithGoal."

msgctxt "https://blackcatinformatics.ca/gmeow/conflictsWithGoalSymmetry|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:conflictsWithGoalSymmetry logic:characterizes gmeow:conflictsWithGoal ."
msgstr "gmeow:conflictsWithGoalSymmetry logic:characterizes gmeow:conflictsWithGoal ."

msgctxt "https://blackcatinformatics.ca/gmeow/toolName|http://www.w3.org/2000/01/rdf-schema#label"
msgid "tool name"
msgstr "nom d’outil"

msgctxt "https://blackcatinformatics.ca/gmeow/toolName|http://www.w3.org/2004/02/skos/core#definition"
msgid "The tool name given by the call, verbatim, distinct from the SoftwareAgent that usedTool must still identify."
msgstr "Nom d’outil donné par l’appel, conservé textuellement, distinct du SoftwareAgent que usedTool doit toujours identifier."

msgctxt "https://blackcatinformatics.ca/gmeow/toolName|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source exposes a name without a rich tool-agent description."
msgstr "Utiliser lorsque la source expose un nom sans description riche de l’agent outil."

msgctxt "https://blackcatinformatics.ca/gmeow/toolName|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid replacing required usedTool with this literal or inferring a holder from the name."
msgstr "Éviter de remplacer usedTool obligatoire par ce littéral ou de déduire un titulaire du nom."

msgctxt "https://blackcatinformatics.ca/gmeow/toolName|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Keep the string and link usedTool to a minimally described actual source-scoped SoftwareAgent."
msgstr "Conserver la chaîne et relier usedTool à un SoftwareAgent réel, limité à la source et minimalement décrit."

msgctxt "https://blackcatinformatics.ca/gmeow/toolName|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:toolName \"source value\" ."
msgstr "ex:record gmeow:toolName \"source value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/toolCallId|http://www.w3.org/2000/01/rdf-schema#label"
msgid "tool call identifier"
msgstr "identifiant d’appel d’outil"

msgctxt "https://blackcatinformatics.ca/gmeow/toolCallId|http://www.w3.org/2004/02/skos/core#definition"
msgid "The identifier carried by this tool call, preserved verbatim in its source scope. It is not a global key or a replacement for the call resource."
msgstr "Identifiant porté par cet appel, conservé textuellement dans sa portée source. Ce n’est ni une clé globale ni un remplacement de la ressource d’appel."

msgctxt "https://blackcatinformatics.ca/gmeow/toolCallId|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain the source identifier by which records referred to the call."
msgstr "Utiliser pour conserver l’identifiant source par lequel des enregistrements référaient à l’appel."

msgctxt "https://blackcatinformatics.ca/gmeow/toolCallId|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid widening unrelated identifier domains or merging calls by a reused local id."
msgstr "Éviter d’élargir des domaines d’identifiant sans lien ou de fusionner des appels par identifiant local réutilisé."

msgctxt "https://blackcatinformatics.ca/gmeow/toolCallId|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Keep the source string and link assertions with existing derivedBy only when they came from that call."
msgstr "Conserver la chaîne source et relier les assertions par derivedBy seulement lorsqu’elles proviennent de cet appel."

msgctxt "https://blackcatinformatics.ca/gmeow/toolCallId|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:toolCallId \"source value\" ."
msgstr "ex:record gmeow:toolCallId \"source value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/receiptTool|http://www.w3.org/2000/01/rdf-schema#label"
msgid "receipt tool name"
msgstr "nom d’outil de l’activité consignée"

msgctxt "https://blackcatinformatics.ca/gmeow/receiptTool|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source-reported tool name for this artifact operation, verbatim. It does not replace a ToolCall’s usedTool agent."
msgstr "Nom d’outil source de cette opération, conservé textuellement. Il ne remplace pas l’agent usedTool d’un ToolCall."

msgctxt "https://blackcatinformatics.ca/gmeow/receiptTool|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when an activity receipt supplies a tool name."
msgstr "Utiliser lorsqu’une activité consignée fournit un nom d’outil."

msgctxt "https://blackcatinformatics.ca/gmeow/receiptTool|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid token whitespace normalization or inferred tool identity from this string alone."
msgstr "Éviter la normalisation des espaces de token ou l’identité d’outil déduite de cette seule chaîne."

msgctxt "https://blackcatinformatics.ca/gmeow/receiptTool|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve the exact string and retain the parent attempt or ToolCall separately."
msgstr "Préserver la chaîne exacte et conserver séparément la tentative ou le ToolCall parent."

msgctxt "https://blackcatinformatics.ca/gmeow/receiptTool|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:receiptTool \"source value\" ."
msgstr "ex:record gmeow:receiptTool \"source value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/resultDigest|http://www.w3.org/2000/01/rdf-schema#label"
msgid "result digest"
msgstr "empreinte du résultat"

msgctxt "https://blackcatinformatics.ca/gmeow/resultDigest|http://www.w3.org/2004/02/skos/core#definition"
msgid "A source-provided content digest of what the operation produced or returned. It is not automatically the artifact’s own bytes or the identity of the receipt."
msgstr "Empreinte source du contenu produit ou retourné par l’opération. Ce n’est pas automatiquement l’identité des octets de l’artefact ni de l’activité consignée."

msgctxt "https://blackcatinformatics.ca/gmeow/resultDigest|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain a reported operation-result identity."
msgstr "Utiliser pour conserver une identité rapportée de résultat d’opération."

msgctxt "https://blackcatinformatics.ca/gmeow/resultDigest|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid equating a tool-result envelope digest with the read artifact’s digest."
msgstr "Éviter d’assimiler l’empreinte d’une enveloppe de résultat à celle de l’artefact lu."

msgctxt "https://blackcatinformatics.ca/gmeow/resultDigest|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Use the existing algorithm-labelled digest convention and preserve multiple reported algorithms."
msgstr "Utiliser la convention existante préfixée par l’algorithme et conserver les algorithmes multiples rapportés."

msgctxt "https://blackcatinformatics.ca/gmeow/resultDigest|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:operation gmeow:resultDigest \"sha256:1111111111111111111111111111111111111111111111111111111111111111\" ."
msgstr "ex:operation gmeow:resultDigest \"sha256:1111111111111111111111111111111111111111111111111111111111111111\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/artifactComplete|http://www.w3.org/2000/01/rdf-schema#label"
msgid "artifact complete"
msgstr "artefact achevé"

msgctxt "https://blackcatinformatics.ca/gmeow/artifactComplete|http://www.w3.org/2004/02/skos/core#definition"
msgid "A source-attributed assertion that the identified artifact is complete or incomplete for its intended content. It is independent of operation success, invocation outcome and receipt completeness."
msgstr "Affirmation source que l’artefact identifié est achevé ou incomplet pour son contenu prévu. Elle est indépendante de la réussite d’opération, du résultat d’invocation et de l’exhaustivité d’un compte rendu."

msgctxt "https://blackcatinformatics.ca/gmeow/artifactComplete|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for an explicitly supplied artifact-completion bit."
msgstr "Utiliser pour un indicateur explicite d’achèvement d’artefact."

msgctxt "https://blackcatinformatics.ca/gmeow/artifactComplete|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid defaulting absent completion to false or deriving goal satisfaction from true."
msgstr "Éviter d’attribuer faux par défaut à l’absence ou de déduire la satisfaction d’un but de vrai."

msgctxt "https://blackcatinformatics.ca/gmeow/artifactComplete|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Put the supplied boolean on the artifact or version; migrate a local receiptComplete field here only when it meant artifact completion."
msgstr "Placer le booléen fourni sur l’artefact ou sa version ; migrer un champ local receiptComplete ici seulement s’il signifiait l’achèvement de l’artefact."

msgctxt "https://blackcatinformatics.ca/gmeow/artifactComplete|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:artifact gmeow:artifactComplete \"true\"^^xsd:boolean ."
msgstr "ex:artifact gmeow:artifactComplete \"true\"^^xsd:boolean ."

msgctxt "https://blackcatinformatics.ca/gmeow/invocationError|http://www.w3.org/2000/01/rdf-schema#label"
msgid "invocation error"
msgstr "erreur d’invocation"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationError|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source error text for a model invocation, preserved verbatim. Missing text does not prove success and an error does not establish artifact incompleteness."
msgstr "Texte d’erreur source d’une invocation de modèle, conservé textuellement. Son absence ne prouve pas le succès et une erreur n’établit pas l’inachèvement d’un artefact."

msgctxt "https://blackcatinformatics.ca/gmeow/invocationError|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve an appraisal or generation invocation’s reported error."
msgstr "Utiliser pour préserver l’erreur rapportée d’une invocation d’évaluation ou de génération."

msgctxt "https://blackcatinformatics.ca/gmeow/invocationError|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid replacing the source error with a normalized diagnosis or inferring it from status alone."
msgstr "Éviter de remplacer l’erreur source par un diagnostic normalisé ou de la déduire du seul état."

msgctxt "https://blackcatinformatics.ca/gmeow/invocationError|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Keep the exact string and record invocationOutcome independently when supplied."
msgstr "Conserver la chaîne exacte et consigner invocationOutcome indépendamment lorsqu’il est fourni."

msgctxt "https://blackcatinformatics.ca/gmeow/invocationError|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:invocationError \"source value\" ."
msgstr "ex:record gmeow:invocationError \"source value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/slices/agency-records|http://www.w3.org/2000/01/rdf-schema#label"
msgid "agency records"
msgstr "enregistrements d’action"

msgctxt "https://blackcatinformatics.ca/gmeow/slices/agency-records|http://www.w3.org/2004/02/skos/core#definition"
msgid "Source-faithful records of planless attempts, intention lifecycle, artifact operations, tool calls, invocation outcomes and situated agency judgments."
msgstr "Enregistrements fidèles de tentatives sans plan, cycle des intentions, opérations sur artefacts, appels d’outils, résultats d’invocation et jugements d’action situés."

msgctxt "https://blackcatinformatics.ca/gmeow/slices/agency-records|http://purl.org/dc/terms/title"
msgid "GMEOW Agency Records Module"
msgstr "Module GMEOW des enregistrements d’action"

msgctxt "https://blackcatinformatics.ca/gmeow/slices/agency-records|https://blackcatinformatics.ca/gmeow/sliceConsumer"
msgid "Agent memory importers retaining prose attempts and activity evidence without fabricating compiled plans, successful outcomes or unknown identities."
msgstr "Importateurs de mémoire d’agent conservant les tentatives en prose et leurs éléments d’activité sans fabriquer plans compilés, réussites ou identités inconnues."

msgctxt "https://blackcatinformatics.ca/gmeow/IntentionSalienceObservation|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Intention Salience Observation"
msgstr "Observation de saillance d’intention"

msgctxt "https://blackcatinformatics.ca/gmeow/IntentionSalienceObservation|http://www.w3.org/2004/02/skos/core#definition"
msgid "A source-attributed numeric observation of an intention’s salience on an explicitly identified producer scale or frame. It is not claim import importance, and no bounds, direction or normalization are implied."
msgstr "Observation numérique attribuée de la saillance d’une intention sur une échelle ou un cadre de producteur explicitement identifié. Ce n’est pas l’importance d’importation d’une affirmation ; aucune borne, direction ou normalisation n’est impliquée."

msgctxt "https://blackcatinformatics.ca/gmeow/IntentionSalienceObservation|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain an intention salience number together with its source convention and vantage."
msgstr "Utiliser pour conserver une saillance d’intention avec sa convention source et son point de vue."

msgctxt "https://blackcatinformatics.ca/gmeow/IntentionSalienceObservation|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid assuming a 0–10 scale or comparing different producer frames without a conversion contract."
msgstr "Éviter de supposer une échelle de 0 à 10 ou de comparer des cadres sans contrat de conversion."

msgctxt "https://blackcatinformatics.ca/gmeow/IntentionSalienceObservation|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Bind salienceOfIntention, salienceValue, salienceFrame and vantage; reuse a source ScoreScale only when its actual bounds are supplied."
msgstr "Lier salienceOfIntention, salienceValue, salienceFrame et vantage ; réutiliser un ScoreScale source seulement si ses bornes réelles sont fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/IntentionSalienceObservation|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:salience a gmeow:IntentionSalienceObservation ."
msgstr "ex:salience a gmeow:IntentionSalienceObservation ."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceOfIntention|http://www.w3.org/2000/01/rdf-schema#label"
msgid "salience of intention"
msgstr "saillance de l’intention"

msgctxt "https://blackcatinformatics.ca/gmeow/salienceOfIntention|http://www.w3.org/2004/02/skos/core#definition"
msgid "The intention whose salience this observation reports, specializing the existing observedFeature role."
msgstr "Intention dont cette observation rapporte la saillance, en spécialisant observedFeature."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceOfIntention|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to identify the intention assessed for salience."
msgstr "Utiliser pour identifier l’intention observée pour sa saillance."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceOfIntention|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid putting the observer or scale in this target role."
msgstr "Éviter de placer l’observateur ou l’échelle dans ce rôle cible."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceOfIntention|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference the existing Intention; keep the numerical reading and producer frame on the observation."
msgstr "Référencer l’Intention existante ; conserver la lecture numérique et le cadre sur l’observation."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceOfIntention|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:salience gmeow:salienceOfIntention ex:intention ."
msgstr "ex:salience gmeow:salienceOfIntention ex:intention ."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceValue|http://www.w3.org/2000/01/rdf-schema#label"
msgid "salience value"
msgstr "valeur de saillance"

msgctxt "https://blackcatinformatics.ca/gmeow/salienceValue|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source decimal salience reading, interpreted only within salienceFrame. A larger number is not assumed to mean greater salience."
msgstr "Lecture décimale source de saillance, interprétée uniquement dans salienceFrame. Un nombre supérieur ne signifie pas nécessairement une saillance supérieure."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceValue|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve the producer’s actual salience number."
msgstr "Utiliser pour préserver le nombre de saillance réel du producteur."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceValue|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid clamping, rescaling or dropping zero readings."
msgstr "Éviter de borner, remettre à l’échelle ou supprimer les valeurs nulles."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceValue|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the decimal with its explicit frame and source attribution."
msgstr "Conserver le décimal avec son cadre explicite et son attribution source."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceValue|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:salience gmeow:salienceValue \"17.5\"^^xsd:decimal ."
msgstr "ex:salience gmeow:salienceValue \"17.5\"^^xsd:decimal ."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceFrame|http://www.w3.org/2000/01/rdf-schema#label"
msgid "salience source frame"
msgstr "cadre source de saillance"

msgctxt "https://blackcatinformatics.ca/gmeow/salienceFrame|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source-defined convention identifying what a salience number means. An InformationObject may identify an opaque producer scale; unknown bounds or direction remain unknown."
msgstr "Convention source identifiant le sens d’un nombre de saillance. Un InformationObject peut identifier une échelle opaque ; les bornes ou direction inconnues restent inconnues."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceFrame|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to keep salience values scoped to the producer’s scale or frame."
msgstr "Utiliser pour délimiter les valeurs à l’échelle ou au cadre du producteur."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceFrame|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing scale bounds or equating differently named producer conventions."
msgstr "Éviter d’inventer des bornes ou d’assimiler des conventions de producteurs distinctes."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceFrame|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference the producer’s convention artifact; it may be a ScoreScale when its numeric contract is actually known."
msgstr "Référencer l’artefact de convention du producteur ; ce peut être un ScoreScale si son contrat numérique est réellement connu."

msgctxt "https://blackcatinformatics.ca/gmeow/salienceFrame|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:salience gmeow:salienceFrame ex:producerConvention ."
msgstr "ex:salience gmeow:salienceFrame ex:producerConvention ."

msgctxt "https://blackcatinformatics.ca/gmeow/VerifierKind|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Verifier Kind"
msgstr "Type de vérificateur"

msgctxt "https://blackcatinformatics.ca/gmeow/VerifierKind|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary of methods used to assess a condition on an artifact. Selecting a method is not a verdict that its condition holds."
msgstr "Vocabulaire ouvert de méthodes évaluant une condition sur un artefact. Choisir une méthode n’est pas un verdict que sa condition tient."

msgctxt "https://blackcatinformatics.ca/gmeow/VerifierKind|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain which verification method a source observation selected."
msgstr "Utiliser pour conserver la méthode choisie par une observation source."

msgctxt "https://blackcatinformatics.ca/gmeow/VerifierKind|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating verifier kind as a successful outcome or an agent identity."
msgstr "Éviter de traiter le type de vérificateur comme réussite ou identité d’agent."

msgctxt "https://blackcatinformatics.ca/gmeow/VerifierKind|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Use method individuals through verifierKind and retain verdicts separately through observationResult."
msgstr "Utiliser les individus de méthode par verifierKind et conserver les verdicts séparément par observationResult."

msgctxt "https://blackcatinformatics.ca/gmeow/VerifierKind|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:check gmeow:verifierKind gmeow:verifierArtifactReadAfterWrite ."
msgstr "ex:check gmeow:verifierKind gmeow:verifierArtifactReadAfterWrite ."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierArtifactReadAfterWrite|http://www.w3.org/2000/01/rdf-schema#label"
msgid "artifact read after write"
msgstr "lecture d’artefact après écriture"

msgctxt "https://blackcatinformatics.ca/gmeow/verifierArtifactReadAfterWrite|http://www.w3.org/2004/02/skos/core#definition"
msgid "Verification by an actual later read of the same identified artifact version that was written. A held verdict requires read and write evidence and artifact byte identity, not merely the writer’s own report."
msgstr "Vérification par lecture réellement ultérieure de la même version identifiée qui a été écrite. Un verdict tenu exige des éléments de lecture et écriture et l’identité des octets, pas le seul rapport de l’auteur de l’écriture."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierArtifactReadAfterWrite|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for source-observed read-back verification of a written artifact."
msgstr "Utiliser pour une vérification source par relecture d’un artefact écrit."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierArtifactReadAfterWrite|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid claiming confirmation from a selected method without a later read."
msgstr "Éviter d’affirmer confirmation à partir d’une méthode choisie sans lecture ultérieure."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierArtifactReadAfterWrite|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Select this kind on an ArtifactVerificationObservation and retain the actual operation receipts, version identity and verdict."
msgstr "Choisir ce type sur une ArtifactVerificationObservation et conserver opérations, identité de version et verdict réels."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierArtifactReadAfterWrite|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:check gmeow:verifierKind gmeow:verifierArtifactReadAfterWrite ."
msgstr "ex:check gmeow:verifierKind gmeow:verifierArtifactReadAfterWrite ."

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactVerificationObservation|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Artifact Verification Observation"
msgstr "Observation de vérification d’artefact"

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactVerificationObservation|http://www.w3.org/2004/02/skos/core#definition"
msgid "A vantage-attributed observation assessing an identified artifact or version by a declared verifier method. Any verdict is separate from the method, receipt result and invocation outcome."
msgstr "Observation attribuée à un point de vue évaluant un artefact ou version identifié par une méthode déclarée. Le verdict est distinct de la méthode, du résultat d’opération et du résultat d’invocation."

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactVerificationObservation|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain an artifact check with its source evidence and observer."
msgstr "Utiliser pour conserver une vérification d’artefact avec ses éléments sources et son observateur."

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactVerificationObservation|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid using the Attestation-domain verificationResult property as an activity output link."
msgstr "Éviter d’utiliser verificationResult, de domaine Attestation, comme lien de sortie d’activité."

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactVerificationObservation|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Bind verifiesArtifact, verifierKind and vantage; use existing evaluation verdict individuals through observationResult when reported."
msgstr "Lier verifiesArtifact, verifierKind et vantage ; utiliser les verdicts d’évaluation existants par observationResult lorsqu’ils sont rapportés."

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactVerificationObservation|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:check a gmeow:ArtifactVerificationObservation ."
msgstr "ex:check a gmeow:ArtifactVerificationObservation ."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierKind|http://www.w3.org/2000/01/rdf-schema#label"
msgid "verifier kind"
msgstr "type de vérificateur"

msgctxt "https://blackcatinformatics.ca/gmeow/verifierKind|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source-selected method of an artifact verification observation, independent of its result."
msgstr "Méthode choisie par la source pour une observation de vérification, indépendante du résultat."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierKind|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve the source’s verifier kind binding."
msgstr "Utiliser pour préserver le lien source : type de vérificateur."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierKind|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing evidence for verifierKind."
msgstr "Éviter d’inventer des éléments absents pour verifierKind."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierKind|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference the source-supported verifierKind target and preserve its attribution context."
msgstr "Référencer la cible verifierKind étayée par la source et préserver son contexte d’attribution."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierKind|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:verifierKind ex:target ."
msgstr "ex:record gmeow:verifierKind ex:target ."

msgctxt "https://blackcatinformatics.ca/gmeow/verifiesArtifact|http://www.w3.org/2000/01/rdf-schema#label"
msgid "verifies artifact"
msgstr "vérifie l’artefact"

msgctxt "https://blackcatinformatics.ca/gmeow/verifiesArtifact|http://www.w3.org/2004/02/skos/core#definition"
msgid "The exact artifact or version assessed by this observation, specializing observedFeature."
msgstr "Artefact ou version exacte évalué par cette observation, en spécialisant observedFeature."

msgctxt "https://blackcatinformatics.ca/gmeow/verifiesArtifact|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve the source’s verifies artifact binding."
msgstr "Utiliser pour préserver le lien source : vérifie l’artefact."

msgctxt "https://blackcatinformatics.ca/gmeow/verifiesArtifact|https://blackcatinformatics.ca/gmeow/avoidWhen"
