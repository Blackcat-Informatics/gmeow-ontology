# --------------------------------------------------------------------------- #
# Maritime zone types — UNCLOS-based (#93)
# --------------------------------------------------------------------------- #
gmeow:referenceTypeSurveyPlan rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:overlayTypeTerritorialSea      a gmeow:RegulatoryOverlayType ; rdfs:label "territorial sea"@x-gmeow-english ;
    skos:definition "A belt of coastal waters extending up to 12 nautical miles from the baseline of a coastal state, over which the state exercises sovereignty (UNCLOS Article 3)."@x-gmeow-english .
gmeow:overlayTypeTerritorialSea rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeContiguousZone      a gmeow:RegulatoryOverlayType ; rdfs:label "contiguous zone"@x-gmeow-english ;
    skos:definition "A band of water extending from the outer edge of the territorial sea to up to 24 nautical miles from the baseline, in which the coastal state may exercise control to prevent infringement of its customs, fiscal, immigration, or sanitary laws (UNCLOS Article 33)."@x-gmeow-english .
gmeow:overlayTypeContiguousZone rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeContinentalShelf    a gmeow:RegulatoryOverlayType ; rdfs:label "continental shelf"@x-gmeow-english ;
    skos:definition "The seabed and subsoil of the submarine areas that extend beyond the territorial sea to the outer edge of the continental margin, or to 200 nautical miles from the baseline where the margin does not extend that far (UNCLOS Article 76)."@x-gmeow-english .
gmeow:overlayTypeContinentalShelf rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeHighSeas            a gmeow:RegulatoryOverlayType ; rdfs:label "high seas"@x-gmeow-english ;
    skos:definition "All parts of the sea that are not included in the exclusive economic zone, territorial sea, or internal waters of a state (UNCLOS Article 86)."@x-gmeow-english .
gmeow:overlayTypeHighSeas rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeMarineProtectedArea a gmeow:RegulatoryOverlayType ; rdfs:label "marine protected area"@x-gmeow-english ;
    skos:definition "A clearly defined geographical space in the marine environment recognised, dedicated and managed through legal or other effective means to achieve the long-term conservation of nature with associated ecosystem services and cultural values (IUCN definition)."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Aviation zone types — ICAO / AIXM-based (#93)
# --------------------------------------------------------------------------- #
gmeow:overlayTypeMarineProtectedArea rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:overlayTypeAirway              a gmeow:RegulatoryOverlayType ; rdfs:label "airway"@x-gmeow-english ;
    skos:definition "A control area or portion thereof established in the form of a corridor equipped with navigation aids, designated by ICAO for channelling the flow of traffic."@x-gmeow-english .
gmeow:overlayTypeAirway rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeControlZone         a gmeow:RegulatoryOverlayType ; rdfs:label "control zone (CTR)"@x-gmeow-english ;
    skos:definition "A controlled airspace extending upwards from the surface of the earth to a specified upper limit, established around an aerodrome (ICAO)."@x-gmeow-english .
gmeow:overlayTypeControlZone rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeTerminalControlArea a gmeow:RegulatoryOverlayType ; rdfs:label "terminal control area (TMA/TCA)"@x-gmeow-english ;
    skos:definition "A controlled airspace normally established at the confluence of ATS routes in the vicinity of one or more major aerodromes (ICAO)."@x-gmeow-english .
gmeow:overlayTypeTerminalControlArea rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeFlightInformationRegion a gmeow:RegulatoryOverlayType ; rdfs:label "flight information region (FIR)"@x-gmeow-english ;
    skos:definition "An airspace of defined dimensions within which flight information service and alerting service are provided (ICAO)."@x-gmeow-english .
gmeow:overlayTypeFlightInformationRegion rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeAerodromeTrafficZone a gmeow:RegulatoryOverlayType ; rdfs:label "aerodrome traffic zone (ATZ)"@x-gmeow-english ;
    skos:definition "An area of protected airspace established around an aerodrome for the protection of aerodrome traffic."@x-gmeow-english .
gmeow:overlayTypeAerodromeTrafficZone rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeMilitaryOperationsArea a gmeow:RegulatoryOverlayType ; rdfs:label "military operations area (MOA)"@x-gmeow-english ;
    skos:definition "Airspace established outside controlled airspace to segregate certain military activities from IFR traffic and to identify for VFR traffic where these activities are conducted."@x-gmeow-english .
gmeow:overlayTypeMilitaryOperationsArea rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeWarningArea         a gmeow:RegulatoryOverlayType ; rdfs:label "warning area"@x-gmeow-english ;
    skos:definition "Airspace of defined dimensions, extending from 3 NM outward from the coast of the United States, that contains activity which may be hazardous to non-participating aircraft."@x-gmeow-english .
gmeow:overlayTypeWarningArea rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeAlertArea           a gmeow:RegulatoryOverlayType ; rdfs:label "alert area"@x-gmeow-english ;
    skos:definition "Airspace which may contain a high volume of pilot training or an unusual type of aerial activity, neither of which is hazardous to aircraft."@x-gmeow-english .
gmeow:overlayTypeAlertArea rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:overlayTypeNOTAM               a gmeow:RegulatoryOverlayType ; rdfs:label "notice to air missions (NOTAM)"@x-gmeow-english ;
    skos:definition "A temporary, dynamic regulatory overlay issued to notify pilots of potential hazards or changes to aeronautical facilities, services, or procedures. Typically short-validity; modeled as a RegulatoryOverlay with brief duringInterval."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# GeometryType value vocabulary & GeoJSON support (#82)
# --------------------------------------------------------------------------- #
gmeow:overlayTypeNOTAM rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:GeometryType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Geometry Type"@x-gmeow-english ;
    skos:definition "The structural kind of a geometry (point, line, polygon, multipoint, multilinestring, multipolygon). A value vocabulary (individuals, never subclasses) aligned by reference to GeoSPARQL simple-features (sf:Point, sf:LineString, sf:Polygon, etc.)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:geometryType
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Geometry ;
    rdfs:range gmeow:GeometryType ;
    rdfs:label "geometry type"@x-gmeow-english ;
    skos:definition "The structural kind of a geometry (a gmeow:GeometryType individual). Non-functional: competing source classifications may differ (e.g. polygon vs multipolygon) and must coexist as evidence."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:geometryTypePoint           a gmeow:GeometryType ; rdfs:label "point"@x-gmeow-english .
gmeow:geometryTypePoint skos:definition "The point geometry type — a Simple Features shape class used to represent a spatial extent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:geometryTypeLineString      a gmeow:GeometryType ; rdfs:label "line string"@x-gmeow-english .
gmeow:geometryTypeLineString skos:definition "The line string geometry type — a Simple Features shape class used to represent a spatial extent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:geometryTypePolygon         a gmeow:GeometryType ; rdfs:label "polygon"@x-gmeow-english .
gmeow:geometryTypePolygon skos:definition "The polygon geometry type — a Simple Features shape class used to represent a spatial extent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:geometryTypeMultiPoint      a gmeow:GeometryType ; rdfs:label "multi-point"@x-gmeow-english .
gmeow:geometryTypeMultiPoint skos:definition "The multi point geometry type — a Simple Features shape class used to represent a spatial extent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:geometryTypeMultiLineString a gmeow:GeometryType ; rdfs:label "multi-line string"@x-gmeow-english .
gmeow:geometryTypeMultiLineString skos:definition "The multi line string geometry type — a Simple Features shape class used to represent a spatial extent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:geometryTypeMultiPolygon    a gmeow:GeometryType ; rdfs:label "multi-polygon"@x-gmeow-english .
gmeow:geometryTypeMultiPolygon skos:definition "The multi polygon geometry type — a Simple Features shape class used to represent a spatial extent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:asGeoJSON
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Geometry ;
    rdfs:range rdfs:Literal ;
    rdfs:label "as GeoJSON"@x-gmeow-english ;
    skos:definition "A GeoJSON serialization of a geometry. The range is rdfs:Literal (not geo:geoJSONLiteral) to stay within the OWL 2 DL datatype map; data may still tag the literal ^^geo:geoJSONLiteral, and the alignment to geo:asGeoJSON preserves GeoSPARQL semantics for spatial engines."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

# --------------------------------------------------------------------------- #
# Place determinacy & lifecycle wiring (#82)
# --------------------------------------------------------------------------- #

gmeow:placeDeterminacy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasDeterminacy ;
    rdfs:domain gmeow:Place ;
    rdfs:range gmeow:Determinacy ;
    rdfs:label "place determinacy"@x-gmeow-english ;
    skos:definition "The ontic determinacy model of a place's existence or boundary — crisp, vague, fuzzy, probabilistic, or disputed. Non-functional: in a multi-source merge, sources may state different determinacy models, and those claims coexist."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:geometryDeterminacy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasDeterminacy ;
    rdfs:domain gmeow:Geometry ;
    rdfs:range gmeow:Determinacy ;
    rdfs:label "geometry determinacy"@x-gmeow-english ;
    skos:definition "The ontic determinacy model of a geometry's boundary — crisp (surveyed), vague (approximate), fuzzy (probabilistic), or disputed. Non-functional: competing source classifications coexist."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:placeSupersededBy
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:placeSupersedes ;
    rdfs:subPropertyOf gmeow:supersededBy ;
    rdfs:domain gmeow:Place ;
    rdfs:range gmeow:Place ;
    rdfs:label "place superseded by"@x-gmeow-english ;
    skos:definition "Links a place to the place that replaced it — Constantinople placeSupersededBy Istanbul, a merged municipality placeSupersededBy its successor. Directional. The superseded place is retained (never deleted) and may carry gmeow:displayable false."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:placeSupersedes
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:placeSupersededBy ;
    rdfs:subPropertyOf gmeow:supersedes ;
    rdfs:domain gmeow:Place ;
    rdfs:range gmeow:Place ;
    rdfs:label "place supersedes"@x-gmeow-english ;
    skos:definition "Links a newer place to a prior one it supersedes. Inverse of gmeow:placeSupersededBy. Non-functional: one successor may consolidate several predecessors."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

# AXIOMATIZED DOCTRINE — open-world EL someValuesFrom on the time-scoped relators.
# Closed-world "exactly one" cardinality is enforced by SHACL (JurisdictionTenureShape,
# ContainmentTenureShape, LandTenureShape). gmeow:JurisdictionTenure,
# gmeow:ContainmentTenure, and gmeow:LandTenure are gufo:Situation subtypes, not
# gufo:Relators, so they carry gmeow:duringInterval (inherited from TimeScopedRelation)
# rather than a relator interval.

gmeow:JurisdictionTenure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:jurisdictionPlace ; owl:someValuesFrom gmeow:Place ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:jurisdictionPolity ; owl:someValuesFrom gmeow:Agent ] .

gmeow:ContainmentTenure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:containmentChild ; owl:someValuesFrom gmeow:Place ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:containmentParent ; owl:someValuesFrom gmeow:Place ] .

gmeow:RegulatoryOverlay rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:overlayPlace ; owl:someValuesFrom gmeow:Place ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:overlayAuthority ; owl:someValuesFrom gmeow:Agent ] .

gmeow:LandTenure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:tenurePlace ; owl:someValuesFrom gmeow:Place ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:tenureParty ; owl:someValuesFrom gmeow:Agent ] .

# Multilingual / historical place names are NOT a flat literal: a place bears
# co-equal gmeow:PlaceName appellations via gmeow:hasPlaceName (names module),
# their endonym/exonym purpose, language frame and toponymic authority carried by
# the inferred gmeow:PlaceNaming (≡ NameUsage ⊓ ∃usageNamed.Place). The former
# flat gmeow:alternateName literal was retired in favour of that model (Principle 6).

# =========================================================================== #
# AXIOMATIZED DOCTRINE (#38 — phase 2 of the reasoning-depth epic #35)
#
# Location propagates through geographic containment: a thing located AT a place
# is located at every place that CONTAINS it (a desk in a room is in the
# building, the city, the country). Expressed as the EL property chain
# locatedAt ∘ containedInLocation ⊑ locatedAt. gmeow:containedInLocation is already
# transitive (room ⊂ city is derived), so the two compose. This is the regular
# R ∘ S ⊑ R form (containedInLocation ≺ locatedAt); locatedAt thereby becomes
# non-simple and is kept out of all cardinality axioms, preserving OWL 2 DL.
# =========================================================================== #

gmeow:locatedAt owl:propertyChainAxiom ( gmeow:locatedAt gmeow:containedInLocation ) .

# =========================================================================== #
# AXIOMATIZED DOCTRINE (#125) — property chains for coordinate/geometry
#
# hasCoordinates and hasGeometry are flat shortcuts derived from the reified
# CoordinateObservation path. Expressed as:
#   hasCoordinateObservation ∘ coordinateResult ⊑ hasCoordinates
#   hasCoordinateObservation ∘ geometryResult   ⊑ hasGeometry
#
# These are OWL 2 DL regular because coordinateResult and geometryResult are
# simple properties (no transitivity, symmetry, or inverse), and the chains
# are the regular R ∘ S ⊑ T form. hasCoordinates and hasGeometry thereby
# become non-simple and are kept out of all cardinality axioms.
# =========================================================================== #

gmeow:hasCoordinates owl:propertyChainAxiom ( gmeow:hasCoordinateObservation gmeow:coordinateResult ) .
gmeow:hasGeometry    owl:propertyChainAxiom ( gmeow:hasCoordinateObservation gmeow:geometryResult ) .

# --------------------------------------------------------------------------- #
# Capacity / Occupancy / Utilization — cross-cutting location measurements (#100)
# --------------------------------------------------------------------------- #
# Capacity, occupancy, and utilization are reified Measurements following the
# ProximityMeasurement pattern (places.ttl § Proximity / Distance). The location
# is the observedFeature; the result is a ScalarQuantity with unit (QUDT). The
# "what is being counted" is implicit from the location's placeType and the unit
# (P11: frame-relativity). Utilization, overflow detection, and occupancy
# counting from locatedAt / LocationState are solver-layer computations (P12).
# --------------------------------------------------------------------------- #

gmeow:Capacity
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Measurement ;
    rdfs:label "Capacity"@x-gmeow-english ;
    skos:definition "A measurement of the maximum number of entities a location can hold. The location is the observedFeature; the result is a ScalarQuantity. The entity kind being counted is implicit from the location's placeType and the ScalarQuantity's hasUnit (P11). A contested capacity (e.g., fire code vs. venue claim) is modelled as multiple co-existing Capacity measurements, each standpoint-indexed and confidence-weighted, never collapsing to a single winner (P9). A superseded capacity (e.g., after renovation) is suppressed via displayable false, never deleted (P10)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:capacityOf
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf gmeow:observedFeature ;
    rdfs:domain gmeow:Capacity ;
    rdfs:range gmeow:Location ;
    rdfs:label "capacity of"@x-gmeow-english ;
    skos:definition "The location whose capacity is measured. Functional: a capacity measurement concerns exactly one location (constitutive of the measurement's identity)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:hasCapacity
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:capacityOf ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Capacity ;
    rdfs:label "has capacity"@x-gmeow-english ;
    skos:definition "Links a location to a capacity measurement describing the maximum number of entities it can hold. Flat form for the common case; promote to full reified Capacity when vantage, confidence, temporal scope, or standpoint matter."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:Occupancy
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Measurement ;
    rdfs:label "Occupancy"@x-gmeow-english ;
    skos:definition "A measurement of the current number of entities located at or within a location. The location is the observedFeature; the result is a ScalarQuantity. Typically computed by the solver layer from locatedAt relationships and active LocationState instances (P12), but may also be asserted directly from sensor readings or manual counts."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:occupancyOf
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf gmeow:observedFeature ;
    rdfs:domain gmeow:Occupancy ;
    rdfs:range gmeow:Location ;
    rdfs:label "occupancy of"@x-gmeow-english ;
    skos:definition "The location whose occupancy is measured. Functional: an occupancy measurement concerns exactly one location (constitutive of the measurement's identity)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:hasOccupancy
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:occupancyOf ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Occupancy ;
    rdfs:label "has occupancy"@x-gmeow-english ;
    skos:definition "Links a location to an occupancy measurement describing the current number of entities located at it. Flat form for the common case; promote to full reified Occupancy when vantage, confidence, temporal scope, or standpoint matter."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:Utilization
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Measurement ;
    rdfs:label "Utilization"@x-gmeow-english ;
    skos:definition "A measurement of the ratio of current occupancy to maximum capacity at a location, typically expressed as a ratio (0–1) or percentage. The location is the observedFeature; the result is a ScalarQuantity. Computed by the solver layer (P12) from capacity and occupancy measurements, not asserted directly in the canonical core."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:utilizationOf
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf gmeow:observedFeature ;
    rdfs:domain gmeow:Utilization ;
    rdfs:range gmeow:Location ;
    rdfs:label "utilization of"@x-gmeow-english ;
    skos:definition "The location whose utilization is measured. Functional: a utilization measurement concerns exactly one location (constitutive of the measurement's identity)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:hasUtilization
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:utilizationOf ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Utilization ;
    rdfs:label "has utilization"@x-gmeow-english ;
    skos:definition "Links a location to a utilization measurement describing the ratio of occupancy to capacity. Flat form for the common case; promote to full reified Utilization when vantage, confidence, temporal scope, or standpoint matter."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

# --------------------------------------------------------------------------- #
# Celestial Object Type — VALUE vocabulary (open; individuals, not classes) (#85)
# --------------------------------------------------------------------------- #

gmeow:CelestialObjectType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Celestial Object Type"@x-gmeow-english ;
    skos:definition "The kind of an astronomical object (star, galaxy, nebula, planet, asteroid, spacecraft, etc.). A value, not a CelestialLocation subclass: the set is open-ended (IVOA object-type vocabulary lists ~100 types) and they share the same structure."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:celestialObjectTypeStar       a gmeow:CelestialObjectType ; rdfs:label "star"@x-gmeow-english .
gmeow:celestialObjectTypeStar skos:definition "The star celestial object type — a category of astronomical entity by its physical nature or scale."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:celestialObjectTypeGalaxy     a gmeow:CelestialObjectType ; rdfs:label "galaxy"@x-gmeow-english .
gmeow:celestialObjectTypeGalaxy skos:definition "The galaxy celestial object type — a category of astronomical entity by its physical nature or scale."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:celestialObjectTypeNebula     a gmeow:CelestialObjectType ; rdfs:label "nebula"@x-gmeow-english .
gmeow:celestialObjectTypeNebula skos:definition "The nebula celestial object type — a category of astronomical entity by its physical nature or scale."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:celestialObjectTypePlanet     a gmeow:CelestialObjectType ; rdfs:label "planet"@x-gmeow-english .
gmeow:celestialObjectTypePlanet skos:definition "The planet celestial object type — a category of astronomical entity by its physical nature or scale."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:celestialObjectTypeAsteroid   a gmeow:CelestialObjectType ; rdfs:label "asteroid"@x-gmeow-english .
gmeow:celestialObjectTypeAsteroid skos:definition "The asteroid celestial object type — a category of astronomical entity by its physical nature or scale."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:celestialObjectTypeComet      a gmeow:CelestialObjectType ; rdfs:label "comet"@x-gmeow-english .
gmeow:celestialObjectTypeComet skos:definition "The comet celestial object type — a category of astronomical entity by its physical nature or scale."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:celestialObjectTypeSpacecraft a gmeow:CelestialObjectType ; rdfs:label "spacecraft / artificial satellite"@x-gmeow-english .
gmeow:celestialObjectTypeSpacecraft skos:definition "The spacecraft celestial object type — a category of astronomical entity by its physical nature or scale."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:celestialObjectTypeCluster    a gmeow:CelestialObjectType ; rdfs:label "star cluster"@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Celestial Reference Origin — VALUE vocabulary (IVOA refposition alignment) (#85)
# --------------------------------------------------------------------------- #
gmeow:celestialObjectTypeCluster skos:definition "The cluster celestial object type — a category of astronomical entity by its physical nature or scale."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:CelestialReferenceOrigin
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Celestial Reference Origin"@x-gmeow-english ;
    skos:definition "The origin of a celestial coordinate system (topocentric, geocentric, barycentric, heliocentric, etc.). A value vocabulary aligned to IVOA refposition."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:refOriginTopocentric  a gmeow:CelestialReferenceOrigin ; rdfs:label "topocentric (observatory site)"@x-gmeow-english .
gmeow:refOriginTopocentric skos:definition "The topocentric celestial reference origin — a geometric origin point relative to which celestial coordinates are expressed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:refOriginGeocentric   a gmeow:CelestialReferenceOrigin ; rdfs:label "geocentric"@x-gmeow-english .
gmeow:refOriginGeocentric skos:definition "The geocentric celestial reference origin — a geometric origin point relative to which celestial coordinates are expressed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:refOriginBarycentric  a gmeow:CelestialReferenceOrigin ; rdfs:label "barycentric (solar system)"@x-gmeow-english .
gmeow:refOriginBarycentric skos:definition "The barycentric celestial reference origin — a geometric origin point relative to which celestial coordinates are expressed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:refOriginHeliocentric a gmeow:CelestialReferenceOrigin ; rdfs:label "heliocentric"@x-gmeow-english .

# Mathematical / n-D Reference Frame seeds (#86)
# --------------------------------------------------------------------------- #
gmeow:refOriginHeliocentric skos:definition "The heliocentric celestial reference origin — a geometric origin point relative to which celestial coordinates are expressed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:referenceFramePhaseSpace3DOF
    a gmeow:ReferenceFrame ;
    rdfs:label "Abstract Phase Space Reference Frame (q,p axes)"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmMathematical ;
    gmeow:hasAxis gmeow:axisGeneralizedCoordinate, gmeow:axisGeneralizedMomentum ;
    gmeow:dimensionCount "2"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindPhaseSpace ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricSymplectic .
gmeow:referenceFramePhaseSpace3DOF skos:definition "The phase space 3 dof reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:referenceFrameHilbertSpace
    a gmeow:ReferenceFrame ;
    rdfs:label "Hilbert Space Reference Frame"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmMathematical ;
    gmeow:hasAxis gmeow:axisHilbertState ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindHilbert ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricEuclidean .
gmeow:referenceFrameHilbertSpace skos:definition "The hilbert space reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:referenceFrameLatentVectorSpace
    a gmeow:ReferenceFrame ;
    rdfs:label "Latent Vector Space Reference Frame"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmMathematical ;
    gmeow:hasAxis gmeow:axisLatentVector ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindLatentSpace ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricCosine .
gmeow:referenceFrameLatentVectorSpace skos:definition "The latent vector space reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:referenceFrameRobotArm6DOF
    a gmeow:ReferenceFrame ;
    rdfs:label "6-DOF Robot Arm Configuration Space"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmMathematical ;
    gmeow:hasAxis gmeow:axisJointAngle1, gmeow:axisJointAngle2, gmeow:axisJointAngle3,
                  gmeow:axisJointAngle4, gmeow:axisJointAngle5, gmeow:axisJointAngle6 ;
    gmeow:dimensionCount "6"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindManifold ;
    gmeow:requiresHost true ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricEuclidean .

# =========================================================================== #
# BIOLOGICAL-SEQUENCE REALM — FALDO / Sequence Ontology / GFF3 (#90)
# =========================================================================== #
# A reference assembly (GRCh38) is a versioned ReferenceFrame / datum;
# a feature is a range (SequenceCoordinates with start, end, strand) in that
# frame. FALDO = positions, SO = feature types; liftover = solver (P12).
# =========================================================================== #
gmeow:referenceFrameRobotArm6DOF skos:definition "The robot arm 6 dof reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:BiologicalSequenceLocation
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Location ;
    rdfs:label "Biological Sequence Location"@x-gmeow-english ;
    skos:definition "A sequence-level container locus — a chromosome, contig, scaffold, or the sequence itself — that hosts SequenceFeature annotations via gmeow:hasSequenceFeature. The features themselves (genes, exons, SNPs, etc.) are SequenceFeature instances with their own coordinates and types; they are not BiologicalSequenceLocation instances."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:SequenceFeature
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Sequence Feature"@x-gmeow-english ;
    skos:definition "A feature or annotation on a biological sequence — a range with start, end, strand, and type, expressed in a reference assembly frame. The first-class entity that carries the coordinates and type; linked to a BiologicalSequenceLocation via gmeow:hasSequenceFeature."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:SequenceCoordinates
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Sequence Coordinates"@x-gmeow-english ;
    skos:definition "Frame-relative coordinates on a biological sequence: a start position, an end position, and a strand orientation, all expressed relative to an explicit reference assembly (Principle 11)."@x-gmeow-english ;
    gmeow:requiresFrame gmeow:inReferenceAssembly ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:StrandOrientation
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Strand Orientation"@x-gmeow-english ;
    skos:definition "The strand direction of a feature on a double-stranded biological sequence (forward / Watson, reverse / Crick, or both). A value, not a subclass: the set is closed and they share the same structure."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:SequenceFeatureType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Sequence Feature Type"@x-gmeow-english ;
    skos:definition "The kind of a sequence feature (gene, exon, intron, CDS, SNP, chromosome, etc.). A value, not a subclass: the set is open-ended (Sequence Ontology lists ~2000 types) and they share all of SequenceFeature's structure, so a new kind is a new individual, not a new class (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:hasSequenceFeature
    a owl:ObjectProperty ;
    rdfs:domain gmeow:BiologicalSequenceLocation ;
    rdfs:range gmeow:SequenceFeature ;
    rdfs:label "has sequence feature"@x-gmeow-english ;
    skos:definition "Links a biological sequence location to a feature annotation on that sequence. Non-functional: a single location may carry multiple features (overlapping genes, nested exons, multiple SNPs)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:hasSequenceCoordinates
    a owl:ObjectProperty ;
    rdfs:domain gmeow:SequenceFeature ;
    rdfs:range gmeow:SequenceCoordinates ;
    rdfs:label "has sequence coordinates"@x-gmeow-english ;
    skos:definition "Links a sequence feature to its frame-relative coordinates. Non-functional: competing coordinate claims from different assemblies or alignment methods coexist as evidence (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:inReferenceAssembly
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf gmeow:hasReferenceFrame ;
    rdfs:domain gmeow:SequenceCoordinates ;
    rdfs:range gmeow:ReferenceFrame ;
    rdfs:label "in reference assembly"@x-gmeow-english ;
    skos:definition "The reference assembly (e.g. GRCh38) in which these sequence coordinates are expressed. Functional: a coordinate tuple is expressed in exactly one assembly; coordinates in another assembly are a different SequenceCoordinates instance (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:sequenceStart
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:SequenceCoordinates ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "sequence start"@x-gmeow-english ;
    skos:definition "The 1-based inclusive start position of a feature on a biological sequence. Frame-relative: the meaning depends on the inReferenceAssembly (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:sequenceEnd
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:SequenceCoordinates ;
    rdfs:range xsd:positiveInteger ;
    rdfs:label "sequence end"@x-gmeow-english ;
    skos:definition "The 1-based inclusive end position of a feature on a biological sequence. Frame-relative: the meaning depends on the inReferenceAssembly (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:sequenceStrand
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:SequenceCoordinates ;
    rdfs:range gmeow:StrandOrientation ;
    rdfs:label "sequence strand"@x-gmeow-english ;
    skos:definition "The strand orientation of a feature on a double-stranded biological sequence."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:sequenceFeatureType
    a owl:ObjectProperty ;
    rdfs:domain gmeow:SequenceFeature ;
    rdfs:range gmeow:SequenceFeatureType ;
    rdfs:label "sequence feature type"@x-gmeow-english ;
    skos:definition "The kind(s) of a sequence feature (one or more gmeow:SequenceFeatureType individuals). Non-functional: multi-source classifications may differ (a feature classified as both 'gene' and 'pseudogene' by different sources) and must coexist as evidence (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

# Seeds for StrandOrientation
gmeow:strandForward a gmeow:StrandOrientation ; rdfs:label "forward / Watson strand"@x-gmeow-english .
gmeow:strandForward skos:definition "The forward strand orientation — a directionality of a nucleic-acid strand relative to its counterpart."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:strandReverse a gmeow:StrandOrientation ; rdfs:label "reverse / Crick strand"@x-gmeow-english .
gmeow:strandReverse skos:definition "The reverse strand orientation — a directionality of a nucleic-acid strand relative to its counterpart."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:strandBoth    a gmeow:StrandOrientation ; rdfs:label "both strands"@x-gmeow-english ;
    skos:definition "Applies to both strands, e.g. some regulatory regions."@x-gmeow-english .

# Seeds for SequenceFeatureType (aligned to Sequence Ontology by reference)
gmeow:strandBoth rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:sequenceFeatureTypeGene       a gmeow:SequenceFeatureType ; rdfs:label "gene"@x-gmeow-english .
gmeow:sequenceFeatureTypeGene skos:definition "The gene sequence feature type — a kind of biological feature identified along a genetic or molecular sequence."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:sequenceFeatureTypeExon       a gmeow:SequenceFeatureType ; rdfs:label "exon"@x-gmeow-english .
gmeow:sequenceFeatureTypeExon skos:definition "The exon sequence feature type — a kind of biological feature identified along a genetic or molecular sequence."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:sequenceFeatureTypeIntron     a gmeow:SequenceFeatureType ; rdfs:label "intron"@x-gmeow-english .
gmeow:sequenceFeatureTypeIntron skos:definition "The intron sequence feature type — a kind of biological feature identified along a genetic or molecular sequence."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:sequenceFeatureTypeCDS        a gmeow:SequenceFeatureType ; rdfs:label "coding sequence (CDS)"@x-gmeow-english .
gmeow:sequenceFeatureTypeCDS skos:definition "The cds sequence feature type — a kind of biological feature identified along a genetic or molecular sequence."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:sequenceFeatureTypeSNP        a gmeow:SequenceFeatureType ; rdfs:label "single nucleotide polymorphism (SNP)"@x-gmeow-english .
gmeow:sequenceFeatureTypeSNP skos:definition "The snp sequence feature type — a kind of biological feature identified along a genetic or molecular sequence."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:sequenceFeatureTypeChromosome a gmeow:SequenceFeatureType ; rdfs:label "chromosome"@x-gmeow-english .

# Seed ReferenceFrame — GRCh38 human reference assembly
gmeow:sequenceFeatureTypeChromosome skos:definition "The chromosome sequence feature type — a kind of biological feature identified along a genetic or molecular sequence."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:referenceFrameGRCh38
    a gmeow:ReferenceFrame ;
    rdfs:label "GRCh38 Human Reference Assembly"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmBiological ;
    gmeow:hasAxis gmeow:axisSequencePosition ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindLinearSequence ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricPositionalDistance .

# --------------------------------------------------------------------------- #
# Geocoding Reference Frames (#91)
# --------------------------------------------------------------------------- #
# Alternative geocoding systems as ReferenceFrames over Earth. The code value
# is carried on a Geocode instance via gmeow:hasCoordinateMatrix (identifier)
# or the per-system datatype property. Conversion to WGS84 = solver (P12).
# --------------------------------------------------------------------------- #
gmeow:referenceFrameGRCh38 skos:definition "The gr ch 38 reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:referenceFramePlusCode
    a gmeow:ReferenceFrame ;
    rdfs:label "Plus Code (Open Location Code) Reference Frame"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmTerrestrial ;
    gmeow:hasAxis gmeow:axisPlusCode ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindGeocoding ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricGeodesic .
gmeow:referenceFramePlusCode skos:definition "The plus code reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:referenceFrameWhat3Words
    a gmeow:ReferenceFrame ;
    rdfs:label "what3words Reference Frame"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmTerrestrial ;
    gmeow:hasAxis gmeow:axisWhat3Words ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindGeocoding ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricGeodesic .
gmeow:referenceFrameWhat3Words skos:definition "The what 3 words reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:referenceFrameGeohash
    a gmeow:ReferenceFrame ;
    rdfs:label "Geohash Reference Frame"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmTerrestrial ;
    gmeow:hasAxis gmeow:axisGeohash ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindGeocoding ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricGeodesic .
gmeow:referenceFrameGeohash skos:definition "The geohash reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:referenceFrameMGRS
    a gmeow:ReferenceFrame ;
    rdfs:label "MGRS Reference Frame"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmTerrestrial ;
    gmeow:hasAxis gmeow:axisMGRS ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindGeocoding ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricGeodesic .
gmeow:referenceFrameMGRS skos:definition "The mgrs reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:referenceFrameUNLocode
    a gmeow:ReferenceFrame ;
    rdfs:label "UN/LOCODE Reference Frame"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmTerrestrial ;
    gmeow:hasAxis gmeow:axisUNLocode ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindGeocoding ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricGraphHops .
gmeow:referenceFrameUNLocode skos:definition "The un locode reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:referenceFrameMileMarker
    a gmeow:ReferenceFrame ;
    rdfs:label "Linear Referencing (Mile Marker) Reference Frame"@x-gmeow-english ;
