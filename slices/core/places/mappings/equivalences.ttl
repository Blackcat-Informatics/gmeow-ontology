# --------------------------------------------------------------------------- #
# time-scoped place design — Terrestrial realm deepening: new term alignments
# --------------------------------------------------------------------------- #

# LinkedGeoData
gmeow:Place skos:closeMatch lgdo:Place {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

gmeow:containedInPlace skos:closeMatch lgdo:parentPlace {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7
|} .

# CIDOC-CRM + CRMgeo
gmeow:JurisdictionTenure skos:closeMatch crm:E4_Period {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:objectLabel "Period" ;
    gmeow:comment "CIDOC-CRM E4_Period captures the time-spanned governance period; GMEOW JurisdictionTenure adds the place×polity relator structure and standpoint indexing."
|} .

gmeow:PlaceNaming skos:closeMatch crm:E41_Appellation {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Appellation" ;
    gmeow:comment "CIDOC-CRM E41_Appellation is the time-spanned name; GMEOW PlaceNaming is the reified relator (NameUsage) that binds a PlaceName to a Place over an interval."
|} .

gmeow:Place skos:closeMatch crmgeo:SP5_Geometric_Place_Expression {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:objectLabel "Geometric Place Expression"
|} .

# Pleiades
gmeow:Place skos:closeMatch pleiades:Place {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:hasPlaceName skos:closeMatch pleiades:Name {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

# WHG (World Historical Gazetteer)
gmeow:Place skos:closeMatch whg:Place {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
