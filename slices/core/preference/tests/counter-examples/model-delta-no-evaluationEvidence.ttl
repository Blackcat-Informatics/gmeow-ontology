#
# Counter-example for gmeow:ModelConfigDeltaCompletenessConstraint (AC5): a
# gmeow:ModelConfigDelta binds TEN of its eleven mandatory identity legs but OMITS
# gmeow:deltaEvaluationEvidence — a partial delta is not a reproducible identity. The ∀→∃(∧×11)
# SPARQL constraint MUST reject it with shacl.SPARQLConstraintComponent and NO other
# finding; every other leg is present, isolating the missing evaluationEvidence leg.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/preference/tests/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# The bound identity-leg nodes (the omitted leg has no node/edge).
ex:baseCkpt a gmeow:ModelArtifact ; gmeow:contentDigest "0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a0a"^^gmeow:blake3_256Digest .
ex:tok1 a gmeow:TokenizerContract ; gmeow:contentDigest "1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b1b"^^gmeow:blake3_256Digest .
ex:cb1 a gmeow:CodebookContract ; gmeow:contentDigest "2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c"^^gmeow:blake3_256Digest .
ex:dpoLoss a gmeow:DisclosedLossEntry ; gmeow:droppedRelation ex:flattenedEdge .
ex:flattenedEdge a math:Relation .
ex:dpoCand a gmeow:InformationObject .
ex:dpoSet a gmeow:CandidateSet ; gmeow:hasCandidate ex:dpoCand .
ex:rec1 a gmeow:DpoView ;
    gmeow:projectionKind gmeow:projectionPairwise ;
    gmeow:projectionSourceSet ex:dpoSet ;
    gmeow:projectionDeterminism gmeow:determinismDeterministic ;
    gmeow:tieBreakRule "chosen-over-rejected-stable" ;
    gmeow:disclosesLoss ex:dpoLoss ;
    logic:preservationKind logic:SoundUnderApproximation ;
    gmeow:contentDigest "3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d"^^gmeow:blake3_256Digest .
ex:sq1 a gmeow:SelectionQuery ; gmeow:contentDigest "4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e4e"^^gmeow:blake3_256Digest .
ex:sysPrompt a gmeow:Prompt ; gmeow:contentDigest "5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f5f"^^gmeow:blake3_256Digest .
ex:rubric1 a gmeow:Rubric ; gmeow:contentDigest "6060606060606060606060606060606060606060606060606060606060606060"^^gmeow:blake3_256Digest .
ex:eng1 a gmeow:EngineContract ; gmeow:contentDigest "7171717171717171717171717171717171717171717171717171717171717171"^^gmeow:blake3_256Digest .
ex:opt1 a gmeow:OptimizerContract ; gmeow:contentDigest "8282828282828282828282828282828282828282828282828282828282828282"^^gmeow:blake3_256Digest .

# The DEFECT: the delta omits gmeow:deltaEvaluationEvidence (only ten legs bound).
ex:delta1 a gmeow:ModelConfigDelta ;
    rdfs:label "a model/config delta missing its evaluationEvidence leg"@en ;
    gmeow:deltaBaseArtifact ex:baseCkpt ;
    gmeow:deltaTokenizer ex:tok1 ;
    gmeow:deltaCodebook ex:cb1 ;
    gmeow:deltaDatasetProjection ex:rec1 ;
    gmeow:deltaSelectionQuery ex:sq1 ;
    gmeow:deltaPromptIdentity ex:sysPrompt ;
    gmeow:deltaRubricIdentity ex:rubric1 ;
    gmeow:deltaEngine ex:eng1 ;
    gmeow:deltaOptimizer ex:opt1 ;
    gmeow:deltaSeed 42 ;
    gmeow:contentDigest "9393939393939393939393939393939393939393939393939393939393939393"^^gmeow:blake3_256Digest .
