# SPDX-License-Identifier: CC-BY-4.0
#
# Declarative structural assertions for the places slice -- the slice-resident
# test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants formerly
# hand-written in tests/test_places.py. Each assertion runs as a SPARQL ASK
# over the places module graph (gmeow:scopeModule) under the native Rust
# slicetest harness (crates/slicetest).
#
# Places IS migrated: class stereotypes are logic:
# (logic:Kind, logic:QualityValue), NOT gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_location_superset_core -- walks blank-node owl:unionOf lists via
#     g.items(), sweeps owl:AllDisjointProperties subjects dynamically, and
#     checks a locatedAt owl:propertyChainAxiom bnode list; bnode graph
#     structure is not expressible as a module-scoped ASK.
#   test_has_coordinate_matrix_includes_geocode -- same bnode unionOf walk.
#   test_has_coordinates_property_chain -- bnode property-chain list check.
#   test_has_geometry_property_chain -- bnode property-chain list check.
#   test_no_unsafe_motion_property_chains -- uses graph.triples() dynamic
#     sweep over a live subject list; a module-scoped cell would silently
#     narrow this regression guard.
#   test_place_type_parcel_exists -- checks graph.value() label string
#     contents ("parcel" not in label); string-content checks are not ASK.
#   test_contested_* / test_superseded_* / test_lapsed_* -- load fixture
#     files and call SHACL validation; multi-file ABox + ExampleConformance checks.
#   test_location_stream_to_trajectory_derivation,
#   test_stream_and_trajectory_coexist -- load places-streaming.ttl fixture
#     and call SHACL validation; ABox checks.
#   test_geocode_shape_valid / test_geocode_shape_invalid_* -- SHACL validation
#     calls; ExampleConformance, not structural TBox assertions.
#   test_biological_coverage_passes_shacl,
#   test_biological_standpoint_coordinate_claims_coexist -- SHACL validation;
#     ABox / ExampleConformance checks.
#   test_cadastral_coverage_passes_shacl, test_land_tenure_instance_structure,
#   test_cadastral_reference_instance_structure,
#   test_contested_land_tenures_coexist, test_lapsed_tenure_suppressed_not_deleted,
#   test_cadastral_reference_multiple_types_coexist -- SHACL validation or ABox
#     fixture sweeps; not structural TBox assertions.
#   test_occupancy_with_unit_asserted, test_storage_capacity_in_bytes --
#     numeric Decimal equality checks on ABox fixture values.
#   test_geometry_has_type_and_geojson -- ABox fixture object sweep.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/places/tests/> .

# --- 1. Location umbrella and structural subclasses (MUST) --------------------
ex:saLocationUmbrellaSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Location        rdfs:subClassOf gmeow:Entity .
    gmeow:Place           rdfs:subClassOf gmeow:Location .
    gmeow:VirtualLocation rdfs:subClassOf gmeow:Location .
    gmeow:StorageLocation rdfs:subClassOf gmeow:Location .
}""" ;
    gmeow:saRationale "gmeow:Location MUST be a subclass of gmeow:Entity and Place, VirtualLocation, StorageLocation MUST each be subclasses of Location -- the three structural subtypes of the umbrella." .

# --- 2. alternateName is retired as any property (MUST-NOT) -------------------
ex:saAlternateNameRetired a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?t { owl:DatatypeProperty owl:ObjectProperty owl:AnnotationProperty }
    gmeow:alternateName a ?t .
}""" ;
    gmeow:saRationale "gmeow:alternateName MUST NOT exist as any property -- retired in favour of gmeow:PlaceName appellations via gmeow:hasPlaceName (Principle 6)." .

# --- 4. PlaceType subclasses logic:QualityValue and placeType is non-functional ObjectProperty (MUST) ---
ex:saPlaceTypeIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PlaceType rdfs:subClassOf logic:QualityValue .
    gmeow:placeType a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:PlaceType MUST be a subclass of logic:QualityValue and gmeow:placeType MUST be an owl:ObjectProperty -- place kinds are value individuals, not subclasses (Principle 9)." .

# --- 5. placeType is NOT functional (MUST-NOT) --------------------------------
ex:saPlaceTypeNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:placeType a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:placeType MUST NOT be owl:FunctionalProperty -- a place may have multiple co-equal type claims (Principle 9)." .

# --- 6. PlaceType seed individuals exist (MUST) --------------------------------
ex:saPlaceTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:placeTypeCountry  a gmeow:PlaceType .
    gmeow:placeTypeCity     a gmeow:PlaceType .
    gmeow:placeTypeRoom     a gmeow:PlaceType .
    gmeow:placeTypePremises a gmeow:PlaceType .
    gmeow:placeTypeSite     a gmeow:PlaceType .
}""" ;
    gmeow:saRationale "The five core PlaceType seed individuals MUST exist as gmeow:PlaceType values, not classes (anti-subclass guard)." .

# --- 7. Rejected per-kind subclasses do NOT exist as classes (MUST-NOT) --------
ex:saRejectedPlaceSubclassesGone a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned { gmeow:Country gmeow:City gmeow:Building gmeow:Room gmeow:Site }
    ?banned a owl:Class .
}""" ;
    gmeow:saRationale "gmeow:Country, City, Building, Room, and Site MUST NOT exist as owl:Class -- the per-kind-subclass pattern was permanently refactored to PlaceType value individuals." .

# --- 8. storageMedium is an ObjectProperty (MUST) -----------------------------
ex:saStorageMediumIsFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:storageMedium a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:storageMedium MUST be an owl:ObjectProperty -- the medium is constitutive of the storage location (like keyScheme), not a descriptive co-equal; its functionality is now carried by a logic:PropertyCharacteristicAssertion (DL-enforced)." .

# --- 9. StorageMedium seed individuals exist (MUST) ---------------------------
ex:saStorageMediumSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:storageMediumCloudService  a gmeow:StorageMedium .
    gmeow:storageMediumPhysicalDisk  a gmeow:StorageMedium .
}""" ;
    gmeow:saRationale "The two core StorageMedium seed individuals MUST exist as gmeow:StorageMedium values." .

# --- 10. Rejected storage subclasses do NOT exist as classes (MUST-NOT) -------
ex:saRejectedStorageSubclassesGone a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned { gmeow:CloudStorage gmeow:LocalStorage gmeow:ObjectStore }
    ?banned a owl:Class .
}""" ;
    gmeow:saRationale "gmeow:CloudStorage, LocalStorage, and ObjectStore MUST NOT exist as owl:Class -- permanently refactored to StorageMedium value individuals." .

# --- 11. asWKT range is rdfs:Literal, NOT geo:wktLiteral (MUST + MUST-NOT) ---
ex:saAsWKTRangeIsLiteral a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:asWKT rdfs:range rdfs:Literal . }""" ;
    gmeow:saRationale "gmeow:asWKT MUST have rdfs:range rdfs:Literal -- the custom geo:wktLiteral datatype is outside the OWL 2 DL datatype map (Principle 3)." .

ex:saAsWKTNotGeoWktLiteral a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:asWKT rdfs:range geo:wktLiteral . }""" ;
    gmeow:saRationale "gmeow:asWKT MUST NOT range over geo:wktLiteral -- not in OWL 2 DL map, would break DL safety." .

# --- 16. containedInPlace is transitive, NOT symmetric (MUST + MUST-NOT) ------
ex:saContainedInPlaceTransitiveNotSymmetric a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:containedInPlace a owl:TransitiveProperty . }""" ;
    gmeow:saRationale "gmeow:containedInPlace MUST be owl:TransitiveProperty -- spatial containment chains are transitive." .

ex:saContainedInPlaceNotSymmetric a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:containedInPlace a owl:SymmetricProperty . }""" ;
    gmeow:saRationale "gmeow:containedInPlace MUST NOT be owl:SymmetricProperty -- containment is asymmetric (a city is in a country, not vice versa)." .

# --- 17. storedIn is subPropertyOf locatedAt (MUST) ---------------------------
ex:saStoredInSubpropertyLocatedAt a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:storedIn rdfs:subPropertyOf gmeow:locatedAt . }""" ;
    gmeow:saRationale "gmeow:storedIn MUST be rdfs:subPropertyOf gmeow:locatedAt -- storage is a specialization of location." .

# --- 18. authorityLink has NO rdfs:range (MUST-NOT) ---------------------------
ex:saAuthorityLinkRangeOpen a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:authorityLink rdfs:range ?r . }""" ;
    gmeow:saRationale "gmeow:authorityLink MUST NOT carry any rdfs:range -- open range for any external authority IRI, DL-safe (the open-range convention)." .

# --- 19. Coordinate props are non-functional; elevation ranges xsd:decimal (MUST) --
ex:saCoordinatePropsNonfunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p { gmeow:latitude gmeow:longitude gmeow:elevation gmeow:timezone }
    ?p a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:latitude, longitude, elevation, and timezone MUST NOT be owl:FunctionalProperty -- competing observation-indexed coordinate claims coexist (Principle 9)." .

ex:saElevationRangeDecimal a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:elevation rdfs:range xsd:decimal . }""" ;
    gmeow:saRationale "gmeow:elevation MUST have rdfs:range xsd:decimal (DL-clean)." .

# --- 20. MetricKind subclasses logic:QualityValue (MUST) ----------------------
ex:saMetricKindIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:MetricKind rdfs:subClassOf logic:QualityValue . }""" ;
    gmeow:saRationale "gmeow:MetricKind MUST be a subclass of logic:QualityValue -- metric kinds are ordered value individuals, not subclasses." .

# --- 21. MetricKind seed individuals exist (MUST) -----------------------------
ex:saMetricKindSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:metricGeodesic           a gmeow:MetricKind .
    gmeow:metricEuclidean          a gmeow:MetricKind .
    gmeow:metricCosine             a gmeow:MetricKind .
    gmeow:metricEditDistance       a gmeow:MetricKind .
    gmeow:metricGraphHops          a gmeow:MetricKind .
    gmeow:metricSymplectic         a gmeow:MetricKind .
    gmeow:metricPositionalDistance a gmeow:MetricKind .
}""" ;
    gmeow:saRationale "The seven core MetricKind seed individuals MUST exist as gmeow:MetricKind values." .

# --- 22. hasMetricKind is an ObjectProperty on ReferenceFrame (MUST) ----------
ex:saHasMetricKindShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasMetricKind a owl:ObjectProperty .
    gmeow:hasMetricKind rdfs:domain gmeow:ReferenceFrame .
    gmeow:hasMetricKind rdfs:range  gmeow:MetricKind .
}""" ;
    gmeow:saRationale "gmeow:hasMetricKind MUST be an owl:ObjectProperty with domain ReferenceFrame and range MetricKind (its functionality is now carried by a logic:PropertyCharacteristicAssertion, DL-enforced)." .

# --- 23. ProximityMeasurement subclasses Measurement (MUST) -------------------
ex:saProximityMeasurementSubclass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:ProximityMeasurement rdfs:subClassOf gmeow:Measurement . }""" ;
    gmeow:saRationale "gmeow:ProximityMeasurement MUST be rdfs:subClassOf gmeow:Measurement." .

# --- 24. proximity domain is Entity, range is ProximityMeasurement (MUST) -----
ex:saProximityPropertyShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:proximity a owl:ObjectProperty ;
        rdfs:domain gmeow:Entity ;
        rdfs:range  gmeow:ProximityMeasurement .
}""" ;
    gmeow:saRationale "gmeow:proximity MUST be an owl:ObjectProperty with domain Entity and range ProximityMeasurement." .

# --- 25. proximityTo is an ObjectProperty with domain/range (MUST) ------------
ex:saProximityToShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:proximityTo a owl:ObjectProperty .
    gmeow:proximityTo rdfs:domain gmeow:ProximityMeasurement .
    gmeow:proximityTo rdfs:range  gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:proximityTo MUST be an owl:ObjectProperty with domain ProximityMeasurement and range Entity (its functionality is now carried by a logic:PropertyCharacteristicAssertion, DL-enforced)." .

# --- 26. Spatial frames declare hasMetricKind seeds (MUST) --------------------
ex:saSpatialFrameMetricKinds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:referenceFrameWGS84               gmeow:hasMetricKind gmeow:metricGeodesic .
    gmeow:referenceFrameLocalGrid           gmeow:hasMetricKind gmeow:metricEuclidean .
    gmeow:referenceFrameRobotBase           gmeow:hasMetricKind gmeow:metricEuclidean .
    gmeow:referenceFrameCelestialEquatorial gmeow:hasMetricKind gmeow:metricGeodesic .
}""" ;
    gmeow:saRationale "The four core spatial frames MUST declare their metric kinds." .

# --- 27. hasCentroid domain Place, range Geometry (MUST) ----------------------
ex:saHasCentroidShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasCentroid a owl:ObjectProperty ;
        rdfs:domain gmeow:Place ;
        rdfs:range  gmeow:Geometry .
}""" ;
    gmeow:saRationale "gmeow:hasCentroid MUST be an owl:ObjectProperty with domain Place and range Geometry." .

# --- 28. No preferred/primary place terms (MUST-NOT) -------------------------
ex:saNoPreferredPrimaryPlaceTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned {
        gmeow:primaryName gmeow:preferredName
        gmeow:primaryJurisdiction gmeow:preferredJurisdiction
        gmeow:preferredRank
        gmeow:primaryOverlay gmeow:preferredOverlay
        gmeow:primaryRegulatoryOverlay gmeow:preferredRegulatoryOverlay
    }
    VALUES ?t {
        owl:ObjectProperty owl:DatatypeProperty
        owl:AnnotationProperty owl:Class
    }
    ?banned a ?t .
}""" ;
    gmeow:saRationale "No preferred*/primary* selector for contested jurisdiction, toponym, or overlay MUST NOT exist (Principle 9, co-equality)." .

# --- 29. JurisdictionTenure subclasses TimeScopedRelation (MUST) --------------
ex:saJurisdictionTenureGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:JurisdictionTenure rdfs:subClassOf gmeow:TimeScopedRelation .
    gmeow:jurisdictionPlace  rdfs:domain gmeow:JurisdictionTenure ;
                             rdfs:range  gmeow:Place .
    gmeow:jurisdictionPolity rdfs:domain gmeow:JurisdictionTenure ;
                             rdfs:range  gmeow:Agent .
}""" ;
    gmeow:saRationale "gmeow:JurisdictionTenure MUST be rdfs:subClassOf TimeScopedRelation; jurisdictionPlace and jurisdictionPolity MUST have correct domain/range (their functionality is now carried by logic:PropertyCharacteristicAssertions, DL-enforced)." .

# --- 30. ContainmentTenure subclasses TimeScopedRelation (MUST) ---------------
ex:saContainmentTenureGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ContainmentTenure  rdfs:subClassOf gmeow:TimeScopedRelation .
    gmeow:containmentChild   rdfs:domain gmeow:ContainmentTenure ;
                             rdfs:range  gmeow:Place .
    gmeow:containmentParent  rdfs:domain gmeow:ContainmentTenure ;
                             rdfs:range  gmeow:Place .
}""" ;
    gmeow:saRationale "gmeow:ContainmentTenure MUST be rdfs:subClassOf TimeScopedRelation; containmentChild and containmentParent MUST have correct domain/range (their functionality is now carried by logic:PropertyCharacteristicAssertions, DL-enforced)." .

# --- 31. GeometryType subclasses logic:QualityValue; seed individuals exist (MUST) --
ex:saGeometryTypeIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:GeometryType rdfs:subClassOf logic:QualityValue . }""" ;
    gmeow:saRationale "gmeow:GeometryType MUST be a subclass of logic:QualityValue -- geometry kinds are value individuals, not subclasses." .

ex:saGeometryTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:geometryTypePoint            a gmeow:GeometryType .
    gmeow:geometryTypeLineString       a gmeow:GeometryType .
    gmeow:geometryTypePolygon          a gmeow:GeometryType .
    gmeow:geometryTypeMultiPoint       a gmeow:GeometryType .
    gmeow:geometryTypeMultiLineString  a gmeow:GeometryType .
    gmeow:geometryTypeMultiPolygon     a gmeow:GeometryType .
}""" ;
    gmeow:saRationale "The six core GeometryType seed individuals MUST exist as gmeow:GeometryType values." .

# --- 32. Rejected geometry subclasses do NOT exist as classes (MUST-NOT) ------
ex:saRejectedGeometrySubclassesGone a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned { gmeow:Point gmeow:LineString gmeow:Polygon gmeow:MultiPoint }
    ?banned a owl:Class .
}""" ;
    gmeow:saRationale "gmeow:Point, LineString, Polygon, and MultiPoint MUST NOT exist as owl:Class -- permanently refactored to GeometryType value individuals." .

# --- 33. asGeoJSON range is rdfs:Literal, NOT geo:geoJSONLiteral (MUST + MUST-NOT) --
ex:saAsGeoJSONRangeIsLiteral a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:asGeoJSON a owl:DatatypeProperty .
    gmeow:asGeoJSON rdfs:range rdfs:Literal .
}""" ;
    gmeow:saRationale "gmeow:asGeoJSON MUST be an owl:DatatypeProperty with rdfs:range rdfs:Literal -- geo:geoJSONLiteral is outside OWL 2 DL (Principle 3)." .

ex:saAsGeoJSONNotGeoLiteral a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:asGeoJSON rdfs:range geo:geoJSONLiteral . }""" ;
    gmeow:saRationale "gmeow:asGeoJSON MUST NOT range over geo:geoJSONLiteral -- not in OWL 2 DL datatype map." .

# --- 34. placeDeterminacy and geometryDeterminacy subproperties (MUST) ---------
ex:saPlaceDeterminacySubproperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:placeDeterminacy    rdfs:subPropertyOf gmeow:hasDeterminacy ;
                              rdfs:domain gmeow:Place .
    gmeow:geometryDeterminacy rdfs:subPropertyOf gmeow:hasDeterminacy ;
                              rdfs:domain gmeow:Geometry .
}""" ;
    gmeow:saRationale "gmeow:placeDeterminacy and geometryDeterminacy MUST be subproperties of gmeow:hasDeterminacy with correct domains." .

# --- 35. placeSupersededBy and placeSupersedes subproperties (MUST) -----------
ex:saPlaceSupersessionSubproperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:placeSupersededBy rdfs:subPropertyOf gmeow:supersededBy .
    gmeow:placeSupersedes   rdfs:subPropertyOf gmeow:supersedes .
}""" ;
    gmeow:saRationale "gmeow:placeSupersededBy MUST be rdfs:subPropertyOf gmeow:supersededBy and gmeow:placeSupersedes MUST be rdfs:subPropertyOf gmeow:supersedes." .

# --- 36. RegulatoryOverlay grounding (MUST) -----------------------------------
ex:saRegulatoryOverlayGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:RegulatoryOverlay rdfs:subClassOf gmeow:TimeScopedRelation .
    gmeow:overlayPlace      rdfs:domain gmeow:RegulatoryOverlay ;
                            rdfs:range  gmeow:Place .
    gmeow:overlayAuthority  rdfs:domain gmeow:RegulatoryOverlay ;
                            rdfs:range  gmeow:Agent .
    gmeow:overlayType       rdfs:domain gmeow:RegulatoryOverlay ;
                            rdfs:range  gmeow:RegulatoryOverlayType .
    gmeow:overlayRegulation rdfs:domain gmeow:RegulatoryOverlay ;
                            rdfs:range  gmeow:RightsStatement .
}""" ;
    gmeow:saRationale "gmeow:RegulatoryOverlay MUST be rdfs:subClassOf TimeScopedRelation; overlayPlace/overlayAuthority MUST have correct domain/range (their functionality is now carried by logic:PropertyCharacteristicAssertions, DL-enforced); overlayType/overlayRegulation MUST have correct ranges." .

# --- 37. overlayDeterminacy is a determinacy subproperty on RegulatoryOverlay (MUST) --
ex:saOverlayDeterminacySubproperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:overlayDeterminacy rdfs:subPropertyOf gmeow:hasDeterminacy ;
                             rdfs:domain gmeow:RegulatoryOverlay ;
                             rdfs:range  gmeow:Determinacy .
}""" ;
    gmeow:saRationale "gmeow:overlayDeterminacy MUST be rdfs:subPropertyOf hasDeterminacy with domain RegulatoryOverlay and range Determinacy." .

# --- 38. overlayLowerBound / overlayUpperBound range math:Quantity (MUST) -----
ex:saOverlayBoundsRange a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX math: <https://blackcatinformatics.ca/math/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:overlayLowerBound rdfs:domain gmeow:RegulatoryOverlay ;
                            rdfs:range  math:Quantity .
    gmeow:overlayUpperBound rdfs:domain gmeow:RegulatoryOverlay ;
                            rdfs:range  math:Quantity .
}""" ;
    gmeow:saRationale "gmeow:overlayLowerBound and overlayUpperBound MUST have domain RegulatoryOverlay and range math:Quantity (3D altitude bounds)." .

# --- 39. Maritime overlay type seeds exist (MUST) -----------------------------
ex:saMaritimeOverlayTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:overlayTypeTerritorialSea       a gmeow:RegulatoryOverlayType .
    gmeow:overlayTypeContiguousZone       a gmeow:RegulatoryOverlayType .
    gmeow:overlayTypeContinentalShelf     a gmeow:RegulatoryOverlayType .
    gmeow:overlayTypeHighSeas             a gmeow:RegulatoryOverlayType .
    gmeow:overlayTypeMarineProtectedArea  a gmeow:RegulatoryOverlayType .
}""" ;
    gmeow:saRationale "The five maritime RegulatoryOverlayType seed individuals MUST exist." .

