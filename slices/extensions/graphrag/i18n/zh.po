msgctxt "https://blackcatinformatics.ca/gmeow/indexAlgorithm|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to record which algorithm built a vector index."
msgstr "用于记录构建向量索引所用的算法。"

msgctxt "https://blackcatinformatics.ca/gmeow/indexAlgorithm|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring it from the parameters or omitting it on a rebuilt index."
msgstr "避免从参数推断，或在重建索引后省略它。"

msgctxt "https://blackcatinformatics.ca/gmeow/indexAlgorithm|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach one gmeow:IndexAlgorithm value to the index; it is functional."
msgstr "为索引关联一个 gmeow:IndexAlgorithm 取值；该属性是函数性的。"

msgctxt "https://blackcatinformatics.ca/gmeow/indexAlgorithm|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:index1 gmeow:indexAlgorithm gmeow:indexAlgorithmHnsw ."
msgstr "gmeow:index1 gmeow:indexAlgorithm gmeow:indexAlgorithmHnsw ."

msgctxt "https://blackcatinformatics.ca/gmeow/relationshipSource|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to name the entity an extracted relationship points FROM."
msgstr "用于命名抽取关系的起始实体。"

msgctxt "https://blackcatinformatics.ca/gmeow/relationshipSource|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid swapping it with gmeow:relationshipTarget on a symmetric-looking relation — direction is asserted, not inferred."
msgstr "在看似对称的关系上避免与 gmeow:relationshipTarget 互换——方向是被断言的，而非推断的。"

msgctxt "https://blackcatinformatics.ca/gmeow/relationshipSource|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach exactly one gmeow:ExtractedEntity as the tail of the relationship; it is functional."
msgstr "将恰好一个 gmeow:ExtractedEntity 作为该关系的尾端关联；该属性是函数性的。"

msgctxt "https://blackcatinformatics.ca/gmeow/relationshipSource|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:rel1 gmeow:relationshipSource gmeow:entity1 ."
msgstr "gmeow:rel1 gmeow:relationshipSource gmeow:entity1 ."

msgctxt "https://blackcatinformatics.ca/gmeow/relationshipTarget|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to name the entity an extracted relationship points TO."
msgstr "用于命名抽取关系所指向的实体。"

msgctxt "https://blackcatinformatics.ca/gmeow/relationshipTarget|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid swapping it with gmeow:relationshipSource — direction is asserted, not inferred."
msgstr "避免与 gmeow:relationshipSource 互换——方向是被断言的，而非推断的。"

msgctxt "https://blackcatinformatics.ca/gmeow/relationshipTarget|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach exactly one gmeow:ExtractedEntity as the head of the relationship; it is functional."
msgstr "将恰好一个 gmeow:ExtractedEntity 作为该关系的头端关联；该属性是函数性的。"

msgctxt "https://blackcatinformatics.ca/gmeow/relationshipTarget|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:rel1 gmeow:relationshipTarget gmeow:entity2 ."
msgstr "gmeow:rel1 gmeow:relationshipTarget gmeow:entity2 ."

msgctxt "https://blackcatinformatics.ca/gmeow/summarizesCommunity|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to say which community a summary condenses."
msgstr "用于说明某摘要所浓缩的社区。"

msgctxt "https://blackcatinformatics.ca/gmeow/summarizesCommunity|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid pointing one summary at several communities — that is several summaries."
msgstr "避免让一个摘要指向多个社区——那应是多个摘要。"

msgctxt "https://blackcatinformatics.ca/gmeow/summarizesCommunity|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach exactly one gmeow:Community; it is functional."
msgstr "恰好关联一个 gmeow:Community；该属性是函数性的。"

msgctxt "https://blackcatinformatics.ca/gmeow/summarizesCommunity|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:summary1 gmeow:summarizesCommunity gmeow:community1 ."
msgstr "gmeow:summary1 gmeow:summarizesCommunity gmeow:community1 ."
