msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramGraph|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query Program Graph"
msgstr "Graphe de programme de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramGraph|http://www.w3.org/2004/02/skos/core#definition"
msgid "A finite, explicitly bounded graph describing a consumer-owned query operation and its nodes. Its declaration requests no native execution."
msgstr "Graphe fini explicitement délimité décrivant une opération de requête exécutée par le consommateur et ses nœuds. Sa déclaration ne demande aucune exécution native."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramGraph|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query program graph with explicit source bindings."
msgstr "Utiliser pour décrire graphe de programme de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramGraph|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramGraph|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramGraph|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:QueryProgramGraph ."
msgstr "ex:record a gmeow:QueryProgramGraph ."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramNode|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query Program Node"
msgstr "Nœud de programme de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramNode|http://www.w3.org/2004/02/skos/core#definition"
msgid "One operation description in a query graph, with explicit effect classification and dependency stratum. It is not an execution occurrence."
msgstr "Description d’une opération dans un graphe de requête, avec classification explicite des effets et strate de dépendance. Ce n’est pas une occurrence d’exécution."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramNode|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query program node with explicit source bindings."
msgstr "Utiliser pour décrire nœud de programme de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramNode|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramNode|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryProgramNode|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:QueryProgramNode ."
msgstr "ex:record a gmeow:QueryProgramNode ."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryList|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Ranked Query List"
msgstr "Liste de requête classée"

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryList|http://www.w3.org/2004/02/skos/core#definition"
msgid "An attributed query answer carrying source-ranked candidate entries. Ranks are the source-supplied positive integers; equal ranks remain tied and are never renumbered by serialization order."
msgstr "Réponse de requête attribuée portant des candidats classés par la source. Les rangs sont les entiers positifs fournis par la source ; les rangs égaux restent ex æquo et ne sont jamais renumérotés selon la sérialisation."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryList|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for ranked query list with explicit source bindings."
msgstr "Utiliser pour décrire liste de requête classée avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryList|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryList|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryList|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:RankedQueryList ."
msgstr "ex:record a gmeow:RankedQueryList ."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryEntry|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Ranked Query Entry"
msgstr "Entrée de requête classée"

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryEntry|http://www.w3.org/2004/02/skos/core#definition"
msgid "One candidate occurrence in one ranked list, retaining its rank and a unique source-scoped tie key. Repeated candidate identities within a list are forbidden."
msgstr "Occurrence d’un candidat dans une liste classée, conservant son rang et une clé de départage unique dans la portée source. Un candidat ne se répète pas dans une liste."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryEntry|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for ranked query entry with explicit source bindings."
msgstr "Utiliser pour décrire entrée de requête classée avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryEntry|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryEntry|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedQueryEntry|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:RankedQueryEntry ."
msgstr "ex:record a gmeow:RankedQueryEntry ."

msgctxt "https://blackcatinformatics.ca/gmeow/ReciprocalRankFusion|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Fixed-Point Reciprocal Rank Fusion"
msgstr "Fusion des rangs réciproques en virgule fixe"

msgctxt "https://blackcatinformatics.ca/gmeow/ReciprocalRankFusion|http://www.w3.org/2004/02/skos/core#definition"
msgid "A query-node description combining selected ranked lists by integer-quantized reciprocal ranks, preserving every per-list contribution. Quantization rounds down before summation."
msgstr "Description de nœud combinant des listes classées par rangs réciproques quantifiés en entiers, en conservant chaque contribution par liste. La quantification arrondit vers le bas avant la somme."

msgctxt "https://blackcatinformatics.ca/gmeow/ReciprocalRankFusion|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for fixed-point reciprocal rank fusion with explicit source bindings."
msgstr "Utiliser pour décrire fusion des rangs réciproques en virgule fixe avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/ReciprocalRankFusion|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/ReciprocalRankFusion|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/ReciprocalRankFusion|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:ReciprocalRankFusion ."
msgstr "ex:record a gmeow:ReciprocalRankFusion ."

msgctxt "https://blackcatinformatics.ca/gmeow/FusionContribution|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query Fusion Contribution"
msgstr "Contribution de fusion de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/FusionContribution|http://www.w3.org/2004/02/skos/core#definition"
msgid "The nonnegative integer contribution of exactly one selected ranked entry to one fusion occurrence. It is a retrieval score, never epistemic confidence."
msgstr "Contribution entière non négative d’une entrée classée sélectionnée à une occurrence de fusion. C’est un score de recherche, jamais une confiance épistémique."

msgctxt "https://blackcatinformatics.ca/gmeow/FusionContribution|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query fusion contribution with explicit source bindings."
msgstr "Utiliser pour décrire contribution de fusion de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/FusionContribution|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/FusionContribution|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/FusionContribution|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:FusionContribution ."
msgstr "ex:record a gmeow:FusionContribution ."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryFusionScore|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query Fusion Score"
msgstr "Score de fusion de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/QueryFusionScore|http://www.w3.org/2004/02/skos/core#definition"
msgid "A candidate score for one fusion, with a finite complete fold over that candidate’s contributions. Equal scores remain tied."
msgstr "Score d’un candidat pour une fusion, avec repli fini complet de ses contributions. Des scores égaux restent ex æquo."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryFusionScore|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query fusion score with explicit source bindings."
msgstr "Utiliser pour décrire score de fusion de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryFusionScore|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryFusionScore|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryFusionScore|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:QueryFusionScore ."
msgstr "ex:record a gmeow:QueryFusionScore ."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryScoreFoldStep|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query Score Fold Step"
msgstr "Étape de repli du score de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/QueryScoreFoldStep|http://www.w3.org/2004/02/skos/core#definition"
msgid "A numbered partial sum within one candidate score. Step zero is zero; each successor adds exactly one previously unused contribution."
msgstr "Somme partielle numérotée d’un score de candidat. L’étape zéro vaut zéro ; chaque successeur ajoute une contribution encore inutilisée."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryScoreFoldStep|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query score fold step with explicit source bindings."
msgstr "Utiliser pour décrire étape de repli du score de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryScoreFoldStep|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryScoreFoldStep|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryScoreFoldStep|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:QueryScoreFoldStep ."
msgstr "ex:record a gmeow:QueryScoreFoldStep ."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryLedgerMerge|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query Ledger Merge"
msgstr "Fusion des registres de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/QueryLedgerMerge|http://www.w3.org/2004/02/skos/core#definition"
msgid "A query-node description taking the identity-preserving union of candidates and loss records from selected answers. It does not repair or waive any loss."
msgstr "Description de nœud prenant l’union des candidats et pertes des réponses sélectionnées tout en préservant leurs identités. Elle ne répare ni ne dispense aucune perte."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryLedgerMerge|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query ledger merge with explicit source bindings."
msgstr "Utiliser pour décrire fusion des registres de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryLedgerMerge|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryLedgerMerge|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryLedgerMerge|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:QueryLedgerMerge ."
msgstr "ex:record a gmeow:QueryLedgerMerge ."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryVerdictChoice|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query Verdict Choice"
msgstr "Choix selon verdict de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/QueryVerdictChoice|http://www.w3.org/2004/02/skos/core#definition"
msgid "A query-node description of an outer binary knownness gate: its supported knownness guard selects an owned internal verdict comparison on the left, and otherwise it selects the explicit unknown query target on the right. It binds one attributed answer, selected axis and known expected value without asserting execution."
msgstr "Description de nœud de requête d’une porte binaire externe de caractère connu : sa garde soutenue de valeur connue sélectionne une comparaison interne de verdict possédée à gauche ; sinon, elle sélectionne la cible explicite de requête inconnue à droite. Elle lie une réponse attribuée, un axe sélectionné et une valeur attendue connue sans affirmer une exécution."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryVerdictChoice|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query verdict choice with explicit source bindings."
msgstr "Utiliser pour décrire choix selon verdict de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryVerdictChoice|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryVerdictChoice|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Bind choiceAnswer, choiceAxis and a known choiceExpectedValue once on the outer node; supply its knownness guardSituation, its owned left QueryVerdictComparison with matching guard and two targets, and its unknown right target."
msgstr "Lier choiceAnswer, choiceAxis et une choiceExpectedValue connue une seule fois sur le nœud externe ; fournir son guardSituation de valeur connue, sa QueryVerdictComparison possédée à gauche avec garde de correspondance et deux cibles, ainsi que sa cible inconnue à droite."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryVerdictChoice|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:QueryVerdictChoice ."
msgstr "ex:record a gmeow:QueryVerdictChoice ."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryNodeExecution|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query Node Execution"
msgstr "Exécution de nœud de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/QueryNodeExecution|http://www.w3.org/2004/02/skos/core#definition"
msgid "A consumer-reported occurrence of executing a query node. Selected branches and measured iteration outcomes belong to occurrences, not reusable operation descriptions."
msgstr "Occurrence d’exécution d’un nœud rapportée par le consommateur. Branches sélectionnées et résultats d’itération mesurés appartiennent aux occurrences, pas aux descriptions réutilisables."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryNodeExecution|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query node execution with explicit source bindings."
msgstr "Utiliser pour décrire exécution de nœud de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryNodeExecution|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryNodeExecution|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryNodeExecution|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:QueryNodeExecution ."
msgstr "ex:record a gmeow:QueryNodeExecution ."

msgctxt "https://blackcatinformatics.ca/gmeow/ConvergentQueryIteration|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Convergent Query Iteration"
msgstr "Itération de requête convergente"

msgctxt "https://blackcatinformatics.ca/gmeow/ConvergentQueryIteration|http://www.w3.org/2004/02/skos/core#definition"
msgid "A query-node description of finite monotone set expansion to equality, under a stratified feedback contract. The body is a pure query node; convergence is separate from a budget stop."
msgstr "Description de nœud d’expansion monotone finie d’ensembles jusqu’à égalité, sous contrat de rétroaction stratifiée. Le corps est pur ; la convergence est distincte d’un arrêt de budget."

msgctxt "https://blackcatinformatics.ca/gmeow/ConvergentQueryIteration|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for convergent query iteration with explicit source bindings."
msgstr "Utiliser pour décrire itération de requête convergente avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/ConvergentQueryIteration|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/ConvergentQueryIteration|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/ConvergentQueryIteration|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:ConvergentQueryIteration ."
msgstr "ex:record a gmeow:ConvergentQueryIteration ."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryIterationState|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query Iteration State"
msgstr "État d’itération de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/QueryIterationState|http://www.w3.org/2004/02/skos/core#definition"
msgid "A finite candidate set after a measured number of body executions in one iteration run. State zero is the seed before any body execution."
msgstr "Ensemble fini de candidats après un nombre mesuré d’exécutions du corps dans une occurrence. L’état zéro est la graine avant toute exécution."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryIterationState|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query iteration state with explicit source bindings."
msgstr "Utiliser pour décrire état d’itération de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryIterationState|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryIterationState|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/QueryIterationState|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:QueryIterationState ."
msgstr "ex:record a gmeow:QueryIterationState ."

msgctxt "https://blackcatinformatics.ca/gmeow/SparqlSelectionLeaf|http://www.w3.org/2000/01/rdf-schema#label"
msgid "SPARQL Selection Leaf"
msgstr "Feuille de sélection SPARQL"

msgctxt "https://blackcatinformatics.ca/gmeow/SparqlSelectionLeaf|http://www.w3.org/2004/02/skos/core#definition"
msgid "A query node describing a well-formed SPARQL SELECT over a declared dataset and context, with explicit input and output descriptors. It authorizes no update or external effect."
msgstr "Nœud décrivant un SELECT SPARQL bien formé sur un jeu de données et contexte déclarés, avec descripteurs explicites d’entrée et sortie. Il n’autorise aucune mise à jour ni effet externe."

msgctxt "https://blackcatinformatics.ca/gmeow/SparqlSelectionLeaf|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for sparql selection leaf with explicit source bindings."
msgstr "Utiliser pour décrire feuille de sélection sparql avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/SparqlSelectionLeaf|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

msgctxt "https://blackcatinformatics.ca/gmeow/SparqlSelectionLeaf|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."
msgstr "Conserver le graphe sélectionné, les identités et éléments source ; appliquer les obligations canoniques du module."

msgctxt "https://blackcatinformatics.ca/gmeow/SparqlSelectionLeaf|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record a gmeow:SparqlSelectionLeaf ."
msgstr "ex:record a gmeow:SparqlSelectionLeaf ."

msgctxt "https://blackcatinformatics.ca/gmeow/queryGraphNode|http://www.w3.org/2000/01/rdf-schema#label"
msgid "query graph node"
msgstr "nœud du graphe de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/queryGraphNode|http://www.w3.org/2004/02/skos/core#definition"
msgid "A node explicitly inside this finite graph. Membership bounds every dependency and sink obligation."
msgstr "Nœud explicitement dans ce graphe fini. L’appartenance délimite chaque obligation de dépendance et de sortie."

msgctxt "https://blackcatinformatics.ca/gmeow/queryGraphNode|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query graph node with explicit source bindings."
msgstr "Utiliser pour décrire nœud du graphe de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/queryGraphNode|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
