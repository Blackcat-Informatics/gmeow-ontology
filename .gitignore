# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.cache/
*.egg-info/
.coverage
htmlcov/

# Ephemeral build products (published on release, never committed).
# Committed generated artifacts live under generated/ (#287) — one root,
# every path owned by a registered generator.
# Exception (#440): ontology-docs/ at the repository root is a committed
# generated artifact owned by the ontology-docs registered generator.
/dist/
/dist/i18n/
/docs/_generated/
/llms.txt

# Stamp files (compilation freshness tracking)
.stamps/

# Editor/OS noise
.DS_Store
*.swp
.antigravitycli
.codex
.claude
.worktrees/

# Toolchain temp directories (hard-kill leftovers)
.gmeow-tmp-*/

# Rust build artifacts
/target/

# Repository Cargo config is source, not build output.
!/.cargo/
!/.cargo/config.toml

# Release signing secrets (public keys live under keys/ and ARE committed).
keys/*.secret.asc
keys/*.secret
keys/*.tmp

# maturin editable-install artifacts (the compiled extension is built, never committed)
crates/logic/python/gmeow_logic/*.so
crates/logic/python/gmeow_logic/*.pyd
crates/rdf/python/gmeow_rdf/*.so
crates/rdf/python/gmeow_rdf/*.pyd
.worktree
