#
# Which metric readings are held about an artifact, by whom, and in what dimension?
# Each row follows one observation to its own metric and its own result, and keeps the
# row only when the result carries the dimension that metric declares. The magnitude is
# returned as its lexical form and the unit is returned where the result names
# one. The result itself is returned too, so two results that carry the same dimension,
# magnitude and unit stay two rows.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX math: <https://blackcatinformatics.ca/math/>
SELECT ?observation ?artifact ?evaluator ?metric ?dimension ?result (STR(?magnitude) AS ?value) ?unit WHERE {
    ?observation a gmeow:ModelMetricObservation ;
        gmeow:vantage ?evaluator ;
        gmeow:observedFeature ?artifact ;
        gmeow:evaluatedMetric ?metric ;
        gmeow:observationResult ?result .
    ?metric a gmeow:ModelMetric ;
        gmeow:metricDimension ?dimension .
    ?result a math:Quantity ;
        math:hasDimension ?dimension ;
        math:quantityValue ?magnitude .
    OPTIONAL { ?result gmeow:unit ?unit }
}
ORDER BY ?observation ?result
