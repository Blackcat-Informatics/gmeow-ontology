#
# Declarative competency question for the quality slice (crates/slicetest),
# migrated from test_qc_missing_definitions_is_empty. The QC check
# (queries/qc/missing-definitions.rq) asserts that every gmeow: owl:Class carries a
# skos:definition; a non-empty result is a failure, so the cell pins
# cqExpectRowCount 0. It runs in the default asserted lane (gmeow:reasoningNone) on
# purpose: reasoning must not be able to invent a definition, so the completeness
# guard is meaningful only over what is actually authored.
#
# This is the Gap-1 GOOD pattern preserved verbatim: the query is an OPEN
# universal over the namespace (a dynamic FILTER(STRSTARTS(...)) ASK over every
# present-or-future gmeow: class), NOT a finite VALUES blacklist — referencing the
# .rq keeps that dynamic universal intact.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/quality/tests/> .

ex:cqMissingDefinitions a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/qc/missing-definitions.rq" ;
    gmeow:cqRationale "Every gmeow: owl:Class must carry a skos:definition; the QC query that finds undefined classes must return the empty set over the asserted merged ontology." ;
    gmeow:cqResultShape ex:cqMissingDefinitionsShape ;
    gmeow:cqExpectRowCount 0 .

ex:cqMissingDefinitionsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "class" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ;
    logic:shapeRowCount 0 .

ex:cqAggregateRetainsProcedureValueAndTarget a gmeow:CompetencyQuestion ;
    gmeow:cqDataFile "examples/aggregate-and-categorical.ttl" ;
    gmeow:cqQuery """PREFIX g: <https://blackcatinformatics.ca/gmeow/>
PREFIX m: <https://blackcatinformatics.ca/math/>
SELECT ?procedure ?dimension ?target WHERE {
  ?assessment a g:AggregateQualityAssessment ; g:observationResult ?estimate .
  ?estimate a m:Estimate ; m:estimateValue ?value ; m:estimator ?procedure ; m:estimatedParameter ?target .
  ?procedure a m:Estimator . ?value a m:Quantity ; m:hasDimension ?dimension .
}""" ;
    gmeow:cqRationale "The held quality claim preserves its distinct estimate, declared procedure, dimensioned value and target without reducing the result to an ungrounded scalar." ;
    gmeow:cqResultShape ex:aggregateResultShape ;
    gmeow:cqExpectRow ex:aggregateResultRow .

ex:aggregateResultShape a logic:ResultShape ;
    logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn
      [ logic:columnVariable "procedure" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ],
      [ logic:columnVariable "dimension" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ],
      [ logic:columnVariable "target" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] .
ex:aggregateResultRow a gmeow:ExpectedRow ;
    gmeow:rowCell
      [ a gmeow:ExpectedCell ; gmeow:cellVar "procedure" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/examples/quality/aggregate/sampleMean> ],
      [ a gmeow:ExpectedCell ; gmeow:cellVar "dimension" ; gmeow:cellValueIri <https://blackcatinformatics.ca/math/dimensionless> ],
      [ a gmeow:ExpectedCell ; gmeow:cellVar "target" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/examples/quality/aggregate/populationMeanCompleteness> ] .
