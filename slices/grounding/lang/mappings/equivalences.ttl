    gmeow:objectLabel "Latn (ISO 15924)" ;
    gmeow:comment "lexvo:script/Latn is the Lexvo resource for the ISO 15924 script code Latn — the code-scoped identifier for the Latin script. A related resource rather than identity, so skos:relatedMatch." ;
    gmeow:sssomFile "gmeow-lexvo.sssom.tsv" .

