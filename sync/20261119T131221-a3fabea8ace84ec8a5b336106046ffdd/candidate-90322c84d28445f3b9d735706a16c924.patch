+) -> gmeow_errors::Result<DocsCatalogFixtures> {
+    let run = prime_stage_fixtures(root, jobs, DOCS_CATALOG_STAGE_IDS)?;
+    let manifest = selected_fixture_manifest(&run.stage_receipts, DOCS_CATALOG_STAGE_IDS)?;
