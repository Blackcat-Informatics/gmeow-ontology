        [ logic:columnVariable "parent" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHypNull a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:NullHypothesis ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "parent" ; gmeow:cellValueIri math:Hypothesis ] .
ex:rowHypAlternative a gmeow:ExpectedRow ;
