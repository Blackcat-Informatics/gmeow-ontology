@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix snomed: <http://snomed.info/id/> .
@prefix loinc: <http://loinc.org/rdf/> .

<https://blackcatinformatics.ca/gmeow/projections/loinc>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:ObservableProperty ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri loinc:Component ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.75"^^xsd:double ;
        rdfs:label "ObservableProperty → loinc:Component"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:ObservationMethod ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri loinc:Method ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "ObservationMethod → loinc:Method"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:SensoryObservation ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri loinc:LabTest ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            rdfs:label "SensoryObservation (lab test) → loinc:LabTest"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:SensoryObservation ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri snomed:404684003 ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.75"^^xsd:double ;
            rdfs:label "SensoryObservation (finding) → snomed:404684003"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri math:Quantity ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri loinc:Quantity ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.75"^^xsd:double ;
            rdfs:label "math:Quantity → loinc:Quantity"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "loinc" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → loinc (EDOAL)"@en .
