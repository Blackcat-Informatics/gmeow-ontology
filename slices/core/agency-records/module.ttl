gmeow:BudgetCountValueConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Budget count value constraint"@x-gmeow-english ;
    skos:definition "A BudgetReading supplies at least one count role; each linked Quantity has a valid xsd:nonNegativeInteger magnitude, one numeric value, only the dimensionless dimension and exactly one typed ReferenceFrame. A signed timezone offset on budgetDay must be zero; timezone-free and Z dates retain the fixed UTC civil-day convention."@x-gmeow-english ;
    skos:scopeNote "Equivalent retained lexical aliases may coexist under numeric value equality. Existing ReferenceFrame obligations apply; source truth, actual scope and convention justification remain evidence obligations. XML Schema whitespace is preserved; this rule neither converts dates nor invents an instant."@x-gmeow-english ;
    skos:example "A request-only historical report retains its valid framed quantity and timezone-free UTC day; a supplied nonzero date offset fails instead of being converted."@x-gmeow-english ;
    gmeow:useWhen "Use to validate supplied daily budget count quantities and require an actual supplied count."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid manufacturing a value, dimension, frame or zero to satisfy the constraint, or equating different count conventions."@x-gmeow-english ;
    gmeow:howToUse "Apply the outer report guard and each independent positive count guard; preserve original literals and validate both count roles with the same canonical obligations. For each supplied budgetDay with a signed timezone suffix, require a zero offset while retaining allowed trailing XML Schema whitespace."@x-gmeow-english ;
    logic:formalizes gmeow:BudgetReading , gmeow:budgetRequests , gmeow:budgetCalls , gmeow:budgetDay ;
    logic:message "A BudgetReading supplies at least one count role; each linked Quantity has a valid xsd:nonNegativeInteger magnitude, one numeric value, only the dimensionless dimension and exactly one typed ReferenceFrame. A signed timezone offset on budgetDay must be zero; timezone-free and Z dates retain the fixed UTC civil-day convention."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "report" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termIri gmeow:BudgetReading ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termIri gmeow:BudgetReading ] ] ;
            logic:consequent [ a logic:Formula ; logic:or [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presentRequests" ] ;
        logic:exists [ a logic:Formula ; logic:relation gmeow:budgetRequests ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "presentRequests" ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "presentCalls" ] ;
        logic:exists [ a logic:Formula ; logic:relation gmeow:budgetCalls ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "presentCalls" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "reqMagnitudeQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:budgetRequests ; logic:argument [ logic:termIndex 0 ; logic:termVariable "report" ], [ logic:termIndex 1 ; logic:termVariable "reqMagnitudeQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "reqMagnitude" ] ;
        logic:exists [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "reqMagnitudeQuantity" ], [ logic:termIndex 1 ; logic:termVariable "reqMagnitude" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "reqTypedQuantity" ], [ logic:termIndex 1 ; logic:termVariable "reqTypedValue" ] ;
