    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "item" ; gmeow:cellValueIri rqf:centreLimit ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "value" ; gmeow:cellValueLiteral "https://blackcatinformatics.ca/math/PositiveInfinity" ] .

