gmeow:instrumentTypeElectricGuitar
    a gmeow:InstrumentType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "electric guitar"@x-gmeow-english ;
