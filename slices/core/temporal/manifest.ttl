@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Slice manifest — authored in slices/vocabulary.ttl terms; validated by
# shapes/slice-manifest-shapes.ttl + the slice gates. Anatomy is convention:
# module.ttl, shapes.ttl, mappings/, queries/, tests/, docs.md live beside
# this file and are discovered, never pointed at.

<https://blackcatinformatics.ca/gmeow/slices/temporal>
    a gmeow:Slice ;
    rdfs:label "temporal"@x-gmeow-english ;
    skos:definition "The temporal slice of the GMEOW ontology (core tier): GMEOW Temporal — intervals, instants, temporal frames, time-scoped relations. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    dcterms:title "GMEOW Temporal — intervals, instants, temporal frames, time-scoped relations"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceProfile "memory" ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/entities> ,
        <https://blackcatinformatics.ca/gmeow/slices/events> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/places> ,
        <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    gmeow:sliceConsumer "Every slice carrying time-scoped facts (tenures, residences, validity); the statement layer's validFrom/validUntil; the calendar slice; the mail corpus."@x-gmeow-english .
