ASK { gmeow:findContextEvent a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:findContextEvent MUST be an owl:ObjectProperty — the excavation, survey, or documentation event during which a carrier was discovered or recorded. Mirrors test_find_context_event_is_non_functional (positive part)." .

# --- 36. findContextEvent is NOT functional (MUST-NOT) ------------------------
ex:saFindContextEventNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
