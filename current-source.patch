+                documents: documents.clone(),
+                formulas: roots[index].clone(),
+                rules: roots[(index + 1) % roots.len()].clone(),
+                owners: roots[(index + 2) % roots.len()].clone(),
+            };
+            let preimage = purrdf_lex::json::record::to_vec(&selection);
