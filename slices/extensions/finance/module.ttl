gmeow:postingJournalEntryFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "postingJournalEntry is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:postingJournalEntry is functional: a posting belongs to exactly one journal entry — the single balanced double-entry event it is one line of. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:postingJournalEntry ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:postingJournalEntry ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:postingJournalEntry names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:postingJournalEntry, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:postingJournalEntry and nothing else. It is not a definition of gmeow:postingJournalEntry (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:postingJournalEntryFunctionality logic:characterizes gmeow:postingJournalEntry ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:transactionAmountFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "transactionAmount is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:transactionAmount is functional: a financial transaction occurrence has exactly one canonical amount — the single MonetaryAmount of the money moved, with disputed figures kept as separate standpoint-indexed statements rather than extra values on the same transaction."@x-gmeow-english ;
    logic:characterizes gmeow:transactionAmount ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:transactionAmount ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:transactionAmount names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:transactionAmount, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:transactionAmount and nothing else. It is not a definition of gmeow:transactionAmount (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:transactionAmountFunctionality logic:characterizes gmeow:transactionAmount ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:walletSchemeFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "walletScheme is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:walletScheme is functional: a crypto wallet operates on exactly one blockchain scheme — a single WalletScheme (Bitcoin, Ethereum, Solana, Monero, …), since a multi-scheme container is modelled as several wallets. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:walletScheme ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:walletScheme ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:walletScheme names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:walletScheme, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:walletScheme and nothing else. It is not a definition of gmeow:walletScheme (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:walletSchemeFunctionality logic:characterizes gmeow:walletScheme ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# Exact financial quantity roles and explicitly selected computational methods.

gmeow:HoldingAssetQuantity
    a logic:Class , logic:AbstractIndividualType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "asset count quantity"@x-gmeow-english ;
    skos:definition "An exact dimensionless quantity of units of one explicitly identified Asset. The countedAsset and a complete scalar reference frame distinguish shares of different assets; it is not a money value."@x-gmeow-english ;
    skos:example "ex:shares a gmeow:HoldingAssetQuantity ; math:quantityValue 10.0 ; math:hasDimension math:dimensionless ; gmeow:countedAsset ex:stock ; gmeow:hasReferenceFrame ex:shareCountFrame ."@x-gmeow-english ;
    gmeow:useWhen "Use for a holding's exact count of units of a specific asset."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid monetary cost, unnamed assets and substituting shares of another asset."@x-gmeow-english ;
    gmeow:howToUse "Link it through holdingQuantity; match countedAsset to holdingAsset and declare the scalar mathematical count frame."@x-gmeow-english .

gmeow:FinancialPeriodRate
    a logic:Class , logic:AbstractIndividualType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "financial rate per explicit period"@x-gmeow-english ;
    skos:definition "An exact dimensionless fractional rate per one explicitly named period-basis reference frame. Its magnitude is a fraction, not a percentage number, and can be negative; it is not a probability or an inverse-time SI quantity."@x-gmeow-english ;
    skos:example "ex:rate a gmeow:FinancialPeriodRate ; math:quantityValue 0.05 ; math:hasDimension math:dimensionless ; gmeow:hasReferenceFrame ex:contractYear ."@x-gmeow-english ;
    gmeow:useWhen "Use for a fractional interest rate per explicitly defined financial period."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid the percentage number 5 for five percent, probability typing and implicit annualization."@x-gmeow-english ;
    gmeow:howToUse "Supply the decimal fraction through interestRate; use the same period frame as the count and calculation."@x-gmeow-english .

gmeow:FinancialPeriodCount
    a logic:Class , logic:AbstractIndividualType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "count of explicit financial periods"@x-gmeow-english ;
    skos:definition "An exact dimensionless count of periods on an explicit period-basis reference frame. A fractional count is allowed; the count and rate in simple interest must name the same basis, with no implied conversion between calendar years and days."@x-gmeow-english ;
    skos:example "ex:periods a gmeow:FinancialPeriodCount ; math:quantityValue 2.5 ; math:hasDimension math:dimensionless ; gmeow:hasReferenceFrame ex:contractYear ."@x-gmeow-english ;
    gmeow:useWhen "Use for a nonnegative, possibly fractional number of the declared financial periods."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid negative counts, bare durations and silently converting days to contract years."@x-gmeow-english ;
    gmeow:howToUse "Link through interestPeriodCount and match its frame to interestRate and calculationPeriodBasis."@x-gmeow-english .

gmeow:FinancialReturnRatio
    a logic:Class , logic:AbstractIndividualType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "holding-period financial return ratio"@x-gmeow-english ;
    skos:definition "An exact dimensionless fractional holding-period return, computed as closing value minus opening value divided by that same nonzero opening value. Both amounts must share a currency frame; the result records the explicitly selected period basis and is not annualized or a probability."@x-gmeow-english ;
    skos:example "ex:computedReturn a gmeow:FinancialReturnRatio ; math:quantityValue 0.2 ; math:hasDimension math:dimensionless ; gmeow:hasReferenceFrame ex:holdingPeriod ."@x-gmeow-english ;
    gmeow:useWhen "Use for the derived fractional gain or loss over the stated holding period."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid probability typing, automatic annualization and asserting the answer as calculation input."@x-gmeow-english ;
    gmeow:howToUse "Read it from the return calculation's derived observationResult; retain its period frame and native proof."@x-gmeow-english .

gmeow:SimpleInterestCalculation
    a logic:Class , logic:SubKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "simple interest calculation"@x-gmeow-english ;
    skos:definition "A standpoint-indexed Measurement that requests exact simple interest from principalAmount, interestRate and interestPeriodCount using the canonical methodSimpleInterest recipe. The period-basis frame must agree across rate, count and calculation; observationResult is derived with its currency and native proof."@x-gmeow-english ;
    skos:example "ex:interest a gmeow:SimpleInterestCalculation ; gmeow:vantage ex:alice ; gmeow:observedFeature ex:account ; gmeow:observationMethod gmeow:methodSimpleInterest ; gmeow:calculationExpression <urn:gmeow:finance:simple:recipe> ; gmeow:calculationPeriodBasis ex:contractYear ; gmeow:principalAmount ex:principal ; gmeow:interestRate ex:rate ; gmeow:interestPeriodCount ex:periods ."@x-gmeow-english ;
    gmeow:useWhen "Use to request principal times fractional rate times period count with observation context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid compound interest, mixed period bases and preasserted observationResult inputs."@x-gmeow-english ;
    gmeow:howToUse "Provide the three typed quantities, matching period basis and authenticated simple recipe; evaluate the named request."@x-gmeow-english .

gmeow:HoldingPeriodReturnCalculation
    a logic:Class , logic:SubKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "holding-period return calculation"@x-gmeow-english ;
    skos:definition "A standpoint-indexed Measurement requesting exact holding-period return from openingAmount and closingAmount through methodHoldingPeriodReturn. A zero opening value or incompatible currency frames is invalid. The explicitly based FinancialReturnRatio and observationResult link are derived, never asserted as input."@x-gmeow-english ;
    skos:example "ex:return a gmeow:HoldingPeriodReturnCalculation ; gmeow:vantage ex:alice ; gmeow:observedFeature ex:portfolio ; gmeow:observationMethod gmeow:methodHoldingPeriodReturn ; gmeow:calculationExpression <urn:gmeow:finance:return:recipe> ; gmeow:calculationPeriodBasis ex:holdingPeriod ; gmeow:openingAmount ex:opening ; gmeow:closingAmount ex:closing ."@x-gmeow-english ;
    gmeow:useWhen "Use to request the fractional change between opening and closing money values."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a zero opening amount, different currencies and an annualized-return claim."@x-gmeow-english ;
    gmeow:howToUse "Supply two MonetaryAmounts in one currency and the explicit period; evaluate the authenticated return recipe."@x-gmeow-english .

gmeow:countedAsset
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "counted asset"@x-gmeow-english ;
    skos:definition "The specific Asset whose units a HoldingAssetQuantity counts. It must equal the holdingAsset when the quantity fills holdingQuantity; counts of different asset identities cannot be substituted solely because both are physically dimensionless."@x-gmeow-english ;
    skos:example "ex:shares gmeow:countedAsset ex:acmeStock ."@x-gmeow-english ;
    gmeow:useWhen "Use to identify the asset whose units a holding quantity counts."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid naming the holder, monetary cost basis or a merely similar asset."@x-gmeow-english ;
    gmeow:howToUse "Set one Asset on HoldingAssetQuantity, equal to the enclosing holding's holdingAsset."@x-gmeow-english .

gmeow:principalAmount
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "principal amount"@x-gmeow-english ;
    skos:definition "The existing MonetaryAmount used as principal in a SimpleInterestCalculation. Its exact canonical numeric value and explicit currency are inputs, not a precomputed interest result."@x-gmeow-english ;
    skos:example "ex:interest gmeow:principalAmount ex:principal . ex:principal a gmeow:MonetaryAmount ; math:quantityValue 1000.00 ; math:hasDimension math:dimensionless ; gmeow:currency gmeow:referenceFrameUSD ."@x-gmeow-english ;
    gmeow:useWhen "Use for the money quantity multiplied by rate and period count in simple interest."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a bare decimal, accrued interest or the final principal-plus-interest total."@x-gmeow-english ;
    gmeow:howToUse "Link the calculation to one complete MonetaryAmount; keep its currency on that input quantity."@x-gmeow-english .

gmeow:interestRate
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "interest rate"@x-gmeow-english ;
    skos:definition "The FinancialPeriodRate input to simple interest. A magnitude of 0.05 means five percent per one period of its explicit basis; it is not 5, an annualization default or a probability."@x-gmeow-english ;
    skos:example "ex:interest gmeow:interestRate ex:rate . ex:rate a gmeow:FinancialPeriodRate ; math:quantityValue 0.05 ; math:hasDimension math:dimensionless ; gmeow:hasReferenceFrame ex:contractYear ."@x-gmeow-english ;
    gmeow:useWhen "Use for the required fractional rate input of a SimpleInterestCalculation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid linking a probability, a literal percentage or the calculated interest amount."@x-gmeow-english ;
    gmeow:howToUse "Link one FinancialPeriodRate; match its explicit frame to the calculation's period basis."@x-gmeow-english .

gmeow:interestPeriodCount
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "interest period count"@x-gmeow-english ;
    skos:definition "The FinancialPeriodCount multiplier in simple interest. Its reference frame must be the same explicit period basis as interestRate and calculationPeriodBasis."@x-gmeow-english ;
    skos:example "ex:interest gmeow:interestPeriodCount ex:periods . ex:periods a gmeow:FinancialPeriodCount ; math:quantityValue 2.0 ; math:hasDimension math:dimensionless ; gmeow:hasReferenceFrame ex:contractYear ."@x-gmeow-english ;
    gmeow:useWhen "Use for the required period-count multiplier of simple interest."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid linking the interest rate, a raw duration or a count in a different period basis."@x-gmeow-english ;
    gmeow:howToUse "Link one nonnegative FinancialPeriodCount using the same frame as interestRate and calculationPeriodBasis."@x-gmeow-english .

gmeow:openingAmount
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "opening monetary amount"@x-gmeow-english ;
    skos:definition "The nonzero opening MonetaryAmount used as both subtrahend and denominator of holding-period return; the same quantity identity is used in both AST positions."@x-gmeow-english ;
    skos:example "ex:return gmeow:openingAmount ex:opening . ex:opening a gmeow:MonetaryAmount ; math:quantityValue 1000.00 ; math:hasDimension math:dimensionless ; gmeow:currency gmeow:referenceFrameUSD ."@x-gmeow-english ;
    gmeow:useWhen "Use for the initial money value and denominator of holding-period return."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid zero, a different currency from closingAmount or separate denominator inputs."@x-gmeow-english ;
    gmeow:howToUse "Link one nonzero MonetaryAmount; the recipe reuses its symbol for subtraction and division."@x-gmeow-english .

gmeow:closingAmount
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "closing monetary amount"@x-gmeow-english ;
    skos:definition "The closing MonetaryAmount of holding-period return. Its currency frame must exactly match openingAmount before subtraction and division are admitted."@x-gmeow-english ;
    skos:example "ex:return gmeow:closingAmount ex:closing . ex:closing a gmeow:MonetaryAmount ; math:quantityValue 1200.00 ; math:hasDimension math:dimensionless ; gmeow:currency gmeow:referenceFrameUSD ."@x-gmeow-english ;
    gmeow:useWhen "Use for the terminal money value in a holding-period return request."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid the profit alone, a computed return ratio or implicit currency conversion."@x-gmeow-english ;
    gmeow:howToUse "Link one MonetaryAmount in openingAmount's currency; the recipe subtracts opening before dividing."@x-gmeow-english .

gmeow:calculationExpression
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "calculation expression"@x-gmeow-english ;
    skos:definition "The canonical ApplicationExpression recipe of a financial method, or the selected source expression of a financial calculation. The installed caller requires structural identity with its authenticated method recipe, including operator topology and symbol identities."@x-gmeow-english ;
    skos:example "ex:interest gmeow:calculationExpression <urn:gmeow:finance:simple:recipe> ."@x-gmeow-english ;
    gmeow:useWhen "Use to select the mathematical AST matching the declared financial method."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a formula string, an answer quantity or an arbitrary well-typed expression."@x-gmeow-english ;
    gmeow:howToUse "Reference the authenticated method recipe or an AST with identical operators, slot topology and mathematical symbols."@x-gmeow-english .

gmeow:calculationPeriodBasis
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "calculation period basis"@x-gmeow-english ;
    skos:definition "The explicit scalar temporal ReferenceFrame defining one financial period for this calculation and its derived return. It declares a shared basis identity, never an implicit duration conversion or a currency frame."@x-gmeow-english ;
    skos:example "ex:interest gmeow:calculationPeriodBasis ex:contractYear . ex:rate gmeow:hasReferenceFrame ex:contractYear . ex:periods gmeow:hasReferenceFrame ex:contractYear ."@x-gmeow-english ;
    gmeow:useWhen "Use to state which explicit financial period the calculation and its return concern."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a currency frame, an undeclared calendar convention or implicit day-to-year conversion."@x-gmeow-english ;
    gmeow:howToUse "Name one complete scalar temporal ReferenceFrame; reuse its identity on rate and count inputs."@x-gmeow-english .

gmeow:methodSimpleInterest
    a gmeow:ObservationMethod , logic:CallableSignature ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "exact simple interest method"@x-gmeow-english ;
    skos:definition "The exact-decimal computational observation method and callable signature for simple interest P*r*n. Its separately identified canonical AST and parameter definitions are read from the installed authenticated owner, and native execution derives a MonetaryAmount result."@x-gmeow-english ;
    skos:example "ex:interest gmeow:observationMethod gmeow:methodSimpleInterest ; gmeow:calculationExpression <urn:gmeow:finance:simple:recipe> ."@x-gmeow-english ;
    gmeow:useWhen "Use to select the installed exact-decimal principal-times-rate-times-count method."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid compound interest, replacing the authenticated signature or asserting a precomputed answer."@x-gmeow-english ;
    gmeow:howToUse "Select it through observationMethod; bind actual quantities through principalAmount, interestRate and interestPeriodCount, not through symbol definitions."@x-gmeow-english .

gmeow:methodHoldingPeriodReturn
    a gmeow:ObservationMethod , logic:CallableSignature ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "exact holding-period return method"@x-gmeow-english ;
    skos:definition "The exact-decimal computational observation method and callable signature for (closing-opening)/opening. The recipe repeats the opening symbol, requires one currency for both money inputs and derives a FinancialReturnRatio on the explicit period basis; nonterminating decimal quotients fail without rounding."@x-gmeow-english ;
    skos:example "ex:return gmeow:observationMethod gmeow:methodHoldingPeriodReturn ; gmeow:calculationExpression <urn:gmeow:finance:return:recipe> ."@x-gmeow-english ;
    gmeow:useWhen "Use to select the installed exact-decimal closing-minus-opening over opening method."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid annualization, currency conversion and silently rounding a nonterminating quotient."@x-gmeow-english ;
    gmeow:howToUse "Select it through observationMethod; bind money through openingAmount and closingAmount while retaining distinct signature, symbol and quantity identities."@x-gmeow-english .

# Canonical exact quantity profiles and financial method input/output contracts.
gmeow:HoldingAssetQuantity logic:subClassOf math:Quantity .
gmeow:HoldingAssetQuantity logic:subClassOf [ a logic:Restriction ; logic:onProperty math:quantityValue ; logic:allValuesFrom xsd:decimal ] .
gmeow:HoldingAssetQuantity logic:subClassOf [ a logic:Restriction ; logic:onProperty math:quantityValue ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:HoldingAssetQuantity ; logic:closureKey "https://blackcatinformatics.ca/math/quantityValue" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:HoldingAssetQuantity logic:subClassOf [ a logic:Restriction ; logic:onProperty math:hasDimension ; logic:allValuesFrom math:Dimension ] .
gmeow:HoldingAssetQuantity logic:subClassOf [ a logic:Restriction ; logic:onProperty math:hasDimension ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:HoldingAssetQuantity ; logic:closureKey "https://blackcatinformatics.ca/math/hasDimension" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:HoldingAssetQuantity logic:subClassOf [ a logic:Restriction ; logic:onProperty math:hasDimension ; logic:hasValue math:dimensionless ] .
gmeow:HoldingAssetQuantity logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:hasReferenceFrame ; logic:allValuesFrom gmeow:ReferenceFrame ] .
gmeow:HoldingAssetQuantity logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:hasReferenceFrame ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:HoldingAssetQuantity ; logic:closureKey "https://blackcatinformatics.ca/gmeow/hasReferenceFrame" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:FinancialPeriodRate logic:subClassOf math:Quantity .
gmeow:FinancialPeriodRate logic:subClassOf [ a logic:Restriction ; logic:onProperty math:quantityValue ; logic:allValuesFrom xsd:decimal ] .
gmeow:FinancialPeriodRate logic:subClassOf [ a logic:Restriction ; logic:onProperty math:quantityValue ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FinancialPeriodRate ; logic:closureKey "https://blackcatinformatics.ca/math/quantityValue" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:FinancialPeriodRate logic:subClassOf [ a logic:Restriction ; logic:onProperty math:hasDimension ; logic:allValuesFrom math:Dimension ] .
gmeow:FinancialPeriodRate logic:subClassOf [ a logic:Restriction ; logic:onProperty math:hasDimension ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FinancialPeriodRate ; logic:closureKey "https://blackcatinformatics.ca/math/hasDimension" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:FinancialPeriodRate logic:subClassOf [ a logic:Restriction ; logic:onProperty math:hasDimension ; logic:hasValue math:dimensionless ] .
gmeow:FinancialPeriodRate logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:hasReferenceFrame ; logic:allValuesFrom gmeow:ReferenceFrame ] .
gmeow:FinancialPeriodRate logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:hasReferenceFrame ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .
