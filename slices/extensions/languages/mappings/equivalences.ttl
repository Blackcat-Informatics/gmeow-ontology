@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lime:    <http://www.w3.org/ns/lemon/lime#> .
@prefix lvont:   <http://lexvo.org/ontology#> .

# Term equivalences for the languages domain — GMEOW authoring source.
# Compiled to mappings/gmeow-languages.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetLanguages a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/languages" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Language alignments — schema.org + Wikidata. gmeow:Language is registry-INDEPENDENT (a self-minted IRI); these are see-also links, and coreference of language INSTANCES to Lexvo (http://lexvo.org/id/iso639-3/…), Glottolog and Wikidata items is asserted in data with skos:exactMatch + gmeow:authorityLink, not here. Proficiency scales (CEFR/ILR/ACTFL), version lineage, and origin/modality/status value vocabularies are largely CANONICAL — no maintained external RDF vocabulary covers them faithfully. Scripts and orthographies are grounded in the lang: layer (lang:Script / lang:Orthography), so their alignments live with the grounding vocabulary, not here. The reified gmeow:LanguageProficiency flattens to schema:knowsLanguage / wdt:P1412 only via the EDOAL+FnO projection layer, not by a 1:1 SSSOM claim." .

gmeow:Language skos:closeMatch schema:Language {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:Language skos:closeMatch wd:Q34770 {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:knowsLanguage skos:closeMatch schema:knowsLanguage {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:knowsLanguage skos:closeMatch wdt:P1412 {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7
|} .

gmeow:nativeLanguage skos:closeMatch wdt:P103 {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

gmeow:languageCode skos:closeMatch schema:iso6391Code {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6
|} .

gmeow:originNatural skos:closeMatch wd:Q33742 {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7
|} .

gmeow:originConstructedEngineered skos:closeMatch wd:Q33215 {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6
|} .

gmeow:modalitySigned skos:closeMatch wd:Q34228 {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6
|} .

# temporal-frame design — Linguistic reference frames (Lexvo alignment).
# Contextual: a gmeow:ReferenceFrame whose frameRealm is gmeow:frameRealmLinguistic
# corresponds to a lvont:Language.

gmeow:ReferenceFrame skos:closeMatch lvont:Language {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "contextual — holds when the ReferenceFrame's frameRealm is gmeow:frameRealmLinguistic"
|} .

gmeow:hasReferenceFrame skos:closeMatch lvont:language {|
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "links a named expression or lexical entity to its language frame"
|} .
