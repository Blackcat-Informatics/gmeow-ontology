#
# Counter-example for the `math:` expression lowering
# (crates/logic/src/physical/lower.rs, MathLoweringError::ArgumentSlotMultipleIndexes):
# a math:ApplicationExpression root whose one math:ArgumentSlot names TWO
# math:slotIndex values (0 and 1) — an ambiguous operand position, distinct from a
# missing index (ArgumentSlotMissingIndex) or two SLOTS sharing one index
# (DuplicateArgumentSlotIndex, already covered by slot-index-duplicate.ttl): here ONE
# slot itself carries two indexes. The authored math:structuralKey lets the
# reasoned-graph gate (check_structural_key_on_rejected_expression) also reach it.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:root a math:ApplicationExpression ;
    math:operator ex:op ;
    math:argumentSlot ex:slot0 ;
    math:structuralKey "not-a-real-digest" .

ex:slot0 a math:ArgumentSlot ;
    math:slotIndex 0 , 1 ;
    math:slotExpression ex:operand .

ex:operand a math:NumberLiteral ;
    math:literalValue 1 .
