|} .

gmeow:Trajectory skos:relatedMatch crm:E92_Spacetime_Volume {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:objectLabel "Spacetime Volume" ;
    gmeow:comment "a Trajectory is a continuous spacetime volume (relatedMatch, not closeMatch — a trajectory is a path, not any arbitrary volume)"
|} .

