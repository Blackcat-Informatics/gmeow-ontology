#
# Counter-example for math:BindingExpressionShape: a math:BindingExpression naming its
# binder operator and its body through an indexed math:argumentSlot, but omitting
# math:boundVariable (sh:minCount 1) — a binder without its bound variable. The single
# slot is well-formed (index + expression), so validation MUST emit
# shacl.MinCountConstraintComponent and no other finding (math:MalformedBindingExpression).
# Bound by ex:ecMalformedBindingExpression.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:variablelessBinder a math:BindingExpression ;
    math:operator math:summationBinder ;
    math:argumentSlot ex:variablelessBinderSlot0 .

ex:variablelessBinderSlot0 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression ex:binderBody .

ex:binderBody a math:MathematicalExpression .
