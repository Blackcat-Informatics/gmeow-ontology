    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "trigger" ; gmeow:cellValueIri gmeow:mediumCodec ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "triggerValue" ; gmeow:cellValueIri gmeow:codecZstdRsyncable ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "required" ; gmeow:cellValueIri gmeow:mediumZstdLevel ] .
