gmeow:QueryOrderCriterionKindLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query order criterion kind law"@x-gmeow-english ;
    skos:definition "Two criterion occurrences of one policy selecting the same comparison-key kind must be the same occurrence. A policy cannot give one key kind competing precedence positions."@x-gmeow-english ;
    gmeow:useWhen "Use to reject duplicate content-tier, score, activation or subject-tie occurrences within a definition."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating equal key kinds in different policies as occurrence identity or interpreting duplicate rejection as permission to discard a source declaration."@x-gmeow-english ;
    gmeow:howToUse "Bind two policy criteria sharing the same orderCriterionKind resource and compare their occurrence identities through logic:termEqual."@x-gmeow-english ;
    skos:scopeNote "The law is scoped to one policy; it imposes no global identity key or cross-policy preference."@x-gmeow-english ;
    skos:example "One selected score occurrence: ex:policy gmeow:orderCriterion ex:scoreKey . ex:scoreKey gmeow:orderCriterionKind gmeow:orderFusedScore ."@x-gmeow-english ;
