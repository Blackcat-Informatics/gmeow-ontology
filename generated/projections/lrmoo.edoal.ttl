@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/lrmoo>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:Expression ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri lrmoo:F2_Expression ;
        ] ;
        align:relation "<=" ;
        rdfs:label "Expression → LRMoo F2 Expression"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:MusicalWork ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri lrmoo:F1_Work ;
            ] ;
            align:relation "<=" ;
            rdfs:label "MusicalWork → LRMoo F1 Work"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:eventTypeMusicalPerformance ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri lrmoo:F31_Performance ;
            ] ;
            align:relation "<=" ;
            rdfs:label "musical performance Event → LRMoo F31 Performance"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "lrmoo" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → lrmoo (EDOAL)"@en .
