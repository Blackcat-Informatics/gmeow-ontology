("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateCounterpartNonTransitive" (lit "gmeow:counterpartOf across realms, frames and datasets: symmetric-only, never transitively chained"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateCrossNodeGlut" (lit "derivation: shared gmeow:findingAnchor typed gmeow:NonTrivialAnchor, distinct findings, gmeow:categoryPolarity logic:InfoSupported ∧ logic:InfoOpposed ⇒ gmeow:crossNodeGlutWith"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateDeceptionHeldProjectedDivergence" (lit "necessary condition: gmeow:eventTypeDeception ⇒ a divergent held/projected DoxasticStandpointClaim pair"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateDiagnosticMetaExtensibility" (lit "derivation: gmeow:findingRootCause ⇒ rdf:type gmeow:RootFinding, discovered and run by the gmeow:DiagnosticMetaRule class selection with no engine change"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateEndurantPerdurantDisjoint" (lit "logic:Endurant owl:disjointWith logic:Perdurant — the continuant/occurrent divide at the top of the foundation"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateEntitySortalCovering" (lit "covering: every gmeow:Entity is one of {Agent, InformationObject, PhysicalObject, SocialObject}"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateEventSituationDisjoint" (lit "logic:Event owl:disjointWith logic:Situation — the occurrence/configuration distinction within the occurrent branch"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateFalsehoodIsRefutedClaim" (lit "equivalence: gmeow:claimModality gmeow:refuted ⟺ StandpointClaim with polarityDeny ∧ modalForceNecessary"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateFindingCluster" (lit "derivation: gmeow:findingRootCause ⇒ gmeow:findingCluster (member), gmeow:clusterRoot (root-keyed self-edge), and rdf:type gmeow:FindingCluster (grouping node), the cluster identified by its shared root finding"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateFindingRootCause" (lit "derivation: gmeow:findingAntecedent ⇒ gmeow:findingHasAntecedent (self-edge), and gmeow:findingTraces to a root NOT gmeow:findingHasAntecedent of itself ⇒ gmeow:findingRootCause (stratified negation as failure)"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateFindingTraces" (lit "derivation: gmeow:findingAntecedent ⇒ gmeow:findingTraces (base), and gmeow:findingAntecedent ∘ gmeow:findingTraces ⇒ gmeow:findingTraces (recursive step), the transitive closure up the witness DAG"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateFrameRelativity" (lit "the true-quantity/measured-value seam: a logic:measuredValue is frame-relative and ill-formed without its logic:referenceFrame; no frame-free equality collapse"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateFunctionalComplexKindDisjoint" (lit "pairwise owl:disjointWith over the three mereological individuation kinds logic:Collection, logic:FunctionalComplex and logic:Quantity"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateGateFatalVerdict" (lit "derivation: (gmeow:findingSeverity gmeow:severityError) ∧ (gmeow:findingCategory ∘ gmeow:categoryBlocking gmeow:blockingBlocking) ∧ (gmeow:findingStandpoint gmeow:standpointBinding) ⇒ gmeow:findingGateVerdict gmeow:gateFatal"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateIndirectContributor" (lit "derivation: gmeow:wasGeneratedBy ∘ gmeow:wasAssociatedWith ⇒ gmeow:indirectContributor over the provenance generation chain"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateInstantiatesWork" (lit "derivation: gmeow:exemplifies ∘ gmeow:embodies ∘ gmeow:realizes ⇒ gmeow:instantiatesWork over the WEMI spine"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateIntentNotEntailed" (lit "gmeow:deceptiveIntentClaim over deception events: intent stays an attributed, defeasible claim, never a reasoned entailment"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateLicensedFalsehoodNotDeception" (lit "necessary condition: a licensed-falsehood projected claim ⇒ ¬ gmeow:eventTypeDeception"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateNoOverTyping" (lit "logic:Kind identity supply: an instance's sortal traces to exactly one ultimate Kind; two disjoint Kinds on one instance is over-typing"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateObjectIndividuationCovering" (lit "covering: every logic:Object is one of {Collection, Quantity, FunctionalComplex}"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateOrgMembershipPropagation" (lit "derivation: gmeow:memberOf ∘ gmeow:subOrganizationOf ⇒ gmeow:memberOf, recursive up the sub-organization hierarchy"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateProperPartOfAsymmetric" (lit "logic:properPartOf asymmetry over the endurant strict-parthood spine"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateRelatorMediation" (lit "every class subClassOf logic:Relator; a concrete relator (one with no logic: subclass) must reach at least two distinct entities — two distinct logic:mediates roles, or one non-functional role — or fire logic:violation logic:RelComp"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateSocialInformationOverlap" (lit "the deliberately-preserved gmeow:SocialObject ∩ gmeow:InformationObject overlap: an explicit, reviewed non-assertion of disjointness"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateTenureClaimSurfacing" (lit "derivation: gmeow:standpointClaim with gmeow:tenureStandpoint ⇒ gmeow:vantage, and with gmeow:tenurePosition ⇒ gmeow:observedFeature, onto the generated StandpointClaim"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateTopSortalDisjoint" (lit "pairwise owl:disjointWith among the four top sortals gmeow:Agent, gmeow:InformationObject, gmeow:PhysicalObject and gmeow:SocialObject, except the preserved gmeow:SocialObject ∩ gmeow:InformationObject overlap"))
