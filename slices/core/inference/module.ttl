@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:AcceptanceStatus
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Acceptance Status"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The Dung labelling status an gmeow:ArgumentEvaluation assigns an argument under a named acceptability semantics — a value vocabulary (individuals, never subclasses): gmeow:acceptanceIn (in the extension), gmeow:acceptanceOut (attacked by an accepted argument), gmeow:acceptanceUndecided (neither). A solver-set value (Principle 12): the engine writes exactly one, and there is no asserted accepted / isBest bit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Analogy
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Analogy"@x-gmeow-english ;
    logic:mediates gmeow:analogicalSource ,
        gmeow:analogicalTarget ,
        gmeow:hasCorrespondence ;
    rdfs:subClassOf logic:Relator ;
    skos:definition "A reified analogical mapping — the source-to-target structure-mapping (Gentner) that warrants an analogical inference: it mediates a source domain (gmeow:analogicalSource), a target domain (gmeow:analogicalTarget), and the element-pair correspondences (gmeow:hasCorrespondence) holding between them, scored by structural consistency (gmeow:systematicity, solver-layer). The warrant of an analogical gmeow:InferenceCommitment points at an Analogy. Rival mappings compete; best-analogy selection is solver-layer like IBE, never an asserted isBest bit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Argument
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Argument"@x-gmeow-english ;
    logic:mediates gmeow:argumentConclusion ,
        gmeow:hasPremiseUse ,
        gmeow:hasInferenceApplication ;
    logic:instantiatesFramework logic:EpistemicFramework ;
    rdfs:subClassOf logic:Relator ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:hasPremiseUse ;
            owl:allValuesFrom gmeow:PremiseUse ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:hasInferenceApplication ;
            owl:allValuesFrom gmeow:InferenceApplication ;
        ] ;
    skos:definition "A node in an argumentation framework — the attackable, supportable unit a named acceptability semantics is evaluated over (Dung / ASPIC+). An Argument wraps at most one Toulmin step (gmeow:argumentInferenceStep -> gmeow:InferenceCommitment), rests on the premises it actually uses (gmeow:hasPremiseUse) via the rule it applies (gmeow:hasInferenceApplication), and establishes a conclusion (gmeow:argumentConclusion). It bears the typed gmeow:Attack and the accruing gmeow:Support relations toward other arguments, and is the proper domain the epistemics gmeow:attacksClaim / gmeow:supportsClaim hooks pair with. A relator, not a process (the gmeow:Commitment idiom); whether it survives is the solver-layer gmeow:ArgumentEvaluation, never an asserted accepted bit (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ArgumentEvaluation
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Argument Evaluation"@x-gmeow-english ;
    logic:mediates gmeow:evaluatesArgument ,
        gmeow:extensionMember ;
    rdfs:subClassOf logic:Relator ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:evaluatesArgument ;
            owl:allValuesFrom gmeow:Argument ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:acceptanceStatus ;
            owl:allValuesFrom gmeow:AcceptanceStatus ;
        ] ;
    skos:definition "A reified, solver-set verdict on a gmeow:Argument — the gmeow:AcceptanceStatus it carries (gmeow:acceptanceStatus) under a named acceptability semantics (gmeow:underSemantics -> logic:ArgumentationSemantics), together with the extension it belongs to (gmeow:extensionMember). The argument-graph evaluation is COMPUTED, never asserted (Principle 12): there is no accepted / isBest bit, only the engine-written status; under a credulous (preferred) semantics several evaluations of one argument coexist, one per extension (Principle 9). Reifies the assessment so its semantics, status, and extension travel as one auditable bundle."@x-gmeow-english ;
    skos:scopeNote "Couples to the central acceptability semantics by reference (gmeow:underSemantics -> logic:GroundedArgumentation / logic:PreferredArgumentation / logic:NoArgumentation / logic:PolicySpecificArgumentation), with no asserted triples into logic:. The named-acceptability-semantics account is canonical in design/LOGIC-FOUNDATION.md (Argumentation and epistemic standards), referenced here by prose (Principle 5)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Attack
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Attack"@x-gmeow-english ;
    logic:mediates gmeow:attackSource ,
        gmeow:attackTarget ;
    rdfs:subClassOf logic:Relator ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:attackKind ;
            owl:allValuesFrom gmeow:AttackKind ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:attackSource ;
            owl:allValuesFrom gmeow:Argument ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:attackTarget ;
            owl:allValuesFrom [
                a owl:Class ;
                owl:unionOf ( gmeow:PremiseUse gmeow:InferenceApplication gmeow:StandpointClaim ) ;
            ] ;
        ] ;
    skos:definition "A reified, TYPED attack between arguments — a structural conflict that names WHAT it attacks and HOW. It relates an attacking structure (gmeow:attackSource) to a target (gmeow:attackTarget, a gmeow:AttackTarget) under a kind (gmeow:attackKind, a gmeow:AttackKind): gmeow:attackUndermine attacks a gmeow:PremiseUse, gmeow:attackUndercut attacks a gmeow:InferenceApplication (the warrant), gmeow:attackRebut attacks the conclusion gmeow:StandpointClaim. The attack is the structural relation, never the adjudicated outcome — which argument survives is the solver-layer gmeow:ArgumentEvaluation. Self-attack is forbidden by SHACL, not OWL (the gmeow:competesWith discipline — doctrine in SHACL, keeping the DL profile clean)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AttackKind
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Attack Kind"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of a typed gmeow:Attack — a value vocabulary (individuals, never subclasses) naming what the attack targets: gmeow:attackUndermine (a premise), gmeow:attackUndercut (the warrant / inferential link), gmeow:attackRebut (the conclusion). The canonical three-way typed-attack distinction (design/LOGIC-FOUNDATION.md); it subsumes the older Pollock two-way rebutting / undercutting, of which undermine is the premise-directed third."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AttackTarget
    a logic:Category ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Attack Target"@x-gmeow-english ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [
        a owl:Class ;
        owl:unionOf ( gmeow:PremiseUse gmeow:InferenceApplication gmeow:StandpointClaim ) ;
    ] ;
    skos:definition "The class of things a typed gmeow:Attack can target — a gmeow:PremiseUse (undermine), a gmeow:InferenceApplication (undercut), or a conclusion gmeow:StandpointClaim (rebut). Introduced as a named superclass so that schema projections can assign a single range to gmeow:attackTarget instead of losing a blank-node owl:unionOf."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Correspondence
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Correspondence"@x-gmeow-english ;
    logic:mediates gmeow:correspondingSource ,
        gmeow:correspondingTarget ;
    rdfs:subClassOf logic:Relator ;
    skos:definition "A single mapped element-pair within an gmeow:Analogy — the reified relation that one source element (gmeow:correspondingSource) plays the same structural role as one target element (gmeow:correspondingTarget). Reached from its analogy via gmeow:hasCorrespondence. The atom of structure-mapping: an analogy's systematicity is the structural consistency of its set of Correspondences."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:InferenceApplication
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Inference Application"@x-gmeow-english ;
    logic:mediates gmeow:appliedRule ,
        gmeow:appliedSubstitution ;
    rdfs:subClassOf logic:Relator ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:appliedSubstitution ;
            owl:allValuesFrom xsd:string ;
        ] ;
    skos:definition "A reified application of an inference rule within a gmeow:Argument — the rule that licenses the step (gmeow:appliedRule, by reference at a logic: rule / proof-trace) together with the substitution that instantiates it (gmeow:appliedSubstitution). The target of an undercutting gmeow:Attack: granting the premises, an undercut denies that THIS rule-application supports the conclusion. Rule-applicability stays defeasible even where the deductive step is contract-local indefeasible (design/LOGIC-FOUNDATION.md)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:InferenceCommitment
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Inference Commitment"@x-gmeow-english ;
    logic:mediates gmeow:candidateHypothesis ,
        gmeow:explanandum ,
        gmeow:premise ,
        gmeow:warrant ;
    rdfs:subClassOf logic:Relator ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:conclusion ;
            owl:allValuesFrom gmeow:StandpointClaim ;
        ] ;
    skos:definition "The endurant, structured argument relation an inference instantiates — the reified Toulmin/Peircean commitment mediating its premises (gmeow:premise), its single conclusion (gmeow:conclusion, a gmeow:StandpointClaim), its warrant (gmeow:warrant), and its mode (gmeow:inferenceModeOf). The argumentation layer wraps it in a gmeow:Argument (gmeow:argumentInferenceStep) to bear the typed gmeow:Attack and accruing gmeow:Support relations. A relator, not a process (the gmeow:Commitment idiom): the occurrent reasoning episode that bears it is the gmeow:InferenceProcess reached by gmeow:hasInferenceCommitment. Reifying is the on-demand tier; the flat 80% case hangs gmeow:inferredFrom + gmeow:inferenceMode directly on the conclusion-claim. Retained as audit when its conclusion is suppressed (belief revision), never erased (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:InferenceMode
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Inference Mode"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The Peircean mode of an inference — a closed-but-open value vocabulary (individuals, never subclasses; the gmeow:StandpointModality idiom): gmeow:modeDeduction, gmeow:modeInduction, gmeow:modeAbduction, gmeow:modeAnalogical. The mode rides as a gmeow:inferenceMode value on the claim (or gmeow:inferenceModeOf on the commitment), never as a subclass of gmeow:InferenceCommitment (Principle 9: no overtyping). The modes differ by warrant and default modality, not by subsumption."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:InferenceProcess
    a logic:Event ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Inference Process"@x-gmeow-english ;
    rdfs:subClassOf gmeow:MentalProcess ;
    skos:definition "The occurrent reasoning episode — inference as it unfolds in time, drawing a conclusion from premises. The perdurant face of inference: a gmeow:MentalProcess borne by exactly one gmeow:experiencer and carrying gmeow:mentalProcessType gmeow:processReasoning, the reparenting hook the mentation slice reserves. It gmeow:producesMentalMoment the belief it creates and reaches its argument structure via gmeow:hasInferenceCommitment. Distinct from the endurant gmeow:InferenceCommitment (the argument relation it instantiates) — keeping the gUFO endurant/occurrent split clean."@x-gmeow-english ;
    skos:scopeNote "The occurrent kind of an inference is recorded as gmeow:mentalProcessType gmeow:processReasoning, NOT as a dedicated gmeow:EventType value: an 'eventTypeInference' individual was deliberately NOT minted (Principle 4 — one canonical source), since processReasoning already names this occurrent fact on the mentation spine."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:InferenceTenure
    a logic:Situation ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Inference Tenure"@x-gmeow-english ;
    rdfs:subClassOf gmeow:TimeScopedRelation ;
    skos:definition "The reified, time-scoped fact that an gmeow:InferenceCommitment's conclusion was held over an interval — opened when the conclusion is accepted and closed when a defeater fires, never deleted (Principle 10). Belief revision is the closing of a tenure (and gmeow:displayable false on the conclusion-claim), not the erasure of the commitment, which survives as audit. Carries its interval via gmeow:duringInterval (temporal module). Use only when the adoption / retraction of the conclusion is itself worth modelling; the common case is a bare claim with its modality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:PremiseUse
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Premise Use"@x-gmeow-english ;
    logic:mediates gmeow:premiseUsed ,
        gmeow:hasPremiseUse ;
    rdfs:subClassOf logic:Relator ;
    skos:definition "A reified USE of a premise within a gmeow:Argument — the basing fact that this argument actually rests on this premise (gmeow:premiseUsed), distinct from the merely AVAILABLE premises of the underlying gmeow:InferenceCommitment (available != used). The target of an undermining gmeow:Attack, which denies the used premise. Reached from its argument via gmeow:hasPremiseUse."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Support
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Support"@x-gmeow-english ;
    logic:mediates gmeow:supportSource ,
        gmeow:supportTarget ;
    rdfs:subClassOf logic:Relator ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:supportTarget ;
            owl:allValuesFrom gmeow:Argument ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:supportSource ;
            owl:allValuesFrom [
                a owl:Class ;
                owl:unionOf ( gmeow:Argument gmeow:StandpointClaim ) ;
            ] ;
        ] ;
    skos:definition "A reified, ACCRUING support relation in bipolar argumentation — an instance relating a supporting structure (gmeow:supportSource) to the gmeow:Argument it supports (gmeow:supportTarget). Each independent support is its own Support instance, so support ACCRUES: several independent supports for one conclusion combine rather than counting once (Principle 9; design/LOGIC-FOUNDATION.md). The support pole of bipolar argumentation; the attack pole is gmeow:Attack."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:SupportSource
    a logic:Category ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "Support Source"@x-gmeow-english ;
    rdfs:subClassOf owl:Thing ;
    owl:equivalentClass [
        a owl:Class ;
        owl:unionOf ( gmeow:Argument gmeow:StandpointClaim ) ;
    ] ;
    skos:definition "The class of things that can supply support to an gmeow:Argument — another gmeow:Argument or a gmeow:StandpointClaim (an evidential consideration may be carried by either). Introduced as a named superclass so that schema projections can assign a single range to gmeow:supportSource instead of losing a blank-node owl:unionOf."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:acceptanceIn
    a gmeow:AcceptanceStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "in"@x-gmeow-english ;
    skos:definition "The Dung 'in' label — the argument is accepted: it belongs to the extension and every attack on it is defeated by an accepted argument. A solver-set value (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:acceptanceOut
    a gmeow:AcceptanceStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "out"@x-gmeow-english ;
    skos:definition "The Dung 'out' label — the argument is rejected: it is attacked by an argument that is itself accepted. A solver-set value (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:acceptanceStatus
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ArgumentEvaluation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "acceptance status"@x-gmeow-english ;
    rdfs:range gmeow:AcceptanceStatus ;
    skos:definition "The Dung labelling status a gmeow:ArgumentEvaluation assigns its argument — gmeow:acceptanceIn / gmeow:acceptanceOut / gmeow:acceptanceUndecided. Functional: one evaluation, one status. A solver-set value (Principle 12): the engine writes it, and there is no asserted accepted / isBest bit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:acceptanceUndecided
    a gmeow:AcceptanceStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "undecided"@x-gmeow-english ;
    skos:definition "The Dung 'undecided' label — the argument is neither in nor out: the semantics neither accepts nor rejects it (it lies on an even-length attack cycle or is otherwise unsettled). A solver-set value (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:analogicalSource
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Analogy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "analogical source"@x-gmeow-english ;
    skos:definition "The source (base) domain of a gmeow:Analogy — the familiar structure whose relations are mapped onto the target. NOT functional."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN (a source may be any entity, situation, or domain)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

gmeow:analogicalTarget
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Analogy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "analogical target"@x-gmeow-english ;
    skos:definition "The target domain of a gmeow:Analogy — the less-familiar structure that inherits relations from the source via the correspondences. NOT functional."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN (a target may be any entity, situation, or domain)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:appliedRule
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InferenceApplication ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "applied rule"@x-gmeow-english ;
    skos:definition "The inference rule a gmeow:InferenceApplication applies — the licence for the step. Functional: one application applies one rule."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN: the rule may be a logic: rule or proof-trace, an gmeow:Analogy, or a textual rule. The coupling to logic: is by reference (no asserted triples into logic:), mirroring gmeow:warrant."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:appliedSubstitution
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:InferenceApplication ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "applied substitution"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The substitution that instantiates a gmeow:InferenceApplication's rule — the variable bindings under which the rule fires, serialised as text. The logical form stays in logic: (by reference); this records, at the epistemic layer, which binding the agent used. NOT functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:argumentConclusion
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Argument ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "argument conclusion"@x-gmeow-english ;
    skos:definition "The conclusion a gmeow:Argument establishes — the claim it concludes for. Functional: one argument, one conclusion (an argument concluding two things is two arguments)."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN: the conclusion may be a gmeow:StandpointClaim (the usual case, matching the wrapped gmeow:InferenceCommitment's gmeow:conclusion), a gmeow:Proposition, or any reified statement. Mirrors the open-range precedent of gmeow:inferredFrom."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:argumentInferenceStep
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Argument ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "argument inference step"@x-gmeow-english ;
    rdfs:range gmeow:InferenceCommitment ;
    skos:definition "Relates a gmeow:Argument to the single Toulmin step (gmeow:InferenceCommitment) it wraps — the premises x conclusion x warrant structure the argument is built on. Functional: one Argument wraps at most one step; a multi-step chain is a chain of Arguments linked by gmeow:Support."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:attackKind
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Attack ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "attack kind"@x-gmeow-english ;
    rdfs:range gmeow:AttackKind ;
    skos:definition "The kind of a typed gmeow:Attack — gmeow:attackUndermine, gmeow:attackUndercut, or gmeow:attackRebut. Functional: an attack has exactly one kind (SHACL enforces it). The kind and the gmeow:attackTarget agree: undermine targets a gmeow:PremiseUse, undercut a gmeow:InferenceApplication, rebut a gmeow:StandpointClaim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:attackRebut
    a gmeow:AttackKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "rebut"@x-gmeow-english ;
    skos:definition "A rebutting attack — attacks the conclusion directly, arguing for its contrary (the conclusion gmeow:StandpointClaim is the gmeow:attackTarget). The Pollock rebutting defeater, now a typed-attack kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:attackSource
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Attack ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "attack source"@x-gmeow-english ;
    skos:definition "The attacking structure of a typed gmeow:Attack — the gmeow:Argument (or other claim structure) mounting the attack. NOT functional."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN (an gmeow:Argument, a gmeow:StandpointClaim, or any reified counter-structure)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:attackTarget
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Attack ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "attack target"@x-gmeow-english ;
    rdfs:range gmeow:AttackTarget ;
    skos:definition "What a typed gmeow:Attack targets — a gmeow:PremiseUse (undermine), a gmeow:InferenceApplication (undercut), or a conclusion gmeow:StandpointClaim (rebut). Functional: an attack names exactly one target (SHACL enforces it), agreeing with its gmeow:attackKind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:attackUndercut
    a gmeow:AttackKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "undercut"@x-gmeow-english ;
    skos:definition "An undercutting attack — grants the premises but denies that the warrant supports the conclusion (the gmeow:InferenceApplication is the gmeow:attackTarget), removing support without asserting the conclusion's negation. The Pollock undercutting defeater, now a typed-attack kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:attackUndermine
    a gmeow:AttackKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "undermine"@x-gmeow-english ;
    skos:definition "An undermining attack — attacks a premise the argument assumes (the gmeow:PremiseUse is the gmeow:attackTarget). The premise-directed third typed-attack kind, beyond Pollock's two."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:candidateHypothesis
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InferenceCommitment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "candidate hypothesis"@x-gmeow-english ;
    rdfs:range gmeow:StandpointClaim ;
    skos:definition "A candidate explanation considered by an abductive gmeow:InferenceCommitment — one of the competing hypotheses (gmeow:competesWith) among which the inference selects the best. NOT functional: inference-to-the-best-explanation weighs several. The winner is promoted conceivable->probable — the axis transition gmeow:polaritySuspend->gmeow:polarityAffirm + gmeow:modalForcePossible->gmeow:modalForceActual + gmeow:credencePossible->gmeow:credenceLikely, whose legacy gmeow:claimModality projection is conceivable->probable; the losers are suppressed (gmeow:displayable false), never erased."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:competesWith
    a owl:ObjectProperty ,
        owl:SymmetricProperty ;
    rdfs:domain gmeow:StandpointClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "competes with"@x-gmeow-english ;
    rdfs:range gmeow:StandpointClaim ;
    skos:definition "Relates two rival gmeow:StandpointClaim hypotheses that cannot both be accepted as the best explanation — the competition abductive (and analogical) selection resolves. Symmetric: competition is mutual. Irreflexivity (a claim never competes with itself) is enforced by SHACL, not OWL, keeping the DL profile clean (the deception discipline — doctrine in SHACL, not axioms)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:conclusion
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InferenceCommitment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "conclusion"@x-gmeow-english ;
    rdfs:range gmeow:StandpointClaim ;
    skos:definition "The single conclusion of a reified gmeow:InferenceCommitment — the gmeow:StandpointClaim the argument establishes (vantage = the reasoner, observedFeature = the concluded proposition). Functional: one commitment, one conclusion; an argument with two conclusions is two commitments (SHACL enforces exactly one)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:correspondingSource
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "corresponding source"@x-gmeow-english ;
    skos:definition "The source-domain element of a gmeow:Correspondence — one half of a mapped pair. Functional: a correspondence maps exactly one source element to one target element."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN (the element may be any entity or relation in the source domain)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

gmeow:correspondingTarget
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "corresponding target"@x-gmeow-english ;
    skos:definition "The target-domain element of a gmeow:Correspondence — the other half of a mapped pair. Functional: exactly one target element per correspondence."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN (the element may be any entity or relation in the target domain)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:evaluatesArgument
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ArgumentEvaluation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "evaluates argument"@x-gmeow-english ;
    rdfs:range gmeow:Argument ;
    skos:definition "Relates a gmeow:ArgumentEvaluation to the gmeow:Argument it assesses. Functional: one evaluation assesses one argument under one semantics; a credulous semantics yields several evaluations of the same argument, one per extension."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:explains
    a owl:ObjectProperty ;
    rdfs:domain gmeow:StandpointClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "explains"@x-gmeow-english ;
    skos:definition "Relates a candidate hypothesis (a gmeow:StandpointClaim) to an explanandum it would account for — the explanatory link a solver back-checks (does the hypothesis, with the background, entail the explanandum?). NOT functional."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN (it points at whatever the explanandum is). The back-check is solver-layer (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:explanandum
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InferenceCommitment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "explanandum"@x-gmeow-english ;
    skos:definition "The fact to be explained by an abductive gmeow:InferenceCommitment — the surprising observation the inference seeks the best explanation of. NOT functional."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN (an observation, a claim, or a proposition)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:explanatoryScore
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:StandpointClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "explanatory score"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "A solver-computed score of how well a candidate hypothesis explains its explanandum (simplicity, scope, coherence) — the basis on which inference-to-the-best-explanation ranks rivals. A solver-layer value (Principle 12), not an asserted truth: there is no isBest bit; the ranking promotes the winner's modality and suppresses the losers. NOT functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extensionMember
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ArgumentEvaluation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "extension member"@x-gmeow-english ;
    rdfs:range gmeow:Argument ;
    skos:definition "Relates a gmeow:ArgumentEvaluation to an gmeow:Argument jointly accepted in the extension this evaluation records — the set of arguments accepted together under the semantics. NOT functional: an extension holds many arguments, and a preferred semantics admits several extensions, so several evaluations coexist (Principle 9)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasCorrespondence
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Analogy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "has correspondence"@x-gmeow-english ;
    rdfs:range gmeow:Correspondence ;
    skos:definition "Relates a gmeow:Analogy to one of its element-pair gmeow:Correspondence relations — the reified mapped pairs whose structural consistency is the analogy's gmeow:systematicity. NOT functional: an analogy holds many correspondences."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasInferenceApplication
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Argument ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "has inference application"@x-gmeow-english ;
    rdfs:range gmeow:InferenceApplication ;
    skos:definition "Relates a gmeow:Argument to a gmeow:InferenceApplication (rule + substitution) by which it derives its conclusion from its premise-uses. NOT functional: an argument's derivation may chain several rule-applications."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasInferenceCommitment
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InferenceProcess ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "has inference commitment"@x-gmeow-english ;
    rdfs:range gmeow:InferenceCommitment ;
    skos:definition "Relates an occurrent gmeow:InferenceProcess (the reasoning episode) to the endurant gmeow:InferenceCommitment (the argument structure) it instantiates — the bridge across the gUFO endurant/occurrent divide that keeps the two faces of inference distinct yet linked. NOT functional: one reasoning episode may settle several arguments."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasPremiseUse
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Argument ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "has premise use"@x-gmeow-english ;
    rdfs:range gmeow:PremiseUse ;
    skos:definition "Relates a gmeow:Argument to a gmeow:PremiseUse it rests on — the premises it actually bases on (available != used). NOT functional: an argument may use several premises."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:inferenceMode
    a owl:ObjectProperty ;
    rdfs:domain gmeow:StandpointClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "inference mode"@x-gmeow-english ;
    rdfs:range gmeow:InferenceMode ;
    skos:definition "The Peircean mode by which a gmeow:StandpointClaim was reached — a gmeow:InferenceMode value (gmeow:modeDeduction / modeInduction / modeAbduction / modeAnalogical). NOT functional: a claim independently reached by parallel modes carries several. The flat counterpart of gmeow:inferenceModeOf on the reified commitment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:inferenceModeOf
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InferenceCommitment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "inference mode of"@x-gmeow-english ;
    rdfs:range gmeow:InferenceMode ;
    skos:definition "The Peircean mode of a reified gmeow:InferenceCommitment — a gmeow:InferenceMode value. Functional: a commitment has exactly one mode (a step that is both inductive and abductive is two commitments). The reified counterpart of the flat gmeow:inferenceMode; the value scopes the abduction / analogy SHACL shapes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:inferredFrom
    a owl:ObjectProperty ;
    rdfs:domain gmeow:StandpointClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "inferred from"@x-gmeow-english ;
    skos:definition "Relates a concluded gmeow:StandpointClaim to a premise it was inferred from — the flat, reification-free shortcut (the 80% case). NOT functional: a conclusion may rest on several premises. When the full argument structure matters, reify with a gmeow:InferenceCommitment (gmeow:pairsWith) whose gmeow:premise / gmeow:conclusion carry the same content."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN: a premise may be another gmeow:StandpointClaim, a gmeow:Proposition, an observation, or any reified statement. Mirrors the open-range precedent of gmeow:observedFeature."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:pairsWith gmeow:InferenceCommitment .

gmeow:modeAbduction
    a gmeow:InferenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "abduction"@x-gmeow-english ;
    skos:definition "Abductive inference — inference to the best explanation: construct candidate hypotheses (gmeow:candidateHypothesis) for an explanandum, back-check them (gmeow:explains), and rank by gmeow:explanatoryScore. Not truth-preserving; defeasible; default axes (suspend, possible, credencePossible, assume, truth-aimed, neither) — the legacy gmeow:conceivable projection — promoted for the winner to (affirm, actual, credenceLikely, conjecture, truth-aimed, supported) = gmeow:probable; rivals genuinely compete (gmeow:competesWith)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# The mode-scoped well-formedness of an abductive gmeow:InferenceCommitment: the four
# Peircean modes ride ONE class discriminated by a gmeow:inferenceModeOf VALUE (Principle 9,
# no overtyping), so the obligation is a general class axiom keyed on that value — every
# commitment with gmeow:inferenceModeOf gmeow:modeAbduction must name the fact it explains
# (gmeow:explanandum) and at least one candidate explanation (gmeow:candidateHypothesis).
[
    a owl:Restriction ;
    owl:onProperty gmeow:inferenceModeOf ;
    owl:hasValue gmeow:modeAbduction ;
] rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty gmeow:explanandum ;
    owl:someValuesFrom owl:Thing ;
] .

[
    a owl:Restriction ;
    owl:onProperty gmeow:inferenceModeOf ;
    owl:hasValue gmeow:modeAbduction ;
] rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty gmeow:candidateHypothesis ;
    owl:someValuesFrom gmeow:StandpointClaim ;
] .

gmeow:modeAnalogical
    a gmeow:InferenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "analogical"@x-gmeow-english ;
    skos:definition "Analogical inference — source-to-target structure-mapping (Gentner): transfer relational structure from a familiar source to a target via a gmeow:Analogy, scored by gmeow:systematicity. Not truth-preserving; defeasible; default axes projecting to the legacy gmeow:conceivable, promoted to the gmeow:probable tuple for the best mapping; rival mappings compete."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:modeDeduction
    a gmeow:InferenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "deduction"@x-gmeow-english ;
    skos:definition "Deductive inference — truth-preserving derivation under a monotonic profile with a native logic proof trace: if the premises hold, the conclusion holds. Non-defeasible; default modality gmeow:unequivocal. At the logic: derivation layer the mode is read off the profile and never separately tagged (Principle 4); gmeow:modeDeduction is the legitimate way to record, at the epistemic / memory layer, that the agent reached this by deduction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:modeInduction
    a gmeow:InferenceMode ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "induction"@x-gmeow-english ;
    skos:definition "Inductive inference — generalisation over a sample, warranted by gmeow:evidenceStrength (logic:). Not truth-preserving; defeasible; default modality gmeow:probable; competing generalisations may rival it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:premise
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InferenceCommitment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "premise"@x-gmeow-english ;
    skos:definition "A premise of a reified gmeow:InferenceCommitment — an input from which its conclusion is drawn. NOT functional: an argument has one or more premises (SHACL requires at least one, and that no premise equals the conclusion)."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN (a premise may be a claim, a proposition, or any reified statement), mirroring gmeow:inferredFrom."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:premiseUsed
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PremiseUse ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "premise used"@x-gmeow-english ;
    skos:definition "The premise a gmeow:PremiseUse bases on — the single premise this use actually rests on (the basing fact). Functional: one premise-use names one used premise."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN: a premise may be a gmeow:StandpointClaim, a gmeow:Proposition, an observation, or any reified statement. Mirrors gmeow:premise / gmeow:inferredFrom."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:supportSource
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Support ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "support source"@x-gmeow-english ;
    rdfs:range gmeow:SupportSource ;
    skos:definition "The supporting structure of a gmeow:Support — a gmeow:SupportSource (another gmeow:Argument or a gmeow:StandpointClaim that lends support). NOT functional: support accrues from several sources."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:supportTarget
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Support ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "support target"@x-gmeow-english ;
    rdfs:range gmeow:Argument ;
    skos:definition "The gmeow:Argument a gmeow:Support supports. Functional: one Support instance supports one argument; independent supports for the same argument are separate Support instances, so support accrues (Principle 9)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:systematicity
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Analogy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "systematicity"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "A solver-computed measure of a gmeow:Analogy's structural consistency (Gentner's systematicity principle: deep, interconnected relational mappings beat shallow attribute matches) — the basis on which the best analogy is selected. A solver-layer value (Principle 12); best-analogy selection promotes the winner's modality and suppresses rival mappings, never an asserted isBest bit. NOT functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:tenureOf
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InferenceTenure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "tenure of"@x-gmeow-english ;
    rdfs:range gmeow:InferenceCommitment ;
    skos:definition "Relates a gmeow:InferenceTenure to the gmeow:InferenceCommitment whose conclusion it time-scopes — opened when the conclusion is accepted, closed (an gmeow:endedAtTime on its gmeow:duringInterval) when a defeater fires. Functional: one tenure tracks one commitment; the commitment survives the closing as audit (the gmeow:StandpointTenure → gmeow:standpointClaim idiom, applied to inference)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:underSemantics
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ArgumentEvaluation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "under semantics"@x-gmeow-english ;
    rdfs:range logic:ArgumentationSemantics ;
    skos:definition "The named acceptability semantics under which a gmeow:ArgumentEvaluation is computed — logic:GroundedArgumentation, logic:PreferredArgumentation, logic:NoArgumentation, or logic:PolicySpecificArgumentation. Functional: one evaluation, one semantics. Coupling to logic: is by reference (no asserted triples into logic:)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:warrant
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InferenceCommitment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "warrant"@x-gmeow-english ;
    skos:definition "The warrant of a reified gmeow:InferenceCommitment — the Toulmin licence authorising the step from premises to conclusion. For a deductive commitment it points at the logic: rule or proof-trace; for an inductive one, the statistical licence; for an abductive one, the explanatory licence; for an analogical one, the gmeow:Analogy (structure-mapping). NOT functional."@x-gmeow-english ;
    skos:scopeNote "Range is intentionally OPEN: the warrant may be a logic: derivation, an gmeow:Analogy, an evidence object, or a textual rule. The substrate coupling to logic: is by reference (no asserted triples into logic:)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

<https://blackcatinformatics.ca/gmeow/slices/inference>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Inference as the EPISTEMIC FACE of a logic: derivation — what an agent believes when it accepts a reasoning step's conclusion. The conclusion of every inference is an ordinary gmeow:StandpointClaim (vantage = the reasoner, observedFeature = the concluded proposition, gmeow:claimModality = the mode's default).

DOCTRINE.
  * Modes differ by a VALUE + a WARRANT, never by subsumption (the deception discipline — divergence is a gmeow:InferenceMode value, not a subclass). The four Peircean modes (gmeow:modeDeduction / modeInduction / modeAbduction / modeAnalogical) ride one class, never a taxonomy.
  * No re-minted truth bit (Principle 6): strength rides the EXISTING logic: axes (logic:weight / logic:confidence / logic:evidenceStrength / logic:probability — BY REFERENCE, no asserted triples into logic:); modality reuses the EXISTING standpoint modality, now the six factored axes (gmeow:Polarity / ModalForce / CredenceLevel / AssertoricForce / TruthDirectedness / SupportStatus), of which the legacy five-value gmeow:StandpointModality (gmeow:unequivocal / probable / conceivable / refuted / bullshit) is the lossless projection a mode's default reads as.
  * ENDURANT / OCCURRENT SPLIT (gUFO's master split — the reason this slice does NOT mint a single double-typed gmeow:Inference). Two classes:
      - gmeow:InferenceProcess rdfs:subClassOf gmeow:MentalProcess — the OCCURRENT reasoning episode (perdurant); the reparenting hook the mentation slice reserves. Carries gmeow:experiencer and gmeow:mentalProcessType gmeow:processReasoning; gmeow:producesMentalMoment the belief it creates.
      - gmeow:InferenceCommitment rdfs:subClassOf gufo:Relator — the ENDURANT structured argument relation (premises x conclusion x warrant); the gmeow:Commitment idiom.
      - gmeow:hasInferenceCommitment bridges process to commitment.
  * Three tiers of fidelity (flat-first, reify on demand — Principle 4): (1) FLAT spine on the claim — gmeow:inferredFrom + gmeow:inferenceMode, the 80% case; (2) the REIFIED gmeow:InferenceCommitment relator when the argument structure matters; (3) the OCCURRENT gmeow:InferenceProcess when the reasoning episode joins the agent's mental timeline.
  * ARGUMENTATION LAYER (Dung / ASPIC+, design/LOGIC-FOUNDATION.md — Argumentation and epistemic standards): a gmeow:Argument is the attackable framework node wrapping a gmeow:InferenceCommitment (gmeow:argumentInferenceStep); it rests on gmeow:PremiseUse leaves (the USED premises, basing — available != used) and a gmeow:InferenceApplication (rule + substitution), and bears TYPED conflict — a gmeow:Attack names WHAT it attacks (gmeow:attackTarget: a gmeow:PremiseUse / gmeow:InferenceApplication / conclusion gmeow:StandpointClaim) and HOW (gmeow:attackKind: gmeow:attackUndermine / attackUndercut / attackRebut). Support ACCRUES (each gmeow:Support is its own instance; independent supports combine, never counted once). Which arguments survive is the solver-layer gmeow:ArgumentEvaluation under a named logic:ArgumentationSemantics (gmeow:underSemantics), labelling each gmeow:acceptanceIn / acceptanceOut / acceptanceUndecided — COMPUTED, never an asserted accepted bit (Principle 12). Self-attack and self-support are forbidden in SHACL, not OWL (clean DL profile).
  * BELIEF UPTAKE (seam to epistemics): a deductively-closed belief is gmeow:believes with modality gmeow:unequivocal; an inductive / abductive / analogical belief arrives as gmeow:believes + attributed modality + confidence (the gmeow:deceptiveIntentClaim idiom: attributed, defeasible, vantage = the assessor).
  * BELIEF REVISION = SUPPRESSION (Principle 10): a solver-fired gmeow:Attack sets the conclusion-claim gmeow:displayable false and closes an gmeow:InferenceTenure; the gmeow:InferenceCommitment is retained as audit, never erased.
  * COMPUTE OUTSIDE THE LOGIC (Principle 12): gmeow:explanatoryScore (IBE) and gmeow:systematicity (Gentner) are solver-layer decimals; there is no isBest bit — the winner is promoted conceivable->probable, an axis transition (gmeow:polaritySuspend->gmeow:polarityAffirm, gmeow:modalForcePossible->gmeow:modalForceActual, gmeow:credencePossible->gmeow:credenceLikely) whose legacy projection is conceivable->probable, and the losers are suppressed.
  * eventTypeInference DROPPED (Principle 4): gmeow:InferenceProcess carrying gmeow:mentalProcessType gmeow:processReasoning is the single canonical occurrent marker; a parallel gmeow:EventType value would be a second canonical source for the same fact.

ALIGNMENT (by reference — see mappings/equivalences.ttl). PROV-O (InferenceProcess ~ prov:Activity, inferredFrom ~ prov:wasDerivedFrom); CRMinf (InferenceCommitment ~ I1_Argumentation / I5_Inference_Making, StandpointModality ~ I6_Belief_Value); analogy ~ Gentner structure-mapping engine; AIF / ASPIC+ / Dung abstract argumentation (Argument / Attack / Support / ArgumentEvaluation); Toulmin / Peirce / Pollock (typed attacks) in prose."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "GMEOW Inference Module"@x-gmeow-english ;
    skos:definition "The GMEOW Inference Module — Peirce's tetrad (deduction, induction, abduction, analogy) as the epistemic face of a logic: derivation: what an agent believes when it accepts a reasoning step's conclusion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Declarative constraint axioms (core slices) — the closed-world
# cardinality / class / datatype obligations the hand-authored shapes.ttl
# NodeShapes state, authored here once as OWL restriction axioms and PROJECTED
# to generated/shapes/validation-shapes.ttl by derive_validation_shapes
# (Principle 17). A restriction carrying both owl:*Cardinality and
# owl:allValuesFrom lowers to the paired sh:minCount/maxCount + sh:class /
# sh:datatype property shape. The cross-node / disjunctive-range / value-keyed
# (sh:sparql, sh:or, SPARQLTarget) conditions have no OWL antecedent and remain
# the procedural fragment .
# =========================================================================== #

gmeow:InferenceCommitment rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:conclusion ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:StandpointClaim ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:premise ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:inferenceModeOf ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:Analogy rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:analogicalSource ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:analogicalTarget ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:hasCorrespondence ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:Correspondence rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:correspondingSource ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:correspondingTarget ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:Argument rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:argumentConclusion ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:argumentInferenceStep ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:hasPremiseUse ; owl:allValuesFrom gmeow:PremiseUse ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:hasInferenceApplication ; owl:allValuesFrom gmeow:InferenceApplication ] .

# gmeow:attackTarget / gmeow:supportSource carry an sh:or disjunctive range
# (PremiseUse|InferenceApplication|StandpointClaim resp. Argument|StandpointClaim)
# that OWL allValuesFrom cannot state without a union filler the derive does not
# classify; only the exact-one cardinality lowers here, the disjoint-range check
# stays procedural .
gmeow:Attack rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:attackTarget ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:attackKind ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:AttackKind ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:attackSource ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:Argument ] .

gmeow:Support rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:supportTarget ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:Argument ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:supportSource ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:ArgumentEvaluation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:evaluatesArgument ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:Argument ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:underSemantics ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:acceptanceStatus ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:AcceptanceStatus ] .

gmeow:PremiseUse rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:premiseUsed ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:InferenceApplication rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:appliedRule ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:appliedSubstitution ; owl:allValuesFrom xsd:string ] .

# exact-one minCount restoration (issue #1194): min-qualified sibling restrictions
# restoring sh:minCount for the reasoner-safe max-qualified exact-one antecedents.
