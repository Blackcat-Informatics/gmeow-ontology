@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/citations>
    a gmeow:Slice ;
    rdfs:label "citations"@x-gmeow-english ;
    skos:definition "The citations slice of the GMEOW ontology (core tier): GMEOW Citations Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/citations> ;
    dcterms:title "GMEOW Citations Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceProfile "claims" , "memory" ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/documents> ,
        <https://blackcatinformatics.ca/gmeow/slices/evidence> ;
    gmeow:sliceConsumer "The citation/credit dogfood (#211): CITATION.cff projection, slice manifests, scholarly credit."@x-gmeow-english .
