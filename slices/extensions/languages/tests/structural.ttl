# SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
# SPDX-License-Identifier: CC-BY-4.0
#
# Declarative structural assertions for the languages extension slice — the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# of the language vocabulary. Each assertion runs as a SPARQL ASK over the
# languages module graph (gmeow:scopeModule) under the native Rust harness
# (crates/slicetest).
#
# Languages is migrated: class stereotypes are logic:
# (logic:AbstractIndividualType, logic:Kind, logic:SubKind, logic:Event,
# logic:QualityValue), not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_registry_independence_no_required_code — gmeow:languageCode is
#     defined in slices/core/language/module.ttl (cross-slice), and the test
#     also performs a dynamic cardinality-restriction sweep over the graph.
#   test_transliteration_scheme_retrofits_names — gmeow:transliterationScheme
#     is defined in slices/core/language/module.ttl (cross-slice).
#   test_software_bridge_and_version_lineage — gmeow:writtenInLanguage is in
#     slices/core/language/module.ttl and gmeow:versionOf is in
#     slices/core/coreference/module.ttl (both cross-slice).
#   test_reference_catalog_languages_are_annotated_and_aligned — uses
#     include_imports=True; dynamic sweep of ISO 639-1 codes with numeric
#     count assertions against the reference catalog.
#   test_reference_catalog_glottolog_alignments — include_imports=True; dynamic
#     check on catalog-only language subjects.
#
# SUPERSEDED by the lang: graft (Principle 6/19): the pre-graft spine —
# gmeow:FormalLanguage / gmeow:ProgrammingLanguage / gmeow:WritingSystem, the
# gmeow:WritingSystemUsage relator and its scriptRole/scriptCode/textDirection/
# writingSystemType value vocabularies, the internal gmeow:languageTag, and the
# core seed languages — is retired. Scripts are lang:Script, orthographies are
# lang:Orthography, and the natural/formal/programming distinction is carried by
# lang:signSystemKind (lang:formalLanguageKind / lang:programmingLanguageKind).
# The pytest twins that asserted the retired spine are migrated with the graft.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/languages/tests/> .

# ---------------------------------------------------------------------------
# GROUP 2: LanguageProficiency reified relator and its functional roles (MUST)
# Mirrors test_reified_relators_and_functional_roles (LanguageProficiency arm).
# ---------------------------------------------------------------------------

# --- 5. LanguageProficiency is a logic:Kind and subclass of logic:Relator (MUST)
ex:saLanguageProficiencyIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageProficiency a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:LanguageProficiency MUST be an owl:Class typed logic:Kind and a subclass of logic:Relator — it is the reified binding of {agent} × {language} × {skill modality} × {level on scale}." .

# --- 6. proficiencyAgent is an ObjectProperty (MUST)
ex:saProficiencyAgentFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:proficiencyAgent a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:proficiencyAgent MUST be an owl:ObjectProperty — constitutive of LanguageProficiency (the assessed agent)." .

# --- 7. proficiencyLanguage is an ObjectProperty (MUST)
ex:saProficiencyLanguageFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:proficiencyLanguage a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:proficiencyLanguage MUST be an owl:ObjectProperty — constitutive of LanguageProficiency (the language of the proficiency)." .

# --- 8. proficiencyModality is an ObjectProperty (MUST)
ex:saProficiencyModalityFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:proficiencyModality a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:proficiencyModality MUST be an owl:ObjectProperty — mint one proficiency per (agent, language, modality) so per-skill levels coexist." .

# --- 9. proficiencyLevel is an ObjectProperty (MUST)
ex:saProficiencyLevelFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:proficiencyLevel a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:proficiencyLevel MUST be an owl:ObjectProperty — the level of the proficiency relator." .

# --- 10. proficiencyScale is an ObjectProperty (MUST)
ex:saProficiencyScaleFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:proficiencyScale a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:proficiencyScale MUST be an owl:ObjectProperty — the framework of the proficiency relator." .

# ---------------------------------------------------------------------------
# GROUP 3: Value vocabularies — logic:QualityValue subclasses (MUST)
# Mirrors test_value_vocabularies_not_subclasses (non-logic: arms).
# ---------------------------------------------------------------------------

# --- 11. LanguageOrigin is a logic:AbstractIndividualType subclassing logic:QualityValue (MUST)
ex:saLanguageOriginIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageOrigin a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:LanguageOrigin MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue — origins are an open individuals-based value vocabulary, never Language subclasses (Principle 9)." .

# --- 12. LanguageOrigin seed individuals exist (MUST)
ex:saLanguageOriginSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:originNatural        a gmeow:LanguageOrigin .
    gmeow:originAiGenerated    a gmeow:LanguageOrigin .
    gmeow:originProgramming    a gmeow:LanguageOrigin .
}""" ;
    gmeow:saRationale "Sample LanguageOrigin individuals (originNatural, originAiGenerated, originProgramming) MUST exist as typed individuals." .

# --- 12b. LanguageVarietyKind and LanguageChangeType are logic:QualityValue vocabs (MUST)
ex:saVarietyAndChangeKindsAreValueVocabs a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageVarietyKind rdfs:subClassOf logic:QualityValue .
    gmeow:kindDialect  a gmeow:LanguageVarietyKind .
    gmeow:kindSociolect a gmeow:LanguageVarietyKind .
    gmeow:kindRegister a gmeow:LanguageVarietyKind .

    gmeow:LanguageChangeType rdfs:subClassOf logic:QualityValue .
    gmeow:changeSoundShift a gmeow:LanguageChangeType .
    gmeow:changeBorrowing  a gmeow:LanguageChangeType .
    gmeow:changeExtinction a gmeow:LanguageChangeType .
}""" ;
    gmeow:saRationale "LanguageVarietyKind and LanguageChangeType MUST be logic:QualityValue vocabularies with their canonical seed individuals. Replaces stale gufo:QualityValue assertions." .

ex:saLanguageStateIsObservationRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageState a owl:Class ;
        rdfs:subClassOf gmeow:Observation , logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:LanguageState MUST be an Observation and logic:Relator for standpoint-scoped language-state claims. Replaces the stale gufo:Relator assertion." .

# --- 13. LanguageModality is a logic:AbstractIndividualType subclassing logic:QualityValue (MUST)
ex:saLanguageModalityIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageModality a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:LanguageModality MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue — modalities are an open individuals-based value vocabulary." .

# --- 14. LanguageModality seed individuals exist (MUST)
ex:saLanguageModalitySeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:modalitySpoken  a gmeow:LanguageModality .
    gmeow:modalitySigned  a gmeow:LanguageModality .
    gmeow:modalityMachine a gmeow:LanguageModality .
}""" ;
    gmeow:saRationale "Sample LanguageModality individuals (modalitySpoken, modalitySigned, modalityMachine) MUST exist as typed individuals." .

# --- 15. LanguageStatus is a logic:AbstractIndividualType subclassing logic:QualityValue (MUST)
ex:saLanguageStatusIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageStatus a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:LanguageStatus MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue — vitality statuses are an open individuals-based value vocabulary." .

# --- 16. LanguageStatus seed individuals exist (MUST)
ex:saLanguageStatusSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:statusLiving            a gmeow:LanguageStatus .
    gmeow:statusConstructedActive a gmeow:LanguageStatus .
}""" ;
    gmeow:saRationale "Sample LanguageStatus individuals (statusLiving, statusConstructedActive) MUST exist as typed individuals." .

# ---------------------------------------------------------------------------
# GROUP 4: Value vocab individuals — logic:-typed classes (subjects local; class cross-slice)
# ProficiencyModality, ProficiencyScale, ProficiencyLevel are defined in
# slices/core/kernel/module.ttl; TransliterationScheme in slices/core/language/module.ttl.
# Their class-shape assertions cannot be scopeModule cells here. However the
# individuals (profModalitySpeaking, scaleCEFR, cefrB2, schemeHepburn, …) are
# all defined in THIS module, so their typed-individual existence is migratable.
# Mirrors test_value_vocabularies_not_subclasses (logic: and TransliterationScheme arms).
# ---------------------------------------------------------------------------

# --- 23. ProficiencyModality seed individuals exist (MUST)
ex:saProficiencyModalitySeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:profModalitySpeaking a gmeow:ProficiencyModality .
    gmeow:profModalityOverall  a gmeow:ProficiencyModality .
}""" ;
    gmeow:saRationale "Sample ProficiencyModality individuals (profModalitySpeaking, profModalityOverall) MUST exist as locally-defined typed individuals — the class is defined in slices/core/kernel/module.ttl but its seed individuals are defined here." .

# --- 24. ProficiencyScale seed individuals exist (MUST)
ex:saProficiencyScaleSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:scaleCEFR  a gmeow:ProficiencyScale .
    gmeow:scaleILR   a gmeow:ProficiencyScale .
    gmeow:scaleACTFL a gmeow:ProficiencyScale .
}""" ;
    gmeow:saRationale "Sample ProficiencyScale individuals (scaleCEFR, scaleILR, scaleACTFL) MUST exist as locally-defined typed individuals — the class is defined in slices/core/kernel/module.ttl but its seed individuals are defined here." .

# --- 25. ProficiencyLevel seed individuals exist (MUST)
ex:saProficiencyLevelSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:cefrB2        a gmeow:ProficiencyLevel .
    gmeow:levelNative   a gmeow:ProficiencyLevel .
    gmeow:levelHeritage a gmeow:ProficiencyLevel .
}""" ;
    gmeow:saRationale "Sample ProficiencyLevel individuals (cefrB2, levelNative, levelHeritage) MUST exist as locally-defined typed individuals — the class is defined in slices/core/kernel/module.ttl but its seed individuals are defined here." .

# --- 26. TransliterationScheme seed individuals exist (MUST)
ex:saTransliterationSchemeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:schemeHepburn a gmeow:TransliterationScheme .
    gmeow:schemePinyin  a gmeow:TransliterationScheme .
    gmeow:schemeIPA     a gmeow:TransliterationScheme .
}""" ;
    gmeow:saRationale "Sample TransliterationScheme individuals (schemeHepburn, schemePinyin, schemeIPA) MUST exist as locally-defined typed individuals — the class is defined in slices/core/language/module.ttl but its seed individuals are defined here." .

# ---------------------------------------------------------------------------
# GROUP 5: CEFR level carries its scale (MUST)
# Mirrors test_cefr_levels_carry_their_scale.
# ---------------------------------------------------------------------------

# --- 27. cefrB2 carries levelScale scaleCEFR (MUST)
ex:saCefrB2CarriesScale a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:cefrB2 gmeow:levelScale gmeow:scaleCEFR .
}""" ;
    gmeow:saRationale "gmeow:cefrB2 MUST carry gmeow:levelScale gmeow:scaleCEFR — every proficiency-level individual declares which scale it belongs to via the functional levelScale property." .

# ---------------------------------------------------------------------------
# GROUP 7: knowsLanguage shortcut and nativeLanguage sub-property (MUST/MUST-NOT)
# Mirrors test_knows_language_shortcut_and_native_subproperty.
# ---------------------------------------------------------------------------

# --- 30. knowsLanguage is a non-functional ObjectProperty (MUST)
ex:saKnowsLanguageIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:knowsLanguage a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:knowsLanguage MUST be an owl:ObjectProperty — the shortcut relation from agent to language." .

# --- 31. knowsLanguage is NOT functional (MUST-NOT)
ex:saKnowsLanguageNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    ?rec logic:characterizes gmeow:knowsLanguage ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "gmeow:knowsLanguage MUST NOT be functional — a person knows multiple languages." .

# --- 32. nativeLanguage is a subPropertyOf knowsLanguage (MUST)
ex:saNativeLanguageSubPropertyOf a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:nativeLanguage rdfs:subPropertyOf gmeow:knowsLanguage .
}""" ;
    gmeow:saRationale "gmeow:nativeLanguage MUST be rdfs:subPropertyOf gmeow:knowsLanguage — native language is a specialisation of the general language-knowledge shortcut." .

# --- 33. LanguageVersion is a subclass of Language (MUST)
ex:saLanguageVersionSubclassLanguage a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageVersion rdfs:subClassOf gmeow:Language .
}""" ;
    gmeow:saRationale "gmeow:LanguageVersion MUST be rdfs:subClassOf gmeow:Language — a dated language revision is itself a fully usable language bearing its own scripts, names and status. This is the languages-extension arm of the language hierarchy spine (the core arm — gmeow:Language as a lang:SignSystem specialization — is pinned in slices/core/language, with the natural/formal/programming distinction carried by lang:signSystemKind rather than a subclass ladder)." .

# --- 34. LanguageVersion carries logic:SubKind discipline (MUST)
ex:saLanguageVersionIsSubKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageVersion a logic:SubKind ;
        rdfs:subClassOf gmeow:Language .
}""" ;
    gmeow:saRationale "gmeow:LanguageVersion MUST carry the logic:SubKind stereotype in addition to being a subclass of gmeow:Language. A dated language revision is a fully-usable language in its own right — Ithkuil 1993 and New Ithkuil are distinct languages that share lineage, not mere sub-varieties — and must participate in the gUFO Kind/SubKind identity discipline that every Language refinement is required to bear. This cell is the extensions-side arm of that discipline guard; the core-side arm (which enforces no bare Language subclass may lack logic:SubKind) is pinned in slices/core/language." .

# ---------------------------------------------------------------------------
# GROUP 8: LanguageVariety hierarchy and non-functional classification roles
# Migrated from tests/test_language_varieties.py.
# ---------------------------------------------------------------------------

# --- 35. LanguageVariety is a subclass of Language (MUST)
ex:saLanguageVarietySubclassLanguage a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageVariety a owl:Class ;
        rdfs:subClassOf gmeow:Language .
}""" ;
    gmeow:saRationale "gmeow:LanguageVariety MUST be an owl:Class and rdfs:subClassOf gmeow:Language — a variety is itself a language, so it carries names, scripts, tags, status, provenance and alignment metadata exactly as gmeow:Language does." .

# --- 36. varietyKind is an ObjectProperty but NOT functional (MUST / MUST-NOT)
ex:saVarietyKindIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:varietyKind a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:varietyKind MUST be an owl:ObjectProperty — it carries standpoint-scoped variety-kind values (dialect, sociolect, register, …)." .

ex:saVarietyKindNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:varietyKind ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:varietyKind MUST NOT be functional — a single variety can be classified as both a language and a dialect by different standpoints (Principle 9)." .

# --- 37. varietyOf is an ObjectProperty but NOT functional (MUST / MUST-NOT)
ex:saVarietyOfIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:varietyOf a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:varietyOf MUST be an owl:ObjectProperty — it links a variety to the language it is a variety of." .

ex:saVarietyOfNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:varietyOf ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:varietyOf MUST NOT be functional — a variety may be held to be of more than one parent language across standpoints (e.g., Scots of English vs Scots of West Germanic)." .

# ---------------------------------------------------------------------------
# GROUP 9: LanguageState relator pattern — one functional role, three non-functional
# Migrated from tests/test_language_varieties.py.
# ---------------------------------------------------------------------------

# --- 38. stateLanguage is an ObjectProperty (MUST)
ex:saStateLanguageFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:stateLanguage a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:stateLanguage MUST be an owl:ObjectProperty — a LanguageState is a standpoint-scoped relator about the language / variety / version it concerns." .

# --- 39. stateStatusValue, stateAuthority, stateInterval are ObjectProperties (MUST)
ex:saStateNonFunctionalRolesAreObjectProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:stateStatusValue a owl:ObjectProperty .
    gmeow:stateAuthority    a owl:ObjectProperty .
    gmeow:stateInterval     a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:stateStatusValue, gmeow:stateAuthority and gmeow:stateInterval MUST each be an owl:ObjectProperty — the status, authority and interval of a LanguageState are object-typed roles of the relator." .

# --- 40. stateStatusValue, stateAuthority, stateInterval are NOT functional (MUST-NOT)
ex:saStateNonFunctionalRolesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    VALUES ?p { gmeow:stateStatusValue gmeow:stateAuthority gmeow:stateInterval }
    ?rec logic:characterizes ?p ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "gmeow:stateStatusValue, gmeow:stateAuthority and gmeow:stateInterval MUST NOT be functional — a language state can co-carry multiple status values, authorities and overlapping intervals under different standpoints (Principle 9)." .

# ---------------------------------------------------------------------------
# GROUP 10: LanguageChangeEvent event pattern
# Migrated from tests/test_language_varieties.py.
# ---------------------------------------------------------------------------

# --- 41. LanguageChangeEvent is an Activity subclass (MUST)
ex:saLanguageChangeEventIsActivity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageChangeEvent a owl:Class ;
        rdfs:subClassOf gmeow:Activity .
}""" ;
    gmeow:saRationale "gmeow:LanguageChangeEvent MUST be an owl:Class and rdfs:subClassOf gmeow:Activity — historical linguistic changes (sound shifts, borrowing, extinction, …) are events in the universal Activity spine." .
