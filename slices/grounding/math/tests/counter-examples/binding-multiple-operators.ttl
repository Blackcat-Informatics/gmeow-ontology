#
# Counter-example for the `math:` expression lowering
# (crates/logic/src/physical/lower.rs, MathLoweringError::BindingMultipleOperators): a
# math:BindingExpression root naming TWO math:operator values (math:summationBinder and
# math:limitBinder) — ambiguous which binder form the node invokes. The authored
# math:structuralKey lets the reasoned-graph gate
# (check_structural_key_on_rejected_expression) also reach it.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:root a math:BindingExpression ;
    math:operator math:summationBinder , math:limitBinder ;
    math:boundVariable ex:xDecl ;
    math:argumentSlot ex:slot0 ;
    math:structuralKey "not-a-real-digest" .

ex:xDecl a math:VariableDeclaration .

ex:slot0 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression ex:body .

ex:body a math:NumberLiteral ;
    math:literalValue 1 .
