@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

# =========================================================================== #
# Mathematics slice SHACL shapes — the bedrock hard-rule gates
#
# Each shape enforces one numbers-and-sets hard rule and names, through
# gmeow:enforcesFailureClass, the typed math:MathConformanceFailure it raises. The
# machine-checkable failure identity is the SHACL constraint-component code, pinned
# per counter-example in tests/example-conformance.ttl.
# =========================================================================== #

# Rule 1 — a number declares its number system.
math:NumberSituatedShape
    a sh:NodeShape ;
    rdfs:label "Number situatedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:Number: every number situates itself in exactly one math:NumberSystem through math:inNumberSystem. An unsituated number is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnsituatedNumber ;
    sh:targetClass math:Number ;
    sh:property [
        sh:path math:inNumberSystem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:NumberSystem ;
        sh:severity sh:Violation ;
        sh:message "A math:Number must declare exactly one math:inNumberSystem naming the math:NumberSystem (ℕ, ℤ, ℚ, ℝ, or ℂ) it belongs to; an unsituated number is ill-formed." ;
    ] .

# Rule 2 — an approximation names what it approximates and its error.
math:ApproximateValueShape
    a sh:NodeShape ;
    rdfs:label "Approximate value shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:ApproximateValue: it names, through math:approximates, the exact math:Number it stands in for, and declares its math:approximationError. An exact number and an approximation of it are distinct objects."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ExactApproximateConflation ;
    sh:targetClass math:ApproximateValue ;
    sh:property [
        sh:path math:approximates ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Number ;
        sh:severity sh:Violation ;
        sh:message "A math:ApproximateValue must name, through math:approximates, exactly one exact math:Number it stands in for; conflating an approximation with the exact value is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:approximationError ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ApproximateValue must declare its math:approximationError — how far it may deviate from the exact value." ;
    ] .

# Rule 3 — a named constant is an exact individual, not a decimal literal.
math:MathematicalConstantShape
    a sh:NodeShape ;
    rdfs:label "Mathematical constant shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:MathematicalConstant: it is exact (math:isExact true) and never carries a raw numeric literal directly (math:quantityValue is forbidden on it). A constant's decimal expansion belongs to a distinct math:ApproximateValue that math:approximates it."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ConstantAsDecimalLiteral ;
    sh:targetClass math:MathematicalConstant ;
    sh:property [
        sh:path math:isExact ;
        sh:minCount 1 ;
        sh:hasValue true ;
        sh:severity sh:Violation ;
        sh:message "A math:MathematicalConstant must declare math:isExact true — a named constant is an exact value." ;
    ] ;
    sh:property [
        sh:path math:quantityValue ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A math:MathematicalConstant must not carry a raw math:quantityValue — it is not a decimal literal; its decimal expansion belongs to a distinct math:ApproximateValue that math:approximates it." ;
    ] .

# Rule 4 — an intensional set's condition denotes a logic: formula, not a string.
math:IntensionalSetShape
    a sh:NodeShape ;
    rdfs:label "Intensional set condition shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:SetBuilderExpression: its math:memberCondition denotes a logic: formula (a resource, the denotation seam), never an opaque literal string."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:StringOnlyMemberCondition ;
    sh:targetClass math:SetBuilderExpression ;
    sh:property [
        sh:path math:memberCondition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:severity sh:Violation ;
        sh:message "A math:SetBuilderExpression must name exactly one math:memberCondition as a resource denoting a logic: formula (a single defining condition, which may itself be a compound formula), not an opaque literal string." ;
    ] .

# Rule 5 — a complement names its ambient space AND its complement-semantics.
math:ComplementShape
    a sh:NodeShape ;
    rdfs:label "Complement ambient-space and semantics shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:Complement: it names the ambient space it is taken relative to through math:ambientSpace and which notion of complement it uses through math:complementSemantics (set-theoretic, orthogonal, complex-linear, topological, or quotient). A complement missing either is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnqualifiedComplement ;
    sh:targetClass math:Complement ;
    sh:property [
        sh:path math:ambientSpace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Complement must name its ambient space through math:ambientSpace; an unqualified complement is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:complementSemantics ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:ComplementSemantics ;
        sh:severity sh:Violation ;
        sh:message "A math:Complement must name its complement-semantics through math:complementSemantics (one of set-theoretic, orthogonal, complex-linear, topological, quotient); an unqualified complement is ill-formed." ;
    ] .

# Rule 6 — a set is extensional or intensional, not silently both.
math:SetExtentShape
    a sh:NodeShape ;
    rdfs:label "Set extent shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint over math:Set: a set is given extensionally (math:hasElement) or intensionally (math:memberCondition), not silently both without a declared equality."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:AmbiguousSetExtent ;
    sh:targetClass math:Set ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:Set must be extensional or intensional, not both: a node carrying both math:hasElement and math:memberCondition without a declared equality has an ambiguous extent." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/math/hasElement> ?element .
                $this <https://blackcatinformatics.ca/math/memberCondition> ?condition .
            }
        """ ;
    ] .

# Rule 7 — a function declares its domain and codomain.
math:FunctionFramingShape
    a sh:NodeShape ;
    rdfs:label "Function framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Function: it declares both its math:domain and its math:codomain. A function without its frame is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnframedFunction ;
    sh:targetClass math:Function ;
    sh:property [
        sh:path math:domain ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Set ;
        sh:severity sh:Violation ;
        sh:message "A math:Function must declare exactly one math:domain naming the source set; a function without a domain, or with several, is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:codomain ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Set ;
        sh:severity sh:Violation ;
        sh:message "A math:Function must declare exactly one math:codomain naming the target set; a function without a codomain, or with several, is ill-formed." ;
    ] .

# =========================================================================== #
# Algebra slice SHACL shapes — the algebra hard-rule gates (ALGEBRA charter)
#
# A structure declares its operation, carrier, and axioms; a homomorphism declares
# its preserved operation and preservation law (a logic: formula, not a string); a
# root system declares its Cartan matrix, Weyl group, and rank; a homomorphic-
# encryption scheme declares its homomorphic operation, hardness assumption, and
# noise model. Each shape names, through gmeow:enforcesFailureClass, the typed
# math:MathConformanceFailure it raises.
# =========================================================================== #

# Rule 8 — an algebraic structure declares its carrier, operation, and axioms.
math:AlgebraicStructureShape
    a sh:NodeShape ;
    rdfs:label "Algebraic structure completeness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:AlgebraicStructure: it declares a math:underlyingSet, at least one math:structureOperation, and at least one math:satisfiesAxiom law. A group is a set with an operation satisfying stated axioms; a structure asserted without them is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IncompleteAlgebraicStructure ;
    sh:targetClass math:AlgebraicStructure ;
    sh:property [
        sh:path math:underlyingSet ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Set ;
        sh:severity sh:Violation ;
        sh:message "A math:AlgebraicStructure must declare exactly one math:underlyingSet naming its carrier; a structure without a carrier is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:structureOperation ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Operation ;
        sh:severity sh:Violation ;
        sh:message "A math:AlgebraicStructure must declare at least one math:structureOperation; a structure without an operation is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:satisfiesAxiom ;
        sh:minCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:severity sh:Violation ;
        sh:message "A math:AlgebraicStructure must declare at least one math:satisfiesAxiom naming a math:Axiom (which denotes a logic: formula); a structure without stated axioms is ill-formed." ;
    ] .

# Rule 9 — a homomorphism declares its preserved operation and preservation law.
math:HomomorphismShape
    a sh:NodeShape ;
    rdfs:label "Homomorphism completeness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Homomorphism: it declares at least one math:preservedOperation and at least one math:preservationLaw. A map is a homomorphism only by declaring what it preserves and the law of that preservation."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedHomomorphism ;
    sh:targetClass math:Homomorphism ;
    sh:property [
        sh:path math:preservedOperation ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Operation ;
        sh:severity sh:Violation ;
        sh:message "A math:Homomorphism must declare at least one math:preservedOperation naming the operation it carries; a homomorphism without a preserved operation is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:preservationLaw ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:Homomorphism must declare at least one math:preservationLaw; a homomorphism without its law is ill-formed." ;
    ] .

# Rule 10 — a preservation law denotes a logic: formula, not a string.
math:PreservationLawShape
    a sh:NodeShape ;
    rdfs:label "Preservation-law denotation shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:Homomorphism: its math:preservationLaw denotes a logic: formula (a resource, the denotation seam), never an opaque literal string."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:StringOnlyPreservationLaw ;
    sh:targetClass math:Homomorphism ;
    sh:property [
        sh:path math:preservationLaw ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Homomorphism must name its math:preservationLaw as a resource denoting a logic: formula, not an opaque literal string." ;
    ] .

# Rule 11 — a Lie group declares its root system.
math:LieStructureShape
    a sh:NodeShape ;
    rdfs:label "Lie structure shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:LieGroup: it declares its math:hasRootSystem. The root system is what makes a semisimple Lie group expressible; a Lie group without one is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IncompleteLieStructure ;
    sh:targetClass math:LieGroup ;
    sh:property [
        sh:path math:hasRootSystem ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:RootSystem ;
        sh:severity sh:Violation ;
        sh:message "A math:LieGroup must declare at least one math:hasRootSystem; a semisimple Lie group without a root system is ill-formed." ;
    ] .

# Rule 12 — a root system declares its Cartan matrix, Weyl group, and rank.
math:RootSystemShape
    a sh:NodeShape ;
    rdfs:label "Root system completeness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:RootSystem: it declares its math:cartanMatrix, math:weylGroup, and math:rootSystemRank. These are what make E8's symmetry an automorphism group; a root system without them is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IncompleteLieStructure ;
    sh:targetClass math:RootSystem ;
    sh:property [
        sh:path math:cartanMatrix ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:CartanMatrix ;
        sh:severity sh:Violation ;
        sh:message "A math:RootSystem must declare its math:cartanMatrix; a root system without one is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:weylGroup ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:WeylGroup ;
        sh:severity sh:Violation ;
        sh:message "A math:RootSystem must declare its math:weylGroup — the symmetry group of the roots; a root system without one is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:rootSystemRank ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:RootSystem must declare its math:rootSystemRank; a root system without a rank is ill-formed." ;
    ] .

# Rule 12b — an automorphism group is anchored to the structure it is the symmetry of.
math:AutomorphismGroupShape
    a sh:NodeShape ;
    rdfs:label "Automorphism-group anchoring shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:AutomorphismGroup: it declares, through math:automorphismGroupOf, the structure whose symmetries it collects. Every automorphism group is the symmetry group OF some structure (a math:WeylGroup of its root system); a free-floating automorphism group is ill-formed. This is the invariant behind the charter's unification — E8's Weyl group is the symmetry of the E8 root system."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnanchoredAutomorphismGroup ;
    sh:targetClass math:AutomorphismGroup ;
    sh:property [
        sh:path math:automorphismGroupOf ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:AutomorphismGroup must declare, through math:automorphismGroupOf, the structure whose symmetries it collects; an automorphism group is always the symmetry group OF something, and one asserted without its anchoring structure is ill-formed." ;
    ] .

# Rule 12c — a root system claiming the E8 fingerprint declares the true Weyl order.
math:E8WeylOrderShape
    a sh:NodeShape ;
    rdfs:label "E8 Weyl-order value shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint over math:RootSystem: a root system carrying the E8 fingerprint (240 roots in rank 8) MUST declare a math:weylGroup whose math:groupOrder is 696,729,600 — the true order of W(E8). This turns the flagship's numbers into a validatable invariant: a corrupted Weyl order on data claiming to be E8 is rejected by value, not trusted."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:WrongE8WeylOrder ;
    sh:targetClass math:RootSystem ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:RootSystem with the E8 fingerprint (math:rootCount 240, math:rootSystemRank 8) must declare a math:weylGroup of math:groupOrder 696729600 — the order of W(E8); a different order corrupts the flagship invariant and is rejected." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/math/rootCount> 240 ;
                      <https://blackcatinformatics.ca/math/rootSystemRank> 8 ;
                      <https://blackcatinformatics.ca/math/weylGroup> ?w .
                ?w <https://blackcatinformatics.ca/math/groupOrder> ?order .
                FILTER(?order != 696729600)
            }
        """ ;
    ] .

# Rule 13 — a homomorphic-encryption scheme declares its homomorphic operation,
# hardness assumption, and noise model.
math:HomomorphicEncryptionSchemeShape
    a sh:NodeShape ;
    rdfs:label "Homomorphic-encryption scheme completeness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:HomomorphicEncryptionScheme: it declares the operation it is math:homomorphicOver, its math:securityAssumption (a lattice-hardness assumption), and its math:noiseModel. These make the homomorphic claim meaningful and its security stateable."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedEncryptionScheme ;
    sh:targetClass math:HomomorphicEncryptionScheme ;
    sh:property [
        sh:path math:homomorphicOver ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Operation ;
        sh:severity sh:Violation ;
        sh:message "A math:HomomorphicEncryptionScheme must declare the math:homomorphicOver operation it carries; a homomorphic scheme without a homomorphic operation is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:securityAssumption ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:LatticeHardnessAssumption ;
        sh:severity sh:Violation ;
        sh:message "A math:HomomorphicEncryptionScheme must declare its math:securityAssumption naming a math:LatticeHardnessAssumption; a scheme without a stated hardness assumption is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:noiseModel ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:HomomorphicEncryptionScheme must declare its math:noiseModel; a lattice-based scheme without a noise model is ill-formed." ;
    ] .

# Rule 14 — a ring declares the distributivity law that ties its two operations together.
math:RingDistributivityShape
    a sh:NodeShape ;
    rdfs:label "Ring distributivity shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:Ring: it declares, through math:satisfiesDistributivity, the distributivity law relating its multiplication to its addition (a·(b+c) = a·b + a·c). Distributivity is what makes a two-operation structure a ring rather than two unrelated groups; a ring declared without it is ill-formed. math:satisfiesDistributivity refines math:satisfiesAxiom (the distributivity law is one of the ring's axioms, and the reasoner entails the general property); the SHACL gate reads asserted triples, so a well-formed ring asserts both math:satisfiesAxiom and math:satisfiesDistributivity, satisfying math:AlgebraicStructureShape and this gate on the asserted graph."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:NonDistributiveRing ;
    sh:targetClass math:Ring ;
    sh:property [
        sh:path math:satisfiesDistributivity ;
        sh:minCount 1 ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Ring must declare at least one math:satisfiesDistributivity naming the distributivity axiom (a logic: formula) that ties its multiplication to its addition; a ring without distributivity is ill-formed." ;
    ] .

# =========================================================================== #
# Measure-and-dimension shapes — the cross-node vector arithmetic (homogeneity,
# integral composition, derived commensurability) is enforced by the native
# reasoned gate in crates/validate (math:DimensionalInhomogeneity); the shapes
# below are the cheap presence/cardinality obligations that precede it.
# =========================================================================== #

# Rule 15 — a measure declares its measurable space and its total mass.
math:MeasureShape
    a sh:NodeShape ;
    rdfs:label "Measure completeness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Measure: it declares the math:MeasurableSpace it acts on (math:measureOn) and exactly one math:totalMass — a finite non-negative number or the extended-real math:PositiveInfinity. A measure without its space and mass is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IncompleteMeasure ;
    sh:targetClass math:Measure ;
    sh:property [
        sh:path math:measureOn ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:MeasurableSpace ;
        sh:severity sh:Violation ;
        sh:message "A math:Measure must declare exactly one math:measureOn naming the math:MeasurableSpace it assigns mass over; a measure without its space is ill-formed." ;
    ] ;
    sh:property [
        sh:path math:totalMass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:or (
            [ sh:nodeKind sh:Literal ; sh:minInclusive 0 ]
            [ sh:hasValue math:PositiveInfinity ]
        ) ;
        sh:message "A math:Measure must declare exactly one math:totalMass — a non-negative number or math:PositiveInfinity; a measure without its total mass is ill-formed." ;
    ] .

# Rule 15b — a signed-extended-real slot holds a finite number or one of the two poles.
# Mirrors the math:totalMass sh:or idiom (finite literal / math:PositiveInfinity), but on
# the SIGNED extended real line ℝ̄: the finite branch admits negatives, and math:NegativeInfinity
# joins math:PositiveInfinity as an accepted pole. Targets the object of math:extendedRealValue,
# so the value in the slot is the focus node; a bad node fails all three arms and trips
# shacl.OrConstraintComponent (math:MalformedExtendedReal).
math:ExtendedRealShape
    a sh:NodeShape ;
    rdfs:label "Signed extended-real value shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for a signed-extended-real slot — the object of math:extendedRealValue, a value on the extended real line ℝ̄ = ℝ ∪ {−∞, +∞}. It is EITHER a finite numeric literal of either sign OR the pole math:PositiveInfinity OR the pole math:NegativeInfinity. A slot holding anything else — a non-numeric literal or an IRI that is neither pole — is a malformed extended real."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:MalformedExtendedReal ;
    sh:targetObjectsOf math:extendedRealValue ;
    sh:or (
        [ sh:nodeKind sh:Literal ;
          sh:or (
              [ sh:datatype xsd:double ]
              [ sh:datatype xsd:decimal ]
              [ sh:datatype xsd:integer ]
              [ sh:datatype xsd:float ]
          ) ]
        [ sh:hasValue math:PositiveInfinity ]
        [ sh:hasValue math:NegativeInfinity ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A signed-extended-real value must be a finite numeric literal, math:PositiveInfinity, or math:NegativeInfinity; anything else is a malformed extended real." .

# Rule 16 — a probability measure has total mass one.
math:ProbabilityMeasureShape
    a sh:NodeShape ;
    rdfs:label "Probability-measure mass shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ProbabilityMeasure: its math:totalMass is one. A probability measure is exactly a measure of total mass one; any other mass is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ProbabilityMeasureMassViolation ;
    sh:targetClass math:ProbabilityMeasure ;
    sh:property [
        sh:path math:totalMass ;
        sh:hasValue 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ProbabilityMeasure must have exactly one math:totalMass and it must be 1 — a probability measure is exactly a measure of total mass one." ;
    ] .

# Rule 17 — an integral names its integrand, domain, and measure.
math:IntegralShape
    a sh:NodeShape ;
    rdfs:label "Integral framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Integral: it names exactly one each of math:integrand (a math:MeasurableFunction), math:integrationDomain, and math:withRespectTo (the math:Measure it integrates against). An integral missing any of the three is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IncompleteIntegral ;
    sh:targetClass math:Integral ;
    sh:property [
        sh:path math:integrand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:MeasurableFunction ;
        sh:severity sh:Violation ;
        sh:message "A math:Integral must name exactly one math:integrand, and it must be a math:MeasurableFunction — the function it integrates." ;
    ] ;
    sh:property [
        sh:path math:integrationDomain ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Integral must name exactly one math:integrationDomain — the domain it integrates over." ;
    ] ;
    sh:property [
        sh:path math:withRespectTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Measure ;
        sh:severity sh:Violation ;
        sh:message "A math:Integral must name exactly one math:withRespectTo — the math:Measure it integrates against." ;
    ] .

# Rule 18 — every quantity carries a dimension.
math:QuantityDimensionShape
    a sh:NodeShape ;
    rdfs:label "Quantity dimensionedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:Quantity: it carries exactly one math:hasDimension naming the math:Dimension it lives in. Every quantity carries a dimension; an undimensioned quantity is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UndimensionedQuantity ;
    sh:targetClass math:Quantity ;
    sh:property [
        sh:path math:hasDimension ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Dimension ;
        sh:severity sh:Violation ;
        sh:message "A math:Quantity must declare exactly one math:hasDimension naming the math:Dimension it carries; an undimensioned quantity is ill-formed." ;
    ] .

# Rule 19 — a derived dimension declares a non-empty exponent structure.
math:DerivedDimensionShape
    a sh:NodeShape ;
    rdfs:label "Derived-dimension structure shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:DerivedDimension: it declares at least one math:baseDimensionExponent cell giving its product over the base dimensions. A derived dimension with no exponent structure is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:MalformedDimension ;
    sh:targetClass math:DerivedDimension ;
    sh:property [
        sh:path math:baseDimensionExponent ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:DimensionExponent ;
        sh:severity sh:Violation ;
        sh:message "A math:DerivedDimension must declare at least one math:baseDimensionExponent naming a math:DimensionExponent cell; a derived dimension without its exponent structure is ill-formed." ;
    ] .

# Rule 20 — a dimension exponent cell names a base dimension and an exact-rational power.
math:DimensionExponentShape
    a sh:NodeShape ;
    rdfs:label "Dimension-exponent cell shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:DimensionExponent: it names the math:BaseDimension it raises (math:exponentOfDimension — a base dimension only, never a derived one, so the exponent vector is acyclic) and carries both math:exponentNumerator and a non-zero math:exponentDenominator, giving an exact-rational power. A zero denominator is not a rational power and is rejected here (not silently dropped downstream)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:MalformedDimension ;
    sh:targetClass math:DimensionExponent ;
    sh:property [
        sh:path math:exponentOfDimension ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:BaseDimension ;
        sh:severity sh:Violation ;
        sh:message "A math:DimensionExponent must name exactly one math:exponentOfDimension, and it must be a math:BaseDimension — never a derived dimension, so the exponent vector is well-defined and acyclic." ;
    ] ;
    sh:property [
        sh:path math:exponentNumerator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Violation ;
        sh:message "A math:DimensionExponent must declare exactly one integer math:exponentNumerator — the numerator of its exact-rational power." ;
    ] ;
    sh:property [
        sh:path math:exponentDenominator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:not [ sh:hasValue 0 ] ;
        sh:severity sh:Violation ;
        sh:message "A math:DimensionExponent must declare exactly one non-zero integer math:exponentDenominator — the denominator of its exact-rational power; a zero denominator is not a rational power." ;
    ] .

# Rule 21 — a dimensional expression combines at least two operands.
math:DimensionalExpressionShape
    a sh:NodeShape ;
    rdfs:label "Dimensional-expression operand shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:DimensionalExpression: it carries at least two math:homogeneousOperand — homogeneity is vacuous below two operands. The native reasoned gate then checks that the operands share one dimension (math:DimensionalInhomogeneity)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:MalformedDimension ;
    sh:targetClass math:DimensionalExpression ;
    sh:property [
        sh:path math:homogeneousOperand ;
        sh:minCount 2 ;
        sh:severity sh:Violation ;
        sh:message "A math:DimensionalExpression must carry at least two math:homogeneousOperand — dimensional homogeneity is vacuous for zero or one operand." ;
    ] .

# =========================================================================== #
# Analysis-and-geometry hard-rule gates (ANALYSIS-AND-GEOMETRY charter)
#
# Binder AST: argument slots and variable occurrences are well-formed. Calculus:
# a derivative/limit/series names its subject and variable/mode. Topology:
# continuity/compactness/connectedness are declared, not assumed. Geometry: a
# manifold declares dimension and structure kind, a chart names its frame, and
# the chart/tangent dimensions agree with the manifold (a SHACL-SPARQL gate, the
# analysis-geometry analogue of dimensional homogeneity). Each shape names the
# typed math:MathConformanceFailure it raises through gmeow:enforcesFailureClass.
# =========================================================================== #

# --- Binder AST -------------------------------------------------------------- #

# An argument slot carries exactly one index and one expression.
math:ArgumentSlotShape
    a sh:NodeShape ;
    rdfs:label "Argument-slot well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:ArgumentSlot: it carries exactly one math:slotIndex (a non-negative integer) and exactly one math:slotExpression. A slot missing its index or expression is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:MalformedArgumentSlot ;
    sh:targetClass math:ArgumentSlot ;
    sh:property [
        sh:path math:slotIndex ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "A math:ArgumentSlot must carry exactly one math:slotIndex (a non-negative integer)." ;
    ] ;
    sh:property [
        sh:path math:slotExpression ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:ArgumentSlot must name exactly one math:slotExpression — its operand or a binder's body." ;
    ] .

# Slot indexes are unique within one application.
math:SlotIndexUniquenessShape
    a sh:NodeShape ;
    rdfs:label "Slot-index uniqueness shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint: within one application/binder node the math:slotIndex of its math:argumentSlot cells are unique — two slots sharing an index make operand order ambiguous."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:MalformedArgumentSlot ;
    sh:targetSubjectsOf math:argumentSlot ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "Two math:argumentSlot cells of one application share a math:slotIndex; slot indexes must be unique so operand order is well-defined." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/math/argumentSlot> ?s1 .
                $this <https://blackcatinformatics.ca/math/argumentSlot> ?s2 .
                ?s1 <https://blackcatinformatics.ca/math/slotIndex> ?i .
                ?s2 <https://blackcatinformatics.ca/math/slotIndex> ?i .
                FILTER(?s1 != ?s2)
            }
        """ ;
    ] .

# An application applies exactly one operator.
math:ApplicationExpressionShape
    a sh:NodeShape ;
    rdfs:label "Application-operator cardinality shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ApplicationExpression: it applies exactly one math:operator. An application — a tensor computation node or an arithmetic application — names the single operator it invokes; zero operators leave the application undefined and two or more make it ambiguous which operator is applied (math:ApplicationOperatorCardinality). The sibling binder AST (math:BindingExpression: math:Derivative, math:Limit, math:Series, math:Integral) is not a subclass of math:ApplicationExpression, so this shape targets only true applications, never the binders."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ApplicationOperatorCardinality ;
    sh:targetClass math:ApplicationExpression ;
    sh:property [
        sh:path math:operator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ApplicationExpression must apply exactly one math:operator." ;
    ] .

# A binding expression names the variable it binds and its body.
math:BindingExpressionShape
    a sh:NodeShape ;
    rdfs:label "Binding-expression well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:BindingExpression: a binder names the math:VariableDeclaration it introduces through exactly one math:boundVariable and names its body through at least one indexed math:argumentSlot cell. A binder without its bound variable, or without a body, is ill-formed (math:MalformedBindingExpression). Subclass-aware: math:Derivative, math:Limit, math:Series, and math:Integral are binding expressions, so this shape also targets them — each must name the variable it binds and its body as a generic binder, alongside its calculus-specific frame."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:MalformedBindingExpression ;
    sh:targetClass math:BindingExpression ;
    sh:property [
        sh:path math:boundVariable ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:BindingExpression must name exactly one math:VariableDeclaration it binds through math:boundVariable; a binder without its bound variable is ill-formed (math:MalformedBindingExpression)." ;
    ] ;
    sh:property [
        sh:path math:argumentSlot ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:BindingExpression must name its body through at least one indexed math:argumentSlot cell; a binder without a body is ill-formed (math:MalformedBindingExpression)." ;
    ] .

# A variable occurrence resolves to a declaration.
math:VariableOccurrenceShape
    a sh:NodeShape ;
    rdfs:label "Variable-occurrence scoping shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:VariableOccurrence: it resolves to exactly one math:VariableDeclaration through math:declaredVariable (a bound declaration or a math:FreeVariableDeclaration). There is no implicit free variable."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnscopedVariableOccurrence ;
    sh:targetClass math:VariableOccurrence ;
    sh:property [
        sh:path math:declaredVariable ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:VariableOccurrence must resolve to exactly one math:VariableDeclaration through math:declaredVariable; an unscoped occurrence is ill-formed." ;
    ] .

# A truth-valued expression lowered into logic: declares its denotation and preservation.
math:LogicLoweringShape
    a sh:NodeShape ;
    rdfs:label "Logic-lowering declaration shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for the math→logic: lowering seam: any math:MathematicalExpression that names a logic:Formula through math:compilesToLogicFormula must also declare its math:denotationKind (that it denotes a proposition) and its math:logicLoweringPreservation (the loss-ledger polarity of the lowering, a logic:preservationKind value). Silent promotion of a mathematical expression to a logical assertion — lowering without either declaration — is forbidden (math:UndeclaredLogicLowering)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UndeclaredLogicLowering ;
    sh:targetSubjectsOf math:compilesToLogicFormula ;
    sh:property [
        sh:path math:denotationKind ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An expression lowered to a logic:Formula through math:compilesToLogicFormula must declare its math:denotationKind; silent promotion to a logical assertion is forbidden (math:UndeclaredLogicLowering)." ;
    ] ;
    sh:property [
        sh:path math:logicLoweringPreservation ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An expression lowered to a logic:Formula through math:compilesToLogicFormula must declare its math:logicLoweringPreservation (a logic:preservationKind value); an unrecorded lowering is forbidden (math:UndeclaredLogicLowering)." ;
    ] .

# --- Calculus ---------------------------------------------------------------- #

# A derivative names what it differentiates, its variable, and its order.
math:DerivativeShape
    a sh:NodeShape ;
    rdfs:label "Derivative framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Derivative: it names math:derivativeOf, math:withRespectToVariable, and math:derivativeOrder. A derivative that does not say what, with respect to which variable, and at what order is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedDerivative ;
    sh:targetClass math:Derivative ;
    sh:property [
        sh:path math:derivativeOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Derivative must name what it differentiates through math:derivativeOf." ;
    ] ;
    sh:property [
        sh:path math:withRespectToVariable ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Derivative must name its variable of differentiation through math:withRespectToVariable." ;
    ] ;
    sh:property [
        sh:path math:derivativeOrder ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:Derivative must declare its order through math:derivativeOrder (a positive integer)." ;
    ] .

# A limit names its expression and its limit point.
math:LimitShape
    a sh:NodeShape ;
    rdfs:label "Limit framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Limit: it names math:limitOf (the expression) and math:limitPoint (the point approached). Its math:limitMode (direction) is optional — a two-sided limit has no direction."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedLimit ;
    sh:targetClass math:Limit ;
    sh:property [
        sh:path math:limitOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Limit must name the expression whose limit is taken through math:limitOf." ;
    ] ;
    sh:property [
        sh:path math:limitPoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:Limit must name the point its variable approaches through math:limitPoint." ;
    ] .

# A convergence names what it converges to and in which mode.
math:ConvergenceShape
    a sh:NodeShape ;
    rdfs:label "Convergence framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Convergence: it names math:convergesTo and math:convergenceMode (a math:ConvergenceMode). 'It converges' is meaningless without the mode."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedConvergence ;
    sh:targetClass math:Convergence ;
    sh:property [
        sh:path math:convergesTo ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:Convergence must name what it converges to through math:convergesTo." ;
    ] ;
    sh:property [
        sh:path math:convergenceMode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class math:ConvergenceMode ;
        sh:severity sh:Violation ;
        sh:message "A math:Convergence must name its mode through math:convergenceMode (pointwise, uniform, absolute, conditional, in-measure, almost-everywhere, in-Lᵖ-norm, or in-distribution)." ;
    ] .

# A series names its general term and carries a convergence.
math:SeriesShape
    a sh:NodeShape ;
    rdfs:label "Series framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Series: it names its math:seriesTerm and carries a math:Convergence through math:hasConvergence naming what it converges to and in which mode."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedConvergence ;
    sh:targetClass math:Series ;
    sh:property [
        sh:path math:seriesTerm ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Series must name its general term through math:seriesTerm." ;
    ] ;
    sh:property [
        sh:path math:hasConvergence ;
        sh:minCount 1 ;
        sh:class math:Convergence ;
        sh:severity sh:Violation ;
        sh:message "A math:Series must carry a math:Convergence through math:hasConvergence naming its mode of convergence." ;
    ] .

# A sequence carries a convergence naming its mode.
math:SequenceShape
    a sh:NodeShape ;
    rdfs:label "Sequence convergence framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:Sequence: it carries a math:Convergence through math:hasConvergence naming what it converges to and in which mode. A sequence asserted to converge without a math:Convergence naming the mode is ill-formed (math:UnderspecifiedConvergence)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedConvergence ;
    sh:targetClass math:Sequence ;
    sh:property [
        sh:path math:hasConvergence ;
        sh:minCount 1 ;
        sh:class math:Convergence ;
        sh:severity sh:Violation ;
        sh:message "A math:Sequence must carry a math:Convergence through math:hasConvergence naming its mode of convergence (math:UnderspecifiedConvergence)." ;
    ] .

# --- Topology: declared, not assumed ---------------------------------------- #

math:ContinuousMapShape
    a sh:NodeShape ;
    rdfs:label "Continuous-map declaration shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ContinuousMap: it declares its continuity through math:isContinuous — continuity is declared (backed by math:continuityLaw), not assumed from the type."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UndeclaredTopologicalProperty ;
    sh:targetClass math:ContinuousMap ;
    sh:property [
        sh:path math:isContinuous ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:severity sh:Violation ;
        sh:message "A math:ContinuousMap must declare math:isContinuous; continuity is declared, not assumed." ;
    ] .

math:CompactSpaceShape
    a sh:NodeShape ;
    rdfs:label "Compact-space declaration shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:CompactSpace: it declares its compactness through math:isCompact — compactness is declared, not assumed from the type."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UndeclaredTopologicalProperty ;
    sh:targetClass math:CompactSpace ;
    sh:property [
        sh:path math:isCompact ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:severity sh:Violation ;
        sh:message "A math:CompactSpace must declare math:isCompact; compactness is declared, not assumed." ;
    ] .

math:ConnectedSpaceShape
    a sh:NodeShape ;
    rdfs:label "Connected-space declaration shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ConnectedSpace: it declares its connectedness through math:isConnected — connectedness is declared, not assumed from the type."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UndeclaredTopologicalProperty ;
    sh:targetClass math:ConnectedSpace ;
    sh:property [
        sh:path math:isConnected ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:severity sh:Violation ;
        sh:message "A math:ConnectedSpace must declare math:isConnected; connectedness is declared, not assumed." ;
    ] .

# --- Geometry: manifold and chart framing ----------------------------------- #

math:ManifoldShape
    a sh:NodeShape ;
    rdfs:label "Manifold framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Manifold: it declares its dimension (math:manifoldDimension) and its structure kind (math:manifoldStructureKind, one of the five kinds). A manifold missing either is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedManifold ;
    sh:targetClass math:Manifold ;
    sh:property [
        sh:path math:manifoldDimension ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "A math:Manifold must declare its dimension through math:manifoldDimension (a non-negative integer)." ;
    ] ;
    sh:property [
        sh:path math:manifoldStructureKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class math:ManifoldStructureKind ;
        sh:severity sh:Violation ;
        sh:message "A math:Manifold must declare its structure kind through math:manifoldStructureKind (topological, smooth, complex, Riemannian, or Lorentzian)." ;
    ] .

math:ChartShape
    a sh:NodeShape ;
    rdfs:label "Chart framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Chart: it names its domain (math:chartDomain), its coordinate map (math:coordinateMap), and its target coordinate space (math:targetCoordinateSpace). A chart missing any is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedChart ;
    sh:targetClass math:Chart ;
    sh:property [
        sh:path math:chartDomain ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Chart must name the region it covers through math:chartDomain." ;
    ] ;
    sh:property [
        sh:path math:coordinateMap ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Chart must name its coordinate map through math:coordinateMap." ;
    ] ;
    sh:property [
        sh:path math:targetCoordinateSpace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Chart must name its target coordinate space through math:targetCoordinateSpace." ;
    ] .

# --- Geometry: dimension-consistency (SHACL-SPARQL, → math:DimensionMismatch) - #

# A chart on an n-manifold maps into a target of dimension n.
math:ChartDimensionShape
    a sh:NodeShape ;
    rdfs:label "Chart dimension-consistency shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint: a math:Chart's math:targetCoordinateSpace has the same math:spaceDimension as its manifold's math:manifoldDimension. A chart into the wrong-dimensional space is a silent-error class the charter forbids."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:DimensionMismatch ;
    sh:targetClass math:Chart ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:Chart's target coordinate space dimension does not equal its manifold's dimension (math:DimensionMismatch)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                ?m <https://blackcatinformatics.ca/math/hasChart> $this .
                ?m <https://blackcatinformatics.ca/math/manifoldDimension> ?md .
                $this <https://blackcatinformatics.ca/math/targetCoordinateSpace> ?t .
                ?t <https://blackcatinformatics.ca/math/spaceDimension> ?sd .
                FILTER(?md != ?sd)
            }
        """ ;
    ] .

# A tangent space has the same dimension as its manifold.
math:TangentSpaceDimensionShape
    a sh:NodeShape ;
    rdfs:label "Tangent-space dimension-consistency shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint: a math:TangentSpace's math:spaceDimension equals its manifold's math:manifoldDimension. A tangent space of the wrong dimension is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:DimensionMismatch ;
    sh:targetClass math:TangentSpace ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:TangentSpace's dimension does not equal its manifold's dimension (math:DimensionMismatch)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/math/tangentSpaceOf> ?m .
                ?m <https://blackcatinformatics.ca/math/manifoldDimension> ?md .
                $this <https://blackcatinformatics.ca/math/spaceDimension> ?sd .
                FILTER(?md != ?sd)
            }
        """ ;
    ] .

# A metric signature (p, q) has p + q equal to its manifold's dimension, and its
# (p, q) split agrees with the manifold's structure kind: Riemannian ⇒ q = 0
# (positive-definite), Lorentzian ⇒ exactly one timelike direction (p = 1 or q = 1).
math:MetricSignatureDimensionShape
    a sh:NodeShape ;
    rdfs:label "Metric-signature dimension-consistency shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint: a math:MetricSignature's math:signaturePositive p and math:signatureNegative q sum to its manifold's math:manifoldDimension, and the (p, q) split agrees with the manifold's math:manifoldStructureKind — a math:riemannianStructure metric is positive-definite (q = 0) and a math:lorentzianStructure metric has exactly one timelike direction (p = 1 or q = 1). A signature that miscounts the dimension or contradicts the structure kind is a silent-error class the charter forbids (math:DimensionMismatch)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:DimensionMismatch ;
    sh:targetClass math:MetricSignature ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:MetricSignature's math:signaturePositive plus math:signatureNegative does not equal its manifold's math:manifoldDimension (math:DimensionMismatch)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                ?mt <https://blackcatinformatics.ca/math/metricSignature> $this .
                ?m <https://blackcatinformatics.ca/math/metricTensor> ?mt .
                ?m <https://blackcatinformatics.ca/math/manifoldDimension> ?md .
                $this <https://blackcatinformatics.ca/math/signaturePositive> ?p .
                $this <https://blackcatinformatics.ca/math/signatureNegative> ?q .
                BIND((?p + ?q) AS ?s)
                FILTER(?s != ?md)
            }
        """ ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:lorentzianStructure manifold's math:MetricSignature does not have exactly one timelike direction (math:signaturePositive = 1 or math:signatureNegative = 1) (math:DimensionMismatch)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                ?mt <https://blackcatinformatics.ca/math/metricSignature> $this .
                ?m <https://blackcatinformatics.ca/math/metricTensor> ?mt .
                ?m <https://blackcatinformatics.ca/math/manifoldStructureKind> <https://blackcatinformatics.ca/math/lorentzianStructure> .
                $this <https://blackcatinformatics.ca/math/signaturePositive> ?p .
                $this <https://blackcatinformatics.ca/math/signatureNegative> ?q .
                FILTER(?p != 1 && ?q != 1)
            }
        """ ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:riemannianStructure manifold's math:MetricSignature is not positive-definite (math:signatureNegative = 0) (math:DimensionMismatch)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                ?mt <https://blackcatinformatics.ca/math/metricSignature> $this .
                ?m <https://blackcatinformatics.ca/math/metricTensor> ?mt .
                ?m <https://blackcatinformatics.ca/math/manifoldStructureKind> <https://blackcatinformatics.ca/math/riemannianStructure> .
                $this <https://blackcatinformatics.ca/math/signatureNegative> ?q .
                FILTER(?q != 0)
            }
        """ ;
    ] .

# =========================================================================== #
# Linear algebra, learning, and representation (LINEAR-ALGEBRA-AND-LEARNING)
#
# A decomposition or embedding declares its inputs, policy, and outputs; an
# orthogonal complement additionally names the inner product defining it; and any
# meaning read off a residual, component, or latent dimension is a vantage-held
# math:ResidualInterpretationClaim (a gmeow:Observation), never a property. The
# tensor computation graph reuses math:ApplicationExpression, so the inherited
# application/slot shapes bite its nodes; these shapes add only the graph- and
# weight-level framing.
# =========================================================================== #

math:OrthogonalComplementShape
    a sh:NodeShape ;
    rdfs:label "Orthogonal-complement inner-product shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:OrthogonalComplement: beyond the ambient space and complement-semantics inherited from math:ComplementShape (math:OrthogonalComplement is a math:Complement), it names the inner product that defines its orthogonality through math:definedByInnerProduct — the math:HermitianInnerProduct in the complex case. An orthogonal complement without a named inner product is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnqualifiedOrthogonalComplement ;
    sh:targetClass math:OrthogonalComplement ;
    sh:property [
        sh:path math:definedByInnerProduct ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:OrthogonalComplement must name the inner product defining its orthogonality through math:definedByInnerProduct; an orthogonal complement without it is ill-formed." ;
    ] .

math:PCAAnalysisShape
    a sh:NodeShape ;
    rdfs:label "PCA analysis inputs/policy/outputs shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:PCAAnalysis: it declares its inputs, its policy, and its outputs — math:analysisInput, math:centeringPolicy, math:scalingPolicy, math:covarianceOperator, math:eigensolver, math:principalComponent, math:loadingVector, math:scoreVector, math:explainedVarianceRatio, and math:residualSubspace. A decomposition hiding any of these is ill-formed (math:IncompletePCAAnalysis)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IncompletePCAAnalysis ;
    sh:targetClass math:PCAAnalysis ;
    sh:property [
        sh:path math:analysisInput ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:PCAAnalysis must name its input through math:analysisInput." ;
    ] ;
    sh:property [
        sh:path math:centeringPolicy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class math:CenteringPolicy ;
        sh:severity sh:Violation ;
        sh:message "A math:PCAAnalysis must declare exactly one math:centeringPolicy (a math:CenteringPolicy)." ;
    ] ;
    sh:property [
        sh:path math:scalingPolicy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class math:ScalingPolicy ;
        sh:severity sh:Violation ;
        sh:message "A math:PCAAnalysis must declare exactly one math:scalingPolicy (a math:ScalingPolicy)." ;
    ] ;
    sh:property [
        sh:path math:covarianceOperator ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:PCAAnalysis must name the math:CovarianceOperator it decomposes through math:covarianceOperator." ;
    ] ;
    sh:property [
        sh:path math:eigensolver ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:PCAAnalysis must name its math:eigensolver." ;
    ] ;
    sh:property [
        sh:path math:principalComponent ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:PCAAnalysis must produce at least one math:principalComponent." ;
    ] ;
    sh:property [
        sh:path math:loadingVector ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:PCAAnalysis must produce at least one math:loadingVector." ;
    ] ;
    sh:property [
        sh:path math:scoreVector ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:PCAAnalysis must produce at least one math:scoreVector." ;
    ] ;
    sh:property [
        sh:path math:explainedVarianceRatio ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:PCAAnalysis must report at least one math:explainedVarianceRatio." ;
    ] ;
    sh:property [
        sh:path math:residualSubspace ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:PCAAnalysis must name its math:residualSubspace." ;
    ] .

math:ResidualInterpretationClaimShape
    a sh:NodeShape ;
    rdfs:label "Residual-meaning observation shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ResidualInterpretationClaim: the meaning of a residual, component, or latent dimension is an observation held from a standpoint — it names its gmeow:vantage (whose frame), its gmeow:observedFeature (which residual/component/dimension), and its gmeow:observationResult (the grounded conclusion, typically a logic:MetaLevelFormula). Meaning asserted without its vantage is ill-formed (math:ResidualMeaningAsProperty); no direct meaning property exists, so a meaning is representable only through this vantage-grounded claim."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ResidualMeaningAsProperty ;
    sh:targetClass math:ResidualInterpretationClaim ;
    sh:property [
        sh:path gmeow:vantage ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ResidualInterpretationClaim must name the gmeow:vantage from which the meaning is claimed; a meaning without a standpoint is a property, not an observation (math:ResidualMeaningAsProperty)." ;
    ] ;
    sh:property [
        sh:path gmeow:observedFeature ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ResidualInterpretationClaim must name the residual, component, or latent dimension it is about through gmeow:observedFeature." ;
    ] ;
    sh:property [
        sh:path gmeow:observationResult ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ResidualInterpretationClaim must ground its meaning in a gmeow:observationResult (the conclusion the claim rests on)." ;
    ] .

math:EmbeddingShape
    a sh:NodeShape ;
    rdfs:label "Embedding source/target/function/model shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:Embedding (and its subclass math:KnowledgeGraphEmbedding): it names its math:embeddingSource, its math:targetSpace, its math:embeddingFunction, and the math:embeddingModel that produced it. An embedding missing any of these is ill-formed (math:UnderspecifiedEmbedding)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedEmbedding ;
    sh:targetClass math:Embedding ;
    sh:property [
        sh:path math:embeddingSource ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:Embedding must name its math:embeddingSource." ;
    ] ;
    sh:property [
        sh:path math:targetSpace ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:Embedding must name its math:targetSpace." ;
    ] ;
    sh:property [
        sh:path math:embeddingFunction ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:Embedding must name its math:embeddingFunction." ;
    ] ;
    sh:property [
        sh:path math:embeddingModel ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:Embedding must name its math:embeddingModel." ;
    ] .

math:TensorComputationGraphShape
    a sh:NodeShape ;
    rdfs:label "Tensor computation graph node shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:TensorComputationGraph: it declares at least one math:computationNode — a math:ApplicationExpression applying a tensor operator to indexed operands. Because the nodes reuse the expression AST, a node's single-operator well-formedness is enforced by math:ApplicationExpressionShape and its slot well-formedness by math:ArgumentSlotShape and math:SlotIndexUniquenessShape; a graph declaring no node is ill-formed (math:MalformedTensorComputationGraph)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:MalformedTensorComputationGraph ;
    sh:targetClass math:TensorComputationGraph ;
    sh:property [
        sh:path math:computationNode ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:TensorComputationGraph must declare at least one math:computationNode (a math:ApplicationExpression)." ;
    ] .

math:WeightTensorShape
    a sh:NodeShape ;
    rdfs:label "Weight-tensor parameter-space shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:WeightTensor: it names the math:ParameterSpace it lives in through math:inParameterSpace. Weights live in a declared parameter space over which optimization searches; a weight tensor without one is ill-formed (math:UnframedWeightTensor)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnframedWeightTensor ;
    sh:targetClass math:WeightTensor ;
    sh:property [
        sh:path math:inParameterSpace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class math:ParameterSpace ;
        sh:severity sh:Violation ;
        sh:message "A math:WeightTensor must name the math:ParameterSpace it lives in through math:inParameterSpace." ;
    ] .

# Rule — a filtration declares stages, each with a threshold and a structure.
math:FiltrationShape
    a sh:NodeShape ;
    rdfs:label "Filtration structural-presence shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Filtration and its stages: a filtration declares at least one math:hasFiltrationStage, and every math:FiltrationStage names exactly one math:filtrationThreshold (a gmeow:Quantity, the ε it sits at) and exactly one math:stageStructure (a math:TopologicalSpace, the substructure present at ε). This is a STRUCTURAL PRESENCE gate only — it does NOT encode monotonicity (ε₁ ≤ ε₂ ⇒ containment), which is carried by the first-order law math:filtrationMonotonicityLaw, not by a shape. A filtration with no stages, or a stage missing its threshold or structure, is ill-formed (math:UnderspecifiedFiltration)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedFiltration ;
    sh:targetClass math:Filtration ;
    sh:property [
        sh:path math:hasFiltrationStage ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:FiltrationStage ;
        sh:severity sh:Violation ;
        sh:message "A math:Filtration must declare at least one math:hasFiltrationStage naming a math:FiltrationStage; a filtration with no stages is ill-formed (math:UnderspecifiedFiltration)." ;
    ] .

math:FiltrationStageShape
    a sh:NodeShape ;
    rdfs:label "Filtration-stage threshold/structure shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:FiltrationStage: it names exactly one math:filtrationThreshold (the gmeow:Quantity ε it sits at) and exactly one math:stageStructure (the math:TopologicalSpace present at that threshold). A stage that names neither where it sits nor what is present there is ill-formed (math:UnderspecifiedFiltration)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedFiltration ;
    sh:targetClass math:FiltrationStage ;
    sh:property [
        sh:path math:filtrationThreshold ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:FiltrationStage must name exactly one math:filtrationThreshold — the gmeow:Quantity ε it sits at; a stage without its threshold is ill-formed (math:UnderspecifiedFiltration)." ;
    ] ;
    sh:property [
        sh:path math:stageStructure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:TopologicalSpace ;
        sh:severity sh:Violation ;
        sh:message "A math:FiltrationStage must name exactly one math:stageStructure, and it must be a math:TopologicalSpace — the substructure Kε present at its threshold; a stage without its structure is ill-formed (math:UnderspecifiedFiltration)." ;
    ] .

# Rule — a persistence lifetime declares both endpoints of its birth–death interval.
math:PersistenceLifetimeShape
    a sh:NodeShape ;
    rdfs:label "Persistence-lifetime birth/death shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:PersistenceLifetime: it names exactly one math:bornAt (the gmeow:Quantity threshold the feature appears at) and at least one math:diesAt (the threshold it disappears at — a finite gmeow:Quantity, or the individual math:PositiveInfinity for an essential feature that never dies within the filtration). A lifetime missing either endpoint has no persistence value (death − birth) and is ill-formed (math:UnderspecifiedPersistenceLifetime); an essential feature must state math:PositiveInfinity, never omit the death. The presence of math:overFiltration and math:persistenceFeature is required so the lifetime is anchored to its filtration and the math:HomologyGroup generator it tracks."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedPersistenceLifetime ;
    sh:targetClass math:PersistenceLifetime ;
    sh:property [
        sh:path math:overFiltration ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Filtration ;
        sh:severity sh:Violation ;
        sh:message "A math:PersistenceLifetime must name exactly one math:overFiltration — the math:Filtration it is read over; a lifetime not anchored to a filtration is ill-formed (math:UnderspecifiedPersistenceLifetime)." ;
    ] ;
    sh:property [
        sh:path math:persistenceFeature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:HomologyGroup ;
        sh:severity sh:Violation ;
        sh:message "A math:PersistenceLifetime must name exactly one math:persistenceFeature — the math:HomologyGroup generator whose survival it tracks; a lifetime without its feature is ill-formed (math:UnderspecifiedPersistenceLifetime)." ;
    ] ;
    sh:property [
        sh:path math:bornAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:PersistenceLifetime must name exactly one math:bornAt — the gmeow:Quantity threshold the feature appears at; a lifetime without its birth is ill-formed (math:UnderspecifiedPersistenceLifetime)." ;
    ] ;
    sh:property [
        sh:path math:diesAt ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:PersistenceLifetime must name exactly one math:diesAt — the finite gmeow:Quantity death threshold, or math:PositiveInfinity for an essential feature; omitting the death entirely is ill-formed (math:UnderspecifiedPersistenceLifetime)." ;
    ] .

# Rule — a stability calibration record carries evidence, derivation kind, and guarantee.
math:StabilityCalibrationRecordShape
    a sh:NodeShape ;
    rdfs:label "Stability-calibration grounding shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:StabilityCalibrationRecord: it names its math:calibrationEvidence (at least one math:PersistenceLifetime whose persistence produced the credence), exactly one math:credenceDerivationKind (which signal the credence derives from), and exactly one math:stabilityGuarantee (the math:Theorem bounding how far the persistence — and hence the credence — can move under perturbation). A record missing its evidence, derivation kind, or guarantee is an unwarranted number rather than a calibrated one and is ill-formed (math:UngroundedStabilityCalibration)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UngroundedStabilityCalibration ;
    sh:targetClass math:StabilityCalibrationRecord ;
    sh:property [
        sh:path math:calibrationEvidence ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:PersistenceLifetime ;
        sh:severity sh:Violation ;
        sh:message "A math:StabilityCalibrationRecord must name at least one math:calibrationEvidence, and it must be a math:PersistenceLifetime — the persistence evidence the credence rests on; a record with no evidence is ill-formed (math:UngroundedStabilityCalibration)." ;
    ] ;
    sh:property [
        sh:path math:credenceDerivationKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:CredenceDerivationKind ;
        sh:severity sh:Violation ;
        sh:message "A math:StabilityCalibrationRecord must name exactly one math:credenceDerivationKind — the math:CredenceDerivationKind the credence derives from; a record without it is ill-formed (math:UngroundedStabilityCalibration)." ;
    ] ;
    sh:property [
        sh:path math:stabilityGuarantee ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Theorem ;
        sh:severity sh:Violation ;
        sh:message "A math:StabilityCalibrationRecord must name exactly one math:stabilityGuarantee, and it must be a math:Theorem — the stability result underwriting the calibration; a record without it is ill-formed (math:UngroundedStabilityCalibration)." ;
    ] .

# =========================================================================== #
# Numeric-layer hard-rule gates (LINEAR-ALGEBRA-AND-LEARNING charter)          #
#                                                                              #
# The exact-numeric layer's well-formedness: a rational carrier has a non-zero #
# denominator; a norm rests on a positive-definite symmetric form; a Gram      #
# matrix is symmetric. Each shape names the typed math:MathConformanceFailure  #
# it raises through gmeow:enforcesFailureClass.                                 #
# =========================================================================== #

# Rule — an exact rational carrier has a non-zero denominator.
math:RationalValueShape
    a sh:NodeShape ;
    rdfs:label "Rational-value non-zero-denominator shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:RationalValue: it carries exactly one integer math:numerator and exactly one integer math:denominator, and the denominator is non-zero. A zero denominator is not a rational value (p/0 is undefined); the object-layer twin of the dimension-exponent zero-denominator rule."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ZeroDenominator ;
    sh:targetClass math:RationalValue ;
    sh:property [
        sh:path math:numerator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:severity sh:Violation ;
        sh:message "A math:RationalValue must declare exactly one integer math:numerator — the p of its exact p/q value." ;
    ] ;
    sh:property [
        sh:path math:denominator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:not [ sh:hasValue 0 ] ;
        sh:severity sh:Violation ;
        sh:message "A math:RationalValue must declare exactly one non-zero integer math:denominator — the q of its exact p/q value; a zero denominator is not a rational value (math:ZeroDenominator)." ;
    ] .

# Rule — a norm rests on a positive-definite symmetric bilinear form.
math:NormPositiveDefiniteShape
    a sh:NodeShape ;
    rdfs:label "Norm positive-definite-form shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:Norm: it names the symmetric bilinear form inducing it through math:inducedByForm, and that form's math:definiteness is math:positiveDefinite — ‖x‖ = √⟨x, x⟩ is a genuine norm only for a positive-definite form. A norm resting on an indefinite, semidefinite, or definiteness-unstated form is ill-formed (math:NonPositiveDefiniteNorm)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:NonPositiveDefiniteNorm ;
    sh:targetClass math:Norm ;
    sh:property [
        sh:path math:inducedByForm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Norm must name exactly one math:inducedByForm — the symmetric bilinear form whose √⟨x, x⟩ it is." ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:Norm's math:inducedByForm must be positive-definite (math:definiteness math:positiveDefinite); a norm resting on a non-positive-definite form is ill-formed (math:NonPositiveDefiniteNorm)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/math/inducedByForm> ?form .
                FILTER NOT EXISTS {
                    ?form <https://blackcatinformatics.ca/math/definiteness> <https://blackcatinformatics.ca/math/positiveDefinite> .
                }
            }
        """ ;
    ] .

# Rule — a Gram matrix names its form and basis and is symmetric.
math:GramMatrixShape
    a sh:NodeShape ;
    rdfs:label "Gram-matrix symmetry shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:GramMatrix: it names the math:SymmetricBilinearForm it represents through math:representsForm, the math:Basis it is taken in through math:inBasis, and is symmetric — every math:MatrixEntry at (row, column) has a transpose entry at (column, row) carrying the same math:entryValue. A Gram matrix is the matrix of a symmetric form; a non-symmetric one is ill-formed (math:AsymmetricGramMatrix)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:AsymmetricGramMatrix ;
    sh:targetClass math:GramMatrix ;
    sh:property [
        sh:path math:representsForm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:SymmetricBilinearForm ;
        sh:severity sh:Violation ;
        sh:message "A math:GramMatrix must name exactly one math:representsForm — the math:SymmetricBilinearForm it is the matrix of." ;
    ] ;
    sh:property [
        sh:path math:inBasis ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:Basis ;
        sh:severity sh:Violation ;
        sh:message "A math:GramMatrix must name exactly one math:inBasis — the math:Basis its entries are taken relative to." ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:GramMatrix must be symmetric: every math:MatrixEntry at (row, column) needs a transpose entry at (column, row) with the same math:entryValue; a missing or mismatched transpose entry is ill-formed (math:AsymmetricGramMatrix)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/math/hasEntry> ?entry .
                ?entry <https://blackcatinformatics.ca/math/atRow> ?row ;
                       <https://blackcatinformatics.ca/math/atColumn> ?col ;
                       <https://blackcatinformatics.ca/math/entryValue> ?val .
                ?val <https://blackcatinformatics.ca/math/numerator> ?vnum ;
                     <https://blackcatinformatics.ca/math/denominator> ?vden .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/math/hasEntry> ?mate .
                    ?mate <https://blackcatinformatics.ca/math/atRow> ?col ;
                          <https://blackcatinformatics.ca/math/atColumn> ?row ;
                          <https://blackcatinformatics.ca/math/entryValue> ?mval .
                    ?mval <https://blackcatinformatics.ca/math/numerator> ?vnum ;
                          <https://blackcatinformatics.ca/math/denominator> ?vden .
                }
            }
        """ ;
    ] .

# =========================================================================== #
# Bridges slice SHACL shapes — the ingestion-bridge hard-rule gates            #
# (BRIDGES charter). A bridge run retains its source witness and the process-  #
# layer in-band witness; a fitted model references data and specification; a   #
# formal-verification result is grounded BY a separate observation (result ≠   #
# claim). The hard-fail on the unliftable (math:UnliftableIngest) is a native  #
# lint gate, not a SHACL shape.                                                #
# =========================================================================== #

math:IngestRunShape
    a sh:NodeShape ;
    rdfs:label "Ingest-run grounding shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:IngestRun: it retains its source witness through math:parseSource and carries the process-layer in-band witness through logic:instantiatesSchema and logic:instantiatesPlan. A bridge run without its retained source and schema/plan witness cannot support the lawful put leg and is ill-formed (math:UngroundedIngestRun)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UngroundedIngestRun ;
    sh:targetClass math:IngestRun ;
    sh:property [
        sh:path math:parseSource ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:IngestRun must retain its source witness through math:parseSource — the in-band mnemomorphic complement that makes the lift a lawful put, not a backward-execution guess." ;
    ] ;
    sh:property [
        sh:path logic:instantiatesSchema ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:IngestRun must carry the process-layer in-band witness through logic:instantiatesSchema (the reusable bridge action schema)." ;
    ] ;
    sh:property [
        sh:path logic:instantiatesPlan ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:IngestRun must carry the process-layer in-band witness through logic:instantiatesPlan (the plan it was executed under)." ;
    ] ;
    sh:property [
        sh:path math:ingestCorrespondence ;
        sh:minCount 1 ;
        sh:class logic:Correspondence ;
        sh:severity sh:Violation ;
        sh:message "A math:IngestRun must carry its lift's law-spine on a logic:Correspondence through math:ingestCorrespondence (where its rung, preservation, and loss are recorded)." ;
    ] .

math:FittedModelShape
    a sh:NodeShape ;
    rdfs:label "Fitted-model data-and-specification shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:FittedModel: it references the data it was fitted to through math:fittedToData and the specification it fits through math:modelFormula. A fitted model missing its data or specification is ill-formed (math:UnfittedModel)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnfittedModel ;
    sh:targetClass math:FittedModel ;
    sh:property [
        sh:path math:fittedToData ;
        sh:minCount 1 ;
        sh:class math:DatasetMatrix ;
        sh:severity sh:Violation ;
        sh:message "A math:FittedModel must reference the math:DatasetMatrix it was fitted to through math:fittedToData." ;
    ] ;
    sh:property [
        sh:path math:modelFormula ;
        sh:minCount 1 ;
        sh:class math:ModelFormula ;
        sh:severity sh:Violation ;
        sh:message "A math:FittedModel must reference its math:ModelFormula specification through math:modelFormula." ;
    ] .

# Rule — an estimate fixes what it estimates and how: its estimand and/or its
# estimated parameter, AND the estimator that produced it.
math:UnderspecifiedEstimateShape
    a sh:NodeShape ;
    rdfs:label "Underspecified-estimate target-and-estimator shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:Estimate: it fixes both WHAT it estimates and HOW. The target arm is an sh:or requiring the estimand (math:estimatesEstimand) and/or the estimated parameter (math:estimatedParameter) — an estimate may reference its math:Estimand, its model parameter, or both — and the procedure arm requires the math:Estimator that produced it (math:estimator, min one). An estimate is the structured result object of the process / result / claim separation, never a bare number; one naming neither its estimand nor its parameter, or naming no estimator, is underspecified (math:UnderspecifiedEstimate). The two arms report distinct components — the target arm trips shacl.OrConstraintComponent, the estimator arm shacl.MinCountConstraintComponent — so a counter-example that satisfies the sh:or but omits the estimator isolates to the estimator min-count alone."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnderspecifiedEstimate ;
    sh:targetClass math:Estimate ;
    sh:or (
        [ sh:path math:estimatesEstimand ; sh:minCount 1 ]
        [ sh:path math:estimatedParameter ; sh:minCount 1 ]
    ) ;
    sh:property [
        sh:path math:estimator ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:Estimate must name the math:Estimator that produced it through math:estimator; a produced value with no estimator is a bare number without its act (math:UnderspecifiedEstimate)." ;
    ] ;
    sh:severity sh:Violation ;
    sh:message "A math:Estimate must reference its estimand through math:estimatesEstimand and/or its estimated parameter through math:estimatedParameter; an estimate naming neither its target quantity nor a model parameter is underspecified (math:UnderspecifiedEstimate)." .

math:ModelFormulaShape
    a sh:NodeShape ;
    rdfs:label "Model-formula binder shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ModelFormula: its body is a math:BindingExpression AST (the ~ is a binder over indexed operands), reached through math:argumentSlot — never a bare string. A model formula without its binder structure is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnframedFunction ;
    sh:targetClass math:ModelFormula ;
    sh:property [
        sh:path math:argumentSlot ;
        sh:minCount 1 ;
        sh:class math:ArgumentSlot ;
        sh:severity sh:Violation ;
        sh:message "A math:ModelFormula must carry its response/term structure as indexed math:ArgumentSlot operands (a math:BindingExpression AST), never a bare string." ;
    ] .

# Rule — missingness is modelled, not implied: a variable whose values encode
# absence declares the mechanism an analysis depending on it rests on.
math:ImplicitMissingnessShape
    a sh:NodeShape ;
    rdfs:label "Implicit-missingness declared-mechanism shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint over math:StatisticalVariable: a variable whose values encode absence — detected by a declared math:MissingnessIndicator attached through math:hasMissingnessIndicator — must name the math:MissingnessMechanism (MCAR/MAR/MNAR) an analysis depending on it rests on, through math:missingnessMechanism. The validity of every missing-data method is conditional on which mechanism holds, so a variable that carries a missingness indicator but declares no mechanism assumes one implicitly and is ill-formed (math:ImplicitMissingness). Absent a missingness indicator the shape is silent; it fires only on the un-declared conflation."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ImplicitMissingness ;
    sh:targetClass math:StatisticalVariable ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:StatisticalVariable whose values encode absence (it carries a math:MissingnessIndicator through math:hasMissingnessIndicator) must declare the math:MissingnessMechanism an analysis depending on it rests on, through math:missingnessMechanism; a variable that depends on missing data but names no MCAR/MAR/MNAR mechanism assumes one implicitly and is ill-formed (math:ImplicitMissingness)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/math/hasMissingnessIndicator> ?indicator .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/missingnessMechanism> ?mechanism . }
            }
        """ ;
    ] .

math:FormalVerificationResultShape
    a sh:NodeShape ;
    rdfs:label "Formal-verification-result grounding shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:FormalVerificationResult: it is grounded BY a separate gmeow:Observation carrying a gmeow:vantage (the checker's standpoint), through the inverse of gmeow:observationResult. The result object is not the held claim; a verification result stated as unconditional truth rather than a vantage-held verdict is ill-formed (math:UngroundedVerificationResult)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UngroundedVerificationResult ;
    sh:targetClass math:FormalVerificationResult ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:FormalVerificationResult must be grounded by a gmeow:Observation that names it through gmeow:observationResult and carries a gmeow:vantage; an unheld result is ill-formed (math:UngroundedVerificationResult)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    ?obs <https://blackcatinformatics.ca/gmeow/observationResult> $this .
                    ?obs <https://blackcatinformatics.ca/gmeow/vantage> ?vantage .
                }
            }
        """ ;
    ] .

# Rule — a theorem claim is not a truth bit: it carries a theory context and a
# proof or a declared external warrant.
math:TheoremGroundingShape
    a sh:NodeShape ;
    rdfs:label "Theorem grounding shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for math:Theorem: theorem-hood is not a truth bit read off the type. A theorem claim carries a theory context (math:roleInTheory, sh:minCount 1) AND either an in-graph math:Proof (some resource math:provesStatement it) or a declared math:externalWarrant. A bare `a math:Theorem` with no theory context, or a theorem with a theory context but neither a proof nor an external warrant, is ill-formed (math:UngroundedTheoremClaim)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UngroundedTheoremClaim ;
    sh:targetClass math:Theorem ;
    sh:property [
        sh:path math:roleInTheory ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:Theorem must carry a theory context through math:roleInTheory (the named, versioned theory its theorem-hood holds in); a bare theorem with no theory context is a truth-bit claim and is ill-formed (math:UngroundedTheoremClaim)." ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:Theorem must be warranted by either an in-graph math:Proof (some resource math:provesStatement it) or a declared math:externalWarrant; a theorem asserted with neither is an unwarranted truth-bit claim (math:UngroundedTheoremClaim)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { ?proof <https://blackcatinformatics.ca/math/provesStatement> $this . }
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/externalWarrant> ?warrant . }
            }
        """ ;
    ] .

# =========================================================================== #
# Flagship acceptance manifest — the slice's thin failure-range gate
#
# The acceptance-manifest vocabulary is hoisted to gmeow: (gmeow:FlagshipScenario), and
# its shared cardinality wiring (an example, competency, producer, counter-example, and
# enforcing class, each exactly once) is carried by the shared gmeow:FlagshipScenarioShape
# in shapes/gmeow-shapes.ttl. This slice contributes ONLY the failure-range check: that a
# gmeow:FlagshipScenario's gmeow:enforcesFailureClass names a math:MathConformanceFailure
# subclass — the slice-local part of the contract.
# =========================================================================== #

math:FlagshipScenarioShape
    a sh:NodeShape ;
    rdfs:label "Flagship scenario failure-range shape"@x-gmeow-english ;
    skos:definition "The math: slice's THIN failure-range gate for gmeow:FlagshipScenario: it checks only that the scenario's gmeow:enforcesFailureClass names a math:MathConformanceFailure subclass — the typed failure its counter-example raises. The shared cardinality wiring (an example, a competency, a producer, a counter-example, and an enforcing class, each exactly once) is carried by the shared gmeow:FlagshipScenarioShape in shapes/gmeow-shapes.ttl; this slice contributes only the slice-namespaced failure-range check."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnwiredFlagshipScenario ;
    sh:targetClass gmeow:FlagshipScenario ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A gmeow:FlagshipScenario's gmeow:enforcesFailureClass must name a math:MathConformanceFailure subclass — the typed failure its counter-example raises; naming a class that is not a conformance failure leaves the scenario unwired (math:UnwiredFlagshipScenario)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/enforcesFailureClass> ?fc .
                FILTER NOT EXISTS {
                    ?fc <http://www.w3.org/2000/01/rdf-schema#subClassOf>+ <https://blackcatinformatics.ca/math/MathConformanceFailure> .
                }
            }
        """ ;
    ] .

# =========================================================================== #
# Probability-layer gates (realizes design/MATHEMATICS-PROBABILITY.md and the   #
# Probability rules of design/MATHEMATICS-CONFORMANCE.md).                       #
# =========================================================================== #

# Rule P1 — a probability value's magnitude lies in the closed unit interval [0, 1].
math:ProbabilityValueRangeShape
    a sh:NodeShape ;
    rdfs:label "Probability-value range shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ProbabilityValue: any concrete gmeow:quantityValue it carries lies in the closed unit interval [0, 1]. A math:ProbabilityValue is a gmeow:Quantity (the core observations quantity, whose magnitude lives in gmeow:quantityValue — the property the charter's worked probability value uses), so the range is bounded on gmeow:quantityValue, not the separate math:quantityValue of a math:Quantity. A probability is ALWAYS in [0, 1]; a magnitude outside it is either ill-formed or a mis-typed odds/log-odds. Where a probability is exact it is carried as a math:RationalValue (num/den) and carries no decimal at all, so this range check is unguarded by cardinality — it bounds the literal when present, and the exact-rational numeric check is the separate native gate that pairs with it."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ProbabilityOutOfBounds ;
    sh:targetClass math:ProbabilityValue ;
    sh:property [
        sh:path gmeow:quantityValue ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ProbabilityValue's gmeow:quantityValue must lie in the closed unit interval [0, 1]; a magnitude outside it is ill-formed or a mis-typed odds/log-odds (math:ProbabilityOutOfBounds)." ;
    ] .

# Rule P2 — a probability value is never also an odds or log-odds value.
math:ProbabilityScaleDisjointShape
    a sh:NodeShape ;
    rdfs:label "Probability-scale disjointness shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ProbabilityValue: it is NOT also typed math:OddsValue or math:LogOddsValue. Odds and log-odds are probability-scale transforms, not probabilities, held owl:disjointWith math:ProbabilityValue by an OWL axiom; this paired SHACL surfaces the same conflation as a finding so a node typed both a probability and a lawful scale trips shacl.NotConstraintComponent instead of resting only on the DL gate."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ProbabilityScaleConflation ;
    sh:targetClass math:ProbabilityValue ;
    sh:not [ sh:class math:OddsValue ] ;
    sh:not [ sh:class math:LogOddsValue ] ;
    sh:severity sh:Violation ;
    sh:message "A math:ProbabilityValue must not also be a math:OddsValue or math:LogOddsValue — odds and log-odds are probability-scale transforms held disjoint from the closed unit interval; typing one as a probability conflates a lawful scale with a probability (math:ProbabilityScaleConflation)." .

# Rule P3 — a probability value names its reference frame or its probability model.
math:ProbabilityValueFramedShape
    a sh:NodeShape ;
    rdfs:label "Probability-value framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ProbabilityValue: it names its probability frame OR its probability model — at least one of gmeow:hasReferenceFrame (the reference frame the value is expressed in) or logic:probabilityModel (the model it is a probability under). A probability value is a framed quantity object, never a bare literal; a value contextualized only by its probability model still passes. The model-context path reuses the logic: vocabulary (logic:probabilityModel, the same edge the lang: sibling uses) verbatim rather than minting a math: near-synonym (Principle 17). Neither present trips shacl.OrConstraintComponent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnframedProbabilityValue ;
    sh:targetClass math:ProbabilityValue ;
    sh:or (
        [ sh:path gmeow:hasReferenceFrame ; sh:minCount 1 ]
        [ sh:path logic:probabilityModel ; sh:minCount 1 ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A math:ProbabilityValue must name its probability frame (gmeow:hasReferenceFrame) or its probability model (logic:probabilityModel); a probability that names neither is an unframed bare literal (math:UnframedProbabilityValue)." .

# Rule P4 — a probability space names all three components of the Kolmogorov triple.
math:ProbabilitySpaceCompleteShape
    a sh:NodeShape ;
    rdfs:label "Probability-space completeness shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ProbabilitySpace: it names each of the three components of the Kolmogorov triple (Ω, ℱ, P) — its sample space (math:sampleSpace), its event σ-algebra (math:eventSigmaAlgebra), and its probability measure (math:probabilityMeasure). Each component may be symbolic or generative, so the gate requires PRESENCE only (a named IRI, min one each) and does not over-constrain the class of the component; the OWL restriction carries the class obligation. A space missing any of the three is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IncompleteProbabilitySpace ;
    sh:targetClass math:ProbabilitySpace ;
    sh:property [
        sh:path math:sampleSpace ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:ProbabilitySpace must name its sample space Ω through math:sampleSpace (possibly symbolic or generative); a space missing it is ill-formed (math:IncompleteProbabilitySpace)." ;
    ] ;
    sh:property [
        sh:path math:eventSigmaAlgebra ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:ProbabilitySpace must name its event σ-algebra ℱ through math:eventSigmaAlgebra (possibly symbolic, e.g. a math:BorelSigmaAlgebra); a space missing it is ill-formed (math:IncompleteProbabilitySpace)." ;
    ] ;
    sh:property [
        sh:path math:probabilityMeasure ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A math:ProbabilitySpace must name its probability measure P through math:probabilityMeasure (possibly given by a math:MeasureDefinitionExpression); a space missing it is ill-formed (math:IncompleteProbabilitySpace)." ;
    ] .

# Rule P5 — a random variable declares its domain, codomain, and a space-or-distribution context.
math:RandomVariableScopedShape
    a sh:NodeShape ;
    rdfs:label "Random-variable scope shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:RandomVariable: it declares its domain (math:randomVariableDomain) and codomain (math:randomVariableCodomain), and carries a probability context — either a distribution (math:hasDistribution) or a domain that is itself a math:ProbabilitySpace. A random variable is a scoped measurable map; one missing its frame or its context is unscoped. The context arm is an sh:or so a variable whose domain IS a probability space needs no separate distribution, and vice versa."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnscopedRandomVariable ;
    sh:targetClass math:RandomVariable ;
    sh:property [
        sh:path math:randomVariableDomain ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:RandomVariable must declare its domain through math:randomVariableDomain — the measurable space it is defined on; a variable missing it is unscoped (math:UnscopedRandomVariable)." ;
    ] ;
    sh:property [
        sh:path math:randomVariableCodomain ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:RandomVariable must declare its codomain through math:randomVariableCodomain — the measurable space it maps into; a variable missing it is unscoped (math:UnscopedRandomVariable)." ;
    ] ;
    sh:or (
        [ sh:path math:hasDistribution ; sh:minCount 1 ]
        [ sh:path math:randomVariableDomain ; sh:qualifiedValueShape [ sh:class math:ProbabilitySpace ] ; sh:qualifiedMinCount 1 ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A math:RandomVariable must carry a probability context — a math:hasDistribution, or a math:randomVariableDomain that is itself a math:ProbabilitySpace; a variable with neither is unscoped (math:UnscopedRandomVariable)." .

# Rule P6a — a distribution names its family (pure sh:property, so the closed-world
# JSON-Schema projection builds a $defs/Distribution node; a shape carrying sh:sparql
# is skipped by that projection, so the family gate is kept in its own property shape).
math:DistributionFamilyShape
    a sh:NodeShape ;
    rdfs:label "Distribution family shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:Distribution: it names its math:distributionFamily — the parametric family (a math:DistributionFamily) it belongs to — the paired SHACL twin of the OWL family restriction. Authored as a pure sh:property shape (no sh:sparql) so the closed-world JSON-Schema projection builds a $defs/Distribution node from it; the parametric-parameterization check, which needs a query, is the separate math:DistributionParameterizationShape. A bare distribution with no family is underspecified (math:MissingDistributionParameterization)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:MissingDistributionParameterization ;
    sh:targetClass math:Distribution ;
    sh:property [
        sh:path math:distributionFamily ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class math:DistributionFamily ;
        sh:severity sh:Violation ;
        sh:message "A math:Distribution must name its math:distributionFamily — the parametric family (a math:DistributionFamily) it belongs to; a distribution missing its family is underspecified (math:MissingDistributionParameterization)." ;
    ] .

# Rule P6b — a parameter-supplying distribution names its parameterization (SHACL-SPARQL).
math:DistributionParameterizationShape
    a sh:NodeShape ;
    rdfs:label "Distribution parameterization shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint over math:Distribution: any distribution that SUPPLIES parameters (math:hasDistributionParameter) also names its math:distributionParameterization. There is no math:ParametricDistribution marker in the vocabulary, so parametricity is detected by the presence of supplied parameters rather than by a class or boolean: a distribution that supplies parameters is parametric and must declare which conventional form of its family those parameters fill, whereas a non-parametric distribution (no supplied parameters) is NOT rejected. This SHACL-SPARQL form is chosen precisely so the gate never misfires on a non-parametric distribution. A bare family label with parameters but no parameterization is ill-formed (math:MissingDistributionParameterization)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:MissingDistributionParameterization ;
    sh:targetClass math:Distribution ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:Distribution that supplies a math:hasDistributionParameter must name its math:distributionParameterization — the explicit convention fixing which parametric form of its family is meant; a supplied parameter with a silent default parameterization is ill-formed (math:MissingDistributionParameterization)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/math/hasDistributionParameter> ?param .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/distributionParameterization> ?parameterization . }
            }
        """ ;
    ] .

# Rule P7 — each role a parameterization requires is supplied exactly once.
math:ParameterRoleCardinalityConstraint
    a sh:NodeShape ;
    rdfs:label "Distribution parameter-role cardinality shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint over math:Distribution: each math:DistributionParameterRole that the distribution's math:distributionParameterization requires (math:requiresParameterRole) is supplied EXACTLY ONCE by the distribution's parameters (math:hasDistributionParameter → math:parameterRole). The aggregate query groups the supplied parameters per required role and fires when the count is zero (a role left unfilled) or two-or-more (a role filled twice), so any cardinality other than one trips shacl.SPARQLConstraintComponent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:DistributionParameterRoleCardinality ;
    sh:targetClass math:Distribution ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:Distribution must supply each math:DistributionParameterRole its math:distributionParameterization requires EXACTLY ONCE through math:hasDistributionParameter → math:parameterRole; a required role supplied zero times or more than once is ill-formed (math:DistributionParameterRoleCardinality)." ;
        sh:select """
            SELECT $this ?role (COUNT(DISTINCT ?param) AS ?supplied) WHERE {
                $this <https://blackcatinformatics.ca/math/distributionParameterization> ?parameterization .
                ?parameterization <https://blackcatinformatics.ca/math/requiresParameterRole> ?role .
                OPTIONAL {
                    $this <https://blackcatinformatics.ca/math/hasDistributionParameter> ?param .
                    ?param <https://blackcatinformatics.ca/math/parameterRole> ?role .
                }
            }
            GROUP BY $this ?role
            HAVING (COUNT(DISTINCT ?param) != 1)
        """ ;
    ] .

# Rule P8 — a conditional probability names the context it is conditioned on.
math:ConditionedAssertionShape
    a sh:NodeShape ;
    rdfs:label "Conditional-probability conditioning shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ConditionalProbability: it names its conditioning event or context through math:conditionalOn — the B in P(A | B). A conditional probability whose conditioning context is left implicit is ill-formed; the conditioning context is never assumed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnconditionedAssertion ;
    sh:targetClass math:ConditionalProbability ;
    sh:property [
        sh:path math:conditionalOn ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ConditionalProbability must name its conditioning event or context through math:conditionalOn — the B in P(A | B); a conditional with an unnamed conditioning context is ill-formed (math:UnconditionedAssertion)." ;
    ] .

# Rule P9 — a conditional-independence assertion names its conditioning set.
math:ConditionalIndependenceGivenShape
    a sh:NodeShape ;
    rdfs:label "Conditional-independence conditioning shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ConditionalIndependenceAssertion: it names its conditioning set through math:independentGiven — the C in A ⫫ B | C. A conditional-independence assertion that fails to name its conditioning set is ill-formed. Authored as a sibling of math:ConditionedAssertionShape (a distinct target class needing a distinct property path) so the two conditioning obligations do not collide on one node shape; both raise the same math:UnconditionedAssertion failure."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnconditionedAssertion ;
    sh:targetClass math:ConditionalIndependenceAssertion ;
    sh:property [
        sh:path math:independentGiven ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ConditionalIndependenceAssertion must name its conditioning set through math:independentGiven — the C in A ⫫ B | C; an assertion that leaves its conditioning set implicit is ill-formed (math:UnconditionedAssertion)." ;
    ] .

# Rule P10 — a probability value derived from a confidence declares its mapping.
math:ConfidenceAsProbabilityConstraint
    a sh:NodeShape ;
    rdfs:label "Confidence-as-probability shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint over math:ProbabilityValue: a probability value that carries a logic:confidence (a confidence score read as its magnitude) must declare a probability model through logic:probabilityModel — the declared mapping that turns a confidence into a probability. The logic: probability/confidence boundary is enforced, not eroded: a confidence annotation is never silently read as a probability, so a math:ProbabilityValue carrying logic:confidence with no declared logic:probabilityModel fires. This mirrors the lang: sibling (lang:ConfidenceNotProbabilityShape) verbatim, reusing the logic: vocabulary rather than minting a math: near-synonym. Absent both a confidence source and a model the shape is silent; it fires only on the conflation."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ConfidenceAsProbability ;
    sh:targetClass math:ProbabilityValue ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:ProbabilityValue that carries a logic:confidence must declare a logic:probabilityModel — the mapping from confidence to probability; a probability derived from a confidence score with no declared mapping erodes the probability/confidence boundary and is ill-formed (math:ConfidenceAsProbability)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this <https://blackcatinformatics.ca/logic/confidence> ?confidence .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/probabilityModel> ?model . }
            }
        """ ;
    ] .

# Rule P11 — a probability event (set of outcomes) is not an occurrent (logic:Event).
math:ProbabilityEventOccurrentDisjointShape
    a sh:NodeShape ;
    rdfs:label "Probability-event occurrent-disjointness shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ProbabilityEvent: it is NOT also typed logic:Event. A math:ProbabilityEvent is the measure-theoretic sense (a measurable set of outcomes); a logic:Event is an occurrent (something that happens in time). The two are held owl:disjointWith by an OWL axiom so a rain occurrence and the rain event-set are never conflated; this paired SHACL surfaces the same conflation as a finding so a node typed both trips shacl.NotConstraintComponent instead of resting only on the DL gate."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:ProbabilityEventOccurrentConflation ;
    sh:targetClass math:ProbabilityEvent ;
    sh:not [ sh:class logic:Event ] ;
    sh:severity sh:Violation ;
    sh:message "A math:ProbabilityEvent (a measurable set of outcomes) must not also be a logic:Event (an occurrent); typing one node as both conflates the event-set with the occurrence (math:ProbabilityEventOccurrentConflation)." .

# =========================================================================== #
# Statistical-inference gates — the p-value framing rules (shapes for the
# "Inference and results" charter section). A math:PValue is unambiguous only
# when it carries its test, null hypothesis, test statistic, null distribution,
# and a tail/sidedness; a bogus sidedness value is also an ill-framed p-value.
# =========================================================================== #

# Rule I1 — a p-value carries its full frame (test, null hypothesis, test
# statistic, null distribution, and a tail-or-sidedness). Authored as SHACL-SPARQL
# because the "test" and "tail-or-sidedness" arms are disjunctions over distinct
# paths (a missing arm fires, so a p-value with a null and a statistic but no tail
# or sidedness is still caught).
math:IllFramedPValueShape
    a sh:NodeShape ;
    rdfs:label "Ill-framed p-value shape"@x-gmeow-english ;
    skos:definition "SHACL-SPARQL constraint over math:PValue: a p-value carries the whole frame that makes P(T ≥ t | H0) well-defined — a test (a math:testStatistic, and/or the math:HypothesisTest whose math:pValue it is), a math:nullHypothesis, a math:nullDistribution, and a tail-or-sidedness (a math:tailDefinition OR a math:alternativeSidedness). The select fires when ANY arm is missing, so a p-value with a null and a statistic but no tail or sidedness is still caught as ambiguous — because whether the extremity is one-tailed, two-tailed, or mid-p changes the value. A missing arm trips shacl.SPARQLConstraintComponent (math:IllFramedPValue)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IllFramedPValue ;
    sh:targetClass math:PValue ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A math:PValue must carry its test (a math:testStatistic or the math:HypothesisTest whose math:pValue it is), its math:nullHypothesis, its math:nullDistribution, and a math:tailDefinition or math:alternativeSidedness; a p-value missing any of these is ambiguous and ill-formed (math:IllFramedPValue)." ;
        sh:select """
            SELECT DISTINCT $this WHERE {
                $this a <https://blackcatinformatics.ca/math/PValue> .
                FILTER (
                    (
                        NOT EXISTS { $this <https://blackcatinformatics.ca/math/testStatistic> ?anyTestStat . }
                        && NOT EXISTS { ?test a <https://blackcatinformatics.ca/math/HypothesisTest> ; <https://blackcatinformatics.ca/math/pValue> $this . }
                    )
                    || NOT EXISTS { $this <https://blackcatinformatics.ca/math/nullHypothesis> ?nullHyp . }
                    || NOT EXISTS { $this <https://blackcatinformatics.ca/math/nullDistribution> ?nullDist . }
                    || (
                        NOT EXISTS { $this <https://blackcatinformatics.ca/math/tailDefinition> ?tailDef . }
                        && NOT EXISTS { $this <https://blackcatinformatics.ca/math/alternativeSidedness> ?sidedness . }
                    )
                )
            }
        """ ;
    ] .

# Rule I2 — a p-value's math:alternativeSidedness, when present, is one of the six
# lawful math:Sidedness individuals. SHACL-Core sh:in, so a bogus sidedness value
# trips shacl.InConstraintComponent; the constraint is vacuously satisfied when the
# property is absent (the SPARQL gate above handles a missing tail/sidedness).
math:AlternativeSidednessValueShape
    a sh:NodeShape ;
    rdfs:label "Alternative-sidedness value shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:PValue: any math:alternativeSidedness it carries is one of the six closed math:Sidedness values (math:oneSidedAlternative, math:twoSidedAlternative, math:greaterAlternative, math:lessAlternative, math:exactTail, math:midPTail). Authored as a pure sh:property shape with sh:in, so a bogus sidedness value trips shacl.InConstraintComponent; a p-value that omits math:alternativeSidedness altogether satisfies this shape vacuously (the missing-tail/sidedness case is caught by math:IllFramedPValueShape). A sidedness outside the six is also an ill-framed p-value (math:IllFramedPValue)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IllFramedPValue ;
    sh:targetClass math:PValue ;
    sh:property [
        sh:path math:alternativeSidedness ;
        sh:in ( math:oneSidedAlternative math:twoSidedAlternative math:greaterAlternative math:lessAlternative math:exactTail math:midPTail ) ;
        sh:severity sh:Violation ;
        sh:message "A math:PValue's math:alternativeSidedness must be one of the six lawful math:Sidedness values (one-sided, two-sided, greater, less, exact, mid-p); a value outside them is not a lawful sidedness and marks the p-value ill-framed (math:IllFramedPValue)." ;
    ] .

# =========================================================================== #
# Interval, region, and effect-size gates — the rest of the "Inference and
# results" charter section. A confidence interval carries its bounds and level;
# a credible interval carries its posterior and mass; a node typed both a
# confidence and a credible interval conflates frequentist coverage with
# posterior mass (paired SHACL over the entailed paradigm disjointness); an
# effect size identifies its contrast, scale, and frame.
# =========================================================================== #

# Rule I3 — a confidence interval is never also a credible interval. The OWL
# disjointness is ENTAILED by the paradigm parents (math:ConfidenceInterval ⊑
# math:FrequentistResult, math:CredibleInterval ⊑ math:BayesianResult,
# math:FrequentistResult owl:disjointWith math:BayesianResult); this paired SHACL
# surfaces the same conflation as a finding so a both-typed node trips
# shacl.NotConstraintComponent instead of resting only on the DL gate.
math:IntervalKindConflationShape
    a sh:NodeShape ;
    rdfs:label "Interval-kind conflation shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ConfidenceInterval: it is NOT also typed math:CredibleInterval. A confidence interval's level is frequentist coverage under a sampling procedure; a credible interval's mass is a Bayesian posterior probability — they share the word 'interval' and nothing else, held owl:disjointWith THROUGH their paradigm parents (math:ConfidenceInterval ⊑ math:FrequentistResult, math:CredibleInterval ⊑ math:BayesianResult, math:FrequentistResult owl:disjointWith math:BayesianResult). This paired SHACL surfaces the same conflation as a finding so a node typed both trips shacl.NotConstraintComponent instead of resting only on the DL gate."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IntervalKindConflation ;
    sh:targetClass math:ConfidenceInterval ;
    sh:not [ sh:class math:CredibleInterval ] ;
    sh:severity sh:Violation ;
    sh:message "A math:ConfidenceInterval must not also be a math:CredibleInterval — frequentist coverage and Bayesian posterior mass are different result kinds held disjoint through their paradigm parents; typing one node as both conflates them (math:IntervalKindConflation)." .

# Rule I4 — a confidence interval carries its bounds and its confidence level.
math:IncompleteConfidenceIntervalShape
    a sh:NodeShape ;
    rdfs:label "Confidence-interval completeness shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ConfidenceInterval: it names its two bounds through math:hasIntervalBound (a two-sided interval carries its lower AND its upper endpoint, so min two) and its coverage through math:confidenceLevel (a framed math:ProbabilityValue over the sampling procedure, min one). The bound cardinality is authored as sh:minCount 2 — the cleanest expression of 'a lower and an upper endpoint' — so a one-endpoint or endpoint-less interval trips shacl.MinCountConstraintComponent, and an interval naming no level trips it too. A confidence interval missing its bounds or its level is a bare pair of numbers, not a coverage statement (math:IncompleteConfidenceInterval)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IncompleteConfidenceInterval ;
    sh:targetClass math:ConfidenceInterval ;
    sh:property [
        sh:path math:hasIntervalBound ;
        sh:minCount 2 ;
        sh:severity sh:Violation ;
        sh:message "A math:ConfidenceInterval must name its two bounds through math:hasIntervalBound — its lower AND its upper endpoint (sh:minCount 2); an interval missing a bound is ill-formed (math:IncompleteConfidenceInterval)." ;
    ] ;
    sh:property [
        sh:path math:confidenceLevel ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ConfidenceInterval must name its coverage through math:confidenceLevel — a framed math:ProbabilityValue over the sampling procedure (sh:minCount 1); an interval with no confidence level is not a coverage statement (math:IncompleteConfidenceInterval)." ;
    ] .

# Rule I5 — a credible interval carries its posterior context and its credible mass.
math:IncompleteCredibleIntervalShape
    a sh:NodeShape ;
    rdfs:label "Credible-interval completeness shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:CredibleInterval: it names its posterior context through math:hasPosterior (the math:PosteriorDistribution it summarizes, min one) and its posterior mass through math:credibleMass (a framed math:ProbabilityValue over that posterior, min one). A credible interval's mass is a probability OVER a posterior, so both the posterior and the mass are required; an interval missing either trips shacl.MinCountConstraintComponent. A credible interval with no posterior or no credible mass cannot state a posterior probability that the parameter lies within it (math:IncompleteCredibleInterval)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:IncompleteCredibleInterval ;
    sh:targetClass math:CredibleInterval ;
    sh:property [
        sh:path math:hasPosterior ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:CredibleInterval must name its posterior context through math:hasPosterior — the math:PosteriorDistribution it summarizes (sh:minCount 1); an interval with no posterior cannot carry a posterior mass (math:IncompleteCredibleInterval)." ;
    ] ;
    sh:property [
        sh:path math:credibleMass ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:CredibleInterval must name its posterior mass through math:credibleMass — a framed math:ProbabilityValue over its posterior (sh:minCount 1); an interval with no credible mass is not a posterior-probability statement (math:IncompleteCredibleInterval)." ;
    ] .

# Rule I6 — an effect size identifies its contrast, its scale, and its frame.
math:UnframedEffectSizeShape
    a sh:NodeShape ;
    rdfs:label "Effect-size framing shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:EffectSize: it identifies all three of the frame that makes its magnitude interpretable — the comparison it measures through math:effectSizeContrast (the SAME shared math:StatisticalContrast an estimand targets, min one), the scale it is expressed on through math:effectSizeScale (a math:MeasurementScale, min one), and its reference frame through gmeow:hasReferenceFrame (the house frame predicate, the same edge a math:ProbabilityValue is framed by, min one). Any of the three absent trips shacl.MinCountConstraintComponent; an effect size missing its contrast, scale, or frame is an uninterpretable bare number (math:UnframedEffectSize)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnframedEffectSize ;
    sh:targetClass math:EffectSize ;
    sh:property [
        sh:path math:effectSizeContrast ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:EffectSize must name the comparison it measures through math:effectSizeContrast — the shared math:StatisticalContrast (sh:minCount 1); an effect size with no contrast has no comparison it is the magnitude of (math:UnframedEffectSize)." ;
    ] ;
    sh:property [
        sh:path math:effectSizeScale ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:EffectSize must name the scale it is expressed on through math:effectSizeScale — a math:MeasurementScale (sh:minCount 1); an effect size with no scale is a magnitude with no units of comparison (math:UnframedEffectSize)." ;
    ] ;
    sh:property [
        sh:path gmeow:hasReferenceFrame ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:EffectSize must name its reference frame through gmeow:hasReferenceFrame — the house frame predicate the value is expressed in (sh:minCount 1); an effect size with no frame is an unframed bare number (math:UnframedEffectSize)." ;
    ] .

# =========================================================================== #
# Diagnostics, model comparison, and calibration — the model-evaluation layer  #
# (STATISTICS-charter "Model comparison and calibration")                      #
# =========================================================================== #

# Rule D1 — a model diagnostic anchors itself to its fitted model and its method.
math:UnanchoredDiagnosticShape
    a sh:NodeShape ;
    rdfs:label "Model-diagnostic anchoring shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:ModelDiagnostic: it names the math:FittedModel it evaluates through math:diagnosticFor (min one) AND the method it applies through math:diagnosticMethod (min one). A diagnostic is an evaluation OF a fit BY a method; either absent trips shacl.MinCountConstraintComponent. A diagnostic missing its fitted model or its method is a floating number rather than a checked property of a model (math:UnanchoredDiagnostic)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:UnanchoredDiagnostic ;
    sh:targetClass math:ModelDiagnostic ;
    sh:property [
        sh:path math:diagnosticFor ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ModelDiagnostic must name the math:FittedModel it evaluates through math:diagnosticFor (sh:minCount 1); a diagnostic anchored to no fit is ill-formed (math:UnanchoredDiagnostic)." ;
    ] ;
    sh:property [
        sh:path math:diagnosticMethod ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A math:ModelDiagnostic must name the method it applies through math:diagnosticMethod (sh:minCount 1); a diagnostic with no method is ill-formed (math:UnanchoredDiagnostic)." ;
    ] .

# Rule D2 — a statistical calibration diagnostic is never a topological stability
# calibration record. The two senses of "calibration" share the word and nothing
# else; because math:CalibrationDiagnostic ⊑ math:ModelDiagnostic and
# math:StabilityCalibrationRecord both descend from math:MathematicalObject, the
# disjointness is NOT entailed by their parents and is asserted DIRECTLY
# (math:CalibrationDiagnostic owl:disjointWith math:StabilityCalibrationRecord);
# this paired SHACL surfaces the same conflation as a finding so a both-typed node
# trips shacl.NotConstraintComponent instead of resting only on the DL gate.
math:CalibrationSenseConflationShape
    a sh:NodeShape ;
    rdfs:label "Calibration-sense conflation shape"@x-gmeow-english ;
    skos:definition "SHACL constraint for math:CalibrationDiagnostic: it is NOT also typed math:StabilityCalibrationRecord. A math:CalibrationDiagnostic is the STATISTICAL sense (a model's predicted probabilities against observed frequencies); a math:StabilityCalibrationRecord is the TOPOLOGICAL sense (a credence calibrated against a bottleneck stability bound over a math:PersistenceLifetime) — they share the word 'calibration' and nothing else, held owl:disjointWith by a DIRECT axiom (both descend from math:MathematicalObject, so the disjointness is not entailed by their parents). This paired SHACL surfaces the same conflation as a finding so a node typed both trips shacl.NotConstraintComponent instead of resting only on the DL gate."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:enforcesFailureClass math:CalibrationSenseConflation ;
    sh:targetClass math:CalibrationDiagnostic ;
    sh:not [ sh:class math:StabilityCalibrationRecord ] ;
    sh:severity sh:Violation ;
    sh:message "A math:CalibrationDiagnostic must not also be a math:StabilityCalibrationRecord — the statistical calibration sense and the topological stability-calibration sense share the word 'calibration' and nothing else, held disjoint by a direct axiom; typing one node as both conflates them (math:CalibrationSenseConflation)." .
