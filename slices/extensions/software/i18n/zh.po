msgstr "来源记录受 gmeow:ParentSequenceCommitScopeConstraint 约束。"


msgctxt "https://blackcatinformatics.ca/gmeow/TaggerIdentityHasTimeConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating TaggerIdentityHasTimeConstraint as a traversal, hashing or Git execution certificate."
