#
# Declarative structural assertions for the archaeological-evidence slice —
# the slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_archaeological_evidence.py. Each assertion
# runs as a SPARQL ASK over the archaeological-evidence module graph
# (gmeow:scopeModule) under the native Rust slicetest harness (crates/slicetest).
#
# Archaeological-evidence is migrated: class stereotypes are logic:
# (logic:Kind, logic:SubKind, logic:AbstractIndividualType, logic:QualityValue,
# logic:Relator), not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_attested_on_carrier_exists — asserts gmeow:attestedOnCarrier, whose
#     subject is defined in slices/extensions/lexicon/module.ttl, not in the
#     archaeological-evidence module; a scopeModule cell would silently miss it.
#   test_no_primary_or_preferred_archaeological_terms — dynamically sweeps the
#     entire merged graph's subject set for any GMEOW-prefixed term whose local
#     name begins with "primary" or "preferred"; module-scoped would silently
#     narrow this whole-ontology regression guard to one graph.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest->DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/archaeological-evidence/tests/> .

# --- 1. Inscription is an owl:Class subclass of InformationObject (MUST) --------
ex:saInscriptionIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Inscription a owl:Class ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:Inscription MUST be an owl:Class and a subclass of gmeow:InformationObject — the sign-bearing content is informationally distinct from its physical carrier. Mirrors test_inscription_is_information_object." .

# --- 2. InscriptionReading is an owl:Class, subClassOf Observation and logic:Relator (MUST) ---
ex:saInscriptionReadingIsObservationRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:InscriptionReading a owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:InscriptionReading MUST be an owl:Class, a subclass of gmeow:Observation, and a subclass of logic:Relator — a scholarly reading is a standpoint-scoped observation that binds inscription and interpreter (Observation+Relator pattern). Mirrors test_inscription_reading_is_observation_relator." .

# --- 3. InscriptionTransliteration is an owl:Class, subClassOf Observation and logic:Relator (MUST) ---
ex:saInscriptionTransliterationIsObservationRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:InscriptionTransliteration a owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:InscriptionTransliteration MUST be an owl:Class, a subclass of gmeow:Observation, and a subclass of logic:Relator — competing transliteration schemes coexist without a single winner (Principle 9). Mirrors test_inscription_transliteration_is_observation_relator." .

# --- 4. InscriptionTranslation is an owl:Class, subClassOf Observation and logic:Relator (MUST) ---
ex:saInscriptionTranslationIsObservationRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:InscriptionTranslation a owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:InscriptionTranslation MUST be an owl:Class, a subclass of gmeow:Observation, and a subclass of logic:Relator — competing translations coexist without privilege (Principle 9). Mirrors test_inscription_translation_is_observation_relator." .

# --- 5. ScriptLanguageAttribution is an owl:Class, subClassOf Observation and logic:Relator (MUST) ---
ex:saScriptLanguageAttributionIsObservationRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ScriptLanguageAttribution a owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:ScriptLanguageAttribution MUST be an owl:Class, a subclass of gmeow:Observation, and a subclass of logic:Relator — disputed, uncertain, and undeciphered cases produce competing attributions that coexist (Principle 9). Mirrors test_script_language_attribution_is_observation_relator." .

# --- 6. ArchaeologicalFindContext is an owl:Class, subClassOf Observation and logic:Relator (MUST) ---
ex:saArchaeologicalFindContextIsObservationRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ArchaeologicalFindContext a owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:ArchaeologicalFindContext MUST be an owl:Class, a subclass of gmeow:Observation, and a subclass of logic:Relator — a reified find context binding a carrier to its stratigraphic unit; multiple context claims from different campaigns coexist (Principle 9). Mirrors test_archaeological_find_context_is_observation_relator." .

# --- 7. inscriptionCarrier is functional (MUST) ---------------------------------
ex:saInscriptionCarrierIsFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:inscriptionCarrier a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:inscriptionCarrier MUST be owl:FunctionalProperty — an inscription is borne by exactly one carrier; a copy on another carrier is a distinct Inscription instance. Mirrors test_inscription_carrier_is_functional." .

# --- 8. carrierInscription is an owl:ObjectProperty (MUST) ----------------------
ex:saCarrierInscriptionIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:carrierInscription a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:carrierInscription MUST be an owl:ObjectProperty — the inverse of inscriptionCarrier, linking a carrier to the inscription(s) it bears. Mirrors test_carrier_inscription_is_non_functional (positive part)." .

# --- 9. carrierInscription is NOT functional (MUST-NOT) -----------------------
ex:saCarrierInscriptionNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:carrierInscription a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:carrierInscription MUST NOT be owl:FunctionalProperty — a carrier may bear multiple inscriptions (e.g. tablet with text on both sides, or a wall with successive graffiti layers). Mirrors test_carrier_inscription_is_non_functional (negative part)." .

