#
# Competency: which candidates are judged a comparable TIE? Over the tie-cell pass scene this
# returns exactly the one preferentially-equivalent pair, proving a tie is a first-class,
# positively-asserted verdict (gmeow:preferentiallyEquivalentWith), distinct from a positive
# incomparability and from an absent edge.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
SELECT ?a ?b WHERE {
    ?a gmeow:preferentiallyEquivalentWith ?b .
}
ORDER BY ?a ?b
