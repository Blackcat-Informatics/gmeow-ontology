# --- Ordered intervals → Wikidata / OpenMath ------------------------------- #

gmeow:eqMathIntervalWd a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject math:Interval ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q185148 ;
    logic:sourceEndpoint math:Interval ; logic:targetEndpoint wd:Q185148 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "interval" ;
    gmeow:comment "math:Interval is the ordered real interval { x ∈ ℝ̄ | lower ⋚ x ⋚ upper }; wd:Q185148 (interval, 'subset of an ordered set consisting of all elements between two given endpoints') names the same order-theoretic concept. closeMatch, not identity: the GMEOW class is the specialization over the extended real line carrying its endpoints and both endpoint inclusions, a close but non-invertible counterpart of the general ordered-set concept." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

gmeow:eqMathIntervalOM a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject math:Interval ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://openmath.org/cd/interval1.xhtml> ;
    logic:sourceEndpoint math:Interval ; logic:targetEndpoint <https://openmath.org/cd/interval1.xhtml> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "OpenMath interval1 (ordered intervals)" ;
    gmeow:comment "The OpenMath interval1 content-dictionary page collects several distinct symbols — interval, interval_cc, interval_oo, interval_oc, and interval_co — while math:Interval represents their shared ordered-interval family with explicit endpoint inclusion. No one symbol uniquely denotes the class, so the page is only a related resource." ;
    gmeow:sssomFile "gmeow-openmath.sssom.tsv" ;
    logic:morphismClass logic:BridgeView ; logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly .

# --- Arithmetic operators → OpenMath (content-dictionary symbols) ----------- #
# Each arithmetic operator individual denotes the same operation as its OpenMath
# content-dictionary symbol (arith1 for the algebraic operators, transc1 for the
# logarithm). closeMatch to the canonical symbol IRI declared by the official
# content dictionary: the GMEOW individual carries a math: signature over number
# systems the bare CD symbol does not, so the correspondence is close, not
# invertible identity. The slice previously anchored these in prose only.

gmeow:eqMathAdditionOM a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject math:Addition ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject <http://www.openmath.org/cd/arith1#plus> ;
    logic:sourceEndpoint math:Addition ; logic:targetEndpoint <http://www.openmath.org/cd/arith1#plus> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "OpenMath arith1 plus" ;
    gmeow:comment "math:Addition is the binary addition operator (+); OpenMath arith1#plus is its verified canonical content-dictionary symbol IRI. closeMatch because the GMEOW operator also carries an explicit mathematical signature." ;
    gmeow:sssomFile "gmeow-openmath.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

