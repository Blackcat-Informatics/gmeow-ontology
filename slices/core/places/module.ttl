gmeow:frameKindLinearSequence rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:metricGeodesic     a gmeow:MetricKind ; rdfs:label "geodesic"@x-gmeow-english ;
    skos:definition "Shortest path along a curved surface (e.g. great-circle on a spheroid)."@x-gmeow-english .
gmeow:metricGeodesic rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:metricEuclidean   a gmeow:MetricKind ; rdfs:label "Euclidean"@x-gmeow-english ;
    skos:definition "Straight-line distance in a Cartesian or flat space."@x-gmeow-english .
gmeow:metricEuclidean rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:metricCosine      a gmeow:MetricKind ; rdfs:label "cosine similarity"@x-gmeow-english ;
    skos:definition "Angular proximity in a latent vector space (1 − cosine distance)."@x-gmeow-english .
gmeow:metricCosine rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:metricEditDistance a gmeow:MetricKind ; rdfs:label "edit distance"@x-gmeow-english ;
    skos:definition "String or sequence dissimilarity (Levenshtein, Hamming, Damerau-Levenshtein, etc.)."@x-gmeow-english .
gmeow:metricEditDistance rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

gmeow:metricPositionalDistance a gmeow:MetricKind ; rdfs:label "positional distance"@x-gmeow-english ;
    skos:definition "Absolute difference between coordinates on a linear 1-D frame (base pairs, amino-acid residues, sequence indices). Interval length (|end - start| + 1 for inclusive ranges) is a distinct metric."@x-gmeow-english .
gmeow:metricPositionalDistance rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:metricGraphHops   a gmeow:MetricKind ; rdfs:label "graph hops"@x-gmeow-english ;
    skos:definition "Shortest-path edge count in a network or graph."@x-gmeow-english .
gmeow:metricGraphHops rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:metricSymplectic  a gmeow:MetricKind ; rdfs:label "phase-space Euclidean"@x-gmeow-english ;
    skos:definition "Standard Euclidean distance metric on a finite-dimensional Hamiltonian phase space, treating the concatenated (q,p) state vector as a point in ℝ²ⁿ."@x-gmeow-english .

# Seeds for GranularityLevel — the spatial resolution axis (#79; class in core).
# Ordered coarse→fine by gmeow:coarserThan (transitive, so country is coarser than
# every finer level). Aligned by reference to gmeow:placeType (the place kind at
# that level) and, through it, to ISO 19112 LocationType / gazetteer tiers.
gmeow:metricSymplectic rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:granularityCountry a gmeow:GranularityLevel ; rdfs:label "country level"@x-gmeow-english ;
    gmeow:coarserThan gmeow:granularityRegion ; skos:closeMatch gmeow:placeTypeCountry .
gmeow:granularityCountry skos:definition "The country granularity level — a resolution at which a value may be disclosed or coarsened (Principle 10)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:granularityRegion  a gmeow:GranularityLevel ; rdfs:label "region level"@x-gmeow-english ;
    gmeow:coarserThan gmeow:granularityCity ; skos:closeMatch gmeow:placeTypeRegion .
gmeow:granularityRegion skos:definition "The region granularity level — a resolution at which a value may be disclosed or coarsened (Principle 10)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:granularityCity    a gmeow:GranularityLevel ; rdfs:label "city level"@x-gmeow-english ;
    gmeow:coarserThan gmeow:granularityAddress ; skos:closeMatch gmeow:placeTypeCity .
gmeow:granularityCity skos:definition "The city granularity level — a resolution at which a value may be disclosed or coarsened (Principle 10)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:granularityAddress a gmeow:GranularityLevel ; rdfs:label "address level"@x-gmeow-english ;
    gmeow:coarserThan gmeow:granularityPoint ; skos:closeMatch gmeow:placeTypePremises .
gmeow:granularityAddress skos:definition "The address granularity level — a resolution at which a value may be disclosed or coarsened (Principle 10)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .
gmeow:granularityPoint   a gmeow:GranularityLevel ; rdfs:label "point / exact coordinate level"@x-gmeow-english .

