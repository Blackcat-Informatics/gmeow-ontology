#
# Counter-example for the canonical math:MathematicalConstant restrictions:
# the situated, exact constant carries a forbidden direct quantityValue literal.
# The registered cell selects math:ConstantAsDecimalLiteral class isolation:
# it requires a matching finding and rejects findings of other classes, without
# additionally enforcing the declared component/source-shape fields or a sole
# finding count. This header records the source contract, not an executed verdict.
# Bound by tests/example-conformance.ttl (ex:ecConstantAsDecimal).
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <http://example.org/math/> .

ex:constantAsDecimal a math:MathematicalConstant ;
    math:inNumberSystem math:realNumbers ;
    math:isExact true ;
    math:quantityValue "3.14159"^^xsd:double .
