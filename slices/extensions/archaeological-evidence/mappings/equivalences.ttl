@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmarc: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix crmsci: <http://www.cidoc-crm.org/extensions/crmsci/> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix oa: <http://www.w3.org/ns/oa#> .

# Term equivalences for archaeological and cultural-heritage evidence — GMEOW authoring source.
# Compiled to mappings/gmeow-archaeological-evidence.sssom.tsv by `gmeow compile-mappings`.
# Aligns CIDOC-CRM E34/E19, CRMarchaeo, CRMsci S4, CRMinf I1/I2, PROV-O, and Web Annotation.

gmeow:mapsetArchaeologicalEvidence a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/archaeological-evidence" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Archaeological evidence alignments: CIDOC-CRM E34 Inscription, E19 Physical Object, CRMsci S4 Observation, CRMinf I1 Argumentation / I2 Belief, PROV-O Activity, and Web Annotation. The gmeow:InscriptionReading, InscriptionTransliteration, InscriptionTranslation, ScriptLanguageAttribution, and ArchaeologicalFindContext are all Observation subclasses; they align to CRM E13 Attribute Assignment and CRMsci S4 Observation at the superclass level (see equivalences/observations.ttl). This file adds the domain-specific term alignments." .

# --------------------------------------------------------------------------- #
# CIDOC-CRM
# --------------------------------------------------------------------------- #

gmeow:Inscription skos:closeMatch crm:E34_Inscription {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "CIDOC-CRM E34 is the closest term for a sign-bearing information object. GMEOW Inscription is broader than E34 (covers marks, symbols, and non-linguistic signs) and is explicitly an InformationObject, not a Man-Made Thing."
|} .

gmeow:PhysicalObject skos:closeMatch crm:E19_Physical_Object {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "GMEOW PhysicalObject is the material carrier; E19 is the closest CRM class. E24 Physical Human-Made Thing is a narrower match when the object is known to be human-made."
|} .

gmeow:inscriptionCarrier skos:closeMatch crm:P128i_is_carried_by {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "crm:P128i is carried by (information): the inscription is carried by the physical object."
|} .

gmeow:carrierInscription skos:closeMatch crm:P128_carries {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "crm:P128 carries (information): the physical object carries the inscription."
|} .

# --------------------------------------------------------------------------- #
# CRMarchaeo
# --------------------------------------------------------------------------- #

gmeow:ArchaeologicalFindContext skos:closeMatch crmarc:A2_Stratigraphic_Volume_Unit {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "CRMarchaeo A2 is the stratigraphic volume unit; GMEOW ArchaeologicalFindContext is an Observation relator that binds carrier, place, stratigraphy, dating, and event. The match is loose because A2 is a spatial-stratigraphic entity, while ArchaeologicalFindContext is a claim/observation about that entity."
|} .

gmeow:findContextStratigraphy skos:closeMatch crmarc:A2_Stratigraphic_Volume_Unit {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "The stratigraphic unit referenced by findContextStratigraphy aligns to CRMarchaeo A2 when the unit is modeled in CRMarchaeo."
|} .

# --------------------------------------------------------------------------- #
# CRMsci
# --------------------------------------------------------------------------- #

gmeow:InscriptionReading skos:closeMatch crmsci:S4_Observation {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "CRMsci S4 Observation covers scientific observations including archaeological readings. The alignment is at the superclass level: InscriptionReading is a domain-specific Observation."
|} .

gmeow:InscriptionTransliteration skos:closeMatch crmsci:S4_Observation {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:InscriptionTranslation skos:closeMatch crmsci:S4_Observation {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

# --------------------------------------------------------------------------- #
# CRMinf
# --------------------------------------------------------------------------- #

gmeow:ScriptLanguageAttribution skos:closeMatch crminf:I1_Argumentation {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "CRMinf I1 Argumentation is the closest term for a scholarly claim assigning language/script to an inscription. The ScriptLanguageAttribution also aligns to I5 Inference Making when the classification is inferred from palaeographic evidence."
|} .

gmeow:ScriptLanguageAttribution skos:closeMatch crminf:I5_Inference_Making {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "When the language/script attribution is inferred from evidence (palaeography, stratigraphy, etc.), it is an instance of I5 Inference Making."
|} .

# --------------------------------------------------------------------------- #
# PROV-O
# --------------------------------------------------------------------------- #

gmeow:InscriptionReading skos:closeMatch prov:Activity {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "A scholarly reading is an Activity in PROV-O terms: an agent performs it, it has a start/end, and it generates a result (the LexicalForm)."
|} .

gmeow:readingResult skos:closeMatch prov:generated {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "The lexical form produced by a reading is generated by the reading activity."
|} .

# --------------------------------------------------------------------------- #
# Web Annotation (OA)
# --------------------------------------------------------------------------- #

gmeow:InscriptionReading skos:closeMatch oa:Annotation {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "A scholarly reading can be modeled as a Web Annotation: the inscription is the target, the LexicalForm is the body, and the scholar is the creator. This is a lossy projection (standpoint, confidence, and determinacy are dropped)."
|} .

gmeow:InscriptionTransliteration skos:closeMatch oa:Annotation {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75
|} .

gmeow:InscriptionTranslation skos:closeMatch oa:Annotation {|
    gmeow:sssomFile "gmeow-archaeological-evidence.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75
|} .
