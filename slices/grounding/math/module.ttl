    gmeow:enforcesFailureClass math:IncompleteHodgeDecomposition .

# Combinatorial-Laplacian coverage family: a degree-k combinatorial (graph/cell)
# Laplacian is defined only relative to a complete, declared frame — the cell
# complex it is built over, its degree k, and BOTH the up (degree-(k+1)) and down
# (degree-k) boundary operators whose adjoint compositions L_k = ∂_{k+1}∘∂_{k+1}*
# + ∂_k*∘∂_k assemble it. Every obligation is a qualified-cardinality +
# allValuesFrom OWL restriction (EL-safe) that derives the paired
# sh:minCount/maxCount + sh:class property shape; a missing complex, degree, or
# either boundary operator fails the derived QualifiedMinCount and isolates
# math:IncompleteCombinatorialLaplacian.
math:CombinatorialLaplacian logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:combinatorialLaplacianComplex ; owl:minQualifiedCardinality 1 ; owl:onClass math:CellComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:combinatorialLaplacianComplex ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CellComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:combinatorialLaplacianComplex ; owl:allValuesFrom math:CellComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:laplacianDegree ; owl:minQualifiedCardinality 1 ; owl:onClass math:NaturalNumber ] ,
    [ a owl:Restriction ; owl:onProperty math:laplacianDegree ; owl:maxQualifiedCardinality 1 ; owl:onClass math:NaturalNumber ] ,
    [ a owl:Restriction ; owl:onProperty math:laplacianDegree ; owl:allValuesFrom math:NaturalNumber ] ,
    [ a owl:Restriction ; owl:onProperty math:upperBoundaryOperator ; owl:minQualifiedCardinality 1 ; owl:onClass math:BoundaryOperator ] ,
    [ a owl:Restriction ; owl:onProperty math:upperBoundaryOperator ; owl:maxQualifiedCardinality 1 ; owl:onClass math:BoundaryOperator ] ,
    [ a owl:Restriction ; owl:onProperty math:upperBoundaryOperator ; owl:allValuesFrom math:BoundaryOperator ] ,
    [ a owl:Restriction ; owl:onProperty math:lowerBoundaryOperator ; owl:minQualifiedCardinality 1 ; owl:onClass math:BoundaryOperator ] ,
    [ a owl:Restriction ; owl:onProperty math:lowerBoundaryOperator ; owl:maxQualifiedCardinality 1 ; owl:onClass math:BoundaryOperator ] ,
    [ a owl:Restriction ; owl:onProperty math:lowerBoundaryOperator ; owl:allValuesFrom math:BoundaryOperator ] ;
    gmeow:enforcesFailureClass math:IncompleteCombinatorialLaplacian .

# Mapper coverage family: a Mapper construction is defined only relative to a
# complete, declared frame — the source metric space it samples, the filter
# (lens) function it factors through, the cover of the filter codomain, the
# deterministic clustering rule applied inside each cover element's inverse image,
# and the output nerve complex. Every obligation is a qualified-cardinality +
# allValuesFrom OWL restriction (EL-safe) that derives the paired
# sh:minCount/maxCount + sh:class property shape; a missing or wrongly typed
# component fails the derived constraint and isolates
# math:IncompleteMapperConstruction. Omitting the filter function fails the derived
# QualifiedMinCount on math:filterFunction (the missing-filter counterexample);
# omitting the cover fails the derived QualifiedMinCount on math:coverScheme (the
# missing-cover counterexample).
math:MapperConstruction logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:sourceMetricSpace ; owl:minQualifiedCardinality 1 ; owl:onClass math:MetricSpace ] ,
    [ a owl:Restriction ; owl:onProperty math:sourceMetricSpace ; owl:maxQualifiedCardinality 1 ; owl:onClass math:MetricSpace ] ,
    [ a owl:Restriction ; owl:onProperty math:sourceMetricSpace ; owl:allValuesFrom math:MetricSpace ] ,
    [ a owl:Restriction ; owl:onProperty math:filterFunction ; owl:minQualifiedCardinality 1 ; owl:onClass math:Function ] ,
    [ a owl:Restriction ; owl:onProperty math:filterFunction ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Function ] ,
    [ a owl:Restriction ; owl:onProperty math:filterFunction ; owl:allValuesFrom math:Function ] ,
    [ a owl:Restriction ; owl:onProperty math:coverScheme ; owl:minQualifiedCardinality 1 ; owl:onClass math:Cover ] ,
    [ a owl:Restriction ; owl:onProperty math:coverScheme ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Cover ] ,
    [ a owl:Restriction ; owl:onProperty math:coverScheme ; owl:allValuesFrom math:Cover ] ,
    [ a owl:Restriction ; owl:onProperty math:clusteringRule ; owl:minQualifiedCardinality 1 ; owl:onClass math:ClusteringRule ] ,
    [ a owl:Restriction ; owl:onProperty math:clusteringRule ; owl:maxQualifiedCardinality 1 ; owl:onClass math:ClusteringRule ] ,
    [ a owl:Restriction ; owl:onProperty math:clusteringRule ; owl:allValuesFrom math:ClusteringRule ] ,
    [ a owl:Restriction ; owl:onProperty math:outputNerve ; owl:minQualifiedCardinality 1 ; owl:onClass math:NerveComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:outputNerve ; owl:maxQualifiedCardinality 1 ; owl:onClass math:NerveComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:outputNerve ; owl:allValuesFrom math:NerveComplex ] ;
    gmeow:enforcesFailureClass math:IncompleteMapperConstruction .

# Vector-symbolic coverage family: a binding, bundling, or unbinding is defined
# only relative to a complete, declared frame — the vector space it composes in,
# the basis fixing its coordinates, its operand vectors, its capacity descriptor,
# and its recovery-loss (fidelity) contract. Every obligation is a
# qualified-cardinality + allValuesFrom OWL restriction (EL-safe) that derives the
# paired sh:minCount/maxCount + sh:class property shape; a missing or wrongly typed
# component fails the derived constraint and isolates
# math:IncompleteVectorSymbolicOperation. Binding and bundling take two or more
# operands (a derived QualifiedMinCount of 2 on math:vsaOperand). Omitting the
# capacity descriptor fails the derived QualifiedMinCount on math:operationCapacity
# (the capacity-degradation counterexample); omitting the recovery-loss contract
# fails the derived QualifiedMinCount on math:recoveryLossContract (the
# non-invertibility counterexample), because recovery is approximate unless an
# exact algebra proves otherwise.
math:VectorBinding logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:overVectorSpace ; owl:minQualifiedCardinality 1 ; owl:onClass math:VectorSpace ] ,
    [ a owl:Restriction ; owl:onProperty math:overVectorSpace ; owl:maxQualifiedCardinality 1 ; owl:onClass math:VectorSpace ] ,
    [ a owl:Restriction ; owl:onProperty math:overVectorSpace ; owl:allValuesFrom math:VectorSpace ] ,
    [ a owl:Restriction ; owl:onProperty math:overBasis ; owl:minQualifiedCardinality 1 ; owl:onClass math:Basis ] ,
    [ a owl:Restriction ; owl:onProperty math:overBasis ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Basis ] ,
    [ a owl:Restriction ; owl:onProperty math:overBasis ; owl:allValuesFrom math:Basis ] ,
    [ a owl:Restriction ; owl:onProperty math:vsaOperand ; owl:minQualifiedCardinality 2 ; owl:onClass math:Vector ] ,
    [ a owl:Restriction ; owl:onProperty math:vsaOperand ; owl:allValuesFrom math:Vector ] ,
    [ a owl:Restriction ; owl:onProperty math:operationCapacity ; owl:minQualifiedCardinality 1 ; owl:onClass math:VectorSymbolicCapacity ] ,
    [ a owl:Restriction ; owl:onProperty math:operationCapacity ; owl:maxQualifiedCardinality 1 ; owl:onClass math:VectorSymbolicCapacity ] ,
    [ a owl:Restriction ; owl:onProperty math:operationCapacity ; owl:allValuesFrom math:VectorSymbolicCapacity ] ,
    [ a owl:Restriction ; owl:onProperty math:recoveryLossContract ; owl:minQualifiedCardinality 1 ; owl:onClass math:RecoveryLossContract ] ,
    [ a owl:Restriction ; owl:onProperty math:recoveryLossContract ; owl:maxQualifiedCardinality 1 ; owl:onClass math:RecoveryLossContract ] ,
    [ a owl:Restriction ; owl:onProperty math:recoveryLossContract ; owl:allValuesFrom math:RecoveryLossContract ] ;
    gmeow:enforcesFailureClass math:IncompleteVectorSymbolicOperation .

