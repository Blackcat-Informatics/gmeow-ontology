gmeow:QueryRerankOutcomeLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank outcome law"@x-gmeow-english ;
    skos:definition "Every rerank entry selects exactly one scored or structured unscored branch. A winning passage is present exactly when a score is retained, while the unscored branch has neither score nor winning passage."@x-gmeow-english ;
    gmeow:useWhen "Use to reject missing, contradictory or partly declared candidate outcome branches."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid filling a missing branch with zero, empty passage text or a fabricated cause, or converting profile-rejected source scores into unscored outcomes."@x-gmeow-english ;
    gmeow:howToUse "Require a score or structured detail, forbid their conjunction, and enforce both score-to-passage and passage-to-score existence implications."@x-gmeow-english ;
    skos:scopeNote "Branch datatype and single-value checks come from the local restrictions. StructuredValue retains its own payload-branch contract."@x-gmeow-english ;
    skos:example "An explicit unscored outcome: ex:e gmeow:rerankUnscoredDetail ex:detail . ex:detail a gmeow:StructuredMap ."@x-gmeow-english ;
    logic:formalizes gmeow:QueryRerankEntry ;
    logic:message "Every rerank entry selects exactly one scored or structured unscored branch. A winning passage is present exactly when a score is retained, while the unscored branch has neither score nor winning passage." ;
    logic:integrity [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "score" ], [ logic:termIndex 2 ; logic:termVariable "passage" ] ;
