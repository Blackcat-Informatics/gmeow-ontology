@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .

# Term equivalences for Dublin Core — cross-cutting DCMI Terms and DCMI Type
# alignments (issue #60). Compiled to mappings/gmeow-dublin-core.sssom.tsv by
# `gmeow compile-mappings`.

gmeow:mapsetDublinCore a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/dublin-core" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Dublin Core maximal alignment (issue #60). DCMI Terms properties and DCMI Type classes mapped to GMEOW canonical terms. dc: element alignments are derived via the dumb-down principle (dcterms:X rdfs:subPropertyOf dc:X), not hand-authored here." .

# --- DCMI Type Vocabulary classes ------------------------------------------ #

gmeow:eqDcType001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Document ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject dcmitype:Text ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "A GMEOW Document (abstract intellectual work of textual content) is a DCMI Text" ;
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" .

gmeow:eqDcType002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Dataset ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject dcmitype:Dataset ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "A GMEOW Dataset is a DCMI Dataset" ;
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" .

gmeow:eqDcType003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:MediaObject ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject dcmitype:Image ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "GMEOW MediaObject covers image, audio, and video; DCMI Image is one possible specialization" ;
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" .

gmeow:eqDcType004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:MediaObject ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject dcmitype:Sound ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "GMEOW MediaObject covers image, audio, and video; DCMI Sound is one possible specialization" ;
