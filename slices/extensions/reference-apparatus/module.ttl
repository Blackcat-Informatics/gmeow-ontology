@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

gmeow:TableCell
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Documentary Table Cell"@x-gmeow-english ;
    skos:definition "A source cell located by one table, row and column under that table's explicit index origin. It is an InformationObject, not a scalar MatrixEntry."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this explicit part of the source structure or apparatus with its original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."@x-gmeow-english ;
    gmeow:howToUse "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."@x-gmeow-english ;
    skos:example "Retain this source meaning: ex:record a gmeow:TableCell ."@x-gmeow-english .

gmeow:FormalBlockKind
    a logic:Class, logic:AbstractIndividualType ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Printed Formal Block Kind"@x-gmeow-english ;
    skos:definition "An open quality-value vocabulary for the source's printed exposition role. A theorem, proof or algorithm label records document apparatus, never successful verification."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this explicit part of the source structure or apparatus with its original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."@x-gmeow-english ;
    gmeow:howToUse "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."@x-gmeow-english ;
    skos:example "Retain this source meaning: ex:record a gmeow:FormalBlockKind ."@x-gmeow-english .

gmeow:speaker
    a logic:ObjectProperty ;
    logic:domain gmeow:ContentBlock ;
    logic:range gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "source speaker"@x-gmeow-english ;
    skos:definition "The Entity explicitly identified as speaking this source block. A fictional character may be the speaker without becoming a Person."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this explicit part of the source structure or apparatus with its original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."@x-gmeow-english ;
    gmeow:howToUse "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."@x-gmeow-english ;
    skos:example "Retain this source meaning: ex:record gmeow:speaker ex:target ."@x-gmeow-english .

gmeow:programmingLanguageAsRecorded
    a logic:DatatypeProperty ;
    logic:domain gmeow:ContentBlock ;
    logic:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "programming language as recorded"@x-gmeow-english ;
    skos:definition "The source's exact programming-language name or code for a listing. It is an opaque string, not the software slice's Project-to-Language relation."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this explicit part of the source structure or apparatus with its original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."@x-gmeow-english ;
    gmeow:howToUse "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."@x-gmeow-english ;
    skos:example "Retain this source meaning: ex:record gmeow:programmingLanguageAsRecorded \"source wording\" ."@x-gmeow-english .

gmeow:equationSource
    a logic:DatatypeProperty ;
    logic:domain gmeow:ContentBlock ;
    logic:range xsd:string ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "equation source text"@x-gmeow-english ;
    skos:definition "The exact source spelling of a mathematical display, before parsing, normalization or notation conversion. A matching retained language surface preserves that spelling; the string itself is not a computable expression AST."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this explicit part of the source structure or apparatus with its original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."@x-gmeow-english ;
