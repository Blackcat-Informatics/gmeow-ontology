logic:exists [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "requiredScoreCriterion" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryOrderCriterion ] ],
