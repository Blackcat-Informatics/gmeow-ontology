# --------------------------------------------------------------------------- #
# CRediT — Contributor Roles Taxonomy (NISO Z39.104-2022)
# --------------------------------------------------------------------------- #

@prefix credit: <https://credit.niso.org/contributor-roles/> .

# CRediT role individuals map directly to GMEOW ContributionRole individuals.
# GMEOW rebuilds the role taxonomy natively (Principle 6) and bridges by
# reference (Principle 5).

gmeow:eqCw039 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:roleConceptualization ;
    gmeow:alignPredicate skos:exactMatch ;
