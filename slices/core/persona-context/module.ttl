gmeow:ModeTransitionActivityConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/persona-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Mode transition activity constraint"@x-gmeow-english ;
    skos:definition "Every ModeTransition is retained under at least one containing activity through an incoming modeTransition relation. The activity is distinct from the transition’s information record."@x-gmeow-english ;
    gmeow:useWhen "Use to keep persona transition records attached to their occurrence context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating an orphan information record as a complete contained transition."@x-gmeow-english ;
    gmeow:howToUse "Supply an existing activity with modeTransition pointing to the record; nested containing activities are permitted."@x-gmeow-english ;
    skos:example "ex:activity gmeow:modeTransition ex:change0 ."@x-gmeow-english ;
    logic:formalizes gmeow:ModeTransition ;
    logic:message "A ModeTransition must be linked from a containing activity by modeTransition." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:ModeTransition ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "activity" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:modeTransition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "activity" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ] ] ] ] .

gmeow:TransitionFromBearerConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/persona-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "transitionFrom bearer constraint"@x-gmeow-english ;
    skos:definition "The Persona referenced by transitionFrom has the same bearer as the transition slot. This preserves the identity of the agent across the recorded persona change."@x-gmeow-english ;
    gmeow:useWhen "Use to prevent transitionFrom from silently changing the slot’s agent."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using a different agent’s persona as the transitionFrom value."@x-gmeow-english ;
    gmeow:howToUse "Check personaBearer on the transitionFrom target against slotBearer on transitionSlot."@x-gmeow-english ;
    skos:example "ex:change0 gmeow:transitionFrom ex:formalPersona ."@x-gmeow-english ;
    logic:formalizes gmeow:transitionFrom ;
    logic:message "The transitionFrom persona must have the same bearer as the transition slot." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "slot" ], [ logic:termIndex 2 ; logic:termVariable "slotAgent" ], [ logic:termIndex 3 ; logic:termVariable "persona" ], [ logic:termIndex 4 ; logic:termVariable "personaAgent" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:ModeTransition ] ],
            [ a logic:Formula ; logic:relation gmeow:transitionSlot ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "slot" ] ],
            [ a logic:Formula ; logic:relation gmeow:slotBearer ; logic:argument [ logic:termIndex 0 ; logic:termVariable "slot" ], [ logic:termIndex 1 ; logic:termVariable "slotAgent" ] ],
            [ a logic:Formula ; logic:relation gmeow:transitionFrom ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "persona" ] ],
            [ a logic:Formula ; logic:relation gmeow:personaBearer ; logic:argument [ logic:termIndex 0 ; logic:termVariable "persona" ], [ logic:termIndex 1 ; logic:termVariable "personaAgent" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "personaAgent" ], [ logic:termIndex 1 ; logic:termVariable "slotAgent" ] ] ] ] .

gmeow:TransitionToBearerConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/persona-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "transitionTo bearer constraint"@x-gmeow-english ;
    skos:definition "The Persona referenced by transitionTo has the same bearer as the transition slot. This preserves the identity of the agent across the recorded persona change."@x-gmeow-english ;
    gmeow:useWhen "Use to prevent transitionTo from silently changing the slot’s agent."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using a different agent’s persona as the transitionTo value."@x-gmeow-english ;
    gmeow:howToUse "Check personaBearer on the transitionTo target against slotBearer on transitionSlot."@x-gmeow-english ;
    skos:example "ex:change0 gmeow:transitionTo ex:formalPersona ."@x-gmeow-english ;
    logic:formalizes gmeow:transitionTo ;
    logic:message "The transitionTo persona must have the same bearer as the transition slot." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "slot" ], [ logic:termIndex 2 ; logic:termVariable "slotAgent" ], [ logic:termIndex 3 ; logic:termVariable "persona" ], [ logic:termIndex 4 ; logic:termVariable "personaAgent" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:ModeTransition ] ],
            [ a logic:Formula ; logic:relation gmeow:transitionSlot ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "slot" ] ],
            [ a logic:Formula ; logic:relation gmeow:slotBearer ; logic:argument [ logic:termIndex 0 ; logic:termVariable "slot" ], [ logic:termIndex 1 ; logic:termVariable "slotAgent" ] ],
            [ a logic:Formula ; logic:relation gmeow:transitionTo ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "persona" ] ],
            [ a logic:Formula ; logic:relation gmeow:personaBearer ; logic:argument [ logic:termIndex 0 ; logic:termVariable "persona" ], [ logic:termIndex 1 ; logic:termVariable "personaAgent" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "personaAgent" ], [ logic:termIndex 1 ; logic:termVariable "slotAgent" ] ] ] ] .

gmeow:AutomaticTransitionBoundaryConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/persona-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Automatic transition boundary constraint"@x-gmeow-english ;
    skos:definition "A transition attributed to an automatic boundary change names at least one producer-reported transitionBoundary. No particular boundary is guessed."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the location that explains an automatic switch."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using an automatic-boundary cause without its reported boundary."@x-gmeow-english ;
    gmeow:howToUse "Keep the source’s boundary value on the same transition record."@x-gmeow-english ;
    skos:example "ex:change0 gmeow:transitionBoundary ex:sourceValue ."@x-gmeow-english ;
    logic:formalizes gmeow:transitionCauseAutomaticBoundary ;
    logic:message "A transitionCauseAutomaticBoundary transition must carry transitionBoundary." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation gmeow:transitionCause ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:transitionCauseAutomaticBoundary ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "value" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:transitionBoundary ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ] ] ] ] .

gmeow:AudienceForcedTransitionRingConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/persona-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Audience-forced transition ring constraint"@x-gmeow-english ;
    skos:definition "A transition attributed to audience forcing names at least one transitionRing identifying the audience context responsible. This does not infer a relationship category for a listener."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the audience context behind a forced persona change."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying a forced-change explanation by inventing a default audience ring."@x-gmeow-english ;
    gmeow:howToUse "Reference the producer’s scheme-scoped audience ring on that transition."@x-gmeow-english ;
    skos:example "ex:change0 gmeow:transitionRing ex:sourceValue ."@x-gmeow-english ;
    logic:formalizes gmeow:transitionCauseAudienceForced ;
    logic:message "A transitionCauseAudienceForced transition must carry transitionRing." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
