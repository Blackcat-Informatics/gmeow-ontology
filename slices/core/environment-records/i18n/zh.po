msgctxt "https://blackcatinformatics.ca/gmeow/policyAgentInternal|http://www.w3.org/2000/01/rdf-schema#label"
msgid "agent internal"
msgstr "代理内部"

msgctxt "https://blackcatinformatics.ca/gmeow/policyAgentInternal|http://www.w3.org/2004/02/skos/core#definition"
msgid "A disclosure posture keeping the claim within the named owner's own agency, with no release to other agents. The owner must be explicit; a missing owner is not inferred from the provider or recorder."
msgstr "将声明保留在具名所有者自身代理范围内、不向其他代理披露的姿态。所有者必须明确，不从提供方或记录者推断缺失所有者。"

msgctxt "https://blackcatinformatics.ca/gmeow/policyAgentInternal|https://blackcatinformatics.ca/gmeow/useWhen"
