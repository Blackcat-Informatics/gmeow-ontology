@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix gedcom: <http://www.w3.org/2000/10/swap/pim/gedcom#> .

# Projection mappings: GMEOW genealogy → SWAP GEDCOM (#34 phase 3). The
# genealogy-exchange view: persons as gedcom:Individual, families, minted
# gedcom:Marriage nodes from CoupleRelationship relators, person-level
# kinship rows. Every kinship cell drops standpoint/accordingTo provenance —
# contested parentage emits COEXISTING rows, never a winner (P9; the
# flat-rows-coexist precedent is the rel: equivalence cells).
#
# REFUSED (P5 + the gender module's tenet "SEX ≠ GENDER, never equated" and
# the identity-axes orthogonality theorem): gedcom:husband / gedcom:wife —
# deriving gendered spousal roles from gmeow:hasGenderIdentity would be the
# forbidden cross-axis bridge, and GMEOW deliberately has no flat gender.
# Spouses emit gedcom:spouseIn rows only. gedcom:sex projects ONLY from
# gmeow:sexAssignedAtBirth (the recorded administrative datum in GEDCOM's
# own documentary frame) under the CLEAN-OR-UNKNOWN rule: an unambiguous,
# uncontested saabMale/saabFemale maps to "M"/"F"; ANY ambiguity — a
# competing value, saabIntersex, saabUnknown, or an intersexVariation note —
# degrades to "U" (never silence, never a guess). Records that carry
# external gedcom:sex directly (the slices' by-reference convention) pass
# through MAXIMAL as base triples.
# REFUSED (P5 — no source edge): gedcom:childIn — ParentChildRelationship
# carries no Family link, and Family⊑Group membership cannot distinguish a
# child from a spouse; person-level rows only.

gmeow:mapGedcomIndividual a gmeow:ProjectionMapping ;
    rdfs:label "Person → gedcom:Individual"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "gperson" ;
        gmeow:atom ( [ gmeow:subjectVar "gperson" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Person ] ) ;
        gmeow:edoalSource gmeow:Person ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [ gmeow:profile "gedcom" ; gmeow:toClass gedcom:Individual ; gmeow:relation "<=" ; gmeow:confidence 0.9 ] .

gmeow:mapGedcomFamily a gmeow:ProjectionMapping ;
    rdfs:label "Family → gedcom:Family"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "gfam" ;
        gmeow:atom ( [ gmeow:subjectVar "gfam" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Family ] ) ;
        gmeow:edoalSource gmeow:Family ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [ gmeow:profile "gedcom" ; gmeow:toClass gedcom:Family ; gmeow:relation "=" ; gmeow:confidence 0.9 ] .

# The couple relator becomes a minted Marriage node; both partners emit
# spouseIn rows. The two hasPartner atoms with an inequality filter bind the
# pair; the projection stays role-symmetric (no husband/wife — see header).
gmeow:mapGedcomMarriage a gmeow:ProjectionMapping ;
    rdfs:label "CoupleRelationship → minted gedcom:Marriage + spouseIn"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "gcouple" ;
        gmeow:atom (
            [ gmeow:subjectVar "gcouple" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:CoupleRelationship ]
            [ gmeow:subjectVar "gcouple" ; gmeow:predicate gmeow:hasPartner ; gmeow:objectVar "gp1" ]
            [ gmeow:subjectVar "gcouple" ; gmeow:predicate gmeow:hasPartner ; gmeow:objectVar "gp2" ] ) ;
        gmeow:filter [ gmeow:exprOp gmeow:opNe ; gmeow:exprArgs (
            [ gmeow:exprVar "gp1" ] [ gmeow:exprVar "gp2" ] ) ] ;
        gmeow:mint [ gmeow:bindVar "gmarriage" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "gcouple" ] ) ]
                    "-marriage" ) ] ) ] ] ;
        gmeow:edoalSource gmeow:CoupleRelationship ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "gedcom" ; gmeow:toClass gedcom:Marriage ; gmeow:relation "<=" ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "the couple relator's kind (marriage vs partnership) and validity period collapse to a bare Marriage node; partner roles stay symmetric (no husband/wife — SEX ≠ GENDER)" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "gmarriage" ; gmeow:tPred rdf:type ; gmeow:tObjValue gedcom:Marriage ]
            [ gmeow:tSubj "gp1" ; gmeow:tPred gedcom:spouseIn ; gmeow:tObj "gmarriage" ]
            [ gmeow:tSubj "gp2" ; gmeow:tPred gedcom:spouseIn ; gmeow:tObj "gmarriage" ] ) ] .

gmeow:mapGedcomChild a gmeow:ProjectionMapping ;
    rdfs:label "hasChild → gedcom:child (standpoints drop; contested rows coexist)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "gparent" ; gmeow:value "gchild" ;
        gmeow:atom ( [ gmeow:subjectVar "gparent" ; gmeow:predicate gmeow:hasChild ; gmeow:objectVar "gchild" ] ) ;
        gmeow:edoalSource gmeow:hasChild ] ;
    gmeow:hasBinding [
        gmeow:profile "gedcom" ; gmeow:toPredicate gedcom:child ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "standpoint/accordingTo provenance dropped; contested parentage emits coexisting rows" ] .

# Documentary sex: ONLY from the recorded administrative datum, never from
# gender identity — and only when UNAMBIGUOUS. The M/F cells suppress
# themselves on any competing value or an intersex-variation note; every
# ambiguous configuration emits "U" instead (the degrade cells below).
gmeow:mapGedcomSexM a gmeow:ProjectionMapping ;
    rdfs:label "uncontested saabMale → gedcom:sex 'M'"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "gsexm" ;
        gmeow:atom ( [ gmeow:subjectVar "gsexm" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabMale ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "gsexm" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabFemale ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "gsexm" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabIntersex ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "gsexm" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabUnknown ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "gsexm" ; gmeow:predicate gmeow:intersexVariation ; gmeow:objectVar "gsexmNote" ] ;
        gmeow:mint [ gmeow:bindVar "gsexmVal" ; gmeow:bindExpr "M" ] ;
        gmeow:edoalSource gmeow:sexAssignedAtBirth ] ;
    gmeow:hasBinding [
        gmeow:profile "gedcom" ; gmeow:toPredicate gedcom:sex ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the documentary sex-assigned-at-birth datum flattens to GEDCOM's SEX code ONLY when unambiguous; gender identity is NEVER a source (SEX != GENDER); any ambiguity degrades to 'U'" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "gsexm" ; gmeow:tPred gedcom:sex ; gmeow:tObj "gsexmVal" ] ) ] .

gmeow:mapGedcomSexF a gmeow:ProjectionMapping ;
    rdfs:label "uncontested saabFemale → gedcom:sex 'F'"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "gsexf" ;
        gmeow:atom ( [ gmeow:subjectVar "gsexf" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabFemale ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "gsexf" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabMale ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "gsexf" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabIntersex ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "gsexf" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabUnknown ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "gsexf" ; gmeow:predicate gmeow:intersexVariation ; gmeow:objectVar "gsexfNote" ] ;
        gmeow:mint [ gmeow:bindVar "gsexfVal" ; gmeow:bindExpr "F" ] ;
        gmeow:edoalSource gmeow:sexAssignedAtBirth ] ;
    gmeow:hasBinding [
        gmeow:profile "gedcom" ; gmeow:toPredicate gedcom:sex ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:templateAtoms ( [ gmeow:tSubj "gsexf" ; gmeow:tPred gedcom:sex ; gmeow:tObj "gsexfVal" ] ) ] .

# The degrade cells: every ambiguous configuration emits "U". CONSTRUCT set
# semantics dedupe multiple triggers into one row.
gmeow:mapGedcomSexUIntersex a gmeow:ProjectionMapping ;
    rdfs:label "saabIntersex → gedcom:sex 'U' (GEDCOM's binary cannot carry it)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "gsexui" ;
        gmeow:atom ( [ gmeow:subjectVar "gsexui" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabIntersex ] ) ;
        gmeow:mint [ gmeow:bindVar "gsexuiVal" ; gmeow:bindExpr "U" ] ;
        gmeow:edoalSource gmeow:sexAssignedAtBirth ] ;
    gmeow:hasBinding [
        gmeow:profile "gedcom" ; gmeow:toPredicate gedcom:sex ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "an intersex datum degrades to 'U' — GEDCOM's binary code cannot carry it and a forced M/F would misrepresent" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "gsexui" ; gmeow:tPred gedcom:sex ; gmeow:tObj "gsexuiVal" ] ) ] .

gmeow:mapGedcomSexUUnknown a gmeow:ProjectionMapping ;
    rdfs:label "saabUnknown → gedcom:sex 'U'"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "gsexuu" ;
        gmeow:atom ( [ gmeow:subjectVar "gsexuu" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabUnknown ] ) ;
        gmeow:mint [ gmeow:bindVar "gsexuuVal" ; gmeow:bindExpr "U" ] ;
        gmeow:edoalSource gmeow:sexAssignedAtBirth ] ;
    gmeow:hasBinding [
        gmeow:profile "gedcom" ; gmeow:toPredicate gedcom:sex ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:templateAtoms ( [ gmeow:tSubj "gsexuu" ; gmeow:tPred gedcom:sex ; gmeow:tObj "gsexuuVal" ] ) ] .

gmeow:mapGedcomSexUContested a gmeow:ProjectionMapping ;
    rdfs:label "contested saab values → gedcom:sex 'U' (no winner is picked)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "gsexuc" ;
        gmeow:atom (
            [ gmeow:subjectVar "gsexuc" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabMale ]
            [ gmeow:subjectVar "gsexuc" ; gmeow:predicate gmeow:sexAssignedAtBirth ; gmeow:objectValue gmeow:saabFemale ] ) ;
        gmeow:mint [ gmeow:bindVar "gsexucVal" ; gmeow:bindExpr "U" ] ;
        gmeow:edoalSource gmeow:sexAssignedAtBirth ] ;
    gmeow:hasBinding [
        gmeow:profile "gedcom" ; gmeow:toPredicate gedcom:sex ; gmeow:relation "<=" ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "competing recorded values coexist in GMEOW (P9); the flat GEDCOM code degrades to 'U' rather than picking a winner" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "gsexuc" ; gmeow:tPred gedcom:sex ; gmeow:tObj "gsexucVal" ] ) ] .

gmeow:mapGedcomSexUVariation a gmeow:ProjectionMapping ;
    rdfs:label "intersexVariation note → gedcom:sex 'U'"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "gsexuv" ;
        gmeow:atom ( [ gmeow:subjectVar "gsexuv" ; gmeow:predicate gmeow:intersexVariation ; gmeow:objectVar "gsexuvNote" ] ) ;
        gmeow:mint [ gmeow:bindVar "gsexuvVal" ; gmeow:bindExpr "U" ] ;
        gmeow:edoalSource gmeow:intersexVariation ] ;
    gmeow:hasBinding [
        gmeow:profile "gedcom" ; gmeow:toPredicate gedcom:sex ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "an intersex-variation note marks the binary datum as insufficient; the code degrades to 'U' (the note itself is never exported)" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "gsexuv" ; gmeow:tPred gedcom:sex ; gmeow:tObj "gsexuvVal" ] ) ] .
