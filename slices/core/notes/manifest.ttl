@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/notes>
    a gmeow:Slice ;
    rdfs:label "notes"@x-gmeow-english ;
    skos:definition "The notes slice of the GMEOW ontology (core tier): GMEOW Notes & Annotation Module. Core by deep interlink — annotation rides directly on the core evidence/observation spine (its only dependencies are kernel and evidence), and retained working memory is required by every enactment binding rather than by one domain. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/notes> ;
    dcterms:title "GMEOW Notes & Annotation Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/evidence> ;
    gmeow:sliceConsumer "PKM annotations (annotation target span) over core evidence spans; Web Annotation projection."@x-gmeow-english.
