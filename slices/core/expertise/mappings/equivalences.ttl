@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix ceterms: <https://purl.org/ctdl/terms/> .
@prefix esco: <http://data.europa.eu/esco/model#> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:eqClasses044 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Credential ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject schema:EducationalOccupationalCredential ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses052 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Skill ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject esco:Skill ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "ESCO skill — the European skills/competences framework" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses054 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Credential ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject ceterms:Credential ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Credential Engine CTDL Credential — superset by reference" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqProperties033 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasOccupation ;
    gmeow:alignPredicate owl:equivalentProperty ;
    gmeow:alignObject schema:hasOccupation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:sssomFile "gmeow-properties.sssom.tsv" .

gmeow:eqProperties068 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasSkill ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:skills ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "schema.org skills — the leveled SkillProficiency relator collapses to a flat skill link" ;
    gmeow:sssomFile "gmeow-properties.sssom.tsv" .

