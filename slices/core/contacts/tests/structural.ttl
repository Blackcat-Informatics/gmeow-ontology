#
# Declarative structural assertions for the contacts slice. Each assertion runs
# as a SPARQL ASK over contacts/module.ttl under the native Rust slicetest
# harness.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/contacts/tests/> .

ex:saInterpersonalRelationshipIsRelatorKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:InterpersonalRelationship a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:InterpersonalRelationship MUST be a logic:Kind subclass of logic:Relator, not a Situation. Replaces the stale temporal cross-slice gufo:Relator check." .

ex:saEmailAddressStablePropertiesFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:addressValue a owl:DatatypeProperty ;
        rdfs:domain gmeow:EmailAddress ;
        rdfs:range rdfs:Literal .
    gmeow:localPart a owl:DatatypeProperty ;
        rdfs:domain gmeow:EmailAddress ;
        rdfs:range rdfs:Literal .
    gmeow:domainPart a owl:DatatypeProperty ;
        rdfs:domain gmeow:EmailAddress ;
        rdfs:range rdfs:Literal .
}""" ;
    gmeow:saRationale """gmeow:addressValue, localPart, and domainPart MUST be DatatypeProperties on EmailAddress ranging over Literal. The EmailAddress stable properties are owned by the contacts slice (cross-slice ownership).""" .

# --- 3. PostalAddress subclasses ContactPoint (MUST) -------------------------
ex:saPostalAddressSubclassesContactPoint a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PostalAddress rdfs:subClassOf gmeow:ContactPoint .
}""" ;
    gmeow:saRationale "gmeow:PostalAddress MUST be rdfs:subClassOf gmeow:ContactPoint." .

# --- 4. Postal address component properties are DatatypeProperties (MUST) ----
ex:saPostalAddressComponentsAreDatatypeProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:streetAddress   a owl:DatatypeProperty .
    gmeow:extendedAddress a owl:DatatypeProperty .
    gmeow:postOfficeBox   a owl:DatatypeProperty .
    gmeow:addressLocality a owl:DatatypeProperty .
    gmeow:addressRegion   a owl:DatatypeProperty .
    gmeow:postalCode      a owl:DatatypeProperty .
    gmeow:countryCode     a owl:DatatypeProperty .
}""" ;
    gmeow:saRationale "The seven postal-address component properties MUST be owl:DatatypeProperty." .

# --- 5. Postal address component properties are NOT functional (MUST-NOT) ----
ex:saPostalAddressComponentsNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p {
        gmeow:streetAddress gmeow:extendedAddress gmeow:postOfficeBox
        gmeow:addressLocality gmeow:addressRegion gmeow:postalCode gmeow:countryCode
    }
    ?p a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "The seven postal-address component properties MUST NOT be owl:FunctionalProperty -- source variants coexist (Principle 9)." .

# --- 6. addressPlace ranges over Place (MUST) ---------------------------------
ex:saAddressPlaceRangesPlace a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:addressPlace rdfs:range gmeow:Place .
}""" ;
    gmeow:saRationale "gmeow:addressPlace MUST have rdfs:range gmeow:Place -- the seam from a postal address surface form to the resolved geographic place." .

# --- 7. postalAddressFrame is a subproperty of hasReferenceFrame (MUST)
ex:saPostalAddressFrameProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:postalAddressFrame a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:hasReferenceFrame ;
        rdfs:domain gmeow:PostalAddress ;
        rdfs:range gmeow:ReferenceFrame .
}""" ;
    gmeow:saRationale "gmeow:postalAddressFrame MUST be an owl:ObjectProperty, rdfs:subPropertyOf gmeow:hasReferenceFrame, with domain gmeow:PostalAddress and range gmeow:ReferenceFrame." .
