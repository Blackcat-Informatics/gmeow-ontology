# =========================================================================== #
# Runtime-DAG vocabulary — the GENERAL scheduled-enrichment DAG.               #
#                                                                             #
# gmeow:pipeline-build above is ONE consumer of the pipeline vocabulary: the   #
# project's own build. This section adds the general runtime-DAG surface a     #
# downstream SCHEDULED ENRICHMENT DAG (the in-rush enrichment planner consumed  #
# by lillith_decodes) declares in GMEOW as its single canon: WHY an edge       #
# exists (gmeow:FlowReason), how a stage-execution ENDED (gmeow:StageDisposition), #
# whether a stage's absence invalidates the run (gmeow:StageObligation), whether #
# its output is byte-stable across turns (gmeow:StageStability), the per-stage  #
# resource BUDGETS (gmeow:StageBudget), the content-addressed run RECEIPTS      #
# (gmeow:StageReceipt), and the admission law the declared graph must satisfy   #
# (gmeow:RuntimeDagAdmissionConstraint). It is graph + constraint vocabulary    #
# ONLY: no scheduler semantics are modelled here (non-goal of the issue). The   #
# Rust projection consuming it is lillith_decodes' commitment, not this repo's. #
# =========================================================================== #

# ── (1) Edge reason — WHY a dataflow edge exists ───────────────────────────── #

gmeow:FlowReason
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Flow Reason"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The declared REASON a gmeow:BuildDataFlow edge exists — a closed value vocabulary drawn through the required gmeow:flowReason property, read by an admission reasoner in place of assuming every edge is a byte-carrying dependency. A CLOSED set of three individuals: gmeow:flowReasonDataflow (bytes genuinely flow producer → consumer), gmeow:flowReasonAuthority (a first-class ORDERING constraint the consumer must run after the producer even when NO bytes flow — a decision-precedence a pure-dataflow reduction would wrongly collapse), and gmeow:flowReasonCost (an edge added only to serialize two stages that share a scarce resource, a scheduling hint rather than a semantic dependency). Modelled as a required property carrying a value rather than an AuthorityFlow subclass so it composes with the existing reified gmeow:BuildDataFlow edge: one edge, one typed reason."@x-gmeow-english ;
    skos:example "gmeow:edge-x gmeow:flowReason gmeow:flowReasonAuthority ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:flowReason
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "flow reason"@x-gmeow-english ;
    rdfs:domain gmeow:BuildDataFlow ;
    rdfs:range gmeow:FlowReason ;
    skos:definition "The REQUIRED reason a gmeow:BuildDataFlow edge exists: every reified edge carries exactly one gmeow:FlowReason (gmeow:minQualifiedCardinality 1, closed to the three declared individuals). It names whether the edge is a byte dependency (gmeow:flowReasonDataflow), a pure ordering authority (gmeow:flowReasonAuthority — retained even when no bytes flow), or a resource-serialization cost edge (gmeow:flowReasonCost). Required because an untyped edge is indistinguishable from a droppable dataflow dependency, and an admission reasoner that reduced the graph to its byte-flow skeleton would silently delete every authority edge — the exact corruption gmeow:RuntimeDagAdmissionConstraint forbids. It types WHY the edge exists, distinct from gmeow:flowEntity, which names WHAT flows on it, not the edge's reason."@x-gmeow-english ;
    skos:example "gmeow:edge-annotate-after-canon gmeow:flowReason gmeow:flowReasonAuthority ."@x-gmeow-english ;
    gmeow:useWhen "Declare, on every gmeow:BuildDataFlow edge, why the consumer depends on the producer — byte flow, ordering authority, or resource-cost serialization — so admission keeps the edge for the right reason."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT leave an authority-only edge with the default gmeow:flowReasonDataflow (that invites a dataflow reducer to drop it because no bytes flow), and do NOT mint a new reason value — the set is closed at three; a genuinely new reason is a vocabulary change, not an inline addition."@x-gmeow-english ;
    gmeow:howToUse "Assert exactly one gmeow:flowReason per edge from {gmeow:flowReasonDataflow, gmeow:flowReasonAuthority, gmeow:flowReasonCost}; an authority edge (gmeow:flowReasonAuthority) is a first-class ordering constraint gmeow:RuntimeDagAdmissionConstraint requires be satisfied on a preceding path."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:flowReasonDataflow
    a gmeow:FlowReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "flow reason: dataflow"@x-gmeow-english ;
    skos:definition "The edge exists because BYTES genuinely flow producer → consumer: the consumer reads the producer's product (the ordinary gmeow:dataflowConsumes case). A dataflow reasoner may key the consumer's cache on the flowing entities' digests and is free to schedule producers first. The default and most common reason; the build DAG's own edges all carry it. Distinct from gmeow:flowReasonAuthority, whose edge carries no bytes and exists purely to order two stages."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:flowReasonAuthority
    a gmeow:FlowReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "flow reason: authority"@x-gmeow-english ;
    skos:definition "The edge is a FIRST-CLASS ORDERING CONSTRAINT the consumer must run AFTER the producer even though NO bytes flow between them: a decision precedence (the producer's verdict authorizes or forecloses the consumer's work), a commit ordering, or an idempotence fence. A pure-dataflow reasoner that reduced the graph to its byte-flow skeleton would see no flowing entity and WRONGLY DROP this edge, reordering or parallelizing two stages whose relative order is semantically required; gmeow:RuntimeDagAdmissionConstraint therefore treats every authority edge as a mandatory ordering that admission MUST preserve on a preceding path. The reason the reason vocabulary exists: authority is not dataflow, and the two must not be conflated."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:flowReasonCost
    a gmeow:FlowReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "flow reason: cost"@x-gmeow-english ;
    skos:definition "The edge exists only to SERIALIZE two stages that would otherwise contend for a scarce resource (peak memory, an exclusive engine, a rate-limited external service): a scheduling hint that imposes an order to bound cost, not a semantic dependency. Distinct from gmeow:flowReasonAuthority (whose ordering is required by MEANING, not merely by resource economy) and from gmeow:flowReasonDataflow (which carries bytes). An admission reasoner may relax a cost edge if the resource conflict it guards is otherwise resolved, but must never relax an authority edge."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# ── (2) Per-stage-execution failure disposition + stage-level obligation ────── #

gmeow:StageExecution
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Stage Execution"@x-gmeow-english ;
    rdfs:subClassOf logic:Event ;
    skos:definition "ONE run of a gmeow:PipelineStage within a gmeow:PipelineRun — a perdurant occurrence (logic:Event), the enactment of the stage's logic:ActionSchema. Where gmeow:PipelineStage is the standing description of a unit of work, a gmeow:StageExecution is a single attempt at it, carrying how that attempt ENDED (gmeow:stageDisposition) so the enrichment planner can distinguish a stage that produced an answer, produced an explicit typed nothing, was rejected, may be retried, killed the candidate, or timed out. Distinct from the stage's declared, run-invariant obligation (gmeow:stageObligation) and output stability (gmeow:stageStability), which are properties of the stage, not of one execution of it."@x-gmeow-english ;
    skos:example "gmeow:exec-annotate-42 a gmeow:StageExecution ; gmeow:stageDisposition gmeow:dispositionTypedAbsence ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:StageDisposition
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Stage Disposition"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "How one gmeow:StageExecution ENDED — a CLOSED value vocabulary of six outcomes drawn through gmeow:stageDisposition: gmeow:dispositionCompleted (produced its normal product), gmeow:dispositionTypedAbsence (ran to completion and produced an explicit, typed 'nothing' — an answer, not a failure — linking a reason individual), gmeow:dispositionRejectedCandidate (the input candidate was rejected on validation), gmeow:dispositionRetryable (a transient failure the planner may re-attempt), gmeow:dispositionFatalToCandidate (a failure that invalidates the whole candidate, not just this stage), and gmeow:dispositionTimedOut (a budget deadline elapsed). Typed dispositions replace an untyped success/failure boolean: an explicit typed absence is a first-class result the downstream must be able to tell apart from a crash."@x-gmeow-english ;
    skos:example "gmeow:exec-x gmeow:stageDisposition gmeow:dispositionRetryable ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:stageDisposition
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "stage disposition"@x-gmeow-english ;
    rdfs:domain gmeow:StageExecution ;
    rdfs:range gmeow:StageDisposition ;
    skos:definition "Relates a gmeow:StageExecution to the one gmeow:StageDisposition it ended in — the typed outcome of that run (completed, typed-absence, rejected-candidate, retryable, fatal-to-candidate, timed-out). Closed to the six declared individuals. The enrichment planner reads it to decide retry, candidate eviction, or acceptance of a typed absence; a missing disposition is an incomplete execution record. It types a per-execution outcome, distinct from gmeow:stageObligation, which is the stage's standing policy, not this per-run result."@x-gmeow-english ;
    skos:example "gmeow:exec-canonicalize gmeow:stageDisposition gmeow:dispositionCompleted ."@x-gmeow-english ;
    gmeow:useWhen "Record on every gmeow:StageExecution how the attempt ended, so the planner can tell a typed absence apart from a retryable failure apart from a candidate-fatal one."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT use it to declare a stage's standing failure policy (that is gmeow:stageObligation on the stage) and do NOT mint a seventh outcome — the disposition set is closed at six."@x-gmeow-english ;
    gmeow:howToUse "Assert exactly one gmeow:stageDisposition per execution from the closed six; gmeow:dispositionTypedAbsence marks a stage that RAN and produced an explicit typed 'nothing', linking its reason individual — not a stage that failed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:dispositionCompleted
    a gmeow:StageDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "disposition: completed"@x-gmeow-english ;
    skos:definition "The stage execution ran to completion and produced its normal product — the ordinary success outcome. Distinct from gmeow:dispositionTypedAbsence, which also ran successfully but produced an explicit typed 'nothing', not a positive product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dispositionTypedAbsence
    a gmeow:StageDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "disposition: typed absence"@x-gmeow-english ;
    skos:definition "The stage execution RAN successfully and produced an explicit, typed 'nothing' — a first-class absence result (e.g. 'no enrichment applies to this candidate') that LINKS a reason individual, NOT a failure. It is distinguished from gmeow:dispositionCompleted (which carries a positive product) and from every failure outcome: an admission or acceptance reasoner must treat a typed absence as a valid, complete answer, never as a missing or degraded output."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dispositionRejectedCandidate
    a gmeow:StageDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "disposition: rejected candidate"@x-gmeow-english ;
    skos:definition "The stage execution rejected its input candidate on a validation check — the candidate does not meet this stage's admission precondition. A verdict about the input, not a fault in the stage."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dispositionRetryable
    a gmeow:StageDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "disposition: retryable"@x-gmeow-english ;
    skos:definition "The stage execution failed transiently (a timeout upstream, a temporarily unavailable service, a contended lock) in a way the planner MAY re-attempt without invalidating the candidate — a recoverable failure, distinct from gmeow:dispositionFatalToCandidate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dispositionFatalToCandidate
    a gmeow:StageDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "disposition: fatal to candidate"@x-gmeow-english ;
    skos:definition "The stage execution failed in a way that INVALIDATES THE WHOLE CANDIDATE, not merely this stage: no retry can rescue it and the candidate must be dropped from the run. Distinct from gmeow:dispositionRetryable (recoverable) and gmeow:dispositionRejectedCandidate (a clean admission rejection rather than a fault)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dispositionTimedOut
    a gmeow:StageDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "disposition: timed out"@x-gmeow-english ;
    skos:definition "The stage execution exceeded a declared budget deadline (gmeow:budgetDeadline) and was stopped before completing — a resource-bound outcome the planner treats per the stage's gmeow:stageObligation (mandatory ⇒ the run is invalid; degradable ⇒ the absence is tolerated). A resource-bound stop, distinct from gmeow:dispositionFatalToCandidate, which is an intrinsic fault rather than an exhausted budget."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:StageObligation
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Stage Obligation"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "Whether a stage's ABSENCE invalidates the run — a CLOSED, run-invariant declaration drawn through gmeow:stageObligation, made a first-class property rather than left implicit: gmeow:obligationMandatory (the run is INVALID if this stage produces no product — its absence is a hard failure) and gmeow:obligationDegradable (the run may proceed without this stage's product, accepting a declared degradation). 'This stage's absence invalidates the run' is thereby a declared, queryable property of the stage, not a convention buried in scheduler code."@x-gmeow-english ;
    skos:example "gmeow:stage-canon gmeow:stageObligation gmeow:obligationMandatory ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:stageObligation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "stage obligation"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    rdfs:range gmeow:StageObligation ;
    skos:definition "Relates a gmeow:PipelineStage to its run-invariant obligation level: gmeow:obligationMandatory (absence invalidates the run) or gmeow:obligationDegradable (absence is tolerated with declared degradation). Closed to the two declared individuals. The declarative replacement for a scheduler special-case: the planner reads it to decide whether a missing or absent stage product is a hard run failure or an accepted degradation. It declares the stage's run-invariant policy, distinct from gmeow:stageDisposition, which records one execution's outcome rather than a standing obligation."@x-gmeow-english ;
    skos:example "gmeow:stage-enrich-authority gmeow:stageObligation gmeow:obligationMandatory ."@x-gmeow-english ;
    gmeow:useWhen "Declare, per stage, whether the run is invalid without this stage's product (mandatory) or may proceed degraded (degradable)."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT conflate it with a per-execution outcome (gmeow:stageDisposition) — obligation is the stage's standing policy, independent of any one run — and do NOT add a third level; the set is closed at two."@x-gmeow-english ;
    gmeow:howToUse "Assert exactly one gmeow:stageObligation per stage; combined with a run's gmeow:dispositionTypedAbsence or a failure disposition, it decides whether the run stands or fails."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:obligationMandatory
    a gmeow:StageObligation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "obligation: mandatory"@x-gmeow-english ;
    skos:definition "The stage's product is MANDATORY: the run is invalid if this stage produces no product (a failure or an untyped absence). Its absence is a hard failure the planner must not silently accept."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:obligationDegradable
    a gmeow:StageObligation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "obligation: degradable"@x-gmeow-english ;
    skos:definition "The stage's product is DEGRADABLE: the run may proceed without it, accepting a declared, explicit degradation. Distinct from silent capability loss — the degradation is a first-class, declared tolerance, not a swallowed failure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# ── (3) Stage-output stability across turns ────────────────────────────────── #

gmeow:StageStability
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Stage Stability"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The byte-stability of a stage's OUTPUT across turns — a CLOSED value vocabulary drawn through gmeow:stageStability: gmeow:stabilityStablePrefix (the stage's output is BYTE-IDENTICAL across turns, so it can be ordered ahead of variable stages to enable prefix-cache reuse) and gmeow:stabilityPerTurnVariance (the output varies turn to turn and cannot be prefix-cached). Declared so a scheduling projection can order the stable prefix first without re-deriving stability empirically."@x-gmeow-english ;
    skos:example "gmeow:stage-canon gmeow:stageStability gmeow:stabilityStablePrefix ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:stageStability
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "stage stability"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    rdfs:range gmeow:StageStability ;
    skos:definition "Relates a gmeow:PipelineStage to the byte-stability of its output across turns: gmeow:stabilityStablePrefix (byte-identical across turns — enables prefix-cache ordering) or gmeow:stabilityPerTurnVariance (varies per turn). Closed to the two declared individuals. A projection that builds a prefix-cache-friendly order reads it to place every stable-prefix stage ahead of the first per-turn-variant one."@x-gmeow-english ;
    skos:example "gmeow:stage-fetch-live gmeow:stageStability gmeow:stabilityPerTurnVariance ."@x-gmeow-english ;
    gmeow:useWhen "Declare, per stage, whether its output is byte-identical across turns (stable prefix) or per-turn variant, so a prefix-cache-aware order is derivable."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT declare gmeow:stabilityStablePrefix for a stage whose output depends on turn-varying input (a live fetch, a timestamp) — a false stable-prefix claim corrupts prefix-cache reuse — and do NOT add a third value."@x-gmeow-english ;
    gmeow:howToUse "Assert exactly one gmeow:stageStability per stage; gmeow:stabilityStablePrefix means byte-identical across turns, the precondition a prefix-cache ordering relies on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:stabilityStablePrefix
    a gmeow:StageStability ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "stability: stable prefix"@x-gmeow-english ;
    skos:definition "The stage's output is BYTE-IDENTICAL across turns: given the same declared inputs it produces the same bytes every turn, so it can be placed in the stable prefix of a schedule and its result (and any downstream token prefix) reused from cache rather than recomputed. The precondition prefix-cache ordering depends on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:stabilityPerTurnVariance
    a gmeow:StageStability ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "stability: per-turn variance"@x-gmeow-english ;
    skos:definition "The stage's output VARIES turn to turn (a live fetch, a sampled model call, a timestamped record) and therefore cannot be prefix-cached: it must be placed after the stable prefix, and everything downstream of it inherits the variance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# ── (4) Per-stage resource budgets ─────────────────────────────────────────── #

gmeow:StageBudget
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Stage Budget"@x-gmeow-english ;
    rdfs:subClassOf gmeow:SocialObject ;
    skos:definition "A reified per-stage RESOURCE BUDGET: the declared ceilings one gmeow:PipelineStage is permitted to consume in a run, gathered through gmeow:hasStageBudget. Grouped as a class (like gmeow:BuildDataFlow and gmeow:FanoutExtraction) rather than scattered as bare stage properties so a whole budget is one addressable record the planner reads and a run can echo. Carries the typed-literal ceilings gmeow:budgetDeadline, gmeow:budgetMaxSteps, gmeow:budgetMaxAnswers, gmeow:budgetMaxInputBytes and gmeow:budgetMaxMemoryBytes. A budget is a permit for a real cost, not a repair; exceeding gmeow:budgetDeadline yields a gmeow:dispositionTimedOut execution."@x-gmeow-english ;
    skos:example "gmeow:budget-enrich a gmeow:StageBudget ; gmeow:budgetDeadline \"PT30S\"^^xsd:duration ; gmeow:budgetMaxSteps 1000 ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:hasStageBudget
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "has stage budget"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineStage ;
    rdfs:range gmeow:StageBudget ;
    skos:definition "Relates a gmeow:PipelineStage to the gmeow:StageBudget declaring its per-run resource ceilings. The planner reads it to admit or throttle the stage and to detect a budget breach (which yields a gmeow:dispositionTimedOut for the deadline, or a candidate-fatal outcome for a hard resource ceiling). It relates a stage to its standing pre-run permit, distinct from gmeow:hasStageReceipt, which gathers a run's after-the-fact records rather than a budget."@x-gmeow-english ;
    skos:example "gmeow:stage-enrich gmeow:hasStageBudget gmeow:budget-enrich ."@x-gmeow-english ;
    gmeow:useWhen "Attach a budget to a stage whose resource consumption must be bounded — a deadline, a step/answer count, an input size, or a memory peak."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT scatter the individual budget literals directly on the stage — group them in one gmeow:StageBudget record so the whole budget is addressable — and do NOT use it to model the exclusive-resource conflict lane (that is gmeow:requiresResource)."@x-gmeow-english ;
    gmeow:howToUse "Mint one gmeow:StageBudget per budgeted stage, set the ceilings that apply, and link it with gmeow:hasStageBudget; an unset ceiling means unbounded on that axis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:budgetDeadline
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "budget deadline"@x-gmeow-english ;
    rdfs:domain gmeow:StageBudget ;
    rdfs:range xsd:duration ;
    skos:definition "The wall-clock time budget a stage is permitted to run before it is stopped — an xsd:duration RELATIVE to the stage's start, deliberately chosen over an absolute xsd:dateTime: a relative budget is turn-invariant and replayable (the same declared budget yields the same admission decision on every run and in a replayed interleaved trace), whereas an absolute deadline would bake a specific run's clock into the canon and defeat deterministic replay. Exceeding it yields a gmeow:dispositionTimedOut execution. A ceiling on elapsed time, distinct from gmeow:budgetMaxSteps, which bounds internal iterations rather than wall-clock duration."@x-gmeow-english ;
    skos:example "gmeow:budget-enrich gmeow:budgetDeadline \"PT30S\"^^xsd:duration ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:budgetMaxSteps
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "budget max steps"@x-gmeow-english ;
    rdfs:domain gmeow:StageBudget ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The maximum number of internal steps (iterations, reasoning rounds, sub-calls) a stage may take before it is stopped — an xsd:nonNegativeInteger ceiling. Zero means the stage may take no steps (a pure pass-through); an unset value means unbounded on this axis. It bounds internal iterations, distinct from gmeow:budgetMaxAnswers, which bounds emitted results rather than steps taken."@x-gmeow-english ;
    skos:example "gmeow:budget-enrich gmeow:budgetMaxSteps 1000 ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:budgetMaxAnswers
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "budget max answers"@x-gmeow-english ;
    rdfs:domain gmeow:StageBudget ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The maximum number of answers (result rows, enrichment candidates, emitted records) a stage may produce before it stops — an xsd:nonNegativeInteger ceiling bounding output cardinality. An unset value means unbounded. It caps emitted results, distinct from gmeow:budgetMaxSteps, which caps internal work rather than answers produced."@x-gmeow-english ;
    skos:example "gmeow:budget-enrich gmeow:budgetMaxAnswers 50 ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:budgetMaxInputBytes
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "budget max input bytes"@x-gmeow-english ;
    rdfs:domain gmeow:StageBudget ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The maximum size, in bytes, of the input a stage will accept before it rejects the candidate — an xsd:nonNegativeInteger ceiling guarding against oversized inputs. An unset value means unbounded. It caps accepted input size, distinct from gmeow:budgetMaxMemoryBytes, which caps resident memory rather than input volume."@x-gmeow-english ;
    skos:example "gmeow:budget-enrich gmeow:budgetMaxInputBytes 1048576 ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:budgetMaxMemoryBytes
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "budget max memory bytes"@x-gmeow-english ;
    rdfs:domain gmeow:StageBudget ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The maximum resident memory, in bytes, a stage's execution may occupy before it is stopped — an xsd:nonNegativeInteger peak-residency ceiling, the per-stage analogue of the whole-dataset gmeow:serializationBufferResource peak the build DAG guards. An unset value means unbounded. It caps peak resident memory, distinct from gmeow:budgetMaxInputBytes, which caps accepted input size, not runtime residency."@x-gmeow-english ;
    skos:example "gmeow:budget-enrich gmeow:budgetMaxMemoryBytes 2147483648 ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── (5) Run receipts — content-addressed, topologically ordered ────────────── #

gmeow:PipelineRun
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Pipeline Run"@x-gmeow-english ;
    rdfs:subClassOf logic:Event ;
    skos:definition "ONE execution of a whole gmeow:Pipeline DAG — a perdurant occurrence (logic:Event) gathering the gmeow:StageExecution occurrences of its stages and, through gmeow:hasStageReceipt, the content-addressed gmeow:StageReceipt of each. The run individual is the replayable record of what happened: its receipts serialize in deterministic TOPOLOGICAL order even when stages ran concurrently, so an interleaved trace replays identically. Distinct from gmeow:Pipeline (the standing plan): a run is a single enactment of that plan."@x-gmeow-english ;
    skos:example "gmeow:run-2026-08-05 a gmeow:PipelineRun ; gmeow:hasStageReceipt gmeow:receipt-canon ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:StageReceipt
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "Stage Receipt"@x-gmeow-english ;
    rdfs:subClassOf gmeow:SocialObject ;
    skos:definition "A content-addressed RECORD of one stage's contribution to a gmeow:PipelineRun: an information object carrying gmeow:receiptDigest (the content address of what the stage produced) and gmeow:receiptOfStage (the gmeow:PipelineStage it is the receipt of). Gathered on the run through gmeow:hasStageReceipt. Receipts serialize in deterministic TOPOLOGICAL order over the DAG even under concurrent execution: two runs whose stages interleaved differently in wall-clock time still emit their receipts in the same topological sequence, so a trace is replayable and two runs are byte-comparable. The digest makes each receipt an immutable, deduplicable fingerprint rather than a timestamped log line."@x-gmeow-english ;
    skos:example "gmeow:receipt-canon a gmeow:StageReceipt ; gmeow:receiptOfStage gmeow:stage-canon ; gmeow:receiptDigest \"blake3:1f9c…\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:hasStageReceipt
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "has stage receipt"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineRun ;
    rdfs:range gmeow:StageReceipt ;
    skos:definition "Relates a gmeow:PipelineRun to each gmeow:StageReceipt it collected — one per stage execution. Multi-valued. The receipts it gathers are serialized in deterministic TOPOLOGICAL order of their stages over the DAG (not wall-clock order), so a run's receipt sequence is replayable and comparable across runs even when execution was concurrent and interleaved."@x-gmeow-english ;
    skos:example "gmeow:run-2026-08-05 gmeow:hasStageReceipt gmeow:receipt-canon ."@x-gmeow-english ;
    gmeow:useWhen "Attach every stage's content-addressed receipt to the run so the run is a replayable, byte-comparable record."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT rely on receipt ASSERTION order for meaning — the serialized order is TOPOLOGICAL, derived from the DAG, not the order triples happen to be written — and do NOT put run-level state on the standing gmeow:Pipeline plan."@x-gmeow-english ;
    gmeow:howToUse "Mint one gmeow:StageReceipt per stage execution with its gmeow:receiptDigest and gmeow:receiptOfStage, and gather them on the gmeow:PipelineRun with gmeow:hasStageReceipt; serialize them in topological order of gmeow:receiptOfStage."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:receiptOfStage
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "receipt of stage"@x-gmeow-english ;
    rdfs:domain gmeow:StageReceipt ;
    rdfs:range gmeow:PipelineStage ;
    skos:definition "Relates a gmeow:StageReceipt to the gmeow:PipelineStage it is the receipt of — the anchor that makes the run's receipts orderable TOPOLOGICALLY over the DAG. Exactly one per receipt: a receipt records one stage's contribution. Distinct from gmeow:receiptOfExecution, which anchors the receipt to the specific occurrence, not the standing stage."@x-gmeow-english ;
    skos:example "gmeow:receipt-canon gmeow:receiptOfStage gmeow:stage-canon ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:receiptDigest
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "receipt digest"@x-gmeow-english ;
    rdfs:domain gmeow:StageReceipt ;
    rdfs:range xsd:string ;
    skos:definition "The CONTENT ADDRESS of what a stage produced — a content-addressed digest string (algorithm-prefixed, e.g. \"blake3:…\") that fingerprints the stage's output. Two executions producing identical output carry the equal digest, so receipts deduplicate and two runs are byte-comparable stage by stage. A stable identifier string, not localizable prose; exactly one per receipt."@x-gmeow-english ;
    skos:example "gmeow:receipt-canon gmeow:receiptDigest \"blake3:1f9c0a…\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── Occurrence wiring: execution ↔ stage, run ↔ execution, receipt ↔ execution ─ #

gmeow:executesStage
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "executes stage"@x-gmeow-english ;
    rdfs:domain gmeow:StageExecution ;
    rdfs:range gmeow:PipelineStage ;
    skos:definition "Relates a gmeow:StageExecution to the ONE gmeow:PipelineStage it is a run of — the standing unit of work this occurrence enacts. Functional: an execution enacts exactly one stage. Where gmeow:PipelineStage is the run-invariant description of a unit of work, gmeow:executesStage names the stage a single gmeow:StageExecution attempted, so a run's occurrences join back to the DAG's stages. Distinct from gmeow:hasStageExecution, which relates the run to its executions, not an execution to its stage."@x-gmeow-english ;
    skos:example "gmeow:exec-annotate-42 gmeow:executesStage gmeow:stage-annotate ."@x-gmeow-english ;
    gmeow:useWhen "Record on every gmeow:StageExecution the gmeow:PipelineStage it enacts, so each occurrence joins to its standing stage in the DAG."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT use it to gather a run's executions (that is gmeow:hasStageExecution on the gmeow:PipelineRun) and do NOT point it at a gmeow:StageReceipt or gmeow:PipelineRun — its range is the standing gmeow:PipelineStage."@x-gmeow-english ;
    gmeow:howToUse "Assert exactly one gmeow:executesStage per gmeow:StageExecution naming the stage it ran; combined with gmeow:hasStageExecution on the run it links occurrence, run, and standing stage."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasStageExecution
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "has stage execution"@x-gmeow-english ;
    rdfs:domain gmeow:PipelineRun ;
    rdfs:range gmeow:StageExecution ;
    skos:definition "Relates a gmeow:PipelineRun to each gmeow:StageExecution it gathered — the perdurant occurrences of its stages, one per attempt. Multi-valued, the occurrence-level companion to gmeow:hasStageReceipt (which gathers the content-addressed records): where a receipt is the immutable fingerprint of what a stage produced, an execution is the run of the stage carrying how the attempt ENDED (gmeow:stageDisposition). Gathering the executions on the run makes the run the replayable record of what happened. Distinct from gmeow:hasStageReceipt, which gathers the content-addressed receipt records rather than the live occurrences."@x-gmeow-english ;
    skos:example "gmeow:run-2026-08-05 gmeow:hasStageExecution gmeow:exec-annotate-42 ."@x-gmeow-english ;
    gmeow:useWhen "Attach every gmeow:StageExecution to the gmeow:PipelineRun it occurred in, so the run gathers its occurrences alongside their receipts."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT put executions on the standing gmeow:Pipeline plan (a run is one enactment) and do NOT conflate it with gmeow:hasStageReceipt — an execution is the occurrence, a receipt is its content-addressed record."@x-gmeow-english ;
    gmeow:howToUse "Mint one gmeow:StageExecution per stage attempt (with its gmeow:executesStage and gmeow:stageDisposition) and gather them on the gmeow:PipelineRun with gmeow:hasStageExecution."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:receiptOfExecution
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "receipt of execution"@x-gmeow-english ;
    rdfs:domain gmeow:StageReceipt ;
    rdfs:range gmeow:StageExecution ;
    skos:definition "Relates a gmeow:StageReceipt to the ONE gmeow:StageExecution whose contribution it records — the occurrence that produced the receipt's gmeow:receiptDigest. Functional: a receipt records exactly one execution. Where gmeow:receiptOfStage anchors the receipt to the standing gmeow:PipelineStage (for topological ordering), gmeow:receiptOfExecution anchors it to the specific occurrence, so a receipt joins to how that attempt ENDED (gmeow:stageDisposition), not only to which stage it was."@x-gmeow-english ;
    skos:example "gmeow:receipt-canon gmeow:receiptOfExecution gmeow:exec-canon-42 ."@x-gmeow-english ;
    gmeow:useWhen "Record on a gmeow:StageReceipt the gmeow:StageExecution it is the receipt of, so the content-addressed record joins to the occurrence's disposition."@x-gmeow-english ;
    gmeow:avoidWhen "Do NOT use it in place of gmeow:receiptOfStage (which anchors the receipt to the standing stage for topological ordering) — a receipt carries both its stage AND its execution."@x-gmeow-english ;
    gmeow:howToUse "Assert exactly one gmeow:receiptOfExecution per receipt naming the execution it records, alongside gmeow:receiptOfStage and gmeow:receiptDigest."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# (6) Runtime-DAG admission constraint — the declared law the graph satisfies. #
#                                                                             #
# Authored in logic: ONLY (a logic:Constraint + logic:Formula), never a hand-  #
# authored SHACL shape. It states FOUR admission expectations of a runtime     #
# DAG: (a) ACYCLICITY, (b) CONNECTIVITY (no unreachable/dead stage), (c) every #
# gmeow:dataflowConsumes satisfied by a producing stage on a preceding path,   #
# and (d) every AUTHORITY edge (gmeow:flowReasonAuthority) satisfied — retained #
# as a first-class ordering a pure-dataflow reducer would wrongly drop. The     #
# first-order-checkable core ((c) producer existence + (d) authority-edge well- #
# formedness/retention) is carried as the logic:Formula; the transitive-closure #
# parts ((a) acyclicity + (b) reachability) are certified by the                #
# logic:DagWorkflowContract the DAG is executed under and disclosed as an       #
# honest logic:expressivenessBoundary (they exceed the base first-order         #
# fragment), never faked as a first-order formula (Principle 17).              #
# =========================================================================== #

gmeow:RuntimeDagAdmissionConstraint
    a logic:Constraint ;
    rdfs:label "Runtime-DAG admission constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The admission law a runtime enrichment DAG must satisfy before it is scheduled, stated as the declared graph's expectations and NOTHING about scheduler mechanism: (a) the gmeow:dataflowConsumes closure is ACYCLIC; (b) every stage is CONNECTED — reachable on the DAG, no unreachable or dead stage; (c) every gmeow:dataflowConsumes edge is SATISFIED by a producing stage on a preceding path; and (d) every AUTHORITY edge (a gmeow:BuildDataFlow with gmeow:flowReason gmeow:flowReasonAuthority) is SATISFIED — retained as a first-class ordering constraint that a pure-dataflow reasoner MUST NOT drop even when no bytes flow. The first-order-checkable core — producer existence (c) and authority-edge well-formedness/retention (d) — is carried by logic:integrity; acyclicity (a) and reachability (b) are transitive-closure properties certified by the logic:DagWorkflowContract the DAG runs under (as gmeow:pipeline-build already is) and disclosed honestly via gmeow:runtimeDagAdmissionBoundary, never faked as a first-order formula."@x-gmeow-english ;
    logic:severity "Violation" ;
    logic:formalizes gmeow:flowReason ;
    rdfs:seeAlso gmeow:runtimeDagAdmissionBoundary ;
    logic:message "A runtime enrichment DAG is admissible only if: (a) its gmeow:dataflowConsumes closure is acyclic; (b) every stage is reachable (no unreachable or dead stage); (c) every gmeow:dataflowConsumes edge is satisfied by a producing stage on a preceding path; and (d) every authority edge (gmeow:flowReason gmeow:flowReasonAuthority) is satisfied — a first-class ordering constraint that MUST be preserved even when no bytes flow. Dropping an authority edge because no data rides it is the corruption this rule forbids." ;
    logic:integrity gmeow:radConj .

# The first-order core: a conjunction of (c) dataflow-producer existence and
# (d) authority-edge well-formedness / retention.
gmeow:radConj a logic:Formula ;
    rdfs:label "Runtime-DAG admission core conjunction"@x-gmeow-english ;
    skos:definition "The first-order core of the runtime-DAG admission law: the conjunction of arm (c) dataflow-producer membership and arm (d) authority-edge retention that logic:integrity carries."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:and gmeow:radDataflowForall , gmeow:radAuthorityForall .

# (c) Every gmeow:dataflowConsumes edge is satisfied by a producing stage that is an
# ASSERTED member of an enclosing pipeline: some gmeow:Pipeline names the producer through
# gmeow:hasStage. This is the first-order shadow of "satisfied by some producer on a
# preceding path" — and it must be an asserted membership, NOT merely producer rdf:type
# gmeow:PipelineStage: gmeow:dataflowConsumes has rdfs:range gmeow:PipelineStage, so a bare
# type check is ENTAILED by RDFS range inference for every consumed relatum and verifies
# nothing. Requiring an explicit gmeow:hasStage membership triple cannot be satisfied by
# that range inference, so the edge must point at a real, declared member stage.
gmeow:radDataflowForall a logic:Formula ;
    rdfs:label "Dataflow producer-membership universal"@x-gmeow-english ;
    skos:definition "The universal over (consumer, producer) asserting arm (c): every consumed producer must be an asserted gmeow:hasStage member of some pipeline."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "consumer" ] , [ logic:termIndex 1 ; logic:termVariable "producer" ] ;
    logic:forall gmeow:radDataflowImpl .
gmeow:radDataflowImpl a logic:Formula ;
    rdfs:label "Dataflow producer-membership implication"@x-gmeow-english ;
    skos:definition "The implication of arm (c): if a consumer gmeow:dataflowConsumes a producer, then that producer is an asserted member stage of some pipeline."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:antecedent gmeow:radConsumes ; logic:consequent gmeow:radProducerMember .
gmeow:radConsumes a logic:Formula ;
    rdfs:label "Dataflow-consumes antecedent atom"@x-gmeow-english ;
    skos:definition "The antecedent atom of arm (c): the consumer stands in gmeow:dataflowConsumes to the producer."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:dataflowConsumes ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "consumer" ] , [ logic:termIndex 1 ; logic:termVariable "producer" ] .
# The producer is an ASSERTED member stage of some pipeline: ∃ pipeline . pipeline gmeow:hasStage producer.
gmeow:radProducerMember a logic:Formula ;
    rdfs:label "Producer pipeline-membership existential"@x-gmeow-english ;
    skos:definition "The existential of arm (c): some gmeow:Pipeline asserts the producer as a member stage."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "pipeline" ] ;
    logic:exists gmeow:radProducerHasStage .
gmeow:radProducerHasStage a logic:Formula ;
    rdfs:label "Producer gmeow:hasStage atom"@x-gmeow-english ;
    skos:definition "The consequent atom of arm (c): some pipeline names the producer through gmeow:hasStage, an asserted membership no RDFS range inference can supply."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:hasStage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "pipeline" ] , [ logic:termIndex 1 ; logic:termVariable "producer" ] .

# (d) Every AUTHORITY edge is a well-formed, RETAINED ordering constraint: an edge
# typed gmeow:BuildDataFlow whose gmeow:flowReason is gmeow:flowReasonAuthority and which
# names a producer (gmeow:buildFlowFrom) MUST also name a consumer (gmeow:buildFlowTo) —
# i.e. it is a complete ordering both of whose ends survive, never a half-edge a
# dataflow reduction could collapse because no entity rides it.
gmeow:radAuthorityForall a logic:Formula ;
    rdfs:label "Authority-edge retention universal"@x-gmeow-english ;
    skos:definition "The universal over (edge, from) asserting arm (d): every authority edge that names a producer must also name a consumer, so the ordering is retained whole."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "edge" ] , [ logic:termIndex 1 ; logic:termVariable "from" ] ;
    logic:forall gmeow:radAuthorityImpl .
gmeow:radAuthorityImpl a logic:Formula ;
    rdfs:label "Authority-edge retention implication"@x-gmeow-english ;
    skos:definition "The implication of arm (d): if an edge is a guarded authority edge naming a producer, then it also names a consumer."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:antecedent gmeow:radAuthorityGuard ; logic:consequent gmeow:radAuthorityConsumer .
gmeow:radAuthorityGuard a logic:Formula ;
    rdfs:label "Authority-edge guard conjunction"@x-gmeow-english ;
    skos:definition "The antecedent guard of arm (d): the conjunction that an edge is typed gmeow:BuildDataFlow, has gmeow:flowReason gmeow:flowReasonAuthority, and names a producer via gmeow:buildFlowFrom."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:and gmeow:radEdgeType , gmeow:radEdgeAuthority , gmeow:radEdgeFrom .
gmeow:radEdgeType a logic:Formula ;
    rdfs:label "Authority-edge type atom"@x-gmeow-english ;
    skos:definition "A guard atom of arm (d): the edge is rdf:type gmeow:BuildDataFlow."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "edge" ] , [ logic:termIndex 1 ; logic:termIri gmeow:BuildDataFlow ] .
gmeow:radEdgeAuthority a logic:Formula ;
    rdfs:label "Authority-edge reason atom"@x-gmeow-english ;
    skos:definition "A guard atom of arm (d): the edge's gmeow:flowReason is gmeow:flowReasonAuthority, marking it an authority ordering."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:flowReason ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "edge" ] , [ logic:termIndex 1 ; logic:termIri gmeow:flowReasonAuthority ] .
gmeow:radEdgeFrom a logic:Formula ;
    rdfs:label "Authority-edge producer atom"@x-gmeow-english ;
    skos:definition "A guard atom of arm (d): the edge names its producer end via gmeow:buildFlowFrom."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:buildFlowFrom ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "edge" ] , [ logic:termIndex 1 ; logic:termVariable "from" ] .
gmeow:radAuthorityConsumer a logic:Formula ;
    rdfs:label "Authority-edge consumer existential"@x-gmeow-english ;
    skos:definition "The consequent existential of arm (d): the authority edge must name some consumer end, so the ordering survives whole rather than as a half-edge."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "to" ] ;
    logic:exists gmeow:radEdgeTo .
gmeow:radEdgeTo a logic:Formula ;
    rdfs:label "Authority-edge consumer atom"@x-gmeow-english ;
    skos:definition "The consequent atom of arm (d): the authority edge names its consumer end via gmeow:buildFlowTo."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:buildFlowTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "edge" ] , [ logic:termIndex 1 ; logic:termVariable "to" ] .

# The honest boundary for the transitive-closure arms (a) acyclicity and (b)
# reachability: both quantify over PATHS in the gmeow:dataflowConsumes closure, which
# the base first-order formula fragment does not express. They are certified instead by
# the logic:DagWorkflowContract the runtime DAG is executed under (the same certification
# gmeow:pipeline-build carries), and the residue is disclosed here rather than faked as a
# first-order formula (Principle 17).
gmeow:runtimeDagAdmissionBoundary
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "runtime-DAG acyclicity/connectivity: an honest transitive-closure boundary"@x-gmeow-english ;
    logic:expressivenessBoundary logic:SecondOrder ;
    logic:preservationKind logic:SoundUnderApproximation ;
    skos:definition "The loss-ledger boundary backing the acyclicity (a) and connectivity/reachability (b) arms of gmeow:RuntimeDagAdmissionConstraint. Both are TRANSITIVE-CLOSURE properties of the gmeow:dataflowConsumes relation — 'no cycle exists on any path' and 'every stage is reachable on some path' quantify over paths of unbounded length, which the base first-order formula fragment does not axiomatize. They are certified by the logic:DagWorkflowContract the runtime DAG is executed under (logic:DagWorkflowResource — the same acyclic-closure certification gmeow:pipeline-build carries), and disclosed here as an honest boundary rather than faked as a first-order formula. Sound-under-approximation: the first-order core (producer existence + authority retention) plus the contract's closure certification together admit exactly the well-formed DAGs, with the closure arms delegated to the certifier, never silently dropped."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Declarative constraint axioms (core slices) — the closed-world
# cardinality / class / datatype obligations the hand-authored shapes.ttl
# NodeShapes state, authored here once as OWL restriction axioms and PROJECTED
# to generated/shapes/validation-shapes.ttl by derive_validation_shapes
# (Principle 17). A restriction carrying both owl:*Cardinality and
# owl:allValuesFrom lowers to the paired sh:minCount/maxCount + sh:class /
# sh:datatype property shape. The cross-node / value-range / disjunctive
# (sh:sparql, sh:or, numeric range, node-shape) conditions have no OWL
# antecedent and remain the procedural fragment .
# =========================================================================== #

gmeow:PipelineStage logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:hasCapability ; logic:allValuesFrom gmeow:StageCapability ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:stageImpl ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:requiresResource ; logic:allValuesFrom gmeow:Resource ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:dataflowConsumes ; logic:allValuesFrom gmeow:PipelineStage ] .

gmeow:Pipeline logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:hasStage ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] .

# Runtime-DAG vocabulary declarative axioms. A gmeow:BuildDataFlow
# carries EXACTLY ONE gmeow:flowReason (required + closed to the three individuals);
# the per-stage/per-execution value properties are closed to their declared sets via
# logic:oneOf (projected declaratively to sh:in), matching the sibling-slice idiom.
gmeow:BuildDataFlow rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:flowReason ; owl:minQualifiedCardinality 1 ; owl:onClass gmeow:FlowReason ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:flowReason ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:FlowReason ] .
gmeow:BuildDataFlow logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:flowReason ; logic:allValuesFrom [ logic:oneOf ( gmeow:flowReasonDataflow gmeow:flowReasonAuthority gmeow:flowReasonCost ) ] ] .
gmeow:StageExecution logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:stageDisposition ; logic:allValuesFrom [ logic:oneOf ( gmeow:dispositionCompleted gmeow:dispositionTypedAbsence gmeow:dispositionRejectedCandidate gmeow:dispositionRetryable gmeow:dispositionFatalToCandidate gmeow:dispositionTimedOut ) ] ] .
gmeow:PipelineStage logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:stageObligation ; logic:allValuesFrom [ logic:oneOf ( gmeow:obligationMandatory gmeow:obligationDegradable ) ] ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:stageStability ; logic:allValuesFrom [ logic:oneOf ( gmeow:stabilityStablePrefix gmeow:stabilityPerTurnVariance ) ] ] .

# exact-one minCount restoration: min-qualified sibling restrictions
# restoring sh:minCount for the reasoner-safe max-qualified exact-one antecedents.
gmeow:PipelineStage logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:stageImpl ; logic:minQualifiedCardinality 1 ; logic:onDataRange xsd:string ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
# gmeow:PipelineShape: gmeow:hasStage is non-functional (min1, no maxCount).
# The min-qualified restriction above now uses onClass owl:Thing (not the
# specific gmeow:PipelineStage), which degrades to the bare sh:minCount 1
# (frontend.rs derive_validation_shapes) instead of a qualified sh:qualifiedMinCount
# — the same fix as the CitationAct/Embedding min1/max1 idiom, here min-only.
# The someValuesFrom restriction below supplies the sh:class PipelineStage half.
gmeow:Pipeline logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:hasStage ; logic:someValuesFrom gmeow:PipelineStage ] .

