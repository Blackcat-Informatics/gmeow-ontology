gmeow:payloadSchemaLangProjectionsArchive
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — lang projections archive"@x-gmeow-english ;
    skos:definition "The lang: projection deliverables under generated/projections/lang/, keyed by repo-relative path: the EBNF/ABNF/GBNF/Lark grammars, the GMN1 example corpus, the CoNLL-U readings, the TEI XML, the SEMAF AMR, the Web-Annotation JSON-LD, and the RDF side formats (a NIF stand-off .nt, the bcp47-tags.ttl tag set). Every one of them is a STANDALONE external-format file a consumer reads, and none reconstructs from a canonical named-graph fold — so they were already opaque byte projections. They ride THIS rep, and no longer the generated-opaque archive, because a rep is the unit a dictionary primes and these deliverables are a distinct external-format family a consumer extracts on its own; the split costs ZERO ontological use, since their lang:ProjectionEmission semantics keep riding the graph/lang-projection-corpus named graph independently. It is primed by gmeow:dictGmeowCoreV1: a linguistic dictionary of its own was measured over exactly this rep plus gmeow:payloadSchemaLangSurfaceBlob and lost by thousands of bytes at every cell of the grid (see the retirement note above), while the core dictionary primes the same frames as part of a population it wins on."@x-gmeow-english ;
    gmeow:payloadSchemaId "lang-projections-archive" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ;
    gmeow:payloadSchemaDictionary gmeow:dictGmeowCoreV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:payloadSchemaLangSurfaceBlob
