msgstr "ex:descriptor gmeow:conditionVerifierKind gmeow:verifierReflectiveAppraisal ."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierWorldObjectExists|http://www.w3.org/2000/01/rdf-schema#label"
msgid "world object exists verifier"
msgstr "vérification d’existence d’objet de monde"

msgctxt "https://blackcatinformatics.ca/gmeow/verifierWorldObjectExists|http://www.w3.org/2004/02/skos/core#definition"
msgid "Verification requiring a cited environment-owned WorldObjectRecord with actual provider, world, object and exact matching provider handle. An expected handle alone does not evidence existence."
msgstr "Vérification exigeant un WorldObjectRecord cité appartenant à l’environnement, avec fournisseur, monde, objet réels et identifiant fournisseur exactement correspondant. Un identifiant attendu seul ne prouve pas l’existence."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierWorldObjectExists|https://blackcatinformatics.ca/gmeow/useWhen"
