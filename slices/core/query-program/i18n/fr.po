msgid "Query score fold index uniqueness"
msgstr "Unicité des indices du repli des scores"

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldIndexUniquenessConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "Steps with the same numeric index in one score are the same step."
msgstr "Les étapes de même indice numérique d’un score sont la même étape."

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldIndexUniquenessConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query score fold index uniqueness with explicit source bindings."
msgstr "Utiliser pour décrire unicité des indices du repli des scores avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldIndexUniquenessConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
