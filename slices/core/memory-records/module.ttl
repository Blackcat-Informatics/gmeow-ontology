                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termVariable "artifact" ] ],
                    [ a logic:Formula ; logic:relation gmeow:epochArchive ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termVariable "artifact" ] ],
                    [ a logic:Formula ; logic:relation gmeow:epochSuccessor ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termVariable "artifact" ] ],
                    [ a logic:Formula ; logic:relation gmeow:epochEvidence ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
