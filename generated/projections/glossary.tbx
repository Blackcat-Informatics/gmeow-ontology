      <termEntry id="c-8304e55bda90e772">
        <langSet xml:lang="en">
          <tig>
            <term>Clifford Anticommutation Witness</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Témoin d'anticommutation de Clifford</term>
