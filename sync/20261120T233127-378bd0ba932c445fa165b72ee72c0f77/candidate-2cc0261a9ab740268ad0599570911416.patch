+
+/// The writer borrows this small shared owner; decoding owns its admitted Arc.
+#[derive(Debug, Clone, PartialEq)]
+pub(in crate::result_rdf) struct ReceiptRecord {
+    pub(in crate::result_rdf) execution: Arc<NativeExecutionEvidence>,
+    pub(in crate::result_rdf) assessment: AssessmentCommitment,
+    pub(in crate::result_rdf) closure: Option<NativeReceiptAddress>,
+}
+
+impl ReceiptRecord {
+    pub(in crate::result_rdf) fn original(
+        result: &ReasoningResult,
+        closure: Option<&NativeReceiptAddress>,
+    ) -> gmeow_errors::Result<Self> {
+        let assessment = result.original_assessment()?;
+        let execution = result.provenance.native_execution.as_ref().ok_or_else(|| {
+            super::super::result_err("native receipt requires its original execution owner".into())
+        })?;
+        Ok(Self {
+            execution: Arc::clone(execution),
+            assessment,
+            closure: closure.cloned(),
+        })
+    }
+}
+
+impl ExecutionCbor for ReceiptRecord {
+    fn check_depth(&self, remaining: usize) -> Result<()> {
+        let remaining = descend(remaining)?;
+        self.execution.check_depth(remaining)?;
+        self.assessment.0.check_depth(remaining)?;
+        if self.closure.is_some() {
+            descend(remaining)?;
+        }
+        Ok(())
+    }
+
+    fn write_cbor<'data, W: LeafWrite<'data> + ?Sized>(&'data self, out: &mut W) -> io::Result<()> {
+        head::write_head(out, head::MAP, 4)?;
+        head::write_text(out, "native_schema")?;
+        head::write_text(out, NATIVE_SCHEMA)?;
+        head::write_text(out, "execution")?;
+        self.execution.write_cbor(out)?;
+        head::write_text(out, "assessment")?;
+        self.assessment.0.write_cbor(out)?;
+        head::write_text(out, "closure")?;
+        match &self.closure {
+            Some(address) => out.string(address.as_str()),
+            None => head::write_head(out, head::SIMPLE, 22),
+        }
+    }
+
+    fn read_cbor(input: &mut Reader<'_>) -> Result<Self> {
+        input.map(|input, length| {
+            if length != 4 {
+                return Err(input.invalid("wrong native receipt binding field count"));
+            }
+            input.field("native_schema")?;
+            if input.text()? != NATIVE_SCHEMA {
+                return Err(input.invalid("native receipt requires the selected native v4 record"));
+            }
+            input.field("execution")?;
+            let execution = ExecutionCbor::read_cbor(input)?;
+            input.field("assessment")?;
+            let assessment = AssessmentCommitment(<[u8; 32]>::read_cbor(input)?);
+            input.field("closure")?;
+            let closure = Option::<String>::read_cbor(input)?
+                .map(|address| {
+                    NativeReceiptAddress::parse(&address).map_err(|cause| {
+                        input.invalid(format!("invalid native closure address: {cause}"))
+                    })
+                })
+                .transpose()?;
+            Ok(Self {
+                execution,
+                assessment,
+                closure,
+            })
+        })
+    }
+}
diff --git crates/logic/src/result_rdf/receipt.rs crates/logic/src/result_rdf/receipt.rs
new file mode 100644
index 000000000..c85021c19
--- /dev/null
+++ crates/logic/src/result_rdf/receipt.rs
@@ -0,0 +1,298 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Immutable binary receipt ownership and explicit content-address resolution.
+
+use crate::execution_cbor::MAX_RECEIPT_BYTES;
+use crate::result::ReasoningResult;
+
+use super::{native, result_err};
+
+/// The complete native receipt's dedicated GTS representation.
+pub const NATIVE_RECEIPT_REPRESENTATION: &str = "native-execution-receipt";
+/// The strict native receipt v1 is a binary CBOR payload.
+pub const NATIVE_RECEIPT_MEDIA_TYPE: &str = "application/cbor";
+
+/// The canonical native GTS address of one complete execution receipt.
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, serde::Serialize, serde::Deserialize)]
+#[serde(try_from = "String", into = "String")]
+pub struct NativeReceiptAddress(String);
+
+impl NativeReceiptAddress {
+    /// Admit the complete canonical `blake3:` spelling.
+    ///
+    /// # Errors
+    /// Rejects another algorithm, length, case or nonhexadecimal digit.
+    pub fn parse(value: &str) -> gmeow_errors::Result<Self> {
+        let Some(digest) = value.strip_prefix("blake3:") else {
+            return Err(result_err(
+                "native receipt address requires blake3:<64 lowercase hex>".into(),
+            ));
+        };
+        if digest.len() != 64
+            || !digest
+                .bytes()
+                .all(|byte| matches!(byte, b'0'..=b'9' | b'a'..=b'f'))
+        {
+            return Err(result_err(
+                "native receipt address requires blake3:<64 lowercase hex>".into(),
+            ));
+        }
+        Ok(Self(value.to_owned()))
+    }
+
+    /// Borrow the canonical interoperable GTS address.
+    #[must_use]
+    pub fn as_str(&self) -> &str {
+        &self.0
+    }
+
+    /// The native GTS identity of already owned bytes; semantic admission is separate.
+    #[must_use]
+    pub fn of_bytes(bytes: &[u8]) -> Self {
+        Self(purrdf::gts::wire::digest_str(bytes))
+    }
+}
+
+impl TryFrom<String> for NativeReceiptAddress {
+    type Error = gmeow_errors::Diag;
+
+    fn try_from(value: String) -> Result<Self, Self::Error> {
+        Self::parse(&value)
+    }
+}
+
+impl From<NativeReceiptAddress> for String {
+    fn from(value: NativeReceiptAddress) -> Self {
+        value.0
+    }
+}
+
+impl std::borrow::Borrow<str> for NativeReceiptAddress {
+    fn borrow(&self) -> &str {
+        self.as_str()
+    }
+}
+
+enum ReceiptBytes<'a> {
+    Owned(Vec<u8>),
+    Borrowed(&'a [u8]),
+}
+
+/// A publication's one owned buffer, or an explicit borrow of that same buffer.
+/// Cloning a publication cannot accidentally duplicate its payload: this type
+/// deliberately implements no `Clone`.
+#[must_use]
+pub struct NativeReceipt<'a> {
+    address: NativeReceiptAddress,
+    bytes: ReceiptBytes<'a>,
+    closure: Option<NativeReceiptAddress>,
+}
+
+impl NativeReceipt<'static> {
+    pub(super) fn from_admitted_payload(
+        address: NativeReceiptAddress,
+        bytes: Vec<u8>,
+        closure: Option<NativeReceiptAddress>,
+    ) -> Self {
+        Self {
+            address,
+            bytes: ReceiptBytes::Owned(bytes),
+            closure,
+        }
+    }
+
+    pub(super) fn publish(
+        result: &ReasoningResult,
+        closure: Option<&NativeReceiptAddress>,
+    ) -> gmeow_errors::Result<Self> {
+        let record = native::ReceiptRecord::original(result, closure)?;
+        let started = crate::timing::Instant::now();
+        tracing::info!(target: "pipeline_phase", stage = "stage-reason", phase = "encode-native-reasoning-receipt", event = "start", "reason phase boundary");
+        let bytes = native::encode(&record)?;
+        tracing::info!(target: "pipeline_phase", stage = "stage-reason", phase = "encode-native-reasoning-receipt", event = "end", elapsed_ms = started.elapsed().as_millis(), encoded_bytes = bytes.len(), "reason phase boundary");
+        let address = NativeReceiptAddress::of_bytes(&bytes);
+        // This same-run equality covers every original source/proof field before
+        // any RDF summary normalization. Canonical replay is validation, separate
+        // from the one publication-buffer encoding above.
+        let authenticated = NativeReceiptRef::admit(&address, &bytes)?;
+        authenticated.admit_result(result)?;
+        Ok(Self {
+            address,
+            bytes: ReceiptBytes::Owned(bytes),
+            closure: record.closure,
+        })
+    }
+}
+
+impl<'a> NativeReceipt<'a> {
+    pub(super) fn borrowed(
+        value: NativeReceiptRef<'a>,
+        closure: Option<NativeReceiptAddress>,
+    ) -> Self {
+        Self {
+            address: value.address.clone(),
+            bytes: ReceiptBytes::Borrowed(value.bytes),
+            closure,
+        }
+    }
+
+    pub(super) fn closure(&self) -> Option<&NativeReceiptAddress> {
+        self.closure.as_ref()
+    }
+
+    /// Borrow the exact immutable payload and its typed address.
+    #[must_use]
+    pub fn as_ref(&self) -> NativeReceiptRef<'_> {
+        let bytes = match &self.bytes {
+            ReceiptBytes::Owned(bytes) => bytes.as_slice(),
+            ReceiptBytes::Borrowed(bytes) => bytes,
+        };
+        NativeReceiptRef {
+            address: &self.address,
+            bytes,
+        }
+    }
+
+    /// Move the initial publication buffer into its declared artifact owner.
+    ///
+    /// # Errors
+    /// A borrowed publication cannot transfer its owner's buffer.
+    pub fn into_owned_bytes(self) -> gmeow_errors::Result<Vec<u8>> {
+        match self.bytes {
+            ReceiptBytes::Owned(bytes) => Ok(bytes),
+            ReceiptBytes::Borrowed(_) => Err(result_err(
+                "native receipt buffer transfer requires its original publication owner".into(),
+            )),
+        }
+    }
+
+    pub(super) fn into_emission_bytes(self) -> Vec<u8> {
+        match self.bytes {
+            ReceiptBytes::Owned(bytes) => bytes,
+            // The final native BlobRow/writer owns its payload. This is the
+            // explicit terminal copy of a borrowed internal artifact.
+            ReceiptBytes::Borrowed(bytes) => bytes.to_vec(),
+        }
+    }
+}
+
+/// A receipt view whose lifetime follows the actual immutable payload owner.
+#[derive(Clone, Copy)]
+pub struct NativeReceiptRef<'a> {
+    address: &'a NativeReceiptAddress,
+    bytes: &'a [u8],
+}
+
+impl<'a> NativeReceiptRef<'a> {
+    /// Admit the complete native record and constructor assessment against this
+    /// result. Shared deserialized values gain retained-receipt reuse authority,
+    /// never original-closure publication authority. Returns the immutable closure
+    /// attachment selected by the exact supplied receipt.
+    ///
+    /// # Errors
+    /// Refuses malformed records, different execution or assessment fields, and
+    /// replacement of an already admitted receipt or closure selection.
+    pub fn admit_result(
+        self,
+        result: &ReasoningResult,
+    ) -> gmeow_errors::Result<Option<NativeReceiptAddress>> {
+        if let Some(closure) = result.retained_receipt_selection(self.address())? {
+            return Ok(closure.clone());
+        }
+        let decoded = native::decode(self.bytes())?;
+        result.admit_native_receipt(
+            decoded.assessment,
+            &decoded.execution,
+            self.address(),
+            decoded.closure.as_ref(),
+        )?;
+        Ok(decoded.closure)
+    }
+
+    /// Authenticate a retained artifact against its declared typed address.
+    /// Native schema/semantic admission remains the result reader's responsibility.
+    ///
+    /// # Errors
+    /// Rejects over-budget or differently addressed bytes.
+    pub fn admit(address: &'a NativeReceiptAddress, bytes: &'a [u8]) -> gmeow_errors::Result<Self> {
+        if bytes.len() > MAX_RECEIPT_BYTES {
+            return Err(result_err(format!(
+                "native receipt {} has {} bytes, exceeding the compact limit {MAX_RECEIPT_BYTES}",
+                address.as_str(),
+                bytes.len(),
+            )));
+        }
+        if purrdf::gts::wire::digest_str(bytes) != address.as_str() {
+            return Err(result_err(format!(
+                "native receipt bytes do not match {}",
+                address.as_str()
+            )));
+        }
+        Ok(Self { address, bytes })
+    }
+
+    /// The authenticated GTS content address.
+    #[must_use]
+    pub fn address(self) -> &'a NativeReceiptAddress {
+        self.address
+    }
+
+    /// The complete compact native CBOR bytes, never hexadecimal text.
+    #[must_use]
+    pub fn bytes(self) -> &'a [u8] {
+        self.bytes
+    }
+}
+
+/// Every reader explicitly names the authority that supplies required bytes.
+pub trait NativeReceiptResolver {
+    /// Resolve exactly this address; missing bytes are an actionable failure.
+    fn resolve(&self, address: &NativeReceiptAddress) -> gmeow_errors::Result<&[u8]>;
+
+    /// Admit the required isolated closure against the same execution's catalog.
+    /// Receipt-only authorities fail closed when a selected result requires it.
+    fn admit_closure(
+        &self,
+        address: &NativeReceiptAddress,
+        _worlds: &[crate::physical::LogicalGraph],
+    ) -> gmeow_errors::Result<()> {
+        Err(result_err(format!(
+            "required RDF closure {} is absent",
+            address.as_str()
+        )))
+    }
+}
+
+impl NativeReceiptResolver for NativeReceiptRef<'_> {
+    fn resolve(&self, address: &NativeReceiptAddress) -> gmeow_errors::Result<&[u8]> {
+        if self.address != address {
+            return Err(result_err(format!(
+                "native receipt {} is not supplied",
+                address.as_str()
+            )));
+        }
+        Ok(self.bytes)
+    }
+}
+
+/// An explicit authority for operations that executed no native closure.
+pub struct NoNativeReceipts;
+
+impl NativeReceiptResolver for NoNativeReceipts {
+    fn resolve(&self, address: &NativeReceiptAddress) -> gmeow_errors::Result<&[u8]> {
+        Err(result_err(format!(
+            "required native receipt {} is absent",
+            address.as_str()
+        )))
+    }
+}
+
+impl NativeReceiptResolver for Option<NativeReceiptRef<'_>> {
+    fn resolve(&self, address: &NativeReceiptAddress) -> gmeow_errors::Result<&[u8]> {
+        match self {
+            Some(receipt) => receipt.resolve(address),
+            None => NoNativeReceipts.resolve(address),
+        }
+    }
+}
diff --git crates/logic/src/result_rdf/reference_vectors.rs crates/logic/src/result_rdf/reference_vectors.rs
new file mode 100644
index 000000000..9e60d3e80
--- /dev/null
+++ crates/logic/src/result_rdf/reference_vectors.rs
@@ -0,0 +1,186 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Explicit reference production, separate from read-only codec checks.
+
+use std::sync::Arc;
+
+use purrdf::{RdfDatasetBuilder, RdfQuad, RdfTerm, TermValue};
+
+use super::{native, result_err};
+use crate::physical::{DomainProfile, LogicalGraph, SelectedDomains, SelectedLogicalWorld};
+use crate::reason::refute::{
+    BoundKind, NativeBoundEvidence, NativeFamilyCompletion, NativeFamilyOutcome,
+    NativeObligationScope, NativeProofOrigin, NativeRefutationFamily,
+};
+use crate::result::{InformationState, ReasoningResult};
+
+#[derive(Clone, Copy)]
+enum BoundaryProfile {
+    Ordinary,
+    Directional,
+    WideCardinality,
+}
+
+impl BoundaryProfile {
+    const ALL: [Self; 3] = [Self::Ordinary, Self::Directional, Self::WideCardinality];
+
+    const fn wire(self) -> &'static str {
+        match self {
+            Self::Ordinary => "ordinary",
+            Self::Directional => "directional",
+            Self::WideCardinality => "ordinary-u128",
+        }
+    }
+}
+
+fn conflict_result() -> gmeow_errors::Result<ReasoningResult> {
+    let mut source = RdfDatasetBuilder::new();
+    source.push_owned_quad(&RdfQuad::new(
+        RdfTerm::iri("urn:gmeow:test:conflicting-individual"),
+        "https://blackcatinformatics.ca/logic/instanceOf",
+        RdfTerm::iri("https://blackcatinformatics.ca/logic/Nothing"),
+    ))?;
+    let source = source.freeze()?;
+    let input = crate::reason::prepare_reasoning_input(&source)?;
+    let domains = SelectedDomains::new([SelectedLogicalWorld::new(
+        LogicalGraph::Default,
+        DomainProfile::NonemptyObjectDomainV1,
+        "urn:gmeow:test:result-provenance-domain".into(),
+        *input.ingress_contract(),
+    )?])?;
+    let result = crate::reason::reason_all(input, &domains)?;
+    result.validate_native_closure()?;
+    if result.information != InformationState::Both {
+        return Err(result_err(
+            "native reference source did not retain its asserted conflict".into(),
+        ));
+    }
+    Ok(result)
+}
+
+/// Alter codec data while retaining the source assessment as opaque metadata.
+/// These packets never acquire Original authority or semantic result admission.
+fn boundary_packet(
+    original: &native::ReceiptRecord,
+    profile: BoundaryProfile,
+    depth: usize,
+) -> gmeow_errors::Result<native::ReceiptRecord> {
+    let mut execution = original.execution.as_ref().clone();
+    if matches!(profile, BoundaryProfile::WideCardinality) {
+        execution
+            .families
+            .first_mut()
+            .ok_or_else(|| result_err("native reference has no selected family ledger".into()))?
+            .outcomes
+            .push(NativeFamilyOutcome {
+                family: NativeRefutationFamily::Cardinality,
+                obligation: NativeObligationScope::World,
+                bounds: vec![NativeBoundEvidence {
+                    owner: TermValue::iri("urn:gmeow:test:capture-bound-owner"),
+                    predicate: "urn:gmeow:test:capture-bound".into(),
+                    value: TermValue::Literal {
+                        lexical_form: "18446744073709551616".into(),
+                        datatype: "http://www.w3.org/2001/XMLSchema#nonNegativeInteger".into(),
+                        language: None,
+                        direction: None,
+                    },
+                    kind: BoundKind::Max,
+                    interpreted: Some(u128::from(u64::MAX) + 1),
+                    qualifier: None,
+                    capacity: Some(u128::MAX),
+                    support: Vec::new(),
+                }],
+                conclusions: Vec::new(),
+                obstructions: Vec::new(),
+                publication_reads: Vec::new(),
+                completion: NativeFamilyCompletion::NotEngaged,
+            });
+    }
+    let directional = matches!(profile, BoundaryProfile::Directional);
+    let mut object = TermValue::Literal {
+        lexical_form: "receipt depth boundary".into(),
+        datatype: if directional {
+            "http://www.w3.org/1999/02/22-rdf-syntax-ns#dirLangString"
+        } else {
+            "http://www.w3.org/2001/XMLSchema#string"
+        }
+        .into(),
+        language: directional.then(|| "ar".into()),
+        direction: directional.then_some(purrdf::RdfTextDirection::Rtl),
+    };
+    for _ in 0..depth {
+        object = TermValue::Triple {
+            s: TermValue::iri("urn:gmeow:test:receipt-subject").into(),
+            p: TermValue::iri("urn:gmeow:test:receipt-predicate").into(),
+            o: object.into(),
+        };
+    }
+    let source_object = execution
+        .families
+        .iter_mut()
+        .flat_map(|ledger| &mut ledger.proofs)
+        .find_map(|proof| match &mut proof.origin {
+            NativeProofOrigin::Asserted { sources, .. } => {
+                sources.first_mut().map(|source| &mut source.object)
+            }
+            _ => None,
+        })
+        .ok_or_else(|| {
+            result_err("native reference source has no retained asserted premise".into())
+        })?;
+    *source_object = object;
+    Ok(native::ReceiptRecord {
+        execution: Arc::new(execution),
+        assessment: original.assessment,
+        closure: original.closure.clone(),
+    })
+}
+
+/// Produce the one current native receipt reference family from a genuine tiny
+/// constructor-owned conflict and twelve deliberately altered codec boundaries.
+/// Only the original row is semantic execution evidence. Profile/depth rows
+/// record strict codec emission and readback, never semantic re-admission.
+///
+/// # Errors
+/// Refuses failed source execution, unexpected codec failures or changed readback.
+pub fn native_receipt_reference_vectors() -> gmeow_errors::Result<String> {
+    let result = conflict_result()?;
+    let original = native::ReceiptRecord::original(&result, None)?;
+    let wire = native::encode(&original)?;
+    if native::decode(&wire)? != original {
+        return Err(result_err(
+            "native reference original changed during codec readback".into(),
+        ));
+    }
+    let mut rows = format!("conflict|{}\n", purrdf_hash::hex::encode(&wire));
+    for profile in BoundaryProfile::ALL {
+        for depth in 25..=28 {
+            let packet = boundary_packet(&original, profile, depth)?;
+            rows.push_str(profile.wire());
+            rows.push('|');
+            rows.push_str(&depth.to_string());
+            match native::encode(&packet) {
+                Ok(encoded) => {
+                    if native::decode(&encoded)? != packet {
+                        return Err(result_err(
+                            "native codec boundary changed during reference readback".into(),
+                        ));
+                    }
+                    rows.push_str("|admitted|admitted|");
+                    rows.push_str(&purrdf_hash::hex::encode(&encoded));
+                    rows.push('|');
+                }
+                Err(error) if error.message().contains("typed admission bound") => {
+                    rows.push_str("|refused|not-run||");
+                    rows.push_str(error.message());
+                }
+                Err(error) => {
+                    return Err(error.with_context("produce native receipt codec reference"));
+                }
+            }
+            rows.push('\n');
+        }
+    }
+    Ok(rows)
+}
