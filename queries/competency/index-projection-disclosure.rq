# Competency question: "Which properties may a geospatial index derive cells from,
# and under which disclosure marks?"
# Expected: the places key-source properties eligible for gmeow:consumerIndexProjection
# (coordinates, geometry, serializations, frame), each annotated with whether it is
# gmeow:coarsenGuarded. Normative ruling (issue #1677): an index built over a
# coarsenGuarded key-source property is itself guarded, so any projection of that index
# disclosed to gmeow:consumerPublicSite MUST coarsen to the guarded granularity first.

PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>

SELECT ?property ?guarded WHERE {
    ?property gmeow:useForConsumer gmeow:consumerIndexProjection .
    BIND(EXISTS { ?property gmeow:coarsenGuarded true } AS ?guarded)
}
ORDER BY ?property
