gmeow:QueryCandidateUnion logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:mergeAnswerInput ; logic:allValuesFrom gmeow:RankedQueryList ],
    [ a logic:Restriction ; logic:onProperty gmeow:mergeAnswerOutput ; logic:allValuesFrom gmeow:QueryUnionAnswer ] .

