@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:eqClasses007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Agent ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject foaf:Agent ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses008 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Agent ;
    gmeow:alignPredicate owl:equivalentClass ;
