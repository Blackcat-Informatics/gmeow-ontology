gmeow:stage-export-lpg
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: LPG"@x-gmeow-english ;
    skos:definition "Emit the labeled-property-graph artifacts — generic CSV, Neo4j Admin Import CSV, openCypher, and GraphML 1.0 — via purrdf's native LPG projections (project_lpg_csv/project_neo4j_csv/project_lpg_cypher/project_lpg_graphml), retiring gmeow's hand-rolled node/edge model and CSV/Cypher/GraphML writers. The projected view is the carrier's graph/statements named graph ONLY, scoped via purrdf's project_named_graph_full (plus the RDF-1.2 reifiers/annotations attached to those statements-graph triples) — the same business-layer typed-resource scope the retired hand-rolled emitter used, never the whole composed carrier. A fold-reading export leaf: reads the gmeow:stage-snapshot bundle directly, never the gts bytes (GTS is exit-only)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "lpg" ;
    gmeow:dataflowConsumes gmeow:stage-snapshot ;
    gmeow:producesFormat "lpg-csv" , "lpg-neo4j-csv" , "lpg-cypher" , "lpg-graphml" .

gmeow:stage-export-yaml-ld
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "export: yaml ld"@x-gmeow-english ;
    skos:definition "Emit the YAML-LD-star and JSON-LD-star serializations of the composed dataset by folding THIS run's snapshot."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "yaml_ld" ;
    gmeow:dataflowConsumes gmeow:stage-snapshot ;
    gmeow:producesFormat "yaml-ld" ;
    gmeow:producesFormat "json-ld" ;
    gmeow:requiresResource gmeow:serializationBufferResource .

# ── The by-reference archive fold ──

gmeow:stage-archive-blobs
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "archive blobs"@x-gmeow-english ;
    skos:definition "Fold the eleven by-reference TAR archives a repo-free consumer reads back out of gmeow.gts — mappings-archive (the compiled SSSOM lift maps), cells-archive (the mapping-DSL cell sources), queries-archive (the generated SPARQL surface), tests-archive (the slice test-DSL specs), schemas-archive (the SHACL-derived JSON Schema and OpenAPI plus the two hand-authored self-describing schemas), shapes-archive (the FULL SHACL shape surface: authored shapes, per-slice shapes, and the generated shape projections), axioms-archive (the small committed logic/DL projections), lang-projections-archive (the whole lang: deliverable family: the generated/projections/lang/ external-format tree plus the two non-RDF terminology surfaces gmeow:stage-export-glossary projects, on their own rep because a rep is the unit a dictionary primes and these are one external-format family a consumer extracts on its own), statements-archive (the RDF 1.2 statement layer's two byte-decorated committed projections, compiled once by gmeow:stage-statements and only tarred here, on their own rep for the same reason), yaml-ld-archive (the claim corpus's JSON-LD-star and YAML-LD-star projections, rendered once by gmeow:stage-statements and only tarred here), and models-python (the generated Pydantic package) — and attach each to this stage's product on its own blob-representation lane. It is the SINGLE authority on archive membership: every generated member is sourced from an in-memory producer product (gmeow:stage-compile-logic, gmeow:stage-mappings, gmeow:stage-export-glossary, gmeow:stage-export-json-schema, gmeow:stage-export-pydantic, gmeow:stage-statements, and the three generated-shape export leaves), never from a committed generated/ file, which is not flushed until the post-run reconcile returns; only genuinely authored trees (dsl/mappings, the per-slice tests and shapes, and the top-level shapes directory) are read from source, and every one of them is declared as a raw cache input. The fold ran INSIDE the terminal sink before, so the archives did not exist as a product until the last node of the graph and any consumer of them would have closed a cycle; as its own stage they are available mid-graph, and the terminal now READS them instead of re-folding (the transform-once razor). A missing producer artifact or an archive that would fold empty is a HARD FAIL, never a degraded partial archive."@x-gmeow-english ;
    skos:example "gmeow:stage-archive-blobs a gmeow:PipelineStage ; gmeow:stageImpl \"archive-blobs\" ; gmeow:attachesBlobRep \"cells-archive\" ."@x-gmeow-english ;
    skos:scopeNote "Scope: this stage covers the FOLD of the eleven by-reference TAR archives onto its own product's blob-representation lanes, and nothing else. It does not render any member — every generated member arrives from its producing leaf's in-memory product, so rendering one here would be a second producer of those bytes — it does not train or pin dictionaries and does not seal envelopes (gmeow:stage-medium-dictionaries and gmeow:stage-gts-sink own those), and it does not write gmeow.gts: the terminal READS these archives rather than re-folding them."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:useWhen "Use when a repo-free consumer must be able to extract a whole generated family out of gmeow.gts as one archive, and when that family has to exist MID-DAG so a later stage — the dictionary trainer, the terminal — can read it instead of closing a cycle against the sink."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid sourcing a generated member from a committed generated/ file (nothing is flushed until the post-run reconcile returns, so the read would race the write), avoid rendering a member here rather than in its producing leaf, and avoid letting an archive fold empty — a missing producer artifact is a HARD FAIL, not a smaller archive."@x-gmeow-english ;
    gmeow:howToUse "Declare the producing leaf on gmeow:dataflowConsumes, read its product in memory, and attach the tarred result under its own gmeow:attachesBlobRep lane; a rep is the unit a gmeow:CompressionDictionary primes, so give a family its own lane when it is meant to be primed or extracted on its own."@x-gmeow-english ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "archive-blobs" ;
    gmeow:dataflowConsumes
        gmeow:stage-compile-logic ,
        gmeow:stage-export-constraint-shapes ,
        gmeow:stage-export-frame-shapes ,
        gmeow:stage-export-glossary ,
        gmeow:stage-export-json-schema ,
        gmeow:stage-export-pydantic ,
        gmeow:stage-export-result-shapes ,
        gmeow:stage-mappings ,
        gmeow:stage-statements .

# ── The medium axis: the shipped zstd dictionaries ──

gmeow:stage-medium-dictionaries
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "medium dictionaries"@x-gmeow-english ;
    skos:definition "Train the seven declared gmeow:CompressionDictionary definitions over their declared gmeow:DictionaryCorpus selectors, measure each into a gmeow:CompressionDictionaryRealization (content digest, byte length, zstd Dictionary_ID, measured strategy, measured target length), and attach the result as the build-time graph/medium-registry named graph. It is the SINGLE producer of the bundle's dictionaries: the terminal reads its product to pin them in the shipped segment header's in-band dct map and to seal one gmeow:MediumEnvelope per emitted frame. Its dataflow edges are DERIVED from the shipped corpora rather than chosen — the archive-rep selectors resolve against gmeow:stage-archive-blobs, the one sink-folded corpus (proof trace) selects the gmeow:stage-reason product directly because its archive exists only at the terminal, and the named-graph and generated-path selectors resolve against the assembled carrier (gmeow:stage-snapshot) and gmeow:stage-statements. Each archive-backed corpus is resolved under the declared gmeow:CorpusTrainingSplit, so the trainer sees a PROPER SUBSET of the archive's members and the tar the dictionary is later evaluated over still carries the rest; the identity of the whole resolution is recorded as gmeow:measuredCorpusDigest and checked against the committed sweep evidence, so a table measured over a corpus this build did not resolve REDS (gmeow:MediumCorpusDrift) rather than grading. A corpus that resolves to nothing, an archive-backed corpus the split holds nothing out of, a selector this build cannot evaluate, or a selector that reaches the medium pass's own output are each a HARD FAIL, never a silently smaller training set. The trained bytes ride an INTERNAL pipeline/ byte-artifact family rather than a committed generated/ file: a dictionary's shipping channel is the segment header, and a second on-disk copy would oblige the superset gate to reconstruct bytes the bundle already carries in band."@x-gmeow-english ;
    skos:example "gmeow:stage-medium-dictionaries a gmeow:PipelineStage ; gmeow:stageImpl \"medium-dictionaries\" ; gmeow:dataflowConsumes gmeow:stage-archive-blobs ."@x-gmeow-english ;
    skos:scopeNote "Scope: this stage covers TRAINING and MEASURING the declared dictionaries into the graph/medium-registry named graph — what the shipped dictionaries ARE. It does not decide which payload rep uses which dictionary (that is authored on gmeow:PayloadSchema, never derived here), it does not pin them into the shipped segment header or seal a gmeow:MediumEnvelope (gmeow:stage-gts-sink does both), and it does not price them: whether a dictionary pays for itself is measured at the terminal into graph/medium-measurement, because only there does the whole emitted frame set exist."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:useWhen "Use when the bundle's compression dictionaries must exist as a mid-DAG product — trained once, measured once, and readable by the terminal and by any consumer of graph/medium-registry — rather than as bytes a writer conjures at emission time."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a corpus selector that reaches this stage's own output (a dictionary trained on itself is a cycle, not a better dictionary), avoid a corpus that resolves to nothing or an archive-backed corpus the split holds nothing out of, and avoid writing the trained bytes to a committed generated/ file — their shipping channel is the segment header, so a second on-disk copy obliges the superset gate to reconstruct bytes the bundle already carries in band."@x-gmeow-english ;
    gmeow:howToUse "Let its gmeow:dataflowConsumes edges follow from the shipped corpora rather than picking them: an archive-rep selector implies gmeow:stage-archive-blobs, a sink-folded corpus implies its producing stage, and a named-graph or generated-path selector implies the assembled carrier. Read its product from graph/medium-registry and compare each gmeow:measuredCorpusDigest against the committed sweep evidence before trusting any number taken from it."@x-gmeow-english ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "medium-dictionaries" ;
    gmeow:dataflowConsumes
        gmeow:stage-archive-blobs ,
        gmeow:stage-reason ,
        gmeow:stage-snapshot ,
        gmeow:stage-statements .

# ── The single serialization exit (the gts narrow waist) ──

gmeow:stage-gts-sink
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "gts sink"@x-gmeow-english ;
    skos:definition "The terminal gts ARCHIVE writer (the ONE canonical exit / narrow waist): serialize the assembled carrier to generated/dist/gmeow.gts. GTS is exit-only — produced here and nowhere else; every fold-reading export leaf reads the carrier dataset off the gmeow:stage-snapshot bundle, never these bytes. The carrier is taken off the snapshot bundle (no re-assembly — the razor: transform transport→form at most once). The eleven by-reference TAR archives are READ off the gmeow:stage-archive-blobs product, folded once by that stage and never re-folded here; the terminal staples only the blob channels it alone can see: the document-scale language surface blobs, the native reasoning reports (gmeow:stage-reason), the opaque generated/ fanout archive over THIS run's carrier, the typed SHACL/ShEx validation sidecars (gmeow:stage-compile-logic), and the SHACL diagnostics SARIF/findings (gmeow:stage-validate). The embedded executable-docs 'try it' surface reasons over the object-level EDB, whose authored self-description graphs ride on gmeow:stage-source-load (read, never re-loaded). The opaque fanout members (references, bench, agreement matrix, apache config, matrix, eval/research-object sidecars, metadata void/dcat, the LinkML/TypeScript/GraphQL developer schema surfaces) ride in from their producing export leaves — rendered once, in the leaf, never re-rendered in the terminal (the transform-once razor) It is also where the MEDIUM's dictionary-effect measurement is taken and folded: the terminal is the one point at which the emission's whole BLOB frame set exists, so the two-part code of every shipped dictionary (gmeow:MediumDictionaryEffectMeasurement in graph/medium-measurement, plus its graph/fanout twin for generated/medium/dictionary-effect.ttl) is measured over exactly the frames it is about to write, on the mandated chain. The SNAPSHOT frame is excluded from that population by declaration — the measurement lands in the snapshot payload, so pricing that frame would make the reading self-referential — and that exclusion is permanent rather than a gap the two-pass gmeow:envelopeDigestStratum fixpoint could close: the digest fixpoint converges only because gmeow:strataDigest is taken over a REGION that excludes the added records, while a compressed LENGTH has no such region (compression is not additive over regions, so no proper sub-region's length equals the frame's, and a length over 'the payload minus the measurement subgraph' would describe bytes the bundle never writes). It is moot for the inventory in any case, because gmeow:payloadSchemaDictionary is maxQualifiedCardinality 1 and the snapshot schema binds exactly gmeow:dictGmeowCoreV1. A dictionary that does not pay for itself stops the emission with gmeow:MediumDictionaryRegression rather than shipping."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "gts_sink" ;
    gmeow:hasCapability gmeow:sinkCapability ;
    gmeow:dataflowConsumes
        gmeow:stage-archive-blobs ,
        gmeow:stage-medium-dictionaries ,
        gmeow:stage-snapshot ,
        gmeow:stage-source-load ,
        gmeow:stage-export-agreement ,
        gmeow:stage-export-apache ,
        gmeow:stage-export-bench ,
        gmeow:stage-export-cost-ledger ,
        gmeow:stage-export-evals ,
        gmeow:stage-export-glossary ,
        gmeow:stage-export-matrix ,
        gmeow:stage-export-metadata ,
        gmeow:stage-export-references ,
        gmeow:stage-export-research-objects ,
        gmeow:stage-export-schemas ,
        gmeow:stage-export-governance-floors ,
        gmeow:stage-export-projection-ceilings ,
        gmeow:stage-compile-logic ,
        gmeow:stage-mappings ,
        gmeow:stage-reason ,
        gmeow:stage-validate .

# =========================================================================== #
# Stage attach declarations (gmeow:attachesGraph / gmeow:attachesBlobRep) —    #
# the named graphs / blob-rep lanes each stage contributes to the carrier as   #
# its delta. The Rust twin (stages/attach.rs) is the single Rust-side source;  #
# these triples mirror it and the dogfooding gate (tests/dag_dogfood.rs, via   #
# bind) HARD-fails on any divergence. Captured empirically from a full run's   #
# attach delta so the scheduler's global bidirectional AttachDrift check has    #
# zero false positives.                                                        #
# =========================================================================== #

gmeow:stage-source-load
