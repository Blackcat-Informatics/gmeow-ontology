gmeow:DriveHistoryClauseConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agentic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "drive history clause constraint"@x-gmeow-english ;
    skos:definition "Requires each selected drive-history clause to be an actual Formula fact with a relation and no supplied quantifier or connective constructor at its root."@x-gmeow-english ;
    skos:scopeNote "Complete Formula and carrier admission remains with Logic; selecting a fact does not assert complete history or execute it."@x-gmeow-english ;
    skos:example "A selected history root carrying an implication constructor violates this fact-only contract."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish supplied history facts from derivation rules."@x-gmeow-english ;
    gmeow:avoidWhen "Do not linearize partial order, count duplicate triples as occurrences or fabricate a source event."@x-gmeow-english ;
    gmeow:howToUse "Inspect the actual selected Formula root and preserve its source context and record identity."@x-gmeow-english ;
    logic:formalizes gmeow:driveHistoryClause ;
    logic:message "Requires each selected drive-history clause to be an actual Formula fact with a relation and no supplied quantifier or connective constructor at its root."@x-gmeow-english ;
    logic:integrity _:driveDriveHistoryClauseConstraint1 .

