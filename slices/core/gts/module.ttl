# --- The registered payload-schema vocabulary ------------------------------- #
# ONE individual per blob representation the carrier can emit, plus one for the
# snapshot wire schema. This registry is the reason an UNREGISTERED rep is a
# genuine production hard fail (gmeow:MediumUnknownSchema) instead of a value a
# reader derives from the frame: a rep read back as an opaque string would decode
# as "some blob" and its medium assignment would be undefined, so the registry —
# not the frame — is the authority. gmeow:payloadSchemaId carries the EXACT wire
# label the emitter writes, and the registry-agreement test enumerates the
# carrier's representation constants against these literals, so adding an archive
# in Rust without registering its schema here reds.

gmeow:payloadSchemaAxiomsArchive
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — axioms archive"@x-gmeow-english ;
    skos:definition "The compiled logic/DL projection surface, keyed by repo-relative path."@x-gmeow-english ;
    gmeow:payloadSchemaId "axioms-archive" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ;
    gmeow:payloadSchemaDictionary gmeow:dictGmeowLogicV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:payloadSchemaCellsArchive
    a gmeow:PayloadSchema ;
