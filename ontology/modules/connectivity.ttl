@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/connectivity>
    a owl:Ontology ;
    rdfs:label "GMEOW Connectivity Module"@x-gmeow-english ;
    skos:definition "The GMEOW Connectivity Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> ;
    rdfs:comment "Universal connectivity, network, and routing constructs — traversable links, reified connections, and route paths. Distinct from mereology (partOf) and RCC-8 adjacency. Part of the #42 Location-as-reference-frame epic."@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Connection relator — reified traversable link (flat shortcut: connectsTo)
# --------------------------------------------------------------------------- #

gmeow:Connection
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Connection"@x-gmeow-english ;
    skos:definition "A reified traversable link between two entities, able to bear its own period, cost, weight, bandwidth, confidence, and standpoint. The flat shortcut is gmeow:connectsTo; promote to Connection when metadata matters."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

gmeow:connectionSource
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Connection ;
    rdfs:range owl:Thing ;
    rdfs:label "connection source"@x-gmeow-english ;
    skos:definition "The source of a reified Connection."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

gmeow:connectionTarget
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Connection ;
    rdfs:range owl:Thing ;
    rdfs:label "connection target"@x-gmeow-english ;
    skos:definition "The target of a reified Connection."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

# --------------------------------------------------------------------------- #
# Route — a traversable path through connected entities
# --------------------------------------------------------------------------- #

gmeow:Route
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity ;
    rdfs:label "Route"@x-gmeow-english ;
    skos:definition "A traversable path through a graph of connected entities — a named, typed sequence of linked nodes with a defined start and end. Models transport lines, network paths, citation chains, social paths, and dependency chains. The actual path geometry, ordering, and cost are computed by the solver layer (Principle 12), not asserted as triples."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

gmeow:RouteKind
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Route Kind"@x-gmeow-english ;
    skos:definition "The kind of a route — transit line, flight path, walking path, citation chain, network path, social path, dependency chain. An open value vocabulary (individuals, never subclasses) per Principle 9."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

# Seeds for RouteKind
gmeow:routeKindTransit      a gmeow:RouteKind ; rdfs:label "transit route"@x-gmeow-english .
gmeow:routeKindTransit skos:definition "The transit route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .
gmeow:routeKindWalking      a gmeow:RouteKind ; rdfs:label "walking route"@x-gmeow-english .
gmeow:routeKindWalking skos:definition "The walking route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .
gmeow:routeKindFlight       a gmeow:RouteKind ; rdfs:label "flight path"@x-gmeow-english .
gmeow:routeKindFlight skos:definition "The flight route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .
gmeow:routeKindNetwork      a gmeow:RouteKind ; rdfs:label "network path"@x-gmeow-english .
gmeow:routeKindNetwork skos:definition "The network route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .
gmeow:routeKindCitation     a gmeow:RouteKind ; rdfs:label "citation chain"@x-gmeow-english .
gmeow:routeKindCitation skos:definition "The citation route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .
gmeow:routeKindSocial       a gmeow:RouteKind ; rdfs:label "social path"@x-gmeow-english .
gmeow:routeKindSocial skos:definition "The social route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .
gmeow:routeKindDependency   a gmeow:RouteKind ; rdfs:label "dependency chain"@x-gmeow-english .

# Route properties
gmeow:routeKindDependency skos:definition "The dependency route kind — a classification of a path by the domain in which the path is traversed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .
gmeow:routeStart
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Route ;
    rdfs:range owl:Thing ;
    rdfs:label "route start"@x-gmeow-english ;
    skos:definition "The start of a route."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

gmeow:routeEnd
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Route ;
    rdfs:range owl:Thing ;
    rdfs:label "route end"@x-gmeow-english ;
    skos:definition "The end of a route."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

gmeow:routeVia
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Route ;
    rdfs:range owl:Thing ;
    rdfs:label "route via"@x-gmeow-english ;
    skos:definition "An intermediate point that a route passes through. The order of via points is computed by the solver layer (Principle 12), not asserted in the OWL core."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

gmeow:routeKind
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Route ;
    rdfs:range gmeow:RouteKind ;
    rdfs:label "route kind"@x-gmeow-english ;
    skos:definition "The kind of a route (a RouteKind individual)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

gmeow:hasRouteSegment
    a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:subPropertyOf gmeow:hasPart ;
    rdfs:domain gmeow:Route ;
    rdfs:range gmeow:Route ;
    rdfs:label "has route segment"@x-gmeow-english ;
    skos:definition "A sub-route that is part of a larger route. A specialization of the universal gmeow:hasPart spine."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

gmeow:hasRoute
    a owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range gmeow:Route ;
    rdfs:label "has route"@x-gmeow-english ;
    skos:definition "Relates a thing to a route that starts from, ends at, or passes through it."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

# --------------------------------------------------------------------------- #
# Reference Frame Seed — network graph (#80, Principle 11)
# --------------------------------------------------------------------------- #

gmeow:referenceFrameNetworkGraph
    a gmeow:ReferenceFrame ;
    rdfs:label "Network Graph Reference Frame"@x-gmeow-english ;
    gmeow:frameRealm gmeow:frameRealmVirtual ;
    gmeow:hasAxis gmeow:axisScalar ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindGrid ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricGraphHops .
gmeow:referenceFrameNetworkGraph skos:definition "The network graph reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/connectivity> .

# =========================================================================== #
# ACCESSIBLE ROUTE KIND (from the accessibility module — #287 surgery)
# Value individuals live beside their value class (the vocabulary stays
# open — Principle 9); this keeps accessibility and connectivity mutually
# independent sibling extensions.
# =========================================================================== #

gmeow:routeKindAccessible
    a gmeow:RouteKind ;
    rdfs:label "accessible route"@x-gmeow-english ;
    skos:definition "A route computed to satisfy a set of accessibility needs. The actual path is determined by the solver layer (Principle 12), not asserted in OWL."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
