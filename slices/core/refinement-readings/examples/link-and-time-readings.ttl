@prefix ex: <https://example.org/link-and-time-readings/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Hypothetical reports, not an executed lookup or time-comparison certificate.
# The ambiguous link has candidates and no selected observationResult.
# The text is identical and exceeds thirty characters in all three records.
# Only the timed source claims have assertedAt; the undated claims stay undated.
# The record join uses another timed claim about the same record, not a new identity.

ex:hypotheticalSource rdf:type gmeow:InformationObject .
ex:holder rdf:type gmeow:Agent .
ex:readerLineage rdf:type gmeow:SoftwareAgent .
ex:readerV1 rdf:type gmeow:SoftwareAgent .
ex:recordA rdf:type gmeow:InformationObject .
ex:recordB rdf:type gmeow:InformationObject .
ex:referringRecord rdf:type gmeow:InformationObject .
ex:readerV1 gmeow:versionOf ex:readerLineage .
ex:referringRecord ex:recipientName "Visitor"@en .
ex:linkScope rdf:type gmeow:ReadingScope .
ex:linkScope gmeow:scopeRecord ex:referringRecord .
ex:linkScope gmeow:scopeRecord ex:recordA .
ex:linkScope gmeow:scopeRecord ex:recordB .
ex:linkScope gmeow:scopeChronology gmeow:temporalFrameUTCGregorian .
ex:ambiguousLink rdf:type gmeow:LinkResolution .
ex:ambiguousLink gmeow:observedFeature ex:referringRecord .
ex:ambiguousLink gmeow:vantage ex:readerV1 .
ex:ambiguousLink gmeow:readingScope ex:linkScope .
ex:ambiguousLink gmeow:relationVault ex:hypotheticalSource .
ex:ambiguousLink gmeow:relationPredicate ex:recipientName .
ex:ambiguousLink gmeow:relatedName "Visitor"@en .
ex:ambiguousLink gmeow:refinementOutcome gmeow:refinementAmbiguous .
ex:ambiguousLink gmeow:refinementCandidate ex:recordA .
ex:ambiguousLink gmeow:refinementCandidate ex:recordB .
ex:undatedTextRecord rdf:type gmeow:InformationObject .
ex:undatedTextRecord dcterms:description "The workshop opens after the morning briefing."@en .
ex:earlyTextRecord rdf:type gmeow:InformationObject .
ex:earlyTextRecord dcterms:description "The workshop opens after the morning briefing."@en .
ex:lateTextRecord rdf:type gmeow:InformationObject .
ex:lateTextRecord dcterms:description "The workshop opens after the morning briefing."@en .
ex:undatedTextClaim rdf:reifies <<( ex:undatedTextRecord dcterms:description "The workshop opens after the morning briefing."@en )>> .
ex:earlyTextClaim rdf:reifies <<( ex:earlyTextRecord dcterms:description "The workshop opens after the morning briefing."@en )>> .
ex:lateTextClaim rdf:reifies <<( ex:lateTextRecord dcterms:description "The workshop opens after the morning briefing."@en )>> .
ex:earlyTextClaim gmeow:assertedAt "2026-11-01T09:00:00Z"^^xsd:dateTime .
ex:lateTextClaim gmeow:assertedAt "2026-11-01T11:00:00Z"^^xsd:dateTime .
ex:textScope rdf:type gmeow:ReadingScope .
ex:textScope gmeow:scopeRecord ex:undatedTextRecord .
ex:textScope gmeow:scopeRecord ex:earlyTextRecord .
ex:textScope gmeow:scopeRecord ex:lateTextRecord .
ex:textScope gmeow:scopeRecord ex:undatedTextClaim .
ex:textScope gmeow:scopeRecord ex:earlyTextClaim .
ex:textScope gmeow:scopeRecord ex:lateTextClaim .
ex:textScope gmeow:scopeChronology gmeow:temporalFrameUTCGregorian .
ex:textJoin rdf:type gmeow:TimeJoin .
ex:textJoin gmeow:observedFeature ex:undatedTextRecord .
ex:textJoin gmeow:vantage ex:readerV1 .
ex:textJoin gmeow:readingScope ex:textScope .
ex:textJoin gmeow:timeJoinBasis gmeow:timeJoinText .
ex:textJoin gmeow:timeJoinedTo ex:earlyTextRecord .
ex:textJoin gmeow:recoveredAt "2026-11-01T09:00:00Z"^^xsd:dateTime .
ex:textJoin gmeow:refinementOutcome gmeow:refinementResolved .
ex:textJoin gmeow:wasDerivedFrom ex:undatedTextClaim .
ex:textJoin gmeow:wasDerivedFrom ex:earlyTextClaim .
ex:textJoin gmeow:wasDerivedFrom ex:lateTextClaim .
ex:sameRecord rdf:type gmeow:InformationObject .
ex:sameRecord ex:status "ready" .
ex:selectedUntimedClaim rdf:reifies <<( ex:sameRecord ex:status "ready" )>> .
ex:otherTimedClaim rdf:reifies <<( ex:sameRecord ex:status "ready" )>> .
ex:otherTimedClaim gmeow:assertedAt "2026-11-02T10:00:00Z"^^xsd:dateTime .
ex:recordScope rdf:type gmeow:ReadingScope .
ex:recordScope gmeow:scopeRecord ex:sameRecord .
ex:recordScope gmeow:scopeRecord ex:selectedUntimedClaim .
ex:recordScope gmeow:scopeRecord ex:otherTimedClaim .
ex:recordScope gmeow:scopeChronology gmeow:temporalFrameUTCGregorian .
ex:recordJoin rdf:type gmeow:TimeJoin .
ex:recordJoin gmeow:observedFeature ex:sameRecord .
ex:recordJoin gmeow:vantage ex:readerV1 .
ex:recordJoin gmeow:readingScope ex:recordScope .
ex:recordJoin gmeow:timeJoinBasis gmeow:timeJoinRecord .
ex:recordJoin gmeow:timeJoinedTo ex:sameRecord .
ex:recordJoin gmeow:recoveredAt "2026-11-02T10:00:00Z"^^xsd:dateTime .
ex:recordJoin gmeow:refinementOutcome gmeow:refinementResolved .
ex:recordJoin gmeow:wasDerivedFrom ex:selectedUntimedClaim .
ex:recordJoin gmeow:wasDerivedFrom ex:otherTimedClaim .

# Exact-statement source, declaring perspective and recorder.

ex:statement001 rdf:reifies <<( ex:hypotheticalSource rdf:type gmeow:InformationObject )>> ;
    gmeow:wasDerivedFrom ex:hypotheticalSource ;
    gmeow:accordingTo ex:holder ;
    gmeow:wasAttributedTo ex:readerV1 .

