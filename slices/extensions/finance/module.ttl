@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:Asset
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Asset"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Entity ;
    skos:definition "A financial asset — a stock, bond, cryptocurrency, real estate holding, commodity, or other instrument of value. The thing that is held, not the holding itself (which is a Holding relator)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AssetType
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Asset Type"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of a financial asset — a VALUE, never an Asset subclass. Open vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:CryptoWallet
    a logic:SubKind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Crypto Wallet"@x-gmeow-english ;
    rdfs:subClassOf gmeow:FinancialAccount ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:walletScheme ;
            logic:someValuesFrom gmeow:WalletScheme ;
        ] ;
    skos:definition "A digital wallet that holds cryptocurrency assets. A subclass of FinancialAccount (it is a financial-existence account) with wallet-specific properties: address(es), scheme, and cryptographic key linkage. It is the ACCOUNT, not the asset held in it (gmeow:FinancialAsset) and not the key that controls it (gmeow:walletKey)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:FinancialAccount
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Financial Account"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:accountHolder ;
            logic:someValuesFrom gmeow:Agent ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:bic ;
            logic:allValuesFrom [
                a rdfs:Datatype ;
                logic:onDatatype xsd:string ;
                logic:withRestrictions (
                    [ xsd:minLength "8"^^xsd:nonNegativeInteger ]
                    [ xsd:maxLength "11"^^xsd:nonNegativeInteger ]
                    [ xsd:pattern "^[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?$" ]
                ) ;
            ] ;
        ] ;
    logic:disjointWith gmeow:OnlineAccount ;
    skos:definition "A financial account held by an agent with a financial institution — a bank account, credit card, investment account, or wallet. Distinct from OnlineAccount (social profiles, decentralized identity): this is the financial-existence layer. The account's legal terms are modelled as an Agreement between the holder and the institution."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:FinancialAccountType
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Financial Account Type"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of a financial account — a VALUE, never a FinancialAccount subclass. The set is open; a kind not among the seeds is a FRESH gmeow:FinancialAccountType individual carrying rdfs:label. Pointed at by gmeow:accountType."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:FinancialTransaction
    a logic:Event ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Financial Transaction"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Event ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:transactionAmount ;
            logic:someValuesFrom gmeow:MonetaryAmount ;
        ] ;
    skos:definition "A money-movement event — a payment, transfer, deposit, withdrawal, fee, interest, or refund. Reuses the Event/Participation substrate: payer, payee, and intermediary are ParticipantRole values on Participation relators, never subproperties. The kind of transaction is a TransactionType value; the status is a TransactionStatus value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Holding
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Holding"@x-gmeow-english ;
    logic:mediates gmeow:holdingAgent ,
        gmeow:holdingAsset ;
    rdfs:subClassOf logic:Relator ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:holdingAgent ;
            logic:someValuesFrom gmeow:Agent ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:holdingAsset ;
            logic:someValuesFrom gmeow:Asset ;
        ] ;
    skos:definition "A reified relator connecting an agent to a financial asset with a quantity and cost-basis. The thing that is held: agent × asset × quantity × cost-basis × optional period. Promote from a flat accountBalance when cost-basis, period, or provenance must be recorded. A Holding is the relator, not the asset itself and never the account it is booked against."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Invoice
    a logic:SubKind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Invoice"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Document ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:invoiceAmount ;
            logic:someValuesFrom gmeow:MonetaryAmount ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:invoiceIssuer ;
            logic:someValuesFrom gmeow:Agent ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:invoiceRecipient ;
            logic:someValuesFrom gmeow:Agent ;
        ] ;
    skos:definition "A billing document issued by a seller to a buyer, requesting payment for goods or services rendered. A subclass of Document: it is the REQUEST for payment, not the payment that discharges it (gmeow:Payment) and not the agreement it bills against (gmeow:Order)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:InvoiceStatus
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Invoice Status"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The status of an invoice — a VALUE, never a subclass. Open vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:JournalEntry
    a logic:Event ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Journal Entry"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Event ,
        [
            a logic:Restriction ;
            logic:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            logic:onProperty gmeow:journalEntryPostings ;
            logic:onClass gmeow:Posting ;
        ] ;
    skos:definition "A balanced double-entry bookkeeping event: a temporal occurrence in which debits equal credits (per currency bucket). Composed of two or more Posting relators — a single-posting entry cannot balance, so at least two postings of class gmeow:Posting are required."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:LedgerAccount
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Ledger Account"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:ledgerAccountType ;
            logic:someValuesFrom gmeow:LedgerAccountType ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:ledgerAccountHolder ;
            logic:someValuesFrom gmeow:Agent ;
        ] ;
    skos:definition "A book-keeping account in a double-entry ledger — an asset, liability, equity, revenue, or expense account. An InformationObject distinct from FinancialAccount: a LedgerAccount is a conceptual book-keeping construct, while a FinancialAccount is a bank-level account with IBAN/BIC/number."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:LedgerAccountType
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Ledger Account Type"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of a ledger account — a VALUE, never a LedgerAccount subclass. The set is open; a kind not among the seeds is a FRESH LedgerAccountType individual carrying rdfs:label. Pointed at by gmeow:ledgerAccountType."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Order
    a logic:SubKind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Order"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Agreement ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:orderAmount ;
            logic:someValuesFrom gmeow:MonetaryAmount ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:orderBuyer ;
            logic:someValuesFrom gmeow:Agent ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:orderSeller ;
            logic:someValuesFrom gmeow:Agent ;
        ] ;
    skos:definition "A purchase order or sales order — an agreement between a buyer and a seller for the supply of goods or services at a stated price. A subclass of Agreement: it records what was agreed, not what was delivered or billed — the bill is a gmeow:Invoice."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:OrderStatus
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Order Status"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The status of an order — a VALUE, never a subclass. Open vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Payment
    a logic:Event ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Payment"@x-gmeow-english ;
    rdfs:subClassOf gmeow:FinancialTransaction ;
    skos:definition "A payment event — a financial transaction whose purpose is to discharge an obligation or transfer value. A thin subclass of FinancialTransaction distinguished by the paymentMethod facet. It is the value-transfer EVENT, not the obligation it discharges and not the document that requested it (gmeow:Invoice)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Posting
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Posting"@x-gmeow-english ;
    logic:mediates gmeow:postingJournalEntry ,
        gmeow:postingAccount ;
    rdfs:subClassOf logic:Relator ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:postingJournalEntry ;
            logic:someValuesFrom gmeow:JournalEntry ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:postingAccount ;
            logic:someValuesFrom gmeow:LedgerAccount ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:postingAmount ;
            logic:someValuesFrom gmeow:MonetaryAmount ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:postingDirection ;
            logic:someValuesFrom gmeow:PostingDirection ;
        ] ;
    skos:definition "A reified relator connecting a journal entry to a ledger account with a monetary amount and a posting direction (debit or credit). The atomic unit of double-entry bookkeeping. A posting is one leg, never a whole entry: it does not balance on its own, and the balancing obligation lives on the journal entry."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:PostingDirection
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Posting Direction"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The direction of a posting in double-entry bookkeeping — a VALUE, never a subclass. Only debit and credit are seeded; the vocabulary is closed in practice but modelled as open for consistency."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:TransactionStatus
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Transaction Status"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The status of a financial transaction — a VALUE, never a subclass. Open vocabulary; seeds in Phase B."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:TransactionType
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Transaction Type"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of a financial transaction — a VALUE, never a subclass. Open vocabulary; seeds in Phase B."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:WalletScheme
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Wallet Scheme"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The blockchain or cryptographic scheme of a wallet — a VALUE, never a subclass. Open vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:accountBalance
    a logic:ObjectProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "account balance"@x-gmeow-english ;
    rdfs:range gmeow:MonetaryAmount ;
    skos:definition "The current balance of a financial account, expressed as a MonetaryAmount. Non-functional: a multi-currency account has several balances, and competing standpoint-indexed balance claims coexist (Principle 9). It is a reported balance, not a derived roll-up of postings — that computation is solver work."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:accountCurrency
    a logic:ObjectProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "account currency"@x-gmeow-english ;
    rdfs:range gmeow:ReferenceFrame ;
    skos:definition "The currency(ies) of a financial account, drawn from the open currency reference-frame vocabulary (gmeow:frameRealmCurrency). NON-FUNCTIONAL: a single account may hold balances in several currencies (multi-currency fintech accounts), so it is not the currency of any one balance — that frame rides on the gmeow:MonetaryAmount."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:accountHolder
    a logic:ObjectProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "account holder"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "Relates a financial account to the agent that holds it. Non-functional: a joint account has several co-equal holders, and none of them is privileged — the property does not distinguish a primary holder."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:accountNumber
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "account number"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The account number identifying the financial account at its institution. Not functional: different sources may report differing formats."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:accountType
    a logic:ObjectProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "account type"@x-gmeow-english ;
    rdfs:range gmeow:FinancialAccountType ;
    skos:definition "The kind of financial account — one of the open gmeow:FinancialAccountType values (bank, credit, investment, wallet). Functional: an account has one canonical type; several types are several accounts rather than one account with a list."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:accountTypeBank
    a gmeow:FinancialAccountType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "bank account"@x-gmeow-english ;
    skos:definition "A deposit or chequing account at a bank or credit union."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:accountTypeCredit
    a gmeow:FinancialAccountType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "credit account"@x-gmeow-english ;
    skos:definition "A credit card or line-of-credit account."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:accountTypeInvestment
    a gmeow:FinancialAccountType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "investment account"@x-gmeow-english ;
    skos:definition "A brokerage, retirement, or other investment holdings account."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:accountTypeWallet
    a gmeow:FinancialAccountType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "wallet"@x-gmeow-english ;
    skos:definition "A digital wallet — fiat or crypto — held by an agent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:assetIdentifier
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:Asset ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "asset identifier"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "An identifier for the financial asset — FIGI, ISIN, ticker symbol, or other instrument identifier. Non-functional: different sources may report differing identifiers, so it is never an identity criterion — two assets are not the same because an identifier matches."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:assetType
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Asset ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "asset type"@x-gmeow-english ;
    rdfs:range gmeow:AssetType ;
    skos:definition "The kind of financial asset — one of the open AssetType values (stock, bond, cryptocurrency, real estate, commodity). Functional: an asset has one canonical type, and the type is a VALUE, never a subclass of gmeow:FinancialAsset."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:assetTypeBond
    a gmeow:AssetType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "bond"@x-gmeow-english ;
    skos:definition "A fixed-income debt instrument."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:assetTypeCommodity
    a gmeow:AssetType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "commodity"@x-gmeow-english ;
    skos:definition "A basic good or raw material traded on a market (gold, oil, wheat, etc.)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:assetTypeCryptocurrency
    a gmeow:AssetType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "cryptocurrency"@x-gmeow-english ;
    skos:definition "A digital currency operating on a blockchain or distributed ledger."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:assetTypeRealEstate
    a gmeow:AssetType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "real estate"@x-gmeow-english ;
    skos:definition "A real property asset — land, buildings, or improvements."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:assetTypeStock
    a gmeow:AssetType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "stock"@x-gmeow-english ;
    skos:definition "A share of ownership in a corporation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:bic
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "BIC"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The Bank Identifier Code (ISO 9362, SWIFT code) of the institution holding the account. It identifies the INSTITUTION, not the account — the account identifier is gmeow:iban."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:holdingAgent
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Holding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "holding agent"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent that holds the asset. Functional: a holding is held by exactly one agent; co-ownership is several holdings, not one holding with several agents."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:holdingAsset
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Holding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "holding asset"@x-gmeow-english ;
    rdfs:range gmeow:Asset ;
    skos:definition "The financial asset that is held. Functional: a holding is of exactly one asset; it points at the asset, never at the account the asset sits in."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:holdingCostBasis
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Holding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "holding cost basis"@x-gmeow-english ;
    rdfs:range gmeow:MonetaryAmount ;
    skos:definition "The cost basis of the holding — the original monetary amount paid to acquire the asset. Functional: a holding has one canonical cost basis (disputed values are standpoint-indexed claims). It is the acquisition cost, not the current market value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:holdingPeriod
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Holding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "holding period"@x-gmeow-english ;
    rdfs:range gmeow:TimeInterval ;
    skos:definition "The time interval over which the holding is valid. Optional: omit for point-in-time holdings. It is the holding's own validity window, not the asset's lifetime."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:holdingQuantity
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Holding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "holding quantity"@x-gmeow-english ;
    logic:range gmeow:HoldingAssetQuantity ;
    skos:definition "The exact HoldingAssetQuantity value of units of the holdingAsset at the holding's time or interval. It is an object carrying canonical magnitude, dimension, countedAsset and count frame; monetary cost remains holdingCostBasis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox  ;
    skos:example "ex:holding gmeow:holdingQuantity ex:shares . ex:shares a gmeow:HoldingAssetQuantity ; math:quantityValue 10.0 ; math:hasDimension math:dimensionless ; gmeow:countedAsset ex:stock ; gmeow:hasReferenceFrame ex:shareCountFrame ."@x-gmeow-english  ;
    gmeow:useWhen "Use for exact whole or fractional asset-unit holdings, including signed positions."@x-gmeow-english  ;
    gmeow:avoidWhen "Avoid a bare decimal, a MonetaryAmount in the count role, or a count whose countedAsset differs from holdingAsset."@x-gmeow-english  ;
    gmeow:howToUse "Link one quantity object and preserve its exact decimal magnitude, explicit dimension, complete scalar mathematical count frame and matching countedAsset; preserve the holding's agent, asset, period and cost basis."@x-gmeow-english  ;
    skos:scopeNote "Scope: asset-unit counts; this property is functional on the quantity object, not a global selection between standpoint-indexed holdings."@x-gmeow-english .

gmeow:iban
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "IBAN"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The International Bank Account Number (ISO 13616) of a bank account. It identifies the ACCOUNT, not the institution holding it — that is gmeow:bic."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:invoiceAmount
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Invoice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "invoice amount"@x-gmeow-english ;
    rdfs:range gmeow:MonetaryAmount ;
    skos:definition "The total monetary amount requested by the invoice, expressed as a MonetaryAmount. Functional: an invoice has one canonical total amount — it is the amount REQUESTED, never the amount actually paid."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:invoiceDueDate
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:Invoice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "invoice due date"@x-gmeow-english ;
    rdfs:range xsd:dateTime ;
    skos:definition "The date and time by which payment is due (xsd:dateTime — DL-clean, never xsd:date). Non-functional: competing standpoint-indexed due dates coexist."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:invoiceIssuer
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Invoice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "invoice issuer"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent that issued the invoice. Non-functional: a jointly issued invoice has several co-equal issuers. It is not the party being billed — that is gmeow:invoiceRecipient."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:invoiceRecipient
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Invoice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "invoice recipient"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent that is being billed. Non-functional: a jointly billed party has several recipients. Being billed is not the same as paying: the payer is recorded on the gmeow:Payment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:invoiceStatus
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Invoice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "invoice status"@x-gmeow-english ;
    rdfs:range gmeow:InvoiceStatus ;
    skos:definition "The status of an invoice, drawn from the open InvoiceStatus value vocabulary. Non-functional: an invoice may progress through several statuses over time; a status is a VALUE, never a subclass of gmeow:Invoice."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:invoiceStatusCancelled
    a gmeow:InvoiceStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "cancelled"@x-gmeow-english ;
    skos:definition "An invoice that has been cancelled. Retained with displayable false, never deleted (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:invoiceStatusDraft
    a gmeow:InvoiceStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "draft"@x-gmeow-english ;
    skos:definition "An invoice that has been created but not yet sent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:invoiceStatusOverdue
    a gmeow:InvoiceStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "overdue"@x-gmeow-english ;
    skos:definition "An invoice whose due date has passed without payment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:invoiceStatusPaid
    a gmeow:InvoiceStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "paid"@x-gmeow-english ;
    skos:definition "An invoice that has been paid in full."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:invoiceStatusSent
    a gmeow:InvoiceStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "sent"@x-gmeow-english ;
    skos:definition "An invoice that has been sent to the recipient."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:journalEntryPostings
    a logic:ObjectProperty ;
    rdfs:domain gmeow:JournalEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "journal entry postings"@x-gmeow-english ;
    rdfs:range gmeow:Posting ;
    logic:inverseOf gmeow:postingJournalEntry ;
    skos:definition "The postings that compose a journal entry. Non-functional: a journal entry has at least two postings (SHACL-enforced) — a single-posting entry cannot balance and is not a journal entry."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:ledgerAccountCurrency
    a logic:ObjectProperty ;
    rdfs:domain gmeow:LedgerAccount ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "ledger account currency"@x-gmeow-english ;
    rdfs:range gmeow:ReferenceFrame ;
    skos:definition "The currency(ies) in which the ledger account tracks balances. Non-functional: a single logical ledger account may track several currency buckets (multi-currency bookkeeping). The functional constraint moves to individual Posting relators, so this property does not fix the currency of any one posting."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:ledgerAccountHolder
    a logic:ObjectProperty ;
    rdfs:domain gmeow:LedgerAccount ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "ledger account holder"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent that holds the ledger account. Non-functional: a jointly maintained ledger account has several co-equal holders. It is not the account's owner-of-record in any legal sense — the ledger is a bookkeeping artifact, not a title register."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:ledgerAccountType
    a logic:ObjectProperty ;
    rdfs:domain gmeow:LedgerAccount ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "ledger account type"@x-gmeow-english ;
    rdfs:range gmeow:LedgerAccountType ;
    skos:definition "The kind of ledger account — one of the open LedgerAccountType values (asset, liability, equity, revenue, expense). Functional: a ledger account has one canonical type; it is not gmeow:accountType, which classifies a gmeow:FinancialAccount rather than a bookkeeping account."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:ledgerAccountTypeAsset
    a gmeow:LedgerAccountType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "asset"@x-gmeow-english ;
    skos:definition "An asset account — resources owned by the entity (cash, receivables, inventory, equipment)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:ledgerAccountTypeEquity
    a gmeow:LedgerAccountType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "equity"@x-gmeow-english ;
    skos:definition "An equity account — the residual interest in the assets after deducting liabilities (owner capital, retained earnings)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:ledgerAccountTypeExpense
    a gmeow:LedgerAccountType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "expense"@x-gmeow-english ;
    skos:definition "An expense account — costs incurred in the process of generating revenue (salaries, rent, utilities, supplies)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:ledgerAccountTypeLiability
    a gmeow:LedgerAccountType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "liability"@x-gmeow-english ;
    skos:definition "A liability account — obligations owed by the entity (payables, loans, accrued expenses)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:ledgerAccountTypeRevenue
    a gmeow:LedgerAccountType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "revenue"@x-gmeow-english ;
    skos:definition "A revenue account — income generated from normal business operations (sales, fees, interest income)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:orderAmount
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Order ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "order amount"@x-gmeow-english ;
    rdfs:range gmeow:MonetaryAmount ;
    skos:definition "The total monetary amount of the order, expressed as a MonetaryAmount. Functional: an order has one canonical total amount — the agreed price, not the amount invoiced or paid."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:orderBuyer
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Order ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "order buyer"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent placing the order. Non-functional: a joint purchase has several buyers, and not one of them is privileged as the principal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:orderSeller
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Order ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "order seller"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent fulfilling the order. Non-functional: a jointly fulfilled order has several sellers. It names who supplies, not who is paid — payment routing is recorded on the gmeow:Payment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:orderStatus
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Order ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "order status"@x-gmeow-english ;
    rdfs:range gmeow:OrderStatus ;
    skos:definition "The status of an order, drawn from the open OrderStatus value vocabulary. Non-functional: an order may progress through several statuses; a status is a VALUE and never a subclass of gmeow:Order."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:orderStatusCancelled
    a gmeow:OrderStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "cancelled"@x-gmeow-english ;
    skos:definition "An order that has been cancelled. Retained with displayable false, never deleted (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:orderStatusConfirmed
    a gmeow:OrderStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "confirmed"@x-gmeow-english ;
    skos:definition "An order that has been confirmed by the seller."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:orderStatusDelivered
    a gmeow:OrderStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "delivered"@x-gmeow-english ;
    skos:definition "An order whose goods have been delivered."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:orderStatusPending
    a gmeow:OrderStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "pending"@x-gmeow-english ;
    skos:definition "An order that has been placed but not yet confirmed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:orderStatusShipped
    a gmeow:OrderStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "shipped"@x-gmeow-english ;
    skos:definition "An order whose goods have been shipped."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:paymentMethod
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Payment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "payment method"@x-gmeow-english ;
    rdfs:range gmeow:PaymentMethod ;
    skos:definition "The method of payment — cash, cheque, credit card, bank transfer, cryptocurrency, etc. Non-functional: a single payment may involve several methods (e.g. split payment). It names HOW value moved, not the account it moved from."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:postingAccount
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Posting ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "posting account"@x-gmeow-english ;
    rdfs:range gmeow:LedgerAccount ;
    skos:definition "The ledger account this posting affects. Functional: a posting affects exactly one ledger account; a posting touching two accounts is not one posting but two."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:postingAmount
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Posting ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "posting amount"@x-gmeow-english ;
    rdfs:range gmeow:MonetaryAmount ;
    skos:definition "The monetary amount of this posting, expressed as a MonetaryAmount with explicit currency frame. Functional: a posting has exactly one amount, and it is unsigned — direction is carried by gmeow:postingDirection, never by a negative value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:postingDirection
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Posting ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "posting direction"@x-gmeow-english ;
    rdfs:range gmeow:PostingDirection ;
    skos:definition "The direction of this posting — debit or credit. Functional: a posting is exactly one direction; direction is not a sign on the amount and not a statement about whether the account increases."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:postingDirectionCredit
    a gmeow:PostingDirection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "credit"@x-gmeow-english ;
    skos:definition "A credit posting — an entry on the right side of a ledger account."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:postingDirectionDebit
    a gmeow:PostingDirection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "debit"@x-gmeow-english ;
    skos:definition "A debit posting — an entry on the left side of a ledger account."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:postingJournalEntry
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Posting ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "posting journal entry"@x-gmeow-english ;
    rdfs:range gmeow:JournalEntry ;
    logic:inverseOf gmeow:journalEntryPostings ;
    skos:definition "The journal entry this posting belongs to. Functional: a posting belongs to exactly one journal entry and is never shared between entries."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:roleIntermediary
    a gmeow:ParticipantRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "intermediary"@x-gmeow-english ;
    skos:definition "An intermediary agent in a financial transaction — a bank, payment processor, or clearing house."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:rolePayee
    a gmeow:ParticipantRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "payee"@x-gmeow-english ;
    skos:definition "The agent that receives money in a financial transaction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:rolePayer
    a gmeow:ParticipantRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "payer"@x-gmeow-english ;
    skos:definition "The agent that sends money in a financial transaction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionAmount
    a logic:ObjectProperty ;
    rdfs:domain gmeow:FinancialTransaction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "transaction amount"@x-gmeow-english ;
    rdfs:range gmeow:MonetaryAmount ;
    skos:definition "The monetary amount of a financial transaction, expressed as a MonetaryAmount. Functional: a single transaction occurrence has one canonical amount (disputed amounts are standpoint-indexed claims on separate statements, not additional values on the same transaction)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:transactionStatus
    a logic:ObjectProperty ;
    rdfs:domain gmeow:FinancialTransaction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "transaction status"@x-gmeow-english ;
    rdfs:range gmeow:TransactionStatus ;
    skos:definition "The status(es) of a financial transaction, drawn from the open TransactionStatus value vocabulary. Non-functional: a transaction may progress through several statuses over time, recorded as co-equal standpoint-indexed claims — the graph does not pick a current status."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:transactionStatusCompleted
    a gmeow:TransactionStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "completed"@x-gmeow-english ;
    skos:definition "A transaction that has been fully processed and settled."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionStatusFailed
    a gmeow:TransactionStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "failed"@x-gmeow-english ;
    skos:definition "A transaction that failed to complete."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionStatusPending
    a gmeow:TransactionStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "pending"@x-gmeow-english ;
    skos:definition "A transaction that has been initiated but not yet settled."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionStatusReversed
    a gmeow:TransactionStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "reversed"@x-gmeow-english ;
    skos:definition "A transaction that has been reversed or voided. The original transaction record is retained with displayable false (Principle 10); the reversal is a separate event."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionType
    a logic:ObjectProperty ;
    rdfs:domain gmeow:FinancialTransaction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "transaction type"@x-gmeow-english ;
    rdfs:range gmeow:TransactionType ;
    skos:definition "The kind(s) of a financial transaction, drawn from the open TransactionType value vocabulary. Non-functional: a transaction may carry several types, and competing standpoint-indexed type claims coexist; a type is a VALUE, never a subclass of gmeow:FinancialTransaction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:transactionTypeDeposit
    a gmeow:TransactionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "deposit"@x-gmeow-english ;
    skos:definition "A deposit transaction — money added to an account."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionTypeFee
    a gmeow:TransactionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "fee"@x-gmeow-english ;
    skos:definition "A fee transaction — a charge levied by a financial institution or service provider."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionTypeInterest
    a gmeow:TransactionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "interest"@x-gmeow-english ;
    skos:definition "An interest transaction — interest earned or charged on an account balance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionTypePayment
    a gmeow:TransactionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "payment"@x-gmeow-english ;
    skos:definition "A payment transaction — money sent from one agent to another."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionTypeRefund
    a gmeow:TransactionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "refund"@x-gmeow-english ;
    skos:definition "A refund transaction — money returned to the payer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionTypeTransfer
    a gmeow:TransactionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "transfer"@x-gmeow-english ;
    skos:definition "A transfer transaction — money moved between accounts held by the same agent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transactionTypeWithdrawal
    a gmeow:TransactionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "withdrawal"@x-gmeow-english ;
    skos:definition "A withdrawal transaction — money removed from an account."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:walletAddress
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:CryptoWallet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "wallet address"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "A public address of the crypto wallet. Non-functional: a single wallet may have multiple addresses (e.g. HD wallet derivation paths), so an address is not a wallet identity criterion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:walletKey
    a logic:ObjectProperty ;
    rdfs:domain gmeow:CryptoWallet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "wallet key"@x-gmeow-english ;
    rdfs:range gmeow:CryptographicKey ;
    skos:definition "The cryptographic key that controls the wallet. Non-functional: a wallet may be controlled by several keys (multi-sig) or the key may rotate over time. It links to the key's identity, never to secret key material — private keys are not GMEOW content."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:walletScheme
    a logic:ObjectProperty ;
    rdfs:domain gmeow:CryptoWallet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "wallet scheme"@x-gmeow-english ;
    rdfs:range gmeow:WalletScheme ;
    skos:definition "The blockchain scheme of the wallet — Bitcoin, Ethereum, Solana, Monero, etc. Functional: a wallet operates on exactly one scheme (a multi-scheme container is several wallets, not one wallet with a list)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:walletSchemeBTC
    a gmeow:WalletScheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Bitcoin"@x-gmeow-english ;
    skos:definition "The Bitcoin blockchain scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:walletSchemeETH
    a gmeow:WalletScheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Ethereum"@x-gmeow-english ;
    skos:definition "The Ethereum blockchain scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:walletSchemeSOL
    a gmeow:WalletScheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Solana"@x-gmeow-english ;
    skos:definition "The Solana blockchain scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:walletSchemeXMR
    a gmeow:WalletScheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Monero"@x-gmeow-english ;
    skos:definition "The Monero blockchain scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

<https://blackcatinformatics.ca/gmeow/slices/finance>
    a logic:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Personal and SMB financial existence: accounts, monetary amounts, transactions, ledgers, invoices, orders, asset holdings, and crypto wallets. Grounded in the existing Event/Participation/Agreement/Rights/Trust substrate. FIBO, schema.org, ISO 4217, ISO 20022, FIGI and OFX are aligned by reference, never imported.

DOCTRINE.
  * A financial account is an InformationObject (consistent with OnlineAccount): it is fundamentally an information construct — an IBAN, account number, and balance record. The legal/contractual aspect is modelled separately via Agreement (account terms between holder and bank).
  * Money is a MonetaryAmount = amount (xsd:decimal) + currency (ReferenceFrame individual). DL-clean; no arithmetic in OWL.
  * Currency is a ReferenceFrame in the frameRealmCurrency realm (Principle 11 — frame-relativity). Each ISO 4217 code is a ReferenceFrame individual.
  * accountCurrency is NON-FUNCTIONAL: a single FinancialAccount may hold balances in several currencies (multi-currency fintech accounts). The functional constraint moves to Posting/Holding relators.
  * A transaction is a reified Event (REA pattern): money movement with Agent participants in roles (payer / payee / intermediary) — reuse Event/Participation, never re-mint.
  * Double-entry as structure: LedgerAccount (asset / liability / equity / revenue / expense — open vocab), JournalEntry ⊑ Event, Posting ⊑ gufo:Relator (account × amount × debit/credit); balance (Σ debits = Σ credits) enforced by SHACL, not OWL.
  * Loans are Agreements; invoices are Documents; ownership is rights; banks are Organizations; wallets hold trust keys — reuse, don't duplicate.
  * Open value vocabularies, no overtyping (Principle 9): account types, transaction types, transaction statuses, ledger account types, posting directions, asset types, invoice statuses, order statuses, and payment methods are individuals, never subclasses.
  * Flat-first, reify on demand: a flat accountBalance on FinancialAccount covers the 80% case; promote to a Holding relator when cost-basis, period, or provenance matters.
  * Sensitive: P9/P10 + provenance. Reversed/voided transactions are displayable false, retained as the audit trail, never deleted; disputed amounts coexist accordingTo; every figure carries confidence/wasAttributedTo."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "GMEOW Finance Module"@x-gmeow-english ;
    skos:definition "The GMEOW Finance Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Suppression constraints — projections of the finance Phase B–D        #
# suppression shapes. A reversed/cancelled record that is not suppressed        #
# (gmeow:displayable false) is a Warning — a source may lag on setting the flag. #
# =========================================================================== #

gmeow:ReversedTransactionSuppressionConstraint
    a logic:Constraint ;
    rdfs:label "Reversed transaction suppression constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a reversed gmeow:FinancialTransaction (one whose gmeow:transactionStatus is transactionStatusReversed) should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)."@x-gmeow-english ;
    logic:formalizes gmeow:FinancialTransaction ;
    logic:severity "Warning" ;
    logic:message "A reversed transaction should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
    logic:integrity logic:supTxForall .
logic:supTxForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:supTxImpl .
logic:supTxImpl a logic:Formula ; logic:antecedent logic:supTxGuard ; logic:consequent logic:supTxPhi .
logic:supTxGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:FinancialTransaction ] .
logic:supTxPhi a logic:Formula ; logic:not logic:supTxEx .
logic:supTxEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "x" ] ;
    logic:exists logic:supTxBody .
logic:supTxBody a logic:Formula ; logic:and logic:supTxStatus , logic:supTxNotSuppressed .
logic:supTxStatus a logic:Formula ; logic:relation gmeow:transactionStatus ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:transactionStatusReversed ] .
logic:supTxNotSuppressed a logic:Formula ; logic:not logic:supTxDisp .
logic:supTxDisp a logic:Formula ; logic:relation gmeow:displayable ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] .

gmeow:CancelledInvoiceSuppressionConstraint
    a logic:Constraint ;
    rdfs:label "Cancelled invoice suppression constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a cancelled gmeow:Invoice (one whose gmeow:invoiceStatus is invoiceStatusCancelled) should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)."@x-gmeow-english ;
    logic:formalizes gmeow:Invoice ;
    logic:severity "Warning" ;
    logic:message "A cancelled invoice should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
    logic:integrity logic:supInvForall .
logic:supInvForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:supInvImpl .
logic:supInvImpl a logic:Formula ; logic:antecedent logic:supInvGuard ; logic:consequent logic:supInvPhi .
logic:supInvGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Invoice ] .
logic:supInvPhi a logic:Formula ; logic:not logic:supInvEx .
logic:supInvEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "x" ] ;
    logic:exists logic:supInvBody .
logic:supInvBody a logic:Formula ; logic:and logic:supInvStatus , logic:supInvNotSuppressed .
logic:supInvStatus a logic:Formula ; logic:relation gmeow:invoiceStatus ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:invoiceStatusCancelled ] .
logic:supInvNotSuppressed a logic:Formula ; logic:not logic:supInvDisp .
logic:supInvDisp a logic:Formula ; logic:relation gmeow:displayable ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] .

gmeow:CancelledOrderSuppressionConstraint
    a logic:Constraint ;
    rdfs:label "Cancelled order suppression constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a cancelled gmeow:Order (one whose gmeow:orderStatus is orderStatusCancelled) should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)."@x-gmeow-english ;
    logic:formalizes gmeow:Order ;
    logic:severity "Warning" ;
    logic:message "A cancelled order should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
    logic:integrity logic:supOrdForall .
logic:supOrdForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:supOrdImpl .
logic:supOrdImpl a logic:Formula ; logic:antecedent logic:supOrdGuard ; logic:consequent logic:supOrdPhi .
logic:supOrdGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Order ] .
logic:supOrdPhi a logic:Formula ; logic:not logic:supOrdEx .
logic:supOrdEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "x" ] ;
    logic:exists logic:supOrdBody .
logic:supOrdBody a logic:Formula ; logic:and logic:supOrdStatus , logic:supOrdNotSuppressed .
logic:supOrdStatus a logic:Formula ; logic:relation gmeow:orderStatus ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:orderStatusCancelled ] .
logic:supOrdNotSuppressed a logic:Formula ; logic:not logic:supOrdDisp .
logic:supOrdDisp a logic:Formula ; logic:relation gmeow:displayable ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/CryptoWallet> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/walletScheme> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/WalletScheme> ] .
<https://blackcatinformatics.ca/gmeow/FinancialAccount> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/accountCurrency> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/ReferenceFrame> ] .
<https://blackcatinformatics.ca/gmeow/FinancialAccount> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/accountHolder> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/FinancialAccount> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/accountType> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/FinancialAccountType> ] .
<https://blackcatinformatics.ca/gmeow/FinancialTransaction> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/transactionAmount> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/MonetaryAmount> ] .
<https://blackcatinformatics.ca/gmeow/Holding> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/holdingAgent> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/Holding> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/holdingAsset> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Asset> ] .
<https://blackcatinformatics.ca/gmeow/Holding> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/holdingQuantity> ; logic:allValuesFrom gmeow:HoldingAssetQuantity ] .
<https://blackcatinformatics.ca/gmeow/Invoice> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/invoiceAmount> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/MonetaryAmount> ] .
<https://blackcatinformatics.ca/gmeow/LedgerAccount> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/ledgerAccountType> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/LedgerAccountType> ] .
<https://blackcatinformatics.ca/gmeow/Order> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/orderAmount> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/MonetaryAmount> ] .
<https://blackcatinformatics.ca/gmeow/Order> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/orderBuyer> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/Order> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/orderSeller> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/Posting> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/postingAccount> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/LedgerAccount> ] .
<https://blackcatinformatics.ca/gmeow/Posting> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/postingAmount> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/MonetaryAmount> ] .
<https://blackcatinformatics.ca/gmeow/Posting> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/postingDirection> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/PostingDirection> ] .
<https://blackcatinformatics.ca/gmeow/Posting> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/postingJournalEntry> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/JournalEntry> ] .
