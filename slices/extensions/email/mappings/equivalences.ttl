# --------------------------------------------------------------------------- #
# Calendar invitation bridge alignments (mail-corpus invitation consumer)
# --------------------------------------------------------------------------- #

gmeow:describesEvent skos:relatedMatch schema:about {|
    gmeow:sssomFile "gmeow-email.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "schema:about is extremely broad; describesEvent is scoped to Event-bearing emails"
|} .

gmeow:calendarUid skos:closeMatch ical:uid {|
    gmeow:sssomFile "gmeow-email.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "iCalendar UID — the persistent identifier of a calendar component"
|} .

gmeow:CalendarMethod skos:relatedMatch ical:method {|
    gmeow:sssomFile "gmeow-email.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "iCalendar METHOD property — the value vocabulary corresponds to the property's value space, not a class equivalence"
|} .

gmeow:hasCalendarMethod skos:closeMatch ical:method {|
    gmeow:sssomFile "gmeow-email.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "iCalendar METHOD property on the calendar component"
|} .

gmeow:messageKindCalendarInvitation skos:relatedMatch ical:Vevent {|
    gmeow:sssomFile "gmeow-email.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "the message carries an iCalendar VEVENT component"
|} .

# --------------------------------------------------------------------------- #
# Mailing-list header terms
# --------------------------------------------------------------------------- #
# MailingList, hasMailingList, listSubscribe, listUnsubscribe, listPost,
# listHelp, listArchive, and listOwner are canonical — no maintained external
# RDF vocabulary covers RFC 2369 / RFC 2919 list headers. Schema.org has no
# mailing-list terms; NMO has no List-* coverage; SIOC has no list concepts.
# This follows the precedent of MessageKind, Mailbox hierarchy, and
# ContentTransferEncoding (all canonical in this slice).
# --------------------------------------------------------------------------- #

# --------------------------------------------------------------------------- #
# Email address structure and envelope/header occurrence terms
# --------------------------------------------------------------------------- #
# gmeow:displayName is occurrence-scoped on MessageParticipant; schema:name is
# broader (applies to Thing / ContactPoint / Person). Bridge is skos:closeMatch.
# gmeow:addressValue, gmeow:localPart, gmeow:domainPart, gmeow:rawAddressValue,
# gmeow:MessageParticipant, gmeow:MessageParticipantRole, and the envelope/resent
# role individuals are canonical — no maintained external RDF vocabulary covers
# RFC 5322 address decomposition, the participant relator pattern, or envelope
# roles. NMO has flat from/to/cc/bcc but no occurrence relator; SIOC has no
# email address structure terms.
# --------------------------------------------------------------------------- #

gmeow:displayName skos:closeMatch schema:name {|
    gmeow:sssomFile "gmeow-email.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW scopes displayName to the MessageParticipant occurrence; schema:name is broader (Thing/ContactPoint/Person)"
|} .

gmeow:Thread skos:closeMatch sioc:Container {|
    gmeow:sssomFile "gmeow-email.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "a thread is a SIOC container of its posts; closeMatch because Container is the broader contents-holder notion (PROV activity alignment phase 3 — declares the sioc projection's Container typing row)"
|} .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:Mailbox skos:closeMatch wd:Q1531418 {|
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:objectLabel "mailbox" ;
    gmeow:comment "Wikidata 'mailbox' is primarily physical; GMEOW Mailbox covers both physical and electronic. Directional lossy projection."
|} .
