#
# Competency: which co-equal evaluator vantages registered observations under the comparison?
# Over the multi-evaluator-no-winner pass scene this returns exactly the three vantages
# (E1, E2, E3), proving conflicting evaluators coexist as co-equal cells (Principle 9), none
# privileged.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
SELECT DISTINCT ?vantage WHERE {
    ?observation a gmeow:PreferenceObservation ;
        gmeow:comparisonContext ?ctx ;
        gmeow:vantage ?vantage .
}
ORDER BY ?vantage
