#
# Declarative structural assertions for the inquiry slice — the slice-resident
# test-DSL twin of the MUST / MUST-NOT invariants formerly hand-written in
# tests/test_inquiry.py. Authored as gmeow: ontology data so the same
# annotation discipline and the native Rust harness (crates/slicetest)
# drive the test, not ad-hoc Python. Each assertion runs as a SPARQL ASK over
# the module graph (gmeow:scopeModule). A positive universal over a fixed term
# set is a single MUST with a conjunctive pattern (all conjuncts must match); a
# negative universal ("no bridge between siblings") is a MUST-NOT over a VALUES
# set or explicit pair list.
#
# The annotation-completeness test (formerly test_every_declared_term_is_annotated)
# is covered by the global `make validate` SHACL gate (shapes/gmeow-shapes.ttl:
# GmeowClassShape + GmeowPropertyShape enforce rdfs:label / skos:definition /
# rdfs:isDefinedBy / gmeow:graphBoxRole on every gmeow:-namespaced class and
# property). Verified 2026-06-22: deleting gmeow:Question's rdfs:label caused
# make validate to emit "error Every GMEOW class must carry at least one
# rdfs:label." and exit non-zero. That pytest function is therefore deleted
# rather than migrated.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/inquiry/tests/> .

# --- 1. Question is a SocialObject Kind (MUST hold) ---------------------------
ex:saQuestionIsSocialObjectKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Question a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:SocialObject .
}""" ;
    gmeow:saRationale "gmeow:Question MUST be an owl:Class, a logic:Kind, and a subClassOf gmeow:SocialObject — the third content-mode sibling sharing the SocialObject genus." .

# --- 2. Content-mode siblings have no subsumption (MUST-NOT hold) -------------
ex:saContentModeSiblingsNoSubsumption a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES (?sub ?sup) {
        (gmeow:Question    gmeow:Proposition)
        (gmeow:Question    gmeow:Goal)
        (gmeow:Proposition gmeow:Question)
        (gmeow:Goal        gmeow:Question)
    }
    ?sub rdfs:subClassOf ?sup .
}""" ;
    gmeow:saRationale "Question / Proposition / Goal are content-mode siblings (documentation only): no rdfs:subClassOf bridge may exist between them in either direction — subsumption would erase the content-mode distinction." .

# --- 3a. Inquiry spine: object properties with Agent domain (MUST hold) -------
ex:saSpineObjectPropertiesWithAgentDomain a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:asks            a owl:ObjectProperty ; rdfs:domain gmeow:Agent .
    gmeow:wondersWhether  a owl:ObjectProperty ; rdfs:domain gmeow:Agent .
    gmeow:inquiresInto    a owl:ObjectProperty ; rdfs:domain gmeow:Agent .
    gmeow:seeksToKnow     a owl:ObjectProperty ; rdfs:domain gmeow:Agent .
}""" ;
    gmeow:saRationale "Every inquiry spine verb (asks, wondersWhether, inquiresInto, seeksToKnow) MUST be an owl:ObjectProperty with rdfs:domain gmeow:Agent." .

# --- 3b. Inquiry spine is open-range: NO rdfs:range (MUST-NOT hold) ----------
ex:saSpineOpenRange a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?p { gmeow:asks gmeow:wondersWhether gmeow:inquiresInto gmeow:seeksToKnow }
    ?p rdfs:range ?r .
}""" ;
    gmeow:saRationale "The inquiry spine is OPEN-RANGE (Principle 13): no spine verb may declare an rdfs:range." .

# --- 3c. Inquiry spine is non-functional (MUST-NOT hold) ---------------------
ex:saSpineNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p { gmeow:asks gmeow:wondersWhether gmeow:inquiresInto gmeow:seeksToKnow }
    ?rec logic:characterizes ?p ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "No inquiry spine verb may be owl:FunctionalProperty — an agent holds many open questions simultaneously." .

# --- 4. Inquiry spine is flat: no rdfs:subPropertyOf (MUST-NOT hold) ---------
ex:saSpineIsFlat a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?p { gmeow:asks gmeow:wondersWhether gmeow:inquiresInto gmeow:seeksToKnow }
    ?p rdfs:subPropertyOf ?anything .
}""" ;
    gmeow:saRationale "The inquiry spine is FLAT (Principle 4): no spine verb may declare an rdfs:subPropertyOf — four distinct attitudes, not a hierarchy (contrast the doxastic keystone knowsThat ⊑ believes)." .

# --- 5. QuestionType is an AbstractIndividualType (MUST hold) -----------------
ex:saQuestionTypeIsAbstractIndividualType a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:QuestionType a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:QuestionType MUST be an owl:Class AND logic:AbstractIndividualType AND a subClassOf logic:QualityValue — the value-vocabulary genus." .

# --- 6. All five question-type seed individuals are typed QuestionType (MUST) -
ex:saQuestionTypeIndividualsSeeded a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:typePolar       a gmeow:QuestionType .
    gmeow:typeAlternative a gmeow:QuestionType .
    gmeow:typeWh          a gmeow:QuestionType .
    gmeow:typeWhy         a gmeow:QuestionType .
    gmeow:typeHow         a gmeow:QuestionType .
}""" ;
    gmeow:saRationale "All five question-type seed individuals (typePolar, typeAlternative, typeWh, typeWhy, typeHow) MUST be explicitly typed gmeow:QuestionType (closed value vocabulary, members never subclasses)." .

# --- 7a. questionType is an ObjectProperty with correct domain/range (MUST) ---
ex:saQuestionTypeProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:questionType a owl:ObjectProperty ;
        rdfs:domain gmeow:Question ;
        rdfs:range gmeow:QuestionType .
}""" ;
    gmeow:saRationale "gmeow:questionType MUST be an owl:ObjectProperty with domain gmeow:Question and range gmeow:QuestionType." .

# --- 7b. questionType is non-functional (MUST-NOT hold) -----------------------
ex:saQuestionTypeNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { ?rec logic:characterizes gmeow:questionType ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:questionType MUST NOT be functional — typeWhy and typeHow may co-apply to a single question." .

# --- 8a. presupposes is an ObjectProperty with domain/range (MUST hold) -------
ex:saPresupposesProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:presupposes a owl:ObjectProperty ;
        rdfs:domain gmeow:Question ;
        rdfs:range gmeow:Proposition .
}""" ;
    gmeow:saRationale "gmeow:presupposes MUST be an owl:ObjectProperty with domain gmeow:Question and range gmeow:Proposition." .

# --- 8b. presupposes is non-functional (MUST-NOT hold) ------------------------
ex:saPresupposesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { ?rec logic:characterizes gmeow:presupposes ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:presupposes MUST NOT be functional — a question may presuppose several propositions." .

# --- 9a. answers is an ObjectProperty with range (MUST hold) ------------------
ex:saAnswersProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:answers a owl:ObjectProperty ;
        rdfs:range gmeow:Question .
}""" ;
    gmeow:saRationale "gmeow:answers MUST be an owl:ObjectProperty ranging over gmeow:Question." .

# --- 9b. answers has open domain: NO rdfs:domain (MUST-NOT hold) -------------
ex:saAnswersOpenDomain a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:answers rdfs:domain ?d . }""" ;
    gmeow:saRationale "gmeow:answers MUST NOT declare an rdfs:domain — the answer surface must never be prematurely closed (Principle 13)." .

# --- 9c. answers is non-functional (MUST-NOT hold) ---------------------------
ex:saAnswersNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { ?rec logic:characterizes gmeow:answers ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:answers MUST NOT be functional — answers are vantage-indexed and coexist (Principle 9)." .

# --- 10a. evokes is an ObjectProperty with range (MUST hold) ------------------
ex:saEvokesProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:evokes a owl:ObjectProperty ;
        rdfs:range gmeow:Question .
}""" ;
    gmeow:saRationale "gmeow:evokes MUST be an owl:ObjectProperty ranging over gmeow:Question." .

# --- 10b. evokes has open domain: NO rdfs:domain (MUST-NOT hold) -------------
ex:saEvokesOpenDomain a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:evokes rdfs:domain ?d . }""" ;
    gmeow:saRationale "gmeow:evokes MUST NOT declare an rdfs:domain — a Proposition or a Question may evoke a question, so the domain stays open (Principle 13)." .

# --- 10c. evokes is non-functional (MUST-NOT hold) ---------------------------
ex:saEvokesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { ?rec logic:characterizes gmeow:evokes ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:evokes MUST NOT be functional — one premise may evoke many questions (Wiśniewski erotetic implication)." .

# --- 11a. InquiryTenure is a SituationType / TimeScopedRelation (MUST hold) ---
ex:saInquiryTenureClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:InquiryTenure a owl:Class , logic:Situation ;
        rdfs:subClassOf gmeow:TimeScopedRelation .
}""" ;
    gmeow:saRationale "gmeow:InquiryTenure MUST be an owl:Class AND logic:Situation AND a subClassOf gmeow:TimeScopedRelation (not a bare relator)." .

# --- 11b. InquiryTenure tenure roles are ObjectProperties (MUST) ---
ex:saInquiryTenureRoles a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:tenureInquirer a owl:ObjectProperty ;
        rdfs:domain gmeow:InquiryTenure ;
        rdfs:range gmeow:Agent .
    gmeow:tenureQuestion a owl:ObjectProperty ;
        rdfs:domain gmeow:InquiryTenure ;
        rdfs:range gmeow:Question .
}""" ;
    gmeow:saRationale "Both tenure roles MUST be owl:ObjectProperty: tenureInquirer domain InquiryTenure range Agent; tenureQuestion domain InquiryTenure range Question; their single-value functionality now lives on the logic: PropertyCharacteristicAssertion carrier and is DL-enforced." .

# --- 11c. EL someValuesFrom mediation restriction on tenureQuestion (MUST) ---
ex:saInquiryTenureELRestriction a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:InquiryTenure rdfs:subClassOf ?r .
    ?r a owl:Restriction ;
       owl:onProperty gmeow:tenureQuestion ;
       owl:someValuesFrom gmeow:Question .
}""" ;
    gmeow:saRationale "The EL relator-mediation restriction MUST exist: some blank node is a someValuesFrom gmeow:Question restriction on gmeow:tenureQuestion, asserted as a superclass of gmeow:InquiryTenure." .

# --- 12. No truth or resolved bit in any triple position (MUST-NOT hold) ------
ex:saNoTruthOrResolvedBit a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    VALUES ?forbidden {
        gmeow:isResolved gmeow:isAnswered gmeow:answerValue gmeow:isTrue gmeow:isFalse
    }
    {   ?forbidden ?p ?o . }
    UNION { ?s ?forbidden ?o . }
    UNION { ?s ?p ?forbidden . }
}""" ;
    gmeow:saRationale "None of isResolved / isAnswered / answerValue / isTrue / isFalse may appear in any subject, predicate, or object position — a question is resolved by reusing the epistemics spine over an answers-claim (Principle 6), never by a resolution bit." .
