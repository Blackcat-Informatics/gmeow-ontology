            [ gmeow:subjectVar "contrib" ; gmeow:predicate gmeow:contributionRole ; gmeow:objectValue gmeow:roleCodeReviewer ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "revAgent" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ] ;
    gmeow:hasBinding [
        gmeow:profile "codemeta" ; gmeow:toPredicate codemeta:contributor ; gmeow:relation "<=" ;
        gmeow:lossyDrop "reviewer role collapsed to contributor; contribution period, provenance, confidence, degree" ] .

