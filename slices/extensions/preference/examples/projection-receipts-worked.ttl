#
# Pass-witness scene: one honest gmeow:ProjectionReceipt of EACH of the five
# gmeow:projectionKind values over a single candidate field. Every derived ranking is
# a LOSSY, disclosed, content-addressed projection of the canonical sheaf — never the
# canon. Each receipt carries a gmeow:contentDigest (blake3), a gmeow:projectionSourceSet,
# and exactly one logic:preservationKind; a receipt is logic:ExactPreservation ONLY when
# it drops nothing (the pairwise view), otherwise it carries a lossy kind AND a
# gmeow:DisclosedLossEntry naming every gmeow:droppedRelation. Deterministic receipts
# carry a gmeow:tieBreakRule; the positively-declared nondeterministic Pareto receipt
# carries none. The scalarized receipt additionally discloses gmeow:scalarizationWeights
# plus a gmeow:scalarizationChoice on its loss entry.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/preference/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# --- The one source field all five receipts project over --------------------- #
ex:candA a gmeow:InformationObject ; rdfs:label "candidate A"@en .
ex:candB a gmeow:InformationObject ; rdfs:label "candidate B"@en .
ex:candC a gmeow:InformationObject ; rdfs:label "candidate C"@en .

ex:candidates a gmeow:CandidateSet ;
    rdfs:label "the shared candidate field"@en ;
    gmeow:hasCandidate ex:candA , ex:candB , ex:candC .

# The canonical edges some projections cannot realize (raw math:Relation referents).
ex:incompEdge a math:Relation ; rdfs:label "a canonical incomparability edge"@en .
ex:cyclicEdge a math:Relation ; rdfs:label "a canonical cyclic preference edge"@en .
ex:totalOrderEdge a math:Relation ; rdfs:label "a strict order across a Pareto void"@en .
ex:tiedPairEdge a math:Relation ; rdfs:label "a canonical tie edge collapsed by scalarizing"@en .

# --- 1. PAIRWISE — exact, deterministic (drops nothing) ----------------------- #
ex:recPairwise a gmeow:ProjectionReceipt ;
    rdfs:label "pairwise projection (exact)"@en ;
    gmeow:projectionKind gmeow:projectionPairwise ;
    gmeow:projectionSourceSet ex:candidates ;
    gmeow:projectionDeterminism gmeow:determinismDeterministic ;
    gmeow:tieBreakRule "lexicographic-by-iri" ;
    logic:preservationKind logic:ExactPreservation ;
    gmeow:contentDigest "blake3:a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90" .

# --- 2. LISTWISE — lossy (collapses the incomparable pair into a total order) -- #
ex:lossListwise a gmeow:DisclosedLossEntry ;
    rdfs:label "dropped: an incomparability edge forced into a total order"@en ;
    gmeow:droppedRelation ex:incompEdge .
ex:recListwise a gmeow:ProjectionReceipt ;
    rdfs:label "listwise projection (sound-under-approximation)"@en ;
    gmeow:projectionKind gmeow:projectionListwise ;
    gmeow:projectionSourceSet ex:candidates ;
    gmeow:projectionDeterminism gmeow:determinismDeterministic ;
    gmeow:tieBreakRule "stable-by-arrival-order" ;
    gmeow:disclosesLoss ex:lossListwise ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:expressivenessBoundary logic:SecondOrder ;
    gmeow:contentDigest "blake3:b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1" .

# --- 3. DAG / HYPERGRAPH — lossy (must drop the cyclic edge to stay acyclic) --- #
ex:lossDag a gmeow:DisclosedLossEntry ;
    rdfs:label "dropped: a cyclic preference edge (DAG must be acyclic)"@en ;
    gmeow:droppedRelation ex:cyclicEdge .
ex:recDag a gmeow:ProjectionReceipt ;
    rdfs:label "DAG/hypergraph projection (sound-under-approximation)"@en ;
    gmeow:projectionKind gmeow:projectionDagHypergraph ;
    gmeow:projectionSourceSet ex:candidates ;
    gmeow:projectionDeterminism gmeow:determinismDeterministic ;
    gmeow:tieBreakRule "topological-then-lexicographic" ;
    gmeow:disclosesLoss ex:lossDag ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:expressivenessBoundary logic:SecondOrder ;
    gmeow:contentDigest "blake3:c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2" .

# --- 4. PARETO — lossy AND positively NONDETERMINISTIC (no tie-break rule) ----- #
ex:lossPareto a gmeow:DisclosedLossEntry ;
    rdfs:label "dropped: any strict order across the Pareto-incomparable region"@en ;
    gmeow:droppedRelation ex:totalOrderEdge .
ex:recPareto a gmeow:ProjectionReceipt ;
    rdfs:label "Pareto projection (nondeterministic frontier ordering)"@en ;
    gmeow:projectionKind gmeow:projectionPareto ;
    gmeow:projectionSourceSet ex:candidates ;
    gmeow:projectionDeterminism gmeow:determinismNondeterministic ;
    gmeow:disclosesLoss ex:lossPareto ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:expressivenessBoundary logic:SecondOrder ;
    gmeow:contentDigest "blake3:d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3" .

# --- 5. SCALARIZED — lossy, with disclosed weights + a scalarization choice ---- #
ex:lossScalar a gmeow:DisclosedLossEntry ;
    rdfs:label "dropped: a tie edge broken by the weighted scalar"@en ;
    gmeow:droppedRelation ex:tiedPairEdge ;
    gmeow:scalarizationChoice "weighted-sum: latency*0.4 + accuracy*0.6, ties broken toward accuracy" .
ex:recScalar a gmeow:ProjectionReceipt ;
    rdfs:label "scalarized projection (weighted sum, deterministic)"@en ;
    gmeow:projectionKind gmeow:projectionScalarized ;
    gmeow:projectionSourceSet ex:candidates ;
    gmeow:projectionDeterminism gmeow:determinismDeterministic ;
    gmeow:tieBreakRule "higher-accuracy-first" ;
    gmeow:scalarizationWeights "{\"latency\":0.4,\"accuracy\":0.6}" ;
    gmeow:disclosesLoss ex:lossScalar ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:expressivenessBoundary logic:SecondOrder ;
    gmeow:contentDigest "blake3:e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4" .
