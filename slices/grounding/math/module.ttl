    logic:argument [ logic:termIndex 0 ; logic:termVariable "vn" ] , [ logic:termIndex 1 ; logic:termIri math:NegativeInfinity ] .

# divergesWithoutLimit ⟹ ¬ ∃ v limitResultValue(this, v)
math:lrvNoLimit a logic:Formula ; logic:antecedent math:lrvNoGuard ; logic:consequent math:lrvNoNot .
