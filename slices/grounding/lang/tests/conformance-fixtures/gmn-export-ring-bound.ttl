# Conforming GMN fixture: an export crossing bound to its ring. The
# generating activity carries gmeow:mentalProcessType gmeow:processExport (mentation) and
# the gmeow:GmnEnvelope it produced carries a full nine-field contract INCLUDING
# gmeow:gmnSecurityRing, so lang:GmnExportRingBindingShape validates with no findings
# (and, incidentally, so does lang:GmnEnvelopeContractShape — both gates are satisfied
# by the same complete envelope).

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

ex:archiveTeam a gmeow:Agent .

ex:agentLillith a gmeow:Agent .

# The mentation occurrent: an export episode, typed by mentation's own value
# vocabulary. This fixture reads it only through the envelope's gmeow:wasGeneratedBy
# hook — no lang term is asserted about it, and mentation gains no edge on lang.
ex:exportRun a gmeow:MentalProcess , gmeow:Activity ;
    gmeow:experiencer ex:agentLillith ;
    gmeow:mentalProcessType gmeow:processExport .

ex:corrExportEnvelope a logic:Correspondence ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:SectionRetraction ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true .

ex:envelopeExportBound a gmeow:GmnEnvelope ;
    gmeow:gmnSchemaVersion "1" ;
    gmeow:gmnDictionaryVersion "3" ;
    gmeow:gmnGlyphTableVersion "2" ;
    gmeow:gmnSecurityRing gmeow:gmnRingTrusted ;
    gmeow:accordingTo ex:archiveTeam ;
    gmeow:wasGeneratedBy ex:exportRun ;
    gmeow:contentDigest "blake3:1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f80" ;
    gmeow:gmnCodebookDigest "blake3:26a68453ecfe47867551038b8b247e9f4b07b3815bd87979c401afb0f7edf5ce" ;
    gmeow:gmnEnvelopeCorrespondence ex:corrExportEnvelope .
