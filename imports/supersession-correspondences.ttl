    rdfs:label "graft-negative: gmeow:NotationProjectionProfile ↔ lang:Rendering"@x-gmeow-english ;
    skos:definition "Retained-negative: gmeow:NotationProjectionProfile is RETAINED (it carries the representable-parameter/declared-loss ledger and the FnO projectionFunction binding lang:Rendering holds none of); a concrete render is a lang:Rendering that references the profile through lang:renderingConvention. AffineCorrespondence: a partial, non-recovering relation, not a supersession."@x-gmeow-english ;
    logic:supersededTerm gmeow:NotationProjectionProfile ;
    logic:supersedingTerm lang:Rendering ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:AffineCorrespondence ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "false"^^xsd:boolean ;
    gmeow:graphBoxRole gmeow:boxABox .

