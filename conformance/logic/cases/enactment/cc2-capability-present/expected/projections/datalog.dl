% === Rules ===
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierBlockedCapabilityOrResource", ?C) :-
    entryAction(?entry, ?step, ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepWaiting", ?C),
    gapBlockedStep(?gap, ?step, ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierBlockedPrecondition", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepPending", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierCancelled", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/EnactmentCancelled", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/InfoNotEvaluated", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepCancelled", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierCancelledWithInFlightEffects", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/EnactmentCancelled", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/InfoUndetermined", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepCancelled", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierCompensationEligible", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/EffectReceipted", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierCompensationFailedForwardCommitted", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/EffectCompensating", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/EnactmentRunning", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/InfoSupported", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepFailed", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierCompensationRequired", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/EffectReconciled", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/EnactmentFailed", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/InfoSupported", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierCompleted", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepCompleted", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierMutuallyExclusive", ?C) :-
    entryExcludes(?entry, ?other, ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierReadyApprovalRequired", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/ApprovalCreated", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepReady", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierReadyAuthorized", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/ApprovalNull", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepReady", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierReconciliationImpossible", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/EffectAbandoned", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierReconciliationRequired", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/EffectAttempted", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierSkippedWithTypedReason", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepSkipped", ?C),
    skipReason(?entry, ?reason, ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierTerminallyFailed", ?C) :-
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/EnactmentFailed", ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepFailed", ?C).
entryLabel(?entry, "https://blackcatinformatics.ca/logic/FrontierWaitingOnEventTimeOrInput", ?C) :-
    entryAwaits(?entry, ?awaited, ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/StepWaiting", ?C).
methodStep(?method, ?step, ?C) :-
    first(?cell, ?step, ?C),
    methodYieldCell(?method, ?cell, ?C).
methodYieldCell(?method, ?cell, ?C) :-
    methodYields(?method, ?cell, ?C).
methodYieldCell(?method, ?next, ?C) :-
    rest(?cell, ?next, ?C),
    methodYieldCell(?method, ?cell, ?C).
refinementRejectedOnApproval(?step, ?entry, ?C) :-
    entryAction(?entry, ?step, ?C),
    entryAxisWitness(?entry, "https://blackcatinformatics.ca/logic/ApprovalCreated", ?C).
refinementRejectedOnCapability(?step, ?capability, ?C) :-
    gapBlockedStep(?gap, ?step, ?C),
    proposalBlockedStep(?proposal, ?step, ?C),
    proposalMissingCapability(?proposal, ?capability, ?C).
refinementRejectedOnPrecondition(?step, ?situation, ?C) :-
    gateVerdict(?probe, "https://blackcatinformatics.ca/logic/GateDenied", ?C),
    probesSchema(?probe, ?step, ?C),
    precondition(?step, ?situation, ?C).
refinementRejectedOnResource(?step, ?lease, ?C) :-
    entryAction(?entry, ?step, ?C),
    entryAwaits(?entry, ?resource, ?C),
    leaseScope(?lease, ?resource, ?C).
refinementCandidateMethod(?task, ?method, ?C) :-
    methodDecomposes(?method, ?task, ?C).
refinementExpands(?task, ?step, ?C) :-
    methodDecomposes(?method, ?task, ?C),
    methodStep(?method, ?step, ?C).
refinementReaches(?task, ?far, ?C) :-
    refinementReaches(?mid, ?far, ?C),
    refinementReaches(?task, ?mid, ?C).
refinementReaches(?task, ?step, ?C) :-
    refinementExpands(?task, ?step, ?C).
