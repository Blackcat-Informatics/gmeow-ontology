+    let source = diagnostic
+        .inner_mut()
+        .source
+        .as_mut()
+        .expect("typed failure");
+    let payload = source
+        .downcast_mut::<ExternalEvidenceFailure>()
+        .expect("typed failure");
+    payload.evidence.classification = EvidenceFailureClass::Resource;
+    payload.evidence.observed = Some(observed);
