# Real call identities are supplied independently of trace-kind membership.
ex:prompt a gmeow:Prompt ;
    gmeow:promptRole gmeow:promptRoleUser ;
    gmeow:promptText "Summarize the supplied harbor note."@en .
ex:call a gmeow:ModelInvocation ;
    gmeow:usedModel ex:model ;
    gmeow:hasPrompt ex:prompt ;
    gmeow:eventTemporalFrame gmeow:temporalFrameUTCGregorian ;
    gmeow:subEventOf ex:episode .
ex:modelRequest gmeow:subEventOf ex:call .
ex:modelResponse gmeow:subEventOf ex:call .

ex:toolCall a gmeow:ToolCall ;
    gmeow:usedTool ex:tool ;
    gmeow:toolName "record.read" ;
    gmeow:toolCallId "call  17" .

# The producing occurrence and image artifact are distinct. Image production
# does not add a multimodal-generation type to this occurrence.
ex:imageGeneration a gmeow:Activity .
ex:imageWork a gmeow:Work .
ex:imageExpression a gmeow:Expression ; gmeow:realizes ex:imageWork .
ex:image a gmeow:MediaObject ;
    gmeow:embodies ex:imageExpression ;
    gmeow:wasGeneratedBy ex:imageGeneration .

# These source reports preserve avenue, cost and count conventions as supplied.
# No cost arithmetic, token equivalence or authoritative-global count is asserted.
ex:correctionReport a gmeow:InformationObject ;
    gmeow:description "The source reports a text correction via a foreground instruction and quotes a cost of two provider tokens."@en ;
    gmeow:wasAttributedTo ex:runtime .
ex:accountingReport a gmeow:InformationObject ;
    gmeow:description "The engine designates its count of 17 tokens authoritative within its own tokenizer convention."@en ;
    gmeow:wasAttributedTo ex:runtime .
ex:engineAuthoritativeTokenCount gmeow:engineContract "trace/accounting  v1" .

# An earlier running reading is an Observation, not a terminal outcome or a
# mutable state property on the invocation Event.
ex:runningSource a gmeow:InformationObject ;
    gmeow:description "The runtime reported that this call was still running at the recorded reading."@en ;
    gmeow:wasAttributedTo ex:runtime ;
    gmeow:recordedAt "2030-05-02T09:00:01Z"^^xsd:dateTime .
ex:runningReading a gmeow:Observation ;
    gmeow:invocationState gmeow:invocationStateRunning ;
    gmeow:observedFeature ex:call ;
    gmeow:vantage ex:runtime ;
    gmeow:observationMethod gmeow:methodInstrumentalReading ;
    gmeow:observedAt "2030-05-02T09:00:00Z"^^xsd:dateTime ;
    gmeow:wasDerivedFrom ex:runningSource ;
    gmeow:wasAttributedTo ex:archiveWriter .

# Later terminal evidence is retained without erasing the earlier reading.
ex:terminalSource a gmeow:InformationObject ;
    gmeow:description "The runtime subsequently reported that the same invocation succeeded."@en ;
    gmeow:wasAttributedTo ex:runtime ;
    gmeow:recordedAt "2030-05-02T09:01:00Z"^^xsd:dateTime .
ex:call gmeow:invocationOutcome gmeow:invocationOutcomeSucceeded .
ex:outcomeClaim rdf:reifies <<( ex:call gmeow:invocationOutcome gmeow:invocationOutcomeSucceeded )>> ;
    gmeow:accordingTo ex:runtime ;
    gmeow:wasAttributedTo ex:archiveWriter ;
    gmeow:wasDerivedFrom ex:terminalSource ;
    gmeow:recordedAt "2030-05-02T09:01:00Z"^^xsd:dateTime .

# The screen's source code is separate from the answer text and from any
# claim about the external model's identity, intention or actual attack success.
ex:outsideAnswer a gmeow:InformationObject ;
    gmeow:description "The retained answer contains unrelated directions to change the reader's role."@en .
ex:screenReport a gmeow:InformationObject ;
    gmeow:description "The source screen assigned its own role-override category to that answer."@en ;
    gmeow:wasAttributedTo ex:screen ;
    gmeow:recordedAt "2030-05-02T09:02:00Z"^^xsd:dateTime .
ex:screenReading a gmeow:Observation ;
    gmeow:injectionCategory " role-override  " ;
    gmeow:observedFeature ex:outsideAnswer ;
    gmeow:vantage ex:reader ;
    gmeow:observationMethod gmeow:methodInstrumentalReading ;
    gmeow:wasDerivedFrom ex:screenReport ;
    gmeow:wasAttributedTo ex:archiveWriter .
