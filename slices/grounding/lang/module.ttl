gmeow:gmnCandidateLangUngrammatical
    a gmeow:GmnSymbolCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: ungrammaticality as asterisk"@x-gmeow-english ;
    skos:definition "The audited adoption of the scoped linguistic asterisk for lang:Ungrammaticality."@x-gmeow-english ;
    gmeow:gmnCandidateTarget lang:Ungrammaticality ;
    gmeow:gmnCandidateGlyph "*" ;
    gmeow:gmnAsciiFallback "ungrammatical" ;
    gmeow:gmnSpokenLabel "ungrammatical" ;
    gmeow:gmnArity 1 ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionAdoptedGlyph ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisTokenCost ;
    gmeow:gmnDispositionRationale "The conventional asterisk costs one pinned BPE token, no more than its ASCII fallback, and @lambda scope keeps it distinct from mathematical multiplication." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenUngrammatical ;
    gmeow:cites gmeow:gmnLinguisticNotationWork ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnCandidateLangDenotation
    a gmeow:GmnSymbolCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: denotation brackets"@x-gmeow-english ;
    skos:definition "The audited named-key ruling for familiar semantic denotation brackets."@x-gmeow-english ;
    gmeow:gmnCandidateTarget lang:Denotation ;
    gmeow:gmnCandidateGlyph "⟦·⟧" ;
    gmeow:gmnAsciiFallback "den" ;
    gmeow:gmnSpokenLabel "denotation" ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionNamedKey ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisTokenCost ;
    gmeow:gmnDispositionRationale "The two semantic brackets and placeholder fragment into more pinned BPE tokens than the one-token `den` key, so the display notation stays outside the executable glyph registry." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenDenotation ;
    gmeow:cites gmeow:gmnFormalSemanticsNotationWork ;
    gmeow:graphBoxRole gmeow:boxABox .

