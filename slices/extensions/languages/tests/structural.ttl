# SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
# SPDX-License-Identifier: CC-BY-4.0
#
# Declarative structural assertions for the languages extension slice — the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_languages.py. Each assertion runs as a
# SPARQL ASK over the languages module graph (gmeow:scopeModule) under the
# native Rust harness (crates/slicetest).
#
# Languages is #694-migrated: class stereotypes are logic:
# (logic:AbstractIndividualType, logic:Kind, logic:SubKind, logic:Event,
# logic:QualityValue), not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_language_hierarchy — Language, FormalLanguage, ProgrammingLanguage,
#     WritingSystem are defined in slices/core/language/module.ttl; only
#     LanguageVersion is local, but the test checks all five together as one
#     cross-slice structural invariant.
#   test_registry_independence_no_required_code — gmeow:languageCode is
#     defined in slices/core/language/module.ttl (cross-slice), and the test
#     also performs a dynamic cardinality-restriction sweep over the graph.
#   test_transliteration_scheme_retrofits_names — gmeow:transliterationScheme
#     is defined in slices/core/language/module.ttl (cross-slice).
#   test_software_bridge_and_version_lineage — gmeow:writtenInLanguage is in
#     slices/core/language/module.ttl and gmeow:versionOf is in
#     slices/core/coreference/module.ttl (both cross-slice).
#   test_internal_language_tags — gmeow:languageTag is defined in
#     slices/core/language/module.ttl (cross-slice).
#   test_projection_bcp47_tags_are_distinct_from_registry_codes — gmeow:bcp47Tag
#     is defined in slices/core/language/module.ttl (cross-slice).
#   test_core_seed_languages_use_reference_catalog_iris — langEnglish,
#     langFrench, langMandarin are defined in slices/core/language/module.ttl
#     (cross-slice).
#   test_reference_catalog_languages_are_annotated_and_aligned — uses
#     include_imports=True; dynamic sweep of 184 ISO 639-1 codes with numeric
#     count assertions against the reference catalog.
#   test_reference_catalog_writing_systems_are_annotated — include_imports=True;
#     dynamic sweep over all writing systems linked from catalog languages.
#   test_reference_catalog_programming_languages_typed — include_imports=True;
#     subjects (langPython, langRust, langJavaScript, langTypeScript, langJava)
#     are in the reference catalog, not this module.
#   test_reference_catalog_glottolog_alignments — include_imports=True; dynamic
#     check on catalog-only language subjects.
#   test_language_tag_map_is_deterministic_and_covers_catalog — tests the
#     gmeow_tools.language_tags.load_tag_map Python function; not a TBox triple
#     assertion.
#   test_inverse_tag_map_recovers_natural_internal_tags — tests
#     load_inverse_tag_map Python function; not a TBox triple assertion.
#   test_retag_graph_to_internal_lifts_public_to_canonical — tests
#     retag_graph_to_internal Python function on a synthetic graph; not a TBox
#     triple assertion.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest→DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/languages/tests/> .

# ---------------------------------------------------------------------------
# GROUP 1: WritingSystemUsage reified relator and its functional roles (MUST)
# Mirrors test_reified_relators_and_functional_roles (WritingSystemUsage arm).
# ---------------------------------------------------------------------------

# --- 1. WritingSystemUsage is a logic:Kind and subclass of logic:Relator (MUST)
ex:saWritingSystemUsageIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:WritingSystemUsage a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:WritingSystemUsage MUST be an owl:Class typed logic:Kind and a subclass of logic:Relator — it is the reified binding of {language} × {writing system} × {role} × {period}. Mirrors test_reified_relators_and_functional_roles (WritingSystemUsage relator arm)." .

# --- 2. usageLanguage is a functional ObjectProperty (MUST)
ex:saUsageLanguageFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:usageLanguage a owl:ObjectProperty , owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:usageLanguage MUST be an owl:ObjectProperty and owl:FunctionalProperty — constitutive of WritingSystemUsage (exactly one language per usage). Mirrors test_reified_relators_and_functional_roles (usageLanguage role arm)." .

# --- 3. usageWritingSystem is a functional ObjectProperty (MUST)
ex:saUsageWritingSystemFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:usageWritingSystem a owl:ObjectProperty , owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:usageWritingSystem MUST be an owl:ObjectProperty and owl:FunctionalProperty — constitutive of WritingSystemUsage (exactly one writing system per usage). Mirrors test_reified_relators_and_functional_roles (usageWritingSystem role arm)." .

# --- 4. scriptRole is a functional ObjectProperty (MUST)
ex:saScriptRoleFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:scriptRole a owl:ObjectProperty , owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:scriptRole MUST be an owl:ObjectProperty and owl:FunctionalProperty — one role per usage (a script playing two roles is two usages). Mirrors test_reified_relators_and_functional_roles (scriptRole role arm)." .

# ---------------------------------------------------------------------------
# GROUP 2: LanguageProficiency reified relator and its functional roles (MUST)
# Mirrors test_reified_relators_and_functional_roles (LanguageProficiency arm).
# ---------------------------------------------------------------------------

# --- 5. LanguageProficiency is a logic:Kind and subclass of logic:Relator (MUST)
ex:saLanguageProficiencyIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LanguageProficiency a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:LanguageProficiency MUST be an owl:Class typed logic:Kind and a subclass of logic:Relator — it is the reified binding of {agent} × {language} × {skill modality} × {level on scale}. Mirrors test_reified_relators_and_functional_roles (LanguageProficiency relator arm)." .

