    rdfs:domain geo:SpatialObject .

geo:hasSerialization a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:domain geo:Geometry ;
    rdfs:range rdfs:Literal .

geo:hasSize a rdf:Property,
        owl:ObjectProperty ;
    rdfs:domain geo:SpatialObject .

geo:hasSpatialAccuracy a rdf:Property,
