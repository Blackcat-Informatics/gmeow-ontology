            "value_iri": "https://blackcatinformatics.ca/gmeow/dimensionValence",
            "value_literal": null
          }
        ]
      },
      {
        "cells": [
          {
            "var": "dimension",
            "value_iri": "https://blackcatinformatics.ca/gmeow/dimensionAgency",
            "value_literal": null
          }
        ]
      }
    ],
