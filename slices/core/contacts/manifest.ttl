@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/contacts>
    a gmeow:Slice ;
    rdfs:label "contacts"@x-gmeow-english ;
    dcterms:title "GMEOW Contacts Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/accounts> ,
        <https://blackcatinformatics.ca/gmeow/slices/agreements> ,
        <https://blackcatinformatics.ca/gmeow/slices/core> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/places> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:sliceConsumer "The mail corpus's address book; email-address structure (core half of the email split)."@x-gmeow-english .
