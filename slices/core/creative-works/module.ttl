gmeow:formatMusicXML              rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/creative-works> .
gmeow:formatMEI                   a gmeow:ManifestationFormat ; rdfs:label "MEI"@x-gmeow-english ;                   skos:definition "An MEI-encoded digital score."@x-gmeow-english .
