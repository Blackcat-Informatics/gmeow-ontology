# The three vector-symbolic operators warrant symbol decisions of their own. Their
# customary glyphs — ⊛ (circled asterisk) or ⊗ for binding, ⊕ for bundling, and ⊘
# (circled slash) or ⊛⁻¹ for unbinding — are all overloaded with their standard
# algebraic meanings (convolution/tensor product, direct sum, circled division),
# and none of them can carry the vector-space + basis + capacity + recovery-loss
# frame that makes a vector-symbolic operation more than a bare binary operator.
# Each disposition is gmnDispositionNamedKey, so no glyph enters the executable GMN
# glyph table and the pinned gmnGlyphTableVersion is unchanged.
gmeow:gmnCandidateMathVectorBinding
    a gmeow:GmnSymbolCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: vector-symbolic binding ⊛"@x-gmeow-english ;
    skos:definition "The audited named-key ruling for the a ⊛ b (or a ⊗ b) notation of math:VectorBinding, the vector-symbolic operation combining two representations into a representation of their association."@x-gmeow-english ;
    gmeow:gmnCandidateTarget math:VectorBinding ;
    gmeow:gmnCandidateGlyph "⊛" ;
    gmeow:gmnAsciiFallback "vsa_bind" ;
    gmeow:gmnSpokenLabel "bind" ;
    gmeow:gmnArity 2 ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionNamedKey ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisAmbiguity ;
    gmeow:gmnDispositionRationale "The circled asterisk ⊛ already denotes convolution and the circled times ⊗ denotes the tensor/Kronecker product, and vector-symbolic binding is written a ⊛ b over a declared vector space, basis, capacity, and recovery-loss contract that a flat glyph cannot carry — recovery being approximate unless an exact algebra proves otherwise; the `vsa_bind` key keeps that frame explicit and adopts no glyph, so the GMN glyph-table version is unchanged." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenMathVectorBinding ;
    gmeow:cites gmeow:gmnOpenMathWork , gmeow:gmnUnicodeMathWork ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnCandidateMathVectorBundling
    a gmeow:GmnSymbolCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: vector-symbolic bundling ⊕"@x-gmeow-english ;
    skos:definition "The audited named-key ruling for the a ⊕ b notation of math:VectorBundling, the vector-symbolic operation superposing several representations into a similarity-preserving aggregate."@x-gmeow-english ;
    gmeow:gmnCandidateTarget math:VectorBundling ;
    gmeow:gmnCandidateGlyph "⊕" ;
    gmeow:gmnAsciiFallback "vsa_bundle" ;
    gmeow:gmnSpokenLabel "bundle" ;
    gmeow:gmnArity 2 ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionNamedKey ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisAmbiguity ;
    gmeow:gmnDispositionRationale "The circled plus ⊕ already denotes the direct sum of spaces and modulo-two (XOR) addition, and vector-symbolic bundling is written a ⊕ b over a declared vector space, basis, and capacity bound on how many items may be superposed before crosstalk overwhelms retrieval — a frame a flat glyph cannot carry; the `vsa_bundle` key keeps that frame explicit and adopts no glyph, so the GMN glyph-table version is unchanged." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenMathVectorBundling ;
    gmeow:cites gmeow:gmnOpenMathWork , gmeow:gmnUnicodeMathWork ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnCandidateMathVectorUnbinding
    a gmeow:GmnSymbolCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: vector-symbolic unbinding ⊘"@x-gmeow-english ;
    skos:definition "The audited named-key ruling for the c ⊘ b (or a ⊛⁻¹) notation of math:VectorUnbinding, the vector-symbolic operation approximately or exactly recovering one bound factor given the other and a declared binding law."@x-gmeow-english ;
    gmeow:gmnCandidateTarget math:VectorUnbinding ;
    gmeow:gmnCandidateGlyph "⊘" ;
    gmeow:gmnAsciiFallback "vsa_unbind" ;
    gmeow:gmnSpokenLabel "unbind" ;
    gmeow:gmnArity 2 ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionNamedKey ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisAmbiguity ;
    gmeow:gmnDispositionRationale "The circled slash ⊘ already denotes circled division and an empty/annihilated element, and unbinding is written c ⊘ b (the inverse of binding under the declared law) whose retrieval carries a mandatory recovery-loss contract — recovery being approximate unless an exact algebra proves otherwise — that a flat glyph cannot express; the `vsa_unbind` key keeps that fidelity frame explicit and adopts no glyph, so the GMN glyph-table version is unchanged." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenMathVectorUnbinding ;
    gmeow:cites gmeow:gmnOpenMathWork , gmeow:gmnUnicodeMathWork ;
    gmeow:graphBoxRole gmeow:boxABox .

# The IPA glyphs remain executable inside phonological surface content but are
# semantically rejected as aliases for their denoted phone IRIs. This prevents
# an identifier-shaped `k` or `t` from overlapping GMN's reference-token grammar.
gmeow:gmnCandidateIpaK
    a gmeow:GmnSymbolCandidate ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: IPA k as a term alias"@x-gmeow-english ; skos:definition "The explicit rejection of IPA k as a flattened GMN reference alias."@x-gmeow-english ;
    gmeow:gmnCandidateTarget gmeow:phoneVoicelessVelarPlosive ; gmeow:gmnCandidateGlyph "k" ; gmeow:gmnAsciiFallback "ipa_k" ; gmeow:gmnSpokenLabel "voiceless velar plosive" ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionSemanticRejection ; gmeow:gmnDispositionBasis gmeow:gmnBasisSemanticMismatch ;
    gmeow:gmnDispositionRationale "IPA k is phonological surface content, not an alias for the phone resource IRI; flattening it would overlap the identifier grammar." ; gmeow:cites gmeow:ipaChartWork ; gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnCandidateIpaAe
    a gmeow:GmnSymbolCandidate ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: IPA ae as a term alias"@x-gmeow-english ; skos:definition "The explicit rejection of IPA ae as a flattened GMN reference alias."@x-gmeow-english ;
    gmeow:gmnCandidateTarget gmeow:phoneNearOpenFrontUnrounded ; gmeow:gmnCandidateGlyph "æ" ; gmeow:gmnAsciiFallback "ipa_ae" ; gmeow:gmnSpokenLabel "near-open front unrounded vowel" ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionSemanticRejection ; gmeow:gmnDispositionBasis gmeow:gmnBasisSemanticMismatch ;
    gmeow:gmnDispositionRationale "IPA ae is phonological surface content, not an alias for the phone resource IRI; its denotation remains in the linguistic plane." ; gmeow:cites gmeow:ipaChartWork ; gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnCandidateIpaT
    a gmeow:GmnSymbolCandidate ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: IPA t as a term alias"@x-gmeow-english ; skos:definition "The explicit rejection of IPA t as a flattened GMN reference alias."@x-gmeow-english ;
    gmeow:gmnCandidateTarget gmeow:phoneVoicelessAlveolarPlosive ; gmeow:gmnCandidateGlyph "t" ; gmeow:gmnAsciiFallback "ipa_t" ; gmeow:gmnSpokenLabel "voiceless alveolar plosive" ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionSemanticRejection ; gmeow:gmnDispositionBasis gmeow:gmnBasisSemanticMismatch ;
    gmeow:gmnDispositionRationale "IPA t is phonological surface content, not an alias for the phone resource IRI; flattening it would overlap the identifier grammar." ; gmeow:cites gmeow:ipaChartWork ; gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnCandidateIpaStress
    a gmeow:GmnSymbolCandidate ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: IPA stress as a term alias"@x-gmeow-english ; skos:definition "The explicit rejection of the IPA stress mark as a flattened GMN reference alias."@x-gmeow-english ;
    gmeow:gmnCandidateTarget gmeow:suprasegmentalPrimaryStress ; gmeow:gmnCandidateGlyph "ˈ" ; gmeow:gmnAsciiFallback "primary_stress" ; gmeow:gmnSpokenLabel "primary stress" ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionSemanticRejection ; gmeow:gmnDispositionBasis gmeow:gmnBasisSemanticMismatch ;
    gmeow:gmnDispositionRationale "The IPA stress mark is phonological surface content, not an alias for the suprasegmental resource IRI; its denotation remains in the linguistic plane." ; gmeow:cites gmeow:ipaChartWork ; gmeow:graphBoxRole gmeow:boxABox .

# --- Codebook wiring -------------------------------------------------------- #
# The current codebook references the two imported alias planes alongside the
# GMN script and sigils it already holds, so a reader that holds the codebook
# holds the linguistic plane's cited, versioned repertoire.

gmeow:gmnCodebookCurrent gmeow:references
    gmeow:ipaChart ,
    gmeow:leipzigGlossingRules .

# =========================================================================== #
# Declarative constraint axioms (grounding slices) — the closed-world presence /
# cardinality / class / datatype obligations the hand-authored shapes.ttl
# NodeShapes state, authored here once as OWL restriction axioms and PROJECTED
# to generated/shapes/validation-shapes.ttl (Principle 17). A restriction that
# carries owl:allValuesFrom owl:Thing projects to sh:nodeKind sh:BlankNodeOrIRI
# (the "a present value is a resource, not a literal" obligation). The
# cross-node / value-set / targetSubjectsOf conditions have no OWL antecedent
# and remain the procedural sh:sparql constraint fragment.
# =========================================================================== #

# Required paths are closed explicitly, per class and property.  Each named
# ClosureEntry is a canonical, queryable authority that the retained validation
# surface can cite while equivalence-before-deletion is completed; paired with
# the allValuesFrom restrictions below, it projects sh:minCount 1 without asking
# the open-world reasoner to invent an existential witness.

lang:formInSignSystemClosure
    a logic:ClosureEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "form sign-system closure"@x-gmeow-english ;
    skos:definition "The class-scoped closed-world authority requiring every lang:Form to carry lang:inSignSystem; its paired universal restriction fixes the value type without creating an existential witness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:onClass lang:Form ;
    logic:closureKey "https://blackcatinformatics.ca/lang/inSignSystem" ;
    logic:closureValue logic:ClosedWorldClosure ;
    gmeow:enforcesFailureClass lang:UnsituatedForm .

lang:wordFormLexemeClosure
    a logic:ClosureEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "word-form lexeme closure"@x-gmeow-english ;
    skos:definition "The class-scoped closed-world authority requiring every lang:WordForm to carry lang:lexemeOf; its paired universal restriction fixes the value as a lang:Lexeme without creating an existential witness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:onClass lang:WordForm ;
    logic:closureKey "https://blackcatinformatics.ca/lang/lexemeOf" ;
    logic:closureValue logic:ClosedWorldClosure ;
    gmeow:enforcesFailureClass lang:OrphanWordForm .

