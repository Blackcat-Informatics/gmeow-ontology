    logic:mnemomorphic "false"^^xsd:boolean ;
    gmeow:graphBoxRole gmeow:boxABox .

# --- Notation profiles / kinds retained + regrounded (AffineCorrespondence) - #
# Retained-negative: lang: does NOT supersede these; they relate to a lang: term
# but stay, carrying facets lang: cannot. A weak, non-recovering relation.
