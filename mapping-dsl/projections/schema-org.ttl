@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .

# Projection mappings: GMEOW → pure schema.org (the richest profile). Compiled to
# projections/schema-org.edoal.ttl + queries/projections/schema-org.rq by
# `gmeow compile-mappings`.

gmeow:mapSchemaPlace a gmeow:ProjectionMapping ;
    rdfs:label "Place → schema:Place (+ containment, coordinates)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:containedInPlace ; gmeow:objectVar "parent" ; gmeow:optional true ]
            [ gmeow:optionalGroup (
                [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:hasCoordinates ; gmeow:objectVar "coords" ]
                [ gmeow:optionalGroup ( [ gmeow:subjectVar "coords" ; gmeow:predicate gmeow:latitude ; gmeow:objectVar "lat" ] ) ]
                [ gmeow:optionalGroup ( [ gmeow:subjectVar "coords" ; gmeow:predicate gmeow:longitude ; gmeow:objectVar "lon" ] ) ]
                [ gmeow:optionalGroup ( [ gmeow:subjectVar "coords" ; gmeow:predicate gmeow:elevation ; gmeow:objectVar "elev" ] ) ] ) ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:Place ]
            [ gmeow:tSubj "place" ; gmeow:tPred schema:containedInPlace ; gmeow:tObj "parent" ]
            [ gmeow:tSubj "place" ; gmeow:tPred schema:geo ; gmeow:tObj "coords" ]
            [ gmeow:tSubj "coords" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:GeoCoordinates ]
            [ gmeow:tSubj "coords" ; gmeow:tPred schema:latitude ; gmeow:tObj "lat" ]
            [ gmeow:tSubj "coords" ; gmeow:tPred schema:longitude ; gmeow:tObj "lon" ]
            [ gmeow:tSubj "coords" ; gmeow:tPred schema:elevation ; gmeow:tObj "elev" ] ) ] .

gmeow:mapSchemaPlaceType a gmeow:ProjectionMapping ;
    rdfs:label "Place placeType value → schema target class"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ; gmeow:value "pt" ;
        gmeow:atom ( [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:placeType ; gmeow:objectVar "pt" ] ) ;
        gmeow:edoalSource gmeow:Place ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "=" ;
        gmeow:transform gmeow:fnPlaceTypeToClass ;
        gmeow:valueClassMap (
            [ gmeow:whenValue gmeow:placeTypeCountry ; gmeow:toClass schema:Country ]
            [ gmeow:whenValue gmeow:placeTypeCity ; gmeow:toClass schema:City ]
            [ gmeow:whenValue gmeow:placeTypeAdministrativeArea ; gmeow:toClass schema:AdministrativeArea ]
            [ gmeow:whenValue gmeow:placeTypeRegion ; gmeow:toClass schema:AdministrativeArea ] ) ] .

gmeow:mapSchemaVirtualLocation a gmeow:ProjectionMapping ;
    rdfs:label "VirtualLocation → schema:VirtualLocation"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "vl" ;
        gmeow:atom (
            [ gmeow:subjectVar "vl" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:VirtualLocation ]
            [ gmeow:subjectVar "vl" ; gmeow:predicate gmeow:accessUrl ; gmeow:objectVar "vurl" ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "vl" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:VirtualLocation ]
            [ gmeow:tSubj "vl" ; gmeow:tPred schema:url ; gmeow:tObj "vurl" ] ) ] .

gmeow:mapSchemaAddress a gmeow:ProjectionMapping ;
    rdfs:label "PostalAddress → schema:PostalAddress"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "holder" ;
        gmeow:atom (
            [ gmeow:subjectVar "holder" ; gmeow:predicate gmeow:hasContactPoint ; gmeow:objectVar "addr" ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:PostalAddress ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate gmeow:streetAddress ; gmeow:objectVar "street" ; gmeow:optional true ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate gmeow:addressLocality ; gmeow:objectVar "locality" ; gmeow:optional true ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate gmeow:addressRegion ; gmeow:objectVar "region" ; gmeow:optional true ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate gmeow:postalCode ; gmeow:objectVar "pcode" ; gmeow:optional true ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate gmeow:countryCode ; gmeow:objectVar "ccode" ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "holder" ; gmeow:tPred schema:address ; gmeow:tObj "addr" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:PostalAddress ]
            [ gmeow:tSubj "addr" ; gmeow:tPred schema:streetAddress ; gmeow:tObj "street" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred schema:addressLocality ; gmeow:tObj "locality" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred schema:addressRegion ; gmeow:tObj "region" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred schema:postalCode ; gmeow:tObj "pcode" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred schema:addressCountry ; gmeow:tObj "ccode" ] ) ] .

gmeow:mapSchemaName a gmeow:ProjectionMapping ;
    rdfs:label "displayable fullName → schema:name"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "dispName" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ;
              gmeow:path [ a gmeow:AltPath ; gmeow:pathAlts ( gmeow:hasAppellation gmeow:hasName ) ] ;
              gmeow:objectVar "app" ]
            [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:fullName ; gmeow:objectVar "dispName" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:fullName ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:name ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnSelectDisplayName ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "non-displayable names (deadnames) dropped" ] .

gmeow:mapSchemaGivenName a gmeow:ProjectionMapping ;
    rdfs:label "given-name part → schema:givenName"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "given" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ;
              gmeow:path [ a gmeow:AltPath ; gmeow:pathAlts ( gmeow:hasAppellation gmeow:hasName ) ] ;
              gmeow:objectVar "app" ]
            [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:hasNamePart ; gmeow:objectVar "np" ]
            [ gmeow:subjectVar "np" ; gmeow:predicate gmeow:namePartType ; gmeow:objectValue gmeow:namePartGiven ]
            [ gmeow:subjectVar "np" ; gmeow:predicate gmeow:partText ; gmeow:objectVar "given" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:givenName ; gmeow:relation "<=" ] .

gmeow:mapSchemaFamilyName a gmeow:ProjectionMapping ;
    rdfs:label "family-name part → schema:familyName"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "family" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ;
              gmeow:path [ a gmeow:AltPath ; gmeow:pathAlts ( gmeow:hasAppellation gmeow:hasName ) ] ;
              gmeow:objectVar "app" ]
            [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:hasNamePart ; gmeow:objectVar "np" ]
            [ gmeow:subjectVar "np" ; gmeow:predicate gmeow:namePartType ; gmeow:objectValue gmeow:namePartSurname ]
            [ gmeow:subjectVar "np" ; gmeow:predicate gmeow:partText ; gmeow:objectVar "family" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:familyName ; gmeow:relation "<=" ] .

gmeow:mapSchemaGender a gmeow:ProjectionMapping ;
    rdfs:label "displayable GenderIdentity value → schema:gender (lossy)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "genderLabel" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:hasGenderIdentity ; gmeow:objectVar "gi" ]
            [ gmeow:subjectVar "gi" ; gmeow:predicate gmeow:genderValue ; gmeow:objectVar "gv" ]
            [ gmeow:subjectVar "gv" ; gmeow:predicate rdfs:label ; gmeow:objectVar "genderLabel" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "gi" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:hasGenderIdentity ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:gender ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnSelectDisplayableGender ; gmeow:confidence 0.6 ;
        gmeow:lossyDrop "orientation + sexAssignedAtBirth dropped; sex/gender conflated" ] .

gmeow:mapSchemaHonorificPrefix a gmeow:ProjectionMapping ;
    rdfs:label "Honorific (prefix position) → schema:honorificPrefix"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "honPrefix" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:honorific ; gmeow:objectVar "h" ]
            [ gmeow:subjectVar "h" ; gmeow:predicate rdfs:label ; gmeow:objectVar "honPrefix" ]
            [ gmeow:subjectVar "h" ; gmeow:predicate gmeow:honorificPosition ; gmeow:objectValue gmeow:honorificPositionPrefix ] ) ;
        gmeow:edoalSource gmeow:honorific ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:honorificPrefix ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnHonorificToAffix ] .

gmeow:mapSchemaHonorificSuffix a gmeow:ProjectionMapping ;
    rdfs:label "Honorific (suffix position) → schema:honorificSuffix"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "honSuffix" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:honorific ; gmeow:objectVar "h" ]
            [ gmeow:subjectVar "h" ; gmeow:predicate rdfs:label ; gmeow:objectVar "honSuffix" ]
            [ gmeow:subjectVar "h" ; gmeow:predicate gmeow:honorificPosition ; gmeow:objectValue gmeow:honorificPositionSuffix ] ) ;
        gmeow:edoalSource gmeow:honorific ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:honorificSuffix ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnHonorificToAffix ] .

gmeow:mapSchemaLanguage a gmeow:ProjectionMapping ;
    rdfs:label "gmeow:Language → schema:Language"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "lang" ;
        gmeow:atom ( [ gmeow:subjectVar "lang" ;
              gmeow:path [ a gmeow:SeqPath ; gmeow:pathSteps
                  ( rdf:type [ a gmeow:ZeroOrMorePath ; gmeow:pathStep rdfs:subClassOf ] ) ] ;
              gmeow:objectValue gmeow:Language ] ) ;
        gmeow:edoalSource gmeow:Language ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toClass schema:Language ; gmeow:relation "=" ] .

gmeow:mapSchemaProgrammingLanguage a gmeow:ProjectionMapping ;
    rdfs:label "gmeow:ProgrammingLanguage → schema:ComputerLanguage"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "prog" ;
        gmeow:atom ( [ gmeow:subjectVar "prog" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:ProgrammingLanguage ] ) ;
        gmeow:edoalSource gmeow:ProgrammingLanguage ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toClass schema:ComputerLanguage ; gmeow:relation "=" ] .

gmeow:mapSchemaBcp47 a gmeow:ProjectionMapping ;
    rdfs:label "languageCode (+ co-mingled scriptCode) → schema:alternateName (BCP-47)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "lang" ; gmeow:value "bcp47" ;
        gmeow:atom (
            [ gmeow:subjectVar "lang" ;
              gmeow:path [ a gmeow:SeqPath ; gmeow:pathSteps
                  ( rdf:type [ a gmeow:ZeroOrMorePath ; gmeow:pathStep rdfs:subClassOf ] ) ] ;
              gmeow:objectValue gmeow:Language ]
            [ gmeow:subjectVar "lang" ; gmeow:predicate gmeow:languageCode ; gmeow:objectVar "code" ]
            [ gmeow:optionalGroup (
                [ gmeow:subjectVar "lang" ; gmeow:predicate gmeow:usesWritingSystem ; gmeow:objectVar "ws" ]
                [ gmeow:subjectVar "ws" ; gmeow:predicate gmeow:scriptCode ; gmeow:objectVar "sc" ] ) ] ) ;
        gmeow:excludeWhen [ gmeow:subjectVar "lang" ;
            gmeow:path [ a gmeow:SeqPath ; gmeow:pathSteps
                ( rdf:type [ a gmeow:ZeroOrMorePath ; gmeow:pathStep rdfs:subClassOf ] ) ] ;
            gmeow:objectValue gmeow:FormalLanguage ] ;
        gmeow:filter [ gmeow:exprOp gmeow:opRegex ; gmeow:exprArgs (
            [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "code" ] ) ]
            "^[a-zA-Z]{2,3}$" ) ] ;
        gmeow:bind [ gmeow:bindVar "bcp47" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIf ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opBound ; gmeow:exprArgs ( [ gmeow:exprVar "sc" ] ) ]
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "code" ] ) ] "-"
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "sc" ] ) ] ) ]
                [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "code" ] ) ] ) ] ] ;
        gmeow:edoalSource gmeow:languageCode ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:alternateName ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnComposeBcp47 ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "Glottocodes excluded; only 2-3 letter primary subtags" ] .

gmeow:mapSchemaKnowsLanguageFlat a gmeow:ProjectionMapping ;
    rdfs:label "knowsLanguage → schema:knowsLanguage (flat)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "knower" ; gmeow:value "known" ;
        gmeow:atom ( [ gmeow:subjectVar "knower" ; gmeow:predicate gmeow:knowsLanguage ; gmeow:objectVar "known" ] ) ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:knowsLanguage ; gmeow:relation "<=" ] .

gmeow:mapSchemaKnowsLanguageProficiency a gmeow:ProjectionMapping ;
    rdfs:label "LanguageProficiency relator → schema:knowsLanguage (flatten, lossy)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "knower" ; gmeow:value "known" ;
        gmeow:atom (
            [ gmeow:subjectVar "prof" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:LanguageProficiency ]
            [ gmeow:subjectVar "prof" ; gmeow:predicate gmeow:proficiencyAgent ; gmeow:objectVar "knower" ]
            [ gmeow:subjectVar "prof" ; gmeow:predicate gmeow:proficiencyLanguage ; gmeow:objectVar "known" ] ) ;
        gmeow:edoalSource gmeow:knowsLanguage ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:knowsLanguage ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnProficiencyToKnownLanguage ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "CEFR/ILR/ACTFL level and skill modality dropped" ] .

gmeow:mapSchemaDescription a gmeow:ProjectionMapping ;
    rdfs:label "gmeow:description → schema:description"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "desc" ;
        gmeow:atom ( [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:description ; gmeow:objectVar "desc" ] ) ;
        gmeow:edoalSource gmeow:description ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:description ; gmeow:relation "=" ; gmeow:confidence 1.0 ] .

gmeow:mapSchemaUrl a gmeow:ProjectionMapping ;
    rdfs:label "hasWebPage → schema:url (the WebPage IRI)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "wp" ;
        gmeow:atom ( [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:hasWebPage ; gmeow:objectVar "wp" ] ) ;
        gmeow:edoalSource gmeow:hasWebPage ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:url ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnWebPageToUrl ; gmeow:confidence 0.8 ] .

gmeow:mapSchemaNickname a gmeow:ProjectionMapping ;
    rdfs:label "nickname-purpose PersonName → schema:alternateName (downcast)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "nick" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:hasName ; gmeow:objectVar "nname" ]
            [ gmeow:subjectVar "nname" ; gmeow:predicate gmeow:namePurpose ; gmeow:objectValue gmeow:namePurposeNickname ]
            [ gmeow:subjectVar "nname" ; gmeow:predicate gmeow:fullName ; gmeow:objectVar "nick" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "nname" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:hasName ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:alternateName ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnNicknameName ; gmeow:confidence 0.9 ] .

gmeow:mapSchemaBirthDate a gmeow:ProjectionMapping ;
    rdfs:label "Birth life-event date → schema:birthDate"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "person" ; gmeow:value "bdate" ;
        gmeow:atom (
            [ gmeow:subjectVar "birth" ; gmeow:predicate gmeow:eventType ; gmeow:objectValue gmeow:eventTypeBirth ]
            [ gmeow:subjectVar "p" ; gmeow:predicate gmeow:participationEvent ; gmeow:objectVar "birth" ]
            [ gmeow:subjectVar "p" ; gmeow:predicate gmeow:participationRole ; gmeow:objectValue gmeow:roleParticipantPrincipal ]
            [ gmeow:subjectVar "p" ; gmeow:predicate gmeow:participationParticipant ; gmeow:objectVar "person" ]
            [ gmeow:subjectVar "birth" ; gmeow:predicate gmeow:eventTime ; gmeow:objectVar "bdate" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:birthDate ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnBirthEventToDate ; gmeow:confidence 0.95 ;
        gmeow:lossyDrop "the birth Participation (role, period, confidence, standpoint) and fuzzy-date bounds are dropped; only the principal's birth instant survives as schema:birthDate" ] .

gmeow:mapSchemaJobTitle a gmeow:ProjectionMapping ;
    rdfs:label "Membership Role → schema:jobTitle"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "member" ; gmeow:value "title" ;
        gmeow:atom (
            [ gmeow:subjectVar "m" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Membership ]
            [ gmeow:subjectVar "m" ; gmeow:predicate gmeow:membershipMember ; gmeow:objectVar "member" ]
            [ gmeow:subjectVar "m" ; gmeow:predicate gmeow:hasRole ; gmeow:objectVar "role" ]
            [ gmeow:subjectVar "role" ;
              gmeow:path [ a gmeow:AltPath ; gmeow:pathAlts ( rdfs:label gmeow:name ) ] ;
              gmeow:objectVar "title" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:jobTitle ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnMembershipToJobTitle ; gmeow:confidence 0.9 ] .

gmeow:mapSchemaDepartment a gmeow:ProjectionMapping ;
    rdfs:label "subOrganizationOf → schema:department (inverse, parent→child)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "parent" ; gmeow:value "dept" ;
        gmeow:atom ( [ gmeow:subjectVar "dept" ; gmeow:predicate gmeow:subOrganizationOf ; gmeow:objectVar "parent" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:department ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnSubOrgToDepartment ; gmeow:confidence 1.0 ] .

# Reified Participation → the flat schema.org event-role edges, keyed by role
# value. The relator's period / confidence / evidence / standpoint and the open
# role space beyond these three collapse to a bare event→agent edge (lossy).

# Each role projection uses a DISTINCT anchor + value variable so its CONSTRUCT
# template fires only for its own WHERE branch (shared output variables would make
# one match emit all three role predicates).

gmeow:mapSchemaAttendee a gmeow:ProjectionMapping ;
    rdfs:label "Participation (attendee role) → schema:attendee"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "attEvent" ; gmeow:value "attendee" ;
        gmeow:atom (
            [ gmeow:subjectVar "pAtt" ; gmeow:predicate gmeow:participationEvent ; gmeow:objectVar "attEvent" ]
            [ gmeow:subjectVar "pAtt" ; gmeow:predicate gmeow:participationRole ; gmeow:objectValue gmeow:roleAttendee ]
            [ gmeow:subjectVar "pAtt" ; gmeow:predicate gmeow:participationParticipant ; gmeow:objectVar "attendee" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "pAtt" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:attendee ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnParticipationToEventRole ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the Participation's period / confidence / evidence / standpoint collapse to a flat schema:attendee edge" ] .

gmeow:mapSchemaPerformer a gmeow:ProjectionMapping ;
    rdfs:label "Participation (performer role) → schema:performer"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "perfEvent" ; gmeow:value "performer" ;
        gmeow:atom (
            [ gmeow:subjectVar "pPerf" ; gmeow:predicate gmeow:participationEvent ; gmeow:objectVar "perfEvent" ]
            [ gmeow:subjectVar "pPerf" ; gmeow:predicate gmeow:participationRole ; gmeow:objectValue gmeow:rolePerformer ]
            [ gmeow:subjectVar "pPerf" ; gmeow:predicate gmeow:participationParticipant ; gmeow:objectVar "performer" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "pPerf" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:performer ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnParticipationToEventRole ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the Participation's period / confidence / evidence / standpoint collapse to a flat schema:performer edge" ] .

gmeow:mapSchemaOrganizer a gmeow:ProjectionMapping ;
    rdfs:label "Participation (organizer role) → schema:organizer"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "orgEvent" ; gmeow:value "organizer" ;
        gmeow:atom (
            [ gmeow:subjectVar "pOrg" ; gmeow:predicate gmeow:participationEvent ; gmeow:objectVar "orgEvent" ]
            [ gmeow:subjectVar "pOrg" ; gmeow:predicate gmeow:participationRole ; gmeow:objectValue gmeow:roleOrganizer ]
            [ gmeow:subjectVar "pOrg" ; gmeow:predicate gmeow:participationParticipant ; gmeow:objectVar "organizer" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "pOrg" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:organizer ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnParticipationToEventRole ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the Participation's period / confidence / evidence / standpoint collapse to a flat schema:organizer edge" ] .

# An approximate (circa) event date → a single schema:startDate. The latestEnd
# upper bound and the temporalPrecision qualifier are dropped (the band collapses).
gmeow:mapSchemaFuzzyStart a gmeow:ProjectionMapping ;
    rdfs:label "Fuzzy event bounds → schema:startDate"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "event" ; gmeow:value "start" ;
        gmeow:atom ( [ gmeow:subjectVar "event" ; gmeow:predicate gmeow:earliestStart ; gmeow:objectVar "start" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:startDate ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnFuzzyTimeToDate ; gmeow:confidence 0.7 ;
        gmeow:lossyDrop "the uncertainty band (gmeow:latestEnd) and the gmeow:temporalPrecision qualifier are dropped; only the earliest bound survives as a single schema:startDate" ] .

# Rights / IP cluster (#21). The Copyright relator flattens to schema's flat
# copyright* terms; hasLicense → schema:license; attributionText → schema:creditText;
# Mark → schema:Brand; plus the access/licence-page/usage flags.

gmeow:mapSchemaLicense a gmeow:ProjectionMapping ;
    rdfs:label "hasLicense → schema:license"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "work" ; gmeow:value "lic" ;
        gmeow:atom ( [ gmeow:subjectVar "work" ; gmeow:predicate gmeow:hasLicense ; gmeow:objectVar "lic" ] ) ;
        gmeow:edoalSource gmeow:hasLicense ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:license ; gmeow:relation "<=" ; gmeow:confidence 0.85 ] .

gmeow:mapSchemaCopyrightHolder a gmeow:ProjectionMapping ;
    rdfs:label "Copyright relator holder → schema:copyrightHolder (flatten)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "cw" ; gmeow:value "holder" ;
        gmeow:atom (
            [ gmeow:subjectVar "cw" ; gmeow:predicate gmeow:hasCopyright ; gmeow:objectVar "cr" ]
            [ gmeow:subjectVar "cr" ; gmeow:predicate gmeow:copyrightHolder ; gmeow:objectVar "holder" ] ) ;
        gmeow:edoalSource gmeow:copyrightHolder ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:copyrightHolder ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the Copyright relator (year, notice, status) collapses to a flat schema:copyrightHolder edge" ] .

gmeow:mapSchemaCopyrightYear a gmeow:ProjectionMapping ;
    rdfs:label "Copyright relator year → schema:copyrightYear (flatten)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "cw" ; gmeow:value "yr" ;
        gmeow:atom (
            [ gmeow:subjectVar "cw" ; gmeow:predicate gmeow:hasCopyright ; gmeow:objectVar "cr" ]
            [ gmeow:subjectVar "cr" ; gmeow:predicate gmeow:copyrightYear ; gmeow:objectVar "yr" ] ) ;
        gmeow:edoalSource gmeow:copyrightYear ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:copyrightYear ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the Copyright relator (holder, notice, status) collapses to a flat schema:copyrightYear edge" ] .

gmeow:mapSchemaCopyrightNotice a gmeow:ProjectionMapping ;
    rdfs:label "Copyright relator notice → schema:copyrightNotice (flatten)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "cw" ; gmeow:value "notice" ;
        gmeow:atom (
            [ gmeow:subjectVar "cw" ; gmeow:predicate gmeow:hasCopyright ; gmeow:objectVar "cr" ]
            [ gmeow:subjectVar "cr" ; gmeow:predicate gmeow:copyrightNotice ; gmeow:objectVar "notice" ] ) ;
        gmeow:edoalSource gmeow:copyrightNotice ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:copyrightNotice ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the structured Copyright relator (holder, year, status) collapses to a flat schema:copyrightNotice edge" ] .

gmeow:mapSchemaCreditText a gmeow:ProjectionMapping ;
    rdfs:label "attributionText → schema:creditText"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "credit" ;
        gmeow:atom ( [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:attributionText ; gmeow:objectVar "credit" ] ) ;
        gmeow:edoalSource gmeow:attributionText ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:creditText ; gmeow:relation "<=" ; gmeow:confidence 0.85 ] .

gmeow:mapSchemaBrand a gmeow:ProjectionMapping ;
    rdfs:label "Mark → schema:Brand"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "mark" ;
        gmeow:atom ( [ gmeow:subjectVar "mark" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Mark ] ) ;
        gmeow:edoalSource gmeow:Mark ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toClass schema:Brand ; gmeow:relation "<=" ; gmeow:confidence 0.8 ] .

gmeow:mapSchemaIsAccessibleForFree a gmeow:ProjectionMapping ;
    rdfs:label "isAccessibleForFree → schema:isAccessibleForFree"@en ;
    gmeow:hasMappingPattern [
