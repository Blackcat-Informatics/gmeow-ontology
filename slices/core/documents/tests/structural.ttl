#
# Declarative structural assertions for the documents slice. Each assertion runs
# as a SPARQL ASK over documents/module.ttl under the native Rust slicetest
# harness.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/documents/tests/> .

ex:saCreativeWorkIsCategory a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:CreativeWork a owl:Class , logic:Category .
}""" ;
    gmeow:saRationale "gmeow:CreativeWork MUST be an owl:Class typed logic:Category in the WEMI spine. Replaces the stale gufo:Category assertion." .

ex:saContentSegmentTypeValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ContentSegmentType rdfs:subClassOf logic:QualityValue .
    gmeow:segmentTypeChapter     a gmeow:ContentSegmentType .
    gmeow:segmentTypeSection     a gmeow:ContentSegmentType .
    gmeow:segmentTypeScene       a gmeow:ContentSegmentType .
    gmeow:segmentTypeParagraph   a gmeow:ContentSegmentType .
    gmeow:segmentTypeFrontMatter a gmeow:ContentSegmentType .
    gmeow:segmentTypeBackMatter  a gmeow:ContentSegmentType .
}""" ;
    gmeow:saRationale "gmeow:ContentSegmentType MUST be a logic:QualityValue vocabulary with the canonical seeded segment-type individuals. Replaces the stale gufo:QualityValue assertion." .

# --- 3. Document, Article, Patent, and Dataset are subclasses of Work (MUST) --
ex:saDocumentWorkSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?cls { gmeow:Document gmeow:Article gmeow:Patent gmeow:Dataset }
    ?cls a owl:Class ; rdfs:subClassOf gmeow:Work .
}""" ;
    gmeow:saRationale "gmeow:Document, gmeow:Article, gmeow:Patent, and gmeow:Dataset MUST each be an owl:Class and a direct subclass of gmeow:Work. These creative-work subclasses are defined in the documents slice." .

# --- 4. Media, WebPage, BookRelease, and SerialInstallment are subclasses of Manifestation (MUST)
ex:saMediaManifestationSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?cls { gmeow:MediaObject gmeow:WebPage gmeow:BookRelease gmeow:SerialInstallment }
    ?cls a owl:Class ; rdfs:subClassOf gmeow:Manifestation .
}""" ;
    gmeow:saRationale "gmeow:MediaObject, gmeow:WebPage, gmeow:BookRelease, and gmeow:SerialInstallment MUST each be an owl:Class and a direct subclass of gmeow:Manifestation. These concrete-carrier classes are defined in the documents slice." .

# --- 5. LiteraryWork is a subclass of Work (MUST) -----------------------------
ex:saLiteraryWorkIsSubclassOfWork a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:LiteraryWork a owl:Class ; rdfs:subClassOf gmeow:Work . }""" ;
    gmeow:saRationale "gmeow:LiteraryWork MUST be an owl:Class and a direct subclass of gmeow:Work. Defined in the documents slice." .

# --- 6. SerialWork is a subclass of Work (MUST) -------------------------------
ex:saSerialWorkIsSubclassOfWork a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:SerialWork a owl:Class ; rdfs:subClassOf gmeow:Work . }""" ;
    gmeow:saRationale "gmeow:SerialWork MUST be an owl:Class and a direct subclass of gmeow:Work. Defined in the documents slice." .

# --- 7. ContentSegment is a subclass of InformationObject (MUST) --------------
ex:saContentSegmentIsSubclassOfInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:ContentSegment a owl:Class , logic:Kind ; rdfs:subClassOf gmeow:InformationObject . }""" ;
    gmeow:saRationale "gmeow:ContentSegment MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject. Defined in the documents slice." .

# --- 8. hasSegment is a subproperty of hasPart (MUST) -------------------------
ex:saHasSegmentIsSubPropertyOfHasPart a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:hasSegment a owl:ObjectProperty ; rdfs:subPropertyOf gmeow:hasPart . }""" ;
    gmeow:saRationale "gmeow:hasSegment MUST be an owl:ObjectProperty and a subproperty of gmeow:hasPart. Defined in the documents slice." .

# --- 9. segmentOf is a subproperty of partOf (MUST) ---------------------------
ex:saSegmentOfIsSubPropertyOfPartOf a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:segmentOf a owl:ObjectProperty ; rdfs:subPropertyOf gmeow:partOf . }""" ;
    gmeow:saRationale "gmeow:segmentOf MUST be an owl:ObjectProperty and a subproperty of gmeow:partOf. Defined in the documents slice." .

# --- 10. segmentType is an ObjectProperty (MUST) ------------------------------
ex:saSegmentTypeIsFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:segmentType a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:segmentType MUST be an owl:ObjectProperty. Defined in the documents slice." .

# --- 11. segmentIndex is a DatatypeProperty (MUST) ----------------------------
ex:saSegmentIndexIsFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:segmentIndex a owl:DatatypeProperty . }""" ;
    gmeow:saRationale "gmeow:segmentIndex MUST be an owl:DatatypeProperty. Defined in the documents slice." .
