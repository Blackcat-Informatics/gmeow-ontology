    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:MusicalWork ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri pon:Work ;
        ] ;
        align:relation "<=" ;
