#
# Declarative structural assertions for the email slice. Each assertion runs as a
# SPARQL ASK over email/module.ttl under the native Rust slicetest harness.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/email/tests/> .

ex:saMailingListClassExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:MailingList a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:MailingList MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject. Replaces the stale gufo:Kind pytest assertion." .

ex:saEmailPatchDiffIsBodyPartSubKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:EmailPatchDiff a owl:Class , logic:SubKind ;
        rdfs:subClassOf gmeow:BodyPart .
}""" ;
    gmeow:saRationale "gmeow:EmailPatchDiff MUST be an owl:Class typed logic:SubKind and a subclass of gmeow:BodyPart. Replaces the stale gufo:SubKind pytest assertion." .

ex:saEmailValueVocabsUseLogicQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:CalendarMethod a owl:Class ;
        rdfs:subClassOf logic:QualityValue .
    gmeow:MessageKind a owl:Class ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:CalendarMethod and gmeow:MessageKind MUST be logic:QualityValue vocabularies. Replaces stale gufo:QualityValue pytest assertions." .
