@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/calendar>
    a owl:Ontology ;
    rdfs:label "GMEOW Calendar and Scheduling Module"@en ;
    rdfs:comment """The calendar and scheduling slice: recurrence, availability, RSVP, reminders, tasks, and time zones on top of events. Builds on the events module (#41) and temporal module, reusing Event, Participation, EventSeries/RecurrenceRule, TimeInterval, and the four clocks. Aligns to iCalendar RFC 5545/5546/6047/4791/6638/7809, jCal RFC 7265, xCal RFC 6321, schema.org Schedule/EventSeries, OWL-Time, and Wikidata by reference.

DESIGN PRINCIPLES.
  * Schedule ≠ occurrence: an EventSchedule (rule + anchor + time zone) GENERATES Event occurrences; it is not itself the occurrence (Principle 1).
  * Reify social acts as relators: EventInvitation and Availability use the Participation idiom — never flat properties.
  * Open value vocabularies, not subclasses: invitationStatus, rsvpStatus, availabilityStatus, reminderAction, taskStatus, exceptionType are individuals, never Event/Task subclasses (Principle 9).
  * Cancelled ≠ deleted (Principle 10): a cancelled/rescheduled occurrence is displayable false + a ScheduleException, retained, never erased.
  * Contested times coexist (#43): disputed times are standpoint-indexed via accordingTo; no single winner.
  * DL-clean time: datetimes are xsd:dateTime, durations xsd:duration; recurrence as a literal rule (RFC 5545 text) + structured form, kept out of OWL cardinality."""@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# PHASE A — Calendar, EventSchedule, ScheduleException (recurrence + exceptions)
# =========================================================================== #

gmeow:Calendar
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:InformationObject, gufo:Object ;
    rdfs:label "Calendar"@en ;
    skos:definition "A CalDAV-style collection of scheduled events — an information object that aggregates calendar members and carries a default time zone. The container, not the contents."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:EventSchedule
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Event Schedule"@en ;
    skos:definition "A recurrence rule anchored to a template event and a time zone, generating a series of concrete Event occurrences. A relator mediating the template event, the recurrence rule, and the generated occurrences. Distinct from any one occurrence; the schedule is the generator, not the generated."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:ScheduleException
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Schedule Exception"@en ;
    skos:definition "An exception to a recurring event schedule — a cancellation or rescheduling of a specific generated occurrence. A relator mediating the schedule, the original date, and optionally a replacement event. Retained with displayable false rather than deleted (Principle 10)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- Calendar properties -----------------------------------------------------

gmeow:calendarTimeZone
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Calendar ;
    rdfs:range gmeow:TimeZone ;
    rdfs:label "calendar time zone"@en ;
    skos:definition "The default time zone for a calendar collection."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:calendarMember
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Calendar ;
    rdfs:range gmeow:Event ;
    rdfs:label "calendar member"@en ;
    skos:definition "An event that is a member of this calendar. Non-functional: a calendar may contain many events."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- EventSchedule properties ------------------------------------------------

gmeow:scheduleTemplateEvent
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:EventSchedule ;
    rdfs:range gmeow:Event ;
    rdfs:label "schedule template event"@en ;
    skos:definition "The template event from which occurrences are generated — the anchor event carrying title, location, participants, and duration. Functional: one template per schedule."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:scheduleRecurrenceRule
    a owl:ObjectProperty ;
    rdfs:domain gmeow:EventSchedule ;
    rdfs:range gmeow:RecurrenceRule ;
    rdfs:label "schedule recurrence rule"@en ;
    skos:definition "The recurrence rule by which this schedule generates occurrences. Non-functional: a schedule may combine multiple rules (e.g. weekly + monthly exception)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:scheduleTimeZone
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:EventSchedule ;
    rdfs:range gmeow:TimeZone ;
    rdfs:label "schedule time zone"@en ;
    skos:definition "The time zone in which this schedule's recurrence is expressed. The occurrence generation engine uses this zone when expanding the rule."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:scheduleOccurrence
    a owl:ObjectProperty ;
    rdfs:domain gmeow:EventSchedule ;
    rdfs:range gmeow:Event ;
    rdfs:label "schedule occurrence"@en ;
    skos:definition "A concrete event occurrence generated by this schedule. Non-functional: a schedule generates many occurrences."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- ScheduleException properties --------------------------------------------

gmeow:exceptionSchedule
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ScheduleException ;
    rdfs:range gmeow:EventSchedule ;
    rdfs:label "exception schedule"@en ;
    skos:definition "The event schedule to which this exception applies."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:exceptionOriginalDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ScheduleException ;
    rdfs:range xsd:dateTime ;
    rdfs:label "exception original date"@en ;
    skos:definition "The original date/time of the occurrence being excepted — the instance that would have been generated by the recurrence rule."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:exceptionReplacementEvent
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ScheduleException ;
    rdfs:range gmeow:Event ;
    rdfs:label "exception replacement event"@en ;
    skos:definition "The replacement event for a rescheduled occurrence. Absent for a pure cancellation."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:exceptionType
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ScheduleException ;
    rdfs:range gmeow:ExceptionType ;
    rdfs:label "exception type"@en ;
    skos:definition "The kind of schedule exception — cancellation or rescheduling."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- ExceptionType open value vocabulary -------------------------------------

gmeow:ExceptionType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Exception Type"@en ;
    skos:definition "The kind of a schedule exception — a VALUE, never a subclass."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:exceptionTypeCancellation  a gmeow:ExceptionType ; rdfs:label "cancellation"@en ; skos:definition "The occurrence is cancelled."@en .
gmeow:exceptionTypeRescheduling  a gmeow:ExceptionType ; rdfs:label "rescheduling"@en ; skos:definition "The occurrence is moved to a different time."@en .

# =========================================================================== #
# PHASE B — EventInvitation, Availability (RSVP + free-busy)
# =========================================================================== #

gmeow:EventInvitation
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Agreement, gufo:Relator ;
    rdfs:label "Event Invitation"@en ;
    skos:definition "A social act inviting an agent to attend an event, reified as a relator. Models the invitation as an Agreement to attend, reusing gmeow:hasParty for the invitee and the invitation status for the response state. Standpoint-indexed: a disputed invitation status is several coexisting claims, none privileged (Principle 9)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Availability
    a owl:Class, gufo:SituationType ;
    rdfs:subClassOf gmeow:TimeScopedRelation, gufo:Situation ;
    rdfs:label "Availability"@en ;
    skos:definition "A time-scoped statement of an agent's availability over an interval — free, busy, tentative, or out-of-office. The free-busy spine of the calendar layer."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- EventInvitation properties ----------------------------------------------

gmeow:invitationEvent
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:EventInvitation ;
    rdfs:range gmeow:Event ;
    rdfs:label "invitation event"@en ;
    skos:definition "The event being invited to."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:invitationInvitee
    a owl:ObjectProperty ;
    rdfs:domain gmeow:EventInvitation ;
    rdfs:range gmeow:Agent ;
    rdfs:label "invitation invitee"@en ;
    skos:definition "An agent invited to the event. Non-functional: a joint invitation may name several invitees."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:invitationStatus
    a owl:ObjectProperty ;
    rdfs:domain gmeow:EventInvitation ;
    rdfs:range gmeow:InvitationStatus ;
    rdfs:label "invitation status"@en ;
    skos:definition "The current status of the invitation as set by the organizer — needs-action, accepted, declined, tentative."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:rsvpStatus
    a owl:ObjectProperty ;
    rdfs:domain gmeow:EventInvitation ;
    rdfs:range gmeow:RsvpStatus ;
    rdfs:label "RSVP status"@en ;
    skos:definition "The RSVP response status as asserted by the invitee — needs-action, accepted, declined, tentative. Distinct from invitationStatus: the organizer's view and the invitee's view may disagree, and both claims coexist (Principle 9)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- Availability properties -------------------------------------------------

gmeow:availabilityAgent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Availability ;
    rdfs:range gmeow:Agent ;
    rdfs:label "availability agent"@en ;
    skos:definition "The agent whose availability is stated."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:availabilitySlot
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Availability ;
    rdfs:range gmeow:TimeInterval ;
    rdfs:label "availability slot"@en ;
    skos:definition "The time interval over which the availability status holds."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:availabilityStatus
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Availability ;
    rdfs:range gmeow:AvailabilityStatus ;
    rdfs:label "availability status"@en ;
    skos:definition "The availability status for this slot — free, busy, tentative, or out-of-office."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- InvitationStatus open value vocabulary ----------------------------------

gmeow:InvitationStatus
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Invitation Status"@en ;
    skos:definition "The status of an event invitation — a VALUE vocabulary aligned to iTIP PARTSTAT, never a subclass."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:invitationStatusNeedsAction a gmeow:InvitationStatus ; rdfs:label "needs action"@en ; skos:definition "The invitee has not yet responded. Aligned to iTIP PARTSTAT=NEEDS-ACTION."@en .
gmeow:invitationStatusAccepted    a gmeow:InvitationStatus ; rdfs:label "accepted"@en ;    skos:definition "The invitee has accepted the invitation. Aligned to iTIP PARTSTAT=ACCEPTED."@en ;    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:invitationStatusDeclined    a gmeow:InvitationStatus ; rdfs:label "declined"@en ;    skos:definition "The invitee has declined the invitation. Aligned to iTIP PARTSTAT=DECLINED."@en ;    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:invitationStatusTentative   a gmeow:InvitationStatus ; rdfs:label "tentative"@en ;   skos:definition "The invitee has tentatively accepted. Aligned to iTIP PARTSTAT=TENTATIVE."@en ;   rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- RsvpStatus open value vocabulary ----------------------------------------

gmeow:RsvpStatus
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "RSVP Status"@en ;
    skos:definition "The RSVP response status as asserted by an invitee — a VALUE vocabulary, distinct from InvitationStatus so that organizer and invitee claims can coexist (Principle 9)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:rsvpStatusNeedsAction a gmeow:RsvpStatus ; rdfs:label "needs action"@en ; skos:definition "The invitee has not yet responded."@en .
gmeow:rsvpStatusAccepted    a gmeow:RsvpStatus ; rdfs:label "accepted"@en ;    skos:definition "The invitee has accepted."@en ;    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:rsvpStatusDeclined    a gmeow:RsvpStatus ; rdfs:label "declined"@en ;    skos:definition "The invitee has declined."@en ;    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:rsvpStatusTentative   a gmeow:RsvpStatus ; rdfs:label "tentative"@en ;   skos:definition "The invitee has tentatively accepted."@en ;   rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- AvailabilityStatus open value vocabulary --------------------------------

gmeow:AvailabilityStatus
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Availability Status"@en ;
    skos:definition "The availability state of an agent over a time slot — a VALUE vocabulary aligned to iCalendar VFREEBUSY, never a subclass."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:availabilityStatusFree         a gmeow:AvailabilityStatus ; rdfs:label "free"@en ;          skos:definition "The agent is free during this slot. Aligned to iCalendar FBTYPE=FREE."@en ;          rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:availabilityStatusBusy         a gmeow:AvailabilityStatus ; rdfs:label "busy"@en ;          skos:definition "The agent is busy during this slot. Aligned to iCalendar FBTYPE=BUSY."@en ;          rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:availabilityStatusTentative    a gmeow:AvailabilityStatus ; rdfs:label "tentative"@en ;     skos:definition "The agent is tentatively busy. Aligned to iCalendar FBTYPE=BUSY-TENTATIVE."@en ;     rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:availabilityStatusOutOfOffice  a gmeow:AvailabilityStatus ; rdfs:label "out of office"@en ; skos:definition "The agent is out of office. Aligned to iCalendar FBTYPE=BUSY-UNAVAILABLE."@en .

# =========================================================================== #
# PHASE C — Reminder, Task, TimeZone
# =========================================================================== #

gmeow:Reminder
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Reminder"@en ;
    skos:definition "A reminder associated with an event — a trigger (offset or absolute time) and an action (display, email, audio)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Task
    a owl:Class, gufo:EventType ;
    rdfs:subClassOf gmeow:Event ;
    rdfs:label "Task"@en ;
    skos:definition "A to-do or task — an event with a due date, status, priority, and optional recurrence-until-done. A subtype of gmeow:Event so it participates in the full event spine: temporal placement, location, participation, and scheduling. The kind of task is a gmeow:eventType value, never a subclass (Principle 9)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:TimeZone
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Time Zone"@en ;
    skos:definition "A time zone identified by an IANA tzid (e.g. America/Toronto). Used by calendars, schedules, and events to express civil time relative to a geographic reference position."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- Reminder properties -----------------------------------------------------

gmeow:reminderTrigger
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Reminder ;
    rdfs:range [
        a rdfs:Datatype ;
        owl:unionOf ( xsd:duration xsd:dateTime )
    ] ;
    rdfs:label "reminder trigger"@en ;
    skos:definition "The trigger for a reminder — either an xsd:duration offset before the target event (e.g. PT15M) or an absolute xsd:dateTime."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:reminderAction
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Reminder ;
    rdfs:range gmeow:ReminderAction ;
    rdfs:label "reminder action"@en ;
    skos:definition "The action to take when the reminder fires — display, email, or audio."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:reminderTarget
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Reminder ;
    rdfs:range gmeow:Event ;
    rdfs:label "reminder target"@en ;
    skos:definition "The event this reminder is attached to."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- Task properties ---------------------------------------------------------

gmeow:taskDueDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Task ;
    rdfs:range xsd:dateTime ;
    rdfs:label "task due date"@en ;
    skos:definition "The date and time by which the task is due."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:taskStatus
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Task ;
    rdfs:range gmeow:TaskStatus ;
    rdfs:label "task status"@en ;
    skos:definition "The status of the task — not-started, in-progress, completed, or cancelled."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:taskPriority
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Task ;
    rdfs:range xsd:integer ;
    rdfs:label "task priority"@en ;
    skos:definition "The priority of the task, 0-9, where 0 is undefined and 1 is highest. Aligned to iCalendar PRIORITY."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:taskRecurrenceUntilDone
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Task ;
    rdfs:range xsd:boolean ;
    rdfs:label "task recurrence until done"@en ;
    skos:definition "Whether this recurring task continues until marked done, rather than stopping at a fixed count or end date."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- TimeZone properties -----------------------------------------------------

gmeow:timeZoneIanaId
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:TimeZone ;
    rdfs:range xsd:string ;
    rdfs:label "time zone IANA id"@en ;
    skos:definition "The IANA time zone identifier, e.g. America/Toronto, Europe/Paris, UTC."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:eventTimeZone
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Event ;
    rdfs:range gmeow:TimeZone ;
    rdfs:label "event time zone"@en ;
    skos:definition "The time zone in which an event's temporal placement is expressed."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- ReminderAction open value vocabulary ------------------------------------

gmeow:ReminderAction
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Reminder Action"@en ;
    skos:definition "The action to take when a reminder fires — a VALUE vocabulary aligned to iCalendar ACTION, never a subclass."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:reminderActionDisplay a gmeow:ReminderAction ; rdfs:label "display"@en ; skos:definition "Display the reminder on screen. Aligned to iCalendar ACTION=DISPLAY."@en .
gmeow:reminderActionEmail  a gmeow:ReminderAction ; rdfs:label "email"@en ;  skos:definition "Send the reminder by email. Aligned to iCalendar ACTION=EMAIL."@en ;  rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:reminderActionAudio  a gmeow:ReminderAction ; rdfs:label "audio"@en ;  skos:definition "Play an audio reminder. Aligned to iCalendar ACTION=AUDIO."@en ;  rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# -- TaskStatus open value vocabulary ----------------------------------------

gmeow:TaskStatus
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Task Status"@en ;
    skos:definition "The status of a task — a VALUE vocabulary, never a Task subclass."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:taskStatusNotStarted  a gmeow:TaskStatus ; rdfs:label "not started"@en ; skos:definition "The task has not yet been started."@en .
gmeow:taskStatusInProgress  a gmeow:TaskStatus ; rdfs:label "in progress"@en ; skos:definition "The task is actively being worked on."@en .
gmeow:taskStatusCompleted   a gmeow:TaskStatus ; rdfs:label "completed"@en ;  skos:definition "The task is completed."@en ;  rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:taskStatusCancelled   a gmeow:TaskStatus ; rdfs:label "cancelled"@en ;  skos:definition "The task is cancelled. Retained with displayable false, never deleted (Principle 10)."@en .

# =========================================================================== #
# AXIOMATIZED DOCTRINE — relator mediation (mirrors events.ttl, agreements.ttl)
# =========================================================================== #

gmeow:EventSchedule rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:scheduleTemplateEvent ; owl:someValuesFrom gmeow:Event ] .

gmeow:ScheduleException rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:exceptionSchedule ; owl:someValuesFrom gmeow:EventSchedule ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:exceptionOriginalDate ; owl:someValuesFrom xsd:dateTime ] .

gmeow:EventInvitation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:invitationEvent ; owl:someValuesFrom gmeow:Event ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:invitationInvitee ; owl:someValuesFrom gmeow:Agent ] .

gmeow:Availability rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:availabilityAgent ; owl:someValuesFrom gmeow:Agent ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:availabilitySlot ; owl:someValuesFrom gmeow:TimeInterval ] .

gmeow:Reminder rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:reminderTarget ; owl:someValuesFrom gmeow:Event ] .
