@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:AccessibilityAssertion
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "Accessibility Assertion"@x-gmeow-english ;
    logic:mediates gmeow:assertionSubject ,
        gmeow:assertionFacet ;
    rdfs:subClassOf logic:Relator ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:assertionSubject ;
            owl:someValuesFrom gmeow:Entity ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:assertionFacet ;
            owl:someValuesFrom gmeow:AccessibilityFacet ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:assertionPolarity ;
            owl:someValuesFrom gmeow:AccessibilityPolarity ;
        ] ;
    skos:definition "A reified claim that a location or connection has a positive accessibility feature, a barrier, or a limited status for a given facet. Bears provenance (vantage, confidence, temporal scope) and suppression (displayable false — Principle 10). The flat shortcuts are gmeow:hasAccessibilityFeature and gmeow:hasBarrier; promote to AccessibilityAssertion when the claim itself must be a node."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxTBox .

gmeow:AccessibilityFacet
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "Accessibility Facet"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The dimension of accessibility being asserted — wheelchair, step-free, visual, auditory, cognitive, clearance, life-support. An open value vocabulary (individuals, never subclasses) per Principle 9."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AccessibilityPolarity
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "Accessibility Polarity"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The polarity of an accessibility assertion — feature (positive), barrier (negative), or limited (partial)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:assertionFacet
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AccessibilityAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "assertion facet"@x-gmeow-english ;
    rdfs:range gmeow:AccessibilityFacet ;
    skos:definition "The accessibility facet being asserted. Functional per relator: one facet per AccessibilityAssertion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

gmeow:assertionPolarity
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AccessibilityAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "assertion polarity"@x-gmeow-english ;
    rdfs:range gmeow:AccessibilityPolarity ;
    skos:definition "Whether the assertion is a positive feature, a negative barrier, or a limited/partial status. Functional per relator: one polarity per AccessibilityAssertion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

gmeow:assertionSubject
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AccessibilityAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "assertion subject"@x-gmeow-english ;
    rdfs:range gmeow:Entity ;
    skos:definition "The location or connection being assessed. Functional per relator: one subject per AccessibilityAssertion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

gmeow:facetAuditory
    a gmeow:AccessibilityFacet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "auditory access"@x-gmeow-english ;
    skos:definition "Access for people with auditory impairments — visual alarms, induction loops, sign language."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:facetClearance
    a gmeow:AccessibilityFacet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "physical clearance"@x-gmeow-english ;
    skos:definition "Sufficient physical space for passage — doorway width, corridor width, turning radius, vertical clearance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:facetCognitive
    a gmeow:AccessibilityFacet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "cognitive access"@x-gmeow-english ;
    skos:definition "Access for people with cognitive impairments — clear signage, simple wayfinding, sensory-quiet spaces."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:facetLifeSupport
    a gmeow:AccessibilityFacet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "life-support access"@x-gmeow-english ;
    skos:definition "Access for people who require life-support equipment — power outlets, oxygen, climate control, emergency protocols."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:facetStepFree
    a gmeow:AccessibilityFacet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "step-free access"@x-gmeow-english ;
    skos:definition "Access without steps or stairs — ramps, lifts, level entrances."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:facetVisual
    a gmeow:AccessibilityFacet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "visual access"@x-gmeow-english ;
    skos:definition "Access for people with visual impairments — tactile paving, audio signals, high contrast, braille."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:facetWheelchair
    a gmeow:AccessibilityFacet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "wheelchair access"@x-gmeow-english ;
    skos:definition "Access for wheelchair users — level surfaces, ramps, elevators, wide doorways."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:hasAccessibilityFeature
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Location ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "has accessibility feature"@x-gmeow-english ;
    rdfs:range gmeow:AccessibilityFacet ;
    skos:definition "Relates a location to an accessibility facet it positively provides. Non-functional: a location may support many facets. A location MAY simultaneously carry hasAccessibilityFeature and hasBarrier for the SAME facet (e.g. a ramp at the front entrance and stairs at the side entrance)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasAccessibilityNeed
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "has accessibility need"@x-gmeow-english ;
    rdfs:range gmeow:AccessibilityFacet ;
    skos:definition "Relates an entity to an accessibility facet it requires in order to reach or use a location. Non-functional: needs are co-equal facets (Principle 9). There is no 'primary need' — all asserted needs coexist."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasBarrier
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Location ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "has barrier"@x-gmeow-english ;
    rdfs:range gmeow:AccessibilityFacet ;
    skos:definition "Relates a location to an accessibility facet it impedes. Non-functional: a location may have multiple barriers. A location MAY simultaneously carry hasAccessibilityFeature and hasBarrier for the SAME facet (e.g. a ramp at the front entrance and stairs at the side entrance)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:polarityBarrier
    a gmeow:AccessibilityPolarity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "barrier"@x-gmeow-english ;
    skos:definition "A negative accessibility barrier — the subject impedes the facet."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:polarityFeature
    a gmeow:AccessibilityPolarity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "feature"@x-gmeow-english ;
    skos:definition "A positive accessibility feature — the subject provides the facet."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:polarityLimited
    a gmeow:AccessibilityPolarity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "limited"@x-gmeow-english ;
    skos:definition "A partial or limited accessibility status — the subject provides the facet under some conditions but not all."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

<https://blackcatinformatics.ca/gmeow/slices/accessibility>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "Cross-cutting accessibility layer — whether an entity can reach or use a location under constraints (wheelchair/step-free, sensory, clearance, life-support). Accessibility features, barriers, and needs are modelled as orthogonal, co-equal value facets (Principle 9). The flat shortcuts (hasAccessibilityFeature, hasBarrier, hasAccessibilityNeed) cover the 80 % case; promote to AccessibilityAssertion when provenance, confidence, temporal scope, or suppression matter (Principle 10). Accessible routes are computed by the solver layer, not asserted in OWL (Principle 12). Part of the Location-as-reference-frame design."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "GMEOW Accessibility Module"@x-gmeow-english ;
    skos:definition "The GMEOW Accessibility Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Suppression constraint (#1194) — projection of RetractedAccessibilityAssertionShape.
# A retracted/superseded accessibility assertion (one carrying gmeow:validUntil) #
# that is not suppressed (gmeow:displayable false) is a Warning — source may lag. #
# =========================================================================== #

gmeow:RetractedAccessibilityAssertionSuppressionConstraint
    a logic:Constraint ;
    rdfs:label "Retracted accessibility-assertion suppression constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a retracted or superseded gmeow:AccessibilityAssertion (one carrying gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)."@x-gmeow-english ;
    logic:formalizes gmeow:RetractedAccessibilityAssertionShape ;
    logic:severity "Warning" ;
    logic:message "A retracted or superseded accessibility assertion (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
    logic:integrity logic:supAxForall .
logic:supAxForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:supAxImpl .
logic:supAxImpl a logic:Formula ; logic:antecedent logic:supAxGuard ; logic:consequent logic:supAxPhi .
logic:supAxGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:AccessibilityAssertion ] .
logic:supAxPhi a logic:Formula ; logic:not logic:supAxEx .
logic:supAxEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "u" ] ;
    logic:exists logic:supAxBody .
logic:supAxBody a logic:Formula ; logic:and logic:supAxValid , logic:supAxNotSuppressed .
logic:supAxValid a logic:Formula ; logic:relation gmeow:validUntil ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "u" ] .
logic:supAxNotSuppressed a logic:Formula ; logic:not logic:supAxDisp .
logic:supAxDisp a logic:Formula ; logic:relation gmeow:displayable ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype <http://www.w3.org/2001/XMLSchema#boolean> ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<https://blackcatinformatics.ca/gmeow/AccessibilityAssertion> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/assertionFacet> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/AccessibilityAssertion> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/assertionPolarity> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/AccessibilityAssertion> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/assertionSubject> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/AccessibilityAssertion> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/assertionFacet" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/AccessibilityAssertion> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/assertionPolarity" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/AccessibilityAssertion> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/assertionSubject" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .

# --- Wave B1 shape-drain: accessibility assertion cardinality + suppression ---
# gmeow:AccessibilityAssertionShape — an AccessibilityAssertion assesses exactly one subject,
# asserts exactly one facet, and declares exactly one polarity.
gmeow:AccessibilityAssertion logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:assertionSubject ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:assertionFacet ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:assertionPolarity ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:assertionFacetFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "assertionFacet is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:assertionFacet is functional: an accessibility assertion asserts exactly one facet, the single dimension of accessibility (wheelchair, step-free, visual, and so on) the relator is about."@x-gmeow-english ;
    logic:characterizes gmeow:assertionFacet ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:assertionFacet ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:assertionPolarityFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "assertionPolarity is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:assertionPolarity is functional: an accessibility assertion carries exactly one polarity — feature, barrier, or limited — the single stance the relator takes on its facet."@x-gmeow-english ;
    logic:characterizes gmeow:assertionPolarity ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:assertionPolarity ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:assertionSubjectFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/accessibility> ;
    rdfs:label "assertionSubject is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:assertionSubject is functional: an accessibility assertion assesses exactly one subject, the single location or connection being evaluated."@x-gmeow-english ;
    logic:characterizes gmeow:assertionSubject ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:assertionSubject ;
    gmeow:graphBoxRole gmeow:boxABox .
