#
# Declarative competency questions for extensions/model-serving, executed by the
# native Rust slice-test harness (crates/slicetest) over the full merged
# ontology, asserted lane (gmeow:reasoningNone). Each instance-classifier question
# overlays its ABox fixture with gmeow:cqDataFile (slice-relative). This is the
# executable half of the INHABITED-COMPETENCY.md conformance contract for the
# two questions Package 1 (core/inhabitation) ledger-deferred to this slice that
# this slice can answer ALONE: CQ3 (two-sessions) and CQ6 (provenance-chain) —
# each of which needs the gmeow:ModelArtifact / gmeow:ModelDeployment /
# gmeow:RuntimeExecution identities minted here.
#
# CQ5 (tool-usage) is NOT here. Its discriminator needs this slice's
# gmeow:usedCapability AND the agentic slice's gmeow:ToolCall / gmeow:usedTool,
# and an extension may not depend on a sibling extension (Principle 16) — a
# competency query IS a semantic dependency edge, whatever lane it runs in. It
# therefore lives in slices/profile/agent-runtime, the profile that selects both
# and mints nothing, alongside the end-to-end query that is here for the same
# reason.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/model-serving/tests/> .
@prefix exd:   <https://blackcatinformatics.ca/gmeow/examples/model-serving/> .

# --- CQ3 / two sessions: same subject or shared model? -------------------------
# The two sessions' invocations trace to the SAME gmeow:ModelArtifact (shared
# model), yet each carries a DISTINCT gmeow:sessionSubjectStage. RowsExact: each
# session with its (distinct) subject stage — the split answers "shared model,
# NOT the same subject".
ex:cqTwoSessions a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/model-serving/queries/competency/two-sessions.rq" ;
    gmeow:cqDataFile "examples/two-sessions.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqTwoSessionsShape ;
    gmeow:cqRationale "GMEOW must answer 'two simultaneous sessions — same subject or shared model?' The subject-stage / model-artifact split discriminates: both sessions' invocations run in one execution of one deployment of one served gmeow:ModelArtifact (a shared MODEL), yet ex:sessionAlice and ex:sessionBob carry DISTINCT gmeow:sessionSubjectStage values (ex:stageAlice, ex:stageBob — DIFFERENT SUBJECTS). The asserted answer is exactly these two (session, distinct subject-stage) rows, which a single collapsed tenure could not express." ;
    gmeow:cqExpectRow ex:cqTwoSessionsRowAlice , ex:cqTwoSessionsRowBob .

ex:cqTwoSessionsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "session" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn
        [ logic:columnVariable "subjectStage" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:cqTwoSessionsRowAlice a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "session" ; gmeow:cellValueIri exd:sessionAlice ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "subjectStage" ; gmeow:cellValueIri exd:stageAlice ] .
ex:cqTwoSessionsRowBob a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "session" ; gmeow:cellValueIri exd:sessionBob ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "subjectStage" ; gmeow:cellValueIri exd:stageBob ] .

# --- CQ6 / provenance chain: which artifact/…/invocation produced an output? ---
# The de-conflation chain resolves end to end. RowsExact: one row binding the
# output to its invocation, execution, deployment, artifact, and session — the
# standalone-resolvable prefix (the subject terminus lives in the agent-runtime
# profile corpus).
ex:cqProvenanceChain a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/model-serving/queries/competency/provenance-chain.rq" ;
    gmeow:cqProject "slices/extensions/model-serving/queries/project/upper-projection.rq" ;
    gmeow:cqDataFile "examples/provenance-chain.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqProvenanceChainShape ;
    gmeow:cqRationale "GMEOW must answer 'which artifact / deployment / runtime / session / invocation produced an output?' The de-conflation chain resolves end to end, each hop named: ex:output gmeow:wasGeneratedBy ex:invocation1, which gmeow:invocationInExecution ex:execution1 and gmeow:subEventOf ex:session1; the execution gmeow:executionOfDeployment ex:opusDeployment, which gmeow:deploymentArtifact ex:opusArtifact. The asserted answer is exactly this one fully-resolved row." ;
    gmeow:cqExpectRow ex:cqProvenanceChainRow .

ex:cqProvenanceChainShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "output" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn
        [ logic:columnVariable "invocation" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn
        [ logic:columnVariable "execution" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn
        [ logic:columnVariable "deployment" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn
        [ logic:columnVariable "artifact" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn
        [ logic:columnVariable "session" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:cqProvenanceChainRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "output" ; gmeow:cellValueIri exd:output ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "invocation" ; gmeow:cellValueIri exd:invocation1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "execution" ; gmeow:cellValueIri exd:execution1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "deployment" ; gmeow:cellValueIri exd:opusDeployment ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "artifact" ; gmeow:cellValueIri exd:opusArtifact ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "session" ; gmeow:cellValueIri exd:session1 ] .

# --- Upper-projection agreement: flat shortcut == collapse of the canon --------
# The soundness centerpiece (INHABITED-RUNTIME-STACK.md §Upper-projections). Over
# perf-recall.ttl the audit query returns the flat gmeow:generatedForSubject /
# gmeow:generatedUnderConfiguration shortcut values AND the values obtained by
# walking the full nested canon (→ session → sessionSubjectStage / sessionConfiguration).
# RowsExact pins ALL FOUR columns to the SAME two IRIs, so the shortcut and the
# collapse of the canon provably AGREE (Principle 7): the commuting diagram
# commutes. A disagreement (a stale or wrong projection) changes the row and fails.
# The perf-recall fixture lives under tests/ (consumed via cqDataFile, not the
# example sweep). The subject terminus here is the STAGE (standalone-resolvable);
# the agent-runtime profile corpus extends the collapse to the durable lineage.
ex:cqProjectionAgreement a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/model-serving/queries/competency/audit.rq" ;
    gmeow:cqProject "slices/extensions/model-serving/queries/project/upper-projection.rq" ;
    gmeow:cqDataFile "tests/perf-recall.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqProjectionAgreementShape ;
    gmeow:cqRationale "GMEOW must guarantee that the flat, materialized upper-projection an agent-memory engine reads for real-time recall AGREES with the deep audit that walks the full nested de-conflation canon (Principle 7). Over perf-recall.ttl the one-hop gmeow:generatedForSubject (ex:lillithStage) equals the collapse output → invocation → session → gmeow:sessionSubjectStage (ex:lillithStage), and gmeow:generatedUnderConfiguration (ex:configA) equals output → invocation → session → gmeow:sessionConfiguration (ex:configA). Pinning shortcut and audit columns to the same IRIs is the executable proof that the projection and the canon commute; a stale or wrong projection would fail this row." ;
    gmeow:cqExpectRow ex:cqProjectionAgreementRow .

ex:cqProjectionAgreementShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "shortcutSubject" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn
        [ logic:columnVariable "auditSubject" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn
        [ logic:columnVariable "shortcutConfig" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:declaresColumn
        [ logic:columnVariable "auditConfig" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:cqProjectionAgreementRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "shortcutSubject" ; gmeow:cellValueIri exd:lillithStage ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "auditSubject" ; gmeow:cellValueIri exd:lillithStage ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "shortcutConfig" ; gmeow:cellValueIri exd:configA ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "auditConfig" ; gmeow:cellValueIri exd:configA ] .
