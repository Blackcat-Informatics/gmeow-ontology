    rdfs:label "reported transition interlude"@x-gmeow-english ;
    skos:definition "A source-supplied interlude occurrence retained within an episode-transition report."@x-gmeow-english ;
    gmeow:useWhen "Use to retain each actual supplied interlude occurrence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid RDF lists, shared payload ordinals or an inferred empty history from missing links."@x-gmeow-english ;
    gmeow:howToUse "Link the report to each EpisodeInterlude; preserve its payload, position and exact association provenance."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional. Each interlude occurrence belongs to one report; ordinal order proves no chronology."@x-gmeow-english ;
    skos:example "A report retains several separately positioned interlude occurrences."@x-gmeow-english ;
