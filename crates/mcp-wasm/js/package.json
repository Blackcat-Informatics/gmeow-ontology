{
  "name": "@blackcatinformatics/gmeow-mcp-wasm",
  "version": "0.2.0",
  "description": "The GMEOW MCP engine's demand-loaded REASONING segment, compiled to wasm32: the full consumer tool surface over a gmeow.gts snapshot, in a browser tab with no server.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Blackcat-Informatics/gmeow-ontology"
  },
  "keywords": [
    "rdf",
    "rdf-1.2",
    "mcp",
    "model-context-protocol",
    "wasm",
    "knowledge-graph"
  ],
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "pkg/gmeow_mcp_wasm.js",
    "pkg/gmeow_mcp_wasm.d.ts",
    "pkg/gmeow_mcp_wasm_bg.wasm",
    "pkg/gmeow_mcp_wasm_bg.wasm.d.ts"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
