@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/notes>
    a gmeow:Slice ;
    rdfs:label "notes"@x-gmeow-english ;
    skos:definition "Core notes and annotation records over shared evidence, naming and tagging foundations. Logical and kernel dependencies support this domain-independent vocabulary. This manifest declares slice identity, tier, dependencies and consumer."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/notes> ;
    dcterms:title "GMEOW Notes & Annotation Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/tags> ,
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/evidence> ,
        <https://blackcatinformatics.ca/gmeow/slices/names> ;
    gmeow:sliceConsumer "PKM annotations (annotation target span) over core evidence spans; Web Annotation projection."@x-gmeow-english.
