    a ontolex:Form ;
    ontolex:writtenRep "Aggregate Constraint"@en .

<http://example.org/lang/glossary-vartrans/form-src/53543ecc824af42e>
    a ontolex:Form ;
    ontolex:writtenRep "has data controller"@en .

<http://example.org/lang/glossary-vartrans/form-src/536fcbc32d79dcac>
    a ontolex:Form ;
    ontolex:writtenRep "dict-v3 entry: lang:Denotation to den"@en .

<http://example.org/lang/glossary-vartrans/form-src/537b647d15df5e33>
    a ontolex:Form ;
    ontolex:writtenRep "Underspecified Piecewise Function"@en .

<http://example.org/lang/glossary-vartrans/form-src/53d145ef3a68a41e>
    a ontolex:Form ;
    ontolex:writtenRep "The axis for QA depth, placement, and manifest honesty: per-term test reach, correct competency-cell cardinality modes, counter-examples pinning their (fixture, code), each hard rule mapped to exactly one cheapest owning gate, and sliceDependsOn equal to the computed ownership set. It is NOT the reasoner axis (which runs the cells) — this measures whether the cells exist and sit in the right layer (SLICE_GUIDE §9; SLICE_QA)."@en .

<http://example.org/lang/glossary-vartrans/form-src/53e841d72831f55a>
    a ontolex:Form ;
    ontolex:writtenRep "The component of a Hodge decomposition lying in the image of the applicable boundary or coboundary operator."@en .

