# ── The deliberate-non-assertion report ─────────────────────────────────────────
# Every intentional boundary the ontology commits to must be enumerable, not merely
# respected. Over the production ontology (no synthetic data file) exactly five accepted
# candidates are flagged logic:candidateDeliberateNonAssertion true — the whole boundary set,
# queryable as one report: two logic:CategoryNonEntailmentObligation (deceptive intent is
# never entailed; counterpart never becomes transitive) carried by their standing
# logic:NonEntailmentObligation, two logic:CategoryIntegrityConstraint (a measured value is
# frame-relative — no frame-free collapse; an instance carries at most one ultimate Kind — no
# over-typing) whose logic:violation is a finding, and one logic:CategoryDeliberateOverlap (the
# preserved gmeow:SocialObject ∩ gmeow:InformationObject overlap). Each candidate's
# skos:definition and logic:candidateScope carry its rationale. The report selects on the flag,
# not the category, precisely because the two integrity-constraint boundaries share their
# category with ordinary integrity constraints and could not otherwise be enumerated as the
# deliberate set.

ex:cqDeliberateNonAssertions a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/logic/queries/competency/deliberate-non-assertions.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The deliberate non-assertions the ontology guarantees must be enumerable as one report, each with its boundary kind: every logic:FormalizationCandidate flagged logic:candidateDeliberateNonAssertion true, regardless of its logic:candidateCategory. Over the production ontology exactly five are recorded — deceptive-intent-never-entailed and counterpart-never-transitive (logic:CategoryNonEntailmentObligation), frame-relativity-no-frame-free-collapse and no-over-typing (logic:CategoryIntegrityConstraint), and the preserved SocialObject∩InformationObject overlap (logic:CategoryDeliberateOverlap); each candidate's skos:definition and logic:candidateScope carry the rationale. Selecting on the flag rather than the category is what makes the whole set queryable — the two integrity-constraint boundaries are indistinguishable from ordinary integrity constraints by category alone." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqDeliberateNonAssertionsShape ;
    gmeow:cqExpectRow ex:rowDnaIntentNotEntailed, ex:rowDnaCounterpartNonTransitive,
        ex:rowDnaFrameRelativity, ex:rowDnaNoOverTyping,
        ex:rowDnaSocialInformationOverlap .

ex:cqDeliberateNonAssertionsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "candidate" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "category" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowDnaIntentNotEntailed a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "candidate" ; gmeow:cellValueIri logic:candidateIntentNotEntailed ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryNonEntailmentObligation ] .

ex:rowDnaCounterpartNonTransitive a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "candidate" ; gmeow:cellValueIri logic:candidateCounterpartNonTransitive ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryNonEntailmentObligation ] .

ex:rowDnaFrameRelativity a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "candidate" ; gmeow:cellValueIri logic:candidateFrameRelativity ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryIntegrityConstraint ] .

ex:rowDnaNoOverTyping a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "candidate" ; gmeow:cellValueIri logic:candidateNoOverTyping ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryIntegrityConstraint ] .

ex:rowDnaSocialInformationOverlap a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "candidate" ; gmeow:cellValueIri logic:candidateSocialInformationOverlap ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryDeliberateOverlap ] .

# ── Native arithmetic/comparison builtin fragment ────────────────────────────────
# Is the closed arithmetic/comparison builtin fragment a first-class, structured,
# box-typed individual of the reasoning ontology — the thing the native physical
# reasoning core actually decides — and not merely a Rust implementation detail? The
# question runs over the production ontology (the merged logic module, no synthetic
# data file) and pins, by IRI, that logic:builtinArithmetic exists as a logic:Builtin
# whose gmeow:graphBoxRole is gmeow:boxABox. The FILTER isolates the arithmetic
# builtin so the answer is drift-proof against the broader logic:Builtin population
# (the date-difference and string-concat builtins are box-typed the same way and must
# not leak into this row). Exactly one row is expected.
ex:cqNativeArithmeticDecided a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/> PREFIX logic: <https://blackcatinformatics.ca/logic/> SELECT ?b WHERE { ?b a logic:Builtin ; gmeow:graphBoxRole gmeow:boxABox . FILTER(?b = logic:builtinArithmetic) }" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The closed arithmetic/comparison builtin fragment — arithmetic operators + - * // (integer division, truncating toward zero) and comparisons > < >= =< =:= (arithmetic equality) over checked i64 numeric arguments — is decided by the native physical reasoning core as binding-pattern-keyed filters and generators. It surfaces in the production ontology as a first-class, box-typed individual, logic:builtinArithmetic, a logic:Builtin whose gmeow:graphBoxRole is gmeow:boxABox, so a query pinned to that IRI returns exactly one row. The residual modes — an unbound operand, division by zero, and i64 overflow — are typed hard failures rather than wrong answers or silent approximations."@x-gmeow-english ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRowCount 1 ;
    gmeow:cqResultShape ex:cqNativeArithmeticDecidedShape ;
    gmeow:cqExpectRow ex:rowNativeArithmeticBuiltin .

ex:cqNativeArithmeticDecidedShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "b" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowNativeArithmeticBuiltin a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "b" ; gmeow:cellValueIri logic:builtinArithmetic ] .

# ── Conjecture library: the closed epistemic lifecycle state set ──────────────────
# Is the EPISTEMIC conjecture lifecycle — open / corroborated / refuted-in-standpoint
# / withdrawn — carried as a closed set of first-class declared individuals, ORTHOGONAL
# to the governance lifecycle a conjecture inherits from the candidate spine (Principle
# 9)? The query runs over the production ontology (the merged logic module, no synthetic
# data file) and selects every member of logic:ConjectureLifecycleState. cqExactRows
# pins that the set is EXACTLY the four states — a missing or misspelt member is a
# coverage gap.
ex:cqConjectureLifecycleStates a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/logic/queries/competency/conjecture-lifecycle-states.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The conjecture library carries a conjecture's EPISTEMIC state (open / corroborated / refuted-in-standpoint / withdrawn) as the closed value class logic:ConjectureLifecycleState, ORTHOGONAL to the GOVERNANCE lifecycle it inherits from logic:FormalizationCandidate (Principle 9 refuses to collapse the two axes). A SELECT DISTINCT over the declared members of that class must return exactly the four: logic:ConjectureOpen, logic:ConjectureCorroborated, logic:ConjectureRefutedInStandpoint and logic:ConjectureWithdrawn." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqConjectureLifecycleStatesShape ;
    gmeow:cqExpectRow
        ex:rowConjectureOpen, ex:rowConjectureCorroborated,
        ex:rowConjectureRefutedInStandpoint, ex:rowConjectureWithdrawn .

ex:cqConjectureLifecycleStatesShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "state" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowConjectureOpen a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "state" ; gmeow:cellValueIri logic:ConjectureOpen ] .

ex:rowConjectureCorroborated a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "state" ; gmeow:cellValueIri logic:ConjectureCorroborated ] .

ex:rowConjectureRefutedInStandpoint a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "state" ; gmeow:cellValueIri logic:ConjectureRefutedInStandpoint ] .

ex:rowConjectureWithdrawn a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "state" ; gmeow:cellValueIri logic:ConjectureWithdrawn ] .

# ── Conjecture library: every refutation is replayable ───────────────────────────
# Does a refuted-in-standpoint conjecture expose a REPLAYABLE witness — the individual
# forced to owl:Nothing, the world it was found in, and a jointly-inconsistent premise?
# The query runs over the merged ontology UNIONED with the tests/fixtures/conjectures.ttl
# overlay (reasoningNone), joining a refuted conjecture through logic:conjectureRefutationWitness
# to its logic:ContradictionWitness and unpacking the witness carriers. The fixture
# carries exactly one refuted conjecture with a one-premise witness, so exactly one row
# (?conj ?ind ?world ?premise) is expected.
ex:cqRefutedConjectureHasWitness a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/logic/queries/competency/refuted-conjecture-has-witness.rq" ;
    gmeow:cqDataFile  "tests/fixtures/conjectures.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A conjecture in logic:ConjectureRefutedInStandpoint MUST name a concrete logic:ContradictionWitness (Principle 9: a refutation is standpoint-scoped and replayable, never a bare global-false claim). Over the fixture the single refuted conjecture ex:cxRefutedTotalParthood joins through logic:conjectureRefutationWitness to ex:cxWitnessIncomparablePair, whose logic:witnessIndividual, logic:witnessWorld and single logic:witnessPremise unpack to exactly one row — the replayable counterexample." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqRefutedConjectureHasWitnessShape ;
    gmeow:cqExpectRow ex:rowRefutedConjectureWitness .

ex:cqRefutedConjectureHasWitnessShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "conj" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "ind" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnDatatype <http://www.w3.org/2001/XMLSchema#string> ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "world" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnDatatype <http://www.w3.org/2001/XMLSchema#string> ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "premise" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnDatatype <http://www.w3.org/2001/XMLSchema#string> ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowRefutedConjectureWitness a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "conj" ; gmeow:cellValueIri ex:cxRefutedTotalParthood ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "ind" ; gmeow:cellValueLiteral "ex:leftHand" ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "world" ; gmeow:cellValueLiteral "ex:worldActual" ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "premise" ; gmeow:cellValueLiteral "ex:leftHand logic:properPartOf ex:body" ] .

# ── Conjecture library: contrapositive propagation frontier ──────────────────────
# Does the corpus entailment pre-order support CONTRAPOSITIVE propagation of refutation
# — if phi entails psi and psi is refuted, phi is on the re-test frontier? This is the
# load-bearing consumer of logic:conjectureEntails. The query runs over the merged
# ontology UNIONED with the tests/fixtures/conjectures.ttl overlay (reasoningNone),
# selecting each ?phi that entails a refuted ?psi. The fixture supplies one such edge
# (ex:cxGeneralParthood entails the refuted ex:cxRefutedTotalParthood), so exactly one
# (?phi ?psi) row is expected.
ex:cqConjectureEntailsPropagation a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/logic/queries/competency/conjecture-entails-propagation.rq" ;
    gmeow:cqDataFile  "tests/fixtures/conjectures.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "logic:conjectureEntails carries the corpus pre-order phi models psi; its purpose is contrapositive propagation — a refutation of psi puts every phi that entails it on the re-test frontier. Over the fixture the edge ex:cxGeneralParthood conjectureEntails ex:cxRefutedTotalParthood, whose target is logic:ConjectureRefutedInStandpoint, yields exactly one propagation row (phi = ex:cxGeneralParthood, psi = ex:cxRefutedTotalParthood)." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqConjectureEntailsPropagationShape ;
    gmeow:cqExpectRow ex:rowConjectureEntailsPropagation .

ex:cqConjectureEntailsPropagationShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "phi" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "psi" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowConjectureEntailsPropagation a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "phi" ; gmeow:cellValueIri ex:cxGeneralParthood ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "psi" ; gmeow:cellValueIri ex:cxRefutedTotalParthood ] .

# ── Conjecture library: the Lakatos monster-barring chain survives its witness ────
# Does a refined SUCCESSOR conjecture name both the refuted predecessor it weakens
# AND the concrete witness that predecessor was killed by — the witness the successor
# now EXCLUDES? This is the load-bearing consumer of logic:conjectureRefinedFrom and
# logic:survivesCounterexample. Unlike the promotion legs, a single conjecture_test
# run cannot synthesize a refinement chain (there is no predecessor conjecture in one
# run), so these are legitimately AUTHORED (reviewer-asserted) edges — the fixture
# supplies one chain (ex:cxRefinePartialParthood refinedFrom the refuted
# ex:cxRefineTotalParthood, survivesCounterexample its witness
# ex:cxRefineWitnessIncomparablePair). The query joins the survived witness to the
# predecessor's own refutation witness, so exactly one (successor, predecessor,
# witness) row is expected; removing either chain edge empties the result.
ex:cqConjectureRefinementSurvivesWitness a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/logic/queries/competency/conjecture-refinement-survives-witness.rq" ;
    gmeow:cqDataFile  "tests/fixtures/conjecture-refinement.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The Lakatos monster-barring move must be REPLAYABLE: a refined successor conjecture (logic:conjectureRefinedFrom) weakens a refuted predecessor to exclude its counterexample, and logic:survivesCounterexample pins the concrete logic:ContradictionWitness the successor now excludes to the SAME witness the predecessor was refuted by (logic:conjectureRefutationWitness) — the evidence the refinement did real work. Over the fixture the successor ex:cxRefinePartialParthood is refinedFrom the refuted ex:cxRefineTotalParthood and survivesCounterexample its witness ex:cxRefineWitnessIncomparablePair, so exactly one (successor, predecessor, witness) row is returned; dropping conjectureRefinedFrom or survivesCounterexample (or breaking the predecessor-witness join) empties it, so the question is falsifiable, not a tautology."@x-gmeow-english ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqConjectureRefinementSurvivesWitnessShape ;
    gmeow:cqExpectRow ex:rowConjectureRefinementSurvivesWitness .

ex:cqConjectureRefinementSurvivesWitnessShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "successor" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "predecessor" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "witness" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowConjectureRefinementSurvivesWitness a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "successor" ; gmeow:cellValueIri ex:cxRefinePartialParthood ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "predecessor" ; gmeow:cellValueIri ex:cxRefineTotalParthood ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "witness" ; gmeow:cellValueIri ex:cxRefineWitnessIncomparablePair ] .

# =========================================================================== #
# Flagship acceptance — the five scenario-pinning competency questions.
#
# Each of the five flagship acceptance scenarios is pinned by a competency question
# that queries its worked acceptance-witness fixture (gmeow:cqDataFile) and pins the
# single carrier value the native producer's structure certifies. These are the
# green competency gates the flagship manifest's gmeow:demonstratedByCompetency
# resolves to; the execution-discharge harness runs each producer and pins the same
# datum from the native side.
# =========================================================================== #

# --- CQ 1 — the closure entails an atom beyond its EDB --------------------- #
ex:cqLogicClosure a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/logic/queries/competency/logic-closure-entails-atom.rq" ;
    gmeow:cqDataFile  "tests/conformance-fixtures/closure-witness-complete.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The elRlDlClosure flagship pinned: over the worked witness the closure names exactly the entailed atom `A subClassOf C` — the transitive subClassOf the native reason_all closure derives beyond the asserted EDB. Dropping logic:closureEntailedAtom empties the result." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqLogicClosureShape ;
    gmeow:cqExpectRow ex:rowLogicClosure .

ex:cqLogicClosureShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "atom" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowLogicClosure a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "atom" ; gmeow:cellValueLiteral "A subClassOf C" ] .

# --- CQ 2 — the correspondence discharges its section obligation ----------- #
ex:cqLogicSection a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/logic/queries/competency/logic-section-obligation.rq" ;
    gmeow:cqDataFile  "tests/conformance-fixtures/section-witness-complete.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The correspondenceSection flagship pinned: over the worked witness the accepted round-trip discharges exactly the obligation fx:sectionObligationRoundTrip — the section law leg_pair_verdict certifies as ObligationDischarged. Dropping logic:dischargesSectionObligation empties the result." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqLogicSectionShape ;
    gmeow:cqExpectRow ex:rowLogicSection .

ex:cqLogicSectionShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "obligation" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowLogicSection a gmeow:ExpectedRow ;
