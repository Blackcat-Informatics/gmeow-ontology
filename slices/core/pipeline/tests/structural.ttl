#
# Declarative structural assertions for the pipeline slice (Tier-B
# closeout). The repo-level narrow-waist/transpile tests check pipeline BEHAVIOR
# (KEEP); these cells pin the slice's asserted-TBox spine and the integrity of
# its dogfooded build-pipeline ABox fresh (MAXIMAL coverage, dogfooding). Each
# runs as a SPARQL ASK over the module graph (gmeow:scopeModule).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/pipeline/tests/> .

# --- 1. Pipeline / PipelineStage / StageKind spine (MUST hold) ---------------
ex:saPipelineKinds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:Pipeline      a owl:Class , logic:Kind ; rdfs:subClassOf logic:Plan , gmeow:SocialObject .
    gmeow:PipelineStage a owl:Class , logic:Kind ; rdfs:subClassOf gmeow:SocialObject .
    gmeow:StageKind     a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:Pipeline MUST be a logic:Plan (the build re-seated under the canonical process model) AND a gmeow:SocialObject (logic:Plan grounds its social-object sort in prose, not by a subclass edge, so the asserted edge is independent and load-bearing). gmeow:PipelineStage stays a logic:Kind SocialObject (a stage is a unit of work, not itself a plan; modelling it as a logic:ActionSchema is deferred). gmeow:StageKind is a QualityValue vocabulary of stage roles." .

# --- 5. Pipeline is a DAG-workflow projection of logic:Plan (MUST hold) -------
ex:saPipelineDagProfileSeating a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:dataflowConsumes rdfs:subPropertyOf logic:dataflowConsumes .
    gmeow:dataflowProduces rdfs:subPropertyOf logic:dataflowProduces .
    gmeow:pipeline-build
        logic:planGoal           gmeow:goalShippableBundle ;
        logic:planSuccessMode    logic:StrongPlanSuccess ;
        logic:executedUnderContract logic:DagWorkflowContract .
    gmeow:goalShippableBundle a gmeow:Goal .
}""" ;
    gmeow:saRationale "The pipeline MUST be a projection of the one canonical process model, not a parallel one: gmeow:dataflowConsumes/dataflowProduces specialize the canonical logic:dataflowConsumes/dataflowProduces, and the build plan gmeow:pipeline-build carries its logic:planGoal (the shippable bundle), logic:planSuccessMode (StrongPlanSuccess — the deterministic build reaches the goal every run, satisfying logic:PlanShape), and runs logic:executedUnderContract the DAG-workflow profile under which its acyclic dataflow closure is certified." .

# --- 2. Dataflow and stage property shapes (MUST hold) -----------------------
ex:saPipelinePropertyShapes a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:hasStage         a owl:ObjectProperty ;   rdfs:domain gmeow:Pipeline ;      rdfs:range gmeow:PipelineStage .
    gmeow:dataflowConsumes a owl:ObjectProperty ;   rdfs:domain gmeow:PipelineStage ; rdfs:range gmeow:PipelineStage .
    gmeow:dataflowProduces a owl:ObjectProperty ;   rdfs:domain gmeow:PipelineStage ; rdfs:range gmeow:PipelineStage .
    gmeow:stageKind        a owl:ObjectProperty ;   rdfs:domain gmeow:PipelineStage ; rdfs:range gmeow:StageKind .
    gmeow:requiresResource a owl:ObjectProperty ;   rdfs:domain gmeow:PipelineStage ; rdfs:range gmeow:Resource .
}""" ;
    gmeow:saRationale "The pipeline edges MUST hold their shapes: gmeow:hasStage (Pipeline→Stage), the gmeow:dataflowConsumes/dataflowProduces dataflow (Stage→Stage), gmeow:stageKind (Stage→StageKind), and gmeow:requiresResource (Stage→Resource)." .

# --- 3. The seeded StageKind value vocabulary (MUST hold) --------------------
ex:saStageKindSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:kindSourceLoad a gmeow:StageKind . gmeow:kindTransform a gmeow:StageKind .
    gmeow:kindReason a gmeow:StageKind .     gmeow:kindValidate a gmeow:StageKind .
    gmeow:kindDocsRender a gmeow:StageKind .  gmeow:kindExportLeaf a gmeow:StageKind .
    gmeow:kindSink a gmeow:StageKind .
}""" ;
    gmeow:saRationale "The StageKind value vocabulary MUST seed the seven stage roles (source-load, transform, reason, validate, docs-render, export-leaf, sink) the narrow-waist pipeline classifies its stages by." .

# --- 4. Every dogfooded PipelineStage carries a stageKind (MUST-NOT hold) -----
ex:saEveryStageHasKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?s a gmeow:PipelineStage .
    FILTER NOT EXISTS { ?s gmeow:stageKind ?k }
}""" ;
    gmeow:saRationale "Integrity of the dogfooded build pipeline: every gmeow:PipelineStage individual MUST carry a gmeow:stageKind classifying its role — the slice MUST NOT contain a stage with no kind, so the narrow-waist dataflow stays fully typed." .
