<https://blackcatinformatics.ca/gmeow/MembershipFillsPostOrgMismatchConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Membership> ;
