@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/employment>
    a gmeow:Slice ;
    rdfs:label "employment"@x-gmeow-english ;
    skos:definition "The employment slice of the GMEOW ontology (extension tier): GMEOW Employment Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    dcterms:title "GMEOW Employment Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierExtension ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/entities> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/organization> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:sliceConsumer "CV/employment claims over organization and agreements; the mail corpus's signatures."@x-gmeow-english .
