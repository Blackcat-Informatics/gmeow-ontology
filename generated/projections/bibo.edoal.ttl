@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/bibo> a align:Alignment ;
    rdfs:label "GMEOW → bibo (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "Article → bibo:AcademicArticle"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Article ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri bibo:AcademicArticle ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "DOI-shaped identifier → bibo:doi"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:identifier ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bibo:doi ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "non-DOI identifier → bibo:identifier"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:identifier ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bibo:identifier ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "Patent → bibo:Patent"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Patent ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri bibo:Patent ] ;
            align:relation "=" ;
            edoal:measure 9.5e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "bibo" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
