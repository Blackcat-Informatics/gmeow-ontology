    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:sessionSubjectStage and nothing else. It is not a definition of gmeow:sessionSubjectStage (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:sessionSubjectStageFunctionality logic:characterizes gmeow:sessionSubjectStage ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# Selected mathematical artifact profiles and held metric observations.
gmeow:LearnedModelArtifact
    a logic:SubKind, logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Learned Model Artifact"@x-gmeow-english ;
    skos:definition "A served information artifact embodying a separately identified math:LearnedModel. Selecting this profile requires that mathematical model link; the artifact is not the mathematical object."@x-gmeow-english ;
    gmeow:useWhen "Use for a served artifact whose fitted mathematical model is explicitly known."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid applying this profile to a tokenizer or other artifact with no declared learned model."@x-gmeow-english ;
    gmeow:howToUse "Link artifactLearnedModel to a separately identified math:LearnedModel; select TensorModelArtifact only when its forward tensor structure is declared."@x-gmeow-english ;
    skos:scopeNote "Only the selected learned profile requires the model role; generic ModelArtifact instances remain legal without mathematical disclosure."@x-gmeow-english ;
    skos:example "ex:artifact a gmeow:LearnedModelArtifact ; gmeow:artifactLearnedModel ex:model . ex:model a math:LearnedModel ."@x-gmeow-english ;
    logic:subClassOf gmeow:ModelArtifact .

gmeow:TensorModelArtifact
    a logic:SubKind, logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Tensor Model Artifact"@x-gmeow-english ;
    skos:definition "A learned artifact declaring a mathematical forward TensorComputationGraph and WeightTensor parameters. This selected profile does not apply to every tokenizer, adapter or non-neural artifact."@x-gmeow-english ;
    gmeow:useWhen "Use when the artifact declares its forward tensor architecture and learned weight tensors."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid requiring tensor architecture from every learned artifact or confusing an unknown shape with a rank-zero tensor."@x-gmeow-english ;
    gmeow:howToUse "Name artifactLearnedModel, artifactComputationGraph and artifactWeightTensor; complete each imported math profile and keep graph and parameter ownership coherent."@x-gmeow-english ;
    skos:scopeNote "Tensor extents and element types reuse the canonical math owner; the profile carries references rather than payload bytes."@x-gmeow-english ;
    skos:example "ex:artifact a gmeow:TensorModelArtifact ; gmeow:artifactLearnedModel ex:model ; gmeow:artifactComputationGraph ex:graph ; gmeow:artifactWeightTensor ex:weight ."@x-gmeow-english ;
    logic:subClassOf gmeow:LearnedModelArtifact .

gmeow:ModelMetricObservation
    a logic:SubKind, logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Model Metric Observation"@x-gmeow-english ;
    skos:definition "An explicitly selected finite numeric-literal metric observation about a model artifact: a vantage applies an ObservationMethod and a ModelMetric to obtain Quantity results with quantityValue and the declared metric dimension. Protocol, mathematical model, artifact, invocation and result retain distinct identities."@x-gmeow-english ;
    gmeow:useWhen "Use for a quantitative benchmark result held by a named evaluator about an artifact."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid placing a bare scalar on the artifact or confusing a benchmark protocol with its result or execution."@x-gmeow-english ;
    gmeow:howToUse "Name vantage, observedFeature, observationMethod, evaluatedMetric and observationResult; give every Quantity result one finite numeric quantityValue and the metric dimension."@x-gmeow-english ;
    skos:scopeNote "This selected profile requires finite numeric-literal quantityValue results. Rational-only carriers, vector, interval, unbounded and categorical results remain legal as ordinary Observations under their appropriate contracts; do not force them into this subtype or manufacture approximations."@x-gmeow-english ;
    skos:example "ex:reading a gmeow:ModelMetricObservation ; gmeow:vantage ex:evaluator ; gmeow:observedFeature ex:artifact ; gmeow:observationMethod ex:protocol ; gmeow:evaluatedMetric ex:accuracy ; gmeow:observationResult ex:score ."@x-gmeow-english ;
    logic:subClassOf gmeow:Observation .

gmeow:ModelMetric
    a logic:AbstractIndividualType, logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Model Metric"@x-gmeow-english ;
    skos:definition "An open value vocabulary naming an evaluation metric and its expected mathematical Dimension. Individuals may declare different dimensions; a metric is neither a physical metric tensor nor a measured result."@x-gmeow-english ;
    gmeow:useWhen "Use to declare an evaluation metric independently of any measured result."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating every metric as dimensionless or using math:MetricSignature for a benchmark metric."@x-gmeow-english ;
    gmeow:howToUse "Mint a metric individual with exactly one typed metricDimension; reuse that individual across observations using the same metric."@x-gmeow-english ;
    skos:scopeNote "Metric identity is open and shared; a declared dimension is not a measured magnitude, tensor shape or preferred assessment."@x-gmeow-english ;
    skos:example "ex:accuracy a gmeow:ModelMetric ; gmeow:metricDimension math:dimensionless ."@x-gmeow-english .

gmeow:artifactLearnedModel
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "artifact learned model"@x-gmeow-english ;
    skos:definition "Links a LearnedModelArtifact to the separately identified math:LearnedModel embodied by its content."@x-gmeow-english ;
    gmeow:useWhen "Use when the mathematical model embodied by an artifact is declared."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing this role at the artifact itself, a SoftwareAgent, an inference invocation or an evaluation result."@x-gmeow-english ;
    gmeow:howToUse "Link one LearnedModelArtifact to one distinct math:LearnedModel; the artifact remains an information object."@x-gmeow-english ;
    skos:scopeNote "Single-valued on LearnedModelArtifact; artifact content identity remains distinct from mathematical model identity."@x-gmeow-english ;
    skos:example "ex:artifact gmeow:artifactLearnedModel ex:model . ex:model a math:LearnedModel ."@x-gmeow-english ;
    logic:domain gmeow:LearnedModelArtifact ; logic:range math:LearnedModel .

gmeow:artifactComputationGraph
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "artifact computation graph"@x-gmeow-english ;
    skos:definition "Links a TensorModelArtifact to its forward TensorComputationGraph, whose architectureOf names the same learned model declared by the artifact."@x-gmeow-english ;
    gmeow:useWhen "Use for the forward expression graph declared by a tensor artifact."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting the runtime execution, a display diagram or tensor bytes for the mathematical graph."@x-gmeow-english ;
    gmeow:howToUse "Point to one TensorComputationGraph with computationNode applications and architectureOf the artifact learned model."@x-gmeow-english ;
    skos:scopeNote "Single-valued on TensorModelArtifact; architecture ownership is checked against the separately declared learned model."@x-gmeow-english ;
    skos:example "ex:artifact gmeow:artifactComputationGraph ex:graph . ex:graph a math:TensorComputationGraph ; math:architectureOf ex:model ."@x-gmeow-english ;
    logic:domain gmeow:TensorModelArtifact ; logic:range math:TensorComputationGraph .

gmeow:artifactWeightTensor
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "artifact weight tensor"@x-gmeow-english ;
    skos:definition "Links a TensorModelArtifact to a WeightTensor in a ParameterSpace declared for the same learned model or its forward graph. This relation carries no tensor payload."@x-gmeow-english ;
    gmeow:useWhen "Use for each learned weight tensor declared by a tensor artifact."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid placing tensor payload bytes or a scalar weight literal in this role."@x-gmeow-english ;
    gmeow:howToUse "Point to a WeightTensor with a typed inParameterSpace; its parameterSpaceOf must name the artifact learned model or forward graph."@x-gmeow-english ;
    skos:scopeNote "Multiple declared weights are permitted. Each parameter-space reference retains the inherited AlgebraicStructure requirements."@x-gmeow-english ;
    skos:example "ex:artifact gmeow:artifactWeightTensor ex:weight . ex:weight a math:WeightTensor ; math:inParameterSpace ex:parameters ."@x-gmeow-english ;
    logic:domain gmeow:TensorModelArtifact ; logic:range math:WeightTensor .

gmeow:artifactTrainingProblem
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "artifact training problem"@x-gmeow-english ;
    skos:definition "Optionally records an OptimizationProblem for a learned artifact. When declared its objectiveFunction is a LossFunction; inference-only or undocumented training does not imply a training objective."@x-gmeow-english ;
    gmeow:useWhen "Use when the artifact training objective is known and explicitly documented."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing an objective for an inference-only artifact or treating a training specification as a training run."@x-gmeow-english ;
    gmeow:howToUse "Point to an OptimizationProblem with a typed LossFunction objectiveFunction; complete the loss Function domain and codomain."@x-gmeow-english ;
    skos:scopeNote "Absence means no training specification is declared; it does not infer that no training occurred."@x-gmeow-english ;
    skos:example "ex:artifact gmeow:artifactTrainingProblem ex:problem . ex:problem a math:OptimizationProblem ; math:objectiveFunction ex:loss . ex:loss a math:LossFunction ."@x-gmeow-english ;
    logic:domain gmeow:LearnedModelArtifact ; logic:range math:OptimizationProblem .

gmeow:evaluatedMetric
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "evaluated metric"@x-gmeow-english ;
    skos:definition "Names the ModelMetric applied by a ModelMetricObservation. Its declared dimension agrees with every observation result."@x-gmeow-english ;
    gmeow:useWhen "Use to identify which declared metric a held model evaluation reports."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid linking to a numeric result, distance function or free-text metric label."@x-gmeow-english ;
    gmeow:howToUse "Point the ModelMetricObservation to exactly one ModelMetric with a typed metricDimension; every result must have that dimension."@x-gmeow-english ;
    skos:scopeNote "The metric is exactly one per observation; independent observations and held results may coexist."@x-gmeow-english ;
    skos:example "ex:reading gmeow:evaluatedMetric ex:accuracy . ex:accuracy a gmeow:ModelMetric ; gmeow:metricDimension math:dimensionless ."@x-gmeow-english ;
    logic:domain gmeow:ModelMetricObservation ; logic:range gmeow:ModelMetric .

gmeow:metricDimension
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "metric dimension"@x-gmeow-english ;
    skos:definition "Names the single mathematical Dimension expected for a ModelMetric result. Dimensionless accuracy and time-valued latency remain different metric declarations."@x-gmeow-english ;
    gmeow:useWhen "Use to declare the mathematical dimension expected for an evaluation metric result."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid confusing tensor shape or parameter-space linear dimension with a Quantity dimension."@x-gmeow-english ;
    gmeow:howToUse "Give the ModelMetric exactly one math:Dimension; declare different metric individuals for incompatible dimensions."@x-gmeow-english ;
    skos:scopeNote "The declaration applies to every result of observations naming this metric; incompatible declarations require distinct metric individuals."@x-gmeow-english ;
    skos:example "ex:latency gmeow:metricDimension math:timeDimension ."@x-gmeow-english ;
    logic:domain gmeow:ModelMetric ; logic:range math:Dimension .

gmeow:LearnedModelArtifact logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:artifactLearnedModel ; logic:allValuesFrom math:LearnedModel ], [ a logic:Restriction ; logic:onProperty gmeow:artifactLearnedModel ; logic:maxQualifiedCardinality 1 ; logic:onClass math:LearnedModel ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:LearnedModelArtifact ; logic:closureKey "https://blackcatinformatics.ca/gmeow/artifactLearnedModel" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:TensorModelArtifact logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:artifactComputationGraph ; logic:allValuesFrom math:TensorComputationGraph ], [ a logic:Restriction ; logic:onProperty gmeow:artifactComputationGraph ; logic:maxQualifiedCardinality 1 ; logic:onClass math:TensorComputationGraph ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:TensorModelArtifact ; logic:closureKey "https://blackcatinformatics.ca/gmeow/artifactComputationGraph" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:TensorModelArtifact logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:artifactWeightTensor ; logic:allValuesFrom math:WeightTensor ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:TensorModelArtifact ; logic:closureKey "https://blackcatinformatics.ca/gmeow/artifactWeightTensor" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:LearnedModelArtifact logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:artifactTrainingProblem ; logic:allValuesFrom math:OptimizationProblem ] .
gmeow:ModelMetric logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:metricDimension ; logic:allValuesFrom math:Dimension ], [ a logic:Restriction ; logic:onProperty gmeow:metricDimension ; logic:maxQualifiedCardinality 1 ; logic:onClass math:Dimension ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelMetric ; logic:closureKey "https://blackcatinformatics.ca/gmeow/metricDimension" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:ModelMetricObservation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:evaluatedMetric ; logic:allValuesFrom gmeow:ModelMetric ], [ a logic:Restriction ; logic:onProperty gmeow:evaluatedMetric ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:ModelMetric ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelMetricObservation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/evaluatedMetric" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:ModelMetricObservation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:vantage ; logic:allValuesFrom gmeow:Entity ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelMetricObservation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/vantage" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:ModelMetricObservation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:observedFeature ; logic:allValuesFrom gmeow:ModelArtifact ], [ a logic:Restriction ; logic:onProperty gmeow:observedFeature ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:ModelArtifact ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelMetricObservation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/observedFeature" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:ModelMetricObservation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:observationMethod ; logic:allValuesFrom gmeow:ObservationMethod ], [ a logic:Restriction ; logic:onProperty gmeow:observationMethod ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:ObservationMethod ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelMetricObservation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/observationMethod" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:ModelMetricObservation logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:observationResult ; logic:allValuesFrom math:Quantity ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelMetricObservation ; logic:closureKey "https://blackcatinformatics.ca/gmeow/observationResult" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:TensorArtifactCoherenceConstraint a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Tensor artifact coherence constraint"@x-gmeow-english ;
    skos:definition "Every artifact graph describes its learned model, every computation node is an ApplicationExpression, and every weight parameter space names only that model or graph."@x-gmeow-english ;
    gmeow:useWhen "Use to reject tensor artifacts whose graph or parameter spaces belong to another model."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this law executes a graph or verifies a tensor payload."@x-gmeow-english ;
    gmeow:howToUse "Retain this Formula when projecting validation; test wrong and extra owners and a neighboring valid artifact."@x-gmeow-english ;
