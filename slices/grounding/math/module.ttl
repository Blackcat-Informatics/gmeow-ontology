    [ a owl:Restriction ; owl:onProperty math:reconstructionResidual ; owl:maxQualifiedCardinality 1 ; owl:onClass math:RationalValue ] ,
    [ a owl:Restriction ; owl:onProperty math:reconstructionResidual ; owl:allValuesFrom math:RationalValue ] ,
    [ a owl:Restriction ; owl:onProperty math:exactCoexactInnerProduct ; owl:minQualifiedCardinality 1 ; owl:onClass math:RationalValue ] ,
    [ a owl:Restriction ; owl:onProperty math:exactCoexactInnerProduct ; owl:maxQualifiedCardinality 1 ; owl:onClass math:RationalValue ] ,
    [ a owl:Restriction ; owl:onProperty math:exactCoexactInnerProduct ; owl:allValuesFrom math:RationalValue ] ,
