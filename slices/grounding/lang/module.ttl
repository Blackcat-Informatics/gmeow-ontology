    gmeow:gmnCandidateDenotation gmeow:gmnDenMathEulerMascheroni ;
    gmeow:cites gmeow:gmnOpenMathWork , gmeow:gmnUnicodeMathWork ;
    gmeow:graphBoxRole gmeow:boxABox .

