|} .

gmeow:Prohibition skos:relatedMatch premis:restriction {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "a PREMIS restriction"
|} .

gmeow:Constraint skos:relatedMatch premis:restriction {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
