# Reviewed class-scoped range/cardinality lift for obligations the conservative migrator left as
# residue because fixture values are typed through subclasses. The asserted ontology proves those
# subclass relations; these are therefore sound universal restrictions, not global-property claims.
math:ApproximateValue rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:approximates ; owl:allValuesFrom math:Number ] .
math:Function rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:domain ; owl:allValuesFrom math:Set ] ,
    [ a owl:Restriction ; owl:onProperty math:codomain ; owl:allValuesFrom math:Set ] .
math:Integral rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:integrand ; owl:allValuesFrom math:MeasurableFunction ] ,
    [ a owl:Restriction ; owl:onProperty math:withRespectTo ; owl:allValuesFrom math:Measure ] .
math:Quantity rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:hasDimension ; owl:allValuesFrom math:Dimension ] .
math:PersistenceLifetime rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:overFiltration ; owl:allValuesFrom math:Filtration ] ,
    [ a owl:Restriction ; owl:onProperty math:overFiltration ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Filtration ] ,
    [ a owl:Restriction ; owl:onProperty math:persistenceFeature ; owl:allValuesFrom math:HomologyGroup ] ,
    [ a owl:Restriction ; owl:onProperty math:persistenceFeature ; owl:maxQualifiedCardinality 1 ; owl:onClass math:HomologyGroup ] ,
    [ a owl:Restriction ; owl:onProperty math:bornAt ; owl:allValuesFrom owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:bornAt ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:diesAt ; owl:allValuesFrom owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:diesAt ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .
math:StabilityCalibrationRecord rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:calibrationEvidence ; owl:allValuesFrom math:PersistenceLifetime ] ,
    [ a owl:Restriction ; owl:onProperty math:credenceDerivationKind ; owl:allValuesFrom math:CredenceDerivationKind ] ,
    [ a owl:Restriction ; owl:onProperty math:credenceDerivationKind ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CredenceDerivationKind ] ,
    [ a owl:Restriction ; owl:onProperty math:stabilityGuarantee ; owl:allValuesFrom math:Theorem ] ,
    [ a owl:Restriction ; owl:onProperty math:stabilityGuarantee ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Theorem ] .
math:FiltrationStage rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:filtrationThreshold ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:stageStructure ; owl:maxQualifiedCardinality 1 ; owl:onClass math:TopologicalSpace ] .

# Numeric boundary residues. The class shape carries requiredness, cardinality, and datatype;
# these exact canonical constraints carry the comparison that OWL cannot safely project.
math:ArgumentSlotNonNegativeConstraint
    a logic:Constraint ;
    gmeow:enforcesFailureClass math:MalformedArgumentSlot ;
    logic:formalizes math:ArgumentSlotShape ;
    logic:message "A math:ArgumentSlot's math:slotIndex must be a non-negative integer." ;
    logic:integrity math:asnForall .
math:asnForall a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall math:asnImpl .
math:asnImpl a logic:Formula ; logic:antecedent math:asnGuard ; logic:consequent math:asnNoBad .
math:asnGuard a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:ArgumentSlot ] .
math:asnNoBad a logic:Formula ; logic:not math:asnBad .
math:asnBad a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "value" ] ; logic:exists math:asnBody .
math:asnBody a logic:Formula ; logic:and math:asnValue , math:asnNegative .
math:asnValue a logic:Formula ; logic:relation math:slotIndex ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "value" ] .
math:asnNegative a logic:Formula ; logic:relation logic:termLess ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] , [ logic:termIndex 1 ; logic:termLiteral "0" ; logic:termLiteralDatatype xsd:integer ] .

math:DerivativePositiveOrderConstraint
    a logic:Constraint ;
    gmeow:enforcesFailureClass math:UnderspecifiedDerivative ;
    logic:formalizes math:DerivativeShape ;
    logic:message "A math:Derivative's math:derivativeOrder must be a positive integer." ;
    logic:integrity math:dpoForall .
math:dpoForall a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall math:dpoImpl .
math:dpoImpl a logic:Formula ; logic:antecedent math:dpoGuard ; logic:consequent math:dpoNoBad .
math:dpoGuard a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:Derivative ] .
math:dpoNoBad a logic:Formula ; logic:not math:dpoBad .
math:dpoBad a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "value" ] ; logic:exists math:dpoBody .
math:dpoBody a logic:Formula ; logic:and math:dpoValue , math:dpoTooSmall .
math:dpoValue a logic:Formula ; logic:relation math:derivativeOrder ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "value" ] .
math:dpoTooSmall a logic:Formula ; logic:relation logic:termLess ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] , [ logic:termIndex 1 ; logic:termLiteral "1" ; logic:termLiteralDatatype xsd:integer ] .

math:ManifoldNonNegativeDimensionConstraint
    a logic:Constraint ;
    gmeow:enforcesFailureClass math:UnderspecifiedManifold ;
    logic:formalizes math:ManifoldShape ;
    logic:message "A math:Manifold's math:manifoldDimension must be a non-negative integer." ;
    logic:integrity math:mndForall .
math:mndForall a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall math:mndImpl .
math:mndImpl a logic:Formula ; logic:antecedent math:mndGuard ; logic:consequent math:mndNoBad .
math:mndGuard a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:Manifold ] .
math:mndNoBad a logic:Formula ; logic:not math:mndBad .
math:mndBad a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "value" ] ; logic:exists math:mndBody .
math:mndBody a logic:Formula ; logic:and math:mndValue , math:mndNegative .
math:mndValue a logic:Formula ; logic:relation math:manifoldDimension ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "value" ] .
math:mndNegative a logic:Formula ; logic:relation logic:termLess ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] , [ logic:termIndex 1 ; logic:termLiteral "0" ; logic:termLiteralDatatype xsd:integer ] .

# Total mass is either a non-negative literal or the named positive-infinity individual. The
# declarative class shape owns exact-one requiredness; this formula owns the disjunction.
math:MeasureMassDomainConstraint
    a logic:Constraint ;
    gmeow:enforcesFailureClass math:IncompleteMeasure ;
    logic:formalizes math:MeasureShape ;
    logic:message "A math:Measure's total mass must be a non-negative literal or math:PositiveInfinity." ;
    logic:integrity math:mmdForall .
math:mmdForall a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall math:mmdImpl .
math:mmdImpl a logic:Formula ; logic:antecedent math:mmdGuard ; logic:consequent math:mmdExists .
math:mmdGuard a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:Measure ] .
math:mmdExists a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "mass" ] ; logic:exists math:mmdBody .
math:mmdBody a logic:Formula ; logic:and math:mmdValue , math:mmdAllowed .
math:mmdValue a logic:Formula ; logic:relation math:totalMass ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "mass" ] .
math:mmdAllowed a logic:Formula ; logic:or math:mmdFinite , math:mmdInfinite .
math:mmdFinite a logic:Formula ; logic:and math:mmdLiteral , math:mmdNotNegative .
math:mmdLiteral a logic:Formula ; logic:relation logic:termIsLiteral ; logic:argument [ logic:termIndex 0 ; logic:termVariable "mass" ] .
math:mmdNotNegative a logic:Formula ; logic:not math:mmdNegative .
math:mmdNegative a logic:Formula ; logic:relation logic:termLess ; logic:argument [ logic:termIndex 0 ; logic:termVariable "mass" ] , [ logic:termIndex 1 ; logic:termLiteral "0" ; logic:termLiteralDatatype xsd:integer ] .
math:mmdInfinite a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "mass" ] , [ logic:termIndex 1 ; logic:termIri math:PositiveInfinity ] .

# The three claim carriers are object-valued. Their requiredness is already class-scoped; these
# canonical node-kind constraints preserve the legacy IRI discipline and typed failure identity.
math:ResidualVantageIriConstraint a logic:PathNodeKindConstraint ; logic:onClass math:ResidualInterpretationClaim ; logic:valuePath gmeow:vantage ; logic:nodeKind "IRI" ; logic:formalizes math:ResidualInterpretationClaimShape ; gmeow:enforcesFailureClass math:ResidualMeaningAsProperty .
math:ResidualFeatureIriConstraint a logic:PathNodeKindConstraint ; logic:onClass math:ResidualInterpretationClaim ; logic:valuePath gmeow:observedFeature ; logic:nodeKind "IRI" ; logic:formalizes math:ResidualInterpretationClaimShape ; gmeow:enforcesFailureClass math:ResidualMeaningAsProperty .
math:ResidualResultIriConstraint a logic:PathNodeKindConstraint ; logic:onClass math:ResidualInterpretationClaim ; logic:valuePath gmeow:observationResult ; logic:nodeKind "IRI" ; logic:formalizes math:ResidualInterpretationClaimShape ; gmeow:enforcesFailureClass math:ResidualMeaningAsProperty .

math:PersistenceDeathIriConstraint
    a logic:PathNodeKindConstraint ;
    logic:onClass math:PersistenceLifetime ;
    logic:valuePath math:diesAt ;
    logic:nodeKind "IRI" ;
    logic:formalizes math:PersistenceLifetimeShape ;
    gmeow:enforcesFailureClass math:UnderspecifiedPersistenceLifetime ;
    logic:message "A persistence lifetime must name its finite death threshold or math:PositiveInfinity by IRI." .

math:RationalValueDenominatorNonZeroConstraint
    a logic:ForbiddenPatternConstraint ;
    logic:onClass math:RationalValue ;
    logic:forbiddenPredicate math:denominator ;
    logic:forbiddenValue "0"^^xsd:integer ;
    logic:formalizes math:RationalValueShape ;
    gmeow:enforcesFailureClass math:ZeroDenominator ;
    logic:message "A math:RationalValue denominator must be a non-zero integer." .

