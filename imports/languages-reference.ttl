    gmeow:namePurpose gmeow:namePurposeEndonym ;
    gmeow:displayable true .

gmeow:appJapaneseExonym a gmeow:Appellation ;
    gmeow:fullName "Japanese"@x-gmeow-japanese ;
    gmeow:nameLanguage gmeow:langJapanese ;
    gmeow:namePurpose gmeow:namePurposeExonym ;
    gmeow:displayable true .

