#
# The corrected ClaimReview translation (#34): a claim with TWO competing
# assessments, a claim with one, and a claim with an ANONYMOUS assessment
# (no vantage). All three emit — one ClaimReview per Assessment, authored
# by its vantage WHEN one exists; the anonymous one passes through
# author-less (anonymous stays anonymous — attribution is never demanded).
# What never appears: a single aggregated rating on the claim itself (P9).
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://example.org/reviews/> .

ex:auditor-a a gmeow:SoftwareAgent ; gmeow:fullName "grounding auditor A" .
ex:auditor-b a gmeow:SoftwareAgent ; gmeow:fullName "grounding auditor B" .

ex:claim-disputed a gmeow:StandpointClaim ;
    gmeow:vantage ex:auditor-a .

ex:assessment-a1 a gmeow:Assessment ;
    gmeow:assessmentTarget ex:claim-disputed ;
    gmeow:vantage ex:auditor-a ;
    gmeow:assessmentScoreValue 0.9 .

ex:assessment-b1 a gmeow:Assessment ;
    gmeow:assessmentTarget ex:claim-disputed ;
    gmeow:vantage ex:auditor-b ;
    gmeow:assessmentScoreValue 0.2 .

ex:claim-single a gmeow:StandpointClaim ;
    gmeow:vantage ex:auditor-a .

ex:assessment-s1 a gmeow:Assessment ;
    gmeow:assessmentTarget ex:claim-single ;
    gmeow:vantage ex:auditor-b ;
    gmeow:assessmentScoreValue 0.75 .

# --- The anonymous aggregate: a score in the review set with no author.
ex:claim-anon a gmeow:StandpointClaim ;
    gmeow:vantage ex:auditor-a .

ex:assessment-anon a gmeow:Assessment ;
    gmeow:assessmentTarget ex:claim-anon ;
    gmeow:assessmentScoreValue 0.49 .
