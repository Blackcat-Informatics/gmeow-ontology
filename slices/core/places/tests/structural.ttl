    }
    ?banned a ?t .
}""" ;
    gmeow:saRationale "No preferred*/primary* capacity/occupancy/utilization selectors MUST NOT exist (Principle 9, co-equality). Mirrors test_no_preferred_or_primary_capacity_term." .

# --- 66. VirtualLocationType subclasses logic:QualityValue (MUST) --------------
ex:saVirtualLocationTypeIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
