gmeow:CueMatchSuppressionConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "applicable suppression declaration"@x-gmeow-english ;
    skos:definition "Every supplied matchSuppressedBy rule is declared in the matched cue's negatedBy set."@x-gmeow-english ;
    gmeow:useWhen "Use to check applicable suppression declaration on the retained CueMatch record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a satisfied record law as executed detection, correct suppression, authenticated source text or external inventory completeness."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the supplied record and retain source evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "Declared applicability does not prove the existence, span or scope of a negating occurrence. Retain that evidence on the suppression assertion or its reifier."@x-gmeow-english ;
    skos:example "gmeow:CueMatchSuppressionConstraint logic:formalizes gmeow:matchSuppressedBy . names the supplied-record law."@x-gmeow-english ;
    logic:formalizes gmeow:matchSuppressedBy ;
