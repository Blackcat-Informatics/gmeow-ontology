    VALUES ?banned {
        gmeow:primaryVirtualLocationType gmeow:preferredVirtualLocationType
        gmeow:primaryNetworkAddress gmeow:preferredNetworkAddress
        gmeow:primaryNetworkAddressType gmeow:preferredNetworkAddressType
    }
    VALUES ?t {
        owl:ObjectProperty owl:DatatypeProperty
        owl:AnnotationProperty owl:Class
    }
    ?banned a ?t .
}""" ;
    gmeow:saRationale "No preferred*/primary* virtual-location selectors MUST NOT exist (Principle 9)." .

