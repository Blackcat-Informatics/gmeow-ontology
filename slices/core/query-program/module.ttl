gmeow:QueryOrderDirectionLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query order direction law"@x-gmeow-english ;
    skos:definition "The selected policy profile validates ascending content-tier and subject-tie directions, and descending fused-score and activation directions. Every direction remains explicitly declared as typed boolean data."@x-gmeow-english ;
    gmeow:useWhen "Use to reject a supplied direction that disagrees with its selected key kind’s admitted source-standard direction."@x-gmeow-english ;
