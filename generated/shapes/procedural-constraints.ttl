        sh:severity sh:Violation ;
        sh:message "A projection's container and manifest profile surfaces must record the same model-contract digest (gmeow:recordsModelContractDigest) — disagreement is a hard fail." ;
        sh:select """SELECT $this WHERE { ?sc <https://blackcatinformatics.ca/gmeow/profileSurfaceOf> $this . ?sc <https://blackcatinformatics.ca/gmeow/profileSurfaceKind> <https://blackcatinformatics.ca/gmeow/surfaceContainer> . ?sm <https://blackcatinformatics.ca/gmeow/profileSurfaceOf> $this . ?sm <https://blackcatinformatics.ca/gmeow/profileSurfaceKind> <https://blackcatinformatics.ca/gmeow/surfaceManifest> . ?sc <https://blackcatinformatics.ca/gmeow/recordsModelContractDigest> ?x . ?sm <https://blackcatinformatics.ca/gmeow/recordsModelContractDigest> ?y . FILTER ( ?x != ?y ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ProfileOpenValueUseConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ProfileOpenValueUseShape> ;
