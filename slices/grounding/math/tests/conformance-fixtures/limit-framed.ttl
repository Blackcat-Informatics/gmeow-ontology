#
# Well-formed: a limit naming its expression and its limit point (mode optional) —
# and, as a math:BindingExpression, the math:VariableDeclaration it binds and its
# body through an indexed math:argumentSlot. Conforms to math:LimitShape and
# math:BindingExpressionShape. Bound by ex:ecLimitFramed.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:sincLimit a math:Limit ;
    math:operator math:limitBinder ;
    math:limitOf ex:sincExpr ;
    math:limitPoint ex:zeroPoint ;
    math:limitMode math:limitTwoSided ;
    math:boundVariable ex:limitVarDecl ;
    math:argumentSlot ex:sincLimitSlot0 .

ex:sincLimitSlot0 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression ex:sincExpr .

ex:limitVarDecl a math:VariableDeclaration .
# sinc is named, not decomposed: a math:SymbolReference resolving to a SYMBOL is the concrete
# form for that. The abstract math:MathematicalExpression base names no form and carries no
# structural identity (math:UnrecognizedExpressionType).
ex:sincExpr a math:SymbolReference ; math:hasMathematicalSymbol ex:sincSymbol .
ex:sincSymbol a math:MathematicalSymbol .
ex:zeroPoint a math:MathematicalObject .
