@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/expertise>
    a gmeow:Slice ;
    rdfs:label "expertise"@x-gmeow-english ;
    skos:definition "The expertise slice of the GMEOW ontology (core tier): GMEOW Expertise Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/expertise> ;
    dcterms:title "GMEOW Expertise Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/entities> ,
        <https://blackcatinformatics.ca/gmeow/slices/organization> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ,
        <https://blackcatinformatics.ca/gmeow/slices/attestation> ;
    gmeow:sliceConsumer "Cross-cutting proficiency claims (promoted core, slice-dependency doctrine): skills, credentials, language proficiency."@x-gmeow-english.
