+/// Find the byte offset of the next run of exactly `run` backticks.
+fn find_backtick_run(bytes: &[u8], run: usize) -> Option<usize> {
+    let mut i = 0usize;
+    while i < bytes.len() {
+        if bytes[i] == b'`' {
+            let here = bytes[i..].iter().take_while(|&&b| b == b'`').count();
+            if here == run {
+                return Some(i);
+            }
+            i += here;
+        } else {
+            i += 1;
+        }
+    }
+    None
+}
