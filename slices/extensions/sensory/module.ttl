@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/sensory>
    a owl:Ontology ;
    rdfs:label "GMEOW Sensory Module"@x-gmeow-english ;
    skos:definition "The GMEOW Sensory Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> ;
    rdfs:comment "Sensor, sensor platform, observable property, and sensory observation stack. Deepens the SensoryObservation stub from observations.ttl with sensor-specific properties and bridges to SOSA/SSN by reference."@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# SENSOR — the observer/perceiver in the sensory domain (sensory slice)
#
# A sensor is an agent that produces observations. It may be a physical device,
# a software process, or a biological perceiver. The existing gmeow:Agent →
# sosa:Sensor broadMatch alignment becomes precise here: a Sensor is a more
# specific kind of Agent that acts as vantage in a SensoryObservation.
# =========================================================================== #

gmeow:Sensor
    a owl:Class, gufo:RoleMixin ;
    rdfs:subClassOf gmeow:Agent, gufo:FunctionalComplex ;
    rdfs:label "Sensor"@x-gmeow-english ;
    skos:definition "An agent that produces observations by responding to a stimulus — a physical device, a software process, or a biological perceiver. The observer in a sensory observation; the vantage of a SensoryObservation may be a Sensor, a person, or an organization. Co-equal: no sensor is privileged as the 'primary' observer (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

# =========================================================================== #
# SENSOR PLATFORM — the physical carrier of sensors (sensory slice)
#
# A platform hosts one or more sensors and is situated at a geographic place.
# Distinct from Sensor (which is the observing agent) and from Place (which is
# the location). Aligns to sosa:Platform by reference.
# =========================================================================== #

gmeow:SensorPlatform
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Sensor Platform"@x-gmeow-english ;
    skos:definition "A physical entity that hosts one or more sensors — a weather station, a satellite, a buoy, a drone, a vehicle, or a building-mounted instrument. The platform is situated at a place and carries sensors that observe properties of the environment. Distinct from the Sensor itself (the observing agent) and from the Place (the location)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

gmeow:platformLocation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:SensorPlatform ;
    rdfs:range gmeow:Place ;
    rdfs:label "platform location"@x-gmeow-english ;
    skos:definition "The geographic place where a sensor platform is situated. A platform typically has one location at a time; historical locations are modelled as past SensoryObservations or LocationStates, not by changing this property (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

# =========================================================================== #
# OBSERVABLE PROPERTY — what is being measured (sensory slice)
#
# A value vocabulary (individuals, never subclasses) of physical, chemical,
# biological, or environmental properties that can be observed by a sensor.
# Aligns to sosa:ObservableProperty by reference.
# =========================================================================== #

gmeow:ObservableProperty
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Observable Property"@x-gmeow-english ;
    skos:definition "A physical, chemical, biological, or environmental property that can be observed or measured by a sensor. A value vocabulary (individuals, never subclasses) so any new property — from temperature to neural activation to social sentiment — is a new individual, not a new class (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

# Seeds — common environmental and physical observable properties.
gmeow:observablePropertyTemperature           a gmeow:ObservableProperty ; rdfs:label "temperature"@x-gmeow-english ;           rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyTemperature skos:definition "The temperature observable property — a physical or environmental quantity that can be measured by a sensor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyHumidity              a gmeow:ObservableProperty ; rdfs:label "humidity"@x-gmeow-english ;              rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyHumidity skos:definition "The humidity observable property — a physical or environmental quantity that can be measured by a sensor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyLightIntensity        a gmeow:ObservableProperty ; rdfs:label "light intensity"@x-gmeow-english ;        rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyLightIntensity skos:definition "The light intensity observable property — a physical or environmental quantity that can be measured by a sensor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertySoundPressureLevel    a gmeow:ObservableProperty ; rdfs:label "sound pressure level"@x-gmeow-english ;    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertySoundPressureLevel skos:definition "The sound pressure level observable property — a physical or environmental quantity that can be measured by a sensor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyAtmosphericPressure   a gmeow:ObservableProperty ; rdfs:label "atmospheric pressure"@x-gmeow-english ;   rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyAtmosphericPressure skos:definition "The atmospheric pressure observable property — a physical or environmental quantity that can be measured by a sensor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyAirQualityIndex       a gmeow:ObservableProperty ; rdfs:label "air quality index"@x-gmeow-english ;       rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyAirQualityIndex skos:definition "The air quality index observable property — a physical or environmental quantity that can be measured by a sensor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyRadiationLevel        a gmeow:ObservableProperty ; rdfs:label "radiation level"@x-gmeow-english ;         rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

# =========================================================================== #
# SENSORY QUANTITY — the result of a sensory observation (sensory slice)
#
# A domain-specific alias for the existing scalar-quantity facility. Following
# the ScalarQuantity alias precedent precedent (Quantity ≡ ScalarQuantity ≡ MeasuredValue), SensoryQuantity
# is the sensory-domain name for the same value×unit×determinacy bundle.
# =========================================================================== #
gmeow:observablePropertyRadiationLevel skos:definition "The radiation level observable property — a physical or environmental quantity that can be measured by a sensor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

# Seeds — musical / auditory observable properties (issue #317)
gmeow:observablePropertyTimbre                a gmeow:ObservableProperty ; rdfs:label "timbre"@x-gmeow-english ;                rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyTimbre skos:definition "The timbre observable property — the perceived tonal quality of a sound (bright, dark, breathy, gritty, hollow, ...) that can be observed by a human listener or measured by an audio feature extractor."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

gmeow:observablePropertyLoudness              a gmeow:ObservableProperty ; rdfs:label "loudness"@x-gmeow-english ;              rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyLoudness skos:definition "The loudness observable property — the perceived intensity of a sound that can be observed by a listener or measured by a level meter."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

gmeow:observablePropertyRoughness             a gmeow:ObservableProperty ; rdfs:label "roughness"@x-gmeow-english ;             rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyRoughness skos:definition "The roughness observable property — the perceived sensory dissonance or rapid amplitude modulation of a sound that can be observed or measured."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

gmeow:observablePropertyTimingDeviation       a gmeow:ObservableProperty ; rdfs:label "timing deviation"@x-gmeow-english ;      rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .
gmeow:observablePropertyTimingDeviation skos:definition "The timing deviation observable property — the expressive or erroneous offset of an onset from a reference time grid, observable by a listener or measurable from an onset detection function."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

gmeow:SensoryQuantity
    a owl:Class, gufo:Kind ;
    owl:equivalentClass gmeow:ScalarQuantity ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Sensory Quantity"@x-gmeow-english ;
    skos:definition "The scalar numeric result of a sensory observation — a value with unit, determinacy, and granularity. Equivalent to gmeow:ScalarQuantity (following the ScalarQuantity alias precedent); the name 'SensoryQuantity' is the domain-specific label for the same construct in the sensor/observation stack."@x-gmeow-english;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

# =========================================================================== #
# SENSORY OBSERVATION — deepen the observations.ttl stub (sensory slice)
#
# The stub in observations.ttl declares SensoryObservation as a SubKind of
# Observation. Here we add sensor-specific properties and EL restrictions.
# =========================================================================== #

# Domain-specific property: the observable property being measured.
gmeow:sensoryProperty
    a owl:ObjectProperty ;
    rdfs:domain gmeow:SensoryObservation ;
    rdfs:range gmeow:ObservableProperty ;
    rdfs:label "sensory property"@x-gmeow-english ;
    skos:definition "The observable property that a sensory observation measures — temperature, humidity, light intensity, etc. Distinct from gmeow:observationMethod (the procedure or protocol used); this names the property itself. A sensory observation concerns exactly one observable property per observation; multiple properties require multiple observations (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

# Domain-specific subproperty of observationResult for the sensory result.
gmeow:sensoryResult
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:observationResult ;
    rdfs:domain gmeow:SensoryObservation ;
    rdfs:range gmeow:SensoryQuantity ;
    rdfs:label "sensory result"@x-gmeow-english ;
    skos:definition "The scalar quantity result of a sensory observation — a value with unit, determinacy, and granularity. Subproperty of gmeow:observationResult so generic consumers can query all observation results without knowing the domain. The reference frame in which the quantity is expressed is carried on the observation via gmeow:hasReferenceFrame and propagates to the result via the existing isResultOf ∘ hasReferenceFrame chain."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

# Domain-specific subproperty of observedFeature for the entity being observed.
gmeow:sensoryObservationOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:observedFeature ;
    rdfs:domain gmeow:SensoryObservation ;
    rdfs:range gmeow:Entity ;
    rdfs:label "sensory observation of"@x-gmeow-english ;
    skos:definition "The entity whose property is being observed — the observedFeature of a sensory observation. Subproperty of gmeow:observedFeature so generic consumers can query all observations without knowing the domain."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

gmeow:hasSensoryObservation
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:sensoryObservationOf ;
    rdfs:domain gmeow:Entity ;
    rdfs:range gmeow:SensoryObservation ;
    rdfs:label "has sensory observation"@x-gmeow-english ;
    skos:definition "Links an entity to a sensory observation that measured one of its properties. Non-functional: multiple sensors may observe the same property of the same entity, and those readings coexist without collapse (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

# EL axiomatisation: every SensoryObservation mediates at least one vantage,
# one observed feature, one observable property, and one result.
gmeow:SensoryObservation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:vantage           ; owl:someValuesFrom gmeow:Agent             ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:sensoryObservationOf ; owl:someValuesFrom gmeow:Entity          ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:sensoryProperty   ; owl:someValuesFrom gmeow:ObservableProperty ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:sensoryResult     ; owl:someValuesFrom gmeow:SensoryQuantity     ] .

# =========================================================================== #
# AXIOMATIZED DOCTRINE (sensory slice) — property chain for flat shortcut
#
# hasSensoryQuantity is a flat shortcut derived from the reified observation
# path. Expressed as:
#   hasSensoryObservation ∘ sensoryResult ⊑ hasSensoryQuantity
#
# This is OWL 2 DL regular because sensoryResult is a simple property (no
# transitivity, symmetry, or inverse), and the chain is the regular R ∘ S ⊑ T
# form. hasSensoryQuantity thereby becomes non-simple and is kept out of all
# cardinality axioms.
# =========================================================================== #

gmeow:hasSensoryQuantity
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:range gmeow:SensoryQuantity ;
    rdfs:label "has sensory quantity"@x-gmeow-english ;
    skos:definition "Flat shortcut linking an entity to the scalar quantity result of a sensory observation of its property. Derived via property chain from the reified observation path (hasSensoryObservation ∘ sensoryResult). Non-simple: kept out of cardinality axioms."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sensory> .

gmeow:hasSensoryQuantity owl:propertyChainAxiom ( gmeow:hasSensoryObservation gmeow:sensoryResult ) .

# --------------------------------------------------------------------------- #
# Graph box role coverage (canonical explicit annotations).
# --------------------------------------------------------------------------- #

gmeow:ObservableProperty gmeow:graphBoxRole gmeow:boxTBox .
gmeow:Sensor gmeow:graphBoxRole gmeow:boxTBox .
gmeow:SensorPlatform gmeow:graphBoxRole gmeow:boxTBox .
gmeow:SensoryQuantity gmeow:graphBoxRole gmeow:boxTBox .
gmeow:hasSensoryObservation gmeow:graphBoxRole gmeow:boxRBox .
gmeow:hasSensoryQuantity gmeow:graphBoxRole gmeow:boxRBox .
gmeow:observablePropertyAirQualityIndex gmeow:graphBoxRole gmeow:boxABox .
gmeow:observablePropertyAtmosphericPressure gmeow:graphBoxRole gmeow:boxABox .
gmeow:observablePropertyHumidity gmeow:graphBoxRole gmeow:boxABox .
gmeow:observablePropertyLightIntensity gmeow:graphBoxRole gmeow:boxABox .
gmeow:observablePropertyLoudness gmeow:graphBoxRole gmeow:boxABox .
gmeow:observablePropertyRadiationLevel gmeow:graphBoxRole gmeow:boxABox .
gmeow:observablePropertyRoughness gmeow:graphBoxRole gmeow:boxABox .
gmeow:observablePropertySoundPressureLevel gmeow:graphBoxRole gmeow:boxABox .
gmeow:observablePropertyTemperature gmeow:graphBoxRole gmeow:boxABox .
gmeow:observablePropertyTimbre gmeow:graphBoxRole gmeow:boxABox .
gmeow:observablePropertyTimingDeviation gmeow:graphBoxRole gmeow:boxABox .
gmeow:platformLocation gmeow:graphBoxRole gmeow:boxRBox .
gmeow:sensoryObservationOf gmeow:graphBoxRole gmeow:boxRBox .
gmeow:sensoryProperty gmeow:graphBoxRole gmeow:boxRBox .
gmeow:sensoryResult gmeow:graphBoxRole gmeow:boxRBox .
<https://blackcatinformatics.ca/gmeow/slices/sensory> gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxTBox .
