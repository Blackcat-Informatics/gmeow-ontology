    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

# --------------------------------------------------------------------------- #
# CIDOC-CRM — creation events
# --------------------------------------------------------------------------- #

gmeow:eqCw018 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventTypeWorkConception ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject crm:E65_Creation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "CIDOC E65 Creation is broader than work conception." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

# --------------------------------------------------------------------------- #
# BIBFRAME 2.0 — Library of Congress
# --------------------------------------------------------------------------- #

gmeow:eqCw019 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Work ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject bibframe:Work ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Lossy: BIBFRAME conflates Work+Expression by design." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw020 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Manifestation ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject bibframe:Instance ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "BIBFRAME Instance ≈ FRBR Manifestation." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw021 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Item ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject bibframe:Item ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "BIBFRAME Item ≈ FRBR Item." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

# --------------------------------------------------------------------------- #
# schema.org — lossy projection layer
# --------------------------------------------------------------------------- #

gmeow:eqCw022 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:CreativeWork ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:CreativeWork ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Lossy: schema.org collapses WEMI into one flat node." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw023 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Work ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:CreativeWork ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Lossy: schema.org has no Work/Expression distinction." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw024 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:BookRelease ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:Book ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema:Book is broader (may denote abstract work); BookRelease is concrete." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw025 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:MediaObject ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:MediaObject ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Direct correspondence." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

gmeow:eqCw026 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:WebPage ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject schema:WebPage ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "Direct correspondence." ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" .

