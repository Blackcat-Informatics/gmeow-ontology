#
# Shared competency fixture for the analysis-and-geometry charter. The five
# competency queries in queries/competency/ run over the mathematics module
# unioned with this fixture and pin their rows exactly (logic:RowsExact). Every
# individual is in the http://example.org/math/ namespace so the queries scope to
# the fixture, and each is well-formed against the slice shapes.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix exf:  <http://example.org/math/> .

# --- Q1: a derivative differentiates an expression, w.r.t. a variable, at an order
exf:dPositionDt a math:Derivative ;
    math:operator math:differentiationBinder ;
    math:derivativeOf exf:positionExpr ;
    math:withRespectToVariable exf:tVar ;
    math:derivativeOrder 1 ;
    math:boundVariable exf:tVar ;
    math:argumentSlot exf:dPositionDtSlot0 .

exf:dPositionDtSlot0 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression exf:positionExpr .

# Named, not decomposed: a math:SymbolReference resolving to a SYMBOL is the concrete form for
# that. The abstract math:MathematicalExpression base names no form at all
# (math:UnrecognizedExpressionType).
exf:positionExpr a math:SymbolReference ; math:hasMathematicalSymbol exf:positionSymbol .
exf:positionSymbol a math:MathematicalSymbol .
exf:tVar a math:VariableDeclaration .

# --- Q2: a series converges to a value in a declared mode
exf:geometricSeries a math:Series ;
    math:operator math:summationBinder ;
    math:seriesTerm exf:geometricTerm ;
    math:boundVariable exf:nVar ;
    math:argumentSlot exf:geometricSeriesSlot0 ;
    math:hasConvergence exf:geometricConvergence .

exf:geometricSeriesSlot0 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression exf:geometricTerm .

exf:geometricTerm a math:SymbolReference ; math:hasMathematicalSymbol exf:geometricTermSymbol .
exf:geometricTermSymbol a math:MathematicalSymbol .
exf:nVar a math:VariableDeclaration .

exf:geometricConvergence a math:Convergence ;
    math:convergesTo exf:seriesLimit ;
    math:convergenceMode math:absoluteConvergence .

exf:seriesLimit a math:MathematicalObject .

# --- Q3: a connected space, its open sets, and its declared connectedness
exf:circleSpace a math:ConnectedSpace ;
    math:isConnected true ;
    math:hasOpenSet exf:arcU , exf:arcV .

exf:arcU a math:OpenSet .
exf:arcV a math:OpenSet .

# --- Q4: a Lorentzian manifold declares dimension + structure kind + charts
exf:minkowski a math:LorentzianManifold ;
    math:manifoldDimension 4 ;
    math:manifoldStructureKind math:lorentzianStructure ;
    math:hasChart exf:inertialChart ;
    math:metricTensor exf:minkowskiMetric .

exf:inertialChart a math:Chart ;
    math:chartDomain exf:inertialRegion ;
    math:coordinateMap exf:inertialCoordinateFn ;
    math:targetCoordinateSpace exf:r4 .

exf:inertialRegion a math:OpenSet .

exf:inertialCoordinateFn a math:CoordinateMap ;
    math:domain exf:inertialRegion ;
    math:codomain exf:r4 .

exf:r4 a math:Set ;
    math:spaceDimension 4 .

exf:minkowskiMetric a math:MetricTensor ;
    math:tensorFieldOn exf:minkowski ;
    math:metricSignature exf:lorentzSignature .

exf:lorentzSignature a math:MetricSignature ;
    math:signaturePositive 3 ;
    math:signatureNegative 1 .

# --- Q5: a complement names its ambient space and its complement-semantics
exf:evenComplement a math:Complement ;
    math:setOperationOn exf:evensSet ;
    math:ambientSpace exf:naturalsSet ;
    math:complementSemantics math:setTheoreticComplement .

exf:evensSet a math:Set .
exf:naturalsSet a math:Set .

# --- Q6: a limit carries a structured result naming its outcome and value
# Two pole-divergent limits: the Lorentz factor γ = 1/√(1−v²/c²) → +∞ as v → c,
# and a runaway cooling difference → −∞. Each math:LimitResult names its
# math:limitOutcome and carries the matching signed extended-real pole as its
# math:limitResultValue.
exf:gammaBlowupLimit a math:Limit ;
    math:operator math:limitBinder ;
    math:limitOf exf:gammaExpr ;
    math:limitPoint exf:lightSpeed ;
    math:limitMode math:limitFromLeft ;
    math:boundVariable exf:vVar ;
    math:argumentSlot exf:gammaBlowupSlot0 ;
    math:hasLimitResult exf:gammaBlowupResult .

exf:gammaBlowupSlot0 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression exf:gammaExpr .

exf:gammaExpr a math:SymbolReference ; math:hasMathematicalSymbol exf:gammaSymbol .
exf:gammaSymbol a math:MathematicalSymbol .
exf:lightSpeed a math:MathematicalObject .
exf:vVar a math:VariableDeclaration .

exf:gammaBlowupResult a math:LimitResult ;
    math:limitOutcome math:divergesToPositiveInfinity ;
    math:limitResultValue math:PositiveInfinity .

exf:coolingLimit a math:Limit ;
    math:operator math:limitBinder ;
    math:limitOf exf:coolingExpr ;
    math:limitPoint exf:runawayPoint ;
    math:limitMode math:limitTwoSided ;
    math:boundVariable exf:tempVar ;
    math:argumentSlot exf:coolingSlot0 ;
    math:hasLimitResult exf:coolingResult .

exf:coolingSlot0 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression exf:coolingExpr .

exf:coolingExpr a math:SymbolReference ; math:hasMathematicalSymbol exf:coolingSymbol .
exf:coolingSymbol a math:MathematicalSymbol .
exf:runawayPoint a math:MathematicalObject .
exf:tempVar a math:VariableDeclaration .

exf:coolingResult a math:LimitResult ;
    math:limitOutcome math:divergesToNegativeInfinity ;
    math:limitResultValue math:NegativeInfinity .

# --- Q7: a conformal compactification names its four roles + conformal factor
# The unbounded radial half-line r ∈ [0, ∞) conformally compactified to the bounded
# interval ρ ∈ [0, 1] by ρ = r/(1+r) (Ω = 1/(1+r)), adjoining the ideal point r = +∞.
exf:radialCompactification a math:ConformalCompactification ;
    math:originalSpace exf:radialHalfLine ;
    math:compactifyingMap exf:radialCompactifyingMap ;
    math:compactifiedSpace exf:compactifiedRadialInterval ;
    math:boundaryAtInfinity exf:radialIdealBoundary ;
    math:conformalFactor exf:radialConformalFactor .

exf:radialHalfLine a math:TopologicalSpace .

exf:radialCompactifyingMap a math:CoordinateMap ;
    math:domain exf:radialHalfLine ;
    math:codomain exf:compactifiedRadialInterval .

exf:compactifiedRadialInterval a math:Interval ;
    math:lowerEndpoint "0.0"^^xsd:double ;
    math:upperEndpoint "1.0"^^xsd:double ;
    math:lowerInclusion math:closedEndpoint ;
    math:upperInclusion math:closedEndpoint .

exf:radialIdealBoundary a math:BoundaryAtInfinity .

exf:radialConformalFactor a math:Function ;
    math:domain exf:radialHalfLine ;
    math:codomain exf:positiveReals .

exf:positiveReals a math:Set .
