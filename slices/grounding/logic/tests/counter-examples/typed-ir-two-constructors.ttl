@prefix ex: <https://blackcatinformatics.ca/gmeow/examples/logic/tests/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .

# The focus selects both the atomic and strong-negation constructor families.
ex:twoConstructors
    a logic:Formula ;
    logic:not ex:validChild ;
    logic:relation ex:predicate .

ex:validChild
    a logic:Formula ;
    logic:relation ex:childPredicate .
