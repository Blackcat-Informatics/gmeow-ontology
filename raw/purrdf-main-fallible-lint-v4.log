     ] ;
     logic:body [
-        rdf:subject   "?x" ;
-        rdf:predicate gmeow:gmnRingLevel ;
-        rdf:object    "?lx"
+        rdf:reifies <<( _:gmeow_ruleGmnRingWithinDerive_x gmeow:gmnRingLevel _:gmeow_ruleGmnRingWithinDerive_lx )>>
     ] , [
-        rdf:subject   "?y" ;
-        rdf:predicate gmeow:gmnRingLevel ;
-        rdf:object    "?ly"
+        rdf:reifies <<( _:gmeow_ruleGmnRingWithinDerive_y gmeow:gmnRingLevel _:gmeow_ruleGmnRingWithinDerive_ly )>>
     ] , [
-        rdf:subject   "?lx" ;
-        rdf:predicate gmeow:gmnRingLevelDominates ;
-        rdf:object    "?ly"
+        rdf:reifies <<( _:gmeow_ruleGmnRingWithinDerive_lx gmeow:gmnRingLevelDominates _:gmeow_ruleGmnRingWithinDerive_ly )>>
     ] ;
     logic:negatedBody [
-        rdf:subject   "?x" ;
-        rdf:predicate gmeow:gmnRingCompartmentGap ;
-        rdf:object    "?y"
+        rdf:reifies <<( _:gmeow_ruleGmnRingWithinDerive_x gmeow:gmnRingCompartmentGap _:gmeow_ruleGmnRingWithinDerive_y )>>
     ] .
 
 # --- GMN dialect individuals (the three-level dialect stack + its apparatus) -- #
