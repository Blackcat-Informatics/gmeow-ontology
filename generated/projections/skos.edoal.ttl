@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/skos>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:Tag ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri skos:Concept ;
        ] ;
        align:relation "=" ;
        rdfs:label "Tag → skos:Concept (prefLabel, broader, inScheme)"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:TagScheme ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri skos:ConceptScheme ;
            ] ;
            align:relation "=" ;
            rdfs:label "TagScheme → skos:ConceptScheme"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "skos" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → skos (EDOAL)"@en .
