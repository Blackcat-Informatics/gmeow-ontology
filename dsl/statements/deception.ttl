# =============================================================================
# Disinformation campaign exemplar — issue #217.
# A 3-hop propagation chain demonstrating the per-node misinfo↔disinfo boundary.
#
#   Hop 0 (origin): Deceiver seeds a false claim — held ≠ projected + intent.
#                   Label: DISINFORMATION at this node.
#   Hop 1 (dupe):  Sincere believer reshares — held ≈ projected, untrue, no intent.
#                   Label: MISINFORMATION at this node.
#   Hop 2 (downstream): Another sincere resharing — held ≈ projected, untrue, no intent.
#                   Label: MISINFORMATION at this node.
#
# The boundary is local to each hop, not a global label on the chain.
# =============================================================================

# 18. DISINFORMATION CAMPAIGN — the campaign event itself.
ex:claim-event-disinformation-001 a gmeow:StatementMetadata ;
    rdfs:label "Disinformation campaign event — coordinated propagated deception"@x-gmeow-english ;
    gmeow:reifier    ex:claim-event-disinformation-001 ;
    gmeow:qSubject   ex:event-disinformation-001 ;
    gmeow:qPredicate gmeow:eventType ;
    gmeow:qObject    gmeow:eventTypeDisinformation ;
    gmeow:annotation
        [ gmeow:annProperty gmeow:confidence ; gmeow:annValue 0.9 ] ,
        [ gmeow:annProperty gmeow:assertedAt ; gmeow:annValue "2026-06-11T00:00:00Z"^^xsd:dateTime ] ,
        [ gmeow:annProperty gmeow:accordingTo  ; gmeow:annValue ex:standpoint-investigator ] .

