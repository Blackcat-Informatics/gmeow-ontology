            [ gmeow:subjectVar "affPerson" ; gmeow:predicate gmeow:memberOf ; gmeow:objectVar "affOrg" ] ) ;
        gmeow:edoalSource gmeow:memberOf ] ;
    gmeow:hasBinding [
