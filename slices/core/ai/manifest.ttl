<https://blackcatinformatics.ca/gmeow/slices/ai>
    a gmeow:Slice ;
    rdfs:label "ai"@x-gmeow-english ;
    skos:definition "The ai slice of the GMEOW ontology (core tier): GMEOW AI Claim Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    dcterms:title "GMEOW AI Claim Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
