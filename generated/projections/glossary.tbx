      <termEntry id="c-b0a5bfd288ac2f19">
        <langSet xml:lang="en">
          <tig>
            <term>dict-v3 entry: logic:and to and</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>entrée dict-v3 : logic:and vers and</term>
