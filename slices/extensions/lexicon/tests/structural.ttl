#
# Declarative structural assertions for the lexicon slice — the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_lexicon.py. Each assertion runs as a
# SPARQL ASK over the lexicon module graph (gmeow:scopeModule) under the
# native Rust harness (crates/slicetest).
#
# Lexicon is migrated, so class stereotypes are logic:
# (logic:Kind, logic:SubKind, logic:AbstractIndividualType, logic:QualityValue),
# not gufo:.
#
# All subjects tested below are defined in slices/extensions/lexicon/module.ttl;
# no cross-slice subjects are tested here.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/lexicon/tests/> .

# --- 1. LexicalItem is a subclass of InformationObject (MUST) -----------------
ex:saLexicalItemIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:LexicalItem rdfs:subClassOf gmeow:InformationObject . }""" ;
    gmeow:saRationale "gmeow:LexicalItem MUST be a subclass of gmeow:InformationObject — the abstract lexeme is a first-class information object." .

# --- 2. LexicalForm is a subclass of InformationObject (MUST) -----------------
ex:saLexicalFormIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:LexicalForm rdfs:subClassOf gmeow:InformationObject . }""" ;
    gmeow:saRationale "gmeow:LexicalForm MUST be a subclass of gmeow:InformationObject — a concrete lexical form is a first-class information object." .

# --- 3a. hasLexicalForm is an ObjectProperty (MUST) ---------------------------
ex:saHasLexicalFormIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasLexicalForm a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:hasLexicalForm MUST be an owl:ObjectProperty — it links LexicalItem to its concrete LexicalForm instances." .

# --- 3b. hasLexicalForm is NOT functional (MUST-NOT) -------------------------
ex:saHasLexicalFormNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:hasLexicalForm ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:hasLexicalForm MUST NOT be functional — a single lexical item may have many coexisting forms (written, spoken, reconstructed, etc.) (Principle 9)." .

# --- 6a. formType is an ObjectProperty (MUST) ---------------------------------
ex:saFormTypeIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:formType a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:formType MUST be an owl:ObjectProperty — it links a LexicalForm to its LexicalFormType value(s)." .

# --- 6b. formType is NOT functional (MUST-NOT) --------------------------------
ex:saFormTypeNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:formType ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:formType MUST NOT be functional — a single form may be classified as both spoken and written under different standpoints (Principle 9)." .

# --- 7. UsageAttestation is an owl:Class, subclass of Observation and logic:Relator (MUST) ---
ex:saUsageAttestationIsObservationRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:UsageAttestation a owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:UsageAttestation MUST be an owl:Class, a subclass of gmeow:Observation, and a subclass of logic:Relator — attestations are evidence nodes that follow the Observation+Relator pattern (Principle 12)." .

# --- 9. EtymologicalDerivation is an owl:Class, subclass of Observation and logic:Relator (MUST) ---
ex:saEtymologicalDerivationIsObservationRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:EtymologicalDerivation a owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:EtymologicalDerivation MUST be an owl:Class, a subclass of gmeow:Observation, and a subclass of logic:Relator — etymology is modeled as a provenance-rich standpointed claim graph, not a flat property (Principle 9)." .

# --- 11a. derivationKind is an ObjectProperty (MUST) -------------------------
ex:saDerivationKindIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:derivationKind a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:derivationKind MUST be an owl:ObjectProperty — it links an EtymologicalDerivation to its DerivationKind value(s)." .

# --- 11b. derivationKind is NOT functional (MUST-NOT) ------------------------
ex:saDerivationKindNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:derivationKind ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:derivationKind MUST NOT be functional — a single derivation may be classified under multiple kinds by different analytical standpoints (Principle 9)." .

# --- 12a. LexicalFormType is a value-vocabulary subclass of logic:QualityValue (MUST) ---
ex:saLexicalFormTypeIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:LexicalFormType rdfs:subClassOf logic:QualityValue . }""" ;
    gmeow:saRationale "gmeow:LexicalFormType MUST be a subclass of logic:QualityValue — form types are an open individuals-based value vocabulary, never subclasses (Principle 9)." .

# --- 12b. The four seeded LexicalFormType individuals exist (MUST) ------------
ex:saLexicalFormTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:formWritten        a gmeow:LexicalFormType .
    gmeow:formSpoken         a gmeow:LexicalFormType .
    gmeow:formReconstructed  a gmeow:LexicalFormType .
    gmeow:formTransliterated a gmeow:LexicalFormType .
}""" ;
    gmeow:saRationale "gmeow:formWritten, gmeow:formSpoken, gmeow:formReconstructed, and gmeow:formTransliterated MUST all exist as gmeow:LexicalFormType individuals — the four canonical seed values of the original vocabulary." .

# --- 13a. DerivationKind is a value-vocabulary subclass of logic:QualityValue (MUST) ---
ex:saDerivationKindIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:DerivationKind rdfs:subClassOf logic:QualityValue . }""" ;
    gmeow:saRationale "gmeow:DerivationKind MUST be a subclass of logic:QualityValue — derivation kinds are an open individuals-based value vocabulary, never subclasses (Principle 9)." .

# --- 13b. The four seeded DerivationKind individuals exist (MUST) -------------
ex:saDerivationKindSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:derivationBorrowing     a gmeow:DerivationKind .
    gmeow:derivationSemanticShift a gmeow:DerivationKind .
    gmeow:derivationCompounding   a gmeow:DerivationKind .
    gmeow:derivationUnknownOrigin a gmeow:DerivationKind .
}""" ;
    gmeow:saRationale "gmeow:derivationBorrowing, gmeow:derivationSemanticShift, gmeow:derivationCompounding, and gmeow:derivationUnknownOrigin MUST all exist as gmeow:DerivationKind individuals — the four canonical seed values of the original vocabulary." .
