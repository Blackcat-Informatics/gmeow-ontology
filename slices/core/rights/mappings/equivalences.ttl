gmeow:eqRights011 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Permission ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:Permission ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ; gmeow:comment "permission rule class" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights012 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Prohibition ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:Prohibition ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ; gmeow:comment "prohibition rule class" ;
