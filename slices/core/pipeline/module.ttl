    skos:definition "Emit the flattened export views: CSV/CSVW, Markdown, JSONL, and llms.txt."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
