    [ a owl:Restriction ; owl:onProperty math:derivativeOrder ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedDerivative .

math:Limit rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:limitOf ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:limitPoint ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:hasLimitResult ; owl:maxQualifiedCardinality 1 ; owl:onClass math:LimitResult ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedLimit .

math:LimitResult rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:limitOutcome ; owl:maxQualifiedCardinality 1 ; owl:onClass math:LimitOutcome ] ,
    [ a owl:Restriction ; owl:onProperty math:limitResultValue ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedLimitResult .

math:Convergence rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:convergenceMode ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:convergesTo ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:convergenceMode ; owl:maxQualifiedCardinality 1 ; owl:onClass math:ConvergenceMode ] ;
