# Synthetic email coverage fixture for the GMEOW email slice.
# A two-message thread with participants (schema.org surface vocab), an
# attachment, a mailbox, and a trust example (Authentication-Results + DKIM).
# There is no public RDF email corpus, so this hand-authored slice exercises the
# surface vocabularies a real importer would emit, plus the GMEOW-native trust
# terms, so `gmeow coverage` can measure email-term coverage.
#
# Also exercises the MessageParticipant relator: alice@example.org appears in
# msg1 From with display name "Alice Smith" and in msg2 To with display name
# "Dr. Alice Smith", demonstrating that displayName is scoped to the occurrence.

@prefix ex:     <https://example.org/mail/> .
@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix schema: <https://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:thread1 a gmeow:Thread .

ex:msg1
    a schema:EmailMessage, gmeow:EmailMessage ;
    gmeow:rfcMessageId "<msg1@example.org>" ;
    gmeow:subject "Quarterly report" ;
    schema:sender ex:addrAlice ;
    schema:toRecipient ex:addrBob ;
    schema:dateSent "2026-06-01T10:00:00Z"^^xsd:dateTime ;
    gmeow:receivedAt "2026-06-01T10:00:03Z"^^xsd:dateTime ;
    gmeow:partOfThread ex:thread1 ;
    gmeow:residesIn ex:inbox ;
    gmeow:hasKeyword gmeow:keywordSeen ;
    gmeow:hasAuthenticationResult ex:auth1 ;
    gmeow:hasSignature ex:dkim1 ;
    gmeow:hasRelayHop ex:hop1 ;
    gmeow:hasMessageParticipant ex:mpAliceFrom1 ;
    gmeow:hasMessageParticipant ex:mpBobTo1 .

ex:msg2
    a schema:EmailMessage, gmeow:EmailMessage ;
    gmeow:rfcMessageId "<msg2@example.org>" ;
    gmeow:subject "Re: Quarterly report" ;
    schema:sender ex:addrBob ;
    schema:toRecipient ex:addrAlice ;
    schema:dateSent "2026-06-01T14:30:00Z"^^xsd:dateTime ;
    gmeow:inReplyTo ex:msg1 ;
    gmeow:partOfThread ex:thread1 ;
    gmeow:residesIn ex:inbox ;
    schema:messageAttachment ex:att1 ;
    gmeow:hasAttachment ex:att1 ;
    gmeow:hasMessageParticipant ex:mpBobFrom2 ;
    gmeow:hasMessageParticipant ex:mpAliceTo2 .

ex:att1
    a gmeow:Attachment ;
    gmeow:filename "q2-report.pdf" ;
    gmeow:mediaType "application/pdf" .

# Derivation layer: a text extraction and an AI summary of the attachment.
ex:att1-text
    a gmeow:TextExtraction ;
    gmeow:wasDerivedFrom ex:att1 .

ex:att1-summary
    a gmeow:Summary ;
    gmeow:wasDerivedFrom ex:att1 ;
    gmeow:wasAttributedTo ex:summariser .

ex:inbox
    a gmeow:Mailbox ;
    gmeow:mailboxRole "inbox" ;
    gmeow:mailboxName "Inbox" ;
    gmeow:mailboxOfAccount ex:aliceAccount .

ex:aliceAccount a gmeow:OnlineAccount .

# Trust indicators.
ex:auth1
    a gmeow:AuthenticationResult ;
    gmeow:authMethod "dkim" ;
    gmeow:authResult "pass" ;
    gmeow:authServer "mx.example.org" .

ex:dkim1
    a gmeow:DKIMSignature ;
    gmeow:signingDomain "example.org" ;
    gmeow:signatureAlgorithm "rsa-sha256" ;
    gmeow:verificationStatus "verified" .

ex:hop1
    a gmeow:RelayHop ;
    gmeow:hopOrdinal 1 ;
    gmeow:relayFrom "smtp.sender.example" ;
    gmeow:relayBy "mx.example.org" ;
    gmeow:relayProtocol "ESMTPS" ;
    gmeow:relayAt "2026-06-01T10:00:02Z"^^xsd:dateTime .

# Message headers for participant occurrences.
ex:hdrFrom1
    a gmeow:MessageHeader ;
    gmeow:headerName "From" ;
    gmeow:headerValue "\"Alice Smith\" <alice@example.org>" .

ex:hdrTo1
    a gmeow:MessageHeader ;
    gmeow:headerName "To" ;
    gmeow:headerValue "\"Bob Jones\" <bob@example.com>" .

ex:hdrFrom2
    a gmeow:MessageHeader ;
    gmeow:headerName "From" ;
    gmeow:headerValue "\"Bob Jones\" <bob@example.com>" .

ex:hdrTo2
    a gmeow:MessageHeader ;
    gmeow:headerName "To" ;
    gmeow:headerValue "\"Dr. Alice Smith\" <alice@example.org>" .

# MessageParticipant occurrences — same address, different display names.
ex:mpAliceFrom1
    a gmeow:MessageParticipant ;
    gmeow:participantMessage ex:msg1 ;
    gmeow:participantAddress ex:addrAlice ;
    gmeow:participantRole gmeow:messageRoleFrom ;
    gmeow:participantHeader ex:hdrFrom1 ;
    gmeow:participantOrdinal 0 ;
    gmeow:displayName "Alice Smith" ;
    gmeow:rawAddressValue "\"Alice Smith\" <alice@example.org>" .

ex:mpBobTo1
    a gmeow:MessageParticipant ;
    gmeow:participantMessage ex:msg1 ;
    gmeow:participantAddress ex:addrBob ;
    gmeow:participantRole gmeow:messageRoleTo ;
    gmeow:participantHeader ex:hdrTo1 ;
    gmeow:participantOrdinal 0 ;
    gmeow:displayName "Bob Jones" ;
    gmeow:rawAddressValue "\"Bob Jones\" <bob@example.com>" .

ex:mpBobFrom2
    a gmeow:MessageParticipant ;
    gmeow:participantMessage ex:msg2 ;
    gmeow:participantAddress ex:addrBob ;
    gmeow:participantRole gmeow:messageRoleFrom ;
    gmeow:participantHeader ex:hdrFrom2 ;
    gmeow:participantOrdinal 0 ;
    gmeow:displayName "Bob Jones" ;
    gmeow:rawAddressValue "\"Bob Jones\" <bob@example.com>" .

ex:mpAliceTo2
    a gmeow:MessageParticipant ;
    gmeow:participantMessage ex:msg2 ;
    gmeow:participantAddress ex:addrAlice ;
    gmeow:participantRole gmeow:messageRoleTo ;
    gmeow:participantHeader ex:hdrTo2 ;
    gmeow:participantOrdinal 0 ;
    gmeow:displayName "Dr. Alice Smith" ;
    gmeow:rawAddressValue "\"Dr. Alice Smith\" <alice@example.org>" .

# Stable contact points with structured decomposition.
ex:addrAlice
    a gmeow:EmailAddress ;
    gmeow:addressValue "alice@example.org" ;
    gmeow:localPart "alice" ;
    gmeow:domainPart "example.org" ;
    gmeow:deliversToAccount ex:aliceAccount .

ex:addrBob
    a gmeow:EmailAddress ;
    gmeow:addressValue "bob@example.com" ;
    gmeow:localPart "bob" ;
    gmeow:domainPart "example.com" .

ex:summariser a gmeow:SoftwareAgent .
