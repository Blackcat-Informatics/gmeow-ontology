    gmeow:saRationale "gmeow:overlayTypeNOTAM MUST exist as a gmeow:RegulatoryOverlayType individual. Mirrors test_notam_overlay_type_exists." .

# --- 44. Vertical reference frames declared (MUST) ----------------------------
ex:saVerticalReferenceFrames a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:referenceFrameAltitudeMSL           a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial .
    gmeow:referenceFrameFlightLevel           a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial .
    gmeow:referenceFrameAltitudeAGL           a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial .
    gmeow:referenceFrameDepthBelowSeaLevel    a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial .
    gmeow:referenceFrameDepthBelowChartDatum  a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial .
}""" ;
    gmeow:saRationale "The five vertical reference frames MUST be declared as ReferenceFrame individuals with frameRealmTerrestrial. Mirrors test_vertical_reference_frames_properly_declared." .

# --- 45. overlayDesignator is a functional DatatypeProperty on RegulatoryOverlay (MUST) --
ex:saOverlayDesignatorGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:overlayDesignator a owl:DatatypeProperty .
    gmeow:overlayDesignator a owl:FunctionalProperty .
    gmeow:overlayDesignator rdfs:domain gmeow:RegulatoryOverlay .
    gmeow:overlayDesignator rdfs:range  rdfs:Literal .
}""" ;
    gmeow:saRationale "gmeow:overlayDesignator MUST be a functional owl:DatatypeProperty with domain RegulatoryOverlay and range rdfs:Literal. Mirrors test_overlay_designator_grounding." .

# --- 46. LocationState is a subclass of Entity (MUST) -------------------------
ex:saLocationStateIsEntity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:LocationState rdfs:subClassOf gmeow:Entity . }""" ;
    gmeow:saRationale "gmeow:LocationState MUST be rdfs:subClassOf gmeow:Entity. Mirrors test_location_state_is_entity." .

# --- 47. Trajectory is a subclass of Entity (MUST) ----------------------------
ex:saTrajectoryIsEntity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:Trajectory rdfs:subClassOf gmeow:Entity . }""" ;
    gmeow:saRationale "gmeow:Trajectory MUST be rdfs:subClassOf gmeow:Entity. Mirrors test_trajectory_is_entity." .

# --- 48. LocationState property domains (MUST) --------------------------------
ex:saLocationStatePropertyDomains a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:stateOf               rdfs:domain gmeow:LocationState .
    gmeow:stateDuringInterval   rdfs:domain gmeow:LocationState .
    gmeow:stateAtInstant        rdfs:domain gmeow:LocationState .
    gmeow:stateHasVelocity      rdfs:domain gmeow:LocationState .
    gmeow:stateHasAngularVelocity rdfs:domain gmeow:LocationState .
    gmeow:stateReferenceFrame   rdfs:domain gmeow:LocationState .
}""" ;
    gmeow:saRationale "The six LocationState properties MUST have rdfs:domain gmeow:LocationState. Mirrors test_location_state_properties_exist." .

# --- 49. Trajectory property domains (MUST) -----------------------------------
ex:saTrajectoryPropertyDomains a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:trajectoryOf           rdfs:domain gmeow:Trajectory .
    gmeow:hasTrajectorySample    rdfs:domain gmeow:Trajectory .
    gmeow:trajectoryReferenceFrame rdfs:domain gmeow:Trajectory .
}""" ;
    gmeow:saRationale "The three Trajectory properties MUST have rdfs:domain gmeow:Trajectory. Mirrors test_trajectory_properties_exist." .

# --- 50. Velocity properties range over ScalarQuantity (MUST) -----------------
ex:saVelocityRangeScalarQuantity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:stateHasVelocity        rdfs:range gmeow:ScalarQuantity .
    gmeow:stateHasAngularVelocity rdfs:range gmeow:ScalarQuantity .
}""" ;
    gmeow:saRationale "gmeow:stateHasVelocity and stateHasAngularVelocity MUST range over gmeow:ScalarQuantity. Mirrors test_velocity_range_is_scalar_quantity." .

# --- 51. hasTrajectorySample is NOT functional (MUST-NOT) ---------------------
ex:saHasTrajectorySampleNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasTrajectorySample a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:hasTrajectorySample MUST NOT be owl:FunctionalProperty -- a trajectory may have many samples. Mirrors test_trajectory_sample_is_non_functional." .

