#[name("https://example.org/bench/rules/lubm-r1")]
<https://example.org/bench/takesCourse>(?s, !c, ?w) :- <https://example.org/bench/gradStudent>(?s, ?o, ?w) .
#[name("https://example.org/bench/rules/lubm-r2")]
<https://example.org/bench/memberOf>(?s, !d, ?w) :- <https://example.org/bench/gradStudent>(?s, ?o, ?w) .
#[name("https://example.org/bench/rules/lubm-r3")]
<https://example.org/bench/subOrganizationOf>(?d, !u, ?w) :- <https://example.org/bench/memberOf>(?s, ?d, ?w) .
