    gmeow:objectLabel "qudt:Quantity" ;
    gmeow:comment "math:Quantity aligns to qudt:Quantity, QUDT's dimensioned quantity. closeMatch (QUDT is a units spine to align to, not to subsume — Principle 17). Full IRI by reference." ;
    gmeow:sssomFile "gmeow-qudt.sssom.tsv" .

