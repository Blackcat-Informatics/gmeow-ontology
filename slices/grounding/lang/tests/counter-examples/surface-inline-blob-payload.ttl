# Counter-example: a document-scale lang:SurfaceForm that inlines its bytes through
# lang:surfaceText (5120 bytes, over the 4096-byte document-scale threshold) instead of
# holding them by reference through lang:surfaceBlob (fires lang:InlineBlobPayload, a
# native crates/validate structural_lint gate). Typed lang:UnanalyzedProse so it fires
# exactly its one class and not lang:SilentIngestDrop.

@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix ex:   <http://example.org/lang/> .

ex:latinScript a lang:Script .

ex:docSurface a lang:SurfaceForm , lang:UnanalyzedProse ;
    lang:inScript ex:latinScript ;
    lang:encoding "UTF-8" ;
    lang:unicodeNormalization "NFC" ;
    lang:collationLocale "en" ;
