# Counter-example: an engine-claimed reading promoted to a slice assertion (through
# lang:promotedReading) by a bare subject that is neither a gmeow:Activity nor
# vantage-held — a promotion with no provenance-carrying editorial act (fires
# lang:SilentPromotion, a native crates/validate structural_lint gate).

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:form a lang:WordForm ; lang:inSignSystem ex:english .

# The engine reading, lawfully vantage-held.
ex:reading a lang:Reading ; lang:readingOf ex:form ;
    gmeow:vantage ex:engineVantage .

ex:act a lang:InterpretationAct ;
    lang:interpretedForm ex:form ;
    lang:interpretationEngine ex:udParser ;
    lang:producedReading ex:reading .

# The illicit promotion: a bare subject adopts the reading as a slice assertion with
# no editorial gmeow:Activity and no gmeow:vantage behind it.
ex:someSlice lang:promotedReading ex:reading .
