    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Norm states at most one gmeow:deonticModality — a rule that both permits and obliges is two norms (functional, closed-world)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/deonticModality> ?value . } GROUP BY $this HAVING ( COUNT(?value) > '1'^^<http://www.w3.org/2001/XMLSchema#integer> )""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/NormIssuerPresenceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Norm> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/NormIssuerShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Norm> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A norm carrying a deontic modality must name at least one gmeow:normIssuer — there is no ought, only ought-according-to (no anonymous oughts, Principles 1/9)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/deonticModality> ?t . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/normIssuer> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/NotabilityRequirementConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/NotabilityRequirementShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/CitationAct> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A citation with supportsNotability true must have sourceIndependence independent, sourceTier secondary, and coverageDepth significantCoverage (WP:GNG triad)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/supportsNotability> 'true'^^<http://www.w3.org/2001/XMLSchema#boolean> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/sourceIndependence> <https://blackcatinformatics.ca/gmeow/sourceIndependenceIndependent> . $this <https://blackcatinformatics.ca/gmeow/sourceTier> <https://blackcatinformatics.ca/gmeow/sourceTierSecondary> . $this <https://blackcatinformatics.ca/gmeow/coverageDepth> <https://blackcatinformatics.ca/gmeow/coverageDepthSignificantCoverage> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/NoteContentConstraintProceduralConstraintShape>
    a sh:NodeShape ;
