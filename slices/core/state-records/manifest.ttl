@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/state-records>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/state-records> ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceProfile "memory" ;
    rdfs:label "state records"@x-gmeow-english ;
    skos:definition "Exact property-named assignment records, multi-predecessor state transitions and evidence on individual supersession edges."@x-gmeow-english ;
    dcterms:title "GMEOW State Records Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Memory services retaining original RDF state assignments and exact replacement edges without copied slots or clock-derived order."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceDependsOn <https://blackcatinformatics.ca/gmeow/slices/logic>,
        <https://blackcatinformatics.ca/gmeow/slices/kernel>,
        <https://blackcatinformatics.ca/gmeow/slices/coreference>,
        <https://blackcatinformatics.ca/gmeow/slices/provenance>,
        <https://blackcatinformatics.ca/gmeow/slices/record-metadata>,
        <https://blackcatinformatics.ca/gmeow/slices/standpoint> .
