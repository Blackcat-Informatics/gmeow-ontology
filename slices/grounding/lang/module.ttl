    rdfs:label "denotation of GMN multiplication"@x-gmeow-english ;
    skos:definition "The executable scoped meaning assignment from the GMN × form to math:Multiplication."@x-gmeow-english ;
    lang:denotedForm gmeow:gmnFormMathMultiplication ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget math:Multiplication ;
    lang:denotationContext gmeow:gmnMathGlyphContext ;
    gmeow:gmnDenotationGrapheme gmeow:gmnGlyphMathMultiplication ;
