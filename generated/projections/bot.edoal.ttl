@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bot: <https://w3id.org/bot#> .

<https://blackcatinformatics.ca/gmeow/projections/bot>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:and ( [
                a edoal:Class ;
                edoal:uri gmeow:Place ;
            ] [
                a edoal:AttributeValueRestriction ;
                edoal:comparator edoal:equals ;
                edoal:onAttribute [
                    a edoal:Relation ;
                    edoal:uri gmeow:placeType ;
                ] ;
                edoal:value [
                    edoal:uri gmeow:placeTypeBuilding ;
                ] ;
            ] ) ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri bot:Building ;
        ] ;
        align:relation "=" ;
        edoal:transformation [
            rdfs:seeAlso gmeow:fnPlaceTypeToClass ;
        ] ;
        rdfs:label "gmeow:Place [gmeow:placeTypeBuilding] → bot:Building"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:and ( [
                    a edoal:Class ;
                    edoal:uri gmeow:Place ;
                ] [
                    a edoal:AttributeValueRestriction ;
                    edoal:comparator edoal:equals ;
                    edoal:onAttribute [
                        a edoal:Relation ;
                        edoal:uri gmeow:placeType ;
                    ] ;
                    edoal:value [
                        edoal:uri gmeow:placeTypeFloor ;
                    ] ;
                ] ) ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri bot:Storey ;
            ] ;
            align:relation "=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnPlaceTypeToClass ;
            ] ;
            rdfs:label "gmeow:Place [gmeow:placeTypeFloor] → bot:Storey"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:and ( [
                    a edoal:Class ;
                    edoal:uri gmeow:Place ;
                ] [
                    a edoal:AttributeValueRestriction ;
                    edoal:comparator edoal:equals ;
                    edoal:onAttribute [
                        a edoal:Relation ;
                        edoal:uri gmeow:placeType ;
                    ] ;
                    edoal:value [
                        edoal:uri gmeow:placeTypeRoom ;
                    ] ;
                ] ) ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri bot:Space ;
            ] ;
            align:relation "=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnPlaceTypeToClass ;
            ] ;
            rdfs:label "gmeow:Place [gmeow:placeTypeRoom] → bot:Space"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:and ( [
                    a edoal:Class ;
                    edoal:uri gmeow:Place ;
                ] [
                    a edoal:AttributeValueRestriction ;
                    edoal:comparator edoal:equals ;
                    edoal:onAttribute [
                        a edoal:Relation ;
                        edoal:uri gmeow:placeType ;
                    ] ;
                    edoal:value [
                        edoal:uri gmeow:placeTypeSite ;
                    ] ;
                ] ) ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri bot:Site ;
            ] ;
            align:relation "=" ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnPlaceTypeToClass ;
            ] ;
            rdfs:label "gmeow:Place [gmeow:placeTypeSite] → bot:Site"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:inverse [
                    a edoal:Relation ;
                    edoal:uri gmeow:containedInPlace ;
                ] ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri bot:hasSpace ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "building contains room directly → bot:hasSpace"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:inverse [
                    a edoal:Relation ;
                    edoal:uri gmeow:containedInPlace ;
                ] ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri bot:hasSpace ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "floor contains room → bot:hasSpace"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:inverse [
                    a edoal:Relation ;
                    edoal:uri gmeow:containedInPlace ;
                ] ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri bot:hasStorey ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "building contains floor → bot:hasStorey"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:adjacentTo ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri bot:adjacentZone ;
            ] ;
            align:relation "=" ;
            rdfs:label "adjacentTo → bot:adjacentZone (indoor topology)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:containsPlace ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri bot:containsZone ;
            ] ;
            align:relation "=" ;
            rdfs:label "containsPlace → bot:containsZone (indoor topology)"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "bot" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → bot (EDOAL)"@en .
