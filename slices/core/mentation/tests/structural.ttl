ex:saProducesMentalMomentProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:producesMentalMoment a owl:ObjectProperty ;
        rdfs:domain gmeow:MentalProcess ;
        rdfs:range gmeow:MentalMoment .
}""" ;
    gmeow:saRationale "gmeow:producesMentalMoment MUST be an owl:ObjectProperty with domain gmeow:MentalProcess and range gmeow:MentalMoment. Mirrors the positive clauses of test_producesmentalmoment_property." .

ex:saProducesMentalMomentNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:producesMentalMoment a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:producesMentalMoment MUST NOT be functional — one process may produce several moments. Mirrors the non-functional clause of test_producesmentalmoment_property." .

# --- 9. updatesMentalTenure is a non-functional ObjectProperty (MUST/-NOT) ----
ex:saUpdatesMentalTenureProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:updatesMentalTenure a owl:ObjectProperty ;
        rdfs:domain gmeow:MentalProcess ;
        rdfs:range gmeow:TimeScopedRelation .
}""" ;
    gmeow:saRationale "gmeow:updatesMentalTenure MUST be an owl:ObjectProperty with domain gmeow:MentalProcess and range gmeow:TimeScopedRelation. Mirrors the positive clauses of test_updatesmentaltenure_property." .

ex:saUpdatesMentalTenureNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:updatesMentalTenure a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:updatesMentalTenure MUST NOT be functional — one process may update several tenures. Mirrors the non-functional clause of test_updatesmentaltenure_property." .

# --- 10. gmeow:realizes collision guard (MUST-NOT hold + MUST declarations) ---
ex:saRealizesAbsentFromMentation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    { gmeow:realizes ?p ?o . }
    UNION
    { ?s gmeow:realizes ?o . }
    UNION
    { ?s ?p gmeow:realizes . }
}""" ;
    gmeow:saRationale "gmeow:realizes MUST NOT appear in any subject, predicate, or object position in this module — creative-works owns it (Principle 4). Mirrors the collision-guard clauses of test_realizes_collision_guard." .

ex:saBridgePropertiesDeclared a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
ASK {
    gmeow:realizesMentalMoment  rdf:type ?t1 .
    gmeow:producesMentalMoment  rdf:type ?t2 .
    gmeow:updatesMentalTenure   rdf:type ?t3 .
}""" ;
    gmeow:saRationale "All three bridge properties (realizesMentalMoment, producesMentalMoment, updatesMentalTenure) MUST be declared with at least one rdf:type triple — their existence in the module is required. Mirrors the bridge-property declaration guard of test_realizes_collision_guard." .
