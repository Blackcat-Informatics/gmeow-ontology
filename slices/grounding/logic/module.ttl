    gmeow:graphBoxRole gmeow:boxRBox .

logic:conditionalRangeSelectorValue
    a logic:ObjectProperty ;
    rdfs:domain logic:ConditionalRangeAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conditional range selector value"@x-gmeow-english ;
    skos:definition "Relates a logic:ConditionalRangeAssertion to the named value of the discriminant property that triggers the required-type condition. Domain logic:ConditionalRangeAssertion; single-valued. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:conditionalRangeValue
    a logic:ObjectProperty ;
    rdfs:domain logic:ConditionalRangeAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conditional range value"@x-gmeow-english ;
    skos:definition "Relates a logic:ConditionalRangeAssertion to the property whose bound value must satisfy the required type when the selector matches. Domain logic:ConditionalRangeAssertion; single-valued. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:conditionalRangeRequiredType
    a logic:ObjectProperty ;
