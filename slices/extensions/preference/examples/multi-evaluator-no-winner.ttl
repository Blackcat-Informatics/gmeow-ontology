#
# Pass-witness scene: three total-ordering evaluators, no Condorcet winner.
# Three candidates P, Q, R are ranked completely by three evaluators, each its own
# gmeow:vantage: E1 sees P≻Q≻R, E2 sees R≻P≻Q, E3 sees Q≻R≻P. Every evaluator's own
# order is internally coherent, yet the pairwise majorities cycle (P beats Q, Q beats
# R, R beats P), so there is NO Condorcet winner — the classic voting paradox as a
# non-vanishing H1 obstruction. FLAG-1 is honored: each evaluator's order is carried
# as a vantage-indexed SET of reified gmeow:PreferenceObservations (each marking its
# winner with gmeow:strictlyOver), NEVER as bare candidate→candidate edges pooled
# across vantages. The gmeow:DisagreementObstruction is present and NOT discharged.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/preference/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# --- The closed candidate field ----------------------------------------------- #
ex:candP a gmeow:InformationObject ; rdfs:label "candidate P"@en .
ex:candQ a gmeow:InformationObject ; rdfs:label "candidate Q"@en .
ex:candR a gmeow:InformationObject ; rdfs:label "candidate R"@en .

ex:candidates a gmeow:CandidateSet ;
    rdfs:label "the three proposal candidates"@en ;
    gmeow:hasCandidate ex:candP , ex:candQ , ex:candR .

# --- The three co-equal evaluator vantages ------------------------------------ #
ex:e1 a gmeow:Standpoint ; rdfs:label "evaluator E1 (P≻Q≻R)"@en .
ex:e2 a gmeow:Standpoint ; rdfs:label "evaluator E2 (R≻P≻Q)"@en .
ex:e3 a gmeow:Standpoint ; rdfs:label "evaluator E3 (Q≻R≻P)"@en .

# --- The content-addressed context registering the WHOLE vantage base (F2) ----- #
ex:goalPick a gmeow:Goal ; rdfs:label "pick the strongest proposal"@en .
ex:committee a gmeow:Standpoint ; rdfs:label "the review committee standpoint"@en .

ex:ctx a gmeow:ComparisonContext ;
    rdfs:label "proposal committee review, 2026-Q3"@en ;
    gmeow:contextTask ex:goalPick ;
    gmeow:contextStandpoint ex:committee ;
    gmeow:contentDigest "blake3:4d5e6f708192a3b4c5061728394a5b6c7d8e9f0a1b2c3d4e5f607182930a4b5c" ;
    gmeow:registersObservation
        ex:o1 , ex:o2 , ex:o3 ,
        ex:o4 , ex:o5 , ex:o6 ,
        ex:o7 , ex:o8 , ex:o9 .

# --- E1's local order P≻Q≻R as a vantage-indexed set of observations ----------- #
ex:featPQ_e1 a gmeow:InformationObject ; rdfs:label "P vs Q"@en ; gmeow:hasPart ex:candP , ex:candQ .
ex:o1 a gmeow:PreferenceObservation ; rdfs:label "P ≻ Q per E1"@en ;
    gmeow:vantage ex:e1 ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featPQ_e1 ; gmeow:observationPrefers ex:candP .
ex:featQR_e1 a gmeow:InformationObject ; rdfs:label "Q vs R"@en ; gmeow:hasPart ex:candQ , ex:candR .
ex:o2 a gmeow:PreferenceObservation ; rdfs:label "Q ≻ R per E1"@en ;
    gmeow:vantage ex:e1 ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featQR_e1 ; gmeow:observationPrefers ex:candQ .
ex:featPR_e1 a gmeow:InformationObject ; rdfs:label "P vs R"@en ; gmeow:hasPart ex:candP , ex:candR .
ex:o3 a gmeow:PreferenceObservation ; rdfs:label "P ≻ R per E1"@en ;
    gmeow:vantage ex:e1 ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featPR_e1 ; gmeow:observationPrefers ex:candP .

# --- E2's local order R≻P≻Q ---------------------------------------------------- #
ex:featRP_e2 a gmeow:InformationObject ; rdfs:label "R vs P"@en ; gmeow:hasPart ex:candR , ex:candP .
ex:o4 a gmeow:PreferenceObservation ; rdfs:label "R ≻ P per E2"@en ;
    gmeow:vantage ex:e2 ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featRP_e2 ; gmeow:observationPrefers ex:candR .
ex:featPQ_e2 a gmeow:InformationObject ; rdfs:label "P vs Q"@en ; gmeow:hasPart ex:candP , ex:candQ .
ex:o5 a gmeow:PreferenceObservation ; rdfs:label "P ≻ Q per E2"@en ;
    gmeow:vantage ex:e2 ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featPQ_e2 ; gmeow:observationPrefers ex:candP .
ex:featRQ_e2 a gmeow:InformationObject ; rdfs:label "R vs Q"@en ; gmeow:hasPart ex:candR , ex:candQ .
ex:o6 a gmeow:PreferenceObservation ; rdfs:label "R ≻ Q per E2"@en ;
    gmeow:vantage ex:e2 ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featRQ_e2 ; gmeow:observationPrefers ex:candR .

# --- E3's local order Q≻R≻P ---------------------------------------------------- #
ex:featQR_e3 a gmeow:InformationObject ; rdfs:label "Q vs R"@en ; gmeow:hasPart ex:candQ , ex:candR .
ex:o7 a gmeow:PreferenceObservation ; rdfs:label "Q ≻ R per E3"@en ;
    gmeow:vantage ex:e3 ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featQR_e3 ; gmeow:observationPrefers ex:candQ .
ex:featRP_e3 a gmeow:InformationObject ; rdfs:label "R vs P"@en ; gmeow:hasPart ex:candR , ex:candP .
ex:o8 a gmeow:PreferenceObservation ; rdfs:label "R ≻ P per E3"@en ;
    gmeow:vantage ex:e3 ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featRP_e3 ; gmeow:observationPrefers ex:candR .
ex:featQP_e3 a gmeow:InformationObject ; rdfs:label "Q vs P"@en ; gmeow:hasPart ex:candQ , ex:candP .
ex:o9 a gmeow:PreferenceObservation ; rdfs:label "Q ≻ P per E3"@en ;
    gmeow:vantage ex:e3 ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featQP_e3 ; gmeow:observationPrefers ex:candQ .

# --- The compiled carrier + the undischarged obstruction ---------------------- #
ex:complex a math:CellComplex ; rdfs:label "the preference cell complex over {P,Q,R}"@en .
ex:sheaf a math:CellularSheaf ;
    rdfs:label "the preference sheaf carrying the three total orders"@en ;
    math:sheafBaseComplex ex:complex ;
    math:connectionOfSheaf ex:prefConnection .
ex:prefConnection a math:Connection ; rdfs:label "the preference connection"@en .

ex:pres a gmeow:ProjectionPreservationRecord ;
    rdfs:label "compilation preservation judgment (lossless assembly)"@en ;
    logic:preservationKind logic:ExactPreservation .

ex:compile a gmeow:ComparisonCompilation ;
    rdfs:label "compile the three vantage orders into the preference sheaf"@en ;
    gmeow:compilesComparison ex:candidates ;
    gmeow:compilesToPreferenceComplex ex:complex ;
    gmeow:carriedBySheaf ex:sheaf ;
    gmeow:recordsProjectionPreservation ex:pres .

# The pairwise-majority cycle P→Q→R→P is a non-vanishing H1 class; it is NOT
# discharged, and no gmeow:PreferenceClaim asserts a winner over this field.
ex:h1class a math:GluingObstruction ;
    rdfs:label "the non-vanishing H1 gluing obstruction (no Condorcet winner)"@en ;
    math:obstructionOf ex:sheaf .
ex:cycleHolonomy a math:Holonomy ;
    rdfs:label "non-trivial holonomy around the majority cycle"@en .

ex:obstruction a gmeow:DisagreementObstruction ;
    rdfs:label "the undischarged majority-cycle disagreement"@en ;
    gmeow:obstructionClass ex:h1class ;
    gmeow:obstructionHolonomy ex:cycleHolonomy .
