msgctxt "https://blackcatinformatics.ca/gmeow/readToEnd|http://www.w3.org/2000/01/rdf-schema#label"
msgid "read to end"
msgstr "lu jusqu’à la fin"

msgctxt "https://blackcatinformatics.ca/gmeow/readToEnd|http://www.w3.org/2004/02/skos/core#definition"
msgid "The reported boolean of whether this exact revision was read to its end during this review. False is explicit partial reading; absence does not default to either value."
msgstr "Le booléen rapporté indiquant si cette révision exacte a été lue jusqu’à la fin durant la revue. Faux signifie lecture partielle explicite ; l’absence n’a aucune valeur par défaut."

msgctxt "https://blackcatinformatics.ca/gmeow/readToEnd|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this part of an attributed memory record or its exact source evidence."
msgstr "Utiliser pour conserver cette partie d’un enregistrement de mémoire attribué ou ses preuves sources exactes."

