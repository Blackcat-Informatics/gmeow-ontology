#
# The nineteen closed axes of the enactment kernel, each with the transition law
# that governs it and the complete roster of positions that law ranges over.
#
# logic:AxisTransitionLaw exists so that "which moves does this axis admit?" is
# DATA rather than prose — that is what lets deadlock-freedom and reachability be
# PROVED over an axis instead of asserted about it. But a law that named its axis
# and stopped there would be a signature on an empty page: the proof obligation is
# discharged against the POSITIONS, so the positions have to be reachable from the
# law. Each law below therefore carries its governed axis and, through
# logic:lawAdmits, an atomic formula whose ordered argument carriers name the
# positions the axis ranges over.
#
# Here ONE carrier is recorded two ways. Every law is present, every axis is
# governed, and eighty-odd positions are named correctly; the single defect is the
# first carrier of the step-state law, which selects a named position AND a variable
# at once, so the move it describes has an endpoint that is simultaneously
# logic:StepCancelled and anything at all.
#
# That is worse than a MISSING position rather than smaller. A law with a hole in it
# refuses moves it should admit and is caught the first time somebody makes one; a
# law with an ambiguous endpoint ADMITS moves nobody wrote down, and the
# deadlock-freedom proof it exists to support becomes unfalsifiable rather than
# false. Nothing downstream can see it, because the arity, the axis and the rest of
# the roster all still read correctly.
#
# MUST trip the typed-IR carrier law that rejects a carrier selecting more than one
# value kind.
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/logic/tests/badaxes/> .

ex:lawStepState a logic:AxisTransitionLaw ;
    rdfs:label "Transition law for the StepState axis"@x-gmeow-english ;
    logic:lawGovernsAxis logic:StepState ;
    logic:lawAdmits ex:movesStepState .

ex:movesStepState a logic:Formula ;
    rdfs:label "The 8 positions the StepState axis ranges over"@x-gmeow-english ;
    logic:relation logic:StepState ;
    logic:argument
        [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termIri logic:StepCancelled ; logic:termVariable "cancelled" ] ,
        [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri logic:StepCompleted ] ,
        [ a logic:TermCarrier ; logic:termIndex 2 ; logic:termIri logic:StepFailed ] ,
        [ a logic:TermCarrier ; logic:termIndex 3 ; logic:termIri logic:StepPending ] ,
        [ a logic:TermCarrier ; logic:termIndex 4 ; logic:termIri logic:StepReady ] ,
        [ a logic:TermCarrier ; logic:termIndex 5 ; logic:termIri logic:StepRunning ] ,
        [ a logic:TermCarrier ; logic:termIndex 6 ; logic:termIri logic:StepSkipped ] ,
        [ a logic:TermCarrier ; logic:termIndex 7 ; logic:termIri logic:StepWaiting ] .

ex:lawEnactmentState a logic:AxisTransitionLaw ;
    rdfs:label "Transition law for the EnactmentState axis"@x-gmeow-english ;
    logic:lawGovernsAxis logic:EnactmentState ;
    logic:lawAdmits ex:movesEnactmentState .

ex:movesEnactmentState a logic:Formula ;
    rdfs:label "The 6 positions the EnactmentState axis ranges over"@x-gmeow-english ;
    logic:relation logic:EnactmentState ;
    logic:argument
        [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termIri logic:EnactmentCancelled ] ,
        [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri logic:EnactmentCompleted ] ,
        [ a logic:TermCarrier ; logic:termIndex 2 ; logic:termIri logic:EnactmentFailed ] ,
        [ a logic:TermCarrier ; logic:termIndex 3 ; logic:termIri logic:EnactmentPaused ] ,
        [ a logic:TermCarrier ; logic:termIndex 4 ; logic:termIri logic:EnactmentPending ] ,
        [ a logic:TermCarrier ; logic:termIndex 5 ; logic:termIri logic:EnactmentRunning ] .

