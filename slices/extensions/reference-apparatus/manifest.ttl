@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/reference-apparatus>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:sliceTier gmeow:tierExtension ;
    rdfs:label "reference apparatus"@x-gmeow-english ;
    skos:definition "Source-preserving technical apparatus for reference-work blocks, documentary table cells and explicit language and mathematical renderings."@x-gmeow-english ;
    dcterms:title "GMEOW Reference Apparatus Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Katamari reference-work import and other attributed document consumers retaining source apparatus without fabricated parsing, execution or proof certification."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic>,
        <https://blackcatinformatics.ca/gmeow/slices/kernel>,
        <https://blackcatinformatics.ca/gmeow/slices/documents>,
        <https://blackcatinformatics.ca/gmeow/slices/entities>,
        <https://blackcatinformatics.ca/gmeow/slices/concepts>,
        <https://blackcatinformatics.ca/gmeow/slices/lang>,
        <https://blackcatinformatics.ca/gmeow/slices/math>,
        <https://blackcatinformatics.ca/gmeow/slices/provenance>,
        <https://blackcatinformatics.ca/gmeow/slices/sources>,
        <https://blackcatinformatics.ca/gmeow/slices/standpoint> .
