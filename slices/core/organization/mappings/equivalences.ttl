gmeow:eqClasses048 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Post ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject org:Post ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "post (seat independent of holder)" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses049 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:organizationTypeCompany ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject org:FormalOrganization ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "company type value ≈ formal organization (lossy: not every formal org is a company)" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses050 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:organizationTypeCollaboration ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject org:OrganizationalCollaboration ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "collaboration type value ≈ organizational collaboration" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses053 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Occupation ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject esco:Occupation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "ESCO occupation is ISCO-grounded; GMEOW Occupation is the superset" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses055 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Identifier ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:PropertyValue ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the reified external-identifier record IS schema's PropertyValue bundle (propertyID/value/url/name); closeMatch — schema's PropertyValue is broader (any keyed value), the projection narrows to identifier records" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

