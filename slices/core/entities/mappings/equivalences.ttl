gmeow:eqClasses006 a gmeow:TermEquivalence ;
    gmeow:alignSubject org:FormalOrganization ;
    gmeow:alignPredicate rdfs:subClassOf ;
    gmeow:alignObject gmeow:Organization ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "formal org is an organization" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

