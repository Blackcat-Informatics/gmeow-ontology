lang:anchorSource skos:closeMatch nif:referenceContext {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-lang-nif.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
