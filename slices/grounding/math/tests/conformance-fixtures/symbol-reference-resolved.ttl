# Positive fixture: one AST occurrence resolves to exactly one local symbol.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:resolvedReference a math:SymbolReference ;
    math:hasMathematicalSymbol ex:resolvedSymbol .

ex:resolvedSymbol a math:MathematicalSymbol .
