# =========================================================================== #
# PROJECT / REPOSITORY — dogfood the software slice's five-facet model
# =========================================================================== #

:project
    a gmeow:SoftwareProject ;
    rdfs:label "GMEOW ontology project"@x-gmeow-english ;
    skos:definition "The Blackcat Informatics® software and ontology publication project that develops, publishes, and maintains GMEOW."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    gmeow:projectHomepage <https://blackcatinformatics.ca/gmeow> ;
    gmeow:bugDatabase <https://github.com/Blackcat-Informatics/gmeow-ontology/issues> ;
    gmeow:downloadPage <https://github.com/Blackcat-Informatics/gmeow-ontology/releases> ;
    gmeow:hasRepository :repository ;
    gmeow:maintenanceStatus gmeow:statusActive ;
    gmeow:governanceModel gmeow:governanceCorporate ;
    gmeow:projectLicense :license-agpl-3 ;
    gmeow:hasLogo :logo-svg .

:license-agpl-3
    a gmeow:License ;
    rdfs:label "GNU Affero General Public License v3.0 (only)"@x-gmeow-english ;
    skos:definition "The GNU Affero General Public License v3.0 (only) used for GMEOW tooling code, the Rust core, and repository-maintenance software. Separate proprietary/commercial terms are available from Blackcat Informatics® Inc."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    gmeow:licensor <https://blackcatinformatics.ca/#bii> ;
    gmeow:licenseFamily gmeow:licenseFamilyCopyleft ;
    gmeow:spdxLicenseId "AGPL-3.0-only" ;
    gmeow:spdxLicenseName "GNU Affero General Public License v3.0" ;
    dcterms:identifier <https://spdx.org/licenses/AGPL-3.0-only> .

:repository
    a gmeow:Repository ;
    rdfs:label "GMEOW ontology repository"@x-gmeow-english ;
    skos:definition "The Git repository that carries the authored ontology sources, mapping DSLs, statement DSLs, examples, tests, generators, and documentation sources for GMEOW."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    gmeow:repositoryType gmeow:repoTypeGit ;
    gmeow:cloneUrl "https://github.com/Blackcat-Informatics/gmeow-ontology.git" ;
    gmeow:webUrl "https://github.com/Blackcat-Informatics/gmeow-ontology" .

# =========================================================================== #
# BRAND ASSETS — logo and social preview as first-class media objects
# =========================================================================== #

<https://blackcatinformatics.ca/gmeow>
    gmeow:hasLogo :logo-svg .

:brand-note
    a gmeow:Document ;
    rdfs:label "GMEOW brand note"@x-gmeow-english ;
    skos:definition "The repository note that documents the GMEOW brand positioning, color tokens, logo assets, and social-preview publishing workflow."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    gmeow:sourceLocation "docs/BRAND.md" ;
    gmeow:isAbout :project ;
    gmeow:isAbout :logo-svg ;
    gmeow:isAbout :social-preview-svg ;
    gmeow:isAbout :social-preview-png ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

# The brand media below are concrete gmeow:MediaObjects — a gmeow:Manifestation
# subclass — so under WEMI each must embody an Expression that realizes a Work
# (the same Work←realizes←Expression←embodies←Manifestation chain backing the
# 0.1.0 publication). The GMEOW visual identity is that Work.
:visual-identity
    a gmeow:Work ;
    rdfs:label "GMEOW visual identity"@x-gmeow-english ;
    skos:definition "The abstract visual brand identity of GMEOW — the black-cat-holding-a-knowledge-graph emblem and the project's social-preview card design — realized as logo and preview-card expressions."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> .

:visual-identity-design
    a gmeow:Expression ;
    rdfs:label "GMEOW visual identity design"@x-gmeow-english ;
    skos:definition "The realized design expression of the GMEOW visual identity, embodied by the logo and social-preview media objects."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    gmeow:realizes :visual-identity .

:logo-svg
    a gmeow:MediaObject ;
    rdfs:label "GMEOW logo SVG"@x-gmeow-english ;
    skos:definition "The canonical GMEOW logo: a black cat holding a linked knowledge graph. It is the emblematic logo for the ontology and project, not a depiction of them."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    gmeow:embodies :visual-identity-design ;
    gmeow:mediaType "image/svg+xml" ;
    gmeow:sourceLocation "docs/gmeow-logo.svg" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

:social-preview-svg
    a gmeow:MediaObject ;
    rdfs:label "GMEOW social preview SVG"@x-gmeow-english ;
    skos:definition "The editable SVG source for the GMEOW repository social preview card."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    gmeow:embodies :visual-identity-design ;
    gmeow:mediaType "image/svg+xml" ;
    gmeow:pixelWidth "1280"^^xsd:nonNegativeInteger ;
    gmeow:pixelHeight "640"^^xsd:nonNegativeInteger ;
    gmeow:hasPart :logo-svg ;
    gmeow:sourceLocation "docs/social-preview.svg" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

:social-preview-png
    a gmeow:MediaObject ;
    rdfs:label "GMEOW social preview PNG"@x-gmeow-english ;
    skos:definition "The rendered PNG social preview card uploaded through GitHub repository settings."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    gmeow:embodies :visual-identity-design ;
    gmeow:mediaType "image/png" ;
    gmeow:pixelWidth "1280"^^xsd:nonNegativeInteger ;
    gmeow:pixelHeight "640"^^xsd:nonNegativeInteger ;
    gmeow:wasDerivedFrom :social-preview-svg ;
    gmeow:sourceLocation "docs/social-preview.png" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> .

<https://blackcatinformatics.ca/gmeow/self>
    skos:definition "The authored self-description graph for GMEOW publication, project, repository, credit, citation, and brand metadata."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> .
