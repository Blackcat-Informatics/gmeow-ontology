@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Term equivalences for the provenance domain — GMEOW authoring source.
# Compiled to mappings/gmeow-provenance.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetProvenance a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/provenance" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Provenance + import-provenance alignments. The core PROV-O anchors (Activity, wasDerivedFrom, wasGeneratedBy, wasAttributedTo) and the carrier/ingestion terms align to PROV-O and Dublin Core Terms. recordedNoLaterThan and contentDigest are canonical — no faithful external term models a derived terminus-ante-quem or a content-addressed carrier digest." .

gmeow:eqProvenance001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Activity ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:Activity ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:wasDerivedFrom ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:wasDerivedFrom ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:wasGeneratedBy ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:wasGeneratedBy ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:wasAttributedTo ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:wasAttributedTo ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:wasAssociatedWith ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:wasAssociatedWith ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:CreativeWork ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:Entity ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Source-hood is anti-rigid; the described thing is a CreativeWork (WEMI)." ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ImportActivity ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:Activity ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance008 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ingestedAt ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:endedAtTime ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance009 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:assertedAt ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:generatedAtTime ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance010 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:sourceModifiedAt ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject dcterms:modified ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance011 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:sourceLocation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject dcterms:source ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

# --------------------------------------------------------------------------- #
# Issue #128 — generatedObservation provenance link.
# --------------------------------------------------------------------------- #

gmeow:eqProvenance013 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:generatedObservation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:generated ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "prov:generated links an activity to the entity it generated; gmeow:generatedObservation specialises the range to Observation. The ObservationalActivity→prov:Activity alignment is canonical in mapping-dsl/equivalences/events.ttl (eqEvents132)." ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .

gmeow:eqProvenance014 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:wasDerivedFrom ;
    gmeow:alignPredicate owl:equivalentProperty ;
    gmeow:alignObject prov:wasDerivedFrom ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "the same derivation relation; gmeow's is deliberately domain-free so events and endurants may participate (#34 phase 2)" ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" .
