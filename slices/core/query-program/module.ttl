logic:argument [ logic:termIndex 0 ; logic:termVariable "left" ], [ logic:termIndex 1 ; logic:termVariable "leftOutput" ] ],
[ a logic:Formula ;
logic:relation gmeow:entryOrdinal ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "right" ], [ logic:termIndex 1 ; logic:termVariable "rightOutput" ] ] ] ;
logic:consequent [ a logic:Formula ;
logic:relation logic:termLess ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "leftOutput" ], [ logic:termIndex 1 ; logic:termVariable "rightOutput" ] ] ],
[ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation gmeow:rerankEntry ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "left" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankEntry ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "right" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankUnscoredDetail ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "left" ], [ logic:termIndex 1 ; logic:termVariable "leftDetail" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankUnscoredDetail ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "right" ], [ logic:termIndex 1 ; logic:termVariable "rightDetail" ] ],
[ a logic:Formula ;
