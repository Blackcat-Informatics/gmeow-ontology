@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vcard:  <http://www.w3.org/2006/vcard/ns#> .
# vCard 4 RFC-9554 extension terms (PRONOUNS) — no W3C-vCard-RDF predicate exists;
# namespaced outside gmeow/ so a pure profile never leaks a GMEOW term.
@prefix vcardx: <https://blackcatinformatics.ca/vcard-ext/> .

# Projection mappings: GMEOW → vCard-RDF. Address components → vcard:Address (+ a
# composed vcard:label); displayable full name → vcard:fn; given/family parts → a
# vcard:Name node. Compiled to projections/vcard.edoal.ttl + queries/projections/
# vcard.rq by `gmeow compile-mappings`.

gmeow:mapVcardAddress a gmeow:ProjectionMapping ;
    rdfs:label "PostalAddress → vcard:Address (component rename + composed vcard:label)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "holder" ;
        gmeow:atom (
            [ gmeow:subjectVar "holder" ; gmeow:predicate gmeow:hasContactPoint ; gmeow:objectVar "addr" ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:PostalAddress ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate gmeow:streetAddress ; gmeow:objectVar "street" ; gmeow:optional true ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate gmeow:addressLocality ; gmeow:objectVar "locality" ; gmeow:optional true ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate gmeow:addressRegion ; gmeow:objectVar "region" ; gmeow:optional true ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate gmeow:postalCode ; gmeow:objectVar "pcode" ; gmeow:optional true ]
            [ gmeow:subjectVar "addr" ; gmeow:predicate gmeow:countryCode ; gmeow:objectVar "ccode" ; gmeow:optional true ] ) ;
        gmeow:bind [ gmeow:bindVar "label" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opCoalesce ; gmeow:exprArgs ( [ gmeow:exprVar "street" ] "" ) ] ", "
                [ gmeow:exprOp gmeow:opCoalesce ; gmeow:exprArgs ( [ gmeow:exprVar "locality" ] "" ) ] " "
                [ gmeow:exprOp gmeow:opCoalesce ; gmeow:exprArgs ( [ gmeow:exprVar "region" ] "" ) ] " "
                [ gmeow:exprOp gmeow:opCoalesce ; gmeow:exprArgs ( [ gmeow:exprVar "pcode" ] "" ) ] " "
                [ gmeow:exprOp gmeow:opCoalesce ; gmeow:exprArgs ( [ gmeow:exprVar "ccode" ] "" ) ] ) ] ] ;
        gmeow:edoalSource gmeow:PostalAddress ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:relation "=" ;
        gmeow:edoalTarget vcard:Address ; gmeow:edoalTargetKind "class" ;
        gmeow:transform gmeow:fnComposeAddress ;
        gmeow:lossyDrop "the postal reference frame (axes, topological kind, metric) is dropped; only the flat vcard:Address component values and composed label survive" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "holder" ; gmeow:tPred vcard:hasAddress ; gmeow:tObj "addr" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred rdf:type ; gmeow:tObjValue vcard:Address ]
            [ gmeow:tSubj "addr" ; gmeow:tPred vcard:street-address ; gmeow:tObj "street" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred vcard:locality ; gmeow:tObj "locality" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred vcard:region ; gmeow:tObj "region" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred vcard:postal-code ; gmeow:tObj "pcode" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred vcard:country-name ; gmeow:tObj "ccode" ]
            [ gmeow:tSubj "addr" ; gmeow:tPred vcard:label ; gmeow:tObj "label" ] ) ] .

gmeow:mapVcardFn a gmeow:ProjectionMapping ;
    rdfs:label "displayable fullName → vcard:fn"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "dispName" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ;
              gmeow:path [ a gmeow:AltPath ; gmeow:pathAlts ( gmeow:hasAppellation gmeow:hasName gmeow:hasOrganizationName gmeow:hasTitle gmeow:hasAgreementName gmeow:hasSoftwareName ) ] ;
              gmeow:objectVar "app" ]
            [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:fullName ; gmeow:objectVar "dispName" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:fullName ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:toPredicate vcard:fn ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnSelectDisplayName ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "non-displayable names (deadnames) dropped" ] .

gmeow:mapVcardGivenName a gmeow:ProjectionMapping ;
    rdfs:label "given-name part → vcard:Name node"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "given" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ;
              gmeow:path [ a gmeow:AltPath ; gmeow:pathAlts ( gmeow:hasAppellation gmeow:hasName gmeow:hasOrganizationName gmeow:hasTitle gmeow:hasAgreementName gmeow:hasSoftwareName ) ] ;
              gmeow:objectVar "app" ]
            [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:hasNamePart ; gmeow:objectVar "np" ]
            [ gmeow:subjectVar "np" ; gmeow:predicate gmeow:namePartType ; gmeow:objectValue gmeow:namePartGiven ]
            [ gmeow:subjectVar "np" ; gmeow:predicate gmeow:partText ; gmeow:objectVar "given" ] ) ;
        gmeow:mint [ gmeow:bindVar "vname" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "ent" ] ) ] "-vcardname" ) ] ) ] ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:partText ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:relation "=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "ent" ; gmeow:tPred vcard:hasName ; gmeow:tObj "vname" ]
            [ gmeow:tSubj "vname" ; gmeow:tPred rdf:type ; gmeow:tObjValue vcard:Name ]
            [ gmeow:tSubj "vname" ; gmeow:tPred vcard:given-name ; gmeow:tObj "given" ] ) ] .

gmeow:mapVcardFamilyName a gmeow:ProjectionMapping ;
    rdfs:label "family-name part → vcard:Name node"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "family" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ;
              gmeow:path [ a gmeow:AltPath ; gmeow:pathAlts ( gmeow:hasAppellation gmeow:hasName gmeow:hasOrganizationName gmeow:hasTitle gmeow:hasAgreementName gmeow:hasSoftwareName ) ] ;
              gmeow:objectVar "app" ]
            [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:hasNamePart ; gmeow:objectVar "np" ]
            [ gmeow:subjectVar "np" ; gmeow:predicate gmeow:namePartType ; gmeow:objectValue gmeow:namePartSurname ]
            [ gmeow:subjectVar "np" ; gmeow:predicate gmeow:partText ; gmeow:objectVar "family" ] ) ;
        gmeow:mint [ gmeow:bindVar "vname" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "ent" ] ) ] "-vcardname" ) ] ) ] ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "app" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:partText ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:relation "=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "ent" ; gmeow:tPred vcard:hasName ; gmeow:tObj "vname" ]
            [ gmeow:tSubj "vname" ; gmeow:tPred rdf:type ; gmeow:tObjValue vcard:Name ]
            [ gmeow:tSubj "vname" ; gmeow:tPred vcard:family-name ; gmeow:tObj "family" ] ) ] .

gmeow:mapVcardNickname a gmeow:ProjectionMapping ;
    rdfs:label "nickname-purpose PersonName → vcard:nickname"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "nick" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:hasName ; gmeow:objectVar "nn" ]
            [ gmeow:subjectVar "nn" ; gmeow:predicate gmeow:namePurpose ; gmeow:objectValue gmeow:namePurposeNickname ]
            [ gmeow:subjectVar "nn" ; gmeow:predicate gmeow:fullName ; gmeow:objectVar "nick" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "nn" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:hasName ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:toPredicate vcard:nickname ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnNicknameName ; gmeow:confidence 0.9 ] .

gmeow:mapVcardBday a gmeow:ProjectionMapping ;
    rdfs:label "Birth life-event date → vcard:bday"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "bdate" ;
        gmeow:atom (
            [ gmeow:subjectVar "b" ; gmeow:predicate gmeow:eventType ; gmeow:objectValue gmeow:eventTypeBirth ]
            [ gmeow:subjectVar "p" ; gmeow:predicate gmeow:participationEvent ; gmeow:objectVar "b" ]
            [ gmeow:subjectVar "p" ; gmeow:predicate gmeow:participationRole ; gmeow:objectValue gmeow:roleParticipantPrincipal ]
            [ gmeow:subjectVar "p" ; gmeow:predicate gmeow:participationParticipant ; gmeow:objectVar "ent" ]
            [ gmeow:subjectVar "b" ; gmeow:predicate gmeow:eventTime ; gmeow:objectVar "bdate" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:toPredicate vcard:bday ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnBirthEventToDate ; gmeow:confidence 0.95 ;
        gmeow:lossyDrop "the birth Participation (role, period, confidence, standpoint) and fuzzy-date bounds are dropped; only the principal's birth instant survives as vcard:bday" ] .

gmeow:mapVcardTitle a gmeow:ProjectionMapping ;
    rdfs:label "Membership Role → vcard:title"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "title" ;
        gmeow:atom (
            [ gmeow:subjectVar "m" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Membership ]
            [ gmeow:subjectVar "m" ; gmeow:predicate gmeow:membershipMember ; gmeow:objectVar "ent" ]
            [ gmeow:subjectVar "m" ; gmeow:predicate gmeow:hasRole ; gmeow:objectVar "r" ]
            [ gmeow:subjectVar "r" ;
              gmeow:path [ a gmeow:AltPath ; gmeow:pathAlts ( rdfs:label gmeow:name ) ] ;
              gmeow:objectVar "title" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:toPredicate vcard:title ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnMembershipToJobTitle ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the Membership relator (organization, period, role, confidence, standpoint) collapses to a flat vcard:title literal; contested membership claims are not distinguished" ] .

gmeow:mapVcardNote a gmeow:ProjectionMapping ;
    rdfs:label "gmeow:description → vcard:note"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "desc" ;
        gmeow:atom ( [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:description ; gmeow:objectVar "desc" ] ) ;
        gmeow:edoalSource gmeow:description ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:toPredicate vcard:note ; gmeow:relation "<=" ; gmeow:confidence 0.8 ] .

gmeow:mapVcardPronouns a gmeow:ProjectionMapping ;
    rdfs:label "PronounSet five forms → vCard PRONOUNS display text (RFC 9554 extension)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "pronouns" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:hasPronounSet ; gmeow:objectVar "ps" ]
            [ gmeow:subjectVar "ps" ; gmeow:predicate gmeow:pronounSubject ; gmeow:objectVar "psubj" ]
            [ gmeow:subjectVar "ps" ; gmeow:predicate gmeow:pronounObject ; gmeow:objectVar "pobj" ]
            [ gmeow:subjectVar "ps" ; gmeow:predicate gmeow:pronounPossessiveDeterminer ; gmeow:objectVar "pdet" ]
            [ gmeow:subjectVar "ps" ; gmeow:predicate gmeow:pronounPossessive ; gmeow:objectVar "ppos" ]
            [ gmeow:subjectVar "ps" ; gmeow:predicate gmeow:pronounReflexive ; gmeow:objectVar "prefl" ] ) ;
        # The FULL five-form declension (subject/object/possessive-determiner/
        # possessive/reflexive, e.g. she/her/her/hers/herself, xe/xem/xyr/xyrs/xemself):
        # free-text PRONOUNS can hold it losslessly, so GMEOW does not flatten it.
        gmeow:bind [ gmeow:bindVar "pronouns" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                [ gmeow:exprVar "psubj" ] "/" [ gmeow:exprVar "pobj" ] "/" [ gmeow:exprVar "pdet" ]
                "/" [ gmeow:exprVar "ppos" ] "/" [ gmeow:exprVar "prefl" ] ) ] ] ;
        gmeow:edoalSource gmeow:hasPronounSet ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:toPredicate vcardx:pronouns ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnPronounSetToText ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the five declined forms are preserved in full (lossless for the declension); only the non-specifying values (any/ask/name-only, which carry no forms) and any period or standpoint are not represented" ] .

gmeow:mapVcardUrl a gmeow:ProjectionMapping ;
    rdfs:label "hasWebPage → vcard:hasURL (the WebPage IRI)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "wp" ;
        gmeow:atom ( [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:hasWebPage ; gmeow:objectVar "wp" ] ) ;
        gmeow:edoalSource gmeow:hasWebPage ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:toPredicate vcard:hasURL ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnWebPageToUrl ; gmeow:confidence 0.8 ] .

# --------------------------------------------------------------------------- #
# Issue #98 — vCard geo: hasCoordinates → vcard:hasGeo via geo: URI (RFC 5870)
# --------------------------------------------------------------------------- #

gmeow:mapVcardGeo a gmeow:ProjectionMapping ;
    rdfs:label "Place coordinates → vcard:hasGeo (vcard:Geo node with geo: URI)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Place ]
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:hasCoordinates ; gmeow:objectVar "c" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:latitude ; gmeow:objectVar "lat" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:longitude ; gmeow:objectVar "lon" ] ) ;
        gmeow:bind [ gmeow:bindVar "geoNode" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    "geo:" [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "lat" ] ) ]
                    "," [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "lon" ] ) ] ) ] ) ] ] ;
        gmeow:bind [ gmeow:bindVar "latDec" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opDecimal ; gmeow:exprArgs ( [ gmeow:exprVar "lat" ] ) ] ] ;
        gmeow:bind [ gmeow:bindVar "lonDec" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opDecimal ; gmeow:exprArgs ( [ gmeow:exprVar "lon" ] ) ] ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:coarsenTo ; gmeow:objectVar "anyLvl" ] ;
        gmeow:edoalSource gmeow:hasCoordinates ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnLatLongToGeoUri ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "elevation is dropped; the coordinate reference frame (WGS84) is implicit in the geo: URI" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "place" ; gmeow:tPred vcard:hasGeo ; gmeow:tObj "geoNode" ]
            [ gmeow:tSubj "geoNode" ; gmeow:tPred rdf:type ; gmeow:tObjValue vcard:Geo ]
            [ gmeow:tSubj "geoNode" ; gmeow:tPred vcard:latitude ; gmeow:tObj "latDec" ]
            [ gmeow:tSubj "geoNode" ; gmeow:tPred vcard:longitude ; gmeow:tObj "lonDec" ] ) ] .

# --- #34 phases 2-3 backlog work-down. ------------------------------------ #
gmeow:mapVcardHasEmail a gmeow:ProjectionMapping ;
    rdfs:label "contact-point email address → vcard:hasEmail"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "vheAgent" ; gmeow:value "vheAddr" ;
        gmeow:atom (
            [ gmeow:subjectVar "vheAgent" ; gmeow:predicate gmeow:hasContactPoint ; gmeow:objectVar "vheAddr" ]
            [ gmeow:subjectVar "vheAddr" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:EmailAddress ] ) ;
        gmeow:edoalSource gmeow:hasContactPoint ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:toPredicate vcard:hasEmail ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "contact-point usage context and validity drop; the bare email edge survives" ] .

gmeow:mapVcardHasTelephone a gmeow:ProjectionMapping ;
    rdfs:label "contact-point telephone number → vcard:hasTelephone"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "vhtAgent" ; gmeow:value "vhtNum" ;
        gmeow:atom (
            [ gmeow:subjectVar "vhtAgent" ; gmeow:predicate gmeow:hasContactPoint ; gmeow:objectVar "vhtNum" ]
            [ gmeow:subjectVar "vhtNum" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:TelephoneNumber ] ) ;
        gmeow:edoalSource gmeow:hasContactPoint ] ;
    gmeow:hasBinding [
        gmeow:profile "vcard" ; gmeow:toPredicate vcard:hasTelephone ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "contact-point usage context and validity drop; the bare telephone edge survives" ] .
