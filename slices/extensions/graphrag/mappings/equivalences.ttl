gmeow:eqProperties080 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:corpusMember ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:distribution ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
