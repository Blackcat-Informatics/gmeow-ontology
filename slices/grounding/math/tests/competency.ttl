#
# Declarative competency questions for the mathematics slice (crates/slicetest): the
# five bedrock questions the charter requires the term surface to answer. Each query
# runs over the merged ontology unioned with the shared fixture (gmeow:cqDataFile),
# and its expected rows are pinned exactly (logic:RowsExact). Boolean flags are
# projected as their string form (STR(...)) so the expected cell is a plain literal.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix wd:    <http://www.wikidata.org/entity/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/math/tests/> .
@prefix exf:   <http://example.org/math/> .
@prefix exs:   <http://example.org/math/statement/> .
# The authored algebra-law witness elements (examples/*.ttl): the native reasoningLogic
# lane queries the consequents the four laws DERIVE over these witnesses.
@prefix exa:   <https://blackcatinformatics.ca/gmeow/examples/math/algebra/> .
# The worked closed-form example (examples/closed-form-functions.ttl).
@prefix exm:   <https://blackcatinformatics.ca/gmeow/examples/math/> .
# The two flagship signed-radial-field scenes (examples/signed-radial-field-*.ttl).
@prefix rqf:   <https://blackcatinformatics.ca/gmeow/examples/math/radial-qual/> .
@prefix rcf:   <https://blackcatinformatics.ca/gmeow/examples/math/radial-cf/> .
@prefix cov:   <https://blackcatinformatics.ca/gmeow/examples/math/coverage/> .
@prefix covf:  <http://example.org/math/coverage/> .
# The worked graded cell complex (examples/graded-cell-complex.ttl).
@prefix exg:   <https://blackcatinformatics.ca/gmeow/examples/math/graded-cell/> .
# The worked combinatorial Laplacian (examples/combinatorial-laplacian.ttl).
@prefix exl:   <https://blackcatinformatics.ca/gmeow/examples/math/combinatorial-laplacian/> .
@prefix exgs:  <https://blackcatinformatics.ca/gmeow/examples/math/global-section/> .
# The multiparameter / zigzag persistence positive fixtures.
@prefix exmf:  <https://blackcatinformatics.ca/gmeow/examples/math/multiparameter-filtration/> .
@prefix expm:  <https://blackcatinformatics.ca/gmeow/examples/math/persistence-module/> .
@prefix expx:  <https://blackcatinformatics.ca/gmeow/examples/math/persistence-morphism/> .
# The connection / holonomy bundle demonstrator (examples/holonomy.ttl).
@prefix exh:   <https://blackcatinformatics.ca/gmeow/examples/math/holonomy/> .
# The worked chain complex (examples/chain-complex.ttl).
@prefix excc:  <https://blackcatinformatics.ca/gmeow/examples/math/chain-complex/> .
# The conforming chain-complex fixture (tests/conformance-fixtures/chain-complex-square-zero-complete.ttl).
@prefix exccf: <http://example.org/math/chain-complex/> .
# The EXECUTABLE-LIFT surface (tests/fixtures/lifted-{r,onnx,proof}.ttl): the producer
# namespace the three shipped lifters mint into. Every IRI below this line is
# content-addressed on the lifted artifact's bytes — nothing here is authorable by hand,
# and a parser change moves the hash and reds these cells.
@prefix lift:  <https://blackcatinformatics.ca/gmeow/examples/math/producers/> .
# The three run-scoped bases (a lifted node's IRI is <run>/<kind>-<hash>).
@prefix liftr: <https://blackcatinformatics.ca/gmeow/examples/math/producers/r-run-ffd06aadf0ff76ac/> .
@prefix lifto: <https://blackcatinformatics.ca/gmeow/examples/math/producers/onnx-run-7978a9f31743d3c2/> .
@prefix liftp: <https://blackcatinformatics.ca/gmeow/examples/math/producers/proof-run-2351ded5a35cacd5/> .

# === Q1 — number system and exactness ====================================== #

ex:cqNumberSystemAndExactness a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/number-system-and-exactness.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Each situated number reports the math:NumberSystem it belongs to and its exactness; over the fixture the answer is exactly {half → ℚ (exact), negFive → ℤ (exact)}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqNumberSystemShape ;
    gmeow:cqExpectRow ex:rowHalf , ex:rowNegFive .

ex:cqNumberSystemShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "number" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "system" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "exact" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHalf a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "number" ; gmeow:cellValueIri exf:half ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "system" ; gmeow:cellValueIri math:rationalNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "exact" ; gmeow:cellValueLiteral "true" ] .

ex:rowNegFive a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "number" ; gmeow:cellValueIri exf:negFive ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "system" ; gmeow:cellValueIri math:integers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "exact" ; gmeow:cellValueLiteral "true" ] .

# === Q1b — the two poles of the signed extended real line and the system they adjoin === #
# Like the topological-defining-law question below, this one carries NO gmeow:cqDataFile:
# the poles and math:ExtendedRealLine live in the ontology (module.ttl), so the query runs
# over the merged asserted store directly. The answer is exactly the two pole → system pairs.
ex:cqSignedExtendedReals a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/signed-extended-reals.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The signed extended real line ℝ̄ reuses the number-system machinery: each pole is situated in it through math:inNumberSystem, exactly as any number situates in ℕ/ℤ/ℚ/ℝ/ℂ. Over the merged ontology the answer is exactly the two pairs {math:NegativeInfinity → math:ExtendedRealLine, math:PositiveInfinity → math:ExtendedRealLine} — the two signed ends adjoined to the reals — confirming the poles are grounded, not free-floating individuals." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqSignedExtendedRealsShape ;
    gmeow:cqExpectRow ex:rowPoleNeg , ex:rowPolePos .

ex:cqSignedExtendedRealsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "pole" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "system" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowPoleNeg a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "pole" ; gmeow:cellValueIri math:NegativeInfinity ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "system" ; gmeow:cellValueIri math:ExtendedRealLine ] .

ex:rowPolePos a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "pole" ; gmeow:cellValueIri math:PositiveInfinity ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "system" ; gmeow:cellValueIri math:ExtendedRealLine ] .

# === Q2 — set extent and condition ========================================= #

ex:cqSetExtentAndCondition a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/set-extent-and-condition.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "An intensional math:SetBuilderExpression reports its math:memberCondition as the logic: formula that denotes it; over the fixture the answer is exactly {evenNumbers → evenFormula}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqSetExtentShape ;
    gmeow:cqExpectRow ex:rowEvenNumbers .

ex:cqSetExtentShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "set" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "condition" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowEvenNumbers a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "set" ; gmeow:cellValueIri exf:evenNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "condition" ; gmeow:cellValueIri exf:evenFormula ] .

# === Q3 — function domain, codomain, image, and inj/surj/bij ================ #

ex:cqFunctionFraming a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/function-domain-codomain-image.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A function reports its domain, codomain, image, and its declared injective/surjective/bijective flags; over the fixture the answer is exactly the single function successor (ℕ → ℕ, image positives, injective, not surjective, not bijective)." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqFunctionShape ;
    gmeow:cqExpectRow ex:rowSuccessor .

ex:cqFunctionShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "function" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "domain" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "codomain" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "image" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "injective" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ,
        [ logic:columnVariable "surjective" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ,
        [ logic:columnVariable "bijective" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowSuccessor a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "function" ; gmeow:cellValueIri exf:successor ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "domain" ; gmeow:cellValueIri exf:naturalsSet ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "codomain" ; gmeow:cellValueIri exf:naturalsSet ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "image" ; gmeow:cellValueIri exf:positivesSet ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "injective" ; gmeow:cellValueLiteral "true" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "surjective" ; gmeow:cellValueLiteral "false" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "bijective" ; gmeow:cellValueLiteral "false" ] .

# === Q3b — a closed-form function's body, formal argument, and frame ======== #

ex:cqClosedFormDefiningExpression a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/closed-form-defining-expression.rq" ;
    gmeow:cqDataFile "examples/closed-form-functions.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A closed-form function reports its body AST (math:definingExpression), its formal argument (math:formalArgument), and its frame (math:domain / math:codomain); over the worked example the answer is exactly the single closed form f(x) = a·x + 1 with body exm:linearBody, formal argument exm:xDeclaration, and frame ℝ → ℝ." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqClosedFormShape ;
    gmeow:cqExpectRow ex:rowLinearForm .

ex:cqClosedFormShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "function" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "definingExpression" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "formalArgument" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "domain" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "codomain" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowLinearForm a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "function" ; gmeow:cellValueIri exm:linearForm ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "definingExpression" ; gmeow:cellValueIri exm:linearBody ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "formalArgument" ; gmeow:cellValueIri exm:xDeclaration ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "domain" ; gmeow:cellValueIri math:realNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "codomain" ; gmeow:cellValueIri math:realNumbers ] .

# === Q3c — the arithmetic operators and their signatures =================== #

ex:cqOperatorSignatures a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/operator-signatures.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Every arithmetic operator reports its signature over the number-system tower through math:operatorDomain and math:operatorCodomain; over the module the answer is exactly the eight framed operators — Addition, Subtraction, Multiplication, Division, and Exponentiation over ℝ → ℝ, Root and Logarithm over ℝ → ℂ, and the unary Negation over the signed extended real line ℝ̄ → ℝ̄." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqOperatorSignatureShape ;
    gmeow:cqExpectRow ex:rowOpAddition , ex:rowOpSubtraction , ex:rowOpMultiplication ,
        ex:rowOpDivision , ex:rowOpExponentiation , ex:rowOpRoot , ex:rowOpLogarithm , ex:rowOpNegation .

ex:cqOperatorSignatureShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "operator" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "operatorDomain" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "operatorCodomain" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowOpAddition a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operator" ; gmeow:cellValueIri math:Addition ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorDomain" ; gmeow:cellValueIri math:realNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorCodomain" ; gmeow:cellValueIri math:realNumbers ] .

ex:rowOpSubtraction a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operator" ; gmeow:cellValueIri math:Subtraction ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorDomain" ; gmeow:cellValueIri math:realNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorCodomain" ; gmeow:cellValueIri math:realNumbers ] .

ex:rowOpMultiplication a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operator" ; gmeow:cellValueIri math:Multiplication ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorDomain" ; gmeow:cellValueIri math:realNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorCodomain" ; gmeow:cellValueIri math:realNumbers ] .

ex:rowOpDivision a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operator" ; gmeow:cellValueIri math:Division ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorDomain" ; gmeow:cellValueIri math:realNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorCodomain" ; gmeow:cellValueIri math:realNumbers ] .

ex:rowOpExponentiation a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operator" ; gmeow:cellValueIri math:Exponentiation ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorDomain" ; gmeow:cellValueIri math:realNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorCodomain" ; gmeow:cellValueIri math:realNumbers ] .

ex:rowOpRoot a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operator" ; gmeow:cellValueIri math:Root ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorDomain" ; gmeow:cellValueIri math:realNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorCodomain" ; gmeow:cellValueIri math:complexNumbers ] .

ex:rowOpLogarithm a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operator" ; gmeow:cellValueIri math:Logarithm ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorDomain" ; gmeow:cellValueIri math:realNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorCodomain" ; gmeow:cellValueIri math:complexNumbers ] .

ex:rowOpNegation a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operator" ; gmeow:cellValueIri math:Negation ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorDomain" ; gmeow:cellValueIri math:ExtendedRealLine ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operatorCodomain" ; gmeow:cellValueIri math:ExtendedRealLine ] .

# === Q4 — set cardinality ================================================== #

ex:cqSetCardinality a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/set-cardinality.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Each set reports its cardinality; over the fixture the answer is exactly {primesUnderTen → finite, allNaturals → ℵ₀, xsdByteValueSpace → finite (the grounded xsd:byte value-space pigeonhole bound)}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqCardinalityShape ;
    gmeow:cqExpectRow ex:rowPrimes , ex:rowAllNaturals , ex:rowXsdByteValueSpace .

ex:cqCardinalityShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "set" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "cardinality" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowPrimes a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "set" ; gmeow:cellValueIri exf:primesUnderTen ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "cardinality" ; gmeow:cellValueIri math:cardinalityFinite ] .

ex:rowAllNaturals a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "set" ; gmeow:cellValueIri exf:allNaturals ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "cardinality" ; gmeow:cellValueIri math:alephNull ] .

ex:rowXsdByteValueSpace a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "set" ; gmeow:cellValueIri math:xsdByteValueSpace ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "cardinality" ; gmeow:cellValueIri math:cardinalityFinite ] .

# === Q4b — an ordered interval's endpoints and endpoint inclusions ========== #

ex:cqIntervalEndpointsAndInclusion a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/interval-endpoints-and-inclusion.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Each ordered interval reports both endpoints and, for each end, whether it is closed (included) or open (excluded); over the fixture the answer is exactly {halfOpenUnit → 0 closed, 1 open; positiveReals → 0 open, +∞ (math:PositiveInfinity) open}. Endpoints are projected as strings so a finite literal and a pole IRI share one column." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqIntervalShape ;
    gmeow:cqExpectRow ex:rowHalfOpenUnit , ex:rowPositiveReals .

ex:cqIntervalShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "interval" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "lower" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ,
        [ logic:columnVariable "lowerIncl" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "upper" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ,
        [ logic:columnVariable "upperIncl" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHalfOpenUnit a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "interval" ; gmeow:cellValueIri exf:halfOpenUnit ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lower" ; gmeow:cellValueLiteral "0.0" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lowerIncl" ; gmeow:cellValueIri math:closedEndpoint ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "upper" ; gmeow:cellValueLiteral "1.0" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "upperIncl" ; gmeow:cellValueIri math:openEndpoint ] .

ex:rowPositiveReals a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "interval" ; gmeow:cellValueIri exf:positiveReals ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lower" ; gmeow:cellValueLiteral "0.0" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lowerIncl" ; gmeow:cellValueIri math:openEndpoint ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "upper" ; gmeow:cellValueLiteral "https://blackcatinformatics.ca/math/PositiveInfinity" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "upperIncl" ; gmeow:cellValueIri math:openEndpoint ] .

# === Q5 — named constants and their anchors ================================ #

ex:cqNamedConstantsAndAnchors a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/named-constants-and-anchors.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A named constant reports the external anchor reached through its fixture-local anchor record; over the fixture the answer is exactly {math:pi → wd:Q167}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqConstantsShape ;
    gmeow:cqExpectRow ex:rowPiAnchor .

ex:cqConstantsShape a logic:ResultShape ;
