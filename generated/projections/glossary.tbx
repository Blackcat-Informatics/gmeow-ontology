            <term>交叉熵</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-2e7f54963cd96ae8">
        <langSet xml:lang="en">
          <tig>
            <term>Incomplete Cellular Sheaf</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Faisceau cellulaire incomplet</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>不完整胞腔层</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-2e83bb4b1406726d">
        <langSet xml:lang="en">
          <tig>
            <term>The failure raised when a Clifford algebra lacks its scalar field, signature, basis blades, grading, product/involution frame, or exact vector-space dimension.</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>L'échec levé quand une algèbre manque corps, signature, lames, graduation, produits ou involutions, ou dimension exacte.</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>Clifford 代数缺少标量域、符号差、基刀片、分次、乘积或对合框架、或精确向量空间维数时引发的失败。</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-2e88ca7a9fe0c554">
        <langSet xml:lang="en">
          <tig>
            <term>The audited named-key ruling for the circled-plus notation associated with math:DirectSumDecomposition.</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>La décision auditée d'utiliser une clé nommée pour la notation plus cerclé associée à math:DirectSumDecomposition.</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>对 math:DirectSumDecomposition 的圈加记法采用具名键之审核裁定。</term>
          </tig>
        </langSet>
      </termEntry>
