# === Q — every grounded topological property with its defining law/boundary === #
# Unlike the fixture-backed questions above, this one carries NO gmeow:cqDataFile:
# the math:definingLaw backing edges live in the ontology (module.ttl), so the query
# runs over the merged asserted store directly (crates/slicetest exec.rs: data_file
# None => the merged store itself). The answer is exactly the eight grounded
# topological property -> law/boundary pairs.
ex:cqTopologicalDefiningLaw a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/topological-property-defining-law.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Each grounded topological property reports its machine-audited backing edge math:definingLaw; over the merged ontology the answer is exactly the eight pairs {ContinuousMap → continuityLaw, ConnectedSpace → connectednessLaw, CompactSpace → compactnessBoundary, t0Separation → t0SeparationLaw, t1Separation → t1SeparationLaw, hausdorffSeparation → hausdorffLaw, t3Separation → regularitySeparationLaw, t4Separation → normalitySeparationLaw}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqTopoLawShape ;
    gmeow:cqExpectRow ex:rowLawContinuity , ex:rowLawConnectedness , ex:rowLawCompactness ,
        ex:rowLawT0 , ex:rowLawT1 , ex:rowLawHausdorff , ex:rowLawT3 , ex:rowLawT4 .

ex:cqTopoLawShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "property" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "backing" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
