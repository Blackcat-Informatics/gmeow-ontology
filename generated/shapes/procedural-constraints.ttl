    logic:formalizes <https://blackcatinformatics.ca/gmeow/OpaqueFrame> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/OpaqueFrame> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A missing-key opaque frame must name at least one gmeow:sealedRecipient — sealed content has a declared audience." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/opacityReason> <https://blackcatinformatics.ca/gmeow/opacityMissingKey> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/sealedRecipient> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/logic/TermCarrierIndexConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/logic/TermCarrier> ;
