# === Q — ∂∘∂ = 0: the boundary square-zero law derives the cancelling pair === #

ex:cqBoundarySquareZero a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/boundary-square-zero.rq" ;
    gmeow:cqReasoning gmeow:reasoningLogic ;
    gmeow:cqRationale "The boundary square-zero law ∂∘∂ = 0 made a LIVE entailment consumer: authored as a real first-order logic:Formula over the reified incidence signature and evaluated by the native logic: reasoner over the concrete simplicial triangle, it DERIVES the binary consequent math:cancellingPairRel(edgeAB, edgeAC) — the two intermediate edges composing faceABC to vertexA with opposite sign products, the fixed-point-free involution of the codimension-2 diamond. Nothing asserts that tuple; only the law derives it. Over the reasoned closure, pinned by VALUES to edgeAB, the answer is exactly {edgeAB, edgeAC}. Removing the law formula makes the answer empty." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqBoundarySquareZeroShape ;
    gmeow:cqExpectRow ex:rowBoundarySquareZero .

ex:cqBoundarySquareZeroShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "b" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "bp" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowBoundarySquareZero a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "b" ; gmeow:cellValueIri excc:edgeAB ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "bp" ; gmeow:cellValueIri excc:edgeAC ] .

# === Q — δ∘δ = 0: the coboundary square-zero law derives the co-cancelling pair #

ex:cqCoboundarySquareZero a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/coboundary-square-zero.rq" ;
    gmeow:cqReasoning gmeow:reasoningLogic ;
    gmeow:cqRationale "The coboundary square-zero law δ∘δ = 0 made a LIVE entailment consumer: authored as a distinct first-order logic:Formula over the transposed coface traversal and evaluated by the native logic: reasoner over the concrete triangle, it DERIVES the binary consequent math:coCancellingPairRel(edgeAB, edgeAC) — the two intermediate cofaces of the upward co-diamond over (vertexA, faceABC). Nothing asserts that tuple; only the law derives it. Over the reasoned closure, pinned by VALUES to edgeAB, the answer is exactly {edgeAB, edgeAC}. Removing the law formula makes the answer empty." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqCoboundarySquareZeroShape ;
    gmeow:cqExpectRow ex:rowCoboundarySquareZero .

ex:cqCoboundarySquareZeroShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "b" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "bp" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowCoboundarySquareZero a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "b" ; gmeow:cellValueIri excc:edgeAB ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "bp" ; gmeow:cellValueIri excc:edgeAC ] .

# === Q — the homology quotient frame H = Z/B =============================== #

ex:cqHomologyQuotientFrame a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/homology-quotient-frame.rq" ;
    gmeow:cqDataFile "tests/conformance-fixtures/chain-complex-square-zero-complete.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:HomologyGroup reports the math:Cycle (the numerator Z) and the bounding math:Boundary (the denominator B) that generate it as the quotient H = Z/B; over the filled triangle the answer is exactly {homologyH1 → cycleZ / boundaryB}, the 1-cycle that bounds faceABC so its homology class is zero." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqHomologyQuotientShape ;
    gmeow:cqExpectRow ex:rowHomologyQuotient .

ex:cqHomologyQuotientShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "homology" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "cycle" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "boundary" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHomologyQuotient a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "homology" ; gmeow:cellValueIri exccf:homologyH1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "cycle" ; gmeow:cellValueIri exccf:cycleZ ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "boundary" ; gmeow:cellValueIri exccf:boundaryB ] .

# === Q — the constant sheaf recovers cellular homology ==================== #

ex:cqConstantSheafRecoversHomology a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/constant-sheaf-recovers-homology.rq" ;
    gmeow:cqDataFile "tests/conformance-fixtures/chain-complex-square-zero-complete.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:ConstantSheaf reports, through math:recoversHomology, the cellular math:HomologyGroup its sheaf cohomology recovers; over the filled triangle the answer is exactly {constantSheaf → homologyH1}, confirming the sheaf-Laplacian machinery generalises plain homology rather than replacing it." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqConstantSheafShape ;
    gmeow:cqExpectRow ex:rowConstantSheaf .

ex:cqConstantSheafShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "sheaf" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "homology" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowConstantSheaf a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sheaf" ; gmeow:cellValueIri exccf:constantSheaf ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "homology" ; gmeow:cellValueIri exccf:homologyH1 ] .

# === Multiparameter / zigzag persistence OBJECT frames =========================== #

ex:cqMultiparameterFiltrationFrame a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/multiparameter-filtration-frame.rq" ;
    gmeow:cqDataFile "examples/multiparameter-filtration-complete.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:MultiparameterFiltration exposes its parameter poset (math:filtrationIndexPoset) and its stages, each carrying a math:multiIndex tuple rather than a single real threshold — the frame that keeps the multi-parameter index inspectable and the object distinct from the math:MultiparameterPersistence activity." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqMultiparameterFiltrationFrameShape ;
    gmeow:cqExpectRow ex:rowMultiparameterFiltrationFrame .

ex:cqMultiparameterFiltrationFrameShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "filtration" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "poset" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "stage" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "index" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowMultiparameterFiltrationFrame a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "filtration" ; gmeow:cellValueIri exmf:filtration ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "poset" ; gmeow:cellValueIri exmf:grid ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "stage" ; gmeow:cellValueIri exmf:stage ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "index" ; gmeow:cellValueIri exmf:index ] .

ex:cqPersistenceModuleFrame a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/persistence-module-frame.rq" ;
    gmeow:cqDataFile "examples/persistence-module-complete.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:PersistenceModule exposes the index poset it is a functor over (math:moduleIndex) and its comparable-pair transition maps (math:structureMap) — the functor frame that keeps the algebraic object distinct from a single feature's math:PersistenceLifetime." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqPersistenceModuleFrameShape ;
    gmeow:cqExpectRow ex:rowPersistenceModuleFrame .

ex:cqPersistenceModuleFrameShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "module" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "index" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "map" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowPersistenceModuleFrame a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "module" ; gmeow:cellValueIri expm:module ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "index" ; gmeow:cellValueIri expm:indexPoset ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "map" ; gmeow:cellValueIri expm:transition01 ] .

ex:cqPersistenceMorphismFrame a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/persistence-morphism-frame.rq" ;
    gmeow:cqDataFile "examples/persistence-morphism-complete.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:PersistenceMorphism exposes both endpoints — its domain math:morphismSource and its codomain math:morphismTarget, each a math:PersistenceModule — the map-of-modules frame that keeps a map between modules from floating free of the modules it relates." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqPersistenceMorphismFrameShape ;
    gmeow:cqExpectRow ex:rowPersistenceMorphismFrame .

ex:cqPersistenceMorphismFrameShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "morphism" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "source" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "target" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowPersistenceMorphismFrame a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "morphism" ; gmeow:cellValueIri expx:morphism ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "source" ; gmeow:cellValueIri expx:sourceModule ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "target" ; gmeow:cellValueIri expx:targetModule ] .

# === Connections / holonomy / parallel transport ============================ #

ex:cqHolonomyLoopFrame a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/holonomy-loop-frame.rq" ;
    gmeow:cqDataFile "examples/holonomy.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:Holonomy exposes BOTH its closed loop (math:holonomyLoop) and the math:Connection whose parallel transport it composes (math:holonomyOf) — the transport-around-a-loop frame. The bundle demonstrator carries two holonomies: the discrete sheaf-connection holonomy around the 3-cell loop and the manifold holonomy around a coordinate loop, so the answer is exactly those two {holonomy → loop / connection} rows." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqHolonomyLoopFrameShape ;
    gmeow:cqExpectRow ex:rowHolonomyLoopDiscrete , ex:rowHolonomyLoopManifold .

ex:cqHolonomyLoopFrameShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "holonomy" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "loop" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "connection" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHolonomyLoopDiscrete a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "holonomy" ; gmeow:cellValueIri exh:discreteHolonomy ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "loop" ; gmeow:cellValueIri exh:loop ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "connection" ; gmeow:cellValueIri exh:discreteConnection ] .

ex:rowHolonomyLoopManifold a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "holonomy" ; gmeow:cellValueIri exh:manifoldHolonomy ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "loop" ; gmeow:cellValueIri exh:manifoldLoop ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "connection" ; gmeow:cellValueIri exh:manifoldConnection ] .

ex:cqDiscreteConnectionFlatness a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/discrete-connection-flatness.rq" ;
    gmeow:cqDataFile "examples/holonomy.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:FlatConnection is the discrete sheaf connection (math:connectionOfSheaf) whose transport cochain (math:transportCochain) is a math:Cocycle — flat ⇔ closed. Over the bundle demonstrator's sheaf data the answer is exactly {discreteConnection → loopSheaf / transportCocycle}, the checkable discrete witness of flatness (the universal path-ordered curvature stays the honest math:holonomyCurvatureBoundary)." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqDiscreteConnectionFlatnessShape ;
    gmeow:cqExpectRow ex:rowDiscreteConnectionFlatness .

ex:cqDiscreteConnectionFlatnessShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "connection" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "sheaf" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "cochain" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowDiscreteConnectionFlatness a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "connection" ; gmeow:cellValueIri exh:discreteConnection ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sheaf" ; gmeow:cellValueIri exh:loopSheaf ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "cochain" ; gmeow:cellValueIri exh:transportCocycle ] .
