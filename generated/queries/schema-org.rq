        ?prof a gmeow:LanguageProficiency .
        ?prof gmeow:proficiencyAgent ?knower .
        ?prof gmeow:proficiencyLanguage ?known .
        FILTER NOT EXISTS { ?prof gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:hasWebPage ?wp .
        FILTER NOT EXISTS { ?ent gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:hasName ?nname .
        ?nname gmeow:namePurpose gmeow:namePurposeNickname .
        ?nname gmeow:fullName ?nick .
        FILTER NOT EXISTS { ?nname gmeow:displayable false . }
        FILTER NOT EXISTS { ?ent gmeow:displayable false . }
    }
    UNION {
        ?birth gmeow:eventType gmeow:eventTypeBirth .
        ?p gmeow:participationEvent ?birth .
        ?p gmeow:participationRole gmeow:roleParticipantPrincipal .
        ?p gmeow:participationParticipant ?person .
        ?birth gmeow:eventTime ?bdate .
        FILTER NOT EXISTS { ?birth gmeow:displayable false . }
        FILTER NOT EXISTS { ?p gmeow:displayable false . }
    }
    UNION {
        ?m a gmeow:Membership .
        ?m gmeow:membershipMember ?member .
        ?m gmeow:hasRole ?role .
        ?role rdfs:label|gmeow:name ?title .
        FILTER NOT EXISTS { ?m gmeow:displayable false . }
        FILTER NOT EXISTS { ?role gmeow:displayable false . }
    }
    UNION {
        ?dept gmeow:subOrganizationOf ?parent .
        FILTER NOT EXISTS { ?dept gmeow:displayable false . }
    }
    UNION {
        ?pAtt gmeow:participationEvent ?attEvent .
        ?pAtt gmeow:participationRole gmeow:roleAttendee .
        ?pAtt gmeow:participationParticipant ?attendee .
        FILTER NOT EXISTS { ?pAtt gmeow:displayable false . }
    }
    UNION {
        ?pPerf gmeow:participationEvent ?perfEvent .
        ?pPerf gmeow:participationRole gmeow:rolePerformer .
        ?pPerf gmeow:participationParticipant ?performer .
        FILTER NOT EXISTS { ?pPerf gmeow:displayable false . }
    }
    UNION {
        ?pOrg gmeow:participationEvent ?orgEvent .
        ?pOrg gmeow:participationRole gmeow:roleOrganizer .
        ?pOrg gmeow:participationParticipant ?organizer .
        FILTER NOT EXISTS { ?pOrg gmeow:displayable false . }
    }
    UNION {
        ?event gmeow:earliestStart ?start .
        FILTER NOT EXISTS { ?event gmeow:displayable false . }
    }
    UNION {
        ?work gmeow:hasLicense ?lic .
        FILTER NOT EXISTS { ?work gmeow:displayable false . }
    }
    UNION {
        ?cw gmeow:hasCopyright ?cr .
        ?cr gmeow:copyrightHolder ?holder .
        FILTER NOT EXISTS { ?cw gmeow:displayable false . }
        FILTER NOT EXISTS { ?cr gmeow:displayable false . }
    }
    UNION {
        ?cw gmeow:hasCopyright ?cr .
        ?cr gmeow:copyrightYear ?yr .
        FILTER NOT EXISTS { ?cw gmeow:displayable false . }
        FILTER NOT EXISTS { ?cr gmeow:displayable false . }
    }
    UNION {
        ?cw gmeow:hasCopyright ?cr .
        ?cr gmeow:copyrightNotice ?notice .
        FILTER NOT EXISTS { ?cw gmeow:displayable false . }
        FILTER NOT EXISTS { ?cr gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:attributionText ?credit .
        FILTER NOT EXISTS { ?ent gmeow:displayable false . }
    }
    UNION {
        ?mark a gmeow:Mark .
        FILTER NOT EXISTS { ?mark gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:isAccessibleForFree ?free .
        FILTER NOT EXISTS { ?ent gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:acquireLicensePage ?alp .
        FILTER NOT EXISTS { ?ent gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:usageInfo ?ui .
        FILTER NOT EXISTS { ?ent gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:conditionsOfAccess ?coa .
        FILTER NOT EXISTS { ?ent gmeow:displayable false . }
    }
    UNION {
        ?route a gmeow:Route .
        FILTER NOT EXISTS { ?route gmeow:displayable false . }
    }
    UNION {
        ?org a gmeow:Organization .
        ?org gmeow:hasCreationEvent ?cevent .
        ?cevent gmeow:eventTime ?fdate .
        FILTER NOT EXISTS { ?org gmeow:displayable false . }
        FILTER NOT EXISTS { ?cevent gmeow:displayable false . }
    }
    UNION {
        ?org a gmeow:Organization .
        ?org gmeow:hasDestructionEvent ?devent .
        ?devent gmeow:eventTime ?ddate .
        FILTER NOT EXISTS { ?org gmeow:displayable false . }
        FILTER NOT EXISTS { ?devent gmeow:displayable false . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:hasCapacity ?cap .
        ?cap gmeow:observationResult ?sq .
        ?sq gmeow:quantityValue ?capVal .
        FILTER NOT EXISTS { ?cap gmeow:displayable false . }
        FILTER NOT EXISTS { ?place gmeow:displayable false . }
        FILTER NOT EXISTS { ?sq gmeow:displayable false . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:hasOccupancy ?occ .
        ?occ gmeow:observationResult ?sq2 .
        ?sq2 gmeow:quantityValue ?occVal .
        FILTER NOT EXISTS { ?occ gmeow:displayable false . }
        FILTER NOT EXISTS { ?place gmeow:displayable false . }
        FILTER NOT EXISTS { ?sq2 gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:locatedAt ?loc .
        FILTER NOT EXISTS { ?ent gmeow:displayable false . }
    }
    UNION {
        ?place gmeow:hasPlaceName ?pn .
        ?pn gmeow:fullName ?allName .
        FILTER NOT EXISTS { ?pn gmeow:displayable false . }
        FILTER NOT EXISTS { ?place gmeow:displayable false . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:hasCoordinateObservation ?obs .
        ?obs gmeow:coordinateResult ?coords .
        OPTIONAL {
            ?coords gmeow:latitude ?lat .
        }
        OPTIONAL {
            ?coords gmeow:longitude ?lon .
        }
        OPTIONAL {
            ?coords gmeow:elevation ?elev .
        }
        FILTER NOT EXISTS { ?place gmeow:coarsenTo ?anyLvl . }
        FILTER NOT EXISTS { ?obs gmeow:displayable false . }
        FILTER NOT EXISTS { ?place gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:description ?desc .
        FILTER NOT EXISTS { ?ent gmeow:displayable false . }
        FILTER EXISTS { ?ent gmeow:eligibleForConsumer gmeow:consumerPublicSite . }
        OPTIONAL {
            ?_lang gmeow:languageTag ?_intTag .
            FILTER(isLiteral(?desc) && LANG(?desc) = ?_intTag)
            ?_lang gmeow:bcp47Tag ?_extTag .
        }
        BIND ( IF(BOUND(?_extTag), STRLANG(STR(?desc), STR(?_extTag)), ?desc) AS ?_final_desc )
    }
    UNION {
        ?org gmeow:organizationType ?otype .
        VALUES ( ?otype ?otypeClass ) {
            ( gmeow:organizationTypeCompany schema:Corporation )
            ( gmeow:organizationTypeNonprofit schema:NGO )
            ( gmeow:organizationTypeGovernmentBody schema:GovernmentOrganization )
            ( gmeow:organizationTypeEducationalInstitution schema:EducationalOrganization )
            ( gmeow:organizationTypeAssociation schema:Organization )
            ( gmeow:organizationTypeCollaboration schema:Project )
        }
        FILTER NOT EXISTS { ?org gmeow:displayable false . }
    }
    UNION {
        ?post a gmeow:Post .
        ?post gmeow:postIn ?postOrg .
        ?mem gmeow:fillsPost ?post .
        ?mem gmeow:hasRole ?role .
        ?role rdfs:label|gmeow:name ?roleName .
        FILTER NOT EXISTS { ?post gmeow:displayable false . }
        FILTER NOT EXISTS { ?mem gmeow:displayable false . }
        FILTER NOT EXISTS { ?role gmeow:displayable false . }
    }
    UNION {
        ?org gmeow:hasSite ?site .
        FILTER NOT EXISTS { ?org gmeow:displayable false . }
    }
    UNION {
        ?org gmeow:legalIdentifier ?id .
        ?id gmeow:identifierValue ?lei .
        ?id gmeow:identifierScheme "lei" .
        FILTER NOT EXISTS { ?org gmeow:displayable false . }
        FILTER NOT EXISTS { ?id gmeow:displayable false . }
    }
    UNION {
        ?org gmeow:industryClassification ?id .
        ?id gmeow:identifierValue ?naics .
        ?id gmeow:identifierScheme "naics" .
        FILTER NOT EXISTS { ?org gmeow:displayable false . }
        FILTER NOT EXISTS { ?id gmeow:displayable false . }
    }
    UNION {
        ?org gmeow:industryClassification ?id .
        ?id gmeow:identifierValue ?isic .
        ?id gmeow:identifierScheme "isicV4" .
        FILTER NOT EXISTS { ?org gmeow:displayable false . }
        FILTER NOT EXISTS { ?id gmeow:displayable false . }
    }
    UNION {
        ?prof a gmeow:SkillProficiency .
        ?prof gmeow:skillProficiencyAgent ?agent .
        ?prof gmeow:skillProficiencyOf ?skill .
        FILTER NOT EXISTS { ?prof gmeow:displayable false . }
    }
    UNION {
        ?agent gmeow:holdsCredential ?cred .
        FILTER NOT EXISTS { ?agent gmeow:displayable false . }
    }
    UNION {
        ?cred a gmeow:Credential .
        ?cred gmeow:credentialIssuer ?issuer .
        FILTER NOT EXISTS { ?cred gmeow:displayable false . }
    }
    UNION {
        ?cred a gmeow:Credential .
        ?cred gmeow:credentialFor ?target .
        FILTER NOT EXISTS { ?cred gmeow:displayable false . }
    }
    UNION {
        ?identEnt gmeow:identifier ?identVal .
        FILTER NOT EXISTS { ?identEnt gmeow:displayable false . }
    }
    UNION {
        ?absWork gmeow:abstract ?absText .
        FILTER NOT EXISTS { ?absWork gmeow:displayable false . }
    }
    UNION {
        ?modWork gmeow:dateModified ?modDate .
        FILTER NOT EXISTS { ?modWork gmeow:displayable false . }
    }
    UNION {
        ?hlArticle a gmeow:Article .
        ?hlArticle gmeow:title ?hlText .
        FILTER NOT EXISTS { ?hlArticle gmeow:displayable false . }
        OPTIONAL {
            ?_lang gmeow:languageTag ?_intTag .
            FILTER(isLiteral(?hlText) && LANG(?hlText) = ?_intTag)
            ?_lang gmeow:bcp47Tag ?_extTag .
        }
        BIND ( IF(BOUND(?_extTag), STRLANG(STR(?hlText), STR(?_extTag)), ?hlText) AS ?_final_hlText )
    }
    UNION {
        ?subjWork gmeow:isAbout ?subjTopic .
        FILTER NOT EXISTS { ?subjWork gmeow:displayable false . }
    }
    UNION {
        ?affPerson a gmeow:Person .
        ?affPerson gmeow:memberOf ?affOrg .
        FILTER NOT EXISTS { ?affPerson gmeow:displayable false . }
    }
    UNION {
        ?skillPerson gmeow:hasSkill ?skillVal .
        FILTER NOT EXISTS { ?skillPerson gmeow:displayable false . }
    }
    UNION {
        ?ddEvent gmeow:eventType gmeow:eventTypeDeath .
        ?ddPart gmeow:participationEvent ?ddEvent .
        ?ddPart gmeow:participationRole gmeow:roleParticipantPrincipal .
        ?ddPart gmeow:participationParticipant ?ddPerson .
        ?ddEvent gmeow:eventTime ?ddWhen .
        FILTER NOT EXISTS { ?ddEvent gmeow:displayable false . }
        FILTER NOT EXISTS { ?ddPart gmeow:displayable false . }
    }
    UNION {
        ?bpEvent gmeow:eventType gmeow:eventTypeBirth .
        ?bpPart gmeow:participationEvent ?bpEvent .
        ?bpPart gmeow:participationRole gmeow:roleParticipantPrincipal .
        ?bpPart gmeow:participationParticipant ?bpPerson .
        ?bpEvent gmeow:eventLocation ?bpWhere .
        FILTER NOT EXISTS { ?bpEvent gmeow:displayable false . }
        FILTER NOT EXISTS { ?bpPart gmeow:displayable false . }
    }
    UNION {
        ?dpEvent gmeow:eventType gmeow:eventTypeDeath .
        ?dpPart gmeow:participationEvent ?dpEvent .
        ?dpPart gmeow:participationRole gmeow:roleParticipantPrincipal .
        ?dpPart gmeow:participationParticipant ?dpPerson .
        ?dpEvent gmeow:eventLocation ?dpWhere .
        FILTER NOT EXISTS { ?dpEvent gmeow:displayable false . }
        FILTER NOT EXISTS { ?dpPart gmeow:displayable false . }
    }
    UNION {
        ?crWork gmeow:hasAuthor ?crAgent .
        FILTER NOT EXISTS { ?crWork gmeow:displayable false . }
    }
    UNION {
        ?ssrcRepo a gmeow:Repository .
        OPTIONAL {
            ?ssrcRepo gmeow:webUrl ?ssrcUrl .
        }
        FILTER NOT EXISTS { ?ssrcRepo gmeow:displayable false . }
    }
    UNION {
        ?smtC a gmeow:Contribution .
        ?smtC gmeow:contributionTarget ?smtProj .
        ?smtC gmeow:contributor ?smtAgent .
        ?smtC gmeow:contributionRole gmeow:roleSoftwareMaintainer .
        FILTER NOT EXISTS { ?smtAgent gmeow:displayable false . }
        FILTER NOT EXISTS { ?smtC gmeow:displayable false . }
    }
    UNION {
        ?mvEv gmeow:eventFromLocation ?mvFrom .
        FILTER NOT EXISTS { ?mvEv gmeow:displayable false . }
    }
    UNION {
        ?mvtEv gmeow:eventToLocation ?mvTo .
        FILTER NOT EXISTS { ?mvtEv gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:hasTag ?tag .
        ?tag rdfs:label ?kw .
        FILTER NOT EXISTS { ?tag gmeow:displayable false . }
        FILTER NOT EXISTS { ?ent gmeow:displayable false . }
        OPTIONAL {
            ?_lang gmeow:languageTag ?_intTag .
            FILTER(isLiteral(?kw) && LANG(?kw) = ?_intTag)
            ?_lang gmeow:bcp47Tag ?_extTag .
        }
        BIND ( IF(BOUND(?_extTag), STRLANG(STR(?kw), STR(?_extTag)), ?kw) AS ?_final_kw )
    }
    UNION {
        ?tagging a gmeow:Tagging .
        ?tagging gmeow:taggingTagged ?ent .
        ?tagging gmeow:taggingTag ?tag .
        ?tag rdfs:label ?kw .
        FILTER NOT EXISTS { ?tagging gmeow:displayable false . }
        FILTER NOT EXISTS { ?tag gmeow:displayable false . }
        OPTIONAL {
            ?_lang gmeow:languageTag ?_intTag .
            FILTER(isLiteral(?kw) && LANG(?kw) = ?_intTag)
            ?_lang gmeow:bcp47Tag ?_extTag .
        }
        BIND ( IF(BOUND(?_extTag), STRLANG(STR(?kw), STR(?_extTag)), ?kw) AS ?_final_kw )
    }
    UNION {
        ?note a gmeow:Note .
        OPTIONAL { ?note gmeow:noteContent ?content . }
        OPTIONAL { ?note gmeow:noteAuthor ?author . }
        OPTIONAL { ?note gmeow:commentParent ?parent . }
        FILTER NOT EXISTS { ?note gmeow:displayable false . }
        FILTER NOT EXISTS { ?parent gmeow:displayable false . }
    }
}
