#
# Declarative structural assertions for the versions slice — the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_versions.py. Each assertion runs as a
# SPARQL ASK over the versions module graph (gmeow:scopeModule) under the
# native Rust harness (crates/slicetest).
#
# Versions is migrated, so class stereotypes are logic:
# (logic:Kind, logic:SubKind, logic:AbstractIndividualType, logic:QualityValue,
# logic:Relator), not gufo:.
#
# gmeow:versionLabel (domain gmeow:Entity, domain-general — any versioned
# artifact, not only versions-slice types) is now defined here rather than in
# slices/extensions/languages/module.ttl, so its domain is covered by a
# scopeModule assertion below (assertion 17) instead of a cross-slice pytest
# check.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/versions/tests/> .

# --- 1. VersionSet is a logic:Kind subclass of InformationObject (MUST) --------
ex:saVersionSetIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:VersionSet a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:VersionSet MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject — the version lineage is a first-class information object so it can carry identifiers and authority links." .

# --- 2. VersionMembership is a logic:SubKind of Observation and logic:Relator (MUST) ---
ex:saVersionMembershipIsObservationAndRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:VersionMembership a owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:VersionMembership MUST be an owl:Class, a subclass of gmeow:Observation (universal claim stack), and a subclass of logic:Relator (reified mediation relator) — the dual typing keeps it in OWL 2 DL and hooks it into the observation spine." .

# --- 3a. versionMember is an ObjectProperty (MUST) -----
ex:saVersionMemberFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:versionMember a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:versionMember MUST be an owl:ObjectProperty — one member per VersionMembership relator; a second member collapses the two." .

# --- 3b. versionSet is an ObjectProperty (MUST) --------
ex:saVersionSetPropertyFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:versionSet a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:versionSet MUST be an owl:ObjectProperty — one set per VersionMembership relator." .

# --- 4a. versionRole is an ObjectProperty (MUST) ------------------------------
ex:saVersionRoleIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:versionRole a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:versionRole MUST be an owl:ObjectProperty — it carries the standpoint-scoped role classification for a membership." .

# --- 4b. versionRole is NOT functional (MUST-NOT) ----------------------------
ex:saVersionRoleNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    ?rec logic:characterizes gmeow:versionRole ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "gmeow:versionRole MUST NOT be functional — competing authority roles coexist without privilege (Principle 9); standpoint-indexed coexistence requires non-functionality." .

# --- 4c. versionScale is an ObjectProperty (MUST) ----------------------------
ex:saVersionScaleIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:versionScale a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:versionScale MUST be an owl:ObjectProperty — it carries the magnitude classification for a membership." .

# --- 4d. versionScale is NOT functional (MUST-NOT) ---------------------------
ex:saVersionScaleNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    ?rec logic:characterizes gmeow:versionScale ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "gmeow:versionScale MUST NOT be functional — rival scheme classifications coexist; standpoint-indexed coexistence requires non-functionality (Principle 9)." .

# --- 5. membershipInterval is an ObjectProperty with range TimeInterval (MUST) ---
ex:saMembershipIntervalProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:membershipInterval a owl:ObjectProperty ;
        rdfs:range gmeow:TimeInterval .
}""" ;
    gmeow:saRationale "gmeow:membershipInterval MUST be an owl:ObjectProperty with rdfs:range gmeow:TimeInterval — it bounds a role claim in time consistent with the relator pattern; duringInterval is reserved for logic:Situation relations." .

# (membershipAuthority's `subPropertyOf vantage` bridge is asserted in the OBSERVATIONS
#  module, not versions, so it cannot be a versions module-scoped cell — it is already
#  covered by observations' ex:saPropertyBridges.)

# --- 7. versionFingerprint is a DatatypeProperty with domain Entity (MUST) ----
ex:saVersionFingerprintProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:versionFingerprint a owl:DatatypeProperty ;
        rdfs:domain gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:versionFingerprint MUST be an owl:DatatypeProperty with rdfs:domain gmeow:Entity — it attaches semantic fingerprints (SWHID, canonical-form digest) to any versioned entity, broader than gmeow:contentDigest." .

# --- 8a. VersionRole is a subclass of logic:QualityValue (MUST) ---------------
ex:saVersionRoleIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:VersionRole a owl:Class ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:VersionRole MUST be an owl:Class and a subclass of logic:QualityValue — roles are open individual value vocabulary, never Entity subclasses (Principle 9)." .

# --- 8b. All twelve VersionRole seed individuals exist (MUST) -----------------
ex:saVersionRoleSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:roleCanonical    a gmeow:VersionRole .
    gmeow:roleVariant      a gmeow:VersionRole .
    gmeow:roleLatest       a gmeow:VersionRole .
    gmeow:roleStable       a gmeow:VersionRole .
    gmeow:roleLTS          a gmeow:VersionRole .
    gmeow:roleDeprecated   a gmeow:VersionRole .
    gmeow:roleYanked       a gmeow:VersionRole .
    gmeow:roleDraft        a gmeow:VersionRole .
    gmeow:rolePublished    a gmeow:VersionRole .
    gmeow:roleRevised      a gmeow:VersionRole .
    gmeow:roleCollected    a gmeow:VersionRole .
    gmeow:roleWithdrawn    a gmeow:VersionRole .
}""" ;
    gmeow:saRationale "All twelve VersionRole seed individuals MUST be present as gmeow:VersionRole individuals — the anchor list covers canonical, variant, latest, stable, LTS, deprecated, yanked, draft, published, revised, collected, and withdrawn." .

# --- 9a. VersionScale is a subclass of logic:QualityValue (MUST) --------------
ex:saVersionScaleIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:VersionScale a owl:Class ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:VersionScale MUST be an owl:Class and a subclass of logic:QualityValue — change magnitude is an open individual value vocabulary, never Entity subclasses (Principle 9)." .

# --- 9b. All three VersionScale seed individuals exist (MUST) -----------------
ex:saVersionScaleSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:scaleTrivial a gmeow:VersionScale .
    gmeow:scaleMinor   a gmeow:VersionScale .
    gmeow:scaleMajor   a gmeow:VersionScale .
}""" ;
    gmeow:saRationale "All three VersionScale seed individuals MUST be present — trivial, minor, and major cover SemVer-style and analogous non-software magnitude schemes." .

# --- 10. No hard-coded role subclasses exist (MUST-NOT) ----------------------
ex:saNoVersionRoleSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?rejected {
        gmeow:CanonicalVersion
        gmeow:LatestVersion
        gmeow:StableVersion
        gmeow:YankedVersion
        gmeow:DeprecatedVersion
        gmeow:DraftVersion
        gmeow:VariantVersion
        gmeow:LTSVersion
    }
    ?rejected a owl:Class .
}""" ;
    gmeow:saRationale "Hard-coded version-role subclasses (CanonicalVersion, LatestVersion, StableVersion, YankedVersion, DeprecatedVersion, DraftVersion, VariantVersion, LTSVersion) MUST NOT be declared as owl:Class — roles are standpoint-scoped individual values, never essential types (Principle 9)." .

# --- 11a. VersionMembership has an EL restriction on versionMember→Entity (MUST) ---
ex:saVersionMemberELRestriction a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:VersionMembership rdfs:subClassOf ?r .
    ?r owl:onProperty gmeow:versionMember ;
       owl:someValuesFrom gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:VersionMembership MUST have an EL someValuesFrom restriction on gmeow:versionMember with filler gmeow:Entity — the OWL 2 DL existential keeps the relator in the EL fragment." .

# --- 11b. VersionMembership has an EL restriction on versionSet→VersionSet (MUST) ---
ex:saVersionSetELRestriction a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:VersionMembership rdfs:subClassOf ?r .
    ?r owl:onProperty gmeow:versionSet ;
       owl:someValuesFrom gmeow:VersionSet .
}""" ;
    gmeow:saRationale "gmeow:VersionMembership MUST have an EL someValuesFrom restriction on gmeow:versionSet with filler gmeow:VersionSet — the existential anchors the relator to its lineage in OWL 2 DL." .

# --- 12. TermStability is a logic:QualityValue value vocabulary (MUST) --------
ex:saTermStabilityIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:TermStability a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:TermStability MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue — per-term maturity is an open value vocabulary mirroring gmeow:VersionRole / gmeow:VersionScale, never an essential type." .

# --- 13. The three TermStability seed individuals exist (MUST) ---------------
ex:saTermStabilitySeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:stabilityStable       a gmeow:TermStability .
    gmeow:stabilityExperimental a gmeow:TermStability .
    gmeow:stabilityDeprecated   a gmeow:TermStability .
}""" ;
    gmeow:saRationale "All three TermStability seed individuals MUST be present — stable, experimental, and deprecated anchor the per-term maturity badge (stable for core-tier, experimental for extension-tier defaults; deprecated for retired terms)." .

# --- 14. The per-term lifecycle properties are owl:AnnotationProperty (MUST) -
ex:saLifecycleAnnotationProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:termStability    a owl:AnnotationProperty .
    gmeow:addedInVersion   a owl:AnnotationProperty .
    gmeow:hasChangelogEntry a owl:AnnotationProperty .
    gmeow:entryVersion     a owl:AnnotationProperty .
    gmeow:entryNote        a owl:AnnotationProperty .
    gmeow:definitionDigest a owl:AnnotationProperty .
}""" ;
    gmeow:saRationale "The per-term lifecycle predicates (termStability, addedInVersion, hasChangelogEntry, entryVersion, entryNote, definitionDigest) MUST be owl:AnnotationProperty — they are asserted ABOUT TBox classes/properties, so the annotation form keeps the generated OWL downcast in OWL 2 DL (the gmeow:accordingTo pattern, Principle 3)." .

# --- 15. ChangelogEntry is a logic:Kind information object (MUST) ------------
ex:saChangelogEntryIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ChangelogEntry a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:ChangelogEntry MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject — a reified per-release change record is a first-class information object carrying a version and optional prose." .

# --- 16. No hard-coded stability subclasses exist (MUST-NOT) -----------------
ex:saNoTermStabilitySubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?rejected {
        gmeow:StableTerm
        gmeow:ExperimentalTerm
        gmeow:DeprecatedTerm
    }
    ?rejected a owl:Class .
}""" ;
    gmeow:saRationale "Hard-coded stability subclasses (StableTerm, ExperimentalTerm, DeprecatedTerm) MUST NOT be declared as owl:Class — term maturity is an annotation value (gmeow:TermStability individual), never an essential type, mirroring the version-role discipline." .

# --- 11c. VersionMembership has an EL restriction on membershipAuthority→Agent (MUST) ---
ex:saMembershipAuthorityELRestriction a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:VersionMembership rdfs:subClassOf ?r .
    ?r owl:onProperty gmeow:membershipAuthority ;
       owl:someValuesFrom gmeow:Agent .
}""" ;
    gmeow:saRationale "gmeow:VersionMembership MUST have an EL someValuesFrom restriction on gmeow:membershipAuthority with filler gmeow:Agent — the existential ensures every membership claim is attributed to an asserting agent (Principle 9)." .

# --- 17. versionLabel is a domain-general owl:DatatypeProperty on gmeow:Entity (MUST) ---
ex:saVersionLabelDomainIsEntity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:versionLabel a owl:DatatypeProperty ;
        rdfs:domain gmeow:Entity ;
        rdfs:range rdfs:Literal .
}""" ;
    gmeow:saRationale "gmeow:versionLabel MUST be an owl:DatatypeProperty with domain gmeow:Entity and range rdfs:Literal — the version designation is domain-general so any versioned artifact (language, software release, book edition, dataset, email variant) may carry it, not only versions-slice types." .
