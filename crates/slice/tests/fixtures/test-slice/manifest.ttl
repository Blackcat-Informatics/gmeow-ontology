@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex:      <https://example.org/test/> .

<https://example.org/test/slice/test>
    a gmeow:Slice ;
    rdfs:label "test slice"@x-gmeow-english ;
    dcterms:title "Test Slice"@x-gmeow-english ;
    dcterms:creator "Test Author" ;
    dcterms:identifier "10.99999/test" ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceConsumer "For testing only."@x-gmeow-english ;
    ex:unknownCustomProp "custom value"^^<http://www.w3.org/2001/XMLSchema#string> .
