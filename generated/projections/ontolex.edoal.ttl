@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/ontolex>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:LexicalForm ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri ontolex:Form ;
        ] ;
        align:relation "<=" ;
        rdfs:label "LexicalForm → ontolex:Form"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:LexicalItem ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri ontolex:LexicalEntry ;
            ] ;
            align:relation "<=" ;
            rdfs:label "LexicalItem → ontolex:LexicalEntry"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:fullName ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri ontolex:LexicalEntry ;
            ] ;
            align:relation "<=" ;
            rdfs:label "displayable Appellation → ontolex:LexicalEntry + Form + writtenRep"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasLexicalForm ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri ontolex:lexicalForm ;
            ] ;
            align:relation "<=" ;
            rdfs:label "LexicalItem → ontolex:LexicalEntry lexicalForm link (displayable forms only)"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "ontolex" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → ontolex (EDOAL)"@en .
