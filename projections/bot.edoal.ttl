@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix bot: <https://w3id.org/bot#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/bot> a align:Alignment ;
    rdfs:label "GMEOW → bot (EDOAL)"@x-gmeow-english ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "adjacentTo → bot:adjacentZone (indoor topology)"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:adjacentTo ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bot:adjacentZone ] ;
            align:relation "=" ],
        [ a align:Cell ;
            rdfs:label "containsPlace → bot:containsZone (indoor topology)"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:containsPlace ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bot:containsZone ] ;
            align:relation "=" ],
        [ a align:Cell ;
            rdfs:label "building contains room directly → bot:hasSpace"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:inverse [ a edoal:Relation ;
                            edoal:uri gmeow:containedInPlace ] ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bot:hasSpace ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "floor contains room → bot:hasSpace"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:inverse [ a edoal:Relation ;
                            edoal:uri gmeow:containedInPlace ] ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bot:hasSpace ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "building contains floor → bot:hasStorey"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:inverse [ a edoal:Relation ;
                            edoal:uri gmeow:containedInPlace ] ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bot:hasStorey ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "gmeow:Place [gmeow:placeTypeSite] → bot:Site"@x-gmeow-english ;
            align:entity1 [ a edoal:Class ;
                    edoal:and ( [ a edoal:Class ;
                                edoal:uri gmeow:Place ] [ a edoal:AttributeValueRestriction ;
                                edoal:comparator edoal:equals ;
                                edoal:onAttribute [ a edoal:Relation ;
                                        edoal:uri gmeow:placeType ] ;
                                edoal:value [ edoal:uri gmeow:placeTypeSite ] ] ) ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri bot:Site ] ;
            align:relation "=" ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnPlaceTypeToClass ] ],
        [ a align:Cell ;
            rdfs:label "gmeow:Place [gmeow:placeTypeBuilding] → bot:Building"@x-gmeow-english ;
            align:entity1 [ a edoal:Class ;
                    edoal:and ( [ a edoal:Class ;
                                edoal:uri gmeow:Place ] [ a edoal:AttributeValueRestriction ;
                                edoal:comparator edoal:equals ;
                                edoal:onAttribute [ a edoal:Relation ;
                                        edoal:uri gmeow:placeType ] ;
                                edoal:value [ edoal:uri gmeow:placeTypeBuilding ] ] ) ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri bot:Building ] ;
            align:relation "=" ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnPlaceTypeToClass ] ],
        [ a align:Cell ;
            rdfs:label "gmeow:Place [gmeow:placeTypeFloor] → bot:Storey"@x-gmeow-english ;
            align:entity1 [ a edoal:Class ;
                    edoal:and ( [ a edoal:Class ;
                                edoal:uri gmeow:Place ] [ a edoal:AttributeValueRestriction ;
                                edoal:comparator edoal:equals ;
                                edoal:onAttribute [ a edoal:Relation ;
                                        edoal:uri gmeow:placeType ] ;
                                edoal:value [ edoal:uri gmeow:placeTypeFloor ] ] ) ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri bot:Storey ] ;
            align:relation "=" ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnPlaceTypeToClass ] ],
        [ a align:Cell ;
            rdfs:label "gmeow:Place [gmeow:placeTypeRoom] → bot:Space"@x-gmeow-english ;
            align:entity1 [ a edoal:Class ;
                    edoal:and ( [ a edoal:Class ;
                                edoal:uri gmeow:Place ] [ a edoal:AttributeValueRestriction ;
                                edoal:comparator edoal:equals ;
                                edoal:onAttribute [ a edoal:Relation ;
                                        edoal:uri gmeow:placeType ] ;
                                edoal:value [ edoal:uri gmeow:placeTypeRoom ] ] ) ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri bot:Space ] ;
            align:relation "=" ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnPlaceTypeToClass ] ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "bot" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@x-gmeow-english .
