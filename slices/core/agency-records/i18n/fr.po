msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Goal condition occurrence constraint"
msgstr "Contrainte d’occurrence de condition de but"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "Each linked condition occurrence retains its source prose, exact local key, zero-based ordinal and a configured verifier of the same goal with that exact key; no executable goal expression is manufactured."
msgstr "Chaque occurrence de condition liée conserve son texte source, sa clé locale exacte, son rang à partir de zéro et un vérificateur configuré du même but avec cette clé exacte ; aucune expression de but exécutable n’est inventée."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of hasSatisfactionCondition."
msgstr "Utiliser pour faire respecter l’obligation de preuve source de hasSatisfactionCondition."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying this law with invented source values or fallback prose."
msgstr "Éviter de satisfaire cette loi avec des valeurs source inventées ou un texte de remplacement."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the actual source bindings expressed by this canonical formula."
msgstr "Conserver les liens source réels exprimés par cette formule canonique."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This law constrains supplied records; it neither runs a verifier nor authenticates an external source."
msgstr "Cette loi contraint les enregistrements fournis ; elle n’exécute aucun vérificateur et n’authentifie aucune source externe."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalConditionOccurrenceConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "gmeow:GoalConditionOccurrenceConstraint logic:formalizes gmeow:hasSatisfactionCondition ."
msgstr "gmeow:GoalConditionOccurrenceConstraint logic:formalizes gmeow:hasSatisfactionCondition ."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Goal verifier condition binding constraint"
msgstr "Contrainte de liaison du vérificateur à la condition du but"

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A configured goal verifier names an actual condition of that same goal through the identical source key."
msgstr "Un vérificateur de but configuré nomme une condition réelle de ce même but par une clé source identique."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to enforce the source-evidence obligation of hasConditionVerifier."
msgstr "Utiliser pour faire respecter l’obligation de preuve source de hasConditionVerifier."

msgctxt "https://blackcatinformatics.ca/gmeow/GoalVerifierConditionBindingConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
