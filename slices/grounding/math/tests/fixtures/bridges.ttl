#
# Deterministic ABox fixture for the six BRIDGES competency questions
# (crates/slicetest run_competency_file, unioned with the merged ontology in the asserted
# reasoningNone lane). Scoped to http://example.org/math/ so each query's answer is exact.
# Three bridge runs (R, ONNX, proof), each carrying its lift correspondence, plus one
# recorded unliftable-ingest diagnostic (Q4).
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <http://example.org/math/> .

# --- R bridge (Q1, Q5, Q6) --------------------------------------------------- #
ex:rRun a math:RIngestRun ;
    math:parseSource ex:rSrc ;
    math:ingestCorrespondence ex:rCorr ;
    logic:instantiatesSchema ex:rSchema ;
    logic:instantiatesPlan ex:rPlan .
ex:rSrc a math:MathematicalObject ; logic:loadBearing true ;
    math:retainedSource "fit <- lm(mpg ~ wt, data = mtcars)" .
ex:rSchema a logic:ActionSchema .
ex:rPlan a logic:Plan .
ex:rCorr a logic:Correspondence ;
    logic:morphismClass logic:LossyLens ;
    logic:preservationKind logic:ValidationOnly ;
    logic:mnemomorphic true .
# The computation product routed to logic: (the math:/logic: split).
ex:rComp a math:MathematicalExpression ;
    gmeow:wasGeneratedBy ex:rRun ;
    math:compilesToLogicFormula ex:rLogic .
# A well-formed atomic logic: AST node. logic:FormulaConstructorConstraint requires EXACTLY
# ONE constructor, so a bare `a logic:Formula` is malformed — it selects none.
ex:rLogic a logic:Formula ;
    logic:relation ex:rComputes ;
    logic:argument ex:rLogicArg .
ex:rComputes a logic:Type .
ex:rLogicArg a logic:TermCarrier ;
    logic:termIndex 0 ;
    logic:termIri ex:rComp .
ex:rFit a math:FittedModel ;
    gmeow:wasGeneratedBy ex:rRun ;
    math:modelFormula ex:rFormula ;
    math:fittedToData ex:rData .
ex:rData a math:DatasetMatrix .
ex:rFormula a math:ModelFormula ; math:argumentSlot ex:rSlot .
ex:rSlot a math:ArgumentSlot ; math:slotIndex 0 ; math:slotExpression ex:rVar .
ex:rVar a math:VariableExpression .
# The held claim (Q5): the fit summary as a vantage-grounded observation.
ex:rObs a gmeow:Observation ;
    gmeow:observedFeature ex:rFit ;
    gmeow:observationResult ex:rSummary ;
    gmeow:vantage ex:rEngine ;
    gmeow:wasGeneratedBy ex:rRun .
ex:rSummary a math:MathematicalObject .
ex:rEngine a gmeow:Standpoint .

# --- ONNX bridge (Q2, Q6) ---------------------------------------------------- #
ex:onnxRun a math:ONNXIngestRun ;
    math:parseSource ex:oSrc ;
    math:ingestCorrespondence ex:oCorr ;
    logic:instantiatesSchema ex:oSchema ;
    logic:instantiatesPlan ex:oPlan .
# Binary source: referenced by digest, never inlined (blob-by-reference), so this
# correspondence may NOT claim logic:mnemomorphic.
ex:oSrc a math:MathematicalObject ; logic:loadBearing true ;
    math:sourceDigest "7978a9f31743d3c2" .
ex:oSchema a logic:ActionSchema .
ex:oPlan a logic:Plan .
ex:oCorr a logic:Correspondence ;
    logic:morphismClass logic:LossyLens ;
    logic:preservationKind logic:ValidationOnly ;
    logic:mnemomorphic false .
ex:oGraph a math:TensorComputationGraph ;
    gmeow:wasGeneratedBy ex:onnxRun ;
    math:architectureOf ex:oNet ;
    math:computationNode ex:oNode .
ex:oNode a math:ApplicationExpression ; math:operator math:matrixProduct .
ex:oNet a math:LearnedModel .
ex:oParams a math:ParameterSpace ;
    gmeow:wasGeneratedBy ex:onnxRun ;
    math:parameterSpaceOf ex:oNet .

# --- Proof bridge (Q3, Q5, Q6) ----------------------------------------------- #
ex:proofRun a math:ProofIngestRun ;
    math:parseSource ex:pSrc ;
    math:ingestCorrespondence ex:pCorr ;
    logic:instantiatesSchema ex:pSchema ;
    logic:instantiatesPlan ex:pPlan .
ex:pSrc a math:MathematicalObject ; logic:loadBearing true ;
    math:retainedSource "cnf(c1, axiom, p(a)).\ncnf(c2, plain, q(a), inference(resolution,[status(thm)],[c1]))." .
ex:pSchema a logic:ActionSchema .
ex:pPlan a logic:Plan .
ex:pCorr a logic:Correspondence ;
    logic:morphismClass logic:LossyLens ;
    logic:preservationKind logic:ValidationOnly ;
    logic:mnemomorphic true .
ex:pDag a math:ProofDependencyGraph ;
    math:dependencyGraphOf ex:pProof ;
    gmeow:wasGeneratedBy ex:proofRun .
ex:pProof a math:Proof ;
    gmeow:wasGeneratedBy ex:proofRun ;
    math:provesGoal ex:pGoal ;
    math:proofStep ex:pStep .
ex:pGoal a logic:GoalExpression ;
    logic:goalExpressionKind logic:AchievementGoal ;
    logic:boundSituationType ex:pProved .
ex:pProved a logic:Situation .
ex:pStep a math:ProofStep .
# The QED result object (Q5), grounded by an observation with the checker as vantage.
ex:pQed a math:FormalVerificationResult ;
    gmeow:wasGeneratedBy ex:proofRun .
ex:pObs a gmeow:Observation ;
    gmeow:observedFeature ex:pProof ;
    gmeow:observationResult ex:pQed ;
    gmeow:vantage ex:pChecker ;
    gmeow:wasGeneratedBy ex:proofRun .
ex:pChecker a gmeow:Standpoint .

# --- A recorded unliftable-ingest diagnostic (Q4) ---------------------------- #
# A run that could not lift its source records a math:UnliftableIngest diagnostic held as
# an observation about the run — the hard-fail made queryable data.
ex:badRun a math:RIngestRun ;
    math:parseSource ex:badSrc ;
    math:ingestCorrespondence ex:badCorr ;
    logic:instantiatesSchema ex:badSchema ;
    logic:instantiatesPlan ex:badPlan .
# The witness RETAINS the script: the run's defect is that it lifted nothing, not that it
# could not read what it was given. A witness holding neither the text nor a digest would
# make this a math:UnreadableIngestSource / math:MalformedRScript case as well, and a
# minimal violation stays minimal only when it is well-formed everywhere else.
ex:badSrc a math:MathematicalObject ; logic:loadBearing true ;
    math:retainedSource "plot(mtcars$wt, mtcars$mpg)" .
ex:badSchema a logic:ActionSchema .
ex:badPlan a logic:Plan .
ex:badCorr a logic:Correspondence ;
    logic:morphismClass logic:BridgeView ;
    logic:preservationKind logic:Unsupported ;
    logic:mnemomorphic false .
ex:badDiagObs a gmeow:Observation ;
    gmeow:observedFeature ex:badRun ;
    gmeow:observationResult ex:badDiag ;
    gmeow:vantage ex:badChecker .
ex:badDiag a math:UnliftableIngest .
ex:badChecker a gmeow:Standpoint .
