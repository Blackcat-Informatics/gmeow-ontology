# --- Base dimensions → BIPM D-SI base-unit PIDs (realized-by-unit) ---------- #
# A base dimension is realized by an SI base unit; the D-SI PID is the authoritative
# SI anchor (cited, not re-minted). A dimension and its realizing unit are related,
# not identical, so skos:relatedMatch.

gmeow:eqMathLengthDimensionDsi a gmeow:TermEquivalence ;
    gmeow:alignSubject math:lengthDimension ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://si-digital-framework.org/SI/units/metre> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "metre" ;
    gmeow:comment "The length dimension L is realized by the SI base unit metre; the BIPM D-SI PID is the authoritative SI anchor. relatedMatch (dimension realized by unit), cited not re-minted." ;
    gmeow:sssomFile "gmeow-dsi.sssom.tsv" .

