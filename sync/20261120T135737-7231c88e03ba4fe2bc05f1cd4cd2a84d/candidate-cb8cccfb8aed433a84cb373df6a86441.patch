-    );
-
-    if let Some(module) = &stage.stage_impl {
-        push_line(
-            out,
-            &format!(
-                "- **{}:** `crates/pipeline/src/stages/{}.rs`",
-                model.ui("body_pipeline_implementation"),
-                code_escape(module)
-            ),
-        );
-    }
-    if !stage.capabilities.is_empty() || !stage.resources.is_empty() {
-        push_line(
-            out,
-            &format!(
-                "- **{}:** {}",
