@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .

# Projection mappings: GMEOW accessibility layer → schema.org.
# Compiled to projections/schema-org-accessibility.edoal.ttl +
# queries/projections/schema-org-accessibility.rq by `gmeow compile-mappings`.

gmeow:mapSchemaAccessibilityFeature a gmeow:ProjectionMapping ;
    rdfs:label "hasAccessibilityFeature → schema:accessibilityFeature (lossy)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ; gmeow:value "facet" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:hasAccessibilityFeature ; gmeow:objectVar "facet" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:hasAccessibilityFeature ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:accessibilityFeature ; gmeow:relation "<=" ; gmeow:confidence 0.7 ;
        gmeow:lossyDrop "GMEOW AccessibilityFacet individuals are emitted as IRIs; schema.org expects specific text tokens (wheelchairAccessible, stepFreeAccess, etc.). The consumer must map IRIs to tokens." ] .

gmeow:mapSchemaAccessibilityHazard a gmeow:ProjectionMapping ;
    rdfs:label "hasBarrier → schema:accessibilityHazard (lossy)"@en ;
    gmeow:hasMappingPattern [
        gmeow:anchor "place" ; gmeow:value "facet" ;
        gmeow:atom (
            [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:hasBarrier ; gmeow:objectVar "facet" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "place" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:hasBarrier ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:accessibilityHazard ; gmeow:relation "<=" ; gmeow:confidence 0.7 ;
        gmeow:lossyDrop "GMEOW AccessibilityFacet individuals are emitted as IRIs; schema.org expects specific text tokens (flashingHazard, motionSimulationHazard, soundHazard, etc.). The consumer must map IRIs to tokens." ] .
