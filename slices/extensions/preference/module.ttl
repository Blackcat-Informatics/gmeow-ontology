    rdfs:label "vssOrder (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:projectionOrder atom ('projection order') of gmeow:VantageScopedStrictOrderConstraint (G3, within-cell strict-order coherence over reified gmeow:PreferenceEdges): relates ?this, ?order."@x-gmeow-english ; logic:relation gmeow:projectionOrder ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "order" ] .
