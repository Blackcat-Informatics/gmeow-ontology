ex:saProficiencyLevelSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:cefrB2        a gmeow:ProficiencyLevel .
    gmeow:levelNative   a gmeow:ProficiencyLevel .
    gmeow:levelHeritage a gmeow:ProficiencyLevel .
}""" ;
    gmeow:saRationale "Sample ProficiencyLevel individuals (cefrB2, levelNative, levelHeritage) MUST exist as locally-defined typed individuals — the class is defined in slices/core/kernel/module.ttl but its seed individuals are defined here. Mirrors test_value_vocabularies_not_subclasses (ProficiencyLevel sample individuals arm)." .

# --- 26. TransliterationScheme seed individuals exist (MUST)
ex:saTransliterationSchemeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:schemeHepburn a gmeow:TransliterationScheme .
    gmeow:schemePinyin  a gmeow:TransliterationScheme .
    gmeow:schemeIPA     a gmeow:TransliterationScheme .
}""" ;
    gmeow:saRationale "Sample TransliterationScheme individuals (schemeHepburn, schemePinyin, schemeIPA) MUST exist as locally-defined typed individuals — the class is defined in slices/core/language/module.ttl but its seed individuals are defined here. Mirrors test_value_vocabularies_not_subclasses (TransliterationScheme sample individuals arm)." .

# ---------------------------------------------------------------------------
# GROUP 5: CEFR level carries its scale (MUST)
# Mirrors test_cefr_levels_carry_their_scale.
# ---------------------------------------------------------------------------

# --- 27. cefrB2 carries levelScale scaleCEFR (MUST)
ex:saCefrB2CarriesScale a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:cefrB2 gmeow:levelScale gmeow:scaleCEFR .
}""" ;
    gmeow:saRationale "gmeow:cefrB2 MUST carry gmeow:levelScale gmeow:scaleCEFR — every proficiency-level individual declares which scale it belongs to via the functional levelScale property. Mirrors test_cefr_levels_carry_their_scale." .

# ---------------------------------------------------------------------------
# GROUP 6: scriptUsageInterval is distinct from names' usageInterval (MUST/MUST-NOT)
# Mirrors test_script_usage_interval_distinct_from_names_usage_interval.
# ---------------------------------------------------------------------------

# --- 28. scriptUsageInterval has domain WritingSystemUsage (MUST)
ex:saScriptUsageIntervalDomain a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:scriptUsageInterval rdfs:domain gmeow:WritingSystemUsage .
}""" ;
    gmeow:saRationale "gmeow:scriptUsageInterval MUST have rdfs:domain gmeow:WritingSystemUsage — the languages relator carries its period via a DISTINCT property, not by reusing names' usageInterval. Mirrors test_script_usage_interval_distinct_from_names_usage_interval (positive domain arm)." .

# --- 29. usageInterval does NOT have domain WritingSystemUsage (MUST-NOT)
ex:saUsageIntervalNotDomainWritingSystemUsage a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:usageInterval rdfs:domain gmeow:WritingSystemUsage .
}""" ;
    gmeow:saRationale "gmeow:usageInterval MUST NOT have rdfs:domain gmeow:WritingSystemUsage — usageInterval stays scoped to NameUsage in the names module; WritingSystemUsage uses the distinct scriptUsageInterval property. Mirrors test_script_usage_interval_distinct_from_names_usage_interval (negative mustNot arm)." .

# ---------------------------------------------------------------------------
# GROUP 7: knowsLanguage shortcut and nativeLanguage sub-property (MUST/MUST-NOT)
# Mirrors test_knows_language_shortcut_and_native_subproperty.
# ---------------------------------------------------------------------------

# --- 30. knowsLanguage is a non-functional ObjectProperty (MUST)
ex:saKnowsLanguageIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:knowsLanguage a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:knowsLanguage MUST be an owl:ObjectProperty — the shortcut relation from agent to language. Mirrors test_knows_language_shortcut_and_native_subproperty (knowsLanguage ObjectProperty arm)." .

# --- 31. knowsLanguage is NOT functional (MUST-NOT)
ex:saKnowsLanguageNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:knowsLanguage a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:knowsLanguage MUST NOT be functional — a person knows multiple languages. Mirrors test_knows_language_shortcut_and_native_subproperty (non-functional mustNot arm)." .

# --- 32. nativeLanguage is a subPropertyOf knowsLanguage (MUST)
ex:saNativeLanguageSubPropertyOf a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:nativeLanguage rdfs:subPropertyOf gmeow:knowsLanguage .
}""" ;
    gmeow:saRationale "gmeow:nativeLanguage MUST be rdfs:subPropertyOf gmeow:knowsLanguage — native language is a specialisation of the general language-knowledge shortcut. Mirrors test_knows_language_shortcut_and_native_subproperty (subPropertyOf arm)." .
