        <https://blackcatinformatics.ca/gmeow/.well-known/void.ttl#dataset-linkset-schema.org-skos_closeMatch> ;
    void:uriSpace "https://blackcatinformatics.ca/gmeow/" ;
    void:vocabulary bfo:bfo.owl,
        dcterms:,
