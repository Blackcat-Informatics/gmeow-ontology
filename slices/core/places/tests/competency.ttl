#
# Declarative competency questions for the places slice, executed by the native
# Rust slice-test harness (crates/slicetest). Migrated from the location /
# place-type / storage-media / place-property competency tests in
# crates/validate/tests/conformance_competency.rs. TBox vocabulary questions over the asserted
# merged ontology; rows are the SUBSET the pytest asserted present (cqExactRows
# omitted → contains-check). No Gap-1 universal — fixed term sets.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/places/tests/> .

# ── Location kinds ────────────────────────────────────────────────────────────
ex:cqLocationKinds a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/location-kinds.rq" ;
    gmeow:cqRationale "GMEOW must model the kinds of location it supports: the Location root plus Place, VirtualLocation, and StorageLocation." ;
    gmeow:cqResultShape ex:cqLocationKindsShape ;
    gmeow:cqExpectRow ex:lkLocation, ex:lkPlace, ex:lkVirtualLocation, ex:lkStorageLocation .

ex:cqLocationKindsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "kind" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

ex:lkLocation a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri gmeow:Location ] .
ex:lkPlace a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri gmeow:Place ] .
ex:lkVirtualLocation a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri gmeow:VirtualLocation ] .
ex:lkStorageLocation a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri gmeow:StorageLocation ] .

# ── Place types ───────────────────────────────────────────────────────────────
ex:cqPlaceTypes a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/place-types.rq" ;
    gmeow:cqRationale "GMEOW must model place-type individuals across scales: country, city, room, premises." ;
    gmeow:cqResultShape ex:cqPlaceTypesShape ;
    gmeow:cqExpectRow ex:ptCountry, ex:ptCity, ex:ptRoom, ex:ptPremises .

ex:cqPlaceTypesShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "placeType" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

ex:ptCountry a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "placeType" ; gmeow:cellValueIri gmeow:placeTypeCountry ] .
ex:ptCity a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "placeType" ; gmeow:cellValueIri gmeow:placeTypeCity ] .
ex:ptRoom a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "placeType" ; gmeow:cellValueIri gmeow:placeTypeRoom ] .
ex:ptPremises a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "placeType" ; gmeow:cellValueIri gmeow:placeTypePremises ] .

# ── Storage media ─────────────────────────────────────────────────────────────
ex:cqStorageMedia a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/storage-media.rq" ;
    gmeow:cqRationale "GMEOW must model storage media including a cloud service and a physical disk." ;
    gmeow:cqResultShape ex:cqStorageMediaShape ;
    gmeow:cqExpectRow ex:smCloudService, ex:smPhysicalDisk .

ex:cqStorageMediaShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "medium" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

ex:smCloudService a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "medium" ; gmeow:cellValueIri gmeow:storageMediumCloudService ] .
ex:smPhysicalDisk a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "medium" ; gmeow:cellValueIri gmeow:storageMediumPhysicalDisk ] .

# ── Place properties ──────────────────────────────────────────────────────────
ex:cqPlaceProperties a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/place-properties.rq" ;
    gmeow:cqRationale "GMEOW must model the spatial properties of a place: containment, coordinates, geometry, and place-type assignment." ;
    gmeow:cqResultShape ex:cqPlacePropertiesShape ;
    gmeow:cqExpectRow ex:ppContainedInPlace, ex:ppHasCoordinates, ex:ppHasGeometry, ex:ppPlaceType .

ex:cqPlacePropertiesShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "property" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

ex:ppContainedInPlace a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:containedInPlace ] .
ex:ppHasCoordinates a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:hasCoordinates ] .
ex:ppHasGeometry a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:hasGeometry ] .
ex:ppPlaceType a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:placeType ] .

# ── Geospatial index disclosure ───────────────────────────────────────────────
ex:cqIndexProjectionDisclosure a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/index-projection-disclosure.rq" ;
    gmeow:cqRationale "GMEOW must name which properties a geospatial index may derive cells from, and under which disclosure marks: an index built over a gmeow:coarsenGuarded key-source property inherits the guard, so a gmeow:consumerPublicSite projection of that index must coarsen first (Principle 10; the normative coarsen-guard ruling)." ;
    gmeow:cqResultShape ex:cqIndexProjectionDisclosureShape ;
    gmeow:cqExpectRow ex:ipdAsGeoJSON, ex:ipdAsWKT, ex:ipdCoordinateFrame,
        ex:ipdCoordinateResult, ex:ipdGeometryResult, ex:ipdHasCoordinates, ex:ipdHasGeometry .

ex:cqIndexProjectionDisclosureShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "property" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "guarded" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

# ?guarded is bound by BIND(EXISTS { … gmeow:coarsenGuarded true } AS ?guarded), an
# xsd:boolean effective value, so the expected cell is a Turtle boolean (xsd:boolean),
# not the string "true"/"false". Every gmeow:useForConsumer gmeow:consumerIndexProjection
# property in the places module appears; the guarded mark is true iff it also carries
# gmeow:coarsenGuarded true (the index-consumer disclosure guard).
ex:ipdAsGeoJSON a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:asGeoJSON ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "guarded" ; gmeow:cellValueLiteral false ] .
ex:ipdAsWKT a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:asWKT ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "guarded" ; gmeow:cellValueLiteral false ] .
ex:ipdCoordinateFrame a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:coordinateFrame ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "guarded" ; gmeow:cellValueLiteral false ] .
ex:ipdCoordinateResult a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:coordinateResult ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "guarded" ; gmeow:cellValueLiteral true ] .
ex:ipdGeometryResult a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:geometryResult ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "guarded" ; gmeow:cellValueLiteral true ] .
ex:ipdHasCoordinates a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:hasCoordinates ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "guarded" ; gmeow:cellValueLiteral true ] .
ex:ipdHasGeometry a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "property" ; gmeow:cellValueIri gmeow:hasGeometry ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "guarded" ; gmeow:cellValueLiteral true ] .
