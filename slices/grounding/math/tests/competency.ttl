    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "anchor" ; gmeow:cellValueIri wd:Q167 ] .

# === Q6 — the unification: structure-preserving maps (det, Weyl, HE) ======== #

ex:cqStructurePreservingMaps a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/structure-preserving-maps.rq" ;
    gmeow:cqReasoning gmeow:reasoningLogic ;
    gmeow:cqRationale "The E8 group-action law (g·h)·x = g·(h·x) made a LIVE entailment consumer: authored as a real logic:Formula over fixed-arity n-ary comp/act predications and evaluated by the native logic: reasoner over a concrete compatible action, it DERIVES the binary consequent eq((g·h)·x, g·(h·x)) — both association orders reach the same point gaWr. Nothing asserts that eq tuple; only the law derives it. Over the reasoned closure the answer is exactly {gaWr}. Removing the law formula makes the answer empty." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqMapsShape ;
    gmeow:cqExpectRow ex:rowWeylMap .

ex:cqMapsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "value" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowWeylMap a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "value" ; gmeow:cellValueIri exa:gaWr ] .

# === Q7 — the validated E8 root system (240 / rank 8 / Weyl order) ========== #

ex:cqE8RootSystem a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/e8-root-system.rq" ;
    gmeow:cqDataFile "tests/fixtures/algebra.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The E8 flagship's invariants made validatable: over the fixture the answer is exactly {rootCount 240, rank 8, Weyl order 696729600}. A mistyped number would fail this exact-match gate." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqE8Shape ;
    gmeow:cqExpectRow ex:rowE8 .

ex:cqE8Shape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "rootCount" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ,
        [ logic:columnVariable "rank" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ,
        [ logic:columnVariable "weylOrder" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowE8 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "rootCount" ; gmeow:cellValueLiteral "240" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "rank" ; gmeow:cellValueLiteral "8" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "weylOrder" ; gmeow:cellValueLiteral "696729600" ] .

# === Q8 — a structure's operation and axioms =============================== #

ex:cqStructureOperationAxioms a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/structure-operation-axioms.rq" ;
    gmeow:cqReasoning gmeow:reasoningLogic ;
    gmeow:cqRationale "The associativity axiom made a LIVE entailment consumer: authored as a real logic:Formula over fixed-arity n-ary op(x,y,z) predications and evaluated by the native logic: reasoner over a concrete operation table, it DERIVES the binary consequent eq((a·b)·c, a·(b·c)) — the two bracketings reach the same element assocWv. Nothing asserts that eq tuple; only the law derives it. Over the reasoned closure the answer is exactly {assocWv}. Removing the law formula makes the answer empty." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStructOpShape ;
    gmeow:cqExpectRow ex:rowStructOp .

ex:cqStructOpShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "value" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowStructOp a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "value" ; gmeow:cellValueIri exa:assocWv ] .

# === Q9 — a homomorphism's preserved operation and kernel ================== #

ex:cqHomomorphismKernel a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/homomorphism-preserved-operation-and-kernel.rq" ;
    gmeow:cqReasoning gmeow:reasoningLogic ;
    gmeow:cqRationale "The determinant preservation law det(A·B) = det(A)·det(B) made a LIVE entailment consumer: authored as a real logic:Formula and evaluated by the native logic: reasoner, its n-ary HEAD atom mul(dA,dB,dAB) DERIVES a content-addressed reified tuple (logic:instanceOf exa:mulRel + logic:naryArg0/1/2 on a chase-minted reifier) over the concrete determinants — the head-derivation path. Nothing asserts that tuple; only the law derives it. Over the reasoned closure the answer is exactly {detWdA, detWdB, detWdAB}. Removing the law formula makes the answer empty." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqHomKernelShape ;
    gmeow:cqExpectRow ex:rowHomKernel .

ex:cqHomKernelShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "dA" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "dB" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "dAB" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHomKernel a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dA" ; gmeow:cellValueIri exa:detWdA ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dB" ; gmeow:cellValueIri exa:detWdB ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dAB" ; gmeow:cellValueIri exa:detWdAB ] .

# === Q10 — which ring op / hardness / noise for an HE scheme (flagship 2) === #

ex:cqHeSchemeFrame a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/he-scheme-frame.rq" ;
    gmeow:cqReasoning gmeow:reasoningLogic ;
    gmeow:cqRationale "The homomorphic-encryption law Dec(E(a) ⊗ E(b)) = a ⊕ b made a LIVE entailment consumer: authored as a real logic:Formula over fixed-arity n-ary ctMul/ptAdd predications joined with the binary enc/dec atoms and evaluated by the native logic: reasoner over concrete ciphertexts, it DERIVES the binary consequent eq(Dec(E(a) ⊗ E(b)), a ⊕ b) — both reach the same plaintext heWp. Nothing asserts that eq tuple; only the law derives it. Over the reasoned closure the answer is exactly {heWp}. Removing the law formula makes the answer empty. (This is the homomorphicEncryption flagship's pinned competency gate.)" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqHeFrameShape ;
    gmeow:cqExpectRow ex:rowHeFrame .

ex:cqHeFrameShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "value" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHeFrame a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "value" ; gmeow:cellValueIri exa:heWp ] .

# === Q11 — which structures are isomorphic ================================= #

ex:cqIsomorphicStructures a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/isomorphic-structures.rq" ;
    gmeow:cqDataFile "tests/fixtures/algebra.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "An isomorphism reports the two structures it identifies; over the fixture the answer is exactly {sampleIso → structA / structB}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqIsoShape ;
    gmeow:cqExpectRow ex:rowIso .

ex:cqIsoShape a logic:ResultShape ;
