# --- Wave B2 shape-drain: narrative-interior residue (logic: canon; project to generated/shapes) ---

# gmeow:MythShape — a Myth carries at most one gmeow:recurringRisk boolean (the path is not globally
# OWL FunctionalProperty; the sh:maxCount 1 rides a class-scoped max-qualified antecedent, onDataRange
# xsd:boolean degrading to the plain sh:maxCount 1 the oracle compares).
gmeow:Myth logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:recurringRisk ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:boolean ] .

# gmeow:MotifShape — a Motif must carry at least one rdfs:label (identity-bearing means nameable).
# rdfs:label is literal-valued, so the existence axiom ranges over rdfs:Literal (OWL allValuesFrom
# OWL Thing would derive sh:nodeKind sh:BlankNodeOrIRI and reject the literal label); the closure
# entry projects the sh:minCount 1. The at-most-one-per-language-tag facet rides the UniqueLang sugar.
gmeow:Motif logic:subClassOf
    [ a logic:Restriction ; logic:onProperty rdfs:label ; logic:allValuesFrom rdfs:Literal ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Motif ; logic:closureKey "http://www.w3.org/2000/01/rdf-schema#label" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:MotifLabelUniqueLangConstraint
    a logic:UniqueLangConstraint ;
    rdfs:label "Motif label unique-language constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Motif carries at most one rdfs:label per language tag (no two language-tagged labels share a tag)."@x-gmeow-english ;
    logic:onClass gmeow:Motif ;
    logic:valuePath rdfs:label ;
    logic:formalizes gmeow:MotifShape ;
    logic:message "A Motif must carry at least one rdfs:label, at most one per language tag — identity-bearing means nameable; an unnameable recurring unit is a tag." .

# gmeow:NarrativePositionShape — a NarrativePosition carries a gmeow:positionOrdinal or a
# gmeow:positionLabel (or both): a disjunctive-requiredness obligation over the two locators.
gmeow:NarrativePositionLocatorConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Narrative position locator constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:NarrativePosition carries at least one of gmeow:positionOrdinal or gmeow:positionLabel."@x-gmeow-english ;
    logic:onClass gmeow:NarrativePosition ;
    logic:anyOf gmeow:positionOrdinal , gmeow:positionLabel ;
    logic:formalizes gmeow:NarrativePositionShape ;
    logic:message "A NarrativePosition must carry a positionOrdinal or a positionLabel (or both)." .

# gmeow:NarrativeTimeFrameShape — the gmeow:narrativeTimeAxis value is one of the two declared axis
# individuals (discourse time or story time): a closed value set (OWL oneOf), projected declaratively
# to sh:in. The axis PRESENCE (sh:minCount 1) rides gmeow:NarrativeTimeFrameAxisConstraint; the
# OWL FunctionalProperty contract supplies the sh:maxCount 1.
gmeow:NarrativeTimeFrame logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:narrativeTimeAxis ; logic:allValuesFrom [ logic:oneOf ( gmeow:axisDiscourseTime gmeow:axisStoryTime ) ] ] .

# gmeow:CharacterArcShape — a CharacterArc reads exactly one gmeow:arcSubject and one gmeow:arcType.
# The at-least-one existence obligation is carried procedurally (mirroring gmeow:ArcSample's locator
# constraints) so the fixture-conformance corpus — which excludes the declarative validation-shape
# surface to avoid over-flagging open-world data — still catches a missing subject/type; the closure
# entries + OWL FunctionalProperty contract carry the same exactly-one bound to the production gate.
gmeow:CharacterArcSubjectConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Character arc subject-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:CharacterArc reads at least one gmeow:arcSubject."@x-gmeow-english ;
    logic:onClass gmeow:CharacterArc ;
    logic:anyOf gmeow:arcSubject ;
    logic:formalizes gmeow:CharacterArcShape ;
    logic:message "A CharacterArc must have exactly one gmeow:arcSubject." .

gmeow:CharacterArcTypeConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Character arc type-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:CharacterArc reads at least one gmeow:arcType."@x-gmeow-english ;
    logic:onClass gmeow:CharacterArc ;
    logic:anyOf gmeow:arcType ;
    logic:formalizes gmeow:CharacterArcShape ;
    logic:message "A CharacterArc must have exactly one gmeow:arcType." .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects OWL FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:arcFrameFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    rdfs:label "arcFrame is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:arcFrame is functional: a CharacterArc is interpreted within exactly one narrative reference frame, and the same trajectory read under a different continuity is a separate arc instance linked by counterpartOf rather than a second frame on the one arc."@x-gmeow-english ;
    logic:characterizes gmeow:arcFrame ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:arcFrame ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:arcFrame names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:arcFrame, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:arcFrame and nothing else. It is not a definition of gmeow:arcFrame (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:arcFrameFunctionality logic:characterizes gmeow:arcFrame ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:arcSubjectFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    rdfs:label "arcSubject is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:arcSubject is functional: a CharacterArc describes the trajectory of exactly one subject entity, so an analysis spanning two characters is two arcs rather than one arc bearing two subjects."@x-gmeow-english ;
    logic:characterizes gmeow:arcSubject ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:arcSubject ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:arcSubject names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:arcSubject, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:arcSubject and nothing else. It is not a definition of gmeow:arcSubject (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:arcSubjectFunctionality logic:characterizes gmeow:arcSubject ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:arcTypeFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    rdfs:label "arcType is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:arcType is functional: a CharacterArc carries exactly one interpretive type from the open gmeow:ArcType vocabulary, so a trajectory read as both redemption and fall is two competing arc interpretations, not one arc holding two types."@x-gmeow-english ;
    logic:characterizes gmeow:arcType ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:arcType ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:arcType names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:arcType, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:arcType and nothing else. It is not a definition of gmeow:arcType (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:arcTypeFunctionality logic:characterizes gmeow:arcType ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:discourseTimeOfFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    rdfs:label "discourseTimeOf is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:discourseTimeOf is functional: a discourse-time frame coordinatizes the telling order of exactly one creative work, and a re-segmenting edition or translation owns its own discourse frame rather than sharing this one — one frame, one telling."@x-gmeow-english ;
    logic:characterizes gmeow:discourseTimeOf ;
