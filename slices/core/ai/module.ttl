    logic:argument [ logic:termIndex 0 ; logic:termVariable "span" ] , [ logic:termIndex 1 ; logic:termVariable "chunk" ] .
logic:stsChunkOf a logic:Formula ; logic:relation gmeow:chunkOf ;
