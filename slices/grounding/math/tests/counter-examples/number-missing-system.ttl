#
# Counter-example for math:NumberSituatedShape: a math:Number with no
# math:inNumberSystem. sh:minCount 1, so validation MUST emit
# shacl.MinCountConstraintComponent (and no other finding).
# Bound by tests/example-conformance.ttl (ex:ecNumberMissingSystem).
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <http://example.org/math/> .

ex:unsituatedNumber a math:RationalNumber ;
    math:isExact true .
