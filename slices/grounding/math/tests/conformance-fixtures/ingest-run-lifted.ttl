#
# The rBridge flagship's worked example: the exact output of the native producer
# math::producers::r_bridge_lift (dogfooded — the worked example IS what the producer
# emits). A bridge run that retains its source witness (math:parseSource), carries the
# process-layer in-band witnesses (logic:instantiatesSchema / logic:instantiatesPlan) and
# its lift's law-spine (math:ingestCorrespondence → a logic:Correspondence), AND produces a
# structured math: codomain (a math:FittedModel over a math:ModelFormula and one
# math:Residual per lifted observation, each gmeow:wasGeneratedBy the run). Conforms to
# math:IngestRunShape and is clean under the native math:UnliftableIngest lint — the lift is
# non-empty and nothing is dropped silently. Bound by ex:ecIngestRunLifted.
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix mprod:     <https://blackcatinformatics.ca/gmeow/examples/math/producers/> .

# Flagship 4 — lifting an R lm(mpg ~ wt + hp) fit into the math: codomain.
mprod:rRun a math:RIngestRun ;
    math:parseSource mprod:rSrcWitness ;
    logic:instantiatesSchema mprod:rBridgeSchema ;
    logic:instantiatesPlan mprod:rBridgePlan ;
    math:ingestCorrespondence mprod:rCorr .

# The retained, load-bearing source witness (the R call, by reference).
mprod:rSrcWitness a math:MathematicalObject ;
    logic:loadBearing true .
mprod:rBridgeSchema a math:MathematicalObject .
mprod:rBridgePlan a math:MathematicalObject .

# The lift's law-spine: a lossy lens with a retained (mnemomorphic) witness.
mprod:rCorr a logic:Correspondence ;
    logic:preservationKind logic:ValidationOnly ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:LossyLens ;
    logic:hasDeterminacy logic:Vague ;
    logic:mnemomorphic true .

# The model formula: the ~ is a binder over indexed argument slots.
mprod:mpgFormula a math:ModelFormula ;
    math:argumentSlot mprod:respSlot , mprod:wtSlot , mprod:hpSlot .
mprod:respSlot a math:ArgumentSlot ; math:slotIndex 0 ; math:slotExpression mprod:mpgVar .
mprod:wtSlot   a math:ArgumentSlot ; math:slotIndex 1 ; math:slotExpression mprod:wtVar .
mprod:hpSlot   a math:ArgumentSlot ; math:slotIndex 2 ; math:slotExpression mprod:hpVar .
mprod:mpgVar a math:VariableExpression .
mprod:wtVar  a math:VariableExpression .
mprod:hpVar  a math:VariableExpression .

# The lifted codomain: the data (by reference) and the fitted model.
mprod:mtcarsMatrix a math:DatasetMatrix ;
    gmeow:wasGeneratedBy mprod:rRun .
mprod:mtcarsFit a math:FittedModel ;
    math:modelFormula mprod:mpgFormula ;
    math:fittedToData mprod:mtcarsMatrix ;
    gmeow:wasGeneratedBy mprod:rRun .

# One math:Residual per lifted observation (N = 5).
mprod:obs0Residual a math:Residual ;
    math:residualOf mprod:mtcarsFit ;
    gmeow:wasGeneratedBy mprod:rRun .
mprod:obs1Residual a math:Residual ;
    math:residualOf mprod:mtcarsFit ;
    gmeow:wasGeneratedBy mprod:rRun .
mprod:obs2Residual a math:Residual ;
    math:residualOf mprod:mtcarsFit ;
    gmeow:wasGeneratedBy mprod:rRun .
mprod:obs3Residual a math:Residual ;
    math:residualOf mprod:mtcarsFit ;
    gmeow:wasGeneratedBy mprod:rRun .
mprod:obs4Residual a math:Residual ;
    math:residualOf mprod:mtcarsFit ;
    gmeow:wasGeneratedBy mprod:rRun .
