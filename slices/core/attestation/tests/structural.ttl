#
# Declarative structural assertions for the attestation slice -- the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_attestation.py. Each assertion runs as a
# SPARQL ASK over the attestation module graph (gmeow:scopeModule) under the
# native Rust slicetest harness (crates/slicetest).
#
# Attestation is migrated: class stereotypes are logic:
# (logic:Kind, logic:AbstractIndividualType, logic:QualityValue, logic:Relator),
# not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_certification_still_exists_as_relator -- gmeow:Certification is not
#     defined in slices/core/attestation/module.ttl; it lives in another slice,
#     making this a cross-slice check that scopeModule cannot cover.
#   test_contested_attestation_coexists -- loads a coverage fixture file
#     (attestation-vc.ttl), calls SHACL validation, and asserts ABox individuals
#     (EX_ATTEST.vcAttestation, claimAffirmed, claimRefuted); this is a
#     multi-file ABox check, not a module-scoped TBox assertion.
#   test_all_fixture_files_load -- iterates over 6 fixture files and calls
#     SHACL validation on each; ExampleConformance, not a structural TBox assertion.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/attestation/tests/> .

# --- 1. Attestation subclasses logic:Relator (MUST) ----------------------------
ex:saAttestationIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Attestation rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:Attestation MUST be a subclass of logic:Relator -- the reified vouching act mediates between an attester, an attested subject, and optionally an attested claim or artifact (gUFO relator pattern)." .

# --- 2. Five InformationObject subclasses (MUST) ------------------------------
ex:saAttestationInformationObjects a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:AttestationArtifact  rdfs:subClassOf gmeow:InformationObject .
    gmeow:VerificationResult   rdfs:subClassOf gmeow:InformationObject .
    gmeow:TransparencyLogEntry rdfs:subClassOf gmeow:InformationObject .
    gmeow:LedgerTransaction    rdfs:subClassOf gmeow:InformationObject .
    gmeow:Block                rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:AttestationArtifact, VerificationResult, TransparencyLogEntry, LedgerTransaction, and Block MUST each be a subclass of gmeow:InformationObject -- they are stored, citable information records, not occurrents or endurants." .

# --- 3. VerificationActivity subclasses gmeow:Activity (MUST) -----------------
ex:saVerificationActivityIsActivity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:VerificationActivity rdfs:subClassOf gmeow:Activity .
}""" ;
    gmeow:saRationale "gmeow:VerificationActivity MUST be a subclass of gmeow:Activity -- the checking act is an occurrent, not the result or the thing checked." .

# --- 4. LedgerEvent subclasses gmeow:Event (MUST) ----------------------------
ex:saLedgerEventIsEvent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LedgerEvent rdfs:subClassOf gmeow:Event .
}""" ;
    gmeow:saRationale "gmeow:LedgerEvent MUST be a subclass of gmeow:Event -- a contract log entry is an occurrent on the gmeow:Event spine, distinct from the LedgerTransaction information object that produced it." .

# --- 5. Three blockchain classes subclass gmeow:Entity (MUST) -----------------
ex:saBlockchainEntitiesAreEntities a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:BlockchainNetwork  rdfs:subClassOf gmeow:Entity .
    gmeow:SmartContract      rdfs:subClassOf gmeow:Entity .
    gmeow:BlockchainAccount  rdfs:subClassOf gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:BlockchainNetwork, SmartContract, and BlockchainAccount MUST each be a subclass of gmeow:Entity -- they are endurant on-chain things, not information objects or occurrents." .

# --- 6. AttestationType subclasses logic:QualityValue (MUST) -------------------
ex:saAttestationTypeIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:AttestationType rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:AttestationType MUST be a subclass of logic:QualityValue -- types are an open value vocabulary (individuals, never subclasses)." .

# --- 7. Three AttestationType seed individuals exist and are not classes (MUST)
ex:saAttestationTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:attestationTypeSLSAProvenance       a gmeow:AttestationType .
    gmeow:attestationTypeVerifiableCredential a gmeow:AttestationType .
    gmeow:attestationTypeBlockchainClaim      a gmeow:AttestationType .
}""" ;
    gmeow:saRationale "The three seeded gmeow:AttestationType individuals (SLSA provenance, VC, blockchain claim) MUST be present as AttestationType individuals." .

# --- 8. Seeded AttestationType individuals are NOT owl:Class (MUST-NOT) -------
ex:saAttestationTypeSeedsNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?seed {
        gmeow:attestationTypeSLSAProvenance
        gmeow:attestationTypeVerifiableCredential
        gmeow:attestationTypeBlockchainClaim
    }
    ?seed a owl:Class .
}""" ;
    gmeow:saRationale "The three seeded AttestationType individuals MUST NOT be typed owl:Class -- the type vocabulary is open individuals, never subclasses (Principle 9)." .

# --- 8a. Release-evidence AttestationType individuals exist (MUST) ------
ex:saAttestationTypeReleaseEvidence a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:attestationTypeConformanceVerdict   a gmeow:AttestationType .
}""" ;
    gmeow:saRationale "The release-as-evidence gmeow:AttestationType individual -- conformance verdict -- MUST be present as an AttestationType individual so the signed full-release bundle can type its folded evidence frames (CONSTITUTION.md §18 release-as-evidence)." .

# --- 8b. Release-evidence AttestationType individuals are NOT owl:Class (MUST-NOT)
ex:saAttestationTypeReleaseEvidenceNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?seed {
        gmeow:attestationTypeConformanceVerdict
    }
    ?seed a owl:Class .
}""" ;
    gmeow:saRationale "The release-evidence AttestationType individual MUST NOT be typed owl:Class -- like every type-vocabulary member it is an open individual, never a subclass (Principle 9)." .

# --- 9. SignatureScheme subclasses logic:QualityValue (MUST) -------------------
ex:saSignatureSchemeIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SignatureScheme rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:SignatureScheme MUST be a subclass of logic:QualityValue -- cryptographic algorithm names are an open value vocabulary (individuals, never subclasses)." .

# --- 10. Two SignatureScheme seed individuals exist (MUST) --------------------
ex:saSignatureSchemeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:signatureSchemeRSASHA256 a gmeow:SignatureScheme .
    gmeow:signatureSchemeEd25519   a gmeow:SignatureScheme .
}""" ;
    gmeow:saRationale "The two seeded gmeow:SignatureScheme individuals (RSA-SHA256, Ed25519) MUST be present as SignatureScheme individuals." .

# --- 11. Seeded SignatureScheme individuals are NOT owl:Class (MUST-NOT) ------
ex:saSignatureSchemeSeedsNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?seed {
        gmeow:signatureSchemeRSASHA256
        gmeow:signatureSchemeEd25519
    }
    ?seed a owl:Class .
}""" ;
    gmeow:saRationale "The two seeded SignatureScheme individuals MUST NOT be typed owl:Class -- algorithm names are individuals, never subclasses (Principle 9)." .

# --- 12. VerificationStatus subclasses logic:QualityValue (MUST) --------------
ex:saVerificationStatusIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:VerificationStatus rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:VerificationStatus MUST be a subclass of logic:QualityValue -- verification verdict names are an open value vocabulary (individuals, never subclasses; a 'verified' status is one verifier's observation, not global truth)." .

# --- 13. Two VerificationStatus seed individuals exist (MUST) -----------------
ex:saVerificationStatusSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:verificationStatusVerified a gmeow:VerificationStatus .
    gmeow:verificationStatusRevoked  a gmeow:VerificationStatus .
}""" ;
    gmeow:saRationale "The two seeded gmeow:VerificationStatus individuals (verified, revoked) MUST be present." .

# --- 14. Seeded VerificationStatus individuals are NOT owl:Class (MUST-NOT) --
ex:saVerificationStatusSeedsNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?seed {
        gmeow:verificationStatusVerified
        gmeow:verificationStatusRevoked
    }
    ?seed a owl:Class .
}""" ;
    gmeow:saRationale "The two seeded VerificationStatus individuals MUST NOT be typed owl:Class -- verdict names are individuals, never subclasses (Principle 9)." .

# --- 15. LedgerFinalityStatus subclasses logic:QualityValue (MUST) ------------
ex:saLedgerFinalityStatusIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LedgerFinalityStatus rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:LedgerFinalityStatus MUST be a subclass of logic:QualityValue -- chain settlement state names are an open value vocabulary (individuals, never subclasses)." .

# --- 16. Two LedgerFinalityStatus seed individuals exist (MUST) ---------------
ex:saLedgerFinalityStatusSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:finalityStatusFinalized a gmeow:LedgerFinalityStatus .
    gmeow:finalityStatusOrphaned  a gmeow:LedgerFinalityStatus .
}""" ;
    gmeow:saRationale "The two seeded gmeow:LedgerFinalityStatus individuals (finalized, orphaned) MUST be present." .

# --- 17. Seeded LedgerFinalityStatus individuals are NOT owl:Class (MUST-NOT)-
ex:saLedgerFinalityStatusSeedsNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?seed {
        gmeow:finalityStatusFinalized
        gmeow:finalityStatusOrphaned
    }
    ?seed a owl:Class .
}""" ;
    gmeow:saRationale "The two seeded LedgerFinalityStatus individuals MUST NOT be typed owl:Class -- settlement state names are individuals, never subclasses (Principle 9)." .

# --- 18. hasSignature is an owl:ObjectProperty (MUST) ------------------------
ex:saHasSignatureIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:hasSignature a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:hasSignature MUST be an owl:ObjectProperty -- the universal domain-free signature spine that anything signed can use." .

# --- 19. hasSignature does NOT have domain gmeow:Message (MUST-NOT) ----------
ex:saHasSignatureNotDomainMessage a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasSignature rdfs:domain gmeow:Message .
}""" ;
    gmeow:saRationale "gmeow:hasSignature MUST NOT carry rdfs:domain gmeow:Message -- the message-specific restriction was removed so hasSignature is a domain-free universal spine (module boundaries)." .

# --- 20. hasSignature has no inferential bridge to truth/trust (MUST-NOT) ----
ex:saHasSignatureNotBridgedToTruth a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned {
        gmeow:observationResult
        gmeow:trustor
        gmeow:trustee
        gmeow:endorses
    }
    {
        gmeow:hasSignature rdfs:subPropertyOf ?banned
    } UNION {
        ?banned rdfs:subPropertyOf gmeow:hasSignature
    } UNION {
        gmeow:hasSignature owl:equivalentProperty ?banned
    }
}""" ;
    gmeow:saRationale "gmeow:hasSignature MUST NOT be bridged (subPropertyOf or equivalentProperty, in either direction) to observationResult, trustor, trustee, or endorses -- a valid signature proves integrity and signer key control only, not truth or trust (Principle 1)." .

# --- 21. verificationResult/verifiedBy have no bridge to truth (MUST-NOT) ----
ex:saVerificationPropsNotBridgedToTruth a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?prop {
        gmeow:verificationResult
        gmeow:verifiedBy
    }
    VALUES ?banned {
        gmeow:observationResult
        gmeow:trustor
        gmeow:trustee
        gmeow:endorses
    }
    {
        ?prop rdfs:subPropertyOf ?banned
    } UNION {
        ?banned rdfs:subPropertyOf ?prop
    } UNION {
        ?prop owl:equivalentProperty ?banned
    }
}""" ;
    gmeow:saRationale "gmeow:verificationResult and gmeow:verifiedBy MUST NOT be bridged to observationResult, trustor, trustee, or endorses -- a verification result is one verifier's observation, never a global truth verdict (Principle 12)." .

# --- 22. Ledger properties have no bridge to truth/trust/quality (MUST-NOT) --
ex:saLedgerPropsNotBridgedToTruth a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?prop {
        gmeow:ledgerInclusionProof
        gmeow:confirmationDepth
        gmeow:finalityStatus
        gmeow:transactionHash
        gmeow:blockHash
    }
    VALUES ?banned {
        gmeow:observationResult
        gmeow:trustor
        gmeow:trustee
        gmeow:endorses
        gmeow:assessedEntity
    }
    {
        ?prop rdfs:subPropertyOf ?banned
    } UNION {
        ?banned rdfs:subPropertyOf ?prop
    } UNION {
        ?prop owl:equivalentProperty ?banned
    }
}""" ;
    gmeow:saRationale "gmeow:ledgerInclusionProof, confirmationDepth, finalityStatus, transactionHash, and blockHash MUST NOT be bridged to observationResult, trustor, trustee, endorses, or assessedEntity -- blockchain inclusion proves ledger inclusion under chain rules, NOT real-world truth (Principle 1)." .

# --- 23. Nine attestation properties are NOT transitive (MUST-NOT) -----------
ex:saAttestationPropertiesNotTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p {
        gmeow:attester
        gmeow:attestedSubject
        gmeow:attestedClaim
        gmeow:hasAttestation
        gmeow:attestationArtifact
        gmeow:verificationActivity
        gmeow:verificationResult
        gmeow:verifiedBy
        gmeow:transparencyLogEntry
    }
    ?p a owl:TransitiveProperty .
}""" ;
    gmeow:saRationale "None of the nine core attestation properties (attester, attestedSubject, attestedClaim, hasAttestation, attestationArtifact, verificationActivity, verificationResult, verifiedBy, transparencyLogEntry) MUST NOT be owl:TransitiveProperty -- chain composition on vouching properties would infer endorsement, which violates the no-truth-machine doctrine (Principle 12)." .

# --- 24. Nine attestation properties are NOT symmetric (MUST-NOT) ------------
ex:saAttestationPropertiesNotSymmetric a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p {
        gmeow:attester
        gmeow:attestedSubject
        gmeow:attestedClaim
        gmeow:hasAttestation
        gmeow:attestationArtifact
        gmeow:verificationActivity
        gmeow:verificationResult
        gmeow:verifiedBy
        gmeow:transparencyLogEntry
    }
    ?p a owl:SymmetricProperty .
}""" ;
    gmeow:saRationale "None of the nine core attestation properties MUST NOT be owl:SymmetricProperty -- attesting X is not the same as X attesting you; vouching acts have a directed polarity (Principle 1)." .
