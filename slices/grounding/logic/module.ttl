    logic:candidateNegativeCase logic:cqFindingTracesNonReachRejected ;
    logic:candidateProjectionBehavior logic:ExactPreservation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes gmeow:findingAntecedent ;
