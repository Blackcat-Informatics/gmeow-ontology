@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/mailmap>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Relation ;
            edoal:uri gmeow:canonicalizedIdentity ;
        ] ;
        align:entity2 [
            a edoal:Relation ;
            edoal:uri gmeow:projectedMailmapMapping ;
        ] ;
        align:relation "<=" ;
        edoal:measure "1"^^xsd:double ;
        edoal:transformation [
            rdfs:seeAlso gmeow:fnComposeMailmapMapping ;
        ] ;
        rdfs:label "suppressed AuthorIdentity → .mailmap remapping line"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:mailmapEntry ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri gmeow:mailmapEntry ;
            ] ;
            align:relation "=" ;
            edoal:measure "1"^^xsd:double ;
            rdfs:label "Agent mailmapEntry → canonical .mailmap line"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "mailmap" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → mailmap (EDOAL)"@en .
