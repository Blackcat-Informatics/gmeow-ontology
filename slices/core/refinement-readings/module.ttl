gmeow:SettledItemEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "settled item evidence constraint"@x-gmeow-english ;
    skos:definition "A reading explicitly marked openItemSettled retains at least one original settling record. The law certifies supplied evidence presence, not real-world resolution."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic state or evidence consistency within an attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this law as proof of global absence, successful settlement or statistical correctness."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula with the source scope and retain original evidence when reporting a violation."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:SettledItemEvidenceConstraint logic:formalizes gmeow:OpenItemReading ."@x-gmeow-english ;
    logic:formalizes gmeow:OpenItemReading ;
    logic:message "A reading explicitly marked openItemSettled retains at least one original settling record. The law certifies supplied evidence presence, not real-world resolution." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:OpenItemReading ] ],
                [ a logic:Formula ; logic:relation gmeow:openItemState ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:openItemSettled ] ] ] ;
            logic:consequent [ a logic:Formula ;
                logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "record" ] ;
                logic:exists [ a logic:Formula ; logic:relation gmeow:settledBy ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] ] .

gmeow:UnsettledItemEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "unsettled item evidence constraint"@x-gmeow-english ;
    skos:definition "Readings explicitly marked open, replied or let go contain no settledBy record. Other declared state values remain open to their own semantics."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic state or evidence consistency within an attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this law as proof of global absence, successful settlement or statistical correctness."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula with the source scope and retain original evidence when reporting a violation."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:UnsettledItemEvidenceConstraint logic:formalizes gmeow:OpenItemReading ."@x-gmeow-english ;
    logic:formalizes gmeow:OpenItemReading ;
    logic:message "Readings explicitly marked open, replied or let go contain no settledBy record. Other declared state values remain open to their own semantics." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:OpenItemReading ] ],
                [ a logic:Formula ; logic:or
                    [ a logic:Formula ; logic:relation gmeow:openItemState ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termIri gmeow:openItemOpen ] ],
                    [ a logic:Formula ; logic:relation gmeow:openItemState ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termIri gmeow:openItemReplied ] ],
                    [ a logic:Formula ; logic:relation gmeow:openItemState ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termIri gmeow:openItemLetGo ] ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "record" ] ;
                    logic:exists [ a logic:Formula ; logic:relation gmeow:settledBy ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] ] ] .

gmeow:StateReadingSourceScopeConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "state reading source scope constraint"@x-gmeow-english ;
    skos:definition "Every source observed by an open-item, recurrence or habit reading belongs to that reading’s declared offered-record scope."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic state or evidence consistency within an attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this law as proof of global absence, successful settlement or statistical correctness."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula with the source scope and retain original evidence when reporting a violation."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:StateReadingSourceScopeConstraint logic:formalizes gmeow:readingScope ."@x-gmeow-english ;
    logic:formalizes gmeow:readingScope ;
    logic:message "Every source observed by an open-item, recurrence or habit reading belongs to that reading’s declared offered-record scope." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "scope" ], [ logic:termIndex 2 ; logic:termVariable "record" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:or
                    [ a logic:Formula ; logic:relation rdf:type ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termIri gmeow:OpenItemReading ] ],
                    [ a logic:Formula ; logic:relation rdf:type ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termIri gmeow:RecurrenceReading ] ],
                    [ a logic:Formula ; logic:relation rdf:type ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termIri gmeow:HabitFigure ] ] ],
                [ a logic:Formula ; logic:relation gmeow:readingScope ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "scope" ] ],
                [ a logic:Formula ; logic:relation gmeow:observedFeature ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation gmeow:scopeRecord ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "scope" ],
                    [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] .

gmeow:ItemSettlingScopeConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "item settling scope constraint"@x-gmeow-english ;
    skos:definition "Every settling record cited by an open-item reading belongs to its offered-record scope."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic state or evidence consistency within an attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this law as proof of global absence, successful settlement or statistical correctness."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula with the source scope and retain original evidence when reporting a violation."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:ItemSettlingScopeConstraint logic:formalizes gmeow:settledBy ."@x-gmeow-english ;
    logic:formalizes gmeow:settledBy ;
    logic:message "Every settling record cited by an open-item reading belongs to its offered-record scope." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "scope" ], [ logic:termIndex 2 ; logic:termVariable "record" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:OpenItemReading ] ],
                [ a logic:Formula ; logic:relation gmeow:readingScope ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "scope" ] ],
                [ a logic:Formula ; logic:relation gmeow:settledBy ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation gmeow:scopeRecord ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "scope" ],
                    [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] .

