gmeow:HighFrictionCorrection logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:observedFeature ; logic:allValuesFrom gmeow:ToolCall ],
    [ a logic:Restriction ; logic:onProperty gmeow:observedFeature ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:ToolCall ],
    [ a logic:Restriction ; logic:onProperty gmeow:vantage ; logic:allValuesFrom gmeow:Entity ],
    [ a logic:Restriction ; logic:onProperty gmeow:vantage ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:Entity ],
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:allValuesFrom gmeow:ReadingScope ],
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:ReadingScope ],
    [ a logic:Restriction ; logic:onProperty gmeow:refinementOutcome ; logic:allValuesFrom gmeow:RefinementOutcome ],
    [ a logic:Restriction ; logic:onProperty gmeow:refinementOutcome ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:RefinementOutcome ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionEpisode ; logic:allValuesFrom gmeow:Activity ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionEpisode ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:Activity ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionTool ; logic:allValuesFrom gmeow:SoftwareAgent ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionTool ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:SoftwareAgent ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionArguments ; logic:allValuesFrom gmeow:StructuredValue ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionArguments ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:StructuredValue ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionCorrection ; logic:allValuesFrom gmeow:ToolCall ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionCorrection ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:ToolCall ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionRule ; logic:allValuesFrom gmeow:ReadingRule ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionRule ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:ReadingRule ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionAttemptCount ; logic:allValuesFrom math:Quantity ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionAttemptCount ; logic:maxQualifiedCardinality 1 ; logic:onClass math:Quantity ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionUnsucceededCount ; logic:allValuesFrom math:Quantity ],
    [ a logic:Restriction ; logic:onProperty gmeow:frictionUnsucceededCount ; logic:maxQualifiedCardinality 1 ; logic:onClass math:Quantity ] .

