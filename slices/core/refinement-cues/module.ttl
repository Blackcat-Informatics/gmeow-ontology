    skos:scopeNote "The separate decimal restriction supplies datatype admission; this law checks numeric bounds without calculating a measurement."@x-gmeow-english ;
    skos:example "gmeow:MinimumShareRangeConstraint logic:formalizes gmeow:minimumShare ."@x-gmeow-english ;
    logic:formalizes gmeow:minimumShare ; logic:message "Every supplied minimumShare is strictly greater than zero and at most one."@x-gmeow-english ;
    logic:onClass gmeow:ReadingRule ; logic:valuePath gmeow:minimumShare ; logic:minExclusiveBound 0 ; logic:maxInclusiveBound 1 .



gmeow:RestatementVersionCountConstraint
    a logic:AggregateConstraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Restatement version term count constraint"@x-gmeow-english ;
    skos:definition "A restatement reifier carries at most one distinct restatementRuleVersion RDF term; independent readings retain separate reifiers."@x-gmeow-english ;
    gmeow:useWhen "Use to check the reported count against its own distinct retained RDF terms."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid counting neighboring reports, repeated visits or decoded literal values."@x-gmeow-english ;
    gmeow:howToUse "Retain the binding and empty-group evidence laws alongside this aggregate."@x-gmeow-english ;
    skos:scopeNote "This counts source RDF terms without interpreting or weakening their digest datatypes. The annotation contract separately requires a matching parameter release."@x-gmeow-english ;
    skos:example "gmeow:RestatementVersionCountConstraint logic:formalizes gmeow:restatementRuleVersion ."@x-gmeow-english ;
    logic:formalizes gmeow:restatementRuleVersion ; logic:message "A restatement reifier carries at most one distinct restatementRuleVersion RDF term; independent readings retain separate reifiers."@x-gmeow-english ;
    logic:onClass rdf:Statement ; logic:aggFunction "COUNT" ; logic:aggDistinct true ; logic:aggPath gmeow:restatementRuleVersion ; logic:aggComparator "<=" ; logic:aggCompareTo 1 .


# Immutable parameter releases and declared, class-local numeric slots.
gmeow:ReadingRule logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:versionOf ; logic:allValuesFrom gmeow:Entity ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:versionOf ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:Entity ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/versionOf" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:ReadingRule logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:versionLabel ; logic:allValuesFrom rdfs:Literal ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/versionLabel" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:ReadingRule logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:contentDigest ; logic:allValuesFrom rdfs:Literal ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/contentDigest" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:ReadingRule logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:wasAttributedTo ; logic:allValuesFrom gmeow:Agent ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasAttributedTo" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:ReadingRule logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:minimumRun ; logic:allValuesFrom xsd:positiveInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:minimumRun ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:positiveInteger ] .
gmeow:ReadingRule logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:minimumShare ; logic:allValuesFrom xsd:decimal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:minimumShare ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] .
gmeow:RestatementRule logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:restatementMinimumRun ; logic:allValuesFrom xsd:positiveInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:restatementMinimumRun ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:positiveInteger ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RestatementRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/restatementMinimumRun" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:RestatementRule logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:restatementMinimumUncommonWords ; logic:allValuesFrom xsd:nonNegativeInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:restatementMinimumUncommonWords ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:nonNegativeInteger ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RestatementRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/restatementMinimumUncommonWords" ; logic:closureValue logic:ClosedWorldClosure ] .
rdf:Statement logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:restatementRun ; logic:allValuesFrom xsd:positiveInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:restatementRun ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:positiveInteger ] .
rdf:Statement logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:restatementShare ; logic:allValuesFrom xsd:decimal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:restatementShare ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] .
rdf:Statement logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:restatementReceivedAt ; logic:allValuesFrom xsd:dateTime ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:restatementReceivedAt ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:dateTime ] .
rdf:Statement logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:restatementReceiptBasis ; logic:allValuesFrom gmeow:ReceiptBasis ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:restatementReceiptBasis ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:ReceiptBasis ] .
rdf:Statement logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:echoRun ; logic:allValuesFrom xsd:positiveInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:echoRun ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:positiveInteger ] .
rdf:Statement logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:echoShare ; logic:allValuesFrom xsd:decimal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:echoShare ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] .


# Explicit range reading does not require fields on unrelated records.
[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/restatementRun" ; logic:closureValue logic:ClosedWorldClosure ] .
