# Competency question: "What is this AI's tensor computation graph, its parameter
# space, and where is its self-reflection carried?" Exercises the self-structure
# flagship: the tensor graph reuses the expression AST (its math:computationNode),
# weights live in a math:ParameterSpace (math:parameterSpaceOf the model), and the
# reflection is a logic:MetaLevelFormula held as the result of a residual-interpretation
# observation. Scoped so the answer is exactly {tgraph -> node, pspace, reflectFormula}.
PREFIX math:  <https://blackcatinformatics.ca/math/>
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>

SELECT ?graph ?node ?parameterSpace ?reflection WHERE {
    ?graph a math:TensorComputationGraph ;
           math:computationNode ?node ;
           math:architectureOf ?model .
    ?parameterSpace math:parameterSpaceOf ?model .
    ?claim gmeow:observationResult ?reflection .
    ?reflection a logic:MetaLevelFormula .
    FILTER(STRSTARTS(STR(?graph), "http://example.org/math/"))
}
ORDER BY ?graph ?node
