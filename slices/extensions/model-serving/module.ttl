    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/model-serving> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Model metric result constraint"@x-gmeow-english ;
    skos:definition "Every metric result carries exactly one finite numeric magnitude and the dimension declared by its metric."@x-gmeow-english ;
    gmeow:useWhen "Use to reject missing, nonnumeric, nonfinite or dimensionally incompatible metric result magnitudes."@x-gmeow-english ;
