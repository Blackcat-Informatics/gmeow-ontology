# SPDX-License-Identifier: CC-BY-4.0
#
# Counter-example for the GOVERNING gmeow:NoGlobalWinnerWithoutConsensusConstraint —
# the F2 whole-base vantage-closure clause, cherry-picked-consensus variant. THREE
# observations are registered on the context: ex:obsOne and ex:obsTwo agree (A ≻ B), and
# ex:obsThree DISSENTS (B ≻ A). The gmeow:ConsensusSection reconciles the two agreeing
# observations but CHERRY-PICKS — it omits the dissenting ex:obsThree, which the context
# still registers. The claim is otherwise perfect (typed, asserts a winner, extends to a
# TYPED gmeow:ConsensusSection bound to the context, discharges a TYPED
# gmeow:DisagreementObstruction). Because a registered dissenter is left unreconciled, the
# ∀→∃(∧…∧¬∃) SPARQL constraint MUST reject it with shacl.SPARQLConstraintComponent and NO
# other finding — a consensus that hides a dissenter does not cover the whole base.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/preference/tests/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# --- The closed candidate field ---------------------------------------------- #
ex:candA a gmeow:InformationObject ; rdfs:label "candidate A"@en .
ex:candB a gmeow:InformationObject ; rdfs:label "candidate B"@en .
ex:candidates a gmeow:CandidateSet ; gmeow:hasCandidate ex:candA , ex:candB .

# --- Three registered vantages: two agree, one dissents ----------------------- #
ex:evalOne   a gmeow:Standpoint ; rdfs:label "evaluator one (A over B)"@en .
ex:evalTwo   a gmeow:Standpoint ; rdfs:label "evaluator two (A over B)"@en .
ex:evalThree a gmeow:Standpoint ; rdfs:label "evaluator three (the dissenter, B over A)"@en .
ex:goal a gmeow:Goal ; rdfs:label "select the strongest draft"@en .

ex:ctx a gmeow:ComparisonContext ;
    gmeow:contextTask ex:goal ;
    gmeow:contentDigest "blake3:cc03cc03cc03cc03cc03cc03cc03cc03cc03cc03cc03cc03cc03cc03cc03cc03" ;
    gmeow:registersObservation ex:obsOne , ex:obsTwo , ex:obsThree .

ex:featOne a gmeow:InformationObject ; gmeow:hasPart ex:candA , ex:candB .
ex:obsOne a gmeow:PreferenceObservation ;
    gmeow:vantage ex:evalOne ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featOne ; gmeow:observationPrefers ex:candA .

ex:featTwo a gmeow:InformationObject ; gmeow:hasPart ex:candA , ex:candB .
ex:obsTwo a gmeow:PreferenceObservation ;
    gmeow:vantage ex:evalTwo ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featTwo ; gmeow:observationPrefers ex:candA .

ex:featThree a gmeow:InformationObject ; gmeow:hasPart ex:candA , ex:candB .
ex:obsThree a gmeow:PreferenceObservation ;
    gmeow:vantage ex:evalThree ; gmeow:comparisonContext ex:ctx ;
    gmeow:observedFeature ex:featThree ; gmeow:observationPrefers ex:candB .

# --- H0 lift + typed discharged obstruction ----------------------------------- #
ex:h0 a math:GlobalSection .
ex:h1 a math:GluingObstruction .
ex:obstruction a gmeow:DisagreementObstruction ;
    gmeow:obstructionClass ex:h1 .

# --- The DEFECT: the section reconciles the two agreeing observations, omitting
#     the registered dissenter ex:obsThree ------------------------------------- #
ex:sec a gmeow:ConsensusSection ;
    rdfs:label "a cherry-picked section omitting the registered dissenter ex:obsThree"@en ;
    gmeow:consensusGlobalSection ex:h0 ;
    gmeow:sectionContext ex:ctx ;
    gmeow:reconcilesObservation ex:obsOne , ex:obsTwo .   # <-- omits registered ex:obsThree

ex:claim a gmeow:PreferenceClaim ;
    gmeow:vantage ex:evalOne ;
    gmeow:accordingTo ex:evalOne ;
    gmeow:assertsGlobalWinner true ;
    gmeow:extendsToConsensusSection ex:sec ;
    gmeow:dischargesDisagreement ex:obstruction .
