@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix jams: <http://w3id.org/polifonia/ontology/jams/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/jams>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:MusicAnalysisClaim ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri jams:Segment ;
        ] ;
        align:relation "<=" ;
        rdfs:label "MusicalSegment analysis → JAMS segment annotation"@en ;
    ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "jams" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → jams (EDOAL)"@en .
