        gmeow:atom ( [ gmeow:subjectVar "agent" ; gmeow:predicate gmeow:holdsCredential ; gmeow:objectVar "cred" ] ) ;
        gmeow:edoalSource gmeow:holdsCredential ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:hasCredential ; gmeow:relation "=" ; gmeow:confidence 0.9 ] .

gmeow:mapSchemaCredentialIssuer a gmeow:ProjectionMapping ;
    rdfs:label "credentialIssuer → schema:recognizedBy"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "cred" ; gmeow:value "issuer" ;
        gmeow:atom (
            [ gmeow:subjectVar "cred" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Credential ]
            [ gmeow:subjectVar "cred" ; gmeow:predicate gmeow:credentialIssuer ; gmeow:objectVar "issuer" ] ) ;
        gmeow:edoalSource gmeow:credentialIssuer ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:recognizedBy ; gmeow:relation "<=" ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "the issuer organization relator collapses to a flat schema:recognizedBy edge" ] .

gmeow:mapSchemaCredentialFor a gmeow:ProjectionMapping ;
    rdfs:label "credentialFor → schema:competencyRequired"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "cred" ; gmeow:value "target" ;
        gmeow:atom (
            [ gmeow:subjectVar "cred" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Credential ]
            [ gmeow:subjectVar "cred" ; gmeow:predicate gmeow:credentialFor ; gmeow:objectVar "target" ] ) ;
        gmeow:edoalSource gmeow:credentialFor ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:competencyRequired ; gmeow:relation "<=" ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "the Skill/Occupation distinction in credentialFor collapses to schema:competencyRequired" ] .

