    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "free-access flag relates to the DC access-rights statement (boolean vs. policy text)"
|} .

gmeow:copyrightNotice skos:relatedMatch dc:rights {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "the DC elements 1.1 rights term (as used on the GMEOW root ontology)"
|} .

