        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "scope" ], [ logic:termIndex 2 ; logic:termVariable "record" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:HabitFigure ] ],
                [ a logic:Formula ; logic:relation gmeow:readingScope ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "scope" ] ],
                [ a logic:Formula ; logic:relation gmeow:habitMember ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation gmeow:scopeRecord ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "scope" ],
                    [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] .

# Reviewed reading parameters and reported textual measurements.
gmeow:limitUnrecordedSource
    a logic:NamedIndividual , gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "unrecorded source"@x-gmeow-english ;
    skos:definition "The selected reader lacks recorded source attribution for the words, so it cannot determine whether they repeat outside words the holder was told. This is a scoped reading limitation, not proof of originality."@x-gmeow-english ;
    gmeow:useWhen "Use when missing source attribution prevents the selected restatement reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating no recorded source as proof that the words were independently authored."@x-gmeow-english ;
    gmeow:howToUse "Retain actually excluded source records as QueryLoss instances under the existing ReadingLimit scope and count contract."@x-gmeow-english ;
    skos:scopeNote "A missing attribution does not invent a source, reject the words or silently establish a negative restatement verdict."@x-gmeow-english ;
    skos:example "ex:limit gmeow:limitReason gmeow:limitUnrecordedSource ."@x-gmeow-english .

gmeow:foundNothing
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "found nothing"@x-gmeow-english ;
    skos:definition "An explicit report that a selected completed refinement read its declared input scope and produced no selected reading; the nonnegative integer counts distinct declared input records, not repeated visits."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish a completed empty reading from a computation that did not run."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving completion or global absence from missing results, missing data or a failed operation."@x-gmeow-english ;
    gmeow:howToUse "Retain the Refinement's scope, exact input evidence, versioned vantage, generating activity and explicit unresolved outcome."@x-gmeow-english ;
    skos:scopeNote "Two-way scope/evidence laws and COUNT DISTINCT check the reported input count, including an explicit zero-row presence contract. They do not execute the computation or authenticate its completion."@x-gmeow-english ;
    skos:example "ex:emptyReading gmeow:foundNothing \"1\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    logic:domain gmeow:Refinement ; logic:range xsd:nonNegativeInteger .


# Intrinsic reading contracts; no lexical or execution computation.
gmeow:FoundNothingReportConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Found-nothing report constraint"@x-gmeow-english ;
    skos:definition "Every foundNothing report is an explicit Refinement over its own ReadingScope with the same observed scope, declared reader, generating Activity, reader association, supplied event time and unresolved outcome, and no selected observationResult."@x-gmeow-english ;
    gmeow:useWhen "Use to check the declared binding or numeric boundary on its own supplied reading record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this intrinsic law as an executed reader, authenticated receipt or digest verification."@x-gmeow-english ;
    gmeow:howToUse "Retain actual source values and evaluate the canonical law in the selected interpretation."@x-gmeow-english ;
    skos:scopeNote "These are explicit completion and no-output claims with retained evidence, not authenticated execution, a failure fallback or global absence."@x-gmeow-english ;
    skos:example "gmeow:FoundNothingReportConstraint logic:formalizes gmeow:foundNothing ."@x-gmeow-english ;
    logic:formalizes gmeow:foundNothing ; logic:message "Every foundNothing report is an explicit Refinement over its own ReadingScope with the same observed scope, declared reader, generating Activity, reader association, supplied event time and unresolved outcome, and no selected observationResult."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "count" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:foundNothing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "count" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "scope" ] , [ logic:termIndex 1 ; logic:termVariable "reader" ] , [ logic:termIndex 2 ; logic:termVariable "activity" ] , [ logic:termIndex 3 ; logic:termVariable "instant" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Refinement ] ] , [ a logic:Formula ; logic:relation gmeow:readingScope ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "scope" ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "scope" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ReadingScope ] ] , [ a logic:Formula ; logic:relation gmeow:observedFeature ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "scope" ] ] , [ a logic:Formula ; logic:relation gmeow:vantage ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "reader" ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "reader" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Agent ] ] , [ a logic:Formula ; logic:relation gmeow:wasGeneratedBy ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "activity" ] ] , [ a logic:Formula ; logic:relation gmeow:used ; logic:argument [ logic:termIndex 0 ; logic:termVariable "activity" ] , [ logic:termIndex 1 ; logic:termVariable "scope" ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "activity" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Activity ] ] , [ a logic:Formula ; logic:relation gmeow:wasAssociatedWith ; logic:argument [ logic:termIndex 0 ; logic:termVariable "activity" ] , [ logic:termIndex 1 ; logic:termVariable "reader" ] ] , [ a logic:Formula ; logic:relation gmeow:eventTime ; logic:argument [ logic:termIndex 0 ; logic:termVariable "activity" ] , [ logic:termIndex 1 ; logic:termVariable "instant" ] ] , [ a logic:Formula ; logic:relation gmeow:refinementOutcome ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:refinementUnresolved ] ] , [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "absentValue" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:observationResult ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "absentValue" ] ] ] ] ] ] ] ] .

gmeow:FoundNothingInputEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Found-nothing input evidence constraint"@x-gmeow-english ;
    skos:definition "Every source record in a foundNothing report's scope retains its exact RDF identity as the report's own derivation evidence, including supplied blank nodes or triple terms."@x-gmeow-english ;
    gmeow:useWhen "Use to check the declared binding or numeric boundary on its own supplied reading record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this intrinsic law as an executed reader, authenticated receipt or digest verification."@x-gmeow-english ;
    gmeow:howToUse "Retain actual source values and evaluate the canonical law in the selected interpretation."@x-gmeow-english ;
    skos:scopeNote "The law preserves the declared input roster; it neither discovers missing inputs nor proves that an activity read them."@x-gmeow-english ;
    skos:example "gmeow:FoundNothingInputEvidenceConstraint logic:formalizes gmeow:foundNothing ."@x-gmeow-english ;
    logic:formalizes gmeow:foundNothing ; logic:message "Every source record in a foundNothing report's scope retains its exact RDF identity as the report's own derivation evidence, including supplied blank nodes or triple terms."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "count" ] , [ logic:termIndex 2 ; logic:termVariable "scope" ] , [ logic:termIndex 3 ; logic:termVariable "record" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:foundNothing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "count" ] ] , [ a logic:Formula ; logic:relation gmeow:readingScope ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "scope" ] ] , [ a logic:Formula ; logic:relation gmeow:scopeRecord ; logic:argument [ logic:termIndex 0 ; logic:termVariable "scope" ] , [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation gmeow:wasDerivedFrom ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] .

gmeow:FoundNothingEvidenceScopeConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Found-nothing evidence scope constraint"@x-gmeow-english ;
    skos:definition "Every wasDerivedFrom source on a foundNothing report is a member of its own declared input scope."@x-gmeow-english ;
    gmeow:useWhen "Use to check the declared binding or numeric boundary on its own supplied reading record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this intrinsic law as an executed reader, authenticated receipt or digest verification."@x-gmeow-english ;
    gmeow:howToUse "Retain actual source values and evaluate the canonical law in the selected interpretation."@x-gmeow-english ;
    skos:scopeNote "Additional rule or execution provenance belongs on the generating activity, without contaminating the report's exact input evidence roster."@x-gmeow-english ;
    skos:example "gmeow:FoundNothingEvidenceScopeConstraint logic:formalizes gmeow:foundNothing ."@x-gmeow-english ;
    logic:formalizes gmeow:foundNothing ; logic:message "Every wasDerivedFrom source on a foundNothing report is a member of its own declared input scope."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "count" ] , [ logic:termIndex 2 ; logic:termVariable "scope" ] , [ logic:termIndex 3 ; logic:termVariable "record" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:foundNothing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "count" ] ] , [ a logic:Formula ; logic:relation gmeow:readingScope ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "scope" ] ] , [ a logic:Formula ; logic:relation gmeow:wasDerivedFrom ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation gmeow:scopeRecord ; logic:argument [ logic:termIndex 0 ; logic:termVariable "scope" ] , [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] .

gmeow:FoundNothingCountEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Found-nothing count evidence constraint"@x-gmeow-english ;
    skos:definition "A zero foundNothing count has no scoped input records; a positive count retains at least one scoped input record."@x-gmeow-english ;
    gmeow:useWhen "Use to check the declared binding or numeric boundary on its own supplied reading record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this intrinsic law as an executed reader, authenticated receipt or digest verification."@x-gmeow-english ;
    gmeow:howToUse "Retain actual source values and evaluate the canonical law in the selected interpretation."@x-gmeow-english ;
    skos:scopeNote "Zero/positive evidence closes empty aggregate groups. The separate COUNT DISTINCT law checks exact cardinality against the same retained input roster."@x-gmeow-english ;
    skos:example "gmeow:FoundNothingCountEvidenceConstraint logic:formalizes gmeow:foundNothing ."@x-gmeow-english ;
    logic:formalizes gmeow:foundNothing ; logic:message "A zero foundNothing count has no scoped input records; a positive count retains at least one scoped input record."@x-gmeow-english ;
