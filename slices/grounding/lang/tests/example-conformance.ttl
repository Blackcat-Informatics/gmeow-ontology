    gmeow:expectedViolationCode "shacl.MaxCountConstraintComponent" ;
    gmeow:conformanceRationale "The gmeow:GmnEnvelope declares TWO gmeow:gmnDictionaryVersion literals at once (sh:maxCount 1 on the derived gmeow:GmnEnvelope-shape) — an alias is meaningless without the ONE pinned dictionary version that minted it, so validation MUST emit shacl.MaxCountConstraintComponent and NO other finding (lang:GmnMissingEnvelopeField); the other eight contract fields are present and well-formed (R5, version-pinning is non-interchangeable)." .

ex:ecGmnRingLatticeMalformed a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/gmn-ring-lattice-malformed.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The gmeow:GmnSecurityRing carries no gmeow:gmnRingLevel at all (sh:minCount 1 on lang:GmnRingLatticeWellFormedShape), so it cannot be placed in the Denning product-order lattice — validation MUST emit shacl.MinCountConstraintComponent and NO other finding (lang:GmnRingLatticeMalformed). This gate bites the AUTHORED coordinate, proving it is not vacuous." .

# === Rule: a GMN dictionary's alias table is injective === #

ex:ecGmnDictionaryAliasUnique a gmeow:ExampleConformance ;
