ex:cqCoverageGradedCell a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/graded-cell-frame.rq" ;
    gmeow:cqDataFile "examples/graded-cell-complex.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A graded cell complex exposes each cell's grade (math:cellDimension) and the exact ±1 sign of each reified boundary math:CellIncidence as separate reusable data. Over the worked triangle the coface of every signed incidence is the 2-cell faceABC (grade exg:dim2), and the answer is exactly the three signed boundary coefficients of ∂(faceABC) = +edgeAB + edgeBC − edgeAC." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqCoverageGradedCellShape ;
    gmeow:cqExpectRow ex:rowGradedCellAB , ex:rowGradedCellAC , ex:rowGradedCellBC .

ex:cqCoverageGradedCellShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "cell" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "dimension" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "incidence" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "sign" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowGradedCellAB a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "cell" ; gmeow:cellValueIri exg:faceABC ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dimension" ; gmeow:cellValueIri exg:dim2 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "incidence" ; gmeow:cellValueIri exg:incFaceAB ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sign" ; gmeow:cellValueLiteral "1" ] .

ex:rowGradedCellAC a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "cell" ; gmeow:cellValueIri exg:faceABC ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dimension" ; gmeow:cellValueIri exg:dim2 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "incidence" ; gmeow:cellValueIri exg:incFaceAC ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sign" ; gmeow:cellValueLiteral "-1" ] .

ex:rowGradedCellBC a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "cell" ; gmeow:cellValueIri exg:faceABC ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dimension" ; gmeow:cellValueIri exg:dim2 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "incidence" ; gmeow:cellValueIri exg:incFaceBC ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sign" ; gmeow:cellValueLiteral "1" ] .

ex:cqCombinatorialLaplacianFrame a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/combinatorial-laplacian-frame.rq" ;
    gmeow:cqDataFile "examples/combinatorial-laplacian.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A degree-k combinatorial Laplacian exposes the cell complex it is built over, its degree, and the two boundary operators (up and down) whose adjoint compositions L_k = ∂_{k+1}∘∂_{k+1}* + ∂_k*∘∂_k assemble it as separate reusable data — the purely combinatorial frame distinct from the continuum math:HodgeLaplacian and the stalk-weighted math:SheafLaplacian." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqCombinatorialLaplacianFrameShape ;
    gmeow:cqExpectRow ex:rowCombinatorialLaplacianFrame .

ex:cqCombinatorialLaplacianFrameShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "laplacian" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "complex" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "degree" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "upper" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "lower" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowCombinatorialLaplacianFrame a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "laplacian" ; gmeow:cellValueIri exl:laplacian1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "complex" ; gmeow:cellValueIri exl:triangle ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "degree" ; gmeow:cellValueIri exl:dim1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "upper" ; gmeow:cellValueIri exl:boundaryUp ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "lower" ; gmeow:cellValueIri exl:boundaryDown ] .

