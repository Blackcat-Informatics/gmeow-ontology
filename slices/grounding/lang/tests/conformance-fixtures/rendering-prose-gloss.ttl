# Prose rendering: a logic:Formula rendered as an English prose gloss lang:SurfaceForm under
# an English prose convention. A natural-language gloss loses the formula's precise
# quantifier scope and variable binding — "every cat chases some mouse" does not fix whether
# one mouse or many — so the rendering carries logic:SoundUnderApproximation, NOT
# logic:ExactPreservation: the gloss is a sound approximation that reads well but is not
# reconstructible into the exact AST. The loss is declared through the non-Exact polarity.
# Conforms to lang:RenderingRecordShape and lang:RenderingNotIdentityShape.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:latin a lang:Script .
ex:englishProse a lang:Grammar ; lang:grammarFor ex:english .

# The abstract content: a full-FOL formula the gloss approximates.
ex:formula a logic:Formula .

# The produced form: the prose gloss surface.
ex:glossSurface a lang:UnanalyzedProse ; lang:inSignSystem ex:english ;
    lang:surfaceText "every cat chases some mouse" ; lang:inScript ex:latin ;
    lang:unicodeNormalization "NFC" ; lang:collationLocale "en" ;
    lang:analysisLevel lang:rawLevel .

ex:renderGloss a lang:Rendering ;
    lang:renderedContent ex:formula ;
    lang:renderingForm ex:glossSurface ;
    lang:renderingKind lang:renderingProse ;
    lang:renderingConvention ex:englishProse ;
    lang:renderingPreservation logic:SoundUnderApproximation .
