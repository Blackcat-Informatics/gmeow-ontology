gmeow:ReadingSourceScopeConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "reading source scope constraint"@x-gmeow-english ;
    skos:definition "Every source observed by a first-occurrence or relation-occasion reading belongs to each explicitly declared reading scope of that reading."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:ReadingSourceScopeConstraint logic:formalizes gmeow:readingScope ."@x-gmeow-english ;
    logic:formalizes gmeow:readingScope ;
    logic:message "Every source observed by a first-occurrence or relation-occasion reading belongs to each explicitly declared reading scope of that reading." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "scope" ], [ logic:termIndex 2 ; logic:termVariable "record" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:or [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:FirstOccurrence ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:RelationOccasion ] ] ], [ a logic:Formula ; logic:relation gmeow:readingScope ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "scope" ] ], [ a logic:Formula ; logic:relation gmeow:observedFeature ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation gmeow:scopeRecord ; logic:argument [ logic:termIndex 0 ; logic:termVariable "scope" ], [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] .

gmeow:LimitMemberScopeCauseConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "limit member scope and cause constraint"@x-gmeow-english ;
    skos:definition "Each actual loss included in a reading-limit aggregate retains its aggregate reason and concerns a record offered in the declared input scope."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:LimitMemberScopeCauseConstraint logic:formalizes gmeow:ledgerLoss ."@x-gmeow-english ;
    logic:formalizes gmeow:ledgerLoss ;
    logic:message "Each actual loss included in a reading-limit aggregate retains its aggregate reason and concerns a record offered in the declared input scope." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "loss" ], [ logic:termIndex 2 ; logic:termVariable "scope" ], [ logic:termIndex 3 ; logic:termVariable "reason" ], [ logic:termIndex 4 ; logic:termVariable "record" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:ReadingLimit ] ], [ a logic:Formula ; logic:relation gmeow:ledgerLoss ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "loss" ] ], [ a logic:Formula ; logic:relation gmeow:readingScope ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "scope" ] ], [ a logic:Formula ; logic:relation gmeow:limitReason ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "reason" ] ], [ a logic:Formula ; logic:relation gmeow:lossConcerns ; logic:argument [ logic:termIndex 0 ; logic:termVariable "loss" ], [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:lossCause ; logic:argument [ logic:termIndex 0 ; logic:termVariable "loss" ], [ logic:termIndex 1 ; logic:termVariable "reason" ] ], [ a logic:Formula ; logic:relation gmeow:scopeRecord ; logic:argument [ logic:termIndex 0 ; logic:termVariable "scope" ], [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] ] .

gmeow:ZeroReadingLimitEmptyConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "zero reading limit empty constraint"@x-gmeow-english ;
    skos:definition "A reading-limit aggregate reporting zero excluded records contains no actual ledgerLoss member. It remains an aggregate report rather than a fabricated loss."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:ZeroReadingLimitEmptyConstraint logic:formalizes gmeow:limitCount ."@x-gmeow-english ;
    logic:formalizes gmeow:limitCount ;
    logic:message "A reading-limit aggregate reporting zero excluded records contains no actual ledgerLoss member. It remains an aggregate report rather than a fabricated loss." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "count" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:ReadingLimit ] ], [ a logic:Formula ; logic:relation gmeow:limitCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "count" ] ], [ a logic:Formula ; logic:relation logic:termLessEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "count" ], [ logic:termIndex 1 ; logic:termLiteral "0" ; logic:termLiteralDatatype xsd:integer ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "loss" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:ledgerLoss ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "loss" ] ] ] ] ] ] .

gmeow:PositiveReadingLimitEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "positive reading limit evidence constraint"@x-gmeow-english ;
    skos:definition "A reading-limit aggregate reporting a positive excluded-record count retains actual loss evidence rather than silently omitting all excluded records. Exact count arithmetic remains the reporting refiner’s responsibility."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:PositiveReadingLimitEvidenceConstraint logic:formalizes gmeow:limitCount ."@x-gmeow-english ;
    logic:formalizes gmeow:limitCount ;
    logic:message "A reading-limit aggregate reporting a positive excluded-record count retains actual loss evidence rather than silently omitting all excluded records. Exact count arithmetic remains the reporting refiner’s responsibility." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "count" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:ReadingLimit ] ], [ a logic:Formula ; logic:relation gmeow:limitCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "count" ] ], [ a logic:Formula ; logic:relation logic:termGreater ; logic:argument [ logic:termIndex 0 ; logic:termVariable "count" ], [ logic:termIndex 1 ; logic:termLiteral "0" ; logic:termLiteralDatatype xsd:integer ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "loss" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:ledgerLoss ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "loss" ] ] ] ] ] .

gmeow:ReadingScope logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:scopeChronology ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ] .

gmeow:FirstOccurrence logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationPredicate ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationVault ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationAt ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] ] .

gmeow:RelationOccasion logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationPredicate ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationVault ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationAt ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] ] .

gmeow:ReadingLimit logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationPredicate ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationVault ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:limitReason ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:limitCount ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange xsd:nonNegativeInteger ] .

gmeow:FirstOccurrenceReferentConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "first-occurrence referent presence constraint"@x-gmeow-english ;
    skos:definition "Each first-occurrence reading supplies a related resource or an original source name, without inventing identity from the name."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:FirstOccurrenceReferentConstraint logic:formalizes gmeow:FirstOccurrence ."@x-gmeow-english ;
    logic:formalizes gmeow:FirstOccurrence ;
    logic:message "Each first-occurrence reading supplies a related resource or an original source name, without inventing identity from the name." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:FirstOccurrence ] ] ;
            logic:consequent [ a logic:Formula ; logic:or [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "referent" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:relatedThing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "referent" ] ] ], [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "name" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:relatedName ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "name" ] ] ] ] ] ] .

