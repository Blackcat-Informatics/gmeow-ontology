@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# =============================================================================
# SHACL shapes for the GMEOW statement DSL (dsl/statements/**/*.ttl).
#
# These shapes validate the canonical authoring source BEFORE the native
# statement compiler runs. Violations surface as
# structured per-node diagnostics (focus node, path, message, source file).
# =============================================================================

# --------------------------------------------------------------------------- #
# StatementMetadata
# --------------------------------------------------------------------------- #

gmeow:StatementMetadataShape
    a sh:NodeShape ;
    rdfs:label "StatementMetadata shape"@en ;
    logic:formalizes gmeow:StatementMetadataSubjectRequiredConstraint, gmeow:StatementMetadataPredicateRequiredConstraint,
        gmeow:StatementMetadataObjectChoiceConstraint ;
    sh:targetClass gmeow:StatementMetadata ;
    sh:property [
        sh:path gmeow:qSubject ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "StatementMetadata must have exactly one gmeow:qSubject (IRI)"
    ] ;
    sh:property [
        sh:path gmeow:qPredicate ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "StatementMetadata must have exactly one gmeow:qPredicate (IRI)"
    ] ;
    sh:property [
        sh:path gmeow:qObject ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "StatementMetadata may have at most one gmeow:qObject (IRI)"
    ] ;
    sh:property [
        sh:path gmeow:qObjectLiteral ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "StatementMetadata may have at most one gmeow:qObjectLiteral"
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "StatementMetadata needs exactly one of qObject (IRI) or qObjectLiteral" ;
        sh:select """
            SELECT $this WHERE {
                FILTER(
                    (EXISTS { $this gmeow:qObject ?o } && EXISTS { $this gmeow:qObjectLiteral ?l }) ||
                    (!EXISTS { $this gmeow:qObject ?o } && !EXISTS { $this gmeow:qObjectLiteral ?l })
                )
            }
        """
    ] ;
    sh:property [
        sh:path gmeow:reifier ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Each gmeow:reifier of a StatementMetadata must be an IRI (RDF 1.2 permits several reifiers per statement — one proposition, many claim tokens)"
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "StatementMetadata may have at most one rdfs:label"
    ] .

# --------------------------------------------------------------------------- #
# Annotation
# --------------------------------------------------------------------------- #

gmeow:StatementAnnotationShape
    a sh:NodeShape ;
    rdfs:label "Statement annotation shape"@en ;
    logic:formalizes gmeow:StatementAnnotationValueRequiredConstraint ;
    sh:targetSubjectsOf gmeow:annProperty ;
    sh:property [
        sh:path gmeow:annProperty ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "Annotation must have exactly one gmeow:annProperty (IRI)"
    ] ;
    sh:property [
        sh:path gmeow:annValue ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Annotation must have exactly one gmeow:annValue (IRI or literal)"
    ] .

# --------------------------------------------------------------------------- #
# Vocabulary annotation completeness (issue #221).
# Every term declared in dsl/statements/vocabulary.ttl must carry label,
# definition, and rdfs:isDefinedBy pointing at the statement DSL vocabulary.
# --------------------------------------------------------------------------- #

gmeow:StatementDslVocabularyTermShape
    a sh:NodeShape ;
    rdfs:label "Statement DSL vocabulary annotation completeness shape"@x-gmeow-english ;
    logic:formalizes gmeow:StatementDslVocabularyTermCompletenessConstraint ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a ?t .
                FILTER(?t IN (
                    <http://www.w3.org/2002/07/owl#Class>,
                    <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#DatatypeProperty>,
                    <http://www.w3.org/2002/07/owl#AnnotationProperty>,
                    <http://www.w3.org/2002/07/owl#Ontology>,
                    <http://www.w3.org/2000/01/rdf-schema#Datatype>
                ))
                FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
            }
        """ ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every statement DSL vocabulary term must carry at least one rdfs:label (issue #221)." ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every statement DSL vocabulary term must carry a skos:definition (issue #221)." ;
    ] ;
    sh:property [
        sh:path rdfs:isDefinedBy ;
        sh:minCount 1 ;
        sh:hasValue <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
        sh:severity sh:Violation ;
        sh:message "Every statement DSL vocabulary term must declare rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> (issue #221)." ;
    ] .
