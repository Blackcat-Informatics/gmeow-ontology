#
# The TRUE end-to-end cross-slice fixture for the agent-runtime profile. It exists
# ONLY here, in the profile corpus, because it needs BOTH slices present:
# extensions/model-serving (the served artifact · deployment · execution · session
# · invocation) AND core/inhabitation (the durable gmeow:SubjectStage /
# gmeow:SubjectLineage). Model-serving alone is standalone (gmeow:sessionSubjectStage
# is open-range) and can only reach the session's subject STAGE; here the chain
# continues via gmeow:stageOfLineage to the durable LINEAGE. The flat one-hop
# gmeow:generatedForSubject shortcut is NOT asserted here: it is MATERIALIZED by
# the projection CONSTRUCT (extensions/model-serving/queries/project/upper-projection.rq),
# which the harness runs over this overlaid canon via gmeow:cqProject before the
# end-to-end query executes. Because core/inhabitation is composed here, the
# projection's COALESCE(?lineage, ?stage) resolves the DEEPER durable LINEAGE, so
# the projection-agreement gate proves the computed shortcut equals the full
# cross-slice collapse (Principle 7) — non-circularly, since no human hand-typed
# the lineage IRI into the shortcut column.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/agent-runtime/> .

# --- core/inhabitation layer: the durable subject ----------------------------
ex:lillithBot a gmeow:SoftwareAgent .
ex:lillithLineage a gmeow:SubjectLineage .
ex:lillithStage a gmeow:SubjectStage ;
    gmeow:stageBearer ex:lillithBot ;
    gmeow:stageOfLineage ex:lillithLineage .
ex:configA a gmeow:InhabitationConfiguration .

# --- extensions/model-serving layer: the served runtime ----------------------
ex:opusArtifact a gmeow:ModelArtifact .
ex:opusDeployment a gmeow:ModelDeployment ;
    gmeow:deploymentArtifact ex:opusArtifact .
ex:execution1 a gmeow:RuntimeExecution ;
    gmeow:executionOfDeployment ex:opusDeployment .
ex:session1 a gmeow:AgentSession ;
    gmeow:sessionSubjectStage ex:lillithStage ;      # session → inhabitation subject stage
    gmeow:sessionConfiguration ex:configA .
ex:invocation1 a gmeow:ModelInvocation ;
    gmeow:invocationInExecution ex:execution1 ;
    gmeow:subEventOf ex:session1 .

# --- the output (canon only; the flat cross-slice shortcut is MATERIALIZED by ---
# --- the projection CONSTRUCT via gmeow:cqProject, never hand-asserted here) ----
ex:output a gmeow:InformationObject ;
    gmeow:wasGeneratedBy ex:invocation1 .
