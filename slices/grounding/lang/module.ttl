    gmeow:gmnArity 1 ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionNamedKey ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisAmbiguity ;
    gmeow:gmnDispositionRationale "The same partial sign denotes partial differentiation and chain boundaries; the `boundary` key keeps the operator family explicit." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenMathBoundaryOperator ;
    gmeow:cites gmeow:gmnOpenMathWork , gmeow:gmnUnicodeMathWork ;
    gmeow:graphBoxRole gmeow:boxABox .

