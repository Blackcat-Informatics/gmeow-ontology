@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix bbc: <http://www.bbc.co.uk/ontologies/news/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix iptc: <http://iptc.org/std/NewsML-G2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oa: <http://www.w3.org/ns/oa#> .

<https://blackcatinformatics.ca/gmeow/projections/iptc>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:ObservationalActivity ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri iptc:NewsMessage ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.7"^^xsd:double ;
        rdfs:label "ObservationalActivity → iptc:NewsMessage"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:StandpointClaim ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri bbc:NewsEvent ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.75"^^xsd:double ;
            rdfs:label "StandpointClaim → bbc:NewsEvent"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:StandpointClaim ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri oa:Annotation ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            rdfs:label "StandpointClaim → oa:Annotation with target"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "iptc" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → iptc (EDOAL)"@en .
