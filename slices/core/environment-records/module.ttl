    gmeow:worldObjectKindBroader gmeow:worldObjectKindWrittenRecord .

gmeow:worldObjectKindInstrument
    a logic:NamedIndividual, gmeow:WorldObjectKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
