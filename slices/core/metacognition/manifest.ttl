@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/metacognition>
    a gmeow:Slice ;
    rdfs:label "metacognition"@x-gmeow-english ;
    skos:definition "The metacognition slice of the GMEOW ontology (core tier): GMEOW Metacognition Module — second-order epistemics, introducing gmeow:MetacognitiveState as the reflexive sibling of gmeow:CognitiveState and gmeow:IntentionalMode under gmeow:MentalMoment, together with calibration, known-unknowns, epistemic self-trust, and the reflection act. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/metacognition> ;
    dcterms:title "GMEOW Metacognition Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/events> ;
    gmeow:sliceProfile "claims" , "memory" ;
    gmeow:sliceConsumer "AI-memory calibration and trustworthiness (Principle 15) — flagging 'I might be wrong', surfacing known-unknowns as inquiries (the inquiry-slice gmeow:evokes bridge), recording the boundary of the agent's knowledge, and defeating one's own inference on reflection; the headline trustworthy-agent demo that separates a calibrated agent from a confabulating one."@x-gmeow-english .
