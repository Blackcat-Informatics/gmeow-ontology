# =========================================================================== #
# Procedural constraints (#1194) — remaining hand-authored sh:sparql NodeShapes  #
# of shapes.ttl migrated to canonical logic:Constraint records. Each carries      #
# logic:formalizes keyed on the shape term its projected sh:SPARQLConstraint twin #
# replaces; the raw logic:Formula integrity trees mirror each sh:select's BGP +   #
# FILTER exactly. All source shapes are sh:Violation (default severity).          #
# =========================================================================== #

# lang:SurfaceAnalysisShape (sparql) — a lang:SurfaceForm's structure must match
# its declared lang:analysisLevel: a parsedLevel surface realizes a
# lang:ComposedForm, a rawLevel surface is typed lang:UnanalyzedProse, and no
# surface both realizes an analyzed form and is typed unanalyzed prose (a 3-way
# disjunctive forbidden pattern over the focus lang:SurfaceForm).
lang:SurfaceAnalysisStructureConstraint
    a logic:Constraint ;
    rdfs:label "Surface analysis-structure constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a lang:SurfaceForm's structure matches its declared lang:analysisLevel — a parsedLevel surface lang:realizes a lang:ComposedForm, a rawLevel surface is typed lang:UnanalyzedProse, and no surface both realizes an analyzed form and is typed unanalyzed prose."@x-gmeow-english ;
    logic:formalizes lang:SurfaceAnalysisShape ;
    logic:message "A lang:SurfaceForm's structure must match its declared analysis level (parsed realizes a composed form; raw is unanalyzed prose; never both)." ;
    logic:integrity lang:sasForall .
lang:sasForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall lang:sasImpl .
lang:sasImpl a logic:Formula ; logic:antecedent lang:sasGuard ; logic:consequent lang:sasPhi .
lang:sasGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri lang:SurfaceForm ] .
lang:sasPhi a logic:Formula ; logic:not lang:sasBad .
lang:sasBad a logic:Formula ; logic:or lang:sasA , lang:sasB , lang:sasC .
lang:sasA a logic:Formula ; logic:and lang:sasAlvl , lang:sasAnoReal .
lang:sasAlvl a logic:Formula ; logic:relation lang:analysisLevel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri lang:parsedLevel ] .
lang:sasAnoReal a logic:Formula ; logic:not lang:sasARealEx .
lang:sasARealEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "f" ] ;
    logic:exists lang:sasARealBody .
lang:sasARealBody a logic:Formula ; logic:and lang:sasAReal , lang:sasACF .
lang:sasAReal a logic:Formula ; logic:relation lang:realizes ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "f" ] .
lang:sasACF a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termIri lang:ComposedForm ] .
lang:sasB a logic:Formula ; logic:and lang:sasBlvl , lang:sasBnoProse .
lang:sasBlvl a logic:Formula ; logic:relation lang:analysisLevel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri lang:rawLevel ] .
lang:sasBnoProse a logic:Formula ; logic:not lang:sasBProse .
lang:sasBProse a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri lang:UnanalyzedProse ] .
lang:sasC a logic:Formula ; logic:and lang:sasCRealEx , lang:sasCProse .
lang:sasCRealEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "g" ] ;
    logic:exists lang:sasCReal .
lang:sasCReal a logic:Formula ; logic:relation lang:realizes ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "g" ] .
lang:sasCProse a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri lang:UnanalyzedProse ] .

# lang:DependencyIntegrityShape (analysis-leaving half) — a lang:FormSlot whose
# lang:dependsOn head reference leaves the lang:Analysis its slot belongs to: it
# lang:dependsOn a head ?h and is lang:inAnalysis ?a, but ?h is not lang:inAnalysis
# the same ?a. The cycle half of this shape is the peer
# lang:FormSlotAcyclicDependencyConstraint.
lang:DependencyLeavesAnalysisConstraint
    a logic:Constraint ;
    rdfs:label "Dependency leaves-analysis constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a lang:FormSlot's lang:dependsOn head reference stays within the lang:Analysis its slot belongs to — a slot lang:inAnalysis ?a that lang:dependsOn a head ?h names a head that is itself lang:inAnalysis ?a. The dependency-cycle half is the peer lang:FormSlotAcyclicDependencyConstraint."@x-gmeow-english ;
    logic:formalizes lang:DependencyIntegrityShape ;
    logic:message "A dependency head reference leaves its analysis or forms a cycle." ;
    logic:integrity lang:dlaForall .
lang:dlaForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall lang:dlaImpl .
lang:dlaImpl a logic:Formula ; logic:antecedent lang:dlaGuard ; logic:consequent lang:dlaPhi .
lang:dlaGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri lang:FormSlot ] .
lang:dlaPhi a logic:Formula ; logic:not lang:dlaEx .
lang:dlaEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "h" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] ;
    logic:exists lang:dlaBody .
lang:dlaBody a logic:Formula ; logic:and lang:dlaDep , lang:dlaIn , lang:dlaNotIn .
lang:dlaDep a logic:Formula ; logic:relation lang:dependsOn ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "h" ] .
lang:dlaIn a logic:Formula ; logic:relation lang:inAnalysis ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .
lang:dlaNotIn a logic:Formula ; logic:not lang:dlaHeadIn .
lang:dlaHeadIn a logic:Formula ; logic:relation lang:inAnalysis ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "h" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .

# lang:DenotationNonSurfaceShape — a lang:Denotation attaches to a lang:Form that is
# not a lang:SurfaceForm; meaning attaches above the byte level, so a denotation
# whose lang:denotedForm is a lang:SurfaceForm is ill-formed.
lang:DenotationNonSurfaceConstraint
    a logic:Constraint ;
