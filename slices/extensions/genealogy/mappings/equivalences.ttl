@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix gedcom: <http://www.w3.org/2000/10/swap/pim/gedcom#> .
@prefix bio: <http://purl.org/vocab/bio/0.1/> .
@prefix gx: <http://gedcomx.org/> .
@prefix gxv: <http://gedcomx.org/v1/> .
@prefix gn: <http://www.geonames.org/ontology#> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix rel: <http://purl.org/vocab/relationship/> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# Term equivalences for the genealogy domain — GMEOW authoring source.
# Compiled to mappings/gmeow-genealogy.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetGenealogy a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/genealogy" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Genealogy alignments — kinship relationships and convenience properties to BIO / GEDCOM X / Wikidata / REL; legacy W3C gedcom predicates for coverage. Life-EVENT alignments (event types, dates, places, participant roles) live in the events mapset (gmeow-events.sssom.tsv), since life events are now the universal events module's concern. Supersedes the unmaintained SWAP gedcom as the canonical model." .

gmeow:Person skos:closeMatch gxv:Person {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:CoupleRelationship skos:closeMatch gx:Couple {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:ParentChildRelationship skos:closeMatch gx:ParentChild {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:BiologicalParentChild skos:closeMatch gx:BiologicalParent {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:AdoptiveParentChild skos:closeMatch gx:AdoptiveParent {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:StepParentChild skos:closeMatch gx:StepParent {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:FosterParentChild skos:closeMatch gx:FosterParent {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:PersonName skos:closeMatch gxv:Name {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:CreativeWork skos:closeMatch gxv:SourceDescription {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Source-hood is anti-rigid; the described thing is a CreativeWork (WEMI) bearing SourceRole."
|} .

gmeow:Selector skos:closeMatch gxv:SourceReference {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "The retired gmeow:Citation locator is replaced by gmeow:Selector."
|} .

gmeow:Place skos:closeMatch gn:Feature {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "GeoNames feature"
|} .

gmeow:hasFather skos:closeMatch bio:father {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:hasMother skos:closeMatch bio:mother {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:hasChild skos:closeMatch bio:child {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:hasParent skos:closeMatch wdt:P8810 {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "parent (gender-neutral)"
|} .

gmeow:hasFather skos:closeMatch wdt:P22 {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "father"
|} .

gmeow:hasMother skos:closeMatch wdt:P25 {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "mother"
|} .

gmeow:hasChild skos:closeMatch wdt:P40 {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "child"
|} .

gmeow:hasSpouse skos:closeMatch wdt:P26 {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "spouse"
|} .

gmeow:hasSibling skos:closeMatch wdt:P3373 {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "sibling"
|} .

gmeow:hasChild skos:closeMatch gedcom:child {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "legacy W3C gedcom"
|} .

gmeow:hasPartner skos:closeMatch gedcom:husband {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "legacy W3C gedcom couple role"
|} .

gmeow:hasPartner skos:closeMatch gedcom:wife {|
    gmeow:sssomFile "gmeow-genealogy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "legacy W3C gedcom couple role"
|} .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:Family owl:equivalentClass gedcom:Family {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:hasParent owl:equivalentProperty schema:parent {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:hasParent owl:equivalentProperty rel:childOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "childOf points child->parent = hasParent"
|} .

gmeow:hasChild owl:equivalentProperty schema:children {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:hasChild owl:equivalentProperty rel:parentOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:hasSpouse owl:equivalentProperty schema:spouse {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:hasSpouse owl:equivalentProperty rel:spouseOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:hasSibling owl:equivalentProperty schema:sibling {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:hasSibling owl:equivalentProperty rel:siblingOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:Family skos:exactMatch wd:Q8436 {|
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "family"
|} .

gmeow:KinRelationship skos:closeMatch sosa:Observation {|
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "SOSA does not distinguish observation types; a kinship claim is a kind of observation in the universal stack."
|} .
