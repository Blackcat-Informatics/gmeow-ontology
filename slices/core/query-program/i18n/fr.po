msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldStepLaw|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query score finite-fold law"
msgstr "Loi de repli fini des scores de requête"

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldStepLaw|http://www.w3.org/2004/02/skos/core#definition"
msgid "Each positive step extends the same score’s previous index by one and adds its contribution exactly once."
msgstr "Chaque étape positive prolonge l’indice précédent du même score de un et ajoute sa contribution une seule fois."

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldStepLaw|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query score finite-fold law with explicit source bindings."
msgstr "Utiliser pour décrire loi de repli fini des scores de requête avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldStepLaw|https://blackcatinformatics.ca/gmeow/avoidWhen"
