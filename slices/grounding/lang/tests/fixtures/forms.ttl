#
# Shared ABox fixture for the language competency questions. Unioned onto the merged
# ontology by gmeow:cqDataFile; each query projects its own slice. It analyses the
# sentence "cats sleep": one raw unanalyzed-prose surface and one parsed surface that
# realizes a composed form over two slots, whose slot forms are the word forms "cats"
# (an inflection of the lexeme cat, Number=Plur) and "sleep" (an inflection of the
# lexeme sleep, Number=Plur). The fixture is fully conformant to lang/shapes.ttl.

@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:latin a lang:Script .

# Q1 — one raw unanalyzed-prose surface and one parsed surface of the same text.
ex:rawSurface a lang:UnanalyzedProse ; lang:inSignSystem ex:english ; lang:surfaceText "cats sleep" ;
    lang:inScript ex:latin ; lang:unicodeNormalization "NFC" ; lang:collationLocale "en" ;
    lang:analysisLevel lang:rawLevel .
ex:parsedSurface a lang:SurfaceForm ; lang:inSignSystem ex:english ; lang:surfaceText "cats sleep" ;
    lang:inScript ex:latin ; lang:unicodeNormalization "NFC" ; lang:collationLocale "en" ;
    lang:analysisLevel lang:parsedLevel ; lang:realizes ex:cf .

# Q2 — the composed form over two indexed slots realized by the parsed surface.
ex:cf a lang:ComposedForm ; lang:inSignSystem ex:english ; lang:compositionLevel lang:sentenceLevel ;
    lang:formSlot ex:s0 , ex:s1 .
ex:s0 a lang:FormSlot ; lang:slotIndex 0 ; lang:slotForm ex:wfCats .
ex:s1 a lang:FormSlot ; lang:slotIndex 1 ; lang:slotForm ex:wfSleep .

# Q3 — the two word forms, their lexemes, and their typed Number morphology.
ex:wfCats a lang:WordForm ; lang:inSignSystem ex:english ; lang:inflectionOf ex:lexCat ;
    lang:lexemeOf ex:lexCat ; lang:morphFeature ex:mfCatsNum .
ex:wfSleep a lang:WordForm ; lang:inSignSystem ex:english ; lang:inflectionOf ex:lexSleep ;
    lang:lexemeOf ex:lexSleep ; lang:morphFeature ex:mfSleepNum .
ex:lexCat a lang:Lexeme ; lang:inSignSystem ex:english ; lang:partOfSpeech lang:noun .
ex:lexSleep a lang:Lexeme ; lang:inSignSystem ex:english ; lang:partOfSpeech lang:verb .
ex:mfCatsNum a lang:MorphFeature ; lang:featureKey lang:featNumber ; lang:featureValue lang:valPlur .
ex:mfSleepNum a lang:MorphFeature ; lang:featureKey lang:featNumber ; lang:featureValue lang:valPlur .
