    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:skills ; gmeow:relation "=" ; gmeow:confidence 0.9 ] .

gmeow:mapSchemaDeathDate a gmeow:ProjectionMapping ;
    rdfs:label "Death life-event date → schema:deathDate"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ddPerson" ; gmeow:value "ddWhen" ;
        gmeow:atom (
            [ gmeow:subjectVar "ddEvent" ; gmeow:predicate gmeow:eventType ; gmeow:objectValue gmeow:eventTypeDeath ]
            [ gmeow:subjectVar "ddPart" ; gmeow:predicate gmeow:participationEvent ; gmeow:objectVar "ddEvent" ]
            [ gmeow:subjectVar "ddPart" ; gmeow:predicate gmeow:participationRole ; gmeow:objectValue gmeow:roleParticipantPrincipal ]
            [ gmeow:subjectVar "ddPart" ; gmeow:predicate gmeow:participationParticipant ; gmeow:objectVar "ddPerson" ]
            [ gmeow:subjectVar "ddEvent" ; gmeow:predicate gmeow:eventTime ; gmeow:objectVar "ddWhen" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:deathDate ; gmeow:relation "<=" ; gmeow:confidence 0.95 ;
        gmeow:lossyDrop "the death Participation (role, period, confidence, standpoint) is dropped; only the principal's death instant survives" ] .

gmeow:mapSchemaBirthPlace a gmeow:ProjectionMapping ;
    rdfs:label "Birth life-event place → schema:birthPlace"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "bpPerson" ; gmeow:value "bpWhere" ;
        gmeow:atom (
            [ gmeow:subjectVar "bpEvent" ; gmeow:predicate gmeow:eventType ; gmeow:objectValue gmeow:eventTypeBirth ]
            [ gmeow:subjectVar "bpPart" ; gmeow:predicate gmeow:participationEvent ; gmeow:objectVar "bpEvent" ]
            [ gmeow:subjectVar "bpPart" ; gmeow:predicate gmeow:participationRole ; gmeow:objectValue gmeow:roleParticipantPrincipal ]
            [ gmeow:subjectVar "bpPart" ; gmeow:predicate gmeow:participationParticipant ; gmeow:objectVar "bpPerson" ]
            [ gmeow:subjectVar "bpEvent" ; gmeow:predicate gmeow:eventLocation ; gmeow:objectVar "bpWhere" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:birthPlace ; gmeow:relation "<=" ; gmeow:confidence 0.95 ;
        gmeow:lossyDrop "the birth Participation detail drops; only the principal's birthplace survives" ] .

gmeow:mapSchemaDeathPlace a gmeow:ProjectionMapping ;
    rdfs:label "Death life-event place → schema:deathPlace"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "dpPerson" ; gmeow:value "dpWhere" ;
        gmeow:atom (
            [ gmeow:subjectVar "dpEvent" ; gmeow:predicate gmeow:eventType ; gmeow:objectValue gmeow:eventTypeDeath ]
            [ gmeow:subjectVar "dpPart" ; gmeow:predicate gmeow:participationEvent ; gmeow:objectVar "dpEvent" ]
            [ gmeow:subjectVar "dpPart" ; gmeow:predicate gmeow:participationRole ; gmeow:objectValue gmeow:roleParticipantPrincipal ]
            [ gmeow:subjectVar "dpPart" ; gmeow:predicate gmeow:participationParticipant ; gmeow:objectVar "dpPerson" ]
            [ gmeow:subjectVar "dpEvent" ; gmeow:predicate gmeow:eventLocation ; gmeow:objectVar "dpWhere" ] ) ;
        gmeow:edoalPath true ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:deathPlace ; gmeow:relation "<=" ; gmeow:confidence 0.95 ;
        gmeow:lossyDrop "the death Participation detail drops; only the principal's deathplace survives" ] .

gmeow:mapSchemaCreator a gmeow:ProjectionMapping ;
    rdfs:label "hasAuthor → schema:creator"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "crWork" ; gmeow:value "crAgent" ;
        gmeow:atom ( [ gmeow:subjectVar "crWork" ; gmeow:predicate gmeow:hasAuthor ; gmeow:objectVar "crAgent" ] ) ;
        gmeow:edoalSource gmeow:hasAuthor ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:creator ; gmeow:relation "<=" ; gmeow:confidence 0.9 ] .

gmeow:mapSchemaSourceCode a gmeow:ProjectionMapping ;
    rdfs:label "Repository → schema:SoftwareSourceCode + codeRepository"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ssrcRepo" ;
        gmeow:atom (
            [ gmeow:subjectVar "ssrcRepo" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Repository ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "ssrcRepo" ; gmeow:predicate gmeow:webUrl ; gmeow:objectVar "ssrcUrl" ] ) ] ) ;
        gmeow:edoalSource gmeow:Repository ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toClass schema:SoftwareSourceCode ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the repository facet narrows to schema's source-code reading; clone protocol detail drops" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "ssrcRepo" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:SoftwareSourceCode ]
            [ gmeow:tSubj "ssrcRepo" ; gmeow:tPred schema:codeRepository ; gmeow:tObj "ssrcUrl" ] ) ] .

gmeow:mapSchemaMaintainer a gmeow:ProjectionMapping ;
    rdfs:label "Contribution(role=SoftwareMaintainer) → schema:maintainer"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "smtProj" ; gmeow:value "smtAgent" ;
        gmeow:atom (
            [ gmeow:subjectVar "smtC" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Contribution ]
            [ gmeow:subjectVar "smtC" ; gmeow:predicate gmeow:contributionTarget ; gmeow:objectVar "smtProj" ]
            [ gmeow:subjectVar "smtC" ; gmeow:predicate gmeow:contributor ; gmeow:objectVar "smtAgent" ]
            [ gmeow:subjectVar "smtC" ; gmeow:predicate gmeow:contributionRole ; gmeow:objectValue gmeow:roleSoftwareMaintainer ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "smtAgent" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:contributionRole ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:maintainer ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "contribution period, provenance, confidence, degree drop" ] .

# --------------------------------------------------------------------------- #
# Movement events → schema:MoveAction. The endpoint pair IS the movement
# signal: any event carrying a from- or to-location is movement-shaped, so the
# MoveAction typing is structural — migration / immigration / emigration /
# household moves all derive without enumerating event-type values (P9: the
# kind stays an open value; schema's action class is a projection artifact).
# --------------------------------------------------------------------------- #

gmeow:mapSchemaMoveActionFrom a gmeow:ProjectionMapping ;
    rdfs:label "eventFromLocation → schema:MoveAction + fromLocation"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "mvEv" ; gmeow:value "mvFrom" ;
        gmeow:atom (
            [ gmeow:subjectVar "mvEv" ; gmeow:predicate gmeow:eventFromLocation ; gmeow:objectVar "mvFrom" ] ) ;
        gmeow:edoalSource gmeow:eventFromLocation ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the event's open kind value, temporal fuzziness and participation detail drop; only the action shape with its origin survives" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "mvEv" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:MoveAction ]
            [ gmeow:tSubj "mvEv" ; gmeow:tPred schema:fromLocation ; gmeow:tObj "mvFrom" ] ) ] .

gmeow:mapSchemaMoveActionTo a gmeow:ProjectionMapping ;
    rdfs:label "eventToLocation → schema:MoveAction + toLocation"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "mvtEv" ; gmeow:value "mvTo" ;
        gmeow:atom (
            [ gmeow:subjectVar "mvtEv" ; gmeow:predicate gmeow:eventToLocation ; gmeow:objectVar "mvTo" ] ) ;
        gmeow:edoalSource gmeow:eventToLocation ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the event's open kind value, temporal fuzziness and participation detail drop; only the action shape with its destination survives" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "mvtEv" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:MoveAction ]
            [ gmeow:tSubj "mvtEv" ; gmeow:tPred schema:toLocation ; gmeow:tObj "mvTo" ] ) ] .

# --------------------------------------------------------------------------- #
# External-identifier records → schema:PropertyValue. The reified
# gmeow:Identifier node IS the property-value bundle, so it is REUSED as the
# schema:PropertyValue (no mint): propertyID ← the scheme code, value ← the
# scheme-local value, url ← the resolvable authority URL, name ← the human
# label. Hung off the bearing entity by schema:identifier. This is the largest
# Long-tail external-identifier profile rows.
# --------------------------------------------------------------------------- #

gmeow:mapSchemaIdentifierRecord a gmeow:ProjectionMapping ;
    rdfs:label "Identifier record → schema:PropertyValue"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "idrEnt" ;
        gmeow:atom (
            [ gmeow:subjectVar "idrEnt" ; gmeow:predicate gmeow:hasIdentifier ; gmeow:objectVar "idrRec" ]
            [ gmeow:subjectVar "idrRec" ; gmeow:predicate gmeow:identifierScheme ; gmeow:objectVar "idrScheme" ]
            [ gmeow:subjectVar "idrRec" ; gmeow:predicate gmeow:identifierValue ; gmeow:objectVar "idrValue" ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "idrRec" ; gmeow:predicate gmeow:identifierUrl ; gmeow:objectVar "idrUrl" ] ) ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "idrRec" ; gmeow:predicate rdfs:label ; gmeow:objectVar "idrName" ] ) ] ) ;
        gmeow:edoalSource gmeow:Identifier ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "jurisdiction and any standpoint/validity detail on the record drop; schema's PropertyValue carries only the scheme/value/url/name quad; the record's rdfs:label is its display name" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "idrEnt" ; gmeow:tPred schema:identifier ; gmeow:tObj "idrRec" ]
            [ gmeow:tSubj "idrRec" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:PropertyValue ]
            [ gmeow:tSubj "idrRec" ; gmeow:tPred schema:propertyID ; gmeow:tObj "idrScheme" ]
            [ gmeow:tSubj "idrRec" ; gmeow:tPred schema:value ; gmeow:tObj "idrValue" ]
            [ gmeow:tSubj "idrRec" ; gmeow:tPred schema:url ; gmeow:tObj "idrUrl" ]
            [ gmeow:tSubj "idrRec" ; gmeow:tPred schema:name ; gmeow:tObj "idrName" ] ) ] .

# --------------------------------------------------------------------------- #
# Web presence. WebSite typing; the page→site hierarchy as isPartOf (the
# breadcrumb trail); a page's principal subject as schema:mainEntity (and its
# inverse schema:mainEntityOfPage); ProfilePage derived STRUCTURALLY from a page
# whose principal subject is an Agent (the defined-class logic, matched directly
# so no reasoner materialization is needed).
# --------------------------------------------------------------------------- #

gmeow:mapSchemaWebSite a gmeow:ProjectionMapping ;
    rdfs:label "WebSite → schema:WebSite"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "wsite" ;
        gmeow:atom ( [ gmeow:subjectVar "wsite" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:WebSite ] ) ;
        gmeow:edoalSource gmeow:WebSite ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toClass schema:WebSite ; gmeow:relation "<=" ; gmeow:confidence 0.9 ] .

gmeow:mapSchemaPageOfSite a gmeow:ProjectionMapping ;
    rdfs:label "pageOfSite → schema:isPartOf (the breadcrumb trail)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "posPage" ; gmeow:value "posSite" ;
        gmeow:atom ( [ gmeow:subjectVar "posPage" ; gmeow:predicate gmeow:pageOfSite ; gmeow:objectVar "posSite" ] ) ;
        gmeow:edoalSource gmeow:pageOfSite ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:isPartOf ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the page→site mereology is the breadcrumb hierarchy; schema:BreadcrumbList's ordered ListItem wrapper is a presentation concern over this isPartOf chain (P12)" ] .

gmeow:mapSchemaPageMainEntity a gmeow:ProjectionMapping ;
    rdfs:label "pagePrincipalSubject → schema:mainEntity (+ inverse mainEntityOfPage)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "pmePage" ; gmeow:value "pmeEnt" ;
        gmeow:atom ( [ gmeow:subjectVar "pmePage" ; gmeow:predicate gmeow:pagePrincipalSubject ; gmeow:objectVar "pmeEnt" ] ) ;
        gmeow:edoalSource gmeow:pagePrincipalSubject ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the page's other isAbout mentions drop; only the principal subject becomes mainEntity, with its inverse mainEntityOfPage on the subject" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "pmePage" ; gmeow:tPred schema:mainEntity ; gmeow:tObj "pmeEnt" ]
            [ gmeow:tSubj "pmeEnt" ; gmeow:tPred schema:mainEntityOfPage ; gmeow:tObj "pmePage" ] ) ] .

gmeow:mapSchemaProfilePage a gmeow:ProjectionMapping ;
    rdfs:label "WebPage about an Agent → schema:ProfilePage (defined-class logic)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ppPage" ;
        gmeow:atom (
            [ gmeow:subjectVar "ppPage" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:WebPage ]
            [ gmeow:subjectVar "ppPage" ; gmeow:predicate gmeow:pagePrincipalSubject ; gmeow:objectVar "ppAgent" ]
            [ gmeow:subjectVar "ppAgent" ;
              gmeow:path [ a gmeow:SeqPath ; gmeow:pathSteps
                  ( rdf:type [ a gmeow:ZeroOrMorePath ; gmeow:pathStep rdfs:subClassOf ] ) ] ;
              gmeow:objectValue gmeow:Agent ] ) ;
        gmeow:edoalSource gmeow:ProfilePage ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toClass schema:ProfilePage ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the WebPage→ProfilePage refinement is the defined-class inference (page principally about an Agent); schema gets the bare ProfilePage typing" ] .

gmeow:mapSchemaInLanguage a gmeow:ProjectionMapping ;
    rdfs:label "contentLanguage → schema:inLanguage / iso6391Code"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ilWork" ;
        gmeow:atom (
            [ gmeow:subjectVar "ilWork" ; gmeow:predicate gmeow:contentLanguage ; gmeow:objectVar "ilLang" ]
            [ gmeow:subjectVar "ilVariety" ; gmeow:predicate lang:varietyOf ; gmeow:objectVar "ilLang" ]
            [ gmeow:subjectVar "ilVariety" ; gmeow:predicate gmeow:bcp47Tag ; gmeow:objectVar "ilTag" ] ) ;
        gmeow:edoalSource gmeow:contentLanguage ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the first-class gmeow:Language collapses to its BCP-47 / ISO 639-1 tag string; script and variety detail drop" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "ilWork" ; gmeow:tPred schema:inLanguage ; gmeow:tObj "ilTag" ] ) ] .

gmeow:mapSchemaEncodingFormat a gmeow:ProjectionMapping ;
    rdfs:label "mediaType → schema:encodingFormat"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "efObj" ; gmeow:value "efType" ;
        gmeow:atom ( [ gmeow:subjectVar "efObj" ; gmeow:predicate gmeow:mediaType ; gmeow:objectVar "efType" ] ) ;
        gmeow:edoalSource gmeow:mediaType ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:encodingFormat ; gmeow:relation "=" ; gmeow:confidence 0.95 ] .

gmeow:mapSchemaImage a gmeow:ProjectionMapping ;
    rdfs:label "depicted entity → schema:image (the depicting MediaObject)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "imgObj" ; gmeow:value "imgEnt" ;
        gmeow:atom (
            [ gmeow:subjectVar "imgObj" ; gmeow:predicate gmeow:depicts ; gmeow:objectVar "imgEnt" ]
            [ gmeow:subjectVar "imgObj" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:MediaObject ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "imgEnt" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:depicts ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the depiction's context/period/audience drop; the entity gains schema:image pointing at the depicting MediaObject" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "imgEnt" ; gmeow:tPred schema:image ; gmeow:tObj "imgObj" ] ) ] .

gmeow:mapSchemaVersionLineage a gmeow:ProjectionMapping ;
    rdfs:label "hasVersion → schema:hasPart (the version entity)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "verLineage" ; gmeow:value "verEntity" ;
        gmeow:atom ( [ gmeow:subjectVar "verLineage" ; gmeow:predicate gmeow:hasVersion ; gmeow:objectVar "verEntity" ] ) ;
        gmeow:edoalSource gmeow:hasVersion ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:hasPart ; gmeow:relation "<=" ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "the version-lineage edge coarsens to schema:hasPart (the version is part of the lineage's release set); the lineage semantics drop" ] .

# Dataset distribution → schema:DataDownload (mirrors the dcat leg). A corpus
# member document is REUSED as the DataDownload node: contentUrl ← sourceLocation,
# encodingFormat ← mediaType.
gmeow:mapSchemaDataDownload a gmeow:ProjectionMapping ;
    rdfs:label "corpusMember → schema:distribution + DataDownload"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ddCorpus" ;
        gmeow:atom (
            [ gmeow:subjectVar "ddCorpus" ; gmeow:predicate gmeow:corpusMember ; gmeow:objectVar "ddDoc" ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "ddDoc" ; gmeow:predicate gmeow:sourceLocation ; gmeow:objectVar "ddUrl" ] ) ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "ddDoc" ; gmeow:predicate gmeow:mediaType ; gmeow:objectVar "ddFmt" ] ) ] ) ;
        gmeow:edoalSource gmeow:corpusMember ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the member document is REUSED as the schema:DataDownload node; its GMEOW typing drops" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "ddCorpus" ; gmeow:tPred schema:distribution ; gmeow:tObj "ddDoc" ]
            [ gmeow:tSubj "ddDoc" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:DataDownload ]
            [ gmeow:tSubj "ddDoc" ; gmeow:tPred schema:contentUrl ; gmeow:tObj "ddUrl" ]
            [ gmeow:tSubj "ddDoc" ; gmeow:tPred schema:encodingFormat ; gmeow:tObj "ddFmt" ] ) ] .

# --------------------------------------------------------------------------- #
# Syndicated content: postings, quotations, shares, feeds. A FeedPosting
# projects to schema:SocialMediaPosting or schema:BlogPosting by its kind value;
# quoted content becomes a schema:Quotation; shared content rides
# schema:sharedContent; a DataFeed and its members become schema:DataFeed +
# dataFeedElement + DataFeedItem. The paudley profile's social presence is the
# P15 consumer (the sioc partial's awaited consumer, resolved alongside).
# --------------------------------------------------------------------------- #

gmeow:mapSchemaSocialPosting a gmeow:ProjectionMapping ;
    rdfs:label "FeedPosting(social) → schema:SocialMediaPosting"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "spPost" ;
        gmeow:atom (
            [ gmeow:subjectVar "spPost" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:FeedPosting ]
            [ gmeow:subjectVar "spPost" ; gmeow:predicate gmeow:feedPostingKind ; gmeow:objectValue gmeow:feedPostingKindSocial ] ) ;
        gmeow:edoalSource gmeow:FeedPosting ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toClass schema:SocialMediaPosting ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the open posting-kind value collapses to schema's fixed SocialMediaPosting class" ] .

gmeow:mapSchemaMicroblogPosting a gmeow:ProjectionMapping ;
    rdfs:label "FeedPosting(microblog) → schema:SocialMediaPosting"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "mpPost" ;
        gmeow:atom (
            [ gmeow:subjectVar "mpPost" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:FeedPosting ]
            [ gmeow:subjectVar "mpPost" ; gmeow:predicate gmeow:feedPostingKind ; gmeow:objectValue gmeow:feedPostingKindMicroblog ] ) ;
        gmeow:edoalSource gmeow:FeedPosting ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toClass schema:SocialMediaPosting ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "microblog narrows to schema's SocialMediaPosting (no microblog subclass)" ] .

gmeow:mapSchemaBlogPosting a gmeow:ProjectionMapping ;
    rdfs:label "FeedPosting(blog) → schema:BlogPosting"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "bpPost" ;
        gmeow:atom (
            [ gmeow:subjectVar "bpPost" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:FeedPosting ]
            [ gmeow:subjectVar "bpPost" ; gmeow:predicate gmeow:feedPostingKind ; gmeow:objectValue gmeow:feedPostingKindBlog ] ) ;
        gmeow:edoalSource gmeow:FeedPosting ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toClass schema:BlogPosting ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "the open posting-kind value collapses to schema's fixed BlogPosting class" ] .

gmeow:mapSchemaQuotation a gmeow:ProjectionMapping ;
    rdfs:label "quotesContent → schema:Quotation + citation"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "qWork" ; gmeow:value "qSrc" ;
        gmeow:atom ( [ gmeow:subjectVar "qWork" ; gmeow:predicate gmeow:quotesContent ; gmeow:objectVar "qSrc" ] ) ;
        gmeow:edoalSource gmeow:quotesContent ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the quoted source is typed schema:Quotation and linked by schema:citation; the inline quoted text (gmeow:quotedText), when present, rides as schema:text on the Quotation via mapSchemaQuotedText" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "qWork" ; gmeow:tPred schema:citation ; gmeow:tObj "qSrc" ]
            [ gmeow:tSubj "qSrc" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:Quotation ] ) ] .

gmeow:mapSchemaQuotedText a gmeow:ProjectionMapping ;
    rdfs:label "quotedText → schema:text on the Quotation"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "qtWork" ; gmeow:value "qtText" ;
        gmeow:atom (
            [ gmeow:subjectVar "qtWork" ; gmeow:predicate gmeow:quotesContent ; gmeow:objectVar "qtSrc" ]
            [ gmeow:subjectVar "qtWork" ; gmeow:predicate gmeow:quotedText ; gmeow:objectVar "qtText" ] ) ;
        gmeow:edoalSource gmeow:quotedText ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        # a clean 1:1 property correspondence (templateAtoms only because the
        # emit subject qtSrc differs from the anchor) — declare its EDOAL target
        gmeow:edoalTarget schema:text ; gmeow:edoalTargetKind "property" ;
        gmeow:lossyDrop "the inline quoted text lands on the Quotation node (the reused source); its position/offset within the quoting work is not modelled" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "qtSrc" ; gmeow:tPred schema:text ; gmeow:tObj "qtText" ] ) ] .

gmeow:mapSchemaSharedContent a gmeow:ProjectionMapping ;
    rdfs:label "sharesContent → schema:sharedContent"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "scPost" ; gmeow:value "scShared" ;
        gmeow:atom ( [ gmeow:subjectVar "scPost" ; gmeow:predicate gmeow:sharesContent ; gmeow:objectVar "scShared" ] ) ;
        gmeow:edoalSource gmeow:sharesContent ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:sharedContent ; gmeow:relation "=" ; gmeow:confidence 0.9 ] .

gmeow:mapSchemaDataFeed a gmeow:ProjectionMapping ;
    rdfs:label "DataFeed + members → schema:DataFeed / dataFeedElement / DataFeedItem"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "dfFeed" ;
        gmeow:atom (
            [ gmeow:subjectVar "dfFeed" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:DataFeed ]
            [ gmeow:subjectVar "dfFeed" ; gmeow:predicate gmeow:hasPart ; gmeow:objectVar "dfItem" ] ) ;
        gmeow:edoalSource gmeow:DataFeed ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the feed's ordered membership flattens to schema:dataFeedElement; each member is REUSED as a schema:DataFeedItem (no item-wrapper mint)" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "dfFeed" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:DataFeed ]
            [ gmeow:tSubj "dfFeed" ; gmeow:tPred schema:dataFeedElement ; gmeow:tObj "dfItem" ]
            [ gmeow:tSubj "dfItem" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:DataFeedItem ] ) ] .

# --------------------------------------------------------------------------- #
# People / org surface, presence history, long tail.
# --------------------------------------------------------------------------- #

gmeow:mapSchemaContactType a gmeow:ProjectionMapping ;
    rdfs:label "contactPointType value → schema:contactType (label)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ctPoint" ; gmeow:value "ctLabel" ;
        gmeow:atom (
            [ gmeow:subjectVar "ctPoint" ; gmeow:predicate gmeow:contactPointType ; gmeow:objectVar "ctVal" ]
            [ gmeow:subjectVar "ctVal" ; gmeow:predicate rdfs:label ; gmeow:objectVar "ctLabel" ] ) ;
        gmeow:edoalSource gmeow:contactPointType ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:contactType ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the first-class ContactPointType value collapses to its label string" ] .

gmeow:mapSchemaPublisher a gmeow:ProjectionMapping ;
    rdfs:label "Contribution(role=publisher) → schema:publisher"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "pubWork" ; gmeow:value "pubAgent" ;
        gmeow:atom (
            [ gmeow:subjectVar "pubC" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Contribution ]
            [ gmeow:subjectVar "pubC" ; gmeow:predicate gmeow:contributionTarget ; gmeow:objectVar "pubWork" ]
            [ gmeow:subjectVar "pubC" ; gmeow:predicate gmeow:contributor ; gmeow:objectVar "pubAgent" ]
            [ gmeow:subjectVar "pubC" ; gmeow:predicate gmeow:contributionRole ; gmeow:objectValue gmeow:rolePublisher ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "pubAgent" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:contributionRole ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:publisher ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "contribution period, provenance, confidence drop" ] .

gmeow:mapSchemaInventor a gmeow:ProjectionMapping ;
    rdfs:label "Contribution(role=inventor) → schema:inventor"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "invWork" ; gmeow:value "invAgent" ;
        gmeow:atom (
            [ gmeow:subjectVar "invC" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Contribution ]
            [ gmeow:subjectVar "invC" ; gmeow:predicate gmeow:contributionTarget ; gmeow:objectVar "invWork" ]
            [ gmeow:subjectVar "invC" ; gmeow:predicate gmeow:contributor ; gmeow:objectVar "invAgent" ]
            [ gmeow:subjectVar "invC" ; gmeow:predicate gmeow:contributionRole ; gmeow:objectValue gmeow:roleInventor ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "invAgent" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:contributionRole ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:inventor ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "contribution period, provenance, confidence drop" ] .

gmeow:mapSchemaFounder a gmeow:ProjectionMapping ;
    rdfs:label "foundedBy / founderOf → schema:founder"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "fOrg" ; gmeow:value "fAgent" ;
        # match the founding edge from EITHER direction (queries run without
        # inverse inference): foundedBy (org→agent) or ^founderOf (agent→org)
        gmeow:atom ( [ gmeow:subjectVar "fOrg" ;
            gmeow:path [ a gmeow:AltPath ; gmeow:pathAlts (
                gmeow:foundedBy
                [ a gmeow:InversePath ; gmeow:pathStep gmeow:founderOf ] ) ] ;
            gmeow:objectVar "fAgent" ] ) ;
        gmeow:edoalSource gmeow:foundedBy ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:founder ; gmeow:relation "<=" ; gmeow:confidence 0.9 ] .

gmeow:mapSchemaOwns a gmeow:ProjectionMapping ;
    rdfs:label "ownerOf → schema:owns"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "oAgent" ; gmeow:value "oItem" ;
        gmeow:atom ( [ gmeow:subjectVar "oAgent" ; gmeow:predicate gmeow:ownerOf ; gmeow:objectVar "oItem" ] ) ;
        gmeow:edoalSource gmeow:ownerOf ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:owns ; gmeow:relation "<=" ; gmeow:confidence 0.85 ] .

