#
# Declarative structural assertions for the epistemics slice — the slice-resident
# test-DSL twin of the MUST / MUST-NOT invariants formerly hand-written in
# tests/test_epistemics.py. Authored as gmeow: ontology data so the same
# annotation discipline and the native Rust harness (crates/slicetest)
# drive the test, not ad-hoc Python. Each assertion runs as a SPARQL ASK over the
# module graph (gmeow:scopeModule). A positive universal over a fixed term set is
# a single MUST with a conjunctive pattern (every conjunct must match); a
# negative universal ("no spine property has X") is a MUST-NOT over a VALUES set.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest→DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/epistemics/tests/> .

# --- 1. Keystone entailment: knowsThat ⊑ believes (MUST hold) ----------------
ex:saKnowsThatSubPropertyOfBelieves a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """ASK {
        <https://blackcatinformatics.ca/gmeow/knowsThat>
            <http://www.w3.org/2000/01/rdf-schema#subPropertyOf>
            <https://blackcatinformatics.ca/gmeow/believes> .
    }""" ;
    gmeow:saRationale "The keystone entailment of the epistemics slice: gmeow:knowsThat MUST be a subproperty of gmeow:believes so that knowing a proposition entails believing it. Mirrors test_knows_that_subproperty_of_believes in test_epistemics.py." .

# --- 2. No truth bit: gmeow:isTrue in NO triple position (MUST-NOT hold) ------
ex:saNoTruthBit a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """ASK {
        { <https://blackcatinformatics.ca/gmeow/isTrue> ?p ?o . }
        UNION
        { ?s <https://blackcatinformatics.ca/gmeow/isTrue> ?o . }
        UNION
        { ?s ?p <https://blackcatinformatics.ca/gmeow/isTrue> . }
    }""" ;
    gmeow:saRationale "The no-truth-bit invariant: the epistemics slice is deliberately non-factive (CONSTITUTION Principle 12), so gmeow:isTrue MUST NOT appear in any subject, predicate, or object position. Mirrors test_no_factivity_no_truth_bit in test_epistemics.py." .

# --- 3. Doxastic spine: object properties with Agent domain (MUST hold) -------
ex:saSpineObjectPropertiesWithAgentDomain a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:believes           a owl:ObjectProperty ; rdfs:domain gmeow:Agent .
    gmeow:doubts             a owl:ObjectProperty ; rdfs:domain gmeow:Agent .
    gmeow:suspendsJudgementOn a owl:ObjectProperty ; rdfs:domain gmeow:Agent .
    gmeow:accepts            a owl:ObjectProperty ; rdfs:domain gmeow:Agent .
    gmeow:knowsThat          a owl:ObjectProperty ; rdfs:domain gmeow:Agent .
}""" ;
    gmeow:saRationale "Every property of the flat doxastic spine (believes, doubts, suspendsJudgementOn, accepts, knowsThat) MUST be an owl:ObjectProperty with rdfs:domain gmeow:Agent. Mirrors test_spine_are_object_properties_with_agent_domain." .

# --- 4. Doxastic spine is open-range: NO rdfs:range (MUST-NOT hold) -----------
ex:saSpineOpenRange a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?p { gmeow:believes gmeow:doubts gmeow:suspendsJudgementOn gmeow:accepts gmeow:knowsThat }
    ?p rdfs:range ?r .
}""" ;
    gmeow:saRationale "The flat spine is open-range (Principle 13): no spine property — including gmeow:knowsThat, which must smuggle in no factivity range — may declare an rdfs:range. Mirrors test_spine_have_open_range and the range clause of test_no_factivity_no_truth_bit." .

# --- 5. Proposition is a SocialObject (MUST hold) ----------------------------
ex:saPropositionIsSocialObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:Proposition rdfs:subClassOf gmeow:SocialObject . }""" ;
    gmeow:saRationale "A proposition is a social object — the content an agent takes an attitude toward. Mirrors test_proposition_is_a_social_object." .

# --- 6. Doxastic spine is non-functional (MUST-NOT hold) ----------------------
ex:saSpineNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p { gmeow:believes gmeow:doubts gmeow:suspendsJudgementOn gmeow:accepts gmeow:knowsThat }
    ?p a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "An agent holds many attitudes and contested ones coexist (Principle 9), so no doxastic-spine property may be declared owl:FunctionalProperty (the no-functional-declaration invariant). Mirrors test_spine_properties_are_not_functional." .

# --- 7. DoxasticStandpointClaim ⊑ StandpointClaim (MUST hold) -----------------
ex:saDoxasticStandpointClaimSubclass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:DoxasticStandpointClaim rdfs:subClassOf gmeow:StandpointClaim . }""" ;
    gmeow:saRationale "A doxastic standpoint claim is a kind of standpoint claim. Mirrors test_doxastic_standpoint_claim_is_subclass_of_standpoint_claim." .

# --- 8. claimOfBelief is a functional object property (MUST hold) -------------
ex:saClaimOfBeliefFunctionalObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:claimOfBelief a owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:DoxasticStandpointClaim ;
        rdfs:range gmeow:DoxasticState .
}""" ;
    gmeow:saRationale "gmeow:claimOfBelief is a functional object property from DoxasticStandpointClaim to DoxasticState. Mirrors test_claim_of_belief_is_functional_object_property." .

# --- 9. Five-way justification split: named domains/ranges (MUST/-NOT) --------
# (The single former justification hook is replaced by five independent edges
#  separating available-evidence from basing. The exact owl:unionOf membership of
#  the named categories remains a bespoke pytest check — see the ledger.)
ex:saJustificationSplitDomainsRanges a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasAvailableEvidence a owl:ObjectProperty ; rdfs:domain gmeow:JustificationSubject ; rdfs:range gmeow:JustificationGround .
    gmeow:basesBeliefOn a owl:ObjectProperty ; rdfs:domain gmeow:JustificationSubject ; rdfs:range gmeow:JustificationGround .
    gmeow:supportsUnder a owl:ObjectProperty ; rdfs:domain gmeow:JustificationSubject ; rdfs:range gmeow:SupportAssessment .
    gmeow:adequateUnder a owl:ObjectProperty ; rdfs:domain gmeow:JustificationSubject ; rdfs:range gmeow:AdequacyAssessment .
    gmeow:defeatedBy a owl:ObjectProperty ; rdfs:domain gmeow:JustificationSubject ; rdfs:range gmeow:Defeater .
}""" ;
    gmeow:saRationale "The five-way justification split: available-evidence and basing range over gmeow:JustificationGround; support-under-a-standard over gmeow:SupportAssessment; adequacy over gmeow:AdequacyAssessment; defeat (structural) over gmeow:Defeater — all domain gmeow:JustificationSubject. Available-evidence and basing are kept distinct (available != used)." .

ex:saJustificationSplitNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p { gmeow:hasAvailableEvidence gmeow:basesBeliefOn gmeow:supportsUnder gmeow:adequateUnder gmeow:defeatedBy gmeow:hasDefeatStatus }
    ?p a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "The justification and defeat edges are non-functional — several grounds, assessments, defeaters, and status flags coexist (Principle 9)." .

# --- 10. Defeat split: defeatedBy → Defeater, hasDefeatStatus → Status (MUST) --
ex:saDefeatSplitRanges a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:defeatedBy a owl:ObjectProperty ; rdfs:range gmeow:Defeater .
    gmeow:hasDefeatStatus a owl:ObjectProperty ; rdfs:domain gmeow:JustificationSubject ; rdfs:range gmeow:JustificationStatus .
}""" ;
    gmeow:saRationale "The defeat reconcile: the STRUCTURAL defeater gmeow:defeatedBy ranges over gmeow:Defeater (Argument | StandpointClaim | EvidenceSpan), while the solver-set VERDICT flag gmeow:hasDefeatStatus ranges over gmeow:JustificationStatus — distinct facts (what defeats vs the adjudicated outcome)." .

# --- 11. JustificationStatus individuals exist (MUST hold) --------------------
ex:saJustificationStatusIndividuals a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:justificationStatusGettier  a gmeow:JustificationStatus .
    gmeow:justificationStatusDefeated a gmeow:JustificationStatus .
}""" ;
    gmeow:saRationale "The seeded justification-status individuals (Gettier, Defeated) MUST be typed gmeow:JustificationStatus. Mirrors test_justification_status_individuals_exist." .

# --- 12. credence vs confidence are distinct (MUST / MUST-NOT) ----------------
ex:saCredenceDomainDoxasticState a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:credence rdfs:domain gmeow:DoxasticState . }""" ;
    gmeow:saRationale "credence lives on gmeow:DoxasticState (Principle 6). Mirrors the credence-domain clause of test_credence_and_confidence_are_distinct." .

ex:saConfidenceNotConflatedWithCredence a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    { gmeow:confidence rdfs:domain gmeow:DoxasticState . }
    UNION
    { gmeow:credence rdfs:subPropertyOf gmeow:confidence . }
    UNION
    { gmeow:confidence rdfs:subPropertyOf gmeow:credence . }
}""" ;
    gmeow:saRationale "confidence belongs to the statement layer, not the doxastic state: it must NOT carry domain gmeow:DoxasticState in this slice, and neither credence nor confidence subsumes the other (Principle 6). Mirrors the negative clauses of test_credence_and_confidence_are_distinct." .

# --- 13. ClaimToken is a perdurant assertion act (MUST hold) ------------------
ex:saClaimTokenIsPerdurantActivity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:ClaimToken a owl:Class , logic:Event ; rdfs:subClassOf gmeow:Activity .
}""" ;
    gmeow:saRationale "A claim token is 'an event with provenance' (the foundation): gmeow:ClaimToken MUST be an owl:Class stereotyped logic:Event and rdfs:subClassOf gmeow:Activity — a perdurant, NOT a relator alias of gmeow:StandpointClaim." .

# --- 14. expresses: ClaimToken → Proposition (the content axis, MUST hold) ----
ex:saExpressesContentAxis a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:expresses a owl:ObjectProperty ;
        rdfs:domain gmeow:ClaimToken ;
        rdfs:range gmeow:Proposition .
}""" ;
    gmeow:saRationale "gmeow:expresses is the content axis of the claim separation: an owl:ObjectProperty from gmeow:ClaimToken to gmeow:Proposition, keeping the truth-apt content distinct from the assertion act." .

# --- 15. heldByAttitude / groundsClaim are an inverse pair (MUST hold) --------
ex:saAttitudeTokenInversePair a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:heldByAttitude a owl:ObjectProperty ;
        rdfs:domain gmeow:ClaimToken ;
        rdfs:range gmeow:MentalMoment ;
        owl:inverseOf gmeow:groundsClaim .
    gmeow:groundsClaim a owl:ObjectProperty ;
        rdfs:domain gmeow:MentalMoment ;
        rdfs:range gmeow:ClaimToken .
}""" ;
    gmeow:saRationale "The attitude↔token link is an inverse pair over gmeow:MentalMoment: gmeow:heldByAttitude (token→attitude) owl:inverseOf gmeow:groundsClaim (attitude→token), covering both DoxasticState (belief) and teleology IntentionalMode (desire/intent) without re-minting (Principle 6)." .

# --- 16. producesClaim: Event → ClaimToken (MUST hold) -----------------------
ex:saProducesClaimEventToToken a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:producesClaim a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:ClaimToken .
}""" ;
    gmeow:saRationale "gmeow:producesClaim is the event→token link (an observing/speech event may produce several claim tokens): an owl:ObjectProperty from gmeow:Event to gmeow:ClaimToken." .

# --- 17. supports/attacksClaim range ClaimToken (MUST hold) -------------------
ex:saSupportAttackRangeClaimToken a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:supportsClaim a owl:ObjectProperty ; rdfs:range gmeow:ClaimToken .
    gmeow:attacksClaim  a owl:ObjectProperty ; rdfs:range gmeow:ClaimToken .
}""" ;
    gmeow:saRationale "The bipolar-argumentation edges gmeow:supportsClaim / gmeow:attacksClaim MUST be owl:ObjectProperties ranging over gmeow:ClaimToken (the claim-token end is fixed now)." .

# --- 18. supports/attacksClaim have NO domain pre-argumentation (MUST-NOT) ----
ex:saSupportAttackOpenDomain a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?p { gmeow:supportsClaim gmeow:attacksClaim }
    ?p rdfs:domain ?d .
}""" ;
    gmeow:saRationale "The support/attack edges keep an OPEN domain (no rdfs:domain) until the argumentation layer mints gmeow:Argument as the proper domain — the open-domain idiom of gmeow:observedFeature. A premature domain would be the regression this guard forbids." .

# --- 19. ClaimEvaluation ⊑ ClaimToken — a claim about a claim (MUST hold) -----
ex:saClaimEvaluationSubclassOfClaimToken a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:ClaimEvaluation a owl:Class , logic:Event ; rdfs:subClassOf gmeow:ClaimToken .
}""" ;
    gmeow:saRationale "An evaluation is 'a separate claim with its own standpoint and provenance' (the foundation): gmeow:ClaimEvaluation MUST be an owl:Class stereotyped logic:Event and rdfs:subClassOf gmeow:ClaimToken — a claim about a claim, reusing the claim apparatus recursively; the logic:Event pin is symmetric with the ClaimToken guard so the perdurant stereotype cannot regress silently." .

# --- 20. evaluates: ClaimEvaluation → ClaimToken (MUST hold) ------------------
ex:saEvaluatesEvaluationToToken a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:evaluates a owl:ObjectProperty ;
        rdfs:domain gmeow:ClaimEvaluation ;
        rdfs:range gmeow:ClaimToken .
}""" ;
    gmeow:saRationale "gmeow:evaluates binds a gmeow:ClaimEvaluation to the single gmeow:ClaimToken it assesses — the subject of the assessment, distinct from gmeow:expresses (the verdict proposition)." .

# --- 21. ClaimToken is NOT in the Observation spine (the separation, MUST-NOT) -
ex:saClaimTokenNotObservation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:ClaimToken rdfs:subClassOf gmeow:Observation . }""" ;
    gmeow:saRationale "The four-way separation: the canonical claim token is a perdurant assertion act (logic:Event ⊑ gmeow:Activity), NOT an Observation relator. gmeow:ClaimToken MUST NOT be rdfs:subClassOf gmeow:Observation — the legacy gmeow:StandpointClaim ⊑ gmeow:Observation surface is the GENERATED union view, not the canonical record." .

# --- 22. Factored-justification classes carry their stereotypes (MUST hold) ----
ex:saJustificationFactorClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:SupportAssessment  a owl:Class , logic:Kind ; rdfs:subClassOf logic:Relator .
    gmeow:AdequacyAssessment a owl:Class , logic:Kind ; rdfs:subClassOf logic:Relator .
    gmeow:Defeater           a owl:Class , logic:Category ; rdfs:subClassOf owl:Thing .
    gmeow:EpistemicStandard  a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
    gmeow:AdequacyVerdict    a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
    gmeow:standardOrdinary a gmeow:EpistemicStandard . gmeow:standardScientific a gmeow:EpistemicStandard .
    gmeow:adequacyMet a gmeow:AdequacyVerdict . gmeow:adequacyUnmet a gmeow:AdequacyVerdict .
}""" ;
    gmeow:saRationale "The factored-justification machinery MUST mint gmeow:SupportAssessment / gmeow:AdequacyAssessment as logic:Kind reified assessments (subClassOf logic:Relator), gmeow:Defeater as a logic:Category named union, and gmeow:EpistemicStandard / gmeow:AdequacyVerdict as QualityValue vocabularies with their seeded individuals — support-under-a-standard, adequacy, the structural defeater, the named standards, and the adequacy verdicts." .

# --- 23. justificationStatusUndermined seeded (MUST hold) ---------------------
ex:saJustificationStatusUndermined a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:justificationStatusUndermined a gmeow:JustificationStatus .
    gmeow:justificationStatusUndercut a gmeow:JustificationStatus .
    gmeow:justificationStatusRebutted a gmeow:JustificationStatus .
}""" ;
    gmeow:saRationale "The defeat-status vocabulary gains gmeow:justificationStatusUndermined so all three typed-attack kinds (undermine / undercut / rebut) have a defeat-status twin (Principle 9)." .
