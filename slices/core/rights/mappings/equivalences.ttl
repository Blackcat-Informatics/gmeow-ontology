    gmeow:comment "a PREMIS rights restriction"
|} .

# --- W3C Ontology for Media Resources (ma-ont) --- #

gmeow:copyrightNotice skos:closeMatch ma:copyright {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "ma-ont copyright statement"
|} .

gmeow:copyrightHolder skos:relatedMatch ma:isCopyrightedBy {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "ma-ont copyrighted-by"
|} .

gmeow:hasRightsStatement skos:closeMatch ma:hasPolicy {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "ma-ont policy link"
|} .

gmeow:hasPermission skos:relatedMatch ma:hasPermissions {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "ma-ont permissions"
|} .

