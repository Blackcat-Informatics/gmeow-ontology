# Term equivalences for the places domain — GMEOW authoring source.
# Compiled to mappings/gmeow-places.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetPlaces a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/places" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Location alignments for comprehensive geo interop — schema.org, GeoSPARQL, GeoNames, Getty (gvp), Wikidata, WGS84, vCard. placeType/storageMedium are value individuals aligned (closeMatch) to external classes/feature-codes; address components align to schema.org + vCard for lossless round-trip; containedInPlace aligns to the topological \"within\"/parent relations of every geo vocab. StorageLocation/Location/storage* and authorityLink are canonical (no faithful external term). Coreference of place INSTANCES to gazetteer records is done in data with skos:exactMatch + gmeow:authorityLink (Wikidata as hub), not here." .

gmeow:eqPlaces001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:VirtualLocation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:VirtualLocation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-places.sssom.tsv" .

gmeow:eqPlaces002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Geometry ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject geo:Geometry ;
