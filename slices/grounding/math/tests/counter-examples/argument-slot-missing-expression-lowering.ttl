#
# Counter-example for the `math:` expression lowering
# (crates/logic/src/physical/lower.rs, MathLoweringError::ArgumentSlotMissingExpression):
# a math:ApplicationExpression root whose one math:ArgumentSlot names a math:slotIndex
# but no math:slotExpression at all — an operand position with no operand. Wired under
# a real math:ApplicationExpression root (unlike the standalone
# argument-slot-malformed.ttl, which is never reached by the lowering at all), so the
# native lowering actually reaches and rejects it. The authored math:structuralKey lets
# the reasoned-graph gate (check_structural_key_on_rejected_expression) also reach it.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:root a math:ApplicationExpression ;
    math:operator ex:op ;
    math:argumentSlot ex:slot0 ;
    math:structuralKey "not-a-real-digest" .

ex:slot0 a math:ArgumentSlot ;
    math:slotIndex 0 .
