# =========================================================================== #
# Suppression constraint (#1194) — projection of WithdrawnDoxasticTenureSuppressionShape.
# A withdrawn belief (a DoxasticTenure whose gmeow:duringInterval has ended,     #
# i.e. carries gmeow:endedAtTime) that is not suppressed (gmeow:displayable      #
# false) is a Warning — a source may lag the flag.                              #
# =========================================================================== #

gmeow:WithdrawnDoxasticTenureSuppressionConstraint
    a logic:Constraint ;
    rdfs:label "Withdrawn doxastic-tenure suppression constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a withdrawn belief (a gmeow:DoxasticTenure whose gmeow:duringInterval carries a gmeow:endedAtTime) should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)."@x-gmeow-english ;
    logic:formalizes gmeow:DoxasticTenure ;
    logic:severity "Warning" ;
    logic:message "A withdrawn belief (a DoxasticTenure whose interval has ended) should set gmeow:displayable false — suppressed from display, never deleted." ;
    logic:integrity logic:supDxForall .
logic:supDxForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:supDxImpl .
logic:supDxImpl a logic:Formula ; logic:antecedent logic:supDxGuard ; logic:consequent logic:supDxPhi .
logic:supDxGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:DoxasticTenure ] .
logic:supDxPhi a logic:Formula ; logic:not logic:supDxEx .
logic:supDxEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "iv" ] , [ logic:termIndex 1 ; logic:termVariable "end" ] ;
    logic:exists logic:supDxBody .
logic:supDxBody a logic:Formula ; logic:and logic:supDxInterval , logic:supDxEnded , logic:supDxNotSuppressed .
logic:supDxInterval a logic:Formula ; logic:relation gmeow:duringInterval ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "iv" ] .
logic:supDxEnded a logic:Formula ; logic:relation gmeow:endedAtTime ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "iv" ] , [ logic:termIndex 1 ; logic:termVariable "end" ] .
logic:supDxNotSuppressed a logic:Formula ; logic:not logic:supDxDisp .
logic:supDxDisp a logic:Formula ; logic:relation gmeow:displayable ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/AdequacyAssessment> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/adequacyUnderStandard> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/EpistemicStandard> ] .
<https://blackcatinformatics.ca/gmeow/AdequacyAssessment> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/meetsThreshold> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/AdequacyVerdict> ] .
<https://blackcatinformatics.ca/gmeow/ClaimEvaluation> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/evaluates> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/ClaimToken> ] .
<https://blackcatinformatics.ca/gmeow/DoxasticStandpointClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/adequateUnder> ; owl:allValuesFrom <https://blackcatinformatics.ca/gmeow/AdequacyAssessment> ] .
<https://blackcatinformatics.ca/gmeow/DoxasticStandpointClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/basesBeliefOn> ; owl:allValuesFrom <https://blackcatinformatics.ca/gmeow/JustificationGround> ] .
<https://blackcatinformatics.ca/gmeow/DoxasticStandpointClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/claimOfBelief> ; owl:allValuesFrom <https://blackcatinformatics.ca/gmeow/DoxasticState> ] .
<https://blackcatinformatics.ca/gmeow/DoxasticStandpointClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/defeatedBy> ; owl:allValuesFrom <https://blackcatinformatics.ca/gmeow/Defeater> ] .
<https://blackcatinformatics.ca/gmeow/DoxasticStandpointClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/hasAvailableEvidence> ; owl:allValuesFrom <https://blackcatinformatics.ca/gmeow/JustificationGround> ] .
<https://blackcatinformatics.ca/gmeow/DoxasticStandpointClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/hasDefeatStatus> ; owl:allValuesFrom <https://blackcatinformatics.ca/gmeow/JustificationStatus> ] .
<https://blackcatinformatics.ca/gmeow/DoxasticStandpointClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/supportsUnder> ; owl:allValuesFrom <https://blackcatinformatics.ca/gmeow/SupportAssessment> ] .
<https://blackcatinformatics.ca/gmeow/KnowledgeAttribution> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/attributedKnower> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/KnowledgeAttribution> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/attributedProposition> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/Proposition> ] .
<https://blackcatinformatics.ca/gmeow/KnowledgeAttribution> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/attributingAgent> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/KnowledgeClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/knowerAgent> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/KnowledgeClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/knownInWorld> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/EpistemicContext> ] .
<https://blackcatinformatics.ca/gmeow/KnowledgeClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/knownProposition> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/Proposition> ] .
<https://blackcatinformatics.ca/gmeow/KnowledgeClaim> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/underStandard> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/EpistemicStandard> ] .
<https://blackcatinformatics.ca/gmeow/SupportAssessment> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/supportStrength> ; owl:allValuesFrom <http://www.w3.org/2001/XMLSchema#decimal> ] .
<https://blackcatinformatics.ca/gmeow/SupportAssessment> rdfs:subClassOf [ a owl:Restriction ; owl:onProperty <https://blackcatinformatics.ca/gmeow/supportUnderStandard> ; owl:someValuesFrom <https://blackcatinformatics.ca/gmeow/EpistemicStandard> ] .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:adequacyUnderStandardFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "adequacyUnderStandard is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:adequacyUnderStandard is functional: a single reified gmeow:AdequacyAssessment judges its support against exactly one named gmeow:EpistemicStandard, so the assessment fixes one standard as the bar it measures against. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:adequacyUnderStandard ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:adequacyUnderStandard ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:adequacyUnderStandard names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:adequacyUnderStandard, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:adequacyUnderStandard and nothing else. It is not a definition of gmeow:adequacyUnderStandard (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:adequacyUnderStandardFunctionality logic:characterizes gmeow:adequacyUnderStandard ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:attributedKnowerFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "attributedKnower is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:attributedKnower is functional: one gmeow:KnowledgeAttribution credits exactly one agent with the knowing — the single knower it is about, which may equal the attributing agent for self-attribution but is never plural within one attribution."@x-gmeow-english ;
    logic:characterizes gmeow:attributedKnower ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:attributedKnower ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:attributedKnower names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:attributedKnower, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:attributedKnower and nothing else. It is not a definition of gmeow:attributedKnower (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:attributedKnowerFunctionality logic:characterizes gmeow:attributedKnower ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:attributedPropositionFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    rdfs:label "attributedProposition is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:attributedProposition is functional: one gmeow:KnowledgeAttribution is about exactly one proposition attributed as known, so a single non-factive 'takes themselves to know' attribution names one propositional target and entails no truth of it. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:attributedProposition ;
