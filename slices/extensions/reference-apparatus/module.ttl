    logic:formalizes gmeow:blockRendering ;
    logic:message "Every supplied block rendering names its actual content and a form retained as a block surface. Content keeps its own sort; a documentary block is not converted into an expression, statement or proof." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "rendering" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation gmeow:blockRendering ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                    [ logic:termIndex 1 ; logic:termVariable "rendering" ] ] ;
            logic:consequent [ a logic:Formula ;
                logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "content" ], [ logic:termIndex 1 ; logic:termVariable "surface" ] ;
                logic:exists [ a logic:Formula ; logic:and
                    [ a logic:Formula ; logic:relation lang:renderedContent ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "rendering" ],
                            [ logic:termIndex 1 ; logic:termVariable "content" ] ],
                    [ a logic:Formula ; logic:relation lang:renderingForm ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "rendering" ],
                            [ logic:termIndex 1 ; logic:termVariable "surface" ] ],
                    [ a logic:Formula ; logic:relation gmeow:blockSurface ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termVariable "surface" ] ] ] ] ] ] .
