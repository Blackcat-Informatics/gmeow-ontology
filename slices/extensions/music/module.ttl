        gmeow:musicalParameterInstrumentation ,
        gmeow:musicalParameterOrder ,
        gmeow:musicalParameterPerformerCount ,
        gmeow:musicalParameterPitch ,
        gmeow:musicalParameterTacet ,
        gmeow:musicalParameterTempo .

