#
# ABox fixture for the result-lineage competency question "does a terminal result reach
# back to an estimand and forward to a held observation?". A full connected process /
# result / claim chain modelled on the charter's process/result/claim example:
#   process  — ex:analysisRun, a math:InferenceRun (a gmeow:Activity) that fits the data;
#   result   — ex:treatmentEffectEstimate, a math:Estimate naming its math:Estimator and
#              math:Estimand, carrying its value quantity (math:estimateValue), produced
#              by the run (gmeow:wasGeneratedBy);
#   claim    — ex:treatmentEffectObservation, a gmeow:Observation with a gmeow:vantage,
#              reporting the estimate through gmeow:observationResult and generated by the
#              same run (gmeow:wasGeneratedBy).
# The three objects are kept strictly distinct — the run is the process, the estimate is
# the result object, the observation is the held claim — so the lineage query walks BACK
# from the estimate to its estimand and FORWARD to the vantage-held observation. Unioned
# onto the merged ontology by gmeow:cqDataFile.
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/math/> .

# process — the analysis run that fit the data and produced the estimate.
ex:analysisRun a math:InferenceRun , gmeow:Activity ;
    math:fittedToData ex:trialDataset ;
    math:usedAnalysisPlan ex:planV2 .

ex:trialDataset a math:DatasetMatrix .
ex:planV2 a math:AnalysisPlan .

# result object — an estimate linked to its estimand, estimator, value, and producing run.
ex:treatmentEffectEstimate a math:Estimate ;
    math:estimatesEstimand ex:averageTreatmentEffectEstimand ;
    math:estimator ex:olsEstimator ;
    math:estimateValue ex:treatmentEffectQuantity ;
    gmeow:wasGeneratedBy ex:analysisRun .

ex:averageTreatmentEffectEstimand a math:Estimand .
ex:olsEstimator a math:Estimator .

ex:treatmentEffectQuantity a math:Quantity ;
    math:quantityValue "1.42"^^xsd:decimal .

# held claim — the observation reporting the estimate from a vantage, generated by the run.
ex:treatmentEffectObservation a gmeow:Observation ;
    gmeow:vantage ex:analysisPipelineCommitA1B2 ;
    gmeow:observedFeature ex:averageTreatmentEffectEstimand ;
    gmeow:observationResult ex:treatmentEffectEstimate ;
    gmeow:wasGeneratedBy ex:analysisRun .

ex:analysisPipelineCommitA1B2 a gmeow:Standpoint .
<http://example.org/math/treatmentEffectQuantity> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/dimensionless> .
