#
# Declarative competency question for the teleology slice, executed by the native
# Rust slice-test harness (crates/slicetest). Migrated from
# tests/test_teleology.py::test_competency_teleology_modes_query.
#
# The query asks: "What grades of intentional commitment can GMEOW record, and
# how do they divide between intrinsic modes and relators?"

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/teleology/tests/> .

ex:cqTeleologyModes a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/teleology-modes.rq" ;
    gmeow:cqRationale "GMEOW must record the graded intentional-commitment trichotomy: Desire and Intention as subclasses of gmeow:IntentionalMode, and Commitment as a logic:Relator." ;
    gmeow:cqResultShape ex:cqTeleologyModesShape ;
    gmeow:cqExpectRow ex:rowDesire, ex:rowIntention, ex:rowCommitment .

ex:cqTeleologyModesShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "mode" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

ex:rowDesire a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "mode" ; gmeow:cellValueIri gmeow:Desire ] .

ex:rowIntention a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "mode" ; gmeow:cellValueIri gmeow:Intention ] .

ex:rowCommitment a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "mode" ; gmeow:cellValueIri gmeow:Commitment ] .

# --- External dependence: a duty's bearer, beneficiary and founding agreement.
ex:cqDutyParties a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/teleology/queries/competency/duty-parties.rq" ;
    gmeow:cqDataFile "examples/duty-owed.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:shapeDutyParties ;
    gmeow:cqRationale "A duty owed to another party keeps three roles apart: the borrower bears it, the lender is the party it depends on externally, and the loan agreement is what it is founded on." ;
    gmeow:cqExpectRow ex:rowDutyParties .

ex:shapeDutyParties a logic:ResultShape ;
    logic:shapeCardinality logic:RowsExact ;
    logic:declaresColumn [ logic:columnVariable "duty" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ],
        [ logic:columnVariable "bearer" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ],
        [ logic:columnVariable "beneficiary" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ],
        [ logic:columnVariable "agreement" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] .

ex:rowDutyParties a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "duty" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/examples/teleology/duty/returnDuty> ],
        [ a gmeow:ExpectedCell ; gmeow:cellVar "bearer" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/examples/teleology/duty/borrower> ],
        [ a gmeow:ExpectedCell ; gmeow:cellVar "beneficiary" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/examples/teleology/duty/lender> ],
        [ a gmeow:ExpectedCell ; gmeow:cellVar "agreement" ; gmeow:cellValueIri <https://blackcatinformatics.ca/gmeow/examples/teleology/duty/loanAgreement> ] .

ex:cqDutyPartiesNegative a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/teleology/queries/competency/duty-parties-negative.rq" ;
    gmeow:cqDataFile "examples/duty-owed.ttl" ;
    gmeow:cqRationale "Being a party to the founding agreement, or being the agreement itself, does not make the guarantor or the agreement the duty's bearer or beneficiary." ;
    gmeow:cqExpectAsk false .
