#
# Competency (projection-vocabulary ratchet, Principle 17): which per-(slice,
# vocabulary) residue ceilings are committed, and what does each guarded
# vocabulary declare as its default ceiling / logic: subsumer / preservation
# judgment? This reads only the RESIDENT ratchet ABox (gmeow:ceilingCount,
# gmeow:vocabularyDefaultCeiling, gmeow:vocabularySubsumedBy,
# gmeow:vocabularyPreservation) — it does NOT return the live measured residue or
# headroom, because those are empirical scan results entailed by no resident
# individual (computed only by `gmeow-dev slice-quality-projection-debt` /
# `slice-quality-gate`), never a SPARQL-queryable projection.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
SELECT ?slice ?vocab ?ceilingCount ?vocabularyDefaultCeiling ?vocabularySubsumedBy ?vocabularyPreservation WHERE {
    ?ceiling a gmeow:ProjectionCeilingCommitment ;
             gmeow:ceilingSlice ?slice ;
             gmeow:ceilingVocabulary ?vocab ;
             gmeow:ceilingCount ?ceilingCount .
    ?vocab gmeow:vocabularyDefaultCeiling ?vocabularyDefaultCeiling ;
           gmeow:vocabularySubsumedBy ?vocabularySubsumedBy ;
           gmeow:vocabularyPreservation ?vocabularyPreservation .
}
ORDER BY ?slice ?vocab
