# --- 4a. gmeow:gender is NOT a DatatypeProperty (MUST-NOT) ------------------
ex:saNoFlatGenderDatatype a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:gender a owl:DatatypeProperty . }""" ;
    gmeow:saRationale "gmeow:gender MUST NOT exist as a DatatypeProperty — flat-literal gender shortcuts are forbidden (greenfield: the object path via genderValue is the SINGLE path). Mirrors test_no_flat_gender_shortcut (banned: gender)." .

