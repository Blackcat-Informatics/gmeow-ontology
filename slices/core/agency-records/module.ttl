ble "artifact" ], [ logic:termIndex 2 ; logic:termVariable "observer" ], [ logic:termIndex 3 ; logic:termVariable "citation" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:wasDerivedFrom ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "observation" ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementSubject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "citation" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementPredicate ; logic:argument [ logic:termIndex 0 ; logic:termVariable "citation" ], [ logic:termIndex 1 ; logic:termIri gmeow:wasDerivedFrom ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementObject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "citation" ], [ logic:termIndex 1 ; logic:termVariable "observation" ] ], [ a logic:Formula ; logic:relation gmeow:verifierKey ; logic:argument [ logic:termIndex 0 ; logic:termVariable "citation" ], [ logic:termIndex 1 ; logic:termVariable "key" ] ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "observation" ], [ logic:termIndex 1 ; logic:termIri gmeow:ArtifactVerificationObservation ] ], [ a logic:Formula ; logic:relation gmeow:verifierKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "observation" ], [ logic:termIndex 1 ; logic:termIri gmeow:verifierArtifactReadAfterWrite ] ], [ a logic:Formula ; logic:relation gmeow:verifiesArtifact ; logic:argument [ logic:termIndex 0 ; logic:termVariable "observation" ], [ logic:termIndex 1 ; logic:termVariable "artifact" ] ], [ a logic:Formula ; logic:relation gmeow:vantage ; logic:argument [ logic:termIndex 0 ; logic:termVariable "observation" ], [ logic:termIndex 1 ; logic:termVariable "observer" ] ], [ a logic:Formula ; logic:relation gmeow:observationResult ; logic:argument [ logic:termIndex 0 ; logic:termVariable "observation" ], [ logic:termIndex 1 ; logic:termIri gmeow:verdictHeld ] ] ] ] ] ] .

# Runtime trace observation and requested recollection strategies.

gmeow:ModelInvocationState
    a logic:AbstractIndividualType, logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Model Invocation State"@x-gmeow-english ;
    skos:definition "An open vocabulary of lifecycle states reported by observations about an actual model invocation. A state reading is scoped to its source and time; it is independent of the invocation's terminal outcome."@x-gmeow-english ;
    gmeow:useWhen "Use when a runtime record reports the lifecycle condition of a particular invocation as it was observed."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid extending ModelInvocationOutcome with running, treating a missing outcome as running, or assigning a state to the model agent itself."@x-gmeow-english ;
    gmeow:howToUse "Place a state value on an Observation through invocationState and identify the actual call with observedFeature; preserve the observation's source and supplied temporal context."@x-gmeow-english ;
    skos:scopeNote "The vocabulary selects no current or latest state. Earlier running evidence and later terminal-outcome evidence remain separate attributed records."@x-gmeow-english ;
    skos:example "Classify a state value: gmeow:invocationStateRunning a gmeow:ModelInvocationState ."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:invocationState
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "observed invocation state"@x-gmeow-english ;
    skos:definition "The lifecycle state held by an observation about a ModelInvocation, specializing observationResult. The observation's observedFeature identifies the call; this relation does not replace invocationOutcome on the call."@x-gmeow-english ;
    gmeow:useWhen "Use to retain an explicit state reading from a runtime snapshot while keeping the invocation occurrence separate from the observation record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid placing this relation directly on the invocation or model agent, making it globally functional, or overwriting an earlier observation with a later reading."@x-gmeow-english ;
    gmeow:howToUse "Bind observedFeature to the actual ModelInvocation, vantage to the observing standpoint and wasDerivedFrom to the retained source record. Preserve supplied observedAt or recordedAt values without inventing a clock."@x-gmeow-english ;
    skos:scopeNote "State observations are nonfunctional and source-relative. Neither their timestamps nor the absence of an outcome authorizes a global latest-state or success inference."@x-gmeow-english ;
    skos:example "Retain a reading of the call: ex:reading gmeow:invocationState gmeow:invocationStateRunning ; gmeow:observedFeature ex:call ."@x-gmeow-english ;
    logic:domain gmeow:Observation ;
    logic:range gmeow:ModelInvocationState ;
    logic:subPropertyOf gmeow:observationResult .

gmeow:invocationStateRunning
    a gmeow:ModelInvocationState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "invocation running"@x-gmeow-english ;
    skos:definition "The source reports that the observed model invocation was still in progress when that reading was made. It supplies no terminal success or failure outcome."@x-gmeow-english ;
    gmeow:useWhen "Use only for an explicit in-progress report, including a record retained before the call returned."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating silence, a missing error, a queued request or a nonterminal trace event as evidence that a call was running."@x-gmeow-english ;
    gmeow:howToUse "Select this value through invocationState on the actual source observation. Keep any later succeeded or failed invocationOutcome as separate evidence about the same call."@x-gmeow-english ;
    skos:scopeNote "Running is not a permanent assertion about the invocation's entire lifetime. The value neither starts a model nor establishes that execution is currently continuing."@x-gmeow-english ;
    skos:example "Record the reported in-progress state: ex:earlyReading gmeow:invocationState gmeow:invocationStateRunning ."@x-gmeow-english .

gmeow:injectionCategory
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "injection category code"@x-gmeow-english ;
    skos:definition "The exact category code reported by a screen for instructions an outside answer attempted to inject, retained on its attributed observation. The machine literal preserves source whitespace, case and datatype."@x-gmeow-english ;
    gmeow:useWhen "Use when a retained screening report names a category for a particular outside-answer artifact."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid storing the injected instruction text as the code, resolving the code into a universal taxonomy, or asserting that the model or sender is globally malicious."@x-gmeow-english ;
    gmeow:howToUse "Keep the supplied xsd:string or xsd:token literal on an Observation with the actual answer as observedFeature, its vantage and retained screening source. Preserve evidence spans or the reported method when supplied."@x-gmeow-english ;
    skos:scopeNote "Preserve the supplied lexical form and datatype: verbatim xsd:string and explicitly supplied xsd:token are admitted. Do not normalize whitespace, retype a string or infer token typing. These declarations do not install a token lexical checker. This source classification neither executes a screen, proves attack success nor supplies a closed category registry."@x-gmeow-english ;
    skos:example "Retain the screen's exact code: ex:screenReading gmeow:injectionCategory \" role-override  \" ."@x-gmeow-english ;
    logic:domain gmeow:Observation ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:string xsd:token ) ] .

gmeow:InvocationStateEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Invocation state evidence constraint"@x-gmeow-english ;
    skos:definition "An invocation-state reading is an actual Observation of the actual ModelInvocation, with its vantage and retained source record. The reading does not select a global latest state or imply a terminal outcome."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the observational context of each supplied invocation-state value."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing an observer or source time, suppressing earlier readings, or rejecting later outcome evidence merely because a running reading exists."@x-gmeow-english ;
    gmeow:howToUse "Retain the actual invocation feature, observing vantage and source. Carry supplied observation or recording times on their own records without fabricating missing precision."@x-gmeow-english ;
    skos:scopeNote "The law constrains a supplied reading only; it creates neither invocation execution nor a lifecycle state machine."@x-gmeow-english ;
    skos:example "Apply the source law: gmeow:InvocationStateEvidenceConstraint logic:formalizes gmeow:invocationState ."@x-gmeow-english ;
    logic:formalizes gmeow:invocationState ;
    logic:message "An invocation-state reading is an actual Observation of the actual ModelInvocation, with its vantage and retained source record. The reading does not select a global latest state or imply a terminal outcome."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "state" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:invocationState ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "state" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "feature" ], [ logic:termIndex 1 ; logic:termVariable "observer" ], [ logic:termIndex 2 ; logic:termVariable "source" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:Observation ] ], [ a logic:Formula ; logic:relation gmeow:observedFeature ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "feature" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "feature" ], [ logic:termIndex 1 ; logic:termIri gmeow:ModelInvocation ] ], [ a logic:Formula ; logic:relation gmeow:vantage ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "observer" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "observer" ], [ logic:termIndex 1 ; logic:termIri gmeow:Entity ] ], [ a logic:Formula ; logic:relation gmeow:wasDerivedFrom ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "source" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "source" ], [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] ] ] ] ] .

gmeow:InjectionCategoryEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Injection category evidence constraint"@x-gmeow-english ;
    skos:definition "An injection category belongs to an actual Observation of the retained answer artifact, with its vantage and actual screening source. The category alone does not prove an attack or its success."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the actual answer and source context of each supplied screening category."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating an ungrounded category literal as a screening observation or inventing an outside-model identity."@x-gmeow-english ;
    gmeow:howToUse "Retain the actual information-object answer, observing vantage and screening source. Keep any supplied evidence span and method independent of the category code."@x-gmeow-english ;
    skos:scopeNote "The law checks a retained source claim; it neither executes a screen nor authenticates its classification."@x-gmeow-english ;
    skos:example "Apply the source law: gmeow:InjectionCategoryEvidenceConstraint logic:formalizes gmeow:injectionCategory ."@x-gmeow-english ;
    logic:formalizes gmeow:injectionCategory ;
    logic:message "An injection category belongs to an actual Observation of the retained answer artifact, with its vantage and actual screening source. The category alone does not prove an attack or its success."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "code" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:injectionCategory ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "code" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "feature" ], [ logic:termIndex 1 ; logic:termVariable "observer" ], [ logic:termIndex 2 ; logic:termVariable "source" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:Observation ] ], [ a logic:Formula ; logic:relation gmeow:observedFeature ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "feature" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "feature" ], [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ], [ a logic:Formula ; logic:relation gmeow:vantage ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "observer" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "observer" ], [ logic:termIndex 1 ; logic:termIri gmeow:Entity ] ], [ a logic:Formula ; logic:relation gmeow:wasDerivedFrom ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "source" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "source" ], [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] ] ] ] ] .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/invocationState" ; logic:closureValue logic:ClosedWorldClosure ] .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/injectionCategory" ; logic:closureValue logic:ClosedWorldClosure ] .

# Source-reported runtime trace kinds; classification does not execute the mechanism.

gmeow:eventTypeTraceRound
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "thinking trace round"@x-gmeow-english ;
    skos:definition "One runtime-reported round in a cycle of thinking, independently of how many model or tool calls it contains."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicit round occurrence, including a round with no model request."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid identifying the round with a response turn, a model invocation or a token allocation."@x-gmeow-english ;
    gmeow:howToUse "Attach through eventType and retain the actual containing episode with subEventOf when supplied."@x-gmeow-english ;
    skos:scopeNote "Round membership and order remain source facts; no cycle counter or scheduler is executed."@x-gmeow-english ;
    skos:example "Classify this thinking trace round: ex:round gmeow:eventType gmeow:eventTypeTraceRound ."@x-gmeow-english .


gmeow:eventTypeTraceTurnStart
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "thinking trace turn start"@x-gmeow-english ;
    skos:definition "The source reports the beginning of one thinking turn."@x-gmeow-english ;
    gmeow:useWhen "Use for a recorded start boundary before that turn's output is known."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring a model request, a completed turn or a delivered chat reply from the start."@x-gmeow-english ;
    gmeow:howToUse "Classify the start occurrence and retain its actual turn or episode parent separately."@x-gmeow-english ;
    skos:scopeNote "A start marker neither opens a fabricated invocation nor predicts an output."@x-gmeow-english ;
    skos:example "Classify this thinking trace turn start: ex:turnStart gmeow:eventType gmeow:eventTypeTraceTurnStart ."@x-gmeow-english .


gmeow:eventTypeTraceTurnOutput
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "thinking trace turn output"@x-gmeow-english ;
    skos:definition "The source reports that a thinking turn produced its output."@x-gmeow-english ;
    gmeow:useWhen "Use for the output-producing occurrence even when later delivery or validation is unknown."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid making the output artifact an Event or treating produced output as an accepted response."@x-gmeow-english ;
    gmeow:howToUse "Keep the occurrence distinct from its actual output artifact and link genuine production with wasGeneratedBy when known."@x-gmeow-english ;
    skos:scopeNote "Output production does not establish artifact completeness, truth or dispatch."@x-gmeow-english ;
    skos:example "Classify this thinking trace turn output: ex:turnOutput gmeow:eventType gmeow:eventTypeTraceTurnOutput ."@x-gmeow-english .


gmeow:eventTypeTraceModelRequest
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "model request trace"@x-gmeow-english ;
    skos:definition "The runtime reports that it sent a request to a model."@x-gmeow-english ;
    gmeow:useWhen "Use for the actual request-send occurrence rather than a planned request."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring receipt, model execution or a successful invocation from sending alone."@x-gmeow-english ;
    gmeow:howToUse "Retain actual invocation and prompt identities when supplied; hasPrompt belongs to the real ModelInvocation."@x-gmeow-english ;
    skos:scopeNote "The trace kind does not satisfy the ModelInvocation contract by itself."@x-gmeow-english ;
    skos:example "Classify this model request trace: ex:modelRequest gmeow:eventType gmeow:eventTypeTraceModelRequest ."@x-gmeow-english .


gmeow:eventTypeTraceModelResponse
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "model response trace"@x-gmeow-english ;
    skos:definition "The source reports that a model responded to a request."@x-gmeow-english ;
    gmeow:useWhen "Use for response arrival, retaining a partial or refused answer when that is what arrived."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid equating a response with semantic correctness, accepted completion or a delivered user message."@x-gmeow-english ;
    gmeow:howToUse "Keep the response occurrence separate from retained answer content and the actual invocation."@x-gmeow-english ;
    skos:scopeNote "A response event does not choose an invocationOutcome value."@x-gmeow-english ;
    skos:example "Classify this model response trace: ex:modelResponse gmeow:eventType gmeow:eventTypeTraceModelResponse ."@x-gmeow-english .


gmeow:eventTypeTraceModelError
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "model error trace"@x-gmeow-english ;
    skos:definition "The runtime reports that a model returned an error."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicit provider error report, preserving whether it was terminal or retried separately."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid converting every error report into a failed terminal outcome or an incomplete artifact."@x-gmeow-english ;
    gmeow:howToUse "Retain the reported error source; use invocationError only on an actual ModelInvocation when that binding is known."@x-gmeow-english ;
    skos:scopeNote "Error text, lifecycle state and terminal outcome remain independent axes."@x-gmeow-english ;
    skos:example "Classify this model error trace: ex:modelError gmeow:eventType gmeow:eventTypeTraceModelError ."@x-gmeow-english .


gmeow:eventTypeTraceGeneration
