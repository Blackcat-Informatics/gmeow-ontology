# ROBOT verify QC (#39) — orthogonality matrix integrity (CONSTITUTION P9).
# Each of the seven orthogonal identity axes MUST be a member of the canonical
# logic:AllDisjointClasses set, so the reasoner can reject an individual placed
# in two of them. OWL is the generated target view; this verification query
# authenticates the authored logic: carrier. If any axis is missing from the
# disjointness matrix, this returns a row → FAILURE.

PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>

SELECT ?axis WHERE {
    VALUES ?axis {
        gmeow:GenderIdentity
        gmeow:GenderExpression
        gmeow:SexAssignedAtBirth
        gmeow:SexualOrientation
        gmeow:RomanticOrientation
        gmeow:PronounSet
        gmeow:Honorific
    }
    FILTER NOT EXISTS {
        ?disjoint a logic:AllDisjointClasses ;
                  logic:members/rdf:rest*/rdf:first ?axis .
    }
}
