logic:argument [ logic:termIndex 0 ; logic:termVariable "answer" ], [ logic:termIndex 1 ; logic:termVariable "input" ] ] ] ] .

gmeow:QueryRerankCandidateAccountingLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank candidate accounting law"@x-gmeow-english ;
    skos:definition "A rerank answer retains exactly its original union’s candidate identities and an outcome occurrence for each. Every entry names an original candidate; no original candidate is omitted and no foreign candidate is added."@x-gmeow-english ;
    gmeow:useWhen "Use to check complete candidate accounting across original membership, output membership and entry occurrences."@x-gmeow-english ;
