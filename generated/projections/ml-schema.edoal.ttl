@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mls: <http://www.w3.org/ns/mls#> .

<https://blackcatinformatics.ca/gmeow/projections/ml-schema>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:ModelArtifact ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri mls:Model ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.7"^^xsd:double ;
        rdfs:label "ModelArtifact → mls:Model (lossy)"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:ModelDeployment ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri mls:Implementation ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.5"^^xsd:double ;
            rdfs:label "ModelDeployment → mls:Implementation (lossy)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:RuntimeExecution ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri mls:Run ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.55"^^xsd:double ;
            rdfs:label "RuntimeExecution → mls:Run (lossy)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:executionOfDeployment ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri mls:executes ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.5"^^xsd:double ;
            rdfs:label "executionOfDeployment → mls:executes (lossy)"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "ml-schema" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → ml-schema (EDOAL)"@en .
