#
# Counter-example for math:MetricSignatureDimensionShape: a four-dimensional
# manifold declares math:lorentzianStructure and signature (3, 2), whose sum is 5.
# These values disagree with the manifold dimension and with the Lorentzian
# requirement p = 1 or q = 1. This fixture is not an isolated sum-check probe.
# Validation MUST emit shacl.SPARQLConstraintComponent (math:DimensionMismatch).
# Bound by ex:ecMetricSignatureDimensionMismatch.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:badSpacetime a math:SmoothManifold ;
    rdfs:label "over-counted 4-manifold"@x-gmeow-english ;
    math:manifoldDimension "4"^^xsd:integer ;
    math:manifoldStructureKind math:lorentzianStructure ;
    math:metricTensor ex:badMetric .

ex:badMetric a math:MetricTensor ;
    rdfs:label "over-counted metric tensor"@x-gmeow-english ;
    math:metricSignature ex:badSignature .

ex:badSignature a math:MetricSignature ;
    rdfs:label "over-counted signature (3, 2)"@x-gmeow-english ;
    math:signaturePositive "3"^^xsd:integer ;
    math:signatureNegative "2"^^xsd:integer .
