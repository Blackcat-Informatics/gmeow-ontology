# --- 13. hasEvidenceClass: ObjectProperty, correct domain/range (MUST) -------
ex:saHasEvidenceClassProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasEvidenceClass a owl:ObjectProperty ;
        rdfs:domain gmeow:CitationAct ;
        rdfs:range gmeow:EvidenceClass .
}""" ;
    gmeow:saRationale "gmeow:hasEvidenceClass MUST be an owl:ObjectProperty with domain gmeow:CitationAct and range gmeow:EvidenceClass. Mirrors test_has_evidence_class_is_non_functional (positive part)." .

# --- 14. hasEvidenceClass is NOT functional (MUST-NOT) ------------------------
ex:saHasEvidenceClassNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasEvidenceClass a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:hasEvidenceClass MUST NOT be owl:FunctionalProperty -- competing evidence classifications coexist (Principle 9). Mirrors test_has_evidence_class_is_non_functional (mustNot-functional part)." .

