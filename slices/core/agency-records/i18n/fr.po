msgstr "ex:record gmeow:bodyCause \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/nextAction|http://www.w3.org/2000/01/rdf-schema#label"
msgid "next action"
msgstr "action suivante"

msgctxt "https://blackcatinformatics.ca/gmeow/nextAction|http://www.w3.org/2004/02/skos/core#definition"
msgid "The proposed next action recorded verbatim on an attempt finish. A proposal is neither an executed event nor an adopted intention."
msgstr "Action suivante proposée, conservée textuellement à la fin d’une tentative. Une proposition n’est ni un événement exécuté ni une intention adoptée."

msgctxt "https://blackcatinformatics.ca/gmeow/nextAction|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

