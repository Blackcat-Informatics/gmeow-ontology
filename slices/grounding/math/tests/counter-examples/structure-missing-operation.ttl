#
# Counter-example for math:AlgebraicStructureShape: a math:Group that declares its carrier
# and an axiom but omits its math:structureOperation (sh:minCount 1), so validation MUST emit
# shacl.MinCountConstraintComponent (and no other finding).
# Bound by tests/example-conformance.ttl (ex:ecStructureMissingOperation).
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:operationlessGroup a math:Group ;
    math:underlyingSet ex:carrier ;
    math:satisfiesAxiom ex:associativityAxiom .

ex:carrier a math:Set .
