# modelRevision is single-valued: two distinct pinned revisions is a hard fail.
gmeow:ModelInferenceRunRevisionUniqueConstraint
    a logic:Constraint ;
    rdfs:label "ModelInferenceRun revision-unique constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:ModelInferenceRun pins at most one gmeow:modelRevision."@x-gmeow-english ;
    logic:formalizes gmeow:ModelInferenceRun , gmeow:ModelInferenceRunShape ;
    logic:message "A ModelInferenceRun must declare exactly one pinned gmeow:modelRevision — a model name without a single pinned revision fails reproducibility (a hard fail)." ;
    logic:integrity logic:mruForall .
logic:mruForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] , [ logic:termIndex 2 ; logic:termVariable "b" ] ;
    logic:forall logic:mruImpl .
logic:mruImpl a logic:Formula ; logic:antecedent logic:mruGuard ; logic:consequent logic:mruEq .
logic:mruGuard a logic:Formula ; logic:and logic:mruType , logic:mruA , logic:mruB .
logic:mruType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ModelInferenceRun ] .
logic:mruA a logic:Formula ; logic:relation gmeow:modelRevision ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .
logic:mruB a logic:Formula ; logic:relation gmeow:modelRevision ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .
logic:mruEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .

# A derived intensity's weighting policy must be a machine-readable IRI, never a free-text string.
gmeow:DerivedAffectIntensityWeightingIriConstraint
    a logic:Constraint ;
    rdfs:label "Derived affect intensity weighting-IRI constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:DerivedAffectIntensityObservation declares its gmeow:weightingPolicy as an IRI-valued gmeow:WeightingPolicy."@x-gmeow-english ;
    logic:formalizes gmeow:DerivedAffectIntensityObservation , gmeow:DerivedAffectIntensityObservationShape ;
    logic:message "A derived affect intensity must declare its gmeow:weightingPolicy — the basis is non-orthogonal, so the weighting is an explicit, machine-readable gmeow:WeightingPolicy IRI, never assumed and never a free-text string." ;
    logic:integrity logic:dwpForall .
logic:dwpForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:dwpImpl .
logic:dwpImpl a logic:Formula ; logic:antecedent logic:dwpGuard ; logic:consequent logic:dwpExists .
logic:dwpGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:DerivedAffectIntensityObservation ] .
logic:dwpExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "w" ] ;
    logic:exists logic:dwpBody .
logic:dwpBody a logic:Formula ; logic:and logic:dwpAtom , logic:dwpIri .
logic:dwpAtom a logic:Formula ; logic:relation gmeow:weightingPolicy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "w" ] .
logic:dwpIri a logic:Formula ; logic:relation logic:termIsIri ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "w" ] .

# A derived intensity must NOT carry a stored magnitude (the norm is a recomputable derived view).
