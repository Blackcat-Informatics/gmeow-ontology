@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://blackcatinformatics.ca/gmeow/projections/doap> a align:Alignment ;
    rdfs:label "GMEOW → doap (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "projectLicense → doap:license"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:projectLicense ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri doap:license ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "SoftwareProject → doap:Project (facet collapse)"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:SoftwareProject ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri doap:Project ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "hasRepository → doap:repository"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasRepository ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri doap:repository ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "Repository → doap:Repository"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Repository ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri doap:Repository ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "releaseVersion → doap:revision"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:releaseVersion ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri doap:revision ] ;
            align:relation "=" ],
        [ a align:Cell ;
            rdfs:label "Release → doap:Version (event conflation)"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Release ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri doap:Version ] ;
            align:relation "<=" ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "doap" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
