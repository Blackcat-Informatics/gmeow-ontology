gmeow:CueEvalMatchAgreementConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "case and match agreement"@x-gmeow-english ;
    skos:definition "Every match associated with a case names the case's cue and carries the same complete RDF literal as its evalText."@x-gmeow-english ;
    gmeow:useWhen "Use to check case and match agreement on the retained CueEvalCase record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a satisfied record law as executed detection, correct suppression, authenticated source text or external inventory completeness."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the supplied record and retain source evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "Shared-variable graph joins preserve literal identity without stripping datatype, language or direction. No equality between matchRecord and the case is required."@x-gmeow-english ;
    skos:example "gmeow:CueEvalMatchAgreementConstraint logic:formalizes gmeow:evalMatch . names the supplied-record law."@x-gmeow-english ;
    logic:formalizes gmeow:evalMatch ;
    logic:message "Every match associated with a case names the case's cue and carries the same complete RDF literal as its evalText." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CueEvalCase ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "match" ], [ logic:termIndex 1 ; logic:termVariable "cue" ], [ logic:termIndex 2 ; logic:termVariable "text" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:evalMatch ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "match" ] ], [ a logic:Formula ; logic:relation gmeow:evalCue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "cue" ] ], [ a logic:Formula ; logic:relation gmeow:evalText ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "text" ] ] ] ; logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:matchedCue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "match" ], [ logic:termIndex 1 ; logic:termVariable "cue" ] ], [ a logic:Formula ; logic:relation gmeow:matchSourceLiteral ; logic:argument [ logic:termIndex 0 ; logic:termVariable "match" ], [ logic:termIndex 1 ; logic:termVariable "text" ] ] ] ] ] ] ] .

gmeow:CueJudgementBranchConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "exclusive judgement target branch"@x-gmeow-english ;
    skos:definition "A CueJudgement selects either a reported match with no judgement offsets, or a case with both missed-span offsets and no judgedMatch. Every supplied observedFeature target must be that same selected judgedMatch or judgedCase target."@x-gmeow-english ;
    gmeow:useWhen "Use to check exclusive judgement target branch on the retained CueJudgement record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a satisfied record law as executed detection, correct suppression, authenticated source text or external inventory completeness."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the supplied record and retain source evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "The branch is a supplied-record contract. It does not certify that a reported occurrence is correct or that a claimed missed occurrence was absent from an external inventory. Shared-variable target membership excludes unrelated observed subjects without requiring a duplicate observedFeature assertion."@x-gmeow-english ;
    skos:example "gmeow:CueJudgementBranchConstraint logic:formalizes gmeow:CueJudgement . names the supplied-record law."@x-gmeow-english ;
    logic:formalizes gmeow:CueJudgement ;
    logic:message "A CueJudgement selects either a reported match with no judgement offsets, or a case with both missed-span offsets and no judgedMatch. Every supplied observedFeature target must be that same selected judgedMatch or judgedCase target." ;
