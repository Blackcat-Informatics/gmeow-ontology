                        logic:relation rdf:type ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryAppliedFusionScore ] ],
                    [ a logic:Formula ;
                        logic:relation gmeow:weightedScoreContribution ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "b53_d" ] ] ] ;
                logic:consequent [ a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "b53_e_t" ], [ logic:termIndex 1 ; logic:termVariable "b53_e_i" ] ;
                    logic:exists [ a logic:Formula ;
                        logic:and [ a logic:Formula ;
                            logic:relation rdf:type ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryAppliedFusionScore ] ],
                        [ a logic:Formula ;
                            logic:relation gmeow:weightedScoreFoldStep ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "b53_e_t" ] ],
                        [ a logic:Formula ;
                            logic:relation gmeow:entryOrdinal ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "b53_e_t" ], [ logic:termIndex 1 ; logic:termVariable "b53_e_i" ] ],
                        [ a logic:Formula ;
                            logic:relation logic:termGreater ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "b53_e_i" ], [ logic:termIndex 1 ; logic:termLiteral "0"^^xsd:nonNegativeInteger ] ],
                        [ a logic:Formula ;
                            logic:relation gmeow:weightedStepContribution ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "b53_e_t" ], [ logic:termIndex 1 ; logic:termVariable "b53_d" ] ] ] ] ],
            [ a logic:Formula ;
                logic:antecedent [ a logic:Formula ;
                    logic:and [ a logic:Formula ;
                        logic:relation rdf:type ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryAppliedFusionScore ] ],
                    [ a logic:Formula ;
                        logic:relation gmeow:weightedScoreFoldStep ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "b54_t" ] ],
                    [ a logic:Formula ;
                        logic:relation gmeow:weightedStepContribution ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "b54_t" ], [ logic:termIndex 1 ; logic:termVariable "b54_d" ] ] ] ;
                logic:consequent [ a logic:Formula ;
                    logic:relation gmeow:weightedScoreContribution ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "b54_d" ] ] ],
            [ a logic:Formula ;
                logic:antecedent [ a logic:Formula ;
                    logic:and [ a logic:Formula ;
                        logic:relation rdf:type ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryAppliedFusionScore ] ],
                    [ a logic:Formula ;
                        logic:relation gmeow:weightedScoreFoldStep ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "b55_t" ] ],
