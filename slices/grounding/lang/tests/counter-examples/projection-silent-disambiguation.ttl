# Counter-example: a per-reading lang:ProjectionEmission (CoNLL-U) over a lang:ComposedForm
# holding TWO co-resident lang:Reading objects, but declaring lang:emittedReadingCount 1 —
# it collapsed the two readings to a silently-chosen winner at the projection seam (fires
# lang:ProjectionSilentDisambiguation). The emission is logic:ExactPreservation, so the
# lossy-emission gates (undeclared / unrecorded-epistemic-loss) do not apply.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

ex:formAmbiguous a lang:ComposedForm .

ex:readingBird a lang:Reading ; lang:readingOf ex:formAmbiguous .
ex:readingCrouch a lang:Reading ; lang:readingOf ex:formAmbiguous .

ex:emConllu a lang:ProjectionEmission ;
    lang:projectionTargetName "CoNLL-U" ;
    lang:projectsSource ex:formAmbiguous ;
    logic:preservationKind logic:ExactPreservation ;
    lang:emittedReadingCount 1 .
