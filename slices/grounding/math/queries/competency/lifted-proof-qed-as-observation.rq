# Competency (executable lift): "Whose QED is this — which activity produced the formal
# verification result, and from what vantage is it held?" — asked of the OUTPUT OF THE REAL
# LIFTER, not of a hand-authored example graph.
#
# The producer-namespace twin of bridge-results-as-observations.rq. That query interrogates
# the prose-authored tests/fixtures/bridges.ttl scene; this one interrogates
# tests/fixtures/lifted-proof.ttl — the byte-exact output of
# gmeow_math::producers::proof_lift over crates/math-lift/fixtures/theorem-subclass.tstp.
#
# The process / result / claim separation must survive the lift: the checker's verdict is
# NOT asserted as a bare truth bit but held as a gmeow:Observation whose
# gmeow:observationResult is a math:FormalVerificationResult, generated by the ingest
# activity and held from the checker's gmeow:vantage. That the executable lifter emits the
# separation — rather than an author remembering to — is what this question tests.
PREFIX math:  <https://blackcatinformatics.ca/math/>
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>

SELECT ?activity ?result ?vantage WHERE {
    ?obs a gmeow:Observation ;
         gmeow:observationResult ?result ;
         gmeow:vantage ?vantage ;
         gmeow:wasGeneratedBy ?activity .
    ?result a math:FormalVerificationResult .
    ?activity a math:ProofIngestRun .
    FILTER(STRSTARTS(STR(?activity), "https://blackcatinformatics.ca/gmeow/examples/math/producers/"))
}
ORDER BY ?activity ?result
