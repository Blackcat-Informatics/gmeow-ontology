{
  "$defs": {
    "entailment": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "type": "string"
        },
        "premises": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule": {
          "type": "string"
        }
      },
      "required": [
        "rule",
        "conclusion",
        "premises"
      ],
      "type": "object"
    },
    "finding": {
      "additionalProperties": false,
      "properties": {
        "anchor_iri": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "type": "string"
        },
        "counter_example": {
          "anyOf": [
            {
              "$ref": "#/$defs/fixture"
            },
            {
              "type": "null"
            }
          ]
        },
        "entails": {
          "items": {
            "$ref": "#/$defs/entailment"
          },
          "type": "array"
        },
        "finding_iri": {
          "type": [
            "string",
            "null"
          ]
        },
        "help_uri": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "wellformed_exemplar": {
          "anyOf": [
            {
              "$ref": "#/$defs/fixture"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "help_uri",
        "counter_example",
        "wellformed_exemplar",
        "entails",
        "finding_iri",
        "anchor_iri"
      ],
      "type": "object"
    },
    "fixture": {
      "additionalProperties": false,
      "properties": {
        "expected_outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "violation_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title",
        "text",
        "expected_outcome",
        "violation_code",
        "rationale"
      ],
      "type": "object"
    }
  },
  "$id": "https://blackcatinformatics.ca/gmeow/schemas/validate-finding.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The teaching envelope `validate_local` returns: each finding corresponded to the bundle's own counter-example, exemplar, help URI, and entailments.",
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/finding"
      },
      "type": "array"
    },
    "ok": {
      "type": "boolean"
    },
    "tool": {
      "type": "string"
    }
  },
  "required": [
    "ok",
    "tool",
    "findings"
  ],
  "title": "GMEOW enriched validation report",
  "type": "object"
}
