#
# A conformant serving fixture — the model-serving happy path. One served
# gmeow:ModelArtifact, documented by a gmeow:ModelCard through the SPLIT relations
# (gmeow:describesModelArtifact for artifact facts, gmeow:describesModelService
# for deployment facts). The deployment binds the artifact, the acting service
# gmeow:SoftwareAgent, a host, and an endpoint. Its serving MODE rides a
# gmeow:AwarenessTenure whose gmeow:awarenessSubject is the deployment's SERVICE
# AGENT (never the deployment relator or the execution event, because
# gmeow:awarenessSubject ranges over gmeow:Agent). A runtime execution runs the
# deployment; a session aggregates an invocation, and an episode is a sub-event of
# the session (gmeow:eventTypeAgentEpisode). Every gmeow:TimeInterval carries a
# gmeow:hasTemporalFrame (Principle 11).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/model-serving/> .

# --- Artifact + its card (the ModelCard split) --------------------------------
ex:opusArtifact a gmeow:ModelArtifact .
ex:opusCard a gmeow:ModelCard ;
    gmeow:describesModelArtifact ex:opusArtifact ;
    gmeow:describesModelService ex:opusDeployment .

# --- Deployment: artifact + service agent + host + endpoint -------------------
ex:opusDeployment a gmeow:ModelDeployment ;
    gmeow:deploymentArtifact ex:opusArtifact ;
    gmeow:deploymentService ex:opusServiceAgent ;
    gmeow:deploymentHost ex:usEast1 ;
    gmeow:deploymentEndpoint ex:opusEndpoint .
ex:opusServiceAgent a gmeow:SoftwareAgent .
ex:usEast1 a gmeow:Entity .

# --- Serving mode: an awareness facet ON THE SERVICE AGENT --------------------
ex:opusServing a gmeow:AwarenessTenure ;
    gmeow:awarenessSubject ex:opusServiceAgent ;
    gmeow:awarenessMode gmeow:modeOnlineInference ;
    gmeow:duringInterval ex:servingWindow .
ex:servingWindow a gmeow:TimeInterval ;
    gmeow:startedAtTime "2026-07-01T00:00:00Z"^^xsd:dateTime ;
    gmeow:hasTemporalFrame gmeow:temporalFrameUTCGregorian .

# --- Execution + session + invocation + episode ------------------------------
ex:opusExecution a gmeow:RuntimeExecution ;
    gmeow:executionOfDeployment ex:opusDeployment .
ex:session1 a gmeow:AgentSession .
ex:invocation1 a gmeow:ModelInvocation ;
    gmeow:invocationInExecution ex:opusExecution ;
    gmeow:subEventOf ex:session1 .
ex:episode1 a gmeow:Activity ;
    gmeow:eventType gmeow:eventTypeAgentEpisode ;
    gmeow:subEventOf ex:session1 .
