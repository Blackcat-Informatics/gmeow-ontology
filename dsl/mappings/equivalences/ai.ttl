@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix mls:    <http://www.w3.org/ns/mls#> .
@prefix schema: <https://schema.org/> .
@prefix oa:     <http://www.w3.org/ns/oa#> .
@prefix cito:   <http://purl.org/spar/cito/> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix np:     <http://www.nanopub.org/nschema#> .
@prefix wd:     <http://www.wikidata.org/entity/> .

# Term equivalences for the AI claim layer (#54) — GMEOW authoring source.
# Maximal bridging BY REFERENCE (Principle 5): the literature's own verdict —
# a combined claim-provenance schema is "an emerging intersection, not an
# established specification" — is why most cells are closeMatch/relatedMatch:
# each external vocabulary owns one slice of the picture. All QIDs were
# curl-validated against the Wikidata API on 2026-06-12.

gmeow:mapsetAi a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/ai" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """AI claim-layer alignments (#54).
        THE CLAIM PATTERN: the generated claim is the EXISTING gmeow:StandpointClaim (unified observation stance, P9) — its external bridges (schema:Claim, CRMinf I2 Belief, nanopublication assertion) are cellled here because the AI layer is why they matter, with the subject term owned by the standpoint slice.
        PROV-O: ModelInvocation/RetrievalEvent are prov:Activity by inheritance through gmeow:Activity (already aligned in the provenance set) — only the AI-specific seams are added here.
        ML-Schema: mls:Run is the W3C member-submission counterpart of a model invocation; mls:Model the trained-model artifact a ModelCard describes.
        Web Annotation: a groundedIn evidence span is near-isomorphic to an oa:Annotation (body = claim node, target = chunk with position selector); the generated projection carries it (P4).
        CiTO: supportPolarity's supports/refutes mirror cito:supports/cito:disputes at the citation-act level — relatedMatch (different carrier: span-to-claim stance vs work-to-work intent).""" ;
    gmeow:setTrailer "# REFUSED (Principles 5/9 — verdict semantics): schema:ClaimReview. Its single reviewRating adjudicates a winner; GMEOW contradictions coexist standpoint-indexed, surfaced by gmeow:Contradiction and never resolved by rank.\n# REFUSED (Principle 5 — scope mismatch): C2PA Content Credentials sign MEDIA provenance at the container level, not statement-level claims; the attestation slice owns that seam.\n# REFUSED (Principle 5 — no RDF vocabulary): Model Cards (the Mitchell et al. practice) and FAIR4ML have no stable RDF namespace to cell against; mls:Model is the nearest stable term and is cellled. Revisit when a W3C/community namespace stabilizes.\n# REFUSED (Principle 15 — instance data, not TBox): RAGAS/ARES/AIS/RAGTruth metric vocabularies land as Criterion individuals in the #298 published rubric, not as term alignments." .

# --- The claim pattern (subjects owned by the standpoint slice; bridged here).

gmeow:eqAi001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:StandpointClaim ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:Claim ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "schema:Claim is the fact-check-markup claim; a StandpointClaim carries vantage/modality/confidence the schema.org term lacks — the projection emits text + appearance and NO reviewRating" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:StandpointClaim ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject crminf:I2_Belief ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "CRMinf's belief (a proposition held by an agent) is the heritage-argumentation cousin of the standpoint-indexed claim; CRMinf adds inference-making machinery GMEOW keeps in the solver layer" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:StandpointClaim ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject np:Assertion ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "a nanopublication's assertion graph plays the claim-content role; nanopubs package assertion+provenance+pubinfo as named graphs where GMEOW uses RDF 1.2 statement annotations" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:StandpointClaim ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q2684591 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata 'statement' — that which a true-or-false sentence asserts; curl-validated 2026-06-12" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

# --- Invocation, prompt, model identity.

gmeow:eqAi005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ModelInvocation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject mls:Run ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "ML-Schema's Run is the executed model task; GMEOW's invocation adds prompt + sampling provenance" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ModelCard ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject mls:Model ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "mls:Model is the trained artifact itself; the ModelCard is the description OF one — the nearest stable RDF term (Model Cards proper have no RDF namespace; see trailer)" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Prompt ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject prov:Entity ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "a prompt is a prov:Entity used by the invocation activity; PROV-O has nothing finer" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi008 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Prompt ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q108941486 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "Wikidata 'prompt engineering' — the practice around the artifact (no artifact-level QID exists); curl-validated 2026-06-12" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

# --- Evidence seam.

gmeow:eqAi009 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:groundedIn ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject oa:hasTarget ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "in the Web Annotation projection the claim is the annotation body and the evidence span its target; directions differ, hence relatedMatch" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi010 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:spanStart ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject oa:start ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "oa:TextPositionSelector's start — same unicode code-point semantics" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi011 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:spanEnd ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject oa:end ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "oa:TextPositionSelector's end — same exclusive-end semantics" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi012 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:polaritySupports ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject cito:supports ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "CiTO's supports is a work-to-work citation intent; GMEOW's polarity is a span-to-claim stance — same epistemics, different carrier" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi013 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:polarityRefutes ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject cito:disputes ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "CiTO's disputes, at the span-to-claim level" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

# --- Contradiction and chunking.

gmeow:eqAi014 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Contradiction ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q363948 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Wikidata 'logical contradiction' — GMEOW's individual is the SURFACED conflict artifact, attributed and kind-classified; curl-validated 2026-06-12" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi015 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Chunk ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject oa:TextPositionSelector ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "a chunk IS located the way a position selector locates (start/end into a source); the selector is the locator, the chunk the located segment — relatedMatch, not equivalence" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

# --- Declarations for the projection executor (projection_spec_drift):
# every emitted target property is declared here or in EDOAL.

gmeow:eqAi016 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:groundedIn ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject schema:appearance ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "the schema-org projection composes claim→span→chunk→source into schema:appearance (the claim appears in that work); the term-level relation is loose, the composed path faithful" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .

gmeow:eqAi017 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:modelVersionTag ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:softwareVersion ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the provider's wire-level version tag, on the described agent in the projection" ;
    gmeow:sssomFile "gmeow-ai.sssom.tsv" .
