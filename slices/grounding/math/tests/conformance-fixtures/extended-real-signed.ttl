#
# Well-formed: signed-extended-real slots on the extended real line ℝ̄.
# They cover each named infinity pole, a finite negative real and zero. These objects of
# math:extendedRealValue conform to the logic: gate
# math:ExtendedRealValueConstraint. Bound by ex:ecExtendedRealSigned.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/math/> .

# An unbounded-below limit declared with the negative pole — no finite literal needed.
ex:divergingDownward math:extendedRealValue math:NegativeInfinity .

# A finite negative real in the same signed-extended-real slot.
ex:finiteReach math:extendedRealValue "-3.5"^^xsd:double .

ex:divergingUpward math:extendedRealValue math:PositiveInfinity .
ex:zeroReach math:extendedRealValue 0 .
