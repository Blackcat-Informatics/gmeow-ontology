#
# Shamir secret sharing — a second "structure-preserving transform that protects
# information", showing the math:Field / math:PolynomialRing machinery does double duty
# with homomorphic encryption. A secret is the constant term of a random degree-(t−1)
# polynomial over a finite field; the n shares are its evaluations at distinct non-zero
# points; any t shares reconstruct the secret by Lagrange interpolation, and any t−1
# reveal nothing. The evaluation is a math:Function over the field; the whole scheme is
# arithmetic in a math:PolynomialRing over a math:Field. Validates cleanly under the gate.

@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix exa:  <https://blackcatinformatics.ca/gmeow/examples/math/algebra/> .

# The finite field GF(2^8) the sharing is done over — a well-formed field.
exa:gf256 a math:Field ;
    rdfs:label "GF(2⁸) — the finite field of 256 elements"@x-gmeow-english ;
    math:underlyingSet exa:gf256Set ;
    math:structureOperation exa:gfAdd , exa:gfMul ;
    math:satisfiesAxiom exa:associativity , exa:commutativity , exa:leftDistributivity ;
    math:satisfiesDistributivity exa:leftDistributivity .

exa:gf256Set a math:Set ; rdfs:label "the 256 elements of GF(2⁸)"@x-gmeow-english .
exa:gfAdd a math:Operation ; rdfs:label "field addition (XOR)"@x-gmeow-english .
exa:gfMul a math:Operation ; rdfs:label "field multiplication"@x-gmeow-english .

# The polynomial ring over GF(2^8) the sharing polynomials live in.
exa:shamirPolyRing a math:PolynomialRing ;
    rdfs:label "GF(2⁸)[x] — the sharing-polynomial ring"@x-gmeow-english ;
    math:underlyingSet exa:shamirPolySet ;
    math:structureOperation exa:polyAdd , exa:polyMul ;
    math:satisfiesAxiom exa:associativity , exa:commutativity , exa:leftDistributivity ;
    math:satisfiesDistributivity exa:leftDistributivity .

exa:shamirPolySet a math:Set ; rdfs:label "polynomials over GF(2⁸)"@x-gmeow-english .
exa:polyAdd a math:Operation ; rdfs:label "polynomial addition"@x-gmeow-english .
exa:polyMul a math:Operation ; rdfs:label "polynomial multiplication"@x-gmeow-english .

# The share-generation map: evaluate the secret polynomial at each distinct point.
# A function over the field — shares are p(xᵢ) for distinct non-zero xᵢ.
exa:shamirEvaluation a math:Function ;
    rdfs:label "x ↦ p(x): evaluate the sharing polynomial at a point (→ a share)"@x-gmeow-english ;
    math:domain exa:gf256Set ;
    math:codomain exa:gf256Set .
