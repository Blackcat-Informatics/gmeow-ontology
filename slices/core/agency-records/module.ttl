    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "creature movement"@x-gmeow-english ;
    skos:definition "The source reports a creature moving from one place to another."@x-gmeow-english ;
    gmeow:useWhen "Use for a reported place-to-place transition, not every generic state change."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting a mood shift or demand response as movement without location evidence."@x-gmeow-english ;
    gmeow:howToUse "Use actual eventFromLocation and eventToLocation endpoints when known, preserving their reference frame."@x-gmeow-english ;
    skos:scopeNote "The kind supplies no route, coordinate, speed or actual-world travel inference."@x-gmeow-english ;
    skos:example "Classify the movement: ex:crossing gmeow:eventType gmeow:eventTypeCreatureTransition ."@x-gmeow-english .

gmeow:eventTypeCreatureUtterance
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "creature utterance"@x-gmeow-english ;
    skos:definition "The source reports that a creature spoke or produced an utterance under its interaction convention."@x-gmeow-english ;
    gmeow:useWhen "Use for the uttering occurrence rather than the retained utterance text."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a Message as the speech Event or inferring a real voice, understanding or delivery."@x-gmeow-english ;
    gmeow:howToUse "Keep the actual speaker distinct from its provider; retain words, language and direction on the actual message artifact."@x-gmeow-english ;
    skos:scopeNote "The kind asserts no truth of the uttered content and executes no speech synthesizer."@x-gmeow-english ;
    skos:example "Classify the utterance: ex:utterance gmeow:eventType gmeow:eventTypeCreatureUtterance ."@x-gmeow-english .

gmeow:eventTypeCreatureMemory
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "creature recollection"@x-gmeow-english ;
    skos:definition "The source reports a creature remembering a moment, distinct from the stored memory claim or report."@x-gmeow-english ;
    gmeow:useWhen "Use for a reported recollection occurrence, including contested memories."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid making a MemoryItem the recollection Event or inferring that remembered content is true."@x-gmeow-english ;
    gmeow:howToUse "Use MentalProcess and processRecollection only with an actual experiencer; recollects targets an actual Experience when supplied."@x-gmeow-english ;
    skos:scopeNote "A reported memory neither runs retrieval nor certifies historical accuracy or completeness."@x-gmeow-english ;
    skos:example "Classify the recollection: ex:remembering gmeow:eventType gmeow:eventTypeCreatureMemory ."@x-gmeow-english .

gmeow:eventTypeCreatureMoodShift
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "creature mood shift"@x-gmeow-english ;
    skos:definition "The source reports a change in a creature’s background mood."@x-gmeow-english ;
    gmeow:useWhen "Use for a source-reported mood transition rather than the enduring mood itself."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring a new mood from a response code, expression or classifier label alone."@x-gmeow-english ;
    gmeow:howToUse "Keep actual before and after Mood claims separately attributed and scoped when the source supplies them."@x-gmeow-english ;
    skos:scopeNote "The kind neither overwrites earlier mood claims nor chooses a globally latest state."@x-gmeow-english ;
    skos:example "Classify the mood change: ex:shift gmeow:eventType gmeow:eventTypeCreatureMoodShift ."@x-gmeow-english .

gmeow:eventTypeCreatureDemand
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "creature demand occurrence"@x-gmeow-english ;
    skos:definition "The source reports a creature expressing a demand; the occurrence is distinct from the underlying Desire."@x-gmeow-english ;
    gmeow:useWhen "Use for the reported demanding occurrence, retaining actual wanting separately."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid typing the Desire or source request document as this Event."@x-gmeow-english ;
    gmeow:howToUse "Retain the actual Desire’s bearer and Goal; use motivates only for a source-supported motive for the demanding act."@x-gmeow-english ;
    skos:scopeNote "Demanding does not impose an obligation or show that an answer was given."@x-gmeow-english ;
    skos:example "Classify the demand act: ex:asking gmeow:eventType gmeow:eventTypeCreatureDemand ."@x-gmeow-english .

gmeow:eventTypeCreatureDemandResolved
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "creature demand answered"@x-gmeow-english ;
    skos:definition "The source reports that a creature’s demand was answered; resolved denotes answering, not proven satisfaction."@x-gmeow-english ;
    gmeow:useWhen "Use for the reported answering occurrence even when acceptance or satisfaction is unknown."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring GoalEvaluation, object acceptance or a terminal success outcome from this label."@x-gmeow-english ;
    gmeow:howToUse "Bind the actual answering Event to its exact Desire with answersDemand; retain a supplied demandResponse independently."@x-gmeow-english ;
    skos:scopeNote "Several answers may address one Desire. Their order and finality remain source facts, never clock-selected defaults."@x-gmeow-english ;
    skos:example "Classify the answer occurrence: ex:answer gmeow:eventType gmeow:eventTypeCreatureDemandResolved ; gmeow:answersDemand ex:wish ."@x-gmeow-english .

gmeow:DemandKindEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Demand kind evidence constraint"@x-gmeow-english ;
    skos:definition "A supplied demand kind belongs to an actual Desire with an actual bearer and Goal, and its exact field claim retains reader and source."@x-gmeow-english ;
    gmeow:useWhen "Use to keep what is wanted attached to the actual wanting mode."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying Desire requirements with a category code or anonymous invented goal."@x-gmeow-english ;
    gmeow:howToUse "Supply intentBearer and intentionGoal and reify the exact demandKind assertion with its reader and retained source."@x-gmeow-english ;
    skos:scopeNote "The law demands retained identities; it never manufactures a bearer, goal or demanded action."@x-gmeow-english ;
    skos:example "Name the wanting law: gmeow:DemandKindEvidenceConstraint logic:formalizes gmeow:demandKind ."@x-gmeow-english ;
    logic:message "A supplied demand kind belongs to an actual Desire with an actual bearer and Goal, and its exact field claim retains reader and source."@x-gmeow-english ;
    logic:formalizes gmeow:demandKind ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "kind" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:demandKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "kind" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "bearer" ], [ logic:termIndex 1 ; logic:termVariable "goal" ], [ logic:termIndex 2 ; logic:termVariable "claim" ], [ logic:termIndex 3 ; logic:termVariable "reader" ], [ logic:termIndex 4 ; logic:termVariable "source" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:Desire ] ], [ a logic:Formula ; logic:relation gmeow:intentBearer ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "bearer" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "bearer" ], [ logic:termIndex 1 ; logic:termIri gmeow:Agent ] ], [ a logic:Formula ; logic:relation gmeow:intentionGoal ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "goal" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "goal" ], [ logic:termIndex 1 ; logic:termIri gmeow:Goal ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementSubject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementPredicate ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termIri gmeow:demandKind ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementObject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "kind" ] ], [ a logic:Formula ; logic:relation gmeow:accordingTo ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "reader" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "reader" ], [ logic:termIndex 1 ; logic:termIri gmeow:Agent ] ], [ a logic:Formula ; logic:relation gmeow:wasDerivedFrom ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "source" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "source" ], [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] ] ] ] ] .

gmeow:DemandResponseEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Demand response evidence constraint"@x-gmeow-english ;
    skos:definition "A supplied response kind belongs to an actual answering Event bound to an actual Desire, with reader and source on the exact response claim."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish a reported answering act from a response label on a document."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid taking a bare cuddle, lap or pet code as sufficient evidence of an answering act."@x-gmeow-english ;
    gmeow:howToUse "Name the Event and its answersDemand target, then retain the exact demandResponse reifier’s reader and source."@x-gmeow-english ;
    skos:scopeNote "Structural evidence does not authenticate the interaction or establish the creature’s acceptance."@x-gmeow-english ;
    skos:example "Name the answer law: gmeow:DemandResponseEvidenceConstraint logic:formalizes gmeow:demandResponse ."@x-gmeow-english ;
    logic:message "A supplied response kind belongs to an actual answering Event bound to an actual Desire, with reader and source on the exact response claim."@x-gmeow-english ;
    logic:formalizes gmeow:demandResponse ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "response" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:demandResponse ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "response" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "demand" ], [ logic:termIndex 1 ; logic:termVariable "claim" ], [ logic:termIndex 2 ; logic:termVariable "reader" ], [ logic:termIndex 3 ; logic:termVariable "source" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:Event ] ], [ a logic:Formula ; logic:relation gmeow:answersDemand ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "demand" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "demand" ], [ logic:termIndex 1 ; logic:termIri gmeow:Desire ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementSubject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementPredicate ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termIri gmeow:demandResponse ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementObject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "response" ] ], [ a logic:Formula ; logic:relation gmeow:accordingTo ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "reader" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "reader" ], [ logic:termIndex 1 ; logic:termIri gmeow:Agent ] ], [ a logic:Formula ; logic:relation gmeow:wasDerivedFrom ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "source" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "source" ], [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] ] ] ] ] .

gmeow:AnsweredDemandBindingConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Answered demand binding constraint"@x-gmeow-english ;
    skos:definition "An answersDemand Event identifies an actual classified Desire with its actual bearer and Goal, retaining source and reader on the exact binding claim."@x-gmeow-english ;
    gmeow:useWhen "Use when similar demands must remain separately addressable by answering events."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid matching by demandKind alone or coercing a WorldObjectRequest into Desire."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact answersDemand claim, the Desire’s demandKind, its Agent bearer and its Goal."@x-gmeow-english ;
    skos:scopeNote "This is an evidence binding, not an inferred motive, acceptance record or satisfaction verdict."@x-gmeow-english ;
    skos:example "Name the exact-binding law: gmeow:AnsweredDemandBindingConstraint logic:formalizes gmeow:answersDemand ."@x-gmeow-english ;
    logic:message "An answersDemand Event identifies an actual classified Desire with its actual bearer and Goal, retaining source and reader on the exact binding claim."@x-gmeow-english ;
    logic:formalizes gmeow:answersDemand ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "demand" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:answersDemand ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "demand" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "bearer" ], [ logic:termIndex 1 ; logic:termVariable "goal" ], [ logic:termIndex 2 ; logic:termVariable "kind" ], [ logic:termIndex 3 ; logic:termVariable "claim" ], [ logic:termIndex 4 ; logic:termVariable "reader" ], [ logic:termIndex 5 ; logic:termVariable "source" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:Event ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "demand" ], [ logic:termIndex 1 ; logic:termIri gmeow:Desire ] ], [ a logic:Formula ; logic:relation gmeow:intentBearer ; logic:argument [ logic:termIndex 0 ; logic:termVariable "demand" ], [ logic:termIndex 1 ; logic:termVariable "bearer" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "bearer" ], [ logic:termIndex 1 ; logic:termIri gmeow:Agent ] ], [ a logic:Formula ; logic:relation gmeow:intentionGoal ; logic:argument [ logic:termIndex 0 ; logic:termVariable "demand" ], [ logic:termIndex 1 ; logic:termVariable "goal" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "goal" ], [ logic:termIndex 1 ; logic:termIri gmeow:Goal ] ], [ a logic:Formula ; logic:relation gmeow:demandKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "demand" ], [ logic:termIndex 1 ; logic:termVariable "kind" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "kind" ], [ logic:termIndex 1 ; logic:termIri gmeow:DemandKind ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementSubject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementPredicate ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termIri gmeow:answersDemand ] ], [ a logic:Formula ; logic:relation logic:reifiedStatementObject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "demand" ] ], [ a logic:Formula ; logic:relation gmeow:accordingTo ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "reader" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "reader" ], [ logic:termIndex 1 ; logic:termIri gmeow:Agent ] ], [ a logic:Formula ; logic:relation gmeow:wasDerivedFrom ; logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ], [ logic:termIndex 1 ; logic:termVariable "source" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "source" ], [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] ] ] ] ] .

gmeow:CreatureDemandAnsweredConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Creature demand answer target constraint"@x-gmeow-english ;
    skos:definition "An occurrence classified as a creature demand answered retains an answersDemand link to its exact actual Desire."@x-gmeow-english ;
    gmeow:useWhen "Use even when the source reports an answer but supplies no response-kind code."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a response kind merely to identify which demand was answered."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact Desire through answersDemand; that relation’s own law preserves its bearer, Goal and source."@x-gmeow-english ;
    skos:scopeNote "The target law imposes no successful outcome, final answer or exclusive response."@x-gmeow-english ;
    skos:example "Name the target law: gmeow:CreatureDemandAnsweredConstraint logic:formalizes gmeow:eventTypeCreatureDemandResolved ."@x-gmeow-english ;
    logic:message "An occurrence classified as a creature demand answered retains an answersDemand link to its exact actual Desire."@x-gmeow-english ;
    logic:formalizes gmeow:eventTypeCreatureDemandResolved ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:eventType ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:eventTypeCreatureDemandResolved ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "demand" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:answersDemand ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "demand" ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "demand" ], [ logic:termIndex 1 ; logic:termIri gmeow:Desire ] ] ] ] ] ] .

# Validate supplied selectors without requiring a category on every Desire/Event.
[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/demandKind" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/demandResponse" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/answersDemand" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:OpenLoop
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Open Loop Record"@x-gmeow-english ;
    skos:definition "A durable information record of a pursuit, retained across episodes and after reported closure."@x-gmeow-english ;
    skos:scopeNote "The record is neither an Intention, a Plan, an episode nor an attempt occurrence. Its type supplies no default open state and identifies no pursuing agent."@x-gmeow-english ;
    skos:example "ex:pursuit a gmeow:OpenLoop ; gmeow:description \"Keep the archive discrepancy in view.\"@en ."@x-gmeow-english ;
    gmeow:useWhen "Use for a pursuit record whose identity persists across episodes and declared states."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the record as a running event, an internal commitment or proof that its pursuit remains open."@x-gmeow-english ;
    gmeow:howToUse "Retain source wording with description; link supplied task artifacts and Intentions separately, and scope exact state claims with their declared frame and source."@x-gmeow-english .

gmeow:loopTaskDocument
    a logic:ObjectProperty ;
    logic:domain gmeow:OpenLoop ;
    logic:range gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "loop task artifact"@x-gmeow-english ;
    skos:definition "A supplied task-specification information object associated with a pursuit record."@x-gmeow-english ;
    skos:scopeNote "The target is an information object, not the Task occurrence. A concrete source artifact is not forced into the abstract Document Work type."@x-gmeow-english ;
    skos:example "ex:pursuit gmeow:loopTaskDocument ex:taskArtifact ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source identifies the task specification kept for a pursuit."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using this edge for the task event or inferring an executable plan from a supplied artifact."@x-gmeow-english ;
    gmeow:howToUse "Link the OpenLoop to the source-identified InformationObject and retain its original identity and provenance."@x-gmeow-english .

gmeow:loopServesIntention
    a logic:ObjectProperty ;
    logic:domain gmeow:OpenLoop ;
    logic:range gmeow:Intention ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "loop serves intention"@x-gmeow-english ;
    skos:definition "An Intention that the source explicitly says a pursuit record serves."@x-gmeow-english ;
    skos:scopeNote "The linked Intention retains its own supplied intentBearer and goal. Neither the declaring writer nor the recorder identifies that bearer by implication."@x-gmeow-english ;
    skos:example "ex:pursuit gmeow:loopServesIntention ex:resolveDiscrepancy ."@x-gmeow-english ;
    gmeow:useWhen "Use when an actual source link identifies an Intention served by the pursuit."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a commitment, bearer or goal, or inferring intention satisfaction or abandonment from loop state."@x-gmeow-english ;
    gmeow:howToUse "Link the OpenLoop to the supplied Intention; preserve the Intention’s own identity, bearer and goal evidence."@x-gmeow-english .

gmeow:LoopState
    a logic:Class, logic:AbstractIndividualType ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Loop State"@x-gmeow-english ;
    skos:definition "An open value vocabulary for declared source assessments of a pursuit record’s state."@x-gmeow-english ;
    skos:scopeNote "The three seeds describe open, done or let-go assessments. They compute no transition, reopening, goal satisfaction or current winner."@x-gmeow-english ;
    skos:example "gmeow:loopDone a gmeow:LoopState ."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve the state a source explicitly declares for a pursuit record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid closing the vocabulary or treating an assessment as a runtime verdict."@x-gmeow-english ;
    gmeow:howToUse "Select a value through loopState; retain the exact assertion’s declaring frame and source."@x-gmeow-english .

gmeow:loopOpen
    a gmeow:LoopState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "pursuit declared open"@x-gmeow-english ;
    skos:definition "A source assessment recording a pursuit as remaining open."@x-gmeow-english ;
    skos:scopeNote "Open is an explicit declaration, not a default from OpenLoop typing or evidence of a running episode."@x-gmeow-english ;
    skos:example "ex:claim rdf:reifies <<( ex:pursuit gmeow:loopState gmeow:loopOpen )>> ; gmeow:accordingTo ex:writer ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly records the pursuit as open."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving this state from missing metadata or the existence of a loop record."@x-gmeow-english ;
    gmeow:howToUse "Record loopOpen through loopState on the exact source-scoped state assertion."@x-gmeow-english .

gmeow:loopDone
    a gmeow:LoopState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "pursuit declared done"@x-gmeow-english ;
    skos:definition "A source assessment recording a pursuit as done."@x-gmeow-english ;
    skos:scopeNote "The declaration establishes no successful execution, goal satisfaction or completion of a linked Intention."@x-gmeow-english ;
    skos:example "ex:claim rdf:reifies <<( ex:pursuit gmeow:loopState gmeow:loopDone )>> ; gmeow:accordingTo ex:writer ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly records the pursuit as done."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this value as a verified outcome or inferring the actual closing Agent."@x-gmeow-english ;
    gmeow:howToUse "Record loopDone through loopState; keep any closure report, actor and evidence separately identified."@x-gmeow-english .

gmeow:loopLetGo
    a gmeow:LoopState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "pursuit declared let go"@x-gmeow-english ;
    skos:definition "A source assessment recording that a pursuit was let go rather than recorded as done."@x-gmeow-english ;
    skos:scopeNote "Letting go establishes no deletion, cancellation permission or abandonment of a linked Intention. The record and earlier claims remain retained."@x-gmeow-english ;
    skos:example "ex:claim rdf:reifies <<( ex:pursuit gmeow:loopState gmeow:loopLetGo )>> ; gmeow:accordingTo ex:writer ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly records letting go of the pursuit."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting this declaration as authority to cancel work, erase history or end an Intention."@x-gmeow-english ;
    gmeow:howToUse "Record loopLetGo through loopState while preserving the source, context and retained loop identity."@x-gmeow-english .

gmeow:loopState
    a logic:ObjectProperty ;
    logic:domain gmeow:OpenLoop ;
    logic:range gmeow:LoopState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "loop state"@x-gmeow-english ;
    skos:definition "A state assessment declared for a pursuit record in the selected source context."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional. Missing values are unspecified; historical and conflicting claims coexist without a default, current winner or latest-timestamp selection."@x-gmeow-english ;
    skos:example "ex:claim rdf:reifies <<( ex:pursuit gmeow:loopState gmeow:loopOpen )>> ; gmeow:accordingTo ex:writer ."@x-gmeow-english ;
    gmeow:useWhen "Use when a source supplies an explicit state assessment for a loop record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid computing transitions, reopening or goal satisfaction from declared states."@x-gmeow-english ;
    gmeow:howToUse "Reify the exact loop and state tuple; keep accordingTo for its declaring frame, wasAttributedTo for the recorder and wasDerivedFrom for the source artifact."@x-gmeow-english .

gmeow:LoopClosure
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Loop Closure Report"@x-gmeow-english ;
    skos:definition "An information record reporting closure of a pursuit record."@x-gmeow-english ;
    skos:scopeNote "The report is not the closing Event or Activity. It rewrites no loop state and supplies no enactment receipt, goal evaluation or permission."@x-gmeow-english ;
    skos:example "ex:report a gmeow:LoopClosure ; gmeow:closureLoop ex:pursuit ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source keeps a separately identified report about closing a pursuit."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a report as an executed closure or identifying the closer from the reporting or recording agent."@x-gmeow-english ;
    gmeow:howToUse "Retain closureLoop, any supplied closedBy and closureEvidence, and the exact statedRationale; keep recording attribution, declaring frame and report source distinct."@x-gmeow-english .

gmeow:closureLoop
    a logic:ObjectProperty ;
    logic:domain gmeow:LoopClosure ;
    logic:range gmeow:OpenLoop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported closure loop"@x-gmeow-english ;
    skos:definition "The pursuit record whose closure a source report describes."@x-gmeow-english ;
    skos:scopeNote "The link identifies the report’s subject; it neither changes loopState nor establishes that closure occurred."@x-gmeow-english ;
    skos:example "ex:report gmeow:closureLoop ex:pursuit ."@x-gmeow-english ;
    gmeow:useWhen "Use when a closure report identifies the pursuit record it concerns."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using this relation as a command to close a loop or an inferred state transition."@x-gmeow-english ;
    gmeow:howToUse "Link the LoopClosure report to the source-identified OpenLoop, retaining both record identities."@x-gmeow-english .

gmeow:closedBy
    a logic:ObjectProperty ;
    logic:domain gmeow:LoopClosure ;
    logic:range gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported actual closing agent"@x-gmeow-english ;
    skos:definition "The actual closing Agent identified by the source of a loop closure report."@x-gmeow-english ;
    skos:scopeNote "The closing, recording and declaring-frame roles are distinct; a source-identified Agent may occupy more than one role. Unknown actors stay unknown; consumer role codes and evidence do not synthesize an Agent identity."@x-gmeow-english ;
    skos:example "ex:report gmeow:closedBy ex:closer ."@x-gmeow-english ;
    gmeow:useWhen "Use only when the source identifies an actual Agent as the closer."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating evidence, a local role code, the declaring writer or the recorder as the closer without an explicit source identification."@x-gmeow-english ;
    gmeow:howToUse "Link the LoopClosure report to the source-identified Agent; retain wasAttributedTo, accordingTo and evidence separately, without inventing unknown actors."@x-gmeow-english .

gmeow:closureEvidence
    a logic:ObjectProperty ;
    logic:domain gmeow:LoopClosure ;
    logic:range gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported closure evidence"@x-gmeow-english ;
    skos:definition "A retained information artifact or exact native reifier cited as the basis of a loop closure report."@x-gmeow-english ;
    skos:scopeNote "Cite the information record without retyping its underlying occurrence or Observation as InformationObject. Citation establishes no verification, entailment, authenticity or permission."@x-gmeow-english ;
    skos:example "ex:report gmeow:closureEvidence ex:evidenceRecord ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source cites an identified information artifact or reifier as closure evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using an actual occurrence as the information record, inferring support or converting an evidence basis into a closing Agent."@x-gmeow-english ;
    gmeow:howToUse "Link the LoopClosure report to the retained InformationObject; preserve exact rdf:reifies content when citing a reifier and keep the report’s wasDerivedFrom source separate."@x-gmeow-english .

# Supplied values are typed without requiring paths, choosing winners or deriving states.
gmeow:OpenLoop logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:loopTaskDocument ; logic:allValuesFrom gmeow:InformationObject ],
    [ a logic:Restriction ; logic:onProperty gmeow:loopServesIntention ; logic:allValuesFrom gmeow:Intention ],
    [ a logic:Restriction ; logic:onProperty gmeow:loopState ; logic:allValuesFrom gmeow:LoopState ] .

gmeow:LoopClosure logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:closureLoop ; logic:allValuesFrom gmeow:OpenLoop ],
    [ a logic:Restriction ; logic:onProperty gmeow:closedBy ; logic:allValuesFrom gmeow:Agent ],
    [ a logic:Restriction ; logic:onProperty gmeow:closureEvidence ; logic:allValuesFrom gmeow:InformationObject ] .

gmeow:LoopReference
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Loop Reference Record"@x-gmeow-english ;
    skos:definition "An independently identified information record for source-supplied references to a pursuit record or its task-specification artifact."@x-gmeow-english ;
    skos:scopeNote "The reference is neither the pursuit record nor the task artifact. Its links constrain supplied values only; missing targets are unspecified, not invented or copied."@x-gmeow-english ;
    skos:example "ex:reference a gmeow:LoopReference ; gmeow:referencedLoop ex:pursuit ."@x-gmeow-english ;
    gmeow:useWhen "Use when a source retains a separately identified reference to a loop or task specification."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the reference as a loop, a task artifact, an assignment or proof of target availability."@x-gmeow-english ;
    gmeow:howToUse "Retain the reference identity and each supplied referencedLoop or referencedTaskDocument link, with its source and context."@x-gmeow-english .

gmeow:referencedLoop
    a logic:ObjectProperty ;
    logic:domain gmeow:LoopReference ;
    logic:range gmeow:OpenLoop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "referenced loop"@x-gmeow-english ;
    skos:definition "A source-supplied pursuit record named by a loop reference record."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional and supplied-only. The link copies no loop state and establishes no current selection, target resolution or pursuer identity."@x-gmeow-english ;
    skos:example "ex:reference gmeow:referencedLoop ex:pursuit ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly identifies the OpenLoop named by a reference."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a loop target or inferring one from a task artifact, writer or recorder."@x-gmeow-english ;
    gmeow:howToUse "Link the LoopReference to each source-identified OpenLoop and preserve the original target identity."@x-gmeow-english .

gmeow:referencedTaskDocument
    a logic:ObjectProperty ;
    logic:domain gmeow:LoopReference ;
    logic:range gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "referenced task artifact"@x-gmeow-english ;
    skos:definition "A supplied task-specification information artifact named by a loop reference record."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional and supplied-only. The target is not copied from loopTaskDocument, selected by latest revision or forced equal to another target."@x-gmeow-english ;
    skos:example "ex:reference gmeow:referencedTaskDocument ex:taskArtifact ."@x-gmeow-english ;
    gmeow:useWhen "Use when a source explicitly names the task-specification artifact retained by a reference."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using a Task occurrence as the information artifact or manufacturing a missing target."@x-gmeow-english ;
    gmeow:howToUse "Link the LoopReference to the supplied InformationObject and retain its original identity independently of other task links."@x-gmeow-english .

gmeow:slotCurrentLoop
    a gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "current-loop attention-slot role"@x-gmeow-english ;
    skos:definition "A named role descriptor for an attention slot whose positions point to actual loop reference records."@x-gmeow-english ;
    skos:scopeNote "This InformationObject is a role, not a mutable property, slot, position, pointer or loop record. It creates no assignment, current winner, target resolution, authentication or permission."@x-gmeow-english ;
    skos:example "ex:slot gmeow:slotRole gmeow:slotCurrentLoop ."@x-gmeow-english ;
    gmeow:useWhen "Use as the role of a source-identified attention slot for current-loop reference selection."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this descriptor as the current loop or as a replacement for the existing slot and assignment protocol."@x-gmeow-english ;
    gmeow:howToUse "Use through slotRole; follow slotState to the SlotPosition and slotPointer to the actual LoopReference, retaining typed SlotAssignmentClaim reifiers."@x-gmeow-english .

gmeow:notebookLoop
    a logic:ObjectProperty ;
    logic:domain gmeow:NotebookEntry ;
    logic:range gmeow:OpenLoop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "notebook loop association"@x-gmeow-english ;
    skos:definition "A source-supplied association of a notebook entry with a durable pursuit record."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional. The link copies no state or content, infers no Intention or pursuer and imposes no common writer."@x-gmeow-english ;
    skos:example "ex:entry gmeow:notebookLoop ex:pursuit ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly associates a notebook entry with an existing loop record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving the association from matching words, a shared author or a current-slot claim."@x-gmeow-english ;
    gmeow:howToUse "Link the NotebookEntry to the supplied OpenLoop while preserving the entry’s existing content, kind, state claims and attribution."@x-gmeow-english .

# Reference and notebook links constrain supplied values without requiring targets.
gmeow:LoopReference logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:referencedLoop ; logic:allValuesFrom gmeow:OpenLoop ],
    [ a logic:Restriction ; logic:onProperty gmeow:referencedTaskDocument ; logic:allValuesFrom gmeow:InformationObject ] .

gmeow:NotebookEntry logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:notebookLoop ; logic:allValuesFrom gmeow:OpenLoop ] .

gmeow:Guidance
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:Note ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Guidance Offer Note"@x-gmeow-english ;
    skos:definition "A note retaining a source’s offered guidance as content, separately from a command or executed action."@x-gmeow-english ;
    skos:scopeNote "This classification establishes no command, permission, Intention, adoption or execution. The note author, recorder, declaring frame and slot bearer do not by themselves identify a proposer or pursuer."@x-gmeow-english ;
    skos:example "ex:offer a gmeow:Guidance ; gmeow:noteContent \"Consider reviewing the archive discrepancy.\"@en ."@x-gmeow-english ;
    gmeow:useWhen "Use when a source keeps an offer of guidance as a note rather than an execution or authority verdict."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the offer as a Norm, an executable plan, a computed preference winner or proof that anyone acted on it."@x-gmeow-english ;
    gmeow:howToUse "Retain wording with noteContent and supplied reasons with statedRationale; keep source derivation, recording attribution and declaring frame separate."@x-gmeow-english .

gmeow:guidanceLoop
    a logic:ObjectProperty ;
    logic:domain gmeow:Guidance ;
    logic:range gmeow:OpenLoop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "guidance loop association"@x-gmeow-english ;
    skos:definition "A source-supplied association of an offered guidance note with a durable pursuit record."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional and supplied-only. The association copies no loop state or content and identifies no Intention, proposer or pursuer by implication."@x-gmeow-english ;
    skos:example "ex:offer gmeow:guidanceLoop ex:pursuit ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly relates the offered guidance to an existing loop record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving the association from shared wording, note authorship, a slot selection or a recording Agent."@x-gmeow-english ;
    gmeow:howToUse "Link the Guidance note to each supplied OpenLoop and preserve the exact association’s source and context."@x-gmeow-english .

gmeow:slotCurrentGuidance
    a gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "current-guidance attention-slot role"@x-gmeow-english ;
    skos:definition "A named role descriptor for an attention slot whose positions point to actual Guidance offer notes."@x-gmeow-english ;
    skos:scopeNote "The descriptor is not a mutable property, slot, position, pointer or offer note. It creates no assignment, current winner, resolver, authentication or permission."@x-gmeow-english ;
    skos:example "ex:slot gmeow:slotRole gmeow:slotCurrentGuidance ."@x-gmeow-english ;
    gmeow:useWhen "Use as the role of a source-identified attention slot retaining current-guidance selections."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the role itself as an offer, a chosen action or a replacement for the existing slot-assignment protocol."@x-gmeow-english ;
    gmeow:howToUse "Use through slotRole; follow slotState to its SlotPosition and slotPointer to the actual Guidance note, retaining typed SlotAssignmentClaim reifiers."@x-gmeow-english .

# Supplied loop links are typed without requiring a target or choosing a winner.
gmeow:Guidance logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:guidanceLoop ; logic:allValuesFrom gmeow:OpenLoop ] .

gmeow:EpisodeTransition
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Episode Transition Report"@x-gmeow-english ;
    skos:definition "An information record of a source-reported departure from an episode Activity and entry into an episode Activity."@x-gmeow-english ;
    skos:scopeNote "The report is distinct from the episode occurrences, a persona transition and a state update. It computes no chronology, causal order, timestamps, execution, permission or current winner."@x-gmeow-english ;
    skos:example "ex:report a gmeow:EpisodeTransition ; gmeow:episodeLeft ex:episodeA ; gmeow:episodeEntered ex:episodeB ."@x-gmeow-english ;
    gmeow:useWhen "Use when a source retains a separately identified report of an episode activity change."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the report as an episode, an executed transition, a persona change or proof of scheduler action."@x-gmeow-english ;
    gmeow:howToUse "Retain each supplied episodeLeft, episodeEntered and transitionLoop link with its source, recording attribution and declaring frame."@x-gmeow-english .

gmeow:episodeLeft
    a logic:ObjectProperty ;
    logic:domain gmeow:EpisodeTransition ;
    logic:range gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "episode left"@x-gmeow-english ;
    skos:definition "The source-identified episode Activity occurrence reported as left by an episode-transition record."@x-gmeow-english ;
    skos:scopeNote "The target is the actual episode occurrence, not a document describing it. The link establishes no ending time, completion, causal order or execution verdict."@x-gmeow-english ;
    skos:example "ex:report gmeow:episodeLeft ex:episodeA ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly identifies the episode Activity it reports leaving."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid targeting an activity descriptor, a report artifact or a persona instead of the episode occurrence."@x-gmeow-english ;
    gmeow:howToUse "Link the EpisodeTransition report to the supplied Activity endpoint and preserve the exact declaration’s source and frame."@x-gmeow-english .

gmeow:episodeEntered
    a logic:ObjectProperty ;
    logic:domain gmeow:EpisodeTransition ;
    logic:range gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "episode entered"@x-gmeow-english ;
    skos:definition "The source-identified episode Activity occurrence reported as entered by an episode-transition record."@x-gmeow-english ;
    skos:scopeNote "The target is the actual episode occurrence, not a document describing it. The link establishes no start time, causal order, permission or successful execution."@x-gmeow-english ;
    skos:example "ex:report gmeow:episodeEntered ex:episodeB ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly identifies the episode Activity it reports entering."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid targeting a proposed activity description, a report artifact or a slot position instead of the episode occurrence."@x-gmeow-english ;
    gmeow:howToUse "Link the EpisodeTransition report to the supplied Activity endpoint and preserve the exact declaration’s source and frame."@x-gmeow-english .

gmeow:transitionLoop
    a logic:ObjectProperty ;
    logic:domain gmeow:EpisodeTransition ;
    logic:range gmeow:OpenLoop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reported transition loop"@x-gmeow-english ;
    skos:definition "A source-supplied pursuit record named as the loop entered in an episode-transition report."@x-gmeow-english ;
    skos:scopeNote "The link names an OpenLoop record without changing loop state, assigning a current slot or identifying an Intention, agent or pursuer."@x-gmeow-english ;
    skos:example "ex:report gmeow:transitionLoop ex:pursuit ."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly identifies the loop entered in the reported episode change."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a loop target from endpoint wording, recording attribution or the declaring frame."@x-gmeow-english ;
    gmeow:howToUse "Link the EpisodeTransition report to each supplied OpenLoop and retain the original target identity and exact claim context."@x-gmeow-english .

# Supplied endpoint and loop values are typed without requiring targets.
gmeow:EpisodeTransition logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:episodeLeft ; logic:allValuesFrom gmeow:Activity ],
    [ a logic:Restriction ; logic:onProperty gmeow:episodeEntered ; logic:allValuesFrom gmeow:Activity ],
    [ a logic:Restriction ; logic:onProperty gmeow:transitionLoop ; logic:allValuesFrom gmeow:OpenLoop ] .

gmeow:BudgetReading
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Budget reading"@x-gmeow-english ;
    skos:definition "A source-recorded information object retaining one UTC civil day’s runtime counters for one ledger spender under the writer-declared ledger schema."@x-gmeow-english ;
    skos:scopeNote "Exactly one day, spender and declared schema are required, with at least one supplied count and at most one Quantity per count role. This record asserts no observation, payment, successful execution, complete coverage or computed total."@x-gmeow-english ;
    skos:example "A historical daily ledger record supplies a request count but no web-call count; the report retains only the supplied count."@x-gmeow-english ;
    gmeow:useWhen "Use for the ledger’s actual daily runtime counter record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a report as an Observation or inventing a missing counter, spender, schema or cost."@x-gmeow-english ;
    gmeow:howToUse "Retain the supplied day, spender and schema, and link each supplied count through its existing math:Quantity with the original typed magnitude, dimensionless dimension and actual complete counting frame."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:budgetDay
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "budget day"@x-gmeow-english ;
    skos:definition "The UTC civil day to which this BudgetReading’s ledger counters belong, retained as the supplied xsd:date."@x-gmeow-english ;
    skos:scopeNote "The date identifies the counting day, not a reporting instant, local civil day or invented midnight. Exactly one is required per report."@x-gmeow-english ;
    skos:example "A ledger declares which UTC day its counters cover without supplying a reporting timestamp."@x-gmeow-english ;
    gmeow:useWhen "Use for the actual UTC civil day declared by the ledger."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving this date from an unrelated timestamp or substituting a local day."@x-gmeow-english ;
    gmeow:howToUse "Keep exactly one supplied xsd:date on the BudgetReading; preserve its literal and UTC day interpretation."@x-gmeow-english ;
    logic:domain gmeow:BudgetReading ;
    logic:range xsd:date .

gmeow:budgetLedgerSchema
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "budget ledger schema"@x-gmeow-english ;
    skos:definition "The exact ledger schema identity declared by the writer for this BudgetReading, retained as the supplied xsd:token."@x-gmeow-english ;
    skos:scopeNote "Exactly one declared schema is required. The value is not a schema inferred from field names or a newly computed schema hash."@x-gmeow-english ;
    skos:example "The writer supplies a schema identity alongside the daily counters."@x-gmeow-english ;
    gmeow:useWhen "Use when the ledger writer actually declares its schema identity."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid guessing a schema, normalizing its identity or silently retyping an xsd:string as xsd:token."@x-gmeow-english ;
    gmeow:howToUse "Retain the writer’s exact supplied xsd:token on the report and preserve the declaration’s source attribution."@x-gmeow-english ;
    logic:domain gmeow:BudgetReading ;
    logic:range xsd:token .

gmeow:budgetRequests
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "budget requests"@x-gmeow-english ;
    skos:definition "The math:Quantity retaining the ledger’s count of external model requests issued for this BudgetReading’s UTC day and spender."@x-gmeow-english ;
    skos:scopeNote "At most one Quantity fills this role. Issued requests do not imply completed or successful calls, billed usage or payment."@x-gmeow-english ;
    skos:example "An issued request remains counted even when its later outcome is unknown."@x-gmeow-english ;
    gmeow:useWhen "Use for the ledger’s actual count of external model requests issued."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting successful responses, completed calls, tokens, cost or a missing-value zero."@x-gmeow-english ;
    gmeow:howToUse "Link the actual Quantity; retain the supplied xsd:nonNegativeInteger unchanged on math:quantityValue, math:dimensionless on math:hasDimension and one complete frame justified for this ledger, day, spender, schema and issued-request convention."@x-gmeow-english ;
    logic:domain gmeow:BudgetReading ;
    logic:range math:Quantity .

gmeow:budgetCalls
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "budget calls"@x-gmeow-english ;
    skos:definition "The math:Quantity retaining the ledger’s count of web calls written down before running for this BudgetReading’s UTC day and spender."@x-gmeow-english ;
    skos:scopeNote "At most one Quantity fills this role. Recording a web call before running does not prove that it ran, completed or succeeded."@x-gmeow-english ;
    skos:example "A web call is written to the ledger before an attempted execution whose outcome is not supplied."@x-gmeow-english ;
    gmeow:useWhen "Use for the ledger’s actual preregistered web-call count."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating preregistration as execution or inventing zero when the historical record has no web-call field."@x-gmeow-english ;
    gmeow:howToUse "Link the actual Quantity with the supplied xsd:nonNegativeInteger unchanged on math:quantityValue, math:dimensionless and one complete actual frame scoped to this ledger, day, spender, schema and preregistered-web-call convention."@x-gmeow-english ;
    logic:domain gmeow:BudgetReading ;
    logic:range math:Quantity .

gmeow:BudgetSpender
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Budget spender"@x-gmeow-english ;
    skos:definition "An open quality-value axis identifying the ledger’s deployment-local budget bucket for a daily runtime counter record."@x-gmeow-english ;
    skos:scopeNote "Values are budget buckets, not Agents, accounts, payers or globally enumerated deployments. New local values remain permitted."@x-gmeow-english ;
    skos:example "A deployment retains its named consumer bucket as a local BudgetSpender value."@x-gmeow-english ;
    gmeow:useWhen "Use to type actual budget buckets declared by the source ledger."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid identifying a budget bucket with its consumer agent or payer."@x-gmeow-english ;
    gmeow:howToUse "Type the source’s local bucket as BudgetSpender and retain its actual local identity; use the unbucketed seed only for its explicit historical meaning."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:budgetSpender
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "budget spender"@x-gmeow-english ;
    skos:definition "The ledger budget bucket to which this BudgetReading’s daily counters belong."@x-gmeow-english ;
    skos:scopeNote "Exactly one actual BudgetSpender is required per report. This role makes no Agent, account or payer identity assertion."@x-gmeow-english ;
    skos:example "A per-consumer ledger record links to the deployment’s actual local budget bucket."@x-gmeow-english ;
    gmeow:useWhen "Use when the source identifies the budget bucket of its daily counters."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving the bucket from a model name or filling an unknown spender with the unbucketed seed."@x-gmeow-english ;
    gmeow:howToUse "Link exactly one source-supported BudgetSpender and preserve the ledger context that identifies the bucket."@x-gmeow-english ;
    logic:domain gmeow:BudgetReading ;
    logic:range gmeow:BudgetSpender .

gmeow:budgetSpenderUnbucketed
    a gmeow:BudgetSpender ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "unbucketed budget spender"@x-gmeow-english ;
    skos:definition "The explicit historical budget bucket for top-level request records made before the ledger introduced per-consumer buckets."@x-gmeow-english ;
    skos:scopeNote "This seed identifies the historical unbucketed convention, not an unknown spender or an automatic default."@x-gmeow-english ;
    skos:example "A source explicitly identifies a historical top-level request record as preceding per-consumer buckets."@x-gmeow-english ;
    gmeow:useWhen "Use only for source-supported historical records using the unbucketed top-level convention."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for missing, unknown or unmapped modern budget buckets."@x-gmeow-english ;
    gmeow:howToUse "Attach through budgetSpender only when the actual record’s historical context establishes this convention."@x-gmeow-english .

