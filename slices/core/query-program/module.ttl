    logic:message "Every graph edge retains endpoints inside that graph and explicit monotonicity, and agrees with consumer-to-producer dataflow." ;
    logic:integrity
[
    a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "g" ] ,
    [ logic:termIndex 1 ; logic:termVariable "e" ] ;
    logic:forall [
        a logic:Formula ;
        logic:antecedent [
            a logic:Formula ;
            logic:relation gmeow:queryGraphEdge ;
            logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] ,
            [ logic:termIndex 1 ; logic:termVariable "e" ]
        ] ;
        logic:consequent [
            a logic:Formula ;
            logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] ,
            [ logic:termIndex 1 ; logic:termVariable "c" ] ,
            [ logic:termIndex 2 ; logic:termVariable "m" ] ;
            logic:exists [
                a logic:Formula ;
                logic:and [
                    a logic:Formula ;
                    logic:relation logic:flowFrom ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "e" ] ,
                    [ logic:termIndex 1 ; logic:termVariable "p" ]
                ] ,
                [
                    a logic:Formula ;
                    logic:relation logic:flowTo ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "e" ] ,
                    [ logic:termIndex 1 ; logic:termVariable "c" ]
                ] ,
                [
                    a logic:Formula ;
                    logic:relation gmeow:queryGraphNode ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] ,
                    [ logic:termIndex 1 ; logic:termVariable "p" ]
                ] ,
                [
                    a logic:Formula ;
                    logic:relation gmeow:queryGraphNode ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] ,
                    [ logic:termIndex 1 ; logic:termVariable "c" ]
                ] ,
                [
                    a logic:Formula ;
                    logic:relation gmeow:queryEdgeMonotone ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "e" ] ,
                    [ logic:termIndex 1 ; logic:termVariable "m" ]
                ] ,
                [
                    a logic:Formula ;
                    logic:relation logic:dataflowConsumes ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] ,
