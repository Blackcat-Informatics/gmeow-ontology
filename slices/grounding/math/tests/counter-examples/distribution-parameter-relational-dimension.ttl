#
# Counter-example for the native math:DistributionParameterConstraint gate's
# RELATIONAL dimension arm (as opposed to the ABSOLUTE-dimension arm covered by
# distribution-parameter-wrong-dimension.ttl): a math:RandomVariable carries a
# RESOLVABLE ℚ⁷ dimension (math:lengthDimension, a math:BaseDimension), and its
# distribution's variance-role parameter declares math:quantityDimension
# math:squareOfRandomVariableDimension — i.e. its quantity must carry length²
# (dimProduct of the random variable's exponent vector with itself). The supplied
# parameter quantity instead carries the LINEAR math:lengthDimension. The native
# gate resolves the random variable's dimension via the param → distribution →
# random-variable traversal (math:hasDistributionParameter / math:hasDistribution),
# computes the required square by exact ℚ⁷ addition, finds it unequal to the
# actual (linear) dimension, and MUST emit math:DistributionParameterConstraint
# (and no other probability failure class). The role declares no
# math:requiresPositiveValue, so only the relational dimension arm fires.
#
# Every OTHER obligation the traversal's carriers are under is satisfied here, so the
# relational dimension mismatch is the fixture's single defect: the random variable
# names its domain and codomain (math:UnscopedRandomVariable), and the distribution
# names its family and — because it supplies a math:hasDistributionParameter — the
# parameterization convention that fixes which parametric form is meant
# (math:MissingDistributionParameterization).
# Back-reference: math:squareOfRandomVariableDimension / math:DistributionParameterConstraint
# (slices/grounding/math/module.ttl).
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <http://example.org/math/> .

ex:weightRV a math:RandomVariable ;
    math:hasDistribution ex:weightDist ;
    math:randomVariableDomain ex:sampleOutcomes ;
    math:randomVariableCodomain ex:realValues ;
    math:hasDimension math:lengthDimension .

ex:sampleOutcomes a math:Set .
ex:realValues a math:Set .

ex:weightDist a math:Distribution ;
    math:distributionFamily ex:gaussianFamily ;
    math:distributionParameterization ex:meanVariance ;
    math:hasDistributionParameter ex:varParam .

ex:gaussianFamily a math:DistributionFamily .
ex:meanVariance a math:DistributionParameterization .

ex:varianceRole a math:DistributionParameterRole ;
    math:quantityDimension math:squareOfRandomVariableDimension .

ex:linearVarianceQuantity a math:Quantity ;
    math:hasDimension math:lengthDimension .

ex:varParam a math:DistributionParameter ;
    math:parameterRole ex:varianceRole ;
    math:parameterQuantity ex:linearVarianceQuantity .
