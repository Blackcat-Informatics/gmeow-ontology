<https://blackcatinformatics.ca/gmeow/slices/observations>
    a gmeow:Slice ;
    rdfs:label "observations"@x-gmeow-english ;
    skos:definition "The observations slice of the GMEOW ontology (core tier): GMEOW Observations Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/observations> ;
    dcterms:title "GMEOW Observations Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceProfile "claims" , "memory" ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/entities> ,
        <https://blackcatinformatics.ca/gmeow/slices/events> ,
