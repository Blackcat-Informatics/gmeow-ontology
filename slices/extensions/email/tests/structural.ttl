PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:mailboxPath a owl:DatatypeProperty ;
        rdfs:domain gmeow:Mailbox ;
        rdfs:range rdfs:Literal .
}""" ;
    gmeow:saRationale """gmeow:mailboxPath MUST be a DatatypeProperty on Mailbox ranging over Literal.""" .

ex:saMailboxTotalMessagesInteger a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:mailboxTotalMessages a owl:DatatypeProperty ;
        rdfs:domain gmeow:Mailbox ;
        rdfs:range xsd:integer .
}""" ;
    gmeow:saRationale """gmeow:mailboxTotalMessages MUST be a DatatypeProperty on Mailbox ranging over xsd:integer.""" .

ex:saMailboxUnreadMessagesInteger a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:mailboxUnreadMessages a owl:DatatypeProperty ;
        rdfs:domain gmeow:Mailbox ;
        rdfs:range xsd:integer .
}""" ;
    gmeow:saRationale """gmeow:mailboxUnreadMessages MUST be a DatatypeProperty on Mailbox ranging over xsd:integer.""" .

ex:saNoSystemMailboxSubclass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:SystemMailbox a owl:Class .
}""" ;
    gmeow:saRationale """System vs user mailbox status MUST be modeled by role, not by a SystemMailbox subclass.""" .

ex:saNoUserMailboxSubclass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:UserMailbox a owl:Class .
}""" ;
    gmeow:saRationale """System vs user mailbox status MUST be modeled by role, not by a UserMailbox subclass.""" .

ex:saNoIsSystemMailboxProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:isSystemMailbox a owl:DatatypeProperty .
}""" ;
    gmeow:saRationale """System mailbox status MUST be modeled by role/lifecycle, not by an isSystemMailbox boolean flag.""" .

ex:saNoIsDestroyedMailboxProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:isDestroyedMailbox a owl:DatatypeProperty .
}""" ;
    gmeow:saRationale """Destroyed mailbox state MUST use the lifecycle event pattern, not an isDestroyedMailbox boolean flag.""" .

ex:saHasMailingListProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasMailingList a owl:ObjectProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range gmeow:MailingList .
    FILTER NOT EXISTS { gmeow:hasMailingList a owl:FunctionalProperty }
}""" ;
    gmeow:saRationale """gmeow:hasMailingList MUST be an ObjectProperty from EmailMessage to MailingList and MUST NOT be functional because cross-posting is possible.""" .

ex:saMailingListUriHeaderProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:listSubscribe a owl:ObjectProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range owl:Thing .
    gmeow:listUnsubscribe a owl:ObjectProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range owl:Thing .
    gmeow:listHelp a owl:ObjectProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range owl:Thing .
    gmeow:listArchive a owl:ObjectProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range owl:Thing .
    FILTER NOT EXISTS { gmeow:listSubscribe a owl:FunctionalProperty }
    FILTER NOT EXISTS { gmeow:listUnsubscribe a owl:FunctionalProperty }
    FILTER NOT EXISTS { gmeow:listHelp a owl:FunctionalProperty }
    FILTER NOT EXISTS { gmeow:listArchive a owl:FunctionalProperty }
}""" ;
    gmeow:saRationale """gmeow:listSubscribe, listUnsubscribe, listHelp, and listArchive MUST be ObjectProperties from EmailMessage to owl:Thing and MUST NOT be functional because multiple URIs may be listed.""" .

ex:saListPostDatatypeProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:listPost a owl:DatatypeProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range rdfs:Literal .
}""" ;
    gmeow:saRationale """gmeow:listPost MUST be a DatatypeProperty on EmailMessage ranging over Literal.""" .

ex:saListOwnerObjectPropertyToEmailAddress a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:listOwner a owl:ObjectProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range gmeow:EmailAddress .
    FILTER NOT EXISTS { gmeow:listOwner a owl:FunctionalProperty }
}""" ;
    gmeow:saRationale """gmeow:listOwner MUST be an ObjectProperty from EmailMessage to EmailAddress and MUST NOT be functional.""" .

ex:saListIdDomainUnchanged a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:listId a owl:DatatypeProperty ;
        rdfs:domain gmeow:Message .
    FILTER NOT EXISTS { gmeow:listId rdfs:domain gmeow:MailingList }
}""" ;
    gmeow:saRationale """gmeow:listId MUST keep Message as its domain and MUST NOT acquire MailingList as an additional domain.""" .

ex:saMailingListAnnotationCompleteness a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
ASK {
    gmeow:MailingList rdfs:label [] ; skos:definition [] ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> .
    gmeow:hasMailingList rdfs:label [] ; skos:definition [] ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> .
    gmeow:listSubscribe rdfs:label [] ; skos:definition [] ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> .
    gmeow:listUnsubscribe rdfs:label [] ; skos:definition [] ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> .
    gmeow:listPost rdfs:label [] ; skos:definition [] ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> .
    gmeow:listHelp rdfs:label [] ; skos:definition [] ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> .
    gmeow:listArchive rdfs:label [] ; skos:definition [] ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> .
    gmeow:listOwner rdfs:label [] ; skos:definition [] ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> .
}""" ;
    gmeow:saRationale """Every new mailing-list term MUST carry rdfs:label, skos:definition, and rdfs:isDefinedBy (Principle 8).""" .

ex:saMessageParticipantClassExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:MessageParticipant a owl:Class , logic:Kind .
}""" ;
    gmeow:saRationale """gmeow:MessageParticipant MUST be declared as an owl:Class (a logic:Kind relator).""" .

ex:saMessageParticipantRoleClassExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:MessageParticipantRole a owl:Class , logic:AbstractIndividualType .
}""" ;
    gmeow:saRationale """gmeow:MessageParticipantRole MUST be declared as an owl:Class (a value vocabulary / AbstractIndividualType).""" .

ex:saMessageParticipantRoleSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:messageRoleFrom a gmeow:MessageParticipantRole .
    gmeow:messageRoleSender a gmeow:MessageParticipantRole .
    gmeow:messageRoleReplyTo a gmeow:MessageParticipantRole .
    gmeow:messageRoleTo a gmeow:MessageParticipantRole .
    gmeow:messageRoleCc a gmeow:MessageParticipantRole .
    gmeow:messageRoleBcc a gmeow:MessageParticipantRole .
    gmeow:messageRoleReturnPath a gmeow:MessageParticipantRole .
    gmeow:messageRoleErrorsTo a gmeow:MessageParticipantRole .
    gmeow:messageRoleEnvelopeFrom a gmeow:MessageParticipantRole .
    gmeow:messageRoleEnvelopeTo a gmeow:MessageParticipantRole .
    gmeow:messageRoleDeliveredTo a gmeow:MessageParticipantRole .
    gmeow:messageRoleOriginalTo a gmeow:MessageParticipantRole .
    gmeow:messageRoleResentFrom a gmeow:MessageParticipantRole .
    gmeow:messageRoleResentTo a gmeow:MessageParticipantRole .
    gmeow:messageRoleResentCc a gmeow:MessageParticipantRole .
}""" ;
    gmeow:saRationale """The fourteen RFC 5322 message participant role seeds MUST be declared.""" .

ex:saParticipantPropertiesDeclared a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:participantMessage a owl:ObjectProperty ;
        rdfs:domain gmeow:MessageParticipant ;
        rdfs:range gmeow:EmailMessage .
    gmeow:participantAddress a owl:ObjectProperty ;
        rdfs:domain gmeow:MessageParticipant ;
        rdfs:range gmeow:EmailAddress .
    gmeow:participantRole a owl:ObjectProperty ;
        rdfs:domain gmeow:MessageParticipant ;
        rdfs:range gmeow:MessageParticipantRole .
    gmeow:participantHeader a owl:ObjectProperty ;
        rdfs:domain gmeow:MessageParticipant ;
        rdfs:range gmeow:MessageHeader .
}""" ;
    gmeow:saRationale """participantMessage, participantAddress, participantRole, and participantHeader MUST be ObjectProperties with domain MessageParticipant and their respective ranges; their functionality is now carried by logic:PropertyCharacteristicAssertions (DL-enforced).""" .

ex:saHasMessageParticipantInverse a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasMessageParticipant a owl:ObjectProperty ;
        owl:inverseOf gmeow:participantMessage ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range gmeow:MessageParticipant .
}""" ;
    gmeow:saRationale """gmeow:hasMessageParticipant MUST be the inverse of participantMessage, domain EmailMessage, range MessageParticipant.""" .

ex:saParticipantOrdinalFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:participantOrdinal a owl:DatatypeProperty ;
        rdfs:domain gmeow:MessageParticipant ;
        rdfs:range xsd:nonNegativeInteger .
}""" ;
    gmeow:saRationale """gmeow:participantOrdinal MUST be a DatatypeProperty on MessageParticipant ranging over xsd:nonNegativeInteger; its functionality is now carried by a logic:PropertyCharacteristicAssertion (DL-enforced).""" .

ex:saDisplayNameScopedToParticipant a gmeow:StructuralAssertion ;
