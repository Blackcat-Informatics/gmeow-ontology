@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/gender>
    a gmeow:Slice ;
    rdfs:label "gender"@x-gmeow-english ;
    skos:definition "The gender slice of the GMEOW ontology (core tier): a respectful, inclusive model of gender identity, gender expression, and the recorded sex-assigned-at-birth datum, built on the shared, reified gmeow:IdentityFacet (a gufo:Relator, the same idiom as names' NameUsage). Governing tenets: ADDRESS ≠ IDENTITY (pronouns/honorifics live in names and carry no bridge to gender), SEX ≠ GENDER (sex-assigned-at-birth is a recorded administrative datum, never an IdentityFacet), SELF-ASSERTION is the top authority, CO-EQUALITY with no preferred/primary gender and suppression-not-deletion (gmeow:displayable false) for superseded labels, and INCLUSIVE-WITHOUT-OVERTYPING (gender, expression-style, and sex-assigned-at-birth are OPEN value vocabularies of individuals, never Person subclasses). Identity is a facet that may be fuzzy or determinacy-bearing (kernel gmeow:hasDeterminacy) and is SENSITIVE personal data, so the disclosure machinery (gmeow:hasSensitivity, coarsen/withhold) applies. Aligns lossily to GSSO, Homosaurus, schema.org, Wikidata, FOAF and HL7/FHIR; the reified self-asserted co-equal machinery is canonical. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gender> ;
    dcterms:title "GMEOW Gender Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/entities> ,
        <https://blackcatinformatics.ca/gmeow/slices/names> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/sexuality> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:sliceConsumer "Identity facets on persons (P16: core by commitment); the 7-axis orthogonality matrix."@x-gmeow-english .
