#
# Positive fixture: the application's unique slot indexes are exactly 0, 1, 2.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:contiguousApplication a math:ApplicationExpression ;
    math:operator math:Addition ;
    math:argumentSlot ex:contiguousSlot0 , ex:contiguousSlot1 , ex:contiguousSlot2 .

ex:contiguousSlot0 a math:ArgumentSlot ; math:slotIndex 0 ; math:slotExpression ex:operand0 .
ex:contiguousSlot1 a math:ArgumentSlot ; math:slotIndex 1 ; math:slotExpression ex:operand1 .
ex:contiguousSlot2 a math:ArgumentSlot ; math:slotIndex 2 ; math:slotExpression ex:operand2 .
# Three operands named but not decomposed. The honest AST leaf for that is a
# math:SymbolReference resolving to a SYMBOL, which is real content; the abstract
# math:MathematicalExpression base names no concrete form and so carries no structural
# identity at all (math:UnrecognizedExpressionType).
ex:operand0 a math:SymbolReference ; math:hasMathematicalSymbol ex:operandSymbol0 .
ex:operand1 a math:SymbolReference ; math:hasMathematicalSymbol ex:operandSymbol1 .
ex:operand2 a math:SymbolReference ; math:hasMathematicalSymbol ex:operandSymbol2 .
ex:operandSymbol0 a math:MathematicalSymbol .
ex:operandSymbol1 a math:MathematicalSymbol .
ex:operandSymbol2 a math:MathematicalSymbol .
