gmeow:partOf skos:closeMatch bfo:BFO_0000050 {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "part of" ;
    gmeow:comment "BFO continuant/occurrent parthood is the OBO hub; GMEOW partOf is a broader universal spine across modules"
|} .

gmeow:hasPart skos:closeMatch bfo:BFO_0000051 {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "has part" ;
    gmeow:comment "BFO has-part is the OBO hub; GMEOW hasPart is broader and keeps specialized subproperties for precise semantics"
|} .

gmeow:partOf skos:closeMatch gufo:isComponentOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.65 ;
    gmeow:comment "gUFO component parthood is endurant/component-specific and not generally transitive; GMEOW partOf is broader"
|} .

gmeow:partOf skos:closeMatch gufo:isCollectionMemberOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "gUFO collection membership is intransitive member-to-collection parthood; a narrower case of the GMEOW universal spine"
|} .

gmeow:partOf skos:closeMatch gufo:isSubCollectionOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "gUFO subcollection parthood is collection-specific; GMEOW partOf is the broader cross-module spine"
|} .

gmeow:partOf skos:closeMatch gufo:TemporaryParthoodSituation {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "Intentional cross-category closeMatch: gUFO's TemporaryParthoodSituation class is the reified reference pattern for mutable endurant parthood; GMEOW partOf remains the flat property shortcut, not an OWL property equivalence"
|} .

gmeow:partOf skos:closeMatch schema:isPartOf {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

