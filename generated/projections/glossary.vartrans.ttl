    a ontolex:Form ;
    ontolex:writtenRep "masse de crédibilité"@fr .

<http://example.org/lang/glossary-vartrans/form-tgt/f5fa530d2ae3fc7d>
    a ontolex:Form ;
    ontolex:writtenRep "plancher d'honnêteté de provenance — Ancré"@fr .

