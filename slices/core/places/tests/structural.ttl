    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:NetworkAddressType rdfs:subClassOf logic:QualityValue . }""" ;
    gmeow:saRationale "gmeow:NetworkAddressType MUST be a subclass of logic:QualityValue." .

