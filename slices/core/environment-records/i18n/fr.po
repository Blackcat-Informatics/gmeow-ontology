msgctxt "https://blackcatinformatics.ca/gmeow/FulfillmentConditionCoverageConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "fulfillment condition coverage"
msgstr "couverture des conditions de réalisation"

msgctxt "https://blackcatinformatics.ca/gmeow/FulfillmentConditionCoverageConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A fulfillment report claims each condition stated on its exact request revision. This covers the supplied criterion inventory, not unrecorded or globally complete requirements."
msgstr "Un rapport de réalisation déclare chaque condition énoncée sur sa révision exacte de demande satisfaite. Cela couvre l’inventaire de critères fourni, pas des exigences non consignées ou globalement complètes."

msgctxt "https://blackcatinformatics.ca/gmeow/FulfillmentConditionCoverageConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to check intrinsic consistency within the declared source scope."
msgstr "Utiliser pour contrôler la cohérence intrinsèque dans le périmètre source déclaré."

msgctxt "https://blackcatinformatics.ca/gmeow/FulfillmentConditionCoverageConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
