gmeow:gtsProducerDocsMeasure
    a gmeow:GtsProducer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "GTS producer — the docs byte measurement"@x-gmeow-english ;
    skos:definition "The docs-distribution byte measurement, which emits candidate bundles solely to weigh them. Its bytes are never shipped — but it is still a production authorship site, and a producer whose output is discarded is exactly the kind of site an exemption list would quietly swallow, so it declares its medium like any other."@x-gmeow-english ;
    gmeow:producerCallSite "crates/pipeline/src/docs_measure.rs" ;
