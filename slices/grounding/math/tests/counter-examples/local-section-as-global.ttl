#
# Counter-example for math:MisscopedSection: a section typed math:GlobalSection whose
# math:sectionRegion is a PROPER subcomplex (ex:subregion) rather than the whole
# math:sheafBaseComplex (ex:base) of its math:overSheaf, so the cross-node equality
# constraint math:MisscopedSectionConstraint fires and validation MUST emit
# shacl.SPARQLConstraintComponent (and no other finding). The sheaf is complete and
# the section names both math:overSheaf and math:sectionRegion, so the sheaf frame and
# the math:IncompleteGlobalSection frame are satisfied — the wrong scope is isolated.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/gluing/> .

ex:sheaf a math:CellularSheaf ;
    math:sheafBaseComplex ex:base ;
    math:hasStalk ex:vertexStalk , ex:edgeStalk ;
    math:restrictionMap ex:vertexToEdge .
ex:base a math:CellComplex .
ex:subregion a math:CellComplex .

ex:vertexStalk a math:SheafStalk ; math:stalkOverCell ex:vertex .
ex:edgeStalk a math:SheafStalk ; math:stalkOverCell ex:edge .
ex:vertexToEdge a math:SheafRestrictionMap ;
    math:sourceObject ex:vertexStalk ;
    math:targetObject ex:edgeStalk .

# Typed global, but scoped to a proper subcomplex — misscoped.
ex:globalSection a math:GlobalSection ;
    math:overSheaf ex:sheaf ;
    math:sectionRegion ex:subregion .

ex:vertex a math:MathematicalObject .
ex:edge a math:MathematicalObject .
