@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gmeow-goemotions: <https://blackcatinformatics.ca/gmeow-registry/goemotions/> .
@prefix gmeow-hf: <https://blackcatinformatics.ca/gmeow-registry/hf/> .
@prefix gmeow-labelset: <https://blackcatinformatics.ca/gmeow-registry/labelset/> .

gmeow:AestheticQuality
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Aesthetic Quality"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "A qualitative aesthetic reading — an OPEN vocabulary seeded with elegance, sublimity, kitsch. No AestheticQuality hierarchy exists or ever will (Principle 9): aesthetic traditions disagree about the inventory, and that disagreement is data."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AffectiveExperience
    a logic:Event ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affective Experience"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Experience ,
        [ a owl:Restriction ;
            owl:onProperty gmeow:mentalProcessType ;
            owl:hasValue gmeow:processAffectiveExperience ] ;
    skos:definition "The phenomenally-conscious felt affective episode — the OCCURRENT (perdurant) of undergoing an affective state, an episode there is something it is like to feel. A subset of mentation's gmeow:Experience whose kind is pinned to gmeow:processAffectiveExperience by an owl:hasValue restriction (the gmeow:DreamReport idiom: a restriction-pinned queryable handle, NOT overtyping — the kind still lives in the gmeow:mentalProcessType value, Principle 9). Distinct from the ENDURANT gmeow:Emotion mode it realizes via gmeow:feltAffect: an agent can bear an emotion mode without currently feeling it, and one felt episode can realize it. Inherits gmeow:experiencer and gmeow:mentalProcessType from gmeow:MentalProcess — the occurrent side of the mode/experience cut."@x-gmeow-english ;
    skos:example "ex:feltAnger a gmeow:AffectiveExperience ; gmeow:experiencer ex:agent ; gmeow:feltAffect ex:angerMode ."@x-gmeow-english ;
    skos:scopeNote "The OCCURRENT face of affect (a perdurant gmeow:Experience), never the endurant gmeow:Emotion mode (a gmeow:AffectiveMoment ⊑ gmeow:MentalMoment) it realizes via gmeow:feltAffect. Modes are logic:Mode, experiences are logic:Event — the foundation's logic:Endurant/logic:Perdurant disjointness keeps them apart, so a MentalMoment can never be an occurrent."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid it for the ENDURING affective mode itself (that is gmeow:Emotion, a gmeow:AffectiveMoment ⊑ gmeow:MentalMoment — an endurant, never an occurrent) and for sub-personal affective processing carrying no first-person character (type plain gmeow:MentalProcess with the process type)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the felt episode gmeow:AffectiveExperience (it carries gmeow:mentalProcessType gmeow:processAffectiveExperience by the pinned restriction), bind its bearer with gmeow:experiencer, and link the affective mode it manifests with gmeow:feltAffect (an affect-scoped refinement of mentation's gmeow:realizesMentalMoment)."@x-gmeow-english ;
    gmeow:useWhen "Use for the occurrent, phenomenal episode of feeling — 'I felt angry for five minutes' — distinct from the enduring gmeow:Emotion mode it realizes, so an agent's felt mental life is a first-class, queryable event on the mental timeline."@x-gmeow-english .

gmeow:AffectiveMoment
    a logic:Category ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affective Moment"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Entity ,
        gmeow:MentalMoment ;
    skos:definition "The abstract affective member of the kernel gmeow:MentalMoment family (alongside cognition's gmeow:CognitiveState, epistemics' doxastic states, and teleology's gmeow:IntentionalMode) — intrinsic affective modes inhering in one agent, so an agent's whole mental life, including what it feels, is queryable as one family (Principles 14, 15). Never instantiated directly: instances are Emotions (the fuller model specifies Moods and affective dispositions)."@x-gmeow-english ;
    skos:example "ex:awe a gmeow:Emotion ; gmeow:emotionBearer ex:reader .  # an AffectiveMoment by inheritance"@x-gmeow-english ;
    skos:scopeNote "The affective branch of gmeow:MentalMoment; groups the affective MODES (endurants). NOT the occurrent felt episode — that is the perdurant gmeow:AffectiveExperience (under mentation's gmeow:Experience), which realizes such a mode via gmeow:feltAffect."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid instantiating it directly (type the specific mode — an Emotion, and later a Mood or affective disposition); and avoid it for the occurrent felt EPISODE, which is gmeow:AffectiveExperience (a perdurant), not a MentalMoment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Subclass the concrete affective mode (gmeow:Emotion, later gmeow:Mood) under it, so one agent-memory query over gmeow:MentalMoment returns an agent's feelings alongside its knowings, beliefs, and intentions."@x-gmeow-english ;
    gmeow:useWhen "Use as the shared parent for an agent's affective modes, or to query the whole affective branch of an agent's mental life as one family (Principles 14, 15)."@x-gmeow-english .

gmeow:Appraisal
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Appraisal"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ;
    skos:definition "An affective or aesthetic reading of something, as an observation: vantage = the appraiser. Dimensional (PAD: a valence/arousal/dominance value) or qualitative (an aesthetic quality: elegance, sublimity, kitsch) — at least one of the two forms (SHACL). Two critics disagreeing are two coexisting cells; self-report is top authority for the subject's own standpoint (Principle 9, the facetVantage precedent)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AppraisalDimension
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Appraisal Dimension"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "A dimensional axis of affective appraisal — an OPEN vocabulary seeded with the PAD triad: valence (pleasant ↔ unpleasant), arousal (activated ↔ calm), dominance (in control ↔ controlled)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AffectScaleProfile
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affect Scale Profile"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "The declared reference frame a numeric affect reading is expressed against: its range (gmeow:profileRangeMin/gmeow:profileRangeMax), midpoint (gmeow:profileMidpoint), polarity (gmeow:profilePolarity — bipolar/unipolar), and normalization transform (gmeow:profileTransform). A magnitude on an affect axis is meaningless without one (Principle 11: a value asserted without its frame is ill-formed). Scale arithmetic — normalization, cross-scale conversion, and the metric under which magnitudes combine into an intensity — is solver work outside the logic (Principle 12); the profile DECLARES the frame, it does not compute in triples. The affect-domain analogue of the rubrics facility's gmeow:ScoreScale, minted here because affect is core and cannot depend on the norms extension."@x-gmeow-english ;
    skos:example "ex:padUnitScale a gmeow:AffectScaleProfile ; gmeow:profileRangeMin -1.0 ; gmeow:profileRangeMax 1.0 ; gmeow:profileMidpoint 0.0 ; gmeow:profilePolarity gmeow:polarityBipolar ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid encoding normalization or cross-scale conversion arithmetic in triples (that is solver work — Principle 12), and avoid a bare numeric reading with no profile — an unframed magnitude is ill-formed, not a default."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint the profile with gmeow:profileRangeMin / gmeow:profileRangeMax (and gmeow:profileMidpoint / gmeow:profilePolarity / gmeow:profileTransform as the tradition declares), then bind every gmeow:appraisalValue to it via gmeow:appraisalScaleProfile and name a vector reading's basis via gmeow:vectorProfile."@x-gmeow-english ;
    gmeow:useWhen "Use to declare the scale/frame a numeric affect magnitude is read against — range, midpoint, polarity, and normalization transform — so a reading carries its own interpretation."@x-gmeow-english .

gmeow:CoreAffectDimension
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Core-Affect Dimension"@x-gmeow-english ;
    rdfs:subClassOf gmeow:AppraisalDimension ;
    skos:definition "The experiential (felt-quality) axes of affect — the low-dimensional, continuous core-affect basis present even in objectless mood: valence, arousal, dominance, and unpredictability. A distinguished subset of the open gmeow:AppraisalDimension vocabulary (⊑, so every core-affect axis is an appraisal dimension), typed distinctly from the cognitive-relational appraisal axes (novelty, goal-relevance, agency, …) that GENERATE and DIFFERENTIATE emotions sharing the same core affect. Both families are also tagged by gmeow:dimensionFamily; the type and the tag are complementary, and the axis vocabulary as a whole stays open and contested (Principle 9)."@x-gmeow-english ;
    skos:scopeNote "The felt-quality family; conflating it with the cognitive appraisal axes is the usual modeling error and separating them is the point. Core-affect axes are the direction of the felt state; appraisal axes are what the mind computed about the eliciting situation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:DimensionFamily
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Dimension Family"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An OPEN value vocabulary grouping affect axes into families — seeded with core-affect (the felt-quality axes) and appraisal (the cognitive-relational axes). A tag on gmeow:AppraisalDimension via gmeow:dimensionFamily that groups the seed basis WITHOUT closing the axis set (Principle 9): PAD, OCC, Scherer's component-process axes, and Plutchik's wheel are different bases of one landscape, and their disagreement is data."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ScalePolarity
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Scale Polarity"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An OPEN value vocabulary for the polarity of an affect scale — seeded with bipolar (a signed axis with a neutral midpoint, e.g. valence −1…1) and unipolar (a one-sided magnitude, e.g. arousal 0…1). Kept open, never an sh:in enum: a closed set anywhere in canonical affect is a projection artifact only."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AffectComposite
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affect Composite"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Emotion ;
    skos:definition "A named emotion whose meaning is given by a DECLARED composition — a core-affect vector bound by relations to its elicitor, target, agency attribution, norm, and, where relevant, other emotions — rather than left as an unanalyzed primitive. GMEOW models up: schadenfreude and saudade are structure over the foundational axes and relations, not new primitive EmotionTypes. A composite MUST carry its decomposition via gmeow:affectiveConstituent (SHACL); if a quality cannot be decomposed into the current axes, that is evidence the axis basis is incomplete (add an axis), never a licence for an opaque primitive."@x-gmeow-english ;
    skos:example "ex:schadenfreude a gmeow:AffectComposite ; gmeow:emotionBearer ex:agent ; gmeow:affectiveConstituent ex:positiveCoreVector , ex:otherMisfortuneElicited ."@x-gmeow-english ;
    skos:scopeNote "A named region/composite in the affect landscape (⊑ gmeow:Emotion, so it inherits the mode/bearer/target/elicitor surface). The composite layer stays analysable; the expressive power stays total."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid it for an unanalyzed primitive feeling (mint no opaque emotionX — either decompose it here or add the missing axis) and for the felt EPISODE (that is gmeow:AffectiveExperience)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the named compound gmeow:AffectComposite, bind its bearer, and declare its decomposition with gmeow:affectiveConstituent — a gmeow:AffectVectorObservation for the core-affect signature plus the elicitor/target/agency/norm relations that differentiate it."@x-gmeow-english ;
    gmeow:useWhen "Use for a culturally salient named affect (schadenfreude, saudade) minted for developer utility and mapping ONLY when it carries its declared decomposition links."@x-gmeow-english .

gmeow:AffectEvaluationConcluded
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affect Evaluation Concluded"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ;
    skos:definition "A positive, queryable record that affect WAS checked over a target and found flat — zero active dimension magnitudes — distinct from no check ever having run. Rejecting a 'neutral' EmotionType (the evidence-spine hard-fail) preserves open-world integrity but must not blind the agent: downstream logic genuinely needs to tell 'a check ran and found a flat baseline' from 'no evaluation'. An Observation (vantage = who concluded it, observedFeature = the target), never an emotion or an EmotionType."@x-gmeow-english ;
    skos:example "ex:concluded a gmeow:AffectEvaluationConcluded ; gmeow:vantage ex:classifier ; gmeow:observedFeature ex:chunk ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid it to assert that NO affect exists (open-world: a flat check is not proof of absence) and avoid modeling it as a 'neutral' EmotionType (that is a hard fail)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Record it as an Observation over the checked target when an affect evaluation ran and returned no salient magnitude, so 'concluded flat' is a fact separate from 'never checked'."@x-gmeow-english ;
    gmeow:useWhen "Use to record that an affect check ran and found a flat baseline — the checked-and-flat state, never conflated with the absence of any evaluation."@x-gmeow-english .

gmeow:AffectDecision
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affect Decision"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ,
        [ a owl:Restriction ;
            owl:onProperty gmeow:decidedLabel ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass owl:Thing ] ,
        [ a owl:Restriction ;
            owl:onProperty gmeow:decisionCrossedThreshold ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass owl:Thing ] ,
        [ a owl:Restriction ;
            owl:onProperty gmeow:observedFeature ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass owl:Thing ] ,
        [ a owl:Restriction ;
            owl:onProperty gmeow:vantage ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass owl:Thing ] ,
        [ a owl:Restriction ;
            owl:onProperty gmeow:derivedByFunction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass owl:Thing ] ;
    skos:definition "A single-label classifier's categorical decision over one target — the argmax (gmeow:decidedLabel) recorded as model-vantage EVIDENCE (gmeow:vantage = the run, gmeow:observedFeature = the target), derived by gmeow:fnArgmax over a gmeow:decisionArgmax label set. A fact about the CLASSIFIER'S OUTPUT over external gmeow:AffectClassifierLabel identities, NEVER a gmeow:AffectiveClaim about inner affect and never a gmeow:EmotionType — so it needs no reviewed closeMatch and is recorded even when the argmax falls BELOW the claim threshold (gmeow:decisionCrossedThreshold false). This preserves the model's decision faithfully (maximal information flow) without forcing a claim (the evidence/claim boundary, Principle 9). Only a gmeow:decisionArgmax set carries one: a multi-label set has no single categorical winner. Supersedes gmeow:AffectEvaluationConcluded for single-label sets — a decided winner, even a low-margin one, is the positive 'checked' fact, never silence."@x-gmeow-english ;
    skos:example "ex:decision a gmeow:AffectDecision ; gmeow:vantage ex:run ; gmeow:observedFeature ex:chunk ; gmeow:decidedLabel gmeow-hf:ekmanJoy ; gmeow:decisionCrossedThreshold false ; gmeow:decisionMargin 0.07 ; gmeow:derivedByFunction gmeow:fnArgmax ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting it for a multi-label (gmeow:decisionIndependentThreshold) set (there is no single argmax winner), avoid treating it as a gmeow:AffectiveClaim about inner affect (it is classifier-output evidence over an external label), and avoid asserting a gmeow:decisionMargin when the run emitted a single top-1 score (no runner-up exists)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "For a gmeow:decisionArgmax label set, mint one gmeow:AffectDecision per (run, target): gmeow:vantage the run, gmeow:observedFeature the target, gmeow:decidedLabel the argmax label, gmeow:decisionCrossedThreshold whether it crossed the claim threshold, gmeow:derivedByFunction gmeow:fnArgmax, and gmeow:decisionMargin (top1−top2) only when ≥2 scores are present."@x-gmeow-english ;
    gmeow:useWhen "Use to record a single-label classifier's argmax decision as faithful evidence over a target — including the below-threshold case where the model decided but no claim is routed."@x-gmeow-english .

gmeow:AffectFunction
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affect Function"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An OPEN value vocabulary naming the canonical derived-affect functions the gmeow CLI exposes — seeded with gmeow:fnAffectiveIntensity (the vector norm under a declared metric). A function is a NAMED HANDLE for a computation carried out outside the logic (Principle 12); the function individual declares which derivation was applied, it does not compute in triples."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:WeightingPolicy
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Weighting Policy"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An OPEN value vocabulary naming the declared axis-weighting policy under which a derived affect intensity combines its core-affect axes — seeded with gmeow:weightingEqualCoreAffect (equal-weight axes) and gmeow:weightingValenceDominant (valence-dominant diagonal weights). Weighting is a machine-readable NAMED HANDLE, never a free-text string: applying it is solver work outside the logic (Principle 12), and the individual declares which policy the diagonal/off-diagonal weights of the metric Gram matrix realize. Kept open, never an sh:in enum."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:LabelSetDecisionRule
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Label Set Decision Rule"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An OPEN value vocabulary naming the decision structure a gmeow:AffectLabelSet carries — how a classifier turns its scores over the set into a decision. gmeow:decisionArgmax is single-label / winner-take-all: the members form a PARTITION (mutually exclusive and exhaustive), a softmax score is a point on the probability simplex, and the decision is its argmax (the categorical mode) — exactly one label. gmeow:decisionIndependentThreshold is multi-label: per-label independent Bernoulli thresholding over the [0,1] hypercube, zero-or-more labels. This is the formal dual of gmeow:ScoreSemantics (softmax ↔ argmax/exclusive, sigmoid ↔ independent-threshold), machine-coupled by gmeow:impliesLabelSetDecision so a scoring function and its set's decision rule can never silently disagree. Kept open, never an sh:in enum."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:AffectVectorObservation
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affect Vector Observation"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ;
    skos:definition "The stable, queryable identity for 'the vector reading' — a reified multidimensional assessment (the same idiom as logic:GoalEvaluation / logic:AgencyAssessment) grouping the per-axis gmeow:Appraisal cells that share vantage, target, elicitor, and time, and naming its metric/basis via gmeow:vectorProfile. One cell per axis is preserved (gmeow:vectorComponent → each dimensional Appraisal); the grouping is the handle that makes the vector citable, signable, suppressible, and projectable as a unit. Overall intensity and cross-basis coordinates are DERIVED views over this record, never stored cells (Principle 12)."@x-gmeow-english ;
    skos:example "ex:vec a gmeow:AffectVectorObservation ; gmeow:vantage ex:agent ; gmeow:vectorProfile ex:padUnitScale ; gmeow:vectorComponent ex:valenceCell , ex:arousalCell ."@x-gmeow-english ;
    skos:scopeNote "A reified assessment whose per-axis components decompose the canonical factored axes; its coarse emotion labels are generated projections. NOT a stored intensity — the norm is a derived gmeow:DerivedAffectIntensityObservation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid materialising a dense high-frequency stream as vector observations (that is a gmeow:AffectTelemetryStream dense block by-reference) and avoid storing the norm as a component cell (it is derived)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint the vector observation, name its basis with gmeow:vectorProfile, and attach one dimensional gmeow:Appraisal per axis via gmeow:vectorComponent; share vantage/target/elicitor/time across the cells."@x-gmeow-english ;
    gmeow:useWhen "Use to give a multi-axis affect reading one queryable identity — the stable handle for the vector, distinct from its per-axis cells and from any derived intensity."@x-gmeow-english .

gmeow:DerivedAffectIntensityObservation
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Derived Affect Intensity Observation"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ;
    skos:definition "Overall affect intensity as a DERIVED view — the norm of a gmeow:AffectVectorObservation computed OUTSIDE the logic under a declared metric (Principle 12), never a separately stored ground fact. Because the axis basis is non-orthogonal (valence correlates with goal-congruence, dominance overlaps coping), a raw Euclidean L² norm is NOT the default: the metric is an explicit declared weighted / metric-tensor form. An intensity record MUST declare its basis (gmeow:intensityBasis), scale normalization (gmeow:metricProfile), weighting policy (gmeow:weightingPolicy), and norm/distance function (gmeow:normFunction) — any missing declaration is a hard fail. No intensity is canonical without that named basis."@x-gmeow-english ;
    skos:example "ex:intensity a gmeow:DerivedAffectIntensityObservation ; gmeow:intensityBasis ex:vec ; gmeow:metricProfile gmeow:coreAffectMetricPAD ; gmeow:weightingPolicy gmeow:weightingEqualCoreAffect ; gmeow:normFunction gmeow:affectMetricTensorNorm ; gmeow:derivedByFunction gmeow:fnAffectiveIntensity ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid storing it as a canonical ground fact (it is a recomputable view), avoid a bare L² norm over the non-orthogonal basis, and avoid omitting any of basis / scale / weighting / norm (each omission is a hard fail)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Compute the norm externally, then record it as a gmeow:DerivedAffectIntensityObservation declaring gmeow:intensityBasis, gmeow:metricProfile, gmeow:weightingPolicy, and gmeow:normFunction (and gmeow:derivedByFunction gmeow:fnAffectiveIntensity for the CLI handle)."@x-gmeow-english ;
    gmeow:useWhen "Use to expose overall intensity (the vector norm) to the CLI as a derived observation under a named metric — the answer to 'how intense, and along which dominant axis?'."@x-gmeow-english .

gmeow:AffectClassifierLabel
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affect Classifier Label"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "The exact, lossless external identity of a label emitted by a classifier or dataset label set (GoEmotions joy, SST-2 NEGATIVE, CardiffNLP Positive). An information artifact, NEVER a gmeow:EmotionType: labels live under their own per-registry authority (gmeow-goemotions:, gmeow-hf:) so a model label can never be mistaken for a canonical emotion. 'NEG', 'Negative', 'LABEL_0' are distinct identities until a reviewed correspondence maps them (Principle 5). The reviewed skos:closeMatch/exactMatch link to a canonical GMEOW term is a generated correspondence lowering, authored separately."@x-gmeow-english ;
    skos:example "gmeow-goemotions:joy a gmeow:AffectClassifierLabel ; gmeow:memberOfLabelSet gmeow-labelset:GoEmotions ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid typing a classifier label as a gmeow:EmotionType (that is a category error, and 'neutral' as an EmotionType is a hard fail) and avoid asserting an unreviewed exactMatch to a canonical term (closeMatch by default)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Register each external label as a gmeow:AffectClassifierLabel individual under its per-registry prefix, bind it to its gmeow:AffectLabelSet via gmeow:memberOfLabelSet, and map it to canonical GMEOW terms only through a reviewed correspondence lowering."@x-gmeow-english ;
    gmeow:useWhen "Use to register the exact identity of an external classifier/dataset label, preserved losslessly and kept distinct from canonical GMEOW emotion vocabulary."@x-gmeow-english .

gmeow:AffectClassifierOutput
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affect Classifier Output"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ;
    skos:definition "One emitted model output over one target span — a model-vantage gmeow:Observation carrying the emitted label (gmeow:emittedLabel), raw score (gmeow:classifierScore), score semantics (gmeow:scoreSemantics), and threshold (gmeow:thresholdApplied), produced by a gmeow:ModelInferenceRun (gmeow:producedBy). It is EVIDENCE, not the human-level claim and not an inner-state truth: 'this model, at this revision, over this span, emitted this label with this score under this label set'. A raw sigmoid/softmax score is logic:evidenceStrength/probability under declared calibration, NEVER logic:confidence. It supports a gmeow:AffectiveClaim by gmeow:supportsAffectiveClaim (an evidence link, never entailment)."@x-gmeow-english ;
    skos:example "ex:out a gmeow:AffectClassifierOutput ; gmeow:producedBy ex:run ; gmeow:emittedLabel gmeow-goemotions:joy ; gmeow:classifierScore 0.84 ; gmeow:scoreSemantics gmeow:scoreSigmoid ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting an inner affect directly from an output (it must support a gmeow:AffectiveClaim, never entail one) and avoid storing its score as logic:confidence without calibration metadata (a raw score is not a calibrated probability — a hard fail)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Record each model output as a gmeow:AffectClassifierOutput linked to its gmeow:ModelInferenceRun (gmeow:producedBy), its target (gmeow:classifiedTarget), its emitted label, raw score, and score semantics; link it to a richer claim via gmeow:supportsAffectiveClaim."@x-gmeow-english ;
    gmeow:useWhen "Use for one classifier output over one target — attributed model evidence with score and provenance, never a privileged truth about inner affect."@x-gmeow-english .

gmeow:AffectLabelSet
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affect Label Set"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "A named label vocabulary/registry that a classifier or dataset emits over (GoEmotions, Ekman-7, SST-2, CardiffNLP TweetEval). Its members are gmeow:AffectClassifierLabel individuals (gmeow:memberOfLabelSet). An information artifact: a label set is NOT an ontology of emotion and never defines canonical affect semantics. A Hugging Face label not registered in some gmeow:AffectLabelSet fails canonical projection (a hard fail). A REGISTERED (static) label set MUST declare its gmeow:labelSetDecision (single-label vs multi-label) — the producer hard-fails a registered set with no rule. A run-scoped zero-shot candidate set is minted per run and carries NO reviewed decision rule (it is legitimately rule-less), so the requirement is a producer-enforced invariant on registered sets, not a universal cardinality that would wrongly flag the minted candidate set."@x-gmeow-english ;
    skos:example "gmeow-labelset:GoEmotions a gmeow:AffectLabelSet ; rdfs:label \"GoEmotions\"@en ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a label set as a canonical emotion taxonomy (it is evidence provenance, not ontology) and avoid emitting a label with no registered set (unregistered labels fail projection)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint the label set, then register each of its labels as a gmeow:AffectClassifierLabel with gmeow:memberOfLabelSet pointing back at it."@x-gmeow-english ;
    gmeow:useWhen "Use to name a classifier/dataset label vocabulary whose members are external label identities."@x-gmeow-english .

gmeow:AffectTelemetryStream
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affect Telemetry Stream"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Stream ;
    skos:definition "The parent for high-frequency affective evidence — per-frame facial cues, voice latency, heart rate — whose dense time-series block is held by-reference (gmeow:telemetryBlob, a content-address digest + origin), NEVER materialised as ten-plus Appraisal triples per frame (that craters the triple store and violates the blob-by-reference doctrine). A gmeow:Stream (reused, not re-minted). Aggregating the dense block up into queryable gmeow:AffectVectorObservation cell bundles is a computation (Principle 12) whose provenance points back at the block; individual cell bundles are reserved for the moments a consumer actually queries (macro state changes, narrative checkpoints, explicit self-reports)."@x-gmeow-english ;
    skos:example "ex:stream a gmeow:AffectTelemetryStream ; gmeow:streamOf ex:agent ; gmeow:telemetryBlob \"sha256:…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid materialising per-frame telemetry as Appraisal triples (a triple storm — use the by-reference block) and avoid inlining the dense payload (it is held by digest + origin, never as bytes in the graph)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint the stream (gmeow:streamOf its subject), hold the dense time-series block by-reference with gmeow:telemetryBlob, and aggregate up into gmeow:AffectVectorObservation cell bundles only at the moments a consumer queries."@x-gmeow-english ;
    gmeow:useWhen "Use as the parent for continuous physiological/vocal affect ingest, keeping the dense block out of the triple store."@x-gmeow-english .

gmeow:AffectiveClaim
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affective Claim"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ;
    skos:definition "A richer GMEOW affect claim SUPPORTED BY evidence — a classifier output, an expression observation, or a self-report — with its own vantage and standpoint. The evidence/claim boundary made explicit (Principle 9): a classifier output that directly asserts someone's inner affect WITHOUT this claim boundary is a hard fail. Self-report outranks third-party attribution for the subject's own standpoint but does not delete the attributed claim; both coexist. The text-expresses-joy / speaker-reports-joy / speaker-likely-felt-joy / reader-appraised-joyful readings are SEPARATE claims, never collapsed."@x-gmeow-english ;
    skos:example "ex:claim a gmeow:AffectiveClaim ; gmeow:vantage ex:analyst ; gmeow:observedFeature ex:author ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid collapsing the distinct claim templates (expresses / reports / felt / appraised) into one and avoid deleting a superseded claim (suppress/close it — both standpoints stay queryable)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint the claim with its vantage and target, and link the evidence that supports it via the inverse of gmeow:supportsAffectiveClaim from each gmeow:AffectClassifierOutput / expression / self-report."@x-gmeow-english ;
    gmeow:useWhen "Use for a human-level affective claim distinct from its evidence — the thing evidence SUPPORTS, never the raw model output itself."@x-gmeow-english .

gmeow:AffectiveExpression
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Affective Expression"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Observation ;
    skos:definition "An observation of an observable expression — a facial expression, word choice, vocal tremor, emoji, posture, latency spike — that EVIDENCES an affective claim but never entails the state itself (Principle: expression is evidence, not the emotion). 'She looked angry' is an expression observation plus an optional low-authority attributed claim, not a direct emotion fact. Kept in the evidence spine so a facial-expression record never entails an inner state."@x-gmeow-english ;
    skos:example "ex:frown a gmeow:AffectiveExpression ; gmeow:vantage ex:observer ; gmeow:observedFeature ex:subject ; gmeow:supportsAffectiveClaim ex:claim ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid letting an expression entail an emotion (it only supports a claim) and avoid conflating the expression with the felt gmeow:AffectiveExperience or the enduring gmeow:Emotion mode."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Record the observed expression as a gmeow:AffectiveExpression with its vantage and subject, and link it to the claim it supports via gmeow:supportsAffectiveClaim."@x-gmeow-english ;
    gmeow:useWhen "Use for an observable expression/signal offered as evidence for an affective claim, never as the emotion itself."@x-gmeow-english .

gmeow:ModelInferenceRun
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Model Inference Run"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Entity ;
    skos:definition "One execution of a classifier over an input — a PROV-O-aligned activity (prov:Activity by generated correspondence) carrying its full run provenance: a pinned model id (gmeow:modelIdentifier) and MANDATORY revision (gmeow:modelRevision), model framework/task, tokenizer + label-set revisions, the id2label mapping, activation/functionToApply, topK/returnAllScores, threshold policy, and a calibration profile whenever a score is claimed as a probability. A model name without a pinned revision fails reproducibility (a hard fail). Its outputs are gmeow:AffectClassifierOutput observations (gmeow:producedBy)."@x-gmeow-english ;
    skos:example "ex:run a gmeow:ModelInferenceRun ; gmeow:modelIdentifier \"SamLowe/roberta-base-go_emotions\" ; gmeow:modelRevision \"a1b2c3d\" ; gmeow:usedInput ex:chunk ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid recording a run without a pinned gmeow:modelRevision (unreproducible — a hard fail) and avoid treating the run's outputs as inner-state truth (they are attributed evidence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Record the run with its pinned model id + revision and full framework/task/tokenizer/label-set provenance, link its input via gmeow:usedInput, and attach each emitted output via gmeow:producedBy."@x-gmeow-english ;
    gmeow:useWhen "Use for one classifier execution over an input — the provenance-bearing activity whose outputs are attributed affect evidence."@x-gmeow-english .

gmeow:ScoreSemantics
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Score Semantics"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An OPEN value vocabulary for what a classifier score MEANS — seeded with sigmoid score, softmax probability, calibrated probability, logit, and margin. Mandatory on every gmeow:AffectClassifierOutput: a raw sigmoid/softmax score is logic:evidenceStrength/probability, and only a CALIBRATED probability may be read as a confidence (Principle 9/17: confidence ≠ probability without a declared mapping). Kept open, never an sh:in enum."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Emotion
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Emotion"@x-gmeow-english ;
    rdfs:subClassOf gmeow:AffectiveMoment ;
    skos:definition "An emotion as an intrinsic affective mode inhering in one agent, grafted under gmeow:AffectiveMoment ⊑ gmeow:MentalMoment — the kernel agent-mental-life family, sibling to teleology's gmeow:IntentionalMode (the Desire/Intention grounding). Episodic temporal scope rides validFrom/validUntil on the statement; the felt-episode and mood surfaces are part of the fuller model in design/AFFECT-DESIGN.md. Whether an emotion is self-reported or attributed is the vantage axis of the claims about it; self-report is top authority for the subject's own standpoint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:EmotionType
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Emotion Type"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of an emotion — an OPEN value vocabulary seeded with Plutchik's primary eight (the EmotionML standard set). Registry-independent and contestable, never a tree (the Genre/Register precedent): traditions disagree about the emotion inventory itself, and that disagreement is data, not error (Principle 9)."@x-gmeow-english ;
    skos:scopeNote "Typed logic:AbstractIndividualType ⊑ logic:QualityValue — the repo-wide idiom for an open value vocabulary of individuals. Purist note: logic:Mode is defined as an aspect lacking a quality value, so classifying an emotion's TYPE with points in a quality space is a mild UFO category tension; GMEOW uses logic:QualityValue as the universal genus for any open value vocabulary (status enums, algorithm names, etc.), so this is house style, not a defect."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:affectiveElicitor
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Emotion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "affective elicitor"@x-gmeow-english ;
    skos:definition "The event, state, or act that TRIGGERED an emotion — its elicitor/cause (the bark that frightened, the news that saddened). Distinct from gmeow:affectiveTarget (what the emotion is ABOUT) and gmeow:emotionBearer (in whom it inheres); conflating cause with aboutness is a modeling error. Range intentionally open; non-functional (several things may contribute)."@x-gmeow-english ;
    skos:example "ex:startle gmeow:affectiveElicitor ex:suddenBark ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it for what the emotion is ABOUT (its intentional object) — that is gmeow:affectiveTarget; and avoid it for the bearer (gmeow:emotionBearer)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point it from an Emotion at the occurrent (event/act/state) that gave rise to it; leave the range open (constrained to an IRI by SHACL)."@x-gmeow-english ;
    gmeow:useWhen "Use to record the trigger/cause of an affective state, kept separate from its aboutness."@x-gmeow-english .

gmeow:elicits
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:affectiveElicitor ;
    rdfs:range gmeow:Emotion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "elicits"@x-gmeow-english ;
    skos:definition "Trigger-to-emotion inverse of gmeow:affectiveElicitor: the occurrent (event, state, or act) that gave rise to an emotion, read from the trigger's side. Domain is intentionally open (anything can elicit); the range is gmeow:Emotion. A query/projection convenience — assert gmeow:affectiveElicitor and read gmeow:elicits as its inverse."@x-gmeow-english ;
    skos:example "ex:suddenBark gmeow:elicits ex:startle ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting gmeow:elicits directly; prefer asserting gmeow:affectiveElicitor from the Emotion and let gmeow:elicits follow by inversion. Do not use it for what an emotion is ABOUT (that is gmeow:affectiveTarget, whose inverse is not this property)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Read it from a trigger to the emotion(s) it elicited; reach for it explicitly only in trigger-rooted projections where the inverse direction is the natural one to state."@x-gmeow-english ;
    gmeow:useWhen "Use when traversing or projecting from a trigger to the emotions it elicited."@x-gmeow-english .

gmeow:affectiveTarget
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Emotion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "affective target"@x-gmeow-english ;
    skos:definition "What an emotion is ABOUT — its intentional object (the dog one fears, the outcome one is proud of). Distinct from gmeow:affectiveElicitor (what TRIGGERED it) and gmeow:emotionBearer (in whom it inheres). Range intentionally open; non-functional (an emotion may be about several things)."@x-gmeow-english ;
    skos:example "ex:fearOfDog gmeow:affectiveTarget ex:theDog ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it for what merely TRIGGERED the emotion (that is gmeow:affectiveElicitor) or for the bearer (gmeow:emotionBearer)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point it from an Emotion at its intentional object; leave the range open (constrained to an IRI by SHACL)."@x-gmeow-english ;
    gmeow:useWhen "Use to record what an emotion is directed at / about, kept separate from its trigger."@x-gmeow-english .

gmeow:appraisalDimension
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Appraisal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "appraisal dimension"@x-gmeow-english ;
    rdfs:range gmeow:AppraisalDimension ;
    skos:definition "The dimension a dimensional appraisal reads. At most one per appraisal (SHACL — one cell, one reading; a PAD triple is three Appraisals sharing a vantage). Open vocabulary (sh:nodeKind sh:IRI)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:appraisalOf
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:Appraisal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "appraisal of"@x-gmeow-english ;
    rdfs:subPropertyOf gmeow:observedFeature ;
    skos:definition "What is appraised — an agent's state, a work, an event, an emotion (⊑ observedFeature, the observation-spine bridge idiom). Range intentionally open. Functional: one appraisal, one subject."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:appraisalQuality
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Appraisal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "appraisal quality"@x-gmeow-english ;
    rdfs:range gmeow:AestheticQuality ;
    skos:definition "The aesthetic quality a qualitative appraisal reads. NOT functional: one cell may attribute several coexisting qualities. Open vocabulary (sh:nodeKind sh:IRI)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:appraisalScaleProfile
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:Appraisal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "appraisal scale profile"@x-gmeow-english ;
    rdfs:range gmeow:AffectScaleProfile ;
    skos:definition "The gmeow:AffectScaleProfile a dimensional gmeow:appraisalValue is read against — the declared range, midpoint, polarity, and transform that give the bare magnitude its meaning. MANDATORY on any dimensional appraisal (a cell carrying gmeow:appraisalValue): the greenfield reshape removed the bare-decimal floor, so an unframed reading is ill-formed, not a permitted default (Principle 6, Principle 11). Functional: one reading, one frame."@x-gmeow-english ;
    skos:example "ex:arousalReading gmeow:appraisalValue 0.9 ; gmeow:appraisalScaleProfile ex:padUnitScale ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid omitting it on a dimensional appraisal (a value without its frame is ill-formed) and avoid pointing it at anything but a gmeow:AffectScaleProfile."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "On every gmeow:Appraisal that carries a gmeow:appraisalValue, assert exactly one gmeow:appraisalScaleProfile naming the gmeow:AffectScaleProfile the magnitude is expressed against."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a dimensional appraisal reading to the declared scale/frame that makes its number interpretable."@x-gmeow-english .

gmeow:appraisalValue
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Appraisal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "appraisal value"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "The magnitude of a dimensional reading, ALWAYS expressed against the gmeow:AffectScaleProfile named by gmeow:appraisalScaleProfile — a bare number carries no meaning without its declared frame (Principle 11), and the greenfield reshape removed the old plain-decimal floor (Principle 6). At most one per appraisal, and only alongside its dimension AND its scale profile (SHACL). Constitutive of this one cell — divergent readings are divergent Appraisals, not extra values."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:dimensionFamily
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AppraisalDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "dimension family"@x-gmeow-english ;
    rdfs:range gmeow:DimensionFamily ;
    skos:definition "Tags a gmeow:AppraisalDimension with its family — core-affect (felt-quality axes) or appraisal (cognitive-relational axes) — grouping the seed basis without closing the axis set (Principle 9). Complements the distinct gmeow:CoreAffectDimension type; open vocabulary (sh:nodeKind sh:IRI)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:profileMidpoint
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectScaleProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "profile midpoint"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "The neutral/reference point of an affect scale (0.0 for a bipolar valence axis −1…1). Optional; absent means the tradition declares no distinguished midpoint. Functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:profilePolarity
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:AffectScaleProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "profile polarity"@x-gmeow-english ;
    rdfs:range gmeow:ScalePolarity ;
    skos:definition "Whether an affect scale is bipolar (signed, with a neutral midpoint) or unipolar (a one-sided magnitude). Open vocabulary (gmeow:ScalePolarity, sh:nodeKind sh:IRI — never sh:in). Functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:profileRangeMax
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectScaleProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "profile range max"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "The maximum of an affect scale's range (must exceed gmeow:profileRangeMin). Mandatory (SHACL). Functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:profileRangeMin
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectScaleProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "profile range min"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "The minimum of an affect scale's range (below gmeow:profileRangeMax). Mandatory (SHACL). Functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:profileTransform
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectScaleProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "profile transform"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The declared normalization/transform a scale applies, named as a string spec (e.g. 'linear', 'z-score', 'min-max to [-1,1]'). The transform is DECLARED here, never computed in triples — applying it, and converting between scales, is solver work (Principle 12). Functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:affectiveConstituent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AffectComposite ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "affective constituent"@x-gmeow-english ;
    skos:definition "A declared part of a gmeow:AffectComposite's decomposition — a core-affect gmeow:AffectVectorObservation, a constituent gmeow:Emotion, or an appraisal/relation cell (elicitor, target, agency, norm) that gives the named compound its structure. Range intentionally open; NOT functional (a composite has several constituents). Mandatory on a composite (SHACL): a composite with no declared constituent is an unanalyzed primitive, which is forbidden."@x-gmeow-english ;
    skos:example "ex:schadenfreude gmeow:affectiveConstituent ex:positiveCoreVector ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid leaving a composite with no constituents (that is the forbidden opaque primitive) and avoid using it for the bearer/target/elicitor of the composite as a whole (those are gmeow:emotionBearer / gmeow:affectiveTarget / gmeow:affectiveElicitor)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "From a gmeow:AffectComposite, point gmeow:affectiveConstituent at each part of its declared decomposition — the core-affect vector observation plus the differentiating relation/appraisal cells."@x-gmeow-english ;
    gmeow:useWhen "Use to declare what a named compound emotion decomposes into, so schadenfreude/saudade are modeled up from axes and relations, not minted as primitives."@x-gmeow-english .

gmeow:derivedByFunction
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Observation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "derived by function"@x-gmeow-english ;
    rdfs:range gmeow:AffectFunction ;
    skos:definition "The named gmeow:AffectFunction that produced a derived-affect observation — the CLI-exposed handle for the computation, carried out outside the logic (Principle 12). Applies to any derived gmeow:Observation: gmeow:fnAffectiveIntensity on a gmeow:DerivedAffectIntensityObservation, gmeow:fnArgmax on a gmeow:AffectDecision."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:intensityBasis
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:DerivedAffectIntensityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "intensity basis"@x-gmeow-english ;
    rdfs:range gmeow:AffectVectorObservation ;
    skos:definition "The gmeow:AffectVectorObservation a derived intensity is the norm OF — its declared basis. Mandatory (SHACL): an intensity with no basis is a floating number. Functional: one intensity, one vector."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:metricProfile
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:DerivedAffectIntensityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "metric profile"@x-gmeow-english ;
    rdfs:range gmeow:AffectScaleProfile ;
    skos:definition "The gmeow:AffectScaleProfile declaring the scale normalization under which a derived intensity is computed. Mandatory (SHACL). Functional. Distinct from a component cell's gmeow:appraisalScaleProfile — this is the metric/basis of the WHOLE vector."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:normFunction
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:DerivedAffectIntensityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "norm function"@x-gmeow-english ;
    rdfs:range math:Norm ;
    skos:definition "The declared math:Norm under which a derived intensity is computed — the machine-readable, grounded norm object (never a free-text string), a math:Norm math:inducedByForm a positive-definite math:SymmetricBilinearForm, so ‖x‖ = √(xᵀGx) is exact and never a bare L² over the non-orthogonal basis. The canonical affect norm is gmeow:affectMetricTensorNorm. Mandatory (SHACL); the metric is explicit and computing it is solver work (Principle 12). Functional: one intensity, one norm."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:labelSetDecision
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectLabelSet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "label set decision"@x-gmeow-english ;
    rdfs:range gmeow:LabelSetDecisionRule ;
    skos:definition "The gmeow:LabelSetDecisionRule a gmeow:AffectLabelSet carries — gmeow:decisionArgmax (single-label / mutually-exclusive) or gmeow:decisionIndependentThreshold (multi-label). Mandatory on a REGISTERED (static) set: the producer hard-fails a registered set with no declared rule, because its exclusivity is then unknown and it cannot judge whether more than one crossing is a violation. A run-scoped zero-shot candidate set is rule-less by design. Functional: one set, one rule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:impliesLabelSetDecision
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "implies label set decision"@x-gmeow-english ;
    rdfs:range gmeow:LabelSetDecisionRule ;
    skos:definition "The gmeow:LabelSetDecisionRule entailed by a normalized gmeow:ScoreSemantics — the machine coupling edge that makes exclusivity a checkable consequence of the scoring function. gmeow:scoreSoftmax implies gmeow:decisionArgmax (a simplex point → an argmax decision over a partition); gmeow:scoreSigmoid implies gmeow:decisionIndependentThreshold (a hypercube point → per-label thresholds). A run whose gmeow:scoreSemantics implies a rule other than its label set's gmeow:labelSetDecision is an inconsistency (a hard fail). Only normalized-distribution semantics carry an implication — gmeow:scoreLogit, gmeow:scoreMargin, and gmeow:scoreEntailment (per-hypothesis, not normalized across candidates) carry none."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:decidedLabel
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectDecision ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "decided label"@x-gmeow-english ;
    rdfs:range gmeow:AffectClassifierLabel ;
    skos:definition "The single gmeow:AffectClassifierLabel a gmeow:AffectDecision decides — the argmax (categorical mode) over a gmeow:decisionArgmax label set. Functional: a decision has exactly one decided label — the categorical winner-take-all exclusivity bound, authored in the reasoning layer as gmeow:AffectDecision owl:maxQualifiedCardinality 1 (owl:onClass owl:Thing) on this property (with owl:FunctionalProperty) and projected to SHACL sh:minCount 1 / sh:maxCount 1 (Principle 17): a decision with no decided label is meaningless, and two labels is not a single-label decision."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:decisionCrossedThreshold
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectDecision ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "decision crossed threshold"@x-gmeow-english ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the decided label's score crossed its claim threshold (true) or the model decided but no claim was routed (false). Makes 'decided-but-below-threshold' a queryable fact distinct from a routed gmeow:AffectiveClaim — the argmax is recorded either way, only the claim is gated. Mandatory and single-valued: authored in the reasoning layer as gmeow:AffectDecision owl:maxQualifiedCardinality 1 (owl:onClass owl:Thing) on this property (with owl:FunctionalProperty) and projected to SHACL sh:minCount 1 / sh:maxCount 1 (Principle 17). The qualified idiom owl:maxQualifiedCardinality 1 with owl:onClass owl:Thing is the in-fragment form the native reasoner DECIDES — degrading the qualified count to the same class-unrestricted single-valued bound the unqualified form intended — so this single-valued datatype bound is a reasoning-layer fact, not a hand-authored SHACL constraint: a decision must record exactly one crossed-threshold verdict, its presence is never optional and two verdicts are incoherent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:decisionMargin
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectDecision ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "decision margin"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "The top1−top2 score gap of a gmeow:AffectDecision — the derived confidence of the argmax call ('joy at 0.45 in a 7-way set' is a low-margin decision the boolean gmeow:decisionCrossedThreshold alone would discard). A derived view (Principle 12), recomputable from the scores, computed by gmeow:fnArgmax. OPTIONAL (functional, NO minCardinality): a run emitting a single top-1 score has no runner-up, so a legitimate single-score argmax decision carries no margin and is never a hard fail."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:vectorComponent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AffectVectorObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "vector component"@x-gmeow-english ;
    rdfs:range gmeow:Appraisal ;
    skos:definition "A per-axis gmeow:Appraisal cell grouped by a gmeow:AffectVectorObservation — one dimensional reading (dimension + value + scale profile) that is one component of the vector. NOT functional: a vector groups several axis cells. One cell per axis is preserved; the grouping does not overwrite the cells."@x-gmeow-english ;
    skos:example "ex:vec gmeow:vectorComponent ex:valenceCell ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at anything but a dimensional gmeow:Appraisal cell, and avoid collapsing several axes into one cell (one cell, one axis)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "From a gmeow:AffectVectorObservation, attach one dimensional gmeow:Appraisal per axis via gmeow:vectorComponent; the cells share the observation's vantage/target/time."@x-gmeow-english ;
    gmeow:useWhen "Use to group the per-axis appraisal cells that make up a vector reading under one queryable identity."@x-gmeow-english .

gmeow:vectorProfile
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectVectorObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "vector profile"@x-gmeow-english ;
    rdfs:range gmeow:AffectScaleProfile ;
    skos:definition "The gmeow:AffectScaleProfile naming the metric/basis of a gmeow:AffectVectorObservation — the frame the whole vector is read against. Mandatory (SHACL). Functional: one vector, one declared basis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:weightingPolicy
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:DerivedAffectIntensityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "weighting policy"@x-gmeow-english ;
    rdfs:range gmeow:WeightingPolicy ;
    skos:definition "The declared gmeow:WeightingPolicy individual under which a derived intensity combines its axes — a machine-readable named handle (gmeow:weightingEqualCoreAffect, gmeow:weightingValenceDominant), never a free-text string. Mandatory (SHACL): weighting is explicit, and applying it (the diagonal/off-diagonal weights of the metric Gram matrix) is solver work (Principle 12). Functional: one intensity, one policy."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:metricGram
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectScaleProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "metric Gram matrix"@x-gmeow-english ;
    rdfs:range math:GramMatrix ;
    skos:definition "The math:GramMatrix G whose induced norm ‖x‖ = √(xᵀGx) is the affect intensity over this profile's core-affect basis — the machine-readable metric tensor of the frame. The canonical PAD metric declares gmeow:coreAffectGram, a positive-definite 4×4 Gram matrix of exact math:RationalValue entries over the {valence, arousal, dominance, unpredictability} basis (diagonal 1, valence–arousal coupling 1/4). Optional on a profile that declares no metric; functional: one profile, one Gram matrix. The norm computation is solver work outside the logic (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:coreAxisIndex
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:CoreAffectDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "core axis index"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The stable zero-based basis index of a gmeow:CoreAffectDimension in the canonical core-affect basis {valence 0, arousal 1, dominance 2, unpredictability 3} — the row/column position an axis occupies in the metric math:GramMatrix (gmeow:metricGram). It fixes the correspondence between a core-affect axis and its coordinate, so a vector reading maps deterministically onto the exact-rational metric. Functional: one axis, one index."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:sparseAxisCompletion
    a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectScaleProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "sparse-axis completion"@x-gmeow-english ;
    rdfs:range xsd:boolean ;
    skos:definition "Declares (true) that a profile's metric completes an absent core-affect axis of the vector reading with a zero coordinate — a sparse vector is read against the full basis with unlisted axes at 0. This makes the missing-axis policy EXPLICIT, not silent: an axis the metric does not list is zero-completed, while an axis a downstream contract declares REQUIRED but the reading omits is a hard fail (a distinct, contract-level rule, never satisfied by zero-completion). Functional: one profile, one policy."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:canonicalizesAs
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AffectClassifierOutput ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "canonicalizes as"@x-gmeow-english ;
    skos:definition "Links a gmeow:AffectClassifierOutput to the canonical GMEOW construct it canonicalizes into under a reviewed mapping — e.g. an SST-2 positive output to a valence gmeow:Appraisal of the target text (positive sentiment is NOT joy). Range intentionally open. The mapping is reviewed and lossy-declared; canonicalization NEVER discards the original label/score."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:classifiedTarget
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:observedFeature ;
    rdfs:domain gmeow:AffectClassifierOutput ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "classified target"@x-gmeow-english ;
    skos:definition "The target span a classifier output was emitted over — the chunk/text/segment classified (⊑ gmeow:observedFeature, the observation-spine bridge). Range intentionally open. Mandatory on an output (SHACL): an output with no target is unmoored evidence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:classifierScore
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:AffectClassifierOutput ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "classifier score"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "The raw score a classifier emitted for its label. Its MEANING is fixed by gmeow:scoreSemantics (sigmoid/softmax/logit/…), never assumed: a raw score is logic:evidenceStrength/probability, and only a CALIBRATED probability may be read as confidence. Mandatory on an output (SHACL)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:emittedLabel
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AffectClassifierOutput ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "emitted label"@x-gmeow-english ;
    rdfs:range gmeow:AffectClassifierLabel ;
    skos:definition "The exact external gmeow:AffectClassifierLabel a classifier output emitted — its lossless label identity (gmeow-goemotions:joy, gmeow-hf:sst2Negative). Mandatory on an output (SHACL); the label MUST be registered in a gmeow:AffectLabelSet or canonical projection fails."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:labelSetRevision
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ModelInferenceRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "label-set revision"@x-gmeow-english ;
    skos:definition "The pinned revision of the label set the run emitted over — part of the full run provenance (a zero-shot candidate label set is part of the run identity; a zero-shot 'joy' is not GoEmotions joy)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hypothesisTemplate
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ModelInferenceRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "hypothesis template"@x-gmeow-english ;
    skos:definition "The natural-language hypothesis template a zero-shot (NLI) inference run instantiated per candidate label (e.g. 'This text expresses {}.'). Part of the run identity: the same candidate word under a different template is a different run, so a zero-shot candidate set is run-scoped provenance, never a static gmeow:AffectLabelSet."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:memberOfLabelSet
    a owl:ObjectProperty ;
    rdfs:domain gmeow:AffectClassifierLabel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "member of label set"@x-gmeow-english ;
    rdfs:range gmeow:AffectLabelSet ;
    skos:definition "Binds a gmeow:AffectClassifierLabel to the gmeow:AffectLabelSet it belongs to (GoEmotions, Ekman-7, SST-2, CardiffNLP). Mandatory on a label (SHACL): an unregistered label fails canonical projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:modelFramework
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ModelInferenceRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "model framework"@x-gmeow-english ;
    skos:definition "The model framework of an inference run (e.g. 'transformers', 'onnxruntime') — part of the full run provenance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:modelIdentifier
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gmeow:ModelInferenceRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "model identifier"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The model repository id of an inference run (e.g. the Hugging Face repo 'SamLowe/roberta-base-go_emotions'). Mandatory (SHACL); a model id WITHOUT a pinned gmeow:modelRevision fails reproducibility."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:modelRevision
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain gmeow:ModelInferenceRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "model revision"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The pinned model revision/commit of an inference run — MANDATORY (SHACL). A model name without a pinned revision is unreproducible and fails. The single most drift-prone field for zero-shot/generative adapters."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:modelTask
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ModelInferenceRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "model task"@x-gmeow-english ;
    skos:definition "The model task of an inference run (e.g. 'text-classification', 'zero-shot-classification') — part of the full run provenance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:producedBy
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectClassifierOutput ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "produced by"@x-gmeow-english ;
    rdfs:range gmeow:ModelInferenceRun ;
    skos:definition "The gmeow:ModelInferenceRun that produced a classifier output — its provenance handle (PROV-O prov:wasGeneratedBy by generated correspondence). Mandatory and functional (SHACL): one output, one run."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:scoreCalibration
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:AffectClassifierOutput ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "score calibration"@x-gmeow-english ;
    skos:definition "The declared calibration profile of a score, named as a string spec (e.g. 'temperature-scaled T=1.4', 'isotonic'). REQUIRED whenever a score's semantics is gmeow:scoreCalibratedProbability: a raw sigmoid/softmax score stored as a calibrated probability/confidence without calibration metadata is a hard fail."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:scoreSemantics
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain gmeow:AffectClassifierOutput ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "score semantics"@x-gmeow-english ;
    rdfs:range gmeow:ScoreSemantics ;
    skos:definition "What a gmeow:classifierScore MEANS — a sigmoid score, softmax probability, calibrated probability, logit, or margin (open gmeow:ScoreSemantics vocab). Mandatory on an output (SHACL): a bare number with no declared semantics is uninterpretable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:supportsAffectiveClaim
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "supports affective claim"@x-gmeow-english ;
    rdfs:range gmeow:AffectiveClaim ;
    skos:definition "The evidence link from a gmeow:AffectClassifierOutput or gmeow:AffectiveExpression to the richer gmeow:AffectiveClaim it SUPPORTS — evidence, NEVER entailment. Domain intentionally open across the evidence surfaces; non-functional (one claim may be supported by several pieces of evidence). A classifier output that asserts inner affect without this claim boundary is a hard fail."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:telemetryBlob
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:AffectTelemetryStream ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "telemetry blob"@x-gmeow-english ;
    skos:definition "The by-reference handle (a content-address digest + origin) for a gmeow:AffectTelemetryStream's dense time-series block — the block is held by reference, NEVER inlined as triples (the blob-by-reference doctrine; high-frequency telemetry must not become a triple storm)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:thresholdApplied
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:AffectClassifierOutput ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "threshold applied"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "The threshold used to binarize/select a classifier's label. The applied threshold policy travels with each output — a single global 0.5 must not be assumed canonical (GoEmotions documents per-label threshold optimization)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:tokenizerRevision
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ModelInferenceRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "tokenizer revision"@x-gmeow-english ;
    skos:definition "The pinned tokenizer revision of an inference run — part of the full run provenance (a tokenizer change silently shifts scores)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:usedInput
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ModelInferenceRun ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "used input"@x-gmeow-english ;
    skos:definition "The input a gmeow:ModelInferenceRun consumed (PROV-O prov:used by generated correspondence). Range intentionally open (a chunk, document, or media segment)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:dimensionAgency
    a gmeow:AppraisalDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "agency"@x-gmeow-english ;
    skos:definition "The agency/attribution appraisal axis — self ↔ other-agent ↔ impersonal cause. Reads against the acting agent; separates pride (self-agency) from joy and guilt from shame. A cognitive-relational appraisal axis."@x-gmeow-english ;
    gmeow:dimensionFamily gmeow:familyAppraisal ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionArousal
    a gmeow:CoreAffectDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "arousal"@x-gmeow-english ;
    skos:definition "The arousal core-affect dimension — activated versus calm (activation / energy)."@x-gmeow-english ;
    gmeow:coreAxisIndex 1 ;
    gmeow:dimensionFamily gmeow:familyCoreAffect ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionCertainty
    a gmeow:AppraisalDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "certainty"@x-gmeow-english ;
    skos:definition "The certainty appraisal axis — how sure the mind is about the eliciting situation. Separates fear (uncertain) from anger at equal valence/arousal. A cognitive-relational appraisal axis."@x-gmeow-english ;
    gmeow:dimensionFamily gmeow:familyAppraisal ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionCoping
    a gmeow:AppraisalDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "coping potential"@x-gmeow-english ;
    skos:definition "The coping-potential appraisal axis — the appraised capacity to manage or influence the situation. Separates fear from anger and challenge from threat. A cognitive-relational appraisal axis."@x-gmeow-english ;
    gmeow:dimensionFamily gmeow:familyAppraisal ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionDominance
    a gmeow:CoreAffectDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "dominance"@x-gmeow-english ;
    skos:definition "The dominance/potency core-affect dimension — in control versus controlled."@x-gmeow-english ;
    gmeow:coreAxisIndex 2 ;
    gmeow:dimensionFamily gmeow:familyCoreAffect ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionGoalCongruence
    a gmeow:AppraisalDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "goal congruence"@x-gmeow-english ;
    skos:definition "The goal-congruence appraisal axis — conducive ↔ obstructive to the appraiser's goals. Reads against teleology's gmeow:Goal / gmeow:Desire / gmeow:counterGoal (affect and teleology stay connected, never identified). A cognitive-relational appraisal axis."@x-gmeow-english ;
    gmeow:dimensionFamily gmeow:familyAppraisal ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionGoalRelevance
    a gmeow:AppraisalDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "goal relevance"@x-gmeow-english ;
    skos:definition "The goal-relevance/salience appraisal axis — how much the situation matters to the appraiser's goals. Reads against teleology's gmeow:Goal / gmeow:Desire; the affective analogue of a reified goal evaluation. A cognitive-relational appraisal axis."@x-gmeow-english ;
    gmeow:dimensionFamily gmeow:familyAppraisal ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionNormCompatibility
    a gmeow:AppraisalDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "norm compatibility"@x-gmeow-english ;
    skos:definition "The norm/self-compatibility appraisal axis — upholds ↔ violates a standard. Reads against the deontic-force-over-goals layer; underlies shame, guilt, pride, and indignation. A cognitive-relational appraisal axis."@x-gmeow-english ;
    gmeow:dimensionFamily gmeow:familyAppraisal ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionNovelty
    a gmeow:AppraisalDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "novelty"@x-gmeow-english ;
    skos:definition "The novelty/expectedness appraisal axis — how unexpected the eliciting situation is. Underlies surprise and startle. A cognitive-relational appraisal axis."@x-gmeow-english ;
    gmeow:dimensionFamily gmeow:familyAppraisal ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionObjectFocus
    a gmeow:AppraisalDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "object focus"@x-gmeow-english ;
    skos:definition "The object-focus appraisal axis — sharply directed ↔ diffuse. The emotion/mood continuum: a sharply object-directed emotion versus a diffuse, backgrounded mood. A cognitive-relational appraisal axis."@x-gmeow-english ;
    gmeow:dimensionFamily gmeow:familyAppraisal ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionTemporalOrientation
    a gmeow:AppraisalDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "temporal orientation"@x-gmeow-english ;
    skos:definition "The temporal-orientation appraisal axis — past ↔ present ↔ prospective. Separates regret (past) from dread (prospective). A cognitive-relational appraisal axis."@x-gmeow-english ;
    gmeow:dimensionFamily gmeow:familyAppraisal ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionUnpredictability
    a gmeow:CoreAffectDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "unpredictability"@x-gmeow-english ;
    skos:definition "The unpredictability core-affect dimension — a fourth felt-quality axis several traditions need to separate fear from anger at equal valence and arousal."@x-gmeow-english ;
    gmeow:coreAxisIndex 3 ;
    gmeow:dimensionFamily gmeow:familyCoreAffect ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimensionValence
    a gmeow:CoreAffectDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "valence"@x-gmeow-english ;
    skos:definition "The valence core-affect dimension — pleasant versus unpleasant (hedonic tone)."@x-gmeow-english ;
    gmeow:coreAxisIndex 0 ;
    gmeow:dimensionFamily gmeow:familyCoreAffect ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:familyAppraisal
    a gmeow:DimensionFamily ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "appraisal"@x-gmeow-english ;
    skos:definition "The cognitive-relational family of affect axes — what the mind computed about the eliciting situation (novelty, goal-relevance, goal-congruence, agency, certainty, coping, norm-compatibility, temporal-orientation, object-focus). These generate and differentiate emotions that share core affect."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:familyCoreAffect
    a gmeow:DimensionFamily ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "core-affect"@x-gmeow-english ;
    skos:definition "The experiential family of affect axes — the felt quality itself (valence, arousal, dominance, unpredictability), low-dimensional and present even in objectless mood."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:fnAffectiveIntensity
    a gmeow:AffectFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "affective intensity"@x-gmeow-english ;
    skos:definition "The canonical derived-affect function the gmeow CLI exposes for overall intensity — the norm of a gmeow:AffectVectorObservation under a declared weighted / metric-tensor metric (never a bare L² over the non-orthogonal basis). It computes gmeow:affectMetricTensorNorm, the math:Norm induced by the positive-definite core-affect form. A named handle for a computation carried out outside the logic (Principle 12); it names the derivation, it does not compute in triples."@x-gmeow-english ;
    rdfs:seeAlso gmeow:affectMetricTensorNorm ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:fnArgmax
    a gmeow:AffectFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "argmax (categorical mode)"@x-gmeow-english ;
    skos:definition "The categorical MAP / mode function the gmeow CLI applies over a single-label classifier's score vector to record its decision — argmax over the labels of a gmeow:decisionArgmax set, dual to gmeow:fnAffectiveIntensity (the intensity norm). A named handle for a computation carried out outside the logic (Principle 12): it names the derivation that produced a gmeow:AffectDecision's gmeow:decidedLabel (and its gmeow:decisionMargin, the top1−top2 gap), it does not compute in triples."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# --- The canonical core-affect intensity metric (resolves the norm open question). --- #
# G is a positive-definite symmetric 4×4 Gram matrix over the core-affect basis
# {valence 0, arousal 1, dominance 2, unpredictability 3}: diagonal all 1, the
# valence–arousal coupling (0,1)=(1,0)=1/4, every other off-diagonal 0. It is
# positive-definite by its leading principal minors 1 and 15/16 > 0. Intensity is
# ‖x‖ = √(xᵀGx), the math:Norm induced by the positive-definite form, computed
# OUTSIDE the logic over EXACT rationals (Principle 12).

gmeow:weightingEqualCoreAffect
    a gmeow:WeightingPolicy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "equal-weight core-affect axes"@x-gmeow-english ;
    skos:definition "The equal-weight core-affect weighting policy — every core-affect axis carries diagonal weight 1 in the metric Gram matrix, so no axis dominates the intensity by construction (the canonical gmeow:coreAffectGram, whose only non-trivial structure is the valence–arousal 1/4 coupling)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:weightingValenceDominant
    a gmeow:WeightingPolicy ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "valence-dominant"@x-gmeow-english ;
    skos:definition "A valence-dominant weighting policy — the metric Gram diagonal weights valence 2 and arousal 1, so valence contributes more to the intensity than an equal-weight reading (the G-weighted-dominant axis can differ from the raw-max axis)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:coreAffectBasis
    a math:Basis ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "core-affect basis"@x-gmeow-english ;
    skos:definition "The 4-axis core-affect coordinate basis {valence 0, arousal 1, dominance 2, unpredictability 3} the canonical metric Gram matrix and intensity vectors are taken in (gmeow:coreAxisIndex fixes each axis's position)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:coreAffectForm
    a math:SymmetricBilinearForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "core-affect metric form"@x-gmeow-english ;
    skos:definition "The positive-definite symmetric bilinear form on the core-affect space whose Gram matrix in the core-affect basis is gmeow:coreAffectGram; it induces the affect-intensity norm gmeow:affectMetricTensorNorm and is the inner product carried by gmeow:coreAffectSpace."@x-gmeow-english ;
    math:definiteness math:positiveDefinite ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:coreAffectGram
    a math:GramMatrix ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "core-affect Gram matrix G"@x-gmeow-english ;
    skos:definition "The canonical positive-definite 4×4 Gram matrix G of the core-affect metric form in the core-affect basis: diagonal 1, valence–arousal coupling (0,1)=(1,0)=1/4, all other off-diagonals 0 (omitted entries are exact zero). Positive-definite by leading principal minors 1 and 15/16. Its induced norm √(xᵀGx) is the affect intensity."@x-gmeow-english ;
    math:definiteness math:positiveDefinite ;
    math:representsForm gmeow:coreAffectForm ;
    math:inBasis gmeow:coreAffectBasis ;
    math:hasEntry
        gmeow:coreAffectGramE00 ,
        gmeow:coreAffectGramE11 ,
        gmeow:coreAffectGramE22 ,
        gmeow:coreAffectGramE33 ,
        gmeow:coreAffectGramE01 ,
        gmeow:coreAffectGramE10 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:coreAffectGramE00
    a math:MatrixEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "G(0,0) = 1 (valence diagonal)"@x-gmeow-english ;
    skos:definition "The (0,0) diagonal entry of the core-affect Gram matrix — G(valence, valence) = 1."@x-gmeow-english ;
    math:atRow 0 ; math:atColumn 0 ; math:entryValue gmeow:rationalOne ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:coreAffectGramE11
    a math:MatrixEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "G(1,1) = 1 (arousal diagonal)"@x-gmeow-english ;
    skos:definition "The (1,1) diagonal entry of the core-affect Gram matrix — G(arousal, arousal) = 1."@x-gmeow-english ;
    math:atRow 1 ; math:atColumn 1 ; math:entryValue gmeow:rationalOne ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:coreAffectGramE22
    a math:MatrixEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "G(2,2) = 1 (dominance diagonal)"@x-gmeow-english ;
    skos:definition "The (2,2) diagonal entry of the core-affect Gram matrix — G(dominance, dominance) = 1."@x-gmeow-english ;
    math:atRow 2 ; math:atColumn 2 ; math:entryValue gmeow:rationalOne ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:coreAffectGramE33
    a math:MatrixEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "G(3,3) = 1 (unpredictability diagonal)"@x-gmeow-english ;
    skos:definition "The (3,3) diagonal entry of the core-affect Gram matrix — G(unpredictability, unpredictability) = 1."@x-gmeow-english ;
    math:atRow 3 ; math:atColumn 3 ; math:entryValue gmeow:rationalOne ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:coreAffectGramE01
    a math:MatrixEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "G(0,1) = 1/4 (valence–arousal coupling)"@x-gmeow-english ;
    skos:definition "The (0,1) off-diagonal entry of the core-affect Gram matrix — the valence–arousal coupling G(valence, arousal) = 1/4."@x-gmeow-english ;
    math:atRow 0 ; math:atColumn 1 ; math:entryValue gmeow:rationalQuarter ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:coreAffectGramE10
    a math:MatrixEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "G(1,0) = 1/4 (symmetric transpose of the coupling)"@x-gmeow-english ;
    skos:definition "The (1,0) off-diagonal entry of the core-affect Gram matrix — the symmetric transpose of the valence–arousal coupling, G(arousal, valence) = 1/4."@x-gmeow-english ;
    math:atRow 1 ; math:atColumn 0 ; math:entryValue gmeow:rationalQuarter ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:rationalOne
    a math:RationalValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the exact rational 1 (the pair (1, 1))"@x-gmeow-english ;
    skos:definition "The exact rational value 1 — the numerator/denominator pair (1, 1), never the decimal 1.0. Reused for every unit (diagonal) entry of the core-affect Gram matrix."@x-gmeow-english ;
    math:numerator 1 ; math:denominator 1 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:rationalQuarter
    a math:RationalValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the exact rational 1/4 (the pair (1, 4), never 0.25)"@x-gmeow-english ;
    skos:definition "The exact rational value 1/4 — the numerator/denominator pair (1, 4), never the decimal 0.25. The valence–arousal coupling weight of the core-affect Gram matrix."@x-gmeow-english ;
    math:numerator 1 ; math:denominator 4 ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:affectMetricTensorNorm
    a math:Norm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "affect metric-tensor norm"@x-gmeow-english ;
    skos:definition "The canonical affect-intensity norm ‖x‖ = √(xᵀGx) — the math:Norm induced by the positive-definite core-affect form gmeow:coreAffectForm (the weighted metric-tensor norm, NEVER a bare L² over the non-orthogonal basis). It is the norm gmeow:normFunction points at and gmeow:fnAffectiveIntensity computes."@x-gmeow-english ;
    math:inducedByForm gmeow:coreAffectForm ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:coreAffectMetricPAD
    a gmeow:AffectScaleProfile ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "core-affect PAD metric profile"@x-gmeow-english ;
    skos:definition "The canonical core-affect metric profile the gmeow CLI exposes: a bipolar [-1, 1] PAD unit scale that names the positive-definite metric Gram matrix gmeow:coreAffectGram (whose induced norm gmeow:affectMetricTensorNorm is the affect intensity) over the 4-axis core-affect basis. The metric form gmeow:coreAffectForm is the inner product of the core-affect coordinate space — a positive-definite symmetric bilinear form — so the space is an inner-product space in which orthogonality, angles, and the intensity norm are defined (the algebraic carrier lives in the math: charter, not re-minted here). Missing-axis policy is EXPLICIT: gmeow:sparseAxisCompletion true — an axis the metric does not list is zero-completed, while an axis a downstream contract declares REQUIRED but a reading omits is a hard fail (a distinct contract-level rule). The EmotionML unit-clamp normalization of a raw magnitude v is (v − gmeow:profileRangeMin) / (gmeow:profileRangeMax − gmeow:profileRangeMin) = (v + 1) / 2 for this profile's range."@x-gmeow-english ;
    skos:note "Missing-axis policy: a core-affect axis absent from the metric is zero-completed (gmeow:sparseAxisCompletion true); an axis a downstream contract declares REQUIRED but the reading omits is a hard fail, never satisfied by zero-completion. EmotionML unit-clamp normalization for this profile's range is (v − rangeMin)/(rangeMax − rangeMin) = (v + 1)/2."@x-gmeow-english ;
    gmeow:profileRangeMin -1.0 ;
    gmeow:profileRangeMax 1.0 ;
    gmeow:profileMidpoint 0.0 ;
    gmeow:profilePolarity gmeow:polarityBipolar ;
    gmeow:sparseAxisCompletion true ;
    gmeow:metricGram gmeow:coreAffectGram ;
    rdfs:seeAlso gmeow:coreAffectForm ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreCalibratedProbability
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "calibrated probability"@x-gmeow-english ;
    skos:definition "A calibrated probability — the ONLY score semantics that may be read as an epistemic confidence, and only with a declared gmeow:scoreCalibration profile."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreLogit
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "logit"@x-gmeow-english ;
    skos:definition "A raw pre-activation logit — not a probability."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreMargin
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "margin"@x-gmeow-english ;
    skos:definition "A decision margin (e.g. an SVM-style distance) — not a probability."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreSigmoid
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "sigmoid score"@x-gmeow-english ;
    skos:definition "A per-label sigmoid score (multi-label, e.g. GoEmotions) — evidence strength, NOT a calibrated probability. A point on the [0,1] hypercube (independent Bernoullis), so it implies the multi-label decision rule."@x-gmeow-english ;
    gmeow:impliesLabelSetDecision gmeow:decisionIndependentThreshold ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreSoftmax
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "softmax probability"@x-gmeow-english ;
    skos:definition "A softmax probability over a mutually-exclusive label set — a raw model probability, not calibrated unless a gmeow:scoreCalibration says so. A point on the probability simplex (a categorical distribution over a partition), so it implies the single-label / argmax decision rule."@x-gmeow-english ;
    gmeow:impliesLabelSetDecision gmeow:decisionArgmax ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreEntailment
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "entailment probability"@x-gmeow-english ;
    skos:definition "A natural-language-inference entailment probability from a zero-shot classifier (a hypothesis built from a run-scoped candidate label and template, scored entailment-vs-contradiction) — evidence strength, NOT a calibrated probability. The candidate label set is part of the run identity, carried by gmeow:hypothesisTemplate + gmeow:labelSetRevision, so a zero-shot 'joy' is not GoEmotions joy."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:decisionArgmax
    a gmeow:LabelSetDecisionRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "argmax (single-label)"@x-gmeow-english ;
    skos:definition "The single-label / winner-take-all decision rule: the label set's members form a partition (mutually exclusive and exhaustive), the score vector is a point on the probability simplex, and the decision is its argmax (the categorical mode) — exactly one decided label. SST-2, CardiffNLP TweetEval, and Ekman-7 carry it. Under it, more than one label crossing its claim threshold in one observation is a hard fail (mutually-exclusive claims), and the model's argmax is recorded as a gmeow:AffectDecision even when it falls below the claim threshold."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:decisionIndependentThreshold
    a gmeow:LabelSetDecisionRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "independent threshold (multi-label)"@x-gmeow-english ;
    skos:definition "The multi-label decision rule: each label is an independent Bernoulli thresholded on its own (the score vector is a point on the [0,1] hypercube, a product space), so zero, one, or many labels may be decided at once. GoEmotions carries it. Multiple crossings are legitimate and no gmeow:AffectDecision is minted — a multi-label set has no single categorical winner."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:polarityBipolar
    a gmeow:ScalePolarity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "bipolar"@x-gmeow-english ;
    skos:definition "A signed affect scale with a neutral midpoint (e.g. valence −1…1)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:polarityUnipolar
    a gmeow:ScalePolarity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "unipolar"@x-gmeow-english ;
    skos:definition "A one-sided affect magnitude scale (e.g. arousal 0…1)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionAnger
    a gmeow:EmotionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "anger"@x-gmeow-english ;
    skos:definition "The anger emotion type (Plutchik primary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionAnticipation
    a gmeow:EmotionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "anticipation"@x-gmeow-english ;
    skos:definition "The anticipation emotion type (Plutchik primary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionBearer
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:Emotion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "emotion bearer"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent in whom this emotion inheres. Functional and mandatory (SHACL): an intrinsic mode has exactly one bearer (the intentBearer pattern)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:emotionDisgust
    a gmeow:EmotionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "disgust"@x-gmeow-english ;
    skos:definition "The disgust emotion type (Plutchik primary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionFear
    a gmeow:EmotionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "fear"@x-gmeow-english ;
    skos:definition "The fear emotion type (Plutchik primary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionJoy
    a gmeow:EmotionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "joy"@x-gmeow-english ;
    skos:definition "The joy emotion type (Plutchik primary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionSadness
    a gmeow:EmotionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "sadness"@x-gmeow-english ;
    skos:definition "The sadness emotion type (Plutchik primary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionSaudade
    a gmeow:EmotionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "saudade"@x-gmeow-english ;
    skos:definition "The saudade emotion type — a named COMPOSITE prototype (not a Plutchik primary), minted for developer utility and external mapping. Its meaning is not primitive: it is mixed valence (bittersweet) + a past/absent affectiveTarget + prospective longing toward something unrecoverable, declared on gmeow:AffectComposite instances via gmeow:affectiveConstituent. Modeled up from axes and relations, never an opaque primitive (Principle 9 open vocabulary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionSchadenfreude
    a gmeow:EmotionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "schadenfreude"@x-gmeow-english ;
    skos:definition "The schadenfreude emotion type — a named COMPOSITE prototype (not a Plutchik primary), minted for developer utility and external mapping. Its meaning is not primitive: it is positive core affect whose affectiveElicitor is another agent's goal-incongruent outcome, with an other-directed agency structure and a deservingness/norm flavour, declared on gmeow:AffectComposite instances via gmeow:affectiveConstituent. Modeled up from axes and relations, never an opaque primitive (Principle 9 open vocabulary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionSurprise
    a gmeow:EmotionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "surprise"@x-gmeow-english ;
    skos:definition "The surprise emotion type (Plutchik primary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionTrust
    a gmeow:EmotionType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "trust"@x-gmeow-english ;
    skos:definition "The trust emotion type (Plutchik primary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:emotionType
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Emotion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "emotion type"@x-gmeow-english ;
    rdfs:range gmeow:EmotionType ;
    skos:definition "The kind(s) of this emotion. NOT functional: blended emotions carry several types, and classifications from different traditions coexist (Principle 9). At least one (SHACL); open vocabulary (sh:nodeKind sh:IRI, never sh:in)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:feltAffect
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:realizesMentalMoment ;
    rdfs:domain gmeow:AffectiveExperience ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "felt affect"@x-gmeow-english ;
    rdfs:range gmeow:AffectiveMoment ;
    skos:definition "Links a felt gmeow:AffectiveExperience (occurrent) to the gmeow:AffectiveMoment (endurant affective mode — an Emotion, later a Mood) it MANIFESTS. The affect-scoped, discoverable refinement of mentation's generic gmeow:realizesMentalMoment (domain narrowed to gmeow:AffectiveExperience, range to gmeow:AffectiveMoment), following the gmeow:appraisalOf ⊑ gmeow:observedFeature idiom. NOT functional — one episode may manifest several coexisting modes; the episode's gmeow:experiencer and the mode's gmeow:emotionBearer are the same agent."@x-gmeow-english ;
    skos:example "ex:feltAnger gmeow:feltAffect ex:angerMode ."@x-gmeow-english ;
    skos:scopeNote "The MANIFESTATION bridge (⊑ gmeow:realizesMentalMoment): a felt episode makes an ALREADY-existing affective mode present. NOT gmeow:producesMentalMoment (which brings a NEW mode into being) nor gmeow:updatesMentalTenure (which changes a held time-scoped tenure)."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid it to CREATE a fresh mode (use mentation's gmeow:producesMentalMoment) or to change a held tenure (gmeow:updatesMentalTenure); and avoid asserting it from the endurant side — it runs from the felt episode to the mode, not the reverse."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert gmeow:feltAffect from a gmeow:AffectiveExperience to the gmeow:AffectiveMoment mode it manifests; keep the episode's gmeow:experiencer and the mode's gmeow:emotionBearer pointing at the same agent."@x-gmeow-english ;
    gmeow:useWhen "Use to record which enduring affective mode a felt episode manifests — answering 'which felt episodes realized mode M?' — the affect-specific reading of gmeow:realizesMentalMoment."@x-gmeow-english .

gmeow:processAffectiveExperience
    a gmeow:MentalProcessType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "affective experience"@x-gmeow-english ;
    skos:definition "The mental-process kind of a felt affective episode — the occurrent of undergoing an affective state (the felt face of an emotion or mood mode). Minted from the affect slice as a value extending mentation's gmeow:MentalProcessType vocabulary (the gmeow:EventType idiom, Principle 9: a new kind is an individual, never a subclass); pinned onto gmeow:AffectiveExperience by an owl:hasValue restriction so every affective experience carries it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:qualityElegance
    a gmeow:AestheticQuality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "elegance"@x-gmeow-english ;
    skos:definition "The elegance aesthetic quality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:qualityKitsch
    a gmeow:AestheticQuality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "kitsch"@x-gmeow-english ;
    skos:definition "The kitsch aesthetic quality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:qualitySublimity
    a gmeow:AestheticQuality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "sublimity"@x-gmeow-english ;
    skos:definition "The sublimity aesthetic quality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# ── Classifier label registries ──────────────────────────────────────────────
# External label identities under their own authority path (gmeow-registry), never
# the canonical gmeow: emotion namespace. Reviewed correspondences to canonical
# GMEOW terms are generated lowerings, authored in the mappings layer.

gmeow-labelset:CardiffTweetEval
    a gmeow:AffectLabelSet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "CardiffNLP TweetEval sentiment"@x-gmeow-english ;
    skos:definition "The CardiffNLP Twitter-RoBERTa ternary sentiment label set (Negative/Neutral/Positive)."@x-gmeow-english ;
    gmeow:labelSetDecision gmeow:decisionArgmax ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow-labelset:Ekman7
    a gmeow:AffectLabelSet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "Ekman-7"@x-gmeow-english ;
    skos:definition "The Ekman-7 emotion label set used by j-hartmann/emotion-english-distilroberta-base (anger, disgust, fear, joy, neutral, sadness, surprise)."@x-gmeow-english ;
    gmeow:labelSetDecision gmeow:decisionArgmax ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow-labelset:GoEmotions
    a gmeow:AffectLabelSet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "GoEmotions"@x-gmeow-english ;
    skos:definition "The GoEmotions label set (27 emotion categories + neutral, multi-label) — the reference classifier adapter, as used by SamLowe/roberta-base-go_emotions."@x-gmeow-english ;
    gmeow:labelSetDecision gmeow:decisionIndependentThreshold ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow-labelset:SST2
    a gmeow:AffectLabelSet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "SST-2 binary sentiment"@x-gmeow-english ;
    skos:definition "The SST-2 binary sentiment label set (POSITIVE/NEGATIVE) — the default text-classification sentiment pipeline."@x-gmeow-english ;
    gmeow:labelSetDecision gmeow:decisionArgmax ;
    gmeow:graphBoxRole gmeow:boxABox .

# ── Canonical schadenfreude worked instance (shipped A-Box) ───────────────────
# Model up, don't mint. Schadenfreude is not an opaque primitive — it is positive
# core affect whose ELICITOR is another agent's goal-incongruent outcome, with an
# other-directed AGENCY structure and a deservingness/NORM flavour. The named
# composite carries its declared decomposition plus a DERIVED intensity — a view
# under a named metric-tensor norm, never a stored fact (Principle 12). This is the
# canonical worked instance the `gmeow affect intensity` CLI computes and the
# EmotionML worked `<emotion>` envelope PROJECTS: it lives in the base graph (module,
# not examples/) so it ships in the reasoned bundle. Its geometry is COMPUTED over
# gmeow:coreAffectGram (√(xᵀGx) = √(79/100) = 0.888819, dominant axis valence),
# never a fabricated constant.

gmeow:schadenfreudeObserver
    a gmeow:Person ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the schadenfreude observer"@x-gmeow-english ;
    skos:definition "The agent bearing the worked schadenfreude composite and holding its appraisal vantage — the observer who feels positive affect at a rival's deserved, self-inflicted setback."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:schadenfreudeElicitor
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the rival's self-inflicted, deserved setback"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:schadenfreudeComposite
    a gmeow:AffectComposite ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the observer's schadenfreude"@x-gmeow-english ;
    skos:definition "The worked schadenfreude gmeow:AffectComposite — a named emotion whose meaning is its declared decomposition: a positive-valence core-affect vector over another agent's goal-incongruent outcome, bound by an other-directed agency reading and a deservingness/norm reading, plus a derived intensity view. Modeled up from axes and relations, never an opaque primitive (Principle 9)."@x-gmeow-english ;
    gmeow:emotionBearer gmeow:schadenfreudeObserver ;
    gmeow:emotionType gmeow:emotionSchadenfreude ;
    gmeow:affectiveElicitor gmeow:schadenfreudeElicitor ;
    gmeow:affectiveConstituent
        gmeow:schadenfreudeCoreVector ,
        gmeow:schadenfreudeAgencyCell ,
        gmeow:schadenfreudeNormCell ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:schadenfreudeCoreVector
    a gmeow:AffectVectorObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the schadenfreude core-affect vector"@x-gmeow-english ;
    skos:definition "The core-affect vector signature of the worked schadenfreude composite: positive valence with moderate arousal, framed against the bipolar PAD unit scale. The metric-tensor norm over gmeow:coreAffectGram of this vector is the composite's overall intensity."@x-gmeow-english ;
    gmeow:vantage gmeow:schadenfreudeObserver ;
    gmeow:observedFeature gmeow:schadenfreudeComposite ;
    gmeow:vectorProfile gmeow:coreAffectMetricPAD ;
    gmeow:vectorComponent
        gmeow:schadenfreudeValenceCell ,
        gmeow:schadenfreudeArousalCell ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:schadenfreudeValenceCell
    a gmeow:Appraisal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the schadenfreude valence reading"@x-gmeow-english ;
    skos:definition "The positive-valence core-affect reading of the worked schadenfreude composite (valence 0.7 on the bipolar PAD unit scale) — the felt goodness of the rival's deserved setback."@x-gmeow-english ;
    gmeow:vantage gmeow:schadenfreudeObserver ;
    gmeow:appraisalOf gmeow:schadenfreudeElicitor ;
    gmeow:appraisalDimension gmeow:dimensionValence ;
    gmeow:appraisalValue 0.7 ;
    gmeow:appraisalScaleProfile gmeow:coreAffectMetricPAD ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:schadenfreudeArousalCell
    a gmeow:Appraisal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the schadenfreude arousal reading"@x-gmeow-english ;
    skos:definition "The moderate-arousal core-affect reading of the worked schadenfreude composite (arousal 0.4 on the bipolar PAD unit scale) — the activation of the felt affect."@x-gmeow-english ;
    gmeow:vantage gmeow:schadenfreudeObserver ;
    gmeow:appraisalOf gmeow:schadenfreudeElicitor ;
    gmeow:appraisalDimension gmeow:dimensionArousal ;
    gmeow:appraisalValue 0.4 ;
    gmeow:appraisalScaleProfile gmeow:coreAffectMetricPAD ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:schadenfreudeAgencyCell
    a gmeow:Appraisal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the schadenfreude agency reading"@x-gmeow-english ;
    skos:definition "The other-directed agency reading that differentiates schadenfreude from plain joy (agency -1.0 on the bipolar PAD unit scale) — the setback is attributed to the rival, not the observer."@x-gmeow-english ;
    gmeow:vantage gmeow:schadenfreudeObserver ;
    gmeow:appraisalOf gmeow:schadenfreudeElicitor ;
    gmeow:appraisalDimension gmeow:dimensionAgency ;
    gmeow:appraisalValue -1.0 ;
    gmeow:appraisalScaleProfile gmeow:coreAffectMetricPAD ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:schadenfreudeNormCell
    a gmeow:Appraisal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the schadenfreude deservingness reading"@x-gmeow-english ;
    skos:definition "The deservingness/norm-compatibility reading that differentiates schadenfreude from cruelty (norm compatibility 0.8 on the bipolar PAD unit scale) — the setback is appraised as deserved, upholding a standard."@x-gmeow-english ;
    gmeow:vantage gmeow:schadenfreudeObserver ;
    gmeow:appraisalOf gmeow:schadenfreudeElicitor ;
    gmeow:appraisalDimension gmeow:dimensionNormCompatibility ;
    gmeow:appraisalValue 0.8 ;
    gmeow:appraisalScaleProfile gmeow:coreAffectMetricPAD ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:schadenfreudeIntensity
    a gmeow:DerivedAffectIntensityObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "the schadenfreude derived intensity"@x-gmeow-english ;
    skos:definition "The overall intensity of the worked schadenfreude composite as a DERIVED view under the canonical core-affect metric-tensor norm — never a stored raw magnitude (Principle 12). The CLI computes ‖x‖ = √(xᵀGx) over gmeow:coreAffectGram for the core-affect vector, yielding √(79/100) = 0.888819 with valence the metric-dominant axis."@x-gmeow-english ;
    gmeow:vantage gmeow:schadenfreudeObserver ;
    gmeow:observedFeature gmeow:schadenfreudeComposite ;
    gmeow:intensityBasis gmeow:schadenfreudeCoreVector ;
    gmeow:metricProfile gmeow:coreAffectMetricPAD ;
    gmeow:weightingPolicy gmeow:weightingEqualCoreAffect ;
    gmeow:normFunction gmeow:affectMetricTensorNorm ;
    gmeow:derivedByFunction gmeow:fnAffectiveIntensity ;
    gmeow:graphBoxRole gmeow:boxABox .

