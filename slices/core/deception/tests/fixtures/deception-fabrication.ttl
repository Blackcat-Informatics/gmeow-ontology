#
# ABox fixture for the deception-fabrication competency question (gmeow:cqDataFile overlay).
# Verbatim externalization of test_competency_deception_fabrication_query:
# fabrication = held refuted + projected unequivocal + a fabricated work whose
# verification failed.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix exd:   <https://example.org/test/> .

exd:event1 a gmeow:Event ;
    gmeow:eventType gmeow:eventTypeFabrication ;
    gmeow:heldStandpoint exd:claimA ;
    gmeow:projectedStandpoint exd:claimB ;
    gmeow:implicates exd:work1 .

exd:claimA a gmeow:StandpointClaim ;
    gmeow:claimModality gmeow:refuted .

exd:claimB a gmeow:StandpointClaim ;
    gmeow:claimModality gmeow:unequivocal .

exd:work1 a gmeow:CreativeWork .

exd:verification1 a gmeow:VerificationResult ;
    gmeow:hasVerificationStatus gmeow:verificationStatusFailed .
