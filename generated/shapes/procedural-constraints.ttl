    ] .

<https://blackcatinformatics.ca/logic/TermCarrierValueConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/logic/TermCarrier> ;
    sh:targetClass <https://blackcatinformatics.ca/logic/TermCarrier> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/logic/termApplication> ?v0 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termIri> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termLiteral> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termSequenceMarker> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termVariable> ?v4 . } } UNION { $this <https://blackcatinformatics.ca/logic/termIri> ?v1 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termApplication> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termLiteral> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termSequenceMarker> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termVariable> ?v4 . } } UNION { $this <https://blackcatinformatics.ca/logic/termLiteral> ?v2 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termApplication> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termIri> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termSequenceMarker> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termVariable> ?v4 . } } UNION { $this <https://blackcatinformatics.ca/logic/termSequenceMarker> ?v3 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termApplication> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termIri> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termLiteral> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termVariable> ?v4 . } } UNION { $this <https://blackcatinformatics.ca/logic/termVariable> ?v4 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termApplication> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termIri> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termLiteral> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/termSequenceMarker> ?v3 . } } } }""" ;
    ] .

<https://blackcatinformatics.ca/math/AnalyticPropertyBackedConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/AnalyticProperty> ;
    sh:targetClass <https://blackcatinformatics.ca/math/AnalyticProperty> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:AnalyticProperty must resolve to a real first-order logic:Formula or an honest logic:expressivenessBoundary through math:definingLaw; an analytic-property claim backed by no law and no boundary is ill-formed (math:UnbackedAnalyticProperty)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/definingLaw> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/ArgumentSlotContiguityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/ArgumentSlotContiguityShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/NonContiguousArgumentSlots> ;
    sh:targetClass <https://blackcatinformatics.ca/math/MathematicalExpression> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A mathematical expression's math:argumentSlot indexes must form the strict zero-based contiguous sequence 0..n−1; every positive index must have a sibling at its immediate predecessor (math:NonContiguousArgumentSlots)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/argumentSlot> ?slot . ?slot <https://blackcatinformatics.ca/math/slotIndex> ?index . FILTER NOT EXISTS { { FILTER ( ?index = '0'^^<http://www.w3.org/2001/XMLSchema#integer> ) } UNION { $this <https://blackcatinformatics.ca/math/argumentSlot> ?predecessorSlot . ?predecessorSlot <https://blackcatinformatics.ca/math/slotIndex> ?predecessorIndex . BIND ( ( ?predecessorIndex + '1'^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?successorIndex ) FILTER ( ?successorIndex = ?index ) } } }""" ;
    ] .

<https://blackcatinformatics.ca/math/ArgumentSlotIndexNonNegativeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/ArgumentSlot> ;
    sh:targetClass <https://blackcatinformatics.ca/math/ArgumentSlot> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:ArgumentSlot's math:slotIndex must be a non-negative integer (zero-based operand position); a negative index is ill-formed (math:MalformedArgumentSlot)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/slotIndex> ?v . FILTER ( ?v < '0'^^<http://www.w3.org/2001/XMLSchema#integer> ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/ArgumentSlotIndexUniquenessConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/SlotIndexUniquenessShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/MalformedArgumentSlot> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/math/argumentSlot> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "No two distinct math:argumentSlot cells of the same parent may share the same math:slotIndex; a duplicate index makes operand order ambiguous." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/argumentSlot> ?g . $this <https://blackcatinformatics.ca/math/argumentSlot> ?s1 . $this <https://blackcatinformatics.ca/math/argumentSlot> ?s2 . ?s1 <https://blackcatinformatics.ca/math/slotIndex> ?i . ?s2 <https://blackcatinformatics.ca/math/slotIndex> ?i . FILTER ( ?s1 != ?s2 ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/BoundaryCoboundaryAdjunctionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/AdjunctionSignShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/BrokenBoundaryCoboundaryAdjunction> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/math/adjointIncidence> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A boundary math:CellIncidence and its math:adjointIncidence coboundary transpose must carry equal math:incidenceSign values (δ = ∂*); disagreeing signs break the adjunction (math:BrokenBoundaryCoboundaryAdjunction)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/adjointIncidence> ?j . $this <https://blackcatinformatics.ca/math/incidenceSign> ?s . ?j <https://blackcatinformatics.ca/math/incidenceSign> ?t . FILTER ( ?s != ?t ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/BoundarySquareZeroConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/BoundarySquareZeroShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/BrokenBoundarySquareZero> ;
    sh:targetClass <https://blackcatinformatics.ca/math/SimplicialComplex> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "On a math:SimplicialComplex a codimension-2 composition path (c ▷ b ▷ a) must have a distinct partner face b′ (the diamond) — combinatorial completeness that, under the induced orientation, is ∂∘∂ = 0; a lone intermediate is a broken diamond (math:BrokenBoundarySquareZero). Explicit ±1 sign cancellation over reified math:CellIncidence records is enforced by math:GeneralBoundarySquareZeroConstraint." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/hasCell> ?c . $this <https://blackcatinformatics.ca/math/hasCell> ?b . $this <https://blackcatinformatics.ca/math/hasCell> ?a . ?c <https://blackcatinformatics.ca/math/incidentTo> ?b . ?b <https://blackcatinformatics.ca/math/incidentTo> ?a . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/hasCell> ?bp . FILTER ( ?b != ?bp ) ?c <https://blackcatinformatics.ca/math/incidentTo> ?bp . ?bp <https://blackcatinformatics.ca/math/incidentTo> ?a . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/ChartDimensionMatchConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/ChartDimensionShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/DimensionMismatch> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Chart> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Chart's target coordinate space dimension does not equal its manifold's dimension (math:DimensionMismatch)." ;
        sh:select """SELECT $this WHERE { ?m <https://blackcatinformatics.ca/math/hasChart> $this . ?m <https://blackcatinformatics.ca/math/manifoldDimension> ?md . $this <https://blackcatinformatics.ca/math/targetCoordinateSpace> ?t . ?t <https://blackcatinformatics.ca/math/spaceDimension> ?sd . FILTER ( ?md != ?sd ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/CoboundarySquareZeroConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/CoboundarySquareZeroShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/BrokenCoboundarySquareZero> ;
    sh:targetClass <https://blackcatinformatics.ca/math/CochainComplex> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "On a math:CochainComplex a codimension-2 co-composition path (a ◁ b ◁ c) must have a distinct partner coface b′ (the co-diamond) — combinatorial completeness that, under the induced orientation, is δ∘δ = 0; a lone intermediate is a broken co-diamond (math:BrokenCoboundarySquareZero). Explicit ±1 sign cancellation is enforced by the δ = ∂* adjunction (math:BoundaryCoboundaryAdjunctionConstraint) with math:GeneralBoundarySquareZeroConstraint." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/hasCell> ?a . $this <https://blackcatinformatics.ca/math/hasCell> ?b . $this <https://blackcatinformatics.ca/math/hasCell> ?c . ?b <https://blackcatinformatics.ca/math/incidentTo> ?a . ?c <https://blackcatinformatics.ca/math/incidentTo> ?b . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/hasCell> ?bp . FILTER ( ?b != ?bp ) ?bp <https://blackcatinformatics.ca/math/incidentTo> ?a . ?c <https://blackcatinformatics.ca/math/incidentTo> ?bp . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/CollapsedMultiparameterFiltrationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/MultiparameterFiltration> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/CollapsedMultiparameterFiltration> ;
    sh:targetClass <https://blackcatinformatics.ca/math/MultiparameterFiltration> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:MultiparameterFiltration must have at least one math:hasFiltrationStage carrying a math:multiIndex tuple; a filtration whose every stage is a bare one-parameter math:filtrationThreshold has collapsed to one parameter (math:CollapsedMultiparameterFiltration)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/hasFiltrationStage> ?stage . ?stage <https://blackcatinformatics.ca/math/multiIndex> ?mi . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/ConfidenceAsProbabilityDeclaredConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/ConfidenceAsProbabilityConstraint> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/ConfidenceAsProbability> ;
    sh:targetClass <https://blackcatinformatics.ca/math/ProbabilityValue> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:ProbabilityValue that carries a logic:confidence must declare a logic:probabilityModel — the mapping from confidence to probability; a probability derived from a confidence score with no declared mapping erodes the probability/confidence boundary and is ill-formed (math:ConfidenceAsProbability)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/logic/confidence> ?t . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/probabilityModel> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/DegenerateZigzagDiagramConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/ZigzagDiagram> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/DegenerateZigzagDiagram> ;
    sh:targetClass <https://blackcatinformatics.ca/math/ZigzagDiagram> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:ZigzagDiagram must declare at least one math:zigzagArrow whose math:arrowDirection is math:backwardArrow; a forward-only diagram has collapsed to single-parameter persistence and is degenerate (math:DegenerateZigzagDiagram)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/zigzagArrow> ?arr . ?arr <https://blackcatinformatics.ca/math/arrowDirection> <https://blackcatinformatics.ca/math/backwardArrow> . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/DerivativeOrderPositiveConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/Derivative> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Derivative> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Derivative's math:derivativeOrder must be a positive integer (a zeroth derivative is the function itself, not a derivative record); an order below one is ill-formed (math:UnderspecifiedDerivative)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/derivativeOrder> ?v . FILTER ( ?v < '1'^^<http://www.w3.org/2001/XMLSchema#integer> ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/DiagonalDegenerateFiltrationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/MultiparameterFiltration> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/DiagonalDegenerateFiltration> ;
    sh:targetClass <https://blackcatinformatics.ca/math/MultiparameterFiltration> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:MultiparameterFiltration stage's math:multiIndex must not carry two components at distinct indices sharing the same math:componentValue; a diagonal (t, t) index is functionally dependent and genuinely one-parametric (math:DiagonalDegenerateFiltration)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/hasFiltrationStage> ?stage . ?stage <https://blackcatinformatics.ca/math/multiIndex> ?mi . ?mi <https://blackcatinformatics.ca/math/hasComponent> ?c1 . ?mi <https://blackcatinformatics.ca/math/hasComponent> ?c2 . ?c1 <https://blackcatinformatics.ca/math/atIndex> ?i1 . ?c2 <https://blackcatinformatics.ca/math/atIndex> ?i2 . FILTER ( ?i1 != ?i2 ) ?c1 <https://blackcatinformatics.ca/math/componentValue> ?val . ?c2 <https://blackcatinformatics.ca/math/componentValue> ?val . }""" ;
    ] .

<https://blackcatinformatics.ca/math/DimensionExponentDenominatorNonZeroConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/DimensionExponent> ;
    sh:targetClass <https://blackcatinformatics.ca/math/DimensionExponent> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:DimensionExponent must declare a non-zero integer math:exponentDenominator; a zero denominator is not a rational power (math:MalformedDimension)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/exponentDenominator> '0'^^<http://www.w3.org/2001/XMLSchema#integer> . }""" ;
    ] .

<https://blackcatinformatics.ca/math/DistributionParameterizationDeclaredConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/DistributionParameterizationShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/MissingDistributionParameterization> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Distribution> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Distribution that supplies a math:hasDistributionParameter must name its math:distributionParameterization — the explicit convention fixing which parametric form of its family is meant; a supplied parameter with a silent default parameterization is ill-formed (math:MissingDistributionParameterization)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/hasDistributionParameter> ?t . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/distributionParameterization> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/E8WeylOrderConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/E8WeylOrderShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/WrongE8WeylOrder> ;
    sh:targetClass <https://blackcatinformatics.ca/math/RootSystem> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:RootSystem with the E8 fingerprint (math:rootCount 240, math:rootSystemRank 8) must declare a math:weylGroup of math:groupOrder 696729600 — the order of W(E8); a different order corrupts the flagship invariant and is rejected." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/rootCount> '240'^^<http://www.w3.org/2001/XMLSchema#integer> . $this <https://blackcatinformatics.ca/math/rootSystemRank> '8'^^<http://www.w3.org/2001/XMLSchema#integer> . $this <https://blackcatinformatics.ca/math/weylGroup> ?w . ?w <https://blackcatinformatics.ca/math/groupOrder> ?o . FILTER ( ?o != '696729600'^^<http://www.w3.org/2001/XMLSchema#integer> ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/ExtendedRealValueConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/extendedRealValue> ;
    sh:targetObjectsOf <https://blackcatinformatics.ca/math/extendedRealValue> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "The object of math:extendedRealValue must be a finite numeric literal, math:PositiveInfinity, or math:NegativeInfinity; a non-literal value (an IRI or blank node) that is neither pole is not a point of the extended real line ℝ̄ (math:MalformedExtendedReal)." ;
        sh:select """SELECT $this WHERE { ?s <https://blackcatinformatics.ca/math/extendedRealValue> $this . FILTER ( ( !isLiteral($this) ) && ( $this NOT IN (<https://blackcatinformatics.ca/math/PositiveInfinity>, <https://blackcatinformatics.ca/math/NegativeInfinity>) ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/FlagshipScenarioFailureClassConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/FlagshipScenarioShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/UnwiredFlagshipScenario> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/FlagshipScenario> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:FlagshipScenario's gmeow:enforcesFailureClass naming a math: class must name a math:MathConformanceFailure subclass — the typed failure its counter-example raises; naming a math: class that is not a conformance failure leaves the scenario unwired (math:UnwiredFlagshipScenario)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/enforcesFailureClass> ?failure . FILTER ( STRSTARTS(STR(?failure), 'https://blackcatinformatics.ca/math/') ) FILTER NOT EXISTS { ?failure <http://www.w3.org/2000/01/rdf-schema#subClassOf>+ <https://blackcatinformatics.ca/math/MathConformanceFailure> . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/FormalVerificationResultGroundingConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/FormalVerificationResult> ;
    sh:targetClass <https://blackcatinformatics.ca/math/FormalVerificationResult> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:FormalVerificationResult must be the gmeow:observationResult of some observation; an ungrounded verification result is ill-formed." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { ?s <https://blackcatinformatics.ca/gmeow/observationResult> $this . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/FormalVerificationResultVantageGroundingConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/FormalVerificationResultShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/UngroundedVerificationResult> ;
    sh:targetClass <https://blackcatinformatics.ca/math/FormalVerificationResult> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:FormalVerificationResult must be grounded by a gmeow:Observation that names it through gmeow:observationResult and carries a gmeow:vantage; an unheld result is ill-formed (math:UngroundedVerificationResult)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { ?obs <https://blackcatinformatics.ca/gmeow/observationResult> $this . ?obs <https://blackcatinformatics.ca/gmeow/vantage> ?vantage . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/GeneralBoundarySquareZeroConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/BoundaryOperator> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/BrokenBoundarySquareZero> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Cell> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "For every codimension-2 pair (coface, far-face) the finite signed sum Σ_b [c:b]·[b:a] over intermediate cells must be 0; a non-zero group sum breaks ∂∘∂ = 0 on a general CW complex (math:BrokenBoundarySquareZero)." ;
        sh:select """SELECT $this ?j2 WHERE { ?r1 <https://blackcatinformatics.ca/math/incidenceCoface> $this . ?r1 <https://blackcatinformatics.ca/math/incidenceFace> ?j1 . ?r1 <https://blackcatinformatics.ca/math/incidenceSign> ?v1 . ?r1 a <https://blackcatinformatics.ca/math/CellIncidence> . ?r2 <https://blackcatinformatics.ca/math/incidenceCoface> ?j1 . ?r2 <https://blackcatinformatics.ca/math/incidenceFace> ?j2 . ?r2 <https://blackcatinformatics.ca/math/incidenceSign> ?v2 . ?r2 a <https://blackcatinformatics.ca/math/CellIncidence> . } GROUP BY $this ?j2 HAVING ( SUM(?v1 * ?v2) != '0'^^<http://www.w3.org/2001/XMLSchema#integer> )""" ;
    ] .

<https://blackcatinformatics.ca/math/GramMatrixSymmetryConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/GramMatrixShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/AsymmetricGramMatrix> ;
    sh:targetClass <https://blackcatinformatics.ca/math/GramMatrix> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:GramMatrix must be symmetric: every math:MatrixEntry at (row, column) needs a transpose entry at (column, row) with the same math:entryValue; a missing or mismatched transpose entry is ill-formed (math:AsymmetricGramMatrix)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/hasEntry> ?entry . ?entry <https://blackcatinformatics.ca/math/atRow> ?row . ?entry <https://blackcatinformatics.ca/math/atColumn> ?col . ?entry <https://blackcatinformatics.ca/math/entryValue> ?val . ?val <https://blackcatinformatics.ca/math/numerator> ?vnum . ?val <https://blackcatinformatics.ca/math/denominator> ?vden . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/hasEntry> ?mate . ?mate <https://blackcatinformatics.ca/math/atRow> ?col . ?mate <https://blackcatinformatics.ca/math/atColumn> ?row . ?mate <https://blackcatinformatics.ca/math/entryValue> ?mval . ?mval <https://blackcatinformatics.ca/math/numerator> ?vnum . ?mval <https://blackcatinformatics.ca/math/denominator> ?vden . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/IntervalKindConflationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/IntervalKindConflationShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/IntervalKindConflation> ;
    sh:targetClass <https://blackcatinformatics.ca/math/ConfidenceInterval> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:ConfidenceInterval must not also be a math:CredibleInterval — frequentist coverage and Bayesian posterior mass are different result kinds held disjoint through their paradigm parents; typing one node as both conflates them (math:IntervalKindConflation)." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/CredibleInterval> . }""" ;
    ] .

<https://blackcatinformatics.ca/math/LimitResultOutcomeValueConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/LimitResult> ;
    sh:targetClass <https://blackcatinformatics.ca/math/LimitResult> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:LimitResult's math:limitResultValue must agree with its math:limitOutcome: a finite numeric literal for math:convergesFinitely, math:PositiveInfinity for math:divergesToPositiveInfinity, math:NegativeInfinity for math:divergesToNegativeInfinity, and no value for math:divergesWithoutLimit; a value that disagrees with the declared outcome is ill-formed (math:UnderspecifiedLimitResult)." ;
        sh:select """SELECT $this WHERE { { $this <https://blackcatinformatics.ca/math/limitOutcome> <https://blackcatinformatics.ca/math/convergesFinitely> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/limitResultValue> ?vf . FILTER ( isLiteral(?vf) ) } } UNION { $this <https://blackcatinformatics.ca/math/limitOutcome> <https://blackcatinformatics.ca/math/divergesToPositiveInfinity> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/limitResultValue> ?vp . FILTER ( ?vp IN (<https://blackcatinformatics.ca/math/PositiveInfinity>) ) } } UNION { $this <https://blackcatinformatics.ca/math/limitOutcome> <https://blackcatinformatics.ca/math/divergesToNegativeInfinity> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/limitResultValue> ?vn . FILTER ( ?vn IN (<https://blackcatinformatics.ca/math/NegativeInfinity>) ) } } UNION { $this <https://blackcatinformatics.ca/math/limitOutcome> <https://blackcatinformatics.ca/math/divergesWithoutLimit> . $this <https://blackcatinformatics.ca/math/limitResultValue> ?vk . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/LogicLoweringDeclaredConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/LogicLoweringShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/UndeclaredLogicLowering> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/math/compilesToLogicFormula> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An expression lowered to a logic:Formula through math:compilesToLogicFormula must declare its math:denotationKind and its math:logicLoweringPreservation; silent promotion to a logical assertion is forbidden (math:UndeclaredLogicLowering)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/compilesToLogicFormula> ?t . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/denotationKind> ?c0 . $this <https://blackcatinformatics.ca/math/logicLoweringPreservation> ?c1 . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/LorentzianSignatureConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/MetricSignatureDimensionShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/DimensionMismatch> ;
    sh:targetClass <https://blackcatinformatics.ca/math/MetricSignature> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:lorentzianStructure manifold's math:MetricSignature does not have exactly one timelike direction (math:signaturePositive = 1 or math:signatureNegative = 1) (math:DimensionMismatch)." ;
        sh:select """SELECT $this WHERE { ?mt <https://blackcatinformatics.ca/math/metricSignature> $this . ?m <https://blackcatinformatics.ca/math/metricTensor> ?mt . ?m <https://blackcatinformatics.ca/math/manifoldStructureKind> <https://blackcatinformatics.ca/math/lorentzianStructure> . $this <https://blackcatinformatics.ca/math/signaturePositive> ?p . $this <https://blackcatinformatics.ca/math/signatureNegative> ?q . FILTER ( ( ?p != '1'^^<http://www.w3.org/2001/XMLSchema#integer> ) && ( ?q != '1'^^<http://www.w3.org/2001/XMLSchema#integer> ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/ManifoldDimensionNonNegativeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/Manifold> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Manifold> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Manifold's math:manifoldDimension must be a non-negative integer; a negative dimension names no manifold (math:UnderspecifiedManifold)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/manifoldDimension> ?v . FILTER ( ?v < '0'^^<http://www.w3.org/2001/XMLSchema#integer> ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/MeasureResultNonNegativeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/MeasureEvaluation> ;
    sh:targetClass <https://blackcatinformatics.ca/math/MeasureEvaluation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:MeasureEvaluation's math:measureResult must be a finite non-negative number or math:PositiveInfinity; a measure is non-negative, so the negative pole math:NegativeInfinity is not a mass (math:MalformedExtendedReal or math:UnderspecifiedMeasureEvaluation)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/measureResult> <https://blackcatinformatics.ca/math/NegativeInfinity> . }""" ;
    ] .

<https://blackcatinformatics.ca/math/MeasureTotalMassValueConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/MeasureShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/IncompleteMeasure> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Measure> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Measure's math:totalMass must be a non-negative numeric literal or math:PositiveInfinity; a measure whose total mass is neither is ill-formed (math:IncompleteMeasure)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/totalMass> ?v . FILTER ( ( ( !isLiteral(?v) ) || ( ?v < '0'^^<http://www.w3.org/2001/XMLSchema#integer> ) ) && ( ?v != <https://blackcatinformatics.ca/math/PositiveInfinity> ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/MetricSignatureDimensionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/MetricSignatureDimensionShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/DimensionMismatch> ;
    sh:targetClass <https://blackcatinformatics.ca/math/MetricSignature> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:MetricSignature's math:signaturePositive plus math:signatureNegative does not equal its manifold's math:manifoldDimension (math:DimensionMismatch)." ;
        sh:select """SELECT $this WHERE { ?mt <https://blackcatinformatics.ca/math/metricSignature> $this . ?m <https://blackcatinformatics.ca/math/metricTensor> ?mt . ?m <https://blackcatinformatics.ca/math/manifoldDimension> ?md . $this <https://blackcatinformatics.ca/math/signaturePositive> ?p . $this <https://blackcatinformatics.ca/math/signatureNegative> ?q . BIND ( ( ?p + ?q ) AS ?s ) FILTER ( ?s != ?md ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/MisscopedSectionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/GlobalSection> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/MisscopedSection> ;
    sh:targetClass <https://blackcatinformatics.ca/math/GlobalSection> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:GlobalSection's math:sectionRegion must equal the whole math:sheafBaseComplex of its math:overSheaf; a global section scoped to a proper subcomplex conflates H⁰ globality with a local datum and is ill-formed (math:MisscopedSection)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/overSheaf> ?sheaf . ?sheaf <https://blackcatinformatics.ca/math/sheafBaseComplex> ?base . $this <https://blackcatinformatics.ca/math/sectionRegion> ?region . FILTER ( ?region != ?base ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/MissingnessMechanismDeclaredConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/ImplicitMissingnessShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/ImplicitMissingness> ;
    sh:targetClass <https://blackcatinformatics.ca/math/StatisticalVariable> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:StatisticalVariable whose values encode absence (it carries a math:MissingnessIndicator through math:hasMissingnessIndicator) must declare the math:MissingnessMechanism an analysis depending on it rests on, through math:missingnessMechanism; a variable that depends on missing data but names no MCAR/MAR/MNAR mechanism assumes one implicitly and is ill-formed (math:ImplicitMissingness)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/hasMissingnessIndicator> ?t . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/missingnessMechanism> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/MultiparameterFunctionalDependenceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/MultiparameterFiltration> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/DiagonalDegenerateFiltration> ;
    sh:targetClass <https://blackcatinformatics.ca/math/MultiparameterFiltration> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:MultiparameterFiltration with two or more declared stages must exhibit a fix-one-vary-another witness — two stages sharing the same math:componentValue node at one math:atIndex position while differing at another; its absence means the declared stages are consistent with a functional dependence t₂ = f(t₁) and have not shown the filtration genuinely multi-parametric (math:DiagonalDegenerateFiltration)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/hasFiltrationStage> ?gs1 . $this <https://blackcatinformatics.ca/math/hasFiltrationStage> ?gs2 . FILTER ( ?gs1 != ?gs2 ) FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/hasFiltrationStage> ?stage1 . $this <https://blackcatinformatics.ca/math/hasFiltrationStage> ?stage2 . FILTER ( ?stage1 != ?stage2 ) ?stage1 <https://blackcatinformatics.ca/math/multiIndex> ?mi1 . ?stage2 <https://blackcatinformatics.ca/math/multiIndex> ?mi2 . ?mi1 <https://blackcatinformatics.ca/math/hasComponent> ?cVary1 . ?cVary1 <https://blackcatinformatics.ca/math/atIndex> ?iVary . ?cVary1 <https://blackcatinformatics.ca/math/componentValue> ?vVary1 . ?mi2 <https://blackcatinformatics.ca/math/hasComponent> ?cVary2 . ?cVary2 <https://blackcatinformatics.ca/math/atIndex> ?iVary . ?cVary2 <https://blackcatinformatics.ca/math/componentValue> ?vVary2 . FILTER ( ?vVary1 != ?vVary2 ) FILTER ( ?iVary != ?iFixed ) ?mi1 <https://blackcatinformatics.ca/math/hasComponent> ?cFixed1 . ?cFixed1 <https://blackcatinformatics.ca/math/atIndex> ?iFixed . ?cFixed1 <https://blackcatinformatics.ca/math/componentValue> ?vFixed . ?mi2 <https://blackcatinformatics.ca/math/hasComponent> ?cFixed2 . ?cFixed2 <https://blackcatinformatics.ca/math/atIndex> ?iFixed . ?cFixed2 <https://blackcatinformatics.ca/math/componentValue> ?vFixed . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/NormPositiveDefiniteConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/NormPositiveDefiniteShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/NonPositiveDefiniteNorm> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Norm> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Norm's math:inducedByForm must be positive-definite (math:definiteness math:positiveDefinite); a norm resting on a non-positive-definite form is ill-formed (math:NonPositiveDefiniteNorm)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/inducedByForm> ?v . FILTER NOT EXISTS { ?v <https://blackcatinformatics.ca/math/definiteness> <https://blackcatinformatics.ca/math/positiveDefinite> . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/PValueFrameConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/IllFramedPValueShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/IllFramedPValue> ;
    sh:targetClass <https://blackcatinformatics.ca/math/PValue> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:PValue must carry its test (a math:testStatistic or the math:HypothesisTest whose math:pValue it is), its math:nullHypothesis, its math:nullDistribution, and a math:tailDefinition or math:alternativeSidedness; a p-value missing any of these is ambiguous and ill-formed (math:IllFramedPValue)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/math/testStatistic> ?ts . } UNION { ?t a <https://blackcatinformatics.ca/math/HypothesisTest> . ?t <https://blackcatinformatics.ca/math/pValue> $this . } $this <https://blackcatinformatics.ca/math/nullHypothesis> ?nh . $this <https://blackcatinformatics.ca/math/nullDistribution> ?nd . { $this <https://blackcatinformatics.ca/math/tailDefinition> ?td . } UNION { $this <https://blackcatinformatics.ca/math/alternativeSidedness> ?sd . } } }""" ;
    ] .

<https://blackcatinformatics.ca/math/ParameterRoleOverfilledConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/ParameterRoleCardinalityConstraint> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/DistributionParameterRoleCardinality> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Distribution> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Distribution must not supply a required math:DistributionParameterRole through two distinct math:hasDistributionParameter parameters; a role filled twice is ill-formed (math:DistributionParameterRoleCardinality)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/distributionParameterization> ?pz . ?pz <https://blackcatinformatics.ca/math/requiresParameterRole> ?role . $this <https://blackcatinformatics.ca/math/hasDistributionParameter> ?p1 . ?p1 <https://blackcatinformatics.ca/math/parameterRole> ?role . $this <https://blackcatinformatics.ca/math/hasDistributionParameter> ?p2 . ?p2 <https://blackcatinformatics.ca/math/parameterRole> ?role . FILTER ( ?p1 != ?p2 ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/ParameterRoleUnfilledConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/ParameterRoleCardinalityConstraint> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/DistributionParameterRoleCardinality> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Distribution> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Distribution must supply each math:DistributionParameterRole its math:distributionParameterization requires through math:hasDistributionParameter -> math:parameterRole; a required role supplied zero times is ill-formed (math:DistributionParameterRoleCardinality)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/distributionParameterization> ?pz . ?pz <https://blackcatinformatics.ca/math/requiresParameterRole> ?role . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/hasDistributionParameter> ?param . ?param <https://blackcatinformatics.ca/math/parameterRole> ?role . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/PersistenceDeathNamedConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/PersistenceLifetimeShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/UnderspecifiedPersistenceLifetime> ;
    sh:targetClass <https://blackcatinformatics.ca/math/PersistenceLifetime> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:PersistenceLifetime's math:diesAt must name an IRI individual — the finite math:Quantity death threshold, or math:PositiveInfinity for an essential feature; a blank or literal death is ill-formed (math:UnderspecifiedPersistenceLifetime)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/diesAt> ?v . FILTER ( !isIRI(?v) ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/PersistenceModuleLifetimeConflationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/PersistenceModuleLifetimeConflationShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/PersistenceModuleLifetimeConflation> ;
    sh:targetClass <https://blackcatinformatics.ca/math/PersistenceModule> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:PersistenceModule must not also be a math:PersistenceLifetime — the whole persistence functor conflated with the birth–death interval of a single feature; the two are held owl:disjointWith and typing one node as both is math:PersistenceModuleLifetimeConflation." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/PersistenceLifetime> . }""" ;
    ] .

<https://blackcatinformatics.ca/math/PreservationLawNodeKindConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/PreservationLawShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/StringOnlyPreservationLaw> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Homomorphism> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Homomorphism must name its math:preservationLaw as a resource denoting a logic: formula, not an opaque literal string (math:StringOnlyPreservationLaw)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/preservationLaw> ?v . FILTER ( !( isIRI(?v) || isBlank(?v) ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/ProbabilityValueFramedConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/ProbabilityValueFramedShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/UnframedProbabilityValue> ;
    sh:targetClass <https://blackcatinformatics.ca/math/ProbabilityValue> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:ProbabilityValue must name its probability frame (gmeow:hasReferenceFrame) or its probability model (logic:probabilityModel); a probability that names neither is an unframed bare literal (math:UnframedProbabilityValue)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/hasReferenceFrame> ?v0 . } UNION { $this <https://blackcatinformatics.ca/logic/probabilityModel> ?v1 . } } }""" ;
    ] .

<https://blackcatinformatics.ca/math/ProbabilityValueRangeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/ProbabilityValueRangeShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/ProbabilityOutOfBounds> ;
    sh:targetClass <https://blackcatinformatics.ca/math/ProbabilityValue> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:ProbabilityValue's math:quantityValue must lie in the closed unit interval [0, 1]; a magnitude outside it is ill-formed or a mis-typed odds/log-odds (math:ProbabilityOutOfBounds)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/quantityValue> ?v . FILTER ( ( ?v < '0'^^<http://www.w3.org/2001/XMLSchema#integer> ) || ( ?v > '1'^^<http://www.w3.org/2001/XMLSchema#integer> ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/RandomVariableContextConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/RandomVariableScopedShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/UnscopedRandomVariable> ;
    sh:targetClass <https://blackcatinformatics.ca/math/RandomVariable> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:RandomVariable must carry a probability context — a math:hasDistribution, or a math:randomVariableDomain that is itself a math:ProbabilitySpace; a variable with neither is unscoped (math:UnscopedRandomVariable)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/math/hasDistribution> ?d . } UNION { $this <https://blackcatinformatics.ca/math/randomVariableDomain> ?dom . ?dom a <https://blackcatinformatics.ca/math/ProbabilitySpace> . } } }""" ;
    ] .

<https://blackcatinformatics.ca/math/RationalValueDenominatorNonZeroConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/RationalValue> ;
    sh:targetClass <https://blackcatinformatics.ca/math/RationalValue> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:RationalValue must declare a non-zero math:denominator; a zero denominator is not a rational value (math:ZeroDenominator)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/denominator> '0'^^<http://www.w3.org/2001/XMLSchema#integer> . }""" ;
    ] .

<https://blackcatinformatics.ca/math/RiemannianSignatureConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/MetricSignatureDimensionShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/DimensionMismatch> ;
    sh:targetClass <https://blackcatinformatics.ca/math/MetricSignature> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:riemannianStructure manifold's math:MetricSignature is not positive-definite (math:signatureNegative = 0) (math:DimensionMismatch)." ;
        sh:select """SELECT $this WHERE { ?mt <https://blackcatinformatics.ca/math/metricSignature> $this . ?m <https://blackcatinformatics.ca/math/metricTensor> ?mt . ?m <https://blackcatinformatics.ca/math/manifoldStructureKind> <https://blackcatinformatics.ca/math/riemannianStructure> . $this <https://blackcatinformatics.ca/math/signatureNegative> ?q . FILTER ( ?q != '0'^^<http://www.w3.org/2001/XMLSchema#integer> ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/SectionGluingConsistencyConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/GlobalSection> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/SectionGluingInconsistency> ;
    sh:targetClass <https://blackcatinformatics.ca/math/GlobalSection> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:GlobalSection must restrict consistently along every math:SheafRestrictionMap of its sheaf — applying the map's declared math:RestrictionImage to the exact integer math:stalkValue at its math:sourceObject stalk must agree with the math:stalkValue at its math:targetObject stalk; a declared assignment whose transported value disagrees with the target does not glue and is ill-formed (math:SectionGluingInconsistency)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/overSheaf> ?sheaf . ?sheaf <https://blackcatinformatics.ca/math/restrictionMap> ?rmap . ?rmap <https://blackcatinformatics.ca/math/sourceObject> ?ss . ?rmap <https://blackcatinformatics.ca/math/targetObject> ?ts . ?ss <https://blackcatinformatics.ca/math/stalkValue> ?vs . ?ts <https://blackcatinformatics.ca/math/stalkValue> ?vt . ?rmap <https://blackcatinformatics.ca/math/restrictionImage> ?img . ?img <https://blackcatinformatics.ca/math/imageSourceValue> ?vs . ?img <https://blackcatinformatics.ca/math/imageTargetValue> ?vimg . FILTER ( ?vimg != ?vt ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/SetBuilderMemberConditionNodeKindConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/SetBuilderExpression> ;
    sh:targetClass <https://blackcatinformatics.ca/math/SetBuilderExpression> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:SetBuilderExpression must name its math:memberCondition as a resource denoting a logic: formula (a blank node or IRI), not an opaque literal string." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/memberCondition> ?v . FILTER ( !( isIRI(?v) || isBlank(?v) ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/SetExtentDisjointConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/SetExtentShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/AmbiguousSetExtent> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Set> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Set must be extensional or intensional, not both: a node carrying both math:hasElement and math:memberCondition without a declared equality has an ambiguous extent (math:AmbiguousSetExtent)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/hasElement> ?v0 . $this <https://blackcatinformatics.ca/math/memberCondition> ?v1 . }""" ;
    ] .

<https://blackcatinformatics.ca/math/StageIndexPresenceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/FiltrationStage> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/UnderspecifiedFiltration> ;
    sh:targetClass <https://blackcatinformatics.ca/math/FiltrationStage> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:FiltrationStage must carry either a math:filtrationThreshold (a one-parameter index) or a math:multiIndex (a multiparameter index tuple); a stage carrying neither names no position in the filtration and is ill-formed (math:UnderspecifiedFiltration)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/math/filtrationThreshold> ?thr . } UNION { $this <https://blackcatinformatics.ca/math/multiIndex> ?mi . } } }""" ;
    ] .

<https://blackcatinformatics.ca/math/TangentSpaceDimensionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/TangentSpaceDimensionShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/DimensionMismatch> ;
    sh:targetClass <https://blackcatinformatics.ca/math/TangentSpace> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:TangentSpace's dimension does not equal its manifold's dimension (math:DimensionMismatch)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/tangentSpaceOf> ?m . ?m <https://blackcatinformatics.ca/math/manifoldDimension> ?md . $this <https://blackcatinformatics.ca/math/spaceDimension> ?sd . FILTER ( ?md != ?sd ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/TheoremWarrantConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/TheoremGroundingShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/math/UngroundedTheoremClaim> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Theorem> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Theorem must be warranted by either an in-graph math:Proof (some resource math:provesStatement it) or a declared math:externalWarrant; a theorem asserted with neither is an unwarranted truth-bit claim (math:UngroundedTheoremClaim)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { ?p <https://blackcatinformatics.ca/math/provesStatement> $this . } UNION { $this <https://blackcatinformatics.ca/math/externalWarrant> ?w . } } }""" ;
    ] .
