@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/places>
    a owl:Ontology ;
    rdfs:label "GMEOW Locations Module"@en ;
    rdfs:comment "Locations — geographic places, online (virtual) locations, and digital storage locations — with coordinates, geometry, containment, and external-gazetteer coreference (the schema.org / GeoSPARQL / GeoNames / Getty TGN / Wikidata / WGS84 superset layer). Place kinds are an open value vocabulary (gmeow:placeType), so any granularity from country to room can be a first-class, QID-bearing place chained by containedInPlace."@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Location umbrella + structural kinds (subclasses where structure differs)
# --------------------------------------------------------------------------- #

gmeow:Location
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Location"@en ;
    skos:definition "A locus where an entity can be situated, reside, or occur — a geographic place, an online (virtual) location, or a digital storage location."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Place
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Location ;
    rdfs:label "Place"@en ;
    skos:definition "A geographic location at any granularity — a country, region, city, thoroughfare, building, floor, or room. The specific kind is given by gmeow:placeType (a value), not a subclass, so any level can be a first-class place with its own coordinates and external identifiers."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:VirtualLocation
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Location ;
    rdfs:label "Virtual Location"@en ;
    skos:definition "A non-geographic location reachable online — a video-conference room, chat space, or metaverse room. Has an access locator and platform rather than coordinates."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:StorageLocation
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Location ;
    rdfs:label "Storage Location"@en ;
    skos:definition "A locus where digital objects reside — a cloud-storage folder, an object-store bucket, a filesystem path, a content-addressed store, or a physical disk. Its medium is a value (gmeow:storageMedium); a physical device may sit at a geographic gmeow:physicalPlace."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:GeoCoordinates
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity ;
    rdfs:label "Geo Coordinates"@en ;
    skos:definition "A geographic point expressed as latitude, longitude, and optional elevation."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Geometry
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Geometry"@en ;
    skos:definition "The spatial extent of a place — a point, line, or polygon — carrying a Well-Known Text (WKT) serialization for shapes richer than a single point (the GeoSPARQL geo:Geometry superset)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Place kind — a VALUE vocabulary (open; new kinds are individuals, not classes)
# --------------------------------------------------------------------------- #

gmeow:PlaceType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Place Type"@en ;
    skos:definition "The kind of a geographic place (country, region, city, building, room, …). Modelled as a value, not a Place subclass: the set of kinds is open-ended (GeoNames lists ~600 feature codes) and they share all of Place's structure, so a new kind is a new individual, not a new class."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:placeTypeCountry            a gmeow:PlaceType ; rdfs:label "country"@en .
gmeow:placeTypeAdministrativeArea a gmeow:PlaceType ; rdfs:label "administrative area"@en .
gmeow:placeTypeRegion             a gmeow:PlaceType ; rdfs:label "region / state / province"@en .
gmeow:placeTypeCity               a gmeow:PlaceType ; rdfs:label "city / populated place"@en .
gmeow:placeTypeNeighborhood       a gmeow:PlaceType ; rdfs:label "neighborhood"@en .
gmeow:placeTypeThoroughfare       a gmeow:PlaceType ; rdfs:label "thoroughfare / street"@en .
gmeow:placeTypePremises           a gmeow:PlaceType ; rdfs:label "premises / address point"@en .
gmeow:placeTypeBuilding           a gmeow:PlaceType ; rdfs:label "building"@en .
gmeow:placeTypeFloor              a gmeow:PlaceType ; rdfs:label "floor / level"@en .
gmeow:placeTypeRoom               a gmeow:PlaceType ; rdfs:label "room"@en .
gmeow:placeTypePointOfInterest    a gmeow:PlaceType ; rdfs:label "point of interest"@en .
gmeow:placeTypeNaturalFeature     a gmeow:PlaceType ; rdfs:label "natural feature"@en .

# --------------------------------------------------------------------------- #
# Storage medium — a VALUE vocabulary (open; individuals, not subclasses)
# --------------------------------------------------------------------------- #

gmeow:StorageMedium
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Storage Medium"@en ;
    skos:definition "The kind of medium a storage location uses (cloud service, local filesystem, object store, content-addressed store, physical disk, removable media). A value, not a StorageLocation subclass: the kinds share the same structure (path, service, holder, physical place)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:storageMediumCloudService     a gmeow:StorageMedium ; rdfs:label "cloud service"@en .
gmeow:storageMediumLocalFilesystem  a gmeow:StorageMedium ; rdfs:label "local filesystem"@en .
gmeow:storageMediumObjectStore      a gmeow:StorageMedium ; rdfs:label "object store"@en .
gmeow:storageMediumContentAddressed a gmeow:StorageMedium ; rdfs:label "content-addressed store"@en .
gmeow:storageMediumPhysicalDisk     a gmeow:StorageMedium ; rdfs:label "physical disk"@en .
gmeow:storageMediumRemovableMedia   a gmeow:StorageMedium ; rdfs:label "removable media"@en .

# --------------------------------------------------------------------------- #
# Relations (all non-functional — multi-source conflicts must coexist)
# --------------------------------------------------------------------------- #

gmeow:locatedAt
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:range gmeow:Location ;
    rdfs:label "located at"@en ;
    skos:definition "Relates an entity to a location it is situated at, resides in, or occurs at — geographic, virtual, or storage."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:storedIn
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:locatedAt ;
    rdfs:domain gmeow:Entity ;
    rdfs:range gmeow:StorageLocation ;
    rdfs:label "stored in"@en ;
    skos:definition "Relates a digital object (e.g. a document or import source) to the storage location where its bytes reside — the structured form of a source's location."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:containedInPlace
    a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:subPropertyOf gmeow:containedInLocation, gmeow:partOf ;
    rdfs:domain gmeow:Place ;
    rdfs:range gmeow:Place ;
    rdfs:label "contained in place"@en ;
    skos:definition "Relates a place to a larger place that geographically contains it; transitive. Chains the nested granularity (room ⊂ building ⊂ city ⊂ region ⊂ country), each level a first-class place."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasCoordinates
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Place ;
    rdfs:range gmeow:GeoCoordinates ;
    rdfs:label "has coordinates"@en ;
    skos:definition "Relates a place to its geographic point coordinates."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasGeometry
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Place ;
    rdfs:range gmeow:Geometry ;
    rdfs:label "has geometry"@en ;
    skos:definition "Relates a place to its spatial geometry (point, line, or polygon)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:placeType
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Place ;
    rdfs:range gmeow:PlaceType ;
    rdfs:label "place type"@en ;
    skos:definition "The kind(s) of a place (one or more gmeow:PlaceType individuals). Non-functional: multi-source classifications may differ (a place that is both 'city' and 'administrative area') and must coexist as evidence."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:storageMedium
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:StorageLocation ;
    rdfs:range gmeow:StorageMedium ;
    rdfs:label "storage medium"@en ;
    skos:definition "The medium of a storage location (a gmeow:StorageMedium individual). Functional: the medium is constitutive of the storage location (a different medium is a different store) — unlike the descriptive, multi-source gmeow:placeType."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:physicalPlace
    a owl:ObjectProperty ;
    rdfs:domain gmeow:StorageLocation ;
    rdfs:range gmeow:Place ;
    rdfs:label "physical place"@en ;
    skos:definition "The geographic place where a storage location's device physically sits (e.g. the room holding a disk). Absent for purely cloud storage."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Datatype properties (all non-functional)
# --------------------------------------------------------------------------- #

gmeow:latitude
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:GeoCoordinates ;
    rdfs:range xsd:decimal ;
    rdfs:label "latitude"@en ;
    skos:definition "The latitude of a geographic point in decimal degrees."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:longitude
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:GeoCoordinates ;
    rdfs:range xsd:decimal ;
    rdfs:label "longitude"@en ;
    skos:definition "The longitude of a geographic point in decimal degrees."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:elevation
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:GeoCoordinates ;
    rdfs:range xsd:decimal ;
    rdfs:label "elevation"@en ;
    skos:definition "Elevation above sea level in metres."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:asWKT
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Geometry ;
    rdfs:range rdfs:Literal ;
    rdfs:label "as WKT"@en ;
    skos:definition "A Well-Known Text (WKT) serialization of a geometry. The range is rdfs:Literal (not geo:wktLiteral) to stay within the OWL 2 DL datatype map; data may still tag the literal ^^geo:wktLiteral, and the alignment to geo:asWKT preserves GeoSPARQL semantics for spatial engines."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:accessUrl
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:VirtualLocation ;
    rdfs:range xsd:anyURI ;
    rdfs:label "access URL"@en ;
    skos:definition "The join/access URL of a virtual location."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:virtualPlatform
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:VirtualLocation ;
    rdfs:range rdfs:Literal ;
    rdfs:label "virtual platform"@en ;
    skos:definition "The platform hosting a virtual location (Zoom, Meet, a chat service, …)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:storageService
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:StorageLocation ;
    rdfs:range rdfs:Literal ;
    rdfs:label "storage service"@en ;
    skos:definition "The service or system hosting a storage location (e.g. \"Google Drive\", \"AWS S3\", \"local\")."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:storagePath
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:StorageLocation ;
    rdfs:range rdfs:Literal ;
    rdfs:label "storage path"@en ;
    skos:definition "The path, key, or URI of a storage location within its service."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:timezone
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Location ;
    rdfs:range rdfs:Literal ;
    rdfs:label "timezone"@en ;
    skos:definition "An IANA time-zone identifier for a location (e.g. \"America/Edmonton\"). Non-functional: a large place may span several zones."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Reference Frame Profile & Coordinate System Framework (#65)
# --------------------------------------------------------------------------- #

gmeow:ReferenceFrame
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Reference Frame"@en ;
    skos:definition "A reference system (such as a coordinate system, datum, grid, or platform space) relative to which locations, coordinates, or measurements are expressed."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Axis
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Axis"@en ;
    skos:definition "A coordinate axis or dimension of a reference frame (e.g. X, Y, Z, latitude, longitude, elevation, time)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:SpatialCoordinates
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Spatial Coordinates"@en ;
    skos:definition "A set of coordinate values representing a position in a specific coordinate reference frame."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:SpatialRealm
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Spatial Realm"@en ;
    skos:definition "The physical, virtual, or conceptual domain of a reference frame (e.g. terrestrial, indoor, celestial, virtual)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:FrameKind
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Frame Kind"@en ;
    skos:definition "The structural type of a reference frame (e.g. geodetic, Cartesian, polar, grid, narrative)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:LocationState
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Location State"@en ;
    skos:definition "The state of a moving entity at a specific point or period in time, including its location, velocity, and orientation."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Trajectory
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Trajectory"@en ;
    skos:definition "A continuous path of motion representing the space-time history of a moving entity."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# Seeds for Spatial Realm
gmeow:spatialRealmTerrestrial a gmeow:SpatialRealm ; rdfs:label "terrestrial"@en .
gmeow:spatialRealmIndoor     a gmeow:SpatialRealm ; rdfs:label "indoor"@en .
gmeow:spatialRealmVirtual    a gmeow:SpatialRealm ; rdfs:label "virtual / network"@en .
gmeow:spatialRealmCelestial  a gmeow:SpatialRealm ; rdfs:label "celestial / astronomical"@en .
gmeow:spatialRealmRobotic    a gmeow:SpatialRealm ; rdfs:label "robotic"@en .

# Seeds for Frame Kind
gmeow:frameKindGeodetic      a gmeow:FrameKind ; rdfs:label "geodetic"@en .
gmeow:frameKindCartesian     a gmeow:FrameKind ; rdfs:label "cartesian"@en .
gmeow:frameKindPolar         a gmeow:FrameKind ; rdfs:label "polar"@en .
gmeow:frameKindGrid          a gmeow:FrameKind ; rdfs:label "grid"@en .

# Seeds for GranularityLevel — the spatial resolution axis (#79; class in core).
# Ordered coarse→fine by gmeow:coarserThan (transitive, so country is coarser than
# every finer level). Aligned by reference to gmeow:placeType (the place kind at
# that level) and, through it, to ISO 19112 LocationType / gazetteer tiers.
gmeow:granularityCountry a gmeow:GranularityLevel ; rdfs:label "country level"@en ;
    gmeow:coarserThan gmeow:granularityRegion ; skos:closeMatch gmeow:placeTypeCountry .
gmeow:granularityRegion  a gmeow:GranularityLevel ; rdfs:label "region level"@en ;
    gmeow:coarserThan gmeow:granularityCity ; skos:closeMatch gmeow:placeTypeRegion .
gmeow:granularityCity    a gmeow:GranularityLevel ; rdfs:label "city level"@en ;
    gmeow:coarserThan gmeow:granularityAddress ; skos:closeMatch gmeow:placeTypeCity .
gmeow:granularityAddress a gmeow:GranularityLevel ; rdfs:label "address level"@en ;
    gmeow:coarserThan gmeow:granularityPoint ; skos:closeMatch gmeow:placeTypePremises .
gmeow:granularityPoint   a gmeow:GranularityLevel ; rdfs:label "point / exact coordinate level"@en .

# Axes individuals
gmeow:axisLatitude         a gmeow:Axis ; rdfs:label "latitude"@en .
gmeow:axisLongitude        a gmeow:Axis ; rdfs:label "longitude"@en .
gmeow:axisElevation        a gmeow:Axis ; rdfs:label "elevation"@en .
gmeow:axisX                a gmeow:Axis ; rdfs:label "X axis"@en .
gmeow:axisY                a gmeow:Axis ; rdfs:label "Y axis"@en .
gmeow:axisZ                a gmeow:Axis ; rdfs:label "Z axis"@en .
gmeow:axisVirtualAddress   a gmeow:Axis ; rdfs:label "virtual address axis"@en .
gmeow:axisRightAscension   a gmeow:Axis ; rdfs:label "right ascension"@en .
gmeow:axisDeclination      a gmeow:Axis ; rdfs:label "declination"@en .

# Default Reference Frames for the seed realms
gmeow:referenceFrameWGS84
    a gmeow:ReferenceFrame ;
    rdfs:label "WGS 84 Geodetic Reference Frame"@en ;
    gmeow:frameRealm gmeow:spatialRealmTerrestrial ;
    gmeow:hasAxis gmeow:axisLatitude, gmeow:axisLongitude, gmeow:axisElevation ;
    gmeow:dimensionCount "3"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindGeodetic ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp .

gmeow:referenceFrameLocalGrid
    a gmeow:ReferenceFrame ;
    rdfs:label "Local Grid Cartesian Reference Frame"@en ;
    gmeow:frameRealm gmeow:spatialRealmIndoor ;
    gmeow:hasAxis gmeow:axisX, gmeow:axisY, gmeow:axisZ ;
    gmeow:dimensionCount "3"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindCartesian ;
    gmeow:requiresHost true ;
    gmeow:determinacyModel gmeow:determinacyCrisp .

gmeow:referenceFrameVirtualPlatform
    a gmeow:ReferenceFrame ;
    rdfs:label "Virtual Platform Reference Frame"@en ;
    gmeow:frameRealm gmeow:spatialRealmVirtual ;
    gmeow:hasAxis gmeow:axisVirtualAddress ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindGrid ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp .

gmeow:referenceFrameCelestialEquatorial
    a gmeow:ReferenceFrame ;
    rdfs:label "Celestial Equatorial Reference Frame"@en ;
    gmeow:frameRealm gmeow:spatialRealmCelestial ;
    gmeow:hasAxis gmeow:axisRightAscension, gmeow:axisDeclination ;
    gmeow:dimensionCount "2"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindPolar ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp .

gmeow:referenceFrameRobotBase
    a gmeow:ReferenceFrame ;
    rdfs:label "Robot Base Cartesian Reference Frame"@en ;
    gmeow:frameRealm gmeow:spatialRealmRobotic ;
    gmeow:hasAxis gmeow:axisX, gmeow:axisY, gmeow:axisZ ;
    gmeow:dimensionCount "3"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindCartesian ;
    gmeow:requiresHost true ;
    gmeow:determinacyModel gmeow:determinacyCrisp .

# Reference Frame Profile Properties
gmeow:frameRealm
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ReferenceFrame ;
    rdfs:range gmeow:SpatialRealm ;
    rdfs:label "frame realm"@en ;
    skos:definition "Relates a reference frame to the spatial realm it describes."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasAxis
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ReferenceFrame ;
    rdfs:range gmeow:Axis ;
    rdfs:label "has axis"@en ;
    skos:definition "Relates a reference frame to one of its coordinate axes."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:dimensionCount
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ReferenceFrame ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "dimension count"@en ;
    skos:definition "The number of dimensions spanned by a reference frame."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:frameKind
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ReferenceFrame ;
    rdfs:range gmeow:FrameKind ;
    rdfs:label "frame kind"@en ;
    skos:definition "Relates a reference frame to its structural frame kind."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:requiresHost
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ReferenceFrame ;
    rdfs:range xsd:boolean ;
    rdfs:label "requires host"@en ;
    skos:definition "Asserts whether a reference frame requires a hosting entity to exist."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:parentFrame
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ReferenceFrame ;
    rdfs:range gmeow:ReferenceFrame ;
    rdfs:label "parent frame"@en ;
    skos:definition "Relates a reference frame to its parent frame in a hierarchy."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:transformsTo
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ReferenceFrame ;
    rdfs:range gmeow:ReferenceFrame ;
    rdfs:label "transforms to"@en ;
    skos:definition "Relates a reference frame to another frame it can be mathematically transformed to."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:frameSolver
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ReferenceFrame ;
    rdfs:range rdfs:Literal ;
    rdfs:label "frame solver"@en ;
    skos:definition "Identifies the external solver or transformation method to resolve coordinates in this frame."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:determinacyModel
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ReferenceFrame ;
    rdfs:range gmeow:Determinacy ;
    rdfs:label "determinacy model"@en ;
    skos:definition "Relates a reference frame to its default determinacy model."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# Coordinate Properties
gmeow:coordinateFrame
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:SpatialCoordinates ;
    rdfs:range gmeow:ReferenceFrame ;
    rdfs:label "coordinate frame"@en ;
    skos:definition "Relates a set of coordinates to the reference frame they are expressed in."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasCoordinateMatrix
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Axis ;
    rdfs:range rdfs:Literal ;
    rdfs:label "has coordinate matrix"@en ;
    skos:definition "Specifies a transformation or projection matrix associated with a coordinate axis."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# Universal Topology Relations
gmeow:containedInLocation
    a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:subPropertyOf gmeow:partOf ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "contained in location"@en ;
    skos:definition "Relates a location to a larger location that contains it; transitive. A spatial/topological specialization of the universal gmeow:partOf spine."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:adjacentTo
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "adjacent to"@en ;
    skos:definition "Relates a location to another location it is adjacent to."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:connectsTo
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "connects to"@en ;
    skos:definition "Relates a location to another location it connects to."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# RCC-8 JEPD Relations
gmeow:rcc8dc
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "rcc8 dc"@en ;
    skos:definition "RCC-8: Disconnected (DC) — regions are disjoint and do not share any point."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:rcc8ec
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "rcc8 ec"@en ;
    skos:definition "RCC-8: Externally Connected (EC) — regions share only boundary points."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:rcc8po
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "rcc8 po"@en ;
    skos:definition "RCC-8: Partial Overlap (PO) — regions overlap but neither is part of the other."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:rcc8tpp
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:containedInLocation, gmeow:partOf ;
    owl:inverseOf gmeow:rcc8tppi ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "rcc8 tpp"@en ;
    skos:definition "RCC-8: Tangential Proper Part (TPP) — region is a proper part of another, sharing part of its boundary."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:rcc8ntpp
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:containedInLocation, gmeow:partOf ;
    owl:inverseOf gmeow:rcc8ntppi ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "rcc8 ntpp"@en ;
    skos:definition "RCC-8: Non-Tangential Proper Part (NTPP) — region is a proper part of another, entirely within its interior."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:rcc8tppi
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasPart ;
    owl:inverseOf gmeow:rcc8tpp ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "rcc8 tppi"@en ;
    skos:definition "RCC-8: Tangential Proper Part Inverse (TPPi) — inverse of TPP."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:rcc8ntppi
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasPart ;
    owl:inverseOf gmeow:rcc8ntpp ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "rcc8 ntppi"@en ;
    skos:definition "RCC-8: Non-Tangential Proper Part Inverse (NTPPi) — inverse of NTPP."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:rcc8eq
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain gmeow:Location ;
    rdfs:range gmeow:Location ;
    rdfs:label "rcc8 eq"@en ;
    skos:definition "RCC-8: Equal (EQ) — regions are identical."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# Pairwise-disjoint declaration of the RCC-8 base relations. The RCC-8 set is
# conceptually Jointly Exhaustive and Pairwise Disjoint (JEPD), but OWL's
# owl:AllDisjointProperties only encodes the pairwise disjointness; exhaustiveness
# (that every region pair stands in exactly one of these relations) is not asserted.
[] a owl:AllDisjointProperties ;
   owl:members (
       gmeow:rcc8dc
       gmeow:rcc8ec
       gmeow:rcc8po
       gmeow:rcc8tpp
       gmeow:rcc8ntpp
       gmeow:rcc8tppi
       gmeow:rcc8ntppi
       gmeow:rcc8eq
   ) .

# Multilingual / historical place names are NOT a flat literal: a place bears
# co-equal gmeow:PlaceName appellations via gmeow:hasPlaceName (names module),
# their endonym/exonym purpose, language frame and toponymic authority carried by
# the inferred gmeow:PlaceNaming (≡ NameUsage ⊓ ∃usageNamed.Place). The former
# flat gmeow:alternateName literal was retired in favour of that model (Principle 6).

# Future: gmeow:adjacentTo (symmetric place topology) and time-varying place
# facts (renames, boundary/jurisdiction changes) reified over the temporal
# module's gmeow:TimeScopedRelation — deferred; no current consumer.

# =========================================================================== #
# AXIOMATIZED DOCTRINE (#38 — phase 2 of the reasoning-depth epic #35)
#
# Location propagates through geographic containment: a thing located AT a place
# is located at every place that CONTAINS it (a desk in a room is in the
# building, the city, the country). Expressed as the EL property chain
# locatedAt ∘ containedInLocation ⊑ locatedAt. gmeow:containedInLocation is already
# transitive (room ⊂ city is derived), so the two compose. This is the regular
# R ∘ S ⊑ R form (containedInLocation ≺ locatedAt); locatedAt thereby becomes
# non-simple and is kept out of all cardinality axioms, preserving OWL 2 DL.
# =========================================================================== #

gmeow:locatedAt owl:propertyChainAxiom ( gmeow:locatedAt gmeow:containedInLocation ) .
