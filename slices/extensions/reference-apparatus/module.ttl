    logic:formalizes gmeow:formalKind ;
    logic:message "A block classified as formal exposition retains at least one source-attributed printed formal kind. The vocabulary remains open and the kind establishes no theorem or proof status." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation gmeow:segmentType ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                    [ logic:termIndex 1 ; logic:termIri gmeow:segmentTypeFormalBlock ] ] ;
            logic:consequent [ a logic:Formula ;
                logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "kind" ] ;
                logic:exists [ a logic:Formula ; logic:relation gmeow:formalKind ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "kind" ] ] ] ] ] .

gmeow:EquationSourceSurfaceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "equation source surface retention"@x-gmeow-english ;
    skos:definition "Every supplied equation-source string has a retained language surface carrying that exact text. Retention does not parse the string or certify mathematical meaning."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency of the supplied source inventory."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this obligation executes a producer, parser, proof checker or table renderer."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact source evidence when a supplied structure violates the obligation; never repair it with invented defaults."@x-gmeow-english ;
