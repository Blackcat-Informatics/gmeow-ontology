@prefix ev: <https://blackcatinformatics.ca/gmeow/evals/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ev:assessment-reference-baseline-abstention-quality a gmeow:Assessment ;
    gmeow:assessmentCriterion ev:crit-abstention ;
    gmeow:assessmentRubric ev:rubric ;
    gmeow:assessmentScoreValue 1.0 ;
    gmeow:assessmentTarget ev:model-reference-baseline ;
    gmeow:vantage ev:harness .

