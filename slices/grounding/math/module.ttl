math:ndA2 a logic:Formula ; logic:relation math:lessThanRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] .
math:ndA3 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "x" ] , [ logic:termIndex 2 ; logic:termVariable "u" ] .
math:ndA4 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] , [ logic:termIndex 2 ; logic:termVariable "v" ] .

math:monotoneNonDecreaseCons a logic:Formula ; logic:relation math:lessOrEqualRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "u" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .

# --- Law: constant map ------------------------------------------------------ #
# ∀f,x,y,u,v: hasMonotonicity(f, constant) ∧ functionValue(f,x,u)
#   ∧ functionValue(f,y,v) → realEqual(u,v)
# No order atom: a constant function's value is the same at ANY two points.
math:constantMapLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "constant: f(x) = f(y) for all x, y"@x-gmeow-english ;
    skos:definition "The defining law of math:constant as a universally-quantified first-order logic:Formula over the reified real/value signature: for a function f declared constant, if f takes value u at x and v at y, then u = v — its value never changes, regardless of the order of x and y. The degenerate limit of both weak monotonicity sorts, so it carries no order atom."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "f" ] ,
        [ logic:termIndex 1 ; logic:termVariable "x" ] ,
        [ logic:termIndex 2 ; logic:termVariable "y" ] ,
        [ logic:termIndex 3 ; logic:termVariable "u" ] ,
        [ logic:termIndex 4 ; logic:termVariable "v" ] ;
    logic:forall math:constantMapImpl .

math:constantMapImpl a logic:Formula ;
    logic:antecedent math:constantMapAnte ;
    logic:consequent math:constantMapCons .

math:constantMapAnte a logic:Formula ;
    logic:and math:cmA1 , math:cmA2 , math:cmA3 .

math:cmA1 a logic:Formula ; logic:relation math:hasMonotonicityRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termIri math:constant ] .
math:cmA2 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "x" ] , [ logic:termIndex 2 ; logic:termVariable "u" ] .
math:cmA3 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] , [ logic:termIndex 2 ; logic:termVariable "v" ] .

math:constantMapCons a logic:Formula ; logic:relation math:realEqualRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "u" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .

# --- Law: non-affinity ------------------------------------------------------ #
# ∀f: hasAnalyticProperty(f, nonAffinity) → ∃x,y,z,u,v,w:
#   functionValue(f,x,u) ∧ functionValue(f,y,v) ∧ functionValue(f,z,w)
#   ∧ affineCombination(z,x,y) ∧ ¬collinear(x,u,y,v,z,w)
# The defining law of math:nonAffinity, authored as a first-order logic:Formula
# whose consequent is an EXISTENTIAL witness of a collinearity failure, mirroring
# the existential/negation shape of math:connectednessLaw: a non-affine function
# has three graph points — one over an interior point of a chord — off the line.
math:nonAffinityLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "non-affinity: the graph has three non-collinear points over a chord"@x-gmeow-english ;
    skos:definition "The defining law of math:nonAffinity as a first-order logic:Formula over the reified real/value signature: for a function f declared non-affine, there exist domain points x, y, z with z a proper affine combination of x and y, and graph values u = f(x), v = f(y), w = f(z), such that the three plane points (x,u), (y,v), (z,w) are NOT collinear. math: expresses the law; logic: owns reasoning over it. It uses logic:exists and logic:not exactly as math:connectednessLaw does; the midpoint/affine combination and collinearity are reified as uninterpreted relations, never invented arithmetic functions."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "f" ] ;
    logic:forall math:nonAffinityImpl .

math:nonAffinityImpl a logic:Formula ;
    logic:antecedent math:nonAffinityAnte ;
    logic:consequent math:nonAffinityWitness .

math:nonAffinityAnte a logic:Formula ; logic:relation math:hasAnalyticPropertyRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termIri math:nonAffinity ] .

math:nonAffinityWitness a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "x" ] ,
        [ logic:termIndex 1 ; logic:termVariable "y" ] ,
        [ logic:termIndex 2 ; logic:termVariable "z" ] ,
        [ logic:termIndex 3 ; logic:termVariable "u" ] ,
        [ logic:termIndex 4 ; logic:termVariable "v" ] ,
        [ logic:termIndex 5 ; logic:termVariable "w" ] ;
    logic:exists math:nonAffinityWitnessBody .

math:nonAffinityWitnessBody a logic:Formula ;
    logic:and math:naA1 , math:naA2 , math:naA3 , math:naA4 , math:naA5 .

math:naA1 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "x" ] , [ logic:termIndex 2 ; logic:termVariable "u" ] .
math:naA2 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] , [ logic:termIndex 2 ; logic:termVariable "v" ] .
math:naA3 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "z" ] , [ logic:termIndex 2 ; logic:termVariable "w" ] .
math:naA4 a logic:Formula ; logic:relation math:affineCombinationRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "z" ] , [ logic:termIndex 1 ; logic:termVariable "x" ] , [ logic:termIndex 2 ; logic:termVariable "y" ] .
math:naA5 a logic:Formula ; logic:not math:naCollinear .

math:naCollinear a logic:Formula ; logic:relation math:collinearRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "u" ] , [ logic:termIndex 2 ; logic:termVariable "y" ] , [ logic:termIndex 3 ; logic:termVariable "v" ] , [ logic:termIndex 4 ; logic:termVariable "z" ] , [ logic:termIndex 5 ; logic:termVariable "w" ] .

# --- Law: convexity (honestly-expressible midpoint form) -------------------- #
# ∀f: hasAnalyticProperty(f, convexity) → ∀x,y,m,u,v,w,z:
#   functionValue(f,x,u) ∧ functionValue(f,y,v) ∧ midpoint(m,x,y)
#   ∧ functionValue(f,m,w) ∧ midpoint(z,u,v) → lessOrEqual(w,z)
# i.e. f((x+y)/2) ≤ (f(x)+f(y))/2. The full λ-chord inequality quantifies over
# the continuum of weights λ and needs scalar arithmetic on the values; the
# midpoint form is the faithful first-order fragment (the midpoint reified as an
# uninterpreted relation), the λ-general residue disclosed rather than faked.
math:convexityLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "convexity (midpoint form): f((x+y)/2) ≤ (f(x)+f(y))/2"@x-gmeow-english ;
    skos:definition "The defining law of math:convexity as a first-order logic:Formula over the reified real/value signature, in the honestly-expressible MIDPOINT form: for a function f declared convex, for all x, y with domain midpoint m = (x+y)/2 and value midpoint z = (f(x)+f(y))/2, the value w = f(m) satisfies w ≤ z. math: expresses the law; logic: owns reasoning over it. The full λ-chord inequality f(λx+(1−λ)y) ≤ λf(x)+(1−λ)f(y) quantifies over the continuum of λ and needs scalar arithmetic on values, exceeding the first-order fragment without inventing arithmetic function symbols; the midpoint form (reifying the midpoint as the uninterpreted relation math:midpointRel, as math:preimageRel reifies the preimage) is the faithful first-order law, and the λ-general residue is disclosed here, never silently faked."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "f" ] ;
    logic:forall math:convexityOuterImpl .

math:convexityOuterImpl a logic:Formula ;
    logic:antecedent math:convexityGuard ;
    logic:consequent math:convexityInner .

math:convexityGuard a logic:Formula ; logic:relation math:hasAnalyticPropertyRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termIri math:convexity ] .

math:convexityInner a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "x" ] ,
        [ logic:termIndex 1 ; logic:termVariable "y" ] ,
        [ logic:termIndex 2 ; logic:termVariable "m" ] ,
        [ logic:termIndex 3 ; logic:termVariable "u" ] ,
        [ logic:termIndex 4 ; logic:termVariable "v" ] ,
        [ logic:termIndex 5 ; logic:termVariable "w" ] ,
        [ logic:termIndex 6 ; logic:termVariable "z" ] ;
    logic:forall math:convexityInnerImpl .

math:convexityInnerImpl a logic:Formula ;
    logic:antecedent math:convexityChordAnte ;
    logic:consequent math:convexityChordCons .

math:convexityChordAnte a logic:Formula ;
    logic:and math:cxA1 , math:cxA2 , math:cxA3 , math:cxA4 , math:cxA5 .

math:cxA1 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "x" ] , [ logic:termIndex 2 ; logic:termVariable "u" ] .
math:cxA2 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "y" ] , [ logic:termIndex 2 ; logic:termVariable "v" ] .
math:cxA3 a logic:Formula ; logic:relation math:midpointRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "m" ] , [ logic:termIndex 1 ; logic:termVariable "x" ] , [ logic:termIndex 2 ; logic:termVariable "y" ] .
math:cxA4 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "m" ] , [ logic:termIndex 2 ; logic:termVariable "w" ] .
math:cxA5 a logic:Formula ; logic:relation math:midpointRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "z" ] , [ logic:termIndex 1 ; logic:termVariable "u" ] , [ logic:termIndex 2 ; logic:termVariable "v" ] .

math:convexityChordCons a logic:Formula ; logic:relation math:lessOrEqualRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "w" ] , [ logic:termIndex 1 ; logic:termVariable "z" ] .

# --- Law: boundedness on an interval ---------------------------------------- #
# ∀f,e,I,x,v: hasBound(f,e) ∧ boundOnInterval(f,I) ∧ inInterval(x,I)
#   ∧ functionValue(f,x,v) → absBound(v,e)
# i.e. |f(x)| ≤ ε for every x in the declared interval — the near-zero plateau's
# defining VALUE property, distinct from measure dominance over an integral.
math:boundednessLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "boundedness: |f(x)| ≤ ε for every x in the interval"@x-gmeow-english ;
    skos:definition "The defining law of math:boundedness as a universally-quantified first-order logic:Formula over the reified real/value signature: for a function f declaring a magnitude bound ε (math:hasBound) that holds on an interval I (math:boundOnInterval), if x lies in I and f takes value v at x, then |v| ≤ ε. math: expresses the law; logic: owns reasoning over it. It is the near-zero plateau's defining VALUE property — a bound on the function's magnitude — distinct from measure dominance (a bound on an integral); the bound is scoped to a region, never global by default."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "f" ] ,
        [ logic:termIndex 1 ; logic:termVariable "e" ] ,
        [ logic:termIndex 2 ; logic:termVariable "I" ] ,
        [ logic:termIndex 3 ; logic:termVariable "x" ] ,
        [ logic:termIndex 4 ; logic:termVariable "v" ] ;
    logic:forall math:boundednessImpl .

math:boundednessImpl a logic:Formula ;
    logic:antecedent math:boundednessAnte ;
    logic:consequent math:boundednessCons .

math:boundednessAnte a logic:Formula ;
    logic:and math:bdA1 , math:bdA2 , math:bdA3 , math:bdA4 .

math:bdA1 a logic:Formula ; logic:relation math:hasBoundRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "e" ] .
math:bdA2 a logic:Formula ; logic:relation math:boundOnIntervalRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "I" ] .
math:bdA3 a logic:Formula ; logic:relation math:inIntervalRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] , [ logic:termIndex 1 ; logic:termVariable "I" ] .
math:bdA4 a logic:Formula ; logic:relation math:functionValueRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termVariable "x" ] , [ logic:termIndex 2 ; logic:termVariable "v" ] .

math:boundednessCons a logic:Formula ; logic:relation math:absBoundRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "v" ] , [ logic:termIndex 1 ; logic:termVariable "e" ] .

# --- Boundary: smoothness — an honest recorded second-order boundary --------- #
# Smoothness (C^∞ / real-analyticity) quantifies over the INFINITE FAMILY of all
# derivatives, so — unlike math:nonAffinityLaw/math:convexityLaw/math:boundednessLaw,
# which ARE first-order — it has NO first-order logic:Formula to author. It is
# recorded here as an honest loss-ledger boundary carrying logic:expressivenessBoundary
# logic:SecondOrder and logic:preservationKind logic:Unsupported, exactly as
# math:compactnessBoundary is, and never faked as a first-order formula.
math:smoothnessBoundary
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "smoothness: an honest recorded second-order boundary (no first-order formula)"@x-gmeow-english ;
    logic:expressivenessBoundary logic:SecondOrder ;
    logic:preservationKind logic:Unsupported ;
    skos:definition "The loss-ledger boundary record backing math:smoothness: smoothness (C^∞ / real-analyticity, 'the function has derivatives of every order') is genuinely second-order — it ∀-quantifies over the INFINITE FAMILY of all derivatives {f, f′, f″, …}, a quantification over an unbounded family of functions that is not first-order axiomatizable. HiLog reflection could reify a single derivative, but 'for all n, the n-th derivative exists' ranges over the whole family, so a first-order witness would be an unsound uninterpreted predicate. Hence smoothness is carried as an honest boundary (logic:expressivenessBoundary logic:SecondOrder, logic:preservationKind logic:Unsupported), residue disclosed in the ledger and never silent prose (Principle 17). Contrast its siblings math:nonAffinityLaw, math:convexityLaw, and math:boundednessLaw, which ARE first-order logic:Formula laws, exactly as math:compactnessBoundary contrasts with math:continuityLaw and math:connectednessLaw."@x-gmeow-english .

# =========================================================================== #
# External-corpus coverage families
#
# These are general mathematical referents needed by the pinned external-corpus
# crosswalk.  They are shipped grounding vocabulary, not project-local aliases:
# the project-specific analytical recipes are compositions of these terms and
# remain outside the ontology.  In particular, a dimensional coincidence never
# establishes an E8/Clifford representation; that requires an explicit faithful
# representation and equivariant map.
# =========================================================================== #

# --- Computational topology ------------------------------------------------ #

math:CellComplex
    a owl:Class ; logic:subClassOf math:TopologicalSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cell Complex"@x-gmeow-english ;
    skos:definition "A topological space assembled from cells by attaching each cell boundary to lower-dimensional cells. It is not merely a partition or mesh: cell dimensions and attaching maps are constitutive."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SimplicialComplex
    a owl:Class ; logic:subClassOf math:CellComplex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Simplicial Complex"@x-gmeow-english ;
    skos:definition "A cell complex whose cells are simplices and which is closed under taking faces, with intersections occurring along common faces. It is not an arbitrary cell complex: simplex cells and face closure are required."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ChainComplex
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Chain Complex"@x-gmeow-english ;
    rdfs:seeAlso math:boundarySquareZeroLaw ;
    math:definingLaw math:boundarySquareZeroLaw ;
    skos:definition "A graded sequence of modules connected by boundary maps whose consecutive composite is zero. It is not a graded collection alone: the square-zero boundary law is constitutive. That square-zero condition ∂∘∂ = 0 is authored in machine form as the first-order logic:Formula math:boundarySquareZeroLaw (math:definingLaw), scoped to regular/simplicial complexes as the combinatorial diamond involution; the general-CW per-instance finite sum is enforced by math:GeneralBoundarySquareZeroConstraint, and the universal class law is the honest boundary math:cellBoundarySumBoundary. It names its boundary operator through math:chainBoundary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BoundaryOperator
    a owl:Class ; logic:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Boundary Operator"@x-gmeow-english ;
    rdfs:seeAlso math:boundarySquareZeroLaw ;
    math:definingLaw math:boundarySquareZeroLaw ;
    skos:definition "The degree-minus-one operation on a chain complex whose square is zero and whose homology records cycles modulo boundaries. It is not a generic derivative or an untyped geometric boundary operation. Its square-is-zero condition ∂∘∂ = 0 is authored in machine form as the first-order logic:Formula math:boundarySquareZeroLaw (math:definingLaw); the coboundary is its adjoint (math:boundaryCoboundaryAdjunctionLaw, δ = ∂*)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CoboundaryOperator
    a owl:Class ; logic:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Coboundary Operator"@x-gmeow-english ;
    rdfs:seeAlso math:coboundarySquareZeroLaw ;
    math:definingLaw math:coboundarySquareZeroLaw ;
    skos:definition "The degree-plus-one operation on a cochain complex, dual to a boundary operator, whose square is zero. It is not an arbitrary delta operator: the cochain grading and square-zero law are required. Its square-is-zero condition δ∘δ = 0 is authored in machine form as the first-order logic:Formula math:coboundarySquareZeroLaw (math:definingLaw), the transposed dual of the boundary law; it is the adjoint of the boundary operator (math:coboundaryAdjoint, math:boundaryCoboundaryAdjunctionLaw)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Graded cells, incidence, and orientation ------------------------------ #
# The building blocks a math:CellComplex is assembled from: a graded math:Cell,
# the reified signed math:CellIncidence carrying the ±1 boundary coefficient, and
# the open math:CellOrientation vocabulary. math:incidentTo is the unsigned
# codimension-1 face relation the boundary operator runs over; it is load-bearing
# for the boundary-square-zero law (∂∘∂ = 0), which is enforced downstream by the
# boundary-square-zero constraint predicating over it. This surface covers the
# PRESENCE of the boundary sign; the COHERENCE of the signs is a separate law.

math:Cell
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cell"@x-gmeow-english ;
    skos:definition "One graded cell of a math:CellComplex: an n-dimensional building block — a 0-cell vertex, a 1-cell edge, a 2-cell face, and so on — whose grade n is fixed by math:cellDimension and whose codimension-1 faces are named through math:incidentTo. A subclass of math:MathematicalObject that carries its own grade and, optionally, its math:orientation. It is NOT the whole math:CellComplex it belongs to, NOT a math:SheafStalk sitting over a cell, and NOT a math:BettiNumber counting cells of a grade — it is a single graded cell, and a cell whose dimension is left implicit is ill-formed (math:IncompleteCell)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CellIncidence
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cell Incidence"@x-gmeow-english ;
    skos:definition "A reified, signed incidence between a coface and one of its codimension-1 faces: it names the higher cell (math:incidenceCoface), the lower cell (math:incidenceFace), and the exact orientation sign ±1 (math:incidenceSign) that the boundary operator attaches to that face. A subclass of math:MathematicalObject reifying one entry of the signed boundary (incidence) matrix so the sign is inspectable. It is NOT bare set-membership and NOT the unsigned math:incidentTo adjacency, and NOT a math:SheafRestrictionMap transporting stalk data along an incidence — it is the signed boundary coefficient itself. An incidence missing its coface, face, or sign is ill-formed (math:UnorientedIncidence)."@x-gmeow-english ;
    skos:scopeNote "This class carries the PRESENCE of a boundary sign on a single incidence. The COHERENCE of the signs — that composing incidences around any cell makes the twice-applied boundary vanish (∂∘∂ = 0) — is enforced downstream by the boundary-square-zero constraint predicating over math:incidentTo, not here: this surface covers sign presence, that constraint covers sign coherence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CellOrientation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cell Orientation"@x-gmeow-english ;
    skos:definition "The orientation a math:Cell carries: the chosen sign of an ordering of the cell — one of math:positivelyOriented or math:negativelyOriented. An OPEN vocabulary of math:NamedIndividuals (never an owl:oneOf enumeration), exactly like math:MonotonicityKind, so a new orientation convention joins by minting an individual. A cell names its orientation through math:orientation. It is NOT the incidence sign ±1 (that is math:incidenceSign on a math:CellIncidence) and NOT a numeric coordinate — it is the qualitative choice of the cell's own orientation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Reach for it as the type of a cell's chosen orientation — the reference (+) sense or its reversal (−)."@x-gmeow-english ;
    gmeow:avoidWhen "Do not model it as an owl:oneOf enumeration and do not conflate it with the ±1 math:incidenceSign; a new orientation convention joins by minting a math:NamedIndividual."@x-gmeow-english ;
    gmeow:howToUse "Attach one of its members to a math:Cell through math:orientation."@x-gmeow-english ;
    skos:example "exg:faceABC math:orientation math:positivelyOriented ."@x-gmeow-english .

math:positivelyOriented
    a owl:NamedIndividual , math:CellOrientation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "positively oriented"@x-gmeow-english ;
    skos:definition "Positive orientation: the math:CellOrientation naming a cell's chosen ordering as the reference (+) orientation. A member of the open math:CellOrientation vocabulary; it is the orientation whose signed boundary the math:incidenceSign coefficients are read relative to."@x-gmeow-english .

math:negativelyOriented
    a owl:NamedIndividual , math:CellOrientation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "negatively oriented"@x-gmeow-english ;
    skos:definition "Negative orientation: the math:CellOrientation naming the reversal of the reference ordering — the (−) orientation. A member of the open math:CellOrientation vocabulary; reversing a cell's orientation flips the sign the boundary operator attaches to it."@x-gmeow-english .

math:cellDimension
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "cell dimension (grade)"@x-gmeow-english ;
    skos:definition "Relates a math:Cell to the math:NaturalNumber that is its grade n — 0 for a vertex, 1 for an edge, 2 for a face, and so on. Domain math:Cell, range math:NaturalNumber (stated in prose). The single canonical carrier of a cell's grade: 'grade' is only a synonym in this label, never a second property (there is no math:grade). A cell whose dimension is left implicit is ill-formed (math:IncompleteCell)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasCell
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has cell"@x-gmeow-english ;
    skos:definition "Relates a math:CellComplex to one of the math:Cells it is assembled from. Domain math:CellComplex, range math:Cell (stated in prose). The complex names its cells explicitly rather than leaving them implicit in a mesh or partition, so each cell's grade and incidences are first-class and inspectable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:incidentTo
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "incident to"@x-gmeow-english ;
    skos:definition "Relates a math:Cell to a codimension-1 face of it — the lower-dimensional cell attached along its boundary. Domain math:Cell, range math:Cell (stated in prose). This is the unsigned face relation the boundary operator runs over, and it is load-bearing for the boundary-square-zero law (∂∘∂ = 0): the downstream boundary-square-zero constraint predicates over this relation. It is NOT the signed math:CellIncidence — the ±1 sign lives on the reified incidence; this names only which cell is a codimension-1 face of which."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:incidenceCoface
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "incidence coface"@x-gmeow-english ;
    skos:definition "Relates a math:CellIncidence to its coface — the higher-dimensional cell on whose boundary the incidence sits. Domain math:CellIncidence, range math:Cell (stated in prose). An incidence missing its coface is ill-formed (math:UnorientedIncidence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:incidenceFace
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "incidence face"@x-gmeow-english ;
    skos:definition "Relates a math:CellIncidence to its face — the codimension-1 cell that the coface's boundary passes through. Domain math:CellIncidence, range math:Cell (stated in prose). An incidence missing its face is ill-formed (math:UnorientedIncidence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:incidenceSign
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "incidence sign"@x-gmeow-english ;
    skos:definition "Relates a math:CellIncidence to the exact orientation sign the boundary operator attaches to its face: the integer +1 or −1, carried as an exact xsd:integer and never a decimal. Domain math:CellIncidence, range xsd:integer, whose only well-formed values are +1 and −1 (stated in prose). Single-valued (documented in prose, not an OWL characteristic — the math profile is EL-clean). An incidence missing its sign is ill-formed (math:UnorientedIncidence)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:orientation
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "orientation"@x-gmeow-english ;
    skos:definition "Relates a math:Cell to the math:CellOrientation it carries — math:positivelyOriented or math:negativelyOriented. Domain math:Cell, range math:CellOrientation (stated in prose). It records the cell's own chosen orientation, distinct from the ±1 math:incidenceSign that a math:CellIncidence attaches to a boundary face."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# Chain and cochain complexes — the square-zero laws and their adjunction.
#
# The graded math:Cell / signed math:CellIncidence surface (above) carries the
# boundary DATA; this block carries the boundary ELEMENTS (math:Chain, math:Cycle,
# math:Boundary and their cochain duals) and the ∂∘∂ = 0 / δ∘δ = 0 coherence laws
# over them. Two executable layers enforce square-zero: the regular/simplicial
# reasoning-form constraint (the combinatorial diamond over math:incidentTo) and
# the general-CW finite-sum constraint (a logic:JoinAggregateConstraint summing the
# incidence-sign products). The universal class law Σ_b [c:b][b:a] = 0 over ALL
# complexes is genuinely higher-order and carried as an honest boundary
# (math:cellBoundarySumBoundary); the per-instance finite sum is executable.
# =========================================================================== #

# --- Chain / cochain ELEMENT carriers -------------------------------------- #

math:Chain
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Chain"@x-gmeow-english ;
    skos:definition "An n-chain of a math:ChainComplex: a graded formal signed combination of same-dimension math:Cells — the element the boundary operator ∂ acts on. A subclass of math:MathematicalObject that names the math:ChainComplex it lives in through math:chainOf. It is NOT a single math:Cell (a chain is a signed combination of cells of one grade), NOT the whole math:ChainComplex it belongs to, and NOT a math:CellIncidence coefficient — it is a graded element of the chain group. A chain naming no complex is ungrounded (math:UngroundedChain)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Cochain
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cochain"@x-gmeow-english ;
    skos:definition "An n-cochain of a math:CochainComplex: a graded functional on n-chains — the element the coboundary operator δ acts on, dual to a math:Chain. A subclass of math:MathematicalObject. It is NOT a math:Chain (a cochain is a functional on chains, living in the dual graded complex), NOT a single math:Cell, and NOT a math:CellIncidence — it is a graded element of the cochain group."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CochainComplex
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cochain Complex"@x-gmeow-english ;
    skos:definition "A cochain complex: the dual graded sequence of modules connected by coboundary maps δ whose consecutive composite δ∘δ is zero — the degree-raising dual of a math:ChainComplex. A subclass of math:MathematicalObject naming its coboundary operator through math:cochainCoboundary. It is NOT the math:ChainComplex it is dual to (the arrows raise degree rather than lower it), and it is not a graded collection alone: the square-zero coboundary law is constitutive, authored as the first-order math:coboundarySquareZeroLaw. A cochain complex naming no coboundary operator is ill-formed (math:IncompleteCochainComplex)."@x-gmeow-english ;
    math:definingLaw math:coboundarySquareZeroLaw ;
    rdfs:seeAlso math:coboundarySquareZeroLaw ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Cycle
    a owl:Class ; logic:subClassOf math:Chain ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cycle"@x-gmeow-english ;
    skos:definition "An n-cycle: a math:Chain in the kernel of the boundary operator (∂z = 0) — a chain with empty boundary. A subclass of math:Chain naming the math:ChainComplex it cycles in through math:cycleOf. The cycles of a grade form the cycle group Z = ker ∂, whose quotient by the boundary group B = im ∂ is the math:HomologyGroup (H = Z/B). It is NOT an arbitrary math:Chain (a cycle is closed, ∂z = 0) and NOT a math:Boundary (a boundary is a cycle, but not every cycle bounds — that gap IS homology). A cycle naming no complex is ungrounded (math:UngroundedCycle)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Cocycle
    a owl:Class ; logic:subClassOf math:Cochain ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cocycle"@x-gmeow-english ;
    skos:definition "An n-cocycle: a math:Cochain in the kernel of the coboundary operator (δc = 0) — a closed cochain, dual to a math:Cycle. A subclass of math:Cochain. The cocycles of a grade form the cocycle group ker δ, whose quotient by the coboundary group im δ is the cohomology group. It is NOT an arbitrary math:Cochain (a cocycle is closed, δc = 0) and NOT a math:Coboundary (every coboundary is a cocycle, but not conversely — that gap is cohomology)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Boundary
    a owl:Class ; logic:subClassOf math:Chain ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Boundary"@x-gmeow-english ;
    skos:definition "An n-boundary: a math:Chain in the image of the boundary operator (b = ∂c for some (n+1)-chain c) — a chain that bounds. A subclass of math:Chain naming the math:ChainComplex it bounds in through math:boundaryOf. Because ∂∘∂ = 0, every boundary is a math:Cycle; the boundaries of a grade form the boundary group B = im ∂, quotiented out of the cycle group to form the math:HomologyGroup (H = Z/B). It is NOT a topological boundary (closure minus interior) and NOT a math:CellIncidence sign — it is a homological boundary chain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Coboundary
    a owl:Class ; logic:subClassOf math:Cochain ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Coboundary"@x-gmeow-english ;
    skos:definition "An n-coboundary: a math:Cochain in the image of the coboundary operator (c = δd for some (n−1)-cochain d) — a cochain that is a coboundary, dual to a math:Boundary. A subclass of math:Cochain naming the coboundary operator it is an image under through math:coboundaryOf. Because δ∘δ = 0, every coboundary is a math:Cocycle. It is NOT an arbitrary math:Cochain and NOT a math:Boundary (it lives in the dual, cochain complex). A coboundary naming no operator it is the image under is ill-formed (math:IncompleteCoboundary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Chain / cochain / homology structural properties ---------------------- #

math:chainBoundary
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "chain boundary"@x-gmeow-english ;
    skos:definition "Relates a math:ChainComplex to the math:BoundaryOperator whose degree-minus-one maps assemble it — the ∂ of the complex. Domain math:ChainComplex, range math:BoundaryOperator (stated in prose). The reflected form math:chainBoundaryRel grounds the square-zero law in the complex's own boundary operator, so ∂∘∂ = 0 predicates over the operator the complex actually carries rather than a free-floating ∂."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:cochainCoboundary
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "cochain coboundary"@x-gmeow-english ;
    skos:definition "Relates a math:CochainComplex to the math:CoboundaryOperator whose degree-plus-one maps assemble it — the δ of the cochain complex. Domain math:CochainComplex, range math:CoboundaryOperator (stated in prose). Every cochain complex names exactly one; a cochain complex without it is ill-formed (math:IncompleteCochainComplex)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:chainOf
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "chain of"@x-gmeow-english ;
    skos:definition "Relates a math:Chain to the math:ChainComplex it is an element of. Domain math:Chain, range math:ChainComplex (stated in prose). A chain is graded by the complex it lives in; a chain naming no complex is ungrounded (math:UngroundedChain)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:cycleOf
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "cycle of"@x-gmeow-english ;
    skos:definition "Relates a math:Cycle to the math:ChainComplex whose kernel of ∂ it lies in. Domain math:Cycle, range math:ChainComplex (stated in prose). A cycle naming no complex is ungrounded (math:UngroundedCycle)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:boundaryOf
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "boundary of"@x-gmeow-english ;
    skos:definition "Relates a math:Boundary to the math:ChainComplex whose image of ∂ it lies in. Domain math:Boundary, range math:ChainComplex (stated in prose). A boundary is a chain that bounds inside a named complex."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:coboundaryOf
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "coboundary of"@x-gmeow-english ;
    skos:definition "Relates a math:Coboundary to the math:CoboundaryOperator it is an image under (c = δd). Domain math:Coboundary, range math:CoboundaryOperator (stated in prose). A coboundary that names neither the cochain it is the coboundary of nor the operator applied is ill-formed (math:IncompleteCoboundary)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:homologyCycles
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homology cycles"@x-gmeow-english ;
    skos:definition "Relates a math:HomologyGroup Hₙ = Zₙ/Bₙ to a math:Cycle representing a class in it — a generator of the cycle group Z whose coset modulo the boundary group B is a homology class. Domain math:HomologyGroup, range math:Cycle (stated in prose). Paired with math:homologyBoundaries, it wires the quotient H = Z/B: the cycles are the numerator, the boundaries the denominator."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:homologyBoundaries
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homology boundaries"@x-gmeow-english ;
    skos:definition "Relates a math:HomologyGroup Hₙ = Zₙ/Bₙ to a math:Boundary quotiented out of it — a generator of the boundary group B = im ∂ that is identified with zero in homology. Domain math:HomologyGroup, range math:Boundary (stated in prose). Paired with math:homologyCycles, it wires the quotient H = Z/B: two cycles are homologous exactly when their difference is one of these boundaries (math:homologyQuotientLaw)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:coboundaryAdjoint
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "coboundary adjoint"@x-gmeow-english ;
    skos:definition "Relates a math:CoboundaryOperator δ to the math:BoundaryOperator ∂ it is the adjoint of (δ = ∂*). Domain math:CoboundaryOperator, range math:BoundaryOperator (stated in prose). The adjunction is the property the math:HodgeLaplacian L = δδ* + δ*δ depends on; the sign-level content — that the coboundary matrix is the transpose of the boundary matrix — is enforced through math:adjointIncidence and math:boundaryCoboundaryAdjunctionLaw."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:adjointIncidence
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "adjoint incidence"@x-gmeow-english ;
    skos:definition "Relates a boundary math:CellIncidence (a signed entry [∂c : a] = s of the boundary matrix) to the coboundary math:CellIncidence that is its transpose entry ([δa : c] = s), the two endpoints swapped and the sign preserved. Domain and range math:CellIncidence (stated in prose). The adjunction δ = ∂* requires the two signs to be EQUAL; a linked pair whose signs disagree witnesses a broken adjunction (math:BrokenBoundaryCoboundaryAdjunction), enforced by math:boundaryCoboundaryAdjunctionLaw."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:recoversHomology
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "recovers homology"@x-gmeow-english ;
    skos:definition "Relates a math:CellularSheaf whose stalks are the constant field to the math:HomologyGroup of its base complex that its degree-k sheaf COHOMOLOGY H^k(X;F) — the harmonic (kernel) space of its degree-k sheaf Laplacian — naturally corresponds to at that SAME degree k. Domain math:CellularSheaf, range math:HomologyGroup (stated in prose). The constant-sheaf specialisation of sheaf cohomology: sheaf cohomology H^k is a CONTRAVARIANT cochain-complex construction (built from δ), while the named math:HomologyGroup H = Zₖ/Bₖ is the COVARIANT chain-complex quotient (built from ∂); over a field F they are DIFFERENT constructions that the universal coefficient theorem identifies dimension-for-dimension at the SAME degree k (both equal the k-th math:BettiNumber), never a different degree and never literally the same object. This is emphatically NOT the first sheaf-cohomology H¹ that math:GluingObstruction measures — that H¹ is the obstruction to lifting compatible local sections to one global section, a structurally different role even when it happens to sit at degree 1 — so the sheaf machinery recovers plain homology at whatever degree its cochain complex sits (math:constantSheafRecoversHomologyLaw), never conflated with the gluing-obstruction reading."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:ConstantSheaf
    a owl:Class ; logic:subClassOf math:CellularSheaf ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Constant Sheaf"@x-gmeow-english ;
    skos:definition "The constant cellular sheaf on a math:CellComplex: the math:CellularSheaf whose stalks are all one fixed field and whose restriction maps are all the identity. A subclass of math:CellularSheaf; at each degree k its sheaf cohomology H^k(X;F) naturally corresponds — dimension-for-dimension over a field, via the universal coefficient theorem, at that SAME degree k — to the ordinary degree-k cellular homology of the base complex (math:constantSheafRecoversHomologyLaw, math:recoversHomology), the specialisation that shows the sheaf-Laplacian machinery generalises plain homology rather than replacing it; this is a same-degree (co)homology correspondence, NOT a claim that sheaf COHOMOLOGY and chain HOMOLOGY are the identical construction, and NOT the first-cohomology H¹ math:GluingObstruction reading. It is NOT an arbitrary math:CellularSheaf (identity restriction maps and a single constant stalk field are constitutive)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Reified relation atoms (HiLog reflection) for the square-zero laws ----- #

math:chainBoundaryRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "chainBoundary(K,∂) ⟺ ∂ is the boundary operator of chain complex K"@x-gmeow-english ;
    rdfs:seeAlso math:chainBoundary ;
    skos:definition "The HiLog reflection of math:chainBoundary as a binary relation individual, so the boundary-square-zero law can ground itself in the complex's own boundary operator inside a logic:Formula atom: chainBoundary(K,∂) holds exactly when ∂ is the math:BoundaryOperator of the math:ChainComplex K. Reflects the existing math:chainBoundary declaration (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:incidentToRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "incidentTo(c,f) ⟺ f is a codimension-1 face of c"@x-gmeow-english ;
    rdfs:seeAlso math:incidentTo ;
    skos:definition "The HiLog reflection of math:incidentTo as a binary relation individual, so the square-zero law can predicate 'f is a codimension-1 face of c' inside a logic:Formula atom. The relation the boundary composition ∂∘∂ runs over. Reflects the existing math:incidentTo declaration (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:cofaceRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "coface(f,c) ⟺ c is a cell whose codimension-1 face is f"@x-gmeow-english ;
    rdfs:seeAlso math:incidentTo ;
    skos:definition "The HiLog reflection of the coface (degree-raising) reading of math:incidentTo as a binary relation individual: coface(f,c) holds exactly when incidentTo(c,f) — c is a cell one grade up whose boundary passes through f. The relation the coboundary composition δ∘δ traverses upward, the transpose of math:incidentToRel. Reflects math:incidentTo read in the coface direction (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:cancellingPairRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "cancellingPair(b,b′) ⟺ the two intermediate faces of a codim-2 diamond cancel"@x-gmeow-english ;
    skos:definition "The involutive pairing the boundary-square-zero law derives: cancellingPair(b,b′) holds when b and b′ are the two distinct codimension-1 intermediate cells of one codimension-2 diamond (a shared coface c and shared far-face a) whose incidence-sign products are opposite, so their contributions to ∂∘∂ cancel. A binary HiLog relation individual over which the law states the fixed-point-free involution; no first-class asserted property is minted, because the pairing is a derived consequence of the incidence structure, not authored data."@x-gmeow-english .

math:coCancellingPairRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "coCancellingPair(b,b′) ⟺ the two intermediate cofaces of a codim-2 co-diamond cancel"@x-gmeow-english ;
    skos:definition "The coboundary dual of math:cancellingPairRel: coCancellingPair(b,b′) holds when b and b′ are the two distinct intermediate cofaces of one δ∘δ diamond (a shared lower cell a and shared upper cell c) whose sign products are opposite, so their contributions to δ∘δ cancel. A binary HiLog relation individual the coboundary-square-zero law derives; derived, no minted property."@x-gmeow-english .

math:oppositeIncidenceProductRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "oppositeProduct(b,b′) ⟺ the sign products [c:b][b:a] and [c:b′][b′:a] are opposite"@x-gmeow-english ;
    skos:definition "The derived arithmetic over math:incidenceSign the square-zero law joins on: oppositeProduct(b,b′) holds exactly when the incidence-sign product [c:b]·[b:a] along the composition through b is the negation of the product [c:b′]·[b′:a] through b′ (one +1, one −1), so the two diamond paths cancel. A binary HiLog relation individual reflecting a derived computation over the ±1 math:incidenceSign integers; no property is minted, because the product is arithmetic over existing signs, not authored data."@x-gmeow-english .

math:adjointIncidenceRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "adjointIncidence(i,j) ⟺ j is the transpose entry of boundary incidence i"@x-gmeow-english ;
    rdfs:seeAlso math:adjointIncidence ;
    skos:definition "The HiLog reflection of math:adjointIncidence as a binary relation individual, so the adjunction law can predicate 'j is the coboundary transpose of the boundary incidence i' inside a logic:Formula atom. Reflects the existing math:adjointIncidence declaration (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:incidenceSignRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "incidenceSign(i,s) ⟺ the incidence i carries the ±1 sign s"@x-gmeow-english ;
    rdfs:seeAlso math:incidenceSign ;
    skos:definition "The HiLog reflection of math:incidenceSign as a binary relation individual, so the adjunction law can bind an incidence's ±1 sign inside a logic:Formula atom. Reflects the existing math:incidenceSign declaration (rdfs:seeAlso), minting no second relation."@x-gmeow-english .

math:homologousRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homologous(z1,z2) ⟺ z1 − z2 is a boundary"@x-gmeow-english ;
    skos:definition "The equivalence the homology-quotient law states: homologous(z1,z2) holds exactly when the difference of the two cycles z1 and z2 is a math:Boundary — the coset relation whose classes ARE the elements of H = Z/B. A binary HiLog relation individual; the coset construction is derived, so no property is minted."@x-gmeow-english .

math:chainDifferenceRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "difference(z1,z2,d) ⟺ d = z1 − z2 in the chain group"@x-gmeow-english ;
    skos:definition "The chain-group subtraction the homology-quotient law reifies: difference(z1,z2,d) holds when d is the signed chain z1 − z2. A ternary HiLog relation individual over the abelian chain group; the subtraction is derived arithmetic over the graded group, so no property is minted."@x-gmeow-english .

math:isBoundaryRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "isBoundary(d) ⟺ d is a boundary (d ∈ im ∂)"@x-gmeow-english ;
    skos:definition "The membership the homology-quotient law tests: isBoundary(d) holds exactly when the chain d lies in the boundary group B = im ∂ (it is a math:Boundary). A unary HiLog relation individual; membership in the image of ∂ is derived, so no property is minted."@x-gmeow-english .

# --- Law B.1: ∂∘∂ = 0 — the combinatorial diamond + fixed-point-free involution #
# ∀ K ∂ c b b′ a: chainBoundary(K,∂) ∧ incidentTo(c,b) ∧ incidentTo(b,a)
#   ∧ incidentTo(c,b′) ∧ incidentTo(b′,a) ∧ oppositeProduct(b,b′) → cancellingPair(b,b′)
# The defining law of a math:ChainComplex / math:BoundaryOperator, authored as a
# first-order logic:Formula exactly as math:filtrationMonotonicityLaw authors its
# hard law. Scoped to regular/simplicial complexes (a codimension-2 pair has exactly
# two intermediate faces there — the diamond lemma is a theorem only in that setting):
# every codim-2 diamond's two intermediate faces are paired by a sign-reversing
# involution, so ∂∘∂ vanishes. It is Horn-derivable, so the native reasoningLogic lane
# fires it over a concrete triangle to DERIVE the cancelling pair. The UNIVERSAL
# arithmetic form Σ_b [c:b][b:a] = 0 over ALL complexes is the higher-order residue
# recorded honestly as math:cellBoundarySumBoundary; the per-instance finite sum is
# executable through math:GeneralBoundarySquareZeroConstraint.

math:boundarySquareZeroLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "boundary square zero: the two intermediate faces of a codim-2 diamond cancel (∂∘∂ = 0)"@x-gmeow-english ;
    skos:definition "The defining law of a math:ChainComplex and its math:BoundaryOperator as a universally-quantified first-order logic:Formula over the reified incidence signature: for a chain complex K with boundary operator ∂, if c has codimension-1 faces b and b′ each having a as a codimension-1 face, and the two composition sign products are opposite, then b and b′ are a cancelling pair — the fixed-point-free involution pairing the two intermediate faces of the codimension-2 diamond, which makes ∂∘∂ vanish. math: expresses the law; logic: owns reasoning over it. SCOPED to regular/simplicial complexes: a codimension-2 pair has exactly two intermediate faces there (the diamond lemma), so the local involution is a theorem; on a general CW complex the exact vanishing is the finite signed SUM Σ_b [c:b][b:a] = 0 enforced per-instance by math:GeneralBoundarySquareZeroConstraint, and the universal class law is the honest higher-order boundary math:cellBoundarySumBoundary. A sibling of math:filtrationMonotonicityLaw in the same first-order style; Horn-derivable, so the native reasoningLogic lane derives its math:cancellingPairRel consequent over a concrete triangle."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "K" ] ,
        [ logic:termIndex 1 ; logic:termVariable "d" ] ,
        [ logic:termIndex 2 ; logic:termVariable "c" ] ,
        [ logic:termIndex 3 ; logic:termVariable "b" ] ,
        [ logic:termIndex 4 ; logic:termVariable "bp" ] ,
        [ logic:termIndex 5 ; logic:termVariable "a" ] ;
    logic:forall math:bszImpl .

math:bszImpl a logic:Formula ;
    logic:antecedent math:bszAnte ;
    logic:consequent math:bszCons .

math:bszAnte a logic:Formula ;
    logic:and math:bszA1 , math:bszA2 , math:bszA3 , math:bszA4 , math:bszA5 , math:bszA6 .

math:bszA1 a logic:Formula ; logic:relation math:chainBoundaryRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "K" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
math:bszA2 a logic:Formula ; logic:relation math:incidentToRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .
math:bszA3 a logic:Formula ; logic:relation math:incidentToRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .
math:bszA4 a logic:Formula ; logic:relation math:incidentToRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .
math:bszA5 a logic:Formula ; logic:relation math:incidentToRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "bp" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .
math:bszA6 a logic:Formula ; logic:relation math:oppositeIncidenceProductRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .

math:bszCons a logic:Formula ; logic:relation math:cancellingPairRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .

# --- Boundary: the UNIVERSAL Σ_b [c:b][b:a] = 0 class law is higher-order ---- #
# The per-instance finite sum is executable (math:GeneralBoundarySquareZeroConstraint);
# what is genuinely higher-order is the UNIVERSAL law that Σ_b [c:b][b:a] = 0 holds
# for EVERY codim-2 pair of EVERY complex — a second-order claim quantifying over the
# unbounded family of complexes and, within each, over the finite-but-unbounded set of
# intermediate cells with a SUM the first-order fragment has no aggregate node for.
# Recorded here as an honest loss-ledger boundary, never faked as a first-order formula;
# it covers ONLY the universal class law, NOT per-instance conformance.

math:cellBoundarySumBoundary
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "universal ∂∘∂ = 0 (Σ_b [c:b][b:a] = 0 over ALL complexes): an honest recorded higher-order boundary"@x-gmeow-english ;
    logic:expressivenessBoundary logic:SecondOrder ;
    logic:preservationKind logic:Unsupported ;
    skos:definition "The loss-ledger boundary record backing the UNIVERSAL boundary-square-zero class law: that Σ_b [c:b]·[b:a] = 0 holds for EVERY codimension-2 pair (c,a) of EVERY math:ChainComplex is genuinely higher-order — it ∀-quantifies over the unbounded family of complexes and, inside each, aggregates a signed SUM over a finite-but-unbounded set of intermediate cells, a group aggregation the first-order fragment cannot express. HiLog reflection reifies one incidence, but the universal sum-vanishes claim is not first-order axiomatizable, so a first-order witness would be an unsound uninterpreted predicate. It is therefore carried as an honest boundary (logic:expressivenessBoundary logic:SecondOrder, logic:preservationKind logic:Unsupported). This boundary covers ONLY the universal class law; the regular/simplicial diamond law math:boundarySquareZeroLaw IS first-order, and the per-instance finite sum IS executable through the logic:JoinAggregateConstraint math:GeneralBoundarySquareZeroConstraint — so this record is the honest mathematical distinction, not a scope dodge. Contrast its sibling math:compactnessBoundary."@x-gmeow-english .

# --- Law B.2a: δ∘δ = 0 — the coboundary square-zero law (transposed) -------- #
# The degree-raising dual of math:boundarySquareZeroLaw: the same diamond/involution
# schema traversed through math:cofaceRel (face → coface) rather than math:incidentToRel.

math:coboundarySquareZeroLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "coboundary square zero: the two intermediate cofaces of a co-diamond cancel (δ∘δ = 0)"@x-gmeow-english ;
    skos:definition "The defining law of a math:CochainComplex and its math:CoboundaryOperator as a universally-quantified first-order logic:Formula, the degree-raising dual of math:boundarySquareZeroLaw: for a cochain complex with coboundary operator δ, if a has cofaces b and b′ each a face of c, and the two composition sign products are opposite, then b and b′ are a co-cancelling pair — the involution that makes δ∘δ vanish. Traverses the coface (upward) reading math:cofaceRel where the boundary law traverses math:incidentToRel. math: expresses the law; logic: owns reasoning over it. Distinct from math:boundarySquareZeroLaw (a separate logic:Formula over the transposed traversal), scoped identically to regular/simplicial complexes, and Horn-derivable so the reasoningLogic lane derives its math:coCancellingPairRel consequent over a concrete triangle."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "L" ] ,
        [ logic:termIndex 1 ; logic:termVariable "dd" ] ,
        [ logic:termIndex 2 ; logic:termVariable "a" ] ,
        [ logic:termIndex 3 ; logic:termVariable "b" ] ,
        [ logic:termIndex 4 ; logic:termVariable "bp" ] ,
        [ logic:termIndex 5 ; logic:termVariable "c" ] ;
    logic:forall math:cbszImpl .

math:cbszImpl a logic:Formula ;
    logic:antecedent math:cbszAnte ;
    logic:consequent math:cbszCons .

math:cbszAnte a logic:Formula ;
    logic:and math:cbszA1 , math:cbszA2 , math:cbszA3 , math:cbszA4 , math:cbszA5 , math:cbszA6 .

math:cbszA1 a logic:Formula ; logic:relation math:chainBoundaryRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "L" ] , [ logic:termIndex 1 ; logic:termVariable "dd" ] .
math:cbszA2 a logic:Formula ; logic:relation math:cofaceRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .
math:cbszA3 a logic:Formula ; logic:relation math:cofaceRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] .
math:cbszA4 a logic:Formula ; logic:relation math:cofaceRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .
math:cbszA5 a logic:Formula ; logic:relation math:cofaceRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "bp" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] .
math:cbszA6 a logic:Formula ; logic:relation math:oppositeIncidenceProductRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .

math:cbszCons a logic:Formula ; logic:relation math:coCancellingPairRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .

# --- Law B.2b: δ = ∂* — the boundary/coboundary adjunction ------------------ #
# ∀ i j s t: adjointIncidence(i,j) ∧ incidenceSign(i,s) ∧ incidenceSign(j,t) → eq(s,t)
# The coboundary is the adjoint (transpose) of the boundary: the transpose entry
# carries the SAME sign. The property math:HodgeLaplacian L = δδ* + δ*δ depends on it.

math:boundaryCoboundaryAdjunctionLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "adjunction: the coboundary is the transpose of the boundary (δ = ∂*)"@x-gmeow-english ;
    skos:definition "The defining law of the boundary/coboundary adjunction as a universally-quantified first-order logic:Formula over the reified incidence-sign signature: if a coboundary incidence j is the transpose (math:adjointIncidence) of a boundary incidence i, then the two carry the SAME ±1 sign — the entry [δa:c] equals the entry [∂c:a]. This is δ = ∂*, the adjunction the math:HodgeLaplacian L = δδ* + δ*δ is built on; a linked transpose pair whose signs disagree witnesses a broken adjunction (math:BrokenBoundaryCoboundaryAdjunction). math: expresses the law; logic: owns reasoning over it; a sibling of math:continuityLaw in the same first-order style."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "i" ] ,
        [ logic:termIndex 1 ; logic:termVariable "j" ] ,
        [ logic:termIndex 2 ; logic:termVariable "s" ] ,
        [ logic:termIndex 3 ; logic:termVariable "t" ] ;
    logic:forall math:adjImpl .

math:adjImpl a logic:Formula ;
    logic:antecedent math:adjAnte ;
    logic:consequent math:adjCons .

math:adjAnte a logic:Formula ;
    logic:and math:adjA1 , math:adjA2 , math:adjA3 .

math:adjA1 a logic:Formula ; logic:relation math:adjointIncidenceRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "i" ] , [ logic:termIndex 1 ; logic:termVariable "j" ] .
math:adjA2 a logic:Formula ; logic:relation math:incidenceSignRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "i" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
math:adjA3 a logic:Formula ; logic:relation math:incidenceSignRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "j" ] , [ logic:termIndex 1 ; logic:termVariable "t" ] .

math:adjCons a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s" ] , [ logic:termIndex 1 ; logic:termVariable "t" ] .

# --- Law B.4: homology quotient H = Z/B — the homologous-cycle equivalence -- #
# ∀ z1 z2 d: difference(z1,z2,d) ∧ isBoundary(d) → homologous(z1,z2)
# The first-order coset relation whose classes ARE the elements of H = Z/B; the
# quotient-GROUP construction (well-defined coset operations) is the higher-order
# residue recorded as math:homologyQuotientBoundary.

math:homologyQuotientLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "homology quotient: two cycles are homologous when their difference is a boundary (H = Z/B)"@x-gmeow-english ;
    skos:definition "The defining law of the homology quotient H = Z/B as a first-order logic:Formula over the reified chain-group signature: two cycles z1 and z2 are homologous — represent the same class in the math:HomologyGroup — exactly when their difference z1 − z2 is a math:Boundary. This is the coset relation whose equivalence classes ARE the elements of H = Zₙ/Bₙ. math: expresses the equivalence; logic: owns reasoning over it. The RELATION is first-order (a difference and a membership test, like math:connectednessLaw's atoms); the full quotient-GROUP CONSTRUCTION — forming Z/B as a group with well-defined coset operations — is the higher-order residue carried honestly as math:homologyQuotientBoundary."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "z1" ] ,
        [ logic:termIndex 1 ; logic:termVariable "z2" ] ,
        [ logic:termIndex 2 ; logic:termVariable "d" ] ;
    logic:forall math:hqImpl .

math:hqImpl a logic:Formula ;
    logic:antecedent math:hqAnte ;
    logic:consequent math:hqCons .

math:hqAnte a logic:Formula ;
    logic:and math:hqA1 , math:hqA2 .

math:hqA1 a logic:Formula ; logic:relation math:chainDifferenceRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "z1" ] , [ logic:termIndex 1 ; logic:termVariable "z2" ] , [ logic:termIndex 2 ; logic:termVariable "d" ] .
math:hqA2 a logic:Formula ; logic:relation math:isBoundaryRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "d" ] .

math:hqCons a logic:Formula ; logic:relation math:homologousRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "z1" ] , [ logic:termIndex 1 ; logic:termVariable "z2" ] .

math:homologyQuotientBoundary
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "quotient-group construction of H = Z/B: an honest recorded higher-order boundary"@x-gmeow-english ;
    logic:expressivenessBoundary logic:SecondOrder ;
    logic:preservationKind logic:Unsupported ;
    skos:definition "The loss-ledger boundary record backing the quotient-GROUP construction of the math:HomologyGroup H = Z/B: while the homologous-cycle EQUIVALENCE is first-order (math:homologyQuotientLaw), CONSTRUCTING the quotient group — forming the set of cosets z + B, quantifying over the subgroup B, and proving the coset operation well-defined — is genuinely higher-order (it quantifies over subgroups and their cosets, not first-order axiomatizable). So the quotient construction is carried as an honest boundary (logic:expressivenessBoundary logic:SecondOrder, logic:preservationKind logic:Unsupported), the residue disclosed in the ledger and never faked as a first-order formula. The structural frame (H names its cycles and boundaries through math:homologyCycles / math:homologyBoundaries) and the homologous relation ARE authored; only the group-quotient construction is the boundary. A sibling of math:cellBoundarySumBoundary."@x-gmeow-english .

# --- Law: constant sheaf recovers cellular homology ------------------------ #

math:constantSheafRecoversHomologyLaw
    a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "constant-sheaf cohomology corresponds to same-degree cellular homology"@x-gmeow-english ;
    skos:definition "The law linking the sheaf-Laplacian machinery back to ordinary homology as a first-order logic:Formula: a math:ConstantSheaf S (constant-field stalks, identity restriction maps) over a base math:CellComplex X has, at each degree k, a sheaf-Laplacian harmonic space that computes the degree-k sheaf COHOMOLOGY H^k(X;F) of X. Over a field F, H^k(X;F) is naturally identified — dimension-for-dimension, via the universal coefficient theorem, at the SAME degree k, never a shifted one — with the degree-k cellular HOMOLOGY group H_k(X;F) = Zₖ/Bₖ (math:homologyQuotientLaw); the two are DIFFERENT constructions (cohomology is built contravariantly from the coboundary δ, homology covariantly from the boundary ∂) that this same-degree correspondence relates, never a literal identity, and never the first sheaf-cohomology H¹ that math:GluingObstruction measures (a structurally different obstruction-to-gluing role, not a Betti-number recovery). If S is a constant sheaf over X and H is the cellular homology of X at the degree S's cochain complex sits at, then S math:recoversHomology H. math: expresses the law; logic: owns reasoning over it. It shows the math:CellularSheaf / math:SheafLaplacian surface GENERALISES plain homology (the constant sheaf is the specialisation) rather than replacing it, so the sheaf machinery is a conservative extension."@x-gmeow-english ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "S" ] ,
        [ logic:termIndex 1 ; logic:termVariable "X" ] ,
        [ logic:termIndex 2 ; logic:termVariable "H" ] ;
    logic:forall math:csrhImpl .

math:csrhImpl a logic:Formula ;
    logic:antecedent math:csrhAnte ;
    logic:consequent math:csrhCons .

math:csrhAnte a logic:Formula ;
    logic:and math:csrhA1 , math:csrhA2 , math:csrhA3 .

math:csrhA1 a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "S" ] , [ logic:termIndex 1 ; logic:termIri math:ConstantSheaf ] .
math:csrhA2 a logic:Formula ; logic:relation math:sheafBaseComplex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "S" ] , [ logic:termIndex 1 ; logic:termVariable "X" ] .
math:csrhA3 a logic:Formula ; logic:relation math:cellularHomologyOfRel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "H" ] , [ logic:termIndex 1 ; logic:termVariable "X" ] .

math:csrhCons a logic:Formula ; logic:relation math:recoversHomology ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "S" ] , [ logic:termIndex 1 ; logic:termVariable "H" ] .

math:cellularHomologyOfRel
    a logic:Type ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "cellularHomologyOf(H,X) ⟺ H is the cellular homology of complex X"@x-gmeow-english ;
    skos:definition "The relation the constant-sheaf law binds the base complex's ordinary homology through: cellularHomologyOf(H,X) holds when H is A math:HomologyGroup of the math:CellComplex X computed from its cellular chain complex AT SOME degree k — the relation is deliberately degree-generic (it does not fix k), so math:constantSheafRecoversHomologyLaw's claim is that H sits at the SAME degree as the constant sheaf's cochain complex, whichever degree that is, never a specific hard-coded 'H₁' or 'H¹'. A binary HiLog relation individual; the cellular-homology assignment is a derived construction, so no property is minted."@x-gmeow-english .

math:VietorisRipsComplex
    a owl:Class ; logic:subClassOf math:SimplicialComplex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vietoris–Rips Complex"@x-gmeow-english ;
    skos:definition "The simplicial complex at a scale whose simplices are finite point sets with all pairwise distances at most that scale. It is not a Čech complex: pairwise distance bounds do not require one common ball intersection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CechComplex
    a owl:Class ; logic:subClassOf math:SimplicialComplex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Čech Complex"@x-gmeow-english ;
    skos:definition "The nerve simplicial complex of a family of equal-radius balls, with a simplex for each subfamily having nonempty total intersection. It is not a Vietoris–Rips complex: a common intersection, not merely pairwise proximity, licenses a simplex."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:AlphaComplex
    a owl:Class ; logic:subClassOf math:SimplicialComplex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Alpha Complex"@x-gmeow-english ;
    skos:definition "A scale-indexed subcomplex of a Delaunay complex that captures the homotopy type of the union of restricted balls. It is not the full Delaunay complex or an arbitrary proximity complex."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PersistentHomology
    a owl:Class ; logic:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Persistent Homology"@x-gmeow-english ;
    skos:definition "A topological-data-analysis activity that computes homology across a declared filtration and emits persistence summaries; it is the method, not the filtration itself."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PersistenceDiagram
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Persistence Diagram"@x-gmeow-english ;
    skos:definition "A multiset of birth–death points summarizing the lifetimes of homological features in a filtration. It is not the filtration or the persistent-homology activity that produced it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PersistenceBarcode
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Persistence Barcode"@x-gmeow-english ;
    skos:definition "A family of intervals representing the same persistent-module decomposition encoded by feature birth and death lifetimes. It is not a persistence diagram, although the two may encode equivalent interval data."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PersistenceLandscape
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Persistence Landscape"@x-gmeow-english ;
    skos:definition "A sequence of real-valued functions derived from persistence intervals that places persistent-homology summaries in a statistical function space. It is not a raw barcode or diagram: it is their function-valued transform."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BettiSummary
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Betti Summary"@x-gmeow-english ;
    skos:definition "A degree-indexed collection of Betti numbers for a declared complex, space, filtration stage, or persistence result. It is not one unscoped Betti number."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BettiNumber
    a owl:Class ; logic:subClassOf math:NaturalNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Betti Number"@x-gmeow-english ;
    skos:definition "The rank of a homology group in a specified degree, counting independent topological features of that degree. It is not a simplex count or an Euler characteristic."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MapperConstruction
    a owl:Class ; logic:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Mapper Construction"@x-gmeow-english ;
    skos:definition "A topological-data-analysis activity that covers the range of a filter function, clusters inverse images, and forms their nerve graph or complex. It is not clustering or dimensional reduction alone: the cover and nerve construction are required."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MultiparameterPersistence
    a owl:Class ; logic:subClassOf math:PersistentHomology ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Multiparameter Persistence"@x-gmeow-english ;
    skos:definition "Persistent-homology analysis over a filtration indexed by a partially ordered parameter space of dimension greater than one. It is not a collection of unrelated one-parameter persistence runs."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ZigzagPersistence
    a owl:Class ; logic:subClassOf math:PersistentHomology ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Zigzag Persistence"@x-gmeow-english ;
    skos:definition "Persistent-homology analysis over a sequence whose structure maps may point forward or backward, permitting additions and removals. It is not ordinary forward-only persistence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Mapper-construction frame classes (Mapper coverage family) ------------- #
# A math:MapperConstruction is defined only relative to a complete, declared
# frame: the source metric space it samples, the filter function it factors
# through, the cover of the filter codomain, the clustering rule applied inside
# each cover element's inverse image, and the output nerve complex. The cover and
# clustering are the reusable objects that make Mapper more than a bare graph, and
# each is a first-class mathematical object here, never an implicit choice.
math:MetricSpace
    a owl:Class ; logic:subClassOf math:TopologicalSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Metric Space"@x-gmeow-english ;
    skos:definition "A metric space (X, d): a set X together with a distance function d that is non-negative, zero exactly on the diagonal, symmetric, and satisfies the triangle inequality. Every metric space induces a topology (the metric balls form a basis), so it is a subclass of math:TopologicalSpace, but the distance function is constitutive and not recoverable from the topology alone. It is the source over which a Mapper construction's filter function and clustering rule are defined; a point cloud sampled with a declared metric is a metric space."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Cover
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cover"@x-gmeow-english ;
    skos:definition "A cover of a space: a finite family of overlapping sets (its math:CoverElement members, named through math:hasCoverElement) whose union contains the covered space. In a Mapper construction the cover is taken of the filter function's codomain, and the overlaps between adjacent cover elements are what create the edges of the output nerve. The cover is declared and finitely enumerated, never an implicit resolution parameter; a Mapper construction missing it is ill-formed (math:IncompleteMapperConstruction)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CoverElement
    a owl:Class ; logic:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cover Element"@x-gmeow-english ;
    skos:definition "A single element of a math:Cover: one of the overlapping sets (typically an open set or interval) whose family covers the space. A subclass of math:Set. Two cover elements that overlap induce an edge between the clusters found in their inverse images; a cover element carries the concrete extent (for a real filter, an interval with its endpoints and inclusions) that makes the cover deterministic rather than a free resolution choice."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ClusteringRule
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Clustering Rule"@x-gmeow-english ;
    skos:definition "The declared, deterministic rule applied to the inverse image of each cover element to partition it into clusters — for example single-linkage clustering at a fixed distance threshold (math:clusteringThreshold). A subclass of math:MathematicalObject naming the rule as a first-class object so a Mapper's node set is reproducible, never the output of an unspecified clustering step. A Mapper construction whose clustering rule is omitted or left to convention is ill-formed (math:IncompleteMapperConstruction)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:NerveComplex
    a owl:Class ; logic:subClassOf math:SimplicialComplex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Nerve Complex"@x-gmeow-english ;
    skos:definition "The nerve of a covered, clustered space: the simplicial complex whose vertices are the clusters found in each cover element's inverse image and whose k-simplices record the non-empty intersections of k+1 clusters. It is a subclass of math:SimplicialComplex; a Mapper construction's output nerve is its one-skeleton graph together with any higher simplices from multi-way cluster overlaps. It is the output of the Mapper construction, not the source complex it is computed from."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Geometric fields, dynamics, and Morse theory -------------------------- #

math:ScalarField
    a owl:Class ; logic:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Scalar Field"@x-gmeow-english ;
    skos:definition "A function assigning a scalar to each point of its declared domain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VectorField
    a owl:Class ; logic:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vector Field"@x-gmeow-english ;
    skos:definition "A function assigning to each point of a manifold a vector in the tangent space at that point."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Flow
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Flow"@x-gmeow-english ;
    skos:definition "A parameterized family of transformations describing the evolution generated by a vector field or dynamical system."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SymplecticForm
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Symplectic Form"@x-gmeow-english ;
    skos:definition "A closed nondegenerate differential two-form on a smooth even-dimensional manifold."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:HamiltonianFunction
    a owl:Class ; logic:subClassOf math:ScalarField ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hamiltonian Function"@x-gmeow-english ;
    skos:definition "A scalar function on a symplectic state space whose symplectic gradient generates the Hamiltonian flow."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:HamiltonianFlow
    a owl:Class ; logic:subClassOf math:Flow ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hamiltonian Flow"@x-gmeow-english ;
    skos:definition "The flow generated by a Hamiltonian function through a declared symplectic form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:HamiltonianSystem
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hamiltonian System"@x-gmeow-english ;
    skos:definition "A dynamical system framed by a symplectic state space and a Hamiltonian function that generates its flow."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Cellular sheaves and Hodge structure ---------------------------------- #

math:CellularSheaf
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cellular Sheaf"@x-gmeow-english ;
    skos:definition "A sheaf on a cell complex assigning a stalk to each cell and a compatible restriction map to each face relation. Unlike a constant sheaf, its stalks and restriction maps may differ from cell to cell, and it is not merely the underlying cell complex, which carries no stalk data."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SheafStalk
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Sheaf Stalk"@x-gmeow-english ;
    skos:definition "The local value object assigned by a sheaf to a point or cell of its base space."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SheafRestrictionMap
    a owl:Class ; logic:subClassOf math:Morphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Restriction Map"@x-gmeow-english ;
    skos:definition "A sheaf morphism transporting local data between stalks along an inclusion or incidence relation, subject to identity and composition laws. Its ACTION on a specific source stalk value — the concrete image the map sends that value to, identity for a math:ConstantSheaf but genuinely non-identity in general — is reified per declared value through math:restrictionImage, so gluing consistency (math:SectionGluingConsistencyConstraint) can be checked against the map's actual transport rather than assumed identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SheafSection
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Sheaf Section"@x-gmeow-english ;
    skos:definition "A compatible assignment of local stalk values over a region of a sheaf's base space."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GlobalSection
    a owl:Class ; logic:subClassOf math:SheafSection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Global Section"@x-gmeow-english ;
    skos:definition "A math:SheafSection defined over the ENTIRE math:sheafBaseComplex of its math:CellularSheaf: a compatible assignment of stalk values that restricts consistently along every restriction map of the whole complex, hence an element of the degree-zero sheaf cohomology H⁰(X; F). Its math:sectionRegion is the whole base, and it names its carrier through math:overSheaf. It is NOT a math:LocalSection over a proper subcomplex (a global section leaves no cell unassigned), and NOT a mere family of local sections that happens to exist — its defining property is that the local data GLUE into one section over all of X, the very lifting whose failure the H¹ math:GluingObstruction measures."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LocalSection
    a owl:Class ; logic:subClassOf math:SheafSection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Local Section"@x-gmeow-english ;
    skos:definition "A math:SheafSection defined over a PROPER subcomplex of its math:CellularSheaf's math:sheafBaseComplex only: a compatible assignment of stalk values over some region math:sectionRegion strictly smaller than the whole base. It is the local datum whose compatibility with its neighbours is what gluing must reconcile. It is NOT a math:GlobalSection over the entire base (a local section deliberately covers a restricted region), and it is NOT sufficient on its own to certify a global truth — a family of local sections lifts to a global section only when their pairwise disagreements vanish, and the residual disagreement is exactly the H¹ math:GluingObstruction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GluingObstruction
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Gluing Obstruction"@x-gmeow-english ;
    rdfs:seeAlso math:SheafCohomology ;
    skos:definition "The first-cohomology (H¹) witness recording WHY a family of math:LocalSections of a math:CellularSheaf may fail to lift to a single math:GlobalSection: the obstruction-to-gluing class whose non-vanishing certifies that consistent local data does not assemble into global truth. It names the sheaf it obstructs through math:obstructionOf. It is NOT a math:SheafRestrictionMap (it does not transport data; it measures the failure of transported data to agree), NOT a mere local disagreement on one overlap (a single pairwise mismatch is a coboundary, not necessarily a cohomology class), and NOT itself a section — it is the cohomological reason a global section may not exist."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RestrictionImage
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Restriction Image"@x-gmeow-english ;
    skos:definition "A reified entry of a math:SheafRestrictionMap's transport action: the declared exact-integer value the map sends ONE named source stalk value to, named through math:imageSourceValue and math:imageTargetValue. Cellular-sheaf gluing compatibility is restriction(sourceValue) = targetValue, not raw equality of the two endpoint stalk values — raw equality is the special case where the map is the identity (as for a math:ConstantSheaf); a non-identity restriction map (a sign flip, a scale, a projection) sends its source to a genuinely different target value, and math:SectionGluingConsistencyConstraint checks the section's declared target stalk value against THIS recorded image rather than against the raw source. A subclass of math:MathematicalObject reifying one input↦output pair of the map's action, exactly as math:CellIncidence reifies one signed boundary coefficient rather than inlining it. It is NOT the math:SheafRestrictionMap itself (a map may act on many source values; each gets its own image record) and NOT a math:SheafStalk (it records a TRANSPORTED value, not a stalk's own assignment). A restriction image missing its source or target value says nothing about the map's action and is ill-formed (math:IncompleteRestrictionImage)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Multiparameter / zigzag persistence OBJECTS ----------------------------- #
# The shipped math:MultiparameterPersistence and math:ZigzagPersistence are
# ANALYSIS ACTIVITIES (⊑ math:PersistentHomology ⊑ gmeow:Activity). The OBJECTS
# those activities range over — a filtration indexed by a poset of dimension ≥ 2,
# the algebraic persistence module (a functor to vector spaces), a map of such
# modules, and a diagram whose structure maps may reverse — are distinct
# mathematical objects, minted here, distinctly named, and cross-linked to their
# activities through rdfs:seeAlso. The non-collapse guards below (frames, cross-node
# logic:Constraints, an owl:disjointWith conflation, and an honest
# logic:expressivenessBoundary) make executable the one principle these objects
# exist to protect: a genuinely multi-parameter or bidirectional construction must
# never silently degrade to the one-parameter, forward-only case.

math:MultiparameterFiltration
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Multiparameter Filtration"@x-gmeow-english ;
    rdfs:seeAlso math:MultiparameterPersistence , math:Filtration , math:multiparameterInvariantBoundary ;
    skos:definition "A filtration indexed by a POSET of dimension ≥ 2: a monotone family of substructures of an ambient object indexed not by a single real threshold ε but by a partially ordered parameter space (a distance × density grid, a scale × codensity plane), named through math:filtrationIndexPoset. A subclass of math:MathematicalObject. Its stages are the EXISTING math:FiltrationStage cells reached through the EXISTING math:hasFiltrationStage, but each stage carries a math:multiIndex — a math:Vector giving the stage's coordinates in the parameter poset — RATHER than the single real math:filtrationThreshold that a one-parameter math:Filtration's stages carry. It is NOT the analysis activity math:MultiparameterPersistence (rdfs:seeAlso) that ranges over it — that is a gmeow:Activity, this is the mathematical object it filters. It is NOT a single-parameter math:Filtration: a multiparameter filtration whose stages carry only a real math:filtrationThreshold and no math:multiIndex has collapsed to one parameter (math:CollapsedMultiparameterFiltration), and one whose 2-index coordinates are functionally dependent — a diagonal (t, t) — is genuinely one-parametric despite the 2-tuple (math:DiagonalDegenerateFiltration). Carlsson–Zomorodian proved there is NO complete discrete invariant of multiparameter persistence (math:multiparameterInvariantBoundary), the principled reason it cannot be reduced to a family of one-parameter runs."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PersistenceModule
    a owl:Class ; logic:subClassOf math:MathematicalObject , math:Functor ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Persistence Module"@x-gmeow-english ;
    rdfs:seeAlso math:MultiparameterPersistence , math:PersistenceLifetime , math:Functor ;
    skos:definition "The ALGEBRAIC object a persistence computation decomposes: the functor P assigning a vector space to each point of an index poset and a linear map to each comparable pair, P: (index poset as a category) → Vect. A subclass of math:MathematicalObject AND of the EXISTING math:Functor grounding — a persistence module IS a functor on its math:moduleIndex poset, so it reuses the shipped category-theory referent rather than minting a parallel structure. It names the index poset it is defined over through math:moduleIndex and its comparable-pair transition maps through math:structureMap. It is NOT the analysis activity math:MultiparameterPersistence (rdfs:seeAlso) that produces or decomposes it, and it is NOT a math:PersistenceLifetime — the birth–death interval of ONE feature is a single decorated bar, whereas a persistence module is the whole functor whose barcode decomposition those intervals summarise. The two are held owl:disjointWith and a node typed both is caught by math:PersistenceModuleLifetimeConflationConstraint (math:PersistenceModuleLifetimeConflation): a lifetime handed where a module is required is a caught error, never a silent one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PersistenceMorphism
    a owl:Class ; logic:subClassOf math:Morphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Persistence Morphism"@x-gmeow-english ;
    rdfs:seeAlso math:PersistenceModule , math:MultiparameterPersistence ;
    skos:definition "A map of persistence modules: a natural transformation between two math:PersistenceModule functors — a commuting family of linear maps, one at each index, intertwining the two modules' structure maps. A subclass of the EXISTING math:Morphism (it reuses the object-layer morphism parent rather than re-deriving a category-theory frame). It names its domain module through math:morphismSource and its codomain module through math:morphismTarget, both math:PersistenceModule individuals. It is NOT a math:PersistenceModule itself (it is a map BETWEEN modules), and NOT the analysis activity math:MultiparameterPersistence (rdfs:seeAlso). A persistence morphism naming no source or no target says nothing about which modules it relates and is ill-formed (math:IncompletePersistenceMorphism)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ZigzagDiagram
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Zigzag Diagram"@x-gmeow-english ;
    rdfs:seeAlso math:ZigzagPersistence , math:Filtration ;
    skos:definition "A sequence of spaces (or vector spaces) whose structure maps may point FORWARD or BACKWARD — V₀ → V₁ ← V₂ → V₃ ← … — permitting both additions and removals rather than the monotone inclusions of an ordinary filtration. A subclass of math:MathematicalObject. It names its structure maps through math:zigzagArrow, and each arrow declares its orientation through math:arrowDirection, a member of the OPEN math:ArrowDirection vocabulary (math:forwardArrow or math:backwardArrow). It is NOT the analysis activity math:ZigzagPersistence (rdfs:seeAlso) that computes over it — that is a gmeow:Activity, this is the diagram object. It is NOT ordinary forward-only persistence: a zigzag diagram that declares no math:backwardArrow has collapsed to the single-parameter forward-only case and is degenerate (math:DegenerateZigzagDiagram) — the backward arrow is exactly what distinguishes a zigzag from a filtration."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# The open arrow-direction vocabulary — minted like math:CellOrientation: an OPEN
# family of math:NamedIndividuals (never an owl:oneOf enumeration), so a new
# orientation convention joins by minting an individual.
math:ArrowDirection
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Arrow Direction"@x-gmeow-english ;
    skos:definition "The direction a math:ZigzagDiagram structure map points: one of math:forwardArrow or math:backwardArrow. An OPEN vocabulary of math:NamedIndividuals (never an owl:oneOf enumeration), exactly like math:CellOrientation, so a new orientation convention joins by minting an individual. A math:zigzagArrow names its direction through math:arrowDirection. It is the qualitative forward/backward sense of a single arrow, NOT the ±1 math:incidenceSign of a boundary and NOT a numeric coordinate; the presence of at least one math:backwardArrow is what keeps a zigzag from collapsing to a forward-only filtration (math:DegenerateZigzagDiagram)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Reach for it as the type of a zigzag structure map's orientation — a forward map or a backward map."@x-gmeow-english ;
    gmeow:avoidWhen "Do not model it as an owl:oneOf enumeration; a new direction convention joins by minting a math:NamedIndividual."@x-gmeow-english ;
    gmeow:howToUse "Attach one of its members to a math:zigzagArrow through math:arrowDirection."@x-gmeow-english ;
    skos:example "exz:arrow1 math:arrowDirection math:backwardArrow ."@x-gmeow-english .

math:forwardArrow
    a owl:NamedIndividual , math:ArrowDirection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "forward arrow"@x-gmeow-english ;
    skos:definition "Forward direction: the math:ArrowDirection naming a zigzag structure map that points from the earlier space to the later one (Vᵢ → Vᵢ₊₁), the inclusion-like direction an ordinary filtration uses. A member of the open math:ArrowDirection vocabulary."@x-gmeow-english .

math:backwardArrow
    a owl:NamedIndividual , math:ArrowDirection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "backward arrow"@x-gmeow-english ;
    skos:definition "Backward direction: the math:ArrowDirection naming a zigzag structure map that points from the later space back to the earlier one (Vᵢ ← Vᵢ₊₁), the reversal that only a zigzag admits. A member of the open math:ArrowDirection vocabulary; a math:ZigzagDiagram with no backward arrow has collapsed to forward-only persistence (math:DegenerateZigzagDiagram)."@x-gmeow-english .

math:SheafCohomology
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Sheaf Cohomology"@x-gmeow-english ;
    skos:definition "The cohomological invariants measuring obstructions to gluing local sheaf data into global sections."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SheafLaplacian
    a owl:Class ; logic:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Sheaf Laplacian"@x-gmeow-english ;
    skos:definition "A Laplacian built from cellular-sheaf coboundary maps and inner products, measuring incompatibility of local data. Unlike a scalar graph Laplacian, it acts on sheaf-valued cochains through the declared restriction maps, not on plain vertex functions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:HodgeLaplacian
    a owl:Class ; logic:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hodge Laplacian"@x-gmeow-english ;
    skos:definition "The degree-wise operator formed from a boundary or coboundary and its adjoint, whose kernel is the harmonic component."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CombinatorialLaplacian
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Combinatorial Laplacian"@x-gmeow-english ;
    skos:definition "The degree-k combinatorial (graph/cell) Laplacian of a math:CellComplex, built entirely from the complex's own signed boundary operators: L_k = ∂_{k+1}∘∂_{k+1}* + ∂_k*∘∂_k, the sum of an UP term (the degree-(k+1) boundary math:upperBoundaryOperator ∂_{k+1} composed with its own adjoint) and a DOWN term (the adjoint of the degree-k boundary math:lowerBoundaryOperator ∂_k composed with itself), both assembled from the reified ±1 math:CellIncidence coefficients (math:incidenceSign) of the named math:combinatorialLaplacianComplex at math:laplacianDegree k. Its kernel — the harmonic k-cochains annihilated by both terms — has dimension the k-th math:BettiNumber of the complex (the discrete Hodge theorem). Identity criteria: two combinatorial Laplacians coincide exactly when their complex, degree, and both named boundary operators coincide. It is NOT the general math:HodgeLaplacian — the manifold/continuum operator formed from a differential-form Hodge star and exterior derivative over a smooth or Riemannian structure, of which this class is the finite-dimensional, purely combinatorial specialisation over a bare cell complex, assuming no metric or smooth structure beyond the signed incidence data — and it is NOT the math:SheafLaplacian, which generalises this exact construction to a math:CellularSheaf's NON-CONSTANT stalks and math:SheafRestrictionMaps rather than the plain, unweighted boundary operators of an unadorned complex (this class is the math:SheafLaplacian's specialisation to the math:ConstantSheaf case, the companion of math:constantSheafRecoversHomologyLaw at the operator level rather than the cohomology level). A combinatorial Laplacian naming no complex, no degree, or missing either constitutive boundary operator is ill-formed (math:IncompleteCombinatorialLaplacian)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:HodgeDecomposition
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hodge Decomposition"@x-gmeow-english ;
    skos:definition "An orthogonal decomposition of a chain, cochain, or flow into exact, coexact, and harmonic components under declared inner products. Unlike an arbitrary direct sum, its three components are mutually orthogonal and the harmonic part is uniquely determined, not freely chosen."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:HarmonicComponent
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Harmonic Component"@x-gmeow-english ;
    skos:definition "The component of a Hodge decomposition lying in the kernel of the applicable Hodge Laplacian."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ExactComponent
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Exact Component"@x-gmeow-english ;
    skos:definition "The component of a Hodge decomposition lying in the image of the applicable boundary or coboundary operator."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CoexactComponent
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Coexact Component"@x-gmeow-english ;
    skos:definition "The component of a Hodge decomposition lying in the image of the adjoint boundary or coboundary operator."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Connections, parallel transport, and holonomy --------------------------- #
# The PRIMARY reading is DISCRETE: the math:SheafRestrictionMaps of a math:CellularSheaf
# ARE a connection; parallel transport is their composition along a path; holonomy is the
# composite around a CLOSED loop; and flatness is the closedness (δ-kernel) of the
# associated transport cochain — a math:FlatConnection's transport cochain is a math:Cocycle
# (flat ⇔ closed). This links directly to the landed math:SheafLaplacian / math:HodgeDecomposition
# / math:Cocycle surface. The manifold math:Atlas / math:Chart / math:transitionMap composition is
# the SECONDARY geometric reading. The UNIVERSAL curvature statement F = dA + A∧A over all loops
# is genuinely higher-order and is recorded as the honest boundary math:holonomyCurvatureBoundary,
# never faked as a first-order formula — this is deliberately a minimal realization, not a full
# curvature calculus.

math:Connection
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Connection"@x-gmeow-english ;
    rdfs:seeAlso math:SheafLaplacian , math:HodgeDecomposition , math:Cocycle , math:holonomyCurvatureBoundary ;
    math:definingLaw math:holonomyCurvatureBoundary ;
    skos:definition "A rule of parallel transport: a prescription for carrying fibre data along paths of a base object consistently. The PRIMARY reading here is DISCRETE — the math:SheafRestrictionMaps of a math:CellularSheaf ARE a connection, transporting stalk data along each incidence, named through math:connectionOfSheaf; its transport cochain (math:transportCochain) is the object whose closedness decides flatness, so a math:FlatConnection's transport cochain is a math:Cocycle (flat ⇔ closed), linking this surface to the landed math:SheafLaplacian / math:HodgeDecomposition machinery. A subclass of math:MathematicalObject naming what it is a connection ON through math:connectionOn (a math:CellularSheaf for the discrete reading, a math:Atlas or bundle for the SECONDARY manifold reading). The full path-ordered curvature calculus F = dA + A∧A is genuinely higher-order and is NOT authored as a first-order law but recorded as the honest boundary math:holonomyCurvatureBoundary (math:definingLaw). It is NOT the metric (a math:MetricTensor measures lengths and angles; a connection transports fibre data), and NOT a math:transitionMap (a coordinate change on chart overlaps, not a transport rule); a connection naming nothing it is a connection ON is ill-formed (math:IncompleteConnection)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ParallelTransport
    a owl:Class ; logic:subClassOf math:Morphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Parallel Transport"@x-gmeow-english ;
    rdfs:seeAlso math:SheafRestrictionMap , math:Connection ;
    skos:definition "The transport of a fibre element along a DECLARED path under a connection: it names the math:Connection giving the rule through math:transportConnection and the path it runs along through math:transportAlong. For the discrete sheaf reading it is the COMPOSITION of the math:SheafRestrictionMaps met along the path, so it reuses the object-layer math:Morphism parent rather than minting a fresh map algebra. A subclass of math:Morphism. It is NOT a generic isomorphism (transport is path-dependent and need not be invertible or structure-agnostic), and NOT the math:Connection itself (it is the connection APPLIED along one path); a parallel transport naming no connection or no path transports nothing and is ill-formed (math:IncompleteParallelTransport)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Holonomy
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Holonomy"@x-gmeow-english ;
    rdfs:seeAlso math:transitionMap , math:Cocycle ;
    skos:definition "The parallel transport around a CLOSED loop: the composite transport that returns to its starting fibre, whose deviation from the identity is the curvature witness. It names the closed loop it runs around through math:holonomyLoop and the math:Connection whose transport it composes through math:holonomyOf. For the discrete sheaf reading it is the composite of the math:SheafRestrictionMaps around a cycle of cells; identity holonomy on every loop is exactly flatness, the transport cochain being closed — a math:Cocycle (rdfs:seeAlso math:Cocycle). It is NOT a coordinate change and NOT a math:transitionMap (rdfs:seeAlso — a transition map re-coordinatises a chart overlap, whereas holonomy measures the failure of transport to close up around a loop); a holonomy naming no loop or no connection witnesses nothing and is ill-formed (math:IncompleteHolonomy)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FlatConnection
    a owl:Class ; logic:subClassOf math:Connection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Flat Connection"@x-gmeow-english ;
    rdfs:seeAlso math:Cocycle ;
    skos:definition "A connection whose transport cochain is CLOSED — flat ⇔ closed. A subclass of math:Connection carrying the EL-safe, CHECKABLE link that its math:transportCochain is a math:Cocycle (the min-1 qualified + allValuesFrom restriction onto math:Cocycle): flatness is the vanishing of holonomy around every loop, which for the discrete reading is exactly the closedness (δ-kernel, a math:Cocycle from the chain-complex surface) of the associated transport cochain. This is a checkable frame link, NOT a claim of the full curvature calculus — the path-ordered curvature integral F = dA + A∧A over all loops stays the honest higher-order boundary math:holonomyCurvatureBoundary carried on math:Connection. It is NOT an arbitrary math:Connection (a flat connection's transport cochain is closed) and NOT a math:Cocycle itself (it is the connection whose transport cochain IS one)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Connection / transport / holonomy properties -------------------------- #

math:connectionOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "connection on"@x-gmeow-english ;
    skos:definition "Relates a math:Connection to the object it is a connection ON — a math:CellularSheaf for the discrete reading (whose math:SheafRestrictionMaps ARE the connection) or a math:Atlas or bundle for the manifold reading. Domain math:Connection, range a math:CellularSheaf, math:Atlas, or bundle (stated in prose). The minimal datum a connection must declare; a connection naming none transports over no base and is ill-formed (math:IncompleteConnection). math:connectionOfSheaf is its discrete refinement (rdfs:subPropertyOf)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:connectionOfSheaf
    a owl:ObjectProperty ;
    logic:subPropertyOf math:connectionOn ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "connection of sheaf"@x-gmeow-english ;
    skos:definition "Relates a math:Connection to the math:CellularSheaf whose math:SheafRestrictionMaps ARE that discrete connection — the PRIMARY reading of this surface. Domain math:Connection, range math:CellularSheaf (stated in prose). A subproperty of math:connectionOn (the discrete refinement of 'what the connection is on'). The sheaf's restriction maps compose into the math:ParallelTransport and, around a loop, the math:Holonomy; the closedness of the transport cochain is flatness (math:FlatConnection)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:transportCochain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "transport cochain"@x-gmeow-english ;
    skos:definition "Relates a math:Connection to the math:Cochain encoding its transport around the base — the cochain whose closedness (δ = 0) decides flatness. Domain math:Connection, range math:Cochain (stated in prose). For a math:FlatConnection this cochain is a math:Cocycle (flat ⇔ closed), the EL-safe link the math:FlatConnection restriction checks, tying the connection surface to the landed cochain-complex machinery rather than restating it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:transportConnection
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "transport connection"@x-gmeow-english ;
    skos:definition "Relates a math:ParallelTransport to the math:Connection giving its transport rule. Domain math:ParallelTransport, range math:Connection (stated in prose). Every parallel transport names exactly one; a transport naming none applies no rule and is ill-formed (math:IncompleteParallelTransport)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:transportAlong
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "transport along"@x-gmeow-english ;
    skos:definition "Relates a math:ParallelTransport to the path it runs along — the declared route (a cell path for the discrete reading, a curve for the manifold reading) whose met math:SheafRestrictionMaps compose into the transport. Domain math:ParallelTransport, range a path object (stated in prose). Every parallel transport names exactly one; a transport naming no path transports along nothing and is ill-formed (math:IncompleteParallelTransport)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:holonomyLoop
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "holonomy loop"@x-gmeow-english ;
    skos:definition "Relates a math:Holonomy to the CLOSED loop it runs around — the cycle of cells (discrete reading) or closed curve (manifold reading) whose transport composite the holonomy measures. Domain math:Holonomy, range a closed-loop object (stated in prose). Every holonomy names exactly one; a holonomy naming no loop measures nothing and is ill-formed (math:IncompleteHolonomy)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:holonomyOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "holonomy of"@x-gmeow-english ;
    skos:definition "Relates a math:Holonomy to the math:Connection whose parallel transport it composes around the loop. Domain math:Holonomy, range math:Connection (stated in prose). Every holonomy names exactly one; a holonomy naming no connection has no transport rule to compose and is ill-formed (math:IncompleteHolonomy)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Connection / transport / holonomy conformance failures ---------------- #

math:IncompleteConnection
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Connection"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Connection does not name what it is a connection ON — neither a math:CellularSheaf through the math:connectionOfSheaf discrete refinement nor a math:Atlas/bundle through the general math:connectionOn edge. A connection is a transport rule ON some base; one naming no base transports nothing and is ill-formed. The declarative frame gate deriving a sh:qualifiedMinCount on math:connectionOn."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteParallelTransport
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Parallel Transport"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ParallelTransport does not name BOTH its math:transportConnection (the math:Connection giving the rule) and its math:transportAlong (the path it runs along). Transport is a rule applied along a path; one missing either applies nothing or goes nowhere and is ill-formed. The declarative frame gate deriving a sh:qualifiedMinCount on each endpoint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteHolonomy
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Holonomy"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Holonomy does not name BOTH its math:holonomyLoop (the closed loop it runs around) and its math:holonomyOf (the math:Connection whose transport it composes). Holonomy is transport-around-a-loop; one missing the loop or the connection measures nothing and is ill-formed. The declarative frame gate deriving a sh:qualifiedMinCount on each."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# The honest higher-order boundary (mirrors math:smoothnessBoundary / math:compactnessBoundary):
# the DISCRETE surface stays first-order and checkable (flat ⇔ closed is an EL-safe restriction,
# holonomy around a NAMED loop is a concrete composite of restriction maps), but the UNIVERSAL
# curvature statement over ALL loops is genuinely second-order and is recorded honestly, never
# faked as a first-order logic:Formula.
math:holonomyCurvatureBoundary
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "holonomy curvature: an honest recorded second-order boundary (no first-order formula)"@x-gmeow-english ;
    logic:expressivenessBoundary logic:SecondOrder ;
    logic:preservationKind logic:Unsupported ;
    skos:definition "The loss-ledger boundary record backing math:Connection's curvature: the path-ordered curvature F = dA + A∧A — the infinitesimal holonomy accumulated around every loop — is genuinely second-order. It ∀-quantifies over the FAMILY of ALL loops (and, in the continuum, over a path-ordered exponential integral) to certify flatness, a quantification over an unbounded family of paths that is not first-order axiomatizable. The DISCRETE surface stays first-order and checkable — a math:FlatConnection's math:transportCochain being a math:Cocycle (flat ⇔ closed) is an EL-safe restriction, and holonomy around a NAMED loop is the concrete composite of math:SheafRestrictionMaps — but the UNIVERSAL curvature statement over all loops is carried here as an honest boundary (logic:expressivenessBoundary logic:SecondOrder, logic:preservationKind logic:Unsupported), residue disclosed in the ledger and never faked as a first-order logic:Formula (Principle 17). Exactly as math:smoothnessBoundary and math:compactnessBoundary are, and referenced by math:Connection through math:definingLaw."@x-gmeow-english .

# --- Reduction, reconstruction, and information ---------------------------- #

math:DimensionalReduction
    a owl:Class ; logic:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dimensional Reduction"@x-gmeow-english ;
    skos:definition "An analysis activity that maps data to a declared lower-dimensional representation and records its input, target dimension, and output embedding."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UMAPReduction
    a owl:Class ; logic:subClassOf math:DimensionalReduction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "UMAP Reduction"@x-gmeow-english ;
    skos:definition "A dimensionality-reduction analysis using the Uniform Manifold Approximation and Projection method with its metric and neighborhood parameters declared."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IsomapReduction
    a owl:Class ; logic:subClassOf math:DimensionalReduction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Isomap Reduction"@x-gmeow-english ;
    skos:definition "A dimensionality-reduction analysis that approximates geodesic distances on a neighborhood graph before embedding them in a lower-dimensional space."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SpectralInitialization
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Spectral Initialization"@x-gmeow-english ;
    skos:definition "An initialization obtained from eigenvectors of a declared graph, kernel, covariance, or Laplacian operator."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ReductionPath
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Reduction Path"@x-gmeow-english ;
    skos:definition "An ordered record of intermediate representations and transformations in a staged dimensionality-reduction procedure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ReconstructionMap
    a owl:Class ; logic:subClassOf math:Morphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Reconstruction Map"@x-gmeow-english ;
    skos:definition "A map from a reduced or embedded representation toward a source-space reconstruction, with exactness, approximation, and round-trip loss declared rather than assumed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IntrinsicDimension
    a owl:Class ; logic:subClassOf math:NaturalNumber ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Intrinsic Dimension"@x-gmeow-english ;
    skos:definition "The estimated minimum number of coordinates needed to describe a dataset or manifold at a declared scale and under a declared estimator."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:InformationMeasure
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Information Measure"@x-gmeow-english ;
    skos:definition "A mathematically framed quantity measuring uncertainty, dependence, divergence, or information relative to declared distributions, logarithm base, and units."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Entropy
    a owl:Class ; logic:subClassOf math:InformationMeasure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Information Entropy"@x-gmeow-english ;
    skos:definition "An information measure of uncertainty in a declared probability distribution, with the logarithm base and units forming part of its frame. Unlike math:CrossEntropy or math:KullbackLeiblerDivergence, it scores a single distribution against itself, not one distribution against a separate reference distribution."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MutualInformation
    a owl:Class ; logic:subClassOf math:InformationMeasure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Mutual Information"@x-gmeow-english ;
    skos:definition "The divergence between a joint distribution and the product of its marginals, measuring statistical dependence. It is not a math:Distance: it vanishes exactly when the variables are independent and is never negative, but it does not obey the triangle inequality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:KullbackLeiblerDivergence
    a owl:Class ; logic:subClassOf math:InformationMeasure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Kullback–Leibler Divergence"@x-gmeow-english ;
    skos:definition "The directed expected log-density ratio from one declared probability distribution to another, not a symmetric distance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CrossEntropy
    a owl:Class ; logic:subClassOf math:InformationMeasure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cross Entropy"@x-gmeow-english ;
    skos:definition "The expected negative log likelihood assigned by one declared distribution to outcomes drawn from another. Unlike math:Entropy, it scores a model distribution against a separate data distribution and is therefore never below that data distribution's own entropy; unlike math:KullbackLeiblerDivergence, it keeps that irreducible entropy term rather than subtracting it out."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FisherInformation
    a owl:Class ; logic:subClassOf math:InformationMeasure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Fisher Information"@x-gmeow-english ;
    skos:definition "The expected curvature or score variance of a parametric likelihood with respect to a declared parameter."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Surprisal
    a owl:Class ; logic:subClassOf math:InformationMeasure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Surprisal"@x-gmeow-english ;
    skos:definition "The negative logarithm of the declared probability of an outcome, with logarithm base and units recorded."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LogarithmBase
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Logarithm Base"@x-gmeow-english ;
    skos:definition "The declared logarithm base that fixes the scale of an information measure — base 2 (bits), base e (nats), or base 10 (hartleys). The base is a frame component of every information measure, never an implicit default; the three canonical bases are the named individuals math:logBaseTwo, math:logBaseE, and math:logBaseTen."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:InformationUnit
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Information Unit"@x-gmeow-english ;
    skos:definition "The unit in which an information measure's magnitude is expressed, paired with its logarithm base — the bit (base 2), the nat (base e), or the hartley (base 10). The three canonical units are the named individuals math:bit, math:nat, and math:hartley."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:JointDistribution
    a owl:Class ; logic:subClassOf math:Distribution ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Joint Distribution"@x-gmeow-english ;
    skos:definition "A joint probability distribution over two or more random variables, from which each marginal is recoverable. A subclass of math:Distribution; a mutual information is taken over a joint distribution, whose divergence from the product of its marginals it measures."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:logBaseTwo
    a owl:NamedIndividual , math:LogarithmBase ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "logarithm base 2"@x-gmeow-english ;
    skos:definition "The base-2 logarithm convention: information measured in bits (shannons). The canonical base of Shannon entropy in digital contexts."@x-gmeow-english .

math:logBaseE
    a owl:NamedIndividual , math:LogarithmBase ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "logarithm base e"@x-gmeow-english ;
    skos:definition "The natural-logarithm convention: information measured in nats. The canonical base in analytic and statistical settings, where derivatives of the log-likelihood are simplest."@x-gmeow-english .

math:logBaseTen
    a owl:NamedIndividual , math:LogarithmBase ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "logarithm base 10"@x-gmeow-english ;
    skos:definition "The base-10 logarithm convention: information measured in hartleys (dits, bans). The historical base of Hartley's measure."@x-gmeow-english .

math:bit
    a owl:NamedIndividual , math:InformationUnit ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "bit (shannon)"@x-gmeow-english ;
    skos:definition "The bit, or shannon: the information unit paired with the base-2 logarithm. One bit is the entropy of a uniform distribution over two equiprobable outcomes."@x-gmeow-english .

math:nat
    a owl:NamedIndividual , math:InformationUnit ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "nat"@x-gmeow-english ;
    skos:definition "The nat, or natural unit of information: the information unit paired with the base-e logarithm."@x-gmeow-english .

math:hartley
    a owl:NamedIndividual , math:InformationUnit ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "hartley (dit)"@x-gmeow-english ;
    skos:definition "The hartley, or dit (ban): the information unit paired with the base-10 logarithm."@x-gmeow-english .

math:VectorSymbolicOperation
    a owl:Class ; logic:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vector-Symbolic Operation"@x-gmeow-english ;
    skos:definition "An operation in a declared vector-symbolic architecture that composes or retrieves distributed representations."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VectorBinding
    a owl:Class ; logic:subClassOf math:VectorSymbolicOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vector Binding"@x-gmeow-english ;
    skos:definition "A vector-symbolic operation combining two representations into a representation of their association. Unlike math:VectorBundling, its result is dissimilar to both operands rather than similar to them, and it is undone by math:VectorUnbinding rather than being idempotent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VectorBundling
    a owl:Class ; logic:subClassOf math:VectorSymbolicOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vector Bundling"@x-gmeow-english ;
    skos:definition "A vector-symbolic operation superposing several representations into a similarity-preserving aggregate. Unlike math:VectorBinding, its result stays similar to each superposed operand and is not invertible into its individual factors."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:VectorUnbinding
    a owl:Class ; logic:subClassOf math:VectorSymbolicOperation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vector Unbinding"@x-gmeow-english ;
    skos:definition "A vector-symbolic operation approximately or exactly recovering one bound factor when supplied with the other and a declared binding law. Unlike math:VectorBundling, it inverts math:VectorBinding rather than superposing, and its recovery is approximate unless an exact algebra is declared, never lossless by default."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Vector-symbolic frame classes (vector-symbolic coverage family) -------- #
# A math:VectorSymbolicOperation is defined only relative to a complete, declared
# frame: the math:VectorSpace it composes representations in, a math:Basis fixing
# the coordinates, the operand math:Vector(s) it binds, bundles, or unbinds, a
# capacity descriptor bounding how many items may be superposed before recovery
# degrades, and a recovery-loss contract stating the exact fidelity of retrieval.
# Capacity and the recovery-loss contract are the reusable objects that make a
# vector-symbolic architecture more than an ordinary similarity score, and each is
# a first-class mathematical object here, never an implicit assumption. Recovery
# is approximate unless an exact algebra proves otherwise, so the recovery-loss
# contract's exact rational loss bound is constitutive.
math:VectorSymbolicCapacity
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Vector-Symbolic Capacity"@x-gmeow-english ;
    skos:definition "The capacity descriptor of a vector-symbolic operation: a first-class mathematical object carrying the exact math:RationalValue bound (through math:capacityBound) on how many representations may be bound or superposed into one vector before recovery degrades below the operation's recovery-loss contract. A subclass of math:MathematicalObject. Capacity is declared, never an implicit consequence of dimension; a vector-symbolic operation missing it is ill-formed (math:IncompleteVectorSymbolicOperation), because the point at which superposition crosstalk overwhelms retrieval is then unstated."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RecoveryLossContract
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Recovery-Loss Contract"@x-gmeow-english ;
    skos:definition "The recovery-loss (fidelity) contract of a vector-symbolic operation: a first-class mathematical object carrying the exact math:RationalValue loss bound (through math:lossBound) on the discrepancy between a recovered operand and the original — 0/1 exactly when an exact algebra makes the operation invertible, and a stated positive rational otherwise. A subclass of math:MathematicalObject. Recovery is approximate unless an exact algebra proves otherwise, so the contract is constitutive: an unbinding whose fidelity is left implicit cannot claim invertibility, and a vector-symbolic operation missing the contract is ill-formed (math:IncompleteVectorSymbolicOperation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Clifford and exterior algebra ----------------------------------------- #

math:QuadraticSpace
    a owl:Class ; logic:subClassOf math:VectorSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Quadratic Space"@x-gmeow-english ;
    skos:definition "A vector space equipped with a declared quadratic form, including its scalar field and degeneracy properties. It is not a bare vector space without that form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:QuadraticForm
    a owl:Class ; logic:subClassOf math:Function ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Quadratic Form"@x-gmeow-english ;
    skos:definition "A homogeneous degree-two scalar-valued function on a vector space, with its associated bilinear form determined when the scalar characteristic permits. It is not its associated bilinear form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GradedAlgebra
    a owl:Class ; logic:subClassOf math:Algebra ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Graded Algebra"@x-gmeow-english ;
    skos:definition "An algebra decomposed into grade-indexed components whose multiplication respects the declared grading law. It is not an arbitrary direct-sum decomposition: multiplication must respect grades."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Grading
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Grading"@x-gmeow-english ;
    skos:definition "A decomposition of an algebra or module into indexed homogeneous components together with the law governing how operations combine their grades. It is not a mere partition or labeling of elements."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ExteriorAlgebra
    a owl:Class ; logic:subClassOf math:GradedAlgebra ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Exterior Algebra"@x-gmeow-english ;
    skos:definition "The graded alternating algebra generated by a vector space under the exterior product. It is not a Clifford algebra: repeated generators vanish and no quadratic-form contribution is retained."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CliffordAlgebra
    a owl:Class ; logic:subClassOf math:GradedAlgebra ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Clifford Algebra"@x-gmeow-english ;
    skos:definition "The unital associative algebra generated by a quadratic space under the relation v² equals its quadratic form; its field, signature, basis, grading, and product convention must be explicit. It is not an exterior algebra because its product retains the quadratic-form contribution."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BasisBlade
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Basis Blade"@x-gmeow-english ;
    skos:definition "A homogeneous Clifford or exterior basis element formed as an ordered product of distinct basis generators. It is not an arbitrary multivector or a sum of blades."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CliffordAnticommutationWitness
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Clifford Anticommutation Witness"@x-gmeow-english ;
    skos:definition "A calculated record that names two distinct Clifford generators and verifies that reversing their geometric-product order negates the result."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Multivector
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Multivector"@x-gmeow-english ;
    skos:definition "An element of a Clifford algebra expressed as a sum of homogeneous blade components across one or more grades. It is not necessarily a vector or a grade-one element."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CliffordProduct
    a owl:Class ; logic:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Clifford Product"@x-gmeow-english ;
    skos:definition "A bilinear product operation defined within a declared Clifford algebra and governed by its quadratic form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GeometricProduct
    a owl:Class ; logic:subClassOf math:CliffordProduct ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Geometric Product"@x-gmeow-english ;
    skos:definition "The associative Clifford product combining inner and exterior contributions according to the declared quadratic form. It is not the scalar product or exterior product alone."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ExteriorProduct
    a owl:Class ; logic:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Exterior Product"@x-gmeow-english ;
    skos:definition "The alternating graded product, conventionally written with a wedge, that vanishes when a generator is repeated. It is not logical conjunction or the full geometric product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LeftContraction
    a owl:Class ; logic:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Left Contraction"@x-gmeow-english ;
    skos:definition "The grade-lowering product selecting the grade-difference component of a Clifford product under a declared contraction convention. It is not a symmetric inner product: operand order and the contraction convention matter."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GradeProjection
    a owl:Class ; logic:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Grade Projection"@x-gmeow-english ;
    skos:definition "The operation selecting the homogeneous component of a multivector at a declared grade. It is not coordinate selection or extraction of one basis coefficient."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CliffordInvolution
    a owl:Class ; logic:subClassOf math:Operation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Clifford Involution"@x-gmeow-english ;
    skos:definition "An order-two operation on a Clifford algebra, with its action on grades and product order declared. It is not an arbitrary algebra endomorphism: applying it twice must return the input."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Reversion
    a owl:Class ; logic:subClassOf math:CliffordInvolution ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Clifford Reversion"@x-gmeow-english ;
    skos:definition "The Clifford anti-involution that reverses the order of basis generators in every blade. It is not grade involution; its grade-dependent signs arise from order reversal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GradeInvolution
    a owl:Class ; logic:subClassOf math:CliffordInvolution ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Grade Involution"@x-gmeow-english ;
    skos:definition "The Clifford involution that negates odd-grade components and preserves even-grade components."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CliffordConjugation
    a owl:Class ; logic:subClassOf math:CliffordInvolution ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Clifford Conjugation"@x-gmeow-english ;
    skos:definition "The composition of grade involution and reversion in a Clifford algebra. It is not reversion or grade involution alone."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Rotor
    a owl:Class ; logic:subClassOf math:Multivector ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Rotor"@x-gmeow-english ;
    skos:definition "An even invertible multivector whose sandwich action implements an orthogonal transformation under a declared Clifford convention. It is not any even multivector: invertibility and the sandwich action are constitutive."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Spinor
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Spinor"@x-gmeow-english ;
    skos:definition "An element of a declared spin representation or spinor module associated with a quadratic space."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DiracOperator
    a owl:Class ; logic:subClassOf math:DifferentialOperator ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Dirac Operator"@x-gmeow-english ;
    skos:definition "A first-order differential operator built from Clifford multiplication and a compatible connection on a spinor bundle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DirectSumDecomposition
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Direct-Sum Decomposition"@x-gmeow-english ;
    skos:definition "A decomposition of one mathematical object into explicitly named summands with zero pairwise intersection and a jointly exhaustive span in the declared category. Unlike a mere set partition, its summands are subobjects whose internal sum reconstructs the whole, not disjoint blocks of elements."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CliffordModuleDecomposition
    a owl:Class ; logic:subClassOf math:DirectSumDecomposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Clifford Module Decomposition"@x-gmeow-english ;
    skos:definition "The vector-space or module decomposition of an extended Clifford algebra into an embedded base-algebra summand and the new-generator multiple of that summand; it is not an algebra direct sum."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CliffordExtension
    a owl:Class ; logic:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Clifford Extension"@x-gmeow-english ;
    skos:definition "A declared extension from a base Clifford algebra to one with an additional generator, recording both signatures and the embedding convention."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FaithfulRepresentation
    a owl:Class ; logic:subClassOf math:GroupRepresentation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Faithful Representation"@x-gmeow-english ;
    skos:definition "A group representation whose kernel is trivial, so distinct represented group elements induce distinct transformations."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:EquivariantMap
    a owl:Class ; logic:subClassOf math:Morphism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Equivariant Map"@x-gmeow-english ;
    skos:definition "A morphism between spaces carrying group actions that commutes with the declared actions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Cross-family properties ------------------------------------------------ #

math:analysisOutput
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "analysis output"@x-gmeow-english ;
    skos:definition "Relates a mathematical analysis activity to an explicit result object it produced; interpretation of that result remains a separate standpoint-indexed claim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:targetDimension
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "target dimension"@x-gmeow-english ;
    skos:definition "The non-negative integer dimension requested as the output dimension of a dimensionality-reduction analysis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:usesInitialization
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "uses initialization"@x-gmeow-english ;
    skos:definition "Relates an iterative mathematical analysis to the explicit initialization from which its optimization or iteration begins."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:reconstructionOf
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "reconstruction of"@x-gmeow-english ;
    skos:definition "Relates a reconstructed mathematical object to the representation, projection, or source object it attempts to recover."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:symplecticForm
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "symplectic form"@x-gmeow-english ;
    skos:definition "Relates a Hamiltonian system or smooth state space to the closed nondegenerate two-form that frames its Hamiltonian dynamics."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:stateSpace
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "state space"@x-gmeow-english ;
    skos:definition "Relates a dynamical or Hamiltonian system to the mathematical space containing its states."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hamiltonianFunction
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hamiltonian function"@x-gmeow-english ;
    skos:definition "Relates a Hamiltonian system to the scalar function whose symplectic gradient generates its evolution."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:generatesFlow
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "generates flow"@x-gmeow-english ;
    skos:definition "Relates a vector field, Hamiltonian function, or dynamical system to the flow it generates."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Information-measure frame properties (information-theoretic coverage family) --- #
math:overDistribution
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "over distribution"@x-gmeow-english ;
    skos:definition "Relates an information measure to the probability distribution it is taken over — the P of an entropy, surprisal, cross entropy, or divergence, or the joint distribution of a mutual information. Domain math:InformationMeasure, range math:Distribution (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:referenceDistribution
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "reference distribution"@x-gmeow-english ;
    skos:definition "Relates a divergence or cross entropy to its reference (second) distribution Q — the model distribution against which the primary distribution P is scored. Domain math:InformationMeasure, range math:Distribution (stated in prose). The direction P→Q is fixed, so a Kullback–Leibler divergence is not symmetric."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:informationBase
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "information base"@x-gmeow-english ;
    skos:definition "Relates an information measure to the logarithm base fixing its scale — base 2, base e, or base 10. Domain math:InformationMeasure, range math:LogarithmBase (stated in prose). The base is part of the measure's frame, never an implicit default; a measure missing it is ill-formed (math:IncompleteInformationMeasure)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:informationUnit
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "information unit"@x-gmeow-english ;
    skos:definition "Relates an information measure to the unit its magnitude is expressed in — the bit (base 2), the nat (base e), or the hartley (base 10) — paired with the declared logarithm base. Domain math:InformationMeasure, range math:InformationUnit (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:likelihoodModel
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "likelihood model"@x-gmeow-english ;
    skos:definition "Relates a Fisher information to the parametric likelihood model whose score-function curvature it measures. Domain math:FisherInformation, range math:Distribution (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:scoreParameter
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "score parameter"@x-gmeow-english ;
    skos:definition "Relates a Fisher information to the model parameter with respect to which the log-likelihood score and its expected curvature are taken. Domain math:FisherInformation, range math:DistributionParameter (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:ofOutcome
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "of outcome"@x-gmeow-english ;
    skos:definition "Relates a surprisal to the single outcome whose declared probability under its distribution it takes the negative logarithm of. Domain math:Surprisal, range math:MathematicalObject (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:measureValue
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "measure value"@x-gmeow-english ;
    skos:definition "Relates an information measure to the exact math:RationalValue of its computed magnitude in its declared unit — carried as an exact numerator/denominator pair, never a decimal, so a reference calculation such as the Shannon entropy of a uniform two-outcome distribution is recorded as exactly 1/1 bit. Domain math:InformationMeasure, range math:RationalValue (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Mapper-construction frame properties (Mapper coverage family) --------- #
math:sourceMetricSpace
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "source metric space"@x-gmeow-english ;
    skos:definition "Relates a Mapper construction to the source metric space it samples — the point cloud (or space) with a declared distance function over which the filter function and the clustering rule are defined. Domain math:MapperConstruction, range math:MetricSpace (stated in prose). The source is part of the construction's frame, never implicit; a construction missing it is ill-formed (math:IncompleteMapperConstruction)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:filterFunction
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "filter function"@x-gmeow-english ;
    skos:definition "Relates a Mapper construction to the filter (lens) function that maps its source metric space to a codomain the cover is taken of — a real-valued height, an eccentricity, or a density estimate. Domain math:MapperConstruction, range math:Function (stated in prose). The filter is constitutive: the whole cover/clustering pipeline is pulled back through it, so a construction whose filter function is omitted has no cover to pull back and is ill-formed (math:IncompleteMapperConstruction)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:coverScheme
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "cover scheme"@x-gmeow-english ;
    skos:definition "Relates a Mapper construction to the math:Cover of its filter function's codomain — the finite, overlapping family of cover elements whose inverse images are clustered and whose overlaps create the nerve's edges. Domain math:MapperConstruction, range math:Cover (stated in prose). The cover is declared and finitely enumerated, never an implicit resolution/gain parameter; a construction missing it is ill-formed (math:IncompleteMapperConstruction)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:clusteringRule
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "clustering rule"@x-gmeow-english ;
    skos:definition "Relates a Mapper construction to the deterministic math:ClusteringRule applied to the inverse image of each cover element to produce the nerve's vertices — for example single-linkage clustering at a fixed distance threshold. Domain math:MapperConstruction, range math:ClusteringRule (stated in prose). The rule is part of the frame so the node set is reproducible; a construction whose clustering is omitted or left to convention is ill-formed (math:IncompleteMapperConstruction)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:outputNerve
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "output nerve"@x-gmeow-english ;
    skos:definition "Relates a Mapper construction to the math:NerveComplex it produces — the simplicial complex (its one-skeleton graph plus any higher simplices) whose vertices are the per-cover-element clusters and whose simplices record cluster overlaps. Domain math:MapperConstruction, range math:NerveComplex (stated in prose). The nerve is the declared output of the construction; a construction missing it is ill-formed (math:IncompleteMapperConstruction)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasCoverElement
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has cover element"@x-gmeow-english ;
    skos:definition "Relates a math:Cover to one of its math:CoverElement members — a single overlapping set of the covering family. Domain math:Cover, range math:CoverElement (stated in prose). Enumerating the cover elements is what makes a cover deterministic: the family is listed explicitly, not summarized by a resolution and gain."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:clusteringThreshold
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "clustering threshold"@x-gmeow-english ;
    skos:definition "Relates a math:ClusteringRule to the exact math:RationalValue of the distance threshold at which it merges points — the single-linkage cut-off carried as an exact numerator/denominator pair, never a decimal, so the clustering is reproducible. Domain math:ClusteringRule, range math:RationalValue (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Vector-symbolic frame properties (vector-symbolic coverage family) ---- #
math:overVectorSpace
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "over vector space"@x-gmeow-english ;
    skos:definition "Relates a vector-symbolic operation to the math:VectorSpace it composes distributed representations in — the ambient space whose vectors are bound, bundled, or unbound. Domain math:VectorSymbolicOperation, range math:VectorSpace (stated in prose). The space is part of the operation's frame, never implicit; an operation missing it is ill-formed (math:IncompleteVectorSymbolicOperation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:overBasis
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "over basis"@x-gmeow-english ;
    skos:definition "Relates a vector-symbolic operation to the math:Basis fixing the coordinates of its vector space, so the operand and result vectors have unambiguous components and the binding law is reproducible. Domain math:VectorSymbolicOperation, range math:Basis (stated in prose). The basis is part of the operation's frame, never implicit; an operation missing it is ill-formed (math:IncompleteVectorSymbolicOperation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:vsaOperand
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "vsa operand"@x-gmeow-english ;
    skos:definition "Relates a math:VectorBinding or math:VectorBundling to one of the operand math:Vectors it composes — a factor of a binding or a summand of a bundle. Domain a math:VectorBinding or math:VectorBundling, range math:Vector (stated in prose). Binding and bundling each take two or more operands; an operation declaring fewer is ill-formed (math:IncompleteVectorSymbolicOperation), because a single operand is nothing to combine."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:boundVector
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "bound vector"@x-gmeow-english ;
    skos:definition "Relates a math:VectorUnbinding to the composite math:Vector it recovers an operand from — the previously bound representation the unbinding is applied to. Domain math:VectorUnbinding, range math:Vector (stated in prose). The bound vector is part of the unbinding's frame, never implicit; an unbinding missing it is ill-formed (math:IncompleteVectorSymbolicOperation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:unbindingKey
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "unbinding key"@x-gmeow-english ;
    skos:definition "Relates a math:VectorUnbinding to the key (cue) math:Vector supplied to retrieve a bound factor — the other operand of the original binding, or its inverse under the declared binding law. Domain math:VectorUnbinding, range math:Vector (stated in prose). Without the key there is nothing to probe the bound vector with, so an unbinding missing it is ill-formed (math:IncompleteVectorSymbolicOperation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:recoveredOperand
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "recovered operand"@x-gmeow-english ;
    skos:definition "Relates a math:VectorUnbinding to the math:Vector it produces — the retrieved estimate of the bound operand, exact when an exact algebra makes the binding invertible and a noisy approximation otherwise. Domain math:VectorUnbinding, range math:Vector (stated in prose). The recovered operand is the declared output of the unbinding; an unbinding missing it is ill-formed (math:IncompleteVectorSymbolicOperation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:operationCapacity
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "operation capacity"@x-gmeow-english ;
    skos:definition "Relates a vector-symbolic operation to the math:VectorSymbolicCapacity descriptor bounding how many representations may be bound or superposed before recovery degrades. Domain math:VectorSymbolicOperation, range math:VectorSymbolicCapacity (stated in prose). The capacity is declared, never an implicit consequence of dimension; an operation missing it is ill-formed (math:IncompleteVectorSymbolicOperation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:recoveryLossContract
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "recovery-loss contract"@x-gmeow-english ;
    skos:definition "Relates a vector-symbolic operation to the math:RecoveryLossContract stating the exact fidelity of retrieval — loss 0/1 when an exact algebra makes it invertible, a stated positive rational otherwise. Domain math:VectorSymbolicOperation, range math:RecoveryLossContract (stated in prose). Recovery is approximate unless an exact algebra proves otherwise, so the contract is constitutive; an operation missing it is ill-formed (math:IncompleteVectorSymbolicOperation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:capacityBound
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "capacity bound"@x-gmeow-english ;
    skos:definition "Relates a math:VectorSymbolicCapacity to the exact math:RationalValue of the maximum number of representations it may bind or superpose before recovery degrades — carried as an exact numerator/denominator pair, never a decimal, so the capacity is reproducible. Domain math:VectorSymbolicCapacity, range math:RationalValue (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:lossBound
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "loss bound"@x-gmeow-english ;
    skos:definition "Relates a math:RecoveryLossContract to the exact math:RationalValue of its recovery-loss bound — 0/1 exactly when an exact algebra makes the operation invertible, and a stated positive rational otherwise — carried as an exact numerator/denominator pair, never a decimal. Domain math:RecoveryLossContract, range math:RationalValue (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Hodge-decomposition frame properties (Hodge coverage family) --------- #
math:overSheaf
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "over sheaf"@x-gmeow-english ;
    skos:definition "Relates a Hodge decomposition to the cellular sheaf whose sheaf Laplacian and coboundary maps define its exact, coexact, and harmonic subspaces. Domain math:HodgeDecomposition, range math:CellularSheaf (stated in prose). The carrier is part of the decomposition's frame, never implicit; a decomposition missing it is ill-formed (math:IncompleteHodgeDecomposition)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hodgeBoundaryOperator
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hodge boundary operator"@x-gmeow-english ;
    skos:definition "Relates a Hodge decomposition to the boundary operator whose image is the exact component and whose adjoint's image is the coexact component. Domain math:HodgeDecomposition, range math:BoundaryOperator (stated in prose). The operator is constitutive of the decomposition — the exact/coexact split is defined relative to it; a decomposition whose boundary operator is omitted or wrongly typed is ill-formed (math:IncompleteHodgeDecomposition)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:exactComponent
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exact component"@x-gmeow-english ;
    skos:definition "Relates a Hodge decomposition to its exact component — the part lying in the image of the applicable boundary or coboundary operator. Domain math:HodgeDecomposition, range math:ExactComponent (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:coexactComponent
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "coexact component"@x-gmeow-english ;
    skos:definition "Relates a Hodge decomposition to its coexact component — the part lying in the image of the adjoint boundary or coboundary operator. Domain math:HodgeDecomposition, range math:CoexactComponent (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:harmonicComponent
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "harmonic component"@x-gmeow-english ;
    skos:definition "Relates a Hodge decomposition to its harmonic component — the part lying in the kernel of the applicable Hodge Laplacian, orthogonal to both the exact and coexact parts. Domain math:HodgeDecomposition, range math:HarmonicComponent (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:reconstructionResidual
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "reconstruction residual"@x-gmeow-english ;
    skos:definition "Relates a Hodge decomposition to the exact math:RationalValue of the residual norm of its reconstruction — the signal minus the sum of its exact, coexact, and harmonic components. The Hodge decomposition theorem makes this residual exactly zero, carried as the exact pair 0/1, never a decimal; a non-zero residual would witness a failed reconstruction. Domain math:HodgeDecomposition, range math:RationalValue (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:exactCoexactInnerProduct
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exact–coexact inner product"@x-gmeow-english ;
    skos:definition "Relates a Hodge decomposition to the exact math:RationalValue of the inner product ⟨exact, coexact⟩ of its exact and coexact components. Orthogonality of the two components makes this value exactly zero, carried as the exact pair 0/1. Domain math:HodgeDecomposition, range math:RationalValue (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:exactHarmonicInnerProduct
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exact–harmonic inner product"@x-gmeow-english ;
    skos:definition "Relates a Hodge decomposition to the exact math:RationalValue of the inner product ⟨exact, harmonic⟩ of its exact and harmonic components. Orthogonality of the two components makes this value exactly zero, carried as the exact pair 0/1. Domain math:HodgeDecomposition, range math:RationalValue (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:coexactHarmonicInnerProduct
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "coexact–harmonic inner product"@x-gmeow-english ;
    skos:definition "Relates a Hodge decomposition to the exact math:RationalValue of the inner product ⟨coexact, harmonic⟩ of its coexact and harmonic components. Orthogonality of the two components makes this value exactly zero, carried as the exact pair 0/1. Domain math:HodgeDecomposition, range math:RationalValue (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:sheafBaseComplex
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "sheaf base complex"@x-gmeow-english ;
    skos:definition "Relates a cellular sheaf to the cell complex on which its stalks and restriction maps are indexed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasStalk
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has stalk"@x-gmeow-english ;
    skos:definition "Relates a sheaf to one of its local stalk objects."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:stalkOverCell
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "stalk over cell"@x-gmeow-english ;
    skos:definition "Relates a cellular-sheaf stalk to the cell of the base complex to which it is assigned."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:restrictionMap
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "restriction map"@x-gmeow-english ;
    skos:definition "Relates a sheaf to one of its compatible restriction maps between stalks."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasSection
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has section"@x-gmeow-english ;
    skos:definition "Relates a sheaf to a local or global compatible section."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasGlobalSection
    a owl:ObjectProperty ; logic:subPropertyOf math:hasSection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has global section"@x-gmeow-english ;
    skos:definition "Relates a math:CellularSheaf to a math:GlobalSection over its ENTIRE base complex — the H⁰ specialisation of math:hasSection. A subproperty of math:hasSection: every global section is a section, so this edge refines rather than replaces it. Domain math:CellularSheaf, range math:GlobalSection (stated in prose). It is NOT the general math:hasSection (which also carries local sections) and NOT re-minted over it — it is the narrower edge that says the named section glues over all of X."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:sectionRegion
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "section region"@x-gmeow-english ;
    skos:definition "Relates a math:SheafSection to the math:CellComplex subcomplex of the sheaf's base over which it is defined — the region whose stalk data it assigns. Domain math:SheafSection, range math:CellComplex (stated in prose). A math:GlobalSection's region is the whole base; a math:LocalSection's region is a proper subcomplex. The region makes global-versus-local scope checkable rather than implied; a global section whose region is a proper subcomplex is misscoped (math:MisscopedSection)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:obstructionOf
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "obstruction of"@x-gmeow-english ;
    skos:definition "Relates a math:GluingObstruction to the math:CellularSheaf whose local-to-global lifting it obstructs — the sheaf whose H¹ the obstruction class inhabits. Domain math:GluingObstruction, range math:CellularSheaf (stated in prose). The anchoring sheaf is constitutive: an obstruction names no free-floating cohomology but the specific sheaf whose sections may fail to glue; a gluing obstruction naming no sheaf is ill-formed (math:UnanchoredGluingObstruction)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:stalkValue
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "stalk value"@x-gmeow-english ;
    skos:definition "Relates a math:SheafStalk to the exact integer value a math:GlobalSection of the sheaf assigns to it, carried as an xsd:integer so the gluing condition is checkable rather than asserted. Domain math:SheafStalk, range xsd:integer (stated in prose). For a sheaf carrying a single global section (the demonstrator case), applying the map's declared math:RestrictionImage to the value at a math:SheafRestrictionMap's source stalk must yield the value at its target stalk — restriction(sourceValue) = targetValue, of which raw source/target agreement is only the identity-map special case; a declared assignment whose transported value disagrees with the target witnesses the H¹ obstruction executably (math:SectionGluingInconsistency). It is NOT a general vector-valued stalk assignment (the exact-integer form is the executable case) and NOT a decimal approximation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:restrictionImage
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "restriction image"@x-gmeow-english ;
    skos:definition "Relates a math:SheafRestrictionMap to one math:RestrictionImage record of its transport action — one declared (input, output) pair the map realizes. Domain math:SheafRestrictionMap, range math:RestrictionImage (stated in prose). A map may name several, one per source value actually exercised by a demonstrator; a map naming none glues vacuously (no source value it covers is ever checked against a target)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:imageSourceValue
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "image source value"@x-gmeow-english ;
    skos:definition "Relates a math:RestrictionImage to the exact integer INPUT value of the recorded (input, output) pair — the source stalk value the math:SheafRestrictionMap's action is applied to. Domain math:RestrictionImage, range xsd:integer (stated in prose). Joined against a math:GlobalSection's math:stalkValue at the map's source stalk to select the matching recorded image; a restriction image naming none is ill-formed (math:IncompleteRestrictionImage)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:imageTargetValue
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "image target value"@x-gmeow-english ;
    skos:definition "Relates a math:RestrictionImage to the exact integer OUTPUT value of the recorded (input, output) pair — the value the math:SheafRestrictionMap's action sends its math:imageSourceValue to. Domain math:RestrictionImage, range xsd:integer (stated in prose). Compared against the math:GlobalSection's math:stalkValue at the map's target stalk; a mismatch is math:SectionGluingInconsistency. A restriction image naming none is ill-formed (math:IncompleteRestrictionImage)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Multiparameter / zigzag persistence relations --------------------------- #

math:filtrationIndexPoset
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "filtration index poset"@x-gmeow-english ;
    skos:definition "Relates a math:MultiparameterFiltration to the partially ordered PARAMETER SPACE its stages are indexed by — the poset of dimension ≥ 2 (a distance × density grid, a scale × codensity plane) whose points the math:multiIndex tuples name. Domain math:MultiparameterFiltration, range math:MathematicalObject (the parameter poset, stated in prose). It is what makes a multiparameter filtration more than a bag of one-parameter runs: the index is a genuine poset, not a single real line. A multiparameter filtration naming no index poset is ill-formed (math:IncompleteMultiparameterFiltration)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:multiIndex
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "multi-index"@x-gmeow-english ;
    skos:definition "Relates a math:FiltrationStage of a math:MultiparameterFiltration to the math:Vector giving its coordinates in the parameter poset — the multi-index (t₁, t₂, …) that REPLACES the single real math:filtrationThreshold a one-parameter stage carries. Domain math:FiltrationStage, range math:Vector (stated in prose); the vector's coordinates are its indexed math:hasComponent cells over exact math:RationalValue. A stage of a multiparameter filtration carries a math:multiIndex, NOT a math:filtrationThreshold; a multiparameter filtration whose stages carry only a real threshold and no multi-index has collapsed to one parameter (math:CollapsedMultiparameterFiltration)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:moduleIndex
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "module index"@x-gmeow-english ;
    skos:definition "Relates a math:PersistenceModule to the index poset it is a functor over — the source category of the functor P: (index poset) → Vect. Domain math:PersistenceModule, range math:MathematicalObject (the index poset, stated in prose). Together with the math:structureMap transition maps it fixes the functor's data; a persistence module naming no index is ill-formed (math:IncompletePersistenceModule)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:structureMap
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "structure map"@x-gmeow-english ;
    skos:definition "Relates a math:PersistenceModule to one of its comparable-pair transition maps — the linear map P(s ≤ t): P(s) → P(t) the functor assigns to a comparable pair of its math:moduleIndex poset. Domain math:PersistenceModule, range math:MathematicalObject (a linear map, stated in prose). The structure maps are the functor's action on morphisms; a persistence module naming no structure map has vector spaces but no functorial glue and is ill-formed (math:IncompletePersistenceModule)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:morphismSource
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "morphism source"@x-gmeow-english ;
    skos:definition "Relates a math:PersistenceMorphism to the math:PersistenceModule it maps FROM — the domain module of the natural transformation. Domain math:PersistenceMorphism, range math:PersistenceModule (stated in prose). It is the persistence-specific source edge, kept distinct from the general math:sourceObject a math:Functor uses for its source math:Category. A persistence morphism naming no source is ill-formed (math:IncompletePersistenceMorphism)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:morphismTarget
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "morphism target"@x-gmeow-english ;
    skos:definition "Relates a math:PersistenceMorphism to the math:PersistenceModule it maps TO — the codomain module of the natural transformation. Domain math:PersistenceMorphism, range math:PersistenceModule (stated in prose). It is the persistence-specific target edge, kept distinct from the general math:targetObject a math:Functor uses for its target math:Category. A persistence morphism naming no target is ill-formed (math:IncompletePersistenceMorphism)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:zigzagArrow
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "zigzag arrow"@x-gmeow-english ;
    skos:definition "Relates a math:ZigzagDiagram to one of its structure maps — an arrow between two consecutive spaces of the sequence, carrying its orientation through math:arrowDirection. Domain math:ZigzagDiagram, range a math:Morphism structure map (stated in prose). The diagram is the family of its arrows; whether any arrow is a math:backwardArrow is what keeps the diagram from collapsing to a forward-only filtration (math:DegenerateZigzagDiagram)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:arrowDirection
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "arrow direction"@x-gmeow-english ;
    skos:definition "Relates a math:zigzagArrow structure map to the math:ArrowDirection it carries — math:forwardArrow or math:backwardArrow. Domain a math:zigzagArrow value, range math:ArrowDirection (stated in prose). It records the arrow's forward/backward sense, the datum a math:ZigzagDiagram is queried on to confirm it is genuinely bidirectional; a diagram whose arrows are all math:forwardArrow is degenerate (math:DegenerateZigzagDiagram)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasLaplacian
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has Laplacian"@x-gmeow-english ;
    skos:definition "Relates a complex, sheaf, or graded space to the Laplacian operator defined on it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:combinatorialLaplacianComplex
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "combinatorial Laplacian complex"@x-gmeow-english ;
    skos:definition "Relates a math:CombinatorialLaplacian to the math:CellComplex it is the Laplacian OF — the complex whose signed math:CellIncidence coefficients its two named boundary operators are drawn from. Domain math:CombinatorialLaplacian, range math:CellComplex (stated in prose). The reverse-direction narrowing companion of math:hasLaplacian (which points complex → Laplacian): this edge lets the Laplacian object itself name its carrier, so a combinatorial Laplacian is never left over an implicit or unstated complex. A combinatorial Laplacian missing it is ill-formed (math:IncompleteCombinatorialLaplacian)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:laplacianDegree
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Laplacian degree"@x-gmeow-english ;
    skos:definition "Relates a math:CombinatorialLaplacian to the math:NaturalNumber k that is its degree — the grade of the cochains it acts on, the same grade whose kernel dimension is the k-th math:BettiNumber of the complex. Domain math:CombinatorialLaplacian, range math:NaturalNumber (stated in prose). Distinct from math:cellDimension (the grade of a single math:Cell): this is the degree OF THE OPERATOR itself, fixing which two boundary operators — degree k and degree k+1 — it is assembled from. A combinatorial Laplacian whose degree is left implicit is ill-formed (math:IncompleteCombinatorialLaplacian)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:upperBoundaryOperator
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "upper boundary operator"@x-gmeow-english ;
    skos:definition "Relates a degree-k math:CombinatorialLaplacian to the degree-(k+1) math:BoundaryOperator ∂_{k+1} whose composite with its own adjoint, ∂_{k+1}∘∂_{k+1}*, forms the UP term of L_k = ∂_{k+1}∘∂_{k+1}* + ∂_k*∘∂_k. Domain math:CombinatorialLaplacian, range math:BoundaryOperator (stated in prose). It is NOT math:lowerBoundaryOperator — the degree-k operator forming the DOWN term — the two relate distinct boundary maps between distinct chain groups, and both are constitutive; a combinatorial Laplacian missing either is ill-formed (math:IncompleteCombinatorialLaplacian)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:lowerBoundaryOperator
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "lower boundary operator"@x-gmeow-english ;
    skos:definition "Relates a degree-k math:CombinatorialLaplacian to the degree-k math:BoundaryOperator ∂_k whose adjoint composed with itself, ∂_k*∘∂_k, forms the DOWN term of L_k = ∂_{k+1}∘∂_{k+1}* + ∂_k*∘∂_k. Domain math:CombinatorialLaplacian, range math:BoundaryOperator (stated in prose). It is NOT math:upperBoundaryOperator — the degree-(k+1) operator forming the UP term — the two relate distinct boundary maps between distinct chain groups, and both are constitutive; a combinatorial Laplacian missing either is ill-formed (math:IncompleteCombinatorialLaplacian)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:decomposesFlow
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "decomposes flow"@x-gmeow-english ;
    skos:definition "Relates a Hodge decomposition to the flow, chain, or cochain it separates into exact, coexact, and harmonic components."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasQuadraticForm
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has quadratic form"@x-gmeow-english ;
    skos:definition "Relates a quadratic space or Clifford algebra to the quadratic form governing its metric relation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:scalarField
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "field of scalars"@x-gmeow-english ;
    skos:definition "Relates a vector space, quadratic space, module, or algebra to the explicitly declared field of scalars over which its operations are interpreted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasGrading
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has grading"@x-gmeow-english ;
    skos:definition "Relates a graded algebra or module to the explicit grading that decomposes it into homogeneous components."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:cliffordInvolution
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Clifford involution"@x-gmeow-english ;
    skos:definition "Relates a Clifford algebra to a supported involution such as reversion, grade involution, or Clifford conjugation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasBasisBlade
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has basis blade"@x-gmeow-english ;
    skos:definition "Relates a Clifford algebra to one of the homogeneous basis blades induced by its ordered generator basis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasAnticommutationWitness
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has anticommutation witness"@x-gmeow-english ;
    skos:definition "Relates a Clifford algebra to a calculated witness for one distinct-generator anticommutation law."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:leftGenerator
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "left generator"@x-gmeow-english ;
    skos:definition "Relates a Clifford anticommutation witness to the generator occurring on the left in its forward product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:rightGenerator
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "right generator"@x-gmeow-english ;
    skos:definition "Relates a Clifford anticommutation witness to the distinct generator occurring on the right in its forward product."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:bladeGrade
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "blade grade"@x-gmeow-english ;
    skos:definition "The non-negative integer grade of a homogeneous basis blade."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:generatorIndex
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "generator index"@x-gmeow-english ;
    skos:definition "The positive integer position of a Clifford generator in the algebra's declared ordered basis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:generatorSquare
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "generator square"@x-gmeow-english ;
    skos:definition "The exact scalar square of a declared Clifford basis generator under the algebra's signature convention."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:pseudoscalarSquare
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "pseudoscalar square"@x-gmeow-english ;
    skos:definition "The exact scalar square of the top-grade pseudoscalar in a declared Clifford algebra and basis convention."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:anticommutationVerified
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "anticommutation verified"@x-gmeow-english ;
    skos:definition "The boolean result of exactly checking the named distinct-generator anticommutation witness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:decomposedObject
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "decomposed object"@x-gmeow-english ;
    skos:definition "Relates a decomposition record to the mathematical object decomposed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:directSummand
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "direct summand"@x-gmeow-english ;
    skos:definition "Relates a direct-sum decomposition to one of its explicitly identified summands."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:moduleBaseSummand
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "module base summand"@x-gmeow-english ;
    skos:definition "Relates a Clifford module decomposition to the embedded base-algebra summand."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:moduleExtensionSummand
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "module extension summand"@x-gmeow-english ;
    skos:definition "Relates a Clifford module decomposition to the summand obtained by left multiplication with the new extension generator."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:splitJoinVerified
    a owl:DatatypeProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "split/join verified"@x-gmeow-english ;
    skos:definition "The boolean result of an exact round trip through a declared Clifford extension split and join."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:baseAlgebra
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "base algebra"@x-gmeow-english ;
    skos:definition "Relates a Clifford extension to the lower-generator Clifford algebra being embedded."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:extendedAlgebra
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "extended algebra"@x-gmeow-english ;
    skos:definition "Relates a Clifford extension to the Clifford algebra obtained after adjoining the declared generator."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:extensionGenerator
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "extension generator"@x-gmeow-english ;
    skos:definition "Relates a Clifford extension to the additional basis generator, including its grade and exact square."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:representedObject
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "represented object"@x-gmeow-english ;
    skos:definition "Relates a mathematical representation to the group, algebra, or structured object it represents."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:representationMap
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "representation map"@x-gmeow-english ;
    skos:definition "Relates a representation record to the explicit morphism realizing the representation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:equivariantMap
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "equivariant map"@x-gmeow-english ;
    skos:definition "Relates a representation or structured comparison to the explicit map proved to commute with the declared group actions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:equivariantUnder
    a owl:ObjectProperty ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "equivariant under"@x-gmeow-english ;
    skos:definition "Relates an equivariant map to the group action or symmetry with which it commutes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- External-corpus coverage conformance failures ------------------------- #

math:IncompletePersistentHomologyAnalysis
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Persistent-Homology Analysis"@x-gmeow-english ;
    skos:definition "The failure raised when a persistent-homology analysis lacks its input, filtration, or persistence-summary output."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteDimensionalityReductionAnalysis
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Dimensionality-Reduction Analysis"@x-gmeow-english ;
    skos:definition "The failure raised when a dimensionality-reduction analysis lacks its input, target dimension, or output embedding."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteHamiltonianSystem
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Hamiltonian System"@x-gmeow-english ;
    skos:definition "The failure raised when a Hamiltonian system lacks its smooth state space, symplectic form, Hamiltonian function, or generated Hamiltonian flow."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteCell
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Cell"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Cell lacks its math:cellDimension: a cell whose grade is not declared is ill-formed, because the dimension is constitutive — an undimensioned cell cannot sit in the graded boundary chain of a math:CellComplex, and its faces cannot be placed one grade below it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnorientedIncidence
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unoriented Incidence"@x-gmeow-english ;
    skos:definition "The failure raised when a math:CellIncidence lacks its math:incidenceCoface, its math:incidenceFace, or its math:incidenceSign: a signed incidence missing its coface, its face, or its ±1 sign is ill-formed, because all three are constitutive of a boundary coefficient. This is the executable boundary-orientation coverage: it enforces the PRESENCE of the boundary sign on each incidence. The COHERENCE of the signs — that the twice-applied boundary vanishes (∂∘∂ = 0) — is a separate law enforced downstream by the boundary-square-zero constraint, not by this frame."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteCellularSheaf
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Cellular Sheaf"@x-gmeow-english ;
    skos:definition "The failure raised when a cellular sheaf lacks its base complex, stalks, or restriction maps."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteCliffordAlgebra
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Clifford Algebra"@x-gmeow-english ;
    skos:definition "The failure raised when a Clifford algebra lacks its scalar field, signature, basis blades, grading, product/involution frame, or exact vector-space dimension."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteCliffordExtension
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Clifford Extension"@x-gmeow-english ;
    skos:definition "The failure raised when a Clifford extension lacks its base algebra, extended algebra, or additional generator."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteInformationMeasure
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Information Measure"@x-gmeow-english ;
    skos:definition "The failure raised when an information measure lacks a required frame component — its probability distribution, its logarithm base, its information unit, a divergence's reference distribution, a Fisher information's likelihood model or score parameter, or a surprisal's outcome. An information measure is defined only relative to a complete, declared frame; a bare uncertainty, divergence, or information token with an implicit distribution, base, or unit is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteHodgeDecomposition
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Hodge Decomposition"@x-gmeow-english ;
    skos:definition "The failure raised when a Hodge decomposition lacks a required frame component — the signal it decomposes, its exact, coexact, or harmonic component, its boundary operator, its carrier sheaf, the exact residual witnessing reconstruction, or one of the three exact pairwise-orthogonality inner products. A Hodge decomposition is defined only relative to a complete, declared frame; a bare split whose boundary operator, reconstruction residual, or component orthogonality is implicit is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteCombinatorialLaplacian
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Combinatorial Laplacian"@x-gmeow-english ;
    skos:definition "The failure raised when a math:CombinatorialLaplacian lacks a required frame component — the math:CellComplex it is built over (math:combinatorialLaplacianComplex), its degree k (math:laplacianDegree), or either of its two constitutive boundary operators (math:upperBoundaryOperator, the degree-(k+1) operator forming the UP term; math:lowerBoundaryOperator, the degree-k operator forming the DOWN term). A combinatorial Laplacian is defined only relative to a complete, declared frame; a bare Laplacian token whose complex, degree, or either boundary operator is implicit says nothing about which operator L_k = ∂_{k+1}∘∂_{k+1}* + ∂_k*∘∂_k actually names and is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteMapperConstruction
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Mapper Construction"@x-gmeow-english ;
    skos:definition "The failure raised when a Mapper construction lacks a required frame component — its source metric space, its filter (lens) function, the cover of the filter codomain, the clustering rule applied inside each cover element's inverse image, or the output nerve complex. A Mapper construction is defined only relative to a complete, declared frame; a bare graph whose filter, cover, or clustering rule is implicit is ill-formed, because without them the node set and edge set are not reproducible."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteVectorSymbolicOperation
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Vector-Symbolic Operation"@x-gmeow-english ;
    skos:definition "The failure raised when a vector-symbolic operation lacks a required frame component — the math:VectorSpace it composes in, the math:Basis fixing its coordinates, its operand vectors (two or more for a binding or bundling; the bound vector, key, and recovered operand for an unbinding), its capacity descriptor, or its recovery-loss (fidelity) contract. A vector-symbolic operation is defined only relative to a complete, declared frame; a bare binding, bundle, or unbinding whose capacity or recovery-loss contract is implicit is ill-formed, because without the capacity the superposition-crosstalk limit is unstated and without the loss bound the operation cannot claim invertibility — recovery is approximate unless an exact algebra proves otherwise."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Task-7 conformance-failure classes ------------------------------------- #

math:UnderspecifiedPiecewiseFunction
    a owl:Class ;
    logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Underspecified Piecewise Function"@x-gmeow-english ;
    skos:definition "The failure raised when a math:PiecewiseFunction declares no math:hasPiece (min-count 1) — a piecewise function is defined BY its pieces, so one with none says nothing about what it computes and is ill-formed. Distinct from math:UnframedFunction (a function missing its domain/codomain, which a piecewise function inherits): this failure is the missing-piece gate specific to the piecewise ladder."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Reach for it as the typed violation object when a math:PiecewiseFunction declares no math:hasPiece."@x-gmeow-english ;
    gmeow:avoidWhen "Do not confuse it with math:UnframedFunction (missing math:domain/math:codomain, which a piecewise function also inherits); this is specifically the missing-piece gate."@x-gmeow-english ;
    gmeow:howToUse "Point the min-count-1 restriction on math:hasPiece at it through gmeow:enforcesFailureClass."@x-gmeow-english ;
    skos:example "exf:pw a math:PiecewiseFunction ; math:domain exf:reals ; math:codomain exf:reals . # no math:hasPiece -> math:UnderspecifiedPiecewiseFunction"@x-gmeow-english .

math:UnbackedAnalyticProperty
    a owl:Class ;
    logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unbacked Analytic Property"@x-gmeow-english ;
    skos:definition "The failure raised when a math:AnalyticProperty resolves to no defining law — it carries no math:definingLaw edge to a real first-order logic:Formula (math:nonAffinityLaw, math:convexityLaw, math:boundednessLaw) nor to an honest logic:expressivenessBoundary record (math:smoothnessBoundary). A monotonicity or analytic-property claim MUST be backed by a real law or a recorded boundary, never a bare flag; a bare analytic-property token is unauthorable by construction. Enforced by the guarded-existence logic:Constraint math:AnalyticPropertyBackedConstraint (every math:AnalyticProperty requires a math:definingLaw), lowered to a SHACL sh:sparql constraint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Reach for it as the typed violation object when a math:AnalyticProperty carries no math:definingLaw — no edge to a first-order logic:Formula nor to a recorded expressiveness boundary."@x-gmeow-english ;
    gmeow:avoidWhen "Do not raise it for math:smoothness, which is legitimately backed by the boundary record math:smoothnessBoundary rather than a first-order law; a recorded boundary counts as backing."@x-gmeow-english ;
    gmeow:howToUse "Point the guarded-existence constraint math:AnalyticPropertyBackedConstraint at it through gmeow:enforcesFailureClass; a bare analytic-property token is unauthorable by construction."@x-gmeow-english ;
    skos:example "exf:mystery a math:AnalyticProperty . # no math:definingLaw -> math:UnbackedAnalyticProperty"@x-gmeow-english .

# --- Chain/cochain square-zero conformance failures ------------------------- #

math:BrokenBoundarySquareZero
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Broken Boundary Square Zero"@x-gmeow-english ;
    skos:definition "The failure raised when the twice-applied boundary does not vanish (∂∘∂ ≠ 0): on a math:SimplicialComplex a codimension-2 composition path lacks its cancelling partner face (the broken diamond, math:BoundarySquareZeroConstraint), or on a general CW complex some codimension-2 pair's finite signed sum Σ_b [c:b]·[b:a] is non-zero (math:GeneralBoundarySquareZeroConstraint). Both reasoning-layer and general-layer enforcement raise this one failure; the sign COHERENCE it checks is distinct from the sign PRESENCE frame math:UnorientedIncidence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BrokenCoboundarySquareZero
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Broken Coboundary Square Zero"@x-gmeow-english ;
    skos:definition "The failure raised when the twice-applied coboundary does not vanish (δ∘δ ≠ 0): on a math:CochainComplex a codimension-2 co-composition path lacks its cancelling partner coface (the broken co-diamond, math:CoboundarySquareZeroConstraint). The degree-raising dual of math:BrokenBoundarySquareZero."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BrokenBoundaryCoboundaryAdjunction
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Broken Boundary Coboundary Adjunction"@x-gmeow-english ;
    skos:definition "The failure raised when the boundary/coboundary adjunction δ = ∂* is violated: a boundary math:CellIncidence and its transpose coboundary math:CellIncidence, linked by math:adjointIncidence, carry DISAGREEING ±1 signs, so the coboundary matrix is not the transpose of the boundary matrix. Enforced by math:BoundaryCoboundaryAdjunctionConstraint; the adjunction the math:HodgeLaplacian L = δδ* + δ*δ depends on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteCochainComplex
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Cochain Complex"@x-gmeow-english ;
    skos:definition "The failure raised when a math:CochainComplex lacks its math:cochainCoboundary — the math:CoboundaryOperator whose degree-plus-one maps assemble it. A cochain complex is defined BY its coboundary operator; one naming none says nothing about its differential and is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteCoboundary
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Coboundary"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Coboundary lacks its math:coboundaryOf — the math:CoboundaryOperator it is an image under (c = δd). A coboundary that names no operator it is the image of is not grounded as a coboundary and is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UngroundedChain
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ungrounded Chain"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Chain lacks its math:chainOf — the math:ChainComplex it is a graded element of. A chain is graded by the complex it lives in; one naming no complex is free-floating and ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UngroundedCycle
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ungrounded Cycle"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Cycle lacks its math:cycleOf — the math:ChainComplex whose kernel of ∂ it lies in. A cycle names the complex it cycles in; one naming none is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Global/local section and H¹ gluing-obstruction failures ---------------- #

math:IncompleteGlobalSection
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Global Section"@x-gmeow-english ;
    skos:definition "The failure raised when a math:GlobalSection lacks its frame — its carrier math:overSheaf (the math:CellularSheaf it is a section of) or its math:sectionRegion (the base complex it is defined over). A global section is defined only relative to a declared sheaf and region; a bare global-section token whose carrier or region is implicit says nothing about what it globalises and is ill-formed. Distinct from math:MisscopedSection (a global section whose region IS declared but is a proper subcomplex): this is the missing-frame gate, that is the wrong-scope gate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MisscopedSection
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Misscoped Section"@x-gmeow-english ;
    skos:definition "The failure raised when a math:GlobalSection's math:sectionRegion is a PROPER subcomplex rather than the whole math:sheafBaseComplex of its math:overSheaf — a section typed global but scoped local. A global section is by definition over the ENTIRE base; one whose declared region differs from the base conflates the H⁰ global reading with a local datum and is ill-formed. Enforced by the cross-node equality logic:Constraint math:MisscopedSectionConstraint (region must equal base), lowered to a SHACL sh:sparql constraint. It is NOT math:IncompleteGlobalSection (that is the missing-frame gate) — here the region is present but wrong."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SectionGluingInconsistency
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Section Gluing Inconsistency"@x-gmeow-english ;
    skos:definition "The failure raised when a declared math:GlobalSection does NOT restrict consistently along a math:SheafRestrictionMap of its sheaf: applying the map's declared math:RestrictionImage to the value its source stalk carries yields a value that DISAGREES with the exact integer math:stalkValue the section assigns to the target stalk, so the local data do not glue and the claimed global section is a fiction. Presence of a global section is insufficient — the gluing condition restriction(sourceValue) = targetValue is the real hazard (raw source/target equality is only the identity-map special case), and this failure makes the H¹ obstruction executable. Enforced per-restriction-map (not by aggregation) by the cross-node equality logic:Constraint math:SectionGluingConsistencyConstraint, lowered to a SHACL sh:sparql constraint. It is NOT math:MisscopedSection (a scope error) — here the scope is right but the transported values fail to agree."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteRestrictionImage
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Restriction Image"@x-gmeow-english ;
    skos:definition "The failure raised when a math:RestrictionImage lacks its math:imageSourceValue or its math:imageTargetValue: a reified map-application record naming no input or no output value says nothing about the math:SheafRestrictionMap's transport action and cannot ground a gluing check. Both are constitutive — a restriction image is exactly the pair (input, output) the map realizes for one declared source value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteSheafSection
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Sheaf Section"@x-gmeow-english ;
    skos:definition "The failure raised when a math:LocalSection fails to declare the actual stalk-and-restriction semantics it is a section of — its carrier math:overSheaf (whose math:CellularSheaf frame in turn requires stalks and restriction maps) or its math:sectionRegion (the proper subcomplex it covers). A sheaf-theoretic section is well-formed only when anchored to a sheaf that declares genuine stalk and restriction structure; local disagreement asserted over no declared stalk/restriction data is not a section at all. It is NOT math:IncompleteGlobalSection (the H⁰ global analogue) — this is the general local-section anchoring gate that keeps bare 'the sections disagree' claims unauthorable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnanchoredGluingObstruction
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unanchored Gluing Obstruction"@x-gmeow-english ;
    skos:definition "The failure raised when a math:GluingObstruction names no math:obstructionOf sheaf — an H¹ obstruction class floating free of the math:CellularSheaf whose local-to-global lifting it is supposed to obstruct. An obstruction is defined only relative to the sheaf whose sections may fail to glue; one that names no sheaf certifies nothing and is ill-formed. It is NOT a math:SheafRestrictionMap and NOT a section — it is the cohomological reason a global section may not exist, and it must say which sheaf it reasons about."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Multiparameter / zigzag persistence failures ---------------------------- #

math:IncompleteMultiparameterFiltration
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Multiparameter Filtration"@x-gmeow-english ;
    skos:definition "The failure raised when a math:MultiparameterFiltration lacks its frame — its math:filtrationIndexPoset (the parameter poset its stages index into) or any math:hasFiltrationStage cell. A multiparameter filtration is defined only relative to a declared poset and at least one stage; a bare token naming no poset or no stage says nothing about what it filters and is ill-formed. The declarative missing-frame gate: it is DISTINCT from math:CollapsedMultiparameterFiltration (stages present but carrying only a single real math:filtrationThreshold and no math:multiIndex, the cross-node SPARQL guard) and from math:DiagonalDegenerateFiltration (a functionally dependent 2-index)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:CollapsedMultiparameterFiltration
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Collapsed Multiparameter Filtration"@x-gmeow-english ;
    skos:definition "The failure raised when a math:MultiparameterFiltration's stages carry ONLY a single real math:filtrationThreshold and NO math:multiIndex — a nominally multi-parameter filtration that has silently degraded to the one-parameter case, indexed by a single real line rather than a poset of dimension ≥ 2. A multiparameter filtration MUST index its stages by multi-index tuples; one whose every stage is a bare one-parameter threshold is not multiparameter at all. Enforced by the cross-node existence logic:Constraint math:CollapsedMultiparameterFiltrationConstraint (a multiparameter filtration must have at least one stage carrying a math:multiIndex), lowered to a SHACL sh:sparql constraint (shacl.SPARQLConstraintComponent). It is NOT math:IncompleteMultiparameterFiltration (that is the missing-poset/missing-stage frame) — here the stages are present but one-parametric."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DiagonalDegenerateFiltration
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Diagonal Degenerate Filtration"@x-gmeow-english ;
    skos:definition "The failure raised when a math:MultiparameterFiltration's coordinates are FUNCTIONALLY DEPENDENT — one index a function of the other — so the 2-index is genuinely one-parametric despite wearing a 2-tuple: the literal diagonal (t, t) is the simplest case, but (t, 2t), (t, t+1), and any other coordinate pair that never varies independently are equally degenerate. A stage that reindexes a single parameter along such a curve buys none of the extra discrimination a real two-parameter poset gives; it is a one-parameter run in multiparameter clothing. TWO cross-node logic:Constraints jointly enforce this, each lowered to a SHACL sh:sparql constraint (shacl.SPARQLConstraintComponent): math:DiagonalDegenerateFiltrationConstraint catches the literal per-stage diagonal (two components of ONE stage's math:multiIndex at distinct indices sharing the same math:componentValue node, checkable from a single stage), and math:MultiparameterFunctionalDependenceConstraint catches the general case (whenever at least two stages exist, it requires a genuine coordinate-independence WITNESS — two stages whose multi-index VARIES at one position while holding the OTHER position fixed — proving both parameters are actually live; when no such witness exists among the declared stages, the filtration is flagged degenerate, since no functionally-dependent family can ever exhibit one coordinate varying alone). It is subtler than math:CollapsedMultiparameterFiltration: there a multi-index is absent, here it is present but degenerate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompletePersistenceModule
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Persistence Module"@x-gmeow-english ;
    skos:definition "The failure raised when a math:PersistenceModule lacks its frame — its math:moduleIndex (the index poset it is a functor over) or any math:structureMap (a comparable-pair transition map). A persistence module is the functor P: (index poset) → Vect; one naming no index, or naming vector spaces with no functorial transition maps, is not a module at all and is ill-formed. The declarative frame gate deriving a sh:qualifiedMinCount; distinct from math:PersistenceModuleLifetimeConflation (a module conflated with a math:PersistenceLifetime)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompletePersistenceMorphism
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Persistence Morphism"@x-gmeow-english ;
    skos:definition "The failure raised when a math:PersistenceMorphism does not name BOTH endpoints — its math:morphismSource (the domain math:PersistenceModule) and its math:morphismTarget (the codomain math:PersistenceModule). A map of persistence modules is defined only by the two modules it relates; one missing its source or its target relates nothing and is ill-formed. The declarative frame gate deriving a sh:qualifiedMinCount on each endpoint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DegenerateZigzagDiagram
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Degenerate Zigzag Diagram"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ZigzagDiagram declares NO math:backwardArrow — every math:zigzagArrow points forward, so the diagram has collapsed to ordinary forward-only single-parameter persistence and buys none of the additions-and-removals a zigzag exists to model. A zigzag is distinguished from a filtration exactly by admitting backward maps; one with none is a filtration wearing a zigzag label. Enforced by the cross-node existence logic:Constraint math:DegenerateZigzagDiagramConstraint (a zigzag diagram must have at least one arrow whose math:arrowDirection is math:backwardArrow), lowered to a SHACL sh:sparql constraint (shacl.SPARQLConstraintComponent)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PersistenceModuleLifetimeConflation
    a owl:Class ; logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Persistence-Module–Lifetime Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when one node is typed BOTH a math:PersistenceModule and a math:PersistenceLifetime — the whole algebraic functor P: (index poset) → Vect conflated with the birth–death interval of a SINGLE feature. A module is the object whose barcode decomposition the lifetimes summarise; a lifetime is one decorated bar of that barcode, so the two are held owl:disjointWith. Because math:PersistenceModule and math:PersistenceLifetime BOTH descend from math:MathematicalObject their disjointness is NOT entailed by their parents and is asserted DIRECTLY (math:PersistenceModule owl:disjointWith math:PersistenceLifetime); the native DL coherence gate forces any individual typed both to owl:Nothing, and the paired SHACL shape (math:PersistenceModuleLifetimeConflationShape) surfaces the same conflation as a sh:not [ sh:class math:PersistenceLifetime ] finding (shacl.NotConstraintComponent) so a consumer selects on the specific class, never on the shared word 'persistence'. Wired exactly like math:ProbabilityScaleConflation and math:CalibrationSenseConflation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# The honest non-collapse boundary (mirrors math:compactnessBoundary form): the
# principled reason multiparameter persistence cannot be reduced to one-parameter
# runs is STRONGER than the structural guards above — Carlsson–Zomorodian proved
# there is no complete discrete invariant, a genuinely second-order non-existence
# claim carried in the loss ledger rather than faked as a first-order formula.
math:multiparameterInvariantBoundary
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "multiparameter persistence: no complete discrete invariant (an honest recorded boundary)"@x-gmeow-english ;
    logic:expressivenessBoundary logic:SecondOrder ;
    logic:preservationKind logic:Unsupported ;
    skos:definition "The loss-ledger boundary record backing math:MultiparameterFiltration's non-collapse: Carlsson and Zomorodian (The Theory of Multidimensional Persistence, Discrete & Computational Geometry 42(1), 2009) proved that multiparameter persistence admits NO complete discrete invariant — unlike the one-parameter case, whose barcode is a complete discrete invariant, no finite discrete summary classifies a multiparameter module up to isomorphism. This is why a multiparameter filtration cannot be reduced to a family of one-parameter runs, and it is genuinely second-order: it ∀-quantifies over the FAMILY of ALL candidate discrete invariants and asserts NONE is complete, a non-existence over an unbounded family that is not first-order axiomatizable. The structural guards (math:CollapsedMultiparameterFiltration, math:DiagonalDegenerateFiltration) catch the syntactic collapses; this boundary records the deeper mathematical reason the collapse is forbidden, carried honestly (logic:expressivenessBoundary logic:SecondOrder, logic:preservationKind logic:Unsupported), never faked as a first-order logic:Formula — exactly as math:compactnessBoundary and math:smoothnessBoundary are."@x-gmeow-english .

# =========================================================================== #
# Declarative constraint axioms (grounding slices) — the closed-world cardinality/
# class/datatype/value obligations that the hand-authored shapes.ttl NodeShapes
# state are authored here once as OWL restriction axioms and PROJECTED to
# generated/shapes/validation-shapes.ttl by derive_validation_shapes (Principle
# 17). A restriction carrying both owl:*Cardinality and owl:allValuesFrom lowers
# to the paired sh:minCount/maxCount + sh:class/sh:datatype/sh:nodeKind property
# shape. owl:allValuesFrom owl:Thing projects to sh:nodeKind sh:BlankNodeOrIRI
# (the "a present value is a resource, not a literal" obligation). Genuinely
# cross-node / value-negation / numeric-range conditions have no OWL antecedent
# and stay as the procedural sh:sparql constraint fragment.
# =========================================================================== #

math:PersistentHomology logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:analysisInput ; owl:minQualifiedCardinality 1 ; owl:onClass math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:analysisInput ; owl:allValuesFrom math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:overFiltration ; owl:minQualifiedCardinality 1 ; owl:onClass math:Filtration ] ,
    [ a owl:Restriction ; owl:onProperty math:overFiltration ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Filtration ] ,
    [ a owl:Restriction ; owl:onProperty math:overFiltration ; owl:allValuesFrom math:Filtration ] ,
    [ a owl:Restriction ; owl:onProperty math:analysisOutput ; owl:minQualifiedCardinality 1 ; owl:onClass math:PersistenceDiagram ] ,
    [ a owl:Restriction ; owl:onProperty math:analysisOutput ; owl:allValuesFrom math:MathematicalObject ] ;
    gmeow:enforcesFailureClass math:IncompletePersistentHomologyAnalysis .

math:DimensionalReduction logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:analysisInput ; owl:minQualifiedCardinality 1 ; owl:onClass math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:analysisInput ; owl:allValuesFrom math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:targetDimension ; owl:minQualifiedCardinality 1 ; owl:onDataRange xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty math:targetDimension ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty math:analysisOutput ; owl:minQualifiedCardinality 1 ; owl:onClass math:Embedding ] ,
    [ a owl:Restriction ; owl:onProperty math:analysisOutput ; owl:allValuesFrom math:Embedding ] ;
    gmeow:enforcesFailureClass math:IncompleteDimensionalityReductionAnalysis .

math:HamiltonianSystem logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:stateSpace ; owl:minQualifiedCardinality 1 ; owl:onClass math:SmoothManifold ] ,
    [ a owl:Restriction ; owl:onProperty math:stateSpace ; owl:maxQualifiedCardinality 1 ; owl:onClass math:SmoothManifold ] ,
    [ a owl:Restriction ; owl:onProperty math:stateSpace ; owl:allValuesFrom math:SmoothManifold ] ,
    [ a owl:Restriction ; owl:onProperty math:symplecticForm ; owl:minQualifiedCardinality 1 ; owl:onClass math:SymplecticForm ] ,
    [ a owl:Restriction ; owl:onProperty math:symplecticForm ; owl:maxQualifiedCardinality 1 ; owl:onClass math:SymplecticForm ] ,
    [ a owl:Restriction ; owl:onProperty math:symplecticForm ; owl:allValuesFrom math:SymplecticForm ] ,
    [ a owl:Restriction ; owl:onProperty math:hamiltonianFunction ; owl:minQualifiedCardinality 1 ; owl:onClass math:HamiltonianFunction ] ,
    [ a owl:Restriction ; owl:onProperty math:hamiltonianFunction ; owl:maxQualifiedCardinality 1 ; owl:onClass math:HamiltonianFunction ] ,
    [ a owl:Restriction ; owl:onProperty math:hamiltonianFunction ; owl:allValuesFrom math:HamiltonianFunction ] ,
    [ a owl:Restriction ; owl:onProperty math:generatesFlow ; owl:minQualifiedCardinality 1 ; owl:onClass math:HamiltonianFlow ] ,
    [ a owl:Restriction ; owl:onProperty math:generatesFlow ; owl:maxQualifiedCardinality 1 ; owl:onClass math:HamiltonianFlow ] ,
    [ a owl:Restriction ; owl:onProperty math:generatesFlow ; owl:allValuesFrom math:HamiltonianFlow ] ;
    gmeow:enforcesFailureClass math:IncompleteHamiltonianSystem .

# Graded-cell coverage: a math:Cell is well-formed only when its grade is
# declared — the minQualifiedCardinality-1 + allValuesFrom pair on
# math:cellDimension/math:NaturalNumber is an EL-safe restriction that derives the
# paired sh:minCount + sh:class property shape; an undimensioned cell fails the
# derived QualifiedMinCount and isolates math:IncompleteCell.
math:Cell logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:cellDimension ; owl:minQualifiedCardinality 1 ; owl:onClass math:NaturalNumber ] ,
    [ a owl:Restriction ; owl:onProperty math:cellDimension ; owl:allValuesFrom math:NaturalNumber ] ;
    gmeow:enforcesFailureClass math:IncompleteCell .

# Boundary-orientation coverage: a math:CellIncidence is well-formed only when all
# three of its coface, face, and ±1 sign are present — three minQualifiedCardinality-1
# restrictions (two onClass math:Cell, one onDataRange xsd:integer), each EL-safe and
# each deriving a sh:qualifiedMinCount property shape. A missing coface, face, or sign
# fails the derived QualifiedMinCount and isolates math:UnorientedIncidence. This frame
# covers sign PRESENCE; sign COHERENCE (∂∘∂ = 0) is the downstream boundary-square-zero
# constraint over math:incidentTo.
math:CellIncidence logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:incidenceCoface ; owl:minQualifiedCardinality 1 ; owl:onClass math:Cell ] ,
    [ a owl:Restriction ; owl:onProperty math:incidenceFace ; owl:minQualifiedCardinality 1 ; owl:onClass math:Cell ] ,
    [ a owl:Restriction ; owl:onProperty math:incidenceSign ; owl:minQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ;
    gmeow:enforcesFailureClass math:UnorientedIncidence .

# Cochain-complex frame: a math:CochainComplex is well-formed only when it names its
# math:cochainCoboundary (the math:CoboundaryOperator assembling it) — a min-1 qualified
# restriction deriving a sh:qualifiedMinCount property shape; a cochain complex naming
# none fails the derived QualifiedMinCount and isolates math:IncompleteCochainComplex.
math:CochainComplex logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:cochainCoboundary ; owl:minQualifiedCardinality 1 ; owl:onClass math:CoboundaryOperator ] ,
    [ a owl:Restriction ; owl:onProperty math:cochainCoboundary ; owl:allValuesFrom math:CoboundaryOperator ] ;
    gmeow:enforcesFailureClass math:IncompleteCochainComplex .

# Coboundary frame: a math:Coboundary is well-formed only when it names the
# math:coboundaryOf operator it is the image under — a min-1 qualified restriction;
# a coboundary naming none isolates math:IncompleteCoboundary.
math:Coboundary logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:coboundaryOf ; owl:minQualifiedCardinality 1 ; owl:onClass math:CoboundaryOperator ] ,
    [ a owl:Restriction ; owl:onProperty math:coboundaryOf ; owl:allValuesFrom math:CoboundaryOperator ] ;
    gmeow:enforcesFailureClass math:IncompleteCoboundary .

# Chain frame (light): a math:Chain must name its math:chainOf complex — a min-1
# qualified restriction; a chain naming none isolates math:UngroundedChain.
math:Chain logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:chainOf ; owl:minQualifiedCardinality 1 ; owl:onClass math:ChainComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:chainOf ; owl:allValuesFrom math:ChainComplex ] ;
    gmeow:enforcesFailureClass math:UngroundedChain .

# Cycle frame (light): a math:Cycle must name its math:cycleOf complex — a min-1
# qualified restriction; a cycle naming none isolates math:UngroundedCycle. (A cycle,
# being a math:Chain, also inherits the math:chainOf obligation above.)
math:Cycle logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:cycleOf ; owl:minQualifiedCardinality 1 ; owl:onClass math:ChainComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:cycleOf ; owl:allValuesFrom math:ChainComplex ] ;
    gmeow:enforcesFailureClass math:UngroundedCycle .

math:CellularSheaf logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:sheafBaseComplex ; owl:minQualifiedCardinality 1 ; owl:onClass math:CellComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:sheafBaseComplex ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CellComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:sheafBaseComplex ; owl:allValuesFrom math:CellComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:hasStalk ; owl:minQualifiedCardinality 1 ; owl:onClass math:SheafStalk ] ,
    [ a owl:Restriction ; owl:onProperty math:hasStalk ; owl:allValuesFrom math:SheafStalk ] ,
    [ a owl:Restriction ; owl:onProperty math:restrictionMap ; owl:minQualifiedCardinality 1 ; owl:onClass math:SheafRestrictionMap ] ,
    [ a owl:Restriction ; owl:onProperty math:restrictionMap ; owl:allValuesFrom math:SheafRestrictionMap ] ;
    gmeow:enforcesFailureClass math:IncompleteCellularSheaf .

# Global-section frame: a math:GlobalSection names its carrier math:overSheaf (a
# math:CellularSheaf) and the math:sectionRegion it globalises over — the H⁰ frame. A
# section missing either says nothing about what it globalises (math:IncompleteGlobalSection).
# The wrong-scope case (region present but a proper subcomplex) is the separate cross-node
# math:MisscopedSectionConstraint; this frame is the missing-frame half.
math:GlobalSection logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:overSheaf ; owl:minQualifiedCardinality 1 ; owl:onClass math:CellularSheaf ] ,
    [ a owl:Restriction ; owl:onProperty math:overSheaf ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CellularSheaf ] ,
    [ a owl:Restriction ; owl:onProperty math:overSheaf ; owl:allValuesFrom math:CellularSheaf ] ,
    [ a owl:Restriction ; owl:onProperty math:sectionRegion ; owl:minQualifiedCardinality 1 ; owl:onClass math:CellComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:sectionRegion ; owl:allValuesFrom math:CellComplex ] ;
    gmeow:enforcesFailureClass math:IncompleteGlobalSection .

# Local-section frame: a math:LocalSection declares the actual stalk-and-restriction
# semantics it sections — its carrier math:overSheaf (whose math:CellularSheaf frame in turn
# forces stalks and restriction maps) and the math:sectionRegion proper subcomplex it covers.
# A local section anchored to no sheaf is a bare 'the sections disagree' claim over no declared
# stalk/restriction data (math:IncompleteSheafSection). Scoped to the math:LocalSection subclass,
# NOT the general math:SheafSection (whose instances also serve as Hodge signals).
math:LocalSection logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:overSheaf ; owl:minQualifiedCardinality 1 ; owl:onClass math:CellularSheaf ] ,
    [ a owl:Restriction ; owl:onProperty math:overSheaf ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CellularSheaf ] ,
    [ a owl:Restriction ; owl:onProperty math:overSheaf ; owl:allValuesFrom math:CellularSheaf ] ,
    [ a owl:Restriction ; owl:onProperty math:sectionRegion ; owl:minQualifiedCardinality 1 ; owl:onClass math:CellComplex ] ,
    [ a owl:Restriction ; owl:onProperty math:sectionRegion ; owl:allValuesFrom math:CellComplex ] ;
    gmeow:enforcesFailureClass math:IncompleteSheafSection .

# Gluing-obstruction frame: a math:GluingObstruction names the math:obstructionOf sheaf
# whose local-to-global lifting it obstructs — an H¹ class anchored to no sheaf is unanchored
# (math:UnanchoredGluingObstruction).
math:GluingObstruction logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:obstructionOf ; owl:minQualifiedCardinality 1 ; owl:onClass math:CellularSheaf ] ,
    [ a owl:Restriction ; owl:onProperty math:obstructionOf ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CellularSheaf ] ,
    [ a owl:Restriction ; owl:onProperty math:obstructionOf ; owl:allValuesFrom math:CellularSheaf ] ;
    gmeow:enforcesFailureClass math:UnanchoredGluingObstruction .

# Restriction-image frame: a math:RestrictionImage is well-formed only when it names
# BOTH the exact-integer input it records (math:imageSourceValue) and the exact-integer
# output the map sends it to (math:imageTargetValue) — two min-1 qualified restrictions
# over xsd:integer. A restriction image missing either isolates math:IncompleteRestrictionImage.
# math:restrictionImage itself carries NO min-cardinality on math:SheafRestrictionMap: a map
# with no declared image glues vacuously (no source value it covers is ever checked), exactly
# as a math:GlobalSection declaring no math:stalkValue glues vacuously.
math:RestrictionImage logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:imageSourceValue ; owl:minQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty math:imageTargetValue ; owl:minQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ;
    gmeow:enforcesFailureClass math:IncompleteRestrictionImage .

# Multiparameter-filtration frame: a math:MultiparameterFiltration names its
# math:filtrationIndexPoset (the parameter poset) and at least one math:hasFiltrationStage —
# two min-1 qualified restrictions deriving sh:qualifiedMinCount property shapes. A filtration
# naming no poset or no stage isolates math:IncompleteMultiparameterFiltration. The stronger
# "stages carry a math:multiIndex, not a bare real threshold" obligation is the cross-node
# math:CollapsedMultiparameterFiltrationConstraint, not this presence frame.
math:MultiparameterFiltration logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:filtrationIndexPoset ; owl:minQualifiedCardinality 1 ; owl:onClass math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:filtrationIndexPoset ; owl:allValuesFrom math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:hasFiltrationStage ; owl:minQualifiedCardinality 1 ; owl:onClass math:FiltrationStage ] ,
    [ a owl:Restriction ; owl:onProperty math:hasFiltrationStage ; owl:allValuesFrom math:FiltrationStage ] ;
    gmeow:enforcesFailureClass math:IncompleteMultiparameterFiltration .

# Persistence-module frame: a math:PersistenceModule names its math:moduleIndex
# poset and at least one math:structureMap transition map — two min-1 qualified restrictions.
# A module naming no index or no structure map isolates math:IncompletePersistenceModule.
math:PersistenceModule logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:moduleIndex ; owl:minQualifiedCardinality 1 ; owl:onClass math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:moduleIndex ; owl:allValuesFrom math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:structureMap ; owl:minQualifiedCardinality 1 ; owl:onClass math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:structureMap ; owl:allValuesFrom math:MathematicalObject ] ;
    gmeow:enforcesFailureClass math:IncompletePersistenceModule .

# Persistence-morphism frame: a math:PersistenceMorphism names BOTH its
# math:morphismSource and math:morphismTarget math:PersistenceModule endpoints — two min-1
# qualified restrictions. A morphism missing either endpoint isolates
# math:IncompletePersistenceMorphism.
math:PersistenceMorphism logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:morphismSource ; owl:minQualifiedCardinality 1 ; owl:onClass math:PersistenceModule ] ,
    [ a owl:Restriction ; owl:onProperty math:morphismSource ; owl:allValuesFrom math:PersistenceModule ] ,
    [ a owl:Restriction ; owl:onProperty math:morphismTarget ; owl:minQualifiedCardinality 1 ; owl:onClass math:PersistenceModule ] ,
    [ a owl:Restriction ; owl:onProperty math:morphismTarget ; owl:allValuesFrom math:PersistenceModule ] ;
    gmeow:enforcesFailureClass math:IncompletePersistenceMorphism .

# Connection frame: a math:Connection names what it is a connection ON
# through math:connectionOn — a math:CellularSheaf (its restriction maps ARE the discrete
# connection, via the math:connectionOfSheaf refinement) or a math:Atlas/bundle for the manifold
# reading. A min-1 qualified restriction (onClass owl:Thing, like the CliffordAlgebra scalarField
# arm, so an Atlas value is admitted) deriving a sh:qualifiedMinCount; a connection naming no base
# isolates math:IncompleteConnection.
math:Connection logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:connectionOn ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:connectionOn ; owl:allValuesFrom owl:Thing ] ;
    gmeow:enforcesFailureClass math:IncompleteConnection .

# Parallel-transport frame: a math:ParallelTransport names BOTH its
# math:transportConnection (the math:Connection rule) and its math:transportAlong (the path) —
# two min-1 qualified restrictions. A transport missing either isolates
# math:IncompleteParallelTransport.
math:ParallelTransport logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:transportConnection ; owl:minQualifiedCardinality 1 ; owl:onClass math:Connection ] ,
    [ a owl:Restriction ; owl:onProperty math:transportConnection ; owl:allValuesFrom math:Connection ] ,
    [ a owl:Restriction ; owl:onProperty math:transportAlong ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:transportAlong ; owl:allValuesFrom owl:Thing ] ;
    gmeow:enforcesFailureClass math:IncompleteParallelTransport .

# Holonomy frame: a math:Holonomy names BOTH its math:holonomyLoop (the
# closed loop) and its math:holonomyOf (the math:Connection) — two min-1 qualified restrictions.
# A holonomy missing either isolates math:IncompleteHolonomy.
math:Holonomy logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:holonomyLoop ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:holonomyLoop ; owl:allValuesFrom owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:holonomyOf ; owl:minQualifiedCardinality 1 ; owl:onClass math:Connection ] ,
    [ a owl:Restriction ; owl:onProperty math:holonomyOf ; owl:allValuesFrom math:Connection ] ;
    gmeow:enforcesFailureClass math:IncompleteHolonomy .

# Flat-connection cocycle link: flat ⇔ closed. A math:FlatConnection is a
# math:Connection whose math:transportCochain is a math:Cocycle — the EL-safe min-1 qualified
# restriction encodes 'a flat connection HAS a closed transport cochain', the paired allValuesFrom
# that EVERY transport cochain it names is closed. This is the CHECKABLE discrete link, NOT the
# full curvature calculus (that stays the honest math:holonomyCurvatureBoundary on math:Connection).
# No gmeow:enforcesFailureClass: it is a semantic subclass link, not a well-formedness frame.
math:FlatConnection logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:transportCochain ; owl:minQualifiedCardinality 1 ; owl:onClass math:Cocycle ] ,
    [ a owl:Restriction ; owl:onProperty math:transportCochain ; owl:allValuesFrom math:Cocycle ] .

math:CliffordAlgebra logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:scalarField ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:scalarField ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:metricSignature ; owl:minQualifiedCardinality 1 ; owl:onClass math:MetricSignature ] ,
    [ a owl:Restriction ; owl:onProperty math:metricSignature ; owl:maxQualifiedCardinality 1 ; owl:onClass math:MetricSignature ] ,
    [ a owl:Restriction ; owl:onProperty math:metricSignature ; owl:allValuesFrom math:MetricSignature ] ,
    [ a owl:Restriction ; owl:onProperty math:hasBasis ; owl:minQualifiedCardinality 1 ; owl:onClass math:Basis ] ,
    [ a owl:Restriction ; owl:onProperty math:hasBasis ; owl:allValuesFrom math:Basis ] ,
    [ a owl:Restriction ; owl:onProperty math:hasGrading ; owl:minQualifiedCardinality 1 ; owl:onClass math:Grading ] ,
    [ a owl:Restriction ; owl:onProperty math:hasGrading ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Grading ] ,
    [ a owl:Restriction ; owl:onProperty math:hasGrading ; owl:allValuesFrom math:Grading ] ,
    [ a owl:Restriction ; owl:onProperty math:cliffordInvolution ; owl:minQualifiedCardinality 1 ; owl:onClass math:CliffordInvolution ] ,
    [ a owl:Restriction ; owl:onProperty math:cliffordInvolution ; owl:allValuesFrom math:CliffordInvolution ] ,
    [ a owl:Restriction ; owl:onProperty math:hasBasisBlade ; owl:minQualifiedCardinality 1 ; owl:onClass math:BasisBlade ] ,
    [ a owl:Restriction ; owl:onProperty math:hasBasisBlade ; owl:allValuesFrom math:BasisBlade ] ,
    [ a owl:Restriction ; owl:onProperty math:spaceDimension ; owl:minQualifiedCardinality 1 ; owl:onDataRange xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty math:spaceDimension ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty math:pseudoscalarSquare ; owl:minQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty math:pseudoscalarSquare ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ;
    gmeow:enforcesFailureClass math:IncompleteCliffordAlgebra .

math:CliffordExtension logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:baseAlgebra ; owl:minQualifiedCardinality 1 ; owl:onClass math:CliffordAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:baseAlgebra ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CliffordAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:baseAlgebra ; owl:allValuesFrom math:CliffordAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:extendedAlgebra ; owl:minQualifiedCardinality 1 ; owl:onClass math:CliffordAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:extendedAlgebra ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CliffordAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:extendedAlgebra ; owl:allValuesFrom math:CliffordAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:extensionGenerator ; owl:minQualifiedCardinality 1 ; owl:onClass math:BasisBlade ] ,
    [ a owl:Restriction ; owl:onProperty math:extensionGenerator ; owl:maxQualifiedCardinality 1 ; owl:onClass math:BasisBlade ] ,
    [ a owl:Restriction ; owl:onProperty math:extensionGenerator ; owl:allValuesFrom math:BasisBlade ] ;
    gmeow:enforcesFailureClass math:IncompleteCliffordExtension .

math:CliffordAnticommutationWitness logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:leftGenerator ; owl:minQualifiedCardinality 1 ; owl:onClass math:BasisBlade ] ,
    [ a owl:Restriction ; owl:onProperty math:leftGenerator ; owl:maxQualifiedCardinality 1 ; owl:onClass math:BasisBlade ] ,
    [ a owl:Restriction ; owl:onProperty math:rightGenerator ; owl:minQualifiedCardinality 1 ; owl:onClass math:BasisBlade ] ,
    [ a owl:Restriction ; owl:onProperty math:rightGenerator ; owl:maxQualifiedCardinality 1 ; owl:onClass math:BasisBlade ] ,
    [ a owl:Restriction ; owl:onProperty math:anticommutationVerified ; owl:minQualifiedCardinality 1 ; owl:onDataRange xsd:boolean ] ,
    [ a owl:Restriction ; owl:onProperty math:anticommutationVerified ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:boolean ] ,
    [ a owl:Restriction ; owl:onProperty math:anticommutationVerified ; owl:hasValue true ] .

math:CliffordModuleDecomposition logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:decomposedObject ; owl:minQualifiedCardinality 1 ; owl:onClass math:CliffordAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:decomposedObject ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CliffordAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:moduleBaseSummand ; owl:minQualifiedCardinality 1 ; owl:onClass math:CliffordAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:moduleBaseSummand ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CliffordAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:moduleExtensionSummand ; owl:minQualifiedCardinality 1 ; owl:onClass math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:moduleExtensionSummand ; owl:maxQualifiedCardinality 1 ; owl:onClass math:MathematicalObject ] ,
    [ a owl:Restriction ; owl:onProperty math:splitJoinVerified ; owl:minQualifiedCardinality 1 ; owl:onDataRange xsd:boolean ] ,
    [ a owl:Restriction ; owl:onProperty math:splitJoinVerified ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:boolean ] ,
    [ a owl:Restriction ; owl:onProperty math:splitJoinVerified ; owl:hasValue true ] ;
    gmeow:enforcesFailureClass math:IncompleteCliffordExtension .

# Information-theoretic coverage family: each information measure is defined only
# relative to a complete, declared frame. Every declarative frame obligation is a
# qualified-cardinality + allValuesFrom OWL restriction (EL-safe) that derives the
# paired sh:minCount/maxCount + sh:class property shape; a missing component fails
# the derived QualifiedMinCount and isolates math:IncompleteInformationMeasure.
math:Entropy logic:subClassOf
    [ a owl:Restriction ; owl:onProperty math:overDistribution ; owl:minQualifiedCardinality 1 ; owl:onClass math:Distribution ] ,
    [ a owl:Restriction ; owl:onProperty math:overDistribution ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Distribution ] ,
    [ a owl:Restriction ; owl:onProperty math:overDistribution ; owl:allValuesFrom math:Distribution ] ,
    [ a owl:Restriction ; owl:onProperty math:informationBase ; owl:minQualifiedCardinality 1 ; owl:onClass math:LogarithmBase ] ,
    [ a owl:Restriction ; owl:onProperty math:informationBase ; owl:maxQualifiedCardinality 1 ; owl:onClass math:LogarithmBase ] ,
    [ a owl:Restriction ; owl:onProperty math:informationBase ; owl:allValuesFrom math:LogarithmBase ] ,
    [ a owl:Restriction ; owl:onProperty math:informationUnit ; owl:minQualifiedCardinality 1 ; owl:onClass math:InformationUnit ] ,
    [ a owl:Restriction ; owl:onProperty math:informationUnit ; owl:maxQualifiedCardinality 1 ; owl:onClass math:InformationUnit ] ,
    [ a owl:Restriction ; owl:onProperty math:informationUnit ; owl:allValuesFrom math:InformationUnit ] ;
    gmeow:enforcesFailureClass math:IncompleteInformationMeasure .

math:Surprisal logic:subClassOf
