+#[test]
+/// Wide maps retain exact local support through direct opposition and nominal equality.
+fn wide_labels_preserve_local_conflict_support_before_and_after_nominal_merges() {
+    for nominal in [false, true] {
+        let mut rows: Vec<(String, String, String)> = (0..1000)
+            .map(|index| {
+                (
+                    "urn:x".to_owned(),
+                    TYPE.to_owned(),
+                    format!("urn:wide:C{index}"),
+                )
+            })
+            .collect();
+        let mut add =
+            |s: &str, p: &str, o: &str| rows.push((s.to_owned(), p.to_owned(), o.to_owned()));
+        add("urn:x", TYPE, "urn:C");
+        add("urn:zzNotC", COMPLEMENT, "urn:C");
+        add("urn:z", TYPE, "urn:unrelated");
+        if nominal {
+            add("urn:alias", TYPE, "urn:zzNotC");
+            add("urn:x", TYPE, "urn:onlyAlias");
+            add(
+                "urn:onlyAlias",
+                "http://www.w3.org/2002/07/owl#oneOf",
+                "urn:list",
+            );
+            add("urn:list", FIRST, "urn:alias");
+            add("urn:list", REST, NIL);
+        } else {
+            add("urn:x", TYPE, "urn:zzNotC");
+        }
+        let borrowed: Vec<_> = rows
+            .iter()
+            .map(|(s, p, o)| (s.as_str(), p.as_str(), o.as_str()))
+            .collect();
+        let frame = Frame::new(&borrowed);
+        let mut analysis = frame.analysis();
+        let mut ledger = frame.ledger(None);
+        let outcome = frame.observe(&mut analysis, &mut ledger, true);
+        outcome.validate(&ledger).unwrap();
+        ledger.validate().unwrap();
+        assert_eq!(outcome.contextual_conflicts.len(), 1);
+        let local = outcome.local_conclusions();
+        assert!(
+            local
+                .iter()
+                .any(|conclusion| conclusion.subject == TermValue::iri("urn:x"))
+        );
+        assert!(
+            !local
+                .iter()
+                .any(|conclusion| conclusion.subject == TermValue::iri("urn:z"))
+        );
+        assert_eq!(local.len(), if nominal { 2 } else { 1 });
+        let proof = &outcome.contextual_conflicts[0].proof;
+        let leaves = ledger.source_leaves(&proof.native_support()).unwrap();
+        assert!(!leaves.is_empty());
+        assert!(leaves.iter().all(|leaf| {
+            !leaf
+                .object
+                .as_iri()
+                .is_some_and(|iri| iri.starts_with("urn:wide:"))
+        }));
+        if nominal {
+            assert_eq!(outcome.completion, NativeFamilyCompletion::Obstructed);
+            assert!(
+                !outcome.obstructions.is_empty(),
+                "local contradiction must not erase incomplete nominal-model admission"
+            );
+        } else {
+            assert_eq!(outcome.completion, NativeFamilyCompletion::Complete);
+        }
+    }
+}
