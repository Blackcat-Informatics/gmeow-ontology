    gmeow:hasBinding [
        gmeow:profile "doap" ; gmeow:toPredicate doap:programming-language ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the first-class gmeow:Language collapses to its label string" ] .
