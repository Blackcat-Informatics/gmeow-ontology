msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttempt|http://www.w3.org/2000/01/rdf-schema#label"
msgid "attempt"
msgstr "尝试"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttempt|http://www.w3.org/2004/02/skos/core#definition"
msgid "An event of pursuing an intention, including work described only in prose. Its type does not assert an executable prescription or a goal achieved."
msgstr "追求意图的事件，包括仅以文字描述的工作。此类型不表示具有可执行规定或已达成目标。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttempt|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded attempt event."
msgstr "用于分类来源记录的尝试事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttempt|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeAttempt alone."
msgstr "避免仅从 eventTypeAttempt 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttempt|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeAttempt through eventType and retain the affected attempt or intention with its explicit context links."
msgstr "通过 eventType 附加 eventTypeAttempt，并用明确上下文关联保留相关尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttempt|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeAttempt ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeAttempt ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptStart|http://www.w3.org/2000/01/rdf-schema#label"
msgid "attempt start"
msgstr "尝试开始"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptStart|http://www.w3.org/2004/02/skos/core#definition"
msgid "The recorded start of an attempt. It is a phase event within the attempt, not creation of a compiled enactment."
msgstr "尝试的已记录开始。它是尝试中的阶段事件，而非编译执行的建立。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptStart|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded attempt start event."
msgstr "用于分类来源记录的尝试开始事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptStart|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeAttemptStart alone."
msgstr "避免仅从 eventTypeAttemptStart 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptStart|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeAttemptStart through eventType and retain the affected attempt or intention with its explicit context links."
msgstr "通过 eventType 附加 eventTypeAttemptStart，并用明确上下文关联保留相关尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptStart|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeAttemptStart ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeAttemptStart ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptContinuation|http://www.w3.org/2000/01/rdf-schema#label"
msgid "attempt continuation"
msgstr "尝试继续"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptContinuation|http://www.w3.org/2004/02/skos/core#definition"
msgid "A recorded continuation or checkpoint phase of an attempt. Its pause cause and resume point are separate from how the attempt ultimately stops."
msgstr "尝试的已记录继续或检查点阶段。其暂停原因及恢复点区别于尝试最终如何停止。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptContinuation|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded attempt continuation event."
msgstr "用于分类来源记录的尝试继续事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptContinuation|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeAttemptContinuation alone."
msgstr "避免仅从 eventTypeAttemptContinuation 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptContinuation|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeAttemptContinuation through eventType and retain the affected attempt or intention with its explicit context links."
msgstr "通过 eventType 附加 eventTypeAttemptContinuation，并用明确上下文关联保留相关尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptContinuation|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeAttemptContinuation ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeAttemptContinuation ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptFinish|http://www.w3.org/2000/01/rdf-schema#label"
msgid "attempt finish"
msgstr "尝试结束"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptFinish|http://www.w3.org/2004/02/skos/core#definition"
msgid "The recorded ending of an attempt, classified by attemptStop. Ending the attempt does not by itself establish goal satisfaction."
msgstr "尝试的已记录结束，由 attemptStop 分类。尝试结束本身不证明目标满足。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptFinish|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded attempt finish event."
msgstr "用于分类来源记录的尝试结束事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptFinish|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeAttemptFinish alone."
msgstr "避免仅从 eventTypeAttemptFinish 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptFinish|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeAttemptFinish through eventType and retain the affected attempt or intention with its explicit context links."
msgstr "通过 eventType 附加 eventTypeAttemptFinish，并用明确上下文关联保留相关尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptFinish|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeAttemptFinish ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeAttemptFinish ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptResumption|http://www.w3.org/2000/01/rdf-schema#label"
msgid "attempt resumption"
msgstr "尝试恢复"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptResumption|http://www.w3.org/2004/02/skos/core#definition"
msgid "A planless attempt being resumed from a recorded resume point. It does not claim the prescription, input snapshot or journal identity required by an enactment resume."
msgstr "从已记录恢复点恢复无计划尝试。它不声称具备执行恢复要求的规定、输入快照或日志身份。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptResumption|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded attempt resumption event."
msgstr "用于分类来源记录的尝试恢复事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptResumption|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeAttemptResumption alone."
msgstr "避免仅从 eventTypeAttemptResumption 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptResumption|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeAttemptResumption through eventType and retain the affected attempt or intention with its explicit context links."
msgstr "通过 eventType 附加 eventTypeAttemptResumption，并用明确上下文关联保留相关尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeAttemptResumption|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeAttemptResumption ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeAttemptResumption ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionActive|http://www.w3.org/2000/01/rdf-schema#label"
msgid "intention active"
msgstr "意图激活"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionActive|http://www.w3.org/2004/02/skos/core#definition"
msgid "An intention was made, or made again, the intention being acted on while its holding tenure remains open."
msgstr "某意图首次或再次成为行动所依据的意图，其持有期间保持开放。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionActive|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded intention active event."
msgstr "用于分类来源记录的意图激活事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionActive|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeIntentionActive alone."
msgstr "避免仅从 eventTypeIntentionActive 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionActive|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeIntentionActive through eventType and retain the affected attempt or intention with its explicit context links."
msgstr "通过 eventType 附加 eventTypeIntentionActive，并用明确上下文关联保留相关尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionActive|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeIntentionActive ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeIntentionActive ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionPaused|http://www.w3.org/2000/01/rdf-schema#label"
msgid "intention paused"
msgstr "意图暂停"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionPaused|http://www.w3.org/2004/02/skos/core#definition"
msgid "Pursuit of an intention was paused without abandonment. The pause itself does not close the holding tenure or imply an enactment state."
msgstr "意图追求被暂停而未放弃。暂停本身不关闭持有期间，也不表示某执行状态。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionPaused|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded intention paused event."
msgstr "用于分类来源记录的意图暂停事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionPaused|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeIntentionPaused alone."
msgstr "避免仅从 eventTypeIntentionPaused 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionPaused|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeIntentionPaused through eventType and retain the affected attempt or intention with its explicit context links."
msgstr "通过 eventType 附加 eventTypeIntentionPaused，并用明确上下文关联保留相关尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionPaused|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeIntentionPaused ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeIntentionPaused ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSatisfied|http://www.w3.org/2000/01/rdf-schema#label"
msgid "intention satisfied"
msgstr "意图满足"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSatisfied|http://www.w3.org/2004/02/skos/core#definition"
msgid "An intention ended because its goal was judged met. The judgment belongs to a separate GoalEvaluation rather than the event kind."
msgstr "意图因目标被判断达成而结束。该判断属于独立 GoalEvaluation，而非事件种类本身。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSatisfied|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded intention satisfied event."
msgstr "用于分类来源记录的意图满足事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSatisfied|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeIntentionSatisfied alone."
msgstr "避免仅从 eventTypeIntentionSatisfied 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSatisfied|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeIntentionSatisfied through eventType and retain the affected attempt or intention with its explicit context links."
msgstr "通过 eventType 附加 eventTypeIntentionSatisfied，并用明确上下文关联保留相关尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSatisfied|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeIntentionSatisfied ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeIntentionSatisfied ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionAbandoned|http://www.w3.org/2000/01/rdf-schema#label"
msgid "intention abandoned"
msgstr "意图放弃"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionAbandoned|http://www.w3.org/2004/02/skos/core#definition"
msgid "An intention was given up without its goal being judged met. This records withdrawal rather than erasing the intention."
msgstr "意图在目标未被判断达成时被放弃。这记录撤回而非删除意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionAbandoned|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded intention abandoned event."
msgstr "用于分类来源记录的意图放弃事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionAbandoned|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeIntentionAbandoned alone."
msgstr "避免仅从 eventTypeIntentionAbandoned 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionAbandoned|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeIntentionAbandoned through eventType and retain the affected attempt or intention with its explicit context links."
msgstr "通过 eventType 附加 eventTypeIntentionAbandoned，并用明确上下文关联保留相关尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionAbandoned|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeIntentionAbandoned ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeIntentionAbandoned ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSuperseded|http://www.w3.org/2000/01/rdf-schema#label"
msgid "intention superseded"
msgstr "意图被取代"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSuperseded|http://www.w3.org/2004/02/skos/core#definition"
msgid "An intention was replaced by another intention, identified separately by supersededBy. Replacement is not evidence of either goal’s satisfaction."
msgstr "某意图被另一个意图取代，替代者由 supersededBy 独立标识。替代不证明任一目标满足。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSuperseded|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded intention superseded event."
msgstr "用于分类来源记录的意图被取代事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSuperseded|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeIntentionSuperseded alone."
msgstr "避免仅从 eventTypeIntentionSuperseded 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSuperseded|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeIntentionSuperseded through eventType and retain the affected attempt or intention with its explicit context links."
msgstr "通过 eventType 附加 eventTypeIntentionSuperseded，并用明确上下文关联保留相关尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeIntentionSuperseded|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeIntentionSuperseded ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeIntentionSuperseded ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeDecision|http://www.w3.org/2000/01/rdf-schema#label"
msgid "decision"
msgstr "决定"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeDecision|http://www.w3.org/2004/02/skos/core#definition"
msgid "An agent settled on one course among the options it weighed, concluding deliberation. The choice may form an intention or decide to do nothing without a new commitment."
msgstr "行动者在权衡的选项中确定一种做法，结束审议。选择可以形成意图，也可以决定不采取行动而不产生新承诺。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeDecision|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to classify a source-recorded decision event."
msgstr "用于分类来源记录的决定事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeDecision|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring an enactment or goal verdict from eventTypeDecision alone."
msgstr "避免仅从 eventTypeDecision 推断执行或目标判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeDecision|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach eventTypeDecision through eventType; link an attempt or intention only when the source actually supplies that context."
msgstr "通过 eventType 附加 eventTypeDecision；仅当来源实际提供该上下文时关联尝试或意图。"

msgctxt "https://blackcatinformatics.ca/gmeow/eventTypeDecision|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:event gmeow:eventType gmeow:eventTypeDecision ."
msgstr "ex:event gmeow:eventType gmeow:eventTypeDecision ."

msgctxt "https://blackcatinformatics.ca/gmeow/learningInsight|http://www.w3.org/2000/01/rdf-schema#label"
msgid "insight"
msgstr "领悟"

msgctxt "https://blackcatinformatics.ca/gmeow/learningInsight|http://www.w3.org/2004/02/skos/core#definition"
msgid "A learning event in which an agent comes to understand a connection or pattern through its own reasoning or reflection, without a teacher or source being reported for that insight. It need not form a new category."
msgstr "行动者通过自身推理或反思理解联系或模式的学习事件，未报告该领悟的教师或来源。它不一定形成新类别。"

msgctxt "https://blackcatinformatics.ca/gmeow/learningInsight|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for a source-reported connection grasped through reflection."
msgstr "用于来源报告的经反思理解的联系。"

msgctxt "https://blackcatinformatics.ca/gmeow/learningInsight|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring universal absence of influences or equating insight with concept formation."
msgstr "避免推断普遍不存在影响，或将领悟等同于概念形成。"

msgctxt "https://blackcatinformatics.ca/gmeow/learningInsight|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference through learningType; retain other supported learning varieties and existing learner/process context."
msgstr "通过 learningType 引用；保留其他有依据的学习种类及现有学习者与过程上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/learningInsight|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:insight gmeow:learningType gmeow:learningInsight ."
msgstr "ex:insight gmeow:learningType gmeow:learningInsight ."

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptStop|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Attempt Stop"
msgstr "尝试停止方式"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptStop|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary describing how an attempt stopped, independently of progress toward its goal."
msgstr "描述尝试如何停止的开放词汇，独立于目标进展。"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptStop|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the explicit attempt stop axis of an agency record."
msgstr "用于行动记录中明确的尝试停止方式维度。"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptStop|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid subclassing AttemptStop to add a value or deriving it from missing data."
msgstr "避免通过继承 AttemptStop 添加值，或从数据缺失推断值。"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptStop|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Use reviewed AttemptStop individuals and extend the vocabulary with additional source-supported individuals."
msgstr "使用经过审核的 AttemptStop 个体，并用额外有来源支持的个体扩展词汇。"

msgctxt "https://blackcatinformatics.ca/gmeow/AttemptStop|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:value a gmeow:AttemptStop ."
msgstr "ex:value a gmeow:AttemptStop ."

msgctxt "https://blackcatinformatics.ca/gmeow/PauseCause|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Pause Cause"
msgstr "暂停原因"

msgctxt "https://blackcatinformatics.ca/gmeow/PauseCause|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary describing why a continuation phase paused, without imposing enactment checkpoint machinery."
msgstr "描述继续阶段为何暂停的开放词汇，不施加执行检查点机制。"

msgctxt "https://blackcatinformatics.ca/gmeow/PauseCause|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the explicit pause cause axis of an agency record."
msgstr "用于行动记录中明确的暂停原因维度。"

msgctxt "https://blackcatinformatics.ca/gmeow/PauseCause|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid subclassing PauseCause to add a value or deriving it from missing data."
msgstr "避免通过继承 PauseCause 添加值，或从数据缺失推断值。"

msgctxt "https://blackcatinformatics.ca/gmeow/PauseCause|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Use reviewed PauseCause individuals and extend the vocabulary with additional source-supported individuals."
msgstr "使用经过审核的 PauseCause 个体，并用额外有来源支持的个体扩展词汇。"

msgctxt "https://blackcatinformatics.ca/gmeow/PauseCause|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:value a gmeow:PauseCause ."
msgstr "ex:value a gmeow:PauseCause ."

msgctxt "https://blackcatinformatics.ca/gmeow/CommitmentStatus|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Self-Commitment Status"
msgstr "自我承诺状态"

msgctxt "https://blackcatinformatics.ca/gmeow/CommitmentStatus|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open status vocabulary for an intention held as an internal commitment. It is distinct from a social Commitment toward another agent."
msgstr "意图作为内部承诺而持有时的开放状态词汇。它区别于针对其他行动者的社会 Commitment。"

msgctxt "https://blackcatinformatics.ca/gmeow/CommitmentStatus|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the explicit self-commitment status axis of an agency record."
msgstr "用于行动记录中明确的自我承诺状态维度。"

msgctxt "https://blackcatinformatics.ca/gmeow/CommitmentStatus|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid subclassing CommitmentStatus to add a value or deriving it from missing data."
msgstr "避免通过继承 CommitmentStatus 添加值，或从数据缺失推断值。"

msgctxt "https://blackcatinformatics.ca/gmeow/CommitmentStatus|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Use reviewed CommitmentStatus individuals and extend the vocabulary with additional source-supported individuals."
msgstr "使用经过审核的 CommitmentStatus 个体，并用额外有来源支持的个体扩展词汇。"

msgctxt "https://blackcatinformatics.ca/gmeow/CommitmentStatus|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:value a gmeow:CommitmentStatus ."
msgstr "ex:value a gmeow:CommitmentStatus ."

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperation|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Artifact Operation"
msgstr "制品操作"

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperation|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary for the operation an activity performed on an identified artifact, separate from invocation outcome and artifact completion."
msgstr "活动对已标识制品执行操作的开放词汇，区别于调用结果及制品完成状态。"

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperation|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the explicit artifact operation axis of an agency record."
msgstr "用于行动记录中明确的制品操作维度。"

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperation|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid subclassing ArtifactOperation to add a value or deriving it from missing data."
msgstr "避免通过继承 ArtifactOperation 添加值，或从数据缺失推断值。"

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperation|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Use reviewed ArtifactOperation individuals and extend the vocabulary with additional source-supported individuals."
msgstr "使用经过审核的 ArtifactOperation 个体，并用额外有来源支持的个体扩展词汇。"

msgctxt "https://blackcatinformatics.ca/gmeow/ArtifactOperation|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:value a gmeow:ArtifactOperation ."
msgstr "ex:value a gmeow:ArtifactOperation ."

msgctxt "https://blackcatinformatics.ca/gmeow/ModelInvocationOutcome|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Model Invocation Outcome"
msgstr "模型调用结果"

msgctxt "https://blackcatinformatics.ca/gmeow/ModelInvocationOutcome|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open vocabulary for a source-reported model invocation outcome. A missing outcome is unknown rather than successful."
msgstr "表示来源报告模型调用结果的开放词汇。结果缺失表示未知，而非成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/ModelInvocationOutcome|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the explicit model invocation outcome axis of an agency record."
msgstr "用于行动记录中明确的模型调用结果维度。"

msgctxt "https://blackcatinformatics.ca/gmeow/ModelInvocationOutcome|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid subclassing ModelInvocationOutcome to add a value or deriving it from missing data."
msgstr "避免通过继承 ModelInvocationOutcome 添加值，或从数据缺失推断值。"

msgctxt "https://blackcatinformatics.ca/gmeow/ModelInvocationOutcome|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Use reviewed ModelInvocationOutcome individuals and extend the vocabulary with additional source-supported individuals."
msgstr "使用经过审核的 ModelInvocationOutcome 个体，并用额外有来源支持的个体扩展词汇。"

msgctxt "https://blackcatinformatics.ca/gmeow/ModelInvocationOutcome|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:value a gmeow:ModelInvocationOutcome ."
msgstr "ex:value a gmeow:ModelInvocationOutcome ."

msgctxt "https://blackcatinformatics.ca/gmeow/stopFinished|http://www.w3.org/2000/01/rdf-schema#label"
msgid "finished"
msgstr "已完成尝试"

msgctxt "https://blackcatinformatics.ca/gmeow/stopFinished|http://www.w3.org/2004/02/skos/core#definition"
msgid "The attempt finished as an activity; this does not assert that its goal was achieved."
msgstr "尝试作为活动结束；这不表示目标已达成。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopFinished|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports finished."
msgstr "来源明确报告已完成尝试时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopFinished|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving stopFinished solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 stopFinished。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopFinished|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach stopFinished through attemptStop, preserving the source attribution and time context."
msgstr "通过 attemptStop 附加 stopFinished，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopFinished|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:attemptStop gmeow:stopFinished ."
msgstr "ex:record gmeow:attemptStop gmeow:stopFinished ."

msgctxt "https://blackcatinformatics.ca/gmeow/stopFailed|http://www.w3.org/2000/01/rdf-schema#label"
msgid "failed"
msgstr "尝试失败"

msgctxt "https://blackcatinformatics.ca/gmeow/stopFailed|http://www.w3.org/2004/02/skos/core#definition"
msgid "The attempt stopped in a source-reported failure, distinct from a goal-evaluation verdict."
msgstr "尝试因来源报告的失败而停止，区别于目标评估判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopFailed|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports failed."
msgstr "来源明确报告尝试失败时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopFailed|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving stopFailed solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 stopFailed。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopFailed|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach stopFailed through attemptStop, preserving the source attribution and time context."
msgstr "通过 attemptStop 附加 stopFailed，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopFailed|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:attemptStop gmeow:stopFailed ."
msgstr "ex:record gmeow:attemptStop gmeow:stopFailed ."

msgctxt "https://blackcatinformatics.ca/gmeow/stopInterrupted|http://www.w3.org/2000/01/rdf-schema#label"
msgid "interrupted"
msgstr "尝试中断"

msgctxt "https://blackcatinformatics.ca/gmeow/stopInterrupted|http://www.w3.org/2004/02/skos/core#definition"
msgid "The attempt stopped because it was interrupted. A later attempt or resumption remains a separate record."
msgstr "尝试因中断而停止。后续尝试或恢复仍是独立记录。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopInterrupted|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports interrupted."
msgstr "来源明确报告尝试中断时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopInterrupted|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving stopInterrupted solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 stopInterrupted。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopInterrupted|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach stopInterrupted through attemptStop, preserving the source attribution and time context."
msgstr "通过 attemptStop 附加 stopInterrupted，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopInterrupted|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:attemptStop gmeow:stopInterrupted ."
msgstr "ex:record gmeow:attemptStop gmeow:stopInterrupted ."

msgctxt "https://blackcatinformatics.ca/gmeow/stopYieldedToForeground|http://www.w3.org/2000/01/rdf-schema#label"
msgid "yielded to foreground"
msgstr "让位于前台工作"

msgctxt "https://blackcatinformatics.ca/gmeow/stopYieldedToForeground|http://www.w3.org/2004/02/skos/core#definition"
msgid "The attempt stopped because foreground work, such as a conversation, took priority."
msgstr "尝试因前台工作（如会话）获得优先而停止。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopYieldedToForeground|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports yielded to foreground."
msgstr "来源明确报告让位于前台工作时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopYieldedToForeground|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving stopYieldedToForeground solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 stopYieldedToForeground。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopYieldedToForeground|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach stopYieldedToForeground through attemptStop, preserving the source attribution and time context."
msgstr "通过 attemptStop 附加 stopYieldedToForeground，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/stopYieldedToForeground|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:attemptStop gmeow:stopYieldedToForeground ."
msgstr "ex:record gmeow:attemptStop gmeow:stopYieldedToForeground ."

msgctxt "https://blackcatinformatics.ca/gmeow/pauseBudgetCheckpoint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "budget checkpoint"
msgstr "预算检查点"

msgctxt "https://blackcatinformatics.ca/gmeow/pauseBudgetCheckpoint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A compute or time budget was reached and a prose-attempt resume point was recorded."
msgstr "达到计算或时间预算，并记录了文字尝试恢复点。"

msgctxt "https://blackcatinformatics.ca/gmeow/pauseBudgetCheckpoint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports budget checkpoint."
msgstr "来源明确报告预算检查点时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/pauseBudgetCheckpoint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving pauseBudgetCheckpoint solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 pauseBudgetCheckpoint。"

msgctxt "https://blackcatinformatics.ca/gmeow/pauseBudgetCheckpoint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach pauseBudgetCheckpoint through pauseCause, preserving the source attribution and time context."
msgstr "通过 pauseCause 附加 pauseBudgetCheckpoint，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/pauseBudgetCheckpoint|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:pauseCause gmeow:pauseBudgetCheckpoint ."
msgstr "ex:record gmeow:pauseCause gmeow:pauseBudgetCheckpoint ."

msgctxt "https://blackcatinformatics.ca/gmeow/pauseInterrupted|http://www.w3.org/2000/01/rdf-schema#label"
msgid "pause through interruption"
msgstr "因中断暂停"

msgctxt "https://blackcatinformatics.ca/gmeow/pauseInterrupted|http://www.w3.org/2004/02/skos/core#definition"
msgid "The continuation phase paused because it was interrupted."
msgstr "继续阶段因受到中断而暂停。"

msgctxt "https://blackcatinformatics.ca/gmeow/pauseInterrupted|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports pause through interruption."
msgstr "来源明确报告因中断暂停时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/pauseInterrupted|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving pauseInterrupted solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 pauseInterrupted。"

msgctxt "https://blackcatinformatics.ca/gmeow/pauseInterrupted|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach pauseInterrupted through pauseCause, preserving the source attribution and time context."
msgstr "通过 pauseCause 附加 pauseInterrupted，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/pauseInterrupted|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:pauseCause gmeow:pauseInterrupted ."
msgstr "ex:record gmeow:pauseCause gmeow:pauseInterrupted ."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentActive|http://www.w3.org/2000/01/rdf-schema#label"
msgid "active self-commitment"
msgstr "有效自我承诺"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentActive|http://www.w3.org/2004/02/skos/core#definition"
msgid "The internal commitment stands as first made, without asserting a social beneficiary."
msgstr "内部承诺按最初形成时持续有效，不声明社会受益人。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentActive|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports active self-commitment."
msgstr "来源明确报告有效自我承诺时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentActive|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving commitmentActive solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 commitmentActive。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentActive|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach commitmentActive through commitmentStatus, preserving the source attribution and time context."
msgstr "通过 commitmentStatus 附加 commitmentActive，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentActive|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:commitmentStatus gmeow:commitmentActive ."
msgstr "ex:record gmeow:commitmentStatus gmeow:commitmentActive ."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentRenewed|http://www.w3.org/2000/01/rdf-schema#label"
msgid "renewed self-commitment"
msgstr "更新自我承诺"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentRenewed|http://www.w3.org/2004/02/skos/core#definition"
msgid "The agent renewed its internal commitment to pursue the intention."
msgstr "行动者更新了追求该意图的内部承诺。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentRenewed|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports renewed self-commitment."
msgstr "来源明确报告更新自我承诺时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentRenewed|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving commitmentRenewed solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 commitmentRenewed。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentRenewed|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach commitmentRenewed through commitmentStatus, preserving the source attribution and time context."
msgstr "通过 commitmentStatus 附加 commitmentRenewed，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentRenewed|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:commitmentStatus gmeow:commitmentRenewed ."
msgstr "ex:record gmeow:commitmentStatus gmeow:commitmentRenewed ."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentReleased|http://www.w3.org/2000/01/rdf-schema#label"
msgid "released self-commitment"
msgstr "解除自我承诺"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentReleased|http://www.w3.org/2004/02/skos/core#definition"
msgid "The internal commitment was released, without proving that its goal was met."
msgstr "内部承诺被解除，但不证明目标已满足。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentReleased|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports released self-commitment."
msgstr "来源明确报告解除自我承诺时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentReleased|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving commitmentReleased solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 commitmentReleased。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentReleased|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach commitmentReleased through commitmentStatus, preserving the source attribution and time context."
msgstr "通过 commitmentStatus 附加 commitmentReleased，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentReleased|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:commitmentStatus gmeow:commitmentReleased ."
msgstr "ex:record gmeow:commitmentStatus gmeow:commitmentReleased ."

msgctxt "https://blackcatinformatics.ca/gmeow/operationCreated|http://www.w3.org/2000/01/rdf-schema#label"
msgid "created"
msgstr "创建操作"

msgctxt "https://blackcatinformatics.ca/gmeow/operationCreated|http://www.w3.org/2004/02/skos/core#definition"
msgid "The activity created the identified artifact or version."
msgstr "活动创建了已标识制品或版本。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationCreated|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports created."
msgstr "来源明确报告创建操作时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationCreated|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving operationCreated solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 operationCreated。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationCreated|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach operationCreated through receiptOperation, preserving the source attribution and time context."
msgstr "通过 receiptOperation 附加 operationCreated，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationCreated|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:receiptOperation gmeow:operationCreated ."
msgstr "ex:record gmeow:receiptOperation gmeow:operationCreated ."

msgctxt "https://blackcatinformatics.ca/gmeow/operationRead|http://www.w3.org/2000/01/rdf-schema#label"
msgid "read"
msgstr "读取操作"

msgctxt "https://blackcatinformatics.ca/gmeow/operationRead|http://www.w3.org/2004/02/skos/core#definition"
msgid "The activity read the identified artifact or version without this classification claiming a change."
msgstr "活动读取了已标识制品或版本，此分类不表示修改。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationRead|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports read."
msgstr "来源明确报告读取操作时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationRead|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving operationRead solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 operationRead。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationRead|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach operationRead through receiptOperation, preserving the source attribution and time context."
msgstr "通过 receiptOperation 附加 operationRead，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationRead|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:receiptOperation gmeow:operationRead ."
msgstr "ex:record gmeow:receiptOperation gmeow:operationRead ."

msgctxt "https://blackcatinformatics.ca/gmeow/operationUpdated|http://www.w3.org/2000/01/rdf-schema#label"
msgid "updated"
msgstr "更新操作"

msgctxt "https://blackcatinformatics.ca/gmeow/operationUpdated|http://www.w3.org/2004/02/skos/core#definition"
msgid "The activity updated the identified artifact, retaining source version identity when supplied."
msgstr "活动更新了已标识制品，并在来源提供时保留版本身份。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationUpdated|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports updated."
msgstr "来源明确报告更新操作时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationUpdated|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving operationUpdated solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 operationUpdated。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationUpdated|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach operationUpdated through receiptOperation, preserving the source attribution and time context."
msgstr "通过 receiptOperation 附加 operationUpdated，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/operationUpdated|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:receiptOperation gmeow:operationUpdated ."
msgstr "ex:record gmeow:receiptOperation gmeow:operationUpdated ."

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeSucceeded|http://www.w3.org/2000/01/rdf-schema#label"
msgid "invocation succeeded"
msgstr "调用成功"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeSucceeded|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reported that this model invocation succeeded. This is not an artifact-completion or truth verdict."
msgstr "来源报告此次模型调用成功。这不是制品完成或真伪判定。"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeSucceeded|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports invocation succeeded."
msgstr "来源明确报告调用成功时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeSucceeded|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving invocationOutcomeSucceeded solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 invocationOutcomeSucceeded。"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeSucceeded|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Attach invocationOutcomeSucceeded through invocationOutcome, preserving the source attribution and time context."
msgstr "通过 invocationOutcome 附加 invocationOutcomeSucceeded，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeSucceeded|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:invocationOutcome gmeow:invocationOutcomeSucceeded ."
msgstr "ex:record gmeow:invocationOutcome gmeow:invocationOutcomeSucceeded ."

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeFailed|http://www.w3.org/2000/01/rdf-schema#label"
msgid "invocation failed"
msgstr "调用失败"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeFailed|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reported that this model invocation failed; any supplied error is retained separately."
msgstr "来源报告此次模型调用失败；提供的错误另行保留。"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeFailed|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly reports invocation failed."
msgstr "来源明确报告调用失败时使用。"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeFailed|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid deriving invocationOutcomeFailed solely from silence, missing timestamps or another status axis."
msgstr "避免仅从沉默、缺失时间戳或其他状态维度推断 invocationOutcomeFailed。"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeFailed|https://blackcatinformatics.ca/gmeow/howToUse"
