msgid "The recorded historical identity of the tagger, when present, using AuthorIdentity independently of a currently canonical agent."
msgstr "存在时记录的标签创建者历史身份，使用 AuthorIdentity，独立于当前规范化智能体。"


msgctxt "https://blackcatinformatics.ca/gmeow/taggerIdentity|http://www.w3.org/2004/02/skos/core#example"
msgid "The source record names gmeow:taggerIdentity explicitly."
msgstr "来源记录显式命名 gmeow:taggerIdentity。"


msgctxt "https://blackcatinformatics.ca/gmeow/taggerTime|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring object completeness, ownership or successful Git execution from taggerTime alone."
msgstr "避免仅从 taggerTime 推断对象完备性、所有权或 Git 执行成功。"


msgctxt "https://blackcatinformatics.ca/gmeow/taggerTime|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit taggerTime value with its source and observation scope."
msgstr "连同来源及观察范围保留显式 taggerTime 值。"


msgctxt "https://blackcatinformatics.ca/gmeow/taggerTime|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain tagger time in an attributed repository description."
msgstr "用于在带有归属的仓库描述中保留标签创建时间。"


