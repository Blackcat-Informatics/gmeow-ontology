#
# Single violation: a bare math:normalForm edge with NO math:NormalizationDeclaration
# naming its (source, target) pair at all (math:UndeclaredNormalForm). ex:undeclaredSource
# carries a math:literalValue structured child so the math:normalForm trigger does not
# ALSO fire math:StringOnlyComputableExpression — this fixture isolates the ONE undeclared-
# normal-form class.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:undeclaredSource a math:NumberLiteral ;
    math:normalForm ex:undeclaredTarget ;
    math:literalValue "1"^^xsd:integer .

# The normal-form TARGET is incidental here, not the defect. It is a math:SymbolReference so
# the ONLY class this fixture raises is math:UndeclaredNormalForm — the abstract
# math:MathematicalExpression base names no concrete form and would raise
# math:UnrecognizedExpressionType beside it.
ex:undeclaredTarget a math:SymbolReference ;
    math:hasMathematicalSymbol ex:undeclaredTargetSymbol .
ex:undeclaredTargetSymbol a math:MathematicalSymbol .
