#
# Declarative structural assertions for the preference extension slice — the
# slice-resident MUST / MUST-NOT invariants of the ratified design set. Each
# assertion runs as a SPARQL ASK over the preference module graph
# (gmeow:scopeModule) under the native Rust slicetest harness (crates/slicetest).
#
# The slice's one governing principle is protected here structurally: a preference
# is NEVER a context-free global winner, so the slice mints NO preferred/primary
# "winner-slot" term (Principle 9). And it is a BY-REFERENCE consumer extension: it
# re-mints NONE of the seven named sibling slices' terms (AC7, no-duplication —
# Principle 16); the reuse rides mappings/equivalences.ttl at the instance level,
# never a re-declared owl:Class / owl:*Property in THIS module.
#
# The manifest-level dependency discipline (preference depends ONLY on core +
# logic/math grounding; norms / model-serving / ai / learning / provenance /
# evidence / semantic-topology are reused by-reference only) is a MANIFEST
# invariant, NOT expressible as an ASK over the single module graph, and is
# therefore enforced by the slice-manifest / DAG gate rather than a
# gmeow:StructuralAssertion here.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/preference/tests/> .

# --- (a) The slice mints NO preferred/primary "winner-slot" term (MUST-NOT) ----
ex:saNoWinnerSlotTerm a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned {
        gmeow:preferredRank gmeow:primaryName gmeow:canonicalName
        gmeow:preferredCandidate gmeow:globalWinner gmeow:contextFreeWinner
        gmeow:primaryClaim gmeow:preferredForDisplay
    }
    { ?banned a owl:ObjectProperty }
    UNION { ?banned a owl:DatatypeProperty }
    UNION { ?banned a owl:AnnotationProperty }
    UNION { ?banned a owl:Class }
}""" ;
    gmeow:saRationale "None of the preferred/primary/canonical winner-slot terms (preferredRank, primaryName, canonicalName, preferredCandidate, globalWinner, contextFreeWinner, primaryClaim, preferredForDisplay) MUST NOT exist as any OWL property or class — the slice provides NO single slot for a candidate to 'win' outright; a global winner is legal only via a gmeow:PreferenceClaim that extends per-vantage orders to a whole-base gmeow:ConsensusSection and discharges the gmeow:DisagreementObstruction (Principle 9, no context-free winner)." .

# --- (b) AC7 no-duplication: the seven named sibling slices' terms are NOT ------
# -------- re-minted (rdfs:isDefinedBy) in THIS slice (MUST-NOT), one per slice --

# --- (b.1) norms terms are not re-minted here (MUST-NOT) ----------------------
ex:saNoRemintNormsTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?banned {
        gmeow:Rubric gmeow:Assessment gmeow:Criterion
        gmeow:EvaluationVerdict gmeow:Condition gmeow:ComplianceAssessment
    }
    ?banned rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> .
}""" ;
    gmeow:saRationale "The norms-extension terms (Rubric, Assessment, Criterion, EvaluationVerdict, Condition, ComplianceAssessment) MUST NOT be rdfs:isDefinedBy the preference slice — they are reused ONLY by-reference at the instance level (mappings/equivalences.ttl), never re-declared/re-minted in this module (AC7 no-duplication, Principle 16)." .

# --- (b.2) model-serving terms are not re-minted here (MUST-NOT) --------------
ex:saNoRemintModelServingTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?banned {
        gmeow:ModelArtifact gmeow:ModelDeployment gmeow:RuntimeExecution
    }
    ?banned rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> .
}""" ;
    gmeow:saRationale "The model-serving-extension terms (ModelArtifact, ModelDeployment, RuntimeExecution) MUST NOT be rdfs:isDefinedBy the preference slice — reused only by-reference at the instance level, never re-minted here (AC7 no-duplication, Principle 16)." .

# --- (b.3) ai terms are not re-minted here (MUST-NOT) -------------------------
ex:saNoRemintAiTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?banned {
        gmeow:ModelInvocation gmeow:Prompt gmeow:PromptTemplate gmeow:ModelCard
    }
    ?banned rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> .
}""" ;
    gmeow:saRationale "The ai-extension terms (ModelInvocation, Prompt, PromptTemplate, ModelCard) MUST NOT be rdfs:isDefinedBy the preference slice — reused only by-reference at the instance level, never re-minted here (AC7 no-duplication, Principle 16)." .

# --- (b.4) learning terms are not re-minted here (MUST-NOT) -------------------
ex:saNoRemintLearningTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?banned {
        gmeow:LearningEvent gmeow:Teaching
    }
    ?banned rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> .
}""" ;
    gmeow:saRationale "The learning-extension terms (LearningEvent, Teaching) MUST NOT be rdfs:isDefinedBy the preference slice — gmeow:PreferenceLearningEvent specializes gmeow:LearningEvent by reference, but the parent term itself is never re-declared/re-minted here (AC7 no-duplication, Principle 16)." .

# --- (b.5) provenance terms are not re-minted here (MUST-NOT) -----------------
ex:saNoRemintProvenanceTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?banned {
        gmeow:wasGeneratedBy gmeow:wasDerivedFrom gmeow:wasAttributedTo
    }
    ?banned rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> .
}""" ;
    gmeow:saRationale "The provenance-extension terms (wasGeneratedBy, wasDerivedFrom, wasAttributedTo) MUST NOT be rdfs:isDefinedBy the preference slice — the slice REUSES the provenance spine (e.g. gmeow:cellObservation ⊑ gmeow:wasDerivedFrom) at the instance level, never re-minting the spine here (AC7 no-duplication, Principle 16)." .

# --- (b.6) evidence terms are not re-minted here (MUST-NOT) -------------------
ex:saNoRemintEvidenceTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?banned {
        gmeow:EvidenceSpan gmeow:EvidenceClass
    }
    ?banned rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> .
}""" ;
    gmeow:saRationale "The evidence-extension terms (EvidenceSpan, EvidenceClass) MUST NOT be rdfs:isDefinedBy the preference slice — reused only by-reference at the instance level (e.g. gmeow:deltaEvaluationEvidence → gmeow:EvidenceSpan), never re-minted here (AC7 no-duplication, Principle 16)." .

# --- (b.7) semantic-topology terms are not re-minted here (MUST-NOT) ----------
ex:saNoRemintSemanticTopologyTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?banned {
        gmeow:TopologyClaim gmeow:ComplexCompilation gmeow:TopologyResult
    }
    ?banned rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> .
}""" ;
    gmeow:saRationale "The semantic-topology-extension terms (TopologyClaim, ComplexCompilation, TopologyResult) MUST NOT be rdfs:isDefinedBy the preference slice — the preference sheaf apparatus is its own twin (gmeow:ComparisonCompilation / gmeow:ConsensusSection / gmeow:DisagreementObstruction) and reuses the sibling only by-reference, never re-minting it here (AC7 no-duplication, Principle 16)." .

# --- (c) Key preference terms carry their expected CORE superclasses (MUST) ----
ex:saKeyTermsCarryCoreSuperclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:PreferenceObservation logic:subClassOf gmeow:Observation .
    gmeow:PreferenceClaim       logic:subClassOf gmeow:StandpointClaim .
}""" ;
    gmeow:saRationale "gmeow:PreferenceObservation MUST be logic:subClassOf gmeow:Observation (one vantage's attributed observation, inheriting the mandatory gmeow:vantage) and gmeow:PreferenceClaim MUST be logic:subClassOf gmeow:StandpointClaim (the truth-apt, vantage-attributed wrapper) — the slice grafts onto the CORE observation/standpoint spine, not a private hierarchy (Principle 16)." .
