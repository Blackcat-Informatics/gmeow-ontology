@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/markdown> a align:Alignment ;
    rdfs:label "GMEOW → markdown (EDOAL)"@x-gmeow-english ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "mentions → gmeow:hasWikilink (markdown round-trip)"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:mentions ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri gmeow:hasWikilink ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "markdown" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@x-gmeow-english .
