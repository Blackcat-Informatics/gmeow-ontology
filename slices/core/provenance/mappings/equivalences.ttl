@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences for the provenance domain — GMEOW authoring source.
# Compiled to mappings/gmeow-provenance.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetProvenance a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/provenance" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Provenance + import-provenance alignments. The core PROV-O anchors (Activity, wasDerivedFrom, wasGeneratedBy, wasAttributedTo) and the carrier/ingestion terms align to PROV-O and Dublin Core Terms. recordedNoLaterThan and contentDigest are canonical — no faithful external term models a derived terminus-ante-quem or a content-addressed carrier digest." .

gmeow:Activity skos:exactMatch prov:Activity {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "the general provenance-activity class, co-extensive with prov:Activity; the narrower activity kinds (Event, ObservationalActivity, ImportActivity, ...) map in by closeMatch/relatedMatch"
|} .

gmeow:wasDerivedFrom skos:exactMatch prov:wasDerivedFrom {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "the same derivation relation — an exact 1:1 term correspondence that round-trips; skos:exactMatch (not owl:equivalentProperty) keeps gmeow's deliberately domain-free property from importing prov's domain/range"
|} .

gmeow:wasGeneratedBy skos:exactMatch prov:wasGeneratedBy {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:wasAttributedTo skos:exactMatch prov:wasAttributedTo {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:wasAssociatedWith skos:closeMatch prov:wasAssociatedWith {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:CreativeWork skos:closeMatch prov:Entity {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Source-hood is anti-rigid; the described thing is a CreativeWork (WEMI)."
|} .

gmeow:ImportActivity skos:closeMatch prov:Activity {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

gmeow:ingestedAt skos:closeMatch prov:endedAtTime {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:assertedAt skos:closeMatch prov:generatedAtTime {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:sourceModifiedAt skos:closeMatch dcterms:modified {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:sourceLocation skos:closeMatch dcterms:source {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6
|} .

# --------------------------------------------------------------------------- #
# observation-linkage design — generatedObservation provenance link.
# --------------------------------------------------------------------------- #

gmeow:generatedObservation skos:closeMatch prov:generated {|
    gmeow:sssomFile "gmeow-provenance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "prov:generated links an activity to the entity it generated; gmeow:generatedObservation specialises the range to Observation. The ObservationalActivity→prov:Activity alignment is canonical in mapping-dsl/equivalences/events.ttl (eqEvents132)."
|} .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:Activity skos:exactMatch prov:Activity {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "the general provenance-activity class, co-extensive with prov:Activity; the narrower activity kinds (Event, ObservationalActivity, ImportActivity, ...) map in by closeMatch/relatedMatch"
|} .

gmeow:provenance skos:closeMatch dcterms:provenance {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "DCTerms provenance — a statement of changes in ownership and custody"
|} .

gmeow:wasAttributedTo skos:exactMatch prov:wasAttributedTo {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "the same attribution relation — an exact 1:1 term correspondence that round-trips; skos:exactMatch (not owl:equivalentProperty) keeps gmeow's deliberately domain-free property from importing prov's domain/range"
|} .

gmeow:wasGeneratedBy skos:exactMatch prov:wasGeneratedBy {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "the same generation relation — an exact 1:1 term correspondence that round-trips; skos:exactMatch (not owl:equivalentProperty) keeps gmeow's deliberately domain-free property from importing prov's domain/range"
|} .

gmeow:Activity skos:closeMatch wd:Q1914636 {|
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:objectLabel "activity"
|} .
