        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/positionLabel> ?v0 . } UNION { $this <https://blackcatinformatics.ca/gmeow/positionOrdinal> ?v1 . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/NarrativeStoryAnchorConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/NarrativeTimeFrame> ;
