gmeow:QueryFusionClassWeight logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:weightForClass ; logic:allValuesFrom logic:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryFusionClassWeight ; logic:closureKey "https://blackcatinformatics.ca/gmeow/weightForClass" ; logic:closureValue logic:ClosedWorldClosure ] .
