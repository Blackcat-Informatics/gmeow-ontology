gmeow:DriveGroundInputConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agentic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "drive ground-input constraint"@x-gmeow-english ;
    skos:definition "Requires actual ground drive-query resource inputs to have their declared source types, the circadian quantity’s selected dimension and the stage’s exact positive membership in the selected definition."@x-gmeow-english ;
    skos:scopeNote "Template variables remain unbound source variables; the selected consumer must check their actual later bindings."@x-gmeow-english ;
    skos:example "A ground stage input lacking membership in the selected definition is rejected."@x-gmeow-english ;
    gmeow:useWhen "Use to check actual supplied ground resources without inventing missing source facts."@x-gmeow-english ;
    gmeow:avoidWhen "Do not cap other stage memberships or infer a time coordinate, dimension or activity occurrence."@x-gmeow-english ;
    gmeow:howToUse "Bind actual stored query carriers and require each exact positive source association."@x-gmeow-english ;
    logic:formalizes gmeow:DriveDefinition ;
    logic:message "Requires actual ground drive-query resource inputs to have their declared source types, the circadian quantity’s selected dimension and the stage’s exact positive membership in the selected definition."@x-gmeow-english ;
    logic:integrity _:driveDriveGroundInputConstraint1 .

