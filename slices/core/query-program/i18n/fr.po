msgstr "Bijection des contributions du repli des scores"

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldContributionBijectionConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A score fold uses every matching input contribution once, with no unrelated contribution."
msgstr "Le repli d’un score utilise une fois chaque contribution correspondante, sans contribution étrangère."

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldContributionBijectionConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query score contribution fold bijection with explicit source bindings."
msgstr "Utiliser pour décrire bijection des contributions du repli des scores avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldContributionBijectionConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
