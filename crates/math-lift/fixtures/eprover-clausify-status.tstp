%
% Dialect: E prover (`eprover --proof-object`) TSTP output, INCLUDING the
% clausification prefix E normally emits ahead of the saturation proper.
%
% This fixture exists for the SZS inference statuses that are not `thm`, which
% every real prover emits during clausification and which our own reasoner never
% does:
%   * `status(cth)` on `assume_negation` — the step's conclusion is a
%     COUNTER-theorem of its parent (the negation of the conjecture), not a
%     theorem of it;
%   * `status(esa)` on `skolemize` — Skolemization preserves satisfiability, not
%     theoremhood, so the conclusion is EQUI-SATISFIABLE with the parent rather
%     than entailed by it;
%   * `status(thm)` on the entailment-preserving steps.
%
% It also carries a `<useful_info>` 5th field (`[proof]`) on the final step, which
% E writes when it marks the clause that closed the proof.
%
% Source problem:
%   fof(ax_pq, axiom,      ! [X] : (p(X) => q(X))).
%   fof(ax_qr, axiom,      ! [X] : (q(X) => r(X))).
%   fof(goal,  conjecture, ! [X] : (p(X) => r(X))).
%
% Because `cth` and `esa` are stated facts about the derivation that the `math:`
% proof layer has no property to carry, a lift of THIS document enumerates them as
% residue on its source witness and travels at a lossy rung — the honest
% alternative to silently reading every step as theorem-preserving.
fof(c_0_0, axiom, ! [X1] : (p(X1) => q(X1)), file('SYN075+1.p', ax_pq)).
fof(c_0_1, axiom, ! [X1] : (q(X1) => r(X1)), file('SYN075+1.p', ax_qr)).
fof(c_0_2, conjecture, ! [X1] : (p(X1) => r(X1)), file('SYN075+1.p', goal)).
fof(c_0_3, negated_conjecture, ~ (! [X1] : (p(X1) => r(X1))), inference(assume_negation, [status(cth)], [c_0_2])).
fof(c_0_4, plain, ? [X1] : (p(X1) & ~r(X1)), inference(fof_nnf, [status(thm)], [c_0_3])).
fof(c_0_5, plain, (p(esk1_0) & ~r(esk1_0)), inference(skolemize, [status(esa)], [c_0_4])).
cnf(c_0_6, plain, p(esk1_0), inference(split_conjunct, [status(thm)], [c_0_5])).
cnf(c_0_7, plain, ~r(esk1_0), inference(split_conjunct, [status(thm)], [c_0_5])).
fof(c_0_8, plain, ! [X1] : (~p(X1) | q(X1)), inference(fof_nnf, [status(thm)], [c_0_0])).
cnf(c_0_9, plain, ~p(X1) | q(X1), inference(split_conjunct, [status(thm)], [c_0_8])).
fof(c_0_10, plain, ! [X1] : (~q(X1) | r(X1)), inference(fof_nnf, [status(thm)], [c_0_1])).
cnf(c_0_11, plain, ~q(X1) | r(X1), inference(split_conjunct, [status(thm)], [c_0_10])).
cnf(c_0_12, plain, q(esk1_0), inference(spm, [status(thm)], [c_0_9, c_0_6])).
cnf(c_0_13, plain, r(esk1_0), inference(spm, [status(thm)], [c_0_11, c_0_12])).
cnf(c_0_14, plain, $false, inference(sr, [status(thm)], [c_0_13, c_0_7]), [proof]).
