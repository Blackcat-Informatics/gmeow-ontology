@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix gsso: <http://purl.obolibrary.org/obo/GSSO_> .
@prefix homosaurus: <https://homosaurus.org/v4/> .
@prefix fhir: <http://hl7.org/fhir/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .

# Term equivalences for the gender domain — GMEOW authoring source.
# Compiled to mappings/gmeow-gender.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetGender a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-gender.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/gender" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Gender alignments — gender-identity values to GSSO and Homosaurus v4 (the authoritative sex-gender / LGBTQ+ vocabularies) and the gender-carrying property to schema.org, FOAF and Wikidata P21 (P21 is Wikidata's accepted sex-or-gender field). EVERY external identifier was verified against the local authoritative copies (Homosaurus v4 + GSSO from /opt/foundation; Wikidata via API) — scraped IDs proved unreliable. Note Wikidata has NO gender-identity item for 'woman'/'man' distinct from the SEX values female/male (Q6581072/Q6581097), which are mapped to sexAssignedAtBirth instead — itself evidence of the sex/gender conflation GMEOW refuses; GSSO does carry distinct woman/man gender identities. The value vocab is OPEN (demigirl/demiboy/questioning are canonical until verified IDs exist). The reified, self-asserted, co-equal gmeow:IdentityFacet machinery (hasGenderIdentity/genderValue, selfAsserted, displayable suppression) is CANONICAL. sexAssignedAtBirth is a recorded administrative datum; documentary sex on records uses external gedcom:sex directly." .

gmeow:eqGender001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:GenderIdentity ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject homosaurus:homoit0000571 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Homosaurus v4 'Gender identity'" ;
    gmeow:sssomFile "gmeow-gender.sssom.tsv" .

gmeow:eqGender002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:genderValue ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:gender ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "lossy — schema:gender conflates sex/gender" ;
    gmeow:sssomFile "gmeow-gender.sssom.tsv" .

gmeow:eqGender003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:genderValue ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject foaf:gender ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "lossy legacy binary-leaning property" ;
    gmeow:sssomFile "gmeow-gender.sssom.tsv" .

gmeow:eqGender004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:genderValue ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wdt:P21 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Wikidata's accepted gender field (P21 'sex or gender')" ;
    gmeow:sssomFile "gmeow-gender.sssom.tsv" .

