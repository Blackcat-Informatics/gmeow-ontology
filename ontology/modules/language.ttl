@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/language>
    a owl:Ontology ;
    rdfs:label "GMEOW Language Core Module"@x-gmeow-english ;
    skos:definition "The slim language foundation every slice depends on: the Language and WritingSystem classes, the private-use/BCP-47 tag machinery, and the seed Language individuals that anchor the framework's own literals."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/modules/language> ;
    rdfs:comment "The CORE half of the languages split (#287 dependency surgery): gmeow:Language and gmeow:WritingSystem as first-class, registry-independent classes; gmeow:languageTag / gmeow:bcp47Tag / gmeow:languageCode (the x-gmeow-* private-use anchor machinery); and the three seed individuals — English, Mandarin, French — that back the framework's own language-tagged literals (Canadian + US + European + Chinese coverage). The rich sociolinguistic machinery (proficiency, writing-system usage, varieties, diachronic states, version lineage, conlangs) lives in the languages extension slice, which extends these classes."@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# Classes — declared HERE (one-defining-slice rule); the languages extension
# subclasses and extends them.
# =========================================================================== #

gmeow:Language
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:InformationObject ;
    rdfs:label "Language"@x-gmeow-english ;
    skos:definition "A language as a first-class information object with a self-minted IRI: a system of signs/symbols and rules used for communication or computation. Registry-INDEPENDENT — BCP-47/ISO 639/Glottolog/Wikidata are optional alignments (gmeow:languageCode, gmeow:authorityLink, skos:exactMatch), never identity, so a code-less conlang or AI-generated language is fully first-class. Origin, modality and status are open value vocabularies; the scripts it is written in are bound co-equally via gmeow:WritingSystemUsage; its endonym/exonym names are gmeow:Appellation."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:WritingSystem
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:InformationObject ;
    rdfs:label "Writing System"@x-gmeow-english ;
    skos:definition "A first-class system for visually or tactilely representing language — a script: Latin, Han (kanji), Hiragana, Katakana, Arabic, Braille, or a bespoke conlang/AI script. Carries gmeow:scriptCode (ISO 15924 when one exists, else a bespoke identifier), a type (gmeow:writingSystemType) and a direction (gmeow:textDirection). Bound to the languages that use it — co-equally and simultaneously — through gmeow:WritingSystemUsage; bespoke and non-linear scripts (Ithkuil) are first-class."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .


# =========================================================================== #
# Tag machinery — the x-gmeow-* private-use anchor (Principle 4: internal
# literals use private-use tags; standard BCP-47 is reconstructed on
# projection).
# =========================================================================== #

gmeow:languageTag
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Language ;
    rdfs:range xsd:string ;
    rdfs:label "language tag"@x-gmeow-english ;
    skos:definition "The internal private-use BCP-47 language tag (e.g., 'x-gmeow-japanese') used for @lang annotations on string literals representing this language."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:bcp47Tag
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Language ;
    rdfs:range xsd:language ;
    rdfs:label "BCP-47 tag"@x-gmeow-english ;
    skos:definition "An OPTIONAL external BCP-47 language tag used only when projecting GMEOW's internal private-use literals into vocabularies that require standard language-tag literals. Non-functional because a language may expose several valid BCP-47 tags across script, region, or variant contexts; broad registry alignments such as ISO 639-3 codes and Glottocodes remain gmeow:languageCode values."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:languageCode
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Language ;
    rdfs:range rdfs:Literal ;
    rdfs:label "language code"@x-gmeow-english ;
    skos:definition "An OPTIONAL registry code for a language (a BCP-47 tag \"ja\", an ISO 639-3 code \"jpn\", a Glottocode). A see-also alignment value, NEVER identity — a code-less conlang or AI-language is fully first-class. Authoritative identity is the self-minted IRI; assert registry coreference with skos:exactMatch and gmeow:authorityLink. Non-functional (a language carries codes in several registries)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .


# =========================================================================== #
# Seed Language individuals — the languages the framework itself speaks.
# These anchor the private-use tags used on every GMEOW literal; further
# languages are first-class data, minted by any slice or dataset (an
# exhaustive reference catalog is tracked as issue #111).
# =========================================================================== #

gmeow:languageEnglish
    a owl:NamedIndividual, gmeow:Language ;
    rdfs:label "English"@x-gmeow-english ;
    skos:definition "The English language — the seed gmeow:Language individual anchoring the internal private-use tag x-gmeow-english carried by the framework's own literals. Registry codes are alignments, never identity."@x-gmeow-english ;
    gmeow:languageTag "x-gmeow-english" ;
    gmeow:bcp47Tag "en" ;
    gmeow:languageCode "eng" ;
    skos:exactMatch <http://www.wikidata.org/entity/Q1860> ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:languageMandarin
    a owl:NamedIndividual, gmeow:Language ;
    rdfs:label "Mandarin Chinese"@x-gmeow-english ;
    rdfs:label "普通话"@x-gmeow-mandarin ;
    skos:definition "Mandarin Chinese — a seed gmeow:Language individual anchoring the internal private-use tag x-gmeow-mandarin. Registry codes are alignments, never identity."@x-gmeow-english ;
    gmeow:languageTag "x-gmeow-mandarin" ;
    gmeow:bcp47Tag "zh" ;
    gmeow:languageCode "cmn" ;
    skos:exactMatch <http://www.wikidata.org/entity/Q9192> ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:languageFrench
    a owl:NamedIndividual, gmeow:Language ;
    rdfs:label "French"@x-gmeow-english ;
    rdfs:label "français"@x-gmeow-french ;
    skos:definition "The French language — a seed gmeow:Language individual anchoring the internal private-use tag x-gmeow-french. Registry codes are alignments, never identity."@x-gmeow-english ;
    gmeow:languageTag "x-gmeow-french" ;
    gmeow:bcp47Tag "fr" ;
    gmeow:languageCode "fra" ;
    skos:exactMatch <http://www.wikidata.org/entity/Q150> ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
