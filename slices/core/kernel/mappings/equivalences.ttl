@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:Agent owl:equivalentClass foaf:Agent {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:Agent owl:equivalentClass prov:Agent {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

prov:Entity skos:closeMatch gmeow:Entity {|
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7
|} .

gmeow:Determinacy skos:closeMatch gufo:QualityValue {|
    gmeow:sssomFile "gmeow-determinacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "gmeow:Determinacy is declared rdfs:subClassOf gufo:QualityValue in the ontology; the alignment makes the dependency explicit in the mapping layer"
|} .

gmeow:Determinacy skos:relatedMatch bfo:BFO_0000019 {|
    gmeow:sssomFile "gmeow-determinacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:objectLabel "quality" ;
    gmeow:comment "BFO 'quality' is a high-level ontological category, not a value individual type; only a loose relatedMatch is warranted"
|} .

gmeow:determinacyFuzzy skos:closeMatch wd:Q1055058 {|
    gmeow:sssomFile "gmeow-determinacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "fuzzy set"
|} .

gmeow:determinacyVague skos:closeMatch wd:Q1411921 {|
    gmeow:sssomFile "gmeow-determinacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "vagueness"
|} .

gmeow:determinacyProbabilistic skos:closeMatch wd:Q9492 {|
    gmeow:sssomFile "gmeow-determinacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "probability"
|} .

gmeow:determinacyDisputed skos:closeMatch wd:Q18912752 {|
    gmeow:sssomFile "gmeow-determinacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "disputed" ;
    gmeow:comment "Wikidata 'disputed' sourcing qualifier; the closest structured external term for a contested/undecided value"
|} .

gmeow:PhysicalObject skos:closeMatch dcmitype:PhysicalObject {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "A GMEOW PhysicalObject is a DCMI PhysicalObject"
|} .

gmeow:hasPart skos:closeMatch dcterms:hasPart {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75
|} .

gmeow:partOf skos:closeMatch dcterms:isPartOf {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75
|} .

gmeow:SensitivityLevel skos:closeMatch dpv:SensitivityLevel {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "DPV's SensitivityLevel is scoped to its process/entity model; GMEOW's is a universal QualityValue facet"
|} .

gmeow:SensitivityLevel skos:closeMatch gufo:QualityValue {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "gmeow:SensitivityLevel is declared rdfs:subClassOf gufo:QualityValue in the ontology"
|} .

gmeow:hasSensitivity skos:closeMatch dpv:hasSensitivityLevel {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "DPV hasSensitivityLevel is scoped to processes/entities; GMEOW hasSensitivity is universal and domain-free"
|} .

gmeow:sensitivitySensitivePersonal skos:closeMatch dpv:SensitivePersonalData {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "the special-category personal-data tier in both vocabularies"
|} .

gmeow:sensitivitySensitivePersonal skos:closeMatch wd:Q2796 {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "personal data"
|} .

gmeow:sensitivityConfidential skos:closeMatch wd:Q188475 {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "confidentiality"
|} .

gmeow:ProjectionContext skos:relatedMatch dpv:Recipient {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "DPV Recipient is the party receiving data; GMEOW ProjectionContext is the consumer/audience of a projection"
|} .

gmeow:DisclosurePolicy skos:relatedMatch dpv:ProcessingContext {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "DPV ProcessingContext is a broad context class; GMEOW DisclosurePolicy is a claim-scoped classification"
|} .

gmeow:DisclosurePolicy skos:relatedMatch odrl:Policy {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "ODRL Policy is a full deontic expression; GMEOW DisclosurePolicy is a lighter-weight claim-scoped classification"
|} .

gmeow:eligibleForConsumer skos:relatedMatch schema:audience {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "schema.org audience is the intended consumer of a CreativeWork; GMEOW eligibleForConsumer is universal and claim-scoped"
|} .

gmeow:hasDisclosurePolicy skos:relatedMatch dpv:hasProcessingContext {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "DPV hasProcessingContext links a process to its context; GMEOW hasDisclosurePolicy is domain-free"
|} .

gmeow:policyPublicOnlyWithIndependentSource skos:relatedMatch odrl:purpose {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "the conditional independent-source requirement is a purpose-like constraint on disclosure"
|} .

gmeow:consumerWikidata skos:closeMatch wd:Q2013 {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "Wikidata"
|} .

gmeow:consumerWikipedia skos:closeMatch wd:Q52 {|
    gmeow:sssomFile "gmeow-privacy.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
