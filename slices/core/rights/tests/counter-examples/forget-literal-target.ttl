@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex: <https://example.org/lifecycle/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:request a gmeow:ForgetRequest ;
    gmeow:requestingAgent ex:person ;
    gmeow:requestedErasureTarget "claim" ;
    gmeow:requestUnderRight ex:right .
ex:person a gmeow:Agent .
ex:claim a gmeow:Entity .
