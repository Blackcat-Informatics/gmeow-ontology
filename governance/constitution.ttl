# Principle 17 enforcement — the logic EPIC has landed.
# The design-stage `meta:practice-logic-design` placeholder is retired and
# replaced by the three real gates promised in its retirement comment: the
# conformance corpus (the native Rust solver ≡ the committed goldens), the
# logic→OWL/Datalog/N3/gUFO round-trip, and the gUFO foundation downcast.
# Rust is the reasoning authority (the "maximally use Rust" doctrine); the
# Python oracle is a secondary validator (test_logic_oracle_engine_parity.py).
meta:gate-logic-conformance a meta:Gate ;
    rdfs:label "the logic: conformance corpus — native solver ≡ committed goldens (Principle 7/17)"@x-gmeow-english ;
    meta:artifact "crates/conformance/src/discover.rs", "crates/conformance/src/run.rs",
        "crates/conformance/tests/conformance.rs", "conformance/logic/README.md" ;
    meta:symbol "discover_cases", "run_case" ;
    meta:makeTarget "conformance" .

meta:gate-logic-round-trip a meta:Gate ;
    rdfs:label "logic→OWL DL/EL, Datalog, N3, gUFO projection round-trip isomorphism + preservation ledger"@x-gmeow-english ;
    meta:artifact "crates/logic/src/compile/projections/text.rs", "crates/logic/src/compile/projections/report.rs" ;
    meta:symbol "project_nemo", "build_projection_report" .

meta:gate-foundation-conformance a meta:Gate ;
    rdfs:label "gUFO foundation downcast ≡ reasoning_lint verdicts — native Rust evaluator"@x-gmeow-english ;
    meta:artifact "tests/test_logic_foundation_cases.py", "crates/logic/src/foundation.rs" ;
    meta:symbol "evaluate" .

meta:gate-logic-gufo-superset a meta:Gate ;
    rdfs:label "gmeow:logic ⊇ gUFO floor — every gUFO class has a logic: correspondence"@x-gmeow-english ;
    meta:artifact "tests/test_logic_gufo_superset.py", "crates/logic/src/compile/adapter.rs" ;
    meta:symbol "_GUFO_CLASS_TO_LOGIC", "test_every_gufo_class_has_logic_correspondence" .

# Principle 18 enforcement — the native reasoning authority. The native
# EL/DL lane is the Java/Docker-free authoritative gate; the divergence ledger
# is built from native results ONLY and enforces native gap-zero coverage, while
# oracle comparison runs in classic-cross-check.
meta:gate-reason-native a meta:Gate ;
    rdfs:label "native Docker-free EL/DL reasoning authority (reason --mode native)"@x-gmeow-english ;
    meta:artifact "src/gmeow_tools/reason.py" ;
    meta:symbol "reason_native" ;
    meta:makeTarget "reason" ;
    meta:cliCommand "reason" .

meta:gate-dl-el-crosscheck a meta:Gate ;
    rdfs:label "native gap-zero divergence ledger — native-built gap-zero artifact; oracle confirmation runs in the classic-cross-check lane"@x-gmeow-english ;
    meta:artifact "crates/pipeline/src/stages/logic.rs", "generated/logic/dl-el-crosscheck-report.ttl" ;
    meta:symbol "LogicStage" ;
    meta:generator "logic" .

# The ENFORCING classic-cross-check lane: the sole Java+Docker surface, a
# single non-required CI job. Compares the native engine against the legacy
# oracles (ELK/HermiT subsumption + consistency; owlrl OWL-2-RL closure) and
# FAILS strictly on any NativeOnly/OracleOnly divergence or DlGap native coverage
# defect. NEVER part of `make check` or the required `quality` gate. Emits
# agreement + timing through the gmeow-diagnostics SARIF rail.
meta:gate-classic-cross-check a meta:Gate ;
    rdfs:label "classic-cross-check lane — native vs ELK/HermiT/owlrl agreement, ENFORCED (non-required Docker/Java oracle lane)"@x-gmeow-english ;
    meta:artifact "src/gmeow_tools/classic_cross_check.py", "src/gmeow_tools/rl_agreement.py" ;
    meta:symbol "enforce", "run" ;
    meta:makeTarget "maint-classic-cross-check" ;
    meta:cliCommand "classic-cross-check", "classic-cross-check-rl" .

# The anti-regression SUPERSET meta-gate (#697 criterion 3): the native-decided
# construct set must be a SUPERSET of the oracle-decided set. Any OracleOnly row
# (the oracle decided a construct the native path did not) or any DlGap (a native
# coverage defect) is a coverage REGRESSION and FAILS. The decision is computed in
# Rust (the `enforce` verdict over the divergence ledger), not in Python, and is
# proven OFFLINE by the frozen oracle-gold conformance lane (native ⊇ HermiT over
# the curated DL datasets, no Docker/Java/network).
meta:gate-native-oracle-superset a meta:Gate ;
    rdfs:label "native ⊇ oracle anti-regression superset gate — Rust-decided, offline frozen-oracle-gold proven (#697)"@x-gmeow-english ;
    meta:artifact "crates/logic/src/reason/ledger.rs",
        "crates/conformance/tests/dl_oracle_gold.rs",
        "coverage/external/697-dl-oracle-gold/README.md" ;
    meta:symbol "enforce", "native_reasoner_is_a_superset_of_the_frozen_oracle_gold" ;
    meta:makeTarget "conformance" .

# --------------------------------------------------------------------------- #
# The principles
# --------------------------------------------------------------------------- #

meta:Principle1 a meta:Principle ;
    meta:number 1 ;
    meta:title "SOTA by being SOTA" ;
    meta:enforcedBy meta:practice-rationale .

meta:Principle2 a meta:Principle ;
    meta:number 2 ;
    meta:title "RDF 1.2 / RDF\\*-first — precisely scoped" ;
    meta:enforcedBy meta:gate-statements, meta:tests-statements ;
    meta:supersededInPartBy meta:Principle17 .

meta:Principle3 a meta:Principle ;
    meta:number 3 ;
    meta:title "The OWL axiom-annotation form is a generated, reasoning-lossless downcast" ;
    meta:enforcedBy meta:gate-rdf12-codec, meta:gate-statements, meta:tests-statements .

meta:Principle4 a meta:Principle ;
    meta:number 4 ;
    meta:title "One canonical source; everything else a generated lossy projection" ;
    meta:enforcedBy meta:gate-generator-registry, meta:tests-narrow-waist .

meta:Principle5 a meta:Principle ;
    meta:number 5 ;
    meta:title "Maximal superset, maximal bridging — by reference" ;
    meta:enforcedBy meta:lint-sameas-ban, meta:lint-equivalence-collapse,
        meta:tests-alignment .

meta:Principle6 a meta:Principle ;
    meta:number 6 ;
    meta:title "Greenfield — get it right, not compatible" ;
    meta:enforcedBy meta:practice-rationale .

meta:Principle7 a meta:Principle ;
    meta:number 7 ;
    meta:title "Verified by construction" ;
    meta:enforcedBy meta:gate-generator-registry, meta:gate-crosscheck .

meta:Principle8 a meta:Principle ;
    meta:number 8 ;
    meta:title "Reasoning-gated and FAIR" ;
    meta:enforcedBy meta:gate-reasoning, meta:gate-fair-metadata,
        meta:gate-compliance-report ;
    meta:supersededInPartBy meta:Principle17 .

meta:Principle9 a meta:Principle ;
    meta:number 9 ;
    meta:title "Inclusive without overtyping; anti-colonial in every direction; self-assertion is top authority" ;
    meta:enforcedBy meta:lint-no-preferred-rank, meta:tests-identity-orthogonality,
        meta:shapes-core, meta:lint-coequal-facet, meta:lint-term-naming .

meta:Principle10 a meta:Principle ;
    meta:number 10 ;
    meta:title "Suppression, never erasure" ;
    meta:enforcedBy meta:gate-suppression, meta:tests-suppression,
        meta:gate-suppression-injection, meta:tests-leak-conformance,
        meta:gate-claim-audit .

meta:Principle11 a meta:Principle ;
    meta:number 11 ;
    meta:title "Frame-relativity — values live in an explicit reference system" ;
    meta:enforcedBy meta:shapes-core, meta:tests-reference-frames,
        meta:shapes-frame-generated, meta:lint-frame-completeness .

meta:Principle12 a meta:Principle ;
    meta:number 12 ;
    meta:title "Compute outside the logic — the solver boundary" ;
    meta:enforcedBy meta:gate-reasoning, meta:lint-reasoning-invariants,
        meta:tests-reasoning ;
    meta:supersededInPartBy meta:Principle17 .

meta:Principle13 a meta:Principle ;
    meta:number 13 ;
    meta:title "The product is a tool; the ontology is its engine" ;
    meta:enforcedBy meta:gate-products, meta:tests-products .

meta:Principle14 a meta:Principle ;
    meta:number 14 ;
    meta:title "Grounded agent memory and claim provenance are the flagship" ;
    meta:enforcedBy meta:tests-claim-spine, meta:gate-statements,
        meta:gate-claim-audit, meta:gate-evals, meta:tests-claim-pattern .

meta:Principle15 a meta:Principle ;
    meta:number 15 ;
    meta:title "Every module earns its consumer" ;
    meta:enforcedBy meta:practice-consumer-question .

meta:Principle16 a meta:Principle ;
    meta:number 16 ;
    meta:title "A small core; everything else a published extension" ;
    meta:enforcedBy meta:gate-core-profile, meta:tests-slices,
        meta:gate-crate-layering .

meta:Principle17 a meta:Principle ;
    meta:number 17 ;
    meta:title "The logic itself is canonical — OWL is a projection of it, not its ceiling" ;
    meta:enforcedBy meta:gate-logic-conformance, meta:gate-logic-round-trip,
        meta:gate-foundation-conformance, meta:gate-logic-gufo-superset .

# The executable lane-purity seal (#667): the two-lane split (primary lane
# Java/Docker-free; classic-cross-check the SOLE oracle lane) is enforced by an
# actual test, not convention. FAILS if a Docker/Java token reaches the primary
# path, or if the classic-cross-check workflow ever becomes a required check.
meta:tests-lane-purity a meta:TestSuite ;
    rdfs:label "lane-purity seal — required CI jobs + make check carry no Java/Docker (#667)"@x-gmeow-english ;
    meta:artifact "tests/test_lane_purity.py" ;
    meta:symbol "test_required_ci_jobs_carry_no_java_or_docker",
        "test_makefile_required_targets_carry_no_java_or_docker" .

meta:Principle18 a meta:Principle ;
    meta:number 18 ;
    meta:title "The reference RDF-1.2 stack — complete, coherent, and Docker-free" ;
    meta:enforcedBy meta:gate-reason-native, meta:gate-dl-el-crosscheck,
        meta:gate-classic-cross-check, meta:gate-native-oracle-superset,
        meta:tests-lane-purity ;
    meta:extends meta:Principle17, meta:Principle13 .
