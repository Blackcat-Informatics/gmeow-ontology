#
# Worked example — THE ARGUMENTATION LAYER (Dung / ASPIC+), the headline.
#
# The classic Tweety: Argument A concludes "Tweety flies" (Tweety is a bird,
# birds fly). Argument B REBUTS A's conclusion (Tweety is a penguin, penguins do
# not fly). B's conclusion accrues SUPPORT from two independent sources (a field
# guide and a direct observation) — each its own gmeow:Support instance, so
# support combines rather than counting once. Under the grounded semantics the
# solver writes the verdict: B is IN, A is OUT — COMPUTED, never an asserted
# accepted bit (Principle 12). Nothing is deleted; A is retained as audit.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/inference/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

ex:zoologist a gmeow:Agent ;
    gmeow:name "Field zoologist"@x-gmeow-english .

ex:propBirdsFly       rdfs:label "birds fly"@x-gmeow-english .
ex:propTweetyBird     rdfs:label "Tweety is a bird"@x-gmeow-english .
ex:propTweetyFlies    rdfs:label "Tweety flies"@x-gmeow-english .
ex:propPenguinsNoFly  rdfs:label "penguins do not fly"@x-gmeow-english .
ex:propTweetyPenguin  rdfs:label "Tweety is a penguin"@x-gmeow-english .
ex:propTweetyNoFly    rdfs:label "Tweety does not fly"@x-gmeow-english .

# --- Argument A: Tweety flies (the defeasible default) ----------------------- #
ex:premBirdsFly a gmeow:StandpointClaim ;
    gmeow:vantage ex:zoologist ; gmeow:observedFeature ex:propBirdsFly ;
    gmeow:observationMethod gmeow:methodExpertJudgement ; gmeow:claimModality gmeow:probable .

ex:premTweetyBird a gmeow:StandpointClaim ;
    gmeow:vantage ex:zoologist ; gmeow:observedFeature ex:propTweetyBird ;
    gmeow:observationMethod gmeow:methodDirectObservation ; gmeow:claimModality gmeow:unequivocal .

ex:conclTweetyFlies a gmeow:StandpointClaim ;
    rdfs:label "Tweety flies (defeated, retained as audit)"@x-gmeow-english ;
    gmeow:vantage ex:zoologist ; gmeow:observedFeature ex:propTweetyFlies ;
    gmeow:observationMethod gmeow:methodExpertJudgement ; gmeow:claimModality gmeow:conceivable ;
    gmeow:inferenceMode gmeow:modeDeduction ;
    gmeow:inferredFrom ex:premBirdsFly , ex:premTweetyBird ;
    gmeow:displayable false .

ex:commitFlies a gmeow:InferenceCommitment ;
    gmeow:inferenceModeOf gmeow:modeDeduction ;
    gmeow:premise ex:premBirdsFly , ex:premTweetyBird ;
    gmeow:conclusion ex:conclTweetyFlies .

ex:useBirdsFly a gmeow:PremiseUse ; gmeow:premiseUsed ex:premBirdsFly .
ex:useTweetyBird a gmeow:PremiseUse ; gmeow:premiseUsed ex:premTweetyBird .
ex:stepDefaultFlight a gmeow:InferenceApplication ;
    gmeow:appliedRule "defeasible default: bird(x) => flies(x)"@x-gmeow-english ;
    gmeow:appliedSubstitution "x := Tweety"@x-gmeow-english .

ex:argTweetyFlies a gmeow:Argument ;
    rdfs:label "Argument A: Tweety flies"@x-gmeow-english ;
    gmeow:argumentInferenceStep ex:commitFlies ;
    gmeow:hasPremiseUse ex:useBirdsFly , ex:useTweetyBird ;
    gmeow:hasInferenceApplication ex:stepDefaultFlight ;
    gmeow:argumentConclusion ex:conclTweetyFlies .

# --- Argument B: Tweety does not fly (the more specific rule) ---------------- #
ex:premPenguinsNoFly a gmeow:StandpointClaim ;
    gmeow:vantage ex:zoologist ; gmeow:observedFeature ex:propPenguinsNoFly ;
    gmeow:observationMethod gmeow:methodExpertJudgement ; gmeow:claimModality gmeow:unequivocal .

ex:premTweetyPenguin a gmeow:StandpointClaim ;
    gmeow:vantage ex:zoologist ; gmeow:observedFeature ex:propTweetyPenguin ;
    gmeow:observationMethod gmeow:methodDirectObservation ; gmeow:claimModality gmeow:unequivocal .

ex:conclTweetyNoFly a gmeow:StandpointClaim ;
    rdfs:label "Tweety does not fly"@x-gmeow-english ;
    gmeow:vantage ex:zoologist ; gmeow:observedFeature ex:propTweetyNoFly ;
    gmeow:observationMethod gmeow:methodExpertJudgement ; gmeow:claimModality gmeow:probable ;
    gmeow:inferenceMode gmeow:modeDeduction ;
    gmeow:inferredFrom ex:premPenguinsNoFly , ex:premTweetyPenguin .

ex:commitNoFly a gmeow:InferenceCommitment ;
    gmeow:inferenceModeOf gmeow:modeDeduction ;
    gmeow:premise ex:premPenguinsNoFly , ex:premTweetyPenguin ;
    gmeow:conclusion ex:conclTweetyNoFly .

ex:usePenguinsNoFly a gmeow:PremiseUse ; gmeow:premiseUsed ex:premPenguinsNoFly .
ex:useTweetyPenguin a gmeow:PremiseUse ; gmeow:premiseUsed ex:premTweetyPenguin .
ex:stepPenguinException a gmeow:InferenceApplication ;
    gmeow:appliedRule "specific rule: penguin(x) => not flies(x)"@x-gmeow-english ;
    gmeow:appliedSubstitution "x := Tweety"@x-gmeow-english .

ex:argTweetyNoFly a gmeow:Argument ;
    rdfs:label "Argument B: Tweety does not fly"@x-gmeow-english ;
    gmeow:argumentInferenceStep ex:commitNoFly ;
    gmeow:hasPremiseUse ex:usePenguinsNoFly , ex:useTweetyPenguin ;
    gmeow:hasInferenceApplication ex:stepPenguinException ;
    gmeow:argumentConclusion ex:conclTweetyNoFly .

# --- B rebuts A's conclusion (attacks the conclusion claim) ------------------ #
ex:rebutFlight a gmeow:Attack ;
    rdfs:label "Rebut: the penguin argument attacks 'Tweety flies'"@x-gmeow-english ;
    gmeow:attackSource ex:argTweetyNoFly ;
    gmeow:attackTarget ex:conclTweetyFlies ;       # the conclusion StandpointClaim of A
    gmeow:attackKind gmeow:attackRebut .

# --- Support ACCRUES: two independent supports for B ------------------------- #
ex:fieldGuideSupport a gmeow:Support ;
    rdfs:label "The field guide supports 'Tweety does not fly'"@x-gmeow-english ;
    gmeow:supportSource ex:premPenguinsNoFly ;
    gmeow:supportTarget ex:argTweetyNoFly .

ex:observationSupport a gmeow:Support ;
    rdfs:label "Direct observation independently supports 'Tweety does not fly'"@x-gmeow-english ;
    gmeow:supportSource ex:premTweetyPenguin ;
    gmeow:supportTarget ex:argTweetyNoFly .

# --- The solver verdict under the grounded semantics ------------------------ #
ex:evalNoFly a gmeow:ArgumentEvaluation ;
    rdfs:label "Grounded: argument B is accepted (in)"@x-gmeow-english ;
    gmeow:evaluatesArgument ex:argTweetyNoFly ;
    gmeow:underSemantics logic:GroundedArgumentation ;
    gmeow:acceptanceStatus gmeow:acceptanceIn ;
    gmeow:extensionMember ex:argTweetyNoFly .

ex:evalFlies a gmeow:ArgumentEvaluation ;
    rdfs:label "Grounded: argument A is rejected (out)"@x-gmeow-english ;
    gmeow:evaluatesArgument ex:argTweetyFlies ;
    gmeow:underSemantics logic:GroundedArgumentation ;
    gmeow:acceptanceStatus gmeow:acceptanceOut .
