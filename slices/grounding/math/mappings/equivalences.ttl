# --- Quantity and dimension → OM 2 (align, don't spine) --------------------- #
# The /resource/ IRIs below are OM 2's own canonical class identities: om-2.0.rdf
# declares <owl:Class rdf:about="&om;Quantity"> and <owl:Class rdf:about="&om;Dimension">
# with &om; = http://www.ontology-of-units-of-measure.org/resource/om-2/, so the align
# targets are the concepts themselves, not a document. The OM 2 server does not
# content-negotiate the /resource/ form (it returns 404 even for RDF Accept headers) —
# a Pubby-server limitation, not a wrong IRI; the entities remain confirmed as owl:Class
# declarations in the published ontology and are browsable via the /page/ view. Aligning
# to the resolvable /page/ HTML view would mismap the concept to a document, so the
# canonical /resource/ identity is kept. Aligned by reference (closeMatch copies no axiom).

gmeow:eqMathQuantityOm2 a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject math:Quantity ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
    logic:sourceEndpoint math:Quantity ; logic:targetEndpoint <http://www.ontology-of-units-of-measure.org/resource/om-2/Quantity> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "om:Quantity" ;
    gmeow:comment "math:Quantity aligns to om-2:Quantity, OM 2's quantity concept. closeMatch (align, don't spine — Principle 17). Full IRI by reference — OM 2's own owl:Class identity (declared in the published om-2.0.rdf); the server 404s the /resource/ form (a Pubby limitation), so it is browsable via the /page/ view." ;
    gmeow:sssomFile "gmeow-om2.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

gmeow:eqMathDimensionOm2 a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject math:Dimension ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject <http://www.ontology-of-units-of-measure.org/resource/om-2/Dimension> ;
