@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/concepts>
    a gmeow:Slice ;
    rdfs:label "concepts"@x-gmeow-english ;
    skos:definition "The concepts slice of the GMEOW ontology (core tier): GMEOW Concepts Module — categories, schemas, and abstractions held by agents; vantage-indexed categorization; graded membership; concept structure; conceptual change."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/concepts> ;
    dcterms:title "GMEOW Concepts Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:sliceConsumer "The agent-memory flagship category/spine and learning surfaces (Principle 15): an LLM output categorizes an entity under a concept or schema, recorded via the flat gmeow:instanceOfConcept shortcut in the 80% case and promoted to a reified gmeow:ConceptCategorization StandpointClaim when the vantage, graded typicality, temporal scope, or provenance must be first-class. Consumed by retrieval stores, knowledge-graph enrichment, and learning-module concept scaffolding."@x-gmeow-english .
