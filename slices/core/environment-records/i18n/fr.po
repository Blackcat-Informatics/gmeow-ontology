msgctxt "https://blackcatinformatics.ca/gmeow/FulfillmentConditionMembershipConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "fulfillment condition membership"
msgstr "appartenance des conditions de réalisation"

msgctxt "https://blackcatinformatics.ca/gmeow/FulfillmentConditionMembershipConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "Every condition claimed met by a fulfillment is stated on its exact answered request revision. A different request's criteria cannot stand in for that revision."
msgstr "Chaque condition déclarée satisfaite par une réalisation est énoncée sur sa révision exacte de demande répondue. Les critères d’une autre demande ne peuvent la remplacer."

msgctxt "https://blackcatinformatics.ca/gmeow/FulfillmentConditionMembershipConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to check intrinsic consistency within the declared source scope."
msgstr "Utiliser pour contrôler la cohérence intrinsèque dans le périmètre source déclaré."

msgctxt "https://blackcatinformatics.ca/gmeow/FulfillmentConditionMembershipConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
