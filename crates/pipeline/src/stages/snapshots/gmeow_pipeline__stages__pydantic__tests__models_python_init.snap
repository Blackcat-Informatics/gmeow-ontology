_REBUILD_NS = {_k: _v for _k, _v in dict(globals()).items() if not _k.startswith("_")}
for _obj in list(_REBUILD_NS.values()):
    _rebuild = getattr(_obj, "model_rebuild", None)
    if callable(_rebuild):
        _rebuild(force=True, _types_namespace=_REBUILD_NS)
