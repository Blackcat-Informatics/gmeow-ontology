# === SQ3 — inference and results: p-value framing and multiplicity ========= #

ex:cqStatisticsPValueFraming a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-pvalue-framing.rq" ;
    gmeow:cqDataFile "tests/fixtures/statistics-pvalue-framing.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:PValue names the math:NullHypothesis it is computed under (math:nullHypothesis), the math:Distribution it is measured against (math:nullDistribution, a math:SamplingDistribution) and its math:Sidedness (math:alternativeSidedness) — the frame that makes P(T ≥ t | H0) unambiguous — and its multiplicity handling is LEFT-JOINed (math:pValueAdjustment / math:multipleComparisonFamily, BindingOptional), so 'what null, distribution, and tail/sidedness produced this p-value, and was it adjusted for multiplicity' is answerable. Over the fixture the answer is exactly {geneExpressionPValue → null noDifferenceNull, distribution tNullDistribution, sidedness twoSidedAlternative, adjustment benjaminiHochberg, family geneFamily}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsPValueFramingShape ;
    gmeow:cqExpectRow ex:rowPValueFraming .

ex:cqStatisticsPValueFramingShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "pvalue" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "nullHypothesis" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "nullDistribution" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "sidedness" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "adjustment" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingOptional ] ,
        [ logic:columnVariable "family" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingOptional ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowPValueFraming a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "pvalue" ; gmeow:cellValueIri exf:geneExpressionPValue ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "nullHypothesis" ; gmeow:cellValueIri exf:noDifferenceNull ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "nullDistribution" ; gmeow:cellValueIri exf:tNullDistribution ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sidedness" ; gmeow:cellValueIri math:twoSidedAlternative ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "adjustment" ; gmeow:cellValueIri exf:benjaminiHochberg ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "family" ; gmeow:cellValueIri exf:geneFamily ] .

# === SQ4 — interval estimates: kind and its level or mass ================== #

ex:cqStatisticsIntervalKind a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-interval-kind.rq" ;
    gmeow:cqDataFile "tests/fixtures/statistics-interval-kind.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A frequentist math:ConfidenceInterval carries its coverage through math:confidenceLevel (a property of the sampling procedure) and a Bayesian math:CredibleInterval carries its posterior mass through math:credibleMass (a posterior probability) — the same word 'interval' over two irreconcilable semantics, read on separate branches so each interval binds its OWN quantity and the two edges are never collapsed. Over the fixture the answer is exactly {coverageInterval → math:ConfidenceInterval, level coverageLevel; posteriorInterval → math:CredibleInterval, mass posteriorMass}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsIntervalKindShape ;
    gmeow:cqExpectRow ex:rowCoverageInterval , ex:rowPosteriorInterval .

ex:cqStatisticsIntervalKindShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "interval" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "kind" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "amount" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowCoverageInterval a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "interval" ; gmeow:cellValueIri exf:coverageInterval ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:ConfidenceInterval ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "amount" ; gmeow:cellValueIri exf:coverageLevel ] .

ex:rowPosteriorInterval a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "interval" ; gmeow:cellValueIri exf:posteriorInterval ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:CredibleInterval ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "amount" ; gmeow:cellValueIri exf:posteriorMass ] .

# === SQ5 — which inference paradigm a result belongs to =================== #

ex:cqStatisticsResultParadigm a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-result-paradigm.rq" ;
    gmeow:cqDataFile "tests/fixtures/statistics-result-paradigm.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Each result is typed a paradigm-exclusive kind and its inference family is resolved by walking the ASSERTED subclass taxonomy math:ConfidenceInterval ⊑ math:FrequentistResult / math:CredibleInterval ⊑ math:BayesianResult held in module.ttl — an rdfs:subClassOf* path that resolves WITHOUT reasoning because those edges are asserted (exactly as the embedding question walks subClassOf*), and the two families are held owl:disjointWith so a result reaches exactly one. Over the fixture the answer is exactly {bayesianResult → math:BayesianResult, frequentistResult → math:FrequentistResult}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsResultParadigmShape ;
    gmeow:cqExpectRow ex:rowBayesianParadigm , ex:rowFrequentistParadigm .

ex:cqStatisticsResultParadigmShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "result" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "paradigm" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowBayesianParadigm a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "result" ; gmeow:cellValueIri exf:bayesianResult ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "paradigm" ; gmeow:cellValueIri math:BayesianResult ] .

ex:rowFrequentistParadigm a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "result" ; gmeow:cellValueIri exf:frequentistResult ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "paradigm" ; gmeow:cellValueIri math:FrequentistResult ] .

# === SQ6 — which diagnostics, comparisons, and calibration results evaluate a fit === #

ex:cqStatisticsModelDiagnostics a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-model-diagnostics.rq" ;
    gmeow:cqDataFile "tests/fixtures/statistics-model-diagnostics.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A single math:FittedModel is evaluated by five first-class objects, each anchored to it through the shared math:diagnosticFor edge: a math:ModelDiagnostic, a math:CalibrationDiagnostic (the statistical calibration sense), an math:InformationCriterion, a math:CrossValidationResult, and a math:ModelComparison. Each evaluation is asserted with its OWN type only, so the reasoning-free query reads each on its own asserted-type UNION branch — a math:CalibrationDiagnostic does NOT also surface on the math:ModelDiagnostic branch — and every evaluation binds its own kind, the five edges never collapsed. Over the fixture the answer is exactly {aicScore → math:InformationCriterion; cvScore → math:CrossValidationResult; lrtComparison → math:ModelComparison; reliabilityDiagnostic → math:CalibrationDiagnostic; residualDiagnostic → math:ModelDiagnostic}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsModelDiagnosticsShape ;
    gmeow:cqExpectRow ex:rowAicScore , ex:rowCvScore , ex:rowLrtComparison , ex:rowReliabilityDiagnostic , ex:rowResidualDiagnostic .

ex:cqStatisticsModelDiagnosticsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "evaluation" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "kind" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowAicScore a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "evaluation" ; gmeow:cellValueIri exf:aicScore ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:InformationCriterion ] .

ex:rowCvScore a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "evaluation" ; gmeow:cellValueIri exf:cvScore ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:CrossValidationResult ] .

ex:rowLrtComparison a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "evaluation" ; gmeow:cellValueIri exf:lrtComparison ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:ModelComparison ] .

ex:rowReliabilityDiagnostic a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "evaluation" ; gmeow:cellValueIri exf:reliabilityDiagnostic ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:CalibrationDiagnostic ] .

ex:rowResidualDiagnostic a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "evaluation" ; gmeow:cellValueIri exf:residualDiagnostic ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "kind" ; gmeow:cellValueIri math:ModelDiagnostic ] .

# === SQ7 — result lineage: back to the estimand, forward to the held claim === #

ex:cqStatisticsResultLineage a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-result-lineage.rq" ;
    gmeow:cqDataFile "tests/fixtures/statistics-result-lineage.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:Estimate result object traces BACK to the math:Estimand it targets (math:estimatesEstimand), through its math:Estimator (math:estimator), its value quantity (math:estimateValue), and the math:InferenceRun process that produced it (gmeow:wasGeneratedBy); and FORWARD to the held claim — the gmeow:Observation that reports it (gmeow:observationResult) from a gmeow:vantage, itself generated by the same run — so the connected estimand → estimator → estimate → uncertainty → claim chain is walked without reasoning, the process, the result object, and the held observation kept strictly distinct. Over the fixture the answer is exactly {treatmentEffectEstimate → estimand averageTreatmentEffectEstimand, estimator olsEstimator, uncertainty treatmentEffectQuantity, run analysisRun, observation treatmentEffectObservation, vantage analysisPipelineCommitA1B2}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsResultLineageShape ;
    gmeow:cqExpectRow ex:rowResultLineage .

ex:cqStatisticsResultLineageShape a logic:ResultShape ;
