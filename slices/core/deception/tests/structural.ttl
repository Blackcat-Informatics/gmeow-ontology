# --- 26. MaximViolationType is a gufo:AbstractIndividualType value vocabulary
#        subclassing gufo:QualityValue (MUST) -----------------------------------
ex:saMaximViolationTypeClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:MaximViolationType a owl:Class , gufo:AbstractIndividualType ;
        rdfs:subClassOf gufo:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:MaximViolationType MUST be an owl:Class typed gufo:AbstractIndividualType and a subclass of gufo:QualityValue -- the four Gricean maxim violations are an open value vocabulary of individuals, not subclasses. Mirrors test_maxim_violation_values_exist (class structure part)." .

# --- 27. The four Gricean maxim violation seed individuals exist (MUST) -------
ex:saMaximViolationSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:maximViolationQuality   a gmeow:MaximViolationType .
    gmeow:maximViolationQuantity  a gmeow:MaximViolationType .
    gmeow:maximViolationRelation  a gmeow:MaximViolationType .
    gmeow:maximViolationManner    a gmeow:MaximViolationType .
}""" ;
    gmeow:saRationale "All four Gricean maxim violation seeds (quality, quantity, relation, manner) MUST exist as gmeow:MaximViolationType individuals -- they cover the full set of conversational maxims a deceptive event may breach. Mirrors test_maxim_violation_values_exist (individual seeds part)." .

