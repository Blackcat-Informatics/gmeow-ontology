+/// A wide label map on one individual exercises opposite-label lookup and
+/// saturation reads, independently of restriction descriptor preparation.
+fn bench_class_memberships(c: &mut Criterion) {
+    let mut group = c.benchmark_group("class_memberships");
+    group.sample_size(10);
+    for count in [250, 500, 1000] {
+        let mut builder = RdfDatasetBuilder::new();
+        builder
+            .push_owned_quad(
+                &RdfQuad::new(
+                    RdfTerm::iri("urn:labels:NotC"),
+                    "http://www.w3.org/2002/07/owl#complementOf",
+                    RdfTerm::iri("urn:labels:C"),
+                )
+                .in_graph(RdfTerm::iri(W)),
+            )
+            .unwrap();
+        for index in 0..count {
+            builder
+                .push_owned_quad(
+                    &RdfQuad::new(
+                        RdfTerm::iri("urn:labels:individual"),
+                        RDF_TYPE,
+                        RdfTerm::iri(format!("urn:labels:C{index}")),
+                    )
+                    .in_graph(RdfTerm::iri(W)),
+                )
+                .unwrap();
+        }
+        let store = builder.freeze().expect("synthetic memberships");
+        group.bench_function(format!("labels_{count}"), |b| {
+            b.iter(|| {
+                let input = prepare_reasoning_input(store.as_ref()).expect("label input");
+                let domains =
+                    SelectedDomains::new(input.source_contexts().iter().map(|(world, graph)| {
+                        SelectedLogicalWorld::new(
+                            LogicalGraph::from_graph(graph.clone()),
+                            DomainProfile::NonemptyObjectDomainV1,
+                            "gmeow.bench.class-memberships.v1".to_owned(),
+                            *blake3::hash(format!("{world}:labels:{count}").as_bytes()).as_bytes(),
+                        )
+                        .expect("label domain")
+                    }))
+                    .expect("label domains");
+                let ClassDiagnosticOutcome::Executed { execution } =
+                    class_diagnostic(input, &domains, None).expect("label diagnostic")
+                else {
+                    panic!("synthetic label source must be admitted")
+                };
+                let class = execution
+                    .classes
+                    .iter()
+                    .find(|class| class.world == W)
+                    .expect("class world");
+                assert_eq!(class.completion, NativeFamilyCompletion::Complete);
+                assert!(class.contextual_conflicts.is_empty());
+                assert!(class.obstructions.is_empty());
+                assert_eq!(
+                    execution
+                        .proofs
+                        .iter()
+                        .flat_map(|ledger| &ledger.proofs)
+                        .filter(|proof| proof.statement.subject.as_iri()
+                            == Some("urn:labels:individual")
+                            && proof.statement.predicate == RDF_TYPE
+                            && matches!(&proof.origin, NativeProofOrigin::Asserted { .. }))
+                        .count(),
+                    count
+                );
+                std::hint::black_box(execution)
+            });
+        });
+    }
+    group.finish();
+}
+
 criterion_group!(
     benches,
     bench_reason_all,
     bench_el_closure,
     bench_native_forward,
-    bench_class_evidence
+    bench_class_evidence,
+    bench_class_memberships
 );
 criterion_main!(benches);
