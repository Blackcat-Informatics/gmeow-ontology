@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix gsso: <http://purl.obolibrary.org/obo/GSSO_> .
@prefix homosaurus: <https://homosaurus.org/v4/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .

# Term equivalences for the sexuality domain — GMEOW authoring source.
# Compiled to mappings/gmeow-sexuality.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetSexuality a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-sexuality.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/sexuality" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Sexuality alignments — sexual-orientation values to Wikidata P91 value items, Homosaurus v4 and GSSO; the property to P91. EVERY external identifier was verified against the local authoritative copies (Homosaurus v4 + GSSO from /opt/foundation; Wikidata via API) — scraped IDs proved unreliable (e.g. the v3 numbers did not match). GMEOW applies the SPLIT-ATTRACTION model (sexual orientation and romantic orientation are separate axes); most external vocabularies do NOT distinguish them, so romantic orientation maps only where a distinct term is verified (Homosaurus 'Aromanticism') and is otherwise canonical. schema.org and FOAF have no orientation term — orientation is a documented lossy drop at the projection layer. The value vocab is OPEN; the reified, self-asserted, co-equal gmeow:IdentityFacet machinery is CANONICAL." .

gmeow:sexualOrientationValue skos:closeMatch wdt:P91 {|
    gmeow:sssomFile "gmeow-sexuality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'sexual orientation' property"
|} .

gmeow:orientHeterosexual skos:closeMatch wd:Q1035954 {|
    gmeow:sssomFile "gmeow-sexuality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Wikidata 'heterosexuality'"
|} .

