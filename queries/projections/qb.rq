# Projection: GMEOW → pure qb. GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: vantage, confidence, temporal scope, granularity, and determinacy are dropped in pure QB; only the measure type (function), observation value (scalar), and spatial context (observedFeature) are retained. Suppressed when displayable=false (Principle 10). The consumer's DSD may declare observedFeature as a dimension property.; bin geometry and aggregation metadata (vantage, confidence, granularity beyond the bin level) are dropped. Suppressed when displayable=false (Principle 10). The consumer's DSD may declare hasBin as a dimension property..
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX qb: <http://purl.org/linked-data/cube#>

CONSTRUCT {
    ?agg a qb:Observation .
    ?agg gmeow:observedFeature ?region .
    ?agg qb:measureType ?func .
    ?agg qb:obsValue ?val .
    ?agg gmeow:hasBin ?bin .
}
WHERE {
    {
        ?agg a gmeow:SpatialAggregation .
        ?agg gmeow:observedFeature ?region .
        ?agg gmeow:aggregationFunction ?func .
        ?agg gmeow:observationResult ?result .
        ?result gmeow:quantityValue ?val .
        FILTER NOT EXISTS { ?agg gmeow:displayable false . }
    }
    UNION {
        ?bin a gmeow:SpatialBin .
        ?agg gmeow:hasBin ?bin .
        ?agg gmeow:aggregationFunction ?func .
        ?agg gmeow:observationResult ?result .
        ?result gmeow:quantityValue ?val .
        FILTER NOT EXISTS { ?agg gmeow:displayable false . }
    }
}
