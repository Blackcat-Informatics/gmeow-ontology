            <term>Produit géométrique</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>几何积</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-2b08a869d83253e3">
