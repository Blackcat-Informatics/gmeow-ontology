        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Le plancher de score mesuré engagé, à hausse seule, pour l'axe de qualité axisProvenanceHonesty sur la slice math ; la barrière passe au rouge si le score mesuré de la slice descend sous ce plancher.</term>
          </tig>
        </langSet>
      </termEntry>
