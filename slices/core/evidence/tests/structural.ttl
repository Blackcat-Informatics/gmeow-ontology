    gmeow:saRationale "gmeow:CoverageDepth MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- the coverage depth value vocabulary (individuals; Principle 9)." .

# --- 11. CoverageDepth seed individuals exist (MUST) --------------------------
ex:saCoverageDepthSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
