@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix esco: <http://data.europa.eu/esco/model#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:eqClasses010 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Role ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject org:Role ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses011 a gmeow:TermEquivalence ;
    gmeow:alignSubject schema:OrganizationRole ;
    gmeow:alignPredicate rdfs:subClassOf ;
    gmeow:alignObject gmeow:Role ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses012 a gmeow:TermEquivalence ;
