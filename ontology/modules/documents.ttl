@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/documents>
    a owl:Ontology ;
    rdfs:label "GMEOW Documents Module"@en ;
    rdfs:comment "Creative works and document metadata — articles, patents, datasets, media, web pages (the schema.org / BIBO / BIBFRAME superset layer)."@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

gmeow:CreativeWork
    a owl:Class, gufo:Category ;
    rdfs:subClassOf gmeow:InformationObject ;
    rdfs:label "Creative Work"@en ;
    skos:definition "The abstract umbrella category for intellectual and artistic creations in the WEMI spine — a Work, Expression, Manifestation, or Item. Formerly a flat gufo:Kind (pre-#208); now a Category so that the four tiers with distinct identity criteria can each be a gufo:Kind beneath it."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Document
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Work ;
    rdfs:label "Document"@en ;
    skos:definition "A bounded textual or digital document — a file, record, or report. A specialization of gmeow:Work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Article
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Work ;
    rdfs:label "Article"@en ;
    skos:definition "A written work published in a periodical, blog, or scholarly venue. A specialization of gmeow:Work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Patent
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Work ;
    rdfs:label "Patent"@en ;
    skos:definition "A granted or filed patent describing an invention. A specialization of gmeow:Work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Dataset
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Work ;
    rdfs:label "Dataset"@en ;
    skos:definition "A collection of data published as a unit. A specialization of gmeow:Work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:MediaObject
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Manifestation ;
    rdfs:label "Media Object"@en ;
    skos:definition "An image, audio, or video media file — a concrete published artifact. A specialization of gmeow:Manifestation."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:WebPage
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Manifestation ;
    rdfs:label "Web Page"@en ;
    skos:definition "A page on the web identified by a URL — a concrete published artifact. A specialization of gmeow:Manifestation."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:BookRelease
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Manifestation ;
    rdfs:label "Book Release"@en ;
    skos:definition "A concrete published edition or release of a book — an out-of-universe information object and rights-bearing publication artifact. A specialization of gmeow:Manifestation. Distinct from the in-universe narrative frame it contributes to; linked via gmeow:sourceFor."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:SerialInstallment
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Manifestation ;
    rdfs:label "Serial Installment"@en ;
    skos:definition "A single issue, episode, or chapter of a serial creative work — a comic issue, TV episode, magazine issue, or serial chapter. An out-of-universe publication artifact distinct from the narrative frame it sources. A specialization of gmeow:Manifestation."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:CreativeWorkTitle
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Appellation ;
    rdfs:label "Creative Work Title"@en ;
    skos:definition "An appellation borne by a creative work — a document title, article headline, dataset name, or media title. Carries its own gmeow:nameLanguage and gmeow:nameScript so co-equal multilingual titles (e.g. 'The Matrix' / '黑客帝国') are separate first-class objects, never alternateName subordinates."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasTitle
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasAppellation ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range gmeow:CreativeWorkTitle ;
    rdfs:label "has title"@en ;
    skos:definition "Relates a creative work to a structured gmeow:CreativeWorkTitle it bears; the creative-work-scoped specialization of gmeow:hasAppellation. Non-functional — a work bears many co-equal titles (original, translated, transliterated, regional); none is primary, and superseded ones set gmeow:displayable false. The structured replacement for the flat gmeow:title literal when multilingual or statement-level metadata is needed."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:title
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range rdfs:Literal ;
    rdfs:label "title"@en ;
    skos:definition "The title of a creative work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:identifier
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range rdfs:Literal ;
    rdfs:label "identifier"@en ;
    skos:definition "A formal identifier of a creative work, such as a DOI or patent number."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:datePublished
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range xsd:dateTime ;
    rdfs:label "date published"@en ;
    skos:definition "The date a creative work was published or issued."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
