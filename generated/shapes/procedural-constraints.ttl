        sh:message "A ModelInferenceRun must declare exactly one pinned gmeow:modelRevision — a model name without a single pinned revision fails reproducibility (a hard fail)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/modelRevision> ?o . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ModelInferenceRunRevisionUniqueConstraintProceduralConstraintShape>
