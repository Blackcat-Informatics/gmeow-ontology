#
# Executable worked correspondence program.
#
# It contains both the §14 affine triangle and the blood-pressure path
# composition from docs/APPLIED_CATEGORY_THEORY. The latter is a pure forward
# relation plan: its certified path fusion does not claim that the bounded
# blood-pressure recovery fixture proves unrestricted stateful lens laws.
#
# foaf:Person (an agent) and schema:ContactPoint (a contact channel) co-project
# onto the contact-bearing facet of gmeow:contact — not peers, not subsets, not
# equivalent. The honest canonical object is a VAGUE AFFINE OVERLAP, so the
# alignment surface is skos:relatedMatch, NEVER skos:exactMatch / owl:equivalentClass.
#
# This file authors the projected-program SHAPE of that one correspondence cell in
# the canonical logic: vocabulary. The correspondence carrier lane parses it as a
# second, INDEPENDENT source (the PATH_SHAPES_EXAMPLE_PATH precedent) and reads it
# back with parse_correspondence — the honest dogfooded replacement for the former
# hardcoded Rust worked example. The two legs are leg-IRI-only (no gm:path body):
# the lawful put legs are derived by with_derived_puts() at compile time.
#
# The lane declares its SoundUnderApproximation preservation polarity in the loss
# ledger — a caveated overlap under-approximates the forced-equality reading it refuses.

@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/example/openehr/blood-pressure/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

logic:correspondence-program
    rdf:type logic:CorrespondenceProgram ;
    logic:hasPreservation logic:SoundUnderApproximation ;
    logic:hasCorrespondence
        <https://blackcatinformatics.ca/gmeow/example/gmeowContactCorrespondence> ,
        ex:rootToEvent ,
        ex:eventToItem ,
        ex:rootToItem ,
        ex:itemToValue ,
        ex:rootToValue ;
    logic:hasComposition ex:rootToItemComposition , ex:rootToValueComposition .

<https://blackcatinformatics.ca/gmeow/example/gmeowContactCorrespondence>
    rdf:type logic:Correspondence ;
    logic:correspondenceRelation logic:Overlaps ;
    logic:morphismClass logic:AffineCorrespondence ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:lossyDrop "This contact-facet overlap is projected as skos:relatedMatch; the alignment does not carry the complete agent/person versus contact-channel distinction or assert their equivalence."@x-gmeow-english ;
    logic:hasDeterminacy logic:Vague ;
    logic:getLeg <https://blackcatinformatics.ca/gmeow/example/foafPersonToGmeowContactFacet> ;
    logic:putLeg <https://blackcatinformatics.ca/gmeow/example/schemaContactPointToGmeowContactFacet> ;
    logic:confidence "0.72"^^xsd:decimal ;
    logic:hasLawClaim <https://blackcatinformatics.ca/gmeow/example/gmeowContactCorrespondence/law-claim/0> ;
    logic:hasCaveat <https://blackcatinformatics.ca/gmeow/example/gmeowContactCorrespondence/caveat> .

<https://blackcatinformatics.ca/gmeow/example/gmeowContactCorrespondence/law-claim/0>
    rdf:type logic:LawClaim ;
    logic:lawClaimed logic:GetPut ;
    logic:lawDischargeVerdict logic:ObligationUnknown .

<https://blackcatinformatics.ca/gmeow/example/gmeowContactCorrespondence/caveat>
    rdf:type logic:CorrespondenceCaveat ;
    rdfs:comment "foaf:Person denotes an agent/person; schema:ContactPoint denotes a contact channel/role. Both project through the contact-bearing facet of gmeow:contact; they are not equivalent and neither subsumes the other."@x-gmeow-english .

# Blood-pressure data-axis relation program. These endpoints are explicit
# source/view TYPES; the leg bodies are the real archetype path predicates from
# the bounded worked case. Every cell keeps the same template standpoint.
ex:rootToEvent
    rdf:type logic:Correspondence ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:lossyDrop "The endpoint relation alone does not carry the complete canonical quality, standpoint, provenance, RDF 1.2 statement metadata, or recovery complement."@x-gmeow-english ;
    logic:hasDeterminacy logic:Crisp ;
    logic:sourceEndpoint ex:CompositionRoot ;
    logic:targetEndpoint ex:PointEvent ;
    logic:getLeg ex:rootToEventGet ;
    gmeow:accordingTo ex:BlutdruckTemplate .

ex:eventToItem
    rdf:type logic:Correspondence ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:lossyDrop "The at0004 path focus identifies the systolic item but does not carry the complete persistent-quality complement."@x-gmeow-english ;
    logic:hasDeterminacy logic:Crisp ;
    logic:sourceEndpoint ex:PointEvent ;
    logic:targetEndpoint ex:SystolicItem ;
    logic:getLeg ex:eventToItemGet ;
    gmeow:accordingTo ex:BlutdruckTemplate .

ex:rootToItem
    rdf:type logic:Correspondence ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:lossyDrop "The composed root-to-item endpoint relation retains its middle event witness in execution but not the complete source carrier."@x-gmeow-english ;
    logic:hasDeterminacy logic:Crisp ;
    logic:sourceEndpoint ex:CompositionRoot ;
    logic:targetEndpoint ex:SystolicItem ;
    logic:getLeg ex:rootToItemGet ;
    gmeow:accordingTo ex:BlutdruckTemplate .

ex:itemToValue
    rdf:type logic:Correspondence ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:lossyDrop "The RM value endpoint does not carry the canonical unit-independent true quantity, frame, or observation metadata without its complement."@x-gmeow-english ;
    logic:hasDeterminacy logic:Crisp ;
    logic:sourceEndpoint ex:SystolicItem ;
    logic:targetEndpoint ex:QuantityValue ;
    logic:getLeg ex:itemToValueGet ;
    gmeow:accordingTo ex:BlutdruckTemplate .

ex:rootToValue
    rdf:type logic:Correspondence ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:SoundUnderApproximation ;
    logic:lossyDrop "The complete composed endpoint relation is a forward read plan; it does not replace the separately admitted source, edited-view, prior-state, and complement law domains."@x-gmeow-english ;
    logic:hasDeterminacy logic:Crisp ;
    logic:sourceEndpoint ex:CompositionRoot ;
    logic:targetEndpoint ex:QuantityValue ;
    logic:getLeg ex:rootToValueGet ;
    gmeow:accordingTo ex:BlutdruckTemplate .

ex:rootToItemComposition
    rdf:type logic:CorrespondenceComposition ;
    logic:compositionFirst ex:rootToEvent ;
    logic:compositionSecond ex:eventToItem ;
    logic:compositionResult ex:rootToItem .

ex:rootToValueComposition
    rdf:type logic:CorrespondenceComposition ;
    logic:compositionFirst ex:rootToItem ;
    logic:compositionSecond ex:itemToValue ;
    logic:compositionResult ex:rootToValue .

ex:rootToEventGet gmeow:path ex:rmEvents .
ex:eventToItemGet gmeow:path ex:rmItemsAt0004 .
ex:itemToValueGet gmeow:path ex:rmValue .

ex:rootToItemGet gmeow:path ex:rootToItemPath .
ex:rootToItemPath
    rdf:type gmeow:SeqPath ;
    gmeow:pathSteps ex:rootToItemStep1 .
ex:rootToItemStep1
    gmeow:pathItem ex:rmEvents ;
    gmeow:pathNext ex:rootToItemStep2 .
ex:rootToItemStep2 gmeow:pathItem ex:rmItemsAt0004 .

ex:rootToValueGet gmeow:path ex:rootToValuePath .
ex:rootToValuePath
    rdf:type gmeow:SeqPath ;
    gmeow:pathSteps ex:rootToValueStep1 .
ex:rootToValueStep1
    gmeow:pathItem ex:rmEvents ;
    gmeow:pathNext ex:rootToValueStep2 .
ex:rootToValueStep2
    gmeow:pathItem ex:rmItemsAt0004 ;
    gmeow:pathNext ex:rootToValueStep3 .
ex:rootToValueStep3 gmeow:pathItem ex:rmValue .

ex:BlutdruckTemplate rdf:type logic:Standpoint .
