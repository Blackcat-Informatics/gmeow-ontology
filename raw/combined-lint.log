+        crate::native_semantics::SemanticVocabulary::GroundedLogicV1,
+        Ladder::Complete,
+    );
+    assert!(
+        !admission.admits_native(),
+        "data-valued marker spellings are distinct: {admission:?}"
+    );
+    assert!(
+        !ChaseAdmission::certify_with_properties(
+            &rules,
+            &[],
+            crate::native_semantics::SemanticVocabulary::GroundedLogicV1,
+        )
+        .admits_native()
+    );
+}
