# --- Geometry/topology classes → Lean mathlib (structural, by reference) --- #
#
# mathlib4 is Apache-2.0 but not RDF-projectable, so a mathlib declaration is a
# related resource, not an invertible identity (skos:relatedMatch). URLs
# curl-validated HTTP 200.

gmeow:eqMathManifoldMathlib a gmeow:TermEquivalence ;
    gmeow:alignSubject math:Manifold ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://leanprover-community.github.io/mathlib4_docs/Mathlib/Geometry/Manifold/IsManifold/Basic.html> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "Mathlib.Geometry.Manifold.IsManifold" ;
    gmeow:comment "math:Manifold is formalized by mathlib's IsManifold in Geometry.Manifold. Structural formalization by reference, so skos:relatedMatch; curl-validated HTTP 200." ;
