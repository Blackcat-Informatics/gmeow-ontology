@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .

gmeow:Community
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "Community"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "A graph-clustering community (Leiden or similar) over extracted-entity descriptions, at a level (gmeow:communityLevel) of the cluster hierarchy. The clustering run is provenance via the EXISTING gmeow:wasGeneratedBy."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:CommunitySummary
    a logic:SubKind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "Community Summary"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Summary ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:summarizesCommunity ;
            logic:someValuesFrom gmeow:Community ;
        ] ;
    skos:definition "A pre-generated summary of a community — GraphRAG's global-question substrate, gmeow:wasDerivedFrom the community's members and chunks and gmeow:wasGeneratedBy its generating invocation (EXISTING provenance), hence revisable rather than a black box."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Corpus
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "Corpus"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "An indexed collection of source information objects over which retrieval operates — the working document set behind a pipeline, distinct from the documents slice's bibliographic gmeow:Collection (a Work). Members via gmeow:corpusMember; content-addressable via the EXISTING gmeow:contentDigest, so an index can prove WHAT it indexed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ExtractedEntity
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "Extracted Entity"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "A model-extracted entity DESCRIPTION — an information object about a putative entity, derived from source chunks. Deliberately NOT the entity itself: promotion to a first-class gmeow:Entity (with coreference by reference, never OWL sameAs — P5) is a separate, attributable curation act."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ExtractedRelationship
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "Extracted Relationship"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:relationshipSource ;
            logic:someValuesFrom gmeow:ExtractedEntity ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:relationshipTarget ;
            logic:someValuesFrom gmeow:ExtractedEntity ;
        ] ;
    skos:definition "A model-extracted relationship description between extracted-entity descriptions — the GraphRAG edge as a revisable, attributed artifact rather than a black-box triple."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:IndexAlgorithm
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "Index Algorithm"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "An open value vocabulary of vector-index structures."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:communityLevel
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:Community ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "community level"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The hierarchy level of this community (0 = leaf clustering)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:communityMember
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Community ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "community member"@x-gmeow-english ;
    rdfs:range gmeow:ExtractedEntity ;
    rdfs:subPropertyOf gmeow:hasPart ;
    skos:definition "An extracted-entity description this community clusters."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:corpusMember
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Corpus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "corpus member"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    rdfs:subPropertyOf gmeow:hasPart ;
    skos:definition "Relates a corpus to a source information object it collects. Non-functional: a source may belong to many corpora."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:forQuery
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:RetrievalEvent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "for query"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The query text this retrieval served, recorded verbatim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:indexAlgorithm
    a logic:ObjectProperty ;
    rdfs:domain gmeow:VectorIndex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "index algorithm"@x-gmeow-english ;
    rdfs:range gmeow:IndexAlgorithm ;
    skos:definition "The approximate-nearest-neighbour structure this index uses (open vocabulary). It is not the index itself and never its parameters — those are gmeow:indexParameters."@x-gmeow-english ;
    gmeow:useWhen "Use to record which algorithm built a vector index."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring it from the parameters or omitting it on a rebuilt index."@x-gmeow-english ;
    gmeow:howToUse "Attach one gmeow:IndexAlgorithm value to the index; it is functional."@x-gmeow-english ;
    skos:example "gmeow:index1 gmeow:indexAlgorithm gmeow:indexAlgorithmHnsw ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:indexAlgorithmFlat
    a gmeow:IndexAlgorithm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "flat"@x-gmeow-english ;
    skos:definition "Exhaustive (brute-force) scan — exact, no approximation structure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:indexAlgorithmHnsw
    a gmeow:IndexAlgorithm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "HNSW"@x-gmeow-english ;
    skos:definition "Hierarchical Navigable Small World graph index."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:indexAlgorithmIvf
    a gmeow:IndexAlgorithm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "IVF"@x-gmeow-english ;
    skos:definition "Inverted-file (coarse-quantizer) index."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:indexParameters
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:VectorIndex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "index parameters"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The build parameters (efConstruction, nlist, M, ...) recorded verbatim as a JSON object string — reproducibility provenance; their semantics stay in the solver layer (P12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:indexesCorpus
    a logic:ObjectProperty ;
    rdfs:domain gmeow:VectorIndex ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "indexes corpus"@x-gmeow-english ;
    rdfs:range gmeow:Corpus ;
    skos:definition "The corpus whose embeddings this index serves. Non-functional: a federated index may span corpora."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:relationshipSource
    a logic:ObjectProperty ;
    rdfs:domain gmeow:ExtractedRelationship ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "relationship source"@x-gmeow-english ;
    rdfs:range gmeow:ExtractedEntity ;
    skos:definition "The extracted-entity description at the tail of this extracted relationship. It is not the target, and never the relationship record itself."@x-gmeow-english ;
    gmeow:useWhen "Use to name the entity an extracted relationship points FROM."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid swapping it with gmeow:relationshipTarget on a symmetric-looking relation — direction is asserted, not inferred."@x-gmeow-english ;
    gmeow:howToUse "Attach exactly one gmeow:ExtractedEntity as the tail of the relationship; it is functional."@x-gmeow-english ;
    skos:example "gmeow:rel1 gmeow:relationshipSource gmeow:entity1 ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

gmeow:relationshipTarget
    a logic:ObjectProperty ;
    rdfs:domain gmeow:ExtractedRelationship ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "relationship target"@x-gmeow-english ;
    rdfs:range gmeow:ExtractedEntity ;
    skos:definition "The extracted-entity description at the head of this extracted relationship. It is not the source, and never the relationship record itself."@x-gmeow-english ;
    gmeow:useWhen "Use to name the entity an extracted relationship points TO."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid swapping it with gmeow:relationshipSource — direction is asserted, not inferred."@x-gmeow-english ;
    gmeow:howToUse "Attach exactly one gmeow:ExtractedEntity as the head of the relationship; it is functional."@x-gmeow-english ;
    skos:example "gmeow:rel1 gmeow:relationshipTarget gmeow:entity2 ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:retrievalScore
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "retrieval score"@x-gmeow-english ;
    skos:definition "Statement-level annotation: the relevance score a retrieval (or re-ranker) assigned to ONE retrievedChunk triple. An annotation property so competing scores coexist attributed (P9) and the OWL downcast stays DL-clean (P3)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:retrievedChunk
    a logic:ObjectProperty ;
    rdfs:domain gmeow:RetrievalEvent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "retrieved chunk"@x-gmeow-english ;
    rdfs:range gmeow:Chunk ;
    skos:definition "A chunk this retrieval returned. Score, rank, and re-ranker attribution ride RDF 1.2 statement annotations on each retrievedChunk triple (gmeow:retrievalScore + the existing provenance annotations)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:summarizesCommunity
    a logic:ObjectProperty ;
    rdfs:domain gmeow:CommunitySummary ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "summarizes community"@x-gmeow-english ;
    rdfs:range gmeow:Community ;
    skos:definition "The community this summary condenses. It is not the summary text and never a second community for one summary."@x-gmeow-english ;
    gmeow:useWhen "Use to say which community a summary condenses."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing one summary at several communities — that is several summaries."@x-gmeow-english ;
    gmeow:howToUse "Attach exactly one gmeow:Community; it is functional."@x-gmeow-english ;
    skos:example "gmeow:summary1 gmeow:summarizesCommunity gmeow:community1 ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:vectorRef
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:Embedding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "vector ref"@x-gmeow-english ;
    rdfs:range xsd:anyURI ;
    skos:definition "A dereferenceable locator for the vector payload (an object-store key, an index slot). The vector lives outside the graph by reference (P12); the graph holds the audit trail, not the floats."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

<https://blackcatinformatics.ca/gmeow/slices/graphrag>
    a logic:Ontology ;
    rdfs:comment "Per-result epistemics (a retrieval's score for ONE chunk) ride RDF 1.2 statement annotations on the gmeow:retrievedChunk triple (gmeow:retrievalScore) — competing re-ranker scores coexist attributed, never overwritten (P9, P3)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "GMEOW GraphRAG Module"@x-gmeow-english ;
    skos:definition "Pipeline observability for retrieval-augmented and GraphRAG systems (GraphRAG provenance design facets A/B/F): the corpus and derived entity-graph artifacts (extracted entities/relationships, communities, community summaries), plus the graphrag-specific corpus/index/retrieval wiring (gmeow:Corpus, gmeow:indexAlgorithm/gmeow:indexParameters/gmeow:indexesCorpus, gmeow:retrievedChunk/gmeow:retrievalScore/gmeow:forQuery) — every artifact content-addressed, every step an attributed activity, so the derived graph is AUDITABLE and revisable rather than a black box (GraphRAG, arXiv:2404.16130). The generic vector/embedding primitives (gmeow:Embedding, gmeow:VectorIndex, gmeow:DistanceMetric, gmeow:RetrievalEvent, and their properties) are CORE-tier infrastructure owned by the ai slice (any embedding consumer needs them, not only GraphRAG) and reused here via the EXISTING gmeow:sliceDependsOn ai edge. Claims extracted by the pipeline are the CORE ai slice's business (a StandpointClaim with model vantage); this extension carries the graphrag-specific machinery around them. Vector payloads stay outside the graph by reference (P12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Declarative constraint axioms (extension slices) — the closed-
# world cardinality obligations the hand-authored shapes.ttl NodeShapes state
# (gmeow:ExtractedRelationshipEndsShape), authored here once as OWL restriction
# axioms and PROJECTED to generated/shapes/validation-shapes.ttl by
# derive_validation_shapes (Principle 17). exact-one -> OWL maxQualifiedCardinality 1
# (onClass OWL Thing) -> sh:minCount 1 + sh:maxCount 1. The Embedding/RetrievalEvent
# cardinality axioms (gmeow:EmbeddingProvenanceShape, gmeow:RetrievalEventShape)
# migrated to the ai slice's module.ttl alongside the classes they constrain.
# =========================================================================== #

gmeow:ExtractedRelationship rdfs:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:relationshipSource ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:relationshipTarget ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .

# exact-one minCount restoration (issue #1194): min-qualified sibling restrictions
# restoring sh:minCount for the reasoner-safe max-qualified exact-one antecedents.
<https://blackcatinformatics.ca/gmeow/ExtractedRelationship> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/relationshipSource> ; logic:minQualifiedCardinality "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; logic:onClass logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/ExtractedRelationship> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/relationshipTarget> ; logic:minQualifiedCardinality "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; logic:onClass logic:Thing ] .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects OWL FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:indexAlgorithmFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "indexAlgorithm is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:indexAlgorithm is functional: a vector index is built with exactly one approximate-nearest-neighbour structure, a single build-time commitment fixing how that index is searched. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:indexAlgorithm ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:indexAlgorithm ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:indexAlgorithm names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:indexAlgorithm, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:indexAlgorithm and nothing else. It is not a definition of gmeow:indexAlgorithm (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:indexAlgorithmFunctionality logic:characterizes gmeow:indexAlgorithm ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:relationshipSourceFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "relationshipSource is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:relationshipSource is functional: an extracted relationship has exactly one entity description at its tail, the single source endpoint of the directed edge. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:relationshipSource ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:relationshipSource ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:relationshipSource names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:relationshipSource, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:relationshipSource and nothing else. It is not a definition of gmeow:relationshipSource (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:relationshipSourceFunctionality logic:characterizes gmeow:relationshipSource ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:relationshipTargetFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "relationshipTarget is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:relationshipTarget is functional: an extracted relationship has exactly one entity description at its head, the single target endpoint of the directed edge. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:relationshipTarget ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:relationshipTarget ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:relationshipTarget names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:relationshipTarget, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:relationshipTarget and nothing else. It is not a definition of gmeow:relationshipTarget (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:relationshipTargetFunctionality logic:characterizes gmeow:relationshipTarget ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:summarizesCommunityFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/graphrag> ;
    rdfs:label "summarizesCommunity is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:summarizesCommunity is functional: a community summary condenses exactly one community, the single cluster whose members and chunks the summary was generated from. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:summarizesCommunity ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:summarizesCommunity ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:summarizesCommunity names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:summarizesCommunity, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:summarizesCommunity and nothing else. It is not a definition of gmeow:summarizesCommunity (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:summarizesCommunityFunctionality logic:characterizes gmeow:summarizesCommunity ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
