rule" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:reifiedStatementSubject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "text" ] ] , [ a logic:Formula ; logic:relation logic:reifiedStatementPredicate ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:wasDerivedFrom ] ] , [ a logic:Formula ; logic:relation logic:reifiedStatementObject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "outside" ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "text" ] , [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "outside" ] , [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] , [ a logic:Formula ; logic:relation gmeow:accordingTo ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "reader" ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "reader" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Entity ] ] , [ a logic:Formula ; logic:relation gmeow:standpointModalForce ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:modalForcePossible ] ] , [ a logic:Formula ; logic:relation gmeow:restatementRun ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "run" ] ] , [ a logic:Formula ; logic:relation gmeow:restatementShare ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "share" ] ] , [ a logic:Formula ; logic:relation gmeow:restatementReceivedAt ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "received" ] ] , [ a logic:Formula ; logic:relation gmeow:restatementReceiptBasis ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "basis" ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "basis" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ReceiptBasis ] ] , [ a logic:Formula ; logic:relation gmeow:restatementRuleVersion ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "digest" ] ] , [ a logic:Formula ; logic:relation gmeow:wasDerivedFrom ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "rule" ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "rule" ] , [ logic:termIndex 1 ; logic:termIri gmeow:RestatementRule ] ] , [ a logic:Formula ; logic:relation gmeow:contentDigest ; logic:argument [ logic:termIndex 0 ; logic:termVariable "rule" ] , [ logic:termIndex 1 ; logic:termVariable "digest" ] ] ] ] , [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "absentValue" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:confidence ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "absentValue" ] ] ] ] , [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "absentValue" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:standpointCredence ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "absentValue" ] ] ] ] ] ] ] ] ] .

gmeow:EchoAnnotationContractConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Echo annotation contract constraint"@x-gmeow-english ;
    skos:definition "Every supplied echo measure binds to its own echoesPremiseOf reifier, original answer, concrete Prompt, reader and complete run/share pair."@x-gmeow-english ;
    gmeow:useWhen "Use to check the declared binding or numeric boundary on its own supplied reading record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this intrinsic law as an executed reader, authenticated receipt or digest verification."@x-gmeow-english ;
    gmeow:howToUse "Retain actual source values and evaluate the canonical law in the selected interpretation."@x-gmeow-english ;
    skos:scopeNote "Ranking measures remain independent of confidence and source truth. Completed statement-component lowering supplies the retained binding evidence."@x-gmeow-english ;
    skos:example "gmeow:EchoAnnotationContractConstraint logic:formalizes gmeow:echoRun ."@x-gmeow-english ;
    logic:formalizes gmeow:echoRun ; logic:message "Every supplied echo measure binds to its own echoesPremiseOf reifier, original answer, concrete Prompt, reader and complete run/share pair."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri rdf:Statement ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "field" ] , [ logic:termIndex 1 ; logic:termVariable "supplied" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri rdf:Statement ] ] , [ a logic:Formula ; logic:relation logic:linkVia ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "field" ] , [ logic:termIndex 2 ; logic:termVariable "supplied" ] ] , [ a logic:Formula ; logic:relation logic:termIn ; logic:argument [ logic:termIndex 0 ; logic:termVariable "field" ] , [ logic:termIndex 1 ; logic:termIri gmeow:echoRun ] , [ logic:termIndex 2 ; logic:termIri gmeow:echoShare ] ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "answer" ] , [ logic:termIndex 1 ; logic:termVariable "prompt" ] , [ logic:termIndex 2 ; logic:termVariable "reader" ] , [ logic:termIndex 3 ; logic:termVariable "run" ] , [ logic:termIndex 4 ; logic:termVariable "share" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:reifiedStatementSubject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "answer" ] ] , [ a logic:Formula ; logic:relation logic:reifiedStatementPredicate ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:echoesPremiseOf ] ] , [ a logic:Formula ; logic:relation logic:reifiedStatementObject ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "prompt" ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "answer" ] , [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "prompt" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Prompt ] ] , [ a logic:Formula ; logic:relation gmeow:accordingTo ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "reader" ] ] , [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "reader" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Entity ] ] , [ a logic:Formula ; logic:relation gmeow:echoRun ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "run" ] ] , [ a logic:Formula ; logic:relation gmeow:echoShare ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "share" ] ] ] ] ] ] ] ] .

gmeow:RestatementShareRangeConstraint
    a logic:ValueRangeConstraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "restatement share range constraint"@x-gmeow-english ;
    skos:definition "Every supplied restatementShare is strictly greater than zero and at most one."@x-gmeow-english ;
    gmeow:useWhen "Use to check the declared binding or numeric boundary on its own supplied reading record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this intrinsic law as an executed reader, authenticated receipt or digest verification."@x-gmeow-english ;
    gmeow:howToUse "Retain actual source values and evaluate the canonical law in the selected interpretation."@x-gmeow-english ;
    skos:scopeNote "The separate decimal restriction supplies datatype admission; this law checks numeric bounds without calculating a measurement."@x-gmeow-english ;
    skos:example "gmeow:RestatementShareRangeConstraint logic:formalizes gmeow:restatementShare ."@x-gmeow-english ;
    logic:formalizes gmeow:restatementShare ; logic:message "Every supplied restatementShare is strictly greater than zero and at most one."@x-gmeow-english ;
    logic:onClass rdf:Statement ; logic:valuePath gmeow:restatementShare ; logic:minExclusiveBound 0 ; logic:maxInclusiveBound 1 .

