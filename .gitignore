# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.cache/
*.egg-info/
.coverage
htmlcov/

# Ephemeral build products (published on release, never committed).
# Committed generated artifacts live under generated/ (#287) — one root,
# every path owned by a registered generator.
# ontology-docs/ is on-demand `extract-docs`/`make docs-gen` output rendered
# from the rust-first gmeow_native.docs renderer; it is never committed (#853).
/dist/
/dist/i18n/
/dist/ontology-docs/
/ontology-docs/
/docs/_generated/
/llms.txt

# Stamp files (compilation freshness tracking)
.stamps/

# gmeow-pipeline content-addressed stage cache (#861): self-verifying, rebuilt
# on demand, never committed (supersedes .stamps/ at the #861 cutover).
generated/.pipeline-cache/

# Editor/OS noise
.DS_Store
*.swp
.antigravitycli
.codex
.claude
.worktrees/

# Toolchain temp directories (hard-kill leftovers)
.gmeow-tmp-*/

# Rust build artifacts
/target/

# Repository Cargo config is source, not build output.
!/.cargo/
!/.cargo/config.toml

# Release signing secrets (public keys live under keys/ and ARE committed).
keys/*.secret.asc
keys/*.secret
keys/*.tmp

# maturin editable-install artifacts (the compiled extension is built, never
# committed). The five extensions now fold into the single gmeow_native cdylib
# (#630); only its build artifacts land in the python package dir.
crates/native/python/gmeow_native/*.so
crates/native/python/gmeow_native/*.pyd
.worktree
.goals
.baseline
lcov.info
mutants.out*/
bench-results.json
/pipeline/
