@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix obscore: <http://www.ivoa.net/rdf/ObsCore#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/ivoa> a align:Alignment ;
    rdfs:label "GMEOW → ivoa (EDOAL)"@x-gmeow-english ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "Sensor (telescope) → obscore:facility"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:vantage ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri obscore:facility ] ;
            align:relation "<=" ;
            edoal:measure 7.5e-01 ],
        [ a align:Cell ;
            rdfs:label "Sensor (instrument) → obscore:instrument"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:vantage ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri obscore:instrument ] ;
            align:relation "<=" ;
            edoal:measure 7.5e-01 ],
        [ a align:Cell ;
            rdfs:label "SensoryObservation → obscore:ObsDataset"@x-gmeow-english ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:SensoryObservation ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri obscore:ObsDataset ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "ScalarQuantity → obscore:observable"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:observationResult ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri obscore:observable ] ;
            align:relation "<=" ;
            edoal:measure 7e-01 ],
        [ a align:Cell ;
            rdfs:label "hasReferenceFrame → obscore:coordsys"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasReferenceFrame ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri obscore:coordsys ] ;
            align:relation "<=" ;
            edoal:measure 7e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "ivoa" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@x-gmeow-english .
