ex:cqOperationOutcomes a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX logic: <https://blackcatinformatics.ca/logic/> SELECT ?term WHERE { ?term a logic:OperationOutcome } ORDER BY ?term" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Six outcomes, and the distinction that earns the roster is between invalid, unsupported and engine failure: the first blames the request, the second blames the fragment the engine was asked to handle, and the third blames the engine. A single error outcome routes all three to the same place, which is how an unsupported-construct report gets triaged as a bug in the caller. Incomplete and requires-full-rebuild are likewise not failures at all — they are results that name their own remedy." ;
    gmeow:cqResultShape ex:cqKernelRosterShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:cqOperationOutcomesRowOutcomeApplied , ex:cqOperationOutcomesRowOutcomeEngineFailure , ex:cqOperationOutcomesRowOutcomeIncomplete , ex:cqOperationOutcomesRowOutcomeInvalid , ex:cqOperationOutcomesRowOutcomeRequiresFullRebuild , ex:cqOperationOutcomesRowOutcomeUnsupportedFragment  .

ex:cqOperationOutcomesRowOutcomeApplied a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:OutcomeApplied ] .
ex:cqOperationOutcomesRowOutcomeEngineFailure a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:OutcomeEngineFailure ] .
ex:cqOperationOutcomesRowOutcomeIncomplete a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:OutcomeIncomplete ] .
ex:cqOperationOutcomesRowOutcomeInvalid a gmeow:ExpectedRow ;
