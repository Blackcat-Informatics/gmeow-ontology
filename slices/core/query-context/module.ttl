gmeow:MeetUsableFrameLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "usable meet frame law"@x-gmeow-english ;
    skos:definition "An exposed meet frame is the same complete syntax frame represented by a realized nonempty result in a complete interpretation with a complete operand inventory."@x-gmeow-english ;
    gmeow:useWhen "Use to require all supplied evidence before usable-result exposure."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid exposing a different frame, an empty result or a partial description as usable."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact represented frame, shared interpretation, complete inventories, realization assertion and at least one result member."@x-gmeow-english ;
    skos:scopeNote "No law manufactures the witness, certifies the source assertions or promotes a restriction into global truth or actuality."@x-gmeow-english ;
