    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this <https://blackcatinformatics.ca/gmeow/authorityLink> ?auth . }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "An authority link should also assert skos:exactMatch or skos:closeMatch to record coreference strength." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/authorityLink> ?auth . FILTER NOT EXISTS { $this <http://www.w3.org/2004/02/skos/core#exactMatch> ?auth . } FILTER NOT EXISTS { $this <http://www.w3.org/2004/02/skos/core#closeMatch> ?auth . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/BranchHasOutgoingFlowsConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/BranchHasOutgoingFlowsShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ProcedureStep> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ProcedureStep of type stepTypeBranch must be the source of at least two ControlFlow relators." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/procedureStepType> <https://blackcatinformatics.ca/gmeow/stepTypeBranch> . FILTER NOT EXISTS { ?flow1 a <https://blackcatinformatics.ca/gmeow/ControlFlow> . ?flow1 <https://blackcatinformatics.ca/gmeow/flowSource> $this . ?flow2 a <https://blackcatinformatics.ca/gmeow/ControlFlow> . ?flow2 <https://blackcatinformatics.ca/gmeow/flowSource> $this . FILTER ( ?flow1 != ?flow2 ) } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CancelledInvoiceSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CancelledInvoiceSuppressionShape> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Invoice> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Invoice> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A cancelled invoice should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/invoiceStatus> <https://blackcatinformatics.ca/gmeow/invoiceStatusCancelled> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CancelledOccurrenceSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CancelledOccurrenceSuppressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Event> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A cancelled occurrence (one with a ScheduleException of type exceptionTypeCancellation) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { ?exception <https://blackcatinformatics.ca/gmeow/exceptionType> <https://blackcatinformatics.ca/gmeow/exceptionTypeCancellation> . ?exception <https://blackcatinformatics.ca/gmeow/exceptionSchedule> ?schedule . ?exception <https://blackcatinformatics.ca/gmeow/exceptionOriginalDate> ?date . ?schedule <https://blackcatinformatics.ca/gmeow/scheduleOccurrence> $this . $this <https://blackcatinformatics.ca/gmeow/eventTime> ?date . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CancelledOrderSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CancelledOrderSuppressionShape> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Order> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Order> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A cancelled order should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/orderStatus> <https://blackcatinformatics.ca/gmeow/orderStatusCancelled> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CapabilityGapFragmentClassificationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/isReasonerFragmentGap> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE {
    ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://blackcatinformatics.ca/gmeow/CapabilityGap> .
}""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:CapabilityGap must reference via gmeow:gapShape a gmeow:GapShape carrying a gmeow:isReasonerFragmentGap boolean value — the reasoner-fragment classification consumed by this integrity guard is missing." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/gapShape> ?gs . ?gs <https://blackcatinformatics.ca/gmeow/isReasonerFragmentGap> ?frag . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CascadeSeverityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Cascade> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Cascade> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Cascade must carry exactly one gmeow:cascadeSeverity (an IRI) — an ungraded cascade is just a story." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/cascadeSeverity> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CausalLinkModalityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CausalLink> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/CausalLink> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A CausalLink must state exactly one gmeow:causalModality (an IRI — the vocabulary is OPEN per Principle 9): if you reified, you had a reason." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/causalModality> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CharacterArcSubjectConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CharacterArcShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/CharacterArc> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A CharacterArc must have exactly one gmeow:arcSubject." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/arcSubject> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CharacterArcTypeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CharacterArcShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/CharacterArc> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A CharacterArc must have exactly one gmeow:arcType." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/arcType> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ClaimCredenceBandConsistencyConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CredenceBandConsistencyShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/claimCredenceLevel> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Credence band and decimal are inconsistent: the decimal must fall within the band's canonical range (credencePossible [0,0.5), credenceLikely [0.5,0.9), credenceCertain [0.9,1.0]) and credenceUnspecified must carry no decimal at all." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/claimCredenceLevel> ?bg . $this <https://blackcatinformatics.ca/gmeow/claimCredenceLevel> ?band . $this <https://blackcatinformatics.ca/gmeow/claimCredence> ?dec . FILTER ( ( ( ?band = <https://blackcatinformatics.ca/gmeow/credenceCertain> ) && ( ?dec < '0.9'^^<http://www.w3.org/2001/XMLSchema#decimal> ) ) || ( ( ?band = <https://blackcatinformatics.ca/gmeow/credenceLikely> ) && ( ( ?dec < '0.5'^^<http://www.w3.org/2001/XMLSchema#decimal> ) || ( ?dec >= '0.9'^^<http://www.w3.org/2001/XMLSchema#decimal> ) ) ) || ( ( ?band = <https://blackcatinformatics.ca/gmeow/credencePossible> ) && ( ( ?dec < '0.0'^^<http://www.w3.org/2001/XMLSchema#decimal> ) || ( ?dec >= '0.5'^^<http://www.w3.org/2001/XMLSchema#decimal> ) ) ) || ( ?band = <https://blackcatinformatics.ca/gmeow/credenceUnspecified> ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ClaimCredenceLowerBoundConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ClaimCredenceRangeShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/claimCredence> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "gmeow:claimCredence must be an xsd:decimal in [0.0, 1.0] — a credence value outside this range is malformed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/claimCredence> ?v . FILTER ( ?v < '0.0'^^<http://www.w3.org/2001/XMLSchema#decimal> ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ClaimCredenceUpperBoundConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ClaimCredenceRangeShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/claimCredence> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "gmeow:claimCredence must be an xsd:decimal in [0.0, 1.0] — a credence value outside this range is malformed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/claimCredence> ?v . FILTER ( ?v > '1.0'^^<http://www.w3.org/2001/XMLSchema#decimal> ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CoarsenToReachabilityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CoarsenToShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/coarsenTo> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A gmeow:coarsenTo target level is not reachable: no gmeow:containedInPlace+ ancestor carries a matching gmeow:hasGranularity, so the value would be suppressed with no coarser replacement." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/coarsenTo> ?lvl . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/containedInPlace>+ ?ancestor . ?ancestor <https://blackcatinformatics.ca/gmeow/hasGranularity> ?lvl . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CommentParentSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/RetractedNoteSuppressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Comment> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A comment whose parent is suppressed should set gmeow:displayable false (Principle 10)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/commentParent> ?parent . ?parent <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CompetesWithIrreflexiveConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CompetesWithShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/competesWith> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A claim must not gmeow:competesWith itself — competition between rival hypotheses is irreflexive." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/competesWith> ?o . $this <https://blackcatinformatics.ca/gmeow/competesWith> $this . }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CompilationContextConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ComplexCompilation> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/gmeow/CompilationMissingContext> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ComplexCompilation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:ComplexCompilation must carry a gmeow:compilationStandpoint, a gmeow:compilationWorld, and a gmeow:compilationTimeScope; a compilation missing any of the three has no epistemic context (gmeow:CompilationMissingContext)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/compilationStandpoint> ?s . $this <https://blackcatinformatics.ca/gmeow/compilationWorld> ?w . $this <https://blackcatinformatics.ca/gmeow/compilationTimeScope> ?t . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CompilationMustRecordCorrespondenceProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ComplexCompilation> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ComplexCompilation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:ComplexCompilation must record a gmeow:CellSourceCorrespondence through gmeow:recordsCorrespondence that carries at least one genuine row (a gmeow:correspondenceCell naming a math:Cell that itself carries a gmeow:cellSource); a compilation with no correspondence, or one recording an empty correspondence, cannot trace its cells to their evidence spans." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/recordsCorrespondence> ?rec . ?rec <https://blackcatinformatics.ca/gmeow/correspondenceCell> ?cell . ?cell <https://blackcatinformatics.ca/gmeow/cellSource> ?span . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CompilationMustRecordLossProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ComplexCompilation> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ComplexCompilation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:ComplexCompilation must record at least one gmeow:CompilationPreservationRecord through gmeow:recordsPreservation; a compilation without one hides whether it preserved or dropped structure." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/recordsPreservation> ?rec . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CompilationPreservationBoundaryConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CompilationPreservationRecord> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/CompilationPreservationRecord> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:CompilationPreservationRecord whose logic:preservationKind is not logic:ExactPreservation must name a logic:ExpressivenessBoundary through logic:expressivenessBoundary; a lossy or unsupported preservation judgment without a named boundary hides what it dropped." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/logic/preservationKind> ?k . FILTER ( ?k != <https://blackcatinformatics.ca/logic/ExactPreservation> ) FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/expressivenessBoundary> ?b . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ConditionEvaluationVerdictConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConditionEvaluation> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ConditionEvaluation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ConditionEvaluation must carry exactly one gmeow:evaluationVerdict." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/evaluationVerdict> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ConditionExpressionTextConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConditionExpressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ConditionExpression> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ConditionExpression must carry exactly one gmeow:expressionText." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/expressionText> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ConditionGroupMemberCountConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConditionGroup> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConditionGroupShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ConditionGroup> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ConditionGroup must have at least two gmeow:groupMember conditions — a one-member group is just the member." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/groupMember> ?value . } GROUP BY $this HAVING ( COUNT(?value) < '2'^^<http://www.w3.org/2001/XMLSchema#integer> )""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ConditionGroupOperatorConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConditionGroup> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConditionGroupShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ConditionGroup> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ConditionGroup must declare exactly one gmeow:groupOperator (all / any / none — a CLOSED vocabulary, hence sh:in)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/groupOperator> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ConditionParameterMutexConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConditionParameter> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConditionParameterShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ConditionParameter> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ConditionParameter binds exactly one of gmeow:parameterValue (literal) or gmeow:parameterEntity (IRI)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/parameterEntity> ?v0 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/parameterValue> ?v1 . } } UNION { $this <https://blackcatinformatics.ca/gmeow/parameterValue> ?v1 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/parameterEntity> ?v0 . } } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ConditionParameterNameConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConditionParameterShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ConditionParameter> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ConditionParameter must carry exactly one gmeow:parameterName." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/parameterName> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ConditionalDisclosureWarningConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConditionalDisclosureWarningShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/hasDisclosurePolicy> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A fact marked gmeow:policyPublicOnlyWithIndependentSource should be supported by a citation with gmeow:sourceIndependence gmeow:sourceIndependenceIndependent." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/hasDisclosurePolicy> <https://blackcatinformatics.ca/gmeow/policyPublicOnlyWithIndependentSource> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasCitation> ?citation . ?citation <https://blackcatinformatics.ca/gmeow/sourceIndependence> <https://blackcatinformatics.ca/gmeow/sourceIndependenceIndependent> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ConsentDataControllerConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConsentWellformednessShape> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/RightsStatement> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/RightsStatement> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A consent-governing rights statement should name at least one data controller (gmeow:hasDataController)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/hasPermission> ?perm . ?perm <https://blackcatinformatics.ca/gmeow/ruleAction> <https://blackcatinformatics.ca/gmeow/actionProcessPersonalData> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasDataController> ?c . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ConsentDataSubjectConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ConsentWellformednessShape> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/RightsStatement> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/RightsStatement> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A consent-governing rights statement should name exactly one data subject (gmeow:hasDataSubject)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/hasPermission> ?perm . ?perm <https://blackcatinformatics.ca/gmeow/ruleAction> <https://blackcatinformatics.ca/gmeow/actionProcessPersonalData> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasDataSubject> ?s . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasDataSubject> ?s2 . FILTER ( ?s2 != ?s ) } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CopyrightHolderRequiredConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Copyright> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CopyrightShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Copyright> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Copyright must have at least one holder (gmeow:copyrightHolder)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/copyrightHolder> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CoreObservationMethodConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StandpointClaim> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this a/<http://www.w3.org/2000/01/rdf-schema#subClassOf>* ?fam . FILTER ( ?fam IN (<https://blackcatinformatics.ca/gmeow/Measurement>, <https://blackcatinformatics.ca/gmeow/SensoryObservation>, <https://blackcatinformatics.ca/gmeow/StandpointClaim>, <https://blackcatinformatics.ca/gmeow/TemporalMeasurement>) ) }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A core observation (measurement, sensory, standpoint claim, or temporal measurement) must record an observation method (gmeow:observationMethod or a sub-property)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/observationMethod> ?m1 . } UNION { $this <https://blackcatinformatics.ca/gmeow/measurementMethod> ?m2 . } UNION { $this <https://blackcatinformatics.ca/gmeow/assessmentCriterion> ?m3 . } UNION { $this <https://blackcatinformatics.ca/gmeow/assessmentRubric> ?m4 . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CredentialAttestationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Credential> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Credential> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A Credential intended to be verifiable should reference a gmeow:Attestation (via attestedSubject / hasAttestation)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { ?att a <https://blackcatinformatics.ca/gmeow/Attestation> . { ?att <https://blackcatinformatics.ca/gmeow/attestedSubject> $this . } UNION { $this <https://blackcatinformatics.ca/gmeow/hasAttestation> ?att . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CriterionPenaltyPoleConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Criterion> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CriterionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Criterion> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Criterion must name exactly one gmeow:penaltyPole, a CriterionPole — the named-poles contract: no poles is no axis." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/penaltyPole> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CriterionRewardPoleConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Criterion> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CriterionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Criterion> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Criterion must name exactly one gmeow:rewardPole, a CriterionPole — the named-poles contract: no poles is no axis." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/rewardPole> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/CrossSpaceComparisonConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CrossSpaceComparisonShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/SimilarityObservation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A similarity observation across two DIFFERENT vector spaces (distinct contract digests) requires a justifying logic:Correspondence between the two gmeow:VectorSpaceContracts." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/comparesLeft> ?pL . $this <https://blackcatinformatics.ca/gmeow/comparesRight> ?pR . ?pL <https://blackcatinformatics.ca/gmeow/hasVectorSpaceContract> ?cL . ?pR <https://blackcatinformatics.ca/gmeow/hasVectorSpaceContract> ?cR . ?cL <https://blackcatinformatics.ca/gmeow/contentDigest> ?dL . ?cR <https://blackcatinformatics.ca/gmeow/contentDigest> ?dR . FILTER ( ?dL != ?dR ) FILTER NOT EXISTS { ?corr a <https://blackcatinformatics.ca/logic/Correspondence> . ?corr <https://blackcatinformatics.ca/logic/sourceEndpoint> ?cL . ?corr <https://blackcatinformatics.ca/logic/targetEndpoint> ?cR . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DeceptionCueConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DeceptionCueShape> ;
    sh:targetObjectsOf <https://blackcatinformatics.ca/gmeow/deceptionCue> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A deception cue observation must be a gmeow:Observation with a gmeow:vantage and a gmeow:observationResult." ;
        sh:select """SELECT $this WHERE { ?event a <https://blackcatinformatics.ca/gmeow/Event> . ?event <https://blackcatinformatics.ca/gmeow/deceptionCue> $this . FILTER NOT EXISTS { $this a <https://blackcatinformatics.ca/gmeow/Observation> . $this <https://blackcatinformatics.ca/gmeow/vantage> ?v . $this <https://blackcatinformatics.ca/gmeow/observationResult> ?r . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DeceptionEventConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DeceptionEventShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Event> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A deception event must carry at least one held standpoint (gmeow:heldStandpoint) and one projected standpoint (gmeow:projectedStandpoint), each a gmeow:DoxasticStandpointClaim." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/eventType> <https://blackcatinformatics.ca/gmeow/eventTypeDeception> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/heldStandpoint> ?h . ?h a <https://blackcatinformatics.ca/gmeow/DoxasticStandpointClaim> . $this <https://blackcatinformatics.ca/gmeow/projectedStandpoint> ?p . ?p a <https://blackcatinformatics.ca/gmeow/DoxasticStandpointClaim> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityBasisPresentConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservation> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservationShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A derived affect intensity must declare its gmeow:intensityBasis (the AffectVectorObservation it is the norm of) — a floating intensity with no basis is a hard fail (Principle 12)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/intensityBasis> ?o . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityMetricPresentConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservation> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservationShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A derived affect intensity must declare its gmeow:metricProfile (scale normalization) — an intensity with no declared scale is a hard fail." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/metricProfile> ?o . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityNoStoredMagnitudeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservation> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservationShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A derived affect intensity must NOT carry a stored magnitude (gmeow:appraisalValue) — the norm is a recomputable derived view, never a stored ground fact (Principle 12); a stored intensity value is a hard fail." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/appraisalValue> ?v . }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityNormPresentConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservation> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservationShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A derived affect intensity must declare its gmeow:normFunction (the math:Norm) — a raw L² over the non-orthogonal affect basis is not a default; the metric is an explicit, grounded math:Norm IRI or it is a hard fail." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/normFunction> ?o . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityWeightingIriConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservation> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservationShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/DerivedAffectIntensityObservation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A derived affect intensity must declare its gmeow:weightingPolicy — the basis is non-orthogonal, so the weighting is an explicit, machine-readable gmeow:WeightingPolicy IRI, never assumed and never a free-text string." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/weightingPolicy> ?w . FILTER ( isIRI(?w) ) } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DesireIntentBearerConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Desire> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Desire> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Desire or Intention must inhere in exactly one gmeow:intentBearer (an intrinsic mode has exactly one bearer)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/intentBearer> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DeterminationStatusNoSubclassConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DeterminationStatus> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { VALUES ?this { <https://blackcatinformatics.ca/gmeow/DeterminationStatus> } }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "DeterminationStatus must not be subclassed (Principle 9)." ;
        sh:select """SELECT $this WHERE { ?sub <http://www.w3.org/2000/01/rdf-schema#subClassOf> $this . FILTER ( ?sub != $this ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DisclosureLeakConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DisclosureLeakShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/hasDisclosurePolicy> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A fact marked gmeow:policyNeverPublic or gmeow:policyInternalOnly must not be eligible for any public consumer (e.g. consumerPublicSite, consumerWikidata, consumerWikipedia, consumerSchemaOrgJsonLd, consumerFoafExport). Principle 10: suppression, never erasure — withhold at projection time." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/hasDisclosurePolicy> ?policy . FILTER ( ?policy IN (<https://blackcatinformatics.ca/gmeow/policyNeverPublic>, <https://blackcatinformatics.ca/gmeow/policyInternalOnly>) ) $this <https://blackcatinformatics.ca/gmeow/eligibleForConsumer> ?consumer . FILTER ( ?consumer IN (<https://blackcatinformatics.ca/gmeow/consumerPublicSite>, <https://blackcatinformatics.ca/gmeow/consumerWikidata>, <https://blackcatinformatics.ca/gmeow/consumerWikipedia>, <https://blackcatinformatics.ca/gmeow/consumerSchemaOrgJsonLd>, <https://blackcatinformatics.ca/gmeow/consumerFoafExport>) ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DutyModalityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Duty> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GraftDutyModalityShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Duty> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Duty's deontic modality, when stated, must be gmeow:deonticObligation — the subkind fixes the modality (#352)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/deonticModality> ?v . FILTER ( ?v NOT IN (<https://blackcatinformatics.ca/gmeow/deonticObligation>) ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/DutyRuleActionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Duty> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Duty> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A rule (Permission / Prohibition / Duty) must regulate exactly one action (gmeow:ruleAction)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/ruleAction> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/EmotionBearerConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Emotion> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Emotion> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An Emotion must inhere in exactly one gmeow:emotionBearer (an intrinsic mode has exactly one bearer)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/emotionBearer> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/EmotionTypeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Emotion> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Emotion> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An Emotion must carry at least one gmeow:emotionType (an IRI — the vocabulary is OPEN per Principle 9: blended emotions and rival traditions coexist)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/emotionType> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/EntityExistenceEntityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/EntityExistence> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/EntityExistence> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An EntityExistence must record exactly one entity (gmeow:existenceEntity)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/existenceEntity> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/EntityExistenceIntervalConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/EntityExistence> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/EntityExistence> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An EntityExistence must record exactly one interval (gmeow:duringInterval)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/duringInterval> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/EventHasTypeOrTimeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/EventHasTypeOrTimeShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Event> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "An event should carry at least a gmeow:eventType or a temporal placement (gmeow:eventTime / eventInterval / earliestStart / latestEnd / atTime / ingestedAt)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/atTime> ?v0 . } UNION { $this <https://blackcatinformatics.ca/gmeow/earliestStart> ?v1 . } UNION { $this <https://blackcatinformatics.ca/gmeow/eventInterval> ?v2 . } UNION { $this <https://blackcatinformatics.ca/gmeow/eventTime> ?v3 . } UNION { $this <https://blackcatinformatics.ca/gmeow/eventType> ?v4 . } UNION { $this <https://blackcatinformatics.ca/gmeow/ingestedAt> ?v5 . } UNION { $this <https://blackcatinformatics.ca/gmeow/latestEnd> ?v6 . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ExclusiveAffectiveClaimConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/AffectiveClaim> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ExclusiveClaimShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/AffectiveClaim> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "At most one gmeow:AffectiveClaim may be routed over one target from a single-label (gmeow:decisionArgmax) classifier run — a threshold policy admitting two mutually-exclusive claims over an exclusive label set is a hard fail." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/observedFeature> ?target . ?out1 <https://blackcatinformatics.ca/gmeow/supportsAffectiveClaim> $this . ?out1 <https://blackcatinformatics.ca/gmeow/producedBy> ?run . ?out1 <https://blackcatinformatics.ca/gmeow/emittedLabel> ?l1 . ?l1 <https://blackcatinformatics.ca/gmeow/memberOfLabelSet> ?set . ?set <https://blackcatinformatics.ca/gmeow/labelSetDecision> <https://blackcatinformatics.ca/gmeow/decisionArgmax> . ?other a <https://blackcatinformatics.ca/gmeow/AffectiveClaim> . ?other <https://blackcatinformatics.ca/gmeow/observedFeature> ?target . FILTER ( ?other != $this ) ?out2 <https://blackcatinformatics.ca/gmeow/supportsAffectiveClaim> ?other . ?out2 <https://blackcatinformatics.ca/gmeow/producedBy> ?run . ?out2 <https://blackcatinformatics.ca/gmeow/emittedLabel> ?l2 . ?l2 <https://blackcatinformatics.ca/gmeow/memberOfLabelSet> ?set . }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ExecutionHasPlanConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ExecutionHasPlanShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Execution> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An Execution must reference at least one Procedure (gmeow:executesProcedure) or ProcedureStep (gmeow:executesStep)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/executesProcedure> ?v0 . } UNION { $this <https://blackcatinformatics.ca/gmeow/executesStep> ?v1 . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ExemplarEvidenceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Exemplar> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ExemplarShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Exemplar> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An Exemplar must pin its evidence: at least one of gmeow:viaSelector (a span) or gmeow:exemplarSubject (an entity whose pattern is the example)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/viaSelector> ?sel . } UNION { $this <https://blackcatinformatics.ca/gmeow/exemplarSubject> ?subj . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ExemplarPolarityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Exemplar> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ExemplarShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Exemplar> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An Exemplar must state exactly one gmeow:exemplarPolarity (positive / negative / cautionary — a CLOSED vocabulary, hence sh:in)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/exemplarPolarity> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ExemplarRedirectConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Exemplar> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ExemplarShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Exemplar> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A cautionary redirect must point AWAY: an exemplar may not redirect to the criterion that anchors it." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/exemplarRedirect> ?criterion . ?criterion <https://blackcatinformatics.ca/gmeow/hasScoreAnchor> ?anchor . ?anchor <https://blackcatinformatics.ca/gmeow/anchorExemplar> $this . }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ExpiredTrademarkSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ExpiredTrademarkSuppressionShape> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Trademark> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Trademark> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "An expired or cancelled trademark should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/trademarkStatus> ?st . FILTER ( ?st IN (<https://blackcatinformatics.ca/gmeow/trademarkStatusExpired>, <https://blackcatinformatics.ca/gmeow/trademarkStatusCancelled>) ) FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/FlagshipScenarioWiringConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/FlagshipScenarioShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/gmeow/UnwiredFlagshipScenario> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/FlagshipScenario> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:FlagshipScenario must bind exactly one worked example, competency question, native producer, counter-example, and enforcing failure class; an acceptance scenario that does not wire all realizing artifacts is unwired." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/demonstratedByExample> ?ex . $this <https://blackcatinformatics.ca/gmeow/demonstratedByCompetency> ?cq . $this <https://blackcatinformatics.ca/gmeow/demonstratedByProducer> ?pr . $this <https://blackcatinformatics.ca/gmeow/guardedByCounterExample> ?ce . $this <https://blackcatinformatics.ca/gmeow/enforcesFailureClass> ?fc . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/FrameAxisPresentConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/FrameProfileShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ReferenceFrame> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A reference frame must have at least one coordinate axis." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasAxis> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/FrameAxisTypeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/FrameProfileShape> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ReferenceFrame> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ReferenceFrame> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A reference frame's coordinate axis (gmeow:hasAxis) must be a gmeow:Axis." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/hasAxis> ?v . FILTER NOT EXISTS { ?v a <https://blackcatinformatics.ca/gmeow/Axis> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/FrameDimensionCountConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/FrameProfileShape> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ReferenceFrame> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ReferenceFrame> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A reference frame's dimension count must equal its number of coordinate axes." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/hasAxis> ?value . $this <https://blackcatinformatics.ca/gmeow/dimensionCount> ?rhs . } GROUP BY $this ?rhs HAVING ( COUNT(DISTINCT ?value) != ?rhs )""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/FrameRealmPresentConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/FrameProfileShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ReferenceFrame> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A reference frame must declare its frame realm." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/frameRealm> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GateFatalUpsetConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/logic/ruleGateFatalVerdict> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE {
    ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://blackcatinformatics.ca/gmeow/Finding> .
    ?this <https://blackcatinformatics.ca/gmeow/findingSeverity> <https://blackcatinformatics.ca/gmeow/severityError> .
    ?this <https://blackcatinformatics.ca/gmeow/findingStandpoint> <https://blackcatinformatics.ca/gmeow/standpointBinding> .
    ?this <https://blackcatinformatics.ca/gmeow/findingCategory> ?cat .
    ?cat <https://blackcatinformatics.ca/gmeow/categoryBlocking> <https://blackcatinformatics.ca/gmeow/blockingBlocking> .
}""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A finding on the gate-fatal up-set (severity error, category projecting to blocking, standpoint binding) must carry gmeow:findingGateVerdict gmeow:gateFatal — the derived verdict of logic:ruleGateFatalVerdict is missing." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/findingGateVerdict> <https://blackcatinformatics.ca/gmeow/gateFatal> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GenerativeProcessKindNoSubclassConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GenerativeProcessKind> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { VALUES ?this { <https://blackcatinformatics.ca/gmeow/GenerativeProcessKind> } }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "GenerativeProcessKind must not be subclassed (Principle 9)." ;
        sh:select """SELECT $this WHERE { ?sub <http://www.w3.org/2000/01/rdf-schema#subClassOf> $this . FILTER ( ?sub != $this ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GenreNoSubclassConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Genre> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { VALUES ?this { <https://blackcatinformatics.ca/gmeow/Genre> } }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Genre must not be subclassed (Principle 9)." ;
        sh:select """SELECT $this WHERE { ?sub <http://www.w3.org/2000/01/rdf-schema#subClassOf> $this . FILTER ( ?sub != $this ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GeocodeCodeChoiceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GeocodeShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Geocode> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Geocode must carry exactly one code value: geocodeValue, plusCode, what3words, geohash, mgrs, unLocode, mileMarker, or hasCoordinateMatrix." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/geocodeValue> ?v0 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geohash> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasCoordinateMatrix> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mgrs> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mileMarker> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/plusCode> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/unLocode> ?v6 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/what3words> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/gmeow/geohash> ?v1 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geocodeValue> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasCoordinateMatrix> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mgrs> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mileMarker> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/plusCode> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/unLocode> ?v6 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/what3words> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/gmeow/hasCoordinateMatrix> ?v2 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geocodeValue> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geohash> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mgrs> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mileMarker> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/plusCode> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/unLocode> ?v6 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/what3words> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/gmeow/mgrs> ?v3 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geocodeValue> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geohash> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasCoordinateMatrix> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mileMarker> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/plusCode> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/unLocode> ?v6 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/what3words> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/gmeow/mileMarker> ?v4 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geocodeValue> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geohash> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasCoordinateMatrix> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mgrs> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/plusCode> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/unLocode> ?v6 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/what3words> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/gmeow/plusCode> ?v5 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geocodeValue> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geohash> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasCoordinateMatrix> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mgrs> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mileMarker> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/unLocode> ?v6 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/what3words> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/gmeow/unLocode> ?v6 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geocodeValue> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geohash> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasCoordinateMatrix> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mgrs> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mileMarker> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/plusCode> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/what3words> ?v7 . } } UNION { $this <https://blackcatinformatics.ca/gmeow/what3words> ?v7 . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geocodeValue> ?v0 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/geohash> ?v1 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasCoordinateMatrix> ?v2 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mgrs> ?v3 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/mileMarker> ?v4 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/plusCode> ?v5 . } FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/unLocode> ?v6 . } } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GmeowClassCompletenessConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GmeowClassShape> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE {
    ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .
    FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
}""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW class must carry at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one IRI-valued gmeow:graphBoxRole." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <http://www.w3.org/2000/01/rdf-schema#label> ?l . $this <http://www.w3.org/2004/02/skos/core#definition> ?d . $this <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> ?i . $this <https://blackcatinformatics.ca/gmeow/graphBoxRole> ?r . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GmeowDatatypeCompletenessConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GmeowDatatypeShape> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE {
    ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2000/01/rdf-schema#Datatype> .
    FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
}""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW datatype must carry at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one IRI-valued gmeow:graphBoxRole." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <http://www.w3.org/2000/01/rdf-schema#label> ?l . $this <http://www.w3.org/2004/02/skos/core#definition> ?d . $this <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> ?i . $this <https://blackcatinformatics.ca/gmeow/graphBoxRole> ?r . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GmeowInternalLanguageTagConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/InternalLanguageTagShape> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT DISTINCT ?this WHERE {
    ?this ?p ?value .
    FILTER (STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/"))
    FILTER (isLiteral(?value) && lang(?value) != "")
}""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Literals in GMEOW must use the 'x-gmeow-' private-use prefix for language tags." ;
        sh:select """SELECT $this WHERE { $this ?p ?value . FILTER ( STRSTARTS(STR(?p), 'https://blackcatinformatics.ca/gmeow/') ) FILTER ( isLiteral(?value) ) FILTER ( LANG(?value) != "" ) FILTER ( !REGEX(LANG(?value), '^x-gmeow-[a-z0-9-]+$', 'i') ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GmeowOntologyCompletenessConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GmeowOntologyShape> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE {
    ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Ontology> .
    FILTER(
        STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/")
        || STR(?this) = "https://blackcatinformatics.ca/gmeow"
    )
}""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW ontology header must carry at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one IRI-valued gmeow:graphBoxRole." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <http://www.w3.org/2000/01/rdf-schema#label> ?l . $this <http://www.w3.org/2004/02/skos/core#definition> ?d . $this <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> ?i . $this <https://blackcatinformatics.ca/gmeow/graphBoxRole> ?r . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GmeowPropertyCompletenessConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GmeowPropertyShape> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE {
    ?this a ?t .
    FILTER(?t IN (
        <http://www.w3.org/2002/07/owl#ObjectProperty>,
        <http://www.w3.org/2002/07/owl#DatatypeProperty>,
        <http://www.w3.org/2002/07/owl#AnnotationProperty>
    ))
    FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
}""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW property must carry at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one IRI-valued gmeow:graphBoxRole." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <http://www.w3.org/2000/01/rdf-schema#label> ?l . $this <http://www.w3.org/2004/02/skos/core#definition> ?d . $this <http://www.w3.org/2000/01/rdf-schema#isDefinedBy> ?i . $this <https://blackcatinformatics.ca/gmeow/graphBoxRole> ?r . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GraftPermissionModalityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GraftPermissionModalityShape> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Permission> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Permission> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:Permission's gmeow:deonticModality must be gmeow:deonticPermission; a permission carrying an obligation or prohibition modality is ill-formed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/deonticModality> ?v . FILTER ( ?v NOT IN (<https://blackcatinformatics.ca/gmeow/deonticPermission>) ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/GtsHeadIdPropagationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GtsHeadIdPropagationShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/EmbeddingProjection> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A certified source's gmeow:gtsHeadId must be propagated into the projection as an equal gmeow:projectionSourceGtsHeadId." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/projectionSource> ?src . ?src <https://blackcatinformatics.ca/gmeow/gtsHeadId> ?h . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/projectionSourceGtsHeadId> ?h2 . FILTER ( ?h = ?h2 ) } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/HazardBearerConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Hazard> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Hazard> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Hazard must inhere in exactly one gmeow:hazardBearer — the same danger borne by two systems is two hazards." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hazardBearer> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/HazardManifestedConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Hazard> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Hazard> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Hazard must name at least one feared gmeow:manifestedAsType, an EventType — the type level is where counterfactuals live without machinery." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/manifestedAsType> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/IdentifierSchemeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Identifier> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Identifier> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:Identifier must declare a gmeow:identifierScheme (e.g. 'lei', 'ror', 'naics', 'isicV4', 'orcid', 'geni', 'nip05')." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/identifierScheme> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/IdentifierUrlNodeKindConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Identifier> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Identifier> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:Identifier has at most one gmeow:identifierUrl, an IRI." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/identifierUrl> ?v . FILTER ( !isIRI(?v) ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/InferencePremiseNotConclusionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/InferenceCommitment> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/InferenceCommitment> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A premise must not also be the conclusion (gmeow:premise = gmeow:conclusion) — an argument cannot assume what it proves." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/premise> ?a . $this <https://blackcatinformatics.ca/gmeow/conclusion> ?b . FILTER ( ?a = ?b ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/InstrumentModificationNoSubclassConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/InstrumentModification> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { VALUES ?this { <https://blackcatinformatics.ca/gmeow/InstrumentModification> } }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "InstrumentModification must not be subclassed (Principle 9)." ;
        sh:select """SELECT $this WHERE { ?sub <http://www.w3.org/2000/01/rdf-schema#subClassOf> $this . FILTER ( ?sub != $this ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/InstrumentTypeNoSubclassConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/InstrumentType> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { VALUES ?this { <https://blackcatinformatics.ca/gmeow/InstrumentType> } }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "InstrumentType must not be subclassed (Principle 9)." ;
        sh:select """SELECT $this WHERE { ?sub <http://www.w3.org/2000/01/rdf-schema#subClassOf> $this . FILTER ( ?sub != $this ) }""" ;
    ] .

