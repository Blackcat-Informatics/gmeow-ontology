#
# Declarative structural assertions for the music slice. Each assertion runs as a
# SPARQL ASK over music/module.ttl under the native Rust slicetest harness.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/music/tests/> .

ex:saMusicValueVocabsUseLogicQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:TuningSystemKind      a owl:Class ; rdfs:subClassOf logic:QualityValue .
    gmeow:PitchCollectionKind   a owl:Class ; rdfs:subClassOf logic:QualityValue .
    gmeow:CollectionMemberRole  a owl:Class ; rdfs:subClassOf logic:QualityValue .
    gmeow:InstrumentModification a owl:Class ; rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "Music value-vocabulary classes MUST be subclasses of logic:QualityValue. Replaces stale gufo:QualityValue pytest assertions for tuning, pitch collection, collection-member role, and instrument modification." .

ex:saPitchSpellingSystemIsInformationObjectKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PitchSpellingSystem a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:PitchSpellingSystem MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject." .

ex:saMusicRelatorClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:InstrumentConfiguration a owl:Class ;
        rdfs:subClassOf logic:Relator .
    gmeow:PitchCollectionMembership a owl:Class ;
        rdfs:subClassOf logic:Relator .
    gmeow:PitchSpelling a owl:Class ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "The music configuration and pitch-relation classes MUST be logic:Relator subclasses. Replaces stale gufo:Relator pytest assertions." .

ex:saPerformanceParticipationIsParticipationSubKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PerformanceParticipation a owl:Class , logic:SubKind ;
        rdfs:subClassOf gmeow:Participation .
}""" ;
    gmeow:saRationale "gmeow:PerformanceParticipation MUST be a logic:SubKind of gmeow:Participation. Replaces the stale gufo:SubKind pytest assertion." .

ex:saTimbreDescriptorValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:TimbreDescriptor a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:TimbreDescriptor MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue. Replaces stale gufo:AbstractIndividualType/QualityValue pytest assertions." .
