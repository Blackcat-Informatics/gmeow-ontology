# Inverse ingest: pure dcterms → GMEOW. CompleteOver up-lift — identity on the displayable image of get. GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX dcterms: <http://purl.org/dc/terms/>

CONSTRUCT {
    ?work gmeow:conditionsOfAccess ?cond .
    ?work gmeow:hasLicense ?lic .
}
WHERE {
    {
        ?work dcterms:accessRights ?cond .
    }
