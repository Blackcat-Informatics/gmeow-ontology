PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <https://schema.org/>

CONSTRUCT {
    ?claim a schema:Claim .
    ?claim schema:text ?text .
    ?claim schema:appearance ?source .
    ?claim schema:author ?model .
    ?model a schema:SoftwareApplication .
    ?model schema:name ?mname .
    ?model schema:softwareVersion ?vtag .
    ?crAssess a schema:ClaimReview .
    ?crAssess schema:itemReviewed ?crClaim .
    ?crAssess schema:author ?crJudge .
    ?crAssess schema:reviewRating ?crRating .
    ?crRating a schema:Rating .
