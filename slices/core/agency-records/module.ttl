gmeow:GoalReadAfterWriteEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Goal read-after-write evidence constraint"@x-gmeow-english ;
    skos:definition "A completed positive read-after-write evaluation cites a held actual artifact observation of that same method and condition key. The existing read-after-write law then requires distinct matching write and later-read receipts."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve the existing read-after-write evidence contract when this method is configured for a goal."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid bypassing actual read and write evidence by configuring a method without a cited observation."@x-gmeow-english ;
    gmeow:howToUse "Cite the actual held observation under the same condition key and retain its versioned read and write receipts."@x-gmeow-english ;
    skos:scopeNote "Configuration neither executes the check nor replaces the existing artifact-byte-identity and later-read obligations."@x-gmeow-english ;
    skos:example "gmeow:GoalReadAfterWriteEvidenceConstraint logic:formalizes gmeow:verifierArtifactReadAfterWrite ."@x-gmeow-english ;
    logic:formalizes gmeow:verifierArtifactReadAfterWrite ;
    logic:message "A completed positive read-after-write evaluation cites a held actual artifact observation of that same method and condition key. The existing read-after-write law then requires distinct matching write and later-read receipts."@x-gmeow-english ;
