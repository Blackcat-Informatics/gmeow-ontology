#
# Declarative structural assertions for the gender slice — the slice-resident
# test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants formerly
# hand-written in tests/test_gender.py. Each runs as a SPARQL ASK over the
# gender module graph (gmeow:scopeModule) under the native Rust slicetest
# harness. Gender is migrated, so the class stereotypes are
# logic: (logic:SubKind, logic:AbstractIndividualType, logic:QualityValue),
# not gufo:.
#
# RETAINED in pytest (not migrated here):
#   test_displayable_generalised_to_cover_identity — gmeow:displayable is
#     defined in a cross-slice module, not gender/module.ttl; a module-scoped
#     cell cannot see it.
#   test_competency_gender_values_query — reads COMPETENCY_DIR external file
#     and runs a dynamic query requiring len >= 11 (numeric/count sweep).
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest->DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/gender/tests/> .

# --- 1a. IdentityFacet is a subclass of logic:Relator (MUST) ------------------
ex:saIdentityFacetIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:IdentityFacet a owl:Class ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:IdentityFacet MUST be an owl:Class and subClassOf logic:Relator (the NameUsage idiom; Endurant-compatible so it bears displayable/wasAttributedTo without clashing with Entity-domained props). Mirrors test_identity_facet_is_a_relator (positive half)." .

# --- 1b. IdentityFacet is NOT a subclass of logic:Situation (MUST-NOT) --------
ex:saIdentityFacetNotSituation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:IdentityFacet rdfs:subClassOf logic:Situation . }""" ;
    gmeow:saRationale "gmeow:IdentityFacet MUST NOT be grounded as a logic:Situation (disjoint from Endurant in gUFO). Mirrors test_identity_facet_is_a_relator (negative half)." .

# --- 1c. GenderIdentity is a subclass of IdentityFacet (MUST) ----------------
ex:saGenderIdentitySubclassIdentityFacet a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:GenderIdentity rdfs:subClassOf gmeow:IdentityFacet . }""" ;
    gmeow:saRationale "gmeow:GenderIdentity MUST be a subClassOf gmeow:IdentityFacet. Mirrors test_identity_facet_is_a_relator (facet loop for GenderIdentity)." .

# --- 1d. GenderExpression is a subclass of IdentityFacet (MUST) --------------
ex:saGenderExpressionSubclassIdentityFacet a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:GenderExpression rdfs:subClassOf gmeow:IdentityFacet . }""" ;
    gmeow:saRationale "gmeow:GenderExpression MUST be a subClassOf gmeow:IdentityFacet. Mirrors test_identity_facet_is_a_relator (facet loop for GenderExpression)." .

# --- 2a. Gender, GenderExpressionStyle, SexAssignedAtBirth are QualityValue (MUST)
ex:saValueVocabsSubclassQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Gender rdfs:subClassOf logic:QualityValue .
    gmeow:GenderExpressionStyle rdfs:subClassOf logic:QualityValue .
    gmeow:SexAssignedAtBirth rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:Gender, gmeow:GenderExpressionStyle and gmeow:SexAssignedAtBirth MUST each be subClassOf logic:QualityValue — they are open value vocabularies of individuals, never per-value Person subclasses (Principle 9). Mirrors test_gender_values_are_individuals_not_subclasses (class assertions)." .

# --- 2b. Core Gender seed individuals exist (MUST) ---------------------------
ex:saGenderSeedIndividuals a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:genderWoman     a gmeow:Gender .
    gmeow:genderMan       a gmeow:Gender .
    gmeow:genderNonBinary a gmeow:Gender .
    gmeow:genderTwoSpirit a gmeow:Gender .
}""" ;
    gmeow:saRationale "The core seeded gmeow:Gender individuals (genderWoman, genderMan, genderNonBinary, genderTwoSpirit) MUST exist. Mirrors test_gender_values_are_individuals_not_subclasses (seed individual assertions)." .

# --- 2c. Per-value Person subclasses MUST NOT exist (MUST-NOT) ---------------
ex:saNoWomanClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:Woman a owl:Class . }""" ;
    gmeow:saRationale "gmeow:Woman MUST NOT exist as an owl:Class — per-value Person subclasses are forbidden (overtyping / class explosion doctrine). Mirrors test_gender_values_are_individuals_not_subclasses (rejected class: Woman)." .

