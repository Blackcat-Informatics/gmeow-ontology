@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .

# Narrative reference frame and creative-work alignments.
# Compiled to mappings/gmeow-narrative.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetNarrative a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/narrative" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Narrative reference frame and creative-work alignments to schema.org and Wikidata." .

schema:Book skos:closeMatch gmeow:BookRelease {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "schema:Book is broader (may denote abstract work); gmeow:BookRelease is a concrete published edition."
|} .

schema:Episode rdfs:subClassOf gmeow:SerialInstallment {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "schema:Episode is TV/radio-specific; gmeow:SerialInstallment is broader (comics, magazines)."
|} .

wd:Q1774138 skos:closeMatch gmeow:NarrativeReferenceFrame {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'fictional universe' is broader than a single canon frame."
|} .

wd:Q15706943 skos:closeMatch gmeow:NarrativeReferenceFrame {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'fictional world' — close match to narrative frame."
|} .

gmeow:LiteraryWork skos:closeMatch schema:Book {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Lossy: schema.org collapses WEMI; schema:Book may denote abstract work or concrete edition."
|} .

gmeow:LiteraryWork skos:closeMatch bibo:Book {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "bibo:Book is scholarly-publication-scoped; gmeow:LiteraryWork is universal."
|} .

gmeow:SerialWork skos:closeMatch schema:CreativeWorkSeries {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema:CreativeWorkSeries is broader (includes TV, film, game series)."
|} .

gmeow:SerialInstallment skos:closeMatch schema:Chapter {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Lossy: schema:Chapter is WebPageElement-scoped; gmeow:SerialInstallment is broader."
|} .

gmeow:ContentSegment skos:narrowMatch schema:Chapter {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Lossy: schema:Chapter is WebPageElement-scoped and narrower than gmeow:ContentSegment."
|} .

gmeow:Contribution skos:closeMatch schema:Role {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Lossy: schema:Role is a class, not a relator; GMEOW Contribution is a reified node."
|} .

gmeow:Myth skos:closeMatch wd:Q12827256 {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Wikidata 'myth' (type of traditional narrative) — close match to gmeow:Myth."
|} .

gmeow:Myth skos:closeMatch wd:Q189349 {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'urban legend' (form of modern folklore) — close match to gmeow:Myth."
|} .

gmeow:Myth skos:closeMatch wd:Q159535 {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Wikidata 'conspiracy theory' — close match to gmeow:Myth as a socially-sustained narrative whose currency is independent of truth-value."
|} .

gmeow:hasMythTelling skos:relatedMatch schema:CreativeWork {|
    gmeow:sssomFile "gmeow-narrative.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Lossy: schema:CreativeWork collapses the WEMI tiers; gmeow:hasMythTelling points to a concrete CreativeWork telling."
|} .
