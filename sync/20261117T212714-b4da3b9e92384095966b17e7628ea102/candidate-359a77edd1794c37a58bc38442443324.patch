-                name,
-                Box::new(move |_: &McpServer, _: &Value| {
-                    Err(segment_not_loaded(name, CORE_SEGMENT))
-                }) as ToolHandler,
-            )
-        };
-        #[cfg(not(feature = "core"))]
-        let entry: (&'static str, ToolHandler) = {
-            let _ = &$segments;
-            (
-                name,
-                Box::new(move |_: &McpServer, _: &Value| {
-                    Err(segment_not_loaded(name, CORE_SEGMENT))
