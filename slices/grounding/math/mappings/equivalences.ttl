    gmeow:confidence 0.9 ;
    gmeow:objectLabel "candela" ;
    gmeow:comment "The luminous-intensity dimension J is realized by the SI base unit candela; the BIPM D-SI PID is the authoritative SI anchor. relatedMatch, cited not re-minted." ;
    gmeow:sssomFile "gmeow-dsi.sssom.tsv" .

