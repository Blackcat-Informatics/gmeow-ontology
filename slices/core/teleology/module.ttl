gmeow:commitmentBeneficiaryDistinctness
    a logic:NamedIndividual ,
        logic:RelatumDistinctnessAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/teleology> ;
    rdfs:label "a commitment's beneficiary is distinct from its committed agent"@x-gmeow-english ;
    skos:definition "Asserts that a gmeow:Commitment's gmeow:committedAgent and gmeow:commitmentBeneficiary must be distinct: a resolution made purely to oneself is an Intention, not a Commitment. The native coherence gate raises a violation when they coincide."@x-gmeow-english ;
    logic:distinctnessTarget gmeow:Commitment ;
