#
# Counter-example for math:HomomorphismShape: a math:GroupHomomorphism that declares its
# preserved operation but omits its math:preservationLaw (sh:minCount 1), so validation
# MUST emit shacl.MinCountConstraintComponent (and no other finding).
# Bound by tests/example-conformance.ttl (ex:ecHomomorphismMissingLaw).
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:lawlessHom a math:GroupHomomorphism ;
    math:preservedOperation ex:op .

ex:op a math:Operation .
