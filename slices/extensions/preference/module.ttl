# Scalarization disclosure: a scalarized receipt must carry weights.
gmeow:ScalarizationDisclosureConstraint
    a logic:Constraint ;
    rdfs:label "Scalarization disclosure constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC4): a gmeow:ProjectionReceipt whose gmeow:projectionKind is gmeow:projectionScalarized MUST carry gmeow:scalarizationWeights — a scalarized ranking that hides its weights hides how it collapsed the criteria. The gate proves DISCLOSURE exists, not that the weights are uniquely faithful (FLAG-2, Principle 12). A ∀→∃ formula, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:ProjectionReceipt ;
    logic:severity "Violation" ;
    logic:message "A gmeow:ProjectionReceipt of kind gmeow:projectionScalarized must carry gmeow:scalarizationWeights disclosing how it collapsed the criteria." ;
    logic:integrity gmeow:sdcForall .
gmeow:sdcForall a logic:Formula ;
    rdfs:label "sdcForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:ScalarizationDisclosureConstraint (AC4, scalarization disclosure): binds ?this and requires ?this is a gmeow:ProjectionReceipt ∧ gmeow:projectionKind(?this, gmeow:projectionScalarized) → ∃?w. gmeow:scalarizationWeights(?this, ?w)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:sdcImpl .
gmeow:sdcImpl a logic:Formula ;
    rdfs:label "sdcImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:ScalarizationDisclosureConstraint (AC4, scalarization disclosure): when ?this is a gmeow:ProjectionReceipt ∧ gmeow:projectionKind(?this, gmeow:projectionScalarized) holds, requires ∃?w. gmeow:scalarizationWeights(?this, ?w)."@x-gmeow-english ; logic:antecedent gmeow:sdcGuard ; logic:consequent gmeow:sdcExists .
gmeow:sdcGuard a logic:Formula ;
    rdfs:label "sdcGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:ScalarizationDisclosureConstraint (AC4, scalarization disclosure): conjoins ?this is a gmeow:ProjectionReceipt ∧ gmeow:projectionKind(?this, gmeow:projectionScalarized)."@x-gmeow-english ; logic:and gmeow:sdcType , gmeow:sdcScal .
