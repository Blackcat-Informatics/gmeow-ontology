PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SourceTier a logic:AbstractIndividualType , owl:Class ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:SourceTier MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- the bibliographic tier value vocabulary (individuals; Principle 9)." .

# --- 8. SourceTier seed individuals exist (MUST) ------------------------------
ex:saSourceTierSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:sourceTierPrimary   a gmeow:SourceTier .
    gmeow:sourceTierSecondary a gmeow:SourceTier .
    gmeow:sourceTierTertiary  a gmeow:SourceTier .
}""" ;
    gmeow:saRationale "The three SourceTier seed individuals (primary, secondary, tertiary) MUST exist as the standard bibliographic tier axis for notability assessment." .

# --- 9. SourceTier seeds are NOT typed owl:Class (MUST-NOT) ------------------
ex:saSourceTierSeedsNotOwlClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?seed {
        gmeow:sourceTierPrimary
        gmeow:sourceTierSecondary
        gmeow:sourceTierTertiary
    }
    ?seed a owl:Class .
}""" ;
    gmeow:saRationale "No SourceTier seed individual MUST be typed owl:Class -- the tiers are individuals, never subclasses (Principle 9)." .

