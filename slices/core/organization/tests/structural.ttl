#
# Declarative structural assertions for the organization slice (#258, #51) --
# the slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT TBox
# invariants formerly hand-written in tests/test_organization.py. Each
# assertion runs as a SPARQL ASK over the organization module graph
# (gmeow:scopeModule) under the native Rust harness (crates/slicetest).
#
# Organization is #694-migrated: class stereotypes are logic:
# (logic:Kind, logic:RoleMixin, logic:AbstractIndividualType, logic:QualityValue,
# logic:Relator), not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_contested_membership_coexists -- run_shacl() call over fixture;
#     ExampleConformance, not a structural TBox assertion.
#   test_contested_succession_coexists -- run_shacl() call over fixture;
#     ExampleConformance, not a structural TBox assertion.
#   test_withdrawn_recognition_suppressed_not_deleted -- run_shacl() + fixture
#     ABox check; not a module-scoped TBox invariant.
#   test_no_preferred_or_primary_org_term -- sweeps the entire merged graph
#     subject set via _graph(); a scopeModule cell would silently narrow the
#     sweep to the organization module only (missing cross-slice violations).
#   test_post_seat_independent_of_holder -- run_shacl() + fixture ABox check.
#   test_post_successive_holders -- run_shacl() + fixture ABox check.
#   test_membership_fills_post_org_mismatch_warns -- run_shacl() + SHACL
#     Warning text check; not expressible as a module-scoped ASK.
#   test_site_location -- run_shacl() + fixture ABox check.
#   test_change_event_entailments -- run_shacl() + fixture ABox check.
#   test_legal_identifier_requires_scheme -- run_shacl() + error-text
#     assertion; ExampleConformance / SHACL Violation check.
#   test_wellformed_legal_identifier_passes -- run_shacl() + graph
#     manipulation; ExampleConformance.
#   test_change_event_type_values_exist -- eventTypeMerger/Split/SpinOff/
#     Acquisition/Rename are defined in slices/core/events/module.ttl, not
#     here; a scopeModule cell would miss them (cross-slice).
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest->DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/organization/tests/> .

# --- 1. Role is a logic:RoleMixin subclass of FunctionalComplex (MUST) --------
ex:saRoleIsRoleMixin a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Role a owl:Class , logic:RoleMixin ;
        rdfs:subClassOf logic:FunctionalComplex .
}""" ;
    gmeow:saRationale "gmeow:Role MUST be an owl:Class typed logic:RoleMixin and a subclass of logic:FunctionalComplex -- roles are functional complexes played by agents, never subclasses of the agent (Principle 9). Mirrors test_organization_is_gufo_grounded (Role part)." .

# --- 2. Membership is a logic:Kind subclass of logic:Relator (MUST) ------------
ex:saMembershipIsKindRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Membership a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:Membership MUST be an owl:Class typed logic:Kind and a subclass of logic:Relator -- the reified member x organization x role x post binding (gUFO relator idiom; Principle 4). Mirrors test_organization_is_gufo_grounded (Membership part)." .

# --- 3. Post is a logic:RoleMixin subclass of FunctionalComplex (MUST) --------
ex:saPostIsRoleMixin a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Post a owl:Class , logic:RoleMixin ;
        rdfs:subClassOf logic:FunctionalComplex .
}""" ;
    gmeow:saRationale "gmeow:Post MUST be an owl:Class typed logic:RoleMixin and a subclass of logic:FunctionalComplex -- a seat independent of its holder; RoleMixin because the post identity does not fix the bearer's identity (issue #258). Mirrors test_post_is_gufo_role_mixin." .

# --- 4. The six OrganizationType seed individuals exist (MUST) ----------------
ex:saOrganizationTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:organizationTypeCompany              a gmeow:OrganizationType .
    gmeow:organizationTypeNonprofit            a gmeow:OrganizationType .
    gmeow:organizationTypeGovernmentBody       a gmeow:OrganizationType .
    gmeow:organizationTypeEducationalInstitution a gmeow:OrganizationType .
    gmeow:organizationTypeAssociation          a gmeow:OrganizationType .
    gmeow:organizationTypeCollaboration        a gmeow:OrganizationType .
}""" ;
    gmeow:saRationale "All six OrganizationType seed individuals (company, nonprofit, governmentBody, educationalInstitution, association, collaboration) MUST exist as gmeow:OrganizationType instances -- the open value vocabulary bootstrap (Principle 9). Mirrors test_organization_type_values_exist." .

# --- 5. The three SiteType seed individuals exist (MUST) ---------------------
ex:saSiteTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:siteTypeHeadquarters a gmeow:SiteType .
    gmeow:siteTypeBranch       a gmeow:SiteType .
    gmeow:siteTypeRegistered   a gmeow:SiteType .
}""" ;
    gmeow:saRationale "The three SiteType seed individuals (headquarters, branch, registered) MUST exist as gmeow:SiteType instances -- the site-purpose value vocabulary bootstrap (issue #258). Mirrors test_site_type_values_exist." .

# --- 6. organizationType is an owl:ObjectProperty (MUST) ---------------------
ex:saOrganizationTypeProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:organizationType a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:organizationType MUST be an owl:ObjectProperty -- kind is a value, not a subclass (Principle 9). Mirrors test_new_organization_properties_exist (organizationType part)." .

