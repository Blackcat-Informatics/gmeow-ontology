    gmeow:textDirection gmeow:directionLtr ;
    skos:exactMatch wd:Q48334 ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> .

gmeow:wsHangul a gmeow:WritingSystem ;
    rdfs:label "Hangul writing system"@x-gmeow-english ;
    skos:definition "The Korean featural alphabet script."@x-gmeow-english ;
    gmeow:scriptCode "Hang" ;
    gmeow:writingSystemType gmeow:wsTypeFeatural ;
    gmeow:textDirection gmeow:directionLtr ;
    skos:exactMatch wd:Q8222 ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> .

gmeow:wsArabic a gmeow:WritingSystem ;
    rdfs:label "Arabic writing system"@x-gmeow-english ;
    skos:definition "The Arabic abjad script used for Arabic, Persian, Urdu, and many other languages."@x-gmeow-english ;
    gmeow:scriptCode "Arab" ;
    gmeow:writingSystemType gmeow:wsTypeAbjad ;
    gmeow:textDirection gmeow:directionRtl ;
    skos:exactMatch wd:Q1828555 ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> .

gmeow:wsCyrillic a gmeow:WritingSystem ;
    rdfs:label "Cyrillic writing system"@x-gmeow-english ;
    skos:definition "The Cyrillic alphabet script used for Russian, Ukrainian, and many other languages."@x-gmeow-english ;
