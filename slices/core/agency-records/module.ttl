                    logic:forall [ a logic:Formula ;
                        logic:antecedent [ a logic:Formula ; logic:and
                            [ a logic:Formula ; logic:relation gmeow:entryOrdinal ; logic:argument [ logic:termIndex 0 ; logic:termVariable "aheadAnchor" ] , [ logic:termIndex 1 ; logic:termVariable "a3FirstOrdinal" ] ] ,
                            [ a logic:Formula ; logic:relation gmeow:entryOrdinal ; logic:argument [ logic:termIndex 0 ; logic:termVariable "aheadAnchor" ] , [ logic:termIndex 1 ; logic:termVariable "a3SecondOrdinal" ] ] ] ;
                        logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "a3FirstOrdinal" ] , [ logic:termIndex 1 ; logic:termVariable "a3SecondOrdinal" ] ] ] ] ,
                [ a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "a4Offer" ] , [ logic:termIndex 1 ; logic:termVariable "a4OtherAnchor" ] , [ logic:termIndex 2 ; logic:termVariable "a4Ordinal" ] , [ logic:termIndex 3 ; logic:termVariable "a4OtherOrdinal" ] ;
