# SPDX-License-Identifier: CC-BY-4.0
#
# Declarative structural assertions for the kernel slice — the slice-resident
# test-DSL twin of the kernel-local MUST / MUST-NOT invariants formerly
# hand-written in tests/test_aboutness.py (the universal aboutness axis).
# Authored as gmeow: ontology data so the native Rust harness
# (crates/slicetest) drives the test, not ad-hoc Python. Each assertion
# runs as a SPARQL ASK over the kernel module graph (gmeow:scopeModule).
#
# Scope note: only the invariants whose subjects are DECLARED in the kernel
# module migrate here. test_aboutness_orthogonal_to_other_axes and
# test_no_aboutness_truth_bridge assert ABSENCE over the whole merged graph
# across axes (gmeow:confidence, gmeow:hasGranularity, …) and a seed
# (gmeow:aboutnessEnacts) that are also declared/used in 10+ other slices, so
# they cannot be faithfully reduced to module scope.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/kernel/tests/> .

# --- 1. AboutnessMode class structure (MUST hold) ----------------------------
ex:saAboutnessModeClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:AboutnessMode a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:AboutnessMode MUST be a universal logic:AbstractIndividualType owl:Class that is a subclass of logic:QualityValue — a value vocabulary of individuals, never per-mode subclasses (Principle 9, the fourth domain-free epistemic axis)." .

# --- 2. hasAboutness is an AnnotationProperty ranging on AboutnessMode (MUST) -
ex:saHasAboutnessAnnotationProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasAboutness a owl:AnnotationProperty ;
        rdfs:range gmeow:AboutnessMode .
}""" ;
    gmeow:saRationale "gmeow:hasAboutness MUST be declared an owl:AnnotationProperty (not an ObjectProperty, unlike the other three axes) with rdfs:range gmeow:AboutnessMode — the annotation form keeps the OWL downcast DL-clean through the accordingTo pattern (Principle 3)." .

# --- 3. hasAboutness is domain-free, non-object, non-functional (MUST-NOT) ----
ex:saHasAboutnessNotObjectFunctionalOrDomained a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    { gmeow:hasAboutness a owl:ObjectProperty . }
    UNION
    { ?rec logic:characterizes gmeow:hasAboutness ; logic:characteristicSort logic:functionalProperty . }
    UNION
    { gmeow:hasAboutness rdfs:domain ?d . }
}""" ;
    gmeow:saRationale "The kernel declaration of gmeow:hasAboutness MUST NOT make it an owl:ObjectProperty (it is an annotation), MUST NOT make it owl:FunctionalProperty (multi-vantage classifications coexist, Principle 9), and MUST NOT give it an rdfs:domain (domain-free/universal, like hasGranularity/hasDeterminacy/hasSensitivity)." .

# --- 4. The value vocabulary's two seeds are typed AboutnessMode (MUST) -------
ex:saAboutnessSeedsTyped a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:aboutnessDescribes a gmeow:AboutnessMode .
    gmeow:aboutnessEnacts    a gmeow:AboutnessMode .
}""" ;
    gmeow:saRationale "The mention/use space MUST be spanned by both seeds: gmeow:aboutnessDescribes (mention) and gmeow:aboutnessEnacts (use) are each a gmeow:AboutnessMode." .

# --- 5. No third AboutnessMode member in the kernel module (MUST-NOT) ---------
ex:saAboutnessNoThirdMember a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?m a gmeow:AboutnessMode .
    FILTER (?m != gmeow:aboutnessDescribes && ?m != gmeow:aboutnessEnacts)
}""" ;
    gmeow:saRationale "The aboutness value vocabulary is a genuinely-closed two-member enumeration with no privileged winner (Principle 9): the kernel module MUST NOT declare any gmeow:AboutnessMode individual other than the describes/enacts seeds." .

# =============================================================================
# 6. Determinacy axis (migrated from tests/test_determinacy.py)
# =============================================================================

# --- 6.1 Determinacy class structure (MUST hold) -----------------------------
ex:saDeterminacyClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:Determinacy a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:Determinacy MUST be a universal logic:AbstractIndividualType owl:Class that is a subclass of logic:QualityValue — a value vocabulary of individuals spanning the ontic-determinacy space (crisp, vague, fuzzy, probabilistic, disputed), never per-determinacy subclasses (Principle 9)." .

# --- 6.2 hasDeterminacy ObjectProperty structure (MUST) -----------------------
ex:saHasDeterminacyProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasDeterminacy a owl:ObjectProperty ;
        rdfs:range gmeow:Determinacy .
}""" ;
    gmeow:saRationale "gmeow:hasDeterminacy MUST be an owl:ObjectProperty with rdfs:range gmeow:Determinacy — the universal facet that attaches an ontic-determinacy model to a value/entity/claim." .

# --- 6.3 hasDeterminacy is domain-free and non-functional (MUST-NOT) ---------
ex:saHasDeterminacyNotFunctionalOrDomained a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    { ?rec logic:characterizes gmeow:hasDeterminacy ; logic:characteristicSort logic:functionalProperty . }
    UNION
    { gmeow:hasDeterminacy rdfs:domain ?d . }
}""" ;
    gmeow:saRationale "gmeow:hasDeterminacy MUST NOT be owl:FunctionalProperty (multi-source determinacy claims coexist, Principle 9) and MUST NOT have an rdfs:domain (domain-free/universal, like hasGranularity and hasSensitivity)." .

# --- 6.5 Determinacy value vocabulary spans five seeds (MUST) ----------------
ex:saDeterminacySeedsTyped a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:determinacyCrisp          a gmeow:Determinacy .
    gmeow:determinacyVague          a gmeow:Determinacy .
    gmeow:determinacyFuzzy          a gmeow:Determinacy .
    gmeow:determinacyProbabilistic  a gmeow:Determinacy .
    gmeow:determinacyDisputed       a gmeow:Determinacy .
}""" ;
    gmeow:saRationale "The determinacy space MUST be spanned by exactly five seeds: crisp, vague, fuzzy, probabilistic, and disputed — each a gmeow:Determinacy individual with no privileged winner (Principle 9)." .

# --- 6.6 No sixth Determinacy member in the kernel module (MUST-NOT) ---------
ex:saDeterminacyNoSixthMember a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?m a gmeow:Determinacy .
    FILTER (
        ?m != gmeow:determinacyCrisp &&
        ?m != gmeow:determinacyVague &&
        ?m != gmeow:determinacyFuzzy &&
        ?m != gmeow:determinacyProbabilistic &&
        ?m != gmeow:determinacyDisputed
    )
}""" ;
    gmeow:saRationale "The determinacy value vocabulary is a five-member enumeration with no privileged winner (Principle 9): the kernel module MUST NOT declare any gmeow:Determinacy individual other than the five seeds." .

# --- 6.7 hasDeterminacy is orthogonal to confidence (MUST-NOT) ---------------
ex:saDeterminacyConfidenceOrthogonal a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    {
        gmeow:hasDeterminacy rdfs:subPropertyOf gmeow:confidence .
    } UNION {
        gmeow:confidence rdfs:subPropertyOf gmeow:hasDeterminacy .
    } UNION {
        gmeow:hasDeterminacy owl:equivalentProperty gmeow:confidence .
    } UNION {
        gmeow:confidence owl:equivalentProperty gmeow:hasDeterminacy .
    }
}""" ;
    gmeow:saRationale "gmeow:hasDeterminacy (ontic indeterminacy) MUST NOT be entangled with gmeow:confidence (epistemic certainty) via rdfs:subPropertyOf or owl:equivalentProperty — the two axes are orthogonal (Principle 9)." .

# --- 6.8 hasDeterminacy is distinct from determinacyModel (MUST-NOT) ---------
ex:saHasDeterminacyDeterminacyModelDistinct a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    {
        gmeow:hasDeterminacy rdfs:subPropertyOf gmeow:determinacyModel .
    } UNION {
        gmeow:determinacyModel rdfs:subPropertyOf gmeow:hasDeterminacy .
    } UNION {
        gmeow:hasDeterminacy owl:equivalentProperty gmeow:determinacyModel .
    } UNION {
        gmeow:determinacyModel owl:equivalentProperty gmeow:hasDeterminacy .
    }
}""" ;
    gmeow:saRationale "The universal facet gmeow:hasDeterminacy and the frame-level default gmeow:determinacyModel MUST NOT be related via rdfs:subPropertyOf or owl:equivalentProperty — they are distinct properties serving different scopes." .

# =============================================================================
# 7. Disclosure / projection axis (migrated from crates/validate/tests/conformance_disclosure.rs)
# =============================================================================

# --- 7.1 ProjectionContext class structure (MUST hold) -----------------------
ex:saProjectionContextClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:ProjectionContext a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:ProjectionContext MUST be a universal logic:AbstractIndividualType owl:Class that is a subclass of logic:QualityValue — the open value vocabulary of projection consumers/audiences (internal archive, agent memory, Wikidata, Wikipedia, public site, etc.), never per-consumer subclasses (Principle 9)." .

# --- 7.2 DisclosurePolicy class structure (MUST hold) ------------------------
ex:saDisclosurePolicyClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:DisclosurePolicy a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:DisclosurePolicy MUST be a universal logic:AbstractIndividualType owl:Class that is a subclass of logic:QualityValue — the open value vocabulary of disclosure postures (internalOnly, sensitive, publicCareful, publicSafe, neverPublic, publicOnlyWithIndependentSource), never per-policy subclasses (Principle 9)." .

# --- 7.3 eligibleForConsumer ObjectProperty structure (MUST) -----------------
ex:saEligibleForConsumerProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:eligibleForConsumer a owl:ObjectProperty ;
        rdfs:range gmeow:ProjectionContext .
}""" ;
    gmeow:saRationale "gmeow:eligibleForConsumer MUST be an owl:ObjectProperty with rdfs:range gmeow:ProjectionContext — the universal *who* facet of disclosure control." .

# --- 7.4 eligibleForConsumer is domain-free and non-functional (MUST-NOT) ----
ex:saEligibleForConsumerNotFunctionalOrDomained a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    { ?rec logic:characterizes gmeow:eligibleForConsumer ; logic:characteristicSort logic:functionalProperty . }
    UNION
    { gmeow:eligibleForConsumer rdfs:domain ?d . }
}""" ;
    gmeow:saRationale "gmeow:eligibleForConsumer MUST NOT be owl:FunctionalProperty (multi-source consumer eligibilities coexist, Principle 9) and MUST NOT have an rdfs:domain (domain-free/universal)." .

# --- 7.5 hasDisclosurePolicy ObjectProperty structure (MUST) -----------------
ex:saHasDisclosurePolicyProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasDisclosurePolicy a owl:ObjectProperty ;
        rdfs:range gmeow:DisclosurePolicy .
}""" ;
    gmeow:saRationale "gmeow:hasDisclosurePolicy MUST be an owl:ObjectProperty with rdfs:range gmeow:DisclosurePolicy — the universal *what* facet of disclosure control." .

# --- 7.6 hasDisclosurePolicy is domain-free and non-functional (MUST-NOT) ----
ex:saHasDisclosurePolicyNotFunctionalOrDomained a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    { ?rec logic:characterizes gmeow:hasDisclosurePolicy ; logic:characteristicSort logic:functionalProperty . }
    UNION
    { gmeow:hasDisclosurePolicy rdfs:domain ?d . }
}""" ;
    gmeow:saRationale "gmeow:hasDisclosurePolicy MUST NOT be owl:FunctionalProperty (multi-source disclosure policies coexist, Principle 9) and MUST NOT have an rdfs:domain (domain-free/universal)." .

# --- 7.7 ProjectionContext seeds are declared (MUST) -------------------------
ex:saProjectionContextSeedsDeclared a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:consumerInternalArchive         a gmeow:ProjectionContext .
    gmeow:consumerAgentMemory             a gmeow:ProjectionContext .
    gmeow:consumerWikidata                a gmeow:ProjectionContext .
    gmeow:consumerWikipedia               a gmeow:ProjectionContext .
    gmeow:consumerPublicSite              a gmeow:ProjectionContext .
    gmeow:consumerSchemaOrgJsonLd         a gmeow:ProjectionContext .
    gmeow:consumerFoafExport              a gmeow:ProjectionContext .
    gmeow:consumerResearchQueue           a gmeow:ProjectionContext .
    gmeow:consumerAdviceCatalog           a gmeow:ProjectionContext .
}""" ;
    gmeow:saRationale "The projection-consumer vocabulary MUST be seeded with the original nine declared gmeow:ProjectionContext individuals — the founding members of what is now a closed fifteen-member enumeration (Principle 9): the nine seeds plus the six documentation-distribution audiences the external documentation distribution catalog references (offline book, print archive, knowledge federation, linked-data tooling, typed-model client, interactive console). This assertion pins only the nine seeds; the closure over all fifteen is ex:saProjectionContextNoTenthMember's job." .

# --- 7.8 No unlisted ProjectionContext member in the kernel module (MUST-NOT) ---
ex:saProjectionContextNoTenthMember a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?m a gmeow:ProjectionContext .
    FILTER (
        ?m != gmeow:consumerInternalArchive &&
        ?m != gmeow:consumerAgentMemory &&
        ?m != gmeow:consumerWikidata &&
        ?m != gmeow:consumerWikipedia &&
        ?m != gmeow:consumerPublicSite &&
        ?m != gmeow:consumerSchemaOrgJsonLd &&
        ?m != gmeow:consumerFoafExport &&
        ?m != gmeow:consumerResearchQueue &&
        ?m != gmeow:consumerAdviceCatalog &&
        ?m != gmeow:consumerKnowledgeFederation &&
        ?m != gmeow:consumerLinkedDataTooling &&
        ?m != gmeow:consumerOfflineBook &&
        ?m != gmeow:consumerPrintArchive &&
        ?m != gmeow:consumerTypedModelClient &&
        ?m != gmeow:consumerInteractiveConsole &&
        ?m != gmeow:consumerIndexProjection
    )
}""" ;
    gmeow:saRationale "The kernel projection-consumer vocabulary is a closed SIXTEEN-member enumeration (Principle 9): the original nine seeds, the six documentation-distribution audiences the external documentation distribution catalog references (offline book, print archive, knowledge federation, linked-data tooling, typed-model client, interactive console), and the rebuildable index/retrieval projection consumer (gmeow:consumerIndexProjection). The kernel module MUST NOT declare any gmeow:ProjectionContext individual outside this closed set." .

# --- 7.9 DisclosurePolicy seeds are declared (MUST) --------------------------
ex:saDisclosurePolicySeedsDeclared a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:policyInternalOnly                     a gmeow:DisclosurePolicy .
    gmeow:policySensitive                        a gmeow:DisclosurePolicy .
    gmeow:policyPublicCareful                    a gmeow:DisclosurePolicy .
    gmeow:policyPublicSafe                       a gmeow:DisclosurePolicy .
    gmeow:policyNeverPublic                      a gmeow:DisclosurePolicy .
    gmeow:policyPublicOnlyWithIndependentSource  a gmeow:DisclosurePolicy .
}""" ;
    gmeow:saRationale "The disclosure-policy vocabulary MUST be seeded with the six declared gmeow:DisclosurePolicy individuals." .

# --- 7.10 No seventh DisclosurePolicy member in the kernel module (MUST-NOT) -
ex:saDisclosurePolicyNoSeventhMember a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?m a gmeow:DisclosurePolicy .
    FILTER (
        ?m != gmeow:policyInternalOnly &&
        ?m != gmeow:policySensitive &&
        ?m != gmeow:policyPublicCareful &&
        ?m != gmeow:policyPublicSafe &&
        ?m != gmeow:policyNeverPublic &&
        ?m != gmeow:policyPublicOnlyWithIndependentSource
    )
}""" ;
    gmeow:saRationale "The kernel disclosure-policy vocabulary is a closed six-member enumeration (Principle 9): the kernel module MUST NOT declare any gmeow:DisclosurePolicy individual other than the six seeds." .

# --- 7.11 hasDisclosurePolicy is orthogonal to other axes (MUST-NOT) ---------
ex:saDisclosureOrthogonalToOtherAxes a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    {
        gmeow:hasDisclosurePolicy rdfs:subPropertyOf ?other .
        FILTER (?other IN (gmeow:hasSensitivity, gmeow:hasDeterminacy, gmeow:confidence))
    } UNION {
        ?other rdfs:subPropertyOf gmeow:hasDisclosurePolicy .
        FILTER (?other IN (gmeow:hasSensitivity, gmeow:hasDeterminacy, gmeow:confidence))
    } UNION {
        gmeow:hasDisclosurePolicy owl:equivalentProperty ?other .
        FILTER (?other IN (gmeow:hasSensitivity, gmeow:hasDeterminacy, gmeow:confidence))
    } UNION {
        ?other owl:equivalentProperty gmeow:hasDisclosurePolicy .
        FILTER (?other IN (gmeow:hasSensitivity, gmeow:hasDeterminacy, gmeow:confidence))
    }
}""" ;
    gmeow:saRationale "gmeow:hasDisclosurePolicy MUST NOT be entangled with gmeow:hasSensitivity, gmeow:hasDeterminacy, or gmeow:confidence via rdfs:subPropertyOf or owl:equivalentProperty — disclosure is orthogonal to sensitivity, determinacy, and confidence (Principle 9)." .

# --- 7.12 hasDisclosurePolicy is orthogonal to hasGranularity (MUST-NOT) -----
ex:saDisclosureOrthogonalToGranularity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    {
        gmeow:hasDisclosurePolicy rdfs:subPropertyOf gmeow:hasGranularity .
    } UNION {
        gmeow:hasGranularity rdfs:subPropertyOf gmeow:hasDisclosurePolicy .
    } UNION {
        gmeow:hasDisclosurePolicy owl:equivalentProperty gmeow:hasGranularity .
    } UNION {
        gmeow:hasGranularity owl:equivalentProperty gmeow:hasDisclosurePolicy .
    }
}""" ;
    gmeow:saRationale "gmeow:hasDisclosurePolicy MUST NOT be entangled with gmeow:hasGranularity via rdfs:subPropertyOf or owl:equivalentProperty — disclosure and granularity are distinct axes (Principle 9)." .

# --- 7.13 Documentation-distribution audience seeds are declared (MUST) ------
#
# ex:saProjectionContextNoTenthMember (7.8) only PERMITS the six
# documentation-distribution audiences; ex:saProjectionContextSeedsDeclared
# (7.7) pins only the original nine. On their own, deleting any of the six
# would leave the suite green — the closure would simply admit one fewer name.
# This is their positive gate, and the half of the closed fifteen-member
# enumeration that 7.7 does not cover.
ex:saProjectionContextDistributionAudiencesDeclared a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:consumerOfflineBook          a gmeow:ProjectionContext .
    gmeow:consumerPrintArchive         a gmeow:ProjectionContext .
    gmeow:consumerKnowledgeFederation  a gmeow:ProjectionContext .
    gmeow:consumerLinkedDataTooling    a gmeow:ProjectionContext .
    gmeow:consumerTypedModelClient     a gmeow:ProjectionContext .
    gmeow:consumerInteractiveConsole   a gmeow:ProjectionContext .
}""" ;
    gmeow:saRationale "The six documentation-distribution audiences the external documentation distribution catalog references — offline book, print archive, knowledge federation, linked-data tooling, typed-model client, interactive console — MUST each be declared a gmeow:ProjectionContext individual. They are the second half of the closed fifteen-member enumeration (Principle 9): ex:saProjectionContextSeedsDeclared pins the original nine and ex:saProjectionContextNoTenthMember closes the set, so without this assertion any of the six could be deleted and the catalog would reference a consumer the kernel no longer declares." .

# =============================================================================
# 8. Privacy / sensitivity axis — kernel parts (migrated from tests/test_privacy.py)
# =============================================================================

# --- 8.1 SensitivityLevel class structure (MUST hold) ------------------------
ex:saSensitivityLevelClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:SensitivityLevel a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:SensitivityLevel MUST be a universal logic:AbstractIndividualType owl:Class that is a subclass of logic:QualityValue — the open, ordered value vocabulary of privacy-sensitivity levels (public ≺ internal ≺ confidential ≺ restricted ≺ sensitive personal), never per-level subclasses (Principle 9)." .

# --- 8.2 hasSensitivity ObjectProperty structure (MUST) ----------------------
ex:saHasSensitivityProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasSensitivity a owl:ObjectProperty ;
        rdfs:range gmeow:SensitivityLevel .
}""" ;
    gmeow:saRationale "gmeow:hasSensitivity MUST be an owl:ObjectProperty with rdfs:range gmeow:SensitivityLevel — the universal privacy-sensitivity facet." .

# --- 8.3 hasSensitivity is domain-free and non-functional (MUST-NOT) ---------
ex:saHasSensitivityNotFunctionalOrDomained a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    { ?rec logic:characterizes gmeow:hasSensitivity ; logic:characteristicSort logic:functionalProperty . }
    UNION
    { gmeow:hasSensitivity rdfs:domain ?d . }
}""" ;
    gmeow:saRationale "gmeow:hasSensitivity MUST NOT be owl:FunctionalProperty (multi-source sensitivity classifications coexist, Principle 9) and MUST NOT have an rdfs:domain (domain-free/universal)." .

# --- 8.4 SensitivityLevel value vocabulary spans five seeds (MUST) -----------
ex:saSensitivitySeedsTyped a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:sensitivityPublic             a gmeow:SensitivityLevel .
    gmeow:sensitivityInternal           a gmeow:SensitivityLevel .
    gmeow:sensitivityConfidential       a gmeow:SensitivityLevel .
    gmeow:sensitivityRestricted         a gmeow:SensitivityLevel .
    gmeow:sensitivitySensitivePersonal  a gmeow:SensitivityLevel .
}""" ;
    gmeow:saRationale "The sensitivity space MUST be spanned by the five ordered seeds: public, internal, confidential, restricted, and sensitive personal — each a gmeow:SensitivityLevel individual with no privileged winner (Principle 9)." .

# --- 8.5 No sixth SensitivityLevel member in the kernel module (MUST-NOT) ----
ex:saSensitivityNoSixthMember a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?m a gmeow:SensitivityLevel .
    FILTER (
        ?m != gmeow:sensitivityPublic &&
        ?m != gmeow:sensitivityInternal &&
        ?m != gmeow:sensitivityConfidential &&
        ?m != gmeow:sensitivityRestricted &&
        ?m != gmeow:sensitivitySensitivePersonal
    )
}""" ;
    gmeow:saRationale "The kernel sensitivity vocabulary is a closed five-member enumeration (Principle 9): the kernel module MUST NOT declare any gmeow:SensitivityLevel individual other than the five seeds." .

# --- 8.6 hasSensitivity is orthogonal to other axes (MUST-NOT) ---------------
ex:saSensitivityOrthogonalToOtherAxes a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    {
        gmeow:hasSensitivity rdfs:subPropertyOf ?other .
        FILTER (?other IN (gmeow:hasDeterminacy, gmeow:confidence))
    } UNION {
        ?other rdfs:subPropertyOf gmeow:hasSensitivity .
        FILTER (?other IN (gmeow:hasDeterminacy, gmeow:confidence))
    } UNION {
        gmeow:hasSensitivity owl:equivalentProperty ?other .
        FILTER (?other IN (gmeow:hasDeterminacy, gmeow:confidence))
    } UNION {
        ?other owl:equivalentProperty gmeow:hasSensitivity .
        FILTER (?other IN (gmeow:hasDeterminacy, gmeow:confidence))
    }
}""" ;
    gmeow:saRationale "gmeow:hasSensitivity MUST NOT be entangled with gmeow:hasDeterminacy or gmeow:confidence via rdfs:subPropertyOf or owl:equivalentProperty — sensitivity is orthogonal to determinacy and confidence (Principle 9)." .

# --- 8.7 hasSensitivity is orthogonal to hasGranularity (MUST-NOT) -----------
ex:saSensitivityOrthogonalToGranularity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    {
        gmeow:hasSensitivity rdfs:subPropertyOf gmeow:hasGranularity .
    } UNION {
        gmeow:hasGranularity rdfs:subPropertyOf gmeow:hasSensitivity .
    } UNION {
        gmeow:hasSensitivity owl:equivalentProperty gmeow:hasGranularity .
    } UNION {
        gmeow:hasGranularity owl:equivalentProperty gmeow:hasSensitivity .
    }
}""" ;
    gmeow:saRationale "gmeow:hasSensitivity MUST NOT be entangled with gmeow:hasGranularity via rdfs:subPropertyOf or owl:equivalentProperty — sensitivity and granularity are distinct axes (Principle 9)." .

# =============================================================================
# 9. Universal mereology spine — kernel parts (migrated from tests/test_mereology.py)
# =============================================================================

# --- 9.1 partOf and hasPart are broad transitive inverses (MUST) -------------
ex:saUniversalPartPropertiesAreBroadTransitiveInverses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:partOf a owl:ObjectProperty , owl:TransitiveProperty ;
        owl:inverseOf gmeow:hasPart .
    gmeow:hasPart a owl:ObjectProperty , owl:TransitiveProperty ;
        owl:inverseOf gmeow:partOf .
}""" ;
    gmeow:saRationale "gmeow:partOf and gmeow:hasPart MUST each be an owl:ObjectProperty and owl:TransitiveProperty, and MUST be owl:inverseOf each other — the universal part/whole spine." .

# --- 9.2 partOf and hasPart are not functional and have no domain/range (MUST-NOT)
ex:saUniversalPartPropertiesNotFunctionalOrTyped a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    {
        ?rec logic:characterizes ?prop ; logic:characteristicSort logic:functionalProperty .
        FILTER (?prop IN (gmeow:partOf, gmeow:hasPart))
    } UNION {
        ?prop rdfs:domain ?d .
        FILTER (?prop IN (gmeow:partOf, gmeow:hasPart))
    } UNION {
        ?prop rdfs:range ?r .
        FILTER (?prop IN (gmeow:partOf, gmeow:hasPart))
    }
}""" ;
    gmeow:saRationale "gmeow:partOf and gmeow:hasPart MUST NOT be owl:FunctionalProperty and MUST NOT have rdfs:domain or rdfs:range — the spine is intentionally broad so event, location, information-object and endurant parthood all remain possible in OWL 2 DL." .

# =============================================================================
# 10. MentalMoment umbrella + proficiency vocabulary (migrated from
#     tests/test_cognition.py and tests/test_teleology.py)
# =============================================================================

# test_mental_moment_is_category_under_intrinsic_mode
ex:saMentalMomentIsCategoryUnderMode a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:MentalMoment a owl:Class , logic:Category ;
        rdfs:subClassOf logic:Mode .
}""" ;
    gmeow:saRationale "gmeow:MentalMoment MUST be an owl:Class typed logic:Category and a subclass of logic:Mode — the umbrella for all agent mental moments (cognition, doxastic, conative) lives in the kernel slice so it can be queried uniformly (Principle 15)." .

# test_proficiency_vocab_relocated_to_kernel
ex:saProficiencyVocabInKernel a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ProficiencyScale a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
    gmeow:ProficiencyLevel a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
    gmeow:ProficiencyModality a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:ProficiencyScale, gmeow:ProficiencyLevel, and gmeow:ProficiencyModality MUST be logic:AbstractIndividualType subclasses of logic:QualityValue and defined by the kernel slice — the domain-neutral proficiency ruler is minted in kernel so expertise, languages, and cognition reuse it without a cross-slice dependency cycle (Principle 6)." .

# test_intrinsic_modes_are_grounded (MentalMoment half)
ex:saMentalMomentGroundsIntrinsicModes a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:MentalMoment rdfs:subClassOf logic:Mode .
}""" ;
    gmeow:saRationale "gmeow:MentalMoment MUST subclass logic:Mode — this is the native-logic grounding that keeps IntentionalMode and other intrinsic modes transitively under Mode without a direct gufo:IntrinsicMode assertion." .

# =============================================================================
# 11. Connectivity universal spine (migrated from tests/test_connectivity.py)
# =============================================================================

# --- 11.1 connectsTo is a universal ObjectProperty (MUST) ---------------------
ex:saConnectsToIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:connectsTo a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:connectsTo MUST be an owl:ObjectProperty -- the universal traversable-link spine." .

# --- 11.2 connectsTo has no rdfs:domain or rdfs:range (MUST-NOT) --------------
ex:saConnectsToHasNoDomainRange a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    { gmeow:connectsTo rdfs:domain ?d . }
    UNION
    { gmeow:connectsTo rdfs:range ?r . }
}""" ;
    gmeow:saRationale "gmeow:connectsTo MUST NOT carry rdfs:domain or rdfs:range -- it is a universal spine." .

# --- 11.3 connectsTo is NOT symmetric (MUST-NOT) ------------------------------
ex:saConnectsToNotSymmetric a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:connectsTo a owl:SymmetricProperty . }""" ;
    gmeow:saRationale "gmeow:connectsTo MUST NOT be owl:SymmetricProperty -- subproperties decide their own directionality." .

# --- 11.4 connectsTo is NOT transitive (MUST-NOT) -----------------------------
ex:saConnectsToNotTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:connectsTo a owl:TransitiveProperty . }""" ;
    gmeow:saRationale "gmeow:connectsTo MUST NOT be owl:TransitiveProperty -- reachability is computed by the solver (Principle 12)." .
