msgstr "ex:record gmeow:commitmentOrigin \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|http://www.w3.org/2000/01/rdf-schema#label"
msgid "release reason"
msgstr "motif de libération"

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|http://www.w3.org/2004/02/skos/core#definition"
msgid "The verbatim source reason a self-commitment was released, attached to its closed IntentionTenure. Retain the actual interval end and history rather than erasing the intention or inventing an end date."
msgstr "Motif source textuel de libération d’un engagement envers soi, porté par son IntentionTenure fermé. Conserver la fin réelle de l’intervalle et l’historique sans effacer l’intention ni inventer de date."

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|https://blackcatinformatics.ca/gmeow/avoidWhen"
