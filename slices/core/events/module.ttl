gmeow:eventTypeBatMitzvah rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/events> .
gmeow:eventTypeFirstCommunion a gmeow:EventType ; rdfs:label "first communion"@x-gmeow-english ; skos:definition "A first communion."@x-gmeow-english .
gmeow:eventTypeFirstCommunion rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/events> .
gmeow:eventTypeAdoption       a gmeow:EventType ; rdfs:label "adoption"@x-gmeow-english ;       skos:definition "The adoption of a person."@x-gmeow-english .
gmeow:eventTypeAdoption rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/events> .
gmeow:eventTypeMarriage       a gmeow:EventType ; rdfs:label "marriage"@x-gmeow-english ;       skos:definition "The event of two persons entering into marriage."@x-gmeow-english .
