@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/sensory>
    a owl:Ontology ;
    rdfs:label "GMEOW Sensory Module"@en ;
    rdfs:comment "Sensor, sensor platform, observable property, and sensory observation stack. Deepens the SensoryObservation stub from observations.ttl with sensor-specific properties and bridges to SOSA/SSN by reference."@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# SENSOR — the observer/perceiver in the sensory domain (#126)
#
# A sensor is an agent that produces observations. It may be a physical device,
# a software process, or a biological perceiver. The existing gmeow:Agent →
# sosa:Sensor broadMatch alignment becomes precise here: a Sensor is a more
# specific kind of Agent that acts as vantage in a SensoryObservation.
# =========================================================================== #

gmeow:Sensor
    a owl:Class, gufo:RoleMixin ;
    rdfs:subClassOf gmeow:Agent, gufo:FunctionalComplex ;
    rdfs:label "Sensor"@en ;
    skos:definition "An agent that produces observations by responding to a stimulus — a physical device, a software process, or a biological perceiver. The observer in a sensory observation; the vantage of a SensoryObservation may be a Sensor, a person, or an organization. Co-equal: no sensor is privileged as the 'primary' observer (Principle 9)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# SENSOR PLATFORM — the physical carrier of sensors (#126)
#
# A platform hosts one or more sensors and is situated at a geographic place.
# Distinct from Sensor (which is the observing agent) and from Place (which is
# the location). Aligns to sosa:Platform by reference.
# =========================================================================== #

gmeow:SensorPlatform
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Sensor Platform"@en ;
    skos:definition "A physical entity that hosts one or more sensors — a weather station, a satellite, a buoy, a drone, a vehicle, or a building-mounted instrument. The platform is situated at a place and carries sensors that observe properties of the environment. Distinct from the Sensor itself (the observing agent) and from the Place (the location)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:platformLocation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:SensorPlatform ;
    rdfs:range gmeow:Place ;
    rdfs:label "platform location"@en ;
    skos:definition "The geographic place where a sensor platform is situated. A platform may have only one location at a time; historical locations are modelled as past SensoryObservations or LocationStates, not by changing this property (Principle 9)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# OBSERVABLE PROPERTY — what is being measured (#126)
#
# A value vocabulary (individuals, never subclasses) of physical, chemical,
# biological, or environmental properties that can be observed by a sensor.
# Aligns to sosa:ObservableProperty by reference.
# =========================================================================== #

gmeow:ObservableProperty
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Observable Property"@en ;
    skos:definition "A physical, chemical, biological, or environmental property that can be observed or measured by a sensor. A value vocabulary (individuals, never subclasses) so any new property — from temperature to neural activation to social sentiment — is a new individual, not a new class (Principle 9)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# Seeds — common environmental and physical observable properties.
gmeow:observablePropertyTemperature           a gmeow:ObservableProperty ; rdfs:label "temperature"@en ;           rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:observablePropertyHumidity              a gmeow:ObservableProperty ; rdfs:label "humidity"@en ;              rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:observablePropertyLightIntensity        a gmeow:ObservableProperty ; rdfs:label "light intensity"@en ;        rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:observablePropertySoundPressureLevel    a gmeow:ObservableProperty ; rdfs:label "sound pressure level"@en ;    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:observablePropertyAtmosphericPressure   a gmeow:ObservableProperty ; rdfs:label "atmospheric pressure"@en ;   rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:observablePropertyAirQualityIndex       a gmeow:ObservableProperty ; rdfs:label "air quality index"@en ;       rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:observablePropertyRadiationLevel        a gmeow:ObservableProperty ; rdfs:label "radiation level"@en ;         rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# SENSORY QUANTITY — the result of a sensory observation (#126)
#
# A domain-specific alias for the existing scalar-quantity facility. Following
# the #77 precedent (Quantity ≡ ScalarQuantity ≡ MeasuredValue), SensoryQuantity
# is the sensory-domain name for the same value×unit×determinacy bundle.
# =========================================================================== #

gmeow:SensoryQuantity
    a owl:Class, gufo:Kind ;
    owl:equivalentClass gmeow:ScalarQuantity ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Sensory Quantity"@en ;
    skos:definition "The scalar numeric result of a sensory observation — a value with unit, determinacy, and granularity. Equivalent to gmeow:ScalarQuantity (following the #77 alias precedent); the name 'SensoryQuantity' is the domain-specific label for the same construct in the sensor/observation stack."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# SENSORY OBSERVATION — deepen the observations.ttl stub (#126)
#
# The stub in observations.ttl declares SensoryObservation as a SubKind of
# Observation. Here we add sensor-specific properties and EL restrictions.
# =========================================================================== #

# Domain-specific property: the observable property being measured.
gmeow:sensoryProperty
    a owl:ObjectProperty ;
    rdfs:domain gmeow:SensoryObservation ;
    rdfs:range gmeow:ObservableProperty ;
    rdfs:label "sensory property"@en ;
    skos:definition "The observable property that a sensory observation measures — temperature, humidity, light intensity, etc. Distinct from gmeow:observationMethod (the procedure or protocol used); this names the property itself. A sensory observation concerns exactly one observable property per observation; multiple properties require multiple observations (Principle 9)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# Domain-specific subproperty of observationResult for the sensory result.
gmeow:sensoryResult
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:observationResult ;
    rdfs:domain gmeow:SensoryObservation ;
    rdfs:range gmeow:SensoryQuantity ;
    rdfs:label "sensory result"@en ;
    skos:definition "The scalar quantity result of a sensory observation — a value with unit, determinacy, and granularity. Subproperty of gmeow:observationResult so generic consumers can query all observation results without knowing the domain. The reference frame in which the quantity is expressed is carried on the observation via gmeow:hasReferenceFrame and propagates to the result via the existing isResultOf ∘ hasReferenceFrame chain."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# Domain-specific subproperty of observedFeature for the entity being observed.
gmeow:sensoryObservationOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:observedFeature ;
    rdfs:domain gmeow:SensoryObservation ;
    rdfs:range gmeow:Entity ;
    rdfs:label "sensory observation of"@en ;
    skos:definition "The entity whose property is being observed — the observedFeature of a sensory observation. Subproperty of gmeow:observedFeature so generic consumers can query all observations without knowing the domain."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasSensoryObservation
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:sensoryObservationOf ;
    rdfs:domain gmeow:Entity ;
    rdfs:range gmeow:SensoryObservation ;
    rdfs:label "has sensory observation"@en ;
    skos:definition "Links an entity to a sensory observation that measured one of its properties. Non-functional: multiple sensors may observe the same property of the same entity, and those readings coexist without collapse (Principle 9)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# EL axiomatisation: every SensoryObservation mediates at least one vantage,
# one observed feature, one observable property, and one result.
gmeow:SensoryObservation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:vantage           ; owl:someValuesFrom gmeow:Agent             ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:sensoryObservationOf ; owl:someValuesFrom gmeow:Entity          ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:sensoryProperty   ; owl:someValuesFrom gmeow:ObservableProperty ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:sensoryResult     ; owl:someValuesFrom gmeow:SensoryQuantity     ] .

# =========================================================================== #
# AXIOMATIZED DOCTRINE (#126) — property chain for flat shortcut
#
# hasSensoryQuantity is a flat shortcut derived from the reified observation
# path. Expressed as:
#   hasSensoryObservation ∘ sensoryResult ⊑ hasSensoryQuantity
#
# This is OWL 2 DL regular because sensoryResult is a simple property (no
# transitivity, symmetry, or inverse), and the chain is the regular R ∘ S ⊑ T
# form. hasSensoryQuantity thereby becomes non-simple and is kept out of all
# cardinality axioms.
# =========================================================================== #

gmeow:hasSensoryQuantity
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:range gmeow:SensoryQuantity ;
    rdfs:label "has sensory quantity"@en ;
    skos:definition "Flat shortcut linking an entity to the scalar quantity result of a sensory observation of its property. Derived via property chain from the reified observation path (hasSensoryObservation ∘ sensoryResult). Non-simple: kept out of cardinality axioms."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasSensoryQuantity owl:propertyChainAxiom ( gmeow:hasSensoryObservation gmeow:sensoryResult ) .
