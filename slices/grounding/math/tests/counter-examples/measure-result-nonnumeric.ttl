@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex: <http://example.org/math/> .

ex:evaluation a math:MeasureEvaluation ; math:evaluatedMeasure ex:measure ;
    math:measuredSubset ex:subset ; math:measureResult "not a mass" .
ex:measure a math:Measure ; math:measureOn ex:space ; math:totalMass math:PositiveInfinity .
ex:space a math:MeasurableSpace .
ex:subset a math:MeasurableSet .
