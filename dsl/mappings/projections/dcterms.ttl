gmeow:mapDctermsLanguage a gmeow:ProjectionMapping ;
    rdfs:label "nameLanguage → dcterms:language (anchored on work)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "work" ; gmeow:value "lang" ;
        gmeow:atom (
            [ gmeow:subjectVar "work" ;
              gmeow:path [ a gmeow:AltPath ; gmeow:pathAlts ( gmeow:hasAppellation gmeow:hasName gmeow:hasTitle ) ] ;
              gmeow:objectVar "name" ]
            [ gmeow:subjectVar "name" ; gmeow:predicate gmeow:nameLanguage ; gmeow:objectVar "lang" ]
        ) ;
        gmeow:edoalSource gmeow:nameLanguage ] ;
    gmeow:hasBinding [ gmeow:profile "dcterms" ; gmeow:toPredicate dcterms:language ; gmeow:relation "=" ; gmeow:confidence 0.8 ] .

