<https://blackcatinformatics.ca/gmeow/slices/creative-works>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """The WEMI spine for creative and intellectual works — Work, Expression,
Manifestation, Item — reconstructed from native GMEOW primitives (frame-relativity,
reified events, relators, standpoints) and bridged to FRBR/LRMoo/CIDOC/schema.org
by reference (Principle 5), never by axiom import.

DOCTRINE.
  * The four tiers are gufo:Kinds with distinct identity criteria (Work=abstract
    content, Expression=language/notation frame, Manifestation=edition/format,
    Item=single copy); CreativeWork is the gufo:Category umbrella over them.
  * Expression variance is carried by gmeow:hasReferenceFrame (language, script,
    notation, arrangement) — never a subclass taxonomy (Principle 9).
  * Creation is a reified gmeow:Event with an eventType value — no Event subclasses
    (Principle 12).
  * Contribution is a reified gmeow:Relator with flat shortcuts for the 80% case
    (flat-first, reify-on-demand).
  * Format, role, genre, and medium are open value vocabularies (individuals),
    never subclasses (Principle 9).
  * No primary/privileged title or edition (Principle 9); suppressed titles and
    withdrawn standpoints use gmeow:displayable false (Principle 10).
  * Complex lineage (translations-as-versions, collected volumes, withdrawn
    releases) reuses the generic VersionSet / VersionMembership machinery."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/creative-works> ;
    rdfs:label "GMEOW Creative Works Module"@x-gmeow-english ;
    skos:definition "The GMEOW Creative Works Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# FRBR spine integrity: every gmeow:Manifestation embodies at                  #
# least one gmeow:Expression. Migrated from the hand-authored                  #
# gmeow:ManifestationEmbodiesExpressionShape gmeow:embodies min-count property #
# constraint to a compact logic: disjunctive-requiredness record, projected to #
# a sh:SPARQLConstraint keyed onto gmeow:Manifestation (its sh:targetClass      #
# follows rdfs:subClassOf, so a subclass instance — a gmeow:MediaObject — is    #
# selected too).                                                                #
# =========================================================================== #

gmeow:ManifestationEmbodiesRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Manifestation embodies requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/creative-works> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world FRBR spine-integrity constraint: every gmeow:Manifestation must embody at least one gmeow:Expression through gmeow:embodies."@x-gmeow-english ;
    logic:onClass gmeow:Manifestation ;
    logic:anyOf gmeow:embodies ;
    logic:formalizes gmeow:Manifestation ;
    logic:message "Every Manifestation must embody at least one Expression (gmeow:embodies)." .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/Contribution> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/contributionRole> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/Contribution> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/contributionTarget> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/Contribution> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/contributor> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/Item> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/exemplifies> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Manifestation> ] .
<https://blackcatinformatics.ca/gmeow/Manifestation> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/embodies> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Expression> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Contribution> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/contributionRole" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Contribution> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/contributionTarget" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Contribution> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/contributor" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Item> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/exemplifies" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Manifestation> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/embodies" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .

# WEMI spine integrity: every Expression realizes at least one Work
# (gmeow:realizes, values typed gmeow:Work — subclass instances such as a
# gmeow:MusicalWork satisfy it under the reasoned closure). Same grounding
# style as the sibling spine axioms above: universal type via
# logic:allValuesFrom, existence via the class-scoped closed-world authority.
<https://blackcatinformatics.ca/gmeow/Expression> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/realizes> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Work> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Expression> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/realizes" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .

# gmeow:contributionDegree is optional but single-valued per Contribution
# (min 0 / max 1). The qualified idiom (logic:onClass owl:Thing) degrades to the
# unqualified sh:minCount 0 / sh:maxCount 1 the retired hand-authored shape
# enforced, staying inside the fragment the native reasoner decides.
gmeow:Contribution logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:contributionDegree ; logic:minQualifiedCardinality 0 ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:contributionDegreeFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/creative-works> ;
    rdfs:label "contributionDegree is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:contributionDegree is functional: a contribution carries at most one degree weight — lead, equal, or supporting — so the relator takes a single degree (or none when unknown) and disputed credit orderings live on the statement layer rather than as rival degrees on one Contribution."@x-gmeow-english ;
    logic:characterizes gmeow:contributionDegree ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:contributionDegree ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:contributionDegree names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:contributionDegree, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:contributionDegree and nothing else. It is not a definition of gmeow:contributionDegree (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:contributionDegreeFunctionality logic:characterizes gmeow:contributionDegree ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:contributionRoleFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/creative-works> ;
    rdfs:label "contributionRole is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:contributionRole is functional: a Contribution relator names the one role the contributor played, so an agent acting in two roles is recorded as two Contributions rather than one relator bearing several roles."@x-gmeow-english ;
    logic:characterizes gmeow:contributionRole ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:contributionRole ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:contributionRole names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:contributionRole, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:contributionRole and nothing else. It is not a definition of gmeow:contributionRole (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:contributionRoleFunctionality logic:characterizes gmeow:contributionRole ."@x-gmeow-english ;
