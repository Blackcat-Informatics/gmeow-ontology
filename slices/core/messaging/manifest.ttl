<https://blackcatinformatics.ca/gmeow/slices/messaging>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/messaging> ;
    gmeow:sliceTier gmeow:tierCore ;
    rdfs:label "messaging"@x-gmeow-english ;
    skos:definition "Shared communicative artifacts, body parts, conversation links, explicit failure outcomes and digest-identified content references for email and chat."@x-gmeow-english ;
    dcterms:title "GMEOW Messaging Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Message archives and governed conversation stores retaining intended communication, source content identity and explicit outcomes independently of transport success."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceDependsOn <https://blackcatinformatics.ca/gmeow/slices/creative-works>,
        <https://blackcatinformatics.ca/gmeow/slices/logic>,
        <https://blackcatinformatics.ca/gmeow/slices/kernel>,
        <https://blackcatinformatics.ca/gmeow/slices/record-metadata>,
        <https://blackcatinformatics.ca/gmeow/slices/documents>,
        <https://blackcatinformatics.ca/gmeow/slices/sources>,
        <https://blackcatinformatics.ca/gmeow/slices/provenance>,
        <https://blackcatinformatics.ca/gmeow/slices/imagination>,
        <https://blackcatinformatics.ca/gmeow/slices/tags> .
