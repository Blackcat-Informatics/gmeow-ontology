@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .

# Closed-world twins for the agentic slice's OWL-functional properties
#: OWL functionality only infers sameness; these maxCounts make a
# double-valued record a VIOLATION instead.

gmeow:ToolCallShape
    a sh:NodeShape ;
    rdfs:label "Tool call record shape"@x-gmeow-english ;
    skos:definition "Closed-world half of the ToolCall record: at most one requesting invocation, one tool agent, one verbatim arguments payload, and one verbatim result payload per call — a multi-tool turn is several ToolCalls, never one fat one."@x-gmeow-english;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agentic> ;
    sh:targetClass gmeow:ToolCall ;
    sh:property [
        sh:path gmeow:calledByInvocation ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:ModelInvocation ;
        sh:message "A ToolCall has at most one requesting model invocation (functional; optional when the harness cannot supply it)."@x-gmeow-english ;
    ] ;
    sh:property [
        sh:path gmeow:usedTool ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:SoftwareAgent ;
        sh:message "A ToolCall uses exactly one tool agent — a call without a tool is not a call, and a multi-tool turn is several ToolCalls."@x-gmeow-english ;
    ] ;
    sh:property [
        sh:path gmeow:toolArguments ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message "One verbatim arguments payload per call, as a literal (large payloads: a content digest literal instead)."@x-gmeow-english ;
    ] ;
    sh:property [
        sh:path gmeow:toolResult ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:message "One verbatim result payload per call, as a literal — produced ENTITIES link back via gmeow:wasGeneratedBy (P5), never forward from the call."@x-gmeow-english ;
    ] .
