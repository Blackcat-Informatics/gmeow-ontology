#
# Fail-witness for ex:saNoSecondExecutionConcept: a locally-minted execution
# class, which is exactly the second process model the retirement removed.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

gmeow:WorkExecution a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/work-orchestration> .
