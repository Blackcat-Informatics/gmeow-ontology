#
# Well-formed: an intensional set whose member condition denotes a logic: formula
# (a resource, the denotation seam). Conforms to math:IntensionalSetShape. Bound by
# ex:ecIntensionalSet.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <http://example.org/math/> .

ex:evenNumbers a math:SetBuilderExpression ;
    math:memberCondition ex:evenFormula .

ex:evenFormula a logic:Formula ;
    rdfs:label "x mod 2 = 0"@x-gmeow-english ;
    logic:relation ex:isEvenRelation ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "x" ] .
