#
# Declarative competency question for the logic slice (crates/slicetest):
# does GMEOW's logic:PathShape actually support bounded-depth traversal — the
# headline capability that SPARQL §9 property paths lack?
#
# This question overlays a synthetic ABox (path-traversal.ttl) and runs a
# depth-bounded SPARQL property-path query over it.  The expected result is exactly
# {ex:orgB, ex:orgC}; ex:orgD is 3 hops away and must NOT appear (cqExactRows true
# pins the closed set).
#
# Rust-first linkage (CR7): logic:nearbyOrgs (pathStepPredicate
# ex:linkedTo, pathMinDepth 1, pathMaxDepth 2) projects to the EXTENDED SPARQL path
# `<...linkedTo>{1,2}`.  A `{m,n}` quantifier is the §9 construct standard SPARQL
# engines cannot parse, so the competency runner (oxigraph) executes the licensed
# standard-SPARQL down-projection `(ex:linkedTo|ex:linkedTo/ex:linkedTo)` in
# named-parametric-paths.rq, semantically identical for maxDepth 2.  The Rust golden
# `nearby_orgs_projection_emits_pinned_bounded_path` (crates/logic,
# projections/paths/tests.rs) pins the lossless `{1,2}` projection output so a
# projection drift fails a test rather than silently passing this CQ.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/logic/tests/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix fx:    <http://example.org/logic/> .
@prefix ir:    <https://blackcatinformatics.ca/gmeow/examples/logic/> .

ex:cqNamedParametricPaths a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/logic/queries/competency/named-parametric-paths.rq" ;
    gmeow:cqDataFile  "tests/fixtures/path-traversal.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A named, parametric, depth-bounded path (logic:PathShape) with pathMaxDepth 2 applied to a four-node chain A→B→C→D must return exactly {B, C}; D is 3 hops away and must be excluded (bounded traversal, not unbounded closure)." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqNamedParametricPathsShape ;
    gmeow:cqExpectRow ex:rowOrgB, ex:rowOrgC .

ex:cqNamedParametricPathsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "neighbor" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowOrgB a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "neighbor" ; gmeow:cellValueIri ex:orgB ] .

ex:rowOrgC a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "neighbor" ; gmeow:cellValueIri ex:orgC ] .

# ── Composition-contract dogfood ────────────────────────────────────────────────
#
# A second question that declares gmeow:cqConsumes ex:cqNamedParametricPaths,
# proving the composition pre-check mechanism end-to-end:
#   1. ex:cqNamedParametricPaths produces ex:cqNamedParametricPathsShape
#      {neighbor:IRI required}.
#   2. ex:cqNeighborOriginsInputShape declares the same column — the producer
#      satisfies the input contract.
#   3. The harness verifies this BEFORE running the query.
#
# The query itself selects all subjects that have any outgoing ex:linkedTo edge.
# Over the four-node fixture (A→B→C→D) the subjects are {orgA, orgB, orgC};
# orgD has no outgoing link.

ex:cqNeighborOrigins a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX ex: <https://blackcatinformatics.ca/gmeow/examples/logic/tests/> SELECT ?neighbor WHERE { ?neighbor ex:linkedTo ?target } ORDER BY ?neighbor" ;
    gmeow:cqDataFile  "tests/fixtures/path-traversal.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Every node with an outgoing ex:linkedTo edge is a potential traversal origin; the fixture chain A→B→C→D has exactly three such origins (A, B, C) — D has no outgoing link. This question depends on the upstream bounded-path question via gmeow:cqConsumes and exercises the composition pre-check: the producer's result shape must satisfy this question's declared input shape before execution." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqNeighborOriginsShape ;
    gmeow:cqInputShape  ex:cqNeighborOriginsInputShape ;
    gmeow:cqConsumes    ex:cqNamedParametricPaths ;
    gmeow:cqExpectRow   ex:rowOrgA2, ex:rowOrgB2, ex:rowOrgC2 .

ex:cqNeighborOriginsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "neighbor" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

# The declared INPUT contract: what this question requires from its producer.
# A single {neighbor:IRI required} column — exactly what ex:cqNamedParametricPathsShape
# provides, so is_satisfiable_by passes.
ex:cqNeighborOriginsInputShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "neighbor" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowOrgA2 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "neighbor" ; gmeow:cellValueIri ex:orgA ] .

ex:rowOrgB2 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "neighbor" ; gmeow:cellValueIri ex:orgB ] .

ex:rowOrgC2 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "neighbor" ; gmeow:cellValueIri ex:orgC ] .

# ── Typed formalization governance ──────────────────────────────────────────────
#
# Does GMEOW record, per formalization candidate, the CATEGORY of force its prose
# carried — and does the candidate population span several of the eleven closed
# categories? The query runs over the merged ontology (every production candidate)
# unioned with the governance example data. The governance-example candidates
# contribute derivation-rule, documentation-only, integrity-constraint,
# non-entailment-obligation and typicality; the production foundational-partition
# candidates additionally contribute necessary-condition (the two class coverings)
# and deliberate-overlap (the preserved social∩information non-assertion). Seven
# distinct categories in all; cqExactRows pins that set, proving the per-category
# coverage surface (the supersession of a single global %) is queryable.

ex:cqFormalizationCandidateCategories a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/logic/queries/competency/formalization-candidate-categories.rq" ;
    gmeow:cqDataFile  "examples/formalization-governance.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Every logic:FormalizationCandidate records its logic:candidateCategory; coverage is reported per category, never as one global %. Over the merged ontology plus the governance example data the candidate population spans exactly eight distinct categories — derivation-rule, documentation-only, integrity-constraint, non-entailment-obligation, typicality, necessary-condition (the foundational-partition class coverings and the deception-family necessary conditions), deliberate-overlap (the preserved social∩information overlap) and equivalence-definition (the deception-family defined classes — falsehood-as-refuted-claim and the bullshit modality) — so a SELECT DISTINCT over the candidate categories must return exactly those eight." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqFormalizationCandidateCategoriesShape ;
    gmeow:cqExpectRow
        ex:rowCatDerivationRule, ex:rowCatDocumentationOnly, ex:rowCatIntegrityConstraint,
        ex:rowCatNonEntailmentObligation, ex:rowCatTypicality,
        ex:rowCatNecessaryCondition, ex:rowCatDeliberateOverlap,
        ex:rowCatEquivalenceDefinition .

ex:cqFormalizationCandidateCategoriesShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "category" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowCatDerivationRule a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryDerivationRule ] .

ex:rowCatDocumentationOnly a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryDocumentationOnly ] .

ex:rowCatIntegrityConstraint a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryIntegrityConstraint ] .

ex:rowCatNonEntailmentObligation a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryNonEntailmentObligation ] .

ex:rowCatTypicality a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryTypicality ] .

ex:rowCatNecessaryCondition a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryNecessaryCondition ] .

ex:rowCatDeliberateOverlap a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryDeliberateOverlap ] .

ex:rowCatEquivalenceDefinition a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "category" ; gmeow:cellValueIri logic:CategoryEquivalenceDefinition ] .

# ── Keystone invariant: the bare superproperty yields no cross-type inference ─────
#
# The typed accessibility relations are sub-relations of logic:accessibleFrom in
# PROSE ONLY: none is asserted rdfs:subPropertyOf it, because that edge would let an
# inference walk the bare superproperty across contexts of different types and
# conclude something the typed semantics forbid (believed → true, in-fiction →
# actual, ideal → is). A structural MUST-NOT guards the asserted graph; this
# question hardens the same invariant under FULL RDFS CLOSURE (reasoningRdfs runs
# rdfs5 subPropertyOf transitivity over the merged ontology), so even a *transitive*
# subproperty chain — which an asserted-graph check would miss — would surface here
# as a non-empty row and fail. The expected answer is the empty set: after RDFS
# materialization, no typed relation is a subproperty of logic:accessibleFrom.
#
# Scope: this is a schema-closure sentinel for the subproperty mechanism, the only
# RDFS-level route to cross-type folding. The harness's RDFS lane materializes the
# merged TBox and takes no instance ABox, so instance-level modal evaluation (e.g. a
# necessity walk over accessibleFrom) is not exercised here; that machinery lives in
# the native engine and is kept apart from the typed relations by construction.
ex:cqKeystoneNoCrossTypeSuperproperty a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/> PREFIX logic: <https://blackcatinformatics.ca/logic/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?typed WHERE { VALUES ?typed { logic:epistemicallyPossible logic:doxasticallyAccessible logic:deonticallyIdeal logic:temporallySucceeds logic:counterfactuallyCloser gmeow:sharpens } ?typed rdfs:subPropertyOf logic:accessibleFrom }" ;
    gmeow:cqReasoning gmeow:reasoningRdfs ;
    gmeow:cqRationale "All six typed accessibility relations — the five logic: kernel relations plus gmeow:sharpens — MUST NOT be rdfs:subPropertyOf logic:accessibleFrom even after RDFS closure (rdfs5 transitivity); the bare superproperty licenses no cross-type entailment, so this query returns the empty set. gmeow:sharpens is included because an asserted or inferred gmeow:sharpens rdfs:subPropertyOf logic:accessibleFrom would reopen the cross-type path for standpoint contexts." ;
    gmeow:cqResultShape ex:cqKeystoneNoCrossTypeSuperpropertyShape ;
    gmeow:cqExpectRowCount 0 .

ex:cqKeystoneNoCrossTypeSuperpropertyShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "typed" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ;
    logic:shapeRowCount 0 .

# ── Harvest coverage ──────────────────────────────────────────────────────────
#
# Is bidirectional prose→axiom harvest coverage actually QUERYABLE, not just
# authored? Each accepted logic:FormalizationCandidate that carries a harvest
# back-link (logic:candidateFormalizes + logic:candidateSourceField) ties a
# harvested axiom to the exact prose it formalized: the term, the prose field
# kind, and the annotation property that field stands for. Over the production
# ontology (the merged logic module, no synthetic data file) exactly twenty-four accepted
# candidates carry the full back-link:
#   - logic:candidateProperPartOfAsymmetric   (formalizing logic:properPartOf,   skos:definition)
#   - logic:candidateFunctionalComplexKindDisjoint (formalizing logic:FunctionalComplex, skos:definition)
#   - logic:candidateEndurantPerdurantDisjoint (formalizing logic:Endurant,       skos:definition)
#   - logic:candidateSocialInformationOverlap  (formalizing gmeow:SocialObject,    skos:definition)
#   - logic:candidateRelatorMediation          (formalizing logic:Relator,        skos:definition)
#   - logic:candidateTopSortalDisjoint         (formalizing gmeow:PhysicalObject,  gmeow:avoidWhen)
#   - logic:candidateDeceptionHeldProjectedDivergence (formalizing gmeow:eventTypeDeception, skos:definition)
#   - logic:candidateFalsehoodIsRefutedClaim   (formalizing gmeow:refuted,        skos:definition)
#   - logic:candidateLicensedFalsehoodNotDeception (formalizing gmeow:veridicalityLicensedFalsehood, skos:definition)
#   - logic:candidateBullshitTruthIndifference (formalizing gmeow:bullshit,       skos:definition)
#   - logic:candidateIndirectContributor       (formalizing gmeow:indirectContributor, skos:definition)
#   - logic:candidateInstantiatesWork          (formalizing gmeow:instantiatesWork, skos:definition)
#   - logic:candidateOrgMembershipPropagation  (formalizing gmeow:memberOf,        skos:definition)
#   - logic:candidateTenureClaimSurfacing      (formalizing gmeow:StandpointTenure, skos:definition)
#   - logic:candidateIntentNotEntailed         (formalizing gmeow:deceptiveIntentClaim, gmeow:avoidWhen)
#   - logic:candidateCounterpartNonTransitive  (formalizing gmeow:counterpartOf,   skos:definition)
#   - logic:candidateFrameRelativity           (formalizing logic:referenceFrame,  skos:definition)
#   - logic:candidateNoOverTyping              (formalizing logic:MixIden,         skos:definition)
#   - logic:candidateGateFatalVerdict          (formalizing gmeow:findingGateVerdict, skos:definition)
#   - logic:candidateFindingTraces             (formalizing gmeow:findingAntecedent, skos:definition)
#   - logic:candidateFindingRootCause          (formalizing gmeow:findingRootCause, skos:definition)
#   - logic:candidateFindingCluster            (formalizing gmeow:FindingCluster,  skos:definition)
#   - logic:candidateCrossNodeGlut             (formalizing gmeow:findingAnchor,   skos:definition)
#   - logic:candidateDiagnosticMetaExtensibility (formalizing gmeow:DiagnosticMetaRule, skos:definition)
# The foundational-partition candidates for Event/Situation and the two class
# coverings (Entity, Object) carry NO harvest back-link and therefore do not appear
# here. This set demonstrates both prose-field kinds: twenty-two sourced from a
# logic:ProseFieldDefinition (skos:definition) and two from a logic:ProseFieldAvoidWhen
# (gmeow:avoidWhen).

ex:cqHarvestCoverage a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/logic/queries/competency/harvest-coverage.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Bidirectional prose→axiom harvest coverage must be queryable: each accepted FormalizationCandidate ties to the exact prose it formalized, identified by the term it formalizes, the prose field kind it was sourced from, and the annotation property that field stands for. Over the production ontology exactly twenty-four accepted candidates carry the full harvest back-link — twenty-two sourced from a term's skos:definition and two from a term's gmeow:avoidWhen." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqHarvestCoverageShape ;
    gmeow:cqExpectRow ex:rowHarvestProperPart, ex:rowHarvestFunctionalComplex,
        ex:rowHarvestEndurantPerdurant, ex:rowHarvestSocialInformation,
        ex:rowHarvestRelatorMediation, ex:rowHarvestTopSortal,
        ex:rowHarvestDeception, ex:rowHarvestFalsehood,
        ex:rowHarvestLicensedFalsehood, ex:rowHarvestBullshit,
        ex:rowHarvestIndirectContribution, ex:rowHarvestWemiInstantiation,
        ex:rowHarvestOrgMembership, ex:rowHarvestTenureClaim,
        ex:rowHarvestIntentNotEntailed, ex:rowHarvestCounterpartNonTransitive,
        ex:rowHarvestFrameRelativity, ex:rowHarvestNoOverTyping,
        ex:rowHarvestGateFatalVerdict, ex:rowHarvestFindingTraces,
        ex:rowHarvestFindingRootCause, ex:rowHarvestFindingCluster,
        ex:rowHarvestCrossNodeGlut, ex:rowHarvestDiagnosticMetaExtensibility .

ex:cqHarvestCoverageShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "candidate" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "term" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "field" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "fieldProperty" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHarvestProperPart a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "candidate" ; gmeow:cellValueIri logic:candidateProperPartOfAsymmetric ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:properPartOf ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "field" ; gmeow:cellValueIri logic:ProseFieldDefinition ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "fieldProperty" ; gmeow:cellValueIri skos:definition ] .

ex:rowHarvestFunctionalComplex a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "candidate" ; gmeow:cellValueIri logic:candidateFunctionalComplexKindDisjoint ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:FunctionalComplex ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "field" ; gmeow:cellValueIri logic:ProseFieldDefinition ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "fieldProperty" ; gmeow:cellValueIri skos:definition ] .

ex:rowHarvestEndurantPerdurant a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "candidate" ; gmeow:cellValueIri logic:candidateEndurantPerdurantDisjoint ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:Endurant ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "field" ; gmeow:cellValueIri logic:ProseFieldDefinition ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "fieldProperty" ; gmeow:cellValueIri skos:definition ] .

ex:rowHarvestSocialInformation a gmeow:ExpectedRow ;
