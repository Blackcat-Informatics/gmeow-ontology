    gmeow:avoidWhen "Avoid treating a satisfied record law as executed detection, correct suppression, authenticated source text or external inventory completeness."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the supplied record and retain source evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "Predicate closure is distinct from required-path and value constraints. Independent RDF 1.2 statement reifiers can carry richer evidence without putting unknown fields on the closed record."@x-gmeow-english ;
    skos:example "gmeow:CueEvalCaseClosedRecordConstraint logic:formalizes gmeow:CueEvalCase . names the supplied-record law."@x-gmeow-english ;
    logic:formalizes gmeow:CueEvalCase ;
    logic:message "A CueEvalCase record uses only its declared fields and the admitted type, attribution, provenance and descriptive metadata predicates." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CueEvalCase ] ] ; logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "predicate" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:linkVia ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "predicate" ], [ logic:termIndex 2 ; logic:termVariable "value" ] ], [ a logic:Formula ; logic:not [ a logic:Formula ; logic:relation logic:termIn ; logic:argument [ logic:termIndex 0 ; logic:termVariable "predicate" ], [ logic:termIndex 1 ; logic:termIri rdf:type ], [ logic:termIndex 2 ; logic:termIri rdfs:label ], [ logic:termIndex 3 ; logic:termIri rdfs:comment ], [ logic:termIndex 4 ; logic:termIri rdfs:isDefinedBy ], [ logic:termIndex 5 ; logic:termIri gmeow:description ], [ logic:termIndex 6 ; logic:termIri gmeow:graphBoxRole ], [ logic:termIndex 7 ; logic:termIri gmeow:accordingTo ], [ logic:termIndex 8 ; logic:termIri gmeow:wasAttributedTo ], [ logic:termIndex 9 ; logic:termIri gmeow:wasDerivedFrom ], [ logic:termIndex 10 ; logic:termIri gmeow:versionOf ], [ logic:termIndex 11 ; logic:termIri gmeow:versionLabel ], [ logic:termIndex 12 ; logic:termIri gmeow:contentDigest ], [ logic:termIndex 13 ; logic:termIri gmeow:evalCue ], [ logic:termIndex 14 ; logic:termIri gmeow:evalText ], [ logic:termIndex 15 ; logic:termIri gmeow:evalMatch ], [ logic:termIndex 16 ; logic:termIri gmeow:machineryAdmittedBy ], [ logic:termIndex 17 ; logic:termIri gmeow:machineryForReader ] ] ] ] ] ] ] ] .

gmeow:CueJudgementClosedRecordConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "CueJudgement closed record"@x-gmeow-english ;
    skos:definition "A CueJudgement record uses only its declared fields and the admitted type, attribution, provenance and descriptive metadata predicates."@x-gmeow-english ;
    gmeow:useWhen "Use to check CueJudgement closed record on the retained CueJudgement record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a satisfied record law as executed detection, correct suppression, authenticated source text or external inventory completeness."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the supplied record and retain source evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "Predicate closure is distinct from required-path and value constraints. Independent RDF 1.2 statement reifiers can carry richer evidence without putting unknown fields on the closed record."@x-gmeow-english ;
    skos:example "gmeow:CueJudgementClosedRecordConstraint logic:formalizes gmeow:CueJudgement . names the supplied-record law."@x-gmeow-english ;
    logic:formalizes gmeow:CueJudgement ;
    logic:message "A CueJudgement record uses only its declared fields and the admitted type, attribution, provenance and descriptive metadata predicates." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CueJudgement ] ] ; logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "predicate" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:linkVia ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "predicate" ], [ logic:termIndex 2 ; logic:termVariable "value" ] ], [ a logic:Formula ; logic:not [ a logic:Formula ; logic:relation logic:termIn ; logic:argument [ logic:termIndex 0 ; logic:termVariable "predicate" ], [ logic:termIndex 1 ; logic:termIri rdf:type ], [ logic:termIndex 2 ; logic:termIri rdfs:label ], [ logic:termIndex 3 ; logic:termIri rdfs:comment ], [ logic:termIndex 4 ; logic:termIri rdfs:isDefinedBy ], [ logic:termIndex 5 ; logic:termIri gmeow:description ], [ logic:termIndex 6 ; logic:termIri gmeow:graphBoxRole ], [ logic:termIndex 7 ; logic:termIri gmeow:accordingTo ], [ logic:termIndex 8 ; logic:termIri gmeow:wasAttributedTo ], [ logic:termIndex 9 ; logic:termIri gmeow:wasDerivedFrom ], [ logic:termIndex 10 ; logic:termIri gmeow:versionOf ], [ logic:termIndex 11 ; logic:termIri gmeow:versionLabel ], [ logic:termIndex 12 ; logic:termIri gmeow:contentDigest ], [ logic:termIndex 13 ; logic:termIri gmeow:vantage ], [ logic:termIndex 14 ; logic:termIri gmeow:cueVerdict ], [ logic:termIndex 15 ; logic:termIri gmeow:judgedMatch ], [ logic:termIndex 16 ; logic:termIri gmeow:judgedCase ], [ logic:termIndex 17 ; logic:termIri gmeow:spanStart ], [ logic:termIndex 18 ; logic:termIri gmeow:spanEnd ], [ logic:termIndex 19 ; logic:termIri gmeow:observedFeature ], [ logic:termIndex 20 ; logic:termIri gmeow:observedAt ], [ logic:termIndex 21 ; logic:termIri gmeow:observationMethod ], [ logic:termIndex 22 ; logic:termIri gmeow:observationResult ], [ logic:termIndex 23 ; logic:termIri gmeow:machineryAdmittedBy ], [ logic:termIndex 24 ; logic:termIri gmeow:machineryForReader ] ] ] ] ] ] ] ] .

# Explicitly selected grounding policies and reader-specific operational records.

gmeow:GroundingRuleSet
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Grounding Rule Set"@x-gmeow-english ;
    skos:definition "A named nonempty collection of actual logic:Rule declarations selected to derive cue grounding over a reader's supplied facts in one declared interpretation. Membership names executable rule structure, not prose guidance or a ReasoningProgram."@x-gmeow-english ;
    gmeow:useWhen "Use to expose the precise rules a selected cue-grounding operation must evaluate."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting set membership as proof that rules were compiled, executed or evaluated over complete facts."@x-gmeow-english ;
    gmeow:howToUse "Supply at least one groundingRule with real head/body reifiers and retain supplied version, source and reader/world provenance. Unsupported rule capabilities must fail explicitly."@x-gmeow-english ;
    skos:scopeNote "Rule selection and input/world selection are separate mandatory operation inputs. The set does not import other worlds, close an external store or turn all rules in a vocabulary into an active program."@x-gmeow-english ;
    skos:example "ex:policy a gmeow:GroundingRuleSet ; gmeow:groundingRule ex:rule . names a collection whose member must carry an actual logic:Rule AST."@x-gmeow-english .

gmeow:cueGrounding
    a logic:ObjectProperty ;
    logic:domain gmeow:Cue ;
    logic:range gmeow:GroundingRuleSet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "cue grounding rules"@x-gmeow-english ;
    skos:definition "The declared GroundingRuleSet selected for this Cue. At most one set is allowed locally; absence does not license inventing a grounding result or substituting detection guidance for rules."@x-gmeow-english ;
    gmeow:useWhen "Use to identify the complete declared grounding policy for a cue."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a rule-set link as an evaluation receipt or as a change to cue evidence polarity."@x-gmeow-english ;
    gmeow:howToUse "Name the actual set and preserve the exact cue release when supplied; evaluate its selected rules over the caller's chosen facts and world."@x-gmeow-english ;
    skos:scopeNote "The local maximum bounds sets per cue without requiring a set or identifying different cues that share one. A released cue's changed grounding declaration requires a new release."@x-gmeow-english ;
    skos:example "ex:cue gmeow:cueGrounding gmeow:operationalCueGrounding . selects the named policy without claiming it ran."@x-gmeow-english .

gmeow:groundingRule
    a logic:ObjectProperty ;
    logic:domain gmeow:GroundingRuleSet ;
    logic:range logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "grounding rule"@x-gmeow-english ;
    skos:definition "An actual logic:Rule member of a GroundingRuleSet, retaining its native RDF 1.2 head, positive or negative body atoms and any supported guards. Every set contains at least one such rule."@x-gmeow-english ;
    gmeow:useWhen "Use to enumerate the real rules required by the selected grounding policy."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid naming prose-only rule descriptions or silently omitting a rule whose capabilities the selected evaluator lacks."@x-gmeow-english ;
    gmeow:howToUse "Reference complete rule declarations; let the canonical compiler validate their reifiers and variables before native lowering and selected evaluation."@x-gmeow-english ;
    skos:scopeNote "Membership is unordered and may be shared across sets. Structural evidence checks do not replace the canonical Rule parser or certify stratification, termination or successful evaluation."@x-gmeow-english ;
    skos:example "gmeow:operationalCueGrounding gmeow:groundingRule gmeow:CueNonMachineryGroundingRule . retains a real rule member."@x-gmeow-english .

gmeow:cueGrounded
    a logic:ObjectProperty ;
    logic:domain gmeow:CueMatch ;
    logic:range gmeow:Cue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "cue grounded"@x-gmeow-english ;
    skos:definition "A derived match-to-cue fact produced by the cue's selected grounding rules over the selected input interpretation. Its cue is the match's actual matchedCue. It is never a source assertion or a verdict about a person's words."@x-gmeow-english ;
    gmeow:useWhen "Use only for facts actually derived by the selected cue-grounding operation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid hand-asserting a grounded result, deriving it from a reported held flag alone, or treating absence as falsity without a completed selected interpretation."@x-gmeow-english ;
    gmeow:howToUse "Keep source facts apart from derived outputs and retain the selected rule set, original match, reader and world evidence. Publish only a completed operation's actual derivations."@x-gmeow-english ;
    skos:scopeNote "The binding law checks the same matched cue and a declared nonempty rule set. A union-graph integrity check cannot authenticate asserted-versus-derived origin or prove that evaluation completed."@x-gmeow-english ;
    skos:example "The potential output ex:hit gmeow:cueGrounded ex:cue . belongs only to derived results; this annotation does not assert it in source data."@x-gmeow-english .

gmeow:MachineryRecord
    a logic:Class, logic:Mixin ;
    logic:subClassOf gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Machinery Record"@x-gmeow-english ;
    skos:definition "A derived cross-kind role for a resource explicitly admitted as operational machinery by the selected reader. Actual admitted attempt or intention-transition Events seed the role; only admitted descendant events and admitted generated information records propagate it. Neither an event kind nor automation alone assigns this role."@x-gmeow-english ;
    gmeow:useWhen "Use as a derived exclusion role when a selected cue policy distinguishes operational records from a person's own signal."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid classifying all human attempts, all SoftwareAgent products or all artifacts touched by a tool as machinery."@x-gmeow-english ;
    gmeow:howToUse "Require reader-supplied admission and actual owner predicates, evaluate the finite declared propagation rules, and preserve original authorship and source words."@x-gmeow-english ;
    skos:scopeNote "This Mixin spans Event, Activity and InformationObject sorts. Unary type publication is descriptive; reader-specific machineryForReader state controls propagation and exclusion, so one reader's classification cannot decide another reader's result."@x-gmeow-english ;
    skos:example "An admitted ToolCall below an admitted attempt can acquire MachineryRecord without being retyped as an InformationObject."@x-gmeow-english .

gmeow:machineryAdmittedBy
    a logic:ObjectProperty ;
    logic:range gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "machinery admitted by"@x-gmeow-english ;
    skos:definition "An explicit reader-supplied admission of this resource as an operational machinery record for the named reader or standpoint in the selected input world. It does not identify the resource's author or assert that software created it."@x-gmeow-english ;
    gmeow:useWhen "Use only when the selected reader actually supplies the operational-record classification input."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing admission from SoftwareAgent typing, derivedBy, used, readArtifact or receiptArtifact."@x-gmeow-english ;
    gmeow:howToUse "Retain the admitting reader or standpoint and its statement provenance; select only the relevant reader/world facts before applying classification rules."@x-gmeow-english ;
    skos:scopeNote "Multi-valued and without a global subject domain: events and information records can both be admitted. Admission alone does not derive MachineryRecord without a permitted root or exact link."@x-gmeow-english ;
    skos:example "ex:operation gmeow:machineryAdmittedBy ex:reader . records the reader's operational classification input separately from source authorship."@x-gmeow-english .

gmeow:operationalCueGrounding
    a gmeow:GroundingRuleSet ;
    gmeow:groundingRule gmeow:MachineryAttemptRootRule, gmeow:MachineryIntentionActiveRootRule, gmeow:MachineryIntentionPausedRootRule, gmeow:MachineryIntentionSatisfiedRootRule, gmeow:MachineryIntentionAbandonedRootRule, gmeow:MachineryIntentionSupersededRootRule, gmeow:MachineryDescendantRule, gmeow:MachineryGeneratedRecordRule, gmeow:MachineryRecordPublicationRule, gmeow:CueNonMachineryGroundingRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxConfigBox ;
    rdfs:label "operational-record cue grounding"@x-gmeow-english ;
    skos:definition "The declared policy set containing explicitly activated reader-specific machinery rules and a stratified rule deriving cueGrounded for selected matches whose record lacks machineryForReader for that same reader in the completed selected interpretation."@x-gmeow-english ;
    gmeow:useWhen "Use when the reader explicitly chooses the finite operational-record exclusion policy."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid presenting this policy as universal human-authorship recognition or treating unevaluated absence as a grounded result."@x-gmeow-english ;
    gmeow:howToUse "Select its actual rules and the caller's reader/world facts, finish positive machinery closure before the negative grounding stratum, and retain exclusions and source provenance."@x-gmeow-english ;
    skos:scopeNote "Only subEventOf descendants and wasGeneratedBy information outputs propagate admitted machinery, with same-reader admission at both ends. Input artifacts and arbitrary provenance links do not propagate the role."@x-gmeow-english ;
    skos:example "A cue selecting this set can have a derived eligible match on an unclassified source while an admitted operational output remains excluded; neither outcome establishes the speaker's state."@x-gmeow-english .

gmeow:groundingSelectedBy
    a logic:ObjectProperty ;
    logic:domain gmeow:GroundingRuleSet ;
    logic:range gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "grounding selected by"@x-gmeow-english ;
    skos:definition "The reader or standpoint explicitly selecting this rule set for the current supplied interpretation. This operation input activates only rules that also check their own membership in the selected set."@x-gmeow-english ;
    gmeow:useWhen "Use to make selected grounding execution explicit even when rule declarations are loaded globally."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving selection from a set declaration, cueGrounding link, source authorship or a SoftwareAgent type."@x-gmeow-english ;
    gmeow:howToUse "Supply the actual reader's selection in the intended input world, and preserve other readers' selections independently."@x-gmeow-english ;
    skos:scopeNote "Multi-valued for independent readers. Selection is not an authorization grant or an evaluation receipt; every declared policy rule binds the same reader through its positive activation guard."@x-gmeow-english ;
    skos:example "gmeow:operationalCueGrounding gmeow:groundingSelectedBy ex:reader . supplies selection, not derived grounding."@x-gmeow-english .

gmeow:cueGroundingReader
    a logic:ObjectProperty ;
    logic:domain gmeow:CueMatch ;
    logic:range gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "cue grounding reader"@x-gmeow-english ;
    skos:definition "The actual reader or standpoint whose selected rule-set interpretation grounds this match report. Required when its cue declares grounding rules, and bounded to at most one reader locally without changing generic vantage."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a selected match report to its actual grounding reader without confusing source authorship."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid combining different readers into one report or requiring this field on unrelated pre-existing matches whose cues have no grounding policy."@x-gmeow-english ;
    gmeow:howToUse "Supply the reader of the selected operation and retain separate reports for independently grounded readings of the same occurrence."@x-gmeow-english ;
    skos:scopeNote "The grounding rule joins this reader to groundingSelectedBy and the same reader-specific machinery state. A class-local maximum does not make the generic observation vantage functional."@x-gmeow-english ;
    skos:example "ex:hit gmeow:cueGroundingReader ex:reader . identifies the selected interpreter independently of the source writer."@x-gmeow-english .

gmeow:machineryForReader
    a logic:ObjectProperty ;
    logic:range gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "machinery for reader"@x-gmeow-english ;
    skos:definition "Derived reader-specific operational-record state. Its resource and reader remain paired through the finite machinery rules and the negative grounding guard, preventing another reader's classification from controlling this interpretation."@x-gmeow-english ;
    gmeow:useWhen "Use only for actually derived state in the selected activated rule evaluation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting this state as source input or replacing its reader coordinate with unary MachineryRecord membership."@x-gmeow-english ;
    gmeow:howToUse "Derive from explicit same-reader admissions and permitted roots or links, retain the world boundary, and publish any unary type only through the declared publication rule."@x-gmeow-english ;
    skos:scopeNote "No subject domain coerces every resource into an information object. Derived-only origin is an ownership contract; ordinary graph integrity checks do not authenticate a production derivation."@x-gmeow-english ;
    skos:example "The queried conclusion ex:operation gmeow:machineryForReader ex:reader . keeps the selected reader visible rather than claiming universal automation."@x-gmeow-english .

# Required membership and local maxima do not create global functionality.
gmeow:GroundingRuleSet logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:groundingRule ; logic:allValuesFrom logic:Rule ],
    [ a logic:Restriction ; logic:onProperty gmeow:groundingSelectedBy ; logic:allValuesFrom gmeow:Entity ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:GroundingRuleSet ; logic:closureKey "https://blackcatinformatics.ca/gmeow/groundingRule" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:Cue logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:cueGrounding ; logic:allValuesFrom gmeow:GroundingRuleSet ],
    [ a logic:Restriction ; logic:onProperty gmeow:cueGrounding ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:GroundingRuleSet ] .
gmeow:CueMatch logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:cueGroundingReader ; logic:allValuesFrom gmeow:Entity ],
    [ a logic:Restriction ; logic:onProperty gmeow:cueGroundingReader ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:Entity ],
    [ a logic:Restriction ; logic:onProperty gmeow:cueGrounded ; logic:allValuesFrom gmeow:Cue ] .
gmeow:MachineryRecord logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:machineryAdmittedBy ; logic:allValuesFrom gmeow:Entity ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:MachineryRecord ; logic:closureKey "https://blackcatinformatics.ca/gmeow/machineryAdmittedBy" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:MachineryAttemptRootRule
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "admitted attempt machinery root"@x-gmeow-english ;
    skos:definition "Derive reader-specific machinery for an actual attempt Event only with explicit admission and positive selection of this rule's containing set."@x-gmeow-english ;
    gmeow:useWhen "Use this declared rule only within an explicitly selected grounding set and reader/world interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid activating rules from declaration membership alone or using another reader's classification as this reader's result."@x-gmeow-english ;
    gmeow:howToUse "Retain its native reified atoms, select its containing set positively, and keep source admissions separate from derived outputs."@x-gmeow-english ;
    skos:scopeNote "An eventTypeAttempt value alone does not classify a human or software attempt as machinery. No automation or author identity is inferred."@x-gmeow-english ;
    skos:example "gmeow:operationalCueGrounding gmeow:groundingRule gmeow:MachineryAttemptRootRule . names this actual rule without executing it."@x-gmeow-english ;
    logic:head [ rdf:reifies <<( _:cueGround_record gmeow:machineryForReader _:cueGround_reader )>> ] ;
    logic:body [ rdf:reifies <<( _:cueGround_set gmeow:groundingSelectedBy _:cueGround_reader )>> ],
        [ rdf:reifies <<( _:cueGround_set gmeow:groundingRule gmeow:MachineryAttemptRootRule )>> ],
        [ rdf:reifies <<( _:cueGround_record rdf:type gmeow:Event )>> ],
        [ rdf:reifies <<( _:cueGround_record gmeow:eventType gmeow:eventTypeAttempt )>> ],
        [ rdf:reifies <<( _:cueGround_record gmeow:machineryAdmittedBy _:cueGround_reader )>> ] .

