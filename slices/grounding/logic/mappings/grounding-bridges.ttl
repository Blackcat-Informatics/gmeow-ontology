@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix ro: <http://purl.obolibrary.org/obo/RO_> .
@prefix sumo: <https://www.ontologyportal.org/SUMO.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .

# Co-foundational bridge catalogs. Each cell is BOTH the ergonomic mapping frontend
# (`gmeow:TermEquivalence`) and an explicit grounding commitment
# (`logic:GroundingCorrespondence`). The compiler materializes a content-addressed
# logic:Correspondence with source/target endpoints in the shipped
# graph/correspondence-laws carrier; the SSSOM files below are generated views.
# External targets never become canonical grounding sources. BFO/OBO/SUMO TBoxes
# remain by-reference and outside object-level closure; the vendored gUFO surface is
# retained as a transition/conformance input, not as the semantic authority.

gmeow:mapsetLogicGufo a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-gufo.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-gufo" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Complete gUFO-class coverage from canonical logic: terms. The five temporary-situation reifiers are explicitly related to the logic:Fluent replacement pattern and marked Unsupported; no target class disappears silently." ;
    gmeow:setTrailer "# gUFO is a generated ValidationOnly projection. These links document its complete class surface; the vendored transition snapshot does not outrank logic: as canon." .

gmeow:mapsetLogicBfo a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-bfo.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-bfo" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Logic-foundation bridge views onto the vendored BFO 2020 category spine. Every row is commitment-shifting and validation-only, never an equivalence." ;
    gmeow:setTrailer "# BFO is linked by reference. BridgeView + CommitmentShiftingBridge forbids owl:equivalentClass." .

gmeow:mapsetLogicObo a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-obo.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-obo" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Canonical logic relation bridge views onto BFO and OBO Relation Ontology predicates. Spatial or causal specializations are relatedMatch rather than false equivalences." ;
    gmeow:setTrailer "# OBO relations are linked by their persistent OBO IRIs and remain outside the imported closure." .

gmeow:mapsetLogicSumo a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-sumo.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-sumo" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Foundational category and structural-relation bridge views onto SUMO's published OWL translation IRIs. SUMO and logic: make different commitments, so every row is a BridgeView." ;
    gmeow:setTrailer "# SUMO links are by-reference validation aids; no SUMO axiom is imported and no equivalence is emitted." .

gmeow:mapsetLogicOwl a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-owl.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-owl" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "The complete compiler-recognized logic: to OWL/RDFS construct surface. OWL is a SoundUnder projection of the richer logic: canon, not a competing grounding source." ;
    gmeow:setTrailer "# Coverage is pinned to the adapter, restriction frontend, and OWL projector tables by native tests." .

gmeow:mapsetLogicShacl a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-shacl.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-shacl" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Logic validation and rule constructs projected onto SHACL Core and SHACL-AF. The target validates but does not entail, so every row is explicitly ValidationOnly." ;
    gmeow:setTrailer "# SHACL and SHACL-AF are generated validation dialects of logic:, never canonical rule or constraint sources." .

# ── gUFO: complete imported class surface ──────────────────────────────────────

gmeow:eqLogicGufo001 a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject logic:Individual ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject gufo:Individual ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ; gmeow:sssomFile "gmeow-logic-gufo.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

