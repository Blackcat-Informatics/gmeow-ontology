<https://blackcatinformatics.ca/gmeow/slices/agency-records>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:sliceTier gmeow:tierCore ;
    rdfs:label "agency records"@x-gmeow-english ;
    skos:definition "Source-faithful records of planless attempts, intention lifecycle, artifact operations, tool calls, invocation outcomes and situated agency judgments."@x-gmeow-english ;
    dcterms:title "GMEOW Agency Records Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Agent memory importers retaining prose attempts and activity evidence without fabricating compiled plans, successful outcomes or unknown identities."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceDependsOn <https://blackcatinformatics.ca/gmeow/slices/temporal>,
        <https://blackcatinformatics.ca/gmeow/slices/logic>,
        <https://blackcatinformatics.ca/gmeow/slices/kernel>,
