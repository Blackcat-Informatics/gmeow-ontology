    skos:definition "The gmeow:vantage atom of gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): relates ?other, ?vc."@x-gmeow-english ; logic:relation gmeow:vantage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "vc" ] .
gmeow:rccSharpens a logic:Formula ;
    rdfs:label "rccSharpens (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:sharpens atom of gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): relates ?vs, ?vc."@x-gmeow-english ; logic:relation gmeow:sharpens ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vs" ] , [ logic:termIndex 1 ; logic:termVariable "vc" ] .
