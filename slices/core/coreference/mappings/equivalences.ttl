@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix mads:   <http://www.loc.gov/mads/rdf/v1#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .

# Term equivalences for the universal identity/coreference layer (#74).
# Instance coreference is asserted in data with gmeow:authorityLink plus
# skos:exactMatch/closeMatch; projections may downcast exact matches to target
# identity URL properties. No row here licenses owl:sameAs merging.

gmeow:mapsetCoreference a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/coreference" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Universal identity/coreference alignments. GMEOW links entities to authority records by reference (authorityLink + SKOS match strength) and avoids owl:sameAs merge semantics for contested or standpoint-indexed claims." .

gmeow:eqCoreference001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:authorityLink ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:sameAs ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "schema:sameAs is a projection target for exact authority links; GMEOW's canonical data keeps authorityLink plus explicit skos:exactMatch/closeMatch strength." ;
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" .

gmeow:eqCoreference002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:counterpartOf ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:alternateOf ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "PROV alternateOf captures alternate entities presenting aspects of the same thing, without owl:sameAs identity collapse." ;
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" .

gmeow:eqCoreference003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:versionOf ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject dcterms:isVersionOf ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" .

gmeow:eqCoreference004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:editionOf ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject dcterms:isVersionOf ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "An edition is a work-version relation for Dublin Core consumers; GMEOW keeps editionOf distinct from generic versionOf." ;
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" .

gmeow:eqCoreference005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:supersedes ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject dcterms:replaces ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" .

gmeow:eqCoreference006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:authorityLink ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject mads:hasCloseExternalAuthority ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "both relate a local description to a close external authority record, by reference (#34 phase 2). mads:authoritativeLabel is REFUSED: GMEOW has no authority-control labeling model — skos:prefLabel serves that role." ;
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" .
