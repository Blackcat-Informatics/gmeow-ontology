@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex: <https://example.org/lifecycle/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:forget-valid a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/forget-request.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A pending request names its requester, exact target and invoked right without granting authorization or recording deletion." .

ex:forget-missing-requester a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/forget-missing-requester.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:expectedSourceShape gmeow:ForgetRequest-shape ;
    gmeow:conformanceRationale "Reject a forget request with missing-requester at its owning canonical constraint, without accepting an unrelated failure as proof." .

