    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0
|} .

gmeow:identifier skos:closeMatch bibo:doi {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

gmeow:datePublished skos:closeMatch dcterms:issued {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "DCTerms issued — the publication date is the issue/release date in DCMI Terms"
|} .

gmeow:identifier skos:closeMatch dcterms:identifier {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "DCTerms identifier — a formal identifier such as a DOI or patent number"
|} .

gmeow:CreativeWorkTitle owl:equivalentClass bf:Title {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "both reify a work's title as a first-class node carrying its text and metadata"
|} .

gmeow:depictedIn skos:closeMatch schema:image {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "the inverse of depicts: an entity's image is the MediaObject depicting it → schema:image"
|} .

gmeow:pagePrincipalSubject skos:closeMatch schema:mainEntity {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a page's principal subject IS schema:mainEntity; its inverse on the subject is schema:mainEntityOfPage"
|} .

