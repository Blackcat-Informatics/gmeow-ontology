@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dc:      <http://purl.org/dc/elements/1.1/> .
@prefix schema:  <https://schema.org/> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix cc:      <http://creativecommons.org/ns#> .
@prefix premis:  <http://www.loc.gov/premis/rdf/v3/> .
@prefix spdx:    <http://spdx.org/rdf/terms#> .
@prefix ma:      <http://www.w3.org/ns/ma-ont#> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences for the rights / IP / trademark / licensing facility (rights facility) —
# GMEOW authoring source. Consumed by the registered mappings generator. All
# alignments are BY REFERENCE (Principle 5); GMEOW
# never imports an external axiom. Executable one-to-one projection bindings now
# emit their own SSSOM rows through gmeow:emitSssom; the remaining
# TermEquivalence rows are non-executable linkage records or deliberately weaker
# by-reference relationships outside those projection cells.
# See the rights slice documentation.

gmeow:mapsetRights a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/rights" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Rights / IP / trademark / licensing alignments (rights facility).
        MACHINE-READABLE RIGHTS: gmeow:RightsStatement is the canonical superset of an ODRL Policy / Set (W3C ODRL 2.2); gmeow:Permission / gmeow:Prohibition / gmeow:Duty are the odrl:Permission / odrl:Prohibition / odrl:Duty rule trio, and gmeow:ruleAction values (reproduce / distribute / derive / commercialize / attribute / share-alike / …) are the odrl:action vocabulary, exactMatch the CC REL permission/requirement/prohibition classes (cc:Reproduction, cc:DerivativeWorks, cc:Attribution, cc:ShareAlike, cc:CommercialUse). The full ODRL policy and CC REL licence are GENERATED projections (queries/projections/odrl.rq, cc.rq).
        LICENCE-IS-AGREEMENT: gmeow:License (⊑ gmeow:Agreement) closeMatch cc:License / odrl:Offer / dcterms:LicenseDocument; gmeow:hasLicense exactMatch dcterms:license, closeMatch schema:license / cc:license.
        ATTRIBUTION REUSE: gmeow:copyrightHolder / gmeow:trademarkHolder (⊑ gmeow:wasAttributedTo) closeMatch dcterms:rightsHolder / schema:copyrightHolder; gmeow:attributionText closeMatch schema:creditText / cc:attributionName.
        COPYRIGHT STATUS: gmeow:CopyrightStatus values closeMatch the RightsStatements.org standardized statements (InC / NKC / CNE) and the CC public-domain mark; the facility relates to PREMIS 3 rights (premis:RightsStatement).
        DISTINCT FROM the ontology-alignment LinkPolicy (the native LinkPolicy in `crates/license`): that governs whether an external vocabulary's AXIOMS may be copied INTO GMEOW; this facility governs the rights of the INSTANCES GMEOW describes. The gmeow:LicenseFamily value vocabulary is the ontology-side reflection of that classification, not a copy of it.""" ;
    gmeow:setTrailer "# REFUSED: no preferred / primary right (Principle 9) — coexisting rights statements are co-equal; GMEOW has no winner-selecting rights projection.\n# WIPO trademark concepts are linked via Wikidata (gmeow-wikidata.sssom.tsv: wd:Q167270 trademark, wd:P1716 brand) rather than a fabricated wipo: namespace IRI." .

# --- ODRL: the deontic policy model (every odrl: term the projection emits) --- #

gmeow:RightsStatement skos:relatedMatch odrl:Set {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "projected as an odrl:Set (the concrete, rule-bearing policy subclass)"
|} .

gmeow:statementAbout skos:closeMatch odrl:target {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "the asset a policy / rule governs"
|} .

gmeow:ruleTarget skos:closeMatch odrl:target {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "the asset a single rule regulates"
|} .

gmeow:hasPermission skos:closeMatch odrl:permission {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a policy's permission rule"
|} .

gmeow:hasProhibition skos:closeMatch odrl:prohibition {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a policy's prohibition rule"
|} .

gmeow:hasDuty skos:closeMatch odrl:obligation {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "a policy-level duty / obligation"
|} .

gmeow:hasDuty skos:relatedMatch odrl:duty {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "the permission-scoped duty form of an obligation"
|} .

gmeow:Rule skos:closeMatch odrl:Rule {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "the abstract deontic rule"
|} .

gmeow:Permission skos:closeMatch odrl:Permission {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "permission rule class"
|} .

gmeow:Prohibition skos:closeMatch odrl:Prohibition {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "prohibition rule class"
|} .

gmeow:Duty skos:closeMatch odrl:Duty {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "duty rule class"
|} .

gmeow:ruleAction skos:closeMatch odrl:action {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the regulated action of a rule"
|} .

gmeow:ruleAssignee skos:closeMatch odrl:assignee {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
