msgctxt "https://blackcatinformatics.ca/gmeow/UseForConsumerTargetConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "useForConsumer range constraint"
msgstr "useForConsumer 值域约束"

msgctxt "https://blackcatinformatics.ca/gmeow/UseForConsumerTargetConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A closed-world integrity constraint: every gmeow:useForConsumer value is a declared gmeow:ProjectionContext individual."
msgstr "闭世界完整性约束：gmeow:useForConsumer 的每个取值都是一个已声明的 gmeow:ProjectionContext 个体。"

