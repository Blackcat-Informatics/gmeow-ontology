        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termIri gmeow:CurationEpoch ] ],
                [ a logic:Formula ; logic:or
                    [ a logic:Formula ; logic:and
                        [ a logic:Formula ; logic:relation gmeow:curationManifest ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "artifact" ] ],
                        [ a logic:Formula ; logic:relation gmeow:curationManifestDigest ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "value" ] ] ],
                    [ a logic:Formula ; logic:and
                        [ a logic:Formula ; logic:relation gmeow:epochPredecessor ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "artifact" ] ],
                        [ a logic:Formula ; logic:relation gmeow:epochPredecessorDigest ;
