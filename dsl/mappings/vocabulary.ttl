# --- MappingPattern (structural: targetObjectsOf gmeow:hasMappingPattern) -------- #

gmeow:MappingPatternAnchorRequiredConstraint
    a logic:Constraint ;
    rdfs:label "MappingPattern anchor requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:MappingPattern (the object of gmeow:hasMappingPattern) carries exactly one gmeow:anchor."@x-gmeow-english ;
    logic:formalizes gmeow:MappingPattern ;
    logic:message "MappingPattern must have exactly one gmeow:anchor (string)"@x-gmeow-english ;
    logic:integrity logic:mpaForall .
logic:mpaForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] ;
    logic:forall logic:mpaImpl .
logic:mpaImpl a logic:Formula ; logic:antecedent logic:mpaGuard ; logic:consequent logic:mpaExists .
logic:mpaGuard a logic:Formula ; logic:relation gmeow:hasMappingPattern ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:mpaExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "a" ] ;
    logic:exists logic:mpaAtom .
logic:mpaAtom a logic:Formula ; logic:relation gmeow:anchor ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .

# --- PatternAtom (structural: targetSubjectsOf gmeow:subjectVar) ---------------- #

gmeow:PatternAtomPredicateChoiceConstraint
    a logic:Constraint ;
    rdfs:label "PatternAtom predicate choice constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:PatternAtom (a subject of gmeow:subjectVar) carries exactly one of gmeow:predicate (IRI), gmeow:predicateVar (string), or gmeow:path."@x-gmeow-english ;
    logic:formalizes gmeow:PatternAtom ;
    logic:message "PatternAtom must have exactly one of predicate (IRI), predicateVar (string), or path (node)"@x-gmeow-english ;
    logic:integrity logic:papForall .
logic:papForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sv" ] ;
    logic:forall logic:papImpl .
logic:papImpl a logic:Formula ; logic:antecedent logic:papGuard ; logic:consequent logic:papXor .
logic:papGuard a logic:Formula ; logic:relation gmeow:subjectVar ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sv" ] .
logic:papXor a logic:Formula ; logic:or logic:papOnlyPred , logic:papOnlyPredVar , logic:papOnlyPath .
logic:papOnlyPred a logic:Formula ; logic:and logic:papHasPred , logic:papNoPredVar , logic:papNoPath .
logic:papOnlyPredVar a logic:Formula ; logic:and logic:papNoPred , logic:papHasPredVar , logic:papNoPath .
logic:papOnlyPath a logic:Formula ; logic:and logic:papNoPred , logic:papNoPredVar , logic:papHasPath .
logic:papHasPred a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] ; logic:exists logic:papHasPredAtom .
logic:papHasPredAtom a logic:Formula ; logic:relation gmeow:predicate ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .
logic:papNoPred a logic:Formula ; logic:not logic:papHasPred .
logic:papHasPredVar a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "pv" ] ; logic:exists logic:papHasPredVarAtom .
logic:papHasPredVarAtom a logic:Formula ; logic:relation gmeow:predicateVar ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "pv" ] .
logic:papNoPredVar a logic:Formula ; logic:not logic:papHasPredVar .
logic:papHasPath a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "pt" ] ; logic:exists logic:papHasPathAtom .
logic:papHasPathAtom a logic:Formula ; logic:relation gmeow:path ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "pt" ] .
logic:papNoPath a logic:Formula ; logic:not logic:papHasPath .

# --- TemplateAtom (structural: targetSubjectsOf gmeow:tSubj) -------------------- #

gmeow:TemplateAtomPredRequiredConstraint
    a logic:Constraint ;
    rdfs:label "TemplateAtom predicate requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:TemplateAtom (a subject of gmeow:tSubj) carries exactly one gmeow:tPred."@x-gmeow-english ;
    logic:formalizes gmeow:TemplateAtom ;
    logic:message "TemplateAtom must have exactly one gmeow:tPred (IRI)"@x-gmeow-english ;
    logic:integrity logic:tapForall .
logic:tapForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] ;
    logic:forall logic:tapImpl .
logic:tapImpl a logic:Formula ; logic:antecedent logic:tapGuard ; logic:consequent logic:tapExists .
logic:tapGuard a logic:Formula ; logic:relation gmeow:tSubj ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
logic:tapExists a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] ; logic:exists logic:tapAtom .
logic:tapAtom a logic:Formula ; logic:relation gmeow:tPred ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .

gmeow:TemplateAtomObjectChoiceConstraint
    a logic:Constraint ;
    rdfs:label "TemplateAtom object choice constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:TemplateAtom carries exactly one of gmeow:tObj (string) or gmeow:tObjValue (IRI)."@x-gmeow-english ;
    logic:formalizes gmeow:TemplateAtom ;
    logic:message "TemplateAtom must have exactly one of tObj (string) or tObjValue (IRI)"@x-gmeow-english ;
    logic:integrity logic:tacForall .
logic:tacForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] ;
    logic:forall logic:tacImpl .
logic:tacImpl a logic:Formula ; logic:antecedent logic:tacGuard ; logic:consequent logic:tacXor .
logic:tacGuard a logic:Formula ; logic:relation gmeow:tSubj ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
logic:tacXor a logic:Formula ; logic:or logic:tacOnlyObj , logic:tacOnlyObjValue .
logic:tacOnlyObj a logic:Formula ; logic:and logic:tacHasObj , logic:tacNoObjValue .
logic:tacOnlyObjValue a logic:Formula ; logic:and logic:tacNoObj , logic:tacHasObjValue .
logic:tacHasObj a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "o" ] ; logic:exists logic:tacHasObjAtom .
logic:tacHasObjAtom a logic:Formula ; logic:relation gmeow:tObj ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "o" ] .
logic:tacNoObj a logic:Formula ; logic:not logic:tacHasObj .
logic:tacHasObjValue a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "ov" ] ; logic:exists logic:tacHasObjValueAtom .
logic:tacHasObjValueAtom a logic:Formula ; logic:relation gmeow:tObjValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "ov" ] .
logic:tacNoObjValue a logic:Formula ; logic:not logic:tacHasObjValue .

