@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://example.org/epistemic-affects/> .

ex:reader a gmeow:Agent ; rdfs:label "the reader"@x-gmeow-english .
ex:doubt a gmeow:Emotion ;
    gmeow:emotionBearer ex:reader ; gmeow:emotionType gmeow:emotionSelfDoubt .
ex:catchingOneself a gmeow:Emotion ;
    gmeow:emotionBearer ex:reader ; gmeow:emotionType gmeow:emotionSelfCorrection .
# These feelings do not assert that a proposed correction is true.
