#
# Construct family: maxCardinality clash under the Unique Name Assumption.
# x ⊑ (≤1 p) but has two p-fillers y, z asserted owl:differentFrom -> INCONSISTENT.
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <https://gmeow.example/dl/max-card#> .

ex: a owl:Ontology .

ex:p a owl:ObjectProperty .

ex:A a owl:Class ;
  rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty ex:p ; owl:maxCardinality "1"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ] .

ex:x a owl:NamedIndividual , ex:A ;
  ex:p ex:y , ex:z .
ex:y a owl:NamedIndividual .
ex:z a owl:NamedIndividual .
ex:y owl:differentFrom ex:z .
