# --- GMN-1 factored qualifier-slot aliases --- #
# The `m` (modality) and `ek` (evidentiality-kind) claim-record slots, and the
# `@p`-only `bd` (boundary) slot, are COMPACT ALIASES over vocabulary the
# standpoint, observations, and logic slices already formalize (LANG-GMN.md,
# "The factored qualifier slots") — never a GMN-local shadow axis (Principle
# 4/U2). Each alias carries its measured gmeow:gmnGlyphTokenCost, cross-checked
# by crates/lang-bridge/tests/gmn_cost_feed.rs against the crate-side
# cl100k_base primitive so an authored value can never drift, and its measured
# cost is strictly lower than the full canonical IRI it dealiases — the
# razor's half (a) discharge (LANG-GMN.md, "The measured token-cost razor").
# The `it` (iteration) slot has no enumerable value set (it names a
# gmeow:EventSeries by reference, exactly like `st`/`ev`) and so mints no
# dictionary entries here.

gmeow:gmnDictV1EntryModalNecessary
    a owl:NamedIndividual , gmeow:GmnDictionaryEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "dict-v1 entry: gmeow:modalForceNecessary → nec"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    skos:definition "The dict-v1 alias binding for the standpoint slice's gmeow:modalForceNecessary (the □ alethic register a gmeow:claimModalForce may carry): the compact token nec, the GMN-1 `m` slot value for a claim settled in every admitted precisification."@x-gmeow-english ;
    gmeow:gmnDictionaryEntryTerm gmeow:modalForceNecessary ;
    gmeow:gmnDictionaryEntryAlias "nec" ;
    gmeow:gmnCodepoints "U+006E U+0065 U+0063" ;
    gmeow:gmnGlyphTokenCost gmeow:gmnTokenCostTwo .

gmeow:gmnDictV1EntryModalActual
