#
# Declarative structural assertions for the narrative slice
# -- the slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT
# invariants formerly hand-written in tests/test_narrative.py. Each assertion
# runs as a SPARQL ASK over the narrative module graph (gmeow:scopeModule) under
# the native Rust slicetest harness (crates/slicetest).
#
# Narrative is migrated: class stereotypes are logic:
# (logic:SubKind, logic:Kind, logic:Relator, logic:AbstractIndividualType,
# logic:QualityValue, logic:Category), not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_narrative_reference_frame_is_not_standpoint_subclass
#     -- uses graph.transitive_objects() over the merged graph; a scopeModule
#     cell would silently narrow the live-set sweep across imported slices.
#   test_book_release_and_serial_installment_are_creative_works
#     -- transitive walk; gmeow:BookRelease and gmeow:SerialInstallment are
#     subjects in slices/core/documents/module.ttl, not the narrative module.
#   test_frame_realm_narrative_and_frame_kind_narrative_exist
#     -- gmeow:frameRealmNarrative and gmeow:frameKindNarrative are subjects in
#     slices/core/places/module.ttl (cross-slice); a scopeModule cell would
#     always return ASK FALSE.
#   test_reading_order_subclasses_standpoint
#     -- gmeow:ReadingOrder is a subject in slices/core/documents/module.ttl
#     (cross-slice), not the narrative module.
#   test_narrative_reference_frame_shacl_passes
#     -- SHACL validation call; ExampleConformance, not a structural TBox assertion.
#   test_narrative_frame_link_shacl_passes
#     -- SHACL validation call; ExampleConformance, not a structural TBox assertion.
#   test_character_arc_shacl_passes
#     -- SHACL validation call; ExampleConformance, not a structural TBox assertion.
#   test_character_arc_missing_subject_fails_shacl
#     -- SHACL validation negative call with error-text assertions; ExampleConformance,
#     not a structural TBox assertion.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/narrative/tests/> .

# --- 1. NarrativeReferenceFrame subclasses ReferenceFrame (MUST) --------------
ex:saNarrativeReferenceFrameIsReferenceFrame a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NarrativeReferenceFrame rdfs:subClassOf gmeow:ReferenceFrame .
}""" ;
    gmeow:saRationale "gmeow:NarrativeReferenceFrame MUST be rdfs:subClassOf gmeow:ReferenceFrame -- canon supplies coordinate topology for in-universe claims; the gUFO MixIden rule forbids a second Kind inheritance (Standpoint)." .

# --- 2. NarrativeFrameRelation is a logic:AbstractIndividualType value vocab ----
ex:saNarrativeFrameRelationIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NarrativeFrameRelation a logic:AbstractIndividualType , owl:Class ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:NarrativeFrameRelation MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- frame-relation types are value-vocabulary individuals, never subclasses (Principle 9)." .

# --- 3. Six NarrativeFrameRelation seed individuals exist (MUST) ---------------
ex:saNarrativeFrameRelationSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:relationCanon               a gmeow:NarrativeFrameRelation .
    gmeow:relationAlternateContinuity a gmeow:NarrativeFrameRelation .
    gmeow:relationExpandedUniverse    a gmeow:NarrativeFrameRelation .
    gmeow:relationFanon               a gmeow:NarrativeFrameRelation .
    gmeow:relationCrossover           a gmeow:NarrativeFrameRelation .
    gmeow:relationAdaptationOf        a gmeow:NarrativeFrameRelation .
}""" ;
    gmeow:saRationale "All six NarrativeFrameRelation seed individuals (canon, alternate continuity, expanded universe, fanon, crossover, adaptation) MUST be present -- they seed the open value vocabulary." .

# --- 4. sourceFor is an owl:ObjectProperty with domain and range (MUST) --------
ex:saSourceForProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:sourceFor a owl:ObjectProperty ;
        rdfs:domain gmeow:CreativeWork ;
        rdfs:range gmeow:NarrativeReferenceFrame .
}""" ;
    gmeow:saRationale "gmeow:sourceFor MUST be an owl:ObjectProperty with rdfs:domain gmeow:CreativeWork and rdfs:range gmeow:NarrativeReferenceFrame -- out-of-universe artifacts source narrative frames, not the reverse." .

# --- 5. NarrativeFrameLink subclasses logic:Relator (MUST) ---------------------
ex:saNarrativeFrameLinkIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NarrativeFrameLink rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:NarrativeFrameLink MUST be rdfs:subClassOf logic:Relator -- a reified binding of source frame, target frame, and relation type into a single node (the NarrationUsage/Tagging idiom)." .

# --- 6. narrativeFrameLinkSource, Target, Relation are ObjectProperties (MUST) -
ex:saNarrativeFrameLinkPropertiesAreObjectProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:narrativeFrameLinkSource   a owl:ObjectProperty .
    gmeow:narrativeFrameLinkTarget   a owl:ObjectProperty .
    gmeow:narrativeFrameLinkRelation a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:narrativeFrameLinkSource, narrativeFrameLinkTarget, and narrativeFrameLinkRelation MUST all be owl:ObjectProperty -- all three link roles of the NarrativeFrameLink relator are object relations." .

# --- 7. narrativeFrameLinkSource domain and range (MUST) ----------------------
ex:saNarrativeFrameLinkSourceDomainRange a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:narrativeFrameLinkSource rdfs:domain gmeow:NarrativeFrameLink ;
        rdfs:range gmeow:NarrativeReferenceFrame .
}""" ;
    gmeow:saRationale "gmeow:narrativeFrameLinkSource MUST have rdfs:domain gmeow:NarrativeFrameLink and rdfs:range gmeow:NarrativeReferenceFrame -- the source end of the reified frame-to-frame binding." .

# --- 8. narrativeFrameLinkTarget domain and range (MUST) ----------------------
ex:saNarrativeFrameLinkTargetDomainRange a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:narrativeFrameLinkTarget rdfs:domain gmeow:NarrativeFrameLink ;
        rdfs:range gmeow:NarrativeReferenceFrame .
}""" ;
    gmeow:saRationale "gmeow:narrativeFrameLinkTarget MUST have rdfs:domain gmeow:NarrativeFrameLink and rdfs:range gmeow:NarrativeReferenceFrame -- the target end of the reified frame-to-frame binding." .

# --- 9. narrativeFrameLinkRelation domain and range (MUST) --------------------
ex:saNarrativeFrameLinkRelationDomainRange a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:narrativeFrameLinkRelation rdfs:domain gmeow:NarrativeFrameLink ;
        rdfs:range gmeow:NarrativeFrameRelation .
}""" ;
    gmeow:saRationale "gmeow:narrativeFrameLinkRelation MUST have rdfs:domain gmeow:NarrativeFrameLink and rdfs:range gmeow:NarrativeFrameRelation -- the relation-type slot of the reified binding." .

# --- 10. contributesToFrame is an ObjectProperty with domain and range (MUST) --
ex:saContributesToFrameProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:contributesToFrame a owl:ObjectProperty ;
        rdfs:domain gmeow:InformationObject ;
        rdfs:range gmeow:NarrativeReferenceFrame .
}""" ;
    gmeow:saRationale "gmeow:contributesToFrame MUST be an owl:ObjectProperty with rdfs:domain gmeow:InformationObject and rdfs:range gmeow:NarrativeReferenceFrame -- broader than sourceFor; a segment may contribute claims without being the primary source." .

# --- 11. CharacterArc subclasses InformationObject (MUST) ---------------------
ex:saCharacterArcSubclassesInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:CharacterArc rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:CharacterArc MUST be rdfs:subClassOf gmeow:InformationObject -- a first-class interpretive information object, not an event or participant (standpoint-scoped analysis)." .

# --- 12. arcSubject, arcFrame, arcType are ObjectProperties (MUST) ------------
ex:saArcCorePropsFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:arcSubject a owl:ObjectProperty .
    gmeow:arcFrame   a owl:ObjectProperty .
    gmeow:arcType    a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:arcSubject, arcFrame, and arcType MUST each be owl:ObjectProperty -- one subject, one frame, and one type per CharacterArc instance (cross-continuity arcs are separate instances); their functionality is now carried by logic:PropertyCharacteristicAssertions (DL-enforced)." .

# --- 13. arcEvidence is an owl:ObjectProperty (NOT functional) (MUST) ---------
ex:saArcEvidenceIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:arcEvidence a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:arcEvidence MUST be owl:ObjectProperty -- an arc may be evidenced by many segments or works, so it is NOT functional." .

# --- 14. arcEvidence must NOT be functional (MUST-NOT) ------------------------
ex:saArcEvidenceNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:arcEvidence a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:arcEvidence MUST NOT be owl:FunctionalProperty -- an arc may be evidenced by many works or segments, and those coexist (Principle 9)." .

# --- 15. ArcType is a logic:AbstractIndividualType value vocab (MUST) -----------
ex:saArcTypeIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ArcType a logic:AbstractIndividualType , owl:Class ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:ArcType MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- arc types are an open value vocabulary (individuals, never subclasses, Principle 9)." .

# --- 16. Six ArcType seed individuals exist (MUST) ----------------------------
ex:saArcTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:arcTypeComingOfAge a gmeow:ArcType .
    gmeow:arcTypeRedemption  a gmeow:ArcType .
    gmeow:arcTypeFall        a gmeow:ArcType .
    gmeow:arcTypeCorruption  a gmeow:ArcType .
    gmeow:arcTypeQuest       a gmeow:ArcType .
    gmeow:arcTypeRecovery    a gmeow:ArcType .
}""" ;
    gmeow:saRationale "All six ArcType seed individuals (coming-of-age, redemption, fall, corruption, quest, recovery) MUST be present as gmeow:ArcType instances -- they seed the open interpretive vocabulary." .

# --- 17. NarrativeTimeFrame is a logic:SubKind ReferenceFrame (MUST) ---------
ex:saNarrativeTimeFrameIsReferenceFrame a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NarrativeTimeFrame a owl:Class , logic:SubKind ;
        rdfs:subClassOf gmeow:ReferenceFrame .
}""" ;
    gmeow:saRationale "gmeow:NarrativeTimeFrame MUST be an owl:Class typed logic:SubKind and a subclass of gmeow:ReferenceFrame. Replaces the stale gufo:SubKind assertion." .

# --- 18. NarrativeTimeAxis is a two-seed value vocabulary (MUST) -------------
ex:saNarrativeTimeAxisValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NarrativeTimeAxis a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
    gmeow:axisDiscourseTime a gmeow:NarrativeTimeAxis .
    gmeow:axisStoryTime     a gmeow:NarrativeTimeAxis .
}""" ;
    gmeow:saRationale "gmeow:NarrativeTimeAxis MUST be a logic:QualityValue vocabulary seeded by discourse-time and story-time axis values. Replaces stale gufo:AbstractIndividualType/QualityValue assertions." .

# --- 19. NarrativePosition is a logic:Kind object with ordinal/label properties (MUST) ---
ex:saNarrativePositionFrameOrdinalLabel a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NarrativePosition a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:Entity .
    gmeow:positionOrdinal a owl:DatatypeProperty .
}""" ;
    gmeow:saRationale "gmeow:NarrativePosition MUST be a logic:Kind entity with a datatype ordinal property. Replaces the stale gufo:Kind assertion." .

ex:saPositionLabelNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:positionLabel a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:positionLabel MUST NOT be functional; co-equal position labels coexist." .

# --- 20. NarrationUsage is a reified logic:Relator with open subject range (MUST) ---
ex:saNarrationUsageIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NarrationUsage a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:NarrationUsage MUST be a logic:Kind relator; its segment and subject role functionality is now carried by logic:PropertyCharacteristicAssertions (DL-enforced). Replaces stale gufo:Kind/Relator assertions." .

ex:saNarrationSubjectRangeOpen a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:narrationSubject rdfs:range ?range . }""" ;
    gmeow:saRationale "gmeow:narrationSubject MUST NOT have an rdfs:range; the narrated thing can be an entity, event, or situation." .

ex:saNarrationModeNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:narrationMode a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:narrationMode MUST NOT be functional; a flashback can also be a dream, and rival readings coexist." .

# --- 21. Myth is a logic:Kind SocialObject (MUST) ----------------------------
ex:saMythIsKindSocialObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Myth a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:SocialObject .
}""" ;
    gmeow:saRationale "gmeow:Myth MUST be an owl:Class typed logic:Kind and a subclass of gmeow:SocialObject. Replaces the stale gufo:Kind assertion." .

# --- 22. RoleInNarrative is a scoped interpretive logic:Relator (MUST) -------
ex:saRoleInNarrativeScopedRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:RoleInNarrative rdfs:subClassOf logic:Relator .
    gmeow:narrativeRoleScope  rdfs:range gmeow:NarrativeScope .
    gmeow:CreativeWork rdfs:subClassOf gmeow:NarrativeScope .
    gmeow:ContentSegment rdfs:subClassOf gmeow:NarrativeScope .
    gmeow:NarrativeReferenceFrame rdfs:subClassOf gmeow:NarrativeScope .
}""" ;
    gmeow:saRationale "gmeow:RoleInNarrative MUST be a logic:Relator with narrativeRoleScope ranging over NarrativeScope and the narrative scope graft asserted extension-side; its bearer, scope, and role-value functionality is now carried by logic:PropertyCharacteristicAssertions (DL-enforced). Replaces the stale gufo:Relator assertion." .
