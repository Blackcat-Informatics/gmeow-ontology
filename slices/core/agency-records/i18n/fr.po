msgctxt "https://blackcatinformatics.ca/gmeow/deadlineAt|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."
msgstr "Conserver valeurs, identités et attribution réelles de la source ; préserver formulation, langue et direction fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/deadlineAt|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Source evidence and configuration remain distinct. Competing attributed records may coexist without a preferred claim."
msgstr "Les preuves source et la configuration restent distinctes. Des enregistrements attribués concurrents peuvent coexister sans déclaration privilégiée."

msgctxt "https://blackcatinformatics.ca/gmeow/deadlineAt|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:deadlineAt \"2030-05-01T09:00:00Z\"^^xsd:dateTime ."
msgstr "ex:record gmeow:deadlineAt \"2030-05-01T09:00:00Z\"^^xsd:dateTime ."

msgctxt "https://blackcatinformatics.ca/gmeow/nextReviewAt|http://www.w3.org/2000/01/rdf-schema#label"
msgid "next review at"
msgstr "prochaine révision à"

msgctxt "https://blackcatinformatics.ca/gmeow/nextReviewAt|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source-stated next review instant of an intention. A scheduled review does not assert a review occurred, and missing precision or timezone is never invented."
msgstr "Instant de prochaine révision d’une intention indiqué par la source. Une révision prévue n’affirme pas sa réalisation ; précision ou fuseau manquants ne sont jamais inventés."

msgctxt "https://blackcatinformatics.ca/gmeow/nextReviewAt|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/nextReviewAt|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "Éviter d’inventer des liens source absents ou de déduire exécution et réussite de ce seul enregistrement."

msgctxt "https://blackcatinformatics.ca/gmeow/nextReviewAt|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."
msgstr "Conserver valeurs, identités et attribution réelles de la source ; préserver formulation, langue et direction fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/nextReviewAt|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Source evidence and configuration remain distinct. Competing attributed records may coexist without a preferred claim."
msgstr "Les preuves source et la configuration restent distinctes. Des enregistrements attribués concurrents peuvent coexister sans déclaration privilégiée."

msgctxt "https://blackcatinformatics.ca/gmeow/nextReviewAt|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:nextReviewAt \"2030-05-01T09:00:00Z\"^^xsd:dateTime ."
msgstr "ex:record gmeow:nextReviewAt \"2030-05-01T09:00:00Z\"^^xsd:dateTime ."

msgctxt "https://blackcatinformatics.ca/gmeow/eventReason|http://www.w3.org/2000/01/rdf-schema#label"
msgid "event reason"
msgstr "motif d’événement"

msgctxt "https://blackcatinformatics.ca/gmeow/eventReason|http://www.w3.org/2004/02/skos/core#definition"
msgid "The verbatim source reason for an intention-related event, independently attributed and retaining language and direction. It neither replaces event type nor proves the stated cause."
msgstr "Motif source textuel d’un événement lié à l’intention, attribué séparément avec sa langue et sa direction. Il ne remplace pas le type d’événement et ne prouve pas la cause annoncée."

msgctxt "https://blackcatinformatics.ca/gmeow/eventReason|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/eventReason|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "Éviter d’inventer des liens source absents ou de déduire exécution et réussite de ce seul enregistrement."

msgctxt "https://blackcatinformatics.ca/gmeow/eventReason|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."
msgstr "Conserver valeurs, identités et attribution réelles de la source ; préserver formulation, langue et direction fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/eventReason|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Source evidence and configuration remain distinct. Competing attributed records may coexist without a preferred claim."
msgstr "Les preuves source et la configuration restent distinctes. Des enregistrements attribués concurrents peuvent coexister sans déclaration privilégiée."

msgctxt "https://blackcatinformatics.ca/gmeow/eventReason|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:eventReason \"source-value\" ."
msgstr "ex:record gmeow:eventReason \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/engineContract|http://www.w3.org/2000/01/rdf-schema#label"
msgid "engine contract"
msgstr "identifiant de contrat moteur"

msgctxt "https://blackcatinformatics.ca/gmeow/engineContract|http://www.w3.org/2004/02/skos/core#definition"
msgid "The exact source engine-contract identifier governing a recorded event. Preserve all code points and spacing; the identifier alone supplies neither an implemented contract nor an execution receipt."
msgstr "Identifiant source exact du contrat moteur régissant un événement enregistré. Conserver points de code et espaces ; l’identifiant seul ne fournit ni implémentation ni reçu d’exécution."

msgctxt "https://blackcatinformatics.ca/gmeow/engineContract|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/engineContract|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "Éviter d’inventer des liens source absents ou de déduire exécution et réussite de ce seul enregistrement."

msgctxt "https://blackcatinformatics.ca/gmeow/engineContract|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Keep the supplied xsd:string or xsd:token engine-contract identifier on the recorded Event with its source attribution. Retain any actual contract artifact or execution evidence separately."
msgstr "Conserver l’identifiant de contrat moteur xsd:string ou xsd:token fourni sur l’Event consigné avec son attribution de source. Garder séparément tout artefact de contrat réel ou toute preuve d’exécution."

msgctxt "https://blackcatinformatics.ca/gmeow/engineContract|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Preserve the supplied lexical form and datatype: verbatim xsd:string and explicitly supplied xsd:token are admitted. Do not normalize whitespace, retype a string or infer token typing. These declarations do not install a token lexical checker. Naming a contract does not authenticate its implementation or establish that an event executed under it."
msgstr "Préserver la forme lexicale et le type de données fournis : les xsd:string verbatim et les xsd:token explicitement fournis sont admis. Ne pas normaliser les espaces, changer le type d’une chaîne ni déduire un type token. Ces déclarations n’installent aucun vérificateur lexical de token. Nommer un contrat n’authentifie pas son implémentation et n’établit pas qu’un événement s’est exécuté sous ce contrat."

msgctxt "https://blackcatinformatics.ca/gmeow/engineContract|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:engineContract \"source-value\" ."
msgstr "ex:record gmeow:engineContract \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/auditText|http://www.w3.org/2000/01/rdf-schema#label"
msgid "audit text"
msgstr "texte d’audit"

msgctxt "https://blackcatinformatics.ca/gmeow/auditText|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source's unparsed tool audit line, verbatim with supplied language and direction. Retaining the line neither parses a contract nor turns an unrecognized audit into success or a malformed value."
msgstr "Ligne d’audit d’outil non analysée de la source, conservée textuellement avec langue et direction fournies. La conserver n’analyse aucun contrat et ne transforme pas une ligne inconnue en réussite ou en valeur mal formée."

msgctxt "https://blackcatinformatics.ca/gmeow/auditText|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/auditText|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "Éviter d’inventer des liens source absents ou de déduire exécution et réussite de ce seul enregistrement."

msgctxt "https://blackcatinformatics.ca/gmeow/auditText|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."
msgstr "Conserver valeurs, identités et attribution réelles de la source ; préserver formulation, langue et direction fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/auditText|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Source evidence and configuration remain distinct. Competing attributed records may coexist without a preferred claim."
msgstr "Les preuves source et la configuration restent distinctes. Des enregistrements attribués concurrents peuvent coexister sans déclaration privilégiée."

msgctxt "https://blackcatinformatics.ca/gmeow/auditText|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:auditText \"source-value\" ."
msgstr "ex:record gmeow:auditText \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|http://www.w3.org/2000/01/rdf-schema#label"
msgid "commitment text"
msgstr "texte d’engagement"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|http://www.w3.org/2004/02/skos/core#definition"
msgid "The self-commitment wording of an intention, verbatim. It records the agent's own commitment without manufacturing another party, contractual Commitment or achieved goal."
msgstr "Formulation textuelle d’engagement envers soi d’une intention. Elle consigne l’engagement propre de l’agent sans inventer autre partie, Commitment contractuel ou but atteint."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "Éviter d’inventer des liens source absents ou de déduire exécution et réussite de ce seul enregistrement."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."
msgstr "Conserver valeurs, identités et attribution réelles de la source ; préserver formulation, langue et direction fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Source evidence and configuration remain distinct. Competing attributed records may coexist without a preferred claim."
msgstr "Les preuves source et la configuration restent distinctes. Des enregistrements attribués concurrents peuvent coexister sans déclaration privilégiée."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentText|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:commitmentText \"source-value\" ."
msgstr "ex:record gmeow:commitmentText \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|http://www.w3.org/2000/01/rdf-schema#label"
msgid "commitment origin"
msgstr "origine de l’engagement"

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source's verbatim wording for the origin of a self-commitment. It is a source claim, distinct from structured adoption provenance and contractual authority."
msgstr "Formulation source textuelle de l’origine d’un engagement envers soi. Cette déclaration est distincte de la provenance structurée d’adoption et de l’autorité contractuelle."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "Éviter d’inventer des liens source absents ou de déduire exécution et réussite de ce seul enregistrement."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."
msgstr "Conserver valeurs, identités et attribution réelles de la source ; préserver formulation, langue et direction fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Source evidence and configuration remain distinct. Competing attributed records may coexist without a preferred claim."
msgstr "Les preuves source et la configuration restent distinctes. Des enregistrements attribués concurrents peuvent coexister sans déclaration privilégiée."

msgctxt "https://blackcatinformatics.ca/gmeow/commitmentOrigin|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:commitmentOrigin \"source-value\" ."
msgstr "ex:record gmeow:commitmentOrigin \"source-value\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|http://www.w3.org/2000/01/rdf-schema#label"
msgid "release reason"
msgstr "motif de libération"

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|http://www.w3.org/2004/02/skos/core#definition"
msgid "The verbatim source reason a self-commitment was released, attached to its closed IntentionTenure. Retain the actual interval end and history rather than erasing the intention or inventing an end date."
msgstr "Motif source textuel de libération d’un engagement envers soi, porté par son IntentionTenure fermé. Conserver la fin réelle de l’intervalle et l’historique sans effacer l’intention ni inventer de date."

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "Éviter d’inventer des liens source absents ou de déduire exécution et réussite de ce seul enregistrement."

msgctxt "https://blackcatinformatics.ca/gmeow/releaseReason|https://blackcatinformatics.ca/gmeow/howToUse"
