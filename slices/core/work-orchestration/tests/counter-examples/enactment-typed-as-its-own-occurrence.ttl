#
# The occurrence and the run, collapsed into one node.
#
# A recurring cluster has three layers and they are three different things: a schedule that
# GENERATES occurrences, an occurrence that is a slot on a calendar, and an enactment that
# is the work actually done in response to one. This fixture models the shortcut every
# scheduler invites — the calendar event IS the run — by typing one node both
# logic:Enactment and gmeow:Event.
#
# Everything else here is correct, and that is what makes the collapse worth fixturing. The
# cluster names its goal, its policy, its schedule and its occurrence series; the schedule
# generates the series; the enactment pins the prescription version it ran and the input
# generation it read. A reviewer reading the record sees a well-formed weekly review whose
# week 17 both was scheduled and happened, which is the reading the shortcut is FOR.
#
# What it costs in the world, in two directions:
#
#   * A SKIPPED occurrence becomes indistinguishable from a missing run. Under the
#     collapse, "no node for week 18" is the only representation available for both "the
#     review was cancelled" and "the review was supposed to happen and nobody ran it" — and
#     those call for opposite responses.
#
#   * A run that OUTLIVES its slot becomes unrepresentable. An occurrence is a bounded
#     calendar interval; an enactment that starts in its slot and finishes on Thursday is
#     ordinary, and a node that is both cannot say so without lying about one of them.
#
# It is deliberately NOT the axiom-edge case. tests/counter-examples/logic-axiom-edge-into-
# gmeow.ttl asserts logic:Enactment rdfs:subClassOf gmeow:Event at the SCHEMA level, which
# is the kernel being made to depend on this domain and is caught by the structural
# assertions. This one is an INSTANCE that carries both types, which no schema check sees:
# the classes stay disjointly authored and one record quietly inhabits both.
#
# MUST trip gmeow:EnactmentIsNotOccurrenceConstraint.
#
# Bound by tests/example-conformance.ttl (ex:ecEnactmentTypedAsItsOccurrence,
# gmeow:violates). Self-contained: the harness loads work-orchestration/module.ttl + ONLY
# this file, against the shapes this slice owns.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix fx:    <https://blackcatinformatics.ca/gmeow/examples/work-orchestration/collapsed-occurrence/> .

# --- The continuing cluster, correctly wired ---------------------------------
fx:releaseReviewCluster a gmeow:WorkCluster ;
    rdfs:label "Weekly release review"@x-gmeow-english ;
    gmeow:clusterGoal fx:releasesStayReviewed ;
    gmeow:clusterPolicy fx:releaseReviewPolicy ;
    gmeow:clusterSchedule fx:weeklyThursdaySchedule ;
    gmeow:clusterOccurrenceSeries fx:releaseReviewSeries ;
    gmeow:clusterActivePrescription fx:releaseRunbookV3 ;
    gmeow:clusterEnactment fx:week17 .

fx:releasesStayReviewed a gmeow:Goal ;
    rdfs:label "Every landed release has been reviewed against the release policy"@x-gmeow-english .

fx:releaseReviewPolicy a gmeow:Norm ;
    rdfs:label "Release review policy — quorum, escalation and publication"@x-gmeow-english .

# The GENERATOR. It issues occurrences; it is not itself the work, and the work is not it.
fx:weeklyThursdaySchedule a gmeow:EventSchedule ;
    rdfs:label "Every Thursday at 14:00 UTC"@x-gmeow-english .

fx:releaseReviewSeries a gmeow:EventSeries ;
    rdfs:label "The weekly release-review occurrences"@x-gmeow-english .

fx:releaseRunbookV3 a logic:PrescriptionVersion ;
    rdfs:label "Release review runbook, revision 3"@x-gmeow-english ;
    logic:prescriptionDigest "b3:0a71c4e93b2d58f6014ae37b9c0d25f8a6317be04d95c2f8b17ea630d4c85917" .

fx:week17Inputs a logic:InputSnapshot ;
    rdfs:label "Release candidates as of week 17"@x-gmeow-english ;
    logic:snapshotDigest "b3:7d2f91b6c0a35e84013bc9a7e526d0f38a41c75b93e082d6f5a1c40b7e29d635" .

# --- The collapse ------------------------------------------------------------
#
# One node, both types. It pins its prescription version and its input generation like any
# well-formed run, so nothing about it reads as unfinished; the defect is that it is also
# the calendar slot it was supposed to have been generated BY.
fx:week17 a logic:Enactment , gmeow:Event ;
    rdfs:label "Week 17's release review — the slot and the run, as one node"@x-gmeow-english ;
    logic:enactsPrescriptionVersion fx:releaseRunbookV3 ;
    logic:enactmentInputSnapshot fx:week17Inputs ;
    logic:enactmentState logic:EnactmentCompleted .
