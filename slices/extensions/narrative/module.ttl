    logic:formalizes gmeow:arcCountTimeProperty ; logic:message "A supplied arcCountTimeProperty is an IRI. On an arc reporting a between count, selected-clock values of each cohort record agree under value comparison. Distinct original literal terms denoting the same temporal value remain retained." ; logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CharacterArc ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "clock" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:arcCountTimeProperty ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "clock" ] ] ; logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:termIsIri ; logic:argument [ logic:termIndex 0 ; logic:termVariable "clock" ] ], [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "count" ], [ logic:termIndex 1 ; logic:termVariable "record" ], [ logic:termIndex 2 ; logic:termVariable "left" ], [ logic:termIndex 3 ; logic:termVariable "right" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:arcBetweenCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "count" ] ], [ a logic:Formula ; logic:relation gmeow:arcCountRecord ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "record" ] ], [ a logic:Formula ; logic:relation logic:linkVia ; logic:argument [ logic:termIndex 0 ; logic:termVariable "record" ], [ logic:termIndex 1 ; logic:termVariable "clock" ], [ logic:termIndex 2 ; logic:termVariable "left" ] ], [ a logic:Formula ; logic:relation logic:linkVia ; logic:argument [ logic:termIndex 0 ; logic:termVariable "record" ], [ logic:termIndex 1 ; logic:termVariable "clock" ], [ logic:termIndex 2 ; logic:termVariable "right" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "left" ], [ logic:termIndex 1 ; logic:termVariable "right" ] ] ] ] ] ] ] ] ] .

gmeow:ArcSpecificNextRecordConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "specific breakthrough next record"@x-gmeow-english ;
    skos:definition "An arc classified as insight, decision or settled-question breakthrough retains its exact arcNextRecord. A narrower label alone is not next-step evidence."@x-gmeow-english ;
    gmeow:useWhen "Use to check the supplied reading's intrinsic source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a valid record as proof that the reading, confidence calibration or counted result is true."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the retained source and report unavailable or inconsistent bindings."@x-gmeow-english ;
    skos:scopeNote "This consistency law does not execute a teller, matcher, review or aggregate count."@x-gmeow-english ;
    skos:example "Record the supplied reading: gmeow:ArcSpecificNextRecordConstraint logic:formalizes gmeow:arcNextRecord ."@x-gmeow-english ;
    logic:formalizes gmeow:arcNextRecord ; logic:message "An arc classified as insight, decision or settled-question breakthrough retains its exact arcNextRecord. A narrower label alone is not next-step evidence." ; logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CharacterArc ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "type" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:arcType ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "type" ] ], [ a logic:Formula ; logic:relation logic:termIn ; logic:argument [ logic:termIndex 0 ; logic:termVariable "type" ], [ logic:termIndex 1 ; logic:termIri gmeow:arcTypeInsight ], [ logic:termIndex 2 ; logic:termIri gmeow:arcTypeDecision ], [ logic:termIndex 3 ; logic:termIri gmeow:arcTypeSettledQuestion ] ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "next" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:arcNextRecord ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "next" ] ] ] ] ] ] ] .

# Intrinsic declaration contracts; reported results are not recomputed here.
gmeow:ArcSample logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:resolutionSignal ; logic:allValuesFrom gmeow:ResolutionSignal ] .
gmeow:SignalConfidenceSetting logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:confidenceRule ; logic:allValuesFrom gmeow:SignalConfidenceRule ],
    [ a logic:Restriction ; logic:onProperty gmeow:confidenceSignal ; logic:allValuesFrom [ a logic:Class ; logic:unionOf ( gmeow:ResolutionSignal gmeow:ImpasseSignal ) ] ],
    [ a logic:Restriction ; logic:onProperty gmeow:signalConfidence ; logic:allValuesFrom xsd:decimal ] .
gmeow:SignalConfidenceRule logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:versionOf ; logic:allValuesFrom gmeow:Entity ],
    [ a logic:Restriction ; logic:onProperty gmeow:versionLabel ; logic:allValuesFrom rdfs:Literal ],
    [ a logic:Restriction ; logic:onProperty gmeow:contentDigest ; logic:allValuesFrom rdfs:Literal ],
    [ a logic:Restriction ; logic:onProperty gmeow:wasDerivedFrom ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:wasAttributedTo ; logic:allValuesFrom gmeow:Agent ],
    [ a logic:Restriction ; logic:onProperty gmeow:signalConfidenceReview ; logic:allValuesFrom gmeow:Activity ] .
gmeow:CharacterArc logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:arcFirstRecord ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcNextRecord ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcCountRecord ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcCountThread ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcCountTimeProperty ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcBetweenCount ; logic:allValuesFrom xsd:nonNegativeInteger ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcUndatedCount ; logic:allValuesFrom xsd:nonNegativeInteger ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:SignalConfidenceSetting ; logic:closureKey "https://blackcatinformatics.ca/gmeow/confidenceRule" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:SignalConfidenceSetting ; logic:closureKey "https://blackcatinformatics.ca/gmeow/confidenceSignal" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:SignalConfidenceSetting ; logic:closureKey "https://blackcatinformatics.ca/gmeow/signalConfidence" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:SignalConfidenceRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/versionOf" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:SignalConfidenceRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/versionLabel" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:SignalConfidenceRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/contentDigest" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:SignalConfidenceRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasDerivedFrom" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:SignalConfidenceRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasAttributedTo" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:SignalConfidenceRule ; logic:closureKey "https://blackcatinformatics.ca/gmeow/signalConfidenceReview" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:SignalConfidenceSetting logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:confidenceRule ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:confidenceSignal ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .
gmeow:CharacterArc logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:arcFirstRecord ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcNextRecord ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcCountThread ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcCountTimeProperty ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .
gmeow:SignalConfidenceSetting logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:signalConfidence ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] .
gmeow:CharacterArc logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:arcBetweenCount ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:nonNegativeInteger ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcUndatedCount ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:nonNegativeInteger ] .
