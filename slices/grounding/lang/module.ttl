    gmeow:gmnArity 2 ;
    gmeow:gmnSymbolDisposition gmeow:gmnDispositionStructuredConstructor ;
    gmeow:gmnDispositionBasis gmeow:gmnBasisAmbiguity ;
    gmeow:gmnDispositionRationale "The same minus sign denotes unary negation and binary subtraction; a flat reference glyph cannot carry the arity, so GMN retains an explicit binary constructor." ;
