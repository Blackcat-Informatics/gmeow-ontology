@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =========================================================================== #
# Temporal kernel data shapes
# =========================================================================== #

# A TemporalFrame must carry exactly one TimeScale (calendar and reference
# position are optional). Functional at the frame, not global.
gmeow:TemporalFrameShape
    a sh:NodeShape ;
    rdfs:label "TemporalFrame well-formedness shape"@x-gmeow-english ;
    skos:definition "Closed-world well-formedness for a TemporalFrame: it must carry exactly one gmeow:frameTimeScale, plus the gmeow:frameRealm and gmeow:frameKind inherited from ReferenceFrame. These are functional at the frame, not globally; calendar and reference position remain optional."@x-gmeow-english;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    sh:targetClass gmeow:TemporalFrame ;
    sh:property [
        sh:path gmeow:frameTimeScale ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:TimeScale ;
        sh:severity sh:Violation ;
        sh:message "A TemporalFrame must have exactly one gmeow:frameTimeScale." ;
    ] ;
    sh:property [
        sh:path gmeow:frameRealm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:FrameRealm ;
        sh:severity sh:Violation ;
        sh:message "A TemporalFrame must have exactly one gmeow:frameRealm (inherited from ReferenceFrame)." ;
    ] ;
    sh:property [
        sh:path gmeow:frameKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:FrameKind ;
        sh:severity sh:Violation ;
        sh:message "A TemporalFrame must have exactly one gmeow:frameKind (inherited from ReferenceFrame)." ;
    ] .

# An Instant must carry at least one of instantValue (xsd:dateTime) or edtfValue
# (EDTF literal). It should also be linked to a TemporalFrame when non-default.
gmeow:InstantShape
    a sh:NodeShape ;
    rdfs:label "Instant well-formedness shape"@x-gmeow-english ;
    skos:definition "An Instant must anchor to a value: at least one of gmeow:instantValue (xsd:dateTime) or gmeow:edtfValue (an EDTF literal for imprecise or partial dates). A point in time with no stated value is not an Instant."@x-gmeow-english;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    sh:targetClass gmeow:Instant ;
    sh:or (
        [ sh:path gmeow:instantValue ; sh:minCount 1 ; sh:datatype xsd:dateTime ]
        [ sh:path gmeow:edtfValue ; sh:minCount 1 ; sh:datatype xsd:string ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "An Instant must have either gmeow:instantValue (xsd:dateTime) or gmeow:edtfValue (EDTF literal), or both." .

# A NamedPeriod needs bounds (start+end) OR a temporal measurement.
gmeow:NamedPeriodShape
    a sh:NodeShape ;
    rdfs:label "NamedPeriod well-formedness shape"@x-gmeow-english ;
    skos:definition "A NamedPeriod must be bounded: either both gmeow:periodStart and gmeow:periodEnd (as Instants) or at least one gmeow:hasTemporalMeasurement. A named stretch of time with neither bounds nor a measured duration is underspecified."@x-gmeow-english;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    sh:targetClass gmeow:NamedPeriod ;
    sh:or (
        [
            sh:and (
                [ sh:path gmeow:periodStart ; sh:minCount 1 ; sh:class gmeow:Instant ]
                [ sh:path gmeow:periodEnd ; sh:minCount 1 ; sh:class gmeow:Instant ]
            )
        ]
        [ sh:path gmeow:hasTemporalMeasurement ; sh:minCount 1 ; sh:class gmeow:TemporalMeasurement ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A NamedPeriod must have either (periodStart + periodEnd) or at least one gmeow:hasTemporalMeasurement." .
