    gmeow:saRationale "No CoverageDepth seed individual MUST be typed owl:Class -- the depths are individuals, never subclasses (Principle 9)." .

# --- 13. hasEvidenceClass: ObjectProperty, correct domain/range (MUST) -------
ex:saHasEvidenceClassProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasEvidenceClass a owl:ObjectProperty ;
        rdfs:domain gmeow:CitationAct ;
        rdfs:range gmeow:EvidenceClass .
}""" ;
    gmeow:saRationale "gmeow:hasEvidenceClass MUST be an owl:ObjectProperty with domain gmeow:CitationAct and range gmeow:EvidenceClass." .

# --- 14. hasEvidenceClass is NOT functional (MUST-NOT) ------------------------
ex:saHasEvidenceClassNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:hasEvidenceClass ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:hasEvidenceClass MUST NOT be owl:FunctionalProperty -- competing evidence classifications coexist (Principle 9)." .

