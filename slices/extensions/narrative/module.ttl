    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:sampleSubject, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:sampleSubject and nothing else. It is not a definition of gmeow:sampleSubject (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:sampleSubjectFunctionality logic:characterizes gmeow:sampleSubject ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:storyTimeOfFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    rdfs:label "storyTimeOf is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:storyTimeOf is functional: a story-time frame coordinatizes the in-universe chronology of exactly one narrative reference frame, and a competing continuity carries its own story-time frame rather than a second anchoring on this one."@x-gmeow-english ;
    logic:characterizes gmeow:storyTimeOf ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:storyTimeOf ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:storyTimeOf names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:storyTimeOf, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:storyTimeOf and nothing else. It is not a definition of gmeow:storyTimeOf (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:storyTimeOfFunctionality logic:characterizes gmeow:storyTimeOf ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:BeatFunction
    a logic:Class, logic:AbstractIndividualType ; logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Beat Function"@x-gmeow-english ;
    skos:definition "The attributed structural function of a narrative beat at a position, such as a crisis, threshold or resolution."@x-gmeow-english ;
    skos:example "gmeow:beatFunctionCrisis a gmeow:BeatFunction ."@x-gmeow-english ;
    skos:scopeNote "An open value vocabulary of individuals; generic functions do not impose a universal story structure, order or duration."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a position subclass for every beat function or confusing function with an ordinal."@x-gmeow-english ;
    gmeow:howToUse "Point beatFunction from a frame-bound NarrativePosition at one or more function values."@x-gmeow-english ;
    gmeow:useWhen "Use when structural readings must be queryable rather than buried in position labels."@x-gmeow-english .

gmeow:beatFunction
    a logic:ObjectProperty ; logic:domain gmeow:NarrativePosition ; logic:range gmeow:BeatFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "beat function"@x-gmeow-english ;
    skos:definition "Relates a narrative position to an attributed structural function of its beat."@x-gmeow-english ;
    skos:example "ex:position gmeow:beatFunction gmeow:beatFunctionThreshold ."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional: functions may overlap at one position and competing readers may retain different attributed functions."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a beat-function label as a chronological coordinate or forcing one preferred interpretation."@x-gmeow-english ;
    gmeow:howToUse "Keep positionFrame and the locator on the position; attribute disputed function statements through the statement layer."@x-gmeow-english ;
    gmeow:useWhen "Use for querying which positions a reading treats as structural turning points or unresolved threads."@x-gmeow-english .

gmeow:beatFunctionIncitingIncident
    a gmeow:BeatFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "inciting incident"@x-gmeow-english ;
    skos:definition "A beat that disturbs the established situation and sets a focal narrative development in motion."@x-gmeow-english ;
    skos:example "ex:position gmeow:beatFunction gmeow:beatFunctionIncitingIncident ."@x-gmeow-english ;
    skos:scopeNote "It need not be the first narrated event and may coincide with a threshold."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid assigning this function to opening exposition solely because it appears first."@x-gmeow-english ;
    gmeow:howToUse "Locate the interpreted disturbance and retain the frame and attributing reader."@x-gmeow-english ;
    gmeow:useWhen "Use for the event a reading identifies as initiating its focal development."@x-gmeow-english .

gmeow:beatFunctionThreshold
    a gmeow:BeatFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "threshold"@x-gmeow-english ;
    skos:definition "A beat marking entry into a changed situation, commitment or domain of action."@x-gmeow-english ;
    skos:example "ex:position gmeow:beatFunction gmeow:beatFunctionThreshold ."@x-gmeow-english ;
    skos:scopeNote "A structural crossing, not necessarily a physical doorway or a fixed stage in every story."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid marking every geographic crossing as a narrative threshold."@x-gmeow-english ;
    gmeow:howToUse "Attach the value where the reading locates the change of commitment or situation."@x-gmeow-english ;
    gmeow:useWhen "Use when a beat changes what the character is entering or committed to."@x-gmeow-english .

gmeow:beatFunctionMidpoint
    a gmeow:BeatFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "midpoint turn"@x-gmeow-english ;
    skos:definition "A structural turn interpreted as the midpoint of a focal narrative development."@x-gmeow-english ;
    skos:example "ex:position gmeow:beatFunction gmeow:beatFunctionMidpoint ."@x-gmeow-english ;
    skos:scopeNote "This function is not an assertion that an ordinal is exactly half the total length."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving midpoint function by dividing the number of positions."@x-gmeow-english ;
    gmeow:howToUse "Name the interpreted pivot without replacing its explicit position locator."@x-gmeow-english ;
    gmeow:useWhen "Use for a reorientation that a reading treats as its central structural turn."@x-gmeow-english .

gmeow:beatFunctionCrisis
    a gmeow:BeatFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "crisis"@x-gmeow-english ;
    skos:definition "A beat of acute impasse or pressured choice in a focal narrative development."@x-gmeow-english ;
    skos:example "ex:position gmeow:beatFunction gmeow:beatFunctionCrisis ."@x-gmeow-english ;
    skos:scopeNote "A crisis can precede or overlap a climax; the two functions are not equivalent."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using the function as a clinical diagnosis or as a synonym for any tense scene."@x-gmeow-english ;
    gmeow:howToUse "Mark the position of the interpreted impasse or consequential choice."@x-gmeow-english ;
    gmeow:useWhen "Use where a reading identifies a decisive dilemma or inability to continue unchanged."@x-gmeow-english .

gmeow:beatFunctionClimax
    a gmeow:BeatFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "climax"@x-gmeow-english ;
    skos:definition "A culminating confrontation, action or turn that a reading treats as decisive for its focal tension."@x-gmeow-english ;
    skos:example "ex:position gmeow:beatFunction gmeow:beatFunctionClimax ."@x-gmeow-english ;
    skos:scopeNote "A structural culmination, not automatically the loudest scene or the strongest measured affect."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid computing this function from emotional intensity alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the position and reader that identify the decisive culmination."@x-gmeow-english ;
    gmeow:useWhen "Use for the culminating beat of the development being analysed."@x-gmeow-english .

gmeow:beatFunctionResolution
    a gmeow:BeatFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "resolution"@x-gmeow-english ;
    skos:definition "A beat that settles consequences or releases a focal narrative tension."@x-gmeow-english ;
    skos:example "ex:position gmeow:beatFunction gmeow:beatFunctionResolution ."@x-gmeow-english ;
    skos:scopeNote "Other threads may remain open; narrative resolution is not a formal goal-verification verdict."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid equating this function with proof that every goal was achieved."@x-gmeow-english ;
    gmeow:howToUse "Attach it to the position where the reading finds settlement or consequences."@x-gmeow-english ;
    gmeow:useWhen "Use for closure of the focal tension, even when another thread survives."@x-gmeow-english .

gmeow:beatFunctionOpenThread
    a gmeow:BeatFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "open thread"@x-gmeow-english ;
    skos:definition "A beat that carries an unresolved question, possibility or tension beyond the current focus."@x-gmeow-english ;
    skos:example "ex:position gmeow:beatFunction gmeow:beatFunctionOpenThread ."@x-gmeow-english ;
    skos:scopeNote "An intentional narrative reading, not missing source data or an automatic defect."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating every omitted fact as an open narrative thread."@x-gmeow-english ;
    gmeow:howToUse "Record the position and preserve any simultaneous resolution function."@x-gmeow-english ;
    gmeow:useWhen "Use when a reading keeps a question or possibility alive beyond a beat."@x-gmeow-english .

gmeow:arcTypeMemorial
    a gmeow:ArcType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "memorial arc"@x-gmeow-english ;
    skos:definition "An interpreted trajectory organised around remembrance or commemoration, including an identity shaped by being named in memory of another."@x-gmeow-english ;
    skos:example "ex:arc gmeow:arcType gmeow:arcTypeMemorial ."@x-gmeow-english ;
    skos:scopeNote "An attributed arc interpretation; it does not by itself assert a death, a naming act or a historical relationship."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using the arc type in place of explicit provenance for the remembered person or naming event."@x-gmeow-english ;
    gmeow:howToUse "Create a CharacterArc with subject and narrative frame, attribute the reading and attach this type."@x-gmeow-english ;
    gmeow:useWhen "Use when remembrance or commemoration shapes the trajectory being analysed."@x-gmeow-english .

gmeow:arcTypeHomecoming
    a gmeow:ArcType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "homecoming arc"@x-gmeow-english ;
    skos:definition "An interpreted trajectory of returning to or establishing a place as home, including a house becoming a home."@x-gmeow-english ;
    skos:example "ex:arc gmeow:arcType gmeow:arcTypeHomecoming ."@x-gmeow-english ;
    skos:scopeNote "Belonging is the narrative focus; the value does not assert geographic travel, ownership or a housing tenure."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid applying it to every arrival or using it as evidence of a legal residence."@x-gmeow-english ;
    gmeow:howToUse "Keep the arc subject and frame explicit, whether the trajectory concerns a character, a household or the house itself."@x-gmeow-english ;
    gmeow:useWhen "Use when a place becomes home or a return is interpreted as renewed belonging."@x-gmeow-english .

# Natural-language values retain language and direction; plain text declares no language.
gmeow:NarrativePosition logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:positionLabel ; logic:allValuesFrom [ logic:unionOf ( xsd:string rdf:langString rdf:dirLangString ) ] ] .

# Teller-attributed progress readings and common-thread assertions.

gmeow:arcTypeBreakthrough
    a gmeow:ArcType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "breakthrough arc"@x-gmeow-english ;
    skos:definition "An attributed arc from an impasse where the subject could not continue unchanged to the next step that let it go on. It records sequence rather than cause and differs from recovery after loss; any shared thread is a separate teller assertion."@x-gmeow-english ;
    gmeow:useWhen "Use for a teller’s reading of an impasse followed by a next step."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming that the next event caused the impasse to end or substituting recovery after loss."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:arc gmeow:arcType gmeow:arcTypeBreakthrough ."@x-gmeow-english .

gmeow:ProgressState
    a logic:AbstractIndividualType, logic:Class ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Progress State"@x-gmeow-english ;
    skos:definition "An open quality-value vocabulary for a teller’s reading of whether a subject’s pursuit was blocked or moving at a narrative position, independently of affect and never as a diagnosis."@x-gmeow-english ;
    gmeow:useWhen "Use for progress readings alongside a sample’s affect reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid closing the vocabulary or treating progress as an affect type or clinical finding."@x-gmeow-english ;
    gmeow:howToUse "Mint additional individuals with labels and definitions for distinct readings; keep this value vocabulary open."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:localProgress a gmeow:ProgressState ."@x-gmeow-english .

gmeow:progressStateImpasse
    a gmeow:ProgressState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "impasse"@x-gmeow-english ;
    skos:definition "The teller’s reading that the subject’s pursuit could not continue unchanged at this position. It does not assert incapacity or a diagnosis."@x-gmeow-english ;
    gmeow:useWhen "Use for an attributed blocked-pursuit reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid equating an impasse reading with the subject’s own assertion."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:sample gmeow:sampleProgress gmeow:progressStateImpasse ."@x-gmeow-english .

gmeow:progressStateMoving
    a gmeow:ProgressState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "moving"@x-gmeow-english ;
    skos:definition "The teller’s reading that the subject’s pursuit was moving at this position. It does not assert completion or that a prior impasse was causally resolved."@x-gmeow-english ;
    gmeow:useWhen "Use for an attributed reading of a next step or continuing pursuit."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting motion as success, completion or proof of a causal remedy."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:sample gmeow:sampleProgress gmeow:progressStateMoving ."@x-gmeow-english .

gmeow:sampleProgress
    a logic:ObjectProperty ;
    logic:domain gmeow:ArcSample ;
    logic:range gmeow:ProgressState ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "sample progress"@x-gmeow-english ;
    skos:definition "Relates an arc sample to the teller’s progress reading at its position, independently of the functional affect reading carried by sampleState."@x-gmeow-english ;
    gmeow:useWhen "Use to record impasse or movement beside affect on one sample."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid replacing sampleState or inferring progress from an emotion value."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:sample gmeow:sampleProgress gmeow:progressStateImpasse ."@x-gmeow-english .

gmeow:ImpasseSignal
    a logic:AbstractIndividualType, logic:Class ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Impasse Signal"@x-gmeow-english ;
    skos:definition "An open quality-value vocabulary identifying what kind of source signal a teller used to read an impasse, without making that reading the subject’s claim."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish the source signal behind an impasse reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a signal category as the evidence record itself or as diagnostic proof."@x-gmeow-english ;
    gmeow:howToUse "Mint additional individuals with labels and definitions for distinct readings; keep this value vocabulary open."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:localSignal a gmeow:ImpasseSignal ."@x-gmeow-english .

gmeow:impasseSignalOwnWords
    a gmeow:ImpasseSignal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "own words signal"@x-gmeow-english ;
    skos:definition "A signal category for a teller’s impasse reading based on the subject’s own words, interpreted through a reviewed rule. The category does not supply that rule or assert that the subject declared an impasse."@x-gmeow-english ;
    gmeow:useWhen "Use when a reviewed reading rule matched the subject’s recorded wording."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting a rule match without retaining the wording and rule provenance."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:sample gmeow:impasseSignal gmeow:impasseSignalOwnWords ."@x-gmeow-english .

gmeow:impasseSignalInquirySuspended
    a gmeow:ImpasseSignal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "inquiry suspended signal"@x-gmeow-english ;
    skos:definition "A signal category for a teller’s impasse reading based on the subject parking an inquiry whose recorded status is inquiryStatusSuspended. Suspension alone does not entail an impasse."@x-gmeow-english ;
    gmeow:useWhen "Use when a suspended inquiry is the recorded source signal."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring blocked progress automatically from inquiry suspension."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:sample gmeow:impasseSignal gmeow:impasseSignalInquirySuspended ."@x-gmeow-english .

gmeow:impasseSignal
    a logic:ObjectProperty ;
    logic:domain gmeow:ArcSample ;
    logic:range gmeow:ImpasseSignal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "impasse signal"@x-gmeow-english ;
    skos:definition "Relates an arc sample to the kind of source signal used by its teller to read an impasse. The evidence and attribution remain separate existing provenance records."@x-gmeow-english ;
    gmeow:useWhen "Use to retain why a teller read an impasse at this sample."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating a source record from a signal category or treating it as a subject assertion."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:sample gmeow:impasseSignal gmeow:impasseSignalOwnWords ."@x-gmeow-english .

gmeow:ThreadKind
    a logic:AbstractIndividualType, logic:Class ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Thread Kind"@x-gmeow-english ;
    skos:definition "An open quality-value vocabulary for the common thread asserted by a teller to join an arc’s ends, including an explicit value for no shared thread."@x-gmeow-english ;
    gmeow:useWhen "Use to describe how the teller joined an arc’s ends."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the initial kinds as exhaustive or missing thread data as explicit absence."@x-gmeow-english ;
    gmeow:howToUse "Mint additional individuals with labels and definitions for distinct readings; keep this value vocabulary open."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:localThreadKind a gmeow:ThreadKind ."@x-gmeow-english .

gmeow:arcThread
    a logic:ObjectProperty ;
    logic:domain gmeow:CharacterArc ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "arc thread"@x-gmeow-english ;
    skos:definition "The resource a teller asserts both ends of an arc link to and by which the teller joined them. It may be a working loop, question, intention or record, without implying cause or independently proving the links."@x-gmeow-english ;
    gmeow:useWhen "Use to name the exact common resource asserted by the teller."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid narrowing every thread to a document or treating a common link as a causal explanation."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:arc gmeow:arcThread ex:question ."@x-gmeow-english .

gmeow:arcThreadKind
    a logic:ObjectProperty ;
    logic:domain gmeow:CharacterArc ;
    logic:range gmeow:ThreadKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "arc thread kind"@x-gmeow-english ;
    skos:definition "Relates an arc to its teller’s classification of the asserted common thread. Explicit threadKindNone records no shared thread; an absent classification remains unknown."@x-gmeow-english ;
    gmeow:useWhen "Use with arcThread for a known common resource or threadKindNone for explicit absence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring none from silence or supplying arcThread together with threadKindNone."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:arc gmeow:arcThreadKind gmeow:threadKindQuestion ."@x-gmeow-english .

gmeow:threadKindLoop
    a gmeow:ThreadKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "working loop thread"@x-gmeow-english ;
    skos:definition "A teller’s classification of a shared working loop as the resource joining an arc’s ends."@x-gmeow-english ;
    gmeow:useWhen "Use to record the teller’s explicit thread classification."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting this classification for evidence or treating it as a causal claim."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:arc gmeow:arcThreadKind gmeow:threadKindLoop ."@x-gmeow-english .

gmeow:threadKindQuestion
    a gmeow:ThreadKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "question thread"@x-gmeow-english ;
    skos:definition "A teller’s classification of a shared question as the resource joining an arc’s ends."@x-gmeow-english ;
    gmeow:useWhen "Use to record the teller’s explicit thread classification."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting this classification for evidence or treating it as a causal claim."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:arc gmeow:arcThreadKind gmeow:threadKindQuestion ."@x-gmeow-english .

gmeow:threadKindIntention
    a gmeow:ThreadKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "intention thread"@x-gmeow-english ;
    skos:definition "A teller’s classification of a shared intention as the resource joining an arc’s ends."@x-gmeow-english ;
    gmeow:useWhen "Use to record the teller’s explicit thread classification."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting this classification for evidence or treating it as a causal claim."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:arc gmeow:arcThreadKind gmeow:threadKindIntention ."@x-gmeow-english .

gmeow:threadKindRecord
    a gmeow:ThreadKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "record thread"@x-gmeow-english ;
    skos:definition "A teller’s classification of a shared record, including the first record itself, as the resource joining an arc’s ends."@x-gmeow-english ;
    gmeow:useWhen "Use to record the teller’s explicit thread classification."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting this classification for evidence or treating it as a causal claim."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:arc gmeow:arcThreadKind gmeow:threadKindRecord ."@x-gmeow-english .

gmeow:threadKindNone
    a gmeow:ThreadKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "no shared thread"@x-gmeow-english ;
    skos:definition "The teller explicitly reports no shared resource joining the arc’s ends. This is distinct from missing or unknown thread data."@x-gmeow-english ;
    gmeow:useWhen "Use to record the teller’s explicit thread classification."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving this value from an absent arcThread or combining it with a supplied thread."@x-gmeow-english ;
    gmeow:howToUse "Retain the teller’s vantage and original evidence; use this term without turning the reading into the subject’s assertion."@x-gmeow-english ;
    skos:example "Record this attributed reading: ex:arc gmeow:arcThreadKind gmeow:threadKindNone ."@x-gmeow-english .

gmeow:ArcSample logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:sampleProgress ; logic:allValuesFrom gmeow:ProgressState ],
    [ a logic:Restriction ; logic:onProperty gmeow:impasseSignal ; logic:allValuesFrom gmeow:ImpasseSignal ] .

gmeow:CharacterArc logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:arcThread ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:arcThreadKind ; logic:allValuesFrom gmeow:ThreadKind ] .

gmeow:ArcNoSharedThreadConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "no shared thread exclusion"@x-gmeow-english ;
    skos:definition "An arc explicitly classified threadKindNone has no supplied arcThread resource."@x-gmeow-english ;
    gmeow:useWhen "Use to validate explicit thread assertions without inferring missing values."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency check as proof of endpoint links or causation."@x-gmeow-english ;
    gmeow:howToUse "Check the teller’s supplied arcThreadKind and arcThread relations together."@x-gmeow-english ;
    skos:example "Retain a consistent thread account: gmeow:ArcNoSharedThreadConstraint logic:formalizes gmeow:arcThreadKind ."@x-gmeow-english ;
    logic:formalizes gmeow:arcThreadKind ;
    logic:message "An arc explicitly classified threadKindNone has no supplied arcThread resource." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:arcThreadKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:threadKindNone ] ] ;
            logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "thread" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:arcThread ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "thread" ] ] ] ] ] ] .

gmeow:ArcKnownThreadResourceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "known thread resource requirement"@x-gmeow-english ;
    skos:definition "An arc classified with a seeded loop, question, intention, record or conversation thread kind supplies an arcThread resource. The vocabulary remains open."@x-gmeow-english ;
    gmeow:useWhen "Use to validate explicit thread assertions without inferring missing values."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency check as proof of endpoint links or causation."@x-gmeow-english ;
    gmeow:howToUse "Check the teller’s supplied arcThreadKind and arcThread relations together."@x-gmeow-english ;
    skos:example "Retain a consistent thread account: gmeow:ArcKnownThreadResourceConstraint logic:formalizes gmeow:arcThreadKind ."@x-gmeow-english ;
    logic:formalizes gmeow:arcThreadKind ;
    logic:message "An arc classified with a seeded loop, question, intention, record or conversation thread kind supplies an arcThread resource. The vocabulary remains open." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ],
            [ logic:termIndex 1 ; logic:termVariable "kind" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation gmeow:arcThreadKind ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "kind" ] ],
                [ a logic:Formula ; logic:or
                    [ a logic:Formula ; logic:relation gmeow:arcThreadKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:threadKindLoop ] ],
                    [ a logic:Formula ; logic:relation gmeow:arcThreadKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:threadKindQuestion ] ],
                    [ a logic:Formula ; logic:relation gmeow:arcThreadKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:threadKindIntention ] ],
                    [ a logic:Formula ; logic:relation gmeow:arcThreadKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:threadKindRecord ] ],
                    [ a logic:Formula ; logic:relation gmeow:arcThreadKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:threadKindConversation ] ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "thread" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:arcThread ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "thread" ] ] ] ] ] .

# Qualified next-step readings, reviewed confidence settings and scoped counts.

gmeow:arcTypeInsight
    a logic:NamedIndividual, gmeow:ArcType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "insight breakthrough arc"@x-gmeow-english ;
    skos:definition "A narrower breakthrough whose next-step record is a note attributed to the subject and explicitly tagged as insight, realization or discovery under the selected reading rule. It says the subject came to see something; it does not assert objective discovery or a causal remedy."@x-gmeow-english ;
    gmeow:useWhen "Use when a retained next-step record supports this specific breakthrough reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid refining an open or ambiguous arc or inferring causation from the narrower type."@x-gmeow-english ;
    gmeow:howToUse "Use arcNextRecord for the exact next-step source and retain attribution, selected thread and rule version."@x-gmeow-english ;
    skos:scopeNote "The exact source tag identities and rule version are evidence. A record also tagged as decision, an untagged wording-only step or an open arc keeps arcTypeBreakthrough."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcType gmeow:arcTypeInsight ."@x-gmeow-english .

gmeow:arcTypeDecision
    a logic:NamedIndividual, gmeow:ArcType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "decision breakthrough arc"@x-gmeow-english ;
    skos:definition "A narrower breakthrough whose next-step record is a note attributed to the subject and explicitly tagged as a decision under the selected reading rule. It records a choice, not its implementation or success."@x-gmeow-english ;
    gmeow:useWhen "Use when a retained next-step record supports this specific breakthrough reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid refining an open or ambiguous arc or inferring causation from the narrower type."@x-gmeow-english ;
    gmeow:howToUse "Use arcNextRecord for the exact next-step source and retain attribution, selected thread and rule version."@x-gmeow-english ;
    skos:scopeNote "A note tagged both as decision and as insight, realization or discovery retains arcTypeBreakthrough. Tag labels alone do not identify source tag meaning."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcType gmeow:arcTypeDecision ."@x-gmeow-english .

gmeow:arcTypeSettledQuestion
    a logic:NamedIndividual, gmeow:ArcType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "settled-question breakthrough arc"@x-gmeow-english ;
    skos:definition "A narrower breakthrough whose next step records the subject setting the exact inquiry selected as the arc's thread to inquiryStatusResolved. The inquiry is settled as a pursuit; no answer is thereby asserted true."@x-gmeow-english ;
    gmeow:useWhen "Use when a retained next-step record supports this specific breakthrough reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid refining an open or ambiguous arc or inferring causation from the narrower type."@x-gmeow-english ;
    gmeow:howToUse "Use arcNextRecord for the exact next-step source and retain attribution, selected thread and rule version."@x-gmeow-english ;
    skos:scopeNote "Retain the subject's attributed status-setting record and exact question identity. Mere current resolved status or an unrelated resolved inquiry supplies neither the act nor the thread."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcType gmeow:arcTypeSettledQuestion ."@x-gmeow-english .

gmeow:threadKindConversation
    a logic:NamedIndividual, gmeow:ThreadKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "conversation continuation thread"@x-gmeow-english ;
    skos:definition "A conversation-rooted thread containing every message of that conversation and every structurally continuing conversation. Message membership is partOfThread with the conversation bound. A conversation continues another when one of its messages inReplyTo or groundedIn a message of the other; take the directed transitive continuation closure."@x-gmeow-english ;
    gmeow:useWhen "Use when the selected common resource is the conversation containing the impasse record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid word matching, unbound whole-corpus scans or requiring reply links between every pair of messages."@x-gmeow-english ;
    gmeow:howToUse "Bind arcThread to the root conversation; enumerate its messages by partOfThread and follow only the declared cross-conversation message links."@x-gmeow-english ;
    skos:scopeNote "The root is included by zero continuation steps. Continuing conversations can belong to several root threads; keep exact identities and deduplicate messages by identity, never by text. Cycles terminate by visited conversation identity."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcThreadKind gmeow:threadKindConversation ; gmeow:arcThread ex:conversation ."@x-gmeow-english .

gmeow:ResolutionSignal
    a logic:Class, logic:AbstractIndividualType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf logic:QualityValue ;
    rdfs:label "Resolution Signal"@x-gmeow-english ;
    skos:definition "An open quality-value vocabulary naming what source signal a teller used to read a next step from an impasse. It distinguishes an attributed act from a reading of the subject's own words, without asserting that the impasse was causally resolved."@x-gmeow-english ;
    gmeow:useWhen "Use to make the next-step evidence category explicit."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the category as a source record or as a truth or success verdict."@x-gmeow-english ;
    gmeow:howToUse "Use resolutionSignal on an ArcSample and retain the original record and teller provenance."@x-gmeow-english ;
    skos:scopeNote "These values classify the teller's reading, not the subject's truth, and assert sequence without cause."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:sample gmeow:resolutionSignal gmeow:resolutionSignalAct ."@x-gmeow-english .

gmeow:resolutionSignalAct
    a logic:NamedIndividual, gmeow:ResolutionSignal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "act next-step signal"@x-gmeow-english ;
    skos:definition "A teller's next-step reading grounded in a retained act of the subject on the selected thread: a decision or insight note, or the subject's setting of the exact inquiry to resolved."@x-gmeow-english ;
    gmeow:useWhen "Use to identify the source evidence behind one next-step reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid replacing retained source evidence with the signal category."@x-gmeow-english ;
    gmeow:howToUse "Annotate the exact resolutionSignal statement with teller confidence and retain its reason and rule setting."@x-gmeow-english ;
    skos:scopeNote "An act classification records the stronger kind of source evidence, not a universal numerical confidence, objective truth or successful execution."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:sample gmeow:resolutionSignal gmeow:resolutionSignalAct ."@x-gmeow-english .

gmeow:resolutionSignalOwnWords
    a logic:NamedIndividual, gmeow:ResolutionSignal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "own-words next-step signal"@x-gmeow-english ;
    skos:definition "A teller's next-step reading from the subject's own recorded words matched through an exact reviewed cue release and reading rule. Word evidence does not manufacture an act or its type."@x-gmeow-english ;
    gmeow:useWhen "Use to identify the source evidence behind one next-step reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid replacing retained source evidence with the signal category."@x-gmeow-english ;
    gmeow:howToUse "Annotate the exact resolutionSignal statement with teller confidence and retain its reason and rule setting."@x-gmeow-english ;
    skos:scopeNote "Retain the matched source literal, source attribution, cue release and rule identity; a label or paraphrase alone is insufficient evidence of a match."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:sample gmeow:resolutionSignal gmeow:resolutionSignalOwnWords ."@x-gmeow-english .

gmeow:resolutionSignal
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "resolution signal"@x-gmeow-english ;
    skos:definition "Relates an ArcSample to the source-signal category used by its teller to read a next step. This relation adds evidence classification beside sampleProgress; it does not retype the sample as a Refinement."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the next-step signal on its actual observation sample."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using refinementOutcome on an ArcSample or asserting the teller's reading as the subject's own claim."@x-gmeow-english ;
    gmeow:howToUse "Keep vantage and original source evidence on the sample; annotate each signal statement independently."@x-gmeow-english ;
    skos:scopeNote "These values classify the teller's reading, not the subject's truth, and assert sequence without cause."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:sample gmeow:resolutionSignal gmeow:resolutionSignalAct ."@x-gmeow-english ;
    logic:domain gmeow:ArcSample ; logic:range gmeow:ResolutionSignal .

gmeow:SignalConfidenceRule
    a logic:Class, logic:Kind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:label "Signal Confidence Rule"@x-gmeow-english ;
    skos:definition "An immutable reviewed version of the signal-confidence configuration used by a teller's reading rule. Its settings map signal categories to decimal degrees for that exact version; it is source configuration, not an executable logic:Rule or a calibrated probability model."@x-gmeow-english ;
    gmeow:useWhen "Use to keep a reviewed numeric reading policy as versioned source data."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid hard-coding values or mutating an existing version when values or reasons change."@x-gmeow-english ;
    gmeow:howToUse "Retain versionOf, versionLabel, contentDigest, wasDerivedFrom, wasAttributedTo and signalConfidenceReview; link each setting with confidenceRule."@x-gmeow-english ;
    skos:scopeNote "Each rule version is independent; numeric settings never live on shared signal vocabulary individuals."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:ruleV1 a gmeow:SignalConfidenceRule ; gmeow:versionOf ex:ruleLineage ."@x-gmeow-english .

gmeow:SignalConfidenceSetting
    a logic:Class, logic:Kind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:label "Signal Confidence Setting"@x-gmeow-english ;
    skos:definition "One signal category's decimal confidence setting in one exact reviewed rule version. The category may be a ResolutionSignal or an ImpasseSignal; the setting is not the signal singleton and does not assign a global value to every teller."@x-gmeow-english ;
    gmeow:useWhen "Use to retain one rule-specific value and its signal binding."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid placing signalConfidence directly on resolutionSignalAct or another shared vocabulary individual."@x-gmeow-english ;
    gmeow:howToUse "Supply confidenceRule, confidenceSignal and exactly one signalConfidence; cite the setting from the qualified signal statement."@x-gmeow-english ;
    skos:scopeNote "Each rule version is independent; numeric settings never live on shared signal vocabulary individuals."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:actSetting a gmeow:SignalConfidenceSetting ; gmeow:confidenceRule ex:ruleV1 ."@x-gmeow-english .

gmeow:confidenceRule
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "confidence rule version"@x-gmeow-english ;
    skos:definition "The exactly-one reviewed SignalConfidenceRule version that owns this SignalConfidenceSetting. Several tellers may explicitly use the same version; differing policies retain distinct version identities."@x-gmeow-english ;
    gmeow:useWhen "Use to bind a confidence setting to exact policy bytes."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring policy identity from a version label or numeric equality."@x-gmeow-english ;
    gmeow:howToUse "Name the immutable rule version and retain its review and source provenance."@x-gmeow-english ;
    skos:scopeNote "Each rule version is independent; numeric settings never live on shared signal vocabulary individuals."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:actSetting gmeow:confidenceRule ex:ruleV1 ."@x-gmeow-english ;
    logic:domain gmeow:SignalConfidenceSetting ; logic:range gmeow:SignalConfidenceRule .

gmeow:confidenceSignal
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "confidence signal category"@x-gmeow-english ;
    skos:definition "The exactly-one ResolutionSignal or ImpasseSignal category covered by a rule-version setting. It names the category, not the source record or an observed match."@x-gmeow-english ;
    gmeow:useWhen "Use for both next-step and impasse signal confidence without changing either value vocabulary."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid assigning a numeric value directly to this target resource."@x-gmeow-english ;
    gmeow:howToUse "Bind the signal category on its own setting and keep source evidence on the actual sample or statement."@x-gmeow-english ;
    skos:scopeNote "Each rule version is independent; numeric settings never live on shared signal vocabulary individuals."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:actSetting gmeow:confidenceSignal gmeow:resolutionSignalAct ."@x-gmeow-english ;
    logic:domain gmeow:SignalConfidenceSetting ; logic:range [ a logic:Class ; logic:unionOf ( gmeow:ResolutionSignal gmeow:ImpasseSignal ) ] .

gmeow:signalConfidence
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "signal confidence"@x-gmeow-english ;
    skos:definition "The exactly-one decimal degree in the closed interval [0,1] supplied by a reviewed rule-version setting for its signal category. It is the teller's confidence in its own reading, not the subject's truth or a claim of calibrated frequency."@x-gmeow-english ;
    gmeow:useWhen "Use as versioned source configuration for a qualified signal statement."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid making this property a subtype of statement-level confidence or attaching values to shared signal individuals."@x-gmeow-english ;
    gmeow:howToUse "Copy the selected setting value to existing confidence on the exact signal statement; retain accordingTo, source evidence, the setting and a language-bearing reason."@x-gmeow-english ;
    skos:scopeNote "The decimal bound is checked by a canonical ValueRangeConstraint. Existing statement confidence remains the output carrier; no probability distribution, causal probability or statistical confidence interval is asserted."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:actSetting gmeow:signalConfidence \"0.9\"^^xsd:decimal ."@x-gmeow-english ;
    logic:domain gmeow:SignalConfidenceSetting ; logic:range xsd:decimal ; rdfs:seeAlso gmeow:confidence, math:Interval .

gmeow:signalConfidenceReview
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "signal confidence review"@x-gmeow-english ;
    skos:definition "The completed review activity for the exact confidence-rule version. Reviewer association and sign-off instant are retained through wasAssociatedWith and atTime, without claiming universal endorsement or executing a review."@x-gmeow-english ;
    gmeow:useWhen "Use to retain accountable review of the actual numeric policy release."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reusing a review for changed settings or presenting a reviewer name string as its activity."@x-gmeow-english ;
    gmeow:howToUse "Link the rule version to its review activity and retain reviewer and time evidence."@x-gmeow-english ;
    skos:scopeNote "Each rule version is independent; numeric settings never live on shared signal vocabulary individuals."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:ruleV1 gmeow:signalConfidenceReview ex:review ."@x-gmeow-english ;
    logic:domain gmeow:SignalConfidenceRule ; logic:range gmeow:Activity .

gmeow:arcBetweenCount
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "arc intervening record count"@x-gmeow-english ;
    skos:definition "The nonnegative count of distinct selected-thread source records strictly between arcFirstRecord and arcNextRecord under arcCountTimeProperty. Exclude both endpoint records and records tied with either endpoint; count each remaining record identity once."@x-gmeow-english ;
    gmeow:useWhen "Use for a complete, reproducible intervening-record count on a closed arc."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid counting samples, messages twice through multiple continuation paths, or records from a different selected thread."@x-gmeow-english ;
    gmeow:howToUse "Retain the finite arcCountRecord cohort, arcCountThread, exact endpoint records and selected time-property IRI. Omit an unavailable count rather than substitute zero."@x-gmeow-english ;
    skos:scopeNote "Counts are supplied observations of a selected finite source cohort, not values computed by these ontology declarations. Missing or incomparable time data must remain visible; no zero or timestamp is invented."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcBetweenCount \"1\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    logic:domain gmeow:CharacterArc ; logic:range xsd:nonNegativeInteger .

gmeow:arcUndatedCount
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "arc undated record count"@x-gmeow-english ;
    skos:definition "The nonnegative count of distinct arcCountRecord cohort members carrying no value of the selected arcCountTimeProperty. It covers the selected thread cohort, not only records already placed between the ends, and includes undated endpoint records if present."@x-gmeow-english ;
    gmeow:useWhen "Use to report missing source times without dropping the records."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid relabelling a supplied coarse or ambiguous temporal value as absent or converting a missing count to zero."@x-gmeow-english ;
    gmeow:howToUse "Count distinct identities without the selected field; retain coarse, conflicting or incomparable supplied values separately and disclose when they prevent a complete between count."@x-gmeow-english ;
    skos:scopeNote "Counts are supplied observations of a selected finite source cohort, not values computed by these ontology declarations. Missing or incomparable time data must remain visible; no zero or timestamp is invented."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcUndatedCount \"1\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    logic:domain gmeow:CharacterArc ; logic:range xsd:nonNegativeInteger .

gmeow:arcFirstRecord
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "arc first record"@x-gmeow-english ;
    skos:definition "The exact source record selected as this telling's impasse endpoint. It identifies evidence, not the first record in a corpus or an inferred cause."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish the impasse endpoint from other arc evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid selecting an endpoint by list order, earliest available timestamp or shared words alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the source identity, teller attribution and the sample derived from it; include it in a supplied count cohort."@x-gmeow-english ;
    skos:scopeNote "Counts are supplied observations of a selected finite source cohort, not values computed by these ontology declarations. Missing or incomparable time data must remain visible; no zero or timestamp is invented."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcFirstRecord ex:impasseRecord ."@x-gmeow-english ;
    logic:domain gmeow:CharacterArc ; logic:range logic:Thing .

gmeow:arcNextRecord
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "arc next-step record"@x-gmeow-english ;
    skos:definition "The exact source record selected as this telling's next step after its impasse. Its source evidence supports a narrower breakthrough type where justified; absence leaves an open arc rather than fabricating an end."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the particular next-step evidence used by a teller."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid selecting an unrelated later record or treating the next step as a causal remedy."@x-gmeow-english ;
    gmeow:howToUse "Keep the record's actual subject attribution, tag or inquiry evidence and narrative position; include it in a supplied between-count cohort."@x-gmeow-english ;
    skos:scopeNote "Counts are supplied observations of a selected finite source cohort, not values computed by these ontology declarations. Missing or incomparable time data must remain visible; no zero or timestamp is invented."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcNextRecord ex:decisionNote ."@x-gmeow-english ;
    logic:domain gmeow:CharacterArc ; logic:range logic:Thing .

gmeow:arcCountRecord
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "arc count cohort record"@x-gmeow-english ;
    skos:definition "One source record in the explicitly retained finite cohort used for this arc's counts. The cohort contains every selected-thread record in the retained source snapshot, including endpoints and undated records; membership is not inferred from arcEvidence alone."@x-gmeow-english ;
    gmeow:useWhen "Use to make the exact counted population recoverable."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid prefiltering undated records by a time window or treating evidence citations as a complete cohort."@x-gmeow-english ;
    gmeow:howToUse "Enumerate the identity-deduplicated thread cohort and retain snapshot provenance through wasDerivedFrom and contentDigest."@x-gmeow-english ;
    skos:scopeNote "Counts are supplied observations of a selected finite source cohort, not values computed by these ontology declarations. Missing or incomparable time data must remain visible; no zero or timestamp is invented."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcCountRecord ex:impasseRecord, ex:interveningRecord, ex:decisionNote, ex:undatedRecord ."@x-gmeow-english ;
    logic:domain gmeow:CharacterArc ; logic:range logic:Thing .

gmeow:arcCountThread
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "arc selected count thread"@x-gmeow-english ;
    skos:definition "The exactly-one supplied arcThread resource selected for an arc's reported counts. Selection does not replace other coexisting thread assertions or claim a globally preferred thread."@x-gmeow-english ;
    gmeow:useWhen "Use when a numeric report must name its particular common-thread scope."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pooling records from all arcThread values or inferring a thread from a missing value."@x-gmeow-english ;
    gmeow:howToUse "Name one of this arc's actual arcThread resources and retain the corresponding selected source cohort."@x-gmeow-english ;
    skos:scopeNote "Counts are supplied observations of a selected finite source cohort, not values computed by these ontology declarations. Missing or incomparable time data must remain visible; no zero or timestamp is invented."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcCountThread ex:conversation ."@x-gmeow-english ;
    logic:domain gmeow:CharacterArc ; logic:range logic:Thing .

gmeow:arcCountTimeProperty
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "arc count time property"@x-gmeow-english ;
    skos:definition "The exactly-one source time-property IRI selected for an arc's counts. It fixes which clock is read; record creation, event occurrence and statement assertion clocks are not interchangeable."@x-gmeow-english ;
    gmeow:useWhen "Use to make the selected source clock explicit."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring chronology from positionOrdinal, substituting updatedAt for recordedAt or manufacturing timezone and precision."@x-gmeow-english ;
    gmeow:howToUse "Retain the property IRI and original values. A complete between count requires endpoint and dated-cohort comparisons to be decidable without inventing missing temporal precision."@x-gmeow-english ;
    skos:scopeNote "Counts are supplied observations of a selected finite source cohort, not values computed by these ontology declarations. Missing or incomparable time data must remain visible; no zero or timestamp is invented."@x-gmeow-english ;
    skos:example "Record the supplied reading: ex:arc gmeow:arcCountTimeProperty gmeow:recordedAt ."@x-gmeow-english ;
    logic:domain gmeow:CharacterArc .

gmeow:SignalConfidenceRangeConstraint
    a logic:ValueRangeConstraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "signal confidence unit-range constraint"@x-gmeow-english ;
    skos:definition "Every supplied signalConfidence value on a SignalConfidenceSetting lies in the closed decimal interval [0,1]. This validates the degree without asserting calibration or a probability distribution."@x-gmeow-english ;
    gmeow:useWhen "Use to check the actual configured degree."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid clipping an invalid value or treating a missing setting as zero."@x-gmeow-english ;
    gmeow:howToUse "Retain the supplied decimal and fail the setting when it falls outside the closed bounds."@x-gmeow-english ;
    skos:scopeNote "The bounds are ordinary numeric comparisons in the canonical validation vocabulary; statement confidence remains a separate provenance carrier."@x-gmeow-english ;
    skos:example "Record the supplied reading: gmeow:SignalConfidenceRangeConstraint logic:valuePath gmeow:signalConfidence ."@x-gmeow-english ;
    logic:onClass gmeow:SignalConfidenceSetting ; logic:valuePath gmeow:signalConfidence ; logic:minInclusiveBound "0"^^xsd:decimal ; logic:maxInclusiveBound "1"^^xsd:decimal ; logic:formalizes gmeow:signalConfidence .

gmeow:SignalConfidenceReviewEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "confidence review evidence constraint"@x-gmeow-english ;
    skos:definition "Every supplied signalConfidenceReview retains a responsible reviewer association and a sign-off instant on the actual review activity."@x-gmeow-english ;
    gmeow:useWhen "Use to check the supplied reading's intrinsic source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a valid record as proof that the reading, confidence calibration or counted result is true."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the retained source and report unavailable or inconsistent bindings."@x-gmeow-english ;
    skos:scopeNote "This consistency law does not execute a teller, matcher, review or aggregate count."@x-gmeow-english ;
    skos:example "Record the supplied reading: gmeow:SignalConfidenceReviewEvidenceConstraint logic:formalizes gmeow:signalConfidenceReview ."@x-gmeow-english ;
    logic:formalizes gmeow:signalConfidenceReview ; logic:message "Every supplied signalConfidenceReview retains a responsible reviewer association and a sign-off instant on the actual review activity." ; logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:SignalConfidenceRule ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "review" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:signalConfidenceReview ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "review" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "reviewer" ], [ logic:termIndex 1 ; logic:termVariable "instant" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:wasAssociatedWith ; logic:argument [ logic:termIndex 0 ; logic:termVariable "review" ], [ logic:termIndex 1 ; logic:termVariable "reviewer" ] ], [ a logic:Formula ; logic:relation gmeow:atTime ; logic:argument [ logic:termIndex 0 ; logic:termVariable "review" ], [ logic:termIndex 1 ; logic:termVariable "instant" ] ] ] ] ] ] ] ] .

gmeow:SignalConfidenceRuleIdentityConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "confidence rule version identity"@x-gmeow-english ;
    skos:definition "A SignalConfidenceRule version differs from every lineage resource named by its versionOf relation."@x-gmeow-english ;
    gmeow:useWhen "Use to check the supplied reading's intrinsic source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a valid record as proof that the reading, confidence calibration or counted result is true."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the retained source and report unavailable or inconsistent bindings."@x-gmeow-english ;
    skos:scopeNote "This consistency law does not execute a teller, matcher, review or aggregate count."@x-gmeow-english ;
    skos:example "Record the supplied reading: gmeow:SignalConfidenceRuleIdentityConstraint logic:formalizes gmeow:SignalConfidenceRule ."@x-gmeow-english ;
    logic:formalizes gmeow:SignalConfidenceRule ; logic:message "A SignalConfidenceRule version differs from every lineage resource named by its versionOf relation." ; logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:SignalConfidenceRule ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "lineage" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:versionOf ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "lineage" ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termDistinct ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "lineage" ] ] ] ] ] ] .

gmeow:SignalConfidenceSettingUniqueConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/narrative> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "confidence setting per-version uniqueness"@x-gmeow-english ;
    skos:definition "One confidence-rule version has at most one setting identity for a given signal category. Different versions may configure that same signal independently."@x-gmeow-english ;
    gmeow:useWhen "Use to check the supplied reading's intrinsic source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a valid record as proof that the reading, confidence calibration or counted result is true."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the retained source and report unavailable or inconsistent bindings."@x-gmeow-english ;
    skos:scopeNote "This consistency law does not execute a teller, matcher, review or aggregate count."@x-gmeow-english ;
    skos:example "Record the supplied reading: gmeow:SignalConfidenceSettingUniqueConstraint logic:formalizes gmeow:SignalConfidenceSetting ."@x-gmeow-english ;
