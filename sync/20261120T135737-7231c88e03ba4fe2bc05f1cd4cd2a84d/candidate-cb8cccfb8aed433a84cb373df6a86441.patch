-        let (Some(Node::Iri(class_iri)), Some(Node::Iri(path))) = (
-            value(store, &rec, &nn(&logic_iri("onClass"))),
-            value(store, &rec, &nn(&logic_iri("valuePath"))),
-        ) else {
-            continue;
-        };
-        if !is_authoring_ns(&class_iri) || optouts.contains(&class_iri) || optouts.contains(&path) {
-            continue;
