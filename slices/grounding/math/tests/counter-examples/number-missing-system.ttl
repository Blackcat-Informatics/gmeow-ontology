#
# This rational number declares exactness and omits its math:inNumberSystem
# link. The ex:ecNumberMissingSystem cell checks for at least one
# math:UnsituatedNumber finding and rejects findings outside that class in
# the class-isolation channels.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <http://example.org/math/> .

ex:unsituatedNumber a math:RationalNumber ;
    math:isExact true .
