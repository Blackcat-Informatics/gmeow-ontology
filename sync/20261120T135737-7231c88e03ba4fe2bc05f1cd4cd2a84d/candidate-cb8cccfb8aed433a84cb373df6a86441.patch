+
+//! Borrowed execution views issued after checking the original compilation.
+
+use std::convert::Infallible;
+
+use purrdf::{
+    DatasetView, GraphMatch, QuadIds, RdfDataset, RdfStoreCapabilities, TermId, TermRef, TermValue,
+};
+
+use crate::frontend::{AxiomSource, FormulaLowering, SourceCarrier, SourceStatementBinding};
+use crate::ir::{Formula, LogicAxiom, LogicRule};
+use crate::source_inventory::{SourceInventory, SourceObligation};
+
+use super::{ResolvedTheorySelection, index::Membership};
+
+/// Execution membership is distinct from the profile's semantic disposition.
+#[derive(Debug, Clone, Copy)]
+pub enum TheoryUnitSelection<'selection> {
+    Included,
+    OutsideRequestedTheory,
+    Blocked {
+        code: &'static str,
+        reason: &'selection str,
+    },
+}
+
+impl<'a> From<Membership<'a>> for TheoryUnitSelection<'a> {
+    fn from(membership: Membership<'a>) -> Self {
+        match membership {
+            Membership::Included => Self::Included,
+            Membership::Outside => Self::OutsideRequestedTheory,
+            Membership::Blocked(boundary) => Self::Blocked {
+                code: boundary.code,
+                reason: &boundary.detail,
+            },
+        }
+    }
+}
+
+impl ResolvedTheorySelection {
+    /// Borrow the filtered physical streams of this exact source publication.
+    ///
+    /// # Errors
+    /// Refuses a foreign compilation or document/root selection.
+    pub fn source_view<'a, 'source>(
+        &'a self,
+        inventory: &'a SourceInventory<'source>,
+    ) -> gmeow_errors::Result<SelectedSourceView<'a>> {
+        self.authorize_inventory(inventory)?;
+        Ok(SelectedSourceView {
+            dataset: inventory.theory().source().dataset(),
+            selection: self,
+        })
+    }
+
+    /// Borrow original program coordinates without copying or reindexing IR.
+    ///
+    /// # Errors
+    /// Refuses a foreign compilation or document/root selection.
+    pub fn program_view<'a, 'source>(
+        &'a self,
+        inventory: &'a SourceInventory<'source>,
+    ) -> gmeow_errors::Result<SelectedProgramView<'a, 'source>> {
+        self.authorize_inventory(inventory)?;
+        Ok(SelectedProgramView {
+            inventory,
+            selection: self,
+        })
+    }
+
+    /// Account for one obligation from its actual immutable inventory.
+    ///
+    /// # Errors
+    /// Refuses obligations borrowed from another compilation or selection.
+    pub fn unit_selection(
+        &self,
+        unit: SourceObligation<'_>,
+    ) -> gmeow_errors::Result<TheoryUnitSelection<'_>> {
+        self.authorize_inventory(unit.inventory)?;
+        let membership = self
+            .0
+            .index
+            .obligation_membership(unit.inventory, unit.origin());
+        // Top-level mode has no authority to exclude authored obligations.
+        if !self.request().is_composed() && matches!(membership, Membership::Outside) {
+            return Ok(TheoryUnitSelection::Blocked {
+                code: "CONTEXT_ERASURE_FORBIDDEN",
+                reason: "source scope remains untranslated in the top-level theory",
+            });
+        }
+        Ok(membership.into())
+    }
+
+    /// Whether an actually selected successful correspondence accounts this row.
+    /// A shared rule path does not select an otherwise excluded catalogue owner.
+    pub fn correspondence_record_selected(
+        &self,
+        unit: SourceObligation<'_>,
+    ) -> gmeow_errors::Result<bool> {
+        self.authorize_inventory(unit.inventory)?;
+        let crate::source_inventory::SourceObligationOrigin::Statement(binding) = unit.origin()
+        else {
+            return Ok(false);
+        };
+        Ok(self
+            .0
+            .index
+            .correspondence_record_selected(unit.inventory, binding))
+    }
+
+    /// Original formula-lowering ordinal asserted by this admitted physical module link.
+    ///
+    /// # Errors
+    /// Refuses obligations borrowed from another compilation or selection.
+    pub fn selected_module_formula(
+        &self,
+        unit: SourceObligation<'_>,
+    ) -> gmeow_errors::Result<Option<usize>> {
+        self.authorize_inventory(unit.inventory)?;
+        let crate::source_inventory::SourceObligationOrigin::Statement(binding) = unit.origin()
+        else {
+            return Ok(None);
+        };
+        Ok(self.0.index.selected_module_formula(binding))
+    }
+
+    /// Selected formula ordinals and independent ownership of this exact evidence row.
+    /// Native coverage checks still apply to every returned formula occurrence.
+    ///
+    /// # Errors
+    /// Refuses obligations borrowed from another compilation or selection.
+    pub fn formula_evidence_origins(
+        &self,
+        unit: SourceObligation<'_>,
+    ) -> gmeow_errors::Result<Option<(&[usize], bool)>> {
+        self.authorize_inventory(unit.inventory)?;
+        let crate::source_inventory::SourceObligationOrigin::Statement(binding) = unit.origin()
+        else {
+            return Ok(None);
+        };
+        Ok(self
+            .0
+            .index
+            .formula_evidence
+            .get(&binding)
+            .map(|evidence| (evidence.origins.as_slice(), evidence.independent_owner)))
+    }
+}
+
+/// Original-indexed, borrowed IR admitted by the compiler's source ownership.
+#[derive(Clone, Copy)]
+pub struct SelectedProgramView<'selection, 'source> {
+    inventory: &'selection SourceInventory<'source>,
+    selection: &'selection ResolvedTheorySelection,
+}
+
+impl SelectedProgramView<'_, '_> {
+    /// Classify an original axiom index without manufacturing an obligation.
+    ///
+    /// # Errors
+    /// Refuses an index outside this immutable compilation.
+    pub fn axiom_selection(&self, index: usize) -> gmeow_errors::Result<TheoryUnitSelection<'_>> {
+        let sources = self
+            .inventory
+            .theory()
+            .axiom_sources()
+            .get(index)
+            .ok_or_else(|| super::selection_error("UNKNOWN_SELECTED_AXIOM", index))?;
+        let mut outside = false;
+        let mut blocked = None;
+        for source in sources {
+            match self
+                .selection
+                .0
+                .index
+                .axiom_source_membership(self.inventory, source)
+            {
+                Some(Membership::Included) => return Ok(TheoryUnitSelection::Included),
+                Some(Membership::Outside) => outside = true,
+                Some(Membership::Blocked(boundary)) => blocked = Some(boundary),
+                None => {}
+            }
+        }
+        if let Some(boundary) = blocked {
+            return Ok(Membership::Blocked(boundary).into());
+        }
+        if outside && self.selection.request().is_composed() {
+            return Ok(TheoryUnitSelection::OutsideRequestedTheory);
+        }
+        Ok(TheoryUnitSelection::Blocked {
+            code: "NO_EXECUTABLE_OWNER_PATH",
+            reason: "axiom has no admitted original source contributor",
+        })
+    }
+
+    pub fn axioms(&self) -> impl Iterator<Item = (usize, &LogicAxiom)> {
+        self.inventory
+            .theory()
+            .program()
+            .axioms
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| self.selection.0.index.axioms[*index])
+    }
+
+    pub fn rules(&self) -> impl Iterator<Item = (usize, &LogicRule)> {
+        self.inventory
+            .theory()
+            .program()
+            .rules
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| self.selection.0.index.rules[*index])
+    }
+
+    pub fn formulas(&self) -> impl Iterator<Item = (usize, &Formula)> {
+        self.inventory
+            .theory()
+            .program()
+            .formulas
+            .iter()
+            .enumerate()
+            .filter(|(index, _)| self.selection.0.index.formulas[*index])
+    }
+
+    /// Every admitted source occurrence survives shared-AST deduplication.
+    pub fn formula_lowerings(&self) -> impl Iterator<Item = (usize, &FormulaLowering)> {
+        self.inventory
+            .theory()
+            .formula_lowerings()
+            .iter()
+            .enumerate()
+            .filter(|(ordinal, _)| self.selection.0.index.formula_occurrences[*ordinal])
+    }
+
+    /// Admitted contributors only, retaining their original axiom coordinate.
+    pub fn axiom_sources(&self) -> impl Iterator<Item = (usize, &AxiomSource)> {
+        self.inventory
+            .theory()
+            .axiom_sources()
+            .iter()
+            .enumerate()
+            .flat_map(|(index, sources)| sources.iter().map(move |source| (index, source)))
+            .filter(|(_, source)| {
+                matches!(
+                    self.selection
+                        .0
+                        .index
+                        .axiom_source_membership(self.inventory, source),
+                    Some(Membership::Included)
+                )
+            })
+    }
+
+    /// Borrow the admitted contributors of one original axiom coordinate.
+    ///
+    /// # Errors
+    /// Refuses an index outside this immutable compilation.
+    pub fn axiom_sources_at(
+        &self,
+        index: usize,
+    ) -> gmeow_errors::Result<impl Iterator<Item = &AxiomSource>> {
+        let sources = self
+            .inventory
+            .theory()
+            .axiom_sources()
+            .get(index)
+            .ok_or_else(|| super::selection_error("UNKNOWN_SELECTED_AXIOM", index))?;
+        Ok(sources.iter().filter(move |source| {
+            matches!(
+                self.selection
+                    .0
+                    .index
+                    .axiom_source_membership(self.inventory, source),
+                Some(Membership::Included)
+            )
+        }))
+    }
+
+    /// Non-excluded observations retain blocked carriers for diagnostics only.
+    pub(crate) fn axiom_source_observations_at(
+        &self,
+        index: usize,
+    ) -> gmeow_errors::Result<impl Iterator<Item = &AxiomSource>> {
+        let sources = self
+            .inventory
+            .theory()
+            .axiom_sources()
+            .get(index)
+            .ok_or_else(|| super::selection_error("UNKNOWN_SELECTED_AXIOM", index))?;
+        Ok(sources.iter().filter(move |source| {
+            matches!(
+                self.selection
+                    .0
+                    .index
+                    .axiom_source_membership(self.inventory, source),
+                Some(Membership::Included | Membership::Blocked(_))
+            )
+        }))
+    }
+
+    #[must_use]
+    pub fn selection(&self) -> &ResolvedTheorySelection {
+        self.selection
+    }
+}
+
+/// A subsequence of each original physical stream, with unchanged native IDs.
+/// Term lookup delegates to the complete dictionary; it never asserts a term.
+pub struct SelectedSourceView<'selection> {
+    dataset: &'selection RdfDataset,
+    selection: &'selection ResolvedTheorySelection,
+}
+
+impl SelectedSourceView<'_> {
+    fn allowed(&self, canonical: QuadIds, carrier: SourceCarrier) -> bool {
+        !self
+            .selection
+            .0
+            .index
+            .excluded_rows
+            .contains(&SourceStatementBinding { canonical, carrier })
+    }
+}
+
+impl DatasetView for SelectedSourceView<'_> {
+    type Id = TermId;
+    type ReadError = Infallible;
+    type TermGuard<'a>
+        = TermRef<'a>
+    where
+        Self: 'a;
+    type ProbePlan = <RdfDataset as DatasetView>::ProbePlan;
+
+    fn quads(&self) -> impl Iterator<Item = QuadIds> + '_ {
+        self.dataset
+            .quads()
+            .zip(&self.selection.0.index.ordinary)
+            .filter_map(|(quad, &admitted)| admitted.then_some(quad))
+    }
+    fn resolve(&self, id: TermId) -> Result<TermRef<'_>, Infallible> {
+        Ok(self.dataset.resolve(id))
+    }
+    fn term_id_by_value(&self, value: &TermValue) -> Result<Option<TermId>, Infallible> {
+        DatasetView::term_id_by_value(self.dataset, value)
+    }
+    fn capabilities(&self) -> RdfStoreCapabilities {
+        self.dataset.capabilities()
+    }
+    fn probe_plan(&self, s: bool, p: bool, o: bool, g: GraphMatch) -> Self::ProbePlan {
+        self.dataset.probe_plan(s, p, o, g)
+    }
+    fn quads_for_pattern(
+        &self,
+        s: Option<TermId>,
+        p: Option<TermId>,
+        o: Option<TermId>,
+        g: GraphMatch,
+    ) -> impl Iterator<Item = QuadIds> + '_ {
+        self.dataset
+            .quads_for_pattern(s, p, o, g)
+            .filter(|quad| self.allowed(*quad, SourceCarrier::Statement))
+    }
+    fn quads_for_pattern_with_plan(
+        &self,
+        plan: &Self::ProbePlan,
+        s: Option<TermId>,
+        p: Option<TermId>,
+        o: Option<TermId>,
+        g: GraphMatch,
+    ) -> impl Iterator<Item = QuadIds> + '_ {
+        self.dataset
+            .quads_for_pattern_with_plan(plan, s, p, o, g)
+            .filter(|quad| self.allowed(*quad, SourceCarrier::Statement))
+    }
+    fn term_count(&self) -> u64 {
+        DatasetView::term_count(self.dataset)
+    }
+    fn reifier_quads(&self) -> impl Iterator<Item = QuadIds> + '_ {
+        self.dataset
+            .reifier_quads()
+            .zip(&self.selection.0.index.reifiers)
+            .filter_map(|(quad, &admitted)| admitted.then_some(quad))
+    }
+    fn reifier_quads_of(&self, reifier: TermId) -> impl Iterator<Item = QuadIds> + '_ {
+        self.dataset
+            .reifier_quads_of(reifier)
+            .filter(|quad| self.allowed(*quad, SourceCarrier::Reifier))
+    }
+    fn annotation_quads(&self) -> impl Iterator<Item = QuadIds> + '_ {
+        self.dataset
+            .annotation_quads()
+            .zip(&self.selection.0.index.annotations)
+            .filter_map(|(quad, &admitted)| admitted.then_some(quad))
+    }
+    fn annotations_of_with_graph(
+        &self,
+        reifier: TermId,
+    ) -> impl Iterator<Item = (TermId, TermId, Option<TermId>)> + '_ {
+        self.dataset
+            .annotations_of_with_graph(reifier)
+            .filter(move |&(p, o, g)| {
+                self.allowed(
+                    QuadIds {
+                        s: reifier,
+                        p,
+                        o,
+                        g,
+                    },
+                    SourceCarrier::Annotation,
+                )
+            })
+    }
+}
diff --git crates/logic-compile/src/source_inventory/trace.rs crates/logic-compile/src/source_inventory/trace.rs
new file mode 100644
index 000000000..1cb931dc4
--- /dev/null
+++ crates/logic-compile/src/source_inventory/trace.rs
@@ -0,0 +1,232 @@
+// SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
+// SPDX-License-Identifier: AGPL-3.0-only
+
+//! Versioned compiler trace identity, streamed without copying the source inventory.
+
+use serde::Serialize;
+use serde::ser::SerializeSeq;
+
+use crate::frontend::{
+    AxiomSource, CollectionField, CollectionRole, CompiledTheory, FormulaDisposition,
+    OwnerDisposition, OwnerFamily, SourceCarrier, SourceOwnerRole, SourceStatementBinding,
+};
+use purrdf::RdfDataset;
+
+use super::identity::{node_anchor, quad_anchor, term_anchor};
+
+const COMPILER_SOURCE_TRACE_DOMAIN: purrdf_hash::Domain =
+    purrdf_hash::Domain::new(b"gmeow-compiler-source-trace-v3\0");
+
+#[derive(Serialize)]
+struct TraceV3<'a> {
+    schema_version: u32,
+    axioms: Axioms<'a>,
+    owners: Owners<'a>,
+    formulas: Formulas<'a>,
+    diagnostics: Diagnostics<'a>,
+}
+
+struct Axioms<'a>(&'a CompiledTheory);
+struct Origins<'a> {
+    dataset: &'a RdfDataset,
+    sources: &'a [AxiomSource],
+}
+struct Owners<'a>(&'a CompiledTheory);
+struct Formulas<'a>(&'a CompiledTheory);
+struct Diagnostics<'a>(&'a CompiledTheory);
+
+#[derive(Serialize)]
+enum Origin {
+    Statement {
+        subject: String,
+        predicate: String,
+        object: String,
+    },
+    ClassExpression {
+        source: String,
+    },
+    Collection {
+        constructor: (&'static str, String),
+        role: CollectionRole,
+        field: CollectionField,
+    },
+    RewrittenField {
+        source: (&'static str, String),
+        owner: SourceOwnerRole,
+    },
+    Reification {
+        source: String,
+    },
+    Formula {
+        source: String,
+    },
+}
+
+fn carrier_name(carrier: SourceCarrier) -> &'static str {
+    match carrier {
+        SourceCarrier::Statement => "statement",
+        SourceCarrier::Annotation => "annotation",
+        SourceCarrier::Reifier => "reifier",
+    }
+}
+
+impl Serialize for Origins<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut sequence = serializer.serialize_seq(Some(self.sources.len()))?;
+        for source in self.sources {
+            let origin = match source {
+                AxiomSource::Statement {
+                    subject,
+                    predicate,
+                    object,
+                } => Origin::Statement {
+                    subject: node_anchor(self.dataset, *subject),
+                    predicate: term_anchor(self.dataset, self.dataset.resolve(*predicate)),
+                    object: term_anchor(self.dataset, self.dataset.resolve(*object)),
+                },
+                AxiomSource::ClassExpression(node) => Origin::ClassExpression {
+                    source: node_anchor(self.dataset, *node),
+                },
+                AxiomSource::Collection { source, field } => Origin::Collection {
+                    constructor: (
+                        carrier_name(source.constructor.carrier),
+                        quad_anchor(self.dataset, source.constructor.canonical),
+                    ),
+                    role: source.role,
+                    field: *field,
+                },
+                AxiomSource::RewrittenField { source, owner } => Origin::RewrittenField {
+                    source: (
+                        carrier_name(source.carrier),
+                        quad_anchor(self.dataset, source.canonical),
+                    ),
+                    owner: *owner,
+                },
+                AxiomSource::Reification(node) => Origin::Reification {
+                    source: node_anchor(self.dataset, *node),
+                },
+                AxiomSource::Formula(node) => Origin::Formula {
+                    source: node_anchor(self.dataset, *node),
+                },
+            };
+            sequence.serialize_element(&origin)?;
+        }
+        sequence.end()
+    }
+}
+
+impl Serialize for Axioms<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut sequence = serializer.serialize_seq(Some(self.0.axiom_sources().len()))?;
+        for sources in self.0.axiom_sources() {
+            sequence.serialize_element(&Origins {
+                dataset: self.0.source().dataset(),
+                sources,
+            })?;
+        }
+        sequence.end()
+    }
+}
+
+#[derive(Serialize)]
+struct Owner<'a> {
+    source: String,
+    family: OwnerFamily,
+    route: &'a OwnerDisposition,
+    diagnostics: &'a [usize],
+    record_support: RecordSupport<'a>,
+}
+
+struct RecordSupport<'a> {
+    dataset: &'a RdfDataset,
+    bindings: &'a std::collections::BTreeSet<SourceStatementBinding>,
+}
+
+impl Serialize for RecordSupport<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut sequence = serializer.serialize_seq(Some(self.bindings.len()))?;
+        for binding in self.bindings {
+            let carrier = carrier_name(binding.carrier);
+            sequence.serialize_element(&(carrier, quad_anchor(self.dataset, binding.canonical)))?;
+        }
+        sequence.end()
+    }
+}
+
+impl Serialize for Owners<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut sequence = serializer.serialize_seq(Some(self.0.owner_lowerings().len()))?;
+        for owner in self.0.owner_lowerings() {
+            sequence.serialize_element(&Owner {
+                source: node_anchor(self.0.source().dataset(), owner.source),
+                family: owner.family,
+                route: &owner.disposition,
+                diagnostics: &owner.diagnostics,
+                record_support: RecordSupport {
+                    dataset: self.0.source().dataset(),
+                    bindings: &owner.record_support,
+                },
+            })?;
+        }
+        sequence.end()
+    }
+}
+
+#[derive(Serialize)]
+struct Formula<'a> {
+    source: String,
+    route: &'a FormulaDisposition,
+}
+
+impl Serialize for Formulas<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut sequence = serializer.serialize_seq(Some(self.0.formula_lowerings().len()))?;
+        for formula in self.0.formula_lowerings() {
+            sequence.serialize_element(&Formula {
+                source: node_anchor(self.0.source().dataset(), formula.source),
+                route: &formula.disposition,
+            })?;
+        }
+        sequence.end()
+    }
+}
+
+#[derive(Serialize)]
+struct Diagnostic<'a> {
+    severity: &'a str,
+    code: &'a str,
+    message: &'a str,
+    subject: &'a Option<String>,
+}
+
+impl Serialize for Diagnostics<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut sequence = serializer.serialize_seq(Some(self.0.diagnostics().len()))?;
+        for diagnostic in self.0.diagnostics() {
+            sequence.serialize_element(&Diagnostic {
+                severity: diagnostic.severity.as_str(),
+                code: &diagnostic.code,
+                message: &diagnostic.message,
+                subject: &diagnostic.subject,
+            })?;
+        }
+        sequence.end()
+    }
+}
+
+pub(super) fn digest(theory: &CompiledTheory) -> String {
+    let mut hasher = purrdf_hash::blake3::Hasher::new();
+    hasher.update(COMPILER_SOURCE_TRACE_DOMAIN.as_bytes());
+    serde_json::to_writer(
+        &mut hasher,
+        &TraceV3 {
+            schema_version: 3,
+            axioms: Axioms(theory),
+            owners: Owners(theory),
+            formulas: Formulas(theory),
+            diagnostics: Diagnostics(theory),
+        },
+    )
+    .expect("typed compiler traces serialize to an infallible digest sink");
+    purrdf_hash::hex::encode(hasher.finalize().as_bytes())
+}
