    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "DCTerms bibliographicCitation — a bibliographic reference for a creative work"
|} .

gmeow:extent skos:closeMatch dcterms:extent {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "DCTerms extent — the size or duration of a creative work"
|} .

