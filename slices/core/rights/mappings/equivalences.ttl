|} .

# --- dcterms / PREMIS / RightsStatements.org --- #

gmeow:License skos:closeMatch dcterms:LicenseDocument {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
