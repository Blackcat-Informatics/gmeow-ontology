@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/cc> a align:Alignment ;
    rdfs:label "GMEOW → cc (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "attributionText → cc:attributionName"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:attributionText ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri cc:attributionName ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "attributionUrl → cc:attributionURL"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:attributionUrl ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri cc:attributionURL ] ;
            align:relation "=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "hasLicense → cc:license"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasLicense ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri cc:license ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ],
        [ a align:Cell ;
            rdfs:label "License → cc:License"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:License ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri cc:License ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "cc" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
