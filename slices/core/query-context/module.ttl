gmeow:restrictionComponentsComplete
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-context> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "restriction components complete"@x-gmeow-english ;
    skos:definition "An explicit source assertion that the recorded typed atom inventory of a QueryRestrictionFrame is complete for its declared syntax. A true value selects a complete finite inventory for the IRI-key profile; it does not certify a hash or semantic realization."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish a deliberately complete inventory, including an explicitly empty one, from partial or missing descriptions."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid defaulting this flag from absent atoms or equating inventory completeness with interpretation completeness."@x-gmeow-english ;
    gmeow:howToUse "Retain the supplied boolean. Canonical naming requires one explicit true value and the complete profile inputs; missing or conflicting declarations refuse that naming operation."@x-gmeow-english ;
    skos:scopeNote "The flag is at most single-valued on one syntax description. It neither fetches missing descriptions nor verifies a canonical name or an interpretation."@x-gmeow-english ;
    skos:example "A supplied inventory assertion: ex:frame gmeow:restrictionComponentsComplete true ."@x-gmeow-english ;
    logic:domain gmeow:QueryRestrictionFrame ; logic:range xsd:boolean .

gmeow:QueryFrameMeetExtent
    a logic:SubKind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Frame Meet Extent"@x-gmeow-english ;
    skos:definition "An interpretation-scoped result-extent descriptor for the intersection of an explicitly complete finite set of operand extents. Operand syntax may mix explicit standpoint and scenario restriction roles; their admitted contexts are intersected in one declared interpretation."@x-gmeow-english ;
    gmeow:useWhen "Use for an n-ary mixed restriction meet while retaining the requested syntax separately from semantic realization and usable-frame exposure."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inheriting binary left/right requirements, replacing universal-truth union with a meet or treating a descriptor as evidence of a realized nonempty result."@x-gmeow-english ;
    gmeow:howToUse "Use inherited extentInterpretation, extentFrame and extentMember; retain meetOperand entries and explicit inventory and realization assertions."@x-gmeow-english ;
    skos:scopeNote "Zero operands yield the unrestricted actual frame over the declared nonempty domain. One operand preserves its extent; an empty result remains incompatible and supplies no usable frame."@x-gmeow-english ;
    skos:example "A supplied meet extent: ex:meet a gmeow:QueryFrameMeetExtent ; gmeow:meetOperand ex:leftExtent, ex:rightExtent ."@x-gmeow-english ;
    logic:subClassOf gmeow:QueryFrameExtent .

gmeow:meetOperand
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-context> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "meet operand"@x-gmeow-english ;
    skos:definition "One supplied operand extent of a QueryFrameMeetExtent. Operands share the result extent’s interpretation and, under an explicit complete inventory, each selects one complete typed restriction-syntax identity."@x-gmeow-english ;
    gmeow:useWhen "Use to retain any finite number of supplied operand extents without ordered binary slots."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid combining interpretations, inventing operand membership or choosing a native kind from a raw scenario alias."@x-gmeow-english ;
    gmeow:howToUse "Reference operand QueryFrameExtent records with their own interpretation, admitted members and explicitly complete QueryRestrictionFrame descriptions."@x-gmeow-english ;
    skos:scopeNote "The operand relation is unordered and nonfunctional. Zero operands require an explicit complete inventory; absence alone does not describe the actual frame."@x-gmeow-english ;
    skos:example "Two supplied operands: ex:meet gmeow:meetOperand ex:standpointExtent, ex:scenarioExtent ."@x-gmeow-english ;
    logic:domain gmeow:QueryFrameMeetExtent ; logic:range gmeow:QueryFrameExtent .

gmeow:meetOperandsComplete
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-context> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "meet operands complete"@x-gmeow-english ;
    skos:definition "An explicit source assertion that the recorded meetOperand set is the complete finite operand inventory for this meet extent. It is distinct from syntax-component completeness and interpretation completeness."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly closes the operand inventory, including a deliberate zero-operand meet."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading an absent operand relation or flag as a complete empty inventory."@x-gmeow-english ;
    gmeow:howToUse "Retain the supplied boolean and all operand records. Realization requires an explicit true value together with complete operand syntax descriptions."@x-gmeow-english ;
    skos:scopeNote "The flag is at most single-valued on this extent record and supplies no missing operands, interpretation members or realization."@x-gmeow-english ;
    skos:example "An explicit operand inventory: ex:meet gmeow:meetOperandsComplete true ."@x-gmeow-english ;
    logic:domain gmeow:QueryFrameMeetExtent ; logic:range xsd:boolean .

gmeow:meetRealized
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-context> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "meet realized"@x-gmeow-english ;
    skos:definition "An explicit source assertion that this meet extent realizes its named restriction syntax in a declared complete interpretation with a complete operand inventory. It is not a runtime verification certificate."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish a supplied semantic realization claim from a partial request or syntax description."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring realization from a canonical syntax name, an existing descriptor or missing result members."@x-gmeow-english ;
    gmeow:howToUse "Retain the supplied boolean; a true claim requires the interpretation and complete inventories and is subject to both exact intersection directions."@x-gmeow-english ;
    skos:scopeNote "The flag is at most single-valued on this extent record. Realization can retain an empty result without exposing a usable frame."@x-gmeow-english ;
    skos:example "A source realization assertion: ex:meet gmeow:meetRealized true ."@x-gmeow-english ;
    logic:domain gmeow:QueryFrameMeetExtent ; logic:range xsd:boolean .

gmeow:meetUsableFrame
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-context> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "usable meet frame"@x-gmeow-english ;
    skos:definition "The explicitly supplied complete restriction-syntax frame represented by a realized nonempty meet extent in its declared complete interpretation. It must be the same frame identified by that extent’s extentFrame."@x-gmeow-english ;
    gmeow:useWhen "Use to expose a supplied usable result only with complete inventories, realization and a result member."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid exposing an empty, partial or unrealized result, inventing an admitted context or substituting a different frame."@x-gmeow-english ;
    gmeow:howToUse "Reference the existing complete syntax frame and retain the exact interpretation, realization claim, complete operand inventory and nonempty extent evidence."@x-gmeow-english ;
    skos:scopeNote "This relation certifies no global semantic existence, proposition truth, privileged observer or native hash computation."@x-gmeow-english ;
    skos:example "A supplied usable result: ex:meet gmeow:meetUsableFrame ex:combinedFrame ."@x-gmeow-english ;
    logic:domain gmeow:QueryFrameMeetExtent ; logic:range gmeow:QueryRestrictionFrame .

gmeow:RestrictionAtomIriConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "restriction atom IRI constraint"@x-gmeow-english ;
    skos:definition "A complete restriction-syntax inventory uses IRI targets for each explicit atom role in the IRI-key profile."@x-gmeow-english ;
    gmeow:useWhen "Use to reject a non-IRI atom target in a declared complete profile inventory."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid coercing blank nodes, literals or triple terms into resource identifiers."@x-gmeow-english ;
    gmeow:howToUse "Check each recorded target under the five explicit atom roles with the native RDF term-kind predicate."@x-gmeow-english ;
    skos:scopeNote "This structural obligation does not resolve relative source syntax, derive component keys or verify a frame name."@x-gmeow-english ;
    skos:example "A profile obligation: gmeow:RestrictionAtomIriConstraint logic:formalizes gmeow:QueryRestrictionFrame ."@x-gmeow-english ;
    logic:formalizes gmeow:QueryRestrictionFrame ;
    logic:message "A complete restriction-syntax inventory uses IRI targets for each explicit atom role in the IRI-key profile." ;
    logic:integrity [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "role" ], [ logic:termIndex 2 ; logic:termVariable "atom" ] ;
logic:forall [ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
