gmeow:eqLangHypernymyWordnet a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:hypernymy ; gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wn:hypernym ;
    logic:sourceEndpoint lang:hypernymy ; logic:targetEndpoint wn:hypernym ;
    gmeow:justification semapv:ManualMappingCuration ; gmeow:confidence 0.8 ;
    gmeow:sssomFile "gmeow-lang-wordnet-schema.sssom.tsv" ;
    gmeow:comment "The WordNet schema term is a synset-relation kind while lang:hypernymy belongs to the broader native sense-relation inventory." ;
