#
# OntoUML metamodel model — the RelComp (relator-completeness) anti-pattern
# (documented in the OntoUML anti-pattern catalogue at
# https://ontouml.readthedocs.io/en/latest/anti-patterns/), serialized in the
# REAL FAIR-catalog "shape (a)" form: the mediation carries `ontouml:relationEnd`
# Property nodes, each with an `ontouml:cardinality` → `ontouml:Cardinality` →
# `ontouml:upperBound`. The sibling `rel-comp` case pins the same anti-pattern via
# the self-authored `ontouml:functionalMediation` convenience flag; this case
# proves the native reader derives functionality from the vocabulary's own
# cardinality, so RelComp fires on the serialization the live catalog actually
# emits (see https://dev.ontouml.org/ontouml-vocabulary/ontouml.ttl).
#
# A concrete relator must mediate at least two distinct entities. ex:Marriage is a
# relator whose single mediated end (to ex:Spouse) has upper bound 1, so it reaches
# only one relatum and violates the discipline. ex:Spouse specializes the kind
# ex:Person, so the role is well-founded and only the relator fires. The documented
# verdict is RelComp.

@prefix ontouml: <https://w3id.org/ontouml#> .
@prefix ex:      <https://gmeow.example/ontouml-mini/rel-comp-shape-a/> .

ex:Person   a ontouml:Class ; ontouml:stereotype ontouml:kind .
ex:Spouse   a ontouml:Class ; ontouml:stereotype ontouml:role .
ex:Marriage a ontouml:Class ; ontouml:stereotype ontouml:relator .

ex:g1 a ontouml:Generalization ;
    ontouml:general  ex:Person ;
    ontouml:specific ex:Spouse .

ex:med a ontouml:Relation ;
    ontouml:stereotype  ontouml:mediation ;
    ontouml:relationEnd ex:pRelator , ex:pMediated .

# The relator end (Marriage side); its own multiplicity is unbounded.
ex:pRelator a ontouml:Property ;
    ontouml:propertyType ex:Marriage ;
    ontouml:cardinality  ex:cRelator .
ex:cRelator a ontouml:Cardinality ;
    ontouml:lowerBound "1" ;
    ontouml:upperBound "*" .

# The mediated end (Spouse side) is functional: upper bound 1 → the relator reaches
# a single relatum, exactly the RelComp shape.
ex:pMediated a ontouml:Property ;
    ontouml:propertyType ex:Spouse ;
    ontouml:cardinality  ex:cMediated .
ex:cMediated a ontouml:Cardinality ;
    ontouml:lowerBound "1" ;
    ontouml:upperBound "1" .
