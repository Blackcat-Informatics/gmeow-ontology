gmeow:eqWikidata043 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:TelephoneNumber ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q214291 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "telephone number" ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqWikidata044 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:EmailAddress ;
