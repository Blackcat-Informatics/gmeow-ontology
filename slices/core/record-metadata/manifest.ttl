@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/record-metadata>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/record-metadata> ;
    gmeow:sliceTier gmeow:tierCore ;
    rdfs:label "record metadata"@x-gmeow-english ;
    skos:definition "Generic recording and modification time, local sequence order, run-time labelled content and digest-identified creation-context artifacts."@x-gmeow-english ;
    dcterms:title "GMEOW Record Metadata Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Record stores, structured-content importers and context-exposure audits that need domain-independent metadata without inventing predicates from run-time keys."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceDependsOn <https://blackcatinformatics.ca/gmeow/slices/logic>,
        <https://blackcatinformatics.ca/gmeow/slices/kernel>,
        <https://blackcatinformatics.ca/gmeow/slices/temporal>,
        <https://blackcatinformatics.ca/gmeow/slices/concepts>,
        <https://blackcatinformatics.ca/gmeow/slices/sources>,
        <https://blackcatinformatics.ca/gmeow/slices/notes>,
        <https://blackcatinformatics.ca/gmeow/slices/documents> .
