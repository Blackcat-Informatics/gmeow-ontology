@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences for the wikidata domain — GMEOW authoring source.
# Compiled to mappings/gmeow-wikidata.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetWikidata a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/wikidata" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "GMEOW term to Wikidata Q-item alignments (concept-scheme layer; QIDs validated)." .

gmeow:eqWikidata001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Person ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q5 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:objectLabel "human" ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqWikidata002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Organization ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q43229 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "organization" ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqWikidata003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Place ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q2221906 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "geographic location" ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqWikidata004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SoftwareProject ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q7397 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "software" ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqWikidata005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Family ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q8436 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "family" ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

# --------------------------------------------------------------------------- #
# Rights / IP / trademark / licensing (#21). QIDs/PIDs curl-validated against
# the live Wikidata API. Reified GMEOW relators (Copyright/Trademark/License)
# closeMatch the Wikidata legal-concept items; the GMEOW properties relatedMatch
# the corresponding Wikidata properties (which are direct-claim predicates, not
# reified relations) — see docs/rights-mapping.md.
# --------------------------------------------------------------------------- #

gmeow:eqWikidata006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Copyright ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q1297822 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "copyright" ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

