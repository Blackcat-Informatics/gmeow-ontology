@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix fibo-fbc-fi-fi: <https://spec.edmcouncil.org/fibo/ontology/FBC/FinancialInstruments/FinancialInstruments/> .
@prefix fibo-fnd-acc-ae: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/AccountingEquity/> .
@prefix fibo-fnd-pas-ps: <https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/> .
@prefix schema: <https://schema.org/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:FinancialTransaction skos:closeMatch fibo-fnd-pas-ps:TransactionEvent {|
    gmeow:sssomFile "gmeow-fibo.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "a financial transaction event; canonical FIBO defining module is FND ProductsAndServices, not FBC FinancialProductsAndServices"
|} .

gmeow:LedgerAccount skos:closeMatch fibo-fnd-acc-ae:Account {|
    gmeow:sssomFile "gmeow-fibo.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "a book-keeping account; GMEOW distinguishes LedgerAccount from FinancialAccount"
|} .

gmeow:Posting skos:closeMatch fibo-fnd-acc-ae:BookEntry {|
    gmeow:sssomFile "gmeow-fibo.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "an accounting entry / posting in double-entry bookkeeping"
|} .

gmeow:Asset skos:closeMatch fibo-fbc-fi-fi:FinancialInstrument {|
    gmeow:sssomFile "gmeow-fibo.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "a financial asset / instrument; GMEOW Asset is broader (includes real estate)"
|} .

gmeow:Holding skos:closeMatch fibo-fbc-fi-fi:Holding {|
    gmeow:sssomFile "gmeow-fibo.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "a holding of a financial asset by an agent"
|} .

gmeow:FinancialAccount skos:closeMatch schema:BankAccount {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "a bank account; GMEOW FinancialAccount is broader (also credit, investment, wallet)"
|} .

gmeow:FinancialAccount skos:relatedMatch schema:DepositAccount {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "a deposit account is a kind of bank account"
|} .

gmeow:iban skos:exactMatch schema:iban {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "International Bank Account Number"
|} .

gmeow:accountBalance skos:closeMatch schema:accountBalance {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the balance of a bank account"
|} .

gmeow:FinancialTransaction skos:closeMatch schema:MoneyTransfer {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "a money transfer; GMEOW FinancialTransaction is broader (also fees, interest, refunds)"
|} .

gmeow:Payment skos:closeMatch schema:Payment {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a payment action; GMEOW Payment is a thin subclass of FinancialTransaction"
|} .

gmeow:Invoice skos:closeMatch schema:Invoice {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "a billing document"
|} .

gmeow:Order skos:closeMatch schema:Order {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a purchase or sales order; GMEOW Order is a subclass of Agreement"
|} .

gmeow:CryptoWallet skos:closeMatch schema:BankAccount {|
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "schema.org has no crypto-specific account term; BankAccount is the closest match. Projection loses crypto-specific semantics: wallet address, blockchain/network scheme, custody/private-key properties, and transaction provenance."
|} .
