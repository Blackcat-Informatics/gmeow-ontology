nionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:adviceUseWhen (logic:range|rdfs:range) rdfs:Literal . gmeow:AdviceEntry (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:adviceUseWhen ; (logic:allValuesFrom|owl:allValuesFrom) ?values5_0 ] . ?values5_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:adviceHowToUse (logic:range|rdfs:range) rdfs:Literal . gmeow:AdviceEntry (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:adviceHowToUse ; (logic:allValuesFrom|owl:allValuesFrom) ?values6_0 ] . ?values6_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:findingHowToUse (logic:range|rdfs:range) rdfs:Literal . gmeow:Finding (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:findingHowToUse ; (logic:allValuesFrom|owl:allValuesFrom) ?values7_0 ] . ?values7_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:findingUseWhen (logic:range|rdfs:range) rdfs:Literal . gmeow:Finding (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:findingUseWhen ; (logic:allValuesFrom|owl:allValuesFrom) ?values8_0 ] . ?values8_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . gmeow:findingAvoidWhen (logic:range|rdfs:range) rdfs:Literal . gmeow:Finding (logic:subClassOf|rdfs:subClassOf) [ (logic:onProperty|owl:onProperty) gmeow:findingAvoidWhen ; (logic:allValuesFrom|owl:allValuesFrom) ?values9_0 ] . ?values9_0 (logic:unionOf|owl:unionOf)/rdf:rest*/rdf:first xsd:string, rdf:langString, rdf:dirLangString . }" ;
