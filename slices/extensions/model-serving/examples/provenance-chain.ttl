#
# CQ6 fixture — the de-conflation chain resolves end to end, each hop named
# (INHABITED-RUNTIME-STACK.md). An output was generated by an invocation, which
# ran in an execution, of a deployment, of a served artifact; the same invocation
# is a sub-event of a session. Tracing ex:output back yields the exact
# artifact·deployment·execution·session·invocation that produced it. This is the
# STANDALONE-resolvable prefix: the session → durable-subject terminus
# (gmeow:sessionSubjectStage → an inhabitation gmeow:SubjectStage) is exercised in
# the agent-runtime profile corpus, where core/inhabitation is present.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/model-serving/> .

ex:opusArtifact a gmeow:ModelArtifact .
ex:opusDeployment a gmeow:ModelDeployment ;
    gmeow:deploymentArtifact ex:opusArtifact .
ex:execution1 a gmeow:RuntimeExecution ;
    gmeow:executionOfDeployment ex:opusDeployment .
ex:session1 a gmeow:AgentSession .

ex:invocation1 a gmeow:ModelInvocation ;
    gmeow:invocationInExecution ex:execution1 ;
    gmeow:subEventOf ex:session1 .

ex:output a gmeow:InformationObject ;
    gmeow:wasGeneratedBy ex:invocation1 .
