    skos:example "ex:set gmeow:pronounObject \"them\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid leaving the object (accusative) form blank while filling the other four forms on a specifying set, and avoid supplying it on a non-specifying stance (any / ask / name-only)."@x-gmeow-english ;
