    gmeow:confidence 1.0 ;
    gmeow:objectLabel "noun" ;
    gmeow:comment "lang:noun is the noun part of speech; wd:Q1084 (noun) is the same category. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqLangVerb a gmeow:TermEquivalence ;
    gmeow:alignSubject lang:verb ;
    gmeow:alignPredicate skos:exactMatch ;
