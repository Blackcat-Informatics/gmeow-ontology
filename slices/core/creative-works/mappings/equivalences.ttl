@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix bibframe: <http://id.loc.gov/ontologies/bibframe/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Creative-works WEMI spine alignments.
# Compiled to mappings/gmeow-creative-works.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetCreativeWorks a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/creative-works" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "WEMI spine alignments to FRBRcore, FaBiO, LRMoo, CIDOC-CRM, BIBFRAME, schema.org, and Wikidata. GMEOW rebuilds the distinction natively and bridges by reference (Principle 5)." .

# --------------------------------------------------------------------------- #
# FRBRcore — the canonical WEMI vocabulary
# --------------------------------------------------------------------------- #

gmeow:Work owl:equivalentClass frbr:Work {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "FRBR Work — abstract intellectual creation."
|} .

gmeow:Expression owl:equivalentClass frbr:Expression {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "FRBR Expression — realization in language/notation."
|} .

gmeow:Manifestation owl:equivalentClass frbr:Manifestation {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "FRBR Manifestation — edition/format/release."
|} .

gmeow:Item owl:equivalentClass frbr:Item {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "FRBR Item — single exemplar."
|} .

gmeow:realizes owl:equivalentProperty frbr:realization {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "Expression realizes Work."
|} .

gmeow:embodies owl:equivalentProperty frbr:embodiment {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "Manifestation embodies Expression."
|} .

gmeow:exemplifies owl:equivalentProperty frbr:exemplar {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "Item exemplifies Manifestation."
|} .

# --------------------------------------------------------------------------- #
# FaBiO — SPAR ontologies for scholarly works
# --------------------------------------------------------------------------- #

gmeow:Work skos:closeMatch fabio:Work {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "FaBiO Work is scholarly-publication-scoped; GMEOW Work is universal."
|} .

gmeow:Expression skos:closeMatch fabio:Expression {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "FaBiO Expression is scholarly-scoped."
|} .

gmeow:Manifestation skos:closeMatch fabio:Manifestation {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "FaBiO Manifestation is scholarly-scoped."
|} .

gmeow:Item skos:closeMatch fabio:Item {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "FaBiO Item is scholarly-scoped."
|} .

# --------------------------------------------------------------------------- #
# LRMoo — object-oriented LRM (ex-FRBRoo)
# --------------------------------------------------------------------------- #

gmeow:Work owl:equivalentClass lrmoo:F1_Work {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "LRMoo F1 Work — aligned by reference, not axiom import."
|} .

gmeow:Expression owl:equivalentClass lrmoo:F2_Expression {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "LRMoo F2 Expression."
|} .

gmeow:Manifestation owl:equivalentClass lrmoo:F3_Manifestation {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "LRMoo F3 Manifestation."
|} .

gmeow:Item owl:equivalentClass lrmoo:F5_Item {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "LRMoo F5 Item."
|} .

gmeow:eventTypeWorkConception skos:closeMatch lrmoo:F27_Work_Conception {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "LRMoo F27 Work Conception ≈ GMEOW event type value."
|} .

gmeow:eventTypeExpressionCreation skos:closeMatch lrmoo:F28_Expression_Creation {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "LRMoo F28 Expression Creation ≈ GMEOW event type value."
|} .

# --------------------------------------------------------------------------- #
# CIDOC-CRM — creation events
# --------------------------------------------------------------------------- #

gmeow:eventTypeWorkConception skos:broadMatch crm:E65_Creation {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "CIDOC E65 Creation is broader than work conception."
|} .

# --------------------------------------------------------------------------- #
# BIBFRAME 2.0 — Library of Congress
# --------------------------------------------------------------------------- #

gmeow:Work skos:closeMatch bibframe:Work {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Lossy: BIBFRAME conflates Work+Expression by design."
|} .

gmeow:Manifestation skos:closeMatch bibframe:Instance {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "BIBFRAME Instance ≈ FRBR Manifestation."
|} .

gmeow:Item skos:closeMatch bibframe:Item {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "BIBFRAME Item ≈ FRBR Item."
|} .

# --------------------------------------------------------------------------- #
# schema.org — lossy projection layer
# --------------------------------------------------------------------------- #

gmeow:CreativeWork skos:exactMatch schema:CreativeWork {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "co-extensive at the top creative-work class; schema.org flattening the WEMI sub-structure is a preservation loss, not an extension difference — the WEMI tiers (gmeow:Work etc.) map separately by closeMatch"
|} .

gmeow:Work skos:closeMatch schema:CreativeWork {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Lossy: schema.org has no Work/Expression distinction."
|} .

gmeow:BookRelease skos:broadMatch schema:Book {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema:Book is broader (may denote abstract work); BookRelease is concrete."
|} .

gmeow:MediaObject skos:exactMatch schema:MediaObject {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "direct 1:1 correspondence; schema:ImageObject/AudioObject map in as narrower subclasses"
|} .

gmeow:WebPage owl:equivalentClass schema:WebPage {|
    gmeow:sssomFile "gmeow-creative-works.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "Direct correspondence."
|} .

