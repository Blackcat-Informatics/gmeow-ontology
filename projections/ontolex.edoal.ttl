@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://blackcatinformatics.ca/gmeow/projections/ontolex> a align:Alignment ;
    rdfs:label "GMEOW → ontolex (EDOAL)"@x-gmeow-english ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "LexicalForm → ontolex:Form"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:LexicalForm ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri ontolex:Form ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "LexicalItem → ontolex:LexicalEntry lexicalForm link (displayable forms only)"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasLexicalForm ] ;
            align:entity2 [ a edoal:Relation ;
                    edoal:uri ontolex:lexicalForm ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "LexicalItem → ontolex:LexicalEntry"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:LexicalItem ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri ontolex:LexicalEntry ] ;
            align:relation "<=" ],
        [ a align:Cell ;
            rdfs:label "displayable Appellation → ontolex:LexicalEntry + Form + writtenRep"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:fullName ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri ontolex:LexicalEntry ] ;
            align:relation "<=" ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "ontolex" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@x-gmeow-english .
