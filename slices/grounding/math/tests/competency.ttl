# === Q10 — which ring op / hardness / noise for an HE scheme (flagship 2) === #

ex:cqHeSchemeFrame a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/he-scheme-frame.rq" ;
    gmeow:cqDataFile "tests/fixtures/algebra.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A homomorphic-encryption scheme reports the operation it is homomorphic over, its hardness assumption, and its noise model; over the fixture the answer is exactly {heScheme → ringMultiplication / RLWE / gaussianNoise}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqHeFrameShape ;
    gmeow:cqExpectRow ex:rowHeFrame .

ex:cqHeFrameShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "scheme" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "operation" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "assumption" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "noise" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHeFrame a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "scheme" ; gmeow:cellValueIri exf:heScheme ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "operation" ; gmeow:cellValueIri exf:ringMultiplication ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "assumption" ; gmeow:cellValueIri math:ringLearningWithErrors ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "noise" ; gmeow:cellValueIri exf:gaussianNoise ] .

# === Q11 — which structures are isomorphic ================================= #

