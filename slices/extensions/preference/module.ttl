# --- G2: a sharper standpoint's order restricts, never contradicts ----------- #
gmeow:RestrictionCoherenceConstraint
    a logic:Constraint ;
    rdfs:label "Restriction coherence constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (G2): when one gmeow:PreferenceProjection cell (this, the sharper) sharpens another (gmeow:vantage related by gmeow:sharpens), the sharper cell's order must RESTRICT, not CONTRADICT, the coarser one — the sharper cell's gmeow:PreferenceOrder may not carry a gmeow:PreferenceEdge (gmeow:edgeWinner b, gmeow:edgeLoser a) where the coarser cell's order carries an edge (gmeow:edgeWinner a, gmeow:edgeLoser b) UNLESS a gmeow:DisagreementObstruction is present to carry the disagreement. Like G3 it rides the cell-attributed reified gmeow:PreferenceEdge (each edge reached through its own cell's gmeow:projectionOrder gmeow:orderEdge), never the uncell-scopeable bare gmeow:preferredOver, so the sharper and coarser edges are genuinely tied to their respective cells. A ∀→¬∃ formula testing a sharpens-linked contradicting pair with no recorded obstruction, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:PreferenceProjection ;
    logic:severity "Violation" ;
    logic:message "A gmeow:PreferenceProjection that sharpens another must restrict, not contradict, its order: a reversed reified gmeow:PreferenceEdge pair along gmeow:sharpens (the sharper cell's order prefers b≻a where the coarser prefers a≻b) with no gmeow:DisagreementObstruction is incoherent refinement." ;
    logic:integrity gmeow:rccForall .
gmeow:rccForall a logic:Formula ;
    rdfs:label "rccForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): binds ?this and requires ?this is a gmeow:PreferenceProjection → ¬[gmeow:rccBad]."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:rccImpl .
gmeow:rccImpl a logic:Formula ;
    rdfs:label "rccImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): when ?this is a gmeow:PreferenceProjection holds, requires ¬[∃?other,?vs,?vc,?a,?b,?os,?es,?oc,?ec. gmeow:rccBadBody]."@x-gmeow-english ; logic:antecedent gmeow:rccGuard ; logic:consequent gmeow:rccNoContra .
gmeow:rccGuard a logic:Formula ;
    rdfs:label "rccGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): asserts ?this is a gmeow:PreferenceProjection."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:PreferenceProjection ] .
gmeow:rccNoContra a logic:Formula ;
    rdfs:label "rccNoContra (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The negation within gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): holds only when it is NOT the case that ∃?other,?vs,?vc,?a,?b,?os,?es,?oc,?ec. gmeow:vantage(?this, ?vs) ∧ gmeow:vantage(?other, ?vc) ∧ gmeow:sharpens(?vs, ?vc) ∧ gmeow:projectionOrder(?this, ?os) ∧ gmeow:orderEdge(?os, ?es) ∧ gmeow:edgeWinner(?es, ?b) ∧ gmeow:edgeLoser(?es, ?a) ∧ gmeow:projectionOrder(?other, ?oc) ∧ gmeow:orderEdge(?oc, ?ec) ∧ gmeow:edgeWinner(?ec, ?a) ∧ gmeow:edgeLoser(?ec, ?b) ∧ gmeow:rccNoObstruction."@x-gmeow-english ; logic:not gmeow:rccBad .
gmeow:rccBad a logic:Formula ;
    rdfs:label "rccBad (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): quantifies ?other, ?vs, ?vc, ?a, ?b, ?os, ?es, ?oc, ?ec and requires gmeow:vantage(?this, ?vs) ∧ gmeow:vantage(?other, ?vc) ∧ gmeow:sharpens(?vs, ?vc) ∧ gmeow:projectionOrder(?this, ?os) ∧ gmeow:orderEdge(?os, ?es) ∧ gmeow:edgeWinner(?es, ?b) ∧ gmeow:edgeLoser(?es, ?a) ∧ gmeow:projectionOrder(?other, ?oc) ∧ gmeow:orderEdge(?oc, ?ec) ∧ gmeow:edgeWinner(?ec, ?a) ∧ gmeow:edgeLoser(?ec, ?b) ∧ ¬[gmeow:rccObstrEx]."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "vs" ] , [ logic:termIndex 2 ; logic:termVariable "vc" ] , [ logic:termIndex 3 ; logic:termVariable "a" ] , [ logic:termIndex 4 ; logic:termVariable "b" ] , [ logic:termIndex 5 ; logic:termVariable "os" ] , [ logic:termIndex 6 ; logic:termVariable "es" ] , [ logic:termIndex 7 ; logic:termVariable "oc" ] , [ logic:termIndex 8 ; logic:termVariable "ec" ] ;
    logic:exists gmeow:rccBadBody .
# Cell-scoped like G3: the sharper edge es hangs under THIS cell's order os, the coarser
# edge ec under the OTHER cell's order oc, and the two cells' vantages are sharpens-linked.
gmeow:rccBadBody a logic:Formula ;
    rdfs:label "rccBadBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): conjoins gmeow:vantage(?this, ?vs) ∧ gmeow:vantage(?other, ?vc) ∧ gmeow:sharpens(?vs, ?vc) ∧ gmeow:projectionOrder(?this, ?os) ∧ gmeow:orderEdge(?os, ?es) ∧ gmeow:edgeWinner(?es, ?b) ∧ gmeow:edgeLoser(?es, ?a) ∧ gmeow:projectionOrder(?other, ?oc) ∧ gmeow:orderEdge(?oc, ?ec) ∧ gmeow:edgeWinner(?ec, ?a) ∧ gmeow:edgeLoser(?ec, ?b) ∧ ¬[gmeow:rccObstrEx]."@x-gmeow-english ;
    logic:and gmeow:rccSharpVantage , gmeow:rccCoarseVantage , gmeow:rccSharpens , gmeow:rccSharpOrder , gmeow:rccSharpEdgeNode , gmeow:rccSharpWin , gmeow:rccSharpLose , gmeow:rccCoarseOrder , gmeow:rccCoarseEdgeNode , gmeow:rccCoarseWin , gmeow:rccCoarseLose , gmeow:rccNoObstruction .
gmeow:rccSharpVantage a logic:Formula ;
    rdfs:label "rccSharpVantage (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:vantage atom of gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): relates ?this, ?vs."@x-gmeow-english ; logic:relation gmeow:vantage ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "vs" ] .
