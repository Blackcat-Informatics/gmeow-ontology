    [ a owl:Restriction ; owl:onProperty math:guardedByCounterExample ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty math:enforcesFailureClass ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

# =========================================================================== #
# Procedural constraints — projected to sh:SPARQLConstraint (the validation    #
# twin of the derivation surface). Each is a compact logic: constraint-sugar   #
# record carrying logic:formalizes, expanded by the frontend to a canonical    #
# logic:Constraint and lowered to a sh:SPARQLConstraint.                       #
# =========================================================================== #

# math:Norm — the inducing symmetric bilinear form must be positive-definite:
# ‖x‖ = √⟨x, x⟩ is a genuine norm only for a positive-definite form. A
# path-value fixed-value check: every value reached by math:inducedByForm must
# carry math:definiteness math:positiveDefinite.
math:NormPositiveDefiniteConstraint
    a logic:PathValueTypeConstraint ;
    logic:onClass math:Norm ;
    logic:valuePath math:inducedByForm ;
    logic:valuePredicate math:definiteness ;
    logic:valueObject math:positiveDefinite ;
    logic:formalizes math:Norm ;
    logic:message "A math:Norm's math:inducedByForm must be positive-definite (math:definiteness math:positiveDefinite); a norm resting on a non-positive-definite form is ill-formed (math:NonPositiveDefiniteNorm)." .

# math:LogicLoweringShape — any expression lowered to a logic:Formula through
# math:compilesToLogicFormula must declare its math:denotationKind and its
# math:logicLoweringPreservation; silent promotion is forbidden. A
# predicate-presence guarded implication (no target class — the trigger
# predicate is the range restriction, so the shape targets subjects of
# math:compilesToLogicFormula).
math:LogicLoweringDeclaredConstraint
    a logic:GuardedImplicationConstraint ;
    logic:trigger math:compilesToLogicFormula ;
    logic:requires math:denotationKind , math:logicLoweringPreservation ;
    logic:formalizes math:LogicLoweringShape ;
    logic:message "An expression lowered to a logic:Formula through math:compilesToLogicFormula must declare its math:denotationKind and its math:logicLoweringPreservation; silent promotion to a logical assertion is forbidden (math:UndeclaredLogicLowering)." .

