<https://blackcatinformatics.ca/gmeow/slices/affect>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Emotions and appraisals — a CORE slice: an agent's felt mental life is part of the Principle 14 grounded-agent-memory flagship.

DOCTRINE.
  * CORE AND COMPREHENSIVE: affect is core because affective memory is load-bearing for grounded agent memory (P14); GMEOW core is comprehensive by design, not a minimal kernel. This module is the kernel baseline of the affect model — the fuller high-dimensional landscape, the affective-experience and evidence layers, and the external bridges are specified canonically in design/AFFECT-DESIGN.md.
  * An Emotion is an intrinsic affective mode inhering in one agent, grafted under gmeow:AffectiveMoment ⊑ gmeow:MentalMoment — the kernel agent-mental-life family, sibling to cognition's CognitiveState, epistemics' doxastic states, and teleology's IntentionalMode. Its aboutness (gmeow:affectiveTarget) is separated from its cause (gmeow:affectiveElicitor) and its bearer (gmeow:emotionBearer). Episodic scope rides validFrom/validUntil on the statement; the mood surface is part of the fuller model in design/AFFECT-DESIGN.md.
  * OCCURRENT vs MODE (the felt-episode cut): gmeow:AffectiveExperience ⊑ mentation's gmeow:Experience is the phenomenal felt episode (a perdurant, logic:Event; gmeow:mentalProcessType gmeow:processAffectiveExperience pinned by restriction — the gmeow:DreamReport idiom), distinct from the endurant gmeow:Emotion mode it realizes via gmeow:feltAffect (⊑ gmeow:realizesMentalMoment). gmeow:MentalMoment excludes occurrents (logic:Mode vs logic:Event; the foundation's logic:Endurant/logic:Perdurant disjointness), so an agent can bear a mode without feeling it and feel one episode that realizes it. gmeow:experiencer/gmeow:realizesMentalMoment are reused from mentation, not re-minted (Principle 4/5).
  * EmotionType is an OPEN vocabulary seeded from the EmotionML standard sets (Plutchik's primary eight); registry-independent, contestable, never a tree (the Genre/Register precedent).
  * APPRAISALS ARE OBSERVATIONS: dimensional readings (PAD: valence, arousal, dominance) and qualitative aesthetic judgements (elegance, sublimity, kitsch — open) are vantage-indexed cells. Two critics disagreeing are two cells (Principle 9). Attributed emotion vs self-report is the vantage axis too: self-report is top authority for the subject's own standpoint (the facetVantage precedent).
  * ALIGNMENTS: MFOEM (linkage-only, BFO lineage), EmotionML vocabularies, the Open English WordNet OntoLex-Lemon lexical bridge, and classifier registries are generated logic:Correspondence lowerings carrying declared preservation (the W3C EmotionML projection is many-to-one and declares its loss). External vocabularies with no resolvable per-term RDF surface — the WordNet-Affect affective labels and NRC lexicons, the Emotion Frame Ontology, and Ithkuil affect roots — are recorded declines (gmeow:DeclinedCorrespondence, logic:Unsupported) in the declined-bridge ledger, their content carried in-slice."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    rdfs:label "GMEOW Affect Module"@x-gmeow-english ;
    skos:definition "The GMEOW Affect Module — emotions as intrinsic affective modes (kernel gmeow:MentalMoment family) and appraisals as vantage-indexed observations. Core; the fuller affect model is specified canonically in design/AFFECT-DESIGN.md."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# Closed-world cardinality/value axioms backing the hand-authored SHACL
# well-formedness shapes.
gmeow:Emotion rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:emotionBearer ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:emotionType ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:Appraisal rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:appraisalOf ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:vantage ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:appraisalDimension ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:appraisalValue ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:decimal ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:appraisalScaleProfile ; owl:maxQualifiedCardinality 1 ; owl:onClass gmeow:AffectScaleProfile ] .

# exact-one minCount restoration (issue #1194): min-qualified sibling restrictions
# restoring sh:minCount for the reasoner-safe max-qualified exact-one antecedents.
<https://blackcatinformatics.ca/gmeow/Emotion> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/emotionBearer> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/Appraisal> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/appraisalOf> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/AffectDecision> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/decidedLabel> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/AffectDecision> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/decisionCrossedThreshold> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/AffectDecision> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/observedFeature> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .

# =========================================================================== #
# Procedural constraints authored as raw logic:Formula integrity trees —        #
# projected to sh:SPARQLConstraint, keyed onto gmeow:Appraisal.                 #
# =========================================================================== #

# A dimensional appraisal reading is framed: gmeow:appraisalValue requires a
# gmeow:appraisalScaleProfile (an unframed magnitude is ill-formed, Principle 6/11).
gmeow:AppraisalFramedValueConstraint
    a logic:Constraint ;
    rdfs:label "Appraisal framed-value constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Appraisal carrying a gmeow:appraisalValue declares a gmeow:appraisalScaleProfile."@x-gmeow-english ;
    logic:formalizes gmeow:Appraisal , gmeow:AppraisalShape ;
    logic:message "A dimensional appraisal reading is unframed: gmeow:appraisalValue requires a gmeow:appraisalScaleProfile (the greenfield reshape removed the bare-decimal floor — an unframed magnitude is ill-formed, Principle 6/11)." ;
    logic:integrity logic:afvForall .
logic:afvForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] ;
    logic:forall logic:afvImpl .
logic:afvImpl a logic:Formula ; logic:antecedent logic:afvGuard ; logic:consequent logic:afvProfile .
logic:afvGuard a logic:Formula ; logic:and logic:afvType , logic:afvValue .
logic:afvType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Appraisal ] .
logic:afvValue a logic:Formula ; logic:relation gmeow:appraisalValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .
logic:afvProfile a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] ;
    logic:exists logic:afvProfileAtom .
logic:afvProfileAtom a logic:Formula ; logic:relation gmeow:appraisalScaleProfile ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .

# An Appraisal must read SOMETHING: a dimensional value (dimension + value) or at
# least one aesthetic quality.
gmeow:AppraisalReadsSomethingConstraint
    a logic:Constraint ;
    rdfs:label "Appraisal reads-something constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Appraisal reads at least one gmeow:appraisalQuality, or a gmeow:appraisalDimension together with a gmeow:appraisalValue."@x-gmeow-english ;
    logic:formalizes gmeow:Appraisal , gmeow:AppraisalShape ;
    logic:message "An Appraisal must read SOMETHING: a dimensional value (dimension + value) or at least one aesthetic quality." ;
    logic:integrity logic:arsForall .
logic:arsForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:arsImpl .
logic:arsImpl a logic:Formula ; logic:antecedent logic:arsGuard ; logic:consequent logic:arsOr .
logic:arsGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Appraisal ] .
logic:arsOr a logic:Formula ; logic:or logic:arsQual , logic:arsDimVal .
logic:arsQual a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "q" ] ;
    logic:exists logic:arsQualAtom .
logic:arsQualAtom a logic:Formula ; logic:relation gmeow:appraisalQuality ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "q" ] .
logic:arsDimVal a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] , [ logic:termIndex 1 ; logic:termVariable "vv" ] ;
    logic:exists logic:arsDimValBody .
logic:arsDimValBody a logic:Formula ; logic:and logic:arsDim , logic:arsVal .
logic:arsDim a logic:Formula ; logic:relation gmeow:appraisalDimension ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
logic:arsVal a logic:Formula ; logic:relation gmeow:appraisalValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "vv" ] .

