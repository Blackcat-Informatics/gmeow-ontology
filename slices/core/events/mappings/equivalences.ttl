|} .

gmeow:eventObservation skos:relatedMatch crm:P140_assigned_attribute_to {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "CIDOC P140 links E13 (the assignment event) to the item observed; GMEOW eventObservation links Event to Observation. Related match because the direction and granularity differ."
|} .

gmeow:eventTypeSurvey skos:relatedMatch schema:DiscoverAction {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "A survey is a kind of discovery/action in schema.org's flat action taxonomy."
|} .

gmeow:eventTypeAudit skos:relatedMatch schema:ReviewAction {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "An audit is a kind of review action in schema.org's flat taxonomy."
|} .

gmeow:hasParticipant skos:exactMatch prov:wasAssociatedWith {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "an event's agent participants are PROV's associated agents; gmeow scopes to any Event where PROV scopes to Activities — exactMatch on the shared activity use (PROV activity alignment phase 2)"
|} .

gmeow:eventFromLocation skos:closeMatch schema:fromLocation {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema scopes fromLocation to MoveAction/TransferAction; gmeow scopes to any movement-shaped Event — closeMatch, with the MoveAction typing handled by the projection cell (MoveAction projection)"
|} .

gmeow:eventToLocation skos:closeMatch schema:toLocation {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema scopes toLocation to MoveAction/TransferAction; gmeow scopes to any movement-shaped Event — closeMatch, with the MoveAction typing handled by the projection cell (MoveAction projection)"
|} .

gmeow:eventTypeMigration skos:closeMatch schema:MoveAction {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "a migration-typed event is schema's MoveAction shape; the projection types ANY endpoint-bearing event as MoveAction structurally (value-to-class convention, MoveAction projection)"
|} .

