      <termEntry id="c-d7b79a0e3d649156">
        <langSet xml:lang="en">
          <tig>
            <term>Term Carrier</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Porteur de terme</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>词项载体</term>
          </tig>
        </langSet>
