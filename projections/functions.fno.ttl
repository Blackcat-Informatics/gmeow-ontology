[] a fno:Mapping ;
    rdfs:label "fnHonorificToAffix → schema-org (FnO mapping)"@en ;
    fno:function gmeow:fnHonorificToAffix ;
    fno:implementation gmeow:implSchemaOrg ;
    fno:parameterMapping [ a fnom:PropertyParameterMapping ;
            rdfs:label "paramHonorific ↦ ?h"@en ;
