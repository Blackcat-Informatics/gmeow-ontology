    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "role" ;
    gmeow:comment "The OntoUML «role» stereotype: an anti-rigid, relationally-dependent sortal — the counterpart of logic:Role." ;
    gmeow:sssomFile "gmeow-ontouml.sssom.tsv" .

