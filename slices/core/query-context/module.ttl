    skos:scopeNote "The same resource in different atom roles remains distinct typed content. Actual is not an atom, and a composite frame name is not substituted for its flattened atoms."@x-gmeow-english ;
    skos:example "A supplied typed atom: ex:frame gmeow:restrictionImagined ex:restriction ."@x-gmeow-english ;
    logic:domain gmeow:QueryRestrictionFrame ; logic:range logic:Thing .

gmeow:restrictionAssumed
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-context> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "assumed restriction"@x-gmeow-english ;
    skos:definition "An explicitly supplied assumed atom role in a QueryRestrictionFrame inventory, corresponding to native component kind 3. The role selects restriction syntax without asserting its contents or assigning a class to its target."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly selects the assumed role for a supplied restriction resource."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving the assumed kind from a Scenario label or turning an assumed premise into an actual assertion or a verified proof."@x-gmeow-english ;
