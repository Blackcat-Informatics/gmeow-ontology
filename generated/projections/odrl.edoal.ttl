@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/odrl>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:RightsStatement ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri odrl:Policy ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.9"^^xsd:double ;
        rdfs:label "RightsStatement → odrl:Policy (the Set's superclass, alongside it)"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:RightsStatement ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri odrl:uid ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "RightsStatement → odrl:uid (the policy's own IRI)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:conformsTo ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri odrl:profile ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "RightsStatement conformsTo → odrl:profile"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasRightsStatement ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri odrl:hasPolicy ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "hasRightsStatement → odrl:hasPolicy"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:ruleAction ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri odrl:action ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.6"^^xsd:double ;
            rdfs:label "Extension RightsAction passthrough → odrl:action"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:ruleConsequence ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri odrl:consequence ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.7"^^xsd:double ;
            rdfs:label "Duty consequence → odrl:consequence"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:ruleConsequence ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri odrl:remedy ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.65"^^xsd:double ;
            rdfs:label "Prohibition consequence → odrl:remedy"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "odrl" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → odrl (EDOAL)"@en .
