# SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
# SPDX-License-Identifier: CC-BY-4.0
#
# The preference extension slice.
# It is a CONSUMER extension: it mints ONLY bridge terms that COMPOSE the shipped
# grounding referents (math: sheaf/Clifford/E8/connection objects, the logic: loss
# ledger and property-characteristic carrier) with the core candidate / observation /
# standpoint / evidence / provenance spine. It grounds NOTHING itself and hand-authors
# no sh:NodeShape/sh:PropertyShape (validation is authored as logic:Constraint + EL-safe
# OWL axioms; the pipeline DERIVES the SHACL). The one principle it exists to protect:
# a preference is NEVER automatically a global winner — a contextual comparison is a
# gmeow:vantage-indexed, defeasible, proof-carrying gmeow:PreferenceObservation, and a
# global winner is legal IFF the per-vantage orders glue into a math:GlobalSection (H0)
# over the WHOLE base AND discharge the math:GluingObstruction (H1). Every ranking
# projection (pairwise/listwise/DAG/Pareto/scalarized, incl. DPO) is a lossy, disclosed
# gmeow:ProjectionReceipt, never the canonical model. Depends only on core + logic/math
# grounding (Principle 16); norms, model-serving, semantic-topology, and
# embedding-projection are reused ONLY at the instance level and by-reference in
# mappings/equivalences.ttl, never by a subclass/domain/range axiom.

@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix logic:   <https://blackcatinformatics.ca/logic/> .
@prefix math:    <https://blackcatinformatics.ca/math/> .

# =========================================================================== #
# TASK 2 — Core preference vocabulary                                          #
# The candidate set, the contextual comparison, the vantage-indexed            #
# observation/claim, and the strict/tie/incomparability relations.             #
# =========================================================================== #

gmeow:CandidateSet
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Candidate Set"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ,
        [ a owl:Restriction ; owl:onProperty gmeow:hasCandidate ; owl:minQualifiedCardinality 1 ; owl:onClass gmeow:InformationObject ] ;
    skos:definition "The complete, closed-world roster of candidates a contextual comparison ranges over — the alternatives among which a preference is expressed. Its membership is CLOSED (a logic:ClosureEntry over gmeow:hasCandidate): 'is X a candidate here?' is answerable, so a projection that silently drops or adds an alternative is caught, and 'the best one' is always relative to a named, complete field. It is NOT the comparison itself (a gmeow:PreferenceObservation) nor a winner: a candidate set is the field, and no member is privileged by being listed (Principle 9)."@x-gmeow-english ;
    skos:example "ex:cs1 a gmeow:CandidateSet ; gmeow:hasCandidate ex:candA , ex:candB , ex:candC ; gmeow:candidateGeneratedBy ex:inv1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid leaving the roster open (membership is closed-world — an omitted alternative is asserted absent, not unknown) and avoid treating the first-listed member as a default winner; the set is an unordered field, and preference is expressed separately and contextually."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the field of alternatives gmeow:CandidateSet, enumerate its members with gmeow:hasCandidate (⊑ gmeow:hasPart), and record how the candidates were produced with gmeow:candidateGeneratedBy; membership is closed, so the roster is the complete field every derived ranking must account for."@x-gmeow-english ;
    gmeow:useWhen "Use for the complete, closed-world field of alternatives a contextual comparison ranges over — the roster every gmeow:PreferenceObservation and gmeow:ProjectionReceipt is relative to."@x-gmeow-english .

gmeow:hasCandidate
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CandidateSet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "has candidate"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    logic:subPropertyOf gmeow:hasPart ;
    skos:definition "Relates a gmeow:CandidateSet to an alternative that is a member of its roster — a subproperty of the EXISTING gmeow:hasPart (it REUSES the mereological spine rather than minting a parallel membership relation), so candidate membership participates in ordinary part queries. Non-functional: a set has many candidates. Its closure (logic:ClosureEntry) makes the roster complete: absence of a gmeow:hasCandidate edge means the object is NOT a candidate here, not merely unlisted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:candidateGeneratedBy
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "candidate generated by"@x-gmeow-english ;
    rdfs:range gmeow:ModelInvocation ;
    skos:definition "Relates a candidate to the gmeow:ModelInvocation (core ai) that produced it — the provenance anchor answering 'which model, prompt, and parameters minted this alternative?'. It REUSES the shipped ai invocation term rather than re-grounding generation, so a candidate's origin joins ordinary provenance queries. It is NOT gmeow:contextGeneration (the generation context of the whole comparison): this names the origin of ONE alternative."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:ComparisonContext
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Comparison Context"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ,
        [ a owl:Restriction ; owl:onProperty gmeow:contentDigest ; owl:allValuesFrom rdfs:Literal ] ;
    skos:definition "The content-addressed frame a contextual comparison is made under: its task (gmeow:contextTask), possible world (gmeow:contextWorld), standpoint (gmeow:contextStandpoint), time (gmeow:contextTime), governing policy (gmeow:contextPolicy), and generation context (gmeow:contextGeneration). It is what makes a preference CONTEXTUAL rather than universal: the same candidates compared under two contexts are two comparisons, neither privileged (Principle 9). Its identity is the REUSED gmeow:contentDigest over the whole frame, so 'which exact context?' is answerable, and it registers the observations made under it (gmeow:registersObservation) as a closed vantage base a consensus section must reconcile in full (F2). It is NOT a gmeow:PreferenceObservation (a single vantage's judgment WITHIN the context) nor a bare timestamp: it is the whole task/world/standpoint/time/policy/generation frame."@x-gmeow-english ;
    skos:example "ex:ctx1 a gmeow:ComparisonContext ; gmeow:contextTask ex:goalSummarize ; gmeow:contextStandpoint ex:editorStandpoint ; gmeow:contextPolicy ex:housePolicy ; gmeow:contentDigest \"blake3:9a2f…\" ; gmeow:registersObservation ex:obs1 , ex:obs2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid folding a single evaluator's judgment into the context (that is a gmeow:PreferenceObservation with a gmeow:vantage) and avoid reusing one context object across genuinely different tasks/worlds — a distinct frame is a distinct content-addressed context."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the comparison frame gmeow:ComparisonContext, bind its task/world/standpoint/time/policy/generation legs, content-address the whole with the existing gmeow:contentDigest, and register the observations made under it with gmeow:registersObservation so the vantage base a consensus section must reconcile is closed and complete."@x-gmeow-english ;
    gmeow:useWhen "Use to name the content-addressed task/world/standpoint/time/policy/generation frame a contextual comparison is made under — the thing that makes a preference contextual, not universal."@x-gmeow-english .

gmeow:contextTask
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonContext ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "context task"@x-gmeow-english ;
    rdfs:range gmeow:Goal ;
    skos:definition "Relates a gmeow:ComparisonContext to the gmeow:Goal (core teleology) the comparison is made in service of — WHAT the candidates are being preferred FOR. A preference is always relative to a task: the best summary for concision is not the best for completeness. It REUSES the shipped teleology goal term rather than minting a task vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:contextWorld
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonContext ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "context world"@x-gmeow-english ;
    rdfs:range logic:PossibleWorld ;
    skos:definition "Relates a gmeow:ComparisonContext to the logic:PossibleWorld under which the comparison's premises are taken to hold — the alethic index of the preference. It REUSES the shipped logic: modal term. It is NOT a gmeow:contextStandpoint (a perspective) nor a scenario: a possible world is an alethic possibility the comparison is evaluated at."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:contextStandpoint
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonContext ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "context standpoint"@x-gmeow-english ;
    rdfs:range gmeow:Standpoint ;
    skos:definition "Relates a gmeow:ComparisonContext to the gmeow:Standpoint (core) whose perspective the comparison is framed from — the named vantage the whole comparison is relative to, distinct from the per-observation gmeow:vantage of one evaluator. It REUSES the shipped standpoint term; competing standpoints frame competing comparisons, none privileged (Principle 9)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:contextTime
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonContext ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "context time"@x-gmeow-english ;
    rdfs:range gmeow:TimeScopedRelation ;
    skos:definition "Relates a gmeow:ComparisonContext to the gmeow:TimeScopedRelation (core temporal) naming the interval the comparison and its premises are scoped to — WHEN the preference holds, so a later re-comparison is a distinct, comparably-scoped frame. It REUSES the shipped temporal term rather than a bare timestamp."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:contextPolicy
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonContext ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "context policy"@x-gmeow-english ;
    rdfs:range gmeow:SocialObject ;
    skos:definition "Relates a gmeow:ComparisonContext to the governing policy the comparison is bound by — typed to the core gmeow:SocialObject, because a policy is a social object, NOT the norms-extension gmeow:Norm (which is reused only by-reference as a gmeow:TermEquivalence, never a range axiom — Principle 16). It names the rule-set under which candidates are judged, so a policy change is a context change."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:contextGeneration
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonContext ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "context generation"@x-gmeow-english ;
    rdfs:range gmeow:ModelInvocation ;
    skos:definition "Relates a gmeow:ComparisonContext to the gmeow:ModelInvocation (core ai) that generated the comparison setting — the invocation whose prompt and parameters produced the field being compared. It REUSES the shipped ai invocation term. It is NOT gmeow:candidateGeneratedBy (the origin of ONE candidate): this names the generation context of the whole comparison."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:registersObservation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonContext ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "registers observation"@x-gmeow-english ;
    rdfs:range gmeow:PreferenceObservation ;
    skos:definition "Relates a gmeow:ComparisonContext to a gmeow:PreferenceObservation made under it — the closed-world roster of vantages the context gathers. Its closure (a logic:ClosureEntry) is what makes 'reconcile the WHOLE vantage base' checkable (F2): a consensus section that omits a registered dissenting observation does not cover the whole base and cannot license a global winner. Non-functional: a context gathers many co-equal vantages (Principle 9)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:PreferenceObservation
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Preference Observation"@x-gmeow-english ;
    logic:subClassOf gmeow:Observation ,
        [ a owl:Restriction ; owl:onProperty gmeow:observedFeature ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    skos:definition "One vantage's contextual comparative judgment over a candidate set: a gmeow:Observation (inheriting its mandatory gmeow:vantage ⊑ gmeow:accordingTo and its gmeow:observedFeature) whose observed feature is a preference/tie/incomparability among candidates, made under a required gmeow:comparisonContext. It is the atomic, defeasible, attributed unit of the whole apparatus: conflicting observations from different vantages COEXIST as co-equal cells, none privileged (Principle 9), and a Condorcet cycle across them is the legal H1 obstruction, not an error. It is NOT a gmeow:PreferenceClaim (the truth-apt wrapper) nor a gmeow:ProjectionReceipt (a derived ranking): it is one evaluator's observation."@x-gmeow-english ;
    skos:example "ex:obs1 a gmeow:PreferenceObservation ; gmeow:vantage ex:evaluatorAlice ; gmeow:comparisonContext ex:ctx1 ; gmeow:observedFeature ex:pref_A_over_B ; gmeow:preferredOver ex:candA ; gmeow:confidence ex:high ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting a preference observation with no gmeow:comparisonContext (a context-free preference is exactly the forbidden universal winner — gmeow:PreferenceContextRequiredConstraint) and avoid resolving conflicting observations by rank; rival vantages coexist (Principle 9) and their disagreement is the H1 obstruction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type one evaluator's comparative judgment gmeow:PreferenceObservation, attribute it with the inherited gmeow:vantage, bind its required gmeow:comparisonContext, carry the compared relation with gmeow:preferredOver / gmeow:preferentiallyEquivalentWith / gmeow:incomparableWith, ground it in evidence (gmeow:groundedIn) and confidence (gmeow:confidence), and let it be reconciled — never overruled — across vantages."@x-gmeow-english ;
    gmeow:useWhen "Use for one vantage's contextual comparative judgment over a candidate set — the atomic, attributed, defeasible unit that conflicting evaluators express as co-equal cells."@x-gmeow-english .

gmeow:comparisonContext
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "comparison context"@x-gmeow-english ;
    rdfs:range gmeow:ComparisonContext ;
    skos:definition "Relates a gmeow:PreferenceObservation to the gmeow:ComparisonContext it is made under — the MANDATORY frame (gmeow:PreferenceContextRequiredConstraint + a logic:ClosureEntry) that makes the preference contextual rather than a universal winner. A preference observation with no comparison context floats free of the task/world/standpoint/time/policy/generation it is relative to, and is exactly the context-free winner Principle 9 forbids."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:PreferenceClaim
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Preference Claim"@x-gmeow-english ;
    logic:subClassOf gmeow:StandpointClaim ;
    skos:definition "The truth-apt, vantage-attributed, defeasible wrapper around a contextual preference: a gmeow:StandpointClaim (the EL-safe governing axiom) attributed to its standpoint/agent vantage (gmeow:vantage ⊑ gmeow:accordingTo). It is the ONLY construct that may assert a global winner (gmeow:assertsGlobalWinner true), and it may do so ONLY when it extends the per-vantage orders to a gmeow:ConsensusSection over the WHOLE base (gmeow:extendsToConsensusSection, H0) AND discharges the gmeow:DisagreementObstruction (gmeow:dischargesDisagreement, H1) — the governing gmeow:NoGlobalWinnerWithoutConsensusConstraint. It is NOT a gmeow:PreferenceObservation (one evaluator's datum) and NOT a gmeow:ProjectionReceipt (a lossy derived ranking): it is the standpoint-relative claim that may, under discharge, become a global fact."@x-gmeow-english ;
    skos:example "ex:claim1 a gmeow:PreferenceClaim ; gmeow:vantage ex:panelStandpoint ; gmeow:assertsGlobalWinner true ; gmeow:extendsToConsensusSection ex:sec1 ; gmeow:dischargesDisagreement ex:obstruction0 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid setting gmeow:assertsGlobalWinner true without a typed gmeow:ConsensusSection over the whole vantage base and a discharged gmeow:DisagreementObstruction (that is the forbidden context-free winner) and avoid treating a claim as indefeasible; it carries a defeasible status and may be attacked."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the vantage-attributed preference assertion gmeow:PreferenceClaim, attribute it with gmeow:vantage; to assert a global winner set gmeow:assertsGlobalWinner true ONLY together with gmeow:extendsToConsensusSection over the whole base and gmeow:dischargesDisagreement, so the governing gate can certify the winner is a genuine H0 lift with a discharged H1 obstruction."@x-gmeow-english ;
    gmeow:useWhen "Use for the truth-apt, vantage-attributed wrapper that may — only under a discharged whole-base consensus — assert a global winner; the sole construct Principle 9 permits to name one."@x-gmeow-english .

# --- The three comparative relations: strict, tie (symmetric), incomparable --- #

gmeow:preferredOver
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "preferred over"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "The STRICT comparative relation: within one gmeow:PreferenceProjection cell (one vantage's local order), the candidate on the left is strictly preferred to the candidate on the right. It is a strict partial order (irreflexive, asymmetric, transitive — the logic:properPartOf reading) but only its IRREFLEXIVITY is declared globally (gmeow:preferredOverIrreflexivity, safe). Its ASYMMETRY and TRANSITIVITY are NOT declared as global characteristics (FLAG-1): two vantages legitimately assert gmeow:preferredOver(A,B) and gmeow:preferredOver(B,A), and a cross-vantage cycle is the legal H1 obstruction, not a contradiction — cross-vantage conflicts are carried by the reified, vantage-indexed gmeow:PreferenceObservation/gmeow:PreferenceClaim, not by bare conflicting edges. This bare candidate→candidate relation is uncell-scopeable, so per-cell asymmetry is enforced NOT over it but over the cell-attributed reified gmeow:PreferenceEdges (gmeow:edgeWinner/gmeow:edgeLoser hung under the cell's gmeow:PreferenceOrder via gmeow:orderEdge) by gmeow:VantageScopedStrictOrderConstraint (G3): winner gmeow:preferredOver loser is the bare reading of an edge, and G3 fires only on a reversed pair under ONE cell's order. It is NOT gmeow:preferentiallyEquivalentWith (a tie) nor gmeow:incomparableWith (a positive non-order)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:preferentiallyEquivalentWith
    a owl:ObjectProperty ,
        owl:SymmetricProperty ;
    rdfs:domain gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "preferentially equivalent with"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "The TIE relation: within a vantage's local order, two candidates are judged equally preferable — neither is preferred over the other, but they ARE comparable (a genuine indifference, distinct from incomparability). It is symmetric and irreflexive via the NATIVE logic:symmetricProperty / logic:irreflexiveProperty markers carried on gmeow:PropertyCharacteristicAssertion records, NEVER owl:SymmetricProperty (EL-illegal). It is NOT gmeow:incomparableWith (a positive non-order where no comparison holds) and NOT the absence of an edge (which is 'not yet compared')."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:incomparableWith
    a owl:ObjectProperty ,
        owl:SymmetricProperty ;
    rdfs:domain gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "incomparable with"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "The POSITIVE incomparability relation: two candidates are asserted genuinely incomparable — e.g. Pareto-incomparable, each better on a different criterion — NOT merely 'not yet compared' (an absent edge) and NOT tied (gmeow:preferentiallyEquivalentWith, a comparable indifference). Making incomparability first-class is what lets a Pareto void be a queryable, disclosed fact rather than silent missing data (gmeow:TieIncomparabilityDistinctnessConstraint, G1). It is symmetric and irreflexive via the native logic:symmetricProperty / logic:irreflexiveProperty markers, never owl:SymmetricProperty."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- The reified observation's DIRECTED judgment (vantage-scoped carrier) ------ #
# A gmeow:PreferenceObservation is a logic:Relator (⊑ gmeow:Observation), NOT an
# gmeow:InformationObject, so it cannot be the subject of gmeow:preferredOver (a
# candidate→candidate InformationObject edge). The observation names its DIRECTED
# judgment with gmeow:observationPrefers (→ the winning candidate) and, optionally,
# gmeow:observationDisprefers (→ the dispreferred candidate); the compared pair itself
# rides gmeow:observedFeature. This is the FLAG-1 cross-vantage coexistence carrier: a
# cross-vantage cycle is a cycle over observationPrefers judgments (the legal H1
# obstruction), never a global-strict-order violation. The bare candidate→candidate
# gmeow:preferredOver edge is reserved for the coherent WITHIN-cell order of one
# gmeow:PreferenceProjection, where gmeow:VantageScopedStrictOrderConstraint (G3) applies.

gmeow:observationPrefers
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "observation prefers"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    logic:subPropertyOf gmeow:observedFeature ;
    skos:definition "Relates a gmeow:PreferenceObservation to the candidate it judges STRICTLY PREFERRED — the winner of the directed comparison this vantage records. It is the reified, vantage-indexed carrier of a strict preference (⊑ gmeow:observedFeature): the observation, not a bare edge, holds the direction, so two vantages that disagree are two coexisting observations (Principle 9) and their cross-vantage cycle is the legal H1 gmeow:DisagreementObstruction. Distinct from the candidate→candidate gmeow:preferredOver (the within-cell order edge): an observation is a logic:Relator and cannot be a gmeow:preferredOver subject. The dispreferred side rides gmeow:observationDisprefers; the compared pair rides gmeow:observedFeature."@x-gmeow-english ;
    skos:example "ex:obsAB a gmeow:PreferenceObservation ; gmeow:vantage ex:eval1 ; gmeow:observationPrefers ex:candA ; gmeow:observationDisprefers ex:candB ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using gmeow:preferredOver from an observation (a logic:Relator cannot be its InformationObject subject); avoid it for a tie (gmeow:preferentiallyEquivalentWith) or a positive incomparability (gmeow:incomparableWith), which name no winner."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "On each gmeow:PreferenceObservation that records a strict preference, point gmeow:observationPrefers at the winning candidate and gmeow:observationDisprefers at the loser; carry the pair on gmeow:observedFeature and the frame on gmeow:vantage."@x-gmeow-english ;
    gmeow:useWhen "Use to record which candidate a single vantage's strict-preference observation judges the winner, as the coexisting, vantage-indexed carrier that keeps cross-vantage cycles legal."@x-gmeow-english .

gmeow:observationDisprefers
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "observation disprefers"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    logic:subPropertyOf gmeow:observedFeature ;
    skos:definition "Relates a gmeow:PreferenceObservation to the candidate it judges STRICTLY DISPREFERRED — the loser of the directed comparison this vantage records, the counterpart of gmeow:observationPrefers (⊑ gmeow:observedFeature). Together the two name the ordered pair the observation reifies, so 'A ≻ B per this vantage' is a single coexisting cell, never a bare candidate→candidate edge."@x-gmeow-english ;
    skos:example "ex:obsAB a gmeow:PreferenceObservation ; gmeow:observationPrefers ex:candA ; gmeow:observationDisprefers ex:candB ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid naming a dispreferred side for a tie or a positive incomparability (neither has a loser); avoid gmeow:preferredOver from the observation (a logic:Relator subject is ill-typed)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point gmeow:observationDisprefers at the losing candidate of a strict-preference observation, paired with gmeow:observationPrefers on the winner."@x-gmeow-english ;
    gmeow:useWhen "Use to record the losing candidate of a single vantage's strict-preference observation."@x-gmeow-english .

gmeow:usesRubric
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "uses rubric"@x-gmeow-english ;
    rdfs:range gmeow:SocialObject ;
    skos:definition "Relates a gmeow:PreferenceObservation to the rubric its judgment applies — typed to the core gmeow:SocialObject (a rubric is a social object; norms gmeow:Rubric ⊑ gmeow:Norm ⊑ gmeow:SocialObject is reused only by-reference as a gmeow:TermEquivalence, never a range axiom — Principle 16). It names the evaluative frame the comparison is under, so a rubric change is a comparison change."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:onCriterion
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceObservation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "on criterion"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "Relates a gmeow:PreferenceObservation to the criterion its comparison is made along — typed to the core gmeow:InformationObject (a criterion is an information object; norms gmeow:Criterion ⊑ gmeow:InformationObject is reused only by-reference, never a range axiom — Principle 16). Two candidates preferred oppositely on two criteria are the Pareto-incomparability the slice records positively (gmeow:incomparableWith)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:PreferenceEvaluation
    a logic:Event ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Preference Evaluation"@x-gmeow-english ;
    logic:subClassOf gmeow:Activity ;
    skos:definition "The attributed activity that produces a gmeow:PreferenceObservation: it applies a rubric and criteria to a candidate set under a context and emits the comparative judgment, its build provenance riding the EXISTING gmeow:wasGeneratedBy / gmeow:wasDerivedFrom (an observation gmeow:wasGeneratedBy its evaluation). It is the occurrent that MAKES a preference observation, distinct from the observation itself and from the downstream gmeow:ComparisonCompilation that assembles many observations into a sheaf."@x-gmeow-english ;
    skos:example "ex:eval1 a gmeow:PreferenceEvaluation ; gmeow:usedModel ex:opus ; gmeow:wasAssociatedWith ex:evaluatorAlice ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating the evaluation activity with the gmeow:PreferenceObservation it produces (the observation gmeow:wasGeneratedBy the evaluation) and avoid folding cross-vantage assembly into it — that is the separate gmeow:ComparisonCompilation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the judging activity gmeow:PreferenceEvaluation, attribute it with the existing provenance (gmeow:wasAssociatedWith / gmeow:usedModel), and link the observation it produces back to it with the existing gmeow:wasGeneratedBy."@x-gmeow-english ;
    gmeow:useWhen "Use for the attributed activity that produces one vantage's gmeow:PreferenceObservation by applying a rubric and criteria to a candidate set under a context."@x-gmeow-english .

gmeow:PreferenceProjection
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Preference Projection"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "One CELL of the comparison: a single vantage's local strict partial order over the candidate set — the scope within which gmeow:preferredOver is genuinely irreflexive, asymmetric, and transitive (FLAG-1). It is the math:LocalSection carrier of the sheaf picture: a cell's order is coherent on its own, and it is the gluing of cells that may fail (the H1 obstruction). It is NOT the global comparison (a coexistence of many cells) and NOT a gmeow:ProjectionReceipt (a lossy derived ranking over the whole comparison)."@x-gmeow-english ;
    skos:example "ex:cell_alice a gmeow:PreferenceProjection ; gmeow:vantage ex:evaluatorAlice ; gmeow:projectionOrder ex:order_alice ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid enforcing the strict-order characteristics across cells (they are cell-scoped — cross-vantage cycles are the legal obstruction, not an error) and avoid treating a cell as a global winner; a cell is one math:LocalSection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type one vantage's local order gmeow:PreferenceProjection, attribute it with gmeow:vantage, and carry its order via gmeow:projectionOrder; the cell is the scope the gmeow:VantageScopedStrictOrderConstraint enforces strict-order coherence within."@x-gmeow-english ;
    gmeow:useWhen "Use for a single vantage's local strict partial order over the candidate set — the cell within which gmeow:preferredOver is strict and the math:LocalSection the sheaf glues."@x-gmeow-english .

gmeow:projectionOrder
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceProjection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "projection order"@x-gmeow-english ;
    rdfs:range gmeow:PreferenceOrder ;
    skos:definition "Relates a gmeow:PreferenceProjection cell to the gmeow:PreferenceOrder it carries — the reified local order (referencing a raw math:Relation) that is coherent within the cell. It is the cell→order edge; the vantage the cell is held from rides gmeow:vantage."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Reified within-cell strict-preference EDGES (the cell-attributed order) --- #
# FLAG-1 / G3 cell-scoping: bare gmeow:preferredOver is a candidate→candidate edge with
# NO structural attribution to a cell, so a constraint over it can only ever be GLOBAL —
# it cannot tell one cell's order from another's, and a global asymmetry check would
# reject the legal cross-vantage conflict preferredOver(A,B) ∧ preferredOver(B,A)
# (Principle 9). The within-cell order is therefore carried by REIFIED gmeow:PreferenceEdge
# nodes hung under the cell's gmeow:PreferenceOrder (gmeow:orderEdge), each naming its
# gmeow:edgeWinner and gmeow:edgeLoser. gmeow:VantageScopedStrictOrderConstraint (G3) joins
# these edges through ?cell gmeow:projectionOrder ?order gmeow:orderEdge ?e, so a reversed
# pair is a violation ONLY when BOTH edges sit under the SAME cell's order — two DIFFERENT
# cells asserting opposite directions is the legal coexistence, never a violation.
gmeow:PreferenceEdge
    a owl:Class ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "preference edge"@x-gmeow-english ;
    skos:definition "A reified directed strict-preference edge WITHIN one gmeow:PreferenceProjection cell's order: it names a gmeow:edgeWinner (the strictly preferred candidate) and a gmeow:edgeLoser (the dispreferred one). It is the CELL-ATTRIBUTED carrier of the within-cell strict order — hung under the cell's gmeow:PreferenceOrder via gmeow:orderEdge — that makes gmeow:VantageScopedStrictOrderConstraint (G3) genuinely cell-scoped (FLAG-1). It corresponds to the bare candidate→candidate gmeow:preferredOver relation (winner preferredOver loser) but, unlike the bare edge, it is attributable to exactly one cell, so a reversed pair is incoherent only within a single cell — a cross-vantage reversal across two cells is the legal Principle-9 conflict."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:orderEdge
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceOrder ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "order edge"@x-gmeow-english ;
    rdfs:range gmeow:PreferenceEdge ;
    skos:definition "Relates a gmeow:PreferenceOrder (the reified order one gmeow:PreferenceProjection cell carries) to a gmeow:PreferenceEdge it contains — a within-cell directed strict-preference pair. Because every edge is reached ONLY through its owning cell's order, gmeow:VantageScopedStrictOrderConstraint (G3) can scope its asymmetry/irreflexivity check to a single cell (FLAG-1)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:edgeWinner
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceEdge ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "edge winner"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "The strictly preferred candidate of a within-cell gmeow:PreferenceEdge (the winner side of the directed pair). Corresponds to the subject of the bare gmeow:preferredOver edge, but carried cell-attributed so G3 is cell-scoped."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:edgeLoser
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceEdge ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "edge loser"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "The dispreferred candidate of a within-cell gmeow:PreferenceEdge (the loser side of the directed pair). Corresponds to the object of the bare gmeow:preferredOver edge, but carried cell-attributed so G3 is cell-scoped."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Strict-order (irreflexivity only, global-safe) + tie/incomparability ----- #
# FLAG-1 resolution: gmeow:preferredOver carries ONLY a GLOBAL irreflexivity
# characteristic (nothing is strictly preferred to itself under any vantage — safe).
# Its ASYMMETRY and TRANSITIVITY are enforced CELL-SCOPED ONLY, by the logic:Constraint
# gmeow:VantageScopedStrictOrderConstraint (G3) — NEVER as global
# logic:PropertyCharacteristicAssertion records: a global asymmetry marker would reject
# the legal cross-vantage conflict preferredOver(A,B) ∧ preferredOver(B,A) (Principle 9),
# and a global transitivity marker would CONFLATE vantages (composing vantage-1's A≻B with
# vantage-2's B≻C into a spurious A≻C). Cross-vantage conflicts are carried by the reified,
# vantage-indexed gmeow:PreferenceObservation, not by bare conflicting edges. Tie/
# incomparability symmetry uses the NATIVE logic:symmetricProperty marker, never
# owl:SymmetricProperty (EL-illegal); both are globally safe (a tie/incomparability holds
# both ways under the vantage that asserts it).

gmeow:preferredOverIrreflexivity
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "preferredOver is irreflexive (global-safe)"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:preferredOver is irreflexive: no candidate is strictly preferred to itself under any vantage. This is the ONE strict-order characteristic that is GLOBALLY safe (unlike asymmetry/transitivity, which are cross-vantage-unsafe and are instead enforced cell-scoped by gmeow:VantageScopedStrictOrderConstraint, G3, per FLAG-1). The native coherence gate reads this to reject a reflexive strict-preference edge anywhere."@x-gmeow-english ;
    logic:characterizes gmeow:preferredOver ;
    logic:characteristicSort logic:irreflexiveProperty ;
    logic:formalizes gmeow:preferredOver ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:equivalenceSymmetry
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "preferentiallyEquivalentWith is symmetric"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:preferentiallyEquivalentWith is symmetric via the NATIVE logic:symmetricProperty marker (never owl:SymmetricProperty, which is EL-illegal): a tie between A and B is a tie between B and A. The native coherence gate reads this to close the tie relation symmetrically."@x-gmeow-english ;
    logic:characterizes gmeow:preferentiallyEquivalentWith ;
    logic:characteristicSort logic:symmetricProperty ;
    logic:formalizes gmeow:preferentiallyEquivalentWith ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:equivalenceIrreflexivity
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "preferentiallyEquivalentWith is irreflexive"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:preferentiallyEquivalentWith is irreflexive: a tie relates two DISTINCT candidates, never a candidate to itself (self-identity is not a preferential tie). The native coherence gate reads this to reject a reflexive tie edge."@x-gmeow-english ;
    logic:characterizes gmeow:preferentiallyEquivalentWith ;
    logic:characteristicSort logic:irreflexiveProperty ;
    logic:formalizes gmeow:preferentiallyEquivalentWith ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:incomparabilitySymmetry
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "incomparableWith is symmetric"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:incomparableWith is symmetric via the NATIVE logic:symmetricProperty marker (never owl:SymmetricProperty): if A is incomparable with B then B is incomparable with A. The native coherence gate reads this to close incomparability symmetrically."@x-gmeow-english ;
    logic:characterizes gmeow:incomparableWith ;
    logic:characteristicSort logic:symmetricProperty ;
    logic:formalizes gmeow:incomparableWith ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:incomparabilityIrreflexivity
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "incomparableWith is irreflexive"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:incomparableWith is irreflexive: a candidate is always comparable with itself, so incomparability relates two DISTINCT candidates. The native coherence gate reads this to reject a reflexive incomparability edge."@x-gmeow-english ;
    logic:characterizes gmeow:incomparableWith ;
    logic:characteristicSort logic:irreflexiveProperty ;
    logic:formalizes gmeow:incomparableWith ;
    gmeow:graphBoxRole gmeow:boxABox .

# =========================================================================== #
# TASK 3 — Sheaf-theoretic consensus core + the governing gate                 #
# The comparison compiles into a math:CellComplex carried by a                 #
# math:CellularSheaf; a global winner is legal IFF the per-vantage orders glue #
# into a math:GlobalSection (H0) over the WHOLE base AND discharge the          #
# math:GluingObstruction (H1). Condorcet cycle = non-flat holonomy.            #
# =========================================================================== #

gmeow:ComparisonCompilation
    a logic:Event ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Comparison Compilation"@x-gmeow-english ;
    logic:subClassOf gmeow:Activity ;
    skos:definition "The attributed activity that compiles a gmeow:CandidateSet and its gmeow:PreferenceObservations into a topological carrier: a math:CellComplex (gmeow:compilesToPreferenceComplex) whose 0-cells are candidates, 1-cells are preference/tie/incomparability edges, and 2-cells are inter-vantage agreement, carried by a math:CellularSheaf (gmeow:carriedBySheaf) whose stalks are the Clifford fibers of the geometric seam. It records the per-cell provenance back to the observations through a gmeow:CandidateSourceCorrespondence (gmeow:recordsCandidateCorrespondence) and its preservation/loss through a gmeow:ProjectionPreservationRecord (gmeow:recordsProjectionPreservation). It is the occurrent that MAKES the sheaf from observations; it is NOT itself a math: object, and NOT the downstream projection that emits a ranking."@x-gmeow-english ;
    skos:example "ex:comp1 a gmeow:ComparisonCompilation ; gmeow:compilesComparison ex:cs1 ; gmeow:compilesToPreferenceComplex ex:complex1 ; gmeow:carriedBySheaf ex:sheaf1 ; gmeow:recordsCandidateCorrespondence ex:corr1 ; gmeow:recordsProjectionPreservation ex:pres1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing gmeow:compilesToPreferenceComplex at anything but a math:CellComplex (the wrapper never IS the math object — gmeow:ProjectionObjectConflationConstraint) and avoid omitting the correspondence or preservation record; an uncorresponded, unledgered compilation is a black box."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the assembly activity gmeow:ComparisonCompilation, bind its input candidate set (gmeow:compilesComparison), its produced math:CellComplex (gmeow:compilesToPreferenceComplex) and math:CellularSheaf (gmeow:carriedBySheaf), and record the cell↔observation correspondence and the preservation/loss judgment."@x-gmeow-english ;
    gmeow:useWhen "Use for the attributed activity that compiles a candidate set and its vantage-indexed observations into a math:CellComplex carried by a math:CellularSheaf — the input to consensus/obstruction analysis."@x-gmeow-english .

gmeow:compilesComparison
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonCompilation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "compiles comparison"@x-gmeow-english ;
    rdfs:range gmeow:CandidateSet ;
    skos:definition "Relates a gmeow:ComparisonCompilation to the gmeow:CandidateSet it reads as its field of alternatives. It names the input CONSUMED, distinct from gmeow:compilesToPreferenceComplex (the complex PRODUCED)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:compilesToPreferenceComplex
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonCompilation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "compiles to preference complex"@x-gmeow-english ;
    rdfs:range math:CellComplex ;
    skos:definition "Relates a gmeow:ComparisonCompilation to the math:CellComplex it produces — candidates as 0-cells, preference/tie/incomparability edges as 1-cells, inter-vantage agreement as 2-cells. The reference is BY LINK: the wrapper compilation never IS the math object (gmeow:ProjectionObjectConflationConstraint)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:carriedBySheaf
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonCompilation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "carried by sheaf"@x-gmeow-english ;
    rdfs:range math:CellularSheaf ;
    skos:definition "Relates a gmeow:ComparisonCompilation to the math:CellularSheaf carrying its complex — the sheaf whose math:SheafStalks are the per-candidate Clifford fibers of the geometric seam and whose restriction maps ARE the preference math:connectionOfSheaf. A Condorcet cycle is non-trivial holonomy of that connection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:CandidateSourceCorrespondence
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Candidate-Source Correspondence"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The per-compilation audit record mapping the cells of the compiled complex back to the gmeow:PreferenceObservations they were built from — the trail that makes a compiled preference topology traceable to its evaluations. Its rows compose gmeow:correspondsToCell (record → math:Cell) with that cell's gmeow:cellObservation (math:Cell → gmeow:PreferenceObservation, ⊑ gmeow:wasDerivedFrom). It is NOT a gmeow:ProjectionPreservationRecord (loss, not provenance) and NOT a math: object."@x-gmeow-english ;
    skos:example "ex:corr1 a gmeow:CandidateSourceCorrespondence ; gmeow:correspondsToCell ex:cell_A ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a correspondence record that names no gmeow:correspondsToCell row (a black box wearing an audit label) and avoid confusing it with the preservation record; this maps provenance, that records loss."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint a gmeow:CandidateSourceCorrespondence per compilation, cover each math:Cell with gmeow:correspondsToCell, and let each cell name its source observation with gmeow:cellObservation (⊑ gmeow:wasDerivedFrom) so every cell is auditable to its evaluation."@x-gmeow-english ;
    gmeow:useWhen "Use for the per-compilation record that traces each cell of the preference complex back to the vantage-indexed observation it was built from."@x-gmeow-english .

gmeow:recordsCandidateCorrespondence
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonCompilation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "records candidate correspondence"@x-gmeow-english ;
    rdfs:range gmeow:CandidateSourceCorrespondence ;
    skos:definition "Relates a gmeow:ComparisonCompilation to the gmeow:CandidateSourceCorrespondence recording which cell traces to which observation. It is NOT gmeow:recordsProjectionPreservation (loss, not provenance)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:correspondsToCell
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CandidateSourceCorrespondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "corresponds to cell"@x-gmeow-english ;
    rdfs:range math:Cell ;
    skos:definition "Relates a gmeow:CandidateSourceCorrespondence to a math:Cell it covers — the record-membership half of an audit row, completed by that cell's own gmeow:cellObservation. Non-functional: a correspondence covers every cell of the complex."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:cellObservation
    a owl:ObjectProperty ;
    rdfs:domain math:Cell ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "cell observation"@x-gmeow-english ;
    rdfs:range gmeow:PreferenceObservation ;
    logic:subPropertyOf gmeow:wasDerivedFrom ;
    skos:definition "Relates a math:Cell of the compiled complex to the gmeow:PreferenceObservation it was derived from — the atomic cell↔evidence edge, a subproperty of the EXISTING gmeow:wasDerivedFrom (it REUSES the provenance spine). Non-functional: a cell may aggregate several observations (e.g. an agreement 2-cell)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:ProjectionPreservationRecord
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Projection Preservation Record"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The per-compilation record carrying the preservation/loss judgment of a gmeow:ComparisonCompilation, stated in the SHIPPED logic: loss-ledger vocabulary and NOTHING new: EXACTLY ONE logic:preservationKind (logic:ExactPreservation when lossless; a lossier rung otherwise), and — for any kind other than logic:ExactPreservation — a named logic:ExpressivenessBoundary via logic:expressivenessBoundary (gmeow:PreservationBoundaryConstraint). It mints no preservation vocabulary; it reuses the ledger exactly as math: and semantic-topology do. It is NOT a gmeow:CandidateSourceCorrespondence (provenance, not loss)."@x-gmeow-english ;
    skos:example "ex:pres1 a gmeow:ProjectionPreservationRecord ; logic:preservationKind logic:ExactPreservation ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a record naming zero preservation kinds (a hollow ledger entry) and avoid a lossy/unsupported kind with no named boundary; both only LOOK honest."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint a gmeow:ProjectionPreservationRecord per compilation, name its rung with exactly one logic:preservationKind, and for any non-exact rung name the logic:ExpressivenessBoundary it drops through logic:expressivenessBoundary."@x-gmeow-english ;
    gmeow:useWhen "Use for the per-compilation preservation/loss judgment, reusing the shipped logic: loss ledger verbatim."@x-gmeow-english .

gmeow:ProjectionPreservationRecord logic:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:preservationKind ; owl:minQualifiedCardinality 1 ; owl:onClass logic:PreservationKind ] ,
    [ a owl:Restriction ; owl:onProperty logic:preservationKind ; owl:maxQualifiedCardinality 1 ; owl:onClass logic:PreservationKind ] .

gmeow:recordsProjectionPreservation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ComparisonCompilation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "records projection preservation"@x-gmeow-english ;
    rdfs:range gmeow:ProjectionPreservationRecord ;
    skos:definition "Relates a gmeow:ComparisonCompilation to the gmeow:ProjectionPreservationRecord carrying its preservation/loss judgment. Compiling observations into a sheaf is a projection, and an honest projection names what it dropped (Principle 17)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:PreferenceOrder
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Preference Order"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The reified order a cell carries: an information-object WRAPPER that REFERENCES a raw math:Relation (gmeow:orderRelation) without BEING it. Keeping the order a distinct wrapper is what lets it be attributed, versioned, and audited while the math:Relation stays the pure mathematical referent — a gmeow:PreferenceOrder typed as a math: object is the gmeow:ProjectionObjectConflationConstraint failure (the semantic-topology ResultObjectConflation twin). It is NOT the math:Relation itself and NOT a gmeow:PreferenceProjection (the cell that carries the order)."@x-gmeow-english ;
    skos:example "ex:order_alice a gmeow:PreferenceOrder ; gmeow:orderRelation ex:rel_alice ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid typing a gmeow:PreferenceOrder in the math: namespace (that conflates the wrapper with the referent) and avoid treating it as the cell; the cell (gmeow:PreferenceProjection) carries the order, the order references the raw relation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint a gmeow:PreferenceOrder wrapper and point gmeow:orderRelation at the raw math:Relation it references; carry attribution and versioning on the wrapper, keep the mathematics on the referent."@x-gmeow-english ;
    gmeow:useWhen "Use for the attributed, auditable wrapper around a cell's raw math:Relation order — the wrapper that is never itself the math object."@x-gmeow-english .

gmeow:orderRelation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceOrder ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "order relation"@x-gmeow-english ;
    rdfs:range math:Relation ;
    skos:definition "Relates a gmeow:PreferenceOrder wrapper to the raw math:Relation it references — the order's mathematical referent, kept a pure math: object by link. It is NOT an identity: the order IS NOT the relation, it REFERENCES it (the conflation is gmeow:ProjectionObjectConflationConstraint)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:ConsensusSection
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Consensus Section"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The information-object wrapper around a math:GlobalSection (gmeow:consensusGlobalSection) — the H0 lift that assigns a compatible order over the ENTIRE comparison base, the sole warrant for a legal global winner. It is bound to its gmeow:ComparisonContext (gmeow:sectionContext) and records which observations it reconciles (gmeow:reconcilesObservation): a section that omits a registered dissenting vantage does NOT cover the whole base and cannot license a winner (F2). It is NOT the math:GlobalSection itself (the wrapper never IS the math object) and NOT a gmeow:DisagreementObstruction (its H1 dual)."@x-gmeow-english ;
    skos:example "ex:sec1 a gmeow:ConsensusSection ; gmeow:consensusGlobalSection ex:h0lift ; gmeow:sectionContext ex:ctx1 ; gmeow:reconcilesObservation ex:obs1 , ex:obs2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a consensus section that reconciles fewer than all observations registered on its context (a cherry-picked section is not a whole-base H0 lift — F2) and avoid typing it in the math: namespace."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint a gmeow:ConsensusSection wrapping the math:GlobalSection (gmeow:consensusGlobalSection), bind its gmeow:sectionContext, and enumerate every observation it reconciles with gmeow:reconcilesObservation so the governing gate can verify it covers the whole vantage base."@x-gmeow-english ;
    gmeow:useWhen "Use for the whole-base H0 consensus lift a gmeow:PreferenceClaim must extend to before any global winner is legal."@x-gmeow-english .

gmeow:consensusGlobalSection
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ConsensusSection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "consensus global section"@x-gmeow-english ;
    rdfs:range math:GlobalSection ;
    skos:definition "Relates a gmeow:ConsensusSection wrapper to the math:GlobalSection (H0) it references — the degree-zero sheaf-cohomology lift assigning a compatible order over the whole base. By link: the wrapper carries audit, the math: object carries the mathematics."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:sectionContext
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ConsensusSection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "section context"@x-gmeow-english ;
    rdfs:range gmeow:ComparisonContext ;
    skos:definition "Relates a gmeow:ConsensusSection to the gmeow:ComparisonContext whose registered observations it must reconcile in full (F2). It is the edge the governing gate follows from a section to the closed vantage base it must cover."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:reconcilesObservation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ConsensusSection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "reconciles observation"@x-gmeow-english ;
    rdfs:range gmeow:PreferenceObservation ;
    skos:definition "Relates a gmeow:ConsensusSection to a gmeow:PreferenceObservation its H0 lift reconciles — the positive record that the section accounts for this vantage. The governing gate demands that EVERY observation registered on the section's context be reconciled: an unreconciled registered observation is a hole in the whole-base cover (F2)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:DisagreementObstruction
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Disagreement Obstruction"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The information-object wrapper around a math:GluingObstruction (gmeow:obstructionClass) — the H1 class whose non-vanishing is the computable witness that per-vantage orders do NOT glue into one global winner. A Condorcet cycle is a non-vanishing H1 class, equivalently non-trivial holonomy of the preference math:connectionOfSheaf (gmeow:obstructionHolonomy, the curvature witness). A global winner is legal only when a gmeow:PreferenceClaim DISCHARGES the obstruction (gmeow:dischargesDisagreement). It is NOT the math:GluingObstruction itself and NOT a gmeow:ConsensusSection (its H0 dual)."@x-gmeow-english ;
    skos:example "ex:obstruction0 a gmeow:DisagreementObstruction ; gmeow:obstructionClass ex:h1class ; gmeow:obstructionHolonomy ex:cycleHolonomy ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a non-vanishing obstruction as an error (a Condorcet cycle is the LEGAL obstruction, not a bug) and avoid typing the wrapper in the math: namespace."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint a gmeow:DisagreementObstruction wrapping the math:GluingObstruction (gmeow:obstructionClass); when the disagreement is a cycle, also record its non-flat math:Holonomy via gmeow:obstructionHolonomy; a claim asserting a winner must gmeow:dischargesDisagreement it."@x-gmeow-english ;
    gmeow:useWhen "Use for the H1 obstruction-to-gluing wrapper — the computable witness of why consistent local orders may not assemble into one global winner."@x-gmeow-english .

gmeow:obstructionClass
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DisagreementObstruction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "obstruction class"@x-gmeow-english ;
    rdfs:range math:GluingObstruction ;
    skos:definition "Relates a gmeow:DisagreementObstruction wrapper to the math:GluingObstruction (H1) it references — the obstruction-to-gluing class whose vanishing certifies the local orders glue. By link: the wrapper carries audit, the math: object carries the cohomology."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:obstructionHolonomy
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DisagreementObstruction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "obstruction holonomy"@x-gmeow-english ;
    rdfs:range math:Holonomy ;
    skos:definition "Relates a gmeow:DisagreementObstruction to the math:Holonomy of the preference math:connectionOfSheaf that witnesses a Condorcet cycle — the transport around the cycle that does not close (curvature). A flat (trivial-holonomy) connection glues; non-trivial holonomy is exactly the cyclic obstruction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:assertsGlobalWinner
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:PreferenceClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "asserts global winner"@x-gmeow-english ;
    rdfs:range xsd:boolean ;
    skos:definition "A boolean flag recording that a gmeow:PreferenceClaim asserts a candidate is a GLOBAL winner over the whole comparison base (not merely a local, vantage-scoped preference). It is the flag the governing gate watches: a claim carrying gmeow:assertsGlobalWinner true is well-formed ONLY when it gmeow:extendsToConsensusSection over the whole base AND gmeow:dischargesDisagreement (gmeow:NoGlobalWinnerWithoutConsensusConstraint). Absent or false, the claim stands as a vantage-scoped preference only."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extendsToConsensusSection
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "extends to consensus section"@x-gmeow-english ;
    rdfs:range gmeow:ConsensusSection ;
    skos:definition "Relates a gmeow:PreferenceClaim to the gmeow:ConsensusSection its per-vantage orders extend to — the H0 lift over the whole base whose PRESENCE (together with a discharged obstruction) is precisely the condition under which a global winner is legal. It is NOT gmeow:dischargesDisagreement (the H1 half): a claim needs both."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:dischargesDisagreement
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "discharges disagreement"@x-gmeow-english ;
    rdfs:range gmeow:DisagreementObstruction ;
    skos:definition "Relates a gmeow:PreferenceClaim to the gmeow:DisagreementObstruction (H1) it has discharged — the witness whose vanishing certifies the local orders DO glue. A claim asserting a global winner MUST discharge its obstruction: the non-vanishing of H1 (a Condorcet cycle) is exactly the computable reason a winner may fail to exist. It is NOT gmeow:extendsToConsensusSection (the resulting H0 lift); the discharged obstruction is the WHY the lift exists."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Failure vocabulary (typed, queryable violations) ------------------------ #

gmeow:PreferenceConformanceFailure
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Preference Conformance Failure"@x-gmeow-english ;
    skos:definition "The parent of the preference well-formedness failure vocabulary: a violation is itself a typed, queryable object, and each slice logic:Constraint may point at its failure class through gmeow:enforcesFailureClass. Conformance here enforces WELL-FORMEDNESS and the local-vs-global preference discipline, never that any particular candidate truly is best."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:GlobalWinnerWithoutConsensus
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Global Winner Without Consensus"@x-gmeow-english ;
    logic:subClassOf gmeow:PreferenceConformanceFailure ;
    skos:definition "The failure raised when a gmeow:PreferenceClaim asserts a global winner (gmeow:assertsGlobalWinner true) without a typed gmeow:ConsensusSection over the whole vantage base and a discharged gmeow:DisagreementObstruction — the forbidden context-free winner. Enforced by gmeow:NoGlobalWinnerWithoutConsensusConstraint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ProjectionObjectConflation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Projection Object Conflation"@x-gmeow-english ;
    logic:subClassOf gmeow:PreferenceConformanceFailure ;
    skos:definition "The failure raised when a gmeow:PreferenceOrder is itself typed in the math: namespace instead of REFERENCING its raw math:Relation through gmeow:orderRelation — the wrapper conflated with the pure mathematical referent (the semantic-topology ResultObjectConflation twin). Enforced by gmeow:ProjectionObjectConflationConstraint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# The GOVERNING gate: no global winner without a whole-base discharged         #
# consensus (retargeted AssertedTopologyResultConstraint + F2 whole-base       #
# vantage closure). A gmeow:PreferenceClaim with gmeow:assertsGlobalWinner true #
# is well-formed ONLY when it extends to a TYPED gmeow:ConsensusSection whose   #
# gmeow:sectionContext registers no observation the section fails to reconcile, #
# AND discharges a TYPED gmeow:DisagreementObstruction.                         #
# =========================================================================== #
gmeow:NoGlobalWinnerWithoutConsensusConstraint
    a logic:Constraint ;
    rdfs:label "No global winner without a whole-base discharged consensus"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The GOVERNING closed-world integrity constraint: a preference is never automatically a global winner. A gmeow:PreferenceClaim asserting one (gmeow:assertsGlobalWinner true) is well-formed ONLY when it extends its per-vantage orders to a resource TYPED gmeow:ConsensusSection (never a resource that merely carries the edges) which extends to a math:GlobalSection over the whole base, is bound to a gmeow:ComparisonContext, and reconciles EVERY gmeow:PreferenceObservation that context registers (the F2 whole-base vantage closure — a lone or cherry-picked section that omits a registered dissenter fails), AND discharges a resource TYPED gmeow:DisagreementObstruction (the H1 gluing obstruction). A winner asserted without a typed whole-base consensus and a discharged obstruction is the forbidden pattern. A cross-node ∀→∃(∧…∧¬∃) formula, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:PreferenceClaim ;
    gmeow:enforcesFailureClass gmeow:GlobalWinnerWithoutConsensus ;
    logic:severity "Violation" ;
    logic:message "A gmeow:PreferenceClaim asserting a global winner (gmeow:assertsGlobalWinner true) must gmeow:extendsToConsensusSection a resource typed gmeow:ConsensusSection that reconciles every gmeow:PreferenceObservation its gmeow:ComparisonContext registers (whole vantage base, F2) and must gmeow:dischargesDisagreement a resource typed gmeow:DisagreementObstruction; a winner without a typed whole-base discharged consensus is the forbidden context-free winner (gmeow:GlobalWinnerWithoutConsensus)." ;
    logic:integrity gmeow:ngwForall .
gmeow:ngwForall a logic:Formula ;
    rdfs:label "ngwForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): binds ?this and requires ?this is a gmeow:PreferenceClaim ∧ gmeow:assertsGlobalWinner(?this, 'true') → ∃?sec,?ctx,?g. gmeow:ngwBody."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:ngwImpl .
gmeow:ngwImpl a logic:Formula ;
    rdfs:label "ngwImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): when ?this is a gmeow:PreferenceClaim ∧ gmeow:assertsGlobalWinner(?this, 'true') holds, requires ∃?sec,?ctx,?g. gmeow:extendsToConsensusSection(?this, ?sec) ∧ ?sec is a gmeow:ConsensusSection ∧ gmeow:sectionContext(?sec, ?ctx) ∧ gmeow:dischargesDisagreement(?this, ?g) ∧ ?g is a gmeow:DisagreementObstruction ∧ gmeow:ngwWholeBase."@x-gmeow-english ; logic:antecedent gmeow:ngwGuard ; logic:consequent gmeow:ngwDischarged .
gmeow:ngwGuard a logic:Formula ;
    rdfs:label "ngwGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): conjoins ?this is a gmeow:PreferenceClaim ∧ gmeow:assertsGlobalWinner(?this, 'true')."@x-gmeow-english ; logic:and gmeow:ngwType , gmeow:ngwAsserts .
gmeow:ngwType a logic:Formula ;
    rdfs:label "ngwType (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): asserts ?this is a gmeow:PreferenceClaim."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:PreferenceClaim ] .
gmeow:ngwAsserts a logic:Formula ;
    rdfs:label "ngwAsserts (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:assertsGlobalWinner atom ('asserts global winner') of gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): relates ?this, 'true'."@x-gmeow-english ; logic:relation gmeow:assertsGlobalWinner ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "true" ; logic:termLiteralDatatype xsd:boolean ] .
gmeow:ngwDischarged a logic:Formula ;
    rdfs:label "ngwDischarged (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): quantifies ?sec, ?ctx, ?g and requires gmeow:extendsToConsensusSection(?this, ?sec) ∧ ?sec is a gmeow:ConsensusSection ∧ gmeow:sectionContext(?sec, ?ctx) ∧ gmeow:dischargesDisagreement(?this, ?g) ∧ ?g is a gmeow:DisagreementObstruction ∧ ¬[gmeow:ngwHole]."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "sec" ] , [ logic:termIndex 1 ; logic:termVariable "ctx" ] , [ logic:termIndex 2 ; logic:termVariable "g" ] ;
    logic:exists gmeow:ngwBody .
gmeow:ngwBody a logic:Formula ;
    rdfs:label "ngwBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): conjoins gmeow:extendsToConsensusSection(?this, ?sec) ∧ ?sec is a gmeow:ConsensusSection ∧ gmeow:sectionContext(?sec, ?ctx) ∧ gmeow:dischargesDisagreement(?this, ?g) ∧ ?g is a gmeow:DisagreementObstruction ∧ ¬[gmeow:ngwHole]."@x-gmeow-english ;
    logic:and gmeow:ngwExtends , gmeow:ngwSecType , gmeow:ngwSecCtx , gmeow:ngwDischarge , gmeow:ngwObsType , gmeow:ngwWholeBase .
gmeow:ngwExtends a logic:Formula ;
    rdfs:label "ngwExtends (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:extendsToConsensusSection atom ('extends to consensus section') of gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): relates ?this, ?sec."@x-gmeow-english ; logic:relation gmeow:extendsToConsensusSection ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sec" ] .
gmeow:ngwSecType a logic:Formula ;
    rdfs:label "ngwSecType (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): asserts ?sec is a gmeow:ConsensusSection."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sec" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ConsensusSection ] .
gmeow:ngwSecCtx a logic:Formula ;
    rdfs:label "ngwSecCtx (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:sectionContext atom ('section context') of gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): relates ?sec, ?ctx."@x-gmeow-english ; logic:relation gmeow:sectionContext ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sec" ] , [ logic:termIndex 1 ; logic:termVariable "ctx" ] .
gmeow:ngwDischarge a logic:Formula ;
    rdfs:label "ngwDischarge (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:dischargesDisagreement atom ('discharges disagreement') of gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): relates ?this, ?g."@x-gmeow-english ; logic:relation gmeow:dischargesDisagreement ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "g" ] .
gmeow:ngwObsType a logic:Formula ;
    rdfs:label "ngwObsType (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): asserts ?g is a gmeow:DisagreementObstruction."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] , [ logic:termIndex 1 ; logic:termIri gmeow:DisagreementObstruction ] .
# F2: no registered observation is left unreconciled by the section.
gmeow:ngwWholeBase a logic:Formula ;
    rdfs:label "ngwWholeBase (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The negation within gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): holds only when it is NOT the case that ∃?obs. gmeow:registersObservation(?ctx, ?obs) ∧ gmeow:ngwUnreconciled."@x-gmeow-english ; logic:not gmeow:ngwHole .
gmeow:ngwHole a logic:Formula ;
    rdfs:label "ngwHole (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:NoGlobalWinnerWithoutConsensusConstraint (the governing no-context-free-winner gate): quantifies ?obs and requires gmeow:registersObservation(?ctx, ?obs) ∧ ¬[gmeow:reconcilesObservation(?sec, ?obs)]."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "obs" ] ;
    logic:exists gmeow:ngwHoleBody .
gmeow:ngwHoleBody a logic:Formula ;
    rdfs:label "ngwHoleBody (formula AST node)"@x-gmeow-english ;
