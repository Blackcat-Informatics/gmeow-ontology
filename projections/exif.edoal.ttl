@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix exif: <http://www.w3.org/2003/12/exif/ns#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/exif> a align:Alignment ;
    rdfs:label "GMEOW → exif (EDOAL)"@x-gmeow-english ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "captureTime → exif:dateTime"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:captureTime ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri exif:dateTime ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "pixelHeight → exif:height"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:pixelHeight ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri exif:height ] ;
            align:relation "<=" ;
            edoal:measure 9.5e-01 ],
        [ a align:Cell ;
            rdfs:label "imageOrientation → exif:orientation"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:imageOrientation ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri exif:orientation ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "pixelWidth → exif:width"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:pixelWidth ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri exif:width ] ;
            align:relation "<=" ;
            edoal:measure 9.5e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "exif" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@x-gmeow-english .
