# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:analysisFrameFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "analysisFrame is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:analysisFrame is functional: a single music-analysis claim expresses its result within exactly one music-theory reference frame, so an analysis stated against two frames is two distinct claims."@x-gmeow-english ;
    logic:characterizes gmeow:analysisFrame ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:analysisFrame ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:analysisPropertyFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "analysisProperty is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:analysisProperty is functional: each music-analysis claim asserts exactly one analytical dimension (key, harmony, meter, form function, motif identity, mode, tuning, groove, or schema), so a claim ranging over two dimensions is two claims."@x-gmeow-english ;
    logic:characterizes gmeow:analysisProperty ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:analysisProperty ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:analysisResultFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "analysisResult is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:analysisResult is functional: a music-analysis claim carries exactly one result value for its asserted dimension, so a second result value is a second claim."@x-gmeow-english ;
    logic:characterizes gmeow:analysisResult ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:analysisResult ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:analysisTargetFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "analysisTarget is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:analysisTarget is functional: a music-analysis claim is directed at exactly one musical target — one analysis, one target — so analysing a second entity is a separate claim."@x-gmeow-english ;
    logic:characterizes gmeow:analysisTarget ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:analysisTarget ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:anchorDegreeFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "anchorDegree is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:anchorDegree is functional: a PitchAnchor binds exactly one tuning-system degree to its frequency, so the degree it pins is single-valued per anchor."@x-gmeow-english ;
    logic:characterizes gmeow:anchorDegree ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:anchorDegree ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:anchorFrequencyFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "anchorFrequency is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:anchorFrequency is functional: a PitchAnchor assigns exactly one physical frequency to its degree, so a degree pinned to two frequencies would be two anchors, not one."@x-gmeow-english ;
    logic:characterizes gmeow:anchorFrequency ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:anchorFrequency ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:assignedMeterFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "assignedMeter is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:assignedMeter is functional: a MeterAssignment relator ties its carrier to exactly one MetricStructure over its span, so the assigned meter is single-valued per assignment."@x-gmeow-english ;
    logic:characterizes gmeow:assignedMeter ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:assignedMeter ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:assignmentSpanFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "assignmentSpan is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:assignmentSpan is functional: a MeterAssignment holds over exactly one MusicalTimeSpan, so a meter applying across two disjoint spans is two assignments."@x-gmeow-english ;
    logic:characterizes gmeow:assignmentSpan ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:assignmentSpan ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:centsFromOriginFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "centsFromOrigin is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:centsFromOrigin is functional: a PitchExpression has exactly one cents value, generated by fnRatioToCents from its single canonical ratio, so the derived cents measure is single-valued."@x-gmeow-english ;
    logic:characterizes gmeow:centsFromOrigin ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:centsFromOrigin ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:collectionKindFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "collectionKind is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:collectionKind is functional: a PitchCollection is of exactly one kind (scale, mode, maqam, raga, pitch-class set, etc.), with contested or hybrid categorisations modelled as coexisting standpoints rather than as multiple kinds on one collection."@x-gmeow-english ;
    logic:characterizes gmeow:collectionKind ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:collectionKind ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:collectionPartOrderFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "collectionPartOrder is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:collectionPartOrder is functional: a pitch collection occupies exactly one zero-based position within its primary parent collection, so its part order is single-valued, and reuse under other parents at different orders uses per-parent part individuals."@x-gmeow-english ;
    logic:characterizes gmeow:collectionPartOrder ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:collectionPartOrder ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:configurationInstrumentTypeFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "configurationInstrumentType is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:configurationInstrumentType is functional: an InstrumentConfiguration relator applies to exactly one kind of instrument, so the instrument type it targets is single-valued per relator."@x-gmeow-english ;
    logic:characterizes gmeow:configurationInstrumentType ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:configurationInstrumentType ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:configurationIntervalFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "configurationInterval is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:configurationInterval is functional: an InstrumentConfiguration is described by at most one characterising interval, so the interval it names is single-valued per relator (optional, since some modifications alter timbre without a named interval)."@x-gmeow-english ;
    logic:characterizes gmeow:configurationInterval ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:configurationInterval ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:configurationOfFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "configurationOf is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:configurationOf is functional: an InstrumentConfiguration relator applies to exactly one specific instrument item, so the item it configures is single-valued per relator."@x-gmeow-english ;
    logic:characterizes gmeow:configurationOf ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:configurationOf ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:configurationTuningFrameFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "configurationTuningFrame is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:configurationTuningFrame is functional: an InstrumentConfiguration is expressed relative to exactly one tuning frame, so its reference frame is single-valued per relator (Principle 11)."@x-gmeow-english ;
    logic:characterizes gmeow:configurationTuningFrame ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:configurationTuningFrame ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:constraintAppliesToFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "constraintAppliesTo is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:constraintAppliesTo is functional: a TraversalConstraint applies to exactly one work, expression, or performance, so the entity it constrains is single-valued."@x-gmeow-english ;
    logic:characterizes gmeow:constraintAppliesTo ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:constraintAppliesTo ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:controlPointOfTrajectoryFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "controlPointOfTrajectory is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:controlPointOfTrajectory is functional: a PitchTrajectoryControlPoint belongs to exactly one PitchTrajectory, so its owning trajectory is single-valued."@x-gmeow-english ;
    logic:characterizes gmeow:controlPointOfTrajectory ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:controlPointOfTrajectory ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:controlPointOrderFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "controlPointOrder is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:controlPointOrder is functional: a control point occupies exactly one zero-based ordinal position within its PitchTrajectory, so its order index is single-valued."@x-gmeow-english ;
    logic:characterizes gmeow:controlPointOrder ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:controlPointOrder ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:controlPointPitchFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "controlPointPitch is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:controlPointPitch is functional: a control point carries exactly one frame-relative PitchValue, so the pitch it fixes is single-valued."@x-gmeow-english ;
    logic:characterizes gmeow:controlPointPitch ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:controlPointPitch ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:controlPointTimeFrameFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "controlPointTimeFrame is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:controlPointTimeFrame is functional: a control point's time position is expressed in exactly one MusicalTimeFrame, so the time frame it is read against is single-valued."@x-gmeow-english ;
    logic:characterizes gmeow:controlPointTimeFrame ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:controlPointTimeFrame ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:controlPointTimePositionDenominatorFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "controlPointTimePositionDenominator is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:controlPointTimePositionDenominator is functional: the rational time position of a control point has exactly one denominator, so this component of its position is single-valued per control point."@x-gmeow-english ;
    logic:characterizes gmeow:controlPointTimePositionDenominator ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:controlPointTimePositionDenominator ;
    gmeow:graphBoxRole gmeow:boxABox .

