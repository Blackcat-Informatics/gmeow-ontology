#
# Declarative structural assertions for the deception slice --
# the slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT
# invariants formerly hand-written in tests/test_deception.py. Each assertion
# runs as a SPARQL ASK over the deception module graph (gmeow:scopeModule)
# under the native Rust harness (crates/slicetest).
#
# Deception is migrated: class stereotypes are logic:
# (logic:AbstractIndividualType, logic:QualityValue), not gufo:.
#
# The SHACL / example-conformance and dynamic ABox checks live natively in
# crates/validate/tests/conformance_cases/conformance_deception.rs (fixture cases + GraphStore
# example-membership and cross-slice vocabulary twins):
#   standpoint_divergence_coexists, deception_event_shacl_passes,
#   deception_cue_shacl_passes, paltering_implicates_structure,
#   self_deception_same_agent, distortion_shacl_passes,
#   fabrication_refuted_provenance, forgery_failed_signature_structure,
#   impersonation_facet_subject_mismatch, disinformation_propagation_chain,
#   licensed_falsehood_conforms + licensed_falsehood_vocab,
#   blame_deflection_example_doxastic_claims.
# gmeow:bullshit (a SUBJECT of slices/core/standpoint/module.ttl) is covered by
# slices/core/standpoint/tests/structural.ttl; the disinformation-boundary
# competency query is covered by slices/core/deception/tests/competency.ttl.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/deception/tests/> .

# --- 1. eventTypeDeception is an EventType individual (MUST) ------------------
ex:saDeceptionEventTypeExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:eventTypeDeception a gmeow:EventType . }""" ;
    gmeow:saRationale "gmeow:eventTypeDeception MUST exist as a gmeow:EventType individual -- deception-kind is an open value vocabulary, never a subclass (events.ttl doctrine)." .

# --- 2. heldStandpoint is an ObjectProperty with domain Event and range
#        DoxasticStandpointClaim (MUST) ----------------------------------------
ex:saHeldStandpointProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:heldStandpoint a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:DoxasticStandpointClaim .
}""" ;
    gmeow:saRationale "gmeow:heldStandpoint MUST be an owl:ObjectProperty with domain gmeow:Event and range gmeow:DoxasticStandpointClaim -- the private-belief half of the held!=projected deception divergence." .

# --- 3. projectedStandpoint is an ObjectProperty with domain Event and range
#        DoxasticStandpointClaim (MUST) ----------------------------------------
ex:saProjectedStandpointProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:projectedStandpoint a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:DoxasticStandpointClaim .
}""" ;
    gmeow:saRationale "gmeow:projectedStandpoint MUST be an owl:ObjectProperty with domain gmeow:Event and range gmeow:DoxasticStandpointClaim -- the communicated-position half of the held!=projected deception divergence." .

# --- 4. deceptiveIntentClaim property shape (MUST) ----------------------------
ex:saDeceptiveIntentClaimProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:deceptiveIntentClaim a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:StandpointClaim .
}""" ;
    gmeow:saRationale "gmeow:deceptiveIntentClaim MUST be an owl:ObjectProperty with domain gmeow:Event and range gmeow:StandpointClaim -- intent is a defeasible, attributed standpoint claim, never an entailed boolean (Principle 9)." .

# --- 5. implicates property shape (MUST) --------------------------------------
ex:saImplicatesProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:implicates a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:implicates MUST be an owl:ObjectProperty with domain gmeow:Event and range gmeow:Entity -- the paltering hook; implicature computation is solver-layer (Principle 12)." .

# --- 6. deceptionCue property shape (MUST) ------------------------------------
ex:saDeceptionCueProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:deceptionCue a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:Observation .
}""" ;
    gmeow:saRationale "gmeow:deceptionCue MUST be an owl:ObjectProperty with domain gmeow:Event and range gmeow:Observation -- each cue carries its own vantage and method rather than being a bare fact." .

# --- 7. The four core deception roles exist as ParticipantRole individuals
#        (MUST) ----------------------------------------------------------------
ex:saDeceptionRolesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:roleDeceiver                a gmeow:ParticipantRole .
    gmeow:roleDeceived                a gmeow:ParticipantRole .
    gmeow:roleBeneficiaryOfDeception  a gmeow:ParticipantRole .
    gmeow:roleDupe                    a gmeow:ParticipantRole .
}""" ;
    gmeow:saRationale "The four core deception roles (deceiver, deceived, beneficiary, dupe) MUST exist as gmeow:ParticipantRole individuals -- they cover the principal positions in any deception event." .

# --- 8. ClaimVeridicality is a logic:AbstractIndividualType value vocabulary
#        subclassing logic:QualityValue (MUST) -----------------------------------
ex:saClaimVeridicalityClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ClaimVeridicality a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:ClaimVeridicality MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- veridicality is an open value vocabulary of individuals, never subclasses (Principle 9)." .

# --- 9. The two required ClaimVeridicality seed individuals exist (MUST) ------
ex:saClaimVeridicalitySeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:veridicalityUntrue           a gmeow:ClaimVeridicality .
    gmeow:veridicalityLicensedFalsehood a gmeow:ClaimVeridicality .
}""" ;
    gmeow:saRationale "Both seed individuals (veridicalityUntrue, veridicalityLicensedFalsehood) MUST exist as gmeow:ClaimVeridicality instances -- they anchor the licensed-falsehood safety property that separates fiction from deception." .

# --- 10. attestationTypeFactCheck exists as an AttestationType (MUST) ---------
ex:saAttestationTypeFactCheck a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:attestationTypeFactCheck a gmeow:AttestationType . }""" ;
    gmeow:saRationale "gmeow:attestationTypeFactCheck MUST exist as a gmeow:AttestationType individual -- models the schema.org ClaimReview act (result is a VerificationResult, never a global truth assertion; Principle 12)." .

# --- 11. No isFalse property declared as ObjectProperty (MUST-NOT) -----------
ex:saNoIsFalseObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:isFalse a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:isFalse MUST NOT be declared an owl:ObjectProperty -- a falsehood is a refuted StandpointClaim modality, never a boolean flag (Principles 1, 12; no-isFalse doctrine)." .

