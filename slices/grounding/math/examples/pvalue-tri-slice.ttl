#
# The signature lang: -> logic: -> math: round-trip, worked as one grounded scene: the
# English sentence "the p-value was 0.03" grounded UP the stack into a canonical,
# reasoning-facing math:PValue with a framed measure. The load-bearing shape is that this
# is ONE connected chain, not three disconnected islands:
#
#   lang:  a lang:SurfaceForm ("the p-value was 0.03") lang:realizes an analyzed
#          lang:ComposedForm; a lang:Denotation whose lang:denotationKind is
#          lang:denotesLogicFormula carries the meaning, and its lang:denotationTarget is a
#          SPECIFIC logic:Formula (the one-way bridge into logic:). The round-trip preserves
#          the assertion exactly, recorded HONESTLY as logic:ExactPreservation on the
#          denotation (the math-producer inline-preservation convention, reused verbatim
#          from the logic: loss ledger).
#   logic: that logic:Formula is an atomic predication (logic:relation over ordered
#          logic:argument term-carriers); its first argument's logic:termIri is the SPECIFIC
#          math:PValue — the logic -> math crossing triple.
#   math:  the math:PValue carries its WHOLE frame, so it is unambiguous and passes
#          math:IllFramedPValue: a math:testStatistic, a math:nullHypothesis, a parameterized
#          math:nullDistribution (a math:SamplingDistribution: normal family + mean/stddev
#          parameterization), a math:alternativeSidedness that IS one of the six lawful
#          math:Sidedness values (math:twoSidedAlternative), and math:pValue -> a framed
#          math:ProbabilityValue (exact 3/100 = 0.03, in [0, 1]). It honours the process /
#          result / claim spine: a math:InferenceRun produced it (gmeow:wasGeneratedBy) and a
#          gmeow:Observation holds the claim about it from a gmeow:vantage.
#
# Doc-rendered on disk; the SAME chain also rides inside gmeow.gts through the native
# gmeow_math::producers::pvalue_tri_slice producer (Design A). Conformance twin:
# tests/conformance-fixtures/pvalue-tri-slice.ttl; the ill-framed foil that drops the tail /
# sidedness is tests/counter-examples/pvalue-tri-slice-illframed.ttl.
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/math/statistics/> .

# --- lang: the sentence as a surface realizing an analyzed composed form ------ #

ex:english a lang:SignSystem ;
    lang:signSystemKind lang:naturalLanguageKind ;
    lang:modality lang:writtenModality .
ex:latinScript a lang:Script .

# The four word forms of "the p-value was 0.03".
ex:wfThe       a lang:WordForm ; lang:inSignSystem ex:english .
ex:wfPValue    a lang:WordForm ; lang:inSignSystem ex:english .
ex:wfWas       a lang:WordForm ; lang:inSignSystem ex:english .
ex:wfMagnitude a lang:WordForm ; lang:inSignSystem ex:english .

# The analyzed composed form: one analysis over four zero-based contiguous slots.
ex:pvalueAnalysis a lang:Analysis .
ex:pvalueSentence a lang:ComposedForm ;
    lang:inSignSystem ex:english ;
    lang:compositionLevel lang:sentenceLevel ;
    lang:inAnalysis ex:pvalueAnalysis ;
    lang:formHead ex:wfWas ;
    lang:formSlot ex:slot0 , ex:slot1 , ex:slot2 , ex:slot3 .

ex:slot0 a lang:FormSlot ; lang:inAnalysis ex:pvalueAnalysis ; lang:slotIndex 0 ;
    lang:slotForm ex:wfThe ; lang:slotRole lang:subjectRole ; lang:dependsOn ex:slot1 .
ex:slot1 a lang:FormSlot ; lang:inAnalysis ex:pvalueAnalysis ; lang:slotIndex 1 ;
    lang:slotForm ex:wfPValue ; lang:slotRole lang:subjectRole ; lang:dependsOn ex:slot2 .
ex:slot2 a lang:FormSlot ; lang:inAnalysis ex:pvalueAnalysis ; lang:slotIndex 2 ;
    lang:slotForm ex:wfWas ; lang:slotRole lang:predicateRole .
ex:slot3 a lang:FormSlot ; lang:inAnalysis ex:pvalueAnalysis ; lang:slotIndex 3 ;
    lang:slotForm ex:wfMagnitude ; lang:slotRole lang:objectRole ; lang:dependsOn ex:slot2 .

# The concrete surface: the parsed text, realizing the composed form.
ex:pvalueSurface a lang:SurfaceForm ;
    lang:inSignSystem ex:english ;
    lang:surfaceText "the p-value was 0.03" ;
    lang:inScript ex:latinScript ;
    lang:encoding "UTF-8" ;
    lang:unicodeNormalization "NFC" ;
    lang:collationLocale "en" ;
    lang:analysisLevel lang:parsedLevel ;
    lang:realizes ex:pvalueSentence .

# The assertion act: an assertion lowers to an asserted logic: formula.
ex:pvalueAssertion a lang:CommunicativeAct ;
    lang:performedOn ex:pvalueSentence ;
    lang:communicativeForce lang:assertForce .

# --- lang -> logic: the denotation whose target IS the logic:Formula ---------- #

ex:pvalueDenotation a lang:Denotation ;
    lang:denotedForm ex:pvalueSentence ;
    lang:denotationKind lang:denotesLogicFormula ;
    lang:denotationTarget ex:pvalueFormula ;
    lang:denotationContext ex:samplingReportContext ;
    lang:isIndexical false ;
    logic:preservationKind logic:ExactPreservation .

# --- logic -> math: the atomic predication whose first argument IS the p-value  #

ex:pvalueFormula a logic:Formula ;
    logic:relation ex:pValueMagnitudeOfRelation ;
    logic:argument ex:argPValue , ex:argMagnitude .
ex:pValueMagnitudeOfRelation a logic:Type .
ex:argPValue logic:termIndex 0 ; logic:termIri ex:tTestPValue .
ex:argMagnitude logic:termIndex 1 ; logic:termIri ex:pValueMagnitude .

# --- math: the well-framed p-value the formula predicates over ---------------- #

ex:tTestPValue a math:PValue ;
    math:testStatistic ex:tStatistic ;
    math:nullHypothesis ex:noEffectNull ;
    math:nullDistribution ex:tNullDistribution ;
    math:alternativeSidedness math:twoSidedAlternative ;
    math:pValue ex:pValueMagnitude ;
    gmeow:wasGeneratedBy ex:inferenceRun .

ex:tStatistic a math:Statistic .
ex:noEffectNull a math:NullHypothesis .

# The null distribution: a parameterized sampling distribution.
ex:tNullDistribution a math:SamplingDistribution ;
    math:distributionFamily ex:normalFamily ;
    math:distributionParameterization ex:meanStddevParameterization ;
    math:hasDistributionParameter ex:meanParam , ex:stddevParam .

ex:normalFamily a math:DistributionFamily .
ex:meanStddevParameterization a math:DistributionParameterization ;
    math:requiresParameterRole ex:meanRole , ex:stddevRole .
ex:meanRole a math:DistributionParameterRole .
ex:stddevRole a math:DistributionParameterRole .
ex:meanParam a math:DistributionParameter ; math:parameterRole ex:meanRole .
ex:stddevParam a math:DistributionParameter ; math:parameterRole ex:stddevRole .

# The magnitude: a framed exact-rational probability value, 3/100 = 0.03 in [0, 1].
ex:pValueMagnitude a math:ProbabilityValue , math:RationalValue ;
    math:numerator 3 ;
    math:denominator 100 ;
    gmeow:hasReferenceFrame ex:samplingFrame .
ex:samplingFrame a gmeow:ReferenceFrame .

# --- The process / result / claim spine --------------------------------------- #

ex:inferenceRun a math:InferenceRun , gmeow:Activity ;
    math:fittedToData ex:sampleData .
ex:sampleData a math:DatasetMatrix .

ex:pvalueObservation a gmeow:Observation ;
    gmeow:vantage ex:analystStandpoint ;
    gmeow:observedFeature ex:tTestPValue ;
    gmeow:observationResult ex:tTestPValue ;
    gmeow:wasGeneratedBy ex:inferenceRun .
ex:analystStandpoint a gmeow:Standpoint .
<https://blackcatinformatics.ca/gmeow/examples/math/statistics/pValueMagnitude> <https://blackcatinformatics.ca/math/hasDimension> <https://blackcatinformatics.ca/math/dimensionless> .
