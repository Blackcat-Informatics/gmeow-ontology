    logic:formalizes gmeow:equationSource ;
    logic:message "Every supplied equation-source string has a retained language surface carrying that exact text. Retention does not parse the string or certify mathematical meaning." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "text" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation gmeow:equationSource ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                    [ logic:termIndex 1 ; logic:termVariable "text" ] ] ;
            logic:consequent [ a logic:Formula ;
                logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "surface" ] ;
                logic:exists [ a logic:Formula ; logic:and
                    [ a logic:Formula ; logic:relation gmeow:blockSurface ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
