    gmeow:virtualLocationType a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:VirtualLocationType MUST be a subclass of logic:QualityValue and gmeow:virtualLocationType MUST be an owl:ObjectProperty. Mirrors test_virtual_location_type_is_value_not_subclass (positive part)." .

# --- 67. virtualLocationType is NOT functional (MUST-NOT) ---------------------
ex:saVirtualLocationTypeNotFunctional a gmeow:StructuralAssertion ;
