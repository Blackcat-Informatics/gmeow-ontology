    skos:definition "The release lane's signed re-emission. It re-authors an already-assembled carrier under a signing key rather than re-running the terminal's rep→medium assignment, so it is a whole-artifact producer: one medium governs the artifact it signs."@x-gmeow-english ;
    gmeow:producerCallSite "crates/pipeline/src/stages/release.rs" ;
    gmeow:producerMedium gmeow:mediumProfileBaselineL12 ;
