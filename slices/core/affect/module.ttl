    skos:definition "A closed-world integrity constraint: a gmeow:DerivedAffectIntensityObservation carries no stored gmeow:appraisalValue magnitude."@x-gmeow-english ;
    logic:formalizes gmeow:DerivedAffectIntensityObservation , gmeow:DerivedAffectIntensityObservationShape ;
    logic:message "A derived affect intensity must NOT carry a stored magnitude (gmeow:appraisalValue) — the norm is a recomputable derived view, never a stored ground fact (Principle 12); a stored intensity value is a hard fail." ;
    logic:integrity logic:dnmForall .
logic:dnmForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:dnmImpl .
logic:dnmImpl a logic:Formula ; logic:antecedent logic:dnmGuard ; logic:consequent logic:dnmNot .
logic:dnmGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:DerivedAffectIntensityObservation ] .
logic:dnmNot a logic:Formula ; logic:not logic:dnmExists .
logic:dnmExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "v" ] ;
    logic:exists logic:dnmAtom .
logic:dnmAtom a logic:Formula ; logic:relation gmeow:appraisalValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .

# A classifier label must not be modeled as a gmeow:EmotionType.
gmeow:AffectClassifierLabelNotEmotionTypeConstraint
    a logic:Constraint ;
    rdfs:label "AffectClassifierLabel not-EmotionType constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:AffectClassifierLabel is not also a gmeow:EmotionType."@x-gmeow-english ;
    logic:formalizes gmeow:AffectClassifierLabel , gmeow:AffectClassifierLabelShape ;
    logic:message "A classifier label must not be modeled as a gmeow:EmotionType — 'neutral' (or any no-detected-affect label) as an EmotionType is a hard fail; labels are external identities, never canonical emotion vocabulary." ;
    logic:integrity logic:lneForall .
logic:lneForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:lneImpl .
logic:lneImpl a logic:Formula ; logic:antecedent logic:lneGuard ; logic:consequent logic:lneNot .
logic:lneGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:AffectClassifierLabel ] .
logic:lneNot a logic:Formula ; logic:not logic:lneEmotion .
logic:lneEmotion a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:EmotionType ] .

# A calibrated-probability score requires a gmeow:scoreCalibration profile.
gmeow:AffectClassifierOutputCalibrationConstraint
    a logic:Constraint ;
    rdfs:label "AffectClassifierOutput calibration constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:AffectClassifierOutput whose gmeow:scoreSemantics is gmeow:scoreCalibratedProbability declares a gmeow:scoreCalibration."@x-gmeow-english ;
    logic:formalizes gmeow:AffectClassifierOutput , gmeow:AffectClassifierOutputShape ;
    logic:message "A score claimed as a calibrated probability requires a gmeow:scoreCalibration profile — a raw sigmoid/softmax score stored as a confidence without calibration metadata is a hard fail (confidence is not a probability without a declared mapping)." ;
    logic:integrity logic:occForall .
logic:occForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:occImpl .
logic:occImpl a logic:Formula ; logic:antecedent logic:occGuard ; logic:consequent logic:occExists .
logic:occGuard a logic:Formula ; logic:and logic:occType , logic:occSem .
logic:occType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:AffectClassifierOutput ] .
logic:occSem a logic:Formula ; logic:relation gmeow:scoreSemantics ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:scoreCalibratedProbability ] .
logic:occExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "c" ] ;
    logic:exists logic:occAtom .
logic:occAtom a logic:Formula ; logic:relation gmeow:scoreCalibration ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] .

# A classifier output must not directly assert inner affect (emotionType / emotionBearer).
gmeow:AffectClassifierOutputNoInnerAffectConstraint
    a logic:Constraint ;
    rdfs:label "AffectClassifierOutput no-inner-affect constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:AffectClassifierOutput asserts neither gmeow:emotionType nor gmeow:emotionBearer directly."@x-gmeow-english ;
    logic:formalizes gmeow:AffectClassifierOutput , gmeow:AffectClassifierOutputShape ;
    logic:message "A classifier output must not directly assert inner affect (gmeow:emotionType / gmeow:emotionBearer) — it supports a gmeow:AffectiveClaim by gmeow:supportsAffectiveClaim (evidence, never entailment); asserting inner affect without the claim boundary is a hard fail." ;
    logic:integrity logic:oiaForall .
logic:oiaForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:oiaImpl .
logic:oiaImpl a logic:Formula ; logic:antecedent logic:oiaGuard ; logic:consequent logic:oiaNot .
logic:oiaGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:AffectClassifierOutput ] .
logic:oiaNot a logic:Formula ; logic:not logic:oiaOr .
logic:oiaOr a logic:Formula ; logic:or logic:oiaType , logic:oiaBearer .
logic:oiaType a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "e" ] ;
    logic:exists logic:oiaTypeAtom .
logic:oiaTypeAtom a logic:Formula ; logic:relation gmeow:emotionType ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "e" ] .
logic:oiaBearer a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "b" ] ;
    logic:exists logic:oiaBearerAtom .
logic:oiaBearerAtom a logic:Formula ; logic:relation gmeow:emotionBearer ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .

# The named appraisal scale profile must actually be a gmeow:AffectScaleProfile.
gmeow:AppraisalScaleProfileIsProfileConstraint
    a logic:Constraint ;
    rdfs:label "Appraisal scale-profile is-a-profile constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:appraisalScaleProfile value of a gmeow:Appraisal is a gmeow:AffectScaleProfile."@x-gmeow-english ;
    logic:formalizes gmeow:Appraisal , gmeow:AppraisalShape ;
    logic:message "gmeow:appraisalScaleProfile names exactly one gmeow:AffectScaleProfile IRI — never a literal, a blank node, or a non-profile IRI (the reshape's frame must actually be a frame, Principle 6)." ;
    logic:integrity logic:aspForall .
logic:aspForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] ;
    logic:forall logic:aspImpl .
logic:aspImpl a logic:Formula ; logic:antecedent logic:aspGuard ; logic:consequent logic:aspClass .
logic:aspGuard a logic:Formula ; logic:and logic:aspType , logic:aspProfile .
logic:aspType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Appraisal ] .
logic:aspProfile a logic:Formula ; logic:relation gmeow:appraisalScaleProfile ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .
logic:aspClass a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termIri gmeow:AffectScaleProfile ] .

# An AffectScaleProfile range is non-degenerate: max strictly exceeds min.
gmeow:AffectScaleProfileRangeConstraint
    a logic:Constraint ;
    rdfs:label "AffectScaleProfile range constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:AffectScaleProfile has gmeow:profileRangeMax strictly greater than gmeow:profileRangeMin."@x-gmeow-english ;
    logic:formalizes gmeow:AffectScaleProfile , gmeow:AffectScaleProfileShape ;
    logic:message "An AffectScaleProfile is degenerate: gmeow:profileRangeMax must strictly exceed gmeow:profileRangeMin — an inverted or empty range frames nothing (Principle 11)." ;
    logic:integrity logic:prxForall .
logic:prxForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "min" ] , [ logic:termIndex 2 ; logic:termVariable "max" ] ;
    logic:forall logic:prxImpl .
logic:prxImpl a logic:Formula ; logic:antecedent logic:prxGuard ; logic:consequent logic:prxGt .
logic:prxGuard a logic:Formula ; logic:and logic:prxType , logic:prxMin , logic:prxMax .
logic:prxType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:AffectScaleProfile ] .
logic:prxMin a logic:Formula ; logic:relation gmeow:profileRangeMin ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "min" ] .
logic:prxMax a logic:Formula ; logic:relation gmeow:profileRangeMax ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "max" ] .
logic:prxGt a logic:Formula ; logic:relation logic:termGreater ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "max" ] , [ logic:termIndex 1 ; logic:termVariable "min" ] .

# A gmeow:AffectDecision may only be recorded over a single-label (decisionArgmax) label set.
gmeow:AffectDecisionSingleLabelConstraint
    a logic:Constraint ;
    rdfs:label "AffectDecision single-label constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world relational integrity constraint: a gmeow:AffectDecision's decided label belongs to a label set whose gmeow:labelSetDecision is gmeow:decisionArgmax."@x-gmeow-english ;
    logic:formalizes gmeow:AffectDecision , gmeow:AffectDecisionShape ;
    logic:message "A gmeow:AffectDecision may only be recorded over a single-label (gmeow:decisionArgmax) label set — a categorical argmax decision over a multi-label set has no single winner (a hard fail)." ;
    logic:integrity logic:dslForall .
logic:dslForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "label" ] , [ logic:termIndex 2 ; logic:termVariable "set" ] , [ logic:termIndex 3 ; logic:termVariable "rule" ] ;
    logic:forall logic:dslImpl .
logic:dslImpl a logic:Formula ; logic:antecedent logic:dslGuard ; logic:consequent logic:dslEq .
logic:dslGuard a logic:Formula ; logic:and logic:dslType , logic:dslDecided , logic:dslMember , logic:dslDecision .
logic:dslType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:AffectDecision ] .
logic:dslDecided a logic:Formula ; logic:relation gmeow:decidedLabel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "label" ] .
logic:dslMember a logic:Formula ; logic:relation gmeow:memberOfLabelSet ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "label" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] .
logic:dslDecision a logic:Formula ; logic:relation gmeow:labelSetDecision ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "set" ] , [ logic:termIndex 1 ; logic:termVariable "rule" ] .
logic:dslEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "rule" ] , [ logic:termIndex 1 ; logic:termIri gmeow:decisionArgmax ] .

# A classifier output's score semantics must match its emitted label's set decision rule.
gmeow:AffectDecisionRuleConsistencyConstraint
    a logic:Constraint ;
    rdfs:label "AffectDecision rule-consistency constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world relational integrity constraint: a gmeow:AffectClassifierOutput's gmeow:scoreSemantics gmeow:impliesLabelSetDecision matches its emitted label's set gmeow:labelSetDecision."@x-gmeow-english ;
    logic:formalizes gmeow:AffectClassifierOutput , gmeow:AffectDecisionRuleConsistencyShape ;
    logic:message "A classifier output's gmeow:scoreSemantics implies a label-set decision rule (softmax → argmax, sigmoid → independent-threshold) that MUST match its emitted label's set gmeow:labelSetDecision — a softmax score over a multi-label set (or a sigmoid over an exclusive set) is an inconsistency (a hard fail)." ;
    logic:integrity logic:drcForall .
logic:drcForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sem" ] , [ logic:termIndex 2 ; logic:termVariable "label" ] , [ logic:termIndex 3 ; logic:termVariable "implied" ] , [ logic:termIndex 4 ; logic:termVariable "set" ] , [ logic:termIndex 5 ; logic:termVariable "declared" ] ;
    logic:forall logic:drcImpl .
logic:drcImpl a logic:Formula ; logic:antecedent logic:drcGuard ; logic:consequent logic:drcEq .
logic:drcGuard a logic:Formula ; logic:and logic:drcType , logic:drcSem , logic:drcLabel , logic:drcImplies , logic:drcMember , logic:drcDecision .
logic:drcType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:AffectClassifierOutput ] .
logic:drcSem a logic:Formula ; logic:relation gmeow:scoreSemantics ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sem" ] .
logic:drcLabel a logic:Formula ; logic:relation gmeow:emittedLabel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "label" ] .
logic:drcImplies a logic:Formula ; logic:relation gmeow:impliesLabelSetDecision ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sem" ] , [ logic:termIndex 1 ; logic:termVariable "implied" ] .
logic:drcMember a logic:Formula ; logic:relation gmeow:memberOfLabelSet ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "label" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] .
logic:drcDecision a logic:Formula ; logic:relation gmeow:labelSetDecision ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "set" ] , [ logic:termIndex 1 ; logic:termVariable "declared" ] .
logic:drcEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "implied" ] , [ logic:termIndex 1 ; logic:termVariable "declared" ] .

# At most one AffectiveClaim over one target from a single-label (argmax) classifier run.
gmeow:ExclusiveAffectiveClaimConstraint
    a logic:Constraint ;
    rdfs:label "Exclusive affective claim constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world relational integrity constraint: no two distinct gmeow:AffectiveClaims over the same target are supported by outputs of one classifier run whose emitted labels share a single-label (gmeow:decisionArgmax) set."@x-gmeow-english ;
    logic:formalizes gmeow:AffectiveClaim , gmeow:ExclusiveClaimShape ;
    logic:message "At most one gmeow:AffectiveClaim may be routed over one target from a single-label (gmeow:decisionArgmax) classifier run — a threshold policy admitting two mutually-exclusive claims over an exclusive label set is a hard fail." ;
    logic:integrity logic:eccForall .
logic:eccForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:eccImpl .
logic:eccImpl a logic:Formula ; logic:antecedent logic:eccGuard ; logic:consequent logic:eccNot .
logic:eccGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:AffectiveClaim ] .
logic:eccNot a logic:Formula ; logic:not logic:eccExists .
logic:eccExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "target" ] , [ logic:termIndex 1 ; logic:termVariable "out1" ] , [ logic:termIndex 2 ; logic:termVariable "run" ] , [ logic:termIndex 3 ; logic:termVariable "l1" ] , [ logic:termIndex 4 ; logic:termVariable "set" ] , [ logic:termIndex 5 ; logic:termVariable "other" ] , [ logic:termIndex 6 ; logic:termVariable "out2" ] , [ logic:termIndex 7 ; logic:termVariable "l2" ] ;
    logic:exists logic:eccBody .
logic:eccBody a logic:Formula ; logic:and
    logic:eccObs , logic:eccSupports1 , logic:eccProduced1 , logic:eccEmitted1 , logic:eccMember1 , logic:eccArgmax ,
    logic:eccOtherType , logic:eccOtherObs , logic:eccDistinct , logic:eccSupports2 , logic:eccProduced2 , logic:eccEmitted2 , logic:eccMember2 .
logic:eccObs a logic:Formula ; logic:relation gmeow:observedFeature ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "target" ] .
logic:eccSupports1 a logic:Formula ; logic:relation gmeow:supportsAffectiveClaim ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out1" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:eccProduced1 a logic:Formula ; logic:relation gmeow:producedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out1" ] , [ logic:termIndex 1 ; logic:termVariable "run" ] .
logic:eccEmitted1 a logic:Formula ; logic:relation gmeow:emittedLabel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out1" ] , [ logic:termIndex 1 ; logic:termVariable "l1" ] .
logic:eccMember1 a logic:Formula ; logic:relation gmeow:memberOfLabelSet ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "l1" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] .
logic:eccArgmax a logic:Formula ; logic:relation gmeow:labelSetDecision ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "set" ] , [ logic:termIndex 1 ; logic:termIri gmeow:decisionArgmax ] .
logic:eccOtherType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termIri gmeow:AffectiveClaim ] .
logic:eccOtherObs a logic:Formula ; logic:relation gmeow:observedFeature ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "target" ] .
logic:eccDistinct a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:eccSupports2 a logic:Formula ; logic:relation gmeow:supportsAffectiveClaim ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out2" ] , [ logic:termIndex 1 ; logic:termVariable "other" ] .
logic:eccProduced2 a logic:Formula ; logic:relation gmeow:producedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out2" ] , [ logic:termIndex 1 ; logic:termVariable "run" ] .
logic:eccEmitted2 a logic:Formula ; logic:relation gmeow:emittedLabel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out2" ] , [ logic:termIndex 1 ; logic:termVariable "l2" ] .
logic:eccMember2 a logic:Formula ; logic:relation gmeow:memberOfLabelSet ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "l2" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] .

# A dimensional value needs its dimension (and a dimension its value): the co-occurrence obligation
# over the (gmeow:appraisalValue, gmeow:appraisalDimension) pair, authored as the two projectable
# guarded-implication halves (value → dimension, dimension → value). The equivalent nested-universal
# raw form has no bounded SPARQL BGP image (it would be carried as unsupported residue and lose SHACL
# enforcement), and the cross-node co-occur sugar's positive lowering mis-nests FILTER NOT EXISTS
# under UNION; two guarded implications lower faithfully to a guarded FILTER NOT EXISTS each.
gmeow:AppraisalDimensionRequiresValueConstraint
    a logic:GuardedImplicationConstraint ;
    rdfs:label "Appraisal dimension-requires-value constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Appraisal carrying a gmeow:appraisalDimension also carries a gmeow:appraisalValue."@x-gmeow-english ;
    logic:onClass gmeow:Appraisal ;
    logic:trigger gmeow:appraisalDimension ;
    logic:requires gmeow:appraisalValue ;
    logic:formalizes gmeow:Appraisal , gmeow:AppraisalShape ;
    logic:message "A dimensional value needs its dimension (and a dimension its value) — half a reading is no reading." .

gmeow:AppraisalValueRequiresDimensionConstraint
    a logic:GuardedImplicationConstraint ;
    rdfs:label "Appraisal value-requires-dimension constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Appraisal carrying a gmeow:appraisalValue also carries a gmeow:appraisalDimension."@x-gmeow-english ;
    logic:onClass gmeow:Appraisal ;
    logic:trigger gmeow:appraisalValue ;
    logic:requires gmeow:appraisalDimension ;
    logic:formalizes gmeow:Appraisal , gmeow:AppraisalShape ;
    logic:message "A dimensional value needs its dimension (and a dimension its value) — half a reading is no reading." .

# =========================================================================== #
# Migrated procedural constraints (#1194): the closed-world Emotion              #
# well-formedness shapes from shapes/gmeow-shapes.ttl (Principle 17).            #
# =========================================================================== #

gmeow:EmotionTypeConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Emotion type-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Emotion carries a gmeow:emotionType."@x-gmeow-english ;
    logic:onClass gmeow:Emotion ;
    logic:anyOf gmeow:emotionType ;
    logic:formalizes gmeow:Emotion ;
    logic:message "An Emotion must carry at least one gmeow:emotionType (an IRI — the vocabulary is OPEN per Principle 9: blended emotions and rival traditions coexist)." .

gmeow:EmotionBearerConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Emotion bearer-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Emotion inheres in a gmeow:emotionBearer."@x-gmeow-english ;
    logic:onClass gmeow:Emotion ;
    logic:anyOf gmeow:emotionBearer ;
    logic:formalizes gmeow:Emotion ;
    logic:message "An Emotion must inhere in exactly one gmeow:emotionBearer (an intrinsic mode has exactly one bearer)." .

