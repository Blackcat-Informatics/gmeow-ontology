gmeow:RankedEntryOwnerConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Ranked entry owner constraint"@x-gmeow-english ;
    skos:definition "Every ranked entry belongs to exactly one ranked-list occurrence; reusing a candidate in another list requires another entry."@x-gmeow-english ;
    gmeow:useWhen "Use for ranked entry owner constraint with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
