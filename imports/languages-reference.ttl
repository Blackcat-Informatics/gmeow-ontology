@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix wd:    <http://www.wikidata.org/entity/> .

<https://blackcatinformatics.ca/gmeow/imports/languages-reference>
    a owl:Ontology ;
    rdfs:label "GMEOW Languages Reference Catalog"@x-gmeow-english ;
    skos:definition "Standard natural and programming languages for GMEOW reuse, pre-seeding internal tags, appellations, and alignments."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> ;
    rdfs:comment "Standard natural and programming languages for GMEOW reuse, pre-seeding internal tags, appellations, and alignments."@x-gmeow-english .

# =========================================================================== #
# Writing Systems (Scripts)
# =========================================================================== #

gmeow:wsLatin a gmeow:WritingSystem ;
    rdfs:label "Latin writing system"@x-gmeow-english ;
    skos:definition "The Latin alphabet script used for English, German, Spanish, French, and romanizations."@x-gmeow-english ;
    gmeow:scriptCode "Latn" ;
    gmeow:writingSystemType gmeow:wsTypeAlphabet ;
    gmeow:textDirection gmeow:directionLtr ;
    skos:exactMatch wd:Q8229 ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> .

gmeow:wsHan a gmeow:WritingSystem ;
    rdfs:label "Han writing system"@x-gmeow-english ;
    skos:definition "The logographic Chinese character writing system used for Chinese and Japanese Kanji."@x-gmeow-english ;
    gmeow:scriptCode "Hani" ;
    gmeow:writingSystemType gmeow:wsTypeLogographic ;
    gmeow:textDirection gmeow:directionLtr ;
    skos:exactMatch wd:Q8201 ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> .

