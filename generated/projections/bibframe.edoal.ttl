@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix bibframe: <http://id.loc.gov/ontologies/bibframe/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/bibframe> a align:Alignment ;
    rdfs:label "GMEOW → bibframe (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "DOI identifier → bf:identifiedBy minted bf:Doi node"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:identifier ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bibframe:identifiedBy ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "non-DOI identifier → bf:identifiedBy minted bf:Identifier node"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:identifier ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bibframe:identifiedBy ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "title → bf:title"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:title ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bibframe:title ] ;
            align:relation "=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "CreativeWorkTitle relator → bf:Title node"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasTitle ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri bibframe:title ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "Work → bf:Work"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Work ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri bibframe:Work ] ;
            align:relation "=" ;
            edoal:measure 9e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "bibframe" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
