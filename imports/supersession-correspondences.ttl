# =========================================================================== #
# notation slice                                                              #
# =========================================================================== #

# --- SymbolicSystem / NotationSystem ⊑ SignSystem: deepen (Isomorphism) ----- #
sup:notationSymbolicSignSystem a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "graft: gmeow:SymbolicSystem → lang:SignSystem"@x-gmeow-english ;
    skos:definition "The deepen graft: gmeow:SymbolicSystem is embedded as a specialization of lang:SignSystem (rdfs:subClassOf), a recoverable embedding — a symbolic system IS a sign system, distinguished by lang:signSystemKind. Isomorphism: no loss."@x-gmeow-english ;
    logic:supersededTerm gmeow:SymbolicSystem ;
    logic:supersedingTerm lang:SignSystem ;
    logic:correspondenceRelation logic:SubsumedBy ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "true"^^xsd:boolean ;
    logic:getLeg sup:notationSymbolicSignSystemGet ;
    logic:recoveryCase sup:notationSymbolicSignSystemRecovery ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:notationSymbolicSignSystemGet gmeow:path sup:notationSymbolicSignSystemStep .
sup:notationSymbolicSignSystemRecovery a logic:RecoveryCase ;
    rdfs:label "Symbolic System to Sign System recovery case"@x-gmeow-english ;
    skos:definition "An executable recovery case that checks whether the Symbolic-System-to-Sign-System correspondence recovers its complete source graph."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    logic:recoveryTransform sup:notationSymbolicSignSystemRecoveryFormula ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:notationSymbolicSignSystemRecoveryFormula a logic:Formula ;
    rdfs:label "Symbolic System to Sign System recovery transform"@x-gmeow-english ;
    skos:definition "The source-to-view formula that maps Symbolic System membership to Sign System membership for executable recovery testing."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:quantifiedVariable [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ;
    logic:forall [ a logic:Formula ;
        logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri gmeow:SymbolicSystem ] ] ;
        logic:consequent [ a logic:Formula ; logic:relation rdf:type ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri lang:SignSystem ] ]
    ] .

sup:notationNotationSignSystem a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "graft: gmeow:NotationSystem → lang:SignSystem"@x-gmeow-english ;
    skos:definition "The deepen graft: gmeow:NotationSystem is embedded as a specialization of lang:SignSystem (rdfs:subClassOf), carrying lang:signSystemKind lang:notationalKind. Isomorphism: recoverable embedding."@x-gmeow-english ;
    logic:supersededTerm gmeow:NotationSystem ;
    logic:supersedingTerm lang:SignSystem ;
