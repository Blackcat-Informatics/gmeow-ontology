# --- Imported alias planes (cited + versioned) ------------------------------ #
# Each external standard the plane imports is a first-class lang:SignSystem
# instance carrying its citation (gmeow:cites, typed by a gmeow:CitationAct)
# and its version (dcterms:hasVersion) — imported verbatim by reference, never
# re-minted. The codebook references them alongside the GMN script and sigils.

gmeow:ipaChart
    a lang:SignSystem , lang:GmnImportedPlane ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "International Phonetic Alphabet"@x-gmeow-english ;
    skos:definition "The International Phonetic Alphabet as an imported notation plane: the lang:SignSystem the GMN linguistic surface draws its phonological glyphs from, imported by citation rather than re-minted. lang:Phone content is notated in IPA, and each IPA glyph the plane admits joins the shared GMN script by reference to this plane's cited, versioned repertoire."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:signSystemKind lang:notationalKind ;
    lang:modality lang:writtenModality ;
    gmeow:cites gmeow:ipaChartWork ;
    dcterms:hasVersion "2020" .

gmeow:ipaChartWork
    a owl:NamedIndividual , gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the IPA Chart"@x-gmeow-english ;
    skos:definition "The published International Phonetic Alphabet chart — the cited source work the IPA notation plane imports its phonological glyph repertoire from."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:title "The International Phonetic Alphabet"@x-gmeow-english .

gmeow:ipaPlaneSourceRecord
    a owl:NamedIndividual , gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "IPA plane source record"@x-gmeow-english ;
    skos:definition "The source record of the IPA notation plane: the information object that references the plane and cites the IPA Chart, carrying the plane's provenance as the citing entity of the conformance citation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:references gmeow:ipaChart ;
    gmeow:cites gmeow:ipaChartWork .

gmeow:ipaChartCitation
    a owl:NamedIndividual , gmeow:CitationAct ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "IPA plane conformance citation"@x-gmeow-english ;
    skos:definition "The typed citation act recording that the GMN linguistic plane's phonological glyphs conform to the International Phonetic Alphabet — the plane's provenance, carried by the citations vocabulary rather than a bespoke provenance property."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:citingEntity gmeow:ipaPlaneSourceRecord ;
    gmeow:citedEntity gmeow:ipaChartWork ;
    gmeow:citationIntent gmeow:intentConformsTo .

gmeow:leipzigGlossingRules
    a lang:SignSystem , lang:GmnImportedPlane ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Leipzig Glossing Rules"@x-gmeow-english ;
    skos:definition "The Leipzig Glossing Rules as an imported alias plane: the lang:SignSystem whose standard interlinear-gloss abbreviations (NOM, ACC, PL, SG, PST, PRS, the person values, the morpheme boundary) the GMN linguistic surface imports verbatim by citation. Each gloss is a named-key alias denoting a lang: grammatical-feature term, never a re-minted parallel code."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:signSystemKind lang:notationalKind ;
    lang:modality lang:writtenModality ;
    gmeow:cites gmeow:leipzigWork ;
    dcterms:hasVersion "2015" .

gmeow:leipzigWork
    a owl:NamedIndividual , gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the Leipzig Glossing Rules"@x-gmeow-english ;
    skos:definition "The published Leipzig Glossing Rules — the cited source work the Leipzig alias plane imports its interlinear-gloss abbreviations from."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:title "The Leipzig Glossing Rules: Conventions for Interlinear Morpheme-by-Morpheme Glosses"@x-gmeow-english .

gmeow:leipzigPlaneSourceRecord
    a owl:NamedIndividual , gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Leipzig plane source record"@x-gmeow-english ;
    skos:definition "The source record of the Leipzig alias plane: the information object that references the plane and cites the Leipzig Glossing Rules, carrying the plane's provenance as the citing entity of the conformance citation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:references gmeow:leipzigGlossingRules ;
    gmeow:cites gmeow:leipzigWork .

gmeow:leipzigCitation
    a owl:NamedIndividual , gmeow:CitationAct ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Leipzig plane conformance citation"@x-gmeow-english ;
    skos:definition "The typed citation act recording that the GMN linguistic plane's grammatical-gloss aliases conform to the Leipzig Glossing Rules — the plane's provenance, carried by the citations vocabulary rather than a bespoke provenance property."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:citingEntity gmeow:leipzigPlaneSourceRecord ;
    gmeow:citedEntity gmeow:leipzigWork ;
    gmeow:citationIntent gmeow:intentConformsTo .

# --- IPA phonological glyphs (the worked /ˈkæt/ phone set) ------------------- #
# Each IPA symbol joins the shared GMN script codepoint-explicitly, realizes an
# IPA-plane form, and denotes its lang:Phone (or, for the primary-stress mark,
# the prosodic suprasegmental it notates). The three segmental glyphs each
# measure one token; the primary-stress mark `ˈ` measures two, and both costs
# are recorded honestly off the crate-side measurement.

gmeow:gmnScript lang:hasGrapheme
    gmeow:gmnGlyphIpaK ,
    gmeow:gmnGlyphIpaAe ,
    gmeow:gmnGlyphIpaT ,
    gmeow:gmnGlyphIpaStress ,
    gmeow:gmnGlyphAsterisk ,
    gmeow:gmnGlyphLogicNot ,
    gmeow:gmnGlyphLogicSubClassOf ,
    gmeow:gmnGlyphMathPi ,
    gmeow:gmnGlyphMathEulerMascheroni ,
    gmeow:gmnGlyphMathAddition ,
    gmeow:gmnGlyphMathMultiplication ,
    gmeow:gmnGlyphMathExponentiation .

gmeow:phoneVoicelessVelarPlosive
    a lang:Phone ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "voiceless velar plosive [k]"@x-gmeow-english ;
    skos:definition "The voiceless velar plosive phone, notated [k] in the IPA — the onset segment of the worked phonological form /ˈkæt/."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnGlyphIpaK
    a lang:Grapheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "IPA k"@x-gmeow-english ;
    skos:definition "The IPA glyph [k] as a member of the shared GMN script repertoire: the codepoint-explicit rendering of the voiceless velar plosive, drawn from the IPA notation plane and costing a single token."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+006B" ;
    gmeow:gmnGlyphTokenCost gmeow:gmnTokenCostOne .

gmeow:gmnFormIpaK
    a lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the IPA [k] symbol form"@x-gmeow-english ;
    skos:definition "The IPA-plane notational form the glyph [k] realizes — the sign whose denotation binds it to the voiceless velar plosive phone."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inSignSystem gmeow:ipaChart .

gmeow:gmnDenIpaK
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of IPA [k]"@x-gmeow-english ;
    skos:definition "The reified meaning assignment binding the IPA [k] form to the voiceless velar plosive phone it denotes — the canonical fact the writer-projected glyph flattens."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:denotedForm gmeow:gmnFormIpaK ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget gmeow:phoneVoicelessVelarPlosive ;
    lang:denotationContext gmeow:gmnLangGlyphContext .

gmeow:phoneNearOpenFrontUnrounded
    a lang:Phone ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "near-open front unrounded vowel [æ]"@x-gmeow-english ;
    skos:definition "The near-open front unrounded vowel phone, notated [æ] in the IPA — the nucleus segment of the worked phonological form /ˈkæt/."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnGlyphIpaAe
    a lang:Grapheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "IPA æ"@x-gmeow-english ;
    skos:definition "The IPA glyph [æ] as a member of the shared GMN script repertoire: the codepoint-explicit rendering of the near-open front unrounded vowel, drawn from the IPA notation plane and costing a single token."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+00E6" ;
    gmeow:gmnGlyphTokenCost gmeow:gmnTokenCostOne .

gmeow:gmnFormIpaAe
    a lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the IPA [æ] symbol form"@x-gmeow-english ;
    skos:definition "The IPA-plane notational form the glyph [æ] realizes — the sign whose denotation binds it to the near-open front unrounded vowel phone."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inSignSystem gmeow:ipaChart .

gmeow:gmnDenIpaAe
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of IPA [æ]"@x-gmeow-english ;
    skos:definition "The reified meaning assignment binding the IPA [æ] form to the near-open front unrounded vowel phone it denotes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:denotedForm gmeow:gmnFormIpaAe ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget gmeow:phoneNearOpenFrontUnrounded ;
    lang:denotationContext gmeow:gmnLangGlyphContext .

gmeow:phoneVoicelessAlveolarPlosive
    a lang:Phone ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "voiceless alveolar plosive [t]"@x-gmeow-english ;
    skos:definition "The voiceless alveolar plosive phone, notated [t] in the IPA — the coda segment of the worked phonological form /ˈkæt/."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnGlyphIpaT
    a lang:Grapheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "IPA t"@x-gmeow-english ;
    skos:definition "The IPA glyph [t] as a member of the shared GMN script repertoire: the codepoint-explicit rendering of the voiceless alveolar plosive, drawn from the IPA notation plane and costing a single token."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+0074" ;
    gmeow:gmnGlyphTokenCost gmeow:gmnTokenCostOne .

gmeow:gmnFormIpaT
    a lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the IPA [t] symbol form"@x-gmeow-english ;
    skos:definition "The IPA-plane notational form the glyph [t] realizes — the sign whose denotation binds it to the voiceless alveolar plosive phone."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inSignSystem gmeow:ipaChart .

gmeow:gmnDenIpaT
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of IPA [t]"@x-gmeow-english ;
    skos:definition "The reified meaning assignment binding the IPA [t] form to the voiceless alveolar plosive phone it denotes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:denotedForm gmeow:gmnFormIpaT ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget gmeow:phoneVoicelessAlveolarPlosive ;
    lang:denotationContext gmeow:gmnLangGlyphContext .

# --- The IPA primary-stress mark (the prosodic head of /ˈkæt/) --------------- #
# `ˈ` (U+02C8) is a suprasegmental: it marks the primary-stressed syllable of
# the worked form /ˈkæt/, notated inline in the IPA phone stream ahead of the
# stressed segment. It is NOT a segmental phone, so it denotes the prosodic
# feature rather than a sound segment. The pinned codebook fragments it into
# two tokens, so it carries the two-token cost — recorded honestly, not
# flattened into the one-token band the segmental glyphs sit in.

gmeow:suprasegmentalPrimaryStress
    a lang:Phone ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "primary stress (suprasegmental)"@x-gmeow-english ;
    skos:definition "The primary-stress suprasegmental: the prosodic prominence borne by the head syllable of a phonological word, notated by the IPA primary-stress mark placed before the stressed syllable — the prosodic feature marked in the worked form /ˈkæt/. Unlike a segmental phone it spans a syllable rather than a single sound segment, but IPA notates it inline in the phone stream, so it is carried here as a phone-stream constituent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnGlyphIpaStress
    a lang:Grapheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "IPA primary-stress mark"@x-gmeow-english ;
    skos:definition "The IPA primary-stress mark `ˈ` (U+02C8) as a member of the shared GMN script repertoire: the codepoint-explicit rendering of the primary-stress suprasegmental, drawn from the IPA notation plane. The pinned codebook fragments it into two tokens, so its measured cost is two — dearer than the one-token segmental glyphs, but it earns its slot as the prosodic head marker of the worked form with no cheaper rendering of the distinction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+02C8" ;
    gmeow:gmnGlyphTokenCost gmeow:gmnTokenCostTwo .

gmeow:gmnFormIpaStress
    a lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the IPA primary-stress symbol form"@x-gmeow-english ;
    skos:definition "The IPA-plane notational form the primary-stress mark `ˈ` realizes — the sign whose denotation binds it to the primary-stress suprasegmental."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inSignSystem gmeow:ipaChart .

gmeow:gmnDenIpaStress
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of the IPA primary-stress mark"@x-gmeow-english ;
    skos:definition "The reified meaning assignment binding the IPA `ˈ` form to the primary-stress suprasegmental it denotes — the canonical fact the writer-projected glyph flattens."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:denotedForm gmeow:gmnFormIpaStress ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget gmeow:suprasegmentalPrimaryStress ;
    lang:denotationContext gmeow:gmnLangGlyphContext .

lang:Ungrammaticality
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Ungrammaticality"@x-gmeow-english ;
    skos:definition "The ill-formedness a `*`-marked linguistic form exhibits: the property of being ungrammatical, a form the grammar of its sign system does not license. The linguistic notion the standard `*` prefix notation marks — distinct from lang:LangConformanceFailure, which is the slice's internal SHACL-conformance-failure taxonomy over serialized documents rather than a judgment about a linguistic form's grammaticality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- The ungrammaticality operator glyph ------------------------------------ #
# `*` (U+002A) marks an ill-formed form. It costs one token, so it earns a
# glyph slot; it shares its codepoint with math multiplication, so its reading
# is pinned to the lang-AST record scope through gmeow:gmnSigilScope.

gmeow:gmnGlyphAsterisk
    a lang:Grapheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "ungrammaticality asterisk"@x-gmeow-english ;
    skos:definition "The `*` glyph (U+002A) as a member of the shared GMN script repertoire: the established linguistics notation for an ungrammatical form, costing a single token. Because the codepoint is reused by mathematical multiplication in the shared inventory, its linguistic reading is scoped to the lang-AST record role through gmeow:gmnSigilScope."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+002A" ;
    gmeow:gmnGlyphTokenCost gmeow:gmnTokenCostOne ;
    gmeow:gmnSigilScope gmeow:gmnSigilLangAst .

gmeow:gmnFormUngrammatical
    a lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the GMN ungrammaticality operator"@x-gmeow-english ;
    skos:definition "The GMN operator form the `*` glyph realizes — the sign whose denotation binds it to the ill-formedness it marks."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inSignSystem gmeow:gmnModelNotation ;
    gmeow:gmnFixity gmeow:gmnFixityPrefix ;
    gmeow:gmnArity 1 ;
    gmeow:gmnPrecedence 90 .

gmeow:gmnDenUngrammatical
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of the ungrammaticality operator"@x-gmeow-english ;
    skos:definition "The reified meaning assignment binding the `*` operator form to lang:Ungrammaticality, the ill-formedness the standard linguistics notation marks."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:denotedForm gmeow:gmnFormUngrammatical ;
    lang:denotationKind lang:denotesClass ;
