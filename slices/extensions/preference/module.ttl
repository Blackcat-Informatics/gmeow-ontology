    skos:definition "The type-guard atom of gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): asserts ?g is a gmeow:DisagreementObstruction."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] , [ logic:termIndex 1 ; logic:termIri gmeow:DisagreementObstruction ] .

# --- G1: tie, incomparability, and uncompared are pairwise distinct ---------- #
gmeow:TieIncomparabilityDistinctnessConstraint
    a logic:Constraint ;
    rdfs:label "Tie/incomparability distinctness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (G1): a pair of candidates may not be BOTH gmeow:preferentiallyEquivalentWith (a comparable tie) AND gmeow:incomparableWith (a positive non-order) — the two are distinct verdicts, and collapsing incomparability into a tie erases the Pareto-void the slice records positively. (The third state, 'not yet compared', is the ABSENCE of both edges and needs no positive assertion.) A ∀→¬∃ formula testing a pair carrying both relations, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:PreferenceObservation ;
    logic:severity "Violation" ;
    logic:message "A candidate pair must not be both gmeow:preferentiallyEquivalentWith and gmeow:incomparableWith; a tie and a positive incomparability are distinct verdicts (G1)." ;
    logic:integrity gmeow:tidForall .
gmeow:tidForall a logic:Formula ;
    rdfs:label "tidForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:TieIncomparabilityDistinctnessConstraint (G1, tie/incomparability distinctness): binds ?a and requires ?a is a gmeow:InformationObject → ¬[gmeow:tidBad]."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "a" ] ;
    logic:forall gmeow:tidImpl .
gmeow:tidImpl a logic:Formula ;
    rdfs:label "tidImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:TieIncomparabilityDistinctnessConstraint (G1, tie/incomparability distinctness): when ?a is a gmeow:InformationObject holds, requires ¬[∃?b. gmeow:tidBadBody]."@x-gmeow-english ; logic:antecedent gmeow:tidGuard ; logic:consequent gmeow:tidNoBoth .
gmeow:tidGuard a logic:Formula ;
    rdfs:label "tidGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:TieIncomparabilityDistinctnessConstraint (G1, tie/incomparability distinctness): asserts ?a is a gmeow:InformationObject."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ] , [ logic:termIndex 1 ; logic:termIri gmeow:InformationObject ] .
gmeow:tidNoBoth a logic:Formula ;
    rdfs:label "tidNoBoth (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The negation within gmeow:TieIncomparabilityDistinctnessConstraint (G1, tie/incomparability distinctness): holds only when it is NOT the case that ∃?b. gmeow:preferentiallyEquivalentWith(?a, ?b) ∧ gmeow:incomparableWith(?a, ?b)."@x-gmeow-english ; logic:not gmeow:tidBad .
gmeow:tidBad a logic:Formula ;
    rdfs:label "tidBad (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:TieIncomparabilityDistinctnessConstraint (G1, tie/incomparability distinctness): quantifies ?b and requires gmeow:preferentiallyEquivalentWith(?a, ?b) ∧ gmeow:incomparableWith(?a, ?b)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "b" ] ;
    logic:exists gmeow:tidBadBody .
gmeow:tidBadBody a logic:Formula ;
    rdfs:label "tidBadBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:TieIncomparabilityDistinctnessConstraint (G1, tie/incomparability distinctness): conjoins gmeow:preferentiallyEquivalentWith(?a, ?b) ∧ gmeow:incomparableWith(?a, ?b)."@x-gmeow-english ; logic:and gmeow:tidTie , gmeow:tidIncomp .
gmeow:tidTie a logic:Formula ;
    rdfs:label "tidTie (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:preferentiallyEquivalentWith atom ('preferentially equivalent with') of gmeow:TieIncomparabilityDistinctnessConstraint (G1, tie/incomparability distinctness): relates ?a, ?b."@x-gmeow-english ; logic:relation gmeow:preferentiallyEquivalentWith ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .
gmeow:tidIncomp a logic:Formula ;
    rdfs:label "tidIncomp (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:incomparableWith atom ('incomparable with') of gmeow:TieIncomparabilityDistinctnessConstraint (G1, tie/incomparability distinctness): relates ?a, ?b."@x-gmeow-english ; logic:relation gmeow:incomparableWith ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "a" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .

# --- The order wrapper must not be conflated with its raw math:Relation ------ #
gmeow:ProjectionObjectConflationConstraint
    a logic:Constraint ;
    rdfs:label "Projection-object conflation constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (the semantic-topology ResultObjectConflation twin): a gmeow:PreferenceOrder must NOT itself be typed in the math: namespace — it must be a wrapper REFERENCING a raw math:Relation through gmeow:orderRelation. An order that IS a raw math: object has conflated the auditable wrapper with the pure mathematical referent (gmeow:ProjectionObjectConflation). A ∀→¬∃ formula using the math: namespace prefix test, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:PreferenceOrder ;
    gmeow:enforcesFailureClass gmeow:ProjectionObjectConflation ;
    logic:severity "Violation" ;
    logic:message "A gmeow:PreferenceOrder must not itself be typed in the math: namespace; it must reference a raw math:Relation through gmeow:orderRelation (gmeow:ProjectionObjectConflation)." ;
    logic:integrity gmeow:pocForall .
gmeow:pocForall a logic:Formula ;
    rdfs:label "pocForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:ProjectionObjectConflationConstraint (the order/math-object conflation gate): binds ?this and requires ?this is a gmeow:PreferenceOrder → ¬[gmeow:pocEx]."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:pocImpl .
gmeow:pocImpl a logic:Formula ;
    rdfs:label "pocImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:ProjectionObjectConflationConstraint (the order/math-object conflation gate): when ?this is a gmeow:PreferenceOrder holds, requires ¬[∃?k. gmeow:pocBody]."@x-gmeow-english ; logic:antecedent gmeow:pocGuard ; logic:consequent gmeow:pocNot .
gmeow:pocGuard a logic:Formula ;
    rdfs:label "pocGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:ProjectionObjectConflationConstraint (the order/math-object conflation gate): asserts ?this is a gmeow:PreferenceOrder."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:PreferenceOrder ] .
gmeow:pocNot a logic:Formula ;
    rdfs:label "pocNot (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The negation within gmeow:ProjectionObjectConflationConstraint (the order/math-object conflation gate): holds only when it is NOT the case that ∃?k. ?this is a ?k ∧ ?k starts with 'https://blackcatinformatics.ca/math/'."@x-gmeow-english ; logic:not gmeow:pocEx .
gmeow:pocEx a logic:Formula ;
    rdfs:label "pocEx (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:ProjectionObjectConflationConstraint (the order/math-object conflation gate): quantifies ?k and requires ?this is a ?k ∧ ?k starts with 'https://blackcatinformatics.ca/math/'."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "k" ] ;
    logic:exists gmeow:pocBody .
gmeow:pocBody a logic:Formula ;
    rdfs:label "pocBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:ProjectionObjectConflationConstraint (the order/math-object conflation gate): conjoins ?this is a ?k ∧ ?k starts with 'https://blackcatinformatics.ca/math/'."@x-gmeow-english ; logic:and gmeow:pocType , gmeow:pocMathNs .
gmeow:pocType a logic:Formula ;
    rdfs:label "pocType (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:ProjectionObjectConflationConstraint (the order/math-object conflation gate): asserts ?this is a ?k."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "k" ] .
gmeow:pocMathNs a logic:Formula ;
    rdfs:label "pocMathNs (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The namespace-prefix atom of gmeow:ProjectionObjectConflationConstraint (the order/math-object conflation gate): asserts ?k's IRI starts with the literal 'https://blackcatinformatics.ca/math/'."@x-gmeow-english ; logic:relation logic:termStrStarts ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "k" ] , [ logic:termIndex 1 ; logic:termLiteral "https://blackcatinformatics.ca/math/" ] .

# =========================================================================== #
# TASK 4 — Hard-constraint / verifier orthogonality (AC3)                      #
# A hard verifier failure is structurally disjoint from soft preference and is #
# NEVER overridden by a high soft score.                                       #
# =========================================================================== #

gmeow:VerifierVerdict
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Verifier Verdict"@x-gmeow-english ;
    logic:subClassOf gmeow:Observation ;
    skos:definition "A hard-or-soft verifier's verdict on a candidate under a contract: a gmeow:Observation carrying its hardness class (gmeow:hardConstraintClass → gmeow:ConstraintHardness {hard, soft}), the candidate it verifies (gmeow:verifiesCandidate), its contract (gmeow:verifierContract, typed to the core gmeow:InformationObject — a contract rides the norms gmeow:Condition + gmeow:formalizedAs by reference, never a range axiom), and its outcome value (gmeow:verifierOutcome, typed to the core logic:QualityValue — reusing the norms gmeow:EvaluationVerdict vocabulary gmeow:verdictHeld / gmeow:verdictNotHeld / gmeow:verdictUndetermined at the instance level). A HARD verdict of gmeow:verdictNotHeld is unrankable-as-winner within its contract's vantages (gmeow:HardFailureNotOverriddenConstraint), no matter how high the soft aggregate. It is NOT a gmeow:PreferenceObservation (a soft comparison): the two axes are structurally disjoint."@x-gmeow-english ;
    skos:example "ex:vv1 a gmeow:VerifierVerdict ; gmeow:vantage ex:safetyChecker ; gmeow:verifiesCandidate ex:candA ; gmeow:hardConstraintClass gmeow:constraintHardnessHard ; gmeow:verifierContract ex:noPiiContract ; gmeow:verifierOutcome gmeow:verdictNotHeld ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid folding a verifier verdict into a gmeow:preferredOver edge (the hard and soft axes are disjoint — gmeow:HardSoftDisjointnessConstraint) and avoid overriding a hard gmeow:verdictNotHeld with a high soft score."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the check gmeow:VerifierVerdict, attribute it with gmeow:vantage, bind the candidate (gmeow:verifiesCandidate) and contract (gmeow:verifierContract), classify its hardness (gmeow:hardConstraintClass), and carry the outcome value with gmeow:verifierOutcome reusing the norms verdict vocabulary."@x-gmeow-english ;
    gmeow:useWhen "Use for a hard-or-soft verifier's contract verdict on a candidate — the structurally-disjoint check that a hard failure of makes a candidate unrankable-as-winner regardless of soft score."@x-gmeow-english .

gmeow:ConstraintHardness
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Constraint Hardness"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "The closed two-valued vocabulary of verifier hardness — hard (a gate that a failing candidate may not win despite soft score) versus soft (a graded preference signal). A value class whose members are minted individuals, not subclasses (Principle 9)."@x-gmeow-english ;
    skos:example "gmeow:constraintHardnessHard a gmeow:ConstraintHardness ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a hardness SUBCLASS of gmeow:VerifierVerdict (the hardness is a value, Principle 9) and avoid a third rung; hardness is exactly the hard/soft dichotomy the disjointness gate rests on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference gmeow:constraintHardnessHard or gmeow:constraintHardnessSoft from a gmeow:VerifierVerdict via gmeow:hardConstraintClass."@x-gmeow-english ;
    gmeow:useWhen "Use as the hard/soft value axis a gmeow:VerifierVerdict draws from via gmeow:hardConstraintClass."@x-gmeow-english .

gmeow:constraintHardnessHard
    a owl:NamedIndividual ,
        gmeow:ConstraintHardness ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "hard"@x-gmeow-english ;
    skos:definition "The hard rung: a verifier gate a candidate must pass to be rankable-as-winner within its contract's vantages; a hard gmeow:verdictNotHeld is never overridden by a soft score."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:constraintHardnessSoft
    a owl:NamedIndividual ,
        gmeow:ConstraintHardness ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "soft"@x-gmeow-english ;
    skos:definition "The soft rung: a graded preference signal that participates in the soft comparison but gates nothing; a soft verdict never makes a candidate unrankable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:hardConstraintClass
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:VerifierVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "hard constraint class"@x-gmeow-english ;
    rdfs:range gmeow:ConstraintHardness ;
    skos:definition "Relates a gmeow:VerifierVerdict to its gmeow:ConstraintHardness — hard or soft. Functional: one verdict has one hardness. It is the axis the orthogonality gates read: only a HARD verdict gates winner-eligibility."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:verifiesCandidate
    a owl:ObjectProperty ;
    rdfs:domain gmeow:VerifierVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "verifies candidate"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "Relates a gmeow:VerifierVerdict to the candidate it verifies. It names WHICH alternative the contract verdict is about, so a hard failure can be pinned to the exact candidate that may not win."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:verifierContract
    a owl:ObjectProperty ;
    rdfs:domain gmeow:VerifierVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "verifier contract"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "Relates a gmeow:VerifierVerdict to the contract it verifies against — typed to the core gmeow:InformationObject (a contract rides the norms gmeow:Condition + gmeow:formalizedAs by reference at the instance level, never a range axiom — Principle 16). The hard-failure gate is scoped per (candidate, contract): a hard failure gates winner-eligibility only within the vantages under THAT contract (G5)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:verifierOutcome
    a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:domain gmeow:VerifierVerdict ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "verifier outcome"@x-gmeow-english ;
    rdfs:range logic:QualityValue ;
    skos:definition "Relates a gmeow:VerifierVerdict to its outcome value — typed to the core logic:QualityValue, REUSING the norms gmeow:EvaluationVerdict vocabulary (gmeow:verdictHeld / gmeow:verdictNotHeld / gmeow:verdictUndetermined) at the instance level rather than minting a parallel verdict axis. Functional: one verdict has one outcome. A hard gmeow:verdictNotHeld is what the hard-failure gate keys on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:selectedCandidate
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ProjectionReceipt ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "selected candidate"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "Relates a gmeow:ProjectionReceipt to the single candidate its argmax/top-pick selects at whole-gmeow:CandidateSet scope — the projection's chosen winner. Binding it is DEFINITIONALLY projection-scoped and cannot ground a global assertion: a whole-set gmeow:selectedCandidate is routed through the SAME consensus gate as gmeow:assertsGlobalWinner (gmeow:SelectedCandidateRequiresConsensusConstraint, F1), closing the 'argmax winner that never sets the flag' bypass. It is NOT a licence to skip the consensus discharge; a hard-failing candidate may not be selected within its contract's vantages (gmeow:HardFailureNotOverriddenConstraint)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- AC3: a hard failure is never overridden as a selected winner ------------ #
gmeow:HardFailureNotOverriddenConstraint
    a logic:Constraint ;
    rdfs:label "Hard failure not overridden constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC3, per-(candidate, contract), NOT global — G5): a candidate carrying a HARD gmeow:VerifierVerdict (gmeow:hardConstraintClass gmeow:constraintHardnessHard) of gmeow:verdictNotHeld may not be bound as a gmeow:selectedCandidate by ANY gmeow:ProjectionReceipt — no soft aggregate overrides a hard failure. A ∀→¬∃ formula joining a receipt's selected candidate to that candidate's hard-not-held verdict, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:ProjectionReceipt ;
    gmeow:enforcesFailureClass gmeow:HardFailureOverridden ;
    logic:severity "Violation" ;
    logic:message "A candidate with a hard gmeow:VerifierVerdict of gmeow:verdictNotHeld must not be a gmeow:selectedCandidate of any gmeow:ProjectionReceipt; a hard failure is never overridden by a soft score (gmeow:HardFailureOverridden)." ;
    logic:integrity gmeow:hfoForall .
gmeow:hfoForall a logic:Formula ;
    rdfs:label "hfoForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:HardFailureNotOverriddenConstraint (AC3, hard-failure-not-overridden): binds ?this and requires ?this is a gmeow:ProjectionReceipt → ¬[gmeow:hfoBad]."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:hfoImpl .
gmeow:hfoImpl a logic:Formula ;
    rdfs:label "hfoImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:HardFailureNotOverriddenConstraint (AC3, hard-failure-not-overridden): when ?this is a gmeow:ProjectionReceipt holds, requires ¬[∃?cand,?vv. gmeow:hfoBadBody]."@x-gmeow-english ; logic:antecedent gmeow:hfoGuard ; logic:consequent gmeow:hfoNoOverride .
gmeow:hfoGuard a logic:Formula ;
    rdfs:label "hfoGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:HardFailureNotOverriddenConstraint (AC3, hard-failure-not-overridden): asserts ?this is a gmeow:ProjectionReceipt."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ProjectionReceipt ] .
gmeow:hfoNoOverride a logic:Formula ;
    rdfs:label "hfoNoOverride (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The negation within gmeow:HardFailureNotOverriddenConstraint (AC3, hard-failure-not-overridden): holds only when it is NOT the case that ∃?cand,?vv. gmeow:selectedCandidate(?this, ?cand) ∧ gmeow:verifiesCandidate(?vv, ?cand) ∧ gmeow:hardConstraintClass(?vv, gmeow:constraintHardnessHard) ∧ gmeow:verifierOutcome(?vv, gmeow:verdictNotHeld)."@x-gmeow-english ; logic:not gmeow:hfoBad .
gmeow:hfoBad a logic:Formula ;
    rdfs:label "hfoBad (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:HardFailureNotOverriddenConstraint (AC3, hard-failure-not-overridden): quantifies ?cand, ?vv and requires gmeow:selectedCandidate(?this, ?cand) ∧ gmeow:verifiesCandidate(?vv, ?cand) ∧ gmeow:hardConstraintClass(?vv, gmeow:constraintHardnessHard) ∧ gmeow:verifierOutcome(?vv, gmeow:verdictNotHeld)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "cand" ] , [ logic:termIndex 1 ; logic:termVariable "vv" ] ;
    logic:exists gmeow:hfoBadBody .
gmeow:hfoBadBody a logic:Formula ;
    rdfs:label "hfoBadBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:HardFailureNotOverriddenConstraint (AC3, hard-failure-not-overridden): conjoins gmeow:selectedCandidate(?this, ?cand) ∧ gmeow:verifiesCandidate(?vv, ?cand) ∧ gmeow:hardConstraintClass(?vv, gmeow:constraintHardnessHard) ∧ gmeow:verifierOutcome(?vv, gmeow:verdictNotHeld)."@x-gmeow-english ;
    logic:and gmeow:hfoSelected , gmeow:hfoVerifies , gmeow:hfoHard , gmeow:hfoNotHeld .
gmeow:hfoSelected a logic:Formula ;
    rdfs:label "hfoSelected (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:selectedCandidate atom ('selected candidate') of gmeow:HardFailureNotOverriddenConstraint (AC3, hard-failure-not-overridden): relates ?this, ?cand."@x-gmeow-english ; logic:relation gmeow:selectedCandidate ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "cand" ] .
gmeow:hfoVerifies a logic:Formula ;
    rdfs:label "hfoVerifies (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:verifiesCandidate atom ('verifies candidate') of gmeow:HardFailureNotOverriddenConstraint (AC3, hard-failure-not-overridden): relates ?vv, ?cand."@x-gmeow-english ; logic:relation gmeow:verifiesCandidate ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vv" ] , [ logic:termIndex 1 ; logic:termVariable "cand" ] .
gmeow:hfoHard a logic:Formula ;
    rdfs:label "hfoHard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:hardConstraintClass atom ('hard constraint class') of gmeow:HardFailureNotOverriddenConstraint (AC3, hard-failure-not-overridden): relates ?vv, gmeow:constraintHardnessHard."@x-gmeow-english ; logic:relation gmeow:hardConstraintClass ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vv" ] , [ logic:termIndex 1 ; logic:termIri gmeow:constraintHardnessHard ] .
gmeow:hfoNotHeld a logic:Formula ;
    rdfs:label "hfoNotHeld (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:verifierOutcome atom ('verifier outcome') of gmeow:HardFailureNotOverriddenConstraint (AC3, hard-failure-not-overridden): relates ?vv, gmeow:verdictNotHeld."@x-gmeow-english ; logic:relation gmeow:verifierOutcome ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vv" ] , [ logic:termIndex 1 ; logic:termIri gmeow:verdictNotHeld ] .

gmeow:HardFailureOverridden
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Hard Failure Overridden"@x-gmeow-english ;
    logic:subClassOf gmeow:PreferenceConformanceFailure ;
    skos:definition "The failure raised when a candidate with a hard gmeow:verdictNotHeld verifier verdict is nonetheless bound as a gmeow:selectedCandidate — a soft score overriding a hard gate. Enforced by gmeow:HardFailureNotOverriddenConstraint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- AC3: a hard verdict may not be folded into gmeow:preferredOver ---------- #
gmeow:HardSoftDisjointnessConstraint
    a logic:ForbiddenPatternConstraint ;
    rdfs:label "Hard/soft disjointness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world forbidden-pattern constraint (AC3): a gmeow:VerifierVerdict must NOT carry gmeow:preferredOver — the hard/soft axes are structurally disjoint, and folding a verifier verdict into a soft preference edge collapses a gate into a graded signal. Expands to ∀this. gmeow:VerifierVerdict(this) → ¬∃b. gmeow:preferredOver(this,b)."@x-gmeow-english ;
    logic:onClass gmeow:VerifierVerdict ;
    logic:forbiddenPredicate gmeow:preferredOver ;
    logic:formalizes gmeow:VerifierVerdict ;
    logic:severity "Violation" ;
    logic:message "A gmeow:VerifierVerdict must not carry gmeow:preferredOver; the hard verifier axis and the soft preference axis are structurally disjoint." .

# =========================================================================== #
# TASK 5 — Proof / counterproof / counterexample + projection receipts (AC4)   #
# Every derived ranking is a lossy, disclosed, content-addressed, deterministic #
# gmeow:ProjectionReceipt; DPO is derived-only.                                #
# =========================================================================== #

gmeow:PreferenceProof
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Preference Proof"@x-gmeow-english ;
    logic:subClassOf gmeow:Argument ;
    skos:definition "The proof-carrying warrant for a preference: a gmeow:Argument whose premises are evidence and criteria (gmeow:groundedIn, gmeow:onCriterion), whose warrant is a gmeow:InferenceApplication carrying its gmeow:appliedRule, concluding a gmeow:PreferenceClaim. Counterproofs REUSE the core typed gmeow:Attack vocabulary (gmeow:attackUndermine / gmeow:attackUndercut / gmeow:attackRebut) at the instance level, and defeat rides the core gmeow:defeatedBy / gmeow:hasDefeatStatus — the slice mints no argumentation vocabulary. It is NOT a gmeow:PreferenceClaim (the conclusion) nor a gmeow:ProjectionReceipt (a lossy ranking): it is the argument that warrants a claim."@x-gmeow-english ;
    skos:example "ex:proof1 a gmeow:PreferenceProof ; gmeow:groundedIn ex:span1 ; gmeow:appliedRule ex:concisionRule ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a parallel argument/attack/defeat vocabulary (reuse the core gmeow:Argument / gmeow:Attack / gmeow:defeatedBy) and avoid treating a proof as indefeasible; it is attackable and defeasible."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the warrant gmeow:PreferenceProof (⊑ gmeow:Argument), ground its premises with the existing gmeow:groundedIn / gmeow:onCriterion, carry its warrant via a gmeow:InferenceApplication + gmeow:appliedRule, and let counterproofs attack it via the core gmeow:Attack vocabulary."@x-gmeow-english ;
    gmeow:useWhen "Use for the defeasible, proof-carrying argument that warrants a gmeow:PreferenceClaim from evidence and criteria."@x-gmeow-english .

gmeow:PreferenceCounterexample
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Preference Counterexample"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "A concrete witness that refutes a preference proof or claim: an information object naming the case (gmeow:counterexampleWitness) where the claimed preference fails — a candidate the claim ranks below another but which a criterion or evidence shows is not, or a cycle the claim's winner ignores. It makes refutation a first-class, auditable object rather than a bare denial. It is NOT a gmeow:PreferenceProof (a warrant) and NOT itself an attack edge (which rides the core gmeow:Attack vocabulary)."@x-gmeow-english ;
    skos:example "ex:cex1 a gmeow:PreferenceCounterexample ; gmeow:counterexampleWitness ex:cycleScene ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a counterexample with no gmeow:counterexampleWitness (a bare denial) and avoid conflating it with the attack edge; the counterexample is the witnessed CASE, the attack is the argumentation move."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint a gmeow:PreferenceCounterexample and point gmeow:counterexampleWitness at the concrete case that refutes the target proof/claim; attach it to the argument graph via the core gmeow:Attack vocabulary."@x-gmeow-english ;
    gmeow:useWhen "Use for a concrete, auditable witness that refutes a preference proof or claim."@x-gmeow-english .

gmeow:counterexampleWitness
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PreferenceCounterexample ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "counterexample witness"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "Relates a gmeow:PreferenceCounterexample to the concrete case it exhibits — the candidate pair, cycle, or Pareto void that refutes the target. A counterexample naming no witness refutes nothing."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:ProjectionReceipt
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Projection Receipt"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ,
        [ a owl:Restriction ; owl:onProperty gmeow:contentDigest ; owl:allValuesFrom rdfs:Literal ] ;
    skos:definition "A lossy, disclosed, content-addressed record of ONE derived ranking over a candidate set: a projection of the canonical vantage-indexed sheaf into a pairwise / listwise / DAG-hypergraph / Pareto / scalarized view (gmeow:projectionKind), never the canonical model. Its identity is the REUSED gmeow:contentDigest over its source-set digest + kind + params + gmeow:tieBreakRule (gmeow:ProjectionMustBeContentAddressed), and same inputs MUST yield the same digest (gmeow:DeterministicDigestConstraint, F4). It carries a source set (gmeow:projectionSourceSet), a determinism declaration (gmeow:projectionDeterminism), and — reusing the shipped logic: loss ledger — EXACTLY ONE logic:preservationKind plus a logic:ExpressivenessBoundary and a gmeow:DisclosedLossEntry for every dropped relation (gmeow:CompleteLossDisclosureConstraint). It is NOT the canonical preference (the sheaf) and NOT a gmeow:PreferenceObservation: a projection is a disclosed derivative, mandatory to disclose, never an alternative canon."@x-gmeow-english ;
    skos:example "ex:rec1 a gmeow:ProjectionReceipt ; gmeow:projectionKind gmeow:projectionListwise ; gmeow:projectionSourceSet ex:cs1 ; gmeow:projectionDeterminism gmeow:determinismDeterministic ; gmeow:tieBreakRule \"lexicographic-by-iri\" ; logic:preservationKind logic:SoundUnderApproximation ; gmeow:contentDigest \"blake3:77aa…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a projection receipt as the canonical model (it is a disclosed derivative — the sheaf is canonical), avoid an undisclosed dropped relation (gmeow:CompleteLossDisclosureConstraint), and avoid a non-exact receipt with no named boundary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the derived ranking gmeow:ProjectionReceipt, declare its gmeow:projectionKind, bind its gmeow:projectionSourceSet, declare gmeow:projectionDeterminism (and a gmeow:tieBreakRule when deterministic, gmeow:scalarizationWeights when scalarized), name its logic:preservationKind and a gmeow:DisclosedLossEntry per dropped relation, and content-address the whole with the existing gmeow:contentDigest."@x-gmeow-english ;
    gmeow:useWhen "Use for one lossy, disclosed, content-addressed derived ranking over a candidate set — a projection of the canonical sheaf, mandatory to disclose but never the canon."@x-gmeow-english .

gmeow:ProjectionKind
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Projection Kind"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "The closed vocabulary of ranking-projection shapes a gmeow:ProjectionReceipt draws from — pairwise, listwise, DAG/hypergraph, Pareto, scalarized. A value class whose members are minted individuals, not subclasses (Principle 9)."@x-gmeow-english ;
    skos:example "gmeow:projectionPareto a gmeow:ProjectionKind ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting a projection-kind SUBCLASS of gmeow:ProjectionReceipt (the kind is a value, Principle 9) and avoid treating DPO as a kind — a DPO view is a gmeow:DpoView subtype of receipt, not a projection kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference one of the five gmeow:ProjectionKind individuals from a gmeow:ProjectionReceipt via gmeow:projectionKind."@x-gmeow-english ;
    gmeow:useWhen "Use as the projection-shape value axis a gmeow:ProjectionReceipt draws from."@x-gmeow-english .

gmeow:projectionPairwise a owl:NamedIndividual , gmeow:ProjectionKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "pairwise"@x-gmeow-english ;
    skos:definition "A pairwise projection: the ranking is expressed as pairwise preferred-over comparisons."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .
gmeow:projectionListwise a owl:NamedIndividual , gmeow:ProjectionKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "listwise"@x-gmeow-english ;
    skos:definition "A listwise projection: the ranking is expressed as one ordered list, whose argmax top pick is a gmeow:selectedCandidate routed through the consensus gate (F1)."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .
gmeow:projectionDagHypergraph a owl:NamedIndividual , gmeow:ProjectionKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "DAG hypergraph"@x-gmeow-english ;
    skos:definition "A DAG/hypergraph projection: the ranking is expressed as a directed acyclic (hyper)graph of preferences; general acyclicity of the projected order is a second-order boundary (FLAG-2)."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .
gmeow:projectionPareto a owl:NamedIndividual , gmeow:ProjectionKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "Pareto"@x-gmeow-english ;
    skos:definition "A Pareto projection: the ranking is a Pareto frontier with positive incomparability off it; general k-criterion Pareto dominance is a second-order boundary (FLAG-2)."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .
gmeow:projectionScalarized a owl:NamedIndividual , gmeow:ProjectionKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "scalarized"@x-gmeow-english ;
    skos:definition "A scalarized projection: multiple criteria are collapsed to a scalar score under declared gmeow:scalarizationWeights (gmeow:ScalarizationDisclosureConstraint), whose argmax top pick is routed through the consensus gate (F1)."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .

gmeow:ProjectionDeterminism
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Projection Determinism"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "The closed vocabulary of projection determinism a gmeow:ProjectionReceipt declares — deterministic, reproducible-within-tolerance, or nondeterministic. Non-determinism is POSITIVELY declared, never silent (gmeow:DeterministicProjectionConstraint). A value class whose members are minted individuals (Principle 9)."@x-gmeow-english ;
    skos:example "gmeow:determinismDeterministic a gmeow:ProjectionDeterminism ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid leaving determinism undeclared (non-determinism must be positively asserted) and avoid claiming deterministic without a gmeow:tieBreakRule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference a gmeow:ProjectionDeterminism individual from a gmeow:ProjectionReceipt via gmeow:projectionDeterminism."@x-gmeow-english ;
    gmeow:useWhen "Use as the determinism value axis a gmeow:ProjectionReceipt draws from."@x-gmeow-english .

gmeow:determinismDeterministic a owl:NamedIndividual , gmeow:ProjectionDeterminism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "deterministic"@x-gmeow-english ;
    skos:definition "A deterministic projection: same inputs always yield the same ranking and digest; it MUST carry a gmeow:tieBreakRule."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .
gmeow:determinismReproducibleWithinTolerance a owl:NamedIndividual , gmeow:ProjectionDeterminism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "reproducible within tolerance"@x-gmeow-english ;
    skos:definition "A projection reproducible only within a declared numeric tolerance; its digest is over the disclosed inputs and tie-break, its recomputation faithful within tolerance (Principle 12)."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .
gmeow:determinismNondeterministic a owl:NamedIndividual , gmeow:ProjectionDeterminism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "nondeterministic"@x-gmeow-english ;
    skos:definition "A positively-declared nondeterministic projection: repeat runs may reorder; the non-determinism is disclosed, never silent."@x-gmeow-english ; gmeow:graphBoxRole gmeow:boxABox .

gmeow:projectionKind
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain gmeow:ProjectionReceipt ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "projection kind"@x-gmeow-english ;
    rdfs:range gmeow:ProjectionKind ;
    skos:definition "Relates a gmeow:ProjectionReceipt to its gmeow:ProjectionKind. Functional: one receipt is one projection shape. It folds into the receipt's content digest and selects which disclosure gates bite (e.g. scalarized ⇒ gmeow:scalarizationWeights)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:projectionDeterminism
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain gmeow:ProjectionReceipt ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "projection determinism"@x-gmeow-english ;
    rdfs:range gmeow:ProjectionDeterminism ;
    skos:definition "Relates a gmeow:ProjectionReceipt to its declared gmeow:ProjectionDeterminism. Functional: one receipt has one determinism declaration, positively asserted (non-determinism is never silent)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:projectionSourceSet
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ProjectionReceipt ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "projection source set"@x-gmeow-english ;
    rdfs:range gmeow:CandidateSet ;
    skos:definition "Relates a gmeow:ProjectionReceipt to the gmeow:CandidateSet it projects over — the source field whose digest is part of the receipt's identity. Two receipts over the same source set with the same kind and params must carry the same digest (F4)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:tieBreakRule
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ProjectionReceipt ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "tie-break rule"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The STORED, not-executed (Principle 12) tie-break rule a deterministic gmeow:ProjectionReceipt uses to order tied candidates — a content-addressed claim the consumer executes, part of the receipt's digest. A deterministic receipt MUST carry one (gmeow:DeterministicProjectionConstraint)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:scalarizationWeights
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:ProjectionReceipt ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "scalarization weights"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The STORED per-criterion weights a scalarized gmeow:ProjectionReceipt collapses criteria under — a content-addressed disclosure (Principle 12), part of the receipt's digest. A scalarized receipt MUST carry it (gmeow:ScalarizationDisclosureConstraint); the gate proves DISCLOSURE exists, not that the scalarization is uniquely faithful (FLAG-2, Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:DisclosedLossEntry
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Disclosed Loss Entry"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "One disclosed loss of a projection: an information object naming a canonical relation the projection could not realize (gmeow:droppedRelation) or the scalarization choice it made (gmeow:scalarizationChoice). Every dropped canonical edge MUST have one (gmeow:CompleteLossDisclosureConstraint): an honest projection names what it dropped (Principle 17). It is NOT the logic:preservationKind rung itself (the ledger summary): it is one line item under it."@x-gmeow-english ;
    skos:example "ex:loss1 a gmeow:DisclosedLossEntry ; gmeow:droppedRelation ex:incomparablePair ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a loss entry that names neither a gmeow:droppedRelation nor a gmeow:scalarizationChoice (an empty disclosure) and avoid using it as the ledger summary; the summary is the receipt's logic:preservationKind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint one gmeow:DisclosedLossEntry per dropped relation (gmeow:droppedRelation) or scalarization choice (gmeow:scalarizationChoice), and attach it to the receipt with gmeow:disclosesLoss."@x-gmeow-english ;
    gmeow:useWhen "Use for one line item of a projection's disclosed loss — a dropped canonical relation or a scalarization choice."@x-gmeow-english .

gmeow:disclosesLoss
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ProjectionReceipt ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "discloses loss"@x-gmeow-english ;
    rdfs:range gmeow:DisclosedLossEntry ;
    skos:definition "Relates a gmeow:ProjectionReceipt to a gmeow:DisclosedLossEntry it discloses. Non-functional: a projection may drop several relations, each a disclosed entry."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:droppedRelation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DisclosedLossEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "dropped relation"@x-gmeow-english ;
    rdfs:range math:Relation ;
    skos:definition "Relates a gmeow:DisclosedLossEntry to the raw math:Relation (a canonical preference/tie/incomparability edge) the projection could not realize — the exact edge dropped. A non-empty dropped-relation set forces a non-exact logic:preservationKind (gmeow:PreservationConsistencyConstraint)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:scalarizationChoice
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DisclosedLossEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "scalarization choice"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The stored scalarization choice a gmeow:DisclosedLossEntry records — the aggregation decision (e.g. which criteria were weighted to break which incomparability) a scalarized projection made, disclosed as a content-addressed claim (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:DpoView
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "DPO View"@x-gmeow-english ;
    logic:subClassOf gmeow:ProjectionReceipt ;
    skos:definition "A Direct-Preference-Optimization training view: a gmeow:ProjectionReceipt subtype that pairs chosen/rejected candidates for optimizer consumption. It is a DERIVED consumer of the canonical preference, NEVER the canonical model: a canonical gmeow:PreferenceObservation may not be derived FROM a gmeow:DpoView (gmeow:DpoNotCanonicalConstraint). It carries the same loss ledger and content-addressing as any projection receipt."@x-gmeow-english ;
    skos:example "ex:dpo1 a gmeow:DpoView ; gmeow:projectionKind gmeow:projectionPairwise ; gmeow:projectionSourceSet ex:cs1 ; gmeow:contentDigest \"blake3:dd01…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving a canonical gmeow:PreferenceObservation from a gmeow:DpoView (DPO is derived-only — gmeow:DpoNotCanonicalConstraint) and avoid treating the training view as the preference model."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the training view gmeow:DpoView (⊑ gmeow:ProjectionReceipt), carry its kind/source/loss-ledger/digest like any receipt, and consume it downstream only — never source a canonical observation from it."@x-gmeow-english ;
    gmeow:useWhen "Use for a DPO chosen/rejected training view — a derived-only projection receipt, never the canonical preference."@x-gmeow-english .

# --- Second-order honesty boundaries (FLAG-2) reusing the shipped loss ledger  #
gmeow:GeneralParetoDominanceBoundary
    a owl:NamedIndividual ,
        gmeow:ProjectionPreservationRecord ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "General k-criterion Pareto dominance boundary"@x-gmeow-english ;
    skos:definition "The honest boundary record for general k-criterion Pareto dominance: a ∀ over an OPEN criterion set is second-order and not first-order expressible, so it is carried as logic:preservationKind logic:Unsupported with a logic:expressivenessBoundary logic:SecondOrder — never a faked first-order logic:Formula. Concrete, fixed-arity Pareto frontiers are enforced by bounded per-fixture Formulas; this record discloses that the GENERAL law is beyond the decidable fragment (Principle 12/17)."@x-gmeow-english ;
    logic:preservationKind logic:Unsupported ;
    logic:expressivenessBoundary logic:SecondOrder ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:ProjectedDagAcyclicityBoundary
    a owl:NamedIndividual ,
        gmeow:ProjectionPreservationRecord ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "General projected-DAG acyclicity boundary"@x-gmeow-english ;
    skos:definition "The honest boundary record for general acyclicity of a PROJECTED order: transitive-closure acyclicity over an unbounded candidate set is a finiteness/second-order appeal, not first-order expressible, so it is carried as logic:preservationKind logic:Unsupported with logic:expressivenessBoundary logic:SecondOrder — never a faked Formula. Bounded per-fixture acyclicity is enforced by concrete Formulas; this record discloses the general law is beyond the decidable fragment."@x-gmeow-english ;
    logic:preservationKind logic:Unsupported ;
    logic:expressivenessBoundary logic:SecondOrder ;
    gmeow:graphBoxRole gmeow:boxABox .

# --- AC4 gates ---------------------------------------------------------------- #

# Complete loss disclosure: every dropped relation is a disclosed entry (a
# non-exact receipt must carry at least one gmeow:DisclosedLossEntry).
gmeow:CompleteLossDisclosureConstraint
    a logic:Constraint ;
    rdfs:label "Complete loss disclosure constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC4): a gmeow:ProjectionReceipt whose logic:preservationKind is anything OTHER than logic:ExactPreservation MUST disclose at least one gmeow:DisclosedLossEntry through gmeow:disclosesLoss — a lossy projection that names nothing it dropped is a hollow disclosure (Principle 17). A ∀→∃ formula guarded on a non-exact receipt, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:ProjectionReceipt ;
    logic:severity "Violation" ;
    logic:message "A gmeow:ProjectionReceipt with a non-exact logic:preservationKind must disclose at least one gmeow:DisclosedLossEntry through gmeow:disclosesLoss; a lossy projection that discloses no dropped relation is a hollow disclosure." ;
    logic:integrity gmeow:cldForall .
gmeow:cldForall a logic:Formula ;
    rdfs:label "cldForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:CompleteLossDisclosureConstraint (AC4, complete loss disclosure): binds ?this and requires ?this is a gmeow:ProjectionReceipt ∧ gmeow:cldLossy → ∃?e. gmeow:disclosesLoss(?this, ?e)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:cldImpl .
gmeow:cldImpl a logic:Formula ;
    rdfs:label "cldImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:CompleteLossDisclosureConstraint (AC4, complete loss disclosure): when ?this is a gmeow:ProjectionReceipt ∧ ∃?k. gmeow:cldLossyBody holds, requires ∃?e. gmeow:disclosesLoss(?this, ?e)."@x-gmeow-english ; logic:antecedent gmeow:cldGuard ; logic:consequent gmeow:cldExists .
gmeow:cldGuard a logic:Formula ;
    rdfs:label "cldGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:CompleteLossDisclosureConstraint (AC4, complete loss disclosure): conjoins ?this is a gmeow:ProjectionReceipt ∧ ∃?k. gmeow:cldLossyBody."@x-gmeow-english ; logic:and gmeow:cldType , gmeow:cldLossy .
gmeow:cldType a logic:Formula ;
    rdfs:label "cldType (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:CompleteLossDisclosureConstraint (AC4, complete loss disclosure): asserts ?this is a gmeow:ProjectionReceipt."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ProjectionReceipt ] .
gmeow:cldLossy a logic:Formula ;
    rdfs:label "cldLossy (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:CompleteLossDisclosureConstraint (AC4, complete loss disclosure): quantifies ?k and requires logic:preservationKind(?this, ?k) ∧ ?k ≠ logic:ExactPreservation."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "k" ] ;
    logic:exists gmeow:cldLossyBody .
gmeow:cldLossyBody a logic:Formula ;
    rdfs:label "cldLossyBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:CompleteLossDisclosureConstraint (AC4, complete loss disclosure): conjoins logic:preservationKind(?this, ?k) ∧ ?k ≠ logic:ExactPreservation."@x-gmeow-english ; logic:and gmeow:cldKind , gmeow:cldNotExact .
gmeow:cldKind a logic:Formula ;
    rdfs:label "cldKind (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The logic:preservationKind atom of gmeow:CompleteLossDisclosureConstraint (AC4, complete loss disclosure): relates ?this, ?k."@x-gmeow-english ; logic:relation logic:preservationKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "k" ] .
gmeow:cldNotExact a logic:Formula ;
    rdfs:label "cldNotExact (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The inequality atom of gmeow:CompleteLossDisclosureConstraint (AC4, complete loss disclosure): asserts ?k and logic:ExactPreservation are distinct, the witness that closes the violation pattern."@x-gmeow-english ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "k" ] , [ logic:termIndex 1 ; logic:termIri logic:ExactPreservation ] .
gmeow:cldExists a logic:Formula ;
    rdfs:label "cldExists (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:CompleteLossDisclosureConstraint (AC4, complete loss disclosure): quantifies ?e and requires gmeow:disclosesLoss(?this, ?e)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "e" ] ;
    logic:exists gmeow:cldAtom .
gmeow:cldAtom a logic:Formula ;
    rdfs:label "cldAtom (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:disclosesLoss atom ('discloses loss') of gmeow:CompleteLossDisclosureConstraint (AC4, complete loss disclosure): relates ?this, ?e."@x-gmeow-english ; logic:relation gmeow:disclosesLoss ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "e" ] .

# Preservation consistency: a receipt disclosing a dropped relation may not
# claim logic:ExactPreservation.
gmeow:PreservationConsistencyConstraint
    a logic:Constraint ;
    rdfs:label "Preservation consistency constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC4): a gmeow:ProjectionReceipt that discloses a gmeow:DisclosedLossEntry naming a gmeow:droppedRelation must NOT carry logic:preservationKind logic:ExactPreservation — dropping an edge is by definition not exact preservation. A ∀→¬∃ formula, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:ProjectionReceipt ;
    logic:severity "Violation" ;
    logic:message "A gmeow:ProjectionReceipt disclosing a dropped relation must not claim logic:ExactPreservation; a dropped edge is not exact preservation." ;
    logic:integrity gmeow:pccForall .
gmeow:pccForall a logic:Formula ;
    rdfs:label "pccForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:PreservationConsistencyConstraint (AC4, preservation consistency): binds ?this and requires ?this is a gmeow:ProjectionReceipt → ¬[gmeow:pccBad]."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:pccImpl .
gmeow:pccImpl a logic:Formula ;
    rdfs:label "pccImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:PreservationConsistencyConstraint (AC4, preservation consistency): when ?this is a gmeow:ProjectionReceipt holds, requires ¬[∃?e,?r. gmeow:pccBadBody]."@x-gmeow-english ; logic:antecedent gmeow:pccGuard ; logic:consequent gmeow:pccNot .
gmeow:pccGuard a logic:Formula ;
    rdfs:label "pccGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:PreservationConsistencyConstraint (AC4, preservation consistency): asserts ?this is a gmeow:ProjectionReceipt."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ProjectionReceipt ] .
gmeow:pccNot a logic:Formula ;
    rdfs:label "pccNot (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The negation within gmeow:PreservationConsistencyConstraint (AC4, preservation consistency): holds only when it is NOT the case that ∃?e,?r. gmeow:disclosesLoss(?this, ?e) ∧ gmeow:droppedRelation(?e, ?r) ∧ logic:preservationKind(?this, logic:ExactPreservation)."@x-gmeow-english ; logic:not gmeow:pccBad .
gmeow:pccBad a logic:Formula ;
    rdfs:label "pccBad (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:PreservationConsistencyConstraint (AC4, preservation consistency): quantifies ?e, ?r and requires gmeow:disclosesLoss(?this, ?e) ∧ gmeow:droppedRelation(?e, ?r) ∧ logic:preservationKind(?this, logic:ExactPreservation)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "e" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] ;
    logic:exists gmeow:pccBadBody .
gmeow:pccBadBody a logic:Formula ;
    rdfs:label "pccBadBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:PreservationConsistencyConstraint (AC4, preservation consistency): conjoins gmeow:disclosesLoss(?this, ?e) ∧ gmeow:droppedRelation(?e, ?r) ∧ logic:preservationKind(?this, logic:ExactPreservation)."@x-gmeow-english ; logic:and gmeow:pccDiscloses , gmeow:pccDropped , gmeow:pccExact .
gmeow:pccDiscloses a logic:Formula ;
    rdfs:label "pccDiscloses (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:disclosesLoss atom ('discloses loss') of gmeow:PreservationConsistencyConstraint (AC4, preservation consistency): relates ?this, ?e."@x-gmeow-english ; logic:relation gmeow:disclosesLoss ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "e" ] .
gmeow:pccDropped a logic:Formula ;
    rdfs:label "pccDropped (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:droppedRelation atom ('dropped relation') of gmeow:PreservationConsistencyConstraint (AC4, preservation consistency): relates ?e, ?r."@x-gmeow-english ; logic:relation gmeow:droppedRelation ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "e" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] .
gmeow:pccExact a logic:Formula ;
    rdfs:label "pccExact (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The logic:preservationKind atom of gmeow:PreservationConsistencyConstraint (AC4, preservation consistency): relates ?this, logic:ExactPreservation."@x-gmeow-english ; logic:relation logic:preservationKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri logic:ExactPreservation ] .

# Determinism: a deterministic receipt must carry a tie-break rule.
gmeow:DeterministicProjectionConstraint
    a logic:Constraint ;
    rdfs:label "Deterministic projection constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC4): a gmeow:ProjectionReceipt declared gmeow:determinismDeterministic MUST carry a gmeow:tieBreakRule — a deterministic ranking with no disclosed tie-break rule cannot in fact be deterministic over ties. Non-determinism is declared positively elsewhere; this gate binds only the deterministic rung. A ∀→∃ formula, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:ProjectionReceipt ;
    logic:severity "Violation" ;
    logic:message "A gmeow:ProjectionReceipt declared gmeow:determinismDeterministic must carry a gmeow:tieBreakRule." ;
    logic:integrity gmeow:dpcForall .
gmeow:dpcForall a logic:Formula ;
    rdfs:label "dpcForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:DeterministicProjectionConstraint (AC4, deterministic projection): binds ?this and requires ?this is a gmeow:ProjectionReceipt ∧ gmeow:projectionDeterminism(?this, gmeow:determinismDeterministic) → ∃?t. gmeow:tieBreakRule(?this, ?t)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:dpcImpl .
gmeow:dpcImpl a logic:Formula ;
    rdfs:label "dpcImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:DeterministicProjectionConstraint (AC4, deterministic projection): when ?this is a gmeow:ProjectionReceipt ∧ gmeow:projectionDeterminism(?this, gmeow:determinismDeterministic) holds, requires ∃?t. gmeow:tieBreakRule(?this, ?t)."@x-gmeow-english ; logic:antecedent gmeow:dpcGuard ; logic:consequent gmeow:dpcExists .
gmeow:dpcGuard a logic:Formula ;
    rdfs:label "dpcGuard (formula AST node)"@x-gmeow-english ;
