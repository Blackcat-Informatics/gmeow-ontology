    rdfs:domain gmeow:RelayHop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "relay at"@x-gmeow-english ;
    rdfs:range xsd:dateTime ;
    skos:definition "The server timestamp recorded for a relay hop."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:relayBy
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:RelayHop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "relay by"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The server that performed a relay hop."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:relayFrom
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:RelayHop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "relay from"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The host a relay hop received the message from."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:relayProtocol
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:RelayHop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "relay protocol"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The protocol used for a relay hop (e.g. ESMTP, ESMTPS)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:replyTo
    a owl:ObjectProperty ;
    rdfs:domain gmeow:EmailMessage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "reply to"@x-gmeow-english ;
    rdfs:range gmeow:EmailAddress ;
    skos:definition "An address to which replies should be sent (RFC 5322 Reply-To)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:resentDate
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:EmailMessage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "resent date"@x-gmeow-english ;
    rdfs:range xsd:dateTime ;
    skos:definition "The RFC 5322 Resent-Date header value of a message. Non-functional: a message may carry multiple Resent-Date values if it was resent multiple times. The raw header value remains on gmeow:MessageHeader (Principle 4)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:resentMessageId
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:EmailMessage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "resent message id"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The RFC 5322 Resent-Message-ID header value of a message. Non-functional: a message may carry multiple Resent-Message-ID values if it was resent multiple times. The raw header value remains on gmeow:MessageHeader (Principle 4)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:residenceMailbox
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MailboxResidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "residence mailbox"@x-gmeow-english ;
    rdfs:range gmeow:Mailbox ;
    skos:definition "The mailbox a mailbox-residence concerns."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:residentMessage
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MailboxResidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "resident message"@x-gmeow-english ;
    rdfs:range gmeow:Message ;
    skos:definition "The message a mailbox-residence concerns."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:residesIn
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Message ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "resides in"@x-gmeow-english ;
    rdfs:range gmeow:Mailbox ;
    skos:definition "Relates a message to a mailbox/label it currently resides in. Time-varying residence is reified as gmeow:MailboxResidence; on this convenience property the period may be carried with gmeow:validFrom/validUntil."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:rfcMessageId
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Message ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "RFC message id"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The RFC 5322 Message-ID of a message."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:sender
    a owl:ObjectProperty ;
    rdfs:domain gmeow:EmailMessage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "sender"@x-gmeow-english ;
    rdfs:range gmeow:EmailAddress ;
    skos:definition "The transmitting address of a message, where different from the author (RFC 5322 Sender)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:sentAt
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Message ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "sent at"@x-gmeow-english ;
    rdfs:range xsd:dateTime ;
    skos:definition "When a message was sent (RFC 5322 Date)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:sentBySoftware
    a owl:ObjectProperty ;
    rdfs:domain gmeow:EmailMessage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "sent by software"@x-gmeow-english ;
    rdfs:range gmeow:SoftwareAgent ;
    skos:definition "The software agent that sent a message, when parsed and identified from the User-Agent or X-Mailer header. The raw header value remains on gmeow:userAgent (Principle 4)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:sizeEstimate
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Message ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "size estimate"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The estimated size of a message in octets."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:subject
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Message ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "subject"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The subject line of a message (RFC 5322 Subject)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:subjectPrefix
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:EmailMessage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "subject prefix"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "A prefix stripped from a message subject during normalization (e.g. 'Re:', 'Fwd:', 'AW:'). A single message may have multiple nested prefixes, so this property is not functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:threadSubject
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Thread ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "thread subject"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The base subject of a conversation thread, with reply/forward prefixes stripped, used for display and grouping. Derived from the raw RFC 5322 Subject headers of the messages in the thread."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:to
    a owl:ObjectProperty ;
    rdfs:domain gmeow:EmailMessage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "to"@x-gmeow-english ;
    rdfs:range gmeow:EmailAddress ;
    skos:definition "A primary recipient address of a message (RFC 5322 To)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:transferEncoding7bit
    a gmeow:ContentTransferEncoding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "7bit"@x-gmeow-english ;
    skos:definition "7-bit content-transfer-encoding — short lines of US-ASCII (RFC 2045)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transferEncoding8bit
    a gmeow:ContentTransferEncoding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "8bit"@x-gmeow-english ;
    skos:definition "8-bit content-transfer-encoding — short lines of octets (RFC 2045)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transferEncodingBase64
    a gmeow:ContentTransferEncoding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "base64"@x-gmeow-english ;
    skos:definition "Base64 content-transfer-encoding (RFC 2045)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transferEncodingBinary
    a gmeow:ContentTransferEncoding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "binary"@x-gmeow-english ;
    skos:definition "Binary content-transfer-encoding — arbitrary octets without line-length restrictions (RFC 2045)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:transferEncodingQuotedPrintable
    a gmeow:ContentTransferEncoding ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "quoted-printable"@x-gmeow-english ;
    skos:definition "Quoted-printable content-transfer-encoding (RFC 2045)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:userAgent
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:EmailMessage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "user agent"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The raw User-Agent or X-Mailer header value of an email message — the sending software identifier as it appeared in the header."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

<https://blackcatinformatics.ca/gmeow/slices/email>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "Email messages, threads, mailboxes and body structure — the JMAP (RFC 8621) superset layer, also covering RFC 5322 headers, MIME, IMAP keywords and the Gmail API. Messages are not disjoint from the entities (via EmailAddress) or accounts (via mailbox residence) they involve, and residence is temporally grounded."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "GMEOW Email Module"@x-gmeow-english ;
    skos:definition "The GMEOW Email Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Suppression constraint (#1194) — projection of SuppressedMessageParticipantShape.
# A withdrawn/superseded MessageParticipant (one carrying gmeow:validUntil) that #
# is not suppressed (gmeow:displayable false) is a Warning — a source may lag.    #
# =========================================================================== #

gmeow:WithdrawnMessageParticipantSuppressionConstraint
    a logic:Constraint ;
    rdfs:label "Withdrawn message-participant suppression constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a withdrawn or superseded gmeow:MessageParticipant (one carrying gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)."@x-gmeow-english ;
    logic:formalizes gmeow:SuppressedMessageParticipantShape ;
    logic:severity "Warning" ;
    logic:message "A withdrawn or superseded MessageParticipant (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
    logic:integrity logic:supMpForall .
logic:supMpForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:supMpImpl .
logic:supMpImpl a logic:Formula ; logic:antecedent logic:supMpGuard ; logic:consequent logic:supMpPhi .
logic:supMpGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:MessageParticipant ] .
logic:supMpPhi a logic:Formula ; logic:not logic:supMpEx .
logic:supMpEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "u" ] ;
    logic:exists logic:supMpBody .
logic:supMpBody a logic:Formula ; logic:and logic:supMpValid , logic:supMpNotSuppressed .
logic:supMpValid a logic:Formula ; logic:relation gmeow:validUntil ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "u" ] .
logic:supMpNotSuppressed a logic:Formula ; logic:not logic:supMpDisp .
logic:supMpDisp a logic:Formula ; logic:relation gmeow:displayable ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/MessageParticipant> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/participantMessage> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/MessageParticipant> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/participantRole> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/MessageParticipant> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/participantMessage" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/MessageParticipant> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/participantRole" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .

# --- Wave B1 shape-drain: message-participant cardinality + suppression ---
# gmeow:MessageParticipantHasPlayersShape — a MessageParticipant belongs to exactly one message,
# references at most one address, and declares exactly one role.
gmeow:MessageParticipant logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:participantMessage ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:participantAddress ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:participantRole ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:authMethodFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "authMethod is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:authMethod is functional: an AuthenticationResult reifies a single RFC 8601 authentication check, and each such check tests exactly one method — dkim, spf, dmarc, arc, iprev, or auth — so the reified result names that one method. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:authMethod ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:authMethod ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:authMethod names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:authMethod, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:authMethod and nothing else. It is not a definition of gmeow:authMethod (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:authMethodFunctionality logic:characterizes gmeow:authMethod ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:authResultFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "authResult is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:authResult is functional: the single method an AuthenticationResult evaluates yields exactly one verdict — pass, fail, none, softfail, neutral, temperror, or permerror — so the reified check carries one result. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:authResult ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:authResult ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:authResult names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:authResult, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:authResult and nothing else. It is not a definition of gmeow:authResult (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:authResultFunctionality logic:characterizes gmeow:authResult ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:authServerFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
