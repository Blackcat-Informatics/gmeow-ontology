#
# Shared ABox fixture for the mathematics bedrock competency questions. Unioned onto
# the merged ontology by gmeow:cqDataFile; each query projects its own slice.
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix wd:    <http://www.wikidata.org/entity/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/math/> .

# Q1 — numbers situated in systems, with exactness.
ex:half a math:RationalNumber ;
    math:inNumberSystem math:rationalNumbers ;
    math:isExact true .
ex:negFive a math:Integer ;
    math:inNumberSystem math:integers ;
    math:isExact true .

# Q2 — an intensional set whose condition denotes a logic: formula.
ex:evenNumbers a math:SetBuilderExpression ;
    math:memberCondition ex:evenFormula .
ex:evenFormula a logic:Formula ;
    rdfs:label "x mod 2 = 0"@x-gmeow-english .

# Q3 — a function with domain, codomain, image, and inj/surj/bij flags.
ex:successor a math:Function ;
    math:domain ex:naturalsSet ;
    math:codomain ex:naturalsSet ;
    math:image ex:positivesSet ;
    math:isInjective true ;
    math:isSurjective false ;
    math:isBijective false .
ex:naturalsSet a math:Set .
ex:positivesSet a math:Set .

# Q4 — sets with cardinalities (finite and countably infinite).
ex:primesUnderTen a math:FiniteSet ;
    math:hasCardinality math:cardinalityFinite .
ex:allNaturals a math:Set ;
    math:hasCardinality math:alephNull .

# Q5 — a named constant carrying a queryable Wikidata anchor.
ex:eqPiAnchor a gmeow:TermEquivalence ;
    gmeow:alignSubject math:pi ;
    gmeow:alignObject wd:Q167 .

# Q6 — measures with their space, total mass, and whether they are probability
# measures. A probability measure has mass one; a Lebesgue measure on the line has
# extended-real mass math:PositiveInfinity. Both are typed math:Measure directly
# (the competency lane reasons none, so subclass typing is asserted explicitly).
ex:coinMeasure a math:ProbabilityMeasure , math:Measure ;
    math:measureOn ex:coinSpace ;
    math:totalMass 1 .
ex:coinSpace a math:MeasurableSpace .
ex:lengthMeasure a math:LebesgueMeasure , math:Measure ;
    math:measureOn ex:lineSpace ;
    math:totalMass math:PositiveInfinity .
ex:lineSpace a math:MeasurableSpace .

# Q7 — an integral naming its integrand, domain, and measure.
ex:expectation a math:Integral ;
    math:integrand ex:densityFn ;
    math:integrationDomain ex:coinSpace ;
    math:withRespectTo ex:coinMeasure .
ex:densityFn a math:MeasurableFunction .

# Q6a — two measure evaluations μ(A) of one measure over two measurable subsets, each
# naming its measure, subset, and finite non-negative result. Unlike the whole-space
# math:totalMass +∞ of the same measure, μ(unitInterval) = 1 and μ(doubleInterval) = 2
# are comparable side by side.
ex:unitInterval a math:MeasurableSet .
ex:doubleInterval a math:MeasurableSet .
ex:lengthOfUnit a math:MeasureEvaluation ;
    math:evaluatedMeasure ex:lengthMeasure ;
    math:measuredSubset ex:unitInterval ;
    math:measureResult "1.0"^^xsd:double .
ex:lengthOfDouble a math:MeasureEvaluation ;
    math:evaluatedMeasure ex:lengthMeasure ;
    math:measuredSubset ex:doubleInterval ;
    math:measureResult "2.0"^^xsd:double .

# Q8/Q9 — two commensurable energy quantities (same derived dimension) and the
# homogeneous dimensional expression that sums them.
ex:energyDim a math:DerivedDimension ;
    math:baseDimensionExponent ex:enMass1 , ex:enLength2 , ex:enTimeMinus2 .
ex:enMass1 a math:DimensionExponent ;
    math:exponentOfDimension math:massDimension ;
    math:exponentNumerator 1 ; math:exponentDenominator 1 .
ex:enLength2 a math:DimensionExponent ;
    math:exponentOfDimension math:lengthDimension ;
    math:exponentNumerator 2 ; math:exponentDenominator 1 .
ex:enTimeMinus2 a math:DimensionExponent ;
    math:exponentOfDimension math:timeDimension ;
    math:exponentNumerator -2 ; math:exponentDenominator 1 .

ex:restEnergyQ a math:Quantity ;
    math:hasDimension ex:energyDim .
ex:kineticEnergyQ a math:Quantity ;
    math:hasDimension ex:energyDim .
ex:totalEnergyExpr a math:DimensionalExpression ;
    math:homogeneousOperand ex:restEnergyQ , ex:kineticEnergyQ .

# Q10 — a quantity whose QUDT unit realizes its (base) dimension. Its dimension
# (mass) is unique among the fixture quantities, so it has no commensurable peer.
ex:sampleMassQ a math:Quantity ;
    math:hasDimension math:massDimension ;
    math:quantityValue "1"^^xsd:decimal ;
    gmeow:unit <http://qudt.org/vocab/unit/KiloGM> ;
    gmeow:hasReferenceFrame gmeow:referenceFrameSI .

# Q11 — two ordered intervals, each naming both endpoints and both endpoint
# inclusions. A half-open bounded interval [0, 1) (lower closed, upper open) and an
# unbounded interval (0, +∞) whose upper endpoint is the pole math:PositiveInfinity
# (always open, a pole is never a member of ℝ̄).
ex:halfOpenUnit a math:Interval ;
    math:lowerEndpoint "0.0"^^xsd:double ;
    math:upperEndpoint "1.0"^^xsd:double ;
    math:lowerInclusion math:closedEndpoint ;
    math:upperInclusion math:openEndpoint .
ex:positiveReals a math:Interval ;
    math:lowerEndpoint "0.0"^^xsd:double ;
    math:upperEndpoint math:PositiveInfinity ;
    math:lowerInclusion math:openEndpoint ;
    math:upperInclusion math:openEndpoint .
