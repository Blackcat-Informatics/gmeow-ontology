gmeow:walletKey
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CryptoWallet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "wallet key"@x-gmeow-english ;
    rdfs:range gmeow:CryptographicKey ;
    skos:definition "The cryptographic key that controls the wallet. Non-functional: a wallet may be controlled by several keys (multi-sig) or the key may rotate over time."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:walletScheme
    a owl:FunctionalProperty ,
        owl:ObjectProperty ;
    rdfs:domain gmeow:CryptoWallet ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "wallet scheme"@x-gmeow-english ;
    rdfs:range gmeow:WalletScheme ;
    skos:definition "The blockchain scheme of the wallet — Bitcoin, Ethereum, Solana, Monero, etc. Functional: a wallet operates on exactly one scheme (a multi-scheme container is several wallets)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:walletSchemeBTC
    a gmeow:WalletScheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Bitcoin"@x-gmeow-english ;
    skos:definition "The Bitcoin blockchain scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:walletSchemeETH
    a gmeow:WalletScheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Ethereum"@x-gmeow-english ;
    skos:definition "The Ethereum blockchain scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:walletSchemeSOL
    a gmeow:WalletScheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Solana"@x-gmeow-english ;
    skos:definition "The Solana blockchain scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:walletSchemeXMR
    a gmeow:WalletScheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Monero"@x-gmeow-english ;
    skos:definition "The Monero blockchain scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

<https://blackcatinformatics.ca/gmeow/slices/finance>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Personal and SMB financial existence: accounts, monetary amounts, transactions, ledgers, invoices, orders, asset holdings, and crypto wallets. Grounded in the existing Event/Participation/Agreement/Rights/Trust substrate. FIBO, schema.org, ISO 4217, ISO 20022, FIGI and OFX are aligned by reference, never imported.

DOCTRINE.
  * A financial account is an InformationObject (consistent with OnlineAccount): it is fundamentally an information construct — an IBAN, account number, and balance record. The legal/contractual aspect is modelled separately via Agreement (account terms between holder and bank).
  * Money is a MonetaryAmount = amount (xsd:decimal) + currency (ReferenceFrame individual). DL-clean; no arithmetic in OWL.
  * Currency is a ReferenceFrame in the frameRealmCurrency realm (Principle 11 — frame-relativity). Each ISO 4217 code is a ReferenceFrame individual.
  * accountCurrency is NON-FUNCTIONAL: a single FinancialAccount may hold balances in several currencies (multi-currency fintech accounts). The functional constraint moves to Posting/Holding relators.
  * A transaction is a reified Event (REA pattern): money movement with Agent participants in roles (payer / payee / intermediary) — reuse Event/Participation, never re-mint.
  * Double-entry as structure: LedgerAccount (asset / liability / equity / revenue / expense — open vocab), JournalEntry ⊑ Event, Posting ⊑ gufo:Relator (account × amount × debit/credit); balance (Σ debits = Σ credits) enforced by SHACL, not OWL.
  * Loans are Agreements; invoices are Documents; ownership is rights; banks are Organizations; wallets hold trust keys — reuse, don't duplicate.
  * Open value vocabularies, no overtyping (Principle 9): account types, transaction types, transaction statuses, ledger account types, posting directions, asset types, invoice statuses, order statuses, and payment methods are individuals, never subclasses.
  * Flat-first, reify on demand: a flat accountBalance on FinancialAccount covers the 80% case; promote to a Holding relator when cost-basis, period, or provenance matters.
  * Sensitive: P9/P10 + provenance. Reversed/voided transactions are displayable false, retained as the audit trail, never deleted; disputed amounts coexist accordingTo; every figure carries confidence/wasAttributedTo."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "GMEOW Finance Module"@x-gmeow-english ;
    skos:definition "The GMEOW Finance Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .
