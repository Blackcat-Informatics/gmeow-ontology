@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/affect>
    a gmeow:Slice ;
    rdfs:label "affect"@x-gmeow-english ;
    skos:definition "The affect slice of the GMEOW ontology (core tier): GMEOW Affect Module — emotions, appraisals, and the occurrent affective-experience branch. Core because Principle 14 makes affective memory load-bearing for grounded agent memory. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/affect> ;
    dcterms:title "GMEOW Affect Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceProfile "narrative" ;
    gmeow:providesSubcommand "affect" ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/mentation> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/teleology> ,
        <https://blackcatinformatics.ca/gmeow/slices/entities> ,
        <https://blackcatinformatics.ca/gmeow/slices/standpoint> ;
    gmeow:sliceConsumer "The grounded-agent-memory engine (an agent's felt mental life is part of the Principle 14 memory flagship, alongside the kernel gmeow:MentalMoment family), the lbox principia importer (affect/aesthetic annotations), and the narrative arc samples (sampleState draws on EmotionType by soft reference, never dependency). Core and comprehensive: the affect model grows with its consumers, per the fuller design in design/AFFECT-DESIGN.md."@x-gmeow-english.
