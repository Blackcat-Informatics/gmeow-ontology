@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

# SHACL shapes for the software module.
# These guard the five-facet orthogonality and validate instance data.

# The software-facet orthogonality data-check MIGRATED to the named axiom
# gmeow:softwareFacetDisjointness (owl:AllDisjointClasses in the software slice),
# projected to gmeow:SoftwareFacetDisjointnessConstraintShape in
# generated/shapes/constraint-shapes.ttl (P17 single-source).

# --------------------------------------------------------------------------- #
# Commit must carry a content digest (git hash or SWHID).
# --------------------------------------------------------------------------- #

gmeow:CommitContentDigestShape
    a sh:NodeShape ;
    rdfs:label "Commit content digest shape"@x-gmeow-english ;
    sh:targetClass gmeow:Commit ;
    sh:property [
        sh:path gmeow:contentDigest ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Commit must carry at least one gmeow:contentDigest (git hash or SWHID)." ;
    ] .

# --------------------------------------------------------------------------- #
# Release must belong to a project.
# --------------------------------------------------------------------------- #

gmeow:ReleaseProjectShape
    a sh:NodeShape ;
    rdfs:label "Release project shape"@x-gmeow-english ;
    sh:targetClass gmeow:Release ;
    sh:property [
        sh:path gmeow:releaseOf ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Release must be the release of at least one Project." ;
    ] .

# --------------------------------------------------------------------------- #
# Repository must have a repository type.
# --------------------------------------------------------------------------- #

gmeow:RepositoryTypeShape
    a sh:NodeShape ;
    rdfs:label "Repository type shape"@x-gmeow-english ;
    sh:targetClass gmeow:Repository ;
    sh:property [
        sh:path gmeow:repositoryType ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Repository must declare its gmeow:repositoryType." ;
    ] .

# --------------------------------------------------------------------------- #
# Blob must carry a content digest (git hash or SWHID).
# --------------------------------------------------------------------------- #

gmeow:BlobContentDigestShape
    a sh:NodeShape ;
    rdfs:label "Blob content digest shape"@x-gmeow-english ;
    sh:targetClass gmeow:Blob ;
    sh:property [
        sh:path gmeow:contentDigest ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Blob must carry at least one gmeow:contentDigest (git hash or SWHID)." ;
    ] .

# --------------------------------------------------------------------------- #
# TreeEntry must have name, mode, and object.
# --------------------------------------------------------------------------- #

gmeow:TreeEntryCompletenessShape
    a sh:NodeShape ;
    rdfs:label "Tree entry completeness shape"@x-gmeow-english ;
    sh:targetClass gmeow:TreeEntry ;
    sh:property [
        sh:path gmeow:treeEntryName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A TreeEntry must have exactly one gmeow:treeEntryName." ;
    ] ;
    sh:property [
        sh:path gmeow:treeEntryMode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A TreeEntry must have exactly one gmeow:treeEntryMode." ;
    ] ;
    sh:property [
        sh:path gmeow:treeEntryObject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A TreeEntry must have exactly one gmeow:treeEntryObject." ;
    ] .

# --------------------------------------------------------------------------- #
# Diff must have both from and to commits.
# --------------------------------------------------------------------------- #

gmeow:DiffEndpointShape
    a sh:NodeShape ;
    rdfs:label "Diff endpoint shape"@x-gmeow-english ;
    sh:targetClass gmeow:Diff ;
    sh:property [
        sh:path gmeow:diffFrom ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Diff must have a gmeow:diffFrom commit." ;
    ] ;
    sh:property [
        sh:path gmeow:diffTo ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Diff must have a gmeow:diffTo commit." ;
    ] .

# --------------------------------------------------------------------------- #
# Merge must have a merge base and a source ref.
# --------------------------------------------------------------------------- #

gmeow:MergeBaseShape
    a sh:NodeShape ;
    rdfs:label "Merge base shape"@x-gmeow-english ;
    sh:targetClass gmeow:Merge ;
    sh:property [
        sh:path gmeow:mergeBase ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Merge must have a gmeow:mergeBase commit." ;
    ] ;
    sh:property [
        sh:path gmeow:mergeSource ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Merge must have a gmeow:mergeSource ref." ;
    ] ;
    sh:property [
        sh:path gmeow:mergeTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Merge must have exactly one gmeow:mergeTarget ref." ;
    ] .
