math:monotoneNonDecreaseImpl a logic:Formula ;
    logic:antecedent math:monotoneNonDecreaseAnte ;
    logic:consequent math:monotoneNonDecreaseCons .

math:monotoneNonDecreaseAnte a logic:Formula ;
    logic:and math:ndA1 , math:ndA2 , math:ndA3 , math:ndA4 .

