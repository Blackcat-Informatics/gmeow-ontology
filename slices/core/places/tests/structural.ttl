    gmeow:saRationale "No preferred*/primary* capacity/occupancy/utilization selectors MUST NOT exist (Principle 9, co-equality)." .

# --- 66. VirtualLocationType subclasses logic:QualityValue (MUST) --------------
ex:saVirtualLocationTypeIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:VirtualLocationType rdfs:subClassOf logic:QualityValue .
    gmeow:virtualLocationType a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:VirtualLocationType MUST be a subclass of logic:QualityValue and gmeow:virtualLocationType MUST be an owl:ObjectProperty." .

# --- 67. virtualLocationType is NOT functional (MUST-NOT) ---------------------
ex:saVirtualLocationTypeNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:virtualLocationType a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:virtualLocationType MUST NOT be owl:FunctionalProperty -- a virtual location may have multiple co-equal type claims (Principle 9)." .

# --- 68. VirtualLocationType seed individuals exist (MUST) --------------------
ex:saVirtualLocationTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
