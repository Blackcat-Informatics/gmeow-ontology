@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix gx: <http://gedcomx.org/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .

# Term equivalences for the names domain — GMEOW authoring source.
# Compiled to mappings/gmeow-names.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetNames a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-names.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/names" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Name alignments for comprehensive, multi-culture interop — schema.org, vCard 4 (N components, nickname, fn), GEDCOM X (gx:) name parts, FOAF, and a few well-established Wikidata properties. Multi-cultural name-part KINDS (gmeow:NamePartType value individuals such as namePartGiven/namePartSurname) align closeMatch to the nearest external concept, following the places.ttl idiom; there are no flat given/family name properties — a 'First Last' rendering is produced by downcasting the structured gmeow:NamePart model in the projection layer (projections/*). PronounSet, NameRegister, NameUsage and the inclusivity machinery (displayable, namePurposeChosen/Deadname) are largely CANONICAL — no maintained external RDF vocabulary covers them faithfully; co-equality of multilingual names is a structural stance, not an external mapping. Coreference of name INSTANCES is done in data, not here." .

gmeow:eqNames001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:fullName ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:name ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:sssomFile "gmeow-names.sssom.tsv" .

gmeow:eqNames002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:fullName ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject vcard:fn ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-names.sssom.tsv" .

