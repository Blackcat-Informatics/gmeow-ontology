@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:  <https://schema.org/> .

# Projection mappings: GMEOW Procedure / ProcedureStep / Execution → schema.org
# HowTo / HowToStep / Recipe / Action. Compiled to
# projections/schema-org-procedures.edoal.ttl + queries/projections/schema-org-procedures.rq
# by `gmeow compile-mappings`.

# --------------------------------------------------------------------------- #
# Procedure → schema:HowTo (default) or schema:Recipe (when procedureType = recipe)
# --------------------------------------------------------------------------- #

gmeow:mapSchemaHowTo a gmeow:ProjectionMapping ;
    rdfs:label "Procedure → schema:HowTo"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "proc" ;
        gmeow:atom (
            [ gmeow:subjectVar "proc" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Procedure ]
            [ gmeow:subjectVar "proc" ; gmeow:predicate gmeow:procedureType ; gmeow:objectValue gmeow:procedureTypeRecipe ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "proc" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:HowTo ] ) ] .

gmeow:mapSchemaRecipe a gmeow:ProjectionMapping ;
    rdfs:label "Procedure (type=recipe) → schema:Recipe"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "recipe" ;
        gmeow:atom (
            [ gmeow:subjectVar "recipe" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Procedure ]
            [ gmeow:subjectVar "recipe" ; gmeow:predicate gmeow:procedureType ; gmeow:objectValue gmeow:procedureTypeRecipe ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "recipe" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:Recipe ] ) ] .

# --------------------------------------------------------------------------- #
# ProcedureStep → schema:HowToStep
# --------------------------------------------------------------------------- #

gmeow:mapSchemaHowToStep a gmeow:ProjectionMapping ;
    rdfs:label "ProcedureStep → schema:HowToStep"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "step" ;
        gmeow:atom (
            [ gmeow:subjectVar "step" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:ProcedureStep ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "step" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:HowToStep ] ) ] .

# --------------------------------------------------------------------------- #
# hasProcedureStep → schema:step
# --------------------------------------------------------------------------- #

gmeow:mapSchemaStep a gmeow:ProjectionMapping ;
    rdfs:label "hasProcedureStep → schema:step"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "proc" ; gmeow:value "step" ;
        gmeow:atom ( [ gmeow:subjectVar "proc" ; gmeow:predicate gmeow:hasProcedureStep ; gmeow:objectVar "step" ] ) ;
        gmeow:edoalSource gmeow:hasProcedureStep ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:step ; gmeow:relation "<=" ; gmeow:confidence 0.9 ] .

# --------------------------------------------------------------------------- #
# stepInput → schema:supply / schema:tool
# --------------------------------------------------------------------------- #

gmeow:mapSchemaSupply a gmeow:ProjectionMapping ;
    rdfs:label "stepInput → schema:supply"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "step" ; gmeow:value "inp" ;
        gmeow:atom ( [ gmeow:subjectVar "step" ; gmeow:predicate gmeow:stepInput ; gmeow:objectVar "inp" ] ) ;
        gmeow:edoalSource gmeow:stepInput ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:supply ; gmeow:relation "<=" ; gmeow:confidence 0.75 ;
        gmeow:lossyDrop "the typed stepInput collapses to a flat schema:supply edge" ] .

gmeow:mapSchemaTool a gmeow:ProjectionMapping ;
    rdfs:label "stepInput (tool) → schema:tool"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "step" ; gmeow:value "tool" ;
        gmeow:atom (
            [ gmeow:subjectVar "step" ; gmeow:predicate gmeow:stepInput ; gmeow:objectVar "tool" ]
            [ gmeow:subjectVar "tool" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:PhysicalObject ] ) ;
        gmeow:edoalSource gmeow:stepInput ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:tool ; gmeow:relation "<=" ; gmeow:confidence 0.7 ;
        gmeow:lossyDrop "the typed stepInput collapses to a flat schema:tool edge when the input is a physical object" ] .

# --------------------------------------------------------------------------- #
# stepOutput → schema:result
# --------------------------------------------------------------------------- #

gmeow:mapSchemaResult a gmeow:ProjectionMapping ;
    rdfs:label "stepOutput → schema:result"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "step" ; gmeow:value "out" ;
        gmeow:atom ( [ gmeow:subjectVar "step" ; gmeow:predicate gmeow:stepOutput ; gmeow:objectVar "out" ] ) ;
        gmeow:edoalSource gmeow:stepOutput ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:result ; gmeow:relation "<=" ; gmeow:confidence 0.75 ;
        gmeow:lossyDrop "the typed stepOutput collapses to a flat schema:result edge" ] .

# --------------------------------------------------------------------------- #
# Execution → schema:Action (lossy — schema.org has no plan/execution split)
# --------------------------------------------------------------------------- #

gmeow:mapSchemaAction a gmeow:ProjectionMapping ;
    rdfs:label "Execution → schema:Action"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "exec" ;
        gmeow:atom (
            [ gmeow:subjectVar "exec" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Execution ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ;
        gmeow:lossyDrop "schema.org has no plan/execution de-conflation; the Execution is projected as a flat Action" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "exec" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:Action ] ) ] .
