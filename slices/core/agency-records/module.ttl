                            [ a logic:Formula ; logic:relation gmeow:guidanceAhead ; logic:argument [ logic:termIndex 0 ; logic:termVariable "a2SecondOffer" ] , [ logic:termIndex 1 ; logic:termVariable "aheadAnchor" ] ] ] ;
                        logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "a2FirstOffer" ] , [ logic:termIndex 1 ; logic:termVariable "a2SecondOffer" ] ] ] ] ,
