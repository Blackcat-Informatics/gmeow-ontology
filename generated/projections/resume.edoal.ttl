@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .

<https://blackcatinformatics.ca/gmeow/projections/resume>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Relation ;
            edoal:compose ( [
                a edoal:Relation ;
                edoal:uri gmeow:employmentInterval ;
            ] [
                a edoal:Relation ;
                edoal:uri gmeow:endedAtTime ;
            ] ) ;
        ] ;
        align:entity2 [
            a edoal:Property ;
            edoal:uri schema:endDate ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.9"^^xsd:double ;
        rdfs:label "Employment interval end → schema:endDate"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:compose ( [
                    a edoal:Relation ;
                    edoal:uri gmeow:employmentInterval ;
                ] [
                    a edoal:Relation ;
                    edoal:uri gmeow:startedAtTime ;
                ] ) ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri schema:startDate ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "Employment interval start → schema:startDate"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:compose ( [
                    a edoal:Relation ;
                    edoal:uri gmeow:employmentType ;
                ] [
                    a edoal:Relation ;
                    edoal:uri rdfs:label ;
                ] ) ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri schema:employmentType ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "Employment type → schema:employmentType"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:compose ( [
                    a edoal:Relation ;
                    edoal:uri gmeow:hasRole ;
                ] [
                    a edoal:Relation ;
                    edoal:or ( [
                        a edoal:Relation ;
                        edoal:uri rdfs:label ;
                    ] [
                        a edoal:Relation ;
                        edoal:uri gmeow:name ;
                    ] ) ;
                ] ) ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri schema:jobTitle ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnMembershipToJobTitle ;
            ] ;
            rdfs:label "Employment role → schema:jobTitle (resume profile)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:membershipOrganization ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri schema:worksFor ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "Employment organization → schema:worksFor (resume profile)"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "resume" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → resume (EDOAL)"@en .
