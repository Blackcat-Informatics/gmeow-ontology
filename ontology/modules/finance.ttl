@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/finance>
    a owl:Ontology ;
    rdfs:label "GMEOW Finance Module"@x-gmeow-english ;
    rdfs:comment """Personal and SMB financial existence: accounts, monetary amounts, transactions, ledgers, invoices, orders, asset holdings, and crypto wallets. Grounded in the existing Event/Participation/Agreement/Rights/Trust substrate. FIBO, schema.org, ISO 4217, ISO 20022, FIGI and OFX are aligned by reference, never imported.

DOCTRINE.
  * A financial account is an InformationObject (consistent with OnlineAccount): it is fundamentally an information construct — an IBAN, account number, and balance record. The legal/contractual aspect is modelled separately via Agreement (account terms between holder and bank).
  * Money is a MonetaryAmount = amount (xsd:decimal) + currency (ReferenceFrame individual). DL-clean; no arithmetic in OWL.
  * Currency is a ReferenceFrame in the frameRealmCurrency realm (Principle 11 — frame-relativity). Each ISO 4217 code is a ReferenceFrame individual.
  * accountCurrency is NON-FUNCTIONAL: a single FinancialAccount may hold balances in several currencies (multi-currency fintech accounts). The functional constraint moves to Posting/Holding relators.
  * A transaction is a reified Event (REA pattern): money movement with Agent participants in roles (payer / payee / intermediary) — reuse Event/Participation, never re-mint.
  * Double-entry as structure: LedgerAccount (asset / liability / equity / revenue / expense — open vocab), JournalEntry ⊑ Event, Posting ⊑ gufo:Relator (account × amount × debit/credit); balance (Σ debits = Σ credits) enforced by SHACL, not OWL.
  * Loans are Agreements; invoices are Documents; ownership is rights; banks are Organizations; wallets hold trust keys — reuse, don't duplicate.
  * Open value vocabularies, no overtyping (Principle 9): account types, transaction types, transaction statuses, ledger account types, posting directions, asset types, invoice statuses, order statuses, and payment methods are individuals, never subclasses.
  * Flat-first, reify on demand: a flat accountBalance on FinancialAccount covers the 80% case; promote to a Holding relator when cost-basis, period, or provenance matters.
  * Sensitive: P9/P10 + provenance. Reversed/voided transactions are displayable false, retained as the audit trail, never deleted; disputed amounts coexist accordingTo; every figure carries confidence/wasAttributedTo."""@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# FinancialAccount — bank / credit / investment / wallet account.
# Distinct from OnlineAccount (social profiles, decentralized identity).
# --------------------------------------------------------------------------- #

gmeow:FinancialAccount
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:InformationObject ;
    owl:disjointWith gmeow:OnlineAccount ;
    rdfs:label "Financial Account"@x-gmeow-english ;
    skos:definition "A financial account held by an agent with a financial institution — a bank account, credit card, investment account, or wallet. Distinct from OnlineAccount (social profiles, decentralized identity): this is the financial-existence layer. The account's legal terms are modelled as an Agreement between the holder and the institution."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:accountHolder
    a owl:ObjectProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:range gmeow:Agent ;
    rdfs:label "account holder"@x-gmeow-english ;
    skos:definition "Relates a financial account to the agent that holds it. Non-functional: a joint account has several co-equal holders."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:accountCurrency
    a owl:ObjectProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:range gmeow:ReferenceFrame ;
    rdfs:label "account currency"@x-gmeow-english ;
    skos:definition "The currency(ies) of a financial account, drawn from the open currency reference-frame vocabulary (gmeow:frameRealmCurrency). NON-FUNCTIONAL: a single account may hold balances in several currencies (multi-currency fintech accounts)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:accountNumber
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:range rdfs:Literal ;
    rdfs:label "account number"@x-gmeow-english ;
    skos:definition "The account number identifying the financial account at its institution. Not functional: different sources may report differing formats."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:iban
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:range rdfs:Literal ;
    rdfs:label "IBAN"@x-gmeow-english ;
    skos:definition "The International Bank Account Number (ISO 13616) of a bank account."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:bic
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:range rdfs:Literal ;
    rdfs:label "BIC"@x-gmeow-english ;
    skos:definition "The Bank Identifier Code (ISO 9362, SWIFT code) of the institution holding the account."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:accountBalance
    a owl:ObjectProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:range gmeow:MonetaryAmount ;
    rdfs:label "account balance"@x-gmeow-english ;
    skos:definition "The current balance of a financial account, expressed as a MonetaryAmount. Non-functional: a multi-currency account has several balances, and competing standpoint-indexed balance claims coexist (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:accountType
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:FinancialAccount ;
    rdfs:range gmeow:FinancialAccountType ;
    rdfs:label "account type"@x-gmeow-english ;
    skos:definition "The kind of financial account — one of the open gmeow:FinancialAccountType values (bank, credit, investment, wallet). Functional: an account has one canonical type; several types are several accounts."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# MonetaryAmount — a quantity of money: value + currency frame.
# --------------------------------------------------------------------------- #

gmeow:MonetaryAmount
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity ;
    rdfs:label "Monetary Amount"@x-gmeow-english ;
    skos:definition "A quantity of money expressed as a decimal value in an explicit currency reference frame. The canonical superset of schema:MonetaryAmount and FIBO fibo-fnd-acc-cur:MonetaryAmount. Frame-relative (Principle 11): a value without its currency frame is ill-formed."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:monetaryValue
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:MonetaryAmount ;
    rdfs:range xsd:decimal ;
    rdfs:label "monetary value"@x-gmeow-english ;
    skos:definition "The numeric value of a monetary amount as an xsd:decimal. Functional: a MonetaryAmount has exactly one numeric value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:currency
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf gmeow:hasReferenceFrame ;
    rdfs:domain gmeow:MonetaryAmount ;
    rdfs:range gmeow:ReferenceFrame ;
    rdfs:label "currency"@x-gmeow-english ;
    skos:definition "The currency reference frame in which this monetary amount is expressed. Functional: a MonetaryAmount is in exactly one currency frame. A subproperty of gmeow:hasReferenceFrame (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Financial account type — an OPEN value vocabulary (gufo:QualityValue).
# --------------------------------------------------------------------------- #

gmeow:FinancialAccountType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Financial Account Type"@x-gmeow-english ;
    skos:definition "The kind of a financial account — a VALUE, never a FinancialAccount subclass. The set is open; a kind not among the seeds is a FRESH gmeow:FinancialAccountType individual carrying rdfs:label. Pointed at by gmeow:accountType."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:accountTypeBank       a gmeow:FinancialAccountType ; rdfs:label "bank account"@x-gmeow-english ;       skos:definition "A deposit or chequing account at a bank or credit union."@x-gmeow-english .
gmeow:accountTypeCredit     a gmeow:FinancialAccountType ; rdfs:label "credit account"@x-gmeow-english ;     skos:definition "A credit card or line-of-credit account."@x-gmeow-english .
gmeow:accountTypeInvestment a gmeow:FinancialAccountType ; rdfs:label "investment account"@x-gmeow-english ; skos:definition "A brokerage, retirement, or other investment holdings account."@x-gmeow-english .
gmeow:accountTypeWallet     a gmeow:FinancialAccountType ; rdfs:label "wallet"@x-gmeow-english ;            skos:definition "A digital wallet — fiat or crypto — held by an agent."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Transaction type and status — declared now for Phase B; seeds in Phase B.
# --------------------------------------------------------------------------- #

gmeow:TransactionType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Transaction Type"@x-gmeow-english ;
    skos:definition "The kind of a financial transaction — a VALUE, never a subclass. Open vocabulary; seeds in Phase B."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:TransactionStatus
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Transaction Status"@x-gmeow-english ;
    skos:definition "The status of a financial transaction — a VALUE, never a subclass. Open vocabulary; seeds in Phase B."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# AXIOMATIZED DOCTRINE — relator mediation (EL someValuesFrom, open-world).
# Closed-world cardinality is SHACL's (gmeow-shapes.ttl).
# =========================================================================== #

gmeow:FinancialAccount rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:accountHolder ; owl:someValuesFrom gmeow:Agent ] .

gmeow:MonetaryAmount rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:currency ; owl:someValuesFrom gmeow:ReferenceFrame ] .


# =========================================================================== #
# PHASE B — Transactions & Double-Entry Ledger
# =========================================================================== #

# --------------------------------------------------------------------------- #
# FinancialTransaction — a money-movement event (REA pattern).
# Reuses Event/Participation; payer/payee are ParticipantRole values, not
# subproperties.  transactionType and transactionStatus are open value vocabularies.
# --------------------------------------------------------------------------- #

gmeow:FinancialTransaction
    a owl:Class, gufo:EventType ;
    rdfs:subClassOf gmeow:Event ;
    rdfs:label "Financial Transaction"@x-gmeow-english ;
    skos:definition "A money-movement event — a payment, transfer, deposit, withdrawal, fee, interest, or refund. Reuses the Event/Participation substrate: payer, payee, and intermediary are ParticipantRole values on Participation relators, never subproperties. The kind of transaction is a TransactionType value; the status is a TransactionStatus value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:transactionAmount
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:FinancialTransaction ;
    rdfs:range gmeow:MonetaryAmount ;
    rdfs:label "transaction amount"@x-gmeow-english ;
    skos:definition "The monetary amount of a financial transaction, expressed as a MonetaryAmount. Functional: a single transaction occurrence has one canonical amount (disputed amounts are standpoint-indexed claims on separate statements, not additional values on the same transaction)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:transactionType
    a owl:ObjectProperty ;
    rdfs:domain gmeow:FinancialTransaction ;
    rdfs:range gmeow:TransactionType ;
    rdfs:label "transaction type"@x-gmeow-english ;
    skos:definition "The kind(s) of a financial transaction, drawn from the open TransactionType value vocabulary. Non-functional: a transaction may carry several types, and competing standpoint-indexed type claims coexist."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:transactionStatus
    a owl:ObjectProperty ;
    rdfs:domain gmeow:FinancialTransaction ;
    rdfs:range gmeow:TransactionStatus ;
    rdfs:label "transaction status"@x-gmeow-english ;
    skos:definition "The status(es) of a financial transaction, drawn from the open TransactionStatus value vocabulary. Non-functional: a transaction may progress through several statuses over time, recorded as co-equal standpoint-indexed claims."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# LedgerAccount — a book-keeping account (asset / liability / equity / revenue /
# expense).  An InformationObject, distinct from FinancialAccount (the bank-level
# account construct).
# --------------------------------------------------------------------------- #

gmeow:LedgerAccount
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:InformationObject ;
    rdfs:label "Ledger Account"@x-gmeow-english ;
    skos:definition "A book-keeping account in a double-entry ledger — an asset, liability, equity, revenue, or expense account. An InformationObject distinct from FinancialAccount: a LedgerAccount is a conceptual book-keeping construct, while a FinancialAccount is a bank-level account with IBAN/BIC/number."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:ledgerAccountType
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:LedgerAccount ;
    rdfs:range gmeow:LedgerAccountType ;
    rdfs:label "ledger account type"@x-gmeow-english ;
    skos:definition "The kind of ledger account — one of the open LedgerAccountType values (asset, liability, equity, revenue, expense). Functional: a ledger account has one canonical type."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:ledgerAccountHolder
    a owl:ObjectProperty ;
    rdfs:domain gmeow:LedgerAccount ;
    rdfs:range gmeow:Agent ;
    rdfs:label "ledger account holder"@x-gmeow-english ;
    skos:definition "The agent that holds the ledger account. Non-functional: a jointly maintained ledger account has several co-equal holders."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:ledgerAccountCurrency
    a owl:ObjectProperty ;
    rdfs:domain gmeow:LedgerAccount ;
    rdfs:range gmeow:ReferenceFrame ;
    rdfs:label "ledger account currency"@x-gmeow-english ;
    skos:definition "The currency(ies) in which the ledger account tracks balances. Non-functional: a single logical ledger account may track several currency buckets (multi-currency bookkeeping). The functional constraint moves to individual Posting relators."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# JournalEntry — a balanced double-entry event.  Subclass of Event because it is
# a temporal occurrence (the act of recording the entry).
# --------------------------------------------------------------------------- #

gmeow:JournalEntry
    a owl:Class, gufo:EventType ;
    rdfs:subClassOf gmeow:Event ;
    rdfs:label "Journal Entry"@x-gmeow-english ;
    skos:definition "A balanced double-entry bookkeeping event: a temporal occurrence in which debits equal credits (per currency bucket). Composed of two or more Posting relators."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:journalEntryPostings
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:postingJournalEntry ;
    rdfs:domain gmeow:JournalEntry ;
    rdfs:range gmeow:Posting ;
    rdfs:label "journal entry postings"@x-gmeow-english ;
    skos:definition "The postings that compose a journal entry. Non-functional: a journal entry has at least two postings (SHACL-enforced)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Posting — the relator connecting a journal entry to a ledger account with an
# amount and a direction (debit or credit).
# --------------------------------------------------------------------------- #

gmeow:Posting
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Posting"@x-gmeow-english ;
    skos:definition "A reified relator connecting a journal entry to a ledger account with a monetary amount and a posting direction (debit or credit). The atomic unit of double-entry bookkeeping."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:postingJournalEntry
    a owl:ObjectProperty, owl:FunctionalProperty ;
    owl:inverseOf gmeow:journalEntryPostings ;
    rdfs:domain gmeow:Posting ;
    rdfs:range gmeow:JournalEntry ;
    rdfs:label "posting journal entry"@x-gmeow-english ;
    skos:definition "The journal entry this posting belongs to. Functional: a posting belongs to exactly one journal entry."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:postingAccount
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Posting ;
    rdfs:range gmeow:LedgerAccount ;
    rdfs:label "posting account"@x-gmeow-english ;
    skos:definition "The ledger account this posting affects. Functional: a posting affects exactly one ledger account."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:postingAmount
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Posting ;
    rdfs:range gmeow:MonetaryAmount ;
    rdfs:label "posting amount"@x-gmeow-english ;
    skos:definition "The monetary amount of this posting, expressed as a MonetaryAmount with explicit currency frame. Functional: a posting has exactly one amount."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:postingDirection
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Posting ;
    rdfs:range gmeow:PostingDirection ;
    rdfs:label "posting direction"@x-gmeow-english ;
    skos:definition "The direction of this posting — debit or credit. Functional: a posting is exactly one direction."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Ledger account type — an OPEN value vocabulary.
# --------------------------------------------------------------------------- #

gmeow:LedgerAccountType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Ledger Account Type"@x-gmeow-english ;
    skos:definition "The kind of a ledger account — a VALUE, never a LedgerAccount subclass. The set is open; a kind not among the seeds is a FRESH LedgerAccountType individual carrying rdfs:label. Pointed at by gmeow:ledgerAccountType."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:ledgerAccountTypeAsset     a gmeow:LedgerAccountType ; rdfs:label "asset"@x-gmeow-english ;     skos:definition "An asset account — resources owned by the entity (cash, receivables, inventory, equipment)."@x-gmeow-english .
gmeow:ledgerAccountTypeLiability a gmeow:LedgerAccountType ; rdfs:label "liability"@x-gmeow-english ; skos:definition "A liability account — obligations owed by the entity (payables, loans, accrued expenses)."@x-gmeow-english .
gmeow:ledgerAccountTypeEquity    a gmeow:LedgerAccountType ; rdfs:label "equity"@x-gmeow-english ;    skos:definition "An equity account — the residual interest in the assets after deducting liabilities (owner capital, retained earnings)."@x-gmeow-english .
gmeow:ledgerAccountTypeRevenue   a gmeow:LedgerAccountType ; rdfs:label "revenue"@x-gmeow-english ;   skos:definition "A revenue account — income generated from normal business operations (sales, fees, interest income)."@x-gmeow-english .
gmeow:ledgerAccountTypeExpense   a gmeow:LedgerAccountType ; rdfs:label "expense"@x-gmeow-english ;   skos:definition "An expense account — costs incurred in the process of generating revenue (salaries, rent, utilities, supplies)."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Posting direction — an OPEN value vocabulary (debit / credit).
# --------------------------------------------------------------------------- #

gmeow:PostingDirection
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Posting Direction"@x-gmeow-english ;
    skos:definition "The direction of a posting in double-entry bookkeeping — a VALUE, never a subclass. Only debit and credit are seeded; the vocabulary is closed in practice but modelled as open for consistency."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:postingDirectionDebit  a gmeow:PostingDirection ; rdfs:label "debit"@x-gmeow-english ;  skos:definition "A debit posting — an entry on the left side of a ledger account."@x-gmeow-english .
gmeow:postingDirectionCredit a gmeow:PostingDirection ; rdfs:label "credit"@x-gmeow-english ; skos:definition "A credit posting — an entry on the right side of a ledger account."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Transaction type — seeds for Phase B.
# --------------------------------------------------------------------------- #

gmeow:transactionTypePayment    a gmeow:TransactionType ; rdfs:label "payment"@x-gmeow-english ;    skos:definition "A payment transaction — money sent from one agent to another."@x-gmeow-english .
gmeow:transactionTypeTransfer   a gmeow:TransactionType ; rdfs:label "transfer"@x-gmeow-english ;   skos:definition "A transfer transaction — money moved between accounts held by the same agent."@x-gmeow-english .
gmeow:transactionTypeDeposit    a gmeow:TransactionType ; rdfs:label "deposit"@x-gmeow-english ;    skos:definition "A deposit transaction — money added to an account."@x-gmeow-english .
gmeow:transactionTypeWithdrawal a gmeow:TransactionType ; rdfs:label "withdrawal"@x-gmeow-english ; skos:definition "A withdrawal transaction — money removed from an account."@x-gmeow-english .
gmeow:transactionTypeFee        a gmeow:TransactionType ; rdfs:label "fee"@x-gmeow-english ;        skos:definition "A fee transaction — a charge levied by a financial institution or service provider."@x-gmeow-english .
gmeow:transactionTypeInterest   a gmeow:TransactionType ; rdfs:label "interest"@x-gmeow-english ;   skos:definition "An interest transaction — interest earned or charged on an account balance."@x-gmeow-english .
gmeow:transactionTypeRefund     a gmeow:TransactionType ; rdfs:label "refund"@x-gmeow-english ;     skos:definition "A refund transaction — money returned to the payer."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Transaction status — seeds for Phase B.
# --------------------------------------------------------------------------- #

gmeow:transactionStatusPending    a gmeow:TransactionStatus ; rdfs:label "pending"@x-gmeow-english ;    skos:definition "A transaction that has been initiated but not yet settled."@x-gmeow-english .
gmeow:transactionStatusCompleted  a gmeow:TransactionStatus ; rdfs:label "completed"@x-gmeow-english ;  skos:definition "A transaction that has been fully processed and settled."@x-gmeow-english .
gmeow:transactionStatusReversed   a gmeow:TransactionStatus ; rdfs:label "reversed"@x-gmeow-english ;   skos:definition "A transaction that has been reversed or voided. The original transaction record is retained with displayable false (Principle 10); the reversal is a separate event."@x-gmeow-english .
gmeow:transactionStatusFailed     a gmeow:TransactionStatus ; rdfs:label "failed"@x-gmeow-english ;     skos:definition "A transaction that failed to complete."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Participant role seeds for financial events — payer, payee, intermediary.
# These extend the open ParticipantRole vocabulary in the events module.
# --------------------------------------------------------------------------- #

gmeow:rolePayer         a gmeow:ParticipantRole ; rdfs:label "payer"@x-gmeow-english ;         skos:definition "The agent that sends money in a financial transaction."@x-gmeow-english .
gmeow:rolePayee         a gmeow:ParticipantRole ; rdfs:label "payee"@x-gmeow-english ;         skos:definition "The agent that receives money in a financial transaction."@x-gmeow-english .
gmeow:roleIntermediary  a gmeow:ParticipantRole ; rdfs:label "intermediary"@x-gmeow-english ;  skos:definition "An intermediary agent in a financial transaction — a bank, payment processor, or clearing house."@x-gmeow-english .

# =========================================================================== #
# PHASE C — Payments, Invoices, Orders, Assets & Holdings
# =========================================================================== #

# --------------------------------------------------------------------------- #
# Payment — a payment event (thin subclass of FinancialTransaction).
# Carries paymentMethod when the medium of payment matters.
# --------------------------------------------------------------------------- #

gmeow:Payment
    a owl:Class, gufo:EventType ;
    rdfs:subClassOf gmeow:FinancialTransaction ;
    rdfs:label "Payment"@x-gmeow-english ;
    skos:definition "A payment event — a financial transaction whose purpose is to discharge an obligation or transfer value. A thin subclass of FinancialTransaction distinguished by the paymentMethod facet."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:paymentMethod
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Payment ;
    rdfs:range gmeow:PaymentMethod ;
    rdfs:label "payment method"@x-gmeow-english ;
    skos:definition "The method of payment — cash, cheque, credit card, bank transfer, cryptocurrency, etc. Non-functional: a single payment may involve several methods (e.g. split payment)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Payment method — an OPEN value vocabulary.
# --------------------------------------------------------------------------- #

gmeow:PaymentMethod
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Payment Method"@x-gmeow-english ;
    skos:definition "The method or instrument used to make a payment — a VALUE, never a subclass. Open vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:paymentMethodCash         a gmeow:PaymentMethod ; rdfs:label "cash"@x-gmeow-english ;         skos:definition "Payment made in physical currency."@x-gmeow-english .
gmeow:paymentMethodCheque       a gmeow:PaymentMethod ; rdfs:label "cheque"@x-gmeow-english ;       skos:definition "Payment made by cheque."@x-gmeow-english .
gmeow:paymentMethodCreditCard   a gmeow:PaymentMethod ; rdfs:label "credit card"@x-gmeow-english ;  skos:definition "Payment made by credit card."@x-gmeow-english .
gmeow:paymentMethodBankTransfer a gmeow:PaymentMethod ; rdfs:label "bank transfer"@x-gmeow-english ; skos:definition "Payment made by bank transfer or wire."@x-gmeow-english .
gmeow:paymentMethodCrypto       a gmeow:PaymentMethod ; rdfs:label "cryptocurrency"@x-gmeow-english ; skos:definition "Payment made in cryptocurrency."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Invoice — a billing document (⊑ Document).
# --------------------------------------------------------------------------- #

gmeow:Invoice
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Document ;
    rdfs:label "Invoice"@x-gmeow-english ;
    skos:definition "A billing document issued by a seller to a buyer, requesting payment for goods or services rendered. A subclass of Document."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:invoiceAmount
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Invoice ;
    rdfs:range gmeow:MonetaryAmount ;
    rdfs:label "invoice amount"@x-gmeow-english ;
    skos:definition "The total monetary amount requested by the invoice, expressed as a MonetaryAmount. Functional: an invoice has one canonical total amount."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:invoiceIssuer
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Invoice ;
    rdfs:range gmeow:Agent ;
    rdfs:label "invoice issuer"@x-gmeow-english ;
    skos:definition "The agent that issued the invoice. Non-functional: a jointly issued invoice has several co-equal issuers."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:invoiceRecipient
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Invoice ;
    rdfs:range gmeow:Agent ;
    rdfs:label "invoice recipient"@x-gmeow-english ;
    skos:definition "The agent that is being billed. Non-functional: a jointly billed party has several recipients."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:invoiceDueDate
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Invoice ;
    rdfs:range xsd:dateTime ;
    rdfs:label "invoice due date"@x-gmeow-english ;
    skos:definition "The date and time by which payment is due (xsd:dateTime — DL-clean, never xsd:date). Non-functional: competing standpoint-indexed due dates coexist."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:invoiceStatus
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Invoice ;
    rdfs:range gmeow:InvoiceStatus ;
    rdfs:label "invoice status"@x-gmeow-english ;
    skos:definition "The status of an invoice, drawn from the open InvoiceStatus value vocabulary. Non-functional: an invoice may progress through several statuses over time."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Invoice status — an OPEN value vocabulary.
# --------------------------------------------------------------------------- #

gmeow:InvoiceStatus
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Invoice Status"@x-gmeow-english ;
    skos:definition "The status of an invoice — a VALUE, never a subclass. Open vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:invoiceStatusDraft     a gmeow:InvoiceStatus ; rdfs:label "draft"@x-gmeow-english ;     skos:definition "An invoice that has been created but not yet sent."@x-gmeow-english .
gmeow:invoiceStatusSent     a gmeow:InvoiceStatus ; rdfs:label "sent"@x-gmeow-english ;      skos:definition "An invoice that has been sent to the recipient."@x-gmeow-english .
gmeow:invoiceStatusPaid     a gmeow:InvoiceStatus ; rdfs:label "paid"@x-gmeow-english ;      skos:definition "An invoice that has been paid in full."@x-gmeow-english .
gmeow:invoiceStatusOverdue  a gmeow:InvoiceStatus ; rdfs:label "overdue"@x-gmeow-english ;   skos:definition "An invoice whose due date has passed without payment."@x-gmeow-english .
gmeow:invoiceStatusCancelled a gmeow:InvoiceStatus ; rdfs:label "cancelled"@x-gmeow-english ; skos:definition "An invoice that has been cancelled. Retained with displayable false, never deleted (Principle 10)."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Order — a purchase or sales order (⊑ Agreement).
# --------------------------------------------------------------------------- #

gmeow:Order
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Agreement ;
    rdfs:label "Order"@x-gmeow-english ;
    skos:definition "A purchase order or sales order — an agreement between a buyer and a seller for the supply of goods or services at a stated price. A subclass of Agreement."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:orderAmount
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Order ;
    rdfs:range gmeow:MonetaryAmount ;
    rdfs:label "order amount"@x-gmeow-english ;
    skos:definition "The total monetary amount of the order, expressed as a MonetaryAmount. Functional: an order has one canonical total amount."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:orderBuyer
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Order ;
    rdfs:range gmeow:Agent ;
    rdfs:label "order buyer"@x-gmeow-english ;
    skos:definition "The agent placing the order. Non-functional: a joint purchase has several buyers."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:orderSeller
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Order ;
    rdfs:range gmeow:Agent ;
    rdfs:label "order seller"@x-gmeow-english ;
    skos:definition "The agent fulfilling the order. Non-functional: a jointly fulfilled order has several sellers."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:orderStatus
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Order ;
    rdfs:range gmeow:OrderStatus ;
    rdfs:label "order status"@x-gmeow-english ;
    skos:definition "The status of an order, drawn from the open OrderStatus value vocabulary. Non-functional: an order may progress through several statuses."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Order status — an OPEN value vocabulary.
# --------------------------------------------------------------------------- #

gmeow:OrderStatus
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Order Status"@x-gmeow-english ;
    skos:definition "The status of an order — a VALUE, never a subclass. Open vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:orderStatusPending    a gmeow:OrderStatus ; rdfs:label "pending"@x-gmeow-english ;    skos:definition "An order that has been placed but not yet confirmed."@x-gmeow-english .
gmeow:orderStatusConfirmed  a gmeow:OrderStatus ; rdfs:label "confirmed"@x-gmeow-english ;  skos:definition "An order that has been confirmed by the seller."@x-gmeow-english .
gmeow:orderStatusShipped   a gmeow:OrderStatus ; rdfs:label "shipped"@x-gmeow-english ;   skos:definition "An order whose goods have been shipped."@x-gmeow-english .
gmeow:orderStatusDelivered a gmeow:OrderStatus ; rdfs:label "delivered"@x-gmeow-english ; skos:definition "An order whose goods have been delivered."@x-gmeow-english .
gmeow:orderStatusCancelled a gmeow:OrderStatus ; rdfs:label "cancelled"@x-gmeow-english ; skos:definition "An order that has been cancelled. Retained with displayable false, never deleted (Principle 10)."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Asset — a financial asset (stock, bond, cryptocurrency, real estate, commodity).
# --------------------------------------------------------------------------- #

gmeow:Asset
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:Entity ;
    rdfs:label "Asset"@x-gmeow-english ;
    skos:definition "A financial asset — a stock, bond, cryptocurrency, real estate holding, commodity, or other instrument of value. The thing that is held, not the holding itself (which is a Holding relator)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:assetType
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Asset ;
    rdfs:range gmeow:AssetType ;
    rdfs:label "asset type"@x-gmeow-english ;
    skos:definition "The kind of financial asset — one of the open AssetType values (stock, bond, cryptocurrency, real estate, commodity). Functional: an asset has one canonical type."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:assetIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Asset ;
    rdfs:range rdfs:Literal ;
    rdfs:label "asset identifier"@x-gmeow-english ;
    skos:definition "An identifier for the financial asset — FIGI, ISIN, ticker symbol, or other instrument identifier. Non-functional: different sources may report differing identifiers."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Asset type — an OPEN value vocabulary.
# --------------------------------------------------------------------------- #

gmeow:AssetType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Asset Type"@x-gmeow-english ;
    skos:definition "The kind of a financial asset — a VALUE, never an Asset subclass. Open vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:assetTypeStock          a gmeow:AssetType ; rdfs:label "stock"@x-gmeow-english ;          skos:definition "A share of ownership in a corporation."@x-gmeow-english .
gmeow:assetTypeBond           a gmeow:AssetType ; rdfs:label "bond"@x-gmeow-english ;           skos:definition "A fixed-income debt instrument."@x-gmeow-english .
gmeow:assetTypeCryptocurrency a gmeow:AssetType ; rdfs:label "cryptocurrency"@x-gmeow-english ; skos:definition "A digital currency operating on a blockchain or distributed ledger."@x-gmeow-english .
gmeow:assetTypeRealEstate     a gmeow:AssetType ; rdfs:label "real estate"@x-gmeow-english ;     skos:definition "A real property asset — land, buildings, or improvements."@x-gmeow-english .
gmeow:assetTypeCommodity      a gmeow:AssetType ; rdfs:label "commodity"@x-gmeow-english ;      skos:definition "A basic good or raw material traded on a market (gold, oil, wheat, etc.)."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# Holding — a relator connecting agent × asset × quantity × cost-basis.
# Reify-on-demand: a flat accountBalance on FinancialAccount covers the 80% case;
# promote to Holding when cost-basis, period, or provenance matters.
# --------------------------------------------------------------------------- #

gmeow:Holding
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Holding"@x-gmeow-english ;
    skos:definition "A reified relator connecting an agent to a financial asset with a quantity and cost-basis. The thing that is held: agent × asset × quantity × cost-basis × optional period. Promote from a flat accountBalance when cost-basis, period, or provenance must be recorded."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:holdingAgent
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Holding ;
    rdfs:range gmeow:Agent ;
    rdfs:label "holding agent"@x-gmeow-english ;
    skos:definition "The agent that holds the asset. Functional: a holding is held by exactly one agent."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:holdingAsset
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Holding ;
    rdfs:range gmeow:Asset ;
    rdfs:label "holding asset"@x-gmeow-english ;
    skos:definition "The financial asset that is held. Functional: a holding is of exactly one asset."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:holdingQuantity
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Holding ;
    rdfs:range xsd:decimal ;
    rdfs:label "holding quantity"@x-gmeow-english ;
    skos:definition "The quantity of the asset held, as an xsd:decimal. Functional: a holding has exactly one quantity at a given point in time (competing standpoint-indexed quantities coexist as separate statements)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:holdingCostBasis
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Holding ;
    rdfs:range gmeow:MonetaryAmount ;
    rdfs:label "holding cost basis"@x-gmeow-english ;
    skos:definition "The cost basis of the holding — the original monetary amount paid to acquire the asset. Functional: a holding has one canonical cost basis (disputed values are standpoint-indexed claims)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:holdingPeriod
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Holding ;
    rdfs:range gmeow:TimeInterval ;
    rdfs:label "holding period"@x-gmeow-english ;
    skos:definition "The time interval over which the holding is valid. Optional: omit for point-in-time holdings."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# PHASE D — Crypto Wallets
# =========================================================================== #

# --------------------------------------------------------------------------- #
# CryptoWallet — a digital wallet for cryptocurrency (⊑ FinancialAccount).
# --------------------------------------------------------------------------- #

gmeow:CryptoWallet
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:FinancialAccount ;
    rdfs:label "Crypto Wallet"@x-gmeow-english ;
    skos:definition "A digital wallet that holds cryptocurrency assets. A subclass of FinancialAccount (it is a financial-existence account) with wallet-specific properties: address(es), scheme, and cryptographic key linkage."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:walletAddress
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CryptoWallet ;
    rdfs:range rdfs:Literal ;
    rdfs:label "wallet address"@x-gmeow-english ;
    skos:definition "A public address of the crypto wallet. Non-functional: a single wallet may have multiple addresses (e.g. HD wallet derivation paths)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:walletScheme
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:CryptoWallet ;
    rdfs:range gmeow:WalletScheme ;
    rdfs:label "wallet scheme"@x-gmeow-english ;
    skos:definition "The blockchain scheme of the wallet — Bitcoin, Ethereum, Solana, Monero, etc. Functional: a wallet operates on exactly one scheme (a multi-scheme container is several wallets)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:walletKey
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CryptoWallet ;
    rdfs:range gmeow:CryptographicKey ;
    rdfs:label "wallet key"@x-gmeow-english ;
    skos:definition "The cryptographic key that controls the wallet. Non-functional: a wallet may be controlled by several keys (multi-sig) or the key may rotate over time."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Wallet scheme — an OPEN value vocabulary.
# --------------------------------------------------------------------------- #

gmeow:WalletScheme
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Wallet Scheme"@x-gmeow-english ;
    skos:definition "The blockchain or cryptographic scheme of a wallet — a VALUE, never a subclass. Open vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:walletSchemeBTC a gmeow:WalletScheme ; rdfs:label "Bitcoin"@x-gmeow-english ; skos:definition "The Bitcoin blockchain scheme."@x-gmeow-english .
gmeow:walletSchemeETH a gmeow:WalletScheme ; rdfs:label "Ethereum"@x-gmeow-english ; skos:definition "The Ethereum blockchain scheme."@x-gmeow-english .
gmeow:walletSchemeSOL a gmeow:WalletScheme ; rdfs:label "Solana"@x-gmeow-english ; skos:definition "The Solana blockchain scheme."@x-gmeow-english .
gmeow:walletSchemeXMR a gmeow:WalletScheme ; rdfs:label "Monero"@x-gmeow-english ; skos:definition "The Monero blockchain scheme."@x-gmeow-english .

# =========================================================================== #
# AXIOMATIZED DOCTRINE — relator mediation (EL someValuesFrom, open-world).
# Closed-world cardinality is SHACL's (gmeow-shapes.ttl).
# =========================================================================== #

gmeow:FinancialTransaction rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:transactionAmount ; owl:someValuesFrom gmeow:MonetaryAmount ] .

gmeow:LedgerAccount rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:ledgerAccountType ; owl:someValuesFrom gmeow:LedgerAccountType ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:ledgerAccountHolder ; owl:someValuesFrom gmeow:Agent ] .

gmeow:JournalEntry rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:journalEntryPostings ; owl:someValuesFrom gmeow:Posting ] .

gmeow:Posting rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:postingJournalEntry ; owl:someValuesFrom gmeow:JournalEntry ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:postingAccount ; owl:someValuesFrom gmeow:LedgerAccount ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:postingAmount ; owl:someValuesFrom gmeow:MonetaryAmount ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:postingDirection ; owl:someValuesFrom gmeow:PostingDirection ] .

gmeow:Invoice rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:invoiceAmount ; owl:someValuesFrom gmeow:MonetaryAmount ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:invoiceIssuer ; owl:someValuesFrom gmeow:Agent ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:invoiceRecipient ; owl:someValuesFrom gmeow:Agent ] .

gmeow:Order rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:orderAmount ; owl:someValuesFrom gmeow:MonetaryAmount ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:orderBuyer ; owl:someValuesFrom gmeow:Agent ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:orderSeller ; owl:someValuesFrom gmeow:Agent ] .

gmeow:Holding rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:holdingAgent ; owl:someValuesFrom gmeow:Agent ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:holdingAsset ; owl:someValuesFrom gmeow:Asset ] .

gmeow:CryptoWallet rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:walletScheme ; owl:someValuesFrom gmeow:WalletScheme ] .
