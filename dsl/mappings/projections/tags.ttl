@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix oa:     <http://www.w3.org/ns/oa#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

# Projection mappings: GMEOW tags → schema.org keywords and W3C Web Annotation.
# Compiled to projections/*.edoal.ttl + queries/projections/*.rq by
# `gmeow compile-mappings`.

# --------------------------------------------------------------------------- #
# schema.org — flat hasTag → schema:keywords (extract label, suppress hidden)
# --------------------------------------------------------------------------- #

gmeow:mapSchemaHasTag a gmeow:ProjectionMapping ;
    rdfs:label "hasTag → schema:keywords (label text, suppress displayable false)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "kw" ;
        gmeow:atom (
            [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:hasTag ; gmeow:objectVar "tag" ]
            [ gmeow:subjectVar "tag" ; gmeow:predicate rdfs:label ; gmeow:objectVar "kw" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "tag" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:hasTag ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:keywords ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnTagToKeyword ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "tag IRI lost; only label text emitted; displayable false tags suppressed" ] .

# --------------------------------------------------------------------------- #
# schema.org — Tagging relator → schema:keywords (lossy flatten)
# --------------------------------------------------------------------------- #

gmeow:mapSchemaTaggingKeyword a gmeow:ProjectionMapping ;
    rdfs:label "Tagging relator → schema:keywords (lossy flatten)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "kw" ;
        gmeow:atom (
            [ gmeow:subjectVar "tagging" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Tagging ]
            [ gmeow:subjectVar "tagging" ; gmeow:predicate gmeow:taggingTagged ; gmeow:objectVar "ent" ]
            [ gmeow:subjectVar "tagging" ; gmeow:predicate gmeow:taggingTag ; gmeow:objectVar "tag" ]
            [ gmeow:subjectVar "tag" ; gmeow:predicate rdfs:label ; gmeow:objectVar "kw" ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "tagging" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "tag" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:Tagging ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:keywords ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnTagToKeyword ; gmeow:confidence 0.7 ;
        gmeow:lossyDrop "tagger, scheme, interval, confidence, provenance dropped; only tag label survives" ] .

# --------------------------------------------------------------------------- #
# W3C Web Annotation — Tagging relator → oa:Annotation (reshape)
# --------------------------------------------------------------------------- #

gmeow:mapWebAnnotationTagging a gmeow:ProjectionMapping ;
    rdfs:label "Tagging relator → oa:Annotation (body/target/motivatedBy)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "tagging" ; gmeow:value "tagging" ;
        gmeow:atom (
            [ gmeow:subjectVar "tagging" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Tagging ]
            [ gmeow:subjectVar "tagging" ; gmeow:predicate gmeow:taggingTagged ; gmeow:objectVar "tagged" ]
            [ gmeow:subjectVar "tagging" ; gmeow:predicate gmeow:taggingTag ; gmeow:objectVar "tag" ]
            [ gmeow:subjectVar "tagging" ; gmeow:predicate gmeow:taggingTagger ; gmeow:objectVar "tagger" ; gmeow:optional true ]
            [ gmeow:subjectVar "tagging" ; gmeow:predicate gmeow:wasAttributedTo ; gmeow:objectVar "attributed" ; gmeow:optional true ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "tagging" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:suppressWhen [ gmeow:subjectVar "tag" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:Tagging ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "web-annotation" ; gmeow:relation "<=" ;
        gmeow:edoalTarget oa:Annotation ; gmeow:edoalTargetKind "class" ;
        gmeow:transform gmeow:fnTaggingToAnnotation ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "confidence, temporal scope (taggingInterval), scheme dropped; tagger and attribution omitted (not projected)" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "tagging" ; gmeow:tPred rdf:type ; gmeow:tObjValue oa:Annotation ]
            [ gmeow:tSubj "tagging" ; gmeow:tPred oa:hasTarget ; gmeow:tObj "tagged" ]
            [ gmeow:tSubj "tagging" ; gmeow:tPred oa:hasBody ; gmeow:tObj "tag" ]
            [ gmeow:tSubj "tagging" ; gmeow:tPred oa:motivatedBy ; gmeow:tObjValue oa:tagging ] ) ] .

# --------------------------------------------------------------------------- #
# SKOS — a Tag IS a concept: label, hierarchy, scheme (the bidirectional model)
# --------------------------------------------------------------------------- #

gmeow:mapSkosConcept a gmeow:ProjectionMapping ;
    rdfs:label "Tag → skos:Concept (prefLabel, broader, inScheme)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "tag" ;
        gmeow:atom (
            [ gmeow:subjectVar "tag" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Tag ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "tag" ; gmeow:predicate rdfs:label ; gmeow:objectVar "label" ] ) ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "tag" ; gmeow:predicate gmeow:broaderTag ; gmeow:objectVar "broader" ] ) ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "tag" ; gmeow:predicate gmeow:tagInScheme ; gmeow:objectVar "scheme" ] ) ] ) ;
        gmeow:suppressWhen [ gmeow:subjectVar "tag" ; gmeow:predicate gmeow:displayable ; gmeow:objectLiteral false ] ;
        gmeow:edoalSource gmeow:Tag ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "skos" ; gmeow:relation "=" ;
        gmeow:edoalTarget skos:Concept ; gmeow:edoalTargetKind "class" ;
        gmeow:lossyDrop "the Tagging relator's provenance/confidence/scope and the open value-vocabulary of tag relations beyond broader/narrower are not expressible in SKOS" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "tag" ; gmeow:tPred rdf:type ; gmeow:tObjValue skos:Concept ]
            [ gmeow:tSubj "tag" ; gmeow:tPred skos:prefLabel ; gmeow:tObj "label" ]
            [ gmeow:tSubj "tag" ; gmeow:tPred skos:broader ; gmeow:tObj "broader" ]
            [ gmeow:tSubj "tag" ; gmeow:tPred skos:inScheme ; gmeow:tObj "scheme" ] ) ] .

gmeow:mapSkosConceptScheme a gmeow:ProjectionMapping ;
    rdfs:label "TagScheme → skos:ConceptScheme"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "scheme" ;
        gmeow:atom (
            [ gmeow:subjectVar "scheme" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:TagScheme ] ) ;
        gmeow:edoalSource gmeow:TagScheme ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "skos" ; gmeow:relation "=" ;
        gmeow:edoalTarget skos:ConceptScheme ; gmeow:edoalTargetKind "class" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "scheme" ; gmeow:tPred rdf:type ; gmeow:tObjValue skos:ConceptScheme ] ) ] .
