# SPDX-FileCopyrightText: 2026 Blackcat Informatics® Inc. <paudley@blackcatinformatics.ca>
# SPDX-License-Identifier: CC-BY-4.0
#
# The gmeow:doc* projection vocabulary — the TBox for the self-hosting
# documentation projection (crates/docs/src/rdf.rs::to_gmeow_rdf). That emitter
# dogfoods the doc model into the gmeow:graph/documentation named graph as
# generated A-Box instance data; this module owns the classes, predicates, and
# value individuals it materializes, so every projected term carries a
# declaration (the orphan-zero contract enforced by
# crates/docs/tests/vocabulary_ownership.rs).
#
# The projected instances are generated A-Box (gmeow:boxABox individuals in a
# downstream named graph); the vocabulary HERE is TBox. The per-instance
# provenance predicates the projection reuses — gmeow:addedInVersion,
# gmeow:definitionDigest, gmeow:hasChangelogEntry, gmeow:entryVersion,
# gmeow:entryNote, gmeow:ChangelogEntry — are owned by slices/core/versions and
# are NOT redeclared here.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# ── Documentation-entry record classes ───────────────────────────────────────
# One reified record per documented artifact. Each is a first-class information
# object (a page's worth of documentation projected as RDF), so it can carry a
# stable IRI, provenance, and its evidence DAG.

gmeow:DocumentedTerm
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Documented Term"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "The documentation-projection record for one vocabulary term (a class, property, individual, or datatype). It is the RDF twin of the term's docs page: it gmeow:documents the real term IRI and carries the page's derived facts (gmeow:docCategory, gmeow:docHasDefinition, gmeow:docUrl, gmeow:docOwnerSlice, gmeow:docReasoningStatus). It is NOT the term itself — the term keeps its own IRI in its owning slice; this record is a separate, downstream information object minted per term by the docs projection."@x-gmeow-english ;
    skos:example "ex:entryCat a gmeow:DocumentedTerm ; gmeow:documents gmeow:Cat ; gmeow:docCategory \"Class\" ; gmeow:docOwnerSlice ex:sliceZoo ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating it with the documented term itself (they are distinct IRIs — the record documents the term) and avoid authoring it by hand: it is a generated projection of the doc model, regenerated from the slice sources."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let the docs projection mint one per documented term; read it to query the documentation surface as RDF — follow gmeow:documents to the term and gmeow:docOwnerSlice to its slice, and join gmeow:DocEvidence nodes for its proof-carrying panels."@x-gmeow-english ;
    gmeow:useWhen "Use to name the RDF record standing for a term's documentation page, so the documentation surface is itself SPARQL-queryable RDF folded into gmeow.gts beside the ontology it describes (Principle 4)."@x-gmeow-english .

gmeow:DocumentedSlice
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Documented Slice"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "The documentation-projection record for one slice's manifest-level page. It gmeow:documents the real slice IRI and carries its gmeow:docUrl. Distinct from the slice itself (a gmeow:Slice declared in that slice's manifest): this record is the downstream information object standing for the slice's rendered documentation, minted by the docs projection."@x-gmeow-english ;
    skos:example "ex:entrySliceTags a gmeow:DocumentedSlice ; gmeow:documents ex:sliceTags ; gmeow:docUrl \"slices/tags/index.html\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it in place of the gmeow:Slice manifest node it documents, and avoid hand-authoring it: it is a regenerated projection of the slice catalog."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let the docs projection mint one per discovered slice; follow gmeow:documents to the slice manifest and gmeow:docUrl to its rendered page."@x-gmeow-english ;
    gmeow:useWhen "Use to name the RDF record for a slice's documentation page when querying the documentation surface for which slices are documented and where their pages live."@x-gmeow-english .

gmeow:DocumentedConcern
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Documented Concern"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "The documentation-projection record for one cross-cutting documentation concern (a gmeow:DocumentationConcern grouping terms by theme). It gmeow:documents the real concern IRI and carries its gmeow:docUrl. The concern itself stays owned by slices/core/kernel; this is the downstream record standing for the concern's rendered page."@x-gmeow-english ;
    skos:example "ex:entryConcernProvenance a gmeow:DocumentedConcern ; gmeow:documents ex:concernProvenance ; gmeow:docUrl \"concerns/provenance/index.html\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid confusing it with the gmeow:DocumentationConcern it documents, and avoid authoring it by hand: it is regenerated from the concern annotations across the slices."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let the docs projection mint one per documentation concern; follow gmeow:documents to the concern and gmeow:docUrl to its rendered overview page."@x-gmeow-english ;
    gmeow:useWhen "Use to name the RDF record for a documentation concern's page when querying which concerns are documented and where their overview pages live."@x-gmeow-english .

gmeow:DocumentedMappingSet
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Documented Mapping Set"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "The documentation-projection record for one cross-vocabulary mapping set (a gmeow:MappingSet compiled from a slice's mappings/ artifact). It gmeow:documents the real mapping-set IRI and links (via gmeow:docUrl) to the shared linkages index page. Distinct from the gmeow:MappingSet it documents: this is the downstream record for that set's rendered documentation."@x-gmeow-english ;
    skos:example "ex:entryMappingSet1 a gmeow:DocumentedMappingSet ; gmeow:documents ex:mappingSet1 ; gmeow:docUrl \"linkages/index.html\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it in place of the gmeow:MappingSet it documents, and avoid hand-authoring it: it is regenerated from the compiled mapping artifacts."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let the docs projection mint one per compiled mapping set; follow gmeow:documents to the set and gmeow:docUrl to the linkages index."@x-gmeow-english ;
    gmeow:useWhen "Use to name the RDF record for a mapping set's documentation when querying which mapping sets are documented on the linkages surface."@x-gmeow-english .

gmeow:DocEvidence
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Doc Evidence"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "One uniform proof-carrying evidence node in a documented term's justification DAG: a claim (gmeow:docClaim) held together WITH its grounds (one or more MANDATORY gmeow:docGroundedBy carrier truthmakers), classified by exactly one gmeow:DocEvidenceKind (competency, diagnostics, fixture, loss, provenance) via gmeow:docEvidenceKind. Every kind carries the SAME shape — claim, grounding, typed counts, optional judgment — so a future evidence source plugs in as a new kind, not a new predicate family. An ungrounded DocEvidence node is the doc-layer analogue of a DARK finding and is forbidden by construction: the grounding obligation is enforced by the SHACL gmeow:DocEvidenceGroundingShape (shapes.ttl) and, over the live projection, by crates/docs/tests/doc_evidence.rs — NOT by an owl:minCardinality restriction, because gmeow:docGroundedBy carries both IRI and literal objects and so is an owl:AnnotationProperty (a cardinality restriction on it would leave OWL 2 DL). It is emitted ONLY when the term genuinely carries that evidence — never a vacuous node."@x-gmeow-english ;
    skos:example "ex:evCatCompetency a gmeow:DocEvidence ; gmeow:documents gmeow:Cat ; gmeow:docEvidenceKind gmeow:docEvidenceKindCompetency ; gmeow:docClaim \"exercised by 1 competency question\" ; gmeow:docGroundedBy ex:cqCatsAreAnimals ; gmeow:docCompetencyCount 1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting one without a gmeow:docGroundedBy truthmaker (an ungrounded evidence node is a DARK claim), avoid a vacuous node for a kind the term does not carry, and avoid splitting the kinds into parallel predicate families — the uniform shape is the point."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let the docs projection mint one per (documented term, evidence kind) actually present; read gmeow:docEvidenceKind for the kind, gmeow:docGroundedBy for its carrier grounds, gmeow:docClaim for the human claim, and the typed count/digest/judgment predicates for the kind-specific measures."@x-gmeow-english ;
    gmeow:useWhen "Use to name a single grounded justification node for a documented term — the reified 'claim with its grounds' unit the documentation surface renders as a proof-carrying evidence panel."@x-gmeow-english .

# ── The evidence-kind value vocabulary ───────────────────────────────────────
# The kind of a gmeow:DocEvidence node is a first-class, join-able resource — an
# enumerated individual chosen over a string literal so the documentation TBox
# can subclass or extend it (mirrors gmeow:VersionRole's QualityValue discipline).

gmeow:DocEvidenceKind
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Doc Evidence Kind"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of evidence a gmeow:DocEvidence node carries — a VALUE, never an Entity subclass. The seed list (competency, diagnostics, fixture, loss, provenance) is an anchor, not a fence: a new evidence source enters as a fresh gmeow:DocEvidenceKind individual referenced by gmeow:docEvidenceKind, so the uniform evidence shape absorbs it without a new predicate family."@x-gmeow-english ;
    skos:example "gmeow:docEvidenceKindProvenance a gmeow:DocEvidenceKind ; rdfs:label \"provenance\"@x-gmeow-english ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting per-kind Entity subclasses or typing an evidence node directly with a kind class; the kind is an individual value referenced through gmeow:docEvidenceKind, not an essential type."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded individuals from gmeow:docEvidenceKind, and extend the anchor list with a new gmeow:DocEvidenceKind individual (label only) when a new evidence source is added."@x-gmeow-english ;
    gmeow:useWhen "Use as the open value vocabulary for evidence kinds — the named kinds (competency, diagnostics, fixture, loss, provenance) a gmeow:DocEvidence node is classified by, and the place to mint a new kind."@x-gmeow-english .

gmeow:docEvidenceKindCompetency
    a gmeow:DocEvidenceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "competency"@x-gmeow-english ;
    skos:definition "The competency evidence kind — the documented term is exercised by one or more competency questions; the node is grounded by each competency-question IRI and carries the count and query digest."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:docEvidenceKindDiagnostics
    a gmeow:DocEvidenceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "diagnostics"@x-gmeow-english ;
    skos:definition "The diagnostics evidence kind — the documented term is the key in a diagnostics-to-term join; the node is grounded by each finding code and carries the finding count."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:docEvidenceKindFixture
    a gmeow:DocEvidenceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "fixture"@x-gmeow-english ;
    skos:definition "The fixture evidence kind — the documented term is referenced by one or more conformance fixtures / counter-examples; the node is grounded by each minted fixture IRI and carries the fixture count."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:docEvidenceKindLoss
    a gmeow:DocEvidenceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "loss"@x-gmeow-english ;
    skos:definition "The loss evidence kind — the documented term degrades under one or more projections; the node is grounded by each ledger-row / loss-target identifier, carries the row count, and records the distinct preservation kinds as its gmeow:docJudgment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:docEvidenceKindProvenance
    a gmeow:DocEvidenceKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "provenance"@x-gmeow-english ;
    skos:definition "The provenance evidence kind — the documented term is produced by the docs render chain; the node is grounded by the stage-docs-render IRI and carries the backward stage-walk depth."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# ── Projection predicates that point AT other resources ──────────────────────
# gmeow:documents / gmeow:docOwnerSlice point at TBox terms and slice/ontology
# nodes; gmeow:docGroundedBy carries BOTH IRI truthmakers (competency, stage,
# fixture IRIs) and code literals (finding codes, loss-target ids). All three are
# owl:AnnotationProperty (the gmeow:accordingTo pattern, Principle 3) so the
# generated OWL stays in OWL 2 DL despite pointing at classes/properties (which a
# logical object property would pun as individuals) or mixing IRI and literal
# objects (which no single owl:ObjectProperty / owl:DatatypeProperty could hold).

gmeow:documents
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "documents"@x-gmeow-english ;
    skos:definition "Links a documentation-projection record (gmeow:DocumentedTerm / gmeow:DocumentedSlice / gmeow:DocumentedConcern / gmeow:DocumentedMappingSet / gmeow:DocEvidence) to the real subject IRI it documents — the term, slice, concern, or mapping set. An owl:AnnotationProperty (Principle 3) because its object is frequently a TBox class or property, which a logical object property would pun as an individual; the annotation form keeps the generated OWL in OWL 2 DL."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:documents gmeow:Cat ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at the documentation record itself (it points AT the documented subject, not back at the record) and avoid using it as a logical object property — its object is often a class or property, so it stays an annotation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set exactly one gmeow:documents on each documentation record, pointing at the real IRI the record is about; walk it to move from the documentation surface back to the documented vocabulary."@x-gmeow-english ;
    gmeow:useWhen "Use to name the subject a documentation record is about — the bridge from the documentation graph back to the term, slice, concern, or mapping set it describes."@x-gmeow-english .

gmeow:docOwnerSlice
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc owner slice"@x-gmeow-english ;
    skos:definition "Names the slice that owns the term a gmeow:DocumentedTerm documents — the slice whose module.ttl defines the term (its rdfs:isDefinedBy). An owl:AnnotationProperty because its object is a slice node that is simultaneously an owl:Ontology, which a logical object property would pun; the annotation form keeps the generated OWL in OWL 2 DL."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docOwnerSlice ex:sliceZoo ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at anything but the term's OWNING slice (the one whose module defines it), and avoid deriving ownership from where a term is merely referenced — ownership is the single rdfs:isDefinedBy slice."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set one gmeow:docOwnerSlice on each gmeow:DocumentedTerm, the IRI of the slice that defines the term; group documented terms by it to render per-slice term listings."@x-gmeow-english ;
    gmeow:useWhen "Use to record which slice a documented term belongs to, so the documentation surface can group terms by owning slice and link a term back to its slice page."@x-gmeow-english .

gmeow:docGroundedBy
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc grounded by"@x-gmeow-english ;
    skos:definition "The MANDATORY carrier truthmaker(s) that ground a gmeow:DocEvidence claim — the reason the claim is asserted. Its object is EITHER an IRI (a competency-question IRI, the stage-docs-render IRI, a minted fixture IRI) OR a code literal (a diagnostic finding code, a loss-target identifier), depending on the evidence kind. Because it mixes IRI and literal objects — which no single owl:ObjectProperty or owl:DatatypeProperty could carry — it is an owl:AnnotationProperty. Every gmeow:DocEvidence node MUST carry at least one (the fail-fast grounding invariant); an ungrounded node is the doc-layer analogue of a DARK finding."@x-gmeow-english ;
    skos:example "ex:evCatCompetency gmeow:docGroundedBy ex:cqCatsAreAnimals ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid emitting a gmeow:DocEvidence node without one (an ungrounded claim is DARK), and avoid inventing a truthmaker to satisfy the invariant — ground it in the real carrier fact or do not emit the node."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Attach one gmeow:docGroundedBy per real truthmaker on every gmeow:DocEvidence node — an IRI for competency/fixture/provenance kinds, a code literal for diagnostics/loss kinds; never leave a node ungrounded."@x-gmeow-english ;
    gmeow:useWhen "Use to record what makes a documentation evidence claim true — the competency IRI, stage IRI, fixture IRI, finding code, or loss-target id that grounds it."@x-gmeow-english .

# ── The evidence-kind classifier (instance → value) ──────────────────────────

gmeow:docEvidenceKind
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DocEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc evidence kind"@x-gmeow-english ;
    rdfs:range gmeow:DocEvidenceKind ;
    skos:definition "Classifies a gmeow:DocEvidence node by exactly one gmeow:DocEvidenceKind value (competency, diagnostics, fixture, loss, provenance). An instance-level owl:ObjectProperty from an evidence node to an enumerated kind individual — the join key that lets the uniform evidence shape absorb a new source as a new kind rather than a new predicate family."@x-gmeow-english ;
    skos:example "ex:evCatLoss gmeow:docEvidenceKind gmeow:docEvidenceKindLoss ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at a string literal (the kind is a first-class join-able individual, not a label) and avoid asserting more than one kind per node — a node is one kind's evidence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set exactly one gmeow:docEvidenceKind on each gmeow:DocEvidence node, referencing a seeded gmeow:DocEvidenceKind individual; group or facet evidence nodes by it."@x-gmeow-english ;
    gmeow:useWhen "Use to record which kind of evidence a gmeow:DocEvidence node carries, so the documentation surface can group a term's evidence by kind."@x-gmeow-english .

# ── Typed datatype predicates on the projection records ──────────────────────

gmeow:docCategory
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocumentedTerm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc category"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The stable vocabulary-category label of a documented term — one of \"Class\", \"Property\", \"Individual\", \"Datatype\", \"Other\", derived from the term's rdf:type. A display token, distinct from the term's logic stereotype; it drives the category badge and grouping on the term surface."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docCategory \"Class\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating it as the term's logic stereotype (that is a logic: type, not this display token) and avoid values outside the fixed set."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection derive it from the term's rdf:type; read it to badge and group documented terms by category."@x-gmeow-english ;
    gmeow:useWhen "Use to record the coarse vocabulary category of a documented term for display and grouping on the documentation surface."@x-gmeow-english .

gmeow:docHasDefinition
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocumentedTerm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc has definition"@x-gmeow-english ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether the documented term carries a skos:definition (true) or none (false) — the completeness flag the documentation surface uses to flag undefined terms. A derived boolean, not authored on the term."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docHasDefinition true ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring it by hand or using it as the definition text (it is a boolean presence flag, not the prose) — it is derived from whether the term has a skos:definition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection set it from the term's definition presence; query gmeow:docHasDefinition false to find terms missing a definition."@x-gmeow-english ;
    gmeow:useWhen "Use to record whether a documented term has a definition, so the documentation surface can surface definition-completeness at a glance."@x-gmeow-english .

gmeow:docUrl
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc url"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The site-relative path of a documentation record's rendered page (e.g. \"terms/{slug}/index.html\", \"slices/{slug}/index.html\", \"linkages/index.html\"). A relative path string, not an absolute IRI, so the rendered site is relocatable. Carried by every documentation-entry record (gmeow:DocumentedTerm / gmeow:DocumentedSlice / gmeow:DocumentedConcern / gmeow:DocumentedMappingSet)."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docUrl \"terms/cat/index.html\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid storing an absolute URL (the path is site-relative so the site can be relocated) and avoid using it for anything but the record's own rendered page."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection set the site-relative page path on each documentation record; resolve it against the site root to build a link."@x-gmeow-english ;
    gmeow:useWhen "Use to record where a documentation record's page lives on the rendered site, so the documentation graph can link to its own HTML."@x-gmeow-english .

gmeow:docReasoningStatus
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocumentedTerm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc reasoning status"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The per-term native-reasoner verdict, projected ONLY when a reasoning verdict is attached — one of \"satisfiable\", \"unsatisfiable\" (a class proven to entail owl:Nothing), or \"not-evaluated\" (a property, individual, or datatype the reasoner decides no satisfiability for). Absent rather than fabricated when no verdict is attached: the documentation surface never carries an unfounded satisfiability claim."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docReasoningStatus \"satisfiable\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid emitting it without a real reasoner verdict (an unfounded satisfiability claim is worse than an honest absence) and avoid reading \"not-evaluated\" as \"satisfiable\" — the two never collapse."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection derive it from the native reasoner's consistency verdict; light a term page red on \"unsatisfiable\"."@x-gmeow-english ;
    gmeow:useWhen "Use to record a documented class's satisfiability under the native reasoner, so the documentation surface can flag an inconsistent term."@x-gmeow-english .

gmeow:docClaim
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc claim"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The short human claim a gmeow:DocEvidence node asserts (e.g. \"exercised by 3 competency question(s)\", \"has 2 projection-loss row(s)\") — the one-line summary the evidence panel renders. The claim WITHOUT its grounds would be a bare assertion; it always travels with at least one gmeow:docGroundedBy truthmaker."@x-gmeow-english ;
    skos:example "ex:evCatCompetency gmeow:docClaim \"exercised by 1 competency question\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid packing multiple claims into one string, and avoid asserting a claim without its gmeow:docGroundedBy grounds — a claim without grounds is DARK."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection derive one terse claim per evidence node from the kind's measure; render it as the evidence panel's headline."@x-gmeow-english ;
    gmeow:useWhen "Use to record the one-line human summary of what a documentation evidence node asserts about its term."@x-gmeow-english .

gmeow:docProducedByChain
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc produced by chain"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The build-stage chain that produced a gmeow:DocEvidence node, rendered as the stage-docs-render lineage walked backward over gmeow:dataflowConsumes (e.g. \"stage-docs-render <- stage-validate <- stage-source-load\"). A human-readable provenance string that rides every evidence node when the model carries the pipeline; absent (an honest absence) when it does not."@x-gmeow-english ;
    skos:example "ex:evCatProvenance gmeow:docProducedByChain \"stage-docs-render <- stage-source-load\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating a chain when the model carries no pipeline (leave it absent) and avoid treating the string as a machine edge — the machine edge is gmeow:dataflowConsumes; this is its rendered summary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection derive it from the pipeline's backward gmeow:dataflowConsumes walk from stage-docs-render; render it as the evidence panel's provenance line."@x-gmeow-english ;
    gmeow:useWhen "Use to record the human-readable build lineage that produced a documentation evidence node, so a reader can trace which stages made it."@x-gmeow-english .

gmeow:docJudgment
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc judgment"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The optional preservation / confidence judgment a gmeow:DocEvidence node carries when its kind has one — e.g. the distinct projection-loss preservation kinds (\"SoundUnderApproximation, ValidationOnly\") on a loss node. Absent when the kind carries no judgment; never a placeholder."@x-gmeow-english ;
    skos:example "ex:evCatLoss gmeow:docJudgment \"SoundUnderApproximation\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a judgment for a kind that has none (leave it absent) and avoid overloading it with the claim text — it is the preservation/confidence verdict, not the summary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection set it from the kind's preservation verdict (today, the distinct loss preservation kinds); render it beside the claim on the evidence panel."@x-gmeow-english ;
    gmeow:useWhen "Use to record a preservation or confidence verdict on a documentation evidence node, where the kind supplies one."@x-gmeow-english .

gmeow:docCompetencyCount
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc competency count"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The number of competency questions that exercise the documented term, carried on its competency gmeow:DocEvidence node. A typed count travelling beside the gmeow:docGroundedBy competency IRIs it summarizes."@x-gmeow-english ;
    skos:example "ex:evCatCompetency gmeow:docCompetencyCount 3 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it on a non-competency evidence node, and avoid a count that disagrees with the gmeow:docGroundedBy competency IRIs it summarizes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection derive it from the competency-to-term join; render it as the competency panel's count."@x-gmeow-english ;
    gmeow:useWhen "Use to record how many competency questions exercise a documented term on its competency evidence node."@x-gmeow-english .

gmeow:docCompetencyQueryDigest
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc competency query digest"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The blake3 content-address (\"blake3:...\") of the concatenated competency-query bodies that exercise the documented term — the query fingerprint carried on its competency gmeow:DocEvidence node. Lets a reader detect when the exercising queries changed, without embedding the query text in the graph."@x-gmeow-english ;
    skos:example "ex:evCatCompetency gmeow:docCompetencyQueryDigest \"blake3:1a2b3c\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring it by hand (it is computed from the query bodies) and avoid treating it as the query text — it is a content-address fingerprint."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection compute it as the blake3 of the joined competency query bodies; compare it across releases to detect query drift."@x-gmeow-english ;
    gmeow:useWhen "Use to fingerprint the competency queries that exercise a documented term, so query drift is detectable from the documentation graph alone."@x-gmeow-english .

gmeow:docFindingCount
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc finding count"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The number of diagnostic findings that structurally concern the documented term, carried on its diagnostics gmeow:DocEvidence node. A typed count travelling beside the gmeow:docGroundedBy finding codes it summarizes."@x-gmeow-english ;
    skos:example "ex:evCatDiagnostics gmeow:docFindingCount 2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it on a non-diagnostics evidence node, and avoid a count that disagrees with the grounding finding codes it summarizes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection derive it from the diagnostics-to-term join; render it as the diagnostics panel's count."@x-gmeow-english ;
    gmeow:useWhen "Use to record how many diagnostic findings concern a documented term on its diagnostics evidence node."@x-gmeow-english .

gmeow:docFixtureCount
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc fixture count"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The number of conformance fixtures / counter-examples that reference the documented term, carried on its fixture gmeow:DocEvidence node. A typed count travelling beside the gmeow:docGroundedBy fixture IRIs it summarizes."@x-gmeow-english ;
    skos:example "ex:evCatFixture gmeow:docFixtureCount 1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it on a non-fixture evidence node, and avoid a count that disagrees with the grounding fixture IRIs it summarizes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection derive it from the fixture-to-term join; render it as the fixture panel's count."@x-gmeow-english ;
    gmeow:useWhen "Use to record how many conformance fixtures reference a documented term on its fixture evidence node."@x-gmeow-english .

gmeow:docLossRowCount
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc loss row count"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The number of projection-loss ledger rows / loss targets under which the documented term degrades, carried on its loss gmeow:DocEvidence node. A typed count travelling beside the gmeow:docGroundedBy ledger-row identifiers it summarizes."@x-gmeow-english ;
    skos:example "ex:evCatLoss gmeow:docLossRowCount 2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it on a non-loss evidence node, and avoid a count that disagrees with the grounding ledger-row identifiers it summarizes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection derive it from the per-term projection-loss join; render it as the loss panel's count."@x-gmeow-english ;
    gmeow:useWhen "Use to record how many projection-loss rows a documented term incurs on its loss evidence node."@x-gmeow-english .

gmeow:docProvenanceDepth
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocEvidence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc provenance depth"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The number of build stages in the backward gmeow:dataflowConsumes walk from stage-docs-render that produced the documented term, carried on its provenance gmeow:DocEvidence node. A typed depth summarizing the gmeow:docProducedByChain string on the same node."@x-gmeow-english ;
    skos:example "ex:evCatProvenance gmeow:docProvenanceDepth 2 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it on a non-provenance evidence node, and avoid a depth that disagrees with the gmeow:docProducedByChain it summarizes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection derive it as the length of the backward stage walk from stage-docs-render; render it beside the provenance chain."@x-gmeow-english ;
    gmeow:useWhen "Use to record how many build stages produced a documented term on its provenance evidence node."@x-gmeow-english .

# ── First-class fixture bodies ───────────────────────────────────────────────
# The conformance Do/Don't fixture bodies, promoted from the opaque
# gmeow:docFixtureCount on the fixture gmeow:DocEvidence node to first-class,
# SPARQL-queryable subjects carrying the full Turtle body, so an offline consumer
# can serve the teaching artifact itself — not just a count — from the bundle.

gmeow:DocFixture
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Doc Fixture"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "The first-class documentation record of one conformance Do/Don't fixture: a well-formed instance or a deliberately malformed counter-example, carrying the FULL Turtle body (gmeow:docFixtureText), a gmeow:documents edge per referenced documented term, the well-formed/counter-example kind (gmeow:docFixtureKind), and — when the slice authors a binding — the expected outcome, violation code, and conformance rationale. Its IRI is the SAME identity the fixture gmeow:DocEvidence node grounds by, so the per-term count and the body join on one IRI. It is the fixture's documentation projection, not the fixture file itself."@x-gmeow-english ;
    skos:example "ex:fixtureCatOk a gmeow:DocFixture ; gmeow:documents gmeow:Cat ; gmeow:docFixtureKind gmeow:docFixtureKindWellformed ; gmeow:docFixtureText \"@prefix gmeow: <...> .\" ; gmeow:docExpectedOutcome \"conforms\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring it by hand (it is a regenerated projection of the slice's tests/ fixtures) and avoid conflating it with the fixture gmeow:DocEvidence incidence node — the evidence node carries the count, this record carries the body."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let the docs projection mint one per discovered conformance fixture; read gmeow:docFixtureText for the runnable body, gmeow:documents for the terms it exercises, and gmeow:docFixtureKind / gmeow:docExpectedOutcome for its Do/Don't classification."@x-gmeow-english ;
    gmeow:useWhen "Use to name the queryable body of a conformance fixture in the documentation graph, so an offline consumer can serve the teaching artifact directly."@x-gmeow-english .

gmeow:DocFixtureKind
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Doc Fixture Kind"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of a gmeow:DocFixture — a VALUE, never an Entity subclass: gmeow:docFixtureKindWellformed (a conforming instance) or gmeow:docFixtureKindCounterExample (a deliberately malformed counter-example). Referenced through gmeow:docFixtureKind so the classification is a first-class, join-able resource (mirrors gmeow:DocEvidenceKind)."@x-gmeow-english ;
    skos:example "gmeow:docFixtureKindWellformed a gmeow:DocFixtureKind ; rdfs:label \"wellformed\"@x-gmeow-english ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid typing a fixture directly with a kind class or pointing gmeow:docFixtureKind at a string literal; the kind is an enumerated individual value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded gmeow:docFixtureKindWellformed / gmeow:docFixtureKindCounterExample individuals from gmeow:docFixtureKind; group fixtures by kind."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary for the Do/Don't classification of a conformance fixture."@x-gmeow-english .

gmeow:docFixtureKindWellformed
    a gmeow:DocFixtureKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "wellformed"@x-gmeow-english ;
    skos:definition "The well-formed fixture kind — a conforming instance the ontology validates cleanly (a Do example)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:docFixtureKindCounterExample
    a gmeow:DocFixtureKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "counter-example"@x-gmeow-english ;
    skos:definition "The counter-example fixture kind — a deliberately malformed instance the ontology must reject (a Don't example), typically bound to an expected violation code."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:docFixtureKind
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DocFixture ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc fixture kind"@x-gmeow-english ;
    rdfs:range gmeow:DocFixtureKind ;
    skos:definition "Classifies a gmeow:DocFixture by exactly one gmeow:DocFixtureKind value — well-formed or counter-example. An instance-level owl:ObjectProperty from the fixture record to an enumerated kind individual, never a plain string tag."@x-gmeow-english ;
    skos:example "ex:fixtureCatOk gmeow:docFixtureKind gmeow:docFixtureKindWellformed ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at a string literal (the kind is a first-class individual) and avoid asserting more than one kind per fixture."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set exactly one gmeow:docFixtureKind on each gmeow:DocFixture; group fixtures into Do/Don't panels by it."@x-gmeow-english ;
    gmeow:useWhen "Use to record whether a documentation fixture is a well-formed instance or a counter-example."@x-gmeow-english .

gmeow:docFixtureText
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocFixture ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc fixture text"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The full Turtle body of a conformance fixture, carried verbatim on its gmeow:DocFixture record — the runnable teaching artifact itself, not a digest. Small by construction (fixtures are pure ABox payloads)."@x-gmeow-english ;
    skos:example "ex:fixtureCatOk gmeow:docFixtureText \"ex:c a gmeow:Cat .\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid storing a digest or a truncated excerpt here (the point is the full runnable body) and avoid embedding a large blob — fixtures are small by design."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry the fixture's Turtle source verbatim; render or replay it directly from the graph."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the full Turtle body of a conformance fixture so an offline consumer can read or run it from the documentation graph."@x-gmeow-english .

gmeow:docExpectedOutcome
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocFixture ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc expected outcome"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The authored expected outcome of a conformance fixture — \"conforms\" or \"violates\" — from the slice's tests/example-conformance.ttl binding, carried on its gmeow:DocFixture record: one of exactly two enumerated tokens, never a free-text explanation (that is gmeow:conformanceRationale). Absent when the fixture carries no authored binding (an honest absence)."@x-gmeow-english ;
    skos:example "ex:fixtureCatOk gmeow:docExpectedOutcome \"conforms\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating it for an unbound fixture (leave it absent) and avoid values outside the \"conforms\"/\"violates\" pair."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry it from the fixture's conformance binding; branch the Do/Don't rendering on it."@x-gmeow-english ;
    gmeow:useWhen "Use to record whether a bound conformance fixture is expected to conform or violate."@x-gmeow-english .

gmeow:docViolationCode
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocFixture ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc violation code"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The authored expected violation code of a counter-example fixture (e.g. \"shacl.MinCountConstraintComponent\"), carried on its gmeow:DocFixture record — the machine constraint identifier, never the human explanation of it (that is gmeow:conformanceRationale). Absent for a well-formed fixture or an unbound counter-example."@x-gmeow-english ;
    skos:example "ex:fixtureCatBad gmeow:docViolationCode \"shacl.MinCountConstraintComponent\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it on a well-formed fixture, and avoid inventing a code for an unbound counter-example (leave it absent)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry it from the fixture's conformance binding; show it as the expected failure on the Don't panel."@x-gmeow-english ;
    gmeow:useWhen "Use to record the constraint a counter-example fixture is expected to violate."@x-gmeow-english .

gmeow:conformanceRationale
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocFixture ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "conformance rationale"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The human-readable \"why\" a conformance fixture conforms or violates, from the slice's tests/example-conformance.ttl binding, carried on its gmeow:DocFixture record — the prose explanation, never the machine violation code sitting beside it (that is gmeow:docViolationCode). Absent when the fixture carries no authored binding."@x-gmeow-english ;
    skos:example "ex:fixtureCatBad gmeow:conformanceRationale \"A cat must declare an owner.\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating a rationale for an unbound fixture (leave it absent) and avoid overloading it with the violation code — that is gmeow:docViolationCode."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry it from the fixture's conformance binding; render it as the fixture panel's explanation."@x-gmeow-english ;
    gmeow:useWhen "Use to record the human explanation of why a conformance fixture conforms or violates."@x-gmeow-english .

# ── First-class competency questions ─────────────────────────────────────────
# Each competency question promoted from an opaque blake3 query digest on the
# competency gmeow:DocEvidence node to a first-class record carrying the runnable
# query text and the enumerated expected result rows, so an offline consumer can
# serve the whole standalone question — query plus expected answer — from the
# bundle.

gmeow:DocumentedCompetency
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Documented Competency"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "The first-class documentation record of one competency question: grounded by the real competency-question IRI it projects, it carries the runnable gmeow:cqQueryText, the expected-answer contract (gmeow:cqExpectRowCount / gmeow:cqExactRows / one gmeow:CompetencyExpectedRow per enumerated row), the gmeow:cqRationale, and a gmeow:documents edge per exercised term. It is the competency question's documentation projection — distinct from the competency IRI it grounds by."@x-gmeow-english ;
    skos:example "ex:cqCatsRecord a gmeow:DocumentedCompetency ; gmeow:docGroundedBy ex:cqCatsAreAnimals ; gmeow:documents gmeow:Cat ; gmeow:cqQueryText \"SELECT ?c WHERE { ?c a gmeow:Cat }\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring it by hand (it is a regenerated projection of the slice's tests/competency.ttl) and avoid conflating it with the competency gmeow:DocEvidence node — the evidence node carries the count and digest, this record carries the query and expected rows."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let the docs projection mint one per discovered competency question; read gmeow:cqQueryText for the runnable query, gmeow:cqExpectRowCount / gmeow:CompetencyExpectedRow for the expected answer, and gmeow:documents for the terms it exercises."@x-gmeow-english ;
    gmeow:useWhen "Use to name the queryable, standalone body of a competency question in the documentation graph, so an offline consumer can serve query plus expected answer directly."@x-gmeow-english .

gmeow:CompetencyExpectedRow
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Competency Expected Row"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "One enumerated expected result row of a competency question, linked from its gmeow:DocumentedCompetency by gmeow:cqExpectedRow: a set of per-variable cell bindings (gmeow:cqCellVar with gmeow:cqCellValueIri or gmeow:cqCellValueLiteral). Makes the expected result SET queryable content, not just a count."@x-gmeow-english ;
    skos:example "ex:cqCatsRow0 a gmeow:CompetencyExpectedRow ; gmeow:cqCellVar \"c\" ; gmeow:cqCellValueIri gmeow:Cat ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring it by hand and avoid using it where only a cardinality matters — that is gmeow:cqExpectRowCount; this reifies an actual enumerated row."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let the docs projection mint one per enumerated expected row; read its gmeow:cqCell* bindings to reconstruct the expected result set."@x-gmeow-english ;
    gmeow:useWhen "Use to carry one enumerated expected result row of a competency question as queryable RDF."@x-gmeow-english .

gmeow:cqQueryText
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocumentedCompetency ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "cq query text"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The full runnable SPARQL body of a competency question, carried verbatim on its gmeow:DocumentedCompetency record — the runnable query itself, not a digest."@x-gmeow-english ;
    skos:example "ex:cqCatsRecord gmeow:cqQueryText \"SELECT ?c WHERE { ?c a gmeow:Cat }\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid storing a digest here (that is the competency evidence node's gmeow:docCompetencyQueryDigest) and avoid a truncated excerpt — carry the full query."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry the resolved competency query verbatim; run it directly from the graph."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the runnable SPARQL body of a competency question so an offline consumer can execute it from the documentation graph."@x-gmeow-english .

gmeow:cqExpectRowCount
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocumentedCompetency ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "cq expect row count"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The declared expected row COUNT of a competency question (e.g. 0 for a must-be-empty QC query), carried on its gmeow:DocumentedCompetency record when the question pins cardinality instead of enumerating rows. Absent for a question that enumerates its expected rows."@x-gmeow-english ;
    skos:example "ex:cqNoOrphans gmeow:cqExpectRowCount 0 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it alongside a fully enumerated expected-row set (the two are alternative modes) and avoid a count that disagrees with the query's real cardinality."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry it from the competency question's declared cardinality; assert the result-set size equals it."@x-gmeow-english ;
    gmeow:useWhen "Use to record the expected cardinality of a competency question that pins a row count rather than enumerating rows."@x-gmeow-english .

gmeow:cqExactRows
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocumentedCompetency ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "cq exact rows"@x-gmeow-english ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a competency question's enumerated expected rows are the CLOSED result set (true) or a floor/subset the result must contain (false), carried on its gmeow:DocumentedCompetency record. Its absence is not a default of false — it means the question declares neither mode."@x-gmeow-english ;
    skos:example "ex:cqCatsRecord gmeow:cqExactRows true ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading its absence as false (absent means the question declared neither) and avoid asserting it without any enumerated expected rows to qualify."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry it from the competency question; branch closed-set vs contains-check assertion on it."@x-gmeow-english ;
    gmeow:useWhen "Use to record whether a competency question's enumerated rows are the exact result set or a required subset."@x-gmeow-english .

gmeow:cqRationale
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocumentedCompetency ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "cq rationale"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The human-readable \"why the ontology must answer this\" of a competency question, carried on its gmeow:DocumentedCompetency record — never the query mechanics it motivates (that is gmeow:cqQueryText). Absent when the question authors none."@x-gmeow-english ;
    skos:example "ex:cqCatsRecord gmeow:cqRationale \"Every cat must classify as an animal.\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating a rationale where the question authors none (leave it absent) and avoid overloading it with the query text — that is gmeow:cqQueryText."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry it from the competency question; render it as the question's motivating prose."@x-gmeow-english ;
    gmeow:useWhen "Use to record why the ontology must answer a competency question."@x-gmeow-english .

gmeow:cqExpectedRow
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DocumentedCompetency ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "cq expected row"@x-gmeow-english ;
    rdfs:range gmeow:CompetencyExpectedRow ;
    skos:definition "Links a gmeow:DocumentedCompetency to one of its enumerated expected result rows (a gmeow:CompetencyExpectedRow). One edge per expected row, in the question's deterministic row order — it enumerates the actual expected content rather than pinning a bare cardinality (that is gmeow:cqExpectRowCount)."@x-gmeow-english ;
    skos:example "ex:cqCatsRecord gmeow:cqExpectedRow ex:cqCatsRow0 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at anything but a gmeow:CompetencyExpectedRow node, and avoid using it where only a cardinality is known — that is gmeow:cqExpectRowCount."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection emit one gmeow:cqExpectedRow per enumerated expected row; walk it to reconstruct the expected result set."@x-gmeow-english ;
    gmeow:useWhen "Use to attach an enumerated expected result row to a documented competency question."@x-gmeow-english .

gmeow:cqCellVar
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CompetencyExpectedRow ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "cq cell var"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The SPARQL projection variable an expected-row cell binds — the bare variable name, not the full \"?\"-prefixed SPARQL syntax — carried on the gmeow:CompetencyExpectedRow node beside its bound value."@x-gmeow-english ;
    skos:example "ex:cqCatsRow0 gmeow:cqCellVar \"c\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid including the leading \"?\" (carry the bare name) and avoid asserting a var without a paired gmeow:cqCellValueIri or gmeow:cqCellValueLiteral."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry the cell's projection variable; pair it with the cell's bound value to rebuild the row."@x-gmeow-english ;
    gmeow:useWhen "Use to record which SPARQL variable an expected-row cell binds."@x-gmeow-english .

gmeow:cqCellValueIri
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "cq cell value iri"@x-gmeow-english ;
    skos:definition "The expected IRI binding of an expected-row cell, carried on the gmeow:CompetencyExpectedRow node when the variable binds a resource — distinct from gmeow:cqCellValueLiteral, which carries a literal lexical form instead of a resource IRI. An owl:AnnotationProperty (Principle 3) because its object is frequently a TBox class or property, which a logical object property would pun as an individual."@x-gmeow-english ;
    skos:example "ex:cqCatsRow0 gmeow:cqCellValueIri gmeow:Cat ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it alongside gmeow:cqCellValueLiteral on the same cell (a cell binds either a resource or a literal) and avoid using it as a logical object property."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry the cell's IRI binding; follow it to the bound resource."@x-gmeow-english ;
    gmeow:useWhen "Use to record the expected IRI an expected-row cell binds."@x-gmeow-english .

gmeow:cqCellValueLiteral
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CompetencyExpectedRow ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "cq cell value literal"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The expected literal lexical form of an expected-row cell, carried on the gmeow:CompetencyExpectedRow node when the variable binds a literal — distinct from gmeow:cqCellValueIri, which carries a resource binding rather than a literal lexical form."@x-gmeow-english ;
    skos:example "ex:cqCountRow0 gmeow:cqCellValueLiteral \"3\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it alongside gmeow:cqCellValueIri on the same cell (a cell binds either a resource or a literal)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry the cell's literal binding; compare it against the query result's lexical value."@x-gmeow-english ;
    gmeow:useWhen "Use to record the expected literal an expected-row cell binds."@x-gmeow-english .

# ── First-class per-term entailment DAG ──────────────────────────────────────
# The per-term reasoner derivations, parsed from stage-reason's already-
# materialized reasoning-explanations (reason-once) and projected as first-class
# nodes, so the derivation DAG — rule, conclusion, and every premise — is
# queryable RDF folded into the bundle beside the terms it explains.

gmeow:Entailment
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Entailment"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "The documentation record of one reasoner derivation about a documented term: the firing rule (gmeow:entailmentRule), the concluded triple (gmeow:entailmentConclusion), and every premise (gmeow:entailmentPremise) — the derivation DAG, not a flattened single hop. Grounded by the term IRI it explains and gmeow:documents it. Read back (reason-once) from stage-reason's materialized reasoning-explanations, never re-derived here."@x-gmeow-english ;
    skos:example "ex:entCat0 a gmeow:Entailment ; gmeow:documents gmeow:Cat ; gmeow:entailmentRule \"rdfs:subClassOf-transitive\" ; gmeow:entailmentConclusion \"gmeow:Cat rdfs:subClassOf gmeow:Animal\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring it by hand or re-running the reasoner to build it (it is a read-back of the materialized explanations) and avoid dropping any premise — the whole derivation DAG is the point."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Let the docs projection mint one per derivation from the materialized explanations; read gmeow:entailmentConclusion for the derived fact and gmeow:entailmentPremise for its supports."@x-gmeow-english ;
    gmeow:useWhen "Use to name one reasoner derivation about a documented term as queryable RDF in the documentation graph."@x-gmeow-english .

gmeow:entailmentRule
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Entailment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "entailment rule"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The firing rule of a gmeow:Entailment derivation, as a compact display form (a CURIE where the canonical prefix registry knows one, else the bare IRI) — the rule the reasoner applied, never a fabricated human label."@x-gmeow-english ;
    skos:example "ex:entCat0 gmeow:entailmentRule \"rdfs:subClassOf-transitive\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a prose rule name (carry the rule's compact IRI/CURIE display) and avoid leaving it empty when the derivation names a rule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry the derivation's firing rule display; group derivations by rule."@x-gmeow-english ;
    gmeow:useWhen "Use to record which rule fired to produce a documented-term entailment."@x-gmeow-english .

gmeow:entailmentConclusion
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Entailment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "entailment conclusion"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The concluded triple of a gmeow:Entailment derivation, as a compact deterministic \"s p o\" display (CURIE-compacted) — the fact the reasoner derived about the documented term, never one of the premises supporting it (that distinction belongs to gmeow:entailmentPremise)."@x-gmeow-english ;
    skos:example "ex:entCat0 gmeow:entailmentConclusion \"gmeow:Cat rdfs:subClassOf gmeow:Animal\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid packing more than one triple into it (one conclusion per derivation) and avoid a lossy paraphrase — carry the compact s p o display."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry the derivation's concluded triple display; render it as the entailment's headline."@x-gmeow-english ;
    gmeow:useWhen "Use to record the triple a documented-term entailment derives."@x-gmeow-english .

gmeow:entailmentPremise
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Entailment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "entailment premise"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "One premise of a gmeow:Entailment derivation, as a compact deterministic \"s p o\" display (CURIE-compacted). A derivation carries ONE gmeow:entailmentPremise per premise — the full support set of the derivation DAG, never a flattened single hop."@x-gmeow-english ;
    skos:example "ex:entCat0 gmeow:entailmentPremise \"gmeow:Cat rdfs:subClassOf gmeow:Feline\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid collapsing multiple premises into one string or dropping any premise — emit one gmeow:entailmentPremise per premise so the derivation DAG is complete."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection emit one gmeow:entailmentPremise per premise; collect them to reconstruct the derivation's supports."@x-gmeow-english ;
    gmeow:useWhen "Use to record one premise of a documented-term entailment derivation."@x-gmeow-english .

# ── Coverage-dimension value vocabulary ──────────────────────────────────────
# The attributes of the Formal-Concept-Analysis incidence "a documented term or
# slice COVERS this dimension". Each dimension is a first-class join-able value
# (mirrors gmeow:DocEvidenceKind / gmeow:VersionRole's QualityValue discipline),
# and — the binding invariant that keeps the maturity axes objective — each
# names a DETERMINISTIC structural predicate: a present/absent fact detected by a
# pure function of the model, never a corpus-tuned threshold. The incidence is
# projected per record by crates/docs (gmeow:docCoversDimension /
# gmeow:docMissesDimension), and the named gmeow:DocMaturity anchors are
# distinguished intents over it.

gmeow:DocCoverageDimension
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Doc Coverage Dimension"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of documentation coverage a term or slice carries — a VALUE, never an Entity subclass. Each individual names one coverage dimension of the Formal-Concept-Analysis incidence a documented record runs over: the record either COVERS the dimension (gmeow:docCoversDimension) or MISSES it (gmeow:docMissesDimension). The binding invariant that keeps every maturity axis objective: every dimension's detector is a DETERMINISTIC structural predicate — a present/absent fact computed by a pure function of the model, never a corpus-tuned threshold or subjective score. The seed list is an anchor, not a fence, and every dimension is tier-eligible: it may enter a gmeow:DocMaturity anchor's intent via gmeow:maturityRequiresDimension."@x-gmeow-english ;
    skos:example "gmeow:dimDefinition a gmeow:DocCoverageDimension ; rdfs:label \"definition\"@x-gmeow-english ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting per-dimension Entity subclasses or typing a documented record directly with a dimension class; the dimension is an individual value referenced through gmeow:docCoversDimension / gmeow:maturityRequiresDimension, not an essential type. Avoid a dimension whose detector is a tuned threshold rather than a present/absent structural fact — that would make the axis subjective."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded individuals from gmeow:docCoversDimension / gmeow:docMissesDimension and gmeow:maturityRequiresDimension; extend the anchor list with a new gmeow:DocCoverageDimension individual (label + a stated deterministic detection rule) when a new structural coverage fact is added."@x-gmeow-english ;
    gmeow:useWhen "Use as the open value vocabulary for documentation-coverage dimensions — the named structural facts (definition, label, usage advice, example, …) a documented term or slice covers or misses, and the attributes the gmeow:DocMaturity intents are built from."@x-gmeow-english .

gmeow:dimDefinition
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "definition"@x-gmeow-english ;
    skos:definition "The definition coverage dimension — the documented term carries a non-empty skos:definition (or rdfs:comment). Detection rule: the definition string is present and non-blank (a deterministic presence test)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimLabel
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "label"@x-gmeow-english ;
    skos:definition "The label coverage dimension — the documented term carries a non-empty rdfs:label. Detection rule: the label string is present and non-blank (a deterministic presence test)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimUsageAdvice
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "usage advice"@x-gmeow-english ;
    skos:definition "The usage-advice coverage dimension — the documented term carries adopter guidance. Detection rule: at least one of gmeow:useWhen / gmeow:avoidWhen / gmeow:howToUse is present (a deterministic presence test)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimExample
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "example"@x-gmeow-english ;
    skos:definition "The example coverage dimension — the documented term carries a usage example. Detection rule: at least one skos:example is present (a deterministic presence test)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimScopeNote
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "scope note"@x-gmeow-english ;
    skos:definition "The scope-note coverage dimension — the documented term carries a boundary note. Detection rule: at least one skos:scopeNote is present (a deterministic presence test)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimAlignment
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "alignment"@x-gmeow-english ;
    skos:definition "The alignment coverage dimension — the documented term is aligned to an external vocabulary. Detection rule: the term IRI is the subject of at least one external alignment / linkage (a deterministic membership test against the linkage subject set). APPLICABILITY-CONDITIONED: GMEOW is a superset ontology, so this dimension is REQUIRED ONLY WHERE APPLICABLE — a term that DECLARES an external correspondence (a non-empty gmeow:adoptionTarget, or it already participates in an alignment / mapping set) must carry a documented alignment; a superset-native term that corresponds to nothing external is NOT applicable and satisfies the dimension by non-applicability (external linkage is an encouraged bonus, never a per-term obligation)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimFixturePair
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "fixture pair"@x-gmeow-english ;
    skos:definition "The fixture-pair coverage dimension — the documented term is exercised by BOTH a well-formed conformance fixture and a counter-example (a rule with no negative fixture is not enforced). Detection rule: the term is referenced by at least one well-formed and at least one counter-example fixture (a deterministic presence test over the fixture set). SLICE-DEMONSTRATION dimension: the SLICE covers this dimension by DEMONSTRATING the fixture-pair discipline on at least one applicable term (existential ∃), not by every term carrying its own fixture pair — fixture discipline is a slice-level testing practice. The per-TERM gmeow:docCoversDimension / gmeow:docMissesDimension incidence still records each term's individual status as the diagnostic."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimCompetencyRationale
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "competency rationale"@x-gmeow-english ;
    skos:definition "The competency-rationale coverage dimension — the documented term is exercised by a competency question that carries a rationale. Detection rule: the term is exercised by at least one competency question whose rationale is present and non-blank (a deterministic presence test). SLICE-DEMONSTRATION dimension: the SLICE covers this dimension by DEMONSTRATING a rationale-carrying competency question on at least one applicable term (existential ∃), not by every term having its own CQ — a competency question documents the slice's vocabulary, not one term. The per-TERM gmeow:docCoversDimension / gmeow:docMissesDimension incidence still records each term's individual status as the diagnostic."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimWorkedInstance
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "worked instance"@x-gmeow-english ;
    skos:definition "The worked-instance coverage dimension — the documented term is demonstrated by a worked instance under examples/. Detection rule: the term is referenced by at least one worked-instance example (a deterministic presence test over the example set). SLICE-DEMONSTRATION dimension: the SLICE covers this dimension by DEMONSTRATING a worked-instance scene on at least one applicable term (existential ∃), not by every term having its own scene — a worked scene documents the slice's vocabulary, not one term. The per-TERM gmeow:docCoversDimension / gmeow:docMissesDimension incidence still records each term's individual status as the diagnostic."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimLossLedgerRow
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "loss ledger row"@x-gmeow-english ;
    skos:definition "The loss-ledger coverage dimension — the documented term's projection loss is recorded in the ledger. Detection rule: the term carries a loss-kind gmeow:DocEvidence node (a projection-loss ledger row). APPLICABILITY-CONDITIONED: this dimension is REQUIRED ONLY WHERE APPLICABLE — only a lossy-projection SOURCE (a term that appears in the projection-loss ledger) must carry a ledger row; a superset-native term that is a lossy projection of nothing is NOT applicable and satisfies the dimension by non-applicability."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimLinkageCoverage
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "linkage coverage"@x-gmeow-english ;
    skos:definition "The linkage-coverage dimension — the documented term participates in the cross-vocabulary linkage / mapping-set coverage. Detection rule: the term is a member of at least one compiled mapping set's coverage (a deterministic membership test against the linkage coverage set). APPLICABILITY-CONDITIONED: this dimension is REQUIRED ONLY WHERE APPLICABLE — a term that DECLARES an external correspondence (a non-empty gmeow:adoptionTarget, or it already participates in an alignment / mapping set) must carry a mapping-set-backed linkage; a superset-native term that corresponds to nothing external is NOT applicable and satisfies the dimension by non-applicability."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimAnnotationCoat
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "annotation coat"@x-gmeow-english ;
    skos:definition "The annotation-coat coverage dimension — the documented term carries the full advice coat. Detection rule: gmeow:useWhen AND gmeow:avoidWhen AND gmeow:howToUse AND gmeow:graphBoxRole are all present (a deterministic conjunction of presence tests, stricter than gmeow:dimUsageAdvice which needs only one advice string)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimThesisSentence
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "thesis sentence"@x-gmeow-english ;
    skos:definition "The thesis-sentence coverage dimension — the owning slice's docs.md opens with a thesis sentence. Detection rule: the slice's docs.md carries a non-empty leading thesis sentence (a deterministic presence test over the narrative)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimTranslationCoverage
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "translation coverage"@x-gmeow-english ;
    skos:definition "The translation-coverage dimension — the documented term's carrier strings are available in every supported language. Detection rule: the term's translatable strings are present for each language in the supported set (en / fr / cmn), read from the i18n translation set (a deterministic membership test)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimTestReach
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "test reach"@x-gmeow-english ;
    skos:definition "The test-reach coverage dimension — the documented term is reached by at least one test. Detection rule: the term is referenced by at least one structural assertion or competency question (a deterministic presence test over the test set)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimRealizedState
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "realized state"@x-gmeow-english ;
    skos:definition "The realized-state coverage dimension — the slice's design-set table honestly marks each documented artifact's realized state. Detection rule: every documented artifact in the slice's docs.md design-set table carries a realized-state marker (design-only / partial / built); a table entry with no marker misses this dimension (a deterministic presence test over the table rows, not authorial prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimProvenanceHonesty
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "provenance honesty"@x-gmeow-english ;
    skos:definition "The provenance-honesty coverage dimension — a rationale is not silently a test reference. Detection rule: the rationale string/IRI names no test artifact (a deterministic name-membership test of the rationale against the slice's test-artifact set)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimProseQuality
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "prose quality"@x-gmeow-english ;
    skos:definition "The prose-quality coverage dimension — reformulated from subjective judgment into a deterministic structural conjunction so it is gate-safe. Detection rule (structural conjunction, each conjunct a present/absent fact): the boundary definition contains the three-NOTs structural pattern AND at least one worked-triple example is present AND a non-empty usage-coat distinct from the definition is present AND a present rationale distinct from the label is present. No substantiveness score, no corpus calibration."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:dimLossJudgmentSound
    a gmeow:DocCoverageDimension ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "loss judgment sound"@x-gmeow-english ;
    skos:definition "The MAXIMAL-only loss-judgment coverage dimension — the Principle-17 judgment-valued refinement of gmeow:dimLossLedgerRow, kept a DISTINCT dimension so the presence bit (gmeow:dimLossLedgerRow, in the FULL intent) and the judgment gate (this dimension, in the MAXIMAL intent only) never collide on one attribute. Detection rule: every preservation judgment the term's projection-loss rows carry is sound-or-stronger in the logic:PreservationKind ordering (logic:ExactPreservation / logic:SoundUnderApproximation are ≥ sound), read from the same docJudgment preservation-kind values the evidence DAG emits — a deterministic field comparison over the existing preservation ordering, never a hand-picked whitelist or corpus tuning. APPLICABILITY-CONDITIONED: this dimension is REQUIRED ONLY WHERE APPLICABLE — only a lossy-projection SOURCE (a term that appears in the projection-loss ledger) is judged; a superset-native term that is a lossy projection of nothing is NOT applicable and satisfies the dimension by non-applicability (equivalently, a term with no loss rows vacuously satisfies it — the empty universal, consistent with the other all-present vacuities)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# ── DocMaturity anchors — distinguished intents over the coverage incidence ───
# The named maturity tiers are anchors (not fences) inside the Formal-Concept
# lattice of the "covers dimension" incidence. Each anchor's INTENT is the set of
# structural dimensions it requires (gmeow:maturityRequiresDimension), authored
# EXPLICITLY for all four so the nesting Minimal ⊆ Basic ⊆ Full ⊆ Maximal holds
# across the whole ladder without relying on inference. The order between anchors
# is DERIVED from intent inclusion — never a tuned threshold; the only numeric is
# the bounded fraction gmeow:coverageFraction = |covered ∩ intent| / |intent| ∈ [0,1].

gmeow:DocMaturity
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "Doc Maturity"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The documentation-maturity anchor a term or slice claims or earns — a VALUE, never an Entity subclass. Each anchor individual (minimal, basic, full, maximal) is a distinguished INTENT inside the Formal-Concept lattice of the gmeow:docCoversDimension incidence: the set of gmeow:DocCoverageDimension attributes it requires via gmeow:maturityRequiresDimension. The maturity ORDER is derived from intent inclusion (Minimal ⊆ Basic ⊆ Full ⊆ Maximal), never a tuned numeric threshold. A slice's CLAIMED anchor is gmeow:sliceDocMaturity; its EARNED floor (largest anchor whose intent ⊆ covered set) is gmeow:docEarnedMaturity; the headline gate is exactly asserted ⊄ earned. The seed list is an anchor, not a fence."@x-gmeow-english ;
    skos:example "gmeow:docMaturityFull a gmeow:DocMaturity ; gmeow:maturityRequiresDimension gmeow:dimDefinition ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting per-tier Entity subclasses or making one anchor rdfs:subClassOf another (the order is intent inclusion, not a class hierarchy); avoid asserting a maturity a slice's coverage does not support (the asserted ⊄ earned gate bites); avoid tuning the ladder to a target — the order is intrinsic to the incidence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded anchor individuals from gmeow:sliceDocMaturity (claimed) and gmeow:docEarnedMaturity (earned); read each anchor's gmeow:maturityRequiresDimension set to see its intent; extend the ladder with a new gmeow:DocMaturity anchor (label + an explicit intent) when a domain needs a tier the seeds omit."@x-gmeow-english ;
    gmeow:useWhen "Use as the open value vocabulary for documentation-maturity tiers — the named anchors (minimal, basic, full, maximal) a slice claims or earns, each defined by the dimension intent it requires rather than a numeric score."@x-gmeow-english .

gmeow:docMaturityMinimal
    a gmeow:DocMaturity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "minimal"@x-gmeow-english ;
    skos:definition "The minimal documentation-maturity anchor — a term is named and defined. Intent: gmeow:dimDefinition, gmeow:dimLabel."@x-gmeow-english ;
    gmeow:maturityRequiresDimension
        gmeow:dimDefinition ,
        gmeow:dimLabel ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:docMaturityBasic
    a gmeow:DocMaturity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "basic"@x-gmeow-english ;
    skos:definition "The basic documentation-maturity anchor — the six-dimension core coat. Intent: the minimal intent plus gmeow:dimUsageAdvice, gmeow:dimExample, gmeow:dimScopeNote, gmeow:dimAlignment."@x-gmeow-english ;
    gmeow:maturityRequiresDimension
        gmeow:dimDefinition ,
        gmeow:dimLabel ,
        gmeow:dimUsageAdvice ,
        gmeow:dimExample ,
        gmeow:dimScopeNote ,
        gmeow:dimAlignment ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:docMaturityFull
    a gmeow:DocMaturity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "full"@x-gmeow-english ;
    skos:definition "The full documentation-maturity anchor — the basic coat plus proof-carrying evidence and honest realized state. Intent: the basic intent plus gmeow:dimFixturePair, gmeow:dimCompetencyRationale, gmeow:dimWorkedInstance, gmeow:dimLossLedgerRow, gmeow:dimLinkageCoverage, gmeow:dimRealizedState. A ≥FULL slice that omits a realized-state marker drops below its asserted tier and the gate bites."@x-gmeow-english ;
    gmeow:maturityRequiresDimension
        gmeow:dimDefinition ,
        gmeow:dimLabel ,
        gmeow:dimUsageAdvice ,
        gmeow:dimExample ,
        gmeow:dimScopeNote ,
        gmeow:dimAlignment ,
        gmeow:dimFixturePair ,
        gmeow:dimCompetencyRationale ,
        gmeow:dimWorkedInstance ,
        gmeow:dimLossLedgerRow ,
        gmeow:dimLinkageCoverage ,
        gmeow:dimRealizedState ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:docMaturityMaximal
    a gmeow:DocMaturity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "maximal"@x-gmeow-english ;
    skos:definition "The maximal documentation-maturity anchor — the full intent plus every remaining structural dimension. Intent: the full intent plus gmeow:dimAnnotationCoat, gmeow:dimThesisSentence, gmeow:dimTranslationCoverage, gmeow:dimTestReach, gmeow:dimProvenanceHonesty, gmeow:dimProseQuality, and the judgment-valued gmeow:dimLossJudgmentSound (all nineteen). The Principle-17 loss refinement is carried by the DISTINCT gmeow:dimLossJudgmentSound (in the MAXIMAL intent only): FULL demands the loss ledger row is PRESENT (gmeow:dimLossLedgerRow), MAXIMAL additionally demands every projection's preservation judgment is ≥ sound — the two never collide on one attribute."@x-gmeow-english ;
    gmeow:maturityRequiresDimension
        gmeow:dimDefinition ,
        gmeow:dimLabel ,
        gmeow:dimUsageAdvice ,
        gmeow:dimExample ,
        gmeow:dimScopeNote ,
        gmeow:dimAlignment ,
        gmeow:dimFixturePair ,
        gmeow:dimCompetencyRationale ,
        gmeow:dimWorkedInstance ,
        gmeow:dimLossLedgerRow ,
        gmeow:dimLinkageCoverage ,
        gmeow:dimRealizedState ,
        gmeow:dimAnnotationCoat ,
        gmeow:dimThesisSentence ,
        gmeow:dimTranslationCoverage ,
        gmeow:dimTestReach ,
        gmeow:dimProvenanceHonesty ,
        gmeow:dimProseQuality ,
        gmeow:dimLossJudgmentSound ;
    gmeow:graphBoxRole gmeow:boxABox .

# ── Maturity + coverage projection predicates ────────────────────────────────

gmeow:maturityRequiresDimension
    a owl:ObjectProperty ;
    rdfs:domain gmeow:DocMaturity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "maturity requires dimension"@x-gmeow-english ;
    rdfs:range gmeow:DocCoverageDimension ;
    skos:definition "Names one gmeow:DocCoverageDimension in a gmeow:DocMaturity anchor's INTENT — the structural coverage facts the anchor requires. The union of an anchor's gmeow:maturityRequiresDimension objects IS its intent; the anchors are authored so their intents nest (Minimal ⊆ Basic ⊆ Full ⊆ Maximal), and a term/slice earns an anchor exactly when its covered-dimension set ⊇ the anchor's intent. An instance-level owl:ObjectProperty from an anchor value to a dimension value — the join the Formal-Concept closure runs over."@x-gmeow-english ;
    skos:example "gmeow:docMaturityFull gmeow:maturityRequiresDimension gmeow:dimFixturePair ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting an intent that breaks nesting (a lower anchor requiring a dimension a higher one does not); avoid pointing it at anything but a seeded gmeow:DocCoverageDimension individual; avoid deriving the intent by inference rather than authoring it explicitly — the structural gate checks the authored triples."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Author the full explicit dimension set on each anchor; read the union of an anchor's objects as its intent when computing earned maturity and the coverage fraction."@x-gmeow-english ;
    gmeow:useWhen "Use to declare which coverage dimensions a maturity anchor requires — the anchor's intent, the set a documented record's coverage must include to earn it."@x-gmeow-english .

gmeow:sliceDocMaturity
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "slice doc maturity"@x-gmeow-english ;
    rdfs:range gmeow:DocMaturity ;
    skos:definition "The documentation-maturity anchor a slice CLAIMS — asserted about the slice in its manifest, a gmeow:DocMaturity individual. An owl:AnnotationProperty (the gmeow:termStability pattern, Principle 3) because it is asserted ABOUT a slice / owl:Ontology node, keeping the generated OWL in OWL 2 DL. When absent, the docs generator derives the slice's maturity from its EARNED floor (gmeow:docEarnedMaturity); an explicit assertion is the CLAIM the asserted ⊄ earned gate checks against the earned floor."@x-gmeow-english ;
    skos:example "ex:sliceZoo gmeow:sliceDocMaturity gmeow:docMaturityFull ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting a maturity the slice's coverage does not support (the earned floor will be lower and the gate bites) and avoid using it on a term rather than a slice — a term's coverage rolls up into its slice's earned maturity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Assert one seeded gmeow:DocMaturity anchor on the slice in its manifest as the tier it claims; omit it to accept the derived earned floor."@x-gmeow-english ;
    gmeow:useWhen "Use to record the documentation-maturity tier a slice claims for itself, so the gate can check the claim against the maturity its coverage earns."@x-gmeow-english .

gmeow:docEarnedMaturity
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc earned maturity"@x-gmeow-english ;
    rdfs:range gmeow:DocMaturity ;
    skos:definition "The documentation-maturity anchor a term or slice EARNS — the projected floor: the largest gmeow:DocMaturity anchor whose intent (its gmeow:maturityRequiresDimension set) is a subset of the record's covered-dimension set, computed by the deterministic Formal-Concept closure over the gmeow:docCoversDimension incidence. Emitted by the docs projection (crates/docs), never authored. An owl:AnnotationProperty (mirroring gmeow:sliceDocMaturity) because it is asserted about a slice / documented-term record whose subject a logical object property would pun. The gate is exactly gmeow:sliceDocMaturity ⊄ gmeow:docEarnedMaturity → violation."@x-gmeow-english ;
    skos:example "ex:sliceZoo gmeow:docEarnedMaturity gmeow:docMaturityBasic ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid authoring it by hand (it is a projection of the covered-dimension set) and avoid reading it as the claim — it is the EARNED floor the claim (gmeow:sliceDocMaturity) is checked against."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection compute it as the largest anchor whose intent ⊆ covered set; compare it to gmeow:sliceDocMaturity to run the asserted ⊄ earned gate."@x-gmeow-english ;
    gmeow:useWhen "Use to record the documentation maturity a term or slice actually earns from its coverage, so the gate and the health page read one projected floor rather than re-deriving it."@x-gmeow-english .

gmeow:coverageFraction
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "coverage fraction"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "The bounded coverage fraction of a documented record against a maturity intent — |covered ∩ intent| / |intent|, a decimal in the closed interval [0,1] (an empty intent yields 1.0). The ONLY numeric on the maturity surface, and a bounded fraction by construction (never an unbounded ratio), so it can never be tuned to a target: it reports how much of an anchor's intent a record's coverage meets. An owl:AnnotationProperty mirroring gmeow:docEarnedMaturity (asserted about a slice / documented-term record), keeping the generated OWL in OWL 2 DL."@x-gmeow-english ;
    skos:example "ex:sliceZoo gmeow:coverageFraction \"0.5\"^^xsd:decimal ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading it as a tunable score or ranking axis (it is a bounded objective fraction, not a grade), avoid values outside [0,1], and avoid substituting it for the earned anchor — the anchor is the gate, the fraction is the burn-down readout."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection compute it as |covered ∩ intent| / |intent| for the record's earned or claimed anchor; render it as the per-slice burn-down toward the next tier."@x-gmeow-english ;
    gmeow:useWhen "Use to record how much of a maturity anchor's intent a documented record's coverage meets, as a bounded [0,1] fraction driving the gap-to-next-tier burn-down."@x-gmeow-english .

gmeow:docCoversDimension
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc covers dimension"@x-gmeow-english ;
    rdfs:range gmeow:DocCoverageDimension ;
    skos:definition "The positive incidence relation the Formal-Concept closure runs over: the documented record (a gmeow:DocumentedTerm or gmeow:DocumentedSlice) COVERS this gmeow:DocCoverageDimension — the dimension's deterministic structural detector fires for the record. Emitted per record by the docs projection (crates/docs); the union of a record's covered dimensions is its concept intent, from which gmeow:docEarnedMaturity and gmeow:coverageFraction are computed. An instance-level owl:ObjectProperty into the value vocabulary (mirrors gmeow:docEvidenceKind); its domain is left open (both gmeow:DocumentedTerm and gmeow:DocumentedSlice records carry it)."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docCoversDimension gmeow:dimDefinition ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it for a dimension whose detector did not fire (it is the actual incidence, not an aspiration) and avoid asserting both gmeow:docCoversDimension and gmeow:docMissesDimension for the same record/dimension pair — a dimension is covered XOR missed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection emit one per (record, dimension) whose detector fires; collect a record's objects as its covered-dimension set for the maturity closure."@x-gmeow-english ;
    gmeow:useWhen "Use to record that a documented term or slice covers a coverage dimension — the positive edge of the incidence the maturity anchors are intents over."@x-gmeow-english .

gmeow:docMissesDimension
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc misses dimension"@x-gmeow-english ;
    rdfs:range gmeow:DocCoverageDimension ;
    skos:definition "The negative incidence relation: the documented record (a gmeow:DocumentedTerm or gmeow:DocumentedSlice) MISSES this gmeow:DocCoverageDimension — the dimension's deterministic structural detector did NOT fire for the record. Emitted per record by the docs projection (crates/docs) as the complement of gmeow:docCoversDimension, so the health page can render the gap-to-next-tier burn-down directly rather than re-deriving it. An instance-level owl:ObjectProperty into the value vocabulary (mirrors gmeow:docEvidenceKind); its domain is left open (both record kinds carry it)."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docMissesDimension gmeow:dimScopeNote ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it for a dimension whose detector fired (that is gmeow:docCoversDimension) and avoid asserting both for the same record/dimension pair — a dimension is covered XOR missed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection emit one per (record, dimension) whose detector did not fire; collect a record's objects as its missing-dimension set for the burn-down toward the next anchor."@x-gmeow-english ;
    gmeow:useWhen "Use to record that a documented term or slice misses a coverage dimension — the negative edge that drives the gap-to-next-tier readout on the documentation-health surface."@x-gmeow-english .

# ── Search facets (offline docs_search over the documentation graph) ─────────
# The searchable content facets a documentation-entry record carries so an offline
# consumer's docs_search MCP tool can query gmeow:graph/documentation directly (the
# lean gmeow.gts bundle carries no packed search-index.json archive member). They
# carry the REAL display content — not the meta rdfs:label — and are the SAME fields
# the site search-index.json indexes, so the offline and online search surfaces can
# never diverge.

gmeow:docSearchLabel
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc search label"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The REAL display label of a documentation-entry record (a gmeow:DocumentedTerm's own label or CURIE, a gmeow:DocumentedSlice / gmeow:DocumentedConcern display name), carried as the primary searchable field so an offline docs_search matches it directly from gmeow:graph/documentation. Distinct from the record's structural rdfs:label (which is the generated 'Documentation entry: …' annotation): this facet carries the term's own human name, the same value the site search-index.json indexes. Carried by every documentation-entry record; its domain is left open (the term/slice/concern record classes all carry it)."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docSearchLabel \"Cat\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid confusing it with the record's structural rdfs:label (that is the generated documentation-entry annotation, not the term's own name) and avoid emitting it empty — a labelless term falls back to its CURIE, never a vacuous facet."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry the record's own display label (term label-or-CURIE, slice/concern display name); match a docs_search query against it case-insensitively."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the real display label of a documentation record as the primary field an offline docs_search matches over the documentation graph."@x-gmeow-english .

gmeow:docSearchDefinition
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc search definition"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "The REAL definition / comment prose of a documentation-entry record (a gmeow:DocumentedTerm's or gmeow:DocumentedConcern's own definition), carried as a searchable field so an offline docs_search matches on the definition text, not just the label. Absent when the record carries no definition (an honest absence, never a fabricated one). The same definition value the site search-index.json indexes."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docSearchDefinition \"A small domesticated felid.\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid emitting it for a record with no authored definition (leave it absent) and avoid using the generated documentation-entry skos:definition here — this facet carries the term's own definition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection carry the record's own definition when present; match a docs_search query against it as a secondary field below the label."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the real definition prose of a documentation record so an offline docs_search can match on the definition text."@x-gmeow-english .

gmeow:docSearchAdvice
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocumentedTerm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc search advice"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "One advisory-prose carrier of a gmeow:DocumentedTerm (a scope note, use-when, avoid-when, or how-to-use string), carried repeatably as a searchable field so an offline docs_search matches on advisory prose, not just the label and definition. The SAME flattened advice facet the site search-index.json indexes (crates/docs render term_advice_facet). Emitted once per advice string, in the stable scope→use-when→avoid-when→how-to-use field order; absent for a term carrying no advice."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docSearchAdvice \"Use for a domesticated cat; avoid for a wildcat.\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid collapsing the advisory carriers into one blob (each is one repeatable value) and avoid emitting it for a term with no advice (leave it absent)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection emit one per advisory carrier from term_advice_facet; match a docs_search query against the union of a term's advice strings."@x-gmeow-english ;
    gmeow:useWhen "Use to carry a term's advisory prose as a repeatable searchable field so an offline docs_search can match on usage guidance."@x-gmeow-english .

gmeow:docSearchAlignment
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:DocumentedTerm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "doc search alignment"@x-gmeow-english ;
    rdfs:range xsd:string ;
    skos:definition "One crosswalk alignment token of a gmeow:DocumentedTerm — a `tag:object` string (the alignment predicate's short tag plus the aligned resource's local name), carried repeatably as a searchable facet so an offline docs_search matches on external-vocabulary correspondences, distinct from gmeow:docSearchAdvice, which carries usage prose rather than an external crosswalk token. The SAME sorted, deduped alignment facet the site search-index.json indexes (crates/docs render precompute_alignment_facets). Emitted once per token in sorted order; absent for a term with no linkages."@x-gmeow-english ;
    skos:example "ex:entryCat gmeow:docSearchAlignment \"exact:Q146\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid re-deriving the tokens differently from precompute_alignment_facets (the offline and online alignment facets must be identical) and avoid emitting it for a term with no linkages (leave it absent)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the docs projection emit one per precomputed `tag:object` alignment token; match a docs_search query against the union of a term's alignment tokens."@x-gmeow-english ;
    gmeow:useWhen "Use to carry a term's external crosswalk alignments as repeatable searchable tokens so an offline docs_search can match on external-vocabulary correspondences."@x-gmeow-english .

# =========================================================================== #
# Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl
# and to procedural logic:Constraint checks, Principle 17).
#
# gmeow:docGroundedBy and gmeow:docOwnerSlice are DELIBERATELY owl:AnnotationProperty
# (docGroundedBy mixes IRI and literal objects; docOwnerSlice's object is a slice
# node that is simultaneously an owl:Ontology) — a plain owl:Restriction cannot
# target an AnnotationProperty without leaving OWL 2 DL. The canonical logic:
# restriction vocabulary (logic:subClassOf / logic:Restriction / logic:onProperty,
# of which owl:Restriction is a generated dialect form, per logic:Restriction's own
# skos:definition) is not so constrained, so their cardinality obligations are
# authored there, with an explicit logic:ClosureEntry opt-in — the exact idiom
# already proven in THIS slice's own gmeow:HasGranularityShape / gmeow:CoarsenToShape
# migration and in slices/core/citations/module.ttl's CitationAct "Wave B1"
# migration. gmeow:docEvidenceKind and gmeow:docCategory are ordinary
# object/datatype properties and get the usual OWL restrictions.
# =========================================================================== #

gmeow:docEvidenceKind a owl:FunctionalProperty .

gmeow:DocEvidence rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:docEvidenceKind ; owl:allValuesFrom gmeow:DocEvidenceKind ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:DocEvidence ; logic:closureKey "https://blackcatinformatics.ca/gmeow/docEvidenceKind" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:DocumentedTerm rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:docCategory ; owl:allValuesFrom xsd:string ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:DocumentedTerm ; logic:closureKey "https://blackcatinformatics.ca/gmeow/docCategory" ; logic:closureValue logic:ClosedWorldClosure ] .

# gmeow:DocEvidenceGroundingShape — every gmeow:DocEvidence node carries at least
# one gmeow:docGroundedBy truthmaker (the fail-fast grounding invariant; an
# ungrounded evidence node is the doc-layer analogue of a DARK finding).
gmeow:DocEvidence logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:docGroundedBy ; logic:someValuesFrom owl:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:DocEvidence ; logic:closureKey "https://blackcatinformatics.ca/gmeow/docGroundedBy" ; logic:closureValue logic:ClosedWorldClosure ] .

# gmeow:DocumentedTermShape — every gmeow:DocumentedTerm names exactly one
# gmeow:docOwnerSlice (the slice whose module defines the term).
gmeow:DocumentedTerm logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:docOwnerSlice ; logic:someValuesFrom owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:docOwnerSlice ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:DocumentedTerm ; logic:closureKey "https://blackcatinformatics.ca/gmeow/docOwnerSlice" ; logic:closureValue logic:ClosedWorldClosure ] .

<https://blackcatinformatics.ca/gmeow/slices/documentation>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "The TBox for the self-hosting documentation projection: the gmeow:doc* vocabulary that crates/docs projects into the gmeow:graph/documentation named graph as generated A-Box, so the documentation surface is itself SPARQL-queryable RDF folded into gmeow.gts beside the ontology it describes (Principle 4). The record classes (gmeow:DocumentedTerm / gmeow:DocumentedSlice / gmeow:DocumentedConcern / gmeow:DocumentedMappingSet) reify per-artifact documentation pages; the uniform gmeow:DocEvidence node reifies one grounded 'claim with its grounds' unit per (term, gmeow:DocEvidenceKind), so a new evidence source enters as a new kind rather than a new predicate family. The per-instance provenance predicates the projection reuses (gmeow:addedInVersion, gmeow:definitionDigest, gmeow:hasChangelogEntry, gmeow:entryVersion, gmeow:entryNote, gmeow:ChangelogEntry) stay owned by slices/core/versions."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/documentation> ;
    rdfs:label "GMEOW Documentation Module"@x-gmeow-english ;
    skos:definition "The GMEOW Documentation Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .
