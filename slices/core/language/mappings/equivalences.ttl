@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:languageCode skos:relatedMatch wd:P424 {|
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Wikimedia language code" ;
    gmeow:comment "Wikidata P424 is the Wikimedia language code; GMEOW languageCode uses BCP-47. Related but not identical."
|} .

# --------------------------------------------------------------------------- #
# lang: graft supersession ledger — the machine-checked rung carrier lives in  #
# imports/supersession-correspondences.ttl as logic:Correspondence nodes       #
# (logic:morphismClass + logic:mnemomorphic + logic:getLeg), run through        #
# assert_gates in the logic-compile stage. The old prose-rung gmeow:            #
# TermEquivalence rows are removed: the rung is no longer a comment, it is a    #
# gate-enforced correspondence law (Principle 17 — SSSOM is its lossy           #
# projection, not a competing authored form).                                   #
# --------------------------------------------------------------------------- #
