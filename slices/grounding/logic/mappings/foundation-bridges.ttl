@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dul: <http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix obi: <http://purl.obolibrary.org/obo/OBI_> .
@prefix pato: <http://purl.obolibrary.org/obo/PATO_> .
@prefix yamato: <http://www.hozo.jp/owl/YAMATO20210808.miz.owl#> .
@prefix opencyc: <http://sw.opencyc.org/concept/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .

# These are commitment-shifting bridge views, not imports and not equivalences.
# The source terms remain canonical; the external ontologies expose independent
# foundational commitments useful for validation and exchange (Principles 5, 17).

gmeow:mapsetLogicDul a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-dul.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-dul" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Commitment-shifting bridge views from the logic foundation onto DOLCE+DnS Ultralite. DUL axioms are linked by reference and are never imported as GMEOW's semantic authority." .

gmeow:mapsetLogicIao a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-iao.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-iao" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Bridge view from the kernel information-object sort onto IAO's information content entity." .

gmeow:mapsetLogicObi a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-obi.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-obi" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Bridge views from the prescription/enactment spine onto OBI's planned-process backbone. OBI's catalog is logic:-owned because that backbone is an upper-ontology surface (protocol, planned process), so these rows are authored here — the one boundary at which an OBI term may be named — and every OBI surface downstream (SSSOM, EDOAL, the alignment and correspondence-law graphs) is a generated projection of them." .

gmeow:mapsetLogicPato a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-pato.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-pato" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Bridge view from the logic quality category onto PATO's quality root." .

gmeow:mapsetLogicYamato a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-yamato.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-yamato-20210808" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Version-pinned bridge views onto the YAMATO 2021-08-08 OWL export. Its process/event, role, material-quantity, and quality-value commitments remain distinct, so no identity-strength axiom is emitted." .

gmeow:mapsetLogicOpenCyc a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-logic-opencyc.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/logic-opencyc-20120510" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Bridge views onto permanent OpenCyc identifiers from the 2012-05-10 OWL export. OpenCyc's collection and microtheory commitments remain external and validation-only." .

# DUL -------------------------------------------------------------------------

logic:Individual skos:closeMatch dul:Entity {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-logic-dul.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Both are top-level entity categories, but their partitions and identity commitments differ." ;
    logic:sourceEndpoint logic:Individual ;
    logic:targetEndpoint dul:Entity ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly
|} .

logic:Endurant skos:closeMatch dul:Object {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-logic-dul.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "DUL Object is the closest endurant-facing category, without collapsing the two foundations." ;
    logic:sourceEndpoint logic:Endurant ;
    logic:targetEndpoint dul:Object ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly
|} .

logic:Event skos:closeMatch dul:Event {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-logic-dul.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    logic:sourceEndpoint logic:Event ;
    logic:targetEndpoint dul:Event ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly
|} .

logic:Quality skos:closeMatch dul:Quality {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-logic-dul.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    logic:sourceEndpoint logic:Quality ;
    logic:targetEndpoint dul:Quality ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly
|} .

logic:Situation skos:closeMatch dul:Situation {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-logic-dul.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    logic:sourceEndpoint logic:Situation ;
    logic:targetEndpoint dul:Situation ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly
|} .

gmeow:InformationObject skos:closeMatch dul:InformationObject {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-logic-dul.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "The kernel sort is grounded here because external foundation ownership belongs to the logic grounding slice." ;
    logic:sourceEndpoint gmeow:InformationObject ;
    logic:targetEndpoint dul:InformationObject ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly
|} .

# OBO foundation-adjacent roots ---------------------------------------------

gmeow:InformationObject skos:closeMatch iao:0000030 {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-logic-iao.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "IAO information content entity is a close bridge, not an identity assertion over the kernel information-object sort." ;
    logic:sourceEndpoint gmeow:InformationObject ;
    logic:targetEndpoint iao:0000030 ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly
|} .

# OBI's planned-process backbone. These two rows carry the prescription/enactment
# alignments the retired process-model slice held. They are authored HERE, on the
# logic: owner surface, because an external grounding term has exactly one
# authoring home (docs/GROUNDING.md, "External grounding ownership"): a domain
# slice consumes the logic: term and this one correspondence instead of asserting
# an OBI term again.

logic:Plan skos:closeMatch obi:0000272 {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-logic-obi.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "OBI protocol" ;
    gmeow:comment "OBI protocol (OBI_0000272) is a plan of action a study or an assay follows. A logic:Plan is the prescription itself — the program whose steps invoke action schemas and whose success criterion is a goal expression — so the bridge is close rather than exact: OBI scopes a protocol to investigation contexts, while logic:Plan is domain-neutral and also carries curricula, control recipes and organizational guides." ;
    gmeow:lossyDrop "OBI's investigation-context scoping (a protocol is realized in an assay or a study design) is not carried by logic:Plan, which is deliberately domain-neutral" ;
    logic:sourceEndpoint logic:Plan ;
    logic:targetEndpoint obi:0000272 ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly
|} .

logic:Enactment skos:closeMatch obi:0000011 {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-logic-obi.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "OBI planned process" ;
    gmeow:comment "OBI planned process (OBI_0000011) is a process that realizes a plan specification. A logic:Enactment is one immutable occurrence of a PINNED prescription version against a CLOSED input snapshot, so the bridge is close: OBI's planned process commits to neither version immutability nor input closure, and those two bindings are precisely what make one enactment comparable to its siblings." ;
    gmeow:lossyDrop "OBI planned process carries no prescription-version pin and no closed input snapshot, so the two bindings that make a logic:Enactment reproducible are dropped in the projection" ;
    logic:sourceEndpoint logic:Enactment ;
    logic:targetEndpoint obi:0000011 ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly
|} .

logic:Quality skos:closeMatch pato:0000001 {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-logic-pato.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "PATO's quality root specializes a biomedical quality commitment; it is a validation bridge onto logic:Quality." ;
    logic:sourceEndpoint logic:Quality ;
    logic:targetEndpoint pato:0000001 ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly
|} .

