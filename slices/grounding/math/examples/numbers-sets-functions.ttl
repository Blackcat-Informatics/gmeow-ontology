#
# An illustrative, well-formed scene over the mathematics bedrock: a situated exact
# number and a distinct approximation of it, an exact named constant, a finite set
# with a cardinality, an intensional set whose condition denotes a logic: formula,
# a function with a declared frame, and a composite function whose non-commutative
# order is preserved. It validates cleanly under the global gate.

@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/math/> .

# An exact rational number, and a distinct approximate value that stands in for it.
ex:oneThird a math:RationalNumber ;
    rdfs:label "1/3"@x-gmeow-english ;
    math:inNumberSystem math:rationalNumbers ;
    math:isExact true .

ex:oneThirdDecimal a math:ApproximateValue ;
    rdfs:label "0.333333 (≈ 1/3)"@x-gmeow-english ;
    math:approximates ex:oneThird ;
    math:approximationError "3.4e-7"^^xsd:double ;
    math:quantityValue "0.333333"^^xsd:double ;
    math:numericDatatype xsd:double .

# An exact named constant, given as an individual — never a decimal literal.
ex:goldenRatio a math:MathematicalConstant ;
    rdfs:label "φ (golden ratio)"@x-gmeow-english ;
    math:inNumberSystem math:realNumbers ;
    math:isExact true .

# A signed-extended-real slot on the extended real line ℝ̄ = ℝ ∪ {−∞, +∞}: a quantity that
# diverges downward, declared with the negative pole math:NegativeInfinity rather than a
# finite literal. math:ExtendedRealLine adjoins both poles to the reals through the same
# number-system machinery the finite tower uses.
ex:unboundedBelowReach a math:Quantity ;
    rdfs:label "an unbounded-below reach (→ −∞)"@x-gmeow-english ;
    math:hasDimension math:dimensionless ;
    math:extendedRealValue math:NegativeInfinity .

# A finite set given extensionally, with a cardinality.
ex:smallPrimes a math:FiniteSet ;
    rdfs:label "{2, 3, 5, 7}"@x-gmeow-english ;
    math:hasElement ex:two , ex:three , ex:five , ex:seven ;
    math:hasCardinality math:cardinalityFinite ;
    math:quantityValue 4 .

# An intensional set whose condition denotes a logic: formula (the denotation seam).
ex:evenNumbers a math:SetBuilderExpression ;
    rdfs:label "{ x | x mod 2 = 0 }"@x-gmeow-english ;
    math:memberCondition ex:evenCondition .

ex:evenCondition a logic:Formula ;
    rdfs:label "x mod 2 = 0"@x-gmeow-english .

# A bijective function with a fully declared frame.
ex:negation a math:Function ;
    rdfs:label "n ↦ −n on ℤ"@x-gmeow-english ;
    math:domain ex:integerSet ;
    math:codomain ex:integerSet ;
    math:image ex:integerSet ;
    math:isInjective true ;
    math:isSurjective true ;
    math:isBijective true .

ex:square a math:Function ;
    rdfs:label "n ↦ n² on ℤ"@x-gmeow-english ;
    math:domain ex:integerSet ;
    math:codomain ex:integerSet .

# A composite function square ∘ negation = n ↦ (−n)², with its non-commutative order
# preserved: math:compositionInner (negation, applied first) and math:compositionOuter
# (square, applied second). The codomain of the inner is the domain of the outer.
ex:negateThenSquare a math:Function ;
    rdfs:label "n ↦ (−n)² on ℤ"@x-gmeow-english ;
    math:domain ex:integerSet ;
    math:codomain ex:integerSet ;
    math:compositionInner ex:negation ;
    math:compositionOuter ex:square .

ex:integerSet a math:Set ;
    rdfs:label "ℤ"@x-gmeow-english ;
    math:hasCardinality math:alephNull .

# Two ordered real intervals, each naming both endpoints AND both endpoint
# inclusions. The half-open unit interval [0, 1): its lower endpoint 0 is closed
# (included, square bracket) and its upper endpoint 1 is open (excluded, round
# bracket).
ex:halfOpenUnit a math:Interval ;
    rdfs:label "[0, 1)"@x-gmeow-english ;
    math:lowerEndpoint "0.0"^^xsd:double ;
    math:upperEndpoint "1.0"^^xsd:double ;
    math:lowerInclusion math:closedEndpoint ;
    math:upperInclusion math:openEndpoint .

# The unbounded interval (0, +∞): its lower endpoint 0 is open (excluded) and its
# upper end runs off to the positive pole math:PositiveInfinity, which — being a
# limit point of ℝ̄, never a member — is always open.
ex:positiveReals a math:Interval ;
    rdfs:label "(0, +∞)"@x-gmeow-english ;
    math:lowerEndpoint "0.0"^^xsd:double ;
    math:upperEndpoint math:PositiveInfinity ;
    math:lowerInclusion math:openEndpoint ;
    math:upperInclusion math:openEndpoint .
