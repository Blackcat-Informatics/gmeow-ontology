+    Some(QuadIds {
+        s: dataset.term_id_by_value(&premise.subject)?,
+        p: dataset.term_id_by_iri(&premise.predicate)?,
+        o: dataset.term_id_by_value(&premise.object)?,
+        g: None,
+    })
+}
