@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lime:    <http://www.w3.org/ns/lemon/lime#> .

# Term equivalences for the languages domain — GMEOW authoring source.
# Compiled to mappings/gmeow-languages.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetLanguages a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-languages.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/languages" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Language alignments — schema.org + Wikidata. gmeow:Language is registry-INDEPENDENT (a self-minted IRI); these are see-also links, and coreference of language INSTANCES to Lexvo (http://lexvo.org/id/iso639-3/…), Glottolog and Wikidata items is asserted in data with skos:exactMatch + gmeow:authorityLink, not here. Proficiency scales (CEFR/ILR/ACTFL), writing-system roles, version lineage, origin/modality/status value vocabularies and the WritingSystemUsage relator are largely CANONICAL — no maintained external RDF vocabulary covers them faithfully. The reified gmeow:LanguageProficiency flattens to schema:knowsLanguage / wdt:P1412 only via the EDOAL+FnO projection layer, not by a 1:1 SSSOM claim." .

gmeow:eqLanguages001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Language ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:Language ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-languages.sssom.tsv" .

