        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <http://www.w3.org/2000/01/rdf-schema#label> ?v0 . } UNION { $this <https://blackcatinformatics.ca/gmeow/noteContent> ?v1 . } } }""" ;
    ] .

