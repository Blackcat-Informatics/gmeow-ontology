gmeow:mapSchemaProjectLanguage a gmeow:ProjectionMapping ;
    rdfs:label "project programmingLanguage → schema:programmingLanguage (the language entity)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "splProj" ; gmeow:value "splLang" ;
        gmeow:atom (
            [ gmeow:subjectVar "splProj" ; gmeow:predicate gmeow:programmingLanguage ; gmeow:objectVar "splLang" ] ) ;
        gmeow:edoalSource gmeow:programmingLanguage ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:programmingLanguage ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:lossyDrop "schema:programmingLanguage points at the first-class language (itself projected to schema:ComputerLanguage by mapSchemaProgrammingLanguage); only the project→language edge is carried, not the language's sociolinguistic detail" ] .

gmeow:mapSchemaContactPoint a gmeow:ProjectionMapping ;
    rdfs:label "ContactPoint → schema:ContactPoint"@x-gmeow-english ;
    gmeow:hasMappingPattern [
