#
# ABox fixture for the adversarial case of the competency question "estimate provenance".
# One dataset, held by reference with no payload, is the fitted-to data of three
# math:FittedModel resources, each with its own math:ModelAssumption. No estimate value or
# numerical fit is supplied. Both runs use the dataset directly (gmeow:used) as well as
# their models, so a query that reached a model through the run's data would return every
# model fitted to it.
#   run A used the dataset and M1 only and generated E1 (estimand-bearing) — M2 is fitted
#         to the same dataset but run A did not use it, so M2 must not appear for E1;
#   run B used the dataset, M1 and M2 and generated E2 (estimand-bearing) — a genuinely
#         multi-model run, so both models are reported and neither is chosen;
#   M3 is fitted to the same dataset but no run used it — a run and a model sharing data
#         must not link the model to any estimate, so M3 yields no row;
#   E3 is a parameter-only estimate (math:estimatedParameter plus math:estimator, no
#         estimand), generated by run A — valid under the canonical Estimate contract and
#         outside the query's estimand-bearing profile, so it yields no row.
# Unioned onto the merged ontology by gmeow:cqDataFile.
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <http://example.org/math/> .

# The shared data, held by reference.
ex:sharedData a math:DatasetMatrix .

# The processes. Each uses the shared dataset directly and the models it applied.
ex:runA a math:InferenceRun , gmeow:Activity ;
    gmeow:used ex:sharedData , ex:modelM1 .

ex:runB a math:InferenceRun , gmeow:Activity ;
    gmeow:used ex:sharedData , ex:modelM1 , ex:modelM2 .

# The result objects.
ex:estimateE1 a math:Estimate ;
    math:estimator ex:sharedEstimator ;
    math:estimatesEstimand ex:sharedEstimand ;
    gmeow:wasGeneratedBy ex:runA .

ex:estimateE2 a math:Estimate ;
    math:estimator ex:sharedEstimator ;
    math:estimatesEstimand ex:sharedEstimand ;
    gmeow:wasGeneratedBy ex:runB .

ex:estimateE3 a math:Estimate ;
    math:estimator ex:sharedEstimator ;
    math:estimatedParameter ex:slopeParameter ;
    gmeow:wasGeneratedBy ex:runA .

ex:sharedEstimator a math:Estimator .
ex:sharedEstimand a math:Estimand .
ex:slopeParameter a math:MathematicalObject .

# Three models over the same data, each with its own formula and assumption.
ex:modelM1 a math:FittedModel ;
    math:fittedToData ex:sharedData ;
    math:modelFormula ex:formulaM1 ;
    math:modelAssumption ex:assumptionM1 .

ex:modelM2 a math:FittedModel ;
    math:fittedToData ex:sharedData ;
    math:modelFormula ex:formulaM2 ;
    math:modelAssumption ex:assumptionM2 .

ex:modelM3 a math:FittedModel ;
    math:fittedToData ex:sharedData ;
    math:modelFormula ex:formulaM3 ;
    math:modelAssumption ex:assumptionM3 .

ex:formulaM1 a math:ModelFormula ;
    math:argumentSlot ex:slotM1 .
ex:slotM1 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression ex:responseM1 .
ex:responseM1 a math:VariableExpression .

ex:formulaM2 a math:ModelFormula ;
    math:argumentSlot ex:slotM2 .
ex:slotM2 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression ex:responseM2 .
ex:responseM2 a math:VariableExpression .

ex:formulaM3 a math:ModelFormula ;
    math:argumentSlot ex:slotM3 .
ex:slotM3 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression ex:responseM3 .
ex:responseM3 a math:VariableExpression .

ex:assumptionM1 a math:ModelAssumption .
ex:assumptionM2 a math:ModelAssumption .
ex:assumptionM3 a math:ModelAssumption .
