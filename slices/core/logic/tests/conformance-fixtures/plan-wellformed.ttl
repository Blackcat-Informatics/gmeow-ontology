#
# Conforming fixture for logic:PlanShape — a well-formed logic:Plan carrying
# exactly one logic:planGoal (a gmeow:Goal) and exactly one logic:planSuccessMode
# (a logic:PlanSuccessMode). Bound by tests/example-conformance.ttl
# (ex:ecPlanWellformed, gmeow:conforms). Self-contained: the harness loads
# logic/module.ttl + ONLY this file against logic/shapes.ttl.
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://example.org/lgc/> .

ex:goalReachOrbit a gmeow:Goal ;
    rdfs:label "reach a stable orbit (fixture)"@en .

ex:planLaunch a logic:Plan ;
    logic:planGoal ex:goalReachOrbit ;
    logic:planSuccessMode logic:WeakPlanSuccess .
