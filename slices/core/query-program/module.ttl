gmeow:QueryRerankScore logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankScoreAuthority ; logic:allValuesFrom gmeow:QueryRerankAuthority ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryRerankScore ; logic:closureKey "https://blackcatinformatics.ca/gmeow/rerankScoreAuthority" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryRerankScore logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankScoreAuthority ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass gmeow:QueryRerankAuthority ] .

