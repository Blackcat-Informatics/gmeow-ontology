    [ a owl:Restriction ; owl:onProperty gmeow:segmentTempoMapKind ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:segmentMapRatioNumerator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:segmentMapRatioDenominator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] .

gmeow:MetricStructure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:hasMetricGroup ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:MetricGroup rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:metricGroupOrder ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:groupLengthNumerator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:groupLengthDenominator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
