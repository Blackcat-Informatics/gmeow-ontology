sup:notationKindSignSystemKind a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "graft-negative: gmeow:SymbolicSystemKind ↔ lang:SignSystemKind"@x-gmeow-english ;
