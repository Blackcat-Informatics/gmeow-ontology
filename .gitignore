# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.cache/
*.egg-info/
.coverage
htmlcov/

# Ephemeral / generated products — reproducible from canonical sources, never committed.
# generated/ is a git-ignored local/release projection of generated/dist/gmeow.gts:
# `make check` (through its single producer, `check-sync`) materializes the whole
# tree from canonical sources and reconstructs it
# from the bundle. It is a product, not a committed input. (The retained products that
# ride outside this projection — catalog-v001.xml and packages/python/gmeow_models/ —
# live outside generated/ and stay tracked.)
# ontology-docs/ is on-demand `gmeow-dev sync --outputs docs` output rendered from
# canonical repository sources; it is never committed.
/generated/
/dist/
/dist/i18n/
/dist/ontology-docs/
/ontology-docs/
/docs/_generated/
/llms.txt

# Stamp files (compilation freshness tracking)
.stamps/

# Editor/OS noise
.DS_Store
*.swp
.antigravitycli
.codex
.claude
.worktrees/

# Toolchain temp directories (hard-kill leftovers)
.gmeow-tmp-*/

# Maint-lane scratch: fetched-at-maint-time external assets (e.g. the restricted-license
# Llama/Gemma tokenizer.json the token-cost-matrix lane curls in) — never committed.
/.tmp/

# Rust build artifacts
/target/

# Repository Cargo config is source, not build output.
!/.cargo/
!/.cargo/config.toml

# Release signing secrets (public keys live under keys/ and ARE committed).
keys/*.secret.asc
keys/*.secret
keys/*.tmp

.worktree
.goals
.baseline
lcov.info
mutants.out*/
/pipeline/

# Nightly rustc internal-compiler-error crash dumps (never commit)
rustc-ice-*.txt

# insta pending-snapshot temp files (never commit)
*.snap.new

# Local agent-tooling state. A developer's locally installed agent tooling is not
# gmeow content, and neither is the ignore rule for it: this file is a tracked,
# shipped artifact, so naming a third-party local tool here puts that tool in the
# repository just as surely as committing its bytes would. Local-only paths belong
# in a local-only ignore surface — `.git/info/exclude`, which is per-clone and
# untracked — or in the tool's own configuration, never here.
#
# The repo's own .agents/skills/gmeow-*/ and deficiency-cleanup skills ARE gmeow
# content and stay tracked.
.claude/settings.local.json
.gemini/settings.json
.gemini/extensions/
.mcp.json
