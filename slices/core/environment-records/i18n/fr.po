msgid "Retain this governing law: gmeow:AgentInternalOwnerConstraint logic:formalizes gmeow:policyAgentInternal ."
msgstr "Conserver cette loi de référence : gmeow:AgentInternalOwnerConstraint logic:formalizes gmeow:policyAgentInternal ."

msgctxt "https://blackcatinformatics.ca/gmeow/NamedCircleOwnerConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "named-circle owner binding"
msgstr "liaison au propriétaire du cercle nommé"

msgctxt "https://blackcatinformatics.ca/gmeow/NamedCircleOwnerConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "Named-circle disclosure explicitly identifies an owned circle and that same circle's owner. Several named circles may coexist without a universal default circle."
msgstr "La divulgation à un cercle nommé identifie explicitement un cercle possédé et le propriétaire de ce même cercle. Plusieurs cercles nommés peuvent coexister sans cercle universel par défaut."

msgctxt "https://blackcatinformatics.ca/gmeow/NamedCircleOwnerConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to check intrinsic consistency within the declared source scope."
msgstr "Utiliser pour contrôler la cohérence intrinsèque dans le périmètre source déclaré."

msgctxt "https://blackcatinformatics.ca/gmeow/NamedCircleOwnerConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
