    a ontolex:Form ;
    ontolex:writtenRep "p值"@zh .

<http://example.org/lang/glossary-vartrans/form-tgt/e28c9137cdd598ee>
    a ontolex:Form ;
    ontolex:writtenRep "按已声明二次形式结合内积与外积贡献的结合 Clifford 乘积。 它不只是标量积或外积。"@zh .

<http://example.org/lang/glossary-vartrans/form-tgt/e28fbb1b8444c223>
    a ontolex:Form ;
    ontolex:writtenRep "蕴含前件约束"@zh .

