    gmeow:confidence 0.75 ;
    gmeow:objectLabel "Spacetime Volume" ;
    gmeow:comment "CIDOC-CRM E92 Spacetime Volume — a 4D point set; GMEOW LocationState is a discrete slice (location + time + pose) of it"
|} .

gmeow:LocationState skos:closeMatch crmgeo:SP1_Spacetime_Volume {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
