    gmeow:hasAxis gmeow:axisAltitude ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
    gmeow:frameKind gmeow:frameKindScalar ;
    gmeow:requiresHost false ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:hasMetricKind gmeow:metricEuclidean .
gmeow:referenceFrameAltitudeMSL skos:definition "The altitude msl reference frame — a named coordinate system or value space together with its axes, origin, and transformation rules (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> .

