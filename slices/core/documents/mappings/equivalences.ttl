    gmeow:confidence 0.9 ;
    gmeow:comment "DCTerms dateAccepted — the date a creative work was accepted"
|} .

gmeow:dateSubmitted skos:closeMatch dcterms:dateSubmitted {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "DCTerms dateSubmitted — the date a creative work was submitted"
|} .

gmeow:abstract skos:closeMatch dcterms:abstract {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "DCTerms abstract — a summary of the content of a creative work"
|} .

gmeow:tableOfContents skos:closeMatch dcterms:tableOfContents {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
