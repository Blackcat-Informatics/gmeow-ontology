@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://example.org/loc/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Fixture for SUPPRESS-GEN (#72) — disclosure control by generalization (P10).
# A precise place opts into coarsening to city level; at projection time its exact
# coordinates are withheld and the enclosing city's coordinates are emitted instead
# (a coarser region, never deletion). A control place without the marker keeps its
# precise point. The enclosing city carries its resolution level (gmeow:hasGranularity)
# and a representative point, so the coarsen branch can re-emit it.

# --- The enclosing city: its own granularity level + representative coordinates --- #
ex:metropolis a gmeow:Place ;
    gmeow:placeType gmeow:placeTypeCity ;
    gmeow:hasGranularity gmeow:granularityCity ;
    gmeow:hasCoordinates ex:metroCoords ;
    rdfs:label "Metropolis"@en .

ex:metroCoords a gmeow:GeoCoordinates ;
    gmeow:latitude 51.5072 ;
    gmeow:longitude -0.1276 .

# --- A precise place that OPTS IN to coarsening (granularityCity) --------------- #
ex:secretLab a gmeow:Place ;
    gmeow:placeType gmeow:placeTypePremises ;
    gmeow:containedInPlace ex:metropolis ;
    gmeow:hasCoordinates ex:secretCoords ;
    gmeow:coarsenTo gmeow:granularityCity ;
    rdfs:label "Secret Lab"@en .

ex:secretCoords a gmeow:GeoCoordinates ;
    gmeow:latitude 51.500001 ;
    gmeow:longitude -0.124999 .

# --- Control: a precise place that does NOT opt in (keeps its exact point) ------ #
ex:openCafe a gmeow:Place ;
    gmeow:placeType gmeow:placeTypePremises ;
    gmeow:containedInPlace ex:metropolis ;
    gmeow:hasCoordinates ex:cafeCoords ;
    rdfs:label "Open Cafe"@en .

ex:cafeCoords a gmeow:GeoCoordinates ;
    gmeow:latitude 51.5099 ;
    gmeow:longitude -0.1280 .
