# Illustrative clean scene for the GMN dialect graft. Demonstrates the three
# working surfaces of the dialect: a citation record referencing the one
# codepoint-explicit, candidate-audited ⊑ glyph/denotation chain owned by
# module.ttl, a complete
# gmeow:GmnEnvelope with its full nine-field contract, and an honest GMN-2
# compaction that names its sources, its standpoint, and its validation-only
# correspondence — losslessness is always a judged logic:Correspondence,
# never a boolean flag.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/lang/> .

# --- A GMN glyph: codepoint-explicit, denotation-bound, citation-grounded ---- #
# The canonical inventory in module.ttl owns the complete U+2291 chain:
# gmeow:gmnGlyphLogicSubClassOf -> gmeow:gmnFormLogicSubClassOf ->
# gmeow:gmnDenLogicSubClassOf -> logic:subClassOf, plus the audited
# gmeow:gmnCandidateLogicSubClassOf disposition. This example deliberately
# REFERENCES that one authority instead of minting a second grapheme/denotation
# table. The downstream rdfs:subClassOf spelling is reached only through the
# logic slice's grounding correspondence, never denoted directly here.

ex:glyphSourceRecordSquareImage
    a gmeow:InformationObject ;
    rdfs:label "glyph-table source record for ⊑"@x-gmeow-english ;
    gmeow:references gmeow:gmnGlyphLogicSubClassOf ,
        gmeow:gmnDenLogicSubClassOf ,
        gmeow:gmnCandidateLogicSubClassOf ;
    gmeow:cites gmeow:gmnDescriptionLogicNotationWork .

ex:citeSquareImageGlyph
    a gmeow:CitationAct ;
    gmeow:citingEntity   ex:glyphSourceRecordSquareImage ;
    gmeow:citedEntity    gmeow:gmnDescriptionLogicNotationWork ;
    gmeow:citationIntent gmeow:intentConformsTo .

# --- A complete GMN envelope: the full nine-field contract ------------------ #
# One envelope per serialized GMN payload: the three dialect coordinates, the
# boundary ring, the asserting standpoint, the generating activity, the
# codebook-frame digest (gmeow:gmnCodebookDigest), the byte-exact content
# digest, and the losslessness judgment — a logic:Correspondence.

ex:archiveKeeper a gmeow:Agent .
ex:nightlyGmnWrite a gmeow:Activity .

ex:corrNightlyEnvelope
    a logic:Correspondence ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:SectionRetraction ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true .

ex:nightlyEnvelope
    a gmeow:GmnEnvelope ;
    gmeow:gmnSchemaVersion "1" ;
    gmeow:gmnDictionaryVersion "3" ;
    gmeow:gmnGlyphTableVersion "2" ;
    gmeow:gmnSecurityRing gmeow:gmnRingTrusted ;
    gmeow:accordingTo ex:archiveKeeper ;
    gmeow:wasGeneratedBy ex:nightlyGmnWrite ;
    gmeow:contentDigest "blake3:9c4b1d7e2f5a8c0b3e6d9f2a5c8b1e4d7a0c3f6b9e2d5a8c1b4e7d0a3c6f9b2e" ;
    gmeow:gmnCodebookDigest "blake3:f93d8b8380cb11f90800342edd0867193d8d6006b5f7c033dee2f3db66c9ae43" ;
    gmeow:gmnEnvelopeCorrespondence ex:corrNightlyEnvelope .

# --- A compartmented-scope envelope: the NATO demonstrator ring -------------- #
# gmeow:gmnRingNato shares gmeow:gmnRingTrusted's level but carries the
# gmeow:gmnCompartmentNato / gmeow:gmnCompartmentPartner compartments (module.ttl)
# — the Denning case "same level, different scope, different ring": an envelope
# admitted at gmeow:gmnRingNato is NOT interchangeable with one admitted at
# gmeow:gmnRingTrusted, even though the two share a classification level.

ex:coalitionDesk a gmeow:Agent .
ex:coalitionGmnWrite a gmeow:Activity .

ex:corrCoalitionEnvelope
    a logic:Correspondence ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:SectionRetraction ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true .

ex:coalitionEnvelope
    a gmeow:GmnEnvelope ;
    gmeow:gmnSchemaVersion "1" ;
    gmeow:gmnDictionaryVersion "3" ;
    gmeow:gmnGlyphTableVersion "2" ;
    gmeow:gmnSecurityRing gmeow:gmnRingNato ;
    gmeow:accordingTo ex:coalitionDesk ;
    gmeow:wasGeneratedBy ex:coalitionGmnWrite ;
    gmeow:contentDigest "blake3:1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f809" ;
    gmeow:gmnCodebookDigest "blake3:f93d8b8380cb11f90800342edd0867193d8d6006b5f7c033dee2f3db66c9ae43" ;
    gmeow:gmnEnvelopeCorrespondence ex:corrCoalitionEnvelope .

# --- A worked gmeow:gmnRingWithin flow example: querying the DERIVED order --- #
# gmeow:gmnRingWithin is NEVER authored (a zero-authored-triples structural gate
# enforces this) — it is computed at reason time from gmeow:gmnRingLevel /
# gmeow:gmnRingCompartment by gmeow:ruleGmnRingWithinDerive. Whether
# ex:nightlyEnvelope's payload (admitted at gmeow:gmnRingTrusted) is eligible to
# flow to a hypothetical restricted-ring destination is decided by querying the
# reasoned closure, never by reading an asserted edge:
#
#   ASK { gmeow:gmnRingTrusted gmeow:gmnRingWithin gmeow:gmnRingRestricted }
#
# under the native logic: reasoner (gmeow:reasoningLogic) — the tests/competency.ttl
# migration-equivalence witness pins this computed answer to TRUE, and pins
# gmeow:gmnRingRestricted gmeow:gmnRingWithin gmeow:gmnRingTrusted to FALSE (the
# loosest-bar ring never flows inward). ex:coalitionEnvelope's ring
# (gmeow:gmnRingNato) shares gmeow:gmnRingTrusted's level, so the SAME level does
# NOT collapse the two rings into one: their compartment sets make the derived
# order strictly ASYMMETRIC. gmeow:gmnRingNato's compartment set {NATO, partner}
# is a superset of gmeow:gmnRingTrusted's empty set, so NATO content is eligible
# to flow into the trusted ring; the reverse never holds, because trusted content
# carries neither compartment marking gmeow:gmnRingNato requires — exactly the
# "same level, different scope, different ring" case the demonstrator exists to
# show:
#
#   ASK { gmeow:gmnRingNato gmeow:gmnRingWithin gmeow:gmnRingTrusted }   # -> true
#   ASK { gmeow:gmnRingTrusted gmeow:gmnRingWithin gmeow:gmnRingNato }   # -> false

# --- An honest GMN-2 compaction: provenance-linked, vantage-held ------------- #
# Compaction NEVER overwrites its sources: it is a reified NEW claim naming
# every source through gmeow:gmnCompacts and its holding standpoint through
# gmeow:vantage. Its correspondence carries the honest weak judgment —
# logic:ValidationOnly, logic:mnemomorphic false — because what a compaction
# keeps is a judgment call held on the compaction's own standpoint.

ex:sensorCrew a gmeow:Agent .
ex:summarizer a gmeow:Agent .

ex:claimGateOpenMonday a gmeow:StandpointClaim ;
    gmeow:vantage ex:sensorCrew .

ex:claimGateOpenTuesday a gmeow:StandpointClaim ;
    gmeow:vantage ex:sensorCrew .

ex:corrGateWeekCompaction
    a logic:Correspondence ;
    logic:preservationKind logic:ValidationOnly ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:BridgeView ;
    logic:hasDeterminacy logic:Vague ;
    logic:mnemomorphic false .

ex:compactionGateWeek
    a gmeow:GmnCompaction ;
    gmeow:gmnCompacts ex:claimGateOpenMonday , ex:claimGateOpenTuesday ;
    gmeow:vantage ex:summarizer ;
    lang:translationCorrespondence ex:corrGateWeekCompaction .
