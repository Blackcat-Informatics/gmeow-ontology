      <termEntry id="c-00de9e755b8c111f">
        <langSet xml:lang="en">
          <tig>
            <term>sheaf base complex</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>complexe de base du faisceau</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>层基复形</term>
          </tig>
