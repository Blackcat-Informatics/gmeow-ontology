#
# Declarative structural assertions for the risk slice — the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in crates/validate/tests/conformance_risk.rs. Each assertion runs as a SPARQL
# ASK over the risk module graph (gmeow:scopeModule) under the native Rust
# slicetest harness (crates/slicetest).
#
# Risk IS migrated: class stereotypes are logic: (logic:Kind,
# logic:Category, logic:AbstractIndividualType, logic:QualityValue,
# logic:Disposition, logic:Relator), NOT gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_no_occurrence_gate — loads fixture files + examples/trust-collapse.ttl
#     and asserts that no gmeow:Event instances are entailed; this is a
#     multi-file dynamic ABox check, not a module-scoped TBox invariant.
#   test_wellformed_risk_fixture_conforms — SHACL validation call;
#     ExampleConformance, not a structural TBox assertion.
#   test_malformed_risk_fixture_is_flagged — SHACL validation call with error-text
#     assertions; ExampleConformance, not a structural TBox assertion.
#   test_competency_severity_order_query — reads an external .rq file from
#     COMPETENCY_DIR and asserts the result set; generated-artifact /
#     SPARQL-result numeric check, not expressible as a module-scoped ASK.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/risk/tests/> .

# --- 1. Hazard is a logic:Kind subclass of logic:Disposition and RiskFactor (MUST) ---
ex:saHazardIsKindDisposition a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Hazard a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Disposition ;
        rdfs:subClassOf gmeow:RiskFactor .
}""" ;
    gmeow:saRationale "gmeow:Hazard MUST be an owl:Class typed logic:Kind with rdfs:subClassOf logic:Disposition and gmeow:RiskFactor — a hazard that never manifests is fully real as a disposition; first logic:Disposition use in GMEOW." .

# --- 3. manifestedAsType range is EventType (MUST) ---------------------------
ex:saManifestedAsTypeRangeEventType a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:manifestedAsType rdfs:range gmeow:EventType .
}""" ;
    gmeow:saRationale "gmeow:manifestedAsType MUST have rdfs:range gmeow:EventType — the type level is where counterfactuals live without machinery; range is never gmeow:Event." .

# --- 4. Flat causal properties are owl:ObjectProperty (MUST) -----------------
ex:saCausalPropertiesAreObjectProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:typeCauses   a owl:ObjectProperty .
    gmeow:typeEnables  a owl:ObjectProperty .
    gmeow:typePrevents a owl:ObjectProperty .
    gmeow:typeMitigates a owl:ObjectProperty .
    gmeow:linkNext     a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:typeCauses, typeEnables, typePrevents, typeMitigates, and linkNext MUST all be owl:ObjectProperty — type-level causal links are reified object relations, not datatype assertions." .

# --- 5. No causal property is transitive (MUST-NOT) --------------------------
ex:saCausalPropertiesNotTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p { gmeow:typeCauses gmeow:typeEnables gmeow:typePrevents gmeow:typeMitigates gmeow:linkNext }
    ?p a owl:TransitiveProperty .
}""" ;
    gmeow:saRationale "None of gmeow:typeCauses, typeEnables, typePrevents, typeMitigates, linkNext MUST NOT be owl:TransitiveProperty — chain composition is solver work over recorded links (Principle 12)." .

# --- 6. No causal property is functional (MUST-NOT) --------------------------
ex:saCausalPropertiesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    VALUES ?p { gmeow:typeCauses gmeow:typeEnables gmeow:typePrevents gmeow:typeMitigates gmeow:linkNext }
    ?rec logic:characterizes ?p ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "None of gmeow:typeCauses, typeEnables, typePrevents, typeMitigates, linkNext MUST NOT be owl:FunctionalProperty — each event type may cause many others; gmeow:linkNext branches (diverging failure trees)." .

# --- 7. Flat causal properties domain and range are EventType (MUST) ---------
ex:saFlatCausalPropertiesDomainRangeEventType a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:typeCauses    rdfs:domain gmeow:EventType ; rdfs:range gmeow:EventType .
    gmeow:typeEnables   rdfs:domain gmeow:EventType ; rdfs:range gmeow:EventType .
    gmeow:typePrevents  rdfs:domain gmeow:EventType ; rdfs:range gmeow:EventType .
    gmeow:typeMitigates rdfs:domain gmeow:EventType ; rdfs:range gmeow:EventType .
}""" ;
    gmeow:saRationale "gmeow:typeCauses, typeEnables, typePrevents, and typeMitigates MUST all have rdfs:domain and rdfs:range gmeow:EventType — flat causal claims relate event TYPES, never instances; this is the no-counterfactual-machinery doctrine." .

# --- 8. CausalLink subclasses logic:Relator and RiskFactor (MUST) ------------
ex:saCausalLinkSubclassRelatorAndRiskFactor a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:CausalLink rdfs:subClassOf logic:Relator ;
        rdfs:subClassOf gmeow:RiskFactor .
}""" ;
    gmeow:saRationale "gmeow:CausalLink MUST be a subclass of logic:Relator and gmeow:RiskFactor — reified causal claims are relators (binding antecedent and consequent kinds) and are also risk factors so gmeow:mitigationCounters can reach them." .

# --- 10. Source-variable properties are NOT functional (MUST-NOT) ------------
ex:saSourceVariablePropertiesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    VALUES ?p { gmeow:linkStrength gmeow:cascadeSeverity gmeow:hazardSeverity gmeow:mitigationStatus }
    ?rec logic:characterizes ?p ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "gmeow:linkStrength, cascadeSeverity, hazardSeverity, and mitigationStatus MUST NOT be owl:FunctionalProperty — divergent estimates/grades/statuses coexist via the statement layer; single-valuedness per base graph is SHACL's job (hasAuthorityLevel convention)." .

# --- 11. linkMechanism is NOT functional (MUST-NOT) --------------------------
ex:saLinkMechanismNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    ?rec logic:characterizes gmeow:linkMechanism ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "gmeow:linkMechanism MUST NOT be owl:FunctionalProperty — mechanism prose is localizable; one account per language tag is allowed (localizable-prose convention)." .

# --- 12. linkMechanism has no rdfs:range (MUST-NOT) --------------------------
ex:saLinkMechanismRangeOpen a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:linkMechanism rdfs:range ?r .
}""" ;
    gmeow:saRationale "gmeow:linkMechanism MUST NOT carry any rdfs:range — the range is intentionally open to allow localizable prose (the localizable-prose convention)." .

# --- 13. SeverityLevel is an ordered value vocabulary (MUST) -----------------
ex:saSeverityLevelIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SeverityLevel a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:SeverityLevel MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue — severity grades are an open ordered value vocabulary (the kernel GranularityLevel pattern, fourth use)." .

# --- 14. moreSevereThan is transitive with domain SeverityLevel (MUST) -------
ex:saMoreSevereThanIsTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:moreSevereThan a owl:TransitiveProperty ;
        rdfs:domain gmeow:SeverityLevel .
}""" ;
    gmeow:saRationale "gmeow:moreSevereThan MUST be owl:TransitiveProperty with rdfs:domain gmeow:SeverityLevel — transitivity is deliberately scoped to levels only; cascades themselves are never ordered transitively." .

# --- 15. Severity ordering chain is asserted (MUST) --------------------------
ex:saSeverityOrderingChain a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:severityCatastrophic gmeow:moreSevereThan gmeow:severitySevere .
    gmeow:severitySevere       gmeow:moreSevereThan gmeow:severityModerate .
    gmeow:severityModerate     gmeow:moreSevereThan gmeow:severityMinor .
}""" ;
    gmeow:saRationale "The three asserted gmeow:moreSevereThan chain steps (catastrophic ≻ severe ≻ moderate ≻ minor) MUST be present — they seed the ISO 31000 / IEC 60812 ordering; transitivity closes the rest." .

# --- 16. mitigationMeasure has no rdfs:range (MUST-NOT) ----------------------
ex:saMitigationMeasureRangeOpen a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:mitigationMeasure rdfs:range ?r .
}""" ;
    gmeow:saRationale "gmeow:mitigationMeasure MUST NOT carry any rdfs:range — the range is intentionally open across extension worlds so the deontic and procedural worlds plug in without axiom coupling (the tenurePosition precedent, fourth use; P16 DAG rule)." .

# --- 17. mitigationCounters range is RiskFactor (MUST) -----------------------
ex:saMitigationCountersRangeRiskFactor a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:mitigationCounters rdfs:range gmeow:RiskFactor .
}""" ;
    gmeow:saRationale "gmeow:mitigationCounters MUST have rdfs:range gmeow:RiskFactor — the named class makes the relator-arity gate and generators see the mediation end (the IntentionalMoment precedent)." .

# --- 18. RiskFactor is a logic:Category subclass of Entity (MUST) ------------
ex:saRiskFactorIsCategory a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:RiskFactor a owl:Class , logic:Category ;
        rdfs:subClassOf gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:RiskFactor MUST be an owl:Class typed logic:Category and a subclass of gmeow:Entity — a named umbrella so mitigationCounters carries a generator-visible range (never instantiated directly)." .
