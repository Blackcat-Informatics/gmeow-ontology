% Depth-budget trip: depth_budget(0) exhausts the nested-counterfactual budget
% before any world is constructed -> status "incomplete" (never unbounded).
:- prefix(ex, 'https://example.org/worlds-c/nested-budget/').
:- counterfactual(ex:cf, ex:base).
:- assume(ex:flagged(ex:s, ex:yes)).
:- depth_budget(0).
?- ex:flagged(ex:s, Z).
