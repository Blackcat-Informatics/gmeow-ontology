<https://blackcatinformatics.ca/gmeow/slices/refinement-cues>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:sliceTier gmeow:tierCore ;
    rdfs:label "refinement cues"@x-gmeow-english ;
    skos:definition "Attributed premise-dependence readings and immutable reviewed cue versions grounded in existing prompts, refinements, version lineages and provenance."@x-gmeow-english ;
    dcterms:title "GMEOW Refinement Cues Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Consumer-owned record refiners retaining premise-echo findings and the exact reviewed word or phrase inventory used as evidence."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
