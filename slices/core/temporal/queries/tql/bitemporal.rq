# TQL — the four-clocks (bitemporal) query. Parameters: ?validAt (the instant the
# fact must hold) and ?asOf (the observation cutoff — only claims asserted by then).
# Over the reified owl:Axiom statement form: a claim qualifies when its valid-time
# window contains ?validAt and it was asserted no later than ?asOf. Standpoint is
# returned so coexisting frames stay distinct (no winner — standpoint facility).
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT ?subject ?predicate ?object ?standpoint WHERE {
    ?ax a owl:Axiom ;
        owl:annotatedSource   ?subject ;
        owl:annotatedProperty ?predicate ;
        owl:annotatedTarget   ?object .
    OPTIONAL { ?ax gmeow:validFrom           ?vf . }
    OPTIONAL { ?ax gmeow:validUntil          ?vu . }
    OPTIONAL { ?ax gmeow:assertedAt          ?aa . }
    OPTIONAL { ?ax gmeow:recordedNoLaterThan ?rnlt . }
    OPTIONAL { ?ax gmeow:accordingTo         ?standpoint . }
    # Observation cutoff: prefer assertedAt; fall back to the derived
    # recordedNoLaterThan bound (the four-clocks terminus ante quem). A claim with
    # NEITHER has an unknown observation time and is kept (open-world).
    BIND(COALESCE(?aa, ?rnlt) AS ?observed)
    FILTER(!BOUND(?vf) || ?vf <= ?validAt)
    FILTER(!BOUND(?vu) || ?vu >= ?validAt)
    FILTER(!BOUND(?observed) || ?observed <= ?asOf)
}
ORDER BY ?subject ?predicate
