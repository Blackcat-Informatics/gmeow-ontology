sup:langMandarinUnifyRecoveryFormula a logic:Formula ;
    rdfs:label "Mandarin identity unification recovery transform"@x-gmeow-english ;
    skos:definition "The source-to-view formula that replaces the superseded Mandarin identity with its canonical language identity for executable recovery testing."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:quantifiedVariable [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "holder" ] ;
    logic:forall [ a logic:Formula ;
