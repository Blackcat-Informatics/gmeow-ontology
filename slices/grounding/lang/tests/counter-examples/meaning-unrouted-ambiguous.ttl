# Counter-example: a denotation whose head lexeme has two senses but no lang:viaSense
# (fires lang:UnroutedAmbiguousDenotation / shacl.SPARQLConstraintComponent).

@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix ex:   <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:lex a lang:Lexeme ; lang:inSignSystem ex:english .
ex:s1 a lang:Sense ; lang:senseOf ex:lex .
ex:s2 a lang:Sense ; lang:senseOf ex:lex .
ex:form a lang:WordForm ; lang:inSignSystem ex:english ; lang:lexemeOf ex:lex .

ex:d a lang:Denotation ;
    lang:denotedForm ex:form ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget ex:entity ;
    lang:denotationContext ex:ctx .
