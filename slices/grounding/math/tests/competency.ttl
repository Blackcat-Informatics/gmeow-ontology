ex:rowSideTwo a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sidedness" ; gmeow:cellValueIri math:twoSidedAlternative ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "class" ; gmeow:cellValueIri math:Sidedness ] .
ex:rowSideGreater a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sidedness" ; gmeow:cellValueIri math:greaterAlternative ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "class" ; gmeow:cellValueIri math:Sidedness ] .
ex:rowSideLess a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sidedness" ; gmeow:cellValueIri math:lessAlternative ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "class" ; gmeow:cellValueIri math:Sidedness ] .
ex:rowSideExact a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sidedness" ; gmeow:cellValueIri math:exactTail ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "class" ; gmeow:cellValueIri math:Sidedness ] .
ex:rowSideMidP a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sidedness" ; gmeow:cellValueIri math:midPTail ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "class" ; gmeow:cellValueIri math:Sidedness ] .

# === SATQ5 — the statistics conformance-failure classes ==================== #

ex:cqStatisticsFailureClasses a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-failure-classes.rq" ;
    gmeow:cqDataFile "tests/fixtures/statistics-failure-classes.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The statistics failure vocabulary made enumerable through exemplars: each way a statistical object can be ill-formed is a first-class subclass of math:MathConformanceFailure the slice's SHACL shapes raise. The fixture instantiates one ill-formed exemplar per failure (each with a note on WHY it is ill-formed), and the reasoning-free query reads back each exemplar's asserted failure type. Over the fixture the answer is exactly the nine statistics failure classes {math:UnderspecifiedEstimate, math:ImplicitMissingness, math:IllFramedPValue, math:IntervalKindConflation, math:IncompleteConfidenceInterval, math:IncompleteCredibleInterval, math:UnframedEffectSize, math:UnanchoredDiagnostic, math:CalibrationSenseConflation}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsFailureClassesShape ;
    gmeow:cqExpectRow ex:rowFailUnderspecifiedEstimate , ex:rowFailImplicitMissingness , ex:rowFailIllFramedPValue ,
        ex:rowFailIntervalKindConflation , ex:rowFailIncompleteConfidenceInterval , ex:rowFailIncompleteCredibleInterval ,
        ex:rowFailUnframedEffectSize , ex:rowFailUnanchoredDiagnostic , ex:rowFailCalibrationSenseConflation .

