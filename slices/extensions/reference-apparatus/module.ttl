                    [ a logic:Formula ; logic:relation lang:surfaceText ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "surface" ],
                            [ logic:termIndex 1 ; logic:termVariable "text" ] ] ] ] ] ] .

gmeow:BlockRenderingSurfaceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "block rendering form retention"@x-gmeow-english ;
    skos:definition "Every supplied block rendering names its actual content and a form retained as a block surface. Content keeps its own sort; a documentary block is not converted into an expression, statement or proof."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency of the supplied source inventory."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this obligation executes a producer, parser, proof checker or table renderer."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact source evidence when a supplied structure violates the obligation; never repair it with invented defaults."@x-gmeow-english ;
