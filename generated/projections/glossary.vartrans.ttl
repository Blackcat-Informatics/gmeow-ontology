    a ontolex:Form ;
    ontolex:writtenRep "ceiling vocabulary"@en .

<http://example.org/lang/glossary-vartrans/form-src/f521d98528bdf65c>
    a ontolex:Form ;
    ontolex:writtenRep "A vector-symbolic operation approximately or exactly recovering one bound factor when supplied with the other and a declared binding law."@en .

<http://example.org/lang/glossary-vartrans/form-src/f554bff9a1a4417c>
    a ontolex:Form ;
    ontolex:writtenRep "is part of"@en .

