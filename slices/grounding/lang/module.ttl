    lang:denotationContext gmeow:gmnLangGlyphContext ;
    gmeow:gmnDenotationGrapheme gmeow:gmnGlyphAsterisk .

# --- Named-key rulings (symbols measured out of the glyph table) ------------- #
# The ⟦·⟧ denotation brackets and the ⇝ translation leg each cost more than one
# token, so — read off the crate-side measurement, not pre-committed — the
# terms stay ASCII named keys and no ⟦/⟧/⇝ grapheme enters the script.

gmeow:gmnFormDenotation
    a lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the GMN denotation named key `den`"@x-gmeow-english ;
    skos:definition "The GMN operator form for the denotation relation, rendered as the ASCII named key `den`. The established formal-semantics notation is the ⟦·⟧ bracket pair, but it costs more than one token under the pinned codebook vocabulary, so — read off the measurement — the denotation term stays a named key and ⟦/⟧ never enter the glyph table."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inSignSystem gmeow:gmnModelNotation .

gmeow:gmnDenDenotation
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of the `den` named key"@x-gmeow-english ;
    skos:definition "The reified meaning assignment binding the `den` named key to lang:Denotation, the meaning-assignment relation of formal semantics it names."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:denotedForm gmeow:gmnFormDenotation ;
    lang:denotationKind lang:denotesClass ;
    lang:denotationTarget lang:Denotation ;
    lang:denotationContext gmeow:gmnLangGlyphContext .

gmeow:gmnFormTranslationLeg
    a lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the GMN translation-leg named key `xl`"@x-gmeow-english ;
    skos:definition "The GMN operator form for a translation leg, rendered as the ASCII named key `xl`. The established notation is the ⇝ squiggle arrow, but it costs three tokens under the pinned codebook vocabulary, so — read off the measurement — the translation-leg term stays a named key and ⇝ never enters the glyph table."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inSignSystem gmeow:gmnModelNotation .

gmeow:gmnDenTranslationLeg
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of the `xl` named key"@x-gmeow-english ;
    skos:definition "The reified meaning assignment binding the `xl` named key to lang:Translation, the translation leg it names."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:denotedForm gmeow:gmnFormTranslationLeg ;
    lang:denotationKind lang:denotesClass ;
    lang:denotationTarget lang:Translation ;
    lang:denotationContext gmeow:gmnLangGlyphContext .

# --- Leipzig grammatical-gloss aliases -------------------------------------- #
# The person value the plane needs for the 3SG portmanteau (the inventory
# ships no person values yet); then every feature value the inventory carries
# is dispositioned by its standard Leipzig gloss, so the coverage gate over the
# feature-value population is green by construction and reds on any new value.

lang:valThirdPerson
    a owl:NamedIndividual , lang:FeatureValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "3"@x-gmeow-english ;
    skos:definition "The third-person value of the Person feature — the value the Leipzig gloss 3 abbreviates and the person half of the 3SG portmanteau."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inFeatureInventory lang:udUniversalFeatures .

