ex:saFindContextDatingNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:findContextDating a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:findContextDating MUST NOT be owl:FunctionalProperty — multiple dating methods and competing date claims coexist (Principle 9). Mirrors test_find_context_dating_is_non_functional (negative part)." .

# --- 35. findContextEvent is an owl:ObjectProperty (MUST) ---------------------
ex:saFindContextEventIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
