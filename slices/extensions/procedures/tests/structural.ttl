#
# Declarative structural assertions for the procedures slice — the slice-resident
# test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants formerly hand-written in
# tests/test_procedures.py. Each assertion runs as a SPARQL ASK over the procedures
# module graph (gmeow:scopeModule) under the native Rust harness (crates/slicetest).
# Procedures is migrated, so class stereotypes are logic:
# (logic:Kind, logic:Event, logic:AbstractIndividualType, logic:QualityValue), not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_ingestion_procedure_has_six_steps — counts g.objects() for hasProcedureStep;
#     a numeric / cardinality count that cannot be expressed as a module-scoped ASK.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest→DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/procedures/tests/> .

# --- 1. Procedure is an owl:Class typed logic:Kind and subclass of InformationObject (MUST) ---
ex:saProcedureIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Procedure a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Plan , gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:Procedure MUST be an owl:Class typed logic:Kind, a subclass of logic:Plan (the prescriptive-spec re-seated under the canonical process model — a procedure IS a plan), AND a gmeow:InformationObject (the plan side of the plan ⟂ execution de-conflation). The now-redundant direct logic:Object parent is dropped — gmeow:InformationObject already entails it. Mirrors test_procedure_is_information_object." .

# --- 2. ProcedureStep is an owl:Class typed logic:Kind and subclass of InformationObject (MUST) ---
ex:saProcedureStepIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ProcedureStep a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:ProcedureStep MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject — procedure steps are plan-level specifications, not execution occurrences. Mirrors test_procedure_step_is_information_object." .

# --- 3. Execution is an owl:Class typed logic:Event and subclass of Event (MUST) ---
ex:saExecutionIsEvent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Execution a owl:Class , logic:Event ;
        rdfs:subClassOf gmeow:Event .
}""" ;
    gmeow:saRationale "gmeow:Execution MUST be an owl:Class typed logic:Event and a subclass of gmeow:Event — an execution is the occurrence (plan ⟂ execution de-conflation) that enacts a Procedure. Mirrors test_execution_is_event." .

# --- 4. ControlFlow specializes the canonical logic:ControlFlowEdge (MUST) ------
ex:saControlFlowIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ControlFlow a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:ControlFlowEdge .
}""" ;
    gmeow:saRationale "gmeow:ControlFlow MUST specialize the canonical logic:ControlFlowEdge (itself a logic:Relator) — a procedure's control flow is the reified flow-graph form the DAG-workflow certifier reads, a projection of the one canonical process model, not a parallel relator. The asserted parent is the intermediate logic:ControlFlowEdge; logic:Relator membership follows by transitivity in the merged graph. Mirrors test_control_flow_is_relator." .

# --- 5. DataFlow specializes the canonical logic:DataFlowEdge (MUST) -----------
ex:saDataFlowIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:DataFlow a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:DataFlowEdge .
}""" ;
    gmeow:saRationale "gmeow:DataFlow MUST specialize the canonical logic:DataFlowEdge (the reified counterpart of logic:dataflowConsumes) — a procedure's dataflow is the same canonical edge family the pipeline and the certifier use. Mirrors test_data_flow_is_relator." .

# --- 5b. The flow legs specialize the canonical logic:flowFrom/flowTo (MUST) ---
ex:saFlowLegsSpecializeCanonical a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:flowSource     rdfs:subPropertyOf logic:flowFrom .
    gmeow:flowTarget     rdfs:subPropertyOf logic:flowTo .
    gmeow:dataFlowSource rdfs:subPropertyOf logic:flowFrom .
    gmeow:dataFlowTarget rdfs:subPropertyOf logic:flowTo .
}""" ;
    gmeow:saRationale "The four reified-edge legs MUST specialize the canonical logic:flowFrom / logic:flowTo, so a procedure's control/dataflow edges mediate the same canonical source/target legs the DAG-workflow flow edges do — the projection-of-one-model invariant at the property level." .

# --- 6a. ProcedureType seed individuals are typed gmeow:ProcedureType (MUST) ---
ex:saProcedureTypeValuesAreIndividuals a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:procedureTypeRecipe          a gmeow:ProcedureType .
    gmeow:procedureTypeLabProtocol     a gmeow:ProcedureType .
    gmeow:procedureTypeDataPipeline    a gmeow:ProcedureType .
    gmeow:procedureTypeAgentFlow       a gmeow:ProcedureType .
    gmeow:procedureTypeCiBuild         a gmeow:ProcedureType .
    gmeow:procedureTypeBusinessProcess a gmeow:ProcedureType .
    gmeow:procedureTypeResearchPlan    a gmeow:ProcedureType .
    gmeow:procedureTypeIngestion       a gmeow:ProcedureType .
}""" ;
    gmeow:saRationale "All eight ProcedureType seed individuals MUST be typed gmeow:ProcedureType — the procedure kind is an open value vocabulary of individuals, never subclasses (Principle 9). Mirrors test_procedure_type_values_are_individuals (must arm)." .

# --- 6b. ProcedureType seed individuals are NOT owl:Class (MUST-NOT) -----------
ex:saProcedureTypeValuesNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?v {
        gmeow:procedureTypeRecipe
        gmeow:procedureTypeLabProtocol
        gmeow:procedureTypeDataPipeline
        gmeow:procedureTypeAgentFlow
        gmeow:procedureTypeCiBuild
        gmeow:procedureTypeBusinessProcess
        gmeow:procedureTypeResearchPlan
        gmeow:procedureTypeIngestion
    }
    ?v a owl:Class .
}""" ;
    gmeow:saRationale "ProcedureType seed values MUST NOT be owl:Class — overtyping the procedure kind as subclasses is banned (Principle 9). Mirrors test_procedure_type_values_are_individuals (mustNot arm)." .

# --- 7a. StepType seed individuals are typed gmeow:StepType (MUST) -------------
ex:saStepTypeValuesAreIndividuals a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
