# Content-addressing: every projection receipt carries a content digest.
gmeow:ProjectionMustBeContentAddressed
    a logic:Constraint ;
    rdfs:label "Projection must be content-addressed"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC4): every gmeow:ProjectionReceipt MUST carry a gmeow:contentDigest — its identity over source-set + kind + params + tie-break rule. A receipt with no digest is not answerable to 'which exact projection?'. A ∀→∃ formula, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:ProjectionReceipt ;
    logic:severity "Violation" ;
    logic:message "A gmeow:ProjectionReceipt must carry a gmeow:contentDigest identity." ;
    logic:integrity gmeow:pcaForall .
gmeow:pcaForall a logic:Formula ;
    rdfs:label "pcaForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:ProjectionMustBeContentAddressed (AC4, projection content-addressing): binds ?this and requires ?this is a gmeow:ProjectionReceipt → ∃?d. gmeow:contentDigest(?this, ?d)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:pcaImpl .
gmeow:pcaImpl a logic:Formula ;
    rdfs:label "pcaImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:ProjectionMustBeContentAddressed (AC4, projection content-addressing): when ?this is a gmeow:ProjectionReceipt holds, requires ∃?d. gmeow:contentDigest(?this, ?d)."@x-gmeow-english ; logic:antecedent gmeow:pcaGuard ; logic:consequent gmeow:pcaExists .
gmeow:pcaGuard a logic:Formula ;
    rdfs:label "pcaGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:ProjectionMustBeContentAddressed (AC4, projection content-addressing): asserts ?this is a gmeow:ProjectionReceipt."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ProjectionReceipt ] .
gmeow:pcaExists a logic:Formula ;
    rdfs:label "pcaExists (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:ProjectionMustBeContentAddressed (AC4, projection content-addressing): quantifies ?d and requires gmeow:contentDigest(?this, ?d)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] ;
    logic:exists gmeow:pcaAtom .
gmeow:pcaAtom a logic:Formula ;
    rdfs:label "pcaAtom (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:contentDigest atom of gmeow:ProjectionMustBeContentAddressed (AC4, projection content-addressing): relates ?this, ?d."@x-gmeow-english ; logic:relation gmeow:contentDigest ;
