      <termEntry id="c-d812cce8aec0d91b">
        <langSet xml:lang="en">
          <tig>
            <term>Relates a sheaf to one of its compatible restriction maps between stalks.</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Relie un faisceau à l'une de ses applications de restriction compatibles.</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>将一个层关联到其茎之间的兼容限制映射之一。</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-d82c56f1c280a031">
        <langSet xml:lang="en">
          <tig>
            <term>Relates a vector field, Hamiltonian function, or dynamical system to the flow it generates.</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Relie un champ, une fonction hamiltonienne ou un système au flot qu'il engendre.</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>将向量场、哈密顿函数或动力系统关联到其生成的流。</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-d85d0e85906061b7">
        <langSet xml:lang="en">
          <tig>
            <term>A Laplacian built from cellular-sheaf coboundary maps and inner products, measuring incompatibility of local data.</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Un laplacien construit à partir des applications de cobord d'un faisceau cellulaire et de produits scalaires, mesurant l'incompatibilité des données locales.</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>由胞腔层上边缘映射与内积构造、度量局部数据不兼容性的拉普拉斯算子。</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-d869f4172ac69980">
        <langSet xml:lang="en">
          <tig>
            <term>has prohibition</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>a une interdiction</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>具有禁止</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-d87aaf153a45b087">
        <langSet xml:lang="en">
          <tig>
            <term>obtain consent</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>obtenir le consentement</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>取得同意</term>
          </tig>
