#
# The published gmeow-evals rubric (#298) — "evaluation is meta-claims",
# dogfooded as PURE INSTANCE DATA over the norms extension: a Rubric (a Norm,
# so it NAMES ITS ISSUER — no anonymous evaluation standards) whose criteria
# are the RAGAS/AIS family with NAMED POLES and one shared scale. Scores come
# back as vantage-indexed Assessments in generated/evals/scores.ttl.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ev:    <https://blackcatinformatics.ca/gmeow/evals/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ev:harness a gmeow:SoftwareAgent ;
    rdfs:label "the gmeow-evals harness"@en .

ev:scale-unit a gmeow:ScoreScale ;
    rdfs:label "unit interval"@en ;
    gmeow:scaleMin 0.0 ;
    gmeow:scaleMax 1.0 .

ev:rubric a gmeow:Rubric ;
    rdfs:label "gmeow-evals claim-extraction rubric v1"@en ;
    gmeow:normIssuer ev:harness ;
    gmeow:usesScale ev:scale-unit ;
    gmeow:hasCriterion ev:crit-schema-validity, ev:crit-grounding-precision,
        ev:crit-grounding-recall, ev:crit-hallucination, ev:crit-abstention,
        ev:crit-calibration .

ev:crit-schema-validity a gmeow:Criterion ;
    rdfs:label "schema validity"@en ;
    gmeow:criterionDomain gmeow:criterionDomainFactual ;
    gmeow:rewardPole ev:pole-conformant ;
    gmeow:penaltyPole ev:pole-malformed .
ev:pole-conformant a gmeow:CriterionPole ; rdfs:label "Conformant emission"@en .
ev:pole-malformed  a gmeow:CriterionPole ; rdfs:label "Malformed emission"@en .

ev:crit-grounding-precision a gmeow:Criterion ;
    rdfs:label "grounding precision"@en ;
    gmeow:criterionDomain gmeow:criterionDomainFactual ;
    gmeow:rewardPole ev:pole-pinned ;
    gmeow:penaltyPole ev:pole-unpinned .
ev:pole-pinned   a gmeow:CriterionPole ; rdfs:label "Every span verifies against the source bytes"@en .
ev:pole-unpinned a gmeow:CriterionPole ; rdfs:label "Spans that do not match the source"@en .

ev:crit-grounding-recall a gmeow:Criterion ;
    rdfs:label "grounding recall"@en ;
    gmeow:criterionDomain gmeow:criterionDomainFactual ;
    gmeow:rewardPole ev:pole-recovered ;
    gmeow:penaltyPole ev:pole-missed .
ev:pole-recovered a gmeow:CriterionPole ; rdfs:label "Expected claims recovered with verified evidence"@en .
ev:pole-missed    a gmeow:CriterionPole ; rdfs:label "Supported claims left unextracted"@en .

ev:crit-hallucination a gmeow:Criterion ;
    rdfs:label "hallucination resistance"@en ;
    gmeow:criterionDomain gmeow:criterionDomainSafety ;
    gmeow:rewardPole ev:pole-grounded-only ;
    gmeow:penaltyPole ev:pole-fabricated .
ev:pole-grounded-only a gmeow:CriterionPole ; rdfs:label "Asserts only what evidence supports"@en .
ev:pole-fabricated    a gmeow:CriterionPole ; rdfs:label "Fabricates beyond the evidence"@en .

ev:crit-abstention a gmeow:Criterion ;
    rdfs:label "abstention quality"@en ;
    gmeow:criterionDomain gmeow:criterionDomainSafety ;
    gmeow:rewardPole ev:pole-declines ;
    gmeow:penaltyPole ev:pole-takes-bait .
ev:pole-declines  a gmeow:CriterionPole ; rdfs:label "Declines unsupported statements"@en .
ev:pole-takes-bait a gmeow:CriterionPole ; rdfs:label "Emits the unsupported bait"@en .

ev:crit-calibration a gmeow:Criterion ;
    rdfs:label "calibration"@en ;
    gmeow:criterionDomain gmeow:criterionDomainFactual ;
    gmeow:rewardPole ev:pole-honest ;
    gmeow:penaltyPole ev:pole-overconfident .
ev:pole-honest        a gmeow:CriterionPole ; rdfs:label "Stated confidence tracks measured grounding"@en .
ev:pole-overconfident a gmeow:CriterionPole ; rdfs:label "Confidence detached from grounding"@en .
