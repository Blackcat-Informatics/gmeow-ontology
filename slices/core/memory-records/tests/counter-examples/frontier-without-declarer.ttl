#
# A frontier that names its ledger, producer and committed point but no declarer.
# The declarer (wasAttributedTo) is the only missing required path.
@prefix ex: <https://example.org/trace-finality-counter/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:deriver a gmeow:SoftwareAgent .
ex:profile a gmeow:InformationObject ;
    dcterms:description "Each packet digest is the digest of the packet's bytes as the memory service wrote them."@en .
ex:ledger a gmeow:TracePacketLedger ;
    gmeow:wasAttributedTo ex:deriver .
ex:pointKey a gmeow:TraceAnchor ;
    gmeow:anchorPacket "4444444444444444444444444444444444444444444444444444444444444444"^^xsd:hexBinary ;
    gmeow:anchorSourceProfile ex:profile .
ex:frontier a gmeow:TraceMarkFrontier ;
    gmeow:traceFinalityLedger ex:ledger ;
    gmeow:traceFinalityProducer ex:deriver ;
    gmeow:frontierPoint ex:pointKey .
