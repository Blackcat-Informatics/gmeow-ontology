#
# Declarative structural assertions for the expertise slice — the slice-resident
# test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants formerly hand-written
# in tests/test_expertise.py. Each assertion runs as a SPARQL ASK over the expertise
# module graph (gmeow:scopeModule) under the native Rust slicetest harness
# (crates/slicetest). This slice is migrated, so the class stereotype
# is logic: (logic:Relator), not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_proficiency_scale_is_generalised — gmeow:ProficiencyScale is defined in
#     core/kernel; gmeow:cefrB2, gmeow:scaleILR, gmeow:scaleACTFL, gmeow:scaleSelfReported,
#     gmeow:scaleNIH, gmeow:scaleAssessed, gmeow:scaleCEFR are defined in the languages
#     extension (slices/extensions/languages/module.ttl) — all cross-slice subjects.
#   test_proficiency_levels_carry_scale — gmeow:cefrB2, gmeow:nihExpert, and
#     gmeow:assessedCompetent are cross-slice (languages extension); only
#     gmeow:dreyfusExpert is local, and a partial cell would silently under-test.
#   test_endorsement_uses_attestation — gmeow:Attestation is in the attestation
#     slice and gmeow:endorses is in the trust slice; both subjects are cross-slice.
#   test_no_primary_or_preferred_skill_term — sweeps ALL property types across
#     the full merged graph; a module-scoped ASK would silently narrow the sweep.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest→DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/expertise/tests/> .

# --- 1a. SkillProficiency is a subclass of logic:Relator (MUST) ----------------
ex:saSkillProficiencyIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:SkillProficiency rdfs:subClassOf logic:Relator . }""" ;
    gmeow:saRationale "gmeow:SkillProficiency MUST be a subclass of logic:Relator — the leveled skill-proficiency is a reified relator binding agent × skill × level × scale. Mirrors test_skill_proficiency_is_relator_with_functional_roles (subClassOf logic:Relator arm)." .

# --- 1b. Core roles of SkillProficiency are functional ObjectProperties (MUST) -
ex:saSkillProficiencyFunctionalRoles a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:skillProficiencyAgent  a owl:ObjectProperty , owl:FunctionalProperty .
    gmeow:skillProficiencyOf     a owl:ObjectProperty , owl:FunctionalProperty .
    gmeow:skillProficiencyLevel  a owl:ObjectProperty , owl:FunctionalProperty .
    gmeow:skillProficiencyScale  a owl:ObjectProperty , owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "The four core roles gmeow:skillProficiencyAgent / gmeow:skillProficiencyOf / gmeow:skillProficiencyLevel / gmeow:skillProficiencyScale MUST each be both owl:ObjectProperty and owl:FunctionalProperty — each is constitutive of the relator's identity. Mirrors test_skill_proficiency_is_relator_with_functional_roles (functional-roles arm)." .

# --- 2a. skillProficiencyInterval is an ObjectProperty (MUST) -----------------
ex:saSkillProficiencyIntervalIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:skillProficiencyInterval a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:skillProficiencyInterval MUST be an owl:ObjectProperty — the optional temporal scope of a proficiency is reified as a gmeow:TimeInterval. Mirrors test_skill_proficiency_interval_is_optional (ObjectProperty arm)." .

# --- 2b. skillProficiencyInterval is NOT functional (MUST-NOT) ----------------
ex:saSkillProficiencyIntervalNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:skillProficiencyInterval a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:skillProficiencyInterval MUST NOT be functional — proficiency may be temporally unbounded, and successive intervals coexist on a proficiency history. Mirrors test_skill_proficiency_interval_is_optional (NOT FunctionalProperty arm)." .

# --- 3. Dreyfus scale and levels are defined in the expertise slice (MUST) ----
ex:saDreyfusTermsExpertiseOwned a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
ASK {
    gmeow:scaleDreyfus         rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/expertise> ;
                               rdfs:label ?l0 ; skos:definition ?d0 .
    gmeow:dreyfusNovice        rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/expertise> ;
                               rdfs:label ?l1 ; skos:definition ?d1 .
    gmeow:dreyfusAdvancedBeginner rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/expertise> ;
                               rdfs:label ?l2 ; skos:definition ?d2 .
    gmeow:dreyfusCompetent     rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/expertise> ;
                               rdfs:label ?l3 ; skos:definition ?d3 .
    gmeow:dreyfusProficient    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/expertise> ;
                               rdfs:label ?l4 ; skos:definition ?d4 .
    gmeow:dreyfusExpert        rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/expertise> ;
                               rdfs:label ?l5 ; skos:definition ?d5 .
}""" ;
    gmeow:saRationale "gmeow:scaleDreyfus and all five Dreyfus level individuals MUST be defined by the expertise slice (rdfs:isDefinedBy) and MUST carry rdfs:label and skos:definition — the Dreyfus skill-acquisition scale belongs in its domain slice (expertise) so the learning slice's gmeow:fromLevel/gmeow:toLevel remain in closure. Mirrors test_dreyfus_scale_and_levels_are_expertise_owned (isDefinedBy + annotation arms)." .

# --- 4. Each Dreyfus level individual carries levelScale gmeow:scaleDreyfus (MUST) -
ex:saDreyfusLevelScaleLinks a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:dreyfusNovice           gmeow:levelScale gmeow:scaleDreyfus .
    gmeow:dreyfusAdvancedBeginner gmeow:levelScale gmeow:scaleDreyfus .
    gmeow:dreyfusCompetent        gmeow:levelScale gmeow:scaleDreyfus .
    gmeow:dreyfusProficient       gmeow:levelScale gmeow:scaleDreyfus .
    gmeow:dreyfusExpert           gmeow:levelScale gmeow:scaleDreyfus .
}""" ;
    gmeow:saRationale "All five Dreyfus level individuals MUST carry gmeow:levelScale gmeow:scaleDreyfus — the scale link is constitutive of the level individual (Principle 9). Mirrors test_dreyfus_scale_and_levels_are_expertise_owned (levelScale arm)." .

# --- 5a. holdsCredential, credentialIssuer, credentialFor are ObjectProperties (MUST) ---
ex:saCredentialPropertiesAreObjectProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:holdsCredential  a owl:ObjectProperty .
    gmeow:credentialIssuer a owl:ObjectProperty .
    gmeow:credentialFor    a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:holdsCredential, gmeow:credentialIssuer, and gmeow:credentialFor MUST each be owl:ObjectProperty — credential depth is modelled structurally with full OWL typing. Mirrors test_credential_properties_exist (ObjectProperty arm)." .

# --- 5b. occupationClassification is a DatatypeProperty with domain Occupation (MUST) ---
ex:saOccupationClassificationDatatype a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:occupationClassification a owl:DatatypeProperty ;
        rdfs:domain gmeow:Occupation .
}""" ;
    gmeow:saRationale "gmeow:occupationClassification MUST be an owl:DatatypeProperty with domain gmeow:Occupation — external codes (ESCO, SOC, O*NET) are open literals on the occupation (Principle 12). Mirrors test_credential_properties_exist (DatatypeProperty + domain arm)." .

# --- 6. credentialIssuer has range Organization and is functional (MUST) ------
ex:saCredentialIssuerRangeAndFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:credentialIssuer rdfs:range gmeow:Organization ;
        a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:credentialIssuer MUST have range gmeow:Organization and be an owl:FunctionalProperty — a different issuer is a constitutively different credential. Mirrors test_credential_issuer_is_organization." .

# --- 7. Banned value-vocabulary subclasses do not exist (MUST-NOT) ------------
ex:saNoValueVocabSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned {
        gmeow:SkillProficiencyLevel
        gmeow:DreyfusLevel
        gmeow:NIHLevel
        gmeow:AssessedLevel
        gmeow:CredentialType
    }
    ?banned a owl:Class .
}""" ;
    gmeow:saRationale "gmeow:SkillProficiencyLevel, gmeow:DreyfusLevel, gmeow:NIHLevel, gmeow:AssessedLevel, and gmeow:CredentialType MUST NOT be declared as owl:Class — Principle 9 requires levels and types to be named individuals of their respective classes, never subclasses. Mirrors test_value_vocabularies_not_subclasses." .

# --- 8. SkillProficiency has someValuesFrom restrictions on each core role (MUST) ---
ex:saSkillProficiencySomeValuesFrom a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SkillProficiency rdfs:subClassOf ?r1 , ?r2 , ?r3 , ?r4 .
    ?r1 owl:onProperty gmeow:skillProficiencyAgent ; owl:someValuesFrom gmeow:Agent .
    ?r2 owl:onProperty gmeow:skillProficiencyOf    ; owl:someValuesFrom gmeow:Skill .
    ?r3 owl:onProperty gmeow:skillProficiencyLevel ; owl:someValuesFrom gmeow:ProficiencyLevel .
    ?r4 owl:onProperty gmeow:skillProficiencyScale ; owl:someValuesFrom gmeow:ProficiencyScale .
}""" ;
    gmeow:saRationale "gmeow:SkillProficiency MUST carry OWL someValuesFrom restrictions on each of its four core roles (Agent, Skill, ProficiencyLevel, ProficiencyScale) — the open-world EL axiomatisation mirrors gmeow:LanguageProficiency. Mirrors test_skill_proficiency_some_values_from_axioms." .
