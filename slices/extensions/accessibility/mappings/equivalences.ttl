@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix schema:  <https://schema.org/> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .

# Term equivalences for the accessibility layer — GMEOW authoring source.
# Compiled to mappings/gmeow-accessibility.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetAccessibility a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/accessibility" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Accessibility alignments — schema.org, WHO ICF, IndoorGML/IMDF, and SOSA." .

# --------------------------------------------------------------------------- #
# schema.org — accessibilityFeature / accessibilityHazard
# --------------------------------------------------------------------------- #

gmeow:hasAccessibilityFeature skos:closeMatch schema:accessibilityFeature {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "schema:accessibilityFeature is a flat textual enum on Place/CreativeWork; GMEOW hasAccessibilityFeature is an object property ranging over AccessibilityFacet individuals. Directional lossy projection."
|} .

gmeow:hasBarrier skos:closeMatch schema:accessibilityHazard {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "schema:accessibilityHazard is a flat textual enum for hazards; GMEOW hasBarrier is an object property ranging over AccessibilityFacet individuals. Directional lossy projection."
|} .

# --------------------------------------------------------------------------- #
# SOSA — AccessibilityAssertion as a kind of observation
# --------------------------------------------------------------------------- #

gmeow:AccessibilityAssertion skos:closeMatch sosa:Observation {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "sosa:Observation is the generic observation class; gmeow:AccessibilityAssertion is a specialised gufo:Relator for accessibility claims. Both carry provenance and result."
|} .

# --------------------------------------------------------------------------- #
# WHO ICF — AccessibilityFacet individuals bridge to ICF categories
# --------------------------------------------------------------------------- #
# ICF codes use the HL7 FHIR sid: http://hl7.org/fhir/sid/icf
# Specific codes referenced conceptually; alignment is by reference only.

gmeow:facetWheelchair skos:closeMatch <http://hl7.org/fhir/sid/icf#d4> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Mobility" ;
    gmeow:comment "ICF d4 (Mobility) encompasses wheelchair and step-free locomotion."
|} .

gmeow:facetWheelchair skos:closeMatch <http://hl7.org/fhir/sid/icf#e115> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Products and technology for personal mobility" ;
    gmeow:comment "ICF e115 covers assistive products for personal mobility (wheelchairs, walkers, ramps)."
|} .

gmeow:facetStepFree skos:closeMatch <http://hl7.org/fhir/sid/icf#d4> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Mobility" ;
    gmeow:comment "ICF d4 (Mobility) encompasses step-free locomotion."
|} .

gmeow:facetVisual skos:closeMatch <http://hl7.org/fhir/sid/icf#b2> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Sensory functions and pain" ;
    gmeow:comment "ICF b2 covers sensory functions including vision."
|} .

gmeow:facetVisual skos:closeMatch <http://hl7.org/fhir/sid/icf#e135> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Products and technology for communication" ;
    gmeow:comment "ICF e135 covers assistive products for communication including visual aids."
|} .

gmeow:facetAuditory skos:closeMatch <http://hl7.org/fhir/sid/icf#b2> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Sensory functions and pain" ;
    gmeow:comment "ICF b2 covers sensory functions including hearing."
|} .

gmeow:facetAuditory skos:closeMatch <http://hl7.org/fhir/sid/icf#e125> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Products and technology for communication" ;
    gmeow:comment "ICF e125 covers assistive products for communication including hearing aids and induction loops."
|} .

gmeow:facetCognitive skos:closeMatch <http://hl7.org/fhir/sid/icf#b1> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Mental functions" ;
    gmeow:comment "ICF b1 covers mental functions including cognitive processes."
|} .

gmeow:facetCognitive skos:closeMatch <http://hl7.org/fhir/sid/icf#e140> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
