#
# Clean conformance fixture for the native math:ProbabilityOutOfBounds gate: a
# math:ProbabilityValue whose math:quantityValue magnitude (0.72) lies within the
# closed unit interval [0, 1]. It MUST raise NO probability failure class.
# Positive counterpart of counter-examples/probability-out-of-bounds.ttl.
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <http://example.org/math/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

ex:inBoundsProbability a math:ProbabilityValue ;
    math:quantityValue "0.72"^^xsd:decimal .
ex:inBoundsProbability math:hasDimension math:dimensionless .
