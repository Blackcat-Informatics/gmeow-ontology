        gmeow:boxConfigBox .

gmeow:payloadSchemaLangProjectionsArchive
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — lang projections archive"@x-gmeow-english ;
    skos:definition "The WHOLE lang: deliverable family, keyed by repo-relative path: everything under generated/projections/lang/ (the EBNF/ABNF/GBNF/Lark grammars, the GMN1 example corpus, the CoNLL-U readings, the TEI XML, the SEMAF AMR, the Web-Annotation JSON-LD, and the RDF side formats — a NIF stand-off .nt, the bcp47-tags.ttl tag set) plus the two NON-RDF terminology surfaces the same export leaf projects from the same reviewed .po fold: the ISO-30042 TBX termbase generated/projections/glossary.tbx and the human-readable table generated/catalog/glossary.md. Every one of them is a STANDALONE external-format file a consumer reads, and none reconstructs from a canonical named-graph fold — so they were already opaque byte projections. They ride THIS rep, and no longer the generated-opaque archive, because a rep is the unit a dictionary primes and these deliverables are one external-format family a consumer extracts on its own; the split costs ZERO ontological use, since their lang:ProjectionEmission and graph/lang-glossary-corpus semantics keep riding their named graphs independently. The RDF sibling generated/projections/glossary.vartrans.ttl is deliberately NOT a member: it rides its RDF-fanout named graph, and a named graph is never de-folded into bytes to widen a dictionary's population. It is primed by gmeow:dictGmeowLangAstV1, whose corpus is exactly this rep plus the authored lang: slice tree."@x-gmeow-english ;
    gmeow:payloadSchemaId "lang-projections-archive" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ;
    gmeow:payloadSchemaDictionary gmeow:dictGmeowLangAstV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:payloadSchemaLangSurfaceBlob
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — lang surface blob"@x-gmeow-english ;
    skos:definition "The lifted linguistic-surface blob: one frame per @x-gmeow-english source literal over the document-scale threshold. SINK-FOLDED — assembled only at the terminal snapshot, which is why gmeow:corpusGmeowLangAstV1 selects gmeow:payloadSchemaLangProjectionsArchive's rep and the authored lang: tree rather than this one. It is primed by gmeow:dictGmeowLangAstV1, the same dictionary that rep selects: both are linguistic surface, and a dictionary is measured over the whole frame set it primes."@x-gmeow-english ;
    gmeow:payloadSchemaId "lang-surface-blob" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileDistL12 ;
    gmeow:payloadSchemaDictionary gmeow:dictGmeowLangAstV1 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

gmeow:payloadSchemaMappingsArchive
    a gmeow:PayloadSchema ;
