# --- 24. CarrierMedium is a logic:AbstractIndividualType subclass of
#         logic:QualityValue (MUST) -------------------------------------------
ex:saCarrierMediumIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:CarrierMedium a logic:AbstractIndividualType , owl:Class ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:CarrierMedium MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- an open value vocabulary of medium individuals, never subclasses (Principle 9)." .

# --- 25. CarrierMedium seed individuals exist (MUST) ------------------------
ex:saCarrierMediumSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:mediumPrint        a gmeow:CarrierMedium .
    gmeow:mediumEInkFile     a gmeow:CarrierMedium .
    gmeow:mediumOpticalDisc  a gmeow:CarrierMedium .
    gmeow:mediumServerObject a gmeow:CarrierMedium .
}""" ;
    gmeow:saRationale "The four CarrierMedium seed individuals MUST exist as gmeow:CarrierMedium instances (open vocabulary -- superset check)." .

# --- 26. hasManifestationFormat is an ObjectProperty with
#         domain Manifestation and range ManifestationFormat (MUST) ----------
ex:saHasManifestationFormatShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasManifestationFormat a owl:ObjectProperty ;
        rdfs:domain gmeow:Manifestation ;
        rdfs:range gmeow:ManifestationFormat .
}""" ;
    gmeow:saRationale "gmeow:hasManifestationFormat MUST be an owl:ObjectProperty with domain gmeow:Manifestation and range gmeow:ManifestationFormat -- one format per Manifestation per asserter (SHACL-mandatory). Its functional character now rides on a logic:PropertyCharacteristicAssertion, DL-enforced, no longer a bare OWL property-type declaration." .

# --- 27. New issue-156 ManifestationFormat seeds exist (MUST) ---------------
ex:saManifestationFormatNewSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:formatWebSerial  a gmeow:ManifestationFormat .
    gmeow:formatComicIssue a gmeow:ManifestationFormat .
}""" ;
    gmeow:saRationale "gmeow:formatWebSerial and gmeow:formatComicIssue MUST exist as gmeow:ManifestationFormat instances -- the book/narrative model additions." .
