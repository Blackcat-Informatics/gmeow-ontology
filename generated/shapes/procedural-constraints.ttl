        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/appliesToSegment> ?v0 . } UNION { $this <https://blackcatinformatics.ca/gmeow/appliesToVoice> ?v1 . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/OrnamentProfileKindNoSubclassConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/OrnamentProfileKind> ;
