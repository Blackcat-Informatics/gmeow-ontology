# Projection: GMEOW → pure vcard. GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: non-displayable names (deadnames) dropped; the birth Participation (role, period, confidence, standpoint) and fuzzy-date bounds are dropped; only the principal's birth instant survives as vcard:bday; five declined forms collapse to the subject/object compact string (possessive-determiner, possessive, reflexive dropped); non-specifying values (any/ask/name-only, carrying no forms) are not emitted; period and standpoint are dropped.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX vcardx: <https://blackcatinformatics.ca/vcard-ext/>

CONSTRUCT {
    ?holder vcard:hasAddress ?addr .
    ?addr a vcard:Address .
    ?addr vcard:street-address ?street .
    ?addr vcard:locality ?locality .
    ?addr vcard:region ?region .
    ?addr vcard:postal-code ?pcode .
    ?addr vcard:country-name ?ccode .
    ?addr vcard:label ?label .
    ?ent vcard:fn ?dispName .
    ?ent vcard:hasName ?vname .
    ?vname a vcard:Name .
    ?vname vcard:given-name ?given .
    ?vname vcard:family-name ?family .
    ?ent vcard:nickname ?nick .
    ?ent vcard:bday ?bdate .
    ?ent vcard:title ?title .
    ?ent vcard:note ?desc .
    ?ent vcardx:pronouns ?pronouns .
    ?ent vcard:hasURL ?wp .
}
WHERE {
    {
        ?holder gmeow:hasContactPoint ?addr .
        ?addr a gmeow:PostalAddress .
        OPTIONAL { ?addr gmeow:streetAddress ?street . }
        OPTIONAL { ?addr gmeow:addressLocality ?locality . }
        OPTIONAL { ?addr gmeow:addressRegion ?region . }
        OPTIONAL { ?addr gmeow:postalCode ?pcode . }
        OPTIONAL { ?addr gmeow:countryCode ?ccode . }
        BIND ( CONCAT(COALESCE(?street, ""), ", ", COALESCE(?locality, ""), " ", COALESCE(?region, ""), " ", COALESCE(?pcode, ""), " ", COALESCE(?ccode, "")) AS ?label )
    }
    UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName ?app .
        ?app gmeow:fullName ?dispName .
        FILTER NOT EXISTS { ?app gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName ?app .
        ?app gmeow:hasNamePart ?np .
        ?np gmeow:namePartType gmeow:namePartGiven .
        ?np gmeow:partText ?given .
        BIND ( IRI(CONCAT(STR(?ent), "-vcardname")) AS ?vname )
        FILTER NOT EXISTS { ?app gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName ?app .
        ?app gmeow:hasNamePart ?np .
        ?np gmeow:namePartType gmeow:namePartSurname .
        ?np gmeow:partText ?family .
        BIND ( IRI(CONCAT(STR(?ent), "-vcardname")) AS ?vname )
        FILTER NOT EXISTS { ?app gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:hasName ?nn .
        ?nn gmeow:namePurpose gmeow:namePurposeNickname .
        ?nn gmeow:fullName ?nick .
        FILTER NOT EXISTS { ?nn gmeow:displayable false . }
    }
    UNION {
        ?b gmeow:eventType gmeow:eventTypeBirth .
        ?p gmeow:participationEvent ?b .
        ?p gmeow:participationRole gmeow:roleParticipantPrincipal .
        ?p gmeow:participationParticipant ?ent .
        ?b gmeow:eventTime ?bdate .
    }
    UNION {
        ?m a gmeow:Membership .
        ?m gmeow:membershipMember ?ent .
        ?m gmeow:hasRole ?r .
        ?r rdfs:label|gmeow:name ?title .
    }
    UNION {
        ?ent gmeow:description ?desc .
    }
    UNION {
        ?ent gmeow:hasPronounSet ?ps .
        ?ps gmeow:pronounSubject ?psubj .
        ?ps gmeow:pronounObject ?pobj .
        BIND ( CONCAT(?psubj, "/", ?pobj) AS ?pronouns )
    }
    UNION {
        ?ent gmeow:hasWebPage ?wp .
    }
}
