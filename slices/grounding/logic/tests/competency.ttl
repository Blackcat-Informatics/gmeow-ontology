ex:cqRecurrenceStates a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX logic: <https://blackcatinformatics.ca/logic/> SELECT ?term WHERE { ?term a logic:RecurrenceState } ORDER BY ?term" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A recurring commitment is not the same object as the run it spawns, and its five states are about the SCHEDULE rather than about any occurrence: suspended means the schedule stands but is not firing, skipped means one occurrence was passed over while the schedule kept running, and ended means the schedule itself is finished. Collapsing suspended into ended is how a paused weekly job silently stops being expected to return." ;
    gmeow:cqResultShape ex:cqKernelRosterShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:cqRecurrenceStatesRowRecurrenceActive , ex:cqRecurrenceStatesRowRecurrenceEnded , ex:cqRecurrenceStatesRowRecurrenceScheduled , ex:cqRecurrenceStatesRowRecurrenceSkipped , ex:cqRecurrenceStatesRowRecurrenceSuspended  .

ex:cqRecurrenceStatesRowRecurrenceActive a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:RecurrenceActive ] .
ex:cqRecurrenceStatesRowRecurrenceEnded a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:RecurrenceEnded ] .
