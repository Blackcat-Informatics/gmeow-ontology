# ── Standpoint: surface a tenure's frame and position onto its generated claim ─
# A gmeow:StandpointTenure generates a gmeow:StandpointClaim (a subClassOf
# gmeow:Observation). Two rules surface the tenure's standpoint and held position
# onto that claim: gmeow:tenureStandpoint ⇒ the claim's gmeow:vantage, and
# gmeow:tenurePosition ⇒ the claim's gmeow:observedFeature — the mapping the
# StandpointTenure prose documents, now derived so generic observation consumers
# read a tenure's claim on the universal observation spine uniformly.

logic:ruleTenureClaimVantage
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "surface a tenure's standpoint as its claim's vantage"@x-gmeow-english ;
    skos:definition "Emits gmeow:vantage(claim, standpoint) whenever a gmeow:StandpointTenure gmeow:standpointClaim a claim and gmeow:tenureStandpoint a standpoint: the tenure's frame becomes the vantage of its generated gmeow:StandpointClaim observation, so 'whose frame' reads uniformly across tenures and bare observations. Positive Horn; monotone; materialized natively."@x-gmeow-english ;
    logic:provenance logic:ruleTenureClaimVantage ;
    logic:formalizes gmeow:StandpointTenure ;
    logic:head [
        rdf:subject   "?claim" ;
        rdf:predicate gmeow:vantage ;
        rdf:object    "?standpoint"
    ] ;
    logic:body [
        rdf:subject   "?tenure" ;
        rdf:predicate gmeow:standpointClaim ;
        rdf:object    "?claim"
    ] , [
        rdf:subject   "?tenure" ;
        rdf:predicate gmeow:tenureStandpoint ;
        rdf:object    "?standpoint"
    ] .

logic:ruleTenureClaimObservedFeature
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "surface a tenure's position as its claim's observed feature"@x-gmeow-english ;
    skos:definition "Emits gmeow:observedFeature(claim, position) whenever a gmeow:StandpointTenure gmeow:standpointClaim a claim and gmeow:tenurePosition a position: the tenure's held position becomes the observedFeature of its generated gmeow:StandpointClaim observation, so 'what is claimed' reads uniformly on the observation spine. Positive Horn; monotone; materialized natively."@x-gmeow-english ;
    logic:provenance logic:ruleTenureClaimObservedFeature ;
    logic:formalizes gmeow:StandpointTenure ;
    logic:head [
        rdf:subject   "?claim" ;
        rdf:predicate gmeow:observedFeature ;
        rdf:object    "?position"
    ] ;
    logic:body [
        rdf:subject   "?tenure" ;
        rdf:predicate gmeow:standpointClaim ;
        rdf:object    "?claim"
    ] , [
        rdf:subject   "?tenure" ;
        rdf:predicate gmeow:tenurePosition ;
        rdf:object    "?position"
    ] .

logic:cqTenureClaimSurfacingHolds
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a tenure's frame and position surface onto its generated claim"@x-gmeow-english ;
    skos:definition "The positive competency case the tenure-claim-surfacing rules must satisfy: given a gmeow:StandpointTenure that gmeow:standpointClaim a claim, gmeow:tenureStandpoint a standpoint, and gmeow:tenurePosition a position, the reasoner must derive gmeow:vantage from the claim to that standpoint AND gmeow:observedFeature from the claim to that position — the tenure→claim mapping the harvested prose commits to."@x-gmeow-english .

logic:cqTenureClaimSurfacingSwapRejected
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "the tenure→claim mapping is never swapped"@x-gmeow-english ;
    skos:definition "The negative countermodel the tenure-claim-surfacing rules must respect: the mapping is directional and specific — the tenureStandpoint becomes the claim's gmeow:vantage (never its gmeow:observedFeature) and the tenurePosition becomes the claim's gmeow:observedFeature (never its gmeow:vantage), and a tenure with no gmeow:standpointClaim surfaces nothing. The boundary that keeps frame and position from being crossed onto the wrong role."@x-gmeow-english .

logic:candidateTenureClaimSurfacing
    a owl:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a tenure's frame and position surface onto its generated claim"@x-gmeow-english ;
    skos:definition "The derivation-rule formalization candidate governing logic:ruleTenureClaimVantage and logic:ruleTenureClaimObservedFeature: it harvests the tenure→claim mapping documented in gmeow:StandpointTenure's skos:definition (the tenureStandpoint maps to the claim's vantage; the tenurePosition maps to the claim's observedFeature) into two enforced positive-Horn derivation rules, materialized natively as logic:ExactPreservation. Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation) with a positive case (logic:cqTenureClaimSurfacingHolds) and a negative countermodel (logic:cqTenureClaimSurfacingSwapRejected). Its harvest back-link (logic:candidateFormalizes gmeow:StandpointTenure, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose, and logic:candidateSourceHash is the sha256 of that definition text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:4969424252e18b640bea0671288eaebc38084df25d9263ba1651eb621a24cf47"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from gmeow:StandpointTenure's skos:definition, which states the tenureStandpoint maps to the generated claim's vantage and the tenurePosition maps to its observedFeature (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "derivation: gmeow:standpointClaim with gmeow:tenureStandpoint ⇒ gmeow:vantage, and with gmeow:tenurePosition ⇒ gmeow:observedFeature, onto the generated StandpointClaim"^^xsd:string ;
    logic:candidateContract logic:PositiveHornProfile ;
    logic:candidateCategory logic:CategoryDerivationRule ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidatePositiveCase logic:cqTenureClaimSurfacingHolds ;
    logic:candidateNegativeCase logic:cqTenureClaimSurfacingSwapRejected ;
    logic:candidateProjectionBehavior logic:ExactPreservation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes gmeow:StandpointTenure ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# ── Deliberate-non-assertion guardrails — the intentional boundaries, executable ──
# The maximal-formalization harvest must never quietly over-constrain: every deliberate
# non-assertion the design commits to is recorded here as a reviewed
# logic:FormalizationCandidate, so an over-eager axiom that would cross one of these
# boundaries is surfaced (logic:ObligationViolated, or a discipline logic:violation) and
# returned to review rather than silently asserted into the reasoned core. Two guardrails
# forbid an entailment via a standing logic:NonEntailmentObligation (Arm A syntactic
# reachability over rule heads + Arm B finite closure over derived edges); two are
# integrity constraints whose violation is a finding, wrapping the existing foundation
# disciplines that already fire it. The deliberately-preserved gmeow:SocialObject ∩
# gmeow:InformationObject overlap (logic:candidateSocialInformationOverlap,
# logic:CategoryDeliberateOverlap, authored above) is the fifth boundary. Each carries a
# harvest back-link so the whole boundary set is queryable in the deliberate-non-assertion
# report. This machinery IS the foundation's guard against over-typing (Principle 9's
# refusal to over-assert): the review of an over-typing collision is the obligation /
# discipline check itself, not a separate advisory flag (design/LOGIC-FOUNDATION.md,
# §Typed formalization governance).

# 1. Intent is attributed, never entailed (deception) — a forbidden entailment.
logic:candidateIntentNotEntailed
    a owl:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "deceptive intent is attributed, never entailed"@x-gmeow-english ;
    skos:definition "The deliberate-non-assertion formalization candidate carrying the standing commitment that deceptive intent must never be entailed: gmeow:deceptiveIntentClaim is an attributed, defeasible standpoint claim, so a held≠projected structural gap is EVIDENCE, never ENTAILMENT, of intent, and the foundation must never derive the predicate. Realized as the logic:NonEntailmentObligation logic:IntentNotFromDeceptionObligation and enforced by Arm A syntactic reachability over the rule heads plus Arm B finite closure over the materialized derivation graph. Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation). The semantic risk is core-contaminating: a mis-formalization that closed this inference would corrupt the reasoned core with an entailed intent, so the guardrail protects the core, not merely a projection. Its harvest back-link (logic:candidateFormalizes gmeow:deceptiveIntentClaim, logic:candidateSourceField logic:ProseFieldAvoidWhen) ties it to the exact prose that forbids the entailment, and logic:candidateSourceHash is the sha256 of that gmeow:avoidWhen text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:4750f37f26e7b1dd379cade0cb9a93d1d7aa6f64c205db27583d832344108245"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from gmeow:deceptiveIntentClaim's gmeow:avoidWhen, which states never let the reasoner entail deceptiveness (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "gmeow:deceptiveIntentClaim over deception events: intent stays an attributed, defeasible claim, never a reasoned entailment"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryNonEntailmentObligation ;
    logic:candidateDeliberateNonAssertion true ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidateNonEntailment logic:IntentNotFromDeceptionObligation ;
    logic:candidateProjectionBehavior logic:ValidationOnly ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes gmeow:deceptiveIntentClaim ;
    logic:candidateSourceField logic:ProseFieldAvoidWhen .

# 2. Counterpart is symmetric-only, never transitive (coreference) — a forbidden entailment.
logic:candidateCounterpartNonTransitive
    a owl:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "counterpart stays symmetric-only, never transitive"@x-gmeow-english ;
    skos:definition "The deliberate-non-assertion formalization candidate carrying the standing commitment that cross-realm counterpart identity (gmeow:counterpartOf) stays non-transitive: it is symmetric by design but must never chain, so contested, standpoint-indexed, or context-dependent claims are never transitively collapsed into owl:sameAs identity. Realized as the logic:NonEntailmentObligation logic:CounterpartNonTransitivityObligation and enforced by Arm A syntactic reachability over the counterpart rule heads (no rule head produces the predicate). Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation). The semantic risk is core-contaminating: a careless transitivity rule would corrupt the reasoned core by merging entities the design keeps distinct. Its harvest back-link (logic:candidateFormalizes gmeow:counterpartOf, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose that commits to non-transitivity, and logic:candidateSourceHash is the sha256 of that skos:definition text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:b2318705c42e37e940f1c2809e1c6a081517082ce26a6e15bbcca4e2f49deff5"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from gmeow:counterpartOf's skos:definition, which states it is symmetric but deliberately not transitive (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "gmeow:counterpartOf across realms, frames and datasets: symmetric-only, never transitively chained"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryNonEntailmentObligation ;
    logic:candidateDeliberateNonAssertion true ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidateNonEntailment logic:CounterpartNonTransitivityObligation ;
    logic:candidateProjectionBehavior logic:ValidationOnly ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes gmeow:counterpartOf ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# 3. Frame-relativity: no frame-free value (Principle 11) — an integrity constraint.
logic:cqFrameRelativityHolds
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a framed value stays well-formed"@x-gmeow-english ;
    skos:definition "The positive competency case the frame-relativity constraint must satisfy: a logic:measuredValue expressed together with its logic:referenceFrame is well-formed — it carries no logic:MeasurementFrameMissing violation — because the value is meaningful only paired with the frame it is expressed in (Principle 11)."@x-gmeow-english .

logic:cqFrameRelativityFramelessRejected
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a frame-free value is rejected"@x-gmeow-english ;
    skos:definition "The negative countermodel the frame-relativity constraint must respect: a logic:measuredValue asserted with no logic:referenceFrame is the logic:MeasurementFrameMissing violation — a frame-free value collapse the foundation catches as a finding, never admits as a well-formed model. The boundary Principle 11 enforces: a value asserted without its frame is ill-formed, and two frame-relative values are never equated frame-free."@x-gmeow-english .

logic:candidateFrameRelativity
    a owl:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "measured values are frame-relative — no frame-free collapse"@x-gmeow-english ;
    skos:definition "The integrity-constraint formalization candidate that harvests Principle 11 frame-relativity from logic:referenceFrame's skos:definition into the enforced logic:MeasurementFrameMissing constraint: a logic:measuredValue is meaningful only together with the logic:referenceFrame it is expressed in, so a frame-free value is ill-formed and two frame-relative values are never equated frame-free. Violation is a finding, not a derivation, materialized by the existing foundation quality discipline. Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation) with a positive case (logic:cqFrameRelativityHolds — a framed value stays well-formed) and a negative countermodel (logic:cqFrameRelativityFramelessRejected — a frame-free value is the logic:MeasurementFrameMissing violation). Its harvest back-link (logic:candidateFormalizes logic:referenceFrame, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose, and logic:candidateSourceHash is the sha256 of that definition text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:2e7a0baa563e6237f44afac81e9cc35ca4fa4c2dff5f55deb9fdc99a8777deeb"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from logic:referenceFrame's skos:definition, which states a logic:measuredValue with no logic:referenceFrame is the logic:MeasurementFrameMissing violation (Principle 11; design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "the true-quantity/measured-value seam: a logic:measuredValue is frame-relative and ill-formed without its logic:referenceFrame; no frame-free equality collapse"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryIntegrityConstraint ;
    logic:candidateDeliberateNonAssertion true ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidatePositiveCase logic:cqFrameRelativityHolds ;
    logic:candidateNegativeCase logic:cqFrameRelativityFramelessRejected ;
    logic:candidateProjectionBehavior logic:SoundUnderApproximation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes logic:referenceFrame ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# 4. No over-typing: at most one ultimate Kind (Principle 9, MixIden) — an integrity constraint.
logic:cqNoOverTypingHolds
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a single-Kind instance is well-formed"@x-gmeow-english ;
    skos:definition "The positive competency case the no-over-typing constraint must satisfy: an object whose sortal traces its principle of identity to exactly one ultimate logic:Kind is well-formed — it carries no logic:MixIden violation — because a Kind supplies a single principle of identity (Principle 9's refusal to over-type)."@x-gmeow-english .

logic:cqNoOverTypingTwoKindsRejected
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a two-Kind instance is rejected"@x-gmeow-english ;
    skos:definition "The negative countermodel the no-over-typing constraint must respect: a sortal tracing its identity to two-or-more disjoint logic:Kinds is the logic:MixIden violation — over-typing the foundation catches as a finding, never admits as a well-formed model. The boundary Principle 9 enforces: co-equal facets are not fused into two disjoint identity-supplying Kinds on one instance."@x-gmeow-english .

logic:candidateNoOverTyping
    a owl:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "an instance carries at most one ultimate Kind — no over-typing"@x-gmeow-english ;
    skos:definition "The integrity-constraint formalization candidate that harvests Principle 9's no-over-typing boundary from logic:MixIden's skos:definition into the enforced identity-overlap discipline: a sortal inherits its principle of identity from exactly one Kind, so an instance tracing to two-or-more disjoint Kinds is the logic:MixIden violation. Violation is a finding, not a derivation, materialized by the existing foundation identity discipline (it wraps logic:MixIden, it does not duplicate it). Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation) with a positive case (logic:cqNoOverTypingHolds — a single-Kind instance is well-formed) and a negative countermodel (logic:cqNoOverTypingTwoKindsRejected — a two-Kind instance is the logic:MixIden violation). Its harvest back-link (logic:candidateFormalizes logic:MixIden, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose, and logic:candidateSourceHash is the sha256 of that definition text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:c806598361dd99032b2934b0f76cb2aa9a773b51a280f9240b76b57f17315266"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from logic:MixIden's skos:definition, which states a sortal inherits its principle of identity from exactly one Kind and tracing to two-or-more Kinds violates it (Principle 9; design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "logic:Kind identity supply: an instance's sortal traces to exactly one ultimate Kind; two disjoint Kinds on one instance is over-typing"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryIntegrityConstraint ;
    logic:candidateDeliberateNonAssertion true ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidatePositiveCase logic:cqNoOverTypingHolds ;
    logic:candidateNegativeCase logic:cqNoOverTypingTwoKindsRejected ;
    logic:candidateProjectionBehavior logic:SoundUnderApproximation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes logic:MixIden ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# =========================================================================== #
# Declarative constraint axioms — canonical OWL 2 DL antecedents for the logic
# slice's closed-world validation projection (Principles 4 and 17). Required
# paths use class-scoped closure entries paired with owl:allValuesFrom, and
# at-most-one uses owl:FunctionalProperty. No OWL existential or raw cardinality
# restriction is needed or permitted here.
# =========================================================================== #

# These properties are intentionally closed on the validation surface. Their
# owl:allValuesFrom restrictions therefore gain sh:minCount 1 for the named
# class/property pair; properties without this explicit closure entry keep the
# conservative open-world universal reading.
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateSourceHash" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateExtractionProvenance" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateScope" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateContract" ; logic:closureValue logic:ClosedWorldClosure ] .
