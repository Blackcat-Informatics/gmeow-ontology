#
# Declarative competency question for the agentic slice, executed by the
# native Rust slice-test harness (crates/slicetest). Migrated from
# tests/test_agentic.py::test_example_answers_which_tool_under_which_invocation.
#
# The worked example (slices/core/agentic/examples/agent-trajectory.ttl)
# must answer: "Which tool produced this entity, called by which invocation,
# with what arguments?"

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/> .
@prefix ext:   <https://blackcatinformatics.ca/gmeow/examples/agentic/tests/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .

ext:cqWhichToolUnderWhichInvocation a gmeow:CompetencyQuestion ;
    gmeow:cqQuery """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX ex: <https://blackcatinformatics.ca/gmeow/examples/>
SELECT ?tool ?invocation ?args WHERE {
    ex:note-2200 gmeow:wasGeneratedBy ?call .
    ?call a gmeow:ToolCall ;
          gmeow:usedTool ?tool ;
          gmeow:calledByInvocation ?invocation ;
          gmeow:toolArguments ?args .
}""" ;
    gmeow:cqDataFile "examples/agent-trajectory.ttl" ;
    gmeow:cqRationale "The agentic trajectory example must answer which tool produced ex:note-2200, under which invocation, with what arguments — the tool-call provenance question." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ext:cqWhichToolShape ;
    gmeow:cqExpectRow ext:cqWhichToolRow .

ext:cqWhichToolShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "tool" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "invocation" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "args" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ext:cqWhichToolRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "tool" ; gmeow:cellValueIri ex:storeClaim ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "invocation" ; gmeow:cellValueIri ex:invocation-7 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "args" ; gmeow:cellValueLiteral "{\"text\": \"the GTS spec mandates RFC 8949 deterministic encoding\"}" ] .
