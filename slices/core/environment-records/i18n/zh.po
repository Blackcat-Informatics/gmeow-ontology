msgctxt "https://blackcatinformatics.ca/gmeow/acceptanceEvidence|http://www.w3.org/2000/01/rdf-schema#label"
msgid "acceptance source evidence"
msgstr "接受来源证据"

msgctxt "https://blackcatinformatics.ca/gmeow/acceptanceEvidence|http://www.w3.org/2004/02/skos/core#definition"
msgid "The original documentary artifact supporting this acceptance act. Evidence describes the act without asserting that a later document generated the earlier event."
msgstr "支持此接受行为的原始文档制品。证据描述行为，而不声称后来的文档产生了更早的事件。"

msgctxt "https://blackcatinformatics.ca/gmeow/acceptanceEvidence|https://blackcatinformatics.ca/gmeow/useWhen"
