% === Rules ===
#[name("https://blackcatinformatics.ca/logic/ruleProjectHasMastered")]
<https://blackcatinformatics.ca/gmeow/hasMastered>(?agent, ?subject, ?W) :-
    <https://blackcatinformatics.ca/logic/assessedAgent>(?assessProc, ?agent, ?W),
    <https://blackcatinformatics.ca/logic/assessmentDimension>(?assessProc, <https://blackcatinformatics.ca/logic/dimensionProceduralCompetence>, ?W),
    <https://blackcatinformatics.ca/logic/assessmentLevel>(?assessProc, ?levelProc, ?W),
    <https://blackcatinformatics.ca/logic/assessmentSubject>(?assessProc, ?subject, ?W),
    <https://blackcatinformatics.ca/logic/assessedAgent>(?assessTransfer, ?agent, ?W),
    <https://blackcatinformatics.ca/logic/assessmentDimension>(?assessTransfer, <https://blackcatinformatics.ca/logic/dimensionTransfer>, ?W),
    <https://blackcatinformatics.ca/logic/assessmentLevel>(?assessTransfer, ?levelTransfer, ?W),
    <https://blackcatinformatics.ca/logic/assessmentSubject>(?assessTransfer, ?subject, ?W),
    <https://blackcatinformatics.ca/logic/levelAtOrAbove>(?levelProc, ?thresholdProc, ?W),
    <https://blackcatinformatics.ca/logic/levelAtOrAbove>(?levelTransfer, ?thresholdTransfer, ?W),
    <https://blackcatinformatics.ca/logic/hasThresholdRow>(?profile, ?rowProc, ?W),
    <https://blackcatinformatics.ca/logic/hasThresholdRow>(?profile, ?rowTransfer, ?W),
    <https://blackcatinformatics.ca/logic/projectsLadderEdge>(?rowProc, <https://blackcatinformatics.ca/gmeow/hasMastered>, ?W),
    <https://blackcatinformatics.ca/logic/sourceDimension>(?rowProc, <https://blackcatinformatics.ca/logic/dimensionProceduralCompetence>, ?W),
    <https://blackcatinformatics.ca/logic/thresholdLevel>(?rowProc, ?thresholdProc, ?W),
    <https://blackcatinformatics.ca/logic/projectsLadderEdge>(?rowTransfer, <https://blackcatinformatics.ca/gmeow/hasMastered>, ?W),
    <https://blackcatinformatics.ca/logic/sourceDimension>(?rowTransfer, <https://blackcatinformatics.ca/logic/dimensionTransfer>, ?W),
    <https://blackcatinformatics.ca/logic/thresholdLevel>(?rowTransfer, ?thresholdTransfer, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleProjectIsAwareOf")]
<https://blackcatinformatics.ca/gmeow/isAwareOf>(?agent, ?subject, ?W) :-
    <https://blackcatinformatics.ca/logic/assessedAgent>(?assessment, ?agent, ?W),
    <https://blackcatinformatics.ca/logic/assessmentDimension>(?assessment, ?dim, ?W),
    <https://blackcatinformatics.ca/logic/assessmentLevel>(?assessment, ?level, ?W),
    <https://blackcatinformatics.ca/logic/assessmentSubject>(?assessment, ?subject, ?W),
    <https://blackcatinformatics.ca/logic/levelAtOrAbove>(?level, ?threshold, ?W),
    <https://blackcatinformatics.ca/logic/hasThresholdRow>(?profile, ?row, ?W),
    <https://blackcatinformatics.ca/logic/projectsLadderEdge>(?row, <https://blackcatinformatics.ca/gmeow/isAwareOf>, ?W),
    <https://blackcatinformatics.ca/logic/sourceDimension>(?row, ?dim, ?W),
    <https://blackcatinformatics.ca/logic/thresholdLevel>(?row, ?threshold, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleProjectKnowsAbout")]
<https://blackcatinformatics.ca/gmeow/knowsAbout>(?agent, ?subject, ?W) :-
    <https://blackcatinformatics.ca/logic/assessedAgent>(?assessment, ?agent, ?W),
    <https://blackcatinformatics.ca/logic/assessmentDimension>(?assessment, ?dim, ?W),
    <https://blackcatinformatics.ca/logic/assessmentLevel>(?assessment, ?level, ?W),
    <https://blackcatinformatics.ca/logic/assessmentSubject>(?assessment, ?subject, ?W),
    <https://blackcatinformatics.ca/logic/levelAtOrAbove>(?level, ?threshold, ?W),
    <https://blackcatinformatics.ca/logic/hasThresholdRow>(?profile, ?row, ?W),
    <https://blackcatinformatics.ca/logic/projectsLadderEdge>(?row, <https://blackcatinformatics.ca/gmeow/knowsAbout>, ?W),
    <https://blackcatinformatics.ca/logic/sourceDimension>(?row, ?dim, ?W),
    <https://blackcatinformatics.ca/logic/thresholdLevel>(?row, ?threshold, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleOrgMembershipPropagation")]
<https://blackcatinformatics.ca/gmeow/memberOf>(?agent, ?parent, ?W) :-
    <https://blackcatinformatics.ca/gmeow/memberOf>(?agent, ?org, ?W),
    <https://blackcatinformatics.ca/gmeow/subOrganizationOf>(?org, ?parent, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleProjectUnderstands")]
<https://blackcatinformatics.ca/gmeow/understands>(?agent, ?subject, ?W) :-
    <https://blackcatinformatics.ca/logic/assessedAgent>(?assessment, ?agent, ?W),
    <https://blackcatinformatics.ca/logic/assessmentDimension>(?assessment, ?dim, ?W),
    <https://blackcatinformatics.ca/logic/assessmentLevel>(?assessment, ?level, ?W),
    <https://blackcatinformatics.ca/logic/assessmentSubject>(?assessment, ?subject, ?W),
    <https://blackcatinformatics.ca/logic/levelAtOrAbove>(?level, ?threshold, ?W),
    <https://blackcatinformatics.ca/logic/hasThresholdRow>(?profile, ?row, ?W),
    <https://blackcatinformatics.ca/logic/projectsLadderEdge>(?row, <https://blackcatinformatics.ca/gmeow/understands>, ?W),
    <https://blackcatinformatics.ca/logic/sourceDimension>(?row, ?dim, ?W),
    <https://blackcatinformatics.ca/logic/thresholdLevel>(?row, ?threshold, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleTenureClaimObservedFeature")]
<https://blackcatinformatics.ca/gmeow/observedFeature>(?claim, ?position, ?W) :-
    <https://blackcatinformatics.ca/gmeow/standpointClaim>(?tenure, ?claim, ?W),
    <https://blackcatinformatics.ca/gmeow/tenurePosition>(?tenure, ?position, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleTenureClaimVantage")]
<https://blackcatinformatics.ca/gmeow/vantage>(?claim, ?standpoint, ?W) :-
    <https://blackcatinformatics.ca/gmeow/standpointClaim>(?tenure, ?claim, ?W),
    <https://blackcatinformatics.ca/gmeow/tenureStandpoint>(?tenure, ?standpoint, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleIndirectContributor")]
<https://blackcatinformatics.ca/gmeow/indirectContributor>(?entity, ?agent, ?W) :-
    <https://blackcatinformatics.ca/gmeow/wasAssociatedWith>(?activity, ?agent, ?W),
    <https://blackcatinformatics.ca/gmeow/wasGeneratedBy>(?entity, ?activity, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleCrossNodeGlut")]
<https://blackcatinformatics.ca/gmeow/crossNodeGlutWith>(?f1, ?f2, ?W) :-
    <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>(?anchor, <https://blackcatinformatics.ca/gmeow/NonTrivialAnchor>, ?W),
    <https://blackcatinformatics.ca/gmeow/categoryPolarity>(?category1, <https://blackcatinformatics.ca/logic/InfoSupported>, ?W),
    <https://blackcatinformatics.ca/gmeow/categoryPolarity>(?category2, <https://blackcatinformatics.ca/logic/InfoOpposed>, ?W),
    <https://blackcatinformatics.ca/gmeow/findingAnchor>(?f1, ?anchor, ?W),
    <https://blackcatinformatics.ca/gmeow/findingCategory>(?f1, ?category1, ?W),
    <https://blackcatinformatics.ca/gmeow/findingAnchor>(?f2, ?anchor, ?W),
    <https://blackcatinformatics.ca/gmeow/findingCategory>(?f2, ?category2, ?W),
    ?f1 != ?f2 .
#[name("https://blackcatinformatics.ca/logic/ruleFindingCluster")]
<https://blackcatinformatics.ca/gmeow/findingCluster>(?finding, ?root, ?W) :-
    <https://blackcatinformatics.ca/gmeow/findingRootCause>(?finding, ?root, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleGateFatalVerdict")]
<https://blackcatinformatics.ca/gmeow/findingGateVerdict>(?finding, <https://blackcatinformatics.ca/gmeow/gateFatal>, ?W) :-
    <https://blackcatinformatics.ca/gmeow/categoryBlocking>(?category, <https://blackcatinformatics.ca/gmeow/blockingBlocking>, ?W),
    <https://blackcatinformatics.ca/gmeow/findingCategory>(?finding, ?category, ?W),
    <https://blackcatinformatics.ca/gmeow/findingSeverity>(?finding, <https://blackcatinformatics.ca/gmeow/severityError>, ?W),
    <https://blackcatinformatics.ca/gmeow/findingStandpoint>(?finding, <https://blackcatinformatics.ca/gmeow/standpointBinding>, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleFindingHasAntecedent")]
<https://blackcatinformatics.ca/gmeow/findingHasAntecedent>(?finding, ?finding, ?W) :-
    <https://blackcatinformatics.ca/gmeow/findingAntecedent>(?finding, ?antecedent, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleFindingRootCause")]
<https://blackcatinformatics.ca/gmeow/findingRootCause>(?finding, ?root, ?W) :-
    <https://blackcatinformatics.ca/gmeow/findingTraces>(?finding, ?root, ?W),
    ~<https://blackcatinformatics.ca/gmeow/findingHasAntecedent>(?root, ?root, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleFindingTracesBase")]
<https://blackcatinformatics.ca/gmeow/findingTraces>(?finding, ?antecedent, ?W) :-
    <https://blackcatinformatics.ca/gmeow/findingAntecedent>(?finding, ?antecedent, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleFindingTracesStep")]
<https://blackcatinformatics.ca/gmeow/findingTraces>(?finding, ?root, ?W) :-
    <https://blackcatinformatics.ca/gmeow/findingAntecedent>(?finding, ?intermediate, ?W),
    <https://blackcatinformatics.ca/gmeow/findingTraces>(?intermediate, ?root, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleInstantiatesWork")]
<https://blackcatinformatics.ca/gmeow/instantiatesWork>(?item, ?work, ?W) :-
    <https://blackcatinformatics.ca/gmeow/realizes>(?expression, ?work, ?W),
    <https://blackcatinformatics.ca/gmeow/exemplifies>(?item, ?manifestation, ?W),
    <https://blackcatinformatics.ca/gmeow/embodies>(?manifestation, ?expression, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleFindingClusterType")]
<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>(?root, <https://blackcatinformatics.ca/gmeow/FindingCluster>, ?W) :-
    <https://blackcatinformatics.ca/gmeow/findingRootCause>(?finding, ?root, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleRootFinding")]
<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>(?root, <https://blackcatinformatics.ca/gmeow/RootFinding>, ?W) :-
    <https://blackcatinformatics.ca/gmeow/findingRootCause>(?finding, ?root, ?W) .
#[name("https://blackcatinformatics.ca/logic/ruleClusterRoot")]
<https://blackcatinformatics.ca/gmeow/clusterRoot>(?root, ?root, ?W) :-
    <https://blackcatinformatics.ca/gmeow/findingRootCause>(?finding, ?root, ?W) .
