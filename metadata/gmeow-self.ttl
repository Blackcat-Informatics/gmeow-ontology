@prefix foaf:    <http://xmlns.com/foaf/0.1/> .

<https://blackcatinformatics.ca/gmeow/self>
    a owl:Ontology ;
    rdfs:label "GMEOW Self-Description"@x-gmeow-english ;
    owl:imports <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# WORK — the abstract intellectual creation
# =========================================================================== #

<https://blackcatinformatics.ca/gmeow>
    a gmeow:Work ;
    rdfs:label "GMEOW — Global Metadata and Entity Ontology for the Web"@x-gmeow-english ;
    skos:definition "A reasoning-centric, OWL 2 DL, upper-ontology-grounded super-vocabulary that unifies document metadata, entity descriptions, legal agreements, contacts, and person-centric data."@x-gmeow-english ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    foaf:homepage <https://blackcatinformatics.ca/gmeow> ;
    gmeow:datePublished "2026-06-03"^^xsd:date .

# =========================================================================== #
# EXPRESSION — a specific realization of the Work
# =========================================================================== #

:expression
    a gmeow:Expression ;
    gmeow:realizes <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# MANIFESTATION — a concrete, versioned publication
# =========================================================================== #

<https://blackcatinformatics.ca/gmeow/0.1.0>
    a gmeow:Manifestation ;
    gmeow:embodies :expression ;
    gmeow:versionFingerprint "0.1.0" ;
    gmeow:datePublished "2026-06-03"^^xsd:date ;
    dcterms:identifier "10.XXXXX/gmeow" ;
    dcterms:publisher <https://blackcatinformatics.ca/#bii> .

<https://blackcatinformatics.ca/#bii>
    a foaf:Organization ;
    foaf:name "Blackcat Informatics Inc."@x-gmeow-english ;
    foaf:mbox <mailto:doi@blackcatinformatics.ca> .

# =========================================================================== #
# CONTRIBUTION — creator credit with CRediT role and degree
# =========================================================================== #

:contribution-bii
    a gmeow:Contribution ;
    gmeow:contributor <https://blackcatinformatics.ca/#bii> ;
    gmeow:contributionTarget <https://blackcatinformatics.ca/gmeow> ;
    gmeow:contributionRole gmeow:roleAuthor ;
    gmeow:contributionDegree gmeow:degreeLead .

