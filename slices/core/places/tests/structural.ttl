# --- 91. Psychological axes exist (MUST) -------------------------------------
ex:saPsychologicalAxesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:axisValence              a gmeow:Axis .
    gmeow:axisArousal              a gmeow:Axis .
    gmeow:axisConceptualSimilarity a gmeow:Axis .
    gmeow:axisEgocentricForward    a gmeow:Axis .
    gmeow:axisEgocentricLateral    a gmeow:Axis .
    gmeow:axisAllocentricX         a gmeow:Axis .
    gmeow:axisAllocentricY         a gmeow:Axis .
    gmeow:axisImaginedSpaceX       a gmeow:Axis .
    gmeow:axisImaginedSpaceY       a gmeow:Axis .
    gmeow:axisImaginedSpaceZ       a gmeow:Axis .
}""" ;
    gmeow:saRationale "The ten psychological/cognitive axis individuals MUST exist. Mirrors test_psychological_axes_exist." .

# --- 92. BiologicalSequenceLocation subclasses Location (MUST) ----------------
ex:saBiologicalSequenceLocationSubclass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:BiologicalSequenceLocation rdfs:subClassOf gmeow:Location . }""" ;
    gmeow:saRationale "gmeow:BiologicalSequenceLocation MUST be rdfs:subClassOf gmeow:Location. Mirrors test_biological_sequence_location_subclass_of_location." .

# --- 93. SequenceFeatureType subclasses logic:QualityValue + seeds (MUST) -----
ex:saSequenceFeatureTypeGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SequenceFeatureType      rdfs:subClassOf logic:QualityValue .
    gmeow:sequenceFeatureTypeGene  a gmeow:SequenceFeatureType .
    gmeow:sequenceFeatureTypeExon  a gmeow:SequenceFeatureType .
    gmeow:sequenceFeatureTypeIntron a gmeow:SequenceFeatureType .
    gmeow:sequenceFeatureTypeCDS   a gmeow:SequenceFeatureType .
    gmeow:sequenceFeatureTypeSNP   a gmeow:SequenceFeatureType .
    gmeow:sequenceFeatureTypeChromosome a gmeow:SequenceFeatureType .
}""" ;
    gmeow:saRationale "gmeow:SequenceFeatureType MUST be a subclass of logic:QualityValue; six seed individuals MUST exist. Mirrors test_sequence_feature_type_is_value_not_subclass." .

# --- 94. Rejected sequence subclasses do NOT exist (MUST-NOT) -----------------
ex:saRejectedSequenceSubclassesGone a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned { gmeow:Gene gmeow:Exon gmeow:Intron gmeow:CDS gmeow:SNP }
    ?banned a owl:Class .
}""" ;
    gmeow:saRationale "gmeow:Gene, Exon, Intron, CDS, SNP MUST NOT exist as owl:Class -- permanently refactored to SequenceFeatureType value individuals. Mirrors test_sequence_feature_type_is_value_not_subclass (rejected part)." .

# --- 95. StrandOrientation subclasses logic:QualityValue + seeds (MUST) -------
ex:saStrandOrientationGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:StrandOrientation rdfs:subClassOf logic:QualityValue .
    gmeow:strandForward     a gmeow:StrandOrientation .
    gmeow:strandReverse     a gmeow:StrandOrientation .
    gmeow:strandBoth        a gmeow:StrandOrientation .
}""" ;
    gmeow:saRationale "gmeow:StrandOrientation MUST be a subclass of logic:QualityValue; three seed individuals MUST exist. Mirrors test_strand_orientation_values." .

# --- 96. SequenceCoordinates core properties (MUST) ---------------------------
ex:saSequenceCoordinatesProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:sequenceStart a owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:SequenceCoordinates ;
        rdfs:range  xsd:positiveInteger .
    gmeow:sequenceEnd   a owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:SequenceCoordinates ;
        rdfs:range  xsd:positiveInteger .
    gmeow:sequenceStrand a owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:SequenceCoordinates ;
        rdfs:range  gmeow:StrandOrientation .
    gmeow:inReferenceAssembly a owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:SequenceCoordinates ;
        rdfs:range  gmeow:ReferenceFrame ;
        rdfs:subPropertyOf gmeow:hasReferenceFrame .
}""" ;
    gmeow:saRationale "Core SequenceCoordinates properties MUST have the correct types, functional-property status, domain/range. Mirrors test_sequence_coordinates_properties (core part)." .

# --- 97. hasSequenceCoordinates and sequenceFeatureType shapes (MUST + MUST-NOT) --
ex:saSequenceFeaturePropertyShapes a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasSequenceCoordinates a owl:ObjectProperty ;
        rdfs:domain gmeow:SequenceFeature ;
        rdfs:range  gmeow:SequenceCoordinates .
    gmeow:sequenceFeatureType a owl:ObjectProperty ;
        rdfs:domain gmeow:SequenceFeature ;
        rdfs:range  gmeow:SequenceFeatureType .
    gmeow:hasSequenceFeature a owl:ObjectProperty ;
        rdfs:domain gmeow:BiologicalSequenceLocation ;
        rdfs:range  gmeow:SequenceFeature .
}""" ;
    gmeow:saRationale "hasSequenceCoordinates, sequenceFeatureType, and hasSequenceFeature MUST have correct domain/range. Mirrors test_sequence_coordinates_properties (feature-property part)." .

ex:saHasSequenceCoordinatesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasSequenceCoordinates a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:hasSequenceCoordinates MUST NOT be owl:FunctionalProperty -- co-equal coordinate claims coexist (Principle 9). Mirrors test_sequence_coordinates_properties (non-functional part)." .

ex:saSequenceFeatureTypeNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:sequenceFeatureType a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:sequenceFeatureType MUST NOT be owl:FunctionalProperty -- co-equal feature-type classifications coexist (Principle 9). Mirrors test_sequence_coordinates_properties (non-functional sequenceFeatureType part)." .

# --- 98. SequenceFeature exists as owl:Class (MUST) ---------------------------
ex:saSequenceFeatureExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SequenceFeature a owl:Class .
    gmeow:hasSequenceCoordinates rdfs:domain gmeow:SequenceFeature .
    gmeow:sequenceFeatureType    rdfs:domain gmeow:SequenceFeature .
}""" ;
    gmeow:saRationale "gmeow:SequenceFeature MUST be an owl:Class with hasSequenceCoordinates and sequenceFeatureType both bearing its domain. Mirrors test_sequence_feature_has_coordinates_and_type." .

# --- 99. GRCh38 reference frame seeded with biological realm (MUST) -----------
ex:saGRCh38ReferenceFrameSeeded a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:referenceFrameGRCh38 a gmeow:ReferenceFrame ;
        gmeow:frameRealm       gmeow:frameRealmBiological ;
        gmeow:frameKind        gmeow:frameKindLinearSequence ;
        gmeow:hasAxis          gmeow:axisSequencePosition ;
        gmeow:dimensionCount   "1"^^xsd:nonNegativeInteger ;
        gmeow:determinacyModel gmeow:determinacyCrisp ;
        gmeow:hasMetricKind    gmeow:metricPositionalDistance .
}""" ;
    gmeow:saRationale "GRCh38 reference frame MUST be seeded with biological realm, linear-sequence kind, 1D, crisp, positionalDistance metric. Mirrors test_grch38_reference_frame_seeded." .

# --- 100. frameRealmBiological, frameKindLinearSequence, axisSequencePosition (MUST) --
ex:saFrameRealmBiologicalSeeded a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:frameRealmBiological    a gmeow:FrameRealm .
    gmeow:frameKindLinearSequence a gmeow:FrameKind .
    gmeow:axisSequencePosition    a gmeow:Axis .
}""" ;
    gmeow:saRationale "Biological realm vocabulary seeds MUST exist. Mirrors test_frame_realm_biological_seeded." .

# --- 101. Geocode is a logic:Kind, subclass of Entity (MUST) ------------------
ex:saGeocodeIsKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Geocode a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:Geocode MUST be an owl:Class typed logic:Kind and a subclass of gmeow:Entity. Mirrors test_geocode_class_grounding." .

# --- 102. Geocode object properties (MUST) ------------------------------------
ex:saGeocodeObjectProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasGeocode  a owl:ObjectProperty ;
        rdfs:domain gmeow:Place ; rdfs:range gmeow:Geocode .
    gmeow:geocodeFrame a owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:Geocode ; rdfs:range gmeow:ReferenceFrame ;
        rdfs:subPropertyOf gmeow:hasReferenceFrame .
}""" ;
    gmeow:saRationale "gmeow:hasGeocode and geocodeFrame MUST be correctly shaped. Mirrors test_geocode_properties (object-property part)." .

# --- 103. Geocode datatype properties are all functional on Geocode (MUST) ----
ex:saGeocodeDatatypeProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:geocodeValue a owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:Geocode .
    gmeow:plusCode     a owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:Geocode ; rdfs:range xsd:string .
    gmeow:what3words   a owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:Geocode ; rdfs:range xsd:string .
    gmeow:geohash      a owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:Geocode ; rdfs:range xsd:string .
    gmeow:mgrs         a owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:Geocode ; rdfs:range xsd:string .
    gmeow:unLocode     a owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:Geocode ; rdfs:range xsd:string .
    gmeow:mileMarker   a owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:Geocode ; rdfs:range xsd:string .
}""" ;
    gmeow:saRationale "All seven Geocode datatype properties MUST be functional DatatypeProperties on gmeow:Geocode with xsd:string range (except geocodeValue which is range-open). Mirrors test_geocode_properties (datatype part)." .

# --- 104. Geocode reference frames declared (MUST) ----------------------------
ex:saGeocodeFramesDeclared a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:referenceFramePlusCode    a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial ;
        gmeow:determinacyModel gmeow:determinacyCrisp .
    gmeow:referenceFrameWhat3Words  a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial ;
        gmeow:determinacyModel gmeow:determinacyCrisp .
    gmeow:referenceFrameGeohash     a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial ;
        gmeow:determinacyModel gmeow:determinacyCrisp .
    gmeow:referenceFrameMGRS        a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial ;
        gmeow:determinacyModel gmeow:determinacyCrisp .
    gmeow:referenceFrameUNLocode    a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial ;
        gmeow:determinacyModel gmeow:determinacyCrisp .
    gmeow:referenceFrameMileMarker  a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial ;
        gmeow:determinacyModel gmeow:determinacyCrisp .
}""" ;
    gmeow:saRationale "The six geocoding reference frames MUST be declared with terrestrial realm and crisp determinacy. Mirrors test_geocode_frames_declared (existence part)." .

# --- 105. referenceFrameMileMarker requiresHost=true; UNLocode metricGraphHops (MUST) --
ex:saGeocodeFrameSpecialProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:referenceFrameMileMarker gmeow:requiresHost "true"^^xsd:boolean .
    gmeow:referenceFrameUNLocode   gmeow:hasMetricKind gmeow:metricGraphHops .
}""" ;
    gmeow:saRationale "MileMarker frame MUST requiresHost=true; UNLocode frame MUST use metricGraphHops. Mirrors test_geocode_frames_declared (special-properties part)." .

# --- 106. SpatialMeasurement subclasses Measurement (MUST) --------------------
ex:saSpatialMeasurementSubclass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:SpatialMeasurement rdfs:subClassOf gmeow:Measurement . }""" ;
    gmeow:saRationale "gmeow:SpatialMeasurement MUST be rdfs:subClassOf gmeow:Measurement. Mirrors test_spatial_measurement_subclass_of_measurement." .

# --- 107. CoordinateObservation subclasses SpatialMeasurement (MUST) ----------
ex:saCoordinateObservationSubclass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:CoordinateObservation rdfs:subClassOf gmeow:SpatialMeasurement . }""" ;
    gmeow:saRationale "gmeow:CoordinateObservation MUST be rdfs:subClassOf gmeow:SpatialMeasurement. Mirrors test_coordinate_observation_subclass_of_spatial_measurement." .

# --- 108. hasCoordinateObservation domain/range/non-functional (MUST) ---------
ex:saHasCoordinateObservationShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasCoordinateObservation a owl:ObjectProperty ;
        rdfs:domain gmeow:Place ;
        rdfs:range  gmeow:CoordinateObservation .
}""" ;
    gmeow:saRationale "gmeow:hasCoordinateObservation MUST be an owl:ObjectProperty with domain Place and range CoordinateObservation. Mirrors test_has_coordinate_observation_domain_range (positive part)." .

ex:saHasCoordinateObservationNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasCoordinateObservation a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:hasCoordinateObservation MUST NOT be owl:FunctionalProperty -- co-equal observations coexist (Principle 9). Mirrors test_has_coordinate_observation_domain_range (non-functional part)." .

# --- 109. coordinateObservationOf subproperty of spatialMeasurementOf (MUST) --
ex:saCoordinateObservationOfSubproperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:coordinateObservationOf rdfs:subPropertyOf gmeow:spatialMeasurementOf ;
        rdfs:domain gmeow:CoordinateObservation ;
        rdfs:range  gmeow:Place .
}""" ;
    gmeow:saRationale "gmeow:coordinateObservationOf MUST be rdfs:subPropertyOf spatialMeasurementOf with domain/range. Mirrors test_coordinate_observation_of_subproperty." .

# --- 110. coordinateResult subproperty of observationResult (MUST) ------------
ex:saCoordinateResultSubproperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:coordinateResult rdfs:subPropertyOf gmeow:observationResult ;
        rdfs:domain gmeow:CoordinateObservation ;
        rdfs:range  gmeow:GeoCoordinates .
}""" ;
    gmeow:saRationale "gmeow:coordinateResult MUST be rdfs:subPropertyOf observationResult with domain/range. Mirrors test_coordinate_result_subproperty." .

# --- 111. geometryResult subproperty of observationResult (MUST) --------------
ex:saGeometryResultSubproperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:geometryResult rdfs:subPropertyOf gmeow:observationResult ;
        rdfs:domain gmeow:CoordinateObservation ;
        rdfs:range  gmeow:Geometry .
}""" ;
    gmeow:saRationale "gmeow:geometryResult MUST be rdfs:subPropertyOf observationResult with domain/range. Mirrors test_geometry_result_subproperty." .

# --- 112. Spatial method seed individuals exist (MUST) ------------------------
ex:saSpatialMethodSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:methodGPS             a gmeow:ObservationMethod .
    gmeow:methodLiDAR           a gmeow:ObservationMethod .
    gmeow:methodTotalStation    a gmeow:ObservationMethod .
    gmeow:methodPhotogrammetry  a gmeow:ObservationMethod .
    gmeow:methodGNSSRTK         a gmeow:ObservationMethod .
}""" ;
    gmeow:saRationale "The five spatial ObservationMethod seed individuals MUST exist. Mirrors test_spatial_method_seeds_exist." .

# --- 113. LandTenure subclasses TimeScopedRelation (MUST) ---------------------
ex:saLandTenureGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LandTenure rdfs:subClassOf gmeow:TimeScopedRelation .
    gmeow:tenurePlace  rdfs:domain gmeow:LandTenure ; rdfs:range gmeow:Place ;
        a owl:FunctionalProperty .
    gmeow:tenureParty  rdfs:domain gmeow:LandTenure ; rdfs:range gmeow:Agent ;
        a owl:FunctionalProperty .
    gmeow:tenureRights rdfs:domain gmeow:LandTenure ;
        rdfs:range gmeow:RightsStatement .
    gmeow:tenureType   rdfs:domain gmeow:LandTenure ;
        rdfs:range gmeow:LandTenureType .
    gmeow:tenureDeterminacy rdfs:subPropertyOf gmeow:hasDeterminacy ;
        rdfs:domain gmeow:LandTenure ; rdfs:range gmeow:Determinacy .
}""" ;
    gmeow:saRationale "gmeow:LandTenure MUST be rdfs:subClassOf TimeScopedRelation; tenurePlace/tenureParty MUST be functional; full property grounding required. Mirrors test_land_tenure_grounding." .

# --- 114. LandTenureType subclasses logic:QualityValue + seeds (MUST) ---------
ex:saLandTenureTypeGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LandTenureType rdfs:subClassOf logic:QualityValue .
    gmeow:tenureTypeOwnership  a gmeow:LandTenureType .
    gmeow:tenureTypeLeasehold  a gmeow:LandTenureType .
    gmeow:tenureTypeEasement   a gmeow:LandTenureType .
    gmeow:tenureTypeMortgage   a gmeow:LandTenureType .
    gmeow:tenureTypeUsufruct   a gmeow:LandTenureType .
    gmeow:tenureTypeFreehold   a gmeow:LandTenureType .
    gmeow:tenureTypeCrownLease a gmeow:LandTenureType .
}""" ;
    gmeow:saRationale "gmeow:LandTenureType MUST be a subclass of logic:QualityValue; seven seed individuals MUST exist. Mirrors test_land_tenure_type_is_value_vocabulary (positive part)." .

# --- 115. Rejected tenure subclasses do NOT exist (MUST-NOT) ------------------
ex:saRejectedTenureSubclassesGone a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned {
        gmeow:Ownership gmeow:Leasehold gmeow:Easement gmeow:Mortgage
    }
    ?banned a owl:Class .
}""" ;
    gmeow:saRationale "gmeow:Ownership, Leasehold, Easement, Mortgage MUST NOT exist as owl:Class. Mirrors test_land_tenure_type_is_value_vocabulary (rejected part)." .

# --- 116. CadastralReference subclasses InformationObject + properties (MUST) -
ex:saCadastralReferenceGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:CadastralReference rdfs:subClassOf gmeow:InformationObject .
    gmeow:hasCadastralReference rdfs:domain gmeow:Place ;
        rdfs:range gmeow:CadastralReference .
    gmeow:referenceValue a owl:DatatypeProperty ;
        rdfs:domain gmeow:CadastralReference .
    gmeow:referenceType  rdfs:domain gmeow:CadastralReference ;
        rdfs:range gmeow:CadastralReferenceType .
    gmeow:referenceAuthority rdfs:domain gmeow:CadastralReference ;
        rdfs:range gmeow:Agent ;
        a owl:FunctionalProperty .
    gmeow:referenceJurisdiction rdfs:domain gmeow:CadastralReference ;
        rdfs:range gmeow:Place ;
        a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:CadastralReference MUST be rdfs:subClassOf InformationObject; all core properties MUST be grounded. Mirrors test_cadastral_reference_grounding." .

# --- 117. CadastralReferenceType subclasses logic:QualityValue + seeds (MUST) -
ex:saCadastralReferenceTypeGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:CadastralReferenceType rdfs:subClassOf logic:QualityValue .
    gmeow:referenceTypeParcelId  a gmeow:CadastralReferenceType .
    gmeow:referenceTypeFolio     a gmeow:CadastralReferenceType .
    gmeow:referenceTypeTitle     a gmeow:CadastralReferenceType .
    gmeow:referenceTypeLot       a gmeow:CadastralReferenceType .
    gmeow:referenceTypeSurveyPlan a gmeow:CadastralReferenceType .
}""" ;
    gmeow:saRationale "gmeow:CadastralReferenceType MUST be a subclass of logic:QualityValue; five seed individuals MUST exist. Mirrors test_cadastral_reference_type_is_value_vocabulary (positive part)." .

# --- 118. Rejected cadastral subclasses do NOT exist (MUST-NOT) ---------------
ex:saRejectedCadastralSubclassesGone a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned { gmeow:FolioNumber gmeow:TitleNumber gmeow:LotNumber }
    ?banned a owl:Class .
}""" ;
    gmeow:saRationale "gmeow:FolioNumber, TitleNumber, LotNumber MUST NOT exist as owl:Class. Mirrors test_cadastral_reference_type_is_value_vocabulary (rejected part)." .

# --- postal reference frame: declared with topological kind + 7 axes (MUST) ---
ex:saPostalAddressFrameDeclared a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:referenceFramePostalAddress a gmeow:ReferenceFrame ;
        gmeow:frameKind gmeow:frameKindTopological ;
        gmeow:dimensionCount "7"^^xsd:nonNegativeInteger ;
        gmeow:hasAxis gmeow:axisStreetAddress , gmeow:axisExtendedAddress ,
            gmeow:axisPostOfficeBox , gmeow:axisAddressLocality , gmeow:axisAddressRegion ,
            gmeow:axisPostalCode , gmeow:axisCountryCode .
}""" ;
    gmeow:saRationale "gmeow:referenceFramePostalAddress MUST be a gmeow:ReferenceFrame of frameKindTopological with dimensionCount 7 and exactly the seven postal hasAxis edges (street/extended/poBox/locality/region/postalCode/countryCode). The frame individual is places-home (module.ttl). Mirrors test_postal_address_frame." .
