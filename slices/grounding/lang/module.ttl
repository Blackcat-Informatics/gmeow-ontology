    gmeow:gmnDictionaryEntryTerm gmeow:modalForceActual ;
    gmeow:gmnDictionaryEntryAlias "act" ;
    gmeow:gmnCodepoints "U+0061 U+0063 U+0074" ;
    gmeow:gmnGlyphTokenCost gmeow:gmnTokenCostOne .

