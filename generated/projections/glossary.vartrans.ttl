<http://example.org/lang/glossary-vartrans/form-tgt/53cf2c7f97c0185b>
    a ontolex:Form ;
    ontolex:writtenRep "gmeow:modalForcePossible 的版本 3 别名绑定：`poss`，与版本 2 保持不变。"@zh .

<http://example.org/lang/glossary-vartrans/form-tgt/53cfff11ff4ceff5>
