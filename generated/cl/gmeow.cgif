("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateEndurantPerdurantDisjoint" (lit "logic:Endurant owl:disjointWith logic:Perdurant — the continuant/occurrent divide at the top of the foundation"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateEntitySortalCovering" (lit "covering: every gmeow:Entity is one of {Agent, InformationObject, PhysicalObject, SocialObject}"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateEventSituationDisjoint" (lit "logic:Event owl:disjointWith logic:Situation — the occurrence/configuration distinction within the occurrent branch"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateFunctionalComplexKindDisjoint" (lit "pairwise owl:disjointWith over the three mereological individuation kinds logic:Collection, logic:FunctionalComplex and logic:Quantity"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateObjectIndividuationCovering" (lit "covering: every logic:Object is one of {Collection, Quantity, FunctionalComplex}"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateProperPartOfAsymmetric" (lit "logic:properPartOf asymmetry over the endurant strict-parthood spine"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateRelatorMediation" (lit "every class subClassOf logic:Relator; a concrete relator (one with no logic: subclass) must reach at least two distinct entities — two distinct logic:mediates roles, or one non-functional role — or fire logic:violation logic:RelComp"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateSocialInformationOverlap" (lit "the deliberately-preserved gmeow:SocialObject ∩ gmeow:InformationObject overlap: an explicit, reviewed non-assertion of disjointness"))
("https://blackcatinformatics.ca/logic/candidateScope" "https://blackcatinformatics.ca/logic/candidateTopSortalDisjoint" (lit "pairwise owl:disjointWith among the four top sortals gmeow:Agent, gmeow:InformationObject, gmeow:PhysicalObject and gmeow:SocialObject, except the preserved gmeow:SocialObject ∩ gmeow:InformationObject overlap"))
