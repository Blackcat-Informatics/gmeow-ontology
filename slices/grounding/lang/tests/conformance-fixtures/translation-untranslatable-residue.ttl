# Untranslatability held as data: the Japanese aesthetic concept 間 (ma) has no adequate
# English single-word target — any English form is a forced approximation. The
# lang:TranslationUnit still records the crossing, but honestly: its carried
# logic:Correspondence is logic:Unsupported (the legalization floor — the crossing is
# present and flagged, never fabricated) with logic:mnemomorphic false (no source witness
# recovers the concept from the target), and the unit is marked lang:translationGap. The
# residue — the untranslated source concept — is disclosed as the source lang:SurfaceForm
# that remains, not silently dropped. Untranslatability is a queryable fact, not a failure.
# Conforms to lang:TranslationUnitShape, lang:UnmarkedSurfaceTranslationShape (both sides
# are lang:UnanalyzedProse and the judgment is the weakest, logic:Unsupported), and
# lang:TranslationAttributionShape.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:japanese a lang:SignSystem .
ex:latin a lang:Script .
ex:japaneseScript a lang:Script .

# The source concept 間 (ma) and its forced English approximation.
ex:jaMa a lang:UnanalyzedProse ; lang:inSignSystem ex:japanese ;
    lang:surfaceText "間" ; lang:inScript ex:japaneseScript ;
    lang:unicodeNormalization "NFC" ; lang:collationLocale "ja" ;
    lang:analysisLevel lang:rawLevel .
ex:enMa a lang:UnanalyzedProse ; lang:inSignSystem ex:english ;
    lang:surfaceText "negative space / pregnant interval" ; lang:inScript ex:latin ;
    lang:unicodeNormalization "NFC" ; lang:collationLocale "en" ;
    lang:analysisLevel lang:rawLevel .

ex:corrMa a logic:Correspondence ;
    logic:preservationKind logic:Unsupported ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:BridgeView ;
    logic:hasDeterminacy logic:Vague ;
    logic:mnemomorphic false .

ex:unitMa a lang:TranslationUnit ;
    lang:translationSource ex:jaMa ;
    lang:translationTarget ex:enMa ;
    lang:translationMethod lang:methodHuman ;
    lang:translationCorrespondence ex:corrMa ;
    lang:translationGap ex:corrMa .
