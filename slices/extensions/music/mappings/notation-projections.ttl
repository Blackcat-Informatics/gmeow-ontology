# --------------------------------------------------------------------------- #
# FnO CATALOG — notation projection functions
# --------------------------------------------------------------------------- #

gmeow:fnSpellPitch a gmeow:ProjectionFunction ;
    rdfs:label "spell pitch value in a notation system"@x-gmeow-english ;
    skos:definition "Renders a frame-relative PitchValue as a note name / symbol in a given PitchSpellingSystem (e.g. C♯4, Sa, +7). Enharmonic peers are co-equal outputs (Principle 9)."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasTuningFrame, gmeow:spellingSystem ;
    gmeow:fnOutput gmeow:projectedPitchName ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnParsePitchName a gmeow:ProjectionFunction ;
    rdfs:label "parse pitch name to frame-relative value"@x-gmeow-english ;
    skos:definition "Parses a spelled pitch name in a given PitchSpellingSystem and TuningSystem into a frame-relative PitchValue."@x-gmeow-english ;
    gmeow:fnInput gmeow:spelledName, gmeow:spellingSystem ;
    gmeow:fnOutput gmeow:projectedParsedPitch ; gmeow:fnOutputType gmeow:PitchValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnApplyTransformation a gmeow:ProjectionFunction ;
    rdfs:label "apply segment transformation"@x-gmeow-english ;
    skos:definition "Applies a SegmentTransformation (transposition, augmentation, retrograde, etc.) to a MusicalSegment, returning a derived segment."@x-gmeow-english ;
    gmeow:fnInput gmeow:transformationSource, gmeow:transformationType, gmeow:transformationParameter ;
    gmeow:fnOutput gmeow:projectedTransformedSegment ; gmeow:fnOutputType gmeow:MusicalSegment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToCMN a gmeow:ProjectionFunction ;
    rdfs:label "project expression to CMN staff notation"@x-gmeow-english ;
    skos:definition "Renders frame-relative musical content to Common Music Notation staff notation. Lossy: quantizes pitch to 12-EDO, time to rational grid, drops microtiming/timbre/tuning-frame/trajectory."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedCMN ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToMensural a gmeow:ProjectionFunction ;
    rdfs:label "project expression to mensural notation"@x-gmeow-english ;
    skos:definition "Renders frame-relative musical content to mensural notation with proportions and coloration. A CMN transcription of ars subtilior is a lossy, standpointed projection."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedMensural ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToTablature a gmeow:ProjectionFunction ;
    rdfs:label "project expression to tablature"@x-gmeow-english ;
    skos:definition "Renders frame-relative pitch/duration content to instrument-specific finger/fret/string tablature. Lossy: abstracts pitch to instrument position."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression, gmeow:configurationInstrumentType ;
    gmeow:fnOutput gmeow:projectedTablature ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToGraphic a gmeow:ProjectionFunction ;
    rdfs:label "project expression to graphic notation"@x-gmeow-english ;
    skos:definition "Renders frame-relative musical content to a graphic score image or instruction set. Near-total loss in the symbolic direction; the visual artifact is canonical in the image direction."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedGraphic ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToSargam a gmeow:ProjectionFunction ;
    rdfs:label "project expression to Sargam"@x-gmeow-english ;
    skos:definition "Renders frame-relative pitch content to Sargam solfege notation."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedSargam ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToJianpu a gmeow:ProjectionFunction ;
    rdfs:label "project expression to Jianpu"@x-gmeow-english ;
    skos:definition "Renders frame-relative pitch content to Jianpu numbered notation."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedJianpu ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToKlavarskribo a gmeow:ProjectionFunction ;
    rdfs:label "project expression to Klavarskribo"@x-gmeow-english ;
    skos:definition "Renders frame-relative pitch/duration content to Klavarskribo vertical keyboard notation."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedKlavarskribo ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToJohnstonJI a gmeow:ProjectionFunction ;
    rdfs:label "project expression to Johnston JI notation"@x-gmeow-english ;
    skos:definition "Renders frame-relative just-intonation pitch content to Ben Johnston staff notation."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedJohnstonJI ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToSagittal a gmeow:ProjectionFunction ;
    rdfs:label "project expression to Sagittal notation"@x-gmeow-english ;
    skos:definition "Renders frame-relative microtonal pitch content to Sagittal accidental notation."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedSagittal ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToHEJI a gmeow:ProjectionFunction ;
    rdfs:label "project expression to HEJI"@x-gmeow-english ;
    skos:definition "Renders frame-relative just-intonation pitch content to Helmholtz-Ellis JI Pitch Notation."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedHEJI ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToByzantineNeume a gmeow:ProjectionFunction ;
    rdfs:label "project expression to Byzantine neume notation"@x-gmeow-english ;
    skos:definition "Renders frame-relative melodic content to Byzantine neumatic notation."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedByzantineNeume ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToMIDI a gmeow:ProjectionFunction ;
    rdfs:label "project expression to MIDI"@x-gmeow-english ;
    skos:definition "Renders frame-relative musical content to MIDI bytes. Lossy: no notation semantics, enharmonics, rests, tuplet structure, or work identity."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedMIDI ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToMusicXML a gmeow:ProjectionFunction ;
    rdfs:label "project expression to MusicXML"@x-gmeow-english ;
    skos:definition "Renders frame-relative musical content to MusicXML 4.0. Lossy: microtones via bare decimal alter, polymeter via hacks, no mobile form."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedMusicXML ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToMEI a gmeow:ProjectionFunction ;
    rdfs:label "project expression to MEI"@x-gmeow-english ;
    skos:definition "Renders frame-relative musical content to MEI. Lossy: att.tuning limited to named temperaments, JI lattices → cents approximations, mobile form via editorial markup only."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedMEI ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToABC a gmeow:ProjectionFunction ;
    rdfs:label "project expression to ABC notation"@x-gmeow-english ;
    skos:definition "Renders frame-relative musical content to ABC notation. Lossy: monophonic bias, nonstandard microtone extensions."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedABC ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToKern a gmeow:ProjectionFunction ;
    rdfs:label "project expression to Humdrum **kern"@x-gmeow-english ;
    skos:definition "Renders frame-relative musical content to Humdrum **kern. Lossy: 12-TET letter pitch, no tuning-frame declaration."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedKern ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToLilyPond a gmeow:ProjectionFunction ;
    rdfs:label "project expression to LilyPond"@x-gmeow-english ;
    skos:definition "Renders frame-relative musical content to LilyPond source. Program-not-data: layout macros are lost when read back as data."@x-gmeow-english ;
    gmeow:fnInput gmeow:projectableExpression ;
    gmeow:fnOutput gmeow:projectedLilyPond ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

gmeow:fnProjectToScl a gmeow:ProjectionFunction ;
    rdfs:label "project tuning to Scala .scl"@x-gmeow-english ;
    skos:definition "Renders a TuningSystem to a Scala .scl pitch-class list. Lossy: comma/prime-limit theory and keyboard mapping context."@x-gmeow-english ;
    gmeow:fnInput gmeow:hasTuningFrame ;
    gmeow:fnOutput gmeow:projectedScl ; gmeow:fnOutputType rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> .

# --------------------------------------------------------------------------- #
# TERM EQUIVALENCES — notation systems and encoding formats
# --------------------------------------------------------------------------- #

gmeow:eqMuNot001 a gmeow:TermEquivalence ;
    rdfs:label "CMN staff notation ↔ Wikidata Q233861"@x-gmeow-english ;
    skos:definition "Maps the GMEOW CMN staff notation individual to Wikidata 'musical notation' (Q233861)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    gmeow:alignSubject gmeow:notationCMNStaff ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q233861 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Wikidata 'musical notation' (Q233861) — broader than CMN staff specifically." ;
    gmeow:sssomFile "gmeow-music.sssom.tsv" .

