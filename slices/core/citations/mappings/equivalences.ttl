@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# Citation, credit, and attribution alignments.
# Compiled to mappings/gmeow-citations.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetCitations a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/citations" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Citation and credit alignments to CiTO, Web Annotation, and PROV-O. GMEOW rebuilds the constructs natively and bridges by reference (Principle 5)." .

# --------------------------------------------------------------------------- #
# CiTO — Citation Typing Ontology (SPAR)
# --------------------------------------------------------------------------- #

gmeow:cites owl:equivalentProperty cito:cites {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "CiTO cites — the core citation property."
|} .

gmeow:intentCitesAsDataSource skos:closeMatch cito:citesAsDataSource {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "CiTO citesAsDataSource is a sub-property of cito:cites; GMEOW encodes the intent as a CitationIntent value."
|} .

gmeow:intentUsesMethodIn skos:closeMatch cito:usesMethodIn {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "CiTO usesMethodIn intent."
|} .

gmeow:intentExtends skos:closeMatch cito:extends {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "CiTO extends intent."
|} .

gmeow:intentIsInspiredBy skos:closeMatch cito:isInspiredBy {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "CiTO isInspiredBy intent."
|} .

gmeow:intentConformsTo skos:closeMatch cito:obtainsSupportFrom {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "CiTO obtainsSupportFrom approximates conforming to a standard; not an exact match."
|} .

gmeow:intentDerivedFrom skos:closeMatch cito:isDerivedFrom {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "CiTO isDerivedFrom intent."
|} .

gmeow:intentDocuments skos:closeMatch cito:documents {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "CiTO documents intent."
|} .

gmeow:intentSupports skos:closeMatch cito:providesSupportFor {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "CiTO providesSupportFor approximates support intent."
|} .

gmeow:intentDisagreesWith skos:closeMatch cito:disagreesWith {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "CiTO disagreesWith intent."
|} .

# --------------------------------------------------------------------------- #
# Web Annotation — Selector / text position model
# --------------------------------------------------------------------------- #

gmeow:Selector skos:closeMatch oa:Selector {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "Web Annotation oa:Selector is the closest peer to GMEOW Selector."
|} .

# --------------------------------------------------------------------------- #
# PROV-O — attribution
# --------------------------------------------------------------------------- #

gmeow:Contribution skos:closeMatch prov:Attribution {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "PROV-O Attribution is an influence/association; GMEOW Contribution is a relator. Lossy but close."
|} .

gmeow:contributor skos:closeMatch prov:agent {|
    gmeow:sssomFile "gmeow-citations.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "PROV-O agent within an Attribution; GMEOW contributor is the relator player. Lossy."
|} .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:references skos:closeMatch dcterms:references {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "DCTerms references — a related resource that is referenced by the described resource. GMEOW references is general (formerly message-scoped, now Entity-scoped)."
|} .

gmeow:isReferencedBy skos:closeMatch dcterms:isReferencedBy {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "DCTerms isReferencedBy — a related resource that references the described resource"
|} .
