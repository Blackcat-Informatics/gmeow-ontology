# SPDX-License-Identifier: CC-BY-4.0
#
# Declarative structural assertions for the finance slice -- the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT
# invariants formerly hand-written in tests/test_finance.py. Each
# assertion runs as a SPARQL ASK over the finance module graph
# (gmeow:scopeModule) under the native Rust slicetest harness
# (crates/slicetest).
#
# Finance is migrated: class stereotypes are logic:
# (logic:Kind, logic:SubKind, logic:Event, logic:AbstractIndividualType,
# logic:QualityValue, logic:Relator), not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_monetary_amount_is_entity -- gmeow:MonetaryAmount is defined in
#     a cross-slice module, not the finance module; a scopeModule cell
#     would silently miss it.
#   test_monetary_value_is_functional -- gmeow:monetaryValue is a
#     cross-slice property (MonetaryAmount layer); same reason.
#   test_currency_is_functional -- gmeow:currency is a cross-slice
#     property; same reason.
#   test_currency_is_subproperty_of_has_reference_frame -- gmeow:currency
#     is cross-slice; same reason.
#   test_currency_frames_have_realm_currency -- gmeow:referenceFrameUSD
#     etc. are reference-frame individuals defined outside finance; cross-
#     slice dynamic check.
#   test_no_transaction_subclass_explosion -- whole-graph sweep asserting
#     absence of PaymentTransaction / InvoiceTransaction /
#     TransferTransaction as owl:Class; dynamic, not module-scoped.
#   test_finance_fixture_conforms -- SHACL validation call; ExampleConformance.
#   test_double_entry_fixture_conforms -- SHACL validation call;
#     ExampleConformance.
#   test_invoice_fixture_conforms -- SHACL validation call; ExampleConformance.
#   test_order_fixture_conforms -- SHACL validation call; ExampleConformance.
#   test_holding_fixture_conforms -- SHACL validation call; ExampleConformance.
#   test_crypto_fixture_conforms -- SHACL validation call; ExampleConformance.
#   test_currency_vocab_is_open_values_not_subclasses (negative half) --
#     absence of BankAccount / CreditAccount / InvestmentAccount /
#     WalletAccount as owl:Class; dynamic whole-graph sweep.
#   test_transaction_type_vocab_is_open_values (negative half) --
#     absence of PaymentTransaction / InvoiceTransaction /
#     TransferTransaction / DebitPosting / CreditPosting as owl:Class;
#     dynamic whole-graph sweep.
#   test_asset_type_vocab_is_open_values (negative half) -- absence of
#     StockAsset / BondAsset / CryptoAsset as owl:Class; dynamic sweep.
#   test_transaction_uses_participation_not_subproperty (negative half) --
#     absence of hasPayer / hasPayee / hasIntermediary as
#     owl:ObjectProperty; dynamic whole-graph sweep.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/finance/tests/> .

# --- 1. FinancialAccount is a logic:Kind subclass of InformationObject (MUST) --
ex:saFinancialAccountIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:FinancialAccount a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:FinancialAccount MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject -- a financial account is an information construct (IBAN, account number, balance record), not a physical object." .

# --- 2. Four FinancialAccountType seed individuals exist (MUST) ---------------
ex:saFinancialAccountTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:accountTypeBank       a gmeow:FinancialAccountType .
    gmeow:accountTypeCredit     a gmeow:FinancialAccountType .
    gmeow:accountTypeInvestment a gmeow:FinancialAccountType .
    gmeow:accountTypeWallet     a gmeow:FinancialAccountType .
}""" ;
    gmeow:saRationale "The four mandatory FinancialAccountType seed individuals (bank, credit, investment, wallet) MUST exist as open-vocabulary values, not as subclasses of FinancialAccount (Principle 9, no subclass explosion)." .

# --- 3. accountCurrency is an owl:ObjectProperty (MUST) -----------------------
ex:saAccountCurrencyIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:accountCurrency a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:accountCurrency MUST be an owl:ObjectProperty." .

# --- 4. accountCurrency is NOT functional (MUST-NOT) --------------------------
ex:saAccountCurrencyNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:accountCurrency ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:accountCurrency MUST NOT be owl:FunctionalProperty -- a single account may hold balances in several currencies; the functional constraint moves to Posting/Holding relators." .

# --- 5. FinancialTransaction is a logic:Event subclass of Event (MUST) -----
ex:saFinancialTransactionIsEvent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:FinancialTransaction a owl:Class , logic:Event ;
        rdfs:subClassOf gmeow:Event .
}""" ;
    gmeow:saRationale "gmeow:FinancialTransaction MUST be an owl:Class typed logic:Event and a subclass of gmeow:Event -- money movement reuses the Event/Participation substrate; payer, payee, and intermediary are ParticipantRole values on Participation relators." .

# --- 6. JournalEntry is a logic:Event subclass of Event (MUST) -------------
ex:saJournalEntryIsEvent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:JournalEntry a owl:Class , logic:Event ;
        rdfs:subClassOf gmeow:Event .
}""" ;
    gmeow:saRationale "gmeow:JournalEntry MUST be an owl:Class typed logic:Event and a subclass of gmeow:Event -- a balanced double-entry bookkeeping event is a temporal occurrence." .

# --- 7. Posting is a logic:Kind subclass of logic:Relator (MUST) ----------------
ex:saPostingIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Posting a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:Posting MUST be an owl:Class typed logic:Kind and a subclass of logic:Relator -- a posting is the atomic unit of double-entry bookkeeping, reifying the journal-entry x ledger-account x amount x direction tuple." .

# --- 8. LedgerAccount is a logic:Kind subclass of InformationObject (MUST) -----
ex:saLedgerAccountIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:LedgerAccount a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:LedgerAccount MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject -- a book-keeping account is a conceptual information construct, distinct from a bank-level FinancialAccount." .

# --- 9. Seven TransactionType seed individuals exist (MUST) -------------------
ex:saTransactionTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:transactionTypePayment    a gmeow:TransactionType .
    gmeow:transactionTypeTransfer   a gmeow:TransactionType .
    gmeow:transactionTypeDeposit    a gmeow:TransactionType .
    gmeow:transactionTypeWithdrawal a gmeow:TransactionType .
    gmeow:transactionTypeFee        a gmeow:TransactionType .
    gmeow:transactionTypeInterest   a gmeow:TransactionType .
    gmeow:transactionTypeRefund     a gmeow:TransactionType .
}""" ;
    gmeow:saRationale "The seven mandatory TransactionType seed individuals (payment, transfer, deposit, withdrawal, fee, interest, refund) MUST exist as open-vocabulary values, never as FinancialTransaction subclasses (Principle 9)." .

# --- 10. Four TransactionStatus seed individuals exist (MUST) -----------------
ex:saTransactionStatusSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:transactionStatusPending   a gmeow:TransactionStatus .
    gmeow:transactionStatusCompleted a gmeow:TransactionStatus .
    gmeow:transactionStatusReversed  a gmeow:TransactionStatus .
    gmeow:transactionStatusFailed    a gmeow:TransactionStatus .
}""" ;
    gmeow:saRationale "The four mandatory TransactionStatus seed individuals (pending, completed, reversed, failed) MUST exist as open-vocabulary values (Principle 9)." .

# --- 11. Five LedgerAccountType seed individuals exist (MUST) -----------------
ex:saLedgerAccountTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:ledgerAccountTypeAsset     a gmeow:LedgerAccountType .
    gmeow:ledgerAccountTypeLiability a gmeow:LedgerAccountType .
    gmeow:ledgerAccountTypeEquity    a gmeow:LedgerAccountType .
    gmeow:ledgerAccountTypeRevenue   a gmeow:LedgerAccountType .
    gmeow:ledgerAccountTypeExpense   a gmeow:LedgerAccountType .
}""" ;
    gmeow:saRationale "The five mandatory LedgerAccountType seed individuals (asset, liability, equity, revenue, expense) MUST exist as open-vocabulary values, never as LedgerAccount subclasses (Principle 9)." .

# --- 12. Two PostingDirection seed individuals exist (MUST) -------------------
ex:saPostingDirectionSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:postingDirectionDebit  a gmeow:PostingDirection .
    gmeow:postingDirectionCredit a gmeow:PostingDirection .
}""" ;
    gmeow:saRationale "The two PostingDirection seed individuals (debit, credit) MUST exist as open-vocabulary values, never as Posting subclasses (Principle 9)." .

# --- 13. Three ParticipantRole individuals seed transaction roles (MUST) ------
ex:saTransactionRoleSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:rolePayer        a gmeow:ParticipantRole .
    gmeow:rolePayee        a gmeow:ParticipantRole .
    gmeow:roleIntermediary a gmeow:ParticipantRole .
}""" ;
    gmeow:saRationale "gmeow:rolePayer, rolePayee, and roleIntermediary MUST exist as gmeow:ParticipantRole individuals -- transaction participants are reused from the Event/Participation substrate, never as hasPayer/hasPayee subproperties." .

# --- 14. transactionAmount is an ObjectProperty (MUST) -------------------------
ex:saTransactionAmountFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:transactionAmount a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:transactionAmount MUST be an owl:ObjectProperty -- disputed amounts are standpoint-indexed claims on separate statements." .

# --- 15. Four posting properties are ObjectProperties (MUST) ------------------
ex:saPostingPropertiesFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:postingJournalEntry a owl:ObjectProperty .
    gmeow:postingAccount      a owl:ObjectProperty .
    gmeow:postingAmount       a owl:ObjectProperty .
    gmeow:postingDirection    a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:postingJournalEntry, postingAccount, postingAmount, and postingDirection MUST each be owl:ObjectProperty -- the four core roles bind a posting to its journal entry, ledger account, amount, and direction." .

# --- 16. Payment is a subclass of FinancialTransaction (MUST) -----------------
ex:saPaymentIsFinancialTransaction a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:Payment rdfs:subClassOf gmeow:FinancialTransaction . }""" ;
    gmeow:saRationale "gmeow:Payment MUST be a subclass of gmeow:FinancialTransaction -- a payment event is a thin FinancialTransaction specialization distinguished by the paymentMethod facet." .

# --- 17. Invoice is a subclass of Document (MUST) ----------------------------
ex:saInvoiceIsDocument a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:Invoice rdfs:subClassOf gmeow:Document . }""" ;
    gmeow:saRationale "gmeow:Invoice MUST be a subclass of gmeow:Document -- a billing document is reused from the Document substrate; no re-minting." .

# --- 18. Order is a subclass of Agreement (MUST) ------------------------------
ex:saOrderIsAgreement a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:Order rdfs:subClassOf gmeow:Agreement . }""" ;
    gmeow:saRationale "gmeow:Order MUST be a subclass of gmeow:Agreement -- a purchase order is an agreement between buyer and seller; reuses Agreement, no re-minting." .

# --- 19. Five AssetType seed individuals exist (MUST) -------------------------
ex:saAssetTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:assetTypeStock          a gmeow:AssetType .
    gmeow:assetTypeBond           a gmeow:AssetType .
    gmeow:assetTypeCryptocurrency a gmeow:AssetType .
    gmeow:assetTypeRealEstate     a gmeow:AssetType .
    gmeow:assetTypeCommodity      a gmeow:AssetType .
}""" ;
    gmeow:saRationale "The five mandatory AssetType seed individuals (stock, bond, cryptocurrency, real estate, commodity) MUST exist as open-vocabulary values, never as Asset subclasses (Principle 9)." .

# --- 20. Four InvoiceStatus seed individuals exist (MUST) --------------------
ex:saInvoiceStatusSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:invoiceStatusSent      a gmeow:InvoiceStatus .
    gmeow:invoiceStatusPaid      a gmeow:InvoiceStatus .
    gmeow:invoiceStatusOverdue   a gmeow:InvoiceStatus .
    gmeow:invoiceStatusCancelled a gmeow:InvoiceStatus .
}""" ;
    gmeow:saRationale "The four mandatory InvoiceStatus seed individuals (sent, paid, overdue, cancelled) MUST exist as open-vocabulary values, never as Invoice subclasses." .

# --- 21. Four OrderStatus seed individuals exist (MUST) ----------------------
ex:saOrderStatusSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:orderStatusConfirmed a gmeow:OrderStatus .
    gmeow:orderStatusShipped   a gmeow:OrderStatus .
    gmeow:orderStatusDelivered a gmeow:OrderStatus .
    gmeow:orderStatusCancelled a gmeow:OrderStatus .
}""" ;
    gmeow:saRationale "The four mandatory OrderStatus seed individuals (confirmed, shipped, delivered, cancelled) MUST exist as open-vocabulary values, never as Order subclasses." .

# --- 22. Four WalletScheme seed individuals exist (MUST) ----------------------
ex:saWalletSchemeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:walletSchemeBTC a gmeow:WalletScheme .
    gmeow:walletSchemeETH a gmeow:WalletScheme .
    gmeow:walletSchemeSOL a gmeow:WalletScheme .
    gmeow:walletSchemeXMR a gmeow:WalletScheme .
}""" ;
    gmeow:saRationale "The four mandatory WalletScheme seed individuals (BTC, ETH, SOL, XMR) MUST exist as open-vocabulary values, never as CryptoWallet subclasses (Principle 9)." .

# --- 23. Holding is a logic:Kind subclass of logic:Relator (MUST) ---------------
ex:saHoldingIsRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Holding a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:Holding MUST be an owl:Class typed logic:Kind and a subclass of logic:Relator -- a holding reifies the agent x asset x quantity x cost-basis x period tuple; promote from flat accountBalance when provenance matters." .

# --- 24. CryptoWallet is a logic:SubKind subclass of FinancialAccount (MUST) ---
ex:saCryptoWalletIsFinancialAccount a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:CryptoWallet a owl:Class , logic:SubKind ;
        rdfs:subClassOf gmeow:FinancialAccount .
}""" ;
    gmeow:saRationale "gmeow:CryptoWallet MUST be an owl:Class typed logic:SubKind and a subclass of gmeow:FinancialAccount -- a crypto wallet is a financial-existence account with wallet-specific properties (address, scheme, key)." .

# --- 25. walletAddress is a DatatypeProperty (MUST) ---------------------------
ex:saWalletAddressIsDatatype a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:walletAddress a owl:DatatypeProperty . }""" ;
    gmeow:saRationale "gmeow:walletAddress MUST be an owl:DatatypeProperty." .

# --- 26. walletAddress is NOT functional (MUST-NOT) ---------------------------
ex:saWalletAddressNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:walletAddress ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:walletAddress MUST NOT be owl:FunctionalProperty -- a single HD wallet may have multiple addresses (derivation paths)." .

# --- 27. walletScheme is an ObjectProperty (MUST) -----------------------------
ex:saWalletSchemeIsFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:walletScheme a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:walletScheme MUST be an owl:ObjectProperty -- a wallet's blockchain scheme is a reified object value." .
