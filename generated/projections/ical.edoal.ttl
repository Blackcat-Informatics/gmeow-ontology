@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ical: <http://www.w3.org/2002/12/cal/icaltzd#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/ical> a align:Alignment ;
    rdfs:label "GMEOW → ical (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "Participation participant → iCalendar ATTENDEE"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:compose ( [ a edoal:Relation ;
                                edoal:inverse [ a edoal:Relation ;
                                        edoal:uri gmeow:participationEvent ] ] [ a edoal:Relation ;
                                edoal:uri gmeow:participationParticipant ] ) ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri ical:attendee ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnParticipationToEventRole ] ],
        [ a align:Cell ;
            rdfs:label "hasParticipant → iCalendar ATTENDEE"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasParticipant ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri ical:attendee ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnParticipantToAttendee ] ],
        [ a align:Cell ;
            rdfs:label "RecurrenceRule text → iCalendar RRULE"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:recurrenceRuleText ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri ical:rrule ] ;
            align:relation "<=" ;
            edoal:measure 9.5e-01 ],
        [ a align:Cell ;
            rdfs:label "Event type label → iCalendar SUMMARY"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:compose ( [ a edoal:Relation ;
                                edoal:uri gmeow:eventType ] [ a edoal:Relation ;
                                edoal:uri rdfs:label ] ) ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri ical:summary ] ;
            align:relation "<=" ;
            edoal:measure 6e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnEventTypeToSummary ] ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "ical" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
