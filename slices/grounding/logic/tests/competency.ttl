# --- Every lifecycle axis has exactly one carrier ----------------------------
ex:cqAxisCarriersShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "axis" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "term" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:cqAxisCarriers a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX logic: <https://blackcatinformatics.ca/logic/> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#> SELECT ?axis ?term WHERE { VALUES ?axis { logic:ApprovalBindingFault logic:ApprovalState logic:ContinuationKind logic:DeliverySemantics logic:EffectProtocolPosition logic:EnactmentState logic:FrontierLabel logic:IncompleteCause logic:InformationState logic:IntegrityFault logic:OperationOutcome logic:PrescriptionKind logic:RebuildReason logic:ReconciliationVerdict logic:RecurrenceState logic:RejectionKind logic:SearchFragment logic:SkipReason logic:StepState logic:UnsupportedFragmentCondition } ?term rdfs:range ?axis . FILTER NOT EXISTS { ?term rdfs:domain ?axis } } ORDER BY ?axis ?term" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A closed axis vocabulary is worth nothing unless exactly one property carries it: two carriers let a record sit at two positions of one axis at once, and none leaves the vocabulary decorative. This question reads the carrier off rdfs:range rather than off prose, and the filter is what makes it an answer about carriers — a relation whose domain is the axis itself relates two positions to each other (logic:knowledgePrecedes orders the knowledge states) and is not a way for a record to occupy one. Nineteen of the twenty axes have exactly one carrier. The twentieth, the pre-existing information-state axis, has two — an enactment reads it as the knowledge held about an effect, and the epistemics surface reads it as a category polarity — which is why the pin is over PAIRS and not over a count: a count of twenty-one cannot tell a legitimate second reader of one axis apart from a second carrier accidentally minted for another." ;
    gmeow:cqResultShape ex:cqAxisCarriersShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:cqAxisCarriersRowApprovalBindingFaultapprovalBindingFault , ex:cqAxisCarriersRowApprovalStateapprovalState , ex:cqAxisCarriersRowContinuationKindcontinuationKind , ex:cqAxisCarriersRowDeliverySemanticsidempotencyDuplicateSemantics , ex:cqAxisCarriersRowEffectProtocolPositioneffectProtocolPosition , ex:cqAxisCarriersRowEnactmentStateenactmentState , ex:cqAxisCarriersRowFrontierLabelentryLabel , ex:cqAxisCarriersRowIncompleteCauseincompleteCause , ex:cqAxisCarriersRowInformationStatecategoryPolarity ,
        ex:cqAxisCarriersRowInformationStateeffectKnowledge , ex:cqAxisCarriersRowIntegrityFaultintegrityFault , ex:cqAxisCarriersRowOperationOutcomeoperationOutcome , ex:cqAxisCarriersRowPrescriptionKindprescriptionKind , ex:cqAxisCarriersRowRebuildReasonrebuildReason , ex:cqAxisCarriersRowReconciliationVerdictreconciliationVerdict , ex:cqAxisCarriersRowRecurrenceStaterecurrenceState , ex:cqAxisCarriersRowRejectionKindrejectionKind , ex:cqAxisCarriersRowSearchFragmentsearchFragment , ex:cqAxisCarriersRowSkipReasonskipReason , ex:cqAxisCarriersRowStepStatestepState , ex:cqAxisCarriersRowUnsupportedFragmentConditionunsupportedCondition  .

ex:cqAxisCarriersRowApprovalBindingFaultapprovalBindingFault a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "axis" ; gmeow:cellValueIri logic:ApprovalBindingFault ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:approvalBindingFault ] .
