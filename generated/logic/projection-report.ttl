<https://blackcatinformatics.ca/logic/target/abnf:gmn>
    a logic:ProjectionTarget ;
    rdfs:label "abnf:gmn" ;
    gmeow:lossyDrop "actual: grammar versioning is not carried into the emitted file" ,
        "actual: licensing links from the source forms have no grammar-notation target" ,
        "actual: rule 'digit': EBNF character class '[0-9]' has no RFC-5234 ABNF form (ABNF has no verbatim/negated class)" ,
        "actual: rule 'nameChar': EBNF character class '[A-Za-z0-9_.-]' has no RFC-5234 ABNF form (ABNF has no verbatim/negated class)" ,
        "actual: rule 'nameStart': EBNF character class '[A-Za-z_]' has no RFC-5234 ABNF form (ABNF has no verbatim/negated class)" ,
        "actual: rule provenance is not carried into the grammar file (comments at best)" ;
    logic:complexityClass "n/a" ;
    logic:preservationKind logic:SoundUnderApproximation .

