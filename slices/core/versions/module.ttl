@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:VersionMembership
    a logic:SubKind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "Version Membership"@x-gmeow-english ;
    logic:mediates gmeow:versionMember ,
        gmeow:versionSet ,
        gmeow:membershipAuthority ;
    rdfs:subClassOf logic:Relator ,
        gmeow:Observation ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:versionMember ;
            logic:someValuesFrom gmeow:Entity ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:versionSet ;
            logic:someValuesFrom gmeow:VersionSet ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:membershipAuthority ;
            logic:someValuesFrom gmeow:Agent ;
        ] ;
    skos:definition "A reified, standpoint-scoped claim that a concrete entity belongs to a version set with a particular role and/or scale — an observation in the universal claim stack (observation-spine bridge). Mediates between an entity (versionMember), a version set (versionSet), and an optional role/scale asserted by an authority (membershipAuthority / vantage). Mint one VersionMembership per (entity, versionSet, role, authority) tuple; when a role changes over time, close the old membership's interval or mint a fresh one — never overwrite (Principle 10). Inherits confidence, displayable, and temporal scope from Observation."@x-gmeow-english ;
    skos:example "ex:m1 a gmeow:VersionMembership ; gmeow:versionMember ex:v2 ; gmeow:versionSet ex:gmeowLineage ; gmeow:versionRole gmeow:roleLatest ; gmeow:membershipAuthority ex:pypi ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid hard-coding a version role as an essential type on the artifact, and avoid overwriting a role in place; mint a new membership or close the old interval instead (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint one relator per (entity, set, role, authority) tuple; fill versionMember, versionSet, and membershipAuthority, attach versionRole / versionScale / membershipInterval as needed, and inherit confidence and gmeow:displayable from Observation."@x-gmeow-english ;
    gmeow:useWhen "Use to claim that a concrete version belongs to a lineage with a given role or scale according to some authority — the reified relator whenever the role, period, authority, or confidence of the membership must be first-class and standpoint-indexed (Principle 9)."@x-gmeow-english .

gmeow:VersionRole
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "Version Role"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "A role or status that an entity holds within a version set according to an authority — a VALUE, never an Entity subclass. Standpoint-scoped: 'latest' according to a package registry may differ from 'latest' according to a downstream mirror. The seed list is an anchor, not a fence."@x-gmeow-english ;
    skos:example "ex:roleArchived a gmeow:VersionRole ; rdfs:label \"archived\"@en ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting per-role Entity subclasses or typing artifacts directly with a role; roles are individual values asserted through a standpoint-scoped membership, not essential types."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded individuals from gmeow:versionRole, and extend the anchor list with new gmeow:VersionRole individuals (label only) rather than subclasses when a lineage needs a role the seeds omit."@x-gmeow-english ;
    gmeow:useWhen "Use as the open value vocabulary for membership roles — the named statuses (latest, stable, deprecated, yanked, …) referenced by gmeow:versionRole, and the place to mint a new role individual when a domain needs one."@x-gmeow-english .

gmeow:VersionScale
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "Version Scale"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The magnitude scale of a version change — a VALUE, never an Entity subclass. Used for SemVer-style classification and analogous schemes in non-software domains."@x-gmeow-english ;
    skos:example "ex:scaleBreaking a gmeow:VersionScale ; rdfs:label \"breaking\"@en ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting per-scale Entity subclasses and avoid using it as the role of a version (that is gmeow:VersionRole); scales are individual values, not essential types."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded individuals from gmeow:versionScale, and add new gmeow:VersionScale individuals (label only) when a non-software scheme needs a magnitude the seeds omit."@x-gmeow-english ;
    gmeow:useWhen "Use as the open value vocabulary for change magnitude — the named scales (trivial, minor, major) referenced by gmeow:versionScale for SemVer-style and analogous schemes."@x-gmeow-english .

gmeow:VersionSet
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "Version Set"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "A first-class information object representing a version family or release lineage — the set of all concrete artifacts that are versions of a common stable entity. A VersionSet is an InformationObject (a kind of Entity) so it can carry identifiers, provenance, and authority links. Examples: the lineage of a software project, the edition chain of a book, the variant family of an email thread, the DOI concept record. It is not itself a version of anything, and never the concrete artifact — its members are."@x-gmeow-english ;
    skos:example "ex:gmeowLineage a gmeow:VersionSet ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a single concrete artifact (that is the gmeow:versionMember entity) and avoid collapsing the lineage into one of its versions; the set is the concept, the members are the versions (concept-vs-version distinction)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint one VersionSet per lineage, carry its identifiers and authority links here, and relate each concrete version to it through a gmeow:VersionMembership rather than by direct typing."@x-gmeow-english ;
    gmeow:useWhen "Use to name the stable concept-level lineage that concrete versions belong to — the family any individual release, edition, or snapshot is a version of — so memberships can hang off it rather than off a privileged 'latest'."@x-gmeow-english .

gmeow:membershipAuthority
    a logic:ObjectProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "membership authority"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent or standpoint that asserts this version membership and its role — a project maintainer, a package registry, a publisher, a curator, or a self-asserting individual. NON-FUNCTIONAL: competing authority claims coexist without privilege (Principle 9). When the claim is promoted from a flat statement annotation, gmeow:accordingTo becomes the membershipAuthority of the relator. It is not the member, nor the set — it is who says the membership holds."@x-gmeow-english ;
    skos:example "ex:m1 gmeow:membershipAuthority ex:pypi ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid privileging one authority's claim over another (Principle 9); model each authority's view as its own membership rather than overwriting, and keep this property non-functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set the asserting gmeow:Agent here; when promoting a flat statement, carry its gmeow:accordingTo onto this property as the relator's authority."@x-gmeow-english ;
    gmeow:useWhen "Use to name the agent or standpoint that vouches for a membership and its role — the registry, maintainer, publisher, or curator whose claim it is, so that rival authorities can be told apart."@x-gmeow-english .

gmeow:membershipInterval
    a logic:ObjectProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "membership interval"@x-gmeow-english ;
    rdfs:range gmeow:TimeInterval ;
    skos:definition "The time interval over which this version membership / role claim holds. A relator carries its period this way (matching gmeow:usageInterval, gmeow:taggingInterval, gmeow:relationshipInterval) rather than via gmeow:duringInterval, which is reserved for gufo:Situation-based time-scoped relations."@x-gmeow-english ;
    skos:example "ex:m1 gmeow:membershipInterval ex:y2024to2025 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid gmeow:duringInterval here (that is reserved for gufo:Situation-based relations) and avoid mutating an interval to flip a role; close the old membership and mint a fresh one (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point it at a gmeow:TimeInterval; when a role changes, leave the old membership with its closed interval and add a new membership for the new period."@x-gmeow-english ;
    gmeow:useWhen "Use to bound a membership / role claim in time — the window over which a version held 'latest', 'stable', or 'deprecated' according to its authority."@x-gmeow-english .

gmeow:roleCanonical
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "canonical"@x-gmeow-english ;
    skos:definition "The canonical version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:roleCollected
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "collected"@x-gmeow-english ;
    skos:definition "The collected version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:roleDeprecated
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "deprecated"@x-gmeow-english ;
    skos:definition "The deprecated version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:roleDraft
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "draft"@x-gmeow-english ;
    skos:definition "The draft version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:roleLTS
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "long-term support (LTS)"@x-gmeow-english ;
    skos:definition "The lts version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:roleLatest
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "latest"@x-gmeow-english ;
    skos:definition "The latest version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:rolePublished
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "published"@x-gmeow-english ;
    skos:definition "The published version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:roleRevised
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "revised"@x-gmeow-english ;
    skos:definition "The revised version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:roleStable
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "stable"@x-gmeow-english ;
    skos:definition "The stable version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:roleVariant
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "variant"@x-gmeow-english ;
    skos:definition "The variant version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:roleWithdrawn
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "withdrawn"@x-gmeow-english ;
    skos:definition "The withdrawn version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:roleYanked
    a gmeow:VersionRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "yanked"@x-gmeow-english ;
    skos:definition "The yanked version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scaleMajor
    a gmeow:VersionScale ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "major"@x-gmeow-english ;
    skos:definition "The major version scale — a magnitude category used to characterize the impact of a version change."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scaleMinor
    a gmeow:VersionScale ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "minor"@x-gmeow-english ;
    skos:definition "The minor version scale — a magnitude category used to characterize the impact of a version change."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scaleTrivial
    a gmeow:VersionScale ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "trivial"@x-gmeow-english ;
    skos:definition "The trivial version scale — a magnitude category used to characterize the impact of a version change."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:versionFingerprint
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "version fingerprint"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "A content fingerprint of the versioned entity — a hash, SWHID, content digest, or semantic identifier. Broader than gmeow:contentDigest (which is byte-exact and domain gmeow:CreativeWork, typically Manifestation or Item): versionFingerprint covers semantic fingerprints where exact bytes are not the identity criterion (e.g. a normalized form, a canonicalized serialization). Non-functional: a single entity may carry several fingerprints under different algorithms or schemes."@x-gmeow-english ;
    skos:example "ex:v2 gmeow:versionFingerprint \"swh:1:rev:abc123\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a byte-exact digest of a creative-work manifestation or item (use gmeow:contentDigest) and avoid assuming one fingerprint per entity; several algorithms or schemes may coexist, so it is non-functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Attach one literal per algorithm/scheme to the versioned gmeow:Entity; record byte-exact identity separately with gmeow:contentDigest where that is the criterion."@x-gmeow-english ;
    gmeow:useWhen "Use to fingerprint a versioned entity where the identity criterion is semantic rather than byte-exact — a SWHID, a normalized-form hash, a canonicalized-serialization digest."@x-gmeow-english .

gmeow:versionLabel
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "version label"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The version designation of an entity as a literal (\"1993\", \"2011\", \"v2.1.0-beta\", \"3rd Edition\"). Domain is gmeow:Entity so any versioned artifact — a language, a software release, a book edition, a dataset, an email variant — may carry its designation. Non-functional. It is not a comparable version structure: never parse it into components or order by it."@x-gmeow-english ;
    gmeow:useWhen "Use to record an entity's version designation as it is actually written."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid parsing it into components or ordering by it — it is a label, not a comparable version structure."@x-gmeow-english ;
    gmeow:howToUse "A plain literal on any gmeow:Entity: a release, a book edition, a dataset, a language variant."@x-gmeow-english ;
    skos:example "gmeow:release1 gmeow:versionLabel \"v2.1.0-beta\" ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:versionMember
    a logic:ObjectProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "version member"@x-gmeow-english ;
    rdfs:range gmeow:Entity ;
    skos:definition "The concrete entity that participates in a version set via this membership — a software release, a book edition, an email variant, a dataset snapshot. Functional per relator: one member per VersionMembership. It is not the version set, nor the membership relator that carries it."@x-gmeow-english ;
    skos:example "ex:m1 gmeow:versionMember ex:gmeow_1_0_1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at the lineage concept (that is gmeow:versionSet) and avoid asserting more than one member per relator; it is functional, so a second member collapses the two."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set exactly one versionMember on each VersionMembership and pair it with gmeow:versionSet; model a different version of the same lineage as its own membership relator."@x-gmeow-english ;
    gmeow:useWhen "Use to name the one concrete version an individual VersionMembership is about — the artifact (release, edition, snapshot) being placed in the lineage."@x-gmeow-english .

gmeow:versionRole
    a logic:ObjectProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "version role"@x-gmeow-english ;
    rdfs:range gmeow:VersionRole ;
    skos:definition "The role or status classification this membership asserts for the member within the set — canonical, variant, latest, stable, LTS, deprecated, yanked, draft, published, revised, collected, withdrawn. NON-FUNCTIONAL: an entity may hold multiple roles from different authorities simultaneously (standpoint-indexed coexistence per Principle 9), and a role may change over time via new memberships rather than overwrite."@x-gmeow-english ;
    skos:example "ex:m1 gmeow:versionRole gmeow:roleLatest ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid forcing a single global role per artifact: competing authority roles coexist (Principle 9), so leave it non-functional and mint a new membership when the role changes rather than overwrite."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Reference a seeded gmeow:VersionRole individual; carry differing authority opinions as separate memberships and bound a role in time with gmeow:membershipInterval."@x-gmeow-english ;
    gmeow:useWhen "Use to record the role or status a membership asserts for its member — latest, stable, deprecated, yanked, and so on — as a standpoint-scoped value rather than an essential type."@x-gmeow-english .

gmeow:versionScale
    a logic:ObjectProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "version scale"@x-gmeow-english ;
    rdfs:range gmeow:VersionScale ;
    skos:definition "The scale classification of this membership — trivial, minor, major. NON-FUNCTIONAL: different authorities or schemes may classify the same change differently; those claims coexist. It is not an ordering: a scale value never implies precedence between two members."@x-gmeow-english ;
    skos:example "ex:m1 gmeow:versionScale gmeow:scaleMajor ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating it as the role of the version (that is gmeow:versionRole) and avoid forcing one scale per change; rival scheme classifications coexist, so keep it non-functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Reference a seeded gmeow:VersionScale individual on the membership relator; carry a competing scheme's classification as its own membership claim."@x-gmeow-english ;
    gmeow:useWhen "Use to classify the magnitude of a version change — trivial, minor, major — for SemVer-style schemes and their non-software analogues."@x-gmeow-english .

gmeow:versionSet
    a logic:ObjectProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "version set"@x-gmeow-english ;
    rdfs:range gmeow:VersionSet ;
    skos:definition "The version set / lineage to which this membership belongs. Functional per relator: one set per VersionMembership. It is not the member, and never a second membership for the same artifact."@x-gmeow-english ;
    skos:example "ex:m1 gmeow:versionSet ex:gmeowLineage ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing it at the concrete artifact (that is gmeow:versionMember) and avoid more than one set per relator; it is functional."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set exactly one versionSet, an existing gmeow:VersionSet individual, alongside the relator's gmeow:versionMember."@x-gmeow-english ;
    gmeow:useWhen "Use to name the one lineage a VersionMembership places its member into — the concept-level family the version belongs to."@x-gmeow-english .

# ── Per-term lifecycle metadata ──────────────────────────────────────────────────
# Maturity and changelog signals about a VOCABULARY TERM (a class or property in
# the TBox), distinct from the standpoint-scoped instance-level version roles
# above. Asserted with OWL AnnotationProperty (the gmeow:accordingTo pattern,
# Principle 3) so that annotating a class keeps the generated OWL downcast in
# OWL 2 DL — a term's own maturity/history is metadata ABOUT the term, never an
# essential type. Surfaced on every term page by the ontology-docs generator.

gmeow:TermStability
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    gmeow:addedInVersion "0.1.0" ;
    rdfs:label "Term Stability"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The maturity status a vocabulary term holds within the ontology's own release lifecycle — a VALUE, never an Entity subclass. The seed list (stable, experimental, deprecated) is an anchor, not a fence: a domain may mint further statuses. Distinct from gmeow:VersionRole, which classifies a concrete artifact's membership in a lineage; TermStability classifies a TBox term's own readiness for adopter use."@x-gmeow-english ;
    skos:example "ex:stabilityReleaseCandidate a gmeow:TermStability ; rdfs:label \"release candidate\"@en ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting per-status Entity subclasses or typing instances with a stability value; stability is an annotation value asserted about a term via gmeow:termStability, not an essential type, and not a per-instance version role (that is gmeow:VersionRole)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Reference the seeded individuals from gmeow:termStability, and extend the anchor list with new gmeow:TermStability individuals (label only) when an editorial process needs a status the seeds omit."@x-gmeow-english ;
    gmeow:useWhen "Use as the open value vocabulary for per-term maturity — the named statuses (stable, experimental, deprecated, …) referenced by gmeow:termStability, and the place to mint a new status individual."@x-gmeow-english .

gmeow:stabilityStable
    a gmeow:TermStability ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "stable"@x-gmeow-english ;
    skos:definition "The stable term-stability status — the term is mature and its meaning is committed; adopters may rely on it. The default for core-tier terms unless an explicit gmeow:termStability or OWL deprecated overrides it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:stabilityExperimental
    a gmeow:TermStability ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "experimental"@x-gmeow-english ;
    skos:definition "The experimental term-stability status — the term is provisional and may change or be withdrawn; adopters should pin and watch it. The default for extension-tier terms unless an explicit gmeow:termStability overrides it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:stabilityDeprecated
    a gmeow:TermStability ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "deprecated"@x-gmeow-english ;
    skos:definition "The deprecated term-stability status — the term is retained for continuity but should no longer be used; a replacement is expected. Implied by OWL deprecated true on the term, or asserted explicitly via gmeow:termStability."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:termStability
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    gmeow:addedInVersion "0.1.0" ;
    rdfs:label "term stability"@x-gmeow-english ;
    skos:definition "Annotates a vocabulary term with its maturity status — a gmeow:TermStability individual (stable, experimental, deprecated). An OWL AnnotationProperty (the gmeow:accordingTo pattern, Principle 3) because it is asserted ABOUT a class or property, keeping the generated OWL in OWL 2 DL. When absent, the docs generator derives a default from the owner slice's tier (core → stable, extension → experimental) and from OWL deprecated; an explicit assertion overrides the default."@x-gmeow-english ;
    skos:example "gmeow:SomeTerm gmeow:termStability gmeow:stabilityExperimental ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it on instances or using it for a concrete version's lifecycle role (that is gmeow:versionRole through a gmeow:VersionMembership); reserve it for the maturity of a TBox term."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point it at one seeded gmeow:TermStability individual on the class or property; omit it to accept the tier-derived default."@x-gmeow-english ;
    gmeow:useWhen "Use to override a term's derived maturity badge — to mark a core term experimental while it settles, or to flag any term deprecated ahead of removal."@x-gmeow-english .

gmeow:addedInVersion
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "added in version"@x-gmeow-english ;
    skos:definition "The ontology release version in which a vocabulary term first appeared — a literal version string (e.g. \"1.0.2\"). An OWL AnnotationProperty asserted about a class or property. The seed for the per-term changelog; eventually populated automatically from release-as-evidence content-address diffs (CONSTITUTION §18)."@x-gmeow-english ;
    skos:example "gmeow:SomeTerm gmeow:addedInVersion \"1.0.2\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it for a concrete artifact's version (that is gmeow:versionMember / gmeow:versionFingerprint on a gmeow:VersionMembership); reserve it for the release a TBox term debuted in."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Attach one version-string literal to the term; pair it with gmeow:hasChangelogEntry to narrate subsequent changes."@x-gmeow-english ;
    gmeow:useWhen "Use to record when a term entered the vocabulary, so adopters can tell newly-added terms from long-stable ones at a glance."@x-gmeow-english .

gmeow:ChangelogEntry
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:hasChangelogEntry [
        a gmeow:ChangelogEntry ;
        gmeow:entryVersion "1.0.2" ;
        gmeow:entryNote "Introduced the reified per-term changelog record; entries are seeded editorially pending release-as-evidence automation (CONSTITUTION §18)."@x-gmeow-english ;
    ] ;
    rdfs:label "Changelog Entry"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "A reified record of one change to a vocabulary term in a given release — a first-class information object carrying a version (gmeow:entryVersion) and optional prose (gmeow:entryNote). Attached to a term through the gmeow:hasChangelogEntry annotation, so a term accrues an ordered per-release history without any per-instance lifecycle modelling."@x-gmeow-english ;
    skos:example "[ a gmeow:ChangelogEntry ; gmeow:entryVersion \"1.0.2\" ; gmeow:entryNote \"Range tightened to gmeow:Entity.\"@x-gmeow-english ]"@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a concrete artifact's release record (that is a gmeow:VersionMembership) and avoid overwriting an entry to revise history; add a new entry per release (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint one entry per (term, release) change, fill gmeow:entryVersion and optionally gmeow:entryNote, and attach it with gmeow:hasChangelogEntry."@x-gmeow-english ;
    gmeow:useWhen "Use to narrate a single per-release change to a term — what changed and in which version — building the term's changelog block in the docs."@x-gmeow-english .

gmeow:hasChangelogEntry
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    gmeow:hasChangelogEntry [
        a gmeow:ChangelogEntry ;
        gmeow:entryVersion "1.0.2" ;
        gmeow:entryNote "Introduced the per-term changelog annotation — attaches gmeow:ChangelogEntry records to a vocabulary term."@x-gmeow-english ;
    ] ;
    rdfs:label "has changelog entry"@x-gmeow-english ;
    skos:definition "Attaches a gmeow:ChangelogEntry to the vocabulary term it describes. An OWL AnnotationProperty (the gmeow:accordingTo pattern, Principle 3) so a class or property can carry per-release history while the generated OWL stays in OWL 2 DL. Non-functional: a term accrues one entry per release."@x-gmeow-english ;
    skos:example "gmeow:SomeTerm gmeow:hasChangelogEntry [ a gmeow:ChangelogEntry ; gmeow:entryVersion \"1.0.2\" ] ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid collapsing several releases into one entry; mint one gmeow:ChangelogEntry per release so the history stays ordered and auditable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Point it at a gmeow:ChangelogEntry node carrying gmeow:entryVersion and optional gmeow:entryNote; repeat for each release that touched the term."@x-gmeow-english ;
    gmeow:useWhen "Use to give a term a per-release changelog — the ordered list of versioned changes shown on its docs page."@x-gmeow-english .

gmeow:entryVersion
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "entry version"@x-gmeow-english ;
    skos:definition "The release version a gmeow:ChangelogEntry pertains to — a literal version string (e.g. \"1.0.2\"). Required on every entry; the docs generator sorts a term's entries by this value."@x-gmeow-english ;
    skos:example "[ a gmeow:ChangelogEntry ; gmeow:entryVersion \"1.0.2\" ] ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid omitting it (an entry with no version cannot be ordered) and avoid pointing it at a lineage concept; it is a literal release string for one entry."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Set one version-string literal per gmeow:ChangelogEntry; keep it consistent with the term's gmeow:addedInVersion."@x-gmeow-english ;
    gmeow:useWhen "Use to stamp a changelog entry with the release it describes, so the per-term changelog can be ordered and rendered."@x-gmeow-english .

gmeow:entryNote
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "entry note"@x-gmeow-english ;
    skos:definition "Optional prose describing what changed in a gmeow:ChangelogEntry — a short, localizable note carried on the @x-gmeow-english carrier. Renders as the per-release line in a term's changelog block."@x-gmeow-english ;
    skos:example "[ a gmeow:ChangelogEntry ; gmeow:entryVersion \"1.0.2\" ; gmeow:entryNote \"Range tightened to gmeow:Entity.\"@x-gmeow-english ] ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid packing multiple releases' changes into one note; one note describes the single release named by its entry's gmeow:entryVersion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Attach one localizable prose literal to the entry on the @x-gmeow-english carrier; keep it terse — one change, one sentence."@x-gmeow-english ;
    gmeow:useWhen "Use to say in words what changed about a term in a given release, beyond the bare version string."@x-gmeow-english .

gmeow:definitionDigest
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    gmeow:addedInVersion "0.1.0" ;
    gmeow:termStability gmeow:stabilityExperimental ;
    rdfs:label "definition digest"@x-gmeow-english ;
    skos:definition "The RDFC-1.0-canonical content digest (blake3) of a vocabulary term's DEFINING triples — its content-address. Computed over the term's concise bounded description with the per-term provenance predicates (this digest, gmeow:versionFingerprint, gmeow:addedInVersion, gmeow:hasChangelogEntry and its parts, gmeow:termStability) excluded, so recording provenance never perturbs the digest that generated it. An OWL AnnotationProperty (the gmeow:accordingTo pattern, Principle 3) because it is asserted ABOUT a class or property, keeping the generated OWL in OWL 2 DL. Drives the computed per-term changelog (a definition whose digest differs from the prior release records a change) and serves as a stable citation permalink for the term's meaning."@x-gmeow-english ;
    skos:example "gmeow:SomeTerm gmeow:definitionDigest \"blake3:1a2b3c…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a concrete artifact's byte-exact hash (use gmeow:contentDigest) or a semantic artifact fingerprint (use gmeow:versionFingerprint); reserve it for the canonical digest of a TBox term's defining triples, and never author it by hand — it is computed from the term's definition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Let the pipeline compute it from the term's canonical definition; read it to detect when a term's meaning changed between releases or to cite a term's definition by content-address."@x-gmeow-english ;
    gmeow:useWhen "Use to content-address a vocabulary term's meaning — to detect when its definition changed across releases (driving the computed changelog) or to cite the exact definition by digest."@x-gmeow-english .

<https://blackcatinformatics.ca/gmeow/slices/versions>
    a logic:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "Cross-cutting version-set and version-membership facility for information-object lineages. Reuses the universal claim stack (Observation / Relator) so that version roles — canonical, variant, latest, stable, LTS, deprecated, yanked, etc. — are standpoint-scoped claims coexisting without privilege (Principle 9), never hard-coded as essential types. Suppressed versions remain first-class with gmeow:displayable false (Principle 10). Attestation evidence (signatures, SLSA, DOI assertions) belongs in attestation layer and composes with this layer; it is not embedded here."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "GMEOW Versions Module"@x-gmeow-english ;
    skos:definition "The GMEOW Versions Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects OWL FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:versionMemberFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "versionMember is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:versionMember is functional: each gmeow:VersionMembership is about exactly one concrete version artifact — a different version of the same lineage is its own membership relator, not a second member."@x-gmeow-english ;
    logic:characterizes gmeow:versionMember ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:versionMember ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:versionMember names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:versionMember, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:versionMember and nothing else. It is not a definition of gmeow:versionMember (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:versionMemberFunctionality logic:characterizes gmeow:versionMember ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:versionSetFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:label "versionSet is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:versionSet is functional: each gmeow:VersionMembership places its member into exactly one lineage, so a membership belongs to a single gmeow:VersionSet. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:versionSet ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:versionSet ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:versionSet names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:versionSet, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:versionSet and nothing else. It is not a definition of gmeow:versionSet (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:versionSetFunctionality logic:characterizes gmeow:versionSet ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
