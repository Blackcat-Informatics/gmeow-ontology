    logic:recoveryCase sup:notationNotationSignSystemRecovery ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:notationNotationSignSystemGet gmeow:path sup:notationNotationSignSystemStep .
sup:notationNotationSignSystemRecovery a logic:RecoveryCase ;
    rdfs:label "Notation System to Sign System recovery case"@x-gmeow-english ;
    skos:definition "An executable recovery case that checks whether the Notation-System-to-Sign-System correspondence recovers its complete source graph."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
