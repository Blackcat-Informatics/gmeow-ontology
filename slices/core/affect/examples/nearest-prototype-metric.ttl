# Worked example: the metric DECIDES which named emotion a felt state is nearest to.
# Under the valence-dominant Gram matrix diag(2, 1) — valence weighted twice as
# heavily as arousal — the state (valence 0.5, arousal 0.0) is classified to its
# NEAREST named-emotion prototype by exact squared distance ‖x − pᵢ‖²_G:
#
#   contentment  p = (0.2, 0.5) :  Δ = (0.3, -0.5)
#       raw L²    = 0.3² + 0.5²         = 0.09 + 0.25 = 0.34
#       metric  G = 2·0.3² + 1·0.5²     = 0.18 + 0.25 = 0.43   (= 43/100)
#   elation      p = (0.6, 0.6) :  Δ = (-0.1, -0.6)
#       raw L²    = 0.1² + 0.6²         = 0.01 + 0.36 = 0.37
#       metric  G = 2·0.1² + 1·0.6²     = 0.02 + 0.36 = 0.38   (= 19/50)
#
# The raw-Euclidean-nearest prototype is CONTENTMENT (0.34 < 0.37), but the
# metric-nearest is ELATION (38/100 < 43/100): the valence-dominant metric pulls the
# state toward the prototype whose valence nearly matches. Nearest-prototype is a
# metric-relative question, decided on the EXACT rational squared distance (√ is
# monotone, so squared order = distance order); the √ decimal is display only.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/affect/nearest/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

ex:analyst a gmeow:Person ; rdfs:label "the analyst"@en .
ex:episode rdfs:label "the appraised affective episode"@en .

# The declared unit scale the per-axis readings are framed against.
ex:padUnitScale a gmeow:AffectScaleProfile ;
    rdfs:label "PAD unit scale"@en ;
    gmeow:profileRangeMin -1.0 ;
    gmeow:profileRangeMax 1.0 ;
    gmeow:profileMidpoint 0.0 ;
    gmeow:profilePolarity gmeow:polarityBipolar .

# The shared valence-dominant metric profile whose Gram matrix is diag(2, 1). ALL
# three observations measure against this one profile, so they share one metric basis.
ex:valenceDominantMetric a gmeow:AffectScaleProfile ;
    rdfs:label "valence-dominant PAD metric profile"@en ;
    gmeow:profileRangeMin -1.0 ;
    gmeow:profileRangeMax 1.0 ;
    gmeow:profileMidpoint 0.0 ;
    gmeow:profilePolarity gmeow:polarityBipolar ;
    gmeow:sparseAxisCompletion true ;
    gmeow:metricGram ex:valenceDominantGram .

ex:valenceDominantForm a math:SymmetricBilinearForm ;
    rdfs:label "the positive-definite valence-dominant form (diagonal 2, 1)"@en ;
    math:definiteness math:positiveDefinite .

ex:valenceDominantBasis a math:Basis ;
    rdfs:label "the (valence, arousal) coordinate basis"@en .

# G = diag(2, 1): valence weight 2, arousal weight 1. Positive-definite (both diagonal
# entries > 0, no off-diagonal). Exact rational entries, never decimals.
ex:valenceDominantGram a math:GramMatrix ;
    rdfs:label "the Gram matrix G = diag(2, 1)"@en ;
    math:definiteness math:positiveDefinite ;
    math:representsForm ex:valenceDominantForm ;
    math:inBasis ex:valenceDominantBasis ;
    math:hasEntry ex:vdG00 , ex:vdG11 .

ex:vdG00 a math:MatrixEntry ; math:atRow 0 ; math:atColumn 0 ; math:entryValue ex:ratTwo .
ex:vdG11 a math:MatrixEntry ; math:atRow 1 ; math:atColumn 1 ; math:entryValue ex:ratOne .

ex:ratTwo a math:RationalValue ; math:numerator 2 ; math:denominator 1 .
ex:ratOne a math:RationalValue ; math:numerator 1 ; math:denominator 1 .

# ── The state to classify: valence 0.5, arousal 0.0 ──────────────────────────────
ex:stateVector a gmeow:AffectVectorObservation ;
    gmeow:vantage ex:analyst ;
    gmeow:observedFeature ex:episode ;
    gmeow:vectorProfile ex:valenceDominantMetric ;
    gmeow:vectorComponent ex:stateValenceCell , ex:stateArousalCell .

ex:stateValenceCell a gmeow:Appraisal ;
    gmeow:vantage ex:analyst ;
    gmeow:appraisalOf ex:episode ;
    gmeow:appraisalDimension gmeow:dimensionValence ;
    gmeow:appraisalValue 0.5 ;
    gmeow:appraisalScaleProfile ex:padUnitScale .

ex:stateArousalCell a gmeow:Appraisal ;
    gmeow:vantage ex:analyst ;
    gmeow:appraisalOf ex:episode ;
    gmeow:appraisalDimension gmeow:dimensionArousal ;
    gmeow:appraisalValue 0.0 ;
    gmeow:appraisalScaleProfile ex:padUnitScale .

ex:stateObservation a gmeow:DerivedAffectIntensityObservation ;
    rdfs:label "the felt state to classify"@en ;
    gmeow:vantage ex:analyst ;
    gmeow:observedFeature ex:episode ;
    gmeow:intensityBasis ex:stateVector ;
    gmeow:metricProfile ex:valenceDominantMetric ;
    gmeow:weightingPolicy gmeow:weightingValenceDominant ;
    gmeow:normFunction gmeow:affectMetricTensorNorm ;
    gmeow:derivedByFunction gmeow:fnAffectiveIntensity .

# ── Prototype "contentment": valence 0.2, arousal 0.5 (the raw-L² nearest) ────────
ex:contentmentVector a gmeow:AffectVectorObservation ;
    gmeow:vantage ex:analyst ;
    gmeow:vectorProfile ex:valenceDominantMetric ;
    gmeow:vectorComponent ex:contentmentValenceCell , ex:contentmentArousalCell .

ex:contentmentValenceCell a gmeow:Appraisal ;
    gmeow:vantage ex:analyst ;
    gmeow:appraisalDimension gmeow:dimensionValence ;
    gmeow:appraisalValue 0.2 ;
    gmeow:appraisalScaleProfile ex:padUnitScale .

ex:contentmentArousalCell a gmeow:Appraisal ;
    gmeow:vantage ex:analyst ;
    gmeow:appraisalDimension gmeow:dimensionArousal ;
    gmeow:appraisalValue 0.5 ;
    gmeow:appraisalScaleProfile ex:padUnitScale .

ex:contentmentPrototype a gmeow:DerivedAffectIntensityObservation ;
    rdfs:label "the contentment prototype"@en ;
    gmeow:vantage ex:analyst ;
    gmeow:intensityBasis ex:contentmentVector ;
    gmeow:metricProfile ex:valenceDominantMetric ;
    gmeow:weightingPolicy gmeow:weightingValenceDominant ;
    gmeow:normFunction gmeow:affectMetricTensorNorm ;
    gmeow:derivedByFunction gmeow:fnAffectiveIntensity .

# ── Prototype "elation": valence 0.6, arousal 0.6 (the metric-nearest) ────────────
ex:elationVector a gmeow:AffectVectorObservation ;
    gmeow:vantage ex:analyst ;
    gmeow:vectorProfile ex:valenceDominantMetric ;
    gmeow:vectorComponent ex:elationValenceCell , ex:elationArousalCell .

ex:elationValenceCell a gmeow:Appraisal ;
    gmeow:vantage ex:analyst ;
    gmeow:appraisalDimension gmeow:dimensionValence ;
    gmeow:appraisalValue 0.6 ;
    gmeow:appraisalScaleProfile ex:padUnitScale .

ex:elationArousalCell a gmeow:Appraisal ;
    gmeow:vantage ex:analyst ;
    gmeow:appraisalDimension gmeow:dimensionArousal ;
    gmeow:appraisalValue 0.6 ;
    gmeow:appraisalScaleProfile ex:padUnitScale .

ex:elationPrototype a gmeow:DerivedAffectIntensityObservation ;
    rdfs:label "the elation prototype"@en ;
    gmeow:vantage ex:analyst ;
    gmeow:intensityBasis ex:elationVector ;
    gmeow:metricProfile ex:valenceDominantMetric ;
    gmeow:weightingPolicy gmeow:weightingValenceDominant ;
    gmeow:normFunction gmeow:affectMetricTensorNorm ;
    gmeow:derivedByFunction gmeow:fnAffectiveIntensity .
