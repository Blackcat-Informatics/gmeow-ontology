[ a logic:ClosureEntry ; logic:onClass gmeow:CurationEpoch ; logic:closureKey "https://blackcatinformatics.ca/gmeow/epochArchiveDigest" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:MemoryTextLanguageConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "memory text language constraint"@x-gmeow-english ;
    skos:definition "Every supplied memoryText value carries its original language tag and retains any RDF 1.2 base direction. A missing tag is not replaced by a guessed language."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency of the supplied memory record and source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this law proves access enforcement, authorship, digest computation or governed migration."@x-gmeow-english ;
    gmeow:howToUse "Retain the original record and evidence when reporting an intrinsic violation; do not manufacture missing inputs."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:MemoryTextLanguageConstraint logic:formalizes gmeow:memoryText ."@x-gmeow-english ;
    logic:formalizes gmeow:memoryText ;
    logic:message "Every supplied memoryText value carries its original language tag and retains any RDF 1.2 base direction. A missing tag is not replaced by a guessed language." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation gmeow:memoryText ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                    [ logic:termIndex 1 ; logic:termVariable "value" ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termHasLang ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] ] ] ] .

