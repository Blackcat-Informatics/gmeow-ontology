      <termEntry id="c-ed6f802f42cdf3ad">
        <langSet xml:lang="en">
          <tig>
            <term>Axis Threshold</term>
          </tig>
          <tig>
            <term>axis threshold</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Seuil d'axe</term>
