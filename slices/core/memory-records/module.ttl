@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:MemoryBank
    a logic:Kind, logic:Class ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Memory Bank"@x-gmeow-english ;
    skos:definition "The lasting identity of a standing memory body rewritten over time. Its revisions are MemoryItems linked by versionOf; the bank identity carries no revision text."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record a gmeow:MemoryBank ."@x-gmeow-english .

gmeow:BankTier
    a logic:AbstractIndividualType, logic:Class ;
    logic:subClassOf gmeow:ProjectionContext ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Bank Audience Tier"@x-gmeow-english ;
    skos:definition "An open audience vocabulary for memory revisions and claims made of them, specializing ProjectionContext. It names who may receive a projection, independently of DisclosurePolicy posture and without certifying access enforcement."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record a gmeow:BankTier ."@x-gmeow-english .

gmeow:BankReview
    a logic:Event, logic:Class ;
    logic:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Bank Review"@x-gmeow-english ;
    skos:definition "An Activity in which an agent reviews one exact memory-bank revision and records whether it read to the end and what it decided. A disposition records a decision, not proof that a later mutation or release occurred. Its eventTime is the recorded review-decision instant, including partial or deferred reviews, not the duration of reading."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record a gmeow:BankReview ."@x-gmeow-english .

gmeow:BankReviewDisposition
    a logic:AbstractIndividualType, logic:Class ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Bank Review Disposition"@x-gmeow-english ;
    skos:definition "An open vocabulary of decisions recorded during a bank review. Decisions may coexist; missing read-to-end evidence or a decision never means that a revision was fully read or kept unchanged."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record a gmeow:BankReviewDisposition ."@x-gmeow-english .

gmeow:BodyDistillation
    a logic:Kind, logic:Class ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Body Distillation"@x-gmeow-english ;
    skos:definition "An agent’s appraisal in its own words kept on its behalf by its runtime and offered under the runtime’s standpoint. It is separate from a note the agent chose to keep and is not automatically the agent’s self-assertion."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record a gmeow:BodyDistillation ."@x-gmeow-english .

gmeow:CurationEpoch
    a logic:Event, logic:Class ;
    logic:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Curation Epoch"@x-gmeow-english ;
    skos:definition "A historical curation act described by original external source evidence, writing a successor ledger from a predecessor under a manifest and retaining an archive artifact. Its evidence remains outside migrated governed stores; it is no erasure tombstone or governed deletion receipt."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record a gmeow:CurationEpoch ."@x-gmeow-english .

gmeow:bankReviewKeep
    a gmeow:BankReviewDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "keep revision"@x-gmeow-english ;
    skos:definition "The reviewer decided to keep the exact reviewed revision. This decision alone neither proves a complete read nor executes a store mutation."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:review gmeow:reviewDisposition gmeow:bankReviewKeep ."@x-gmeow-english .

gmeow:bankReviewReplace
    a gmeow:BankReviewDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "replace revision"@x-gmeow-english ;
    skos:definition "The reviewer decided to replace the reviewed revision with a new one. Retain the old revision and lineage; the decision itself is not a replacement receipt."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:review gmeow:reviewDisposition gmeow:bankReviewReplace ."@x-gmeow-english .

gmeow:bankReviewAppend
    a gmeow:BankReviewDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "append to revision"@x-gmeow-english ;
    skos:definition "The reviewer decided to append material in a successor revision. It does not silently modify the exact revision already reviewed."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:review gmeow:reviewDisposition gmeow:bankReviewAppend ."@x-gmeow-english .

gmeow:bankReviewClear
    a gmeow:BankReviewDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "clear revision body"@x-gmeow-english ;
    skos:definition "The reviewer decided to clear the bank’s current body in a successor revision. It is not authorization to erase revision history or the bank identity."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:review gmeow:reviewDisposition gmeow:bankReviewClear ."@x-gmeow-english .

gmeow:bankReviewRelabel
    a gmeow:BankReviewDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "relabel revision"@x-gmeow-english ;
    skos:definition "The reviewer decided to change a revision’s label or classification. The decision does not imply unchanged content or confer a broader audience."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:review gmeow:reviewDisposition gmeow:bankReviewRelabel ."@x-gmeow-english .

gmeow:bankReviewRestoreSnapshot
    a gmeow:BankReviewDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "restore snapshot"@x-gmeow-english ;
    skos:definition "The reviewer decided to restore a prior snapshot as a successor revision, preserving the original snapshot and intervening history."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:review gmeow:reviewDisposition gmeow:bankReviewRestoreSnapshot ."@x-gmeow-english .

gmeow:bankReviewProposeWiderAudience
    a gmeow:BankReviewDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "propose wider audience version"@x-gmeow-english ;
    skos:definition "The reviewer proposed a version for a wider audience. A proposal is not publication, permission or proof that the current revision may be released."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:review gmeow:reviewDisposition gmeow:bankReviewProposeWiderAudience ."@x-gmeow-english .

gmeow:bankReviewHandledPrivately
    a gmeow:BankReviewDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "handled in private conversation"@x-gmeow-english ;
    skos:definition "The review was handled in a private conversation. This disposition makes no claim that the bank was unchanged and requires no exposure of private conversation text."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:review gmeow:reviewDisposition gmeow:bankReviewHandledPrivately ."@x-gmeow-english .

gmeow:bankReviewDeferredChanged
    a gmeow:BankReviewDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "deferred because bank changed"@x-gmeow-english ;
    skos:definition "The reviewer deferred because the bank changed during the review. The reviewedRevision still identifies the exact revision actually read, never a moving latest pointer."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:review gmeow:reviewDisposition gmeow:bankReviewDeferredChanged ."@x-gmeow-english .

gmeow:memoryText
    a logic:DatatypeProperty ;
    logic:domain gmeow:MemoryItem ;
    logic:range rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "memory text"@x-gmeow-english ;
    skos:definition "The memory item’s verbatim prose as written by the remembering agent, retaining language and base direction. It is neither a summary nor a chosen note."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record gmeow:memoryText \"Words retained.\"@en ."@x-gmeow-english .

gmeow:bankTier
    a logic:AnnotationProperty ;
    logic:range gmeow:BankTier ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "bank audience tier"@x-gmeow-english ;
    skos:definition "The audience classification of a revision or a statement about one. Statement annotations retain claim-specific audience scope; the value is separate from disclosure posture and does not certify enforcement."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record gmeow:bankTier ex:value ."@x-gmeow-english .

gmeow:reviewedRevision
    a logic:ObjectProperty ;
    logic:domain gmeow:BankReview ;
    logic:range gmeow:MemoryItem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reviewed revision"@x-gmeow-english ;
    skos:definition "The exact MemoryItem revision read during this review, with a versionOf link to its lasting MemoryBank. It is not the bank’s latest revision by default."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record gmeow:reviewedRevision ex:value ."@x-gmeow-english .

gmeow:readToEnd
    a logic:DatatypeProperty ;
    logic:domain gmeow:BankReview ;
    logic:range xsd:boolean ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "read to end"@x-gmeow-english ;
    skos:definition "The reported boolean of whether this exact revision was read to its end during this review. False is explicit partial reading; absence does not default to either value."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record gmeow:readToEnd false ."@x-gmeow-english .

gmeow:reviewDisposition
    a logic:ObjectProperty ;
    logic:domain gmeow:BankReview ;
    logic:range gmeow:BankReviewDisposition ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "review disposition"@x-gmeow-english ;
    skos:definition "A decision explicitly recorded by the review. Several decisions may coexist; none alone proves a complete read, an unchanged bank or execution of the proposed change."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record gmeow:reviewDisposition ex:value ."@x-gmeow-english .

gmeow:summaryText
    a logic:DatatypeProperty ;
    logic:domain gmeow:Summary ;
    logic:range rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "summary text"@x-gmeow-english ;
    skos:definition "The summary’s words verbatim as supplied by its summarizer, retaining language and base direction. The original source remains separate through wasDerivedFrom."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record gmeow:summaryText \"Words retained.\"@en ."@x-gmeow-english .

gmeow:summaryAnchor
    a logic:DatatypeProperty ;
    logic:domain gmeow:Summary ;
    logic:range rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "summary paraphrase anchor"@x-gmeow-english ;
    skos:definition "A passage in the summarizer’s own wording identifying material it drew on. It is a paraphrase anchor, not a quotation of source words and not credited to the source author."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record gmeow:summaryAnchor \"Words retained.\"@en ."@x-gmeow-english .

gmeow:distilledText
    a logic:DatatypeProperty ;
    logic:domain gmeow:BodyDistillation ;
    logic:range rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "kept appraisal text"@x-gmeow-english ;
    skos:definition "The original appraisal words preserved by the runtime, with language and base direction. Keeping or offering them does not fabricate an agent-authored note or endorsement."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record gmeow:distilledText \"Words retained.\"@en ."@x-gmeow-english .

gmeow:distillationFor
    a logic:ObjectProperty ;
    logic:domain gmeow:BodyDistillation ;
    logic:range gmeow:Agent ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "appraisal beneficiary"@x-gmeow-english ;
    skos:definition "The Agent on whose behalf the runtime kept the appraisal. This role does not make that agent the keeper, the runtime standpoint or an endorsing author."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record gmeow:distillationFor ex:value ."@x-gmeow-english .


gmeow:curationManifest
    a logic:ObjectProperty ;
    logic:domain gmeow:CurationEpoch ;
    logic:range gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "curation manifest artifact"@x-gmeow-english ;
    skos:definition "The exact original manifest artifact governing the historically described curation, with its own contentDigest. This reference does not authorize a new operation."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an attributed memory record or its exact source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring endorsement, enforcement, a complete read or a governed store transition from a record alone."@x-gmeow-english ;
    gmeow:howToUse "Keep exact identities, original words and attributed scope; record missing evidence explicitly without inventing defaults."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:record gmeow:curationManifest ex:value ."@x-gmeow-english .

gmeow:epochPredecessor
    a logic:ObjectProperty ;
    logic:domain gmeow:CurationEpoch ;
    logic:range gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
