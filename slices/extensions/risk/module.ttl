@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:Cascade
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "Cascade"@x-gmeow-english ;
    rdfs:subClassOf gmeow:SocialObject ;
    skos:definition "A NAMED chain of causal links — 'Trust Collapse: betrayal dissolves the bond, bond dissolution kills the will to survive.' A social object: the cascade exists as a recognized failure narrative, independent of anything ever occurring. Entered at gmeow:cascadeFirstLink, walked by gmeow:linkNext, graded by gmeow:cascadeSeverity. Acyclic within itself (the gmeow:linkNextAcyclicity axiom, projected to SHACL); propagation arithmetic is solver work (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:CausalLink
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "Causal Link"@x-gmeow-english ;
    logic:mediates gmeow:linkAntecedent ,
        gmeow:linkConsequent ;
    rdfs:subClassOf logic:Relator ,
        gmeow:RiskFactor ;
    skos:definition "A reified type-level causal claim — antecedent kind × consequent kind × modality, with optional mechanism prose and solver-input strength. Mint one when HOW the causation works must be first-class; the 80% case stays flat gmeow:typeCauses (reify-on-demand, Principle 4). Whose claim it is rides the statement layer; two analysts' divergent links coexist (Principle 9)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:CausalModality
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "Causal Modality"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The force of a causal link — an OPEN value vocabulary seeded with necessitates (the antecedent suffices), promotes (raises likelihood), enables (makes possible), prevents (blocks). Distinct from gmeow:standpointModality (doxastic — how firmly a frame believes the link) and from gmeow:hasDeterminacy (ontic): causal modality is what the link CLAIMS about the world's mechanics."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Hazard
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "Hazard"@x-gmeow-english ;
    rdfs:subClassOf logic:Disposition ,
        gmeow:RiskFactor ;
    skos:definition "A bearer's disposition toward harm — manifested, when it manifests at all, as events of a feared type (gmeow:manifestedAsType). A hazard that never manifests is still fully real as a disposition: the first gufo:Disposition use in GMEOW, and the reason this slice needs no counterfactual machinery. The bearer may be anything that can carry a disposition: a system, an agent, a relationship, an artifact."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:Mitigation
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "Mitigation"@x-gmeow-english ;
    logic:mediates gmeow:mitigationMeasure ,
        gmeow:mitigationCounters ;
    rdfs:subClassOf logic:Relator ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:mitigationMeasure ;
            logic:someValuesFrom logic:Thing ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:mitigationCounters ;
            logic:someValuesFrom logic:Thing ;
        ] ;
    skos:definition "A reified countermeasure binding: a measure — a gmeow:Norm that forbids the antecedent conduct, or a logic:Plan that interrupts the chain — set against a causal link or hazard it counters. The measure range stays OPEN because a countermeasure is genuinely heterogeneous: a norm, a plan, and an engineered design control are all measures, and no single class subsumes them without distorting one of the three. The D3FEND countermeasure and bowtie barrier map here at alignment time. Whether a mitigation WORKED is a vantage-indexed claim, never an entailment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:MitigationStatus
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "Mitigation Status"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The lifecycle status of a mitigation — an OPEN value vocabulary seeded with proposed, active, retired. Retirement is suppression-shaped: a retired mitigation is kept with its status, never deleted (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:RiskFactor
    a logic:Category ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "Risk Factor"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Entity ;
    skos:definition "The umbrella category of things a mitigation can be set against — causal links (a bowtie barrier on the chain) and hazards (a control at the source). Exists as a NAMED class so gmeow:mitigationCounters carries a generator-visible range instead of an anonymous union (the IntentionalMoment precedent) and so the relator-arity gate can see the mediation end. Never instantiated directly."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:SeverityLevel
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "Severity Level"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The graded severity of a cascade or hazard — an OPEN, ordered value vocabulary (catastrophic ≻ severe ≻ moderate ≻ minor; deployments add grades — negligible, critical, FMEA 1–10 bands — without schema change, Principle 9), the kernel GranularityLevel pattern (fourth use). gmeow:moreSevereThan is transitive ON LEVELS ONLY. Terminology anchored to ISO 31000 / IEC 60812 in docs, never axioms; what a grade DEMANDS in response is the norms extension's business, plugged in via Mitigation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:cascadeFirstLink
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Cascade ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "cascade first link"@x-gmeow-english ;
    rdfs:range gmeow:CausalLink ;
    skos:definition "The entry link of this cascade. Functional and mandatory (SHACL)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:cascadeSeverity
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Cascade ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "cascade severity"@x-gmeow-english ;
    rdfs:range gmeow:SeverityLevel ;
    skos:definition "The cascade's graded severity — according to whoever grades it (statement-layer indexed). NOT functional design review: grading is evaluative and source-variable; divergent grades coexist through the statement layer, and single-valuedness per base graph is SHACL's job (the hasAuthorityLevel convention). Mandatory: an ungraded cascade is just a story."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:causalModality
    a logic:ObjectProperty ;
    rdfs:domain gmeow:CausalLink ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "causal modality"@x-gmeow-english ;
    rdfs:range gmeow:CausalModality ;
    skos:definition "The force this link claims. Functional and mandatory (SHACL): if you reified, you had a reason — the modality is it. Open vocabulary (sh:nodeKind sh:IRI, never sh:in)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:causallyEnables
    a gmeow:CausalModality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "enables"@x-gmeow-english ;
    skos:definition "The antecedent kind makes the consequent kind possible."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:causallyNecessitates
    a gmeow:CausalModality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "necessitates"@x-gmeow-english ;
    skos:definition "The antecedent kind suffices for the consequent kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:causallyPrevents
    a gmeow:CausalModality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "prevents"@x-gmeow-english ;
    skos:definition "The antecedent kind blocks the consequent kind — the inhibitory reading, reified."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:causallyPromotes
    a gmeow:CausalModality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "promotes"@x-gmeow-english ;
    skos:definition "The antecedent kind raises the likelihood of the consequent kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:hazardBearer
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Hazard ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "hazard bearer"@x-gmeow-english ;
    rdfs:range gmeow:Entity ;
    skos:definition "The entity in which this hazard inheres. Functional and mandatory (SHACL): a disposition has exactly one bearer (gUFO inherence, asserted with GMEOW's own property — Principle 5). The same danger borne by two systems is two hazards."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hazardSeverity
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Hazard ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "hazard severity"@x-gmeow-english ;
    rdfs:range gmeow:SeverityLevel ;
    skos:definition "The hazard's graded severity, when graded standalone (a hazard feeding a cascade usually inherits attention from the cascade's grade). NOT functional (design review — evaluative, source-variable; the hasAuthorityLevel convention); optional, at most one per base graph (SHACL)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:linkAntecedent
    a logic:ObjectProperty ;
    rdfs:domain gmeow:CausalLink ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "link antecedent"@x-gmeow-english ;
    rdfs:range gmeow:EventType ;
    skos:definition "The causing kind. Functional and mandatory (SHACL); distinct from the consequent (the gmeow:causalLinkDistinctness axiom, projected to SHACL — nothing type-causes itself)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:linkConsequent
    a logic:ObjectProperty ;
    rdfs:domain gmeow:CausalLink ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "link consequent"@x-gmeow-english ;
    rdfs:range gmeow:EventType ;
    skos:definition "The caused kind. Functional and mandatory (SHACL)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:linkMechanism
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:CausalLink ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "link mechanism"@x-gmeow-english ;
    skos:definition "How the causation works — prose. NOT functional and range-open (localizable prose, the localizable-prose convention lesson): one mechanism account per language tag."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:linkNext
    a logic:ObjectProperty ;
    rdfs:domain gmeow:CausalLink ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "link next"@x-gmeow-english ;
    rdfs:range gmeow:CausalLink ;
    skos:definition "The next link in a cascade walk. NOT functional (a link may feed branches; a branching failure tree is one cascade entry with diverging walks) and NOT transitive — reachability is solver work. Acyclic (the gmeow:linkNextAcyclicity axiom, projected to SHACL): no link reaches itself through linkNext."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:linkStrength
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:CausalLink ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "link strength"@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    skos:definition "A solver-INPUT weight for this link, on whatever scale the consuming analysis declares. Never a solver output written back as assertion (Principle 12). NOT functional design review: strength estimates are source-variable claims — divergent estimates coexist through the statement layer rather than forcing OWL sameAs collisions; single-valuedness per base graph is the SHACL layer's job (the hasAuthorityLevel convention)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:manifestedAsType
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Hazard ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "manifested as type"@x-gmeow-english ;
    rdfs:range gmeow:EventType ;
    skos:definition "The feared kind of event — what this hazard's manifestation would BE, were it to occur. Range is gmeow:EventType, never gmeow:Event: the type level is where counterfactuals live without machinery. NOT functional, at least one (SHACL): a hazard may threaten several manifestation kinds."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:mitigationActive
    a gmeow:MitigationStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "active"@x-gmeow-english ;
    skos:definition "The mitigation is in force."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:mitigationCounters
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Mitigation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "mitigation counters"@x-gmeow-english ;
    rdfs:range gmeow:RiskFactor ;
    skos:definition "What the measure is set against — a gmeow:RiskFactor: a CausalLink (a bowtie barrier on the chain) or a Hazard (a control at the source). NOT functional, at least one (SHACL)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:mitigationMeasure
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Mitigation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "mitigation measure"@x-gmeow-english ;
    skos:definition "The countermeasure — a gmeow:Norm that forbids the antecedent conduct, a logic:Plan that interrupts the chain, or an engineered design control. The range stays open because those three are genuinely heterogeneous. NOT functional, at least one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:mitigationProposed
    a gmeow:MitigationStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "proposed"@x-gmeow-english ;
    skos:definition "The mitigation is proposed, not yet in force."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:mitigationRetired
    a gmeow:MitigationStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "retired"@x-gmeow-english ;
    skos:definition "The mitigation has been withdrawn — kept with this status, never deleted (Principle 10)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:mitigationStatus
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Mitigation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "mitigation status"@x-gmeow-english ;
    rdfs:range gmeow:MitigationStatus ;
    skos:definition "The mitigation's lifecycle status. NOT functional design review: lifecycle is mutable and source-variable — status-over-time rides validFrom/validUntil on the statement, and single-valuedness per base graph is SHACL's job. Open vocabulary (sh:nodeKind sh:IRI, never sh:in)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:moreSevereThan
    a logic:ObjectProperty ,
        logic:transitiveProperty ;
    rdfs:domain gmeow:SeverityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "more severe than"@x-gmeow-english ;
    rdfs:range gmeow:SeverityLevel ;
    skos:definition "Orders severity levels. Transitive ON LEVELS ONLY (the gmeow:coarserThan / gmeow:strongerThan pattern) — cascades themselves are never ordered transitively."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:severityCatastrophic
    a gmeow:SeverityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "catastrophic"@x-gmeow-english ;
    skos:definition "The catastrophic severity level — the failure that ends the system it grades."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:moreSevereThan gmeow:severitySevere .

gmeow:severityMinor
    a gmeow:SeverityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "minor"@x-gmeow-english ;
    skos:definition "The minor severity level."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:severityModerate
    a gmeow:SeverityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "moderate"@x-gmeow-english ;
    skos:definition "The moderate severity level."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:moreSevereThan gmeow:severityMinor .

gmeow:severitySevere
    a gmeow:SeverityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "severe"@x-gmeow-english ;
    skos:definition "The severe severity level."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:moreSevereThan gmeow:severityModerate .

gmeow:typeCauses
    a logic:ObjectProperty ;
    rdfs:domain gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "type causes"@x-gmeow-english ;
    rdfs:range gmeow:EventType ;
    skos:definition "Flat type-level causal claim: events of the subject kind bring about events of the object kind — according to whoever asserts it (statement-layer indexed, Principle 9). DELIBERATELY NOT TRANSITIVE: chain composition is solver work over recorded links (Principle 12). Promote to a gmeow:CausalLink when modality, mechanism, or strength rides on the claim. Grounds cn:Causes, atomic:Causes, and sumo:causes at alignment time."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:pairsWith gmeow:CausalLink .

gmeow:typeEnables
    a logic:ObjectProperty ;
    rdfs:domain gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "type enables"@x-gmeow-english ;
    rdfs:range gmeow:EventType ;
    skos:definition "Flat type-level enablement: events of the subject kind make events of the object kind possible without bringing them about. NOT transitive; promote to gmeow:CausalLink for the reified form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:typeMitigates
    a logic:ObjectProperty ;
    rdfs:domain gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "type mitigates"@x-gmeow-english ;
    rdfs:range gmeow:EventType ;
    skos:definition "Flat type-level mitigation: events of the subject kind reduce the severity or likelihood of events of the object kind without fully preventing them. NOT transitive."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:typePrevents
    a logic:ObjectProperty ;
    rdfs:domain gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "type prevents"@x-gmeow-english ;
    rdfs:range gmeow:EventType ;
    skos:definition "Flat type-level prevention: events of the subject kind block events of the object kind. NOT transitive. Grounds sumo:prevents at alignment time; the D3FEND countermeasure reading arrives through gmeow:Mitigation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

<https://blackcatinformatics.ca/gmeow/slices/risk>
    a logic:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Hazards, type-level causation, cascades, and mitigations — counterfactual causal structure without counterfactual machinery.

DOCTRINE.
  * THE COUNTERFACTUAL PROBLEM DISSOLVES AT THE TYPE LEVEL: cascades relate event TYPES, never event instances — nothing in this slice asserts that anything occurred, and the no-occurrence gate makes that executable (loading the full fixture set entails zero gmeow:Event instances from this slice's terms). 'Trust betrayal dissolves the bond' is a claim about kinds of events; the catastrophe it warns of need never have happened. PROV lineage and CRM influence are token-level; OBO RO is the rare type-level causation vocabulary — that asymmetry is why this slice exists.
  * CAUSAL LINKS ARE CLAIMS LIKE ANY OTHER: standpoint-indexed and confidence-bearing through the statement layer. Two risk analysts disagreeing about whether T1 promotes T2 are two coexisting claims (Principle 9). Cascade propagation, probability composition, and simulation are solver work over the recorded links (Principle 12); gmeow:linkStrength is solver INPUT, never solver output written back as assertion.
  * FIRST gufo:Disposition USE IN GMEOW: a Hazard is a bearer's disposition toward harm, manifested (when it manifests at all) as events of a feared type. Inherence is asserted with GMEOW's own gmeow:hazardBearer (Principle 5: gufo:inheresIn is the alignment target, not the asserted axiom).
  * MITIGATION CROSSES TO DEONTICS BY OPEN RANGE: a Mitigation binds a measure — a gmeow:Norm that forbids the antecedent conduct, or a logic:Plan that interrupts the chain — to what it counters. The range stays open because countermeasures are genuinely heterogeneous (norm, plan, engineered control), not because a dependency rule forbids naming a class.
  * SEVERITY IS AN ORDERED VOCABULARY (the kernel GranularityLevel pattern — catastrophic ≻ severe ≻ moderate ≻ minor, gmeow:moreSevereThan transitive ON LEVELS ONLY), anchored terminologically to ISO 31000 / IEC 60812 in docs, never in axioms.
  * ALIGNMENTS DEFERRED to the compiler-arc window: OBO RO causal properties (linkage-only, BFO lineage), MITRE D3FEND (countermeasure ↔ Mitigation), STIX 2.1/ATT&CK, UCO, ConceptNet/ATOMIC rows; projections to bowtie JSON, FMEA CSV, STIX bundles each with declared-loss manifests. Target list fixed in the alignment ledger."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    rdfs:label "GMEOW Risk Module"@x-gmeow-english ;
    skos:definition "The GMEOW Risk Module — hazards, type-level causation, cascades, and mitigations."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# Closed-world cardinality/value axioms backing the hand-authored SHACL
# well-formedness shapes.
gmeow:Hazard rdfs:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:hazardBearer ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:manifestedAsType ; logic:minQualifiedCardinality 1 ; logic:onClass gmeow:EventType ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:hazardSeverity ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .

gmeow:Cascade rdfs:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:cascadeFirstLink ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:CausalLink ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:cascadeSeverity ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .

gmeow:Mitigation rdfs:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:mitigationMeasure ; logic:minQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:mitigationCounters ; logic:minQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:mitigationStatus ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .

# exact-one minCount restoration: min-qualified sibling restrictions
# restoring sh:minCount for the reasoner-safe max-qualified exact-one antecedents.
<https://blackcatinformatics.ca/gmeow/Hazard> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/hazardBearer> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/Cascade> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/cascadeFirstLink> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/gmeow/CausalLink> ] .
<https://blackcatinformatics.ca/gmeow/Cascade> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/gmeow/cascadeSeverity> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .

# =========================================================================== #
# Migrated procedural constraints: the closed-world risk well-formedness #
# shapes from shapes/gmeow-shapes.ttl (Principle 17).                            #
# =========================================================================== #

gmeow:HazardBearerConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Hazard bearer-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Hazard inheres in a gmeow:hazardBearer."@x-gmeow-english ;
    logic:onClass gmeow:Hazard ;
    logic:anyOf gmeow:hazardBearer ;
    logic:formalizes gmeow:Hazard ;
    logic:message "A Hazard must inhere in exactly one gmeow:hazardBearer — the same danger borne by two systems is two hazards." .

gmeow:HazardManifestedConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Hazard feared-type-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Hazard names a feared gmeow:manifestedAsType."@x-gmeow-english ;
    logic:onClass gmeow:Hazard ;
    logic:anyOf gmeow:manifestedAsType ;
    logic:formalizes gmeow:Hazard ;
    logic:message "A Hazard must name at least one feared gmeow:manifestedAsType, an EventType — the type level is where counterfactuals live without machinery." .

gmeow:CausalLinkModalityConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "CausalLink modality-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:CausalLink states a gmeow:causalModality."@x-gmeow-english ;
    logic:onClass gmeow:CausalLink ;
    logic:anyOf gmeow:causalModality ;
    logic:formalizes gmeow:CausalLink ;
    logic:message "A CausalLink must state exactly one gmeow:causalModality (an IRI — the vocabulary is OPEN per Principle 9): if you reified, you had a reason." .

gmeow:CascadeSeverityConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Cascade severity-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Cascade carries a gmeow:cascadeSeverity."@x-gmeow-english ;
    logic:onClass gmeow:Cascade ;
    logic:anyOf gmeow:cascadeSeverity ;
    logic:formalizes gmeow:Cascade ;
    logic:message "A Cascade must carry exactly one gmeow:cascadeSeverity (an IRI) — an ungraded cascade is just a story." .

gmeow:MitigationMeasureConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Mitigation measure-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Mitigation binds a gmeow:mitigationMeasure."@x-gmeow-english ;
    logic:onClass gmeow:Mitigation ;
    logic:anyOf gmeow:mitigationMeasure ;
    logic:formalizes gmeow:Mitigation ;
    logic:message "A Mitigation must bind at least one gmeow:mitigationMeasure (an IRI — the range is deliberately open across norms, plans and engineered controls)." .

gmeow:MitigationCountersPresenceConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Mitigation counters-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:Mitigation counters at least one risk factor via gmeow:mitigationCounters."@x-gmeow-english ;
    logic:onClass gmeow:Mitigation ;
    logic:anyOf gmeow:mitigationCounters ;
    logic:formalizes gmeow:Mitigation ;
    logic:message "A Mitigation must counter at least one risk factor — a CausalLink (barrier on the chain) or a Hazard (control at the source). sh:or over the concrete classes, not sh:class RiskFactor: data graphs type instances concretely and raw-graph SHACL does no subclass inference." .

# Every gmeow:mitigationCounters value is a CausalLink OR a Hazard (disjunctive
# value-type — no single-class sugar, so a raw logic:Formula integrity tree).
gmeow:MitigationCountersTypeConstraint
    a logic:Constraint ;
    rdfs:label "Mitigation counters value-type constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/risk> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:mitigationCounters value is a gmeow:CausalLink or a gmeow:Hazard."@x-gmeow-english ;
    logic:formalizes gmeow:MitigationShape ;
    logic:message "A Mitigation must counter at least one risk factor — a CausalLink (barrier on the chain) or a Hazard (control at the source). sh:or over the concrete classes, not sh:class RiskFactor: data graphs type instances concretely and raw-graph SHACL does no subclass inference." ;
    logic:integrity logic:mictForall .
logic:mictForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:mictImpl .
logic:mictImpl a logic:Formula ; logic:antecedent logic:mictGuard ; logic:consequent logic:mictInner .
logic:mictGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Mitigation ] .
logic:mictInner a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "v" ] ;
    logic:forall logic:mictVImpl .
logic:mictVImpl a logic:Formula ; logic:antecedent logic:mictHas ; logic:consequent logic:mictOr .
logic:mictHas a logic:Formula ; logic:relation gmeow:mitigationCounters ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .
logic:mictOr a logic:Formula ; logic:or logic:mictIsLink , logic:mictIsHazard .
logic:mictIsLink a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "v" ] , [ logic:termIndex 1 ; logic:termIri gmeow:CausalLink ] .
logic:mictIsHazard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "v" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Hazard ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/Cascade> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/cascadeFirstLink> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/CausalLink> ] .
<https://blackcatinformatics.ca/gmeow/Cascade> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/cascadeSeverity> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/CausalLink> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/causalModality> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/CausalLink> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/linkAntecedent> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/EventType> ] .
<https://blackcatinformatics.ca/gmeow/CausalLink> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/linkConsequent> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/EventType> ] .
<https://blackcatinformatics.ca/gmeow/CausalLink> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/linkStrength> ; logic:allValuesFrom <http://www.w3.org/2001/XMLSchema#decimal> ] .
<https://blackcatinformatics.ca/gmeow/Hazard> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/hazardBearer> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/Hazard> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/manifestedAsType> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/EventType> ] .
<https://blackcatinformatics.ca/gmeow/Mitigation> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/mitigationCounters> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/gmeow/Mitigation> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/mitigationMeasure> ; logic:allValuesFrom <http://www.w3.org/2002/07/owl#Thing> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Cascade> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/cascadeFirstLink" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Cascade> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/cascadeSeverity" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/CausalLink> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/causalModality" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/CausalLink> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/linkAntecedent" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/CausalLink> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/linkConsequent" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Hazard> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/hazardBearer" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
