#
# Single violation: a math:NormalizationDeclaration held at math:structuralNormalization
# whose math:normalizes source and math:normalizesTo target carry DIFFERENT
# math:structuralKey values — a false structural-identity claim
# (math:FalseStructuralNormalizationClaim). The declaration correctly names the SAME pair
# as the math:normalForm edge, so math:UndeclaredNormalForm stays silent, and the strength
# IS structural, so math:UnattributedNormalization's coarser-than-structural guard never
# fires. Both expressions carry a math:literalValue structured child so the
# math:normalForm trigger does not ALSO fire math:StringOnlyComputableExpression — this
# fixture isolates the ONE false-structural-normalization-claim class.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

ex:mismatchedSource a math:MathematicalExpression ;
    math:normalForm ex:mismatchedTarget ;
    math:structuralKey "key-a" ;
    math:literalValue "4"^^xsd:integer .

ex:mismatchedTarget a math:MathematicalExpression ;
    math:structuralKey "key-b" ;
    math:literalValue "5"^^xsd:integer .

ex:mismatchedDecl a math:NormalizationDeclaration ;
    math:normalizes ex:mismatchedSource ;
    math:normalizesTo ex:mismatchedTarget ;
    math:normalizationStrength math:structuralNormalization .
