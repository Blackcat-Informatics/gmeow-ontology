    gmeow:confidence 0.55 ; gmeow:comment "free-access flag relates to the DC access-rights statement (boolean vs. policy text)" ;
    gmeow:sssomFile "gmeow-rights.sssom.tsv" .

gmeow:eqRights068 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:copyrightNotice ; gmeow:alignPredicate skos:relatedMatch ;
