@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:ReadingScope
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Reading Scope"@x-gmeow-english ;
    skos:definition "An attributed enumeration of the exact source records offered to a selected refiner, with their declared assertion-time chronology frame. It asserts no completeness of the surrounding store."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:scope a gmeow:ReadingScope ."@x-gmeow-english .

gmeow:scopeRecord
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "scope record"@x-gmeow-english ;
    skos:definition "A source record offered within a reading scope, including a record later reported unreadable. Members retain their actual RDF identities, including blank nodes or triple terms when supplied."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:scope gmeow:scopeRecord ex:record ."@x-gmeow-english .

gmeow:scopeChronology
    a logic:ObjectProperty ;
    logic:range gmeow:TemporalFrame ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "scope chronology"@x-gmeow-english ;
    skos:definition "The temporal frame in which source assertion times are interpreted for this scope’s chronology. The selected reading must respect original precision and unresolved ties; this relation does not manufacture an order."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:scope gmeow:scopeChronology gmeow:temporalFrameUTCGregorian ."@x-gmeow-english .

gmeow:readingScope
    a logic:ObjectProperty ;
    logic:range gmeow:ReadingScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reading scope"@x-gmeow-english ;
    skos:definition "The explicit source-record scope of a finding or reading-limit aggregate. This relation does not turn its subject into an Observation or claim global source coverage."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:readingScope ex:scope ."@x-gmeow-english .

gmeow:FirstOccurrence
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:Refinement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "First Occurrence"@x-gmeow-english ;
    skos:definition "A selected refiner’s reading of an earliest source record for one relation and referent among the records explicitly offered in its reading scope, under the declared source assertion-time chronology. It is not a global first or the subject’s assertion."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:first a gmeow:FirstOccurrence ."@x-gmeow-english .

gmeow:RelationOccasion
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:Refinement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Relation Occasion"@x-gmeow-english ;
    skos:definition "A selected refiner’s reading of one occasion of a relation to a resource or source-named referent in its declared records-read scope. It records source evidence rather than an independent world event."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:occasion a gmeow:RelationOccasion ."@x-gmeow-english .

gmeow:relationPredicate
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "relation predicate"@x-gmeow-english ;
    skos:definition "The actual predicate IRI by which the source records relate to the referent. It names the source relation without asserting a new edge or evaluating a query."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relationPredicate gmeow:hasParticipant ."@x-gmeow-english .

gmeow:relationVault
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "relation vault"@x-gmeow-english ;
    skos:definition "The source store containing the records for this relation reading or reading-limit aggregate. Naming the store supplies neither access authority nor a claim that every store record was read."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relationVault ex:archive ."@x-gmeow-english .

gmeow:relatedThing
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "related thing"@x-gmeow-english ;
    skos:definition "The referent identified by its actual IRI in the source relation. The IRI is retained without inferring identity from a name or minting a replacement for an unshareable source term."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relatedThing ex:person ."@x-gmeow-english .

gmeow:relatedName
    a logic:DatatypeProperty ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:string rdf:langString rdf:dirLangString ) ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "related name"@x-gmeow-english ;
    skos:definition "The exact source-supplied name when a relation names its referent only by a literal. Language and base direction are retained when supplied; the name alone does not establish an IRI identity."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relatedName \"Visitor\"@en ."@x-gmeow-english .

gmeow:relationAt
    a logic:DatatypeProperty ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "relation assertion time"@x-gmeow-english ;
    skos:definition "The original assertion-time value supplied by the source record, retained at its actual precision. It is neither the refiner’s observation clock nor the record’s transaction time; a date, month or year invents no instant or timezone."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relationAt \"2026-10\"^^xsd:gYearMonth ."@x-gmeow-english .

gmeow:relationIn
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "relation source occasion"@x-gmeow-english ;
    skos:definition "The source occasion or context in which the relation was found, such as a conversation. This is distinct from the refiner’s execution and from its derived RelationOccasion reading."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relationIn ex:conversation ."@x-gmeow-english .

gmeow:findingSummary
    a logic:DatatypeProperty ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( rdf:langString rdf:dirLangString ) ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "finding summary"@x-gmeow-english ;
    skos:definition "A language-bearing one-line account of what the refiner found under its own vantage. The wording retains its language and any base direction and does not become the source subject’s claim."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:findingSummary \"Earliest in the supplied archive excerpt.\"@en ."@x-gmeow-english .

gmeow:Milestone
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Milestone"@x-gmeow-english ;
    skos:definition "An attributed information annotation in which a teller reads a source record as marking a milestone. It is distinct from the underlying life event and never automatically the subject’s own claim."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:annotation a gmeow:Milestone ."@x-gmeow-english .

gmeow:MilestoneKind
    a logic:Class, logic:AbstractIndividualType ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Milestone Kind"@x-gmeow-english ;
    skos:definition "An open quality-value vocabulary of teller-defined milestone classifications. Consumers mint their own individuals; no classification is a diagnosis or an event type inferred from the source."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:localKind a gmeow:MilestoneKind ."@x-gmeow-english .

gmeow:milestoneKind
    a logic:ObjectProperty ;
    logic:range gmeow:MilestoneKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "milestone kind"@x-gmeow-english ;
    skos:definition "The teller’s classification of a milestone annotation, drawn from the open MilestoneKind vocabulary."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:annotation gmeow:milestoneKind ex:localKind ."@x-gmeow-english .

gmeow:milestoneOf
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "milestone source"@x-gmeow-english ;
    skos:definition "The original record on which the teller’s milestone annotation rests. This link identifies evidence rather than declaring that the record itself is a life event."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:annotation gmeow:milestoneOf ex:record ."@x-gmeow-english .

gmeow:ReadingLimit
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:QueryLossLedger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Reading Limit"@x-gmeow-english ;
    skos:definition "An attributed QueryLossLedger grouping records the selected refiner could not read for one relation, store, source scope and reason. Its reported count may be zero; actual excluded records retain separate QueryLoss identities through ledgerLoss."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:limit a gmeow:ReadingLimit ."@x-gmeow-english .

gmeow:ReadingLimitReason
    a logic:Class, logic:AbstractIndividualType ;
    logic:subClassOf gmeow:QueryLossCause ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Reading Limit Reason"@x-gmeow-english ;
    skos:definition "An open specialization of QueryLossCause for limitations of a selected refiner and input scope. A reason describes that operation’s capability boundary, never an RDF 1.2 prohibition."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:localReason a gmeow:ReadingLimitReason ."@x-gmeow-english .

gmeow:limitReason
    a logic:ObjectProperty ;
    logic:range gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "limit reason"@x-gmeow-english ;
    skos:definition "The selected refiner limitation grouping this aggregate’s excluded records. Each referenced actual loss retains this same reason through lossCause."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:limit gmeow:limitReason gmeow:limitNoAssertionTime ."@x-gmeow-english .

gmeow:limitCount
    a logic:DatatypeProperty ;
    logic:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "limit count"@x-gmeow-english ;
    skos:definition "The reported number of distinct source records excluded for this aggregate’s single reason and scope. Zero records no actual loss; the count is a source report whose exact arithmetic is not certified by the ontology."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:limit gmeow:limitCount \"0\"^^xsd:nonNegativeInteger ."@x-gmeow-english .

gmeow:limitNoAssertionTime
    a gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "no usable assertion time"@x-gmeow-english ;
    skos:definition "The selected refiner could not order this record because the input supplied no usable assertion time. It does not authorize substituting a refiner clock or inventing precision."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:loss gmeow:lossCause gmeow:limitNoAssertionTime ."@x-gmeow-english .

gmeow:limitRecordUnnameable
    a gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "record unnameable to refiner"@x-gmeow-english ;
    skos:definition "The selected refiner’s addressing contract could not retain a supplied blank-node record as a named record. RDF 1.2 can retain blank nodes; this is a limitation of the selected operation."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:loss gmeow:lossCause gmeow:limitRecordUnnameable ."@x-gmeow-english .

gmeow:limitThingUnshareable
    a gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "referent unshareable to refiner"@x-gmeow-english ;
    skos:definition "The selected refiner could not correlate a supplied blank-node or triple-term referent across records under its addressing contract. This neither bans those RDF 1.2 terms nor proves that no relation or shared referent exists."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:loss gmeow:lossCause gmeow:limitThingUnshareable ."@x-gmeow-english .

gmeow:limitCueSuppressed
    a gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "cue match suppressed"@x-gmeow-english ;
    skos:definition "The selected reading reports that a cue matched words it read, but a negating cue within the declared negation scope suppressed that match from counting as cue evidence. The match and its source remain retained; suppression does not establish a negative verdict about the source subject."@x-gmeow-english ;
    gmeow:useWhen "Use when an actual in-scope negating cue suppressed an otherwise detected match under the selected reading's declared negation rule."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using suppression for words the cue never read, for a failed grounding attempt, or as permission to delete the match or source."@x-gmeow-english ;
    gmeow:howToUse "Retain the original match and the negating evidence with its declared scope and reading attribution. Use this reason on a QueryLoss through lossCause; an aggregate uses limitReason only for source records actually excluded from that selected reading."@x-gmeow-english ;
    skos:scopeNote "This reason records a scoped suppression decision, not absence of a match. Several suppressed matches in one record do not become several excluded source records, and a retained contribution elsewhere in that record is not silently erased."@x-gmeow-english ;
    skos:example "A reading detects an affirmation and its scoped negating cue, retains both, and reports the uncounted match. If the source record is excluded for this reason, ex:loss gmeow:lossCause gmeow:limitCueSuppressed ; gmeow:lossConcerns ex:record . identifies that record's loss rather than a match count."@x-gmeow-english .

gmeow:limitCueUngrounded
    a gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "cue match ungrounded"@x-gmeow-english ;
    skos:definition "The selected reading reports that a cue matched words it read, but the cue's declared grounding rules did not establish the match as grounded. The detected match remains evidence of detection, not a counted cue contribution or a verdict about the person whose words were read."@x-gmeow-english ;
    gmeow:useWhen "Use when the selected reading evaluated the declared grounding rules for a detected match and did not obtain the required grounding."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using an ungrounded result to conceal missing rules, an evaluation that never ran, or an execution failure; those do not establish the reported grounding outcome."@x-gmeow-english ;
    gmeow:howToUse "Keep the detected match, the declared rule set and the supplied facts supporting the reading's reported outcome. Retain attribution independently of source authorship, and use lossCause for any actual source-record loss."@x-gmeow-english ;
    skos:scopeNote "Non-grounding is distinct from negation suppression and speaker or field exclusion. It reports the selected rule evaluation's outcome without converting an uncounted cue into evidence that the interpreted claim is false."@x-gmeow-english ;
    skos:example "A detected phrase lacks the record facts required by its evaluated grounding rules. The reading retains the phrase and rule outcome; ex:loss gmeow:lossCause gmeow:limitCueUngrounded ; gmeow:lossConcerns ex:record . can retain an actual excluded-record loss."@x-gmeow-english .

gmeow:limitCueUnread
    a gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "supplied words unread by cue"@x-gmeow-english ;
    skos:definition "The selected reading was offered words that a cue it uses does not read because those words belong to another speaker or another property under the cue's declared selection. This reason records excluded reading input, not a failed match search or proof that the words contain no cue."@x-gmeow-english ;
    gmeow:useWhen "Use when offered source words fall outside the cue's declared speaker or field selection."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating unread words as searched with no matches, as suppressed matches, or as a negative finding about their author."@x-gmeow-english ;
    gmeow:howToUse "Retain the offered source record and the selected speaker or field restriction. Attribute the exclusion to the reading, preserve the input through scopeRecord, and attach any actual record loss through ledgerLoss with this lossCause."@x-gmeow-english ;
    skos:scopeNote "The words remain in the offered input scope even though the selected cue does not read them. Another cue or reading may legitimately read them; this reason neither removes access nor changes their authorship."@x-gmeow-english ;
    skos:example "A cue selected for a speaker's answer field does not read the quoted words of another speaker in a different field. If this excludes the source record from the selected reading, ex:loss gmeow:lossCause gmeow:limitCueUnread ; gmeow:lossConcerns ex:record . preserves the reason."@x-gmeow-english .

gmeow:scopeRecord logic:domain gmeow:ReadingScope .
gmeow:scopeChronology logic:domain gmeow:ReadingScope .
gmeow:milestoneKind logic:domain gmeow:Milestone .
gmeow:milestoneOf logic:domain gmeow:Milestone .
gmeow:limitReason logic:domain gmeow:ReadingLimit .
gmeow:limitCount logic:domain gmeow:ReadingLimit .
gmeow:milestoneOf logic:subPropertyOf gmeow:wasDerivedFrom .
gmeow:scopeChronology logic:subPropertyOf gmeow:hasReferenceFrame .


gmeow:ReadingScope logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:scopeChronology ; logic:allValuesFrom gmeow:TemporalFrame ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingScope ; logic:closureKey "https://blackcatinformatics.ca/gmeow/scopeChronology" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:FirstOccurrence logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:allValuesFrom gmeow:ReadingScope ],
    [ a logic:Restriction ; logic:onProperty gmeow:observedFeature ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:vantage ; logic:allValuesFrom gmeow:Entity ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationPredicate ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationVault ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationAt ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FirstOccurrence ; logic:closureKey "https://blackcatinformatics.ca/gmeow/readingScope" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FirstOccurrence ; logic:closureKey "https://blackcatinformatics.ca/gmeow/observedFeature" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FirstOccurrence ; logic:closureKey "https://blackcatinformatics.ca/gmeow/vantage" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FirstOccurrence ; logic:closureKey "https://blackcatinformatics.ca/gmeow/relationPredicate" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FirstOccurrence ; logic:closureKey "https://blackcatinformatics.ca/gmeow/relationVault" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FirstOccurrence ; logic:closureKey "https://blackcatinformatics.ca/gmeow/relationAt" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:RelationOccasion logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:allValuesFrom gmeow:ReadingScope ],
    [ a logic:Restriction ; logic:onProperty gmeow:observedFeature ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:vantage ; logic:allValuesFrom gmeow:Entity ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationPredicate ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationVault ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationAt ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RelationOccasion ; logic:closureKey "https://blackcatinformatics.ca/gmeow/readingScope" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RelationOccasion ; logic:closureKey "https://blackcatinformatics.ca/gmeow/observedFeature" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RelationOccasion ; logic:closureKey "https://blackcatinformatics.ca/gmeow/vantage" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RelationOccasion ; logic:closureKey "https://blackcatinformatics.ca/gmeow/relationPredicate" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RelationOccasion ; logic:closureKey "https://blackcatinformatics.ca/gmeow/relationVault" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RelationOccasion ; logic:closureKey "https://blackcatinformatics.ca/gmeow/relationAt" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:Milestone logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:milestoneKind ; logic:allValuesFrom gmeow:MilestoneKind ],
    [ a logic:Restriction ; logic:onProperty gmeow:milestoneOf ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:wasAttributedTo ; logic:allValuesFrom gmeow:Agent ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Milestone ; logic:closureKey "https://blackcatinformatics.ca/gmeow/milestoneKind" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Milestone ; logic:closureKey "https://blackcatinformatics.ca/gmeow/milestoneOf" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Milestone ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasAttributedTo" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:ReadingLimit logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:allValuesFrom gmeow:ReadingScope ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationPredicate ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationVault ; logic:allValuesFrom logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:limitReason ; logic:allValuesFrom gmeow:ReadingLimitReason ],
    [ a logic:Restriction ; logic:onProperty gmeow:limitCount ; logic:allValuesFrom xsd:nonNegativeInteger ],
    [ a logic:Restriction ; logic:onProperty gmeow:wasAttributedTo ; logic:allValuesFrom gmeow:Agent ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingLimit ; logic:closureKey "https://blackcatinformatics.ca/gmeow/readingScope" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingLimit ; logic:closureKey "https://blackcatinformatics.ca/gmeow/relationPredicate" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingLimit ; logic:closureKey "https://blackcatinformatics.ca/gmeow/relationVault" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingLimit ; logic:closureKey "https://blackcatinformatics.ca/gmeow/limitReason" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingLimit ; logic:closureKey "https://blackcatinformatics.ca/gmeow/limitCount" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ReadingLimit ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasAttributedTo" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:ReadingSourceScopeConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "reading source scope constraint"@x-gmeow-english ;
    skos:definition "Every source observed by a first-occurrence or relation-occasion reading belongs to each explicitly declared reading scope of that reading."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:ReadingSourceScopeConstraint logic:formalizes gmeow:readingScope ."@x-gmeow-english ;
    logic:formalizes gmeow:readingScope ;
    logic:message "Every source observed by a first-occurrence or relation-occasion reading belongs to each explicitly declared reading scope of that reading." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "scope" ], [ logic:termIndex 2 ; logic:termVariable "record" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:or [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:FirstOccurrence ] ], [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:RelationOccasion ] ] ], [ a logic:Formula ; logic:relation gmeow:readingScope ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "scope" ] ], [ a logic:Formula ; logic:relation gmeow:observedFeature ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation gmeow:scopeRecord ; logic:argument [ logic:termIndex 0 ; logic:termVariable "scope" ], [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] .

gmeow:LimitMemberScopeCauseConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "limit member scope and cause constraint"@x-gmeow-english ;
    skos:definition "Each actual loss included in a reading-limit aggregate retains its aggregate reason and concerns a record offered in the declared input scope."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:LimitMemberScopeCauseConstraint logic:formalizes gmeow:ledgerLoss ."@x-gmeow-english ;
    logic:formalizes gmeow:ledgerLoss ;
    logic:message "Each actual loss included in a reading-limit aggregate retains its aggregate reason and concerns a record offered in the declared input scope." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "loss" ], [ logic:termIndex 2 ; logic:termVariable "scope" ], [ logic:termIndex 3 ; logic:termVariable "reason" ], [ logic:termIndex 4 ; logic:termVariable "record" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:ReadingLimit ] ], [ a logic:Formula ; logic:relation gmeow:ledgerLoss ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "loss" ] ], [ a logic:Formula ; logic:relation gmeow:readingScope ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "scope" ] ], [ a logic:Formula ; logic:relation gmeow:limitReason ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "reason" ] ], [ a logic:Formula ; logic:relation gmeow:lossConcerns ; logic:argument [ logic:termIndex 0 ; logic:termVariable "loss" ], [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:lossCause ; logic:argument [ logic:termIndex 0 ; logic:termVariable "loss" ], [ logic:termIndex 1 ; logic:termVariable "reason" ] ], [ a logic:Formula ; logic:relation gmeow:scopeRecord ; logic:argument [ logic:termIndex 0 ; logic:termVariable "scope" ], [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] ] .

gmeow:ZeroReadingLimitEmptyConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "zero reading limit empty constraint"@x-gmeow-english ;
    skos:definition "A reading-limit aggregate reporting zero excluded records contains no actual ledgerLoss member. It remains an aggregate report rather than a fabricated loss."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:ZeroReadingLimitEmptyConstraint logic:formalizes gmeow:limitCount ."@x-gmeow-english ;
    logic:formalizes gmeow:limitCount ;
    logic:message "A reading-limit aggregate reporting zero excluded records contains no actual ledgerLoss member. It remains an aggregate report rather than a fabricated loss." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "count" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:ReadingLimit ] ], [ a logic:Formula ; logic:relation gmeow:limitCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "count" ] ], [ a logic:Formula ; logic:relation logic:termLessEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "count" ], [ logic:termIndex 1 ; logic:termLiteral "0" ; logic:termLiteralDatatype xsd:integer ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "loss" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:ledgerLoss ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "loss" ] ] ] ] ] ] .

gmeow:PositiveReadingLimitEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "positive reading limit evidence constraint"@x-gmeow-english ;
    skos:definition "A reading-limit aggregate reporting a positive excluded-record count retains actual loss evidence rather than silently omitting all excluded records. Exact count arithmetic remains the reporting refiner’s responsibility."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:PositiveReadingLimitEvidenceConstraint logic:formalizes gmeow:limitCount ."@x-gmeow-english ;
    logic:formalizes gmeow:limitCount ;
    logic:message "A reading-limit aggregate reporting a positive excluded-record count retains actual loss evidence rather than silently omitting all excluded records. Exact count arithmetic remains the reporting refiner’s responsibility." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "count" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:ReadingLimit ] ], [ a logic:Formula ; logic:relation gmeow:limitCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "count" ] ], [ a logic:Formula ; logic:relation logic:termGreater ; logic:argument [ logic:termIndex 0 ; logic:termVariable "count" ], [ logic:termIndex 1 ; logic:termLiteral "0" ; logic:termLiteralDatatype xsd:integer ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "loss" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:ledgerLoss ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "loss" ] ] ] ] ] .

gmeow:ReadingScope logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:scopeChronology ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ] .

gmeow:FirstOccurrence logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationPredicate ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationVault ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationAt ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] ] .

gmeow:RelationOccasion logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationPredicate ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationVault ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationAt ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] ] .

gmeow:ReadingLimit logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:readingScope ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationPredicate ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:relationVault ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:limitReason ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ],
    [ a logic:Restriction ; logic:onProperty gmeow:limitCount ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange xsd:nonNegativeInteger ] .

gmeow:FirstOccurrenceReferentConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "first-occurrence referent presence constraint"@x-gmeow-english ;
    skos:definition "Each first-occurrence reading supplies a related resource or an original source name, without inventing identity from the name."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:FirstOccurrenceReferentConstraint logic:formalizes gmeow:FirstOccurrence ."@x-gmeow-english ;
    logic:formalizes gmeow:FirstOccurrence ;
    logic:message "Each first-occurrence reading supplies a related resource or an original source name, without inventing identity from the name." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:FirstOccurrence ] ] ;
            logic:consequent [ a logic:Formula ; logic:or [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "referent" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:relatedThing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "referent" ] ] ], [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "name" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:relatedName ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "name" ] ] ] ] ] ] .

gmeow:RelationOccasionReferentConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "relation-occasion referent presence constraint"@x-gmeow-english ;
    skos:definition "Each relation-occasion reading supplies a related resource or an original source name, without inventing identity from the name."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
