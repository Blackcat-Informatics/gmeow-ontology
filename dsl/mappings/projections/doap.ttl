gmeow:mapDoapProgrammingLanguage a gmeow:ProjectionMapping ;
    rdfs:label "programmingLanguage → doap:programming-language (label)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "dplProj" ; gmeow:value "dplLabel" ;
        gmeow:atom (
            [ gmeow:subjectVar "dplProj" ; gmeow:predicate gmeow:programmingLanguage ; gmeow:objectVar "dplLang" ]
