    gmeow:subEventOf ex:episode .

ex:checkpointResponse a gmeow:Event ;
    gmeow:eventType gmeow:eventTypeTraceCheckpointResponse ;
    gmeow:subEventOf ex:episode .

ex:checkpointValidation a gmeow:Event ;
    gmeow:eventType gmeow:eventTypeTraceCheckpointValidation ;
