@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# =========================================================================== #
# Build-DAG well-formedness: every stage carries exactly one kind and exactly  #
# one stageImpl, every gmeow:requiresResource target is a gmeow:Resource, and   #
# every pipeline holds at least one stage — closed-world cardinality the        #
# executor relies on before scheduling (the acyclicity / single-Sink / resource #
# -agreement invariants are enforced in the Rust loader, which reads across the #
# whole graph).                                                                 #
# =========================================================================== #

gmeow:PipelineStageShape
    a sh:NodeShape ;
    rdfs:label "Pipeline stage well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:PipelineStage: exactly one gmeow:stageKind (a gmeow:StageKind), exactly one xsd:string gmeow:stageImpl, and every gmeow:requiresResource target a gmeow:Resource, so the gmeow-pipeline loader can bind and schedule every stage without holes."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    sh:targetClass gmeow:PipelineStage ;
    sh:property [
        sh:path gmeow:stageKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:StageKind ;
        sh:severity sh:Violation ;
        sh:message "A PipelineStage must carry exactly one gmeow:stageKind (a gmeow:StageKind)." ;
    ] ;
    sh:property [
        sh:path gmeow:stageImpl ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A PipelineStage must carry exactly one xsd:string gmeow:stageImpl (the STAGE_REGISTRY key)." ;
    ] ;
    sh:property [
        sh:path gmeow:requiresResource ;
        sh:class gmeow:Resource ;
        sh:severity sh:Violation ;
        sh:message "Every gmeow:requiresResource target must be a gmeow:Resource." ;
    ] ;
    sh:property [
        sh:path gmeow:dataflowConsumes ;
        sh:class gmeow:PipelineStage ;
        sh:severity sh:Violation ;
        sh:message "Every gmeow:dataflowConsumes target must be a gmeow:PipelineStage." ;
    ] .

gmeow:PipelineShape
    a sh:NodeShape ;
    rdfs:label "Pipeline well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:Pipeline: at least one gmeow:hasStage member (a gmeow:PipelineStage), so a pipeline names a non-empty stage set for the executor to validate and schedule."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    sh:targetClass gmeow:Pipeline ;
    sh:property [
        sh:path gmeow:hasStage ;
        sh:minCount 1 ;
        sh:class gmeow:PipelineStage ;
        sh:severity sh:Violation ;
        sh:message "A Pipeline must hold at least one gmeow:hasStage member (a gmeow:PipelineStage)." ;
    ] .
