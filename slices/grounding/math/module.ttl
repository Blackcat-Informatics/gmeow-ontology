<https://blackcatinformatics.ca/math/FlagshipScenario> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/math/guardedByCounterExample> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onDataRange> <http://www.w3.org/2001/XMLSchema#string> ] .
<https://blackcatinformatics.ca/math/FlagshipScenario> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/math/enforcesFailureClass> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .

# A math:SetBuilderExpression's math:memberCondition must be a resource denoting a
# logic: formula (a blank node or IRI), not an opaque literal string (a path node-kind
# constraint).
math:SetBuilderMemberConditionNodeKindConstraint
    a logic:PathNodeKindConstraint ;
    logic:onClass math:SetBuilderExpression ;
    logic:valuePath math:memberCondition ;
    logic:nodeKind "BlankNodeOrIRI" ;
    logic:formalizes math:SetBuilderExpression ;
    logic:message "A math:SetBuilderExpression must name its math:memberCondition as a resource denoting a logic: formula (a blank node or IRI), not an opaque literal string." .

# No two distinct math:argumentSlot cells of the same parent may share the same
# math:slotIndex — a duplicate index makes operand order ambiguous (a self-join
# uniqueness constraint over subjects of math:argumentSlot).
math:ArgumentSlotIndexUniquenessConstraint
    a logic:SelfJoinUniquenessConstraint ;
    logic:siblingPredicate math:argumentSlot ;
    logic:sharedPredicate math:slotIndex ;
    logic:formalizes math:SlotIndexUniquenessShape ;
    logic:message "No two distinct math:argumentSlot cells of the same parent may share the same math:slotIndex; a duplicate index makes operand order ambiguous." .

# A math:FormalVerificationResult must be grounded in an observation that names it through
# gmeow:observationResult — an ungrounded verification result is ill-formed (an inverse-existence
# constraint: the result must be the gmeow:observationResult of some subject).
math:FormalVerificationResultGroundingConstraint
    a logic:InverseExistenceConstraint ;
    logic:onClass math:FormalVerificationResult ;
    logic:inversePredicate gmeow:observationResult ;
    logic:formalizes math:FormalVerificationResult ;
    logic:message "A math:FormalVerificationResult must be the gmeow:observationResult of some observation; an ungrounded verification result is ill-formed." .

# A math:FlagshipScenario's math:enforcesFailureClass must name a class that transitively
# rdfs:subClassOf the conformance-failure root — a transitive reachability constraint.
math:FlagshipScenarioFailureClassConstraint
    a logic:TransitiveReachabilityConstraint ;
    logic:onClass math:FlagshipScenario ;
    logic:viaPredicate math:enforcesFailureClass ;
    logic:pathPredicate rdfs:subClassOf ;
    logic:reachTarget math:MathConformanceFailure ;
    logic:formalizes math:FlagshipScenario ;
    logic:message "A math:FlagshipScenario's math:enforcesFailureClass must transitively rdfs:subClassOf math:MathConformanceFailure; a scenario that enforces a non-failure class is ill-formed." .

# A math:Set is given extensionally (math:hasElement) or intensionally
# (math:memberCondition), not silently both without a declared equality: a node
# carrying BOTH has an ambiguous extent (a choice-group at-most-one over the two
# extent predicates — the two must not both be present).
math:SetExtentDisjointConstraint
    a logic:ChoiceGroupConstraint ;
    logic:onClass math:Set ;
    logic:choicePredicate math:hasElement , math:memberCondition ;
    logic:choiceMode "at-most-one" ;
    logic:formalizes math:Set ;
    logic:message "A math:Set must be extensional or intensional, not both: a node carrying both math:hasElement and math:memberCondition without a declared equality has an ambiguous extent (math:AmbiguousSetExtent)." .

# A math:DimensionExponent's math:exponentDenominator must be non-zero: a zero
# denominator is not a rational power (a forbidden pinned-value pattern — the
# focus must not carry math:exponentDenominator 0).
math:DimensionExponentDenominatorNonZeroConstraint
    a logic:ForbiddenPatternConstraint ;
    logic:onClass math:DimensionExponent ;
    logic:forbiddenPredicate math:exponentDenominator ;
    logic:forbiddenValue "0"^^xsd:integer ;
    logic:formalizes math:DimensionExponent ;
    logic:message "A math:DimensionExponent must declare a non-zero integer math:exponentDenominator; a zero denominator is not a rational power (math:MalformedDimension)." .

# A math:Homomorphism's math:preservationLaw must be a resource denoting a logic:
# formula (a blank node or IRI), not an opaque literal string (a path node-kind
# constraint).
math:PreservationLawNodeKindConstraint
    a logic:PathNodeKindConstraint ;
    logic:onClass math:Homomorphism ;
    logic:valuePath math:preservationLaw ;
    logic:nodeKind "BlankNodeOrIRI" ;
    logic:formalizes math:Homomorphism ;
    logic:message "A math:Homomorphism must name its math:preservationLaw as a resource denoting a logic: formula, not an opaque literal string (math:StringOnlyPreservationLaw)." .

# =========================================================================== #
# Procedural constraints authored as raw logic:Formula integrity trees — the   #
# compound closed-world checks whose violation is a finding, lowered to a       #
# sh:SPARQLConstraint. Each carries logic:formalizes so its projected twin      #
# keys onto the same domain source-term as the hand-authored SHACL it replaces. #
# =========================================================================== #

# A math:Theorem must be warranted by either an in-graph math:Proof (some
# resource math:provesStatement it) or a declared math:externalWarrant; a
# theorem asserted with neither is an unwarranted truth-bit claim. The proof arm
# is an inverse existence and the warrant arm a direct one, joined by a
# disjunction — beyond any single sugar, so authored as a raw formula.
math:TheoremWarrantConstraint
    a logic:Constraint ;
    rdfs:label "Theorem warrant constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a math:Theorem must be warranted by an in-graph math:Proof that math:provesStatement it, or by a declared math:externalWarrant; a theorem with neither is an ungrounded truth-bit claim."@x-gmeow-english ;
    logic:formalizes math:Theorem ;
    logic:message "A math:Theorem must be warranted by either an in-graph math:Proof (some resource math:provesStatement it) or a declared math:externalWarrant; a theorem asserted with neither is an unwarranted truth-bit claim (math:UngroundedTheoremClaim)." ;
    logic:integrity math:twForall .
math:twForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:twImpl .
math:twImpl a logic:Formula ; logic:antecedent math:twGuard ; logic:consequent math:twOr .
math:twGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:Theorem ] .
math:twOr a logic:Formula ; logic:or math:twProof , math:twWarrant .
math:twProof a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] ;
    logic:exists math:twProofAtom .
math:twProofAtom a logic:Formula ; logic:relation math:provesStatement ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
math:twWarrant a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "w" ] ;
    logic:exists math:twWarrantAtom .
math:twWarrantAtom a logic:Formula ; logic:relation math:externalWarrant ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "w" ] .

# A math:Chart's math:targetCoordinateSpace has the same math:spaceDimension as
# its manifold's math:manifoldDimension; a chart into a wrong-dimensional space is
# a math:DimensionMismatch. A cross-node numeric inequality — a raw formula.
math:ChartDimensionMatchConstraint
    a logic:Constraint ;
    rdfs:label "Chart dimension-match constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a math:Chart's target coordinate space dimension equals its manifold's dimension."@x-gmeow-english ;
    logic:formalizes math:Chart ;
    logic:message "A math:Chart's target coordinate space dimension does not equal its manifold's dimension (math:DimensionMismatch)." ;
    logic:integrity math:cdForall .
math:cdForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:cdImpl .
math:cdImpl a logic:Formula ; logic:antecedent math:cdGuard ; logic:consequent math:cdNot .
math:cdGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:Chart ] .
math:cdNot a logic:Formula ; logic:not math:cdExists .
math:cdExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "m" ] ,
                             [ logic:termIndex 1 ; logic:termVariable "md" ] ,
                             [ logic:termIndex 2 ; logic:termVariable "t" ] ,
