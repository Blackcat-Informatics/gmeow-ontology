    skos:definition "The class-scoped closed-world authority requiring every lang:TranslationUnit to carry lang:translationCorrespondence; its paired universal restriction fixes the value type."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:onClass lang:TranslationUnit ;
    logic:closureKey "https://blackcatinformatics.ca/lang/translationCorrespondence" ;
    logic:closureValue logic:ClosedWorldClosure .

lang:translationMethodClosure
    a logic:ClosureEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "translation method closure"@x-gmeow-english ;
    skos:definition "The class-scoped closed-world authority requiring every lang:TranslationUnit to carry lang:translationMethod; its paired universal restriction fixes the value type."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:onClass lang:TranslationUnit ;
    logic:closureKey "https://blackcatinformatics.ca/lang/translationMethod" ;
    logic:closureValue logic:ClosedWorldClosure .

lang:paraphraseSamenessClosure
    a logic:ClosureEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "paraphrase sameness closure"@x-gmeow-english ;
    skos:definition "The class-scoped closed-world authority requiring every lang:Paraphrase to carry lang:paraphraseSamenessKind; its paired universal restriction fixes the value type."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:onClass lang:Paraphrase ;
    logic:closureKey "https://blackcatinformatics.ca/lang/paraphraseSamenessKind" ;
    logic:closureValue logic:ClosedWorldClosure .

lang:Form logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:inSignSystem ; logic:allValuesFrom lang:SignSystem ] .

lang:WordForm logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:lexemeOf ; logic:allValuesFrom lang:Lexeme ] .

lang:Grammar logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:grammarFor ; logic:allValuesFrom lang:SignSystem ] .

lang:GrammarRule logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:grammarRuleOf ; logic:allValuesFrom lang:Grammar ] .

lang:SurfaceForm logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:analysisLevel ; logic:allValuesFrom lang:AnalysisLevel ] ,
    [ a logic:Restriction ; logic:onProperty lang:inScript ; logic:allValuesFrom lang:Script ] ,
    [ a logic:Restriction ; logic:onProperty lang:inScript ; logic:minQualifiedCardinality 1 ; logic:onClass lang:Script ] ,
    [ a logic:Restriction ; logic:onProperty lang:unicodeNormalization ; logic:allValuesFrom rdfs:Literal ] ,
    [ a logic:Restriction ; logic:onProperty lang:unicodeNormalization ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:collationLocale ; logic:allValuesFrom rdfs:Literal ] ,
    [ a logic:Restriction ; logic:onProperty lang:collationLocale ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] .

lang:FormSlot rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty lang:slotIndex ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] .

lang:MorphFeature logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:featureKey ; logic:allValuesFrom lang:FeatureKey ] ,
    [ a logic:Restriction ; logic:onProperty lang:featureValue ; logic:allValuesFrom lang:FeatureValue ] .

lang:SurfaceAnchor logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:anchorSource ; logic:allValuesFrom owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:anchorSource ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:anchorStart ; logic:allValuesFrom xsd:integer ] ,
    [ a logic:Restriction ; logic:onProperty lang:anchorStart ; logic:minQualifiedCardinality 1 ; logic:onDataRange xsd:integer ] ,
    [ a logic:Restriction ; logic:onProperty lang:anchorEnd ; logic:allValuesFrom xsd:integer ] ,
    [ a logic:Restriction ; logic:onProperty lang:anchorEnd ; logic:minQualifiedCardinality 1 ; logic:onDataRange xsd:integer ] ,
    [ a logic:Restriction ; logic:onProperty lang:offsetSpace ; logic:allValuesFrom lang:OffsetSpace ] ,
    [ a logic:Restriction ; logic:onProperty lang:offsetSpace ; logic:minQualifiedCardinality 1 ; logic:onClass lang:OffsetSpace ] .

lang:Grapheme logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:inScript ; logic:allValuesFrom lang:Script ] ,
    [ a logic:Restriction ; logic:onProperty lang:inScript ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] .
# NOTE: lang:inScript is shared with lang:SurfaceForm, which legitimately allows more than one
# script (mixed-script surfaces) — so lang:inScript cannot be declared owl:FunctionalProperty
# globally without wrongly tightening SurfaceForm. Scoping the max bound to lang:Grapheme's OWN
# restriction avoids that: a qualified max cardinality with onClass lang:Script would project to
# a QUALIFIED sh:qualifiedMaxCount (never matching the legacy BARE sh:maxCount 1), but onClass
# owl:Thing degrades a qualified cardinality to a bare, class-scoped sh:maxCount (the same proven
# recipe used for gmeow:citingEntity/gmeow:citedEntity in slices/core/citations/module.ttl), so it
# combines with the allValuesFrom restriction above into bare min=1/max=1/class=Script — exactly
# lang:GraphemeGroundedShape's covered fragment — without touching lang:SurfaceForm's own,
# separate inScript restrictions at all.

lang:Denotation logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:denotedForm ; logic:allValuesFrom lang:Form ] ,
    [ a logic:Restriction ; logic:onProperty lang:denotationKind ; logic:allValuesFrom lang:DenotationKind ] ,
    [ a logic:Restriction ; logic:onProperty lang:denotationTarget ; logic:allValuesFrom owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:denotationTarget ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:denotationContext ; logic:allValuesFrom owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:denotationContext ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] .

lang:Paraphrase logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:paraphraseOf ; logic:allValuesFrom lang:Form ] ,
    [ a logic:Restriction ; logic:onProperty lang:paraphraseForm ; logic:allValuesFrom lang:Form ] ,
    [ a logic:Restriction ; logic:onProperty lang:paraphraseSamenessKind ; logic:allValuesFrom lang:ParaphraseSamenessKind ] .

lang:Rendering logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:renderedContent ; logic:allValuesFrom owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:renderedContent ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:renderingConvention ; logic:allValuesFrom owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:renderingConvention ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:renderingPreservation ; logic:allValuesFrom owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:renderingPreservation ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:renderingKind ; logic:allValuesFrom lang:RenderingKind ] .

lang:TranslationUnit logic:subClassOf
    [ a logic:Restriction ; logic:onProperty lang:translationSource ; logic:allValuesFrom owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:translationSource ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:translationTarget ; logic:allValuesFrom owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:translationTarget ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty lang:translationCorrespondence ; logic:allValuesFrom logic:Correspondence ] ,
    [ a logic:Restriction ; logic:onProperty lang:translationMethod ; logic:allValuesFrom lang:TranslationMethod ] .

lang:TransliterationMap rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty lang:transliterationSourceOrthography ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty lang:transliterationTargetOrthography ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty lang:transliterationScheme ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

lang:ProjectionEmission rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:preservationKind ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty lang:projectionTargetName ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

lang:GmnImportedPlane rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:cites ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty dcterms:hasVersion ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:GmnEnvelope logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:gmnSecurityRing ; logic:allValuesFrom gmeow:GmnSecurityRing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:gmnEnvelopeCorrespondence ; logic:allValuesFrom logic:Correspondence ] .

gmeow:GmnEnvelope rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:gmnSchemaVersion ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:gmnDictionaryVersion ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:gmnDictionaryVersion ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:gmnGlyphTableVersion ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:accordingTo ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:wasGeneratedBy ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:contentDigest ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:gmnCodebookDigest ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:gmnSecurityRingClosure
    a logic:ClosureEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "gmn envelope security-ring closure"@x-gmeow-english ;
    skos:definition "The class-scoped closed-world authority requiring every gmeow:GmnEnvelope to carry gmeow:gmnSecurityRing; its paired universal restriction fixes the value type without creating an existential witness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:onClass gmeow:GmnEnvelope ;
    logic:closureKey "https://blackcatinformatics.ca/gmeow/gmnSecurityRing" ;
    logic:closureValue logic:ClosedWorldClosure .

gmeow:gmnEnvelopeCorrespondenceClosure
    a logic:ClosureEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "gmn envelope correspondence closure"@x-gmeow-english ;
    skos:definition "The class-scoped closed-world authority requiring every gmeow:GmnEnvelope to carry gmeow:gmnEnvelopeCorrespondence; its paired universal restriction fixes the value type without creating an existential witness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:onClass gmeow:GmnEnvelope ;
    logic:closureKey "https://blackcatinformatics.ca/gmeow/gmnEnvelopeCorrespondence" ;
    logic:closureValue logic:ClosedWorldClosure .

gmeow:GmnCompaction rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:gmnCompacts ; owl:allValuesFrom owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:gmnCompacts ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:vantage ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:GmnSecurityRing logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:gmnRingLevel ; logic:allValuesFrom gmeow:GmnRingLevel ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:gmnRingCompartment ; logic:allValuesFrom gmeow:GmnCompartment ] .

gmeow:gmnRingLevelClosure
    a logic:ClosureEntry ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "gmn ring level closure"@x-gmeow-english ;
    skos:definition "The class-scoped closed-world authority requiring every gmeow:GmnSecurityRing to carry gmeow:gmnRingLevel; its paired universal restriction fixes the value type without creating an existential witness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:onClass gmeow:GmnSecurityRing ;
    logic:closureKey "https://blackcatinformatics.ca/gmeow/gmnRingLevel" ;
    logic:closureValue logic:ClosedWorldClosure .

lang:FlagshipScenario rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty lang:demonstratedByExample ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty lang:demonstratedByCompetency ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty lang:demonstratedByProducer ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty lang:guardedByCounterExample ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty lang:enforcesFailureClass ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

# =========================================================================== #
# Procedural constraints — projected to sh:SPARQLConstraint (the validation    #
# twin of the derivation surface). Each is a compact logic: constraint-sugar   #
# record carrying logic:formalizes, expanded by the frontend to a canonical    #
# logic:Constraint and lowered to a sh:SPARQLConstraint.                       #
# =========================================================================== #

# The GMN alias table is injective within each dictionary: if two member
# entries share an alias, they denote the same term. The hand-authored SHACL is
# retained as a ValidationOnly finding surface while this canonical formula is
# also projected through the logic compiler.
lang:GmnDictionaryAliasInjectivityConstraint
    a logic:Constraint ;
    rdfs:label "GMN dictionary alias-injectivity constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    skos:definition "A closed-world integrity constraint requiring entries in one gmeow:GmnDictionary that share a gmeow:gmnDictionaryEntryAlias to name the same gmeow:gmnDictionaryEntryTerm; one alias never reads back as two terms."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes lang:GmnDictionaryAliasInjectivityShape ;
    gmeow:enforcesFailureClass lang:GmnDictionaryAliasCollision ;
    logic:message "Two entries of one GMN dictionary alias different terms with the same alias string; the alias table is not injective." ;
    logic:integrity lang:gdaiForall .
lang:gdaiForall a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termVariable "entry1" ] ,
        [ logic:termIndex 2 ; logic:termVariable "entry2" ] ,
        [ logic:termIndex 3 ; logic:termVariable "alias" ] ,
        [ logic:termIndex 4 ; logic:termVariable "term1" ] ,
        [ logic:termIndex 5 ; logic:termVariable "term2" ] ;
    logic:forall lang:gdaiImpl .
lang:gdaiImpl a logic:Formula ; logic:antecedent lang:gdaiGuard ; logic:consequent lang:gdaiSameTerm .
lang:gdaiGuard a logic:Formula ;
    logic:and lang:gdaiType , lang:gdaiMember1 , lang:gdaiMember2 , lang:gdaiAlias1 , lang:gdaiAlias2 , lang:gdaiTerm1 , lang:gdaiTerm2 .
lang:gdaiType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:GmnDictionary ] .
lang:gdaiMember1 a logic:Formula ; logic:relation gmeow:gmnDictionaryEntry ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "entry1" ] .
lang:gdaiMember2 a logic:Formula ; logic:relation gmeow:gmnDictionaryEntry ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "entry2" ] .
lang:gdaiAlias1 a logic:Formula ; logic:relation gmeow:gmnDictionaryEntryAlias ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "entry1" ] , [ logic:termIndex 1 ; logic:termVariable "alias" ] .
lang:gdaiAlias2 a logic:Formula ; logic:relation gmeow:gmnDictionaryEntryAlias ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "entry2" ] , [ logic:termIndex 1 ; logic:termVariable "alias" ] .
lang:gdaiTerm1 a logic:Formula ; logic:relation gmeow:gmnDictionaryEntryTerm ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "entry1" ] , [ logic:termIndex 1 ; logic:termVariable "term1" ] .
lang:gdaiTerm2 a logic:Formula ; logic:relation gmeow:gmnDictionaryEntryTerm ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "entry2" ] , [ logic:termIndex 1 ; logic:termVariable "term2" ] .
lang:gdaiSameTerm a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "term1" ] , [ logic:termIndex 1 ; logic:termVariable "term2" ] .

# An envelope emitted by the mentation export process is admitted only when it
# names the GMN security ring governing the serialization boundary.
lang:GmnExportRingBindingConstraint
    a logic:Constraint ;
    rdfs:label "GMN export-ring binding constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    skos:definition "A closed-world integrity constraint requiring every gmeow:GmnEnvelope generated by a gmeow:processExport activity to name a gmeow:gmnSecurityRing."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes lang:GmnExportRingBindingShape ;
    gmeow:enforcesFailureClass lang:GmnUnringedExportCrossing ;
    logic:message "A GMN envelope generated by an export activity declares no security ring." ;
    logic:integrity lang:gerbForall .
lang:gerbForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "activity" ] ;
    logic:forall lang:gerbImpl .
lang:gerbImpl a logic:Formula ; logic:antecedent lang:gerbGuard ; logic:consequent lang:gerbHasRing .
lang:gerbGuard a logic:Formula ; logic:and lang:gerbEnvelope , lang:gerbGenerated , lang:gerbExport .
lang:gerbEnvelope a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:GmnEnvelope ] .
lang:gerbGenerated a logic:Formula ; logic:relation gmeow:wasGeneratedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "activity" ] .
lang:gerbExport a logic:Formula ; logic:relation gmeow:mentalProcessType ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "activity" ] , [ logic:termIndex 1 ; logic:termIri gmeow:processExport ] .
lang:gerbHasRing a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "ring" ] ;
    logic:exists lang:gerbRing .
lang:gerbRing a logic:Formula ; logic:relation gmeow:gmnSecurityRing ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "ring" ] .

# lang:ReadingClaimGroundedShape — a gmeow:Observation that is a claim about a
# lang:Reading (through lang:aboutReading) names its gmeow:vantage: the claim
# that a reading is correct is a vantage-held observation, never a groundless
# assertion. A predicate-presence guarded implication (no target class — the
# trigger predicate lang:aboutReading is the range restriction, so the shape
# targets subjects of lang:aboutReading).
lang:ReadingClaimVantageConstraint
    a logic:GuardedImplicationConstraint ;
    logic:trigger lang:aboutReading ;
    logic:requires gmeow:vantage ;
    logic:formalizes lang:ReadingClaimGroundedShape ;
    logic:message "A reading-correctness claim (a gmeow:Observation about a lang:Reading) must name its gmeow:vantage; an ungrounded reading claim is ill-formed (lang:UngroundedReadingClaim)." .

# exact-one minCount restoration (issue #1194): min-qualified sibling restrictions
# restoring sh:minCount for the reasoner-safe max-qualified exact-one antecedents.
<https://blackcatinformatics.ca/lang/FormSlot> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/lang/slotIndex> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onDataRange> <http://www.w3.org/2001/XMLSchema#integer> ] .
<https://blackcatinformatics.ca/lang/FlagshipScenario> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/lang/demonstratedByExample> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onDataRange> <http://www.w3.org/2001/XMLSchema#string> ] .
<https://blackcatinformatics.ca/lang/FlagshipScenario> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/lang/demonstratedByCompetency> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/lang/FlagshipScenario> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/lang/guardedByCounterExample> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onDataRange> <http://www.w3.org/2001/XMLSchema#string> ] .
<https://blackcatinformatics.ca/lang/FlagshipScenario> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/lang/enforcesFailureClass> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .

# A lang:slotForm value must be a resource (a blank node or IRI), never a literal
# (a path node-kind constraint targeting subjects of lang:slotForm).
lang:SlotFormNodeKindConstraint
    a logic:PathNodeKindConstraint ;
    logic:valuePath lang:slotForm ;
    logic:nodeKind "BlankNodeOrIRI" ;
    logic:formalizes lang:SlotFormStructuralShape ;
    logic:message "A lang:slotForm value must be a resource (a blank node or IRI), never a literal." .

# The sibling lang:realizes and lang:formHead paths carry the same structural
# obligation as lang:slotForm: every present value is a resource rather than a
# string. These are canonical formula-sugar records; the retained SHACL blocks
# are validation-only projections until the equivalence oracle can compare a
# path-node-kind formula to its SPARQL lowering directly.
lang:RealizesNodeKindConstraint
    a logic:PathNodeKindConstraint ;
    logic:valuePath lang:realizes ;
    logic:nodeKind "BlankNodeOrIRI" ;
    logic:formalizes lang:RealizesStructuralShape ;
    gmeow:enforcesFailureClass lang:StringOnlyForm ;
    logic:message "A lang:realizes value must be a resource (a blank node or IRI), never a literal." .

lang:FormHeadNodeKindConstraint
    a logic:PathNodeKindConstraint ;
    logic:valuePath lang:formHead ;
    logic:nodeKind "BlankNodeOrIRI" ;
    logic:formalizes lang:FormHeadStructuralShape ;
    gmeow:enforcesFailureClass lang:StringOnlyForm ;
    logic:message "A lang:formHead value must be a resource (a blank node or IRI), never a literal." .

# A surface must carry its material either inline or by content-addressed blob.
# The four remaining field obligations are ordinary OWL restrictions above; this
# disjunctive requiredness record is the canonical authority for the only
# non-declarative part of lang:SurfaceMaterialShape.
lang:SurfaceMaterialChoiceConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    logic:onClass lang:SurfaceForm ;
    logic:anyOf lang:surfaceText , lang:surfaceBlob ;
    logic:formalizes lang:SurfaceMaterialShape ;
    gmeow:enforcesFailureClass lang:UnhashableSurface ;
    logic:message "A lang:SurfaceForm must carry its bytes inline through lang:surfaceText or by reference through lang:surfaceBlob." .

# Zero-based contiguity without aggregation: every observed non-zero slot index
# has an observed predecessor whose index plus one equals it. Together with the
# exact-one integer slotIndex OWL restriction and the uniqueness constraint,
# this is equivalent over finite RDF graphs to indexes {0,...,n-1}. The formula
# is canonical; termSum lowers to a checked arithmetic BIND and termEqual to a
# FILTER, so this is not an uninterpreted proxy for the legacy aggregate query.
lang:SlotContiguityConstraint
    a logic:Constraint ;
    rdfs:label "zero-based contiguous slot-index constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    skos:definition "A first-order integrity constraint over finite RDF graphs: every slot index of a lang:ComposedForm is zero or has an observed predecessor whose index plus one equals it. Combined with exact-one integer indexes and sibling-index uniqueness, this is exactly zero-based contiguity, not a structural proxy."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes lang:SlotContiguityShape ;
    gmeow:enforcesFailureClass lang:NonContiguousSlots ;
    logic:message "A composed form's slot indexes are not zero-based and contiguous." ;
    logic:integrity lang:sctForall .
lang:sctForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall lang:sctImpl .
lang:sctImpl a logic:Formula ; logic:antecedent lang:sctGuard ; logic:consequent lang:sctAllSlots .
lang:sctGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri lang:ComposedForm ] .
lang:sctAllSlots a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "slot" ] , [ logic:termIndex 1 ; logic:termVariable "index" ] ;
    logic:forall lang:sctSlotImpl .
lang:sctSlotImpl a logic:Formula ; logic:antecedent lang:sctSlotGuard ; logic:consequent lang:sctZeroOrPredecessor .
lang:sctSlotGuard a logic:Formula ; logic:and lang:sctSlotEdge , lang:sctIndexEdge .
lang:sctSlotEdge a logic:Formula ; logic:relation lang:formSlot ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "slot" ] .
lang:sctIndexEdge a logic:Formula ; logic:relation lang:slotIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "slot" ] , [ logic:termIndex 1 ; logic:termVariable "index" ] .
lang:sctZeroOrPredecessor a logic:Formula ; logic:or lang:sctZero , lang:sctPredecessorExists .
lang:sctZero a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "index" ] , [ logic:termIndex 1 ; logic:termLiteral "0" ; logic:termLiteralDatatype xsd:integer ] .
lang:sctPredecessorExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "previousSlot" ] , [ logic:termIndex 1 ; logic:termVariable "previousIndex" ] , [ logic:termIndex 2 ; logic:termVariable "successorIndex" ] ;
    logic:exists lang:sctPredecessorBody .
lang:sctPredecessorBody a logic:Formula ; logic:and lang:sctPreviousSlotEdge , lang:sctPreviousIndexEdge , lang:sctSuccessorSum , lang:sctSuccessorEqual .
lang:sctPreviousSlotEdge a logic:Formula ; logic:relation lang:formSlot ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "previousSlot" ] .
lang:sctPreviousIndexEdge a logic:Formula ; logic:relation lang:slotIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "previousSlot" ] , [ logic:termIndex 1 ; logic:termVariable "previousIndex" ] .
lang:sctSuccessorSum a logic:Formula ; logic:relation logic:termSum ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "successorIndex" ] , [ logic:termIndex 1 ; logic:termVariable "previousIndex" ] , [ logic:termIndex 2 ; logic:termLiteral "1" ; logic:termLiteralDatatype xsd:integer ] .
lang:sctSuccessorEqual a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "successorIndex" ] , [ logic:termIndex 1 ; logic:termVariable "index" ] .

# No two distinct lang:formSlot cells of one composed form may share the same
# lang:slotIndex (a self-join uniqueness constraint).
lang:FormSlotIndexUniquenessConstraint
    a logic:SelfJoinUniquenessConstraint ;
    logic:onClass lang:ComposedForm ;
    logic:siblingPredicate lang:formSlot ;
    logic:sharedPredicate lang:slotIndex ;
    logic:formalizes lang:SlotIndexUniqueShape ;
    logic:message "No two distinct lang:formSlot cells of one lang:ComposedForm may share the same lang:slotIndex." .

# A lang:FeatureValue must be dispositioned in the symbology plane: it must be the
# lang:denotationTarget of some lang:Denotation (an inverse-existence constraint).
lang:FeatureValueDispositionConstraint
    a logic:InverseExistenceConstraint ;
    logic:onClass lang:FeatureValue ;
    logic:inversePredicate lang:denotationTarget ;
    logic:subjectClass lang:Denotation ;
    logic:formalizes lang:GmnLangCoverageShape ;
    logic:message "A lang:FeatureValue must be the lang:denotationTarget of some lang:Denotation; an undispositioned feature value is ill-formed." .

# A gmeow:gmnCodepoints value must be canonical: space-separated U+XXXX groups of 4-6 uppercase
# hex digits (a string-pattern constraint — every value on the path must match the regex).
lang:GmnCodepointCanonicalConstraint
    a logic:StringPatternConstraint ;
    logic:valuePath gmeow:gmnCodepoints ;
    logic:stringOp "regexRequired" ;
    logic:stringPattern "^U\\+[0-9A-F]{4,6}( U\\+[0-9A-F]{4,6})*$" ;
    logic:formalizes lang:GmnCodepointCanonicalShape ;
    logic:message "A gmeow:gmnCodepoints value must be canonical: space-separated U+XXXX groups of 4-6 uppercase hex digits." .

# A lang:FlagshipScenario's lang:enforcesFailureClass must transitively rdfs:subClassOf the
# conformance-failure root (a transitive reachability constraint).
lang:FlagshipScenarioFailureClassConstraint
    a logic:Constraint ;
    logic:integrity lang:fsrForall ;
    logic:formalizes lang:FlagshipScenarioShape ;
    gmeow:enforcesFailureClass lang:UnwiredFlagshipScenario ;
    logic:message "A gmeow:FlagshipScenario's gmeow:enforcesFailureClass must transitively rdfs:subClassOf lang:LangConformanceFailure; a scenario that enforces a non-failure class is ill-formed." .
lang:fsrForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "failure" ] ;
    logic:forall lang:fsrImpl .
lang:fsrImpl a logic:Formula ; logic:antecedent lang:fsrGuard ; logic:consequent lang:fsrReach .
lang:fsrGuard a logic:Formula ; logic:and lang:fsrType , lang:fsrEdge , lang:fsrNs .
lang:fsrType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:FlagshipScenario ] .
lang:fsrEdge a logic:Formula ; logic:relation gmeow:enforcesFailureClass ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "failure" ] .
lang:fsrNs a logic:Formula ; logic:relation logic:termStrStarts ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "failure" ] , [ logic:termIndex 1 ; logic:termLiteral "https://blackcatinformatics.ca/lang/" ] .
lang:fsrReach a logic:Formula ; logic:relation logic:transitiveReach ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "failure" ] , [ logic:termIndex 1 ; logic:termIri rdfs:subClassOf ] , [ logic:termIndex 2 ; logic:termIri lang:LangConformanceFailure ] .

# A lang:FormSlot may not depend (transitively) on itself along lang:dependsOn — a
# dependency cycle is ill-formed (an acyclicity constraint).
lang:FormSlotAcyclicDependencyConstraint
    a logic:AcyclicConstraint ;
    logic:onClass lang:FormSlot ;
    logic:pathPredicate lang:dependsOn ;
    logic:formalizes lang:DependencyIntegrityShape ;
    logic:message "A lang:FormSlot may not depend on itself transitively along lang:dependsOn; a dependency cycle is ill-formed." .

# Every lang:Grapheme in the GMN script (lang:inScript gmeow:gmnScript) carries a
# measured token cost through gmeow:gmnGlyphTokenCost — the per-glyph feed the
# glyph-versus-named-key disposition reads off. A GMN-script glyph with no cost is
# lang:GmnUncostedScriptGlyph (a guarded implication: the inScript=gmnScript trigger
# is the guard, gmeow:gmnGlyphTokenCost the required field).
lang:GmnScriptGlyphCoverageConstraint
    a logic:GuardedImplicationConstraint ;
    logic:onClass lang:Grapheme ;
    logic:trigger lang:inScript ;
    logic:triggerValue gmeow:gmnScript ;
    logic:requires gmeow:gmnGlyphTokenCost ;
    logic:formalizes lang:GmnScriptGlyphCoverageShape ;
    logic:message "A lang:Grapheme in the GMN script carries no gmeow:gmnGlyphTokenCost; the GMN glyph inventory is cost-covered by rule, so every admitted glyph carries its measured token-cost feed." .

# =========================================================================== #
# Procedural constraints authored as raw logic:Formula integrity trees. Each   #
# carries logic:formalizes so its projected sh:SPARQLConstraint twin keys onto  #
# the same source-term as the hand-authored SHACL it replaces.                 #
# =========================================================================== #

# A lang:Grapheme belongs to the repertoire of the lang:Script it declares: the
# script lists it through lang:hasGrapheme. A grapheme whose declared script does
# not list it is ungrounded — an inverse-existence over the declared script.
lang:GraphemeRepertoireConstraint
    a logic:Constraint ;
    rdfs:label "Grapheme repertoire constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a lang:Grapheme is in the repertoire of the lang:Script it declares (the script lists it through lang:hasGrapheme)."@x-gmeow-english ;
    logic:formalizes lang:GraphemeGroundedShape ;
    logic:message "A grapheme is not in the repertoire of the script it declares." ;
    logic:integrity lang:grForall .
lang:grForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] ;
    logic:forall lang:grImpl .
lang:grImpl a logic:Formula ; logic:antecedent lang:grGuard ; logic:consequent lang:grHas .
lang:grGuard a logic:Formula ; logic:and lang:grType , lang:grInScript .
lang:grType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri lang:Grapheme ] .
lang:grInScript a logic:Formula ; logic:relation lang:inScript ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
lang:grHas a logic:Formula ; logic:relation lang:hasGrapheme ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .

# A reading-preference claim (a subject of lang:aboutReading) that carries a
# logic:probability must declare a logic:probabilityModel — a preference weight is
# a logic:confidence unless a real model is present. A DUAL guard (aboutReading
# AND probability) so a bare logic:probability elsewhere is not swept in.
lang:ConfidenceModelConstraint
    a logic:Constraint ;
    rdfs:label "Confidence model constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a reading claim (a subject of lang:aboutReading) carrying a logic:probability declares a logic:probabilityModel."@x-gmeow-english ;
    logic:formalizes lang:ConfidenceNotProbabilityShape ;
    logic:message "A reading claim carries a logic:probability with no declared logic:probabilityModel." ;
    logic:integrity lang:cnpForall .
lang:cnpForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] , [ logic:termIndex 2 ; logic:termVariable "p" ] ;
    logic:forall lang:cnpImpl .
lang:cnpImpl a logic:Formula ; logic:antecedent lang:cnpGuard ; logic:consequent lang:cnpModel .
lang:cnpGuard a logic:Formula ; logic:and lang:cnpAbout , lang:cnpProb .
lang:cnpAbout a logic:Formula ; logic:relation lang:aboutReading ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] .
lang:cnpProb a logic:Formula ; logic:relation logic:probability ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .
lang:cnpModel a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "m" ] ;
    logic:exists lang:cnpModelAtom .
lang:cnpModelAtom a logic:Formula ; logic:relation logic:probabilityModel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "m" ] .

# No two distinct graphemes of gmeow:gmnScript are related by
# gmeow:gmnConfusableWith — the confusables blocklist of the GMN orthography.
lang:GmnConfusableGlyphConstraint
    a logic:Constraint ;
    rdfs:label "GMN confusable glyph constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: no two distinct graphemes of gmeow:gmnScript are a declared gmeow:gmnConfusableWith pair."@x-gmeow-english ;
    logic:formalizes lang:GmnConfusableGlyphShape ;
    logic:message "Two distinct graphemes of the GMN script are a declared gmeow:gmnConfusableWith pair; the orthography's confusables blocklist forbids co-resident confusables." ;
    logic:integrity lang:gcgForall .
lang:gcgForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "g2" ] ;
    logic:forall lang:gcgImpl .
lang:gcgImpl a logic:Formula ; logic:antecedent lang:gcgGuard ; logic:consequent lang:gcgNot .
lang:gcgGuard a logic:Formula ; logic:relation gmeow:gmnConfusableWith ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "g2" ] .
lang:gcgNot a logic:Formula ; logic:not lang:gcgBody .
lang:gcgBody a logic:Formula ; logic:and lang:gcgA1 , lang:gcgA2 , lang:gcgA3 .
lang:gcgA1 a logic:Formula ; logic:relation lang:inScript ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:gmnScript ] .
lang:gcgA2 a logic:Formula ; logic:relation lang:inScript ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "g2" ] , [ logic:termIndex 1 ; logic:termIri gmeow:gmnScript ] .
lang:gcgA3 a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "g2" ] .

# No two distinct graphemes of one lang:Script share an identical
# gmeow:gmnCodepoints value unless BOTH carry a gmeow:gmnSigilScope (the record-
# initial sigil discipline is the single lawful cross-plane reuse).
lang:GmnGlyphCollisionConstraint
    a logic:Constraint ;
    rdfs:label "GMN glyph collision constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: two distinct graphemes of one script sharing a gmeow:gmnCodepoints value must both carry a gmeow:gmnSigilScope."@x-gmeow-english ;
    logic:formalizes lang:GmnGlyphCollisionShape ;
    logic:message "Two distinct graphemes of one script share an identical gmeow:gmnCodepoints value without both carrying a gmeow:gmnSigilScope; unscoped glyph collisions are forbidden." ;
    logic:integrity lang:ggcForall .
lang:ggcForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "cp" ] , [ logic:termIndex 2 ; logic:termVariable "s" ] , [ logic:termIndex 3 ; logic:termVariable "g2" ] ;
    logic:forall lang:ggcImpl .
lang:ggcImpl a logic:Formula ; logic:antecedent lang:ggcGuard ; logic:consequent lang:ggcScoped .
lang:ggcGuard a logic:Formula ; logic:and lang:ggcA1 , lang:ggcA2 , lang:ggcA3 , lang:ggcA4 , lang:ggcA5 .
lang:ggcA1 a logic:Formula ; logic:relation gmeow:gmnCodepoints ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "cp" ] .
lang:ggcA2 a logic:Formula ; logic:relation lang:inScript ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
lang:ggcA3 a logic:Formula ; logic:relation gmeow:gmnCodepoints ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "g2" ] , [ logic:termIndex 1 ; logic:termVariable "cp" ] .
lang:ggcA4 a logic:Formula ; logic:relation lang:inScript ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "g2" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
lang:ggcA5 a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "g2" ] .
lang:ggcScoped a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "sc1" ] , [ logic:termIndex 1 ; logic:termVariable "sc2" ] ;
    logic:exists lang:ggcScopedBody .
lang:ggcScopedBody a logic:Formula ; logic:and lang:ggcS1 , lang:ggcS2 .
lang:ggcS1 a logic:Formula ; logic:relation gmeow:gmnSigilScope ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sc1" ] .
lang:ggcS2 a logic:Formula ; logic:relation gmeow:gmnSigilScope ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "g2" ] , [ logic:termIndex 1 ; logic:termVariable "sc2" ] .

# =========================================================================== #
# Procedural constraints (#1194) authored as raw logic:Formula integrity trees, #
# projected to sh:SPARQLConstraint keyed (via logic:formalizes) onto the same    #
# source-terms the hand-authored SHACL enforced. GmnCompaction uses the          #
# logic:linkVia variable-predicate relation; GmnVersionOverclaim a filter        #
# conjunction over the version-scale classification.                            #
# =========================================================================== #

# A gmeow:GmnCompaction's correspondence never claims a preservation stronger
# than logic:ValidationOnly: any logic:Correspondence the compaction record links
# — through ANY predicate — must not carry logic:mnemomorphic true,
# logic:ExactPreservation, or logic:SoundUnderApproximation.
lang:GmnCompactionOverclaimConstraint
    a logic:Constraint ;
    rdfs:label "GMN compaction overclaim constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:GmnCompaction that links a logic:Correspondence claiming mnemomorphic recoverability, exact preservation, or soundness under approximation overclaims — compaction is get-leg-only (validation-only)."@x-gmeow-english ;
    logic:formalizes lang:GmnCompactionOverclaimShape ;
    logic:severity "Violation" ;
    logic:message "A gmeow:GmnCompaction links a logic:Correspondence claiming mnemomorphic recoverability, exact preservation, or soundness under approximation; compaction is validation-only." ;
    logic:integrity lang:gmnCoForall .
lang:gmnCoForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall lang:gmnCoImpl .
lang:gmnCoImpl a logic:Formula ; logic:antecedent lang:gmnCoGuard ; logic:consequent lang:gmnCoPhi .
lang:gmnCoGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:GmnCompaction ] .
lang:gmnCoPhi a logic:Formula ; logic:not lang:gmnCoEx .
lang:gmnCoEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "link" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] ;
    logic:exists lang:gmnCoBody .
lang:gmnCoBody a logic:Formula ; logic:and lang:gmnCoLink , lang:gmnCoType , lang:gmnCoClaim .
lang:gmnCoLink a logic:Formula ; logic:relation logic:linkVia ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "link" ] , [ logic:termIndex 2 ; logic:termVariable "c" ] .
lang:gmnCoType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termIri logic:Correspondence ] .
lang:gmnCoClaim a logic:Formula ; logic:or lang:gmnCoMnemo , lang:gmnCoExact , lang:gmnCoSound .
lang:gmnCoMnemo a logic:Formula ; logic:relation logic:mnemomorphic ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termLiteral "true" ; logic:termLiteralDatatype xsd:boolean ] .
lang:gmnCoExact a logic:Formula ; logic:relation logic:preservationKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termIri logic:ExactPreservation ] .
lang:gmnCoSound a logic:Formula ; logic:relation logic:preservationKind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termIri logic:SoundUnderApproximation ] .

# A GMN version migration (a subject of gmeow:gmnMigratesTo) whose carried
# correspondence claims logic:mnemomorphic true is honest only over an additive
# bump: when the destination version's gmeow:VersionMembership carries a
# gmeow:versionScale other than gmeow:scaleMinor or gmeow:scaleTrivial, the
# recoverability witness is an overclaim.
lang:GmnVersionOverclaimConstraint
    a logic:Constraint ;
    rdfs:label "GMN version overclaim constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a GMN migration whose carried lang:translationCorrespondence claims logic:mnemomorphic true over a stronger-than-additive version bump (a destination gmeow:versionScale other than gmeow:scaleMinor or gmeow:scaleTrivial) overclaims — the version machinery never claims more than its lineage discharges."@x-gmeow-english ;
    logic:formalizes lang:GmnVersionOverclaimShape ;
    logic:severity "Violation" ;
    logic:message "A GMN migration claims logic:mnemomorphic true over a stronger-than-additive version bump; the version machinery never claims more than its lineage discharges." ;
    logic:integrity lang:gmnVoForall .
lang:gmnVoForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "vg" ] ;
    logic:forall lang:gmnVoImpl .
lang:gmnVoImpl a logic:Formula ; logic:antecedent lang:gmnVoGuard ; logic:consequent lang:gmnVoPhi .
lang:gmnVoGuard a logic:Formula ; logic:relation gmeow:gmnMigratesTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "vg" ] .
lang:gmnVoPhi a logic:Formula ; logic:not lang:gmnVoEx .
lang:gmnVoEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "v" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] , [ logic:termIndex 2 ; logic:termVariable "m" ] , [ logic:termIndex 3 ; logic:termVariable "sc" ] ;
    logic:exists lang:gmnVoBody .
lang:gmnVoBody a logic:Formula ; logic:and lang:gmnVoTo , lang:gmnVoCorr , lang:gmnVoMnemo , lang:gmnVoMember , lang:gmnVoScale , lang:gmnVoNotMinor , lang:gmnVoNotTrivial .
lang:gmnVoTo a logic:Formula ; logic:relation gmeow:gmnMigratesTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .
lang:gmnVoCorr a logic:Formula ; logic:relation lang:translationCorrespondence ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] .
lang:gmnVoMnemo a logic:Formula ; logic:relation logic:mnemomorphic ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termLiteral "true" ; logic:termLiteralDatatype xsd:boolean ] .
lang:gmnVoMember a logic:Formula ; logic:relation gmeow:versionMember ;
