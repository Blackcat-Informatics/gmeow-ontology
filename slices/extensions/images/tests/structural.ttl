#
# Declarative structural assertions for the images slice -- the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_images.py. Each assertion runs as a
# SPARQL ASK over the images module graph (gmeow:scopeModule) under the native
# Rust slicetest harness (crates/slicetest).
#
# Images is migrated: class stereotypes are logic:
# (logic:SubKind, logic:Kind, logic:AbstractIndividualType, logic:QualityValue),
# not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_depicts_is_subproperty_of_is_about -- gmeow:depicts is defined in
#     slices/core/documents/module.ttl, not the images module; a scopeModule
#     cell would miss it entirely (cross-slice subject).
#   test_depicted_in_is_inverse_of_depicts -- gmeow:depictedIn likewise lives
#     in slices/core/documents/module.ttl (cross-slice subject).
#   test_pixel_dimensions_on_media_object -- gmeow:pixelWidth and
#     gmeow:pixelHeight are defined in slices/core/documents/module.ttl
#     (cross-slice subjects).
#   test_image_orientation_on_media_object -- gmeow:imageOrientation is
#     defined in slices/core/documents/module.ttl (cross-slice subject).
#   test_capture_metadata_on_media_object -- gmeow:captureTime and
#     gmeow:captureDevice are defined in slices/core/documents/module.ttl
#     (cross-slice subjects).
#   test_colourspace_property_exists -- gmeow:colourspace is defined in
#     slices/core/documents/module.ttl (cross-slice subject).
#   test_image_event_types_exist -- gmeow:eventTypeImageCapture etc. are
#     defined in slices/core/events/module.ttl (cross-slice subjects).
#   test_depiction_usage_shacl_passes -- SHACL validation call; ExampleConformance,
#     not a structural TBox assertion.
#   test_depiction_usage_missing_image_fails_shacl -- SHACL validation call;
#     ExampleConformance with error-text assertions.
#   test_image_region_shacl_passes -- SHACL validation call; ExampleConformance.
#   test_image_region_missing_selector_fails_shacl -- SHACL validation call;
#     ExampleConformance with error-text assertions.
#   test_scene_graph_edge_shacl_passes -- SHACL validation call; ExampleConformance.
#   test_scene_graph_edge_missing_relation_fails_shacl -- SHACL validation call;
#     ExampleConformance with error-text assertions.
#   test_region_selector_missing_value_fails_shacl -- SHACL validation call;
#     ExampleConformance with error-text assertions.
#   test_scene_graph_edge_confidence_out_of_range_fails_shacl -- SHACL validation;
#     ExampleConformance with numeric range assertion.
#   test_depiction_usage_multiple_subjects_fails_shacl -- SHACL validation call;
#     ExampleConformance with error-text assertions.
#   test_media_object_colourspace_shacl_passes -- SHACL validation call;
#     ExampleConformance.
#   test_media_object_missing_colourspace_warns_shacl -- SHACL validation call;
#     warning-text assertion, not a structural TBox invariant.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/images/tests/> .

# --- 1. DepictionUsage is a logic:SubKind subclass of Observation and
#        Relator (MUST) ---------------------------------------------------
ex:saDepictionUsageIsSubKindRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:DepictionUsage a logic:SubKind , owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:DepictionUsage MUST be an owl:Class typed logic:SubKind with rdfs:subClassOf gmeow:Observation and logic:Relator -- a reified depiction is a relator (binding subject, image, context) and an observation in the universal claim spine." .

# --- 2. ImageRegion is a logic:Kind subclass of InformationObject (MUST) ---
ex:saImageRegionIsKindInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ImageRegion a logic:Kind , owl:Class ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:ImageRegion MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject -- image regions are functional complexes that carry their own identity (face, bounding box, polygon) within a single image." .

# --- 3. RegionSelector is a logic:Kind subclass of InformationObject (MUST) -
ex:saRegionSelectorIsKindInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:RegionSelector a logic:Kind , owl:Class ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:RegionSelector MUST be an owl:Class typed logic:Kind and a subclass of gmeow:InformationObject -- the encoding descriptor carries its own identity separate from the region it describes." .

# --- 4. SceneGraphEdge is a logic:Kind subclass of Relator (MUST) ----------
ex:saSceneGraphEdgeIsKindRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SceneGraphEdge a logic:Kind , owl:Class ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:SceneGraphEdge MUST be an owl:Class typed logic:Kind and a subclass of logic:Relator -- a scene-graph edge reifies a spatial or semantic relation between two image regions; its identity is the triple (subject, object, relation type)." .

# --- 5. DepictionUsage role properties are ObjectProperties with correct
#        domains and ranges (MUST) -----------------------------------------
ex:saDepictionUsageRolePropertiesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:depictionSubject a owl:ObjectProperty ;
        rdfs:domain gmeow:DepictionUsage ;
        rdfs:range gmeow:Entity .
    gmeow:depictionImage a owl:ObjectProperty ;
        rdfs:domain gmeow:DepictionUsage ;
        rdfs:range gmeow:MediaObject .
    gmeow:depictionContext a owl:ObjectProperty ;
        rdfs:domain gmeow:DepictionUsage ;
        rdfs:range gmeow:DepictionContext .
    gmeow:depictionAudience a owl:ObjectProperty ;
        rdfs:domain gmeow:DepictionUsage ;
        rdfs:range gmeow:Entity .
    gmeow:depictionInterval a owl:ObjectProperty ;
        rdfs:domain gmeow:DepictionUsage ;
        rdfs:range gmeow:TimeInterval .
    gmeow:depictionAuthority a owl:ObjectProperty ;
        rdfs:domain gmeow:DepictionUsage ;
        rdfs:range gmeow:Agent .
}""" ;
    gmeow:saRationale "The six DepictionUsage role properties MUST all be owl:ObjectProperty with domain gmeow:DepictionUsage and correct ranges. The single-valued character of depictionSubject, depictionImage, depictionContext (one per relator) now rides on a logic:PropertyCharacteristicAssertion, DL-enforced, no longer a bare OWL property-type declaration; depictionAudience, depictionInterval, depictionAuthority remain non-functional (multiple audiences, periods, and authorities coexist, P9)." .

# --- 6. Non-functional DepictionUsage role properties are NOT functional
#        (MUST-NOT) -------------------------------------------------------
ex:saDepictionUsageNonFunctionalRolesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p {
        gmeow:depictionAudience
        gmeow:depictionInterval
        gmeow:depictionAuthority
    }
    ?p a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:depictionAudience, depictionInterval, and depictionAuthority MUST NOT be owl:FunctionalProperty -- multiple audiences, periods, and authorities coexist without a privileged claimant (Principle 9)." .

# --- 7. ImageRegion and RegionSelector properties have correct
#        domains and ranges (MUST) -----------------------------------------
ex:saImageRegionPropertiesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasRegion a owl:ObjectProperty ;
        rdfs:domain gmeow:MediaObject ;
        rdfs:range gmeow:ImageRegion .
    gmeow:regionOf a owl:ObjectProperty ;
        rdfs:domain gmeow:ImageRegion ;
        rdfs:range gmeow:MediaObject .
    gmeow:regionSelector a owl:ObjectProperty ;
        rdfs:domain gmeow:ImageRegion ;
        rdfs:range gmeow:RegionSelector .
    gmeow:selectorType a owl:ObjectProperty ;
        rdfs:domain gmeow:RegionSelector ;
        rdfs:range gmeow:SelectorType .
    gmeow:selectorValue a owl:DatatypeProperty ;
        rdfs:domain gmeow:RegionSelector .
    gmeow:regionLabel a owl:DatatypeProperty ;
        rdfs:domain gmeow:ImageRegion .
}""" ;
    gmeow:saRationale "hasRegion, regionOf, regionSelector, selectorType, selectorValue, and regionLabel MUST all carry the correct type, domain, and range. The single-valued character of regionOf, regionSelector, and selectorType (each region has exactly one parent image, one selector, and one selector kind) now rides on a logic:PropertyCharacteristicAssertion, DL-enforced, no longer a bare OWL property-type declaration." .

# --- 8. SceneGraphEdge properties have correct domains and
#        ranges (MUST) ----------------------------------------------------
ex:saSceneGraphEdgePropertiesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:sceneSubject a owl:ObjectProperty ;
        rdfs:domain gmeow:SceneGraphEdge ;
        rdfs:range gmeow:ImageRegion .
    gmeow:sceneObject a owl:ObjectProperty ;
        rdfs:domain gmeow:SceneGraphEdge ;
        rdfs:range gmeow:ImageRegion .
    gmeow:sceneRelation a owl:ObjectProperty ;
        rdfs:domain gmeow:SceneGraphEdge ;
        rdfs:range gmeow:SceneRelationType .
    gmeow:sceneConfidence a owl:DatatypeProperty ;
        rdfs:domain gmeow:SceneGraphEdge .
}""" ;
    gmeow:saRationale "sceneSubject, sceneObject, sceneRelation, and sceneConfidence MUST all be present with domain gmeow:SceneGraphEdge and correct ranges -- a reified edge binds exactly one subject region, one object region, one relation type, and one confidence value. That single-valued (one-per-edge) character now rides on a logic:PropertyCharacteristicAssertion, DL-enforced, no longer a bare OWL property-type declaration." .

# --- 9. SelectorType is a logic:QualityValue and its nine seeds exist (MUST) -
ex:saSelectorTypeValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SelectorType rdfs:subClassOf logic:QualityValue .
    gmeow:selectorTypeSvgPath               a gmeow:SelectorType .
    gmeow:selectorTypePixelRectangle        a gmeow:SelectorType .
    gmeow:selectorTypeFractionalRectangle   a gmeow:SelectorType .
    gmeow:selectorTypePolygonPath           a gmeow:SelectorType .
    gmeow:selectorTypeRunLengthEncoded      a gmeow:SelectorType .
    gmeow:selectorTypeCocoRleMask           a gmeow:SelectorType .
    gmeow:selectorTypeDicomSegMask          a gmeow:SelectorType .
    gmeow:selectorTypePixelMask             a gmeow:SelectorType .
    gmeow:selectorTypeWebAnnotationFragment a gmeow:SelectorType .
}""" ;
    gmeow:saRationale "gmeow:SelectorType MUST be a subclass of logic:QualityValue and all nine seed individuals (SVG path, pixel rectangle, fractional rectangle, polygon path, RLE, COCO RLE mask, DICOM-SEG mask, pixel mask, Web Annotation fragment) MUST exist as gmeow:SelectorType instances (open value vocabulary, Principle 9)." .

# --- 10. DepictionContext is a logic:QualityValue and its twelve seeds
#         exist (MUST) ---------------------------------------------------
ex:saDepictionContextValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:DepictionContext rdfs:subClassOf logic:QualityValue .
    gmeow:depictionContextWork          a gmeow:DepictionContext .
    gmeow:depictionContextFamily        a gmeow:DepictionContext .
    gmeow:depictionContextChildhood     a gmeow:DepictionContext .
    gmeow:depictionContextNow           a gmeow:DepictionContext .
    gmeow:depictionContextPortrait      a gmeow:DepictionContext .
    gmeow:depictionContextCandid        a gmeow:DepictionContext .
    gmeow:depictionContextFormal        a gmeow:DepictionContext .
    gmeow:depictionContextProfessional  a gmeow:DepictionContext .
    gmeow:depictionContextSocial        a gmeow:DepictionContext .
    gmeow:depictionContextSelfPortrait  a gmeow:DepictionContext .
    gmeow:depictionContextActionShot    a gmeow:DepictionContext .
    gmeow:depictionContextEvent         a gmeow:DepictionContext .
}""" ;
    gmeow:saRationale "gmeow:DepictionContext MUST be a subclass of logic:QualityValue and all twelve seed individuals (work, family, childhood, now, portrait, candid, formal, professional, social, self-portrait, action shot, event) MUST exist as gmeow:DepictionContext instances (open value vocabulary, Principle 9)." .

# --- 11. SceneRelationType is a logic:QualityValue and its fifteen seeds
#         exist (MUST) ---------------------------------------------------
ex:saSceneRelationTypeValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SceneRelationType rdfs:subClassOf logic:QualityValue .
    gmeow:sceneRelationLeftOf   a gmeow:SceneRelationType .
    gmeow:sceneRelationRightOf  a gmeow:SceneRelationType .
    gmeow:sceneRelationAbove    a gmeow:SceneRelationType .
    gmeow:sceneRelationBelow    a gmeow:SceneRelationType .
    gmeow:sceneRelationInside   a gmeow:SceneRelationType .
    gmeow:sceneRelationTouching a gmeow:SceneRelationType .
    gmeow:sceneRelationNear     a gmeow:SceneRelationType .
    gmeow:sceneRelationFarFrom  a gmeow:SceneRelationType .
    gmeow:sceneRelationSameAs   a gmeow:SceneRelationType .
    gmeow:sceneRelationPartOf   a gmeow:SceneRelationType .
    gmeow:sceneRelationHolding  a gmeow:SceneRelationType .
    gmeow:sceneRelationWearing  a gmeow:SceneRelationType .
    gmeow:sceneRelationRiding   a gmeow:SceneRelationType .
    gmeow:sceneRelationEating   a gmeow:SceneRelationType .
    gmeow:sceneRelationPlaying  a gmeow:SceneRelationType .
}""" ;
    gmeow:saRationale "gmeow:SceneRelationType MUST be a subclass of logic:QualityValue and all fifteen seed individuals (leftOf, rightOf, above, below, inside, touching, near, farFrom, sameAs, partOf, holding, wearing, riding, eating, playing) MUST exist as gmeow:SceneRelationType instances (open value vocabulary, Principle 9)." .
