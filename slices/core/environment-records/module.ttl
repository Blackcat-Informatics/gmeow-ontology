    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "request" ], [ logic:termIndex 2 ; logic:termVariable "object" ], [ logic:termIndex 3 ; logic:termVariable "evaluation" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation gmeow:fulfillmentEvaluation ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "evaluation" ] ],
                [ a logic:Formula ; logic:relation gmeow:answersRequestRevision ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "request" ] ],
                [ a logic:Formula ; logic:relation gmeow:fulfilledObject ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "object" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation gmeow:answersRequestRevision ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "evaluation" ],
                        [ logic:termIndex 1 ; logic:termVariable "request" ] ],
                [ a logic:Formula ; logic:relation gmeow:recordedWorldObject ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "evaluation" ],
                        [ logic:termIndex 1 ; logic:termVariable "object" ] ],
                [ a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "condition" ] ;
                    logic:exists [ a logic:Formula ; logic:and
                        [ a logic:Formula ; logic:relation gmeow:evaluatedCondition ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "evaluation" ],
                                [ logic:termIndex 1 ; logic:termVariable "condition" ] ],
                        [ a logic:Formula ; logic:relation gmeow:requestCondition ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "request" ],
                                [ logic:termIndex 1 ; logic:termVariable "condition" ] ] ] ],
                [ a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "otherRequest" ] ;
                    logic:forall [ a logic:Formula ;
                        logic:antecedent [ a logic:Formula ; logic:relation gmeow:answersRequestRevision ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "evaluation" ],
                                [ logic:termIndex 1 ; logic:termVariable "otherRequest" ] ] ;
                        logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "otherRequest" ],
                                [ logic:termIndex 1 ; logic:termVariable "request" ] ] ] ],
                [ a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "otherObject" ] ;
                    logic:forall [ a logic:Formula ;
                        logic:antecedent [ a logic:Formula ; logic:relation gmeow:recordedWorldObject ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "evaluation" ],
                                [ logic:termIndex 1 ; logic:termVariable "otherObject" ] ] ;
                        logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "otherObject" ],
                                [ logic:termIndex 1 ; logic:termVariable "object" ] ] ] ] ] ] ] .

