#
# Declarative competency question for the contacts slice (crates/slicetest),
# migrated from test_competency_interpersonal_relationships_query. TBox
# subset over the asserted merged ontology (contains-check). No Gap-1 universal.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/contacts/tests/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .

ex:cqInterpersonalRelationships a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/interpersonal-relationships.rq" ;
    gmeow:cqRationale "GMEOW must model interpersonal relationship kinds: the InterpersonalRelationship root plus ProfessionalRelationship and AcquaintanceRelationship." ;
    gmeow:cqResultShape ex:cqInterpersonalRelationshipsShape ;
    gmeow:cqExpectRow ex:irRoot, ex:irProfessional, ex:irAcquaintance .

ex:irRoot a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "relationship" ; gmeow:cellValueIri gmeow:InterpersonalRelationship ] .
ex:irProfessional a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "relationship" ; gmeow:cellValueIri gmeow:ProfessionalRelationship ] .
ex:irAcquaintance a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "relationship" ; gmeow:cellValueIri gmeow:AcquaintanceRelationship ] .

ex:cqInterpersonalRelationshipsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "relationship" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .
