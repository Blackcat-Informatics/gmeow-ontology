[ a logic:ClosureEntry ; logic:onClass logic:CounterfactualAcceptanceWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/selectedByEntrenchment" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:RefutationAcceptanceWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/namesContradictionWitness" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:ChaseAcceptanceWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/carriesTerminationCertificate" ; logic:closureValue logic:ClosedWorldClosure ] .

logic:FormalizationCandidate rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:candidateSourceHash ; owl:allValuesFrom xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty logic:candidateExtractionProvenance ; owl:allValuesFrom xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty logic:candidateScope ; owl:allValuesFrom xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty logic:candidateContract ; owl:allValuesFrom logic:ReasoningContract ] ,
    [ a owl:Restriction ; owl:onProperty logic:candidateCategory ; owl:allValuesFrom logic:FormalizationCategory ] ,
    [ a owl:Restriction ; owl:onProperty logic:candidateLifecycle ; owl:allValuesFrom logic:CandidateLifecycleState ] ,
    [ a owl:Restriction ; owl:onProperty logic:candidateProjectionBehavior ; owl:allValuesFrom logic:PreservationKind ] ,
    [ a owl:Restriction ; owl:onProperty logic:candidateSemanticRisk ; owl:allValuesFrom logic:SemanticRiskClass ] ,
    [ a owl:Restriction ; owl:onProperty logic:candidateSourceField ; owl:allValuesFrom logic:ProseField ] .

logic:Plan rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:planGoal ; owl:allValuesFrom gmeow:Goal ] ,
    [ a owl:Restriction ; owl:onProperty logic:planSuccessMode ; owl:allValuesFrom logic:PlanSuccessMode ] .

logic:GoalEvaluation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:satisfactionStatus ; owl:allValuesFrom logic:SatisfactionStatus ] ,
    [ a owl:Restriction ; owl:onProperty logic:feasibilityStatus ; owl:allValuesFrom logic:FeasibilityStatus ] ,
    [ a owl:Restriction ; owl:onProperty logic:lifecycleStatus ; owl:allValuesFrom logic:LifecycleStatus ] ,
    [ a owl:Restriction ; owl:onProperty logic:goalEvaluationStatus ; owl:allValuesFrom logic:GoalEvaluationStatus ] ,
    [ a owl:Restriction ; owl:onProperty logic:evaluatesGoal ; owl:allValuesFrom gmeow:Goal ] .

logic:ActionSchema rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:precondition ; owl:allValuesFrom owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty logic:capability ; owl:allValuesFrom owl:Thing ] .

logic:McpActionSchema rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:capability ; owl:allValuesFrom owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty logic:precondition ; owl:allValuesFrom owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty logic:compensation ; owl:allValuesFrom owl:Thing ] .

logic:NotificationWaitSchema rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:awaitsSignal ; owl:allValuesFrom logic:ExternalSignal ] .

logic:FreshnessGuard rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:guardsPrecondition ; owl:allValuesFrom owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty logic:freshnessHorizon ; owl:allValuesFrom xsd:duration ] ,
    [ a owl:Restriction ; owl:onProperty logic:freshnessWindowStart ; owl:allValuesFrom xsd:dateTime ] ,
    [ a owl:Restriction ; owl:onProperty logic:freshnessWindowEnd ; owl:allValuesFrom xsd:dateTime ] .

logic:NonEntailmentObligation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:obligationForbiddenPredicate ; owl:allValuesFrom xsd:anyURI ] ,
    [ a owl:Restriction ; owl:onProperty logic:obligationDischargeCondition ; owl:allValuesFrom logic:DischargeCondition ] .

logic:Conjecture rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:conjectureFormula ; owl:allValuesFrom xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty logic:conjectureStandpoint ; owl:allValuesFrom owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty logic:conjectureLifecycleState ; owl:allValuesFrom logic:ConjectureLifecycleState ] ,
    [ a owl:Restriction ; owl:onProperty logic:verdictProvenance ; owl:allValuesFrom logic:VerdictProvenanceKind ] .

logic:ContradictionWitness rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty logic:witnessIndividual ; owl:allValuesFrom xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty logic:witnessWorld ; owl:allValuesFrom xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty logic:witnessPremise ; owl:allValuesFrom xsd:string ] .

# Global at-most-one semantics for the carriers legacy SHACL constrained with maxCount 1.
logic:candidateSourceHash a owl:FunctionalProperty .
logic:candidateExtractionProvenance a owl:FunctionalProperty .
logic:candidateScope a owl:FunctionalProperty .
logic:candidateContract a owl:FunctionalProperty .
logic:candidateCategory a owl:FunctionalProperty .
logic:candidateLifecycle a owl:FunctionalProperty .
logic:candidateProjectionBehavior a owl:FunctionalProperty .
logic:candidateSemanticRisk a owl:FunctionalProperty .
logic:candidateFormalizes a owl:FunctionalProperty .
logic:candidateSourceField a owl:FunctionalProperty .
logic:planGoal a owl:FunctionalProperty .
logic:planSuccessMode a owl:FunctionalProperty .
logic:satisfactionStatus a owl:FunctionalProperty .
logic:feasibilityStatus a owl:FunctionalProperty .
logic:lifecycleStatus a owl:FunctionalProperty .
logic:goalEvaluationStatus a owl:FunctionalProperty .
logic:satisfactionDegree a owl:FunctionalProperty .
logic:objectiveValue a owl:FunctionalProperty .
logic:utility a owl:FunctionalProperty .
logic:effect a owl:FunctionalProperty .
logic:invariant a owl:FunctionalProperty .
logic:observation a owl:FunctionalProperty .
logic:actionResource a owl:FunctionalProperty .
logic:guardsPrecondition a owl:FunctionalProperty .
logic:freshnessHorizon a owl:FunctionalProperty .
logic:freshnessWindowStart a owl:FunctionalProperty .
logic:freshnessWindowEnd a owl:FunctionalProperty .
logic:obligationForbiddenPredicate a owl:FunctionalProperty .
logic:conjectureFormula a owl:FunctionalProperty .
logic:conjectureStandpoint a owl:FunctionalProperty .
logic:conjectureLifecycleState a owl:FunctionalProperty .
logic:verdictProvenance a owl:FunctionalProperty .
logic:witnessIndividual a owl:FunctionalProperty .
logic:witnessWorld a owl:FunctionalProperty .

# Flagship acceptance witnesses: each required carrier is canonical, typed, and retains its
# exact failure class through the generated validation-shape projection.
logic:ClosureAcceptanceWitness
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty logic:closureEntailedAtom ; owl:allValuesFrom xsd:string ] ;
    gmeow:enforcesFailureClass logic:IncompleteClosure .
logic:SectionAcceptanceWitness
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty logic:dischargesSectionObligation ; owl:allValuesFrom owl:Thing ] ;
    gmeow:enforcesFailureClass logic:SectionObligationViolated .
logic:CounterfactualAcceptanceWitness
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty logic:selectedByEntrenchment ; owl:allValuesFrom owl:Thing ] ;
    gmeow:enforcesFailureClass logic:UnentrenchedCounterfactual .
logic:RefutationAcceptanceWitness
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty logic:namesContradictionWitness ; owl:allValuesFrom logic:ContradictionWitness ] ;
    gmeow:enforcesFailureClass logic:UnwitnessedRefutation .
logic:ChaseAcceptanceWitness
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty logic:carriesTerminationCertificate ; owl:allValuesFrom xsd:string ] ;
    gmeow:enforcesFailureClass logic:UncertifiedChase .

# =========================================================================== #
# Authored procedural-constraint records (grounding slices). Each compact
# logic:Constraint sugar record is compiled here (the canonical logic: terminal)
# and PROJECTED to generated/shapes/procedural-constraints.ttl as a
# sh:SPARQLConstraint carrying logic:formalizes the grounding term it enforces
# (Principle 17 — logic: is canonical, SHACL is the projection). Only the
# forward-from-focus fragment (P1-P7 / aggregate) is expressible here; genuinely
# cross-node / arithmetic / inverse-path / property-path grounding conditions have
# no range-restricted guarded SPARQL-constraint form and stay as the hand-authored
# sh:sparql shapes in each slice's shapes.ttl.
# =========================================================================== #

# math:RationalValue — a zero math:denominator is not a rational value (p/0 is
# undefined; math:ZeroDenominator). A forbidden-pattern constraint pinned to the
# value 0: the projected sh:SPARQLConstraint selects any rational carrying
# math:denominator 0.
logic:RationalValueNonZeroDenominatorConstraint
    a logic:ForbiddenPatternConstraint ;
    logic:onClass math:RationalValue ;
    logic:forbiddenPredicate math:denominator ;
    logic:forbiddenValue 0 ;
    logic:formalizes math:RationalValue ;
    logic:message "A math:RationalValue must declare a non-zero math:denominator; a zero denominator is not a rational value (math:ZeroDenominator)." .

logic:valuePredicate
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "value predicate"@x-gmeow-english ;
    skos:definition "The fixed check predicate of a logic:PathValueTypeConstraint's fixed-value variant: every value the focus carries on logic:valuePath must itself carry this predicate with object logic:valueObject (Q(v, o)), rather than being an instance of a logic:valueClass. Paired with logic:valueObject; mutually exclusive with logic:valueClass."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:valueObject
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "value object"@x-gmeow-english ;
    skos:definition "The fixed object of a logic:PathValueTypeConstraint's fixed-value variant: the required object (an IRI or a literal) of logic:valuePredicate on every value reached by logic:valuePath."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .


# =========================================================================== #
# Procedural constraint authored as a raw logic:Formula integrity tree —        #
# projected to a sh:SPARQLConstraint. logic:formalizes keys the projected twin  #
# onto gmeow:Goal, the source-term of the hand-authored SHACL it replaces.      #
# =========================================================================== #

# A conclusive gmeow:satisfiedBy(goal, situation) edge must be backed by at least
# one logic:GoalEvaluation under SOME vantage whose logic:evaluatesGoal is the
# goal, logic:evaluatedAgainst is the situation, logic:satisfactionStatus is
# logic:Satisfied, and logic:goalEvaluationStatus is logic:GoalEvaluationCompleted.
logic:SatisfiedByBackedByEvaluationConstraint
    a logic:Constraint ;
    rdfs:label "satisfiedBy backed-by-evaluation constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a conclusive gmeow:satisfiedBy edge is backed by a vantage-scoped logic:GoalEvaluation that evaluatesGoal this goal, was evaluatedAgainst the situation, and is Satisfied and completed."@x-gmeow-english ;
    logic:formalizes logic:SatisfiedByBackedByEvaluationShape ;
    logic:message "A conclusive gmeow:satisfiedBy edge must be backed by a vantage-scoped logic:GoalEvaluation (evaluatesGoal = this goal, evaluatedAgainst = the situation, satisfactionStatus = logic:Satisfied, goalEvaluationStatus = logic:GoalEvaluationCompleted). No backing evaluation under any vantage was found." ;
    logic:integrity logic:sbeForall .
logic:sbeForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "situation" ] ;
    logic:forall logic:sbeImpl .
logic:sbeImpl a logic:Formula ; logic:antecedent logic:sbeGuard ; logic:consequent logic:sbeExists .
logic:sbeGuard a logic:Formula ; logic:and logic:sbeType , logic:sbeSat .
logic:sbeType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Goal ] .
logic:sbeSat a logic:Formula ; logic:relation gmeow:satisfiedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "situation" ] .
logic:sbeExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "eval" ] ;
    logic:exists logic:sbeBody .
logic:sbeBody a logic:Formula ; logic:and logic:sbeB1 , logic:sbeB2 , logic:sbeB3 , logic:sbeB4 .
logic:sbeB1 a logic:Formula ; logic:relation logic:evaluatesGoal ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "eval" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:sbeB2 a logic:Formula ; logic:relation logic:evaluatedAgainst ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "eval" ] , [ logic:termIndex 1 ; logic:termVariable "situation" ] .
logic:sbeB3 a logic:Formula ; logic:relation logic:satisfactionStatus ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "eval" ] , [ logic:termIndex 1 ; logic:termIri logic:Satisfied ] .
logic:sbeB4 a logic:Formula ; logic:relation logic:goalEvaluationStatus ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "eval" ] , [ logic:termIndex 1 ; logic:termIri logic:GoalEvaluationCompleted ] .

# =========================================================================== #
# Procedural constraints for conditional FreshnessGuard and Conjecture obligations,
# authored as raw logic:Formula integrity trees and projected to SHACL (Principle 17).
# =========================================================================== #

# A logic:FreshnessGuard that declares a logic:freshnessWindow must carry BOTH a
# logic:freshnessWindowStart AND a logic:freshnessWindowEnd (the closed interval
# bounds). Violation: a window present with either bound absent — a raw formula
# whose two co-occur arms each re-bind the focus through the window predicate.
logic:FreshnessGuardWindowBoundsConstraint
    a logic:Constraint ;
    rdfs:label "FreshnessGuard window-bounds constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a logic:FreshnessGuard declaring a logic:freshnessWindow carries both a logic:freshnessWindowStart and a logic:freshnessWindowEnd — a half-declared window gates on an ill-defined interval."@x-gmeow-english ;
    logic:formalizes logic:FreshnessGuardShape ;
    logic:severity "Violation" ;
    logic:message "A FreshnessGuard that declares a logic:freshnessWindow must carry BOTH a logic:freshnessWindowStart AND a logic:freshnessWindowEnd (the closed interval bounds); the property shapes already cap each bound at one." ;
    logic:integrity logic:fgwForall .
logic:fgwForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:fgwImpl .
logic:fgwImpl a logic:Formula ; logic:antecedent logic:fgwGuard ; logic:consequent logic:fgwPhi .
logic:fgwGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri logic:FreshnessGuard ] .
logic:fgwPhi a logic:Formula ; logic:not logic:fgwBad .
logic:fgwBad a logic:Formula ; logic:or logic:fgwBadStart , logic:fgwBadEnd .
logic:fgwBadStart a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "w" ] ;
    logic:exists logic:fgwStartBody .
logic:fgwStartBody a logic:Formula ; logic:and logic:fgwStartWin , logic:fgwNoStart .
logic:fgwStartWin a logic:Formula ; logic:relation logic:freshnessWindow ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "w" ] .
logic:fgwNoStart a logic:Formula ; logic:not logic:fgwStartEx .
logic:fgwStartEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "s" ] ;
    logic:exists logic:fgwStartAtom .
logic:fgwStartAtom a logic:Formula ; logic:relation logic:freshnessWindowStart ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
logic:fgwBadEnd a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "w2" ] ;
    logic:exists logic:fgwEndBody .
logic:fgwEndBody a logic:Formula ; logic:and logic:fgwEndWin , logic:fgwNoEnd .
logic:fgwEndWin a logic:Formula ; logic:relation logic:freshnessWindow ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "w2" ] .
logic:fgwNoEnd a logic:Formula ; logic:not logic:fgwEndEx .
logic:fgwEndEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "e" ] ;
    logic:exists logic:fgwEndAtom .
logic:fgwEndAtom a logic:Formula ; logic:relation logic:freshnessWindowEnd ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "e" ] .

# A logic:Conjecture whose logic:conjectureLifecycleState is
# logic:ConjectureRefutedInStandpoint must name at least one
# logic:conjectureRefutationWitness (a concrete logic:ContradictionWitness); a
# refutation with no witness is a hard error — a raw guarded-existence formula.
logic:ConjectureRefutationWitnessConstraint
    a logic:Constraint ;
    rdfs:label "Conjecture refutation-witness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a logic:Conjecture in logic:ConjectureRefutedInStandpoint names at least one logic:conjectureRefutationWitness — the concrete logic:ContradictionWitness backing the refutation."@x-gmeow-english ;
    logic:formalizes logic:ConjectureShape ;
    logic:severity "Violation" ;
    logic:message "A Conjecture in logic:ConjectureRefutedInStandpoint must name at least one logic:conjectureRefutationWitness (the concrete logic:ContradictionWitness); a refutation with no witness is a hard error." ;
    logic:integrity logic:crwForall .
logic:crwForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:crwImpl .
logic:crwImpl a logic:Formula ; logic:antecedent logic:crwGuard ; logic:consequent logic:crwExists .
logic:crwGuard a logic:Formula ; logic:and logic:crwType , logic:crwRefuted .
logic:crwType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri logic:Conjecture ] .
logic:crwRefuted a logic:Formula ; logic:relation logic:conjectureLifecycleState ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri logic:ConjectureRefutedInStandpoint ] .
logic:crwExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "w" ] ;
    logic:exists logic:crwAtom .
logic:crwAtom a logic:Formula ; logic:relation logic:conjectureRefutationWitness ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "w" ] .

# =========================================================================== #
# Flagship acceptance — the typed conformance-failure lattice and the five
# scenario acceptance witnesses.
#
# The logic grounding layer's depth bar is defined by five flagship acceptance
# scenarios (design/LOGIC-CONFORMANCE.md, LOGIC-CORRESPONDENCE.md,
# LOGIC-SEMANTICS.md, LOGIC-CONTRACT.md, LOGIC-RUNTIME.md), each realized by a
# worked example, pinned by a competency question, emitted by a native producer,
# and guarded by a counter-example that raises a named failure class. This section
# mints that failure lattice — logic:LogicConformanceFailure and its subclasses —
# and the five acceptance-witness classes whose single required carrier the thin
# per-scenario shapes enforce, so every acceptance malformation is a typed,
# queryable object rather than a silent gap.
# =========================================================================== #

logic:LogicConformanceFailure
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Logic Conformance Failure"@x-gmeow-english ;
    skos:definition "The root of the logic grounding layer's typed conformance-failure lattice: every well-formedness violation the logic: slice detects is an instance of one of its subclasses, so a failure is a first-class queryable object rather than an out-of-band error string. Its five bedrock subclasses cover the flagship acceptance scenarios — an incomplete EL/RL/DL closure, a violated correspondence section obligation, an unentrenched counterfactual, an unwitnessed refutation, and an uncertified chase — plus logic:UnwiredFlagshipScenario for an acceptance scenario that does not bind all its realizing/enforcing artifacts."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:IncompleteClosure
    a owl:Class ;
    rdfs:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Incomplete Closure"@x-gmeow-english ;
    skos:definition "The failure raised when a logic:ClosureAcceptanceWitness — the acceptance record of an EL→RL→DL reasoning closure — declares no logic:closureEntailedAtom, i.e. names no atom the closure entails beyond its asserted EDB. A closure that adds nothing is either trivial or truncated; the flagship's guarantee is that the native reason_all closure genuinely derives new entailed atoms, so a witness carrying none is ill-formed and the gate rejects it. It is not an interchangeable alias for a broader, narrower, or merely related construct; use logic:IncompleteClosure only under the stated identity and validation conditions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:SectionObligationViolated
    a owl:Class ;
    rdfs:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Section Obligation Violated"@x-gmeow-english ;
    skos:definition "The failure raised when a logic:SectionAcceptanceWitness — the acceptance record of a correspondence section-law discharge — names no logic:dischargesSectionObligation edge, i.e. claims a get/put leg pair round-trips without pointing at the section obligation it discharges. The section law (put ∘ get = identity) is the correspondence's teeth; a witness that discharges no obligation is unfalsifiable, so the gate rejects it (LOGIC-CORRESPONDENCE.md). It is not an interchangeable alias for a broader, narrower, or merely related construct; use logic:SectionObligationViolated only under the stated identity and validation conditions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:UnentrenchedCounterfactual
    a owl:Class ;
    rdfs:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Unentrenched Counterfactual"@x-gmeow-english ;
    skos:definition "The failure raised when a logic:CounterfactualAcceptanceWitness — the acceptance record of a Stratum-C counterfactual resolution — names no logic:selectedByEntrenchment outcome, i.e. resolves an antecedent without recording the entrenchment-ranked selection that made the result deterministic. A counterfactual whose outcome is not tied to an entrenchment ordering is a silent, arbitrary choice; the flagship's guarantee is a deterministic entrenchment-ranked selection, so a witness with none is ill-formed (LOGIC-SEMANTICS.md)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:UnwitnessedRefutation
    a owl:Class ;
    rdfs:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Unwitnessed Refutation"@x-gmeow-english ;
    skos:definition "The failure raised when a logic:RefutationAcceptanceWitness — the acceptance record of a symmetric φ/¬φ conjecture test whose verdict is a refutation — names no logic:namesContradictionWitness, i.e. claims the conjecture was refuted without pointing at the concrete logic:ContradictionWitness that carries the clash. A refutation with no replayable witness is an assertion, not a proof; the flagship's guarantee is that conjecture_test returns a concrete witness on a refutation, so a witness-less refutation record is ill-formed (LOGIC-CONTRACT.md)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:UncertifiedChase
    a owl:Class ;
    rdfs:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Uncertified Chase"@x-gmeow-english ;
    skos:definition "The failure raised when a logic:ChaseAcceptanceWitness — the acceptance record of an existential-rule chase materialization — carries no logic:carriesTerminationCertificate, i.e. reports a materialized closure without the weak-acyclicity termination certificate that admits it. An uncertified chase may not terminate; the flagship's guarantee is that materialize_routed surfaces the ChaseAdmission termination certificate as a first-class gmeow:Finding, so a chase acceptance record with no certificate is ill-formed (LOGIC-RUNTIME.md)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:UnwiredFlagshipScenario
    a owl:Class ;
    rdfs:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Unwired Flagship Scenario"@x-gmeow-english ;
    skos:definition "The failure raised when a gmeow:FlagshipScenario in the logic grounding layer is not fully wired: it is missing its worked example (gmeow:demonstratedByExample), its competency question (gmeow:demonstratedByCompetency), its producer (gmeow:demonstratedByProducer), its counter-example (gmeow:guardedByCounterExample), or its enforcing failure class (gmeow:enforcesFailureClass); or the class it names as enforcing is not a logic:LogicConformanceFailure subclass. The depth bar is a contract, not a suggestion: an acceptance scenario that does not bind all realizing/enforcing artifacts cannot claim the scenario is met, and the gate rejects it. This layer's concrete realization of the shared gmeow:UnwiredFlagshipScenario marker (enforced uniformly by the shared gmeow:FlagshipScenarioShape); it subclasses ONLY the slice failure root (never the spec-layer gmeow:UnwiredFlagshipScenario marker), so it is a typed, queryable object in this layer's own failure lattice."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# The slice-owned flagship failure-range gate. Its canonical formula requires every enforcing
# class to lie in the transitive LogicConformanceFailure hierarchy; the projector emits the SHACL
# path check and preserves the exact failure type attached to this validation obligation. The
# rdf:type guard is carried inside the formula so this grounding slice does not re-own or retype the
# test-DSL's gmeow:FlagshipScenario term.
logic:FlagshipScenarioFailureClassConstraint
    a logic:Constraint ;
    rdfs:label "Flagship scenario failure-class constraint"@x-gmeow-english ;
    skos:definition "Requires every failure class named by a logic-slice flagship scenario to be a logic:LogicConformanceFailure or one of its subclasses."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:enforcesFailureClass logic:UnwiredFlagshipScenario ;
    logic:formalizes logic:FlagshipScenarioShape ;
    logic:message "A flagship scenario's enforcing failure class must be a logic:LogicConformanceFailure subclass." ;
    logic:integrity logic:fsfcForall .
logic:fsfcForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "failure" ] ;
    logic:forall logic:fsfcImpl .
logic:fsfcImpl a logic:Formula ; logic:antecedent logic:fsfcGuard ; logic:consequent logic:fsfcMembership .
logic:fsfcGuard a logic:Formula ; logic:and logic:fsfcType , logic:fsfcFailurePath .
logic:fsfcType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:FlagshipScenario ] .
logic:fsfcFailurePath a logic:Formula ; logic:relation gmeow:enforcesFailureClass ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "failure" ] .
logic:fsfcMembership a logic:Formula ; logic:relation rdfs:subClassOf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "failure" ] , [ logic:termIndex 1 ; logic:termIri logic:LogicConformanceFailure ] .

# --- The five scenario acceptance-witness classes and their carriers -------- #

logic:ClosureAcceptanceWitness
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Closure Acceptance Witness"@x-gmeow-english ;
    skos:definition "The acceptance record that an EL→RL→DL reasoning closure (gmeow_logic::reason::reason_all) genuinely entailed new atoms: it names, through logic:closureEntailedAtom, at least one atom the closure derived beyond its asserted EDB. The flagship producer runs the native closure and pins that a designated entailed atom is present and absent from the EDB; this witness is the ontological twin the thin logic:ClosureAcceptanceWitnessShape gates. It is not an interchangeable alias for a broader, narrower, or merely related construct; use logic:ClosureAcceptanceWitness only under the stated identity and validation conditions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:closureEntailedAtom
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "closure entailed atom"@x-gmeow-english ;
    skos:definition "Relates a logic:ClosureAcceptanceWitness to a serialized atom (xsd:string, e.g. `A subClassOf C`) that the EL→RL→DL closure entails but the asserted EDB does not contain. Domain logic:ClosureAcceptanceWitness (stated in prose). At least one is required: a closure witness that entails nothing beyond its input demonstrates no reasoning."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:SectionAcceptanceWitness
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Section Acceptance Witness"@x-gmeow-english ;
    skos:definition "The acceptance record that a correspondence get/put leg pair discharges its section law (put ∘ get = identity), executed natively by gmeow_logic::correspondence_exec::leg_pair_verdict. It names, through logic:dischargesSectionObligation, the section obligation the executed round-trip discharges. The flagship producer runs the native discharge and pins that a genuine inverse yields DischargeVerdict::ObligationDischarged while a broken section does not; this witness is the ontological twin the thin logic:SectionAcceptanceWitnessShape gates."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:dischargesSectionObligation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "discharges section obligation"@x-gmeow-english ;
    skos:definition "Relates a logic:SectionAcceptanceWitness to the section obligation (an IRI) its executed get/put round-trip discharges. Domain logic:SectionAcceptanceWitness (stated in prose). Exactly the edge whose absence makes the discharge unfalsifiable: a section witness that names no obligation asserts a round-trip without saying which law it satisfies. It is not an interchangeable alias for a broader, narrower, or merely related construct; use logic:dischargesSectionObligation only under the stated identity and validation conditions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:CounterfactualAcceptanceWitness
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Counterfactual Acceptance Witness"@x-gmeow-english ;
    skos:definition "The acceptance record that a Stratum-C counterfactual world was constructed and resolved to a deterministic outcome, executed natively by gmeow_logic::counterfactual::construct_and_resolve over the entrenchment ordering. It names, through logic:selectedByEntrenchment, the outcome the entrenchment ranking selected. The flagship producer runs the native resolution and pins the deterministic selected binding; this witness is the ontological twin the thin logic:CounterfactualAcceptanceWitnessShape gates. It is not an interchangeable alias for a broader, narrower, or merely related construct; use logic:CounterfactualAcceptanceWitness only under the stated identity and validation conditions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:selectedByEntrenchment
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "selected by entrenchment"@x-gmeow-english ;
    skos:definition "Relates a logic:CounterfactualAcceptanceWitness to the outcome (an IRI) the entrenchment ranking deterministically selected when resolving the counterfactual antecedent. Domain logic:CounterfactualAcceptanceWitness (stated in prose). Its absence marks an unentrenched, arbitrary counterfactual: an outcome chosen without a recorded ordering is a silent guess. It is not an interchangeable alias for a broader, narrower, or merely related construct; use logic:selectedByEntrenchment only under the stated identity and validation conditions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:RefutationAcceptanceWitness
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Refutation Acceptance Witness"@x-gmeow-english ;
    skos:definition "The acceptance record that a symmetric φ/¬φ conjecture test resolved to a refutation carrying a concrete contradiction witness, executed natively by gmeow_logic::conjecture::conjecture_test. It names, through logic:namesContradictionWitness, the logic:ContradictionWitness the refutation rests on. The flagship producer runs the native test and pins that a refutation case yields Some(witness) while a corroboration case yields None; this witness is the ontological twin the thin logic:RefutationAcceptanceWitnessShape gates. It is not an interchangeable alias for a broader, narrower, or merely related construct; use logic:RefutationAcceptanceWitness only under the stated identity and validation conditions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:namesContradictionWitness
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "names contradiction witness"@x-gmeow-english ;
    skos:definition "Relates a logic:RefutationAcceptanceWitness to the concrete logic:ContradictionWitness (an IRI) its refutation rests on — the individual forced to owl:Nothing and the jointly-inconsistent premises. Domain logic:RefutationAcceptanceWitness (stated in prose). A refutation naming no witness is an unreplayable assertion, not a proof."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:ChaseAcceptanceWitness
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Chase Acceptance Witness"@x-gmeow-english ;
    skos:definition "The acceptance record that an existential-rule chase materialization terminated under a weak-acyclicity certificate, executed natively by gmeow_logic::materialize::materialize_routed, which surfaces the ChaseAdmission termination certificate as a first-class gmeow:Finding. It carries, through logic:carriesTerminationCertificate, the certificate evidence. The flagship producer runs the native chase and pins that the surfaced Finding is non-empty and that the derivation carries an explain trace passing gmeow_logic::explain::assert_faithful; this witness is the ontological twin the thin logic:ChaseAcceptanceWitnessShape gates. It is not an interchangeable alias for a broader, narrower, or merely related construct; use logic:ChaseAcceptanceWitness only under the stated identity and validation conditions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:carriesTerminationCertificate
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "carries termination certificate"@x-gmeow-english ;
    skos:definition "Relates a logic:ChaseAcceptanceWitness to the weak-acyclicity termination-certificate evidence (xsd:string, the ChaseAdmission::WeaklyAcyclic evidence summary) that admits its chase. Domain logic:ChaseAcceptanceWitness (stated in prose). A chase acceptance record with no certificate reports a closure that may never terminate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

