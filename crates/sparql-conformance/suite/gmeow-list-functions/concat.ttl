#
# Expected CONSTRUCT output for listConcat(( x y z ), ( x y z )) → ( x y z x y z ).
# Blank-node cell labels are compared isomorphically (RDFC-1.0 canonical N-Quads).
@prefix : <http://gmeow.test/list#> .

:out :has ( :x :y :z :x :y :z ) .
