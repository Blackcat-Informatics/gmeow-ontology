#
# Worked example for the ANALYSIS-AND-GEOMETRY charter: the charter's chart on a
# Lorentzian manifold (the math-side object a physics slice builds spacetime on),
# plus a derivative as a binder over the AST, a two-sided limit, an absolutely
# convergent series, and a set-theoretic complement — one instance of each of the
# five competency questions. Every individual is well-formed against the slice
# shapes (manifold declares dimension + structure kind; chart names domain, map,
# and target with matching dimension; complement names ambient space + semantics).
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/math/> .

# --- A chart on a Lorentzian manifold (the charter's worked example) -------- #

ex:minkowski a math:LorentzianManifold ;
    rdfs:label "Minkowski spacetime (as a math object)"@x-gmeow-english ;
    math:manifoldDimension 4 ;
    math:manifoldStructureKind math:lorentzianStructure ;
    math:hasChart ex:inertialChart ;
    math:metricTensor ex:minkowskiMetric .

ex:inertialChart a math:Chart ;
    math:chartDomain ex:inertialRegion ;
    math:coordinateMap ex:inertialCoordinateFn ;
    math:targetCoordinateSpace ex:realFourSpace .

ex:inertialRegion a math:OpenSet .

ex:inertialCoordinateFn a math:CoordinateMap ;
    math:domain ex:inertialRegion ;
    math:codomain ex:realFourSpace .

ex:realFourSpace a math:Set ;
    math:spaceDimension 4 .

ex:minkowskiMetric a math:MetricTensor ;
    math:tensorFieldOn ex:minkowski ;
    math:metricSignature ex:minkowskiSignature .

# Signature (3, 1): three spacelike, one timelike — the Lorentzian signature.
ex:minkowskiSignature a math:MetricSignature ;
    math:signaturePositive 3 ;
    math:signatureNegative 1 .

# The tangent space at a point, of the same dimension as the manifold.
ex:tangentAtOrigin a math:TangentSpace ;
    math:tangentSpaceAt ex:originPoint ;
    math:tangentSpaceOf ex:minkowski ;
    math:spaceDimension 4 .

ex:originPoint a math:MathematicalObject .

# --- A derivative: a binder over the expression AST ------------------------- #

ex:dfdt a math:Derivative ;
    math:operator math:differentiationBinder ;
    math:derivativeOf ex:worldlineExpr ;
    math:withRespectToVariable ex:properTimeDecl ;
    math:derivativeOrder 1 ;
    math:boundVariable ex:properTimeDecl ;
    math:argumentSlot ex:dfdtSlot0 .

ex:dfdtSlot0 a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression ex:worldlineExpr .

ex:worldlineExpr a math:MathematicalExpression .
ex:properTimeDecl a math:VariableDeclaration .

# --- A two-sided limit ------------------------------------------------------ #

ex:worldlineLimit a math:Limit ;
    math:operator math:limitBinder ;
    math:limitOf ex:worldlineExpr ;
    math:limitPoint ex:originPoint ;
    math:limitMode math:limitTwoSided .

# --- Structured limit results ----------------------------------------------- #
# A limit that runs off to the positive pole: the result names the divergent
# outcome and carries math:PositiveInfinity as its value (a point on ℝ̄, never a
# finite literal). The Lorentz factor γ = 1/√(1 − v²/c²) → +∞ as v → c.
ex:lorentzFactorLimit a math:Limit ;
    math:operator math:limitBinder ;
    math:limitOf ex:lorentzFactorExpr ;
    math:limitPoint ex:lightSpeed ;
    math:limitMode math:limitFromLeft ;
    math:hasLimitResult ex:lorentzFactorResult .

ex:lorentzFactorResult a math:LimitResult ;
    math:limitOutcome math:divergesToPositiveInfinity ;
    math:limitResultValue math:PositiveInfinity .

ex:lorentzFactorExpr a math:MathematicalExpression .
ex:lightSpeed a math:MathematicalObject .

# A convergent limit: the result names math:convergesFinitely and carries a finite
# numeric literal. The proper-time integrand → 1 as v → 0 (the Newtonian limit).
ex:properTimeRateLimit a math:Limit ;
    math:operator math:limitBinder ;
    math:limitOf ex:properTimeRateExpr ;
    math:limitPoint ex:restVelocity ;
    math:limitMode math:limitTwoSided ;
    math:hasLimitResult ex:properTimeRateResult .

ex:properTimeRateResult a math:LimitResult ;
    math:limitOutcome math:convergesFinitely ;
    math:limitResultValue "1.0"^^xsd:double .

ex:properTimeRateExpr a math:MathematicalExpression .
ex:restVelocity a math:MathematicalObject .

# --- An absolutely convergent series ---------------------------------------- #

ex:properTimeSeries a math:Series ;
    math:operator math:summationBinder ;
    math:seriesTerm ex:properTimeTerm ;
    math:hasConvergence ex:properTimeConvergence .

ex:properTimeTerm a math:MathematicalExpression .
ex:properTimeConvergence a math:Convergence ;
    math:convergesTo ex:properTimeSum ;
    math:convergenceMode math:absoluteConvergence .

ex:properTimeSum a math:MathematicalObject .

# --- A set-theoretic complement --------------------------------------------- #

ex:causalComplement a math:Complement ;
    math:setOperationOn ex:lightcone ;
    math:ambientSpace ex:minkowski ;
    math:complementSemantics math:setTheoreticComplement .

ex:lightcone a math:Set .

# --- A conformal compactification of a radial half-line --------------------- #
# The unbounded radial half-line r ∈ [0, ∞) conformally compactified to the
# bounded coordinate interval ρ ∈ [0, 1] by the angle-preserving map ρ = r/(1+r),
# whose conformal factor Ω = 1/(1+r) rescales the metric so the infinite metric
# distance becomes finite. A single boundary point at ρ = 1 is adjoined — the
# ideal point r = +∞ the half-line approaches but never reaches. All four roles
# (original space, compactifying map, compactified space, boundary at infinity)
# plus the conformal factor are named, so this conforms to the derived
# math:CompactificationShape. Pure math: the geometry a Lorentzian-radial case
# reuses downstream, authored here neutrally.
ex:radialCompactification a math:ConformalCompactification ;
    rdfs:label "Conformal compactification of the radial half-line [0, ∞)"@x-gmeow-english ;
    math:originalSpace ex:radialHalfLine ;
    math:compactifyingMap ex:radialCompactifyingMap ;
    math:compactifiedSpace ex:compactifiedRadialInterval ;
    math:boundaryAtInfinity ex:radialIdealBoundary ;
    math:conformalFactor ex:radialConformalFactor .

# The original unbounded space: the radial half-line as a topological space.
ex:radialHalfLine a math:TopologicalSpace ;
    rdfs:label "The unbounded radial half-line r ∈ [0, ∞)"@x-gmeow-english .

# The compactifying map ρ = r/(1+r): a coordinate map from the half-line onto the
# bounded interval, so it declares its domain and codomain.
ex:radialCompactifyingMap a math:CoordinateMap ;
    rdfs:label "The compactifying map ρ = r/(1+r)"@x-gmeow-english ;
    math:domain ex:radialHalfLine ;
    math:codomain ex:compactifiedRadialInterval .

# The resulting bounded space: the closed unit interval [0, 1], its upper endpoint
# closed because the boundary point at infinity is adjoined as a member.
ex:compactifiedRadialInterval a math:Interval ;
    rdfs:label "The compactified radial interval [0, 1]"@x-gmeow-english ;
    math:lowerEndpoint "0.0"^^xsd:double ;
    math:upperEndpoint "1.0"^^xsd:double ;
    math:lowerInclusion math:closedEndpoint ;
    math:upperInclusion math:closedEndpoint .

# The boundary at infinity: the single ideal point ρ = 1 (r = +∞).
ex:radialIdealBoundary a math:BoundaryAtInfinity ;
    rdfs:label "The ideal point at infinity ρ = 1 (r = +∞)"@x-gmeow-english .

# The conformal factor Ω = 1/(1+r): a positive rescaling function on the half-line.
ex:radialConformalFactor a math:Function ;
    rdfs:label "The conformal factor Ω = 1/(1+r)"@x-gmeow-english ;
    math:domain ex:radialHalfLine ;
    math:codomain ex:positiveReals .

ex:positiveReals a math:Set .

# --- A worked piecewise function — pieces, monotonicity, and a plateau bound - #
# f(r) = { a strictly-decreasing core on [0, 1);  a near-zero plateau on [1, +∞) }.
# The case-split is DATA: two math:FunctionPiece parts, each over a fully-formed
# math:Interval, one carrying math:hasMonotonicity math:strictlyDecreasing and one
# a small math:hasBound over its math:boundOnInterval. Well-formed against the
# piecewise gate (≥ 1 math:hasPiece, exactly-one math:pieceDomain), the inherited
# function frame (math:domain/math:codomain), and the interval endpoint gate.
ex:radialDecayProfile a math:PiecewiseFunction ;
    rdfs:label "A piecewise radial profile: a strictly-decreasing core and a near-zero plateau"@x-gmeow-english ;
    math:domain ex:radialDecayDomain ;
    math:codomain ex:positiveReals ;
    math:hasPiece ex:coreDropPiece , ex:tailPlateauPiece .

ex:coreDropPiece a math:FunctionPiece ;
    rdfs:label "Core piece over [0, 1): strictly decreasing"@x-gmeow-english ;
    math:pieceDomain ex:coreDomain ;
    math:hasMonotonicity math:strictlyDecreasing ;
    math:hasAnalyticProperty math:convexity .

ex:tailPlateauPiece a math:FunctionPiece ;
    rdfs:label "Tail piece over [1, +∞): near-zero plateau"@x-gmeow-english ;
    math:pieceDomain ex:tailDomain ;
    math:hasBound "0.0001"^^xsd:double ;
    math:boundOnInterval ex:tailDomain ;
    math:hasAnalyticProperty math:boundedness .

ex:coreDomain a math:Interval ;
    rdfs:label "The half-open core interval [0, 1)"@x-gmeow-english ;
    math:lowerEndpoint "0.0"^^xsd:double ;
    math:upperEndpoint "1.0"^^xsd:double ;
    math:lowerInclusion math:closedEndpoint ;
    math:upperInclusion math:openEndpoint .

ex:tailDomain a math:Interval ;
    rdfs:label "The unbounded tail interval [1, +∞)"@x-gmeow-english ;
    math:lowerEndpoint "1.0"^^xsd:double ;
    math:upperEndpoint math:PositiveInfinity ;
    math:lowerInclusion math:closedEndpoint ;
    math:upperInclusion math:openEndpoint .

ex:radialDecayDomain a math:Set ;
    rdfs:label "The non-negative real half-line [0, +∞) the profile is defined on"@x-gmeow-english .
