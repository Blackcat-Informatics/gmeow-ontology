gmeow:eventTypeCensus rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/events> .
gmeow:eventTypeGraduation     a gmeow:EventType ; rdfs:label "graduation"@x-gmeow-english ;     skos:definition "Graduation from an educational program."@x-gmeow-english .
gmeow:eventTypeGraduation rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/events> .
gmeow:eventTypeMilitaryService a gmeow:EventType ; rdfs:label "military service"@x-gmeow-english ; skos:definition "A period of military service."@x-gmeow-english .
gmeow:eventTypeMilitaryService rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/events> .
gmeow:eventTypeWill           a gmeow:EventType ; rdfs:label "will"@x-gmeow-english ;           skos:definition "The making of a will."@x-gmeow-english .
gmeow:eventTypeWill rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/events> .
gmeow:eventTypeProbate        a gmeow:EventType ; rdfs:label "probate"@x-gmeow-english ;        skos:definition "The probate of an estate."@x-gmeow-english .
gmeow:eventTypeProbate rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/events> .
gmeow:eventTypeRetirement     a gmeow:EventType ; rdfs:label "retirement"@x-gmeow-english ;     skos:definition "Retirement from working life."@x-gmeow-english .
