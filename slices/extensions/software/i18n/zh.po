msgid "tagger time"
msgstr "标签创建时间"


msgctxt "https://blackcatinformatics.ca/gmeow/taggerTime|http://www.w3.org/2004/02/skos/core#definition"
msgid "The recorded tagger timestamp, when present, distinct from commit author time, committer time and this record’s observation time."
msgstr "存在时记录的标签创建者时间戳，区别于提交作者时间、提交者时间及该记录观察时间。"


msgctxt "https://blackcatinformatics.ca/gmeow/taggerTime|http://www.w3.org/2004/02/skos/core#example"
