gmeow:cellText
    a logic:DatatypeProperty ;
    logic:domain gmeow:TableCell ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:string rdf:langString rdf:dirLangString ) ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "source cell text"@x-gmeow-english ;
    skos:definition "The original textual content of a documentary cell, including an explicitly empty string. Preserve language and direction when supplied; absence is not an invented empty value."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this explicit part of the source structure or apparatus with its original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."@x-gmeow-english ;
    gmeow:howToUse "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."@x-gmeow-english ;
    skos:example "Retain this source meaning: ex:record gmeow:cellText \"source wording\"@en ."@x-gmeow-english .

gmeow:altText
    a logic:DatatypeProperty ;
    logic:domain gmeow:ContentBlock ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:string rdf:langString rdf:dirLangString ) ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "source alternative text"@x-gmeow-english ;
    skos:definition "The source's alternative description for perceiving a block's content. It is distinct from a displayed caption and does not type a figure block as a media file."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this explicit part of the source structure or apparatus with its original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."@x-gmeow-english ;
