    logic:exists gmeow:rocBody .
gmeow:rocBody a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "raw-math-result conjunction"@x-gmeow-english ;
    skos:definition "The conjunction of the forbidden-witness existential of gmeow:ResultObjectConflationConstraint: the computation produces ?r, ?r has type ?k, AND ?k is a math:-namespace IRI."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:and gmeow:rocProduces , gmeow:rocType , gmeow:rocMathNs .
gmeow:rocProduces a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "produces-result atom (negative)"@x-gmeow-english ;
    skos:definition "The gmeow:producesResult atom of gmeow:ResultObjectConflationConstraint's negative arm: the computation ?this produces the candidate raw result ?r."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation gmeow:producesResult ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] .
gmeow:rocType a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "result-type binding atom"@x-gmeow-english ;
    skos:definition "The rdf:type atom of gmeow:ResultObjectConflationConstraint's negative arm: binds the result ?r's type to the variable ?k tested against the math: namespace."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "r" ] , [ logic:termIndex 1 ; logic:termVariable "k" ] .
gmeow:rocMathNs a logic:Formula ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "math-namespace prefix test"@x-gmeow-english ;
    skos:definition "The logic:termStrStarts atom of gmeow:ResultObjectConflationConstraint: tests whether the result's type IRI ?k begins with the math: namespace prefix, witnessing a raw-math result."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:relation logic:termStrStarts ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "k" ] ,
        [ logic:termIndex 1 ; logic:termLiteral "https://blackcatinformatics.ca/math/" ] .

# =========================================================================== #
# The slice ontology header                                                    #
# =========================================================================== #

<https://blackcatinformatics.ca/gmeow/slices/semantic-topology>
    a owl:Ontology ;
    rdfs:comment "The extension mints ONLY bridge terms (Principle 19): it COMPOSES the shipped math: topology objects (math:CellComplex/math:SimplicialComplex, math:Filtration, math:Cell, math:PersistentHomology and the math:PersistenceDiagram/Barcode/Landscape/BettiSummary/HodgeDecomposition/Holonomy result artifacts, math:GlobalSection/math:LocalSection/math:GluingObstruction, math:StabilityCalibrationRecord/math:bottleneckStabilityTheorem), the logic: loss ledger (logic:preservationKind, logic:expressivenessBoundary), and the core claim/evidence/standpoint spine — grounding NOTHING itself and hand-authoring no shapes (the pipeline derives them). Compiled RDF 1.2 claim/evidence/proof INSTANCE data lives in the consumer lillith_decodes; this slice is the vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "GMEOW Semantic-Topology Module"@x-gmeow-english ;
    skos:definition "The semantic-topology consumer extension: it compiles RDF 1.2 claim/evidence/proof structures into declared math: complexes and filtrations, records the cell↔source correspondence and the preservation/loss judgment, runs persistent-homology computations whose results are attributed wrappers around math: objects, and wraps a computed feature as a standpoint-relative, defeasible gmeow:TopologyClaim carrying a theorem-warranted logic:confidence. Its governing rule: a computed topological feature over a standpoint's sub-evidence is a math:LocalSection and is NEVER automatically a global truth — global truth holds IFF the local data extend to a math:GlobalSection (H⁰), and the H¹ math:GluingObstruction is the computable witness of why they may not."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Tail registration — every minted class to its logic: metatype (mirroring the  #
# grounding slices' metatype layer): the object/activity/record kinds and the   #
# conformance-failure situations.                                               #
# =========================================================================== #

gmeow:ComplexCompilation a logic:Event .
gmeow:TopologyComputation a logic:Event .
gmeow:CellSourceCorrespondence a logic:Kind .
gmeow:CompilationPreservationRecord a logic:Kind .
gmeow:TopologyResult a logic:Kind .
gmeow:TopologyClaim a logic:SubKind .
gmeow:TopologyConformanceFailure a logic:Situation .
gmeow:CompilationMissingContext a logic:Situation .
gmeow:TopologyClaimMissingStatus a logic:Situation .
gmeow:ResultObjectConflation a logic:Situation .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:claimResultFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "claimResult is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:claimResult is functional: a topology claim wraps exactly one computed topology result, the single TopologyResult it makes a standpoint-relative claim about."@x-gmeow-english ;
    logic:characterizes gmeow:claimResult ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:claimResult ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:claimResult names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:claimResult, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:claimResultFunctionality logic:characterizes gmeow:claimResult ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:computationOverCompilationFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/semantic-topology> ;
    rdfs:label "computationOverCompilation is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:computationOverCompilation is functional: a topology computation runs over exactly one complex compilation, since a federated computation spanning several compilations is several computations under a parent activity."@x-gmeow-english ;
    logic:characterizes gmeow:computationOverCompilation ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:computationOverCompilation ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:computationOverCompilation names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:computationOverCompilation, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:example "gmeow:computationOverCompilationFunctionality logic:characterizes gmeow:computationOverCompilation ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .