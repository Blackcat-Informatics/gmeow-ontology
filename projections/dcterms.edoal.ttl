@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/dcterms> a align:Alignment ;
    rdfs:label "GMEOW → dcterms (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "Copyright year → dcterms:dateCopyrighted (flatten)"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:copyrightYear ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri dcterms:dateCopyrighted ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ],
        [ a align:Cell ;
            rdfs:label "hasLicense → dcterms:license"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasLicense ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri dcterms:license ] ;
            align:relation "=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "Copyright relator holder → dcterms:rightsHolder (flatten)"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:copyrightHolder ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri dcterms:rightsHolder ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "Copyright notice → dcterms:rights (flatten)"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:copyrightNotice ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri dcterms:rights ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "dcterms" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@en .
