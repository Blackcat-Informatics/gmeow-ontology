@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix logic:   <https://blackcatinformatics.ca/logic/> .

# =============================================================================
# GMEOW test DSL — the canonical authoring vocabulary for slice-resident,
# declarative test fixtures.
#
# GMEOW's doctrine is "one canonical source, everything else a generated/checked
# projection". A slice's tests/ directory carries its tests AS ONTOLOGY DATA: a
# competency question is a SPARQL ASK/SELECT plus an expected outcome and a
# rationale; a structural assertion is a MUST / MUST-NOT triple pattern or SHACL
# shape over the module; an example conformance binds an example file to its
# expected validation outcome. Authoring tests as gmeow: data — rather than as
# ad-hoc Python or shell — makes them inspectable, projectable, and driven by the
# same annotation discipline as every other GMEOW term.
#
# This file is a SPEC LAYER — grounded in the gmeow: namespace and annotated like
# every GMEOW term, but NOT owl:imports-ed into the reasoned OWL 2 DL core. It is
# the sibling of dsl/statements/vocabulary.ttl and dsl/mappings/vocabulary.ttl, not
# of ontology/modules/*. The test harness reads it; the reasoner does not.
# =============================================================================

<https://blackcatinformatics.ca/gmeow/test-dsl>
    a owl:Ontology ;
    rdfs:label "GMEOW test DSL vocabulary"@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    skos:definition "The GMEOW test DSL vocabulary — terms used to author slice-resident declarative test fixtures (competency questions, structural assertions, example-conformance fixtures) as ontology data, read and executed by the GMEOW test harness. A spec layer, never owl:imports-ed into the reasoned OWL 2 DL core."@x-gmeow-english ;
    rdfs:comment "Authoring vocabulary for slice-resident declarative tests — competency questions, structural assertions, and example-conformance fixtures — read and executed by the GMEOW test harness."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

# --------------------------------------------------------------------------- #
# The three test-cell types
# --------------------------------------------------------------------------- #

gmeow:CompetencyQuestion a owl:Class ;
    rdfs:label "competency question"@x-gmeow-english ;
    skos:definition "A declarative competency test: a SPARQL ASK or SELECT query (inline via gmeow:cqQuery or referenced via gmeow:cqQueryFile) paired with an expected outcome and a rationale, authored as ontology data resident in a slice's tests/ directory. An ASK question pins gmeow:cqExpectAsk; a SELECT question pins its result set via gmeow:cqExpectRow (preferred) or a coarse gmeow:cqExpectRowCount. By default the query runs over the asserted merged ontology (TBox); a question that classifies synthetic instances may overlay a slice-relative ABox fixture via gmeow:cqDataFile, which is inserted onto the asserted merged graph for that one cell only (and only in the gmeow:reasoningNone lane)."@x-gmeow-english ;
    skos:example "ex:cqHasName a gmeow:CompetencyQuestion ; gmeow:cqQuery \"ASK { ?p gmeow:hasName ?n }\" ; gmeow:cqExpectAsk true ; gmeow:cqRationale \"Every modelled person must expose a name.\" ."@x-gmeow-english ;
    gmeow:useWhen "Use to pin a question the ontology must be able to answer — a query whose result (a boolean for ASK, a row set for SELECT) is the acceptance criterion for a slice's modelling decisions."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for structural MUST / MUST-NOT invariants over the module graph (use gmeow:StructuralAssertion) and for example-validation outcomes (use gmeow:ExampleConformance); a competency question is about query-answerability, not graph well-formedness."@x-gmeow-english ;
    gmeow:howToUse "Author one instance per question in the slice's tests/ directory: give it a query (inline gmeow:cqQuery or a repo-root-relative gmeow:cqQueryFile), the expected outcome (gmeow:cqExpectAsk for ASK; enumerated gmeow:cqExpectRow with gmeow:cqExactRows true for SELECT), and a gmeow:cqRationale."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    logic:subClassOf [
        a logic:Restriction ;
        logic:onProperty gmeow:cqReasoning ;
        logic:allValuesFrom [ logic:oneOf ( gmeow:reasoningNone gmeow:reasoningRdfs ) ] ;
    ] .

gmeow:StructuralAssertion a owl:Class ;
    rdfs:label "structural assertion"@x-gmeow-english ;
    skos:definition "A triple-pattern (expressed as a SPARQL ASK via gmeow:saPattern) or a SHACL shape (referenced via gmeow:saShape) that MUST or MUST-NOT hold over a slice module — optionally including the module's examples/ — as fixed by gmeow:saPolarity and gmeow:saScope. The structural counterpart of a competency question: it constrains the shape of the graph rather than the answer to a query."@x-gmeow-english ;
    skos:example "ex:saAgentHasName a gmeow:StructuralAssertion ; gmeow:saPolarity gmeow:must ; gmeow:saPattern \"ASK { ?a a gmeow:Agent ; gmeow:hasName ?n }\" ; gmeow:saScope gmeow:scopeModuleAndExamples ; gmeow:saRationale \"Agents must carry a name.\" ."@x-gmeow-english ;
    gmeow:useWhen "Use to assert a MUST or MUST-NOT invariant about the structure of a slice module's graph — a pattern that has to hold (or must never hold), or a SHACL shape the module must satisfy."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for query-answerability acceptance criteria (use gmeow:CompetencyQuestion) and for per-example expected validation findings (use gmeow:ExampleConformance)."@x-gmeow-english ;
    gmeow:howToUse "Set gmeow:saPolarity to gmeow:must or gmeow:mustNot, supply EXACTLY ONE of gmeow:saPattern (a SPARQL ASK) or gmeow:saShape (an sh:NodeShape IRI), optionally narrow gmeow:saScope, and add a gmeow:saRationale explaining the invariant."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    logic:subClassOf [
        a logic:Restriction ;
        logic:onProperty gmeow:saPolarity ;
        logic:allValuesFrom [ logic:oneOf ( gmeow:must gmeow:mustNot ) ] ;
    ] ,
    [
        a logic:Restriction ;
        logic:onProperty gmeow:saScope ;
        logic:allValuesFrom [ logic:oneOf ( gmeow:scopeModule gmeow:scopeModuleAndExamples ) ] ;
    ] .

gmeow:ExampleConformance a owl:Class ;
    rdfs:label "example conformance"@x-gmeow-english ;
    skos:definition "An expected validation outcome binding an example or counter-example file (gmeow:exampleFile, slice-relative) to either gmeow:conforms or gmeow:violates a finding code. The fixture that pins what `make validate` is expected to say about a given example: a positive example must conform; a counter-example must violate a named code (gmeow:expectedViolationCode)."@x-gmeow-english ;
    skos:example "ex:ecBadAgent a gmeow:ExampleConformance ; gmeow:exampleFile \"examples/agent-missing-name.ttl\" ; gmeow:expectedOutcome gmeow:violates ; gmeow:expectedViolationCode \"shacl.MinCountConstraintComponent\" ."@x-gmeow-english ;
    gmeow:useWhen "Use to pin the expected SHACL/validation outcome for a specific example or counter-example file shipped with a slice — conformance for positive examples, a specific violation code for counter-examples."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for query-answerability (gmeow:CompetencyQuestion) and for graph-wide structural invariants not tied to a single example file (gmeow:StructuralAssertion)."@x-gmeow-english ;
    gmeow:howToUse "Name the slice-relative gmeow:exampleFile, set gmeow:expectedOutcome to gmeow:conforms (no code) or gmeow:violates with a gmeow:expectedViolationCode in the real `shacl.<FullConstraintComponentLocalName>` form, and optionally add a gmeow:conformanceRationale."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    logic:subClassOf [
        a logic:Restriction ;
        logic:onProperty gmeow:expectedOutcome ;
        logic:allValuesFrom [ logic:oneOf ( gmeow:conforms gmeow:violates ) ] ;
    ] .

# --------------------------------------------------------------------------- #
# Expected SELECT result rows / cells (helpers for CompetencyQuestion)
# --------------------------------------------------------------------------- #

gmeow:ExpectedRow a owl:Class ;
    rdfs:label "expected row"@x-gmeow-english ;
    skos:definition "One expected SELECT result row — a helper node grouping the per-variable gmeow:ExpectedCell bindings that together make up a single row of a competency question's expected result set. An expected row is an EXAMPLE-INSTANCE of the logic:ResultShape its question declares via gmeow:cqResultShape: the shape types the columns, the row witnesses one concrete binding of them."@x-gmeow-english ;
    skos:example "ex:row1 a gmeow:ExpectedRow ; gmeow:rowCell ex:cellName ."@x-gmeow-english ;
    gmeow:useWhen "Use to enumerate one row of the expected result set of a SELECT competency question — attach it to the question via gmeow:cqExpectRow and hang its cells via gmeow:rowCell."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for ASK questions (pin gmeow:cqExpectAsk instead) and as a place to record the variable bindings directly — each binding belongs in its own gmeow:ExpectedCell."@x-gmeow-english ;
    gmeow:howToUse "Mint one gmeow:ExpectedRow per expected row, give it one gmeow:rowCell per projected variable, and link the rows to the question via gmeow:cqExpectRow; set gmeow:cqExactRows true when the rows are the COMPLETE expected set."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:ExpectedCell a owl:Class ;
    rdfs:label "expected cell"@x-gmeow-english ;
    skos:definition "One variable-to-value binding within a gmeow:ExpectedRow: the SPARQL variable name (gmeow:cellVar, without the leading '?') bound to exactly one of an IRI value (gmeow:cellValueIri) or a literal value (gmeow:cellValueLiteral)."@x-gmeow-english ;
    skos:example "ex:cellName a gmeow:ExpectedCell ; gmeow:cellVar \"name\" ; gmeow:cellValueLiteral \"Lillith\" ."@x-gmeow-english ;
    gmeow:useWhen "Use to record the expected bound value of one SELECT variable in one expected row."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid binding both gmeow:cellValueIri and gmeow:cellValueLiteral on the same cell — exactly one is permitted (enforced by SHACL) — and avoid including the leading '?' in gmeow:cellVar."@x-gmeow-english ;
    gmeow:howToUse "Set gmeow:cellVar to the bare variable name and exactly one of gmeow:cellValueIri (for IRI bindings) or gmeow:cellValueLiteral (for literal bindings); group the cells under a gmeow:ExpectedRow via gmeow:rowCell."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

# --------------------------------------------------------------------------- #
# Enumeration marker classes (the three small controlled vocabularies)
# --------------------------------------------------------------------------- #

gmeow:AssertionPolarity a owl:Class ;
    rdfs:label "assertion polarity"@x-gmeow-english ;
    skos:definition "The polarity of a structural assertion: whether the pattern or shape MUST hold (gmeow:must) or MUST-NOT hold (gmeow:mustNot). The value vocabulary for gmeow:saPolarity."@x-gmeow-english ;
    gmeow:useWhen "Use as the value type for gmeow:saPolarity to declare whether a structural assertion is a positive (must hold) or negative (must not hold) invariant."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting further polarity individuals; the axis is the closed pair gmeow:must / gmeow:mustNot."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:AssertionScope a owl:Class ;
    rdfs:label "assertion scope"@x-gmeow-english ;
    skos:definition "The graph scope a structural assertion is evaluated over: the module alone (gmeow:scopeModule) or the module together with its examples/ (gmeow:scopeModuleAndExamples). The value vocabulary for gmeow:saScope."@x-gmeow-english ;
    gmeow:useWhen "Use as the value type for gmeow:saScope to narrow whether an assertion is checked against the module graph alone or the module plus its examples/."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting further scope individuals; the axis is the closed pair gmeow:scopeModule / gmeow:scopeModuleAndExamples."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:ConformanceOutcome a owl:Class ;
    rdfs:label "conformance outcome"@x-gmeow-english ;
    skos:definition "The expected validation outcome of an example: it conforms (gmeow:conforms) or it violates a constraint (gmeow:violates). The value vocabulary for gmeow:expectedOutcome."@x-gmeow-english ;
    gmeow:useWhen "Use as the value type for gmeow:expectedOutcome to declare whether an example file is expected to pass validation or to be rejected with a finding."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting further outcome individuals; the axis is the closed pair gmeow:conforms / gmeow:violates."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:ReasoningProfile a owl:Class ;
    rdfs:label "reasoning profile"@x-gmeow-english ;
    skos:definition "The entailment lane a competency question is evaluated under: the asserted merged graph alone (gmeow:reasoningNone, the default), the merged graph closed under RDFS (gmeow:reasoningRdfs), or the full native logic: reasoner (gmeow:reasoningLogic — the canonical entailment engine, over which a question whose answer is DERIVED by a first-order logic:Formula, not asserted, is checked). The value vocabulary for gmeow:cqReasoning. RDFS is deliberately the middle rung — it covers type/subsumption entailments at a fraction of the OWL-2-RL cost — while gmeow:reasoningLogic is the deliberate, opt-in heavy lane for law-entailment questions."@x-gmeow-english ;
    gmeow:useWhen "Use as the value type for gmeow:cqReasoning to declare whether a competency question runs over the asserted graph, its RDFS closure, or the native logic: entailment closure."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting further profile individuals casually; the axis is the ordered triple gmeow:reasoningNone / gmeow:reasoningRdfs / gmeow:reasoningLogic (a further OWL profile would be a deliberate future extension, not an ad-hoc value)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

# --------------------------------------------------------------------------- #
# Enumerated individuals
# --------------------------------------------------------------------------- #

gmeow:must a gmeow:AssertionPolarity ;
    rdfs:label "must"@x-gmeow-english ;
    skos:definition "Positive polarity: the structural assertion's pattern or shape MUST hold over the scoped graph; a run in which it fails to hold is a test failure."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:mustNot a gmeow:AssertionPolarity ;
    rdfs:label "must not"@x-gmeow-english ;
    skos:definition "Negative polarity: the structural assertion's pattern or shape MUST NOT hold over the scoped graph; a run in which it does hold is a test failure."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:scopeModule a gmeow:AssertionScope ;
    rdfs:label "scope: module"@x-gmeow-english ;
    skos:definition "The structural assertion is evaluated over the slice module graph alone, excluding the module's examples/."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:scopeModuleAndExamples a gmeow:AssertionScope ;
    rdfs:label "scope: module and examples"@x-gmeow-english ;
    skos:definition "The structural assertion is evaluated over the slice module graph together with its examples/. The default scope when gmeow:saScope is omitted."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:conforms a gmeow:ConformanceOutcome ;
    rdfs:label "conforms"@x-gmeow-english ;
    skos:definition "The expected validation outcome is conformance: the example file is expected to pass validation with no findings, so no gmeow:expectedViolationCode is permitted."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:violates a gmeow:ConformanceOutcome ;
    rdfs:label "violates"@x-gmeow-english ;
    skos:definition "The expected validation outcome is a violation: the counter-example file is expected to be rejected, and gmeow:expectedViolationCode names the specific finding code (`shacl.<FullConstraintComponentLocalName>`) that must be reported."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:reasoningNone a gmeow:ReasoningProfile ;
    rdfs:label "reasoning: none"@x-gmeow-english ;
    skos:definition "Evaluate the competency question over the ASSERTED merged ontology, with no materialized entailment — the default. SPARQL property paths (rdfs:subClassOf*, rdfs:subPropertyOf*) still compute transitive closure at query time, so most 'what kinds of X?' questions are answered correctly at no reasoning cost."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:reasoningRdfs a gmeow:ReasoningProfile ;
    rdfs:label "reasoning: RDFS"@x-gmeow-english ;
    skos:definition "Evaluate the competency question over the merged ontology closed under RDFS — the rdfs2/rdfs3 (domain/range typing), rdfs9 (rdf:type propagation up the class hierarchy), and rdfs5/rdfs7/rdfs11 (subproperty/subclass transitivity and property propagation) rules. Opt into this only when the answer depends on entailment a SPARQL property path cannot express. Computed natively in oxigraph via CONSTRUCT rules iterated to fixpoint — not the OWL 2 RL chase."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:reasoningLogic a gmeow:ReasoningProfile ;
    rdfs:label "reasoning: native logic:"@x-gmeow-english ;
    skos:definition "Evaluate the competency question over the FULL native logic: entailment closure — the canonical reasoner (gmeow_logic::reason::reason_program) run over the LogicProgram compiled from the merged sources, including its first-order logic:Formula ASTs. Opt into this when the expected answer is a consequent a law DERIVES, not an asserted fact — in particular a consequent reached through fixed-arity n-ary predication (a reified op/act/mul tuple), which neither the asserted lane nor RDFS can produce. This is the deliberate, opt-in heavy lane (it runs the native chase); the four math: algebra laws (associativity, the determinant homomorphism, the E8 group action, and homomorphic encryption) are its charter consumers."@x-gmeow-english ;
    gmeow:useWhen "Use when a competency question's answer is entailed by a logic:Formula (e.g. an equational law over reified n-ary operations) and is absent from the asserted graph and its RDFS closure."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for questions the asserted graph or its RDFS closure already answer — the native chase is the heaviest lane and pulls the full reasoner into the run; reach for it only for genuine law-entailment questions."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

# --------------------------------------------------------------------------- #
# CompetencyQuestion fields
# --------------------------------------------------------------------------- #

gmeow:cqQuery a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "competency query"@x-gmeow-english ;
    skos:definition "The inline SPARQL ASK or SELECT query text of a competency question. Mutually exclusive with gmeow:cqQueryFile: a question carries its query either inline here or by reference, never both."@x-gmeow-english ;
    skos:example "ex:cq gmeow:cqQuery \"ASK { ?p a gmeow:Person ; gmeow:hasName ?n }\" ."@x-gmeow-english ;
    gmeow:useWhen "Use for short, self-contained queries that read clearly inline in the test fixture."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for large or shared queries that already live as .rq files (use gmeow:cqQueryFile) and avoid pairing it with gmeow:cqQueryFile on the same question."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqQueryFile a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "competency query file"@x-gmeow-english ;
    skos:definition "A REPO-ROOT-RELATIVE path to an existing .rq file holding the competency question's SPARQL query. The base is ALWAYS the repository root — never the slice directory — so that both a shared `queries/competency/<name>.rq` and a slice-local `slices/<group>/<name>/queries/competency/<name>.rq` are addressable unambiguously by the same property. Mutually exclusive with gmeow:cqQuery."@x-gmeow-english ;
    skos:example "ex:cq gmeow:cqQueryFile \"slices/core/kernel/queries/competency/agent-has-name.rq\" ."@x-gmeow-english ;
    gmeow:useWhen "Use for queries that already exist as .rq files — shared competency queries under queries/competency/ or slice-local ones under slices/<group>/<name>/queries/competency/."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a SLICE-RELATIVE path: the base is the repository root, so do NOT write `queries/competency/x.rq` expecting it to resolve inside the slice — write the full repo-root path. Avoid pairing it with gmeow:cqQuery on the same question."@x-gmeow-english ;
    gmeow:howToUse "Write the path from the REPOSITORY ROOT, e.g. `queries/competency/<name>.rq` for a shared query or `slices/<group>/<name>/queries/competency/<name>.rq` for a slice-local one; the harness resolves it against the repo root in both cases."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqProject a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "competency projection query file"@x-gmeow-english ;
    skos:definition "A REPO-ROOT-RELATIVE path (the same base as gmeow:cqQueryFile) to an existing CONSTRUCT .rq file that MATERIALIZES a computed projection over the overlaid canon BEFORE the competency query runs. The harness runs the CONSTRUCT over the dataset the question is answered against (the merged ontology plus any gmeow:cqDataFile overlay) and UNIONS the constructed triples in, so a computed-projection edge (one that must never be hand-asserted, Principle 12) is present because the projection rule produced it — not because a human typed it. This is what makes a projection-agreement gate NON-CIRCULAR: the flat shortcut column is materialized by the rule and compared against the collapse of the canon, rather than being a second hand-typed copy of the same IRI."@x-gmeow-english ;
    skos:example "ex:cqAgreement gmeow:cqQueryFile \"slices/extensions/model-serving/queries/competency/audit.rq\" ; gmeow:cqProject \"slices/extensions/model-serving/queries/project/upper-projection.rq\" ; gmeow:cqDataFile \"tests/perf-recall.ttl\" ."@x-gmeow-english ;
    gmeow:useWhen "Use for a competency question that must exercise a COMPUTED PROJECTION (a generated-not-authored edge) so the projection is materialized by its CONSTRUCT rule over the canon rather than hand-asserted in the fixture — e.g. a projection-agreement gate proving flat == collapse(nested)."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a question whose query reads only authored edges (omit it — there is no projection to materialize) and never point it at an ASK/SELECT query: the projection file MUST be a CONSTRUCT that returns a graph."@x-gmeow-english ;
    gmeow:howToUse "Write the repo-root-relative path to a CONSTRUCT .rq file (like gmeow:cqQueryFile); the harness runs it over the overlaid dataset, unions the constructed triples in, then runs the competency query over the result."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqDataFile a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:range xsd:string ;
    rdfs:label "competency data file"@x-gmeow-english ;
    skos:definition "A SLICE-RELATIVE path to a .ttl file of synthetic instance data (an ABox) overlaid onto the asserted merged ontology for this one competency question only, then removed — resolved against the slice directory, NOT the repository root (the same base as gmeow:exampleFile, and the opposite of the repo-root-relative gmeow:cqQueryFile). The merged ontology is TBox-only, so a competency question that classifies instances (e.g. 'is this event a lie?') has nothing to match against the bare ontology; gmeow:cqDataFile supplies the instances. The overlay only applies in the gmeow:reasoningNone lane: pairing it with gmeow:reasoningRdfs is rejected, because the RDFS closure is computed before the overlay and would not see the fixture's entailments."@x-gmeow-english ;
    skos:example "ex:cqLie gmeow:cqQueryFile \"queries/competency/deception-lie.rq\" ; gmeow:cqDataFile \"tests/fixtures/deception-lie.ttl\" ; gmeow:cqExpectRow ex:lieRow ."@x-gmeow-english ;
    gmeow:useWhen "Use for a competency question whose query selects over INSTANCE data (an ABox classifier) rather than the asserted vocabulary — supply the synthetic instances as a slice-resident fixture and let the harness overlay them for that cell."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for questions answered by the asserted ontology alone (omit it — the merged TBox is the graph) and avoid pairing it with gmeow:cqReasoning gmeow:reasoningRdfs (the overlay is only honoured in the asserted lane)."@x-gmeow-english ;
    gmeow:howToUse "Write the path relative to the OWNING SLICE (e.g. `tests/fixtures/<name>.ttl`), author the synthetic instances the query is meant to classify in that .ttl, and pin the expected classification with gmeow:cqExpectRow; the harness overlays the fixture onto the asserted merged graph, runs the one query, and removes it again."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqRationale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "competency rationale"@x-gmeow-english ;
    skos:definition "The human-readable rationale for a competency question: why this query and this expected outcome are an acceptance criterion for the slice's modelling decisions."@x-gmeow-english ;
    skos:example "ex:cq gmeow:cqRationale \"A person with no retrievable name is not usefully modelled.\" ."@x-gmeow-english ;
    gmeow:useWhen "Use to record the modelling intent a competency question protects, so a reader understands what would be lost if the query stopped answering as expected."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqExpectAsk a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "expected ASK result"@x-gmeow-english ;
    skos:definition "The expected boolean result of an ASK competency question. Set on ASK questions only; SELECT questions pin their result set via gmeow:cqExpectRow / gmeow:cqExpectRowCount instead."@x-gmeow-english ;
    skos:example "ex:cq gmeow:cqExpectAsk true ."@x-gmeow-english ;
    gmeow:useWhen "Use on a competency question whose query is a SPARQL ASK, to pin the expected true/false answer."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid on SELECT questions — enumerate their expected rows with gmeow:cqExpectRow (and gmeow:cqExactRows) or, as an escape hatch, gmeow:cqExpectRowCount."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqExpectRow a owl:ObjectProperty ;
    rdfs:range gmeow:ExpectedRow ;
    rdfs:label "expected row"@x-gmeow-english ;
    skos:definition "Zero or more expected SELECT result rows of a competency question. Each value is a gmeow:ExpectedRow grouping the per-variable cells. The PREFERRED, maximal-fidelity way to pin a SELECT result: enumerate every expected row and set gmeow:cqExactRows true."@x-gmeow-english ;
    skos:example "ex:cq gmeow:cqExpectRow ex:row1, ex:row2 ; gmeow:cqExactRows true ."@x-gmeow-english ;
    gmeow:useWhen "Use to pin the expected result set of a SELECT competency question by full enumeration — one gmeow:ExpectedRow per expected row."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid on ASK questions (use gmeow:cqExpectAsk); avoid leaning on gmeow:cqExpectRowCount when full enumeration is feasible — the enumerated form is preferred."@x-gmeow-english ;
    gmeow:howToUse "Attach one gmeow:ExpectedRow per expected row and set gmeow:cqExactRows true when the enumerated rows are the COMPLETE expected set; leave gmeow:cqExactRows false (or absent) for a contains-check subset."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqExpectRowCount a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "expected row count"@x-gmeow-english ;
    skos:definition "A COARSE expected row count for a SELECT competency question: how many rows the query is expected to return, without pinning their content. An ESCAPE HATCH for not-yet-fully-migrated competency questions — the PREFERRED form is full enumeration via gmeow:cqExpectRow with gmeow:cqExactRows true."@x-gmeow-english ;
    skos:example "ex:cq gmeow:cqExpectRowCount 3 ."@x-gmeow-english ;
    gmeow:useWhen "Use ONLY as a temporary escape hatch when a SELECT question's rows are not yet fully enumerated and a coarse count is the most you can pin today."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid whenever full enumeration is feasible: prefer gmeow:cqExpectRow with gmeow:cqExactRows true, which pins both the count and the content of every row."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqExactRows a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "exact rows"@x-gmeow-english ;
    skos:definition "Whether the enumerated gmeow:cqExpectRow set is the COMPLETE expected result set (true) or merely a subset / contains-check (false). The true + fully-enumerated form is the preferred, maximal-fidelity way to pin a SELECT result, asserting that the query returns these rows AND NO OTHERS."@x-gmeow-english ;
    skos:example "ex:cq gmeow:cqExpectRow ex:row1 ; gmeow:cqExactRows true ."@x-gmeow-english ;
    gmeow:useWhen "Use true when the enumerated rows are the complete expected result (the maximal-fidelity, preferred form); use false for a contains-check that requires those rows to be present but tolerates others."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid leaving it absent on an enumerated SELECT question when you intend an exact match — make the completeness claim explicit with true."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqResultShape a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "competency result shape"@x-gmeow-english ;
    skos:definition "The typed result-set schema a SELECT competency question's result is contracted to: a logic:ResultShape (range stated in prose, the test-DSL convention) declaring one typed column per projected variable (term-kind, optional datatype, binding) and a row-set cardinality. The schema-level generalisation of the example-row idiom — the question's gmeow:ExpectedRow values become example-instances of this shape, and the harness validates the actual SELECT bindings against it (a wrong term-kind, datatype, missing required column, or extra column hard-fails). Maps to logic:producesResultShape."@x-gmeow-english ;
    skos:example "ex:cq gmeow:cqResultShape ex:agentShape . ex:agentShape a logic:ResultShape ; logic:declaresColumn [ logic:columnVariable \"agent\" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ; logic:shapeCardinality logic:RowsExact ."@x-gmeow-english ;
    gmeow:useWhen "Use to pin the typed schema of a SELECT competency question's result — the maximal-fidelity contract that types each projected variable, not just its example bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid on ASK questions (use gmeow:cqExpectAsk). The shape complements gmeow:cqExpectRow (the example-instances); it does not replace the rationale."@x-gmeow-english ;
    gmeow:howToUse "Mint one logic:ResultShape individual in the slice's tests/ directory with one logic:declaresColumn per projected SELECT variable (logic:columnVariable + logic:columnTermKind + optional logic:columnDatatype + logic:columnBinding) and a logic:shapeCardinality; link it to the question via gmeow:cqResultShape; keep the gmeow:ExpectedRow values as its example-instances."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqInputShape a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "competency input shape"@x-gmeow-english ;
    skos:definition "The typed input contract this question expects from the upstream producer named by gmeow:cqConsumes; validated before execution by checking the producer's gmeow:cqResultShape satisfies it (structural input→output compatibility); maps to logic:expectsInputShape."@x-gmeow-english ;
    skos:example "ex:cq gmeow:cqInputShape ex:inputShape ; gmeow:cqConsumes ex:upstreamQuestion ."@x-gmeow-english ;
    gmeow:useWhen "Use together with gmeow:cqConsumes to declare the typed contract a producer's output must satisfy before this question executes — the column set and term-kinds the producer must cover."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid without a paired gmeow:cqConsumes (there is no producer to check against), and on ASK questions."@x-gmeow-english ;
    gmeow:howToUse "Mint a logic:ResultShape for the required input columns and link it via gmeow:cqInputShape; also declare the upstream question via gmeow:cqConsumes; the harness checks the producer's gmeow:cqResultShape satisfies this shape before executing the query."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqConsumes a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:label "competency consumes"@x-gmeow-english ;
    skos:definition "The upstream gmeow:CompetencyQuestion whose declared output (gmeow:cqResultShape) this question's declared input (gmeow:cqInputShape) must be compatible with; the harness checks the structural input→output compatibility contract before executing this question. The composition property between two questions — the producer supplies what this question requires. Maps to the inter-question dependency axis of logic:expectsInputShape."@x-gmeow-english ;
    skos:example "ex:cqDownstream gmeow:cqConsumes ex:cqUpstream ; gmeow:cqInputShape ex:downstreamInputShape ."@x-gmeow-english ;
    gmeow:useWhen "Use to declare that this question depends on a specific upstream producer, so the harness can enforce the structural contract (producer's gmeow:cqResultShape must satisfy this question's gmeow:cqInputShape) before execution."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid without a paired gmeow:cqInputShape on the same question — the contract requires both the dependency (gmeow:cqConsumes) and the declared input type (gmeow:cqInputShape); avoid on ASK questions."@x-gmeow-english ;
    gmeow:howToUse "Point gmeow:cqConsumes at the upstream gmeow:CompetencyQuestion IRI and pair it with gmeow:cqInputShape naming the logic:ResultShape the producer must cover; the harness resolves the producer from the same spec file and performs the composition pre-check before execution."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cqReasoning a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:range gmeow:ReasoningProfile ;
    rdfs:label "competency reasoning profile"@x-gmeow-english ;
    skos:definition "The entailment lane a competency question is evaluated under (a gmeow:ReasoningProfile). Optional; when omitted the default is gmeow:reasoningNone — the ASSERTED merged ontology, over which SPARQL property paths (rdfs:subClassOf*, rdfs:subPropertyOf*) still supply transitive closure at query time. Set gmeow:reasoningRdfs to evaluate over the RDFS closure of the merged graph for questions whose expected answer is entailed (e.g. a type inferred from a property's rdfs:domain), not asserted."@x-gmeow-english ;
    skos:example "ex:cq gmeow:cqReasoning gmeow:reasoningRdfs ."@x-gmeow-english ;
    gmeow:useWhen "Use only when a SELECT/ASK answer depends on RDFS entailment the asserted graph does not carry — domain/range typing, rdf:type propagation up the class hierarchy, or subclass/subproperty transitivity that a property path cannot express in the query itself."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the common case answerable on the asserted graph: every profile above gmeow:reasoningNone closes the graph first, so omitting it keeps the question on the fast default lane. Reasoning is monotonic, so a question that does NOT need entailment returns the same answer either way."@x-gmeow-english ;
    gmeow:howToUse "Leave it unset for the default (asserted + property paths); set gmeow:reasoningRdfs to opt the single question into the RDFS-closed graph. The harness builds the closure once per spec file and only when some question requests it."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

# --------------------------------------------------------------------------- #
# ExpectedRow / ExpectedCell fields
# --------------------------------------------------------------------------- #

gmeow:rowCell a owl:ObjectProperty ;
    rdfs:range gmeow:ExpectedCell ;
    rdfs:label "row cell"@x-gmeow-english ;
    skos:definition "Links a gmeow:ExpectedRow to one of its per-variable gmeow:ExpectedCell bindings. A row carries one cell per projected SELECT variable."@x-gmeow-english ;
    skos:example "ex:row1 gmeow:rowCell ex:cellName, ex:cellAge ."@x-gmeow-english ;
    gmeow:useWhen "Use to attach the expected per-variable bindings to an expected row — one gmeow:rowCell per projected variable."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cellVar a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:range xsd:string ;
    rdfs:label "cell variable"@x-gmeow-english ;
    skos:definition "The SPARQL variable name an expected cell binds, WITHOUT the leading '?' — e.g. \"name\", not \"?name\"."@x-gmeow-english ;
    skos:example "ex:cellName gmeow:cellVar \"name\" ."@x-gmeow-english ;
    gmeow:useWhen "Use to name which SELECT variable an expected cell binds the value of."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid including the leading '?': write the bare variable name."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cellValueIri a owl:ObjectProperty ;
    rdfs:label "cell value (IRI)"@x-gmeow-english ;
    skos:definition "The expected bound value of an expected cell when that value is an IRI. EXACTLY ONE of gmeow:cellValueIri | gmeow:cellValueLiteral is set per cell (enforced by SHACL in the test-DSL shapes)."@x-gmeow-english ;
    skos:example "ex:cellAgent gmeow:cellValueIri ex:lillith ."@x-gmeow-english ;
    gmeow:useWhen "Use when the expected binding for the cell's variable is an IRI / resource."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pairing it with gmeow:cellValueLiteral on the same cell — exactly one value property per cell."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:cellValueLiteral a owl:DatatypeProperty ;
    rdfs:range rdfs:Literal ;
    rdfs:label "cell value (literal)"@x-gmeow-english ;
    skos:definition "The expected bound value of an expected cell when that value is a literal (a string, number, date, …). EXACTLY ONE of gmeow:cellValueIri | gmeow:cellValueLiteral is set per cell (enforced by SHACL in the test-DSL shapes)."@x-gmeow-english ;
    skos:example "ex:cellName gmeow:cellValueLiteral \"Lillith\" ."@x-gmeow-english ;
    gmeow:useWhen "Use when the expected binding for the cell's variable is a literal value."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pairing it with gmeow:cellValueIri on the same cell — exactly one value property per cell."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

# --------------------------------------------------------------------------- #
# StructuralAssertion fields
# --------------------------------------------------------------------------- #

gmeow:saPolarity a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:range gmeow:AssertionPolarity ;
    rdfs:label "assertion polarity"@x-gmeow-english ;
    skos:definition "The required polarity of a structural assertion — gmeow:must (the pattern/shape must hold) or gmeow:mustNot (it must not hold). Required on every gmeow:StructuralAssertion."@x-gmeow-english ;
    skos:example "ex:sa gmeow:saPolarity gmeow:mustNot ."@x-gmeow-english ;
    gmeow:useWhen "Use on every structural assertion to declare whether its pattern or shape is a positive (must hold) or negative (must not hold) invariant."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid omitting it: polarity is required, and an assertion with no polarity is ambiguous about pass vs. fail."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:saPattern a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "assertion pattern"@x-gmeow-english ;
    skos:definition "The triple pattern of a structural assertion, expressed as a SPARQL ASK query whose boolean result is read against gmeow:saPolarity. EXACTLY ONE of gmeow:saPattern | gmeow:saShape is set per assertion."@x-gmeow-english ;
    skos:example "ex:sa gmeow:saPattern \"ASK { ?a a gmeow:Agent ; gmeow:hasName ?n }\" ."@x-gmeow-english ;
    gmeow:useWhen "Use to express a structural invariant as a SPARQL ASK pattern over the scoped graph."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pairing it with gmeow:saShape on the same assertion — exactly one of pattern or shape — and avoid it when a SHACL shape already captures the constraint (use gmeow:saShape)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:saShape a owl:ObjectProperty ;
    rdfs:label "assertion shape"@x-gmeow-english ;
    skos:definition "An IRI referencing a sh:NodeShape that the scoped graph must (or must not) satisfy, per gmeow:saPolarity. EXACTLY ONE of gmeow:saPattern | gmeow:saShape is set per assertion."@x-gmeow-english ;
    skos:example "ex:sa gmeow:saShape ex:AgentNameShape ."@x-gmeow-english ;
    gmeow:useWhen "Use to express a structural invariant as conformance (or non-conformance) to a named SHACL node shape, when a shape already captures the constraint more precisely than a triple pattern."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pairing it with gmeow:saPattern on the same assertion — exactly one of pattern or shape."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:saScope a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:range gmeow:AssertionScope ;
    rdfs:label "assertion scope"@x-gmeow-english ;
    skos:definition "The graph scope a structural assertion is evaluated over — gmeow:scopeModule or gmeow:scopeModuleAndExamples. Optional; when omitted the default semantics are gmeow:scopeModuleAndExamples (the harness applies this default; no owl default is asserted on the property)."@x-gmeow-english ;
    skos:example "ex:sa gmeow:saScope gmeow:scopeModule ."@x-gmeow-english ;
    gmeow:useWhen "Use to narrow a structural assertion to the module graph alone (gmeow:scopeModule) when the examples/ should be excluded."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it just to restate the default: omitting it means gmeow:scopeModuleAndExamples, so set it only to deviate from that default."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:saRationale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "assertion rationale"@x-gmeow-english ;
    skos:definition "The human-readable rationale for a structural assertion: why this invariant must (or must not) hold over the slice. Optional."@x-gmeow-english ;
    skos:example "ex:sa gmeow:saRationale \"An agent without a name cannot be cited or credited.\" ."@x-gmeow-english ;
    gmeow:useWhen "Use to record why a structural invariant matters, so a reader understands the modelling rule it protects."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

# --------------------------------------------------------------------------- #
# ExampleConformance fields
# --------------------------------------------------------------------------- #

gmeow:exampleFile a owl:DatatypeProperty ,
        owl:FunctionalProperty ;
    rdfs:range xsd:string ;
    rdfs:label "example file"@x-gmeow-english ;
    skos:definition "A SLICE-RELATIVE path to the example or counter-example .ttl file whose validation outcome is being pinned — resolved against the slice directory, NOT the repository root (contrast with gmeow:cqQueryFile, which is repo-root-relative)."@x-gmeow-english ;
    skos:example "ex:ec gmeow:exampleFile \"examples/agent-missing-name.ttl\" ."@x-gmeow-english ;
    gmeow:useWhen "Use to name the example or counter-example file a conformance fixture pins, written relative to the slice directory (e.g. `examples/<name>.ttl`)."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a repo-root-relative path here: this property is SLICE-RELATIVE, unlike gmeow:cqQueryFile. Do not prefix it with `slices/<group>/<name>/`."@x-gmeow-english ;
    gmeow:howToUse "Write the path relative to the slice directory, typically `examples/<name>.ttl` for a positive example or a counter-example; the harness resolves it inside the owning slice."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:expectedOutcome a owl:ObjectProperty ,
        owl:FunctionalProperty ;
    rdfs:range gmeow:ConformanceOutcome ;
    rdfs:label "expected outcome"@x-gmeow-english ;
    skos:definition "The expected validation outcome of the bound example file — gmeow:conforms (passes validation) or gmeow:violates (is rejected with a finding). Required on every gmeow:ExampleConformance."@x-gmeow-english ;
    skos:example "ex:ec gmeow:expectedOutcome gmeow:violates ."@x-gmeow-english ;
    gmeow:useWhen "Use on every example-conformance fixture to declare whether the example is expected to conform or to violate."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid setting gmeow:expectedViolationCode when the outcome is gmeow:conforms, and avoid omitting the code when it is gmeow:violates."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:expectedViolationCode a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "expected violation code"@x-gmeow-english ;
    skos:definition "The expected validation finding code when gmeow:expectedOutcome is gmeow:violates. Uses the REAL finding-code format `shacl.<FullConstraintComponentLocalName>` — e.g. `shacl.MinCountConstraintComponent`, NOT `shacl.minCount`. Required iff the outcome is gmeow:violates; absent iff gmeow:conforms (enforced by SHACL in the test-DSL shapes)."@x-gmeow-english ;
    skos:example "ex:ec gmeow:expectedOutcome gmeow:violates ; gmeow:expectedViolationCode \"shacl.MinCountConstraintComponent\" ."@x-gmeow-english ;
    gmeow:useWhen "Use on a gmeow:violates fixture to pin WHICH finding the counter-example must trigger, in the `shacl.<FullConstraintComponentLocalName>` form."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid the short SHACL form (`shacl.minCount`) — the real code is the full constraint-component local name, e.g. `shacl.MinCountConstraintComponent`. Avoid setting it at all when the outcome is gmeow:conforms."@x-gmeow-english ;
    gmeow:howToUse "Read the finding code the validator emits — it is `shacl.` followed by the SHACL constraint component's FULL local name (e.g. shacl.MinCountConstraintComponent, shacl.ClassConstraintComponent, shacl.DatatypeConstraintComponent) — and pin that exact string on the violates fixture."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:conformanceRationale a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "conformance rationale"@x-gmeow-english ;
    skos:definition "The human-readable rationale for an example-conformance fixture: why this example is expected to conform, or why the counter-example is expected to violate the named code. Optional."@x-gmeow-english ;
    skos:example "ex:ec gmeow:conformanceRationale \"This counter-example omits the required name, so MinCount must fire.\" ."@x-gmeow-english ;
    gmeow:useWhen "Use to record why a particular conformance or violation is the expected outcome, documenting the constraint the fixture guards."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

# =============================================================================
# Migrated procedural + declarative constraints: the closed-world
# gmeow:CompetencyQuestionShape / gmeow:StructuralAssertionShape /
# gmeow:ExampleConformanceShape / gmeow:ExpectedRowShape / gmeow:ExpectedCellShape
# / gmeow:TestDslVocabularyTermShape shapes from shapes/test-dsl-shapes.ttl,
# re-expressed as canonical logic: records (Principle 17). The authored shapes
# stay (additive); the sweep verifies.
# =============================================================================

# --- CompetencyQuestion ------------------------------------------------------ #

gmeow:CompetencyQuestionRationaleRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "CompetencyQuestion rationale requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:CompetencyQuestion must carry at least one gmeow:cqRationale."@x-gmeow-english ;
    logic:onClass gmeow:CompetencyQuestion ;
    logic:anyOf gmeow:cqRationale ;
    logic:formalizes gmeow:CompetencyQuestion ;
    logic:message "CompetencyQuestion must have at least one gmeow:cqRationale (xsd:string)"@x-gmeow-english .

gmeow:CompetencyQuestionQueryChoiceConstraint
    a logic:ChoiceGroupConstraint ;
    rdfs:label "CompetencyQuestion query choice constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:CompetencyQuestion carries exactly one of gmeow:cqQuery (inline) or gmeow:cqQueryFile (referenced)."@x-gmeow-english ;
    logic:onClass gmeow:CompetencyQuestion ;
    logic:choicePredicate gmeow:cqQuery , gmeow:cqQueryFile ;
    logic:choiceMode "exactly-one" ;
    logic:formalizes gmeow:CompetencyQuestion ;
    logic:message "CompetencyQuestion needs exactly one of gmeow:cqQuery (inline) or gmeow:cqQueryFile (referenced)"@x-gmeow-english .

# gmeow:cqDataFile is only honoured in the asserted (gmeow:reasoningNone) lane —
# pairing it with gmeow:reasoningRdfs is a closed-world co-occurrence violation,
# so this mirrors the organization gmeow:MembershipFillsPostOrgMismatchConstraint
# raw-Formula idiom (a guarded non-existence over two named values).
gmeow:CompetencyQuestionDataFileReasoningConstraint
    a logic:Constraint ;
    rdfs:label "CompetencyQuestion data-file reasoning-lane constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:CompetencyQuestion carrying a gmeow:cqDataFile must not also declare gmeow:cqReasoning gmeow:reasoningRdfs — the overlay is only honoured in the asserted lane."@x-gmeow-english ;
    logic:formalizes gmeow:CompetencyQuestion ;
    logic:message "CompetencyQuestion gmeow:cqDataFile is only honoured in the asserted (gmeow:reasoningNone) lane, not gmeow:reasoningRdfs"@x-gmeow-english ;
    logic:integrity logic:cqdfForall .
logic:cqdfForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:cqdfImpl .
logic:cqdfImpl a logic:Formula ; logic:antecedent logic:cqdfGuard ; logic:consequent logic:cqdfNot .
logic:cqdfGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:CompetencyQuestion ] .
logic:cqdfNot a logic:Formula ; logic:not logic:cqdfExists .
logic:cqdfExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] ;
    logic:exists logic:cqdfBody .
logic:cqdfBody a logic:Formula ; logic:and logic:cqdfHasData , logic:cqdfIsRdfs .
logic:cqdfHasData a logic:Formula ; logic:relation gmeow:cqDataFile ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
logic:cqdfIsRdfs a logic:Formula ; logic:relation gmeow:cqReasoning ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:reasoningRdfs ] .

# gmeow:cqExpectAsk XOR (gmeow:cqExpectRow OR gmeow:cqExpectRowCount): the SELECT
# side is itself a disjunction of two predicates, so this is NOT a flat
# ChoiceGroupConstraint (which would wrongly forbid cqExpectRow and
# cqExpectRowCount co-occurring); authored as a raw logic:Formula XOR of "ask"
# and "select" (select := cqExpectRow ∨ cqExpectRowCount).
gmeow:CompetencyQuestionExpectationChoiceConstraint
    a logic:Constraint ;
    rdfs:label "CompetencyQuestion expectation choice constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:CompetencyQuestion carries exactly one expectation — either gmeow:cqExpectAsk (for ASK) XOR at least one SELECT expectation (gmeow:cqExpectRow or gmeow:cqExpectRowCount)."@x-gmeow-english ;
    logic:formalizes gmeow:CompetencyQuestion ;
    logic:message "CompetencyQuestion needs exactly one expectation: either gmeow:cqExpectAsk (for ASK) XOR at least one SELECT expectation (gmeow:cqExpectRow or gmeow:cqExpectRowCount)"@x-gmeow-english ;
    logic:integrity logic:cqecForall .
logic:cqecForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:cqecImpl .
logic:cqecImpl a logic:Formula ; logic:antecedent logic:cqecGuard ; logic:consequent logic:cqecXor .
logic:cqecGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:CompetencyQuestion ] .
logic:cqecXor a logic:Formula ; logic:or logic:cqecAskOnly , logic:cqecSelectOnly .
logic:cqecAskOnly a logic:Formula ; logic:and logic:cqecAsk , logic:cqecNotSelect .
logic:cqecSelectOnly a logic:Formula ; logic:and logic:cqecNotAsk , logic:cqecSelect .
logic:cqecAsk a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "a" ] ;
    logic:exists logic:cqecAskAtom .
logic:cqecAskAtom a logic:Formula ; logic:relation gmeow:cqExpectAsk ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .
logic:cqecNotAsk a logic:Formula ; logic:not logic:cqecAsk .
logic:cqecSelect a logic:Formula ; logic:or logic:cqecRow , logic:cqecRowCount .
logic:cqecRow a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "r" ] ;
    logic:exists logic:cqecRowAtom .
logic:cqecRowAtom a logic:Formula ; logic:relation gmeow:cqExpectRow ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] .
logic:cqecRowCount a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "c" ] ;
    logic:exists logic:cqecRowCountAtom .
logic:cqecRowCountAtom a logic:Formula ; logic:relation gmeow:cqExpectRowCount ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] .
logic:cqecNotSelect a logic:Formula ; logic:not logic:cqecSelect .

# --- StructuralAssertion ------------------------------------------------------ #

gmeow:StructuralAssertionPolarityRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "StructuralAssertion polarity requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:StructuralAssertion must carry exactly one gmeow:saPolarity."@x-gmeow-english ;
    logic:onClass gmeow:StructuralAssertion ;
    logic:anyOf gmeow:saPolarity ;
    logic:formalizes gmeow:StructuralAssertion ;
    logic:message "StructuralAssertion must have exactly one gmeow:saPolarity in (gmeow:must, gmeow:mustNot)"@x-gmeow-english .

gmeow:StructuralAssertionPatternChoiceConstraint
    a logic:ChoiceGroupConstraint ;
    rdfs:label "StructuralAssertion pattern/shape choice constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:StructuralAssertion carries exactly one of gmeow:saPattern (a SPARQL ASK) or gmeow:saShape (an sh:NodeShape IRI)."@x-gmeow-english ;
    logic:onClass gmeow:StructuralAssertion ;
    logic:choicePredicate gmeow:saPattern , gmeow:saShape ;
    logic:choiceMode "exactly-one" ;
    logic:formalizes gmeow:StructuralAssertion ;
    logic:message "StructuralAssertion needs exactly one of gmeow:saPattern (SPARQL ASK) or gmeow:saShape (sh:NodeShape IRI)"@x-gmeow-english .

# --- ExampleConformance -------------------------------------------------------- #

gmeow:ExampleConformanceFileRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "ExampleConformance file requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:ExampleConformance must carry exactly one gmeow:exampleFile."@x-gmeow-english ;
    logic:onClass gmeow:ExampleConformance ;
    logic:anyOf gmeow:exampleFile ;
    logic:formalizes gmeow:ExampleConformance ;
    logic:message "ExampleConformance must have exactly one gmeow:exampleFile (xsd:string)"@x-gmeow-english .

gmeow:ExampleConformanceOutcomeRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "ExampleConformance outcome requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:ExampleConformance must carry exactly one gmeow:expectedOutcome."@x-gmeow-english ;
    logic:onClass gmeow:ExampleConformance ;
    logic:anyOf gmeow:expectedOutcome ;
    logic:formalizes gmeow:ExampleConformance ;
    logic:message "ExampleConformance must have exactly one gmeow:expectedOutcome in (gmeow:conforms, gmeow:violates)"@x-gmeow-english .

# gmeow:expectedOutcome gmeow:violates ⟺ gmeow:expectedViolationCode present — a
# biconditional, so this is a raw logic:Formula (AND of the two guarded
# implications) rather than a single sugar record.
gmeow:ExampleConformanceViolationCodeConstraint
    a logic:Constraint ;
    rdfs:label "ExampleConformance violation-code biconditional constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:ExampleConformance carries a gmeow:expectedViolationCode if and only if its gmeow:expectedOutcome is gmeow:violates."@x-gmeow-english ;
    logic:formalizes gmeow:ExampleConformance ;
    logic:message "ExampleConformance with gmeow:expectedOutcome gmeow:violates must carry gmeow:expectedViolationCode; gmeow:conforms must NOT"@x-gmeow-english ;
    logic:integrity logic:ecvForall .
logic:ecvForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:ecvImpl .
logic:ecvImpl a logic:Formula ; logic:antecedent logic:ecvGuard ; logic:consequent logic:ecvBiconditional .
logic:ecvGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ExampleConformance ] .
logic:ecvBiconditional a logic:Formula ; logic:and logic:ecvForward , logic:ecvBackward .
logic:ecvForward a logic:Formula ; logic:antecedent logic:ecvViolates ; logic:consequent logic:ecvHasCode .
logic:ecvViolates a logic:Formula ; logic:relation gmeow:expectedOutcome ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:violates ] .
logic:ecvHasCode a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "code" ] ;
    logic:exists logic:ecvHasCodeAtom .
logic:ecvHasCodeAtom a logic:Formula ; logic:relation gmeow:expectedViolationCode ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "code" ] .
logic:ecvBackward a logic:Formula ; logic:antecedent logic:ecvConforms ; logic:consequent logic:ecvNoCode .
logic:ecvConforms a logic:Formula ; logic:relation gmeow:expectedOutcome ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:conforms ] .
logic:ecvNoCode a logic:Formula ; logic:not logic:ecvHasCode .

# --- ExpectedRow / ExpectedCell ----------------------------------------------- #

gmeow:ExpectedRowCellRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "ExpectedRow cell requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:ExpectedRow must carry at least one gmeow:rowCell."@x-gmeow-english ;
    logic:onClass gmeow:ExpectedRow ;
    logic:anyOf gmeow:rowCell ;
    logic:formalizes gmeow:ExpectedRow ;
    logic:message "ExpectedRow must have at least one gmeow:rowCell"@x-gmeow-english .

gmeow:ExpectedCellVarRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "ExpectedCell variable requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:ExpectedCell must carry exactly one gmeow:cellVar."@x-gmeow-english ;
    logic:onClass gmeow:ExpectedCell ;
    logic:anyOf gmeow:cellVar ;
    logic:formalizes gmeow:ExpectedCell ;
    logic:message "ExpectedCell must have exactly one gmeow:cellVar (xsd:string)"@x-gmeow-english .

gmeow:ExpectedCellValueChoiceConstraint
    a logic:ChoiceGroupConstraint ;
    rdfs:label "ExpectedCell value choice constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:ExpectedCell carries exactly one of gmeow:cellValueIri or gmeow:cellValueLiteral."@x-gmeow-english ;
    logic:onClass gmeow:ExpectedCell ;
    logic:choicePredicate gmeow:cellValueIri , gmeow:cellValueLiteral ;
    logic:choiceMode "exactly-one" ;
    logic:formalizes gmeow:ExpectedCell ;
    logic:message "ExpectedCell needs exactly one of gmeow:cellValueIri or gmeow:cellValueLiteral"@x-gmeow-english .

# --- Vocabulary annotation completeness -------------------------------------- #
# gmeow:TestDslVocabularyTermShape — mirrors
# logic:GmeowClassCompletenessConstraint / GmeowPropertyCompletenessConstraint's
# logic:sparqlTarget idiom for a raw sh:SPARQLTarget focus set, scoped to the
# test-dsl namespace.

gmeow:TestDslVocabularyTermCompletenessConstraint
    a logic:Constraint ;
    rdfs:label "Test DSL vocabulary term completeness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every term declared in the test DSL vocabulary namespace (a class, object/datatype/annotation property, ontology, or datatype) carries at least one rdfs:label, one skos:definition, and rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl>."@x-gmeow-english ;
    logic:formalizes gmeow:TestDslVocabularyTermShape ;
    logic:message "Every test DSL vocabulary term must carry rdfs:label, skos:definition, and rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl>."@x-gmeow-english ;
    logic:integrity logic:tdvForall .
logic:tdvForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:tdvImpl .
logic:tdvImpl a logic:Formula ; logic:antecedent logic:tdvTarget ; logic:consequent logic:tdvAnd .
logic:tdvTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral """SELECT ?this WHERE {
    ?this a ?t .
    FILTER(?t IN (
        <http://www.w3.org/2002/07/owl#Class>,
        <http://www.w3.org/2002/07/owl#ObjectProperty>,
        <http://www.w3.org/2002/07/owl#DatatypeProperty>,
        <http://www.w3.org/2002/07/owl#AnnotationProperty>,
        <http://www.w3.org/2002/07/owl#Ontology>,
        <http://www.w3.org/2000/01/rdf-schema#Datatype>
    ))
    FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
}""" ] .
logic:tdvAnd a logic:Formula ; logic:and logic:tdvLabel , logic:tdvDef , logic:tdvDefBy .
logic:tdvLabel a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "l" ] ; logic:exists logic:tdvLabelAtom .
logic:tdvLabelAtom a logic:Formula ; logic:relation rdfs:label ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "l" ] .
logic:tdvDef a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] ; logic:exists logic:tdvDefAtom .
logic:tdvDefAtom a logic:Formula ; logic:relation skos:definition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
logic:tdvDefBy a logic:Formula ; logic:relation rdfs:isDefinedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri <https://blackcatinformatics.ca/gmeow/test-dsl> ] .

# =============================================================================
# Flagship acceptance manifest — the shared depth-bar vocabulary.
#
# A grounding slice's depth is defined by a small set of flagship acceptance
# scenarios: worked cases whose realization and enforcement are wired to concrete
# artifacts, not asserted by adjective. These terms reify that acceptance bar as a
# typed, queryable object shared across every grounding slice (math:, lang:, …), so
# a scenario binds ONE worked example, ONE pinning competency question, ONE named
# producer, ONE guarding counter-example, and ONE enforcing conformance-failure
# class — and a slice that hoists onto this vocabulary re-uses one contract rather
# than copying it. The enforcing-failure-class value stays SLICE-namespaced (each
# slice's own <Slice>ConformanceFailure subclass); only the manifest vocabulary is
# shared here.
# =============================================================================

# gmeow:FlagshipScenario, gmeow:UnwiredFlagshipScenario, and the five wiring predicates
# (gmeow:demonstratedByExample/Competency/Producer, gmeow:guardedByCounterExample,
# gmeow:enforcesFailureClass) are now first-class ontology terms in the logic grounding
# slice (slices/grounding/logic/module.ttl), which the shape-derive reads; they are no
# longer declared here (no dual source of truth).

# --- Counter-example discharge depth --------------------------------------- #
# How a flagship scenario's GUARDING counter-example proves its gate bites: a
# structural/SHACL well-formedness proxy (the floor today) or a reasoner-driven
# counter-example whose malformed input the native solver runs to observe the
# missing/failed entailment directly (the depth target — see
# slices/grounding/logic/design/LOGIC-CONFORMANCE.md, Tests as ontology data).
# The classification is an HONEST factual annotation authored per scenario; the
# slice-quality flagship-counter-example-depth axis reads it to surface how many
# counter-examples remain structural-only (Principle 17: SHACL is a lossy
# projection of the canonical logic: core; Principle 18: the native solver is the
# authoritative gate).

gmeow:CounterExampleDischarge a owl:Class ;
    rdfs:label "counter-example discharge"@x-gmeow-english ;
    skos:definition "The value vocabulary classifying HOW a gmeow:FlagshipScenario's guarding counter-example discharges its guard-bites leg: by a structural/SHACL well-formedness proxy (gmeow:structuralDischarge) or by a reasoner-driven counter-example the native solver runs to observe the missing entailment (gmeow:reasonerDrivenDischarge). An open value vocabulary of individuals, never subclasses. It is NOT the counter-example path (that is gmeow:guardedByCounterExample) and NOT the enforced failure class (that is gmeow:enforcesFailureClass): it records the DEPTH at which the negative space is proven."@x-gmeow-english ;
    skos:example "gmeow:structuralDischarge a gmeow:CounterExampleDischarge ."@x-gmeow-english ;
    gmeow:useWhen "Use as the value vocabulary for gmeow:counterExampleDischarge — the honest classification of whether a flagship counter-example bites at the reasoning-runtime layer or only at the SHACL projection surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid subclassing to add a discharge kind (mint an individual) and avoid asserting gmeow:reasonerDrivenDischarge for a counter-example the native solver is not actually run over — the marker must be truthful, never aspirational."@x-gmeow-english ;
    gmeow:howToUse "Reference gmeow:structuralDischarge or gmeow:reasonerDrivenDischarge from a gmeow:FlagshipScenario through gmeow:counterExampleDischarge, classifying that scenario's guarding counter-example by the layer at which it proves the gate bites."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:counterExampleDischarge a owl:ObjectProperty ;
    rdfs:domain gmeow:FlagshipScenario ;
    rdfs:range gmeow:CounterExampleDischarge ;
    rdfs:label "counter-example discharge"@x-gmeow-english ;
    skos:definition "Classifies a gmeow:FlagshipScenario's guarding counter-example by the layer at which it proves the gate bites: gmeow:structuralDischarge when a structural/SHACL well-formedness shape stands in for the failure, or gmeow:reasonerDrivenDischarge when the native solver is run over the malformed input and observes the missing/failed entailment at reasoning-runtime. An HONEST per-scenario annotation — never asserted reasoner-driven for a counter-example the solver is not actually run over — read by the slice-quality flagship-counter-example-depth axis. It is NOT a gate itself: it records depth, and the depth target (Principle 17/18) is that every flagship counter-example become reasoner-driven."@x-gmeow-english ;
    skos:example "exa:elRlDlClosure gmeow:counterExampleDischarge gmeow:structuralDischarge ."@x-gmeow-english ;
    gmeow:useWhen "Use on every gmeow:FlagshipScenario to record, honestly, whether its guarding counter-example is discharged by a structural/SHACL proxy or by a reasoner-driven counter-example."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid marking a scenario gmeow:reasonerDrivenDischarge when its counter-example only trips a SHACL well-formedness shape (that is gmeow:structuralDischarge), and avoid omitting the marker — an unclassified counter-example is read as structural-only by the depth axis."@x-gmeow-english ;
    gmeow:howToUse "Assert one gmeow:counterExampleDischarge per gmeow:FlagshipScenario pointing at gmeow:structuralDischarge or gmeow:reasonerDrivenDischarge; the flagship-counter-example-depth slice-quality axis scores the fraction reasoner-driven and advises on each structural-only scenario."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:structuralDischarge a gmeow:CounterExampleDischarge ;
    rdfs:label "structural discharge"@x-gmeow-english ;
    skos:definition "The floor: a flagship scenario's guarding counter-example proves its gate bites through a structural/SHACL well-formedness proxy — the malformed input trips a shape (a sh:minCount, a sh:sparql) that stands in for the failure class, rather than the native solver observing the missing entailment. It is NOT a defect but the current baseline; the depth target is gmeow:reasonerDrivenDischarge (Principle 17: the SHACL proxy is a lossy projection of the canonical logic: negative space)."@x-gmeow-english ;
    skos:example "exa:elRlDlClosure gmeow:counterExampleDischarge gmeow:structuralDischarge ."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a counter-example that bites only at the SHACL projection surface — a structural well-formedness shape standing in for the failure the reasoner would otherwise observe."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it for a counter-example the native solver is actually run over to observe the missing entailment (that is gmeow:reasonerDrivenDischarge)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .

gmeow:reasonerDrivenDischarge a gmeow:CounterExampleDischarge ;
    rdfs:label "reasoner-driven discharge"@x-gmeow-english ;
    skos:definition "The depth target: a flagship scenario's guarding counter-example proves its gate bites by driving the native solver (Principle 18) over the malformed input and observing the missing or failed entailment at reasoning-runtime — the closure genuinely fails to derive the atom the scenario demands — rather than resting on a structural/SHACL stand-in. It is NOT merely a SHACL shape firing (that is gmeow:structuralDischarge): the failure class is raised by the reasoner, in the canonical logic: core."@x-gmeow-english ;
    skos:example "exa:someScenario gmeow:counterExampleDischarge gmeow:reasonerDrivenDischarge ."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a counter-example the native solver is actually run over, observing the missing/failed entailment that raises the scenario's failure class at reasoning-runtime."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it for a counter-example that only trips a structural/SHACL well-formedness shape (that is gmeow:structuralDischarge) — the marker must be truthful."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> .
