math:Chart rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:chartDomain ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:coordinateMap ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:targetCoordinateSpace ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedChart .

math:Compactification rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:originalSpace ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:compactifyingMap ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:compactifiedSpace ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:boundaryAtInfinity ; owl:maxQualifiedCardinality 1 ; owl:onClass math:BoundaryAtInfinity ] ;
