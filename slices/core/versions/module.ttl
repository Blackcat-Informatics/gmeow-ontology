@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/versions>
    a owl:Ontology ;
    rdfs:label "GMEOW Versions Module"@x-gmeow-english ;
    skos:definition "The GMEOW Versions Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> ;
    rdfs:comment """Cross-cutting version-set and version-membership facility for information-object lineages. Reuses the universal claim stack (Observation / Relator) so that version roles — canonical, variant, latest, stable, LTS, deprecated, yanked, etc. — are standpoint-scoped claims coexisting without privilege (Principle 9), never hard-coded as essential types. Suppressed versions remain first-class with gmeow:displayable false (Principle 10). Attestation evidence (signatures, SLSA, DOI assertions) belongs in #162 and composes with this layer; it is not embedded here."""@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# CORE CLASSES
# =========================================================================== #

gmeow:VersionSet
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:InformationObject ;
    rdfs:label "Version Set"@x-gmeow-english ;
    skos:definition "A first-class information object representing a version family or release lineage — the set of all concrete artifacts that are versions of a common stable entity. A VersionSet is an InformationObject (a kind of Entity) so it can carry identifiers, provenance, and authority links. Examples: the lineage of a software project, the edition chain of a book, the variant family of an email thread, the DOI concept record."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:VersionMembership
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Observation, gufo:Relator ;
    rdfs:label "Version Membership"@x-gmeow-english ;
    skos:definition "A reified, standpoint-scoped claim that a concrete entity belongs to a version set with a particular role and/or scale — an observation in the universal claim stack (#69). Mediates between an entity (versionMember), a version set (versionSet), and an optional role/scale asserted by an authority (membershipAuthority / vantage). Mint one VersionMembership per (entity, versionSet, role, authority) tuple; when a role changes over time, close the old membership's interval or mint a fresh one — never overwrite (Principle 10). Inherits confidence, displayable, and temporal scope from Observation."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# RELATOR ROLE PROPERTIES
# =========================================================================== #

gmeow:versionMember
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:range gmeow:Entity ;
    rdfs:label "version member"@x-gmeow-english ;
    skos:definition "The concrete entity that participates in a version set via this membership — a software release, a book edition, an email variant, a dataset snapshot. Functional per relator: one member per VersionMembership."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:versionSet
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:range gmeow:VersionSet ;
    rdfs:label "version set"@x-gmeow-english ;
    skos:definition "The version set / lineage to which this membership belongs. Functional per relator: one set per VersionMembership."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:versionRole
    a owl:ObjectProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:range gmeow:VersionRole ;
    rdfs:label "version role"@x-gmeow-english ;
    skos:definition "The role or status classification this membership asserts for the member within the set — canonical, variant, latest, stable, LTS, deprecated, yanked, draft, published, revised, collected, withdrawn. NON-FUNCTIONAL: an entity may hold multiple roles from different authorities simultaneously (standpoint-indexed coexistence per Principle 9), and a role may change over time via new memberships rather than overwrite."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:versionScale
    a owl:ObjectProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:range gmeow:VersionScale ;
    rdfs:label "version scale"@x-gmeow-english ;
    skos:definition "The scale classification of this membership — trivial, minor, major. NON-FUNCTIONAL: different authorities or schemes may classify the same change differently; those claims coexist."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:membershipInterval
    a owl:ObjectProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:range gmeow:TimeInterval ;
    rdfs:label "membership interval"@x-gmeow-english ;
    skos:definition "The time interval over which this version membership / role claim holds. A relator carries its period this way (matching gmeow:usageInterval, gmeow:taggingInterval, gmeow:relationshipInterval) rather than via gmeow:duringInterval, which is reserved for gufo:Situation-based time-scoped relations."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:membershipAuthority
    a owl:ObjectProperty ;
    rdfs:domain gmeow:VersionMembership ;
    rdfs:range gmeow:Agent ;
    rdfs:label "membership authority"@x-gmeow-english ;
    skos:definition "The agent or standpoint that asserts this version membership and its role — a project maintainer, a package registry, a publisher, a curator, or a self-asserting individual. NON-FUNCTIONAL: competing authority claims coexist without privilege (Principle 9). When the claim is promoted from a flat statement annotation, gmeow:accordingTo becomes the membershipAuthority of the relator."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# FINGERPRINT
# =========================================================================== #

gmeow:versionFingerprint
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:range rdfs:Literal ;
    rdfs:label "version fingerprint"@x-gmeow-english ;
    skos:definition "A content fingerprint of the versioned entity — a hash, SWHID, content digest, or semantic identifier. Broader than gmeow:contentDigest (which is byte-exact and domain gmeow:CreativeWork, typically Manifestation or Item): versionFingerprint covers semantic fingerprints where exact bytes are not the identity criterion (e.g. a normalized form, a canonicalized serialization). Non-functional: a single entity may carry several fingerprints under different algorithms or schemes."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# VALUE VOCABULARIES (open; individuals carry rdfs:label only)
# =========================================================================== #

gmeow:VersionRole
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Version Role"@x-gmeow-english ;
    skos:definition "A role or status that an entity holds within a version set according to an authority — a VALUE, never an Entity subclass. Standpoint-scoped: 'latest' according to a package registry may differ from 'latest' according to a downstream mirror. The seed list is an anchor, not a fence."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:roleCanonical     a gmeow:VersionRole ; rdfs:label "canonical"@x-gmeow-english .
gmeow:roleCanonical skos:definition "The canonical version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:roleVariant       a gmeow:VersionRole ; rdfs:label "variant"@x-gmeow-english .
gmeow:roleVariant skos:definition "The variant version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:roleLatest        a gmeow:VersionRole ; rdfs:label "latest"@x-gmeow-english .
gmeow:roleLatest skos:definition "The latest version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:roleStable        a gmeow:VersionRole ; rdfs:label "stable"@x-gmeow-english .
gmeow:roleStable skos:definition "The stable version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:roleLTS           a gmeow:VersionRole ; rdfs:label "long-term support (LTS)"@x-gmeow-english .
gmeow:roleLTS skos:definition "The lts version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:roleDeprecated    a gmeow:VersionRole ; rdfs:label "deprecated"@x-gmeow-english .
gmeow:roleDeprecated skos:definition "The deprecated version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:roleYanked        a gmeow:VersionRole ; rdfs:label "yanked"@x-gmeow-english .
gmeow:roleYanked skos:definition "The yanked version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:roleDraft         a gmeow:VersionRole ; rdfs:label "draft"@x-gmeow-english .
gmeow:roleDraft skos:definition "The draft version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:rolePublished     a gmeow:VersionRole ; rdfs:label "published"@x-gmeow-english .
gmeow:rolePublished skos:definition "The published version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:roleRevised       a gmeow:VersionRole ; rdfs:label "revised"@x-gmeow-english .
gmeow:roleRevised skos:definition "The revised version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:roleCollected     a gmeow:VersionRole ; rdfs:label "collected"@x-gmeow-english .
gmeow:roleCollected skos:definition "The collected version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:roleWithdrawn     a gmeow:VersionRole ; rdfs:label "withdrawn"@x-gmeow-english .
gmeow:roleWithdrawn skos:definition "The withdrawn version role — a status that a versioned artifact occupies in its release lifecycle."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .

gmeow:VersionScale
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Version Scale"@x-gmeow-english ;
    skos:definition "The magnitude scale of a version change — a VALUE, never an Entity subclass. Used for SemVer-style classification and analogous schemes in non-software domains."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:scaleTrivial      a gmeow:VersionScale ; rdfs:label "trivial"@x-gmeow-english .
gmeow:scaleTrivial skos:definition "The trivial version scale — a magnitude category used to characterize the impact of a version change."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:scaleMinor        a gmeow:VersionScale ; rdfs:label "minor"@x-gmeow-english .
gmeow:scaleMinor skos:definition "The minor version scale — a magnitude category used to characterize the impact of a version change."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
gmeow:scaleMajor        a gmeow:VersionScale ; rdfs:label "major"@x-gmeow-english .

gmeow:scaleMajor skos:definition "The major version scale — a magnitude category used to characterize the impact of a version change."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/versions> .
# =========================================================================== #
# AXIOMATIZED DOCTRINE — EL someValuesFrom for reasoner visibility
# =========================================================================== #

gmeow:VersionMembership rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:versionMember ; owl:someValuesFrom gmeow:Entity ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:versionSet ; owl:someValuesFrom gmeow:VersionSet ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:membershipAuthority ; owl:someValuesFrom gmeow:Agent ] .
