    a ontolex:Form ;
    ontolex:writtenRep "Le plancher de score de l'axe de documentation requis pour mériter le palier Lié."@fr .

<http://example.org/lang/glossary-vartrans/form-tgt/f55e210bcca407c8>
    a ontolex:Form ;
    ontolex:writtenRep "identifiant de licence SPDX"@fr .

<http://example.org/lang/glossary-vartrans/form-tgt/f561173763ec27a3>
    a ontolex:Form ;
    ontolex:writtenRep "Une analyse d'homologie persistante sur une suite dont les applications structurelles peuvent pointer vers l'avant ou l'arrière, autorisant ajouts et retraits. Ce n’est pas une persistance ordinaire uniquement orientée vers l’avant."@fr .

