#
# The flagship acceptance manifest — the mathematics grounding layer's depth bar as a typed contract.
#
# The mathematics grounding layer's depth is defined by five flagship acceptance
# scenarios, not by adjectives. Each is realized by a worked example, pinned by a
# competency question, emitted by a named native producer, and guarded by a
# counter-example that raises a named failure class. This manifest reifies the acceptance
# bar ITSELF: five gmeow:FlagshipScenario individuals, each binding one scenario to the
# artifacts that realize and enforce it —
#   gmeow:demonstratedByExample     → the worked fixture under tests/ (a conformance fixture,
#                                     or — for rBridge — the committed byte-exact output of
#                                     the executable lift its producer runs)
#   gmeow:demonstratedByCompetency  → the gmeow:CompetencyQuestion that pins it
#   gmeow:demonstratedByProducer    → the native producer entrypoint
#   gmeow:guardedByCounterExample   → the minimal violation that proves the gate bites
#   gmeow:enforcesFailureClass      → the math:MathConformanceFailure subclass it raises
#
# The bindings are gated across three surfaces: the shared SHACL gmeow:FlagshipScenarioShape
# (cardinalities) plus the slice's thin math:FlagshipScenarioShape (failure-range) and a
# structural ASK (ex:saFlagshipCoverage) check that the five are present and fully
# linked with a real failure class; the native flagship cross-check resolves each
# gmeow:demonstratedByCompetency into tests/competency.ttl and confirms it carries a
# gmeow:cqExpectRow expectation and an existing query file. The competency-question
# individuals live in the tests dataset, which SHACL never loads — hence the split.
# Validates cleanly.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix exa:  <https://blackcatinformatics.ca/gmeow/examples/math/acceptance/> .
@prefix cq:   <https://blackcatinformatics.ca/gmeow/examples/math/tests/> .

# --- Flagship 1 — the symmetry groups of E8 -------------------------------- #
exa:e8Symmetry a gmeow:FlagshipScenario ;
    rdfs:label "Flagship: the symmetry groups of E8"@x-gmeow-english ;
    skos:definition "Lie group and Lie algebra, root system (240 roots in rank 8), Weyl group modelled as the automorphism group preserving the root system, its numbers pinned by an exact-match competency gate."@x-gmeow-english ;
    gmeow:demonstratedByExample "tests/conformance-fixtures/e8-weyl-produced.ttl" ;
    gmeow:demonstratedByCompetency cq:cqE8RootSystem ;
    gmeow:demonstratedByProducer "math::producers::e8_weyl_order" ;
    gmeow:guardedByCounterExample "tests/counter-examples/e8-wrong-weyl-order.ttl" ;
    gmeow:enforcesFailureClass math:WrongE8WeylOrder ;
    gmeow:counterExampleDischarge gmeow:structuralDischarge .

# --- Flagship 2 — how homomorphic encryption works ------------------------- #
exa:homomorphicEncryption a gmeow:FlagshipScenario ;
    rdfs:label "Flagship: how homomorphic encryption works"@x-gmeow-english ;
    skos:definition "A ring homomorphism whose homomorphic law (Dec(E(a) ⊗ E(b)) = a ⊕ b) is a logic: formula grounded in math: ring/lattice structure, framed by its noise model and security assumption."@x-gmeow-english ;
    gmeow:demonstratedByExample "tests/conformance-fixtures/he-scheme-produced.ttl" ;
    gmeow:demonstratedByCompetency cq:cqHeSchemeFrame ;
    gmeow:demonstratedByProducer "math::producers::additive_he_demo" ;
    gmeow:guardedByCounterExample "tests/counter-examples/he-scheme-missing-noise-model.ttl" ;
    gmeow:enforcesFailureClass math:UnderspecifiedEncryptionScheme ;
    gmeow:counterExampleDischarge gmeow:structuralDischarge .

# --- Flagship 3 — complex proofs as process -------------------------------- #
exa:proofAsProcess a gmeow:FlagshipScenario ;
    rdfs:label "Flagship: complex proofs as process"@x-gmeow-english ;
    skos:definition "A proof effort as a goal-decomposed process whose QED is a verification observation grounded in a vantage — the proof-dependency DAG lifted through the bridge, with an ungrounded verdict rejected."@x-gmeow-english ;
    gmeow:demonstratedByExample "tests/conformance-fixtures/verification-result-produced.ttl" ;
    gmeow:demonstratedByCompetency cq:cqBridgeProof ;
    gmeow:demonstratedByProducer "math::producers::proof_ingest" ;
    gmeow:guardedByCounterExample "tests/counter-examples/verification-result-ungrounded.ttl" ;
    gmeow:enforcesFailureClass math:UngroundedVerificationResult ;
    gmeow:counterExampleDischarge gmeow:structuralDischarge .

# --- Flagship 4 — the universal R → math: bridge --------------------------- #
# The worked example is tests/fixtures/lifted-r.ttl: the byte-exact output of the EXECUTABLE
# R front-end (math::producers::r_lift runs gmeow_math_lift::r::lift, the same entrypoint the
# gmeow CLI calls) over the committed crates/math-lift/fixtures/mtcars.R script. The scenario
# therefore discharges on a graph a real parser derived, not on a hand-written imitation of
# one — the reason the in-code r_bridge_lift emitter it replaced was retired outright.
exa:rBridge a gmeow:FlagshipScenario ;
    rdfs:label "Flagship: R → math:, for any R script"@x-gmeow-english ;
    skos:definition "A universal lift where an R script's mathematical/statistical content lifts into math: as the put leg of a logic:Correspondence, hard-failing with a typed diagnostic on anything it cannot lift rather than dropping it silently."@x-gmeow-english ;
    gmeow:demonstratedByExample "tests/fixtures/lifted-r.ttl" ;
    gmeow:demonstratedByCompetency cq:cqBridgeRFidelity ;
    gmeow:demonstratedByProducer "math::producers::r_lift" ;
    gmeow:guardedByCounterExample "tests/counter-examples/ingest-run-unliftable.ttl" ;
    gmeow:enforcesFailureClass math:UnliftableIngest ;
    gmeow:counterExampleDischarge gmeow:structuralDischarge .

# --- Flagship 5 — an AI describing its own structure ----------------------- #
# The native producer math::producers::exact_pca_residual emits an AI's residual PCA — a
# math:PCAAnalysis over the exact-rational math:GramMatrix G = [[4,1,0],[1,3,1],[0,1,2]] it
# decomposes (dominant axis + LDLᵀ pivots pinned exactly). The worked example IS that producer
# output (dogfooded, like the rBridge flagship): the manifest's gmeow:demonstratedByExample
# names the object the producer emits, and `stage-math-producers` asserts the two are
# graph-isomorphic at the explicit producer boundary so neither can silently drift. The gate is the PCA-completeness rule
# (math:IncompletePCAAnalysis), guarded by a PCA missing its covariance operator.
exa:aiSelfStructure a gmeow:FlagshipScenario ;
    rdfs:label "Flagship: an AI describing its own structure"@x-gmeow-english ;
    skos:definition "An AI's own latent-space geometry AS a math: object: an exact-rational residual PCA (math:PCAAnalysis) over the math:GramMatrix it decomposes, its dominant axis and LDLᵀ positive-definiteness certificate pinned exactly, with the AI's reflection on that structure carried at the logic: metalevel — the dogfooding apex."@x-gmeow-english ;
    gmeow:demonstratedByExample "tests/conformance-fixtures/pca-residual-lifted.ttl" ;
    gmeow:demonstratedByCompetency cq:cqPCAAnalysis ;
    gmeow:demonstratedByProducer "math::producers::exact_pca_residual" ;
    gmeow:guardedByCounterExample "tests/counter-examples/pca-analysis-missing-covariance.ttl" ;
    gmeow:enforcesFailureClass math:IncompletePCAAnalysis ;
    gmeow:counterExampleDischarge gmeow:structuralDischarge .
