    gmeow:objectLabel "eigenvectors and eigenvalues" ;
    gmeow:comment "math:Eigendecomposition factors an operator into its eigenvalue/eigenvector pairs; wd:Q190524 (eigenvectors and eigenvalues) names the underlying concept. The decomposition object is a facet of that concept, so skos:closeMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqMathOptimizationProblem a gmeow:TermEquivalence ;
