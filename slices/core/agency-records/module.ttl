gmeow:commitmentReleased
    a gmeow:CommitmentStatus ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "released self-commitment"@x-gmeow-english ;
    skos:definition "The internal commitment was released, without proving that its goal was met."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly reports released self-commitment."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving commitmentReleased solely from silence, missing timestamps or another status axis."@x-gmeow-english ;
    gmeow:howToUse "Attach commitmentReleased through commitmentStatus, preserving the source attribution and time context."@x-gmeow-english ;
    skos:example "ex:record gmeow:commitmentStatus gmeow:commitmentReleased ."@x-gmeow-english .

