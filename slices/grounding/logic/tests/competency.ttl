ex:rowHarvestTopSortal a gmeow:ExpectedRow ;
    gmeow:rowCell
        [ a gmeow:ExpectedCell ; gmeow:cellVar "candidate" ; gmeow:cellValueIri logic:candidateTopSortalDisjoint ] ,
