@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/organization>
    a gmeow:Slice ;
    rdfs:label "organization"@x-gmeow-english ;
    skos:definition "The organization slice of the GMEOW ontology (core tier): the ORG-superset layer modelling organizations as gmeow:Agent functional complexes. Membership is a gufo:Relator (foundedOn an agreement, bearing role, post, and period); gmeow:subOrganizationOf specializes the kernel gmeow:partOf spine so department membership propagates by property chain. Roles are values, posts are holder-independent seats, and organization/site/service kinds are open value vocabularies (Principle 9) — never subclasses. Carries the universal reified gmeow:Identifier, the commercial offerings surface, and multi-organization change events; contested membership, succession, and recognition coexist as standpoint-indexed claims (Principles 9/10). Anatomy, dependencies, and consumer are declared in this manifest, which is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/organization> ;
    dcterms:title "GMEOW Organization Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/entities> ,
        <https://blackcatinformatics.ca/gmeow/slices/events> ,
        <https://blackcatinformatics.ca/gmeow/slices/places> ,
        <https://blackcatinformatics.ca/gmeow/slices/accounts> ,
        <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    gmeow:sliceConsumer "Employers, publishers, registrars across slices; posts and roles; the W3C-ORG projection."@x-gmeow-english .
