gmeow:gmnGloss3Sg
    a lang:WordForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Leipzig gloss 3SG"@x-gmeow-english ;
    skos:definition "The Leipzig portmanteau gloss 3SG, a named-key alias of the Leipzig plane condensing the third-person and singular values into one interlinear label."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inSignSystem gmeow:leipzigGlossingRules .

gmeow:gmnGloss3SgDenotation
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of Leipzig 3SG"@x-gmeow-english ;
    skos:definition "The reified meaning assignment binding the Leipzig portmanteau gloss 3SG to both the third-person value lang:valThirdPerson and the singular number value lang:valSing it condenses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:denotedForm gmeow:gmnGloss3Sg ;
    lang:denotationKind lang:denotesEntity ;
    lang:denotationTarget lang:valThirdPerson , lang:valSing ;
    lang:denotationContext gmeow:gmnLangGlyphContext .

gmeow:gmnFormMorphemeBoundary
    a lang:WordForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "the Leipzig morpheme-boundary named key `-`"@x-gmeow-english ;
    skos:definition "The Leipzig morpheme-boundary marker, rendered as the ASCII named key `-` (hyphen-minus, U+002D). It stays a named key rather than entering the glyph table because the ASCII hyphen-minus is confusable with U+2010 (hyphen), U+2212 (minus sign), and U+00AD (soft hyphen); an alias that never leaves the named-key plane cannot be silently substituted by one of those look-alikes at serialization or transport."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:inSignSystem gmeow:leipzigGlossingRules .

gmeow:gmnDenMorphemeBoundary
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of the Leipzig morpheme-boundary named key `-`"@x-gmeow-english ;
    skos:definition "The reified meaning assignment binding the Leipzig morpheme-boundary named key `-` to lang:MorphemeBoundary, the segmentation point between adjacent morphs it marks."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    lang:denotedForm gmeow:gmnFormMorphemeBoundary ;
    lang:denotationKind lang:denotesClass ;
    lang:denotationTarget lang:MorphemeBoundary ;
    lang:denotationContext gmeow:gmnLangGlyphContext .

# --- Codebook wiring -------------------------------------------------------- #
# The current codebook references the two imported alias planes alongside the
# GMN script and sigils it already holds, so a reader that holds the codebook
# holds the linguistic plane's cited, versioned repertoire.

gmeow:gmnCodebookCurrent gmeow:references
    gmeow:ipaChart ,
    gmeow:leipzigGlossingRules .
