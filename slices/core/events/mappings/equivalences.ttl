@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmgeo: <http://www.ics.forth.gr/isl/CRMgeo/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix time:   <http://www.w3.org/2006/time#> .
@prefix teo:    <https://sbmi.uth.edu/bsdi/TEO_1.0.0.owl#> .
@prefix lode:   <http://linkedevents.org/ontology/> .
@prefix sem:    <http://semanticweb.cs.vu.nl/2009/11/sem/> .
@prefix ical:   <http://www.w3.org/2002/12/cal/icaltzd#> .
@prefix bio:    <http://purl.org/vocab/bio/0.1/> .
@prefix gx:     <http://gedcomx.org/> .
@prefix gedcom: <http://www.w3.org/2000/10/swap/pim/gedcom#> .
@prefix wd:     <http://www.wikidata.org/entity/> .
@prefix wdt:    <http://www.wikidata.org/prop/direct/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .

# Term equivalences for the universal events slice (event/temporal design) — GMEOW authoring source.
# Compiled to mappings/gmeow-events.sssom.tsv by `gmeow compile-mappings`. All
# alignments are BY REFERENCE (Principle 5); GMEOW never imports an external axiom.
# Event types and participant roles are VALUE individuals (gufo:QualityValue), so
# they align to external classes / fact-types / role-properties with skos:closeMatch
# (the placeType / Gender value-vocabulary convention), never owl:equivalentClass.

gmeow:mapsetEvents a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/events" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Universal-event alignments (event/temporal design) — gmeow:Event + the gmeow:Participation relator + the open gmeow:eventType / gmeow:ParticipantRole / gmeow:TemporalPrecision value vocabularies + the Allen temporal-relation algebra + Duration / RecurrenceRule, supersetting schema.org Event, CIDOC-CRM E5/E7, OWL-Time, the Time Event Ontology (TEO), ISO-TimeML (TLINK/TIMEX3/EVENT), PROV-O, iCalendar, LODE, SEM, BIO / GEDCOM X (the life-event types) and Wikidata BY REFERENCE.
        VALUE VOCABULARIES: eventType / participationRole individuals are gufo:QualityValue values, aligned to external classes, fact-types and role-properties with skos:closeMatch (a value-to-class/property correspondence), mirroring placeType. An unforeseen type/role is a fresh individual, never a new class or subproperty (Principle 9 — no overtyping, no role-subproperty proliferation).
        REIFIED PARTICIPATION: gmeow:Participation is the NameUsage relator idiom; it carries role / period / confidence / provenance / standpoint that schema.org's flat attendee/performer/organizer and OWL-Time's participation-free interval algebra cannot. The flat gmeow:hasParticipant covers the 80% case and projects to the flat targets.
        TEMPORAL RELATIONS: the 13 Allen interval relations relate gmeow:Event occurrences directly (the ISO-TimeML TLINK / TEO event-event idiom), aligned to OWL-Time interval* (relatedMatch — OWL-Time relates the intervals) and TEO (closeMatch — TEO is BFO-grounded like GMEOW). ISO-TimeML is an XML scheme with no canonical RDF namespace, so its TLINK/TIMEX3/EVENT relType/type/tense/aspect STRING enums are documented as value correspondences (see the inline table), not IRI-aligned; its OWL realization IS OWL-Time, aligned here.
        CONTESTED FACTS: a disputed type, role, date or location is several coexisting gmeow:accordingTo-indexed claims (standpoint module, standpoint facility), never one slot to win; there is no preferredRank / primaryClaim.
        CANONICAL (no faithful external term): gmeow:temporalPrecision and gmeow:earliestStart / latestEnd fuzzy bounds (related only to CRM E52 P82a/P82b begin/end-of bounds and TEO hasApproximation).""" .

# --------------------------------------------------------------------------- #
# The universal event and its reified participation.
# --------------------------------------------------------------------------- #

gmeow:Event skos:closeMatch schema:Event {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "schema:Event flattens participation to attendee/performer/organizer; GMEOW reifies it"
|} .

gmeow:Event skos:closeMatch crm:E5_Event {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "CIDOC-CRM E5 Event — the time-span/place/event separation is adopted; the PC property-class verbosity is not"
|} .

gmeow:Event skos:relatedMatch prov:Activity {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "prov:Activity is provenance-shaped (used/generated), not a general occurrence; gmeow:Activity (the GMEOW provenance class) is the closeMatch, gmeow:Event the broader generalization"
|} .

gmeow:Event skos:closeMatch lode:Event {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "LODE (Linking Open Descriptions of Events)"
|} .

gmeow:Event skos:closeMatch sem:Event {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Simple Event Model (SEM)"
|} .

gmeow:Event skos:relatedMatch ical:Vevent {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "iCalendar VEVENT is projection-grade (single time/place/agent); a lossy FnO target, not a peer model"
|} .

gmeow:Event skos:relatedMatch wd:Q1656682 {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Wikidata event (Q1656682)"
|} .

gmeow:Participation skos:closeMatch prov:Association {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "a reified role-in-an-event is a prov:Association (qualifiedAssociation); GMEOW adds period/confidence/standpoint"
|} .

gmeow:Participation skos:relatedMatch sem:Role {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "SEM reifies a role-binding (sem:Role); GMEOW's Participation is the same idiom with full provenance"
|} .

gmeow:EventSeries skos:closeMatch schema:EventSeries {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a recurrence that issues concrete occurrences"
|} .

# --------------------------------------------------------------------------- #
# Structural properties — participation, temporal placement, location, mereology.
# --------------------------------------------------------------------------- #

gmeow:hasParticipant skos:closeMatch lode:involvedAgent {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the flat event-participant shortcut"
|} .

gmeow:hasParticipant skos:closeMatch sem:hasActor {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "SEM actor of an event"
|} .

gmeow:hasParticipant skos:closeMatch crm:P11_had_participant {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "CIDOC-CRM P11 had participant"
|} .

gmeow:hasParticipant skos:closeMatch bio:agent {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "BIO agent in a life event"
|} .

gmeow:participationParticipant skos:relatedMatch prov:agent {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "the participant end of the reified Participation (prov:agent of a qualified association)"
|} .

gmeow:eventTime skos:closeMatch schema:startDate {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "point-in-time placement → schema startDate (projection collapses an interval too)"
|} .

gmeow:eventTime skos:closeMatch bio:date {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "BIO life-event date — replaces the former free-text gmeow:eventDate"
|} .

gmeow:eventTime skos:closeMatch wdt:P585 {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Wikidata 'point in time' (P585)"
|} .

gmeow:eventTime skos:closeMatch gedcom:date {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "legacy W3C gedcom date"
|} .

gmeow:eventInterval skos:relatedMatch crm:P4_has_time-span {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "the crisp interval of an event ≈ CIDOC P4 has time-span (E52)"
|} .

gmeow:eventInterval skos:relatedMatch time:hasTime {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "OWL-Time hasTime — grounds the interval; GMEOW keeps base datatypes DL-clean (xsd:dateTime)"
|} .

gmeow:earliestStart skos:relatedMatch crm:P82a_begin_of_the_begin {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "fuzzy lower bound ≈ CIDOC E52 begin-of-the-begin"
|} .

gmeow:latestEnd skos:relatedMatch crm:P82b_end_of_the_end {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "fuzzy upper bound ≈ CIDOC E52 end-of-the-end"
|} .

gmeow:eventLocation skos:closeMatch schema:location {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:eventLocation skos:closeMatch crm:P7_took_place_at {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
