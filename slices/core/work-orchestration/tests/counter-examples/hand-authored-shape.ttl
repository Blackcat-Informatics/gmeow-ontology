#
# Fail-witness for ex:saNoHandAuthoredShapes: a hand-authored node shape, the
# second source of truth the derived shape surface exists to prevent.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .

gmeow:WorkClusterShape a sh:NodeShape ;
    sh:targetClass gmeow:WorkCluster .
