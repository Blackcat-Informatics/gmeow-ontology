gmeow:MetricGroupOrderUniquenessConstraint
    a logic:SelfJoinUniquenessConstraint ;
    rdfs:label "Metric group order uniqueness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "Two distinct MetricGroups within the same MetricStructure must not share a metricGroupOrder index."@x-gmeow-english ;
    logic:formalizes gmeow:MetricGroup ;
    logic:message "A MetricGroup order must be unique within its MetricStructure." ;
    logic:siblingPredicate gmeow:hasMetricGroup ;
    logic:sharedPredicate gmeow:metricGroupOrder .

gmeow:SegmentTransformationDistinctConstraint
    a logic:CrossNodeConstraint ;
    rdfs:label "Segment transformation distinct constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A SegmentTransformation source and target must be distinct entities."@x-gmeow-english ;
    logic:onClass gmeow:SegmentTransformation ;
    logic:formalizes gmeow:SegmentTransformation ;
    logic:message "A SegmentTransformation source and target must be distinct entities." ;
    logic:roleA gmeow:transformationSource ;
    logic:roleB gmeow:transformationTarget ;
    logic:crossMode "differ" .

gmeow:OrnamentProfileApplicationConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "Ornament profile application constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "An OrnamentProfile must apply to at least one MusicalSegment or Voice."@x-gmeow-english ;
    logic:onClass gmeow:OrnamentProfile ;
    logic:formalizes gmeow:OrnamentProfile ;
    logic:message "An OrnamentProfile must apply to at least one MusicalSegment or Voice." ;
    logic:anyOf gmeow:appliesToSegment , gmeow:appliesToVoice .

