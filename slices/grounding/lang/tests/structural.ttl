#
# Declarative structural assertions for the language slice — the slice-resident
# test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants. Each assertion
# runs as a SPARQL ASK over the language module graph (gmeow:scopeModule) under
# the native Rust slicetest harness (crates/slicetest).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/lang/tests/> .

# --- 1. The form-AST strata subclass lang:Form (MUST) ----------------------- #
ex:saFormStrata a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX lang: <https://blackcatinformatics.ca/lang/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    lang:SurfaceForm      rdfs:subClassOf lang:Form .
    lang:Lexeme           rdfs:subClassOf lang:Form .
    lang:WordForm         rdfs:subClassOf lang:Form .
    lang:ComposedForm     rdfs:subClassOf lang:Form .
    lang:Morpheme         rdfs:subClassOf lang:Form .
    lang:Morph            rdfs:subClassOf lang:Form .
    lang:OrthographicWord rdfs:subClassOf lang:Form .
    lang:CovertForm       rdfs:subClassOf lang:Form .
    lang:UnanalyzedProse  rdfs:subClassOf lang:SurfaceForm .
    lang:SyntacticWord    rdfs:subClassOf lang:WordForm .
}""" ;
    gmeow:saRationale "Every structured stratum of the form AST MUST subclass lang:Form, so the mandatory-sign-system gate (lang:FormSituatedShape) reaches all of them, and the word-level and prose strata sit under their proper parents." .

# --- 2. Every failure class subclasses lang:LangConformanceFailure (MUST) ---- #
ex:saFailureHierarchy a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX lang: <https://blackcatinformatics.ca/lang/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    lang:UnsituatedForm      rdfs:subClassOf lang:LangConformanceFailure .
    lang:MisdeclaredAnalysis rdfs:subClassOf lang:LangConformanceFailure .
    lang:DuplicateSlotIndex  rdfs:subClassOf lang:LangConformanceFailure .
    lang:NonContiguousSlots  rdfs:subClassOf lang:LangConformanceFailure .
    lang:DanglingDependency  rdfs:subClassOf lang:LangConformanceFailure .
    lang:UntypedMorphology   rdfs:subClassOf lang:LangConformanceFailure .
    lang:UnhashableSurface   rdfs:subClassOf lang:LangConformanceFailure .
    lang:UnanchoredOffset    rdfs:subClassOf lang:LangConformanceFailure .
    lang:StringOnlyForm      rdfs:subClassOf lang:LangConformanceFailure .
    lang:UngroundedGrapheme  rdfs:subClassOf lang:LangConformanceFailure .
}""" ;
    gmeow:saRationale "Each of the ten hard-rule failures MUST be a subclass of lang:LangConformanceFailure, so a violation is a typed, queryable object." .

# --- 3. The sign-system kinds and modalities exist as individuals (MUST) ----- #
ex:saKindIndividuals a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX lang: <https://blackcatinformatics.ca/lang/>
ASK {
    lang:naturalLanguageKind a lang:SignSystemKind .
    lang:formalLanguageKind  a lang:SignSystemKind .
    lang:notationalKind      a lang:SignSystemKind .
    lang:gesturalKind        a lang:SignSystemKind .
    lang:tactileKind         a lang:SignSystemKind .
    lang:writtenModality     a lang:Modality .
    lang:signedModality      a lang:Modality .
    lang:tactileModality     a lang:Modality .
}""" ;
    gmeow:saRationale "Sign systems are distinguished by kind and modality individuals rather than by a subclass ladder; the natural, formal, notational, gestural, and tactile kinds and the written/signed/tactile modalities MUST exist so signed languages and Braille are first-class." .

# --- 4. The analysis levels are ordered by lang:levelRank (MUST) ------------- #
ex:saAnalysisLevelOrder a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX lang: <https://blackcatinformatics.ca/lang/>
ASK {
    lang:rawLevel          lang:levelRank 0 .
    lang:segmentedLevel    lang:levelRank 1 .
    lang:tokenizedLevel    lang:levelRank 2 .
    lang:morphAnalyzedLevel lang:levelRank 3 .
    lang:parsedLevel       lang:levelRank 4 .
}""" ;
    gmeow:saRationale "The graded analysis lattice MUST be data-driven: each lang:AnalysisLevel carries an integer lang:levelRank from raw (0) to parsed (4), so the ordering is queryable without hard-coding names." .

# --- 5. No lang: property asserts an EL-forbidden OWL characteristic (MUST-NOT) - #
ex:saNoForbiddenCharacteristics a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    ?p a ?characteristic .
    FILTER (?characteristic IN (
        owl:SymmetricProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty,
        owl:FunctionalProperty, owl:InverseFunctionalProperty
    ))
    FILTER (STRSTARTS(STR(?p), "https://blackcatinformatics.ca/lang/"))
}""" ;
    gmeow:saRationale "No lang: property MUST carry a symmetric, asymmetric, irreflexive, functional, or inverse-functional OWL characteristic — the profile is kept EL-clean; functionality (every form names exactly one sign system) is enforced in SHACL, and the inverse pairing of lang:spansWords / lang:tokenOf is documented in prose." .
