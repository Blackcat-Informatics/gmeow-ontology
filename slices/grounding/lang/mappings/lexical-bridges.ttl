gmeow:eqLangAnchorOa a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:SurfaceAnchor ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject oa:TextPositionSelector ;
    logic:sourceEndpoint lang:SurfaceAnchor ; logic:targetEndpoint oa:TextPositionSelector ;
    gmeow:justification semapv:ManualMappingCuration ; gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-lang-web-annotation.sssom.tsv" ;
    gmeow:comment "The selector is an exchange representation of the native anchor; source attachment is modeled at a different node in Web Annotation." ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

gmeow:eqLangAnchorStartOa a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:anchorStart ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject oa:start ;
    logic:sourceEndpoint lang:anchorStart ; logic:targetEndpoint oa:start ;
    gmeow:justification semapv:ManualMappingCuration ; gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-lang-web-annotation.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

gmeow:eqLangAnchorEndOa a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:anchorEnd ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject oa:end ;
    logic:sourceEndpoint lang:anchorEnd ; logic:targetEndpoint oa:end ;
    gmeow:justification semapv:ManualMappingCuration ; gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-lang-web-annotation.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .

gmeow:eqLangAnchorSourceOa a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:anchorSource ; gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject oa:hasSource ;
    logic:sourceEndpoint lang:anchorSource ; logic:targetEndpoint oa:hasSource ;
    gmeow:justification semapv:ManualMappingCuration ; gmeow:confidence 0.7 ;
    gmeow:sssomFile "gmeow-lang-web-annotation.sssom.tsv" ;
    gmeow:comment "Web Annotation places hasSource on the SpecificResource rather than directly on the TextPositionSelector, so this is relatedMatch only." ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly .
