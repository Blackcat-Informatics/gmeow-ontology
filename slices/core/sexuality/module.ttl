    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> ;
    rdfs:label "sexualOrientationValue is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:sexualOrientationValue is functional: a gmeow:SexualOrientation facet names exactly one sexual-orientation value — a change of orientation is modelled as a new facet rather than a second value on this functional edge."@x-gmeow-english ;
    logic:characterizes gmeow:sexualOrientationValue ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:sexualOrientationValue ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:sexualOrientationValue names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:sexualOrientationValue, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:sexualOrientationValue and nothing else. It is not a definition of gmeow:sexualOrientationValue (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:sexualOrientationValueFunctionality logic:characterizes gmeow:sexualOrientationValue ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
