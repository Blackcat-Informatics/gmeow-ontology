<http://example.org/lang/glossary-vartrans/form-tgt/e2c62418607d2f72>
    a ontolex:Form ;
    ontolex:writtenRep "Seuil d'axe"@fr .

<http://example.org/lang/glossary-vartrans/form-tgt/e2ca5241cfd4e483>
    a ontolex:Form ;
    ontolex:writtenRep "紧化空间"@zh .

