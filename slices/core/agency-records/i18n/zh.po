msgstr "通过 invocationOutcome 附加 invocationOutcomeFailed，保留来源归属及时间上下文。"

msgctxt "https://blackcatinformatics.ca/gmeow/invocationOutcomeFailed|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:invocationOutcome gmeow:invocationOutcomeFailed ."
msgstr "ex:record gmeow:invocationOutcome gmeow:invocationOutcomeFailed ."

msgctxt "https://blackcatinformatics.ca/gmeow/attemptStop|http://www.w3.org/2000/01/rdf-schema#label"
msgid "attempt stop"
msgstr "尝试停止方式"

msgctxt "https://blackcatinformatics.ca/gmeow/attemptStop|http://www.w3.org/2004/02/skos/core#definition"
msgid "How a recorded attempt finish stopped, independent of whether the goal was satisfied."
msgstr "已记录的尝试结束如何停止，独立于目标是否满足。"

msgctxt "https://blackcatinformatics.ca/gmeow/attemptStop|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve the source’s attempt stop relation."
msgstr "用于保留来源的尝试停止方式关联关系。"

msgctxt "https://blackcatinformatics.ca/gmeow/attemptStop|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing a attemptStop target from a different lifecycle or status axis."
msgstr "避免从另一生命周期或状态维度虚构 attemptStop 目标。"

msgctxt "https://blackcatinformatics.ca/gmeow/attemptStop|https://blackcatinformatics.ca/gmeow/howToUse"
