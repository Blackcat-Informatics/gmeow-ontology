@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix vann:  <http://purl.org/vocab/vann/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/lang>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    vann:preferredNamespacePrefix "lang" ;
    vann:preferredNamespaceUri "https://blackcatinformatics.ca/lang/" ;
    rdfs:comment "Grounding vocabulary for GMEOW Language. The lang: namespace <https://blackcatinformatics.ca/lang/> is the semiotic grounding surface, the third co-foundational grounding layer alongside logic: and math: (Principle 19). It grounds what language is made of before meaning is attached: the sign-system reference layer (sign systems, varieties, scripts, orthographies, grammars, held as first-class individuals distinguished by kind) and the typed form AST (surface forms, graphemes and phones, morphemes and morphs, lexemes and word forms, orthographic and syntactic words, composed forms over indexed slots with dependency structure, covert forms, and competing analyses). Form identity is computed over structural content alone and is independent of encoding, script, casing, and rendering."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMEOW Language"@x-gmeow-english ;
    skos:definition "The GMEOW Language module — home of the lang: grounding vocabulary. Its two load-bearing commitments are that a language is an individual and never a tag, and that a string is a surface while the form is a tree. A sign system is a first-class individual distinguished by a lang:SignSystemKind and a lang:Modality rather than by a subclass ladder; scripts (character repertoires) and orthographies (system-to-script conventions) are separated; grammars are first-class objects that license forms without owning their identity. A form that carries inferential weight is a structured lang:Form, never an opaque string: every form names exactly one sign system, morphology is typed against a lang:FeatureInventory, constituent order is carried by indexed lang:FormSlot individuals with co-resident dependency edges, and every surface either realizes an analyzed form or is explicitly lang:UnanalyzedProse. The graded lang:AnalysisLevel records how far a surface has been analyzed (raw, segmented, tokenized, morph-analyzed, parsed) rather than forcing a binary. The typed conformance-failure vocabulary (lang:LangConformanceFailure and its subclasses) makes every well-formedness violation a queryable object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Sign-system reference layer
# =========================================================================== #

lang:SignSystem
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Sign System"@x-gmeow-english ;
    skos:definition "A sign system: the system of signs a form belongs to — a natural language (English), a formal language (Turtle, GTS), a notation (IPA), a gestural language (a signed language), or a tactile system (Braille). A first-class individual, never a subclass ladder and never a bare tag: it is distinguished by a lang:SignSystemKind (through lang:signSystemKind) and a lang:Modality (through lang:modality), and it may align to a BCP-47 tag, an ISO 639 code, a Wikidata QID, or a MIME type — but the GMEOW term remains the local source of truth and external identifiers name alignments, not identity. Every lang:Form names exactly one through lang:inSignSystem."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SignSystemKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Sign System Kind"@x-gmeow-english ;
    skos:definition "The kind of a sign system — natural, formal, notational, gestural, or tactile. Its instances are the named individuals lang:naturalLanguageKind, lang:formalLanguageKind, lang:notationalKind, lang:gesturalKind, and lang:tactileKind. A sign system points at one through lang:signSystemKind; the kind-individual pattern keeps the TBox small and the ABox expressive rather than minting an OWL class per language."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:LanguageVariety
    a owl:Class ;
    rdfs:subClassOf lang:SignSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Language Variety"@x-gmeow-english ;
    skos:definition "A variety of a sign system — Quebec French, Middle English, or RFC-2119 requirement prose. A subclass of lang:SignSystem related to its parent system through lang:varietyOf, time-scoped through the temporal slice where the variety is a stage. A variety is a system in its own right, not a qualifier; a BCP-47 tag such as fr-CA is a projection of a variety individual, never its definition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Script
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Script"@x-gmeow-english ;
    skos:definition "A script: a character repertoire — Latin, Cyrillic, Han. Distinct from an orthography, which is the convention binding a sign system to a script (Serbian has one language and two orthographies). A script names its member characters through lang:hasGrapheme; a lang:Grapheme declares the script it belongs to through lang:inScript. Aligns to ISO 15924 as a generated identifier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Orthography
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Orthography"@x-gmeow-english ;
    skos:definition "An orthography: a convention binding a sign system to a script — the writing convention, as distinct from the script's bare character repertoire. Names the sign system it serves through lang:orthographyFor and the script it uses through lang:usesScript. Transliteration between orthographies is a rendering-layer map, not a form-identity change."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Grammar
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Grammar"@x-gmeow-english ;
    skos:definition "A grammar: a first-class object naming the sign system it licenses (through lang:grammarFor) and carrying its rules as lang:GrammarRule individuals. Declares its formalism through lang:grammarFormalism (context-free, PEG, regular, ABNF, EBNF). Formal grammars (Turtle's, GTS's) are held natively and projected to EBNF/ABNF — a grammar file is a rendering of the grammar object, not the grammar. A grammar licenses forms; it never owns their identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GrammarRule
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Grammar Rule"@x-gmeow-english ;
    skos:definition "A production rule of a grammar: names the grammar it belongs to through lang:grammarRuleOf. A form may declare the rule that licenses it through lang:licensedBy, but form identity never depends on the grammar — grammars change, forms persist, and the licensing link is versioned like any evolving claim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GrammarFormalism
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Grammar Formalism"@x-gmeow-english ;
    skos:definition "The formalism a grammar is expressed in. Its instances are the named individuals lang:cfgFormalism, lang:pegFormalism, lang:regularFormalism, lang:abnfFormalism, and lang:ebnfFormalism. A lang:Grammar points at one through lang:grammarFormalism."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Modality
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Modality"@x-gmeow-english ;
    skos:definition "The channel a sign system operates in — written, spoken, signed, or tactile. Its instances are the named individuals lang:writtenModality, lang:spokenModality, lang:signedModality, and lang:tactileModality. A sign system points at one through lang:modality, so signed languages and Braille are first-class rather than special cases of writing."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Sign-system-kind individuals ------------------------------------------- #

lang:naturalLanguageKind
    a owl:NamedIndividual , lang:SignSystemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "natural language"@x-gmeow-english ;
    skos:definition "The kind of sign system that is a natural human language — English, French, Japanese."@x-gmeow-english .

lang:formalLanguageKind
    a owl:NamedIndividual , lang:SignSystemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "formal language"@x-gmeow-english ;
    skos:definition "The kind of sign system that is a formal language with an explicit grammar — Turtle, the GTS grammar, a programming language."@x-gmeow-english .

lang:notationalKind
    a owl:NamedIndividual , lang:SignSystemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "notation"@x-gmeow-english ;
    skos:definition "The kind of sign system that is a notation — IPA, mathematical notation, a controlled symbolic vocabulary."@x-gmeow-english .

lang:gesturalKind
    a owl:NamedIndividual , lang:SignSystemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "gestural"@x-gmeow-english ;
    skos:definition "The kind of sign system that is gestural — a signed language such as ASL."@x-gmeow-english .

lang:tactileKind
    a owl:NamedIndividual , lang:SignSystemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "tactile"@x-gmeow-english ;
    skos:definition "The kind of sign system that is tactile — Braille."@x-gmeow-english .

# --- Modality individuals --------------------------------------------------- #

lang:writtenModality
    a owl:NamedIndividual , lang:Modality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "written"@x-gmeow-english ;
    skos:definition "The written modality — a sign system realized as text in a script."@x-gmeow-english .

lang:spokenModality
    a owl:NamedIndividual , lang:Modality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "spoken"@x-gmeow-english ;
    skos:definition "The spoken modality — a sign system realized as speech."@x-gmeow-english .

lang:signedModality
    a owl:NamedIndividual , lang:Modality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "signed"@x-gmeow-english ;
    skos:definition "The signed modality — a sign system realized in gesture and space, as in a signed language."@x-gmeow-english .

lang:tactileModality
    a owl:NamedIndividual , lang:Modality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "tactile"@x-gmeow-english ;
    skos:definition "The tactile modality — a sign system realized by touch, as in Braille."@x-gmeow-english .

# --- Grammar-formalism individuals ------------------------------------------ #

lang:cfgFormalism
    a owl:NamedIndividual , lang:GrammarFormalism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "context-free"@x-gmeow-english ;
    skos:definition "The context-free grammar formalism."@x-gmeow-english .

lang:pegFormalism
    a owl:NamedIndividual , lang:GrammarFormalism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "PEG"@x-gmeow-english ;
    skos:definition "The parsing-expression-grammar formalism."@x-gmeow-english .

lang:regularFormalism
    a owl:NamedIndividual , lang:GrammarFormalism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "regular"@x-gmeow-english ;
    skos:definition "The regular-grammar formalism."@x-gmeow-english .

lang:abnfFormalism
    a owl:NamedIndividual , lang:GrammarFormalism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "ABNF"@x-gmeow-english ;
    skos:definition "The RFC 5234 ABNF grammar-interchange formalism."@x-gmeow-english .

lang:ebnfFormalism
    a owl:NamedIndividual , lang:GrammarFormalism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "EBNF"@x-gmeow-english ;
    skos:definition "The ISO/IEC 14977 EBNF grammar-interchange formalism."@x-gmeow-english .

# --- Self-hosting grammar individuals --------------------------------------- #
# The grammars of GMEOW's own serialization sign systems, held as first-class
# lang:Grammar individuals. The full grammar bytes are the EBNF renderings under
# grammars/turtle.ebnf and grammars/gts.ebnf (an EBNF file is a rendering of the
# grammar object, not the grammar); each individual references its rendering by
# label and licenses its sign system through lang:grammarFor. This is the semantic
# statement that the native parse of Turtle and GTS is an interpretation over these
# grammars — the self-description, not a second parser stack.

lang:turtleGrammar
    a owl:NamedIndividual , lang:Grammar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Turtle grammar"@x-gmeow-english ;
    skos:definition "The grammar of the W3C Turtle serialization, licensing the lang:turtle sign system the native codec interprets. Its EBNF rendering is grammars/turtle.ebnf; the file is a rendering of this grammar object, never its identity."@x-gmeow-english ;
    lang:grammarFor lang:turtle ;
    lang:grammarFormalism lang:ebnfFormalism .

lang:gtsGrammar
    a owl:NamedIndividual , lang:Grammar ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GTS grammar"@x-gmeow-english ;
    skos:definition "The grammar of the GTS textual serialization, licensing the lang:gts sign system the native codec interprets. Its EBNF rendering is grammars/gts.ebnf; the file is a rendering of this grammar object, never its identity."@x-gmeow-english ;
    lang:grammarFor lang:gts ;
    lang:grammarFormalism lang:ebnfFormalism .

# --- Canonical sign-system and script references ---------------------------- #
# A minimal set of first-class sign-system individuals the reference layer names
# and the alignment records anchor to. English and Turtle are sign systems; Latin
# is a script. External identifiers (Wikidata, Glottolog, ISO 639, ISO 15924) name
# alignments of these individuals in mappings/equivalences.ttl, never their identity.

lang:english
    a owl:NamedIndividual , lang:SignSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "English"@x-gmeow-english ;
    skos:definition "The English natural language as a first-class sign system: a lang:SignSystem of lang:naturalLanguageKind in the written modality. Its BCP-47 tag en, ISO 639-3 code eng, Glottolog languoid, and Wikidata QID are generated identifiers recorded as alignments, never its definition."@x-gmeow-english ;
    lang:signSystemKind lang:naturalLanguageKind ;
    lang:modality lang:writtenModality .

lang:turtle
    a owl:NamedIndividual , lang:SignSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Turtle"@x-gmeow-english ;
    skos:definition "The W3C Turtle serialization as a first-class sign system: a lang:SignSystem of lang:formalLanguageKind in the written modality, licensed by a lang:Grammar. One of GMEOW's own serialization sign systems."@x-gmeow-english ;
    lang:signSystemKind lang:formalLanguageKind ;
    lang:modality lang:writtenModality .

lang:gts
    a owl:NamedIndividual , lang:SignSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GTS"@x-gmeow-english ;
    skos:definition "The GTS textual serialization as a first-class sign system: a lang:SignSystem of lang:formalLanguageKind in the written modality, licensed by a lang:Grammar. One of GMEOW's own serialization sign systems, the surface the native GTS codec interprets."@x-gmeow-english ;
    lang:signSystemKind lang:formalLanguageKind ;
    lang:modality lang:writtenModality .

lang:latinScript
    a owl:NamedIndividual , lang:Script ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Latin script"@x-gmeow-english ;
    skos:notation "Latn"^^xsd:string ;
    skos:definition "The Latin script as a first-class character repertoire: a lang:Script. Its ISO 15924 code Latn (carried machine-readably as a skos:notation) and Wikidata QID are alignments, never its identity."@x-gmeow-english .

lang:hanScript
    a owl:NamedIndividual , lang:Script ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Han script"@x-gmeow-english ;
    skos:notation "Hani"^^xsd:string ;
    skos:definition "The Han (CJK) script as a first-class character repertoire: a lang:Script. Its ISO 15924 code Hani (carried machine-readably as a skos:notation) and Wikidata QID are alignments, never its identity."@x-gmeow-english .

# --- The internal GMEOW English carrier variety and its orthography ---------- #
# The @x-gmeow-english carrier under which every source prose literal is authored
# is a language individual, never a bare tag: a lang:LanguageVariety of English
# (the controlled, RFC-2119-style English GMEOW writes its own prose in), carrying
# its internal language tag as machine-readable data through lang:carrierTag. Its
# script is bound through an orthography — the module's designated sign-system-to-
# script convention — using the existing lang:orthographyFor and lang:usesScript.
# Resolving a carrier tag to its lang:Script is therefore a pure data lookup over
# this model; adding a language is adding a variety + orthography here, never a
# Rust code change.

lang:gmeowEnglish
    a owl:NamedIndividual , lang:LanguageVariety ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMEOW English carrier"@x-gmeow-english ;
    skos:definition "The internal GMEOW English carrier: the controlled variety of English under which every @x-gmeow-english source prose literal is authored — a lang:LanguageVariety of lang:english, a language individual rather than a bare tag. Its internal language tag x-gmeow-english is carried machine-readably through lang:carrierTag; its script is bound through lang:gmeowEnglishOrthography. Resolving the carrier tag to its lang:Script is a data lookup over this model, never a hard-coded mapping."@x-gmeow-english ;
    lang:varietyOf lang:english ;
    lang:signSystemKind lang:naturalLanguageKind ;
    lang:modality lang:writtenModality ;
    lang:carrierTag "x-gmeow-english" .

lang:gmeowEnglishOrthography
    a owl:NamedIndividual , lang:Orthography ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMEOW English orthography"@x-gmeow-english ;
    skos:definition "The writing convention binding the internal GMEOW English carrier (lang:gmeowEnglish) to the Latin script: a lang:Orthography that serves that variety through lang:orthographyFor and uses lang:latinScript through lang:usesScript. This is the data edge that makes carrier-tag-to-script resolution a lookup rather than a Rust match."@x-gmeow-english ;
    lang:orthographyFor lang:gmeowEnglish ;
    lang:usesScript lang:latinScript .

# =========================================================================== #
# Form AST — the stratified form calculus
# =========================================================================== #

lang:Form
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Form"@x-gmeow-english ;
    skos:definition "The abstract root of the form AST: a form that is meant to be analyzed, denoted, translated, matched, or projected is a structured object, never an opaque string. Every lang:Form names exactly one sign system through lang:inSignSystem — an unsituated form is ill-formed. Its identity is computed over structural content alone (sign system, stratum, features, slot structure with constituent keys) and is independent of encoding, script, casing, and rendering. The strata that specialize it — surface forms, morphemes and morphs, lexemes and word forms, orthographic and syntactic words, composed forms, and covert forms — each have a distinct identity criterion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SurfaceForm
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Surface Form"@x-gmeow-english ;
    skos:definition "A concrete realization of a form: text (through lang:surfaceText) with a declared script (lang:inScript), encoding (lang:encoding), Unicode normalization (lang:unicodeNormalization), and collation locale (lang:collationLocale). The only stratum where byte identity means anything: two surface forms with different normalization are different surface forms of possibly the same form. A surface either realizes an analyzed form through lang:realizes or is typed lang:UnanalyzedProse — never silently either — and declares how far it has been analyzed through lang:analysisLevel. It may carry a lang:SurfaceAnchor locating it in a source document. Re-encoding or re-normalizing a text creates new surface forms but no new forms."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnanalyzedProse
    a owl:Class ;
    rdfs:subClassOf lang:SurfaceForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unanalyzed Prose"@x-gmeow-english ;
    skos:definition "A surface form explicitly recorded as carrying no analyzed structure yet — the honest status of most @x-gmeow-english prose fields. Lawful and expected, but a recorded status rather than an ambient assumption, so 'this string has no structure yet' is a queryable fact. An unanalyzed-prose surface is at lang:rawLevel and does not lang:realize an analyzed form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SurfaceAnchor
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Surface Anchor"@x-gmeow-english ;
    skos:definition "A stand-off anchor locating a surface form in a source: names the source through lang:anchorSource, the span through lang:anchorStart and lang:anchorEnd, and the offset space through lang:offsetSpace (byte, codepoint, or grapheme cluster). Surface-stratum material excluded from form identity but included in surface identity; the anchor is what makes the prose-hash discipline a lookup rather than a recomputation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Grapheme
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Grapheme"@x-gmeow-english ;
    skos:definition "A grapheme: a member character of a script's repertoire — a Latin letter, a Cyrillic letter, a Han character. Declares the script it belongs to through lang:inScript; the owning script lists it through lang:hasGrapheme. A grapheme not in its script's repertoire is ill-formed. Below the morph in the stratification; a repertoire element rather than a sign-system-scoped form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Phone
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Phone"@x-gmeow-english ;
    skos:definition "A phone: a segment of sound, the phonetic counterpart of a grapheme, notated in IPA. Below the morph in the stratification; the segment stratum for spoken and phonological analysis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Morpheme
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Morpheme"@x-gmeow-english ;
    skos:definition "A morpheme: the abstract smallest meaningful unit — the identity-bearing plural morpheme, the past-tense morpheme — as distinct from its concrete realizations. Its realizing morphs name it through lang:morphemeOf. The abstract counterpart of the concrete lang:Morph, the morphological peer of the lang:Lexeme / lang:WordForm split."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Morph
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Morph"@x-gmeow-english ;
    skos:definition "A morph: the concrete realization of a morpheme — /s/, /z/, /ɪz/ realizing the English plural morpheme. Names the morpheme it realizes through lang:morphemeOf and any morph it is an allomorph of through lang:allomorphOf. Carries typed morphological content through lang:morphFeature; morphology is never a free string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:MorphFeature
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Morph Feature"@x-gmeow-english ;
    skos:definition "A typed morphological feature-value pair — Number=Plur, Tense=Past — carrying a key drawn from a feature inventory (lang:featureKey, a lang:FeatureKey individual), a value drawn from that inventory (lang:featureValue, a lang:FeatureValue individual), and optionally a layer (lang:featureLayer, as in the UD Number[psor] convention). Morphological content is carried this way, never as an unparsed feature string; the inventory aligns to Universal Dependencies' universal features and extends past them where a language demands it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Lexeme
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Lexeme"@x-gmeow-english ;
    skos:definition "A lexeme: the dictionary word — the abstract cat, as opposed to its inflections cat and cats. Declares its part of speech through lang:partOfSpeech. The lexeme, not the spelling, is what senses attach to (in the meaning layer). The OntoLex form / lexical-entry split, held with GMEOW's claim rigor."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:WordForm
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Word Form"@x-gmeow-english ;
    skos:definition "A word form: an inflection of a lexeme — cats as an inflection of the lexeme cat. Names its lexeme through lang:lexemeOf (and the inflection relation through lang:inflectionOf), and carries the morphological features distinguishing it through lang:morphFeature (cats carries Number=Plur)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:OrthographicWord
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Orthographic Word"@x-gmeow-english ;
    skos:definition "An orthographic word: a whitespace- or punctuation-delimited token that may correspond to several syntactic words — French du (= de le), English isn't (= is + n't). Names the syntactic words it spans through lang:spansWords. The CoNLL-U multiword-token distinction, held natively: one orthographic token is not always one syntactic word."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SyntacticWord
    a owl:Class ;
    rdfs:subClassOf lang:WordForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Syntactic Word"@x-gmeow-english ;
    skos:definition "A syntactic word: a word form that is a unit of syntactic analysis, participating in the dependency and constituency structure — de and le as the two syntactic words of the orthographic word du. Names the orthographic word it belongs to through lang:tokenOf. A subclass of lang:WordForm."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:ComposedForm
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Composed Form"@x-gmeow-english ;
    skos:definition "A composed form: a phrase, clause, sentence, paragraph, section, or text as a tree over indexed slots. Declares its level through lang:compositionLevel, its constituents through lang:formSlot, and its head where headedness is analyzed through lang:formHead. Constituent order is carried by lang:FormSlot individuals with integer lang:slotIndex, never by RDF list ordering — two encodings of one form must be one form. Code-switching is compositional: the composed form belongs to its matrix system while embedded constituents carry their own."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FormSlot
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Form Slot"@x-gmeow-english ;
    skos:definition "A slot in a composed form: carries an integer lang:slotIndex (constituent order), the constituent form (lang:slotForm), optionally a grammatical role (lang:slotRole, a lang:FormRole individual), and — where a dependency analysis is present — a dependency relation (lang:dependencyRelation) and a head reference among sibling slots (lang:dependsOn). Slot indexes are unique per composed form; strict canonical mode requires them zero-based and contiguous. Word order and grammatical function are identity-bearing."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FormRole
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Form Role"@x-gmeow-english ;
    skos:definition "A grammatical role or dependency relation a constituent plays — subject, predicate, object, modifier. Universal-Dependencies-relation-alignable. Its instances are named individuals such as lang:subjectRole, lang:predicateRole, lang:objectRole, and lang:modifierRole; a slot points at one through lang:slotRole or lang:dependencyRelation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:CovertForm
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Covert Form"@x-gmeow-english ;
    skos:definition "A covert form: a constituent that is structurally present but has no surface material — a zero morpheme (the plural of sheep), a syntactic trace, an elided or pro-dropped element. Keys distinctly from an absent constituent, so morphological and syntactic completeness survives even where there is nothing to spell. A subclass of lang:Form; it names its sign system like any form but has no realizing surface."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Analysis
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Analysis"@x-gmeow-english ;
    skos:definition "A grouping of one coherent analysis of a surface — one segmentation and one parse — so that competing analyses of the same surface are co-resident, comparable, and non-collapsing. Slots and dependency edges are scoped to the analysis they belong to through lang:inAnalysis; an edge leaving its analysis is ill-formed. The structural foundation for ambiguity: the meaning layer attaches vantage and confidence to readings over these analyses, but the multiplicity of structure lives here."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:PartOfSpeech
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Part of Speech"@x-gmeow-english ;
    skos:definition "A part of speech — noun, verb, adjective. Its instances are named individuals such as lang:noun and lang:verb, Universal-Dependencies-UPOS-alignable. A lexeme points at one through lang:partOfSpeech."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:CompositionLevel
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Composition Level"@x-gmeow-english ;
    skos:definition "The level at which a composed form composes — morphological word, phrase, clause, sentence, paragraph, section, or text. Its instances are the named individuals lang:morphWordLevel, lang:phraseLevel, lang:clauseLevel, lang:sentenceLevel, lang:paragraphLevel, lang:sectionLevel, and lang:textLevel. A composed form points at one through lang:compositionLevel, so a sentence and a document are distinguishable and document structure is first-class for the prose lift."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:AnalysisLevel
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Analysis Level"@x-gmeow-english ;
    skos:definition "How far a surface form has been analyzed — raw, segmented, tokenized, morph-analyzed, or parsed. Its instances are the named individuals lang:rawLevel, lang:segmentedLevel, lang:tokenizedLevel, lang:morphAnalyzedLevel, and lang:parsedLevel, ordered by an integer lang:levelRank. A surface points at exactly one through lang:analysisLevel, and its structure must match the declared level. This graded status replaces a binary analyzed/unanalyzed flag and preserves the epistemic shape of partial analysis; denotation is the meaning layer's level, above these."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FeatureInventory
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Feature Inventory"@x-gmeow-english ;
    skos:definition "A declared inventory of morphological feature keys and values — the Universal Dependencies universal features and its language-specific extensions. Its member keys and values name it through lang:inFeatureInventory. Typed morphology is drawn from an inventory rather than authored as free strings; the inventory is the alignment anchor for UD and UniMorph."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FeatureKey
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Feature Key"@x-gmeow-english ;
    skos:definition "A morphological feature key — Number, Case, Tense, Person. Its instances are named individuals belonging to a lang:FeatureInventory through lang:inFeatureInventory. A lang:MorphFeature names its key through lang:featureKey, an inventory individual rather than a bare string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FeatureValue
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Feature Value"@x-gmeow-english ;
    skos:definition "A morphological feature value — Plur, Sing, Past, Pres, Nom, Acc. Its instances are named individuals belonging to a lang:FeatureInventory through lang:inFeatureInventory. A lang:MorphFeature names its value (or, for disjunctive underspecification, several) through lang:featureValue, an inventory individual rather than a bare string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:OffsetSpace
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Offset Space"@x-gmeow-english ;
    skos:definition "The unit an anchor's offsets are measured in — byte, Unicode codepoint, or grapheme cluster. Its instances are the named individuals lang:byteOffset, lang:codepointOffset, and lang:graphemeClusterOffset. A lang:SurfaceAnchor names one through lang:offsetSpace so its span is unambiguous."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Form-role individuals -------------------------------------------------- #

lang:subjectRole
    a owl:NamedIndividual , lang:FormRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "subject"@x-gmeow-english ;
    skos:definition "The subject role — Universal Dependencies nsubj."@x-gmeow-english .

lang:predicateRole
    a owl:NamedIndividual , lang:FormRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "predicate"@x-gmeow-english ;
    skos:definition "The predicate role — the head verb of a clause, Universal Dependencies root for the main predicate."@x-gmeow-english .

lang:objectRole
    a owl:NamedIndividual , lang:FormRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "object"@x-gmeow-english ;
    skos:definition "The object role — Universal Dependencies obj."@x-gmeow-english .

lang:modifierRole
    a owl:NamedIndividual , lang:FormRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "modifier"@x-gmeow-english ;
    skos:definition "The modifier role — an adjectival or adverbial modifier, Universal Dependencies amod/advmod."@x-gmeow-english .

# --- Part-of-speech individuals --------------------------------------------- #

lang:noun
    a owl:NamedIndividual , lang:PartOfSpeech ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "noun"@x-gmeow-english ;
    skos:definition "The noun part of speech — Universal Dependencies UPOS NOUN."@x-gmeow-english .

lang:verb
    a owl:NamedIndividual , lang:PartOfSpeech ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "verb"@x-gmeow-english ;
    skos:definition "The verb part of speech — Universal Dependencies UPOS VERB."@x-gmeow-english .

# --- Composition-level individuals ------------------------------------------ #

lang:morphWordLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "morphological word"@x-gmeow-english ;
    skos:definition "The composition level of a morphologically complex word built from morphs."@x-gmeow-english .

lang:phraseLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "phrase"@x-gmeow-english ;
    skos:definition "The composition level of a phrase — a sub-clausal constituent."@x-gmeow-english .

lang:clauseLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "clause"@x-gmeow-english ;
    skos:definition "The composition level of a clause."@x-gmeow-english .

lang:sentenceLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "sentence"@x-gmeow-english ;
    skos:definition "The composition level of a sentence."@x-gmeow-english .

lang:paragraphLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "paragraph"@x-gmeow-english ;
    skos:definition "The composition level of a paragraph."@x-gmeow-english .

lang:sectionLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "section"@x-gmeow-english ;
    skos:definition "The composition level of a section of a document."@x-gmeow-english .

lang:textLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "text"@x-gmeow-english ;
    skos:definition "The composition level of a whole text or document."@x-gmeow-english .

# --- Analysis-level individuals (ordered by lang:levelRank) ------------------ #

lang:rawLevel
    a owl:NamedIndividual , lang:AnalysisLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "raw"@x-gmeow-english ;
    skos:definition "The raw analysis level: a surface held as unanalyzed prose, with no segmentation. The level of a lang:UnanalyzedProse surface."@x-gmeow-english ;
    lang:levelRank 0 .

lang:segmentedLevel
    a owl:NamedIndividual , lang:AnalysisLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "segmented"@x-gmeow-english ;
    skos:definition "The segmented analysis level: a surface split into segments (graphemes or phones) but not yet tokenized."@x-gmeow-english ;
    lang:levelRank 1 .

lang:tokenizedLevel
    a owl:NamedIndividual , lang:AnalysisLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "tokenized"@x-gmeow-english ;
    skos:definition "The tokenized analysis level: a surface split into orthographic and syntactic words but not yet morphologically analyzed."@x-gmeow-english ;
    lang:levelRank 2 .

lang:morphAnalyzedLevel
    a owl:NamedIndividual , lang:AnalysisLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "morph-analyzed"@x-gmeow-english ;
    skos:definition "The morph-analyzed level: word forms resolved to lexemes with typed morphological features, but not yet parsed into a composed form."@x-gmeow-english ;
    lang:levelRank 3 .

lang:parsedLevel
    a owl:NamedIndividual , lang:AnalysisLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "parsed"@x-gmeow-english ;
    skos:definition "The parsed level: a surface realizing a lang:ComposedForm with a full constituency and dependency analysis. The highest form-layer level; denotation is above it, in the meaning layer."@x-gmeow-english ;
    lang:levelRank 4 .

# --- Offset-space individuals ----------------------------------------------- #

lang:byteOffset
    a owl:NamedIndividual , lang:OffsetSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "byte offset"@x-gmeow-english ;
    skos:definition "Offsets measured in bytes of the declared encoding."@x-gmeow-english .

lang:codepointOffset
    a owl:NamedIndividual , lang:OffsetSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "codepoint offset"@x-gmeow-english ;
    skos:definition "Offsets measured in Unicode codepoints."@x-gmeow-english .

lang:graphemeClusterOffset
    a owl:NamedIndividual , lang:OffsetSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "grapheme cluster offset"@x-gmeow-english ;
    skos:definition "Offsets measured in extended grapheme clusters (UAX #29)."@x-gmeow-english .

# --- Feature inventory (Universal Dependencies universal features) ---------- #

lang:udUniversalFeatures
    a owl:NamedIndividual , lang:FeatureInventory ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "UD universal features"@x-gmeow-english ;
    skos:definition "The Universal Dependencies universal-features inventory — the starter feature keys and values GMEOW draws typed morphology from, aligned to the UD guidelines and extensible per language."@x-gmeow-english .

lang:featNumber
    a owl:NamedIndividual , lang:FeatureKey ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Number"@x-gmeow-english ;
    skos:definition "The Number feature key — grammatical number."@x-gmeow-english ;
    lang:inFeatureInventory lang:udUniversalFeatures .

lang:featCase
    a owl:NamedIndividual , lang:FeatureKey ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Case"@x-gmeow-english ;
    skos:definition "The Case feature key — grammatical case."@x-gmeow-english ;
    lang:inFeatureInventory lang:udUniversalFeatures .

lang:featTense
    a owl:NamedIndividual , lang:FeatureKey ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Tense"@x-gmeow-english ;
    skos:definition "The Tense feature key — grammatical tense."@x-gmeow-english ;
    lang:inFeatureInventory lang:udUniversalFeatures .

lang:featPerson
    a owl:NamedIndividual , lang:FeatureKey ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Person"@x-gmeow-english ;
    skos:definition "The Person feature key — grammatical person."@x-gmeow-english ;
    lang:inFeatureInventory lang:udUniversalFeatures .

lang:valPlur
    a owl:NamedIndividual , lang:FeatureValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Plur"@x-gmeow-english ;
    skos:definition "The plural value of the Number feature."@x-gmeow-english ;
    lang:inFeatureInventory lang:udUniversalFeatures .

lang:valSing
    a owl:NamedIndividual , lang:FeatureValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Sing"@x-gmeow-english ;
    skos:definition "The singular value of the Number feature."@x-gmeow-english ;
    lang:inFeatureInventory lang:udUniversalFeatures .

lang:valPast
    a owl:NamedIndividual , lang:FeatureValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Past"@x-gmeow-english ;
    skos:definition "The past value of the Tense feature."@x-gmeow-english ;
    lang:inFeatureInventory lang:udUniversalFeatures .

lang:valPres
    a owl:NamedIndividual , lang:FeatureValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Pres"@x-gmeow-english ;
    skos:definition "The present value of the Tense feature."@x-gmeow-english ;
    lang:inFeatureInventory lang:udUniversalFeatures .

lang:valNom
    a owl:NamedIndividual , lang:FeatureValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Nom"@x-gmeow-english ;
    skos:definition "The nominative value of the Case feature."@x-gmeow-english ;
    lang:inFeatureInventory lang:udUniversalFeatures .

lang:valAcc
    a owl:NamedIndividual , lang:FeatureValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Acc"@x-gmeow-english ;
    skos:definition "The accusative value of the Case feature."@x-gmeow-english ;
    lang:inFeatureInventory lang:udUniversalFeatures .

# =========================================================================== #
# Conformance-failure vocabulary (typed, queryable violation objects)
# =========================================================================== #

lang:LangConformanceFailure
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Lang Conformance Failure"@x-gmeow-english ;
    skos:definition "The parent of the lang: well-formedness failure vocabulary: a violation is itself a typed, queryable object rather than a log line. Each subclass names one hard rule of the form AST, and the SHACL shape enforcing that rule points at its failure class through lang:enforcesFailureClass. Conformance enforces well-formedness, never linguistic truth."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnsituatedForm
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unsituated Form"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:Form does not name exactly one lang:SignSystem through lang:inSignSystem. Every form names exactly one sign system; a form with none or with two is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:MisdeclaredAnalysis
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Misdeclared Analysis"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:SurfaceForm's structure does not match its declared lang:analysisLevel — a parsed surface that does not realize a lang:ComposedForm, a raw surface not typed lang:UnanalyzedProse, or a surface that both realizes an analyzed form and is typed unanalyzed prose. A surface is analyzed or explicitly unanalyzed, never silently either."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:DuplicateSlotIndex
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Duplicate Slot Index"@x-gmeow-english ;
    skos:definition "The failure raised when two lang:FormSlot individuals of one lang:ComposedForm share a lang:slotIndex. Slot indexes are unique per composed form so constituent order is unambiguous."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:NonContiguousSlots
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Non-Contiguous Slots"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:ComposedForm's slot indexes are not zero-based and contiguous — a missing index 0, an internal gap, or a maximum index not equal to the slot count minus one. Composed forms have a gap-free zero-based index sequence, enforced unconditionally (there is no lax mode); constituent order is identity-bearing, so a gap or non-zero start is always ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:DanglingDependency
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Dangling Dependency"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:dependsOn head reference, or a lang:spansWords edge, points outside the lang:Analysis it belongs to, or when lang:dependsOn forms a cycle. Dependency and token edges are scoped to their analysis and describe a well-founded structure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UntypedMorphology
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Untyped Morphology"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:MorphFeature does not draw its key and value from a lang:FeatureInventory — a missing or literal lang:featureKey or lang:featureValue rather than a lang:FeatureKey / lang:FeatureValue individual. Morphology is typed, never an unparsed feature string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnhashableSurface
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unhashable Surface"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:SurfaceForm does not declare the material identity a stable hash needs — its lang:surfaceText, lang:inScript, lang:unicodeNormalization, or lang:collationLocale. A surface with undeclared normalization is ill-formed for the candidateSourceHash discipline."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnanchoredOffset
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unanchored Offset"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:SurfaceAnchor does not declare its lang:anchorSource, lang:anchorStart, lang:anchorEnd, and lang:offsetSpace. An anchor without a source and a span in a declared offset space locates nothing."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:StringOnlyForm
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "String-Only Form"@x-gmeow-english ;
    skos:definition "The failure raised when a structural position that must hold a form — lang:slotForm, lang:realizes, lang:formHead — holds a bare literal instead of a lang:Form resource. A form that carries inferential weight is a structured object, not a string literal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UngroundedGrapheme
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Ungrounded Grapheme"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:Grapheme names a lang:Script through lang:inScript that does not list it in its repertoire through lang:hasGrapheme. A grapheme belongs to the repertoire of the script it declares."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# =========================================================================== #
# Properties
# =========================================================================== #

# --- Sign-system reference properties --------------------------------------- #

lang:signSystemKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "sign system kind"@x-gmeow-english ;
    skos:definition "Names the kind of a sign system. Domain lang:SignSystem, range lang:SignSystemKind (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:modality
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "modality"@x-gmeow-english ;
    skos:definition "Names the channel a sign system operates in. Domain lang:SignSystem, range lang:Modality (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:varietyOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "variety of"@x-gmeow-english ;
    skos:definition "Relates a language variety to the sign system it is a variety of. Domain lang:LanguageVariety, range lang:SignSystem (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:carrierTag
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "carrier tag"@x-gmeow-english ;
    skos:definition "The internal language tag under which a sign system's or variety's source prose literals are authored — the machine-readable identifier the pipeline resolves to a lang:Script through the variety's orthography. Domain lang:SignSystem or lang:LanguageVariety, range a string literal (stated in prose). Unlike an external BCP-47 alignment, this is the pipeline's own load-bearing carrier tag (e.g. x-gmeow-english), so it is carried as data on the language individual rather than named as an alignment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:usesScript
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "uses script"@x-gmeow-english ;
    skos:definition "Relates an orthography to the script it writes in. Domain lang:Orthography, range lang:Script (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:orthographyFor
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "orthography for"@x-gmeow-english ;
    skos:definition "Relates an orthography to the sign system it serves. Domain lang:Orthography, range lang:SignSystem (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:hasGrapheme
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "has grapheme"@x-gmeow-english ;
    skos:definition "Relates a script to a grapheme in its repertoire. Domain lang:Script, range lang:Grapheme (stated in prose). A grapheme must be in the repertoire of the script it declares through lang:inScript."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:grammarFor
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "grammar for"@x-gmeow-english ;
    skos:definition "Relates a grammar to the sign system it licenses. Domain lang:Grammar, range lang:SignSystem (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:grammarFormalism
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "grammar formalism"@x-gmeow-english ;
    skos:definition "Names the formalism a grammar is expressed in. Domain lang:Grammar, range lang:GrammarFormalism (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:grammarRuleOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "grammar rule of"@x-gmeow-english ;
    skos:definition "Relates a grammar rule to the grammar it belongs to. Domain lang:GrammarRule, range lang:Grammar (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:informalGloss
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "informal gloss"@x-gmeow-english ;
    skos:definition "An informal human-readable gloss of a sign-system reference object. Domain a reference-layer individual, range a string literal (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:inFeatureInventory
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "in feature inventory"@x-gmeow-english ;
    skos:definition "Relates a feature key or value to the inventory it belongs to. Domain lang:FeatureKey or lang:FeatureValue, range lang:FeatureInventory (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Form-situating and surface properties ---------------------------------- #

lang:inSignSystem
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "in sign system"@x-gmeow-english ;
    skos:definition "Situates a form in the sign system it belongs to. Domain lang:Form, range lang:SignSystem (stated in prose). Every lang:Form declares exactly one — an unsituated form is ill-formed. Code-switching is compositional: a composed form belongs to its matrix system while embedded constituents carry their own."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:realizes
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "realizes"@x-gmeow-english ;
    skos:definition "Relates a surface form to the analyzed form it realizes. Domain lang:SurfaceForm, range lang:Form (stated in prose). Re-encoding, re-normalizing, or re-transliterating a text creates new surface forms but no new forms — the realization fan-out widens while the form stands."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:surfaceText
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "surface text"@x-gmeow-english ;
    skos:definition "The concrete text a surface form carries. Domain lang:SurfaceForm, range a string literal (stated in prose). The only identity-bearing byte content in the AST, and only at the surface stratum. A document-scale surface holds its bytes by reference through lang:surfaceBlob instead, never inline here."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:surfaceBlob
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "surface blob"@x-gmeow-english ;
    skos:definition "A by-reference handle to the concrete bytes a document-scale surface form carries — the content-addressed blob digest (a \"blake3:<hex>\" reference literal) of those bytes, held in the bundle's content-addressed blob channel rather than inline. Domain lang:SurfaceForm, range a blob-reference string literal (stated in prose). A surface whose text byte-length exceeds the document-scale threshold carries lang:surfaceBlob in place of lang:surfaceText so the graph never inlines document-scale payload bytes; the digest is content-addressed, so the reference is deterministic and the bytes resolve through the blob store. A surface carries exactly one of lang:surfaceText or lang:surfaceBlob."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:inScript
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "in script"@x-gmeow-english ;
    skos:definition "Names the script a surface form is written in, or the script a grapheme belongs to. Domain lang:SurfaceForm or lang:Grapheme, range lang:Script (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:encoding
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "encoding"@x-gmeow-english ;
    skos:definition "The character encoding a surface form's bytes are in, such as UTF-8. Domain lang:SurfaceForm, range a string literal (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:unicodeNormalization
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "unicode normalization"@x-gmeow-english ;
    skos:definition "The Unicode normalization form a surface's text is in — NFC, NFD, NFKC, or NFKD (UAX #15). Domain lang:SurfaceForm, range a string literal (stated in prose). Two surfaces differing only in normalization are distinct surfaces of possibly the same form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:collationLocale
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "collation locale"@x-gmeow-english ;
    skos:definition "The locale whose collation and case-folding rules apply to a surface, such as a CLDR/ICU locale identifier. Domain lang:SurfaceForm, range a string literal (stated in prose). Canonicalization is sign-system-relative, so a well-defined hash names the locale it folds under."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:surfaceAnchor
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "surface anchor"@x-gmeow-english ;
    skos:definition "Relates a surface form to a stand-off anchor locating it in a source. Domain lang:SurfaceForm, range lang:SurfaceAnchor (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:anchorSource
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "anchor source"@x-gmeow-english ;
    skos:definition "Names the source document or blob an anchor points into. Domain lang:SurfaceAnchor, range a resource (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:anchorStart
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "anchor start"@x-gmeow-english ;
    skos:definition "The start offset of an anchor's span, measured in its declared offset space. Domain lang:SurfaceAnchor, range xsd:integer (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:anchorEnd
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "anchor end"@x-gmeow-english ;
    skos:definition "The end offset of an anchor's span, measured in its declared offset space. Domain lang:SurfaceAnchor, range xsd:integer (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:offsetSpace
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "offset space"@x-gmeow-english ;
    skos:definition "Names the unit an anchor's offsets are measured in. Domain lang:SurfaceAnchor, range lang:OffsetSpace (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:analysisLevel
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "analysis level"@x-gmeow-english ;
    skos:definition "Names how far a surface form has been analyzed. Domain lang:SurfaceForm, range lang:AnalysisLevel (stated in prose). Exactly one per surface, and the surface's structure must match the declared level."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:levelRank
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "level rank"@x-gmeow-english ;
    skos:definition "The integer rank ordering the analysis levels from raw (0) to parsed (4). Domain lang:AnalysisLevel, range xsd:integer (stated in prose). Data-driven ordering, so the level lattice is queryable without hard-coding names."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Morphology and word-structure properties ------------------------------- #

lang:morphemeOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "morpheme of"@x-gmeow-english ;
    skos:definition "Relates a morph to the abstract morpheme it realizes. Domain lang:Morph, range lang:Morpheme (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:allomorphOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "allomorph of"@x-gmeow-english ;
    skos:definition "Relates a morph to another morph it is a context-conditioned variant of — /z/ as an allomorph of the plural /s/. Domain and range lang:Morph (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:lexemeOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "lexeme of"@x-gmeow-english ;
    skos:definition "Relates a word form to the lexeme it realizes. Domain lang:WordForm, range lang:Lexeme (stated in prose). The general form-to-lexeme membership that lang:inflectionOf refines."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:inflectionOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf lang:lexemeOf ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "inflection of"@x-gmeow-english ;
    skos:definition "Relates a word form to the lexeme it is an inflection of — cats as an inflection of cat. Domain lang:WordForm, range lang:Lexeme (stated in prose). A refinement of lang:lexemeOf carrying the inflectional relation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:partOfSpeech
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "part of speech"@x-gmeow-english ;
    skos:definition "Names the part of speech of a lexeme. Domain lang:Lexeme, range lang:PartOfSpeech (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:spansWords
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "spans words"@x-gmeow-english ;
    skos:definition "Relates an orthographic word to a syntactic word it spans. Domain lang:OrthographicWord, range lang:SyntacticWord (stated in prose). One orthographic token can span several syntactic words."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:tokenOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "token of"@x-gmeow-english ;
    skos:definition "Relates a syntactic word to the orthographic word it belongs to — the reading counterpart of lang:spansWords, documented as its inverse in prose rather than asserted as an OWL characteristic to keep the term profile-clean. Domain lang:SyntacticWord, range lang:OrthographicWord (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:morphFeature
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "morph feature"@x-gmeow-english ;
    skos:definition "Relates a word form or morph to a typed morphological feature it carries. Domain lang:WordForm or lang:Morph, range lang:MorphFeature (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:featureKey
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "feature key"@x-gmeow-english ;
    skos:definition "Names the key of a morphological feature. Domain lang:MorphFeature, range lang:FeatureKey (stated in prose). An inventory individual, never a bare string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:featureValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "feature value"@x-gmeow-english ;
    skos:definition "Names the value (or, for disjunctive underspecification, values) of a morphological feature. Domain lang:MorphFeature, range lang:FeatureValue (stated in prose). An inventory individual, never a bare string; a value set is unordered."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:featureLayer
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "feature layer"@x-gmeow-english ;
    skos:definition "The layer of a layered morphological feature — the psor in the UD Number[psor] convention. Domain lang:MorphFeature, range a string literal (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Composition and dependency properties ---------------------------------- #

lang:compositionLevel
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "composition level"@x-gmeow-english ;
    skos:definition "Names the level at which a composed form composes. Domain lang:ComposedForm, range lang:CompositionLevel (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:formSlot
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "form slot"@x-gmeow-english ;
    skos:definition "Relates a composed form to one of its constituent slots. Domain lang:ComposedForm, range lang:FormSlot (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:slotIndex
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "slot index"@x-gmeow-english ;
    skos:definition "The integer position of a slot in its composed form's constituent order. Domain lang:FormSlot, range xsd:integer (stated in prose). Unique per composed form; zero-based and contiguous in strict canonical mode. Identity-bearing — word order distinguishes forms."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:slotForm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "slot form"@x-gmeow-english ;
    skos:definition "Relates a slot to the constituent form it holds. Domain lang:FormSlot, range lang:Form (stated in prose). A structured form, never a string literal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:slotRole
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "slot role"@x-gmeow-english ;
    skos:definition "Names the grammatical role a slot's constituent plays. Domain lang:FormSlot, range lang:FormRole (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:dependencyRelation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "dependency relation"@x-gmeow-english ;
    skos:definition "Names the Universal-Dependencies dependency relation a slot bears to its head. Domain lang:FormSlot, range lang:FormRole (stated in prose). Co-resident with constituency slots, so non-projective and discontinuous structure a nested tree cannot express is representable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:dependsOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "depends on"@x-gmeow-english ;
    skos:definition "Relates a slot to its head slot in a dependency analysis. Domain and range lang:FormSlot (stated in prose). Scoped to one lang:Analysis and acyclic; a head reference leaving its analysis or forming a cycle is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:inAnalysis
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "in analysis"@x-gmeow-english ;
    skos:definition "Relates a slot or constituent to the analysis it belongs to, so competing analyses of one surface stay separate. Domain lang:FormSlot or lang:Form, range lang:Analysis (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:formHead
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "form head"@x-gmeow-english ;
    skos:definition "Names the head constituent of a composed form where headedness is analyzed. Domain lang:ComposedForm, range lang:Form (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:licensedBy
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "licensed by"@x-gmeow-english ;
    skos:definition "Relates a form to a grammar rule that licenses it. Domain lang:Form, range lang:GrammarRule (stated in prose). Non-identity-bearing: a grammar licenses a form but never owns its identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Enforcement annotation property ---------------------------------------- #

lang:enforcesFailureClass
    a owl:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "enforces failure class"@x-gmeow-english ;
    skos:definition "Links a SHACL shape to the lang:LangConformanceFailure subclass it enforces, so the machine-checked gate and the typed failure vocabulary are cross-referenced: a query can move from a shape to the named failure it raises and back. An annotation property, carried on the shape, never a reasoned axiom."@x-gmeow-english .

# =========================================================================== #
# ===  MEANING STRATUM  ===================================================== #
# The semantic layer over the form AST: the Frege triangle (form / sense /
# reference as disjoint kinds), the reified denotation record, the one-way
# bridge into logic:, and interpretation as a vantage-held act. Form ≠ sense ≠
# reference is the layer's signature hard rule. Meaning bottoms out in logic:;
# the bridge runs lang: → logic: and never reverses (acyclic grounding order).
# =========================================================================== #

# --- Frege-triangle classes ------------------------------------------------- #

lang:Sense
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Sense"@x-gmeow-english ;
    skos:definition "A sense: a lexicalized or constructed way of meaning, attached to a lexeme or a composed form through lang:senseOf — the middle corner of the Frege triangle. The morning star and the evening star are two forms with two senses that reach one referent. A sense is what WordNet synsets, dictionary sense numbers, and OntoLex LexicalSenses approximate, and what translation tries to preserve. Disjoint from lang:Form and lang:Denotation: sense identity never implies co-reference and form identity never implies sense identity. Sense-to-sense relations (hypernymy, meronymy, antonymy) are reasoned in logic: over the logic:Type a sense denotes, or aligned to WordNet-RDF/lexinfo — never a second is-a graph forked inside lang:."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:LexicalConcept
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Lexical Concept"@x-gmeow-english ;
    skos:definition "A lexical concept: the shared concept a set of synonymous senses evoke — the synset. Senses point at one through lang:evokes, so synonymy is derived (two senses evoking one concept) rather than asserted as a primitive sense-to-sense edge. The OntoLex-Lemon ontolex:LexicalConcept peer; concept-to-concept structure is reasoned in logic: over the denoted logic:Type."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Denotation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Denotation"@x-gmeow-english ;
    skos:definition "A meaning assignment as a reified record — the Peircean triad made structural (sign, object, and the interpreting context that connects them), never a bare triple from form to target. Reification is what makes disagreement, revision, and ambiguity representable. Every denotation names its form (lang:denotedForm, a non-surface form), its kind (lang:denotationKind), its target (lang:denotationTarget), and its context (lang:denotationContext); lang:viaSense routes it through a sense where the head lexeme is ambiguous. Disjoint from lang:Form and lang:Sense — the reference corner of the Frege triangle is not a form and not a sense."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:DenotationKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Denotation Kind"@x-gmeow-english ;
    skos:definition "The kind of thing a denotation means: a closed, per-release vocabulary of named individuals — lang:denotesEntity, lang:denotesClass, lang:denotesLogicFormula, lang:denotesLogicTerm, lang:denotesLogicType, lang:denotesByDescription, and lang:denotesQuery. A denotation points at exactly one through lang:denotationKind, and the kind fixes the type its lang:denotationTarget must carry. Extended by design, never ad hoc."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Intension
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Intension"@x-gmeow-english ;
    skos:definition "The intensional structure a lang:denotesByDescription denotation holds when no extensional referent is identified — a way of picking out a thing (an open logic: condition, a description) carried as structure rather than resolved to an individual. The intensional target of a denotation whose reference is described, not named."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Interpretation, readings, and communicative acts ----------------------- #

lang:Reading
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Reading"@x-gmeow-english ;
    skos:definition "A candidate interpretation of a form — the structured result object of an interpretation act, carrying a lang:Denotation through lang:denotation and naming the form it reads through lang:readingOf. An ambiguous form holds multiple co-resident readings, each with its own denotation and its own vantage-held support; the readings are first-class data and are never structurally collapsed. A reading is a result, not a claim: the claim that a reading is correct is a separate gmeow:Observation held from a vantage."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:InterpretationAct
    a owl:Class ;
    rdfs:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Interpretation Act"@x-gmeow-english ;
    skos:definition "The act of assigning meaning to a form — a gmeow:Activity with an agent or method (a person, an NLP engine, a compositional rule run), inputs (the form through lang:interpretedForm, the context, an anchor through lang:anchorsIndexical where deixis needs resolving), and provenance. Its results are lang:Reading objects through lang:producedReading. This is the process of the observation spine's process/result/claim separation, and it is NEVER typed as a gmeow:Observation: the act is disjoint from the claim about its readings."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:IndexicalAnchor
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Indexical Anchor"@x-gmeow-english ;
    skos:definition "An anchor resolving deixis for an interpretation act: speaker, time, place, or discourse state relative to which an indexical form (I, here, yesterday, this term) denotes. A declared object on the act through lang:anchorsIndexical, kind-typed through lang:anchorKind, so the same form lawfully denotes differently under different anchors. An indexical denotation without an anchor is ill-formed — deixis is anchored, never resolved away."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:IndexicalAnchorKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Indexical Anchor Kind"@x-gmeow-english ;
    skos:definition "The kind of deixis an indexical anchor resolves — person, time, place, discourse, or social. Its instances are the named individuals lang:personDeixis, lang:timeDeixis, lang:placeDeixis, lang:discourseDeixis, and lang:socialDeixis. An anchor points at one through lang:anchorKind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:DiscourseReferent
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Discourse Referent"@x-gmeow-english ;
    skos:definition "A discourse referent: the entity a referring expression introduces into a discourse and later expressions may co-refer with (the anaphora primitive). A form introduces one through lang:introducesReferent; two referring expressions naming the same referent are linked through lang:corefersWith. The referent's nature is the domain slices' and logic:'s business — lang: holds only the discourse-level identity that later reference reuses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:CommunicativeAct
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Communicative Act"@x-gmeow-english ;
    skos:definition "What a use of a form does — assert, ask, order, define, promise — recorded through lang:communicativeForce. Force is not content: the door is closed and is the door closed? share propositional content and differ in force, and only an assertion lowers to an asserted logic: formula. GMEOW's own competency questions are communicative acts with interrogative force whose content denotes a query."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:CommunicativeForce
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Communicative Force"@x-gmeow-english ;
    skos:definition "The illocutionary force of a communicative act — a theory-neutral flat vocabulary of named individuals lang:assertForce, lang:askForce, lang:orderForce, lang:promiseForce, and lang:defineForce. A communicative act points at one through lang:communicativeForce. Speech-act meta-classifications (Searle's assertive/directive/commissive/expressive/declarative, ISO 24617 DiAML dialogue-act classes) are theory-scoped and carried as alignment, not minted here as a second class layer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Sense-relation and composition classes --------------------------------- #

lang:SenseRelation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Sense Relation"@x-gmeow-english ;
    skos:definition "A reified relation between two senses, so the relation can be sourced and vantage-held rather than asserted flat: it names the two senses through lang:relatesSense and its kind through lang:senseRelationKind. Only the taxonomic kinds (hypernymy, hyponymy) are minted here, and even they resolve through the logic: subsumption over the denoted logic:Type; the wider WordNet relation inventory (antonymy, meronymy, holonymy, troponymy) is carried as alignment to WordNet-RDF/lexinfo, never as canonical lang: structure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SenseRelationKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Sense Relation Kind"@x-gmeow-english ;
    skos:definition "The kind of a sense relation. Its instances are the named individuals lang:hypernymy and lang:hyponymy — the taxonomic relations that recover as logic: subsumption over the senses' denoted logic:Types. A sense relation points at one through lang:senseRelationKind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:CompositionRule
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Composition Rule"@x-gmeow-english ;
    skos:definition "A named rule of the compositional program (the Montagovian fragment GMEOW needs): it says how a composed form's denotation is built from its constituents' denotations. A composed denotation names the rule that built it through lang:composedBy and its constituent denotations through lang:composedFrom, so the lowering is inspectable and each compositional step carries a logic:preservationKind judgment. Where composition does not reach, the form's surface stays honest lang:UnanalyzedProse — the unliftable remainder is marked, never approximated."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Disjointness axioms (the Frege signature rule; act ≠ observation) ------- #
# DisjointClasses is OWL 2 EL-clean, so these stay within the term profile.

[] a owl:AllDisjointClasses ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    owl:members ( lang:Form lang:Sense lang:Denotation ) .

lang:InterpretationAct owl:disjointWith gmeow:Observation .

# --- Denotation-kind individuals (closed per release) ----------------------- #

lang:denotesEntity
    a owl:NamedIndividual , lang:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotes entity"@x-gmeow-english ;
    skos:definition "The denotation kind whose target is a GMEOW individual — a referring expression denoting a named entity."@x-gmeow-english .

lang:denotesClass
    a owl:NamedIndividual , lang:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotes class"@x-gmeow-english ;
    skos:definition "The denotation kind whose target is an owl:Class — a common noun denoting a class."@x-gmeow-english .

lang:denotesLogicFormula
    a owl:NamedIndividual , lang:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotes logic formula"@x-gmeow-english ;
    skos:definition "The logic:-bridge denotation kind whose target is a logic:Formula — a declarative sentence denoting a full-FOL formula. Nothing about natural language forces a decidable fragment; whether the formula entails another is logic:'s question, not lang:'s."@x-gmeow-english .

lang:denotesLogicTerm
    a owl:NamedIndividual , lang:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotes logic term"@x-gmeow-english ;
    skos:definition "The logic:-bridge denotation kind whose target is a logic:Individual — a referring expression bottoming out at a logic individual (logic: reifies terms as term-carrier positions and individuals, so there is no separate term node to point at)."@x-gmeow-english .

lang:denotesLogicType
    a owl:NamedIndividual , lang:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotes logic type"@x-gmeow-english ;
    skos:definition "The logic:-bridge denotation kind whose target is a logic:Type — a common noun or predicate denoting a type (logic: reifies relations as logic:Type individuals, the HiLog reflection, so a predicate denotation is a type denotation)."@x-gmeow-english .

lang:denotesByDescription
    a owl:NamedIndividual , lang:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotes by description"@x-gmeow-english ;
    skos:definition "The denotation kind whose target is a lang:Intension held as structure when no referent is identified — an intensional target, a way of picking out a thing rather than the thing."@x-gmeow-english .

lang:denotesQuery
    a owl:NamedIndividual , lang:DenotationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotes query"@x-gmeow-english ;
    skos:definition "The logic:-bridge denotation kind whose target is a query — an interrogative communicative act whose content denotes a query rather than an asserted formula. This is what makes GMEOW reading its own competency questions more than label-matching: the question's prose denotes the query it asks."@x-gmeow-english .

# --- Sense-relation-kind individuals ---------------------------------------- #

lang:hypernymy
    a owl:NamedIndividual , lang:SenseRelationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "hypernymy"@x-gmeow-english ;
    skos:definition "The is-a-kind-of taxonomic relation from a narrower sense to a broader one — dog to animal. Recovered as logic: subsumption over the senses' denoted logic:Types, never a forked lang: is-a graph."@x-gmeow-english .

lang:hyponymy
    a owl:NamedIndividual , lang:SenseRelationKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "hyponymy"@x-gmeow-english ;
    skos:definition "The taxonomic relation from a broader sense to a narrower one — animal to dog, the reading counterpart of lang:hypernymy. Recovered as logic: subsumption over the denoted logic:Types."@x-gmeow-english .

# --- Indexical-anchor-kind individuals -------------------------------------- #

lang:personDeixis
    a owl:NamedIndividual , lang:IndexicalAnchorKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "person deixis"@x-gmeow-english ;
    skos:definition "Person deixis — the speaker/addressee anchor for indexicals like I, you, we."@x-gmeow-english .

lang:timeDeixis
    a owl:NamedIndividual , lang:IndexicalAnchorKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "time deixis"@x-gmeow-english ;
    skos:definition "Time deixis — the utterance-time anchor for indexicals like now, yesterday, this term."@x-gmeow-english .

lang:placeDeixis
    a owl:NamedIndividual , lang:IndexicalAnchorKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "place deixis"@x-gmeow-english ;
    skos:definition "Place deixis — the utterance-location anchor for indexicals like here, there, this place."@x-gmeow-english .

lang:discourseDeixis
    a owl:NamedIndividual , lang:IndexicalAnchorKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "discourse deixis"@x-gmeow-english ;
    skos:definition "Discourse deixis — the discourse-state anchor for expressions pointing at prior or following stretches of discourse (the former, as mentioned above)."@x-gmeow-english .

lang:socialDeixis
    a owl:NamedIndividual , lang:IndexicalAnchorKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "social deixis"@x-gmeow-english ;
    skos:definition "Social deixis — the social-relationship anchor for honorifics and register-marking forms (the T/V distinction, formal address)."@x-gmeow-english .

# --- Communicative-force individuals ---------------------------------------- #

lang:assertForce
    a owl:NamedIndividual , lang:CommunicativeForce ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "assert"@x-gmeow-english ;
    skos:definition "Assertive force — a use of a form that asserts its propositional content. The only force that lowers to an asserted logic: formula."@x-gmeow-english .

lang:askForce
    a owl:NamedIndividual , lang:CommunicativeForce ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "ask"@x-gmeow-english ;
    skos:definition "Interrogative force — a use of a form that asks. Its content denotes a query (lang:denotesQuery), not an asserted formula."@x-gmeow-english .

lang:orderForce
    a owl:NamedIndividual , lang:CommunicativeForce ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "order"@x-gmeow-english ;
    skos:definition "Directive force — a use of a form that orders or requests an action. Does not lower to an asserted formula."@x-gmeow-english .

lang:promiseForce
    a owl:NamedIndividual , lang:CommunicativeForce ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "promise"@x-gmeow-english ;
    skos:definition "Commissive force — a use of a form that commits the speaker to a future course of action."@x-gmeow-english .

lang:defineForce
    a owl:NamedIndividual , lang:CommunicativeForce ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "define"@x-gmeow-english ;
    skos:definition "Declarative/definitional force — a performative use of a form that fixes a definition or, more broadly, brings about the state it names by being uttered."@x-gmeow-english .

# --- Meaning-layer conformance-failure classes ------------------------------ #

lang:FregeConflation
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Frege Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when form, sense, and denotation-record kinds are conflated — a node typed as two corners of the Frege triangle. String identity never implies form identity; form identity never implies sense identity; sense identity never implies co-reference. Every conflation fabricates information and is a typed conformance failure. Primary gate: the OWL disjointness of lang:Form, lang:Sense, lang:Denotation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnderspecifiedDenotation
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Underspecified Denotation"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:Denotation does not name its form (lang:denotedForm), kind (lang:denotationKind), target (lang:denotationTarget), and context (lang:denotationContext). A meaning assignment is a fully specified reified record, never a bare edge; a context-free denotation is ill-formed, not conveniently universal. The denotesByDescription case holds a lang:Intension in place of an extensional target."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SurfaceLevelDenotation
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Surface-Level Denotation"@x-gmeow-english ;
    skos:definition "The failure raised when a denotation attaches to a lang:SurfaceForm through lang:denotedForm. Meaning attaches above the byte level; a denotation hung on a surface form is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnroutedAmbiguousDenotation
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unrouted Ambiguous Denotation"@x-gmeow-english ;
    skos:definition "The failure raised when a denotation's head lexeme has more than one recorded lang:Sense but the denotation omits lang:viaSense. Routing through the triangle is exactly what prevents the record from silently resolving an ambiguity it never examined."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:DenotationKindMismatch
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Denotation Kind Mismatch"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:denotationKind does not match its target's type — a denotesLogicFormula denotation whose target is not a logic:Formula, a denotesLogicType whose target is not a logic:Type, a denotesLogicTerm whose target is not a logic:Individual, a denotesClass whose target is not an owl:Class, a denotesByDescription whose target is not a lang:Intension. The kind fixes the target's type."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:ActObservationConflation
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Act–Observation Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:InterpretationAct is typed as a gmeow:Observation. The act is the process and is never the claim: the process/result/claim separation forbids collapsing the interpretation act into the observation that a reading is correct. Primary gate: the OWL disjointness of lang:InterpretationAct and gmeow:Observation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UngroundedReadingClaim
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Ungrounded Reading Claim"@x-gmeow-english ;
    skos:definition "The failure raised when a gmeow:Observation about a lang:Reading (through lang:aboutReading) carries no gmeow:vantage. The claim that a reading is correct is a vantage-held observation, never a groundless assertion; a second annotator may hold the other reading."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SilentDisambiguation
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Silent Disambiguation"@x-gmeow-english ;
    skos:definition "The failure raised when co-resident lang:Reading objects are structurally collapsed — a form or interpretation act with more than one produced reading carrying a single resolved reading that erases the others without a vantage-held gmeow:Observation selecting among them. Silent disambiguation is the meaning-layer form of fabricating certainty: the data's ambiguity is its shape, and imposing a single reading the source does not license is fabrication."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnanchoredIndexical
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unanchored Indexical"@x-gmeow-english ;
    skos:definition "The failure raised when an indexical denotation's interpretation act names no lang:IndexicalAnchor. Indexical forms denote only relative to an anchor; an indexical denotation without one is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:ConfidenceAsProbability
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Confidence As Probability"@x-gmeow-english ;
    skos:definition "The failure raised when a reading-preference claim treats a preference weight as a logic:probability without a declared logic:ProbabilityModel. Reading-preference weights are logic:confidence unless an actual probability model is present — the discipline inherited verbatim from the logic: and math: siblings."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UndeclaredLoweringStage
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Undeclared Lowering Stage"@x-gmeow-english ;
    skos:definition "The failure raised when a compositional lowering into logic: (a denotation whose kind bridges into logic: — denotesLogicFormula, denotesLogicTerm, denotesLogicType, denotesQuery) does not declare a logic:preservationKind. Every lowering carries a preservation judgment like every other lowering in the project; being a lowering is derived from the denotation kind, never an optional flag."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Meaning-layer properties ----------------------------------------------- #

lang:senseOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "sense of"@x-gmeow-english ;
    skos:definition "Relates a sense to the lexeme or composed form it is a way of meaning. Domain lang:Sense, range lang:Lexeme or lang:Form (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:evokes
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "evokes"@x-gmeow-english ;
    skos:definition "Relates a sense to the lexical concept it evokes. Domain lang:Sense, range lang:LexicalConcept (stated in prose). Two senses evoking one concept are synonymous — synonymy derived, not asserted flat. The OntoLex ontolex:evokes peer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:relatesSense
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "relates sense"@x-gmeow-english ;
    skos:definition "Relates a reified sense relation to a sense it holds between. Domain lang:SenseRelation, range lang:Sense (stated in prose). A sense relation names two."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:senseRelationKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "sense relation kind"@x-gmeow-english ;
    skos:definition "Names the kind of a sense relation. Domain lang:SenseRelation, range lang:SenseRelationKind (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:denotedForm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denoted form"@x-gmeow-english ;
    skos:definition "Relates a denotation to the form it assigns meaning to. Domain lang:Denotation, range lang:Form (stated in prose). Never a lang:SurfaceForm — meaning attaches above the byte level."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:denotationKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation kind"@x-gmeow-english ;
    skos:definition "Names what kind of thing a denotation means. Domain lang:Denotation, range lang:DenotationKind (stated in prose). The kind fixes the type of lang:denotationTarget."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:denotationTarget
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation target"@x-gmeow-english ;
    skos:definition "Relates a denotation to the referent or lowered object it means, typed consistently with lang:denotationKind — a logic:Formula, logic:Type, logic:Individual, a GMEOW entity, an owl:Class, a query, or a lang:Intension. Domain lang:Denotation, range a resource (stated in prose). The one-way bridge into logic: runs through this property and never reverses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:denotationContext
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation context"@x-gmeow-english ;
    skos:definition "Names the context under which a denotation holds — sign-system stage, theory, register, discourse. Domain lang:Denotation, range a resource (stated in prose). The same form denotes differently in different contexts; a context-free denotation is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:viaSense
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "via sense"@x-gmeow-english ;
    skos:definition "Routes a denotation through the sense under which it means. Domain lang:Denotation, range lang:Sense (stated in prose). Required where the denoted form's head lexeme has more than one recorded sense."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:composedBy
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "composed by"@x-gmeow-english ;
    skos:definition "Relates a composed denotation to the composition rule that built it. Domain lang:Denotation, range lang:CompositionRule (stated in prose). Makes the Montagovian lowering inspectable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:composedFrom
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "composed from"@x-gmeow-english ;
    skos:definition "Relates a composed denotation to a constituent denotation it was built from. Domain and range lang:Denotation (stated in prose). A composed form's denotation is constructed from its constituents' denotations by the declared composition rule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:presupposes
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "presupposes"@x-gmeow-english ;
    skos:definition "Relates a form or denotation to a logic: formula it presupposes — content taken for granted rather than asserted, distinct from the asserted content. Domain lang:Form or lang:Denotation, range logic:Formula (stated in prose). Presupposition and assertion are separate lowerings."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:readingOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "reading of"@x-gmeow-english ;
    skos:definition "Relates a reading to the form it interprets. Domain lang:Reading, range lang:Form (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:denotation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation"@x-gmeow-english ;
    skos:definition "Relates a reading to the denotation record it carries. Domain lang:Reading, range lang:Denotation (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:interpretedForm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "interpreted form"@x-gmeow-english ;
    skos:definition "Relates an interpretation act to the form it interprets. Domain lang:InterpretationAct, range lang:Form (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:producedReading
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "produced reading"@x-gmeow-english ;
    skos:definition "Relates an interpretation act to a reading it produced. Domain lang:InterpretationAct, range lang:Reading (stated in prose). An ambiguous form's act produces multiple co-resident readings, none collapsed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:interpretationEngine
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "interpretation engine"@x-gmeow-english ;
    skos:definition "Relates a lang:InterpretationAct to the external NLP engine (a parser, tagger, lemmatizer, or MT system) that produced its readings, carrying the engine and version as provenance. Domain lang:InterpretationAct, range an engine agent (stated in prose). Its presence marks the act as an engine run — an oracle that produces claims, never an authority that produces facts — so every lang:producedReading of such an act MUST be a vantage-held reading (carrying gmeow:vantage); an engine act whose reading carries no vantage has entered engine output as unattributed structure (lang:UnattributedEngineClaim)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:resolvedReading
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "resolved reading"@x-gmeow-english ;
    skos:definition "Relates an interpretation act to the single reading it selects as canonical. Domain lang:InterpretationAct, range lang:Reading (stated in prose). Selecting a winner among co-resident readings is lawful ONLY when a vantage-held gmeow:Observation (through lang:aboutReading, with gmeow:vantage) grounds the choice; an act that resolves to one reading with no such observation has silently disambiguated — the meaning-layer form of fabricating certainty — and is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:anchorsIndexical
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "anchors indexical"@x-gmeow-english ;
    skos:definition "Relates an interpretation act to the indexical anchor it resolves deixis against. Domain lang:InterpretationAct, range lang:IndexicalAnchor (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:anchorKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "anchor kind"@x-gmeow-english ;
    skos:definition "Names the kind of deixis an indexical anchor resolves. Domain lang:IndexicalAnchor, range lang:IndexicalAnchorKind (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:isIndexical
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "is indexical"@x-gmeow-english ;
    skos:definition "Whether a denotation is indexical — its referent varies with a lang:IndexicalAnchor. Domain lang:Denotation, range xsd:boolean (stated in prose). An indexical denotation (this is true) denotes only relative to an anchor on its interpretation act; an indexical denotation whose act names no anchor is ill-formed. Declared, like the analysis level, rather than inferred."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:introducesReferent
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "introduces referent"@x-gmeow-english ;
    skos:definition "Relates a form to the discourse referent it introduces. Domain lang:Form, range lang:DiscourseReferent (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:corefersWith
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "corefers with"@x-gmeow-english ;
    skos:definition "Relates two referring expressions naming the same discourse referent — the anaphora link. Domain and range lang:Form (stated in prose). Symmetric in reading, documented in prose rather than asserted as an OWL characteristic to keep the term profile-clean."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:communicativeForce
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "communicative force"@x-gmeow-english ;
    skos:definition "Names the illocutionary force of a communicative act. Domain lang:CommunicativeAct, range lang:CommunicativeForce (stated in prose). Force is not content."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:isPerformative
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "is performative"@x-gmeow-english ;
    skos:definition "Whether a communicative act is performative (brings about the state it names by being uttered) rather than constative. Domain lang:CommunicativeAct, range xsd:boolean (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:performedOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "performed on"@x-gmeow-english ;
    skos:definition "Relates a communicative act to the lang:Form whose use it is — the form the act is performed on. A communicative act is the use of a form, so it names that form here. Domain lang:CommunicativeAct, range lang:Form (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:aboutReading
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:observedFeature ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "about reading"@x-gmeow-english ;
    skos:definition "Relates a gmeow:Observation to the lang:Reading it is a claim about — the reading-correctness claim's subject. A sub-property of gmeow:observedFeature, so a reading claim is an ordinary vantage-held observation about a feature. Domain gmeow:Observation, range lang:Reading (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# Translation, rendering, transliteration, and paraphrase
#
# The sign-system-facet layer of the crossing calculus. A crossing from one form
# to another — rendering content to a surface, transliterating across scripts,
# translating across sign systems, or paraphrasing within one — is NOT a new
# law-spine: every preservation judgment, morphism class, correspondence
# relation, mnemomorphic witness, determinacy, and law claim is carried by a
# linked logic:Correspondence node using the real logic: property names
# (logic:preservationKind, logic:morphismClass, logic:correspondenceRelation,
# logic:mnemomorphic, logic:hasDeterminacy, logic:hasLawClaim / logic:lawClaimed
# / logic:lawDischargeVerdict, logic:SectionLaw / logic:GetPut / logic:PutGet).
# lang: mints ONLY the sign-system-specific facets — what content, what form,
# what orthographies, what method, what document roll-up — and the single
# attachment point (lang:translationCorrespondence) that hangs a unit off its
# logic:Correspondence. No lang: shadow of the law-spine is created here.
# =========================================================================== #

lang:Rendering
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Rendering"@x-gmeow-english ;
    skos:definition "A reified record of realizing content as a form: a content object (a lang:Form, a lang:Denotation, a composed form, a document node) rendered into a concrete lang:Form or lang:SurfaceForm under a declared kind and convention. Names the content it renders through lang:renderedContent, the form it produces through lang:renderingForm, its kind through lang:renderingKind (a lang:RenderingKind individual), the convention governing it through lang:renderingConvention, and — where the crossing is judged — a preservation kind through lang:renderingPreservation, which carries a logic:preservationKind rather than a lang: preservation enum. Rendering is the facet layer over a logic:Correspondence whose two sides are content and form; serializing the ontology to Turtle, lifting prose to a docs page, and transliterating a name are all renderings distinguished by kind, never a subclass ladder."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:RenderingKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Rendering Kind"@x-gmeow-english ;
    skos:definition "The kind of a rendering — serialization, prose, transliteration, notation, or docs page. Its instances are the named individuals lang:renderingSerialization, lang:renderingProse, lang:renderingTransliteration, lang:renderingNotation, and lang:renderingDocsPage. A lang:Rendering points at one through lang:renderingKind; the kind-individual pattern keeps the TBox small rather than minting a class per rendering mode, and it is a facet only — the preservation and morphism class of the crossing live on the linked logic:Correspondence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:TransliterationMap
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Transliteration Map"@x-gmeow-english ;
    skos:definition "A form-to-form map across orthographies of one sign system — Hepburn Japanese to Latin, Cyrillic Serbian to Latin Serbian. Names its source and target orthographies through lang:transliterationSourceOrthography and lang:transliterationTargetOrthography and the naming scheme it grafts through lang:transliterationScheme, which references a gmeow:TransliterationScheme individual (the FnO-backed romanization scheme in the core language slice). Transliteration is a rendering-layer map that changes the script surface, not form identity: two orthographic surfaces linked by a transliteration map may realize one and the same form. Its preservation is judged on the carried logic:Correspondence, never restated as a lang: kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Translation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Translation"@x-gmeow-english ;
    skos:definition "A document-level translation: a crossing of content from a source sign system to a target sign system, aggregating the reified lang:TranslationUnit pairings that make it up. Names its constituent units through lang:rollsUpFrom and the method that produced it through lang:translationMethod (a lang:TranslationMethod individual). A translation is a whole assembled from units; its adequacy is the join of its units' preservation judgments, each carried by that unit's logic:Correspondence, never a document-level preservation flag minted in lang:. The document roll-up is derived from the units, never asserted independently of them."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:TranslationUnit
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Translation Unit"@x-gmeow-english ;
    skos:definition "A reified source-form-to-target-form pairing — the atom of a translation. Names its source form through lang:translationSource, its target form through lang:translationTarget, and the sibling unit it aligns with through lang:translationOf, and it carries the law-spine of the crossing by pointing — through lang:translationCorrespondence — at exactly one logic:Correspondence node. That Correspondence, not the unit, holds the logic:preservationKind, the logic:morphismClass, the logic:correspondenceRelation, the logic:mnemomorphic witness enumerating any untranslatable residue, the logic:hasDeterminacy, and any logic:hasLawClaim. A unit whose target is inadequate is marked through lang:translationGap; the enumerated residue itself lives on the carried Correspondence's mnemomorphic witness, never on the unit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:TranslationMethod
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Translation Method"@x-gmeow-english ;
    skos:definition "How a translation was produced — human, machine, or compositional. Its instances are the named individuals lang:methodHuman, lang:methodMachine, and lang:methodCompositional. A lang:Translation or lang:TranslationUnit points at one through lang:translationMethod; the method is provenance for the crossing, not a substitute for the preservation judgment carried by the logic:Correspondence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Paraphrase
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Paraphrase"@x-gmeow-english ;
    skos:definition "A form-to-form crossing within one sign system under a declared sameness kind — a restatement, a plain-language rewrite, a definitional gloss. Names the form it paraphrases through lang:paraphraseOf, the sameness it claims to preserve through lang:paraphraseSamenessKind (a lang:ParaphraseSamenessKind individual — same denotation, same sense, or same force and content), and, where the crossing is judged, a preservation kind through lang:paraphrasePreservation, which carries a logic:preservationKind. Sameness is never a bare assertion: a paraphrase claim is vantage-held, so that a paraphrase-correctness claim is a gmeow:Observation from a gmeow:vantage rather than a groundless equivalence. Unlike translation, both forms belong to one sign system; unlike rendering, both sides are forms rather than content and form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:ParaphraseSamenessKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Paraphrase Sameness Kind"@x-gmeow-english ;
    skos:definition "The kind of sameness a paraphrase claims to preserve. Its instances are the named individuals lang:sameDenotation, lang:sameSense, and lang:sameForceAndContent. A paraphrase points at one through lang:paraphraseSamenessKind; the kind fixes which corner of the Frege triangle the paraphrase holds fixed, and it is a facet only — how well the crossing preserves that sameness is the logic:preservationKind on the paraphrase's logic:Correspondence, not a second lang: judgment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Rendering-kind individuals --------------------------------------------- #

lang:renderingSerialization
    a owl:NamedIndividual , lang:RenderingKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "serialization"@x-gmeow-english ;
    skos:definition "The rendering kind that serializes structured content to a formal-language surface — the ontology rendered to Turtle or GTS."@x-gmeow-english .

lang:renderingProse
    a owl:NamedIndividual , lang:RenderingKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "prose"@x-gmeow-english ;
    skos:definition "The rendering kind that realizes content as natural-language prose — a denotation or a term description rendered to an @x-gmeow-english surface."@x-gmeow-english .

lang:renderingTransliteration
    a owl:NamedIndividual , lang:RenderingKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "transliteration"@x-gmeow-english ;
    skos:definition "The rendering kind that realizes a form in a different orthography of its own sign system, governed by a lang:TransliterationMap — a romanization of a name."@x-gmeow-english .

lang:renderingNotation
    a owl:NamedIndividual , lang:RenderingKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "notation"@x-gmeow-english ;
    skos:definition "The rendering kind that realizes content in a notation — a phonological form written in IPA, a formula written in mathematical notation."@x-gmeow-english .

lang:renderingDocsPage
    a owl:NamedIndividual , lang:RenderingKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "docs page"@x-gmeow-english ;
    skos:definition "The rendering kind that lifts ontology content into a documentation page — a term or slice rendered to a human-facing docs surface."@x-gmeow-english .

# --- Translation-method individuals ----------------------------------------- #

lang:methodHuman
    a owl:NamedIndividual , lang:TranslationMethod ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "human"@x-gmeow-english ;
    skos:definition "The translation method of a human translator."@x-gmeow-english .

lang:methodMachine
    a owl:NamedIndividual , lang:TranslationMethod ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "machine"@x-gmeow-english ;
    skos:definition "The translation method of a machine-translation engine."@x-gmeow-english .

lang:methodCompositional
    a owl:NamedIndividual , lang:TranslationMethod ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "compositional"@x-gmeow-english ;
    skos:definition "The translation method that builds a target form from an abstract-form tree by composition — the Grammatical Framework mode, where a strong-by-construction preservation rung can be derived from the composition rather than asserted flat. The compositional path is optional and never a mandate; when present it is declared through lang:composedThroughAbstract."@x-gmeow-english .

# --- Paraphrase-sameness-kind individuals ----------------------------------- #

lang:sameDenotation
    a owl:NamedIndividual , lang:ParaphraseSamenessKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "same denotation"@x-gmeow-english ;
    skos:definition "The paraphrase sameness kind that holds the referent fixed while sense and form may vary — two forms picking out the same thing (the morning star / the evening star as descriptions of one referent)."@x-gmeow-english .

lang:sameSense
    a owl:NamedIndividual , lang:ParaphraseSamenessKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "same sense"@x-gmeow-english ;
    skos:definition "The paraphrase sameness kind that holds the sense fixed while the form varies — a synonymous restatement that means the same way, not merely reaching the same referent."@x-gmeow-english .

lang:sameForceAndContent
    a owl:NamedIndividual , lang:ParaphraseSamenessKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "same force and content"@x-gmeow-english ;
    skos:definition "The paraphrase sameness kind that holds both the propositional content and the communicative force fixed — a restatement that asserts, asks, or orders the same thing in the same way, the strongest sameness a paraphrase can claim."@x-gmeow-english .

# --- Rendering properties (sign-system facets) ------------------------------ #

lang:renderedContent
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "rendered content"@x-gmeow-english ;
    skos:definition "Relates a lang:Rendering to the content it realizes — a lang:Form, a lang:Denotation, a composed form, or a document node. Domain lang:Rendering, range a content resource (stated in prose). The content side of the rendering's crossing; the form side is lang:renderingForm."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:renderingForm
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "rendering form"@x-gmeow-english ;
    skos:definition "Relates a lang:Rendering to the concrete form it produces — a lang:Form or lang:SurfaceForm. Domain lang:Rendering, range lang:Form (stated in prose). The form side of the rendering's crossing; the content side is lang:renderedContent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:renderingKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "rendering kind"@x-gmeow-english ;
    skos:definition "Names the kind of a rendering. Domain lang:Rendering, range lang:RenderingKind (stated in prose). A facet only; the preservation and morphism class of the crossing live on the linked logic:Correspondence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:renderingConvention
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "rendering convention"@x-gmeow-english ;
    skos:definition "Names the convention governing a rendering — a lang:Grammar, a lang:Orthography, or a gmeow:TransliterationScheme that fixes how content becomes form. Domain lang:Rendering, range a convention resource (stated in prose). The convention licenses the surface; it does not own the rendered form's identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:renderingPreservation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "rendering preservation"@x-gmeow-english ;
    skos:definition "Relates a lang:Rendering to the preservation judgment of its crossing, carried as a logic:preservationKind on the rendering's logic:Correspondence. Domain lang:Rendering, range logic:PreservationKind (stated in prose). Preservation is never a lang: enum: this property is the facet handle onto the shared logic: judgment, not a second grade."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Transliteration properties --------------------------------------------- #

lang:transliterationSourceOrthography
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "transliteration source orthography"@x-gmeow-english ;
    skos:definition "Relates a lang:TransliterationMap to the orthography its input surfaces are written in. Domain lang:TransliterationMap, range lang:Orthography (stated in prose). The source side of the orthography-to-orthography map; the target is lang:transliterationTargetOrthography."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:transliterationTargetOrthography
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "transliteration target orthography"@x-gmeow-english ;
    skos:definition "Relates a lang:TransliterationMap to the orthography its output surfaces are written in. Domain lang:TransliterationMap, range lang:Orthography (stated in prose). The target side of the orthography-to-orthography map; the source is lang:transliterationSourceOrthography."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:transliterationScheme
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "transliteration scheme"@x-gmeow-english ;
    skos:definition "Relates a lang:TransliterationMap to the named romanization or transliteration scheme it grafts — a gmeow:TransliterationScheme individual in the core language slice, whose FnO transform the projection layer resolves. Domain lang:TransliterationMap, range gmeow:TransliterationScheme (stated in prose). The scheme names the convention; the map's preservation is judged on its logic:Correspondence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Translation properties ------------------------------------------------- #

lang:translationSource
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "translation source"@x-gmeow-english ;
    skos:definition "Relates a lang:TranslationUnit to its source form. Domain lang:TranslationUnit, range lang:Form or lang:SurfaceForm (stated in prose). A translation source is a structured form, never a bare string; an unmarked surface source is ill-formed. The target side is lang:translationTarget."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:translationTarget
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "translation target"@x-gmeow-english ;
    skos:definition "Relates a lang:TranslationUnit to its target form. Domain lang:TranslationUnit, range lang:Form or lang:SurfaceForm (stated in prose). A translation target is a structured form, never a bare string. The source side is lang:translationSource."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:translationOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "translation of"@x-gmeow-english ;
    skos:definition "Relates a lang:TranslationUnit to the unit it is a translation of — the unit-to-unit pairing across the two documents. Domain and range lang:TranslationUnit (stated in prose). The pairing is directional from target unit to source unit; symmetry, where it holds, is documented rather than asserted, to keep the term profile-clean."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:translationMethod
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "translation method"@x-gmeow-english ;
    skos:definition "Names the method that produced a translation or unit. Domain lang:Translation or lang:TranslationUnit, range lang:TranslationMethod (stated in prose). The method is provenance, never a substitute for the preservation judgment carried by the logic:Correspondence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:translationCorrespondence
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "translation correspondence"@x-gmeow-english ;
    skos:definition "Relates a lang:TranslationUnit to the single logic:Correspondence node it carries — THE attachment point of the law-spine. Domain lang:TranslationUnit, range logic:Correspondence (stated in prose). Everything about the crossing that is a law rather than a facet lives on that Correspondence: its logic:preservationKind, logic:morphismClass, logic:correspondenceRelation, logic:mnemomorphic witness, logic:hasDeterminacy, and any logic:hasLawClaim with its logic:lawClaimed and logic:lawDischargeVerdict. lang: never shadows those properties; it only points at the node that holds them, and each unit carries exactly one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:surfaceCorrespondence
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "surface correspondence"@x-gmeow-english ;
    skos:definition "Relates a lang:SurfaceForm to the single logic:Correspondence node carrying the law-spine of its surface round-trip — THE attachment point when a raw surface is interned as unanalyzed prose. Domain lang:SurfaceForm, range logic:Correspondence (stated in prose). The round-trip that re-emits the surface bytes verbatim is an exact isomorphism, so the carried Correspondence holds its logic:preservationKind, logic:morphismClass, logic:correspondenceRelation, logic:mnemomorphic witness, logic:hasDeterminacy, and logic:hasLawClaim rather than any lang: shadow of them. A surface carries at most one; a raw prose lift always mints exactly one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:rollsUpFrom
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "rolls up from"@x-gmeow-english ;
    skos:definition "Relates a document-level lang:Translation to the constituent lang:TranslationUnits it aggregates — the document roll-up, mirroring the meaning layer's lang:composedFrom for denotations. Domain lang:Translation, range lang:TranslationUnit (stated in prose). A document's adequacy is the derived join of its units' preservation judgments; the roll-up is computed from the units and never asserted independently of them."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:composedThroughAbstract
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "composed through abstract"@x-gmeow-english ;
    skos:definition "Relates a compositional translation (of lang:methodCompositional) to the abstract-form tree and leaf units it was built through, so the Composition gate can derive a strong-by-construction preservation rung on the carried logic:Correspondence rather than take it on assertion — the Grammatical Framework mode. Domain lang:Translation or lang:TranslationUnit, range the abstract-form tree with its leaf lang:TranslationUnits (stated in prose). An optional path, never a mandate: a non-compositional translation simply omits it and its units carry their preservation directly."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:translationGap
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "translation gap"@x-gmeow-english ;
    skos:definition "Marks a lang:TranslationUnit whose target is inadequate — an untranslatable term, a lost distinction, a forced approximation. Domain lang:TranslationUnit, range the marked inadequacy (stated in prose). The mark says only that a gap exists; the enumerated residue — what specifically failed to cross — lives on the carried logic:Correspondence's logic:mnemomorphic witness, never on the unit, so the residue is disclosed once in the law-spine and not re-minted as lang: structure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Paraphrase properties -------------------------------------------------- #

lang:paraphraseOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "paraphrase of"@x-gmeow-english ;
    skos:definition "Relates a lang:Paraphrase to the form it paraphrases. Domain lang:Paraphrase, range lang:Form (stated in prose). Both forms belong to one sign system; the sameness the paraphrase preserves is declared through lang:paraphraseSamenessKind and its degree judged on the paraphrase's logic:Correspondence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:paraphraseSamenessKind
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "paraphrase sameness kind"@x-gmeow-english ;
    skos:definition "Names the kind of sameness a paraphrase claims to preserve. Domain lang:Paraphrase, range lang:ParaphraseSamenessKind (stated in prose). The kind fixes which corner of the Frege triangle is held constant; a paraphrase that declares no sameness kind is ill-formed, because an undeclared sameness is an equivalence smuggled in without saying what it preserves."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

lang:paraphrasePreservation
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "paraphrase preservation"@x-gmeow-english ;
    skos:definition "Relates a lang:Paraphrase to the preservation judgment of its crossing, carried as a logic:preservationKind on the paraphrase's logic:Correspondence. Domain lang:Paraphrase, range logic:PreservationKind (stated in prose). How well the declared sameness is actually preserved is the shared logic: judgment, never a second lang: grade."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# Crossing conformance-failure vocabulary (typed, queryable violation objects)
# =========================================================================== #

lang:UnderspecifiedRendering
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Underspecified Rendering"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:Rendering does not declare the material a rendering needs — its lang:renderedContent, its lang:renderingForm, or its lang:renderingKind. A rendering that names neither what it renders, nor what it produces, nor its kind realizes nothing inspectable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:RenderingAsIdentity
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Rendering As Identity"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:Rendering's lang:renderedContent and lang:renderingForm are the same resource — a rendering that claims to cross content to form while both sides are one node. A rendering realizes content as a distinct form; a self-identical rendering is a crossing that never happened, smuggled in as though it did."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnderspecifiedTranslationUnit
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Underspecified Translation Unit"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:TranslationUnit does not declare its lang:translationSource, its lang:translationTarget, or the single lang:translationCorrespondence carrying its law-spine — or declares more than one correspondence. A unit without both forms and exactly one logic:Correspondence carries no inspectable, judged crossing."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnmarkedSurfaceTranslation
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unmarked Surface Translation"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:translationSource or lang:translationTarget holds a bare literal or an unanalyzed surface not typed lang:UnanalyzedProse instead of a structured lang:Form — a translation between strings rather than forms. A translation crosses forms; an unmarked surface on either side is the string-only failure in the crossing layer."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnattributedTranslation
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unattributed Translation"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:Translation or lang:TranslationUnit declares no lang:translationMethod. Whether a crossing was produced by a human, a machine, or a compositional rule run is provenance the crossing must carry; an unattributed translation hides who or what made it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:AssertedRollup
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Asserted Rollup"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:Translation asserts a document-level preservation or adequacy directly rather than deriving it from its lang:rollsUpFrom units' judgments — a document grade minted independently of the units it aggregates. The roll-up is the join of the units' logic:Correspondence judgments and is derived, never a free document-level claim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FabricatedEquivalence
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Fabricated Equivalence"@x-gmeow-english ;
    skos:definition "The failure raised when a crossing claims a preservation stronger than its logic:Correspondence discharges — a lang:TranslationUnit, lang:Rendering, or lang:Paraphrase whose carried logic:preservationKind is logic:ExactPreservation (or a logic:hasLawClaim marked logic:ObligationDischarged) with no witness, or upgraded past what the mnemomorphic witness supports. Claiming a sameness the law-spine does not license is fabricating certainty, the crossing-layer form of imposing structure the source never had."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UndeclaredParaphraseKind
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Undeclared Paraphrase Kind"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:Paraphrase does not name a lang:paraphraseSamenessKind. A paraphrase that declares no sameness kind claims an equivalence without saying which corner of the Frege triangle — denotation, sense, or force and content — it holds fixed, and so smuggles in an equivalence without content."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnanchoredTransliteration
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unanchored Transliteration"@x-gmeow-english ;
    skos:definition "The failure raised when a lang:TransliterationMap does not declare its lang:transliterationSourceOrthography, its lang:transliterationTargetOrthography, or the lang:transliterationScheme it grafts. A transliteration between undeclared orthographies, or with no named scheme, maps nothing reconstructible."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SurfaceLeakInContentKey
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Surface Leak In Content Key"@x-gmeow-english ;
    skos:definition "The failure raised when a crossing's content-level identity is computed over surface-stratum material — a translation, rendering, or paraphrase keyed on script, encoding, casing, normalization, or rendered surface rather than on structural form content. Form identity is computed over structural content alone and is independent of encoding, script, casing, and rendering; a crossing that lets a surface distinction into its content key has leaked the surface into identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:InlineBlobPayload
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Inline Blob Payload"@x-gmeow-english ;
    skos:definition "The failure raised when a document-scale lang:SurfaceForm carries its bytes inline through lang:surfaceText rather than by reference through lang:surfaceBlob — a surface whose lang:surfaceText byte-length exceeds the document-scale threshold. Document-scale surfaces hold a content-addressed blob reference, never inline payload bytes, so the RDF carries a handle and origin rather than growing without bound with the document; a surface that inlines document-scale bytes has folded payload into identity-bearing graph content."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Ingestion-stratum failure classes (the external-engine handoff) --------- #

lang:UnattributedEngineClaim
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unattributed Engine Claim"@x-gmeow-english ;
    skos:definition "The failure raised when an external engine's output enters the graph as unattributed structure rather than a vantage-held reading — a lang:Reading produced by a lang:InterpretationAct (through lang:producedReading) that carries no gmeow:vantage. Parsers, taggers, and MT systems are oracles that produce claims, never authorities that produce facts: every engine reading is held from the engine's vantage, so an engine reading with no vantage has been folded as an unattributed fact, and two engines that disagree can no longer be told apart."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SilentPromotion
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Silent Promotion"@x-gmeow-english ;
    skos:definition "The failure raised when an engine-produced lang:Reading is promoted to a slice-level assertion without an accompanying provenance-carrying editorial act — a subject that adopts a reading as canonical (through lang:promotedReading) while itself being neither a gmeow:Activity nor carrying a gmeow:vantage. Promotion from an engine-claimed reading to a slice-asserted analysis is an explicit editorial act with its own provenance; adopting a reading as fact with no such act erases the boundary between what an engine claimed and what the slice stands behind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SilentIngestDrop
    a owl:Class ;
    rdfs:subClassOf lang:LangConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Silent Ingest Drop"@x-gmeow-english ;
    skos:definition "The failure raised when an ingester admits content without accounting for it — a construct that enters the graph neither fully lifted nor hard-failed with a typed diagnostic naming it. An ingester lifts fully or hard-fails; it never silently drops material. The bridges enforce this at the seam (a lift that cannot represent a construct raises a typed diagnostic carrying this class rather than emitting a plausible-but-wrong structure); at the dataset level it surfaces as a lang:SurfaceForm left in limbo — one that neither lang:realizes an analyzed lang:Form nor is typed lang:UnanalyzedProse — a surface whose analysis was silently dropped rather than recorded or refused."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:promotedReading
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "promoted reading"@x-gmeow-english ;
    skos:definition "Relates an editorial promotion act to the lang:Reading it elevates from an engine-claimed candidate to a slice-asserted analysis. Domain gmeow:Activity, range lang:Reading (stated in prose). Promotion is lawful ONLY as an explicit provenance-carrying act: the promoting subject is a gmeow:Activity carrying a gmeow:vantage naming the editor who stands behind the reading; a lang:promotedReading edge from a subject that is neither an activity nor vantage-held has silently promoted the reading (lang:SilentPromotion)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
