@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .

# =========================================================================== #
# GTS transport data shapes (GTS transport design, docs/GTS-SPEC.md)
# =========================================================================== #

# A segment must carry the parts of its composite identity: exactly one head,
# exactly one index, exactly one profile (spec §3.1, §13).
gmeow:GTSSegmentShape
    a sh:NodeShape ;
    rdfs:label "GTSSegment well-formedness shape"@x-gmeow-english ;
    skos:definition "Well-formedness for a GTSSegment's composite identity: exactly one gmeow:gtsHeadId (a blake3 content digest), one gmeow:gtsSegmentIndex, and one gmeow:gtsProfile. The three parts together name the segment (GTS spec §3.1, §13)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    logic:formalizes gmeow:GtsHeadIdCanonicalConstraint ;
    sh:targetClass gmeow:GTSSegment ;
    sh:property [
        sh:path gmeow:gtsHeadId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^blake3:[0-9a-f]{64}$" ;
        sh:severity sh:Violation ;
        sh:message "A GTSSegment must carry exactly one gmeow:gtsHeadId of the form 'blake3:<64 hex digits>'." ;
    ] ;
    sh:property [
        sh:path gmeow:gtsSegmentIndex ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:severity sh:Violation ;
        sh:message "A GTSSegment must carry exactly one gmeow:gtsSegmentIndex." ;
    ] ;
    sh:property [
        sh:path gmeow:gtsProfile ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:GTSProfile ;
        sh:severity sh:Violation ;
        sh:message "A GTSSegment must declare exactly one gmeow:gtsProfile." ;
    ] .
