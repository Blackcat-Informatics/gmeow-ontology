#
# The GMN-1 (GMEOW Model Notation) surface grammar in W3C EBNF, one production
# per line. This file is a RENDERING of the gmeow:gmnGrammar object in the lang
# module, never its identity: the grammar object carries the normative claims
# (LL(1) prefix decodability via gmeow:gmnDeterminismClass, the sigil-role and
# operator tables). GMN is newline-delimited: every record occupies one line and
# opens with a record-initial sigil, so a reader dispatches on the first token.
# The in-band '@gmn' header pins the dialect coordinates (schema version,
# alias-table reference, and glyph-table version) before any record. Records are sigil-then-braced
# key-value lists; a schema-once tabular batch declares its columns once in an
# '@claims[...]' header and then streams bare rows. Lexical whitespace rules are
# carried by the codec, not by these productions.

gmnDoc ::= header line*
header ::= '@gmn' '{' 'v' ':' integer ',' 'aliases' ':' identifier ',' 'glyphs' ':' integer '}' EOL
line ::= record | batch
record ::= sigil recordBody EOL
sigil ::= '@c' | '@e' | '@s' | '@p' | '@d' | '@m' | '@π' | '@μ' | '@λ' | '@ℒ' | '@err' | '@patch' | '@retract'
recordBody ::= '{' pairList '}'
pairList ::= pair (',' pair)*
pair ::= identifier ':' value
value ::= referenceToken | number | list | tripleTerm
referenceToken ::= identifier | glyphToken
# RDF 1.2 triple term in the object slot (`s rdf:reifies <<( a b c )>>`): the compact
# GMN-1 surface `( s p o )` over three nested values, recovered by the codec's
# paren-depth-aware split. Nests (`( a b ( c d e ) )`); inter-component whitespace is
# carried by the codec, per this file's whitespace note.
tripleTerm ::= '(' value value value ')'
# GENERATOR SEAM: the pipeline replaces this whole production from the canonical
# Denotation -> Grapheme registry before parsing or shipping the grammar. The
# sentinel is deliberately not a glyph inventory; exactly one such production is
# required so replacement is deterministic and a second source cannot drift.
glyphToken ::= GRAPH_DERIVED_GLYPH_TOKEN
list ::= '[' value (',' value)* ']'
batch ::= batchHeader batchRow*
batchHeader ::= '@claims' '[' columnList ']' EOL
columnList ::= identifier (' ' identifier)*
batchRow ::= value (' ' value)* EOL
identifier ::= nameStart nameChar*
nameStart ::= [A-Za-z_]
nameChar ::= [A-Za-z0-9_.-]
number ::= '-'? integer fraction?
fraction ::= '.' digit digit
integer ::= digit+
digit ::= [0-9]
EOL ::= #xD? #xA
