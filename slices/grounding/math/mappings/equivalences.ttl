    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://oeis.org/A000796> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:objectLabel "A000796" ;
    gmeow:comment "OEIS A000796 is the decimal expansion of π — a locator for the digits of math:pi, a related resource rather than the constant's identity, so skos:relatedMatch. Link-only (OEIS is CC BY-SA 4.0, aligned by reference)." ;
    gmeow:sssomFile "gmeow-oeis.sssom.tsv" .

