<?xml version="1.0" encoding="UTF-8"?>
<!-- EmotionML 1.0 projection of the GMEOW affect vocabulary. Lossy by construction:
     mode / experience / appraisal / classifier-output all collapse into one <emotion>
     envelope (the many-to-one loss is recorded in generated/logic/projection-report.ttl).
     Generated projection — do not edit; author in slices/core/affect. -->
<emotionml xmlns="http://www.w3.org/2009/10/emotionml" xmlns:gmeow="https://blackcatinformatics.ca/gmeow/" category-set="#gmeow-emotion-categories" dimension-set="#gmeow-appraisal-dimensions">
  <vocabulary type="category" id="gmeow-emotion-categories">
    <item name="anger"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/emotionAnger</gmeow:term></info></item>
    <item name="anticipation"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/emotionAnticipation</gmeow:term></info></item>
    <item name="disgust"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/emotionDisgust</gmeow:term></info></item>
    <item name="fear"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/emotionFear</gmeow:term></info></item>
    <item name="joy"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/emotionJoy</gmeow:term></info></item>
    <item name="sadness"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/emotionSadness</gmeow:term></info></item>
    <item name="saudade"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/emotionSaudade</gmeow:term></info></item>
    <item name="schadenfreude"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/emotionSchadenfreude</gmeow:term></info></item>
    <item name="surprise"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/emotionSurprise</gmeow:term></info></item>
    <item name="trust"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/emotionTrust</gmeow:term></info></item>
  </vocabulary>
  <vocabulary type="dimension" id="gmeow-appraisal-dimensions">
    <item name="agency"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionAgency</gmeow:term></info></item>
    <item name="arousal"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionArousal</gmeow:term></info></item>
    <item name="certainty"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionCertainty</gmeow:term></info></item>
    <item name="coping potential"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionCoping</gmeow:term></info></item>
    <item name="dominance"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionDominance</gmeow:term></info></item>
    <item name="goal congruence"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionGoalCongruence</gmeow:term></info></item>
    <item name="goal relevance"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionGoalRelevance</gmeow:term></info></item>
    <item name="norm compatibility"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionNormCompatibility</gmeow:term></info></item>
    <item name="novelty"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionNovelty</gmeow:term></info></item>
    <item name="object focus"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionObjectFocus</gmeow:term></info></item>
    <item name="temporal orientation"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionTemporalOrientation</gmeow:term></info></item>
    <item name="unpredictability"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionUnpredictability</gmeow:term></info></item>
    <item name="valence"><info><gmeow:term>https://blackcatinformatics.ca/gmeow/dimensionValence</gmeow:term></info></item>
  </vocabulary>
  <!-- A worked <emotion> envelope: gmeow:Emotion, gmeow:AffectiveExperience,
       gmeow:Appraisal, and gmeow:AffectClassifierOutput ALL project into one such
       envelope — the projection is many-to-one and lossy by design. -->
  <emotion category-set="#gmeow-emotion-categories" dimension-set="#gmeow-appraisal-dimensions">
    <category name="anger"/>
    <dimension name="valence" value="0.5"/>
  </emotion>
</emotionml>
