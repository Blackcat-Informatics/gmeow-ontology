    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:proficiencyModality a owl:ObjectProperty , owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:proficiencyModality MUST be an owl:ObjectProperty and owl:FunctionalProperty — mint one proficiency per (agent, language, modality) so per-skill levels coexist. Mirrors test_reified_relators_and_functional_roles (proficiencyModality role arm)." .

# --- 9. proficiencyLevel is a functional ObjectProperty (MUST)
ex:saProficiencyLevelFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
