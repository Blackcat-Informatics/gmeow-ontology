gmeow:mapDoapGitRepository a gmeow:ProjectionMapping ;
    rdfs:label "Repository(repoTypeGit) → doap:GitRepository"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "dgit" ;
        gmeow:atom (
            [ gmeow:subjectVar "dgit" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:Repository ]
            [ gmeow:subjectVar "dgit" ; gmeow:predicate gmeow:repositoryType ; gmeow:objectValue gmeow:repoTypeGit ] ) ;
        gmeow:edoalSource gmeow:repositoryType ] ;
    gmeow:hasBinding [
        gmeow:profile "doap" ; gmeow:toClass doap:GitRepository ; gmeow:relation "=" ; gmeow:confidence 0.95 ] .


gmeow:mapDoapCategory a gmeow:ProjectionMapping ;
    rdfs:label "SoftwareProject hasTag → doap:category"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "dcatProj" ; gmeow:value "dcatTag" ;
        gmeow:atom (
            [ gmeow:subjectVar "dcatProj" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:SoftwareProject ]
            [ gmeow:subjectVar "dcatProj" ; gmeow:predicate gmeow:hasTag ; gmeow:objectVar "dcatTag" ] ) ;
        gmeow:edoalSource gmeow:hasTag ] ;
    gmeow:hasBinding [
        gmeow:profile "doap" ; gmeow:toPredicate doap:category ; gmeow:relation "<=" ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "the tag node passes as the category resource; tagger, scheme, and interval drop" ] .

