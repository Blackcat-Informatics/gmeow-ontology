# --- CQ / cq-promotion-defers-activation (AC6) ------------------------------ #
ex:cqPromotionDefersActivation a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/preference/queries/competency/cq-promotion-defers-activation.rq" ;
    gmeow:cqDataFile "examples/promotion-worked.ttl" ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqPromotionDefersActivationShape ;
