# Inverse ingest: ml-schema → GMEOW. Mint-with-claim, validation-only — import-derived claim, not extracted fact; subject/tenure not synthesized (residue). GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX mls: <http://www.w3.org/ns/mls#>

CONSTRUCT {
    ?mlsExec gmeow:executionOfDeployment ?mlsImpl .
    ?mlsExec gmeow:wasGeneratedBy _:imp .
    ?mlsExec gmeow:mappedFrom mls:executes .
    _:imp a gmeow:ImportActivity .
    ?mlsDeployment a gmeow:ModelDeployment .
    ?mlsDeployment gmeow:wasGeneratedBy _:imp .
    ?mlsDeployment gmeow:mappedFrom mls:Implementation .
    ?mlsArtifact a gmeow:ModelArtifact .
    ?mlsArtifact gmeow:wasGeneratedBy _:imp .
    ?mlsArtifact gmeow:mappedFrom mls:Model .
    ?mlsExecution a gmeow:RuntimeExecution .
    ?mlsExecution gmeow:wasGeneratedBy _:imp .
    ?mlsExecution gmeow:mappedFrom mls:Run .
}
WHERE {
    {
        ?mlsExec mls:executes ?mlsImpl .
    }
    UNION {
        ?mlsDeployment a mls:Implementation .
    }
    UNION {
        ?mlsArtifact a mls:Model .
    }
    UNION {
        ?mlsExecution a mls:Run .
    }
}
