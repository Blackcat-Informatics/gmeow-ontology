gmeow:eqDeterminacy005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:determinacyProbabilistic ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q9492 ;
    gmeow:justification semapv:ManualMappingCuration ;
