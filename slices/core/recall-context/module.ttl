    logic:formalizes gmeow:recallOutcomeRecollections ;
    logic:message "A recollections outcome retains at least one selected record without claiming completeness." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:recallOutcome ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:recallOutcomeRecollections ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "record" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:recalledRecord ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "record" ] ] ] ] ] .

gmeow:RecallVerdictIsAskersOwnConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "asker verdict attribution constraint"@x-gmeow-english ;
    skos:definition "A recall verdict is attributed to the same agent who asked the judged answer’s cue. Other agents’ judgements are separate records and do not resolve this asker’s question."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve asker verdict attribution constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying RecallVerdictIsAskersOwnConstraint by inventing records or selecting a weaker operation."@x-gmeow-english ;
    gmeow:howToUse "Apply RecallVerdictIsAskersOwnConstraint to the explicit scoped records and retain the original evidence."@x-gmeow-english ;
    skos:example "The declared records are checked against gmeow:RecallVerdictIsAskersOwnConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:RecallVerdict ;
    logic:message "A recall verdict is attributed to the same agent who asked the judged answer’s cue. Other agents’ judgements are separate records and do not resolve this asker’s question." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "answer" ] , [ logic:termIndex 2 ; logic:termVariable "asker" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:RecallVerdict ] ] , [ a logic:Formula ; logic:relation gmeow:verdictOn ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "answer" ] ] , [ a logic:Formula ; logic:relation gmeow:recallAsker ; logic:argument [ logic:termIndex 0 ; logic:termVariable "answer" ] , [ logic:termIndex 1 ; logic:termVariable "asker" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation gmeow:wasAttributedTo ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "asker" ] ] ] ] .

gmeow:RecallAskerAskedQuestionConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "recall asker question constraint"@x-gmeow-english ;
    skos:definition "The answer’s identified asker holds open the actual Question answered, not merely an equal cue string."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve recall asker question constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying RecallAskerAskedQuestionConstraint by inventing records or selecting a weaker operation."@x-gmeow-english ;
    gmeow:howToUse "Apply RecallAskerAskedQuestionConstraint to the explicit scoped records and retain the original evidence."@x-gmeow-english ;
    skos:example "The declared records are checked against gmeow:RecallAskerAskedQuestionConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:recallAsker ;
    logic:message "The answer’s identified asker holds open the actual Question answered, not merely an equal cue string." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "question" ] , [ logic:termIndex 2 ; logic:termVariable "asker" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:RecallAnswer ] ] , [ a logic:Formula ; logic:relation gmeow:answers ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "question" ] ] , [ a logic:Formula ; logic:relation gmeow:recallAsker ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "asker" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation gmeow:asks ; logic:argument [ logic:termIndex 0 ; logic:termVariable "asker" ] , [ logic:termIndex 1 ; logic:termVariable "question" ] ] ] ] .

gmeow:ExclusionReasonLanguageConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "exclusion reason language constraint"@x-gmeow-english ;
    skos:definition "Every supplied wording preserves its language tag, including RDF 1.2 base direction when present."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve exclusion reason language constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying ExclusionReasonLanguageConstraint by inventing records or selecting a weaker operation."@x-gmeow-english ;
    gmeow:howToUse "Apply ExclusionReasonLanguageConstraint to the explicit scoped records and retain the original evidence."@x-gmeow-english ;
    skos:example "The declared records are checked against gmeow:ExclusionReasonLanguageConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:exclusionReason ;
    logic:message "Every supplied wording preserves its language tag, including RDF 1.2 base direction when present." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "value" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:exclusionReason ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "value" ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termHasLang ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] ] ] ] .

gmeow:RecallVerdictWordsLanguageConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "verdict wording language constraint"@x-gmeow-english ;
    skos:definition "Every supplied wording preserves its language tag, including RDF 1.2 base direction when present."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve verdict wording language constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying RecallVerdictWordsLanguageConstraint by inventing records or selecting a weaker operation."@x-gmeow-english ;
    gmeow:howToUse "Apply RecallVerdictWordsLanguageConstraint to the explicit scoped records and retain the original evidence."@x-gmeow-english ;
    skos:example "The declared records are checked against gmeow:RecallVerdictWordsLanguageConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:verdictWords ;
    logic:message "Every supplied wording preserves its language tag, including RDF 1.2 base direction when present." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "value" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:verdictWords ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "value" ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termHasLang ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] ] ] ] .

gmeow:RecallBudgetSumRule a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    rdfs:label "recall budget finite sum rule"@x-gmeow-english ;
    skos:definition "Derive the per-budget finite sum over full operation substitutions, retaining repeated equal shares and schema reuse as distinct operation contributions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:aggregateFunction "SUM" ; logic:aggregateVariable "?share" ;
    logic:aggregateResult "?total" ; logic:groupKey "?budget" ;
    logic:head [ rdf:reifies <<( _:recallContextBudget gmeow:recallBudgetTotal _:recallContextTotal )>> ] ;
    logic:body [ rdf:reifies <<( _:recallContextBudget gmeow:budgetOperation _:recallContextOperation )>> ],
               [ rdf:reifies <<( _:recallContextOperation gmeow:budgetShare _:recallContextShare )>> ] .
_:recallContextBudget logic:termVariable "budget" .
_:recallContextOperation logic:termVariable "operation" .
_:recallContextShare logic:termVariable "share" .
_:recallContextTotal logic:termVariable "total" .

logic:ActionSchema logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:recallScope ; logic:allValuesFrom gmeow:RecallScope ],
    [ a logic:Restriction ; logic:onProperty gmeow:recallDepth ; logic:allValuesFrom gmeow:RecallDepth ],
    [ a logic:Restriction ; logic:onProperty gmeow:recollectionForm ; logic:allValuesFrom gmeow:RecollectionForm ],
    [ a logic:Restriction ; logic:onProperty gmeow:recallLatest ; logic:allValuesFrom xsd:positiveInteger ],
    [ a logic:Restriction ; logic:onProperty gmeow:budgetShare ; logic:allValuesFrom xsd:decimal ] .

gmeow:BudgetShareBoundsConstraint a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "budget share bounds law"@x-gmeow-english ;
    skos:definition "Every supplied share is greater than zero and at most one; the separate plan-total law still applies."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve budget share bounds law."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating BudgetShareBoundsConstraint as a runtime certificate."@x-gmeow-english ;
    gmeow:howToUse "Apply BudgetShareBoundsConstraint to actual records while retaining independent obligations."@x-gmeow-english ;
    skos:example "The record is governed by gmeow:BudgetShareBoundsConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:budgetShare ;
    logic:message "Every supplied share is greater than zero and at most one; the separate plan-total law still applies." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "share" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:budgetShare ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "share" ] ] ; logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:termGreater ; logic:argument [ logic:termIndex 0 ; logic:termVariable "share" ] , [ logic:termIndex 1 ; logic:termLiteral "0.0" ; logic:termLiteralDatatype xsd:decimal ] ] , [ a logic:Formula ; logic:relation logic:termLessEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "share" ] , [ logic:termIndex 1 ; logic:termLiteral "1.0" ; logic:termLiteralDatatype xsd:decimal ] ] ] ] ] .

gmeow:RecallRankReifierCompletenessConstraint a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "recall rank reifier completeness constraint"@x-gmeow-english ;
    skos:definition "Every actual recalled-record reifier has a rank. Schema-level reification obligations are not returned-record occurrences."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve recall rank reifier completeness constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating RecallRankReifierCompletenessConstraint as a runtime certificate."@x-gmeow-english ;
    gmeow:howToUse "Apply RecallRankReifierCompletenessConstraint to actual records while retaining independent obligations."@x-gmeow-english ;
    skos:example "The record is governed by gmeow:RecallRankReifierCompletenessConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:recallRank ;
    logic:message "Every actual recalled-record reifier has a rank. Schema-level reification obligations are not returned-record occurrences." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "triple" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:RecalledRecordClaim ] ] , [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#reifies> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "triple" ] ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "rank" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:recallRank ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "rank" ] ] ] ] ] .

gmeow:SlotStateReificationObligation a rdf:Statement , gmeow:SlotAssignmentClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "slot-state reification obligation"@x-gmeow-english ;
    skos:definition "Every slotState assertion carries its own SlotAssignmentClaim reifier. This schema-level obligation is not an assignment occurrence."@x-gmeow-english ;
    gmeow:useWhen "Use to require the typed reifier for gmeow:slotState assertions."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid presenting schema metadata as an actual returned record or slot change."@x-gmeow-english ;
    gmeow:howToUse "Declare the subject class, predicate and reifier class in the canonical reification-obligation form."@x-gmeow-english ;
    skos:example "The obligation governs gmeow:slotState reifiers."@x-gmeow-english ;
    rdf:subject gmeow:AttentionSlot ; rdf:predicate gmeow:slotState ; rdf:object logic:Thing .

gmeow:RecalledRecordReificationObligation a rdf:Statement , gmeow:RecalledRecordClaim ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "recalled-record reification obligation"@x-gmeow-english ;
    skos:definition "Every recalledRecord assertion carries its own RecalledRecordClaim reifier, whose actual occurrence must retain its rank."@x-gmeow-english ;
    gmeow:useWhen "Use to require the typed reifier for gmeow:recalledRecord assertions."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid presenting schema metadata as an actual returned record or slot change."@x-gmeow-english ;
    gmeow:howToUse "Declare the subject class, predicate and reifier class in the canonical reification-obligation form."@x-gmeow-english ;
    skos:example "The obligation governs gmeow:recalledRecord reifiers."@x-gmeow-english ;
    rdf:subject gmeow:RecallAnswer ; rdf:predicate gmeow:recalledRecord ; rdf:object logic:Thing .

gmeow:RecallBudgetSumRule
    gmeow:useWhen "Use to derive the total from the complete finite operation roster."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid independently authoring a total or collapsing equal shares from distinct operations."@x-gmeow-english ;
    gmeow:howToUse "Retain operation identity in full body substitutions and group SUM by budget identity."@x-gmeow-english ;
    skos:example "Two identified operations with share 0.4 derive a budget total of 0.8."@x-gmeow-english .

gmeow:RecallDeadlineIsIncompleteConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "deadline recall completeness constraint"@x-gmeow-english ;
    skos:definition "A deadline outcome requires recallComplete false, even when some records were returned."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve deadline recall completeness constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating RecallDeadlineIsIncompleteConstraint as evidence of unrecorded execution or tuple comparisons."@x-gmeow-english ;
    gmeow:howToUse "Apply RecallDeadlineIsIncompleteConstraint to the actual source records without inventing missing facts."@x-gmeow-english ;
    skos:example "The source record is governed by gmeow:RecallDeadlineIsIncompleteConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:recallOutcomeDeadline ;
    logic:message "A deadline outcome requires recallComplete false, even when some records were returned." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:recallOutcome ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:recallOutcomeDeadline ] ] ; logic:consequent [ a logic:Formula ; logic:relation gmeow:recallComplete ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] ] ] ] .

gmeow:RecallPartialIsIncompleteConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "partial recall completeness constraint"@x-gmeow-english ;
    skos:definition "A partial-search outcome requires recallComplete false, even when some records were returned."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve partial recall completeness constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating RecallPartialIsIncompleteConstraint as evidence of unrecorded execution or tuple comparisons."@x-gmeow-english ;
    gmeow:howToUse "Apply RecallPartialIsIncompleteConstraint to the actual source records without inventing missing facts."@x-gmeow-english ;
    skos:example "The source record is governed by gmeow:RecallPartialIsIncompleteConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:recallOutcomePartial ;
    logic:message "A partial-search outcome requires recallComplete false, even when some records were returned." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:recallOutcome ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:recallOutcomePartial ] ] ; logic:consequent [ a logic:Formula ; logic:relation gmeow:recallComplete ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] ] ] ] .

gmeow:SlotClaimPredecessorConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "slot claim predecessor constraint"@x-gmeow-english ;
    skos:definition "A slot-assignment successor names another actual RDF 1.2 assignment claim as predecessor. The consumer verifies same-slot history from the authoritative reified tuples; recorder attribution need not remain equal."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve slot claim predecessor constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating SlotClaimPredecessorConstraint as evidence of unrecorded execution or tuple comparisons."@x-gmeow-english ;
    gmeow:howToUse "Apply SlotClaimPredecessorConstraint to the actual source records without inventing missing facts."@x-gmeow-english ;
    skos:example "The source record is governed by gmeow:SlotClaimPredecessorConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:SlotAssignmentClaim ;
    logic:message "A slot-assignment successor names another actual RDF 1.2 assignment claim as predecessor. The consumer verifies same-slot history from the authoritative reified tuples; recorder attribution need not remain equal." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "prior" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:SlotAssignmentClaim ] ] , [ a logic:Formula ; logic:relation gmeow:supersedes ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "prior" ] ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "triple" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "prior" ] , [ logic:termIndex 1 ; logic:termIri gmeow:SlotAssignmentClaim ] ] , [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#reifies> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "prior" ] , [ logic:termIndex 1 ; logic:termVariable "triple" ] ] ] ] ] ] .

# Runtime trace observation and requested recollection strategies.

gmeow:recollectionFading
    a gmeow:RecollectionForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "recency-graded recollection strategy"@x-gmeow-english ;
    skos:definition "A requested presentation strategy that grades recalled records by source recency: newest records verbatim, older records as summaries, and oldest records as a line with a handle. It is selected on an ActionSchema rather than asserted as a delivered record's form."@x-gmeow-english ;
    gmeow:useWhen "Use when a source plan explicitly requests recency-dependent presentation rather than one uniform verbatim, gist or summary-with-handle mode."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring age bands, a reference clock, summary content, available handles or completed rendering from selection of this strategy."@x-gmeow-english ;
    gmeow:howToUse "Select this value with recollectionForm on the actual recall ActionSchema and retain any source-specified recency rules separately. Preserve the original records and actual output evidence independently."@x-gmeow-english ;
    skos:scopeNote "Grading direction does not define numeric cutoffs or implement a summarizer. The strategy is independent of recall depth and does not substitute for the standalone one-line gist form."@x-gmeow-english ;
    skos:example "Request graded presentation: ex:gradedRecall gmeow:recollectionForm gmeow:recollectionFading ."@x-gmeow-english .

gmeow:recollectionFormOneLineGist
    a gmeow:RecollectionForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "one-line gist recollection form"@x-gmeow-english ;
    skos:definition "A requested concise one-line gist of a recalled record, without requiring a handle and without claiming verbatim wording. It is a uniform presentation choice, distinct from a recency-grading strategy."@x-gmeow-english ;
    gmeow:useWhen "Use when the source asks for a one-line gist and neither verbatim presentation nor a summary with a mandatory handle describes that request."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid equating the gist with original words, silently adding a handle requirement or treating one line as a numeric recency band."@x-gmeow-english ;
    gmeow:howToUse "Select this value through recollectionForm on the actual ActionSchema; retain original-record provenance and any independently supplied handle without making that handle mandatory."@x-gmeow-english ;
    skos:scopeNote "The value requests a presentation; it does not assert that a gist was generated, that a retrieval completed or that the gist is true."@x-gmeow-english ;
    skos:example "Request a gist without requiring a handle: ex:gistRecall gmeow:recollectionForm gmeow:recollectionFormOneLineGist ."@x-gmeow-english .

gmeow:SlotBoundRecallScope
    a logic:Class, logic:SubKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Slot Bound Recall Scope"@x-gmeow-english ;
    skos:definition "A RecallScope whose requested record selection is explicitly anchored through supplied scopeSlot values to at least one actual AttentionSlot."@x-gmeow-english ;
    skos:scopeNote "This explicit profile requires actual anchors and preserves their AttentionSlot typing. Missing anchors remain invalid; they never select the unbound parent as a fallback. No maximum number of anchors is imposed."@x-gmeow-english ;
    skos:example "The existing conversation-turn scope names its actual conversation slot and selects this bound profile."@x-gmeow-english ;
    gmeow:useWhen "Use when the source specification selects actual attention-slot anchors for its requested records."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing an agent, slot or history to complete this profile, copying the pointed record into the scope, or dropping the profile when an anchor is missing."@x-gmeow-english ;
    gmeow:howToUse "Type the actual anchored specification as SlotBoundRecallScope and retain its supplied scopeSlot values. Keep each slot’s real bearer, role, history and attributed state claims under their existing contracts."@x-gmeow-english ;
    logic:subClassOf gmeow:RecallScope ,
        [ a logic:Restriction ; logic:onProperty gmeow:scopeSlot ; logic:allValuesFrom gmeow:AttentionSlot ] .

gmeow:recallScopeAttendedNow
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "currently attended recall scope"@x-gmeow-english ;
    skos:definition "A shared RecallScope specification requesting the thread that the agent’s supplied state holds open now, resolved within the actual per-call state and view."@x-gmeow-english ;
    skos:scopeNote "The value is a parameterized request, not a current thread, slot assignment or global state winner. Its meaning needs the actual selected agent-state context."@x-gmeow-english ;
    skos:example "A declared recall operation requests the thread held open in the state supplied for that call."@x-gmeow-english ;
    gmeow:useWhen "Use when a context plan explicitly requests the agent-state thread currently held open for this call."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring a global current thread, fabricating a slot or treating this selector as evidence that any records were retrieved."@x-gmeow-english ;
    gmeow:howToUse "Reference recallScopeAttendedNow through recallScope on the actual schema and retain the supplied per-call agent-state view; resolve it without manufacturing missing state."@x-gmeow-english .

gmeow:recallScopeRecentEpisodes
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "recent episodes recall scope"@x-gmeow-english ;
    skos:definition "A shared RecallScope specification requesting the agent’s latest episodes under the actual source chronology and context selected for the call."@x-gmeow-english ;
    skos:scopeNote "The value supplies no fixed age window, episode count, clock precision or global recency order. Any selected limits and ordering remain actual source inputs."@x-gmeow-english ;
    skos:example "A declared operation requests the agent’s latest episodes while retaining the source’s actual ordering and any separately supplied limit."@x-gmeow-english ;
    gmeow:useWhen "Use when the plan explicitly selects recent episodes rather than the thread currently held open or the packet’s topics."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing dates, episode identities or a fixed recency cutoff, or treating incomplete chronology as a complete latest-order computation."@x-gmeow-english ;
    gmeow:howToUse "Reference recallScopeRecentEpisodes through recallScope and retain the actual agent context, source ordering and any explicitly selected recallLatest limit without adding defaults."@x-gmeow-english .

gmeow:recallScopePacket
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "packet wording recall scope"@x-gmeow-english ;
    skos:definition "A shared RecallScope specification requesting what the actual packet’s own words are about."@x-gmeow-english ;
    skos:scopeNote "The packet’s words, their subjects and the packet’s kind are distinct. This value supplies no inferred topic, referent identity, language or performed interpretation."@x-gmeow-english ;
    skos:example "A context plan requests recall about the supplied packet’s own wording rather than substituting a standing thread or a kind label."@x-gmeow-english ;
    gmeow:useWhen "Use when the requested recall selection is about the actual packet’s own words."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting the packet kind, a default topic or another conversation, or claiming that naming this scope executes text analysis."@x-gmeow-english ;
    gmeow:howToUse "Reference recallScopePacket through recallScope and retain the actual packet wording and source context required by the consumer’s selection. Keep unresolved aboutness unresolved."@x-gmeow-english .

gmeow:recallScopeAudience
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "audience floor recall scope"@x-gmeow-english ;
    skos:definition "A shared RecallScope specification requesting who is listening, using the floor of the relationship rings of everyone in the actual current conversation together with the configured warning text for that resulting ring."@x-gmeow-english ;
    skos:scopeNote "The actual conversation roster, relationship-ring ordering, floor rule and configured warning are consumer inputs. This value defines no universal rings, numerical minimum, participant presence or fallback warning."@x-gmeow-english ;
    skos:example "A declared operation requests the audience under the supplied conversation’s relationship-ring floor and retains the warning configured for that ring."@x-gmeow-english ;
    gmeow:useWhen "Use when the source plan explicitly requests the current conversation’s audience floor and its configured ring warning."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid replacing relationship rings with persona audience ranks, inventing a ring taxonomy or warning, omitting listeners from the declared roster, or claiming that this selector computes or authenticates the floor."@x-gmeow-english ;
    gmeow:howToUse "Reference recallScopeAudience through recallScope and retain the actual conversation context, all supplied relationship-ring inputs, the selected floor policy and that ring’s configured warning. Missing inputs are not a default audience."@x-gmeow-english .

gmeow:PacketKind
    a logic:Kind, logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Packet Kind"@x-gmeow-english ;
    skos:definition "An information-bearing specification of the kind of thinking or context for which a model-call packet is requested. Its instances describe consumer-defined kinds, not the packet or its words."@x-gmeow-english ;
    skos:scopeNote "This open Kind under InformationObject describes kind specifications, not QualityValue measurements, model-call activities or a fixed mode taxonomy. Deployment-specific values remain local."@x-gmeow-english ;
    skos:example "A context-plan condition reads the packet’s supplied kind specification beside actual state-slot facts, without reading the packet’s words as its kind."@x-gmeow-english ;
    gmeow:useWhen "Use to identify an actual consumer-defined kind specification for the thinking or context requested for a packet."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid typing the packet or its words as PacketKind, inferring an executed model call, or publishing a deployment’s local modes as a universal taxonomy."@x-gmeow-english ;
    gmeow:howToUse "Retain the actual kind specification resource and reference it through packetKind on the information-bearing packet. Preserve consumer identity and source without inventing a mode from wording or missing data."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:packetKind
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "packet kind"@x-gmeow-english ;
    skos:definition "Relates an information-bearing packet to the PacketKind specification of the thinking or context it is requested for, as one supplied kind fact per packet rather than the packet’s words."@x-gmeow-english ;
    skos:scopeNote "The canonical upper bound permits at most one PacketKind per InformationObject. It requires no kind on every information object and creates no Packet class; absence remains unknown rather than a default mode."@x-gmeow-english ;
    skos:example "The source supplies one packet-kind resource for a packet, and a plan condition refers to that fact without inferring that the condition currently holds."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly supplies the kind specification that a context condition reads for this packet."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid putting literal packet words or a guessed mode here, requiring the property on unrelated information objects, or treating its presence as rule execution or model lifecycle authority."@x-gmeow-english ;
    gmeow:howToUse "Link the actual InformationObject packet to its supplied PacketKind resource and retain exact-statement attribution. Keep its words separately; the endpoint closure and qualified upper bound validate supplied values without claiming universal field presence."@x-gmeow-english ;
    logic:domain gmeow:InformationObject ;
    logic:range gmeow:PacketKind .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/packetKind" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:InformationObject logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:packetKind ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass gmeow:PacketKind ] .

gmeow:contextPlanHolder
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "context plan source lens"@x-gmeow-english ;
    skos:definition "The actual source/vantage lens whose declared record domain a context plan selects, independently of its state subject, author or executor."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly identifies the lens governing this plan’s record selection."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid equating the lens with an Agent, state subject, author, recorder or pair member without actual source evidence."@x-gmeow-english ;
    gmeow:howToUse "Retain the actual Entity fulfilling the Agent/Standpoint vantage role and the exact association’s source and frame. Supply state and record-domain bindings separately."@x-gmeow-english ;
    skos:scopeNote "Optional and nonfunctional. Absence selects no default agent or domain. Entity range does not prove lens semantics, permission, execution or private-field equivalence."@x-gmeow-english ;
    skos:example "A plan names its supplied source lens while keeping the actual state subject separately identified."@x-gmeow-english ;
    logic:domain logic:Plan ;
    logic:range gmeow:Entity .

gmeow:recallScopeHolderHeardFromSpeaker
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "holder-side heard-from-speaker recall scope"@x-gmeow-english ;
    skos:definition "A shared specification requesting holder-side heard records of the current speaker, newest in the actual selected source order, excluding the exact current exchange."@x-gmeow-english ;
    gmeow:useWhen "Use for historical hearing of the actual current speaker."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting the speaker’s private memory, inferring hearing from receipt or including the current exchange as history."@x-gmeow-english ;
    gmeow:howToUse "Supply the actual lens/domain, state view, exchange, addressed words, speaker, source order and temporal interpretation; retain exact source links."@x-gmeow-english ;
    skos:scopeNote "Missing bindings refuse the selected operation; this specification creates no records, clock or global latest selection."@x-gmeow-english ;
    skos:example "Recall earlier heard records of the supplied speaker while setting aside the exact exchange now addressed to the holder."@x-gmeow-english .

gmeow:recallScopeHolderMemoriesOfSpeaker
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "holder-side memories-of-speaker recall scope"@x-gmeow-english ;
    skos:definition "A shared specification requesting the holder-side memory records whose retained words identify the actual current speaker under supplied source name and mention evidence."@x-gmeow-english ;
    gmeow:useWhen "Use for the holder-side memories that actually name the current speaker."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a memory-to-person link, canonical name or universal text matcher."@x-gmeow-english ;
    gmeow:howToUse "Supply actual lens/domain, state/exchange, addressed words, speaker and source name/mention bindings; retain the selected matching capability."@x-gmeow-english ;
    skos:scopeNote "This selection requests source-supported memory wording, not the speaker’s own records or proof of identity resolution."@x-gmeow-english ;
    skos:example "A request retains the actual source name used to find memories without adding a fabricated aboutness edge."@x-gmeow-english .

gmeow:recallScopeHolderRepliesToSpeaker
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "holder-side replies-to-speaker recall scope"@x-gmeow-english ;
    skos:definition "A shared specification requesting holder-side replies prompted by actual heard records of the current speaker, under the selected source order."@x-gmeow-english ;
    gmeow:useWhen "Use for source-identified earlier replies to the supplied current speaker."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating every generated output or matching author as a reply to that speaker."@x-gmeow-english ;
    gmeow:howToUse "Supply actual lens/domain, state/exchange, addressed words, speaker, prompt/heard links and source temporal order."@x-gmeow-english ;
    skos:scopeNote "Missing prompt evidence stays missing; the request neither invents a reply nor proves successful communication."@x-gmeow-english ;
    skos:example "A selected reply retains the actual heard record that prompted it."@x-gmeow-english .

gmeow:recallScopeHolderSawSpeakerHere
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "holder-side saw-speaker-here recall scope"@x-gmeow-english ;
    skos:definition "A shared specification requesting holder-side seen-act records of the actual current speaker at the source-supported current place."@x-gmeow-english ;
    gmeow:useWhen "Use when both the speaker and current place have actual source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing an observed act from speech attribution or current location alone."@x-gmeow-english ;
    gmeow:howToUse "Supply lens/domain, state/exchange, speaker, actual seen-act/actor/place links and source order; retain any interpreted spatial and temporal frames."@x-gmeow-english ;
    skos:scopeNote "Unknown place is not a wildcard. The request proves neither perception nor frame conversion."@x-gmeow-english ;
    skos:example "The same speaker’s acts elsewhere do not satisfy a request bound to this actual place."@x-gmeow-english .

gmeow:recallScopeHolderLastOfOtherPairMember
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "holder-side last-of-other-pair-member recall scope"@x-gmeow-english ;
    skos:definition "A shared specification requesting the newest holder-side heard record and newest seen-act record of the unique pair member other than the current speaker."@x-gmeow-english ;
    gmeow:useWhen "Use for the explicitly supplied other member of a two-Agent pair."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a default member when the speaker is unknown or outside the pair, or one newest record across both categories."@x-gmeow-english ;
    gmeow:howToUse "Supply lens/domain, current exchange/speaker, two distinct pair Agents and actual source order; require the speaker to be a member."@x-gmeow-english ;
    skos:scopeNote "Heard and seen records are selected separately. No global latest order or missing record is manufactured."@x-gmeow-english ;
    skos:example "A request about the other member keeps distinct newest heard and seen records."@x-gmeow-english .

gmeow:recallScopeHolderMemoriesOfPair
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "holder-side memories-of-pair recall scope"@x-gmeow-english ;
    skos:definition "A shared specification requesting holder-side memory records whose retained words identify both explicitly supplied pair members."@x-gmeow-english ;
    gmeow:useWhen "Use for source-supported memories naming both actual pair identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing a relationship, cohabitation, aboutness edge or third-party memory domain."@x-gmeow-english ;
    gmeow:howToUse "Supply actual lens/domain, two distinct Agent identities and their actual source name/mention evidence and matching capability."@x-gmeow-english ;
    skos:scopeNote "The pair is an explicit unordered input; no member is primary and names do not create identity links."@x-gmeow-english ;
    skos:example "Both supplied identities remain explicit while source wording is searched without fabricated links."@x-gmeow-english .

gmeow:recallScopeHolderCanonSharedPast
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "shared-canon holder-past recall scope"@x-gmeow-english ;
    skos:definition "A shared specification requesting the actual shared canon’s account concerning the holder and its shared past, including its source-identified canon record and records naming it."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly selects the shared canon independently of private memory domains."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid merging canon into either private domain or treating its account as verified history."@x-gmeow-english ;
    gmeow:howToUse "Supply the actual holder lens, shared-canon view, holder canon identity and source reference/mention evidence with its own frame."@x-gmeow-english ;
    skos:scopeNote "Canon is a separately selected source, not either mind’s records or a truth certificate."@x-gmeow-english ;
    skos:example "A request retains the canon account separately from the holder’s own memories."@x-gmeow-english .

gmeow:recallScopeHolderTrail
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "holder-side trail recall scope"@x-gmeow-english ;
    skos:definition "A shared specification requesting holder-side transition and genesis records forming the supplied trail under actual source chronology."@x-gmeow-english ;
    gmeow:useWhen "Use for the trail anchored by the actual selected locus state."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid replacing a trail with unrelated recent episodes or inventing a genesis, transition or clock."@x-gmeow-english ;
    gmeow:howToUse "Supply lens/domain, actual state/locus anchor, source record-kind bindings and source ordering/temporal interpretation."@x-gmeow-english ;
    skos:scopeNote "Source chronology is retained, not repaired. This selector creates no route, place or current-state winner."@x-gmeow-english ;
    skos:example "A request preserves the actual transitions and genesis supplied for one trail."@x-gmeow-english .

gmeow:recallScopeHolderMemoriesHere
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "holder-side memories-here recall scope"@x-gmeow-english ;
    skos:definition "A shared specification requesting holder-side memory records of the actual place resolved from the selected source locus/move evidence."@x-gmeow-english ;
    gmeow:useWhen "Use for memories of the explicitly bound current place."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating missing place as all places or inferring a location from a name."@x-gmeow-english ;
    gmeow:howToUse "Supply actual lens/domain, state/locus, Place, source location association and source order; retain frames when interpreting coordinates or times."@x-gmeow-english ;
    skos:scopeNote "The place and memory associations need actual evidence; no missing boundary, coordinate or frame is synthesized."@x-gmeow-english ;
    skos:example "A request stays bound to the source-identified place instead of broadening when its anchor is absent."@x-gmeow-english .

gmeow:recallScopeHolderWakingEntries
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
