#
# Conformance case: kind-hierarchy (legacy OWL/gUFO form)
# Equivalent constructs to input.logic.ttl using owl:* and gufo: vocabulary.
# adapt_legacy_source must produce the same IR as parse_logic_source on input.logic.ttl.

@prefix gufo:  <http://purl.org/nemo/gufo#> .
@prefix ex:    <https://example.org/kind-hierarchy/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

# Sorts via gUFO stereotypes
ex:Animal   a gufo:Kind .
ex:Mammal   a gufo:SubKind .
ex:Dog      a gufo:SubKind .
ex:Pet      a gufo:Role .

# Subsumption chain
ex:Dog    rdfs:subClassOf ex:Mammal .
ex:Mammal rdfs:subClassOf ex:Animal .

# Role applies to the Kind
ex:Pet rdfs:subClassOf ex:Animal .
