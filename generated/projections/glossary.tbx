      <termEntry id="c-5e9112555297097f">
        <langSet xml:lang="en">
          <tig>
            <term>Information Criterion</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Critère d'information</term>
          </tig>
