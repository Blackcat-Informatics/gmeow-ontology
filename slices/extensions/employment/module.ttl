@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:Employment
    a logic:SubKind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "Employment"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Membership ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:employmentType ;
            owl:someValuesFrom gmeow:EmploymentType ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:membershipMember ;
            owl:allValuesFrom gmeow:Person ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty gmeow:membershipOrganization ;
            owl:someValuesFrom gmeow:Organization ;
        ] ;
    skos:definition "A reified employment relationship between a natural person and an organization, optionally founded on an employment contract and bearing a role, compensation, and employment type over a period. A specialization of gmeow:Membership: the employment-specific facets (compensation, seniority, employment type) are added here; the structural spine (member, organization, role, period) is inherited. On an Employment every member is a gmeow:Person (a narrowing of the inherited gmeow:Agent member range) — organizations affiliate through other Membership subtypes such as partnership or consortium membership, not employment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:EmploymentType
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "Employment Type"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of employment — a VALUE, never an Employment subclass. The set is open; a kind not among the seeds is a FRESH gmeow:EmploymentType individual carrying rdfs:label. Pointed at by gmeow:employmentType."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:SeniorityLevel
    a logic:AbstractIndividualType ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "Seniority Level"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The seniority or rank of an employment — a VALUE, never an Employment subclass. The set is open; a level not among the seeds is a FRESH gmeow:SeniorityLevel individual carrying rdfs:label. Pointed at by gmeow:employmentSeniority. Orthogonal to employment type and role."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:employmentCompensation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Employment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "employment compensation"@x-gmeow-english ;
    rdfs:range gmeow:MonetaryAmount ;
    skos:definition "The monetary compensation of an employment, expressed as a MonetaryAmount with explicit currency frame (Principle 11). Non-functional: a single employment may have several compensation figures over time (raises, bonuses, multi-currency arrangements), recorded as co-equal standpoint-indexed claims."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:employmentInterval
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Employment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "employment interval"@x-gmeow-english ;
    rdfs:range gmeow:TimeInterval ;
    skos:definition "The time interval over which the employment holds. A relator carries its period this way (matching gmeow:participationInterval, gmeow:membershipInterval) rather than via gmeow:duringInterval, which is reserved for gufo:Situation-based time-scoped relations. Open-ended (no end instant) when the employment is current."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:employmentOccupation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Employment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "employment occupation"@x-gmeow-english ;
    rdfs:range gmeow:Occupation ;
    skos:definition "The occupation associated with this employment, drawn from an open vocabulary such as ESCO or SOC. Functional: an employment maps to one canonical occupation; an agent with several occupations has several employment records."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:employmentRole
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Employment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "employment role"@x-gmeow-english ;
    rdfs:range gmeow:Role ;
    rdfs:subPropertyOf gmeow:hasRole ;
    skos:definition "The role borne by this employment — a job title, position, or function. Functional: an employment has one canonical role at a time; a change of role is a new employment record or a standpoint-indexed claim. Specializes gmeow:hasRole."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:employmentSeniority
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Employment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "employment seniority"@x-gmeow-english ;
    rdfs:range gmeow:SeniorityLevel ;
    skos:definition "The seniority level of an employment — one of the open gmeow:SeniorityLevel values. Functional: an employment has one canonical seniority at a time; a promotion is a new employment record or a standpoint-indexed claim. Orthogonal to employment type and role."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:employmentType
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Employment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "employment type"@x-gmeow-english ;
    rdfs:range gmeow:EmploymentType ;
    skos:definition "The kind of employment — one of the open gmeow:EmploymentType values. Functional: an employment has one canonical type at a time; a change of type is a new employment record or a standpoint-indexed claim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:employmentTypeApprentice
    a gmeow:EmploymentType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "apprentice"@x-gmeow-english ;
    skos:definition "Employment as an apprentice, combining work with structured training."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:employmentTypeContract
    a gmeow:EmploymentType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "contract"@x-gmeow-english ;
    skos:definition "Employment under a fixed-term contract."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:employmentTypeFreelance
    a gmeow:EmploymentType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "freelance"@x-gmeow-english ;
    skos:definition "Self-employed or independent contractor work."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:employmentTypeFullTime
    a gmeow:EmploymentType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "full-time"@x-gmeow-english ;
    skos:definition "Employment for the full ordinary duration of working hours."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:employmentTypeIntern
    a gmeow:EmploymentType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "intern"@x-gmeow-english ;
    skos:definition "Employment as an intern or trainee."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:employmentTypePartTime
    a gmeow:EmploymentType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "part-time"@x-gmeow-english ;
    skos:definition "Employment for less than the full ordinary duration of working hours."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:employmentTypeVolunteer
    a gmeow:EmploymentType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "volunteer"@x-gmeow-english ;
    skos:definition "Unpaid voluntary work."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:seniorityEntry
    a gmeow:SeniorityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "entry-level"@x-gmeow-english ;
    skos:definition "An entry-level or junior position."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:seniorityExecutive
    a gmeow:SeniorityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "executive"@x-gmeow-english ;
    skos:definition "An executive or C-level position."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:seniorityLead
    a gmeow:SeniorityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "lead"@x-gmeow-english ;
    skos:definition "A lead or principal position."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:seniorityMid
    a gmeow:SeniorityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "mid-level"@x-gmeow-english ;
    skos:definition "A mid-level position."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:senioritySenior
    a gmeow:SeniorityLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "senior"@x-gmeow-english ;
    skos:definition "A senior-level position."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

<https://blackcatinformatics.ca/gmeow/slices/employment>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Employment relationships, compensation, and career events (the ResumeRDF / Europass / schema.org / ESCO / CTDL superset layer).

STANDPOINT DOCTRINE. Contested facts in the employment slice — disputed tenure, rival role claims, contested termination — are standpoint-indexed claims that COEXIST, none privileged (Principle 9). A contested employment is two gmeow:accordingTo-annotated gmeow:memberOf base triples, or two reified gmeow:Employment relators each carrying gmeow:accordingTo. A withdrawn employment record is modelled with gmeow:displayable false, never deletion (Principle 10). There is NO employment-specific dispute mechanism, no primaryEmployment, no preferredJob — only the cross-cutting standpoint facility.

DOCTRINE.
  * Employment is a Membership: a reified gufo:Relator connecting an agent to an organization, optionally founded on an Agreement (Principle 4).
  * Employment events (hiring, promotion, transfer, resignation, termination) are value individuals in the EventType vocabulary, never subclasses (Principle 9).
  * Employment type (full-time, part-time, contract, intern) is an open value vocabulary, never a subclass taxonomy.
  * Compensation is a MonetaryAmount with explicit currency ReferenceFrame (Principle 11).
  * Seniority is an open value vocabulary, orthogonal to employment type and role.
  * Flat-first, reify on demand: a flat gmeow:memberOf covers the 80% case; promote to gmeow:Employment when type, compensation, seniority, or provenance matters.
  * Reuse: Membership, Role, Occupation, Agreement, Event/Participation, MonetaryAmount, Credential, Skill, LanguageProficiency."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "GMEOW Employment Module"@x-gmeow-english ;
    skos:definition "The GMEOW Employment Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:employmentOccupationFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/employment> ;
    rdfs:label "employmentOccupation is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:employmentOccupation is functional: an employment maps to exactly one canonical occupation, so an agent holding several occupations is recorded as several employment records rather than one employment carrying many occupations."@x-gmeow-english ;
    logic:characterizes gmeow:employmentOccupation ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:employmentOccupation ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:employmentOccupation names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:employmentOccupation, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:employmentOccupation and nothing else. It is not a definition of gmeow:employmentOccupation (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:employmentOccupationFunctionality logic:characterizes gmeow:employmentOccupation ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
