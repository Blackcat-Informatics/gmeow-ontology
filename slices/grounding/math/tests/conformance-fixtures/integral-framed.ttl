#
# Well-formed: an integral naming its integrand (a measurable function), its
# integration domain, and the measure it integrates against. Conforms to
# math:IntegralShape. Bound by ex:ecIntegralFramed.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:anIntegral a math:Integral ;
    math:integrand ex:densityFn ;
    math:integrationDomain ex:space ;
    math:withRespectTo ex:mu .

ex:densityFn a math:MeasurableFunction ;
    math:domain ex:domainSet ;
    math:codomain ex:codomainSet .

ex:mu a math:Measure ;
    math:measureOn ex:space ;
    math:totalMass 1 .

ex:space a math:MeasurableSpace .
ex:domainSet a math:Set .
ex:codomainSet a math:Set .
