    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "result_shape_composition" .

gmeow:stage-export-matrix
    a gmeow:PipelineStage ;
