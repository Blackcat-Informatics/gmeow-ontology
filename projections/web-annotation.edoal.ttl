@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/web-annotation> a align:Alignment ;
    rdfs:label "GMEOW → web-annotation (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "Tagging relator → oa:Annotation (body/target/motivatedBy)"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Tagging ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri oa:Annotation ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnTaggingToAnnotation ] ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "web-annotation" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@en .
