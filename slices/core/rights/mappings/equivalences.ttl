# --- schema.org rights cluster (also EDOAL-declared via the projection) --- #

gmeow:Trademark skos:relatedMatch schema:Brand {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "the trademark RIGHT relates to (is not) the brand it protects"
|} .

gmeow:hasPermission skos:relatedMatch cc:permits {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "CC REL permits (the licence-level allowed actions)"
|} .

gmeow:hasDuty skos:relatedMatch cc:requires {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "CC REL requires (the licence-level required actions)"
|} .

gmeow:hasProhibition skos:relatedMatch cc:prohibits {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "CC REL prohibits (the licence-level forbidden actions)"
|} .

