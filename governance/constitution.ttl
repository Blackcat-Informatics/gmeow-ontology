# Principle 17 enforcement — the logic EPIC has landed.
# The design-stage `meta:practice-logic-design` placeholder is retired and
# replaced by the three real gates promised in its retirement comment: the
# conformance corpus (the native Rust solver ≡ the committed goldens), the
# logic→OWL/Datalog/N3/gUFO round-trip, and the gUFO foundation downcast.
# Rust is the reasoning authority (the "maximally use Rust" doctrine); the
# Python oracle is a secondary validator (test_logic_oracle_engine_parity.py).
meta:gate-logic-conformance a meta:Gate ;
    rdfs:label "the logic: conformance corpus — native solver ≡ committed goldens (Principle 7/17)"@x-gmeow-english ;
    meta:artifact "crates/conformance/src/discover.rs", "crates/conformance/src/run.rs",
        "crates/conformance/tests/conformance.rs", "conformance/logic/README.md" ;
    meta:symbol "discover_cases", "run_case" ;
    meta:makeTarget "conformance" .

meta:gate-logic-round-trip a meta:Gate ;
    rdfs:label "logic→OWL DL/EL, Datalog, N3, gUFO projection round-trip isomorphism + preservation ledger"@x-gmeow-english ;
    meta:artifact "crates/logic-compile/src/projections/text.rs", "crates/logic-compile/src/projections/report.rs" ;
    meta:symbol "build_projection_report" .

meta:gate-foundation-conformance a meta:Gate ;
    rdfs:label "gUFO foundation downcast ≡ reasoning_lint verdicts — native Rust evaluator"@x-gmeow-english ;
    meta:artifact "crates/logic/src/foundation.rs" ;
    meta:symbol "evaluate" .

meta:gate-logic-gufo-superset a meta:Gate ;
    rdfs:label "gmeow:logic ⊇ gUFO floor — every gUFO class has a logic: correspondence"@x-gmeow-english ;
    meta:artifact "crates/logic/tests/gufo_superset.rs", "crates/logic-compile/src/adapter.rs" ;
    meta:symbol "GUFO_CLASS_TO_LOGIC", "every_gufo_class_has_logic_correspondence" .

# Principle 18 enforcement — the native reasoning authority. The native
# EL/DL lane is the Java/Docker-free authoritative gate and the SINGLE reasoning
# authority; the divergence ledger is built from native results ONLY and enforces
# native gap-zero DL⊇EL coverage. There is no live second reasoner on-gate: the
# native-vs-purrdf differential oracle was retired, and only committed
# engine-independent goldens remain as external evidence.
meta:gate-reason-native a meta:Gate ;
    rdfs:label "native Docker-free EL/DL reasoning authority (reason --mode native)"@x-gmeow-english ;
    meta:artifact "crates/logic/src/reason/mod.rs" ;
    meta:symbol "reason_all" ;
    meta:makeTarget "reason" ;
    meta:cliCommand "reason" .

meta:gate-dl-el-crosscheck a meta:Gate ;
    rdfs:label "native gap-zero divergence ledger — native-built DL⊇EL gap-zero artifact, computed from native results only (no external oracle)"@x-gmeow-english ;
    meta:artifact "crates/pipeline/src/stages/reason.rs", "generated/logic/dl-el-crosscheck-report.ttl" ;
    meta:symbol "ReasonStage" ;
    meta:generator "reason" .

# The anti-regression SUPERSET meta-gate (criterion 3): the native-decided
# construct set must be a SUPERSET of the frozen external OWL 2 DL oracle's. Any
# inconsistency or unsatisfiable class the frozen gold caught that the native
# reasoner MISSES is a coverage REGRESSION and FAILS. The witness is a COMMITTED
# engine-independent golden, proven OFFLINE by the frozen oracle-gold conformance
# lane (native ⊇ the frozen external OWL 2 DL oracle over the curated DL datasets,
# no Docker/Java/network and NO live oracle) — the retired live native-vs-purrdf
# differential cross-check is gone; only this committed golden remains.
meta:gate-native-oracle-superset a meta:Gate ;
    rdfs:label "native ⊇ frozen-oracle-gold anti-regression superset gate — offline, committed engine-independent golden, no live oracle"@x-gmeow-english ;
    meta:artifact "crates/conformance/tests/dl_oracle_gold.rs",
        "coverage/external/697-dl-oracle-gold/README.md" ;
    meta:symbol "native_reasoner_is_a_superset_of_the_frozen_oracle_gold" ;
    meta:makeTarget "conformance" .

# The release-as-evidence gate: the signed `make full-release` bundle folds
# every check / conformance / SARIF / compliance / perf result as
# content-addressed `gmeow:Attestation` frames into a SEPARATE signed
# dist/gmeow.gts (never the committed Docker-free snapshot). The Rust round-trip
# test proves the fold carries the signature, the graph/attestations frames, and a
# gmeow:contentDigest per evidence blob; `make verify-release` is the consumer's
# signature + trust-policy verification path.
meta:gate-release-evidence a meta:Gate ;
    rdfs:label "release-as-evidence gate — signed full-release folds attestations into gmeow.gts, consumer-verifiable"@x-gmeow-english ;
    meta:artifact "crates/pipeline/src/stages/release.rs" ;
    meta:symbol "fold_release_bundle",
        "verify_release_bundle",
        "round_trip_carries_signature_attestations_and_blobs",
        "verify_release_bundle_accepts_a_well_formed_bundle" ;
    meta:makeTarget "full-release", "verify-release" ;
    meta:cliCommand "release-bundle", "verify-release-bundle" .

# The deterministic engine-cost measurement gate. The native reasoning engine's
# operational cost — decomposable cost vectors (rule × predicate × stratum),
# consumed steps, deterministic peak-live bytes, and the native↔golden
# verdict-agreement — is committed as a byte-stable baseline
# (bench/cost-baseline.json) and drift-gated as a gmeow.gts projection
# (generated/bench/cost-ledger.md, the stage-export-cost-ledger leaf). Integer
# counts and boolean verdicts only (no wall-clock, no peak-RSS, no total-allocation
# scalars — those are report-only), so the ledger is reproduced byte-for-byte from
# the committed baseline without ever running a benchmark; strict sync reddens
# on any count divergence. The richer honesty surface — a fresh run vs the committed
# baseline — is a cost-regression gmeow:Finding routed through the shared divergence
# ledger (content-addressed identity).
meta:gate-cost-ledger a meta:Gate ;
    rdfs:label "deterministic engine-cost ledger — cost-baseline.json → cost-ledger.md drift-gated projection (integer counts, no timings)"@x-gmeow-english ;
    meta:artifact "crates/pipeline/src/stages/bench.rs",
        "generated/bench/cost-ledger.md",
        "bench/cost-baseline.json" ;
    meta:symbol "CostLedgerStage" ;
    meta:makeTarget "sync" .

# The instruction-count corroboration lane (off-gate). iai-callgrind measures
# RETIRED INSTRUCTIONS under Valgrind Callgrind — a machine-independent, run-to-run
# stable metric that corroborates the on-gate deterministic cost gate. Off-gate
# because it needs Valgrind and the out-of-tree runner; per the measurement
# doctrine, instruction-count is CORROBORATION, not the gate.
meta:gate-bench-instructions a meta:Gate ;
    rdfs:label "iai-callgrind retired-instruction corroboration — machine-independent engine instruction counts (off-gate maint lane)"@x-gmeow-english ;
    meta:artifact "crates/logic/benches/engines_iai.rs" ;
    meta:makeTarget "maint-bench-instructions" .

# --------------------------------------------------------------------------- #
# The principles
# --------------------------------------------------------------------------- #

meta:Principle1 a meta:Principle ;
    meta:number 1 ;
    meta:title "SOTA by being SOTA" ;
    meta:enforcedBy meta:practice-rationale .

meta:Principle2 a meta:Principle ;
    meta:number 2 ;
    meta:title "RDF 1.2 / RDF\\*-first — precisely scoped" ;
    meta:enforcedBy meta:gate-statements ;
    meta:supersededInPartBy meta:Principle17 .

meta:Principle3 a meta:Principle ;
    meta:number 3 ;
    meta:title "The OWL axiom-annotation form is a generated, reasoning-lossless downcast" ;
    meta:enforcedBy meta:gate-rdf12-codec, meta:gate-statements .

meta:Principle4 a meta:Principle ;
    meta:number 4 ;
    meta:title "One canonical source; everything else a generated lossy projection" ;
    meta:enforcedBy meta:gate-generator-registry, meta:tests-narrow-waist,
        meta:gate-projection-compute-purity .

meta:Principle5 a meta:Principle ;
    meta:number 5 ;
    meta:title "Maximal superset, maximal bridging — by reference" ;
    meta:enforcedBy meta:lint-sameas-ban, meta:lint-equivalence-collapse,
        meta:tests-alignment .

meta:Principle6 a meta:Principle ;
    meta:number 6 ;
    meta:title "Greenfield — get it right, not compatible" ;
    meta:enforcedBy meta:practice-rationale .

meta:Principle7 a meta:Principle ;
    meta:number 7 ;
    meta:title "Verified by construction" ;
    meta:enforcedBy meta:gate-generator-registry .

meta:Principle8 a meta:Principle ;
    meta:number 8 ;
    meta:title "Reasoning-gated and FAIR" ;
    meta:enforcedBy meta:gate-reasoning, meta:gate-fair-metadata,
        meta:gate-compliance-report ;
    meta:supersededInPartBy meta:Principle17 .

meta:Principle9 a meta:Principle ;
    meta:number 9 ;
    meta:title "Inclusive without overtyping; anti-colonial in every direction; self-assertion is top authority" ;
    meta:enforcedBy meta:lint-no-preferred-rank, meta:tests-identity-orthogonality,
        meta:shapes-core, meta:lint-coequal-facet, meta:lint-term-naming .

meta:Principle10 a meta:Principle ;
    meta:number 10 ;
    meta:title "Suppression, never erasure" ;
    meta:enforcedBy meta:gate-suppression, meta:tests-suppression,
        meta:gate-suppression-injection, meta:tests-leak-conformance,
        meta:gate-claim-audit .

meta:Principle11 a meta:Principle ;
    meta:number 11 ;
    meta:title "Frame-relativity — values live in an explicit reference system" ;
    meta:enforcedBy meta:shapes-core, meta:tests-reference-frames,
        meta:shapes-frame-generated, meta:lint-frame-completeness .

meta:Principle12 a meta:Principle ;
    meta:number 12 ;
    meta:title "Compute outside the logic — the solver boundary" ;
    meta:enforcedBy meta:gate-reasoning, meta:lint-reasoning-invariants,
        meta:tests-reasoning, meta:gate-projection-compute-purity ;
    meta:supersededInPartBy meta:Principle17 .

meta:Principle13 a meta:Principle ;
    meta:number 13 ;
    meta:title "The product is a tool; the ontology is its engine" ;
    meta:enforcedBy meta:gate-products, meta:tests-products, meta:gate-docs-export .

meta:Principle14 a meta:Principle ;
    meta:number 14 ;
    meta:title "Grounded agent memory and claim provenance are the flagship" ;
    meta:enforcedBy meta:tests-claim-spine, meta:gate-statements,
        meta:gate-claim-audit, meta:gate-evals, meta:tests-claim-pattern .

meta:Principle15 a meta:Principle ;
    meta:number 15 ;
    meta:title "Every module earns its consumer" ;
    meta:enforcedBy meta:practice-consumer-question .

meta:Principle16 a meta:Principle ;
    meta:number 16 ;
    meta:title "A small core; everything else a published extension" ;
    meta:enforcedBy meta:gate-core-profile, meta:tests-slices,
        meta:gate-crate-layering .

meta:Principle17 a meta:Principle ;
    meta:number 17 ;
    meta:title "The logic itself is canonical — OWL is a projection of it, not its ceiling" ;
    meta:enforcedBy meta:gate-logic-conformance, meta:gate-logic-round-trip,
        meta:gate-foundation-conformance, meta:gate-logic-gufo-superset,
        meta:shapes-result-generated, meta:gate-projection-compute-purity,
        meta:gate-projection-shape-purity, meta:gate-docs-loss-lattice .

# The documentation-format loss lattice: the four docs output surfaces (live site,
# mdbook, print PDF, term snippets) are lossy projections of one shared documentation
# body-set, each carrying a preservation judgment DERIVED over a composition DAG and a
# machine-checkable capability-loss lattice — never a hand-asserted flat grade. The
# single honest per-format capability source (gmeow_docs::formats) is read by BOTH the
# print PDF's loss appendix and the carrier grounding graph, so the two match by
# construction; the A3 gate proves that table total (every capability representable XOR
# dropped) and monotone (site ⊆ mdbook ⊆ pdf ⊆ snippets in dropped capabilities). Lives
# in the pipeline crate because it reads gmeow_docs (a validate→docs edge would cycle the
# acyclic crate DAG); wired onto the crate-check gate surface.
meta:gate-docs-loss-lattice a meta:Gate ;
    rdfs:label "documentation formats are preservation-judged lossy projections over a total, monotone capability lattice"@x-gmeow-english ;
    meta:artifact "crates/pipeline/src/docs_loss_lattice.rs",
        "crates/pipeline/src/stages/docs_format_rendering.rs",
        "crates/docs/src/formats.rs",
        "slices/grounding/lang/module.ttl" ;
    meta:symbol "check_docs_loss_lattice", "fold_docs_format_loss", "renderingBook" ;
    meta:cliCommand "crate-check" ;
    meta:makeTarget "crate-check" .

# The executable single-authority + lane-purity seal, enforced by an actual gate,
# not convention. The native `logic:` reasoner is the SOLE reasoning authority on
# the primary lane. The allowed/forbidden boundary is machine-checked: COMMITTED
# engine-independent goldens (the frozen `dl_oracle_gold` corpus, the native
# gap-zero `dl-el-crosscheck-report.ttl` ledger) are ALLOWED external evidence; a
# LIVE external/second reasoner wired on-gate as a differential subsumption/
# entailment oracle (the retired native-vs-purrdf `reason-crosscheck` lane) is
# FORBIDDEN and cannot silently regrow. FAILS if a Docker/Java token reaches the
# primary path, if a required CI job invokes the oracle lane, or if any Makefile
# target re-introduces a live differential reasoning oracle gate
# (`check_differential_oracle_seal`).
meta:tests-lane-purity a meta:Gate ;
    rdfs:label "single-authority + lane-purity seal — required CI jobs + make check carry no Java/Docker and no live differential reasoning oracle"@x-gmeow-english ;
    meta:artifact "crates/validate/src/repo_static.rs" ;
    meta:symbol "check_lane_purity", "check_required_ci_jobs",
        "check_makefile_lane_purity", "check_differential_oracle_seal" ;
    meta:cliCommand "crate-check" ;
    meta:makeTarget "crate-check" .

# Computation surfaces are PROJECTIONS of the logic: canon, not extensions of
# SHACL/SPARQL: derivation/aggregation is authored in logic: and emitted to a
# generated SHACL-AF rule surface (the §1 map/reduce projection), and a query
# surface compiles INTO logic: (the §8 RDFQuery design). Two falsifiable claims:
# (i) the repo-static purity seal red-fails on a hand-authored computational
# SHACL-AF/RDFQuery construct in the authored sources lacking a logic:formalizes
# back-reference; (ii) the emitted SHACL-AF projection is a generated artifact the
# single-pass sync drift gate owns. Sharpens Principles
# 17 + 4 + 12 (no new numbered principle).
meta:gate-projection-compute-purity a meta:Gate ;
    rdfs:label "computation surfaces are projections of logic:, not extensions of SHACL/SPARQL"@x-gmeow-english ;
    meta:artifact "crates/validate/src/repo_static.rs",
        "crates/logic-compile/src/projections/shacl_af.rs",
        "generated/shacl-af/gmeow.shacl-af.ttl",
        "slices/grounding/logic/design/LOGIC-SHACL-AF.md",
        "slices/grounding/logic/design/LOGIC-RDFQUERY.md" ;
    meta:symbol "check_projection_compute_purity", "project_shacl_af" ;
    meta:cliCommand "crate-check", "sync" ;
    meta:makeTarget "crate-check", "sync" .

# The shape-half peer of gate-projection-compute-purity: an open-world FOL axiom
# (irreflexivity / acyclicity / relatum-distinctness) is authored in the logic: canon
# and PROJECTED to generated/shapes/constraint-shapes.ttl, never hand-authored as a
# sh:sparql second source of truth. The repo-static seal red-fails on an authored
# sh:select re-encoding a migrated axiom signature without a logic:formalizes
# back-reference. This realizes the sh:sparql procedural-constraint fragment of the
# shape gate (design/LOGIC-VALIDATION.md); the declarative sh:PropertyShape fragment
# follows as the remaining closed-world shapes migrate. Sharpens Principles 17 + 4.
meta:gate-projection-shape-purity a meta:Gate ;
    rdfs:label "validation constraints are projections of logic:, not hand-authored second sources"@x-gmeow-english ;
    meta:artifact "crates/validate/src/repo_static.rs",
        "crates/pipeline/src/stages/constraint_shapes.rs",
        "generated/shapes/constraint-shapes.ttl",
        "slices/grounding/logic/design/LOGIC-VALIDATION.md" ;
    meta:symbol "check_projection_shape_purity", "render_constraint_shapes" ;
    meta:cliCommand "crate-check", "sync" ;
    meta:makeTarget "crate-check", "sync" .

meta:Principle18 a meta:Principle ;
    meta:number 18 ;
    meta:title "The reference RDF-1.2 stack — complete, coherent, and Docker-free" ;
    meta:enforcedBy meta:gate-reason-native, meta:gate-dl-el-crosscheck,
        meta:gate-native-oracle-superset,
        meta:tests-lane-purity, meta:gate-release-evidence,
        meta:gate-cost-ledger, meta:gate-bench-instructions ;
