@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix nmo: <http://www.semanticdesktop.org/ontologies/2007/03/22/nmo#> .
@prefix ical: <http://www.w3.org/2002/12/cal/icaltzd#> .

# Term equivalences for the email domain — GMEOW authoring source.
# Compiled to mappings/gmeow-email.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetEmail a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-email.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/email" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Email alignments. EmailMessage is equivalent to schema:EmailMessage; the rest use skos:closeMatch (cross-type/loose) to schema.org, the Nepomuk Message Ontology (NMO), and SIOC. The reified MessageParticipant relator (issue #159) is canonical; flat from/to/cc/bcc and their schema.org/NMO counterparts are lossy projection shortcuts. Trust terms (RelayHop/AuthenticationResult/signatures) are canonical — no maintained external RDF vocabulary exists for them. MessageParticipantRole envelope/resent roles are also canonical — no external vocabulary covers them. threadSubject and subjectPrefix (issue #138) are canonical — no maintained external vocabulary exposes thread-level normalized subject or per-message prefix stripping. MessageKind and its individuals (issue #137) are canonical — no maintained external vocabulary covers DSN/ARF/MDN/auto-generated report kinds. priority, importance, precedence, autoSubmitted, readReceiptRequested, and dispositionNotificationTo (issue #137) are canonical — no maintained external vocabulary covers these behavioral header facets. MIME body-part metadata terms (MultipartBodyPart, InlinePart, MultipartType, ContentDisposition, ContentTransferEncoding, hasMultipartType, hasInlinePart, hasContentDisposition, hasContentTransferEncoding, partId, contentId, charset; issue #133) are canonical — no maintained external RDF vocabulary covers granular MIME structure, Content-ID, transfer encoding, or disposition values. Mailbox hierarchy terms (parentMailbox, childMailbox, mailboxSortOrder, mailboxPath, mailboxTotalMessages, mailboxUnreadMessages; issue #132) are canonical — JMAP (RFC 8621) has no maintained RDF vocabulary. parentMailbox/childMailbox specialize the universal partOf/hasPart spine; path and counts are derived projection state (Principle 12). Calendar invitation bridge terms (describesEvent, calendarAttachment, calendarUid, CalendarMethod, hasCalendarMethod, messageKindCalendarInvitation; issue #139) are canonical — no maintained external RDF vocabulary covers the email→event bridge. iCalendar METHOD/UID alignments are by reference to icaltzd. Email versioning terms (EmailPatchDiff, hasPatchDiff, messageIdGenerated, messageIdCollision, canonicalFingerprint, bodyLineFingerprint, analysisScope, analysisInputBodyLine; issue #136) are canonical — no maintained external vocabulary covers Message-ID collision tracking, body-line fingerprinting, or email patch-diff artifacts. Canonical/variant status is represented via the cross-cutting VersionMembership relator from versions.ttl (#161), not as email-specific subclasses." .

gmeow:eqEmail001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:EmailMessage ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject schema:EmailMessage ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:sssomFile "gmeow-email.sssom.tsv" .

gmeow:eqEmail002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:EmailMessage ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject nmo:Email ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:sssomFile "gmeow-email.sssom.tsv" .

gmeow:eqEmail003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:EmailMessage ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sioc:Post ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:sssomFile "gmeow-email.sssom.tsv" .

