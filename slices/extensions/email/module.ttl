    rdfs:label "filename"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "The filename of an attachment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:from
    a owl:ObjectProperty ;
