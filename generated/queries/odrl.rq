        FILTER NOT EXISTS { ?coGt gmeow:displayable false . }
    }
    UNION {
        ?coGteq gmeow:constraintOperator gmeow:operatorGteq .
        FILTER NOT EXISTS { ?coGteq gmeow:displayable false . }
    }
    UNION {
        ?coHasPart gmeow:constraintOperator gmeow:operatorHasPart .
        FILTER NOT EXISTS { ?coHasPart gmeow:displayable false . }
    }
    UNION {
        ?coIsA gmeow:constraintOperator gmeow:operatorIsA .
        FILTER NOT EXISTS { ?coIsA gmeow:displayable false . }
    }
    UNION {
        ?coIsAllOf gmeow:constraintOperator gmeow:operatorIsAllOf .
        FILTER NOT EXISTS { ?coIsAllOf gmeow:displayable false . }
    }
    UNION {
        ?coIsAnyOf gmeow:constraintOperator gmeow:operatorIsAnyOf .
        FILTER NOT EXISTS { ?coIsAnyOf gmeow:displayable false . }
    }
    UNION {
        ?coIsNoneOf gmeow:constraintOperator gmeow:operatorIsNoneOf .
        FILTER NOT EXISTS { ?coIsNoneOf gmeow:displayable false . }
    }
    UNION {
        ?coIsPartOf gmeow:constraintOperator gmeow:operatorIsPartOf .
        FILTER NOT EXISTS { ?coIsPartOf gmeow:displayable false . }
    }
    UNION {
        ?coLt gmeow:constraintOperator gmeow:operatorLt .
        FILTER NOT EXISTS { ?coLt gmeow:displayable false . }
    }
    UNION {
        ?coLteq gmeow:constraintOperator gmeow:operatorLteq .
        FILTER NOT EXISTS { ?coLteq gmeow:displayable false . }
    }
    UNION {
        ?coNeq gmeow:constraintOperator gmeow:operatorNeq .
        FILTER NOT EXISTS { ?coNeq gmeow:displayable false . }
    }
    UNION {
        ?anyrule gmeow:ruleAssignee ?p .
        FILTER NOT EXISTS { ?anyrule gmeow:displayable false . }
    }
    UNION {
        ?rs a gmeow:RightsStatement .
        ?rs gmeow:statementAbout ?asset .
        ?rs gmeow:hasPermission ?perm .
        OPTIONAL { ?perm gmeow:ruleAssignee ?permAssignee . }
        FILTER NOT EXISTS { ?rs gmeow:displayable false . }
    }
    UNION {
        ?pdRs a gmeow:RightsStatement .
        ?pdRs gmeow:hasPermission ?pdPerm .
        ?pdPerm gmeow:hasDuty ?pdDuty .
        OPTIONAL {
            ?pdRs gmeow:statementAbout ?pdAsset .
        }
        OPTIONAL { ?pdDuty gmeow:ruleAssignee ?pdAssignee . }
        FILTER NOT EXISTS { ?pdRs gmeow:displayable false . }
        FILTER NOT EXISTS { ?pdPerm gmeow:displayable false . }
    }
    UNION {
        ?rs a gmeow:RightsStatement .
        FILTER NOT EXISTS { ?rs gmeow:displayable false . }
    }
    UNION {
        ?optRs a gmeow:RightsStatement .
        FILTER NOT EXISTS { ?optRs gmeow:displayable false . }
    }
    UNION {
        ?opfRs a gmeow:RightsStatement .
        ?opfRs gmeow:conformsTo ?opfProfile .
        FILTER NOT EXISTS { ?opfRs gmeow:displayable false . }
    }
    UNION {
        ?rs a gmeow:RightsStatement .
        ?rs gmeow:statementAbout ?asset .
        ?rs gmeow:hasProhibition ?proh .
        OPTIONAL { ?proh gmeow:ruleAssignee ?prohAssignee . }
        FILTER NOT EXISTS { ?rs gmeow:displayable false . }
    }
    UNION {
        ?r a gmeow:Prohibition .
        ?r gmeow:ruleConsequence ?d .
        FILTER NOT EXISTS { ?r gmeow:displayable false . }
    }
    UNION {
        ?ouRs a gmeow:RightsStatement .
        FILTER NOT EXISTS { ?ouRs gmeow:displayable false . }
    }
}
