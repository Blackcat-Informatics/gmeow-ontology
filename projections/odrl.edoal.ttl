@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/odrl> a align:Alignment ;
    rdfs:label "GMEOW → odrl (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "conflictStrategy → odrl:conflict"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:conflictStrategy ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri odrl:conflict ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ],
        [ a align:Cell ;
            rdfs:label "ruleConsequence → odrl:consequence"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:ruleConsequence ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri odrl:consequence ] ;
            align:relation "<=" ;
            edoal:measure 7e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "odrl" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@en .
