        <langSet xml:lang="zh">
          <tig>
            <term>gmeow:methodRemoteSensing 的版本 3 别名绑定：`rmt`，与版本 2 保持不变。</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-ef4adb3e599d01d6">
