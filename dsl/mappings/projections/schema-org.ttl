    gmeow:hasMappingPattern [
        gmeow:anchor "dsSvc" ; gmeow:value "dsDate" ;
        gmeow:atom ( [ gmeow:subjectVar "dsSvc" ; gmeow:predicate gmeow:serviceShutdownDate ; gmeow:objectVar "dsDate" ] ) ;
        gmeow:edoalSource gmeow:serviceShutdownDate ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toPredicate schema:dissolutionDate ; gmeow:relation "<=" ; gmeow:confidence 0.9 ] .

# Commercial offerings: the full Offer/Service surface.
gmeow:mapSchemaOffer a gmeow:ProjectionMapping ;
    rdfs:label "makesOffer + Offering → schema:makesOffer / Offer / itemOffered"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ofAgent" ;
        gmeow:atom (
            [ gmeow:subjectVar "ofAgent" ; gmeow:predicate gmeow:makesOffer ; gmeow:objectVar "ofOffer" ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "ofOffer" ; gmeow:predicate gmeow:itemOffered ; gmeow:objectVar "ofItem" ] ) ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "ofOffer" ; gmeow:predicate gmeow:offeringProvider ; gmeow:objectVar "ofProv" ] ) ] ) ;
        gmeow:edoalSource gmeow:Offering ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the offering is REUSED as the schema:Offer node; price/availability detail is not modelled" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "ofAgent" ; gmeow:tPred schema:makesOffer ; gmeow:tObj "ofOffer" ]
            [ gmeow:tSubj "ofOffer" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:Offer ]
            [ gmeow:tSubj "ofOffer" ; gmeow:tPred schema:itemOffered ; gmeow:tObj "ofItem" ]
            [ gmeow:tSubj "ofOffer" ; gmeow:tPred schema:provider ; gmeow:tObj "ofProv" ] ) ] .

gmeow:mapSchemaServiceOffering a gmeow:ProjectionMapping ;
    rdfs:label "ServiceOffering + serviceType + areaServed → schema:Service"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "svc" ;
        gmeow:atom (
            [ gmeow:subjectVar "svc" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:ServiceOffering ]
            [ gmeow:optionalGroup (
                [ gmeow:subjectVar "svc" ; gmeow:predicate gmeow:serviceType ; gmeow:objectVar "svcTypeVal" ]
                [ gmeow:subjectVar "svcTypeVal" ; gmeow:predicate rdfs:label ; gmeow:objectVar "svcType" ] ) ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "svc" ; gmeow:predicate gmeow:areaServed ; gmeow:objectVar "svcArea" ] ) ] ) ;
        gmeow:edoalSource gmeow:ServiceOffering ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the service offering is typed schema:Service; the serviceType value collapses to its label" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "svc" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:Service ]
            [ gmeow:tSubj "svc" ; gmeow:tPred schema:serviceType ; gmeow:tObj "svcType" ]
            [ gmeow:tSubj "svc" ; gmeow:tPred schema:areaServed ; gmeow:tObj "svcArea" ] ) ] .

# The spec node, its opens/closes. The day rides a separate per-value cell
# (below) so each gmeow:DayOfWeek maps to the correct schema:DayOfWeek
# enumeration MEMBER (schema:Monday …), never a day-name string — schema's
# dayOfWeek is an enumeration, not Text.
gmeow:mapSchemaOpeningHours a gmeow:ProjectionMapping ;
    rdfs:label "OpeningHoursSpecification → schema:OpeningHoursSpecification + opens/closes"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ohOffer" ;
        gmeow:atom (
            [ gmeow:subjectVar "ohOffer" ; gmeow:predicate gmeow:hasOpeningHours ; gmeow:objectVar "ohSpec" ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "ohSpec" ; gmeow:predicate gmeow:opensAt ; gmeow:objectVar "ohOpens" ] ) ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "ohSpec" ; gmeow:predicate gmeow:closesAt ; gmeow:objectVar "ohCloses" ] ) ] ) ;
        gmeow:edoalSource gmeow:OpeningHoursSpecification ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the spec is REUSED as schema:OpeningHoursSpecification; price/validity detail is not modelled" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "ohOffer" ; gmeow:tPred schema:openingHoursSpecification ; gmeow:tObj "ohSpec" ]
            [ gmeow:tSubj "ohSpec" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:OpeningHoursSpecification ]
            [ gmeow:tSubj "ohSpec" ; gmeow:tPred schema:opens ; gmeow:tObj "ohOpens" ]
            [ gmeow:tSubj "ohSpec" ; gmeow:tPred schema:closes ; gmeow:tObj "ohCloses" ] ) ] .

# Each gmeow:DayOfWeek value maps to its schema:DayOfWeek enumeration MEMBER
# (the canonical form; the string day-name is NOT schema:dayOfWeek's type). One
# cell per day — the same explicit per-value discipline mapSchemaPlaceType uses
# for classes, since the DSL maps values to target IRIs only by enumeration.
gmeow:mapSchemaDayMonday a gmeow:ProjectionMapping ;
    rdfs:label "openingDay Monday → schema:dayOfWeek schema:Monday"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "dwMonSpec" ;
        gmeow:atom ( [ gmeow:subjectVar "dwMonSpec" ; gmeow:predicate gmeow:openingDay ; gmeow:objectValue gmeow:dayMonday ] ) ;
        gmeow:edoalSource gmeow:openingDay ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:relation "=" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "dwMonSpec" ; gmeow:tPred schema:dayOfWeek ; gmeow:tObjValue schema:Monday ] ) ] .

gmeow:mapSchemaDayTuesday a gmeow:ProjectionMapping ;
    rdfs:label "openingDay Tuesday → schema:dayOfWeek schema:Tuesday"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "dwTueSpec" ;
        gmeow:atom ( [ gmeow:subjectVar "dwTueSpec" ; gmeow:predicate gmeow:openingDay ; gmeow:objectValue gmeow:dayTuesday ] ) ;
        gmeow:edoalSource gmeow:openingDay ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:relation "=" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "dwTueSpec" ; gmeow:tPred schema:dayOfWeek ; gmeow:tObjValue schema:Tuesday ] ) ] .

