#
# Conformance case: enactment/cc3-capability-absent
# The capability is NOT available. The step is blocked and the gap carries a
# COMPLETE eight-field proposal. What must not appear anywhere in this case is a
# weaker substitute, an invented tool call, or a step marked complete with empty
# output — each of which converts an absent capability into a silent quality
# loss that surfaces much later as unexplained bad data.
#
# Both answers are DERIVED. No logic:entryLabel is asserted: the blocked entry
# carries the waiting position and its action, the operational gap stands on that
# same action, and the shipped rules named in profile.json reach BOTH the frontier
# label and the typed refinement rejection that names the missing capability.
# That second conclusion is the one an operator acts on — it says WHICH capability
# is absent, which is what a proposal is for.
#
# The entry awaits nothing, and the whole shipped rule set is loaded, so the
# absence of logic:FrontierWaitingOnEventTimeOrInput in the golden is a fact about
# this data rather than about which rules were present: a step blocked by a
# capability the deployment does not have awaits nothing, because what is absent
# does not arrive.

@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix e:     <https://blackcatinformatics.ca/gmeow/conformance/enactment/> .

e:ingest a logic:Plan ;
    logic:planGoal e:textExtracted ;
    logic:planSuccessMode logic:StrongCyclicPlanSuccess ;
    logic:prescriptionKind logic:prescriptionKindIngestion .
e:textExtracted a gmeow:Goal ; rdfs:label "Scanned pages ingested with text"@x-gmeow-english .
e:ingestV2 a logic:PrescriptionVersion ;
    logic:prescriptionOf e:ingest ;
    logic:prescriptionDigest "b3:2d94c015af38be6701c5a97d3be0284fc16a509db73e28f4a061c58b39e07d2a" .
e:batch77 a logic:InputSnapshot ;
    logic:snapshotDigest "b3:6e1b93da05c7f284013ba95c780e2df46019ac35be82d740f1a5c69b03e27d18" .
e:run77 a logic:Enactment ;
    logic:enactsPrescriptionVersion e:ingestV2 ;
    logic:enactmentInputSnapshot e:batch77 ;
    logic:enactmentState logic:EnactmentRunning .

e:ocrStep a logic:TransactionStep ; rdfs:label "Extract text"@x-gmeow-english .
e:ocrCapability a logic:EngineCapability ; rdfs:label "OCR over page images"@x-gmeow-english .

e:frontier77 a logic:ActionableFrontier ;
    logic:frontierSaturationWitness e:sat77 ;
    logic:frontierOfEnactment e:run77 ;
    logic:hasFrontierEntry e:eOcrBlocked .

# The witness is a logic:SaturationWitness, never a logic:FrontierEntry: it is a
# claim ABOUT the roster, not a member of it, and one typed as an entry becomes a
# phantom row an operator can be asked to perform.
e:sat77 a logic:SaturationWitness ;
    rdfs:label "Saturation witness — the frontier predicates reached fixpoint within budget"@x-gmeow-english ;
    logic:settledPredicate logic:hasFrontierEntry, logic:entryLabel,
                           logic:entryAxisWitness, logic:entryAction ;
    logic:consumedBudget "32"^^xsd:nonNegativeInteger ;
    logic:resultEvaluation logic:EvaluationCompleted .

# Waiting on the step axis, and NAMING its action. The action is the join the
# blocked-on-capability rule needs: without it the entry is just waiting, and
# waiting on a capability the deployment does not have is a different instruction
# from waiting on an input that is on its way.
e:eOcrBlocked a logic:FrontierEntry ;
    logic:entryAction e:ocrStep ;
    logic:entryAxisWitness logic:StepWaiting .

# An operational gap — a capability the deployment does not HAVE. Deliberately
# not a reasoning-profile gap, which is a claim about what a fragment can EXPRESS.
e:gap a logic:OperationalCapabilityGap ;
    logic:gapBlockedStep e:ocrStep .

e:proposal a logic:CapabilityGapProposal ;
    logic:proposalMissingCapability e:ocrCapability ;
    logic:proposalRequiredContract "Page image in, positioned text out, with per-token confidence."@x-gmeow-english ;
    logic:proposalExpectedInputs "Rasterised page images, 300dpi or better."@x-gmeow-english ;
    logic:proposalExpectedOutputs "Per-page text with bounding boxes and confidence."@x-gmeow-english ;
    logic:proposalExpectedEffects "Reads batch images and writes text alongside; no mutation of sources."@x-gmeow-english ;
    logic:proposalVerificationMethod "Character error rate below 2% on the committed ground-truth set."@x-gmeow-english ;
    logic:proposalSecurityLifecycle "Runs inside the data boundary; retains no page content after extraction."@x-gmeow-english ;
    logic:proposalBlockedStep e:ocrStep .
