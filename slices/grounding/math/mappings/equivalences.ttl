    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqMathProbabilityMeasure a gmeow:TermEquivalence ;
    gmeow:alignSubject math:ProbabilityMeasure ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q355020 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "probability measure" ;
    gmeow:comment "math:ProbabilityMeasure is a measure of total mass one; wd:Q355020 (probability measure) is the same concept. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqMathMeasurableFunction a gmeow:TermEquivalence ;
    gmeow:alignSubject math:MeasurableFunction ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q516776 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
