    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:scoreSemantics, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:scoreSemantics and nothing else. It is not a definition of gmeow:scoreSemantics (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:scoreSemanticsFunctionality logic:characterizes gmeow:scoreSemantics ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:labelSetDecisionFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "labelSetDecision is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:labelSetDecision is functional: a registered label set carries exactly one decision structure — argmax-exclusive or independent-threshold — because a set that was simultaneously single-label and multi-label would make its exclusivity, and hence whether a second label crossing is a violation, undecidable. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:labelSetDecision ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:labelSetDecision ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:labelSetDecision names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:labelSetDecision, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:labelSetDecision and nothing else. It is not a definition of gmeow:labelSetDecision (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:labelSetDecisionFunctionality logic:characterizes gmeow:labelSetDecision ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# Classifier typing and closed-world required paths.
<https://blackcatinformatics.ca/gmeow/ClassifierLabel> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/memberOfLabelSet> ; logic:allValuesFrom logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/ClassifierOutput> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/classifiedTarget> ; logic:allValuesFrom logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/ClassifierOutput> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/classifierScore> ; logic:allValuesFrom <http://www.w3.org/2001/XMLSchema#decimal> ] .
<https://blackcatinformatics.ca/gmeow/ClassifierOutput> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/emittedLabel> ; logic:allValuesFrom logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/ClassifierOutput> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/producedBy> ; logic:allValuesFrom logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/ClassifierOutput> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/scoreSemantics> ; logic:allValuesFrom logic:Thing ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierLabel> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/memberOfLabelSet" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierOutput> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/classifiedTarget" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierOutput> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/classifierScore" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierOutput> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/emittedLabel" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierOutput> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/producedBy" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierOutput> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/scoreSemantics" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
gmeow:ModelInferenceRun logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:modelIdentifier ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( xsd:string xsd:token ) ] ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:modelRevision ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( xsd:string xsd:token ) ] ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelInferenceRun ; logic:closureKey "https://blackcatinformatics.ca/gmeow/modelIdentifier" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelInferenceRun ; logic:closureKey "https://blackcatinformatics.ca/gmeow/modelRevision" ; logic:closureValue logic:ClosedWorldClosure ] .

# One output is one score cell; property-characteristic carriers govern shared relations.
gmeow:ClassifierOutput logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:emittedLabel ; logic:allValuesFrom gmeow:ClassifierLabel ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:producedBy ; logic:allValuesFrom gmeow:ModelInferenceRun ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:scoreSemantics ; logic:allValuesFrom gmeow:ScoreSemantics ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:classifiedTarget ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:emittedLabel ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:classifierScore ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:thresholdApplied ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] .
gmeow:ClassifierLabel logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:memberOfLabelSet ; logic:allValuesFrom gmeow:ClassifierLabelSet ] .
gmeow:ModelInferenceRun logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:runLabelSet ; logic:allValuesFrom gmeow:ClassifierLabelSet ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:runLabelSet ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:hypothesisTemplate ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:hypothesisTemplate ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:labelSetRevision ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( xsd:string xsd:token ) ] ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:labelSetRevision ; logic:maxQualifiedCardinality 1 ; logic:onDataRange [ a rdfs:Datatype ; logic:unionOf ( xsd:string xsd:token ) ] ] .

gmeow:RegisteredClassifierLabelSet
    a logic:SubKind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Registered Classifier Label Set"@x-gmeow-english ;
    skos:definition "A static classifier registry admitted with a reviewed decision rule, specializing ClassifierLabelSet. The required labelSetDecision applies to this class only, never to every run-scoped candidate set."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:ClassifierLabelSet ,
        [ a logic:Restriction ; logic:onProperty gmeow:labelSetDecision ; logic:allValuesFrom gmeow:LabelSetDecisionRule ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RegisteredClassifierLabelSet ; logic:closureKey "https://blackcatinformatics.ca/gmeow/labelSetDecision" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:ZeroShotTemplatePresentConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Zero-shot template-present constraint"@x-gmeow-english ;
    skos:definition "An execution record named by an output declaring scoreEntailment must preserve its exact hypothesisTemplate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes gmeow:ModelInferenceRun ;
    logic:message "An execution record named by an output declaring scoreEntailment must preserve its exact hypothesisTemplate." ;
    logic:integrity logic:classifierZeroTemplateForall .
logic:classifierZeroTemplateForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "out" ] ;
    logic:forall logic:classifierZeroTemplateImpl .
logic:classifierZeroTemplateImpl a logic:Formula ; logic:antecedent logic:classifierZeroTemplateGuard ; logic:consequent logic:classifierZeroTemplateExists .
logic:classifierZeroTemplateGuard a logic:Formula ; logic:and logic:classifierZeroTemplateGuard0 , logic:classifierZeroTemplateGuard1 , logic:classifierZeroTemplateGuard2 .
logic:classifierZeroTemplateGuard0 a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ModelInferenceRun ] .
logic:classifierZeroTemplateGuard1 a logic:Formula ; logic:relation gmeow:producedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:classifierZeroTemplateGuard2 a logic:Formula ; logic:relation gmeow:scoreSemantics ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out" ] , [ logic:termIndex 1 ; logic:termIri gmeow:scoreEntailment ] .
logic:classifierZeroTemplateExists a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "template" ] ; logic:exists logic:classifierZeroTemplateRequired .
logic:classifierZeroTemplateRequired a logic:Formula ; logic:relation gmeow:hypothesisTemplate ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "template" ] .

gmeow:ClassifierRunLabelMembershipConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Classifier run label-membership constraint"@x-gmeow-english ;
    skos:definition "If an execution record explicitly declares runLabelSet, every label emitted by an output attributed to that record must belong to that set."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes gmeow:ModelInferenceRun ;
    logic:message "If an execution record explicitly declares runLabelSet, every label emitted by an output attributed to that record must belong to that set." ;
    logic:integrity logic:classifierRunMembershipForall .
logic:classifierRunMembershipForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] , [ logic:termIndex 2 ; logic:termVariable "out" ] , [ logic:termIndex 3 ; logic:termVariable "label" ] ;
    logic:forall logic:classifierRunMembershipImpl .
logic:classifierRunMembershipImpl a logic:Formula ; logic:antecedent logic:classifierRunMembershipGuard ; logic:consequent logic:classifierRunMembershipRequired .
logic:classifierRunMembershipGuard a logic:Formula ; logic:and logic:classifierRunMembershipGuard0 , logic:classifierRunMembershipGuard1 , logic:classifierRunMembershipGuard2 , logic:classifierRunMembershipGuard3 .
logic:classifierRunMembershipGuard0 a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ModelInferenceRun ] .
logic:classifierRunMembershipGuard1 a logic:Formula ; logic:relation gmeow:runLabelSet ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] .
logic:classifierRunMembershipGuard2 a logic:Formula ; logic:relation gmeow:producedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:classifierRunMembershipGuard3 a logic:Formula ; logic:relation gmeow:emittedLabel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out" ] , [ logic:termIndex 1 ; logic:termVariable "label" ] .
logic:classifierRunMembershipRequired a logic:Formula ; logic:relation gmeow:memberOfLabelSet ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "label" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] .

# Contract-bound retrieval segmentation and whole-source atomic block coordinates.

gmeow:Chunking
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Chunking"@x-gmeow-english ;
    skos:definition "One recorded segmentation of an exact source revision under an identified frozen contract. Source and contract artifacts retain their own content digests; the selected pins are distinct from any digest of this enclosing result record. Granularity and ordered member chunks describe this segmentation without assuming overlap or exhaustive coverage policies."@x-gmeow-english ;
    gmeow:useWhen "Use to retain one segmentation of a named source revision under a frozen rules artifact."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a result record as its source, its rules artifact or proof of complete source coverage."@x-gmeow-english ;
    gmeow:howToUse "Name chunkingSource and chunkingRulesArtifact, retain their selected digest pins and hasGranularity, and link selected chunks through inChunking."@x-gmeow-english ;
    skos:scopeNote "This InformationObject records a segmentation. Member ordinals and represented block extents do not impose overlap, consecutive ordering or exhaustive coverage policies."@x-gmeow-english ;
    skos:example "ex:segmentation a gmeow:Chunking ; gmeow:chunkingSource ex:revision ; gmeow:chunkingRulesArtifact ex:rules ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ChunkingMember
    a logic:Role , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Chunking Member"@x-gmeow-english ;
    skos:definition "The role of an actual contiguous Chunk selected into one Chunking. Its ordinal belongs to that chunking, and chunkOf identifies the exact carrier cut by its source-coordinate bounds. A different segmentation uses fresh chunk identities; this role does not turn every existing Chunk into a contract-bound member."@x-gmeow-english ;
    gmeow:useWhen "Use for an actual contiguous Chunk selected into one recorded chunking."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid applying this role to every Chunk or reusing a chunk identity for a different segmentation."@x-gmeow-english ;
    gmeow:howToUse "Link inChunking to the selected result, retain entryOrdinal, chunkOf and span bounds, and identify covered atomic occurrences through coversBlockExtent."@x-gmeow-english ;
    skos:scopeNote "The ordinal is scoped to the selected chunking. chunkOf names the carrier containing the retrieved text; derivation from another artifact does not change that carrier."@x-gmeow-english ;
    skos:example "ex:member a gmeow:ChunkingMember ; gmeow:inChunking ex:segmentation ; gmeow:chunkOf ex:revision ."@x-gmeow-english ;
    logic:subClassOf gmeow:Chunk ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:BlockExtent
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Block Extent"@x-gmeow-english ;
    skos:definition "A recorded whole-source extent of one ContentBlock in one exact source carrier. extentSource fixes the coordinate origin; spanStart and spanEnd retain the existing zero-based half-open Unicode-code-point semantics. These are not offsets local to the block or its division. This record supplies coordinates for atomic-boundary checks without redefining the block’s structural identity."@x-gmeow-english ;
    gmeow:useWhen "Use to locate a structural ContentBlock in an exact whole-source coordinate frame."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting block-local offsets or treating the extent record as the structural block itself."@x-gmeow-english ;
    gmeow:howToUse "Name extentOfBlock and extentSource, then retain spanStart and spanEnd in that carrier’s zero-based, half-open Unicode-code-point frame."@x-gmeow-english ;
    skos:scopeNote "This InformationObject supplies represented coordinates for boundary laws. Its presence does not certify that every block in the source has an extent record."@x-gmeow-english ;
    skos:example "ex:extent a gmeow:BlockExtent ; gmeow:extentOfBlock ex:paragraph ; gmeow:extentSource ex:revision ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:chunkingSource
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "chunking source revision"@x-gmeow-english ;
    skos:definition "The exact information artifact whose text this chunking segments, rather than a mutable work identity, location or enclosing import record."@x-gmeow-english ;
    gmeow:useWhen "Use to identify the exact information artifact segmented by a Chunking."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing at a mutable work, a location or an import wrapper in place of the actual source revision."@x-gmeow-english ;
    gmeow:howToUse "Link the result to its source InformationObject and retain the selected source digest separately with chunkingSourceDigest."@x-gmeow-english ;
    skos:scopeNote "The source artifact supplies the member carrier and whole-source coordinate origin. Naming it neither reads its bytes nor computes its digest."@x-gmeow-english ;
    skos:example "ex:segmentation gmeow:chunkingSource ex:revision ."@x-gmeow-english ;
    logic:domain gmeow:Chunking ;
    logic:range gmeow:InformationObject ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:chunkingSourceDigest
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:seeAlso gmeow:blake3_256Digest , gmeow:sha256Digest , gmeow:md5Digest ;
    rdfs:label "chunking source digest"@x-gmeow-english ;
    skos:definition "The selected contentDigest of the exact chunkingSource artifact, retained as the same complete RDF literal on this Chunking. Its lowercase hexadecimal spelling and grounded algorithm datatype both match the artifact declaration. It identifies the source bytes, not the enclosing result or its segmentation tuple. Other algorithm digests may coexist on the artifact."@x-gmeow-english ;
    logic:domain gmeow:Chunking ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( gmeow:blake3_256Digest gmeow:sha256Digest gmeow:md5Digest ) ] ;
    logic:subPropertyOf lang:literalValue ;
    gmeow:useWhen "Use to pin the exact source revision selected by a Chunking while retaining algorithm identity and the artifact witness."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting a path, IRI, the contract pin, an enclosing result digest or a scheme identifier. Equal hexadecimal text with another datatype does not satisfy this pin."@x-gmeow-english ;
    gmeow:howToUse "Copy one supplied blake3_256Digest, sha256Digest or md5Digest literal from the named chunkingSource artifact without changing its lexical form or datatype. Keep the same literal as a contentDigest on that artifact."@x-gmeow-english ;
    skos:scopeNote "The existing closed-world Chunking contract selects exactly one pin. The witness relation reuses the complete literal term; it does not strip a prefix, equate different datatypes, recompute bytes or prove contract execution. The global contentDigest property remains nonfunctional."@x-gmeow-english ;
    skos:example "ex:r gmeow:chunkingSource ex:artifact ; gmeow:chunkingSourceDigest \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"^^gmeow:sha256Digest . ex:artifact gmeow:contentDigest \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"^^gmeow:sha256Digest ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:chunkingRulesArtifact
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "chunking rules artifact"@x-gmeow-english ;
    skos:definition "The frozen rules artifact used for this segmentation and present in its creation context. It identifies the actual contract bytes, not prose describing a wrapper or a claim that the opaque contract has been executed or proved."@x-gmeow-english ;
    logic:domain gmeow:Chunking ;
    logic:range gmeow:InformationObject ;
    logic:subPropertyOf gmeow:contextIncluded ;
    rdfs:seeAlso gmeow:chunkingContractDigest ;
    gmeow:useWhen "Use to identify the exact information artifact containing the rules applied to one recorded segmentation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using an opaque configuration string, digest literal or reasoner contract in place of the actual rules artifact."@x-gmeow-english ;
    gmeow:howToUse "Link the Chunking to its frozen InformationObject. Retain the artifact’s contentDigest and select its pin with chunkingContractDigest."@x-gmeow-english ;
    skos:scopeNote "Specializes contextIncluded for the rules present in the chunking’s creation context. This artifact relation is distinct from the literal chunkingContract on an EmbeddingFamily; neither relation entails execution or verification of the rules."@x-gmeow-english ;
    skos:example "ex:segmentation gmeow:chunkingRulesArtifact ex:rules ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:chunkingContractDigest
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:seeAlso gmeow:blake3_256Digest , gmeow:sha256Digest , gmeow:md5Digest ;
    rdfs:label "chunking contract digest"@x-gmeow-english ;
    skos:definition "The selected contentDigest of the exact rules artifact linked by chunkingRulesArtifact, retained as the same complete RDF literal on this Chunking. Its lowercase hexadecimal spelling and grounded algorithm datatype both match the artifact declaration. It identifies the contract bytes, not the enclosing result or its segmentation tuple. Other algorithm digests may coexist on the artifact."@x-gmeow-english ;
    logic:domain gmeow:Chunking ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( gmeow:blake3_256Digest gmeow:sha256Digest gmeow:md5Digest ) ] ;
    logic:subPropertyOf lang:literalValue ;
    gmeow:useWhen "Use to pin the exact contract revision selected by a Chunking while retaining algorithm identity and the artifact witness."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting a path, IRI, the source pin, an enclosing result digest or a scheme identifier. Equal hexadecimal text with another datatype does not satisfy this pin."@x-gmeow-english ;
    gmeow:howToUse "Copy one supplied blake3_256Digest, sha256Digest or md5Digest literal from the artifact linked by chunkingRulesArtifact without changing its lexical form or datatype. Keep the same literal as a contentDigest on that artifact."@x-gmeow-english ;
    skos:scopeNote "The existing closed-world Chunking contract selects exactly one pin. The witness relation reuses the complete literal term; it does not strip a prefix, equate different datatypes, recompute bytes or prove contract execution. The global contentDigest property remains nonfunctional."@x-gmeow-english ;
    skos:example "ex:r gmeow:chunkingRulesArtifact ex:artifact ; gmeow:chunkingContractDigest \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"^^gmeow:sha256Digest . ex:artifact gmeow:contentDigest \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"^^gmeow:sha256Digest ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:inChunking
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "in chunking"@x-gmeow-english ;
    skos:definition "The one segmentation containing this selected chunk. Its source, contract and ordinal scope belong to that Chunking; membership is not a claim that all source text has been covered."@x-gmeow-english ;
    gmeow:useWhen "Use to select the one segmentation whose member role this chunk bears."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting membership as global chunk order, source completeness or membership in every segmentation of that source."@x-gmeow-english ;
    gmeow:howToUse "Link each ChunkingMember to its Chunking and interpret its entryOrdinal within that result."@x-gmeow-english ;
    skos:scopeNote "This relation scopes the member’s source, rules and ordinal obligations. It does not require consecutive ordinals or prohibit overlap between distinct members."@x-gmeow-english ;
    skos:example "ex:member gmeow:inChunking ex:segmentation ."@x-gmeow-english ;
    logic:domain gmeow:ChunkingMember ;
    logic:range gmeow:Chunking ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:coversBlockExtent
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "covers block extent"@x-gmeow-english ;
    skos:definition "An atomic block occurrence wholly covered by this chunk, identified through its BlockExtent and extentOfBlock. The extent must share the chunk’s exact source origin. This relation neither substitutes local block offsets nor declares exhaustive source coverage."@x-gmeow-english ;
    gmeow:useWhen "Use to record the atomic block occurrences wholly included in a selected chunk."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming coverage for an extent that is disjoint, merely touches a boundary or uses another source origin."@x-gmeow-english ;
    gmeow:howToUse "Link the ChunkingMember to each covered BlockExtent, retaining the extent’s structural block, exact carrier and whole-source bounds."@x-gmeow-english ;
    skos:scopeNote "The boundary law also examines represented extents without this relation. Omitting the relation cannot hide an intersecting split; asserted coverage does not certify exhaustive source coverage."@x-gmeow-english ;
    skos:example "ex:member gmeow:coversBlockExtent ex:extent ."@x-gmeow-english ;
    logic:domain gmeow:ChunkingMember ;
    logic:range gmeow:BlockExtent ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extentOfBlock
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "extent of block"@x-gmeow-english ;
    skos:definition "The structural ContentBlock located by this whole-source extent record. The block keeps its existing division, structural index and segment kind."@x-gmeow-english ;
    gmeow:useWhen "Use to identify the structural ContentBlock located by a BlockExtent."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid replacing the block’s division, structural index or segment kind with this coordinate record."@x-gmeow-english ;
    gmeow:howToUse "Link the extent to the existing ContentBlock and keep its whole-source carrier in extentSource."@x-gmeow-english ;
    skos:scopeNote "The relation identifies the block occurrence described by the extent. Coordinates remain on the extent; the block retains its documents-slice structure."@x-gmeow-english ;
    skos:example "ex:extent gmeow:extentOfBlock ex:paragraph ."@x-gmeow-english ;
    logic:domain gmeow:BlockExtent ;
    logic:range gmeow:ContentBlock ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extentSource
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "extent source origin"@x-gmeow-english ;
    skos:definition "The exact whole-source carrier whose Unicode-code-point origin these extent bounds use. A block-local rendering or a different revision is a different frame and cannot be compared silently with chunk bounds."@x-gmeow-english ;
    gmeow:useWhen "Use to declare the exact whole-source carrier supplying an extent’s coordinate origin."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid silently comparing bounds from different revisions or block-local and whole-source frames."@x-gmeow-english ;
    gmeow:howToUse "Link the BlockExtent to the actual source InformationObject and express both span bounds in that carrier’s Unicode-code-point coordinates."@x-gmeow-english ;
    skos:scopeNote "Covered extents use the selected chunkingSource as origin. This frame relation performs no coordinate conversion or validation against source bytes."@x-gmeow-english ;
    skos:example "ex:extent gmeow:extentSource ex:revision ."@x-gmeow-english ;
    logic:domain gmeow:BlockExtent ;
    logic:range gmeow:InformationObject ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:Chunking logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingSource ; logic:allValuesFrom gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingSource ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingSourceDigest ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( gmeow:blake3_256Digest gmeow:sha256Digest gmeow:md5Digest ) ] ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingSourceDigest ; logic:maxQualifiedCardinality 1 ; logic:onDataRange [ a rdfs:Datatype ; logic:unionOf ( gmeow:blake3_256Digest gmeow:sha256Digest gmeow:md5Digest ) ] ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingRulesArtifact ; logic:allValuesFrom gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingRulesArtifact ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingContractDigest ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( gmeow:blake3_256Digest gmeow:sha256Digest gmeow:md5Digest ) ] ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingContractDigest ; logic:maxQualifiedCardinality 1 ; logic:onDataRange [ a rdfs:Datatype ; logic:unionOf ( gmeow:blake3_256Digest gmeow:sha256Digest gmeow:md5Digest ) ] ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:hasGranularity ; logic:allValuesFrom gmeow:GranularityLevel ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Chunking ; logic:closureKey "https://blackcatinformatics.ca/gmeow/chunkingSource" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Chunking ; logic:closureKey "https://blackcatinformatics.ca/gmeow/chunkingSourceDigest" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Chunking ; logic:closureKey "https://blackcatinformatics.ca/gmeow/chunkingRulesArtifact" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Chunking ; logic:closureKey "https://blackcatinformatics.ca/gmeow/chunkingContractDigest" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Chunking ; logic:closureKey "https://blackcatinformatics.ca/gmeow/hasGranularity" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:ChunkingMember logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:inChunking ; logic:allValuesFrom gmeow:Chunking ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:inChunking ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:Chunking ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:entryOrdinal ; logic:allValuesFrom xsd:nonNegativeInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:entryOrdinal ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:nonNegativeInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkOf ; logic:allValuesFrom gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:spanStart ; logic:allValuesFrom xsd:nonNegativeInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:spanEnd ; logic:allValuesFrom xsd:nonNegativeInteger ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ChunkingMember ; logic:closureKey "https://blackcatinformatics.ca/gmeow/inChunking" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ChunkingMember ; logic:closureKey "https://blackcatinformatics.ca/gmeow/entryOrdinal" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ChunkingMember ; logic:closureKey "https://blackcatinformatics.ca/gmeow/chunkOf" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ChunkingMember ; logic:closureKey "https://blackcatinformatics.ca/gmeow/spanStart" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ChunkingMember ; logic:closureKey "https://blackcatinformatics.ca/gmeow/spanEnd" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:BlockExtent logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:extentOfBlock ; logic:allValuesFrom gmeow:ContentBlock ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:extentOfBlock ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:ContentBlock ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:extentSource ; logic:allValuesFrom gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:extentSource ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:spanStart ; logic:allValuesFrom xsd:nonNegativeInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:spanStart ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:nonNegativeInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:spanEnd ; logic:allValuesFrom xsd:nonNegativeInteger ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:spanEnd ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:nonNegativeInteger ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BlockExtent ; logic:closureKey "https://blackcatinformatics.ca/gmeow/extentOfBlock" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BlockExtent ; logic:closureKey "https://blackcatinformatics.ca/gmeow/extentSource" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BlockExtent ; logic:closureKey "https://blackcatinformatics.ca/gmeow/spanStart" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:BlockExtent ; logic:closureKey "https://blackcatinformatics.ca/gmeow/spanEnd" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:ChunkingMember logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:coversBlockExtent ; logic:allValuesFrom gmeow:BlockExtent ] .

gmeow:ChunkingSourceDigestWitnessConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Chunking source digest witness constraint"@x-gmeow-english ;
    skos:definition "The selected chunkingSourceDigest must occur as the same complete RDF literal on the exact chunkingSource artifact through contentDigest. Both lexical form and algorithm datatype must match; a digest of another artifact or the enclosing result does not satisfy this pin."@x-gmeow-english ;
    gmeow:useWhen "Use to require the selected source pin to be witnessed on the named source artifact."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid accepting a matching digest on another artifact or treating a recorded witness as byte authentication."@x-gmeow-english ;
    gmeow:howToUse "For each Chunking with chunkingSource and chunkingSourceDigest, retain the corresponding contentDigest on that exact source."@x-gmeow-english ;
    skos:scopeNote "The formula checks the recorded source/digest relation. It neither computes a hash nor selects an algorithm or a default source."@x-gmeow-english ;
    skos:example "gmeow:ChunkingSourceDigestWitnessConstraint logic:formalizes gmeow:chunkingSourceDigest ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes gmeow:Chunking , gmeow:chunkingSourceDigest ;
    logic:message "The selected chunkingSourceDigest must occur as the same complete RDF literal on the exact chunkingSource artifact through contentDigest. Both lexical form and algorithm datatype must match; a digest of another artifact or the enclosing result does not satisfy this pin." ;
    logic:integrity logic:chunkingSourceWitnessForall .
logic:chunkingSourceWitnessForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "source" ] , [ logic:termIndex 2 ; logic:termVariable "digest" ] ;
    logic:forall logic:chunkingSourceWitnessImpl .
logic:chunkingSourceWitnessImpl a logic:Formula ; logic:antecedent logic:chunkingSourceWitnessGuard ; logic:consequent logic:chunkingSourceWitnessRequired .
logic:chunkingSourceWitnessGuard a logic:Formula ; logic:and logic:chunkingSourceWitnessGuard0 , logic:chunkingSourceWitnessGuard1 , logic:chunkingSourceWitnessGuard2 .
logic:chunkingSourceWitnessGuard0 a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Chunking ] .
logic:chunkingSourceWitnessGuard1 a logic:Formula ; logic:relation gmeow:chunkingSource ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "source" ] .
logic:chunkingSourceWitnessGuard2 a logic:Formula ; logic:relation gmeow:chunkingSourceDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "digest" ] .
logic:chunkingSourceWitnessRequired a logic:Formula ; logic:relation gmeow:contentDigest ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "source" ] , [ logic:termIndex 1 ; logic:termVariable "digest" ] .

gmeow:ChunkingContractDigestWitnessConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Chunking contract digest witness constraint"@x-gmeow-english ;
    skos:definition "The selected chunkingContractDigest must occur as the same complete RDF literal on the exact rules artifact linked by chunkingRulesArtifact through contentDigest. Both lexical form and algorithm datatype must match; a digest of another artifact or the enclosing result does not satisfy this pin."@x-gmeow-english ;
    gmeow:useWhen "Use to require a digest witness on the actual rules artifact selected by the chunking."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting the result record’s digest or treating matching recorded pins as proof that rules were executed."@x-gmeow-english ;
    gmeow:howToUse "Follow chunkingRulesArtifact and retain the selected chunkingContractDigest among that artifact’s own contentDigest values."@x-gmeow-english ;
    skos:scopeNote "The formula concerns the selected rules artifact and its recorded digest. It does not execute the rules, authenticate bytes or equate an EmbeddingFamily configuration literal with an artifact."@x-gmeow-english ;
    skos:example "gmeow:ChunkingContractDigestWitnessConstraint logic:formalizes gmeow:chunkingRulesArtifact ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes gmeow:Chunking , gmeow:chunkingContractDigest , gmeow:chunkingRulesArtifact ;
    logic:message "The selected chunkingContractDigest must occur as the same complete RDF literal on the exact rules artifact linked by chunkingRulesArtifact through contentDigest. Both lexical form and algorithm datatype must match; a digest of another artifact or the enclosing result does not satisfy this pin." ;
    logic:integrity logic:chunkingContractWitnessForall .
