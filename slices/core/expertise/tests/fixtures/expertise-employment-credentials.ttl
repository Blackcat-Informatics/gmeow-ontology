#
# ABox fixture for the expertise-employment-credentials competency question
# (gmeow:cqDataFile overlay). Verbatim externalization of
# test_competency_expertise_employment_credentials_query: an employment whose
# occupation is certified by a credential.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix exd:   <https://example.org/test/> .

exd:emp1 a gmeow:Employment ;
    gmeow:employmentOccupation exd:sweOcc .

exd:sweOcc a gmeow:Occupation .

exd:cred1 a gmeow:Credential ;
    gmeow:credentialFor exd:sweOcc ;
    gmeow:credentialIssuer exd:org1 .

exd:org1 a gmeow:Organization .
