#
# Declarative structural assertions for the coreference slice (#74) -- the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_coreference.py. Each assertion runs as a
# SPARQL ASK over the coreference module graph (gmeow:scopeModule) under the
# native Rust slicetest harness (crates/slicetest).
#
# Coreference is #694-migrated: it uses no gufo: or logic: stereotypes --
# it is a pure property/annotation module with no OntoUML class sorts.
#
# RETAINED in pytest (not migratable here):
#   test_no_preferred_or_primary_coreference_terms -- iterates over 6 banned
#     IRI names and checks that none exist as OWL.Class, OWL.ObjectProperty, or
#     OWL.DatatypeProperty anywhere in the merged graph; the subject IRIs
#     (gmeow:primaryAuthority etc.) are not asserted anywhere in module.ttl so a
#     scopeModule cell would silently miss them -- whole-graph absence sweep.
#   test_authority_link_without_match_strength_warns_only -- calls run_shacl()
#     against a hand-built Graph; ExampleConformance, not a structural TBox
#     assertion.
#   test_schema_sameas_projection_requires_exact_authority_match -- calls
#     load_merged_graph + project_graph and checks projected triples; generated-
#     artifact / projection result check, not expressible as a module-scoped ASK.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest->DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/coreference/tests/> .

# --- 1. authorityLink is an owl:ObjectProperty (MUST) -------------------------
ex:saAuthorityLinkIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:authorityLink a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:authorityLink MUST be an owl:ObjectProperty -- the authority pointer is a named object relation, not a datatype assertion (#74). Mirrors test_authority_link_is_universal_open_and_not_sameas (ObjectProperty part)." .

# --- 2. authorityLink has domain gmeow:Entity (MUST) -------------------------
ex:saAuthorityLinkDomainEntity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:authorityLink rdfs:domain gmeow:Entity . }""" ;
    gmeow:saRationale "gmeow:authorityLink MUST have rdfs:domain gmeow:Entity -- only GMEOW entities link to external authority records, not literals or blank nodes. Mirrors test_authority_link_is_universal_open_and_not_sameas (domain part)." .

# --- 3. authorityLink has no rdfs:range (MUST-NOT) ---------------------------
ex:saAuthorityLinkRangeOpen a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:authorityLink rdfs:range ?r . }""" ;
    gmeow:saRationale "gmeow:authorityLink MUST NOT carry any rdfs:range -- the range is intentionally open so it can point at any external authority IRI regardless of vocabulary. Mirrors test_authority_link_is_universal_open_and_not_sameas (no-range part)." .

# --- 4. authorityLink is NOT functional (MUST-NOT) ---------------------------
ex:saAuthorityLinkNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:authorityLink a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:authorityLink MUST NOT be owl:FunctionalProperty -- an entity may link to many external authorities (Wikidata, VIAF, GeoNames etc.) simultaneously. Mirrors test_authority_link_is_universal_open_and_not_sameas (not-functional part)." .

# --- 5. authorityLink is NOT equivalentProperty of owl:sameAs (MUST-NOT) -----
ex:saAuthorityLinkNotEquivSameAs a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:authorityLink owl:equivalentProperty owl:sameAs . }""" ;
    gmeow:saRationale "gmeow:authorityLink MUST NOT be declared owl:equivalentProperty owl:sameAs -- authority links are see-also references, never identity merges (#74). Mirrors test_authority_link_is_universal_open_and_not_sameas (not-equivSameAs part)." .

# --- 6. authorityLink is NOT subPropertyOf owl:sameAs (MUST-NOT) -------------
ex:saAuthorityLinkNotSubpropertySameAs a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:authorityLink rdfs:subPropertyOf owl:sameAs . }""" ;
    gmeow:saRationale "gmeow:authorityLink MUST NOT be rdfs:subPropertyOf owl:sameAs -- authority links are see-also references, never identity merges (#74). Mirrors test_authority_link_is_universal_open_and_not_sameas (not-subproperty-sameAs part)." .

# --- 7. counterpartOf is an owl:ObjectProperty (MUST) ------------------------
ex:saCounterpartOfIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:counterpartOf a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:counterpartOf MUST be an owl:ObjectProperty -- the cross-realm link is a named object relation. Mirrors test_counterpart_preserves_link_without_identity_merge (ObjectProperty part)." .

# --- 8. counterpartOf is owl:SymmetricProperty (MUST) ------------------------
ex:saCounterpartOfIsSymmetric a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:counterpartOf a owl:SymmetricProperty . }""" ;
    gmeow:saRationale "gmeow:counterpartOf MUST be owl:SymmetricProperty -- if A is a counterpart of B then B is a counterpart of A by definition. Mirrors test_counterpart_preserves_link_without_identity_merge (SymmetricProperty part)." .

# --- 9. counterpartOf is NOT owl:TransitiveProperty (MUST-NOT) ---------------
ex:saCounterpartOfNotTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:counterpartOf a owl:TransitiveProperty . }""" ;
    gmeow:saRationale "gmeow:counterpartOf MUST NOT be owl:TransitiveProperty -- counterpart chains must not auto-collapse via transitivity; each pairing is an explicit assertion to keep contested or context-dependent claims standpoint-indexed (#74). Mirrors test_counterpart_preserves_link_without_identity_merge (not-transitive part)." .

# --- 10. counterpartOf is NOT equivalentProperty of owl:sameAs (MUST-NOT) ---
ex:saCounterpartOfNotEquivSameAs a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:counterpartOf owl:equivalentProperty owl:sameAs . }""" ;
    gmeow:saRationale "gmeow:counterpartOf MUST NOT be declared owl:equivalentProperty owl:sameAs -- counterpart links preserve cross-realm linkage without owl:sameAs merger (#74). Mirrors test_counterpart_preserves_link_without_identity_merge (not-equivSameAs part)." .

# --- 11. counterpartOf is NOT subPropertyOf owl:sameAs (MUST-NOT) ------------
ex:saCounterpartOfNotSubpropertySameAs a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:counterpartOf rdfs:subPropertyOf owl:sameAs . }""" ;
    gmeow:saRationale "gmeow:counterpartOf MUST NOT be rdfs:subPropertyOf owl:sameAs -- counterpart links preserve cross-realm linkage without owl:sameAs merger (#74). Mirrors test_counterpart_preserves_link_without_identity_merge (not-subproperty-sameAs part)." .

# --- 12. versionOf, editionOf, supersedes are owl:ObjectProperty (MUST) ------
ex:saLineageTermsAreObjectProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:versionOf   a owl:ObjectProperty .
    gmeow:editionOf   a owl:ObjectProperty .
    gmeow:supersedes  a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:versionOf, gmeow:editionOf, and gmeow:supersedes MUST all be owl:ObjectProperty -- lineage relations link entity nodes to entity nodes, never to literals. Mirrors test_universal_version_and_edition_lineage_terms (ObjectProperty part)." .

# --- 13. versionOf is owl:FunctionalProperty (MUST) --------------------------
ex:saVersionOfIsFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:versionOf a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:versionOf MUST be owl:FunctionalProperty -- a version belongs to exactly one lineage entity; the lineage may have many versions (#74). Mirrors test_universal_version_and_edition_lineage_terms (versionOf-functional part)." .

# --- 14. editionOf is owl:FunctionalProperty (MUST) --------------------------
ex:saEditionOfIsFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:editionOf a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:editionOf MUST be owl:FunctionalProperty -- a concrete edition belongs to exactly one stable work (#74). Mirrors test_universal_version_and_edition_lineage_terms (editionOf-functional part)." .

# --- 15. supersedes is NOT owl:FunctionalProperty (MUST-NOT) -----------------
ex:saSupersedesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:supersedes a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:supersedes MUST NOT be owl:FunctionalProperty -- one successor may consolidate several predecessors (non-functional by design). Mirrors test_universal_version_and_edition_lineage_terms (supersedes-not-functional part)." .

# --- 16. versionOf has domain gmeow:Entity (MUST) ----------------------------
ex:saVersionOfDomainEntity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:versionOf rdfs:domain gmeow:Entity . }""" ;
    gmeow:saRationale "gmeow:versionOf MUST have rdfs:domain gmeow:Entity -- any GMEOW entity may be versioned, not only creative works. Mirrors test_universal_version_and_edition_lineage_terms (versionOf-domain part)." .
