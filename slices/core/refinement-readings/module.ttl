gmeow:HighFrictionCountValueConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "High-friction count value constraint"@x-gmeow-english ;
    skos:definition "Each supplied correction count Quantity has valid xsd:nonNegativeInteger magnitudes with one numeric value, the dimensionless dimension and one typed ReferenceFrame; attempt counts are at least two and unsuccessful counts at least one."@x-gmeow-english ;
    skos:scopeNote "Counts are optional annotations of the same declared witness-containing population, never confidence. Equal retained lexical aliases may coexist. Frame interpretation, grouping, outcome meaning and actual aggregate truth remain source evidence obligations."@x-gmeow-english ;
    skos:example "A supplied count is validated without inventing an absent count or equating it with receipt membership."@x-gmeow-english ;
    gmeow:useWhen "Use for actual supplied counts over this reading’s declared attempt population."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid synthesizing a witness minimum, zero, counting frame, population or confidence, or adding unsupported aggregate equalities and inequalities."@x-gmeow-english ;
    gmeow:howToUse "Validate both optional roles through independent positive guards and atomic presence probes. Preserve each original magnitude, numeric aliases, actual dimension and complete frame; enforce only the declared witness bounds without recomputing counts."@x-gmeow-english ;
    logic:formalizes gmeow:HighFrictionCorrection, gmeow:frictionAttemptCount, gmeow:frictionUnsucceededCount ;
    logic:message "Each supplied correction count Quantity has valid xsd:nonNegativeInteger magnitudes with one numeric value, the dimensionless dimension and one typed ReferenceFrame; attempt counts are at least two and unsuccessful counts at least one."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "countReport" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termIri gmeow:HighFrictionCorrection ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountMagnitudeQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:frictionAttemptCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountMagnitudeQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountMagnitude" ] ;
        logic:exists [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountMagnitudeQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountMagnitude" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountTypedQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountTypedValue" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:frictionAttemptCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountTypedQuantity" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountTypedQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountTypedValue" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:termSameComponent ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountTypedValue" ], [ logic:termIndex 1 ; logic:termIri logic:componentDatatype ], [ logic:termIndex 2 ; logic:termIri xsd:nonNegativeInteger ], [ logic:termIndex 3 ; logic:termIri logic:componentWhole ] ],
                [ a logic:Formula ; logic:relation logic:termIsFiniteNumeric ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountTypedValue" ] ],
                [ a logic:Formula ; logic:relation logic:termGreaterEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountTypedValue" ], [ logic:termIndex 1 ; logic:termLiteral "2" ; logic:termLiteralDatatype xsd:nonNegativeInteger ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountFirstValue" ], [ logic:termIndex 2 ; logic:termVariable "attemptCountSecondValue" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:frictionAttemptCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountEqualQuantity" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountFirstValue" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountSecondValue" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountFirstValue" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountSecondValue" ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountDimensionQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:frictionAttemptCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountDimensionQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountDimension" ] ;
        logic:exists [ a logic:Formula ; logic:relation math:hasDimension ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountDimension" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountOnlyDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountOnlyDimension" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:frictionAttemptCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountOnlyDimensionQuantity" ] ],
                [ a logic:Formula ; logic:relation math:hasDimension ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountOnlyDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountOnlyDimension" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountOnlyDimension" ], [ logic:termIndex 1 ; logic:termIri math:dimensionless ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountFrameQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:frictionAttemptCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountFrameQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountFrame" ] ;
        logic:exists [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountFrame" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountTypedFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountTypedFrame" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:frictionAttemptCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountTypedFrameQuantity" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountTypedFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountTypedFrame" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountTypedFrame" ], [ logic:termIndex 1 ; logic:termIri gmeow:ReferenceFrame ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "attemptCountUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountFirstFrame" ], [ logic:termIndex 2 ; logic:termVariable "attemptCountSecondFrame" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:frictionAttemptCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountUniqueFrameQuantity" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountFirstFrame" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountSecondFrame" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "attemptCountFirstFrame" ], [ logic:termIndex 1 ; logic:termVariable "attemptCountSecondFrame" ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountMagnitudeQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:frictionUnsucceededCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountMagnitudeQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountMagnitude" ] ;
        logic:exists [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountMagnitudeQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountMagnitude" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountTypedQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountTypedValue" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:frictionUnsucceededCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountTypedQuantity" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountTypedQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountTypedValue" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:termSameComponent ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountTypedValue" ], [ logic:termIndex 1 ; logic:termIri logic:componentDatatype ], [ logic:termIndex 2 ; logic:termIri xsd:nonNegativeInteger ], [ logic:termIndex 3 ; logic:termIri logic:componentWhole ] ],
                [ a logic:Formula ; logic:relation logic:termIsFiniteNumeric ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountTypedValue" ] ],
                [ a logic:Formula ; logic:relation logic:termGreaterEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountTypedValue" ], [ logic:termIndex 1 ; logic:termLiteral "1" ; logic:termLiteralDatatype xsd:nonNegativeInteger ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountFirstValue" ], [ logic:termIndex 2 ; logic:termVariable "unsuccessfulCountSecondValue" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:frictionUnsucceededCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountEqualQuantity" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountFirstValue" ] ],
                [ a logic:Formula ; logic:relation math:quantityValue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountEqualQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountSecondValue" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountFirstValue" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountSecondValue" ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountDimensionQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:frictionUnsucceededCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountDimensionQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountDimension" ] ;
        logic:exists [ a logic:Formula ; logic:relation math:hasDimension ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountDimension" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountOnlyDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountOnlyDimension" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:frictionUnsucceededCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountOnlyDimensionQuantity" ] ],
                [ a logic:Formula ; logic:relation math:hasDimension ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountOnlyDimensionQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountOnlyDimension" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountOnlyDimension" ], [ logic:termIndex 1 ; logic:termIri math:dimensionless ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountFrameQuantity" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:frictionUnsucceededCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountFrameQuantity" ] ] ;
            logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountFrame" ] ;
        logic:exists [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountFrame" ] ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountTypedFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountTypedFrame" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:frictionUnsucceededCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountTypedFrameQuantity" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountTypedFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountTypedFrame" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountTypedFrame" ], [ logic:termIndex 1 ; logic:termIri gmeow:ReferenceFrame ] ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountFirstFrame" ], [ logic:termIndex 2 ; logic:termVariable "unsuccessfulCountSecondFrame" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:frictionUnsucceededCount ; logic:argument [ logic:termIndex 0 ; logic:termVariable "countReport" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountUniqueFrameQuantity" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountFirstFrame" ] ],
                [ a logic:Formula ; logic:relation gmeow:hasReferenceFrame ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountUniqueFrameQuantity" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountSecondFrame" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "unsuccessfulCountFirstFrame" ], [ logic:termIndex 1 ; logic:termVariable "unsuccessfulCountSecondFrame" ] ] ] ] ] ] ] .

gmeow:FrictionRuleParametersConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Selected correction rule parameters constraint"@x-gmeow-english ;
    skos:definition "Every ReadingRule release selected through frictionRule supplies frictionToolField, frictionArgumentsField, frictionOutcomeField and frictionUnsucceededOutcome on that same release."@x-gmeow-english ;
    skos:scopeNote "The law requires the four selected inputs without making them required on every ReadingRule. It supplies no token defaults and does not execute field lookup, duplicate-key selection or outcome interpretation."@x-gmeow-english ;
    skos:example "A selected release is incomplete when one parameter is absent, even if another release has that value."@x-gmeow-english ;
    gmeow:useWhen "Use to require the complete actual parameter tuple of a selected correction reader release."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid borrowing a missing token from another version or treating an unrelated generic ReadingRule as a selected correction profile."@x-gmeow-english ;
    gmeow:howToUse "Bind the rule object positively through frictionRule and check four independent atomic existence obligations on that same object. Preserve all supplied literals and the existing immutable release metadata."@x-gmeow-english ;
    logic:formalizes gmeow:frictionRule, gmeow:frictionToolField, gmeow:frictionArgumentsField, gmeow:frictionOutcomeField, gmeow:frictionUnsucceededOutcome ;
    logic:message "Every ReadingRule release selected through frictionRule supplies frictionToolField, frictionArgumentsField, frictionOutcomeField and frictionUnsucceededOutcome on that same release."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "parameterRule" ], [ logic:termIndex 1 ; logic:termVariable "parameterReading" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:frictionRule ; logic:argument [ logic:termIndex 0 ; logic:termVariable "parameterReading" ], [ logic:termIndex 1 ; logic:termVariable "parameterRule" ] ] ;
            logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "parameter0" ] ;
        logic:exists [ a logic:Formula ; logic:relation gmeow:frictionToolField ; logic:argument [ logic:termIndex 0 ; logic:termVariable "parameterRule" ], [ logic:termIndex 1 ; logic:termVariable "parameter0" ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "parameter1" ] ;
        logic:exists [ a logic:Formula ; logic:relation gmeow:frictionArgumentsField ; logic:argument [ logic:termIndex 0 ; logic:termVariable "parameterRule" ], [ logic:termIndex 1 ; logic:termVariable "parameter1" ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "parameter2" ] ;
        logic:exists [ a logic:Formula ; logic:relation gmeow:frictionOutcomeField ; logic:argument [ logic:termIndex 0 ; logic:termVariable "parameterRule" ], [ logic:termIndex 1 ; logic:termVariable "parameter2" ] ] ],
                [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "parameter3" ] ;
        logic:exists [ a logic:Formula ; logic:relation gmeow:frictionUnsucceededOutcome ; logic:argument [ logic:termIndex 0 ; logic:termVariable "parameterRule" ], [ logic:termIndex 1 ; logic:termVariable "parameter3" ] ] ] ] ] ] .

