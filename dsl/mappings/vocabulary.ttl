    logic:forall logic:pbpImpl .
logic:pbpImpl a logic:Formula ; logic:antecedent logic:pbpGuard ; logic:consequent logic:pbpExists .
logic:pbpGuard a logic:Formula ; logic:relation gmeow:hasBinding ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "m" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:pbpExists a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] ; logic:exists logic:pbpAtom .
logic:pbpAtom a logic:Formula ; logic:relation gmeow:profile ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .

gmeow:ProfileBindingOutputRequiredConstraint
    a logic:Constraint ;
    rdfs:label "ProfileBinding output requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:ProfileBinding declares at least one output: gmeow:toPredicate, gmeow:toClass, gmeow:templateAtoms, or gmeow:valueClassMap."@x-gmeow-english ;
    logic:formalizes gmeow:ProfileBinding ;
    logic:message "ProfileBinding must have at least one output: toPredicate, toClass, templateAtoms, or valueClassMap"@x-gmeow-english ;
    logic:integrity logic:pboForall .
logic:pboForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "m" ] ;
    logic:forall logic:pboImpl .
logic:pboImpl a logic:Formula ; logic:antecedent logic:pboGuard ; logic:consequent logic:pboOr .
logic:pboGuard a logic:Formula ; logic:relation gmeow:hasBinding ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "m" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:pboOr a logic:Formula ; logic:or logic:pboPred , logic:pboClass , logic:pboTemplate , logic:pboValueMap .
logic:pboPred a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] ; logic:exists logic:pboPredAtom .
logic:pboPredAtom a logic:Formula ; logic:relation gmeow:toPredicate ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .
logic:pboClass a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "c" ] ; logic:exists logic:pboClassAtom .
logic:pboClassAtom a logic:Formula ; logic:relation gmeow:toClass ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] .
logic:pboTemplate a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "t" ] ; logic:exists logic:pboTemplateAtom .
logic:pboTemplateAtom a logic:Formula ; logic:relation gmeow:templateAtoms ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "t" ] .
logic:pboValueMap a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "v" ] ; logic:exists logic:pboValueMapAtom .
logic:pboValueMapAtom a logic:Formula ; logic:relation gmeow:valueClassMap ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .

gmeow:ProfileBindingSssomEmitConstraint
    a logic:Constraint ;
    rdfs:label "ProfileBinding SSSOM-emission guarded requirement"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:ProfileBinding with gmeow:emitSssom true must carry gmeow:sssomPredicate and gmeow:sssomFile."@x-gmeow-english ;
    logic:formalizes gmeow:ProfileBinding ;
    logic:message "ProfileBinding with gmeow:emitSssom true must have gmeow:sssomPredicate and gmeow:sssomFile"@x-gmeow-english ;
    logic:integrity logic:pbsForall .
logic:pbsForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:pbsImpl .
logic:pbsImpl a logic:Formula ; logic:antecedent logic:pbsGuard ; logic:consequent logic:pbsAnd .
logic:pbsGuard a logic:Formula ; logic:relation gmeow:emitSssom ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ] .
logic:pbsAnd a logic:Formula ; logic:and logic:pbsPredExists , logic:pbsFileExists .
logic:pbsPredExists a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "sp" ] ; logic:exists logic:pbsPredAtom .
logic:pbsPredAtom a logic:Formula ; logic:relation gmeow:sssomPredicate ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sp" ] .
logic:pbsFileExists a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "sf" ] ; logic:exists logic:pbsFileAtom .
logic:pbsFileAtom a logic:Formula ; logic:relation gmeow:sssomFile ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sf" ] .

# --- Bind / Mint (structural: targetObjectsOf gmeow:bind, gmeow:mint) ----------- #

gmeow:BindVarRequiredConstraint
    a logic:Constraint ;
    rdfs:label "Bind/Mint variable requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every bind/mint node (the object of gmeow:bind or gmeow:mint) carries exactly one gmeow:bindVar and exactly one gmeow:bindExpr."@x-gmeow-english ;
    logic:formalizes gmeow:BindShape ;
    logic:message "Bind/Mint must have exactly one gmeow:bindVar (string) and exactly one gmeow:bindExpr"@x-gmeow-english ;
    logic:integrity logic:bvForall .
logic:bvForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] ;
    logic:forall logic:bvImpl .
logic:bvImpl a logic:Formula ; logic:antecedent logic:bvGuard ; logic:consequent logic:bvAnd .
logic:bvGuard a logic:Formula ; logic:or logic:bvBindGuard , logic:bvMintGuard .
logic:bvBindGuard a logic:Formula ; logic:relation gmeow:bind ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:bvMintGuard a logic:Formula ; logic:relation gmeow:mint ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:bvAnd a logic:Formula ; logic:and logic:bvVarExists , logic:bvExprExists .
logic:bvVarExists a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "v" ] ; logic:exists logic:bvVarAtom .
logic:bvVarAtom a logic:Formula ; logic:relation gmeow:bindVar ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .
logic:bvExprExists a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "e" ] ; logic:exists logic:bvExprAtom .
logic:bvExprAtom a logic:Formula ; logic:relation gmeow:bindExpr ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "e" ] .

# --- Expression (structural: targetSubjectsOf gmeow:exprOp / gmeow:exprVar) ----- #

gmeow:ExpressionShapeChoiceConstraint
    a logic:Constraint ;
    rdfs:label "Expression shape choice constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:Expression node carries exactly one of gmeow:exprVar (string) or the pair (gmeow:exprOp + gmeow:exprArgs)."@x-gmeow-english ;
    logic:formalizes gmeow:Expression ;
    logic:message "Expression must have exactly one of exprVar (string) or (exprOp + exprArgs)"@x-gmeow-english ;
    logic:integrity logic:excForall .
logic:excForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:excImpl .
logic:excImpl a logic:Formula ; logic:antecedent logic:excGuard ; logic:consequent logic:excXor .
logic:excGuard a logic:Formula ; logic:or logic:excOpGuard , logic:excVarGuard .
logic:excOpGuard a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "o" ] ; logic:exists logic:excOpGuardAtom .
logic:excOpGuardAtom a logic:Formula ; logic:relation gmeow:exprOp ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "o" ] .
logic:excVarGuard a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "vv" ] ; logic:exists logic:excVarGuardAtom .
logic:excVarGuardAtom a logic:Formula ; logic:relation gmeow:exprVar ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "vv" ] .
logic:excXor a logic:Formula ; logic:or logic:excOnlyVar , logic:excOpAndArgs .
logic:excOnlyVar a logic:Formula ; logic:and logic:excHasVar , logic:excNoOp , logic:excNoArgs .
logic:excOpAndArgs a logic:Formula ; logic:and logic:excNoVar , logic:excHasOp , logic:excHasArgs .
logic:excHasVar a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "v" ] ; logic:exists logic:excHasVarAtom .
logic:excHasVarAtom a logic:Formula ; logic:relation gmeow:exprVar ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .
logic:excNoVar a logic:Formula ; logic:not logic:excHasVar .
logic:excHasOp a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "op" ] ; logic:exists logic:excHasOpAtom .
logic:excHasOpAtom a logic:Formula ; logic:relation gmeow:exprOp ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "op" ] .
logic:excNoOp a logic:Formula ; logic:not logic:excHasOp .
logic:excHasArgs a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "ar" ] ; logic:exists logic:excHasArgsAtom .
logic:excHasArgsAtom a logic:Formula ; logic:relation gmeow:exprArgs ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "ar" ] .
logic:excNoArgs a logic:Formula ; logic:not logic:excHasArgs .

# --- ValueClassMap entry (structural: targetSubjectsOf gmeow:whenValue) --------- #

gmeow:ValueClassMapEntryToClassRequiredConstraint
    a logic:Constraint ;
    rdfs:label "ValueClassMap entry toClass requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every value-class map entry (a subject of gmeow:whenValue) carries exactly one gmeow:toClass."@x-gmeow-english ;
    logic:formalizes gmeow:ValueClassMapEntryShape ;
    logic:message "Value-class map entry must have exactly one gmeow:toClass (IRI)"@x-gmeow-english ;
    logic:integrity logic:vcmForall .
logic:vcmForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "wv" ] ;
    logic:forall logic:vcmImpl .
logic:vcmImpl a logic:Formula ; logic:antecedent logic:vcmGuard ; logic:consequent logic:vcmExists .
logic:vcmGuard a logic:Formula ; logic:relation gmeow:whenValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "wv" ] .
logic:vcmExists a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "c" ] ; logic:exists logic:vcmAtom .
logic:vcmAtom a logic:Formula ; logic:relation gmeow:toClass ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] .

# --- Vocabulary annotation completeness --------------------------------------- #
# gmeow:MappingDslVocabularyTermShape — mirrors
# logic:GmeowClassCompletenessConstraint / GmeowPropertyCompletenessConstraint's
# logic:sparqlTarget idiom for a raw sh:SPARQLTarget focus set, scoped to the
# mapping-dsl namespace.

gmeow:MappingDslVocabularyTermCompletenessConstraint
    a logic:Constraint ;
    rdfs:label "Mapping DSL vocabulary term completeness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every term declared in the mapping DSL vocabulary namespace (a class, object/datatype/annotation property, ontology, or datatype) carries at least one rdfs:label, one skos:definition, and rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl>."@x-gmeow-english ;
    logic:formalizes gmeow:MappingDslVocabularyTermShape ;
    logic:message "Every mapping DSL vocabulary term must carry rdfs:label, skos:definition, and rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl>."@x-gmeow-english ;
    logic:integrity logic:mdvForall .
logic:mdvForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:mdvImpl .
logic:mdvImpl a logic:Formula ; logic:antecedent logic:mdvTarget ; logic:consequent logic:mdvAnd .
logic:mdvTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral """SELECT ?this WHERE {
    ?this a ?t .
    FILTER(?t IN (
        <http://www.w3.org/2002/07/owl#Class>,
        <http://www.w3.org/2002/07/owl#ObjectProperty>,
        <http://www.w3.org/2002/07/owl#DatatypeProperty>,
        <http://www.w3.org/2002/07/owl#AnnotationProperty>,
        <http://www.w3.org/2002/07/owl#Ontology>,
        <http://www.w3.org/2000/01/rdf-schema#Datatype>
    ))
    FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
}""" ] .
logic:mdvAnd a logic:Formula ; logic:and logic:mdvLabel , logic:mdvDef , logic:mdvDefBy .
logic:mdvLabel a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "l" ] ; logic:exists logic:mdvLabelAtom .
logic:mdvLabelAtom a logic:Formula ; logic:relation rdfs:label ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "l" ] .
logic:mdvDef a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] ; logic:exists logic:mdvDefAtom .
logic:mdvDefAtom a logic:Formula ; logic:relation skos:definition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
logic:mdvDefBy a logic:Formula ; logic:relation rdfs:isDefinedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri <https://blackcatinformatics.ca/gmeow/mapping-dsl> ] .

