    [ a owl:Restriction ; owl:onProperty math:guardedByCounterExample ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:string ] ,
    [ a owl:Restriction ; owl:onProperty math:enforcesFailureClass ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

# =========================================================================== #
# Procedural constraints — projected to sh:SPARQLConstraint (the validation    #
# twin of the derivation surface). Each is a compact logic: constraint-sugar   #
# record carrying logic:formalizes, expanded by the frontend to a canonical    #
# logic:Constraint and lowered to a sh:SPARQLConstraint.                       #
# =========================================================================== #

# math:Norm — the inducing symmetric bilinear form must be positive-definite:
# ‖x‖ = √⟨x, x⟩ is a genuine norm only for a positive-definite form. A
# path-value fixed-value check: every value reached by math:inducedByForm must
# carry math:definiteness math:positiveDefinite.
math:NormPositiveDefiniteConstraint
    a logic:PathValueTypeConstraint ;
    gmeow:enforcesFailureClass math:NonPositiveDefiniteNorm ;
    logic:onClass math:Norm ;
    logic:valuePath math:inducedByForm ;
    logic:valuePredicate math:definiteness ;
    logic:valueObject math:positiveDefinite ;
    logic:formalizes math:NormPositiveDefiniteShape ;
    logic:message "A math:Norm's math:inducedByForm must be positive-definite (math:definiteness math:positiveDefinite); a norm resting on a non-positive-definite form is ill-formed (math:NonPositiveDefiniteNorm)." .

# math:LogicLoweringShape — any expression lowered to a logic:Formula through
# math:compilesToLogicFormula must declare its math:denotationKind and its
# math:logicLoweringPreservation; silent promotion is forbidden. A
# predicate-presence guarded implication (no target class — the trigger
# predicate is the range restriction, so the shape targets subjects of
# math:compilesToLogicFormula).
math:LogicLoweringDeclaredConstraint
    a logic:GuardedImplicationConstraint ;
    gmeow:enforcesFailureClass math:UndeclaredLogicLowering ;
    logic:trigger math:compilesToLogicFormula ;
    logic:requires math:denotationKind , math:logicLoweringPreservation ;
    logic:formalizes math:LogicLoweringShape ;
    logic:message "An expression lowered to a logic:Formula through math:compilesToLogicFormula must declare its math:denotationKind and its math:logicLoweringPreservation; silent promotion to a logical assertion is forbidden (math:UndeclaredLogicLowering)." .

# Typed conformance ownership for the canonical declarative projection. Each class has exactly
# one class-wide failure identity; narrower same-target obligations retain their distinct failure
# through an exact `logic:formalizes` procedural constraint below. This metadata is projected onto
# the generated validation shape, so deleting the legacy SHACL never erases diagnostic semantics.
# The shared test-DSL class is used by reasoned math acceptance data; repeat its canonical
# foundation stereotype here because the spec-layer vocabulary is deliberately not imported into
# the OWL core, while the meta-grounding verify query still sees the class through its instances.
gmeow:FlagshipScenario
    a logic:Kind ;
    rdfs:label "flagship scenario"@x-gmeow-english ;
    skos:definition "A typed acceptance-manifest object reifying one of a grounding slice's flagship acceptance scenarios and binding the worked example, competency question, native producer, guarding counter-example, and enforcing conformance-failure class that realize its depth bar. This mathematics-layer declaration carries the shared test-DSL class into the OWL reasoning carrier because the test vocabulary itself is deliberately not imported into the logical core."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Number gmeow:enforcesFailureClass math:UnsituatedNumber .
math:ApproximateValue gmeow:enforcesFailureClass math:ExactApproximateConflation .
math:MathematicalConstant gmeow:enforcesFailureClass math:ConstantAsDecimalLiteral .
math:SetBuilderExpression gmeow:enforcesFailureClass math:StringOnlyMemberCondition .
math:Complement gmeow:enforcesFailureClass math:UnqualifiedComplement .
math:Set gmeow:enforcesFailureClass math:AmbiguousSetExtent .
math:Function gmeow:enforcesFailureClass math:UnframedFunction .
math:AlgebraicStructure gmeow:enforcesFailureClass math:IncompleteAlgebraicStructure .
math:Homomorphism gmeow:enforcesFailureClass math:UnderspecifiedHomomorphism .
math:LieGroup gmeow:enforcesFailureClass math:IncompleteLieStructure .
math:RootSystem gmeow:enforcesFailureClass math:IncompleteLieStructure .
math:AutomorphismGroup gmeow:enforcesFailureClass math:UnanchoredAutomorphismGroup .
math:HomomorphicEncryptionScheme gmeow:enforcesFailureClass math:UnderspecifiedEncryptionScheme .
math:Ring gmeow:enforcesFailureClass math:NonDistributiveRing .
math:Measure gmeow:enforcesFailureClass math:IncompleteMeasure .
math:ProbabilityMeasure gmeow:enforcesFailureClass math:ProbabilityMeasureMassViolation .
math:Integral gmeow:enforcesFailureClass math:IncompleteIntegral .
math:Quantity gmeow:enforcesFailureClass math:UndimensionedQuantity .
math:DerivedDimension gmeow:enforcesFailureClass math:MalformedDimension .
math:DimensionExponent gmeow:enforcesFailureClass math:MalformedDimension .
math:DimensionalExpression gmeow:enforcesFailureClass math:MalformedDimension .
math:ArgumentSlot gmeow:enforcesFailureClass math:MalformedArgumentSlot .
math:ApplicationExpression gmeow:enforcesFailureClass math:ApplicationOperatorCardinality .
math:BindingExpression gmeow:enforcesFailureClass math:MalformedBindingExpression .
math:VariableOccurrence gmeow:enforcesFailureClass math:UnscopedVariableOccurrence .
math:Derivative gmeow:enforcesFailureClass math:UnderspecifiedDerivative .
math:Limit gmeow:enforcesFailureClass math:UnderspecifiedLimit .
math:Convergence gmeow:enforcesFailureClass math:UnderspecifiedConvergence .
math:Series gmeow:enforcesFailureClass math:UnderspecifiedConvergence .
math:Sequence gmeow:enforcesFailureClass math:UnderspecifiedConvergence .
math:ContinuousMap gmeow:enforcesFailureClass math:UndeclaredTopologicalProperty .
math:CompactSpace gmeow:enforcesFailureClass math:UndeclaredTopologicalProperty .
math:ConnectedSpace gmeow:enforcesFailureClass math:UndeclaredTopologicalProperty .
math:Manifold gmeow:enforcesFailureClass math:UnderspecifiedManifold .
math:Chart gmeow:enforcesFailureClass math:UnderspecifiedChart .
math:TangentSpace gmeow:enforcesFailureClass math:DimensionMismatch .
math:MetricSignature gmeow:enforcesFailureClass math:DimensionMismatch .
math:OrthogonalComplement gmeow:enforcesFailureClass math:UnqualifiedOrthogonalComplement .
math:PCAAnalysis gmeow:enforcesFailureClass math:IncompletePCAAnalysis .
math:ResidualInterpretationClaim gmeow:enforcesFailureClass math:ResidualMeaningAsProperty .
math:Embedding gmeow:enforcesFailureClass math:UnderspecifiedEmbedding .
math:TensorComputationGraph gmeow:enforcesFailureClass math:MalformedTensorComputationGraph .
math:WeightTensor gmeow:enforcesFailureClass math:UnframedWeightTensor .
math:Filtration gmeow:enforcesFailureClass math:UnderspecifiedFiltration .
math:FiltrationStage gmeow:enforcesFailureClass math:UnderspecifiedFiltration .
math:PersistenceLifetime gmeow:enforcesFailureClass math:UnderspecifiedPersistenceLifetime .
math:StabilityCalibrationRecord gmeow:enforcesFailureClass math:UngroundedStabilityCalibration .
math:RationalValue gmeow:enforcesFailureClass math:ZeroDenominator .
math:Norm gmeow:enforcesFailureClass math:NonPositiveDefiniteNorm .
math:GramMatrix gmeow:enforcesFailureClass math:AsymmetricGramMatrix .
math:IngestRun gmeow:enforcesFailureClass math:UngroundedIngestRun .
math:FittedModel gmeow:enforcesFailureClass math:UnfittedModel .
math:ModelFormula gmeow:enforcesFailureClass math:UnframedFunction .
math:FormalVerificationResult gmeow:enforcesFailureClass math:UngroundedVerificationResult .
math:Theorem gmeow:enforcesFailureClass math:UngroundedTheoremClaim .

