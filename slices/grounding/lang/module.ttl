gmeow:gmnCandidateMathSubtraction
    a gmeow:GmnSymbolCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: binary subtraction minus"@x-gmeow-english ;
    skos:definition "The audited structured-constructor ruling for binary math:Subtraction."@x-gmeow-english ;
    gmeow:gmnCandidateTarget math:Subtraction ;
    gmeow:gmnCandidateGlyph "−" ;
    gmeow:gmnAsciiFallback "sub" ;
