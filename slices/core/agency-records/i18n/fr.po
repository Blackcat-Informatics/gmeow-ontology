msgid "ex:descriptor gmeow:conditionVerifierKind gmeow:verifierWorldObjectExists ."
msgstr "ex:descriptor gmeow:conditionVerifierKind gmeow:verifierWorldObjectExists ."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierForegroundYield|http://www.w3.org/2000/01/rdf-schema#label"
msgid "foreground yield verifier"
msgstr "vérification de cession au premier plan"

msgctxt "https://blackcatinformatics.ca/gmeow/verifierForegroundYield|http://www.w3.org/2004/02/skos/core#definition"
msgid "Verification requiring an actual cited attempt-finish event whose attemptStop is stopYieldedToForeground and whose actor is identified. Silence, elapsed time or an interrupted code alone does not evidence a foreground yield."
msgstr "Vérification exigeant un événement réel cité de fin de tentative dont attemptStop vaut stopYieldedToForeground et dont l’acteur est identifié. Silence, temps écoulé ou code d’interruption seul ne prouvent pas cette cession."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierForegroundYield|https://blackcatinformatics.ca/gmeow/useWhen"
