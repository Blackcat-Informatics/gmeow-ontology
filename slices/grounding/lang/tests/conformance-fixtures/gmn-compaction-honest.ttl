# Conforming GMN fixture: an honest GMN-2 compaction plus the canonical GMN-1 emission.
# The gmeow:GmnCompaction names both sources it condenses through gmeow:gmnCompacts and
# its holding standpoint through gmeow:vantage (satisfying
# lang:GmnCompactionProvenanceShape), and its correspondence carries the honest weak
# judgment — logic:ValidationOnly, logic:mnemomorphic false — so
# lang:GmnCompactionOverclaimShape stays quiet (GMN-2 compaction is a NEW claim about
# older claims and stays honestly weak; it is NOT the GMN-0 -> GMN-1 crossing). Alongside
# it, the canonical lang:ProjectionEmission of the GMN-0 → GMN-1 crossing now mirrors
# gmeow:gmnCorrNormalToGmn's section/retraction judgment: logic:ExactPreservation, an
# EMPTY lang:unsupportedConstruct set (the prior alias/annotation/confidence drop list is
# eliminated, not merely reduced), and lang:roundTripHolds true — satisfying
# lang:ProjectionEmissionDeclaredShape and the native lossy-emission gates (an
# ExactPreservation emission is exempt from the undeclared-unsupported-construct check,
# and its roundTripHolds is not refuted).

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

# ── The compacted sources: two older standpoint-held claims ──────────────────
ex:sensorTeam a gmeow:Agent .
ex:summarizerStandpoint a gmeow:Agent .

ex:claimDoorOpenMonday a gmeow:StandpointClaim ;
    gmeow:vantage ex:sensorTeam .

ex:claimDoorOpenTuesday a gmeow:StandpointClaim ;
    gmeow:vantage ex:sensorTeam .

# ── The honest compaction: provenance-linked, vantage-held, validation-only ──
ex:corrCompaction a logic:Correspondence ;
    logic:preservationKind logic:ValidationOnly ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:BridgeView ;
    logic:hasDeterminacy logic:Vague ;
    logic:mnemomorphic false .

ex:compactionDoorWeek a gmeow:GmnCompaction ;
    gmeow:gmnCompacts ex:claimDoorOpenMonday , ex:claimDoorOpenTuesday ;
    gmeow:vantage ex:summarizerStandpoint ;
    lang:translationCorrespondence ex:corrCompaction .

# ── The canonical GMN-0 → GMN-1 emission (section/retraction, exact) ─────────
ex:emGmnSurface a lang:ProjectionEmission ;
    lang:projectionTargetName "GMN-1" ;
    lang:projectsSource gmeow:gmnNormalForm ;
    logic:preservationKind logic:ExactPreservation ;
    lang:roundTripHolds true .
