ex:movesApprovalState a logic:Formula ;
    rdfs:label "The 8 positions the ApprovalState axis ranges over"@x-gmeow-english ;
    logic:relation logic:ApprovalState ;
    logic:argument
        [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termIri logic:ApprovalCancelled ] ,
        [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri logic:ApprovalCreated ] ,
        [ a logic:TermCarrier ; logic:termIndex 2 ; logic:termIri logic:ApprovalDetached ] ,
        [ a logic:TermCarrier ; logic:termIndex 3 ; logic:termIri logic:ApprovalDischarged ] ,
        [ a logic:TermCarrier ; logic:termIndex 4 ; logic:termIri logic:ApprovalExpired ] ,
        [ a logic:TermCarrier ; logic:termIndex 5 ; logic:termIri logic:ApprovalNull ] ,
        [ a logic:TermCarrier ; logic:termIndex 6 ; logic:termIri logic:ApprovalReleased ] ,
        [ a logic:TermCarrier ; logic:termIndex 7 ; logic:termIri logic:ApprovalViolated ] .

