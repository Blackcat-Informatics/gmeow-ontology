gmeow:activationVaultIdentity
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "activation vault identity"@x-gmeow-english ;
    skos:definition "The required supplied sixteen-byte native vault identity on one selected-call snapshot record, represented as an unspaced either-case hexBinary literal."@x-gmeow-english ;
    gmeow:useWhen "Use to associate actual candidate-found vaults and the complete source snapshot roster by their supplied bytes."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating VaultId as a UUID or thirty-two-byte digest, fabricating an IRI or recomputing a source construction hash."@x-gmeow-english ;
    gmeow:howToUse "Supply xsd:hexBinary with exactly thirty-two hex digits matching ^[0-9A-Fa-f]{32}$."@x-gmeow-english ;
    skos:scopeNote "The explicit lexical profile is not XSD-canonical normalization. Opposite-case spellings compare by decoded binary value and cannot identify distinct records in one account. Regex dialect projection residue remains explicit."@x-gmeow-english ;
    skos:example "Fictional scoped fragment: ex:vaultRecord gmeow:activationVaultIdentity \"00112233445566778899aAbBcCdDeEfF\"^^xsd:hexBinary . The bytes are fictional and are not an authenticated native identity."@x-gmeow-english ;
    logic:domain gmeow:QueryVaultSnapshotRecord ; logic:range xsd:hexBinary ; logic:subPropertyOf lang:literalValue .

gmeow:activationSnapshotPresent
    a logic:DatatypeProperty ;
