# Synthetic coverage fixture for the languages building block. Worked examples:
# (a) Japanese — ONE language co-mingling FOUR scripts as four co-equal
#     lang:Orthography bindings (Han, Hiragana, Katakana, rōmaji/Latin);
#     (b) Ithkuil — engineered conlang, NO code, human creator, designGoal, two
#     versions, a bespoke NON-LINEAR lang:Script; (c) an AI-generated language
#     created by a SoftwareAgent; (d) a sign language (signed, no script);
#     (e) Python bridging software.ttl; (f) German endonym/exonym + a person with
#     leveled per-skill proficiency. Plus the names↔languages bridge: a romanized
#     name naming its transliteration scheme (Hepburn). No RDF-star.
#
# Scripts are grounded lang:Script (skos:notation = ISO 15924); the language↔script
# binding is a lang:Orthography (lang:orthographyFor + lang:usesScript). The former
# gmeow:WritingSystemUsage role/period facets are a declared loss (see the language
# slice loss ledger). Internal gmeow:languageTag is dropped (IRI identity supersedes).

@prefix ex:     <https://example.org/lang/> .
@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix lang:   <https://blackcatinformatics.ca/lang/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix wd:     <http://www.wikidata.org/entity/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# --- (a) Japanese: four co-equal, co-mingled scripts as orthographies -------- #

ex:japanese a gmeow:Language ;
    gmeow:languageOrigin gmeow:originNatural ;
    gmeow:languageModality gmeow:modalitySpoken , gmeow:modalityWritten ;
    gmeow:languageStatus gmeow:statusLiving ;
    gmeow:languageCode "ja" ;
    skos:exactMatch wd:Q5287 ;
    gmeow:hasAppellation ex:jaEndonym , ex:jaExonym .

ex:wsHan a lang:Script ;
    skos:notation "Hani"^^xsd:string .
ex:wsHiragana a lang:Script ;
    skos:notation "Hira"^^xsd:string .
ex:wsKatakana a lang:Script ;
    skos:notation "Kana"^^xsd:string .
ex:wsRomaji a lang:Script ;
    skos:notation "Latn"^^xsd:string .

ex:orthJaHan a lang:Orthography ;
    lang:orthographyFor ex:japanese ; lang:usesScript ex:wsHan .
ex:orthJaHira a lang:Orthography ;
    lang:orthographyFor ex:japanese ; lang:usesScript ex:wsHiragana .
ex:orthJaKana a lang:Orthography ;
    lang:orthographyFor ex:japanese ; lang:usesScript ex:wsKatakana .
ex:orthJaRomaji a lang:Orthography ;
    lang:orthographyFor ex:japanese ; lang:usesScript ex:wsRomaji .

ex:jaEndonym a gmeow:Appellation ;
    gmeow:fullName "日本語"@x-gmeow-japanese ; gmeow:nameLanguage ex:japanese ; gmeow:nameScript "Hani" ;
    gmeow:namePurpose gmeow:namePurposeEndonym .
ex:jaExonym a gmeow:Appellation ;
    gmeow:fullName "Japanese"@x-gmeow-english ; gmeow:nameLanguage ex:english ;
    gmeow:namePurpose gmeow:namePurposeExonym .

# names↔languages bridge: a romanization that names HOW it was produced (Hepburn).
ex:yamada a gmeow:Person ; gmeow:hasName ex:yamadaName ; gmeow:knowsLanguage ex:japanese .
ex:yamadaName a gmeow:PersonName ;
    gmeow:fullName "山田太郎"@x-gmeow-japanese ; gmeow:nameLanguage ex:japanese ; gmeow:nameScript "Hani" ;
    gmeow:romanization "Yamada Tarō"@x-gmeow-japanese-latn ;
    gmeow:transliterationScheme gmeow:schemeHepburn .

# --- (b) Ithkuil: engineered, code-less, versioned, bespoke non-linear script  #

ex:ithkuil a gmeow:Language ;
    gmeow:languageOrigin gmeow:originConstructedEngineered ;
    gmeow:languageModality gmeow:modalitySpoken , gmeow:modalityWritten ;
    gmeow:languageStatus gmeow:statusConstructedActive ;
    gmeow:designGoal "Maximal cognitive precision and semantic exactitude with minimal ambiguity." ;
    gmeow:wasAttributedTo ex:quijada ;
    gmeow:hasAppellation ex:ithkuilName .
# NB: NO gmeow:languageCode — a code-less conlang is fully first-class.
ex:ithkuilName a gmeow:Appellation ;
    gmeow:fullName "Ithkuil"@x-gmeow-english ; gmeow:namePurpose gmeow:namePurposeGlossonym .
ex:quijada a gmeow:Person ; gmeow:hasName ex:quijadaName.
ex:quijadaName a gmeow:PersonName ; gmeow:fullName "John Quijada"@x-gmeow-english .
# Bespoke, non-linear morpho-script — NO skos:notation (no ISO 15924 registration).
ex:wsIthkuil a lang:Script .
ex:orthIthkuil a lang:Orthography ;
    lang:orthographyFor ex:ithkuil ; lang:usesScript ex:wsIthkuil .

ex:ithkuil1993 a gmeow:LanguageVersion ;
    gmeow:versionOf ex:ithkuil ; gmeow:versionLabel "1993" ; gmeow:wasAttributedTo ex:quijada .
ex:ithkuil2011 a gmeow:LanguageVersion ;
    gmeow:versionOf ex:ithkuil ; gmeow:versionLabel "2011" ;
    gmeow:supersedes ex:ithkuil1993 ; gmeow:wasDerivedFrom ex:ithkuil1993 .

# --- (c) AI-generated language (creator is a SoftwareAgent) ------------------ #

ex:aiLang a gmeow:Language ;
    gmeow:languageOrigin gmeow:originAiGenerated ;
    gmeow:languageModality gmeow:modalityMachine ;
    gmeow:languageStatus gmeow:statusEmerging ;
    gmeow:designGoal "Compressed agent-to-agent interlingua optimised for token efficiency." ;
    gmeow:wasAttributedTo ex:modelAgent ;
    gmeow:wasGeneratedBy ex:genRun .
ex:modelAgent a gmeow:SoftwareAgent ; gmeow:name "gmeow-conlang-synth v1" .
ex:genRun a gmeow:LanguageCreation ; gmeow:wasAssociatedWith ex:modelAgent .

# --- (d) Sign language: signed modality, no writing system ------------------ #

ex:asl a gmeow:Language ;
    gmeow:languageOrigin gmeow:originNatural ;
    gmeow:languageModality gmeow:modalitySigned ;
    gmeow:languageStatus gmeow:statusLiving ;
    gmeow:languageCode "ase" ;
    gmeow:hasAppellation ex:aslName .
ex:aslName a gmeow:Appellation ;
    gmeow:fullName "American Sign Language"@x-gmeow-english ; gmeow:namePurpose gmeow:namePurposeExonym .

# --- (e) Python: programming language bridging software.ttl ------------------ #

ex:python a gmeow:Language ;
    lang:signSystemKind lang:programmingLanguageKind ;
    lang:modality lang:writtenModality ;
    gmeow:languageOrigin gmeow:originProgramming ;
    gmeow:languageModality gmeow:modalityMachine ;
    gmeow:languageCode "py" ;
    gmeow:hasAppellation ex:pythonName .
ex:pythonName a gmeow:Appellation ;
    gmeow:fullName "Python"@x-gmeow-english ; gmeow:namePurpose gmeow:namePurposeGlossonym .
ex:someProject a gmeow:SoftwareProject .
ex:someProjectTree a gmeow:SourceTree ;
    gmeow:writtenInLanguage ex:python .

# --- (f) German + English: endonym/exonym + leveled per-skill proficiency ---- #

ex:german a gmeow:Language ;
    gmeow:languageOrigin gmeow:originNatural ;
    gmeow:languageModality gmeow:modalitySpoken , gmeow:modalityWritten ;
    gmeow:languageStatus gmeow:statusLiving ;
    gmeow:languageCode "de" ;
    gmeow:hasAppellation ex:deEndonym , ex:deExonym .
ex:wsLatin a lang:Script ;
    skos:notation "Latn"^^xsd:string .
ex:orthDeLatin a lang:Orthography ;
    lang:orthographyFor ex:german ; lang:usesScript ex:wsLatin .
ex:deEndonym a gmeow:Appellation ;
    gmeow:fullName "Deutsch"@x-gmeow-german ; gmeow:nameLanguage ex:german ; gmeow:namePurpose gmeow:namePurposeEndonym .
ex:deExonym a gmeow:Appellation ;
    gmeow:fullName "German"@x-gmeow-english ; gmeow:nameLanguage ex:english ; gmeow:namePurpose gmeow:namePurposeExonym .

ex:english a gmeow:Language ;
    gmeow:languageOrigin gmeow:originNatural ; gmeow:languageCode "en" ;
    gmeow:hasAppellation ex:enName .
ex:enName a gmeow:Appellation ;
    gmeow:fullName "English"@x-gmeow-english ; gmeow:namePurpose gmeow:namePurposeExonym .

ex:learner a gmeow:Person ;
    gmeow:hasName ex:learnerName ;
    gmeow:nativeLanguage ex:english ;
    gmeow:knowsLanguage ex:german .
ex:learnerName a gmeow:PersonName ; gmeow:fullName "Sam Lee"@x-gmeow-english .

# Per-skill proficiency: native overall (English), CEFR B2 writing + C1 speaking (German).
ex:profEnNative a gmeow:LanguageProficiency ;
    gmeow:proficiencyAgent ex:learner ; gmeow:proficiencyLanguage ex:english ;
    gmeow:proficiencyModality gmeow:profModalityOverall ;
    gmeow:proficiencyLevel gmeow:levelNative ; gmeow:proficiencyScale gmeow:scaleSelfReported .
ex:profDeWriting a gmeow:LanguageProficiency ;
    gmeow:proficiencyAgent ex:learner ; gmeow:proficiencyLanguage ex:german ;
    gmeow:proficiencyModality gmeow:profModalityWriting ;
    gmeow:proficiencyLevel gmeow:cefrB2 ; gmeow:proficiencyScale gmeow:scaleCEFR .
ex:profDeSpeaking a gmeow:LanguageProficiency ;
    gmeow:proficiencyAgent ex:learner ; gmeow:proficiencyLanguage ex:german ;
    gmeow:proficiencyModality gmeow:profModalitySpeaking ;
    gmeow:proficiencyLevel gmeow:cefrC1 ; gmeow:proficiencyScale gmeow:scaleCEFR .
