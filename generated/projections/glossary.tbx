      <termEntry id="c-76d10344843698d6">
        <langSet xml:lang="en">
          <tig>
            <term>reconstruction residual</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>résidu de reconstruction</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>重构残差</term>
          </tig>
        </langSet>
      </termEntry>
