@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix crmarc: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/crmarchaeo> a align:Alignment ;
    rdfs:label "GMEOW → crmarchaeo (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "ObservationalActivity (excavation) → crmarc:A1_Excavation_Process_Unit"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:ObservationalActivity ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri crmarc:A1_Excavation_Process_Unit ] ;
            align:relation "<=" ;
            edoal:measure 7.5e-01 ],
        [ a align:Cell ;
            rdfs:label "connectsTo between Observations → crmarc:AP11_has_physical_relation"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:connectsTo ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri crmarc:AP11_has_physical_relation ] ;
            align:relation "<=" ;
            edoal:measure 6e-01 ],
        [ a align:Cell ;
            rdfs:label "Observation → crmarc:S4_Observation"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Observation ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri crmarc:S4_Observation ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "crmarchaeo" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@en .
