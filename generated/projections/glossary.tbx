        <langSet xml:lang="fr">
          <tig>
            <term>Ne pas réduire les valeurs IRI, variable, littéral et marqueur de séquence à un champ textuel commun ; leur genre influe sur le sens de la formule.</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
