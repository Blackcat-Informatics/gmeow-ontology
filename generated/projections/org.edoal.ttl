@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .

<https://blackcatinformatics.ca/gmeow/projections/org>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:Membership ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri org:Membership ;
        ] ;
        align:relation "=" ;
        edoal:measure "0.95"^^xsd:double ;
        rdfs:label "Membership relator → org:Membership (member/organization/role)"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:Organization ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri org:FormalOrganization ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "Organization → org:FormalOrganization"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:Role ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri org:Role ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "Role → org:Role"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasMember ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri org:member ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "hasMember → org:member"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:memberOf ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri org:memberOf ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "memberOf → org:memberOf"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:subOrganizationOf ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri org:subOrganizationOf ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "subOrganizationOf → org:subOrganizationOf"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "org" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → org (EDOAL)"@en .
