    [ a logic:Restriction ; logic:onProperty gmeow:budgetCostCurrency ; logic:allValuesFrom gmeow:ReferenceFrame ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:budgetCostCurrency ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:ReferenceFrame ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:budgetCostPriceTable ; logic:allValuesFrom gmeow:InformationObject ] .

