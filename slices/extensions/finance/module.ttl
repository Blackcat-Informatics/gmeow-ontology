gmeow:walletSchemeSOL
    a gmeow:WalletScheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Solana"@x-gmeow-english ;
    skos:definition "The Solana blockchain scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:walletSchemeXMR
    a gmeow:WalletScheme ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "Monero"@x-gmeow-english ;
    skos:definition "The Monero blockchain scheme."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

<https://blackcatinformatics.ca/gmeow/slices/finance>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Personal and SMB financial existence: accounts, monetary amounts, transactions, ledgers, invoices, orders, asset holdings, and crypto wallets. Grounded in the existing Event/Participation/Agreement/Rights/Trust substrate. FIBO, schema.org, ISO 4217, ISO 20022, FIGI and OFX are aligned by reference, never imported.

DOCTRINE.
  * A financial account is an InformationObject (consistent with OnlineAccount): it is fundamentally an information construct — an IBAN, account number, and balance record. The legal/contractual aspect is modelled separately via Agreement (account terms between holder and bank).
  * Money is a MonetaryAmount = amount (xsd:decimal) + currency (ReferenceFrame individual). DL-clean; no arithmetic in OWL.
  * Currency is a ReferenceFrame in the frameRealmCurrency realm (Principle 11 — frame-relativity). Each ISO 4217 code is a ReferenceFrame individual.
  * accountCurrency is NON-FUNCTIONAL: a single FinancialAccount may hold balances in several currencies (multi-currency fintech accounts). The functional constraint moves to Posting/Holding relators.
  * A transaction is a reified Event (REA pattern): money movement with Agent participants in roles (payer / payee / intermediary) — reuse Event/Participation, never re-mint.
  * Double-entry as structure: LedgerAccount (asset / liability / equity / revenue / expense — open vocab), JournalEntry ⊑ Event, Posting ⊑ gufo:Relator (account × amount × debit/credit); balance (Σ debits = Σ credits) enforced by SHACL, not OWL.
  * Loans are Agreements; invoices are Documents; ownership is rights; banks are Organizations; wallets hold trust keys — reuse, don't duplicate.
  * Open value vocabularies, no overtyping (Principle 9): account types, transaction types, transaction statuses, ledger account types, posting directions, asset types, invoice statuses, order statuses, and payment methods are individuals, never subclasses.
  * Flat-first, reify on demand: a flat accountBalance on FinancialAccount covers the 80% case; promote to a Holding relator when cost-basis, period, or provenance matters.
  * Sensitive: P9/P10 + provenance. Reversed/voided transactions are displayable false, retained as the audit trail, never deleted; disputed amounts coexist accordingTo; every figure carries confidence/wasAttributedTo."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "GMEOW Finance Module"@x-gmeow-english ;
    skos:definition "The GMEOW Finance Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Suppression constraints (#1194) — projections of the finance Phase B–D        #
# suppression shapes. A reversed/cancelled record that is not suppressed        #
# (gmeow:displayable false) is a Warning — a source may lag on setting the flag. #
# =========================================================================== #

gmeow:ReversedTransactionSuppressionConstraint
    a logic:Constraint ;
    rdfs:label "Reversed transaction suppression constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a reversed gmeow:FinancialTransaction (one whose gmeow:transactionStatus is transactionStatusReversed) should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)."@x-gmeow-english ;
    logic:formalizes gmeow:FinancialTransaction ;
    logic:severity "Warning" ;
    logic:message "A reversed transaction should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
    logic:integrity logic:supTxForall .
logic:supTxForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:supTxImpl .
logic:supTxImpl a logic:Formula ; logic:antecedent logic:supTxGuard ; logic:consequent logic:supTxPhi .
logic:supTxGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:FinancialTransaction ] .
logic:supTxPhi a logic:Formula ; logic:not logic:supTxEx .
logic:supTxEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "x" ] ;
    logic:exists logic:supTxBody .
logic:supTxBody a logic:Formula ; logic:and logic:supTxStatus , logic:supTxNotSuppressed .
logic:supTxStatus a logic:Formula ; logic:relation gmeow:transactionStatus ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:transactionStatusReversed ] .
logic:supTxNotSuppressed a logic:Formula ; logic:not logic:supTxDisp .
logic:supTxDisp a logic:Formula ; logic:relation gmeow:displayable ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] .

gmeow:CancelledInvoiceSuppressionConstraint
    a logic:Constraint ;
    rdfs:label "Cancelled invoice suppression constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a cancelled gmeow:Invoice (one whose gmeow:invoiceStatus is invoiceStatusCancelled) should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)."@x-gmeow-english ;
    logic:formalizes gmeow:Invoice ;
    logic:severity "Warning" ;
    logic:message "A cancelled invoice should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
    logic:integrity logic:supInvForall .
logic:supInvForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:supInvImpl .
logic:supInvImpl a logic:Formula ; logic:antecedent logic:supInvGuard ; logic:consequent logic:supInvPhi .
logic:supInvGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Invoice ] .
logic:supInvPhi a logic:Formula ; logic:not logic:supInvEx .
logic:supInvEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "x" ] ;
    logic:exists logic:supInvBody .
logic:supInvBody a logic:Formula ; logic:and logic:supInvStatus , logic:supInvNotSuppressed .
logic:supInvStatus a logic:Formula ; logic:relation gmeow:invoiceStatus ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:invoiceStatusCancelled ] .
logic:supInvNotSuppressed a logic:Formula ; logic:not logic:supInvDisp .
logic:supInvDisp a logic:Formula ; logic:relation gmeow:displayable ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] .

gmeow:CancelledOrderSuppressionConstraint
    a logic:Constraint ;
    rdfs:label "Cancelled order suppression constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a cancelled gmeow:Order (one whose gmeow:orderStatus is orderStatusCancelled) should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)."@x-gmeow-english ;
    logic:formalizes gmeow:Order ;
    logic:severity "Warning" ;
    logic:message "A cancelled order should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
    logic:integrity logic:supOrdForall .
logic:supOrdForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:supOrdImpl .
logic:supOrdImpl a logic:Formula ; logic:antecedent logic:supOrdGuard ; logic:consequent logic:supOrdPhi .
logic:supOrdGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Order ] .
logic:supOrdPhi a logic:Formula ; logic:not logic:supOrdEx .
logic:supOrdEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "x" ] ;
    logic:exists logic:supOrdBody .
logic:supOrdBody a logic:Formula ; logic:and logic:supOrdStatus , logic:supOrdNotSuppressed .
logic:supOrdStatus a logic:Formula ; logic:relation gmeow:orderStatus ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:orderStatusCancelled ] .
logic:supOrdNotSuppressed a logic:Formula ; logic:not logic:supOrdDisp .
logic:supOrdDisp a logic:Formula ; logic:relation gmeow:displayable ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "false" ; logic:termLiteralDatatype xsd:boolean ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/CryptoWallet> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/walletScheme> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/WalletScheme> ] .
<https://blackcatinformatics.ca/gmeow/FinancialAccount> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/accountCurrency> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/ReferenceFrame> ] .
<https://blackcatinformatics.ca/gmeow/FinancialAccount> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/accountHolder> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/FinancialAccount> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/accountType> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/FinancialAccountType> ] .
<https://blackcatinformatics.ca/gmeow/FinancialTransaction> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/transactionAmount> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/MonetaryAmount> ] .
<https://blackcatinformatics.ca/gmeow/Holding> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/holdingAgent> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/Holding> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/holdingAsset> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Asset> ] .
<https://blackcatinformatics.ca/gmeow/Holding> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/holdingQuantity> ; logic:allValuesFrom <http://www.w3.org/2001/XMLSchema#decimal> ] .
<https://blackcatinformatics.ca/gmeow/Invoice> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/invoiceAmount> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/MonetaryAmount> ] .
<https://blackcatinformatics.ca/gmeow/LedgerAccount> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/ledgerAccountType> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/LedgerAccountType> ] .
<https://blackcatinformatics.ca/gmeow/Order> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/orderAmount> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/MonetaryAmount> ] .
<https://blackcatinformatics.ca/gmeow/Order> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/orderBuyer> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/Order> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/orderSeller> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Agent> ] .
<https://blackcatinformatics.ca/gmeow/Posting> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/postingAccount> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/LedgerAccount> ] .
<https://blackcatinformatics.ca/gmeow/Posting> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/postingAmount> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/MonetaryAmount> ] .
<https://blackcatinformatics.ca/gmeow/Posting> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/postingDirection> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/PostingDirection> ] .
<https://blackcatinformatics.ca/gmeow/Posting> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/postingJournalEntry> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/JournalEntry> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/CryptoWallet> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/walletScheme" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/FinancialAccount> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/accountHolder" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/FinancialTransaction> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/transactionAmount" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Holding> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/holdingAgent" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Holding> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/holdingAsset" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Holding> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/holdingQuantity" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Invoice> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/invoiceAmount" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/LedgerAccount> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/ledgerAccountType" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Order> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/orderAmount" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Order> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/orderBuyer" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Order> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/orderSeller" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Posting> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/postingAccount" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Posting> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/postingAmount" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Posting> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/postingDirection" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/Posting> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/postingJournalEntry" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .

# =========================================================================== #
# Canonical logic: grounding for the finance closed-world constraints. Records  #
# formalize the suppression validation-shape IRIs and ground the                #
# transaction-parties disjunction, the two-posting count, and the               #
# posting-direction value set. The gmeow:Agent obligations on                   #
# ledgerAccountHolder / invoiceIssuer / invoiceRecipient hold under reasoning    #
# (gmeow:Organization logic:subClassOf gmeow:Agent), so they ground              #
# declaratively via owl:allValuesFrom gmeow:Agent.                              #
# =========================================================================== #

gmeow:ReversedTransactionSuppressionConstraint logic:formalizes gmeow:ReversedTransactionSuppressionShape .
gmeow:CancelledInvoiceSuppressionConstraint logic:formalizes gmeow:CancelledInvoiceSuppressionShape .
gmeow:CancelledOrderSuppressionConstraint logic:formalizes gmeow:CancelledOrderSuppressionShape .

# A gmeow:FinancialTransaction has at least one participant: either the flat
# gmeow:hasParticipant shortcut OR a reified gmeow:Participation relator whose
# gmeow:participationEvent points back at the transaction (the sh:or of the shape).
gmeow:TransactionPartiesConstraint
    a logic:Constraint ;
    rdfs:label "Transaction has-parties constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:FinancialTransaction has at least one participant, bound either through the flat gmeow:hasParticipant shortcut or through a gmeow:Participation relator whose gmeow:participationEvent is the transaction."@x-gmeow-english ;
    logic:formalizes gmeow:TransactionHasPartiesShape ;
    logic:message "A FinancialTransaction must have at least one participant (gmeow:hasParticipant or a gmeow:Participation relator)." ;
    logic:integrity logic:txpForall .
logic:txpForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:txpImpl .
logic:txpImpl a logic:Formula ; logic:antecedent logic:txpGuard ; logic:consequent logic:txpOr .
logic:txpGuard a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:FinancialTransaction ] .
logic:txpOr a logic:Formula ; logic:or logic:txpFlat , logic:txpRelator .
logic:txpFlat a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] ;
    logic:exists logic:txpFlatAtom .
logic:txpFlatAtom a logic:Formula ; logic:relation gmeow:hasParticipant ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .
logic:txpRelator a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "q" ] ;
    logic:exists logic:txpRelatorAtom .
logic:txpRelatorAtom a logic:Formula ; logic:relation gmeow:participationEvent ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "q" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .

# A gmeow:JournalEntry has at least two gmeow:journalEntryPostings (double-entry).
gmeow:JournalEntryPostingsCountConstraint
    a logic:AggregateConstraint ;
    rdfs:label "JournalEntry postings-count constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:JournalEntry binds at least two gmeow:journalEntryPostings."@x-gmeow-english ;
    logic:onClass gmeow:JournalEntry ;
    logic:aggFunction "COUNT" ;
    logic:aggPath gmeow:journalEntryPostings ;
    logic:aggComparator ">=" ;
    logic:aggCompareTo "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    logic:formalizes gmeow:JournalEntryHasPostingsShape ;
    logic:message "A JournalEntry must have at least two postings (gmeow:journalEntryPostings)." .

# postingDirection sh:in value set → owl:oneOf antecedent (declarative sh:in).
gmeow:Posting logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:postingDirection ; logic:allValuesFrom [ logic:oneOf ( gmeow:postingDirectionDebit gmeow:postingDirectionCredit ) ] ] .

# Data-sound gmeow:Agent obligations (gmeow:Organization logic:subClassOf gmeow:Agent).
gmeow:LedgerAccount logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:ledgerAccountHolder ; logic:allValuesFrom gmeow:Agent ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:LedgerAccount ; logic:closureKey "https://blackcatinformatics.ca/gmeow/ledgerAccountHolder" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:Invoice logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:invoiceIssuer ; logic:allValuesFrom gmeow:Agent ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:invoiceRecipient ; logic:allValuesFrom gmeow:Agent ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Invoice ; logic:closureKey "https://blackcatinformatics.ca/gmeow/invoiceIssuer" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Invoice ; logic:closureKey "https://blackcatinformatics.ca/gmeow/invoiceRecipient" ; logic:closureValue logic:ClosedWorldClosure ] .

# JournalEntry: at least two postings, projected as a BARE sh:minCount 2 (owl:Thing
# filler collapses the qualified count to the plain minimum the legacy shape stated).
gmeow:JournalEntry logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:journalEntryPostings ; logic:minQualifiedCardinality 2 ; logic:onClass owl:Thing ] .

# The double-entry balance invariant: within each currency, the sum of a JournalEntry's debit
# postings equals the sum of its credit postings. A first-class aggregate-balance constraint
# (partitioned two-sum equality over a value-key group), lowered to a GROUP BY $this ?currency
# HAVING(sumDebits != sumCredits) violation SELECT.
gmeow:JournalEntryBalanceConstraint
    a logic:AggregateBalanceConstraint ;
    rdfs:label "Journal entry balance constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: for each gmeow:JournalEntry, within every currency bucket the sum of debit-posting amounts must equal the sum of credit-posting amounts. Partitions the entry's postings by gmeow:postingDirection (debit vs credit), reads each posting's amount via gmeow:postingAmount then gmeow:monetaryValue and its currency via gmeow:postingAmount then gmeow:currency, and asserts the two partition-sums are equal per currency."@x-gmeow-english ;
    logic:onClass gmeow:JournalEntry ;
    logic:balancePostingPredicate gmeow:journalEntryPostings ;
    logic:balancePartitionPredicate gmeow:postingDirection ;
    logic:balanceDebitValue gmeow:postingDirectionDebit ;
    logic:balanceCreditValue gmeow:postingDirectionCredit ;
    logic:balanceAmountNodePredicate gmeow:postingAmount ;
    logic:balanceValuePredicate gmeow:monetaryValue ;
    logic:balanceGroupPredicate gmeow:currency ;
    logic:severity "Violation" ;
    logic:message "The sum of debit postings must equal the sum of credit postings for each currency in a JournalEntry." ;
    logic:formalizes gmeow:JournalEntryBalancedShape .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects owl:FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:accountTypeFunctionality
    a owl:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/finance> ;
    rdfs:label "accountType is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:accountType is functional: a financial account has exactly one canonical type — a single FinancialAccountType (bank, credit, investment, wallet), since an account with several types is modelled as several accounts. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:accountType ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:accountType ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:accountType names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:accountType, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:accountType and nothing else. It is not a definition of gmeow:accountType (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:accountTypeFunctionality logic:characterizes gmeow:accountType ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
