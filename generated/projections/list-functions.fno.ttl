@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:list-functions a owl:Ontology ;
    rdfs:label "GMEOW first-class RDF list functions (FnO)"@en ;
    skos:definition "GENERATED by `gmeow regenerate` (mappings) — DO NOT EDIT. Six primitive rdf:List operations (listLength, listGet, listIndexOf, listSlice, listConcat, listContains) declared as FnO. listContains is computed in the reasoning layer today via the recursive rdf:first/rdf:rest walk (conformance case goal-rdf-list-functions, the backward-goal analog of the rl:list-member recursion). The indexed/counting/constructing operations (listLength, listGet, listIndexOf, listSlice, listConcat) need arithmetic/value-construction beyond the current relational engine; their executable backing — and a purrdf SPARQL binding for all six — is deferred to #1016."@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

gmeow:listLength a fno:Function ;
    rdfs:label "list length"@en ;
    skos:definition "The number of members in an rdf:List (the length of the rdf:first/rdf:rest chain to rdf:nil)."@en ;
    fno:expects ( gmeow:pList ) ;
    fno:returns ( gmeow:oListLength ) ;
    rdfs:seeAlso <https://blackcatinformatics.ca/logic/listLength> .

gmeow:listGet a fno:Function ;
    rdfs:label "list get"@en ;
    skos:definition "The member of an rdf:List at a zero-based index (the nth rdf:first along the chain)."@en ;
    fno:expects ( gmeow:pList gmeow:pIndex ) ;
    fno:returns ( gmeow:oListGet ) ;
    rdfs:seeAlso <https://blackcatinformatics.ca/logic/listGet> .

gmeow:listIndexOf a fno:Function ;
    rdfs:label "list index of"@en ;
    skos:definition "The zero-based index of the first occurrence of a value in an rdf:List, or absent when the value is not a member."@en ;
    fno:expects ( gmeow:pList gmeow:pValue ) ;
    fno:returns ( gmeow:oListIndexOf ) ;
    rdfs:seeAlso <https://blackcatinformatics.ca/logic/listIndexOf> .

gmeow:listSlice a fno:Function ;
    rdfs:label "list slice"@en ;
    skos:definition "A new rdf:List of the members in the half-open index range [start, end) of an rdf:List."@en ;
    fno:expects ( gmeow:pList gmeow:pSliceStart gmeow:pSliceEnd ) ;
    fno:returns ( gmeow:oListSlice ) ;
    rdfs:seeAlso <https://blackcatinformatics.ca/logic/listSlice> .

gmeow:listConcat a fno:Function ;
    rdfs:label "list concat"@en ;
    skos:definition "A new rdf:List that is the concatenation of two rdf:Lists (the members of the first followed by the members of the second)."@en ;
    fno:expects ( gmeow:pListA gmeow:pListB ) ;
    fno:returns ( gmeow:oListConcat ) ;
    rdfs:seeAlso <https://blackcatinformatics.ca/logic/listConcat> .

gmeow:listContains a fno:Function ;
    rdfs:label "list contains"@en ;
    skos:definition "True when a value is a member of an rdf:List, false otherwise."@en ;
    fno:expects ( gmeow:pList gmeow:pValue ) ;
    fno:returns ( gmeow:oListContains ) ;
    rdfs:seeAlso <https://blackcatinformatics.ca/logic/listContains> .

gmeow:pList a fno:Parameter ; fno:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#List> ; fno:required true ;
    rdfs:label "list"@en ;
    skos:definition "The input rdf:List the operation reads."@en .

gmeow:pIndex a fno:Parameter ; fno:type <http://www.w3.org/2001/XMLSchema#integer> ; fno:required true ;
    rdfs:label "index"@en ;
    skos:definition "A zero-based position into an rdf:List."@en .

gmeow:pValue a fno:Parameter ; fno:type <http://www.w3.org/2000/01/rdf-schema#Resource> ; fno:required true ;
    rdfs:label "value"@en ;
    skos:definition "A value to locate as a member of an rdf:List."@en .

gmeow:pSliceStart a fno:Parameter ; fno:type <http://www.w3.org/2001/XMLSchema#integer> ; fno:required true ;
    rdfs:label "slice start"@en ;
    skos:definition "The inclusive zero-based start index of a slice."@en .

gmeow:pSliceEnd a fno:Parameter ; fno:type <http://www.w3.org/2001/XMLSchema#integer> ; fno:required true ;
    rdfs:label "slice end"@en ;
    skos:definition "The exclusive zero-based end index of a slice."@en .

gmeow:pListA a fno:Parameter ; fno:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#List> ; fno:required true ;
    rdfs:label "first list"@en ;
    skos:definition "The first (left) rdf:List of a concatenation."@en .

gmeow:pListB a fno:Parameter ; fno:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#List> ; fno:required true ;
    rdfs:label "second list"@en ;
    skos:definition "The second (right) rdf:List of a concatenation."@en .

gmeow:oListLength a fno:Output ; fno:type <http://www.w3.org/2001/XMLSchema#integer> ;
    rdfs:label "list length result"@en ;
    skos:definition "The result of gmeow:listLength."@en .

gmeow:oListGet a fno:Output ; fno:type <http://www.w3.org/2000/01/rdf-schema#Resource> ;
    rdfs:label "list get result"@en ;
    skos:definition "The result of gmeow:listGet."@en .

gmeow:oListIndexOf a fno:Output ; fno:type <http://www.w3.org/2001/XMLSchema#integer> ;
    rdfs:label "list index of result"@en ;
    skos:definition "The result of gmeow:listIndexOf."@en .

gmeow:oListSlice a fno:Output ; fno:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#List> ;
    rdfs:label "list slice result"@en ;
    skos:definition "The result of gmeow:listSlice."@en .

gmeow:oListConcat a fno:Output ; fno:type <http://www.w3.org/1999/02/22-rdf-syntax-ns#List> ;
    rdfs:label "list concat result"@en ;
    skos:definition "The result of gmeow:listConcat."@en .

gmeow:oListContains a fno:Output ; fno:type <http://www.w3.org/2001/XMLSchema#boolean> ;
    rdfs:label "list contains result"@en ;
    skos:definition "The result of gmeow:listContains."@en .
