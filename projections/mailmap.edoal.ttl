@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/mailmap> a align:Alignment ;
    rdfs:label "GMEOW → mailmap (EDOAL)"@x-gmeow-english ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "Agent mailmapEntry → canonical .mailmap line"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:mailmapEntry ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri gmeow:mailmapEntry ] ;
            align:relation "=" ;
            edoal:measure 1e+00 ],
        [ a align:Cell ;
            rdfs:label "suppressed AuthorIdentity → .mailmap remapping line"@x-gmeow-english ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:canonicalizedIdentity ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri gmeow:projectedMailmapMapping ] ;
            align:relation "<=" ;
            edoal:measure 1e+00 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnComposeMailmapMapping ] ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "mailmap" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@x-gmeow-english .
