msgstr "用于来源明确的“通知投递待定”分类。"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Pending does not mean no attempt ever occurred or that later delivery is guaranteed."
msgstr "待定不意味着从未尝试或保证以后送达。"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeDeliveryState individual through noticeDeliveryState, retaining the exact claim's source context."
msgstr "通过 noticeDeliveryState 引用此 NoticeDeliveryState 个体，并保留精确主张的来源情境。"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This notice delivery pending value is not a default, an executable transition or a current-state winner."
msgstr "“通知投递待定”值不是默认值、可执行转换或胜出的当前状态。"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStatePending|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStatePending ."
msgstr "例如：ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStatePending ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|http://www.w3.org/2000/01/rdf-schema#label"
msgid "notice delivery attempted"
msgstr "通知投递已尝试"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source reports a notice-delivery attempt."
msgstr "来源报告已尝试投递通知。"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for the source's explicit notice delivery attempted classification."
msgstr "用于来源明确的“通知投递已尝试”分类。"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Attempted is distinct from delivered, failed and unknown delivery."
msgstr "尝试区别于已送达、失败及送达未知。"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference this NoticeDeliveryState individual through noticeDeliveryState, retaining the exact claim's source context."
msgstr "通过 noticeDeliveryState 引用此 NoticeDeliveryState 个体，并保留精确主张的来源情境。"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "This notice delivery attempted value is not a default, an executable transition or a current-state winner."
msgstr "“通知投递已尝试”值不是默认值、可执行转换或胜出的当前状态。"

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateAttempted|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStateAttempted ."
msgstr "例如：ex:record gmeow:noticeDeliveryState gmeow:noticeDeliveryStateAttempted ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeDeliveryStateDelivered|http://www.w3.org/2000/01/rdf-schema#label"
msgid "notice delivered"
msgstr "通知已送达"

