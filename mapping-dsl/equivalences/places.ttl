# gmeow:alternateName was RETIRED (issue #105, Principle 6): a place's multilingual
# /historical names are now co-equal gmeow:PlaceName appellations borne via
# gmeow:hasPlaceName (names mapset — aligned to CIDOC E48 Place Name, GeoNames
# gn:name, schema:name). The former flat-literal "alternate" senses
# (schema:alternateName, skos:altLabel, gn:alternateName) are emitted in the
# PROJECTION layer as the downcast of NON-selected place names — deliberately NOT
# term-level equivalences, because GMEOW recognises no primary-vs-alternate ranking.

gmeow:eqPlaces047 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Location ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject crm:E53_Place ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "Place" ;
    gmeow:sssomFile "gmeow-places.sssom.tsv" .

gmeow:eqPlaces048 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Location ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject bfo:BFO_0000029 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "site" ;
    gmeow:sssomFile "gmeow-places.sssom.tsv" .

gmeow:eqPlaces049 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Location ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject bfo:BFO_0000006 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "spatial region" ;
    gmeow:sssomFile "gmeow-places.sssom.tsv" .

gmeow:eqPlaces050 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:proximity ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:distance ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "schema.org:distance is a flat property with range QuantitativeValue or Text; GMEOW proximity is a reified Measurement with frame-declared metric kind. Directional lossy projection." ;
    gmeow:sssomFile "gmeow-places.sssom.tsv" .

# Pose / Orientation alignments (#78). GMEOW separates position (SpatialCoordinates)
# from pose; the compound Pose+Orientation design aligns by reference to the IEEE
# 1872-2015 CORA/POS ontology (pos:QuantitativePose, pos:OrientationMeasure) and
# to Wikidata items for the mathematical concepts.

gmeow:eqPlaces051 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Pose ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject pos:QuantitativePose ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "Quantitative Pose" ;
    gmeow:sssomFile "gmeow-places.sssom.tsv" .

gmeow:eqPlaces052 a gmeow:TermEquivalence ;
