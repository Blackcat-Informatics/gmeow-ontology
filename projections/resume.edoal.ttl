@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/resume> a align:Alignment ;
    rdfs:label "GMEOW → resume (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "Employment type → schema:employmentType"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:compose ( [ a edoal:Relation ;
                                edoal:uri gmeow:employmentType ] [ a edoal:Relation ;
                                edoal:uri rdfs:label ] ) ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri schema:employmentType ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "Employment interval end → schema:endDate"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:compose ( [ a edoal:Relation ;
                                edoal:uri gmeow:employmentInterval ] [ a edoal:Relation ;
                                edoal:uri gmeow:endedAtTime ] ) ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri schema:endDate ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "Employment role → schema:jobTitle (resume profile)"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:compose ( [ a edoal:Relation ;
                                edoal:uri gmeow:hasRole ] [ a edoal:Relation ;
                                edoal:or ( [ a edoal:Relation ;
                                            edoal:uri rdfs:label ] [ a edoal:Relation ;
                                            edoal:uri gmeow:name ] ) ] ) ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri schema:jobTitle ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnMembershipToJobTitle ] ],
        [ a align:Cell ;
            rdfs:label "Employment interval start → schema:startDate"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:compose ( [ a edoal:Relation ;
                                edoal:uri gmeow:employmentInterval ] [ a edoal:Relation ;
                                edoal:uri gmeow:startedAtTime ] ) ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri schema:startDate ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "Employment organization → schema:worksFor (resume profile)"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:membershipOrganization ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri schema:worksFor ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "resume" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@en .
