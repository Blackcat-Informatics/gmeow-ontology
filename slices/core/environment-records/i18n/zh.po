msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestFulfilled|http://www.w3.org/2004/02/skos/core#example"
msgid "For example: ex:record gmeow:noticeKind gmeow:noticeKindRequestFulfilled ."
msgstr "例如：ex:record gmeow:noticeKind gmeow:noticeKindRequestFulfilled ."

msgctxt "https://blackcatinformatics.ca/gmeow/noticeKindRequestWithdrawn|http://www.w3.org/2000/01/rdf-schema#label"
