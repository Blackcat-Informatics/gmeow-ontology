#
# Declarative structural assertions for the temporal slice — the slice-resident
# test-DSL twin of the MUST invariants formerly hand-written in
# tests/test_temporal.py. Authored as gmeow: ontology data so the same annotation
# discipline and the native Rust harness (crates/slicetest) drive the test,
# not ad-hoc Python. Each assertion runs as a SPARQL ASK over the slice module
# graph (gmeow:scopeModule); every `must` ASK anchors on a concrete term IRI.
#
# NAMESPACE: the temporal module is migrated — its gUFO-stereotyped spine is
# typed with the logic: stereotype vocabulary (logic:Situation,
# logic:AbstractIndividual, logic:Relator). These cells mirror the module's
# CURRENT logic: shape.
#
# RETAINED in pytest (not migratable here):
#   * test_reified_residence_and_tenure_are_time_scoped (tests/test_temporal.py)
#     — CROSS-SLICE: gmeow:MailboxResidence (extensions/email) and
#     gmeow:AddressTenure (core/contacts) ⊑ gmeow:TimeScopedRelation. The
#     subclass edges live in those OTHER slices' modules, not here.
#   * test_no_owl_all_disjoint_properties_over_interval_relations
#     (tests/test_allen_jepd.py) — whole-graph sweep over every
#     owl:AllDisjointProperties to ensure no interval-level Allen relation is
#     grouped into an OWL disjoint-properties axiom; not a finite module-scoped
#     ASK.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/temporal/tests/> .

# --- 1. TimeScopedRelation ⊑ logic:Situation (MUST hold) ---------------------
ex:saTimeScopedRelationIsLogicSituation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:TimeScopedRelation rdfs:subClassOf logic:Situation . }""" ;
    gmeow:saRationale "gmeow:TimeScopedRelation reifies a relation that holds over an interval: it MUST be a subClassOf logic:Situation (the migrated stereotype) so residence and tenure are situations, not relators." .

# --- 2. validFrom / validUntil are AnnotationProperties (MUST hold) ----------
ex:saValidityPredicatesAreAnnotationProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:validFrom  a owl:AnnotationProperty .
    gmeow:validUntil a owl:AnnotationProperty .
}""" ;
    gmeow:saRationale "The lightweight RDF-star validity clocks gmeow:validFrom / gmeow:validUntil MUST each be an owl:AnnotationProperty — statement-layer annotations, not first-class object/datatype edges." .

# --- 3. Instant ⊑ logic:AbstractIndividual (MUST hold) -----------------------
ex:saInstantSubclassesLogicAbstractIndividual a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:Instant rdfs:subClassOf logic:AbstractIndividual . }""" ;
    gmeow:saRationale "A gmeow:Instant is a reified zero-duration point: it MUST be a subClassOf logic:AbstractIndividual (the migrated stereotype)." .

# --- 4. TimeInterval has start and end Instants (MUST hold) ------------------
ex:saTimeIntervalHasStartAndEndInstants a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasStartInstant a owl:ObjectProperty ;
        rdfs:domain gmeow:TimeInterval ;
        rdfs:range gmeow:Instant .
    gmeow:hasEndInstant a owl:ObjectProperty ;
        rdfs:domain gmeow:TimeInterval ;
        rdfs:range gmeow:Instant .
}""" ;
    gmeow:saRationale "gmeow:hasStartInstant / gmeow:hasEndInstant MUST each be an owl:ObjectProperty with domain gmeow:TimeInterval and range gmeow:Instant — the interval's two reified endpoints." .

# --- 5. TimeInterval can carry a TemporalFrame (MUST hold) -------------------
ex:saTimeIntervalCanHaveTemporalFrame a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasTemporalFrame a owl:ObjectProperty ;
        rdfs:domain gmeow:TimeInterval ;
        rdfs:range gmeow:TemporalFrame .
}""" ;
    gmeow:saRationale "gmeow:hasTemporalFrame MUST be an owl:ObjectProperty with domain gmeow:TimeInterval and range gmeow:TemporalFrame — the frame edge satisfying the interval's frame-relativity requirement (P11)." .

# --- 6. TemporalMeasurement ⊑ logic:Relator (MUST hold) ----------------------
ex:saTemporalMeasurementIsLogicRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:TemporalMeasurement rdfs:subClassOf logic:Relator . }""" ;
    gmeow:saRationale "gmeow:TemporalMeasurement reifies a dating claim (method, age, uncertainty): it MUST be a subClassOf logic:Relator (the migrated stereotype), not a Situation." .
# ===========================================================================
# EDTF / Instant vocabulary (migrated from tests/test_edtf.py)
# ===========================================================================

# --- 7. edtfValue is a DatatypeProperty (MUST) -------------------------------
ex:saEdtfValueIsDatatypeProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:edtfValue a owl:DatatypeProperty . }""" ;
    gmeow:saRationale "gmeow:edtfValue MUST be an owl:DatatypeProperty — the ISO 8601-2 EDTF expression of an instant or interval is carried as a plain literal (Principle 3)." .

# --- 8. edtfValue ranges over rdfs:Literal (MUST) ----------------------------
ex:saEdtfValueRangeIsLiteral a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:edtfValue rdfs:range rdfs:Literal . }""" ;
    gmeow:saRationale "gmeow:edtfValue MUST range over rdfs:Literal — EDTF strings are plain literals, not xsd:dateTime (Principle 3)." .

# --- 9. Instant exists and instantValue has correct shape (MUST) -------------
ex:saInstantExistsAndHasInstantValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:Instant a owl:Class .
    gmeow:instantValue a owl:DatatypeProperty ;
        rdfs:domain gmeow:Instant ;
        rdfs:range xsd:dateTime .
}""" ;
    gmeow:saRationale "gmeow:Instant MUST exist as an owl:Class and gmeow:instantValue MUST be an owl:DatatypeProperty with domain gmeow:Instant and range xsd:dateTime — the crisp, machine-computable point value (Principle 3)." .

# ===========================================================================
# Allen interval relations (migrated from tests/test_allen_jepd.py)
# ===========================================================================

# --- 10. All thirteen interval-level Allen relations exist (MUST) -------------
ex:saAllIntervalLevelAllenRelationsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?rel {
        gmeow:intervalBefore
        gmeow:intervalAfter
        gmeow:intervalMeets
        gmeow:intervalMetBy
        gmeow:intervalOverlaps
        gmeow:intervalOverlappedBy
        gmeow:intervalStarts
        gmeow:intervalStartedBy
        gmeow:intervalDuring
        gmeow:intervalContains
        gmeow:intervalFinishes
        gmeow:intervalFinishedBy
        gmeow:intervalCoincidesWith
    }
    ?rel a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "All thirteen interval-level Allen relations MUST exist as owl:ObjectProperty — the complete JEPD relation set for TimeInterval ordering." .

# --- 11. intervalBefore and intervalAfter are transitive (MUST) --------------
ex:saIntervalBeforeAndAfterAreTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:intervalBefore a owl:TransitiveProperty .
    gmeow:intervalAfter  a owl:TransitiveProperty .
}""" ;
    gmeow:saRationale "gmeow:intervalBefore and gmeow:intervalAfter MUST each be owl:TransitiveProperty — strict ordering chains across a sequence of intervals." .

# --- 12. intervalCoincidesWith is symmetric and transitive (MUST) ------------
ex:saIntervalCoincidesWithIsSymmetricAndTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:intervalCoincidesWith a owl:SymmetricProperty , owl:TransitiveProperty .
}""" ;
    gmeow:saRationale "gmeow:intervalCoincidesWith MUST be both owl:SymmetricProperty and owl:TransitiveProperty — Allen EQUALS is co-extensionality, which is symmetric and transitive (but not identity: distinct intervals may coincide)." .

# --- 13. No event/interval relation pair is property-disjoint in OWL (MUST-NOT)
ex:saNoEventIntervalPropertyDisjointnessInOwl a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES (?eventRel ?intervalRel) {
        (gmeow:before          gmeow:intervalBefore)
        (gmeow:after           gmeow:intervalAfter)
        (gmeow:meets           gmeow:intervalMeets)
        (gmeow:metBy           gmeow:intervalMetBy)
        (gmeow:overlaps        gmeow:intervalOverlaps)
        (gmeow:overlappedBy    gmeow:intervalOverlappedBy)
        (gmeow:starts          gmeow:intervalStarts)
        (gmeow:startedBy       gmeow:intervalStartedBy)
        (gmeow:during          gmeow:intervalDuring)
        (gmeow:contains        gmeow:intervalContains)
        (gmeow:finishes        gmeow:intervalFinishes)
        (gmeow:finishedBy      gmeow:intervalFinishedBy)
        (gmeow:coincidesWith   gmeow:intervalCoincidesWith)
    }
    { ?eventRel owl:propertyDisjointWith ?intervalRel }
    UNION
    { ?intervalRel owl:propertyDisjointWith ?eventRel }
}""" ;
    gmeow:saRationale "No event-level Allen relation and its interval-level twin MUST be declared owl:propertyDisjointWith in OWL — several interval relations are transitive (non-simple), and OWL 2 DL forbids DisjointObjectProperties over non-simple properties. JEPD disjointness is enforced in SHACL / solver instead." .

# ===========================================================================
# Named periods (migrated from tests/test_named_period.py)
# ===========================================================================

# --- 14. NamedPeriod subclasses Entity (MUST) --------------------------------
ex:saNamedPeriodSubclassesEntity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:NamedPeriod a owl:Class ;
        rdfs:subClassOf gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:NamedPeriod MUST be an owl:Class and a subclass of gmeow:Entity — a geologic era, dynasty, or fiscal year is a first-class identifiable entity." .

# --- 15. PeriodType exists (MUST) --------------------------------------------
ex:saPeriodTypeExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:PeriodType a owl:Class . }""" ;
    gmeow:saRationale "gmeow:PeriodType MUST exist as an owl:Class — the value vocabulary that classifies named periods by kind (geologic rank, historical era, fiscal year)." .

# --- 16. Seed geologic periods exist (MUST) ----------------------------------
ex:saSeedGeologicPeriodsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:periodPhanerozoic a gmeow:NamedPeriod .
    gmeow:periodCenozoic    a gmeow:NamedPeriod .
    gmeow:periodQuaternary  a gmeow:NamedPeriod .
    gmeow:periodHolocene    a gmeow:NamedPeriod .
}""" ;
    gmeow:saRationale "The four seed geologic periods (Phanerozoic, Cenozoic, Quaternary, Holocene) MUST exist as gmeow:NamedPeriod individuals — they bootstrap the geologic-timescale examples." .

# --- 17. periodPartOf is transitive (MUST) -----------------------------------
ex:saPeriodPartOfIsTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:periodPartOf a owl:TransitiveProperty . }""" ;
    gmeow:saRationale "gmeow:periodPartOf MUST be owl:TransitiveProperty — epoch-within-period-within-era nesting chains transitively." .

# --- 18. periodPartOf seed links form the geologic ladder (MUST) -------------
ex:saPeriodPartOfLinks a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:periodHolocene   gmeow:periodPartOf gmeow:periodQuaternary .
    gmeow:periodQuaternary gmeow:periodPartOf gmeow:periodCenozoic .
    gmeow:periodCenozoic   gmeow:periodPartOf gmeow:periodPhanerozoic .
}""" ;
    gmeow:saRationale "The seed geologic periods MUST be linked by gmeow:periodPartOf in the expected ladder (Holocene → Quaternary → Cenozoic → Phanerozoic)." .

# --- 19. periodContainsPeriod is inverse of periodPartOf (MUST) --------------
ex:saPeriodContainsPeriodIsInverse a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:periodContainsPeriod owl:inverseOf gmeow:periodPartOf .
}""" ;
    gmeow:saRationale "gmeow:periodContainsPeriod MUST be the owl:inverseOf gmeow:periodPartOf — the whole-rooted view of period nesting." .

# ===========================================================================
# Temporal frame profile (migrated from tests/test_temporal_frame.py)
# ===========================================================================

# --- 20. TemporalFrame ⊑ logic:Object AND ⊑ ReferenceFrame (MUST) ------------
ex:saTemporalFrameSubclassesReferenceFrame a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:TemporalFrame rdfs:subClassOf gmeow:ReferenceFrame .
    gmeow:TemporalFrame rdfs:subClassOf logic:Object .
}""" ;
    gmeow:saRationale "gmeow:TemporalFrame MUST be a subclass of both gmeow:ReferenceFrame (the frame supertype, so generic frame consumers read it) and logic:Object (the migrated endurant stereotype) — a temporal frame is a first-class reference system, the time counterpart of the spatial reference frame." .

# --- 21. temporalFrameUTCGregorian is fully componented (MUST) ----------------
ex:saTemporalFrameUTCGregorianComponents a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:temporalFrameUTCGregorian a gmeow:TemporalFrame ;
        gmeow:frameTimeScale gmeow:timeScaleUTC ;
        gmeow:frameCalendarSystem gmeow:calendarGregorian ;
        gmeow:frameRealm gmeow:frameRealmTemporal ;
        gmeow:frameKind gmeow:frameKindTemporal .
}""" ;
    gmeow:saRationale "The seed civil frame gmeow:temporalFrameUTCGregorian MUST be a gmeow:TemporalFrame decomposed into its UTC time scale and Gregorian calendar, and tagged with the temporal realm and kind — the canonical worked frame every crisp civil timestamp resolves against." .

# --- 23. hasTemporalFrame is a subproperty of hasReferenceFrame (MUST) -------
ex:saHasTemporalFrameSubpropertyOfReferenceFrame a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasTemporalFrame a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:hasReferenceFrame ;
        rdfs:domain gmeow:TimeInterval ;
        rdfs:range gmeow:TemporalFrame .
}""" ;
    gmeow:saRationale "gmeow:hasTemporalFrame MUST be an owl:ObjectProperty from gmeow:TimeInterval to gmeow:TemporalFrame that specializes gmeow:hasReferenceFrame — the interval's frame edge, read uniformly by generic frame consumers across the spatial and temporal profiles." .

# --- 24. inTemporalFrame is a subproperty of hasReferenceFrame (MUST) --------
ex:saInTemporalFrameSubpropertyOfReferenceFrame a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:inTemporalFrame a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:hasReferenceFrame ;
        rdfs:domain gmeow:Instant ;
        rdfs:range gmeow:TemporalFrame .
}""" ;
    gmeow:saRationale "gmeow:inTemporalFrame MUST be an owl:ObjectProperty from gmeow:Instant to gmeow:TemporalFrame that specializes gmeow:hasReferenceFrame — the point's frame edge, the parallel of gmeow:hasTemporalFrame for intervals." .

# ===========================================================================
# Temporal measurement + dating methods (migrated from
# tests/test_temporal_measurement.py)
# ===========================================================================

# --- 25. TemporalMeasurement and DatingMethod both exist (MUST) --------------
ex:saTemporalMeasurementAndDatingMethodExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:TemporalMeasurement a owl:Class .
    gmeow:DatingMethod a owl:Class .
}""" ;
    gmeow:saRationale "Both gmeow:TemporalMeasurement (the reified dating claim) and gmeow:DatingMethod (its method value vocabulary) MUST exist as owl:Class — the spine of the temporal-dating domain." .

# --- 26. Seed dating methods exist (MUST) ------------------------------------
ex:saSeedDatingMethodsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:datingMethodRadiocarbon a gmeow:DatingMethod .
    gmeow:datingMethodDendrochronology a gmeow:DatingMethod .
    gmeow:datingMethodThermoluminescence a gmeow:DatingMethod .
    gmeow:datingMethodPotassiumArgon a gmeow:DatingMethod .
    gmeow:datingMethodUraniumLead a gmeow:DatingMethod .
}""" ;
    gmeow:saRationale "The five seed dating-method individuals (radiocarbon, dendrochronology, thermoluminescence, potassium-argon, uranium-lead) MUST exist as gmeow:DatingMethod individuals — the bootstrap value vocabulary for how a temporal measurement was derived, minted as individuals never subclasses." .

# --- 28. measuredAge ranges over xsd:decimal (MUST) --------------------------
ex:saMeasuredAgeRangeIsDecimal a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK { gmeow:measuredAge rdfs:range xsd:decimal . }""" ;
    gmeow:saRationale "gmeow:measuredAge MUST range over xsd:decimal — a measured elapsed-time figure is an exact decimal quantity paired with a unit, not a floating-point approximation." .

# --- 29. measurementDeterminacy ranges over Determinacy (MUST) ---------------
ex:saMeasurementDeterminacyRangeIsDeterminacy a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:measurementDeterminacy rdfs:range gmeow:Determinacy . }""" ;
    gmeow:saRationale "gmeow:measurementDeterminacy MUST range over gmeow:Determinacy — the ontic determinacy model of a dating result (crisp, vague, fuzzy, probabilistic, disputed) is drawn from the shared Determinacy value vocabulary." .

# --- 30. DatingMethod ⊑ ObservationMethod (MUST) -----------------------------
ex:saDatingMethodSubclassesObservationMethod a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:DatingMethod rdfs:subClassOf gmeow:ObservationMethod . }""" ;
    gmeow:saRationale "gmeow:DatingMethod MUST be a subclass of gmeow:ObservationMethod — a dating technique specializes the domain-neutral observation-method vocabulary for the temporal-dating domain." .

# --- 31. measuredDate is NOT a subproperty of observationResult (MUST-NOT) ----
ex:saMeasuredDateNotBridgedToObservationResult a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:measuredDate rdfs:subPropertyOf gmeow:observationResult . }""" ;
    gmeow:saRationale "gmeow:measuredDate MUST NOT be asserted rdfs:subPropertyOf gmeow:observationResult: it plays the observationResult role only semantically, but gmeow:Instant (an abstract individual) is not a gmeow:Entity (an endurant), the range of observationResult, so the bridge would be ill-typed — the alignment lives in the projection mapping only." .

# --- 32. measurementMethod bridges to observationMethod (MUST) ---------------
ex:saMeasurementMethodBridgesToObservationMethod a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:measurementMethod rdfs:subPropertyOf gmeow:observationMethod . }""" ;
    gmeow:saRationale "gmeow:measurementMethod MUST be rdfs:subPropertyOf gmeow:observationMethod — the bridge that lets domain-neutral consumers query every observation by its method without knowing it is a dating method." .

# --- 33. measurementDeterminacy bridges to hasDeterminacy (MUST) -------------
ex:saMeasurementDeterminacyBridgesToHasDeterminacy a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:measurementDeterminacy rdfs:subPropertyOf gmeow:hasDeterminacy . }""" ;
    gmeow:saRationale "gmeow:measurementDeterminacy MUST be rdfs:subPropertyOf gmeow:hasDeterminacy — the bridge exposing a dating result's determinacy to generic determinacy queries across all domains." .

# --- 34. periodStart property chain from a measurement (MUST) ----------------
ex:saPeriodStartPropertyChainFromMeasurement a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:periodStart owl:propertyChainAxiom ( gmeow:hasTemporalMeasurement gmeow:measuredDate ) . }""" ;
    gmeow:saRationale "gmeow:periodStart MUST carry the ordered owl:propertyChainAxiom (gmeow:hasTemporalMeasurement ∘ gmeow:measuredDate) — a named period's start instant is derivable from a temporal measurement's measured date, so a period bounded only by a dated measurement still has a computable start." .

# --- 35. Seed measurements carry vantage, observed feature, method (MUST) ----
ex:saSeedMeasurementsCarryVantageAndObservedFeature a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:measurementPhanerozoicStart a gmeow:TemporalMeasurement ;
        gmeow:vantage [] ; gmeow:observedFeature [] ; gmeow:observationMethod [] .
    gmeow:measurementCenozoicStart a gmeow:TemporalMeasurement ;
        gmeow:vantage [] ; gmeow:observedFeature [] ; gmeow:observationMethod [] .
    gmeow:measurementQuaternaryStart a gmeow:TemporalMeasurement ;
        gmeow:vantage [] ; gmeow:observedFeature [] ; gmeow:observationMethod [] .
    gmeow:measurementHoloceneStart a gmeow:TemporalMeasurement ;
        gmeow:vantage [] ; gmeow:observedFeature [] ; gmeow:observationMethod [] .
}""" ;
    gmeow:saRationale "Each of the four seed geologic-boundary measurements MUST be a gmeow:TemporalMeasurement carrying a gmeow:vantage (the dating agent), a gmeow:observedFeature (the dated period), and a gmeow:observationMethod — the standpoint-indexed-claim shape (P9), never a bare ground-truth value." .
