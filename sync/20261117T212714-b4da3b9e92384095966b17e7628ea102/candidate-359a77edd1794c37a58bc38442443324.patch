+
 math:Eigendecomposition skos:closeMatch wd:Q190524 {|
     a logic:GroundingCorrespondence ;
     gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
@@ -2933,3 +2949,29 @@ math:CombinatorialLaplacian skos:relatedMatch wd:Q772067 {|
     logic:morphismKind logic:InstitutionMorphism ;
     logic:preservationKind logic:ValidationOnly
 |} .
+
+math:ExplainedVariance skos:relatedMatch wd:Q2510752 {|
