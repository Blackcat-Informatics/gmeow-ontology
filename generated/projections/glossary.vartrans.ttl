    a ontolex:Form ;
    ontolex:writtenRep "Multivector"@en .

<http://example.org/lang/glossary-vartrans/form-src/b67d064d398a5e1e>
    a ontolex:Form ;
    ontolex:writtenRep "GMN candidate: left contraction"@en .

<http://example.org/lang/glossary-vartrans/form-src/b698848d24c44ea4>
    a ontolex:Form ;
    ontolex:writtenRep "The axis for information moved into the ontology: annotation-coat completeness on every term including A-Box individuals, epistemic-shape coverage (contested/suppressed/ambiguous/time-scoped cases), and prose-to-axiom harvest coverage. It is NOT prose quality (that judges how well the strings read) — this axis measures whether the required information is present at all (SLICE_GUIDE §6)."@en .

