@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://blackcatinformatics.ca/gmeow/examples/ai/assistant>
    a gmeow:SoftwareAgent ;
    rdfs:label "facilities assistant model"@en ;
    gmeow:hasGoal <https://blackcatinformatics.ca/gmeow/examples/ai/goal-answer-faithfully> .

<https://blackcatinformatics.ca/gmeow/examples/ai/auditor>
    a gmeow:SoftwareAgent ;
    rdfs:label "grounding auditor"@en .

<https://blackcatinformatics.ca/gmeow/examples/ai/card-assistant>
    a gmeow:ModelCard ;
    gmeow:describesModel <https://blackcatinformatics.ca/gmeow/examples/ai/assistant> ;
    gmeow:modelContextWindow "200000"^^xsd:positiveInteger ;
    gmeow:modelProvider "Example Labs" ;
    gmeow:modelTrainingCutoff "2026-01-31"^^xsd:date ;
    gmeow:modelVersionTag "assistant-2026-05-01" .

<https://blackcatinformatics.ca/gmeow/examples/ai/chunk-042>
    a gmeow:Chunk ;
    gmeow:chunkOf <https://blackcatinformatics.ca/gmeow/examples/ai/handbook> ;
    gmeow:contentDigest "blake3:1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f809" ;
    gmeow:spanEnd "18950"^^xsd:nonNegativeInteger ;
    gmeow:spanStart "18200"^^xsd:nonNegativeInteger .

<https://blackcatinformatics.ca/gmeow/examples/ai/claim-close-2200>
    a gmeow:MemoryItem ,
        gmeow:StandpointClaim ;
    gmeow:claimModality gmeow:probable ;
    gmeow:groundedIn <https://blackcatinformatics.ca/gmeow/examples/ai/span-close-2200> ;
    gmeow:memoryKind gmeow:memoryKindSemantic ;
    gmeow:memoryOf <https://blackcatinformatics.ca/gmeow/examples/ai/assistant> ;
    gmeow:observationMethod gmeow:methodLlmExtraction ;
    gmeow:observedFeature <https://blackcatinformatics.ca/gmeow/examples/ai/stmt-2200> ;
    gmeow:vantage <https://blackcatinformatics.ca/gmeow/examples/ai/assistant> ;
    gmeow:wasAttributedTo <https://blackcatinformatics.ca/gmeow/examples/ai/assistant> ;
    gmeow:wasGeneratedBy <https://blackcatinformatics.ca/gmeow/examples/ai/invocation-19> .

<https://blackcatinformatics.ca/gmeow/examples/ai/claim-close-2300>
    a gmeow:StandpointClaim ;
    gmeow:claimModality gmeow:probable ;
    gmeow:observationMethod gmeow:methodLlmExtraction ;
    gmeow:observedFeature <https://blackcatinformatics.ca/gmeow/examples/ai/stmt-2300> ;
    gmeow:vantage <https://blackcatinformatics.ca/gmeow/examples/ai/assistant> ;
    gmeow:wasAttributedTo <https://blackcatinformatics.ca/gmeow/examples/ai/assistant> ;
    gmeow:wasGeneratedBy <https://blackcatinformatics.ca/gmeow/examples/ai/invocation-19> .

<https://blackcatinformatics.ca/gmeow/examples/ai/contradiction-close>
    a gmeow:Contradiction ;
    gmeow:contradictionKind gmeow:contradictionKindNumeric ;
    gmeow:contradictsClaim <https://blackcatinformatics.ca/gmeow/examples/ai/claim-close-2200> ,
        <https://blackcatinformatics.ca/gmeow/examples/ai/claim-close-2300> ;
    gmeow:detectedBy <https://blackcatinformatics.ca/gmeow/examples/ai/auditor> .

<https://blackcatinformatics.ca/gmeow/examples/ai/east-wing>
    gmeow:validUntil "2026-12-31T22:00:00Z"^^xsd:dateTime .

<https://blackcatinformatics.ca/gmeow/examples/ai/goal-answer-faithfully>
    a gmeow:Goal ;
    rdfs:label "answer facilities questions faithfully to the handbook"@en .

<https://blackcatinformatics.ca/gmeow/examples/ai/handbook>
    a gmeow:Document ;
    rdfs:label "facilities handbook, 2026 edition"@en ;
    gmeow:contentDigest "blake3:9f8e7d6c5b4a39281706f5e4d3c2b1a09f8e7d6c5b4a39281706f5e4d3c2b1a0" ,
        "md5:7b14f3681bed923ac3ddf9af885a5086" ,
        "sha256:45441a53c39d0908231f626f36c99661e78108aca3cb8271e9085d732cb1f3f6" ;
    gmeow:sourceLocation "https://blackcatinformatics.ca/gmeow/examples/graphrag/facilities-handbook-2026" .

<https://blackcatinformatics.ca/gmeow/examples/ai/invocation-19>
    a gmeow:ModelInvocation ;
    gmeow:atTime "2026-05-15T10:00:00Z"^^xsd:dateTime ;
    gmeow:eventTemporalFrame gmeow:temporalFrameUTCGregorian ;
    gmeow:hasPrompt <https://blackcatinformatics.ca/gmeow/examples/ai/prompt-extract> ;
    gmeow:samplingTemperature 0.0 ;
    gmeow:usedModel <https://blackcatinformatics.ca/gmeow/examples/ai/assistant> .

<https://blackcatinformatics.ca/gmeow/examples/ai/prompt-extract>
    a gmeow:Prompt ;
    gmeow:contentDigest "blake3:00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff" ;
    gmeow:filledFrom <https://blackcatinformatics.ca/gmeow/examples/ai/template-extract-v1> ;
    gmeow:promptRole gmeow:promptRoleSystem .

<https://blackcatinformatics.ca/gmeow/examples/ai/span-close-2200>
    a gmeow:EvidenceSpan ;
    gmeow:spanEnd "366"^^xsd:nonNegativeInteger ;
    gmeow:spanOfChunk <https://blackcatinformatics.ca/gmeow/examples/ai/chunk-042> ;
    gmeow:spanStart "310"^^xsd:nonNegativeInteger ;
    gmeow:supportPolarity gmeow:polaritySupports .

<https://blackcatinformatics.ca/gmeow/examples/ai/stmt-2200>
    a owl:Axiom ;
    owl:annotatedProperty gmeow:validUntil ;
    owl:annotatedSource <https://blackcatinformatics.ca/gmeow/examples/ai/east-wing> ;
    owl:annotatedTarget "2026-12-31T22:00:00Z"^^xsd:dateTime .

<https://blackcatinformatics.ca/gmeow/examples/ai/stmt-2300>
    a owl:Axiom ;
    owl:annotatedProperty gmeow:validUntil ;
    owl:annotatedSource <https://blackcatinformatics.ca/gmeow/examples/ai/east-wing> ;
    owl:annotatedTarget "2026-12-31T23:00:00Z"^^xsd:dateTime .

<https://blackcatinformatics.ca/gmeow/examples/ai/stmt-2300-is-claimed>
    a owl:Axiom ;
    owl:annotatedProperty gmeow:claimModality ;
    owl:annotatedSource <https://blackcatinformatics.ca/gmeow/examples/ai/claim-close-2300> ;
    owl:annotatedTarget gmeow:probable .

<https://blackcatinformatics.ca/gmeow/examples/ai/template-extract-v1>
    a gmeow:PromptTemplate ;
    rdfs:label "claim-extraction template v1"@en ;
    gmeow:promptRole gmeow:promptRoleSystem .

<https://blackcatinformatics.ca/gmeow/examples/ai/verdict-2300>
    a gmeow:StandpointClaim ;
    gmeow:claimModality gmeow:bullshit ;
    gmeow:claimVeridicality gmeow:veridicalityUntrue ;
    gmeow:observationMethod gmeow:methodNliDerivation ;
    gmeow:observedFeature <https://blackcatinformatics.ca/gmeow/examples/ai/stmt-2300-is-claimed> ;
    gmeow:vantage <https://blackcatinformatics.ca/gmeow/examples/ai/auditor> .
