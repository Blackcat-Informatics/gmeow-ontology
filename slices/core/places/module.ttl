    gmeow:graphBoxRole gmeow:boxABox .

gmeow:tenureTypeUsufruct
    a gmeow:LandTenureType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/places> ;
    rdfs:label "usufruct"@x-gmeow-english ;
