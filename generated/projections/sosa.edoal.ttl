@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/sosa>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:ObservableProperty ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri sosa:ObservableProperty ;
        ] ;
        align:relation "<=" ;
        rdfs:label "ObservableProperty → sosa:ObservableProperty"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:Sensor ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri sosa:Sensor ;
            ] ;
            align:relation "<=" ;
            rdfs:label "Sensor → sosa:Sensor"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:SensorPlatform ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri sosa:Platform ;
            ] ;
            align:relation "<=" ;
            rdfs:label "SensorPlatform → sosa:Platform"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:SensoryObservation ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri sosa:Observation ;
            ] ;
            align:relation "<=" ;
            rdfs:label "SensoryObservation → sosa:Observation"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:platformLocation ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri geo:location ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            rdfs:label "platformLocation → geo:location (SOSA has no direct platform-location property)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:sensoryObservationOf ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri sosa:hasFeatureOfInterest ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "sensoryObservationOf → sosa:hasFeatureOfInterest"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:sensoryProperty ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri sosa:observedProperty ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "sensoryProperty → sosa:observedProperty"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:sensoryResult ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri sosa:hasResult ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "sensoryResult → sosa:hasResult (scalar quantity value)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:vantage ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri sosa:madeBySensor ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "vantage (Sensor) → sosa:madeBySensor"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "sosa" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → sosa (EDOAL)"@en .
