    gmeow:strandBoth        a gmeow:StrandOrientation .
}""" ;
    gmeow:saRationale "gmeow:StrandOrientation MUST be a subclass of logic:QualityValue; three seed individuals MUST exist." .

# --- 96. SequenceCoordinates core properties (MUST) ---------------------------
ex:saSequenceCoordinatesProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:sequenceStart a owl:DatatypeProperty ;
        rdfs:domain gmeow:SequenceCoordinates ;
        rdfs:range  xsd:positiveInteger .
    gmeow:sequenceEnd   a owl:DatatypeProperty ;
        rdfs:domain gmeow:SequenceCoordinates ;
        rdfs:range  xsd:positiveInteger .
    gmeow:sequenceStrand a owl:ObjectProperty ;
        rdfs:domain gmeow:SequenceCoordinates ;
        rdfs:range  gmeow:StrandOrientation .
    gmeow:inReferenceAssembly a owl:ObjectProperty ;
        rdfs:domain gmeow:SequenceCoordinates ;
        rdfs:range  gmeow:ReferenceFrame ;
        rdfs:subPropertyOf gmeow:hasReferenceFrame .
}""" ;
    gmeow:saRationale "Core SequenceCoordinates properties MUST have the correct types, domain/range (their functional-property status is now carried by logic:PropertyCharacteristicAssertions, DL-enforced)." .

# --- 97. hasSequenceCoordinates and sequenceFeatureType shapes (MUST + MUST-NOT) --
ex:saSequenceFeaturePropertyShapes a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasSequenceCoordinates a owl:ObjectProperty ;
        rdfs:domain gmeow:SequenceFeature ;
        rdfs:range  gmeow:SequenceCoordinates .
    gmeow:sequenceFeatureType a owl:ObjectProperty ;
        rdfs:domain gmeow:SequenceFeature ;
        rdfs:range  gmeow:SequenceFeatureType .
    gmeow:hasSequenceFeature a owl:ObjectProperty ;
        rdfs:domain gmeow:BiologicalSequenceLocation ;
        rdfs:range  gmeow:SequenceFeature .
}""" ;
    gmeow:saRationale "hasSequenceCoordinates, sequenceFeatureType, and hasSequenceFeature MUST have correct domain/range." .

ex:saHasSequenceCoordinatesNotFunctional a gmeow:StructuralAssertion ;
