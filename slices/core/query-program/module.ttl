logic:and [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "freshPolicyOwner" ] ;
logic:exists [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "freshPolicyOwner" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryOrderPolicy ] ],
[ a logic:Formula ;
logic:relation gmeow:orderCriterion ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "freshPolicyOwner" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ] ] ],
[ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation gmeow:orderCriterion ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "leftOwner" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ],
[ a logic:Formula ;
