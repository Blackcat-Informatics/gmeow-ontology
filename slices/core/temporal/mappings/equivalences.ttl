|} .

gmeow:measuredAge skos:closeMatch crm:P90_has_value {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "CIDOC measured value"
|} .

gmeow:unit skos:closeMatch qudt:hasUnit {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
