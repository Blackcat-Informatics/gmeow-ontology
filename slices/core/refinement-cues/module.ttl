gmeow:CueMatchSuppressionConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "applicable suppression declaration"@x-gmeow-english ;
    skos:definition "Every supplied matchSuppressedBy rule is declared in the matched cue's negatedBy set."@x-gmeow-english ;
    gmeow:useWhen "Use to check applicable suppression declaration on the retained CueMatch record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a satisfied record law as executed detection, correct suppression, authenticated source text or external inventory completeness."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the supplied record and retain source evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "Declared applicability does not prove the existence, span or scope of a negating occurrence. Retain that evidence on the suppression assertion or its reifier."@x-gmeow-english ;
    skos:example "gmeow:CueMatchSuppressionConstraint logic:formalizes gmeow:matchSuppressedBy . names the supplied-record law."@x-gmeow-english ;
    logic:formalizes gmeow:matchSuppressedBy ;
    logic:message "Every supplied matchSuppressedBy rule is declared in the matched cue's negatedBy set." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CueMatch ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "cue" ], [ logic:termIndex 1 ; logic:termVariable "rule" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:matchedCue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "cue" ] ], [ a logic:Formula ; logic:relation gmeow:matchSuppressedBy ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "rule" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation gmeow:negatedBy ; logic:argument [ logic:termIndex 0 ; logic:termVariable "cue" ], [ logic:termIndex 1 ; logic:termVariable "rule" ] ] ] ] ] ] .

gmeow:CueEvalMatchAgreementConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "case and match agreement"@x-gmeow-english ;
    skos:definition "Every match associated with a case names the case's cue and carries the same complete RDF literal as its evalText."@x-gmeow-english ;
    gmeow:useWhen "Use to check case and match agreement on the retained CueEvalCase record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a satisfied record law as executed detection, correct suppression, authenticated source text or external inventory completeness."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the supplied record and retain source evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "Shared-variable graph joins preserve literal identity without stripping datatype, language or direction. No equality between matchRecord and the case is required."@x-gmeow-english ;
    skos:example "gmeow:CueEvalMatchAgreementConstraint logic:formalizes gmeow:evalMatch . names the supplied-record law."@x-gmeow-english ;
    logic:formalizes gmeow:evalMatch ;
    logic:message "Every match associated with a case names the case's cue and carries the same complete RDF literal as its evalText." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CueEvalCase ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "match" ], [ logic:termIndex 1 ; logic:termVariable "cue" ], [ logic:termIndex 2 ; logic:termVariable "text" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:evalMatch ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "match" ] ], [ a logic:Formula ; logic:relation gmeow:evalCue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "cue" ] ], [ a logic:Formula ; logic:relation gmeow:evalText ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "text" ] ] ] ; logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:matchedCue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "match" ], [ logic:termIndex 1 ; logic:termVariable "cue" ] ], [ a logic:Formula ; logic:relation gmeow:matchSourceLiteral ; logic:argument [ logic:termIndex 0 ; logic:termVariable "match" ], [ logic:termIndex 1 ; logic:termVariable "text" ] ] ] ] ] ] ] .

gmeow:CueJudgementBranchConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "exclusive judgement target branch"@x-gmeow-english ;
    skos:definition "A CueJudgement selects either a reported match with no judgement offsets, or a case with both missed-span offsets and no judgedMatch. Every supplied observedFeature target must be that same selected judgedMatch or judgedCase target."@x-gmeow-english ;
    gmeow:useWhen "Use to check exclusive judgement target branch on the retained CueJudgement record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a satisfied record law as executed detection, correct suppression, authenticated source text or external inventory completeness."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the supplied record and retain source evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "The branch is a supplied-record contract. It does not certify that a reported occurrence is correct or that a claimed missed occurrence was absent from an external inventory. Shared-variable target membership excludes unrelated observed subjects without requiring a duplicate observedFeature assertion."@x-gmeow-english ;
    skos:example "gmeow:CueJudgementBranchConstraint logic:formalizes gmeow:CueJudgement . names the supplied-record law."@x-gmeow-english ;
    logic:formalizes gmeow:CueJudgement ;
    logic:message "A CueJudgement selects either a reported match with no judgement offsets, or a case with both missed-span offsets and no judgedMatch. Every supplied observedFeature target must be that same selected judgedMatch or judgedCase target." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CueJudgement ] ] ; logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CueJudgement ] ] ; logic:consequent [ a logic:Formula ; logic:or [ a logic:Formula ; logic:and [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "matchTarget" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:judgedMatch ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "matchTarget" ] ] ], [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "forbiddenCase" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:judgedCase ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "forbiddenCase" ] ] ] ], [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "forbiddenStart" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:spanStart ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "forbiddenStart" ] ] ] ], [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "forbiddenEnd" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:spanEnd ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "forbiddenEnd" ] ] ] ] ], [ a logic:Formula ; logic:and [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "caseTarget" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:judgedCase ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "caseTarget" ] ] ], [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "missedStart" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:spanStart ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "missedStart" ] ] ], [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "missedEnd" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:spanEnd ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "missedEnd" ] ] ], [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "forbiddenMatch" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:judgedMatch ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "forbiddenMatch" ] ] ] ] ] ] ], [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "feature" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:observedFeature ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "feature" ] ] ; logic:consequent [ a logic:Formula ; logic:or [ a logic:Formula ; logic:relation gmeow:judgedMatch ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "feature" ] ], [ a logic:Formula ; logic:relation gmeow:judgedCase ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "feature" ] ] ] ] ] ] ] ] .

gmeow:CueMatchClosedRecordConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "CueMatch closed record"@x-gmeow-english ;
    skos:definition "A CueMatch record uses only its declared fields and the admitted type, attribution, provenance and descriptive metadata predicates."@x-gmeow-english ;
    gmeow:useWhen "Use to check CueMatch closed record on the retained CueMatch record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a satisfied record law as executed detection, correct suppression, authenticated source text or external inventory completeness."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized formula against the supplied record and retain source evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "Predicate closure is distinct from required-path and value constraints. Independent RDF 1.2 statement reifiers can carry richer evidence without putting unknown fields on the closed record."@x-gmeow-english ;
    skos:example "gmeow:CueMatchClosedRecordConstraint logic:formalizes gmeow:CueMatch . names the supplied-record law."@x-gmeow-english ;
    logic:formalizes gmeow:CueMatch ;
    logic:message "A CueMatch record uses only its declared fields and the admitted type, attribution, provenance and descriptive metadata predicates." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CueMatch ] ] ; logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "predicate" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:linkVia ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "predicate" ], [ logic:termIndex 2 ; logic:termVariable "value" ] ], [ a logic:Formula ; logic:not [ a logic:Formula ; logic:relation logic:termIn ; logic:argument [ logic:termIndex 0 ; logic:termVariable "predicate" ], [ logic:termIndex 1 ; logic:termIri rdf:type ], [ logic:termIndex 2 ; logic:termIri rdfs:label ], [ logic:termIndex 3 ; logic:termIri rdfs:comment ], [ logic:termIndex 4 ; logic:termIri rdfs:isDefinedBy ], [ logic:termIndex 5 ; logic:termIri gmeow:description ], [ logic:termIndex 6 ; logic:termIri gmeow:graphBoxRole ], [ logic:termIndex 7 ; logic:termIri gmeow:accordingTo ], [ logic:termIndex 8 ; logic:termIri gmeow:wasAttributedTo ], [ logic:termIndex 9 ; logic:termIri gmeow:wasDerivedFrom ], [ logic:termIndex 10 ; logic:termIri gmeow:versionOf ], [ logic:termIndex 11 ; logic:termIri gmeow:versionLabel ], [ logic:termIndex 12 ; logic:termIri gmeow:contentDigest ], [ logic:termIndex 13 ; logic:termIri gmeow:matchedCue ], [ logic:termIndex 14 ; logic:termIri gmeow:matchRecord ], [ logic:termIndex 15 ; logic:termIri gmeow:matchField ], [ logic:termIndex 16 ; logic:termIri gmeow:matchSourceLiteral ], [ logic:termIndex 17 ; logic:termIri gmeow:spanStart ], [ logic:termIndex 18 ; logic:termIri gmeow:spanEnd ], [ logic:termIndex 19 ; logic:termIri gmeow:matchSuppressedBy ], [ logic:termIndex 20 ; logic:termIri gmeow:matchGrounding ], [ logic:termIndex 21 ; logic:termIri lang:literalValue ], [ logic:termIndex 22 ; logic:termIri gmeow:machineryAdmittedBy ], [ logic:termIndex 23 ; logic:termIri gmeow:machineryForReader ], [ logic:termIndex 24 ; logic:termIri gmeow:cueGrounded ], [ logic:termIndex 25 ; logic:termIri gmeow:cueGroundingReader ] ] ] ] ] ] ] ] .

