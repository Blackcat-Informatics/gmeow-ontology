    a ontolex:Form ;
    ontolex:writtenRep "向量符号容量"@zh .

<http://example.org/lang/glossary-vartrans/form-tgt/7c2c48604c90b063>
    a ontolex:Form ;
    ontolex:writtenRep "inférieur"@fr .

<http://example.org/lang/glossary-vartrans/form-tgt/7c31f740024299d0>
    a ontolex:Form ;
    ontolex:writtenRep "L’association de clé nommée de version 3 pour math:BoundaryOperator : `boundary`, qui distingue le bord de chaîne de la dérivation partielle."@fr .

<http://example.org/lang/glossary-vartrans/form-tgt/7c391d6178ddb66e>
    a ontolex:Form ;
    ontolex:writtenRep "position spatiale absolue"@fr .

