#
# Declarative structural assertions for the evidence slice -- the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_evidence.py. Each assertion runs as a
# SPARQL ASK over the evidence module graph (gmeow:scopeModule) under the
# native Rust slicetest harness (crates/slicetest).
#
# Evidence is migrated: class stereotypes are logic:
# (logic:AbstractIndividualType, logic:Category), not gufo:.
#
# The inline SHACL example-conformance cases and the fixture-based per-node
# warning/violation + mutation checks now live natively in
# crates/validate/tests/conformance_cases/conformance_evidence.rs (Case rows for the five inline
# graphs; GraphStore/report twins for the cogneto-cases.ttl InfoWorld/OrgBook/
# Private citations and the OrgBook supportsNotability mutation).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/evidence/tests/> .

# --- 1. EvidenceClass is a logic:AbstractIndividualType value vocabulary (MUST) -
ex:saEvidenceClassIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:EvidenceClass a logic:AbstractIndividualType , owl:Class ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:EvidenceClass MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- the class is a value vocabulary (individuals, never subclasses; Principle 9)." .

# --- 2. All 17 EvidenceClass seed individuals exist (MUST) --------------------
ex:saEvidenceClassSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:evidenceVERIFIED              a gmeow:EvidenceClass .
    gmeow:evidenceSELF                  a gmeow:EvidenceClass .
    gmeow:evidenceANECDOTAL             a gmeow:EvidenceClass .
    gmeow:evidenceRUMOR                 a gmeow:EvidenceClass .
    gmeow:evidenceIndependentTradePress a gmeow:EvidenceClass .
    gmeow:evidencePublicRegistry        a gmeow:EvidenceClass .
    gmeow:evidenceLegalFiling           a gmeow:EvidenceClass .
    gmeow:evidenceOfficialSource        a gmeow:EvidenceClass .
    gmeow:evidenceSelfControlledSite    a gmeow:EvidenceClass .
    gmeow:evidencePrivateScan           a gmeow:EvidenceClass .
    gmeow:evidenceFamilyNarrative       a gmeow:EvidenceClass .
    gmeow:evidenceGeneratedReport       a gmeow:EvidenceClass .
    gmeow:evidenceOcrExtract            a gmeow:EvidenceClass .
    gmeow:evidenceRawArchive            a gmeow:EvidenceClass .
    gmeow:evidencePrivateCorrespondence a gmeow:EvidenceClass .
    gmeow:evidenceSourceCodeArchive     a gmeow:EvidenceClass .
    gmeow:evidenceNewspaperLead         a gmeow:EvidenceClass .
}""" ;
    gmeow:saRationale "All 17 EvidenceClass seed individuals MUST be present as gmeow:EvidenceClass instances -- they are the open value vocabulary for evidential warrant (Axis A)." .

# --- 3. EvidenceClass seeds are NOT typed owl:Class (MUST-NOT) ----------------
ex:saEvidenceClassSeedsNotOwlClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?seed {
        gmeow:evidenceVERIFIED
        gmeow:evidenceSELF
        gmeow:evidenceANECDOTAL
        gmeow:evidenceRUMOR
        gmeow:evidenceIndependentTradePress
        gmeow:evidencePublicRegistry
        gmeow:evidenceLegalFiling
        gmeow:evidenceOfficialSource
        gmeow:evidenceSelfControlledSite
        gmeow:evidencePrivateScan
        gmeow:evidenceFamilyNarrative
        gmeow:evidenceGeneratedReport
        gmeow:evidenceOcrExtract
        gmeow:evidenceRawArchive
        gmeow:evidencePrivateCorrespondence
        gmeow:evidenceSourceCodeArchive
        gmeow:evidenceNewspaperLead
    }
    ?seed a owl:Class .
}""" ;
    gmeow:saRationale "No EvidenceClass seed individual MUST be typed owl:Class -- evidence classes are individuals (value vocabulary), never subclasses; minting a seed as owl:Class would violate Principle 9." .

# --- 4. SourceIndependence is a logic:AbstractIndividualType value vocab (MUST) -
ex:saSourceIndependenceIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SourceIndependence a logic:AbstractIndividualType , owl:Class ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:SourceIndependence MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- it is the Axis B independence value vocabulary (individuals, never subclasses; Principle 9)." .

# --- 5. SourceIndependence seed individuals exist (MUST) ----------------------
ex:saSourceIndependenceSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:sourceIndependenceIndependent          a gmeow:SourceIndependence .
    gmeow:sourceIndependenceSelfOrIssuerOriginated a gmeow:SourceIndependence .
}""" ;
    gmeow:saRationale "Both SourceIndependence seed individuals (independent, self-or-issuer-originated) MUST exist." .

# --- 6. SourceIndependence seeds are NOT typed owl:Class (MUST-NOT) -----------
ex:saSourceIndependenceSeedsNotOwlClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?seed {
        gmeow:sourceIndependenceIndependent
        gmeow:sourceIndependenceSelfOrIssuerOriginated
    }
    ?seed a owl:Class .
}""" ;
    gmeow:saRationale "No SourceIndependence seed individual MUST be typed owl:Class -- the values are individuals, never subclasses (Principle 9)." .

# --- 7. SourceTier is a logic:AbstractIndividualType value vocabulary (MUST) ---
ex:saSourceTierIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
