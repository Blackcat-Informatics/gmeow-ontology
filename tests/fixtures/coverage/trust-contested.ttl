# Coverage slice (#51): contested trust facts — standpoint-indexed, coexisting,
# NO winner. Exercises the three-axis separation (accordingTo ⟂ wasAttributedTo ⟂
# confidence) on a contested key↔identity binding (Certification). One standpoint
# holds the binding unequivocal; another refutes it. Native GMEOW terms only.

@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/trust/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

ex:standpoint-wot a gmeow:Standpoint ; gmeow:sharpens gmeow:universalStandpoint .
ex:standpoint-audit a gmeow:Standpoint ; gmeow:sharpens gmeow:universalStandpoint .

# A contested certification: the same key→agent binding, one standpoint affirms,
# another denies.
ex:contestedCert a gmeow:Certification ;
    gmeow:certifier ex:alice ;
    gmeow:certifiedKey ex:bobKey ;
    gmeow:certifiedIdentity ex:bob ;
    gmeow:certificationLevel "positive" .

# Standpoint A affirms the binding.
ex:claimCertAffirmed a owl:Axiom ;
    owl:annotatedSource   ex:contestedCert ;
    owl:annotatedProperty gmeow:certifiedIdentity ;
    owl:annotatedTarget   ex:bob ;
    gmeow:accordingTo ex:standpoint-wot ;
    gmeow:standpointModality gmeow:unequivocal ;
    gmeow:confidence 0.9 .

# Standpoint B refutes the binding — explicit denial, not silence.
ex:claimCertRefuted a owl:Axiom ;
    owl:annotatedSource   ex:contestedCert ;
    owl:annotatedProperty gmeow:certifiedIdentity ;
    owl:annotatedTarget   ex:bob ;
    gmeow:accordingTo ex:standpoint-audit ;
    gmeow:standpointModality gmeow:refuted ;
    gmeow:confidence 0.95 .

# The three-axis separation: same wasAttributedTo (Alice the certifier),
# different accordingTo (WoT community vs audit firm), different confidence.
