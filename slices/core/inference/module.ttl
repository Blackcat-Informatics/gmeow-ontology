    logic:compositionExclusionWhole gmeow:attackSource ;
    logic:compositionExclusionPart gmeow:attackTarget ;
    logic:compositionExclusionVia gmeow:argumentConclusion , gmeow:hasPremiseUse , gmeow:hasInferenceApplication ;
    logic:formalizes gmeow:attackSource ;
    gmeow:useWhen "Use when the native coherence gate must enforce this record's integrity condition over gmeow:Attack; the record is the canonical carrier the gate joins."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when gmeow:Attack no longer bears the condition — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read the record's own logic: fields together: they name gmeow:Attack and the condition asserted over it, and the OWL grounding view projects the matching axiom from them."@x-gmeow-english ;
    skos:example "gmeow:attackComponentSelfExclusion logic:characterizes gmeow:Attack ."@x-gmeow-english ;
