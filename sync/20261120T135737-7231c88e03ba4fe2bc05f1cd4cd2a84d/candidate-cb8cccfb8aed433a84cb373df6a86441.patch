+        let error = CarrierParts::new(&upstream)
+            .push_rooted_graph("stage-docs-render", GRAPH_DOCUMENTATION)
+            .expect_err("refuse default graph rows");
+        assert!(
+            error.to_string().contains("contains RDF rows outside"),
+            "{layer:?}: {error}"
+        );
+    }
