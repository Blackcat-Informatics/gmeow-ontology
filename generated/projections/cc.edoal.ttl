@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/cc>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:License ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri cc:License ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.8"^^xsd:double ;
        rdfs:label "License → cc:License"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:attributionText ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri cc:attributionName ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "attributionText → cc:attributionName"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:attributionUrl ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri cc:attributionURL ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "attributionUrl → cc:attributionURL"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasLicense ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri cc:license ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            rdfs:label "hasLicense → cc:license"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "cc" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → cc (EDOAL)"@en .
