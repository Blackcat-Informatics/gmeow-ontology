@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/inhabitation>
    a gmeow:Slice ;
    rdfs:label "inhabitation"@x-gmeow-english ;
    skos:definition "The inhabitation slice of the GMEOW ontology (core tier): GMEOW Inhabitation Module. It supplies the connecting topology that says which transformations preserve the same durable digital subject and which do not — a subject inhabiting a host over a tenure, in a time-scoped configuration, without asserting metaphysical singularity (Principle 9). Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier. Authored from the ratified design set in design/*.md."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inhabitation> ;
    dcterms:title "GMEOW Inhabitation Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/coreference> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ,
        <https://blackcatinformatics.ca/gmeow/slices/events> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/epistemics> ,
        <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    gmeow:sliceConsumer "The AI-agent / MCP audience (Principle 15): a durable subject inhabiting a served model, with memory and claims — who persists across model upgrades, host migrations, sessions, personas, and embodiments; and the cross-domain spiritual / fictional / legal profiles modelled frame-relatively as siblings."@x-gmeow-english .
