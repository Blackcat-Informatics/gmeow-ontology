# --- ODRL policy identity and profile details ------------------------------ #
# odrl:uid (audit-overturned): ODRL's uid IS the policy's own IRI — the
# projected RightsStatement node self-identifies truthfully (no document
# identity is minted).
# odrl:profile (audit-overturned, round 2): conformance is an ASSERTABLE
# FACT like any other — when the policy author asserts gmeow:conformsTo on
# the RightsStatement, the projection carries it as odrl:profile (asserted
# + attributable, never invented; GMEOW verifies no other claim
# independently either).
# REFUSED (P5 — scope mismatch): odrl:duty (the PERMISSION-scoped duty,
# e.g. attribution-on-use). GMEOW scopes duties to the RightsStatement
# (already projected as odrl:obligation by mapOdrlDuty above); there is no
# permission-level duty source, and re-homing the statement duty onto each
# permission would assert a tighter binding than the data holds.

gmeow:mapOdrlHasPolicy a gmeow:ProjectionMapping ;
    rdfs:label "hasRightsStatement → odrl:hasPolicy"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ohpEnt" ; gmeow:value "ohpRs" ;
        gmeow:atom ( [ gmeow:subjectVar "ohpEnt" ; gmeow:predicate gmeow:hasRightsStatement ; gmeow:objectVar "ohpRs" ] ) ;
        gmeow:edoalSource gmeow:hasRightsStatement ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:toPredicate odrl:hasPolicy ; gmeow:relation "=" ; gmeow:confidence 0.9 ; gmeow:mnemomorphic true ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:closeMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ] .

gmeow:mapOdrlPolicyType a gmeow:ProjectionMapping ;
    rdfs:label "RightsStatement → odrl:Policy (the Set's superclass, alongside it)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "optRs" ;
        gmeow:atom ( [ gmeow:subjectVar "optRs" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:RightsStatement ] ) ;
        gmeow:edoalSource gmeow:RightsStatement ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:toClass odrl:Policy ; gmeow:relation "<=" ; gmeow:confidence 0.9 ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:closeMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ] .


gmeow:mapOdrlUid a gmeow:ProjectionMapping ;
    rdfs:label "RightsStatement → odrl:uid (the policy's own IRI)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ouRs" ;
        gmeow:atom ( [ gmeow:subjectVar "ouRs" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:RightsStatement ] ) ;
        gmeow:edoalSource gmeow:RightsStatement ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:toPredicate odrl:uid ; gmeow:relation "<=" ; gmeow:confidence 0.95 ;
        gmeow:lossyDrop "odrl:uid is the policy node's own IRI; no independent GMEOW uid predicate exists to recover from the target property alone" ;
        gmeow:templateAtoms ( [ gmeow:tSubj "ouRs" ; gmeow:tPred odrl:uid ; gmeow:tObj "ouRs" ] ) ] .


gmeow:mapOdrlProfile a gmeow:ProjectionMapping ;
    rdfs:label "RightsStatement conformsTo → odrl:profile"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "opfRs" ; gmeow:value "opfProfile" ;
        gmeow:atom (
            [ gmeow:subjectVar "opfRs" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:RightsStatement ]
            [ gmeow:subjectVar "opfRs" ; gmeow:predicate gmeow:conformsTo ; gmeow:objectVar "opfProfile" ] ) ;
        gmeow:edoalSource gmeow:conformsTo ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:toPredicate odrl:profile ; gmeow:relation "=" ; gmeow:confidence 0.9 ; gmeow:mnemomorphic true ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:closeMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
        gmeow:lossyDrop "the conformance claim is carried exactly as declared by the policy author — the transpiler never verifies it" ] .

# --------------------------------------------------------------------------- #
# Permission-scoped duties: ODRL's odrl:duty is a duty bound to ONE permission —
# the CC-attribution pattern ("you may reproduce, PROVIDED you attribute").
# gmeow:hasDuty's domain is the union of RightsStatement and Permission, so the
# rule-level binding is already representable; this cell gives it its ODRL leg.
# Statement-scoped duties keep
# projecting as odrl:obligation (mapOdrlDuty above) — the two scopes coexist.
# odrl:target rides the duty when the statement names an asset: ODRL 2.2 does
# not inherit the permission's target onto its duties (target is 0..1 per
# rule), so the duty's asset must be stated explicitly to be present.
# --------------------------------------------------------------------------- #

gmeow:mapOdrlPermissionDuty a gmeow:ProjectionMapping ;
    rdfs:label "Permission duty rule → odrl:duty on the permission node"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "pdRs" ;
        gmeow:atom (
            [ gmeow:subjectVar "pdRs" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:RightsStatement ]
            [ gmeow:subjectVar "pdRs" ; gmeow:predicate gmeow:hasPermission ; gmeow:objectVar "pdPerm" ]
            [ gmeow:subjectVar "pdPerm" ; gmeow:predicate gmeow:hasDuty ; gmeow:objectVar "pdDuty" ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "pdRs" ; gmeow:predicate gmeow:statementAbout ; gmeow:objectVar "pdAsset" ] ) ]
            [ gmeow:subjectVar "pdDuty" ; gmeow:predicate gmeow:ruleAssignee ; gmeow:objectVar "pdAssignee" ; gmeow:optional true ] ) ;
        gmeow:edoalSource gmeow:hasDuty ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:relation "<=" ;
        gmeow:lossyDrop "the permission's own odrl:constraint (e.g. temporal validity) does not propagate to the duty — ODRL 2.2 does not inherit a permission's constraints onto its duties, so the duty's constraint scope must be stated separately on the duty rule" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "pdPerm" ; gmeow:tPred odrl:duty ; gmeow:tObj "pdDuty" ]
            [ gmeow:tSubj "pdDuty" ; gmeow:tPred rdf:type ; gmeow:tObjValue odrl:Duty ]
            [ gmeow:tSubj "pdDuty" ; gmeow:tPred odrl:target ; gmeow:tObj "pdAsset" ]
            [ gmeow:tSubj "pdDuty" ; gmeow:tPred odrl:assignee ; gmeow:tObj "pdAssignee" ] ) ] .
