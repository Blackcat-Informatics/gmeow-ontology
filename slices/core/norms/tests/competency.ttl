#
# Declarative competency questions for the norms slice (crates/slicetest),
# migrated from tests/test_norms.py, tests/test_rubrics.py, and
# tests/test_registers.py. Each question runs the referenced .rq file against
# the asserted merged ontology (or against a synthetic ABox overlay for the
# instance-level divergence query) and pins the expected result set.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/norms/tests/> .

# ── Deontic modalities ────────────────────────────────────────────────────────
# Migrated from test_competency_deontic_modalities_query.
# The query returns every DeonticModality individual; the four canonical seeds
# MUST be present (open vocabulary — additional values are allowed).
ex:cqNormsDeonticModalities a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/norms-deontic-modalities.rq" ;
    gmeow:cqRationale "A GMEOW norm must be able to carry obligation, prohibition, permission, and recommendation as seed deontic modalities." ;
    gmeow:cqResultShape ex:cqNormsDeonticModalitiesShape ;
    gmeow:cqExpectRow
        ex:rowDeonticObligation, ex:rowDeonticProhibition,
        ex:rowDeonticPermission, ex:rowDeonticRecommendation .

ex:cqNormsDeonticModalitiesShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "modality" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

ex:rowDeonticObligation a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "modality" ; gmeow:cellValueIri gmeow:deonticObligation ] .
ex:rowDeonticProhibition a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "modality" ; gmeow:cellValueIri gmeow:deonticProhibition ] .
ex:rowDeonticPermission a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "modality" ; gmeow:cellValueIri gmeow:deonticPermission ] .
ex:rowDeonticRecommendation a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "modality" ; gmeow:cellValueIri gmeow:deonticRecommendation ] .

# ── Authority ordering ────────────────────────────────────────────────────────
# Migrated from test_competency_authority_order_query.
# absolute reaches conditional through strongerThan+ and nothing outranks it.
ex:cqNormsAuthorityOrder a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/norms-authority-order.rq" ;
    gmeow:cqRationale "The claimed-authority ladder must make absolute the unique top level reachable transitively above conditional." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqNormsAuthorityOrderShape ;
    gmeow:cqExpectRow ex:rowAuthorityAbsoluteTop .

ex:cqNormsAuthorityOrderShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "top" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowAuthorityAbsoluteTop a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "top" ; gmeow:cellValueIri gmeow:authorityAbsolute ] .

# ── Rubric exemplar polarities ────────────────────────────────────────────────
# Migrated from test_competency_exemplar_polarity_query.
# The ExemplarPolarity vocabulary is the closed positive/negative/cautionary
# trichotomy.
ex:cqRubricsExemplarPolarity a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/rubrics-exemplar-polarity.rq" ;
    gmeow:cqRationale "A rubric exemplar must carry one of the three closed polarities: positive, negative, or cautionary." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqRubricsExemplarPolarityShape ;
    gmeow:cqExpectRow ex:rowPolarityPositive, ex:rowPolarityNegative, ex:rowPolarityCautionary .

ex:cqRubricsExemplarPolarityShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "polarity" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowPolarityPositive a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "polarity" ; gmeow:cellValueIri gmeow:polarityPositive ] .
ex:rowPolarityNegative a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "polarity" ; gmeow:cellValueIri gmeow:polarityNegative ] .
ex:rowPolarityCautionary a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "polarity" ; gmeow:cellValueIri gmeow:polarityCautionary ] .

# ── Same-norms invariant (no divergence) ──────────────────────────────────────
# Migrated from test_same_norms_invariant_holds_on_wellformed_fixture.
# Over the well-formed fixture both personas express the same tier-1 norm, so
# the divergence query must return the empty set. Divergence is legal (P9); the
# query makes it visible rather than forbidden.
ex:cqRegistersSameNormsInvariant a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/registers-norm-divergence.rq" ;
    gmeow:cqDataFile "tests/fixtures/registers-wellformed.ttl" ;
    gmeow:cqRationale "Two personas of the same agent that express the same norm set must produce no divergence rows." ;
    gmeow:cqResultShape ex:cqRegistersSameNormsInvariantShape ;
    gmeow:cqExpectRowCount 0 .

ex:cqRegistersSameNormsInvariantShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "agent" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "persona" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "norm" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ;
    logic:shapeRowCount 0 .
