# Flagship (scope ambiguity): "every man loves a woman" holds two co-resident
# readings whose denotations are two DISTINCT logic:Formulas (forall-exists vs
# exists-forall). Both persist; neither is collapsed.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:sent a lang:ComposedForm ; lang:inSignSystem ex:english .

# forall x . man(x) -> exists y . woman(y) & loves(x,y)
ex:fAllExists a logic:Formula .
# exists y . woman(y) & forall x . man(x) -> loves(x,y)
ex:fExistsAll a logic:Formula .

ex:denAllExists a lang:Denotation ;
    lang:denotedForm ex:sent ;
    lang:denotationKind lang:denotesLogicFormula ;
    lang:denotationTarget ex:fAllExists ;
    lang:denotationContext ex:ctx ;
    logic:preservationKind logic:ExactPreservation .

ex:denExistsAll a lang:Denotation ;
    lang:denotedForm ex:sent ;
    lang:denotationKind lang:denotesLogicFormula ;
    lang:denotationTarget ex:fExistsAll ;
    lang:denotationContext ex:ctx ;
    logic:preservationKind logic:ExactPreservation .

ex:readingAllExists a lang:Reading ; lang:readingOf ex:sent ; lang:denotation ex:denAllExists .
ex:readingExistsAll a lang:Reading ; lang:readingOf ex:sent ; lang:denotation ex:denExistsAll .

ex:act a lang:InterpretationAct ;
    lang:interpretedForm ex:sent ;
    lang:producedReading ex:readingAllExists , ex:readingExistsAll .
