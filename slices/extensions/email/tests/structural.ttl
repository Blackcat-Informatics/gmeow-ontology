}""" ;
    gmeow:saRationale """gmeow:precedence MUST be a DatatypeProperty with domain EmailMessage and range Literal.""" .

ex:saReadReceiptRequestedBooleanNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:readReceiptRequested a owl:DatatypeProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range xsd:boolean .
    FILTER NOT EXISTS { gmeow:readReceiptRequested a owl:FunctionalProperty }
}""" ;
    gmeow:saRationale """gmeow:readReceiptRequested MUST be a DatatypeProperty on EmailMessage ranging over xsd:boolean and MUST NOT be functional.""" .

ex:saDispositionNotificationToObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:dispositionNotificationTo a owl:ObjectProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range gmeow:EmailAddress .
}""" ;
    gmeow:saRationale """gmeow:dispositionNotificationTo MUST be an ObjectProperty from EmailMessage to EmailAddress.""" .

ex:saSentBySoftwareObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:sentBySoftware a owl:ObjectProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range gmeow:SoftwareAgent .
}""" ;
    gmeow:saRationale """gmeow:sentBySoftware MUST be an ObjectProperty from EmailMessage to SoftwareAgent.""" .

ex:saDescribesEventObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:describesEvent a owl:ObjectProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range gmeow:Event .
    FILTER NOT EXISTS { gmeow:describesEvent a owl:FunctionalProperty }
}""" ;
    gmeow:saRationale """gmeow:describesEvent MUST be an ObjectProperty from EmailMessage to Event and MUST NOT be functional because one email may describe multiple events.""" .

ex:saEventDescribedByInverse a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:eventDescribedBy a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:EmailMessage ;
        owl:inverseOf gmeow:describesEvent .
}""" ;
    gmeow:saRationale """gmeow:eventDescribedBy MUST be the inverse of gmeow:describesEvent, domain Event, range EmailMessage.""" .

ex:saCalendarAttachmentSubproperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:calendarAttachment a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:hasAttachment ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range gmeow:Attachment .
}""" ;
    gmeow:saRationale """gmeow:calendarAttachment MUST be an ObjectProperty, subproperty of gmeow:hasAttachment, from EmailMessage to Attachment.""" .

ex:saCalendarUidDatatypeProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:calendarUid a owl:DatatypeProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range rdfs:Literal .
    FILTER NOT EXISTS { gmeow:calendarUid a owl:FunctionalProperty }
}""" ;
    gmeow:saRationale """gmeow:calendarUid MUST be a DatatypeProperty on EmailMessage ranging over Literal and MUST NOT be functional because competing or multiple UIDs may coexist.""" .

ex:saCalendarMethodSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:calendarMethodRequest a gmeow:CalendarMethod .
    gmeow:calendarMethodReply a gmeow:CalendarMethod .
    gmeow:calendarMethodCancel a gmeow:CalendarMethod .
    gmeow:calendarMethodPublish a gmeow:CalendarMethod .
    gmeow:calendarMethodCounter a gmeow:CalendarMethod .
    gmeow:calendarMethodDeclineCounter a gmeow:CalendarMethod .
    gmeow:calendarMethodAdd a gmeow:CalendarMethod .
    gmeow:calendarMethodRefresh a gmeow:CalendarMethod .
}""" ;
    gmeow:saRationale """The eight iCalendar METHOD seeds MUST be declared as CalendarMethod individuals.""" .

ex:saHasCalendarMethodProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasCalendarMethod a owl:ObjectProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range gmeow:CalendarMethod .
    FILTER NOT EXISTS { gmeow:hasCalendarMethod a owl:FunctionalProperty }
}""" ;
    gmeow:saRationale """gmeow:hasCalendarMethod MUST be an ObjectProperty from EmailMessage to CalendarMethod and MUST NOT be functional.""" .

ex:saMessageKindCalendarInvitationExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:messageKindCalendarInvitation a gmeow:MessageKind .
}""" ;
    gmeow:saRationale """gmeow:messageKindCalendarInvitation MUST be declared as a MessageKind individual.""" .

ex:saBlobIdDatatypePropertyDomainFree a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:blobId a owl:DatatypeProperty ;
        rdfs:range rdfs:Literal .
    FILTER NOT EXISTS { gmeow:blobId rdfs:domain ?d }
}""" ;
    gmeow:saRationale """gmeow:blobId MUST be a domain-free DatatypeProperty ranging over Literal so it can be used on EmailMessage and BodyPart.""" .

ex:saBodyStructureFunctionalDatatypeProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:bodyStructure a owl:DatatypeProperty ;
        rdfs:domain gmeow:EmailMessage ;
        rdfs:range rdfs:Literal .
}""" ;
    gmeow:saRationale """gmeow:bodyStructure MUST be a DatatypeProperty on EmailMessage ranging over Literal; its functionality is now carried by a logic:PropertyCharacteristicAssertion (DL-enforced).""" .

ex:saBodyValueClassExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:BodyValue a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale """gmeow:BodyValue MUST be a logic:Kind subclass of InformationObject.""" .

ex:saNoCompetingBodyStructureClassOrProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    { gmeow:BodyStructure a owl:Class . }
    UNION
    { gmeow:hasBodyStructure a owl:ObjectProperty . }
}""" ;
    gmeow:saRationale """The canonical MIME tree is the existing hasBodyPart/hasPart spine; no competing BodyStructure class or hasBodyStructure property may be declared.""" .

ex:saNoCompetingBodyValueProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:hasBodyValue a owl:ObjectProperty .
}""" ;
    gmeow:saRationale """Decoded body content is linked by wasDerivedFrom, not a dedicated hasBodyValue property.""" .

ex:saParentMailboxSubpropertyOfPartOf a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:parentMailbox a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:partOf ;
        rdfs:domain gmeow:Mailbox ;
        rdfs:range gmeow:Mailbox .
}""" ;
    gmeow:saRationale """gmeow:parentMailbox MUST be an ObjectProperty, subproperty of gmeow:partOf, from Mailbox to Mailbox.""" .

ex:saChildMailboxSubpropertyOfHasPart a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:childMailbox a owl:ObjectProperty ;
        rdfs:subPropertyOf gmeow:hasPart ;
        rdfs:domain gmeow:Mailbox ;
        rdfs:range gmeow:Mailbox ;
        owl:inverseOf gmeow:parentMailbox .
}""" ;
    gmeow:saRationale """gmeow:childMailbox MUST be an ObjectProperty, subproperty of gmeow:hasPart, inverse of gmeow:parentMailbox, from Mailbox to Mailbox.""" .

ex:saMailboxSortOrderIntegerNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:mailboxSortOrder a owl:DatatypeProperty ;
        rdfs:domain gmeow:Mailbox ;
        rdfs:range xsd:integer .
    FILTER NOT EXISTS { gmeow:mailboxSortOrder a owl:FunctionalProperty }
}""" ;
    gmeow:saRationale """gmeow:mailboxSortOrder MUST be a DatatypeProperty on Mailbox ranging over xsd:integer and MUST NOT be functional.""" .

