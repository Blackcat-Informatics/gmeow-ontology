# --------------------------------------------------------------------------- #
# iCalendar (RFC 5545 RDF) — the calendar-interchange projection targets. An
# event is a VEVENT; its interval/point endpoints are DTSTART/DTEND, its location
# the LOCATION, its participants ATTENDEEs. Projection-grade (single time/place),
# so closeMatch on the structural props, relatedMatch on the lossy reshape.
# --------------------------------------------------------------------------- #

gmeow:eqEvents087 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventTime ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ical:dtstart ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "a point event's instant ↔ iCalendar DTSTART" ;
    gmeow:sssomFile "gmeow-events.sssom.tsv" .

gmeow:eqEvents088 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventInterval ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject ical:dtstart ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "the crisp interval's endpoints become DTSTART/DTEND (a reshape, not a rename)" ;
    gmeow:sssomFile "gmeow-events.sssom.tsv" .

gmeow:eqEvents089 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventLocation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ical:location ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "iCalendar LOCATION (GMEOW keeps a first-class place; iCal flattens to a label)" ;
    gmeow:sssomFile "gmeow-events.sssom.tsv" .

gmeow:eqEvents090 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasParticipant ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ical:attendee ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "the flat participant shortcut ↔ iCalendar ATTENDEE" ;
    gmeow:sssomFile "gmeow-events.sssom.tsv" .

gmeow:eqEvents091 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventType ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject ical:summary ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.4 ;
    gmeow:comment "the event-type label is downcast to a human-readable iCalendar SUMMARY" ;
    gmeow:sssomFile "gmeow-events.sssom.tsv" .
