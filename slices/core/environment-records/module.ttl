    gmeow:useWhen "Use for a source-classified document collection object in an attributed world description."@x-gmeow-english ;
    gmeow:avoidWhen "Collection classification does not prove indexing completeness or available search tools."@x-gmeow-english ;
    gmeow:howToUse "Attach worldObjectKindDocumentCollection through worldObjectKind; let the declared broader-value chain supply only its documented ancestors."@x-gmeow-english ;
    skos:scopeNote "The direct broader value is worldObjectKindWrittenRecord; inherited classification remains inferred, not a new source assertion."@x-gmeow-english ;
    skos:example "For example: ex:object gmeow:worldObjectKind gmeow:worldObjectKindDocumentCollection ."@x-gmeow-english ;
    gmeow:worldObjectKindBroader gmeow:worldObjectKindWrittenRecord .

gmeow:worldObjectKindReadableFramedArtifact
    a logic:NamedIndividual, gmeow:WorldObjectKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "readable framed artifact object"@x-gmeow-english ;
    skos:definition "A framed piece set out to read, narrower than written record."@x-gmeow-english ;
