# Structural contracts and real canonical bridges.
gmeow:acceptedBy logic:subPropertyOf gmeow:wasAssociatedWith .
gmeow:acceptedAt logic:subPropertyOf gmeow:eventTime .
gmeow:WorldObjectRecord logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:recordedWorldObject ; logic:allValuesFrom gmeow:Entity ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:WorldObjectRecord ; logic:closureKey "https://blackcatinformatics.ca/gmeow/recordedWorldObject" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:WorldObjectRecord logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:recordedWorldObject ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:Entity ] .
gmeow:WorldObjectRecord logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:providerProgram ; logic:allValuesFrom gmeow:SoftwareAgent ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:WorldObjectRecord ; logic:closureKey "https://blackcatinformatics.ca/gmeow/providerProgram" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:WorldObjectRecord logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:providerProgram ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:SoftwareAgent ] .
gmeow:WorldObjectRecord logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:providerWorld ; logic:allValuesFrom logic:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:WorldObjectRecord ; logic:closureKey "https://blackcatinformatics.ca/gmeow/providerWorld" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:WorldObjectRecord logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:providerWorld ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .
gmeow:WorldObjectRecord logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:wasAttributedTo ; logic:allValuesFrom gmeow:Agent ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:WorldObjectRecord ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasAttributedTo" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:WorldObjectRecord logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:wasDerivedFrom ; logic:allValuesFrom logic:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:WorldObjectRecord ; logic:closureKey "https://blackcatinformatics.ca/gmeow/wasDerivedFrom" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:WorldObjectStateClaim logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:worldObjectState ; logic:allValuesFrom xsd:string ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:WorldObjectStateClaim ; logic:closureKey "https://blackcatinformatics.ca/gmeow/worldObjectState" ; logic:closureValue logic:ClosedWorldClosure ] .
