# =========================================================================== #
# 6. Which media declare a dictionary, and what corpus trains it?             #
# =========================================================================== #

ex:cqMediumDictionaryInventory a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/gts/queries/competency/medium-dictionary-inventory.rq" ;
    gmeow:cqRationale "This is the question a consumer must answer BEFORE decoding and a reviewer must answer before shipping: which dictionaries may a given medium prime with, and what material does each of those dictionaries carry substrings of? The gmeow:mediumDictionary bound is a DECLARATION, not a hint — it is what makes the per-rep selection bounded rather than open at encode time — so a dictionary reachable from a medium but trained over an undeclared corpus is a shipped byte table nobody can audit, and a dictionary a producer primes with but no medium declares is a decode a consumer cannot reproduce. The two shipped media differ here for a stated reason and the difference must stay visible: the distribution medium declares all seven, while the runtime-store medium declares exactly the two memory dictionaries, because a store primed with a dictionary the bundle does not ship could never be re-primed by a consumer holding only that bundle. Note also which medium is ABSENT from every row: gmeow:mediumProfileBaselineL12 declares no dictionary at all, and that emptiness is its selection rather than a gap in this answer." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:shapeMediumDictionaryInventory ;
    gmeow:cqExpectRow
        ex:rowInventory02 ,
        ex:rowInventory03 ,
        ex:rowInventory04 ,
        ex:rowInventory05 ,
        ex:rowInventory06 ,
        ex:rowInventory07 ,
        ex:rowInventory08 ,
        ex:rowInventory09 .

ex:shapeMediumDictionaryInventory a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "medium" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "dictionary" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "corpus" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowInventory02 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "medium" ; gmeow:cellValueIri gmeow:mediumProfileDistL12 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dictionary" ; gmeow:cellValueIri gmeow:dictGmeowCoreV1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corpus" ; gmeow:cellValueIri gmeow:corpusGmeowCoreV1 ] .
ex:rowInventory03 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "medium" ; gmeow:cellValueIri gmeow:mediumProfileDistL12 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dictionary" ; gmeow:cellValueIri gmeow:dictGmeowLangAstV1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corpus" ; gmeow:cellValueIri gmeow:corpusGmeowLangAstV1 ] .
ex:rowInventory04 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "medium" ; gmeow:cellValueIri gmeow:mediumProfileDistL12 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dictionary" ; gmeow:cellValueIri gmeow:dictGmeowLogicV1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corpus" ; gmeow:cellValueIri gmeow:corpusGmeowLogicV1 ] .
ex:rowInventory05 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "medium" ; gmeow:cellValueIri gmeow:mediumProfileDistL12 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dictionary" ; gmeow:cellValueIri gmeow:dictGmeowMemoryCompactV1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corpus" ; gmeow:cellValueIri gmeow:corpusGmeowMemoryCompactV1 ] .
ex:rowInventory06 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "medium" ; gmeow:cellValueIri gmeow:mediumProfileDistL12 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dictionary" ; gmeow:cellValueIri gmeow:dictGmeowMemoryHotV1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corpus" ; gmeow:cellValueIri gmeow:corpusGmeowMemoryHotV1 ] .
ex:rowInventory07 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "medium" ; gmeow:cellValueIri gmeow:mediumProfileDistL12 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dictionary" ; gmeow:cellValueIri gmeow:dictGmeowProoftraceV1 ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "corpus" ; gmeow:cellValueIri gmeow:corpusGmeowProoftraceV1 ] .
