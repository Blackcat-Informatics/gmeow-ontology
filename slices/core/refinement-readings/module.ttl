            logic:consequent [ a logic:Formula ; logic:or [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "referent" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:relatedThing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "referent" ] ] ], [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "name" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:relatedName ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "name" ] ] ] ] ] ] .

gmeow:RelationPredicateIriConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "relation predicate IRI constraint"@x-gmeow-english ;
    skos:definition "Every supplied relationPredicate value is an actual IRI, including on subjects without a reading type."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:RelationPredicateIriConstraint logic:formalizes gmeow:relationPredicate ."@x-gmeow-english ;
    logic:formalizes gmeow:relationPredicate ;
    logic:message "Every supplied relationPredicate value is an actual IRI, including on subjects without a reading type." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:relationPredicate ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termIsIri ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] ] ] ] .

gmeow:RelatedThingIriConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "related thing IRI constraint"@x-gmeow-english ;
    skos:definition "Every supplied relatedThing value is an actual IRI, never a fabricated lexical replacement for an unnameable source term, including on untyped subjects."@x-gmeow-english ;
    gmeow:useWhen "Use to check the intrinsic consistency of the supplied scoped record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this consistency law as certification of source completeness, firstness or refiner execution."@x-gmeow-english ;
    gmeow:howToUse "Read the realized formula against the named report and preserve the original evidence when diagnosing a violation."@x-gmeow-english ;
    skos:example "Retain the governing law: gmeow:RelatedThingIriConstraint logic:formalizes gmeow:relatedThing ."@x-gmeow-english ;
    logic:formalizes gmeow:relatedThing ;
    logic:message "Every supplied relatedThing value is an actual IRI, never a fabricated lexical replacement for an unnameable source term, including on untyped subjects." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ;
        logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:relatedThing ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termIsIri ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] ] ] ] .

# Scoped process-state readings.

gmeow:OpenItemReading
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:Refinement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Open Item Reading"@x-gmeow-english ;
    skos:definition "A versioned process’s reading of a request or question awaiting an agent, limited to explicitly offered records. An open reading reports no linked settling act in that scope, never that the matter is unsettled in reality."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly scoped process reading with retained source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global absence, preference, diagnosis or source-subject endorsement from a process reading."@x-gmeow-english ;
    gmeow:howToUse "Retain the source, readingScope and versioned vantage; report supplied values without defaults and preserve earlier readings."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:reading a gmeow:OpenItemReading ."@x-gmeow-english .

