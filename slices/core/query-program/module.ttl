gmeow:WeightedFusionFoldContributionAccountLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "weighted fusion fold contribution account law"@x-gmeow-english ;
    skos:definition "The declared fold uses every actual score contribution in exactly one positive step and no unrelated contribution."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve complete contribution multiplicity in finite summation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using SUM DISTINCT semantics, skipping zeros or counting equal-valued components only once."@x-gmeow-english ;
    gmeow:howToUse "Require a positive step for every score contribution, reverse membership for every step contribution and step identity for repeated use of one component."@x-gmeow-english ;
    skos:scopeNote "The base has no contribution and positive steps have one. Together with index and final laws this is a complete finite bijection."@x-gmeow-english ;
    skos:example "Fictional scoped example: Two fictional equal-valued contributions require two positive steps, while one contribution cannot be added twice."@x-gmeow-english ;
