@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

# =========================================================================== #
# Doxastic tier shapes
# =========================================================================== #

gmeow:DoxasticStandpointClaimShape
    a sh:NodeShape ;
    rdfs:label "DoxasticStandpointClaim well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:DoxasticStandpointClaim: at most one claimOfBelief link to a DoxasticState; optional justification grounds restricted to EvidenceSpan, Attestation, or DoxasticState; optional defeat-status flags typed as gmeow:JustificationStatus."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    sh:targetClass gmeow:DoxasticStandpointClaim ;
    sh:property [
        sh:path gmeow:claimOfBelief ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:class gmeow:DoxasticState ;
        sh:severity sh:Violation ;
        sh:message "A DoxasticStandpointClaim may be linked to at most one DoxasticState via gmeow:claimOfBelief." ;
    ] ;
    sh:property [
        sh:path gmeow:hasAvailableEvidence ;
        sh:minCount 0 ;
        sh:class gmeow:JustificationGround ;
        sh:severity sh:Violation ;
        sh:message "If present, available evidence (gmeow:hasAvailableEvidence) must be a gmeow:JustificationGround (EvidenceSpan, Attestation, or DoxasticState)." ;
    ] ;
    sh:property [
        sh:path gmeow:basesBeliefOn ;
        sh:minCount 0 ;
        sh:class gmeow:JustificationGround ;
        sh:severity sh:Violation ;
        sh:message "If present, the basing ground (gmeow:basesBeliefOn) must be a gmeow:JustificationGround (EvidenceSpan, Attestation, or DoxasticState)." ;
    ] ;
    sh:property [
        sh:path gmeow:hasDefeatStatus ;
        sh:minCount 0 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:JustificationStatus ;
        sh:severity sh:Violation ;
        sh:message "If present, gmeow:hasDefeatStatus on a DoxasticStandpointClaim must be an IRI typed as gmeow:JustificationStatus." ;
    ] .

gmeow:DoxasticStateShape
    a sh:NodeShape ;
    rdfs:label "DoxasticState well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:DoxasticState: exactly one believer, one proposition, one linked StandpointClaim; optional credence in [0,1]."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    sh:targetClass gmeow:DoxasticState ;
    sh:property [
        sh:path gmeow:epistemicAgent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "A DoxasticState must have exactly one epistemic agent (gmeow:epistemicAgent, range gmeow:Agent)." ;
    ] ;
    sh:property [
        sh:path gmeow:doxasticContent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Proposition ;
        sh:severity sh:Violation ;
        sh:message "A DoxasticState must have exactly one doxastic content (gmeow:doxasticContent, range gmeow:Proposition)." ;
    ] ;
    sh:property [
        sh:path gmeow:doxasticClaim ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:StandpointClaim ;
        sh:severity sh:Violation ;
        sh:message "A DoxasticState must be linked to exactly one StandpointClaim (gmeow:doxasticClaim) carrying its qualitative claimModality." ;
    ] ;
    sh:property [
        sh:path gmeow:credence ;
        sh:minCount 0 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:severity sh:Violation ;
        sh:message "If present, gmeow:credence must be an xsd:decimal in the closed interval [0,1]." ;
    ] ;
    sh:property [
        sh:path gmeow:hasAvailableEvidence ;
        sh:minCount 0 ;
        sh:class gmeow:JustificationGround ;
        sh:severity sh:Violation ;
        sh:message "If present, gmeow:hasAvailableEvidence must point to a gmeow:JustificationGround (EvidenceSpan, Attestation, or DoxasticState)." ;
    ] ;
    sh:property [
        sh:path gmeow:basesBeliefOn ;
        sh:minCount 0 ;
        sh:class gmeow:JustificationGround ;
        sh:severity sh:Violation ;
        sh:message "If present, gmeow:basesBeliefOn must point to a gmeow:JustificationGround (EvidenceSpan, Attestation, or DoxasticState)." ;
    ] ;
    sh:property [
        sh:path gmeow:hasDefeatStatus ;
        sh:minCount 0 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:JustificationStatus ;
        sh:severity sh:Violation ;
        sh:message "If present, gmeow:hasDefeatStatus on a DoxasticState must be an IRI typed as gmeow:JustificationStatus." ;
    ] .

gmeow:ClaimEvaluationShape
    a sh:NodeShape ;
    rdfs:label "ClaimEvaluation well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:ClaimEvaluation: exactly one evaluated claim token. The OWL functional axiom on gmeow:evaluates carries the cardinality into the reasoned projection; this shape enforces it on raw un-reasoned instance data (Principle 8)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    sh:targetClass gmeow:ClaimEvaluation ;
    sh:property [
        sh:path gmeow:evaluates ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:ClaimToken ;
        sh:severity sh:Violation ;
        sh:message "A ClaimEvaluation must evaluate exactly one target claim token (gmeow:evaluates, range gmeow:ClaimToken)." ;
    ] .

gmeow:DoxasticTenureShape
    a sh:NodeShape ;
    rdfs:label "DoxasticTenure well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:DoxasticTenure: exactly one DoxasticState and one TimeInterval."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    sh:targetClass gmeow:DoxasticTenure ;
    sh:property [
        sh:path gmeow:tenureOfDoxasticState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:DoxasticState ;
        sh:severity sh:Violation ;
        sh:message "A DoxasticTenure must scope exactly one DoxasticState (gmeow:tenureOfDoxasticState)." ;
    ] ;
    sh:property [
        sh:path gmeow:duringInterval ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:TimeInterval ;
        sh:severity sh:Violation ;
        sh:message "A DoxasticTenure must carry exactly one time interval (gmeow:duringInterval, range gmeow:TimeInterval)." ;
    ] .

# (Principle 10) A withdrawn belief (a DoxasticTenure whose interval has ended)
# should be suppressed with gmeow:displayable false rather than deleted.
gmeow:WithdrawnDoxasticTenureSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Withdrawn doxastic tenure suppression shape"@x-gmeow-english ;
    skos:definition "Warns when a closed DoxasticTenure is not marked displayable false — suppression, not deletion (Principle 10)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    sh:targetClass gmeow:DoxasticTenure ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A withdrawn belief (a DoxasticTenure whose interval has ended) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/duringInterval> ?iv .
                ?iv <https://blackcatinformatics.ca/gmeow/endedAtTime> ?end .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> false }
            }
        """ ;
    ] .

# (Principle 13) The justification-ground edges keep the JustificationGround range;
# this shape is advisory only and warns when a basing/available ground is not one
# of the expected types from the evidence/inference/standpoint slices.
gmeow:DoxasticStateJustifierWarningShape
    a sh:NodeShape ;
    rdfs:label "DoxasticState justifier warning shape"@x-gmeow-english ;
    skos:definition "Warns when a DoxasticState's gmeow:hasAvailableEvidence or gmeow:basesBeliefOn value is not an EvidenceSpan, Attestation, or DoxasticState. Advisory only."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    sh:targetClass gmeow:DoxasticState ;
    sh:severity sh:Warning ;
    sh:property [
        sh:path gmeow:hasAvailableEvidence ;
        sh:or (
            [ sh:class gmeow:EvidenceSpan ]
            [ sh:class gmeow:Attestation ]
            [ sh:class gmeow:DoxasticState ]
        ) ;
        sh:message "gmeow:hasAvailableEvidence should point to an EvidenceSpan, Attestation, or DoxasticState (advisory warning)." ;
    ] ;
    sh:property [
        sh:path gmeow:basesBeliefOn ;
        sh:or (
            [ sh:class gmeow:EvidenceSpan ]
            [ sh:class gmeow:Attestation ]
            [ sh:class gmeow:DoxasticState ]
        ) ;
        sh:message "gmeow:basesBeliefOn should point to an EvidenceSpan, Attestation, or DoxasticState (advisory warning)." ;
    ] .

# =========================================================================== #
# Factored-justification assessment shapes (support-under-a-standard, adequacy).
# Each reified assessment names exactly one EpistemicStandard; the strength /
# verdict are solver-set.
# =========================================================================== #

gmeow:SupportAssessmentShape
    a sh:NodeShape ;
    rdfs:label "SupportAssessment well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:SupportAssessment: exactly one ground (gmeow:supportGround) and exactly one named standard (gmeow:supportUnderStandard)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    sh:targetClass gmeow:SupportAssessment ;
    sh:property [
        sh:path gmeow:supportGround ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:JustificationGround ;
        sh:severity sh:Violation ;
        sh:message "A SupportAssessment must weigh exactly one gmeow:JustificationGround (gmeow:supportGround)." ;
    ] ;
    sh:property [
        sh:path gmeow:supportUnderStandard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:EpistemicStandard ;
        sh:severity sh:Violation ;
        sh:message "A SupportAssessment must name exactly one gmeow:EpistemicStandard (gmeow:supportUnderStandard)." ;
    ] .

gmeow:AdequacyAssessmentShape
    a sh:NodeShape ;
    rdfs:label "AdequacyAssessment well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:AdequacyAssessment: exactly one named standard (gmeow:adequacyUnderStandard) and exactly one verdict (gmeow:meetsThreshold)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    sh:targetClass gmeow:AdequacyAssessment ;
    sh:property [
        sh:path gmeow:adequacyUnderStandard ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:EpistemicStandard ;
        sh:severity sh:Violation ;
        sh:message "An AdequacyAssessment must name exactly one gmeow:EpistemicStandard (gmeow:adequacyUnderStandard)." ;
    ] ;
    sh:property [
        sh:path gmeow:meetsThreshold ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:AdequacyVerdict ;
        sh:severity sh:Violation ;
        sh:message "An AdequacyAssessment must carry exactly one gmeow:AdequacyVerdict (gmeow:meetsThreshold)." ;
    ] .

# =========================================================================== #
# Locally-factive knowledge (gmeow:KnowledgeClaim) and non-factive
# knowledge-attribution (gmeow:KnowledgeAttribution) reified constructs.
# =========================================================================== #

gmeow:KnowledgeClaimShape
    a sh:NodeShape ;
    rdfs:label "KnowledgeClaim well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:KnowledgeClaim: exactly one knower, one known proposition, one belief-world, and one epistemic standard — the four roles of the locally-factive knowing relation."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    sh:targetClass gmeow:KnowledgeClaim ;
    sh:property [
        sh:path gmeow:knowerAgent ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "A KnowledgeClaim must have exactly one knower (gmeow:knowerAgent, range gmeow:Agent)." ;
    ] ;
    sh:property [
        sh:path gmeow:knownProposition ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:Proposition ;
        sh:severity sh:Violation ;
        sh:message "A KnowledgeClaim must know exactly one proposition (gmeow:knownProposition, range gmeow:Proposition)." ;
    ] ;
    sh:property [
        sh:path gmeow:knownInWorld ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:EpistemicContext ;
        sh:severity sh:Violation ;
        sh:message "A KnowledgeClaim must name exactly one belief-world (gmeow:knownInWorld, range gmeow:EpistemicContext) — factivity is world-local." ;
    ] ;
    sh:property [
        sh:path gmeow:underStandard ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:EpistemicStandard ;
        sh:severity sh:Violation ;
        sh:message "A KnowledgeClaim must name exactly one gmeow:EpistemicStandard (gmeow:underStandard)." ;
    ] .

gmeow:KnowledgeAttributionShape
    a sh:NodeShape ;
    rdfs:label "KnowledgeAttribution well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:KnowledgeAttribution: exactly one attributing agent, one attributed knower, and one attributed proposition — the non-factive 'X takes Y to know P'."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/epistemics> ;
    sh:targetClass gmeow:KnowledgeAttribution ;
    sh:property [
        sh:path gmeow:attributingAgent ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "A KnowledgeAttribution must have exactly one attributing agent (gmeow:attributingAgent)." ;
    ] ;
    sh:property [
        sh:path gmeow:attributedKnower ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "A KnowledgeAttribution must credit exactly one knower (gmeow:attributedKnower)." ;
    ] ;
    sh:property [
        sh:path gmeow:attributedProposition ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:Proposition ;
        sh:severity sh:Violation ;
        sh:message "A KnowledgeAttribution must attribute exactly one proposition (gmeow:attributedProposition)." ;
    ] .
