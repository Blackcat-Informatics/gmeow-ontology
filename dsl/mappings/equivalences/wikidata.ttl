# --------------------------------------------------------------------------- #
# Rights / IP / trademark / licensing (#21). QIDs/PIDs curl-validated against
# the live Wikidata API. Reified GMEOW relators (Copyright/Trademark/License)
# closeMatch the Wikidata legal-concept items; the GMEOW properties relatedMatch
# the corresponding Wikidata properties (which are direct-claim predicates, not
# reified relations) — see docs/rights-mapping.md.
# --------------------------------------------------------------------------- #

gmeow:eqWikidata006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Copyright ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q1297822 ;
    gmeow:justification semapv:ManualMappingCuration ;
