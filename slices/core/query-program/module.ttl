gmeow:QueryChoiceMatchLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query choice matching guard law"@x-gmeow-english ;
    skos:definition "At the same reported State and bound answer context, the internal matching Situation is supported exactly when the selected actual value is known and equals the expected value."@x-gmeow-english ;
    gmeow:useWhen "Use to reject contradictory generic matching support even when matching, nonmatching or unknown targets happen to coincide."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid admitting unknown expected sentinels, coercing information into completeness values or relying on the reported target alone to validate binary guard truth."@x-gmeow-english ;
    gmeow:howToUse "Join the execution context, expected value and comparison guard; expand known equality for both axes into two guarded support directions using separate fresh actual-value witnesses."@x-gmeow-english ;
    skos:scopeNote "Missing or explicit unknown actual values and known inequality forbid matching support. This check applies during outer unknown evaluations as well as known outer or inner evaluations, without requiring distinct target resources."@x-gmeow-english ;
    skos:example "A known matching value: ex:answer gmeow:queryInformationState logic:InfoBoth . ex:outer gmeow:choiceExpectedValue logic:InfoBoth . ex:state logic:situationObtains ex:matchSituation ."@x-gmeow-english ;
    logic:formalizes gmeow:QueryVerdictComparison ;
    logic:message "At the same reported State and bound answer context, the internal matching Situation is supported exactly when the selected actual value is known and equals the expected value." ;
