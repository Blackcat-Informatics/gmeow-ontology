    rdfs:label "conditional range target"@x-gmeow-english ;
    skos:definition "Relates a logic:ConditionalRangeAssertion to the class whose focus nodes it constrains. Domain logic:ConditionalRangeAssertion; single-valued. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:conditionalRangeSelector
    a logic:ObjectProperty ;
    rdfs:domain logic:ConditionalRangeAssertion ;
