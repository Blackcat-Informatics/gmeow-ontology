        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>rang de palier</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-65a6b759a4169561">
        <langSet xml:lang="en">
          <tig>
            <term>effect-size scale</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>échelle de taille d'effet</term>
          </tig>
        </langSet>
