# Tail registration — every minted class to its logic: metatype (mirroring the  #
# grounding/extension slices' metatype layer).                                 #
# =========================================================================== #

gmeow:CandidateSet a logic:Kind .
gmeow:ComparisonContext a logic:Kind .
gmeow:PreferenceObservation a logic:SubKind .
gmeow:PreferenceClaim a logic:SubKind .
gmeow:PreferenceEvaluation a logic:Event .
gmeow:PreferenceProjection a logic:Kind .
gmeow:ComparisonCompilation a logic:Event .
gmeow:CandidateSourceCorrespondence a logic:Kind .
gmeow:ProjectionPreservationRecord a logic:Kind .
gmeow:PreferenceOrder a logic:Kind .
gmeow:ConsensusSection a logic:Kind .
gmeow:DisagreementObstruction a logic:Kind .
gmeow:VerifierVerdict a logic:SubKind .
gmeow:ConstraintHardness a logic:AbstractIndividualType .
gmeow:PreferenceProof a logic:Kind .
gmeow:PreferenceCounterexample a logic:Kind .
gmeow:ProjectionReceipt a logic:Kind .
gmeow:ProjectionKind a logic:AbstractIndividualType .
gmeow:ProjectionDeterminism a logic:AbstractIndividualType .
gmeow:DisclosedLossEntry a logic:Kind .
gmeow:DpoView a logic:Kind .
gmeow:PreferenceLearningEvent a logic:Event .
gmeow:ModelConfigDelta a logic:Kind .
gmeow:TokenizerContract a logic:Kind .
gmeow:CodebookContract a logic:Kind .
gmeow:SelectionQuery a logic:Kind .
gmeow:EngineContract a logic:Kind .
gmeow:OptimizerContract a logic:Kind .
gmeow:LifecycleReceipt a logic:Kind .
gmeow:ReceiptKind a logic:AbstractIndividualType .
gmeow:PromotionReceipt a logic:SubKind .
gmeow:RejectionReceipt a logic:SubKind .
gmeow:RollbackReceipt a logic:SubKind .
gmeow:EvaluationReceipt a logic:SubKind .
gmeow:ConsumerImprovementGate a logic:SubKind .
gmeow:PreferenceConformanceFailure a logic:Situation .
gmeow:GlobalWinnerWithoutConsensus a logic:Situation .
gmeow:ProjectionObjectConflation a logic:Situation .
gmeow:HardFailureOverridden a logic:Situation .
gmeow:GeometryDimensionMismatch a logic:Situation .
