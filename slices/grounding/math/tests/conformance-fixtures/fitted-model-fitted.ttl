#
# Well-formed: a fitted model bound to its data (math:fittedToData) and its specification
# (math:modelFormula). Conforms to math:FittedModelShape and math:ModelFormulaShape.
# Bound by ex:ecFittedModelFitted.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:fit a math:FittedModel ;
    math:fittedToData ex:data ;
    math:modelFormula ex:formula .
ex:data a math:DatasetMatrix .
ex:formula a math:ModelFormula ;
    math:argumentSlot ex:slot0 .
ex:slot0 a math:ArgumentSlot ; math:slotIndex 0 ; math:slotExpression ex:respVar .
ex:respVar a math:VariableExpression .
