    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnCandidateMathPi
    a gmeow:GmnSymbolCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: math:pi as π"@x-gmeow-english ;
    skos:definition "The audited adoption record for rendering the exact constant math:pi as π in @μ records."@x-gmeow-english ;
    gmeow:gmnCandidateTarget math:pi ;
