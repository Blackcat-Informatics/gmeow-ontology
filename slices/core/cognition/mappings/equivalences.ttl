gmeow:eqCognition014 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:curiousAbout ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q366791 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata Q366791 'curiosity' — entity-page verified 2026-06-18. Issue-supplied Q179637 resolved to 'prisoner of war' and was rejected." ;
    gmeow:sssomFile "gmeow-cognition.sssom.tsv" .

# Wikidata — mastery.
gmeow:eqCognition015 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasMastered ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q12770764 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata Q12770764 'mastery' — entity-page verified 2026-06-18. Issue-supplied Q1016098 resolved to 'Mautes' (French commune) and was rejected." ;
    gmeow:sssomFile "gmeow-cognition.sssom.tsv" .
