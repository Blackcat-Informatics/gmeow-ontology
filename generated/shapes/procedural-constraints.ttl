        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/mitigationCounters> ?v . FILTER NOT EXISTS { { ?v a <https://blackcatinformatics.ca/gmeow/CausalLink> . } UNION { ?v a <https://blackcatinformatics.ca/gmeow/Hazard> . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/MitigationMeasureConstraintProceduralConstraintShape>
