gmeow:WorldObjectKind
    a logic:Class, logic:AbstractIndividualType ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "World Object Kind"@x-gmeow-english ;
    skos:definition "An open value vocabulary for everyday kinds of represented world objects. Values classify objects within an attributed world description; they are neither Concept individuals nor per-kind object subclasses."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: An open value vocabulary for everyday kinds of represented world objects. Values classify objects within an attributed world description; they are neither Concept individuals nor per-kind object subclasses."@x-gmeow-english .

gmeow:WorldObjectRecord
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "World Object Record"@x-gmeow-english ;
    skos:definition "An attributed provider record describing an entity or part in one simulated world. Object identity, provider program and world scope remain distinct; a provider handle alone is not a global identity."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: An attributed provider record describing an entity or part in one simulated world. Object identity, provider program and world scope remain distinct; a provider handle alone is not a global identity."@x-gmeow-english .

gmeow:WorldObjectStateClaim
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:WorldObjectRecord ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "World Object State Claim"@x-gmeow-english ;
    skos:definition "An attributed claim of an object's meaningful-state digest under a named canonical encoding profile. Causal replacement follows supersedes, not clocks; concurrent unsuperseded claims may coexist."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: An attributed claim of an object's meaningful-state digest under a named canonical encoding profile. Causal replacement follows supersedes, not clocks; concurrent unsuperseded claims may coexist."@x-gmeow-english .

gmeow:WorldStateView
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "World State View"@x-gmeow-english ;
    skos:definition "An explicitly bounded inventory of state claims for one object, provider, world and encoding profile. Its current heads are exactly inventory members with no superseding member, never a certificate of global completeness."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: An explicitly bounded inventory of state claims for one object, provider, world and encoding profile. Its current heads are exactly inventory members with no superseding member, never a certificate of global completeness."@x-gmeow-english .

gmeow:WorldObjectRequest
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "World Object Request"@x-gmeow-english ;
    skos:definition "An exact source revision requesting that an object be provided in a simulated world. It is distinct from an attention request, an agent's Desire and any act that acknowledges or fulfills it."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: An exact source revision requesting that an object be provided in a simulated world. It is distinct from an attention request, an agent's Desire and any act that acknowledges or fulfills it."@x-gmeow-english .

gmeow:RequestTransition
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Request Transition Record"@x-gmeow-english ;
    skos:definition "An attributed record of a request-state transition for an exact request revision. It preserves source evidence and time without asserting an unrecorded act or replacing history with a mutable success flag."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: An attributed record of a request-state transition for an exact request revision. It preserves source evidence and time without asserting an unrecorded act or replacing history with a mutable success flag."@x-gmeow-english .

gmeow:RequestResponse
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Object Request Response Record"@x-gmeow-english ;
    skos:definition "An attributed reply record tied to the exact object-request revision it answers. Recording a response does not itself establish fulfillment or acceptance."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: An attributed reply record tied to the exact object-request revision it answers. Recording a response does not itself establish fulfillment or acceptance."@x-gmeow-english .

gmeow:RequestFulfillment
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Object Request Fulfillment Record"@x-gmeow-english ;
    skos:definition "An attributed report identifying the provided object, exact request revision, cited work and condition evaluations. Fulfillment and the agent's later acceptance are separate claims; validation does not execute criteria."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: An attributed report identifying the provided object, exact request revision, cited work and condition evaluations. Fulfillment and the agent's later acceptance are separate claims; validation does not execute criteria."@x-gmeow-english .

gmeow:RequestCorrection
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Object Request Correction Record"@x-gmeow-english ;
    skos:definition "An evidence-backed correction of a recorded response or transition for one request revision. It retains the original record and source rather than erasing history or denying that a real event occurred."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: An evidence-backed correction of a recorded response or transition for one request revision. It retains the original record and source rather than erasing history or denying that a real event occurred."@x-gmeow-english .

gmeow:ObjectAcceptance
    a logic:Class, logic:Event ;
    logic:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Object Acceptance"@x-gmeow-english ;
    skos:definition "An agent's recorded acceptance act for an exact fulfillment and request revision. Agent, original acceptance words, source evidence and acceptance time are explicit; fulfillment alone does not imply acceptance."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: An agent's recorded acceptance act for an exact fulfillment and request revision. Agent, original acceptance words, source evidence and acceptance time are explicit; fulfillment alone does not imply acceptance."@x-gmeow-english .

gmeow:CitedWorkEvidence
    a logic:Class, logic:Role ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Cited Work Evidence"@x-gmeow-english ;
    skos:definition "A source artifact in the role of work cited as done. Its recorded reference kind and verification status remain source-attributed; citation alone is not execution, verification or satisfaction of a condition."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly attributed environment record with exact source identities."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authority, acceptance or global completeness from a source record alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the provider, world, original source and recorded scope; preserve conflicting reports without defaults."@x-gmeow-english ;
    skos:example "Retain this documented meaning: A source artifact in the role of work cited as done. Its recorded reference kind and verification status remain source-attributed; citation alone is not execution, verification or satisfaction of a condition."@x-gmeow-english .

gmeow:WorkReferenceKind
