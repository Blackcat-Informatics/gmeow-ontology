<https://blackcatinformatics.ca/logic/target/correspondence:693dca551ec34fc1>
    a logic:ProjectionTarget ;
    rdfs:label "correspondence:693dca551ec34fc1" ;
    gmeow:lossyDrop "a lossy correspondence's get leg is many-to-one (non-injective): the coarse view cannot recover the source distinctions its finer domain drew, so the lowering is a sound under-approximation, never exact — the dropped source distinctions survive only in the canonical logic: layer" ,
        "actual: correspondence: https://blackcatinformatics.ca/logic/corrSzsToVerdict" ,
        "actual: logic:SzsContradictoryAxioms and logic:SzsUnsatisfiable collapse to logic:ConfInconsistent; the CAX≠UNS distinction survives only via logic:rawStatusToken" ,
        "actual: logic:SzsCounterSatisfiable and logic:SzsSatisfiable collapse to logic:ConfConsistent; the CSA≠SAT distinction survives only via logic:rawStatusToken" ;
    logic:complexityClass "decidable/graph-iso lens-law check" ;
    logic:preservationKind logic:SoundUnderApproximation .

<https://blackcatinformatics.ca/logic/target/datalog>
    a logic:ProjectionTarget ;
    rdfs:label "datalog" ;
    gmeow:lossyDrop "OWL class expressions not representable as Datalog atoms are dropped" ,
        "actual: logic:Formula #0 [Nested+Quantified] (full first-order quantifier / connective tree) is not representable in Datalog; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: logic:Formula #1 [Nested+Quantified] (full first-order quantifier / connective tree) is not representable in Datalog; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: logic:Formula #2 [Disjunctive+Nested+Quantified] (full first-order quantifier / connective tree) is not representable in Datalog; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: logic:Formula #3 [Nested+Quantified+StrongNegation] (full first-order quantifier / connective tree) is not representable in Datalog; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: logic:Formula #4 [Disjunctive+Nested+Quantified] (full first-order quantifier / connective tree) is not representable in Datalog; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: logic:Formula #5 [Nested+Quantified+StrongNegation] (full first-order quantifier / connective tree) is not representable in Datalog; it remains in the canonical logic: layer (carried by canonical-rdf12) as flagged unsupported residue" ,
        "actual: reasoning contract (an anonymous faceted contract) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:PositiveHornProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:ProbabilisticProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:ProceduralPrologProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:StableModelProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:StratifiedNAFProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "actual: reasoning contract (preset logic:WellFoundedProfile) is not representable in Datalog; the full facet selection is dropped (preserved only in the canonical RDF 1.2 projection)" ,
        "modal/world context flattened to predicate reification" ,
        "no existential rule heads (skolemisation not emitted)" ;
    logic:complexityClass "terminating/PTIME-data" ;
    logic:preservationKind logic:SoundUnderApproximation .

