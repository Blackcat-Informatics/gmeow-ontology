@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix loinc: <http://loinc.org/rdf/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix snomed: <http://snomed.info/id/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/loinc> a align:Alignment ;
    rdfs:label "GMEOW → loinc (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "ObservableProperty → loinc:Component"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:ObservableProperty ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri loinc:Component ] ;
            align:relation "<=" ;
            edoal:measure 7.5e-01 ],
        [ a align:Cell ;
            rdfs:label "SensoryObservation (lab test) → loinc:LabTest"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:SensoryObservation ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri loinc:LabTest ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ],
        [ a align:Cell ;
            rdfs:label "ObservationMethod → loinc:Method"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:ObservationMethod ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri loinc:Method ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "ScalarQuantity → loinc:Quantity"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:ScalarQuantity ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri loinc:Quantity ] ;
            align:relation "<=" ;
            edoal:measure 7.5e-01 ],
        [ a align:Cell ;
            rdfs:label "SensoryObservation (finding) → snomed:404684003"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:SensoryObservation ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri snomed:404684003 ] ;
            align:relation "<=" ;
            edoal:measure 7.5e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "loinc" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
