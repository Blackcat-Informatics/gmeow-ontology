#
# Counter-example for math:LimitShape: a math:Limit naming its expression but omitting
# math:limitPoint (sh:minCount 1). Validation MUST emit shacl.MinCountConstraintComponent
# (math:UnderspecifiedLimit). Bound by ex:ecLimitMissingPoint.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:pointlessLimit a math:Limit ;
    math:operator math:limitBinder ;
    math:limitOf ex:someExpr .

# The limited expression is an incidental named operand here, not the defect. It is a
# math:SymbolReference so the ONLY class this fixture raises is the missing math:limitPoint —
# the abstract math:MathematicalExpression base names no concrete form and would raise
# math:UnrecognizedExpressionType beside it.
ex:someExpr a math:SymbolReference ; math:hasMathematicalSymbol ex:someExprSymbol .
ex:someExprSymbol a math:MathematicalSymbol .
