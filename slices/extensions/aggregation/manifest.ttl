@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/aggregation>
    a gmeow:Slice ;
    rdfs:label "aggregation"@x-gmeow-english ;
    skos:definition "The aggregation slice of the GMEOW ontology (extension tier): GMEOW Spatial Aggregation Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    dcterms:title "GMEOW Spatial Aggregation Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierExtension ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/documents> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/math> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/places> ;
    gmeow:sliceConsumer "Spatial aggregation (count, density, k-anonymity) in the solver layer over places."@x-gmeow-english .
