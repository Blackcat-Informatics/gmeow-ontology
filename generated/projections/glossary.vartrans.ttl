    a ontolex:Form ;
    ontolex:writtenRep "Relates a Hodge decomposition to the flow, chain, or cochain it separates into exact, coexact, and harmonic components."@en .

<http://example.org/lang/glossary-vartrans/form-src/73a28160a0efb1df>
    a ontolex:Form ;
