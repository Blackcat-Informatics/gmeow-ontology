@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .

# The complete RDF literal is retained. This does not identify schema:value
# with this narrower literal-valued property or interpret a literal as a number.
lang:literalValue skos:relatedMatch schema:value .
lang:literalValueSchemaBridge
    rdf:reifies <<(lang:literalValue skos:relatedMatch schema:value)>> ;
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-schema-org-literal-values.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    logic:sourceEndpoint lang:literalValue ;
    logic:targetEndpoint schema:value ;
    logic:morphismClass logic:BridgeView ;
    logic:morphismKind logic:CommitmentShiftingBridge ;
    logic:preservationKind logic:ValidationOnly .
