@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix oa: <http://www.w3.org/ns/oa#> .

<https://blackcatinformatics.ca/gmeow/projections/web-annotation>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:Annotation ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri oa:Annotation ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.85"^^xsd:double ;
        rdfs:label "Annotation relator → oa:Annotation (body/target/motivatedBy)"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:Bookmark ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri oa:Annotation ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "Bookmark → oa:Annotation (target only, motivatedBy bookmarking)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:Comment ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri oa:Annotation ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            rdfs:label "Comment → oa:Annotation (body = comment, target = parent, motivatedBy replying)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:Highlight ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri oa:Annotation ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "Highlight → oa:Annotation (SpecificResource + selector, no body)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:Tagging ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri oa:Annotation ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnTaggingToAnnotation ;
            ] ;
            rdfs:label "Tagging relator → oa:Annotation (body/target/motivatedBy)"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:groundedIn ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri oa:Annotation ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "groundedIn evidence span → oa:Annotation (claim body, chunk target, position selector)"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "web-annotation" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → web-annotation (EDOAL)"@en .
