gmeow:ContextPlanHasConditionAndBudgetConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "context plan condition and budget constraint"@x-gmeow-english ;
    skos:definition "A selected context-plan kind names a situation condition and one finite recall budget for the same plan."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve context plan condition and budget constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying ContextPlanHasConditionAndBudgetConstraint by inventing records or selecting a weaker operation."@x-gmeow-english ;
    gmeow:howToUse "Apply ContextPlanHasConditionAndBudgetConstraint to the explicit scoped records and retain the original evidence."@x-gmeow-english ;
    skos:example "The declared records are checked against gmeow:ContextPlanHasConditionAndBudgetConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:prescriptionKindContextPlan ;
    logic:message "A selected context-plan kind names a situation condition and one finite recall budget for the same plan." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation logic:prescriptionKind ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:prescriptionKindContextPlan ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "condition" ] , [ logic:termIndex 1 ; logic:termVariable "budget" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:contextPlanCondition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "condition" ] ] , [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "condition" ] , [ logic:termIndex 1 ; logic:termIri logic:Situation ] ] , [ a logic:Formula ; logic:relation gmeow:budgetForPlan ; logic:argument [ logic:termIndex 0 ; logic:termVariable "budget" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] ] , [ a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ; logic:argument [ logic:termIndex 0 ; logic:termVariable "budget" ] , [ logic:termIndex 1 ; logic:termIri gmeow:RecallBudget ] ] ] ] ] ] .

gmeow:RecallBudgetOnePerPlanConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "one recall budget per plan constraint"@x-gmeow-english ;
    skos:definition "One plan-local budget roster owns the allocation total, so independent rosters cannot each spend the whole plan budget."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve one recall budget per plan constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying RecallBudgetOnePerPlanConstraint by inventing records or selecting a weaker operation."@x-gmeow-english ;
    gmeow:howToUse "Apply RecallBudgetOnePerPlanConstraint to the explicit scoped records and retain the original evidence."@x-gmeow-english ;
    skos:example "The declared records are checked against gmeow:RecallBudgetOnePerPlanConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:budgetForPlan ;
    logic:message "One plan-local budget roster owns the allocation total, so independent rosters cannot each spend the whole plan budget." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "other" ] , [ logic:termIndex 2 ; logic:termVariable "plan" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:budgetForPlan ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "plan" ] ] , [ a logic:Formula ; logic:relation gmeow:budgetForPlan ; logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "plan" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "other" ] ] ] ] .

gmeow:RecallOperationOneBudgetConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "operation allocation ownership constraint"@x-gmeow-english ;
    skos:definition "An operation allocation belongs to one budget roster; reuse in another plan requires another operation identity."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve operation allocation ownership constraint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying RecallOperationOneBudgetConstraint by inventing records or selecting a weaker operation."@x-gmeow-english ;
    gmeow:howToUse "Apply RecallOperationOneBudgetConstraint to the explicit scoped records and retain the original evidence."@x-gmeow-english ;
    skos:example "The declared records are checked against gmeow:RecallOperationOneBudgetConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:budgetOperation ;
    logic:message "An operation allocation belongs to one budget roster; reuse in another plan requires another operation identity." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "other" ] , [ logic:termIndex 2 ; logic:termVariable "operation" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:budgetOperation ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "operation" ] ] , [ a logic:Formula ; logic:relation gmeow:budgetOperation ; logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] , [ logic:termIndex 1 ; logic:termVariable "operation" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "other" ] ] ] ] .

gmeow:RecallBudgetTotalBoundConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "recall budget total bound law"@x-gmeow-english ;
    skos:definition "The derived finite sum of operation shares must be at most one. Equal numeric shares from distinct operations contribute separately."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve recall budget total bound law."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying RecallBudgetTotalBoundConstraint by inventing records or selecting a weaker operation."@x-gmeow-english ;
    gmeow:howToUse "Apply RecallBudgetTotalBoundConstraint to the explicit scoped records and retain the original evidence."@x-gmeow-english ;
    skos:example "The declared records are checked against gmeow:RecallBudgetTotalBoundConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:recallBudgetTotal ;
    logic:message "The derived finite sum of operation shares must be at most one. Equal numeric shares from distinct operations contribute separately." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "total" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:recallBudgetTotal ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "total" ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termLessEqual ; logic:argument [ logic:termIndex 0 ; logic:termVariable "total" ] , [ logic:termIndex 1 ; logic:termLiteral "1.0" ; logic:termLiteralDatatype xsd:decimal ] ] ] ] .

