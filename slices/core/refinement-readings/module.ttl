@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:ReadingScope
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Reading Scope"@x-gmeow-english ;
    skos:definition "An attributed enumeration of the exact source records offered to a selected refiner, with their declared assertion-time chronology frame. It asserts no completeness of the surrounding store."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:scope a gmeow:ReadingScope ."@x-gmeow-english .

gmeow:scopeRecord
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "scope record"@x-gmeow-english ;
    skos:definition "A source record offered within a reading scope, including a record later reported unreadable. Members retain their actual RDF identities, including blank nodes or triple terms when supplied."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:scope gmeow:scopeRecord ex:record ."@x-gmeow-english .

gmeow:scopeChronology
    a logic:ObjectProperty ;
    logic:range gmeow:TemporalFrame ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "scope chronology"@x-gmeow-english ;
    skos:definition "The temporal frame in which source assertion times are interpreted for this scope’s chronology. The selected reading must respect original precision and unresolved ties; this relation does not manufacture an order."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:scope gmeow:scopeChronology gmeow:temporalFrameUTCGregorian ."@x-gmeow-english .

gmeow:readingScope
    a logic:ObjectProperty ;
    logic:range gmeow:ReadingScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "reading scope"@x-gmeow-english ;
    skos:definition "The explicit source-record scope of a finding or reading-limit aggregate. This relation does not turn its subject into an Observation or claim global source coverage."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:readingScope ex:scope ."@x-gmeow-english .

gmeow:FirstOccurrence
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:Refinement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "First Occurrence"@x-gmeow-english ;
    skos:definition "A selected refiner’s reading of an earliest source record for one relation and referent among the records explicitly offered in its reading scope, under the declared source assertion-time chronology. It is not a global first or the subject’s assertion."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:first a gmeow:FirstOccurrence ."@x-gmeow-english .

gmeow:RelationOccasion
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:Refinement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Relation Occasion"@x-gmeow-english ;
    skos:definition "A selected refiner’s reading of one occasion of a relation to a resource or source-named referent in its declared records-read scope. It records source evidence rather than an independent world event."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:occasion a gmeow:RelationOccasion ."@x-gmeow-english .

gmeow:relationPredicate
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "relation predicate"@x-gmeow-english ;
    skos:definition "The actual predicate IRI by which the source records relate to the referent. It names the source relation without asserting a new edge or evaluating a query."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relationPredicate gmeow:hasParticipant ."@x-gmeow-english .

gmeow:relationVault
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "relation vault"@x-gmeow-english ;
    skos:definition "The source store containing the records for this relation reading or reading-limit aggregate. Naming the store supplies neither access authority nor a claim that every store record was read."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relationVault ex:archive ."@x-gmeow-english .

gmeow:relatedThing
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "related thing"@x-gmeow-english ;
    skos:definition "The referent identified by its actual IRI in the source relation. The IRI is retained without inferring identity from a name or minting a replacement for an unshareable source term."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relatedThing ex:person ."@x-gmeow-english .

gmeow:relatedName
    a logic:DatatypeProperty ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:string rdf:langString rdf:dirLangString ) ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "related name"@x-gmeow-english ;
    skos:definition "The exact source-supplied name when a relation names its referent only by a literal. Language and base direction are retained when supplied; the name alone does not establish an IRI identity."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relatedName \"Visitor\"@en ."@x-gmeow-english .

gmeow:relationAt
    a logic:DatatypeProperty ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear ) ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "relation assertion time"@x-gmeow-english ;
    skos:definition "The original assertion-time value supplied by the source record, retained at its actual precision. It is neither the refiner’s observation clock nor the record’s transaction time; a date, month or year invents no instant or timezone."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relationAt \"2026-10\"^^xsd:gYearMonth ."@x-gmeow-english .

gmeow:relationIn
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "relation source occasion"@x-gmeow-english ;
    skos:definition "The source occasion or context in which the relation was found, such as a conversation. This is distinct from the refiner’s execution and from its derived RelationOccasion reading."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:relationIn ex:conversation ."@x-gmeow-english .

gmeow:findingSummary
    a logic:DatatypeProperty ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( rdf:langString rdf:dirLangString ) ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "finding summary"@x-gmeow-english ;
    skos:definition "A language-bearing one-line account of what the refiner found under its own vantage. The wording retains its language and any base direction and does not become the source subject’s claim."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:finding gmeow:findingSummary \"Earliest in the supplied archive excerpt.\"@en ."@x-gmeow-english .

gmeow:Milestone
    a logic:Class, logic:Kind ;
    logic:subClassOf gmeow:InformationObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Milestone"@x-gmeow-english ;
    skos:definition "An attributed information annotation in which a teller reads a source record as marking a milestone. It is distinct from the underlying life event and never automatically the subject’s own claim."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:annotation a gmeow:Milestone ."@x-gmeow-english .

gmeow:MilestoneKind
    a logic:Class, logic:AbstractIndividualType ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Milestone Kind"@x-gmeow-english ;
    skos:definition "An open quality-value vocabulary of teller-defined milestone classifications. Consumers mint their own individuals; no classification is a diagnosis or an event type inferred from the source."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:localKind a gmeow:MilestoneKind ."@x-gmeow-english .

gmeow:milestoneKind
    a logic:ObjectProperty ;
    logic:range gmeow:MilestoneKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "milestone kind"@x-gmeow-english ;
    skos:definition "The teller’s classification of a milestone annotation, drawn from the open MilestoneKind vocabulary."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:annotation gmeow:milestoneKind ex:localKind ."@x-gmeow-english .

gmeow:milestoneOf
    a logic:ObjectProperty ;
    logic:range logic:Thing ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "milestone source"@x-gmeow-english ;
    skos:definition "The original record on which the teller’s milestone annotation rests. This link identifies evidence rather than declaring that the record itself is a life event."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:annotation gmeow:milestoneOf ex:record ."@x-gmeow-english .

gmeow:ReadingLimit
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:QueryLossLedger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Reading Limit"@x-gmeow-english ;
    skos:definition "An attributed QueryLossLedger grouping records the selected refiner could not read for one relation, store, source scope and reason. Its reported count may be zero; actual excluded records retain separate QueryLoss identities through ledgerLoss."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:limit a gmeow:ReadingLimit ."@x-gmeow-english .

gmeow:ReadingLimitReason
    a logic:Class, logic:AbstractIndividualType ;
    logic:subClassOf gmeow:QueryLossCause ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Reading Limit Reason"@x-gmeow-english ;
    skos:definition "An open specialization of QueryLossCause for limitations of a selected refiner and input scope. A reason describes that operation’s capability boundary, never an RDF 1.2 prohibition."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:localReason a gmeow:ReadingLimitReason ."@x-gmeow-english .

gmeow:limitReason
    a logic:ObjectProperty ;
    logic:range gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "limit reason"@x-gmeow-english ;
    skos:definition "The selected refiner limitation grouping this aggregate’s excluded records. Each referenced actual loss retains this same reason through lossCause."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:limit gmeow:limitReason gmeow:limitNoAssertionTime ."@x-gmeow-english .

gmeow:limitCount
    a logic:DatatypeProperty ;
    logic:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "limit count"@x-gmeow-english ;
    skos:definition "The reported number of distinct source records excluded for this aggregate’s single reason and scope. Zero records no actual loss; the count is a source report whose exact arithmetic is not certified by the ontology."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:limit gmeow:limitCount \"0\"^^xsd:nonNegativeInteger ."@x-gmeow-english .

gmeow:limitNoAssertionTime
    a gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "no usable assertion time"@x-gmeow-english ;
    skos:definition "The selected refiner could not order this record because the input supplied no usable assertion time. It does not authorize substituting a refiner clock or inventing precision."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:loss gmeow:lossCause gmeow:limitNoAssertionTime ."@x-gmeow-english .

gmeow:limitRecordUnnameable
    a gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "record unnameable to refiner"@x-gmeow-english ;
    skos:definition "The selected refiner’s addressing contract could not retain a supplied blank-node record as a named record. RDF 1.2 can retain blank nodes; this is a limitation of the selected operation."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:loss gmeow:lossCause gmeow:limitRecordUnnameable ."@x-gmeow-english .

gmeow:limitThingUnshareable
    a gmeow:ReadingLimitReason ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "referent unshareable to refiner"@x-gmeow-english ;
    skos:definition "The selected refiner could not correlate a supplied blank-node or triple-term referent across records under its addressing contract. This neither bans those RDF 1.2 terms nor proves that no relation or shared referent exists."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this part of an explicitly scoped, attributed reading."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global completeness, source-subject endorsement or a successful computation from this record."@x-gmeow-english ;
    gmeow:howToUse "Preserve the original source identities, supplied precision and declaring vantage; do not replace missing evidence with defaults."@x-gmeow-english ;
    skos:example "Retain this scoped report: ex:loss gmeow:lossCause gmeow:limitThingUnshareable ."@x-gmeow-english .

gmeow:scopeRecord logic:domain gmeow:ReadingScope .
gmeow:scopeChronology logic:domain gmeow:ReadingScope .
gmeow:milestoneKind logic:domain gmeow:Milestone .
gmeow:milestoneOf logic:domain gmeow:Milestone .
gmeow:limitReason logic:domain gmeow:ReadingLimit .
gmeow:limitCount logic:domain gmeow:ReadingLimit .
gmeow:milestoneOf logic:subPropertyOf gmeow:wasDerivedFrom .
gmeow:scopeChronology logic:subPropertyOf gmeow:hasReferenceFrame .


gmeow:ReadingScope logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:scopeChronology ; logic:allValuesFrom gmeow:TemporalFrame ] .
