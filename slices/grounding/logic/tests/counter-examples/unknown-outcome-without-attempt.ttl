#
# N5 - an unknown outcome naming no attempt. Retry from an undetermined position is
# licensed only through the attempt, so this record can never be resolved and can never
# license the retry it invites. MUST trip logic:NoBlindRetryConstraint.

@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/logic/tests/> .

ex:unknownNoAttempt a logic:ExternalOutcomeUnknown ;
    rdfs:label "an unknown outcome that names no attempt to reconcile"@en .
