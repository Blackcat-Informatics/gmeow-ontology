    logic:forall [ a logic:Formula ;
        logic:antecedent [ a logic:Formula ;
            logic:relation rdf:type ;
            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryAppliedFusionCoefficient ] ] ;
        logic:consequent [ a logic:Formula ;
            logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "b59_e_a" ] ;
            logic:exists [ a logic:Formula ;
                logic:and [ a logic:Formula ;
                    logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "b59_e_a" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryWeightedFusionApplication ] ],
                [ a logic:Formula ;
                    logic:relation gmeow:weightedFusionCoefficient ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "b59_e_a" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ] ] ] ] ] .

gmeow:WeightedFusionPartialSumOwnerPresenceLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "weighted fusion partial sum owner presence law"@x-gmeow-english ;
    skos:definition "Every typed partial-sum Quantity has at least one typed incoming declared fold step."@x-gmeow-english ;
    gmeow:useWhen "Use to keep derived sum carriers within actual declared witness accounts."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid imposing unique inverse total ownership or inferring source reporting solely from the witness role."@x-gmeow-english ;
    gmeow:howToUse "Require weightedStepTotal from a typed QueryWeightedScoreFoldStep; that step separately requires its unique score owner."@x-gmeow-english ;
    skos:scopeNote "Compatible control steps may share the same total Quantity. No artificial disjointness from other compatible Quantity roles is imposed."@x-gmeow-english ;
    skos:example "Fictional scoped example: A fictional total Quantity shared by two compatible steps is permitted; an isolated typed partial sum fails."@x-gmeow-english ;
    logic:formalizes gmeow:QueryWeightedPartialSum ;
    logic:message "Every typed partial-sum Quantity has at least one typed incoming declared fold step." ;
    logic:integrity [ a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall [ a logic:Formula ;
        logic:antecedent [ a logic:Formula ;
            logic:relation rdf:type ;
            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryWeightedPartialSum ] ] ;
        logic:consequent [ a logic:Formula ;
            logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "b60_e_t" ] ;
            logic:exists [ a logic:Formula ;
                logic:and [ a logic:Formula ;
                    logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "b60_e_t" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryWeightedScoreFoldStep ] ],
                [ a logic:Formula ;
                    logic:relation gmeow:weightedStepTotal ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "b60_e_t" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ] ] ] ] ] .

