@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix schema:  <https://schema.org/> .

# Term equivalences for the finance domain — schema.org financial extension.
# Compiled to mappings/gmeow-schema-org-finance.sssom.tsv by `gmeow compile-mappings`.
# schema.org's financial terms are FIBO-derived and form the clean projection target.

gmeow:mapsetSchemaOrgFinance a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/schema-org-finance" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "schema.org financial extension alignments for the GMEOW finance slice. schema.org BankAccount/DepositAccount/MonetaryAmount/Invoice/Order/Payment/LoanOrCredit are the clean projection targets." .

gmeow:eqSchemaOrgFin001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:FinancialAccount ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:BankAccount ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "a bank account; GMEOW FinancialAccount is broader (also credit, investment, wallet)" ;
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" .

gmeow:eqSchemaOrgFin002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:FinancialAccount ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject schema:DepositAccount ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "a deposit account is a kind of bank account" ;
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" .

gmeow:eqSchemaOrgFin003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:MonetaryAmount ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:MonetaryAmount ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a quantity of money; GMEOW makes the currency frame explicit via ReferenceFrame" ;
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" .

gmeow:eqSchemaOrgFin004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:monetaryValue ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:value ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "the numeric value of a monetary amount" ;
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" .

gmeow:eqSchemaOrgFin005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:currency ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:currency ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "the currency of a monetary amount; GMEOW uses a ReferenceFrame individual, schema.org uses a string code" ;
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" .

gmeow:eqSchemaOrgFin006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:iban ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject schema:iban ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "International Bank Account Number" ;
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" .

gmeow:eqSchemaOrgFin007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:accountBalance ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:accountBalance ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the balance of a bank account" ;
    gmeow:sssomFile "gmeow-schema-org-finance.sssom.tsv" .
