@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix wd:     <http://www.wikidata.org/entity/> .

# Term equivalences for the GraphRAG extension — GMEOW authoring source.
# Maximal bridging BY REFERENCE (Principle 5). All QIDs curl-validated against
# the Wikidata API on 2026-06-12.

gmeow:mapsetGraphrag a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-graphrag.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/graphrag" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """GraphRAG pipeline alignments (consumer: Project Lillith).
        The pipeline activities are prov:Activity by inheritance (provenance set); cells here cover the artifacts.
        schema.org: the corpus is the working dataset surface (#58's Croissant profile builds on this cell).
        Wikidata: hub identifiers for the technique family — several cells are relatedMatch because Wikidata names the TECHNIQUE (community detection, summarization) where GMEOW names the derived ARTIFACT.""" ;
    gmeow:setTrailer "# REFUSED (Principle 5 — the genuine gap, #54): gmeow:Embedding / gmeow:VectorIndex have no external RDF vocabulary to cell against — model, dimensionality, metric, and index parameters have no agreed semantic representation anywhere. Recorded rather than papered over; revisit when a standard emerges.\n# REFUSED (Principle 5 — no stable RDF namespace): OpenLineage and MLflow describe runs/lineage as JSON specs, not RDF vocabularies; bridging is a projection concern (#58 Workflow Run Crate), not a term alignment.\n# REFUSED (Principle 5 — instance-level): Leiden/Louvain algorithm identities belong on the clustering Activity as instance data, not as TBox alignments." .

gmeow:eqGr001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Corpus ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q461183 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'text corpus'; curl-validated 2026-06-12" ;
    gmeow:sssomFile "gmeow-graphrag.sssom.tsv" .

gmeow:eqGr002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Corpus ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:Dataset ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "the working retrieval dataset; the #58 Croissant/RO-Crate profiles project through this cell" ;
    gmeow:sssomFile "gmeow-graphrag.sssom.tsv" .

gmeow:eqGr003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Embedding ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q18395344 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata 'word embedding' — the vector-representation technique family (no artifact-level RDF vocabulary exists; see trailer); curl-validated 2026-06-12" ;
    gmeow:sssomFile "gmeow-graphrag.sssom.tsv" .

gmeow:eqGr004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:RetrievalEvent ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q121362277 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Wikidata 'retrieval-augmented generation' — the technique this event instruments; curl-validated 2026-06-12" ;
    gmeow:sssomFile "gmeow-graphrag.sssom.tsv" .

gmeow:eqGr005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Community ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q105222918 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Wikidata 'community detection' — the technique producing the artifact; curl-validated 2026-06-12" ;
    gmeow:sssomFile "gmeow-graphrag.sssom.tsv" .

gmeow:eqGr006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:CommunitySummary ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q1394144 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Wikidata 'automatic summarization' — the technique; the artifact also bridges via its Summary parent; curl-validated 2026-06-12" ;
    gmeow:sssomFile "gmeow-graphrag.sssom.tsv" .

gmeow:eqGr007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ExtractedEntity ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject schema:Thing ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.4 ;
    gmeow:comment "an extracted-entity DESCRIPTION projects as the schema:Thing it putatively describes only AFTER curation promotes it; the low confidence is the point" ;
    gmeow:sssomFile "gmeow-graphrag.sssom.tsv" .
