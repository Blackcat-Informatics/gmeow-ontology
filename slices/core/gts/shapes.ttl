@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# =========================================================================== #
# GTS transport data shapes (#267, docs/GTS-SPEC.md)
# =========================================================================== #

# An opaque frame without a stated reason is indistinguishable from data
# loss — the reason is the whole point of surfacing opacity (spec §7.6).
gmeow:OpaqueFrameShape
    a sh:NodeShape ;
    rdfs:label "OpaqueFrame well-formedness shape" ;
    sh:targetClass gmeow:OpaqueFrame ;
    sh:property [
        sh:path gmeow:opacityReason ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:OpacityReason ;
        sh:severity sh:Violation ;
        sh:message "An OpaqueFrame must state exactly one gmeow:opacityReason (unknown-codec, missing-key, or damaged)." ;
    ] ;
    sh:property [
        sh:path gmeow:opaqueFrameIn ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:GTSSegment ;
        sh:severity sh:Violation ;
        sh:message "An OpaqueFrame must belong to exactly one gmeow:GTSSegment." ;
    ] .

# A missing-key frame is sealed TO someone; opacity is vantage-relative, so
# the audience must be stated for the description to be useful (spec §9.3).
gmeow:SealedFrameRecipientShape
    a sh:NodeShape ;
    rdfs:label "Sealed frame recipient shape" ;
    sh:targetClass gmeow:OpaqueFrame ;
    sh:severity sh:Violation ;   # NodeShape-level so pyshacl honors it
    sh:sparql [
        sh:message "A missing-key opaque frame must name at least one gmeow:sealedRecipient — sealed content has a declared audience." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/opacityReason>
                      <https://blackcatinformatics.ca/gmeow/opacityMissingKey> .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/sealedRecipient> ?recipient
                }
            }
        """ ;
    ] .

# A segment must carry the parts of its composite identity: exactly one head,
# exactly one index, exactly one profile (spec §3.1, §13).
gmeow:GTSSegmentShape
    a sh:NodeShape ;
    rdfs:label "GTSSegment well-formedness shape" ;
    sh:targetClass gmeow:GTSSegment ;
    sh:property [
        sh:path gmeow:gtsHeadId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^blake3:[0-9a-f]{64}$" ;
        sh:severity sh:Violation ;
        sh:message "A GTSSegment must carry exactly one gmeow:gtsHeadId of the form 'blake3:<64 hex digits>'." ;
    ] ;
    sh:property [
        sh:path gmeow:gtsSegmentIndex ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "A GTSSegment must carry exactly one non-negative gmeow:gtsSegmentIndex." ;
    ] ;
    sh:property [
        sh:path gmeow:gtsProfile ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:GTSProfile ;
        sh:severity sh:Violation ;
        sh:message "A GTSSegment must declare exactly one gmeow:gtsProfile." ;
    ] .

# Evidence packages should never reference a compaction event: re-authoring
# the ordering detaches the third-party transport attestation (#342). Seal
# the original verbatim as a nested GTS blob instead (spec §12.1).
gmeow:EvidenceCompactionShape
    a sh:NodeShape ;
    rdfs:label "Evidence-profile compaction shape" ;
    sh:targetClass gmeow:GTSDocument ;
    sh:severity sh:Warning ;   # NodeShape-level so pyshacl honors it
    sh:sparql [
        sh:message "An evidence-profile GTS document should not be generated by a GTSCompaction — compaction re-authors the ordering and detaches third-party transport attestation (#342)." ;
        sh:select """
            SELECT $this WHERE {
                ?segment <https://blackcatinformatics.ca/gmeow/gtsSegmentOf> $this ;
                         <https://blackcatinformatics.ca/gmeow/gtsProfile>
                         <https://blackcatinformatics.ca/gmeow/gtsProfileEvidence> .
                $this <https://blackcatinformatics.ca/gmeow/wasGeneratedBy> ?activity .
                ?activity a <https://blackcatinformatics.ca/gmeow/GTSCompaction> .
            }
        """ ;
    ] .
