<https://blackcatinformatics.ca/gmeow/ProximityObservedFeaturePresentConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ProximityMeasurementShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ProximityMeasurement> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ProximityMeasurement must name exactly one starting entity (gmeow:observedFeature)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/observedFeature> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ProximityResultPresentConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ProximityMeasurementShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ProximityMeasurement> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ProximityMeasurement must yield at least one math:Quantity result." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/observationResult> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ProximityResultTypeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ProximityMeasurementShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ProximityMeasurement> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ProximityMeasurement must yield a math:Quantity result." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/observationResult> ?v . FILTER NOT EXISTS { ?v a <https://blackcatinformatics.ca/math/Quantity> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ProximityToPresentConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ProximityMeasurementShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ProximityMeasurement> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ProximityMeasurement must name exactly one target entity (gmeow:proximityTo)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/proximityTo> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ReadingOrderAccordingToConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ReadingOrderShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ReadingOrder> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:ReadingOrder must be the gmeow:accordingTo of at least one claim; an ordering standpoint that nothing orders by is unwired." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { ?s <https://blackcatinformatics.ca/gmeow/accordingTo> $this . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ReminderTriggerLiteralConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ReminderHasTriggerAndActionShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/reminderTrigger> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Reminder must have exactly one reminderTrigger (xsd:duration or xsd:dateTime)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/reminderTrigger> ?g . $this <https://blackcatinformatics.ca/gmeow/reminderTrigger> ?v . FILTER ( !isLiteral(?v) ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ResultObjectConflationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/TopologyComputation> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/gmeow/ResultObjectConflation> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/TopologyComputation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:TopologyComputation's gmeow:producesResult value must be TYPED gmeow:TopologyResult and must NOT itself be typed in the math: namespace; an untyped result, or one conflated with a raw math: object, is gmeow:ResultObjectConflation." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/producesResult> ?r . ?r a <https://blackcatinformatics.ca/gmeow/TopologyResult> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/producesResult> ?r . ?r a ?k . FILTER ( STRSTARTS(STR(?k), 'https://blackcatinformatics.ca/math/') ) } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/RetractedAccessibilityAssertionSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/RetractedAccessibilityAssertionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/AccessibilityAssertion> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A retracted or superseded accessibility assertion (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/validUntil> ?u . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/RetractedTaggingSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/RetractedTagSuppressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Tagging> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A retracted or superseded tagging (one whose interval has ended) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/taggingInterval> ?iv . ?iv <https://blackcatinformatics.ca/gmeow/endedAtTime> ?end . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ReversedTransactionSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/FinancialTransaction> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ReversedTransactionSuppressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/FinancialTransaction> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A reversed transaction should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/transactionStatus> <https://blackcatinformatics.ca/gmeow/transactionStatusReversed> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/RightsStatementAssetConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/RightsStatement> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/RightsStatement> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A RightsStatement must govern exactly one asset (gmeow:statementAbout)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/statementAbout> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/RoleInNarrativeScopeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/RoleInNarrative> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/RoleInNarrative> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A RoleInNarrative must be relative to exactly one gmeow:narrativeRoleScope (an IRI) — protagonist-of-WHAT is half the claim. nodeKind only: scope instances are data-typed concretely (BookRelease, NarrativeReferenceFrame, ContentSegment) and raw-graph SHACL does no subclass inference toward NarrativeScope." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/narrativeRoleScope> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SceneGraphEdgeConfidenceRangeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SceneGraphEdgeShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/SceneGraphEdge> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "When present, gmeow:sceneConfidence must be a decimal in [0.0, 1.0]." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/sceneConfidence> ?v . FILTER ( ( ?v < '0.0'^^<http://www.w3.org/2001/XMLSchema#decimal> ) || ( ?v > '1.0'^^<http://www.w3.org/2001/XMLSchema#decimal> ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ScheduleHasRuleConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScheduleHasRuleShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/EventSchedule> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An EventSchedule must have at least one scheduleTemplateEvent or scheduleRecurrenceRule." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/scheduleRecurrenceRule> ?v0 . } UNION { $this <https://blackcatinformatics.ca/gmeow/scheduleTemplateEvent> ?v1 . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ScoreAnchorMeaningConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreAnchor> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreAnchorShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ScoreAnchor> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ScoreAnchor must carry at least one gmeow:anchorMeaning, at most one per language tag — an anchor without a meaning is just an interval (localizable prose, PR #376 review)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/anchorMeaning> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ScoreAnchorRangeMaxConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreAnchor> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreAnchorShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ScoreAnchor> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ScoreAnchor must pin exactly one decimal gmeow:anchorRangeMax — an anchor IS a pinned range." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/anchorRangeMax> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ScoreAnchorRangeMinConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreAnchor> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreAnchorShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ScoreAnchor> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ScoreAnchor must pin exactly one decimal gmeow:anchorRangeMin — an anchor IS a pinned range." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/anchorRangeMin> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ScoreAnchorRangeOrderConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreAnchor> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreAnchorShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ScoreAnchor> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ScoreAnchor's range minimum must not exceed its range maximum." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/anchorRangeMin> ?l . $this <https://blackcatinformatics.ca/gmeow/anchorRangeMax> ?r . FILTER ( ?l > ?r ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ScoreAnchorRangeWithinScaleConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreAnchor> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreAnchorShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ScoreAnchor> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ScoreAnchor's range must lie within the scale its criterion (or owning rubric) declares." ;
        sh:select """SELECT $this WHERE { ?criterion <https://blackcatinformatics.ca/gmeow/hasScoreAnchor> $this . { ?criterion <https://blackcatinformatics.ca/gmeow/usesScale> ?scale . } UNION { ?rubric <https://blackcatinformatics.ca/gmeow/hasCriterion> ?criterion . ?rubric <https://blackcatinformatics.ca/gmeow/usesScale> ?scale . FILTER NOT EXISTS { ?criterion <https://blackcatinformatics.ca/gmeow/usesScale> ?ownScale . } } ?scale <https://blackcatinformatics.ca/gmeow/scaleMin> ?smin . ?scale <https://blackcatinformatics.ca/gmeow/scaleMax> ?smax . $this <https://blackcatinformatics.ca/gmeow/anchorRangeMin> ?amin . $this <https://blackcatinformatics.ca/gmeow/anchorRangeMax> ?amax . FILTER ( ( ?amin < ?smin ) || ( ?amax > ?smax ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/ScoreScaleOrderConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreScale> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/ScoreScaleShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/ScoreScale> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A ScoreScale's minimum must be strictly below its maximum." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/scaleMin> ?l . $this <https://blackcatinformatics.ca/gmeow/scaleMax> ?r . FILTER ( ?l >= ?r ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SecurityMonotonicityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SecurityMonotonicityShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/EmbeddingProjection> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A projection whose sensitivity is below its source's requires an explicit gmeow:DeclassificationAct declassifying it — sensitivity never drops silently (P15)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/hasSensitivity> ?ps . ?ps <https://blackcatinformatics.ca/gmeow/sensitivityRank> ?pr . $this <https://blackcatinformatics.ca/gmeow/projectionSource> ?src . ?src <https://blackcatinformatics.ca/gmeow/hasSensitivity> ?ss . ?ss <https://blackcatinformatics.ca/gmeow/sensitivityRank> ?sr . FILTER ( ?sr > ?pr ) FILTER NOT EXISTS { ?act a <https://blackcatinformatics.ca/gmeow/DeclassificationAct> . ?act <https://blackcatinformatics.ca/gmeow/declassifies> $this . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SegmentTransformationDistinctConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SegmentTransformation> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/SegmentTransformation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A SegmentTransformation source and target must be distinct entities." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/transformationSource> ?a . $this <https://blackcatinformatics.ca/gmeow/transformationTarget> ?b . FILTER ( ?a = ?b ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SelfPrivateEvidenceWarningConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SelfPrivateEvidenceWarningShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/CitationAct> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "This citation relies solely on self-asserted or private evidence from a self/issuer-originated source — consider suppressing it from public projections (Principle 10)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/hasEvidenceClass> ?ec . FILTER ( ?ec IN (<https://blackcatinformatics.ca/gmeow/evidenceSELF>, <https://blackcatinformatics.ca/gmeow/evidencePrivateScan>) ) $this <https://blackcatinformatics.ca/gmeow/sourceIndependence> <https://blackcatinformatics.ca/gmeow/sourceIndependenceSelfOrIssuerOriginated> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/hasEvidenceClass> ?other . FILTER ( ?other NOT IN (<https://blackcatinformatics.ca/gmeow/evidenceSELF>, <https://blackcatinformatics.ca/gmeow/evidencePrivateScan>) ) } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SensitiveValueConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SensitiveValueShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/hasSensitivity> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A value marked gmeow:sensitivitySensitivePersonal should also carry gmeow:coarsenTo or gmeow:displayable false — the trigger for projection-time redaction (Principle 10). A source may legitimately publish the precise value under explicit consent." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/hasSensitivity> <https://blackcatinformatics.ca/gmeow/sensitivitySensitivePersonal> . FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/coarsenTo> ?lvl . } UNION { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SkillProficiencyLevelRequiredConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SkillProficiency> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/SkillProficiency> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A SkillProficiency must carry a ProficiencyLevel (gmeow:skillProficiencyLevel)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/skillProficiencyLevel> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SkillProficiencyOfRequiredConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SkillProficiency> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/SkillProficiency> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A SkillProficiency must reference a Skill (gmeow:skillProficiencyOf)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/skillProficiencyOf> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SkillProficiencyScaleMatchConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SkillProficiency> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/SkillProficiency> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "The skillProficiencyLevel's levelScale should match the relator's skillProficiencyScale." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/skillProficiencyLevel> ?level . ?level <https://blackcatinformatics.ca/gmeow/levelScale> ?expected . $this <https://blackcatinformatics.ca/gmeow/skillProficiencyScale> ?scale . FILTER ( ?scale != ?expected ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SourceDigestMatchConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SourceDigestMatchShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/EmbeddingProjection> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A projection's recorded source digest (gmeow:projectionSourceDigest) must equal the resolved source's gmeow:contentDigest — the projection was built over different bytes than its source now carries." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/projectionSourceDigest> ?d1 . $this <https://blackcatinformatics.ca/gmeow/projectionSource> ?src . ?src <https://blackcatinformatics.ca/gmeow/contentDigest> ?d2 . FILTER ( ?d1 != ?d2 ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SpanEndAfterStartConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SpanSanityShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/spanStart> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A span's end offset must be greater than its start (spanEnd exclusive > spanStart inclusive)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/spanStart> ?s . $this <https://blackcatinformatics.ca/gmeow/spanEnd> ?e . FILTER ( ?e <= ?s ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SpatialAggregationResultTypeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SpatialAggregationShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/SpatialAggregation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A SpatialAggregation result must be a math:Quantity or a gmeow:MonetaryAmount." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/observationResult> ?v . FILTER NOT EXISTS { { ?v a <https://blackcatinformatics.ca/math/Quantity> . } UNION { ?v a <https://blackcatinformatics.ca/gmeow/MonetaryAmount> . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SplitSpinOffEventConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Event> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Event> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A split or spin-off event should have at least 1 predecessor organization and at least 2 successor organizations." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/eventType> ?et . FILTER ( ?et IN (<https://blackcatinformatics.ca/gmeow/eventTypeSplit>, <https://blackcatinformatics.ca/gmeow/eventTypeSpinOff>) ) FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/predecessorOrganization> ?p . $this <https://blackcatinformatics.ca/gmeow/successorOrganization> ?s1 . $this <https://blackcatinformatics.ca/gmeow/successorOrganization> ?s2 . FILTER ( ?s1 != ?s2 ) } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/StaleSourceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StaleSourceShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/groundedIn> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "This claim's source was modified after the claim was asserted — the evidence may have drifted; re-verify (stale-source-claims.rq)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/groundedIn> ?span . $this <https://blackcatinformatics.ca/gmeow/assertedAt> ?assertedAt . ?span <https://blackcatinformatics.ca/gmeow/spanOfChunk> ?chunk . ?chunk <https://blackcatinformatics.ca/gmeow/chunkOf> ?source . ?source <https://blackcatinformatics.ca/gmeow/sourceModifiedAt> ?srcMod . FILTER ( ?srcMod > ?assertedAt ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/StandpointCredenceLowerBoundConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StandpointCredenceRangeShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/standpointCredence> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "gmeow:standpointCredence must be an xsd:decimal in [0.0, 1.0] — a credence value outside this range is malformed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/standpointCredence> ?v . FILTER ( ?v < '0.0'^^<http://www.w3.org/2001/XMLSchema#decimal> ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/StandpointCredenceUpperBoundConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StandpointCredenceRangeShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/standpointCredence> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "gmeow:standpointCredence must be an xsd:decimal in [0.0, 1.0] — a credence value outside this range is malformed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/standpointCredence> ?v . FILTER ( ?v > '1.0'^^<http://www.w3.org/2001/XMLSchema#decimal> ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/StyleGuideForConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StyleGuide> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StyleGuideShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/StyleGuide> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A StyleGuide must voice at least one gmeow:styleGuideFor target (a Persona or a Register) — a style guide for nothing is just a document." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/styleGuideFor> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/StyleGuideVoiceDigestConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StyleGuide> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StyleGuideShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/StyleGuide> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Every gmeow:voiceExemplifiedBy document must carry a gmeow:contentDigest (byte-perfect voice doctrine)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/voiceExemplifiedBy> ?doc . FILTER NOT EXISTS { ?doc <https://blackcatinformatics.ca/gmeow/contentDigest> ?dig . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SupersededEntitySuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SupersededEntitySuppressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Entity> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A superseded entity (one with gmeow:supersededBy) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/supersededBy> ?s . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SupersededGenderIdentitySuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SupersededFacetSuppressionShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/validUntil> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A superseded identity facet (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/validUntil> ?u . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SupersededNameSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DeadnameSuppressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/PersonName> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A superseded name or deadname should set gmeow:displayable false." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/namePurpose> ?p . FILTER ( ( ?p = <https://blackcatinformatics.ca/gmeow/namePurposeDeadname> ) || ( ?p = <https://blackcatinformatics.ca/gmeow/namePurposeSuperseded> ) ) FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SupersededObservationSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SupersededObservationSuppressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Observation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A superseded observation (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/validUntil> ?u . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SupersededParticipationSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/CorrectedEventSuppressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Participation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A superseded participation (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/validUntil> ?u . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SupersededPlaceSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Place> ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SupersededPlaceSuppressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Place> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A superseded place (one with gmeow:placeSupersededBy) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/placeSupersededBy> ?s . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SupportNotSelfConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Support> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Support> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Support must not support itself (gmeow:supportSource = gmeow:supportTarget) — support is irreflexive." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/supportSource> ?a . $this <https://blackcatinformatics.ca/gmeow/supportTarget> ?b . FILTER ( ?a = ?b ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/TargetExactIdentityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/TargetExactIdentityShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/VectorTarget> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A vector target must carry an exact identity — a gmeow:targetsResource or a gmeow:contentDigest — not just a non-identifying gmeow:targetOrdinal." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/targetsResource> ?r . } UNION { $this <https://blackcatinformatics.ca/gmeow/contentDigest> ?d . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/TeachingSelfTeachConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Teaching> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Teaching> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:Teaching relation's gmeow:teacher and gmeow:learner must differ; a self-teaching relation is ill-formed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/teacher> ?a . $this <https://blackcatinformatics.ca/gmeow/learner> ?b . FILTER ( ?a = ?b ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/TemporalMeasurementDateOrAgeConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/TemporalMeasurementShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/TemporalMeasurement> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A TemporalMeasurement must have either gmeow:measuredAge or gmeow:measuredDate (or both)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/measuredAge> ?v0 . } UNION { $this <https://blackcatinformatics.ca/gmeow/measuredDate> ?v1 . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/TopologyClaimStatusConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/TopologyClaim> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/gmeow/TopologyClaimMissingStatus> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/TopologyClaim> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:TopologyClaim must carry an attributed status through gmeow:vantage (the standpoint or agent the feature is claimed from); an unattributed topology claim is an anonymous assertion (gmeow:TopologyClaimMissingStatus)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/vantage> ?v . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/TrademarkMarkConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Trademark> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Trademark> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A Trademark must be about exactly one mark (gmeow:trademarkMark)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/trademarkMark> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/TransactionPartiesConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/TransactionHasPartiesShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/FinancialTransaction> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A FinancialTransaction must have at least one participant (gmeow:hasParticipant or a gmeow:Participation relator)." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/hasParticipant> ?p . } UNION { ?q <https://blackcatinformatics.ca/gmeow/participationEvent> $this . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/UnitBearingQuantityValueConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/MeasuredQuantityShape> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Quantity> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A unit-bearing math:Quantity must carry a numeric magnitude through math:quantityValue; a unit without a value is incomplete." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/unit> ?t . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/quantityValue> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/UsesScaleFunctionalConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/UsesScaleTargetShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/usesScale> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A holder binds at most one gmeow:usesScale, a ScoreScale — two scales make anchor containment and score interpretation ambiguous (closed-world functional)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/usesScale> ?a . $this <https://blackcatinformatics.ca/gmeow/usesScale> ?b . FILTER ( ?a != ?b ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/WithMetricAgreementConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/WithMetricAgreementShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/overVectorSpace> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A similarity observation's gmeow:withMetric must equal its gmeow:overVectorSpace's gmeow:distanceMetric — a disagreeing metric is a hard fail." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/overVectorSpace> ?vsc . $this <https://blackcatinformatics.ca/gmeow/withMetric> ?m . ?vsc <https://blackcatinformatics.ca/gmeow/distanceMetric> ?sm . FILTER ( ?m != ?sm ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/WithdrawnDoxasticTenureSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/DoxasticTenure> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/DoxasticTenure> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A withdrawn belief (a DoxasticTenure whose interval has ended) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/duringInterval> ?iv . ?iv <https://blackcatinformatics.ca/gmeow/endedAtTime> ?end . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/WithdrawnMessageParticipantSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SuppressedMessageParticipantShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/MessageParticipant> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A withdrawn or superseded MessageParticipant (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/validUntil> ?u . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/WithdrawnStandpointSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/WithdrawnStandpointSuppressionShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/StandpointTenure> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A withdrawn standpoint (a StandpointTenure whose interval has ended) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/duringInterval> ?iv . ?iv <https://blackcatinformatics.ca/gmeow/endedAtTime> ?end . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/AmbiguousDenotationRoutingConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/AmbiguityRoutingShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/UnroutedAmbiguousDenotation> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Denotation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "The denoted form's head lexeme has more than one sense but the denotation omits lang:viaSense." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/denotedForm> ?f . ?f <https://blackcatinformatics.ca/lang/lexemeOf> ?lex . ?s1 <https://blackcatinformatics.ca/lang/senseOf> ?lex . ?s2 <https://blackcatinformatics.ca/lang/senseOf> ?lex . FILTER ( ?s1 != ?s2 ) FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/lang/viaSense> ?vs . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/ConfidenceModelConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/ConfidenceNotProbabilityShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/ConfidenceAsProbability> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/lang/aboutReading> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A reading claim carries a logic:probability with no declared logic:probabilityModel." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/aboutReading> ?r . $this <https://blackcatinformatics.ca/logic/probability> ?p . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/probabilityModel> ?m . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/DenotationKindMatchConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/DenotationKindMatchShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/DenotationKindMismatch> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Denotation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A denotation kind does not match its target's type." ;
        sh:select """SELECT $this WHERE { { $this <https://blackcatinformatics.ca/lang/denotationTarget> ?t . $this <https://blackcatinformatics.ca/lang/denotationKind> <https://blackcatinformatics.ca/lang/denotesLogicFormula> . FILTER NOT EXISTS { ?t a <https://blackcatinformatics.ca/logic/Formula> . } } UNION { $this <https://blackcatinformatics.ca/lang/denotationTarget> ?t . $this <https://blackcatinformatics.ca/lang/denotationKind> <https://blackcatinformatics.ca/lang/denotesLogicType> . FILTER NOT EXISTS { ?t a <https://blackcatinformatics.ca/logic/Type> . } } UNION { $this <https://blackcatinformatics.ca/lang/denotationTarget> ?t . $this <https://blackcatinformatics.ca/lang/denotationKind> <https://blackcatinformatics.ca/lang/denotesLogicTerm> . FILTER NOT EXISTS { ?t a <https://blackcatinformatics.ca/logic/Individual> . } } UNION { $this <https://blackcatinformatics.ca/lang/denotationTarget> ?t . $this <https://blackcatinformatics.ca/lang/denotationKind> <https://blackcatinformatics.ca/lang/denotesClass> . FILTER NOT EXISTS { ?t a <http://www.w3.org/2002/07/owl#Class> . } } UNION { $this <https://blackcatinformatics.ca/lang/denotationTarget> ?t . $this <https://blackcatinformatics.ca/lang/denotationKind> <https://blackcatinformatics.ca/lang/denotesByDescription> . FILTER NOT EXISTS { ?t a <https://blackcatinformatics.ca/lang/Intension> . } } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/DenotationNonSurfaceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/DenotationNonSurfaceShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/SurfaceLevelDenotation> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Denotation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:Denotation attaches to a lang:SurfaceForm; meaning attaches above the byte level." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/denotedForm> ?f . ?f a <https://blackcatinformatics.ca/lang/SurfaceForm> . }""" ;
    ] .

<https://blackcatinformatics.ca/lang/DependencyLeavesAnalysisConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/DependencyIntegrityShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/DanglingDependency> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/FormSlot> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A dependency head reference leaves its analysis or forms a cycle." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/dependsOn> ?h . $this <https://blackcatinformatics.ca/lang/inAnalysis> ?a . FILTER NOT EXISTS { ?h <https://blackcatinformatics.ca/lang/inAnalysis> ?a . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FeatureValueDispositionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnLangCoverageShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/GmnUndispositionedTerm> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/FeatureValue> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:FeatureValue must be the lang:denotationTarget of some lang:Denotation; an undispositioned feature value is ill-formed." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { ?s a <https://blackcatinformatics.ca/lang/Denotation> . ?s <https://blackcatinformatics.ca/lang/denotationTarget> $this . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FlagshipScenarioFailureClassConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/FlagshipScenarioShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/UnwiredFlagshipScenario> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/FlagshipScenario> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:FlagshipScenario's gmeow:enforcesFailureClass must transitively rdfs:subClassOf lang:LangConformanceFailure; a scenario that enforces a non-failure class is ill-formed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/enforcesFailureClass> ?failure . FILTER ( STRSTARTS(STR(?failure), 'https://blackcatinformatics.ca/lang/') ) FILTER NOT EXISTS { ?failure <http://www.w3.org/2000/01/rdf-schema#subClassOf>+ <https://blackcatinformatics.ca/lang/LangConformanceFailure> . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FormHeadNodeKindConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/FormHeadStructuralShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/StringOnlyForm> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/lang/formHead> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:formHead value must be a resource (a blank node or IRI), never a literal." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/formHead> ?g . $this <https://blackcatinformatics.ca/lang/formHead> ?v . FILTER ( !( isIRI(?v) || isBlank(?v) ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FormSlotAcyclicDependencyConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/DependencyIntegrityShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/DanglingDependency> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/FormSlot> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:FormSlot may not depend on itself transitively along lang:dependsOn; a dependency cycle is ill-formed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/dependsOn>+ $this . }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FormSlotIndexUniquenessConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/SlotIndexUniqueShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/DuplicateSlotIndex> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/ComposedForm> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "No two distinct lang:formSlot cells of one lang:ComposedForm may share the same lang:slotIndex." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/formSlot> ?s1 . $this <https://blackcatinformatics.ca/lang/formSlot> ?s2 . ?s1 <https://blackcatinformatics.ca/lang/slotIndex> ?i . ?s2 <https://blackcatinformatics.ca/lang/slotIndex> ?i . FILTER ( ?s1 != ?s2 ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FregeDisjointDenotationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/FregeDisjointShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/FregeConflation> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Denotation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A node is typed as two corners of the Frege triangle (form/sense/denotation)." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/lang/Form> . }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FregeDisjointSenseConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/FregeDisjointShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/FregeConflation> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Sense> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A node is typed as two corners of the Frege triangle (form/sense/denotation)." ;
        sh:select """SELECT $this WHERE { { $this a <https://blackcatinformatics.ca/lang/Form> . } UNION { $this a <https://blackcatinformatics.ca/lang/Denotation> . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnCodepointCanonicalConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnCodepointCanonicalShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/GmnNonCanonicalCodepoint> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:gmnCodepoints value must be canonical: space-separated U+XXXX groups of 4-6 uppercase hex digits." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?g . $this <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?v . FILTER ( !REGEX(STR(?v), '^U\\\\+[0-9A-F]{4,6}( U\\\\+[0-9A-F]{4,6})*$') ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnCompactionOverclaimConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnCompactionOverclaimShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/GmnCompactionOverclaim> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/GmnCompaction> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnCompaction links a logic:Correspondence claiming mnemomorphic recoverability, exact preservation, or soundness under approximation; compaction is validation-only." ;
        sh:select """SELECT $this WHERE { $this ?link ?c . ?c a <https://blackcatinformatics.ca/logic/Correspondence> . { ?c <https://blackcatinformatics.ca/logic/mnemomorphic> 'true'^^<http://www.w3.org/2001/XMLSchema#boolean> . } UNION { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/ExactPreservation> . } UNION { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/SoundUnderApproximation> . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnConfusableGlyphConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnConfusableGlyphShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/GmnConfusableGlyph> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/gmnConfusableWith> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Two distinct graphemes of the GMN script are a declared gmeow:gmnConfusableWith pair; the orthography's confusables blocklist forbids co-resident confusables." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/gmnConfusableWith> ?g2 . $this <https://blackcatinformatics.ca/lang/inScript> <https://blackcatinformatics.ca/gmeow/gmnScript> . ?g2 <https://blackcatinformatics.ca/lang/inScript> <https://blackcatinformatics.ca/gmeow/gmnScript> . FILTER ( $this != ?g2 ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnDictionaryAliasInjectivityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnDictionaryAliasInjectivityShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/GmnDictionaryAliasCollision> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/GmnDictionary> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Two entries of one GMN dictionary alias different terms with the same alias string; the alias table is not injective." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntry> ?entry1 . $this <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntry> ?entry2 . ?entry1 <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntryAlias> ?alias . ?entry2 <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntryAlias> ?alias . ?entry1 <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntryTerm> ?term1 . ?entry2 <https://blackcatinformatics.ca/gmeow/gmnDictionaryEntryTerm> ?term2 . FILTER ( ?term1 != ?term2 ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnExportRingBindingConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnExportRingBindingShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/GmnUnringedExportCrossing> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/GmnEnvelope> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A GMN envelope generated by an export activity declares no security ring." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/wasGeneratedBy> ?activity . ?activity <https://blackcatinformatics.ca/gmeow/mentalProcessType> <https://blackcatinformatics.ca/gmeow/processExport> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/gmnSecurityRing> ?ring . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnGlyphCollisionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnGlyphCollisionShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/GmnGlyphCollision> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Two distinct graphemes of one script share an identical gmeow:gmnCodepoints value without both carrying a gmeow:gmnSigilScope; unscoped glyph collisions are forbidden." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?cp . $this <https://blackcatinformatics.ca/lang/inScript> ?s . ?g2 <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?cp . ?g2 <https://blackcatinformatics.ca/lang/inScript> ?s . FILTER ( $this != ?g2 ) FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/gmnSigilScope> ?sc1 . ?g2 <https://blackcatinformatics.ca/gmeow/gmnSigilScope> ?sc2 . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnScriptCodepointPresenceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnScriptCodepointPresenceShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/GmnNonCanonicalCodepoint> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Grapheme> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A grapheme in the GMN script's repertoire carries no gmeow:gmnCodepoints spelling; the GMN glyph table is codepoint-explicit." ;
        sh:select """SELECT $this WHERE { <https://blackcatinformatics.ca/gmeow/gmnScript> <https://blackcatinformatics.ca/lang/hasGrapheme> $this . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?cp . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnScriptGlyphCoverageConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnScriptGlyphCoverageShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/GmnUncostedScriptGlyph> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Grapheme> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:Grapheme in the GMN script carries no gmeow:gmnGlyphTokenCost; the GMN glyph inventory is cost-covered by rule, so every admitted glyph carries its measured token-cost feed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/inScript> <https://blackcatinformatics.ca/gmeow/gmnScript> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/gmnGlyphTokenCost> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnVersionOverclaimConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnVersionOverclaimShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/GmnVersionOverclaim> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/gmnMigratesTo> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A GMN migration claims logic:mnemomorphic true over a stronger-than-additive version bump; the version machinery never claims more than its lineage discharges." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/gmnMigratesTo> ?vg . $this <https://blackcatinformatics.ca/gmeow/gmnMigratesTo> ?v . $this <https://blackcatinformatics.ca/lang/translationCorrespondence> ?c . ?c <https://blackcatinformatics.ca/logic/mnemomorphic> 'true'^^<http://www.w3.org/2001/XMLSchema#boolean> . ?m <https://blackcatinformatics.ca/gmeow/versionMember> ?v . ?m <https://blackcatinformatics.ca/gmeow/versionScale> ?sc . FILTER ( ?sc != <https://blackcatinformatics.ca/gmeow/scaleMinor> ) FILTER ( ?sc != <https://blackcatinformatics.ca/gmeow/scaleTrivial> ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GraphemeRepertoireConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GraphemeGroundedShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/UngroundedGrapheme> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Grapheme> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A grapheme is not in the repertoire of the script it declares." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/inScript> ?s . FILTER NOT EXISTS { ?s <https://blackcatinformatics.ca/lang/hasGrapheme> $this . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/IndexicalAnchoredConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/IndexicalAnchoredShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/UnanchoredIndexical> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Denotation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An indexical denotation's interpretation act names no lang:IndexicalAnchor." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/isIndexical> 'true'^^<http://www.w3.org/2001/XMLSchema#boolean> . ?r <https://blackcatinformatics.ca/lang/denotation> $this . ?act <https://blackcatinformatics.ca/lang/producedReading> ?r . FILTER NOT EXISTS { ?act <https://blackcatinformatics.ca/lang/anchorsIndexical> ?an . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/MachineTranslationProvenanceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/TranslationAttributionShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/UnattributedTranslation> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/TranslationUnit> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A machine translation (lang:methodMachine) names no gmeow:wasGeneratedBy activity that produced it." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/translationMethod> <https://blackcatinformatics.ca/lang/methodMachine> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/wasGeneratedBy> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/ReadingClaimVantageConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/ReadingClaimGroundedShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/UngroundedReadingClaim> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/lang/aboutReading> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A reading-correctness claim (a gmeow:Observation about a lang:Reading) must name its gmeow:vantage; an ungrounded reading claim is ill-formed (lang:UngroundedReadingClaim)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/aboutReading> ?t . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/vantage> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/RealizesNodeKindConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/RealizesStructuralShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/StringOnlyForm> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/lang/realizes> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:realizes value must be a resource (a blank node or IRI), never a literal." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/realizes> ?g . $this <https://blackcatinformatics.ca/lang/realizes> ?v . FILTER ( !( isIRI(?v) || isBlank(?v) ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/RenderingNotIdentityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/RenderingNotIdentityShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/RenderingAsIdentity> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Rendering> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:Rendering is its own lang:renderedContent; a self-identical rendering is a crossing that never happened." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/renderedContent> $this . }""" ;
    ] .

<https://blackcatinformatics.ca/lang/SlotContiguityConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/SlotContiguityShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/NonContiguousSlots> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/ComposedForm> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A composed form's slot indexes are not zero-based and contiguous." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/formSlot> ?slot . ?slot <https://blackcatinformatics.ca/lang/slotIndex> ?index . FILTER NOT EXISTS { { FILTER ( ?index = '0'^^<http://www.w3.org/2001/XMLSchema#integer> ) } UNION { $this <https://blackcatinformatics.ca/lang/formSlot> ?previousSlot . ?previousSlot <https://blackcatinformatics.ca/lang/slotIndex> ?previousIndex . BIND ( ( ?previousIndex + '1'^^<http://www.w3.org/2001/XMLSchema#integer> ) AS ?successorIndex ) FILTER ( ?successorIndex = ?index ) } } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/SlotFormNodeKindConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/SlotFormStructuralShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/StringOnlyForm> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/lang/slotForm> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:slotForm value must be a resource (a blank node or IRI), never a literal." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/slotForm> ?g . $this <https://blackcatinformatics.ca/lang/slotForm> ?v . FILTER ( !( isIRI(?v) || isBlank(?v) ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/SurfaceAnalysisStructureConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/SurfaceAnalysisShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/MisdeclaredAnalysis> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/SurfaceForm> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceForm's structure must match its declared analysis level (parsed realizes a composed form; raw is unanalyzed prose; never both)." ;
        sh:select """SELECT $this WHERE { { $this <https://blackcatinformatics.ca/lang/analysisLevel> <https://blackcatinformatics.ca/lang/parsedLevel> . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/lang/realizes> ?f . ?f a <https://blackcatinformatics.ca/lang/ComposedForm> . } } UNION { $this <https://blackcatinformatics.ca/lang/analysisLevel> <https://blackcatinformatics.ca/lang/rawLevel> . FILTER NOT EXISTS { $this a <https://blackcatinformatics.ca/lang/UnanalyzedProse> . } } UNION { $this <https://blackcatinformatics.ca/lang/realizes> ?g . $this a <https://blackcatinformatics.ca/lang/UnanalyzedProse> . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/SurfaceMaterialChoiceConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/SurfaceMaterialShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/UnhashableSurface> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/SurfaceForm> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:SurfaceForm must carry its bytes inline through lang:surfaceText or by reference through lang:surfaceBlob." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/lang/surfaceBlob> ?v0 . } UNION { $this <https://blackcatinformatics.ca/lang/surfaceText> ?v1 . } } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/UnmarkedSourceOverclaimConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/UnmarkedSurfaceTranslationShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/UnmarkedSurfaceTranslation> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/TranslationUnit> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A surface-only translation source realizes no analyzed form yet carries a stronger-than-weakest preservation judgment on its logic:Correspondence." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/translationSource> ?s . ?s a <https://blackcatinformatics.ca/lang/SurfaceForm> . $this <https://blackcatinformatics.ca/lang/translationCorrespondence> ?c . FILTER NOT EXISTS { ?s <https://blackcatinformatics.ca/lang/realizes> ?rf . } FILTER NOT EXISTS { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/Unsupported> . } FILTER NOT EXISTS { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/ValidationOnly> . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/UnmarkedSourceProseConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/UnmarkedSurfaceTranslationShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/UnmarkedSurfaceTranslation> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/TranslationUnit> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A surface-only translation source realizes no analyzed form yet is not typed lang:UnanalyzedProse." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/translationSource> ?s . ?s a <https://blackcatinformatics.ca/lang/SurfaceForm> . FILTER NOT EXISTS { ?s <https://blackcatinformatics.ca/lang/realizes> ?rf . } FILTER NOT EXISTS { ?s a <https://blackcatinformatics.ca/lang/UnanalyzedProse> . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/UnmarkedTargetOverclaimConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/UnmarkedSurfaceTranslationShape> ;
    gmeow:enforcesFailureClass <https://blackcatinformatics.ca/lang/UnmarkedSurfaceTranslation> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/TranslationUnit> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A surface-only translation target realizes no analyzed form yet carries a stronger-than-weakest preservation judgment on its logic:Correspondence." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/translationTarget> ?t . ?t a <https://blackcatinformatics.ca/lang/SurfaceForm> . $this <https://blackcatinformatics.ca/lang/translationCorrespondence> ?c . FILTER NOT EXISTS { ?t <https://blackcatinformatics.ca/lang/realizes> ?rf . } FILTER NOT EXISTS { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/Unsupported> . } FILTER NOT EXISTS { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/ValidationOnly> . } }""" ;
    ] .

