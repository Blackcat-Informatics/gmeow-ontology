# --- Composition-level individuals ------------------------------------------ #

lang:morphWordLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "morphological word"@x-gmeow-english ;
    skos:definition "The composition level of a morphologically complex word built from morphs."@x-gmeow-english .

lang:phraseLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "phrase"@x-gmeow-english ;
    skos:definition "The composition level of a phrase — a sub-clausal constituent."@x-gmeow-english .

lang:clauseLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "clause"@x-gmeow-english ;
    skos:definition "The composition level of a clause."@x-gmeow-english .

lang:sentenceLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "sentence"@x-gmeow-english ;
    skos:definition "The composition level of a sentence."@x-gmeow-english .

lang:paragraphLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "paragraph"@x-gmeow-english ;
    skos:definition "The composition level of a paragraph."@x-gmeow-english .

lang:sectionLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "section"@x-gmeow-english ;
    skos:definition "The composition level of a section of a document."@x-gmeow-english .

lang:textLevel
    a owl:NamedIndividual , lang:CompositionLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "text"@x-gmeow-english ;
    skos:definition "The composition level of a whole text or document."@x-gmeow-english .

# --- Analysis-level individuals (ordered by lang:levelRank) ------------------ #

lang:rawLevel
    a owl:NamedIndividual , lang:AnalysisLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "raw"@x-gmeow-english ;
    skos:definition "The raw analysis level: a surface held as unanalyzed prose, with no segmentation. The level of a lang:UnanalyzedProse surface."@x-gmeow-english ;
    lang:levelRank 0 .

lang:segmentedLevel
    a owl:NamedIndividual , lang:AnalysisLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "segmented"@x-gmeow-english ;
    skos:definition "The segmented analysis level: a surface split into segments (graphemes or phones) but not yet tokenized."@x-gmeow-english ;
    lang:levelRank 1 .

lang:tokenizedLevel
    a owl:NamedIndividual , lang:AnalysisLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "tokenized"@x-gmeow-english ;
    skos:definition "The tokenized analysis level: a surface split into orthographic and syntactic words but not yet morphologically analyzed."@x-gmeow-english ;
    lang:levelRank 2 .

lang:morphAnalyzedLevel
    a owl:NamedIndividual , lang:AnalysisLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "morph-analyzed"@x-gmeow-english ;
    skos:definition "The morph-analyzed level: word forms resolved to lexemes with typed morphological features, but not yet parsed into a composed form."@x-gmeow-english ;
    lang:levelRank 3 .

lang:parsedLevel
    a owl:NamedIndividual , lang:AnalysisLevel ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "parsed"@x-gmeow-english ;
    skos:definition "The parsed level: a surface realizing a lang:ComposedForm with a full constituency and dependency analysis. The highest form-layer level; denotation is above it, in the meaning layer."@x-gmeow-english ;
    lang:levelRank 4 .

# --- Offset-space individuals ----------------------------------------------- #

lang:byteOffset
    a owl:NamedIndividual , lang:OffsetSpace ;
