    rdfs:label "GMN candidate: morpheme-boundary hyphen"@x-gmeow-english ;
    skos:definition "The audited safety ruling that keeps the conventional morpheme-boundary hyphen as display notation and uses the executable `mb` key."@x-gmeow-english ;
