@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix ical:   <http://www.w3.org/2002/12/cal/icaltzd#> .
@prefix wd:     <http://www.wikidata.org/entity/> .
@prefix wdt:    <http://www.wikidata.org/prop/direct/> .

# Term equivalences for the calendar and scheduling slice (calendar and scheduling design).
# Compiled to mappings/gmeow-calendar.sssom.tsv by `gmeow compile-mappings`.

# --------------------------------------------------------------------------- #
# Mapping set metadata
# --------------------------------------------------------------------------- #

gmeow:mapsetCalendar a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/calendar" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Calendar and scheduling alignments (calendar and scheduling design) — gmeow:Calendar, gmeow:EventSchedule, gmeow:EventInvitation, gmeow:Availability, gmeow:Reminder, gmeow:Task, gmeow:TimeZone and their value vocabularies, aligned to iCalendar (RFC 5545/5546), schema.org Schedule/EventSeries, and Wikidata by reference.
        VALUE VOCABULARIES: InvitationStatus, RsvpStatus, AvailabilityStatus, ReminderAction, TaskStatus, ExceptionType are gufo:QualityValue individuals, aligned to external classes/enums with skos:closeMatch (Principle 9 — no overtyping).
        SCHEDULE ≠ OCCURRENCE: an EventSchedule generates Event occurrences; it is not the occurrence itself.""" .

# --------------------------------------------------------------------------- #
# Core classes
# --------------------------------------------------------------------------- #

gmeow:Calendar skos:relatedMatch ical:Vcalendar {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "iCalendar VCALENDAR is a projection target, not a peer model"
|} .

gmeow:EventSchedule skos:closeMatch schema:Schedule {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema.org Schedule — a repeating schedule with exceptions"
|} .

gmeow:EventSchedule skos:relatedMatch ical:Vevent {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "iCalendar VEVENT is the projection of a generated occurrence, not the schedule itself"
|} .

gmeow:Task skos:closeMatch ical:Vtodo {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "iCalendar VTODO — a task is an event subtype with due date and status"
|} .

gmeow:Reminder skos:closeMatch ical:Valarm {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "iCalendar VALARM — trigger + action"
|} .

gmeow:TimeZone skos:closeMatch ical:Vtimezone {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "iCalendar VTIMEZONE — IANA tzid"
|} .

gmeow:Availability skos:closeMatch ical:Vfreebusy {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "iCalendar VFREEBUSY — free/busy time slots"
|} .

gmeow:EventInvitation skos:relatedMatch schema:RsvpAction {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "schema.org RsvpAction — the invitation/RSVP social act"
|} .

# --------------------------------------------------------------------------- #
# Structural properties
# --------------------------------------------------------------------------- #

gmeow:scheduleRecurrenceRule skos:closeMatch schema:repeatFrequency {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "schema.org repeatFrequency — a textual recurrence rule"
|} .

gmeow:scheduleOccurrence skos:closeMatch schema:subEvent {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "a generated occurrence is a sub-event of the schedule's series"
|} .

gmeow:taskDueDate skos:closeMatch ical:due {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:reminderTrigger skos:closeMatch ical:trigger {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:timeZoneIanaId skos:closeMatch ical:tzid {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:availabilityStatus skos:closeMatch ical:fbtype {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "iCalendar FBTYPE — FREE, BUSY, BUSY-TENTATIVE, BUSY-UNAVAILABLE"
|} .

gmeow:invitationStatus skos:closeMatch ical:partstat {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "iCalendar PARTSTAT — NEEDS-ACTION, ACCEPTED, DECLINED, TENTATIVE"
|} .

gmeow:taskPriority skos:closeMatch ical:priority {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:reminderAction skos:closeMatch ical:action {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "iCalendar ACTION — display, email, audio"
|} .

gmeow:taskStatus skos:closeMatch ical:status {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "iCalendar STATUS for VTODO — COMPLETED, CANCELLED, etc."
|} .

gmeow:scheduleRecurrenceRule skos:closeMatch ical:rrule {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "the recurrence rule text projects directly to RRULE"
|} .

# --------------------------------------------------------------------------- #
# Value vocabulary individuals
# --------------------------------------------------------------------------- #

gmeow:invitationStatusAccepted skos:closeMatch wd:Q2498022 {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'acceptance' (Q2498022)"
|} .

gmeow:taskStatusCompleted skos:closeMatch wd:Q1198487 {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'completion' (Q1198487)"
|} .

gmeow:reminderActionDisplay skos:closeMatch wd:Q548665 {|
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Wikidata 'display device' (Q548665) — rough alignment"
|} .
