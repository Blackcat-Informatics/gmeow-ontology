logic:and [ a logic:Formula ;
logic:or [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "retainedScore" ] ;
logic:exists [ a logic:Formula ;
logic:relation gmeow:rerankScore ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "retainedScore" ] ] ],
[ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "retainedDetail" ] ;
logic:exists [ a logic:Formula ;
logic:relation gmeow:rerankUnscoredDetail ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "retainedDetail" ] ] ] ],
[ a logic:Formula ;
logic:not [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "conflictingScore" ], [ logic:termIndex 1 ; logic:termVariable "conflictingDetail" ] ;
logic:exists [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation gmeow:rerankScore ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "conflictingScore" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankUnscoredDetail ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "conflictingDetail" ] ] ] ] ],
[ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:relation gmeow:rerankScore ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "score" ] ] ;
logic:consequent [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "winningPassage" ] ;
logic:exists [ a logic:Formula ;
logic:relation gmeow:rerankWinningPassage ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "winningPassage" ] ] ] ],
[ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:relation gmeow:rerankWinningPassage ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "passage" ] ] ;
logic:consequent [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "passageScore" ] ;
logic:exists [ a logic:Formula ;
logic:relation gmeow:rerankScore ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "passageScore" ] ] ] ] ] ] ] .

gmeow:QueryRerankAuthorityRequiredLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank authority required law"@x-gmeow-english ;
    skos:definition "A rerank answer retaining any scored entry must retain a supplied source authority record. No authority is manufactured for an all-unscored answer."@x-gmeow-english ;
    gmeow:useWhen "Use to reject scored results whose answer-level source scoring context is absent."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting a present authority as proof that any candidate was scored or forbidding a supplied authority on an all-unscored result."@x-gmeow-english ;
    gmeow:howToUse "Bind the answer, its entry and that entry’s score; require an existing QueryRerankAuthority linked through rerankAuthority."@x-gmeow-english ;
    skos:scopeNote "The answer permits at most one authority. Its agreement with each score’s own authority is a separate law, and the score retains its existing quantitative context requirements."@x-gmeow-english ;
    skos:example "Scored answer context: ex:answer gmeow:rerankEntry ex:e ; gmeow:rerankAuthority ex:authority . ex:e gmeow:rerankScore ex:score ."@x-gmeow-english ;
    logic:formalizes gmeow:rerankAuthority ;
    logic:message "A rerank answer retaining any scored entry must retain a supplied source authority record. No authority is manufactured for an all-unscored answer." ;
    logic:integrity [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "entry" ], [ logic:termIndex 2 ; logic:termVariable "score" ] ;
logic:forall [ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryRerankAnswer ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankEntry ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "entry" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankScore ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "entry" ], [ logic:termIndex 1 ; logic:termVariable "score" ] ] ] ;
logic:consequent [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "authority" ] ;
logic:exists [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "authority" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryRerankAuthority ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankAuthority ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "authority" ] ] ] ] ] ] .

gmeow:QueryRerankAuthorityAgreementLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank authority agreement law"@x-gmeow-english ;
    skos:definition "Every score retained by a rerank answer references the same actual source authority record as the answer. Equal opaque identity bytes on different records do not satisfy this record-identity obligation."@x-gmeow-english ;
    gmeow:useWhen "Use to reject an answer that mixes scores from another retained authority context."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid comparing authority labels, byte values or frames in place of the authority resource, or repeating the score’s existing finite and quantitative context laws."@x-gmeow-english ;
    gmeow:howToUse "Bind the answer, entry, score, score authority and answer authority, then require logic:termEqual between the two authority resources."@x-gmeow-english ;
    skos:scopeNote "The existing QueryRerankScoreContextLaw handles dimension and frame agreement through the score’s direct authority link. This law adds only answer-to-score authority identity agreement."@x-gmeow-english ;
    skos:example "Matching authority record: ex:answer gmeow:rerankAuthority ex:authority . ex:score gmeow:rerankScoreAuthority ex:authority ."@x-gmeow-english ;
    logic:formalizes gmeow:rerankAuthority ;
    logic:message "Every score retained by a rerank answer references the same actual source authority record as the answer. Equal opaque identity bytes on different records do not satisfy this record-identity obligation." ;
    logic:integrity [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "entry" ], [ logic:termIndex 2 ; logic:termVariable "score" ], [ logic:termIndex 3 ; logic:termVariable "scoreAuthority" ], [ logic:termIndex 4 ; logic:termVariable "answerAuthority" ] ;
logic:forall [ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryRerankAnswer ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankEntry ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "entry" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankScore ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "entry" ], [ logic:termIndex 1 ; logic:termVariable "score" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankScoreAuthority ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "score" ], [ logic:termIndex 1 ; logic:termVariable "scoreAuthority" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankAuthority ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "answerAuthority" ] ] ] ;
logic:consequent [ a logic:Formula ;
logic:relation logic:termEqual ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "scoreAuthority" ], [ logic:termIndex 1 ; logic:termVariable "answerAuthority" ] ] ] ] .

gmeow:QueryRerankReportedOrderLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank reported order law"@x-gmeow-english ;
    skos:definition "Within a rerank answer, every scored occurrence precedes every unscored occurrence, and unscored occurrences retain their relative original union order. Both obligations compare integer sequence positions only."@x-gmeow-english ;
    gmeow:useWhen "Use to check scored-group placement and original order within the unscored tail."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this law validates scored numeric-descending order, equal-score tie order, signed-zero behavior or a provider’s floating-point comparator."@x-gmeow-english ;
    gmeow:howToUse "Use logic:termLess on bound entryOrdinal values for scored versus unscored entries; for two unscored entries, require output order whenever their input positions are ordered."@x-gmeow-english ;
    skos:scopeNote "These are exactly two guarded integer implications. No score magnitude, contiguous-index requirement or comparator implementation is added."@x-gmeow-english ;
    skos:example "Group placement: ex:scored gmeow:entryOrdinal \"0\"^^xsd:nonNegativeInteger . ex:unscored gmeow:entryOrdinal \"1\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    logic:formalizes gmeow:entryOrdinal ;
    logic:message "Within a rerank answer, every scored occurrence precedes every unscored occurrence, and unscored occurrences retain their relative original union order. Both obligations compare integer sequence positions only." ;
    logic:integrity [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "left" ], [ logic:termIndex 2 ; logic:termVariable "right" ], [ logic:termIndex 3 ; logic:termVariable "leftScore" ], [ logic:termIndex 4 ; logic:termVariable "leftDetail" ], [ logic:termIndex 5 ; logic:termVariable "rightDetail" ], [ logic:termIndex 6 ; logic:termVariable "leftInput" ], [ logic:termIndex 7 ; logic:termVariable "rightInput" ], [ logic:termIndex 8 ; logic:termVariable "leftOutput" ], [ logic:termIndex 9 ; logic:termVariable "rightOutput" ] ;
logic:forall [ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryRerankAnswer ] ] ;
logic:consequent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation gmeow:rerankEntry ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "left" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankEntry ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "right" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankScore ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "left" ], [ logic:termIndex 1 ; logic:termVariable "leftScore" ] ],
[ a logic:Formula ;
