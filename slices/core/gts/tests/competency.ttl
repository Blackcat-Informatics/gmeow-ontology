# =========================================================================== #
# 7. Which build stages feed the trainer, and which consumes what it trains?  #
# =========================================================================== #

ex:cqMediumDictionaryStageDataflow a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/gts/queries/competency/medium-dictionary-stage-dataflow.rq" ;
    gmeow:cqRationale "The dictionary stage's upstream edges are DERIVED from the shipped corpora rather than chosen by an author, so this question is how the graph proves the derivation still covers the corpora: the archive-rep selectors need the archive stage's product, the named-graph and generated-path selectors need the assembled carrier and the statement stage, and the sink-folded proof-trace corpus needs the reasoning stage's product directly because its archive does not exist until the terminal. A corpus that reaches for material no declared upstream produces is not a smaller training set — it is a HARD FAIL the build must be able to see, and it can only see it if the edge set is readable. The downstream edge matters just as much and is the reason the trainer is its own stage rather than terminal work: the terminal must READ trained dictionaries to pin them in the segment header's in-band map and to seal one envelope per emitted frame, so a trainer folded into the sink would have had to produce and consume the same product in one node." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:shapeMediumDictionaryStageDataflow ;
    gmeow:cqExpectRow
        ex:rowStage01 ,
        ex:rowStage02 ,
        ex:rowStage03 ,
        ex:rowStage04 ,
        ex:rowStage05 .

ex:shapeMediumDictionaryStageDataflow a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "stage" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "upstream" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowStage01 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "stage" ; gmeow:cellValueIri gmeow:stage-gts-sink ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "upstream" ; gmeow:cellValueIri gmeow:stage-medium-dictionaries ] .
ex:rowStage02 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "stage" ; gmeow:cellValueIri gmeow:stage-medium-dictionaries ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "upstream" ; gmeow:cellValueIri gmeow:stage-archive-blobs ] .
ex:rowStage03 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "stage" ; gmeow:cellValueIri gmeow:stage-medium-dictionaries ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "upstream" ; gmeow:cellValueIri gmeow:stage-reason ] .
ex:rowStage04 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "stage" ; gmeow:cellValueIri gmeow:stage-medium-dictionaries ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "upstream" ; gmeow:cellValueIri gmeow:stage-snapshot ] .
ex:rowStage05 a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "stage" ; gmeow:cellValueIri gmeow:stage-medium-dictionaries ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "upstream" ; gmeow:cellValueIri gmeow:stage-statements ] .
