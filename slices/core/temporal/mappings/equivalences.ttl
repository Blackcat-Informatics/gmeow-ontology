@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmgeo: <http://www.ics.forth.gr/isl/CRMgeo/> .
@prefix edtf: <http://id.loc.gov/datatypes/edtf/> .
@prefix periodo: <http://n2t.net/ark:/99152/> .
@prefix gts: <http://resource.geosciml.org/ontology/timescale/gts#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix ivoa: <http://www.ivoa.net/rdf/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .

# Term equivalences for the expanded temporal kernel — GMEOW authoring source.
# Compiled to mappings/gmeow-temporal.sssom.tsv by `gmeow compile-mappings`.
# Alignments are BY REFERENCE (Principle 5); GMEOW never imports an external axiom.
#
# Design notes:
# * TemporalFrame is the temporal counterpart of gmeow:ReferenceFrame (reference-frame profile / temporal-frame design).
#     It aligns to OWL-Time's TRS, CIDOC-CRM E52, and CRMgeo's spatiotemporal
#     reference system by reference.
#   * ReferenceFrame and hasReferenceFrame also align to OWL-Time TRS/hasTRS
# when the frame's realm is temporal (contextual closeMatch from temporal-frame design).
#   * TimeScale, CalendarSystem, and ReferencePosition are first-class kinds so
#     non-Gregorian calendars and astronomical scales are co-equal with UTC/Gregorian
#     (Principle 9).
#   * EDTF values are plain literals in the GMEOW core; the EDTF Ontology alignment
#     is by reference for consumers that want to project them.
#   * NamedPeriod aligns to OWL-Time ProperInterval, PeriodO, and the ICS geologic
#     timescale ontology.
#   * TemporalMeasurement aligns to CIDOC E16 Measurement and CRMgeo, with dating
#     methods as a value vocabulary.

# REFUSED (Principle 5 — no faithful external term):
#   gmeow:FrameRealm has no direct OWL-Time counterpart; the concept is GMEOW-specific.
# REFUSED (Principle 5):
#   gmeow:FrameKind has no direct OWL-Time counterpart.

gmeow:mapsetTemporal a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/temporal" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Expanded temporal kernel alignments — TemporalFrame / Instant / NamedPeriod / TemporalMeasurement / interval-level Allen JEPD, supersetting OWL-Time, CIDOC-CRM E52/E16, CRMgeo, EDTF Ontology, PeriodO, ICS Geologic Timescale, QUDT, IVOA, and Wikidata BY REFERENCE.
        TEMPORAL FRAME: GMEOW's TemporalFrame is the temporal counterpart of the spatial ReferenceFrame (reference-frame profile), decomposed into TimeScale + optional CalendarSystem + optional ReferencePosition. It aligns to OWL-Time TRS, CIDOC-CRM E52 Time-Span, and CRMgeo spatiotemporal reference systems. Also includes contextual alignments from temporal-frame design: ReferenceFrame↔time:TRS and hasReferenceFrame↔time:hasTRS when frameRealm is temporal.
        INSTANT / EDTF: crisp instantValue is xsd:dateTime; edtfValue is a plain literal (EDTF parsing is solver-layer, P12). Aligned to OWL-Time time:Instant and EDTF Ontology by reference.
        NAMED PERIOD: aligned to OWL-Time time:ProperInterval, PeriodO periods, and ICS geologic timescale concepts. Geologic period seeds carry skos:exactMatch to ICS by reference.
        TEMPORAL MEASUREMENT: aligned to CIDOC-CRM E16 Measurement and CRMgeo; dating methods are a value vocabulary mapped to Wikidata QIDs.
        ALLEN JEPD: interval-level Allen relations are pairwise disjoint; event-level relations are disjoint from interval-level relations. Exhaustiveness lives in the solver layer (P12).
        CO-EQUAL CALENDARS: Gregorian is one peer among Julian, Hebrew, Islamic, Chinese, Persian, Ethiopian, Coptic, and ISO week (Principle 9).""" .

# --------------------------------------------------------------------------- #
# ReferenceFrame contextual alignments (from temporal-frame design — merged during rebase)
# --------------------------------------------------------------------------- #

gmeow:ReferenceFrame skos:closeMatch time:TRS {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "contextual — holds when the ReferenceFrame's frameRealm is gmeow:frameRealmTemporal"
|} .

gmeow:hasReferenceFrame skos:closeMatch time:hasTRS {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "links a temporal position to its calendar/timescale frame"
|} .

# --------------------------------------------------------------------------- #
# TemporalFrame and its components
# --------------------------------------------------------------------------- #

gmeow:TemporalFrame skos:closeMatch time:TemporalReferenceSystem {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OWL-Time Temporal Reference System — GMEOW decomposes it into scale+calendar+position"
|} .

gmeow:TemporalFrame skos:relatedMatch crm:E52_Time-Span {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "CIDOC E52 Time-Span carries the frame implicitly via its time primitives"
|} .

gmeow:TemporalFrame skos:closeMatch crmgeo:SP13_Temporal_Reference_System {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "CRMgeo spatiotemporal reference system (temporal aspect)"
|} .

gmeow:TimeScale skos:closeMatch time:TRS {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OWL-Time Temporal Reference System when scale-only"
|} .

gmeow:CalendarSystem skos:closeMatch time:CalendarSystem {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "OWL-Time CalendarSystem"
|} .

gmeow:ReferencePosition skos:relatedMatch time:TimeZone {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "timezone is one kind of reference position; observatory/planet are others"
|} .

# --------------------------------------------------------------------------- #
# Instant
# --------------------------------------------------------------------------- #

gmeow:Instant skos:closeMatch time:Instant {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:Instant skos:closeMatch crm:E61_Time_Primitive {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "CIDOC time primitive"
|} .

gmeow:instantValue skos:closeMatch time:inXSDDateTimeStamp {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "crisp instant as xsd:dateTime"
|} .

gmeow:edtfValue skos:relatedMatch edtf:EDTF {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "GMEOW stores EDTF as plain literal; the EDTF Ontology treats it as a datatype. Alignment is by reference/convention."
|} .

gmeow:inTemporalFrame skos:closeMatch time:hasTRS {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "links an instant to its temporal reference system/frame"
|} .

# --------------------------------------------------------------------------- #
# NamedPeriod
# --------------------------------------------------------------------------- #

gmeow:NamedPeriod skos:closeMatch time:ProperInterval {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a named period is an interval with extra naming/authority structure"
|} .

gmeow:NamedPeriod skos:closeMatch crm:E4_Period {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "CIDOC E4 Period — culturally-defined temporal extent"
|} .

gmeow:NamedPeriod skos:relatedMatch periodo:Period {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "PeriodO period — a gazetteer entry rather than an ontology class"
|} .

gmeow:periodStart skos:closeMatch time:hasBeginning {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:periodEnd skos:closeMatch time:hasEnd {|
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
