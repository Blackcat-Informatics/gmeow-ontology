# Competency question: "Which properties frame an estimand — what fixes the target quantity a
# study estimates?" Enumerates this fixture's supplied mathematical framing edges,
# including distinct missing-data analysis context and event-specific target strategies.
# These repository roles are not ICH's five-attribute list or universal required fields.
# Record subjects retain the event-strategy associations rather than flattening their
# endpoints. The answer is exactly twelve selected edges; no inference or validation of
# incomplete records is performed.
PREFIX math: <https://blackcatinformatics.ca/math/>
PREFIX ex:   <http://example.org/math/>

SELECT ?subject ?prop ?object WHERE {
    {
        BIND(ex:estimand AS ?subject)
        ?subject ?prop ?object .
        FILTER(STRSTARTS(STR(?prop), "https://blackcatinformatics.ca/math/"))
    }
    UNION
    {
        ex:estimand math:intercurrentEventHandling ?subject .
        VALUES ?prop { math:intercurrentEvent math:intercurrentEventStrategy }
        ?subject ?prop ?object .
    }
}
ORDER BY ?subject ?prop ?object
