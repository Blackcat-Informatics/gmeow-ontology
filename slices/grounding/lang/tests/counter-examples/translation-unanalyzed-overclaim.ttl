# Counter-example (ONE violation): a lang:TranslationUnit whose surfaces ARE typed
# lang:UnanalyzedProse and realize nothing, but whose carried logic:Correspondence claims a
# STRONG preservation (logic:ExactPreservation, not the weakest logic:Unsupported /
# logic:ValidationOnly) → lang:UnmarkedSurfaceTranslation (the sh:sparql constraint of
# lang:UnmarkedSurfaceTranslationShape). This is the fabrication the honest "unanalyzed AND
# weakest-judgment" rule forbids on its SECOND conjunct: an unanalyzed surface may not claim
# an exact crossing. Both surfaces are lang:rawLevel UnanalyzedProse with full material
# identity, and the method is present, so no cardinality / surface-analysis / material finding
# fires — ONLY the SPARQL finding.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:french a lang:SignSystem .
ex:latin a lang:Script .

# Both surfaces ARE unanalyzed prose and realize nothing — the first conjunct holds.
ex:src a lang:SurfaceForm , lang:UnanalyzedProse ; lang:inSignSystem ex:english ;
    lang:surfaceText "cat" ; lang:inScript ex:latin ;
    lang:unicodeNormalization "NFC" ; lang:collationLocale "en" ;
    lang:analysisLevel lang:rawLevel .
ex:tgt a lang:SurfaceForm , lang:UnanalyzedProse ; lang:inSignSystem ex:french ;
    lang:surfaceText "chat" ; lang:inScript ex:latin ;
    lang:unicodeNormalization "NFC" ; lang:collationLocale "fr" ;
    lang:analysisLevel lang:rawLevel .

# The strong crossing over unanalyzed prose — the second conjunct is violated.
ex:corrStrong a logic:Correspondence ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Equiv ;
    logic:morphismClass logic:SectionRetraction ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true .

ex:unitOverclaim a lang:TranslationUnit ;
    lang:translationSource ex:src ;
    lang:translationTarget ex:tgt ;
    lang:translationMethod lang:methodHuman ;
    lang:translationCorrespondence ex:corrStrong .
