    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75
|} .

gmeow:partOf skos:closeMatch crm:P46i_forms_part_of {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "CIDOC CRM P46 inverse forms part of — physical/conceptual object parthood; narrower than GMEOW universal partOf"
|} .

gmeow:hasPart skos:closeMatch crm:P46_is_composed_of {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "CIDOC CRM P46 is composed of — narrower than GMEOW universal hasPart"
|} .

gmeow:coarsenTo skos:closeMatch dpv:Generalisation {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "DPV Generalisation (reduce granularity/precision by grouping or rounding) — the privacy-technique counterpart of the gmeow:coarsenTo projection-time directive; the seam to PRIV-GEN"
|} .

gmeow:coarserThan skos:closeMatch skos:broader {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "SKOS broader — the generic hierarchical-order counterpart of the granularity-level ordering gmeow:coarserThan"
|} .

gmeow:Agent skos:closeMatch wd:Q24229398 {|
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:objectLabel "agent" ;
    gmeow:comment "Wikidata 'agent' is a very abstract philosophical concept; GMEOW Agent is the actor in provenance and trust assertions. Directional lossy projection."
|} .
