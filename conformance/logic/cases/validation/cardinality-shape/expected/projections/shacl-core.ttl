@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/cardinality/Record-shape> a sh:NodeShape ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/cardinality/Record> ;
    sh:property [ sh:path <https://blackcatinformatics.ca/gmeow/cardinality/recordId> ; sh:minCount 1 ; sh:maxCount 2 ] .
