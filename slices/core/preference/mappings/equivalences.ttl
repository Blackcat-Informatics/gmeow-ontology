#
# Preference — BY-REFERENCE composition bridges. The preference slice is a
# CONSUMER: it mints its own bridge vocabulary and reuses the sibling slices
# (norms, model-serving, ai, learning, provenance, evidence, semantic-topology)
# at the instance level and BY REFERENCE (Principle 5), rather than re-minting
# their terms. Where the target slice is core and declared in
# gmeow:sliceDependsOn — as norms now is — a real rdfs:range axiom is authored in
# module.ttl instead, and no by-reference row stands in for it; the rows that
# remain here document genuine instance-level composition, including composition
# with the model-serving and semantic-topology extensions, which a core slice may
# never reach by a subclass/domain/range axiom. Each row records that reuse as a
# shipped, auditable correspondence rather than an implicit dependency. Compiled
# to mappings/gmeow-preference.sssom.tsv by `gmeow compile-mappings`.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .

gmeow:mapsetPreference a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-preference.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/preference" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "By-reference composition bridges from the preference slice to the sibling slices it composes with (norms, model-serving, ai, learning, provenance, evidence, semantic-topology). Each row documents an instance-level reuse (Principle 5), NOT a redeclaration: the preference slice composes the sibling term, it does not re-mint it. The gmeow:usesRubric → gmeow:Rubric and gmeow:onCriterion → gmeow:Criterion bridges are absent by design — norms is a core slice preference declares in gmeow:sliceDependsOn, so those two seams are carried by real rdfs:range axioms in module.ttl and a correspondence row would be a second source of truth." .

# ── norms: verdict / contract value vocabulary, reused by-reference ────────────
gmeow:verifierOutcome skos:relatedMatch gmeow:EvaluationVerdict {|
    gmeow:sssomFile "gmeow-preference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "gmeow:verifierOutcome ranges over the grounding logic:QualityValue and reuses the norms gmeow:EvaluationVerdict value vocabulary (verdictHeld / verdictNotHeld / verdictUndetermined) by reference at the instance level, rather than minting a parallel verdict axis."
|} .

gmeow:verifierContract skos:relatedMatch gmeow:Condition {|
    gmeow:sssomFile "gmeow-preference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "gmeow:verifierContract ranges over the core gmeow:InformationObject — a verifier contract is any information object, not specifically a norms gmeow:Condition — and reaches the norms condition apparatus by reference (via gmeow:formalizedAs) at the instance level: the contract a verdict verifies against."
|} .

# ── model-serving: the base model artifact, reused by-reference ────────────────
gmeow:deltaBaseArtifact skos:relatedMatch gmeow:ModelArtifact {|
    gmeow:sssomFile "gmeow-preference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "gmeow:deltaBaseArtifact ranges over the core gmeow:InformationObject and reuses the model-serving gmeow:ModelArtifact by reference at the instance level (Principle 5) — the checkpoint a config delta is a change FROM; a core slice may never take a range axiom onto the model-serving extension."
|} .

# ── ai: model invocation and prompt, reused by-reference ──────────────────────
gmeow:candidateGeneratedBy skos:relatedMatch gmeow:ModelInvocation {|
    gmeow:sssomFile "gmeow-preference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "gmeow:candidateGeneratedBy reuses the ai gmeow:ModelInvocation by reference (Principle 16) — the invocation that minted a candidate, joining ordinary provenance queries rather than re-grounding generation."
|} .

gmeow:deltaPromptIdentity skos:relatedMatch gmeow:Prompt {|
    gmeow:sssomFile "gmeow-preference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "gmeow:deltaPromptIdentity reuses the ai gmeow:Prompt by reference (Principle 16) — the exact prompt leg of a model-config delta's identity tuple, never a re-minted prompt vocabulary."
|} .

# ── learning: the learning event, specialized by-reference ────────────────────
gmeow:PreferenceLearningEvent skos:narrowMatch gmeow:LearningEvent {|
    gmeow:sssomFile "gmeow-preference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "gmeow:PreferenceLearningEvent specializes the learning gmeow:LearningEvent — it reuses the shipped learning-event term by reference (Principle 16) rather than minting a parallel training vocabulary; a preference-learning run IS a kind of learning event, so the alignment is skos:narrowMatch (the preference term is strictly narrower than the learning-slice term), not a symmetric closeMatch."
|} .

# ── provenance: the derivation spine, reused by-reference ──────────────────────
gmeow:recordsProjectionPreservation skos:relatedMatch gmeow:wasDerivedFrom {|
    gmeow:sssomFile "gmeow-preference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "compiling observations into a sheaf is a projection whose preservation/loss ledger rides the provenance derivation spine — gmeow:recordsProjectionPreservation composes with gmeow:wasDerivedFrom by reference (Principle 16 / Principle 17), never re-minting the provenance vocabulary."
|} .

# ── evidence: the evidence span, reused by-reference ──────────────────────────
gmeow:deltaEvaluationEvidence skos:relatedMatch gmeow:EvidenceSpan {|
    gmeow:sssomFile "gmeow-preference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "gmeow:deltaEvaluationEvidence reuses the evidence gmeow:EvidenceSpan by reference (Principle 16) — the evidence leg that makes a config delta's evaluation warrant auditable, never a re-minted evidence term."
|} .

# ── semantic-topology: the standpoint claim wrapper, reused by-reference ───────
gmeow:DisagreementObstruction skos:relatedMatch gmeow:TopologyClaim {|
    gmeow:sssomFile "gmeow-preference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "gmeow:DisagreementObstruction is the preference-side H1 twin of the semantic-topology sheaf apparatus: both wrap a math: object (here math:GluingObstruction) under the same H0/H1 gluing picture that gmeow:TopologyClaim governs. Related by reference (Principle 16) — the preference slice reuses the sibling's obstruction/consensus pattern at the instance level, never redeclaring gmeow:TopologyClaim."
|} .
