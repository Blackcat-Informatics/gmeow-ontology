gmeow:MachineryDescendantRule
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "admitted event descendant propagation"@x-gmeow-english ;
    skos:definition "Propagate machineryForReader from a machinery Event to an Event related by subEventOf, requiring the same reader's explicit admission at both endpoints and explicit rule selection."@x-gmeow-english ;
    gmeow:useWhen "Use this declared rule only within an explicitly selected grounding set and reader/world interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid activating rules from declaration membership alone or using another reader's classification as this reader's result."@x-gmeow-english ;
    gmeow:howToUse "Retain its native reified atoms, select its containing set positively, and keep source admissions separate from derived outputs."@x-gmeow-english ;
    skos:scopeNote "subEventOf is transitive, so admitted descendants may be nested at any supplied or entailed depth. This is one permitted relation, not a promise of one physical edge or a walk over arbitrary links."@x-gmeow-english ;
    skos:example "gmeow:operationalCueGrounding gmeow:groundingRule gmeow:MachineryDescendantRule . names this actual rule without executing it."@x-gmeow-english ;
    logic:head [ rdf:reifies <<( _:cueGround_record gmeow:machineryForReader _:cueGround_reader )>> ] ;
    logic:body [ rdf:reifies <<( _:cueGround_set gmeow:groundingSelectedBy _:cueGround_reader )>> ],
        [ rdf:reifies <<( _:cueGround_set gmeow:groundingRule gmeow:MachineryDescendantRule )>> ],
        [ rdf:reifies <<( _:cueGround_parent rdf:type gmeow:Event )>> ],
        [ rdf:reifies <<( _:cueGround_record rdf:type gmeow:Event )>> ],
        [ rdf:reifies <<( _:cueGround_record gmeow:subEventOf _:cueGround_parent )>> ],
        [ rdf:reifies <<( _:cueGround_parent gmeow:machineryForReader _:cueGround_reader )>> ],
        [ rdf:reifies <<( _:cueGround_parent gmeow:machineryAdmittedBy _:cueGround_reader )>> ],
        [ rdf:reifies <<( _:cueGround_record gmeow:machineryAdmittedBy _:cueGround_reader )>> ] .

gmeow:MachineryGeneratedRecordRule
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "admitted generated record propagation"@x-gmeow-english ;
    skos:definition "Propagate machineryForReader to an admitted InformationObject generated by a machinery Activity, with same-reader admission on output and activity and explicit rule selection."@x-gmeow-english ;
    gmeow:useWhen "Use this declared rule only within an explicitly selected grounding set and reader/world interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid activating rules from declaration membership alone or using another reader's classification as this reader's result."@x-gmeow-english ;
    gmeow:howToUse "Retain its native reified atoms, select its containing set positively, and keep source admissions separate from derived outputs."@x-gmeow-english ;
    skos:scopeNote "Only wasGeneratedBy carries this output edge. Human-authored outputs are not excluded without explicit admission; used, readArtifact, receiptArtifact, wasDerivedFrom and derivedBy do not propagate the role."@x-gmeow-english ;
    skos:example "gmeow:operationalCueGrounding gmeow:groundingRule gmeow:MachineryGeneratedRecordRule . names this actual rule without executing it."@x-gmeow-english ;
    logic:head [ rdf:reifies <<( _:cueGround_record gmeow:machineryForReader _:cueGround_reader )>> ] ;
    logic:body [ rdf:reifies <<( _:cueGround_set gmeow:groundingSelectedBy _:cueGround_reader )>> ],
        [ rdf:reifies <<( _:cueGround_set gmeow:groundingRule gmeow:MachineryGeneratedRecordRule )>> ],
        [ rdf:reifies <<( _:cueGround_record rdf:type gmeow:InformationObject )>> ],
        [ rdf:reifies <<( _:cueGround_parent rdf:type gmeow:Activity )>> ],
        [ rdf:reifies <<( _:cueGround_record gmeow:wasGeneratedBy _:cueGround_parent )>> ],
        [ rdf:reifies <<( _:cueGround_parent gmeow:machineryForReader _:cueGround_reader )>> ],
        [ rdf:reifies <<( _:cueGround_parent gmeow:machineryAdmittedBy _:cueGround_reader )>> ],
        [ rdf:reifies <<( _:cueGround_record gmeow:machineryAdmittedBy _:cueGround_reader )>> ] .

gmeow:MachineryRecordPublicationRule
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "descriptive machinery type publication"@x-gmeow-english ;
    skos:definition "Publish MachineryRecord type from actual reader-specific machineryForReader state under an explicitly selected containing rule set."@x-gmeow-english ;
    gmeow:useWhen "Use this declared rule only within an explicitly selected grounding set and reader/world interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid activating rules from declaration membership alone or using another reader's classification as this reader's result."@x-gmeow-english ;
    gmeow:howToUse "Retain its native reified atoms, select its containing set positively, and keep source admissions separate from derived outputs."@x-gmeow-english ;
    skos:scopeNote "This unary type is descriptive and never drives recursive propagation or a negative grounding decision. Reader identity remains in the binary derived state."@x-gmeow-english ;
    skos:example "gmeow:operationalCueGrounding gmeow:groundingRule gmeow:MachineryRecordPublicationRule . names this actual rule without executing it."@x-gmeow-english ;
    logic:head [ rdf:reifies <<( _:cueGround_record rdf:type gmeow:MachineryRecord )>> ] ;
    logic:body [ rdf:reifies <<( _:cueGround_set gmeow:groundingSelectedBy _:cueGround_reader )>> ],
        [ rdf:reifies <<( _:cueGround_set gmeow:groundingRule gmeow:MachineryRecordPublicationRule )>> ],
        [ rdf:reifies <<( _:cueGround_record gmeow:machineryForReader _:cueGround_reader )>> ] .

gmeow:CueNonMachineryGroundingRule
    a logic:Rule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "selected non-machinery cue grounding"@x-gmeow-english ;
    skos:definition "Derive cueGrounded for a selected CueMatch only when its matched cue selects the active set, its source record and field are supplied, and no machineryForReader fact holds for that same grounding reader in the completed selected interpretation."@x-gmeow-english ;
    gmeow:useWhen "Use this declared rule only within an explicitly selected grounding set and reader/world interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid activating rules from declaration membership alone or using another reader's classification as this reader's result."@x-gmeow-english ;
    gmeow:howToUse "Retain its native reified atoms, select its containing set positively, and keep source admissions separate from derived outputs."@x-gmeow-english ;
    skos:scopeNote "Negation is scoped to the supplied reader/world model after positive machinery closure. It asserts neither universal absence of machinery nor source authorship, and it never changes suppression or evidence polarity."@x-gmeow-english ;
    skos:example "gmeow:operationalCueGrounding gmeow:groundingRule gmeow:CueNonMachineryGroundingRule . names this actual rule without executing it."@x-gmeow-english ;
    logic:head [ rdf:reifies <<( _:cueGround_match gmeow:cueGrounded _:cueGround_cue )>> ] ;
    logic:body [ rdf:reifies <<( _:cueGround_set gmeow:groundingSelectedBy _:cueGround_reader )>> ],
        [ rdf:reifies <<( _:cueGround_set gmeow:groundingRule gmeow:CueNonMachineryGroundingRule )>> ],
        [ rdf:reifies <<( _:cueGround_match rdf:type gmeow:CueMatch )>> ],
        [ rdf:reifies <<( _:cueGround_match gmeow:matchedCue _:cueGround_cue )>> ],
        [ rdf:reifies <<( _:cueGround_match gmeow:matchRecord _:cueGround_record )>> ],
        [ rdf:reifies <<( _:cueGround_match gmeow:matchField _:cueGround_field )>> ],
        [ rdf:reifies <<( _:cueGround_match gmeow:cueGroundingReader _:cueGround_reader )>> ],
        [ rdf:reifies <<( _:cueGround_cue gmeow:cueGrounding _:cueGround_set )>> ] ;
    logic:negatedBody [ rdf:reifies <<( _:cueGround_record gmeow:machineryForReader _:cueGround_reader )>> ] .

# Native RDF 1.2 statement-position variables are local to each compiled rule.
_:cueGround_cue logic:termVariable "cue" .
_:cueGround_field logic:termVariable "field" .
_:cueGround_intention logic:termVariable "intention" .
_:cueGround_match logic:termVariable "match" .
_:cueGround_parent logic:termVariable "parent" .
_:cueGround_reader logic:termVariable "reader" .
_:cueGround_record logic:termVariable "record" .
_:cueGround_set logic:termVariable "set" .

gmeow:GroundingRuleHeadEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "grounding rule head evidence"@x-gmeow-english ;
    skos:definition "Every rule member of a GroundingRuleSet supplies a head reifier with an rdf:reifies target; prose membership alone is insufficient."@x-gmeow-english ;
    gmeow:useWhen "Use to check the retained grounding declaration and its supplied binding evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting structural validity as selected execution, complete facts or authenticated derivation."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized constraint over the selected supplied records and preserve the original evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "Structural evidence does not replace canonical Rule parsing, selected execution or source/derived-origin authentication."@x-gmeow-english ;
    skos:example "gmeow:GroundingRuleHeadEvidenceConstraint logic:formalizes gmeow:groundingRule . identifies this declaration law."@x-gmeow-english ;
    logic:formalizes gmeow:groundingRule ;
    logic:message "Every rule member of a GroundingRuleSet supplies a head reifier with an rdf:reifies target; prose membership alone is insufficient." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:GroundingRuleSet ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "rule" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:groundingRule ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "rule" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "head" ], [ logic:termIndex 1 ; logic:termVariable "headTarget" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:head ; logic:argument [ logic:termIndex 0 ; logic:termVariable "rule" ], [ logic:termIndex 1 ; logic:termVariable "head" ] ], [ a logic:Formula ; logic:relation rdf:reifies ; logic:argument [ logic:termIndex 0 ; logic:termVariable "head" ], [ logic:termIndex 1 ; logic:termVariable "headTarget" ] ] ] ] ] ] ] ] .

gmeow:GroundingRuleBodyEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "grounding rule body evidence"@x-gmeow-english ;
    skos:definition "Every supplied positive or negative body atom on a grounding-rule member carries an rdf:reifies target. A ground empty-body rule remains legal."@x-gmeow-english ;
    gmeow:useWhen "Use to check the retained grounding declaration and its supplied binding evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting structural validity as selected execution, complete facts or authenticated derivation."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized constraint over the selected supplied records and preserve the original evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "Structural evidence does not replace canonical Rule parsing, selected execution or source/derived-origin authentication."@x-gmeow-english ;
    skos:example "gmeow:GroundingRuleBodyEvidenceConstraint logic:formalizes gmeow:groundingRule . identifies this declaration law."@x-gmeow-english ;
    logic:formalizes gmeow:groundingRule ;
    logic:message "Every supplied positive or negative body atom on a grounding-rule member carries an rdf:reifies target. A ground empty-body rule remains legal." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:GroundingRuleSet ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "rule" ], [ logic:termIndex 1 ; logic:termVariable "atom" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:groundingRule ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "rule" ] ], [ a logic:Formula ; logic:or [ a logic:Formula ; logic:relation logic:body ; logic:argument [ logic:termIndex 0 ; logic:termVariable "rule" ], [ logic:termIndex 1 ; logic:termVariable "atom" ] ], [ a logic:Formula ; logic:relation logic:negatedBody ; logic:argument [ logic:termIndex 0 ; logic:termVariable "rule" ], [ logic:termIndex 1 ; logic:termVariable "atom" ] ] ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "bodyTarget" ] ; logic:exists [ a logic:Formula ; logic:relation rdf:reifies ; logic:argument [ logic:termIndex 0 ; logic:termVariable "atom" ], [ logic:termIndex 1 ; logic:termVariable "bodyTarget" ] ] ] ] ] ] ] .

gmeow:CueGroundingReaderRequiredConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "selected grounding reader required"@x-gmeow-english ;
    skos:definition "A CueMatch whose matched cue declares a cueGrounding set supplies its actual cueGroundingReader. Other cue matches acquire no unconditional reader requirement."@x-gmeow-english ;
    gmeow:useWhen "Use to check the retained grounding declaration and its supplied binding evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting structural validity as selected execution, complete facts or authenticated derivation."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized constraint over the selected supplied records and preserve the original evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "This is conditional presence, separate from local reader maximum and explicit rule-set activation. It does not turn source authorship into reader identity."@x-gmeow-english ;
    skos:example "gmeow:CueGroundingReaderRequiredConstraint logic:formalizes gmeow:cueGroundingReader . identifies this declaration law."@x-gmeow-english ;
    logic:formalizes gmeow:cueGroundingReader ;
    logic:message "A CueMatch whose matched cue declares a cueGrounding set supplies its actual cueGroundingReader. Other cue matches acquire no unconditional reader requirement." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CueMatch ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "cue" ], [ logic:termIndex 1 ; logic:termVariable "set" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:matchedCue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "cue" ] ], [ a logic:Formula ; logic:relation gmeow:cueGrounding ; logic:argument [ logic:termIndex 0 ; logic:termVariable "cue" ], [ logic:termIndex 1 ; logic:termVariable "set" ] ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "reader" ] ; logic:exists [ a logic:Formula ; logic:relation gmeow:cueGroundingReader ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "reader" ] ] ] ] ] ] ] .

gmeow:CueGroundedBindingConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "derived cue grounding binding"@x-gmeow-english ;
    skos:definition "Every supplied cueGrounded fact names the match's actual cue, retains a grounding reader and a selected nonempty rule set, and agrees with its reported held grounding outcome."@x-gmeow-english ;
    gmeow:useWhen "Use to check the retained grounding declaration and its supplied binding evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting structural validity as selected execution, complete facts or authenticated derivation."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized constraint over the selected supplied records and preserve the original evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "This checks retained binding evidence only. It cannot distinguish a forged source assertion from a genuine derived fact in a union graph or prove evaluation completion."@x-gmeow-english ;
    skos:example "gmeow:CueGroundedBindingConstraint logic:formalizes gmeow:cueGrounded . identifies this declaration law."@x-gmeow-english ;
    logic:formalizes gmeow:cueGrounded ;
    logic:message "Every supplied cueGrounded fact names the match's actual cue, retains a grounding reader and a selected nonempty rule set, and agrees with its reported held grounding outcome." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:CueMatch ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "cue" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:cueGrounded ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "cue" ] ] ; logic:consequent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:matchedCue ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "cue" ] ], [ a logic:Formula ; logic:relation gmeow:matchGrounding ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:verdictHeld ] ], [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "reader" ], [ logic:termIndex 1 ; logic:termVariable "set" ], [ logic:termIndex 2 ; logic:termVariable "rule" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:cueGroundingReader ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "reader" ] ], [ a logic:Formula ; logic:relation gmeow:cueGrounding ; logic:argument [ logic:termIndex 0 ; logic:termVariable "cue" ], [ logic:termIndex 1 ; logic:termVariable "set" ] ], [ a logic:Formula ; logic:relation gmeow:groundingSelectedBy ; logic:argument [ logic:termIndex 0 ; logic:termVariable "set" ], [ logic:termIndex 1 ; logic:termVariable "reader" ] ], [ a logic:Formula ; logic:relation gmeow:groundingRule ; logic:argument [ logic:termIndex 0 ; logic:termVariable "set" ], [ logic:termIndex 1 ; logic:termVariable "rule" ] ] ] ] ] ] ] ] ] .

gmeow:GroundingRuleSetClosedRecordConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "grounding rule set closed record"@x-gmeow-english ;
    skos:definition "A GroundingRuleSet carries only its declared membership and selection fields, complete annotation coat and admitted provenance or operational-record metadata."@x-gmeow-english ;
    gmeow:useWhen "Use to check the retained grounding declaration and its supplied binding evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting structural validity as selected execution, complete facts or authenticated derivation."@x-gmeow-english ;
    gmeow:howToUse "Evaluate the realized constraint over the selected supplied records and preserve the original evidence when reporting a violation."@x-gmeow-english ;
    skos:scopeNote "Predicate closure does not close the external fact world or assert that named rules ran. Richer provenance can remain on independent RDF 1.2 assertion reifiers."@x-gmeow-english ;
    skos:example "gmeow:GroundingRuleSetClosedRecordConstraint logic:formalizes gmeow:GroundingRuleSet . identifies this declaration law."@x-gmeow-english ;
    logic:formalizes gmeow:GroundingRuleSet ;
    logic:message "A GroundingRuleSet carries only its declared membership and selection fields, complete annotation coat and admitted provenance or operational-record metadata." ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:GroundingRuleSet ] ] ; logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "predicate" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:linkVia ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "predicate" ], [ logic:termIndex 2 ; logic:termVariable "value" ] ], [ a logic:Formula ; logic:not [ a logic:Formula ; logic:relation logic:termIn ; logic:argument [ logic:termIndex 0 ; logic:termVariable "predicate" ], [ logic:termIndex 1 ; logic:termIri rdf:type ], [ logic:termIndex 2 ; logic:termIri rdfs:label ], [ logic:termIndex 3 ; logic:termIri rdfs:comment ], [ logic:termIndex 4 ; logic:termIri rdfs:isDefinedBy ], [ logic:termIndex 5 ; logic:termIri skos:definition ], [ logic:termIndex 6 ; logic:termIri skos:scopeNote ], [ logic:termIndex 7 ; logic:termIri skos:example ], [ logic:termIndex 8 ; logic:termIri gmeow:useWhen ], [ logic:termIndex 9 ; logic:termIri gmeow:avoidWhen ], [ logic:termIndex 10 ; logic:termIri gmeow:howToUse ], [ logic:termIndex 11 ; logic:termIri gmeow:description ], [ logic:termIndex 12 ; logic:termIri gmeow:graphBoxRole ], [ logic:termIndex 13 ; logic:termIri gmeow:accordingTo ], [ logic:termIndex 14 ; logic:termIri gmeow:wasAttributedTo ], [ logic:termIndex 15 ; logic:termIri gmeow:wasDerivedFrom ], [ logic:termIndex 16 ; logic:termIri gmeow:versionOf ], [ logic:termIndex 17 ; logic:termIri gmeow:versionLabel ], [ logic:termIndex 18 ; logic:termIri gmeow:contentDigest ], [ logic:termIndex 19 ; logic:termIri gmeow:groundingRule ], [ logic:termIndex 20 ; logic:termIri gmeow:groundingSelectedBy ], [ logic:termIndex 21 ; logic:termIri gmeow:machineryAdmittedBy ], [ logic:termIndex 22 ; logic:termIri gmeow:machineryForReader ] ] ] ] ] ] ] ] .

# Reviewed reading parameters and reported textual measurements.
gmeow:restatementRun
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "restatement run"@x-gmeow-english ;
    skos:definition "The longest consecutive word run a text repeats from the outside text it is read as restating, recorded on that wasDerivedFrom reading's reifier."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the reported longest repeated run for ranking a possible restatement."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using the run as confidence, a truth verdict or proof of word matching."@x-gmeow-english ;
    gmeow:howToUse "Supply one positiveInteger on the attributed restatement reifier, retaining the source texts and rule version."@x-gmeow-english ;
    skos:scopeNote "The value is a supplied ranking measurement, never confidence, credence or independently verified lexical overlap."@x-gmeow-english ;
    skos:example "ex:restatement gmeow:restatementRun \"5\"^^xsd:positiveInteger ."@x-gmeow-english ;
    logic:domain rdf:Statement ; logic:range xsd:positiveInteger .

gmeow:restatementShare
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "restatement share"@x-gmeow-english ;
    skos:definition "The supplied share of the outside text's words covered by the repeated consecutive run, strictly greater than zero and at most one, recorded on the possible restatement reifier."@x-gmeow-english ;
    gmeow:useWhen "Use to rank possible restatements by coverage of their outside source."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting an answer-word denominator or interpreting coverage as support."@x-gmeow-english ;
    gmeow:howToUse "Supply one decimal in (0,1] with restatementRun on the same attributed reifier."@x-gmeow-english ;
    skos:scopeNote "The value is a supplied ranking measurement, never confidence, credence or independently verified lexical overlap."@x-gmeow-english ;
    skos:example "ex:restatement gmeow:restatementShare 0.5 ."@x-gmeow-english ;
    logic:domain rdf:Statement ; logic:range xsd:decimal .

gmeow:restatementReceivedAt
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "restatement received at"@x-gmeow-english ;
    skos:definition "The supplied date-time at which the reader orders the author as having received the outside words read as restated, accompanied by the stated receipt basis."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the reader's reported receipt chronology for a possible restatement."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid padding coarse source dates, inventing a timezone or equating storage receipt with human readership."@x-gmeow-english ;
    gmeow:howToUse "Preserve the source dateTime and restatementReceiptBasis on the attributed restatement reifier."@x-gmeow-english ;
    skos:scopeNote "The timestamp is an attributed interpretation. These declarations do not select a fallback time, resolve incomparable clocks or prove that receipt preceded authorship."@x-gmeow-english ;
    skos:example "ex:restatement gmeow:restatementReceivedAt \"2026-10-29T10:00:00Z\"^^xsd:dateTime ."@x-gmeow-english ;
    logic:domain rdf:Statement ; logic:range xsd:dateTime .

gmeow:restatementReceiptBasis
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "restatement receipt basis"@x-gmeow-english ;
    skos:definition "What the reader reports having used to locate receipt of the outside words, retained on the possible restatement reifier separately from the receipt date-time."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the explicit basis of a reported receipt time."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring a preferred source, a missing receipt or a stronger clock from a basis value."@x-gmeow-english ;
    gmeow:howToUse "Name one ReceiptBasis and retain its actual source evidence through provenance."@x-gmeow-english ;
    skos:scopeNote "The open basis vocabulary describes a selected interpretation; it neither orders evidence globally nor executes a fallback procedure."@x-gmeow-english ;
    skos:example "ex:restatement gmeow:restatementReceiptBasis gmeow:receiptFromReceivedAt ."@x-gmeow-english ;
    logic:domain rdf:Statement ; logic:range gmeow:ReceiptBasis .

gmeow:ReceiptBasis
    a logic:Class , logic:AbstractIndividualType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Receipt Basis"@x-gmeow-english ;
    skos:definition "An open quality-value vocabulary describing the source a reader used to locate receipt of outside words. Preference and availability belong to the selected reader and rule version."@x-gmeow-english ;
    gmeow:useWhen "Use to classify the stated source of a reader's receipt-time interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating basis identity as proof of receipt, source availability or a universal preference."@x-gmeow-english ;
    gmeow:howToUse "Retain the chosen value, actual source evidence and selected rule version."@x-gmeow-english ;
    skos:scopeNote "Values are semantic QualityValues, not source documents, observation results or automatically selected fallbacks."@x-gmeow-english ;
    skos:example "gmeow:receiptFromAssertion a gmeow:ReceiptBasis ."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:receiptFromReceivedAt
    a logic:NamedIndividual , gmeow:ReceiptBasis ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "receipt from receivedAt"@x-gmeow-english ;
    skos:definition "The reader reports using the source message's receivedAt value to locate receipt of the outside words. Storage receipt does not prove that their author read them."@x-gmeow-english ;
    gmeow:useWhen "Use when the reader explicitly reports this receipt-time basis."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving absence of a stronger source merely from this value."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected basis and its source evidence on the restatement reifier."@x-gmeow-english ;
    skos:scopeNote "Basis values do not execute source selection or choose a universally preferred chronology."@x-gmeow-english ;
    skos:example "ex:restatement gmeow:restatementReceiptBasis gmeow:receiptFromReceivedAt ."@x-gmeow-english .

gmeow:receiptFromEvidenceAct
    a logic:NamedIndividual , gmeow:ReceiptBasis ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "receipt from evidence act"@x-gmeow-english ;
    skos:definition "The reader reports that no receipt was recorded and uses the latest supplied assertion time of the acts named by the outside claim's evidence. Latest is a reported reader ordering, not a computed ontology result."@x-gmeow-english ;
    gmeow:useWhen "Use when the reader explicitly reports this receipt-time basis."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving absence of a stronger source merely from this value."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected basis and its source evidence on the restatement reifier."@x-gmeow-english ;
    skos:scopeNote "Basis values do not execute source selection or choose a universally preferred chronology."@x-gmeow-english ;
    skos:example "ex:restatement gmeow:restatementReceiptBasis gmeow:receiptFromEvidenceAct ."@x-gmeow-english .

gmeow:receiptFromAssertion
    a logic:NamedIndividual , gmeow:ReceiptBasis ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "receipt from assertion"@x-gmeow-english ;
    skos:definition "The reader reports that no other source records receipt and uses the outside claim's own assertion time as its receipt-time basis. It remains an interpretation rather than a receipt observation."@x-gmeow-english ;
    gmeow:useWhen "Use when the reader explicitly reports this receipt-time basis."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving absence of a stronger source merely from this value."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected basis and its source evidence on the restatement reifier."@x-gmeow-english ;
    skos:scopeNote "Basis values do not execute source selection or choose a universally preferred chronology."@x-gmeow-english ;
    skos:example "ex:restatement gmeow:restatementReceiptBasis gmeow:receiptFromAssertion ."@x-gmeow-english .

gmeow:restatementRuleVersion
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "restatement rule version"@x-gmeow-english ;
    skos:definition "The exact digest literal of the immutable RestatementRule parameter release used for this reading, copied from that release's contentDigest without changing its datatype or lexical identity."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the reported parameter-release digest on a restatement reifier."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid an untyped substitute version token, an invented digest validator or a mutable rule node."@x-gmeow-english ;
    gmeow:howToUse "Link the reifier through wasDerivedFrom to the actual RestatementRule version whose contentDigest is the identical RDF term."@x-gmeow-english ;
    skos:scopeNote "The binding law checks term identity and retained release metadata. It does not compute a parameter hash or supply missing native digest admission."@x-gmeow-english ;
    skos:example "ex:restatement gmeow:restatementRuleVersion \"sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\" ."@x-gmeow-english ;
    logic:domain rdf:Statement ; logic:range rdfs:Literal .

gmeow:ReadingRule
    a logic:Class , logic:Kind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Reading Rule"@x-gmeow-english ;
    skos:definition "An immutable, reviewed information artifact declaring a reader's matching parameters. Its version identity is separate from its lineage, the reading process and any logic:Rule execution structure."@x-gmeow-english ;
    gmeow:useWhen "Use to expose the exact reviewed parameters selected by a reader."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a parameter artifact as an executable logic:Rule or mutating a released version."@x-gmeow-english ;
    gmeow:howToUse "Retain versionOf, versionLabel, contentDigest and accountable provenance; declare only the thresholds this selected rule actually uses."@x-gmeow-english ;
    skos:scopeNote "Generic thresholds are explicit, not defaults. A changed parameter or declared word inventory requires a new version; digest verification remains its existing owner's contract."@x-gmeow-english ;
    skos:example "ex:ruleV1 a gmeow:ReadingRule ; gmeow:versionOf ex:ruleLineage ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:RestatementRule
    a logic:Class , logic:SubKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Restatement Rule"@x-gmeow-english ;
    skos:definition "A ReadingRule parameter release for reading a text as restating outside words received earlier according to the selected reader. It declares its minimum run, short-source uncommon-word threshold and common-word inventory."@x-gmeow-english ;
    gmeow:useWhen "Use to expose the exact restatement parameters used by a reader."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring earlier receipt, successful matching or source authorship from the rule declaration."@x-gmeow-english ;
    gmeow:howToUse "Supply restatementMinimumRun and restatementMinimumUncommonWords; retain common words exactly as the declared rule reads them."@x-gmeow-english ;
    skos:scopeNote "The common-word inventory may be empty. No implicit minimumShare is invented for this profile, and no lexical matcher or receipt selector is executed."@x-gmeow-english ;
    skos:example "ex:restatementV1 a gmeow:RestatementRule ; gmeow:restatementMinimumRun \"5\"^^xsd:positiveInteger ; gmeow:restatementMinimumUncommonWords \"2\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    logic:subClassOf gmeow:ReadingRule .

gmeow:restatementMinimumRun
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "restatement minimum run"@x-gmeow-english ;
    skos:definition "The fewest consecutive source words a text must repeat under this RestatementRule."@x-gmeow-english ;
    gmeow:useWhen "Use to expose this selected rule's actual matching threshold."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid filling an absent threshold with a hidden default or treating it as a measured result."@x-gmeow-english ;
    gmeow:howToUse "Keep the declared numeric value on the immutable rule version; changed parameters create a new release."@x-gmeow-english ;
    skos:scopeNote "Thresholds are supplied parameter values, not confidence or executed match evidence. A zero uncommon-word threshold is an explicit setting, not a missing capability."@x-gmeow-english ;
    skos:example "ex:ruleV1 gmeow:restatementMinimumRun \"5\"^^xsd:positiveInteger ."@x-gmeow-english ;
    logic:domain gmeow:RestatementRule ; logic:range xsd:positiveInteger ; logic:subPropertyOf gmeow:minimumRun .

gmeow:restatementMinimumUncommonWords
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "restatement minimum uncommon words"@x-gmeow-english ;
    skos:definition "The least number of uncommon words required in a source shorter than the minimum run for a whole-source repetition to qualify under this RestatementRule."@x-gmeow-english ;
    gmeow:useWhen "Use to expose this selected rule's actual matching threshold."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid filling an absent threshold with a hidden default or treating it as a measured result."@x-gmeow-english ;
    gmeow:howToUse "Keep the declared numeric value on the immutable rule version; changed parameters create a new release."@x-gmeow-english ;
    skos:scopeNote "Thresholds are supplied parameter values, not confidence or executed match evidence. A zero uncommon-word threshold is an explicit setting, not a missing capability."@x-gmeow-english ;
    skos:example "ex:ruleV1 gmeow:restatementMinimumUncommonWords \"2\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    logic:domain gmeow:RestatementRule ; logic:range xsd:nonNegativeInteger .

gmeow:minimumRun
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "minimum run"@x-gmeow-english ;
    skos:definition "The explicitly declared least consecutive-word span of a match under this ReadingRule."@x-gmeow-english ;
    gmeow:useWhen "Use to expose this selected rule's actual matching threshold."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid filling an absent threshold with a hidden default or treating it as a measured result."@x-gmeow-english ;
    gmeow:howToUse "Keep the declared numeric value on the immutable rule version; changed parameters create a new release."@x-gmeow-english ;
    skos:scopeNote "Thresholds are supplied parameter values, not confidence or executed match evidence. A zero uncommon-word threshold is an explicit setting, not a missing capability."@x-gmeow-english ;
    skos:example "ex:ruleV1 gmeow:minimumRun \"5\"^^xsd:positiveInteger ."@x-gmeow-english ;
    logic:domain gmeow:ReadingRule ; logic:range xsd:positiveInteger .

gmeow:minimumShare
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "minimum share"@x-gmeow-english ;
    skos:definition "The explicitly declared least share a match must reach under this ReadingRule, strictly greater than zero and at most one."@x-gmeow-english ;
    gmeow:useWhen "Use to expose this selected rule's actual matching threshold."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid filling an absent threshold with a hidden default or treating it as a measured result."@x-gmeow-english ;
    gmeow:howToUse "Keep the declared numeric value on the immutable rule version; changed parameters create a new release."@x-gmeow-english ;
    skos:scopeNote "Thresholds are supplied parameter values, not confidence or executed match evidence. A zero uncommon-word threshold is an explicit setting, not a missing capability."@x-gmeow-english ;
    skos:example "ex:ruleV1 gmeow:minimumShare 0.5 ."@x-gmeow-english ;
    logic:domain gmeow:ReadingRule ; logic:range xsd:decimal .

gmeow:restatementCommonWord
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "restatement common word"@x-gmeow-english ;
    skos:definition "A common-word token spelling exactly as the selected RestatementRule reads words. It is part of that immutable parameter inventory, not a claim that the word is universally common."@x-gmeow-english ;
    gmeow:useWhen "Use to expose the rule's actual common-word inventory."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid minting Lexemes or imposing an undeclared tokenizer, case fold or language default."@x-gmeow-english ;
    gmeow:howToUse "Keep each machine token as xsd:string and retain the rule's declared language and matching contract."@x-gmeow-english ;
    skos:scopeNote "The inventory is unordered and may be empty. These declarations do not test tokenization, normalization or uncommon-word counts."@x-gmeow-english ;
    skos:example "ex:restatementV1 gmeow:restatementCommonWord \"the\" , \"and\" ."@x-gmeow-english ;
    logic:domain gmeow:RestatementRule ; logic:range xsd:string .

gmeow:echoRun
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "echo run"@x-gmeow-english ;
    skos:definition "The longest run of a prompt's words that one sentence of an answer repeats in order, recorded on the echoesPremiseOf reading's reifier for ranking."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the reported longest sentence-level prompt echo."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid confusing the run with a confidence score or the full-answer word-share measure."@x-gmeow-english ;
    gmeow:howToUse "Supply one positiveInteger on the attributed echo reifier and preserve the answer and concrete Prompt."@x-gmeow-english ;
    skos:scopeNote "The value is a supplied ranking measurement, never confidence, credence or independently verified lexical overlap."@x-gmeow-english ;
    skos:example "ex:echo gmeow:echoRun \"4\"^^xsd:positiveInteger ."@x-gmeow-english ;
    logic:domain rdf:Statement ; logic:range xsd:positiveInteger .

gmeow:echoShare
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "echo share"@x-gmeow-english ;
    skos:definition "The supplied share of an answer's words that are words of its prompt, strictly greater than zero and at most one, recorded on the attributed echo reifier."@x-gmeow-english ;
    gmeow:useWhen "Use to rank reported echoes by answer-word coverage."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting the outside-source denominator of restatementShare or deriving a truth verdict."@x-gmeow-english ;
    gmeow:howToUse "Supply one decimal in (0,1] with echoRun on the same echo reifier."@x-gmeow-english ;
    skos:scopeNote "The value is a supplied ranking measurement, never confidence, credence or independently verified lexical overlap."@x-gmeow-english ;
    skos:example "ex:echo gmeow:echoShare 0.75 ."@x-gmeow-english ;
    logic:domain rdf:Statement ; logic:range xsd:decimal .


# Intrinsic reading contracts; no lexical or execution computation.
gmeow:ReadingRuleVersionIdentityConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-cues> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Reading rule version identity constraint"@x-gmeow-english ;
    skos:definition "An immutable ReadingRule version is distinct from the lineage resource it versions."@x-gmeow-english ;
    gmeow:useWhen "Use to check the declared binding or numeric boundary on its own supplied reading record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating this intrinsic law as an executed reader, authenticated receipt or digest verification."@x-gmeow-english ;
    gmeow:howToUse "Retain actual source values and evaluate the canonical law in the selected interpretation."@x-gmeow-english ;
    skos:scopeNote "Version identity and retained digest evidence do not authenticate review, bytes or an executed rule."@x-gmeow-english ;
    skos:example "gmeow:ReadingRuleVersionIdentityConstraint logic:formalizes gmeow:ReadingRule ."@x-gmeow-english ;
    logic:formalizes gmeow:ReadingRule ; logic:message "An immutable ReadingRule version is distinct from the lineage resource it versions."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "lineage" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ReadingRule ] ] , [ a logic:Formula ; logic:relation gmeow:versionOf ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "lineage" ] ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termDistinct ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "lineage" ] ] ] ] .

gmeow:RestatementAnnotationContractConstraint
    a logic:Constraint ;
