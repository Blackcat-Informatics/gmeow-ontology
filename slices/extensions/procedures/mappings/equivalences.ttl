    gmeow:confidence 0.85 ;
    gmeow:comment "OBI protocol (OBI:0000272); GMEOW Procedure generalises this to all prescriptive specs." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc022 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Execution ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject obi:0000011 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "OBI planned process (OBI:0000011); GMEOW Execution is the event occurrence." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

# --------------------------------------------------------------------------- #
# BPMN — conceptual alignments (no canonical RDF ontology with stable IRIs)
# --------------------------------------------------------------------------- #

gmeow:eqProc023 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:stepTypeBranch ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject bpmn:gateway ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "BPMN gateway; GMEOW stepTypeBranch is a value on a ProcedureStep." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc024 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ControlFlow ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject bpmn:sequenceFlow ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "BPMN sequenceFlow; GMEOW ControlFlow is a reified relator with optional guard." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc025 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:DataFlow ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject bpmn:dataAssociation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "BPMN dataAssociation; GMEOW DataFlow is a reified relator carrying the flowing entity." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

# --------------------------------------------------------------------------- #
# RO-Crate Workflow-Run — reproducibility profile
# --------------------------------------------------------------------------- #

gmeow:eqProc026 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Execution ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject ro_crate:CreateAction ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "RO-Crate Workflow-Run CreateAction; GMEOW Execution is the event that enacts a procedure." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

# --------------------------------------------------------------------------- #
# Workflow-engine surfaces — Airflow / CWL / WDL / Temporal / Nextflow.        #
#                                                                              #
# These engines publish no canonical RDF ontologies with stable term IRIs, so  #
# each alignment is a BY-REFERENCE bridge (logic:BridgeView, Principle 5):     #
# skos:relatedMatch to an informal concept IRI (a full IRI, not a registered   #
# CURIE), NOT an equivalence. As lowerings of the canonical logic:Plan process #
# model they are commitment-shifting and lossy — preservation polarity         #
# validation-only, never exact. The recurring drops the engine surfaces impose #
# on the canonical model: a logic:Iteration loop is unrolled or rejected (most #
# DAG engines forbid cycles), a logic:ConcurrentComposition is serialized where #
# the engine has no parallel gateway, and a per-outcome logic:compensation is  #
# omitted where the engine has no compensation primitive. The structured       #
# per-correspondence residue ledger is assembled by the mappings stage into    #
# generated/logic/projection-report.                                          #
# --------------------------------------------------------------------------- #

gmeow:eqProc027 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://airflow.apache.org/concept/DAG> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Apache Airflow DAG (by reference, no canonical RDF): a procedure is a DAG of tasks. Lossy lowering — Airflow forbids cycles (a logic:Iteration loop must unroll or error) and has no per-outcome compensation (omitted)." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc028 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ProcedureStep ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://airflow.apache.org/concept/Task> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Apache Airflow Task (by reference): a procedure step is an Airflow task node in the DAG." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc029 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://w3id.org/cwl/cwl#Workflow> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Common Workflow Language Workflow (by reference, no stable RDF term IRIs): a procedure is a CWL workflow. Lossy — CWL is acyclic dataflow (a logic:Iteration loop must unroll) and carries no compensation (omitted)." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc030 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ProcedureStep ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://w3id.org/cwl/cwl#WorkflowStep> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Common Workflow Language WorkflowStep (by reference): a procedure step is a CWL workflow step." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc031 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://openwdl.org/concept/Workflow> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Workflow Description Language (WDL) workflow (by reference, no canonical RDF): a procedure is a WDL workflow of calls. Lossy lowering of the canonical plan." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc032 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ProcedureStep ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://openwdl.org/concept/Task> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Workflow Description Language (WDL) task (by reference): a procedure step is a WDL task." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc033 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://temporal.io/concept/Workflow> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "Temporal Workflow (by reference, no canonical RDF): a procedure is a Temporal workflow definition. Temporal DOES express loops and compensation (saga) imperatively, so the lowering is closer for control flow but is a code surface, not a declarative spec — carried by reference only." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc034 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ProcedureStep ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://temporal.io/concept/Activity> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "Temporal Activity (by reference): a procedure step is a Temporal activity invoked by the workflow." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc035 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://www.nextflow.io/concept/Workflow> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Nextflow workflow (by reference, no canonical RDF): a procedure is a Nextflow dataflow workflow of processes. Lossy — Nextflow concurrency is channel-implicit (a logic:ConcurrentComposition serializes in the spec view) and there is no compensation primitive (omitted)." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc036 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ProcedureStep ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject <https://www.nextflow.io/concept/Process> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Nextflow process (by reference): a procedure step is a Nextflow process node consuming/producing channels." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .
