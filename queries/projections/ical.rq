# Projection: GMEOW → pure ical. GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: the event's full open type vocabulary collapses to one human-readable SUMMARY label; role / period / confidence / standpoint of the participation are dropped; the participant becomes a bare ATTENDEE.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ical: <http://www.w3.org/2002/12/cal/icaltzd#>

CONSTRUCT {
    ?event a ical:Vevent .
    ?event ical:dtstart ?start .
    ?event ical:dtend ?end .
    ?event ical:location ?loc .
    ?event ical:summary ?summary .
    ?event ical:attendee ?att .
}
WHERE {
    {
        ?event gmeow:eventInterval ?iv .
        OPTIONAL { ?iv gmeow:startedAtTime ?start . }
        OPTIONAL { ?iv gmeow:endedAtTime ?end . }
        OPTIONAL { ?event gmeow:eventLocation ?loc . }
    }
    UNION {
        ?event gmeow:eventTime ?start .
        OPTIONAL { ?event gmeow:eventLocation ?loc . }
    }
    UNION {
        ?event gmeow:earliestStart ?start .
        OPTIONAL { ?event gmeow:latestEnd ?end . }
    }
    UNION {
        ?event gmeow:eventType ?et .
        ?et rdfs:label ?summary .
    }
    UNION {
        ?event gmeow:hasParticipant ?att .
    }
}
