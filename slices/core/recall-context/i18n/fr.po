msgstr "Une position slotState sélectionnée appartient à cette même case continue."

msgctxt "https://blackcatinformatics.ca/gmeow/SlotPositionBelongsToItsSlotConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "The declared records are checked against gmeow:SlotPositionBelongsToItsSlotConstraint."
msgstr "Les relevés déclarés sont examinés selon gmeow:SlotPositionBelongsToItsSlotConstraint."

msgctxt "https://blackcatinformatics.ca/gmeow/BudgetShareBoundsConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating BudgetShareBoundsConstraint as a runtime certificate."
msgstr "Éviter de traiter BudgetShareBoundsConstraint comme certificat d’exécution."

msgctxt "https://blackcatinformatics.ca/gmeow/BudgetShareBoundsConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Apply BudgetShareBoundsConstraint to actual records while retaining independent obligations."
msgstr "Appliquer BudgetShareBoundsConstraint aux relevés réels en conservant les obligations indépendantes."

msgctxt "https://blackcatinformatics.ca/gmeow/BudgetShareBoundsConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve budget share bounds law."
msgstr "Utiliser pour préserver loi des bornes de part budgétaire."

msgctxt "https://blackcatinformatics.ca/gmeow/BudgetShareBoundsConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "budget share bounds law"
msgstr "loi des bornes de part budgétaire"

msgctxt "https://blackcatinformatics.ca/gmeow/BudgetShareBoundsConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "Every supplied share is greater than zero and at most one; the separate plan-total law still applies."
msgstr "Toute part fournie est supérieure à zéro et au plus égale à un ; la loi distincte du total reste applicable."

msgctxt "https://blackcatinformatics.ca/gmeow/BudgetShareBoundsConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "The record is governed by gmeow:BudgetShareBoundsConstraint."
msgstr "Le relevé est régi par gmeow:BudgetShareBoundsConstraint."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallRankReifierCompletenessConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating RecallRankReifierCompletenessConstraint as a runtime certificate."
msgstr "Éviter de traiter RecallRankReifierCompletenessConstraint comme certificat d’exécution."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallRankReifierCompletenessConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Apply RecallRankReifierCompletenessConstraint to actual records while retaining independent obligations."
msgstr "Appliquer RecallRankReifierCompletenessConstraint aux relevés réels en conservant les obligations indépendantes."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallRankReifierCompletenessConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve recall rank reifier completeness constraint."
msgstr "Utiliser pour préserver contrainte de complétude du réificateur de rang."

msgctxt "https://blackcatinformatics.ca/gmeow/RecallRankReifierCompletenessConstraint|http://www.w3.org/2000/01/rdf-schema#label"
