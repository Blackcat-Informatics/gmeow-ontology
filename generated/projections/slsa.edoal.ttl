@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/slsa>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:BuildActivity ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri <https://slsa.dev/provenance/v1#Provenance> ;
        ] ;
        align:relation "<=" ;
        rdfs:label "BuildActivity → slsa:Provenance"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasSLSALevel ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri <https://slsa.dev/provenance/v1#buildLevel> ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.7"^^xsd:double ;
            rdfs:label "hasSLSALevel → slsa:buildLevel"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "slsa" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → slsa (EDOAL)"@en .
