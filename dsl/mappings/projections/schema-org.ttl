        gmeow:edoalSource gmeow:ContactPoint ; gmeow:edoalSourceKind "class" ] ;
    gmeow:hasBinding [ gmeow:profile "schema-org" ; gmeow:toClass schema:ContactPoint ; gmeow:relation "<=" ; gmeow:confidence 0.9 ] .

# EXIF tags → schema:exifData. The reified gmeow:ExifTag node
# IS the schema:PropertyValue bundle, so it is REUSED (no mint): propertyID ←
# exifTagId, value ← exifTagValue, name ← rdfs:label. Every tag round-trips.
gmeow:mapSchemaExifData a gmeow:ProjectionMapping ;
    rdfs:label "ExifTag → schema:exifData schema:PropertyValue"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "exImg" ;
        gmeow:atom (
            [ gmeow:subjectVar "exImg" ; gmeow:predicate gmeow:hasExifTag ; gmeow:objectVar "exTag" ]
            [ gmeow:subjectVar "exTag" ; gmeow:predicate gmeow:exifTagId ; gmeow:objectVar "exId" ]
            [ gmeow:subjectVar "exTag" ; gmeow:predicate gmeow:exifTagValue ; gmeow:objectVar "exVal" ]
            [ gmeow:optionalGroup ( [ gmeow:subjectVar "exTag" ; gmeow:predicate rdfs:label ; gmeow:objectVar "exName" ] ) ] ) ;
        gmeow:edoalSource gmeow:hasExifTag ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.95 ;
        gmeow:lossyDrop "none for the tag triple — propertyID/value/name carry the full EXIF tag; the gmeow:ExifTag node is reused as the PropertyValue" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "exImg" ; gmeow:tPred schema:exifData ; gmeow:tObj "exTag" ]
            [ gmeow:tSubj "exTag" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:PropertyValue ]
            [ gmeow:tSubj "exTag" ; gmeow:tPred schema:propertyID ; gmeow:tObj "exId" ]
            [ gmeow:tSubj "exTag" ; gmeow:tPred schema:value ; gmeow:tObj "exVal" ]
            [ gmeow:tSubj "exTag" ; gmeow:tPred schema:name ; gmeow:tObj "exName" ] ) ] .

# Contact affordances: that an agent CAN be reached via a contact point
# is a fact derivable from the point itself — a schema:CommunicateAction whose
# target is the mailto:/tel: URI built from the contact value. The action's
# editorial NAME ("Email general inquiries") is site UI copy, not derived
# (translators emit what is there, never fabricate). A minted action node per
# (agent, channel) keeps them distinct.
gmeow:mapSchemaCommunicateEmail a gmeow:ProjectionMapping ;
    rdfs:label "agent email → schema:CommunicateAction (mailto: target)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ceAgent" ; gmeow:value "ceEmail" ;
        gmeow:atom ( [ gmeow:subjectVar "ceAgent" ; gmeow:predicate gmeow:email ; gmeow:objectVar "ceEmail" ] ) ;
        # the minted action IRI carries the ENCODE_FOR_URI'd address so an
        # agent with several emails mints DISTINCT actions, never one merged
        gmeow:mint [ gmeow:bindVar "ceAction" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "ceAgent" ] ) ]
                    "-communicate-email-"
                    [ gmeow:exprOp gmeow:opEncodeForUri ; gmeow:exprArgs (
                        [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "ceEmail" ] ) ] ) ] ) ] ) ] ] ;
        # the mailto: target is an IRI resource, not a string literal
        gmeow:mint [ gmeow:bindVar "ceTarget" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    "mailto:" [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "ceEmail" ] ) ] ) ] ) ] ] ;
        gmeow:edoalSource gmeow:email ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the affordance's editorial name/label is site UI copy and is NOT fabricated; only the structural CommunicateAction + mailto: target derive" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "ceAgent" ; gmeow:tPred schema:potentialAction ; gmeow:tObj "ceAction" ]
            [ gmeow:tSubj "ceAction" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:CommunicateAction ]
            [ gmeow:tSubj "ceAction" ; gmeow:tPred schema:target ; gmeow:tObj "ceTarget" ] ) ] .

gmeow:mapSchemaCommunicatePhone a gmeow:ProjectionMapping ;
    rdfs:label "agent telephone → schema:CommunicateAction (tel: target)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "cpAgent" ; gmeow:value "cpPhone" ;
        gmeow:atom ( [ gmeow:subjectVar "cpAgent" ; gmeow:predicate gmeow:telephone ; gmeow:objectVar "cpPhone" ] ) ;
        # the minted action IRI carries the ENCODE_FOR_URI'd number so an
        # agent with several phones mints DISTINCT actions, never one merged
        gmeow:mint [ gmeow:bindVar "cpAction" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "cpAgent" ] ) ]
                    "-communicate-phone-"
                    [ gmeow:exprOp gmeow:opEncodeForUri ; gmeow:exprArgs (
                        [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "cpPhone" ] ) ] ) ] ) ] ) ] ] ;
        # the tel: target is an IRI resource, not a string literal
        gmeow:mint [ gmeow:bindVar "cpTarget" ; gmeow:bindExpr
            [ gmeow:exprOp gmeow:opIri ; gmeow:exprArgs (
                [ gmeow:exprOp gmeow:opConcat ; gmeow:exprArgs (
                    "tel:" [ gmeow:exprOp gmeow:opStr ; gmeow:exprArgs ( [ gmeow:exprVar "cpPhone" ] ) ] ) ] ) ] ] ;
        gmeow:edoalSource gmeow:telephone ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:relation "<=" ; gmeow:confidence 0.85 ;
        gmeow:lossyDrop "the affordance's editorial name is site UI copy and is NOT fabricated; only the structural CommunicateAction + tel: target derive" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "cpAgent" ; gmeow:tPred schema:potentialAction ; gmeow:tObj "cpAction" ]
            [ gmeow:tSubj "cpAction" ; gmeow:tPred rdf:type ; gmeow:tObjValue schema:CommunicateAction ]
            [ gmeow:tSubj "cpAction" ; gmeow:tPred schema:target ; gmeow:tObj "cpTarget" ] ) ] .
