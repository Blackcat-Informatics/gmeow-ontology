# --- 5a. sexAssignedAtBirth is an ObjectProperty with range SexAssignedAtBirth (MUST)
ex:saSexAssignedAtBirthShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:sexAssignedAtBirth a owl:ObjectProperty ;
        rdfs:range gmeow:SexAssignedAtBirth .
}""" ;
    gmeow:saRationale "gmeow:sexAssignedAtBirth MUST be an owl:ObjectProperty with range gmeow:SexAssignedAtBirth — a recorded administrative datum, not a facet. Mirrors test_sex_assigned_at_birth_is_recorded_not_a_facet (positive half)." .

# --- 5b. sexAssignedAtBirth is NOT a sub-property of hasGenderIdentity (MUST-NOT)
ex:saSexAssignedAtBirthNotSubpropIdentity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:sexAssignedAtBirth rdfs:subPropertyOf gmeow:hasGenderIdentity . }""" ;
    gmeow:saRationale "gmeow:sexAssignedAtBirth MUST NOT be a sub-property of gmeow:hasGenderIdentity — it is a recorded datum, NOT an identity facet. Mirrors test_sex_assigned_at_birth_is_recorded_not_a_facet (not-an-identity-facet guard)." .

# --- 5c. The old flat gmeow:sex DatatypeProperty is GONE (MUST-NOT) ---------
ex:saNoFlatSexDatatypeProperty a gmeow:StructuralAssertion ;
