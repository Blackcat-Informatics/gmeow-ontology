#
# Declarative structural assertions for the deception slice (#213, EPIC #212) --
# the slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT
# invariants formerly hand-written in tests/test_deception.py. Each assertion
# runs as a SPARQL ASK over the deception module graph (gmeow:scopeModule)
# under the native Rust harness (crates/slicetest).
#
# Deception is NOT #694-migrated: class stereotypes remain gufo:
# (gufo:AbstractIndividualType, gufo:QualityValue), not logic:.
#
# RETAINED in pytest (not migratable here):
#   test_blame_deflection_example_uses_doxastic_standpoint_claims --
#     loads slices/core/deception/examples/blame-deflection.ttl and checks
#     that every held/projected standpoint is typed DoxasticStandpointClaim;
#     dynamic ABox file-load check, not a module-scoped TBox assertion.
#   test_bullshit_modality_exists --
#     gmeow:bullshit is a SUBJECT of slices/core/standpoint/module.ttl, not
#     the deception module; a scopeModule cell would silently miss it.
#   test_standpoint_divergence_coexists -- run_shacl(); ExampleConformance.
#   test_deception_event_shacl_passes -- run_shacl(); ExampleConformance.
#   test_deception_cue_shacl_passes -- run_shacl(); ExampleConformance.
#   test_paltering_implicates_structure -- run_shacl(); ExampleConformance.
#   test_self_deception_same_agent -- run_shacl(); ExampleConformance.
#   test_distortion_shacl_passes -- run_shacl(); ExampleConformance.
#   test_licensed_falsehood_not_a_lie -- run_shacl() + NarrativeReferenceFrame
#     check (cross-slice subject); ExampleConformance + cross-slice guard.
#   test_fabrication_refuted_provenance -- run_shacl(); ExampleConformance.
#   test_forgery_failed_signature_structure -- run_shacl(); ExampleConformance.
#   test_impersonation_facet_subject_mismatch -- run_shacl(); ExampleConformance.
#   test_disinformation_propagation_chain -- run_shacl(); ExampleConformance.
#   test_disinformation_boundary_query -- reads competency .rq file and
#     asserts result labels; generated-artifact / SPARQL-result check, not
#     expressible as a module-scoped ASK.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest->DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/deception/tests/> .

# --- 1. eventTypeDeception is an EventType individual (MUST) ------------------
ex:saDeceptionEventTypeExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:eventTypeDeception a gmeow:EventType . }""" ;
    gmeow:saRationale "gmeow:eventTypeDeception MUST exist as a gmeow:EventType individual -- deception-kind is an open value vocabulary, never a subclass (events.ttl doctrine). Mirrors test_deception_event_type_exists." .

# --- 2. heldStandpoint is an ObjectProperty with domain Event and range
#        DoxasticStandpointClaim (MUST) ----------------------------------------
ex:saHeldStandpointProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:heldStandpoint a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:DoxasticStandpointClaim .
}""" ;
    gmeow:saRationale "gmeow:heldStandpoint MUST be an owl:ObjectProperty with domain gmeow:Event and range gmeow:DoxasticStandpointClaim -- the private-belief half of the held!=projected deception divergence. Mirrors test_divergence_properties_exist (heldStandpoint part)." .

# --- 3. projectedStandpoint is an ObjectProperty with domain Event and range
#        DoxasticStandpointClaim (MUST) ----------------------------------------
ex:saProjectedStandpointProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:projectedStandpoint a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:DoxasticStandpointClaim .
}""" ;
    gmeow:saRationale "gmeow:projectedStandpoint MUST be an owl:ObjectProperty with domain gmeow:Event and range gmeow:DoxasticStandpointClaim -- the communicated-position half of the held!=projected deception divergence. Mirrors test_divergence_properties_exist (projectedStandpoint part)." .

# --- 4. deceptiveIntentClaim property shape (MUST) ----------------------------
ex:saDeceptiveIntentClaimProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:deceptiveIntentClaim a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:StandpointClaim .
}""" ;
    gmeow:saRationale "gmeow:deceptiveIntentClaim MUST be an owl:ObjectProperty with domain gmeow:Event and range gmeow:StandpointClaim -- intent is a defeasible, attributed standpoint claim, never an entailed boolean (Principle 9). Mirrors test_deceptive_intent_claim_property_exists." .

# --- 5. implicates property shape (MUST) --------------------------------------
ex:saImplicatesProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:implicates a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:implicates MUST be an owl:ObjectProperty with domain gmeow:Event and range gmeow:Entity -- the paltering hook; implicature computation is solver-layer (Principle 12). Mirrors test_implicates_property_exists." .

# --- 6. deceptionCue property shape (MUST) ------------------------------------
ex:saDeceptionCueProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:deceptionCue a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:Observation .
}""" ;
    gmeow:saRationale "gmeow:deceptionCue MUST be an owl:ObjectProperty with domain gmeow:Event and range gmeow:Observation -- each cue carries its own vantage and method rather than being a bare fact. Mirrors test_deception_cue_property_exists." .

# --- 7. The four core deception roles exist as ParticipantRole individuals
#        (MUST) ----------------------------------------------------------------
ex:saDeceptionRolesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:roleDeceiver                a gmeow:ParticipantRole .
    gmeow:roleDeceived                a gmeow:ParticipantRole .
    gmeow:roleBeneficiaryOfDeception  a gmeow:ParticipantRole .
    gmeow:roleDupe                    a gmeow:ParticipantRole .
}""" ;
    gmeow:saRationale "The four core deception roles (deceiver, deceived, beneficiary, dupe) MUST exist as gmeow:ParticipantRole individuals -- they cover the principal positions in any deception event. Mirrors test_deception_roles_exist." .

# --- 8. ClaimVeridicality is a gufo:AbstractIndividualType value vocabulary
#        subclassing gufo:QualityValue (MUST) -----------------------------------
ex:saClaimVeridicalityClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ClaimVeridicality a owl:Class , gufo:AbstractIndividualType ;
        rdfs:subClassOf gufo:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:ClaimVeridicality MUST be an owl:Class typed gufo:AbstractIndividualType and a subclass of gufo:QualityValue -- veridicality is an open value vocabulary of individuals, never subclasses (Principle 9). Mirrors test_veridicality_values_exist (class structure part)." .

# --- 9. The two required ClaimVeridicality seed individuals exist (MUST) ------
ex:saClaimVeridicalitySeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:veridicalityUntrue           a gmeow:ClaimVeridicality .
    gmeow:veridicalityLicensedFalsehood a gmeow:ClaimVeridicality .
}""" ;
    gmeow:saRationale "Both seed individuals (veridicalityUntrue, veridicalityLicensedFalsehood) MUST exist as gmeow:ClaimVeridicality instances -- they anchor the licensed-falsehood safety property that separates fiction from deception. Mirrors test_veridicality_values_exist (individual seeds part)." .

# --- 10. attestationTypeFactCheck exists as an AttestationType (MUST) ---------
ex:saAttestationTypeFactCheck a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:attestationTypeFactCheck a gmeow:AttestationType . }""" ;
    gmeow:saRationale "gmeow:attestationTypeFactCheck MUST exist as a gmeow:AttestationType individual -- models the schema.org ClaimReview act (result is a VerificationResult, never a global truth assertion; Principle 12). Mirrors test_attestation_type_fact_check_exists." .

# --- 11. No isFalse property declared as ObjectProperty (MUST-NOT) -----------
ex:saNoIsFalseObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:isFalse a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:isFalse MUST NOT be declared an owl:ObjectProperty -- a falsehood is a refuted StandpointClaim modality, never a boolean flag (Principles 1, 12; no-isFalse doctrine). Mirrors test_no_is_false_axiom (isFalse ObjectProperty part)." .

