gmeow:eventTypeConfirmation rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/events> .
gmeow:eventTypeBarMitzvah     a gmeow:EventType ; rdfs:label "bar mitzvah"@x-gmeow-english ;    skos:definition "A bar mitzvah."@x-gmeow-english .
gmeow:eventTypeBarMitzvah rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/events> .
