#
# Declarative structural assertions for the observations slice — the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_observations.py. Each runs as a SPARQL ASK
# over the observations module graph (gmeow:scopeModule) under the native Rust
# slicetest harness. Observation is migrated (logic:Relator, not gufo:).
#
# The OWL-RL ENTAILMENT tests were migrated to crates/logic/tests/ontology_entailments.rs
# The SOSA/AFO *_mapped_to_* fns read GENERATED mapping artifacts (not the
# module graph) and are KEPT in pytest (doctrine-guard, generated-artifact reads).
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/observations/tests/> .

# --- 1. Observation is a logic:Relator class (MUST) --------------------------
ex:saObservationClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:Observation a owl:Class ; rdfs:subClassOf logic:Relator . }""" ;
    gmeow:saRationale "gmeow:Observation MUST be an owl:Class and a subclass of logic:Relator (the gufo→logic migration)." .

# --- 2. The seven core observation object properties exist (MUST) ------------
ex:saObservationProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:observedFeature a owl:ObjectProperty . gmeow:observationResult a owl:ObjectProperty .
    gmeow:isResultOf a owl:ObjectProperty . gmeow:vantage a owl:ObjectProperty .
    gmeow:observationMethod a owl:ObjectProperty . gmeow:observationType a owl:ObjectProperty .
    gmeow:observationEvent a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "All seven core observation roles MUST be owl:ObjectProperty." .

ex:saObservationResultBroadNonFunctionalCarrier a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:observationResult a owl:ObjectProperty ;
        rdfs:domain gmeow:Observation ;
        rdfs:range logic:Individual .
    gmeow:isResultOf rdfs:domain logic:Individual .
    FILTER NOT EXISTS { ?rec logic:characterizes gmeow:observationResult ; logic:characteristicSort logic:functionalProperty }
}""" ;
    gmeow:saRationale "Observation results span concrete entities and abstract values, so the carrier ranges over logic:Individual and is non-functional: multiple frame- or standpoint-indexed results coexist." .

# --- 3. The observation value-vocabulary classes exist (MUST) ----------------
ex:saObservationValueVocabularies a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:ObservationMethod a owl:Class . gmeow:ObservationType a owl:Class .
    gmeow:Measurement a owl:Class . gmeow:SensoryObservation a owl:Class .
    gmeow:StandpointClaim a owl:Class .
}""" ;
    gmeow:saRationale "The observation-owned value-vocabulary classes MUST exist as owl:Class; the quantity authority is imported from math: rather than redeclared here." .

# --- 4. The nine ObservationType seeds exist (MUST) --------------------------
ex:saObservationTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:observationTypeMeasurement a gmeow:ObservationType . gmeow:observationTypeSensory a gmeow:ObservationType .
    gmeow:observationTypeStandpoint a gmeow:ObservationType . gmeow:observationTypeDerived a gmeow:ObservationType .
    gmeow:observationTypeSimulation a gmeow:ObservationType . gmeow:observationTypeIdentity a gmeow:ObservationType .
    gmeow:observationTypeNaming a gmeow:ObservationType . gmeow:observationTypeRights a gmeow:ObservationType .
    gmeow:observationTypeKinship a gmeow:ObservationType .
}""" ;
    gmeow:saRationale "All nine seeded ObservationType individuals MUST exist." .

# --- 5. The six ObservationMethod seeds exist (MUST) ------------------------
ex:saObservationMethodSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:methodDirectObservation a gmeow:ObservationMethod . gmeow:methodInstrumentalReading a gmeow:ObservationMethod .
    gmeow:methodSurvey a gmeow:ObservationMethod . gmeow:methodRemoteSensing a gmeow:ObservationMethod .
    gmeow:methodComputationalModel a gmeow:ObservationMethod . gmeow:methodExpertJudgement a gmeow:ObservationMethod .
}""" ;
    gmeow:saRationale "All six seeded ObservationMethod individuals MUST exist." .

# --- 6. Observation uncertainty qualifies the math-owned quantity (MUST) ----
ex:saQuantityUncertaintyGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX math: <https://blackcatinformatics.ca/math/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:quantityUncertainty a owl:DatatypeProperty ;
        rdfs:domain math:Quantity .
}""" ;
    gmeow:saRationale "Observations owns only the uncertainty qualifier; its domain is the sole math:Quantity authority." .

# --- 7. The universal-claim-construct sub-property bridges fire (MUST) -------
ex:saPropertyBridges a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:usageNamer rdfs:subPropertyOf gmeow:vantage .
    gmeow:usageNamed rdfs:subPropertyOf gmeow:observedFeature .
    gmeow:usageAppellation rdfs:subPropertyOf gmeow:observationResult .
    gmeow:statementAbout rdfs:subPropertyOf gmeow:observedFeature .
    gmeow:facetSubject rdfs:subPropertyOf gmeow:observedFeature .
    gmeow:facetVantage rdfs:subPropertyOf gmeow:vantage .
    gmeow:versionMember rdfs:subPropertyOf gmeow:observedFeature .
    gmeow:membershipAuthority rdfs:subPropertyOf gmeow:vantage .
}""" ;
    gmeow:saRationale "The observations-module-local domain sub-property bridges expose NameUsage/RightsStatement/IdentityFacet/VersionMembership roles as observation roles." .

# --- 8. Retired observation-local quantity aliases stay absent (MUST NOT) ---
ex:saRetiredQuantityAliasesAbsent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    VALUES ?legacy { gmeow:Quantity gmeow:ScalarQuantity gmeow:MeasuredValue gmeow:quantityValue }
    { ?legacy ?predicate ?object }
    UNION { ?subject ?legacy ?object }
    UNION { ?subject ?predicate ?legacy }
}""" ;
    gmeow:saRationale "The observation-local Quantity, ScalarQuantity, MeasuredValue, and quantityValue authorities are retired; consumers use math:Quantity and math:quantityValue." .

# --- 10. isResultOf is the inverse of observationResult (MUST) --------------
ex:saIsResultOfInverseObservationResult a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:isResultOf owl:inverseOf gmeow:observationResult . }""" ;
    gmeow:saRationale "gmeow:isResultOf MUST be owl:inverseOf gmeow:observationResult." .

# --- 11. Stream class (MUST) ------------------------------------------------
ex:saStreamClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:Stream a owl:Class ; rdfs:subClassOf gmeow:Entity . }""" ;
    gmeow:saRationale "gmeow:Stream MUST be an owl:Class subclass of gmeow:Entity." .

# --- 12. Stream object properties exist (MUST) ------------------------------
ex:saStreamProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:streamOf a owl:ObjectProperty . gmeow:hasStream a owl:ObjectProperty .
    gmeow:streamSample a owl:ObjectProperty . gmeow:streamPlatform a owl:ObjectProperty .
    gmeow:streamSensor a owl:ObjectProperty . gmeow:streamInterval a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "The six Stream object properties MUST exist." .

# --- 13. streamOf has Stream domain / Entity range (MUST) ----
ex:saStreamOfFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:streamOf rdfs:domain gmeow:Stream ; rdfs:range gmeow:Entity . }""" ;
    gmeow:saRationale "gmeow:streamOf MUST have domain Stream and range Entity; its single-value functionality now lives on the logic: PropertyCharacteristicAssertion carrier and is DL-enforced." .

# --- 14. hasStream is the inverse of streamOf (MUST) ------------------------
ex:saHasStreamInverseStreamOf a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasStream owl:inverseOf gmeow:streamOf . }""" ;
    gmeow:saRationale "gmeow:hasStream MUST be owl:inverseOf gmeow:streamOf." .

# --- 15a. streamSample shape (MUST) ----------------------------------------
ex:saStreamSampleShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:streamSample a owl:ObjectProperty ; rdfs:domain gmeow:Stream ; rdfs:range gmeow:Entity . }""" ;
    gmeow:saRationale "gmeow:streamSample MUST be an owl:ObjectProperty with domain Stream and range Entity." .

# --- 15b. streamSample is NOT functional (MUST-NOT) ------------------------
ex:saStreamSampleNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?fpRec logic:characterizes gmeow:streamSample ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:streamSample MUST NOT be functional (a stream has many samples)." .

# --- 16a. streamPlatform shape (MUST) --------------------------------------
ex:saStreamPlatformShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:streamPlatform a owl:ObjectProperty ; rdfs:range gmeow:Agent . }""" ;
    gmeow:saRationale "gmeow:streamPlatform MUST be an owl:ObjectProperty with range Agent." .

# --- 16b. streamPlatform is NOT functional (MUST-NOT) ----------------------
ex:saStreamPlatformNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?fpRec logic:characterizes gmeow:streamPlatform ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:streamPlatform MUST NOT be functional." .

# --- 17a. streamSensor shape (MUST) ----------------------------------------
ex:saStreamSensorShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:streamSensor a owl:ObjectProperty ; rdfs:range gmeow:Agent . }""" ;
    gmeow:saRationale "gmeow:streamSensor MUST be an owl:ObjectProperty with range Agent." .

# --- 17b. streamSensor is NOT functional (MUST-NOT) ------------------------
ex:saStreamSensorNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?fpRec logic:characterizes gmeow:streamSensor ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:streamSensor MUST NOT be functional." .

# --- 18. streamInterval has Stream domain / TimeInterval range (MUST) ---
ex:saStreamIntervalFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:streamInterval rdfs:domain gmeow:Stream ; rdfs:range gmeow:TimeInterval . }""" ;
    gmeow:saRationale "gmeow:streamInterval MUST have domain Stream and range TimeInterval; its single-value functionality now lives on the logic: PropertyCharacteristicAssertion carrier and is DL-enforced." .

# --- 19. The streaming ObservationType seed exists (MUST) ------------------
ex:saStreamingObservationType a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:observationTypeStreaming a gmeow:ObservationType . }""" ;
    gmeow:saRationale "gmeow:observationTypeStreaming MUST exist as an ObservationType." .

# --- 20. The streaming ObservationMethod seed exists (MUST) ----------------
ex:saStreamingMethod a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:methodStreaming a gmeow:ObservationMethod . }""" ;
    gmeow:saRationale "gmeow:methodStreaming MUST exist as an ObservationMethod." .

# --- 21. YAMATO quality stratification grounded in the observation spine (MUST) -
ex:saQualityStratificationGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX math: <https://blackcatinformatics.ca/math/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Quality a owl:Class ; rdfs:subClassOf logic:Quality .
    gmeow:Magnitude a owl:Class .
    gmeow:GenericQuality a owl:Class .
    gmeow:bearer a owl:ObjectProperty .
    gmeow:observationOf a owl:ObjectProperty ; rdfs:subPropertyOf gmeow:observedFeature .
    gmeow:observedAt a owl:DatatypeProperty .
    gmeow:dimension a owl:ObjectProperty .
    gmeow:trueQuantity rdfs:subPropertyOf logic:trueQuantity .
    gmeow:unit rdfs:subPropertyOf logic:unit .
    gmeow:hasReferenceFrame rdfs:subPropertyOf logic:referenceFrame .
    gmeow:UnitBearingQuantityValueConstraint a logic:GuardedImplicationConstraint ;
        logic:onClass math:Quantity ;
        logic:trigger gmeow:unit ;
        logic:requires math:quantityValue .
    gmeow:pressure a gmeow:GenericQuality .
}""" ;
    gmeow:saRationale "The YAMATO quality stratification MUST be grounded in the observation spine: the persistent gmeow:Quality borne by its bearer, dated readings attached through observationOf, the frame-independent Magnitude, and the trueQuantity/unit/referenceFrame seams lifted into logic:. The guarded constraint requires a numeric value only when a math:Quantity bears a unit; the generic math:quantityValue remains usable for abstract values and declared rates without becoming globally measurement-relative." .

# --- 22. Condition is an InformationObject (MUST) ---------------------------
# gmeow:Condition was promoted here from the norms extension (Principle 16): a
# foundational evaluative primitive several non-norms slices genuinely need.
ex:saConditionIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Condition rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:Condition MUST be a subclass of gmeow:InformationObject — conditions are stored information objects, never entailed (Principle 12). The norms-resident gmeow:ConditionGroup specializes it (checked in the norms module)." .

# --- 23. Criterion is an InformationObject (MUST) ---------------------------
ex:saCriterionIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Criterion rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:Criterion MUST be a subclass of gmeow:InformationObject — one evaluative axis of a rubric, with named poles (gmeow:rewardPole / gmeow:penaltyPole, checked in the norms module where gmeow:CriterionPole lives)." .

# --- 24. Rubric is a logic:Kind SocialObject for judging (MUST) -------------
# The norms extension additionally declares gmeow:Rubric rdfs:subClassOf
# gmeow:Norm — a norms->observations bridge axiom authored there (Principle 16).
ex:saRubricIsSocialObjectForJudging a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Rubric a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:SocialObject .
}""" ;
    gmeow:saRationale "gmeow:Rubric MUST be a logic:Kind social object for judging — a reified evaluation framework whose criteria, poles, scales, and anchors are first-class content." .

# --- 25. Assessment is a vantage-indexed observation (MUST / MUST-NOT) ------
ex:saAssessmentIsVantageIndexedObservation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:Assessment rdfs:subClassOf gmeow:Observation .
    gmeow:assessmentTarget rdfs:subPropertyOf gmeow:observedFeature .
    gmeow:assessmentScoreValue a owl:DatatypeProperty .
    FILTER NOT EXISTS { gmeow:assessmentCriterion rdfs:subPropertyOf gmeow:observationMethod }
    FILTER NOT EXISTS { gmeow:assessmentRubric rdfs:subPropertyOf gmeow:observationMethod }
}""" ;
    gmeow:saRationale "gmeow:Assessment MUST subclass gmeow:Observation; gmeow:assessmentTarget MUST specialize gmeow:observedFeature (the observation-spine bridge idiom) and gmeow:assessmentScoreValue MUST be a datatype property — the whole Assessment property cluster is core-owned here, not split across an extension; and gmeow:assessmentCriterion / gmeow:assessmentRubric MUST NOT be subproperties of gmeow:observationMethod — they play the observationMethod ROLE without the subproperty axiom (the claimModality pattern, since Criterion and Rubric are Entities, not QualityValues)." .

# --- 26. Three EvaluationVerdict seeds exist (MUST) -------------------------
ex:saEvaluationVerdictSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:verdictHeld         a gmeow:EvaluationVerdict .
    gmeow:verdictNotHeld      a gmeow:EvaluationVerdict .
    gmeow:verdictUndetermined a gmeow:EvaluationVerdict .
}""" ;
    gmeow:saRationale "The three EvaluationVerdict seed individuals (held, not held, undetermined) MUST exist — they form the closed trichotomy for condition evaluation outcomes, reused by both gmeow:evaluationVerdict and gmeow:complianceVerdict (norms)." .

# --- 27. No fourth EvaluationVerdict individual exists (MUST-NOT) ----------
ex:saNoExtraEvaluationVerdict a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?x a gmeow:EvaluationVerdict .
    FILTER (?x NOT IN (gmeow:verdictHeld, gmeow:verdictNotHeld, gmeow:verdictUndetermined))
}""" ;
    gmeow:saRationale "No fourth gmeow:EvaluationVerdict individual MUST NOT exist — the held/not-held/undetermined trichotomy is closed by design (a fourth verdict would violate the semantics)." .
