# Projection: GMEOW → vCard-RDF (the W3C vcard namespace, decomposed — not the
# single-line VCARD text format). Executable form of projections/vcard.edoal.ttl.
# Address components → vcard:Address (+ a composed vcard:label); displayable full
# name → vcard:fn; given/family parts → a vcard:Name node (their correct domain).
# Lossy drops: nested Place hierarchy + QIDs, placeType granularity, geometry,
# NameUsage/register/purpose, non-displayable names, StorageLocation.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX vcard: <http://www.w3.org/2006/vcard/ns#>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?holder vcard:hasAddress ?addr .
    ?addr a vcard:Address ;
        vcard:street-address ?street ; vcard:locality ?locality ;
        vcard:region ?region ; vcard:postal-code ?pcode ;
        vcard:country-name ?ccode ; vcard:label ?label .
    ?ent vcard:fn ?dispName .
    ?ent vcard:hasName ?vname .
    ?vname a vcard:Name ; vcard:given-name ?given ; vcard:family-name ?family .
    ?ent vcard:nickname ?nick .
    ?ent vcard:bday ?bdate .
    ?ent vcard:title ?title .
    ?ent vcard:note ?desc .
    ?ent vcard:hasURL ?wp .
}
WHERE {
    {
        ?holder gmeow:hasContactPoint ?addr .
        ?addr a gmeow:PostalAddress .
        OPTIONAL { ?addr gmeow:streetAddress ?street . }
        OPTIONAL { ?addr gmeow:addressLocality ?locality . }
        OPTIONAL { ?addr gmeow:addressRegion ?region . }
        OPTIONAL { ?addr gmeow:postalCode ?pcode . }
        OPTIONAL { ?addr gmeow:countryCode ?ccode . }
        # fnComposeAddress: a single-line vcard:label from the components.
        BIND ( CONCAT(
            COALESCE(?street, ""), ", ", COALESCE(?locality, ""), " ",
            COALESCE(?region, ""), " ", COALESCE(?pcode, ""), " ",
            COALESCE(?ccode, "") ) AS ?label )
    } UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName ?app .
        ?app gmeow:fullName ?dispName .
        FILTER NOT EXISTS { ?app gmeow:displayable false }
    } UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName ?app .
        ?app gmeow:hasNamePart ?np .
        ?np gmeow:namePartType gmeow:namePartGiven ; gmeow:partText ?given .
        BIND ( IRI(CONCAT(STR(?ent), "-vcardname")) AS ?vname )
    } UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName ?app .
        ?app gmeow:hasNamePart ?np .
        ?np gmeow:namePartType gmeow:namePartSurname ; gmeow:partText ?family .
        BIND ( IRI(CONCAT(STR(?ent), "-vcardname")) AS ?vname )
    } UNION {
        # Standard vCard fields downcast from structured GMEOW models: NICKNAME from
        # a nickname-purpose PersonName, BDAY from a Birth event, TITLE from a
        # Membership Role, NOTE from gmeow:description, URL from gmeow:hasWebPage.
        ?ent gmeow:hasName ?nn .
        ?nn gmeow:namePurpose gmeow:namePurposeNickname ; gmeow:fullName ?nick .
        FILTER NOT EXISTS { ?nn gmeow:displayable false }
    } UNION {
        ?b a gmeow:Birth ; gmeow:hasPrincipal ?ent ; gmeow:eventDate ?bdate .
    } UNION {
        ?m a gmeow:Membership ; gmeow:membershipMember ?ent ; gmeow:hasRole ?r .
        ?r rdfs:label|gmeow:name ?title .
    } UNION {
        ?ent gmeow:description ?desc .
    } UNION {
        ?ent gmeow:hasWebPage ?wp .
    }
}
