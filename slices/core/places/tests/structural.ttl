# --- 44. Vertical reference frames declared (MUST) ----------------------------
ex:saVerticalReferenceFrames a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:referenceFrameAltitudeMSL           a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial .
    gmeow:referenceFrameFlightLevel           a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial .
    gmeow:referenceFrameAltitudeAGL           a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial .
    gmeow:referenceFrameDepthBelowSeaLevel    a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial .
    gmeow:referenceFrameDepthBelowChartDatum  a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmTerrestrial .
}""" ;
    gmeow:saRationale "The five vertical reference frames MUST be declared as ReferenceFrame individuals with frameRealmTerrestrial." .

# --- 45. overlayDesignator is a DatatypeProperty on RegulatoryOverlay (MUST) --
ex:saOverlayDesignatorGrounding a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:overlayDesignator a owl:DatatypeProperty .
    gmeow:overlayDesignator rdfs:domain gmeow:RegulatoryOverlay .
    gmeow:overlayDesignator rdfs:range  rdfs:Literal .
}""" ;
    gmeow:saRationale "gmeow:overlayDesignator MUST be an owl:DatatypeProperty with domain RegulatoryOverlay and range rdfs:Literal (its functionality is now carried by a logic:PropertyCharacteristicAssertion, DL-enforced)." .

