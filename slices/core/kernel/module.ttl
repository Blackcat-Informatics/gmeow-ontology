gmeow:policyInternalOnly                   a gmeow:DisclosurePolicy ; rdfs:label "internal only"@x-gmeow-english ;                   skos:definition "The fact must never leave internal systems."@x-gmeow-english ;                   rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/kernel> .
gmeow:policySensitive                      a gmeow:DisclosurePolicy ; rdfs:label "sensitive"@x-gmeow-english ;                      skos:definition "The fact is sensitive and requires case-by-case review before any projection."@x-gmeow-english ;                      rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/kernel> .
