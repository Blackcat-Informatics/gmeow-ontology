@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/spdx>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:License ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri spdx:License ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.8"^^xsd:double ;
        rdfs:label "License → spdx:License"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:isOsiApproved ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri spdx:isOsiApproved ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "isOsiApproved → spdx:isOsiApproved"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:licenseText ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri spdx:licenseText ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "licenseText → spdx:licenseText"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:spdxLicenseId ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri spdx:licenseId ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "spdxLicenseId → spdx:licenseId"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:spdxLicenseName ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri spdx:name ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "spdxLicenseName → spdx:name"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "spdx" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → spdx (EDOAL)"@en .
