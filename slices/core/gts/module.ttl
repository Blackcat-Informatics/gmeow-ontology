gmeow:payloadSchemaStatementsArchive
    a gmeow:PayloadSchema ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/gts> ;
    rdfs:label "payload schema — statements archive"@x-gmeow-english ;
    skos:definition "The RDF 1.2 statement layer's two committed byte projections, keyed by repo-relative path: the OWL downcast generated/statements/gmeow-statements.owl.ttl and the RDF-1.2 lead generated/statements/gmeow.rdf12.ttl, compiled once by gmeow:stage-statements and only tarred by gmeow:stage-archive-blobs. Both are BYTE-DECORATED RDF — their committed form carries generated banners and section markers that are not graph data — so they cannot reconstruct from a canonical named-graph fold and have always travelled as bytes. They ride THIS rep, and no longer the generated-opaque archive, because a rep is the unit a dictionary primes and welding them into the general archive made their medium assignment an accident of packaging. Nothing that was a graph becomes bytes — the queryable statement semantics keep riding the graph/statements named graph — so only the medium assignment of bytes that were already bytes changed. It carries NO gmeow:payloadSchemaDictionary: the claim dictionary the rep was separated out for was retired once the sweep priced it, because over this population its own in-band bytes cost more than the frames it saved, and gmeow:payloadSchemaDictionary is optional precisely so a rep may ride the mandated medium unprimed rather than carry a dictionary that does not pay."@x-gmeow-english ;
    gmeow:payloadSchemaId "statements-archive" ;
    gmeow:payloadSchemaMedium gmeow:mediumProfileBaselineL12 ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxConfigBox .

