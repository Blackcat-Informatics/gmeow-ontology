#
# Raw structural fixture (NOT a conformance fixture — no example-conformance.ttl cell;
# a later Rust property test loads this file via include_str!()). Half A of an
# α-equivalence pair: ∑ᵢ i, a summation binder over a bound variable declaration named
# ex:iDecl, with its bound occurrence as the sole operand of argument slot 0. Pair with
# alpha-equivalent-pair-b.ttl, which is STRUCTURALLY IDENTICAL — same operator, same
# slot-indexed operand, same binding shape — differing ONLY in the IRI of its
# bound-variable declaration (ex:jDecl in place of ex:iDecl). The property test asserts
# the two digest to the SAME math:structuralKey.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:sumBinder a math:BindingExpression ;
    math:operator math:summationBinder ;
    math:boundVariable ex:iDecl ;
    math:bindsOccurrence ex:iOccurrence ;
    math:argumentSlot ex:bodySlot .

ex:iDecl a math:VariableDeclaration .

ex:bodySlot a math:ArgumentSlot ;
    math:slotIndex 0 ;
    math:slotExpression ex:iOccurrence .

ex:iOccurrence a math:VariableOccurrence ;
    math:declaredVariable ex:iDecl ;
    math:occursInScope ex:sumBinder .
