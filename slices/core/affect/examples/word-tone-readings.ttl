@prefix ex: <https://example.org/word-tone-readings/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Every identity and assertion is explicitly supplied by these hypothetical sources.
# Words, speaker, recipient, versioned refiners, runs, recorder and frames stay distinct.
# Source A selects both co-equal label-set members; source B selects weary only.
# Source B's troubled candidate is unselected and is not a second readTone result.
# No available reading for unreadWords supplies no neutral or negative label.
# No actual cue review, released inventory, model run, score or diagnosis is asserted.
# The example runs no reader, detector, model, provenance check or isolation mechanism.

ex:wordSource rdf:type gmeow:InformationObject .
ex:wordSource rdfs:label "Original source recording the words and addressed participants"@en .
ex:readingSourceA rdf:type gmeow:InformationObject .
ex:readingSourceA rdfs:label "Source account for the first actual refiner version and its reading"@en .
ex:readingSourceB rdf:type gmeow:InformationObject .
ex:readingSourceB rdfs:label "Independent source account for the second actual refiner version"@en .
ex:speaker rdf:type gmeow:Agent .
ex:speaker rdfs:label "Original author of the words"@en .
ex:recipient rdf:type gmeow:Agent .
ex:recipient rdfs:label "Actual addressee independently named by the source"@en .
ex:recorder rdf:type gmeow:SoftwareAgent .
ex:recorder rdf:type gmeow:Agent .
ex:recorder rdfs:label "Recording importer, separate from speaker, recipient and refiner"@en .
ex:frameA rdf:type gmeow:Agent .
ex:frameA rdfs:label "Actual declaring source frame for the words and first reading"@en .
ex:frameB rdf:type gmeow:Agent .
ex:frameB rdfs:label "Actual declaring source frame for the second reading"@en .
ex:refinerV1 rdf:type gmeow:SoftwareAgent .
ex:refinerV1 rdf:type gmeow:Agent .
ex:refinerV1 rdfs:label "Source-identified word-tone refiner version one"@en .
ex:refinerV2 rdf:type gmeow:SoftwareAgent .
ex:refinerV2 rdf:type gmeow:Agent .
ex:refinerV2 rdfs:label "Source-identified word-tone refiner version two"@en .
ex:words rdf:type gmeow:Message .
ex:words rdf:type gmeow:InformationObject .
ex:words rdfs:label "Actual retained words targeted by both readings"@en .
ex:unreadWords rdf:type gmeow:Message .
ex:unreadWords rdf:type gmeow:InformationObject .
ex:unreadWords rdfs:label "Words for which the supplied source makes no reading available"@en .
ex:hearing rdf:type gmeow:Activity .
ex:hearing rdfs:label "Source-reported reception by the addressee"@en .
ex:readingKind rdf:type gmeow:EventType .
ex:readingKind rdfs:label "Actual reading-activity kind supplied by the source accounts"@en .
ex:runA rdf:type gmeow:Activity .
ex:runA rdfs:label "Actual generating activity for the first reading"@en .
ex:runB rdf:type gmeow:Activity .
ex:runB rdfs:label "Actual generating activity for the second reading"@en .
ex:readingA rdf:type gmeow:ToneReading .
ex:readingA rdfs:label "First source-attributed reading, selecting both co-equal labels"@en .
ex:readingB rdf:type gmeow:ToneReading .
ex:readingB rdfs:label "Second source-attributed reading, retaining a separate candidate"@en .
ex:wordSource gmeow:description "This hypothetical source explicitly identifies ex:speaker as the author and ex:recipient as the addressee, records the supplied hearing, and supplies no available reading for ex:unreadWords. Missing, unread or failed interpretation supplies no neutral-tone fact."@en .
ex:words gmeow:utteranceText "I am worried about the roof and exhausted after the journey."@en .
ex:words gmeow:wasAttributedTo ex:speaker .
ex:hearing gmeow:eventType gmeow:eventTypeAgentHeard .
ex:hearing gmeow:heardMessage ex:words .
ex:hearing gmeow:wasAssociatedWith ex:recipient .
ex:refinerV1 gmeow:description "The source identifies the exact process as example-word-tone-refiner version one. This is source identity evidence, not a model run, score or reviewed cue release."@en .
ex:refinerV2 gmeow:description "The independent source identifies the exact process as example-word-tone-refiner version two and reports its best-guess selection and distinct unselected alternative."@en .
ex:runA gmeow:eventType ex:readingKind .
ex:runA gmeow:wasAssociatedWith ex:refinerV1 .
ex:runB gmeow:eventType ex:readingKind .
ex:runB gmeow:wasAssociatedWith ex:refinerV2 .
ex:readingA gmeow:observedFeature ex:words .
ex:readingA gmeow:vantage ex:refinerV1 .
ex:readingA gmeow:wasDerivedFrom ex:words .
ex:readingA gmeow:wasGeneratedBy ex:runA .
ex:readingA gmeow:refinementOutcome gmeow:refinementResolved .
ex:readingA gmeow:readTone gmeow:toneTroubled .
ex:readingA gmeow:readTone gmeow:toneWeary .
ex:readingB gmeow:observedFeature ex:words .
ex:readingB gmeow:vantage ex:refinerV2 .
ex:readingB gmeow:wasDerivedFrom ex:words .
ex:readingB gmeow:wasGeneratedBy ex:runB .
ex:readingB gmeow:refinementOutcome gmeow:refinementBestGuess .
ex:readingB gmeow:readTone gmeow:toneWeary .
ex:readingB gmeow:refinementCandidate gmeow:toneTroubled .

# Exact per-statement sources, recorder and declaring frame; no metadata propagation.

ex:statement001 rdf:reifies <<( ex:wordSource rdf:type gmeow:InformationObject )>> ;
    gmeow:wasDerivedFrom ex:wordSource ;
    gmeow:wasAttributedTo ex:recorder ;
    gmeow:accordingTo ex:frameA .

ex:statement002 rdf:reifies <<( ex:wordSource rdfs:label "Original source recording the words and addressed participants"@en )>> ;
    gmeow:wasDerivedFrom ex:wordSource ;
    gmeow:wasAttributedTo ex:recorder ;
    gmeow:accordingTo ex:frameA .

