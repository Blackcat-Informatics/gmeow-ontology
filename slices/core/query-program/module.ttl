logic:argument [ logic:termIndex 0 ; logic:termVariable "rightOwner" ], [ logic:termIndex 1 ; logic:termVariable "this" ] ] ] ;
logic:consequent [ a logic:Formula ;
logic:relation logic:termEqual ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "leftOwner" ], [ logic:termIndex 1 ; logic:termVariable "rightOwner" ] ] ] ] ] ] .

gmeow:QueryOrderCriterionPositionLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query order criterion position law"@x-gmeow-english ;
    skos:definition "Within one query-order policy, equal criterion positions require the same criterion occurrence resource. Different policies retain independent sequence positions."@x-gmeow-english ;
    gmeow:useWhen "Use to reject competing key occurrences at one supplied precedence position."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid renumbering source positions, requiring contiguous indices or identifying occurrences across policy boundaries."@x-gmeow-english ;
    gmeow:howToUse "Bind two criteria of one policy and their entryOrdinal values; use logic:termEqual on positions and require equality of the occurrence resources."@x-gmeow-english ;
    skos:scopeNote "The admitted integer coordinates express control precedence, not mathematical magnitudes, measured ranks or a source count."@x-gmeow-english ;
    skos:example "Distinct precedence positions: ex:first gmeow:entryOrdinal \"0\"^^xsd:nonNegativeInteger . ex:last gmeow:entryOrdinal \"3\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
