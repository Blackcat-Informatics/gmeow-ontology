    ] .

<https://blackcatinformatics.ca/gmeow/MergerAcquisitionEventConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Event> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Event> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A merger or acquisition event should have at least 2 predecessor organizations and at least 1 successor organization." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/eventType> ?et . FILTER ( ?et IN (<https://blackcatinformatics.ca/gmeow/eventTypeMerger>, <https://blackcatinformatics.ca/gmeow/eventTypeAcquisition>) ) FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/predecessorOrganization> ?p1 . $this <https://blackcatinformatics.ca/gmeow/predecessorOrganization> ?p2 . FILTER ( ?p1 != ?p2 ) $this <https://blackcatinformatics.ca/gmeow/successorOrganization> ?s . } }""" ;
    ] .

