@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

logic:projection-report a logic:ProjectionReport ;
    logic:axiomCount 6 ;
    logic:hasProjection <https://blackcatinformatics.ca/logic/target/canonical-rdf12>,
        <https://blackcatinformatics.ca/logic/target/datalog>,
        <https://blackcatinformatics.ca/logic/target/gufo>,
        <https://blackcatinformatics.ca/logic/target/n3>,
        <https://blackcatinformatics.ca/logic/target/nemo>,
        <https://blackcatinformatics.ca/logic/target/owl-dl>,
        <https://blackcatinformatics.ca/logic/target/owl-el> ;
    logic:profileCount 0 ;
    logic:ruleCount 1 .

<https://blackcatinformatics.ca/logic/target/canonical-rdf12> a logic:ProjectionTarget ;
    rdfs:label "canonical-rdf12" ;
    logic:complexityClass "N/A (identity serialization)" ;
    logic:preservationKind logic:ExactPreservation .

<https://blackcatinformatics.ca/logic/target/datalog> a logic:ProjectionTarget ;
    rdfs:label "datalog" ;
    gmeow:lossyDrop "OWL class expressions not representable as Datalog atoms are dropped",
        "modal/world context flattened to predicate reification",
        "no existential rule heads (skolemisation not emitted)" ;
    logic:complexityClass "terminating/PTIME-data" ;
    logic:preservationKind logic:SoundUnderApproximation .

<https://blackcatinformatics.ca/logic/target/gufo> a logic:ProjectionTarget ;
    rdfs:label "gufo" ;
    gmeow:lossyDrop "actual: logic:body on <https://example.org/worlds-B/no-occurrence-gate/ruleTransitiveCausation> has no gUFO bridge equivalent",
        "actual: logic:head on <https://example.org/worlds-B/no-occurrence-gate/ruleTransitiveCausation> has no gUFO bridge equivalent",
        "actual: logic:provenance on <https://example.org/worlds-B/no-occurrence-gate/ruleTransitiveCausation> has no gUFO bridge equivalent",
        "actual: rdf:type logic:Rule on <https://example.org/worlds-B/no-occurrence-gate/ruleTransitiveCausation> has no gUFO equivalent",
        "actual: rule head <?A> dropped (gUFO bridge has no rule surface)",
        "logic: world-modal/contextual structure has no gUFO equivalent",
        "only gUFO-mapped sorts and structural predicates emitted",
        "preservation kind is ValidationOnly: gUFO is an anti-pattern check, not an entailment surface",
        "rules not representable in gUFO; only type/subtype declarations kept" ;
    logic:complexityClass "PTIME" ;
    logic:preservationKind logic:ValidationOnly .

<https://blackcatinformatics.ca/logic/target/n3> a logic:ProjectionTarget ;
    rdfs:label "n3" ;
    gmeow:lossyDrop "N3 builtins used for arithmetic/string predicates where available",
        "modal context encoded as quoted graph arguments (may overgenerate)" ;
    logic:complexityClass "semi-decidable" ;
    logic:preservationKind logic:CompleteOverApproximation .

<https://blackcatinformatics.ca/logic/target/nemo> a logic:ProjectionTarget ;
    rdfs:label "nemo" ;
    gmeow:lossyDrop "context (third arity slot) encoded as Nemo string constant \"default\" for unscoped axioms or modality value for scoped axioms",
        "predicate names and IRI arguments encoded as Nemo <iri> constants (angle-bracket syntax preserves full IRI identity, not local names)" ;
    logic:complexityClass "PTIME/datalog" ;
    logic:preservationKind logic:ExactPreservation .

<https://blackcatinformatics.ca/logic/target/owl-dl> a logic:ProjectionTarget ;
    rdfs:label "owl-dl" ;
    gmeow:lossyDrop "actual: logic:body on <https://example.org/worlds-B/no-occurrence-gate/ruleTransitiveCausation> has no OWL DL equivalent",
        "actual: logic:head on <https://example.org/worlds-B/no-occurrence-gate/ruleTransitiveCausation> has no OWL DL equivalent",
        "actual: logic:provenance on <https://example.org/worlds-B/no-occurrence-gate/ruleTransitiveCausation> has no OWL DL equivalent",
        "actual: rule head <?A> 'https://example.org/worlds-B/no-occurrence-gate/typeCauses' not expressible in OWL DL (body complexity)",
        "contextual scope (standpoint, time, confidence) is dropped",
        "modal/world context is erased",
        "probabilistic profile not representable in OWL DL",
        "rule bodies mapped to OWL axioms where OWL is expressive enough; existential rules beyond OWL DL expressivity are dropped" ;
    logic:complexityClass "decidable/N2EXPTIME" ;
    logic:preservationKind logic:SoundUnderApproximation .

<https://blackcatinformatics.ca/logic/target/owl-el> a logic:ProjectionTarget ;
    rdfs:label "owl-el" ;
    gmeow:lossyDrop "actual: logic:body on <https://example.org/worlds-B/no-occurrence-gate/ruleTransitiveCausation> has no EL equivalent",
        "actual: logic:head on <https://example.org/worlds-B/no-occurrence-gate/ruleTransitiveCausation> has no EL equivalent",
        "actual: logic:provenance on <https://example.org/worlds-B/no-occurrence-gate/ruleTransitiveCausation> has no EL equivalent",
        "actual: rule head <?A> dropped (EL has no rule surface)",
        "contextual scope (standpoint, time, confidence) is dropped",
        "modal/world context is erased",
        "only EL-safe axioms emitted (no disjointness, no inverseOf, no cardinality restrictions, no nominals)",
        "rules beyond EL expressivity are dropped" ;
    logic:complexityClass "PTIME" ;
    logic:preservationKind logic:SoundUnderApproximation .
