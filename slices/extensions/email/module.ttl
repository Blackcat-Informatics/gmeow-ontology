gmeow:participantAddress
    a owl:ObjectProperty ;
    rdfs:domain gmeow:MessageParticipant ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/email> ;
    rdfs:label "participant address"@x-gmeow-english ;
