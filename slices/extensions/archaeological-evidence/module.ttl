@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence>
    a owl:Ontology ;
    rdfs:label "GMEOW Archaeological Evidence Module"@x-gmeow-english ;
    skos:definition "The GMEOW Archaeological Evidence Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> ;
    rdfs:comment """Language-facing hooks for archaeological and cultural-heritage evidence: inscriptions, physical carriers, readings, transliterations, translations, script/language attributions, and find context. Keeps the physical carrier, the sign-bearing inscription, the documentation event, the reading, the transliteration, the translation, the dating evidence, the stratigraphic/find context, and the linguistic interpretation as separable, standpoint-scoped claims (Principle 9). Reuses the universal Observation stack, TemporalMeasurement, Place, Event, and the lexicon/attestation layer. Defers general archaeological domain modeling to archaeological-domain model."""@x-gmeow-english;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# CORE CLASSES
# =========================================================================== #

gmeow:Inscription
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:InformationObject ;
    rdfs:label "Inscription"@x-gmeow-english ;
    skos:definition "The sign-bearing content or mark on a physical carrier — a text, sequence of signs, or symbolic marking that is informationally distinct from the material object that bears it. An inscription is an InformationObject; its carrier is a PhysicalObject. Multiple inscriptions may coexist on one carrier, and competing readings of the same inscription coexist without privilege (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:InscriptionReading
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Observation, gufo:Relator ;
    rdfs:label "Inscription Reading"@x-gmeow-english ;
    skos:definition "A scholarly reading of an inscription — the Observation that produces a LexicalForm from a sign-bearing feature. The reading is a standpoint-scoped claim, not ground truth: two scholars may read the same marks differently, and both readings coexist (Principle 9). Follows the universal Observation + Relator pattern."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:InscriptionTransliteration
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Observation, gufo:Relator ;
    rdfs:label "Inscription Transliteration"@x-gmeow-english ;
    skos:definition "A transliteration of an inscription into another script — an Observation that maps sign sequences from one writing system to another, producing a LexicalForm. Standpoint-scoped: competing transliteration schemes (e.g. Hepburn vs Kunrei-shiki) coexist without a single winner (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:InscriptionTranslation
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Observation, gufo:Relator ;
    rdfs:label "Inscription Translation"@x-gmeow-english ;
    skos:definition "A translation of an inscription into another language — an Observation that produces a LexicalForm representing the meaning of the source inscription in a target language. Standpoint-scoped: competing translations coexist without privilege (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:ScriptLanguageAttribution
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Observation, gufo:Relator ;
    rdfs:label "Script Language Attribution"@x-gmeow-english ;
    skos:definition "A standpoint-scoped claim assigning a language, writing system, or notation system to an inscription. Handles disputed, uncertain, and undeciphered cases: an undeciphered inscription may carry an attribution to a NotationSystem with low confidence and determinacy = disputed, while competing palaeographic classifications coexist as separate attributions (Principle 9). Follows the universal Observation + Relator pattern."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:ArchaeologicalFindContext
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Observation, gufo:Relator ;
    rdfs:label "Archaeological Find Context"@x-gmeow-english ;
    skos:definition "A reified find context binding a physical carrier to its stratigraphic unit, find-spot, excavation or documentation event, and dating evidence. A single carrier may have multiple coexisting context claims from different excavation campaigns or analytical standpoints (Principle 9). Follows the universal Observation + Relator pattern."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

# EL axiomatisation: relators mediate their constitutive roles.
gmeow:InscriptionReading rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:readingOf ;    owl:someValuesFrom gmeow:Inscription ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:vantage ;      owl:someValuesFrom gmeow:Entity ] .

gmeow:InscriptionTransliteration rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:transliterationOf ;   owl:someValuesFrom gmeow:Inscription ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:vantage ;             owl:someValuesFrom gmeow:Entity ] .

gmeow:InscriptionTranslation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:translationOf ; owl:someValuesFrom gmeow:Inscription ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:vantage ;       owl:someValuesFrom gmeow:Entity ] .

gmeow:ScriptLanguageAttribution rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:attributionTarget ; owl:someValuesFrom gmeow:Inscription ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:vantage ;           owl:someValuesFrom gmeow:Entity ] .

gmeow:ArchaeologicalFindContext rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:findContextTarget ; owl:someValuesFrom gmeow:PhysicalObject ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:vantage ;           owl:someValuesFrom gmeow:Entity ] .

# =========================================================================== #
# PROPERTIES — Inscription ↔ PhysicalObject
# =========================================================================== #

gmeow:inscriptionCarrier
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Inscription ;
    rdfs:range gmeow:PhysicalObject ;
    rdfs:label "inscription carrier"@x-gmeow-english ;
    skos:definition "The physical object that bears an inscription. Functional: an inscription is borne by exactly one carrier (if a copy exists on another carrier, it is a distinct Inscription instance)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:carrierInscription
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:inscriptionCarrier ;
    rdfs:domain gmeow:PhysicalObject ;
    rdfs:range gmeow:Inscription ;
    rdfs:label "carrier inscription"@x-gmeow-english ;
    skos:definition "The inscription(s) borne by a physical carrier. Non-functional: a carrier may bear multiple inscriptions (e.g. a tablet with text on both sides, or a wall with successive layers of graffiti)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:carrierType
    a owl:ObjectProperty ;
    rdfs:domain gmeow:PhysicalObject ;
    rdfs:range gmeow:PhysicalCarrierType ;
    rdfs:label "carrier type"@x-gmeow-english ;
    skos:definition "The archaeological or cultural-heritage classification of a physical carrier — a value vocabulary individual from gmeow:PhysicalCarrierType. Non-functional: a carrier may be classified plurally by different standpoints (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

# =========================================================================== #
# PROPERTIES — InscriptionReading
# =========================================================================== #

gmeow:readingOf
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:InscriptionReading ;
    rdfs:range gmeow:Inscription ;
    rdfs:label "reading of"@x-gmeow-english ;
    skos:definition "The inscription that a reading observes. Functional per relator: one source inscription per InscriptionReading."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:readingResult
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InscriptionReading ;
    rdfs:range gmeow:InformationObject; # weakened from lexicon's LexicalForm (slice-dependency doctrine: sibling extensions stay independent; the slice's shapes narrow when lexicon is loaded);
    rdfs:label "reading result"@x-gmeow-english ;
    skos:definition "The lexical form(s) produced by a reading. Non-functional: a single reading may yield multiple coexisting forms (e.g. ambiguous or damaged signs interpreted differently within the same analytical frame), and competing result claims from different readings coexist (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

# =========================================================================== #
# PROPERTIES — InscriptionTransliteration
# =========================================================================== #

gmeow:transliterationOf
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:InscriptionTransliteration ;
    rdfs:range gmeow:Inscription ;
    rdfs:label "transliteration of"@x-gmeow-english ;
    skos:definition "The inscription that a transliteration maps into another script. Functional per relator: one source inscription per InscriptionTransliteration."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:transliterationResult
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InscriptionTransliteration ;
    rdfs:range gmeow:InformationObject; # weakened from lexicon's LexicalForm (slice-dependency doctrine: sibling extensions stay independent; the slice's shapes narrow when lexicon is loaded);
    rdfs:label "transliteration result"@x-gmeow-english ;
    skos:definition "The lexical form(s) produced by a transliteration. Non-functional: competing transliteration schemes may produce different forms for the same inscription, and those claims coexist (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

# =========================================================================== #
# PROPERTIES — InscriptionTranslation
# =========================================================================== #

gmeow:translationOf
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:InscriptionTranslation ;
    rdfs:range gmeow:Inscription ;
    rdfs:label "translation of"@x-gmeow-english ;
    skos:definition "The inscription that a translation renders into another language. Functional per relator: one source inscription per InscriptionTranslation."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:translationResult
    a owl:ObjectProperty ;
    rdfs:domain gmeow:InscriptionTranslation ;
    rdfs:range gmeow:InformationObject; # weakened from lexicon's LexicalForm (slice-dependency doctrine: sibling extensions stay independent; the slice's shapes narrow when lexicon is loaded);
    rdfs:label "translation result"@x-gmeow-english ;
    skos:definition "The lexical form(s) produced by a translation. Non-functional: competing translations of the same inscription coexist without privilege (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

# =========================================================================== #
# PROPERTIES — ScriptLanguageAttribution
# =========================================================================== #

gmeow:attributionTarget
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ScriptLanguageAttribution ;
    rdfs:range gmeow:Inscription ;
    rdfs:label "attribution target"@x-gmeow-english ;
    skos:definition "The inscription being classified by a script/language attribution. Functional per relator: one target inscription per ScriptLanguageAttribution."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:attributedLanguage
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ScriptLanguageAttribution ;
    rdfs:range gmeow:Language ;
    rdfs:label "attributed language"@x-gmeow-english ;
    skos:definition "The language assigned to an inscription by a script/language attribution. Non-functional: competing language assignments from different standpoints coexist (Principle 9), and an attribution may assign multiple languages (bilingual inscription)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:attributedScript
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ScriptLanguageAttribution ;
    rdfs:range gmeow:WritingSystem ;
    rdfs:label "attributed script"@x-gmeow-english ;
    skos:definition "The writing system assigned to an inscription by a script/language attribution. Non-functional: competing script assignments coexist (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:attributedNotation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ScriptLanguageAttribution ;
    rdfs:range gmeow:InformationObject; # weakened from notation's NotationSystem (slice-dependency doctrine: same convention as the LexicalForm ranges);
    rdfs:label "attributed notation"@x-gmeow-english ;
    skos:definition "The notation system assigned to an undeciphered or symbol-classified inscription. Non-functional: used when the inscription is not yet linked to a known language or writing system (e.g. Linear A, Rongorongo, proto-cuneiform)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

# =========================================================================== #
# PROPERTIES — ArchaeologicalFindContext
# =========================================================================== #

gmeow:findContextTarget
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ArchaeologicalFindContext ;
    rdfs:range gmeow:PhysicalObject ;
    rdfs:label "find context target"@x-gmeow-english ;
    skos:definition "The physical carrier whose find context is being described. Functional per relator: one target carrier per ArchaeologicalFindContext."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:findContextPlace
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ArchaeologicalFindContext ;
    rdfs:range gmeow:Place ;
    rdfs:label "find context place"@x-gmeow-english ;
    skos:definition "The find-spot or locus where a carrier was discovered. Non-functional: a carrier may be associated with multiple place claims (e.g. ancient find-spot vs modern museum location), and competing place attributions coexist (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:findContextStratigraphy
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ArchaeologicalFindContext ;
    rdfs:range gmeow:Entity ;
    rdfs:label "find context stratigraphy"@x-gmeow-english ;
    skos:definition "The stratigraphic unit or layer associated with a carrier's find context. Range is gmeow:Entity (opaque reference) because general stratigraphic domain modeling is deferred to archaeological-domain model; this property provides the language-facing hook. Non-functional: competing stratigraphic interpretations coexist."@x-gmeow-english;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:findContextDating
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ArchaeologicalFindContext ;
    rdfs:range gmeow:TemporalMeasurement ;
    rdfs:label "find context dating"@x-gmeow-english ;
    skos:definition "The temporal measurement(s) assigned to a carrier's find context — radiocarbon, stratigraphic correlation, terminus post quem, etc. Non-functional: multiple dating methods and competing date claims coexist (Principle 9)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:findContextEvent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ArchaeologicalFindContext ;
    rdfs:range gmeow:Event ;
    rdfs:label "find context event"@x-gmeow-english ;
    skos:definition "The excavation, survey, or documentation event during which a carrier was discovered or recorded. Non-functional: a carrier may be rediscovered or re-documented multiple times."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

# =========================================================================== #
# VALUE VOCABULARIES
# =========================================================================== #

gmeow:PhysicalCarrierType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Physical Carrier Type"@x-gmeow-english ;
    skos:definition "The archaeological or cultural-heritage classification of a physical object that bears inscriptions, marks, or signs — a value vocabulary (individuals, never subclasses). Open-ended: new carrier kinds are minted as needed without ontology modification."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

gmeow:carrierTablet          a gmeow:PhysicalCarrierType ; rdfs:label "tablet"@x-gmeow-english ;          skos:definition "A flat slab of clay, stone, or wax bearing inscribed text."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierOstracon        a gmeow:PhysicalCarrierType ; rdfs:label "ostracon"@x-gmeow-english ;        skos:definition "A potsherd or stone flake bearing ink or incised writing."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierSeal            a gmeow:PhysicalCarrierType ; rdfs:label "seal"@x-gmeow-english ;            skos:definition "A stamped or engraved object used to impress a design or text into clay or wax."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierCoin            a gmeow:PhysicalCarrierType ; rdfs:label "coin"@x-gmeow-english ;            skos:definition "A metallic disc bearing stamped legends, symbols, or portraits."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierManuscript      a gmeow:PhysicalCarrierType ; rdfs:label "manuscript"@x-gmeow-english ;      skos:definition "A handwritten document on parchment, papyrus, paper, or other flexible support."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierWallInscription a gmeow:PhysicalCarrierType ; rdfs:label "wall inscription"@x-gmeow-english ; skos:definition "Text or signs carved, painted, or affixed to a wall or other architectural surface."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierStela           a gmeow:PhysicalCarrierType ; rdfs:label "stela"@x-gmeow-english ;           skos:definition "An upright stone slab or pillar bearing inscribed text or relief."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierPapyrus         a gmeow:PhysicalCarrierType ; rdfs:label "papyrus"@x-gmeow-english ;         skos:definition "A sheet of papyrus bearing written or drawn content."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierPotterySherd    a gmeow:PhysicalCarrierType ; rdfs:label "pottery sherd"@x-gmeow-english ;   skos:definition "A fragment of ceramic vessel, often bearing painted or incised marks."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierBone            a gmeow:PhysicalCarrierType ; rdfs:label "bone"@x-gmeow-english ;            skos:definition "A bone object or fragment bearing carved or inked signs."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierMetal           a gmeow:PhysicalCarrierType ; rdfs:label "metal"@x-gmeow-english ;           skos:definition "A metal object or fragment bearing inscribed, cast, or stamped text."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .
gmeow:carrierWood            a gmeow:PhysicalCarrierType ; rdfs:label "wood"@x-gmeow-english ;            skos:definition "A wooden object or fragment bearing inscribed, painted, or burned text."@x-gmeow-english ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> .

# =========================================================================== #
# CROSS-CUTTING REUSE DECLARATION
#
# The following properties and classes are defined in other modules and are
# reused here without redefinition. They are listed for documentation only.
#
#   gmeow:PhysicalObject     (core.ttl)        — material carrier
#   gmeow:InformationObject  (core.ttl)        — information-content kind
#   gmeow:Observation        (observations.ttl)— universal claim stack
#   gmeow:Measurement        (observations.ttl)— quantitative observation
#   gmeow:TemporalMeasurement (temporal.ttl)   — dating evidence
#   gmeow:Place              (places.ttl)      — find-spot
#   gmeow:Event              (events.ttl)      — excavation / documentation
#   gmeow:LexicalForm        (lexicon.ttl)     — reading / transliteration / translation result
#   gmeow:Language           (languages.ttl)   — attributed language
#   gmeow:WritingSystem      (languages.ttl)   — attributed script
#   gmeow:NotationSystem     (notation.ttl)    — attributed notation
#   gmeow:Entity             (entities.ttl)    — universal entity class
#   gmeow:Agent              (core.ttl)        — vantage / observer
#   gmeow:confidence         (provenance.ttl)  — epistemic confidence [0,1]
#   gmeow:accordingTo        (standpoint.ttl)  — standpoint axis
#   gmeow:validFrom          (temporal.ttl)    — validity start
#   gmeow:validUntil         (temporal.ttl)    — validity end
#   gmeow:assertedAt         (temporal.ttl)    — assertion time
#   gmeow:displayable        (core.ttl)        — suppression, never erasure (P10)
#   gmeow:hasDeterminacy     (core.ttl)        — ontic determinacy
#   gmeow:vantage            (observations.ttl)— observer / standpoint
#   gmeow:observedFeature    (observations.ttl)— feature of interest
#   gmeow:observationResult  (observations.ttl)— observation result
#
# No new properties are minted for these axes — the archaeological evidence
# module reuses the existing cross-cutting vocabulary (Principle 4).
# =========================================================================== #

# =========================================================================== #
# OBSERVATION-SPINE BRIDGES (slice-dependency doctrine dependency refactor)
# Declared HERE, in the slice that owns these properties: a dependent slice
# knows the core observation spine; the spine never knows the slice. The
# super-properties (observedFeature / vantage / observationResult) live in
# the observations module.
# =========================================================================== #
# Archaeological evidence bridges (declared here because the super-properties live here).
# Only domain-specific properties whose domain is an Observation subclass are subsumed.
gmeow:readingOf               rdfs:subPropertyOf gmeow:observedFeature .
gmeow:readingResult           rdfs:subPropertyOf gmeow:observationResult .
gmeow:transliterationOf       rdfs:subPropertyOf gmeow:observedFeature .
gmeow:transliterationResult   rdfs:subPropertyOf gmeow:observationResult .
gmeow:translationOf           rdfs:subPropertyOf gmeow:observedFeature .
gmeow:translationResult       rdfs:subPropertyOf gmeow:observationResult .
gmeow:attributionTarget       rdfs:subPropertyOf gmeow:observedFeature .
gmeow:attributedLanguage      rdfs:subPropertyOf gmeow:observationResult .
gmeow:attributedScript        rdfs:subPropertyOf gmeow:observationResult .
gmeow:attributedNotation      rdfs:subPropertyOf gmeow:observationResult .
gmeow:findContextTarget       rdfs:subPropertyOf gmeow:observedFeature .
gmeow:findContextPlace        rdfs:subPropertyOf gmeow:observationResult .
gmeow:findContextStratigraphy rdfs:subPropertyOf gmeow:observationResult .
gmeow:findContextDating       rdfs:subPropertyOf gmeow:observationResult .
# Note: findContextEvent is deliberately NOT subsumed under observationResult
# because gmeow:Event (range of findContextEvent) is a gufo:Event, while
# gmeow:observationResult has range gmeow:Entity (= gufo:Endurant), and in
# gUFO gufo:Event and gufo:Endurant are disjoint. Subsumption would make the
# property unsatisfiable (Principle 8: reasoning-centric).
