msgstr "避免仅从 untracked 推断对象完备性、所有权或 Git 执行成功。"


msgctxt "https://blackcatinformatics.ca/gmeow/untracked|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain the explicit untracked value with its source and observation scope."
msgstr "连同来源及观察范围保留显式 untracked 值。"


msgctxt "https://blackcatinformatics.ca/gmeow/untracked|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain untracked in an attributed repository description."
msgstr "用于在带有归属的仓库描述中保留未跟踪。"


msgctxt "https://blackcatinformatics.ca/gmeow/untracked|http://www.w3.org/2000/01/rdf-schema#label"
msgid "untracked"
msgstr "未跟踪"


msgctxt "https://blackcatinformatics.ca/gmeow/untracked|http://www.w3.org/2004/02/skos/core#definition"
msgid "An explicit report that this working entry is untracked. Absence is unknown; false does not assert committed-tree membership or a clean working file."
msgstr "显式报告该工作条目未被跟踪。缺失为未知；假不表示属于已提交树或工作文件干净。"


msgctxt "https://blackcatinformatics.ca/gmeow/untracked|http://www.w3.org/2004/02/skos/core#example"
msgid "The source record names gmeow:untracked explicitly."
msgstr "来源记录显式命名 gmeow:untracked。"


msgctxt "https://blackcatinformatics.ca/gmeow/GitRepositoryHasObjectFormatConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating GitRepositoryHasObjectFormatConstraint as a traversal, hashing or Git execution certificate."
msgstr "避免将 GitRepositoryHasObjectFormatConstraint 视为遍历、哈希或 Git 执行证书。"


msgctxt "https://blackcatinformatics.ca/gmeow/GitRepositoryHasObjectFormatConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Apply GitRepositoryHasObjectFormatConstraint to the explicitly scoped source records."
msgstr "将 GitRepositoryHasObjectFormatConstraint 应用于显式限定范围的来源记录。"


msgctxt "https://blackcatinformatics.ca/gmeow/GitRepositoryHasObjectFormatConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve Git repository object format presence constraint."
msgstr "用于保持Git 仓库对象格式存在性约束。"


msgctxt "https://blackcatinformatics.ca/gmeow/GitRepositoryHasObjectFormatConstraint|http://www.w3.org/2000/01/rdf-schema#label"
