@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:eqGr001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Corpus ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q461183 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Wikidata 'text corpus'; curl-validated 2026-06-12" ;
    gmeow:sssomFile "gmeow-graphrag.sssom.tsv" .

gmeow:eqGr002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Corpus ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:Dataset ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "the working retrieval dataset; the #58 Croissant/RO-Crate profiles project through this cell" ;
    gmeow:sssomFile "gmeow-graphrag.sssom.tsv" .

gmeow:eqGr003 a gmeow:TermEquivalence ;
