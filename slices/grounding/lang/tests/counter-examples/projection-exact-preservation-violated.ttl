# Counter-example: a lang:ProjectionEmission claiming logic:ExactPreservation whose MEASURED
# lang:roundTripHolds is false — an exactness claim its own round-trip refutes (fires
# lang:ExactPreservationViolated).

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

ex:grammarSurface a lang:Grammar .

ex:emExact a lang:ProjectionEmission ;
    lang:projectionTargetName "GTS-grammar-surface" ;
    lang:projectsSource ex:grammarSurface ;
    logic:preservationKind logic:ExactPreservation ;
    lang:roundTripHolds false .
