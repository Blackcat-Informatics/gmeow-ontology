@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix schema:  <https://schema.org/> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .

# Term equivalences for the accessibility layer — GMEOW authoring source.
# Compiled to mappings/gmeow-accessibility.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetAccessibility a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/accessibility" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Accessibility alignments — schema.org, WHO ICF, IndoorGML/IMDF, and SOSA." .

# --------------------------------------------------------------------------- #
# schema.org — accessibilityFeature / accessibilityHazard
# --------------------------------------------------------------------------- #

gmeow:eqA11y001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasAccessibilityFeature ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:accessibilityFeature ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "schema:accessibilityFeature is a flat textual enum on Place/CreativeWork; GMEOW hasAccessibilityFeature is an object property ranging over AccessibilityFacet individuals. Directional lossy projection." ;
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" .

gmeow:eqA11y002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasBarrier ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:accessibilityHazard ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "schema:accessibilityHazard is a flat textual enum for hazards; GMEOW hasBarrier is an object property ranging over AccessibilityFacet individuals. Directional lossy projection." ;
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" .

# --------------------------------------------------------------------------- #
# SOSA — AccessibilityAssertion as a kind of observation
# --------------------------------------------------------------------------- #

gmeow:eqA11y003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:AccessibilityAssertion ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "sosa:Observation is the generic observation class; gmeow:AccessibilityAssertion is a specialised gufo:Relator for accessibility claims. Both carry provenance and result." ;
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" .

# --------------------------------------------------------------------------- #
# WHO ICF — AccessibilityFacet individuals bridge to ICF categories
# --------------------------------------------------------------------------- #
# ICF codes use the HL7 FHIR sid: http://hl7.org/fhir/sid/icf
# Specific codes referenced conceptually; alignment is by reference only.

gmeow:eqA11y010 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:facetWheelchair ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject <http://hl7.org/fhir/sid/icf#d4> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Mobility" ;
    gmeow:comment "ICF d4 (Mobility) encompasses wheelchair and step-free locomotion." ;
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" .

gmeow:eqA11y011 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:facetWheelchair ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject <http://hl7.org/fhir/sid/icf#e115> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "Products and technology for personal mobility" ;
    gmeow:comment "ICF e115 covers assistive products for personal mobility (wheelchairs, walkers, ramps)." ;
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" .

