    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:eventTypeLie a gmeow:EventType . }""" ;
    gmeow:saRationale "gmeow:eventTypeLie MUST exist as a gmeow:EventType individual -- lie/falsification is the core speech-act deception type (issue #215). Mirrors test_event_type_lie_exists." .

