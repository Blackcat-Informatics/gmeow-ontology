# ── Deliberate-non-assertion guardrails — the intentional boundaries, executable ──
# The maximal-formalization harvest must never quietly over-constrain: every deliberate
# non-assertion the design commits to is recorded here as a reviewed
# logic:FormalizationCandidate, so an over-eager axiom that would cross one of these
# boundaries is surfaced (logic:ObligationViolated, or a discipline logic:violation) and
# returned to review rather than silently asserted into the reasoned core. Two guardrails
# forbid an entailment via a standing logic:NonEntailmentObligation (Arm A syntactic
# reachability over rule heads + Arm B finite closure over derived edges); two are
# integrity constraints whose violation is a finding, wrapping the existing foundation
# disciplines that already fire it. The deliberately-preserved gmeow:SocialObject ∩
# gmeow:InformationObject overlap (logic:candidateSocialInformationOverlap,
# logic:CategoryDeliberateOverlap, authored above) is the fifth boundary. Each carries a
# harvest back-link so the whole boundary set is queryable in the deliberate-non-assertion
# report. This machinery IS the foundation's guard against over-typing (Principle 9's
# refusal to over-assert): the review of an over-typing collision is the obligation /
# discipline check itself, not a separate advisory flag (design/LOGIC-FOUNDATION.md,
# §Typed formalization governance).

# 1. Intent is attributed, never entailed (deception) — a forbidden entailment.
logic:candidateIntentNotEntailed
    a logic:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "deceptive intent is attributed, never entailed"@x-gmeow-english ;
    skos:definition "The deliberate-non-assertion formalization candidate carrying the standing commitment that deceptive intent must never be entailed: gmeow:deceptiveIntentClaim is an attributed, defeasible standpoint claim, so a held≠projected structural gap is EVIDENCE, never ENTAILMENT, of intent, and the foundation must never derive the predicate. Realized as the logic:NonEntailmentObligation logic:IntentNotFromDeceptionObligation and enforced by Arm A syntactic reachability over the rule heads plus Arm B finite closure over the materialized derivation graph. Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation). The semantic risk is core-contaminating: a mis-formalization that closed this inference would corrupt the reasoned core with an entailed intent, so the guardrail protects the core, not merely a projection. Its harvest back-link (logic:candidateFormalizes gmeow:deceptiveIntentClaim, logic:candidateSourceField logic:ProseFieldAvoidWhen) ties it to the exact prose that forbids the entailment, and logic:candidateSourceHash is the sha256 of that gmeow:avoidWhen text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:4750f37f26e7b1dd379cade0cb9a93d1d7aa6f64c205db27583d832344108245"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from gmeow:deceptiveIntentClaim's gmeow:avoidWhen, which states never let the reasoner entail deceptiveness (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "gmeow:deceptiveIntentClaim over deception events: intent stays an attributed, defeasible claim, never a reasoned entailment"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryNonEntailmentObligation ;
    logic:candidateDeliberateNonAssertion true ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidateNonEntailment logic:IntentNotFromDeceptionObligation ;
    logic:candidateProjectionBehavior logic:ValidationOnly ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes gmeow:deceptiveIntentClaim ;
    logic:candidateSourceField logic:ProseFieldAvoidWhen .

# 2. Counterpart is symmetric-only, never transitive (coreference) — a forbidden entailment.
logic:candidateCounterpartNonTransitive
    a logic:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "counterpart stays symmetric-only, never transitive"@x-gmeow-english ;
    skos:definition "The deliberate-non-assertion formalization candidate carrying the standing commitment that cross-realm counterpart identity (gmeow:counterpartOf) stays non-transitive: it is symmetric by design but must never chain, so contested, standpoint-indexed, or context-dependent claims are never transitively collapsed into OWL sameAs identity. Realized as the logic:NonEntailmentObligation logic:CounterpartNonTransitivityObligation and enforced by Arm A syntactic reachability over the counterpart rule heads (no rule head produces the predicate). Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation). The semantic risk is core-contaminating: a careless transitivity rule would corrupt the reasoned core by merging entities the design keeps distinct. Its harvest back-link (logic:candidateFormalizes gmeow:counterpartOf, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose that commits to non-transitivity, and logic:candidateSourceHash is the sha256 of that skos:definition text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:b2318705c42e37e940f1c2809e1c6a081517082ce26a6e15bbcca4e2f49deff5"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from gmeow:counterpartOf's skos:definition, which states it is symmetric but deliberately not transitive (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "gmeow:counterpartOf across realms, frames and datasets: symmetric-only, never transitively chained"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryNonEntailmentObligation ;
    logic:candidateDeliberateNonAssertion true ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidateNonEntailment logic:CounterpartNonTransitivityObligation ;
    logic:candidateProjectionBehavior logic:ValidationOnly ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes gmeow:counterpartOf ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# 3. Frame-relativity: no frame-free value (Principle 11) — an integrity constraint.
logic:cqFrameRelativityHolds
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a framed value stays well-formed"@x-gmeow-english ;
    skos:definition "The positive competency case the frame-relativity constraint must satisfy: a logic:measuredValue expressed together with its logic:referenceFrame is well-formed — it carries no logic:MeasurementFrameMissing violation — because the value is meaningful only paired with the frame it is expressed in (Principle 11)."@x-gmeow-english .

logic:cqFrameRelativityFramelessRejected
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a frame-free value is rejected"@x-gmeow-english ;
    skos:definition "The negative countermodel the frame-relativity constraint must respect: a logic:measuredValue asserted with no logic:referenceFrame is the logic:MeasurementFrameMissing violation — a frame-free value collapse the foundation catches as a finding, never admits as a well-formed model. The boundary Principle 11 enforces: a value asserted without its frame is ill-formed, and two frame-relative values are never equated frame-free."@x-gmeow-english .

logic:candidateFrameRelativity
    a logic:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "measured values are frame-relative — no frame-free collapse"@x-gmeow-english ;
    skos:definition "The integrity-constraint formalization candidate that harvests Principle 11 frame-relativity from logic:referenceFrame's skos:definition into the enforced logic:MeasurementFrameMissing constraint: a logic:measuredValue is meaningful only together with the logic:referenceFrame it is expressed in, so a frame-free value is ill-formed and two frame-relative values are never equated frame-free. Violation is a finding, not a derivation, materialized by the existing foundation quality discipline. Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation) with a positive case (logic:cqFrameRelativityHolds — a framed value stays well-formed) and a negative countermodel (logic:cqFrameRelativityFramelessRejected — a frame-free value is the logic:MeasurementFrameMissing violation). Its harvest back-link (logic:candidateFormalizes logic:referenceFrame, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose, and logic:candidateSourceHash is the sha256 of that definition text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:2e7a0baa563e6237f44afac81e9cc35ca4fa4c2dff5f55deb9fdc99a8777deeb"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from logic:referenceFrame's skos:definition, which states a logic:measuredValue with no logic:referenceFrame is the logic:MeasurementFrameMissing violation (Principle 11; design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "the true-quantity/measured-value seam: a logic:measuredValue is frame-relative and ill-formed without its logic:referenceFrame; no frame-free equality collapse"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryIntegrityConstraint ;
    logic:candidateDeliberateNonAssertion true ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidatePositiveCase logic:cqFrameRelativityHolds ;
    logic:candidateNegativeCase logic:cqFrameRelativityFramelessRejected ;
    logic:candidateProjectionBehavior logic:SoundUnderApproximation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes logic:referenceFrame ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# 4. No over-typing: at most one ultimate Kind (Principle 9, MixIden) — an integrity constraint.
logic:cqNoOverTypingHolds
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a single-Kind instance is well-formed"@x-gmeow-english ;
    skos:definition "The positive competency case the no-over-typing constraint must satisfy: an object whose sortal traces its principle of identity to exactly one ultimate logic:Kind is well-formed — it carries no logic:MixIden violation — because a Kind supplies a single principle of identity (Principle 9's refusal to over-type)."@x-gmeow-english .

logic:cqNoOverTypingTwoKindsRejected
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a two-Kind instance is rejected"@x-gmeow-english ;
    skos:definition "The negative countermodel the no-over-typing constraint must respect: a sortal tracing its identity to two-or-more disjoint logic:Kinds is the logic:MixIden violation — over-typing the foundation catches as a finding, never admits as a well-formed model. The boundary Principle 9 enforces: co-equal facets are not fused into two disjoint identity-supplying Kinds on one instance."@x-gmeow-english .

logic:candidateNoOverTyping
    a logic:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "an instance carries at most one ultimate Kind — no over-typing"@x-gmeow-english ;
    skos:definition "The integrity-constraint formalization candidate that harvests Principle 9's no-over-typing boundary from logic:MixIden's skos:definition into the enforced identity-overlap discipline: a sortal inherits its principle of identity from exactly one Kind, so an instance tracing to two-or-more disjoint Kinds is the logic:MixIden violation. Violation is a finding, not a derivation, materialized by the existing foundation identity discipline (it wraps logic:MixIden, it does not duplicate it). Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation) with a positive case (logic:cqNoOverTypingHolds — a single-Kind instance is well-formed) and a negative countermodel (logic:cqNoOverTypingTwoKindsRejected — a two-Kind instance is the logic:MixIden violation). Its harvest back-link (logic:candidateFormalizes logic:MixIden, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose, and logic:candidateSourceHash is the sha256 of that definition text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:c806598361dd99032b2934b0f76cb2aa9a773b51a280f9240b76b57f17315266"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from logic:MixIden's skos:definition, which states a sortal inherits its principle of identity from exactly one Kind and tracing to two-or-more Kinds violates it (Principle 9; design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "logic:Kind identity supply: an instance's sortal traces to exactly one ultimate Kind; two disjoint Kinds on one instance is over-typing"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryIntegrityConstraint ;
    logic:candidateDeliberateNonAssertion true ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidatePositiveCase logic:cqNoOverTypingHolds ;
    logic:candidateNegativeCase logic:cqNoOverTypingTwoKindsRejected ;
    logic:candidateProjectionBehavior logic:SoundUnderApproximation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes logic:MixIden ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# =========================================================================== #
# Declarative constraint axioms — canonical OWL 2 DL antecedents for the logic
# slice's closed-world validation projection (Principles 4 and 17). Required
# paths use class-scoped closure entries paired with OWL allValuesFrom, and
# at-most-one uses OWL FunctionalProperty. No OWL existential or raw cardinality
# restriction is needed or permitted here.
# =========================================================================== #

# These properties are intentionally closed on the validation surface. Their
# OWL allValuesFrom restrictions therefore gain sh:minCount 1 for the named
# class/property pair; properties without this explicit closure entry keep the
# conservative open-world universal reading.
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateSourceHash" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateExtractionProvenance" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateScope" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateContract" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateCategory" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateLifecycle" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateProjectionBehavior" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FormalizationCandidate ; logic:closureKey "https://blackcatinformatics.ca/logic/candidateSemanticRisk" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:Plan ; logic:closureKey "https://blackcatinformatics.ca/logic/planGoal" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:Plan ; logic:closureKey "https://blackcatinformatics.ca/logic/planSuccessMode" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:GoalEvaluation ; logic:closureKey "https://blackcatinformatics.ca/logic/satisfactionStatus" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:GoalEvaluation ; logic:closureKey "https://blackcatinformatics.ca/logic/feasibilityStatus" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:GoalEvaluation ; logic:closureKey "https://blackcatinformatics.ca/logic/lifecycleStatus" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:GoalEvaluation ; logic:closureKey "https://blackcatinformatics.ca/logic/goalEvaluationStatus" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:GoalEvaluation ; logic:closureKey "https://blackcatinformatics.ca/logic/evaluatesGoal" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:ActionSchema ; logic:closureKey "https://blackcatinformatics.ca/logic/precondition" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:ActionSchema ; logic:closureKey "https://blackcatinformatics.ca/logic/capability" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:McpActionSchema ; logic:closureKey "https://blackcatinformatics.ca/logic/compensation" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:McpActionSchema ; logic:closureKey "https://blackcatinformatics.ca/logic/capability" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:McpActionSchema ; logic:closureKey "https://blackcatinformatics.ca/logic/precondition" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:NotificationWaitSchema ; logic:closureKey "https://blackcatinformatics.ca/logic/awaitsSignal" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:FreshnessGuard ; logic:closureKey "https://blackcatinformatics.ca/logic/guardsPrecondition" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:NonEntailmentObligation ; logic:closureKey "https://blackcatinformatics.ca/logic/obligationForbiddenPredicate" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:NonEntailmentObligation ; logic:closureKey "https://blackcatinformatics.ca/logic/obligationDischargeCondition" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:Conjecture ; logic:closureKey "https://blackcatinformatics.ca/logic/conjectureFormula" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:Conjecture ; logic:closureKey "https://blackcatinformatics.ca/logic/conjectureStandpoint" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:Conjecture ; logic:closureKey "https://blackcatinformatics.ca/logic/conjectureLifecycleState" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:Conjecture ; logic:closureKey "https://blackcatinformatics.ca/logic/verdictProvenance" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:ContradictionWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/witnessIndividual" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:ContradictionWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/witnessWorld" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:ContradictionWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/witnessPremise" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:RecoveryCase ; logic:closureKey "https://blackcatinformatics.ca/logic/recoveryTransform" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:ClosureAcceptanceWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/closureEntailedAtom" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:SectionAcceptanceWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/dischargesSectionObligation" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:CounterfactualAcceptanceWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/selectedByEntrenchment" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:RefutationAcceptanceWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/namesContradictionWitness" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass logic:ChaseAcceptanceWitness ; logic:closureKey "https://blackcatinformatics.ca/logic/carriesTerminationCertificate" ; logic:closureValue logic:ClosedWorldClosure ] .

logic:FormalizationCandidate logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:candidateSourceHash ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty logic:candidateExtractionProvenance ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty logic:candidateScope ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty logic:candidateContract ; logic:allValuesFrom logic:ReasoningContract ] ,
    [ a logic:Restriction ; logic:onProperty logic:candidateCategory ; logic:allValuesFrom logic:FormalizationCategory ] ,
    [ a logic:Restriction ; logic:onProperty logic:candidateLifecycle ; logic:allValuesFrom logic:CandidateLifecycleState ] ,
    [ a logic:Restriction ; logic:onProperty logic:candidateProjectionBehavior ; logic:allValuesFrom logic:PreservationKind ] ,
    [ a logic:Restriction ; logic:onProperty logic:candidateSemanticRisk ; logic:allValuesFrom logic:SemanticRiskClass ] ,
    [ a logic:Restriction ; logic:onProperty logic:candidateSourceField ; logic:allValuesFrom logic:ProseField ] .

logic:Plan logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:planGoal ; logic:allValuesFrom gmeow:Goal ] ,
    [ a logic:Restriction ; logic:onProperty logic:planSuccessMode ; logic:allValuesFrom logic:PlanSuccessMode ] .

logic:GoalEvaluation logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:satisfactionStatus ; logic:allValuesFrom logic:SatisfactionStatus ] ,
    [ a logic:Restriction ; logic:onProperty logic:feasibilityStatus ; logic:allValuesFrom logic:FeasibilityStatus ] ,
    [ a logic:Restriction ; logic:onProperty logic:lifecycleStatus ; logic:allValuesFrom logic:LifecycleStatus ] ,
    [ a logic:Restriction ; logic:onProperty logic:goalEvaluationStatus ; logic:allValuesFrom logic:GoalEvaluationStatus ] ,
    [ a logic:Restriction ; logic:onProperty logic:evaluatesGoal ; logic:allValuesFrom gmeow:Goal ] .

logic:ActionSchema logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:precondition ; logic:allValuesFrom logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty logic:capability ; logic:allValuesFrom logic:Thing ] .

logic:McpActionSchema logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:capability ; logic:allValuesFrom logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty logic:precondition ; logic:allValuesFrom logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty logic:compensation ; logic:allValuesFrom logic:Thing ] .

logic:NotificationWaitSchema logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:awaitsSignal ; logic:allValuesFrom logic:ExternalSignal ] .

logic:FreshnessGuard logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:guardsPrecondition ; logic:allValuesFrom logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty logic:freshnessHorizon ; logic:allValuesFrom xsd:duration ] ,
    [ a logic:Restriction ; logic:onProperty logic:freshnessWindowStart ; logic:allValuesFrom xsd:dateTime ] ,
    [ a logic:Restriction ; logic:onProperty logic:freshnessWindowEnd ; logic:allValuesFrom xsd:dateTime ] .

logic:NonEntailmentObligation logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:obligationForbiddenPredicate ; logic:allValuesFrom xsd:anyURI ] ,
    [ a logic:Restriction ; logic:onProperty logic:obligationDischargeCondition ; logic:allValuesFrom logic:DischargeCondition ] .

logic:Conjecture logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:conjectureFormula ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty logic:conjectureStandpoint ; logic:allValuesFrom logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty logic:conjectureLifecycleState ; logic:allValuesFrom logic:ConjectureLifecycleState ] ,
    [ a logic:Restriction ; logic:onProperty logic:verdictProvenance ; logic:allValuesFrom logic:VerdictProvenanceKind ] .

logic:ContradictionWitness logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:witnessIndividual ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty logic:witnessWorld ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty logic:witnessPremise ; logic:allValuesFrom xsd:string ] .

logic:RecoveryCase logic:subClassOf
    [ a logic:Restriction ; logic:onProperty logic:recoveryTransform ; logic:allValuesFrom logic:Formula ] .

# Global at-most-one semantics for the carriers legacy SHACL constrained with maxCount 1.

# Flagship acceptance witnesses: each required carrier is canonical, typed, and retains its
# exact failure class through the generated validation-shape projection.
logic:ClosureAcceptanceWitness
    logic:subClassOf [ a logic:Restriction ; logic:onProperty logic:closureEntailedAtom ; logic:allValuesFrom xsd:string ] ;
    gmeow:enforcesFailureClass logic:IncompleteClosure .
logic:SectionAcceptanceWitness
    logic:subClassOf [ a logic:Restriction ; logic:onProperty logic:dischargesSectionObligation ; logic:allValuesFrom logic:Thing ] ;
    gmeow:enforcesFailureClass logic:SectionObligationViolated .
logic:CounterfactualAcceptanceWitness
    logic:subClassOf [ a logic:Restriction ; logic:onProperty logic:selectedByEntrenchment ; logic:allValuesFrom logic:Thing ] ;
    gmeow:enforcesFailureClass logic:UnentrenchedCounterfactual .
logic:RefutationAcceptanceWitness
    logic:subClassOf [ a logic:Restriction ; logic:onProperty logic:namesContradictionWitness ; logic:allValuesFrom logic:ContradictionWitness ] ;
    gmeow:enforcesFailureClass logic:UnwitnessedRefutation .
logic:ChaseAcceptanceWitness
    logic:subClassOf [ a logic:Restriction ; logic:onProperty logic:carriesTerminationCertificate ; logic:allValuesFrom xsd:string ] ;
    gmeow:enforcesFailureClass logic:UncertifiedChase .

# =========================================================================== #
# Authored procedural-constraint records live in the slice that OWNS the
# grounding term they enforce (e.g. math:RationalValueDenominatorNonZeroConstraint
# in slices/grounding/math). Each compact logic:Constraint sugar record is
# compiled into the canonical logic: terminal and PROJECTED to
# generated/shapes/procedural-constraints.ttl as a sh:SPARQLConstraint carrying
# logic:formalizes the grounding term it enforces (Principle 17 — logic: is
# canonical, SHACL is the projection). Only the forward-from-focus fragment
# (P1-P7 / aggregate) is expressible; genuinely cross-node / arithmetic /
# inverse-path / property-path grounding conditions have no range-restricted
# guarded SPARQL-constraint form and stay in the canon as flagged residue.
# =========================================================================== #

logic:valuePredicate
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "value predicate"@x-gmeow-english ;
    skos:definition "The fixed check predicate of a logic:PathValueTypeConstraint's fixed-value variant: every value the focus carries on logic:valuePath must itself carry this predicate with object logic:valueObject (Q(v, o)), rather than being an instance of a logic:valueClass. Paired with logic:valueObject; mutually exclusive with logic:valueClass."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:valueObject
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "value object"@x-gmeow-english ;
    skos:definition "The fixed object of a logic:PathValueTypeConstraint's fixed-value variant: the required object (an IRI or a literal) of logic:valuePredicate on every value reached by logic:valuePath."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .


# =========================================================================== #
# Procedural constraint authored as a raw logic:Formula integrity tree —        #
# projected to a sh:SPARQLConstraint. logic:formalizes keys the projected twin  #
# onto gmeow:Goal, the source-term of the hand-authored SHACL it replaces.      #
# =========================================================================== #

# A conclusive gmeow:satisfiedBy(goal, situation) edge must be backed by at least
# one logic:GoalEvaluation under SOME vantage whose logic:evaluatesGoal is the
# goal, logic:evaluatedAgainst is the situation, logic:satisfactionStatus is
# logic:Satisfied, and logic:goalEvaluationStatus is logic:GoalEvaluationCompleted.
logic:SatisfiedByBackedByEvaluationConstraint
    a logic:Constraint ;
    rdfs:label "satisfiedBy backed-by-evaluation constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a conclusive gmeow:satisfiedBy edge is backed by a vantage-scoped logic:GoalEvaluation that evaluatesGoal this goal, was evaluatedAgainst the situation, and is Satisfied and completed."@x-gmeow-english ;
    logic:formalizes logic:SatisfiedByBackedByEvaluationShape ;
    logic:message "A conclusive gmeow:satisfiedBy edge must be backed by a vantage-scoped logic:GoalEvaluation (evaluatesGoal = this goal, evaluatedAgainst = the situation, satisfactionStatus = logic:Satisfied, goalEvaluationStatus = logic:GoalEvaluationCompleted). No backing evaluation under any vantage was found." ;
    logic:integrity logic:sbeForall .
logic:sbeForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "situation" ] ;
    logic:forall logic:sbeImpl .
logic:sbeImpl a logic:Formula ; logic:antecedent logic:sbeGuard ; logic:consequent logic:sbeExists .
logic:sbeGuard a logic:Formula ; logic:and logic:sbeType , logic:sbeSat .
logic:sbeType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:Goal ] .
logic:sbeSat a logic:Formula ; logic:relation gmeow:satisfiedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "situation" ] .
logic:sbeExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "eval" ] ;
    logic:exists logic:sbeBody .
logic:sbeBody a logic:Formula ; logic:and logic:sbeB1 , logic:sbeB2 , logic:sbeB3 , logic:sbeB4 .
logic:sbeB1 a logic:Formula ; logic:relation logic:evaluatesGoal ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "eval" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:sbeB2 a logic:Formula ; logic:relation logic:evaluatedAgainst ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "eval" ] , [ logic:termIndex 1 ; logic:termVariable "situation" ] .
logic:sbeB3 a logic:Formula ; logic:relation logic:satisfactionStatus ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "eval" ] , [ logic:termIndex 1 ; logic:termIri logic:Satisfied ] .
logic:sbeB4 a logic:Formula ; logic:relation logic:goalEvaluationStatus ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "eval" ] , [ logic:termIndex 1 ; logic:termIri logic:GoalEvaluationCompleted ] .

# =========================================================================== #
# Procedural constraints for conditional FreshnessGuard and Conjecture obligations,
# authored as raw logic:Formula integrity trees and projected to SHACL (Principle 17).
# =========================================================================== #

# A logic:FreshnessGuard that declares a logic:freshnessWindow must carry BOTH a
# logic:freshnessWindowStart AND a logic:freshnessWindowEnd (the closed interval
# bounds). Violation: a window present with either bound absent — a raw formula
# whose two co-occur arms each re-bind the focus through the window predicate.
logic:FreshnessGuardWindowBoundsConstraint
    a logic:Constraint ;
    rdfs:label "FreshnessGuard window-bounds constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a logic:FreshnessGuard declaring a logic:freshnessWindow carries both a logic:freshnessWindowStart and a logic:freshnessWindowEnd — a half-declared window gates on an ill-defined interval."@x-gmeow-english ;
    logic:formalizes logic:FreshnessGuardShape ;
    logic:severity "Violation" ;
    logic:message "A FreshnessGuard that declares a logic:freshnessWindow must carry BOTH a logic:freshnessWindowStart AND a logic:freshnessWindowEnd (the closed interval bounds); the property shapes already cap each bound at one." ;
    logic:integrity logic:fgwForall .
logic:fgwForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:fgwImpl .
logic:fgwImpl a logic:Formula ; logic:antecedent logic:fgwGuard ; logic:consequent logic:fgwPhi .
logic:fgwGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri logic:FreshnessGuard ] .
logic:fgwPhi a logic:Formula ; logic:not logic:fgwBad .
logic:fgwBad a logic:Formula ; logic:or logic:fgwBadStart , logic:fgwBadEnd .
logic:fgwBadStart a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "w" ] ;
    logic:exists logic:fgwStartBody .
logic:fgwStartBody a logic:Formula ; logic:and logic:fgwStartWin , logic:fgwNoStart .
logic:fgwStartWin a logic:Formula ; logic:relation logic:freshnessWindow ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "w" ] .
logic:fgwNoStart a logic:Formula ; logic:not logic:fgwStartEx .
logic:fgwStartEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "s" ] ;
    logic:exists logic:fgwStartAtom .
logic:fgwStartAtom a logic:Formula ; logic:relation logic:freshnessWindowStart ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
logic:fgwBadEnd a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "w2" ] ;
    logic:exists logic:fgwEndBody .
logic:fgwEndBody a logic:Formula ; logic:and logic:fgwEndWin , logic:fgwNoEnd .
logic:fgwEndWin a logic:Formula ; logic:relation logic:freshnessWindow ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "w2" ] .
logic:fgwNoEnd a logic:Formula ; logic:not logic:fgwEndEx .
logic:fgwEndEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "e" ] ;
    logic:exists logic:fgwEndAtom .
logic:fgwEndAtom a logic:Formula ; logic:relation logic:freshnessWindowEnd ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "e" ] .

# A logic:Conjecture whose logic:conjectureLifecycleState is
# logic:ConjectureRefutedInStandpoint must name at least one
# logic:conjectureRefutationWitness (a concrete logic:ContradictionWitness); a
# refutation with no witness is a hard error — a raw guarded-existence formula.
logic:ConjectureRefutationWitnessConstraint
    a logic:Constraint ;
    rdfs:label "Conjecture refutation-witness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a logic:Conjecture in logic:ConjectureRefutedInStandpoint names at least one logic:conjectureRefutationWitness — the concrete logic:ContradictionWitness backing the refutation."@x-gmeow-english ;
    logic:formalizes logic:ConjectureShape ;
    logic:severity "Violation" ;
    logic:message "A Conjecture in logic:ConjectureRefutedInStandpoint must name at least one logic:conjectureRefutationWitness (the concrete logic:ContradictionWitness); a refutation with no witness is a hard error." ;
    logic:integrity logic:crwForall .
logic:crwForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:crwImpl .
logic:crwImpl a logic:Formula ; logic:antecedent logic:crwGuard ; logic:consequent logic:crwExists .
logic:crwGuard a logic:Formula ; logic:and logic:crwType , logic:crwRefuted .
logic:crwType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri logic:Conjecture ] .
logic:crwRefuted a logic:Formula ; logic:relation logic:conjectureLifecycleState ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri logic:ConjectureRefutedInStandpoint ] .
logic:crwExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "w" ] ;
    logic:exists logic:crwAtom .
logic:crwAtom a logic:Formula ; logic:relation logic:conjectureRefutationWitness ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "w" ] .

# =========================================================================== #
# Flagship acceptance — the typed conformance-failure lattice and the five
# scenario acceptance witnesses.
#
# The logic grounding layer's depth bar is defined by five flagship acceptance
# scenarios (design/LOGIC-CONFORMANCE.md, LOGIC-CORRESPONDENCE.md,
# LOGIC-SEMANTICS.md, LOGIC-CONTRACT.md, LOGIC-RUNTIME.md), each realized by a
# worked example, pinned by a competency question, emitted by a native producer,
# and guarded by a counter-example that raises a named failure class. This section
# mints that failure lattice — logic:LogicConformanceFailure and its subclasses —
# and the five acceptance-witness classes whose single required carrier the thin
# per-scenario shapes enforce, so every acceptance malformation is a typed,
# queryable object rather than a silent gap.
# =========================================================================== #

logic:LogicConformanceFailure
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Logic Conformance Failure"@x-gmeow-english ;
    skos:definition "The root of the logic grounding layer's typed conformance-failure lattice: every well-formedness violation the logic: slice detects is an instance of one of its subclasses, so a failure is a first-class queryable object rather than an out-of-band error string. Its five bedrock subclasses cover the flagship acceptance scenarios — an incomplete EL/RL/DL closure, a violated correspondence section obligation, an unentrenched counterfactual, an unwitnessed refutation, and an uncertified chase — plus logic:UnwiredFlagshipScenario for an acceptance scenario that does not bind all its realizing/enforcing artifacts and logic:EnactmentIntegrityViolation for an enactment record that breaks one of the enactment kernel's authored integrity laws."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:IncompleteClosure
    a logic:Class ;
    logic:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Incomplete Closure"@x-gmeow-english ;
    skos:definition "The failure raised when a logic:ClosureAcceptanceWitness — the acceptance record of an EL→RL→DL reasoning closure — declares no logic:closureEntailedAtom, i.e. names no atom the closure entails beyond its asserted EDB. A closure that adds nothing is either trivial or truncated; the flagship's guarantee is that the native reason_all closure genuinely derives new entailed atoms, so a witness carrying none is ill-formed and the gate rejects it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:SectionObligationViolated
    a logic:Class ;
    logic:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Section Obligation Violated"@x-gmeow-english ;
    skos:definition "The failure raised when a logic:SectionAcceptanceWitness — the acceptance record of a correspondence section-law discharge — names no logic:dischargesSectionObligation edge, i.e. claims a get/put leg pair round-trips without pointing at the section obligation it discharges. The section law (put ∘ get = identity) is the correspondence's teeth; a witness that discharges no obligation is unfalsifiable, so the gate rejects it (LOGIC-CORRESPONDENCE.md)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:UnentrenchedCounterfactual
    a logic:Class ;
    logic:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Unentrenched Counterfactual"@x-gmeow-english ;
    skos:definition "The failure raised when a logic:CounterfactualAcceptanceWitness — the acceptance record of a Stratum-C counterfactual resolution — names no logic:selectedByEntrenchment outcome, i.e. resolves an antecedent without recording the entrenchment-ranked selection that made the result deterministic. A counterfactual whose outcome is not tied to an entrenchment ordering is a silent, arbitrary choice; the flagship's guarantee is a deterministic entrenchment-ranked selection, so a witness with none is ill-formed (LOGIC-SEMANTICS.md)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:UnwitnessedRefutation
    a logic:Class ;
    logic:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Unwitnessed Refutation"@x-gmeow-english ;
    skos:definition "The failure raised when a logic:RefutationAcceptanceWitness — the acceptance record of a symmetric φ/¬φ conjecture test whose verdict is a refutation — names no logic:namesContradictionWitness, i.e. claims the conjecture was refuted without pointing at the concrete logic:ContradictionWitness that carries the clash. A refutation with no replayable witness is an assertion, not a proof; the flagship's guarantee is that conjecture_test returns a concrete witness on a refutation, so a witness-less refutation record is ill-formed (LOGIC-CONTRACT.md)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:UncertifiedChase
    a logic:Class ;
    logic:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Uncertified Chase"@x-gmeow-english ;
    skos:definition "The failure raised when a logic:ChaseAcceptanceWitness — the acceptance record of an existential-rule chase materialization — carries no logic:carriesTerminationCertificate, i.e. reports a materialized closure without the weak-acyclicity termination certificate that admits it. An uncertified chase may not terminate; the flagship's guarantee is that materialize_existential_rules surfaces the ChaseAdmission termination certificate as a first-class gmeow:Finding, so a chase acceptance record with no certificate is ill-formed (LOGIC-RUNTIME.md)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# Its subsumption is authored as logic:subClassOf, not rdfs:subClassOf: the logic: core is
# the canonical reasoning language and the RDFS form is its projection, so a NEW taxonomy
# axiom belongs in logic: (the projection-ceiling ratchet counts a hand-authored
# rdfs:subClassOf as exactly this kind of second source). Its five older siblings above
# predate that rule and still carry the RDFS form; migrating them is the ratchet's own
# burn-down, not this term's to smuggle in.
logic:EnactmentIntegrityViolation
    a logic:Class ;
    logic:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Enactment Integrity Violation"@x-gmeow-english ;
    skos:definition "The failure raised when an enactment record breaks one of the enactment kernel's authored logic:Constraint integrity laws: a logic:DispatchIntent omitting a mandatory binding, a logic:ExternalEffectReceipt naming no attempt, a logic:ResourceLease claiming a scope another lease holds, a logic:CompensationAttempt typed as the receipt it counteracts, a logic:EffectAttempt carrying derivation provenance. The native enactment gate materializes it by compiling each law's logic:integrity formula into a violation-emitting forward rule — the antecedent plus the NEGATED consequent — and typing the offending record with this class when the guard holds and the obligation fails; the logic:Constraint whose law fired is published ALONGSIDE the marker on logic:violatedLaw, so a reader of the finding sees which law rejected the record and not merely that one did. One class across the kernel's laws rather than one per law, mirroring math:DimensionalInhomogeneity over the two dimension laws: the marker answers WHICH RECORD is ill-formed, logic:violatedLaw answers WHICH LAW says so, and neither question needs a proliferation of marker classes to be answerable."@x-gmeow-english ;
    skos:example "ex:lease-7 a logic:ResourceLease with no logic:fencingIdentity is typed ex:lease-7 a logic:EnactmentIntegrityViolation by the enactment gate."@x-gmeow-english ;
    gmeow:useWhen "Use to query for enactment records the kernel's integrity laws reject, and to assert in a counter-example fixture which record the gate must condemn."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand on a well-formed record: it is a reasoner-materialized marker, and hand-asserting it claims a violation no law derived."@x-gmeow-english ;
    gmeow:howToUse "Author the law as a logic:Constraint carrying gmeow:enforcesFailureClass logic:EnactmentIntegrityViolation and a logic:integrity formula of the shape forall this. guard(this) implies obligation; the enactment gate compiles it, types the violating record, and publishes the law's identity on logic:violatedLaw."@x-gmeow-english ;
    skos:scopeNote "One class across the kernel's laws rather than one per law: the marker answers WHICH RECORD is ill-formed, and logic:violatedLaw answers WHICH LAW says so. Neither question needs a proliferation of marker classes to be answerable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:violatedLaw
    a logic:ObjectProperty ;
    rdfs:range logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "violated law"@x-gmeow-english ;
    skos:definition "Relates a record the native gates condemned to the authored logic:Constraint whose law condemned it. Domain a conformance-failure-marked record (stated in prose, since the marker classes are several and the relation is one). Multi-valued: one record may break several laws, and collapsing that to the first would hide the others. It exists because the failure CLASS is deliberately shared across many laws — the marker says a record is ill-formed, and without this the operator is left to re-derive which of two dozen authored obligations it broke. The gate publishes it from the same violation rule that emitted the marker, so it is derived from the authored law and can never disagree with it."@x-gmeow-english ;
    skos:example "ex:lease-7 logic:violatedLaw logic:LeaseCarriesFencingIdentityConstraint ."@x-gmeow-english ;
    gmeow:useWhen "Use to read, or to query for, WHICH authored law a gate-condemned record broke."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting it by hand: like the marker it accompanies it is reasoner-materialized, and a hand-written one claims a derivation no law made."@x-gmeow-english ;
    gmeow:howToUse "Read it off the finding; it names the logic:Constraint individual, whose logic:message states the obligation in the author's own words."@x-gmeow-english ;
    skos:scopeNote "Multi-valued: one record may break several laws, and collapsing that to the first would hide the others. It exists because the failure class is deliberately shared, so without it an operator must re-derive which of two dozen obligations was broken."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:UnwiredFlagshipScenario
    a logic:Class ;
    logic:subClassOf logic:LogicConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Unwired Flagship Scenario"@x-gmeow-english ;
    skos:definition "The failure raised when a gmeow:FlagshipScenario in the logic grounding layer is not fully wired: it is missing its worked example (gmeow:demonstratedByExample), its competency question (gmeow:demonstratedByCompetency), its producer (gmeow:demonstratedByProducer), its counter-example (gmeow:guardedByCounterExample), or its enforcing failure class (gmeow:enforcesFailureClass); or the class it names as enforcing is not a logic:LogicConformanceFailure subclass. The depth bar is a contract, not a suggestion: an acceptance scenario that does not bind all realizing/enforcing artifacts cannot claim the scenario is met, and the gate rejects it. This layer's concrete realization of the shared gmeow:UnwiredFlagshipScenario marker (enforced uniformly by the shared gmeow:FlagshipScenarioShape); it subclasses ONLY the slice failure root (never the spec-layer gmeow:UnwiredFlagshipScenario marker), so it is a typed, queryable object in this layer's own failure lattice."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# The slice-owned flagship failure-range gate. Its canonical formula requires every enforcing
# class to lie in the transitive LogicConformanceFailure hierarchy; the projector emits the SHACL
# path check and preserves the exact failure type attached to this validation obligation. The
# rdf:type guard is carried inside the formula so this grounding slice does not re-own or retype the
# test-DSL's gmeow:FlagshipScenario term. The membership atom names logic:subClassOf, not
# rdfs:subClassOf: this slice's failure lattice asserts its subsumption on the canonical logic:
# predicate, and rdfs:subClassOf is a downstream projected view — a law that read the view would
# see nothing in the authored TBox and vacuously pass every scenario.
logic:FlagshipScenarioFailureClassConstraint
    a logic:Constraint ;
    rdfs:label "Flagship scenario failure-class constraint"@x-gmeow-english ;
    skos:definition "Requires every logic:-namespaced failure class named by a flagship scenario to be a logic:LogicConformanceFailure or one of its subclasses. Namespace-scoped: the three grounding slices each contribute a failure-range gate over the ONE shared gmeow:FlagshipScenario class, so each validates exactly the failure classes it owns — an unscoped gate would demand every scenario reach every slice's root at once."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:enforcesFailureClass logic:UnwiredFlagshipScenario ;
    logic:formalizes logic:FlagshipScenarioShape ;
    logic:message "A flagship scenario's enforcing failure class must be a logic:LogicConformanceFailure subclass." ;
    logic:integrity logic:fsfcForall .
logic:fsfcForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "failure" ] ;
    logic:forall logic:fsfcImpl .
logic:fsfcImpl a logic:Formula ; logic:antecedent logic:fsfcGuard ; logic:consequent logic:fsfcMembership .
logic:fsfcGuard a logic:Formula ; logic:and logic:fsfcType , logic:fsfcFailurePath , logic:fsfcNsGuard .
logic:fsfcType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:FlagshipScenario ] .
logic:fsfcFailurePath a logic:Formula ; logic:relation gmeow:enforcesFailureClass ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "failure" ] .
logic:fsfcNsGuard a logic:Formula ; logic:relation logic:termStrStarts ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "failure" ] , [ logic:termIndex 1 ; logic:termLiteral "https://blackcatinformatics.ca/logic/" ] .
# Membership is tested against logic:subClassOf, the predicate the failure classes are
# actually authored with. Testing rdfs:subClassOf here asked for the PROJECTED form of an
# axiom the module states canonically, so the gate stopped recognizing its own slice's
# failure classes and reported a conforming flagship scenario as a violation. This is the
# opposite spelling from logic:besSortalUnderEntity above (which correctly names
# rdfs:subClassOf, for its own, different reason recorded there) — the two formulas are
# validated over different graphs, so naming the same predicate in both would be the actual
# bug, not the fix.
logic:fsfcMembership a logic:Formula ; logic:relation logic:subClassOf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "failure" ] , [ logic:termIndex 1 ; logic:termIri logic:LogicConformanceFailure ] .

# =========================================================================== #
# The flagship acceptance-manifest vocabulary, promoted here from the test-DSL  #
# to a first-class ontology surface the shape-derive reads. gmeow:FlagshipScenario#
# and its five wiring predicates are shared, slice-agnostic terms; this grounding #
# slice is their ruled home. The shared structural wiring gate — every flagship   #
# scenario binds exactly one worked example, competency question, native producer, #
# counter-example, and enforcing failure class — is expressed declaratively (each  #
# predicate min-1/max-1 on gmeow:FlagshipScenario) so the derived validation-shape #
# reproduces the legacy gmeow:FlagshipScenarioShape, and the whole obligation is    #
# ALSO carried as a logic:Constraint formalizing gmeow:FlagshipScenarioShape with   #
# the gmeow:UnwiredFlagshipScenario failure identity the guard fixture resolves.     #
# =========================================================================== #

gmeow:FlagshipScenario a logic:Kind , logic:Class ;
    rdfs:label "flagship scenario"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:enforcesFailureClass gmeow:UnwiredFlagshipScenario ;
    skos:definition "A typed acceptance-manifest object reifying one of a grounding slice's flagship acceptance scenarios — its depth bar. Each gmeow:FlagshipScenario binds one scenario to the artifacts that realize and enforce it: the worked example (gmeow:demonstratedByExample), the competency question that pins its structure (gmeow:demonstratedByCompetency), the native producer that emits its output (gmeow:demonstratedByProducer), the counter-example that proves its gate bites (gmeow:guardedByCounterExample), and the named conformance-failure subclass that gate raises (gmeow:enforcesFailureClass). A scenario missing its example, competency, producer, counter-example, or enforcing class, or naming an enforcing class that is not one of the owning slice's conformance-failure subclasses, is unwired and ill-formed (gmeow:UnwiredFlagshipScenario)."@x-gmeow-english ;
    skos:example "exa:e8Symmetry a gmeow:FlagshipScenario ; gmeow:demonstratedByExample \"examples/e8-symmetry.ttl\" ; gmeow:demonstratedByCompetency cq:cqE8RootSystem ; gmeow:demonstratedByProducer \"math::producers::e8_weyl_order\" ; gmeow:guardedByCounterExample \"tests/counter-examples/e8-wrong-weyl-order.ttl\" ; gmeow:enforcesFailureClass math:WrongE8WeylOrder ."@x-gmeow-english ;
    gmeow:useWhen "Use to make a grounding slice's acceptance bar a typed, gated object: one gmeow:FlagshipScenario per flagship, each binding the worked example, competency, producer, counter-example, and enforcing failure class that realize and enforce it."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for ordinary well-formedness invariants (use gmeow:StructuralAssertion) or example-validation outcomes (use gmeow:ExampleConformance); a flagship scenario reifies a depth-bar acceptance case, not a single graph constraint."@x-gmeow-english ;
    gmeow:howToUse "Author one gmeow:FlagshipScenario individual per flagship in the slice's examples/flagship-acceptance.ttl, binding gmeow:demonstratedByExample, gmeow:demonstratedByCompetency, gmeow:demonstratedByProducer, gmeow:guardedByCounterExample, and gmeow:enforcesFailureClass (the last pointing at the owning slice's own conformance-failure subclass)."@x-gmeow-english .

# The five structural wiring obligations, declared as min-1/max-1 restrictions on the class so the
# derived gmeow:FlagshipScenario validation-shape carries the exact cardinality gate. Existence is a
# ClosedWorldClosure opt-in (sh:minCount 1 without minting a reasoner witness); at-most-one is a
# functional property (the four scenario-only predicates) or a scoped max-qualified restriction
# (the shared gmeow:enforcesFailureClass annotation, kept single-valued only on a flagship scenario).
gmeow:FlagshipScenario logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:demonstratedByExample ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:demonstratedByProducer ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:guardedByCounterExample ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:demonstratedByCompetency ; logic:allValuesFrom logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:enforcesFailureClass ; logic:allValuesFrom logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:enforcesFailureClass ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FlagshipScenario ; logic:closureKey "https://blackcatinformatics.ca/gmeow/demonstratedByExample" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FlagshipScenario ; logic:closureKey "https://blackcatinformatics.ca/gmeow/demonstratedByProducer" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FlagshipScenario ; logic:closureKey "https://blackcatinformatics.ca/gmeow/guardedByCounterExample" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FlagshipScenario ; logic:closureKey "https://blackcatinformatics.ca/gmeow/demonstratedByCompetency" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:FlagshipScenario ; logic:closureKey "https://blackcatinformatics.ca/gmeow/enforcesFailureClass" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:UnwiredFlagshipScenario a logic:Category , logic:Class ;
    rdfs:label "unwired flagship scenario"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The shared abstract failure class for a gmeow:FlagshipScenario that is not fully wired: it is missing its worked example (gmeow:demonstratedByExample), competency question (gmeow:demonstratedByCompetency), producer (gmeow:demonstratedByProducer), counter-example (gmeow:guardedByCounterExample), or enforcing failure class (gmeow:enforcesFailureClass); or the class it names as enforcing is not one of the owning slice's conformance-failure subclasses. The depth bar is a contract, not a suggestion: an acceptance scenario that does not bind all realizing/enforcing artifacts cannot claim the scenario is met. Each grounding slice's own <Slice>UnwiredFlagshipScenario subclasses ONLY its slice-local <Slice>ConformanceFailure root (never this spec-layer marker, which is never a subclass target); unwired-detection is instead enforced UNIFORMLY across every slice by the shared gmeow:FlagshipScenarioShape, which carries gmeow:enforcesFailureClass gmeow:UnwiredFlagshipScenario, cross-referencing this shared name with the gate that raises it."@x-gmeow-english ;
    skos:example "gmeow:FlagshipScenarioShape gmeow:enforcesFailureClass gmeow:UnwiredFlagshipScenario ."@x-gmeow-english ;
    gmeow:useWhen "Use as the shared, cross-slice-recognisable name for the wiring failure of an incompletely-wired gmeow:FlagshipScenario; the shared gmeow:FlagshipScenarioShape names it via gmeow:enforcesFailureClass so every slice's unwired scenarios are queryable under one common failure name."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid pointing gmeow:enforcesFailureClass at this abstract marker on a scenario individual; the enforcing class of a real scenario is a concrete slice-local conformance failure, and this marker only names the WIRING failure of the acceptance object itself."@x-gmeow-english ;
    gmeow:howToUse "In a grounding slice, make <Slice>UnwiredFlagshipScenario a subclass of only its own <Slice>ConformanceFailure root; this spec-layer marker itself is never a subclass target. The shared gmeow:FlagshipScenarioShape (not a per-slice shape) already carries gmeow:enforcesFailureClass gmeow:UnwiredFlagshipScenario, so slice authors do not redeclare that annotation."@x-gmeow-english .

gmeow:demonstratedByExample a logic:DatatypeProperty ;
    logic:domain gmeow:FlagshipScenario ;
    logic:range xsd:string ;
    rdfs:label "demonstrated by example"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    skos:definition "Names the worked example that realizes a gmeow:FlagshipScenario, as a SLICE-RELATIVE path string (the same base as gmeow:exampleFile). The referenced *.ttl is the concrete artifact a reader inspects to see the scenario built, and the execution-discharge harness validates it clean."@x-gmeow-english ;
    skos:example "exa:e8Symmetry gmeow:demonstratedByExample \"examples/e8-symmetry.ttl\" ."@x-gmeow-english ;
    gmeow:useWhen "Use on a gmeow:FlagshipScenario to name the slice-relative worked example that realizes it — the positive artifact the discharge harness validates clean."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a repo-root-relative path (this property is slice-relative, like gmeow:exampleFile) and avoid naming more than one worked example per scenario."@x-gmeow-english .

gmeow:demonstratedByCompetency a logic:ObjectProperty ;
    logic:domain gmeow:FlagshipScenario ;
    rdfs:label "demonstrated by competency"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    skos:definition "Names the competency question that pins a gmeow:FlagshipScenario's structure, referenced by IRI (a gmeow:CompetencyQuestion). The competency-question individual lives in the slice's tests/competency.ttl, so this reference is resolved and its gmeow:cqExpectRow expectation confirmed by the native flagship cross-check rather than by SHACL, which never loads the tests dataset."@x-gmeow-english ;
    skos:example "exa:e8Symmetry gmeow:demonstratedByCompetency cq:cqE8RootSystem ."@x-gmeow-english ;
    gmeow:useWhen "Use on a gmeow:FlagshipScenario to reference, by IRI, the gmeow:CompetencyQuestion that pins its structure and numbers."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a literal here (the value is an IRI into tests/competency.ttl) and avoid pointing at a competency question that carries no gmeow:cqExpectRow — the cross-check requires a pinned green competency."@x-gmeow-english .

gmeow:demonstratedByProducer a logic:DatatypeProperty ;
    logic:domain gmeow:FlagshipScenario ;
    logic:range xsd:string ;
    rdfs:label "demonstrated by producer"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    skos:definition "Names the native producer entrypoint that emits a gmeow:FlagshipScenario's output, as a path-like identifier string (e.g. math::producers::e8_weyl_order, pipeline::stages::lang_form::build_corpus). REQUIRED on every gmeow:FlagshipScenario: a scenario carries this binding if and only if the execution-discharge harness actually runs that producer and pins its output — the acceptance bar is discharged by execution, never by an unrun label."@x-gmeow-english ;
    skos:example "exa:e8Symmetry gmeow:demonstratedByProducer \"math::producers::e8_weyl_order\" ."@x-gmeow-english ;
    gmeow:useWhen "Use on every gmeow:FlagshipScenario to name the native producer identifier the execution-discharge harness dispatches and runs."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid omitting it (the producer binding is required) and avoid naming a producer the discharge harness does not actually run — an unrun label is not a discharged acceptance bar."@x-gmeow-english .

gmeow:guardedByCounterExample a logic:DatatypeProperty ;
    logic:domain gmeow:FlagshipScenario ;
    logic:range xsd:string ;
    rdfs:label "guarded by counter-example"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    skos:definition "Names the counter-example that proves a gmeow:FlagshipScenario's gate bites, as a SLICE-RELATIVE path string. The referenced tests/counter-examples/*.ttl is the minimal violation that raises the scenario's gmeow:enforcesFailureClass; per the conformance discipline, a rule with no negative fixture is not considered enforced, and the execution-discharge harness runs the fixture and confirms exactly that class fires."@x-gmeow-english ;
    skos:example "exa:e8Symmetry gmeow:guardedByCounterExample \"tests/counter-examples/e8-wrong-weyl-order.ttl\" ."@x-gmeow-english ;
    gmeow:useWhen "Use on a gmeow:FlagshipScenario to name the slice-relative minimal counter-example that raises its enforcing failure class — the negative fixture that proves the gate bites."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid a repo-root-relative path (this property is slice-relative) and avoid a counter-example that raises any failure class other than the scenario's gmeow:enforcesFailureClass."@x-gmeow-english .

gmeow:enforcesFailureClass a logic:AnnotationProperty ;
    rdfs:label "enforces failure class"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    skos:definition "Links a gate — a SHACL shape or a gmeow:FlagshipScenario — to the conformance-failure subclass it enforces, so the machine-checked gate and the typed failure vocabulary are cross-referenced: a query can move from a gate to the named failure it raises and back. Carried on a SHACL shape (the shape enforcing that failure) or on a gmeow:FlagshipScenario (the failure its guarding counter-example must raise). An annotation property, never a reasoned axiom; its value is a slice-local <Slice>ConformanceFailure subclass."@x-gmeow-english ;
    skos:example "math:UnsituatedNumberShape gmeow:enforcesFailureClass math:UnsituatedNumber ."@x-gmeow-english ;
    gmeow:useWhen "Use on a SHACL gate shape or a gmeow:FlagshipScenario to name the conformance-failure subclass it enforces, cross-referencing the machine-checked gate with the typed failure vocabulary."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating it as a reasoned axiom (it is an annotation) and avoid pointing it at a class that is not one of the owning slice's conformance-failure subclasses."@x-gmeow-english .

# The shared structural wiring gate as a canonical logic: constraint: every gmeow:FlagshipScenario
# binds min-1 of each of the five wiring predicates. It formalizes gmeow:FlagshipScenarioShape and
# carries the gmeow:UnwiredFlagshipScenario failure identity the guard fixture resolves, and it
# record-backs the derived declarative shape's typed-IRI enforcing-class obligation.
gmeow:FlagshipScenarioWiringConstraint
    a logic:Constraint ;
    rdfs:label "Flagship scenario wiring constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:FlagshipScenario binds at least one worked example, competency question, native producer, counter-example, and enforcing failure class. An acceptance scenario missing any realizing/enforcing artifact is unwired (gmeow:UnwiredFlagshipScenario)."@x-gmeow-english ;
    gmeow:enforcesFailureClass gmeow:UnwiredFlagshipScenario ;
    logic:formalizes gmeow:FlagshipScenarioShape ;
    logic:severity "Violation" ;
    logic:message "A gmeow:FlagshipScenario must bind exactly one worked example, competency question, native producer, counter-example, and enforcing failure class; an acceptance scenario that does not wire all realizing artifacts is unwired." ;
    logic:integrity logic:fswForall .
logic:fswForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:fswImpl .
logic:fswImpl a logic:Formula ; logic:antecedent logic:fswGuard ; logic:consequent logic:fswAnd .
logic:fswGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:FlagshipScenario ] .
logic:fswAnd a logic:Formula ; logic:and logic:fswExample , logic:fswCompetency , logic:fswProducer , logic:fswCounter , logic:fswFailure .
logic:fswExample a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "ex" ] ; logic:exists logic:fswExampleAtom .
logic:fswExampleAtom a logic:Formula ; logic:relation gmeow:demonstratedByExample ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "ex" ] .
logic:fswCompetency a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "cq" ] ; logic:exists logic:fswCompetencyAtom .
logic:fswCompetencyAtom a logic:Formula ; logic:relation gmeow:demonstratedByCompetency ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "cq" ] .
logic:fswProducer a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "pr" ] ; logic:exists logic:fswProducerAtom .
logic:fswProducerAtom a logic:Formula ; logic:relation gmeow:demonstratedByProducer ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "pr" ] .
logic:fswCounter a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "ce" ] ; logic:exists logic:fswCounterAtom .
logic:fswCounterAtom a logic:Formula ; logic:relation gmeow:guardedByCounterExample ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "ce" ] .
logic:fswFailure a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "fc" ] ; logic:exists logic:fswFailureAtom .
logic:fswFailureAtom a logic:Formula ; logic:relation gmeow:enforcesFailureClass ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "fc" ] .

# --- The five scenario acceptance-witness classes and their carriers -------- #

logic:ClosureAcceptanceWitness
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Closure Acceptance Witness"@x-gmeow-english ;
    skos:definition "The acceptance record that an EL→RL→DL reasoning closure (gmeow_logic::reason::reason_all) genuinely entailed new atoms: it names, through logic:closureEntailedAtom, at least one atom the closure derived beyond its asserted EDB. The flagship producer runs the native closure and pins that a designated entailed atom is present and absent from the EDB; this witness is the ontological twin the thin logic:ClosureAcceptanceWitnessShape gates."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:closureEntailedAtom
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "closure entailed atom"@x-gmeow-english ;
    skos:definition "Relates a logic:ClosureAcceptanceWitness to a serialized atom (xsd:string, e.g. `A subClassOf C`) that the EL→RL→DL closure entails but the asserted EDB does not contain. Domain logic:ClosureAcceptanceWitness (stated in prose). At least one is required: a closure witness that entails nothing beyond its input demonstrates no reasoning."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:SectionAcceptanceWitness
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Section Acceptance Witness"@x-gmeow-english ;
    skos:definition "The acceptance record that a correspondence get/put leg pair discharges its section law (put ∘ get = identity), executed natively by gmeow_logic::correspondence_exec::leg_pair_verdict. It names, through logic:dischargesSectionObligation, the section obligation the executed round-trip discharges. The flagship producer runs the native discharge and pins that a genuine inverse yields DischargeVerdict::ObligationDischarged while a broken section does not; this witness is the ontological twin the thin logic:SectionAcceptanceWitnessShape gates."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:dischargesSectionObligation
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "discharges section obligation"@x-gmeow-english ;
    skos:definition "Relates a logic:SectionAcceptanceWitness to the section obligation (an IRI) its executed get/put round-trip discharges. Domain logic:SectionAcceptanceWitness (stated in prose). Exactly the edge whose absence makes the discharge unfalsifiable: a section witness that names no obligation asserts a round-trip without saying which law it satisfies."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:CounterfactualAcceptanceWitness
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Counterfactual Acceptance Witness"@x-gmeow-english ;
    skos:definition "The acceptance record that a Stratum-C counterfactual world was constructed and resolved to a deterministic outcome, executed natively by gmeow_logic::counterfactual::construct_and_resolve over the entrenchment ordering. It names, through logic:selectedByEntrenchment, the outcome the entrenchment ranking selected. The flagship producer runs the native resolution and pins the deterministic selected binding; this witness is the ontological twin the thin logic:CounterfactualAcceptanceWitnessShape gates."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:selectedByEntrenchment
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "selected by entrenchment"@x-gmeow-english ;
    skos:definition "Relates a logic:CounterfactualAcceptanceWitness to the outcome (an IRI) the entrenchment ranking deterministically selected when resolving the counterfactual antecedent. Domain logic:CounterfactualAcceptanceWitness (stated in prose). Its absence marks an unentrenched, arbitrary counterfactual: an outcome chosen without a recorded ordering is a silent guess."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:RefutationAcceptanceWitness
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Refutation Acceptance Witness"@x-gmeow-english ;
    skos:definition "The acceptance record that a symmetric φ/¬φ conjecture test resolved to a refutation carrying a concrete contradiction witness, executed natively by gmeow_logic::conjecture::conjecture_test. It names, through logic:namesContradictionWitness, the logic:ContradictionWitness the refutation rests on. The flagship producer runs the native test and pins that a refutation case yields Some(witness) while a corroboration case yields None; this witness is the ontological twin the thin logic:RefutationAcceptanceWitnessShape gates."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:namesContradictionWitness
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "names contradiction witness"@x-gmeow-english ;
    skos:definition "Relates a logic:RefutationAcceptanceWitness to the concrete logic:ContradictionWitness (an IRI) its refutation rests on — the individual forced to OWL Nothing and the jointly-inconsistent premises. Domain logic:RefutationAcceptanceWitness (stated in prose). A refutation naming no witness is an unreplayable assertion, not a proof."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:ChaseAcceptanceWitness
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Chase Acceptance Witness"@x-gmeow-english ;
    skos:definition "The acceptance record that an existential-rule chase materialization terminated under a weak-acyclicity certificate, executed natively by gmeow_logic::materialize::materialize_existential_rules, which surfaces the ChaseAdmission termination certificate as a first-class gmeow:Finding. It carries, through logic:carriesTerminationCertificate, the certificate evidence. The flagship producer runs the native chase and pins that the surfaced Finding is non-empty and that the derivation carries an explain trace passing gmeow_logic::explain::assert_faithful; this witness is the ontological twin the thin logic:ChaseAcceptanceWitnessShape gates."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:carriesTerminationCertificate
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "carries termination certificate"@x-gmeow-english ;
    skos:definition "Relates a logic:ChaseAcceptanceWitness to the weak-acyclicity termination-certificate evidence (xsd:string, the ChaseAdmission::WeaklyAcyclic evidence summary) that admits its chase. Domain logic:ChaseAcceptanceWitness (stated in prose). A chase acceptance record with no certificate reports a closure that may never terminate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# The repo-wide gmeow: annotation-completeness meta-constraints. Each is a       #
# whole-shape logic:Constraint reproducing the namespace-filter sh:SPARQLTarget  #
# focus and the four annotation-completeness obligations (rdfs:label,            #
# skos:definition, rdfs:isDefinedBy, gmeow:graphBoxRole), and formalizes the     #
# corresponding validation-shape IRI. The structural minCount obligations are    #
# machine-readable, so the semantic witness cross-check (structural-side pinned) #
# proves the record reproduces the shape's judgments over every graph.          #
# =========================================================================== #

gmeow:GmeowClassCompletenessConstraint
    a logic:Constraint ;
    rdfs:label "GMEOW class annotation-completeness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:-namespaced OWL Class carries at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one gmeow:graphBoxRole."@x-gmeow-english ;
    logic:formalizes gmeow:GmeowClassShape ;
    logic:severity "Violation" ;
    logic:message "Every GMEOW class must carry at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one IRI-valued gmeow:graphBoxRole." ;
    logic:integrity logic:gccForall .
logic:gccForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:gccImpl .
logic:gccImpl a logic:Formula ; logic:antecedent logic:gccTarget ; logic:consequent logic:gccAnd .
logic:gccTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral """SELECT ?this WHERE {
    ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Class> .
    FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
}""" ] .
logic:gccAnd a logic:Formula ; logic:and logic:gccLabel , logic:gccDef , logic:gccDefBy , logic:gccRole .
logic:gccLabel a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "l" ] ; logic:exists logic:gccLabelAtom .
logic:gccLabelAtom a logic:Formula ; logic:relation rdfs:label ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "l" ] .
logic:gccDef a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] ; logic:exists logic:gccDefAtom .
logic:gccDefAtom a logic:Formula ; logic:relation skos:definition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
logic:gccDefBy a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "i" ] ; logic:exists logic:gccDefByAtom .
logic:gccDefByAtom a logic:Formula ; logic:relation rdfs:isDefinedBy ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "i" ] .
logic:gccRole a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "r" ] ; logic:exists logic:gccRoleAtom .
logic:gccRoleAtom a logic:Formula ; logic:relation gmeow:graphBoxRole ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] .

gmeow:GmeowPropertyCompletenessConstraint
    a logic:Constraint ;
    rdfs:label "GMEOW property annotation-completeness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:-namespaced owl object/datatype/annotation property carries at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one gmeow:graphBoxRole."@x-gmeow-english ;
    logic:formalizes gmeow:GmeowPropertyShape ;
    logic:severity "Violation" ;
    logic:message "Every GMEOW property must carry at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one IRI-valued gmeow:graphBoxRole." ;
    logic:integrity logic:gpcForall .
logic:gpcForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:gpcImpl .
logic:gpcImpl a logic:Formula ; logic:antecedent logic:gpcTarget ; logic:consequent logic:gpcAnd .
logic:gpcTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral """SELECT ?this WHERE {
    ?this a ?t .
    FILTER(?t IN (
        <http://www.w3.org/2002/07/owl#ObjectProperty>,
        <http://www.w3.org/2002/07/owl#DatatypeProperty>,
        <http://www.w3.org/2002/07/owl#AnnotationProperty>
    ))
    FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
}""" ] .
logic:gpcAnd a logic:Formula ; logic:and logic:gpcLabel , logic:gpcDef , logic:gpcDefBy , logic:gpcRole .
logic:gpcLabel a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "l" ] ; logic:exists logic:gpcLabelAtom .
logic:gpcLabelAtom a logic:Formula ; logic:relation rdfs:label ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "l" ] .
logic:gpcDef a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] ; logic:exists logic:gpcDefAtom .
logic:gpcDefAtom a logic:Formula ; logic:relation skos:definition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
logic:gpcDefBy a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "i" ] ; logic:exists logic:gpcDefByAtom .
logic:gpcDefByAtom a logic:Formula ; logic:relation rdfs:isDefinedBy ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "i" ] .
logic:gpcRole a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "r" ] ; logic:exists logic:gpcRoleAtom .
logic:gpcRoleAtom a logic:Formula ; logic:relation gmeow:graphBoxRole ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] .

# The repo-wide private-use language-tag gate. A whole-shape logic:Constraint whose focus is any
# subject carrying a gmeow:-namespaced predicate with a language-tagged literal (a predicate-PREFIX
# sh:SPARQLTarget, filtering on ?p — not ?this), obligating every such tagged literal to use the
# private-use x-gmeow-* language-tag prefix. It introspects the value's LANGUAGE TAG through the
# logic:termLangMatches / logic:termHasLang term algebra, so the tag-prefix convention is a
# first-class logic: check. Formalizes gmeow:InternalLanguageTagShape.
gmeow:GmeowInternalLanguageTagConstraint
    a logic:Constraint ;
    rdfs:label "GMEOW internal private-use language-tag constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every language-tagged literal object of a gmeow:-namespaced predicate must carry a language tag under the private-use x-gmeow-* prefix (case-insensitive ^x-gmeow-[a-z0-9-]+$). Introspects the value's language tag via logic:termHasLang and logic:termLangMatches so the repo-wide localizable-prose convention is enforced by the logic: core, not a hand-authored shape surface."@x-gmeow-english ;
    logic:formalizes gmeow:InternalLanguageTagShape ;
    logic:severity "Violation" ;
    logic:message "Literals in GMEOW must use the 'x-gmeow-' private-use prefix for language tags." ;
    logic:integrity logic:iltForall .
logic:iltForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:iltImpl .
logic:iltImpl a logic:Formula ; logic:antecedent logic:iltTarget ; logic:consequent logic:iltOk .
logic:iltTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral """SELECT DISTINCT ?this WHERE {
    ?this ?p ?value .
    FILTER (STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/"))
    FILTER (isLiteral(?value) && lang(?value) != "")
}""" ] .
# The per-focus OK condition: no gmeow:-namespaced tagged literal violates the private-use prefix.
logic:iltOk a logic:Formula ; logic:not logic:iltBad .
logic:iltBad a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termVariable "value" ] ;
    logic:exists logic:iltBadBody .
logic:iltBadBody a logic:Formula ; logic:and logic:iltLink , logic:iltNs , logic:iltLit , logic:iltHasLang , logic:iltNotOk .
logic:iltLink a logic:Formula ; logic:relation logic:linkVia ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] , [ logic:termIndex 2 ; logic:termVariable "value" ] .
logic:iltNs a logic:Formula ; logic:relation logic:termStrStarts ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "p" ] , [ logic:termIndex 1 ; logic:termLiteral "https://blackcatinformatics.ca/gmeow/" ] .
logic:iltLit a logic:Formula ; logic:relation logic:termIsLiteral ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] .
logic:iltHasLang a logic:Formula ; logic:relation logic:termHasLang ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] .
logic:iltNotOk a logic:Formula ; logic:not logic:iltMatch .
logic:iltMatch a logic:Formula ; logic:relation logic:termLangMatches ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] , [ logic:termIndex 1 ; logic:termLiteral "^x-gmeow-[a-z0-9-]+$" ] .

gmeow:GmeowDatatypeCompletenessConstraint
    a logic:Constraint ;
    rdfs:label "GMEOW datatype annotation-completeness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:-namespaced rdfs:Datatype carries at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one gmeow:graphBoxRole."@x-gmeow-english ;
    logic:formalizes gmeow:GmeowDatatypeShape ;
    logic:severity "Violation" ;
    logic:message "Every GMEOW datatype must carry at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one IRI-valued gmeow:graphBoxRole." ;
    logic:integrity logic:gdcForall .
logic:gdcForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:gdcImpl .
logic:gdcImpl a logic:Formula ; logic:antecedent logic:gdcTarget ; logic:consequent logic:gdcAnd .
logic:gdcTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral """SELECT ?this WHERE {
    ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2000/01/rdf-schema#Datatype> .
    FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
}""" ] .
logic:gdcAnd a logic:Formula ; logic:and logic:gdcLabel , logic:gdcDef , logic:gdcDefBy , logic:gdcRole .
logic:gdcLabel a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "l" ] ; logic:exists logic:gdcLabelAtom .
logic:gdcLabelAtom a logic:Formula ; logic:relation rdfs:label ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "l" ] .
logic:gdcDef a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] ; logic:exists logic:gdcDefAtom .
logic:gdcDefAtom a logic:Formula ; logic:relation skos:definition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
logic:gdcDefBy a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "i" ] ; logic:exists logic:gdcDefByAtom .
logic:gdcDefByAtom a logic:Formula ; logic:relation rdfs:isDefinedBy ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "i" ] .
logic:gdcRole a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "r" ] ; logic:exists logic:gdcRoleAtom .
logic:gdcRoleAtom a logic:Formula ; logic:relation gmeow:graphBoxRole ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] .

gmeow:GmeowOntologyCompletenessConstraint
    a logic:Constraint ;
    rdfs:label "GMEOW ontology-header annotation-completeness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:-namespaced OWL Ontology header carries at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one gmeow:graphBoxRole."@x-gmeow-english ;
    logic:formalizes gmeow:GmeowOntologyShape ;
    logic:severity "Violation" ;
    logic:message "Every GMEOW ontology header must carry at least one rdfs:label, one skos:definition, one rdfs:isDefinedBy, and one IRI-valued gmeow:graphBoxRole." ;
    logic:integrity logic:gocForall .
logic:gocForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:gocImpl .
logic:gocImpl a logic:Formula ; logic:antecedent logic:gocTarget ; logic:consequent logic:gocAnd .
logic:gocTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral """SELECT ?this WHERE {
    ?this <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Ontology> .
    FILTER(
        STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/")
        || STR(?this) = "https://blackcatinformatics.ca/gmeow"
    )
}""" ] .
logic:gocAnd a logic:Formula ; logic:and logic:gocLabel , logic:gocDef , logic:gocDefBy , logic:gocRole .
logic:gocLabel a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "l" ] ; logic:exists logic:gocLabelAtom .
logic:gocLabelAtom a logic:Formula ; logic:relation rdfs:label ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "l" ] .
logic:gocDef a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] ; logic:exists logic:gocDefAtom .
logic:gocDefAtom a logic:Formula ; logic:relation skos:definition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
logic:gocDefBy a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "i" ] ; logic:exists logic:gocDefByAtom .
logic:gocDefByAtom a logic:Formula ; logic:relation rdfs:isDefinedBy ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "i" ] .
logic:gocRole a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "r" ] ; logic:exists logic:gocRoleAtom .
logic:gocRoleAtom a logic:Formula ; logic:relation gmeow:graphBoxRole ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "r" ] .

# ── Canonical OWL/RDFS construct vocabulary ────────────────────────────────────
# These are the logic:-native terms the frontend lifts OWL into and the projection
# lowers back out of. They were historically implemented only as Rust string tables;
# declaring them here makes logic: the usable authoring target rather than a hidden IR.

logic:Restriction
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Restriction"@x-gmeow-english ;
    skos:definition "A canonical logic: class-expression restriction: a constraint over one logic:onProperty together with one or more value or cardinality constraints. OWL's OWL Restriction is a generated dialect form of this construct, not the canonical authoring term."@x-gmeow-english ;
    skos:example "ex:memberRestriction a logic:Restriction ; logic:onProperty ex:member ; logic:someValuesFrom ex:Person ."@x-gmeow-english ;
    skos:scopeNote "A restriction is a class expression in the canonical logic graph, even when projected as an OWL blank node."@x-gmeow-english ;
    gmeow:useWhen "Use to constrain the values or cardinality of one property in a class expression."@x-gmeow-english ;
    gmeow:avoidWhen "Do not author OWL Restriction as a second canonical source."@x-gmeow-english ;
    gmeow:howToUse "Name one logic:onProperty and add the applicable value, unqualified-cardinality, or qualified-cardinality predicate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Enumeration
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Enumeration"@x-gmeow-english ;
    skos:definition "A finite class expression whose members are named by a logic:oneOf RDF list. It lowers to an OWL nominal (OWL oneOf) and remains first-class in logic: even when a weaker target profile cannot carry nominals."@x-gmeow-english ;
    skos:example "ex:trafficLightState a logic:Enumeration ; logic:oneOf ( ex:red ex:amber ex:green ) ."@x-gmeow-english ;
    skos:scopeNote "Enumeration denotes exactly the listed members; list order does not imply preference or rank."@x-gmeow-english ;
    gmeow:useWhen "Use for a finite class or datarange whose complete extension is explicitly listed."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for an open code list that may gain unlisted members."@x-gmeow-english ;
    gmeow:howToUse "Attach one logic:oneOf RDF list containing every admitted IRI or literal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Datarange
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Datarange"@x-gmeow-english ;
    skos:definition "A constrained datatype expression: one logic:onDatatype plus a logic:withRestrictions list of facet constraints. It is the canonical form lowered to OWL 2 datatype restrictions when the target can represent them, not a literal value or an unconstrained datatype name."@x-gmeow-english ;
    skos:example "ex:adultAge a logic:Datarange ; logic:onDatatype xsd:integer ; logic:withRestrictions ( [ xsd:minInclusive 18 ] ) ."@x-gmeow-english ;
    skos:scopeNote "Facet records retain their native datatype-facet predicates inside the ordered restriction list."@x-gmeow-english ;
    gmeow:useWhen "Use for a datatype narrowed by one or more explicit facets."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for a bare datatype that has no facet restrictions."@x-gmeow-english ;
    gmeow:howToUse "Name the base with logic:onDatatype and supply the facet records through one logic:withRestrictions list."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:subClassOf
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "subclass of"@x-gmeow-english ;
    skos:definition "Canonical class subsumption: every instance of the subject type is an instance of the object type. It is not a lexical hierarchy hint; it lowers to rdfs:subClassOf on the OWL/RDFS projection surface."@x-gmeow-english ;
    skos:example "ex:Cat logic:subClassOf ex:Animal ."@x-gmeow-english ;
    skos:scopeNote "The edge carries extensional implication from subject class to object class."@x-gmeow-english ;
    gmeow:useWhen "Use when membership in one class logically entails membership in another."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for topic grouping, navigation, or a merely approximate taxonomic relation."@x-gmeow-english ;
    gmeow:howToUse "Place the narrower class expression as subject and the broader class expression as object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:equivalentClass
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "equivalent class"@x-gmeow-english ;
    skos:definition "Canonical extensional equivalence between two class expressions. It is not similarity or close matching; it lowers to OWL equivalentClass only when the selected projection can preserve the claim."@x-gmeow-english ;
    skos:example "ex:EveningStar logic:equivalentClass ex:MorningStarDescription ."@x-gmeow-english ;
    skos:scopeNote "Equivalence entails both subsumption directions and therefore requires stronger evidence than a bridge relation."@x-gmeow-english ;
    gmeow:useWhen "Use only when both class expressions have the same extension in the governing theory."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for commitment-shifting upper-ontology bridges or approximate matches."@x-gmeow-english ;
    gmeow:howToUse "Connect the two class expressions and ensure the projection's preservation judgment licenses equivalence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:disjointWith
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "disjoint with"@x-gmeow-english ;
    skos:definition "Canonical class disjointness: no individual may instantiate both class expressions. Distinct from logic:disjoint, the mereological relation between individuals; lowers to OWL disjointWith."@x-gmeow-english ;
    skos:example "ex:Continuant logic:disjointWith ex:Occurrent ."@x-gmeow-english ;
    skos:scopeNote "The assertion is symmetric at the class-extension level even when written in one direction."@x-gmeow-english ;
    gmeow:useWhen "Use when the two class extensions are required not to overlap."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use merely because two labels contrast or current data has no shared instance."@x-gmeow-english ;
    gmeow:howToUse "Connect two class expressions only after a negative competency case confirms that dual typing is inconsistent."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:subPropertyOf
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "subproperty of"@x-gmeow-english ;
    skos:definition "Canonical relation subsumption: every pair related by the subject property is related by the object property. It is not a label hierarchy; it lowers to rdfs:subPropertyOf."@x-gmeow-english ;
    skos:example "ex:biologicalParentOf logic:subPropertyOf ex:parentOf ."@x-gmeow-english ;
    skos:scopeNote "Every subject-object pair in the narrower relation is entailed in the broader relation."@x-gmeow-english ;
    gmeow:useWhen "Use when one relation extension is contained in another relation extension."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for two predicates that are only associated by subject matter."@x-gmeow-english ;
    gmeow:howToUse "Place the narrower property as subject and the entailed broader property as object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:equivalentProperty
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "equivalent property"@x-gmeow-english ;
    skos:definition "Canonical extensional equivalence between two properties. It is not a related-property hint; it lowers to OWL equivalentProperty only when the projection preserves the full relation."@x-gmeow-english ;
    skos:example "ex:hasBiologicalMother logic:equivalentProperty ex:biologicalMotherRelation ."@x-gmeow-english ;
    skos:scopeNote "Equivalent properties entail identical ordered subject-object pair extensions."@x-gmeow-english ;
    gmeow:useWhen "Use when each property entails the other for every ordered pair."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for inverse, broader, narrower, or merely similar relations."@x-gmeow-english ;
    gmeow:howToUse "Connect the two properties and retain an exact-enough preservation judgment for the target projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:inverseOf
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "inverse of"@x-gmeow-english ;
    skos:definition "Canonical inverse-relation declaration: P(x,y) holds exactly when Q(y,x) holds. It is not property equivalence because the argument order reverses; it lowers to OWL inverseOf."@x-gmeow-english ;
    skos:example "ex:parentOf logic:inverseOf ex:childOf ."@x-gmeow-english ;
    skos:scopeNote "The declaration is symmetric between the two property names while reversing each related pair."@x-gmeow-english ;
    gmeow:useWhen "Use when one binary relation holds exactly for the reversed pairs of another."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use when the two relations merely tend to co-occur or differ in scope."@x-gmeow-english ;
    gmeow:howToUse "Connect the forward property to its reverse and verify both implication directions."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:domain
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "domain"@x-gmeow-english ;
    skos:definition "Canonical domain entailment for a property: using the property entails that its subject instantiates the named type. It is not a closed-world validation constraint; it lowers to rdfs:domain."@x-gmeow-english ;
    skos:example "ex:memberOf logic:domain ex:Agent ."@x-gmeow-english ;
    skos:scopeNote "Multiple domain axioms are conjunctive entailments, not alternative allowed subject types."@x-gmeow-english ;
    gmeow:useWhen "Use when every subject using the property must be inferred to have the named type."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to reject untyped subjects or to express a disjunctive validation menu."@x-gmeow-english ;
    gmeow:howToUse "Connect the property to the entailed subject type and use a validation constraint separately when rejection is required."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:range
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "range"@x-gmeow-english ;
    skos:definition "Canonical range entailment for a property: using the property entails that its object instantiates the named type or datatype. It is not a closed-world validation constraint; it lowers to rdfs:range."@x-gmeow-english ;
    skos:example "ex:memberOf logic:range ex:Organization ."@x-gmeow-english ;
    skos:scopeNote "Multiple range axioms are conjunctive entailments, not alternative allowed object types."@x-gmeow-english ;
    gmeow:useWhen "Use when every object reached through the property must be inferred to have the named type or datatype."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to reject an object or to express a disjunctive validation menu."@x-gmeow-english ;
    gmeow:howToUse "Connect the property to the entailed object type and add a separate validation constraint when enforcement is required."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:inverseFunctionalProperty
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "inverse-functional property"@x-gmeow-english ;
    skos:definition "The logic: property-characteristic marker for inverse functionality: P(a,c) and P(b,c) entail a = b. It is not ordinary functionality, which constrains objects per subject; the OWL projection is OWL InverseFunctionalProperty."@x-gmeow-english ;
    skos:example "ex:identifiedBy a logic:inverseFunctionalProperty ."@x-gmeow-english ;
    skos:scopeNote "Inverse functionality identifies subjects that share one object and can trigger equality reasoning."@x-gmeow-english ;
    gmeow:useWhen "Use when one object may identify at most one subject in the governing interpretation."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for a property that merely has unique values in the current dataset."@x-gmeow-english ;
    gmeow:howToUse "Type the property with this characteristic and provide an equality competency case for shared objects."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:reflexiveProperty
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "reflexive property"@x-gmeow-english ;
    skos:definition "The logic: property-characteristic marker for reflexivity: every individual in scope relates to itself through the property. It is not evidence that self-edges were explicitly asserted; the OWL projection is OWL ReflexiveProperty."@x-gmeow-english ;
    skos:example "ex:connectedTo a logic:reflexiveProperty ."@x-gmeow-english ;
    skos:scopeNote "Reflexivity is a global semantic characteristic of the property over the interpretation domain."@x-gmeow-english ;
    gmeow:useWhen "Use when the relation must hold from every in-scope individual to itself."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for a relation whose self-cases are merely permitted or commonly observed."@x-gmeow-english ;
    gmeow:howToUse "Type the property with this characteristic and test that a representative self-edge is entailed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:onProperty
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "on property"@x-gmeow-english ;
    skos:definition "Names the property constrained by a logic:Restriction. It is not an assertion using that property; it lowers to OWL onProperty."@x-gmeow-english ;
    skos:example "ex:memberRestriction logic:onProperty ex:member ."@x-gmeow-english ;
    skos:scopeNote "Each restriction selects one property before stating its value or cardinality condition."@x-gmeow-english ;
    gmeow:useWhen "Use to identify the property whose fillers a logic:Restriction constrains."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use as the constrained domain relation itself."@x-gmeow-english ;
    gmeow:howToUse "Attach exactly one constrained property to the restriction before adding its restriction predicate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:someValuesFrom
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "some values from"@x-gmeow-english ;
    skos:definition "Existential restriction value: at least one value reached through logic:onProperty belongs to the named class or datarange. It does not constrain every filler; it lowers to OWL someValuesFrom."@x-gmeow-english ;
    skos:example "ex:parentRestriction logic:someValuesFrom ex:Person ."@x-gmeow-english ;
    skos:scopeNote "The restriction entails the existence of at least one qualifying filler."@x-gmeow-english ;
    gmeow:useWhen "Use when class membership requires at least one property value in a named class or datarange."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use when all fillers must qualify or when no filler existence is intended."@x-gmeow-english ;
    gmeow:howToUse "Pair it with logic:onProperty on the same restriction and name the required filler class or datarange."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:allValuesFrom
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "all values from"@x-gmeow-english ;
    skos:definition "Universal restriction value: every value reached through logic:onProperty belongs to the named class or datarange. It does not assert that any filler exists; it lowers to OWL allValuesFrom."@x-gmeow-english ;
    skos:example "ex:teamRestriction logic:allValuesFrom ex:Person ."@x-gmeow-english ;
    skos:scopeNote "The condition is vacuously satisfied when the constrained property has no values."@x-gmeow-english ;
    gmeow:useWhen "Use when every existing filler of the selected property must belong to one class or datarange."@x-gmeow-english ;
    gmeow:avoidWhen "Do not rely on it to require at least one filler."@x-gmeow-english ;
    gmeow:howToUse "Pair it with logic:onProperty and add an existential or minimum-cardinality condition separately when presence is required."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:hasValue
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "has value"@x-gmeow-english ;
    skos:definition "Value restriction requiring the logic:onProperty relation to contain one named IRI or literal. It is not a range declaration; it lowers to OWL hasValue."@x-gmeow-english ;
    skos:example "ex:activeRestriction logic:hasValue ex:active ."@x-gmeow-english ;
    skos:scopeNote "The required filler is one concrete RDF term rather than a class of possible fillers."@x-gmeow-english ;
    gmeow:useWhen "Use when the constrained property must include a specific IRI or literal value."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to constrain fillers by class; use logic:someValuesFrom or logic:allValuesFrom instead."@x-gmeow-english ;
    gmeow:howToUse "Pair the concrete required value with logic:onProperty on the same restriction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:minCardinality
    a logic:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "minimum cardinality"@x-gmeow-english ;
    skos:definition "The inclusive minimum number of logic:onProperty values required by an unqualified logic:Restriction. It does not filter fillers by class or datarange; it lowers to OWL minCardinality."@x-gmeow-english ;
    skos:example "ex:teamRestriction logic:minCardinality 1 ."@x-gmeow-english ;
    skos:scopeNote "The count ranges over all distinct fillers of the selected property."@x-gmeow-english ;
    gmeow:useWhen "Use to require at least a non-negative number of property fillers regardless of their type."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to set a lower bound when only fillers of a qualifying class or datarange should be counted; use logic:minQualifiedCardinality instead."@x-gmeow-english ;
    gmeow:howToUse "Pair a non-negative integer with logic:onProperty; use logic:minQualifiedCardinality for a qualified count."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:maxCardinality
    a logic:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "maximum cardinality"@x-gmeow-english ;
    skos:definition "The inclusive maximum number of logic:onProperty values permitted by an unqualified logic:Restriction. It does not filter fillers by class or datarange; it lowers to OWL maxCardinality."@x-gmeow-english ;
    skos:example "ex:primaryContactRestriction logic:maxCardinality 1 ."@x-gmeow-english ;
    skos:scopeNote "The count ranges over all distinct fillers of the selected property."@x-gmeow-english ;
    gmeow:useWhen "Use to permit at most a non-negative number of property fillers regardless of their type."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to set an upper bound when only fillers of a qualifying class or datarange should be counted; use logic:maxQualifiedCardinality instead."@x-gmeow-english ;
    gmeow:howToUse "Pair a non-negative integer with logic:onProperty; use logic:maxQualifiedCardinality for a qualified count."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:cardinality
    a logic:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "cardinality"@x-gmeow-english ;
    skos:definition "The exact number of logic:onProperty values required by an unqualified logic:Restriction. It does not filter fillers by class or datarange; it lowers to OWL cardinality."@x-gmeow-english ;
    skos:example "ex:birthMotherRestriction logic:cardinality 1 ."@x-gmeow-english ;
    skos:scopeNote "Exact cardinality combines the corresponding inclusive minimum and maximum over all fillers."@x-gmeow-english ;
    gmeow:useWhen "Use when the selected property must have exactly a stated number of fillers."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use when the count is a data-quality expectation rather than an ontological commitment."@x-gmeow-english ;
    gmeow:howToUse "Pair a non-negative integer with logic:onProperty; use logic:qualifiedCardinality when filler type matters."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:qualifiedCardinality
    a logic:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "qualified cardinality"@x-gmeow-english ;
    skos:definition "The exact number of logic:onProperty values belonging to the qualifying logic:onClass or logic:onDataRange. It does not count fillers outside that qualifier; it lowers to OWL qualifiedCardinality."@x-gmeow-english ;
    skos:example "ex:reviewRestriction logic:qualifiedCardinality 2 ; logic:onClass ex:Reviewer ."@x-gmeow-english ;
    skos:scopeNote "Exactly one qualifier, logic:onClass or logic:onDataRange, determines which fillers are counted."@x-gmeow-english ;
    gmeow:useWhen "Use when exactly a stated number of fillers must satisfy one class or datarange qualifier."@x-gmeow-english ;
    gmeow:avoidWhen "Do not omit the qualifier or attach both class and datarange qualifiers."@x-gmeow-english ;
    gmeow:howToUse "Pair the count with logic:onProperty and exactly one of logic:onClass or logic:onDataRange."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:minQualifiedCardinality
    a logic:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "minimum qualified cardinality"@x-gmeow-english ;
    skos:definition "The inclusive minimum number of logic:onProperty values belonging to the qualifying logic:onClass or logic:onDataRange. It does not count fillers outside that qualifier; it lowers to OWL minQualifiedCardinality."@x-gmeow-english ;
    skos:example "ex:committeeRestriction logic:minQualifiedCardinality 2 ; logic:onClass ex:Member ."@x-gmeow-english ;
    skos:scopeNote "The lower bound applies only to fillers satisfying the one declared qualifier."@x-gmeow-english ;
    gmeow:useWhen "Use when at least a stated number of fillers must satisfy one class or datarange qualifier."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to set a lower bound without exactly one qualifier, or when all fillers should be counted; use logic:minCardinality instead."@x-gmeow-english ;
    gmeow:howToUse "Pair the lower bound with logic:onProperty and exactly one of logic:onClass or logic:onDataRange."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:maxQualifiedCardinality
    a logic:DatatypeProperty ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "maximum qualified cardinality"@x-gmeow-english ;
    skos:definition "The inclusive maximum number of logic:onProperty values belonging to the qualifying logic:onClass or logic:onDataRange. It does not count fillers outside that qualifier; it lowers to OWL maxQualifiedCardinality."@x-gmeow-english ;
    skos:example "ex:leadRestriction logic:maxQualifiedCardinality 1 ; logic:onClass ex:Lead ."@x-gmeow-english ;
    skos:scopeNote "The upper bound applies only to fillers satisfying the one declared qualifier."@x-gmeow-english ;
    gmeow:useWhen "Use when at most a stated number of fillers may satisfy one class or datarange qualifier."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to set an upper bound without exactly one qualifier, or when all fillers should be counted; use logic:maxCardinality instead."@x-gmeow-english ;
    gmeow:howToUse "Pair the upper bound with logic:onProperty and exactly one of logic:onClass or logic:onDataRange."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:onDataRange
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "on data range"@x-gmeow-english ;
    skos:definition "Names the datarange qualifying a cardinality restriction. It is not the base datatype of a logic:Datarange expression; it lowers to OWL onDataRange."@x-gmeow-english ;
    skos:example "ex:scoreRestriction logic:onDataRange xsd:decimal ."@x-gmeow-english ;
    skos:scopeNote "This qualifier selects datatype-valued fillers counted by a qualified cardinality predicate."@x-gmeow-english ;
    gmeow:useWhen "Use on a qualified restriction whose counted fillers are literals in a datarange."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use on an object-valued qualified restriction; use logic:onClass there."@x-gmeow-english ;
    gmeow:howToUse "Attach one datarange beside a qualified-cardinality predicate and logic:onProperty."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:oneOf
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "one of"@x-gmeow-english ;
    skos:definition "Links a logic:Enumeration to the RDF list of its named members. It is not an open suggestion list; it lowers to OWL oneOf, and members may be IRIs or literals according to the enumerated expression."@x-gmeow-english ;
    skos:example "ex:binaryState logic:oneOf ( ex:on ex:off ) ."@x-gmeow-english ;
    skos:scopeNote "The RDF list is closed and exhaustive for the enumeration's extension."@x-gmeow-english ;
    gmeow:useWhen "Use to provide every member of a finite logic:Enumeration."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use when unlisted values remain permitted."@x-gmeow-english ;
    gmeow:howToUse "Attach one well-formed RDF list whose member kind matches the class or datarange enumeration."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:onDatatype
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "on datatype"@x-gmeow-english ;
    skos:definition "Names the base datatype constrained by a logic:Datarange. It is not the qualifier of a cardinality restriction; it lowers to OWL onDatatype."@x-gmeow-english ;
    skos:example "ex:adultAge logic:onDatatype xsd:integer ."@x-gmeow-english ;
    skos:scopeNote "The base datatype supplies the lexical and value space before facet restrictions narrow it."@x-gmeow-english ;
    gmeow:useWhen "Use to select the base datatype of a facet-constrained logic:Datarange."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use as a qualified-cardinality filler constraint; use logic:onDataRange there."@x-gmeow-english ;
    gmeow:howToUse "Attach exactly one base datatype and pair it with a logic:withRestrictions facet list."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:withRestrictions
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "with restrictions"@x-gmeow-english ;
    skos:definition "Links a logic:Datarange to the RDF list of datatype-facet restriction records it applies. It is not a list of class restrictions; it lowers to OWL withRestrictions."@x-gmeow-english ;
    skos:example "ex:adultAge logic:withRestrictions ( [ xsd:minInclusive 18 ] ) ."@x-gmeow-english ;
    skos:scopeNote "Each list member is a facet record interpreted against the base named by logic:onDatatype."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the ordered facet records that narrow a logic:Datarange."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for object-property restrictions or an unconstrained datatype."@x-gmeow-english ;
    gmeow:howToUse "Attach one RDF list of datatype-facet records beside exactly one logic:onDatatype value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── Canonical typing markers ───────────────────────────────────────────────────
# The rdf:type objects the frontend, refuters, and projection read a term's kind
# by name. Each is the canonical logic: authoring spelling; the W3C OWL term is a
# generated projection (Principle 17), recorded by a grounding correspondence law
# in the block below.

logic:Class
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Class"@x-gmeow-english ;
    skos:definition "The canonical marker typing a named class expression on the logic: reasoning surface. It is not an instance-level individual; its generated OWL projection is the Class type object a reader recognizes a class by."@x-gmeow-english ;
    skos:example "ex:Animal a logic:Class ."@x-gmeow-english ;
    skos:scopeNote "Typing a resource as a class licenses subsumption and membership reasoning over it."@x-gmeow-english ;
    gmeow:useWhen "Use to type a resource that denotes a set of individuals."@x-gmeow-english ;
    gmeow:avoidWhen "Do not author the OWL Class projection as a second canonical source."@x-gmeow-english ;
    gmeow:howToUse "Type the resource with logic:Class before asserting its subclass, equivalence, or restriction axioms."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:ObjectProperty
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Object Property"@x-gmeow-english ;
    skos:definition "The canonical marker typing a relation whose values are individuals. It is not a datatype or annotation relation; its generated OWL projection is the ObjectProperty type object."@x-gmeow-english ;
    skos:example "ex:memberOf a logic:ObjectProperty ."@x-gmeow-english ;
    skos:scopeNote "An object property relates individuals to individuals and can carry logical characteristics."@x-gmeow-english ;
    gmeow:useWhen "Use to type a relation whose object is an individual rather than a literal."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for a relation whose values are literals; use logic:DatatypeProperty."@x-gmeow-english ;
    gmeow:howToUse "Type the relation with logic:ObjectProperty before adding its domain, range, or characteristics."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:DatatypeProperty
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Datatype Property"@x-gmeow-english ;
    skos:definition "The canonical marker typing a relation whose values are literals. It is not an object or annotation relation; its generated OWL projection is the DatatypeProperty type object."@x-gmeow-english ;
    skos:example "ex:age a logic:DatatypeProperty ."@x-gmeow-english ;
    skos:scopeNote "A datatype property relates individuals to literals in a datatype value space."@x-gmeow-english ;
    gmeow:useWhen "Use to type a relation whose object is a literal value."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for a relation whose values are individuals; use logic:ObjectProperty."@x-gmeow-english ;
    gmeow:howToUse "Type the relation with logic:DatatypeProperty and constrain its literal range separately."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:AnnotationProperty
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Annotation Property"@x-gmeow-english ;
    skos:definition "The canonical marker typing a non-logical annotation relation that carries documentation rather than entailment. It is not an object or datatype property in the reasoning theory; its generated OWL projection is the AnnotationProperty type object."@x-gmeow-english ;
    skos:example "ex:editorialNote a logic:AnnotationProperty ."@x-gmeow-english ;
    skos:scopeNote "Annotation-property triples are out-of-band metadata and license no logical inference."@x-gmeow-english ;
    gmeow:useWhen "Use to type a relation that documents a term without asserting reasoning content."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for a relation whose triples must participate in entailment."@x-gmeow-english ;
    gmeow:howToUse "Type the documentation relation with logic:AnnotationProperty so consumers treat its triples as annotations."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:NamedIndividual
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Named Individual"@x-gmeow-english ;
    skos:definition "The canonical marker typing a named ABox individual. It is not a class or property; its generated OWL projection is the NamedIndividual type object a reader recognizes an individual by."@x-gmeow-english ;
    skos:example "ex:socrates a logic:NamedIndividual ."@x-gmeow-english ;
    skos:scopeNote "The marker records that a resource denotes one individual, distinct from a class or property."@x-gmeow-english ;
    gmeow:useWhen "Use to make a resource's individual status explicit alongside its type assertions."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to type a class or a property."@x-gmeow-english ;
    gmeow:howToUse "Type the individual with logic:NamedIndividual in addition to its domain classes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Ontology
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Ontology"@x-gmeow-english ;
    skos:definition "The canonical marker typing an ontology or module header resource that carries importation and versioning metadata. It is not a domain class; its generated OWL projection is the Ontology type object."@x-gmeow-english ;
    skos:example "ex:myModule a logic:Ontology ."@x-gmeow-english ;
    skos:scopeNote "The header resource anchors module-level metadata such as imports and version information."@x-gmeow-english ;
    gmeow:useWhen "Use to type the header resource of a module or ontology document."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for a domain class or an individual."@x-gmeow-english ;
    gmeow:howToUse "Type the header resource with logic:Ontology and attach its logic:imports and logic:versionInfo metadata."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Thing
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Thing"@x-gmeow-english ;
    skos:definition "The canonical universal (top) class: every individual is a logic:Thing. It is not a domain root that authors should subclass casually; its generated OWL projection is the Thing top the clash readers compare against."@x-gmeow-english ;
    skos:example "ex:anyRestriction logic:onClass logic:Thing ."@x-gmeow-english ;
    skos:scopeNote "Top denotes the whole domain of discourse and subsumes every class."@x-gmeow-english ;
    gmeow:useWhen "Use as the unqualified filler class of a cardinality restriction or as an explicit universal bound."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use as a substitute for a real domain superclass."@x-gmeow-english ;
    gmeow:howToUse "Reference logic:Thing where a restriction needs the universal class as its qualifier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:Nothing
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Nothing"@x-gmeow-english ;
    skos:definition "The canonical empty (bottom) class: no individual is a logic:Nothing. It is not a modelling placeholder for missing data; its generated OWL projection is the Nothing bottom an inconsistency collapses to."@x-gmeow-english ;
    skos:example "ex:SquareCircle logic:equivalentClass logic:Nothing ."@x-gmeow-english ;
    skos:scopeNote "Bottom is the unsatisfiable class; deriving membership in it signals an inconsistency."@x-gmeow-english ;
    gmeow:useWhen "Use to state that a class expression is necessarily empty."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to represent an as-yet-unpopulated but satisfiable class."@x-gmeow-english ;
    gmeow:howToUse "Equate the unsatisfiable class expression with logic:Nothing when emptiness is an ontological commitment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# ── Canonical class and property axiom vocabulary ──────────────────────────────
# The set-forming class constructors, individual (in)equality edges, and n-ary
# axiom markers the frontend lifts and the projection lowers.

logic:unionOf
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "union of"@x-gmeow-english ;
    skos:definition "Links a class expression to the RDF list of class expressions whose union it denotes: an individual is a member exactly when it is a member of at least one listed class. It is not a subclass hint; its generated OWL projection is the unionOf constructor."@x-gmeow-english ;
    skos:example "ex:Parent logic:unionOf ( ex:Mother ex:Father ) ."@x-gmeow-english ;
    skos:scopeNote "The union extension is the set-theoretic union of the listed class extensions."@x-gmeow-english ;
    gmeow:useWhen "Use to define a class as the disjunction of a finite list of class expressions."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for an open-ended or approximate grouping."@x-gmeow-english ;
    gmeow:howToUse "Attach one RDF list of the class expressions that compose the union."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:intersectionOf
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "intersection of"@x-gmeow-english ;
    skos:definition "Links a class expression to the RDF list of class expressions whose intersection it denotes: an individual is a member exactly when it is a member of every listed class. It is not a subclass chain; its generated OWL projection is the intersectionOf constructor."@x-gmeow-english ;
    skos:example "ex:WorkingParent logic:intersectionOf ( ex:Parent ex:Employee ) ."@x-gmeow-english ;
    skos:scopeNote "The intersection extension is the set-theoretic intersection of the listed class extensions."@x-gmeow-english ;
    gmeow:useWhen "Use to define a class as the conjunction of a finite list of class expressions."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use where a single subclass edge already captures the intended narrowing."@x-gmeow-english ;
    gmeow:howToUse "Attach one RDF list of the class expressions that compose the intersection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:disjointUnionOf
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "disjoint union of"@x-gmeow-english ;
    skos:definition "Links a class to the RDF list of pairwise-disjoint classes that exhaustively partition it: every instance belongs to exactly one listed class. It is not a bare union, which permits overlap; its generated OWL projection is the disjointUnionOf constructor."@x-gmeow-english ;
    skos:example "ex:Person logic:disjointUnionOf ( ex:Child ex:Adult ) ."@x-gmeow-english ;
    skos:scopeNote "The axiom asserts both exhaustive coverage and pairwise disjointness of the listed classes."@x-gmeow-english ;
    gmeow:useWhen "Use to partition a class into mutually exclusive, jointly exhaustive subclasses."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use when the subclasses may overlap or need not cover the parent; use logic:unionOf."@x-gmeow-english ;
    gmeow:howToUse "Attach one RDF list of the partition classes after confirming they are disjoint and exhaustive."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:sameAs
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "same as"@x-gmeow-english ;
    skos:definition "Canonical individual identity: the two related IRIs denote the same individual, so their assertions merge. It is not class equivalence or similarity; its generated OWL projection is the sameAs relation."@x-gmeow-english ;
    skos:example "ex:samuelClemens logic:sameAs ex:markTwain ."@x-gmeow-english ;
    skos:scopeNote "Identity is symmetric and transitive and licenses substitution of one IRI for the other."@x-gmeow-english ;
    gmeow:useWhen "Use only when two IRIs are known to refer to one and the same individual."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for two merely similar or closely related individuals."@x-gmeow-english ;
    gmeow:howToUse "Relate the coreferent IRIs after a competency case confirms their assertions may be merged."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:differentFrom
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "different from"@x-gmeow-english ;
    skos:definition "Canonical individual distinctness: the two related IRIs denote distinct individuals and may never be merged. It is not class disjointness; its generated OWL projection is the differentFrom relation."@x-gmeow-english ;
    skos:example "ex:markTwain logic:differentFrom ex:charlesDickens ."@x-gmeow-english ;
    skos:scopeNote "The assertion blocks an identity inference that would otherwise unify the two individuals."@x-gmeow-english ;
    gmeow:useWhen "Use when two individuals must be kept distinct under the unique-name-defeating open world."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for classes; use logic:disjointWith there."@x-gmeow-english ;
    gmeow:howToUse "Relate the two individuals to forbid their identification."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:propertyChainAxiom
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "property chain axiom"@x-gmeow-english ;
    skos:definition "Links a property to the RDF list of properties whose ordered composition it subsumes: following the chain entails the head property. It is not a subproperty edge over a single property; its generated OWL projection is the propertyChainAxiom constructor."@x-gmeow-english ;
    skos:example "ex:hasGrandparent logic:propertyChainAxiom ( ex:hasParent ex:hasParent ) ."@x-gmeow-english ;
    skos:scopeNote "The list order matters: the chain composes the properties left to right."@x-gmeow-english ;
    gmeow:useWhen "Use to entail a relation from the ordered composition of two or more relations."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use where a plain logic:subPropertyOf edge suffices."@x-gmeow-english ;
    gmeow:howToUse "Attach the ordered RDF list of chained properties to the entailed head property."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:propertyDisjointWith
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "property disjoint with"@x-gmeow-english ;
    skos:definition "Canonical property disjointness: no ordered pair may be related by both properties at once. It is not class disjointness; its generated OWL projection is the propertyDisjointWith relation."@x-gmeow-english ;
    skos:example "ex:parentOf logic:propertyDisjointWith ex:siblingOf ."@x-gmeow-english ;
    skos:scopeNote "The disjointness is symmetric between the two properties at the ordered-pair level."@x-gmeow-english ;
    gmeow:useWhen "Use when a single ordered pair related by both properties must be inconsistent."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use merely because two relations rarely co-occur in current data."@x-gmeow-english ;
    gmeow:howToUse "Relate the two properties after a negative competency case confirms the overlap is contradictory."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:hasKey
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "has key"@x-gmeow-english ;
    skos:definition "Links a class to the RDF list of properties that jointly identify its instances: two class members agreeing on every key value are the same individual. It is not inverse functionality of a single property; its generated OWL projection is the hasKey constructor."@x-gmeow-english ;
    skos:example "ex:Country logic:hasKey ( ex:isoCode ) ."@x-gmeow-english ;
    skos:scopeNote "The key is a closed-world identification over named individuals of the class."@x-gmeow-english ;
    gmeow:useWhen "Use when a tuple of property values uniquely identifies a class instance."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to constrain cardinality; a key licenses identity, not counting."@x-gmeow-english ;
    gmeow:howToUse "Attach the RDF list of identifying properties to the class whose instances they key."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:members
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "members"@x-gmeow-english ;
    skos:definition "Links an n-ary disjointness axiom resource to the RDF list of the classes or properties it declares pairwise disjoint. It is not a class-extension membership edge; its generated OWL projection is the members constructor."@x-gmeow-english ;
    skos:example "ex:disjointColours logic:members ( ex:Red ex:Green ex:Blue ) ."@x-gmeow-english ;
    skos:scopeNote "The list carries the terms of a logic:AllDisjointClasses or logic:AllDisjointProperties axiom."@x-gmeow-english ;
    gmeow:useWhen "Use to carry the term list of an n-ary all-pairwise-disjoint axiom."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to state that an individual is a member of a class."@x-gmeow-english ;
    gmeow:howToUse "Attach one RDF list of the mutually disjoint classes or properties to the axiom resource."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:hasSelf
    a logic:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "has self"@x-gmeow-english ;
    skos:definition "Self restriction: the constrained logic:onProperty relates each instance to itself. Its truth-valued object is the local reflexivity flag of one restriction, not the global logic:reflexiveProperty characteristic; its generated OWL projection is the hasSelf restriction."@x-gmeow-english ;
    skos:example "ex:selfAwareRestriction logic:onProperty ex:knows ; logic:hasSelf true ."@x-gmeow-english ;
    skos:scopeNote "The flag constrains the self-edge of one property inside a single class expression."@x-gmeow-english ;
    gmeow:useWhen "Use to require, within a restriction, that the property relates an instance to itself."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to declare a property globally reflexive; use logic:reflexiveProperty."@x-gmeow-english ;
    gmeow:howToUse "Pair a boolean value with logic:onProperty on the same restriction."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:AllDisjointClasses
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "All Disjoint Classes"@x-gmeow-english ;
    skos:definition "Typing marker for an n-ary axiom asserting that every class in its logic:members list is pairwise disjoint from every other. It is not a binary logic:disjointWith edge; its generated OWL projection is the AllDisjointClasses axiom type."@x-gmeow-english ;
    skos:example "ex:primaryColourDisjointness a logic:AllDisjointClasses ; logic:members ( ex:Red ex:Green ex:Blue ) ."@x-gmeow-english ;
    skos:scopeNote "One axiom resource captures the full pairwise disjointness of three or more classes."@x-gmeow-english ;
    gmeow:useWhen "Use to declare three or more classes mutually disjoint in a single axiom."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for a single pair; use logic:disjointWith."@x-gmeow-english ;
    gmeow:howToUse "Type the axiom resource and attach the disjoint classes through logic:members."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:AllDisjointProperties
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "All Disjoint Properties"@x-gmeow-english ;
    skos:definition "Typing marker for an n-ary axiom asserting that every property in its logic:members list is pairwise disjoint from every other. It is not a binary logic:propertyDisjointWith edge; its generated OWL projection is the AllDisjointProperties axiom type."@x-gmeow-english ;
    skos:example "ex:kinshipDisjointness a logic:AllDisjointProperties ; logic:members ( ex:parentOf ex:siblingOf ex:spouseOf ) ."@x-gmeow-english ;
    skos:scopeNote "One axiom resource captures the full pairwise disjointness of three or more properties."@x-gmeow-english ;
    gmeow:useWhen "Use to declare three or more properties mutually disjoint in a single axiom."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for a single pair; use logic:propertyDisjointWith."@x-gmeow-english ;
    gmeow:howToUse "Type the axiom resource and attach the disjoint properties through logic:members."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# ── Canonical ontology-header metadata vocabulary ──────────────────────────────
# The reified-axiom marker and the two header annotation properties an ontology
# header carries. logic:imports is already declared above.

logic:Axiom
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "Axiom"@x-gmeow-english ;
    skos:definition "Typing marker for a reified axiom resource that carries out-of-band annotations on an asserted statement. It is not the asserted statement itself; its generated OWL projection is the Axiom reification type."@x-gmeow-english ;
    skos:example "ex:reifiedClaim a logic:Axiom ."@x-gmeow-english ;
    skos:scopeNote "The reifier hangs annotations on a statement without changing the statement's assertion."@x-gmeow-english ;
    gmeow:useWhen "Use to annotate a specific asserted axiom with provenance or editorial metadata."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use as an ordinary domain class."@x-gmeow-english ;
    gmeow:howToUse "Type the reifier with logic:Axiom and attach its annotations to it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:deprecated
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "deprecated"@x-gmeow-english ;
    skos:definition "Annotation marking a term as deprecated and scheduled for removal, so consumers avoid authoring against it. It carries no logical entailment; its generated OWL projection is the deprecated annotation."@x-gmeow-english ;
    skos:example "ex:legacyProperty logic:deprecated true ."@x-gmeow-english ;
    skos:scopeNote "Deprecation is advisory metadata, not a retraction of the term's existing assertions."@x-gmeow-english ;
    gmeow:useWhen "Use to flag a term that remains present but should no longer be used."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use to delete a term; remove it under the greenfield discipline instead."@x-gmeow-english ;
    gmeow:howToUse "Attach a boolean deprecation flag to the term being retired."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:versionInfo
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "version info"@x-gmeow-english ;
    skos:definition "Annotation carrying free-text version information for an ontology header or term. It carries no logical entailment; its generated OWL projection is the versionInfo annotation."@x-gmeow-english ;
    skos:example "ex:myModule logic:versionInfo \"2026-08-19\" ."@x-gmeow-english ;
    skos:scopeNote "The value is human-readable version metadata, not a machine-ordered version identifier."@x-gmeow-english ;
    gmeow:useWhen "Use to record a human-readable version string on a module header or term."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use for structured provenance that a dedicated property already carries."@x-gmeow-english ;
    gmeow:howToUse "Attach one version string to the ontology header or annotated term."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# ── Grounding correspondence laws for the canonical construct vocabulary ────────
# One logic:GroundingCorrespondence per canonical construct above, shipped as
# meta-level correspondence data for graph/correspondence-laws (routed by type,
# outside object-level closure). Each records that the W3C OWL/RDFS spelling is a
# GENERATED projection of the canonical logic: term (Principle 17): an exact
# structural rename, so logic:morphismClass logic:Isomorphism and
# logic:preservationKind logic:ExactPreservation (the preservation-consistency gate
# admits ExactPreservation only for an injective rung such as an Isomorphism). The
# target endpoint is written as a FULL IRI, never the OWL/rdfs: prefix, so the
# authored slice surface reaches zero prefixed W3C authoring terms once the domain
# slices flip. This mirrors, in shipped ontology content, the reasoner's
# CALCULUS_VOCABULARY lowering table.

logic:corrSubClassOfGrounding
    a logic:GroundingCorrespondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "logic:subClassOf to W3C RDFS subClassOf grounding"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint logic:subClassOf ;
    logic:targetEndpoint <http://www.w3.org/2000/01/rdf-schema#subClassOf> ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    gmeow:justification <https://w3id.org/semapv/vocab/ManualMappingCuration> ;
    skos:definition "Grounding correspondence: the canonical logic:subClassOf edge is projected to the W3C RDFS subClassOf edge as an exact structural rename — a logic:Isomorphism under a logic:InstitutionMorphism carrying logic:ExactPreservation. RDFS is a lossy projection surface overall (Principle 17), yet this single subsumption edge is preserved exactly and invertibly."@x-gmeow-english .

logic:corrSubPropertyOfGrounding
    a logic:GroundingCorrespondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "logic:subPropertyOf to W3C RDFS subPropertyOf grounding"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint logic:subPropertyOf ;
    logic:targetEndpoint <http://www.w3.org/2000/01/rdf-schema#subPropertyOf> ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    gmeow:justification <https://w3id.org/semapv/vocab/ManualMappingCuration> ;
    skos:definition "Grounding correspondence: the canonical logic:subPropertyOf edge is projected to the W3C RDFS subPropertyOf edge as an exact structural rename — a logic:Isomorphism under a logic:InstitutionMorphism carrying logic:ExactPreservation; the relation-subsumption edge is preserved exactly and invertibly."@x-gmeow-english .

logic:corrEquivalentClassGrounding
    a logic:GroundingCorrespondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "logic:equivalentClass to W3C OWL equivalentClass grounding"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint logic:equivalentClass ;
    logic:targetEndpoint <http://www.w3.org/2002/07/owl#equivalentClass> ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    gmeow:justification <https://w3id.org/semapv/vocab/ManualMappingCuration> ;
    skos:definition "Grounding correspondence: the canonical logic:equivalentClass term is projected to the W3C OWL equivalentClass construct as an exact structural rename — a logic:Isomorphism under a logic:InstitutionMorphism carrying logic:ExactPreservation, the projection changing only the namespace of an otherwise identical term."@x-gmeow-english .

logic:corrRestrictionGrounding
    a logic:GroundingCorrespondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "logic:Restriction to W3C OWL Restriction grounding"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint logic:Restriction ;
    logic:targetEndpoint <http://www.w3.org/2002/07/owl#Restriction> ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    gmeow:justification <https://w3id.org/semapv/vocab/ManualMappingCuration> ;
    skos:definition "Grounding correspondence: the canonical logic:Restriction term is projected to the W3C OWL Restriction construct as an exact structural rename — a logic:Isomorphism under a logic:InstitutionMorphism carrying logic:ExactPreservation."@x-gmeow-english .

logic:corrOnPropertyGrounding
    a logic:GroundingCorrespondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "logic:onProperty to W3C OWL onProperty grounding"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint logic:onProperty ;
    logic:targetEndpoint <http://www.w3.org/2002/07/owl#onProperty> ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    gmeow:justification <https://w3id.org/semapv/vocab/ManualMappingCuration> ;
    skos:definition "Grounding correspondence: the canonical logic:onProperty term is projected to the W3C OWL onProperty construct as an exact structural rename — a logic:Isomorphism under a logic:InstitutionMorphism carrying logic:ExactPreservation."@x-gmeow-english .

logic:corrSomeValuesFromGrounding
    a logic:GroundingCorrespondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "logic:someValuesFrom to W3C OWL someValuesFrom grounding"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint logic:someValuesFrom ;
    logic:targetEndpoint <http://www.w3.org/2002/07/owl#someValuesFrom> ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ExactPreservation ;
    gmeow:justification <https://w3id.org/semapv/vocab/ManualMappingCuration> ;
    skos:definition "Grounding correspondence: the canonical logic:someValuesFrom term is projected to the W3C OWL someValuesFrom construct as an exact structural rename — a logic:Isomorphism under a logic:InstitutionMorphism carrying logic:ExactPreservation."@x-gmeow-english .

logic:corrAllValuesFromGrounding
    a logic:GroundingCorrespondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "logic:allValuesFrom to W3C OWL allValuesFrom grounding"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:sourceEndpoint logic:allValuesFrom ;
    logic:targetEndpoint <http://www.w3.org/2002/07/owl#allValuesFrom> ;
