@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .

# Term equivalences for the sensory environment layer — GMEOW authoring source.
# Compiled to mappings/gmeow-sensory-environment.sssom.tsv by `gmeow compile-mappings`.
#
# SOSA/SSN (W3C/OGC) provides the strongest structural match and is aligned via
# TermEquivalence / SSSOM rows below.
#
# SWEET (NASA ESIP), ISO 12913 (soundscape), CIE (colourspaces), OpenAQ
# (air-quality measurements), and ASHRAE Standard 55 (thermal comfort) do not
# publish stable RDF ontologies with resolvable term IRIs. Their alignments are
# documented here as plain comments following the colourspace.ttl precedent
# (Principle 5 — never force weak matches).
#
#   SWEET      — gmeow:SensoryEnvironment conceptually maps to SWEET realm
#                properties (sweet:prop/EnvironmentProperty and sub-realm
#                ontologies), but no single SWEET term captures the
#                perceptual+measurement duality. SensoryModality values map
#                broadly to sweet:prop/PhysicalProperty sub-properties.
#   ISO 12913  — gmeow:sensoryModalityAuditory and the auditory measured-
#                condition pattern map to ISO 12913-1:2014 Acoustics —
#                Soundscape (perceptual characterisation of acoustic
#                environments). https://www.iso.org/standard/52161.html
#   CIE        — gmeow:referenceFrameCIEXYZ aligns structurally to CIE 1931
#                XYZ tristimulus space; gmeow:referenceFrameCIELAB to CIE
#                L*a*b* perceptually-uniform space.
#                https://cie.co.at/publications/cie-1931-colour-spaces
#                https://cie.co.at/publications/cie-0152018
#   OpenAQ     — gmeow:sensoryModalityAirQuality and air-quality
#                SensoryObservation patterns map conceptually to the OpenAQ
#                measurements API and data format.
#                https://docs.openaq.org/
#   ASHRAE 55  — gmeow:referenceFrameThermalComfort aligns to the ASHRAE
#                PMV/PPD thermal comfort model in Standard 55 — Thermal
#                Environmental Conditions for Human Occupancy.
#                https://www.ashrae.org/technical-resources/bookstore/standard-55

gmeow:mapsetSensoryEnvironment a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-sensory-environment.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/sensory-environment" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Sensory environment alignments — SOSA/SSN. Putative (#104)." .

# --------------------------------------------------------------------------- #
# SOSA / SSN
# --------------------------------------------------------------------------- #

gmeow:eqSenv001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SensoryObservation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "SOSA does not distinguish observation types; a sensory observation is a kind of sosa:Observation. Already aligned in observations.ttl; repeated here for completeness of the sensory-environment mapping set." ;
    gmeow:sssomFile "gmeow-sensory-environment.sssom.tsv" .

gmeow:eqSenv002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SensoryEnvironment ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:FeatureOfInterest ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "A SensoryEnvironment is the feature of interest that sensory observations are about — the ambient conditions at a location×time." ;
    gmeow:sssomFile "gmeow-sensory-environment.sssom.tsv" .

gmeow:eqSenv003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:CoordinateMatrix ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Result ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "sosa:Result is broader (any result); gmeow:CoordinateMatrix is specifically a multi-dimensional numeric result with frame, unit, and determinacy." ;
    gmeow:sssomFile "gmeow-sensory-environment.sssom.tsv" .

gmeow:eqSenv004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasMeasuredCondition ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:hasResult ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "A measured condition is the result of a sensory observation. Directional: GMEOW reifies the environment separately from the observation." ;
    gmeow:sssomFile "gmeow-sensory-environment.sssom.tsv" .

gmeow:eqSenv005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SensoryPerception ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "A SensoryPerception is a standpoint-indexed observation; SOSA does not distinguish observation types. The vantage (perceiver) aligns to sosa:madeBySensor." ;
    gmeow:sssomFile "gmeow-sensory-environment.sssom.tsv" .
