@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix lang:   <https://blackcatinformatics.ca/lang/> .
@prefix mads:   <http://www.loc.gov/mads/rdf/v1#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Term equivalences for the universal identity/coreference layer (authority/coreference links).
# Instance coreference is asserted in data with gmeow:authorityLink plus
# skos:exactMatch/closeMatch; projections may downcast exact matches to target
# identity URL properties. No row here licenses owl:sameAs merging.

gmeow:mapsetCoreference a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/coreference" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Universal identity/coreference alignments. GMEOW links entities to authority records by reference (authorityLink + SKOS match strength) and avoids owl:sameAs merge semantics for contested or standpoint-indexed claims." .

gmeow:authorityLink skos:closeMatch schema:sameAs {|
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "schema:sameAs is a projection target for exact authority links; GMEOW's canonical data keeps authorityLink plus explicit skos:exactMatch/closeMatch strength."
|} .

gmeow:counterpartOf skos:closeMatch prov:alternateOf {|
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "PROV alternateOf captures alternate entities presenting aspects of the same thing, without owl:sameAs identity collapse."
|} .

gmeow:versionOf skos:closeMatch dcterms:isVersionOf {|
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:editionOf skos:closeMatch dcterms:isVersionOf {|
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "An edition is a work-version relation for Dublin Core consumers; GMEOW keeps editionOf distinct from generic versionOf."
|} .

gmeow:supersedes skos:closeMatch dcterms:replaces {|
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:authorityLink skos:exactMatch mads:hasCloseExternalAuthority {|
    gmeow:sssomFile "gmeow-coreference.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "both relate a local description to a close external authority record, by reference (PROV activity alignment phase 2). mads:authoritativeLabel is REFUSED: GMEOW has no authority-control labeling model — skos:prefLabel serves that role."
|} .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:supersedes skos:closeMatch dcterms:replaces {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "DCTerms replaces — a related resource that is superseded by the described resource"
|} .

gmeow:versionOf skos:closeMatch dcterms:isVersionOf {|
    gmeow:sssomFile "gmeow-dublin-core.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "DCTerms isVersionOf — a related resource of which the described resource is a version"
|} .

# --------------------------------------------------------------------------- #
# lang: graft supersession ledger — the machine-checked rung carrier lives in  #
# imports/supersession-correspondences.ttl as logic:Correspondence nodes        #
# (logic:morphismClass + logic:mnemomorphic + logic:getLeg), run through         #
# assert_gates in the logic-compile stage. The prose-rung alignment cell graft   #
# rows are removed: the rung is a gate-enforced correspondence law, not a        #
# comment (Principle 17 — SSSOM is its lossy projection).                        #
# --------------------------------------------------------------------------- #
