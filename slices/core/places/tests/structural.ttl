ASK { gmeow:NetworkAddressType rdfs:subClassOf logic:QualityValue . }""" ;
    gmeow:saRationale "gmeow:NetworkAddressType MUST be a subclass of logic:QualityValue. Mirrors test_network_address_type_is_value_not_subclass (subclass part)." .

