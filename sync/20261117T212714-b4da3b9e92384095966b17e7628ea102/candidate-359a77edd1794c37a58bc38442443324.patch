+    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" ;
+    gmeow:justification semapv:ManualMappingCuration ;
+    gmeow:objectLabel "Explained variation" ;
+    gmeow:comment "The canonical term names a normalized PCA component share. The target covers broader modelling-based explained variation. This related match retains conceptual context only; it supplies no identity, R-squared equivalence, numeric conversion or executed ratio result." ;
