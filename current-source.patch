+/// Returns a native value refusal for invalid token syntax or target overflow.
+pub fn read_signed<T: TryFrom<i128>>(value: &Value, expected: &str) -> Result<T, DecodeError> {
     value
         .as_number()
         .filter(|number| number.lexeme() != "-0")
