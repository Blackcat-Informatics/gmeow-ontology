# Projection: GMEOW → pure schema-org. GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: non-displayable names (deadnames) dropped; orientation + sexAssignedAtBirth dropped; sex/gender conflated; Glottocodes excluded; only 2-3 letter primary subtags; CEFR/ILR/ACTFL level and skill modality dropped; the birth Participation (role, period, confidence, standpoint) and fuzzy-date bounds are dropped; only the principal's birth instant survives as schema:birthDate.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>

CONSTRUCT {
    ?place a schema:Place .
    ?place schema:containedInPlace ?parent .
    ?place schema:geo ?coords .
    ?coords a schema:GeoCoordinates .
    ?coords schema:latitude ?lat .
    ?coords schema:longitude ?lon .
    ?coords schema:elevation ?elev .
    ?place a ?ptClass .
    ?vl a schema:VirtualLocation .
    ?vl schema:url ?vurl .
    ?holder schema:address ?addr .
    ?addr a schema:PostalAddress .
    ?addr schema:streetAddress ?street .
    ?addr schema:addressLocality ?locality .
    ?addr schema:addressRegion ?region .
    ?addr schema:postalCode ?pcode .
    ?addr schema:addressCountry ?ccode .
    ?ent schema:name ?dispName .
    ?ent schema:givenName ?given .
    ?ent schema:familyName ?family .
    ?ent schema:gender ?genderLabel .
    ?ent schema:honorificPrefix ?honPrefix .
    ?ent schema:honorificSuffix ?honSuffix .
    ?lang a schema:Language .
    ?prog a schema:ComputerLanguage .
    ?lang schema:alternateName ?bcp47 .
    ?knower schema:knowsLanguage ?known .
    ?ent schema:description ?desc .
    ?ent schema:url ?wp .
    ?ent schema:alternateName ?nick .
    ?person schema:birthDate ?bdate .
    ?member schema:jobTitle ?title .
    ?parent schema:department ?dept .
}
WHERE {
    {
        ?place a gmeow:Place .
        OPTIONAL { ?place gmeow:containedInPlace ?parent . }
        OPTIONAL {
            ?place gmeow:hasCoordinates ?coords .
            OPTIONAL {
                ?coords gmeow:latitude ?lat .
            }
            OPTIONAL {
                ?coords gmeow:longitude ?lon .
            }
            OPTIONAL {
                ?coords gmeow:elevation ?elev .
            }
        }
    }
    UNION {
        ?place gmeow:placeType ?pt .
        VALUES ( ?pt ?ptClass ) {
            ( gmeow:placeTypeCountry schema:Country )
            ( gmeow:placeTypeCity schema:City )
            ( gmeow:placeTypeAdministrativeArea schema:AdministrativeArea )
            ( gmeow:placeTypeRegion schema:AdministrativeArea )
        }
    }
    UNION {
        ?vl a gmeow:VirtualLocation .
        OPTIONAL { ?vl gmeow:accessUrl ?vurl . }
    }
    UNION {
        ?holder gmeow:hasContactPoint ?addr .
        ?addr a gmeow:PostalAddress .
        OPTIONAL { ?addr gmeow:streetAddress ?street . }
        OPTIONAL { ?addr gmeow:addressLocality ?locality . }
        OPTIONAL { ?addr gmeow:addressRegion ?region . }
        OPTIONAL { ?addr gmeow:postalCode ?pcode . }
        OPTIONAL { ?addr gmeow:countryCode ?ccode . }
    }
    UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName ?app .
        ?app gmeow:fullName ?dispName .
        FILTER NOT EXISTS { ?app gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName ?app .
        ?app gmeow:hasNamePart ?np .
        ?np gmeow:namePartType gmeow:namePartGiven .
        ?np gmeow:partText ?given .
        FILTER NOT EXISTS { ?app gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:hasAppellation|gmeow:hasName ?app .
        ?app gmeow:hasNamePart ?np .
        ?np gmeow:namePartType gmeow:namePartSurname .
        ?np gmeow:partText ?family .
        FILTER NOT EXISTS { ?app gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:hasGenderIdentity ?gi .
        ?gi gmeow:genderValue ?gv .
        ?gv rdfs:label ?genderLabel .
        FILTER NOT EXISTS { ?gi gmeow:displayable false . }
    }
    UNION {
        ?ent gmeow:honorific ?h .
        ?h rdfs:label ?honPrefix .
        ?h gmeow:honorificPosition gmeow:honorificPositionPrefix .
    }
    UNION {
        ?ent gmeow:honorific ?h .
        ?h rdfs:label ?honSuffix .
        ?h gmeow:honorificPosition gmeow:honorificPositionSuffix .
    }
    UNION {
        ?lang rdf:type/rdfs:subClassOf* gmeow:Language .
    }
    UNION {
        ?prog a gmeow:ProgrammingLanguage .
    }
    UNION {
        ?lang rdf:type/rdfs:subClassOf* gmeow:Language .
        ?lang gmeow:languageCode ?code .
        OPTIONAL {
            ?lang gmeow:usesWritingSystem ?ws .
            ?ws gmeow:scriptCode ?sc .
        }
        BIND ( IF(BOUND(?sc), CONCAT(STR(?code), "-", STR(?sc)), STR(?code)) AS ?bcp47 )
        FILTER NOT EXISTS { ?lang rdf:type/rdfs:subClassOf* gmeow:FormalLanguage . }
        FILTER( regex(STR(?code), "^[a-zA-Z]{2,3}$") )
    }
    UNION {
        ?knower gmeow:knowsLanguage ?known .
    }
    UNION {
        ?prof a gmeow:LanguageProficiency .
        ?prof gmeow:proficiencyAgent ?knower .
        ?prof gmeow:proficiencyLanguage ?known .
    }
    UNION {
        ?ent gmeow:description ?desc .
    }
    UNION {
        ?ent gmeow:hasWebPage ?wp .
    }
    UNION {
        ?ent gmeow:hasName ?nname .
        ?nname gmeow:namePurpose gmeow:namePurposeNickname .
        ?nname gmeow:fullName ?nick .
        FILTER NOT EXISTS { ?nname gmeow:displayable false . }
    }
    UNION {
        ?birth gmeow:eventType gmeow:eventTypeBirth .
        ?p gmeow:participationEvent ?birth .
        ?p gmeow:participationRole gmeow:roleParticipantPrincipal .
        ?p gmeow:participationParticipant ?person .
        ?birth gmeow:eventTime ?bdate .
    }
    UNION {
        ?m a gmeow:Membership .
        ?m gmeow:membershipMember ?member .
        ?m gmeow:hasRole ?role .
        ?role rdfs:label|gmeow:name ?title .
    }
    UNION {
        ?dept gmeow:subOrganizationOf ?parent .
    }
}
