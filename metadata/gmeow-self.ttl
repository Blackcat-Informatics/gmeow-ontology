<https://blackcatinformatics.ca/gmeow/self>
    a owl:Ontology ;
    rdfs:label "GMEOW Self-Description"@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    owl:imports <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# WORK — the abstract intellectual creation
# =========================================================================== #

<https://blackcatinformatics.ca/gmeow>
    a gmeow:Work ;
    rdfs:label "GMEOW — Global Metadata and Entity Ontology for the Web"@x-gmeow-english ;
    skos:definition "GMEOW is an ontology engine for machine and human minds that treats every mental act as an attributed, revisable claim rather than a stored truth — a place to record not just what an agent (or a person) believes, but who held it, from what vantage, with what confidence, on what evidence, by which kind of reasoning, in what state of awareness, and whether it has since been defeated. Its flagship use is grounded agent memory — store, recall, revise — that can tell a recalled fact from a confabulated one and surfaces disagreement as coexisting standpoints rather than overwriting the loser. Truth is never a bit on a triple: belief, knowledge, inference, calibration, and reality-monitoring are all first-class, vantage-indexed claims, revision is suppression rather than deletion, and a full model of mind — endurant states and occurrent processes over content typed by direction of fit — gives every faculty both a human and a machine face. Every fact is authored once across GMEOW's self-contained slices, generated outward as lossy projections (OWL, SHACL, JSON-LD, schema.org, citation and deposit forms) and maximally linked to 85 external vocabularies and authority identifiers, so a GMEOW graph is a first-class node in the linked-data and persistent-identifier web."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    foaf:homepage <https://blackcatinformatics.ca/gmeow> ;
    gmeow:authorityLink wd:Q140287679 ;
    skos:exactMatch wd:Q140287679 ;
    # Concept DOI — the always-latest citation anchor (FORCE11). It denotes the
    # Work (the lineage / DOI concept record, cf. gmeow:VersionSet), not any one
    # release. Resolves to the concept IRI above. This is the single registered
    # DOI; version/profile granularity rides the content-addressed triangle
    # (owl:versionIRI ↔ SWHID / gmeow:gtsHeadId / gmeow:contentDigest), never a
    # minted DOI per unit. See docs/dois.md.
    dcterms:identifier "10.67342/26w4o" ;
    gmeow:datePublished "2026-06-03"^^xsd:date .

# =========================================================================== #
# EXPRESSION — a specific realization of the Work
# =========================================================================== #

:expression
    a gmeow:Expression ;
    rdfs:label "GMEOW 0.1.0 expression"@x-gmeow-english ;
    skos:definition "The realized expression of the GMEOW ontology work for the 0.1.0 publication."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    gmeow:realizes <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# MANIFESTATION — a concrete, versioned publication
# =========================================================================== #

<https://blackcatinformatics.ca/gmeow/0.1.0>
    a gmeow:Manifestation ;
    rdfs:label "GMEOW 0.1.0 manifestation"@x-gmeow-english ;
    skos:definition "The concrete versioned publication manifestation of GMEOW 0.1.0."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/self> ;
    gmeow:embodies :expression ;
    gmeow:versionFingerprint "0.1.0" ;
    gmeow:datePublished "2026-06-03"^^xsd:date ;
    # Version DOI — OPTIONAL second registered DOI, denoting this immutable
    # release (resolves to its owl:versionIRI). Not yet minted: concept-only is
    # a first-class supported state, NOT a placeholder. When a version DOI is
    # registered, add it here as dcterms:identifier "10.67342/…"; the deposit
    # then emits a second record related to the concept by isVersionOf/hasVersion
    # (the Work←realizes←Expression←embodies←Manifestation chain IS that edge).
    dcterms:publisher <https://blackcatinformatics.ca/#bii> .

<https://blackcatinformatics.ca/#bii>
    a foaf:Organization ;
    foaf:name "Blackcat Informatics® Inc."@x-gmeow-english ;
    gmeow:authorityLink wd:Q140285712 ;
    foaf:mbox <mailto:root@blackcatinformatics.ca> .

