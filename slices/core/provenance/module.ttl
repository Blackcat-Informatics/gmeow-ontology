@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:Activity
    a logic:Event ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "Activity"@x-gmeow-english ;
    logic:instantiatesFramework logic:TemporalFramework ;
    rdfs:subClassOf gmeow:Event ;
    skos:definition "Something that occurs over a period of time and acts upon or with entities — creating, transforming, using, or attributing them. The provenance-layer specialization of gmeow:Event: the occurrent that gmeow:wasGeneratedBy points to and that gmeow:wasAssociatedWith ties to its performing agent."@x-gmeow-english ;
    skos:example "ex:import2026 a gmeow:Activity ; gmeow:wasAssociatedWith ex:vcardImporter ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the enduring product of the activity (that is a gmeow:Entity reached via gmeow:wasGeneratedBy) and for a generic happening with no provenance role; use gmeow:Event directly when no agent, generation, or attribution is at stake."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Type the occurrent as gmeow:Activity (or a specialization such as gmeow:ImportActivity), link its performer with gmeow:wasAssociatedWith and its products with the inverse of gmeow:wasGeneratedBy; carry the time the activity occurred on the event, and statement-level confidence on the derivation claims it produces."@x-gmeow-english ;
    gmeow:useWhen "Use as the occurrent that produced, transformed, used, or attributed an entity — the activity end of gmeow:wasGeneratedBy and the domain of gmeow:wasAssociatedWith."@x-gmeow-english .

gmeow:Approval
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "Approval"@x-gmeow-english ;
    logic:mediates gmeow:approvedBy ,
        gmeow:approvalOf ;
    rdfs:subClassOf logic:Relator ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:approvedBy ;
            logic:someValuesFrom gmeow:Agent ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:approvalOf ;
            logic:someValuesFrom gmeow:Entity ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty gmeow:approvedOn ;
            logic:someValuesFrom xsd:date ;
        ] ;
    skos:definition "A reified record that a named agent approved a body of work on a given day. It mediates between the approver (gmeow:approvedBy) and the body of work approved (gmeow:approvalOf), carries the calendar day (gmeow:approvedOn), and may carry the part of the work approved (gmeow:approvalScope) and the agent who put the approval on record (gmeow:reportedBy). Approving a body of work is a different fact from holding the claims in it: an approver is not thereby a holder of those claims, an author, a contributor or a source, and the record asserts neither that the work is correct nor that the approver agrees with every part of it."@x-gmeow-english ;
    skos:scopeNote "One Approval node records one approval by one approver of one body of work. A joint approval is several Approval nodes, and a later approval is a new node. The identifier and label of an existing Approval are never changed or reused, and a correction or a re-approval adds a new node instead of rewriting an earlier one. This is a usage contract: no axiom enforces it and no gate can detect a relabelled node. The existential restrictions require an approver, an approved work and an approval day to be present; nothing in the record says the approval is still current."@x-gmeow-english ;
    skos:example "ex:approval1 a gmeow:Approval ; gmeow:approvalOf ex:handbook ; gmeow:approvedBy ex:drOkafor ; gmeow:approvedOn \"2026-11-05\"^^xsd:date ; gmeow:approvalScope ex:handbookChapter3 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid it for signed or policy-bound vouching, which is gmeow:Attestation (a vouching act under a named policy, with a required issue instant); for authorizing an effect before it is dispatched, which is logic:ApprovalCommitment (bound to an exact intent, operator, policy, decision and validity window); and for credit for making the work, which is gmeow:Contribution. Avoid it to say whose frame holds a claim (gmeow:accordingTo) or who is responsible for the work (gmeow:wasAttributedTo), and avoid treating an approver as a holder because an Approval names them."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Mint one Approval per approval and bind gmeow:approvalOf, gmeow:approvedBy and gmeow:approvedOn. Add gmeow:approvalScope only when the approval covers a stated part of the work, and gmeow:reportedBy when the party who recorded the approval is worth naming. For a later approval or a correction add a new node and leave earlier nodes untouched. Keep any claims the approver holds on their own standpoint-indexed statements, separate from the Approval."@x-gmeow-english ;
    gmeow:useWhen "Use to record who approved a body of work, on which day, and optionally for which part of it, as a fact kept apart from who holds the claims in the work."@x-gmeow-english .

gmeow:ImportActivity
    a logic:Event ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "Import Activity"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Activity ;
    skos:definition "An activity that ingested an external source artifact (an import envelope such as a vCard file) and recorded the claims it carried. Carries the ingestion (transaction) time — when the system learned the claims, distinct from when they were asserted or when they hold."@x-gmeow-english ;
    skos:example "ex:import2026 a gmeow:ImportActivity ; gmeow:ingestedAt \"2026-06-15T09:00:00Z\"^^xsd:dateTime ."@x-gmeow-english ;
    gmeow:avoidForConsumer gmeow:consumerPublicSite ,
        gmeow:consumerWikidata ;
    gmeow:avoidWhen "Avoid for in-system derivations that produce no external-source envelope (use a plain gmeow:Activity with gmeow:wasDerivedFrom) and for the moment a fact was asserted by an observer (that is statement-level gmeow:assertedAt, not ingestion)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Type the import as gmeow:ImportActivity, stamp it with gmeow:ingestedAt, tie it to its software agent with gmeow:wasAssociatedWith, and record per-claim gmeow:mappedFrom / gmeow:importanceLevel on the statements it generated; the ingested claims point back via gmeow:wasGeneratedBy."@x-gmeow-english ;
    gmeow:useForConsumer gmeow:consumerAgentMemory ,
        gmeow:consumerInternalArchive ;
    gmeow:useWhen "Use when modeling the ingestion of an external source — a vCard, mbox, or feed pulled in — so the transaction time and the source mapping become first-class and auditable."@x-gmeow-english .

gmeow:Summary
    a logic:Kind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "Summary"@x-gmeow-english ;
    rdfs:subClassOf gmeow:InformationObject ;
    skos:definition "A condensed account derived from a source information object (often machine-generated), linked to its source by gmeow:wasDerivedFrom. A lossy projection of its source: the source remains canonical and the summary is the reduced view."@x-gmeow-english ;
    skos:example "ex:summary a gmeow:Summary ; gmeow:wasDerivedFrom ex:report ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a verbatim slice of the source text (use gmeow:TextExtraction) and for an independently authored work that merely covers the same topic; a Summary asserts derivation from a specific source."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Type the condensed object as gmeow:Summary and link it to its source with gmeow:wasDerivedFrom; record the generating model via gmeow:wasGeneratedBy and the summarization confidence and lossiness on the statement layer."@x-gmeow-english ;
    gmeow:useForConsumer gmeow:consumerAgentMemory ,
        gmeow:consumerResearchQueue ;
    gmeow:useWhen "Use for a condensed, lossy account derived from a source information object — a machine- or human-written abstract whose source stays canonical and whose lineage must be recoverable."@x-gmeow-english .

gmeow:TextExtraction
    a logic:SubKind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "Text Extraction"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Document ;
    skos:definition "The text content extracted from a source object (e.g. a PDF attachment), linked to its source by gmeow:wasDerivedFrom. A faithful (ideally verbatim) rendering of the source's textual content, distinct from a gmeow:Summary, which condenses and is therefore lossy."@x-gmeow-english ;
    skos:example "ex:pdfText a gmeow:TextExtraction ; gmeow:wasDerivedFrom ex:pdfAttachment ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for a condensed or paraphrased account (use gmeow:Summary) and for the source document itself; a TextExtraction is the derived text view, not the original artifact."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxTBox ;
    gmeow:howToUse "Type the extracted text as gmeow:TextExtraction, link it to its source with gmeow:wasDerivedFrom, and name the extracting activity via gmeow:wasGeneratedBy; record extraction confidence (OCR quality) on the statement layer."@x-gmeow-english ;
    gmeow:useForConsumer gmeow:consumerAgentMemory ,
        gmeow:consumerInternalArchive ;
    gmeow:useWhen "Use for the text content pulled verbatim out of a source object — OCR or extraction from a PDF, image, or binary attachment — whose lineage to that source must be recorded."@x-gmeow-english .

gmeow:approvalOf
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Approval ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "approval of"@x-gmeow-english ;
    rdfs:range gmeow:Entity ;
    skos:definition "Relates an Approval to the body of work it approves. It is the second role of the Approval relator, which needs an approved work as well as an approver; without it an approval would not be about anything. A single Approval approves one body of work, and approval of several works is several Approval nodes."@x-gmeow-english ;
    skos:example "ex:approval1 gmeow:approvalOf ex:handbook ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid it for the part of the work that was approved (use gmeow:approvalScope) and for the agent who approved (use gmeow:approvedBy); naming a work here does not make the approver a holder of its claims."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point the gmeow:Approval at the whole work approved, whether a creative work, an information object or another entity; narrow the approval to a part with gmeow:approvalScope, not by pointing here at the part."@x-gmeow-english ;
    gmeow:useWhen "Use to name the body of work that an Approval approves."@x-gmeow-english .

gmeow:approvalScope
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Approval ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "approval scope"@x-gmeow-english ;
    rdfs:range gmeow:Entity ;
    skos:definition "Relates an Approval to a part of the approved work that the approval covers: a component reached by gmeow:partOf, or a citation selector for a pinpoint. It is optional and not functional, so one Approval can name several parts. When it is absent the scope is unstated; that never means the whole work was approved."@x-gmeow-english ;
    skos:example "ex:approval1 gmeow:approvalScope ex:handbookChapter3 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid it for the whole work (that is gmeow:approvalOf), and avoid reading a missing value as approval of everything; also avoid it for a time window, which is not a part of a work."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point at each approved part, or at a citation selector when only a pinpoint is covered; leave it off when the scope was not stated rather than naming the whole work."@x-gmeow-english ;
    gmeow:useWhen "Use to say which part of a body of work an Approval covers when the approval is narrower than the work."@x-gmeow-english .

gmeow:approvedBy
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Approval ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "approved by"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "Relates an Approval to the person or agent who approved the body of work. An approver is not thereby a holder of the work's claims, an author or a contributor: this property is deliberately not a subproperty of gmeow:accordingTo, gmeow:vantage, gmeow:wasAttributedTo, gmeow:wasAssociatedWith or any contributor property, so that holding claims and approving a work stay separate facts, both expressible."@x-gmeow-english ;
    skos:example "ex:approval1 gmeow:approvedBy ex:drOkafor ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid it to say whose frame holds a claim (use gmeow:accordingTo), who is responsible for the work (use gmeow:wasAttributedTo), who is credited for making it (use a gmeow:Contribution) or who recorded the approval (use gmeow:reportedBy)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Set one gmeow:Agent on each Approval; for a joint approval mint one Approval per approver. Do not infer holding of the work's claims, authorship or endorsement of every part from it."@x-gmeow-english ;
    gmeow:useWhen "Use to name the person or agent who approved a body of work in an Approval."@x-gmeow-english .

gmeow:approvedOn
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:Approval ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "approved on"@x-gmeow-english ;
    rdfs:range xsd:date ;
    skos:definition "The calendar day on which an Approval was given, typed as xsd:date. It is a day, not an instant: no time of day and no midnight is invented for it."@x-gmeow-english ;
    skos:example "ex:approval1 gmeow:approvedOn \"2026-11-05\"^^xsd:date ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid it for the instant of a signed vouching act (use gmeow:issuedAt on a gmeow:Attestation), for when the system learned of the approval (gmeow:ingestedAt or gmeow:recordedAt) and for a validity window; avoid padding a day to a date-time."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Attach one xsd:date literal to the gmeow:Approval; a different day is a different approval and so a new node."@x-gmeow-english ;
    gmeow:useWhen "Use to record the day an approval was given when only the date is known or meant."@x-gmeow-english .

gmeow:confidence
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "confidence"@x-gmeow-english ;
    logic:instantiatesFramework logic:ProbabilisticFramework ;
    skos:definition "Confidence in a claim, in the closed interval [0,1], attached to the statement it qualifies."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernProvenanceEvidence ,
        gmeow:concernStatementMetadata ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

gmeow:importanceLevel
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "importance level"@x-gmeow-english ;
    skos:definition "Relative import/source importance of a claim on a 0–10 scale; projection takes the maximum across imports."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

gmeow:ingestedAt
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:ImportActivity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "ingested at"@x-gmeow-english ;
    rdfs:range xsd:dateTime ;
    skos:definition "When an import activity recorded its claims into the system — the transaction time. Distinct from gmeow:assertedAt (observation) and gmeow:validFrom/validUntil (validity)."@x-gmeow-english ;
    skos:example "ex:import2026 gmeow:ingestedAt \"2026-06-15T09:00:00Z\"^^xsd:dateTime ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the observation time of a claim (statement-level gmeow:assertedAt) or the time a fact holds in the world (gmeow:validFrom / gmeow:validUntil); collapsing the three temporal axes defeats the bitemporal model."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Attach exactly one xsd:dateTime to the gmeow:ImportActivity (it is functional); pair it with gmeow:wasAssociatedWith for the importing agent, and let the ingested claims carry their own gmeow:assertedAt on the statement layer."@x-gmeow-english ;
    gmeow:useWhen "Use to stamp a gmeow:ImportActivity with its transaction time — the instant the system learned the claims — so bitemporal queries can separate when-learned from when-asserted and when-valid."@x-gmeow-english .

gmeow:mappedFrom
    a logic:AnnotationProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "mapped from"@x-gmeow-english ;
    skos:definition "The source property a claim was derived from during ingestion, recorded for mapping-step audit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox .

gmeow:provenance
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "provenance"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "A free-text statement of any changes in ownership and custody of a resource since its creation that are significant for its authenticity, integrity, and interpretation (the dcterms:provenance idiom). A prose escape hatch — prefer the structured derivation, generation, and attribution links when the custody chain can be modelled as graph relations."@x-gmeow-english ;
    skos:example "ex:report gmeow:provenance \"Donated 1998; held by the city archive since 2004.\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid when the custody chain can be expressed structurally; prefer gmeow:wasDerivedFrom, gmeow:wasGeneratedBy, and gmeow:wasAttributedTo so the lineage is queryable rather than locked in a literal."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Attach the prose to the gmeow:Entity as a literal; where parts of the narrative can be lifted into structured derivation, generation, or attribution links, model those and reserve this property for the irreducible remainder."@x-gmeow-english ;
    gmeow:useWhen "Use for a human-readable custody/ownership narrative that resists structured modelling — provenance prose imported from a catalogue record or curator's note."@x-gmeow-english .

gmeow:reportedBy
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Approval ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "reported by"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "Relates an Approval to the agent who put the approval on record. The reporter only recorded it: they need not be the approver, and reporting makes them neither responsible for the approved work nor a holder of its claims. It differs from gmeow:wasAttributedTo, which ascribes responsibility (authorship, ownership or accountability) for an entity to an agent, and from gmeow:approvedBy, which names who gave the approval. It is optional, not functional, and not a subproperty of anything."@x-gmeow-english ;
    skos:example "ex:approval1 gmeow:reportedBy ex:registryClerk ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid it for the agent who gave the approval (use gmeow:approvedBy), for responsibility for the Approval or the work (use gmeow:wasAttributedTo) and for the party who ran an import (use gmeow:wasAssociatedWith on the gmeow:ImportActivity)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Set it on the gmeow:Approval for each agent who reported the approval; several reporters may coexist. Omit it when the recorder is unknown."@x-gmeow-english ;
    gmeow:useWhen "Use to name who put an approval on record when that party differs from the approver."@x-gmeow-english .

gmeow:wasAssociatedWith
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "was associated with"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "Relates an activity to an agent associated with carrying it out — e.g. the software agent that ran an import. (Activity→Agent; the counterpart of gmeow:wasAttributedTo, which ascribes an endurant Entity to an agent.)"@x-gmeow-english ;
    skos:example "ex:import2026 gmeow:wasAssociatedWith ex:vcardImporter ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for ascribing an enduring product to its author (use gmeow:wasAttributedTo on the gmeow:Entity) and for a role richer than bare association — promote to a participation relator when capacity or responsibility share matters."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Relate the gmeow:Activity to its performing gmeow:Agent; record the activity's products through the inverse of gmeow:wasGeneratedBy and its time on the event, so performer, product, and timing stay separable."@x-gmeow-english ;
    gmeow:useWhen "Use to tie an activity to the agent that carried it out — the software agent that ran an import, the person who performed a transformation — the activity-side companion of gmeow:wasAttributedTo."@x-gmeow-english .

gmeow:wasAttributedTo
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "was attributed to"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "Ascribes responsibility for an enduring entity to an agent — authorship, ownership, or accountability. The endurant counterpart of gmeow:wasAssociatedWith (which ties an activity to its performer): attribution lands on the gmeow:Entity, association on the gmeow:Activity."@x-gmeow-english ;
    skos:example "ex:report gmeow:wasAttributedTo ex:lillith ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the agent who performed an activity (use gmeow:wasAssociatedWith) and for nuanced credit needing role, share, or period — promote to a Contribution relator rather than flattening it onto this binary link."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernProvenanceEvidence ,
        gmeow:concernStatementMetadata ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Relate the gmeow:Entity to its responsible gmeow:Agent; when the attribution itself is uncertain or sourced, carry gmeow:confidence and the asserting source on the statement layer, and reify to a Contribution relator when role or credit share matters (P3)."@x-gmeow-english ;
    gmeow:useWhen "Use to ascribe responsibility for an enduring entity — a document, dataset, or artifact — to the agent who authored, owns, or is accountable for it."@x-gmeow-english .

gmeow:indirectContributor
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "indirect contributor"@x-gmeow-english ;
    rdfs:range gmeow:Agent ;
    skos:definition "The agent indirectly credited with an entity: derived, never asserted, by composing the entity's generating activity (gmeow:wasGeneratedBy) with that activity's performer (gmeow:wasAssociatedWith), so an entity's indirect contributors are exactly the agents that ran the activities that produced it. Distinct from gmeow:wasAttributedTo, which ascribes DIRECT responsibility — authorship, ownership, accountability — as an asserted fact: indirect contribution is a reasoned consequence of the generation chain and must never be read as, nor collapse into, that direct attribution."@x-gmeow-english ;
    skos:example "ex:summary gmeow:indirectContributor ex:vcardImporter ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid asserting this link by hand — it is derived from gmeow:wasGeneratedBy and gmeow:wasAssociatedWith by the reasoner; and avoid reading it as direct authorship or accountability, which is gmeow:wasAttributedTo."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernProvenanceEvidence ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Do not assert it: record the generating gmeow:Activity with gmeow:wasGeneratedBy and its performer with gmeow:wasAssociatedWith, and let the cross-slice derivation rule surface the indirect contributor; consume it to credit the agents behind an entity's production without conflating them with its directly attributed responsible party."@x-gmeow-english ;
    gmeow:useWhen "Use to read off the agents that indirectly contributed to an entity through the activities that generated it — the performers reached by composing generation with association — as distinct from the entity's directly attributed author or owner."@x-gmeow-english .

gmeow:wasDerivedFrom
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "was derived from"@x-gmeow-english ;
    skos:definition "Relates a derived thing to the thing it was derived from — e.g. a text extraction, summary, or embedding to its source; a commit to its parent commit; a trajectory to its sample stream. The derivation's confidence and generating agent are recorded with gmeow:confidence and gmeow:wasGeneratedBy. Domain-free so that events, endurants, and information objects may all participate in derivation chains."@x-gmeow-english ;
    skos:example "ex:summary gmeow:wasDerivedFrom ex:report ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the activity that did the deriving (use gmeow:wasGeneratedBy → gmeow:Activity) and for mere topical aboutness (use gmeow:hasAboutness); derivation asserts genealogical descent, not subject matter."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernProvenanceEvidence ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point the derived thing at its source; carry the derivation's gmeow:confidence and lossiness on the statement layer (a summary is a lossy projection of its source), and attach gmeow:wasGeneratedBy to name the generating activity and, through it, the agent."@x-gmeow-english ;
    gmeow:useWhen "Use to link a derived artifact to its source — a summary, text extraction, or embedding to the document it came from, a commit to its parent — building the derivation chain that lets consumers trace a value back to its origin."@x-gmeow-english .

gmeow:wasGeneratedBy
    a logic:ObjectProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "was generated by"@x-gmeow-english ;
    rdfs:range gmeow:Activity ;
    skos:definition "Relates an entity to the activity that produced it — the generation link from an enduring product back to its occurrent cause. The performing agent is reached transitively through the activity's gmeow:wasAssociatedWith, keeping who-did-it separable from what-happened."@x-gmeow-english ;
    skos:example "ex:summary gmeow:wasGeneratedBy ex:summarizationRun ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the source the product was derived from (use gmeow:wasDerivedFrom, entity→entity) and for naming the agent directly; reach the agent through the activity's gmeow:wasAssociatedWith rather than collapsing activity and agent."@x-gmeow-english ;
    gmeow:docsConcern gmeow:concernProvenanceEvidence ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Point the gmeow:Entity at its generating gmeow:Activity; put the time on the activity (event), the performer on gmeow:wasAssociatedWith, and the source lineage on gmeow:wasDerivedFrom, so generation, derivation, and association stay three distinct facets."@x-gmeow-english ;
    gmeow:useWhen "Use to link an enduring product to the gmeow:Activity that produced it — a summary to its summarization run, a commit to its build — so the occurrent cause and its timing and agent become recoverable."@x-gmeow-english .

<https://blackcatinformatics.ca/gmeow/slices/provenance>
    a logic:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "Activities, attribution, and the cross-cutting statement-level annotation properties (confidence, importance, mapping provenance) used across every slice (the PROV-O superset layer)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "GMEOW Provenance Module"@x-gmeow-english ;
    skos:definition "The GMEOW Provenance Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxConfigBox ,
        gmeow:boxTBox .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects OWL FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:ingestedAtFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "ingestedAt is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:ingestedAt is functional: a gmeow:ImportActivity has a single transaction time — the one instant it recorded its claims into the system — so exactly one xsd:dateTime stamps the activity, keeping the ingest axis distinct from assertion and validity."@x-gmeow-english ;
    logic:characterizes gmeow:ingestedAt ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:ingestedAt ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:ingestedAt names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:ingestedAt, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:ingestedAt and nothing else. It is not a definition of gmeow:ingestedAt (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:ingestedAtFunctionality logic:characterizes gmeow:ingestedAt ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:approvalOfFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "approvalOf is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:approvalOf is functional: an Approval approves exactly one body of work, so approval of several works is several Approval nodes rather than several works on one."@x-gmeow-english ;
    logic:characterizes gmeow:approvalOf ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:approvalOf ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:approvalOf names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:approvalOf, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:approvalOf and nothing else. It is not a definition of gmeow:approvalOf (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:approvalOfFunctionality logic:characterizes gmeow:approvalOf ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:approvedByFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "approvedBy is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:approvedBy is functional: an Approval has exactly one approver, so a co-approval is modelled as several Approval nodes, one per approver, rather than two approvers on one."@x-gmeow-english ;
    logic:characterizes gmeow:approvedBy ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:approvedBy ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:approvedBy names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:approvedBy, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:approvedBy and nothing else. It is not a definition of gmeow:approvedBy (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:approvedByFunctionality logic:characterizes gmeow:approvedBy ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:approvedOnFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    rdfs:label "approvedOn is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:approvedOn is functional: an Approval was given on exactly one day, so a different day is a different Approval node rather than a second date on the same one."@x-gmeow-english ;
    logic:characterizes gmeow:approvedOn ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:approvedOn ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:approvedOn names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:approvedOn, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:approvedOn and nothing else. It is not a definition of gmeow:approvedOn (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:approvedOnFunctionality logic:characterizes gmeow:approvedOn ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:summaryOf
    a logic:ObjectProperty ;
    logic:domain gmeow:Summary ;
    logic:range gmeow:InformationObject ;
    logic:subPropertyOf gmeow:wasDerivedFrom ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "summarized source"@x-gmeow-english ;
    skos:definition "The identified source information object whose content this Summary condenses."@x-gmeow-english ;
    skos:scopeNote "This optional, nonfunctional relation identifies a particular summarization role within the source lineage. A summary may condense several supplied sources; another derivation input is not automatically a summarized source. The link certifies no fidelity, complete coverage, execution or source-byte identity."@x-gmeow-english ;
    skos:example "Record ex:summary gmeow:summaryOf ex:division while a retrieval Chunk keeps its actual summary-text carrier through chunkOf."@x-gmeow-english ;
    gmeow:useWhen "Use to identify the actual source work, division or other information object whose content a supplied Summary condenses."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting mere topical aboutness, production instructions or the output's retrieval-carrier role for an identified summarized source, inferring the role from every wasDerivedFrom link, or treating generated summary text as a contiguous cut of its original source."@x-gmeow-english ;
    gmeow:howToUse "Link the Summary to each identified summarized InformationObject and retain actual source, viewpoint and confidence on the exact assertion. Preserve other actual lineage separately; never invent missing source identities, a unique target, source fidelity or original-source offsets."@x-gmeow-english .

gmeow:provenanceDigest
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "provenance digest"@x-gmeow-english ;
    skos:definition "The supplied SHA-256 digest of the exact identified bytes of the producer-stamped provenance bookkeeping item set aside whole outside the knowledge graph for an Activity record, serving as that record’s pointer to the item while it is retained."@x-gmeow-english ;
    skos:scopeNote "This optional, nonfunctional pointer identifies the whole set-aside bookkeeping item rather than its individual leaves. Its preimage is not the Activity record’s own bytes. The relation supplies neither a store location nor a guarantee of retrieval, byte verification or permanent retention."@x-gmeow-english ;
    skos:example "A producer keeps an activity record’s evidence identifiers and contract bookkeeping as one separate item for review; the record retains that item’s supplied SHA-256 pointer instead of asserting each leaf as graph facts."@x-gmeow-english ;
    gmeow:useWhen "Use when the producer’s provenance bookkeeping is machinery kept elsewhere whole for review, and the Activity record keeps its supplied SHA-256 pointer instead of expanding the bookkeeping into graph facts."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid for the record’s own contentDigest, provenance already stated as facts, a wasDerivedFrom source, another hash algorithm, or an invented encoding, store address or verification claim."@x-gmeow-english ;
    gmeow:howToUse "Keep the supplied xsd:hexBinary literal on the Activity as exactly 64 bare lowercase hexadecimal digits. Preserve source attribution and identification of the separate item and its actual bytes; do not retype the literal, infer an encoding, or claim that the item was retrieved or its digest checked."@x-gmeow-english ;
    logic:domain gmeow:Activity ;
    logic:range xsd:hexBinary .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/provenanceDigest" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:ProvenanceDigestLexicalConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Provenance digest lexical constraint"@x-gmeow-english ;
    skos:definition "Every supplied provenanceDigest has exactly 64 bare lowercase hexadecimal digits; its provided-value range independently requires xsd:hexBinary. SHA-256 is fixed by the property’s meaning, not inferred from arbitrary hexadecimal values."@x-gmeow-english ;
    skos:scopeNote "This is supplied-value syntax admission. It computes no hash and certifies neither the item’s bytes, agreement with its reported digest, retrieval nor retention. No missing pointer is invented and no other digest representation is substituted."@x-gmeow-english ;
    skos:example "A supplied pointer with an algorithm prefix or uppercase hexadecimal fails this lexical contract even when the source labels it SHA-256."@x-gmeow-english ;
    gmeow:useWhen "Use to validate the exact lowercase hexadecimal spelling of each supplied provenanceDigest without changing its literal identity."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating lexical acceptance as verified SHA-256 agreement, accepting a generic digest fallback, normalizing invalid input or requiring a pointer on every Activity."@x-gmeow-english ;
    gmeow:howToUse "Apply the canonical positive provenanceDigest guard and the exact pattern ^[0-9a-f]{64}$ to its supplied value. Combine this lexical obligation with the property’s provided-value Activity and xsd:hexBinary checks; reject failures without retyping or replacing the source value."@x-gmeow-english ;
    logic:message "Every supplied provenanceDigest has exactly 64 bare lowercase hexadecimal digits; its provided-value range independently requires xsd:hexBinary. SHA-256 is fixed by the property’s meaning, not inferred from arbitrary hexadecimal values."@x-gmeow-english ;
    logic:formalizes gmeow:provenanceDigest ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "activity" ] , [ logic:termIndex 1 ; logic:termVariable "digest" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:provenanceDigest ; logic:argument [ logic:termIndex 0 ; logic:termVariable "activity" ] , [ logic:termIndex 1 ; logic:termVariable "digest" ] ] ; logic:consequent [ a logic:Formula ; logic:relation logic:termRegex ; logic:argument [ logic:termIndex 0 ; logic:termVariable "digest" ] , [ logic:termIndex 1 ; logic:termLiteral "^[0-9a-f]{64}$" ] ] ] ] .
