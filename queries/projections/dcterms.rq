# Projection: GMEOW → pure dcterms. GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: the Copyright relator (year, notice, status) collapses to a flat dcterms:rightsHolder edge; the structured Copyright collapses to a free-text dcterms:rights string.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX dcterms: <http://purl.org/dc/terms/>

CONSTRUCT {
    ?work dcterms:license ?lic .
    ?cw dcterms:rightsHolder ?holder .
    ?cw dcterms:rights ?notice .
    ?cw dcterms:dateCopyrighted ?yr .
}
WHERE {
    {
        ?work gmeow:hasLicense ?lic .
    }
    UNION {
        ?cw gmeow:hasCopyright ?cr .
        ?cr gmeow:copyrightHolder ?holder .
    }
    UNION {
        ?cw gmeow:hasCopyright ?cr .
        ?cr gmeow:copyrightNotice ?notice .
    }
    UNION {
        ?cw gmeow:hasCopyright ?cr .
        ?cr gmeow:copyrightYear ?yr .
    }
}
