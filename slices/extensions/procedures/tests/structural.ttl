    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:executionStatusPending   a gmeow:ExecutionStatus .
    gmeow:executionStatusRunning   a gmeow:ExecutionStatus .
    gmeow:executionStatusSucceeded a gmeow:ExecutionStatus .
    gmeow:executionStatusFailed    a gmeow:ExecutionStatus .
    gmeow:executionStatusCancelled a gmeow:ExecutionStatus .
    gmeow:executionStatusSkipped   a gmeow:ExecutionStatus .
}""" ;
    gmeow:saRationale "All six ExecutionStatus seed individuals MUST be typed gmeow:ExecutionStatus — execution status values are an open individual vocabulary, never subclasses (Principle 9, #226). Mirrors test_execution_status_values_are_individuals (must arm)." .

