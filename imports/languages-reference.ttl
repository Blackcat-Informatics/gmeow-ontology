    gmeow:languageStatus gmeow:statusLiving ;
    gmeow:usesWritingSystem gmeow:wsLatin ;
    gmeow:hasAppellation gmeow:appGermanEndonym, gmeow:appGermanExonym ;
    skos:exactMatch wd:Q188 ;
    skos:exactMatch <http://lexvo.org/id/iso639-3/deu> ;
    skos:exactMatch <https://glottolog.org/resource/languoid/id/stan1295> ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/languages-reference> .

gmeow:appGermanEndonym a gmeow:Appellation ;
