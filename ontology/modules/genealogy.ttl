@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/genealogy>
    a owl:Ontology ;
    rdfs:label "GMEOW Genealogy Module"@en ;
    rdfs:comment "A comprehensive, evidence-centric genealogy model: reified, typed kinship relationships and kinship convenience properties. Life events themselves are modelled by the universal events module (gmeow:Event + gmeow:eventType value vocabulary + the gmeow:Participation relator); a person's life events are gmeow:LifeEvent occurrences carrying gmeow:eventTypeBirth / …Marriage / …NameChange etc. Structured naming terms (gmeow:PersonName et al.) live in the names module and link to the event that confers them via gmeow:conferredByEvent. Supersedes the unmaintained W3C SWAP gedcom vocabulary; aligned to BIO, GEDCOM X, schema.org, Wikidata, REL and GeoNames."@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# Classes

gmeow:Family
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Group ;
    rdfs:label "Family"@en ;
    skos:definition "A kinship group of persons related by descent, marriage, or adoption."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# Life events are modelled by the universal events module: gmeow:LifeEvent
# (⊑ gmeow:Event), the gmeow:eventType value vocabulary (eventTypeBirth, …Death,
# …Marriage, …), the gmeow:Participation relator (principal/witness/officiant are
# gmeow:ParticipantRole values), structured time (gmeow:eventTime / eventInterval
# / fuzzy bounds) and gmeow:eventLocation. Genealogy no longer defines its own
# event types, role subproperties, or free-text eventDate.

gmeow:KinRelationship
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Kin Relationship"@en ;
    skos:definition "A reified kinship relationship between persons, able to bear its own events, dates and sources."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:CoupleRelationship
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:KinRelationship ;
    rdfs:label "Couple Relationship"@en ;
    skos:definition "A reified couple relationship (marriage, civil union, or partnership) between two persons; bears marriage, divorce and related events."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:ParentChildRelationship
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:KinRelationship ;
    rdfs:label "Parent-Child Relationship"@en ;
    skos:definition "A reified parent-child relationship, typed by its nature (biological, adoptive, step, or foster)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:BiologicalParentChild
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:ParentChildRelationship ;
    rdfs:label "Biological Parent-Child"@en ;
    skos:definition "A parent-child relationship by biological descent."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:AdoptiveParentChild
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:ParentChildRelationship ;
    rdfs:label "Adoptive Parent-Child"@en ;
    skos:definition "A parent-child relationship established by adoption."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:StepParentChild
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:ParentChildRelationship ;
    rdfs:label "Step Parent-Child"@en ;
    skos:definition "A parent-child relationship through marriage to a biological/adoptive parent."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:FosterParentChild
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:ParentChildRelationship ;
    rdfs:label "Foster Parent-Child"@en ;
    skos:definition "A parent-child relationship through fostering."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# Names live in the dedicated names module: a person bears a gmeow:PersonName
# (a gmeow:Appellation) via gmeow:hasName, with structured gmeow:NamePart
# components. Genealogy links a name to the event that confers it via
# gmeow:conferredByEvent (Christening, NameChange, Marriage, Adoption).

# Properties

gmeow:hasParent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Person ;
    rdfs:range gmeow:Person ;
    rdfs:label "has parent"@en ;
    skos:definition "Relates a person to a parent (any kind: biological, adoptive, step, or foster)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasChild
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:hasParent ;
    rdfs:domain gmeow:Person ;
    rdfs:range gmeow:Person ;
    rdfs:label "has child"@en ;
    skos:definition "Relates a person to a child; the inverse of hasParent."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasMother
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasParent ;
    rdfs:domain gmeow:Person ;
    rdfs:range gmeow:Person ;
    rdfs:label "has mother"@en ;
    skos:definition "Relates a person to a female parent."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasFather
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasParent ;
    rdfs:domain gmeow:Person ;
    rdfs:range gmeow:Person ;
    rdfs:label "has father"@en ;
    skos:definition "Relates a person to a male parent."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasSpouse
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain gmeow:Person ;
    rdfs:range gmeow:Person ;
    rdfs:label "has spouse"@en ;
    skos:definition "Relates a person to a spouse; symmetric."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasSibling
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain gmeow:Person ;
    rdfs:range gmeow:Person ;
    rdfs:label "has sibling"@en ;
    skos:definition "Relates a person to a sibling; symmetric."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasPartner
    a owl:ObjectProperty ;
    rdfs:domain gmeow:CoupleRelationship ;
    rdfs:range gmeow:Person ;
    rdfs:label "has partner"@en ;
    skos:definition "Relates a couple relationship to one of its two partners."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:relationshipParent
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ParentChildRelationship ;
    rdfs:range gmeow:Person ;
    rdfs:label "relationship parent"@en ;
    skos:definition "The parent in a reified parent-child relationship."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:relationshipChild
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ParentChildRelationship ;
    rdfs:range gmeow:Person ;
    rdfs:label "relationship child"@en ;
    skos:definition "The child in a reified parent-child relationship."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# A person's sex/gender is modelled in the dedicated gender + sexuality modules:
# gmeow:sexAssignedAtBirth (a recorded administrative datum) and the self-asserted
# gmeow:hasGenderIdentity / gmeow:hasGenderExpression / orientation facets — kept
# rigorously separate from one another and from address (pronouns/honorifics in
# names). Documentary sex on historical records uses external gedcom:sex directly.

# =========================================================================== #
# AXIOMATIZED DOCTRINE (#38 — phase 2 of the reasoning-depth epic #35)
#
# Derived ancestry. gmeow:hasAncestor is transitive and gmeow:hasParent is one of
# its sub-properties, so hasParent ∘ hasParent ⊑ hasAncestor is ENTAILED — a
# reasoner derives the full ancestor/descendant closure that was never asserted.
# All EL (transitive property + sub-property); gmeow:hasDescendant adds the DL
# inverse (HermiT-complete). gmeow:hasAncestor / hasDescendant are non-simple
# (transitive) and so are deliberately kept out of every cardinality / functional
# axiom, preserving OWL 2 DL regularity.
# =========================================================================== #

gmeow:hasAncestor
    a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain gmeow:Person ;
    rdfs:range gmeow:Person ;
    rdfs:label "has ancestor"@en ;
    skos:definition "Relates a person to an ancestor — a parent, a parent's parent, and so on. Transitive: an ancestor of an ancestor is an ancestor. gmeow:hasParent (hence gmeow:hasMother / hasFather) is a sub-property, so ancestry is DERIVED from parentage by the reasoner and is never asserted directly."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasDescendant
    a owl:ObjectProperty, owl:TransitiveProperty ;
    owl:inverseOf gmeow:hasAncestor ;
    rdfs:domain gmeow:Person ;
    rdfs:range gmeow:Person ;
    rdfs:label "has descendant"@en ;
    skos:definition "Relates a person to a descendant — a child, a child's child, and so on; the transitive inverse of gmeow:hasAncestor. Derived by the reasoner (gmeow:hasChild is a sub-property), never asserted directly."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasParent rdfs:subPropertyOf gmeow:hasAncestor .
gmeow:hasChild  rdfs:subPropertyOf gmeow:hasDescendant .

# Relator mediation: a parent-child relationship mediates a parent and a child
# (EL existential, open-world; closed-world cardinality is SHACL's, #39). Applies
# to every subtype (Biological / Adoptive / Step / Foster).
gmeow:ParentChildRelationship rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:relationshipParent ; owl:someValuesFrom gmeow:Person ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:relationshipChild ; owl:someValuesFrom gmeow:Person ] .
