# SPDX-License-Identifier: CC-BY-4.0
#
# Declarative structural assertions for the rights slice — the slice-resident
# test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants formerly hand-written
# in tests/test_rights.py. Each assertion runs as a SPARQL ASK over the rights
# module graph (gmeow:scopeModule) under the native Rust slicetest harness
# (crates/slicetest).
#
# Rights is migrated, so class stereotypes are logic:
# (logic:Kind, logic:SubKind, logic:Category, logic:AbstractIndividualType,
# logic:QualityValue, logic:Relator), not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_expanded_action_vocabulary_is_seeded — asserts len(actions) >= 45, a
#     numeric cardinality check over the live action-individual set; SPARQL ASK
#     cannot express numeric lower-bound counts in a module-scoped cell.
#   test_wellformed_rights_fixture_conforms — SHACL validation call;
#     ExampleConformance, not a structural TBox assertion.
#   test_malformed_rights_fixture_is_flagged — SHACL validation call with error-text
#     assertions; ExampleConformance, not a structural TBox assertion.
#   test_expired_trademark_warns_but_does_not_fail — SHACL validation call;
#     ExampleConformance, not a structural TBox assertion.
#   test_odrl_projection_emits_a_policy_with_rules — project_graph() over loaded
#     coverage fixture; generated-artifact projection check, not a TBox assertion.
#   test_odrl_projection_emits_constraint_and_conflict_logic — project_graph();
#     generated-artifact projection check.
#   test_spdx_projection_emits_listed_license — project_graph();
#     generated-artifact projection check.
#   test_cc_projection_emits_license_and_attribution — project_graph();
#     generated-artifact projection check.
#   test_dcterms_projection_emits_flat_rights — project_graph();
#     generated-artifact projection check.
#   test_schema_projection_emits_rights_cluster — project_graph();
#     generated-artifact projection check.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/rights/tests/> .

# --- 1. Core relators are grounded — class + stereotype pairs (MUST) -----------
ex:saCoreRelatorsGrounded a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:RightsStatement a owl:Class , logic:SubKind .
    gmeow:Copyright        a owl:Class , logic:Kind .
    gmeow:Trademark        a owl:Class , logic:Kind .
    gmeow:Mark             a owl:Class , logic:Kind .
    gmeow:Rule             a owl:Class , logic:Category .
    gmeow:Permission       a owl:Class , logic:Kind .
    gmeow:Prohibition      a owl:Class , logic:Kind .
    gmeow:Duty             a owl:Class , logic:Kind .
    gmeow:License          a owl:Class , logic:SubKind .
}""" ;
    gmeow:saRationale "All nine core rights classes MUST be asserted as owl:Class with their logic: stereotype — RightsStatement/License as logic:SubKind, Copyright/Trademark/Mark/Permission/Prohibition/Duty as logic:Kind, Rule as logic:Category." .

# --- 2. RightsStatement is a subclass of logic:Relator (MUST) ------------------
ex:saRightsStatementSubclassRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:RightsStatement rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:RightsStatement MUST be a subclass of logic:Relator — it reifies the binding of an IP right to its subject as a relator." .

# --- 3. RightsStatement is a subclass of gmeow:Observation (MUST) -------------
ex:saRightsStatementSubclassObservation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:RightsStatement rdfs:subClassOf gmeow:Observation .
}""" ;
    gmeow:saRationale "gmeow:RightsStatement MUST be a subclass of gmeow:Observation — the observation-spine bridge wires rights into the universal claim stack (observation-spine)." .

# --- 4. Permission is a subclass of Rule (MUST) --------------------------------
ex:saPermissionSubclassRule a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Permission rdfs:subClassOf gmeow:Rule .
}""" ;
    gmeow:saRationale "gmeow:Permission MUST be a subclass of gmeow:Rule — the deontic trio (Permission/Prohibition/Duty) specialises the abstract Rule base." .

# --- 5. License is a subclass of gmeow:Agreement (MUST) -----------------------
ex:saLicenseSubclassAgreement a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:License rdfs:subClassOf gmeow:Agreement .
}""" ;
    gmeow:saRationale "gmeow:License MUST be a subclass of gmeow:Agreement — a licence binds licensor and licensee and creates permissions / duties, which IS an agreement." .

# --- 6. Holder properties are subproperties of wasAttributedTo (MUST) ---------
ex:saHolderPropertiesSpecialiseAttribution a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:copyrightHolder  rdfs:subPropertyOf gmeow:wasAttributedTo .
    gmeow:trademarkHolder  rdfs:subPropertyOf gmeow:wasAttributedTo .
}""" ;
    gmeow:saRationale "gmeow:copyrightHolder and gmeow:trademarkHolder MUST both be subproperties of gmeow:wasAttributedTo — holder attribution reuses the generic attribution property (Principle: reuse not duplicate)." .

# --- 7. Licence party properties are subproperties of hasParty (MUST) ---------
ex:saLicencePartyPropertiesSpecialiseHasParty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:licensor rdfs:subPropertyOf gmeow:hasParty .
    gmeow:licensee rdfs:subPropertyOf gmeow:hasParty .
}""" ;
    gmeow:saRationale "gmeow:licensor and gmeow:licensee MUST both be subproperties of gmeow:hasParty — licence parties reuse the generic party property rather than a separate model (Principle: reuse not duplicate)." .

# --- 8. Deontic trio Permission/Prohibition/Duty is pairwise disjoint (MUST) --
ex:saDeonticTrioIsDisjoint a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    ?adc a owl:AllDisjointClasses ;
         owl:members ( gmeow:Permission gmeow:Prohibition gmeow:Duty ) .
}""" ;
    gmeow:saRationale "gmeow:Permission, gmeow:Prohibition, and gmeow:Duty MUST be declared pairwise disjoint via owl:AllDisjointClasses — no rights rule may simultaneously grant and forbid an action (the ODRL closed-world rule model)." .

# --- 9. Value vocabularies are subclasses of logic:QualityValue (MUST) ---------
ex:saValueVocabulariesAreQualityValues a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:RightsAction     rdfs:subClassOf logic:QualityValue .
    gmeow:LicenseFamily    rdfs:subClassOf logic:QualityValue .
    gmeow:TrademarkStatus  rdfs:subClassOf logic:QualityValue .
    gmeow:CopyrightStatus  rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:RightsAction, LicenseFamily, TrademarkStatus, and CopyrightStatus MUST all be subclasses of logic:QualityValue — they are open individuals-based value vocabularies, never subclassed per value (Principle 9)." .

# --- 10. One seed individual from each value vocabulary exists (MUST) ----------
ex:saValueVocabularySeedIndividualsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:actionReproduce          a gmeow:RightsAction .
    gmeow:licenseFamilyCC          a gmeow:LicenseFamily .
    gmeow:trademarkStatusRegistered a gmeow:TrademarkStatus .
    gmeow:copyrightStatusInCopyright a gmeow:CopyrightStatus .
}""" ;
    gmeow:saRationale "A representative seed individual from each value vocabulary MUST exist: gmeow:actionReproduce (RightsAction), licenseFamilyCC (LicenseFamily), trademarkStatusRegistered (TrademarkStatus), copyrightStatusInCopyright (CopyrightStatus)." .

# --- 11. spdxLicenseId is a DatatypeProperty with domain License (MUST) -------
ex:saSpdxLicenseIdPropertyExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:spdxLicenseId a owl:DatatypeProperty ;
        rdfs:domain gmeow:License .
}""" ;
    gmeow:saRationale "gmeow:spdxLicenseId MUST be an owl:DatatypeProperty with rdfs:domain gmeow:License — the SPDX identifier is a mandatory datatype property on every licence (P5 canonical identifier)." .

# --- 12. Constraint algebra — AtomicConstraint/LogicalConstraint subclasses and ruleConstraint (MUST) ---
ex:saConstraintAlgebraTermsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:AtomicConstraint  rdfs:subClassOf gmeow:Constraint .
    gmeow:LogicalConstraint rdfs:subClassOf gmeow:Constraint .
    gmeow:ruleConstraint    a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:AtomicConstraint and LogicalConstraint MUST be subclasses of gmeow:Constraint, and gmeow:ruleConstraint MUST be an owl:ObjectProperty — the ODRL constraint algebra is modelled as two specialisations of an abstract Constraint base." .

# --- 13. ODRL operand/operator/logic/conflict value vocabulary seeds exist (MUST) ---
ex:saConstraintVocabSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:leftOpDateTime  a gmeow:LeftOperand .
    gmeow:operatorLteq    a gmeow:ConstraintOperator .
    gmeow:logicAnd        a gmeow:ConstraintLogic .
    gmeow:conflictProhibit a gmeow:ConflictStrategy .
}""" ;
    gmeow:saRationale "The four ODRL vocabulary seeds gmeow:leftOpDateTime, gmeow:operatorLteq, gmeow:logicAnd, and gmeow:conflictProhibit MUST exist as individuals of their respective value vocabularies — they are the minimal seeds for the constraint algebra." .

# --- 14. Three rightsType seed individuals exist (MUST) -----------------------
ex:saRightsTypeSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:rightsTypeCopyright    a gmeow:RightsType .
    gmeow:rightsTypePatent       a gmeow:RightsType .
    gmeow:rightsTypeTradeSecret  a gmeow:RightsType .
}""" ;
    gmeow:saRationale "gmeow:rightsTypeCopyright, rightsTypePatent, and rightsTypeTradeSecret MUST exist as gmeow:RightsType individuals — these seed the IP-right-kind vocabulary (copyright, patent, trade-secret)." .

# --- 15. Four specific RightsAction seeds exist (MUST) -----------------------
ex:saRightsActionCoreSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:actionSell      a gmeow:RightsAction .
    gmeow:actionStream    a gmeow:RightsAction .
    gmeow:actionModify    a gmeow:RightsAction .
    gmeow:actionAnonymize a gmeow:RightsAction .
}""" ;
    gmeow:saRationale "The four ODRL Common-Vocabulary action seeds gmeow:actionSell, actionStream, actionModify, and actionAnonymize MUST exist as gmeow:RightsAction individuals — they confirm the maximal ODRL common-vocabulary seeding (the non-numeric part of the maximal common-vocabulary seeding)." .

# --- 16. No RightsAction individual is also an owl:Class (MUST-NOT) -----------
ex:saNoActionValueIsAClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    ?action a gmeow:RightsAction , owl:Class .
}""" ;
    gmeow:saRationale "No gmeow:RightsAction individual MUST NOT also be typed owl:Class — actions are values, never per-value subclasses (Principle 9, no overtyping)." .

# --- 17. No gmeow: term in the rights module starts with 'primary' or 'preferred' (MUST-NOT) ---
ex:saNoPreferredOrPrimaryRightsTerm a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    ?s ?p ?o .
    FILTER(
        STRSTARTS(STR(?s), "https://blackcatinformatics.ca/gmeow/") &&
        (
            STRSTARTS(LCASE(STRAFTER(STR(?s), "https://blackcatinformatics.ca/gmeow/")), "primary") ||
            STRSTARTS(LCASE(STRAFTER(STR(?s), "https://blackcatinformatics.ca/gmeow/")), "preferred")
        )
    )
}""" ;
    gmeow:saRationale "No gmeow: term in the rights module MUST start with 'primary' or 'preferred' — Principle 9 forbids preferred/primary selector terms anywhere in the vocabulary (open-world, individuals-first doctrine)." .

# =============================================================================
# 18. Privacy-role cross-slice items (migrated from tests/test_privacy.py)
#    These terms are declared in the rights slice, so the cells live here.
# =============================================================================

# --- 18.1 Privacy roles hasDataSubject / hasDataController are declared (MUST)
ex:saPrivacyRolesDeclared a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasDataSubject a owl:ObjectProperty ;
        rdfs:domain gmeow:RightsStatement ;
        rdfs:range gmeow:Agent .
    gmeow:hasDataController a owl:ObjectProperty ;
        rdfs:domain gmeow:RightsStatement ;
        rdfs:range gmeow:Agent .
}""" ;
    gmeow:saRationale "gmeow:hasDataSubject and gmeow:hasDataController MUST each be an owl:ObjectProperty with rdfs:domain gmeow:RightsStatement and rdfs:range gmeow:Agent — the privacy-role pair names the data subject and controller for a consent/processing rights statement." .

# --- 18.2 PrivacyNotice is a subclass of InformationObject (MUST) ------------
ex:saPrivacyNoticeIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:PrivacyNotice a owl:Class ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:PrivacyNotice MUST be an owl:Class that is a subclass of gmeow:InformationObject — a privacy notice is an information-object counterpart of a policy." .

# --- 18.3 hasPrivacyNotice is domain-free with range PrivacyNotice (MUST) ----
ex:saHasPrivacyNoticeIsDomainFree a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasPrivacyNotice a owl:ObjectProperty ;
        rdfs:range gmeow:PrivacyNotice .
    FILTER NOT EXISTS { gmeow:hasPrivacyNotice rdfs:domain ?d }
}""" ;
    gmeow:saRationale "gmeow:hasPrivacyNotice MUST be an owl:ObjectProperty with rdfs:range gmeow:PrivacyNotice and MUST be domain-free so it can attach a notice to a governed entity, a gmeow:License, or a gmeow:RightsStatement." .

# --- 18.4 actionProcessPersonalData is a RightsAction (MUST) -----------------
ex:saActionProcessPersonalDataIsRightsAction a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:actionProcessPersonalData a gmeow:RightsAction .
}""" ;
    gmeow:saRationale "gmeow:actionProcessPersonalData MUST be a gmeow:RightsAction individual — the regulated action for personal-data processing rules." .

# --- 19. Permission / Prohibition / Duty retain OWL classhood under Rule (MUST)
ex:saPermissionProhibitionDutyClasshood a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Permission a owl:Class ; rdfs:subClassOf gmeow:Rule .
    gmeow:Prohibition a owl:Class ; rdfs:subClassOf gmeow:Rule .
    gmeow:Duty a owl:Class ; rdfs:subClassOf gmeow:Rule .
}""" ;
    gmeow:saRationale "gmeow:Permission, gmeow:Prohibition, and gmeow:Duty MUST each remain an owl:Class and a subclass of gmeow:Rule so the rights graft preserves the core deontic trio classhood." .

# --- 20. ODRL action vocabulary seeds are RightsAction individuals (MUST) ----
ex:saRightsActionVocabularySeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:actionAcceptTracking            a gmeow:RightsAction .
    gmeow:actionAggregate                 a gmeow:RightsAction .
    gmeow:actionAnnotate                  a gmeow:RightsAction .
    gmeow:actionAnonymize                 a gmeow:RightsAction .
    gmeow:actionArchive                   a gmeow:RightsAction .
    gmeow:actionAttribute                 a gmeow:RightsAction .
    gmeow:actionCommercialize             a gmeow:RightsAction .
    gmeow:actionCompensate                a gmeow:RightsAction .
    gmeow:actionConcurrentUse             a gmeow:RightsAction .
    gmeow:actionDelete                    a gmeow:RightsAction .
    gmeow:actionDerive                    a gmeow:RightsAction .
    gmeow:actionDigitize                  a gmeow:RightsAction .
    gmeow:actionDisplay                   a gmeow:RightsAction .
    gmeow:actionDistribute                a gmeow:RightsAction .
    gmeow:actionEnsureExclusivity         a gmeow:RightsAction .
    gmeow:actionExecute                   a gmeow:RightsAction .
    gmeow:actionExtract                   a gmeow:RightsAction .
    gmeow:actionGive                      a gmeow:RightsAction .
    gmeow:actionGrantUse                  a gmeow:RightsAction .
    gmeow:actionInclude                   a gmeow:RightsAction .
    gmeow:actionIndex                     a gmeow:RightsAction .
    gmeow:actionInform                    a gmeow:RightsAction .
    gmeow:actionInstall                   a gmeow:RightsAction .
    gmeow:actionLease                     a gmeow:RightsAction .
    gmeow:actionLend                      a gmeow:RightsAction .
    gmeow:actionModify                    a gmeow:RightsAction .
    gmeow:actionMove                      a gmeow:RightsAction .
    gmeow:actionNextPolicy                a gmeow:RightsAction .
    gmeow:actionObtainConsent             a gmeow:RightsAction .
    gmeow:actionPlay                      a gmeow:RightsAction .
    gmeow:actionPresent                   a gmeow:RightsAction .
    gmeow:actionPrint                     a gmeow:RightsAction .
    gmeow:actionProcessPersonalData       a gmeow:RightsAction .
    gmeow:actionRead                      a gmeow:RightsAction .
    gmeow:actionReproduce                 a gmeow:RightsAction .
    gmeow:actionRetainNotice              a gmeow:RightsAction .
    gmeow:actionReviewPolicy              a gmeow:RightsAction .
    gmeow:actionSell                      a gmeow:RightsAction .
    gmeow:actionShareAlike                a gmeow:RightsAction .
    gmeow:actionStream                    a gmeow:RightsAction .
    gmeow:actionSynchronize               a gmeow:RightsAction .
    gmeow:actionTextToSpeech              a gmeow:RightsAction .
    gmeow:actionTransfer                  a gmeow:RightsAction .
    gmeow:actionTransform                 a gmeow:RightsAction .
    gmeow:actionTranslate                 a gmeow:RightsAction .
    gmeow:actionUninstall                 a gmeow:RightsAction .
    gmeow:actionUse                       a gmeow:RightsAction .
    gmeow:actionWatermark                 a gmeow:RightsAction .
}""" ;
    gmeow:saRationale "Every seeded ODRL/CC action value MUST remain a gmeow:RightsAction individual. The rule layer regulates action values, not per-action subclasses." .

# --- 21. Constraint and rights value vocabulary seeds exist (MUST) -----------
ex:saRightsValueVocabularySeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:conflictInvalid                                    a gmeow:ConflictStrategy .
    gmeow:conflictPerm                                       a gmeow:ConflictStrategy .
    gmeow:conflictProhibit                                   a gmeow:ConflictStrategy .
    gmeow:logicAnd                                           a gmeow:ConstraintLogic .
    gmeow:logicAndSequence                                   a gmeow:ConstraintLogic .
    gmeow:logicOr                                            a gmeow:ConstraintLogic .
    gmeow:logicXone                                          a gmeow:ConstraintLogic .
    gmeow:copyrightStatusInCopyright                         a gmeow:CopyrightStatus .
    gmeow:copyrightStatusInCopyrightEducationalUse           a gmeow:CopyrightStatus .
    gmeow:copyrightStatusInCopyrightEuOrphanWork             a gmeow:CopyrightStatus .
    gmeow:copyrightStatusInCopyrightNonCommercialUse         a gmeow:CopyrightStatus .
    gmeow:copyrightStatusInCopyrightRightsholderUnlocatable  a gmeow:CopyrightStatus .
    gmeow:copyrightStatusNoCopyrightContractualRestrictions  a gmeow:CopyrightStatus .
    gmeow:copyrightStatusNoCopyrightNonCommercialOnly        a gmeow:CopyrightStatus .
    gmeow:copyrightStatusNoCopyrightOtherLegalRestrictions   a gmeow:CopyrightStatus .
    gmeow:copyrightStatusNoCopyrightUnitedStates             a gmeow:CopyrightStatus .
    gmeow:copyrightStatusNoKnownCopyright                    a gmeow:CopyrightStatus .
    gmeow:copyrightStatusNotEvaluated                        a gmeow:CopyrightStatus .
    gmeow:copyrightStatusPublicDomain                        a gmeow:CopyrightStatus .
    gmeow:copyrightStatusUndetermined                        a gmeow:CopyrightStatus .
    gmeow:licenseFamilyCC                                    a gmeow:LicenseFamily .
    gmeow:licenseFamilyCopyleft                              a gmeow:LicenseFamily .
    gmeow:licenseFamilyDual                                  a gmeow:LicenseFamily .
    gmeow:licenseFamilyPermissive                            a gmeow:LicenseFamily .
    gmeow:licenseFamilyProprietary                           a gmeow:LicenseFamily .
    gmeow:licenseFamilyPublicDomain                          a gmeow:LicenseFamily .
    gmeow:rightsTypeCopyright                                a gmeow:RightsType .
    gmeow:rightsTypeDatabaseRight                            a gmeow:RightsType .
    gmeow:rightsTypeIndustrialDesign                         a gmeow:RightsType .
    gmeow:rightsTypeMoralRights                              a gmeow:RightsType .
    gmeow:rightsTypePatent                                   a gmeow:RightsType .
    gmeow:rightsTypePlantBreedersRights                      a gmeow:RightsType .
    gmeow:rightsTypeRelatedRights                            a gmeow:RightsType .
    gmeow:rightsTypeTradeSecret                              a gmeow:RightsType .
    gmeow:rightsTypeTrademark                                a gmeow:RightsType .
    gmeow:trademarkStatusCancelled                           a gmeow:TrademarkStatus .
    gmeow:trademarkStatusExpired                             a gmeow:TrademarkStatus .
    gmeow:trademarkStatusPending                             a gmeow:TrademarkStatus .
    gmeow:trademarkStatusRegistered                          a gmeow:TrademarkStatus .
    gmeow:trademarkStatusUnregistered                        a gmeow:TrademarkStatus .
}""" ;
    gmeow:saRationale "The rights status, conflict, logic, license-family, rights-type, and trademark-status vocabularies MUST remain seeded as individuals, preserving the individuals-first value-vocabulary doctrine." .

# --- 22. ODRL constraint operand/operator seeds exist (MUST) -----------------
ex:saConstraintVocabularySeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:leftOpAbsolutePosition                 a gmeow:LeftOperand .
    gmeow:leftOpAbsoluteSize                     a gmeow:LeftOperand .
    gmeow:leftOpAbsoluteSpatialPosition          a gmeow:LeftOperand .
    gmeow:leftOpAbsoluteTemporalPosition         a gmeow:LeftOperand .
    gmeow:leftOpCount                            a gmeow:LeftOperand .
    gmeow:leftOpDateTime                         a gmeow:LeftOperand .
    gmeow:leftOpDelayPeriod                      a gmeow:LeftOperand .
    gmeow:leftOpDeliveryChannel                  a gmeow:LeftOperand .
    gmeow:leftOpDevice                           a gmeow:LeftOperand .
    gmeow:leftOpElapsedTime                      a gmeow:LeftOperand .
    gmeow:leftOpEvent                            a gmeow:LeftOperand .
    gmeow:leftOpFileFormat                       a gmeow:LeftOperand .
    gmeow:leftOpIndustry                         a gmeow:LeftOperand .
    gmeow:leftOpLanguage                         a gmeow:LeftOperand .
    gmeow:leftOpMedia                            a gmeow:LeftOperand .
    gmeow:leftOpMeteredTime                      a gmeow:LeftOperand .
    gmeow:leftOpPayAmount                        a gmeow:LeftOperand .
    gmeow:leftOpPercentage                       a gmeow:LeftOperand .
    gmeow:leftOpProduct                          a gmeow:LeftOperand .
    gmeow:leftOpPurpose                          a gmeow:LeftOperand .
    gmeow:leftOpRecipient                        a gmeow:LeftOperand .
    gmeow:leftOpRelativePosition                 a gmeow:LeftOperand .
    gmeow:leftOpRelativeSize                     a gmeow:LeftOperand .
    gmeow:leftOpRelativeSpatialPosition          a gmeow:LeftOperand .
    gmeow:leftOpRelativeTemporalPosition         a gmeow:LeftOperand .
    gmeow:leftOpResolution                       a gmeow:LeftOperand .
    gmeow:leftOpSpatial                          a gmeow:LeftOperand .
    gmeow:leftOpSpatialCoordinates               a gmeow:LeftOperand .
    gmeow:leftOpSystem                           a gmeow:LeftOperand .
    gmeow:leftOpSystemDevice                     a gmeow:LeftOperand .
    gmeow:leftOpTimeInterval                     a gmeow:LeftOperand .
    gmeow:leftOpUnitOfCount                      a gmeow:LeftOperand .
    gmeow:leftOpVersion                          a gmeow:LeftOperand .
    gmeow:leftOpVirtualLocation                  a gmeow:LeftOperand .
    gmeow:operatorEq                             a gmeow:ConstraintOperator .
    gmeow:operatorGt                             a gmeow:ConstraintOperator .
    gmeow:operatorGteq                           a gmeow:ConstraintOperator .
    gmeow:operatorHasPart                        a gmeow:ConstraintOperator .
    gmeow:operatorIsA                            a gmeow:ConstraintOperator .
    gmeow:operatorIsAllOf                        a gmeow:ConstraintOperator .
    gmeow:operatorIsAnyOf                        a gmeow:ConstraintOperator .
    gmeow:operatorIsNoneOf                       a gmeow:ConstraintOperator .
    gmeow:operatorIsPartOf                       a gmeow:ConstraintOperator .
    gmeow:operatorLt                             a gmeow:ConstraintOperator .
    gmeow:operatorLteq                           a gmeow:ConstraintOperator .
    gmeow:operatorNeq                            a gmeow:ConstraintOperator .
}""" ;
    gmeow:saRationale "The ODRL constraint left-operand and comparison-operator seeds MUST remain individuals in their respective value vocabularies, so constraints stay data-driven instead of subclass-driven." .

# --- 23. Projection-facing rights properties retain their core typing (MUST) -
ex:saProjectionFacingRightsPropertiesTyped a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:acquireLicensePage   a owl:DatatypeProperty ; rdfs:domain gmeow:Entity ; rdfs:range xsd:anyURI .
    gmeow:attributionText      a owl:DatatypeProperty ; rdfs:domain gmeow:Entity ; rdfs:range rdfs:Literal .
    gmeow:attributionUrl       a owl:DatatypeProperty ; rdfs:domain gmeow:Entity ; rdfs:range xsd:anyURI .
    gmeow:conditionsOfAccess   a owl:DatatypeProperty ; rdfs:domain gmeow:Entity ; rdfs:range rdfs:Literal .
    gmeow:copyrightNotice      a owl:DatatypeProperty ; rdfs:domain gmeow:Copyright ; rdfs:range rdfs:Literal .
    gmeow:copyrightYear        a owl:DatatypeProperty ; rdfs:domain gmeow:Copyright ; rdfs:range rdfs:Literal .
    gmeow:isAccessibleForFree  a owl:DatatypeProperty ; rdfs:domain gmeow:Entity ; rdfs:range xsd:boolean .
    gmeow:isOsiApproved        a owl:DatatypeProperty ; rdfs:domain gmeow:License ; rdfs:range xsd:boolean .
    gmeow:licenseText          a owl:DatatypeProperty ; rdfs:domain gmeow:License ; rdfs:range rdfs:Literal .
    gmeow:markText             a owl:DatatypeProperty ; rdfs:domain gmeow:Mark ; rdfs:range rdfs:Literal .
    gmeow:registrationNumber   a owl:DatatypeProperty ; rdfs:domain gmeow:Trademark ; rdfs:range rdfs:Literal .
    gmeow:rightOperand         a owl:DatatypeProperty ; rdfs:domain gmeow:AtomicConstraint ; rdfs:range rdfs:Literal .
    gmeow:spdxLicenseId        a owl:DatatypeProperty ; rdfs:domain gmeow:License ; rdfs:range rdfs:Literal .
    gmeow:spdxLicenseName      a owl:DatatypeProperty ; rdfs:domain gmeow:License ; rdfs:range rdfs:Literal .
    gmeow:usageInfo            a owl:DatatypeProperty ; rdfs:domain gmeow:Entity ; rdfs:range rdfs:Literal .

    gmeow:conflictStrategy       a owl:ObjectProperty ; rdfs:domain gmeow:RightsStatement ; rdfs:range gmeow:ConflictStrategy .
    gmeow:constraintLogic        a owl:ObjectProperty ; rdfs:domain gmeow:LogicalConstraint ; rdfs:range gmeow:ConstraintLogic .
    gmeow:constraintOperator     a owl:ObjectProperty ; rdfs:domain gmeow:AtomicConstraint ; rdfs:range gmeow:ConstraintOperator .
    gmeow:copyrightHolder        a owl:ObjectProperty ; rdfs:domain gmeow:Copyright ; rdfs:range gmeow:Agent .
    gmeow:copyrightStatus        a owl:ObjectProperty ; rdfs:domain gmeow:Copyright ; rdfs:range gmeow:CopyrightStatus .
    gmeow:copyrightWork          a owl:ObjectProperty ; rdfs:domain gmeow:Copyright ; rdfs:range gmeow:InformationObject .
    gmeow:hasCopyright          a owl:ObjectProperty ; rdfs:domain gmeow:Entity ; rdfs:range gmeow:Copyright .
    gmeow:hasDuty               a owl:ObjectProperty ; rdfs:range gmeow:Duty .
    gmeow:hasLicense            a owl:ObjectProperty ; rdfs:domain gmeow:Entity ; rdfs:range gmeow:License .
    gmeow:hasPermission         a owl:ObjectProperty ; rdfs:domain gmeow:RightsStatement ; rdfs:range gmeow:Permission .
    gmeow:hasProhibition        a owl:ObjectProperty ; rdfs:domain gmeow:RightsStatement ; rdfs:range gmeow:Prohibition .
    gmeow:hasRightsStatement    a owl:ObjectProperty ; rdfs:domain gmeow:Entity ; rdfs:range gmeow:RightsStatement .
    gmeow:hasTrademark          a owl:ObjectProperty ; rdfs:domain gmeow:Entity ; rdfs:range gmeow:Trademark .
    gmeow:leftOperand           a owl:ObjectProperty ; rdfs:domain gmeow:AtomicConstraint ; rdfs:range gmeow:LeftOperand .
    gmeow:licenseFamily         a owl:ObjectProperty ; rdfs:domain gmeow:License ; rdfs:range gmeow:LicenseFamily .
    gmeow:licensedWork          a owl:ObjectProperty ; rdfs:domain gmeow:License ; rdfs:range gmeow:InformationObject .
    gmeow:licensee              a owl:ObjectProperty ; rdfs:domain gmeow:License ; rdfs:range gmeow:Agent .
    gmeow:licensor              a owl:ObjectProperty ; rdfs:domain gmeow:License ; rdfs:range gmeow:Agent .
    gmeow:logicConstraintMember a owl:ObjectProperty ; rdfs:domain gmeow:LogicalConstraint ; rdfs:range gmeow:Constraint .
    gmeow:rightOperandReference a owl:ObjectProperty ; rdfs:domain gmeow:AtomicConstraint ; rdfs:range gmeow:Entity .
    gmeow:rightsType            a owl:ObjectProperty ; rdfs:domain gmeow:RightsStatement ; rdfs:range gmeow:RightsType .
    gmeow:ruleAction            a owl:ObjectProperty ; rdfs:domain gmeow:Rule ; rdfs:range gmeow:RightsAction .
    gmeow:ruleAssignee          a owl:ObjectProperty ; rdfs:domain gmeow:Rule ; rdfs:range gmeow:Agent .
    gmeow:ruleConsequence       a owl:ObjectProperty ; rdfs:domain gmeow:Rule ; rdfs:range gmeow:Duty .
    gmeow:ruleConstraint        a owl:ObjectProperty ; rdfs:domain gmeow:Rule ; rdfs:range gmeow:Constraint .
    gmeow:ruleTarget            a owl:ObjectProperty ; rdfs:domain gmeow:Rule ; rdfs:range gmeow:Entity .
    gmeow:statementAbout        a owl:ObjectProperty ; rdfs:domain gmeow:RightsStatement ; rdfs:range gmeow:Entity .
    gmeow:trademarkHolder       a owl:ObjectProperty ; rdfs:domain gmeow:Trademark ; rdfs:range gmeow:Agent .
    gmeow:trademarkMark         a owl:ObjectProperty ; rdfs:domain gmeow:Trademark ; rdfs:range gmeow:Mark .
    gmeow:trademarkStatus       a owl:ObjectProperty ; rdfs:domain gmeow:Trademark ; rdfs:range gmeow:TrademarkStatus .
}""" ;
    gmeow:saRationale "The projection-facing rights property surface MUST retain its datatype/object property typing and its core domain/range anchors, because the CC, DC Terms, ODRL, schema.org, and SPDX projections rely on these contracts." .
