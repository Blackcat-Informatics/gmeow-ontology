    a ontolex:Form ;
    ontolex:writtenRep "non-affinity: the graph has three non-collinear points over a chord"@en .

<http://example.org/lang/glossary-vartrans/form-src/b6ece834fd38f61a>
    a ontolex:Form ;
    ontolex:writtenRep "projection-ceiling commitment — ai / sh"@en .

<http://example.org/lang/glossary-vartrans/form-src/b705bc4ff3d71071>
    a ontolex:Form ;
