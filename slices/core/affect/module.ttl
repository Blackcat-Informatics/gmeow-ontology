# gmeow:AppraisalShape at-most-one restorations: gmeow:appraisalDimension and gmeow:appraisalValue
# are Appraisal-scoped at-most-one facets whose paths are NOT globally owl:FunctionalProperty (a PAD
# triple is three Appraisals sharing a vantage; the magnitude is per-cell), so the sh:maxCount 1
# rides a class-scoped max-qualified antecedent (logic:onClass owl:Thing degrades to the plain
# sh:maxCount 1 the oracle compares; the decimal magnitude rides logic:onDataRange).
gmeow:Appraisal logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:appraisalDimension ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:appraisalValue ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] .

# gmeow:ModelInferenceRunShape — a ModelInferenceRun declares exactly one gmeow:modelIdentifier and
# one pinned gmeow:modelRevision. Both are literal-valued (a repo id, a revision string), so the
# existence axiom ranges over rdfs:Literal (logic:allValuesFrom owl:Thing would reject the literal);
# the closure entries project sh:minCount 1 and the owl:FunctionalProperty contract the sh:maxCount 1.
gmeow:ModelInferenceRun logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:modelIdentifier ; logic:allValuesFrom rdfs:Literal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:modelRevision ; logic:allValuesFrom rdfs:Literal ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelInferenceRun ; logic:closureKey "https://blackcatinformatics.ca/gmeow/modelIdentifier" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelInferenceRun ; logic:closureKey "https://blackcatinformatics.ca/gmeow/modelRevision" ; logic:closureValue logic:ClosedWorldClosure ] .

# gmeow:DerivedAffectIntensityObservationShape — a DerivedAffectIntensityObservation must NOT carry a
# stored gmeow:appraisalValue magnitude (the norm is a recomputable derived view, Principle 12): the
# forbidden-property obligation (sh:maxCount 0) is the reasoner-safe logic:maxQualifiedCardinality 0.
# The gmeow:DerivedAffectIntensityNoStoredMagnitudeConstraint carries the same law in the logic: canon.
gmeow:DerivedAffectIntensityObservation logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:appraisalValue ; logic:maxQualifiedCardinality 0 ; logic:onClass owl:Thing ] .
