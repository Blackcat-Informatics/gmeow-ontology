<https://blackcatinformatics.ca/gmeow/slices/music>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Frame-relative musical content; every notation is a lossy projection.

This module implements the music extension slice: pitch frames (pitch frames),
pitch collections and spelling (pitch collections and spelling), musical time (musical time), the
structure graph (structure graph), performance events & participation (performance events and participation),
and instruments & configurations (instruments and configurations): InstrumentType,
InstrumentConfiguration, InstrumentModification, PlayingTechnique, and the
Cage prepared-piano / drop-D guitar fixtures. Bulk note-level data lives in
GTS music-package bundles, not the reasoned core (Principles 8, 12)."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "GMEOW Music Module"@x-gmeow-english ;
    skos:definition "The GMEOW Music Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Declarative constraint axioms (extension slices) — the closed-
# world cardinality / datatype / fixed-value / class obligations the hand-
# authored shapes.ttl NodeShapes state, authored here once as OWL restriction
# axioms and PROJECTED to generated/shapes/validation-shapes.ttl by
# derive_validation_shapes (Principle 17). Counts use the reasoner-safe QUALIFIED
# form with owl:onClass owl:Thing (the native DL consistency pass decides it, and
# owl:onClass owl:Thing degrades the qualified count to the plain sh:minCount /
# sh:maxCount the hand-authored shapes state): exact-one -> owl:maxQualifiedCardinality 1
# (sh:minCount 1 + sh:maxCount 1); at-most-one -> owl:maxQualifiedCardinality 1;
# at-least N -> owl:minQualifiedCardinality N; sh:datatype D -> owl:allValuesFrom D;
# sh:hasValue V -> owl:hasValue V; sh:class C -> owl:allValuesFrom C.
#
# Carried in the procedural constraint fragment (no ordinary-OWL antecedent):
#   * `sh:nodeKind sh:IRI` value-node-kind facets (owl:Thing lowers to
#     sh:BlankNodeOrIRI, not sh:IRI);
#   * numeric-range facets (sh:minExclusive / sh:minInclusive / sh:maxInclusive)
#     on the rational-encoding integers/decimals;
#   * the rational-string `sh:pattern` facets (pivotSourceValue / pivotTargetValue);
#   * `sh:uniqueLang` + rdf:langString multilingual-text facets;
#   * the `sh:xone` exactly-one-encoding disjunctions and every `sh:sparql`
#     cross-node / no-subclass constraint;
#   * gmeow:participationInstrument (authored at sh:Warning severity — a derived
#     shape emits sh:Violation, so migrating it would change the finding severity).
# =========================================================================== #

gmeow:TuningSystem rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:tuningKind ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:frameRealm ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ; owl:hasValue gmeow:frameRealmMusicalPitch ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:frameKind ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:requiresHost ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:boolean ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:dividedIntervalDenominator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] .

gmeow:PitchValue rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:hasTuningFrame ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:ratioDenominator ; owl:allValuesFrom xsd:integer ] .

gmeow:PitchInterval rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:hasTuningFrame ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:ratioDenominator ; owl:allValuesFrom xsd:integer ] .

gmeow:PitchAnchor rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:pitchAnchorOf ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:anchorDegree ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:anchorFrequency ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:decimal ] .

gmeow:PitchCollection rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:collectionKind ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:derivedFromSpectrum ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:collectionPartOrder ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:nonNegativeInteger ] .

gmeow:PitchCollectionMembership rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:membershipCollection ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:membershipPitch ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:membershipRole ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:membershipDegreeIndex ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] .

gmeow:PitchSpelling rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:spellingPitch ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:spellingSystem ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:spelledName ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:string ] .

gmeow:MusicalTimeFrame rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:frameRealm ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ; owl:hasValue gmeow:frameRealmMusicalTime ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:frameKind ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ; owl:hasValue gmeow:frameKindScalar ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:dimensionCount ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:nonNegativeInteger ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:hasAxis ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:requiresHost ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:boolean ] .

gmeow:MusicalTimeSpan rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:hasMusicalTimeFrame ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:timeStartNumerator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:timeStartDenominator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:timeDurationNumerator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:timeDurationDenominator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] .

gmeow:TimeMapping rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:timeMappingKind ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:mapsFrame ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:mapsToFrame ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:mapRatioDenominator ; owl:allValuesFrom xsd:integer ] .

gmeow:TempoMapSegment rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:tempoMapSegmentOf ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
