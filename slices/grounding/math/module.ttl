# math:isExact must be true, and math:totalMass must be 1 (math:ProbabilityMeasure), are
# VALUE-EQUALITY constraints authored with owl:hasValue: the frontend term model now carries
# the literal datatype, so a typed owl:hasValue true / owl:hasValue 1 derives a typed
# sh:hasValue that equals the typed value on every well-formed individual and rejects the
# counter-example. The absence obligation math:quantityValue maxQualifiedCardinality 0
# (onClass owl:Thing, which also catches the constant-as-decimal counter-example) is
# authored alongside.
math:MathematicalConstant rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:isExact ; owl:minQualifiedCardinality 1 ; owl:onDataRange xsd:boolean ] ,
    [ a owl:Restriction ; owl:onProperty math:isExact ; owl:hasValue true ] ,
    [ a owl:Restriction ; owl:onProperty math:quantityValue ; owl:maxQualifiedCardinality 0 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:ConstantAsDecimalLiteral .

math:SetBuilderExpression rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:memberCondition ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:StringOnlyMemberCondition .

math:Complement rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:complementSemantics ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:ambientSpace ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:complementSemantics ; owl:maxQualifiedCardinality 1 ; owl:onClass math:ComplementSemantics ] ;
    gmeow:enforcesFailureClass math:UnqualifiedComplement .

math:Interval rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:lowerEndpoint ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:upperEndpoint ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:lowerInclusion ; owl:maxQualifiedCardinality 1 ; owl:onClass math:EndpointInclusion ] ,
    [ a owl:Restriction ; owl:onProperty math:upperInclusion ; owl:maxQualifiedCardinality 1 ; owl:onClass math:EndpointInclusion ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedInterval .

math:Function rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:domain ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:codomain ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:domain ; owl:allValuesFrom math:Set ] ,
    [ a owl:Restriction ; owl:onProperty math:codomain ; owl:allValuesFrom math:Set ] ,
    [ a owl:Restriction ; owl:onProperty math:domain ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:codomain ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:domain ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Set ] ,
    [ a owl:Restriction ; owl:onProperty math:codomain ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Set ] ;
    gmeow:enforcesFailureClass math:UnframedFunction .

# A math:ClosedFormFunction requires exactly one body AST (math:definingExpression)
# and exactly one formal argument (math:formalArgument); math:functionParameter is
# unconstrained (0..n). It inherits the domain/codomain exact-one obligations above
# through math:Function. The max-qualified halves pair with the N-Triples
# min-qualified siblings in the appendix below (exact-one; missing → math:UnboundClosedForm).
math:ClosedFormFunction rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:definingExpression ; owl:maxQualifiedCardinality 1 ; owl:onClass math:MathematicalExpression ] ,
    [ a owl:Restriction ; owl:onProperty math:formalArgument ; owl:maxQualifiedCardinality 1 ; owl:onClass math:VariableDeclaration ] ;
    gmeow:enforcesFailureClass math:UnboundClosedForm .

# A math:ArithmeticOperation carries a signature over number systems: exactly one
# math:operatorDomain and exactly one math:operatorCodomain, each a math:NumberSystem.
# The restriction targets the CLASS, so EVERY math:ArithmeticOperation individual
# (math:Addition … math:Logarithm and math:Negation) must be framed; an unframed
# operator is math:UnframedOperator. The min-qualified siblings are in the appendix below.
math:ArithmeticOperation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:operatorDomain ; owl:maxQualifiedCardinality 1 ; owl:onClass math:NumberSystem ] ,
    [ a owl:Restriction ; owl:onProperty math:operatorCodomain ; owl:maxQualifiedCardinality 1 ; owl:onClass math:NumberSystem ] ;
    gmeow:enforcesFailureClass math:UnframedOperator .

math:AlgebraicStructure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:underlyingSet ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:underlyingSet ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Set ] ,
    [ a owl:Restriction ; owl:onProperty math:structureOperation ; owl:minQualifiedCardinality 1 ; owl:onClass math:Operation ] ,
    [ a owl:Restriction ; owl:onProperty math:satisfiesAxiom ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:IncompleteAlgebraicStructure .

math:Homomorphism rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:preservedOperation ; owl:minQualifiedCardinality 1 ; owl:onClass math:Operation ] ,
    [ a owl:Restriction ; owl:onProperty math:preservationLaw ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedHomomorphism .

math:LieGroup rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:hasRootSystem ; owl:minQualifiedCardinality 1 ; owl:onClass math:RootSystem ] ;
    gmeow:enforcesFailureClass math:IncompleteLieStructure .

math:RootSystem rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:cartanMatrix ; owl:minQualifiedCardinality 1 ; owl:onClass math:CartanMatrix ] ,
    [ a owl:Restriction ; owl:onProperty math:weylGroup ; owl:minQualifiedCardinality 1 ; owl:onClass math:WeylGroup ] ,
    [ a owl:Restriction ; owl:onProperty math:rootSystemRank ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:IncompleteLieStructure .

math:AutomorphismGroup rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:automorphismGroupOf ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:UnanchoredAutomorphismGroup .

math:HomomorphicEncryptionScheme rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:homomorphicOver ; owl:minQualifiedCardinality 1 ; owl:onClass math:Operation ] ,
    [ a owl:Restriction ; owl:onProperty math:securityAssumption ; owl:minQualifiedCardinality 1 ; owl:onClass math:LatticeHardnessAssumption ] ,
    [ a owl:Restriction ; owl:onProperty math:noiseModel ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedEncryptionScheme .

math:Ring rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:satisfiesDistributivity ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:NonDistributiveRing .

math:Measure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:measureOn ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:measureOn ; owl:maxQualifiedCardinality 1 ; owl:onClass math:MeasurableSpace ] ,
    [ a owl:Restriction ; owl:onProperty math:totalMass ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:IncompleteMeasure .

math:MeasureEvaluation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:evaluatedMeasure ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Measure ] ,
    [ a owl:Restriction ; owl:onProperty math:measuredSubset ; owl:maxQualifiedCardinality 1 ; owl:onClass math:MeasurableSet ] ,
    [ a owl:Restriction ; owl:onProperty math:measureResult ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedMeasureEvaluation .

# A probability measure is exactly a measure of total mass one — a typed value-equality
# obligation on the inherited math:totalMass, derived to sh:hasValue 1.
math:ProbabilityMeasure rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:totalMass ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:totalMass ; owl:hasValue 1 ] ;
    gmeow:enforcesFailureClass math:ProbabilityMeasureMassViolation .

math:Integral rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:withRespectTo ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:withRespectTo ; owl:allValuesFrom math:Measure ] ,
    [ a owl:Restriction ; owl:onProperty math:integrand ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:withRespectTo ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:integrand ; owl:maxQualifiedCardinality 1 ; owl:onClass math:MeasurableFunction ] ,
    [ a owl:Restriction ; owl:onProperty math:integrationDomain ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:withRespectTo ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Measure ] ;
    gmeow:enforcesFailureClass math:IncompleteIntegral .

math:Quantity rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:hasDimension ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:hasDimension ; owl:allValuesFrom math:Dimension ] ,
    [ a owl:Restriction ; owl:onProperty math:hasDimension ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:hasDimension ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Dimension ] ;
    gmeow:enforcesFailureClass math:UndimensionedQuantity .

math:DerivedDimension rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:baseDimensionExponent ; owl:minQualifiedCardinality 1 ; owl:onClass math:DimensionExponent ] ;
    gmeow:enforcesFailureClass math:MalformedDimension .

math:DimensionExponent rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:exponentOfDimension ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:exponentOfDimension ; owl:maxQualifiedCardinality 1 ; owl:onClass math:BaseDimension ] ,
    [ a owl:Restriction ; owl:onProperty math:exponentNumerator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty math:exponentDenominator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ;
    gmeow:enforcesFailureClass math:MalformedDimension .

math:DimensionalExpression rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:homogeneousOperand ; owl:minQualifiedCardinality 2 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:MalformedDimension .

math:ArgumentSlot rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:slotIndex ; owl:allValuesFrom xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty math:slotIndex ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty math:slotExpression ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:MalformedArgumentSlot .

math:SymbolReference logic:subClassOf
    [ a logic:Restriction ; logic:onProperty math:hasMathematicalSymbol ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty math:hasMathematicalSymbol ; logic:allValuesFrom math:MathematicalSymbol ] ,
    [ a logic:Restriction ; logic:onProperty math:hasMathematicalSymbol ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty math:hasMathematicalSymbol ; logic:maxQualifiedCardinality 1 ; logic:onClass math:MathematicalSymbol ] ;
    gmeow:enforcesFailureClass math:UnresolvedSymbolReference .

math:FreeVariableDeclaration logic:subClassOf
    [ a logic:Restriction ; logic:onProperty math:variableDomain ; logic:minQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty math:variableDomain ; logic:allValuesFrom math:Set ] ,
    [ a logic:Restriction ; logic:onProperty math:variableDomain ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] ,
    [ a logic:Restriction ; logic:onProperty math:variableDomain ; logic:maxQualifiedCardinality 1 ; logic:onClass math:Set ] ;
    gmeow:enforcesFailureClass math:UntypedFreeVariable .

# math:structuralKey is declared functional (single-valued WHEN ASSERTED — it stays
# OPTIONAL, since not every math:MathematicalExpression declares one) in prose; the
# class-scoped max-qualified form below is the reasoner-safe way to say so — never a
# global owl:FunctionalProperty claim, which the math: profile forbids (see
# math:FiltrationStage's restriction further down in this file for the same idiom over
# a bare owl:Thing range). The sibling logic:allValuesFrom restriction on
# math:structuralKey carries the xsd:string datatype constraint the native reasoned
# gate's exactly-one-singleton-literal check (crates/logic/src/math_expression.rs,
# classify_structural_key_usage / math:MalformedStructuralKey) enforces procedurally —
# without it the derived shape carries an sh:maxCount with no sh:datatype at all,
# exactly the same "no flat relational join" reasoning that idiom's own
# math:manifoldDimension sibling further down in this file already follows.
math:MathematicalExpression logic:subClassOf
    [ a logic:Restriction ; logic:onProperty math:structuralKey ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty math:structuralKey ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:string ] .

# math:alphaEquivalenceClass carries the SAME single-valued discipline its own definition
# promises ("Single-valued, exactly as math:structuralKey is"), stated here rather than left to
# prose. It is deliberately NOT mandatory: the edge is materialized by the expression-identity
# reasoned gate for every root that LOWERS CLEANLY, and a root the grammar refutes gets none —
# a structural identity cannot be claimed for an expression that is not well formed, which is
# the same reason math:StructuralKeyOnRejectedExpression exists. So max-1, never min-1.
math:MathematicalExpression logic:subClassOf
    [ a logic:Restriction ; logic:onProperty math:alphaEquivalenceClass ; logic:allValuesFrom math:AlphaEquivalenceClass ] ,
    [ a logic:Restriction ; logic:onProperty math:alphaEquivalenceClass ; logic:maxQualifiedCardinality 1 ; logic:onClass math:AlphaEquivalenceClass ] .

# math:normalizationStrength, unlike math:structuralKey, is declared MANDATORY as well
# as functional: every math:NormalizationDeclaration names exactly one strength — a
# strength-less declaration is a bare, unattributed edge, exactly the vacuous-contract
# gap this restriction closes (see the note on math:UndeclaredNormalFormConstraint
# below). The gmeow:enforcesFailureClass binding names the class-scoped failure the
# DERIVED shape raises for EITHER half of the exact-one pair (the min half is the one
# reachable in practice — a declaration cannot easily acquire two strengths without
# first acquiring one — but the binding is class-scoped, exactly like
# math:DimensionExponent's four restrictions sharing one math:MalformedDimension): a
# strength-less declaration is math:UndeclaredNormalizationStrength, never a bare,
# anonymous cardinality violation.
#
# The cardinality is deliberately UNQUALIFIED, and that is the whole point.
#
# Qualifying it on math:NormalizationStrength makes the count depend on the VALUE'S TYPE, and
# the four strength individuals are typed in this bundle, not in a consumer's graph. A qualified
# count therefore sees zero conforming values in any graph that merely CITES them — so a
# consumer who authors a normalization declaration exactly as this vocabulary specifies is told
# by this ontology's own validator to repair data that is already correct — including this
# slice's own shipped reference example, which cites the rungs without re-typing them.
#
# An unqualified min/max-1 asks only what is actually required — that exactly one strength be
# named — and needs no type lookup, so it decides identically in the bundle and in a consumer's
# graph. The value-set constraint below carries the "which four" half by IRI, again without
# consulting a type, so the closed vocabulary is still closed.
math:NormalizationDeclaration logic:subClassOf
    [ a logic:Restriction ; logic:onProperty math:normalizationStrength ; logic:maxCardinality 1 ] ,
    [ a logic:Restriction ; logic:onProperty math:normalizationStrength ; logic:minCardinality 1 ] ;
    gmeow:enforcesFailureClass math:UndeclaredNormalizationStrength .

# "Which four" is decided by IRI, never by the value's TYPE.
#
# logic:allValuesFrom here derived a bare sh:class, and sh:class asks what the VALUE is typed as.
# The four rungs are typed in this bundle and not in a consumer's file, so any graph that merely
# CITES a rung was told its correct data was wrong — the unqualified cardinality above fixes the
# COUNT half of that, but a class-valued restriction reintroduces the same dependence, so it is
# gone. A value-set names the admissible IRIs outright: it closes the vocabulary exactly as
# tightly, and decides identically in the bundle and in a consumer's graph because there is
# nothing to look up.
math:NormalizationStrengthValueConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "normalization strength is one of the four rungs"@x-gmeow-english ;
    skos:definition "A math:NormalizationDeclaration's math:normalizationStrength names one of the four closed math:NormalizationStrength rungs, tested by IRI membership rather than by the value's asserted type so the obligation decides the same way in the shipped bundle and in a consumer's own graph."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes math:normalizationStrength ;
    logic:message "A math:NormalizationDeclaration's math:normalizationStrength must be one of math:structuralNormalization, math:commutativeNormalization, math:algebraicNormalization, or math:semanticNormalization (math:UndeclaredNormalizationStrength)." ;
    logic:severity "Violation" ;
    logic:integrity math:nsvForall ;
    gmeow:enforcesFailureClass math:UndeclaredNormalizationStrength .
math:nsvForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ,
                             [ logic:termIndex 1 ; logic:termVariable "strength" ] ;
    logic:forall math:nsvImpl .
math:nsvImpl a logic:Formula ; logic:antecedent math:nsvGuard ; logic:consequent math:nsvIn .
math:nsvGuard a logic:Formula ; logic:relation math:normalizationStrength ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "strength" ] .
math:nsvIn a logic:Formula ; logic:relation logic:termIn ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "strength" ] ,
                   [ logic:termIndex 1 ; logic:termIri math:structuralNormalization ] ,
                   [ logic:termIndex 2 ; logic:termIri math:commutativeNormalization ] ,
                   [ logic:termIndex 3 ; logic:termIri math:algebraicNormalization ] ,
                   [ logic:termIndex 4 ; logic:termIri math:semanticNormalization ] .

math:ApplicationExpression rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:operator ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:ApplicationOperatorCardinality .

math:BindingExpression rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:boundVariable ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:argumentSlot ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:MalformedBindingExpression .

math:VariableOccurrence rdfs:subClassOf
