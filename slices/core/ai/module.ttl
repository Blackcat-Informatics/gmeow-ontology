    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:usedModel, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:usedModel and nothing else. It is not a definition of gmeow:usedModel (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:usedModelFunctionality logic:characterizes gmeow:usedModel ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:againstIndexFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "againstIndex is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:againstIndex is functional: a retrieval event queries exactly one vector index, because federated retrieval is decomposed into several RetrievalEvents under one parent activity rather than one event fired against many indices."@x-gmeow-english ;
    logic:characterizes gmeow:againstIndex ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:againstIndex ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:againstIndex names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:againstIndex, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:againstIndex and nothing else. It is not a definition of gmeow:againstIndex (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:againstIndexFunctionality logic:characterizes gmeow:againstIndex ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:distanceMetricFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "distanceMetric is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:distanceMetric is functional: an embedding or index is meaningful under exactly one similarity/distance function, because cosine and euclidean disagree about what counts as 'near', so a carrier commits to a single metric rather than blending incomparable notions of nearness."@x-gmeow-english ;
    logic:characterizes gmeow:distanceMetric ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:distanceMetric ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:distanceMetric names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:distanceMetric, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:distanceMetric and nothing else. It is not a definition of gmeow:distanceMetric (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:distanceMetricFunctionality logic:characterizes gmeow:distanceMetric ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:embeddingModelFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "embeddingModel is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:embeddingModel is functional: an embedding is produced by exactly one model agent, since two models' embeddings of the same chunk are two distinct Embedding individuals rather than one embedding crediting two models (P9 attribution)."@x-gmeow-english ;
    logic:characterizes gmeow:embeddingModel ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:embeddingModel ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:embeddingModel names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:embeddingModel, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:embeddingModel and nothing else. It is not a definition of gmeow:embeddingModel (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:embeddingModelFunctionality logic:characterizes gmeow:embeddingModel ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:embeddingOfFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "embeddingOf is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:embeddingOf is functional: an embedding represents exactly one information object under one model, so a single vector is never made to stand for two different objects."@x-gmeow-english ;
    logic:characterizes gmeow:embeddingOf ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:embeddingOf ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:embeddingOf names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:embeddingOf, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:embeddingOf and nothing else. It is not a definition of gmeow:embeddingOf (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:embeddingOfFunctionality logic:characterizes gmeow:embeddingOf ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:externalRedactionCount
    a logic:DatatypeProperty ; logic:domain gmeow:ModelInvocation ; logic:range xsd:nonNegativeInteger ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "external redaction count"@x-gmeow-english ;
    skos:definition "The number of answer items reported redacted for a model invocation."@x-gmeow-english ;
    skos:example "ex:call gmeow:externalRedactionCount \"0\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    skos:scopeNote "A count of items, not characters or hidden content; explicit zero differs from missing information."@x-gmeow-english ;
    gmeow:avoidWhen "Do not replace the original prompt, requested alias, actual model and attributed answer with one unstructured invocation string."@x-gmeow-english ;
    gmeow:howToUse "Keep hasPrompt, usedModel and the output’s wasGeneratedBy/wasAttributedTo provenance; reach answer content through observationResult."@x-gmeow-english ;
    gmeow:useWhen "Use when preserving what was asked and answered without treating generated words as established facts."@x-gmeow-english .

gmeow:promptText
    a logic:DatatypeProperty ; logic:domain gmeow:Prompt ; logic:range rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "prompt text"@x-gmeow-english ;
    skos:definition "The original words of a concrete prompt presented to a model."@x-gmeow-english ;
    skos:example "ex:question gmeow:promptText \"What did you observe?\"@en ."@x-gmeow-english ;
    skos:scopeNote "Retain language and direction where supplied; a text rendering does not replace the exact-byte content digest."@x-gmeow-english ;
    gmeow:avoidWhen "Do not replace the original prompt, requested alias, actual model and attributed answer with one unstructured invocation string."@x-gmeow-english ;
    gmeow:howToUse "Keep hasPrompt, usedModel and the output’s wasGeneratedBy/wasAttributedTo provenance; reach answer content through observationResult."@x-gmeow-english ;
    gmeow:useWhen "Use when preserving what was asked and answered without treating generated words as established facts."@x-gmeow-english .

gmeow:modelAlias
    a logic:DatatypeProperty ; logic:domain gmeow:ModelInvocation ; logic:range xsd:token ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "requested model alias"@x-gmeow-english ;
    skos:definition "The provider model name or alias requested for a model invocation before resolution to the actual model."@x-gmeow-english ;
    skos:example "ex:call gmeow:modelAlias \"provider/latest\"^^xsd:token ."@x-gmeow-english ;
    skos:scopeNote "The requested token is provenance; usedModel still names the actual model agent."@x-gmeow-english ;
    gmeow:avoidWhen "Do not replace the original prompt, requested alias, actual model and attributed answer with one unstructured invocation string."@x-gmeow-english ;
    gmeow:howToUse "Keep hasPrompt, usedModel and the output’s wasGeneratedBy/wasAttributedTo provenance; reach answer content through observationResult."@x-gmeow-english ;
    gmeow:useWhen "Use when preserving what was asked and answered without treating generated words as established facts."@x-gmeow-english .

gmeow:answerText
    a logic:DatatypeProperty ; logic:domain gmeow:InformationObject ; logic:range rdfs:Literal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "answer text"@x-gmeow-english ;
    skos:definition "The original words of an answer retained as an information object."@x-gmeow-english ;
    skos:example "ex:answer gmeow:answerText \"I could not verify it.\"@en ."@x-gmeow-english ;
    skos:scopeNote "Text is attributed content, not an asserted triple or proof of what it says; preserve language and direction."@x-gmeow-english ;
    gmeow:avoidWhen "Do not replace the original prompt, requested alias, actual model and attributed answer with one unstructured invocation string."@x-gmeow-english ;
    gmeow:howToUse "Keep hasPrompt, usedModel and the output’s wasGeneratedBy/wasAttributedTo provenance; reach answer content through observationResult."@x-gmeow-english ;
    gmeow:useWhen "Use when preserving what was asked and answered without treating generated words as established facts."@x-gmeow-english .

# Natural-language values retain language and direction; plain text declares no language.
gmeow:ModelCard logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:modelProvider ; logic:allValuesFrom [ logic:unionOf ( xsd:string rdf:langString rdf:dirLangString ) ] ] .

# General classifier evidence: exact external labels, execution records and score meaning.

gmeow:ClassifierLabel
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Classifier Label"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The exact external label identity in a classifier label set. This information artifact is distinct from a canonical category; identical words in different registries or run-scoped candidate sets do not identify the same label."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ClassifierOutput
    a logic:SubKind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Classifier Output"@x-gmeow-english ;
    logic:subClassOf gmeow:Observation ;
    skos:definition "One attributed classifier result for one target and exact emitted label, retaining its raw decimal score, declared score semantics and producing ModelInferenceRun record. Model evidence does not entail membership in a canonical domain category."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ClassifierLabelSet
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Classifier Label Set"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "An identified external label vocabulary, either a static registry or a run-scoped zero-shot candidate set. Members are ClassifierLabel artifacts, not canonical domain categories. Static registries used by the affect producer require a reviewed decision rule; run-scoped candidate sets may legitimately lack one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ModelInferenceRun
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Model Inference Run"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The enduring provenance record of one classifier execution, not the execution activity. It pins the model identifier and exact revision and captures task, framework, tokenizer and label-set revisions, inputs and hypothesis template. It may serve as an Observation vantage. A real generating Activity is distinct and may generate the record through wasGeneratedBy; producedBy points to the record."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ScoreSemantics
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Score Semantics"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "An open vocabulary declaring the interpretation of a raw classifier score. Calibration and probability do not by themselves establish epistemic confidence or provenance-derived evidence strength; each requires a separately justified mapping."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:LabelSetDecisionRule
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Label Set Decision Rule"@x-gmeow-english ;
    logic:subClassOf logic:QualityValue ;
    skos:definition "An open vocabulary of declared score-to-decision policies over a label set. Argmax and independent thresholding are distinct policies, coupled to compatible score semantics through impliesLabelSetDecision."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:classifiedTarget
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "classified target"@x-gmeow-english ;
    logic:domain gmeow:ClassifierOutput ;
    logic:subPropertyOf gmeow:observedFeature ;
    skos:definition "The target classified by this output, bridged to observedFeature. The target may be a document, span, media segment or other feature of interest."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:classifierScore
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "classifier score"@x-gmeow-english ;
    logic:domain gmeow:ClassifierOutput ;
    logic:range xsd:decimal ;
    skos:definition "The exact raw decimal score emitted for this label, interpreted only under scoreSemantics. No universal unit interval, probability, confidence or evidential-warrant interpretation is inferred."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:emittedLabel
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "emitted label"@x-gmeow-english ;
    logic:domain gmeow:ClassifierOutput ;
    logic:range gmeow:ClassifierLabel ;
    skos:definition "The exact ClassifierLabel artifact emitted by this output. Identity and label-set membership survive any reviewed mapping to a canonical category."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:labelSetRevision
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "label-set revision"@x-gmeow-english ;
    logic:domain gmeow:ModelInferenceRun ;
    logic:range xsd:string ;
    skos:definition "The pinned label-set revision of this execution record. For zero-shot inference it identifies the exact candidate inventory as part of run identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hypothesisTemplate
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "hypothesis template"@x-gmeow-english ;
    logic:domain gmeow:ModelInferenceRun ;
    logic:range xsd:string ;
    logic:subPropertyOf lang:literalValue ;
    skos:definition "The exact natural-language template instantiated with each zero-shot candidate label. The literal carrier preserves the template itself; changing it changes the execution context."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:memberOfLabelSet
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "member of label set"@x-gmeow-english ;
    logic:domain gmeow:ClassifierLabel ;
    logic:range gmeow:ClassifierLabelSet ;
    skos:definition "Registers an exact label identity in its ClassifierLabelSet. Membership also applies to run-scoped candidates and does not imply a static registry or reviewed decision rule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:modelFramework
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "model framework"@x-gmeow-english ;
    logic:domain gmeow:ModelInferenceRun ;
    logic:range xsd:string ;
    skos:definition "The execution framework captured in the run record, such as transformers or onnxruntime."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:modelIdentifier
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "model identifier"@x-gmeow-english ;
    logic:domain gmeow:ModelInferenceRun ;
    logic:range xsd:string ;
    skos:definition "The exact model repository or artifact identifier pinned by the execution record, paired with modelRevision."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:modelRevision
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "model revision"@x-gmeow-english ;
    logic:domain gmeow:ModelInferenceRun ;
    logic:range xsd:string ;
    skos:definition "The exact immutable model revision used for this execution. A mutable model name alone cannot satisfy the pinned revision requirement."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:modelTask
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "model task"@x-gmeow-english ;
    logic:domain gmeow:ModelInferenceRun ;
    logic:range xsd:string ;
    skos:definition "The model task text captured in the execution record, such as text-classification or zero-shot-classification. Required hypothesis provenance follows declared entailment score semantics, not the spelling of this task text."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:producedBy
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "produced by"@x-gmeow-english ;
    logic:domain gmeow:ClassifierOutput ;
    logic:range gmeow:ModelInferenceRun ;
    skos:definition "The single ModelInferenceRun record attributing this output. It points to an enduring record, not an Activity; it is not a wasGeneratedBy specialization."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:scoreCalibration
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "score calibration"@x-gmeow-english ;
    logic:domain gmeow:ClassifierOutput ;
    logic:range xsd:string ;
    skos:definition "The declared calibration profile of a score, required for calibrated-probability semantics. Calibration alone never turns probability into epistemic confidence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:scoreSemantics
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "score semantics"@x-gmeow-english ;
    logic:domain gmeow:ClassifierOutput ;
    logic:range gmeow:ScoreSemantics ;
    skos:definition "The single declared interpretation of classifierScore from the open ScoreSemantics vocabulary. A bare uninterpreted number is incomplete evidence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:thresholdApplied
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "threshold applied"@x-gmeow-english ;
    logic:domain gmeow:ClassifierOutput ;
    logic:range xsd:decimal ;
    skos:definition "The threshold actually applied to this output label. No universal threshold or requirement to threshold every classifier is implied."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:tokenizerRevision
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "tokenizer revision"@x-gmeow-english ;
    logic:domain gmeow:ModelInferenceRun ;
    logic:range xsd:string ;
    skos:definition "The exact tokenizer revision captured in this execution record; changing it may change scores independently of the model revision."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:usedInput
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "used input"@x-gmeow-english ;
    logic:domain gmeow:ModelInferenceRun ;
    skos:definition "An input recorded as consumed by the classifier execution. The subject is the execution record, not an Activity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:labelSetDecision
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "label set decision"@x-gmeow-english ;
    logic:domain gmeow:ClassifierLabelSet ;
    logic:range gmeow:LabelSetDecisionRule ;
    skos:definition "The declared decision policy of a label set. Static registries used by the affect producer require one; run-scoped zero-shot candidates need not carry one. Where supplied it must agree with score semantics."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:impliesLabelSetDecision
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "implies label set decision"@x-gmeow-english ;
    logic:domain gmeow:ScoreSemantics ;
    logic:range gmeow:LabelSetDecisionRule ;
    skos:definition "The compatibility commitment from score semantics to decision policy: softmax to argmax, sigmoid to independent thresholding. Logit, margin and per-hypothesis entailment carry none."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:runLabelSet
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "run label set"@x-gmeow-english ;
    logic:domain gmeow:ModelInferenceRun ;
    logic:range gmeow:ClassifierLabelSet ;
    skos:definition "An explicit label set used by this execution record. When supplied, its outputs must emit labels belonging to that set. Existing records may capture membership through emitted labels and labelSetRevision instead. This edge implies no static decision rule."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:scoreCalibratedProbability
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "calibrated probability"@x-gmeow-english ;
    skos:definition "A model probability under a declared calibration profile. Calibration alone authorizes neither epistemic confidence nor provenance-derived evidence strength."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreLogit
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "logit"@x-gmeow-english ;
    skos:definition "A raw pre-activation logit, potentially outside the unit interval and not a probability."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreMargin
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "margin"@x-gmeow-english ;
    skos:definition "A decision margin, such as a signed classifier distance, not a probability."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreSigmoid
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "sigmoid score"@x-gmeow-english ;
    gmeow:impliesLabelSetDecision gmeow:decisionIndependentThreshold ;
    skos:definition "A per-label sigmoid score in the unit interval. Independent-label interpretation is distinct from calibration, confidence and evidential warrant."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreSoftmax
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "softmax probability"@x-gmeow-english ;
    gmeow:impliesLabelSetDecision gmeow:decisionArgmax ;
    skos:definition "A model probability normalized over the declared mutually exclusive label set. This simplex interpretation establishes neither calibration nor confidence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreEntailment
    a gmeow:ScoreSemantics ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "entailment probability"@x-gmeow-english ;
    skos:definition "A per-hypothesis entailment-versus-contradiction model probability for a zero-shot candidate and template. It is not normalized across candidates and does not establish calibration or confidence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:decisionArgmax
    a gmeow:LabelSetDecisionRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "argmax (single-label)"@x-gmeow-english ;
    skos:definition "A single-label decision policy selecting an argmax over the label set. It does not discard other emitted scores or entail a canonical category claim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:decisionIndependentThreshold
    a gmeow:LabelSetDecisionRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "independent threshold (multi-label)"@x-gmeow-english ;
    skos:definition "A per-label threshold policy admitting zero, one or several labels. Applied thresholds remain explicit output provenance."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# Shared integrity and property-characteristic carriers retain a single owner.
gmeow:ModelInferenceRunIdentifierPresentConstraint
    a logic:Constraint ;
