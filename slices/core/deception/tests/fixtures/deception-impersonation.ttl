#
# ABox fixture for the deception-impersonation competency question (gmeow:cqDataFile overlay).
# Verbatim externalization of test_competency_deception_impersonation_query:
# impersonation = held refuted + projected unequivocal + an identity facet whose
# subject differs from the deceiver.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix exd:   <https://example.org/test/> .

exd:event1 a gmeow:Event ;
    gmeow:eventType gmeow:eventTypeImpersonation ;
    gmeow:heldStandpoint exd:claimA ;
    gmeow:projectedStandpoint exd:claimB .

exd:claimA a gmeow:StandpointClaim ;
    gmeow:claimModality gmeow:refuted .

exd:claimB a gmeow:StandpointClaim ;
    gmeow:claimModality gmeow:unequivocal .

exd:facet1 a gmeow:IdentityFacet ;
    gmeow:observedFeature exd:event1 ;
    gmeow:facetSubject exd:victim .
