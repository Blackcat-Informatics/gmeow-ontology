ex:saRoleSpinDoctorExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:roleSpinDoctor a gmeow:ParticipantRole . }""" ;
    gmeow:saRationale "gmeow:roleSpinDoctor MUST exist as a gmeow:ParticipantRole individual -- the distortion-specific role for the participant who reframes information." .

# --- 26. MaximViolationType is a logic:AbstractIndividualType value vocabulary
#        subclassing logic:QualityValue (MUST) -----------------------------------
ex:saMaximViolationTypeClass a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:MaximViolationType a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:MaximViolationType MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- the four Gricean maxim violations are an open value vocabulary of individuals, not subclasses." .

# --- 27. The four Gricean maxim violation seed individuals exist (MUST) -------
ex:saMaximViolationSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:maximViolationQuality   a gmeow:MaximViolationType .
    gmeow:maximViolationQuantity  a gmeow:MaximViolationType .
    gmeow:maximViolationRelation  a gmeow:MaximViolationType .
    gmeow:maximViolationManner    a gmeow:MaximViolationType .
}""" ;
    gmeow:saRationale "All four Gricean maxim violation seeds (quality, quantity, relation, manner) MUST exist as gmeow:MaximViolationType individuals -- they cover the full set of conversational maxims a deceptive event may breach." .

