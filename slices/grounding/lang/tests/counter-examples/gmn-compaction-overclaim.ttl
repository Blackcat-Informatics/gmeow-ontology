# Counter-example: a gmeow:GmnCompaction whose correspondence claims
# logic:ExactPreservation (and a mnemomorphic witness) — stronger than the
# logic:ValidationOnly the compaction discipline licenses; compaction is get-leg-only, so
# the claim asserts a round-trip its own crossing denies (fires lang:GmnCompactionOverclaim
# via the sh:sparql of lang:GmnCompactionOverclaimShape). The compaction is otherwise
# fully provenance-linked (gmeow:gmnCompacts + gmeow:vantage), so
# lang:GmnCompactionProvenanceShape stays quiet: exactly the one overclaim finding fires.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

ex:sensorTeam a gmeow:Agent .
ex:summarizerStandpoint a gmeow:Agent .

ex:claimDoorOpenMonday a gmeow:StandpointClaim ;
    gmeow:vantage ex:sensorTeam .

ex:claimDoorOpenTuesday a gmeow:StandpointClaim ;
    gmeow:vantage ex:sensorTeam .

# The overclaiming correspondence: exactness and recoverability on a lossy compaction.
ex:corrCompactionOverclaim a logic:Correspondence ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Equiv ;
    logic:morphismClass logic:Isomorphism ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true .

ex:compactionOverclaim a gmeow:GmnCompaction ;
    gmeow:gmnCompacts ex:claimDoorOpenMonday , ex:claimDoorOpenTuesday ;
    gmeow:vantage ex:summarizerStandpoint ;
    lang:translationCorrespondence ex:corrCompactionOverclaim .
