      <termEntry id="c-809cf1335ca017be">
        <langSet xml:lang="en">
          <tig>
            <term>Type II Error Rate</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Taux d'erreur de type II</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
