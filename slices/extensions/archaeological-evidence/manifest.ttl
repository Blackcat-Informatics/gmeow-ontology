<https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence>
    a gmeow:Slice ;
    rdfs:label "archaeological-evidence"@x-gmeow-english ;
    skos:definition "The archaeological-evidence slice of the GMEOW ontology (extension tier): GMEOW Archaeological Evidence Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/archaeological-evidence> ;
    dcterms:title "GMEOW Archaeological Evidence Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierExtension ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/events> ,
        <https://blackcatinformatics.ca/gmeow/slices/language> ,
