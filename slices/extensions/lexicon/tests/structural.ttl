#
# Declarative structural assertions for the lexicon slice (#171) — the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_lexicon.py. Each assertion runs as a
# SPARQL ASK over the lexicon module graph (gmeow:scopeModule) under the
# native Rust harness (crates/slicetest).
#
# Lexicon is NOT yet #694-migrated, so class stereotypes remain gufo:
# (gufo:Kind, gufo:SubKind, gufo:AbstractIndividualType, gufo:QualityValue),
# not logic:.
#
# All subjects tested below are defined in slices/extensions/lexicon/module.ttl;
# no cross-slice subjects are tested here.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest→DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/lexicon/tests/> .

# --- 1. LexicalItem is a subclass of InformationObject (MUST) -----------------
ex:saLexicalItemIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:LexicalItem rdfs:subClassOf gmeow:InformationObject . }""" ;
    gmeow:saRationale "gmeow:LexicalItem MUST be a subclass of gmeow:InformationObject — the abstract lexeme is a first-class information object (#171). Mirrors test_lexical_item_is_information_object." .

# --- 2. LexicalForm is a subclass of InformationObject (MUST) -----------------
ex:saLexicalFormIsInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:LexicalForm rdfs:subClassOf gmeow:InformationObject . }""" ;
    gmeow:saRationale "gmeow:LexicalForm MUST be a subclass of gmeow:InformationObject — a concrete lexical form is a first-class information object (#171). Mirrors test_lexical_form_is_information_object." .

# --- 3a. hasLexicalForm is an ObjectProperty (MUST) ---------------------------
ex:saHasLexicalFormIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasLexicalForm a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:hasLexicalForm MUST be an owl:ObjectProperty — it links LexicalItem to its concrete LexicalForm instances (#171). Mirrors test_has_lexical_form_is_non_functional (positive half)." .

# --- 3b. hasLexicalForm is NOT functional (MUST-NOT) -------------------------
ex:saHasLexicalFormNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasLexicalForm a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:hasLexicalForm MUST NOT be functional — a single lexical item may have many coexisting forms (written, spoken, reconstructed, etc.) (Principle 9, #171). Mirrors test_has_lexical_form_is_non_functional (negative half)." .

# --- 4. lexicalItemLanguage is functional (MUST) ------------------------------
ex:saLexicalItemLanguageFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:lexicalItemLanguage a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:lexicalItemLanguage MUST be an owl:FunctionalProperty — one primary language per lexical item; polyglot items are separate items linked by derivation or translation (#171). Mirrors test_lexical_item_language_is_functional." .

# --- 5. formRepresentation is functional (MUST) -------------------------------
ex:saFormRepresentationFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:formRepresentation a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:formRepresentation MUST be an owl:FunctionalProperty — one surface string per form instance; a different representation is a different form (#171). Mirrors test_form_representation_is_functional." .

# --- 6a. formType is an ObjectProperty (MUST) ---------------------------------
ex:saFormTypeIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:formType a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:formType MUST be an owl:ObjectProperty — it links a LexicalForm to its LexicalFormType value(s) (#171). Mirrors test_form_type_is_non_functional (positive half)." .

# --- 6b. formType is NOT functional (MUST-NOT) --------------------------------
ex:saFormTypeNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:formType a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:formType MUST NOT be functional — a single form may be classified as both spoken and written under different standpoints (Principle 9, #171). Mirrors test_form_type_is_non_functional (negative half)." .

# --- 7. UsageAttestation is an owl:Class, subclass of Observation and gufo:Relator (MUST) ---
ex:saUsageAttestationIsObservationRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:UsageAttestation a owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf gufo:Relator .
}""" ;
    gmeow:saRationale "gmeow:UsageAttestation MUST be an owl:Class, a subclass of gmeow:Observation, and a subclass of gufo:Relator — attestations are evidence nodes that follow the Observation+Relator pattern (Principle 12, #171). Mirrors test_usage_attestation_is_observation_relator." .

# --- 8. attestedForm is functional (MUST) -------------------------------------
ex:saAttestedFormFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:attestedForm a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:attestedForm MUST be an owl:FunctionalProperty — one attested form per UsageAttestation relator; multiple forms require separate attestations (#171). Mirrors test_attested_form_is_functional." .

# --- 9. EtymologicalDerivation is an owl:Class, subclass of Observation and gufo:Relator (MUST) ---
ex:saEtymologicalDerivationIsObservationRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:EtymologicalDerivation a owl:Class ;
        rdfs:subClassOf gmeow:Observation ;
        rdfs:subClassOf gufo:Relator .
}""" ;
    gmeow:saRationale "gmeow:EtymologicalDerivation MUST be an owl:Class, a subclass of gmeow:Observation, and a subclass of gufo:Relator — etymology is modeled as a provenance-rich standpointed claim graph, not a flat property (Principle 9, #171). Mirrors test_etymological_derivation_is_observation_relator." .

# --- 10. etymonSource and derivationTarget are functional (MUST) --------------
ex:saDerivationSourceTargetFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:etymonSource a owl:FunctionalProperty .
    gmeow:derivationTarget a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:etymonSource and gmeow:derivationTarget MUST each be owl:FunctionalProperty — one etymon source and one descendant target per EtymologicalDerivation relator; multi-etymon derivations are modeled as separate relators (#171). Mirrors test_derivation_source_target_are_functional." .

# --- 11a. derivationKind is an ObjectProperty (MUST) -------------------------
ex:saDerivationKindIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:derivationKind a owl:ObjectProperty . }""" ;
    gmeow:saRationale "gmeow:derivationKind MUST be an owl:ObjectProperty — it links an EtymologicalDerivation to its DerivationKind value(s) (#171). Mirrors test_derivation_kind_is_non_functional (positive half)." .

# --- 11b. derivationKind is NOT functional (MUST-NOT) ------------------------
ex:saDerivationKindNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:derivationKind a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:derivationKind MUST NOT be functional — a single derivation may be classified under multiple kinds by different analytical standpoints (Principle 9, #171). Mirrors test_derivation_kind_is_non_functional (negative half)." .

# --- 12a. LexicalFormType is a value-vocabulary subclass of gufo:QualityValue (MUST) ---
ex:saLexicalFormTypeIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:LexicalFormType rdfs:subClassOf gufo:QualityValue . }""" ;
    gmeow:saRationale "gmeow:LexicalFormType MUST be a subclass of gufo:QualityValue — form types are an open individuals-based value vocabulary, never subclasses (Principle 9, #171). Mirrors test_form_type_value_vocabulary (class half)." .

# --- 12b. The four seeded LexicalFormType individuals exist (MUST) ------------
ex:saLexicalFormTypeSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:formWritten        a gmeow:LexicalFormType .
    gmeow:formSpoken         a gmeow:LexicalFormType .
    gmeow:formReconstructed  a gmeow:LexicalFormType .
    gmeow:formTransliterated a gmeow:LexicalFormType .
}""" ;
    gmeow:saRationale "gmeow:formWritten, gmeow:formSpoken, gmeow:formReconstructed, and gmeow:formTransliterated MUST all exist as gmeow:LexicalFormType individuals — the four seed values tested by the original pytest. Mirrors test_form_type_value_vocabulary (individual-existence half)." .

# --- 13a. DerivationKind is a value-vocabulary subclass of gufo:QualityValue (MUST) ---
ex:saDerivationKindIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:DerivationKind rdfs:subClassOf gufo:QualityValue . }""" ;
    gmeow:saRationale "gmeow:DerivationKind MUST be a subclass of gufo:QualityValue — derivation kinds are an open individuals-based value vocabulary, never subclasses (Principle 9, #171). Mirrors test_derivation_kind_value_vocabulary (class half)." .

# --- 13b. The four seeded DerivationKind individuals exist (MUST) -------------
ex:saDerivationKindSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:derivationBorrowing     a gmeow:DerivationKind .
    gmeow:derivationSemanticShift a gmeow:DerivationKind .
    gmeow:derivationCompounding   a gmeow:DerivationKind .
    gmeow:derivationUnknownOrigin a gmeow:DerivationKind .
}""" ;
    gmeow:saRationale "gmeow:derivationBorrowing, gmeow:derivationSemanticShift, gmeow:derivationCompounding, and gmeow:derivationUnknownOrigin MUST all exist as gmeow:DerivationKind individuals — the four seed values tested by the original pytest. Mirrors test_derivation_kind_value_vocabulary (individual-existence half)." .
