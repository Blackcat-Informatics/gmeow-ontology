@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/documents>
    a owl:Ontology ;
    rdfs:label "GMEOW Documents Module"@en ;
    rdfs:comment "Creative works and document metadata — articles, patents, datasets, media, web pages (the schema.org / BIBO / BIBFRAME superset layer)."@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

gmeow:CreativeWork
    a owl:Class, gufo:Category ;
    rdfs:subClassOf gmeow:InformationObject ;
    rdfs:label "Creative Work"@en ;
    skos:definition "The abstract umbrella category for intellectual and artistic creations in the WEMI spine — a Work, Expression, Manifestation, or Item. Formerly a flat gufo:Kind (pre-#208); now a Category so that the four tiers with distinct identity criteria can each be a gufo:Kind beneath it."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Document
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Work ;
    rdfs:label "Document"@en ;
    skos:definition "An abstract intellectual work of bounded textual or digital content — the conceptual document, independent of any particular file, record, or report. A specialization of gmeow:Work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Article
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Work ;
    rdfs:label "Article"@en ;
    skos:definition "A written work published in a periodical, blog, or scholarly venue. A specialization of gmeow:Work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Patent
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Work ;
    rdfs:label "Patent"@en ;
    skos:definition "An abstract intellectual work describing an invention — the inventive concept as claimed, independent of any granted or filed document. A specialization of gmeow:Work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Dataset
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Work ;
    rdfs:label "Dataset"@en ;
    skos:definition "A collection of data published as a unit. A specialization of gmeow:Work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:LiteraryWork
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Work ;
    rdfs:label "Literary Work"@en ;
    skos:definition "An abstract long-form story or textual work — fiction, poetry, drama, or literary non-fiction. A specialization of gmeow:Work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:SerialWork
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Work ;
    rdfs:label "Serial Work"@en ;
    skos:definition "An ongoing authored work released over installments — a web serial, comic series, or magazine. A specialization of gmeow:Work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:MediaObject
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Manifestation ;
    rdfs:label "Media Object"@en ;
    skos:definition "An image, audio, or video media file — a concrete published artifact. A specialization of gmeow:Manifestation."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:WebPage
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Manifestation ;
    rdfs:label "Web Page"@en ;
    skos:definition "A page on the web identified by a URL — a concrete published artifact. A specialization of gmeow:Manifestation."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:BookRelease
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Manifestation ;
    rdfs:label "Book Release"@en ;
    skos:definition "A concrete published edition or release of a book — an out-of-universe information object and rights-bearing publication artifact. A specialization of gmeow:Manifestation. Distinct from the in-universe narrative frame it contributes to; linked via gmeow:sourceFor."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:SerialInstallment
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Manifestation ;
    rdfs:label "Serial Installment"@en ;
    skos:definition "A single issue, episode, or chapter of a serial creative work — a comic issue, TV episode, magazine issue, or serial chapter. An out-of-universe publication artifact distinct from the narrative frame it sources. A specialization of gmeow:Manifestation."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:ContentSegment
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:InformationObject ;
    rdfs:label "Content Segment"@en ;
    skos:definition "A structural part of a creative work, release, or installment — a chapter, section, scene, or episode. A gufo:Kind with distinct identity criteria (position and type within a containing whole)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:ReadingOrder
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Standpoint ;
    rdfs:label "Reading Order"@en ;
    skos:definition "A standpoint that supplies a subjective ordering for consuming segments of a work — publication order, internal chronology, author-recommended order, or fandom order. Never canonical ontology truth; claims are annotated gmeow:accordingTo a ReadingOrder."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:CreativeWorkTitle
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Appellation ;
    rdfs:label "Creative Work Title"@en ;
    skos:definition "An appellation borne by a creative work — a document title, article headline, dataset name, or media title. Carries its own gmeow:nameLanguage and gmeow:nameScript so co-equal multilingual titles (e.g. 'The Matrix' / '黑客帝国') are separate first-class objects, never alternateName subordinates."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasSegment
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasPart ;
    rdfs:range gmeow:ContentSegment ;
    rdfs:label "has segment"@en ;
    skos:definition "Relates a whole (work, release, installment, or another segment) to a structural part. Non-functional: a work may have many segments. Inverse of gmeow:segmentOf."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:segmentOf
    a owl:ObjectProperty, owl:TransitiveProperty ;
    owl:inverseOf gmeow:hasSegment ;
    rdfs:subPropertyOf gmeow:partOf ;
    rdfs:domain gmeow:ContentSegment ;
    rdfs:range gmeow:Entity ;
    rdfs:label "segment of"@en ;
    skos:definition "A structural segment is part of a larger whole — a work, release, installment, or another segment. Transitive; inverse of gmeow:hasSegment."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:segmentType
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ContentSegment ;
    rdfs:range gmeow:ContentSegmentType ;
    rdfs:label "segment type"@en ;
    skos:definition "The structural type of this segment — chapter, section, scene, etc. A value from the open gmeow:ContentSegmentType vocabulary."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:segmentIndex
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:ContentSegment ;
    rdfs:range xsd:integer ;
    rdfs:label "segment index"@en ;
    skos:definition "The position of this segment within its containing whole — 1-based by convention, but not enforced."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasTitle
    a owl:ObjectProperty ;
    rdfs:subPropertyOf gmeow:hasAppellation ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range gmeow:CreativeWorkTitle ;
    rdfs:label "has title"@en ;
    skos:definition "Relates a creative work to a structured gmeow:CreativeWorkTitle it bears; the creative-work-scoped specialization of gmeow:hasAppellation. Non-functional — a work bears many co-equal titles (original, translated, transliterated, regional); none is primary, and superseded ones set gmeow:displayable false. The structured replacement for the flat gmeow:title literal when multilingual or statement-level metadata is needed."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:title
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range rdfs:Literal ;
    rdfs:label "title"@en ;
    skos:definition "The title of a creative work."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:identifier
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range rdfs:Literal ;
    rdfs:label "identifier"@en ;
    skos:definition "A formal identifier of a creative work, such as a DOI or patent number."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:datePublished
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:range xsd:dateTime ;
    rdfs:label "date published"@en ;
    skos:definition "The date a creative work was published or issued."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# OPEN VALUE VOCABULARIES — individuals, never subclasses (Principle 9)
# =========================================================================== #

gmeow:ContentSegmentType
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Content Segment Type"@en ;
    skos:definition "The structural type of a content segment — a VALUE vocabulary (individuals, never subclasses). Chapter, section, scene, and paragraph are examples; the set is open."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# ContentSegmentType seeds
# --------------------------------------------------------------------------- #

gmeow:segmentTypeChapter     a gmeow:ContentSegmentType ; rdfs:label "chapter"@en ;     skos:definition "A major division of a written work."@en .
gmeow:segmentTypeSection     a gmeow:ContentSegmentType ; rdfs:label "section"@en ;     skos:definition "A distinct part or subdivision of a work."@en .
gmeow:segmentTypeScene       a gmeow:ContentSegmentType ; rdfs:label "scene"@en ;       skos:definition "A continuous sequence of action in a dramatic or narrative work."@en .
gmeow:segmentTypeParagraph   a gmeow:ContentSegmentType ; rdfs:label "paragraph"@en ;   skos:definition "A distinct section of writing covering a single theme."@en .
gmeow:segmentTypeFrontMatter a gmeow:ContentSegmentType ; rdfs:label "front matter"@en ; skos:definition "Preliminary material at the beginning of a book — title page, preface, table of contents."@en .
gmeow:segmentTypeBackMatter  a gmeow:ContentSegmentType ; rdfs:label "back matter"@en ;  skos:definition "Supplementary material at the end of a book — appendix, bibliography, index."@en .
