@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/sexuality>
    a owl:Ontology ;
    rdfs:label "GMEOW Sexuality Module"@x-gmeow-english ;
    skos:definition "The GMEOW Sexuality Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> ;
    rdfs:comment "A respectful, inclusive model of a person's orientation, reusing the gmeow:IdentityFacet base from the gender module (a reified, SELF-ASSERTED gufo:Relator). It applies the SPLIT-ATTRACTION model: sexual orientation and romantic orientation are SEPARATE, mutually independent axes — so asexual-biromantic, aromantic-bisexual and similar are directly expressible; neither is inferred from the other, nor from gender identity/expression, sex-assigned-at-birth, pronouns or honorifics. GOVERNING TENETS (shared with gender): self-assertion is the top authority; co-equality (no preferred/primary orientation; superseded labels kept with gmeow:displayable false, never deleted); INCLUSIVE WITHOUT OVERTYPING — gmeow:SexualOrientationValue and gmeow:RomanticOrientationValue are OPEN value vocabularies of individuals (never per-value subclasses, never a forced enum), an orientation not among the seeds being a FRESH value individual with rdfs:label. Aligns (lossily) to GSSO, Homosaurus and Wikidata; schema.org and FOAF have no orientation term, so orientation is a documented lossy drop at the projection layer. The machinery is otherwise canonical."@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Split-attraction orientation facets. Both subclass the shared gmeow:IdentityFacet
# (gender module) — a reified, self-asserted gufo:Relator. Sexual and romantic
# orientation are SEPARATE axes; there is deliberately no bridge between them.
# Each value property is the SINGLE path to its value (a fresh individual with
# rdfs:label when none is seeded) — no flat-literal shortcut.
# --------------------------------------------------------------------------- #

gmeow:SexualOrientation
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:IdentityFacet ;
    rdfs:label "Sexual Orientation"@x-gmeow-english ;
    skos:definition "A person's SELF-ASSERTED sexual orientation — the pattern of their sexual attraction — as a reified facet pointing (via gmeow:sexualOrientationValue) to an open gmeow:SexualOrientationValue. A SEPARATE axis from romantic orientation (split-attraction model) and from gender identity/expression; nothing infers one from another."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .

gmeow:hasSexualOrientation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Person ;
    rdfs:range gmeow:SexualOrientation ;
    rdfs:label "has sexual orientation"@x-gmeow-english ;
    skos:definition "Relates a person to a self-asserted sexual-orientation facet. Non-functional and contextual; a superseded one is kept with gmeow:displayable false, never deleted. MUST NOT be inferred from gmeow:hasRomanticOrientation, gmeow:hasGenderIdentity, gmeow:sexAssignedAtBirth, pronouns or honorifics."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .

gmeow:sexualOrientationValue
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:SexualOrientation ;
    rdfs:range gmeow:SexualOrientationValue ;
    rdfs:label "sexual orientation value"@x-gmeow-english ;
    skos:definition "The gmeow:SexualOrientationValue a sexual-orientation facet asserts (functional per facet). A predefined individual or a fresh one with rdfs:label; the single path to the value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .

gmeow:RomanticOrientation
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:IdentityFacet ;
    rdfs:label "Romantic Orientation"@x-gmeow-english ;
    skos:definition "A person's SELF-ASSERTED romantic orientation — the pattern of their romantic attraction — as a reified facet pointing (via gmeow:romanticOrientationValue) to an open gmeow:RomanticOrientationValue. A SEPARATE axis from sexual orientation (split-attraction model); the two are mutually independent (e.g. asexual yet biromantic)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .

gmeow:hasRomanticOrientation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Person ;
    rdfs:range gmeow:RomanticOrientation ;
    rdfs:label "has romantic orientation"@x-gmeow-english ;
    skos:definition "Relates a person to a self-asserted romantic-orientation facet. Non-functional and contextual; a superseded one is kept with gmeow:displayable false, never deleted. MUST NOT be inferred from gmeow:hasSexualOrientation, gmeow:hasGenderIdentity, gmeow:sexAssignedAtBirth, pronouns or honorifics."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .

gmeow:romanticOrientationValue
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:RomanticOrientation ;
    rdfs:range gmeow:RomanticOrientationValue ;
    rdfs:label "romantic orientation value"@x-gmeow-english ;
    skos:definition "The gmeow:RomanticOrientationValue a romantic-orientation facet asserts (functional per facet). A predefined individual or a fresh one with rdfs:label; the single path to the value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .

# =========================================================================== #
# VALUE VOCABULARIES (open; new entries are individuals, not subclasses).
# Sexual and romantic patterns are kept as SEPARATE vocabularies so the split-
# attraction distinction is explicit (asexual ≠ aromantic). The seed lists are
# anchors; the long tail is fresh individuals + the GSSO/Homosaurus alignments in
# mappings/gmeow-sexuality.sssom.tsv.
# =========================================================================== #

gmeow:SexualOrientationValue
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Sexual Orientation Value"@x-gmeow-english ;
    skos:definition "A pattern of sexual attraction — a VALUE pointed at by gmeow:sexualOrientationValue, never a subclass. Open: an orientation not seeded here is a fresh individual with rdfs:label."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .

gmeow:orientHeterosexual a gmeow:SexualOrientationValue ; rdfs:label "heterosexual"@x-gmeow-english .
gmeow:orientHeterosexual skos:definition "The heterosexual sexual orientation value — a pattern of sexual attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:orientHomosexual   a gmeow:SexualOrientationValue ; rdfs:label "homosexual / gay / lesbian"@x-gmeow-english .
gmeow:orientHomosexual skos:definition "The homosexual sexual orientation value — a pattern of sexual attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:orientBisexual     a gmeow:SexualOrientationValue ; rdfs:label "bisexual"@x-gmeow-english .
gmeow:orientBisexual skos:definition "The bisexual sexual orientation value — a pattern of sexual attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:orientPansexual    a gmeow:SexualOrientationValue ; rdfs:label "pansexual"@x-gmeow-english .
gmeow:orientPansexual skos:definition "The pansexual sexual orientation value — a pattern of sexual attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:orientAsexual      a gmeow:SexualOrientationValue ; rdfs:label "asexual"@x-gmeow-english .
gmeow:orientAsexual skos:definition "The asexual sexual orientation value — a pattern of sexual attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:orientDemisexual   a gmeow:SexualOrientationValue ; rdfs:label "demisexual"@x-gmeow-english .
gmeow:orientDemisexual skos:definition "The demisexual sexual orientation value — a pattern of sexual attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:orientQueer        a gmeow:SexualOrientationValue ; rdfs:label "queer"@x-gmeow-english .
gmeow:orientQueer skos:definition "The queer sexual orientation value — a pattern of sexual attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:orientQuestioning  a gmeow:SexualOrientationValue ; rdfs:label "questioning"@x-gmeow-english .
gmeow:orientQuestioning skos:definition "The questioning sexual orientation value — a pattern of sexual attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .

gmeow:RomanticOrientationValue
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Romantic Orientation Value"@x-gmeow-english ;
    skos:definition "A pattern of romantic attraction — a VALUE pointed at by gmeow:romanticOrientationValue, never a subclass. Kept separate from sexual orientation (split-attraction). Open: a fresh individual with rdfs:label when none is seeded."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .

gmeow:romanticHeteroromantic a gmeow:RomanticOrientationValue ; rdfs:label "heteroromantic"@x-gmeow-english .
gmeow:romanticHeteroromantic skos:definition "The heteroromantic romantic orientation value — a pattern of romantic attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:romanticHomoromantic   a gmeow:RomanticOrientationValue ; rdfs:label "homoromantic"@x-gmeow-english .
gmeow:romanticHomoromantic skos:definition "The homoromantic romantic orientation value — a pattern of romantic attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:romanticBiromantic     a gmeow:RomanticOrientationValue ; rdfs:label "biromantic"@x-gmeow-english .
gmeow:romanticBiromantic skos:definition "The biromantic romantic orientation value — a pattern of romantic attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:romanticPanromantic    a gmeow:RomanticOrientationValue ; rdfs:label "panromantic"@x-gmeow-english .
gmeow:romanticPanromantic skos:definition "The panromantic romantic orientation value — a pattern of romantic attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:romanticAromantic      a gmeow:RomanticOrientationValue ; rdfs:label "aromantic"@x-gmeow-english .
gmeow:romanticAromantic skos:definition "The aromantic romantic orientation value — a pattern of romantic attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:romanticDemiromantic   a gmeow:RomanticOrientationValue ; rdfs:label "demiromantic"@x-gmeow-english .
gmeow:romanticDemiromantic skos:definition "The demiromantic romantic orientation value — a pattern of romantic attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:romanticQueerromantic  a gmeow:RomanticOrientationValue ; rdfs:label "queerplatonic / queer-romantic"@x-gmeow-english .
gmeow:romanticQueerromantic skos:definition "The queerromantic romantic orientation value — a pattern of romantic attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
gmeow:romanticQuestioning    a gmeow:RomanticOrientationValue ; rdfs:label "questioning"@x-gmeow-english .

gmeow:romanticQuestioning skos:definition "The questioning romantic orientation value — a pattern of romantic attraction that an agent may experience."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sexuality> .
# =========================================================================== #
# AXIOMATIZED DOCTRINE (#38). The cross-module disjointness of the orientation
# axes (SexualOrientation / RomanticOrientation) and their value spaces is
# asserted with the rest of the seven-axis matrix in gender.ttl. Here we add the
# relator-mediation existentials for the two orientation facets — EL, open-world
# (the closed-world "exactly one value" is SHACL's job, #39).
# =========================================================================== #

gmeow:SexualOrientation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:sexualOrientationValue ; owl:someValuesFrom gmeow:SexualOrientationValue ] .
gmeow:RomanticOrientation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:romanticOrientationValue ; owl:someValuesFrom gmeow:RomanticOrientationValue ] .
