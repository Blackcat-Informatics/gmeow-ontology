                                [ logic:termIndex 1 ; logic:termVariable "value" ] ] ],
                    [ a logic:Formula ; logic:and
                        [ a logic:Formula ; logic:relation gmeow:epochArchive ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "artifact" ] ],
                        [ a logic:Formula ; logic:relation gmeow:epochArchiveDigest ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "value" ] ] ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation gmeow:contentDigest ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "artifact" ],
                    [ logic:termIndex 1 ; logic:termVariable "value" ] ] ] ] .

