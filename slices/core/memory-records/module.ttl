gmeow:CurationEpoch logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:epochEvidence ; logic:allValuesFrom gmeow:InformationObject ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:CurationEpoch ; logic:closureKey "https://blackcatinformatics.ca/gmeow/epochEvidence" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:CurationEpoch logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:curationManifestDigest ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( gmeow:blake3_256Digest gmeow:sha256Digest gmeow:md5Digest ) ] ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:CurationEpoch ; logic:closureKey "https://blackcatinformatics.ca/gmeow/curationManifestDigest" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:CurationEpoch logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:epochPredecessorDigest ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( gmeow:blake3_256Digest gmeow:sha256Digest gmeow:md5Digest ) ] ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:CurationEpoch ; logic:closureKey "https://blackcatinformatics.ca/gmeow/epochPredecessorDigest" ; logic:closureValue logic:ClosedWorldClosure ] .
