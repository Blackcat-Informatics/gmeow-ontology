gmeow:AffectDecisionRuleConsistencyConstraint
    a logic:Constraint ;
    rdfs:label "Classifier decision rule-consistency constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world relational integrity constraint: a gmeow:ClassifierOutput's gmeow:scoreSemantics gmeow:impliesLabelSetDecision matches its emitted label's set gmeow:labelSetDecision."@x-gmeow-english ;
    logic:formalizes gmeow:ClassifierOutput ;
    logic:message "A classifier output's gmeow:scoreSemantics implies a label-set decision rule (softmax → argmax, sigmoid → independent-threshold) that MUST match its emitted label's set gmeow:labelSetDecision — a softmax score over a multi-label set (or a sigmoid over an exclusive set) is an inconsistency (a hard fail)." ;
    logic:integrity logic:drcForall .
logic:drcForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sem" ] , [ logic:termIndex 2 ; logic:termVariable "label" ] , [ logic:termIndex 3 ; logic:termVariable "implied" ] , [ logic:termIndex 4 ; logic:termVariable "set" ] , [ logic:termIndex 5 ; logic:termVariable "declared" ] ;
    logic:forall logic:drcImpl .
logic:drcImpl a logic:Formula ; logic:antecedent logic:drcGuard ; logic:consequent logic:drcEq .
logic:drcGuard a logic:Formula ; logic:and logic:drcType , logic:drcSem , logic:drcLabel , logic:drcImplies , logic:drcMember , logic:drcDecision .
logic:drcType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ClassifierOutput ] .
logic:drcSem a logic:Formula ; logic:relation gmeow:scoreSemantics ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sem" ] .
logic:drcLabel a logic:Formula ; logic:relation gmeow:emittedLabel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "label" ] .
logic:drcImplies a logic:Formula ; logic:relation gmeow:impliesLabelSetDecision ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sem" ] , [ logic:termIndex 1 ; logic:termVariable "implied" ] .
logic:drcMember a logic:Formula ; logic:relation gmeow:memberOfLabelSet ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "label" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] .
logic:drcDecision a logic:Formula ; logic:relation gmeow:labelSetDecision ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "set" ] , [ logic:termIndex 1 ; logic:termVariable "declared" ] .
logic:drcEq a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "implied" ] , [ logic:termIndex 1 ; logic:termVariable "declared" ] .

gmeow:modelIdentifierFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "modelIdentifier is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:modelIdentifier is functional: an inference run executes exactly one pinned model repository id, so a run naming two model ids would not identify a single reproducible execution."@x-gmeow-english ;
    logic:characterizes gmeow:modelIdentifier ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:modelIdentifier ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:modelIdentifier names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:modelIdentifier, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:modelIdentifier and nothing else. It is not a definition of gmeow:modelIdentifier (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:modelIdentifierFunctionality logic:characterizes gmeow:modelIdentifier ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:modelRevisionFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "modelRevision is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:modelRevision is functional: a run pins exactly one model revision/commit — the single most drift-prone coordinate of its reproducible identity — so two revisions on one run would name two different models rather than one execution."@x-gmeow-english ;
    logic:characterizes gmeow:modelRevision ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:modelRevision ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:modelRevision names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:modelRevision, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:modelRevision and nothing else. It is not a definition of gmeow:modelRevision (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:modelRevisionFunctionality logic:characterizes gmeow:modelRevision ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:producedByFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "producedBy is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:producedBy is functional: a classifier output is attributed to exactly one ModelInferenceRun execution record, so it cannot name two producing records. The record is distinct from an execution Activity."@x-gmeow-english ;
    logic:characterizes gmeow:producedBy ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:producedBy ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:producedBy names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:producedBy, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:producedBy and nothing else. It is not a definition of gmeow:producedBy (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:producedByFunctionality logic:characterizes gmeow:producedBy ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:scoreSemanticsFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "scoreSemantics is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:scoreSemantics is functional: a classifier score has exactly one declared meaning — sigmoid, softmax probability, calibrated probability, logit, or margin — because one number cannot be two of those at once without becoming uninterpretable."@x-gmeow-english ;
    logic:characterizes gmeow:scoreSemantics ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:scoreSemantics ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:scoreSemantics names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:scoreSemantics, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:scoreSemantics and nothing else. It is not a definition of gmeow:scoreSemantics (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:scoreSemanticsFunctionality logic:characterizes gmeow:scoreSemantics ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:labelSetDecisionFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "labelSetDecision is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:labelSetDecision is functional: a registered label set carries exactly one decision structure — argmax-exclusive or independent-threshold — because a set that was simultaneously single-label and multi-label would make its exclusivity, and hence whether a second label crossing is a violation, undecidable. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:labelSetDecision ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:labelSetDecision ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:labelSetDecision names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:labelSetDecision, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:labelSetDecision and nothing else. It is not a definition of gmeow:labelSetDecision (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:labelSetDecisionFunctionality logic:characterizes gmeow:labelSetDecision ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

# Classifier typing and closed-world required paths.
<https://blackcatinformatics.ca/gmeow/ClassifierLabel> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/memberOfLabelSet> ; logic:allValuesFrom logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/ClassifierOutput> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/classifiedTarget> ; logic:allValuesFrom logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/ClassifierOutput> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/classifierScore> ; logic:allValuesFrom <http://www.w3.org/2001/XMLSchema#decimal> ] .
<https://blackcatinformatics.ca/gmeow/ClassifierOutput> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/emittedLabel> ; logic:allValuesFrom logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/ClassifierOutput> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/producedBy> ; logic:allValuesFrom logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/ClassifierOutput> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/scoreSemantics> ; logic:allValuesFrom logic:Thing ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierLabel> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/memberOfLabelSet" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierOutput> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/classifiedTarget" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierOutput> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/classifierScore" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierOutput> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/emittedLabel" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierOutput> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/producedBy" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/ClassifierOutput> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/scoreSemantics" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
gmeow:ModelInferenceRun logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:modelIdentifier ; logic:allValuesFrom rdfs:Literal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:modelRevision ; logic:allValuesFrom rdfs:Literal ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelInferenceRun ; logic:closureKey "https://blackcatinformatics.ca/gmeow/modelIdentifier" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:ModelInferenceRun ; logic:closureKey "https://blackcatinformatics.ca/gmeow/modelRevision" ; logic:closureValue logic:ClosedWorldClosure ] .

# One output is one score cell; property-characteristic carriers govern shared relations.
gmeow:ClassifierOutput logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:emittedLabel ; logic:allValuesFrom gmeow:ClassifierLabel ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:producedBy ; logic:allValuesFrom gmeow:ModelInferenceRun ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:scoreSemantics ; logic:allValuesFrom gmeow:ScoreSemantics ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:classifiedTarget ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:emittedLabel ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:classifierScore ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:thresholdApplied ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:decimal ] .
gmeow:ClassifierLabel logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:memberOfLabelSet ; logic:allValuesFrom gmeow:ClassifierLabelSet ] .
gmeow:ModelInferenceRun logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:runLabelSet ; logic:allValuesFrom gmeow:ClassifierLabelSet ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:runLabelSet ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:hypothesisTemplate ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:hypothesisTemplate ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:labelSetRevision ; logic:allValuesFrom xsd:string ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:labelSetRevision ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:string ] .

gmeow:RegisteredClassifierLabelSet
    a logic:SubKind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Registered Classifier Label Set"@x-gmeow-english ;
    skos:definition "A static classifier registry admitted with a reviewed decision rule, specializing ClassifierLabelSet. The required labelSetDecision applies to this class only, never to every run-scoped candidate set."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:subClassOf gmeow:ClassifierLabelSet ,
        [ a logic:Restriction ; logic:onProperty gmeow:labelSetDecision ; logic:allValuesFrom gmeow:LabelSetDecisionRule ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:RegisteredClassifierLabelSet ; logic:closureKey "https://blackcatinformatics.ca/gmeow/labelSetDecision" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:ZeroShotTemplatePresentConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Zero-shot template-present constraint"@x-gmeow-english ;
    skos:definition "An execution record named by an output declaring scoreEntailment must preserve its exact hypothesisTemplate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes gmeow:ModelInferenceRun ;
    logic:message "An execution record named by an output declaring scoreEntailment must preserve its exact hypothesisTemplate." ;
    logic:integrity logic:classifierZeroTemplateForall .
logic:classifierZeroTemplateForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "out" ] ;
    logic:forall logic:classifierZeroTemplateImpl .
logic:classifierZeroTemplateImpl a logic:Formula ; logic:antecedent logic:classifierZeroTemplateGuard ; logic:consequent logic:classifierZeroTemplateExists .
logic:classifierZeroTemplateGuard a logic:Formula ; logic:and logic:classifierZeroTemplateGuard0 , logic:classifierZeroTemplateGuard1 , logic:classifierZeroTemplateGuard2 .
logic:classifierZeroTemplateGuard0 a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ModelInferenceRun ] .
logic:classifierZeroTemplateGuard1 a logic:Formula ; logic:relation gmeow:producedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:classifierZeroTemplateGuard2 a logic:Formula ; logic:relation gmeow:scoreSemantics ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out" ] , [ logic:termIndex 1 ; logic:termIri gmeow:scoreEntailment ] .
logic:classifierZeroTemplateExists a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "template" ] ; logic:exists logic:classifierZeroTemplateRequired .
logic:classifierZeroTemplateRequired a logic:Formula ; logic:relation gmeow:hypothesisTemplate ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "template" ] .

gmeow:ClassifierRunLabelMembershipConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Classifier run label-membership constraint"@x-gmeow-english ;
    skos:definition "If an execution record explicitly declares runLabelSet, every label emitted by an output attributed to that record must belong to that set."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes gmeow:ModelInferenceRun ;
    logic:message "If an execution record explicitly declares runLabelSet, every label emitted by an output attributed to that record must belong to that set." ;
    logic:integrity logic:classifierRunMembershipForall .
logic:classifierRunMembershipForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] , [ logic:termIndex 2 ; logic:termVariable "out" ] , [ logic:termIndex 3 ; logic:termVariable "label" ] ;
    logic:forall logic:classifierRunMembershipImpl .
logic:classifierRunMembershipImpl a logic:Formula ; logic:antecedent logic:classifierRunMembershipGuard ; logic:consequent logic:classifierRunMembershipRequired .
logic:classifierRunMembershipGuard a logic:Formula ; logic:and logic:classifierRunMembershipGuard0 , logic:classifierRunMembershipGuard1 , logic:classifierRunMembershipGuard2 , logic:classifierRunMembershipGuard3 .
logic:classifierRunMembershipGuard0 a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ModelInferenceRun ] .
logic:classifierRunMembershipGuard1 a logic:Formula ; logic:relation gmeow:runLabelSet ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] .
logic:classifierRunMembershipGuard2 a logic:Formula ; logic:relation gmeow:producedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:classifierRunMembershipGuard3 a logic:Formula ; logic:relation gmeow:emittedLabel ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "out" ] , [ logic:termIndex 1 ; logic:termVariable "label" ] .
logic:classifierRunMembershipRequired a logic:Formula ; logic:relation gmeow:memberOfLabelSet ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "label" ] , [ logic:termIndex 1 ; logic:termVariable "set" ] .

# Contract-bound retrieval segmentation and whole-source atomic block coordinates.

gmeow:Chunking
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Chunking"@x-gmeow-english ;
    skos:definition "One recorded segmentation of an exact source revision under an identified frozen contract. Source and contract artifacts retain their own content digests; the selected pins are distinct from any digest of this enclosing result record. Granularity and ordered member chunks describe this segmentation without assuming overlap or exhaustive coverage policies."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:ChunkingMember
    a logic:Role , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Chunking Member"@x-gmeow-english ;
    skos:definition "The role of an actual contiguous Chunk selected into one Chunking. Its ordinal belongs to that chunking, and chunkOf identifies the exact carrier cut by its source-coordinate bounds. A different segmentation uses fresh chunk identities; this role does not turn every existing Chunk into a contract-bound member."@x-gmeow-english ;
    logic:subClassOf gmeow:Chunk ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:BlockExtent
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "Block Extent"@x-gmeow-english ;
    skos:definition "A recorded whole-source extent of one ContentBlock in one exact source carrier. extentSource fixes the coordinate origin; spanStart and spanEnd retain the existing zero-based half-open Unicode-code-point semantics. These are not offsets local to the block or its division. This record supplies coordinates for atomic-boundary checks without redefining the block’s structural identity."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:chunkingSource
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "chunking source revision"@x-gmeow-english ;
    skos:definition "The exact information artifact whose text this chunking segments, rather than a mutable work identity, location or enclosing import record."@x-gmeow-english ;
    logic:domain gmeow:Chunking ;
    logic:range gmeow:InformationObject ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:chunkingSourceDigest
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "chunking source digest"@x-gmeow-english ;
    skos:definition "The selected contentDigest of the exact chunkingSource artifact, captured as a pin on this result. It hashes the source bytes, not this result record. Other algorithm-labelled source digests may coexist."@x-gmeow-english ;
    logic:domain gmeow:Chunking ;
    logic:range rdfs:Literal ;
    logic:subPropertyOf lang:literalValue ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:chunkingContract
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "chunking contract artifact"@x-gmeow-english ;
    skos:definition "The frozen rules artifact used for this segmentation and present in its creation context. It identifies the actual contract bytes, not prose describing a wrapper or a claim that the opaque contract has been executed or proved."@x-gmeow-english ;
    logic:domain gmeow:Chunking ;
    logic:range gmeow:InformationObject ;
    logic:subPropertyOf gmeow:contextIncluded ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:chunkingContractDigest
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "chunking contract digest"@x-gmeow-english ;
    skos:definition "The selected contentDigest of the named chunkingContract artifact. It pins those rule bytes; it is not a contentDigest of the enclosing Chunking. No IRI, path or result hash substitutes for the required contract digest."@x-gmeow-english ;
    logic:domain gmeow:Chunking ;
    logic:range rdfs:Literal ;
    logic:subPropertyOf lang:literalValue ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:inChunking
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "in chunking"@x-gmeow-english ;
    skos:definition "The one segmentation containing this selected chunk. Its source, contract and ordinal scope belong to that Chunking; membership is not a claim that all source text has been covered."@x-gmeow-english ;
    logic:domain gmeow:ChunkingMember ;
    logic:range gmeow:Chunking ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:coversBlockExtent
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "covers block extent"@x-gmeow-english ;
    skos:definition "An atomic block occurrence wholly covered by this chunk, identified through its BlockExtent and extentOfBlock. The extent must share the chunk’s exact source origin. This relation neither substitutes local block offsets nor declares exhaustive source coverage."@x-gmeow-english ;
    logic:domain gmeow:ChunkingMember ;
    logic:range gmeow:BlockExtent ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extentOfBlock
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "extent of block"@x-gmeow-english ;
    skos:definition "The structural ContentBlock located by this whole-source extent record. The block keeps its existing division, structural index and segment kind."@x-gmeow-english ;
    logic:domain gmeow:BlockExtent ;
    logic:range gmeow:ContentBlock ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:extentSource
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "extent source origin"@x-gmeow-english ;
    skos:definition "The exact whole-source carrier whose Unicode-code-point origin these extent bounds use. A block-local rendering or a different revision is a different frame and cannot be compared silently with chunk bounds."@x-gmeow-english ;
    logic:domain gmeow:BlockExtent ;
    logic:range gmeow:InformationObject ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:Chunking logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingSource ; logic:allValuesFrom gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingSource ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingSourceDigest ; logic:allValuesFrom rdfs:Literal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingSourceDigest ; logic:maxQualifiedCardinality 1 ; logic:onDataRange rdfs:Literal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingContract ; logic:allValuesFrom gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingContract ; logic:maxQualifiedCardinality 1 ; logic:onClass gmeow:InformationObject ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingContractDigest ; logic:allValuesFrom rdfs:Literal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:chunkingContractDigest ; logic:maxQualifiedCardinality 1 ; logic:onDataRange rdfs:Literal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:hasGranularity ; logic:allValuesFrom gmeow:GranularityLevel ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Chunking ; logic:closureKey "https://blackcatinformatics.ca/gmeow/chunkingSource" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Chunking ; logic:closureKey "https://blackcatinformatics.ca/gmeow/chunkingSourceDigest" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Chunking ; logic:closureKey "https://blackcatinformatics.ca/gmeow/chunkingContract" ; logic:closureValue logic:ClosedWorldClosure ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:Chunking ; logic:closureKey "https://blackcatinformatics.ca/gmeow/chunkingContractDigest" ; logic:closureValue logic:ClosedWorldClosure ] .
