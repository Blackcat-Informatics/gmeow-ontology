#
# Declarative structural assertions for the employment slice — the slice-resident
# test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants formerly
# hand-written in tests/test_employment.py. Each runs as a SPARQL ASK over the
# employment module graph (gmeow:scopeModule) under the native Rust slicetest
# harness (crates/slicetest).
#
# Employment is migrated, so class stereotypes are logic:
# (logic:AbstractIndividualType, logic:SubKind, logic:QualityValue), not gufo:.
#
# The cross-slice EventType invariant, the SHACL fixture-conformance checks, and
# the whole-graph negative sweep now live natively in
# crates/validate/tests/conformance_cases/conformance_employment.rs
# (employment_event_types_are_values, contested/withdrawn conform cases +
# GraphStore ABox twins, no_preferred_or_primary_employment_term).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/employment/tests/> .

# --- 0. Employment is a Membership subkind (MUST) ----------------------------
ex:saEmploymentIsMembershipSubKind a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Employment a owl:Class , logic:SubKind ;
        rdfs:subClassOf gmeow:Membership .
}""" ;
    gmeow:saRationale "gmeow:Employment MUST be an owl:Class typed logic:SubKind and a subclass of gmeow:Membership. Replaces the local half of the former whole-graph employment grounding check." .

# --- 1. EmploymentType is an AbstractIndividualType value vocabulary (MUST) ---
ex:saEmploymentTypeIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:EmploymentType a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:EmploymentType MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue — employment kind is a value vocabulary of individuals, never a subclass taxonomy (Principle 9)." .

# --- 2. Core EmploymentType seed individuals exist (MUST) ---------------------
ex:saEmploymentTypeSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:employmentTypeFullTime a gmeow:EmploymentType .
    gmeow:employmentTypePartTime a gmeow:EmploymentType .
    gmeow:employmentTypeContract a gmeow:EmploymentType .
    gmeow:employmentTypeIntern   a gmeow:EmploymentType .
}""" ;
    gmeow:saRationale "The four core EmploymentType seed individuals (fullTime, partTime, contract, intern) MUST exist as gmeow:EmploymentType individuals — they are the minimum closed seed set (Principle 9)." .

# --- 3. No per-type Employment subclasses exist (MUST-NOT) -------------------
ex:saNoPerTypeEmploymentSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?rejected { gmeow:FullTimeEmployment gmeow:PartTimeEmployment gmeow:ContractEmployment }
    ?rejected a owl:Class .
}""" ;
    gmeow:saRationale "gmeow:FullTimeEmployment, gmeow:PartTimeEmployment, and gmeow:ContractEmployment MUST NOT be declared as owl:Class — per-type subclasses are banned; all employment kinds are open individuals of EmploymentType (Principle 9)." .

# --- 4. SeniorityLevel is an AbstractIndividualType value vocabulary (MUST) --
ex:saSeniorityLevelIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SeniorityLevel a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:SeniorityLevel MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue — seniority rank is a value vocabulary of individuals, never an Employment subclass (Principle 9)." .

# --- 5. SeniorityLevel seed individuals exist (MUST) -------------------------
ex:saSeniorityLevelSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:seniorityEntry     a gmeow:SeniorityLevel .
    gmeow:seniorityMid       a gmeow:SeniorityLevel .
    gmeow:senioritySenior    a gmeow:SeniorityLevel .
    gmeow:seniorityLead      a gmeow:SeniorityLevel .
    gmeow:seniorityExecutive a gmeow:SeniorityLevel .
}""" ;
    gmeow:saRationale "All five SeniorityLevel seed individuals (entry, mid, senior, lead, executive) MUST exist as gmeow:SeniorityLevel individuals." .
