# Class-local coordinate bounds; partial descriptions retain absent flags.
gmeow:QueryRestrictionFrame logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:restrictionComponentsComplete ; logic:allValuesFrom xsd:boolean ],
    [ a logic:Restriction ; logic:onProperty gmeow:restrictionComponentsComplete ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange xsd:boolean ] .

gmeow:QueryFrameMeetExtent logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:meetOperandsComplete ; logic:allValuesFrom xsd:boolean ],
    [ a logic:Restriction ; logic:onProperty gmeow:meetOperandsComplete ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange xsd:boolean ],
    [ a logic:Restriction ; logic:onProperty gmeow:meetRealized ; logic:allValuesFrom xsd:boolean ],
    [ a logic:Restriction ; logic:onProperty gmeow:meetRealized ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange xsd:boolean ],
    [ a logic:Restriction ; logic:onProperty gmeow:extentFrame ; logic:allValuesFrom gmeow:QueryRestrictionFrame ],
    [ a logic:Restriction ; logic:onProperty gmeow:extentFrame ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ] .
