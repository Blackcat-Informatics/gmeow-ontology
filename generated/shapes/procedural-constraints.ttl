        sh:select """SELECT $this WHERE { ?profile <https://blackcatinformatics.ca/gmeow/profileOpenValue> ?openClass . $this a ?openClass . FILTER NOT EXISTS { ?profile <https://blackcatinformatics.ca/gmeow/profileDescriptor> ?descriptor . ?subj ?descriptor $this . } }""" ;
    ] .

