<https://blackcatinformatics.ca/gmeow/slices/entities>
    a gmeow:Slice ;
    rdfs:label "entities"@x-gmeow-english ;
    skos:definition "The entities slice of the GMEOW ontology (core tier): GMEOW Entities Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/entities> ;
    dcterms:title "GMEOW Entities Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/contacts> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/documents> ,
        <https://blackcatinformatics.ca/gmeow/slices/language> ,
        <https://blackcatinformatics.ca/gmeow/slices/names> ,
