@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix logic:   <https://blackcatinformatics.ca/logic/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# =============================================================================
# Slice manifest shapes — validate every slices/*/*/manifest.ttl.
#
# Structural validation only (cardinality, datatypes, tier values). The
# SEMANTIC gates — declared deps match the computed reference graph, no
# extension→extension edge, guide term-anchors resolve, consumer non-vacuous —
# live in the slice gate (gmeow_tools), which has the whole graph in view.
# Sibling of mapping-dsl-shapes.ttl / statement-dsl-shapes.ttl.
# =============================================================================

gmeow:SliceManifestShape
    a sh:NodeShape ;
    sh:targetClass gmeow:Slice ;
    rdfs:label "slice manifest shape"@x-gmeow-english ;
    skos:definition "Structural validation for every slice manifest: exactly one tier (core or extension), at least one non-vacuous Principle 15 consumer, IRI-valued dependencies, and the title/creator pair the CITATION.cff projection requires. Semantic gates (dependency DAG, anchor resolution) live in the slice gate."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slice-dsl> ;
    logic:formalizes gmeow:SliceTierRequiredConstraint, gmeow:SliceConsumerRequiredConstraint,
        gmeow:SliceDependsOnCreatorRequiredConstraint, gmeow:SliceProvidesSubcommandPatternConstraint,
        gmeow:SliceConsumerLangMinLengthConstraint, gmeow:SliceTitleUniqueLangConstraint,
        gmeow:SliceTitleCanonicalConstraint ;
    sh:property [
        sh:path gmeow:sliceTier ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( gmeow:tierCore gmeow:tierExtension gmeow:tierProfile ) ;
        sh:message "A slice declares exactly one tier: gmeow:tierCore, gmeow:tierExtension, or gmeow:tierProfile (a pure-selection profile that mints nothing — Principle 16)."@x-gmeow-english ;
    ] ;
    sh:property [
        sh:path gmeow:sliceConsumer ;
        sh:minCount 1 ;
        # PROSE (human-facing, localizable): a consumer description is a
        # translatable sentence, so it MUST carry the @x-gmeow-english source
        # tag (lang-tag discipline, #820 S0 manifest datatype contract). A plain
        # xsd:string would forbid the very lang-tagged literals every committed
        # manifest already uses.
        sh:nodeKind sh:Literal ;
        sh:languageIn ( "x-gmeow-english" ) ;
        sh:minLength 8 ;
        sh:message "A slice names at least one consumer — who uses this, through which surface, in which product (Principle 15); the literal carries @x-gmeow-english (lang-tag discipline)."@x-gmeow-english ;
    ] ;
    sh:property [
        sh:path gmeow:sliceDependsOn ;
        sh:nodeKind sh:IRI ;
        sh:message "Slice dependencies are slice IRIs."@x-gmeow-english ;
    ] ;
    sh:property [
        sh:path dcterms:title ;
        sh:minCount 1 ;
        # PROSE (human-facing, localizable): the title is a translatable label.
        # sh:maxCount 1 is intentionally absent — the imminent whole-ontology
        # Mandarin+French translation will add one literal per language tag.
        # sh:uniqueLang true ensures at most one literal per language tag.
        # The canonical @x-gmeow-english carrier is REQUIRED (qualified value
        # shape below); additional translations are freely permitted.
        sh:nodeKind sh:Literal ;
        sh:uniqueLang true ;
        sh:qualifiedValueShape [ sh:languageIn ( "x-gmeow-english" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "A slice carries at least the canonical @x-gmeow-english dcterms:title (projected to its CITATION.cff); translations may add further language-tagged literals, one per language tag."@x-gmeow-english ;
    ] ;
    sh:property [
        sh:path dcterms:creator ;
        sh:minCount 1 ;
        # TOKEN / proper-name (NOT translatable prose): a creator is a legal-entity
        # or personal proper name projected verbatim into CITATION.cff, so the #820
        # S0 manifest datatype contract classes it with the programmatic tokens —
        # a plain string, NEVER lang-tagged. (Every committed manifest already
        # carries an untagged name; tagging a proper noun @x-gmeow-english would be
        # a category error and would hard-fail this gate.)
        sh:datatype xsd:string ;
        sh:message "A slice names at least one creator as a plain proper-name literal (projected to its CITATION.cff — third-party slice authors get citability from the manifest)."@x-gmeow-english ;
    ] ;
    sh:property [
        sh:path gmeow:sliceProfile ;
        sh:datatype xsd:string ;
        sh:message "Profile membership is multi-valued (#330): a slice may serve several named profiles; each value names both the OWL composition IRI and the GTS sub-profile tag."@x-gmeow-english ;
    ] ;
    sh:property [
        sh:path gmeow:providesSubcommand ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-z][a-z0-9-]*$" ;
        sh:message "A provided subcommand is a lowercase token the gmeow roll-up can dispatch on (docs/cli-extensions.md, #326)."@x-gmeow-english ;
    ] ;
    sh:property [
        sh:path gmeow:builtAgainstCore ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] .
