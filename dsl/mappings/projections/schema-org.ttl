gmeow:mapSchemaSkillProficiency a gmeow:ProjectionMapping ;
    rdfs:label "SkillProficiency relator → schema:knowsAbout / schema:skills (flatten)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "agent" ; gmeow:value "skill" ;
        gmeow:atom (
            [ gmeow:subjectVar "prof" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:SkillProficiency ]
            [ gmeow:subjectVar "prof" ; gmeow:predicate gmeow:skillProficiencyAgent ; gmeow:objectVar "agent" ]
            [ gmeow:subjectVar "prof" ; gmeow:predicate gmeow:skillProficiencyOf ; gmeow:objectVar "skill" ] ) ;
        gmeow:edoalSource gmeow:hasSkill ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:knowsAbout ; gmeow:relation "<=" ;
        gmeow:transform gmeow:fnSkillProficiencyToKnowsAbout ; gmeow:confidence 0.8 ;
        gmeow:lossyDrop "the SkillProficiency relator (level, scale, interval, standpoint, confidence) collapses to a flat schema:knowsAbout edge" ] .

