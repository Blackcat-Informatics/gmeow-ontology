gmeow:QueryVerdictComparison logic:subClassOf [ a logic:Restriction ; logic:onProperty logic:leftOperand ; logic:allValuesFrom gmeow:QueryProgramNode ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryVerdictComparison ; logic:closureKey "https://blackcatinformatics.ca/logic/leftOperand" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryVerdictComparison logic:subClassOf [ a logic:Restriction ; logic:onProperty logic:leftOperand ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass gmeow:QueryProgramNode ] .

