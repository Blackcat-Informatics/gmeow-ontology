@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/documents>
    a owl:Ontology ;
    rdfs:label "GMEOW Documents Module"@en ;
    rdfs:comment "Document metadata: works, expressions, and the agents responsible for them."@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

gmeow:Document
    a owl:Class ;
    rdfs:subClassOf gmeow:Entity, gufo:Object ;
    rdfs:label "Document"@en ;
    skos:definition "A bounded information artifact — a file, record, web page, or publication — that can be described, attributed, and dated."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasAuthor
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Document ;
    rdfs:range gmeow:Agent ;
    rdfs:label "has author"@en ;
    skos:definition "Relates a document to an agent chiefly responsible for creating its intellectual content."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
