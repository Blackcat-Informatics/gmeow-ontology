msgctxt "https://blackcatinformatics.ca/gmeow/commitmentStatus|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:record gmeow:commitmentStatus ex:target ."
msgstr "ex:record gmeow:commitmentStatus ex:target ."

msgctxt "https://blackcatinformatics.ca/gmeow/receiptOperation|http://www.w3.org/2000/01/rdf-schema#label"
msgid "receipt operation"
msgstr "回执操作"

msgctxt "https://blackcatinformatics.ca/gmeow/receiptOperation|http://www.w3.org/2004/02/skos/core#definition"
msgid "The artifact operation performed by this receipt-shaped activity occurrence."
msgstr "此回执形式活动出现所执行的制品操作。"

msgctxt "https://blackcatinformatics.ca/gmeow/receiptOperation|https://blackcatinformatics.ca/gmeow/useWhen"
