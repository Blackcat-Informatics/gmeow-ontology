# Projection: GMEOW → pure ontolex. GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: structured name parts, name usage contexts, register/audience.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX ontolex: <http://www.w3.org/ns/lemon/ontolex#>
PREFIX lime: <http://www.w3.org/ns/lemon/lime#>

CONSTRUCT {
    ?app a ontolex:LexicalEntry .
    ?app ontolex:lexicalForm ?form .
    ?form a ontolex:Form .
    ?form ontolex:writtenRep ?_final_fullName .
    ?app lime:language ?lang .
}
WHERE {
    {
        ?app gmeow:fullName ?fullName .
        OPTIONAL { ?app gmeow:nameLanguage ?lang . }
        BIND ( IRI(CONCAT(STR(?app), "-form")) AS ?form )
        FILTER NOT EXISTS { ?app gmeow:displayable false . }
        OPTIONAL {
            ?app gmeow:nameLanguage ?_lang .
            ?_lang gmeow:languageTag ?_intTag .
            FILTER(isLiteral(?fullName) && LANG(?fullName) = ?_intTag)
            ?_lang gmeow:languageCode ?_extCode .
            OPTIONAL { ?app gmeow:nameScript ?_sc . }
        }
        BIND ( IF(BOUND(?_extCode), STRLANG(STR(?fullName), IF(BOUND(?_sc), CONCAT(?_extCode, '-', ?_sc), ?_extCode)), ?fullName) AS ?_final_fullName )
    }
}
