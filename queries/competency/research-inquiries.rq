# Competency question: "Open research inquiries by theme and status"
# Expected: plans carrying logic:prescriptionKindResearchPlan whose inquiryStatus
# is a non-terminal enactment position, grouped by inquiryTheme.

PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?inquiry ?theme ?status WHERE {
    ?inquiry a logic:Plan .
    ?inquiry logic:prescriptionKind logic:prescriptionKindResearchPlan .
    ?inquiry gmeow:inquiryStatus ?status .
    ?inquiry gmeow:inquiryTheme ?theme .
    FILTER(?status IN (logic:EnactmentPending, logic:EnactmentRunning))
}
ORDER BY ?theme ?status
