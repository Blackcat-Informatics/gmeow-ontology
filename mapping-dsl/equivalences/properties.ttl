# Term equivalences for the properties domain — GMEOW authoring source.
# Compiled to mappings/gmeow-properties.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetProperties a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/properties" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Canonical GMEOW property alignments. equivalentProperty for same-typed synonyms; skos:closeMatch for cross-type/fuzzy links." .

gmeow:eqProperties001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:name ;
    gmeow:alignPredicate owl:equivalentProperty ;
    gmeow:alignObject schema:name ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:sssomFile "gmeow-properties.sssom.tsv" .

gmeow:eqProperties002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:name ;
    gmeow:alignPredicate owl:equivalentProperty ;
