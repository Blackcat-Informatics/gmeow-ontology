#
# Declarative competency questions authored as slice-resident test-DSL data,
# executed by the native Rust slice-test harness (crates/slicetest, #784).
# Two exemplars, both fully-enumerated SELECTs (gmeow:cqExpectRow + gmeow:cqExactRows
# true): "what kinds of agent?" and "what contribution roles?". Expected rows were
# MEASURED by running each query over the merged ontology graph closed under OWL 2
# RL (the same reasoned-graph harness tests/test_competency.py uses), so the
# answers are entailed, not asserted.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/epistemics/tests/> .

# --- A. Small, fully-enumerated SELECT: "what kinds of agent?" ----------------
# queries/competency/agents.rq projects ?agentKind = rdfs:subClassOf* gmeow:Agent.
# Reasoned-graph result is the complete six-member set below, so cqExactRows true.
ex:cqAgentKinds a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/agents.rq" ;
    gmeow:cqRationale "GMEOW must be able to answer 'what kinds of agent does it model?'. The reasoned answer is the complete reflexive-transitive subclass closure of gmeow:Agent: Agent itself plus Builder, Organization, Person, Sensor, and SoftwareAgent." ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow
        ex:cqAgentRowAgent ,
        ex:cqAgentRowBuilder ,
        ex:cqAgentRowOrganization ,
        ex:cqAgentRowPerson ,
        ex:cqAgentRowSensor ,
        ex:cqAgentRowSoftwareAgent .

ex:cqAgentRowAgent a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ;
        gmeow:cellVar "agentKind" ;
        gmeow:cellValueIri gmeow:Agent ] .

ex:cqAgentRowBuilder a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ;
        gmeow:cellVar "agentKind" ;
        gmeow:cellValueIri gmeow:Builder ] .

ex:cqAgentRowOrganization a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ;
        gmeow:cellVar "agentKind" ;
        gmeow:cellValueIri gmeow:Organization ] .

ex:cqAgentRowPerson a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ;
        gmeow:cellVar "agentKind" ;
        gmeow:cellValueIri gmeow:Person ] .

ex:cqAgentRowSensor a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ;
        gmeow:cellVar "agentKind" ;
        gmeow:cellValueIri gmeow:Sensor ] .

ex:cqAgentRowSoftwareAgent a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ;
        gmeow:cellVar "agentKind" ;
        gmeow:cellValueIri gmeow:SoftwareAgent ] .

# --- B. Fully-enumerated SELECT: "what contribution roles?" -------------------
# queries/competency/contribution-roles.rq projects ?role a gmeow:ContributionRole.
# T3 (#784) finishes the enumeration the T2 escape hatch deferred: all 48
# gmeow:ContributionRole individuals (the CRediT canon plus GMEOW's domain
# extensions), MEASURED over the reasoned graph, with cqExactRows true.
ex:cqContributionRoles a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/contribution-roles.rq" ;
    gmeow:cqRationale "GMEOW must enumerate the contribution roles it supports (the CRediT canon plus GMEOW's domain extensions). The reasoned graph returns exactly 48 gmeow:ContributionRole individuals; T3 enumerates every one (cqExactRows true), replacing the T2 coarse-count escape hatch." ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow
        ex:cqRoleRowAIAssistant,
        ex:cqRoleRowArranger,
        ex:cqRoleRowAuthor,
        ex:cqRoleRowBotContributor,
        ex:cqRoleRowCodeReviewer,
        ex:cqRoleRowComposer,
        ex:cqRoleRowConceptualization,
        ex:cqRoleRowConductor,
        ex:cqRoleRowCoverArtist,
        ex:cqRoleRowDataCuration,
        ex:cqRoleRowDirector,
        ex:cqRoleRowEditor,
        ex:cqRoleRowFormalAnalysis,
        ex:cqRoleRowFundingAcquisition,
        ex:cqRoleRowIllustrator,
        ex:cqRoleRowInventor,
        ex:cqRoleRowInvestigation,
        ex:cqRoleRowLetterer,
        ex:cqRoleRowLibrettist,
        ex:cqRoleRowLLMAssistedEditor,
        ex:cqRoleRowLyricist,
        ex:cqRoleRowMasteringEngineer,
        ex:cqRoleRowMethodology,
        ex:cqRoleRowMixingEngineer,
        ex:cqRoleRowNarrator,
        ex:cqRoleRowOrchestrator,
        ex:cqRoleRowPerformer,
        ex:cqRoleRowPhotographer,
        ex:cqRoleRowProducer,
        ex:cqRoleRowProjectAdministration,
        ex:cqRoleRowPublisher,
        ex:cqRoleRowRecordingEngineer,
        ex:cqRoleRowReleaser,
        ex:cqRoleRowRemixer,
        ex:cqRoleRowResources,
        ex:cqRoleRowSamplingArtist,
        ex:cqRoleRowSecurityContact,
        ex:cqRoleRowSoftware,
        ex:cqRoleRowSoftwareDeveloper,
        ex:cqRoleRowSoftwareMaintainer,
        ex:cqRoleRowSongwriter,
        ex:cqRoleRowSoundDesigner,
        ex:cqRoleRowSupervision,
        ex:cqRoleRowTranslator,
        ex:cqRoleRowValidation,
        ex:cqRoleRowVisualization,
        ex:cqRoleRowWritingOriginalDraft,
        ex:cqRoleRowWritingReviewEditing .

ex:cqRoleRowAIAssistant a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ;
        gmeow:cellVar "role" ;
        gmeow:cellValueIri gmeow:roleAIAssistant ] .

ex:cqRoleRowArranger a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ;
        gmeow:cellVar "role" ;
        gmeow:cellValueIri gmeow:roleArranger ] .

