@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix lime:    <http://www.w3.org/ns/lemon/lime#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix wd:      <http://www.wikidata.org/entity/> .

# Term equivalences for the lexicon layer — GMEOW authoring source.
# Compiled to mappings/gmeow-lexicon.sssom.tsv by `gmeow compile-mappings`.
#
# The lexicon layer has rich directional projections in
# mapping-dsl/projections/ontolex.ttl (EDOAL + SPARQL CONSTRUCT). This file
# captures the 1:1 SSSOM term equivalences where a clean alignment exists.
# Domain-specific constructs (EtymologicalDerivation evidence graph,
# reconstructed-form standpoint claims, attestation-to-carrier links) are
# canonical — no maintained external vocabulary covers them faithfully.

gmeow:mapsetLexicon a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-lexicon.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/lexicon" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Lexicon alignments — OntoLex-Lemon, LIME, PROV-O, Wikidata.
    gmeow:LexicalItem and gmeow:LexicalForm are registry-independent, first-class
    information objects. The OntoLex alignment is by reference (Principle 5);
    GMEOW does not import OntoLex axioms. Reified constructs
    (UsageAttestation, EtymologicalDerivation) align to PROV-O at the entity/
    derivation level; the full relator structure is available only in the
    canonical model. Frequency (FrAC), morphological (Morph), and lexicographic
    (Lexicog) projections are staged in the projection layer.""" .

# --------------------------------------------------------------------------- #
# OntoLex-Lemon + LIME
# --------------------------------------------------------------------------- #

gmeow:LexicalItem skos:broadMatch ontolex:LexicalEntry {|
    gmeow:sssomFile "gmeow-lexicon.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW LexicalItem is broader than ontolex:LexicalEntry (covers morphemes, phrases, symbols, constructions, not just words), but the alignment is the closest surface term."
|} .

gmeow:LexicalForm skos:broadMatch ontolex:Form {|
    gmeow:sssomFile "gmeow-lexicon.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW LexicalForm is broader than ontolex:Form (covers spoken, signed, reconstructed, and rendered forms, not just written)."
|} .

gmeow:hasLexicalForm skos:closeMatch ontolex:lexicalForm {|
    gmeow:sssomFile "gmeow-lexicon.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:formRepresentation skos:closeMatch ontolex:writtenRep {|
    gmeow:sssomFile "gmeow-lexicon.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Lossy: ontolex:writtenRep covers only written forms; GMEOW formRepresentation also carries spoken (IPA), signed, reconstructed, and rendered forms."
|} .

gmeow:lexicalItemLanguage skos:closeMatch lime:language {|
    gmeow:sssomFile "gmeow-lexicon.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Both link a lexical entity to its language. GMEOW uses a first-class gmeow:Language IRI; LIME expects a language tag string."
|} .

# --------------------------------------------------------------------------- #
# PROV-O
# --------------------------------------------------------------------------- #

gmeow:UsageAttestation skos:closeMatch prov:Entity {|
    gmeow:sssomFile "gmeow-lexicon.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "A UsageAttestation is a provenance entity — information about observed use that can be attributed, derived, and versioned."
|} .

gmeow:EtymologicalDerivation skos:closeMatch prov:Derivation {|
    gmeow:sssomFile "gmeow-lexicon.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "An EtymologicalDerivation is a specialized provenance derivation with standpoint, confidence, and temporal scope. The full relator structure is lost in PROV-O projection."
|} .

gmeow:etymonSource skos:closeMatch prov:entity {|
    gmeow:sssomFile "gmeow-lexicon.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Structural difference: GMEOW models etymology via a reified EtymologicalDerivation relator (Derivation --etymonSource--> SourceItem), while PROV-O uses a direct binary property (DerivedItem --wasDerivedFrom--> SourceItem). Aligning etymonSource to prov:entity preserves the relator-level linkage to the source entity within the PROV-O Derivation structure, though the reified relator itself and its provenance metadata are lost in projection."
|} .

# --------------------------------------------------------------------------- #
# Wikidata
# --------------------------------------------------------------------------- #

gmeow:LexicalItem skos:closeMatch wd:Q181970 {|
    gmeow:sssomFile "gmeow-lexicon.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata 'lexeme' (Q181970) — a lexical item in a language, broader than a word."
|} .
