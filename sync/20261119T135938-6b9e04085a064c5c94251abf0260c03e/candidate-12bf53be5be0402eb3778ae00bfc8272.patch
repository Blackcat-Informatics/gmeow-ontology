+/// Check that the promised graph owns the entire native dataset.
+pub(super) fn require_rooted_graph(
+    dataset: &purrdf::RdfDataset,
+    stage: &str,
+    graph_iri: &str,
+) -> gmeow_errors::Result<()> {
+    let invalid = |message| {
+        gmeow_errors::Diag::of_kind(crate::error::StageFailed {
+            stage: stage.to_owned(),
+            message,
+            cause: None,
+        })
+    };
