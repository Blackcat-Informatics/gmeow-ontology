@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/spdx> a align:Alignment ;
    rdfs:label "GMEOW → spdx (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "spdxLicenseId → spdx:licenseId"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:spdxLicenseId ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri spdx:licenseId ] ;
            align:relation "=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "spdxLicenseName → spdx:name"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:spdxLicenseName ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri spdx:name ] ;
            align:relation "=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "licenseText → spdx:licenseText"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:licenseText ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri spdx:licenseText ] ;
            align:relation "=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "License → spdx:License"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:License ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri spdx:License ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ],
        [ a align:Cell ;
            rdfs:label "isOsiApproved → spdx:isOsiApproved"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:isOsiApproved ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri spdx:isOsiApproved ] ;
            align:relation "=" ;
            edoal:measure 8.5e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "spdx" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
