# --- G3: strict-order coherence is enforced WITHIN one vantage only ---------- #
# Within a single gmeow:PreferenceProjection cell, gmeow:preferredOver must not
# be reflexive and must not carry both directions (asymmetry); cross-vantage
# cycles are the LEGAL obstruction, so this is scoped to one cell.
gmeow:VantageScopedStrictOrderConstraint
    a logic:Constraint ;
    rdfs:label "Vantage-scoped strict-order constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: within a single gmeow:PreferenceProjection cell, the cell's gmeow:PreferenceOrder must not carry a reversed pair of gmeow:PreferenceEdges — an edge (gmeow:edgeWinner a, gmeow:edgeLoser b) together with an edge (gmeow:edgeWinner b, gmeow:edgeLoser a) — where a self-loop (a = b) is the degenerate reflexive case (both edges collapse to one). The check is GENUINELY cell-scoped: both edges are reached through ?cell gmeow:projectionOrder ?order gmeow:orderEdge, so it fires ONLY when both sit under the SAME cell's order. Two DIFFERENT cells asserting opposite directions is the legal Principle-9 cross-vantage conflict (the H1 obstruction), NEVER a violation — this is why the check rides the cell-attributed reified gmeow:PreferenceEdge, not the bare candidate→candidate gmeow:preferredOver (which is uncell-scopeable and would wrongly reject that conflict globally, FLAG-1). A ∀→¬∃ formula, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:PreferenceProjection ;
    logic:severity "Violation" ;
    logic:message "Within a single gmeow:PreferenceProjection cell, the cell's order must be irreflexive and asymmetric: no reversed pair of gmeow:PreferenceEdges (a≻b and b≻a) — nor a self-loop (a≻a) — may sit under one cell's gmeow:PreferenceOrder (cross-vantage reversals across DIFFERENT cells remain the legal obstruction)." ;
    logic:integrity gmeow:vssForall .
gmeow:vssForall a logic:Formula ;
    rdfs:label "vssForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:VantageScopedStrictOrderConstraint (G3, within-cell strict-order coherence over reified gmeow:PreferenceEdges): binds ?this and requires ?this is a gmeow:PreferenceProjection → ¬[gmeow:vssBad]."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:vssImpl .
gmeow:vssImpl a logic:Formula ;
    rdfs:label "vssImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:VantageScopedStrictOrderConstraint (G3, within-cell strict-order coherence over reified gmeow:PreferenceEdges): when ?this is a gmeow:PreferenceProjection holds, requires ¬[∃?order,?e1,?e2,?a,?b. gmeow:vssBadBody]."@x-gmeow-english ; logic:antecedent gmeow:vssGuard ; logic:consequent gmeow:vssNoCycle .
gmeow:vssGuard a logic:Formula ;
    rdfs:label "vssGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:VantageScopedStrictOrderConstraint (G3, within-cell strict-order coherence over reified gmeow:PreferenceEdges): asserts ?this is a gmeow:PreferenceProjection."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:PreferenceProjection ] .
gmeow:vssNoCycle a logic:Formula ;
    rdfs:label "vssNoCycle (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The negation within gmeow:VantageScopedStrictOrderConstraint (G3, within-cell strict-order coherence over reified gmeow:PreferenceEdges): holds only when it is NOT the case that ∃?order,?e1,?e2,?a,?b. gmeow:projectionOrder(?this, ?order) ∧ gmeow:orderEdge(?order, ?e1) ∧ gmeow:orderEdge(?order, ?e2) ∧ gmeow:edgeWinner(?e1, ?a) ∧ gmeow:edgeLoser(?e1, ?b) ∧ gmeow:edgeWinner(?e2, ?b) ∧ gmeow:edgeLoser(?e2, ?a)."@x-gmeow-english ; logic:not gmeow:vssBad .
gmeow:vssBad a logic:Formula ;
    rdfs:label "vssBad (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:VantageScopedStrictOrderConstraint (G3, within-cell strict-order coherence over reified gmeow:PreferenceEdges): quantifies ?order, ?e1, ?e2, ?a, ?b and requires gmeow:projectionOrder(?this, ?order) ∧ gmeow:orderEdge(?order, ?e1) ∧ gmeow:orderEdge(?order, ?e2) ∧ gmeow:edgeWinner(?e1, ?a) ∧ gmeow:edgeLoser(?e1, ?b) ∧ gmeow:edgeWinner(?e2, ?b) ∧ gmeow:edgeLoser(?e2, ?a)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "order" ] , [ logic:termIndex 1 ; logic:termVariable "e1" ] , [ logic:termIndex 2 ; logic:termVariable "e2" ] , [ logic:termIndex 3 ; logic:termVariable "a" ] , [ logic:termIndex 4 ; logic:termVariable "b" ] ;
    logic:exists gmeow:vssBadBody .
# Cell-scoped: BOTH edges are reached through ?this gmeow:projectionOrder ?order
# gmeow:orderEdge, so a reversed pair (a≻b ∧ b≻a) is a violation only WITHIN one cell's
# order. A self-loop (a = b, e1 = e2) is the degenerate reflexive case, caught by the
# same body. A cross-vantage reversal across two DIFFERENT cells never matches (their
# edges hang under different ?order nodes) — that is the legal Principle-9 obstruction.
gmeow:vssBadBody a logic:Formula ;
    rdfs:label "vssBadBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:VantageScopedStrictOrderConstraint (G3, within-cell strict-order coherence over reified gmeow:PreferenceEdges): conjoins gmeow:projectionOrder(?this, ?order) ∧ gmeow:orderEdge(?order, ?e1) ∧ gmeow:orderEdge(?order, ?e2) ∧ gmeow:edgeWinner(?e1, ?a) ∧ gmeow:edgeLoser(?e1, ?b) ∧ gmeow:edgeWinner(?e2, ?b) ∧ gmeow:edgeLoser(?e2, ?a)."@x-gmeow-english ; logic:and gmeow:vssOrder , gmeow:vssE1 , gmeow:vssE2 , gmeow:vssE1Win , gmeow:vssE1Lose , gmeow:vssE2Win , gmeow:vssE2Lose .
