    lang:inSignSystem gmeow:gmnModelNotation ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:gmnDenMathPi
    a lang:Denotation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "denotation of GMN pi"@x-gmeow-english ;
    skos:definition "The executable scoped meaning assignment from the GMN π form to the exact constant math:pi."@x-gmeow-english ;
    lang:denotedForm gmeow:gmnFormMathPi ;
