@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/coverage/> .

ex:sheaf a math:CellularSheaf ;
    math:sheafBaseComplex ex:base ;
    math:hasStalk ex:vertexStalk .
ex:base a math:CellComplex .
ex:vertexStalk a math:SheafStalk ; math:stalkOverCell ex:vertex .
ex:vertex a math:MathematicalObject .
