#
# Counter-example for math:FlagshipScenarioShape: a math:FlagshipScenario that declares
# its worked example, its competency question, and its counter-example but OMITS
# math:enforcesFailureClass (sh:minCount 1), so validation MUST emit
# shacl.MinCountConstraintComponent (and no other finding). The other three links are
# present so ONLY the missing-enforcing-failure-class violation fires, isolating it —
# an acceptance scenario whose gate raises no named failure is unwired
# (math:UnwiredFlagshipScenario).
# Bound by tests/example-conformance.ttl (ex:ecFlagshipUnwired).
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:unwiredScenario a math:FlagshipScenario ;
    math:demonstratedByExample "examples/e8-symmetry.ttl" ;
    math:demonstratedByCompetency <https://blackcatinformatics.ca/gmeow/examples/math/tests/cqE8RootSystem> ;
    math:guardedByCounterExample "tests/counter-examples/e8-wrong-weyl-order.ttl" .
