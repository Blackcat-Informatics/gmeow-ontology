msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldFinalConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Query score final-fold constraint"
msgstr "Contrainte de fin du repli des scores"

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldFinalConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "The final step belongs to the fold, equals the score total, and bounds every retained step index."
msgstr "L’étape finale appartient au repli, égale le total du score et borne chaque indice conservé."

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldFinalConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for query score final-fold constraint with explicit source bindings."
msgstr "Utiliser pour décrire contrainte de fin du repli des scores avec des liens source explicites."

msgctxt "https://blackcatinformatics.ca/gmeow/ScoreFoldFinalConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, authorization or completeness from a declaration alone."
msgstr "Éviter de déduire exécution, autorisation ou exhaustivité de la seule déclaration."

