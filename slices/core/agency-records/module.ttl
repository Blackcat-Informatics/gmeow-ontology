# Configured descriptor fields are mandatory, without manufacturing source values.
gmeow:ConditionVerifier logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:verifierKey ; logic:allValuesFrom [ a rdfs:Datatype ; logic:unionOf ( xsd:string xsd:token ) ] ],
    [ a logic:Restriction ; logic:onProperty gmeow:conditionVerifierKind ; logic:allValuesFrom gmeow:VerifierKind ] .

[ a logic:ClosureEntry ; logic:onClass gmeow:ConditionVerifier ; logic:closureKey "https://blackcatinformatics.ca/gmeow/verifierKey" ; logic:closureValue logic:ClosedWorldClosure ] .

[ a logic:ClosureEntry ; logic:onClass gmeow:ConditionVerifier ; logic:closureKey "https://blackcatinformatics.ca/gmeow/conditionVerifierKind" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:GoalConditionOccurrenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Goal condition occurrence constraint"@x-gmeow-english ;
    skos:definition "Each linked condition occurrence retains its source prose, exact local key, zero-based ordinal and a configured verifier of the same goal with that exact key; no executable goal expression is manufactured."@x-gmeow-english ;
    gmeow:useWhen "Use to enforce the source-evidence obligation of hasSatisfactionCondition."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid satisfying this law with invented source values or fallback prose."@x-gmeow-english ;
    gmeow:howToUse "Retain the actual source bindings expressed by this canonical formula."@x-gmeow-english ;
    skos:scopeNote "This law constrains supplied records; it neither runs a verifier nor authenticates an external source."@x-gmeow-english ;
    skos:example "gmeow:GoalConditionOccurrenceConstraint logic:formalizes gmeow:hasSatisfactionCondition ."@x-gmeow-english ;
    logic:formalizes gmeow:hasSatisfactionCondition ;
    logic:message "Each linked condition occurrence retains its source prose, exact local key, zero-based ordinal and a configured verifier of the same goal with that exact key; no executable goal expression is manufactured."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "condition" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:relation gmeow:hasSatisfactionCondition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "condition" ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "key" ], [ logic:termIndex 1 ; logic:termVariable "ordinal" ], [ logic:termIndex 2 ; logic:termVariable "text" ], [ logic:termIndex 3 ; logic:termVariable "verifier" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:verifierKey ; logic:argument [ logic:termIndex 0 ; logic:termVariable "condition" ], [ logic:termIndex 1 ; logic:termVariable "key" ] ], [ a logic:Formula ; logic:relation gmeow:entryOrdinal ; logic:argument [ logic:termIndex 0 ; logic:termVariable "condition" ], [ logic:termIndex 1 ; logic:termVariable "ordinal" ] ], [ a logic:Formula ; logic:relation gmeow:conditionText ; logic:argument [ logic:termIndex 0 ; logic:termVariable "condition" ], [ logic:termIndex 1 ; logic:termVariable "text" ] ], [ a logic:Formula ; logic:relation gmeow:hasConditionVerifier ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "verifier" ] ], [ a logic:Formula ; logic:relation gmeow:verifierKey ; logic:argument [ logic:termIndex 0 ; logic:termVariable "verifier" ], [ logic:termIndex 1 ; logic:termVariable "key" ] ] ] ] ] ] .

