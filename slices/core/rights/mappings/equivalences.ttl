gmeow:eqRights011 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Permission ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject odrl:Permission ; gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ; gmeow:comment "permission rule class" ;
