+        || selected
+            .quads_for_pattern(
+                Some(quad.s),
+                Some(quad.p),
+                Some(quad.o),
+                GraphMatch::Default,
+            )
+            .next()
+            .is_none()
+    {
+        return false;
+    }
+    let type_predicates = [
+        store.term_id_by_iri(&logic_iri("instanceOf")),
+        store.term_id_by_iri(RDF_TYPE),
+    ];
+    let Some(finite_set) = store.term_id_by_iri(FINITE_SET) else {
+        return false;
