gmeow:eqWikidata054 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Group ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q874405 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:objectLabel "social group" ;
    gmeow:comment "Wikidata 'social group' is broader than GMEOW Group (which includes non-social collectives). Directional lossy projection." ;
