    skos:example "Each selected demand keeps its original raised-time evidence rather than an invented timestamp."@x-gmeow-english .

gmeow:recallScopeHolderLastOfPair
    a gmeow:RecallScope ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/recall-context> ;
