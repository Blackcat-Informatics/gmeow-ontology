@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix exif: <http://www.w3.org/2003/12/exif/ns#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crmdig: <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix iiif: <http://iiif.io/api/presentation/3#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# Image super-ontology alignments.
# Compiled to mappings/gmeow-images.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetImages a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/images" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Image super-ontology alignments — schema.org ImageObject, W3C Web Annotation, W3C EXIF Ontology, IIIF, CIDOC-CRM/CRMdig, and Wikidata. GMEOW models the structure natively and bridges by reference (Principle 5)." .

# --------------------------------------------------------------------------- #
# schema.org ImageObject
# --------------------------------------------------------------------------- #

gmeow:MediaObject skos:closeMatch schema:ImageObject {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "GMEOW MediaObject is broader than schema:ImageObject (it also covers audio and video); directional lossy projection."
|} .

gmeow:depicts skos:closeMatch schema:about {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "gmeow:depicts (⊑ gmeow:isAbout, domain MediaObject) projects to schema:about on schema:ImageObject. Lossy: context, audience, period dropped."
|} .

gmeow:pixelWidth skos:closeMatch schema:width {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Pixel width projects to schema:width (as QuantitativeValue or integer)."
|} .

gmeow:pixelHeight skos:closeMatch schema:height {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Pixel height projects to schema:height (as QuantitativeValue or integer)."
|} .

# --------------------------------------------------------------------------- #
# W3C Web Annotation — region selectors
# --------------------------------------------------------------------------- #

gmeow:ImageRegion skos:closeMatch oa:SpecificResource {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "An ImageRegion with a selector projects to an oa:SpecificResource. Lossy: regionLabel and scene-graph edges are dropped."
|} .

gmeow:RegionSelector skos:closeMatch oa:Selector {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "RegionSelector projects to oa:Selector. The selectorType determines the concrete selector subclass (FragmentSelector, SvgSelector, etc.)."
|} .

gmeow:selectorTypePixelRectangle skos:exactMatch oa:FragmentSelector {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Pixel rectangle projects to oa:FragmentSelector with xywh media fragment."
|} .

gmeow:selectorTypeSvgPath skos:exactMatch oa:SvgSelector {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "SVG path projects to oa:SvgSelector."
|} .

# --------------------------------------------------------------------------- #
# W3C EXIF Ontology — technical metadata
# --------------------------------------------------------------------------- #

gmeow:pixelWidth skos:closeMatch exif:width {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Pixel width projects to exif:width."
|} .

gmeow:pixelHeight skos:closeMatch exif:height {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Pixel height projects to exif:height."
|} .

gmeow:imageOrientation skos:closeMatch exif:orientation {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Image orientation projects to exif:orientation."
|} .

# --------------------------------------------------------------------------- #
# CIDOC-CRM / CRMdig — provenance
# --------------------------------------------------------------------------- #

gmeow:eventTypeImageCapture skos:closeMatch crm:E12_Production {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Image capture is a production event in CIDOC-CRM terms."
|} .

gmeow:eventTypeImageProcessing skos:closeMatch crm:E11_Modification {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Image processing aligns to CIDOC-CRM modification activity. Directional lossy projection."
|} .

# --------------------------------------------------------------------------- #
# Wikidata — hub bridging
# --------------------------------------------------------------------------- #

gmeow:ImageRegion skos:closeMatch wd:Q10884 {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Wikidata 'region' (Q10884) is broader than GMEOW ImageRegion; directional lossy projection."
|} .

gmeow:SceneGraphEdge skos:closeMatch wd:Q215032 {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata 'spatial relation' (Q215032) is the closest peer to SceneGraphEdge. Directional lossy projection."
|} .

# --------------------------------------------------------------------------- #
# schema.org — captureTime
# --------------------------------------------------------------------------- #

gmeow:captureTime skos:closeMatch schema:dateCreated {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "captureTime projects to schema:dateCreated. Lossy: provenance and confidence dropped."
|} .

# --------------------------------------------------------------------------- #
# IIIF Presentation API 3 — Canvas, Annotation, dimensions
# --------------------------------------------------------------------------- #

gmeow:MediaObject skos:closeMatch iiif:Canvas {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "GMEOW MediaObject projects to iiif:Canvas. Lossy: depicts, regions, rights, and capture metadata dropped."
|} .

gmeow:pixelWidth skos:closeMatch iiif:width {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Pixel width projects to iiif:width."
|} .

gmeow:pixelHeight skos:closeMatch iiif:height {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Pixel height projects to iiif:height."
|} .

gmeow:ImageRegion skos:closeMatch iiif:Annotation {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "ImageRegion projects to iiif:Annotation. Lossy: regionLabel and scene-graph edges dropped."
|} .

# --------------------------------------------------------------------------- #
# W3C EXIF Ontology — captureTime
# --------------------------------------------------------------------------- #

gmeow:captureTime skos:closeMatch exif:dateTime {|
    gmeow:sssomFile "gmeow-images.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "captureTime projects to exif:dateTime. Lossy: provenance and confidence dropped."
|} .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:hasExifTag skos:closeMatch schema:exifData {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "reified EXIF tags → schema:exifData PropertyValues (lossless)"
|} .

gmeow:hasLogo skos:closeMatch schema:logo {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "an entity's emblematic media object → schema:logo (follow-through)"
|} .

gmeow:hasLogo skos:closeMatch foaf:logo {|
    gmeow:sssomFile "gmeow-properties.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "an entity's emblematic media object → foaf:logo (follow-through)"
|} .
