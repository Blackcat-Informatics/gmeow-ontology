#
# Declarative structural assertions for the lifecycle slice — the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_lifecycle.py. Each assertion runs as a
# SPARQL ASK over the lifecycle module graph (gmeow:scopeModule) under the
# native Rust harness (crates/slicetest).
#
# Lifecycle is migrated, so class stereotypes are logic:
# (logic:Situation), not gufo:.
#
# The cross-slice gUFO/EventType invariants, the whole-merged-graph negative
# sweeps, and the SHACL fixture-conformance + ABox checks now live natively in
# crates/validate/tests/conformance_cases/conformance_lifecycle.rs
# (supersession_properties_are_object_properties,
# lifecycle_event_types_are_individuals_not_classes,
# no_lifecycle_event_subclasses_exist, no_preferred_or_primary_lifecycle_term via
# GraphStore::ontology(); the entity-existence + contested/coverage conform cases
# with GraphStore ABox twins).
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/lifecycle/tests/> .

# --- 1. EntityExistence is a logic:Situation subclass of TimeScopedRelation (MUST) ---
ex:saEntityExistenceIsSituationType a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:EntityExistence a owl:Class , logic:Situation ;
        rdfs:subClassOf gmeow:TimeScopedRelation .
}""" ;
    gmeow:saRationale "gmeow:EntityExistence MUST be an owl:Class typed logic:Situation and a subclass of gmeow:TimeScopedRelation — the reified existence record is a situation bounded by a temporal scope, the universal contested-claim pattern." .

# --- 2. Flat lifecycle properties are owl:ObjectProperty with domain Entity (MUST) ---
ex:saFlatLifecyclePropertiesAreObjectProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasCreationEvent a owl:ObjectProperty ;
        rdfs:domain gmeow:Entity .
    gmeow:hasDestructionEvent a owl:ObjectProperty ;
        rdfs:domain gmeow:Entity .
    gmeow:existenceInterval a owl:ObjectProperty ;
        rdfs:domain gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:hasCreationEvent, hasDestructionEvent, and existenceInterval MUST each be an owl:ObjectProperty with rdfs:domain gmeow:Entity — the flat-first pattern attaches lifecycle facts directly to any entity without reification." .

# --- 3. Reified EntityExistence has its constituent object properties (MUST) ---
ex:saReifiedEntityExistenceProperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:EntityExistence a owl:Class .
    gmeow:existenceEntity a owl:ObjectProperty .
    gmeow:existenceCreationEvent a owl:ObjectProperty .
    gmeow:existenceDestructionEvent a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:EntityExistence MUST be an owl:Class and gmeow:existenceEntity, existenceCreationEvent, existenceDestructionEvent MUST each be owl:ObjectProperty — together they form the reified situation slot set required by SHACL." .

# --- 4. EntityExistence carries a someValuesFrom mediation axiom on existenceEntity (MUST) ---
ex:saEntityExistenceMediationAxiom a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:EntityExistence rdfs:subClassOf [
        owl:onProperty gmeow:existenceEntity ;
        owl:someValuesFrom gmeow:Entity
    ] .
}""" ;
    gmeow:saRationale "gmeow:EntityExistence MUST carry an open-world EL someValuesFrom restriction on gmeow:existenceEntity to gmeow:Entity — the situation binds exactly one entity and the someValuesFrom axiom is the relator-mediation gate that makes it visible to reasoners and generators." .

# --- 5. supersededBy is a directed owl:ObjectProperty with domain+range Entity (MUST) ---
ex:saSupersededByIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:supersededBy a owl:ObjectProperty ;
        rdfs:domain gmeow:Entity ;
        rdfs:range gmeow:Entity ;
        owl:inverseOf gmeow:supersedes .
}""" ;
    gmeow:saRationale "gmeow:supersededBy MUST be an owl:ObjectProperty with domain and range gmeow:Entity and declare owl:inverseOf gmeow:supersedes — it is directional (predecessor→successor) and non-symmetric; the superseded entity is retained, never deleted (Principle 10)." .
