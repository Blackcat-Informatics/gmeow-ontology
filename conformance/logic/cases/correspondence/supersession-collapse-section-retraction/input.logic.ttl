#
# Conformance case: correspondence/supersession-collapse-section-retraction
# AC: the lang:-graft FormalLanguage → formalLanguageKind collapse reaches the
#     section/retraction rung — the round-trip + mnemomorphism gates PASS on the
#     canonical IR (the two lang:SignSystemKind individuals bijectively recover the
#     two-way distinction, so put ∘ get = id). Mirrors the machine-checked
#     correspondence the logic-compile stage enforces over imports/supersession-
#     correspondences.ttl; a permanent regression fixture for the enforcement.

@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex: <https://gmeow.example/corr/> .

ex:collapse a logic:Correspondence ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:SectionRetraction ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "true"^^xsd:boolean ;
    logic:getLeg ex:collapseGet ;
    logic:recoveryCase ex:collapseRecovery .

# The get leg consumes the source type relation exercised by the recovery case;
# the retraction (put) is its structural inverse.
ex:collapseGet gmeow:path rdf:type .

# The complete source query class is executed, not inferred from the mechanically derived
# path inverse: the distinct kind value is what permits exact recovery of FormalLanguage.
ex:collapseRecovery a logic:RecoveryCase ;
    logic:recoveryTransform ex:collapseRecoveryFormula .
ex:collapseRecoveryFormula a logic:Formula ;
    logic:quantifiedVariable [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ;
    logic:forall [ a logic:Formula ;
        logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri gmeow:FormalLanguage ] ] ;
        logic:consequent [ a logic:Formula ; logic:relation lang:signSystemKind ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri lang:formalLanguageKind ] ]
    ] .
