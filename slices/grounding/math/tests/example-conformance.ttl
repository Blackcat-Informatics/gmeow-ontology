ex:ecDerivedDimensionStructured a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/derived-dimension-structured.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:DerivedDimension declaring math:baseDimensionExponent cells that raise base dimensions to exact-rational powers satisfies math:DerivedDimensionShape and math:DimensionExponentShape and validates with no findings." .

ex:ecDerivedDimensionNoExponents a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/derived-dimension-no-exponents.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example declares no math:baseDimensionExponent on a math:DerivedDimension (sh:minCount 1 on math:DerivedDimensionShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:MalformedDimension)." .

# === Rule 20: an exponent cell raises a base dimension only ================= #

ex:ecDimensionNonBaseExponent a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/dimension-nonbase-exponent.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.ClassConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example points math:exponentOfDimension at a non-base dimension (sh:class math:BaseDimension on math:DimensionExponentShape), so validation MUST emit shacl.ClassConstraintComponent and NO other finding (math:MalformedDimension)." .

ex:ecDimensionZeroDenominator a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/dimension-zero-denominator.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.NotConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example declares math:exponentDenominator 0 on a math:DimensionExponent (sh:not [ sh:hasValue 0 ] on math:DimensionExponentShape), so validation MUST emit shacl.NotConstraintComponent and NO other finding. A zero denominator is not an exact-rational power; the native zero-denominator scan is the whole-bundle twin (exercised by the in-crate lint tests), so the cell is never silently dropped." .

# === Rule 21: a dimensional expression combines at least two operands ====== #

ex:ecDimensionalExpressionSingleton a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/dimensional-expression-singleton.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example carries only one math:homogeneousOperand on a math:DimensionalExpression (sh:minCount 2 on math:DimensionalExpressionShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:MalformedDimension)." .

# === Analysis & geometry rules (ANALYSIS-AND-GEOMETRY charter) ============== #

# Binder AST: an argument slot and a scoped variable occurrence are well-formed.
ex:ecBindingScoped a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/binding-expression-scoped.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:BindingExpression with a bound math:VariableDeclaration, an indexed math:ArgumentSlot, and a math:VariableOccurrence resolving to the declaration satisfies math:BindingExpressionShape, math:ArgumentSlotShape, and math:VariableOccurrenceShape and validates with no findings." .

ex:ecSlotIndexDuplicate a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/slot-index-duplicate.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.SPARQLConstraintComponent" ;
    gmeow:conformanceRationale "Two math:argumentSlot cells of one binder share math:slotIndex 0 (the SPARQL constraint of math:SlotIndexUniquenessShape), so validation MUST emit shacl.SPARQLConstraintComponent and NO other finding (math:MalformedArgumentSlot)." .

ex:ecVariableUnscoped a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/variable-occurrence-unscoped.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example omits math:declaredVariable on a math:VariableOccurrence (sh:minCount 1 on math:VariableOccurrenceShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:UnscopedVariableOccurrence)." .

ex:ecMalformedBindingExpression a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/malformed-binding-expression.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
