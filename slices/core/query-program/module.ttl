    skos:example "Every declared dependency of a graph node has a classified edge inside the same graph. Example declaration: gmeow:QueryDependencyEdgeConstraint rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ."@x-gmeow-english  ;
    logic:formalizes gmeow:QueryProgramGraph ;
    logic:message "Every declared dependency of a graph node has a classified edge inside the same graph." ;
    logic:integrity
[
    a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "g" ] ,
    [ logic:termIndex 1 ; logic:termVariable "c" ] ,
    [ logic:termIndex 2 ; logic:termVariable "p" ] ;
    logic:forall [
        a logic:Formula ;
        logic:antecedent [
            a logic:Formula ;
            logic:and [
                a logic:Formula ;
                logic:relation gmeow:queryGraphNode ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] ,
                [ logic:termIndex 1 ; logic:termVariable "c" ]
            ] ,
            [
                a logic:Formula ;
                logic:relation logic:dataflowConsumes ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] ,
                [ logic:termIndex 1 ; logic:termVariable "p" ]
            ]
        ] ;
        logic:consequent [
            a logic:Formula ;
            logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "e" ] ;
            logic:exists [
                a logic:Formula ;
                logic:and [
                    a logic:Formula ;
                    logic:relation gmeow:queryGraphEdge ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] ,
                    [ logic:termIndex 1 ; logic:termVariable "e" ]
                ] ,
                [
                    a logic:Formula ;
                    logic:relation logic:flowFrom ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "e" ] ,
                    [ logic:termIndex 1 ; logic:termVariable "p" ]
                ] ,
                [
                    a logic:Formula ;
                    logic:relation logic:flowTo ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "e" ] ,
                    [ logic:termIndex 1 ; logic:termVariable "c" ]
                ]
            ]
        ]
    ]
] .

gmeow:QueryEdgeClassificationConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query edge classification constraint"@x-gmeow-english ;
    skos:definition "A graph edge has exactly one boolean monotonicity classification."@x-gmeow-english ;
    gmeow:useWhen "Use for query edge classification constraint with explicit source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, authorization or completeness from a declaration alone."@x-gmeow-english ;
    gmeow:howToUse "Retain the selected graph, identities and source evidence; apply the canonical obligations in this module."@x-gmeow-english ;
    skos:example "A graph edge has exactly one boolean monotonicity classification. Example declaration: gmeow:QueryEdgeClassificationConstraint rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ."@x-gmeow-english  ;
    logic:formalizes gmeow:QueryProgramGraph ;
    logic:message "A graph edge has exactly one boolean monotonicity classification." ;
    logic:integrity
[
    a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "g" ] ,
    [ logic:termIndex 1 ; logic:termVariable "e" ] ;
    logic:forall [
        a logic:Formula ;
        logic:antecedent [
            a logic:Formula ;
            logic:relation gmeow:queryGraphEdge ;
            logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] ,
            [ logic:termIndex 1 ; logic:termVariable "e" ]
        ] ;
        logic:consequent [
            a logic:Formula ;
            logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "m" ] ;
            logic:exists [
                a logic:Formula ;
                logic:and [
                    a logic:Formula ;
                    logic:relation gmeow:queryEdgeMonotone ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "e" ] ,
                    [ logic:termIndex 1 ; logic:termVariable "m" ]
                ] ,
                [
                    a logic:Formula ;
                    logic:or [
                        a logic:Formula ;
                        logic:relation gmeow:queryEdgeMonotone ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "e" ] ,
                        [ logic:termIndex 1 ; logic:termLiteral "true"^^xsd:boolean ]
                    ] ,
                    [
                        a logic:Formula ;
                        logic:relation gmeow:queryEdgeMonotone ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "e" ] ,
                        [ logic:termIndex 1 ; logic:termLiteral "false"^^xsd:boolean ]
                    ]
                ] ,
                [
                    a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "other" ] ;
                    logic:forall [
                        a logic:Formula ;
                        logic:antecedent [
                            a logic:Formula ;
                            logic:relation gmeow:queryEdgeMonotone ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "e" ] ,
                            [ logic:termIndex 1 ; logic:termVariable "other" ]
                        ] ;
                        logic:consequent [
                            a logic:Formula ;
                            logic:relation logic:termEqual ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "m" ] ,
                            [ logic:termIndex 1 ; logic:termVariable "other" ]
                        ]
                    ]
                ]
            ]
        ]
    ]
] .

gmeow:QueryDependencyStrataConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query dependency strata constraint"@x-gmeow-english ;
