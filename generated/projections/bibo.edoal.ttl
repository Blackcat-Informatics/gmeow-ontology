@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/bibo>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:Article ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri bibo:AcademicArticle ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.85"^^xsd:double ;
        rdfs:label "Article → bibo:AcademicArticle"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Class ;
                edoal:uri gmeow:Patent ;
            ] ;
            align:entity2 [
                a edoal:Class ;
                edoal:uri bibo:Patent ;
            ] ;
            align:relation "=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "Patent → bibo:Patent"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:identifier ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri bibo:doi ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.9"^^xsd:double ;
            rdfs:label "DOI-shaped identifier → bibo:doi"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Property ;
                edoal:uri gmeow:identifier ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri bibo:identifier ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.85"^^xsd:double ;
            rdfs:label "non-DOI identifier → bibo:identifier"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "bibo" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → bibo (EDOAL)"@en .
