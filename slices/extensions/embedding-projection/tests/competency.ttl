#
# Declarative competency questions for the embedding-projection slice
# (crates/slicetest). Sixteen named CQs (CT1–CT11 + R1–R5), each an INDEPENDENT
# SPARQL check of the same invariant a logic:Constraint enforces — never the derived
# SHACL. Each violation-finder is authored as a FALSIFIABLE PAIR: the named cell runs
# the finder over a minimal Don't counter-example (tests/counter-examples/*.ttl) and
# expects the offending node, and a "*Clean" companion runs the SAME query over the
# passing worked scene (examples/purremb-bookshelf.ttl) expecting ZERO rows. The two
# "must be empty" CQs (CT2, CT11) invert the pairing (named cell empty over the scene,
# a "*Violation" companion catching a collision/legacy construct), and the three
# POSITIVE CQs (CT6, CT9, R3) pin the specific example rows. All cells run in the
# gmeow:reasoningNone lane: the overlay (gmeow:cqDataFile) is honoured only there, and
# every invariant here is decidable over the asserted graph (the gmeow:sensitivityRank
# total order and the supersession quartet are asserted facts, compared by SPARQL).

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/embedding-projection/> .
@prefix ce:    <https://blackcatinformatics.ca/gmeow/counter-examples/embedding-projection/> .
@prefix ep:    <https://blackcatinformatics.ca/gmeow/examples/embedding-projection/tests/> .

# =========================================================================== #
# Typed result shapes (logic:ResultShape). Cardinality matches each cell's tier #
# 1:1 (RowsExact ↔ cqExactRows true; RowsCount 0 ↔ cqExpectRowCount 0;          #
# RowsContains ↔ cqExactRows false).                                            #
# =========================================================================== #

ep:shapeProjExact a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "proj" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ep:shapeProjEmpty a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "proj" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ; logic:shapeRowCount 0 .

ep:shapeObsExact a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "obs" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ep:shapeObsEmpty a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "obs" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ; logic:shapeRowCount 0 .

ep:shapeVscExact a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "vsc" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ep:shapeVscEmpty a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "vsc" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ; logic:shapeRowCount 0 .

ep:shapeVtExact a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "vt" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ep:shapeVtEmpty a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "vt" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ; logic:shapeRowCount 0 .

ep:shapeIdxExact a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "idx" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ep:shapeIdxEmpty a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "idx" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ; logic:shapeRowCount 0 .

ep:shapeSpacePairExact a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "a" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
                         [ logic:columnVariable "b" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ep:shapeSpacePairEmpty a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "a" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
                         [ logic:columnVariable "b" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ; logic:shapeRowCount 0 .

ep:shapeProjPackContains a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "proj" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
                         [ logic:columnVariable "pack" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

ep:shapeProjPairContains a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "projA" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
                         [ logic:columnVariable "projB" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

ep:shapeRebuildExact a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "retired" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
                         [ logic:columnVariable "successor" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
                         [ logic:columnVariable "event" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ep:shapeLegacyExact a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "s" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ep:shapeLegacyEmpty a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "s" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ; logic:shapeRowCount 0 .

ep:shapeSurfaceExact a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "surface" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ep:shapeSurfaceEmpty a logic:ResultShape ;
    logic:declaresColumn [ logic:columnVariable "surface" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsCount ; logic:shapeRowCount 0 .

# =========================================================================== #
# CT1 — source-digest match (C1). Violation over the drift fixture; empty over  #
# the scene (every projection records its source's live digest).                #
# =========================================================================== #
ep:epCqSourceDigestMismatch a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/source-digest-mismatch.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-source-digest-mismatch.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "A projection whose recorded gmeow:projectionSourceDigest disagrees with its resolved source's gmeow:contentDigest is caught: exactly ce:driftProj." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:driftProj ] ] .

ep:epCqSourceDigestMismatchClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/source-digest-mismatch.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjEmpty ;
    gmeow:cqRationale "Over the worked scene no projection's recorded source digest drifts from its source — zero rows." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT1 — source-digest present (C8). Violation over a projection whose source     #
# carries NO gmeow:contentDigest; empty over the scene (ex:bookshelfPack has a    #
# content digest). Closes C1's vacuous-pass hole: a digest-less source leaves     #
# gmeow:SourceDigestMatchConstraint's guard unsatisfiable.                        #
# =========================================================================== #
ep:epCqSourceDigestAbsent a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/source-digest-absent.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-source-digest-absent.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "A projection whose resolved gmeow:projectionSource carries no gmeow:contentDigest is caught: exactly ce:absentProj — the byte identity C1 compares against is absent, so C1 would pass vacuously." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:absentProj ] ] .

ep:epCqSourceDigestAbsentClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/source-digest-absent.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjEmpty ;
    gmeow:cqRationale "Over the worked scene every projection's source (ex:bookshelfPack) carries a gmeow:contentDigest — zero digest-less sources." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT2 — distinct vector-space identity. EMPTY over the scene (the full space and #
# its Matryoshka prefix over one family carry DIFFERENT digests); a companion    #
# collision fixture makes it non-empty.                                          #
# =========================================================================== #
ep:epCqDistinctVectorSpaceId a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/distinct-vector-space-id.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeSpacePairEmpty ;
    gmeow:cqRationale "No two vector-space contracts that differ in a component share a digest — the full ex:vscA and the 256-d prefix ex:vscAprefix over ex:familyA carry distinct digests. Zero rows." ;
    gmeow:cqExpectRowCount 0 .

ep:epCqDistinctVectorSpaceIdViolation a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/distinct-vector-space-id.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-distinct-vector-space-id.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeSpacePairExact ;
    gmeow:cqRationale "A full space and its Matryoshka prefix (differing dimensions/policy) that COLLIDE on one content digest are caught: the pair (ce:collideFull, ce:collidePrefix)." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "a" ; gmeow:cellValueIri ce:collideFull ] ,
                                     [ gmeow:cellVar "b" ; gmeow:cellValueIri ce:collidePrefix ] ] .

# CT2 (family axis) — distinct family identity over the generation contract. EMPTY
# over the scene (each family carries its own digest); a companion collision fixture
# differing only in gmeow:executionContract makes it non-empty, so the execution /
# subject-projection / generation-normalization axes are identity-bearing.
ep:epCqDistinctFamilyId a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/distinct-family-id.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeSpacePairEmpty ;
    gmeow:cqRationale "No two embedding families that differ in a generation-contract component share a digest over the worked scene — each family carries a distinct content digest. Zero rows." ;
    gmeow:cqExpectRowCount 0 .

ep:epCqDistinctFamilyIdViolation a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/distinct-family-id.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-distinct-family-id.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeSpacePairExact ;
    gmeow:cqRationale "Two families differing only in gmeow:executionContract (a material generation-contract component) that COLLIDE on one content digest are caught: the pair (ce:famCollideA, ce:famCollideB)." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "a" ; gmeow:cellValueIri ce:famCollideA ] ,
                                     [ gmeow:cellVar "b" ; gmeow:cellValueIri ce:famCollideB ] ] .

# =========================================================================== #
# CT3 — cross-space comparison rejected (C2). Violation over a cross-prefix      #
# observation with no bridging correspondence; empty over the scene.            #
# =========================================================================== #
ep:epCqCrossSpaceRejected a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/cross-space-rejected.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-cross-space-rejected.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeObsExact ;
    gmeow:cqRationale "A cross-PREFIX similarity observation whose two effective spaces have distinct digests and no justifying logic:Correspondence is caught: ce:crossPrefixObs." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "obs" ; gmeow:cellValueIri ce:crossPrefixObs ] ] .

ep:epCqCrossSpaceRejectedClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/cross-space-rejected.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeObsEmpty ;
    gmeow:cqRationale "The scene's cross-space ex:crossObs carries ex:crossCorr, and ex:inObs is within-space — zero unjustified cross-space observations." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT4 — target exact identity (C4). Violation over an ordinal-only target;       #
# empty over the scene (every target has a resource or a digest).               #
# =========================================================================== #
ep:epCqTargetExactIdentity a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/target-exact-identity.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-target-exact-identity.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeVtExact ;
    gmeow:cqRationale "A vector target with only a gmeow:targetOrdinal and no exact identity is caught: ce:orphanTarget." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "vt" ; gmeow:cellValueIri ce:orphanTarget ] ] .

ep:epCqTargetExactIdentityClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/target-exact-identity.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeVtEmpty ;
    gmeow:cqRationale "Every scene target carries a gmeow:targetsResource or its own gmeow:contentDigest — zero identity-less targets." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT4b — target-set ordered membership (C4b). Violation over a TargetSet member  #
# with no gmeow:targetOrdinal; empty over the scene (every member is ordinaled). #
# =========================================================================== #
ep:epCqTargetSetOrdered a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/targetset-unordered.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-targetset-unordered.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeVtExact ;
    gmeow:cqRationale "A gmeow:targetSetMember with no gmeow:targetOrdinal leaves the set's row order unreconstructable and is caught: ce:unorderedMember." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "vt" ; gmeow:cellValueIri ce:unorderedMember ] ] .

ep:epCqTargetSetOrderedClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/targetset-unordered.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeVtEmpty ;
    gmeow:cqRationale "Every member of the scene target set (ex:tgtDoc, ex:tgtChunk, ex:tgtStmt) carries a gmeow:targetOrdinal — zero unorderable members." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT5 — similarity is not equivalence. Non-empty over the overclaim             #
# counter-example (owl:sameAs / owl:equivalentClass); empty over the scene.     #
# =========================================================================== #
ep:epCqSimilarityNotEquivalence a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/similarity-not-equivalence.rq" ;
    gmeow:cqDataFile "tests/counter-examples/similarity-overclaim.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeObsExact ;
    gmeow:cqRationale "Similarity observations promoted to owl:sameAs and owl:equivalentClass are both caught: ce:obsOverSame and ce:obsOverEquiv." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "obs" ; gmeow:cellValueIri ce:obsOverSame ] ] ,
                      [ gmeow:rowCell [ gmeow:cellVar "obs" ; gmeow:cellValueIri ce:obsOverEquiv ] ] .

ep:epCqSimilarityNotEquivalenceClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/similarity-not-equivalence.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeObsEmpty ;
    gmeow:cqRationale "No scene similarity observation is promoted to a logical identity — zero rows." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT6 — generated, lossy projection over a stable source (POSITIVE). The scene's #
# projections are derived + lossy while ex:bookshelfPack keeps its own digest    #
# and head id.                                                                   #
# =========================================================================== #
ep:epCqGeneratedLossyStableSource a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/generated-lossy-stable-source.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjPackContains ;
    gmeow:cqRationale "Projections A and B are generated + lossy (source, space contract, reproducibility level) over ex:bookshelfPack, which retains its own gmeow:contentDigest and gmeow:gtsHeadId." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ex:bookshelfProjA ] ,
                                     [ gmeow:cellVar "pack" ; gmeow:cellValueIri ex:bookshelfPack ] ] ,
                      [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ex:bookshelfProjB ] ,
                                     [ gmeow:cellVar "pack" ; gmeow:cellValueIri ex:bookshelfPack ] ] .

# =========================================================================== #
# CT7 — security monotonicity (C3). Violation over a silently-declassified       #
# projection; empty over the scene (the internal view carries ex:declassAct).    #
# =========================================================================== #
ep:epCqSecurityMonotonic a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/security-monotonic.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-security-monotonic.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "A projection sitting below its source's sensitivity rank with no gmeow:DeclassificationAct is caught: ce:leakyProj." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:leakyProj ] ] .

ep:epCqSecurityMonotonicClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/security-monotonic.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjEmpty ;
    gmeow:cqRationale "The scene's lower-sensitivity ex:bookshelfProjPublic is authorized by ex:declassAct — zero unauthorized drops." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT7 — REVIEWABLE declassification (C3, strengthened). Violation over a         #
# projection dropped below its source by a BARE, unattributed act (no reviewing  #
# invocation, no authorizing agent); empty over the scene, whose ex:declassAct   #
# carries both gmeow:wasGeneratedBy and gmeow:wasAssociatedWith. Closes the       #
# disclosure-review hole: a bare declassifies edge never warrants the drop.      #
# =========================================================================== #
ep:epCqDeclassUnreviewed a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/declass-unreviewed.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-declass-unreviewed.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "A projection dropped below its source's sensitivity by a BARE gmeow:DeclassificationAct that names no reviewing invocation and no authorizing agent is caught: ce:leakyProj — the unattributed act is not reviewable." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:leakyProj ] ] .

ep:epCqDeclassUnreviewedClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/declass-unreviewed.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjEmpty ;
    gmeow:cqRationale "The scene's lower-sensitivity ex:bookshelfProjPublic is authorized by ex:declassAct, which carries BOTH gmeow:wasGeneratedBy (ex:declassReview) and gmeow:wasAssociatedWith (ex:disclosureReviewer) — the act is reviewable, so zero unreviewed drops." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT8 — derived index fully bound. Violation over an index missing               #
# gmeow:indexOverSpace; empty over the scene.                                    #
# =========================================================================== #
ep:epCqDerivedIndexBound a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/derived-index-bound.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-derived-index-bound.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeIdxExact ;
    gmeow:cqRationale "A derived index missing its gmeow:indexOverSpace binding is caught: ce:unboundIndex." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "idx" ; gmeow:cellValueIri ce:unboundIndex ] ] .

ep:epCqDerivedIndexBoundClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/derived-index-bound.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeIdxEmpty ;
    gmeow:cqRationale "Both scene indexes (ex:annIndexA, ex:annIndexA2) bind projection, recall, and effective space — zero under-bound indexes." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT9 — multiple vector spaces over one source (POSITIVE).                       #
# =========================================================================== #
ep:epCqMultiSpaceSameSource a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/multi-space-same-source.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjPairContains ;
    gmeow:cqRationale "Projections A and B share ex:bookshelfPack but commit distinct-digest space contracts (ex:vscA vs ex:vscB) — legitimately independent projections of one pack." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "projA" ; gmeow:cellValueIri ex:bookshelfProjA ] ,
                                     [ gmeow:cellVar "projB" ; gmeow:cellValueIri ex:bookshelfProjB ] ] .

# =========================================================================== #
# CT10 — container/manifest source-digest agreement (C5a). Violation over a      #
# split projection; empty over the scene.                                        #
# =========================================================================== #
ep:epCqManifestContainerDisagree a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/manifest-container-disagree.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-manifest-container-disagree.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "A projection whose container and manifest surfaces record different source-pack digests is caught: ce:splitProj." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:splitProj ] ] .

ep:epCqManifestContainerDisagreeClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/manifest-container-disagree.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjEmpty ;
    gmeow:cqRationale "The scene's ex:containerSurfaceA and ex:manifestSurfaceA record identical source digests — zero disagreements." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT10-robustness — every surface records all three digests individually. A      #
# surface omitting one silently dodges the agreement constraint for that digest  #
# (which only fires when BOTH surfaces carry it), so omission is itself invalid.  #
# Violation over the omitting fixture; empty over the scene.                      #
# =========================================================================== #
ep:epCqSurfaceDigestOmitted a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/surface-digest-omitted.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-surface-digest-omitted.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeSurfaceExact ;
    gmeow:cqRationale "A profile surface omitting a required shared-referent digest (here the manifest lacks gmeow:recordsTargetTableDigest) is caught: ce:omitManifest — it would otherwise dodge the container/manifest target-table agreement check by omission." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "surface" ; gmeow:cellValueIri ce:omitManifest ] ] .

ep:epCqSurfaceDigestOmittedClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/surface-digest-omitted.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeSurfaceEmpty ;
    gmeow:cqRationale "The scene's ex:containerSurfaceA and ex:manifestSurfaceA each record all three shared-referent digests — zero omitting surfaces." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# CT11 — RDF 1.2 only. EMPTY over the scene (rdf:Statement reification is         #
# permitted); a companion legacy-container fixture makes it non-empty.           #
# =========================================================================== #
ep:epCqRdf12Only a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/rdf12-only.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeLegacyEmpty ;
    gmeow:cqRationale "The scene uses only RDF 1.2 constructs (the statement target rides rdf:Statement reification, which is permitted) — zero banned legacy container constructs." ;
    gmeow:cqExpectRowCount 0 .

ep:epCqRdf12OnlyViolation a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/rdf12-only.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-rdf12-legacy.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeLegacyExact ;
    gmeow:cqRationale "A banned rdf:Bag with rdf:_N membership is caught: ce:legacyBag." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "s" ; gmeow:cellValueIri ce:legacyBag ] ] .

# =========================================================================== #
# R1 — GTS head-id propagation (C6). Violation over a dropped head id; empty     #
# over the scene.                                                                #
# =========================================================================== #
ep:epCqGtsHeadIdPropagation a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/gts-head-id-propagation.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-gts-head-id-propagation.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "A projection over a certified source that fails to propagate the matching gmeow:projectionSourceGtsHeadId is caught: ce:droppedHeadProj." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:droppedHeadProj ] ] .

ep:epCqGtsHeadIdPropagationClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/gts-head-id-propagation.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjEmpty ;
    gmeow:cqRationale "Every scene projection propagates ex:bookshelfPack's gmeow:gtsHeadId — zero dropped head ids." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# R2 — provenance retained on a copy. Violation over an orphaned copy; empty     #
# over the scene.                                                                #
# =========================================================================== #
ep:epCqProvenanceOnCopy a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/provenance-on-copy.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-provenance-on-copy.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "A derived copy that dropped its gmeow:hasDisclosurePolicy is caught: ce:orphanCopy." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:orphanCopy ] ] .

ep:epCqProvenanceOnCopyClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/provenance-on-copy.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjEmpty ;
    gmeow:cqRationale "The scene's derived copy ex:bookshelfProjACopy retains both sensitivity and disclosure policy — zero orphaned copies." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# R3 — rebuild as append-only supersession (POSITIVE).                           #
# =========================================================================== #
ep:epCqRebuildSupersession a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/rebuild-supersession.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeRebuildExact ;
    gmeow:cqRationale "The retired ex:annIndexA is superseded by ex:annIndexA2 through the transaction quartet while ex:retrievalEventOld stays bound to the retired index — suppression, not erasure." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "retired" ; gmeow:cellValueIri ex:annIndexA ] ,
                                     [ gmeow:cellVar "successor" ; gmeow:cellValueIri ex:annIndexA2 ] ,
                                     [ gmeow:cellVar "event" ; gmeow:cellValueIri ex:retrievalEventOld ] ] .

# =========================================================================== #
# R4 — within-tolerance reproducibility needs a tolerance. Violation over a       #
# tolerance-less projection; empty over the scene.                              #
# =========================================================================== #
ep:epCqQuantizationTolerance a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/quantization-tolerance.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-quantization-tolerance.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "A gmeow:reproducibleWithinTolerance projection with no gmeow:reproducibilityTolerance is caught: ce:noTolProj." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:noTolProj ] ] .

ep:epCqQuantizationToleranceClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/quantization-tolerance.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjEmpty ;
    gmeow:cqRationale "The scene's within-tolerance ex:bookshelfProjA carries ex:tol1 — zero uninterpretable tolerance claims." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# R5 — container/manifest agreement across ALL recorded digests. The named cell  #
# catches a TARGET-TABLE disagreement (which the CT10 source-only finder would   #
# miss); companions catch the source and model disagreements, and a clean cell   #
# stays empty over the scene.                                                    #
# =========================================================================== #
ep:epCqDisagreementAllSurfaces a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/disagreement-all-surfaces.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-disagreement-target.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "The generalized finder catches a TARGET-TABLE digest disagreement the source-only CT10 finder misses: ce:targetSplitProj." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:targetSplitProj ] ] .

ep:epCqDisagreementAllSurfacesSource a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/disagreement-all-surfaces.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-manifest-container-disagree.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "The generalized finder also catches the source-pack digest disagreement: ce:splitProj." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:splitProj ] ] .

ep:epCqDisagreementAllSurfacesModel a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/disagreement-all-surfaces.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-disagreement-model.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeProjExact ;
    gmeow:cqRationale "The generalized finder catches the model-contract digest disagreement: ce:modelSplitProj." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "proj" ; gmeow:cellValueIri ce:modelSplitProj ] ] .

ep:epCqDisagreementAllSurfacesClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/disagreement-all-surfaces.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeProjEmpty ;
    gmeow:cqRationale "The scene's container and manifest surfaces agree on all three recorded digests — zero disagreements." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# C7 — with-metric agreement. A gmeow:SimilarityObservation's gmeow:withMetric   #
# must equal its gmeow:overVectorSpace's gmeow:distanceMetric. EMPTY over the     #
# scene (every observation agrees with its space); a companion fixture whose      #
# observation reports cosine over a dot-product space makes it non-empty.         #
# =========================================================================== #
ep:epCqWithMetricAgreementClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/with-metric-agreement.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeObsEmpty ;
    gmeow:cqRationale "Every similarity observation in the scene reports the metric its overVectorSpace declares — no disagreement. Zero rows." ;
    gmeow:cqExpectRowCount 0 .

ep:epCqWithMetricAgreementViolation a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/with-metric-agreement.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-with-metric-disagree.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeObsExact ;
    gmeow:cqRationale "An observation reporting cosine over a dot-product space is caught: ce:disagreeObs." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "obs" ; gmeow:cellValueIri ce:disagreeObs ] ] .

# =========================================================================== #
# Similarity operands grounded to actual rows. A gmeow:similarityScore           #
# must name the EXACT two vector rows it scored (gmeow:comparesLeftTarget /       #
# gmeow:comparesRightTarget). Violation over a score-bearing observation with no  #
# operand rows; empty over the scene, whose ex:crossObs / ex:inObs each name both #
# operand rows. Live SPARQL twin of the operand requiredness (sh:minCount 1).     #
# =========================================================================== #
ep:epCqSimilarityOperandsMissing a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/similarity-operands.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-similarity-operands-missing.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeObsExact ;
    gmeow:cqRationale "A score-bearing gmeow:SimilarityObservation that names neither operand row (no gmeow:comparesLeftTarget, no gmeow:comparesRightTarget) is caught: ce:noOperandObs — its proximity is unattributable to a vector pair." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "obs" ; gmeow:cellValueIri ce:noOperandObs ] ] .

ep:epCqSimilarityOperandsMissingClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/similarity-operands.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeObsEmpty ;
    gmeow:cqRationale "Every scene similarity observation names BOTH operand rows — ex:crossObs binds ex:tgtChunk / ex:tgtDocB and ex:inObs binds ex:tgtDoc / ex:tgtChunk — zero ungrounded scores." ;
    gmeow:cqExpectRowCount 0 .

# =========================================================================== #
# Vector-space contract comparability core complete. An effective                #
# gmeow:VectorSpaceContract must NAME its full comparability core individually —   #
# gmeow:effectiveOfFamily, gmeow:embeddingDimensions, gmeow:distanceMetric, and    #
# gmeow:normalizationKind — not merely fold them into its digest. Violation over a  #
# contract omitting its metric; empty over the scene, whose ex:vscA / ex:vscAprefix #
# / ex:vscB each name all four. Live SPARQL twin of the core requiredness           #
# (sh:minCount 1 on each axis).                                                    #
# =========================================================================== #
ep:epCqVscIncomplete a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/vsc-incomplete.rq" ;
    gmeow:cqDataFile "tests/counter-examples/ce-vsc-incomplete.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ep:shapeVscExact ;
    gmeow:cqRationale "A gmeow:VectorSpaceContract that omits a required comparability-core axis (here gmeow:distanceMetric) is caught: ce:incompleteVsc — its space cannot decide whether two vectors are near or far." ;
    gmeow:cqExpectRow [ gmeow:rowCell [ gmeow:cellVar "vsc" ; gmeow:cellValueIri ce:incompleteVsc ] ] .

ep:epCqVscIncompleteClean a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/extensions/embedding-projection/queries/competency/vsc-incomplete.rq" ;
    gmeow:cqDataFile "examples/purremb-bookshelf.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqResultShape ep:shapeVscEmpty ;
    gmeow:cqRationale "Every scene effective space names all four comparability-core axes — ex:vscA, ex:vscAprefix, and ex:vscB each bind gmeow:effectiveOfFamily, gmeow:embeddingDimensions, gmeow:distanceMetric, and gmeow:normalizationKind — zero incomplete contracts." ;
    gmeow:cqExpectRowCount 0 .
