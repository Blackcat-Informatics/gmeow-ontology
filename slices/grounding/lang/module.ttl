    logic:formalizes lang:UnmarkedSurfaceTranslationShape ;
    logic:severity "Violation" ;
    logic:message "A surface-only translation source realizes no analyzed form yet is not typed lang:UnanalyzedProse." ;
    logic:integrity lang:ustSpForall .
lang:ustSpForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall lang:ustSpImpl .
lang:ustSpImpl a logic:Formula ; logic:antecedent lang:ustSpGuard ; logic:consequent lang:ustSpPhi .
lang:ustSpGuard a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri lang:TranslationUnit ] .
lang:ustSpPhi a logic:Formula ; logic:not lang:ustSpEx .
lang:ustSpEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "s" ] ;
    logic:exists lang:ustSpBody .
lang:ustSpBody a logic:Formula ; logic:and lang:ustSpSrc , lang:ustSpSurf , lang:ustSpNoReal , lang:ustSpNoProse .
lang:ustSpSrc a logic:Formula ; logic:relation lang:translationSource ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
lang:ustSpSurf a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s" ] , [ logic:termIndex 1 ; logic:termIri lang:SurfaceForm ] .
lang:ustSpNoReal a logic:Formula ; logic:not lang:ustSpRealEx .
lang:ustSpRealEx a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "rf" ] ;
    logic:exists lang:ustSpReal .
lang:ustSpReal a logic:Formula ; logic:relation lang:realizes ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s" ] , [ logic:termIndex 1 ; logic:termVariable "rf" ] .
lang:ustSpNoProse a logic:Formula ; logic:not lang:ustSpProse .
lang:ustSpProse a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "s" ] , [ logic:termIndex 1 ; logic:termIri lang:UnanalyzedProse ] .

