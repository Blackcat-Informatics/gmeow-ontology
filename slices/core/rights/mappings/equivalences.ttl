gmeow:copyrightStatusNotEvaluated skos:closeMatch <https://rightsstatements.org/vocab/CNE/1.0/> {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
