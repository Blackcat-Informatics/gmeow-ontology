      <termEntry id="c-eb7c0ed704fa4cea">
        <langSet xml:lang="en">
          <tig>
            <term>minimum cardinality</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>cardinalité minimale</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>最小基数</term>
          </tig>
        </langSet>
      </termEntry>
      <termEntry id="c-ebdd2eaeb4ff6e76">
        <langSet xml:lang="en">
          <tig>
            <term>Relates a surprisal to the single outcome whose declared probability under its distribution it takes the negative logarithm of. Domain math:Surprisal, range math:MathematicalObject (stated in prose).</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Relie une surprise informationnelle au résultat unique dont elle prend le logarithme négatif de la probabilité déclarée sous sa distribution. Domaine math:Surprisal, portée math:MathematicalObject (énoncé en prose).</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>将自信息量关联到其在分布下取已声明概率之负对数的单个结果。定义域 math:Surprisal，值域 math:MathematicalObject（以散文陈述）。</term>
          </tig>
        </langSet>
      </termEntry>
