@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:eventTypeAttempt
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "attempt"@x-gmeow-english ;
    skos:definition "An event of pursuing an intention, including work described only in prose. Its type does not assert an executable prescription or a goal achieved."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded attempt event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeAttempt alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeAttempt through eventType and retain the affected attempt or intention with its explicit context links."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeAttempt ."@x-gmeow-english .

gmeow:eventTypeAttemptStart
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "attempt start"@x-gmeow-english ;
    skos:definition "The recorded start of an attempt. It is a phase event within the attempt, not creation of a compiled enactment."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded attempt start event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeAttemptStart alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeAttemptStart through eventType and retain the affected attempt or intention with its explicit context links."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeAttemptStart ."@x-gmeow-english .

gmeow:eventTypeAttemptContinuation
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "attempt continuation"@x-gmeow-english ;
    skos:definition "A recorded continuation or checkpoint phase of an attempt. Its pause cause and resume point are separate from how the attempt ultimately stops."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded attempt continuation event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeAttemptContinuation alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeAttemptContinuation through eventType and retain the affected attempt or intention with its explicit context links."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeAttemptContinuation ."@x-gmeow-english .

gmeow:eventTypeAttemptFinish
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "attempt finish"@x-gmeow-english ;
    skos:definition "The recorded ending of an attempt, classified by attemptStop. Ending the attempt does not by itself establish goal satisfaction."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded attempt finish event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeAttemptFinish alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeAttemptFinish through eventType and retain the affected attempt or intention with its explicit context links."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeAttemptFinish ."@x-gmeow-english .

gmeow:eventTypeAttemptResumption
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "attempt resumption"@x-gmeow-english ;
    skos:definition "A planless attempt being resumed from a recorded resume point. It does not claim the prescription, input snapshot or journal identity required by an enactment resume."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded attempt resumption event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeAttemptResumption alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeAttemptResumption through eventType and retain the affected attempt or intention with its explicit context links."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeAttemptResumption ."@x-gmeow-english .

gmeow:eventTypeIntentionActive
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "intention active"@x-gmeow-english ;
    skos:definition "An intention was made, or made again, the intention being acted on while its holding tenure remains open."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded intention active event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeIntentionActive alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeIntentionActive through eventType and retain the affected attempt or intention with its explicit context links."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeIntentionActive ."@x-gmeow-english .

gmeow:eventTypeIntentionPaused
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "intention paused"@x-gmeow-english ;
    skos:definition "Pursuit of an intention was paused without abandonment. The pause itself does not close the holding tenure or imply an enactment state."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded intention paused event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeIntentionPaused alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeIntentionPaused through eventType and retain the affected attempt or intention with its explicit context links."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeIntentionPaused ."@x-gmeow-english .

gmeow:eventTypeIntentionSatisfied
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "intention satisfied"@x-gmeow-english ;
    skos:definition "An intention ended because its goal was judged met. The judgment belongs to a separate GoalEvaluation rather than the event kind."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded intention satisfied event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeIntentionSatisfied alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeIntentionSatisfied through eventType and retain the affected attempt or intention with its explicit context links."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeIntentionSatisfied ."@x-gmeow-english .

gmeow:eventTypeIntentionAbandoned
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "intention abandoned"@x-gmeow-english ;
    skos:definition "An intention was given up without its goal being judged met. This records withdrawal rather than erasing the intention."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded intention abandoned event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeIntentionAbandoned alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeIntentionAbandoned through eventType and retain the affected attempt or intention with its explicit context links."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeIntentionAbandoned ."@x-gmeow-english .

gmeow:eventTypeIntentionSuperseded
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "intention superseded"@x-gmeow-english ;
    skos:definition "An intention was replaced by another intention, identified separately by supersededBy. Replacement is not evidence of either goal’s satisfaction."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded intention superseded event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeIntentionSuperseded alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeIntentionSuperseded through eventType and retain the affected attempt or intention with its explicit context links."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeIntentionSuperseded ."@x-gmeow-english .

gmeow:eventTypeDecision
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "decision"@x-gmeow-english ;
    skos:definition "An agent settled on one course among the options it weighed, concluding deliberation. The choice may form an intention or decide to do nothing without a new commitment."@x-gmeow-english ;
    gmeow:useWhen "Use to classify a source-recorded decision event."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring an enactment or goal verdict from eventTypeDecision alone."@x-gmeow-english ;
    gmeow:howToUse "Attach eventTypeDecision through eventType; link an attempt or intention only when the source actually supplies that context."@x-gmeow-english ;
    skos:example "ex:event gmeow:eventType gmeow:eventTypeDecision ."@x-gmeow-english .

gmeow:learningInsight
    a gmeow:LearningEventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "insight"@x-gmeow-english ;
    skos:definition "A learning event in which an agent comes to understand a connection or pattern through its own reasoning or reflection, without a teacher or source being reported for that insight. It need not form a new category."@x-gmeow-english ;
    gmeow:useWhen "Use for a source-reported connection grasped through reflection."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring universal absence of influences or equating insight with concept formation."@x-gmeow-english ;
    gmeow:howToUse "Reference through learningType; retain other supported learning varieties and existing learner/process context."@x-gmeow-english ;
    skos:example "ex:insight gmeow:learningType gmeow:learningInsight ."@x-gmeow-english .

gmeow:AttemptStop
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Attempt Stop"@x-gmeow-english ;
    skos:definition "An open vocabulary describing how an attempt stopped, independently of progress toward its goal."@x-gmeow-english ;
    gmeow:useWhen "Use for the explicit attempt stop axis of an agency record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid subclassing AttemptStop to add a value or deriving it from missing data."@x-gmeow-english ;
    gmeow:howToUse "Use reviewed AttemptStop individuals and extend the vocabulary with additional source-supported individuals."@x-gmeow-english ;
    skos:example "ex:value a gmeow:AttemptStop ."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:PauseCause
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Pause Cause"@x-gmeow-english ;
    skos:definition "An open vocabulary describing why a continuation phase paused, without imposing enactment checkpoint machinery."@x-gmeow-english ;
    gmeow:useWhen "Use for the explicit pause cause axis of an agency record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid subclassing PauseCause to add a value or deriving it from missing data."@x-gmeow-english ;
    gmeow:howToUse "Use reviewed PauseCause individuals and extend the vocabulary with additional source-supported individuals."@x-gmeow-english ;
    skos:example "ex:value a gmeow:PauseCause ."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:CommitmentStatus
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Self-Commitment Status"@x-gmeow-english ;
    skos:definition "An open status vocabulary for an intention held as an internal commitment. It is distinct from a social Commitment toward another agent."@x-gmeow-english ;
    gmeow:useWhen "Use for the explicit self-commitment status axis of an agency record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid subclassing CommitmentStatus to add a value or deriving it from missing data."@x-gmeow-english ;
    gmeow:howToUse "Use reviewed CommitmentStatus individuals and extend the vocabulary with additional source-supported individuals."@x-gmeow-english ;
    skos:example "ex:value a gmeow:CommitmentStatus ."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:ArtifactOperation
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Artifact Operation"@x-gmeow-english ;
    skos:definition "An open vocabulary for the operation an activity performed on an identified artifact, separate from invocation outcome and artifact completion."@x-gmeow-english ;
    gmeow:useWhen "Use for the explicit artifact operation axis of an agency record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid subclassing ArtifactOperation to add a value or deriving it from missing data."@x-gmeow-english ;
    gmeow:howToUse "Use reviewed ArtifactOperation individuals and extend the vocabulary with additional source-supported individuals."@x-gmeow-english ;
    skos:example "ex:value a gmeow:ArtifactOperation ."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:ModelInvocationOutcome
    a logic:AbstractIndividualType , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Model Invocation Outcome"@x-gmeow-english ;
    skos:definition "An open vocabulary for a source-reported model invocation outcome. A missing outcome is unknown rather than successful."@x-gmeow-english ;
    gmeow:useWhen "Use for the explicit model invocation outcome axis of an agency record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid subclassing ModelInvocationOutcome to add a value or deriving it from missing data."@x-gmeow-english ;
    gmeow:howToUse "Use reviewed ModelInvocationOutcome individuals and extend the vocabulary with additional source-supported individuals."@x-gmeow-english ;
    skos:example "ex:value a gmeow:ModelInvocationOutcome ."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:stopFinished
    a gmeow:AttemptStop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "finished"@x-gmeow-english ;
    skos:definition "The attempt finished as an activity; this does not assert that its goal was achieved."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly reports finished."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving stopFinished solely from silence, missing timestamps or another status axis."@x-gmeow-english ;
    gmeow:howToUse "Attach stopFinished through attemptStop, preserving the source attribution and time context."@x-gmeow-english ;
    skos:example "ex:record gmeow:attemptStop gmeow:stopFinished ."@x-gmeow-english .

gmeow:stopFailed
    a gmeow:AttemptStop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "failed"@x-gmeow-english ;
    skos:definition "The attempt stopped in a source-reported failure, distinct from a goal-evaluation verdict."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly reports failed."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving stopFailed solely from silence, missing timestamps or another status axis."@x-gmeow-english ;
    gmeow:howToUse "Attach stopFailed through attemptStop, preserving the source attribution and time context."@x-gmeow-english ;
    skos:example "ex:record gmeow:attemptStop gmeow:stopFailed ."@x-gmeow-english .

gmeow:stopInterrupted
    a gmeow:AttemptStop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "interrupted"@x-gmeow-english ;
    skos:definition "The attempt stopped because it was interrupted. A later attempt or resumption remains a separate record."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly reports interrupted."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving stopInterrupted solely from silence, missing timestamps or another status axis."@x-gmeow-english ;
    gmeow:howToUse "Attach stopInterrupted through attemptStop, preserving the source attribution and time context."@x-gmeow-english ;
    skos:example "ex:record gmeow:attemptStop gmeow:stopInterrupted ."@x-gmeow-english .

gmeow:stopYieldedToForeground
    a gmeow:AttemptStop ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "yielded to foreground"@x-gmeow-english ;
    skos:definition "The attempt stopped because foreground work, such as a conversation, took priority."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly reports yielded to foreground."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving stopYieldedToForeground solely from silence, missing timestamps or another status axis."@x-gmeow-english ;
    gmeow:howToUse "Attach stopYieldedToForeground through attemptStop, preserving the source attribution and time context."@x-gmeow-english ;
    skos:example "ex:record gmeow:attemptStop gmeow:stopYieldedToForeground ."@x-gmeow-english .

gmeow:pauseBudgetCheckpoint
    a gmeow:PauseCause ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "budget checkpoint"@x-gmeow-english ;
    skos:definition "A compute or time budget was reached and a prose-attempt resume point was recorded."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly reports budget checkpoint."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving pauseBudgetCheckpoint solely from silence, missing timestamps or another status axis."@x-gmeow-english ;
    gmeow:howToUse "Attach pauseBudgetCheckpoint through pauseCause, preserving the source attribution and time context."@x-gmeow-english ;
    skos:example "ex:record gmeow:pauseCause gmeow:pauseBudgetCheckpoint ."@x-gmeow-english .

gmeow:pauseInterrupted
    a gmeow:PauseCause ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "pause through interruption"@x-gmeow-english ;
    skos:definition "The continuation phase paused because it was interrupted."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly reports pause through interruption."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving pauseInterrupted solely from silence, missing timestamps or another status axis."@x-gmeow-english ;
    gmeow:howToUse "Attach pauseInterrupted through pauseCause, preserving the source attribution and time context."@x-gmeow-english ;
    skos:example "ex:record gmeow:pauseCause gmeow:pauseInterrupted ."@x-gmeow-english .

