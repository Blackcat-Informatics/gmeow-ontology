# Graph-tier negative (native/SHACL gate, lang:GmnMissingEnvelopeField): a gmeow:GmnEnvelope
# that omits its gmeow:gmnCodebookDigest contract field entirely. This is a graph/native
# negative — NOT a malformed .gmn codec-byte negative — discharged by the SHACL/native tier
# in a later task. Every other contract field is present so exactly the missing-field rule fires.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

ex:archiveTeam a gmeow:Agent .
ex:gmnWriterRun a gmeow:Activity .

ex:corrEnvelope a logic:Correspondence ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:SectionRetraction ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true .

# The codebook digest field is absent: the envelope declares no codebook frame identity.
ex:envelopeNoDigest a gmeow:GmnEnvelope ;
    gmeow:gmnSchemaVersion "1" ;
    gmeow:gmnDictionaryVersion "3" ;
    gmeow:gmnGlyphTableVersion "2" ;
    gmeow:gmnSecurityRing gmeow:gmnRingTrusted ;
    gmeow:accordingTo ex:archiveTeam ;
    gmeow:wasGeneratedBy ex:gmnWriterRun ;
    gmeow:contentDigest "blake3:0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e" ;
    gmeow:gmnEnvelopeCorrespondence ex:corrEnvelope .
