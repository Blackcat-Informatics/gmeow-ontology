#
# Closed-world half of the learning slice (issue #584). Cardinality and
# disjointness constraints that OWL EL cannot (or should not, to keep the DL
# profile clean) express live here as SHACL: a gmeow:Teaching mediates exactly
# one teacher, at least one learner, and at least one subject taught, and the
# teacher must differ from every learner (an agent cannot teach itself). The
# open-world "some teacher, some learner" mediation is in module.ttl as EL
# someValuesFrom; the cardinality and teacher ≠ learner rule are SHACL's — the
# deception discipline (doctrine in SHACL, never in axioms), mirroring the
# inference slice's premise ≠ conclusion constraint.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

# --------------------------------------------------------------------------- #
# The reified teaching relation: exactly one teacher, at least one learner and
# subject taught, and teacher != learner.
# --------------------------------------------------------------------------- #

gmeow:TeachingShape
    a sh:NodeShape ;
    rdfs:label "Teaching shape"@x-gmeow-english ;
    skos:definition "Well-formedness of a reified gmeow:Teaching: exactly one gmeow:teacher (a gmeow:Agent), at least one gmeow:learner, at least one gmeow:subjectTaught, and no agent that is both the teacher and a learner of the same Teaching (an agent cannot teach itself). The teacher ≠ learner rule is enforced here, not as an OWL axiom, to keep the reasoned profile within OWL 2 DL."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/learning> ;
    sh:targetClass gmeow:Teaching ;
    sh:property [
        sh:path gmeow:teacher ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "A Teaching must have exactly one teacher (gmeow:teacher), and it must be a gmeow:Agent — two teachers are two Teachings sharing a subject and learner set." ;
    ] ;
    sh:property [
        sh:path gmeow:learner ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Teaching must have at least one learner (gmeow:learner) — instruction with no one taught is not a teaching." ;
    ] ;
    sh:property [
        sh:path gmeow:subjectTaught ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Teaching must name at least one subject taught (gmeow:subjectTaught) — instruction is always instruction in something." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "The teacher must not also be a learner of the same Teaching (gmeow:teacher = gmeow:learner) — an agent cannot teach itself." ;
        sh:select """
            PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
            SELECT $this WHERE {
                $this gmeow:teacher ?a ; gmeow:learner ?a .
            }
        """ ;
    ] .
