# --------------------------------------------------------------------------- #
# spatial-measurement design — SpatialMeasurement / CoordinateObservation place-domain alignments
# --------------------------------------------------------------------------- #

gmeow:SpatialMeasurement skos:relatedMatch geo:SpatialObject {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "GeoSPARQL SpatialObject is the broad top class for anything with spatial representation; GMEOW SpatialMeasurement is an observation relator, not a spatial object itself. Related match only."
|} .

gmeow:CoordinateObservation skos:relatedMatch geo:Feature {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.65 ;
    gmeow:comment "GeoSPARQL Feature is a spatial thing with a geometry; GMEOW CoordinateObservation is the act of assigning that geometry. Related match only."
|} .

gmeow:hasCoordinateObservation skos:relatedMatch geo:hasGeometry {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "gmeow:hasCoordinateObservation links a place to its coordinate observation relator; geo:hasGeometry links a feature to its geometry. Directional lossy projection."
|} .

gmeow:coordinateResult skos:relatedMatch geo:asWKT {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "coordinateResult points to a GeoCoordinates entity; geo:asWKT is a literal property on a Geometry. The projection layer bridges them via the CoordinateObservation path."
|} .

gmeow:geometryResult skos:relatedMatch geo:hasGeometry {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "geometryResult points to a Geometry entity; geo:hasGeometry links a feature to its geometry. Related match because the subject roles differ (observation vs. feature)."
|} .

# --------------------------------------------------------------------------- #
# Cadastral / land administration — ISO 19152 LADM + INSPIRE CP (cadastral design)
# --------------------------------------------------------------------------- #

gmeow:Place skos:closeMatch ladm:LA_SpatialUnit {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW Place is broader: it covers any geographic location, while LADM LA_SpatialUnit is specifically a spatial unit in a land-administration context. A Place typed as placeTypeParcel is the closest match."
|} .

gmeow:placeTypeParcel skos:closeMatch cp:CadastralParcel {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "A GMEOW Place with placeTypeParcel corresponds to an INSPIRE CadastralParcel — a single area of Earth surface under homogeneous real property rights."
|} .

gmeow:LandTenure skos:closeMatch ladm:LA_RRR {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW LandTenure bridges Place × Agent × RightsStatement, while LADM LA_RRR covers rights, restrictions, and responsibilities over a spatial unit. Close semantic match but different structural decomposition."
|} .

gmeow:LandTenure skos:closeMatch cp:BasicPropertyUnit {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "INSPIRE BasicPropertyUnit represents a unit of property with homogeneous rights; GMEOW LandTenure is the time-scoped rights relationship itself. Related but not identical scope."
|} .

gmeow:RightsStatement skos:closeMatch ladm:LA_RRR {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW RightsStatement (deontic rules: permissions, prohibitions, duties) maps to LADM LA_RRR (rights, restrictions, responsibilities). Both are machine-readable statements of the rights situation."
|} .

gmeow:Geometry skos:relatedMatch cp:CadastralBoundary {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "GMEOW Geometry is the general geometric construct; INSPIRE CadastralBoundary is a specific geometry type representing a parcel boundary."
|} .

gmeow:Geometry skos:relatedMatch ladm:LA_BoundaryFace {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "GMEOW Geometry is the general geometric construct; LADM LA_BoundaryFace is a specific 2D boundary face element."
|} .

gmeow:Agent skos:closeMatch ladm:LA_Party {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "GMEOW Agent is broader (any entity capable of action), but within the land-administration context it aligns to LADM LA_Party (a person or organisation with rights)."
|} .

gmeow:RegulatoryOverlay skos:closeMatch cp:CadastralZoning {|
    gmeow:sssomFile "gmeow-places.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
