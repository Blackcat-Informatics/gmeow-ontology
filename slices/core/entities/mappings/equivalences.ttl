@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gedcom: <http://www.w3.org/2000/10/swap/pim/gedcom#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix schema: <https://schema.org/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:eqClasses001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Person ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject schema:Person ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "person" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Person ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject foaf:Person ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "person" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Person ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject gedcom:Individual ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:comment "genealogical individual is a person" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses004 a gmeow:TermEquivalence ;
