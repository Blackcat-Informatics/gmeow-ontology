<https://blackcatinformatics.ca/gmeow/slices/environment-records>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/environment-records> ;
    gmeow:sliceTier gmeow:tierCore ;
    rdfs:label "environment records"@x-gmeow-english ;
    skos:definition "Attributed simulated-world objects, causal state inventories, provider identities, request evidence and owner-scoped disclosure circles."@x-gmeow-english ;
    dcterms:title "GMEOW Environment Records Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Environment providers and agent memory adapters retaining exact object, request and disclosure evidence without fabricated execution."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
