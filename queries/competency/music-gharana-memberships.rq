# Competency question 7 (Music): Kirana-gharana memberships of Raga Yaman
# performances held by the Kirana tradition itself, selected by membership
# authority.
#
# Expected fixture bindings: three memberships for 1960, 1975, and 1980,
# each with the Kirana gharana standpoint as authority. A rival scholar's
# contested membership is a retained, attributed claim with a different
# authority; it is not selected here because it is not the tradition's own,
# and it carries no display flag.

PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>

SELECT ?membership ?performance ?authority ?confidence
WHERE {
    ?membership a gmeow:VersionMembership ;
                gmeow:versionSet gmeow:fixtureRagaYamanKiranaSet ;
                gmeow:versionMember ?performance ;
                gmeow:membershipAuthority ?authority ;
                gmeow:confidence ?confidence .
    FILTER ( ?authority = gmeow:fixtureKiranaGharanaStandpoint )
}
ORDER BY ?membership
