@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

# =========================================================================== #
# Concept categorization shapes
# =========================================================================== #

gmeow:ConceptCategorizationShape
    a sh:NodeShape ;
    rdfs:label "ConceptCategorization well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:ConceptCategorization: exactly one observed entity and one categorizing concept, plus optional typicality in [0,1]."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/concepts> ;
    sh:targetClass gmeow:ConceptCategorization ;
    sh:property [
        sh:path gmeow:observedFeature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A ConceptCategorization must have exactly one observed feature (the categorized entity) via gmeow:observedFeature." ;
    ] ;
    sh:property [
        sh:path gmeow:observationResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Concept ;
        sh:severity sh:Violation ;
        sh:message "A ConceptCategorization must have exactly one observation result of type gmeow:Concept via gmeow:observationResult." ;
    ] ;
    sh:property [
        sh:path gmeow:typicality ;
        sh:minCount 0 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:severity sh:Violation ;
        sh:message "If present, gmeow:typicality must be an xsd:decimal in the closed interval [0,1]." ;
    ] .

gmeow:ConceptTenureShape
    a sh:NodeShape ;
    rdfs:label "ConceptTenure well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:ConceptTenure: a link to exactly one gmeow:Concept via gmeow:conceptHoldsFor, and a time interval expressed via gmeow:duringInterval pointing to a gmeow:TimeInterval."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/concepts> ;
    sh:targetClass gmeow:ConceptTenure ;
    sh:property [
        sh:path gmeow:conceptHoldsFor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Concept ;
        sh:severity sh:Violation ;
        sh:message "A ConceptTenure must scope exactly one gmeow:Concept via gmeow:conceptHoldsFor." ;
    ] ;
    sh:property [
        sh:path gmeow:duringInterval ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:TimeInterval ;
        sh:severity sh:Violation ;
        sh:message "A ConceptTenure must scope exactly one gmeow:TimeInterval via gmeow:duringInterval." ;
    ] .
