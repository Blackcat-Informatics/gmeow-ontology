    skos:example "Retain this governing law: gmeow:StateViewHeadDefinitionLaw logic:formalizes gmeow:currentStateClaim ."@x-gmeow-english ;
    logic:formalizes gmeow:currentStateClaim ;
    logic:message "Current state claims are exactly the retained members with no superseding member in the same view. Every concurrent head is retained; clocks and serialization order choose no winner." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "state" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation rdf:type ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                    [ logic:termIndex 1 ; logic:termIri gmeow:WorldStateView ] ] ;
            logic:consequent [ a logic:Formula ; logic:and
                [ a logic:Formula ;
                    logic:antecedent [ a logic:Formula ; logic:relation gmeow:currentStateClaim ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termVariable "state" ] ] ;
                    logic:consequent [ a logic:Formula ; logic:and
                        [ a logic:Formula ; logic:relation gmeow:stateViewMember ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "state" ] ],
                        [ a logic:Formula ; logic:not [ a logic:Formula ;
                                logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "other" ] ;
                                logic:exists [ a logic:Formula ; logic:and
                                    [ a logic:Formula ; logic:relation gmeow:stateViewMember ;
                                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                            [ logic:termIndex 1 ; logic:termVariable "other" ] ],
                                    [ a logic:Formula ; logic:relation gmeow:supersedes ;
                                        logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ],
                                            [ logic:termIndex 1 ; logic:termVariable "state" ] ] ] ] ] ] ],
                [ a logic:Formula ;
                    logic:antecedent [ a logic:Formula ; logic:and
                        [ a logic:Formula ; logic:relation gmeow:stateViewMember ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "state" ] ],
                        [ a logic:Formula ; logic:not [ a logic:Formula ;
                                logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "other" ] ;
                                logic:exists [ a logic:Formula ; logic:and
                                    [ a logic:Formula ; logic:relation gmeow:stateViewMember ;
                                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                            [ logic:termIndex 1 ; logic:termVariable "other" ] ],
                                    [ a logic:Formula ; logic:relation gmeow:supersedes ;
                                        logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ],
                                            [ logic:termIndex 1 ; logic:termVariable "state" ] ] ] ] ] ] ;
                    logic:consequent [ a logic:Formula ; logic:relation gmeow:currentStateClaim ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                            [ logic:termIndex 1 ; logic:termVariable "state" ] ] ] ] ] ] .

