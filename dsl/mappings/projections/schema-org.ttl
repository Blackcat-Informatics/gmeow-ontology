            [ gmeow:subjectVar "id" ; gmeow:predicate gmeow:identifierScheme ; gmeow:objectLiteral "tax" ] ) ;
        gmeow:edoalSource gmeow:hasIdentifier ] ;
    gmeow:hasBinding [
