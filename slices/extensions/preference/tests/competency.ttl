    logic:declaresColumn [ logic:columnVariable "deployment" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .
ex:cqPromotionDefersActivationRow a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "activation" ; gmeow:cellValueIri exd:activation ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "gate" ; gmeow:cellValueIri exd:gate ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "deployment" ; gmeow:cellValueIri exd:deployment ] .

