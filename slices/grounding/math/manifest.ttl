@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/math>
    a gmeow:Slice, gmeow:GroundingSlice ;
    rdfs:label "mathematics"@x-gmeow-english ;
    skos:definition "The mathematics slice (core tier): the home of GMEOW Mathematics — the `math:` grounding layer, a peer of `logic:` and `lang:`. It owns local mathematical reference identity (concepts, symbols, notations, theories, contexts, and definitions), typed expression ASTs with strict zero-based contiguous slots, applied-category-theory referents (categories, morphisms, functors, and natural transformations), the sole dimensioned Quantity/value authority, number systems and exactness, arithmetic, sets, relations, functions, probability, and statistics. Expressions lower explicitly into `logic:` and render through `lang:`; external standards and upper ontologies are typed target correspondences, never semantic owners. Typed conformance failures make every well-formedness violation queryable, and preservation vocabulary is reused from the `logic:` loss ledger. The manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    dcterms:title "GMEOW Mathematics"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/places> ,
        <https://blackcatinformatics.ca/gmeow/slices/provenance> ;
    gmeow:sliceCoFoundationalWith <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    gmeow:sliceConsumer "Every slice and consumer that needs mathematical identity, quantities, dimensions, typed expressions, category-theoretic structure, probability, statistics, or projection-preservation judgments. The preservation vocabulary and denotation seam come from the co-foundational `logic:` slice; expression rendering composes with the general `lang:Rendering` theory rather than forking a private display vocabulary. Observation slices qualify the math-owned `math:Quantity` with unit/frame, determinacy, uncertainty, and provenance instead of minting parallel quantity classes."@x-gmeow-english ;
    gmeow:sliceQualityTier gmeow:tierRegistered ;
    gmeow:sliceDocMaturity gmeow:docMaturityMinimal .

# --------------------------------------------------------------------------- #
# The mathematical grounding domain.
#
# One of the three subject-matter domains of docs/GROUNDING.md's "External
# grounding ownership" table, declared here by the slice that owns it. A term
# marked gmeow:groundingConceptDomain gmeow:groundingDomainMathematical is a
# GROUNDING CONCEPT that `math:` must own; the tier rule fires when a grounding
# slice references such a term while a non-grounding slice owns it.
# --------------------------------------------------------------------------- #

<https://blackcatinformatics.ca/gmeow/groundingDomainMathematical>
    a gmeow:GroundingDomain ;
    rdfs:label "mathematical grounding domain"@x-gmeow-english ;
    skos:definition "Mathematical structures, quantities, and mathematical interchange languages — number systems, sets, relations, functions, algebraic and categorical structure, dimension and magnitude, probability and statistics, and the expression languages they are exchanged in. The `math:` slice is the sole owner of every grounding concept in this domain. Note the standing applied example of docs/GROUNDING.md's tier rule: math:Quantity and math:quantityValue carry dimension and magnitude and are in this domain, while the unit, frame, determinacy, uncertainty, and provenance qualifiers the observations slice adds to a quantity are NOT — they are consumer-side qualification, not mathematical structure."@x-gmeow-english ;
    gmeow:groundingDomainOwner <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> .
