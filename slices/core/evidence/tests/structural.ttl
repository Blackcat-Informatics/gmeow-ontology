# --- 21. supportsNotability is a DatatypeProperty with xsd:boolean range (MUST) ---
ex:saSupportsNotabilityProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:supportsNotability a owl:DatatypeProperty ;
        rdfs:domain gmeow:CitationAct ;
        rdfs:range xsd:boolean .
}""" ;
    gmeow:saRationale "gmeow:supportsNotability MUST be an owl:DatatypeProperty with domain gmeow:CitationAct and range xsd:boolean -- the notability summary flag for the Axis B assessment." .

# --- 22. Evidence properties have no inferential bridge to truth props (MUST-NOT) ---
ex:saEvidencePropsNoTruthBridge a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?evProp {
        gmeow:hasEvidenceClass
        gmeow:sourceIndependence
        gmeow:sourceTier
        gmeow:coverageDepth
    }
    VALUES ?truthProp {
        gmeow:observationResult
        gmeow:trustor
        gmeow:trustee
        gmeow:endorses
    }
    {
        ?evProp rdfs:subPropertyOf ?truthProp .
    } UNION {
        ?truthProp rdfs:subPropertyOf ?evProp .
    } UNION {
        ?evProp owl:equivalentProperty ?truthProp .
    } UNION {
        ?truthProp owl:equivalentProperty ?evProp .
    }
}""" ;
    gmeow:saRationale "No evidence property (hasEvidenceClass, sourceIndependence, sourceTier, coverageDepth) MUST carry any rdfs:subPropertyOf or owl:equivalentProperty bridge to truth/trust properties (observationResult, trustor, trustee, endorses) -- evidence is a warrant annotation, never an inferential truth bridge." .
