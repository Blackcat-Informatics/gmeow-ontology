@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .

# =========================================================================== #
# Finding well-formedness: a projected finding carries exactly one
# severity, exactly one code, and exactly one message — closed-world checks the
# EL someValuesFrom mediation in module.ttl cannot express.
# =========================================================================== #

gmeow:FindingShape
    a sh:NodeShape ;
    rdfs:label "Finding well-formedness shape"@x-gmeow-english ;
    skos:definition "SHACL constraints for gmeow:Finding: exactly one gmeow:findingSeverity (a gmeow:DiagnosticSeverity), exactly one xsd:string gmeow:findingCode, and exactly one xsd:string gmeow:findingMessage, so every projected finding is renderable to SARIF/CLI without holes."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    sh:targetClass gmeow:Finding ;
    sh:property [
        sh:path gmeow:findingSeverity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:DiagnosticSeverity ;
        sh:severity sh:Violation ;
        sh:message "A Finding must carry exactly one gmeow:findingSeverity (a gmeow:DiagnosticSeverity)." ;
    ] ;
    sh:property [
        sh:path gmeow:findingCode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A Finding must carry exactly one xsd:string gmeow:findingCode." ;
    ] ;
    sh:property [
        sh:path gmeow:findingMessage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A Finding must carry exactly one xsd:string gmeow:findingMessage." ;
    ] .

# =========================================================================== #
# The gate-fatal up-set projection (Principle 17): the closed-world SHACL image
# of logic:ruleGateFatalVerdict. A gmeow:Finding on the principal up-set
# ↑(gmeow:severityError, gmeow:blockingBlocking, gmeow:standpointBinding) — its
# severity is error, its category projects (through gmeow:categoryBlocking) to
# gmeow:blockingBlocking, AND its standpoint is gmeow:standpointBinding — MUST
# carry the derived verdict gmeow:findingGateVerdict gmeow:gateFatal. A finding on
# the up-set that lacks the fatal verdict is the violation: the projection agrees
# with the derivation only when the reasoner has fired. The sh:SPARQLTarget selects
# the up-set findings; the sh:SPARQLConstraint fires on those missing the verdict.
# purrdf's SHACL engine supports sh:sparql (the learning slice proves it).
# =========================================================================== #

gmeow:GateFatalUpsetShape
    a sh:NodeShape ;
    rdfs:label "Gate-fatal up-set shape"@x-gmeow-english ;
    skos:definition "The closed-world SHACL projection of logic:ruleGateFatalVerdict (Principle 17): a gmeow:Finding on the principal up-set ↑(gmeow:severityError, gmeow:blockingBlocking, gmeow:standpointBinding) — severity error, category projecting through gmeow:categoryBlocking to gmeow:blockingBlocking, and standpoint gmeow:standpointBinding — must carry gmeow:findingGateVerdict gmeow:gateFatal. A finding meeting the up-set antecedent but lacking the fatal verdict violates the shape, so the SHACL surface agrees with the reasoner's derived verdict over the up-set boundary. A lossy projection of the canonical logic: rule, sealed by logic:formalizes."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    logic:formalizes logic:ruleGateFatalVerdict ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
            SELECT ?this WHERE {
                ?this a gmeow:Finding ;
                      gmeow:findingSeverity gmeow:severityError ;
                      gmeow:findingStandpoint gmeow:standpointBinding ;
                      gmeow:findingCategory ?cat .
                ?cat gmeow:categoryBlocking gmeow:blockingBlocking .
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A finding on the gate-fatal up-set (severity error, category projecting to blocking, standpoint binding) must carry gmeow:findingGateVerdict gmeow:gateFatal — the derived verdict of logic:ruleGateFatalVerdict is missing." ;
        sh:select """
            PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
            SELECT $this WHERE {
                $this a gmeow:Finding ;
                      gmeow:findingSeverity gmeow:severityError ;
                      gmeow:findingStandpoint gmeow:standpointBinding ;
                      gmeow:findingCategory ?cat .
                ?cat gmeow:categoryBlocking gmeow:blockingBlocking .
                FILTER NOT EXISTS { $this gmeow:findingGateVerdict gmeow:gateFatal . }
            }
        """ ;
    ] .

# =========================================================================== #
# Cross-node glut witness INTEGRITY (not presence): a reasoner-minted
# gmeow:CrossNodeGlutWitness records a two-sided coherence conflict, so it must
# carry EXACTLY two gmeow:glutWitnessOf links — one per conflicting finding. This
# gates the STRUCTURE of the meta-finding, never its presence (root-cause / glut
# meta-findings are informational, never gate-failing).
# =========================================================================== #

gmeow:CrossNodeGlutWitnessShape
    a sh:NodeShape ;
    rdfs:label "Cross-node glut witness integrity shape"@x-gmeow-english ;
    skos:definition "SHACL structural integrity for gmeow:CrossNodeGlutWitness: a cross-node glut witness records a two-sided coherence conflict, so it must carry EXACTLY two gmeow:glutWitnessOf links, each to a gmeow:Finding. This gates the SHAPE of the reasoner-minted meta-finding only — never its presence, since a cross-node glut is informational and never gate-failing."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    sh:targetClass gmeow:CrossNodeGlutWitness ;
    sh:property [
        sh:path gmeow:glutWitnessOf ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:class gmeow:Finding ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:CrossNodeGlutWitness must carry exactly two gmeow:glutWitnessOf links (one per conflicting finding)." ;
    ] .

# =========================================================================== #
# The invented-witness single-ordinal invariant: gmeow:existentialOrdinal's own
# definition states it is "Single-valued per gmeow:InventedWitness" — one
# firing-rule head position per Skolem witness. sh:maxCount 1 ONLY (no
# sh:minCount): an InventedWitness whose ordinal has not yet been asserted is
# never a violation on its own, only a SECOND, conflicting ordinal is.
# =========================================================================== #

gmeow:InventedWitnessShape
    a sh:NodeShape ;
    rdfs:label "Invented witness single-ordinal shape"@x-gmeow-english ;
    skos:definition "SHACL structural integrity for gmeow:InventedWitness: gmeow:existentialOrdinal is single-valued per witness (at most one xsd:nonNegativeInteger), enforcing the term's own documented invariant — a Skolem witness discharges exactly one existential head-variable position of its firing rule, never two at once. sh:maxCount 1 only, deliberately no sh:minCount, so an ordinal not yet asserted is never itself a violation."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/diagnostics> ;
    sh:targetClass gmeow:InventedWitness ;
    sh:property [
        sh:path gmeow:existentialOrdinal ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:InventedWitness carries at most one gmeow:existentialOrdinal — it is single-valued per witness." ;
    ] .
