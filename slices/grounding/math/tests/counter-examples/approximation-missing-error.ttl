#
# Counter-example for the canonical math:ApproximateValue restrictions: the
# approximation names its target but omits the required numeric error bound.
# The registered cell selects math:ExactApproximateConflation class isolation:
# it requires a matching finding and rejects findings of other classes, without
# additionally enforcing the declared component/source-shape fields or a sole
# finding count. This header records the source contract, not an executed verdict.
# Bound by tests/example-conformance.ttl (ex:ecApproximationMissingError).
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <http://example.org/math/> .

ex:approxNoError a math:ApproximateValue ;
    math:approximates ex:exactThird .

ex:exactThird a math:RationalNumber ;
    math:inNumberSystem math:rationalNumbers ;
    math:isExact true .
