gmeow:cell
    a logic:ObjectProperty ;
    logic:domain gmeow:ContentBlock ;
    logic:range gmeow:TableCell ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "source table cell"@x-gmeow-english ;
    skos:definition "A retained documentary cell of this table block. Row and column identities are scoped by this exact table, not shared globally across tables."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this explicit part of the source structure or apparatus with its original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."@x-gmeow-english ;
    gmeow:howToUse "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."@x-gmeow-english ;
    skos:example "Retain this source meaning: ex:record gmeow:cell ex:target ."@x-gmeow-english .

gmeow:cellOf
    a logic:ObjectProperty ;
    logic:domain gmeow:TableCell ;
    logic:range gmeow:ContentBlock ;
    logic:inverseOf gmeow:cell ;
    logic:subPropertyOf gmeow:partOf ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "cell of source table"@x-gmeow-english ;
    skos:definition "The exact table block containing this documentary cell. It is the inverse of cell and supplies the coordinate scope."@x-gmeow-english ;
    gmeow:useWhen "Use to retain this explicit part of the source structure or apparatus with its original evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."@x-gmeow-english ;
    gmeow:howToUse "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."@x-gmeow-english ;
    skos:example "Retain this source meaning: ex:record gmeow:cellOf ex:target ."@x-gmeow-english .

gmeow:cellRow
    a logic:DatatypeProperty ;
    logic:domain gmeow:TableCell ;
    logic:range xsd:integer ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "source cell row"@x-gmeow-english ;
    skos:definition "The source row index of a documentary cell under its table's explicit tableIndexOrigin. It is not a matrix coordinate or an implicit zero-based conversion."@x-gmeow-english ;
