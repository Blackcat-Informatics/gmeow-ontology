@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .

# Term equivalences for the norms extension — GMEOW authoring source.
# Compiled to mappings/gmeow-norms.sssom.tsv by the mapping compiler.

gmeow:mapsetNorms a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-norms.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/norms" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Assessment/rubric alignments to schema.org's review cluster (PROV activity alignment): the Assessment relator is per-review — its vantage is the review author — so the schema review idiom carries coexisting verdicts faithfully (Principle 9).".

gmeow:assessmentTarget skos:closeMatch schema:itemReviewed {|
    gmeow:sssomFile "gmeow-norms.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the assessed target is what a schema review reviews; closeMatch — itemReviewed scopes to Review acts where assessmentTarget covers any scored observation (PROV activity alignment: declares the per-review ClaimReview projection)"
|} .

gmeow:assessmentScoreValue skos:closeMatch schema:ratingValue {|
    gmeow:sssomFile "gmeow-norms.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "the score literal as schema's rating value; closeMatch — ratingValue rides a Rating node where the score sits on the Assessment (PROV activity alignment)"
|} .
