gmeow:tuningSystemShruti22
    a gmeow:TuningSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "22-śruti Hindustani tuning"@x-gmeow-english ;
    skos:definition "The Hindustani 22-śruti reference frame: the octave partitioned into 22 unequal 5-limit just-intonation intervals (śrutis), the pitch space of rāga performance. One TuningSystem among many (Principle 9)."@x-gmeow-english ;
    gmeow:cites gmeow:workNatyashastra ,
        gmeow:workSangitaratnakara ;
    gmeow:degreeCount "22"^^xsd:nonNegativeInteger ;
    gmeow:determinacyModel gmeow:determinacyCrisp ;
    gmeow:dimensionCount "1"^^xsd:nonNegativeInteger ;
