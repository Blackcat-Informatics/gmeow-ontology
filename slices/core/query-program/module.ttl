gmeow:QueryRerankLossRetentionLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank loss retention law"@x-gmeow-english ;
    skos:definition "Every loss resource retained by an original union ledger survives by identity in an output answer ledger. Additional supplied rerank-stage losses may coexist with those original records."@x-gmeow-english ;
    gmeow:useWhen "Use to reject a rerank result that omits or replaces an inherited loss record."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid requiring input and output ledgers to be identical, erasing acknowledged losses or treating a new stage loss as a replacement for an original one."@x-gmeow-english ;
    gmeow:howToUse "Bind each input ledger and loss, then require an existing output ledger containing the same loss resource through ledgerLoss."@x-gmeow-english ;
    skos:scopeNote "The law forwards source loss identities without repairing, waiving or authenticating them. It imposes no inverse owner on a shared loss or ledger."@x-gmeow-english ;
    skos:example "Original plus stage loss: ex:inputLedger gmeow:ledgerLoss ex:originalLoss . ex:outputLedger gmeow:ledgerLoss ex:originalLoss, ex:stageLoss ."@x-gmeow-english ;
    logic:formalizes gmeow:rerankedUnion ;
    logic:message "Every loss resource retained by an original union ledger survives by identity in an output answer ledger. Additional supplied rerank-stage losses may coexist with those original records." ;
    logic:integrity [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "input" ], [ logic:termIndex 2 ; logic:termVariable "inputLedger" ], [ logic:termIndex 3 ; logic:termVariable "loss" ] ;
logic:forall [ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryRerankAnswer ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankedUnion ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "input" ] ],
[ a logic:Formula ;
logic:relation gmeow:queryLossLedger ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "input" ], [ logic:termIndex 1 ; logic:termVariable "inputLedger" ] ],
[ a logic:Formula ;
logic:relation gmeow:ledgerLoss ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "inputLedger" ], [ logic:termIndex 1 ; logic:termVariable "loss" ] ] ] ;
logic:consequent [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "outputLedger" ] ;
logic:exists [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "outputLedger" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryLossLedger ] ],
[ a logic:Formula ;
logic:relation gmeow:queryLossLedger ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "outputLedger" ] ],
[ a logic:Formula ;
logic:relation gmeow:ledgerLoss ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "outputLedger" ], [ logic:termIndex 1 ; logic:termVariable "loss" ] ] ] ] ] ] .

gmeow:QueryRerankUnscoredCompletenessLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query rerank unscored completeness law"@x-gmeow-english ;
    skos:definition "A rerank answer with any explicit unscored candidate cannot report CompleteForFragment. The source’s other status evidence and any missing status remain independently represented."@x-gmeow-english ;
    gmeow:useWhen "Use to reject a complete-result claim that coexists with a retained unscored outcome."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid fabricating an incomplete status from absence, deleting the unscored row or treating an empty loss ledger as proof of complete scoring."@x-gmeow-english ;
    gmeow:howToUse "Bind an answer entry and its structured unscored detail, then forbid the answer’s queryCompletenessStatus value logic:CompleteForFragment."@x-gmeow-english ;
    skos:scopeNote "This law is a negative compatibility check, not a status default or inference of provider success. Empty input and all-scored results still carry only statuses actually supplied."@x-gmeow-english ;
    skos:example "An explicitly incomplete source report: ex:answer gmeow:queryCompletenessStatus logic:Incomplete ; gmeow:rerankEntry ex:e . ex:e gmeow:rerankUnscoredDetail ex:detail ."@x-gmeow-english ;
    logic:formalizes gmeow:QueryRerankAnswer ;
    logic:message "A rerank answer with any explicit unscored candidate cannot report CompleteForFragment. The source’s other status evidence and any missing status remain independently represented." ;
    logic:integrity [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "entry" ], [ logic:termIndex 2 ; logic:termVariable "detail" ] ;
logic:forall [ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryRerankAnswer ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankEntry ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "entry" ] ],
[ a logic:Formula ;
logic:relation gmeow:rerankUnscoredDetail ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "entry" ], [ logic:termIndex 1 ; logic:termVariable "detail" ] ] ] ;
logic:consequent [ a logic:Formula ;
logic:not [ a logic:Formula ;
logic:relation gmeow:queryCompletenessStatus ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri logic:CompleteForFragment ] ] ] ] ] .

gmeow:QueryRerank logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankInput ; logic:allValuesFrom gmeow:QueryUnionAnswer ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryRerank ; logic:closureKey "https://blackcatinformatics.ca/gmeow/rerankInput" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryRerank logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankInput ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass gmeow:QueryUnionAnswer ] .

gmeow:QueryRerank logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankOutput ; logic:allValuesFrom gmeow:QueryRerankAnswer ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryRerank ; logic:closureKey "https://blackcatinformatics.ca/gmeow/rerankOutput" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryRerank logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankOutput ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass gmeow:QueryRerankAnswer ] .

gmeow:QueryRerank logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankScoreProfile ; logic:allValuesFrom [ a logic:Class ; logic:oneOf ( gmeow:rerankFiniteFloatProfile ) ] ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryRerank ; logic:closureKey "https://blackcatinformatics.ca/gmeow/rerankScoreProfile" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryRerank logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankScoreProfile ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:QualityValue ] .

gmeow:QueryRerankAnswer logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankedUnion ; logic:allValuesFrom gmeow:QueryUnionAnswer ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryRerankAnswer ; logic:closureKey "https://blackcatinformatics.ca/gmeow/rerankedUnion" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryRerankAnswer logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankedUnion ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass gmeow:QueryUnionAnswer ] .

gmeow:QueryRerankAnswer logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankScoreProfile ; logic:allValuesFrom [ a logic:Class ; logic:oneOf ( gmeow:rerankFiniteFloatProfile ) ] ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryRerankAnswer ; logic:closureKey "https://blackcatinformatics.ca/gmeow/rerankScoreProfile" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryRerankAnswer logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankScoreProfile ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:QualityValue ] .

gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankEntryCandidate ; logic:allValuesFrom logic:Thing ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryRerankEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/rerankEntryCandidate" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankEntryCandidate ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass logic:Thing ] .

gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankInputPosition ; logic:allValuesFrom xsd:nonNegativeInteger ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryRerankEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/rerankInputPosition" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankInputPosition ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange xsd:nonNegativeInteger ] .

gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:entryOrdinal ; logic:allValuesFrom xsd:nonNegativeInteger ] .
[ a logic:ClosureEntry ; logic:onClass gmeow:QueryRerankEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/entryOrdinal" ; logic:closureValue logic:ClosedWorldClosure ] .
gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:entryOrdinal ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange xsd:nonNegativeInteger ] .

gmeow:QueryRerankAnswer logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankAuthority ; logic:allValuesFrom gmeow:QueryRerankAuthority ] .
gmeow:QueryRerankAnswer logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankAuthority ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass gmeow:QueryRerankAuthority ] .

gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankScore ; logic:allValuesFrom gmeow:QueryRerankScore ] .
gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankScore ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass gmeow:QueryRerankScore ] .

gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankWinningPassage ; logic:allValuesFrom xsd:string ] .
gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankWinningPassage ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onDataRange xsd:string ] .

gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankUnscoredDetail ; logic:allValuesFrom gmeow:StructuredValue ] .
gmeow:QueryRerankEntry logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankUnscoredDetail ; logic:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; logic:onClass gmeow:StructuredValue ] .

gmeow:QueryRerankAnswer logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:rerankEntry ; logic:allValuesFrom gmeow:QueryRerankEntry ] .

gmeow:QueryRerankAnswer logic:subClassOf [ a logic:Restriction ; logic:onProperty gmeow:queryCandidate ; logic:allValuesFrom logic:Thing ] .

gmeow:QueryOrderPolicy
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Order Policy"@x-gmeow-english ;
    skos:definition "An explicit complete query-order definition selecting unique predicate-to-tier mappings and source-standard key directions. It contains ordered criterion occurrences with required fused-score and terminal source-subject-tie criteria, plus explicitly included content-tier or activation criteria."@x-gmeow-english ;
    gmeow:useWhen "Use to describe criterion precedence without changing the selected fusion arithmetic or asserting an executed order."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the definition as an applied result, a native policy digest, a provider capability claim or a permission to filter candidates."@x-gmeow-english ;
    gmeow:howToUse "Retain every orderCriterion occurrence with its own position, kind and explicit direction; include a fused-score criterion and a final source-subject-tie criterion."@x-gmeow-english ;
    skos:scopeNote "This selected contract admits both score-before-activation and activation-before-score definitions. Actual key values, snapshot evidence, result positions and source adoption require separate evidence."@x-gmeow-english ;
    skos:example "A complete minimal definition: ex:policy a gmeow:QueryOrderPolicy ; gmeow:orderCriterion ex:scoreCriterion, ex:tieCriterion ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:QueryOrderCriterion
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Order Criterion"@x-gmeow-english ;
    skos:definition "One criterion occurrence in exactly one query-order policy sequence, retaining one nonnegative entryOrdinal, one selected key kind and one explicit boolean direction. Its precedence is local to the owning policy."@x-gmeow-english ;
    gmeow:useWhen "Use for a mechanical comparison key whose position and direction must remain explicit in a policy definition."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid coercing the occurrence into a rubric Criterion, sharing it between policy sequences or treating its ordinal as a measured magnitude."@x-gmeow-english ;
    gmeow:howToUse "Link the occurrence from its policy through orderCriterion and supply entryOrdinal, orderCriterionKind and a typed boolean orderDescending."@x-gmeow-english ;
    skos:scopeNote "Another policy uses another occurrence even when the key kind and direction agree. Predicate-tier binding declarations may still be shared across occurrences."@x-gmeow-english ;
    skos:example "An explicit score occurrence: ex:scoreCriterion a gmeow:QueryOrderCriterion ; gmeow:entryOrdinal \"1\"^^xsd:nonNegativeInteger ; gmeow:orderCriterionKind gmeow:orderFusedScore ; gmeow:orderDescending true ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:QueryPredicateTierBinding
    a logic:Kind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Predicate Tier Binding"@x-gmeow-english ;
    skos:definition "A supplied declaration mapping one actual content-predicate IRI to one unsigned integer control-tier label. A content-tier criterion selects at most one binding resource for each predicate."@x-gmeow-english ;
    gmeow:useWhen "Use to define the predicate-to-tier mapping consulted by a declared content-tier criterion."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the tier label as a mathematical magnitude, bibliographic source tier, audience tier or class rank."@x-gmeow-english ;
    gmeow:howToUse "Supply one tierBindingPredicate IRI and one xsd:unsignedInt tierBindingOrdinal, then retain the declaration through contentTierBinding."@x-gmeow-english ;
    skos:scopeNote "The binding is reusable across policies and has no unique inverse owner. The selected unique-predicate profile does not model a native last-wins duplicate mapping vector."@x-gmeow-english ;
    skos:example "A reusable declaration: ex:labelTier a gmeow:QueryPredicateTierBinding ; gmeow:tierBindingPredicate ex:label ; gmeow:tierBindingOrdinal \"0\"^^xsd:unsignedInt ."@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject .

gmeow:queryOrderPolicy
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "query order policy description"@x-gmeow-english ;
    skos:definition "Associates a query-program node description with a supplied query-order policy definition. The association retains descriptive evidence without changing the node’s existing operator contract or selecting an executed policy."@x-gmeow-english ;
    gmeow:useWhen "Use to keep one or more supplied order definitions beside a query-program description."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid interpreting the edge as proof that an operator applied the policy, a default selection or an alteration of existing reciprocal-fusion semantics."@x-gmeow-english ;
    gmeow:howToUse "Reference each supplied QueryOrderPolicy and preserve its criterion sequence independently of execution and result evidence."@x-gmeow-english ;
    skos:scopeNote "The association is optional and nonfunctional. Coexisting definitions do not imply that a result applied all of them or choose a preferred policy."@x-gmeow-english ;
    skos:example "Two supplied definitions: ex:node gmeow:queryOrderPolicy ex:scoreFirst, ex:activationFirst ."@x-gmeow-english ;
    logic:domain gmeow:QueryProgramNode ; logic:range gmeow:QueryOrderPolicy .

gmeow:orderCriterion
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "query order criterion occurrence"@x-gmeow-english ;
    skos:definition "One criterion occurrence retained in a QueryOrderPolicy’s complete comparison prescription. Ascending entryOrdinal determines precedence among its distinct key kinds."@x-gmeow-english ;
    gmeow:useWhen "Use to expose the full ordered set of comparison keys in a policy definition."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating RDF edge serialization order as criterion precedence or omitting the required fused-score or terminal tie criterion."@x-gmeow-english ;
    gmeow:howToUse "Link each answer-independent QueryOrderCriterion and retain its own ordinal, key kind and explicit direction."@x-gmeow-english ;
    skos:scopeNote "Criterion positions and kinds are unique within the policy. Noncontiguous source positions are permitted, and collection membership does not assert an applied candidate order."@x-gmeow-english ;
    skos:example "Two precedence occurrences: ex:policy gmeow:orderCriterion ex:firstKey, ex:lastKey ."@x-gmeow-english ;
    logic:domain gmeow:QueryOrderPolicy ; logic:range gmeow:QueryOrderCriterion .

gmeow:orderCriterionKind
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "query order criterion kind"@x-gmeow-english ;
    skos:definition "The explicitly selected comparison-key kind of a criterion occurrence: content tier, fused score, snapshot activation or source subject tie. The selected policy profile admits exactly those four value kinds."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish what a criterion compares from its sequence position and direction."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting a measured score, rubric axis, predicate IRI or source identity bytes for the key-kind value."@x-gmeow-english ;
    gmeow:howToUse "Select one of orderContentTier, orderFusedScore, orderActivation or orderSubjectTie on each occurrence."@x-gmeow-english ;
    skos:scopeNote "Key-kind selection supplies no candidate key value or execution evidence. Content-tier and activation criteria are included explicitly rather than inferred from data availability."@x-gmeow-english ;
    skos:example "An explicit activation key: ex:activationCriterion gmeow:orderCriterionKind gmeow:orderActivation ."@x-gmeow-english ;
    logic:domain gmeow:QueryOrderCriterion ; logic:range logic:QualityValue .

gmeow:orderDescending
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "query order descending"@x-gmeow-english ;
    skos:definition "The explicit boolean direction coordinate of one criterion occurrence. This selected profile requires false for content tier and subject tie, and true for fused score and activation."@x-gmeow-english ;
    gmeow:useWhen "Use to retain a declared ascending or descending comparison direction as actual typed boolean data."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid string-valued true or false, a missing direction default or a claim that a described reverse direction is supported by this selected profile."@x-gmeow-english ;
    gmeow:howToUse "Write one xsd:boolean value on each occurrence and check it against the selected key kind’s required direction."@x-gmeow-english ;
    skos:scopeNote "The direction remains explicitly supplied even though the profile validates its value. No missing declaration is generated from the criterion kind."@x-gmeow-english ;
    skos:example "An explicit descending key: ex:scoreCriterion gmeow:orderDescending \"true\"^^xsd:boolean ."@x-gmeow-english ;
    logic:domain gmeow:QueryOrderCriterion ; logic:range xsd:boolean .

gmeow:contentTierBinding
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "content tier binding"@x-gmeow-english ;
    skos:definition "A predicate-to-tier declaration retained by a content-tier criterion occurrence. The candidate tier is the minimum declared label among its matched-literal predicates; a candidate with no matching declaration follows every declared tier."@x-gmeow-english ;
    gmeow:useWhen "Use to retain all predicate mappings of an explicitly selected content-tier comparison key."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid attaching mappings to score, activation or subject-tie criteria, matching every predicate a subject has or filtering candidates with undeclared predicates."@x-gmeow-english ;
    gmeow:howToUse "Link each QueryPredicateTierBinding from an orderContentTier occurrence, preserving one binding per predicate within that occurrence."@x-gmeow-english ;
    skos:scopeNote "A criterion may explicitly contain no mappings, making every candidate undeclared for that key. Shared binding resources do not merge policy occurrences or assert matched-literal evidence."@x-gmeow-english ;
    skos:example "Two supplied mappings: ex:tierCriterion gmeow:contentTierBinding ex:labelTier, ex:bodyTier ."@x-gmeow-english ;
    logic:domain gmeow:QueryOrderCriterion ; logic:range gmeow:QueryPredicateTierBinding .

gmeow:tierBindingPredicate
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "content tier binding predicate"@x-gmeow-english ;
    skos:definition "The actual source content-predicate IRI mapped by one tier binding. It identifies the predicate on a matched literal statement, without interpreting an arbitrary text label as a predicate or asserting a new predicate schema."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve the source predicate identity of a content-tier declaration."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid replacing the IRI with a string, blank node, ontology class or an invented semantic identity derived from a source hash."@x-gmeow-english ;
    gmeow:howToUse "Link one predicate IRI on the binding and retain the unsigned control-tier label separately through tierBindingOrdinal."@x-gmeow-english ;
    skos:scopeNote "The bound term-kind check requires an IRI but does not authenticate it, resolve it or prove that any candidate matched a statement using it."@x-gmeow-english ;
    skos:example "An actual predicate resource: ex:labelTier gmeow:tierBindingPredicate ex:label ."@x-gmeow-english ;
    logic:domain gmeow:QueryPredicateTierBinding ; logic:range logic:Thing .

gmeow:tierBindingOrdinal
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "content tier binding ordinal"@x-gmeow-english ;
    skos:definition "The supplied unsigned integer control-tier label assigned to one content predicate. Smaller declared labels precede larger ones, while undeclared candidates remain after every declared label."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve a source predicate’s tier label without turning it into a score or measured quantity."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating the ordinal as a probability, class rank, linear-map rank, physical dimension or a globally preferred classification."@x-gmeow-english ;
    gmeow:howToUse "Retain one xsd:unsignedInt value on the binding; let the selected content-tier criterion define comparison and undeclared behavior."@x-gmeow-english ;
    skos:scopeNote "Equal labels on different predicates are legal and preserve a shared tier. The label’s integer range does not impose contiguous tiers or construct a mathematical Quantity."@x-gmeow-english ;
    skos:example "A supplied control label: ex:bodyTier gmeow:tierBindingOrdinal \"2\"^^xsd:unsignedInt ."@x-gmeow-english ;
    logic:domain gmeow:QueryPredicateTierBinding ; logic:range xsd:unsignedInt .

gmeow:orderContentTier
    a logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "content tier order key"@x-gmeow-english ;
    skos:definition "The content-tier comparison-key kind: a candidate uses the smallest declared control-tier label among the predicates on its matched literal statements, with no declared match ordered after every declared tier."@x-gmeow-english ;
    gmeow:useWhen "Use to include matched-content predicate tiers as an explicit policy criterion."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid reading the tier as evidence quality, truth, audience classification or an authorization to filter an undeclared candidate."@x-gmeow-english ;
    gmeow:howToUse "Select this kind on a criterion, declare orderDescending false and retain its contentTierBinding collection."@x-gmeow-english ;
    skos:scopeNote "An empty binding collection yields a constant undeclared key. Applied matching evidence and assigned candidate tiers are separate from this policy definition."@x-gmeow-english ;
    skos:example "A selected tier key: ex:tierCriterion gmeow:orderCriterionKind gmeow:orderContentTier ; gmeow:orderDescending false ."@x-gmeow-english .

gmeow:orderFusedScore
    a logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "fused score order key"@x-gmeow-english ;
    skos:definition "The fused-score comparison-key kind, ordering greater source fused scores first without defining or changing the fusion arithmetic that produced them."@x-gmeow-english ;
    gmeow:useWhen "Use to place the source fused-score criterion explicitly within a comparison prescription."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid substituting a reranker’s floating-point score, epistemic confidence or a new arithmetic rule for the source fused-score context."@x-gmeow-english ;
    gmeow:howToUse "Select this kind on one criterion with orderDescending true and retain its explicit sequence position."@x-gmeow-english ;
    skos:scopeNote "Every selected policy includes exactly one fused-score occurrence. Actual magnitudes, datatype, dimension, frame and fusion-profile evidence belong to an applied account."@x-gmeow-english ;
    skos:example "A selected score key: ex:scoreCriterion gmeow:orderCriterionKind gmeow:orderFusedScore ; gmeow:orderDescending true ."@x-gmeow-english .

gmeow:orderActivation
    a logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "snapshot activation order key"@x-gmeow-english ;
    skos:definition "The snapshot-activation comparison-key kind, ordering greater source activation estimates first in the explicitly chosen precedence position. It names a retrieval-history key rather than deployment activation authority."@x-gmeow-english ;
    gmeow:useWhen "Use to include source snapshot activation estimates as an explicit comparison criterion."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating activation magnitude as confidence, truth, permission or a value read from unspecified live counters."@x-gmeow-english ;
    gmeow:howToUse "Select this kind on a criterion with orderDescending true; preserve the chosen position independently of the fused-score criterion."@x-gmeow-english ;
    skos:scopeNote "The policy definition supplies no measured estimate or snapshot. A later applied account must retain actual source snapshots, vault scope, aggregation conventions and quantitative context."@x-gmeow-english ;
    skos:example "A selected snapshot key: ex:activationCriterion gmeow:orderCriterionKind gmeow:orderActivation ; gmeow:orderDescending true ."@x-gmeow-english .

gmeow:orderSubjectTie
    a logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "source subject tie order key"@x-gmeow-english ;
    skos:definition "The terminal source-subject-tie comparison-key kind, ordering the source’s subject tie keys ascending after all other declared criteria. It does not replace those keys with canonical RDF tuple order."@x-gmeow-english ;
    gmeow:useWhen "Use as the required final comparison criterion of a complete selected policy definition."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid synthesizing subject digest bytes, assuming an arbitrary IRI lexical order or claiming a non-IRI subject is admitted by a particular source profile."@x-gmeow-english ;
    gmeow:howToUse "Select this kind on one criterion with orderDescending false and an entryOrdinal greater than every other criterion’s position."@x-gmeow-english ;
    skos:scopeNote "Actual subject identity, tie bytes and source refusal behavior belong to applied evidence. The declaration authenticates no hash recipe and supplies no missing tie value."@x-gmeow-english ;
    skos:example "A terminal tie key: ex:tieCriterion gmeow:orderCriterionKind gmeow:orderSubjectTie ; gmeow:orderDescending false ."@x-gmeow-english .

gmeow:QueryOrderCriterionOwnerLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query order criterion owner law"@x-gmeow-english ;
    skos:definition "Every query-order criterion occurrence belongs to exactly one policy sequence. Another policy requires a separate occurrence so its position, kind and direction remain local to that prescription."@x-gmeow-english ;
    gmeow:useWhen "Use to prevent a criterion occurrence from borrowing two policy contexts."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid imposing inverse ownership on reusable predicate-tier bindings or equating policies because their criteria have equal coordinates."@x-gmeow-english ;
    gmeow:howToUse "Require a fresh existing typed policy owner and compare any two policy links to the occurrence through logic:termEqual."@x-gmeow-english ;
    skos:scopeNote "The realized Formula uses one outer universal, a joined owner existential and a guarded owner-pair implication, without a positive nested universal."@x-gmeow-english ;
    skos:example "One owning policy: ex:policy gmeow:orderCriterion ex:key . ex:key a gmeow:QueryOrderCriterion ."@x-gmeow-english ;
    logic:formalizes gmeow:QueryOrderCriterion ;
    logic:message "Every query-order criterion occurrence belongs to exactly one policy sequence. Another policy requires a separate occurrence so its position, kind and direction remain local to that prescription." ;
    logic:integrity [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "leftOwner" ], [ logic:termIndex 2 ; logic:termVariable "rightOwner" ] ;
