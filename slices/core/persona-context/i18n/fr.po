msgctxt "https://blackcatinformatics.ca/gmeow/ModeTransitionActivityConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Mode transition activity constraint"
msgstr "Contrainte d’activité des transitions de persona"

msgctxt "https://blackcatinformatics.ca/gmeow/ModeTransitionActivityConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "Every ModeTransition is retained under at least one containing activity through an incoming modeTransition relation. The activity is distinct from the transition’s information record."
msgstr "Chaque ModeTransition est conservé sous au moins une activité contenante via une relation modeTransition entrante. L’activité est distincte de l’enregistrement informationnel de transition."

msgctxt "https://blackcatinformatics.ca/gmeow/ModeTransitionActivityConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to keep persona transition records attached to their occurrence context."
msgstr "Utiliser pour garder les enregistrements de transition rattachés à leur contexte de survenue."

msgctxt "https://blackcatinformatics.ca/gmeow/ModeTransitionActivityConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid treating an orphan information record as a complete contained transition."
msgstr "Éviter de traiter un enregistrement informationnel orphelin comme une transition contenue complète."

msgctxt "https://blackcatinformatics.ca/gmeow/ModeTransitionActivityConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Supply an existing activity with modeTransition pointing to the record; nested containing activities are permitted."
msgstr "Fournir une activité existante dont modeTransition pointe vers l’enregistrement ; des activités contenantes imbriquées sont permises."

msgctxt "https://blackcatinformatics.ca/gmeow/ModeTransitionActivityConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:activity gmeow:modeTransition ex:change0 ."
msgstr "ex:activity gmeow:modeTransition ex:change0 ."

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionFromBearerConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "transitionFrom bearer constraint"
msgstr "Contrainte de porteur transitionFrom"

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionFromBearerConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "The Persona referenced by transitionFrom has the same bearer as the transition slot. This preserves the identity of the agent across the recorded persona change."
msgstr "La Persona référencée par transitionFrom possède le même porteur que l’emplacement de transition. Cela préserve l’identité de l’agent durant le changement de persona enregistré."

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionFromBearerConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to prevent transitionFrom from silently changing the slot’s agent."
msgstr "Utiliser pour empêcher transitionFrom de changer silencieusement l’agent de l’emplacement."

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionFromBearerConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid using a different agent’s persona as the transitionFrom value."
msgstr "Éviter d’utiliser la persona d’un autre agent comme valeur de transitionFrom."

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionFromBearerConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Check personaBearer on the transitionFrom target against slotBearer on transitionSlot."
msgstr "Comparer personaBearer de la cible transitionFrom à slotBearer de transitionSlot."

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionFromBearerConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:change0 gmeow:transitionFrom ex:formalPersona ."
msgstr "ex:change0 gmeow:transitionFrom ex:formalPersona ."

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionToBearerConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "transitionTo bearer constraint"
msgstr "Contrainte de porteur transitionTo"

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionToBearerConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "The Persona referenced by transitionTo has the same bearer as the transition slot. This preserves the identity of the agent across the recorded persona change."
msgstr "La Persona référencée par transitionTo possède le même porteur que l’emplacement de transition. Cela préserve l’identité de l’agent durant le changement de persona enregistré."

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionToBearerConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to prevent transitionTo from silently changing the slot’s agent."
msgstr "Utiliser pour empêcher transitionTo de changer silencieusement l’agent de l’emplacement."

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionToBearerConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid using a different agent’s persona as the transitionTo value."
msgstr "Éviter d’utiliser la persona d’un autre agent comme valeur de transitionTo."

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionToBearerConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Check personaBearer on the transitionTo target against slotBearer on transitionSlot."
msgstr "Comparer personaBearer de la cible transitionTo à slotBearer de transitionSlot."

msgctxt "https://blackcatinformatics.ca/gmeow/TransitionToBearerConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:change0 gmeow:transitionTo ex:formalPersona ."
msgstr "ex:change0 gmeow:transitionTo ex:formalPersona ."

msgctxt "https://blackcatinformatics.ca/gmeow/AutomaticTransitionBoundaryConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Automatic transition boundary constraint"
msgstr "Contrainte de limite de transition automatique"

msgctxt "https://blackcatinformatics.ca/gmeow/AutomaticTransitionBoundaryConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A transition attributed to an automatic boundary change names at least one producer-reported transitionBoundary. No particular boundary is guessed."
msgstr "Une transition attribuée à un changement automatique à une limite nomme au moins une transitionBoundary rapportée par le producteur. Aucune limite particulière n’est devinée."

msgctxt "https://blackcatinformatics.ca/gmeow/AutomaticTransitionBoundaryConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain the location that explains an automatic switch."
msgstr "Utiliser pour conserver la position qui explique un changement automatique."

msgctxt "https://blackcatinformatics.ca/gmeow/AutomaticTransitionBoundaryConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid using an automatic-boundary cause without its reported boundary."
msgstr "Éviter d’utiliser une cause automatique à une limite sans sa limite rapportée."

msgctxt "https://blackcatinformatics.ca/gmeow/AutomaticTransitionBoundaryConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Keep the source’s boundary value on the same transition record."
msgstr "Conserver la valeur de limite de la source sur le même enregistrement de transition."

msgctxt "https://blackcatinformatics.ca/gmeow/AutomaticTransitionBoundaryConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:change0 gmeow:transitionBoundary ex:sourceValue ."
msgstr "ex:change0 gmeow:transitionBoundary ex:sourceValue ."

msgctxt "https://blackcatinformatics.ca/gmeow/AudienceForcedTransitionRingConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Audience-forced transition ring constraint"
msgstr "Contrainte de cercle des transitions imposées par l’audience"

msgctxt "https://blackcatinformatics.ca/gmeow/AudienceForcedTransitionRingConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "A transition attributed to audience forcing names at least one transitionRing identifying the audience context responsible. This does not infer a relationship category for a listener."
msgstr "Une transition attribuée à une contrainte d’audience nomme au moins un transitionRing identifiant le contexte d’audience responsable. Cela ne déduit aucune catégorie de relation pour un auditeur."

msgctxt "https://blackcatinformatics.ca/gmeow/AudienceForcedTransitionRingConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain the audience context behind a forced persona change."
msgstr "Utiliser pour conserver le contexte d’audience derrière un changement de persona imposé."

msgctxt "https://blackcatinformatics.ca/gmeow/AudienceForcedTransitionRingConstraint|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid satisfying a forced-change explanation by inventing a default audience ring."
msgstr "Éviter de satisfaire une explication de changement imposé en inventant un cercle d’audience par défaut."

msgctxt "https://blackcatinformatics.ca/gmeow/AudienceForcedTransitionRingConstraint|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Reference the producer’s scheme-scoped audience ring on that transition."
msgstr "Référencer le cercle d’audience du producteur limité au schéma sur cette transition."

msgctxt "https://blackcatinformatics.ca/gmeow/AudienceForcedTransitionRingConstraint|http://www.w3.org/2004/02/skos/core#example"
msgid "ex:change0 gmeow:transitionRing ex:sourceValue ."
msgstr "ex:change0 gmeow:transitionRing ex:sourceValue ."

# Source-faithful conversation records.

msgctxt "https://blackcatinformatics.ca/gmeow/personaMode|http://www.w3.org/2000/01/rdf-schema#label"
msgid "audience persona mode"
msgstr "registre de persona pour l’audience"

msgctxt "https://blackcatinformatics.ca/gmeow/personaMode|http://www.w3.org/2004/02/skos/core#definition"
msgid "The Persona register in which a particular record was made for its audience. This audience-facing expression policy is distinct from the Persona worn as state and does not select a globally preferred persona."
msgstr "Registre Persona dans lequel un enregistrement particulier a été produit pour son audience. Cette politique d’expression destinée au public se distingue de la Persona portée comme état et ne sélectionne aucune persona globalement privilégiée."

msgctxt "https://blackcatinformatics.ca/gmeow/personaMode|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this record or field."
msgstr "À employer lorsque la source fournit explicitement cet enregistrement ou ce champ."

msgctxt "https://blackcatinformatics.ca/gmeow/personaMode|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring identity, delivery, verification or execution from missing source evidence."
msgstr "Éviter de déduire identité, livraison, vérification ou exécution de preuves source manquantes."

msgctxt "https://blackcatinformatics.ca/gmeow/personaMode|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain exact source values, their scope and attribution; preserve supplied language and base direction."
msgstr "Conserver les valeurs source exactes, leur portée et leur attribution ; préserver la langue et la direction de base fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/personaMode|http://www.w3.org/2004/02/skos/core#scopeNote"
msgid "Independent source claims coexist. These declarations preserve evidence without authenticating the provider or executing its operation."
msgstr "Les déclarations source indépendantes coexistent. Ces déclarations conservent les preuves sans authentifier le fournisseur ni exécuter son opération."

msgctxt "https://blackcatinformatics.ca/gmeow/personaMode|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain the supplied value for gmeow:personaMode."
msgstr "Conserver la valeur fournie pour gmeow:personaMode."
