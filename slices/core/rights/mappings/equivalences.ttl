# --- schema.org (access conditions + digital-document permissions) --- #

gmeow:Permission skos:relatedMatch schema:DigitalDocumentPermission {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "a schema.org digital-document permission"
|} .

gmeow:hasPermission skos:relatedMatch schema:hasDigitalDocumentPermission {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "schema.org has-permission"
|} .

# --- SPDX (listed-licence detail) --- #

gmeow:License skos:closeMatch spdx:ListedLicense {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "an SPDX listed licence"
|} .

gmeow:Copyright skos:closeMatch premis:Copyright {|
    gmeow:sssomFile "gmeow-rights.sssom.tsv" ;
