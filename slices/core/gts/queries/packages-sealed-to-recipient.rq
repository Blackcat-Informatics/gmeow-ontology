# Competency (GTS transport design): which GTS documents carry content sealed to a recipient —
# and which frames could a given agent NOT read (missing-key opacity)?
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
SELECT ?document ?segment ?frame ?recipient WHERE {
    ?frame a gmeow:OpaqueFrame ;
           gmeow:opacityReason gmeow:opacityMissingKey ;
           gmeow:sealedRecipient ?recipient ;
           gmeow:opaqueFrameIn ?segment .
    ?segment gmeow:gtsSegmentOf ?document .
}
ORDER BY ?document ?segment
