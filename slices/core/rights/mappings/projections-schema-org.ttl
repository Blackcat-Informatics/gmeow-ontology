    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "alp" ;
        gmeow:atom ( [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:acquireLicensePage ; gmeow:objectVar "alp" ] ) ;
        gmeow:edoalSource gmeow:acquireLicensePage ] ;
    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:acquireLicensePage ; gmeow:relation "=" ; gmeow:confidence 0.95 ; gmeow:mnemomorphic true ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:exactMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ] .

