@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix dqv:    <http://www.w3.org/ns/dqv#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix oa:     <http://www.w3.org/ns/oa#> .
@prefix wd:     <http://www.wikidata.org/entity/> .

# Term equivalences for the data-quality layer — GMEOW authoring
# source. Compiled to mappings/gmeow-quality.sssom.tsv by `gmeow compile-mappings`.
# Aligns W3C DQV, GeoDCAT-AP quality annotations, and PROV-O lineage by reference.
# ISO 19157 dimensions have no canonical RDF namespace; they are documented as
# value correspondences in the mapping set comment rather than IRI-aligned.
#
# CONSTITUTIONAL GROUNDING:
#   P4  — canonical source in ontology/modules/quality.ttl; alignments here.
#   P5  — maximal bridging by reference; no external axioms imported.
#   P9  — quality dimensions are co-equal value individuals; none privileged.
#   P11 — dimensioned numeric assessment results use math:Quantity bundles
#         (frame+unit+determinacy); categorical results remain valid.
#   P12 — quality metrics are computed by external solvers, not in OWL.

gmeow:mapsetQuality a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/quality" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Data-quality layer alignments — ISO 19157 dimensions + lineage, bridged to W3C DQV and GeoDCAT-AP by reference.
        FORMAL GROUNDING: gmeow:QualityAssessment is a gufo:SubKind of gmeow:Observation, reusing the universal claim construct. gmeow:QualityDimension is a gufo:AbstractIndividualType / QualityValue — an open value vocabulary of individuals (never subclasses). There is no 'primary' or 'preferred' dimension (Principle 9).
        DQV FLATTENING: DQV introduces dqv:Metric between QualityMeasurement and Dimension. GMEOW flattens this (qualityDimension points directly to QualityDimension) because metric-specific metadata (thresholds, algorithms) are solver-layer concerns (Principle 12). The projection layer can expand to the full DQV chain when needed.
        ISO 19157 STATUS: ISO 19157:2013 defines completeness, logical consistency, positional accuracy, temporal accuracy, and thematic accuracy. No canonical RDF namespace exists for these dimensions; the mapping set documents their correspondence to GMEOW value individuals in the comment below. GeoDCAT-AP (http://data.europa.eu/r5r/) provides dcat:qualityAnnotation as the RDF-aligned pathway to ISO 19115/19157 quality and lineage concepts.""" ;
    gmeow:setTrailer """# ISO 19157 dimension value correspondences (no canonical RDF IRIs; documented as comments):
#   gmeow:qualityDimensionPositionalAccuracy     → ISO 19157 positional accuracy
#   gmeow:qualityDimensionTemporalAccuracy       → ISO 19157 temporal accuracy
#   gmeow:qualityDimensionThematicAccuracy       → ISO 19157 thematic accuracy
#   gmeow:qualityDimensionCompleteness           → ISO 19157 completeness
#   gmeow:qualityDimensionLogicalConsistency     → ISO 19157 logical consistency
#   gmeow:qualityDimensionTopologicalConsistency → ISO 19157 topological consistency
#   gmeow:qualityDimensionLineage                → ISO 19115 lineage (LI_Lineage)
#
# REFUSED (Principle 5 — no faithful external term): gmeow:assessedEntity has no direct DQV counterpart. DQV's dqv:computedOn expects dcat:Dataset/Distribution; GMEOW's range is gmeow:Entity (universal). The closeMatch to dqv:computedOn is annotated with a scope note.
# REFUSED (Principle 5): gmeow:qualityDimension has no exact DQV property. dqv:isMeasurementOf points to dqv:Metric, not directly to dqv:Dimension; the closeMatch carries a note about the flattening.""" .

# --------------------------------------------------------------------------- #
# W3C DQV alignments
# --------------------------------------------------------------------------- #

gmeow:QualityAssessment skos:closeMatch dqv:QualityMeasurement {|
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Both are reified quality assessments carrying a numeric or categorical result. GMEOW uses math:Quantity for dimensioned numeric results; categorical conformance statements remain valid. DQV uses dqv:value with an expectedDataType on the Metric."
|} .

gmeow:QualityDimension skos:closeMatch dqv:Dimension {|
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Both are quality dimensions — criteria for assessing data quality. GMEOW models dimensions as value individuals (gufo:QualityValue), not as OWL classes."
|} .

gmeow:assessedEntity skos:closeMatch dqv:computedOn {|
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "The entity whose quality is assessed. DQV's dqv:computedOn is generally scoped to dcat:Dataset/Distribution; GMEOW's assessedEntity is universal (any gmeow:Entity)."
|} .

gmeow:qualityDimension skos:closeMatch dqv:isMeasurementOf {|
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "GMEOW flattens the DQV chain: qualityDimension points directly to QualityDimension, bypassing the intermediate dqv:Metric node. The metric is solver-computed and lives outside the OWL core (Principle 12)."
|} .

gmeow:QualityAssessment skos:relatedMatch dqv:QualityAnnotation {|
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "DQV QualityAnnotation (a subclass of oa:Annotation) is broader — it covers ratings, certificates, and feedback, not only structured measurements. A GMEOW QualityAssessment MAY be projected to a DQV QualityAnnotation when the result is categorical or subjective."
|} .

# --------------------------------------------------------------------------- #
# GeoDCAT-AP / ISO 19157 pathway alignments
# --------------------------------------------------------------------------- #

gmeow:QualityAssessment skos:relatedMatch oa:Annotation {|
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "GeoDCAT-AP represents quality statements as dcat:qualityAnnotation pointing to oa:Annotation. GMEOW's structured QualityAssessment can be projected to an OA Annotation when targeting GeoDCAT-AP consumers."
|} .

# --------------------------------------------------------------------------- #
# PROV-O lineage bridge
# --------------------------------------------------------------------------- #

gmeow:qualityDimensionLineage skos:relatedMatch prov:wasDerivedFrom {|
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Lineage is provenance viewed through a quality lens. GMEOW records structural lineage via wasDerivedFrom / wasGeneratedBy / ImportActivity (provenance module); the qualityDimensionLineage value marks an assessment that evaluates lineage completeness or correctness."
|} .

# --------------------------------------------------------------------------- #
# Wikidata alignments for dimension seeds
# --------------------------------------------------------------------------- #

gmeow:qualityDimensionPositionalAccuracy skos:closeMatch wd:Q2401740 {|
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "spatial resolution" ;
    gmeow:comment "Wikidata 'spatial resolution' is the closest structured term for positional accuracy; it is broader (includes granularity) but captures the same spatial-quality axis."
|} .

gmeow:qualityDimensionCompleteness skos:closeMatch wd:Q194041 {|
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "completeness"
|} .

gmeow:qualityDimensionLineage skos:closeMatch wd:Q13411553 {|
    gmeow:sssomFile "gmeow-quality.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:objectLabel "provenance" ;
    gmeow:comment "Wikidata 'provenance' is the closest structured term for lineage; lineage is a quality-lens view of provenance."
|} .
