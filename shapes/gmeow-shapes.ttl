@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# SHACL shapes for the GMEOW vocabulary. The SPARQL target restricts each shape
# to GMEOW-namespaced terms so imported gUFO/peer-schema terms are not flagged.

gmeow:GmeowClassShape
    a sh:NodeShape ;
    rdfs:label "GMEOW class completeness shape" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <http://www.w3.org/2002/07/owl#Class> .
                FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
            }
        """ ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW class must carry at least one rdfs:label." ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW class must carry a skos:definition." ;
    ] ;
    sh:property [
        sh:path rdfs:isDefinedBy ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Every GMEOW class should declare rdfs:isDefinedBy the ontology." ;
    ] .

gmeow:GmeowPropertyShape
    a sh:NodeShape ;
    rdfs:label "GMEOW property completeness shape" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a ?t .
                FILTER(?t IN (
                    <http://www.w3.org/2002/07/owl#ObjectProperty>,
                    <http://www.w3.org/2002/07/owl#DatatypeProperty>
                ))
                FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
            }
        """ ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW property must carry at least one rdfs:label." ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every GMEOW property must carry a skos:definition." ;
    ] .

# --------------------------------------------------------------------------- #
# Names building block — inclusivity + anti-colonial data shapes. These target
# instance data (gmeow:PersonName individuals), so they are dormant when
# validating the term graph (the TBox has no instances) and enforce when a data
# graph is checked against these shapes.
# --------------------------------------------------------------------------- #

# A name must carry content, but a SURNAME is never required — mononyms and
# non-Western naming systems are first-class. Satisfied by a full name or any
# typed part.
gmeow:AppellationHasContentShape
    a sh:NodeShape ;
    rdfs:label "Appellation content shape (no required surname)" ;
    sh:targetClass gmeow:Appellation ;
    sh:or (
        [ sh:path gmeow:fullName ; sh:minCount 1 ]
        [ sh:path gmeow:hasNamePart ; sh:minCount 1 ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "An appellation must have a gmeow:fullName or at least one name part; a surname is never required (mononyms are valid)." .

# Deadnames and superseded names must be suppressed from display by default.
gmeow:DeadnameSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Deadname / superseded suppression shape" ;
    sh:targetClass gmeow:PersonName ;
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "A superseded name or deadname should set gmeow:displayable false." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/namePurpose> ?p .
                FILTER(?p IN (
                    <https://blackcatinformatics.ca/gmeow/namePurposeDeadname>,
                    <https://blackcatinformatics.ca/gmeow/namePurposeSuperseded>
                ))
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# =========================================================================== #
# Hybrid OWL+SHACL closed-world data shapes (#39, epic #35).
#
# These shapes are the CLOSED-WORLD counterpart of the phase-2 (#38) open-world
# OWL 2 EL axioms. A relator carries `owl:someValuesFrom` so the reasoner can
# *classify* it ("a GenderIdentity points at SOME Gender"); SHACL adds the
# cardinality the reasoner deliberately cannot enforce under the open-world
# assumption ("...at EXACTLY one Gender"). OWL infers; SHACL validates
# (Knublauch, "SHACL and OWL Compared"). Like the names shapes above, all of
# these target INSTANCE DATA, so they stay dormant when `gmeow validate` checks
# the term graph (the TBox has no instances) and bite only when a data graph is
# validated against them. See docs/reasoning.md for the full division of labour.
# =========================================================================== #

# --------------------------------------------------------------------------- #
# (a) Relator well-formedness — closed-world cardinality (CONSTITUTION P7/P8).
# Each facet relator mediates its value via EXACTLY ONE path: the value property
# is functional per facet, but OWL functionality does not REJECT a second value
# (it infers the two are owl:sameAs). SHACL minCount/maxCount enforces it.
# --------------------------------------------------------------------------- #

gmeow:GenderIdentityFacetShape
    a sh:NodeShape ;
    rdfs:label "GenderIdentity well-formedness shape" ;
    sh:targetClass gmeow:GenderIdentity ;
    sh:property [
        sh:path gmeow:genderValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A GenderIdentity facet must point at exactly one gmeow:Gender value (gmeow:genderValue)." ;
    ] .

gmeow:GenderExpressionFacetShape
    a sh:NodeShape ;
    rdfs:label "GenderExpression well-formedness shape" ;
    sh:targetClass gmeow:GenderExpression ;
    sh:property [
        sh:path gmeow:expressionValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A GenderExpression facet must point at exactly one gmeow:GenderExpressionStyle value (gmeow:expressionValue)." ;
    ] .

gmeow:SexualOrientationFacetShape
    a sh:NodeShape ;
    rdfs:label "SexualOrientation well-formedness shape" ;
    sh:targetClass gmeow:SexualOrientation ;
    sh:property [
        sh:path gmeow:sexualOrientationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A SexualOrientation facet must point at exactly one gmeow:SexualOrientationValue (gmeow:sexualOrientationValue)." ;
    ] .

gmeow:RomanticOrientationFacetShape
    a sh:NodeShape ;
    rdfs:label "RomanticOrientation well-formedness shape" ;
    sh:targetClass gmeow:RomanticOrientation ;
    sh:property [
        sh:path gmeow:romanticOrientationValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A RomanticOrientation facet must point at exactly one gmeow:RomanticOrientationValue (gmeow:romanticOrientationValue)." ;
    ] .

# The NameUsage relator binds {who is named} × {which appellation}; both relata
# are required and single-valued per usage (a distinct usage is minted per
# audience/register). Audience, register and period stay optional.
gmeow:NameUsageShape
    a sh:NodeShape ;
    rdfs:label "NameUsage well-formedness shape" ;
    sh:targetClass gmeow:NameUsage ;
    sh:property [
        sh:path gmeow:usageNamed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A NameUsage must name exactly one entity (gmeow:usageNamed)." ;
    ] ;
    sh:property [
        sh:path gmeow:usageAppellation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A NameUsage must use exactly one appellation (gmeow:usageAppellation)." ;
    ] .

# A NotationSystemUsage mediates exactly one target and one notation system
# (mirrors the someValuesFrom on notationUsageTarget and notationUsageNotationSystem).
gmeow:NotationSystemUsageShape
    a sh:NodeShape ;
    rdfs:label "NotationSystemUsage well-formedness shape" ;
    sh:targetClass gmeow:NotationSystemUsage ;
    sh:property [
        sh:path gmeow:notationUsageTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A NotationSystemUsage must target exactly one entity (gmeow:notationUsageTarget)." ;
    ] ;
    sh:property [
        sh:path gmeow:notationUsageNotationSystem ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A NotationSystemUsage must bind exactly one notation system (gmeow:notationUsageNotationSystem)." ;
    ] ;
    sh:property [
        sh:path gmeow:notationUsageRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A NotationSystemUsage must declare exactly one role (gmeow:notationUsageRole)." ;
    ] ;
    sh:property [
        sh:path gmeow:notationUsageInterval ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A NotationSystemUsage must bind exactly one time interval (gmeow:notationUsageInterval)." ;
    ] .

# --------------------------------------------------------------------------- #
# (b) Suppression / display contract (CONSTITUTION P10 — suppression, never
# erasure). The IdentityFacet sibling of DeadnameSuppressionShape: a facet that
# has been superseded (it carries gmeow:validUntil) must be suppressed from
# display (gmeow:displayable false) rather than deleted. Warning, like the
# deadname shape — a source may legitimately lag on setting the flag.
# --------------------------------------------------------------------------- #

# Targets the four concrete IdentityFacet axes directly (not the abstract base):
# a closed-world data check runs without subclass inference, so an instance typed
# only as gmeow:GenderIdentity would not match a gmeow:IdentityFacet target.
gmeow:SupersededFacetSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Superseded identity-facet suppression shape" ;
    sh:targetClass gmeow:GenderIdentity ;
    sh:targetClass gmeow:GenderExpression ;
    sh:targetClass gmeow:SexualOrientation ;
    sh:targetClass gmeow:RomanticOrientation ;
    sh:severity sh:Warning ;   # NodeShape-level so pyshacl honors it (a source may lag the flag)
    sh:sparql [
        sh:message "A superseded identity facet (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/validUntil> ?until .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# (c) Orthogonality data-check (CONSTITUTION P9 — anti-overtyping). The
# closed-world counterpart of the 7-axis owl:AllDisjointClasses matrix: it
# catches an individual placed in two disjoint identity axes WITHOUT a reasoner
# (HermiT proves the same as an inconsistency — see
# tests/test_reasoning_entailments.py::test_two_axis_individual_is_inconsistent).
# --------------------------------------------------------------------------- #

gmeow:IdentityAxisOrthogonalityShape
    a sh:NodeShape ;
    rdfs:label "Identity-axis orthogonality data-check" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a ?axis .
                FILTER(?axis IN (
                    <https://blackcatinformatics.ca/gmeow/GenderIdentity>,
                    <https://blackcatinformatics.ca/gmeow/GenderExpression>,
                    <https://blackcatinformatics.ca/gmeow/SexAssignedAtBirth>,
                    <https://blackcatinformatics.ca/gmeow/SexualOrientation>,
                    <https://blackcatinformatics.ca/gmeow/RomanticOrientation>,
                    <https://blackcatinformatics.ca/gmeow/PronounSet>,
                    <https://blackcatinformatics.ca/gmeow/Honorific>
                ))
            }
        """ ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "An individual may fill at most one identity axis; these seven axes are orthogonal and disjoint (no overtyping)." ;
        sh:select """
            SELECT $this WHERE {
                $this a ?a , ?b .
                FILTER(STR(?a) < STR(?b))   # ordered pair: one result per violation, not two
                FILTER(?a IN (
                    <https://blackcatinformatics.ca/gmeow/GenderIdentity>,
                    <https://blackcatinformatics.ca/gmeow/GenderExpression>,
                    <https://blackcatinformatics.ca/gmeow/SexAssignedAtBirth>,
                    <https://blackcatinformatics.ca/gmeow/SexualOrientation>,
                    <https://blackcatinformatics.ca/gmeow/RomanticOrientation>,
                    <https://blackcatinformatics.ca/gmeow/PronounSet>,
                    <https://blackcatinformatics.ca/gmeow/Honorific>
                ))
                FILTER(?b IN (
                    <https://blackcatinformatics.ca/gmeow/GenderIdentity>,
                    <https://blackcatinformatics.ca/gmeow/GenderExpression>,
                    <https://blackcatinformatics.ca/gmeow/SexAssignedAtBirth>,
                    <https://blackcatinformatics.ca/gmeow/SexualOrientation>,
                    <https://blackcatinformatics.ca/gmeow/RomanticOrientation>,
                    <https://blackcatinformatics.ca/gmeow/PronounSet>,
                    <https://blackcatinformatics.ca/gmeow/Honorific>
                ))
            }
        """ ;
    ] .

# =========================================================================== #
# Standpoint / contested-claims data shapes (#43). The OWL-infers / SHACL-
# validates split applies: SHACL only ever REJECTS closed-world malformations,
# so "contradictory standpoint claims are allowed" is NOT a shape — it is proven
# by a passing positive fixture (tests/test_standpoint.py). The marker shape
# below records that intent where a reader looks; it enforces nothing. All other
# shapes here target INSTANCE DATA and stay dormant on the TBox term graph.
# =========================================================================== #

# (a) Coexistence is explicitly permitted — a documented NO-OP marker (no target,
# no constraint). Contradictory gmeow:accordingTo-scoped claims over the same
# subject/predicate are co-equal and must NOT be flagged; there is deliberately
# no shape constraining their coexistence (Principle 9 — no single slot to win).
gmeow:StandpointCoexistenceShape
    a sh:NodeShape ;
    rdfs:label "Standpoint coexistence marker (no-op)" ;
    rdfs:comment "Documentation only — asserts and enforces nothing. Contradictory gmeow:accordingTo-scoped claims over the same subject/predicate are explicitly permitted and are NOT a violation (Principle 9). Coexistence is proven by the positive fixture in tests/test_standpoint.py, not by a SHACL constraint, because the OWL-infers / SHACL-validates split means SHACL only rejects malformations." .

# (b) StandpointTenure well-formedness — closed-world cardinality. Mirrors
# NameUsageShape; the OWL EL someValuesFrom in standpoint.ttl classifies, SHACL
# enforces "exactly one standpoint".
gmeow:StandpointTenureShape
    a sh:NodeShape ;
    rdfs:label "StandpointTenure well-formedness shape" ;
    sh:targetClass gmeow:StandpointTenure ;
    sh:property [
        sh:path gmeow:tenureStandpoint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A StandpointTenure must record exactly one standpoint (gmeow:tenureStandpoint)." ;
    ] ;
    sh:property [
        sh:path gmeow:standpointClaim ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:StandpointClaim ;
        sh:severity sh:Violation ;
        sh:message "A StandpointTenure must record exactly one generated StandpointClaim (gmeow:standpointClaim)." ;
    ] .

# (c) No preferred / primary claim (Principle 9). Fires on any GMEOW-namespace
# predicate whose local name begins with "primary" / "preferred" — the forward
# guard against ever re-creating the single winning slot the edit war is fought
# over (the data-graph twin of the statement-DSL no_preferred_rank lint and the
# term-absence test). No such term exists today, so this is dormant.
gmeow:NoPreferredClaimShape
    a sh:NodeShape ;
    rdfs:label "No preferred / primary claim shape" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this ?p ?o .
                FILTER(STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/primary")
                    || STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/preferred"))
            }
        """ ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "No claim may be marked preferred/primary; standpoint-indexed claims are co-equal — there is no single slot to win (Principle 9)." ;
        sh:select """
            SELECT $this WHERE {
                $this ?p ?o .
                FILTER(STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/primary")
                    || STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/preferred"))
            }
        """ ;
    ] .

# =========================================================================== #
# Coreference data shapes (#74). Bare authorityLink is allowed but warned: an
# authority pointer should say whether it is exact or close. The semantics stay
# data-level because match strength may be attributed, confidence-weighted, or
# standpoint-indexed in statement metadata.
# =========================================================================== #

gmeow:AuthorityLinkMatchStrengthShape
    a sh:NodeShape ;
    rdfs:label "Authority link match-strength shape" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this <https://blackcatinformatics.ca/gmeow/authorityLink> ?auth .
            }
        """ ;
    ] ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "An authority link should also assert skos:exactMatch or skos:closeMatch to record coreference strength." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/authorityLink> ?auth .
                FILTER NOT EXISTS {
                    $this <http://www.w3.org/2004/02/skos/core#exactMatch> ?auth
                }
                FILTER NOT EXISTS {
                    $this <http://www.w3.org/2004/02/skos/core#closeMatch> ?auth
                }
            }
        """ ;
    ] .

# (d) Withdrawn-standpoint suppression (Principle 10 — suppression, never
# erasure). The StandpointTenure sibling of SupersededFacetSuppressionShape: a
# tenure whose interval has ended (a withdrawn position) should set
# gmeow:displayable false rather than be deleted. Warning — a source may lag.
gmeow:WithdrawnStandpointSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Withdrawn standpoint suppression shape" ;
    sh:targetClass gmeow:StandpointTenure ;
    sh:severity sh:Warning ;   # NodeShape-level so pyshacl honors it (a source may lag the flag)
    sh:sparql [
        sh:message "A withdrawn standpoint (a StandpointTenure whose interval has ended) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/duringInterval> ?iv .
                ?iv <https://blackcatinformatics.ca/gmeow/endedAtTime> ?end .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Events module (#41). Closed-world well-formedness for the universal event +
# its Participation relator; the standpoint coexistence / no-preferred-claim
# guards (StandpointCoexistenceShape, NoPreferredClaimShape) are generic and
# already cover contested eventType / participationRole claims.
# --------------------------------------------------------------------------- #

# A Participation must mediate exactly one event and at least one participant —
# the closed-world counterpart of the EL someValuesFrom mediation axiom in
# events.ttl (mirrors gmeow:NameUsageShape).
gmeow:ParticipationHasPlayersShape
    a sh:NodeShape ;
    rdfs:label "Participation well-formedness shape" ;
    sh:targetClass gmeow:Participation ;
    sh:property [
        sh:path gmeow:participationEvent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Participation must be part of exactly one event (gmeow:participationEvent)." ;
    ] ;
    sh:property [
        sh:path gmeow:participationParticipant ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Participation must have at least one participant (gmeow:participationParticipant)." ;
    ] .

# An event should carry at least a type or some temporal placement — otherwise it
# is an unanchored occurrence. Warning (a stub event may be fleshed out later).
gmeow:EventHasTypeOrTimeShape
    a sh:NodeShape ;
    rdfs:label "Event has type or time shape" ;
    sh:targetClass gmeow:Event ;
    sh:severity sh:Warning ;
    sh:or (
        [ sh:path gmeow:eventType ; sh:minCount 1 ]
        [ sh:path gmeow:eventTime ; sh:minCount 1 ]
        [ sh:path gmeow:eventInterval ; sh:minCount 1 ]
        [ sh:path gmeow:earliestStart ; sh:minCount 1 ]
        [ sh:path gmeow:latestEnd ; sh:minCount 1 ]
    ) ;
    sh:message "An event should carry at least a gmeow:eventType or a temporal placement (gmeow:eventTime / eventInterval / earliestStart / latestEnd)." .

# Suppression, never erasure (Principle 10): a superseded participation claim — a
# corrected participant, role, or date carried on a Participation that has ended
# (gmeow:validUntil) — should set gmeow:displayable false rather than be deleted.
# The events sibling of SupersededFacetSuppressionShape. Warning (a source may lag).
gmeow:CorrectedEventSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Corrected / superseded participation suppression shape" ;
    sh:targetClass gmeow:Participation ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A superseded participation (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/validUntil> ?until .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Rights / IP module (#21). Closed-world well-formedness for the rights relators
# (the SHACL counterpart of the EL someValuesFrom mediation axioms in rights.ttl),
# plus an expired-right suppression warning (Principle 10). The generic
# NoPreferredClaimShape already forbids any preferred / primary right (Principle 9).
# --------------------------------------------------------------------------- #

# A RightsStatement governs exactly one asset (mirrors the someValuesFrom on
# gmeow:statementAbout).
gmeow:RightsStatementShape
    a sh:NodeShape ;
    rdfs:label "RightsStatement well-formedness shape" ;
    sh:targetClass gmeow:RightsStatement ;
    sh:property [
        sh:path gmeow:statementAbout ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A RightsStatement must govern exactly one asset (gmeow:statementAbout)." ;
    ] .

# Every deontic rule regulates exactly one action (mirrors the someValuesFrom on
# gmeow:ruleAction). Targets the concrete rule kinds directly — pyshacl does not
# infer subclass membership, so targeting the abstract gmeow:Rule would miss
# instances typed only as Permission / Prohibition / Duty.
gmeow:RuleHasActionShape
    a sh:NodeShape ;
    rdfs:label "Rule well-formedness shape" ;
    sh:targetClass gmeow:Permission ;
    sh:targetClass gmeow:Prohibition ;
    sh:targetClass gmeow:Duty ;
    sh:property [
        sh:path gmeow:ruleAction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A rule (Permission / Prohibition / Duty) must regulate exactly one action (gmeow:ruleAction)." ;
    ] .

# A Copyright relator mediates exactly one work and at least one holder.
gmeow:CopyrightShape
    a sh:NodeShape ;
    rdfs:label "Copyright well-formedness shape" ;
    sh:targetClass gmeow:Copyright ;
    sh:property [
        sh:path gmeow:copyrightWork ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Copyright must be about exactly one work (gmeow:copyrightWork)." ;
    ] ;
    sh:property [
        sh:path gmeow:copyrightHolder ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Copyright must have at least one holder (gmeow:copyrightHolder)." ;
    ] .

# A Licence is granted by at least one licensor (its other parties / work are
# optional — a blanket or open licence need not name a licensee).
gmeow:LicenseShape
    a sh:NodeShape ;
    rdfs:label "License well-formedness shape" ;
    sh:targetClass gmeow:License ;
    sh:property [
        sh:path gmeow:licensor ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A License must name at least one licensor (gmeow:licensor)." ;
    ] .

# A Trademark mediates exactly one mark and at least one holder.
gmeow:TrademarkShape
    a sh:NodeShape ;
    rdfs:label "Trademark well-formedness shape" ;
    sh:targetClass gmeow:Trademark ;
    sh:property [
        sh:path gmeow:trademarkMark ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Trademark must be about exactly one mark (gmeow:trademarkMark)." ;
    ] ;
    sh:property [
        sh:path gmeow:trademarkHolder ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Trademark must have at least one holder (gmeow:trademarkHolder)." ;
    ] .

# Suppression, never erasure (Principle 10): an expired / cancelled trademark
# should set gmeow:displayable false rather than be deleted. Warning (a source
# may lag the status change).
gmeow:ExpiredTrademarkSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Expired / cancelled trademark suppression shape" ;
    sh:targetClass gmeow:Trademark ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "An expired or cancelled trademark should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/trademarkStatus> ?st .
                FILTER( ?st IN (
                    <https://blackcatinformatics.ca/gmeow/trademarkStatusExpired>,
                    <https://blackcatinformatics.ca/gmeow/trademarkStatusCancelled> ) )
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# Constraint algebra well-formedness (#21) — the SHACL counterpart of the EL
# someValuesFrom mediation axioms on gmeow:AtomicConstraint / gmeow:LogicalConstraint.
gmeow:AtomicConstraintShape
    a sh:NodeShape ;
    rdfs:label "Atomic constraint well-formedness shape" ;
    sh:targetClass gmeow:AtomicConstraint ;
    sh:property [
        sh:path gmeow:leftOperand ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
        sh:message "An atomic constraint must have exactly one gmeow:leftOperand." ;
    ] ;
    sh:property [
        sh:path gmeow:constraintOperator ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
        sh:message "An atomic constraint must have exactly one gmeow:constraintOperator." ;
    ] ;
    # Exactly one right-hand side: a literal value XOR an IRI reference.
    sh:xone (
        [ sh:property [ sh:path gmeow:rightOperand ;
            sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
            sh:message "An atomic constraint must have exactly one gmeow:rightOperand when no reference is given." ] ]
        [ sh:property [ sh:path gmeow:rightOperandReference ;
            sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
            sh:message "An atomic constraint must have exactly one gmeow:rightOperandReference when no literal value is given." ] ]
    ) .

gmeow:LogicalConstraintShape
    a sh:NodeShape ;
    rdfs:label "Logical constraint well-formedness shape" ;
    sh:targetClass gmeow:LogicalConstraint ;
    sh:property [
        sh:path gmeow:constraintLogic ;
        sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Violation ;
        sh:message "A logical constraint must have exactly one gmeow:constraintLogic operator." ;
    ] ;
    sh:property [
        sh:path gmeow:logicConstraintMember ;
        sh:minCount 2 ; sh:severity sh:Violation ;
        sh:message "A logical constraint must combine at least two member constraints." ;
    ] .

gmeow:InternalLanguageTagShape
    a sh:NodeShape ;
    rdfs:label "GMEOW internal language tag validation shape" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT DISTINCT ?this WHERE {
                ?this ?p ?value .
                FILTER (STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/"))
                FILTER (isLiteral(?value) && lang(?value) != "")
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Literals in GMEOW must use the 'x-gmeow-' private-use prefix for language tags." ;
        sh:select """
            SELECT $this ?value
            WHERE {
                $this ?p ?value .
                FILTER (STRSTARTS(STR(?p), "https://blackcatinformatics.ca/gmeow/"))
                FILTER (isLiteral(?value) && lang(?value) != "" && !regex(lang(?value), "^x-gmeow-[a-z0-9\\\\-]+$", "i"))
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Reference Frame Profile & Novel Realm SHACL Shapes (#65)
# --------------------------------------------------------------------------- #

gmeow:FrameProfileShape
    a sh:NodeShape ;
    rdfs:label "Reference Frame Profile Shape" ;
    sh:targetClass gmeow:ReferenceFrame ;
    sh:property [
        sh:path gmeow:frameRealm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:FrameRealm ;
        sh:severity sh:Violation ;
        sh:message "A reference frame must declare its frame realm." ;
    ] ;
    sh:property [
        sh:path gmeow:hasAxis ;
        sh:minCount 1 ;
        sh:class gmeow:Axis ;
        sh:severity sh:Violation ;
        sh:message "A reference frame must have at least one coordinate axis." ;
    ] ;
    sh:property [
        sh:path gmeow:dimensionCount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:severity sh:Violation ;
        sh:message "A reference frame must declare exactly one dimension count." ;
    ] ;
    sh:property [
        sh:path gmeow:frameKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:FrameKind ;
        sh:severity sh:Violation ;
        sh:message "A reference frame must declare its frame kind." ;
    ] ;
    sh:property [
        sh:path gmeow:requiresHost ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:severity sh:Violation ;
        sh:message "A reference frame must declare whether it requires a host." ;
    ] ;
    sh:property [
        sh:path gmeow:parentFrame ;
        sh:maxCount 1 ;
        sh:class gmeow:ReferenceFrame ;
        sh:severity sh:Violation ;
        sh:message "A reference frame may have at most one parent frame." ;
    ] ;
    sh:property [
        sh:path gmeow:transformsTo ;
        sh:class gmeow:ReferenceFrame ;
        sh:severity sh:Violation ;
        sh:message "A reference frame transformation target must be another reference frame." ;
    ] ;
    sh:property [
        sh:path gmeow:determinacyModel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Determinacy ;
        sh:severity sh:Violation ;
        sh:message "A reference frame must declare its determinacy model." ;
    ] ;
    sh:property [
        sh:path gmeow:hasMetricKind ;
        sh:maxCount 1 ;
        sh:class gmeow:MetricKind ;
        sh:severity sh:Violation ;
        sh:message "A reference frame may declare at most one metric kind." ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A reference frame's dimension count must equal its number of coordinate axes." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/dimensionCount> ?dimensionCount .
                {
                    SELECT $this (COUNT(DISTINCT ?axis) AS ?axisCount)
                    WHERE {
                        $this <https://blackcatinformatics.ca/gmeow/hasAxis> ?axis .
                    }
                    GROUP BY $this
                }
                FILTER(?dimensionCount != ?axisCount)
            }
        """ ;
    ] .

gmeow:NarrativeReferenceFrameShape
    a sh:NodeShape ;
    rdfs:label "Narrative Reference Frame Shape" ;
    sh:targetClass gmeow:NarrativeReferenceFrame ;
    sh:property [
        sh:path gmeow:frameRealm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue gmeow:frameRealmNarrative ;
        sh:severity sh:Violation ;
        sh:message "A NarrativeReferenceFrame must declare gmeow:frameRealmNarrative." ;
    ] ;
    sh:property [
        sh:path gmeow:frameKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue gmeow:frameKindNarrative ;
        sh:severity sh:Violation ;
        sh:message "A NarrativeReferenceFrame must declare gmeow:frameKindNarrative." ;
    ] .

gmeow:NarrativeFrameLinkShape
    a sh:NodeShape ;
    rdfs:label "Narrative Frame Link Shape" ;
    sh:targetClass gmeow:NarrativeFrameLink ;
    sh:property [
        sh:path gmeow:narrativeFrameLinkSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:NarrativeReferenceFrame ;
        sh:severity sh:Violation ;
        sh:message "A NarrativeFrameLink must have exactly one gmeow:narrativeFrameLinkSource." ;
    ] ;
    sh:property [
        sh:path gmeow:narrativeFrameLinkTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:NarrativeReferenceFrame ;
        sh:severity sh:Violation ;
        sh:message "A NarrativeFrameLink must have exactly one gmeow:narrativeFrameLinkTarget." ;
    ] ;
    sh:property [
        sh:path gmeow:narrativeFrameLinkRelation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:NarrativeFrameRelation ;
        sh:severity sh:Violation ;
        sh:message "A NarrativeFrameLink must have exactly one gmeow:narrativeFrameLinkRelation." ;
    ] .

gmeow:PoseShape
    a sh:NodeShape ;
    rdfs:label "Pose well-formedness shape" ;
    sh:targetClass gmeow:Pose ;
    sh:property [
        sh:path gmeow:hasPosePosition ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:SpatialCoordinates ;
        sh:severity sh:Violation ;
        sh:message "A Pose must have exactly one position (gmeow:hasPosePosition) as SpatialCoordinates." ;
    ] ;
    sh:property [
        sh:path gmeow:hasPoseOrientation ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:Orientation ;
        sh:severity sh:Violation ;
        sh:message "A Pose must have exactly one orientation (gmeow:hasPoseOrientation) as Orientation." ;
    ] ;
    sh:property [
        sh:path gmeow:poseFrame ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:class gmeow:ReferenceFrame ;
        sh:severity sh:Violation ;
        sh:message "A Pose must declare exactly one reference frame (gmeow:poseFrame)." ;
    ] .

gmeow:OrientationShape
    a sh:NodeShape ;
    rdfs:label "Orientation well-formedness shape" ;
    sh:targetClass gmeow:Orientation ;
    sh:or (
        [ sh:and (
            [ sh:path gmeow:quaternionX ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ]
            [ sh:path gmeow:quaternionY ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ]
            [ sh:path gmeow:quaternionZ ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ]
            [ sh:path gmeow:quaternionW ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ]
        ) ]
        [ sh:and (
            [ sh:path gmeow:yaw   ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ]
            [ sh:path gmeow:pitch ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ]
            [ sh:path gmeow:roll  ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ]
            [ sh:path gmeow:eulerOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        ) ]
        [ sh:path gmeow:heading ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ]
        [ sh:path gmeow:bearing ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ]
        [ sh:path gmeow:hasCoordinateMatrix ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "An Orientation must carry at least one of: a complete unit quaternion (x,y,z,w); complete Euler angles with eulerOrder (yaw,pitch,roll,order); a heading; a bearing; or a homogeneous coordinate matrix." .

gmeow:ProfileShape
    a sh:NodeShape ;
    rdfs:label "Profile well-formedness shape" ;
    sh:targetClass gmeow:Profile ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Profile must carry at least one rdfs:label."
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Profile must carry a skos:definition."
    ] ;
    sh:property [
        sh:path gmeow:profileAppliesTo ;
        sh:nodeKind sh:IRI ;
        sh:class owl:Class ;
        sh:severity sh:Violation ;
        sh:message "When a Profile declares gmeow:profileAppliesTo, the value must be an owl:Class."
    ] ;
    sh:property [
        sh:path gmeow:profileDescriptor ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Profile must declare at least one descriptor property (gmeow:profileDescriptor)."
    ] .

gmeow:ProfileOpenValueUseShape
    a sh:NodeShape ;
    rdfs:label "Profile open-value use guard" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?profile <https://blackcatinformatics.ca/gmeow/profileOpenValue> ?openClass .
                ?this a ?openClass .
            }
        """
    ] ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Open value individuals must be referenced by at least one profile descriptor — extensibility-by-construction guard." ;
        sh:select """
            SELECT $this WHERE {
                ?profile <https://blackcatinformatics.ca/gmeow/profileOpenValue> ?openClass .
                $this a ?openClass .
                FILTER NOT EXISTS {
                    ?profile <https://blackcatinformatics.ca/gmeow/profileDescriptor> ?descriptor .
                    [] ?descriptor $this .
                }
            }
        """
    ] .

# Disclosure control by generalization (#72, P10) + granularity axis (#79).
# coarsenTo and hasGranularity are domain-free, so target their subjects directly:
# whatever carries them, the value must be a gmeow:GranularityLevel.
gmeow:CoarsenToShape
    a sh:NodeShape ;
    rdfs:label "coarsenTo disclosure-control well-formedness shape" ;
    sh:targetSubjectsOf gmeow:coarsenTo ;
    sh:property [
        sh:path gmeow:coarsenTo ;
        sh:class gmeow:GranularityLevel ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "gmeow:coarsenTo must point at a single gmeow:GranularityLevel — the coarsest level the value may be disclosed at; multiple, possibly conflicting, markers are ill-formed." ;
    ] ;
    # Reachability (warning): coarsening replaces the precise value with an enclosing
    # ancestor at the target level. If no gmeow:containedInPlace+ ancestor carries that
    # gmeow:hasGranularity, the precise value is suppressed with nothing to put in its
    # place — silent precision loss. Warn rather than fail (the ancestor may be supplied
    # by a separate graph, or coarsening deferred to the solver).
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "A gmeow:coarsenTo target level is not reachable: no gmeow:containedInPlace+ ancestor carries a matching gmeow:hasGranularity, so the value would be suppressed with no coarser replacement." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/coarsenTo> ?lvl .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/containedInPlace>+ ?ancestor .
                    ?ancestor <https://blackcatinformatics.ca/gmeow/hasGranularity> ?lvl .
                }
            }
        """ ;
    ] .

gmeow:HasGranularityShape
    a sh:NodeShape ;
    rdfs:label "hasGranularity facet well-formedness shape" ;
    sh:targetSubjectsOf gmeow:hasGranularity ;
    sh:property [
        sh:path gmeow:hasGranularity ;
        sh:class gmeow:GranularityLevel ;
        sh:severity sh:Violation ;
        sh:message "gmeow:hasGranularity must point at a gmeow:GranularityLevel — the value's own resolution level." ;
    ] .
# --------------------------------------------------------------------------- #
# Privacy / consent / redaction shapes (#73, PRIV-GEN).
#
# These target instance data and stay dormant on the TBox. Sensitive-value
# coarsening is a Warning (a source may legitimately publish sensitive data
# under explicit consent). Consent well-formedness is a Warning (a source may
# supply incomplete metadata). Privacy-notice attribution is a Warning.
# --------------------------------------------------------------------------- #

# A value marked sensitive-personal SHOULD carry a disclosure-control directive
# (coarsenTo or displayable false). Warning — a source may publish under consent.
gmeow:SensitiveValueShape
    a sh:NodeShape ;
    rdfs:label "Sensitive value disclosure-control shape" ;
    sh:targetSubjectsOf gmeow:hasSensitivity ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A value marked gmeow:sensitivitySensitivePersonal should also carry gmeow:coarsenTo or gmeow:displayable false — the trigger for projection-time redaction (Principle 10). A source may legitimately publish the precise value under explicit consent." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/hasSensitivity> <https://blackcatinformatics.ca/gmeow/sensitivitySensitivePersonal> .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/coarsenTo> ?lvl
                }
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# A privacy notice SHOULD declare who issued it.
gmeow:PrivacyNoticeShape
    a sh:NodeShape ;
    rdfs:label "Privacy notice attribution shape" ;
    sh:targetClass gmeow:PrivacyNotice ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A privacy notice should declare who issued it (dcterms:creator or gmeow:wasAttributedTo)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this <http://purl.org/dc/terms/creator> ?creator
                }
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/wasAttributedTo> ?att
                }
            }
        """ ;
    ] .

# Consent metadata well-formedness — Warning because incomplete consent metadata
# is allowed (a source may supply it later).
gmeow:ConsentWellformednessShape
    a sh:NodeShape ;
    rdfs:label "Consent metadata well-formedness shape" ;
    sh:targetClass gmeow:RightsStatement ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A consent-governing rights statement (one with a permission whose gmeow:ruleAction is gmeow:actionProcessPersonalData) should name exactly one data subject (gmeow:hasDataSubject) and at least one data controller (gmeow:hasDataController)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/hasPermission> ?perm .
                ?perm <https://blackcatinformatics.ca/gmeow/ruleAction> <https://blackcatinformatics.ca/gmeow/actionProcessPersonalData> .
                OPTIONAL { $this <https://blackcatinformatics.ca/gmeow/hasDataSubject> ?subj }
                OPTIONAL { $this <https://blackcatinformatics.ca/gmeow/hasDataController> ?ctrl }
            }
            GROUP BY $this
            HAVING (COUNT(DISTINCT ?subj) != 1 || COUNT(DISTINCT ?ctrl) < 1)
        """ ;
    ] .

# =========================================================================== #
# Temporal kernel data shapes (#67)
# =========================================================================== #

# A TemporalFrame must carry exactly one TimeScale (calendar and reference
# position are optional). Functional at the frame, not global.
gmeow:TemporalFrameShape
    a sh:NodeShape ;
    rdfs:label "TemporalFrame well-formedness shape" ;
    sh:targetClass gmeow:TemporalFrame ;
    sh:property [
        sh:path gmeow:frameTimeScale ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:TimeScale ;
        sh:severity sh:Violation ;
        sh:message "A TemporalFrame must have exactly one gmeow:frameTimeScale." ;
    ] ;
    sh:property [
        sh:path gmeow:frameRealm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:FrameRealm ;
        sh:severity sh:Violation ;
        sh:message "A TemporalFrame must have exactly one gmeow:frameRealm (inherited from ReferenceFrame)." ;
    ] ;
    sh:property [
        sh:path gmeow:frameKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:FrameKind ;
        sh:severity sh:Violation ;
        sh:message "A TemporalFrame must have exactly one gmeow:frameKind (inherited from ReferenceFrame)." ;
    ] .

# An Instant must carry at least one of instantValue (xsd:dateTime) or edtfValue
# (EDTF literal). It should also be linked to a TemporalFrame when non-default.
gmeow:InstantShape
    a sh:NodeShape ;
    rdfs:label "Instant well-formedness shape" ;
    sh:targetClass gmeow:Instant ;
    sh:or (
        [ sh:path gmeow:instantValue ; sh:minCount 1 ; sh:datatype xsd:dateTime ]
        [ sh:path gmeow:edtfValue ; sh:minCount 1 ; sh:datatype xsd:string ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "An Instant must have either gmeow:instantValue (xsd:dateTime) or gmeow:edtfValue (EDTF literal), or both." .

# A NamedPeriod needs bounds (start+end) OR a temporal measurement.
gmeow:NamedPeriodShape
    a sh:NodeShape ;
    rdfs:label "NamedPeriod well-formedness shape" ;
    sh:targetClass gmeow:NamedPeriod ;
    sh:or (
        [
            sh:and (
                [ sh:path gmeow:periodStart ; sh:minCount 1 ; sh:class gmeow:Instant ]
                [ sh:path gmeow:periodEnd ; sh:minCount 1 ; sh:class gmeow:Instant ]
            )
        ]
        [ sh:path gmeow:hasTemporalMeasurement ; sh:minCount 1 ; sh:class gmeow:TemporalMeasurement ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A NamedPeriod must have either (periodStart + periodEnd) or at least one gmeow:hasTemporalMeasurement." .

# =========================================================================== #
# Observation module data shapes (#66)
# =========================================================================== #

# An Observation must mediate at least a vantage and an observedFeature.
# Closed-world cardinality: exactly one observed feature (the SHACL counterpart
# of the EL someValuesFrom axioms in observations.ttl).
#
# #69 — Observation is now the universal claim construct. The base shape targets
# DIRECT Observation instances only (not subclasses), because subclass-specific
# properties (usageNamer, facetVantage, statementAbout, relationshipParent)
# bridge to vantage/observedFeature via rdfs:subPropertyOf in the reasoned core,
# but SHACL runs without OWL inference. Each subclass has its own shape below.
gmeow:ObservationShape
    a sh:NodeShape ;
    rdfs:label "Observation well-formedness shape" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://blackcatinformatics.ca/gmeow/Observation> .
                FILTER NOT EXISTS {
                    ?this a ?sub .
                    ?sub <http://www.w3.org/2000/01/rdf-schema#subClassOf>+ <https://blackcatinformatics.ca/gmeow/Observation> .
                    FILTER (?sub != <https://blackcatinformatics.ca/gmeow/Observation>)
                }
            }
        """ ;
    ] ;
    sh:property [
        sh:path gmeow:vantage ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Observation must record at least one vantage (gmeow:vantage)." ;
    ] ;
    sh:property [
        sh:path gmeow:observedFeature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Observation must record exactly one observed feature (gmeow:observedFeature)." ;
    ] .

# Core observation kinds (Measurement, SensoryObservation, StandpointClaim) still
# require a method — they are the original observation stack.
gmeow:CoreObservationMethodShape
    a sh:NodeShape ;
    rdfs:label "Core observation method shape" ;
    sh:targetClass gmeow:Measurement ;
    sh:targetClass gmeow:SensoryObservation ;
    sh:targetClass gmeow:StandpointClaim ;
    sh:targetClass gmeow:TemporalMeasurement ;
    sh:property [
        sh:path gmeow:observationMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:ObservationMethod ;
        sh:severity sh:Violation ;
        sh:message "A core observation (measurement, sensory, standpoint claim, or temporal measurement) must record exactly one observation method (gmeow:observationMethod)." ;
    ] .

# IdentityFacet well-formedness (#69) — the universal claim construct bridges.
gmeow:IdentityFacetShape
    a sh:NodeShape ;
    rdfs:label "IdentityFacet well-formedness shape" ;
    sh:targetClass gmeow:IdentityFacet ;
    sh:targetClass gmeow:GenderIdentity ;
    sh:targetClass gmeow:GenderExpression ;
    sh:targetClass gmeow:SexualOrientation ;
    sh:targetClass gmeow:RomanticOrientation ;
    sh:property [
        sh:path gmeow:facetSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An IdentityFacet must record exactly one subject (gmeow:facetSubject)." ;
    ] ;
    sh:property [
        sh:path gmeow:facetVantage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An IdentityFacet must record exactly one vantage (gmeow:facetVantage)." ;
    ] .

# KinRelationship well-formedness (#69) — multi-participant observation.
gmeow:KinRelationshipShape
    a sh:NodeShape ;
    rdfs:label "KinRelationship well-formedness shape" ;
    sh:targetClass gmeow:KinRelationship ;
    sh:property [
        sh:path gmeow:relationshipParent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A KinRelationship must record exactly one parent (gmeow:relationshipParent)." ;
    ] ;
    sh:property [
        sh:path gmeow:relationshipChild ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A KinRelationship must record exactly one child (gmeow:relationshipChild)." ;
    ] .

# A ScalarQuantity / Quantity / MeasuredValue needs a value and a unit.
gmeow:ScalarQuantityShape
    a sh:NodeShape ;
    rdfs:label "Quantity well-formedness shape" ;
    sh:targetClass gmeow:ScalarQuantity, gmeow:Quantity, gmeow:MeasuredValue ;
    sh:property [
        sh:path gmeow:quantityValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "A Quantity must carry exactly one numeric gmeow:quantityValue." ;
    ] ;
    sh:property [
        sh:path gmeow:hasUnit ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Quantity must declare exactly one unit (gmeow:hasUnit)." ;
    ] .

# Suppression, never erasure (Principle 10): a superseded or withdrawn
# observation (one with gmeow:validUntil) should set gmeow:displayable false.
gmeow:SupersededObservationSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Superseded observation suppression shape" ;
    sh:targetClass gmeow:Observation ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A superseded observation (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/validUntil> ?until .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Temporal kernel data shapes (#67)
# --------------------------------------------------------------------------- #

# A TemporalMeasurement is an Observation: it needs vantage, observedFeature,
# observationMethod, and either an observationResult (Instant) or a measuredAge.
gmeow:TemporalMeasurementShape
    a sh:NodeShape ;
    rdfs:label "TemporalMeasurement well-formedness shape" ;
    sh:targetClass gmeow:TemporalMeasurement ;
    sh:property [
        sh:path gmeow:vantage ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A TemporalMeasurement must record at least one vantage (gmeow:vantage)." ;
    ] ;
    sh:property [
        sh:path gmeow:observedFeature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A TemporalMeasurement must record exactly one observed feature (gmeow:observedFeature)." ;
    ] ;
    sh:property [
        sh:path gmeow:observationMethod ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:DatingMethod ;
        sh:severity sh:Violation ;
        sh:message "A TemporalMeasurement must record exactly one observation method (gmeow:observationMethod, range DatingMethod)." ;
    ] ;
    sh:or (
        [ sh:path gmeow:measuredAge ; sh:minCount 1 ; sh:datatype xsd:decimal ]
        [ sh:path gmeow:measuredDate ; sh:minCount 1 ; sh:class gmeow:Instant ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A TemporalMeasurement must have either gmeow:measuredAge or gmeow:measuredDate (or both)." .
# --------------------------------------------------------------------------- #
# Proximity / distance shapes (#95)
# --------------------------------------------------------------------------- #

gmeow:ProximityMeasurementShape
    a sh:NodeShape ;
    rdfs:label "ProximityMeasurement well-formedness shape" ;
    sh:targetClass gmeow:ProximityMeasurement ;
    sh:property [
        sh:path gmeow:observedFeature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ProximityMeasurement must name exactly one starting entity (gmeow:observedFeature)." ;
    ] ;
    sh:property [
        sh:path gmeow:proximityTo ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ProximityMeasurement must name exactly one target entity (gmeow:proximityTo)." ;
    ] ;
    sh:property [
        sh:path gmeow:observationResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class gmeow:ScalarQuantity ]
            [ sh:class gmeow:Quantity ]
            [ sh:class gmeow:MeasuredValue ]
        ) ;
        sh:severity sh:Violation ;
        sh:message "A ProximityMeasurement must yield exactly one scalar quantity result (ScalarQuantity, Quantity, or MeasuredValue)." ;
    ] .

# --------------------------------------------------------------------------- #
# Spatial Aggregation / Statistics (#101)
# --------------------------------------------------------------------------- #

gmeow:SpatialAggregationShape
    a sh:NodeShape ;
    rdfs:label "SpatialAggregation well-formedness shape" ;
    sh:targetClass gmeow:SpatialAggregation ;
    sh:property [
        sh:path gmeow:vantage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A SpatialAggregation must record exactly one vantage (gmeow:vantage)." ;
    ] ;
    sh:property [
        sh:path gmeow:observedFeature ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Place ;
        sh:severity sh:Violation ;
        sh:message "A SpatialAggregation must name exactly one observed feature (the aggregation region, gmeow:observedFeature)." ;
    ] ;
    sh:property [
        sh:path gmeow:aggregationFunction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:AggregationFunction ;
        sh:severity sh:Violation ;
        sh:message "A SpatialAggregation must declare exactly one aggregation function (gmeow:aggregationFunction)." ;
    ] ;
    sh:property [
        sh:path gmeow:observationResult ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class gmeow:ScalarQuantity ]
            [ sh:class gmeow:Quantity ]
            [ sh:class gmeow:MeasuredValue ]
        ) ;
        sh:severity sh:Violation ;
        sh:message "A SpatialAggregation must yield exactly one scalar quantity result (ScalarQuantity, Quantity, or MeasuredValue)." ;
    ] ;
    sh:property [
        sh:path gmeow:minimumPopulation ;
        sh:maxCount 1 ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:severity sh:Violation ;
        sh:message "A SpatialAggregation may declare at most one minimum population (gmeow:minimumPopulation)." ;
    ] .

gmeow:CentroidGeometryShape
    a sh:NodeShape ;
    rdfs:label "Place centroid shape" ;
    sh:targetClass gmeow:Place ;
    sh:property [
        sh:path gmeow:hasCentroid ;
        sh:maxCount 1 ;
        sh:class gmeow:Geometry ;
        sh:severity sh:Violation ;
        sh:message "A Place may have at most one centroid geometry (gmeow:hasCentroid)." ;
    ] .

# --------------------------------------------------------------------------- #
# Tags module (#27). Closed-world well-formedness for the Tagging relator;
# suppression contract (Principle 10) for retracted taggings.
# --------------------------------------------------------------------------- #

# A Tagging must mediate exactly one tagged entity and exactly one tag —
# the closed-world counterpart of the EL someValuesFrom mediation axiom in
# tags.ttl (mirrors gmeow:ParticipationHasPlayersShape).
gmeow:TaggingHasPlayersShape
    a sh:NodeShape ;
    rdfs:label "Tagging well-formedness shape" ;
    sh:targetClass gmeow:Tagging ;
    sh:property [
        sh:path gmeow:taggingTagged ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Tagging must tag exactly one entity (gmeow:taggingTagged)." ;
    ] ;
    sh:property [
        sh:path gmeow:taggingTag ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Tagging must use exactly one tag (gmeow:taggingTag)." ;
    ] ;
    sh:property [
        sh:path gmeow:taggingTagger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Tagging must have exactly one tagger (gmeow:taggingTagger)." ;
    ] .

# Suppression, never erasure (Principle 10): a retracted or superseded tagging
# (one whose gmeow:taggingInterval has gmeow:endedAtTime) should set
# gmeow:displayable false rather than be deleted. Warning — a source may lag.
gmeow:RetractedTagSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Retracted / superseded tag suppression shape" ;
    sh:targetClass gmeow:Tagging ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A retracted or superseded tagging (one whose interval has ended) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/taggingInterval>/<https://blackcatinformatics.ca/gmeow/endedAtTime> ?until .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Email module (#159). Closed-world well-formedness for the MessageParticipant
# relator; suppression contract (Principle 10) for withdrawn occurrences.
# --------------------------------------------------------------------------- #

# A MessageParticipant must mediate exactly one message, one address, and one
# role — the closed-world counterpart of the EL someValuesFrom mediation axiom
# in email.ttl (mirrors gmeow:TaggingHasPlayersShape).
gmeow:MessageParticipantHasPlayersShape
    a sh:NodeShape ;
    rdfs:label "MessageParticipant well-formedness shape" ;
    sh:targetClass gmeow:MessageParticipant ;
    sh:property [
        sh:path gmeow:participantMessage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A MessageParticipant must belong to exactly one message (gmeow:participantMessage)." ;
    ] ;
    sh:property [
        sh:path gmeow:participantAddress ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A MessageParticipant must reference at most one EmailAddress (gmeow:participantAddress)." ;
    ] ;
    sh:property [
        sh:path gmeow:participantRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A MessageParticipant must declare exactly one role (gmeow:participantRole)." ;
    ] .

# Suppression, never erasure (Principle 10): a withdrawn or superseded
# MessageParticipant occurrence (one with gmeow:validUntil) should set
# gmeow:displayable false rather than be deleted. Warning — a source may lag.
gmeow:SuppressedMessageParticipantShape
    a sh:NodeShape ;
    rdfs:label "Suppressed / withdrawn message participant shape" ;
    sh:targetClass gmeow:MessageParticipant ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A withdrawn or superseded MessageParticipant (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/validUntil> ?until .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Lifecycle module (#81). Closed-world well-formedness for EntityExistence and
# suppression guards for superseded entities.
# --------------------------------------------------------------------------- #

# An EntityExistence must bind exactly one entity and one interval — the closed-world
# counterpart of the EL someValuesFrom mediation axiom in lifecycle.ttl.
gmeow:EntityExistenceHasEntityShape
    a sh:NodeShape ;
    rdfs:label "EntityExistence well-formedness shape" ;
    sh:targetClass gmeow:EntityExistence ;
    sh:property [
        sh:path gmeow:existenceEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An EntityExistence must record exactly one entity (gmeow:existenceEntity)." ;
    ] ;
    sh:property [
        sh:path gmeow:duringInterval ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An EntityExistence must record exactly one interval (gmeow:duringInterval)." ;
    ] .

# Suppression, never erasure (Principle 10): a superseded entity — one that has a
# gmeow:supersededBy link to a successor — should set gmeow:displayable false rather
# than be deleted. Warning — a source may lag the flag.
gmeow:SupersededEntitySuppressionShape
    a sh:NodeShape ;
    rdfs:label "Superseded entity suppression shape" ;
    sh:targetClass gmeow:Entity ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A superseded entity (one with gmeow:supersededBy) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/supersededBy> ?successor .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# =========================================================================== #
# Places module — terrestrial realm deepening (#82)
# --------------------------------------------------------------------------- #

# JurisdictionTenure well-formedness: exactly one place, one polity, one interval.
gmeow:JurisdictionTenureShape
    a sh:NodeShape ;
    rdfs:label "JurisdictionTenure well-formedness shape" ;
    sh:targetClass gmeow:JurisdictionTenure ;
    sh:property [
        sh:path gmeow:jurisdictionPlace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A JurisdictionTenure must record exactly one place (gmeow:jurisdictionPlace)." ;
    ] ;
    sh:property [
        sh:path gmeow:jurisdictionPolity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A JurisdictionTenure must record exactly one governing polity (gmeow:jurisdictionPolity)." ;
    ] ;
    sh:property [
        sh:path gmeow:duringInterval ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A JurisdictionTenure must record exactly one time interval (gmeow:duringInterval)." ;
    ] .

# ContainmentTenure well-formedness: exactly one child, one parent, one interval.
gmeow:ContainmentTenureShape
    a sh:NodeShape ;
    rdfs:label "ContainmentTenure well-formedness shape" ;
    sh:targetClass gmeow:ContainmentTenure ;
    sh:property [
        sh:path gmeow:containmentChild ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ContainmentTenure must record exactly one child place (gmeow:containmentChild)." ;
    ] ;
    sh:property [
        sh:path gmeow:containmentParent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ContainmentTenure must record exactly one parent place (gmeow:containmentParent)." ;
    ] ;
    sh:property [
        sh:path gmeow:duringInterval ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ContainmentTenure must record exactly one time interval (gmeow:duringInterval)." ;
    ] .

# RegulatoryOverlay well-formedness: exactly one place, one authority, one interval.
gmeow:RegulatoryOverlayShape
    a sh:NodeShape ;
    rdfs:label "RegulatoryOverlay well-formedness shape" ;
    sh:targetClass gmeow:RegulatoryOverlay ;
    sh:property [
        sh:path gmeow:overlayPlace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A RegulatoryOverlay must record exactly one place (gmeow:overlayPlace)." ;
    ] ;
    sh:property [
        sh:path gmeow:overlayAuthority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A RegulatoryOverlay must record exactly one authority (gmeow:overlayAuthority)." ;
    ] ;
    sh:property [
        sh:path gmeow:duringInterval ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A RegulatoryOverlay must record exactly one time interval (gmeow:duringInterval)." ;
    ] .

# LandTenure well-formedness: exactly one place, one party, one interval; at least one type.
gmeow:LandTenureShape
    a sh:NodeShape ;
    rdfs:label "LandTenure well-formedness shape" ;
    sh:targetClass gmeow:LandTenure ;
    sh:property [
        sh:path gmeow:tenurePlace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A LandTenure must record exactly one place (gmeow:tenurePlace)." ;
    ] ;
    sh:property [
        sh:path gmeow:tenureParty ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A LandTenure must record exactly one party (gmeow:tenureParty)." ;
    ] ;
    sh:property [
        sh:path gmeow:tenureType ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A LandTenure must record at least one tenure type (gmeow:tenureType)." ;
    ] ;
    sh:property [
        sh:path gmeow:duringInterval ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A LandTenure must record exactly one time interval (gmeow:duringInterval)." ;
    ] .

# CadastralReference well-formedness: exactly one value, at least one type, one authority, one jurisdiction.
gmeow:CadastralReferenceShape
    a sh:NodeShape ;
    rdfs:label "CadastralReference well-formedness shape" ;
    sh:targetClass gmeow:CadastralReference ;
    sh:property [
        sh:path gmeow:referenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CadastralReference must record exactly one reference value (gmeow:referenceValue)." ;
    ] ;
    sh:property [
        sh:path gmeow:referenceType ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CadastralReference must record at least one reference type (gmeow:referenceType)." ;
    ] ;
    sh:property [
        sh:path gmeow:referenceAuthority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CadastralReference must record exactly one issuing authority (gmeow:referenceAuthority)." ;
    ] ;
    sh:property [
        sh:path gmeow:referenceJurisdiction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CadastralReference must record exactly one jurisdiction (gmeow:referenceJurisdiction)." ;
    ] .

# PlaceNaming has-players guard (Violation): a NameUsage that names a Place must bind
# a PlaceName appellation.
gmeow:PlaceNamingHasPlayersShape
    a sh:NodeShape ;
    rdfs:label "PlaceNaming player binding shape" ;
    sh:targetClass gmeow:NameUsage ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A name-usage that names a gmeow:Place must bind a gmeow:PlaceName via gmeow:usageAppellation." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/usageNamed> ?place .
                ?place a <https://blackcatinformatics.ca/gmeow/Place> .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/usageAppellation> ?app .
                    ?app a <https://blackcatinformatics.ca/gmeow/PlaceName>
                }
            }
        """ ;
    ] .

# Superseded place suppression (Principle 10): a place that has been superseded by
# another place should set gmeow:displayable false. Warning — a source may lag the flag.
gmeow:SupersededPlaceSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Superseded place suppression shape" ;
    sh:targetClass gmeow:Place ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A superseded place (one with gmeow:placeSupersededBy) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/placeSupersededBy> ?successor .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Accessibility module (#102). Closed-world well-formedness for the
# AccessibilityAssertion relator; suppression contract (Principle 10).
# --------------------------------------------------------------------------- #

gmeow:AccessibilityAssertionShape
    a sh:NodeShape ;
    rdfs:label "AccessibilityAssertion well-formedness shape" ;
    sh:targetClass gmeow:AccessibilityAssertion ;
    sh:property [
        sh:path gmeow:assertionSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An AccessibilityAssertion must assess exactly one subject (gmeow:assertionSubject)." ;
    ] ;
    sh:property [
        sh:path gmeow:assertionFacet ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An AccessibilityAssertion must assert exactly one facet (gmeow:assertionFacet)." ;
    ] ;
    sh:property [
        sh:path gmeow:assertionPolarity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An AccessibilityAssertion must declare exactly one polarity (gmeow:assertionPolarity)." ;
    ] .

# Suppression, never erasure (Principle 10): a retracted or superseded
# accessibility assertion (one with gmeow:validUntil) should set
# gmeow:displayable false rather than be deleted. Warning — a source may lag.
gmeow:RetractedAccessibilityAssertionShape
    a sh:NodeShape ;
    rdfs:label "Retracted accessibility assertion suppression shape" ;
    sh:targetClass gmeow:AccessibilityAssertion ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A retracted or superseded accessibility assertion (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/validUntil> ?until .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

gmeow:GeocodeShape
    a sh:NodeShape ;
    rdfs:label "Geocode well-formedness shape" ;
    skos:definition "Enforces that a Geocode carries exactly one code value in exactly one reference frame. sh:xone (not sh:or) is intentional: a single Geocode instance represents one code in one system; competing or supplementary codes for the same place are modeled as multiple Geocode instances linked via gmeow:hasGeocode, coexisting as standpoint-indexed claims per Principle 9."@en ;
    sh:targetClass gmeow:Geocode ;
    sh:property [
        sh:path gmeow:geocodeFrame ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Geocode must declare exactly one reference frame (gmeow:geocodeFrame)." ;
    ] ;
    sh:xone (
        [ sh:path gmeow:geocodeValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ]
        [ sh:path gmeow:plusCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:what3words ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:geohash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:mgrs ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:unLocode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:mileMarker ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:hasCoordinateMatrix ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A Geocode must carry exactly one code value: geocodeValue, plusCode, what3words, geohash, mgrs, unLocode, mileMarker, or hasCoordinateMatrix." .


# =========================================================================== #
# Creative-works module (#208) — WEMI spine well-formedness
# =========================================================================== #

# Contribution relator well-formedness — closed-world cardinality.
# Mirrors ParticipationHasPlayersShape and NameUsageShape.
gmeow:ContributionHasPlayersShape
    a sh:NodeShape ;
    rdfs:label "Contribution well-formedness shape" ;
    sh:targetClass gmeow:Contribution ;
    sh:property [
        sh:path gmeow:contributor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Contribution must have exactly one contributor (gmeow:contributor)." ;
    ] ;
    sh:property [
        sh:path gmeow:contributionTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Contribution must target exactly one creative work (gmeow:contributionTarget)." ;
    ] ;
    sh:property [
        sh:path gmeow:contributionRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Contribution must specify exactly one role (gmeow:contributionRole)." ;
    ] ;
    sh:property [
        sh:path gmeow:contributionDegree ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Contribution may have at most one degree (gmeow:contributionDegree)." ;
    ] .

# CitationAct relator well-formedness — closed-world cardinality.
gmeow:CitationActShape
    a sh:NodeShape ;
    rdfs:label "CitationAct well-formedness shape" ;
    sh:targetClass gmeow:CitationAct ;
    sh:property [
        sh:path gmeow:citingEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CitationAct must have exactly one citing entity (gmeow:citingEntity)." ;
    ] ;
    sh:property [
        sh:path gmeow:citedEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CitationAct must have exactly one cited entity (gmeow:citedEntity)." ;
    ] ;
    sh:property [
        sh:path gmeow:citationIntent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CitationAct must specify exactly one citation intent (gmeow:citationIntent)." ;
    ] .

# Spine integrity: every Expression realizes at least one Work.
gmeow:ExpressionRealizesWorkShape
    a sh:NodeShape ;
    rdfs:label "Expression realizes Work shape" ;
    sh:targetClass gmeow:Expression ;
    sh:property [
        sh:path gmeow:realizes ;
        sh:minCount 1 ;
        sh:class gmeow:Work ;
        sh:severity sh:Violation ;
        sh:message "Every Expression must realize at least one Work (gmeow:realizes)." ;
    ] .

# Spine integrity: every Manifestation embodies at least one Expression.
gmeow:ManifestationEmbodiesExpressionShape
    a sh:NodeShape ;
    rdfs:label "Manifestation embodies Expression shape" ;
    sh:targetClass gmeow:Manifestation ;
    sh:property [
        sh:path gmeow:embodies ;
        sh:minCount 1 ;
        sh:class gmeow:Expression ;
        sh:severity sh:Violation ;
        sh:message "Every Manifestation must embody at least one Expression (gmeow:embodies)." ;
    ] .

# Spine integrity: every Item exemplifies at least one Manifestation.
gmeow:ItemExemplifiesManifestationShape
    a sh:NodeShape ;
    rdfs:label "Item exemplifies Manifestation shape" ;
    sh:targetClass gmeow:Item ;
    sh:property [
        sh:path gmeow:exemplifies ;
        sh:minCount 1 ;
        sh:class gmeow:Manifestation ;
        sh:severity sh:Violation ;
        sh:message "Every Item must exemplify at least one Manifestation (gmeow:exemplifies)." ;
    ] .

# Expression well-formedness: carries a reference frame (language/notation/arrangement).
gmeow:ExpressionHasFrameShape
    a sh:NodeShape ;
    rdfs:label "Expression reference-frame shape" ;
    sh:targetClass gmeow:Expression ;
    sh:property [
        sh:path gmeow:hasReferenceFrame ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "An Expression should carry at least one reference frame (gmeow:hasReferenceFrame) — language, script, notation, or arrangement." ;
    ] .
