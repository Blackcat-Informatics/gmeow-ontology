      <termEntry id="c-02c7b18c2afffe93">
        <langSet xml:lang="en">
          <tig>
            <term>registered (®)</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>enregistrée (®)</term>
