gmeow:ProfileBindingProfileRequiredConstraint
    a logic:Constraint ;
    rdfs:label "ProfileBinding profile requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every gmeow:ProfileBinding (the object of gmeow:hasBinding) carries exactly one gmeow:profile."@x-gmeow-english ;
