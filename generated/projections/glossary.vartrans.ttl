    a ontolex:Form ;
    ontolex:writtenRep "Vietoris–Rips 复形"@zh .

<http://example.org/lang/glossary-vartrans/form-tgt/303adb002a139cb3>
    a ontolex:Form ;
    ontolex:writtenRep "使用信息"@zh .

<http://example.org/lang/glossary-vartrans/form-tgt/3048cad9b3c6b026>
