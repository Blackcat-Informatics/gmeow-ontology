# Competency question: "What convergence target and mode are declared for this series?"
# This reads supplied math:Series/math:Convergence frames; it neither computes
# a sum nor proves convergence, and it does not select math:Sequence records.
# Scoped to the fixture namespace, the answer remains
# {geometricSeries → converges to seriesLimit, absolutely}.
PREFIX math: <https://blackcatinformatics.ca/math/>

SELECT ?series ?convergesTo ?mode WHERE {
    ?series a math:Series ;
            math:hasConvergence ?convergence .
    ?convergence math:convergesTo ?convergesTo ;
                 math:convergenceMode ?mode .
    FILTER(STRSTARTS(STR(?series), "http://example.org/math/"))
}
ORDER BY ?series
