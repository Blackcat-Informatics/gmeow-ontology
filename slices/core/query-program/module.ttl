gmeow:QueryVerdictComparison
    a logic:SubKind , logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Query Verdict Comparison"@x-gmeow-english ;
    skos:definition "An outer-owned internal binary query-choice occurrence comparing a known selected answer-axis value with its outer choice’s expected value. Its matching guard selects the left target when supported and the known-nonmatching right target otherwise."@x-gmeow-english ;
    gmeow:useWhen "Use as the internal comparison reached through a QueryVerdictChoice’s left operand after knownness is established."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid copying answer, axis or expected-value roles onto the comparison, sharing it between distinct outer choices or treating unknown context as known inequality."@x-gmeow-english ;
    gmeow:howToUse "Supply one guardSituation, one matching leftOperand and one known-nonmatching rightOperand, inherited node effect and stratum, and one distinct typed structural outer owner through that outer’s leftOperand."@x-gmeow-english ;
    skos:scopeNote "An inner-only execution uses its own choiceEvaluationState and its unique structural outer context, with knownness supported there. It needs no fabricated outer execution, native start instruction or distinct downstream branch targets."@x-gmeow-english ;
    skos:example "An owned binary comparison: ex:outer logic:leftOperand ex:comparison . ex:comparison a gmeow:QueryVerdictComparison ; logic:guardSituation ex:matchingSituation ; logic:leftOperand ex:match ; logic:rightOperand ex:nonmatch ."@x-gmeow-english ;
    logic:subClassOf gmeow:QueryProgramNode , logic:Choice .

gmeow:choiceEvaluationState
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "query choice evaluation state"@x-gmeow-english ;
    skos:definition "The supplied State of a reported outer verdict-choice or internal comparison evaluation. Its situationObtains support is checked against that node’s bound answer context, without making the reusable node a native transaction root."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the actual declared evaluation State on a reported outer or inner choice execution."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using a node-global flag, substituting an answer resource for State, adding a native start instruction or attaching this selected role to a nonchoice execution."@x-gmeow-english ;
    gmeow:howToUse "Link at most one typed State from the QueryNodeExecution; outer and inner choice executions require this coordinate and retain their resolved querySelectedBranch separately."@x-gmeow-english ;
    skos:scopeNote "Generic nonchoice executions without this role require no State. A graph link grades declared support rather than authenticating execution history or invoking a query adapter."@x-gmeow-english ;
    skos:example "A reported evaluation context: ex:execution gmeow:choiceEvaluationState ex:state . ex:state a gmeow:State ."@x-gmeow-english ;
    logic:domain gmeow:QueryNodeExecution ; logic:range gmeow:State .

gmeow:QueryVerdictComparisonOwnerLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query verdict comparison owner law"@x-gmeow-english ;
    skos:definition "Every internal verdict comparison has an existing typed structural outer choice owner distinct from itself. Any two typed outer choices naming that comparison as left operand must be the same owner resource."@x-gmeow-english ;
    gmeow:useWhen "Use to keep the comparison’s borrowed answer, axis and expected context unique and non-self-referential."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid selecting an arbitrary outer context, copying its bound fields onto the comparison or imposing inverse ownership on downstream targets, States or Situations."@x-gmeow-english ;
