    gmeow:graphBoxRole gmeow:boxRBox .

logic:compositionExclusionVia
    a logic:ObjectProperty ;
    rdfs:domain logic:RoleCompositionExclusionAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "composition exclusion via"@x-gmeow-english ;
    skos:definition "Relates a logic:RoleCompositionExclusionAssertion to a composition property linking the whole role's value to a component. Each asserted value is one step the exclusion ranges over; the native coherence gate raises a violation when the part role coincides with a component reached through any of them. Domain logic:RoleCompositionExclusionAssertion; multi-valued. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── Mediated-property-requirement assertions (a mediated value must carry a property) ──
# The canonical carrier for a Principle-11-style requirement that the value a focus node
# reaches through a mediating property must itself declare a required property. It names the
# class with logic:mediatedRequirementTarget, the mediating property with
# logic:mediatedRequirementVia, and the required property with logic:mediatedRequirementProperty;
# the native coherence gate raises a violation when a mediated value lacks the required
# property, and the generated SHACL constraint surface is its projection. This slice owns the
# vocabulary; every record whose logic:mediatedRequirementTarget is a term of a non-grounding
# slice is authored in THAT slice's module.ttl (the tier rule, docs/GROUNDING.md).

logic:MediatedPropertyRequirementAssertion
    a logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "mediated property requirement assertion"@x-gmeow-english ;
    skos:definition "A central record asserting that, on a target class, every value a focus node reaches through a mediating property must itself declare at least one value of a required property — the interval that scopes a situation must carry its temporal frame (Principle 11). It names the class with logic:mediatedRequirementTarget, the mediating property with logic:mediatedRequirementVia, and the demanded property with logic:mediatedRequirementProperty; the native coherence gate joins them to raise a violation when a mediated value lacks the required property. Carries a logic:formalizes back-reference to the domain property whose prose it encodes. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:mediatedRequirementTarget
    a logic:ObjectProperty ;
    rdfs:domain logic:MediatedPropertyRequirementAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "mediated requirement target"@x-gmeow-english ;
    skos:definition "Relates a logic:MediatedPropertyRequirementAssertion to the class whose focus nodes it constrains. Domain logic:MediatedPropertyRequirementAssertion; single-valued. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:mediatedRequirementVia
    a logic:ObjectProperty ;
    rdfs:domain logic:MediatedPropertyRequirementAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "mediated requirement via"@x-gmeow-english ;
    skos:definition "Relates a logic:MediatedPropertyRequirementAssertion to the mediating property whose values must carry the required property. Domain logic:MediatedPropertyRequirementAssertion; single-valued. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:mediatedRequirementProperty
    a logic:ObjectProperty ;
    rdfs:domain logic:MediatedPropertyRequirementAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "mediated requirement property"@x-gmeow-english ;
    skos:definition "Relates a logic:MediatedPropertyRequirementAssertion to the property each mediated value must declare at least once. Domain logic:MediatedPropertyRequirementAssertion; single-valued. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# ── A NET-NEW harvested integrity constraint (prose → enforced axiom) ─────────────
# The harvest mechanism run on a constraint that did NOT exist as an axiom before:
# the three mereological individuation kinds (logic:Collection, logic:FunctionalComplex,
# logic:Quantity) are pairwise disjoint. Their skos:definitions each contrast the
# three as distinct individuation modes (member count vs distinct functional roles
# vs constitution) — logic:FunctionalComplex's Definition literally says "Contrast
# logic:Collection (uniform members) and logic:Quantity (homogeneous stuff)" — yet
# none was asserted OWL disjointWith. This candidate harvests that prose into the
# pairwise OWL disjointWith axioms asserted above, which the native DL coherence
# gate reads directly: an individual typed into two of the three kinds is forced to
# OWL Nothing, so the harvested constraint is genuinely ENFORCED. Accepted through
# review with a positive case and a negative countermodel.

logic:cqFunctionalComplexKindDisjointHolds
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "individuation-kind disjointness holds"@x-gmeow-english ;
    skos:definition "The positive competency case the individuation-kind disjointness axioms must satisfy: an individual typed logic:FunctionalComplex and NOT also logic:Collection or logic:Quantity stays coherent — it is not forced to OWL Nothing — because a whole is individuated in exactly one of the three modes the prose contrasts."@x-gmeow-english .

logic:cqFunctionalComplexKindDisjointOverlapRejected
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "individuation-kind overlap is rejected"@x-gmeow-english ;
    skos:definition "The negative countermodel the individuation-kind disjointness axioms must respect: an individual typed BOTH logic:FunctionalComplex and logic:Collection is a violation — the native DL coherence gate forces it to OWL Nothing — so a whole individuated at once by distinct functional roles and by member count is not an admissible model. The boundary the harvested constraint enforces."@x-gmeow-english .

logic:candidateFunctionalComplexKindDisjoint
    a logic:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "individuation kinds are pairwise disjoint"@x-gmeow-english ;
    skos:definition "The net-new-enforcement formalization candidate that harvests the pairwise disjointness of the three mereological individuation kinds (logic:Collection, logic:FunctionalComplex, logic:Quantity) from their skos:definition prose into enforced OWL disjointWith integrity constraints: the demonstration that the harvest mechanism creates axioms that did NOT exist before, not merely a link to an already-typed one. None of the three was asserted OWL disjointWith on origin/main; the prose contrasts them as distinct individuation modes (logic:FunctionalComplex's Definition names both other kinds explicitly). Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation) with a positive case (logic:cqFunctionalComplexKindDisjointHolds) and a negative countermodel (logic:cqFunctionalComplexKindDisjointOverlapRejected); its harvest back-link (logic:candidateFormalizes logic:FunctionalComplex, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose, and logic:candidateSourceHash is the sha256 of that definition text so a later edit to the prose surfaces as drift. The native DL coherence gate reads the resulting OWL disjointWith directly, forcing a two-kind individual to OWL Nothing."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:ae6ffde78c8d4cd93cdb0d06ee67fd15ab46573e7aa4f1fe5f2ee2dd209cb529"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from the logic:FunctionalComplex skos:definition, which contrasts it against logic:Collection and logic:Quantity (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "pairwise OWL disjointWith over the three mereological individuation kinds logic:Collection, logic:FunctionalComplex and logic:Quantity"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryIntegrityConstraint ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
