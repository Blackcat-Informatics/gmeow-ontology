# === SQ2 — models and estimation: data, model, estimator, assumptions, process #

ex:cqStatisticsEstimateProvenance a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-estimate-provenance.rq" ;
    gmeow:cqDataFile "tests/fixtures/statistics-estimate-provenance.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:Estimate names its math:Estimator (math:estimator) and math:Estimand (math:estimatesEstimand) and is produced by a math:InferenceRun process (gmeow:wasGeneratedBy); the run fits the math:DatasetMatrix data (math:fittedToData) and the math:FittedModel over that same data carries its math:ModelAssumption (math:modelAssumption) — so a statistical result is the traceable output of a method over data under stated assumptions, by a named process. Over the fixture the answer is exactly {treatmentEffectEstimate → run analysisRun, data trialData, model trialFittedModel, estimator olsEstimator, estimand averageTreatmentEffect, assumption normalErrors}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsEstimateProvenanceShape ;
    gmeow:cqExpectRow ex:rowEstimateProvenance .

ex:cqStatisticsEstimateProvenanceShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "estimate" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "run" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "data" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "model" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "estimator" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "estimand" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "assumption" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowEstimateProvenance a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "estimate" ; gmeow:cellValueIri exf:treatmentEffectEstimate ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "run" ; gmeow:cellValueIri exf:analysisRun ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "data" ; gmeow:cellValueIri exf:trialData ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "model" ; gmeow:cellValueIri exf:trialFittedModel ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "estimator" ; gmeow:cellValueIri exf:olsEstimator ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "estimand" ; gmeow:cellValueIri exf:averageTreatmentEffect ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "assumption" ; gmeow:cellValueIri exf:normalErrors ] .

# === SQ3 — inference and results: p-value framing and multiplicity ========= #

ex:cqStatisticsPValueFraming a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-pvalue-framing.rq" ;
    gmeow:cqDataFile "tests/fixtures/statistics-pvalue-framing.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A math:PValue names the math:NullHypothesis it is computed under (math:nullHypothesis), the math:Distribution it is measured against (math:nullDistribution, a math:SamplingDistribution) and its math:Sidedness (math:alternativeSidedness) — the frame that makes P(T ≥ t | H0) unambiguous — and its multiplicity handling is LEFT-JOINed (math:pValueAdjustment / math:multipleComparisonFamily, BindingOptional), so 'what null, distribution, and tail/sidedness produced this p-value, and was it adjusted for multiplicity' is answerable. Over the fixture the answer is exactly {geneExpressionPValue → null noDifferenceNull, distribution tNullDistribution, sidedness twoSidedAlternative, adjustment benjaminiHochberg, family geneFamily}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsPValueFramingShape ;
    gmeow:cqExpectRow ex:rowPValueFraming .

ex:cqStatisticsPValueFramingShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "pvalue" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "nullHypothesis" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "nullDistribution" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "sidedness" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "adjustment" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingOptional ] ,
        [ logic:columnVariable "family" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingOptional ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowPValueFraming a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "pvalue" ; gmeow:cellValueIri exf:geneExpressionPValue ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "nullHypothesis" ; gmeow:cellValueIri exf:noDifferenceNull ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "nullDistribution" ; gmeow:cellValueIri exf:tNullDistribution ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "sidedness" ; gmeow:cellValueIri math:twoSidedAlternative ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "adjustment" ; gmeow:cellValueIri exf:benjaminiHochberg ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "family" ; gmeow:cellValueIri exf:geneFamily ] .
