@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/calendar>
    a gmeow:Slice ;
    rdfs:label "calendar"@x-gmeow-english ;
    skos:definition "The calendar slice of the GMEOW ontology (core tier): GMEOW Calendar and Scheduling Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/calendar> ;
    dcterms:title "GMEOW Calendar and Scheduling Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/agreements> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/events> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ,
        <https://blackcatinformatics.ca/gmeow/slices/names> ;
    gmeow:sliceConsumer "Scheduling atop events: the mail corpus's invitations (mail-corpus invitation consumer), the >25%-usage floor (named in slice-dependency doctrine)."@x-gmeow-english.
