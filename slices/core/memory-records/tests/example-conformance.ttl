#
# Example-conformance cells for the trace-finality records. The harness unions
# memory-records/module.ttl with the one bound gmeow:exampleFile and validates it
# against the constraints derived from the module's required paths. Each counter-example
# omits only the declarer, so the required wasAttributedTo path is the missing one.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/memory-records/tests/> .

ex:ecWatermarkWithoutDeclarer a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/watermark-without-declarer.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "A watermark with its ledger, producer and cut packet but no wasAttributedTo reads as a bare fact that marking is final; the required declarer path must report a missing value." .

ex:ecFrontierWithoutDeclarer a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/frontier-without-declarer.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "A frontier with its ledger, producer and committed point but no wasAttributedTo states no claimant for the committed point; the required declarer path must report a missing value." .

ex:ecGiveUpWithoutDeclarer a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/give-up-without-declarer.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "A give-up with its reason but no wasAttributedTo states no claimant for the lost marks; the required declarer path must report a missing value." .
