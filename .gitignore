# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.cache/
*.egg-info/
.coverage
htmlcov/

# Ephemeral / generated products — reproducible from canonical sources, never committed.
# generated/ is a git-ignored local/release projection of generated/dist/gmeow.gts:
# `make check` (through its single producer, `check-sync`) materializes the whole
# tree from canonical sources and reconstructs it
# from the bundle. It is a product, not a committed input. (The retained products that
# ride outside this projection — catalog-v001.xml and packages/python/gmeow_models/ —
# live outside generated/ and stay tracked.)
# ontology-docs/ is on-demand `gmeow-dev sync --outputs docs` output rendered from
# canonical repository sources; it is never committed.
/generated/
/dist/
/dist/i18n/
/dist/ontology-docs/
/ontology-docs/
/docs/_generated/
/llms.txt

# Stamp files (compilation freshness tracking)
.stamps/

# Editor/OS noise
.DS_Store
*.swp
.antigravitycli
.codex
.claude
.worktrees/

# Toolchain temp directories (hard-kill leftovers)
.gmeow-tmp-*/

# Maint-lane scratch: fetched-at-maint-time external assets (e.g. the restricted-license
# Llama/Gemma tokenizer.json the token-cost-matrix lane curls in) — never committed.
/.tmp/

# Rust build artifacts
/target/

# Repository Cargo config is source, not build output.
!/.cargo/
!/.cargo/config.toml

# Release signing secrets (public keys live under keys/ and ARE committed).
keys/*.secret.asc
keys/*.secret
keys/*.tmp

.worktree
.goals
.baseline
lcov.info
mutants.out*/
/pipeline/

# Nightly rustc internal-compiler-error crash dumps (never commit)
rustc-ice-*.txt

# insta pending-snapshot temp files (never commit)
*.snap.new

# coding-ethos generated runtime output
.claude/settings.local.json
.coding-ethos/cache/
.coding-ethos/code-intel.duckdb
.coding-ethos/code-intel.duckdb.wal
.coding-ethos/events/
.coding-ethos/hook-runs/
.coding-ethos/lint-runs/
.coding-ethos/prune-runs/
.coding-ethos/state/
.gemini/settings.json
.mcp.json
# coding-ethos tooling source checked out into the worktree (not gmeow content)
/coding-ethos/
# coding-ethos agent tooling installed locally into the worktree — never gmeow
# content: the local memory index, the Gemini extension payload, and the local
# skill mirrors. The repo's own .agents/skills/gmeow-*/ and deficiency-cleanup
# skills are real gmeow content and stay tracked (not matched below).
.coding-ethos/memories/
.gemini/extensions/
.agents/skills/agent-operating-discipline/
.agents/skills/coding-ethos-agent-workflow/
.agents/skills/conditional-imports/
.agents/skills/lint-remediation/
.agents/skills/managed-lint-workflow/
.agents/skills/managed-toolchain/
.agents/skills/modern-web-guidance/
.agents/skills/safe-git-workflow/

.coding-ethos/code-intel-v2/
