    skos:definition "A completed satisfied evaluation of a goal with source conditions retains every condition's key and a matching verifier of that same goal, so omitting a configured condition cannot evade its evidence obligation."@x-gmeow-english ;
    gmeow:useWhen "Use to enforce complete condition coverage for a conclusive positive goal judgment."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid certifying a goal by selecting only the easiest condition or omitting its condition keys."@x-gmeow-english ;
    gmeow:howToUse "Retain each actual condition key and its configured verifier; keep incomplete evaluations explicitly incomplete."@x-gmeow-english ;
    skos:scopeNote "Coverage constrains the supplied judgment; it does not execute conditions or infer their truth."@x-gmeow-english ;
    skos:example "gmeow:CompletedGoalConditionCoverageConstraint logic:formalizes gmeow:hasSatisfactionCondition ."@x-gmeow-english ;
    logic:formalizes gmeow:hasSatisfactionCondition ;
    logic:message "A completed satisfied evaluation of a goal with source conditions retains every condition's key and a matching verifier of that same goal, so omitting a configured condition cannot evade its evidence obligation."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "goal" ], [ logic:termIndex 2 ; logic:termVariable "condition" ], [ logic:termIndex 3 ; logic:termVariable "key" ] ; logic:forall [ a logic:Formula ; logic:antecedent [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri logic:GoalEvaluation ] ], [ a logic:Formula ; logic:relation logic:evaluatesGoal ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "goal" ] ], [ a logic:Formula ; logic:relation logic:satisfactionStatus ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri logic:Satisfied ] ], [ a logic:Formula ; logic:relation logic:goalEvaluationStatus ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri logic:GoalEvaluationCompleted ] ], [ a logic:Formula ; logic:relation gmeow:hasSatisfactionCondition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "goal" ], [ logic:termIndex 1 ; logic:termVariable "condition" ] ], [ a logic:Formula ; logic:relation gmeow:verifierKey ; logic:argument [ logic:termIndex 0 ; logic:termVariable "condition" ], [ logic:termIndex 1 ; logic:termVariable "key" ] ] ] ; logic:consequent [ a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "verifier" ] ; logic:exists [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation gmeow:conditionKey ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "key" ] ], [ a logic:Formula ; logic:relation gmeow:hasConditionVerifier ; logic:argument [ logic:termIndex 0 ; logic:termVariable "goal" ], [ logic:termIndex 1 ; logic:termVariable "verifier" ] ], [ a logic:Formula ; logic:relation gmeow:verifierKey ; logic:argument [ logic:termIndex 0 ; logic:termVariable "verifier" ], [ logic:termIndex 1 ; logic:termVariable "key" ] ] ] ] ] ] .

gmeow:GoalReadAfterWriteEvidenceConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Goal read-after-write evidence constraint"@x-gmeow-english ;
    skos:definition "A completed positive read-after-write evaluation cites a held actual artifact observation of that same method and condition key. The existing read-after-write law then requires distinct matching write and later-read receipts."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve the existing read-after-write evidence contract when this method is configured for a goal."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid bypassing actual read and write evidence by configuring a method without a cited observation."@x-gmeow-english ;
    gmeow:howToUse "Cite the actual held observation under the same condition key and retain its versioned read and write receipts."@x-gmeow-english ;
    skos:scopeNote "Configuration neither executes the check nor replaces the existing artifact-byte-identity and later-read obligations."@x-gmeow-english ;
    skos:example "gmeow:GoalReadAfterWriteEvidenceConstraint logic:formalizes gmeow:verifierArtifactReadAfterWrite ."@x-gmeow-english ;
    logic:formalizes gmeow:verifierArtifactReadAfterWrite ;
    logic:message "A completed positive read-after-write evaluation cites a held actual artifact observation of that same method and condition key. The existing read-after-write law then requires distinct matching write and later-read receipts."@x-gmeow-english ;
