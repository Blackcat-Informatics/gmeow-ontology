msgstr "ex:record gmeow:verifiesArtifact ex:target ."

msgctxt "https://blackcatinformatics.ca/gmeow/verificationWriteReceipt|http://www.w3.org/2000/01/rdf-schema#label"
msgid "verification write receipt"
msgstr "activité d’écriture de vérification"

msgctxt "https://blackcatinformatics.ca/gmeow/verificationWriteReceipt|http://www.w3.org/2004/02/skos/core#definition"
msgid "The actual created-or-updated operation occurrence used as write evidence, not a fabricated successful invocation."
msgstr "Occurrence réelle de création ou mise à jour servant d’élément d’écriture, pas une invocation réussie fabriquée."

msgctxt "https://blackcatinformatics.ca/gmeow/verificationWriteReceipt|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to preserve the source’s verification write receipt binding."
msgstr "Utiliser pour préserver le lien source : activité d’écriture de vérification."

msgctxt "https://blackcatinformatics.ca/gmeow/verificationWriteReceipt|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing evidence for verificationWriteReceipt."
msgstr "Éviter d’inventer des éléments absents pour verificationWriteReceipt."

msgctxt "https://blackcatinformatics.ca/gmeow/verificationWriteReceipt|https://blackcatinformatics.ca/gmeow/howToUse"
