@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix vann:  <http://purl.org/vocab/vann/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/lang>
    a owl:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    vann:preferredNamespacePrefix "lang" ;
    vann:preferredNamespaceUri "https://blackcatinformatics.ca/lang/" ;
    rdfs:comment "Grounding vocabulary for GMEOW Language. The lang: namespace <https://blackcatinformatics.ca/lang/> is the semiotic grounding surface, the third co-foundational grounding layer alongside logic: and math: (Principle 19). It grounds what language is made of before meaning is attached: the sign-system reference layer (sign systems, varieties, scripts, orthographies, grammars, held as first-class individuals distinguished by kind) and the typed form AST (surface forms, graphemes and phones, morphemes and morphs, lexemes and word forms, orthographic and syntactic words, composed forms over indexed slots with dependency structure, covert forms, and competing analyses). Form identity is computed over structural content alone and is independent of encoding, script, casing, and rendering."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMEOW Language"@x-gmeow-english ;
    skos:definition "The GMEOW Language module — home of the lang: grounding vocabulary. Its two load-bearing commitments are that a language is an individual and never a tag, and that a string is a surface while the form is a tree. A sign system is a first-class individual distinguished by a lang:SignSystemKind and a lang:Modality rather than by a subclass ladder; scripts (character repertoires) and orthographies (system-to-script conventions) are separated; grammars are first-class objects that license forms without owning their identity. A form that carries inferential weight is a structured lang:Form, never an opaque string: every form names exactly one sign system, morphology is typed against a lang:FeatureInventory, constituent order is carried by indexed lang:FormSlot individuals with co-resident dependency edges, and every surface either realizes an analyzed form or is explicitly lang:UnanalyzedProse. The graded lang:AnalysisLevel records how far a surface has been analyzed (raw, segmented, tokenized, morph-analyzed, parsed) rather than forcing a binary. The typed conformance-failure vocabulary (lang:LangConformanceFailure and its subclasses) makes every well-formedness violation a queryable object."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# =========================================================================== #
# Sign-system reference layer
# =========================================================================== #

lang:SignSystem
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Sign System"@x-gmeow-english ;
    skos:definition "A sign system: the system of signs a form belongs to — a natural language (English), a formal language (Turtle, GTS), a notation (IPA), a gestural language (a signed language), or a tactile system (Braille). A first-class individual, never a subclass ladder and never a bare tag: it is distinguished by a lang:SignSystemKind (through lang:signSystemKind) and a lang:Modality (through lang:modality), and it may align to a BCP-47 tag, an ISO 639 code, a Wikidata QID, or a MIME type — but the GMEOW term remains the local source of truth and external identifiers name alignments, not identity. Every lang:Form names exactly one through lang:inSignSystem."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SignSystemKind
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Sign System Kind"@x-gmeow-english ;
    skos:definition "The kind of a sign system — natural, formal, notational, gestural, or tactile. Its instances are the named individuals lang:naturalLanguageKind, lang:formalLanguageKind, lang:notationalKind, lang:gesturalKind, and lang:tactileKind. A sign system points at one through lang:signSystemKind; the kind-individual pattern keeps the TBox small and the ABox expressive rather than minting an OWL class per language."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:LanguageVariety
    a owl:Class ;
    rdfs:subClassOf lang:SignSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Language Variety"@x-gmeow-english ;
    skos:definition "A variety of a sign system — Quebec French, Middle English, or RFC-2119 requirement prose. A subclass of lang:SignSystem related to its parent system through lang:varietyOf, time-scoped through the temporal slice where the variety is a stage. A variety is a system in its own right, not a qualifier; a BCP-47 tag such as fr-CA is a projection of a variety individual, never its definition."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Script
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Script"@x-gmeow-english ;
    skos:definition "A script: a character repertoire — Latin, Cyrillic, Han. Distinct from an orthography, which is the convention binding a sign system to a script (Serbian has one language and two orthographies). A script names its member characters through lang:hasGrapheme; a lang:Grapheme declares the script it belongs to through lang:inScript. Aligns to ISO 15924 as a generated identifier."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Orthography
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Orthography"@x-gmeow-english ;
    skos:definition "An orthography: a convention binding a sign system to a script — the writing convention, as distinct from the script's bare character repertoire. Names the sign system it serves through lang:orthographyFor and the script it uses through lang:usesScript. Transliteration between orthographies is a rendering-layer map, not a form-identity change."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Grammar
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Grammar"@x-gmeow-english ;
    skos:definition "A grammar: a first-class object naming the sign system it licenses (through lang:grammarFor) and carrying its rules as lang:GrammarRule individuals. Declares its formalism through lang:grammarFormalism (context-free, PEG, regular, ABNF, EBNF). Formal grammars (Turtle's, GTS's) are held natively and projected to EBNF/ABNF — a grammar file is a rendering of the grammar object, not the grammar. A grammar licenses forms; it never owns their identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GrammarRule
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Grammar Rule"@x-gmeow-english ;
    skos:definition "A production rule of a grammar: names the grammar it belongs to through lang:grammarRuleOf. A form may declare the rule that licenses it through lang:licensedBy, but form identity never depends on the grammar — grammars change, forms persist, and the licensing link is versioned like any evolving claim."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:GrammarFormalism
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Grammar Formalism"@x-gmeow-english ;
    skos:definition "The formalism a grammar is expressed in. Its instances are the named individuals lang:cfgFormalism, lang:pegFormalism, lang:regularFormalism, lang:abnfFormalism, and lang:ebnfFormalism. A lang:Grammar points at one through lang:grammarFormalism."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Modality
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Modality"@x-gmeow-english ;
    skos:definition "The channel a sign system operates in — written, spoken, signed, or tactile. Its instances are the named individuals lang:writtenModality, lang:spokenModality, lang:signedModality, and lang:tactileModality. A sign system points at one through lang:modality, so signed languages and Braille are first-class rather than special cases of writing."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Sign-system-kind individuals ------------------------------------------- #

lang:naturalLanguageKind
    a owl:NamedIndividual , lang:SignSystemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "natural language"@x-gmeow-english ;
    skos:definition "The kind of sign system that is a natural human language — English, French, Japanese."@x-gmeow-english .

lang:formalLanguageKind
    a owl:NamedIndividual , lang:SignSystemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "formal language"@x-gmeow-english ;
    skos:definition "The kind of sign system that is a formal language with an explicit grammar — Turtle, the GTS grammar, a programming language."@x-gmeow-english .

lang:notationalKind
    a owl:NamedIndividual , lang:SignSystemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "notation"@x-gmeow-english ;
    skos:definition "The kind of sign system that is a notation — IPA, mathematical notation, a controlled symbolic vocabulary."@x-gmeow-english .

lang:gesturalKind
    a owl:NamedIndividual , lang:SignSystemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "gestural"@x-gmeow-english ;
    skos:definition "The kind of sign system that is gestural — a signed language such as ASL."@x-gmeow-english .

lang:tactileKind
    a owl:NamedIndividual , lang:SignSystemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "tactile"@x-gmeow-english ;
    skos:definition "The kind of sign system that is tactile — Braille."@x-gmeow-english .

# --- Modality individuals --------------------------------------------------- #

lang:writtenModality
    a owl:NamedIndividual , lang:Modality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "written"@x-gmeow-english ;
    skos:definition "The written modality — a sign system realized as text in a script."@x-gmeow-english .

lang:spokenModality
    a owl:NamedIndividual , lang:Modality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "spoken"@x-gmeow-english ;
    skos:definition "The spoken modality — a sign system realized as speech."@x-gmeow-english .

lang:signedModality
    a owl:NamedIndividual , lang:Modality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "signed"@x-gmeow-english ;
    skos:definition "The signed modality — a sign system realized in gesture and space, as in a signed language."@x-gmeow-english .

lang:tactileModality
    a owl:NamedIndividual , lang:Modality ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "tactile"@x-gmeow-english ;
    skos:definition "The tactile modality — a sign system realized by touch, as in Braille."@x-gmeow-english .

# --- Grammar-formalism individuals ------------------------------------------ #

lang:cfgFormalism
    a owl:NamedIndividual , lang:GrammarFormalism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "context-free"@x-gmeow-english ;
    skos:definition "The context-free grammar formalism."@x-gmeow-english .

lang:pegFormalism
    a owl:NamedIndividual , lang:GrammarFormalism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "PEG"@x-gmeow-english ;
    skos:definition "The parsing-expression-grammar formalism."@x-gmeow-english .

lang:regularFormalism
    a owl:NamedIndividual , lang:GrammarFormalism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "regular"@x-gmeow-english ;
    skos:definition "The regular-grammar formalism."@x-gmeow-english .

lang:abnfFormalism
    a owl:NamedIndividual , lang:GrammarFormalism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "ABNF"@x-gmeow-english ;
    skos:definition "The RFC 5234 ABNF grammar-interchange formalism."@x-gmeow-english .

lang:ebnfFormalism
    a owl:NamedIndividual , lang:GrammarFormalism ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "EBNF"@x-gmeow-english ;
    skos:definition "The ISO/IEC 14977 EBNF grammar-interchange formalism."@x-gmeow-english .

# =========================================================================== #
# Form AST — the stratified form calculus
# =========================================================================== #

lang:Form
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Form"@x-gmeow-english ;
    skos:definition "The abstract root of the form AST: a form that is meant to be analyzed, denoted, translated, matched, or projected is a structured object, never an opaque string. Every lang:Form names exactly one sign system through lang:inSignSystem — an unsituated form is ill-formed. Its identity is computed over structural content alone (sign system, stratum, features, slot structure with constituent keys) and is independent of encoding, script, casing, and rendering. The strata that specialize it — surface forms, morphemes and morphs, lexemes and word forms, orthographic and syntactic words, composed forms, and covert forms — each have a distinct identity criterion."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SurfaceForm
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Surface Form"@x-gmeow-english ;
    skos:definition "A concrete realization of a form: text (through lang:surfaceText) with a declared script (lang:inScript), encoding (lang:encoding), Unicode normalization (lang:unicodeNormalization), and collation locale (lang:collationLocale). The only stratum where byte identity means anything: two surface forms with different normalization are different surface forms of possibly the same form. A surface either realizes an analyzed form through lang:realizes or is typed lang:UnanalyzedProse — never silently either — and declares how far it has been analyzed through lang:analysisLevel. It may carry a lang:SurfaceAnchor locating it in a source document. Re-encoding or re-normalizing a text creates new surface forms but no new forms."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:UnanalyzedProse
    a owl:Class ;
    rdfs:subClassOf lang:SurfaceForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Unanalyzed Prose"@x-gmeow-english ;
    skos:definition "A surface form explicitly recorded as carrying no analyzed structure yet — the honest status of most @x-gmeow-english prose fields. Lawful and expected, but a recorded status rather than an ambient assumption, so 'this string has no structure yet' is a queryable fact. An unanalyzed-prose surface is at lang:rawLevel and does not lang:realize an analyzed form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SurfaceAnchor
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Surface Anchor"@x-gmeow-english ;
    skos:definition "A stand-off anchor locating a surface form in a source: names the source through lang:anchorSource, the span through lang:anchorStart and lang:anchorEnd, and the offset space through lang:offsetSpace (byte, codepoint, or grapheme cluster). Surface-stratum material excluded from form identity but included in surface identity; the anchor is what makes the prose-hash discipline a lookup rather than a recomputation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Grapheme
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Grapheme"@x-gmeow-english ;
    skos:definition "A grapheme: a member character of a script's repertoire — a Latin letter, a Cyrillic letter, a Han character. Declares the script it belongs to through lang:inScript; the owning script lists it through lang:hasGrapheme. A grapheme not in its script's repertoire is ill-formed. Below the morph in the stratification; a repertoire element rather than a sign-system-scoped form."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Phone
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Phone"@x-gmeow-english ;
    skos:definition "A phone: a segment of sound, the phonetic counterpart of a grapheme, notated in IPA. Below the morph in the stratification; the segment stratum for spoken and phonological analysis."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Morpheme
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Morpheme"@x-gmeow-english ;
    skos:definition "A morpheme: the abstract smallest meaningful unit — the identity-bearing plural morpheme, the past-tense morpheme — as distinct from its concrete realizations. Its realizing morphs name it through lang:morphemeOf. The abstract counterpart of the concrete lang:Morph, the morphological peer of the lang:Lexeme / lang:WordForm split."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Morph
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Morph"@x-gmeow-english ;
    skos:definition "A morph: the concrete realization of a morpheme — /s/, /z/, /ɪz/ realizing the English plural morpheme. Names the morpheme it realizes through lang:morphemeOf and any morph it is an allomorph of through lang:allomorphOf. Carries typed morphological content through lang:morphFeature; morphology is never a free string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:MorphFeature
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Morph Feature"@x-gmeow-english ;
    skos:definition "A typed morphological feature-value pair — Number=Plur, Tense=Past — carrying a key drawn from a feature inventory (lang:featureKey, a lang:FeatureKey individual), a value drawn from that inventory (lang:featureValue, a lang:FeatureValue individual), and optionally a layer (lang:featureLayer, as in the UD Number[psor] convention). Morphological content is carried this way, never as an unparsed feature string; the inventory aligns to Universal Dependencies' universal features and extends past them where a language demands it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Lexeme
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Lexeme"@x-gmeow-english ;
    skos:definition "A lexeme: the dictionary word — the abstract cat, as opposed to its inflections cat and cats. Declares its part of speech through lang:partOfSpeech. The lexeme, not the spelling, is what senses attach to (in the meaning layer). The OntoLex form / lexical-entry split, held with GMEOW's claim rigor."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:WordForm
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Word Form"@x-gmeow-english ;
    skos:definition "A word form: an inflection of a lexeme — cats as an inflection of the lexeme cat. Names its lexeme through lang:lexemeOf (and the inflection relation through lang:inflectionOf), and carries the morphological features distinguishing it through lang:morphFeature (cats carries Number=Plur)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:OrthographicWord
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Orthographic Word"@x-gmeow-english ;
    skos:definition "An orthographic word: a whitespace- or punctuation-delimited token that may correspond to several syntactic words — French du (= de le), English isn't (= is + n't). Names the syntactic words it spans through lang:spansWords. The CoNLL-U multiword-token distinction, held natively: one orthographic token is not always one syntactic word."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:SyntacticWord
    a owl:Class ;
    rdfs:subClassOf lang:WordForm ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Syntactic Word"@x-gmeow-english ;
    skos:definition "A syntactic word: a word form that is a unit of syntactic analysis, participating in the dependency and constituency structure — de and le as the two syntactic words of the orthographic word du. Names the orthographic word it belongs to through lang:tokenOf. A subclass of lang:WordForm."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:ComposedForm
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Composed Form"@x-gmeow-english ;
    skos:definition "A composed form: a phrase, clause, sentence, paragraph, section, or text as a tree over indexed slots. Declares its level through lang:compositionLevel, its constituents through lang:formSlot, and its head where headedness is analyzed through lang:formHead. Constituent order is carried by lang:FormSlot individuals with integer lang:slotIndex, never by RDF list ordering — two encodings of one form must be one form. Code-switching is compositional: the composed form belongs to its matrix system while embedded constituents carry their own."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FormSlot
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Form Slot"@x-gmeow-english ;
    skos:definition "A slot in a composed form: carries an integer lang:slotIndex (constituent order), the constituent form (lang:slotForm), optionally a grammatical role (lang:slotRole, a lang:FormRole individual), and — where a dependency analysis is present — a dependency relation (lang:dependencyRelation) and a head reference among sibling slots (lang:dependsOn). Slot indexes are unique per composed form; strict canonical mode requires them zero-based and contiguous. Word order and grammatical function are identity-bearing."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FormRole
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Form Role"@x-gmeow-english ;
    skos:definition "A grammatical role or dependency relation a constituent plays — subject, predicate, object, modifier. Universal-Dependencies-relation-alignable. Its instances are named individuals such as lang:subjectRole, lang:predicateRole, lang:objectRole, and lang:modifierRole; a slot points at one through lang:slotRole or lang:dependencyRelation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:CovertForm
    a owl:Class ;
    rdfs:subClassOf lang:Form ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Covert Form"@x-gmeow-english ;
    skos:definition "A covert form: a constituent that is structurally present but has no surface material — a zero morpheme (the plural of sheep), a syntactic trace, an elided or pro-dropped element. Keys distinctly from an absent constituent, so morphological and syntactic completeness survives even where there is nothing to spell. A subclass of lang:Form; it names its sign system like any form but has no realizing surface."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:Analysis
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Analysis"@x-gmeow-english ;
    skos:definition "A grouping of one coherent analysis of a surface — one segmentation and one parse — so that competing analyses of the same surface are co-resident, comparable, and non-collapsing. Slots and dependency edges are scoped to the analysis they belong to through lang:inAnalysis; an edge leaving its analysis is ill-formed. The structural foundation for ambiguity: the meaning layer attaches vantage and confidence to readings over these analyses, but the multiplicity of structure lives here."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:PartOfSpeech
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Part of Speech"@x-gmeow-english ;
    skos:definition "A part of speech — noun, verb, adjective. Its instances are named individuals such as lang:noun and lang:verb, Universal-Dependencies-UPOS-alignable. A lexeme points at one through lang:partOfSpeech."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:CompositionLevel
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Composition Level"@x-gmeow-english ;
    skos:definition "The level at which a composed form composes — morphological word, phrase, clause, sentence, paragraph, section, or text. Its instances are the named individuals lang:morphWordLevel, lang:phraseLevel, lang:clauseLevel, lang:sentenceLevel, lang:paragraphLevel, lang:sectionLevel, and lang:textLevel. A composed form points at one through lang:compositionLevel, so a sentence and a document are distinguishable and document structure is first-class for the prose lift."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:AnalysisLevel
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Analysis Level"@x-gmeow-english ;
    skos:definition "How far a surface form has been analyzed — raw, segmented, tokenized, morph-analyzed, or parsed. Its instances are the named individuals lang:rawLevel, lang:segmentedLevel, lang:tokenizedLevel, lang:morphAnalyzedLevel, and lang:parsedLevel, ordered by an integer lang:levelRank. A surface points at exactly one through lang:analysisLevel, and its structure must match the declared level. This graded status replaces a binary analyzed/unanalyzed flag and preserves the epistemic shape of partial analysis; denotation is the meaning layer's level, above these."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FeatureInventory
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Feature Inventory"@x-gmeow-english ;
    skos:definition "A declared inventory of morphological feature keys and values — the Universal Dependencies universal features and its language-specific extensions. Its member keys and values name it through lang:inFeatureInventory. Typed morphology is drawn from an inventory rather than authored as free strings; the inventory is the alignment anchor for UD and UniMorph."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FeatureKey
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Feature Key"@x-gmeow-english ;
    skos:definition "A morphological feature key — Number, Case, Tense, Person. Its instances are named individuals belonging to a lang:FeatureInventory through lang:inFeatureInventory. A lang:MorphFeature names its key through lang:featureKey, an inventory individual rather than a bare string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:FeatureValue
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Feature Value"@x-gmeow-english ;
    skos:definition "A morphological feature value — Plur, Sing, Past, Pres, Nom, Acc. Its instances are named individuals belonging to a lang:FeatureInventory through lang:inFeatureInventory. A lang:MorphFeature names its value (or, for disjunctive underspecification, several) through lang:featureValue, an inventory individual rather than a bare string."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

lang:OffsetSpace
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "Offset Space"@x-gmeow-english ;
    skos:definition "The unit an anchor's offsets are measured in — byte, Unicode codepoint, or grapheme cluster. Its instances are the named individuals lang:byteOffset, lang:codepointOffset, and lang:graphemeClusterOffset. A lang:SurfaceAnchor names one through lang:offsetSpace so its span is unambiguous."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Form-role individuals -------------------------------------------------- #

lang:subjectRole
    a owl:NamedIndividual , lang:FormRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "subject"@x-gmeow-english ;
    skos:definition "The subject role — Universal Dependencies nsubj."@x-gmeow-english .

lang:predicateRole
    a owl:NamedIndividual , lang:FormRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "predicate"@x-gmeow-english ;
    skos:definition "The predicate role — the head verb of a clause, Universal Dependencies root for the main predicate."@x-gmeow-english .

lang:objectRole
    a owl:NamedIndividual , lang:FormRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "object"@x-gmeow-english ;
    skos:definition "The object role — Universal Dependencies obj."@x-gmeow-english .

lang:modifierRole
    a owl:NamedIndividual , lang:FormRole ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
