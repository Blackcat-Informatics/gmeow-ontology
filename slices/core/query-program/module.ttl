logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "answer" ], [ logic:termIndex 2 ; logic:termVariable "retainedList" ] ;
logic:forall [ a logic:Formula ;
logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryCandidateUnion ] ],
[ a logic:Formula ;
logic:relation gmeow:mergeAnswerOutput ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "answer" ] ],
[ a logic:Formula ;
logic:relation gmeow:unionClassList ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "answer" ], [ logic:termIndex 1 ; logic:termVariable "retainedList" ] ] ] ;
logic:consequent [ a logic:Formula ;
logic:relation gmeow:mergeAnswerInput ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "retainedList" ] ] ] ] .

gmeow:UnionSelectedListClassLaw
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "union selected list class law"@x-gmeow-english ;
    skos:definition "Each RankedQueryList selected as a QueryCandidateUnion input retains a supplied retrieval-class resource through rankedListClass."@x-gmeow-english ;
    gmeow:useWhen "Use to require class identity for selected union inputs without changing the required fields of ordinary ranked lists."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid manufacturing a class identity, selecting it from a human label or adding a global required-path closure."@x-gmeow-english ;
