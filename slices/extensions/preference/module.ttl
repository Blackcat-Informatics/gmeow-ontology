    skos:definition "The gmeow:deltaRubricIdentity atom ('delta rubric identity') of gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): relates ?this, ?rb."@x-gmeow-english ; logic:relation gmeow:deltaRubricIdentity ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "rb" ] .
