#
# What a closed frontier actually certifies.
#
# Every other enactment example in this directory shows the kernel being USED. This
# one shows the kernel being FINISHED: the moment the frontier derivation runs out
# of new tuples, and the witness it leaves behind so that a reader can check the
# claim instead of taking it.
#
# The reason the witness enumerates rather than summarizes is that closure is not a
# property of a run, it is a property of a PREDICATE. "The chase reached a fixed
# point" is shorthand for "for each of these predicates, no further rule application
# adds a tuple", and the predicates the witness does not name are exactly the ones it
# does not certify. So a reader of a closed roster who wants to know whether the
# absence of an entry is evidence of absence has a precise question to ask — is the
# predicate that would have produced it on this list? — and this scene is the answer
# for a whole-kernel run.
#
# Read as documentation, the roster below is also a map of the enactment kernel's
# derived surface: the approval, effect-protocol, journal, checkpoint, refinement and
# frontier predicates the chase touches, in one place, with the budget it cost.
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/logic/closure/> .

# The run this closure is about. Naming it matters: a witness detached from the
# enactment it closed over is a certificate with no subject.
ex:auditRun2291 a logic:Enactment ;
    rdfs:label "Quarterly reconciliation run 2291"@x-gmeow-english ;
    logic:enactsPrescriptionVersion ex:reconciliationV7 ;
    logic:enactmentInputSnapshot ex:ledgerGeneration412 ;
    logic:enactmentState logic:EnactmentRunning .

# The frozen text the run is following, and the frozen inputs it is following it
# over. A closure claim about a run that could name neither would be a claim about
# nothing repeatable: the same frontier derived tomorrow would be a different
# derivation, and the witness below could not be checked against it.
ex:reconciliationQuarterly a logic:Plan ;
    rdfs:label "Quarterly ledger reconciliation"@x-gmeow-english ;
    logic:planGoal ex:ledgersReconciled ;
    logic:planSuccessMode logic:StrongCyclicPlanSuccess .

ex:ledgersReconciled a gmeow:Goal ;
    rdfs:label "Every ledger line is matched or exceptioned"@x-gmeow-english .

ex:reconciliationV7 a logic:PrescriptionVersion ;
    rdfs:label "Quarterly ledger reconciliation, revision 7"@x-gmeow-english ;
    logic:prescriptionOf ex:reconciliationQuarterly ;
    logic:prescriptionDigest "b3:9d4a17c6b0e83f52a7148db93c05fe6218a7d340bb6c19e57f2043ae8c1d76b9" .

ex:ledgerGeneration412 a logic:InputSnapshot ;
    rdfs:label "Ledger generation 412, frozen at run start"@x-gmeow-english ;
    logic:snapshotDigest "b3:3e05fa71c8b249d06e37a1cd5840bf9276e1a03d5cb87f4e2091da6c37bf5108" .

ex:auditFrontier a logic:ActionableFrontier ;
    rdfs:label "Frontier of run 2291, derived to a fixed point"@x-gmeow-english ;
    logic:frontierOfEnactment ex:auditRun2291 ;
    logic:frontierSaturationWitness ex:auditSaturation .

# logic:EvaluationCompleted, not logic:BudgetExhausted: the search stopped because
# there was nothing left to add. The budget is recorded anyway — a fixed point is a
# claim relative to a bound, and a bound nobody wrote down cannot be re-checked.
ex:auditSaturation a logic:SaturationWitness ;
    rdfs:label "Saturation witness for run 2291"@x-gmeow-english ;
    logic:resultEvaluation logic:EvaluationCompleted ;
    logic:consumedBudget "steps=41208;pages=96;wallclock-ms=1873" ;
    logic:settledPredicate
        logic:adjudicatesAttempt ,
        logic:advisoryAbout ,
