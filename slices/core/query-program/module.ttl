    logic:formalizes gmeow:QueryProgramGraph ;
    logic:message "Every ranked entry belongs to exactly one ranked-list occurrence; reusing a candidate in another list requires another entry." ;
    logic:integrity
[
    a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "entry" ] ;
    logic:forall [
        a logic:Formula ;
        logic:antecedent [
            a logic:Formula ;
            logic:relation rdf:type ;
            logic:argument [ logic:termIndex 0 ; logic:termVariable "entry" ] ,
            [ logic:termIndex 1 ; logic:termIri gmeow:RankedQueryEntry ]
        ] ;
        logic:consequent [
            a logic:Formula ;
            logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "list" ] ;
            logic:exists [
                a logic:Formula ;
                logic:and [
                    a logic:Formula ;
                    logic:relation rdf:type ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "list" ] ,
                    [ logic:termIndex 1 ; logic:termIri gmeow:RankedQueryList ]
                ] ,
                [
                    a logic:Formula ;
                    logic:relation gmeow:rankedQueryEntry ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "list" ] ,
                    [ logic:termIndex 1 ; logic:termVariable "entry" ]
                ] ,
                [
                    a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "other" ] ;
                    logic:forall [
                        a logic:Formula ;
                        logic:antecedent [
                            a logic:Formula ;
                            logic:relation gmeow:rankedQueryEntry ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "other" ] ,
                            [ logic:termIndex 1 ; logic:termVariable "entry" ]
                        ] ;
                        logic:consequent [
                            a logic:Formula ;
                            logic:relation logic:termEqual ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "list" ] ,
                            [ logic:termIndex 1 ; logic:termVariable "other" ]
                        ]
                    ]
                ]
            ]
        ]
    ]
] .

gmeow:QueryIterationDistinctPassConstraint
