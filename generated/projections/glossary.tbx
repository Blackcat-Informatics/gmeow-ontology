      <termEntry id="c-cc398c16bdfaae44">
        <langSet xml:lang="en">
          <tig>
            <term>derive / modify</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>dériver / modifier</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>衍生 / 修改</term>
          </tig>
