    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "renewed self-commitment"@x-gmeow-english ;
    skos:definition "The agent renewed its internal commitment to pursue the intention."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly reports renewed self-commitment."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid deriving commitmentRenewed solely from silence, missing timestamps or another status axis."@x-gmeow-english ;
    gmeow:howToUse "Attach commitmentRenewed through commitmentStatus, preserving the source attribution and time context."@x-gmeow-english ;
