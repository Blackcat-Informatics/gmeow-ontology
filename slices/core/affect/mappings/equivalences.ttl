#
# Affect correspondence bridges — authored in-slice, lowered to SSSOM (and the
# shared projection-report loss ledger) by the pipeline. GMEOW-first: external
# vocabularies are LINKED, never imported. closeMatch by default; exactMatch is
# earned only after review, and never for a caveated overlap (the overclaim gate
# reds an unearned equivalence). Classifier labels are the first bridge layer
# (A5), then the ontology bridges (PROV-O, Web Annotation, MFOEM), then the W3C
# EmotionML vocabulary sets (relatedMatch, SET-LEVEL only — EmotionML category
# items are XML `name` attributes with no per-term IRI, so nothing finer is honest).
# EmotionML is ALSO emitted as a lossy XML projection of the affect category and
# dimension vocabularies (recorded in the projection loss ledger, many-to-one).
# The WordNet lexical layer IS bridged, by reference to Open English WordNet — its
# per-synset IRIs content-negotiate to OntoLex-Lemon RDF, so each canonical emotion type
# closeMatches its noun.feeling synset (below). That is the live successor to the defunct
# Princeton WordNet-Affect *affective-label* export, whose categorical content is carried,
# modeled up, in-slice. The Emotion Frame Ontology and Ithkuil carry NO resolvable per-term
# RDF surface — the Emotion Frame Ontology's term IRIs do not dereference and Ithkuil is a
# reference inventory, not a namespace authority — so a correspondence against them would
# fabricate a link to a dead IRI. Rather than leave that as an implicit comment, each is a
# reviewable gmeow:DeclinedCorrespondence in mappings/declined-bridges.ttl, carrying its
# rationale, a revisit condition, and logic:preservationKind logic:Unsupported.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix gmeow-goemotions: <https://blackcatinformatics.ca/gmeow-registry/goemotions/> .
@prefix gmeow-hf: <https://blackcatinformatics.ca/gmeow-registry/hf/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix emo: <https://www.w3.org/TR/emotion-voc/#> .
@prefix oewn: <https://en-word.net/id/oewn-> .

# ── Classifier registries → canonical GMEOW (closeMatch, never == ) ────────────
# GoEmotions labels are annotation categories over Reddit comments, not guaranteed
# to denote the same ontological thing as a GMEOW emotion mode; closeMatch, and
# exactMatch only after review.

gmeow-goemotions:anger skos:closeMatch gmeow:emotionAnger {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-goemotions:fear skos:closeMatch gmeow:emotionFear {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-goemotions:joy skos:closeMatch gmeow:emotionJoy {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-goemotions:sadness skos:closeMatch gmeow:emotionSadness {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-goemotions:disgust skos:closeMatch gmeow:emotionDisgust {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-goemotions:surprise skos:closeMatch gmeow:emotionSurprise {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-goemotions:grief skos:broadMatch gmeow:emotionSadness {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "grief is an intense, bereavement-scoped sadness — a narrower reading, so the GoEmotions label broad-matches the canonical sadness type"
|} .

# desire is a CONATIVE label — it bridges to teleology's gmeow:Desire, not an emotion type.
gmeow-goemotions:desire skos:closeMatch gmeow:Desire {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "a conative label — GoEmotions 'desire' bridges to teleology's gmeow:Desire, not to any emotion type"
|} .

# neutral has NO canonical mapping — a no-detected-affect label is not an EmotionType.

# j-hartmann Ekman-7 labels → canonical emotion types.
gmeow-hf:ekmanAnger skos:closeMatch gmeow:emotionAnger {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-hf:ekmanFear skos:closeMatch gmeow:emotionFear {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-hf:ekmanJoy skos:closeMatch gmeow:emotionJoy {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-hf:ekmanSadness skos:closeMatch gmeow:emotionSadness {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-hf:ekmanDisgust skos:closeMatch gmeow:emotionDisgust {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow-hf:ekmanSurprise skos:closeMatch gmeow:emotionSurprise {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

# Sentiment labels bridge to the VALENCE appraisal axis of the target text, never
# to an emotion (positive sentiment is not joy) — a deliberately weak relatedMatch.
gmeow-hf:sst2Positive skos:relatedMatch gmeow:dimensionValence {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "SST-2 POSITIVE is a valence appraisal of the target text (above midpoint), never an emotion — relatedMatch to the valence axis"
|} .

gmeow-hf:sst2Negative skos:relatedMatch gmeow:dimensionValence {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "SST-2 NEGATIVE is a valence appraisal of the target text (below midpoint), never an emotion — relatedMatch to the valence axis"
|} .

gmeow-hf:cardiffPositive skos:relatedMatch gmeow:dimensionValence {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75
|} .

gmeow-hf:cardiffNegative skos:relatedMatch gmeow:dimensionValence {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75
|} .

# ── PROV-O: the inference-output activity/entity chain ─────────────────────────
gmeow:ModelInferenceRun skos:closeMatch prov:Activity {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "a model run is a prov:Activity; closeMatch, since GMEOW pins richer model provenance than PROV requires"
|} .

gmeow:AffectClassifierOutput skos:closeMatch prov:Entity {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:producedBy skos:closeMatch prov:wasGeneratedBy {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:usedInput skos:closeMatch prov:used {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

# ── Web Annotation: evidence spans and media segments ──────────────────────────
gmeow:AffectiveExpression skos:relatedMatch oa:Annotation {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "an affective expression observed over a span is annotation-shaped; relatedMatch — an expression is evidence, not a bare annotation"
|} .

gmeow:classifiedTarget skos:relatedMatch oa:hasTarget {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7
|} .

# ── MFOEM (Emotion Ontology, BFO lineage) — linkage-only, closeMatch ───────────
gmeow:Emotion skos:closeMatch bfo:MFOEM_000001 {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "MFOEM_000001 'emotion process'; closeMatch — GMEOW's Emotion is the endurant mode, MFOEM's is the occurrent process, so not exact"
|} .

gmeow:emotionAnger skos:closeMatch bfo:MFOEM_000009 {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:emotionDisgust skos:closeMatch bfo:MFOEM_000019 {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:emotionFear skos:closeMatch bfo:MFOEM_000026 {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:emotionSurprise skos:closeMatch bfo:MFOEM_000032 {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:emotionJoy skos:closeMatch bfo:MFOEM_000034 {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:emotionSadness skos:closeMatch bfo:MFOEM_000056 {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

# ── Wikidata authority links (each QID curl-verified against its English label) ─
gmeow:Emotion skos:closeMatch wd:Q9415 {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "wd:Q9415 'emotion'"
|} .

gmeow:emotionAnger skos:closeMatch wd:Q260704 {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "wd:Q260704 'anger'"
|} .

gmeow:emotionDisgust skos:closeMatch wd:Q208351 {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "wd:Q208351 'disgust'"
|} .

# ── W3C EmotionML vocabulary sets (SET-LEVEL relatedMatch — no per-term IRI) ────
# EmotionML category items are XML `name` attributes, not dereferenceable terms, so
# the honest bridge is vocabulary-set to vocabulary-set: the gmeow category / core-affect
# / appraisal vocabularies are RELATED to (never == ) the corresponding EmotionML sets.
# Each object is a resolvable anchor on the W3C EmotionML Vocabularies note.
gmeow:EmotionType skos:relatedMatch emo:everyday-categories {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "the gmeow emotion-category vocabulary relates to EmotionML's 'everyday' category set — a set-level association, not a per-term equivalence"
|} .

gmeow:CoreAffectDimension skos:relatedMatch emo:pad-dimensions {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "the gmeow core-affect axes (valence / arousal / dominance / unpredictability) relate to EmotionML's PAD dimension set — set-level, closest of the EmotionML dimension vocabularies"
|} .

gmeow:AppraisalDimension skos:relatedMatch emo:scherer-appraisals {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "the gmeow cognitive appraisal axes (novelty, goal-relevance, coping, norm-compatibility, …) relate to EmotionML's Scherer appraisal set — set-level, the appraisal-family analogue"
|} .

# ── Open English WordNet — OntoLex-Lemon lexical bridge (closeMatch to the emotion synset) ──
# The affect lexical surface. Open English WordNet publishes per-synset IRIs that
# content-negotiate to lemon RDF (…/id/oewn-<offset>-n), so each canonical emotion type
# closeMatches the WordNet "feeling" synset (noun.feeling) that denotes it — a concept-level
# link by reference (Principle 5), the OntoLex lexical-sense bridge the affect layer targets.
# closeMatch, never == : a WordNet synset is a lexical-semantic concept, close to but not the
# same carrier as GMEOW's emotion mode. This is the live successor to the defunct Princeton
# WordNet-Affect export — WordNet's lexical layer, not its retired affective-label extension.
gmeow:emotionAnger skos:closeMatch oewn:07531593-n {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OEWN noun.feeling synset 'a strong emotion; a feeling oriented toward some real or supposed grievance'"
|} .

gmeow:emotionFear skos:closeMatch oewn:07534492-n {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OEWN noun.feeling synset 'an emotion experienced in anticipation of some specific pain or danger'"
|} .

gmeow:emotionJoy skos:closeMatch oewn:07542591-n {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OEWN noun.feeling synset 'the emotion of great happiness'"
|} .

gmeow:emotionSadness skos:closeMatch oewn:07547828-n {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OEWN noun.feeling synset 'emotions experienced when not in a state of well-being'"
|} .

gmeow:emotionDisgust skos:closeMatch oewn:07518499-n {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OEWN noun.feeling synset 'strong feelings of dislike'"
|} .

gmeow:emotionSurprise skos:closeMatch oewn:07525587-n {|
    gmeow:sssomFile "gmeow-affect.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OEWN noun.feeling synset 'the astonishment you feel when something totally unexpected happens to you'"
|} .
