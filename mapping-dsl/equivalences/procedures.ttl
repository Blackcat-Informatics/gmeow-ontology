@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .
@prefix schema:  <https://schema.org/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix pplan:   <http://purl.org/net/p-plan#> .
@prefix opmw:    <https://www.opmw.org/ontology/> .
@prefix obi:     <http://purl.obolibrary.org/obo/OBI_> .
@prefix bpmn:    <http://www.omg.org/spec/BPMN/20100524/MODEL#> .
@prefix ro_crate: <https://w3id.org/ro/crate/#> .
# Procedure / Execution / Step alignments — GMEOW authoring source.
# Compiled to mappings/gmeow-procedures.sssom.tsv by `gmeow compile-mappings`.
# Projections live in mapping-dsl/projections/schema-org-procedures.ttl.
#
# NOTE: BPMN 2.0, CWL, WDL, and RO-Crate Workflow-Run do not publish canonical
# RDF ontologies with stable term IRIs; alignments to them are carried as
# skos:relatedMatch to informal concept URIs and will be refined when stable
# vocabularies emerge.

gmeow:mapsetProcedures a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/procedures" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Plan ⟂ execution de-conflation alignments to P-Plan, PROV-O, schema.org HowTo/Recipe, OPMW, and OBI. GMEOW models the distinction natively and bridges by reference (Principle 5)." .

# --------------------------------------------------------------------------- #
# P-Plan — the closest peer model for plan / step / input / output / precedence
# --------------------------------------------------------------------------- #

gmeow:eqProc001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject pplan:Plan ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "P-Plan Plan; GMEOW Procedure is broader (includes recipes, CI, business processes)." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ProcedureStep ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject pplan:Step ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "P-Plan Step; GMEOW ProcedureStep adds stepType values and subprocess composition." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Execution ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject pplan:Activity ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "P-Plan Activity is the execution of a Step; GMEOW Execution is the event that enacts a Procedure or Step." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:stepInput ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject pplan:Input ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "P-Plan Input variable; GMEOW stepInput is a property pointing to any entity." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:stepOutput ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject pplan:Output ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "P-Plan Output variable; GMEOW stepOutput is a property pointing to any entity." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ControlFlow ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject pplan:precededBy ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "P-Plan precededBy is a direct property between steps; GMEOW ControlFlow is a reified relator." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

# --------------------------------------------------------------------------- #
# PROV-O — prov:Plan and prov:Activity
# --------------------------------------------------------------------------- #

gmeow:eqProc007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:Plan ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "PROV-O Plan; GMEOW Procedure is typed as InformationObject and carries step structure." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc008 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Execution ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:Activity ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "PROV-O Activity; GMEOW Execution is the event occurrence that enacts a plan." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc009 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:stepInput ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:used ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "PROV-O used — an activity consumes an entity; GMEOW stepInput is the plan-level consumption." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc010 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:stepOutput ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:wasGeneratedBy ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "PROV-O wasGeneratedBy — an entity is produced by an activity; GMEOW stepOutput is the plan-level production." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

# --------------------------------------------------------------------------- #
# schema.org — HowTo / HowToStep / HowToTool / HowToSupply / Recipe
# --------------------------------------------------------------------------- #

gmeow:eqProc011 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:HowTo ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema.org HowTo; GMEOW Procedure is broader (includes protocols, CI, business processes)." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc012 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:Recipe ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "schema.org Recipe is a Procedure of type recipe." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc013 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ProcedureStep ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:HowToStep ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema.org HowToStep; GMEOW ProcedureStep adds control-flow and data-flow relators." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc014 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:stepInput ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:supply ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "schema.org supply — a consumable input to a HowToStep." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc015 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:stepInput ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:tool ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "schema.org tool — a tool used in a HowToStep." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc016 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:stepOutput ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:result ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "schema.org result — the output of a HowTo." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc017 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasProcedureStep ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:step ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema.org step — the steps of a HowTo." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

# --------------------------------------------------------------------------- #
# OPMW — WorkflowTemplate vs WorkflowExecution (the plan ⟂ execution split)
# --------------------------------------------------------------------------- #

gmeow:eqProc018 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject opmw:WorkflowTemplate ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "OPMW WorkflowTemplate; GMEOW Procedure is the plan side of the de-conflation." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc019 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Execution ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject opmw:WorkflowExecution ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "OPMW WorkflowExecution; GMEOW Execution is the execution side of the de-conflation." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc020 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ProcedureStep ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject opmw:WorkflowTemplateProcess ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "OPMW WorkflowTemplateProcess; GMEOW ProcedureStep is the atomic step in a plan." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

# --------------------------------------------------------------------------- #
# OBI — laboratory protocols and planned processes
# --------------------------------------------------------------------------- #

gmeow:eqProc021 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Procedure ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject obi:0000272 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OBI protocol (OBI:0000272); GMEOW Procedure generalises this to all prescriptive specs." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc022 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Execution ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject obi:0000011 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "OBI planned process (OBI:0000011); GMEOW Execution is the event occurrence." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

# --------------------------------------------------------------------------- #
# BPMN — conceptual alignments (no canonical RDF ontology with stable IRIs)
# --------------------------------------------------------------------------- #

gmeow:eqProc023 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:stepTypeBranch ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject bpmn:gateway ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "BPMN gateway; GMEOW stepTypeBranch is a value on a ProcedureStep." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc024 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ControlFlow ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject bpmn:sequenceFlow ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "BPMN sequenceFlow; GMEOW ControlFlow is a reified relator with optional guard." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

gmeow:eqProc025 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:DataFlow ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject bpmn:dataAssociation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "BPMN dataAssociation; GMEOW DataFlow is a reified relator carrying the flowing entity." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .

# --------------------------------------------------------------------------- #
# RO-Crate Workflow-Run — reproducibility profile
# --------------------------------------------------------------------------- #

gmeow:eqProc026 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Execution ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject ro_crate:CreateAction ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "RO-Crate Workflow-Run CreateAction; GMEOW Execution is the event that enacts a procedure." ;
    gmeow:sssomFile "gmeow-procedures.sssom.tsv" .
