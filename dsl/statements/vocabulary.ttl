@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix logic:   <https://blackcatinformatics.ca/logic/> .

# =============================================================================
# GMEOW statement DSL — the canonical source for the RDF 1.2 / RDF* statement-
# metadata layer (provenance, confidence, temporal scope).
#
# GMEOW is RDF 1.2 / RDF*-FIRST (CONSTITUTION Principles 2-3): statement-level
# metadata is authored ONCE here, and the `gmeow-dev sync --mode update --outputs generated` statements generator emits two
# verified artifacts from it — the RDF 1.2 / RDF* serialization (the canonical
# LEAD form, through the native RDF codec) and the OWL 2 axiom-annotation form (the generated,
# reasoning-lossless DOWNCAST the OWL 2 DL reasoners consume). The OWL form is a
# projection (Principle 4), never a competing source of truth; it recedes as
# RDF-1.2-native reasoners arrive.
#
# Each cell is a 1:1 STRUCTURAL TRANSCRIPTION of one
# RDF 1.2 reifying statement: the (qSubject qPredicate qObject) triad IS the
# quoted triple, gmeow:reifier IS the rdf:reifies subject, and the gmeow:annotation
# list IS every triple hung off the reifier. The native compiler preserves
# this statement identity in both projections.
#
# This file is a SPEC LAYER — grounded in gmeow: and annotated like every GMEOW
# term, but NOT owl:imports-ed into the reasoned OWL 2 DL core. It is the sibling
# of mapping-dsl/vocabulary.ttl.
# =============================================================================

<https://blackcatinformatics.ca/gmeow/statement-dsl>
    a logic:Ontology ;
    rdfs:label "GMEOW statement DSL vocabulary"@x-gmeow-english ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "Authoring vocabulary for the canonical RDF 1.2 / RDF* statement-metadata layer; compiled to the RDF 1.2 serialization + the OWL axiom-annotation downcast by the `gmeow-dev sync --mode update --outputs generated` statements generator."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# The cell type — one reified statement
# --------------------------------------------------------------------------- #

gmeow:StatementMetadata a logic:Class ;
    rdfs:label "statement metadata"@x-gmeow-english ;
    skos:definition "One reified RDF 1.2 statement: a quoted base triple (qSubject/qPredicate/qObject) plus the metadata annotations hung off its reifier (confidence, provenance, temporal scope). The structural isomorph of `?reifier rdf:reifies <<( ?s ?p ?o )>> . ?reifier <annProp> <annVal> .` — authored as plain Turtle, compiled to both RDF 1.2 and the OWL owl:Axiom downcast."@x-gmeow-english ;
    logic:subClassOf [
        a logic:Restriction ;
        logic:onProperty rdfs:label ;
        logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ;
    ] .

# --------------------------------------------------------------------------- #
# The reifier and the quoted triple
# --------------------------------------------------------------------------- #

gmeow:reifier a logic:ObjectProperty ;
    rdfs:label "reifier"@x-gmeow-english ;
    skos:definition "The named reifier IRI for the statement — the subject of `rdf:reifies` in the RDF 1.2 form and the `owl:Axiom` node in the OWL downcast. OPTIONAL: when omitted, the compiler mints a deterministic, content-addressed reifier IRI from the quoted triple, so the same statement always yields the same reifier (no spurious drift)."@x-gmeow-english .

gmeow:qSubject a logic:ObjectProperty ;
    rdfs:label "quoted subject"@x-gmeow-english ;
    skos:definition "The subject of the quoted base triple — the `s` in `<<( s p o )>>` and the `owl:annotatedSource` in the OWL downcast."@x-gmeow-english .

gmeow:qPredicate a logic:ObjectProperty ;
    rdfs:label "quoted predicate"@x-gmeow-english ;
    skos:definition "The predicate of the quoted base triple — the `p` in `<<( s p o )>>` and the `owl:annotatedProperty` in the OWL downcast."@x-gmeow-english .

gmeow:qObject a logic:ObjectProperty ;
    rdfs:label "quoted object (IRI)"@x-gmeow-english ;
    skos:definition "The object of the quoted base triple when it is an IRI / value individual — the `o` in `<<( s p o )>>` and the `owl:annotatedTarget` in the OWL downcast. Mutually exclusive with gmeow:qObjectLiteral."@x-gmeow-english .

gmeow:qObjectLiteral a logic:DatatypeProperty ;
    rdfs:label "quoted object (literal)"@x-gmeow-english ;
    skos:definition "The object of the quoted base triple when it is a literal (a date, a string, a number). Mutually exclusive with gmeow:qObject."@x-gmeow-english .

# --------------------------------------------------------------------------- #
# The annotations hung off the reifier
# --------------------------------------------------------------------------- #

gmeow:annotation a logic:ObjectProperty ;
    rdfs:label "annotation"@x-gmeow-english ;
    skos:definition "Links a statement cell to one metadata annotation node (annProperty + annValue). Each annotation becomes one triple on the reifier in the RDF 1.2 form and one annotation on the owl:Axiom in the OWL downcast. A cell carries several."@x-gmeow-english .

gmeow:annProperty a logic:ObjectProperty ;
    rdfs:label "annotation property"@x-gmeow-english ;
    skos:definition "The metadata property of one annotation — a real GMEOW statement-level annotation property (gmeow:confidence, gmeow:validFrom, gmeow:assertedAt, gmeow:mappedFrom, …). Must be an owl:AnnotationProperty in the ontology so the generated OWL downcast stays OWL 2 DL-clean."@x-gmeow-english .

gmeow:annValue a rdf:Property ;
    rdfs:label "annotation value"@x-gmeow-english ;
    skos:definition "The value of one annotation — an IRI/value individual or a literal (0.95, a date, an agent IRI). Authored as a single field for ergonomics; the compiler emits it verbatim into both forms. (A bare rdf:Property in this spec layer, never reasoned; the generated OWL form attaches it under the real owl:AnnotationProperty named by gmeow:annProperty.)"@x-gmeow-english .

# Backfilled annotations for annotation-completeness gate
gmeow:StatementMetadata rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> .

gmeow:annProperty rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> .

gmeow:annValue rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> .

gmeow:annotation rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> .

gmeow:qObject rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> .

gmeow:qObjectLiteral rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> .

gmeow:qPredicate rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> .

gmeow:qSubject rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> .

gmeow:reifier rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> .

gmeow:statement-dsl skos:definition "The GMEOW statement DSL vocabulary — terms used to author RDF 1.2 / RDF* statement-level metadata (provenance, confidence, temporal scope, standpoint) that compile to both native RDF 1.2 and OWL axiom-annotation forms (Principles 2–3)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> .

# --------------------------------------------------------------------------- #
# Migrated procedural + declarative constraints: the closed-world
# gmeow:StatementMetadataShape / gmeow:StatementAnnotationShape /
# gmeow:StatementDslVocabularyTermShape shapes from
# shapes/statement-dsl-shapes.ttl, re-expressed as canonical logic: records
# (Principle 17). The authored shapes stay (additive); the sweep verifies.
# --------------------------------------------------------------------------- #

gmeow:StatementMetadataSubjectRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "StatementMetadata subject requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:StatementMetadata must carry exactly one gmeow:qSubject."@x-gmeow-english ;
    logic:onClass gmeow:StatementMetadata ;
    logic:anyOf gmeow:qSubject ;
    logic:formalizes gmeow:StatementMetadata ;
    logic:message "StatementMetadata must have exactly one gmeow:qSubject (IRI)"@x-gmeow-english .

gmeow:StatementMetadataPredicateRequiredConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "StatementMetadata predicate requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world requiredness constraint: a gmeow:StatementMetadata must carry exactly one gmeow:qPredicate."@x-gmeow-english ;
    logic:onClass gmeow:StatementMetadata ;
    logic:anyOf gmeow:qPredicate ;
    logic:formalizes gmeow:StatementMetadata ;
    logic:message "StatementMetadata must have exactly one gmeow:qPredicate (IRI)"@x-gmeow-english .

gmeow:StatementMetadataObjectChoiceConstraint
    a logic:ChoiceGroupConstraint ;
    rdfs:label "StatementMetadata object choice constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:StatementMetadata carries exactly one of gmeow:qObject (IRI) or gmeow:qObjectLiteral."@x-gmeow-english ;
    logic:onClass gmeow:StatementMetadata ;
    logic:choicePredicate gmeow:qObject , gmeow:qObjectLiteral ;
    logic:choiceMode "exactly-one" ;
    logic:formalizes gmeow:StatementMetadata ;
    logic:message "StatementMetadata needs exactly one of qObject (IRI) or qObjectLiteral"@x-gmeow-english .

# gmeow:StatementAnnotationShape targets every subject of gmeow:annProperty (not
# a class), so this mirrors the kernel gmeow:UseForConsumerTargetConstraint
# subjectsOf idiom: the guard is the property assertion itself, not an rdf:type
# check.
gmeow:StatementAnnotationValueRequiredConstraint
    a logic:Constraint ;
    rdfs:label "Statement annotation value requiredness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every subject of gmeow:annProperty carries exactly one gmeow:annValue."@x-gmeow-english ;
    logic:formalizes gmeow:StatementAnnotationShape ;
    logic:message "Annotation must have exactly one gmeow:annValue (IRI or literal)"@x-gmeow-english ;
    logic:integrity logic:savForall .
logic:savForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] ;
    logic:forall logic:savImpl .
logic:savImpl a logic:Formula ; logic:antecedent logic:savGuard ; logic:consequent logic:savExists .
logic:savGuard a logic:Formula ; logic:relation gmeow:annProperty ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .
logic:savExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "v" ] ;
    logic:exists logic:savAtom .
logic:savAtom a logic:Formula ; logic:relation gmeow:annValue ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .

# gmeow:StatementDslVocabularyTermShape — the repo-wide annotation-completeness
# meta-gate, scoped to the statement-dsl namespace, mirrors
# logic:GmeowClassCompletenessConstraint / GmeowPropertyCompletenessConstraint's
# logic:sparqlTarget idiom for a raw sh:SPARQLTarget focus set.
gmeow:StatementDslVocabularyTermCompletenessConstraint
    a logic:Constraint ;
    rdfs:label "Statement DSL vocabulary term completeness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every term declared in the statement DSL vocabulary namespace (a class, object/datatype/annotation property, ontology, or datatype) carries at least one rdfs:label, one skos:definition, and rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl>."@x-gmeow-english ;
    logic:formalizes gmeow:StatementDslVocabularyTermShape ;
    logic:message "Every statement DSL vocabulary term must carry rdfs:label, skos:definition, and rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl>."@x-gmeow-english ;
    logic:integrity logic:sdvForall .
logic:sdvForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall logic:sdvImpl .
logic:sdvImpl a logic:Formula ; logic:antecedent logic:sdvTarget ; logic:consequent logic:sdvAnd .
logic:sdvTarget a logic:Formula ; logic:relation logic:sparqlTarget ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termLiteral """SELECT ?this WHERE {
    ?this a ?t .
    FILTER(?t IN (
        <https://blackcatinformatics.ca/logic/Class>,
        <https://blackcatinformatics.ca/logic/ObjectProperty>,
        <https://blackcatinformatics.ca/logic/DatatypeProperty>,
        <https://blackcatinformatics.ca/logic/AnnotationProperty>,
        <https://blackcatinformatics.ca/logic/Ontology>,
        <http://www.w3.org/2000/01/rdf-schema#Datatype>
    ))
    FILTER(STRSTARTS(STR(?this), "https://blackcatinformatics.ca/gmeow/"))
}""" ] .
logic:sdvAnd a logic:Formula ; logic:and logic:sdvLabel , logic:sdvDef , logic:sdvDefBy .
logic:sdvLabel a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "l" ] ; logic:exists logic:sdvLabelAtom .
logic:sdvLabelAtom a logic:Formula ; logic:relation rdfs:label ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "l" ] .
logic:sdvDef a logic:Formula ; logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "d" ] ; logic:exists logic:sdvDefAtom .
logic:sdvDefAtom a logic:Formula ; logic:relation skos:definition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "d" ] .
logic:sdvDefBy a logic:Formula ; logic:relation rdfs:isDefinedBy ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri <https://blackcatinformatics.ca/gmeow/statement-dsl> ] .

# --------------------------------------------------------------------------- #
# Graph box role coverage (canonical explicit annotations).
# --------------------------------------------------------------------------- #

gmeow:StatementMetadata gmeow:graphBoxRole gmeow:boxCBox, gmeow:boxTBox .
gmeow:annProperty gmeow:graphBoxRole gmeow:boxRBox .
gmeow:annValue gmeow:graphBoxRole gmeow:boxRBox, gmeow:boxABox .
gmeow:annotation gmeow:graphBoxRole gmeow:boxRBox .
gmeow:qObject gmeow:graphBoxRole gmeow:boxRBox .
gmeow:qObjectLiteral gmeow:graphBoxRole gmeow:boxRBox .
gmeow:qPredicate gmeow:graphBoxRole gmeow:boxRBox .
gmeow:qSubject gmeow:graphBoxRole gmeow:boxRBox .
gmeow:reifier gmeow:graphBoxRole gmeow:boxCBox, gmeow:boxRBox .
gmeow:statement-dsl gmeow:graphBoxRole gmeow:boxCBox, gmeow:boxConfigBox, gmeow:boxTBox .

# Canonical property characteristics (Principle 17).

gmeow:statementDslReifierFunctionality
    a logic:NamedIndividual, logic:PropertyCharacteristicAssertion ;
    rdfs:label "reifier is functional"@x-gmeow-english ;
    skos:definition "The canonical property-characteristic assertion for gmeow:reifier: each subject has at most one value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    logic:characterizes gmeow:reifier ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:reifier ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:statementDslQSubjectFunctionality
    a logic:NamedIndividual, logic:PropertyCharacteristicAssertion ;
    rdfs:label "qSubject is functional"@x-gmeow-english ;
    skos:definition "The canonical property-characteristic assertion for gmeow:qSubject: each subject has at most one value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    logic:characterizes gmeow:qSubject ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:qSubject ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:statementDslQPredicateFunctionality
    a logic:NamedIndividual, logic:PropertyCharacteristicAssertion ;
    rdfs:label "qPredicate is functional"@x-gmeow-english ;
    skos:definition "The canonical property-characteristic assertion for gmeow:qPredicate: each subject has at most one value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    logic:characterizes gmeow:qPredicate ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:qPredicate ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:statementDslQObjectFunctionality
    a logic:NamedIndividual, logic:PropertyCharacteristicAssertion ;
    rdfs:label "qObject is functional"@x-gmeow-english ;
    skos:definition "The canonical property-characteristic assertion for gmeow:qObject: each subject has at most one value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    logic:characterizes gmeow:qObject ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:qObject ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:statementDslQObjectLiteralFunctionality
    a logic:NamedIndividual, logic:PropertyCharacteristicAssertion ;
    rdfs:label "qObjectLiteral is functional"@x-gmeow-english ;
    skos:definition "The canonical property-characteristic assertion for gmeow:qObjectLiteral: each subject has at most one value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    logic:characterizes gmeow:qObjectLiteral ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:qObjectLiteral ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:statementDslAnnPropertyFunctionality
    a logic:NamedIndividual, logic:PropertyCharacteristicAssertion ;
    rdfs:label "annProperty is functional"@x-gmeow-english ;
    skos:definition "The canonical property-characteristic assertion for gmeow:annProperty: each subject has at most one value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    logic:characterizes gmeow:annProperty ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:annProperty ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:statementDslAnnValueFunctionality
    a logic:NamedIndividual, logic:PropertyCharacteristicAssertion ;
    rdfs:label "annValue is functional"@x-gmeow-english ;
    skos:definition "The canonical property-characteristic assertion for gmeow:annValue: each subject has at most one value."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/statement-dsl> ;
    logic:characterizes gmeow:annValue ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:annValue ;
    gmeow:graphBoxRole gmeow:boxABox .
