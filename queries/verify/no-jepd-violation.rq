# ROBOT verify QC (#67) — JEPD integrity of Allen interval relations.
# No TimeInterval may stand in two different Allen relations to the same
# other interval.  The 13 relations are listed explicitly because
# owl:AllDisjointProperties was removed for OWL 2 DL safety (transitive
# properties cannot appear in DisjointObjectProperties).  Any row is a FAILURE.

PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>

SELECT ?interval ?other ?rel1 ?rel2 WHERE {
    ?interval a gmeow:TimeInterval .
    ?other a gmeow:TimeInterval .
    VALUES ?rel1 {
        gmeow:intervalBefore gmeow:intervalAfter gmeow:intervalMeets
        gmeow:intervalMetBy gmeow:intervalOverlaps gmeow:intervalOverlappedBy
        gmeow:intervalStarts gmeow:intervalStartedBy gmeow:intervalDuring
        gmeow:intervalContains gmeow:intervalFinishes gmeow:intervalFinishedBy
        gmeow:intervalCoincidesWith
    }
    VALUES ?rel2 {
        gmeow:intervalBefore gmeow:intervalAfter gmeow:intervalMeets
        gmeow:intervalMetBy gmeow:intervalOverlaps gmeow:intervalOverlappedBy
        gmeow:intervalStarts gmeow:intervalStartedBy gmeow:intervalDuring
        gmeow:intervalContains gmeow:intervalFinishes gmeow:intervalFinishedBy
        gmeow:intervalCoincidesWith
    }
    FILTER(STR(?rel1) < STR(?rel2))
    ?interval ?rel1 ?other .
    ?interval ?rel2 ?other .
}
