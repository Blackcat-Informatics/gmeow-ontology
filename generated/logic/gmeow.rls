<https://blackcatinformatics.ca/logic/precondition>(<https://blackcatinformatics.ca/logic/wfConstructModel>, <https://blackcatinformatics.ca/logic/wfWorldSeeded>, "default").
<https://blackcatinformatics.ca/logic/capability>(<https://blackcatinformatics.ca/logic/wfMaterializeEdb>, <https://blackcatinformatics.ca/logic/wfReductEngineCapability>, "default").
<https://blackcatinformatics.ca/logic/precondition>(<https://blackcatinformatics.ca/logic/wfMaterializeEdb>, <https://blackcatinformatics.ca/logic/wfWorldSeeded>, "default").
<https://blackcatinformatics.ca/logic/leftOperand>(<https://blackcatinformatics.ca/logic/wfPhaseSequence>, <https://blackcatinformatics.ca/logic/wfMaterializeEdb>, "default").
<https://blackcatinformatics.ca/logic/rightOperand>(<https://blackcatinformatics.ca/logic/wfPhaseSequence>, <https://blackcatinformatics.ca/logic/wfResolveThenBuild>, "default").
<https://blackcatinformatics.ca/logic/capability>(<https://blackcatinformatics.ca/logic/wfResolveFixpoint>, <https://blackcatinformatics.ca/logic/wfReductEngineCapability>, "default").
<https://blackcatinformatics.ca/logic/precondition>(<https://blackcatinformatics.ca/logic/wfResolveFixpoint>, <https://blackcatinformatics.ca/logic/wfWorldSeeded>, "default").
