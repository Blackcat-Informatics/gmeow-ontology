    gmeow:producesFormat "json-ld" .

# ── The single serialization exit (the gts narrow waist) ──

gmeow:stage-gts-sink
    a gmeow:PipelineStage ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    rdfs:label "gts sink"@x-gmeow-english ;
    skos:definition "The terminal gts ARCHIVE writer (the ONE canonical exit / narrow waist): serialize the assembled carrier to generated/dist/gmeow.gts. GTS is exit-only — produced here and nowhere else; every fold-reading export leaf reads the carrier dataset off the gmeow:stage-snapshot bundle, never these bytes. The carrier is taken off the snapshot bundle (no re-assembly — the razor: transform transport→form at most once), and the by-reference blob archives are folded in alongside it: the fresh JSON-Schema/OpenAPI (gmeow:stage-export-json-schema), the compiled axiom surface (gmeow:stage-compile-logic), the native reasoning reports (gmeow:stage-reason), and the SHACL diagnostics SARIF/findings (gmeow:stage-validate)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:precondition gmeow:stageInputsAvailable ;
    logic:capability gmeow:stageExecutorCapability ;
    gmeow:stageImpl "gts_sink" ;
    gmeow:hasCapability gmeow:sinkCapability ;
    gmeow:dataflowConsumes
        gmeow:stage-snapshot ,
        gmeow:stage-export-json-schema ,
        gmeow:stage-compile-logic ,
        gmeow:stage-reason ,
        gmeow:stage-statements ,
        gmeow:stage-validate .
