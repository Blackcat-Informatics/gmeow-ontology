@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix ical:   <http://www.w3.org/2002/12/cal/icaltzd#> .
@prefix wd:     <http://www.wikidata.org/entity/> .
@prefix wdt:    <http://www.wikidata.org/prop/direct/> .

# Term equivalences for the calendar and scheduling slice (calendar and scheduling design).
# Compiled to mappings/gmeow-calendar.sssom.tsv by `gmeow compile-mappings`.

# --------------------------------------------------------------------------- #
# Mapping set metadata
# --------------------------------------------------------------------------- #

gmeow:mapsetCalendar a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/calendar" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Calendar and scheduling alignments (calendar and scheduling design) — gmeow:Calendar, gmeow:EventSchedule, gmeow:EventInvitation, gmeow:Availability, gmeow:Reminder, gmeow:Task, gmeow:TimeZone and their value vocabularies, aligned to iCalendar (RFC 5545/5546), schema.org Schedule/EventSeries, and Wikidata by reference.
        VALUE VOCABULARIES: InvitationStatus, RsvpStatus, AvailabilityStatus, ReminderAction, TaskStatus, ExceptionType are gufo:QualityValue individuals, aligned to external classes/enums with skos:closeMatch (Principle 9 — no overtyping).
        SCHEDULE ≠ OCCURRENCE: an EventSchedule generates Event occurrences; it is not the occurrence itself.""" .

# --------------------------------------------------------------------------- #
# Core classes
# --------------------------------------------------------------------------- #

gmeow:eqCalendar001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Calendar ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject ical:Vcalendar ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "iCalendar VCALENDAR is a projection target, not a peer model" ;
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" .

gmeow:eqCalendar002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:EventSchedule ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject schema:Schedule ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "schema.org Schedule — a repeating schedule with exceptions" ;
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" .

gmeow:eqCalendar003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:EventSchedule ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject ical:Vevent ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "iCalendar VEVENT is the projection of a generated occurrence, not the schedule itself" ;
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" .

gmeow:eqCalendar004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Task ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ical:Vtodo ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "iCalendar VTODO — a task is an event subtype with due date and status" ;
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" .

gmeow:eqCalendar005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Reminder ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ical:Valarm ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "iCalendar VALARM — trigger + action" ;
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" .

gmeow:eqCalendar006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:TimeZone ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ical:Vtimezone ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "iCalendar VTIMEZONE — IANA tzid" ;
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" .

gmeow:eqCalendar007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Availability ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ical:Vfreebusy ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "iCalendar VFREEBUSY — free/busy time slots" ;
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" .

gmeow:eqCalendar008 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:EventInvitation ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject schema:RsvpAction ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "schema.org RsvpAction — the invitation/RSVP social act" ;
    gmeow:sssomFile "gmeow-calendar.sssom.tsv" .

