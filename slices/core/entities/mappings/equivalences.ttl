gmeow:eqWikidata001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Person ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q5 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:objectLabel "human" ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqWikidata002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Organization ;
