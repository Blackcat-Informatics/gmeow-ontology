# Source reference blocks and apparatus.

msgctxt "https://blackcatinformatics.ca/gmeow/TableCell|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Documentary Table Cell"
msgstr "文档表格单元格"

msgctxt "https://blackcatinformatics.ca/gmeow/TableCell|http://www.w3.org/2004/02/skos/core#definition"
msgid "A source cell located by one table, row and column under that table's explicit index origin. It is an InformationObject, not a scalar MatrixEntry."
msgstr "在表格明确索引起点下由一个表格、行和列定位的来源单元格。它是 InformationObject，而非标量 MatrixEntry。"

msgctxt "https://blackcatinformatics.ca/gmeow/TableCell|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/TableCell|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/TableCell|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/TableCell|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record a gmeow:TableCell ."
msgstr "保留此来源含义：ex:record a gmeow:TableCell ."

msgctxt "https://blackcatinformatics.ca/gmeow/FormalBlockKind|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Printed Formal Block Kind"
msgstr "印刷形式块种类"

msgctxt "https://blackcatinformatics.ca/gmeow/FormalBlockKind|http://www.w3.org/2004/02/skos/core#definition"
msgid "An open quality-value vocabulary for the source's printed exposition role. A theorem, proof or algorithm label records document apparatus, never successful verification."
msgstr "表示来源印刷论述角色的开放性质值词汇。定理、证明或算法标签记录的是文档论述装置，绝非核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/FormalBlockKind|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/FormalBlockKind|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/FormalBlockKind|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/FormalBlockKind|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record a gmeow:FormalBlockKind ."
msgstr "保留此来源含义：ex:record a gmeow:FormalBlockKind ."

msgctxt "https://blackcatinformatics.ca/gmeow/speaker|http://www.w3.org/2000/01/rdf-schema#label"
msgid "source speaker"
msgstr "来源说话者"

msgctxt "https://blackcatinformatics.ca/gmeow/speaker|http://www.w3.org/2004/02/skos/core#definition"
msgid "The Entity explicitly identified as speaking this source block. A fictional character may be the speaker without becoming a Person."
msgstr "明确标识为说出此来源块内容的 Entity。虚构角色可以是说话者，而不成为 Person。"

msgctxt "https://blackcatinformatics.ca/gmeow/speaker|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/speaker|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/speaker|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/speaker|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record gmeow:speaker ex:target ."
msgstr "保留此来源含义：ex:record gmeow:speaker ex:target ."

msgctxt "https://blackcatinformatics.ca/gmeow/programmingLanguageAsRecorded|http://www.w3.org/2000/01/rdf-schema#label"
msgid "programming language as recorded"
msgstr "原样记录的编程语言"

msgctxt "https://blackcatinformatics.ca/gmeow/programmingLanguageAsRecorded|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source's exact programming-language name or code for a listing. It is an opaque string, not the software slice's Project-to-Language relation."
msgstr "来源为代码清单给出的确切编程语言名称或代码。它是不透明字符串，而非 software 切片中的 Project 到 Language 关系。"

msgctxt "https://blackcatinformatics.ca/gmeow/programmingLanguageAsRecorded|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/programmingLanguageAsRecorded|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/programmingLanguageAsRecorded|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/programmingLanguageAsRecorded|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record gmeow:programmingLanguageAsRecorded \"source wording\" ."
msgstr "保留此来源含义：ex:record gmeow:programmingLanguageAsRecorded \"source wording\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/equationSource|http://www.w3.org/2000/01/rdf-schema#label"
msgid "equation source text"
msgstr "公式来源文本"

msgctxt "https://blackcatinformatics.ca/gmeow/equationSource|http://www.w3.org/2004/02/skos/core#definition"
msgid "The exact source spelling of a mathematical display, before parsing, normalization or notation conversion. A matching retained language surface preserves that spelling; the string itself is not a computable expression AST."
msgstr "数学显示内容在解析、规范化或记法转换前的确切来源拼写。对应的保留语言表面形式保存此拼写；字符串本身不是可计算表达式 AST。"

msgctxt "https://blackcatinformatics.ca/gmeow/equationSource|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/equationSource|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/equationSource|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/equationSource|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record gmeow:equationSource \"source wording\" ."
msgstr "保留此来源含义：ex:record gmeow:equationSource \"source wording\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/sourceNotation|http://www.w3.org/2000/01/rdf-schema#label"
msgid "notation as recorded"
msgstr "原样记录的记法"

msgctxt "https://blackcatinformatics.ca/gmeow/sourceNotation|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source's exact notation name or code. The spelling alone neither identifies a MathematicalNotation convention nor proves a rendering preserves meaning."
msgstr "来源给出的确切记法名称或代码。仅凭拼写既不能标识 MathematicalNotation 约定，也不能证明呈现保持意义。"

msgctxt "https://blackcatinformatics.ca/gmeow/sourceNotation|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/sourceNotation|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/sourceNotation|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/sourceNotation|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record gmeow:sourceNotation \"source wording\" ."
msgstr "保留此来源含义：ex:record gmeow:sourceNotation \"source wording\" ."

msgctxt "https://blackcatinformatics.ca/gmeow/cell|http://www.w3.org/2000/01/rdf-schema#label"
msgid "source table cell"
msgstr "来源表格单元格"

msgctxt "https://blackcatinformatics.ca/gmeow/cell|http://www.w3.org/2004/02/skos/core#definition"
msgid "A retained documentary cell of this table block. Row and column identities are scoped by this exact table, not shared globally across tables."
msgstr "此表格块中保留的文档单元格。行列身份限定于此确切表格，而不在不同表格间全局共享。"

msgctxt "https://blackcatinformatics.ca/gmeow/cell|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/cell|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/cell|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/cell|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record gmeow:cell ex:target ."
msgstr "保留此来源含义：ex:record gmeow:cell ex:target ."

msgctxt "https://blackcatinformatics.ca/gmeow/cellOf|http://www.w3.org/2000/01/rdf-schema#label"
msgid "cell of source table"
msgstr "单元格所属来源表格"

msgctxt "https://blackcatinformatics.ca/gmeow/cellOf|http://www.w3.org/2004/02/skos/core#definition"
msgid "The exact table block containing this documentary cell. It is the inverse of cell and supplies the coordinate scope."
msgstr "包含此文档单元格的确切表格块。它是 cell 的逆关系，并提供坐标范围。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellOf|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellOf|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellOf|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellOf|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record gmeow:cellOf ex:target ."
msgstr "保留此来源含义：ex:record gmeow:cellOf ex:target ."

msgctxt "https://blackcatinformatics.ca/gmeow/cellRow|http://www.w3.org/2000/01/rdf-schema#label"
msgid "source cell row"
msgstr "来源单元格行"

msgctxt "https://blackcatinformatics.ca/gmeow/cellRow|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source row index of a documentary cell under its table's explicit tableIndexOrigin. It is not a matrix coordinate or an implicit zero-based conversion."
msgstr "文档单元格在其表格明确 tableIndexOrigin 下的来源行索引。它不是矩阵坐标，也不是隐式零起始转换。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellRow|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellRow|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellRow|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellRow|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record gmeow:cellRow 0 ."
msgstr "保留此来源含义：ex:record gmeow:cellRow 0 ."

msgctxt "https://blackcatinformatics.ca/gmeow/cellColumn|http://www.w3.org/2000/01/rdf-schema#label"
msgid "source cell column"
msgstr "来源单元格列"

msgctxt "https://blackcatinformatics.ca/gmeow/cellColumn|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source column index of a documentary cell under its table's explicit tableIndexOrigin. Identical indices in distinct tables do not identify the same cell."
msgstr "文档单元格在其表格明确 tableIndexOrigin 下的来源列索引。不同表格中的相同索引不标识同一单元格。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellColumn|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellColumn|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellColumn|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellColumn|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record gmeow:cellColumn 0 ."
msgstr "保留此来源含义：ex:record gmeow:cellColumn 0 ."

msgctxt "https://blackcatinformatics.ca/gmeow/tableIndexOrigin|http://www.w3.org/2000/01/rdf-schema#label"
msgid "source table index origin"
msgstr "来源表格索引起点"

msgctxt "https://blackcatinformatics.ca/gmeow/tableIndexOrigin|http://www.w3.org/2004/02/skos/core#definition"
msgid "The explicit integer origin shared by this source table's row and column indices. Missing origin stays missing; consumers must not silently assume zero or one."
msgstr "此来源表格行列索引共同采用的明确整数起点。缺失起点保持缺失；使用方不得悄然假定为零或一。"

msgctxt "https://blackcatinformatics.ca/gmeow/tableIndexOrigin|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/tableIndexOrigin|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/tableIndexOrigin|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/tableIndexOrigin|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record gmeow:tableIndexOrigin 0 ."
msgstr "保留此来源含义：ex:record gmeow:tableIndexOrigin 0 ."

msgctxt "https://blackcatinformatics.ca/gmeow/cellText|http://www.w3.org/2000/01/rdf-schema#label"
msgid "source cell text"
msgstr "来源单元格文本"

msgctxt "https://blackcatinformatics.ca/gmeow/cellText|http://www.w3.org/2004/02/skos/core#definition"
msgid "The original textual content of a documentary cell, including an explicitly empty string. Preserve language and direction when supplied; absence is not an invented empty value."
msgstr "文档单元格的原始文本内容，包括明确的空字符串。保留已提供的语言和书写方向；缺失并非虚构的空值。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellText|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellText|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellText|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Preserve source identity and exact-statement attribution; keep unresolved or missing information explicit without invented defaults."
msgstr "保留来源身份与确切陈述归属；明确未解析或缺失的信息，而不虚构默认值。"

msgctxt "https://blackcatinformatics.ca/gmeow/cellText|http://www.w3.org/2004/02/skos/core#example"
msgid "Retain this source meaning: ex:record gmeow:cellText \"source wording\"@en ."
msgstr "保留此来源含义：ex:record gmeow:cellText \"source wording\"@en ."

msgctxt "https://blackcatinformatics.ca/gmeow/altText|http://www.w3.org/2000/01/rdf-schema#label"
msgid "source alternative text"
msgstr "来源替代文本"

msgctxt "https://blackcatinformatics.ca/gmeow/altText|http://www.w3.org/2004/02/skos/core#definition"
msgid "The source's alternative description for perceiving a block's content. It is distinct from a displayed caption and does not type a figure block as a media file."
msgstr "来源为感知块内容提供的替代描述。它区别于显示的说明文字，也不将插图块标记为媒体文件。"

msgctxt "https://blackcatinformatics.ca/gmeow/altText|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use to retain this explicit part of the source structure or apparatus with its original evidence."
msgstr "用于保留来源结构或论述装置的此明确部分及其原始证据。"

msgctxt "https://blackcatinformatics.ca/gmeow/altText|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inferring execution, identity, formal truth or successful verification from document layout or source wording alone."
msgstr "避免仅从文档版式或来源措辞推断执行、身份、形式真理或核验成功。"

