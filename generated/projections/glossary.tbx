      <termEntry id="c-d3b43e3658663e09">
        <langSet xml:lang="en">
          <tig>
            <term>The version-3 alias binding for gmeow:modalForceActual: `act`, retained unchanged from version 2.</term>
          </tig>
        </langSet>
