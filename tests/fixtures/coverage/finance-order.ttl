@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:      <https://blackcatinformatics.ca/gmeow/examples/finance/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# A well-formed purchase order from Alice to Bob.
ex:alice a gmeow:Agent .
ex:bob   a gmeow:Agent .

ex:order001
    a gmeow:Order ;
    gmeow:orderAmount ex:orderAmount ;
    gmeow:orderBuyer ex:alice ;
    gmeow:orderSeller ex:bob ;
    gmeow:orderStatus gmeow:orderStatusConfirmed .

ex:orderAmount
    a gmeow:MonetaryAmount ;
    gmeow:monetaryValue "250.00"^^xsd:decimal ;
    gmeow:currency gmeow:referenceFrameUSD .
