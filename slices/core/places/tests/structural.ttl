ASK { gmeow:virtualLocationType a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:virtualLocationType MUST NOT be owl:FunctionalProperty -- a virtual location may have multiple co-equal type claims (Principle 9). Mirrors test_virtual_location_type_is_value_not_subclass (non-functional part)." .

# --- 68. VirtualLocationType seed individuals exist (MUST) --------------------
ex:saVirtualLocationTypeSeeds a gmeow:StructuralAssertion ;
