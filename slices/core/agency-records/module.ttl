                        logic:consequent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "w2Frame" ] , [ logic:termIndex 1 ; logic:termIri gmeow:TemporalFrame ] ] ] ] ,
