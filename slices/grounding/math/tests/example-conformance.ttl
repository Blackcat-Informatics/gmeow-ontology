#
# Declarative example-conformance fixtures for the mathematics slice — the test-DSL
# twin of the SHACL shapes in slices/grounding/math/shapes.ttl ("this instance
# must validate, that counter-example must be rejected"). The harness
# (crates/slicetest run_conformance_cell) validates mathematics/module.ttl + the one
# bound gmeow:exampleFile against mathematics/shapes.ttl and compares finding codes.
#
# Each counter-example isolates ONE violation, so the (fixture, code) pair pins the
# specific constraint. The conforming fixtures live under tests/conformance-fixtures/
# and the counter-examples under tests/counter-examples/, so the global
# `make validate` gate never loads the intentional violations as data.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/math/tests/> .

# === Rule 1: a number declares its number system ============================ #

ex:ecNumberSituated a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/number-situated.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:RationalNumber situated in math:rationalNumbers with math:isExact true satisfies math:NumberSituatedShape and validates with no findings." .

ex:ecNumberMissingSystem a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/number-missing-system.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example omits math:inNumberSystem (sh:minCount 1 on math:NumberSituatedShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:UnsituatedNumber)." .

# === Rule 2: an approximation names what it approximates and its error ====== #

ex:ecApproximationFramed a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/approximation-framed.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:ApproximateValue naming its exact math:Number and its math:approximationError satisfies math:ApproximateValueShape and validates with no findings." .

ex:ecApproximationMissingError a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/approximation-missing-error.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example omits math:approximationError (sh:minCount 1 on math:ApproximateValueShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:ExactApproximateConflation)." .

# === Rule 3: a named constant is an exact individual, not a decimal ========= #

ex:ecConstantExact a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/constant-exact.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:MathematicalConstant that is exact and carries no raw math:quantityValue satisfies math:MathematicalConstantShape and validates with no findings." .

ex:ecConstantAsDecimal a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/constant-as-decimal.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MaxCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example carries a raw math:quantityValue on a math:MathematicalConstant (sh:maxCount 0 on math:MathematicalConstantShape), so validation MUST emit shacl.MaxCountConstraintComponent and NO other finding (math:ConstantAsDecimalLiteral)." .

# === Rule 4: an intensional condition denotes a logic: formula ============== #

ex:ecIntensionalSet a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/intensional-set.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:SetBuilderExpression whose math:memberCondition is a resource denoting a logic: formula satisfies math:IntensionalSetShape and validates with no findings." .

ex:ecIntensionalConditionString a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/intensional-condition-string.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.NodeKindConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example gives math:memberCondition an opaque string literal (sh:nodeKind sh:BlankNodeOrIRI on math:IntensionalSetShape), so validation MUST emit shacl.NodeKindConstraintComponent and NO other finding (math:StringOnlyMemberCondition)." .

# === Rule 5: a complement names its ambient set ============================= #

ex:ecComplementQualified a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/complement-qualified.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:Complement naming its ambient set through math:complementWithin satisfies math:ComplementShape and validates with no findings." .

ex:ecComplementUnqualified a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/complement-unqualified.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example omits math:complementWithin on a math:Complement (sh:minCount 1 on math:ComplementShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:UnqualifiedComplement)." .

# === Rule 6: a set is extensional or intensional, not both ================== #

ex:ecExtensionalSet a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/extensional-set.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:FiniteSet given extensionally by math:hasElement, with no math:memberCondition, satisfies math:SetExtentShape and validates with no findings." .

ex:ecSetBothExtents a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/set-both-extents.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.SPARQLConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example carries both math:hasElement and math:memberCondition on one set (the SPARQL constraint of math:SetExtentShape), so validation MUST emit shacl.SPARQLConstraintComponent and NO other finding (math:AmbiguousSetExtent)." .

# === Rule 7: a function declares its domain and codomain =================== #

ex:ecFunctionFramed a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/function-framed.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:Function declaring both math:domain and math:codomain satisfies math:FunctionFramingShape and validates with no findings." .

ex:ecFunctionMissingCodomain a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/function-missing-codomain.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example omits math:codomain on a math:Function (sh:minCount 1 on math:FunctionFramingShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:UnframedFunction)." .

# === Rule 8: a measure declares its space and total mass ==================== #

ex:ecMeasureComplete a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/measure-complete.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:Measure declaring math:measureOn (its measurable space) and a finite math:totalMass satisfies math:MeasureShape and validates with no findings." .

ex:ecMeasureMissingMass a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/measure-missing-mass.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example omits math:totalMass on a math:Measure (sh:minCount 1 on math:MeasureShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:IncompleteMeasure)." .

# === Rule 9: a probability measure has total mass one ======================= #

ex:ecProbabilityMassOne a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/probability-mass-one.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:ProbabilityMeasure of math:totalMass 1 on its space satisfies math:ProbabilityMeasureShape and math:MeasureShape and validates with no findings." .

ex:ecProbabilityMassNotOne a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/probability-mass-not-one.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.HasValueConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example gives a math:ProbabilityMeasure math:totalMass 2 (sh:hasValue 1 on math:ProbabilityMeasureShape), so validation MUST emit shacl.HasValueConstraintComponent and NO other finding (math:ProbabilityMeasureMassViolation)." .

# === Rule 10: an integral names its integrand, domain, and measure ========= #

ex:ecIntegralFramed a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/integral-framed.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:Integral naming its math:integrand, math:integrationDomain, and math:withRespectTo satisfies math:IntegralShape and validates with no findings." .

ex:ecIntegralMissingMeasure a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/integral-missing-measure.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example omits math:withRespectTo on a math:Integral (sh:minCount 1 on math:IntegralShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:IncompleteIntegral)." .

# === Rule 11: every quantity carries a dimension =========================== #

ex:ecQuantityDimensioned a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/quantity-dimensioned.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:Quantity declaring one math:hasDimension satisfies math:QuantityDimensionShape and validates with no findings." .

ex:ecQuantityUndimensioned a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/quantity-undimensioned.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example carries no math:hasDimension on a math:Quantity (sh:minCount 1 on math:QuantityDimensionShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:UndimensionedQuantity)." .

# === Rule 12: a derived dimension declares its exponent structure ========== #

ex:ecDerivedDimensionStructured a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/conformance-fixtures/derived-dimension-structured.ttl" ;
    gmeow:expectedOutcome gmeow:conforms ;
    gmeow:conformanceRationale "A math:DerivedDimension declaring math:baseDimensionExponent cells that raise base dimensions to exact-rational powers satisfies math:DerivedDimensionShape and math:DimensionExponentShape and validates with no findings." .

ex:ecDerivedDimensionNoExponents a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/derived-dimension-no-exponents.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example declares no math:baseDimensionExponent on a math:DerivedDimension (sh:minCount 1 on math:DerivedDimensionShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:MalformedDimension)." .

# === Rule 13: an exponent cell raises a base dimension only ================= #

ex:ecDimensionNonBaseExponent a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/dimension-nonbase-exponent.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.ClassConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example points math:exponentOfDimension at a non-base dimension (sh:class math:BaseDimension on math:DimensionExponentShape), so validation MUST emit shacl.ClassConstraintComponent and NO other finding (math:MalformedDimension)." .

# === Rule 14: a dimensional expression combines at least two operands ======= #

ex:ecDimensionalExpressionSingleton a gmeow:ExampleConformance ;
    gmeow:exampleFile "tests/counter-examples/dimensional-expression-singleton.ttl" ;
    gmeow:expectedOutcome gmeow:violates ;
    gmeow:expectedViolationCode "shacl.MinCountConstraintComponent" ;
    gmeow:conformanceRationale "The counter-example carries only one math:homogeneousOperand on a math:DimensionalExpression (sh:minCount 2 on math:DimensionalExpressionShape), so validation MUST emit shacl.MinCountConstraintComponent and NO other finding (math:MalformedDimension)." .
