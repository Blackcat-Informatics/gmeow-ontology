@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:      <https://blackcatinformatics.ca/gmeow/examples/finance/> .

# Alice's Bitcoin wallet with two addresses.
ex:alice a gmeow:Agent .

ex:aliceBTCWallet
    a gmeow:CryptoWallet ;
    gmeow:accountHolder ex:alice ;
    gmeow:accountType gmeow:accountTypeWallet ;
    gmeow:walletAddress "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa" ;
    gmeow:walletAddress "bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh" ;
    gmeow:walletScheme gmeow:walletSchemeBTC .
