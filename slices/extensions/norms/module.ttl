# =========================================================================== #
# Canonical logic: grounding for the norms closed-world constraints. Each        #
# canonical constraint also formalizes the corresponding validation-shape IRI.  #
# Sugar records ground the value sets (logic:oneOf), the unique-language facet,    #
# and the bare-literal existence obligations.                                   #
# =========================================================================== #

gmeow:NormIssuerPresenceConstraint logic:formalizes gmeow:NormIssuerShape .
gmeow:NormDeonticModalityCardinalityConstraint logic:formalizes gmeow:NormIssuerShape .
gmeow:GraftPermissionModalityConstraint logic:formalizes gmeow:GraftPermissionModalityShape .
gmeow:ProhibitionModalityConstraint logic:formalizes gmeow:GraftProhibitionModalityShape .
gmeow:DutyModalityConstraint logic:formalizes gmeow:GraftDutyModalityShape .
gmeow:AssessmentMethodConstraint logic:formalizes gmeow:AssessmentShape .
gmeow:ConditionParameterMutexConstraint logic:formalizes gmeow:ConditionParameterShape .
gmeow:ScoreScaleOrderConstraint logic:formalizes gmeow:ScoreScaleShape .
gmeow:StyleGuideVoiceDigestConstraint logic:formalizes gmeow:StyleGuideShape .
gmeow:StyleGuideForConstraint logic:formalizes gmeow:StyleGuideShape .
gmeow:ScoreAnchorMeaningConstraint logic:formalizes gmeow:ScoreAnchorShape .
gmeow:ScoreAnchorRangeMinConstraint logic:formalizes gmeow:ScoreAnchorShape .
gmeow:ScoreAnchorRangeMaxConstraint logic:formalizes gmeow:ScoreAnchorShape .
gmeow:ScoreAnchorRangeOrderConstraint logic:formalizes gmeow:ScoreAnchorShape .
gmeow:ScoreAnchorRangeWithinScaleConstraint logic:formalizes gmeow:ScoreAnchorShape .
gmeow:ExemplarRedirectConstraint logic:formalizes gmeow:ExemplarShape .
gmeow:ExemplarEvidenceConstraint logic:formalizes gmeow:ExemplarShape .
gmeow:ExemplarPolarityConstraint logic:formalizes gmeow:ExemplarShape .
gmeow:ConditionGroupMemberCountConstraint logic:formalizes gmeow:ConditionGroupShape .
gmeow:ConditionGroupOperatorConstraint logic:formalizes gmeow:ConditionGroupShape .
gmeow:PrecedenceTenureScopeConstraint logic:formalizes gmeow:PrecedenceTenureShape .
gmeow:CriterionRewardPoleConstraint logic:formalizes gmeow:CriterionShape .
gmeow:CriterionPenaltyPoleConstraint logic:formalizes gmeow:CriterionShape .

# sh:in value sets → logic:oneOf antecedent (the derive projects a declarative sh:in).
gmeow:ConditionGroup logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:groupOperator ; logic:allValuesFrom [ logic:oneOf ( gmeow:operatorAll gmeow:operatorAny gmeow:operatorNone ) ] ] .
gmeow:Exemplar logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:exemplarPolarity ; logic:allValuesFrom [ logic:oneOf ( gmeow:polarityPositive gmeow:polarityNegative gmeow:polarityCautionary ) ] ] .

# sh:uniqueLang facet → declarative logic:UniqueLangConstraint sugar (localizable prose).
gmeow:ScoreAnchorMeaningUniqueLangConstraint
    a logic:UniqueLangConstraint ;
    rdfs:label "ScoreAnchor meaning unique-language constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/norms> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:ScoreAnchor carries at most one gmeow:anchorMeaning per language tag (no two language-tagged meanings share a tag)."@x-gmeow-english ;
    logic:onClass gmeow:ScoreAnchor ;
    logic:valuePath gmeow:anchorMeaning ;
    logic:formalizes gmeow:ScoreAnchorShape ;
    logic:message "A ScoreAnchor must carry at least one gmeow:anchorMeaning, at most one per language tag — an anchor without a meaning is just an interval (localizable prose)." .

# bare-literal existence obligations (no datatype antecedent → logic: existence record).
gmeow:ConditionExpressionTextConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "ConditionExpression text-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/norms> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:ConditionExpression carries a gmeow:expressionText."@x-gmeow-english ;
    logic:onClass gmeow:ConditionExpression ;
    logic:anyOf gmeow:expressionText ;
    logic:formalizes gmeow:ConditionExpressionShape ;
    logic:message "A ConditionExpression must carry exactly one gmeow:expressionText." .

gmeow:ConditionParameterNameConstraint
    a logic:DisjunctiveRequirednessConstraint ;
    rdfs:label "ConditionParameter name-present constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/norms> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:ConditionParameter carries a gmeow:parameterName."@x-gmeow-english ;
    logic:onClass gmeow:ConditionParameter ;
    logic:anyOf gmeow:parameterName ;
    logic:formalizes gmeow:ConditionParameterShape ;
    logic:message "A ConditionParameter must carry exactly one gmeow:parameterName." .

# ConditionExpression: gmeow:expressionLanguage is functional per expression (max 1).
gmeow:ConditionExpression logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:expressionLanguage ; logic:maxQualifiedCardinality 1 ; logic:onClass owl:Thing ] .

# ConditionExpression: gmeow:expressionText is a single mandatory literal (min 1, max 1);
# an rdfs:Literal data-range filler projects the declarative sh:minCount/maxCount without a
# category-error IRI node-kind on the literal-valued path.
gmeow:ConditionExpression logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:expressionText ; logic:minQualifiedCardinality 1 ; logic:onDataRange rdfs:Literal ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:expressionText ; logic:maxQualifiedCardinality 1 ; logic:onDataRange rdfs:Literal ] .
