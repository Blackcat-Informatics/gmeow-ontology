    logic:candidateProjectionBehavior logic:ExactPreservation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes gmeow:findingRootCause ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# ── Cluster: group findings sharing a root under the root-keyed cluster node ─────
# Fresh cluster-node minting is not expressible in the reified-Horn chase, so the
# cluster is IDENTIFIED BY its shared root finding: the root doubles as the
# gmeow:FindingCluster node, carrying gmeow:clusterRoot to itself, and every
# finding sharing that root links to it through gmeow:findingCluster.
logic:ruleFindingCluster
    a logic:Rule ,
        gmeow:DiagnosticMetaRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "link a finding to the cluster keyed by its root cause"@x-gmeow-english ;
    skos:definition "Emits gmeow:findingCluster(finding, root) whenever a finding gmeow:findingRootCause a root: the finding's membership in the cluster keyed by that shared root. Positive Horn (logic:PositiveHornProfile) over the root-cause output (stratified above it); monotone; materialized natively. The cluster node is the root finding itself (fresh-node minting is not expressible in the reified-Horn chase), so gmeow:findingCluster points at the shared root, which logic:ruleFindingClusterType types gmeow:FindingCluster and logic:ruleClusterRoot links to itself."@x-gmeow-english ;
    logic:provenance logic:ruleFindingCluster ;
    logic:formalizes gmeow:findingCluster ;
    logic:head [
        rdf:subject   "?finding" ;
        rdf:predicate gmeow:findingCluster ;
        rdf:object    "?root"
    ] ;
    logic:body [
        rdf:subject   "?finding" ;
        rdf:predicate gmeow:findingRootCause ;
        rdf:object    "?root"
    ] .

logic:ruleClusterRoot
    a logic:Rule ,
        gmeow:DiagnosticMetaRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "carry the shared root on the root-keyed cluster node"@x-gmeow-english ;
    skos:definition "Emits gmeow:clusterRoot(root, root) whenever some finding gmeow:findingRootCause a root: the root-keyed cluster node carries its shared root once. Positive Horn (logic:PositiveHornProfile); monotone; materialized natively. The self-edge follows from identifying the cluster with its root finding — the cluster node (the root) names R exactly once, matching every member's gmeow:findingRootCause."@x-gmeow-english ;
    logic:provenance logic:ruleClusterRoot ;
    logic:formalizes gmeow:clusterRoot ;
    logic:head [
        rdf:subject   "?root" ;
        rdf:predicate gmeow:clusterRoot ;
        rdf:object    "?root"
    ] ;
    logic:body [
        rdf:subject   "?finding" ;
        rdf:predicate gmeow:findingRootCause ;
        rdf:object    "?root"
    ] .

logic:ruleFindingClusterType
    a logic:Rule ,
        gmeow:DiagnosticMetaRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "type the root-keyed cluster node as a finding cluster"@x-gmeow-english ;
    skos:definition "Emits rdf:type(root, gmeow:FindingCluster) whenever some finding gmeow:findingRootCause a root: the root-keyed grouping node is a gmeow:FindingCluster. Positive Horn (logic:PositiveHornProfile); monotone; materialized natively. Types the shared root as the cluster it heads, so the readable 'N findings share root R' surface is a first-class typed node."@x-gmeow-english ;
    logic:provenance logic:ruleFindingClusterType ;
    logic:formalizes gmeow:FindingCluster ;
    logic:head [
        rdf:subject   "?root" ;
        rdf:predicate rdf:type ;
        rdf:object    gmeow:FindingCluster
    ] ;
    logic:body [
        rdf:subject   "?finding" ;
        rdf:predicate gmeow:findingRootCause ;
        rdf:object    "?root"
    ] .

logic:cqFindingClusterHolds
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "all findings sharing root R group under one cluster"@x-gmeow-english ;
    skos:definition "The positive competency case the cluster rules must satisfy — 'all findings sharing root R': given F2 and F3 that each gmeow:findingRootCause the root F1, the reasoner must derive gmeow:findingCluster(F2, F1), gmeow:findingCluster(F3, F1), gmeow:clusterRoot(F1, F1), and rdf:type(F1, gmeow:FindingCluster) — every finding sharing R gathered under the one root-keyed cluster node, which carries R exactly once."@x-gmeow-english .

logic:cqFindingClusterDistinctRootsRejected
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "findings under different roots never share a cluster"@x-gmeow-english ;
    skos:definition "The negative countermodel the cluster rules must respect: findings with DIFFERENT gmeow:findingRootCause values land in different clusters — a finding whose root is R1 is never linked by gmeow:findingCluster to the cluster keyed by a distinct R2, and each cluster node carries only its own root. The boundary that keeps unrelated root-cause groups from merging."@x-gmeow-english .

logic:candidateFindingCluster
    a logic:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "findings sharing a root cause group under one cluster node"@x-gmeow-english ;
    skos:definition "The derivation-rule formalization candidate governing logic:ruleFindingCluster, logic:ruleClusterRoot, and logic:ruleFindingClusterType: it harvests the grouping commitment in gmeow:FindingCluster's skos:definition (a grouping of findings that share one gmeow:findingRootCause, its members linked by gmeow:findingCluster and its shared root carried by gmeow:clusterRoot) into three enforced positive-Horn rules over the root-cause output, materialized natively as logic:ExactPreservation. Because fresh-node minting is not expressible in the reified-Horn chase, the cluster is identified by its root finding. Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation) with a positive case (logic:cqFindingClusterHolds) and a negative countermodel (logic:cqFindingClusterDistinctRootsRejected). Its harvest back-link (logic:candidateFormalizes gmeow:FindingCluster, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose, and logic:candidateSourceHash is the sha256 of that definition text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:c95215b1f377631247322939147176f00d05a7b6736cce41562c74f0ee064f44"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from gmeow:FindingCluster's skos:definition, which states it is a grouping of findings that share one gmeow:findingRootCause, its members linked by gmeow:findingCluster and its shared root carried by gmeow:clusterRoot (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "derivation: gmeow:findingRootCause ⇒ gmeow:findingCluster (member), gmeow:clusterRoot (root-keyed self-edge), and rdf:type gmeow:FindingCluster (grouping node), the cluster identified by its shared root finding"^^xsd:string ;
    logic:candidateContract logic:PositiveHornProfile ;
    logic:candidateCategory logic:CategoryDerivationRule ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidatePositiveCase logic:cqFindingClusterHolds ;
    logic:candidateNegativeCase logic:cqFindingClusterDistinctRootsRejected ;
    logic:candidateProjectionBehavior logic:ExactPreservation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes gmeow:FindingCluster ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# ── Cross-node glut: two opposing-polarity findings at one non-trivial anchor ────
logic:ruleCrossNodeGlut
    a logic:Rule ,
        gmeow:DiagnosticMetaRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "derive a cross-node glut edge from opposing polarities at one anchor"@x-gmeow-english ;
    skos:definition "Emits gmeow:crossNodeGlutWith(f1, f2) whenever two DISTINCT findings share one gmeow:findingAnchor that is a gmeow:NonTrivialAnchor, f1's gmeow:findingCategory has gmeow:categoryPolarity logic:InfoSupported, and f2's has logic:InfoOpposed: an opposing-polarity Belnap clash at one real source position, the cross-code coherence conflict the same-fingerprint merge (which keys on the code) cannot see. Positive Horn (logic:PositiveHornProfile) with a logic:distinctBody inequality guard (f1 ≠ f2) and the gmeow:NonTrivialAnchor guard that keeps it off the shared empty anchor of locationless findings; monotone; materialized natively (logic:ExactPreservation). Because the reified-Horn chase cannot mint a fresh witness node, the glut is carried as this directed edge (Supported → Opposed) rather than a minted gmeow:CrossNodeGlutWitness."@x-gmeow-english ;
    logic:provenance logic:ruleCrossNodeGlut ;
    logic:formalizes gmeow:crossNodeGlutWith ;
    logic:head [
        rdf:subject   "?f1" ;
        rdf:predicate gmeow:crossNodeGlutWith ;
        rdf:object    "?f2"
    ] ;
    logic:body [
        rdf:subject   "?f1" ;
        rdf:predicate gmeow:findingAnchor ;
        rdf:object    "?anchor"
    ] , [
        rdf:subject   "?f2" ;
        rdf:predicate gmeow:findingAnchor ;
        rdf:object    "?anchor"
    ] , [
        rdf:subject   "?anchor" ;
        rdf:predicate rdf:type ;
        rdf:object    gmeow:NonTrivialAnchor
    ] , [
        rdf:subject   "?f1" ;
        rdf:predicate gmeow:findingCategory ;
        rdf:object    "?category1"
    ] , [
        rdf:subject   "?category1" ;
        rdf:predicate gmeow:categoryPolarity ;
        rdf:object    logic:InfoSupported
    ] , [
        rdf:subject   "?f2" ;
        rdf:predicate gmeow:findingCategory ;
        rdf:object    "?category2"
    ] , [
        rdf:subject   "?category2" ;
        rdf:predicate gmeow:categoryPolarity ;
        rdf:object    logic:InfoOpposed
    ] ;
    logic:distinctBody [
        rdf:subject "?f1" ;
        rdf:object  "?f2"
    ] .

logic:cqCrossNodeGlutHolds
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "all cross-node gluts at one anchor"@x-gmeow-english ;
    skos:definition "The positive competency case the cross-node-glut rule must satisfy — 'all cross-node gluts at one anchor': given two distinct findings at one gmeow:NonTrivialAnchor whose categories carry opposing gmeow:categoryPolarity (one logic:InfoSupported, one logic:InfoOpposed), the reasoner must derive gmeow:crossNodeGlutWith linking them — the Supported/Opposed clash across codes the same-fingerprint merge structurally misses."@x-gmeow-english .

logic:cqCrossNodeGlutTrivialAnchorRejected
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a glut never fires on the shared empty anchor"@x-gmeow-english ;
    skos:definition "The first negative countermodel the cross-node-glut rule must respect: two opposing-polarity findings that share an anchor which is NOT a gmeow:NonTrivialAnchor (the default empty anchor locationless findings collapse onto) derive NO gmeow:crossNodeGlutWith — the gmeow:NonTrivialAnchor guard keeps the join off the shared placeholder, so the rule fires only at anchors that name a real source position. The boundary that prevents the false-join over locationless findings."@x-gmeow-english .

logic:cqCrossNodeGlutSamePolarityRejected
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "same-polarity findings at one anchor are not a glut"@x-gmeow-english ;
    skos:definition "The second negative countermodel the cross-node-glut rule must respect: two findings at one gmeow:NonTrivialAnchor whose categories carry the SAME gmeow:categoryPolarity (both logic:InfoSupported, say) derive NO gmeow:crossNodeGlutWith — a glut is an OPPOSING Belnap clash (Supported vs Opposed), never an agreement; and findings at DIFFERENT anchors never join at all. The boundary that keeps the edge to genuine coherence conflicts."@x-gmeow-english .

logic:candidateCrossNodeGlut
    a logic:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a cross-node glut is opposing polarities at one shared anchor"@x-gmeow-english ;
    skos:definition "The derivation-rule formalization candidate governing logic:ruleCrossNodeGlut: it harvests the cross-node-glut commitment in gmeow:findingAnchor's skos:definition (the anchor is the code-blind join key that lets a reasoner join two different-code findings at one place and detect an opposing-polarity conflict the same-fingerprint merge misses) into an enforced positive-Horn rule with an inequality guard and a non-trivial-anchor guard, materialized natively as logic:ExactPreservation. Because the reified-Horn chase cannot mint a fresh witness node, the glut is carried as the gmeow:crossNodeGlutWith edge rather than a minted gmeow:CrossNodeGlutWitness. Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation) with a positive case (logic:cqCrossNodeGlutHolds) and two countermodels (logic:cqCrossNodeGlutTrivialAnchorRejected, logic:cqCrossNodeGlutSamePolarityRejected). Its harvest back-link (logic:candidateFormalizes gmeow:findingAnchor, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose, and logic:candidateSourceHash is the sha256 of that definition text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:8b2aa3227645ac27452770bbb7393bef455a9049875ded598a4ca9545d39903f"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from gmeow:findingAnchor's skos:definition, which states the anchor is the join key for cross-node glut detection: a reasoner joins two different-code findings at one place and detects an opposing-polarity conflict the same-fingerprint merge misses (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "derivation: shared gmeow:findingAnchor typed gmeow:NonTrivialAnchor, distinct findings, gmeow:categoryPolarity logic:InfoSupported ∧ logic:InfoOpposed ⇒ gmeow:crossNodeGlutWith"^^xsd:string ;
    logic:candidateContract logic:PositiveHornProfile ;
    logic:candidateCategory logic:CategoryDerivationRule ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidatePositiveCase logic:cqCrossNodeGlutHolds ;
    logic:candidateNegativeCase logic:cqCrossNodeGlutTrivialAnchorRejected ,
        logic:cqCrossNodeGlutSamePolarityRejected ;
    logic:candidateProjectionBehavior logic:ExactPreservation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes gmeow:findingAnchor ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# ── Extensibility demonstrator: a third tagged rule, discovered by TYPE ──────────
# Marks a finding that is some finding's derived root cause. It fires through the
# SAME gmeow:DiagnosticMetaRule class selection as the rules above, with zero
# engine change — the proof that a new meta-finding is added by authoring a tagged
# rule, not by touching the reasoner (design-decision-2).
logic:ruleRootFinding
    a logic:Rule ,
        gmeow:DiagnosticMetaRule ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "mark a finding that is some finding's root cause"@x-gmeow-english ;
    skos:definition "Emits rdf:type(root, gmeow:RootFinding) whenever some finding gmeow:findingRootCause a root: the childless root antecedent surfaced as a one-place marker. Positive Horn (logic:PositiveHornProfile) over the root-cause output (stratified above it); monotone; materialized natively (logic:ExactPreservation). Authored as the third member of the diagnostic meta-fold to demonstrate that a new meta-finding is added by tagging a rule gmeow:DiagnosticMetaRule — the reasoner discovers and runs it by TYPE, with no engine change."@x-gmeow-english ;
    logic:provenance logic:ruleRootFinding ;
    logic:formalizes gmeow:RootFinding ;
    logic:head [
        rdf:subject   "?root" ;
        rdf:predicate rdf:type ;
        rdf:object    gmeow:RootFinding
    ] ;
    logic:body [
        rdf:subject   "?finding" ;
        rdf:predicate gmeow:findingRootCause ;
        rdf:object    "?root"
    ] .

logic:cqRootFindingHolds
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a witnessed root is marked a root finding"@x-gmeow-english ;
    skos:definition "The positive competency case the root-finding rule must satisfy — 'which findings are root causes': given F2 gmeow:findingRootCause F1, the reasoner must derive rdf:type(F1, gmeow:RootFinding); and it must fire through the gmeow:DiagnosticMetaRule class discovery exactly like the other meta-rules, so a consumer selecting rules by that type runs it with no engine change."@x-gmeow-english .

logic:cqRootFindingNonRootRejected
    a logic:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a non-root finding is never a root finding"@x-gmeow-english ;
    skos:definition "The negative countermodel the root-finding rule must respect: a finding that is NOT the gmeow:findingRootCause of any finding is never typed gmeow:RootFinding — the marker names exactly the witnessed roots, so a downstream witness or an independent finding with no dependents carries no gmeow:RootFinding type."@x-gmeow-english .

logic:candidateDiagnosticMetaExtensibility
    a logic:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a new meta-finding is added by tagging a rule, with no engine change"@x-gmeow-english ;
    skos:definition "The derivation-rule formalization candidate governing logic:ruleRootFinding, the extensibility demonstrator: it harvests the extension-point commitment in gmeow:DiagnosticMetaRule's skos:definition (the reasoner enumerates every gmeow:DiagnosticMetaRule and applies it, so a new meta-finding is added by authoring a new tagged rule with zero engine change) into an enforced positive-Horn rule deriving gmeow:RootFinding, materialized natively as logic:ExactPreservation. Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation) with a positive case (logic:cqRootFindingHolds) and a negative countermodel (logic:cqRootFindingNonRootRejected). Its harvest back-link (logic:candidateFormalizes gmeow:DiagnosticMetaRule, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose, and logic:candidateSourceHash is the sha256 of that definition text so a later edit surfaces as drift."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:6c55898bf91f86ff60aed9ed10787e4e1f6823d7f4eb148072946975d509eabc"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from gmeow:DiagnosticMetaRule's skos:definition, which states the reasoner enumerates every gmeow:DiagnosticMetaRule and applies it, so a new meta-finding is added by authoring a new tagged rule with zero engine change (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "derivation: gmeow:findingRootCause ⇒ rdf:type gmeow:RootFinding, discovered and run by the gmeow:DiagnosticMetaRule class selection with no engine change"^^xsd:string ;
    logic:candidateContract logic:PositiveHornProfile ;
    logic:candidateCategory logic:CategoryDerivationRule ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidatePositiveCase logic:cqRootFindingHolds ;
    logic:candidateNegativeCase logic:cqRootFindingNonRootRejected ;
    logic:candidateProjectionBehavior logic:ExactPreservation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes gmeow:DiagnosticMetaRule ;
