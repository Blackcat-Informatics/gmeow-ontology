# CadastralReference well-formedness: exactly one value, at least one type, one authority, one jurisdiction.
gmeow:CadastralReferenceShape
    a sh:NodeShape ;
    rdfs:label "CadastralReference well-formedness shape"@x-gmeow-english ;
    sh:targetClass gmeow:CadastralReference ;
    sh:property [
        sh:path gmeow:referenceValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CadastralReference must record exactly one reference value (gmeow:referenceValue)." ;
    ] ;
    sh:property [
        sh:path gmeow:referenceType ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CadastralReference must record at least one reference type (gmeow:referenceType)." ;
    ] ;
    sh:property [
        sh:path gmeow:referenceAuthority ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CadastralReference must record exactly one issuing authority (gmeow:referenceAuthority)." ;
    ] ;
    sh:property [
        sh:path gmeow:referenceJurisdiction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CadastralReference must record exactly one jurisdiction (gmeow:referenceJurisdiction)." ;
    ] .

# PlaceNaming has-players guard (Violation): a NameUsage that names a Place must bind
# a PlaceName appellation.
gmeow:PlaceNamingHasPlayersShape
    a sh:NodeShape ;
    rdfs:label "PlaceNaming player binding shape"@x-gmeow-english ;
    sh:targetClass gmeow:NameUsage ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A name-usage that names a gmeow:Place must bind a gmeow:PlaceName via gmeow:usageAppellation." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/usageNamed> ?place .
                ?place a <https://blackcatinformatics.ca/gmeow/Place> .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/usageAppellation> ?app .
                    ?app a <https://blackcatinformatics.ca/gmeow/PlaceName>
                }
            }
        """ ;
    ] .

# Superseded place suppression (Principle 10): a place that has been superseded by
# another place should set gmeow:displayable false. Warning — a source may lag the flag.
gmeow:SupersededPlaceSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Superseded place suppression shape"@x-gmeow-english ;
    sh:targetClass gmeow:Place ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A superseded place (one with gmeow:placeSupersededBy) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/placeSupersededBy> ?successor .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Accessibility module (#102). Closed-world well-formedness for the
# AccessibilityAssertion relator; suppression contract (Principle 10).
# --------------------------------------------------------------------------- #

gmeow:AccessibilityAssertionShape
    a sh:NodeShape ;
    rdfs:label "AccessibilityAssertion well-formedness shape"@x-gmeow-english ;
    sh:targetClass gmeow:AccessibilityAssertion ;
    sh:property [
        sh:path gmeow:assertionSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An AccessibilityAssertion must assess exactly one subject (gmeow:assertionSubject)." ;
    ] ;
    sh:property [
        sh:path gmeow:assertionFacet ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An AccessibilityAssertion must assert exactly one facet (gmeow:assertionFacet)." ;
    ] ;
    sh:property [
        sh:path gmeow:assertionPolarity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An AccessibilityAssertion must declare exactly one polarity (gmeow:assertionPolarity)." ;
    ] .

# Suppression, never erasure (Principle 10): a retracted or superseded
# accessibility assertion (one with gmeow:validUntil) should set
# gmeow:displayable false rather than be deleted. Warning — a source may lag.
gmeow:RetractedAccessibilityAssertionShape
    a sh:NodeShape ;
    rdfs:label "Retracted accessibility assertion suppression shape"@x-gmeow-english ;
    sh:targetClass gmeow:AccessibilityAssertion ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A retracted or superseded accessibility assertion (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/validUntil> ?until .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

gmeow:GeocodeShape
    a sh:NodeShape ;
    rdfs:label "Geocode well-formedness shape"@x-gmeow-english ;
    skos:definition "Enforces that a Geocode carries exactly one code value (the exactly-one-frame half is the generated gmeow:GeocodeFrameRequirementShape, #283). sh:xone (not sh:or) is intentional: a single Geocode instance represents one code in one system; competing or supplementary codes for the same place are modeled as multiple Geocode instances linked via gmeow:hasGeocode, coexisting as standpoint-indexed claims per Principle 9."@en ;
    sh:targetClass gmeow:Geocode ;
    sh:xone (
        [ sh:path gmeow:geocodeValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ]
        [ sh:path gmeow:plusCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:what3words ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:geohash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:mgrs ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:unLocode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:mileMarker ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        [ sh:path gmeow:hasCoordinateMatrix ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A Geocode must carry exactly one code value: geocodeValue, plusCode, what3words, geohash, mgrs, unLocode, mileMarker, or hasCoordinateMatrix." .


# =========================================================================== #
# Creative-works module (#208) — WEMI spine well-formedness
# =========================================================================== #

# Contribution relator well-formedness — closed-world cardinality.
# Mirrors ParticipationHasPlayersShape and NameUsageShape.
# CitationAct relator well-formedness — closed-world cardinality.
gmeow:CitationActShape
    a sh:NodeShape ;
    rdfs:label "CitationAct well-formedness shape"@x-gmeow-english ;
    sh:targetClass gmeow:CitationAct ;
    sh:property [
        sh:path gmeow:citingEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CitationAct must have exactly one citing entity (gmeow:citingEntity)." ;
    ] ;
    sh:property [
        sh:path gmeow:citedEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CitationAct must have exactly one cited entity (gmeow:citedEntity)." ;
    ] ;
    sh:property [
        sh:path gmeow:citationIntent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A CitationAct must specify exactly one citation intent (gmeow:citationIntent)." ;
    ] .

# Spine integrity: every Expression realizes at least one Work.
# Spine integrity: every Manifestation embodies at least one Expression.
# Spine integrity: every Item exemplifies at least one Manifestation.
# Expression well-formedness: carries a reference frame (language/notation/arrangement).
# =========================================================================== #
# Evidence module (#224) — evidential warrant & source-typing shapes
# =========================================================================== #

# Self/private-only warning: a citation whose only evidence classes are SELF or
# PrivateScan, and whose source independence is self/issuer originated, is
# eligible for projection suppression (Principle 10 — never erasure).
gmeow:SelfPrivateEvidenceWarningShape
    a sh:NodeShape ;
    rdfs:label "Self/private-only evidence warning shape"@x-gmeow-english ;
    sh:targetClass gmeow:CitationAct ;
    sh:sparql [
        sh:severity sh:Warning ;   # on the constraint, where conformant SHACL honors it (a source may lag the flag)
        sh:message "This citation relies solely on self-asserted or private evidence from a self/issuer-originated source — consider suppressing it from public projections (Principle 10)." ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://blackcatinformatics.ca/gmeow/CitationAct> .
                $this <https://blackcatinformatics.ca/gmeow/hasEvidenceClass> ?ec .
                FILTER(?ec IN (
                    <https://blackcatinformatics.ca/gmeow/evidenceSELF>,
                    <https://blackcatinformatics.ca/gmeow/evidencePrivateScan>
                ))
                # Ensure ALL evidence classes are in the self/private set.
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/hasEvidenceClass> ?other .
                    FILTER(?other NOT IN (
                        <https://blackcatinformatics.ca/gmeow/evidenceSELF>,
                        <https://blackcatinformatics.ca/gmeow/evidencePrivateScan>
                    ))
                }
                # And the source is self/issuer originated.
                $this <https://blackcatinformatics.ca/gmeow/sourceIndependence> <https://blackcatinformatics.ca/gmeow/sourceIndependenceSelfOrIssuerOriginated> .
            }
        """ ;
    ] .

# Notability-requirement violation: supportsNotability true requires the full
# WP:GNG triad (independent + secondary + significant coverage).
gmeow:NotabilityRequirementShape
    a sh:NodeShape ;
    rdfs:label "Notability requirement shape"@x-gmeow-english ;
    sh:targetClass gmeow:CitationAct ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A citation with supportsNotability true must have sourceIndependence independent, sourceTier secondary, and coverageDepth significantCoverage (WP:GNG triad)." ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://blackcatinformatics.ca/gmeow/CitationAct> .
                $this <https://blackcatinformatics.ca/gmeow/supportsNotability> true .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/sourceIndependence> <https://blackcatinformatics.ca/gmeow/sourceIndependenceIndependent> .
                    $this <https://blackcatinformatics.ca/gmeow/sourceTier> <https://blackcatinformatics.ca/gmeow/sourceTierSecondary> .
                    $this <https://blackcatinformatics.ca/gmeow/coverageDepth> <https://blackcatinformatics.ca/gmeow/coverageDepthSignificantCoverage> .
                }
            }
        """ ;
    ] .
gmeow:CharacterArcShape
    a sh:NodeShape ;
    rdfs:label "Character Arc Shape"@x-gmeow-english ;
    sh:targetClass gmeow:CharacterArc ;
    sh:property [
        sh:path gmeow:arcSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A CharacterArc must have exactly one gmeow:arcSubject." ;
    ] ;
    sh:property [
        sh:path gmeow:arcType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A CharacterArc must have exactly one gmeow:arcType." ;
    ] .

gmeow:MythShape
    a sh:NodeShape ;
    rdfs:label "Myth Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Myth ;
    sh:property [
        sh:path gmeow:hasMythTelling ;
        sh:minCount 0 ;
        sh:class gmeow:CreativeWork ;
        sh:severity sh:Violation ;
        sh:message "A Myth telling must be a gmeow:CreativeWork." ;
    ] ;
    sh:property [
        sh:path gmeow:recurringRisk ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:severity sh:Violation ;
        sh:message "A Myth may have at most one gmeow:recurringRisk boolean." ;
    ] ;
    sh:property [
        sh:path gmeow:affectedConsumerSurface ;
        sh:minCount 0 ;
        sh:class gmeow:ProjectionContext ;
        sh:severity sh:Violation ;
        sh:message "A Myth affected consumer surface must be a gmeow:ProjectionContext." ;
    ] .

gmeow:ReadingOrderShape
    a sh:NodeShape ;
    rdfs:label "Reading Order Shape"@x-gmeow-english ;
    rdfs:comment "Documentation only — asserts no property constraints. gmeow:ReadingOrder is a gmeow:Standpoint subclass; Standpoint declares no owl:Restriction requirements in the ontology, so this shape serves as a marker confirming ReadingOrder instances are valid without additional closed-world checks."@x-gmeow-english ;
    sh:targetClass gmeow:ReadingOrder .

# =========================================================================== #
# Finance module (#64) — MonetaryAmount and FinancialAccount shapes
# =========================================================================== #

# Every MonetaryAmount must have exactly one currency (frame-relativity, P11).
# FinancialAccount well-formedness — holder (required) and type (functional).
gmeow:FinancialAccountShape
    a sh:NodeShape ;
    rdfs:label "FinancialAccount shape"@x-gmeow-english ;
    sh:targetClass gmeow:FinancialAccount ;
    sh:property [
        sh:path gmeow:accountHolder ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "Every FinancialAccount must have at least one account holder (gmeow:accountHolder)." ;
    ] ;
    sh:property [
        sh:path gmeow:accountCurrency ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:ReferenceFrame ;
        sh:severity sh:Violation ;
        sh:message "Each gmeow:accountCurrency value on a FinancialAccount must be a gmeow:ReferenceFrame." ;
    ] ;
    sh:property [
        sh:path gmeow:accountType ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:FinancialAccountType ;
        sh:severity sh:Violation ;
        sh:message "A FinancialAccount must have at most one account type (gmeow:accountType)." ;
    ] .

# Every MonetaryAmount must have exactly one monetary value.
gmeow:MonetaryAmountHasValueShape
    a sh:NodeShape ;
    rdfs:label "MonetaryAmount value shape"@x-gmeow-english ;
    sh:targetClass gmeow:MonetaryAmount ;
    sh:property [
        sh:path gmeow:monetaryValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "Every MonetaryAmount must have exactly one monetary value (gmeow:monetaryValue, xsd:decimal)." ;
    ] .

# --------------------------------------------------------------------------- #
# Finance module Phase B shapes — Transactions, Ledger, Posting.
# --------------------------------------------------------------------------- #

# A FinancialTransaction must have at least one participant.  Accepts either the
# flat shortcut (hasParticipant) or a reified Participation relator.
gmeow:TransactionHasPartiesShape
    a sh:NodeShape ;
    rdfs:label "Transaction has parties shape"@x-gmeow-english ;
    sh:targetClass gmeow:FinancialTransaction ;
    sh:or (
        [
            sh:path gmeow:hasParticipant ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:severity sh:Violation ;
        ]
        [
            sh:path [ sh:inversePath gmeow:participationEvent ] ;
            sh:minCount 1 ;
            sh:class gmeow:Participation ;
            sh:severity sh:Violation ;
        ]
    ) ;
    sh:message "A FinancialTransaction must have at least one participant (gmeow:hasParticipant or gmeow:Participation relator)." .

# A FinancialTransaction must have an amount (mirrors the EL someValuesFrom axiom).
gmeow:TransactionHasAmountShape
    a sh:NodeShape ;
    rdfs:label "Transaction has amount shape"@x-gmeow-english ;
    sh:targetClass gmeow:FinancialTransaction ;
    sh:property [
        sh:path gmeow:transactionAmount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:MonetaryAmount ;
        sh:severity sh:Violation ;
        sh:message "A FinancialTransaction must have exactly one transaction amount (gmeow:transactionAmount)." ;
    ] .

# A LedgerAccount must have a type and at least one holder.
gmeow:LedgerAccountShape
    a sh:NodeShape ;
    rdfs:label "LedgerAccount shape"@x-gmeow-english ;
    sh:targetClass gmeow:LedgerAccount ;
    sh:property [
        sh:path gmeow:ledgerAccountHolder ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "Every LedgerAccount must have at least one ledger account holder (gmeow:ledgerAccountHolder)." ;
    ] ;
    sh:property [
        sh:path gmeow:ledgerAccountType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:LedgerAccountType ;
        sh:severity sh:Violation ;
        sh:message "A LedgerAccount must have exactly one ledger account type (gmeow:ledgerAccountType)." ;
    ] .

# A JournalEntry must have at least two postings.
gmeow:JournalEntryHasPostingsShape
    a sh:NodeShape ;
    rdfs:label "JournalEntry postings shape"@x-gmeow-english ;
    sh:targetClass gmeow:JournalEntry ;
    sh:property [
        sh:path gmeow:journalEntryPostings ;
        sh:minCount 2 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:Posting ;
        sh:severity sh:Violation ;
        sh:message "A JournalEntry must have at least two postings (gmeow:journalEntryPostings)." ;
    ] .

# Enforce double-entry balance (Σ debits = Σ credits) per currency.
gmeow:JournalEntryBalancedShape
    a sh:NodeShape ;
    rdfs:label "JournalEntry balanced shape"@x-gmeow-english ;
    sh:targetClass gmeow:JournalEntry ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "The sum of debit postings must equal the sum of credit postings for each currency in a JournalEntry." ;
        sh:select """
            SELECT $this WHERE {
                {
                    SELECT $this ?currency (SUM(?debitVal) AS ?sumDebits) (SUM(?creditVal) AS ?sumCredits)
                    WHERE {
                        $this <https://blackcatinformatics.ca/gmeow/journalEntryPostings> ?posting .
                        ?posting <https://blackcatinformatics.ca/gmeow/postingAmount> ?amount ;
                                 <https://blackcatinformatics.ca/gmeow/postingDirection> ?direction .
                        ?amount <https://blackcatinformatics.ca/gmeow/monetaryValue> ?val ;
                                <https://blackcatinformatics.ca/gmeow/currency> ?currency .
                        BIND(IF(?direction = <https://blackcatinformatics.ca/gmeow/postingDirectionDebit>, ?val, 0) AS ?debitVal)
                        BIND(IF(?direction = <https://blackcatinformatics.ca/gmeow/postingDirectionCredit>, ?val, 0) AS ?creditVal)
                    }
                    GROUP BY $this ?currency
                }
                FILTER(?sumDebits != ?sumCredits)
            }
        """ ;
    ] .

# A Posting must have journal entry, account, amount, and direction.
gmeow:PostingShape
    a sh:NodeShape ;
    rdfs:label "Posting shape"@x-gmeow-english ;
    sh:targetClass gmeow:Posting ;
    sh:property [
        sh:path gmeow:postingJournalEntry ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:JournalEntry ;
        sh:severity sh:Violation ;
        sh:message "A Posting must have exactly one journal entry (gmeow:postingJournalEntry)." ;
    ] ;
    sh:property [
        sh:path gmeow:postingAccount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:LedgerAccount ;
        sh:severity sh:Violation ;
        sh:message "A Posting must have exactly one ledger account (gmeow:postingAccount)." ;
    ] ;
    sh:property [
        sh:path gmeow:postingAmount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:MonetaryAmount ;
        sh:severity sh:Violation ;
        sh:message "A Posting must have exactly one monetary amount (gmeow:postingAmount)." ;
    ] ;
    sh:property [
        sh:path gmeow:postingDirection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:PostingDirection ;
        sh:in ( gmeow:postingDirectionDebit gmeow:postingDirectionCredit ) ;
        sh:severity sh:Violation ;
        sh:message "A Posting must have exactly one posting direction (gmeow:postingDirection), and it must be debit or credit." ;
    ] .

# --------------------------------------------------------------------------- #
# Finance module Phase C shapes — Invoice, Order, Holding.
# --------------------------------------------------------------------------- #

# An Invoice must have an amount, at least one issuer, and at least one recipient.
gmeow:InvoiceShape
    a sh:NodeShape ;
    rdfs:label "Invoice shape"@x-gmeow-english ;
    sh:targetClass gmeow:Invoice ;
    sh:property [
        sh:path gmeow:invoiceAmount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:MonetaryAmount ;
        sh:severity sh:Violation ;
        sh:message "An Invoice must have exactly one invoice amount (gmeow:invoiceAmount)." ;
    ] ;
    sh:property [
        sh:path gmeow:invoiceIssuer ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "An Invoice must have at least one issuer (gmeow:invoiceIssuer)." ;
    ] ;
    sh:property [
        sh:path gmeow:invoiceRecipient ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "An Invoice must have at least one recipient (gmeow:invoiceRecipient)." ;
    ] .

# An Order must have an amount, at least one buyer, and at least one seller.
gmeow:OrderShape
    a sh:NodeShape ;
    rdfs:label "Order shape"@x-gmeow-english ;
    sh:targetClass gmeow:Order ;
    sh:property [
        sh:path gmeow:orderAmount ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:MonetaryAmount ;
        sh:severity sh:Violation ;
        sh:message "An Order must have exactly one order amount (gmeow:orderAmount)." ;
    ] ;
    sh:property [
        sh:path gmeow:orderBuyer ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "An Order must have at least one buyer (gmeow:orderBuyer)." ;
    ] ;
    sh:property [
        sh:path gmeow:orderSeller ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "An Order must have at least one seller (gmeow:orderSeller)." ;
    ] .

# A Holding must have agent, asset, and quantity.
gmeow:HoldingShape
    a sh:NodeShape ;
    rdfs:label "Holding shape"@x-gmeow-english ;
    sh:targetClass gmeow:Holding ;
    sh:property [
        sh:path gmeow:holdingAgent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "A Holding must have exactly one agent (gmeow:holdingAgent)." ;
    ] ;
    sh:property [
        sh:path gmeow:holdingAsset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:Asset ;
        sh:severity sh:Violation ;
        sh:message "A Holding must have exactly one asset (gmeow:holdingAsset)." ;
    ] ;
    sh:property [
        sh:path gmeow:holdingQuantity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "A Holding must have exactly one quantity (gmeow:holdingQuantity, xsd:decimal)." ;
    ] .

# --------------------------------------------------------------------------- #
# Finance module Phase D shapes — CryptoWallet.
# --------------------------------------------------------------------------- #

# A CryptoWallet must have a scheme.
gmeow:CryptoWalletShape
    a sh:NodeShape ;
    rdfs:label "CryptoWallet shape"@x-gmeow-english ;
    sh:targetClass gmeow:CryptoWallet ;
    sh:property [
        sh:path gmeow:walletScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:WalletScheme ;
        sh:severity sh:Violation ;
        sh:message "A CryptoWallet must have exactly one wallet scheme (gmeow:walletScheme)." ;
    ] .

# --------------------------------------------------------------------------- #
# Finance module Phase B–D suppression shapes (Principle 10).
# Reversed/cancelled records must be suppressed (displayable false), never
# deleted. Warning — a source may legitimately lag on setting the flag.
# --------------------------------------------------------------------------- #

gmeow:ReversedTransactionSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Reversed transaction suppression shape"@x-gmeow-english ;
    sh:targetClass gmeow:FinancialTransaction ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A reversed transaction should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/transactionStatus> <https://blackcatinformatics.ca/gmeow/transactionStatusReversed> .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

gmeow:CancelledInvoiceSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Cancelled invoice suppression shape"@x-gmeow-english ;
    sh:targetClass gmeow:Invoice ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A cancelled invoice should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/invoiceStatus> <https://blackcatinformatics.ca/gmeow/invoiceStatusCancelled> .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

gmeow:CancelledOrderSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Cancelled order suppression shape"@x-gmeow-english ;
    sh:targetClass gmeow:Order ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A cancelled order should set gmeow:displayable false — suppressed from display, never deleted (Principle 10)." ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/orderStatus> <https://blackcatinformatics.ca/gmeow/orderStatusCancelled> .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# =========================================================================== #
# Deception data shapes (#213). Instance-targeted; dormant on TBox.
# =========================================================================== #

# A deception event must carry at least one held standpoint and one projected
# standpoint. minCount only (open-world: a complex deception may have more).
gmeow:DeceptionEventShape
    a sh:NodeShape ;
    rdfs:label "Deception event well-formedness shape"@x-gmeow-english ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://blackcatinformatics.ca/gmeow/Event> .
                ?this <https://blackcatinformatics.ca/gmeow/eventType> <https://blackcatinformatics.ca/gmeow/eventTypeDeception> .
            }
        """ ;
    ] ;
    sh:property [
        sh:path gmeow:heldStandpoint ;
        sh:minCount 1 ;
        sh:class gmeow:DoxasticStandpointClaim ;
        sh:severity sh:Violation ;
        sh:message "A deception event must carry at least one held standpoint (gmeow:heldStandpoint) of type gmeow:DoxasticStandpointClaim." ;
    ] ;
    sh:property [
        sh:path gmeow:projectedStandpoint ;
        sh:minCount 1 ;
        sh:class gmeow:DoxasticStandpointClaim ;
        sh:severity sh:Violation ;
        sh:message "A deception event must carry at least one projected standpoint (gmeow:projectedStandpoint) of type gmeow:DoxasticStandpointClaim." ;
    ] .

# A deception cue observation must carry vantage and observationResult.
gmeow:DeceptionCueShape
    a sh:NodeShape ;
    rdfs:label "Deception cue well-formedness shape"@x-gmeow-english ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?event a <https://blackcatinformatics.ca/gmeow/Event> .
                ?event <https://blackcatinformatics.ca/gmeow/deceptionCue> ?this .
            }
        """ ;
    ] ;
    sh:class gmeow:Observation ;
    sh:property [
        sh:path gmeow:vantage ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A deception cue observation must have a vantage (gmeow:vantage)." ;
    ] ;
    sh:property [
        sh:path gmeow:observationResult ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A deception cue observation must have an observation result (gmeow:observationResult)." ;
    ] .

# =========================================================================== #
# Procedures module shapes (#226) — plan ⟂ execution de-conflation
# =========================================================================== #

# An Execution must reference at least one Procedure or ProcedureStep.
gmeow:ExecutionHasPlanShape
    a sh:NodeShape ;
    rdfs:label "Execution must reference a plan or step"@x-gmeow-english ;
    sh:targetClass gmeow:Execution ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "An Execution must reference at least one Procedure (gmeow:executesProcedure) or ProcedureStep (gmeow:executesStep)." ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://blackcatinformatics.ca/gmeow/Execution> .
                FILTER NOT EXISTS {
                    { $this <https://blackcatinformatics.ca/gmeow/executesProcedure> ?p }
                    UNION
                    { $this <https://blackcatinformatics.ca/gmeow/executesStep> ?s }
                }
            }
        """ ;
    ] .

# A ControlFlow must have exactly one source and one target.
gmeow:ControlFlowHasSourceTargetShape
    a sh:NodeShape ;
    rdfs:label "ControlFlow must have source and target"@x-gmeow-english ;
    sh:targetClass gmeow:ControlFlow ;
    sh:property [
        sh:path gmeow:flowSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:ProcedureStep ;
        sh:severity sh:Violation ;
        sh:message "A ControlFlow must have exactly one flowSource (a ProcedureStep)." ;
    ] ;
    sh:property [
        sh:path gmeow:flowTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:ProcedureStep ;
        sh:severity sh:Violation ;
        sh:message "A ControlFlow must have exactly one flowTarget (a ProcedureStep)." ;
    ] .

# A DataFlow must have exactly one source and one target.
gmeow:DataFlowHasSourceTargetShape
    a sh:NodeShape ;
    rdfs:label "DataFlow must have source and target"@x-gmeow-english ;
    sh:targetClass gmeow:DataFlow ;
    sh:property [
        sh:path gmeow:dataFlowSource ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:ProcedureStep ;
        sh:severity sh:Violation ;
        sh:message "A DataFlow must have exactly one dataFlowSource (a ProcedureStep)." ;
    ] ;
    sh:property [
        sh:path gmeow:dataFlowTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:ProcedureStep ;
        sh:severity sh:Violation ;
        sh:message "A DataFlow must have exactly one dataFlowTarget (a ProcedureStep)." ;
    ] .

# A branch step must be the source of at least two ControlFlow relators.
gmeow:BranchHasOutgoingFlowsShape
    a sh:NodeShape ;
    rdfs:label "Branch step must have at least two outgoing control flows"@x-gmeow-english ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://blackcatinformatics.ca/gmeow/ProcedureStep> .
                ?this <https://blackcatinformatics.ca/gmeow/procedureStepType> <https://blackcatinformatics.ca/gmeow/stepTypeBranch> .
            }
        """ ;
    ] ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A ProcedureStep of type stepTypeBranch must be the source of at least two ControlFlow relators." ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://blackcatinformatics.ca/gmeow/ProcedureStep> .
                $this <https://blackcatinformatics.ca/gmeow/procedureStepType> <https://blackcatinformatics.ca/gmeow/stepTypeBranch> .
                FILTER NOT EXISTS {
                    ?flow1 a <https://blackcatinformatics.ca/gmeow/ControlFlow> ;
                           <https://blackcatinformatics.ca/gmeow/flowSource> $this .
                    ?flow2 a <https://blackcatinformatics.ca/gmeow/ControlFlow> ;
                           <https://blackcatinformatics.ca/gmeow/flowSource> $this .
                    FILTER (?flow1 != ?flow2)
                }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Notes & Annotation building block (#63)
# --------------------------------------------------------------------------- #

gmeow:WebAnnotationShape
    a sh:NodeShape ;
    rdfs:label "Web Annotation well-formedness shape"@x-gmeow-english ;
    sh:targetClass gmeow:Annotation ;
    sh:property [
        sh:path gmeow:annotationTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every Annotation must have exactly one annotationTarget." ;
    ] ;
    sh:property [
        sh:path gmeow:annotationBody ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Annotation may have at most one annotationBody." ;
    ] ;
    sh:property [
        sh:path gmeow:annotationMotivation ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every Annotation must have exactly one annotationMotivation." ;
    ] .

gmeow:HighlightHasSelectorShape
    a sh:NodeShape ;
    rdfs:label "Highlight must have a selector span"@x-gmeow-english ;
    sh:targetClass gmeow:Highlight ;
    sh:property [
        sh:path gmeow:annotationTargetSpan ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Every Highlight must have at least one annotationTargetSpan (an EvidenceSpan or Selector)." ;
    ] .

gmeow:CommentHasParentShape
    a sh:NodeShape ;
    rdfs:label "Comment parent must be an Entity"@x-gmeow-english ;
    sh:targetClass gmeow:Comment ;
    sh:property [
        sh:path gmeow:commentParent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Entity ;
        sh:severity sh:Violation ;
        sh:message "A commentParent must point to exactly one Entity (typically an Annotation or Comment)." ;
    ] .

gmeow:NoteContentShape
    a sh:NodeShape ;
    rdfs:label "Note must have content or a label"@x-gmeow-english ;
    sh:targetClass gmeow:Note ;
    sh:or (
        [ sh:path gmeow:noteContent ; sh:minCount 1 ]
        [ sh:path rdfs:label ; sh:minCount 1 ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "A Note must have gmeow:noteContent or at least one rdfs:label." .

gmeow:RetractedNoteSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Retracted comment suppression check"@x-gmeow-english ;
    sh:targetClass gmeow:Comment ;
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "A comment whose parent is suppressed should set gmeow:displayable false (Principle 10)." ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://blackcatinformatics.ca/gmeow/Comment> .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false .
                }
                $this <https://blackcatinformatics.ca/gmeow/commentParent> ?parent .
                ?parent <https://blackcatinformatics.ca/gmeow/displayable> false .
            }
        """ ;
    ] .

# =========================================================================== #
# Images module (issue #22) — DepictionUsage, ImageRegion, SceneGraphEdge
# =========================================================================== #

gmeow:DepictionUsageShape
    a sh:NodeShape ;
    rdfs:label "Depiction Usage Shape"@x-gmeow-english ;
    sh:targetClass gmeow:DepictionUsage ;
    sh:property [
        sh:path gmeow:depictionSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Entity ;
        sh:severity sh:Violation ;
        sh:message "A DepictionUsage must specify exactly one depicted entity (gmeow:depictionSubject)." ;
    ] ;
    sh:property [
        sh:path gmeow:depictionImage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:MediaObject ;
        sh:severity sh:Violation ;
        sh:message "A DepictionUsage must specify exactly one image (gmeow:depictionImage)." ;
    ] ;
    sh:property [
        sh:path gmeow:depictionContext ;
        sh:minCount 1 ;
        sh:class gmeow:DepictionContext ;
        sh:severity sh:Violation ;
        sh:message "A DepictionUsage must specify exactly one depiction context (gmeow:depictionContext)." ;
    ] ;
    sh:property [
        sh:path gmeow:depictionContext ;
        sh:maxCount 1 ;
        sh:class gmeow:DepictionContext ;
        sh:severity sh:Violation ;
        sh:message "A DepictionUsage must have at most one depiction context." ;
    ] .

gmeow:ImageRegionShape
    a sh:NodeShape ;
    rdfs:label "Image Region Shape"@x-gmeow-english ;
    sh:targetClass gmeow:ImageRegion ;
    sh:property [
        sh:path gmeow:regionOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:MediaObject ;
        sh:severity sh:Violation ;
        sh:message "An ImageRegion must be a region of exactly one MediaObject (gmeow:regionOf)." ;
    ] ;
    sh:property [
        sh:path gmeow:regionSelector ;
        sh:minCount 1 ;
        sh:class gmeow:RegionSelector ;
        sh:severity sh:Violation ;
        sh:message "An ImageRegion must have at least one selector (gmeow:regionSelector)." ;
    ] ;
    sh:property [
        sh:path gmeow:regionSelector ;
        sh:maxCount 1 ;
        sh:class gmeow:RegionSelector ;
        sh:severity sh:Violation ;
        sh:message "An ImageRegion must have at most one selector." ;
    ] .

gmeow:RegionSelectorShape
    a sh:NodeShape ;
    rdfs:label "Region Selector Shape"@x-gmeow-english ;
    sh:targetClass gmeow:RegionSelector ;
    sh:property [
        sh:path gmeow:selectorType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:SelectorType ;
        sh:severity sh:Violation ;
        sh:message "A RegionSelector must specify exactly one selector type (gmeow:selectorType)." ;
    ] ;
    sh:property [
        sh:path gmeow:selectorValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        sh:message "A RegionSelector must specify exactly one literal selector value (gmeow:selectorValue)." ;
    ] .

gmeow:SceneGraphEdgeShape
    a sh:NodeShape ;
    rdfs:label "Scene Graph Edge Shape"@x-gmeow-english ;
    sh:targetClass gmeow:SceneGraphEdge ;
    sh:property [
        sh:path gmeow:sceneSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:ImageRegion ;
        sh:severity sh:Violation ;
        sh:message "A SceneGraphEdge must have exactly one subject region (gmeow:sceneSubject)." ;
    ] ;
    sh:property [
        sh:path gmeow:sceneObject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:ImageRegion ;
        sh:severity sh:Violation ;
        sh:message "A SceneGraphEdge must have exactly one object region (gmeow:sceneObject)." ;
    ] ;
    sh:property [
        sh:path gmeow:sceneRelation ;
        sh:minCount 1 ;
        sh:class gmeow:SceneRelationType ;
        sh:severity sh:Violation ;
        sh:message "A SceneGraphEdge must specify a relation (gmeow:sceneRelation)." ;
    ] ;
    sh:property [
        sh:path gmeow:sceneRelation ;
        sh:maxCount 1 ;
        sh:class gmeow:SceneRelationType ;
        sh:severity sh:Violation ;
        sh:message "A SceneGraphEdge must have at most one relation." ;
    ] ;
    sh:property [
        sh:path gmeow:sceneConfidence ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:severity sh:Violation ;
        sh:message "When present, gmeow:sceneConfidence must be a decimal in [0.0, 1.0]." ;
    ] .
# =========================================================================== #
# MediaObject colourspace warning (issue #22 follow-up)
# =========================================================================== #


# =========================================================================== #
# Calendar / Scheduling module (#62)
# =========================================================================== #

# An EventSchedule must anchor at least a template event or a recurrence rule.
gmeow:ScheduleHasRuleShape
    a sh:NodeShape ;
    rdfs:label "Schedule has rule or template shape"@x-gmeow-english ;
    sh:targetClass gmeow:EventSchedule ;
    sh:or (
        [ sh:path gmeow:scheduleTemplateEvent ; sh:minCount 1 ; sh:class gmeow:Event ]
        [ sh:path gmeow:scheduleRecurrenceRule ; sh:minCount 1 ; sh:class gmeow:RecurrenceRule ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "An EventSchedule must have at least one scheduleTemplateEvent or scheduleRecurrenceRule." .

# An EventInvitation must have at least one invitee and exactly one invitationStatus.
gmeow:InvitationHasInviteeAndStatusShape
    a sh:NodeShape ;
    rdfs:label "Invitation has invitee and status shape"@x-gmeow-english ;
    sh:targetClass gmeow:EventInvitation ;
    sh:property [
        sh:path gmeow:invitationEvent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Event ;
        sh:severity sh:Violation ;
        sh:message "An EventInvitation must have exactly one invitationEvent (Event)." ;
    ] ;
    sh:property [
        sh:path gmeow:invitationInvitee ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An EventInvitation must have at least one invitee (gmeow:invitationInvitee)." ;
    ] ;
    sh:property [
        sh:path gmeow:invitationStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:InvitationStatus ;
        sh:severity sh:Violation ;
        sh:message "An EventInvitation must have exactly one invitationStatus." ;
    ] .

# A Task must have exactly one taskStatus.
gmeow:TaskHasStatusShape
    a sh:NodeShape ;
    rdfs:label "Task has status shape"@x-gmeow-english ;
    sh:targetClass gmeow:Task ;
    sh:property [
        sh:path gmeow:taskStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:TaskStatus ;
        sh:severity sh:Violation ;
        sh:message "A Task must have exactly one taskStatus." ;
    ] .

# Suppression, never erasure (Principle 10): a cancelled occurrence should be
# suppressed rather than deleted. Warning — a source may lag on setting the flag.
gmeow:CancelledOccurrenceSuppressionShape
    a sh:NodeShape ;
    rdfs:label "Cancelled occurrence suppression shape"@x-gmeow-english ;
    sh:targetClass gmeow:Event ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "A cancelled occurrence (one with a ScheduleException of type exceptionTypeCancellation) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """
            SELECT $this WHERE {
                ?exception <https://blackcatinformatics.ca/gmeow/exceptionType> <https://blackcatinformatics.ca/gmeow/exceptionTypeCancellation> .
                ?exception <https://blackcatinformatics.ca/gmeow/exceptionSchedule> ?schedule .
                ?exception <https://blackcatinformatics.ca/gmeow/exceptionOriginalDate> ?date .
                ?schedule <https://blackcatinformatics.ca/gmeow/scheduleOccurrence> $this .
                $this <https://blackcatinformatics.ca/gmeow/eventTime> ?date .
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/displayable> false
                }
            }
        """ ;
    ] .

# An Availability must have exactly one slot and one status.
gmeow:AvailabilityHasIntervalAndStatusShape
    a sh:NodeShape ;
    rdfs:label "Availability has interval and status shape"@x-gmeow-english ;
    sh:targetClass gmeow:Availability ;
    sh:property [
        sh:path gmeow:availabilityAgent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Agent ;
        sh:severity sh:Violation ;
        sh:message "An Availability must have exactly one availabilityAgent (Agent)." ;
    ] ;
    sh:property [
        sh:path gmeow:availabilitySlot ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:TimeInterval ;
        sh:severity sh:Violation ;
        sh:message "An Availability must have exactly one availabilitySlot (TimeInterval)." ;
    ] ;
    sh:property [
        sh:path gmeow:availabilityStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:AvailabilityStatus ;
        sh:severity sh:Violation ;
        sh:message "An Availability must have exactly one availabilityStatus." ;
    ] .

# A Reminder must have exactly one trigger and one action.
gmeow:ReminderHasTriggerAndActionShape
    a sh:NodeShape ;
    rdfs:label "Reminder has trigger and action shape"@x-gmeow-english ;
    sh:targetClass gmeow:Reminder ;
    sh:property [
        sh:path gmeow:reminderTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Event ;
        sh:severity sh:Violation ;
        sh:message "A Reminder must have exactly one reminderTarget (Event)." ;
    ] ;
    sh:property [
        sh:path gmeow:reminderTrigger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:duration ]
            [ sh:datatype xsd:dateTime ]
        ) ;
        sh:severity sh:Violation ;
        sh:message "A Reminder must have exactly one reminderTrigger (xsd:duration or xsd:dateTime)." ;
    ] ;
    sh:property [
        sh:path gmeow:reminderAction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:ReminderAction ;
        sh:severity sh:Violation ;
        sh:message "A Reminder must have exactly one reminderAction." ;
    ] .

# A TimeZone must have exactly one IANA id.
gmeow:TimeZoneHasIanaIdShape
    a sh:NodeShape ;
    rdfs:label "Time zone has IANA id shape"@x-gmeow-english ;
    sh:targetClass gmeow:TimeZone ;
    sh:property [
        sh:path gmeow:timeZoneIanaId ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A TimeZone must have exactly one timeZoneIanaId." ;
    ] .

# --------------------------------------------------------------------------- #
# Teleology shapes (#350, EPIC #348) — goals, intentional modes, commitments.
# --------------------------------------------------------------------------- #
    # The beneficiary≠committedAgent distinctness MIGRATED to
    # logic:commitmentBeneficiaryDistinctness (generated/shapes/constraint-shapes.ttl, P17).

# gmeow:CounterGoalIrreflexiveShape MIGRATED to logic:counterGoalIrreflexivity,
# projected to generated/shapes/constraint-shapes.ttl (P17 single-source).
# --------------------------------------------------------------------------- #
# Aboutness guard (#349, EPIC #348) — the axis targets vocabulary IRIs.
# The vocabulary stays OPEN (Principle 9): the guard forbids literals, not
# unknown modes. DELIBERATELY no sh:class gmeow:AboutnessMode (PR #366
# review): these shapes validate instance-data graphs WITHOUT the module
# closure merged in, so a class constraint would flag every legitimate use
# of the kernel seeds (aboutnessDescribes / aboutnessEnacts — typed in the
# kernel module, not in data) and would force data graphs to re-type kernel
# vocabulary, which no other value-vocabulary shape requires.
# --------------------------------------------------------------------------- #

gmeow:AboutnessTargetShape
    a sh:NodeShape ;
    rdfs:label "Aboutness Target Shape"@x-gmeow-english ;
    sh:targetSubjectsOf gmeow:hasAboutness ;
    sh:property [
        sh:path gmeow:hasAboutness ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "gmeow:hasAboutness must target an AboutnessMode individual (an IRI), not a free literal." ;
    ] .

# --------------------------------------------------------------------------- #
# Norms shapes (#351 / #352, EPIC #348) — indexed authority, condition
# machinery, and the rights-graft modality invariants.
# --------------------------------------------------------------------------- #

gmeow:NormIssuerShape
    a sh:NodeShape ;
    rdfs:label "Norm Issuer Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Norm ;
    sh:property [
        sh:path gmeow:deonticModality ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Norm states at most one gmeow:deonticModality — a rule that both permits and obliges is two norms (functional, closed-world)." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A norm carrying a deontic modality must name at least one gmeow:normIssuer — there is no ought, only ought-according-to (no anonymous oughts, Principles 1/9)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/deonticModality> ?m .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/normIssuer> ?issuer . }
            }
        """ ;
    ] .
    # The overrides irreflexivity MIGRATED to logic:overridesIrreflexivity
    # (generated/shapes/constraint-shapes.ttl, P17).

gmeow:ConditionShape
    a sh:NodeShape ;
    rdfs:label "Condition Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Condition ;
    sh:property [
        sh:path gmeow:conditionText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A Condition must carry exactly one gmeow:conditionText — prose is the canonical form." ;
    ] .

gmeow:ConditionGroupShape
    a sh:NodeShape ;
    rdfs:label "Condition Group Shape"@x-gmeow-english ;
    sh:targetClass gmeow:ConditionGroup ;
    sh:property [
        sh:path gmeow:groupOperator ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( gmeow:operatorAll gmeow:operatorAny gmeow:operatorNone ) ;
        sh:severity sh:Violation ;
        sh:message "A ConditionGroup must declare exactly one gmeow:groupOperator (all / any / none — a CLOSED vocabulary, hence sh:in)." ;
    ] ;
    sh:property [
        sh:path gmeow:groupMember ;
        sh:minCount 2 ;
        sh:severity sh:Violation ;
        sh:message "A ConditionGroup must have at least two gmeow:groupMember conditions — a one-member group is just the member." ;
    ] .

gmeow:ConditionExpressionShape
    a sh:NodeShape ;
    rdfs:label "Condition Expression Shape"@x-gmeow-english ;
    sh:targetClass gmeow:ConditionExpression ;
    sh:property [
        sh:path gmeow:expressionText ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ConditionExpression must carry exactly one gmeow:expressionText." ;
    ] ;
    sh:property [
        sh:path gmeow:expressionLanguage ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A ConditionExpression must name exactly one gmeow:expressionLanguage as an IRI. DELIBERATELY no sh:in (PR #369 review): the language vocabulary is OPEN (new engines join without schema change, Principle 9) — the aboutness-guard convention." ;
    ] .

gmeow:ConditionParameterShape
    a sh:NodeShape ;
    rdfs:label "Condition Parameter Shape"@x-gmeow-english ;
    sh:targetClass gmeow:ConditionParameter ;
    sh:property [
        sh:path gmeow:parameterName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ConditionParameter must carry exactly one gmeow:parameterName." ;
    ] ;
    sh:xone (
        [ sh:property [ sh:path gmeow:parameterValue ;  sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] ;
          sh:property [ sh:path gmeow:parameterEntity ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gmeow:parameterEntity ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
          sh:property [ sh:path gmeow:parameterValue ;  sh:maxCount 0 ] ]
    ) ;
    sh:message "A ConditionParameter binds exactly one of gmeow:parameterValue (literal) or gmeow:parameterEntity (IRI)." .

gmeow:PrecedenceTenureShape
    a sh:NodeShape ;
    rdfs:label "Precedence Tenure Shape"@x-gmeow-english ;
    sh:targetClass gmeow:PrecedenceTenure ;
    sh:property [
        sh:path gmeow:precedenceHigher ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Norm ;
        sh:severity sh:Violation ;
        sh:message "A PrecedenceTenure must record exactly one gmeow:precedenceHigher norm." ;
    ] ;
    sh:property [
        sh:path gmeow:precedenceLower ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:Norm ;
        sh:severity sh:Violation ;
        sh:message "A PrecedenceTenure must record exactly one gmeow:precedenceLower norm." ;
    ] ;
    sh:property [
        sh:path gmeow:precedenceScope ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:NormativeSystem ;
        sh:severity sh:Violation ;
        sh:message "A PrecedenceTenure must be scoped to exactly one gmeow:precedenceScope normative system — precedence is always scoped." ;
    ] .
    # The higher≠lower distinctness MIGRATED to logic:precedenceTenureDistinctness
    # (generated/shapes/constraint-shapes.ttl, P17).
gmeow:ComplianceAssessmentShape
    a sh:NodeShape ;
    rdfs:label "Compliance Assessment Shape"@x-gmeow-english ;
    sh:targetClass gmeow:ComplianceAssessment ;
    sh:property [
        sh:path gmeow:assessedEvent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ComplianceAssessment must assess exactly one gmeow:assessedEvent." ;
    ] ;
    sh:property [
        sh:path gmeow:assessedNorm ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ComplianceAssessment must assess against exactly one gmeow:assessedNorm." ;
    ] ;
    sh:property [
        sh:path gmeow:complianceVerdict ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ComplianceAssessment must carry exactly one gmeow:complianceVerdict." ;
    ] ;
    sh:property [
        sh:path gmeow:vantage ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ComplianceAssessment must name its assessor vantage — violation is always somebody's judgement (Principle 9)." ;
    ] .

# Rights-graft modality invariants (#352): each subkind of the deontic trio
# fixes its effective modality. Carrying none is fine (the subkind IS the
# modality); carrying the wrong one is a contradiction-in-data. These shapes
# only ever fire when the norms extension's vocabulary is in use, so the
# core-only behaviour of the rights slice is untouched.
gmeow:GraftPermissionModalityShape
    a sh:NodeShape ;
    rdfs:label "Graft: Permission Modality Invariant"@x-gmeow-english ;
    sh:targetClass gmeow:Permission ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A Permission's deontic modality, when stated, must be gmeow:deonticPermission — the subkind fixes the modality (#352)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/deonticModality> ?m .
                FILTER(?m != <https://blackcatinformatics.ca/gmeow/deonticPermission>)
            }
        """ ;
    ] .

gmeow:GraftProhibitionModalityShape
    a sh:NodeShape ;
    rdfs:label "Graft: Prohibition Modality Invariant"@x-gmeow-english ;
    sh:targetClass gmeow:Prohibition ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A Prohibition's deontic modality, when stated, must be gmeow:deonticProhibition — the subkind fixes the modality (#352)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/deonticModality> ?m .
                FILTER(?m != <https://blackcatinformatics.ca/gmeow/deonticProhibition>)
            }
        """ ;
    ] .

gmeow:GraftDutyModalityShape
    a sh:NodeShape ;
    rdfs:label "Graft: Duty Modality Invariant"@x-gmeow-english ;
    sh:targetClass gmeow:Duty ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A Duty's deontic modality, when stated, must be gmeow:deonticObligation — the subkind fixes the modality (#352)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/deonticModality> ?m .
                FILTER(?m != <https://blackcatinformatics.ca/gmeow/deonticObligation>)
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Narration seam shapes (#360, EPIC #358) — reify only with a reason.
# --------------------------------------------------------------------------- #

gmeow:NarrationUsageShape
    a sh:NodeShape ;
    rdfs:label "Narration Usage Shape"@x-gmeow-english ;
    sh:targetClass gmeow:NarrationUsage ;
    sh:property [
        sh:path gmeow:narrationSegment ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:ContentSegment ;
        sh:severity sh:Violation ;
        sh:message "A NarrationUsage must carry exactly one gmeow:narrationSegment." ;
    ] ;
    sh:property [
        sh:path gmeow:narrationSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A NarrationUsage must carry exactly one gmeow:narrationSubject — one relator per (segment, subject) pair." ;
    ] ;
    sh:property [
        sh:path gmeow:narrationMode ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A NarrationUsage must state at least one gmeow:narrationMode (an IRI — the vocabulary is OPEN per Principle 9, so no sh:class/sh:in: the aboutness-guard convention) — if you reified, you had a reason; the modeless case is the flat gmeow:narrates shortcut (efficiency doctrine, #360)." ;
    ] .

# --------------------------------------------------------------------------- #
# Rubrics shapes (#353, EPIC #348) — reified evaluation frameworks.
# --------------------------------------------------------------------------- #

gmeow:CriterionShape
    a sh:NodeShape ;
    rdfs:label "Criterion Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Criterion ;
    sh:property [
        sh:path gmeow:rewardPole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:CriterionPole ;
        sh:severity sh:Violation ;
        sh:message "A Criterion must name exactly one gmeow:rewardPole, a CriterionPole — the named-poles contract: no poles is no axis." ;
    ] ;
    sh:property [
        sh:path gmeow:penaltyPole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:CriterionPole ;
        sh:severity sh:Violation ;
        sh:message "A Criterion must name exactly one gmeow:penaltyPole, a CriterionPole — the named-poles contract: no poles is no axis." ;
    ] .
    # The reward≠penalty pole distinctness MIGRATED to logic:criterionPoleDistinctness
    # (generated/shapes/constraint-shapes.ttl, P17).

gmeow:ScoreScaleShape
    a sh:NodeShape ;
    rdfs:label "Score Scale Shape"@x-gmeow-english ;
    sh:targetClass gmeow:ScoreScale ;
    sh:property [
        sh:path gmeow:scaleMin ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "A ScoreScale must declare exactly one decimal gmeow:scaleMin." ;
    ] ;
    sh:property [
        sh:path gmeow:scaleMax ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "A ScoreScale must declare exactly one decimal gmeow:scaleMax." ;
    ] ;
    sh:property [
        sh:path gmeow:scaleStep ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "A ScoreScale carries at most one decimal gmeow:scaleStep (closed-world functional)." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ScoreScale's minimum must be strictly below its maximum." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/scaleMin> ?min .
                $this <https://blackcatinformatics.ca/gmeow/scaleMax> ?max .
                FILTER(?min >= ?max)
            }
        """ ;
    ] .

gmeow:ScoreAnchorShape
    a sh:NodeShape ;
    rdfs:label "Score Anchor Shape"@x-gmeow-english ;
    sh:targetClass gmeow:ScoreAnchor ;
    sh:property [
        sh:path gmeow:anchorMeaning ;
        sh:minCount 1 ;
        sh:uniqueLang true ;
        sh:severity sh:Violation ;
        sh:message "A ScoreAnchor must carry at least one gmeow:anchorMeaning, at most one per language tag — an anchor without a meaning is just an interval (localizable prose, PR #376 review)." ;
    ] ;
    sh:property [
        sh:path gmeow:anchorRangeMin ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "A ScoreAnchor must pin exactly one decimal gmeow:anchorRangeMin — an anchor IS a pinned range." ;
    ] ;
    sh:property [
        sh:path gmeow:anchorRangeMax ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "A ScoreAnchor must pin exactly one decimal gmeow:anchorRangeMax — an anchor IS a pinned range." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ScoreAnchor's range minimum must not exceed its range maximum." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/anchorRangeMin> ?min .
                $this <https://blackcatinformatics.ca/gmeow/anchorRangeMax> ?max .
                FILTER(?min > ?max)
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A ScoreAnchor's range must lie within the scale its criterion (or owning rubric) declares." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                ?criterion <https://blackcatinformatics.ca/gmeow/hasScoreAnchor> $this .
                {
                    ?criterion <https://blackcatinformatics.ca/gmeow/usesScale> ?scale .
                } UNION {
                    ?rubric <https://blackcatinformatics.ca/gmeow/hasCriterion> ?criterion ;
                            <https://blackcatinformatics.ca/gmeow/usesScale> ?scale .
                    FILTER NOT EXISTS { ?criterion <https://blackcatinformatics.ca/gmeow/usesScale> ?ownScale . }
                }
                ?scale <https://blackcatinformatics.ca/gmeow/scaleMin> ?smin ;
                       <https://blackcatinformatics.ca/gmeow/scaleMax> ?smax .
                $this <https://blackcatinformatics.ca/gmeow/anchorRangeMin> ?amin ;
                      <https://blackcatinformatics.ca/gmeow/anchorRangeMax> ?amax .
                FILTER(?amin < ?smin || ?amax > ?smax)
            }
        """ ;
    ] .

gmeow:ExemplarShape
    a sh:NodeShape ;
    rdfs:label "Exemplar Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Exemplar ;
    sh:property [
        sh:path gmeow:exemplarPolarity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( gmeow:polarityPositive gmeow:polarityNegative gmeow:polarityCautionary ) ;
        sh:severity sh:Violation ;
        sh:message "An Exemplar must state exactly one gmeow:exemplarPolarity (positive / negative / cautionary — a CLOSED vocabulary, hence sh:in)." ;
    ] ;
    sh:property [
        sh:path gmeow:citingEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Exemplar (a CitationAct) must have exactly one gmeow:citingEntity — restated here because closed-world targeting does not inherit." ;
    ] ;
    sh:property [
        sh:path gmeow:citedEntity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Exemplar (a CitationAct) must have exactly one gmeow:citedEntity." ;
    ] ;
    sh:property [
        sh:path gmeow:citationIntent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Exemplar (a CitationAct) must specify exactly one gmeow:citationIntent." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A cautionary redirect must point AWAY: an exemplar may not redirect to the criterion that anchors it." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/exemplarRedirect> ?criterion .
                ?criterion <https://blackcatinformatics.ca/gmeow/hasScoreAnchor> ?anchor .
                ?anchor <https://blackcatinformatics.ca/gmeow/anchorExemplar> $this .
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An Exemplar must pin its evidence: at least one of gmeow:viaSelector (a span) or gmeow:exemplarSubject (an entity whose pattern is the example)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/viaSelector> ?sel . }
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/exemplarSubject> ?subj . }
            }
        """ ;
    ] .

gmeow:UsesScaleTargetShape
    a sh:NodeShape ;
    rdfs:label "Uses Scale Target Shape"@x-gmeow-english ;
    sh:targetSubjectsOf gmeow:usesScale ;
    sh:property [
        sh:path gmeow:usesScale ;
        sh:maxCount 1 ;
        sh:class gmeow:ScoreScale ;
        sh:severity sh:Violation ;
        sh:message "A holder binds at most one gmeow:usesScale, a ScoreScale — two scales make anchor containment and score interpretation ambiguous (closed-world functional)." ;
    ] .

gmeow:AssessmentShape
    a sh:NodeShape ;
    rdfs:label "Assessment Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Assessment ;
    sh:property [
        sh:path gmeow:assessmentTarget ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Assessment must score exactly one gmeow:assessmentTarget." ;
    ] ;
    sh:property [
        sh:path gmeow:assessmentScoreValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "An Assessment must carry exactly one decimal gmeow:assessmentScoreValue — a zero is a score, not an absence." ;
    ] ;
    sh:property [
        sh:path gmeow:vantage ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Assessment must name its judge vantage — a score is somebody's observation, never a graph fact (Principle 9)." ;
    ] ;
    sh:property [
        sh:path gmeow:assessmentCriterion ;
        sh:maxCount 1 ;
        sh:class gmeow:Criterion ;
        sh:severity sh:Violation ;
        sh:message "An Assessment applies at most one gmeow:assessmentCriterion, a Criterion — a 21-axis pass is 21 Assessments (closed-world functional)." ;
    ] ;
    sh:property [
        sh:path gmeow:assessmentRubric ;
        sh:maxCount 1 ;
        sh:class gmeow:Rubric ;
        sh:severity sh:Violation ;
        sh:message "An Assessment is made under at most one gmeow:assessmentRubric, a Rubric (closed-world functional)." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An Assessment must name what it applies: a gmeow:assessmentCriterion, a gmeow:assessmentRubric, or both." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/assessmentCriterion> ?c . }
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/assessmentRubric> ?r . }
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Registers & personas shapes (#355, EPIC #348).
# --------------------------------------------------------------------------- #
gmeow:StyleGuideShape
    a sh:NodeShape ;
    rdfs:label "Style Guide Shape"@x-gmeow-english ;
    sh:targetClass gmeow:StyleGuide ;
    sh:property [
        sh:path gmeow:styleGuideFor ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A StyleGuide must voice at least one gmeow:styleGuideFor target (a Persona or a Register) — a style guide for nothing is just a document." ;
    ] ;
    sh:property [
        sh:path gmeow:voiceExemplifiedBy ;
        sh:node [
            sh:property [
                sh:path gmeow:contentDigest ;
                sh:minCount 1 ;
                sh:severity sh:Violation ;
                sh:message "A voice exemplar document must carry gmeow:contentDigest — an undigested exemplar can drift silently." ;
            ] ;
        ] ;
        sh:severity sh:Violation ;
        sh:message "Every gmeow:voiceExemplifiedBy document must carry a gmeow:contentDigest (byte-perfect voice doctrine)." ;
    ] .

gmeow:OrganizationCurrencyShape
    a sh:NodeShape ;
    rdfs:label "Organization Currency Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Organization ;
    sh:property [
        # open-vocabulary contract: the value is an IRI whose frameRealm IS the
        # currency realm — NO sh:class, which would force data graphs to restate
        # the frame's TBox typing in the raw-graph lane.
        sh:path gmeow:acceptsCurrency ;
        sh:nodeKind sh:IRI ;
        sh:node [
            sh:property [
                sh:path gmeow:frameRealm ;
                sh:hasValue gmeow:frameRealmCurrency ;
                sh:severity sh:Violation ;
                sh:message "A gmeow:acceptsCurrency value must be in the currency realm (gmeow:frameRealm gmeow:frameRealmCurrency)." ;
            ] ;
        ] ;
        sh:severity sh:Violation ;
        sh:message "Each gmeow:acceptsCurrency value must be a currency reference frame in gmeow:frameRealmCurrency (e.g. gmeow:referenceFrameUSD), not an arbitrary reference frame." ;
    ] .

# --------------------------------------------------------------------------- #
# Risk shapes (#354, EPIC #348) — types never tokens; reify with a reason.
# --------------------------------------------------------------------------- #

gmeow:HazardShape
    a sh:NodeShape ;
    rdfs:label "Hazard Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Hazard ;
    sh:property [
        sh:path gmeow:hazardBearer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A Hazard must inhere in exactly one gmeow:hazardBearer — the same danger borne by two systems is two hazards." ;
    ] ;
    sh:property [
        sh:path gmeow:manifestedAsType ;
        sh:minCount 1 ;
        sh:class gmeow:EventType ;
        sh:severity sh:Violation ;
        sh:message "A Hazard must name at least one feared gmeow:manifestedAsType, an EventType — the type level is where counterfactuals live without machinery." ;
    ] ;
    sh:property [
        sh:path gmeow:hazardSeverity ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A Hazard carries at most one gmeow:hazardSeverity (closed-world functional)." ;
    ] .

gmeow:CausalLinkShape
    a sh:NodeShape ;
    rdfs:label "Causal Link Shape"@x-gmeow-english ;
    sh:targetClass gmeow:CausalLink ;
    sh:property [
        sh:path gmeow:linkAntecedent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:EventType ;
        sh:severity sh:Violation ;
        sh:message "A CausalLink must have exactly one gmeow:linkAntecedent, an EventType." ;
    ] ;
    sh:property [
        sh:path gmeow:linkConsequent ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:EventType ;
        sh:severity sh:Violation ;
        sh:message "A CausalLink must have exactly one gmeow:linkConsequent, an EventType." ;
    ] ;
    sh:property [
        sh:path gmeow:causalModality ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A CausalLink must state exactly one gmeow:causalModality (an IRI — the vocabulary is OPEN per Principle 9): if you reified, you had a reason." ;
    ] ;
    sh:property [
        sh:path gmeow:linkStrength ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "A CausalLink carries at most one decimal gmeow:linkStrength per base graph (single-valued in SHACL, deliberately not OWL-functional — divergent estimates ride the statement layer)." ;
    ] ;
    sh:property [
        sh:path gmeow:linkMechanism ;
        sh:uniqueLang true ;
        sh:severity sh:Violation ;
        sh:message "A CausalLink carries at most one gmeow:linkMechanism per language tag (localizable prose, the #376 convention)." ;
    ] .
    # The antecedent≠consequent distinctness and the linkNext acyclicity MIGRATED to
    # logic:causalLinkDistinctness and logic:linkNextAcyclicity
    # (generated/shapes/constraint-shapes.ttl, P17).

gmeow:CascadeShape
    a sh:NodeShape ;
    rdfs:label "Cascade Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Cascade ;
    sh:property [
        sh:path gmeow:cascadeFirstLink ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:CausalLink ;
        sh:severity sh:Violation ;
        sh:message "A Cascade must enter at exactly one gmeow:cascadeFirstLink, a CausalLink." ;
    ] ;
    sh:property [
        sh:path gmeow:cascadeSeverity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A Cascade must carry exactly one gmeow:cascadeSeverity (an IRI) — an ungraded cascade is just a story." ;
    ] .

gmeow:MitigationShape
    a sh:NodeShape ;
    rdfs:label "Mitigation Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Mitigation ;
    sh:property [
        sh:path gmeow:mitigationMeasure ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A Mitigation must bind at least one gmeow:mitigationMeasure (an IRI — the range is deliberately open across the deontic and procedural worlds, P16)." ;
    ] ;
    sh:property [
        sh:path gmeow:mitigationCounters ;
        sh:minCount 1 ;
        sh:or ( [ sh:class gmeow:CausalLink ] [ sh:class gmeow:Hazard ] ) ;
        sh:severity sh:Violation ;
        sh:message "A Mitigation must counter at least one risk factor — a CausalLink (barrier on the chain) or a Hazard (control at the source). sh:or over the concrete classes, not sh:class RiskFactor: data graphs type instances concretely and raw-graph SHACL does no subclass inference." ;
    ] ;
    sh:property [
        sh:path gmeow:mitigationStatus ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A Mitigation carries at most one gmeow:mitigationStatus (closed-world functional; open vocabulary)." ;
    ] .

# --------------------------------------------------------------------------- #
# Affect shapes (#356, EPIC #348) — thin slice, thin shapes.
# --------------------------------------------------------------------------- #
gmeow:AffectiveExperienceShape
    a sh:NodeShape ;
    rdfs:label "Affective Experience Shape"@x-gmeow-english ;
    sh:targetClass gmeow:AffectiveExperience ;
    sh:property [
        sh:path gmeow:experiencer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An AffectiveExperience must have exactly one gmeow:experiencer — the agent undergoing the felt episode (a mental occurrent inheres in exactly one agent)." ;
    ] ;
    sh:property [
        sh:path gmeow:mentalProcessType ;
        sh:hasValue gmeow:processAffectiveExperience ;
        sh:severity sh:Violation ;
        sh:message "An AffectiveExperience must carry gmeow:mentalProcessType gmeow:processAffectiveExperience (the pinned occurrent kind — assert it explicitly; SHACL does not infer the OWL hasValue restriction)." ;
    ] ;
    sh:property [
        sh:path gmeow:feltAffect ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An AffectiveExperience must realize at least one affective mode via gmeow:feltAffect (an IRI — a felt episode realizes some gmeow:AffectiveMoment by definition)." ;
    ] .

gmeow:AppraisalShape
    a sh:NodeShape ;
    rdfs:label "Appraisal Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Appraisal ;
    sh:property [
        sh:path gmeow:appraisalOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Appraisal must read exactly one gmeow:appraisalOf subject." ;
    ] ;
    sh:property [
        sh:path gmeow:vantage ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An Appraisal must name its appraiser vantage — a reading is somebody's cell, never a graph fact (Principle 9)." ;
    ] ;
    sh:property [
        sh:path gmeow:appraisalDimension ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An Appraisal reads at most one gmeow:appraisalDimension — a PAD triple is three Appraisals sharing a vantage." ;
    ] ;
    sh:property [
        sh:path gmeow:appraisalQuality ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "gmeow:appraisalQuality targets vocabulary IRIs (the open AestheticQuality vocabulary) — never literals or blank nodes." ;
    ] ;
    sh:property [
        sh:path gmeow:appraisalValue ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "An Appraisal carries at most one decimal gmeow:appraisalValue, with its dimension AND its scale profile." ;
    ] ;
    sh:property [
        sh:path gmeow:appraisalScaleProfile ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class gmeow:AffectScaleProfile ;
        sh:severity sh:Violation ;
        sh:message "gmeow:appraisalScaleProfile names exactly one gmeow:AffectScaleProfile IRI — never a literal, a blank node, or a non-profile IRI (the reshape's frame must actually be a frame, Principle 6)." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A dimensional appraisal reading is unframed: gmeow:appraisalValue requires a gmeow:appraisalScaleProfile (the greenfield reshape removed the bare-decimal floor — an unframed magnitude is ill-formed, Principle 6/11)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/appraisalValue> ?v .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/appraisalScaleProfile> ?p . }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An Appraisal must read SOMETHING: a dimensional value (dimension + value) or at least one aesthetic quality." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://blackcatinformatics.ca/gmeow/Appraisal> .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/appraisalQuality> ?q . }
                FILTER NOT EXISTS {
                    $this <https://blackcatinformatics.ca/gmeow/appraisalDimension> ?d .
                    $this <https://blackcatinformatics.ca/gmeow/appraisalValue> ?v .
                }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A dimensional value needs its dimension (and a dimension its value) — half a reading is no reading." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                { $this <https://blackcatinformatics.ca/gmeow/appraisalValue> ?v .
                  FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/appraisalDimension> ?d . } }
                UNION
                { $this <https://blackcatinformatics.ca/gmeow/appraisalDimension> ?d .
                  FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/appraisalValue> ?v . } }
            }
        """ ;
    ] .

gmeow:AffectScaleProfileShape
    a sh:NodeShape ;
    rdfs:label "Affect Scale Profile Shape"@x-gmeow-english ;
    sh:targetClass gmeow:AffectScaleProfile ;
    sh:property [
        sh:path gmeow:profileRangeMin ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "An AffectScaleProfile must declare exactly one gmeow:profileRangeMin — a frame with no range declares nothing (Principle 11)." ;
    ] ;
    sh:property [
        sh:path gmeow:profileRangeMax ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "An AffectScaleProfile must declare exactly one gmeow:profileRangeMax — a frame with no range declares nothing (Principle 11)." ;
    ] ;
    sh:property [
        sh:path gmeow:profilePolarity ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "gmeow:profilePolarity names at most one gmeow:ScalePolarity IRI (open vocabulary — never a literal)." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "An AffectScaleProfile is degenerate: gmeow:profileRangeMax must strictly exceed gmeow:profileRangeMin — an inverted or empty range frames nothing (Principle 11)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/profileRangeMin> ?min .
                $this <https://blackcatinformatics.ca/gmeow/profileRangeMax> ?max .
                FILTER ( ?min >= ?max )
            }
        """ ;
    ] .

gmeow:AffectVectorObservationShape
    a sh:NodeShape ;
    rdfs:label "Affect Vector Observation Shape"@x-gmeow-english ;
    sh:targetClass gmeow:AffectVectorObservation ;
    sh:property [
        sh:path gmeow:vectorProfile ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An AffectVectorObservation must name exactly one gmeow:vectorProfile (its metric/basis) — a vector with no declared basis is uninterpretable (Principle 11)." ;
    ] ;
    sh:property [
        sh:path gmeow:vectorComponent ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An AffectVectorObservation must group at least one gmeow:vectorComponent (a per-axis Appraisal cell) — an empty vector is no reading." ;
    ] .

gmeow:AffectCompositeShape
    a sh:NodeShape ;
    rdfs:label "Affect Composite Shape"@x-gmeow-english ;
    sh:targetClass gmeow:AffectComposite ;
    sh:property [
        sh:path gmeow:affectiveConstituent ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An AffectComposite must declare at least one gmeow:affectiveConstituent — a named compound with no decomposition is a forbidden unanalyzed primitive (model up from axes, or add the missing axis)." ;
    ] .

gmeow:DerivedAffectIntensityObservationShape
    a sh:NodeShape ;
    rdfs:label "Derived Affect Intensity Observation Shape"@x-gmeow-english ;
    sh:targetClass gmeow:DerivedAffectIntensityObservation ;
    sh:property [
        sh:path gmeow:intensityBasis ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A derived affect intensity must declare its gmeow:intensityBasis (the AffectVectorObservation it is the norm of) — a floating intensity with no basis is a hard fail (Principle 12)." ;
    ] ;
    sh:property [
        sh:path gmeow:metricProfile ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A derived affect intensity must declare its gmeow:metricProfile (scale normalization) — an intensity with no declared scale is a hard fail." ;
    ] ;
    sh:property [
        sh:path gmeow:weightingPolicy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A derived affect intensity must declare its gmeow:weightingPolicy — the basis is non-orthogonal, so the weighting is an explicit, machine-readable gmeow:WeightingPolicy IRI, never assumed and never a free-text string." ;
    ] ;
    sh:property [
        sh:path gmeow:normFunction ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A derived affect intensity must declare its gmeow:normFunction (the math:Norm) — a raw L² over the non-orthogonal affect basis is not a default; the metric is an explicit, grounded math:Norm IRI or it is a hard fail." ;
    ] ;
    sh:property [
        sh:path gmeow:appraisalValue ;
        sh:maxCount 0 ;
        sh:severity sh:Violation ;
        sh:message "A derived affect intensity must NOT carry a stored magnitude (gmeow:appraisalValue) — the norm is a recomputable derived view, never a stored ground fact (Principle 12); a stored intensity value is a hard fail." ;
    ] .

gmeow:ModelInferenceRunShape
    a sh:NodeShape ;
    rdfs:label "Model Inference Run Shape"@x-gmeow-english ;
    sh:targetClass gmeow:ModelInferenceRun ;
    sh:property [
        sh:path gmeow:modelIdentifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ModelInferenceRun must declare exactly one gmeow:modelIdentifier (the model repo id) — run provenance is mandatory and single-valued." ;
    ] ;
    sh:property [
        sh:path gmeow:modelRevision ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A ModelInferenceRun must declare exactly one pinned gmeow:modelRevision — a model name without a single pinned revision fails reproducibility (a hard fail)." ;
    ] .

gmeow:AffectClassifierLabelShape
    a sh:NodeShape ;
    rdfs:label "Affect Classifier Label Shape"@x-gmeow-english ;
    sh:targetClass gmeow:AffectClassifierLabel ;
    sh:property [
        sh:path gmeow:memberOfLabelSet ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An AffectClassifierLabel must be registered in a gmeow:AffectLabelSet via gmeow:memberOfLabelSet — an unregistered label fails canonical projection." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A classifier label must not be modeled as a gmeow:EmotionType — 'neutral' (or any no-detected-affect label) as an EmotionType is a hard fail; labels are external identities, never canonical emotion vocabulary." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://blackcatinformatics.ca/gmeow/AffectClassifierLabel> .
                $this a <https://blackcatinformatics.ca/gmeow/EmotionType> .
            }
        """ ;
    ] .

gmeow:AffectClassifierOutputShape
    a sh:NodeShape ;
    rdfs:label "Affect Classifier Output Shape"@x-gmeow-english ;
    sh:targetClass gmeow:AffectClassifierOutput ;
    sh:property [
        sh:path gmeow:producedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An AffectClassifierOutput must be gmeow:producedBy exactly one gmeow:ModelInferenceRun — output provenance is mandatory." ;
    ] ;
    sh:property [
        sh:path gmeow:classifiedTarget ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An AffectClassifierOutput must name its gmeow:classifiedTarget (the span classified) — an output with no target is unmoored evidence." ;
    ] ;
    sh:property [
        sh:path gmeow:emittedLabel ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An AffectClassifierOutput must carry a gmeow:emittedLabel (a registered gmeow:AffectClassifierLabel IRI)." ;
    ] ;
    sh:property [
        sh:path gmeow:classifierScore ;
        sh:minCount 1 ;
        sh:datatype xsd:decimal ;
        sh:severity sh:Violation ;
        sh:message "An AffectClassifierOutput must carry a raw gmeow:classifierScore." ;
    ] ;
    sh:property [
        sh:path gmeow:scoreSemantics ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An AffectClassifierOutput must declare exactly one gmeow:scoreSemantics (sigmoid/softmax/…) — a bare or ambiguous score meaning is uninterpretable." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A score claimed as a calibrated probability requires a gmeow:scoreCalibration profile — a raw sigmoid/softmax score stored as a confidence without calibration metadata is a hard fail (confidence is not a probability without a declared mapping)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/scoreSemantics> <https://blackcatinformatics.ca/gmeow/scoreCalibratedProbability> .
                FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/scoreCalibration> ?c . }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A classifier output must not directly assert inner affect (gmeow:emotionType / gmeow:emotionBearer) — it supports a gmeow:AffectiveClaim by gmeow:supportsAffectiveClaim (evidence, never entailment); asserting inner affect without the claim boundary is a hard fail." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this a <https://blackcatinformatics.ca/gmeow/AffectClassifierOutput> .
                { $this <https://blackcatinformatics.ca/gmeow/emotionType> ?e . }
                UNION
                { $this <https://blackcatinformatics.ca/gmeow/emotionBearer> ?b . }
            }
        """ ;
    ] .

# Label-set exclusivity twins — RELATIONAL invariants no OWL restriction can hold, so
# hand-authored sh:sparql here.
#
# gmeow:AffectDecision's cardinality/functional bounds are authored in the REASONING LAYER
# (slices/core/affect/module.ttl: gmeow:decidedLabel / gmeow:decisionCrossedThreshold /
# gmeow:observedFeature owl:cardinality 1; gmeow:vantage / gmeow:derivedByFunction
# owl:minQualifiedCardinality 1) and PROJECTED to generated/shapes/validation-shapes.ttl
# (Principle 17) as sh:minCount/maxCount 1 and sh:qualifiedMinCount 1. Those projected shapes
# ARE enforced via the live production shape union (purrdf::shapes::shape_union::load_shapes,
# what `gmeow validate` / `stage-validate` run), so the mandatory + single-valued structure of
# a decision is a genuine on-gate hard fail there — it is NOT re-stated by hand here. Only the
# relational argmax-set invariant that no OWL restriction can express — a decision may only be
# recorded over a single-label (gmeow:decisionArgmax) set — is hand-authored below.

gmeow:AffectDecisionShape
    a sh:NodeShape ;
    rdfs:label "Affect Decision Shape"@x-gmeow-english ;
    sh:targetClass gmeow:AffectDecision ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A gmeow:AffectDecision may only be recorded over a single-label (gmeow:decisionArgmax) label set — a categorical argmax decision over a multi-label set has no single winner (a hard fail)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/decidedLabel> ?label .
                ?label <https://blackcatinformatics.ca/gmeow/memberOfLabelSet> ?set .
                ?set <https://blackcatinformatics.ca/gmeow/labelSetDecision> ?rule .
                FILTER(?rule != <https://blackcatinformatics.ca/gmeow/decisionArgmax>)
            }
        """ ;
    ] .

gmeow:AffectDecisionRuleConsistencyShape
    a sh:NodeShape ;
    rdfs:label "Affect Decision Rule Consistency Shape"@x-gmeow-english ;
    sh:targetClass gmeow:AffectClassifierOutput ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A classifier output's gmeow:scoreSemantics implies a label-set decision rule (softmax → argmax, sigmoid → independent-threshold) that MUST match its emitted label's set gmeow:labelSetDecision — a softmax score over a multi-label set (or a sigmoid over an exclusive set) is an inconsistency (a hard fail)." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/scoreSemantics> ?sem ;
                      <https://blackcatinformatics.ca/gmeow/emittedLabel> ?label .
                ?sem <https://blackcatinformatics.ca/gmeow/impliesLabelSetDecision> ?implied .
                ?label <https://blackcatinformatics.ca/gmeow/memberOfLabelSet> ?set .
                ?set <https://blackcatinformatics.ca/gmeow/labelSetDecision> ?declared .
                FILTER(?implied != ?declared)
            }
        """ ;
    ] .

gmeow:ExclusiveClaimShape
    a sh:NodeShape ;
    rdfs:label "Exclusive Claim Shape"@x-gmeow-english ;
    sh:targetClass gmeow:AffectiveClaim ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "At most one gmeow:AffectiveClaim may be routed over one target from a single-label (gmeow:decisionArgmax) classifier run — a threshold policy admitting two mutually-exclusive claims over an exclusive label set is a hard fail." ;
        sh:severity sh:Violation ;
        sh:select """
            SELECT $this WHERE {
                $this <https://blackcatinformatics.ca/gmeow/observedFeature> ?target .
                ?out1 <https://blackcatinformatics.ca/gmeow/supportsAffectiveClaim> $this ;
                      <https://blackcatinformatics.ca/gmeow/producedBy> ?run ;
                      <https://blackcatinformatics.ca/gmeow/emittedLabel> ?l1 .
                ?l1 <https://blackcatinformatics.ca/gmeow/memberOfLabelSet> ?set .
                ?set <https://blackcatinformatics.ca/gmeow/labelSetDecision> <https://blackcatinformatics.ca/gmeow/decisionArgmax> .
                ?other a <https://blackcatinformatics.ca/gmeow/AffectiveClaim> ;
                       <https://blackcatinformatics.ca/gmeow/observedFeature> ?target .
                FILTER(?other != $this)
                ?out2 <https://blackcatinformatics.ca/gmeow/supportsAffectiveClaim> ?other ;
                      <https://blackcatinformatics.ca/gmeow/producedBy> ?run ;
                      <https://blackcatinformatics.ca/gmeow/emittedLabel> ?l2 .
                ?l2 <https://blackcatinformatics.ca/gmeow/memberOfLabelSet> ?set .
            }
        """ ;
    ] .

# --------------------------------------------------------------------------- #
# Narrative-interior shapes (#361 / #362 / #363, EPIC #358).
# --------------------------------------------------------------------------- #

gmeow:ArcSampleShape
    a sh:NodeShape ;
    rdfs:label "Arc Sample Shape"@x-gmeow-english ;
    sh:targetClass gmeow:ArcSample ;
    sh:property [
        sh:path gmeow:sampleSubject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An ArcSample must read exactly one gmeow:sampleSubject." ;
    ] ;
    sh:property [
        sh:path gmeow:samplePosition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gmeow:NarrativePosition ;
        sh:severity sh:Violation ;
        sh:message "An ArcSample must read at exactly one gmeow:samplePosition, a NarrativePosition — never a bare index (#359)." ;
    ] ;
    sh:property [
        sh:path gmeow:sampleState ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "An ArcSample must read exactly one gmeow:sampleState by IRI (affect EmotionType, EmotionML category, or another tradition's term — open by design, P16 soft reference)." ;
    ] ;
    sh:property [
        sh:path gmeow:vantage ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An ArcSample must name its analyzing vantage — two analyzers disagreeing about chapter 31 are two cells (Principle 9)." ;
    ] .
gmeow:MotifShape
    a sh:NodeShape ;
    rdfs:label "Motif Shape"@x-gmeow-english ;
    sh:targetClass gmeow:Motif ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:uniqueLang true ;
        sh:severity sh:Violation ;
        sh:message "A Motif must carry at least one rdfs:label, at most one per language tag — identity-bearing means nameable; an unnameable recurring unit is a tag." ;
    ] ;
    sh:property [
        sh:path gmeow:motifKind ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "gmeow:motifKind targets vocabulary IRIs (the open MotifKind vocabulary)." ;
    ] ;
    sh:property [
        sh:path gmeow:motifOccursIn ;
        sh:class gmeow:ContentSegment ;
        sh:severity sh:Violation ;
        sh:message "A motif occurrence rides the narration seam into a ContentSegment (#360)." ;
    ] .

# --------------------------------------------------------------------------- #
# Web-presence model (#410): a page names at most one principal subject.
# --------------------------------------------------------------------------- #
# --------------------------------------------------------------------------- #
# Closed-world twins for the new functional properties (#410, #412): the
# owl:FunctionalProperty contract enforced in the raw-graph lane by SHACL.
# --------------------------------------------------------------------------- #
# =========================================================================== #
# Flagship acceptance manifest — the shared depth-bar wiring shape.
#
# The single, slice-agnostic structural gate for gmeow:FlagshipScenario: every
# flagship scenario (in any grounding slice's examples/flagship-acceptance.ttl,
# validated against the data-graph shape union) binds exactly one worked example,
# one competency question, one native producer, one counter-example, and one
# enforcing failure class. The FAILURE-RANGE check (that the enforcing class is one
# of the owning slice's conformance-failure subclasses) is a per-slice concern —
# each grounding slice carries its own thin FlagshipScenarioShape with that
# slice-namespaced sh:sparql. This shape carries only the shared cardinalities.
# =========================================================================== #

gmeow:FlagshipScenarioShape
    a sh:NodeShape ;
    rdfs:label "Flagship scenario wiring shape"@x-gmeow-english ;
    skos:definition "The shared SHACL cardinality gate for gmeow:FlagshipScenario: it binds exactly one worked example (gmeow:demonstratedByExample), one competency question (gmeow:demonstratedByCompetency), one native producer (gmeow:demonstratedByProducer, REQUIRED), one counter-example (gmeow:guardedByCounterExample), and one enforcing failure class (gmeow:enforcesFailureClass). An acceptance scenario that does not wire all realizing artifacts to a failure class cannot claim the scenario is met (gmeow:UnwiredFlagshipScenario). The failure-range check — that the enforcing class is a slice-local conformance-failure subclass — is carried by each grounding slice's own thin FlagshipScenarioShape, not here."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/test-dsl> ;
    gmeow:enforcesFailureClass gmeow:UnwiredFlagshipScenario ;
    sh:targetClass gmeow:FlagshipScenario ;
    sh:property [
        sh:path gmeow:demonstratedByExample ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:FlagshipScenario must name exactly one worked example through gmeow:demonstratedByExample (a slice-relative path); an acceptance scenario with no realizing example is unwired." ;
    ] ;
    sh:property [
        sh:path gmeow:demonstratedByCompetency ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:FlagshipScenario must name exactly one competency question through gmeow:demonstratedByCompetency (an IRI into tests/competency.ttl); an acceptance scenario with no pinning competency question is unwired." ;
    ] ;
    sh:property [
        sh:path gmeow:demonstratedByProducer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:FlagshipScenario must name exactly one native producer through gmeow:demonstratedByProducer; the execution-discharge harness runs the named producer, so an acceptance bar with no producer is not discharged by execution." ;
    ] ;
    sh:property [
        sh:path gmeow:guardedByCounterExample ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:FlagshipScenario must name exactly one counter-example through gmeow:guardedByCounterExample (a slice-relative path); a rule with no negative fixture is not considered enforced." ;
    ] ;
    sh:property [
        sh:path gmeow:enforcesFailureClass ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:FlagshipScenario must name exactly one enforcing failure class through gmeow:enforcesFailureClass; an acceptance scenario whose gate raises no named failure is unwired." ;
    ] .
