#
# Declarative structural assertions for the accounts slice (Tier-B
# closeout). The accounts slice has no migratable rdflib pytest; these cells are
# authored fresh to pin its keystone invariants (MAXIMAL coverage, dogfooding).
# Each runs as a SPARQL ASK over the module graph (gmeow:scopeModule). Note:
# gmeow:AccountStatus and gmeow:ServiceStatus are explicitly OPEN value
# vocabularies, so the seeds are asserted present (MUST) but NOT closed.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/accounts/tests/> .

# --- 1. Status value vocabularies are QualityValues (MUST hold) ---------------
ex:saAccountStatusVocabsAreQualityValues a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:AccountStatus a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
    gmeow:ServiceStatus a owl:Class , logic:AbstractIndividualType ; rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:AccountStatus (usage state) and gmeow:ServiceStatus (liveness) MUST each be a logic:AbstractIndividualType owl:Class subClassOf logic:QualityValue — value vocabularies of individuals, never per-status subclasses." .

# --- 2. Account/Service objects are InformationObject Kinds (MUST hold) -------
ex:saAccountKindsAreInformationObjects a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:OnlineAccount a owl:Class , logic:Kind ; rdfs:subClassOf gmeow:InformationObject .
    gmeow:OnlineService a owl:Class , logic:Kind ; rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:OnlineAccount and gmeow:OnlineService MUST each be a logic:Kind owl:Class subClassOf gmeow:InformationObject — the held identity-object and the platform-object, both information carriers distinct from the agent." .

# --- 3. Seeded status individuals are present (MUST hold; open vocab) ---------
ex:saAccountStatusSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:accountStatusActive     a gmeow:AccountStatus .
    gmeow:accountStatusDormant    a gmeow:AccountStatus .
    gmeow:accountStatusHistorical a gmeow:AccountStatus .
    gmeow:serviceStatusLive       a gmeow:ServiceStatus .
    gmeow:serviceStatusShutDown   a gmeow:ServiceStatus .
}""" ;
    gmeow:saRationale "The seeded status individuals MUST be present and typed: AccountStatus {active, dormant, historical} and ServiceStatus {live, shut-down}. These are seeds of an OPEN value vocabulary (extended by new individuals, never subclasses), so presence is asserted but closure is deliberately NOT." .

# --- 4. accountService / serviceShutdownDate declared shapes (MUST hold) ------
ex:saAccountFunctionalShapes a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:accountService a owl:ObjectProperty ;
        rdfs:domain gmeow:OnlineAccount ; rdfs:range gmeow:OnlineService .
    gmeow:serviceShutdownDate a owl:DatatypeProperty ;
        rdfs:domain gmeow:OnlineService ; rdfs:range xsd:dateTime .
    gmeow:holdsAccount a owl:ObjectProperty ;
        rdfs:domain gmeow:Agent ; rdfs:range gmeow:OnlineAccount .
}""" ;
    gmeow:saRationale "gmeow:accountService (an account is on one service) and gmeow:serviceShutdownDate (one shutdown date) MUST carry their declared domains/ranges; their single-valued (functional) characteristic is now asserted on the logic:PropertyCharacteristicAssertion carrier and enforced by the DL reasoner, not in the slice module. gmeow:holdsAccount MUST link gmeow:Agent to gmeow:OnlineAccount." .

# --- 5. Status object properties are NOT functional (MUST-NOT hold) ----------
ex:saStatusPropertiesNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    VALUES ?p { gmeow:accountStatus gmeow:serviceStatus }
    ?rec logic:characterizes ?p ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "gmeow:accountStatus and gmeow:serviceStatus MUST NOT be owl:FunctionalProperty (Principle 9): competing source- or standpoint-asserted statuses coexist. A functional object property would force the distinct status values to be owl:sameAs and could drive a global OWL inconsistency that halts reasoning. VALUES here ranges over the two status object properties the slice declares — a closed, finite set, not a stand-in for an open universal." .
