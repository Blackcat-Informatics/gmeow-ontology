#
# Declarative structural assertions for the software slice (Phase A + Phase B)
# -- the slice-resident test-DSL twin of the asserted-TBox MUST /
# MUST-NOT invariants formerly hand-written in tests/test_software.py. Each
# assertion runs as a SPARQL ASK over the software module graph
# (gmeow:scopeModule) under the native Rust slicetest harness
# (crates/slicetest).
#
# Software is migrated: class stereotypes are logic:
# (logic:Kind, logic:SubKind, logic:Event, logic:AbstractIndividualType).
#
# RETAINED in pytest (not migratable here):
#   test_no_subclass_bridge_between_facets -- dynamic pairwise sweep over 6
#     facet classes (15 pairs); cannot be expressed as a fixed module-scoped ASK
#     without enumerating every pair inline (which would turn a live sweep into a
#     finite list and lose coverage if new facets are added).
#   test_facet_orthogonality_shacl_rejects_two_facets -- SHACL validation call
#     with ABox graph; ExampleConformance, not a structural TBox assertion.
#   test_fixture_parses_and_shacl_passes -- SHACL validation fixture conformance.
#   test_fixture_has_all_five_facets -- fixture ABox individual type checks.
#   test_fixture_commit_has_content_digest -- fixture ABox predicate check.
#   test_fixture_ai_contributor_is_first_class -- fixture ABox dynamic subject
#     scan (g.subjects(GM.contributor, EX.copilot)); not module-scoped TBox.
#   test_fixture_contribution_reifies_role_and_degree -- fixture ABox checks.
#   test_software_contribution_roles_seeded -- dynamic subset sweep
#     (expected <= actual); not a closed-set TBox assertion; new roles may be
#     added by future slices without breaking the invariant.
#   test_software_event_types_seeded -- dynamic subset sweep (expected <= actual)
#     over gmeow:ContributionRole / gmeow:EventType individuals; same reason.
#   test_fixture_has_three_commit_dag -- fixture ABox parentCommit assertions.
#   test_fixture_has_commit_ancestor_closure -- fixture ABox commitAncestor.
#   test_fixture_has_blobs_and_tree_entries -- fixture ABox.
#   test_fixture_has_push_event -- fixture ABox.
#   test_fixture_has_merge_event -- fixture ABox.
#   test_fixture_has_code_review_event -- fixture ABox.
#   test_fixture_has_diff -- fixture ABox.
#   test_fixture_repository_has_materialization_depth -- fixture ABox numeric
#     check (datatype + value); not expressible as a module-scoped TBox ASK.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/software/tests/> .

# --- 1. Core class hierarchy (Phase A gUFO grounding) (MUST) -----------------
ex:saProjectIsKindSubclassEntity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Project a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:Project MUST be an owl:Class typed logic:Kind and a subclass of gmeow:Entity -- the Project facet is the primary real-world kind (not an artifact or event) in the five-facet de-conflation doctrine." .

# --- 2. SoftwareProject subClassOf Project (MUST) ----------------------------
ex:saSoftwareProjectSubclassProject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SoftwareProject rdfs:subClassOf gmeow:Project .
}""" ;
    gmeow:saRationale "gmeow:SoftwareProject MUST be a subclass of gmeow:Project -- specialises the project facet to software without bridging to other facets." .

# --- 3. SoftwareProduct subClassOf Work (MUST) --------------------------------
ex:saSoftwareProductSubclassWork a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SoftwareProduct rdfs:subClassOf gmeow:Work .
}""" ;
    gmeow:saRationale "gmeow:SoftwareProduct MUST be a subclass of gmeow:Work -- the product facet is a WEMI Work, not an Entity or Activity; this is the Product != Project split." .

# --- 4. Commit subClassOf Activity (MUST) ------------------------------------
ex:saCommitSubclassActivity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Commit rdfs:subClassOf gmeow:Activity .
}""" ;
    gmeow:saRationale "gmeow:Commit MUST be a subclass of gmeow:Activity -- a commit is a performed action (with author + committer), not just an artifact or event." .

# --- 5. Release subClassOf Event (MUST) --------------------------------------
ex:saReleaseSubclassEvent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Release rdfs:subClassOf gmeow:Event .
}""" ;
    gmeow:saRationale "gmeow:Release MUST be a subclass of gmeow:Event -- releasing is a point-in-time event, not a sustained activity; distinct from the artifact (Distribution) it produces." .

# --- 6. Repository subClassOf InformationObject (MUST) -----------------------
ex:saRepositorySubclassInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Repository rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:Repository MUST be a subclass of gmeow:InformationObject -- a repository is a content-addressed store, not an Entity or Event; this is the Repository != Project split." .

# --- 7. Value-vocabulary classes are logic:QualityValue subclasses (MUST) -----
ex:saValueVocabsAreQualityValues a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:RepositoryType    rdfs:subClassOf logic:QualityValue .
    gmeow:MaintenanceStatus rdfs:subClassOf logic:QualityValue .
    gmeow:GovernanceModel   rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:RepositoryType, MaintenanceStatus, and GovernanceModel MUST each be subclasses of logic:QualityValue -- they are ordered or unordered value vocabularies (the kernel QualityValue pattern)." .

# --- 7b. SLSALevel is a logic:QualityValue vocabulary with four seed values (MUST) ---
ex:saSlsaLevelIsValueVocabulary a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SLSALevel rdfs:subClassOf logic:QualityValue .
    gmeow:slsaLevel1 a gmeow:SLSALevel .
    gmeow:slsaLevel2 a gmeow:SLSALevel .
    gmeow:slsaLevel3 a gmeow:SLSALevel .
    gmeow:slsaLevel4 a gmeow:SLSALevel .
}""" ;
    gmeow:saRationale "gmeow:SLSALevel MUST be a logic:QualityValue vocabulary with SLSA levels 1 through 4 as individuals. Replaces the stale gufo:QualityValue assertion." .

ex:saSlsaLevelsAreNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?level { gmeow:slsaLevel1 gmeow:slsaLevel2 gmeow:slsaLevel3 gmeow:slsaLevel4 }
    ?level a owl:Class .
}""" ;
    gmeow:saRationale "SLSA level individuals MUST NOT be owl:Class declarations; levels are values, not subclasses." .

# --- 8. parentCommit subPropertyOf wasDerivedFrom (MUST) ---------------------
ex:saParentCommitSubPropertyWasDerivedFrom a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:parentCommit rdfs:subPropertyOf gmeow:wasDerivedFrom .
}""" ;
    gmeow:saRationale "gmeow:parentCommit MUST be a subproperty of gmeow:wasDerivedFrom -- every parent-commit link is also a PROV-O derivation link, enabling provenance chain queries without separate inference." .

# --- 9. Phase B new classes are owl:Class with correct parents (MUST) --------
ex:saBlobIsSubKindSourceNode a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Blob a owl:Class ;
        rdfs:subClassOf gmeow:SourceNode .
}""" ;
    gmeow:saRationale "gmeow:Blob MUST be an owl:Class and a subclass of gmeow:SourceNode -- a blob is the leaf content node of a Merkle source tree; distinct from TreeEntry which carries the name." .

# --- 10. TreeEntry is owl:Class subClassOf InformationObject (MUST) ----------
ex:saTreeEntrySubclassInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:TreeEntry a owl:Class ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:TreeEntry MUST be an owl:Class and a subclass of gmeow:InformationObject -- a tree entry is a named pointer in a directory, not an Event or Entity." .

# --- 11. Push is owl:Class subClassOf Activity (MUST) ------------------------
ex:saPushSubclassActivity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Push a owl:Class ;
        rdfs:subClassOf gmeow:Activity .
}""" ;
    gmeow:saRationale "gmeow:Push MUST be an owl:Class and a subclass of gmeow:Activity -- pushing commits is an intentional performed action." .

# --- 12. Merge is owl:Class subClassOf Activity (MUST) -----------------------
ex:saMergeSubclassActivity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Merge a owl:Class ;
        rdfs:subClassOf gmeow:Activity .
}""" ;
    gmeow:saRationale "gmeow:Merge MUST be an owl:Class and a subclass of gmeow:Activity -- a merge is an intentional action integrating branches, not merely an event." .

# --- 13. CodeReview is owl:Class subClassOf Event (MUST) ---------------------
ex:saCodeReviewSubclassEvent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:CodeReview a owl:Class ;
        rdfs:subClassOf gmeow:Event .
}""" ;
    gmeow:saRationale "gmeow:CodeReview MUST be an owl:Class and a subclass of gmeow:Event (not Activity) -- reviewing is observation-like and does not require intentional agency in the same sense as Push or Merge." .

# --- 14. Diff is owl:Class subClassOf InformationObject (MUST) ---------------
ex:saDiffSubclassInformationObject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Diff a owl:Class ;
        rdfs:subClassOf gmeow:InformationObject .
}""" ;
    gmeow:saRationale "gmeow:Diff MUST be an owl:Class and a subclass of gmeow:InformationObject -- a diff is a computed artifact (content), not an Event or Entity." .

# --- 15. commitAncestor is transitive and subPropertyOf wasDerivedFrom (MUST) -
ex:saCommitAncestorTransitiveAndDerived a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:commitAncestor a owl:TransitiveProperty ;
        rdfs:subPropertyOf gmeow:wasDerivedFrom .
}""" ;
    gmeow:saRationale "gmeow:commitAncestor MUST be an owl:TransitiveProperty and a subproperty of gmeow:wasDerivedFrom -- transitivity enables full ancestor queries without materialising every step; derivation link exposes history to PROV-O consumers." .

# --- 16. parentCommit subPropertyOf commitAncestor (MUST) --------------------
ex:saParentCommitSubPropertyCommitAncestor a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:parentCommit rdfs:subPropertyOf gmeow:commitAncestor .
}""" ;
    gmeow:saRationale "gmeow:parentCommit MUST be a subproperty of gmeow:commitAncestor -- direct parent edges are the base case of the transitive closure; the sub-property relation seeds closure correctly." .

# --- 17. commitDescendant inverseOf commitAncestor (MUST) --------------------
ex:saCommitDescendantInverseOfAncestor a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:commitDescendant owl:inverseOf gmeow:commitAncestor .
}""" ;
    gmeow:saRationale "gmeow:commitDescendant MUST be declared owl:inverseOf gmeow:commitAncestor -- a single declared inverse avoids maintaining two parallel transitive chains." .

# --- 18. treeEntry properties have correct domain and range (MUST) -----------
ex:saTreeEntryPropertiesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:treeEntryName   rdfs:domain gmeow:TreeEntry .
    gmeow:treeEntryMode   rdfs:domain gmeow:TreeEntry .
    gmeow:treeEntryObject rdfs:domain gmeow:TreeEntry ;
                          rdfs:range  gmeow:SourceNode .
}""" ;
    gmeow:saRationale "gmeow:treeEntryName, treeEntryMode, and treeEntryObject MUST all have domain gmeow:TreeEntry; treeEntryObject MUST also have range gmeow:SourceNode -- the entry is the name+mode+pointer triple of a Merkle directory node." .

# --- 19. diff properties have correct domain and range (MUST) ----------------
ex:saDiffPropertiesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:diffFrom rdfs:domain gmeow:Diff ; rdfs:range gmeow:Commit .
    gmeow:diffTo   rdfs:domain gmeow:Diff ; rdfs:range gmeow:Commit .
}""" ;
    gmeow:saRationale "gmeow:diffFrom and diffTo MUST both have domain gmeow:Diff and range gmeow:Commit -- a diff is always anchored between exactly two commits; range constrains the pointer to the commit facet." .

# --- 20. Push/Merge/CodeReview properties exist with correct domain (MUST) ---
ex:saPushMergeReviewPropertiesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:pushTarget   rdfs:domain gmeow:Push .
    gmeow:mergeBase    rdfs:domain gmeow:Merge .
    gmeow:mergeSource  rdfs:domain gmeow:Merge .
    gmeow:mergeTarget  rdfs:domain gmeow:Merge .
    gmeow:reviewOf     rdfs:domain gmeow:CodeReview .
    gmeow:reviewCommit rdfs:domain gmeow:CodeReview .
}""" ;
    gmeow:saRationale "gmeow:pushTarget, mergeBase, mergeSource, mergeTarget, reviewOf, and reviewCommit MUST all have their respective event-class domains. mergeTarget's single-valued character (a merge has exactly one target branch) now rides on a logic:PropertyCharacteristicAssertion, DL-enforced, no longer a bare OWL property-type declaration." .

# --- 21. materializationDepth has correct domain and range (MUST) ------------
ex:saMaterializationDepthPropertyExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:materializationDepth rdfs:domain gmeow:Repository ;
                               rdfs:range  xsd:nonNegativeInteger .
}""" ;
    gmeow:saRationale "gmeow:materializationDepth MUST have domain gmeow:Repository and range xsd:nonNegativeInteger -- records the clone depth chosen at fetch time so tooling can warn when ancestor queries may be incomplete." .
