    a owl:NamedIndividual ,
        logic:RoleCompositionExclusionAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/inference> ;
    rdfs:label "an argument does not attack its own component"@x-gmeow-english ;
    skos:definition "Asserts that a gmeow:Attack's gmeow:attackSource (a gmeow:Argument) must not aim its gmeow:attackTarget at one of its own components — its conclusion (gmeow:argumentConclusion), a premise use (gmeow:hasPremiseUse), or an inference application (gmeow:hasInferenceApplication): an argument does not attack a part of itself. The native coherence gate raises a violation when the target is a component of the source."@x-gmeow-english ;
