#
# SHACL well-formedness shapes for the software slice.
#
# gmeow:Distribution carries a closed-world node shape so the JSON-Schema
# projection of the shape union emits a `$defs/Distribution` node for it. The
# software distribution class is referenced by projected `sh:class gmeow:Distribution`
# range constraints (e.g. on gmeow:buildOutput), and the closed-world @type
# discriminator keys a class's `$defs` node by the LOCAL name of its target class.
# The mathematics slice's math:Distribution shares that local name ("Distribution");
# without a node shape here, the projected reference to the software Distribution
# resolves against no emitted def and dangles. This shape is deliberately
# permissive on presence — a Distribution's mandatory content-digest identity is
# already carried by the OWL cardinality restriction on gmeow:contentDigest in
# module.ttl, so this shape constrains the digest's shape when present rather than
# re-asserting its presence, and never rejects a minimally-typed distribution.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .

# A software distribution's content digest, when declared, is a literal fingerprint.
gmeow:DistributionShape
    a sh:NodeShape ;
    rdfs:label "Software distribution shape"@x-gmeow-english ;
    skos:definition "SHACL node shape for gmeow:Distribution — the concrete distribution artifact of a software product (a tarball, wheel, binary, container image, or installer, identified by content digest). It emits the closed-world $defs/Distribution node for the software distribution class and constrains its gmeow:contentDigest to a literal fingerprint when present; the digest's mandatory presence is carried by the OWL cardinality restriction on gmeow:contentDigest, so this shape does not re-require it and never rejects a minimally-typed distribution."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/software> ;
    sh:targetClass gmeow:Distribution ;
    sh:property [
        sh:path gmeow:contentDigest ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:Distribution's gmeow:contentDigest is a literal content-fingerprint (e.g. \"blake3:…\"); a non-literal digest is ill-formed." ;
    ] .
