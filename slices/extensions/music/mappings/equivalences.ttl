# --------------------------------------------------------------------------- #
# Genre doctrine alignments
# --------------------------------------------------------------------------- #

gmeow:Genre skos:relatedMatch mbz:genre {|
    gmeow:sssomFile "gmeow-music.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "MusicBrainz genre pages use /genre/{mbid}."
|} .

gmeow:Genre skos:relatedMatch discogs:style {|
    gmeow:sssomFile "gmeow-music.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Discogs style pages use /style/{name}."
|} .

# --------------------------------------------------------------------------- #
# AFO 1.1 — timbre descriptor
# --------------------------------------------------------------------------- #

gmeow:TimbreDescriptor skos:closeMatch afo:AudioFeature {|
    gmeow:sssomFile "gmeow-music.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "A categorical timbre descriptor is a coarse, human-interpretable audio feature in the AFO sense."
|} .
