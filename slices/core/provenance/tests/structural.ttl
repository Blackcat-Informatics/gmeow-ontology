#
# Declarative structural assertions for the provenance slice — the slice-resident
# test-DSL twin of the asserted-TBox MUST invariants formerly hand-written in
# tests/test_provenance.py. Each runs as a SPARQL ASK over the provenance module
# graph (gmeow:scopeModule) under the native Rust slicetest harness.
# Provenance is migrated (logic:Event, logic:Kind, logic:SubKind, not gufo:).
#
# MIGRATED to this file from tests/test_events.py (cross-slice: subject defined
# here; the superclass gmeow:Event is defined in the events slice):
#   test_event_is_grounded_in_gufo_event -- the gmeow:Activity rdfs:subClassOf
#     gmeow:Event assertion.
#   test_observational_activity_is_subclass_of_activity_and_event -- the
#     gmeow:Activity rdfs:subClassOf gmeow:Event half.
#
# RETAINED in pytest (all subjects are cross-slice):
#   test_carrier_and_ingestion_props — gmeow:sourceModifiedAt and gmeow:contentDigest
#     are defined in the sources slice, not here; gmeow:ingestedAt is mixed in.
#   test_four_clocks_are_distinct_dated_annotations — gmeow:validFrom, gmeow:validUntil,
#     gmeow:assertedAt, and gmeow:recordedNoLaterThan are all defined in the temporal
#     and sources slices, not provenance.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/provenance/tests/> .

# --- 1. ImportActivity is a subclass of Activity (MUST) ----------------------
ex:saImportActivityIsSubclassOfActivity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ImportActivity a owl:Class , logic:Event ;
        rdfs:subClassOf gmeow:Activity .
}""" ;
    gmeow:saRationale "gmeow:ImportActivity MUST be an owl:Class typed logic:Event and a subclass of gmeow:Activity — an import is an occurrent event in the provenance chain." .

# --- 2. wasAssociatedWith has Activity domain and Agent range (MUST) ---------
ex:saWasAssociatedWithShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:wasAssociatedWith a owl:ObjectProperty ;
        rdfs:domain gmeow:Activity ;
        rdfs:range gmeow:Agent .
}""" ;
    gmeow:saRationale "gmeow:wasAssociatedWith MUST be an owl:ObjectProperty with domain gmeow:Activity and range gmeow:Agent — the activity-side agent link is event-safe (Activity, not Entity), avoiding gUFO endurant/event disjointness clash." .

# --- 3. Activity is a subclass of Event (MUST) -------------------------------
# Migrated from tests/test_events.py (cross-slice: subject defined here; the
# superclass gmeow:Event is defined in the events slice).
ex:saActivityIsSubclassOfEvent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Activity a owl:Class , logic:Event ;
        rdfs:subClassOf gmeow:Event .
}""" ;
    gmeow:saRationale "gmeow:Activity MUST be an owl:Class typed logic:Event and a direct subclass of gmeow:Event. The subject is defined in the provenance slice; gmeow:Event itself is in the events slice, so this is a cross-slice structural assertion authored in the subject's owning slice." .
