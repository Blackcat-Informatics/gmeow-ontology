      </termEntry>
      <termEntry id="c-bfdfe3383dd24bba">
        <langSet xml:lang="en">
          <tig>
            <term>conditions of access</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>conditions d'accès</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>访问条件</term>
