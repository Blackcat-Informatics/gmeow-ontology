|} .

# ISO-TimeML (ISO 24617-1) correspondence — documented, not IRI-aligned, because
# TimeML is an XML annotation scheme whose TLINK/ALINK relType and EVENT tense/aspect
# are STRING enums, not RDF terms (its OWL realization is OWL-Time, aligned above):
#   TLINK relType : BEFORE→gmeow:before  AFTER→gmeow:after  IBEFORE→gmeow:meets
#     IAFTER→gmeow:metBy  INCLUDES→gmeow:contains  IS_INCLUDED→gmeow:during
#     DURING→gmeow:during  SIMULTANEOUS/IDENTITY→gmeow:coincidesWith
#     BEGINS→gmeow:starts  BEGUN_BY→gmeow:startedBy  ENDS→gmeow:finishes
#     ENDED_BY→gmeow:finishedBy
#   TIMEX3 @type  : DATE/TIME→gmeow:eventTime/eventInterval  DURATION→gmeow:Duration
#     SET→gmeow:RecurrenceRule
#   EVENT @tense  : PAST/PRESENT/FUTURE/NONE→gmeow:GrammaticalTense values
#   EVENT @aspect : PERFECTIVE/PROGRESSIVE/…→gmeow:GrammaticalAspect values
#   EVENT @class  : OCCURRENCE/STATE/REPORTING/… → gmeow:eventType value vocabulary
#     (GMEOW's open type vocab subsumes TimeML's seven fixed classes)

# iCalendar DTEND — the upper endpoint of a VEVENT, projected from the crisp
# interval's end or the fuzzy latestEnd bound (declares ical:dtend for the
# projection drift lint; the projection itself is generated).
gmeow:eventInterval skos:relatedMatch ical:dtend {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:comment "the crisp interval's end becomes the VEVENT DTEND"
|} .

gmeow:latestEnd skos:relatedMatch ical:dtend {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "the fuzzy upper bound becomes the VEVENT DTEND"
|} .

gmeow:earliestStart skos:relatedMatch ical:dtstart {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "the fuzzy lower bound becomes the VEVENT DTSTART"
|} .

# =========================================================================== #
# Spacetime / Trajectory linkage — moving events and 4D spacetime slices
# =========================================================================== #

gmeow:eventTrajectory skos:relatedMatch crm:E92_Spacetime_Volume {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:objectLabel "Spacetime Volume" ;
    gmeow:comment "a trajectory is a continuous spacetime volume (relatedMatch — it is a path, not any arbitrary volume)"
|} .

gmeow:eventSpacetime skos:relatedMatch crm:E92_Spacetime_Volume {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:objectLabel "Spacetime Volume" ;
    gmeow:comment "an event spacetime slice is a discrete projection of a spacetime volume onto a LocationState; no direct CIDOC property exists from Event to E92"
|} .

gmeow:eventSpacetime skos:relatedMatch crmgeo:SP1_Spacetime_Volume {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.55 ;
    gmeow:objectLabel "Spacetime Volume" ;
    gmeow:comment "CRMgeo SP1 is the geospatial extension of CIDOC E92; same relatedMatch rationale as eqEvents129"
|} .

# --------------------------------------------------------------------------- #
# observation-linkage design — ObservationalActivity and observation linkage.
# --------------------------------------------------------------------------- #

gmeow:ObservationalActivity skos:closeMatch crm:E13_Attribute_Assignment {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "CIDOC-CRM E13 is the closest event-centric analogue: an act of assigning an attribute to an item. GMEOW ObservationalActivity generalises this to any structured act of observing or asserting."
|} .

gmeow:ObservationalActivity skos:closeMatch prov:Activity {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "An observational activity is a provenance activity that generates observations as outputs."
|} .

gmeow:ObservationalActivity skos:closeMatch schema:Action {|
    gmeow:sssomFile "gmeow-events.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
