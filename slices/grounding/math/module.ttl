<https://blackcatinformatics.ca/math/WeightTensor> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/math/inParameterSpace> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/math/ParameterSpace> ] .
<https://blackcatinformatics.ca/math/RationalValue> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/math/numerator> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onDataRange> <http://www.w3.org/2001/XMLSchema#integer> ] .
<https://blackcatinformatics.ca/math/RationalValue> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/math/denominator> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onDataRange> <http://www.w3.org/2001/XMLSchema#integer> ] .
<https://blackcatinformatics.ca/math/Norm> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/math/inducedByForm> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <http://www.w3.org/2002/07/owl#Thing> ] .
<https://blackcatinformatics.ca/math/GramMatrix> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/math/representsForm> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/math/SymmetricBilinearForm> ] .
<https://blackcatinformatics.ca/math/GramMatrix> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/math/inBasis> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/math/Basis> ] .
# math:FunctionPiece — the min-qualified sibling restoring sh:minCount for the exact-one
# math:pieceDomain antecedent (the max-qualified half is in the Turtle block above).
<https://blackcatinformatics.ca/math/FunctionPiece> <http://www.w3.org/2000/01/rdf-schema#subClassOf> [ <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#Restriction> ; <http://www.w3.org/2002/07/owl#onProperty> <https://blackcatinformatics.ca/math/pieceDomain> ; <http://www.w3.org/2002/07/owl#minQualifiedCardinality> "1"^^<http://www.w3.org/2001/XMLSchema#integer> ; <http://www.w3.org/2002/07/owl#onClass> <https://blackcatinformatics.ca/math/Interval> ] .
# A math:SetBuilderExpression's math:memberCondition must be a resource denoting a
# logic: formula (a blank node or IRI), not an opaque literal string (a path node-kind
# constraint).
math:SetBuilderMemberConditionNodeKindConstraint
    a logic:PathNodeKindConstraint ;
    logic:onClass math:SetBuilderExpression ;
    logic:valuePath math:memberCondition ;
    logic:nodeKind "BlankNodeOrIRI" ;
    logic:formalizes math:SetBuilderExpression ;
    logic:message "A math:SetBuilderExpression must name its math:memberCondition as a resource denoting a logic: formula (a blank node or IRI), not an opaque literal string." ;
    # Bound to its failure class: without this the constraint rejects ANONYMOUSLY — the
    # violation carries no typed identity, so a conformance cell can only pin the SHACL
    # component code and every SPARQL-derived gate shares one of those.
    gmeow:enforcesFailureClass math:StringOnlyMemberCondition .

# No two distinct math:argumentSlot cells of the same parent may share the same
# math:slotIndex — a duplicate index makes operand order ambiguous (a self-join
# uniqueness constraint over subjects of math:argumentSlot).
math:ArgumentSlotIndexUniquenessConstraint
    a logic:SelfJoinUniquenessConstraint ;
    logic:siblingPredicate math:argumentSlot ;
    logic:sharedPredicate math:slotIndex ;
    logic:formalizes math:SlotIndexUniquenessShape ;
    gmeow:enforcesFailureClass math:DuplicateArgumentSlotIndex ;
    logic:message "No two distinct math:argumentSlot cells of the same parent may share the same math:slotIndex; a duplicate index makes operand order ambiguous (math:DuplicateArgumentSlotIndex)." .

# Every positive slot index must have a predecessor slot under the same parent.
# The existing non-negative and sibling-uniqueness gates complete the proof:
# together the three rules admit exactly the strict zero-based contiguous
# sequence 0..n−1, with neither a leading gap nor an interior gap.
math:ArgumentSlotContiguityConstraint
    a logic:Constraint ;
    rdfs:label "Argument-slot contiguity constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    skos:definition "A closed-world integrity constraint requiring every positive math:slotIndex under one math:argumentSlot parent to have a sibling at the immediately preceding index. Combined with the non-negative and sibling-uniqueness rules, this enforces exactly 0..n−1 for every non-empty slot family."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    logic:formalizes math:ArgumentSlotContiguityShape ;
    gmeow:enforcesFailureClass math:NonContiguousArgumentSlots ;
    logic:severity "Violation" ;
    logic:message "A mathematical expression's math:argumentSlot indexes must form the strict zero-based contiguous sequence 0..n−1; every positive index must have a sibling at its immediate predecessor (math:NonContiguousArgumentSlots)." ;
    logic:integrity math:ascForall .
math:ascForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall math:ascImpl .
math:ascImpl a logic:Formula ;
    logic:antecedent math:ascGuard ;
    logic:consequent math:ascAllSlots .
# The guard range-restricts `this` to nodes with AT LEAST ONE math:argumentSlot — the
# same sh:targetSubjectsOf math:argumentSlot idiom math:ArgumentSlotIndexUniquenessConstraint
# uses — rather than an explicit `rdf:type(this, math:MathematicalExpression)` test. A node
# with an argumentSlot is already a math:MathematicalExpression by math:argumentSlot's own
# rdfs:domain axiom, and a math:MathematicalExpression with NO argumentSlot trivially
# satisfies math:ascAllSlots (its universal quantification ranges over zero slots), so the
# two guards admit identical verdicts; this form additionally derives a
# `sh:targetSubjectsOf` shape rather than a `sh:targetClass` one, which purrdf's SHACL
# engine selects directly off the DATA graph's OWN asserted math:argumentSlot edges — no
# `rdfs:subClassOf` walk needed — so the rule fires for every subclass-typed application
# root without depending on the consumer's data graph restating the bundle's class
# hierarchy.
math:ascGuard a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "guardSlot" ] ;
    logic:exists math:ascGuardHasSlot .
math:ascGuardHasSlot a logic:Formula ; logic:relation math:argumentSlot ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termVariable "guardSlot" ] .
math:ascAllSlots a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "slot" ] ,
        [ logic:termIndex 1 ; logic:termVariable "index" ] ;
    logic:forall math:ascSlotImpl .
math:ascSlotImpl a logic:Formula ;
    logic:antecedent math:ascSlotGuard ;
    logic:consequent math:ascZeroOrPredecessor .
math:ascSlotGuard a logic:Formula ;
    logic:and math:ascSlot , math:ascIndex .
math:ascSlot a logic:Formula ; logic:relation math:argumentSlot ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "slot" ] .
math:ascIndex a logic:Formula ; logic:relation math:slotIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "slot" ] , [ logic:termIndex 1 ; logic:termVariable "index" ] .
math:ascZeroOrPredecessor a logic:Formula ;
    logic:or math:ascZero , math:ascPredecessorExists .
math:ascZero a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "index" ] ,
        [ logic:termIndex 1 ; logic:termLiteral "0" ; logic:termLiteralDatatype xsd:integer ] .
math:ascPredecessorExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "predecessorSlot" ] ,
        [ logic:termIndex 1 ; logic:termVariable "predecessorIndex" ] ,
        [ logic:termIndex 2 ; logic:termVariable "successorIndex" ] ;
    logic:exists math:ascPredecessorBody .
math:ascPredecessorBody a logic:Formula ;
    logic:and math:ascPredecessorSlot , math:ascPredecessorIndex , math:ascSuccessor , math:ascIndexEqual .
math:ascPredecessorSlot a logic:Formula ; logic:relation math:argumentSlot ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "predecessorSlot" ] .
math:ascPredecessorIndex a logic:Formula ; logic:relation math:slotIndex ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "predecessorSlot" ] , [ logic:termIndex 1 ; logic:termVariable "predecessorIndex" ] .
math:ascSuccessor a logic:Formula ; logic:relation logic:termSum ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "successorIndex" ] ,
        [ logic:termIndex 1 ; logic:termVariable "predecessorIndex" ] ,
        [ logic:termIndex 2 ; logic:termLiteral "1" ; logic:termLiteralDatatype xsd:integer ] .
math:ascIndexEqual a logic:Formula ; logic:relation logic:termEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "successorIndex" ] , [ logic:termIndex 1 ; logic:termVariable "index" ] .

# A math:FormalVerificationResult must be grounded in an observation that names it through
# gmeow:observationResult — an ungrounded verification result is ill-formed (an inverse-existence
# constraint: the result must be the gmeow:observationResult of some subject).
math:FormalVerificationResultGroundingConstraint
    a logic:InverseExistenceConstraint ;
    logic:onClass math:FormalVerificationResult ;
    logic:inversePredicate gmeow:observationResult ;
    logic:formalizes math:FormalVerificationResult ;
    logic:message "A math:FormalVerificationResult must be the gmeow:observationResult of some observation; an ungrounded verification result is ill-formed." ;
    # Bound to its failure class: without this the constraint rejects ANONYMOUSLY — the
    # violation carries no typed identity, so a conformance cell can only pin the SHACL
    # component code and every SPARQL-derived gate shares one of those.
    gmeow:enforcesFailureClass math:UngroundedVerificationResult .

# The math: slice's THIN failure-range gate for gmeow:FlagshipScenario (the canonical
# grounding of the retired math:FlagshipScenarioShape): a scenario whose
# gmeow:enforcesFailureClass names a math:-namespaced class must name a
# math:MathConformanceFailure subclass (rdfs:subClassOf+, checked by value). The gate is
# NAMESPACE-SCOPED because every grounding slice contributes its own failure-range gate
# over the SAME shared gmeow:FlagshipScenario class: an unscoped gate would demand every
# scenario's failure class reach EVERY slice's root at once — mutually unsatisfiable on
# the union graph — so each slice validates exactly the failure classes it owns.
math:FlagshipScenarioFailureClassConstraint
    a logic:Constraint ;
    rdfs:label "Flagship scenario failure-range constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The math: slice's thin failure-range gate: a gmeow:FlagshipScenario whose gmeow:enforcesFailureClass names a math:-namespaced class must name a math:MathConformanceFailure subclass (transitively, by rdfs:subClassOf). Namespace-scoped so the three grounding slices' failure-range gates coexist over the one shared gmeow:FlagshipScenario class; a scenario enforcing a math: class that is not a conformance failure is unwired (math:UnwiredFlagshipScenario)."@x-gmeow-english ;
    logic:formalizes math:FlagshipScenarioShape ;
    gmeow:enforcesFailureClass math:UnwiredFlagshipScenario ;
    logic:message "A gmeow:FlagshipScenario's gmeow:enforcesFailureClass naming a math: class must name a math:MathConformanceFailure subclass — the typed failure its counter-example raises; naming a math: class that is not a conformance failure leaves the scenario unwired (math:UnwiredFlagshipScenario)." ;
    logic:integrity math:fsrForall .
math:fsrForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "failure" ] ;
    logic:forall math:fsrImpl .
math:fsrImpl a logic:Formula ; logic:antecedent math:fsrGuard ; logic:consequent math:fsrReach .
math:fsrGuard a logic:Formula ; logic:and math:fsrType , math:fsrEdge , math:fsrNs .
math:fsrType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:FlagshipScenario ] .
math:fsrEdge a logic:Formula ; logic:relation gmeow:enforcesFailureClass ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "failure" ] .
math:fsrNs a logic:Formula ; logic:relation logic:termStrStarts ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "failure" ] , [ logic:termIndex 1 ; logic:termLiteral "https://blackcatinformatics.ca/math/" ] .
math:fsrReach a logic:Formula ; logic:relation logic:transitiveReach ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "failure" ] , [ logic:termIndex 1 ; logic:termIri rdfs:subClassOf ] , [ logic:termIndex 2 ; logic:termIri math:MathConformanceFailure ] .

# A math:Set is given extensionally (math:hasElement) or intensionally
# (math:memberCondition), not silently both without a declared equality: a node
# carrying BOTH has an ambiguous extent (a choice-group at-most-one over the two
# extent predicates — the two must not both be present).
math:SetExtentDisjointConstraint
    a logic:ChoiceGroupConstraint ;
    logic:onClass math:Set ;
    logic:choicePredicate math:hasElement , math:memberCondition ;
    logic:choiceMode "at-most-one" ;
    logic:formalizes math:SetExtentShape ;
    gmeow:enforcesFailureClass math:AmbiguousSetExtent ;
    logic:message "A math:Set must be extensional or intensional, not both: a node carrying both math:hasElement and math:memberCondition without a declared equality has an ambiguous extent (math:AmbiguousSetExtent)." .

# --- ∂∘∂ = 0 executable enforcement, TWO layers ---------------------------- #
# Reasoning layer (regular/simplicial): the combinatorial diamond over math:incidentTo.
# On a math:SimplicialComplex every codimension-2 face pair has EXACTLY TWO intermediate
# faces (the diamond lemma), so every codim-2 composition path must have a distinct
# cancelling partner face; a lone intermediate (a broken diamond) is ill-formed
# (math:BrokenBoundarySquareZero). A cross-node ∀→∃ formula, scoped to
# math:SimplicialComplex, projected to a sh:SPARQLConstraint.
math:BoundarySquareZeroConstraint
    a logic:Constraint ;
    rdfs:label "Boundary square-zero constraint (regular/simplicial diamond)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint enforcing the COMBINATORIAL half of ∂∘∂ = 0 on a math:SimplicialComplex under the induced orientation: every codimension-2 composition path (a coface c with a codimension-1 face b that has a as a codimension-1 face) must have a distinct partner face b′ ≠ b that also composes c to a — the two intermediate faces of the diamond. On a simplicial complex under the standard induced orientation the diamond lemma makes those two faces' ±1 boundary coefficients cancel automatically, so diamond-completeness (a partner face exists) IS ∂∘∂ = 0 there; this constraint checks that completeness over the UNSIGNED math:incidentTo face relation and deliberately does NOT itself read math:incidenceSign (a plain logic:Constraint projects to a triple-pattern sh:SPARQLConstraint that cannot compute a sign product — an oppositeProduct atom here would be a vacuous, always-satisfied pattern). The explicit signed arithmetic Σ_b [c:b]·[b:a] = 0 — required whenever a complex carries reified ±1 math:CellIncidence records, simplicial or not — is enforced by math:GeneralBoundarySquareZeroConstraint (a logic:JoinAggregateConstraint over the signed incidence SUM, onClass math:Cell, so it also covers signed simplicial complexes); the machine law is math:boundarySquareZeroLaw. A lone intermediate (a broken diamond) makes ∂∘∂ non-zero and is ill-formed (math:BrokenBoundarySquareZero)."@x-gmeow-english ;
    logic:formalizes math:BoundarySquareZeroShape ;
    gmeow:enforcesFailureClass math:BrokenBoundarySquareZero ;
    logic:message "On a math:SimplicialComplex a codimension-2 composition path (c ▷ b ▷ a) must have a distinct partner face b′ (the diamond) — combinatorial completeness that, under the induced orientation, is ∂∘∂ = 0; a lone intermediate is a broken diamond (math:BrokenBoundarySquareZero). Explicit ±1 sign cancellation over reified math:CellIncidence records is enforced by math:GeneralBoundarySquareZeroConstraint." ;
    logic:integrity math:bszcForall .
math:bszcForall a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termVariable "c" ] ,
        [ logic:termIndex 2 ; logic:termVariable "b" ] ,
        [ logic:termIndex 3 ; logic:termVariable "a" ] ;
    logic:forall math:bszcImpl .
math:bszcImpl a logic:Formula ; logic:antecedent math:bszcGuard ; logic:consequent math:bszcExists .
math:bszcGuard a logic:Formula ;
    logic:and math:bszcType , math:bszcHasC , math:bszcHasB , math:bszcHasA , math:bszcIncCB , math:bszcIncBA .
math:bszcType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:SimplicialComplex ] .
math:bszcHasC a logic:Formula ; logic:relation math:hasCell ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] .
math:bszcHasB a logic:Formula ; logic:relation math:hasCell ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .
math:bszcHasA a logic:Formula ; logic:relation math:hasCell ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .
math:bszcIncCB a logic:Formula ; logic:relation math:incidentTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .
math:bszcIncBA a logic:Formula ; logic:relation math:incidentTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .
math:bszcExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "bp" ] ;
    logic:exists math:bszcPartner .
math:bszcPartner a logic:Formula ;
    logic:and math:bszcHasBp , math:bszcDistinct , math:bszcIncCBp , math:bszcIncBpA .
math:bszcHasBp a logic:Formula ; logic:relation math:hasCell ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .
math:bszcDistinct a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .
math:bszcIncCBp a logic:Formula ; logic:relation math:incidentTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .
math:bszcIncBpA a logic:Formula ; logic:relation math:incidentTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "bp" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .

# Reasoning layer (coboundary dual): the same diamond traversed UPWARD, scoped to
# math:CochainComplex, so it is isolated from the boundary constraint by focus type.
math:CoboundarySquareZeroConstraint
    a logic:Constraint ;
    rdfs:label "Coboundary square-zero constraint (regular/simplicial co-diamond)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint enforcing the COMBINATORIAL half of δ∘δ = 0 on a math:CochainComplex under the induced orientation, the degree-raising dual of math:BoundarySquareZeroConstraint: every codimension-2 co-composition path (a low cell a with a coface b that is a face of c) must have a distinct partner coface b′ ≠ b that also co-composes a to c — the two intermediate cofaces of the co-diamond. Under the induced orientation the co-diamond lemma makes those two cofaces' ±1 coefficients cancel automatically, so co-diamond-completeness IS δ∘δ = 0 there; this constraint checks that completeness over the UNSIGNED math:incidentTo relation and deliberately does NOT itself read math:incidenceSign (the plain-constraint sh:SPARQLConstraint projection cannot compute a sign product). The explicit signed arithmetic over reified ±1 math:CellIncidence records is enforced by the boundary/coboundary adjunction δ = ∂* (math:BoundaryCoboundaryAdjunctionConstraint) composed with math:GeneralBoundarySquareZeroConstraint; the machine law is math:coboundarySquareZeroLaw. A lone intermediate coface (a broken co-diamond) makes δ∘δ non-zero and is ill-formed (math:BrokenCoboundarySquareZero)."@x-gmeow-english ;
    logic:formalizes math:CoboundarySquareZeroShape ;
    gmeow:enforcesFailureClass math:BrokenCoboundarySquareZero ;
    logic:message "On a math:CochainComplex a codimension-2 co-composition path (a ◁ b ◁ c) must have a distinct partner coface b′ (the co-diamond) — combinatorial completeness that, under the induced orientation, is δ∘δ = 0; a lone intermediate is a broken co-diamond (math:BrokenCoboundarySquareZero). Explicit ±1 sign cancellation is enforced by the δ = ∂* adjunction (math:BoundaryCoboundaryAdjunctionConstraint) with math:GeneralBoundarySquareZeroConstraint." ;
    logic:integrity math:cbszcForall .
math:cbszcForall a logic:Formula ;
    logic:quantifiedVariable
        [ logic:termIndex 0 ; logic:termVariable "this" ] ,
        [ logic:termIndex 1 ; logic:termVariable "a" ] ,
        [ logic:termIndex 2 ; logic:termVariable "b" ] ,
        [ logic:termIndex 3 ; logic:termVariable "c" ] ;
    logic:forall math:cbszcImpl .
math:cbszcImpl a logic:Formula ; logic:antecedent math:cbszcGuard ; logic:consequent math:cbszcExists .
math:cbszcGuard a logic:Formula ;
    logic:and math:cbszcType , math:cbszcHasA , math:cbszcHasB , math:cbszcHasC , math:cbszcIncBA , math:cbszcIncCB .
math:cbszcType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri math:CochainComplex ] .
math:cbszcHasA a logic:Formula ; logic:relation math:hasCell ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .
math:cbszcHasB a logic:Formula ; logic:relation math:hasCell ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .
math:cbszcHasC a logic:Formula ; logic:relation math:hasCell ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "c" ] .
math:cbszcIncBA a logic:Formula ; logic:relation math:incidentTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "a" ] .
math:cbszcIncCB a logic:Formula ; logic:relation math:incidentTo ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "c" ] , [ logic:termIndex 1 ; logic:termVariable "b" ] .
math:cbszcExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "bp" ] ;
    logic:exists math:cbszcPartner .
math:cbszcPartner a logic:Formula ;
    logic:and math:cbszcHasBp , math:cbszcDistinct , math:cbszcIncBpA , math:cbszcIncCBp .
math:cbszcHasBp a logic:Formula ; logic:relation math:hasCell ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .
math:cbszcDistinct a logic:Formula ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "b" ] , [ logic:termIndex 1 ; logic:termVariable "bp" ] .
math:cbszcIncBpA a logic:Formula ; logic:relation math:incidentTo ;
