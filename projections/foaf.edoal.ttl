@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/foaf> a align:Alignment ;
    rdfs:label "GMEOW → foaf (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "locatedAt a Place → foaf:based_near"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:locatedAt ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri foaf:based_near ] ;
            align:relation "<=" ;
            edoal:measure 7e-01 ],
        [ a align:Cell ;
            rdfs:label "displayable GenderIdentity value → foaf:gender (lossy; suppressed labels dropped)"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasGenderIdentity ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri foaf:gender ] ;
            align:relation "<=" ;
            edoal:measure 6e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnSelectDisplayableGender ] ],
        [ a align:Cell ;
            rdfs:label "hasWebPage → foaf:homepage (the WebPage IRI)"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasWebPage ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri foaf:homepage ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnWebPageToUrl ] ],
        [ a align:Cell ;
            rdfs:label "displayable fullName → foaf:name"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:fullName ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri foaf:name ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnSelectDisplayName ] ],
        [ a align:Cell ;
            rdfs:label "NetworkAddress (URL type) → foaf:homepage"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasNetworkAddress ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri foaf:homepage ] ;
            align:relation "<=" ;
            edoal:measure 8e-01 ],
        [ a align:Cell ;
            rdfs:label "nickname-purpose PersonName → foaf:nick"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:hasName ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri foaf:nick ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ;
            edoal:transformation [ rdfs:seeAlso gmeow:fnNicknameName ] ],
        [ a align:Cell ;
            rdfs:label "Place with coordinates → wgs84:SpatialThing (lat/long, no WKT)"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Place ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri wgs84:SpatialThing ] ;
            align:relation "<=" ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "foaf" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@en .
