@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obscore: <http://www.ivoa.net/rdf/ObsCore#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/ivoa>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Class ;
            edoal:uri gmeow:SensoryObservation ;
        ] ;
        align:entity2 [
            a edoal:Class ;
            edoal:uri obscore:ObsDataset ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.85"^^xsd:double ;
        rdfs:label "SensoryObservation → obscore:ObsDataset"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasReferenceFrame ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri obscore:coordsys ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.7"^^xsd:double ;
            rdfs:label "hasReferenceFrame → obscore:coordsys"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:observationResult ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri obscore:observable ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.7"^^xsd:double ;
            rdfs:label "math:Quantity → obscore:observable"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:vantage ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri obscore:facility ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.75"^^xsd:double ;
            rdfs:label "Sensor (telescope) → obscore:facility"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:vantage ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri obscore:instrument ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.75"^^xsd:double ;
            rdfs:label "Sensor (instrument) → obscore:instrument"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "ivoa" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → ivoa (EDOAL)"@en .
