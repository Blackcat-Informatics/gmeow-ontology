math:PCAAnalysis rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:centeringPolicy ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:scalingPolicy ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:analysisInput ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:centeringPolicy ; owl:maxQualifiedCardinality 1 ; owl:onClass math:CenteringPolicy ] ,
    [ a owl:Restriction ; owl:onProperty math:scalingPolicy ; owl:maxQualifiedCardinality 1 ; owl:onClass math:ScalingPolicy ] ,
    [ a owl:Restriction ; owl:onProperty math:covarianceOperator ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:eigensolver ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:principalComponent ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:loadingVector ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:scoreVector ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:explainedVarianceRatio ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:residualSubspace ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:IncompletePCAAnalysis .

math:ResidualInterpretationClaim rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:vantage ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:observedFeature ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:observationResult ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:ResidualMeaningAsProperty .

math:Embedding rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:embeddingSource ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:targetSpace ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:embeddingFunction ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:embeddingModel ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedEmbedding .

math:TensorComputationGraph rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:computationNode ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:MalformedTensorComputationGraph .

math:WeightTensor rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:inParameterSpace ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:inParameterSpace ; owl:maxQualifiedCardinality 1 ; owl:onClass math:ParameterSpace ] ;
    gmeow:enforcesFailureClass math:UnframedWeightTensor .

math:RationalValue rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:numerator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ,
    [ a owl:Restriction ; owl:onProperty math:denominator ; owl:maxQualifiedCardinality 1 ; owl:onDataRange xsd:integer ] ;
    gmeow:enforcesFailureClass math:ZeroDenominator .

math:Norm rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:inducedByForm ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:NonPositiveDefiniteNorm .

math:GramMatrix rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:representsForm ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:inBasis ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:representsForm ; owl:maxQualifiedCardinality 1 ; owl:onClass math:SymmetricBilinearForm ] ,
    [ a owl:Restriction ; owl:onProperty math:inBasis ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Basis ] ;
    gmeow:enforcesFailureClass math:AsymmetricGramMatrix .

math:ModelFormula rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:argumentSlot ; owl:minQualifiedCardinality 1 ; owl:onClass math:ArgumentSlot ] ;
    gmeow:enforcesFailureClass math:UnframedFunction .

math:FittedModel rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:fittedToData ; owl:minQualifiedCardinality 1 ; owl:onClass math:DatasetMatrix ] ,
    [ a owl:Restriction ; owl:onProperty math:modelFormula ; owl:minQualifiedCardinality 1 ; owl:onClass math:ModelFormula ] ;
    gmeow:enforcesFailureClass math:UnfittedModel .

math:IngestRun rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:parseSource ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty logic:instantiatesSchema ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty logic:instantiatesPlan ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:ingestCorrespondence ; owl:minQualifiedCardinality 1 ; owl:onClass logic:Correspondence ] ;
    gmeow:enforcesFailureClass math:UngroundedIngestRun .

math:Theorem rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:roleInTheory ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ;
    gmeow:enforcesFailureClass math:UngroundedTheoremClaim .


# A filtration stage pairs exactly one threshold with exactly one structure; a
# confidence interval carries its lower AND upper endpoint (min two bounds); a
# stability calibration record names exactly one derivation kind and exactly one
# guarantee. The class-scoped exact-one bounds are authored as max-qualified
# owl:Thing restrictions (the reasoner-safe class-scoped form — never a global
# owl:FunctionalProperty claim, which the math: profile forbids).
math:FiltrationStage rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:filtrationThreshold ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:stageStructure ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:StabilityCalibrationRecord rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:credenceDerivationKind ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
    [ a owl:Restriction ; owl:onProperty math:stabilityGuarantee ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

math:ConfidenceInterval rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:hasIntervalBound ; owl:minQualifiedCardinality 2 ; owl:onClass owl:Thing ] .

# A math:PiecewiseFunction requires at least one math:hasPiece (min 1, unbounded —
# a function has one or more pieces); a piecewise function with no piece is
# math:UnderspecifiedPiecewiseFunction. Authored as a bare min-qualified restriction
# exactly like math:Series/math:seriesTerm, so it needs no N-Triples max sibling.
math:PiecewiseFunction rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:hasPiece ; owl:minQualifiedCardinality 1 ; owl:onClass math:FunctionPiece ] ;
    gmeow:enforcesFailureClass math:UnderspecifiedPiecewiseFunction .

# A math:FunctionPiece requires EXACTLY ONE math:pieceDomain (a math:Interval — the
# sub-domain the piece governs) and AT MOST ONE math:pieceExpression. The pieceDomain
# max-qualified half pairs with the N-Triples min-qualified sibling in the appendix
# below (exact-one; missing → the pieceDomain gate); math:pieceExpression is 0..1.
math:FunctionPiece rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:pieceDomain ; owl:maxQualifiedCardinality 1 ; owl:onClass math:Interval ] ,
    [ a owl:Restriction ; owl:onProperty math:pieceExpression ; owl:maxQualifiedCardinality 1 ; owl:onClass math:MathematicalExpression ] .

# =========================================================================== #
# PROBABILITY LAYER — Kolmogorov spine, distributions, dependency models,      #
# the logic: lowering seam, and the probability conformance-failure vocabulary #
# (realizes design/MATHEMATICS-PROBABILITY.md).                                #
# =========================================================================== #

# --- Probability-space classes (the Kolmogorov triple, specialized) --------- #

math:ProbabilitySpace
    a owl:Class ;
    rdfs:subClassOf math:MeasurableSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability Space"@x-gmeow-english ;
    skos:definition "A probability space: the Kolmogorov triple (Ω, ℱ, P) made explicit as one object — a sample space Ω named through math:sampleSpace (a math:SampleSpace), an event σ-algebra ℱ named through math:eventSigmaAlgebra (a math:SigmaAlgebra), and a probability measure P named through math:probabilityMeasure (a math:ProbabilityMeasure). A subclass of math:MeasurableSpace carrying a probability measure — the probability charter SPECIALIZES the measure-theoretic bedrock rather than re-minting it. Each of the three components must be present, but any of them may be symbolic or generative (a math:SymbolicSampleSpace, a math:BorelSigmaAlgebra, a math:MeasureDefinitionExpression) rather than extensionally enumerated; a probability space missing any of the three components is ill-formed (math:IncompleteProbabilitySpace). The gate requires presence and structural completeness, never impossible enumeration."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SampleSpace
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Sample Space"@x-gmeow-english ;
    skos:definition "A sample space Ω: the set of all possible outcomes of a probabilistic experiment — the underlying set of a math:ProbabilitySpace, named through math:sampleSpace. A subclass of math:Set; because a σ-algebra is rarely extensionally enumerable, a sample space may be given generatively (math:GeneratedSampleSpace) or symbolically (math:SymbolicSampleSpace) rather than by listing its members. An outcome is a point of Ω; a measurable set of outcomes is a math:ProbabilityEvent, not a point."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:GeneratedSampleSpace
    a owl:Class ;
    rdfs:subClassOf math:SampleSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Generated Sample Space"@x-gmeow-english ;
    skos:definition "A sample space whose outcomes are produced by a generative rule rather than enumerated — the outcomes of an unbounded sequence of coin flips, the paths of a process. A subclass of math:SampleSpace realizing the charter's allowance that the components of a probability space may be generative rather than extensional; presence of the generative description satisfies the completeness gate, and no impossible enumeration is demanded."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:SymbolicSampleSpace
    a owl:Class ;
    rdfs:subClassOf math:SampleSpace ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Symbolic Sample Space"@x-gmeow-english ;
    skos:definition "A sample space named symbolically — ℝ, ℝⁿ, a manifold, a function space — rather than by listing its outcomes. A subclass of math:SampleSpace realizing the charter's allowance that a probability space's components may be symbolic; a continuous sample space such as the real line is a math:SymbolicSampleSpace carrying a math:BorelSigmaAlgebra and a measure given by a math:MeasureDefinitionExpression."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProbabilityEvent
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability Event"@x-gmeow-english ;
    skos:definition "A probability event: a measurable subset of a sample space — a MEASURABLE SET OF OUTCOMES, in the measure-theoretic sense, situated in a space through math:eventInSpace and assigned a framed probability through math:probabilityOfEvent. A subclass of math:Set. It is held owl:disjointWith logic:Event because a logic:Event is an occurrent (something that happens in time) whereas a probability event is a set of outcomes: a rain occurrence and the rain event-set in a forecast space are never conflated. Membership of an event in the space's algebra is math:eventInSpace against the space's math:eventSigmaAlgebra; there is NO separate EventSet class — the σ-algebra is the sole event algebra."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:enforcesFailureClass math:ProbabilityEventOccurrentConflation .

math:BorelSigmaAlgebra
    a owl:Class ;
    rdfs:subClassOf math:SigmaAlgebra ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Borel σ-Algebra"@x-gmeow-english ;
    skos:definition "The Borel σ-algebra of a topological space: the σ-algebra generated by its open sets. A subclass of math:SigmaAlgebra given symbolically by its generator rather than by enumerating its measurable sets — the canonical event algebra of a continuous math:SymbolicSampleSpace such as the real line, over which a math:LebesgueMeasure or a density-defined measure acts."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PowerSetSigmaAlgebra
    a owl:Class ;
    rdfs:subClassOf math:SigmaAlgebra ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Power-Set σ-Algebra"@x-gmeow-english ;
    skos:definition "The discrete (power-set) σ-algebra: the σ-algebra of ALL subsets of a set, 2^Ω. A subclass of math:SigmaAlgebra — the event algebra of a discrete or countable sample space, where every subset is measurable, over which a math:CountingMeasure-derived probability mass function acts."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProductSigmaAlgebra
    a owl:Class ;
    rdfs:subClassOf math:SigmaAlgebra ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Product σ-Algebra"@x-gmeow-english ;
    skos:definition "The product σ-algebra on a product space: the σ-algebra generated by the measurable rectangles of a product of measurable spaces. A subclass of math:SigmaAlgebra given symbolically by its factors rather than enumerated — the event algebra of a joint sample space, the measure-theoretic ground of a math:JointProbabilityTable and of the independence factorization a math:FullIndependenceModel asserts."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MeasureDefinitionExpression
    a owl:Class ;
    rdfs:subClassOf math:MathematicalExpression ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Measure Definition Expression"@x-gmeow-english ;
    skos:definition "An expression that DEFINES a measure rather than tabulating it: a density or mass function, a Radon–Nikodym derivative, an integral expression from the expression layer that gives the measure of a set. A subclass of math:MathematicalExpression (an AST, never a display string) — the symbolic carrier of the probability measure of a math:SymbolicSampleSpace, satisfying the presence requirement of a probability space without demanding an impossible enumeration of P over every measurable set."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Probability-space properties ------------------------------------------- #

math:sampleSpace
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "sample space"@x-gmeow-english ;
    skos:definition "Names the sample space Ω of a probability space. Domain math:ProbabilitySpace, range math:SampleSpace (stated in prose). Every math:ProbabilitySpace names one; the sample space may be symbolic or generative but never absent — a space missing it is ill-formed (math:IncompleteProbabilitySpace)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:eventSigmaAlgebra
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "event σ-algebra"@x-gmeow-english ;
    skos:definition "Names the event σ-algebra ℱ of a probability space — the algebra of measurable sets against which event membership is decided. Domain math:ProbabilitySpace, range math:SigmaAlgebra (stated in prose). Every math:ProbabilitySpace names one (extensional or symbolic, e.g. a math:BorelSigmaAlgebra); a space missing it is ill-formed (math:IncompleteProbabilitySpace). The σ-algebra is the sole event algebra — there is no separate EventSet class."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:probabilityMeasure
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "probability measure"@x-gmeow-english ;
    skos:definition "Names the probability measure P of a probability space — the math:ProbabilityMeasure of total mass one assigning probabilities to the events of its σ-algebra. Domain math:ProbabilitySpace, range math:ProbabilityMeasure (stated in prose). Every math:ProbabilitySpace names one, possibly given by a math:MeasureDefinitionExpression; a space missing it is ill-formed (math:IncompleteProbabilitySpace)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:eventInSpace
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "event in space"@x-gmeow-english ;
    skos:definition "Situates a probability event in the probability space it is a measurable set of outcomes of. Domain math:ProbabilityEvent, range math:ProbabilitySpace (stated in prose). Membership of the event in the algebra is decided against the space's math:eventSigmaAlgebra; the event is a set of outcomes, not an occurrent (it is disjoint from logic:Event)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:probabilityOfEvent
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "probability of event"@x-gmeow-english ;
    skos:definition "Relates a probability event to the framed probability value P(A) assigned to it. Domain math:ProbabilityEvent, range math:ProbabilityValue (stated in prose). The probability is a framed quantity object naming its probability frame or model, never a bare literal (math:UnframedProbabilityValue) and never inferred from a confidence score without a declared mapping (math:ConfidenceAsProbability)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Probability-value scale kinds (the [0,1] gate and its lawful scales) ---- #

math:ProbabilityValue
    a owl:Class ;
    logic:subClassOf math:Quantity ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:hasValue math:dimensionless ;
        ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability Value"@x-gmeow-english ;
    skos:definition "A probability value: a quantity/result object that is ALWAYS in the closed unit interval [0, 1], carrying its magnitude and naming its probability frame or model. A subclass of math:Quantity (a probability is math:dimensionless). Where exact, it is carried as a math:RationalValue with math:isExact true (the exact/approximate split — 1/3, not 0.333); where empirical it may be an approximate value. The [0, 1] bound is a genuine hard fail enforced by SHACL and a native numeric check (math:ProbabilityOutOfBounds); odds and log-odds are NOT probabilities and are their own kinds (math:OddsValue, math:LogOddsValue), held disjoint from this class so a consumer seeing a math:ProbabilityValue may correctly assume a closed unit interval."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:enforcesFailureClass math:ProbabilityScaleConflation .

math:OddsValue
    a owl:Class ;
    logic:subClassOf math:Quantity ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:hasValue math:dimensionless ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:minQualifiedCardinality 1 ;
            logic:onClass owl:Thing ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:allValuesFrom math:Dimension ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:maxQualifiedCardinality 1 ;
            logic:onClass owl:Thing ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:maxQualifiedCardinality 1 ;
            logic:onClass math:Dimension ;
        ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Odds Value"@x-gmeow-english ;
    skos:definition "An odds value: p/(1−p), a quantity in the open interval (0, ∞). A subclass of math:Quantity and a probability-scale transform of a probability, NOT a probability — held owl:disjointWith math:ProbabilityValue so it can never be read as one (math:ProbabilityScaleConflation). It links back to the probability it transforms through a math:ProbabilityScaleTransform."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LogOddsValue
    a owl:Class ;
    logic:subClassOf math:Quantity ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:hasValue math:dimensionless ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:minQualifiedCardinality 1 ;
            logic:onClass owl:Thing ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:allValuesFrom math:Dimension ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:maxQualifiedCardinality 1 ;
            logic:onClass owl:Thing ;
        ] ,
        [
            a logic:Restriction ;
            logic:onProperty math:hasDimension ;
            logic:maxQualifiedCardinality 1 ;
            logic:onClass math:Dimension ;
        ] ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Log-Odds Value"@x-gmeow-english ;
    skos:definition "A log-odds (logit) value: log(p/(1−p)), a quantity on the whole real line (−∞, ∞). A subclass of math:Quantity and a probability-scale transform of a probability, NOT a probability — held owl:disjointWith math:ProbabilityValue so a log-odds handed to a consumer expecting [0, 1] is a caught error (math:ProbabilityScaleConflation), not a silent one. It links back to the probability it transforms through a math:ProbabilityScaleTransform."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProbabilityScaleTransform
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability Scale Transform"@x-gmeow-english ;
    skos:definition "A probability-scale transform: the object linking a lawful probability-scale value (a math:OddsValue or math:LogOddsValue) back to the math:ProbabilityValue it re-expresses, through math:transformsToProbabilityValue. A subclass of math:MathematicalObject. It is what keeps the [0, 1] gate a genuine hard fail while still admitting odds and log-odds: the scales are related to their probability by a declared transform, never conflated with it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:transformsToProbabilityValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "transforms to probability value"@x-gmeow-english ;
    skos:definition "Relates a math:ProbabilityScaleTransform to the math:ProbabilityValue it re-expresses. Domain math:ProbabilityScaleTransform, range math:ProbabilityValue (stated in prose). The seam by which a math:OddsValue or math:LogOddsValue recovers its probability without being typed as one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Random variables, distributions, factored parameterization, moments ---- #

math:RandomVariable
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Random Variable"@x-gmeow-english ;
    skos:definition "A random variable: a measurable map from a probability space's sample space into a measurable codomain, with a declared domain (math:randomVariableDomain) and codomain (math:randomVariableCodomain) and a probability-space or distribution context (math:hasDistribution). A subclass of math:MathematicalObject. Its dimensional constraints are CARRIED, not assumed — a random variable over height and its distribution's location parameter share height units — so a mis-dimensioned parameter is a caught error. A random variable without its domain, codomain, and a space or distribution context is ill-formed (math:UnscopedRandomVariable)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:enforcesFailureClass math:UnscopedRandomVariable .

math:DistributionFamily
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Distribution Family"@x-gmeow-english ;
    skos:definition "A distribution family: the named parametric family a math:Distribution belongs to — normal, binomial, Poisson, gamma, and the rest — carried by math:distributionFamily. A subclass of math:MathematicalObject. A family fixes the functional form but NOT the convention: many families have several conventional parameterizations (mean/stddev vs mean/variance vs mean/precision), so a bare family label is insufficient and a distribution must also name a math:DistributionParameterization. A distribution without a family is ill-formed (math:MissingDistributionParameterization)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DistributionParameterization
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Distribution Parameterization"@x-gmeow-english ;
    skos:definition "A distribution parameterization: the explicit, mandatory convention that fixes WHICH parametric form of a family is meant, declaring the roles it requires through math:requiresParameterRole (e.g. a normal mean/stddev parameterization requires a mean role and a stddev role). A subclass of math:MathematicalObject. Roles are SCOPED by the parameterization, so 'scale' cannot silently mean standard deviation in one family and rate in another. Linking two parameterization conventions of the same family (mean/variance to mean/stddev) is a DECLARED transform — a math:MathematicalExpression such as σ = √(σ²) — never a string relabel; a silent default parameterization is forbidden (math:MissingDistributionParameterization)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DistributionParameter
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Distribution Parameter"@x-gmeow-english ;
    skos:definition "A distribution parameter: one supplied parameter of a math:Distribution, carrying its role in the parameterization (math:parameterRole, a math:DistributionParameterRole) and its value as EITHER a numeric quantity (math:parameterQuantity, a math:Quantity) OR a symbolic expression (math:parameterExpression, a math:MathematicalExpression). A subclass of math:MathematicalObject. The earlier single overloaded parameterValue property is REMOVED (greenfield): the role, the numeric value, and the symbolic value are three distinct properties, never one. Each required role is supplied by exactly one parameter (math:DistributionParameterRoleCardinality otherwise), whose quantity satisfies the role's positivity and dimension constraints (math:DistributionParameterConstraint otherwise)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DistributionParameterRole
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Distribution Parameter Role"@x-gmeow-english ;
    skos:definition "A distribution parameter role: the SCOPED slot a parameter fills within a parameterization — the mean role, the stddev role, the rate role — named as a first-class object so 'scale' cannot silently mean different things across families. A subclass of math:MathematicalObject. It declares the parameterization it belongs to (math:roleWithinParameterization), whether its parameter's value must be positive (math:requiresPositiveValue, a boolean), and the dimension its parameter's quantity must carry (math:quantityDimension) — so a variance role carrying squared units and a correlation role being dimensionless are stated, not assumed, and a mis-dimensioned parameter is caught (math:DistributionParameterConstraint)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DistributionSupport
    a owl:Class ;
    rdfs:subClassOf math:Set ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Distribution Support"@x-gmeow-english ;
    skos:definition "The support of a distribution: the set of outcomes over which a math:Distribution places positive probability — the real line for a normal, the non-negative integers for a Poisson, [0, 1] for a beta — named by math:hasSupport. A subclass of math:Set, possibly symbolic. A distribution carries its support so that a parameter or a moment can be checked for consistency with the values the distribution actually ranges over."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Moment
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Moment"@x-gmeow-english ;
    skos:definition "A moment of a distribution or random variable: a quantity-valued summary — an expectation, a variance, a covariance, a correlation — named through math:hasMoment. A subclass of math:MathematicalObject and the parent of math:ExpectedValue, math:Variance, math:Covariance, and math:Correlation. A moment is a QUANTITY-valued result object carrying its dimension, never a bare literal: an expectation over height carries height units, a variance squared units, a correlation is dimensionless."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ExpectedValue
    a owl:Class ;
    rdfs:subClassOf math:Moment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Expected Value"@x-gmeow-english ;
    skos:definition "The expected value E[X]: the first moment of a random variable, the integral of the variable against its probability measure (a math:Integral against a math:ProbabilityMeasure). A subclass of math:Moment. It carries the same dimension as the random variable it is taken over."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Variance
    a owl:Class ;
    rdfs:subClassOf math:Moment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Variance"@x-gmeow-english ;
    skos:definition "The variance Var(X) = E[(X − E[X])²]: the second central moment of a random variable. A subclass of math:Moment. It carries the SQUARED dimension of the random variable — a variance of a height carries length², which is why a variance-parameterized family and a stddev-parameterized family carry different dimensions on their scale role."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Covariance
    a owl:Class ;
    rdfs:subClassOf math:Moment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Covariance"@x-gmeow-english ;
    skos:definition "The covariance Cov(X, Y) = E[(X − E[X])(Y − E[Y])]: the joint second central moment of two random variables. A subclass of math:Moment. It carries the product of the dimensions of its two variables."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:Correlation
    a owl:Class ;
    rdfs:subClassOf math:Moment ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Correlation"@x-gmeow-english ;
    skos:definition "The correlation ρ(X, Y) = Cov(X, Y) / (σ_X σ_Y): the covariance normalized by the product of standard deviations, a math:dimensionless quantity in [−1, 1]. A subclass of math:Moment. Being dimensionless is a stated dimensional fact, not an assumption."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:randomVariableDomain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "random variable domain"@x-gmeow-english ;
    skos:definition "Names the domain of a random variable — the measurable space (typically the sample space of a probability space) it is defined on. Domain math:RandomVariable, range math:MeasurableSpace or math:ProbabilitySpace (stated in prose). A random variable without its domain is ill-formed (math:UnscopedRandomVariable)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:randomVariableCodomain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "random variable codomain"@x-gmeow-english ;
    skos:definition "Names the codomain of a random variable — the measurable space it maps into (the real line with its Borel algebra for a real-valued variable). Domain math:RandomVariable, range math:MeasurableSpace (stated in prose). A random variable without its codomain is ill-formed (math:UnscopedRandomVariable)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasDistribution
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has distribution"@x-gmeow-english ;
    skos:definition "Relates a random variable to the math:Distribution it follows. Domain math:RandomVariable, range math:Distribution (stated in prose). One of the ways a random variable declares its probability context (the other being a probability-space domain); a variable with neither is unscoped (math:UnscopedRandomVariable)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasSupport
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has support"@x-gmeow-english ;
    skos:definition "Relates a math:Distribution to its math:DistributionSupport — the set of outcomes it places positive probability on. Domain math:Distribution, range math:DistributionSupport (stated in prose). The support may be symbolic (the real line, the non-negative integers)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasMoment
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has moment"@x-gmeow-english ;
    skos:definition "Relates a math:Distribution or math:RandomVariable to a math:Moment of it — an expectation, variance, covariance, or correlation. Domain a math:Distribution or math:RandomVariable, range math:Moment (stated in prose). Moments are quantity-valued result objects carrying their dimension, never bare literals."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:distributionParameterization
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "distribution parameterization"@x-gmeow-english ;
    skos:definition "Relates a math:Distribution to the math:DistributionParameterization it uses — the explicit convention fixing which parametric form of its family is meant. Domain math:Distribution, range math:DistributionParameterization (stated in prose). Mandatory for a parametric distribution: a parametric distribution without a parameterization is ill-formed (math:MissingDistributionParameterization), and a silent default is forbidden. Linking one parameterization convention to another of the same family is a declared math:MathematicalExpression transform, never a string relabel."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasDistributionParameter
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has distribution parameter"@x-gmeow-english ;
    skos:definition "Relates a math:Distribution to one of its supplied math:DistributionParameter objects. Domain math:Distribution, range math:DistributionParameter (stated in prose). A distribution supplies each role required by its parameterization exactly once (math:DistributionParameterRoleCardinality otherwise)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:parameterQuantity
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "parameter quantity"@x-gmeow-english ;
    skos:definition "Relates a math:DistributionParameter to its numeric value as a dimensioned quantity. Domain math:DistributionParameter, range math:Quantity (stated in prose). One of the two mutually exclusive value carriers of a parameter (the other being math:parameterExpression for a symbolic value); it replaces the removed overloaded parameterValue property, and its quantity must satisfy the role's positivity and dimension constraints (math:DistributionParameterConstraint otherwise)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:parameterExpression
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "parameter expression"@x-gmeow-english ;
    skos:definition "Relates a math:DistributionParameter to its value as a symbolic expression — a math:MathematicalExpression AST for a parameter given by a formula (a hierarchical prior's hyperparameter, a reparameterization σ = √(σ²)). Domain math:DistributionParameter, range math:MathematicalExpression (stated in prose). The symbolic counterpart of math:parameterQuantity; a reparameterization is carried here as a declared transform, never a string relabel."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:parameterRole
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "parameter role"@x-gmeow-english ;
    skos:definition "Relates a math:DistributionParameter to the math:DistributionParameterRole it fills within its distribution's parameterization. Domain math:DistributionParameter, range math:DistributionParameterRole (stated in prose). The role is scoped by the parameterization, so the same parameter object never silently means different things across families."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:requiresParameterRole
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "requires parameter role"@x-gmeow-english ;
    skos:definition "Relates a math:DistributionParameterization to a math:DistributionParameterRole it requires — the roles a conforming distribution must supply exactly once each. Domain math:DistributionParameterization, range math:DistributionParameterRole (stated in prose). A distribution that fails to supply a required role exactly once is ill-formed (math:DistributionParameterRoleCardinality)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:roleWithinParameterization
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "role within parameterization"@x-gmeow-english ;
    skos:definition "Relates a math:DistributionParameterRole to the math:DistributionParameterization that scopes it. Domain math:DistributionParameterRole, range math:DistributionParameterization (stated in prose). The scoping edge that makes a role's meaning local to its parameterization rather than global."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:requiresPositiveValue
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "requires positive value"@x-gmeow-english ;
    skos:definition "Declares whether the parameter filling a role must be strictly positive — true for a standard-deviation, variance, rate, or precision role. Domain math:DistributionParameterRole, range xsd:boolean (stated in prose). A parameter whose quantity violates its role's declared positivity is ill-formed (math:DistributionParameterConstraint)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:quantityDimension
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "quantity dimension"@x-gmeow-english ;
    skos:definition "Names the dimension the quantity of a parameter filling a role must carry — the same dimension as the random variable for a location role, the squared dimension for a variance role, math:dimensionless for a correlation role. Domain math:DistributionParameterRole, range math:Dimension or a math:RoleDimensionRelation (stated in prose; a dimension may be given absolutely, or by reference to the random variable's dimension). It carries the parameter's dimensional constraint so a mis-dimensioned parameter is caught (math:DistributionParameterConstraint), not silently accepted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:RoleDimensionRelation
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Role Dimension Relation"@x-gmeow-english ;
    skos:definition "A relational specification of a parameter role's required dimension, stated RELATIVE to the random variable's dimension rather than as an absolute math:Dimension. The canonical relations are math:sameAsRandomVariableDimension (a location parameter shares the random variable's dimension), math:squareOfRandomVariableDimension (a variance parameter carries the squared dimension), and — for a dimensionless parameter such as a correlation — the absolute math:dimensionless. The native math:DistributionParameterConstraint validator resolves a role's math:quantityDimension against the actual random-variable dimension by exact ℚ⁷ arithmetic (dimEqual for same, dimProduct of the vector with itself for square), so a variance parameter given linear units is a caught error."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:sameAsRandomVariableDimension
    a owl:NamedIndividual , math:RoleDimensionRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "same as random-variable dimension"@x-gmeow-english ;
    skos:definition "The role-dimension relation for a location-like parameter whose quantity must carry the SAME dimension as the random variable it parameterizes (dimEqual): a location parameter of a distribution over height carries height units. Resolved by the native math:DistributionParameterConstraint validator against the random variable's math:hasDimension."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:squareOfRandomVariableDimension
    a owl:NamedIndividual , math:RoleDimensionRelation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "square of random-variable dimension"@x-gmeow-english ;
    skos:definition "The role-dimension relation for a variance-like parameter whose quantity must carry the SQUARED dimension of the random variable (the exact-rational sum of the random variable's exponent vector with itself, dimProduct): a variance parameter of a distribution over height carries height² units. Resolved by the native math:DistributionParameterConstraint validator; a variance parameter given the linear (un-squared) dimension is a caught error."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

# --- Conditioning and three-state independence ------------------------------ #

math:ConditionalProbability
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Conditional Probability"@x-gmeow-english ;
    skos:definition "A conditional probability P(A | B): a probability object naming BOTH the event it is about and the conditioning event or context it is conditioned on (math:conditionalOn). A subclass of math:MathematicalObject. A conditional with an unnamed conditioning context is ill-formed (math:UnconditionedAssertion) — the conditioning context is never left implicit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:enforcesFailureClass math:UnconditionedAssertion .

math:IndependenceAssertion
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Independence Assertion"@x-gmeow-english ;
    skos:definition "A marginal-independence assertion: a modeler's claim that A and B (or a set of facts) are independent, naming its subject (math:independenceSubject) and what it is independent of (math:independentOf, or math:mutuallyIndependentSet for a joint set). A subclass of math:MathematicalObject. Independence is a STANDPOINT-SCOPED claim, not a fact of the graph: the assertion is held by whoever asserted the model and names the model it holds in (math:independenceHoldsInModel, held by a gmeow:vantage), so 'who claimed these independent, and in which model' is always answerable. The ABSENCE of any independence assertion is 'not modeled' — a real, distinct third state that a reasoning engine must NEVER read as independence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ConditionalIndependenceAssertion
    a owl:Class ;
    rdfs:subClassOf math:IndependenceAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Conditional Independence Assertion"@x-gmeow-english ;
    skos:definition "A conditional-independence assertion A ⫫ B | C: an independence assertion that additionally names the conditioning set it is relative to (math:independentGiven). A subclass of math:IndependenceAssertion. Like marginal independence it is a standpoint-scoped modeler's claim naming its model; distinct from marginal independence (a different, weaker-or-stronger relation), and distinct again from 'not modeled'. A conditional-independence assertion that fails to name its conditioning set is ill-formed (math:UnconditionedAssertion)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:enforcesFailureClass math:UnconditionedAssertion .

math:conditionalOn
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "conditional on"@x-gmeow-english ;
    skos:definition "Names the conditioning event or context of a conditional probability — the B in P(A | B). Domain math:ConditionalProbability, range a math:ProbabilityEvent or conditioning context (stated in prose). A conditional probability names one; a conditional with an unnamed conditioning context is ill-formed (math:UnconditionedAssertion)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:independenceSubject
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "independence subject"@x-gmeow-english ;
    skos:definition "Names the subject of an independence assertion — the A whose independence is claimed. Domain math:IndependenceAssertion, range a math:ProbabilityEvent or math:RandomVariable (stated in prose)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:independentOf
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "independent of"@x-gmeow-english ;
    skos:definition "Names the event or variable an independence subject is asserted independent of — the B in A ⫫ B. Domain math:IndependenceAssertion, range a math:ProbabilityEvent or math:RandomVariable (stated in prose). Used for pairwise marginal independence; a set of mutually independent facts uses math:mutuallyIndependentSet instead."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:independentGiven
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "independent given"@x-gmeow-english ;
    skos:definition "Names the conditioning set of a conditional-independence assertion — the C in A ⫫ B | C. Domain math:ConditionalIndependenceAssertion, range the conditioning set (stated in prose). A conditional-independence assertion that fails to name its conditioning set is ill-formed (math:UnconditionedAssertion)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:mutuallyIndependentSet
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "mutually independent set"@x-gmeow-english ;
    skos:definition "Names the set of facts an independence assertion claims MUTUALLY independent — a stronger claim than pairwise independence over the same facts. Domain math:IndependenceAssertion, range the set of mutually independent events or variables (stated in prose). The joint-set form of math:independentOf."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:independenceHoldsInModel
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "independence holds in model"@x-gmeow-english ;
    skos:definition "Names the model an independence assertion holds in — the dependency model, probability model, or standpoint within which the claimed independence is asserted. Domain math:IndependenceAssertion, range the model it holds in (stated in prose). Independence is a modeler's claim from a vantage (the assertion is held by a gmeow:vantage), not a fact of the graph, so an independence claim always names the model it holds in and never floats free of one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- Dependency models, the Bayesian update chain, and MCMC diagnostics ------ #

math:FullIndependenceModel
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Full Independence Model"@x-gmeow-english ;
    skos:definition "A full-independence dependency model: the model under which every probabilistic fact is an independent variable and the joint factorizes as a product. A subclass of math:MathematicalObject. It lowers into logic:FullIndependence (math:probabilityModelLowering) with logic:ExactPreservation, exact precisely when its completeness gate holds — all probabilistic facts named. Made explicit rather than assumed: a reasoning engine never treats silence as full independence."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:JointProbabilityTable
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Joint Probability Table"@x-gmeow-english ;
    skos:definition "A joint probability table: an explicit tabulation of the joint distribution over a correlated set of facts. A subclass of math:MathematicalObject. It lowers into logic:DependencyModel together with a set of logic:JointOutcome rows (math:probabilityModelLowering) with logic:ExactPreservation, exact if and only if its completeness gate holds — the outcomes are present (exhaustive) and their mass sums to one. An incompletely-tabulated table is structurally incomplete (math:IncompleteDependencyModel)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:BayesianNetwork
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Bayesian Network"@x-gmeow-english ;
    skos:definition "A Bayesian network: a directed acyclic graph of random variables with conditional probability tables, factoring a joint distribution as a product of local conditionals. A subclass of math:MathematicalObject naming its graph through math:dependencyGraph. It lowers into logic:DependencyModel (a weighted-model-counting factorization) via math:probabilityModelLowering; its declared logic:ExactPreservation is honest only when its completeness gate holds — the graph is a DAG and the conditional probability tables are complete — and is otherwise structurally incomplete (math:IncompleteDependencyModel). Declaring exactness while the gate fails is the overclaim math:ExactPreservationViolated."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:FactorGraph
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Factor Graph"@x-gmeow-english ;
    skos:definition "A factor graph: a bipartite graph of variables and factors representing the factorization of a joint distribution as a product of factors. A subclass of math:MathematicalObject naming its structure through math:dependencyGraph. It lowers into logic:DependencyModel (a weighted factor product) via math:probabilityModelLowering; its declared logic:ExactPreservation is honest only when its completeness gate holds — finitely many factors, and the product either normalized or declared unnormalized — and is otherwise structurally incomplete (math:IncompleteDependencyModel)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MarkovKernel
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Markov Kernel"@x-gmeow-english ;
    skos:definition "A Markov kernel: a measurable map assigning to each point of a source space a probability measure on a target space — the general-theory counterpart of a transition matrix. A subclass of math:MathematicalObject. It lowers into logic:GenericDependence (a stochastic transition) via math:probabilityModelLowering; its declared logic:ExactPreservation is honest only when its completeness gate holds — a declared domain and codomain, and kernel totality (each source point maps to a genuine probability measure) — and is otherwise structurally incomplete (math:IncompleteDependencyModel)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:StochasticProcess
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Stochastic Process"@x-gmeow-english ;
    skos:definition "A stochastic process: an indexed family of random variables {X_t} over a common probability space — a Markov chain, a Poisson process, Brownian motion. A subclass of math:MathematicalObject. Its transition structure is often carried by a math:MarkovKernel, and its dependency structure feeds the logic: probability-model seam like the other dependency models."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PriorDistribution
    a owl:Class ;
    rdfs:subClassOf math:Distribution ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Prior Distribution"@x-gmeow-english ;
    skos:definition "A prior distribution: the distribution over a parameter BEFORE data is taken into account, the input of a Bayesian update. A subclass of math:Distribution. It is a distinct first-class object linked into the update chain through math:hasPrior, so a posterior always answers 'from what prior'."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:LikelihoodFunction
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Likelihood Function"@x-gmeow-english ;
    skos:definition "A likelihood function L(θ) = P(data | θ): the probability of the observed data as a function of the parameter, the evidence term of a Bayesian update. A subclass of math:MathematicalObject (it is a function of the parameter, not itself a normalized distribution over it). It is linked into the update chain through math:hasLikelihood, so a posterior always answers 'under what likelihood, over what data'."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PosteriorDistribution
    a owl:Class ;
    rdfs:subClassOf math:Distribution ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Posterior Distribution"@x-gmeow-english ;
    skos:definition "A posterior distribution: the distribution over a parameter AFTER data, proportional to prior times likelihood, the output of a Bayesian update. A subclass of math:Distribution. It is linked to the prior and likelihood it derives from through math:hasPrior and math:hasLikelihood, so a posterior always answers 'from what prior, under what likelihood, over what data'. Where it is sampled rather than closed-form, its trustworthiness is answerable through math:PosteriorSample and the chain diagnostics."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:PosteriorSample
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Posterior Sample"@x-gmeow-english ;
    skos:definition "A posterior sample: the set of draws approximating a math:PosteriorDistribution when the posterior is sampled rather than computed in closed form — the output of a math:MCMCRun. A subclass of math:MathematicalObject. Its trustworthiness is not assumed but answerable through the math:ChainDiagnostic objects (effective sample size, R-hat, divergences) attached to its run."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MCMCRun
    a owl:Class ;
    rdfs:subClassOf gmeow:Activity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "MCMC Run"@x-gmeow-english ;
    skos:definition "A Markov-chain Monte Carlo run: the sampling PROCESS that draws a math:PosteriorSample from a posterior. A subclass of gmeow:Activity (the run is a process, distinct from its result sample and from any claim about the posterior). It produces the chain diagnostics by which 'is this posterior trustworthy' is answered rather than assumed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ChainDiagnostic
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Chain Diagnostic"@x-gmeow-english ;
    skos:definition "A chain diagnostic: a computed measure of the health of a math:MCMCRun's sampling — the parent of math:EffectiveSampleSize, math:RHat, and math:DivergenceDiagnostic. A subclass of math:MathematicalObject. Diagnostics make the trustworthiness of a sampled posterior answerable structurally rather than assumed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:EffectiveSampleSize
    a owl:Class ;
    rdfs:subClassOf math:ChainDiagnostic ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Effective Sample Size"@x-gmeow-english ;
    skos:definition "The effective sample size: the number of effectively independent draws in a correlated MCMC chain, discounting autocorrelation. A subclass of math:ChainDiagnostic. A low effective sample size warns that a posterior summary rests on far fewer independent draws than the raw sample count suggests."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:RHat
    a owl:Class ;
    rdfs:subClassOf math:ChainDiagnostic ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "R-hat"@x-gmeow-english ;
    skos:definition "The potential-scale-reduction factor R̂: the between-chain versus within-chain variance ratio diagnosing whether multiple MCMC chains have converged to the same distribution. A subclass of math:ChainDiagnostic. An R̂ far from one warns that the chains have not mixed and the sampled posterior is not trustworthy."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DivergenceDiagnostic
    a owl:Class ;
    rdfs:subClassOf math:ChainDiagnostic ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Divergence Diagnostic"@x-gmeow-english ;
    skos:definition "A divergence diagnostic: the count or record of divergent transitions in a Hamiltonian/NUTS MCMC run, flagging regions of the posterior the sampler could not explore reliably. A subclass of math:ChainDiagnostic. Divergences warn of bias the raw sample would otherwise hide."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:hasPrior
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has prior"@x-gmeow-english ;
    skos:definition "Relates a Bayesian update (or its math:PosteriorDistribution) to the math:PriorDistribution it starts from. Domain a math:PosteriorDistribution or Bayesian update, range math:PriorDistribution (stated in prose). Names the prior a posterior derives from, so the update chain is always traceable to its input."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasLikelihood
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has likelihood"@x-gmeow-english ;
    skos:definition "Relates a Bayesian update (or its math:PosteriorDistribution) to the math:LikelihoodFunction weighting the prior by the data. Domain a math:PosteriorDistribution or Bayesian update, range math:LikelihoodFunction (stated in prose). Names the likelihood under which the update was performed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:hasPosterior
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has posterior"@x-gmeow-english ;
    skos:definition "Relates a Bayesian update — or a Bayesian interval estimate (a math:CredibleInterval / math:CredibleRegion) that summarizes it — to the math:PosteriorDistribution it produces or is taken over. Domain a Bayesian update or a credible interval/region, range math:PosteriorDistribution (stated in prose). Names the posterior resulting from combining the prior and likelihood, and the posterior context a credible interval's math:credibleMass is a probability over; a credible interval naming no posterior is ill-formed (math:IncompleteCredibleInterval)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:dependencyGraph
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "dependency graph"@x-gmeow-english ;
    skos:definition "Relates a dependency model to the graph structure carrying its dependencies — the DAG of a math:BayesianNetwork, the bipartite graph of a math:FactorGraph. Domain a dependency model (math:BayesianNetwork, math:FactorGraph, and kin), range its graph structure (stated in prose). Structural completeness of this graph (a DAG, finite factors) is part of the model's completeness gate; an incomplete one is ill-formed (math:IncompleteDependencyModel)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:kernelDomain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "kernel domain"@x-gmeow-english ;
    skos:definition "Names the source (domain) measurable space of a math:MarkovKernel — the space whose points the kernel assigns a transition measure to. Domain math:MarkovKernel, range a measurable space (stated in prose). A Markov kernel declares both a math:kernelDomain and a math:kernelCodomain; one missing either is structurally incomplete (math:IncompleteDependencyModel)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:kernelCodomain
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "kernel codomain"@x-gmeow-english ;
    skos:definition "Names the target (codomain) measurable space of a math:MarkovKernel — the space on which each source point's transition probability measure lives. Domain math:MarkovKernel, range a measurable space (stated in prose). A Markov kernel declares both a math:kernelCodomain and a math:kernelDomain; one missing either is structurally incomplete (math:IncompleteDependencyModel)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:probabilityModelLowering
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "probability model lowering"@x-gmeow-english ;
    skos:definition "Relates a reasoning-facing math: dependency model (a class or individual — a math:FullIndependenceModel, math:JointProbabilityTable, math:BayesianNetwork, math:FactorGraph, or math:MarkovKernel) to the logic: probability-model target it formally lowers into (logic:FullIndependence, logic:DependencyModel, logic:JointOutcome, or logic:GenericDependence). Domain a reasoning-facing math: dependency model, range a logic: probability-model target (stated in prose). The lowering is a formal, preservation-judged map, not a soft 'satisfy or project into': its preservation polarity is carried ALONGSIDE it by logic:preservationKind, reused verbatim from the logic: loss-ledger vocabulary rather than a math: near-synonym (Principle 17). A reasoning-facing model that references probabilistic facts without a declared lowering is unsupported/not-evaluated, never assumed independent (math:MissingProbabilityModelLowering)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# --- The logic: lowering table as first-class data -------------------------- #
# Each reasoning-facing dependency-model class declares its logic: target
# (math:probabilityModelLowering) and its preservation polarity
# (logic:preservationKind, reused verbatim — Principle 17, no math: near-synonym).
# The "conditional" rows of the charter's lowering table declare
# logic:ExactPreservation because their lowering IS exact once their completeness
# gate holds; a class declaring logic:ExactPreservation while that gate does not
# hold is the overclaim math:ExactPreservationViolated. The completeness-gate
# obligation of each is stated in the class's own skos:definition above.

math:FullIndependenceModel
    math:probabilityModelLowering logic:FullIndependence ;
    logic:preservationKind logic:ExactPreservation .

math:JointProbabilityTable
    math:probabilityModelLowering logic:DependencyModel , logic:JointOutcome ;
    logic:preservationKind logic:ExactPreservation .

math:BayesianNetwork
    math:probabilityModelLowering logic:DependencyModel ;
    logic:preservationKind logic:ExactPreservation .

math:FactorGraph
    math:probabilityModelLowering logic:DependencyModel ;
    logic:preservationKind logic:ExactPreservation .

math:MarkovKernel
    math:probabilityModelLowering logic:GenericDependence ;
    logic:preservationKind logic:ExactPreservation .

# --- Disjointness axioms ---------------------------------------------------- #

math:ProbabilityEvent owl:disjointWith logic:Event .
math:OddsValue owl:disjointWith math:ProbabilityValue .
math:LogOddsValue owl:disjointWith math:ProbabilityValue .
math:FrequentistResult owl:disjointWith math:BayesianResult .
# The two senses of "calibration" share the word and nothing else. Both
# math:CalibrationDiagnostic (⊑ math:ModelDiagnostic) and its topological homonym
# math:StabilityCalibrationRecord descend from math:MathematicalObject, so their
# disjointness is NOT entailed by their parents and MUST be asserted directly —
# the OWL-axiom gate backing math:CalibrationSenseConflation, read by the native
# DL coherence check, paired with math:CalibrationSenseConflationShape.
math:CalibrationDiagnostic owl:disjointWith math:StabilityCalibrationRecord .
# A persistence module (the whole functor to Vect) and a persistence lifetime (one
# feature's birth–death bar) share the word "persistence" and nothing else. Both
# math:PersistenceModule and math:PersistenceLifetime descend from
# math:MathematicalObject, so their disjointness is NOT entailed by their parents and
# MUST be asserted directly — the OWL-axiom gate backing
# math:PersistenceModuleLifetimeConflation, read by the native DL coherence check and
# paired with the derived math:PersistenceModuleLifetimeConflationShape (sh:not).
math:PersistenceModule owl:disjointWith math:PersistenceLifetime .

# The typed-failure grounding of that disjointness. math:PersistenceModule already carries a
# presence frame (math:IncompletePersistenceModule), so the conflation's gmeow:enforcesFailureClass
# cannot ride the class TBox alongside it (a class may declare only one failure class); it is
# carried HERE on a dedicated logic:ForbiddenPatternConstraint, exactly as
# math:IntervalKindConflationConstraint grounds the ConfidenceInterval/CredibleInterval conflation
# whose classes both carry frames.
math:PersistenceModuleLifetimeConflationConstraint
    a logic:ForbiddenPatternConstraint ;
    rdfs:label "Persistence-module/lifetime conflation constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The typed-failure grounding of the math:PersistenceModule owl:disjointWith math:PersistenceLifetime axiom: a math:PersistenceModule is NOT also typed math:PersistenceLifetime — the whole algebraic functor P: (index poset) → Vect is not the birth–death interval of a SINGLE feature; typing one node as both conflates them (math:PersistenceModuleLifetimeConflation)."@x-gmeow-english ;
    logic:onClass math:PersistenceModule ;
    logic:forbiddenPredicate rdf:type ;
    logic:forbiddenValue math:PersistenceLifetime ;
    logic:formalizes math:PersistenceModuleLifetimeConflationShape ;
    gmeow:enforcesFailureClass math:PersistenceModuleLifetimeConflation ;
    logic:message "A math:PersistenceModule must not also be a math:PersistenceLifetime — the whole persistence functor conflated with the birth–death interval of a single feature; the two are held owl:disjointWith and typing one node as both is math:PersistenceModuleLifetimeConflation." .

# --- Structural restriction axioms (presence gates) ------------------------- #
# A math:ProbabilitySpace requires a sample-space, a σ-algebra, and a measure
# object (each possibly symbolic → presence only, min-qualified as math:Measure
# does). A math:Distribution requires a math:DistributionFamily (the family is a
# hard restriction; the parameterization/role cardinality gates are SHACL/native
# so a non-parametric distribution is not rejected here).

math:ProbabilitySpace rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:sampleSpace ; owl:minQualifiedCardinality 1 ; owl:onClass math:SampleSpace ] ,
    [ a owl:Restriction ; owl:onProperty math:eventSigmaAlgebra ; owl:minQualifiedCardinality 1 ; owl:onClass math:SigmaAlgebra ] ,
    [ a owl:Restriction ; owl:onProperty math:probabilityMeasure ; owl:minQualifiedCardinality 1 ; owl:onClass math:ProbabilityMeasure ] ;
    gmeow:enforcesFailureClass math:IncompleteProbabilitySpace .

math:Distribution rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty math:distributionFamily ; owl:minQualifiedCardinality 1 ; owl:onClass math:DistributionFamily ] ;
    gmeow:enforcesFailureClass math:MissingDistributionParameterization .

# --- Probability conformance-failure classes -------------------------------- #

math:ProbabilityOutOfBounds
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability Out Of Bounds"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ProbabilityValue carries a magnitude outside the closed unit interval [0, 1]. A probability is always in [0, 1]; a value outside it is either ill-formed or a mis-typed odds/log-odds. Enforced by a SHACL range check and a native numeric check."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProbabilityScaleConflation
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability Scale Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when an odds or log-odds value is modeled as a math:ProbabilityValue rather than as its own scale kind (math:OddsValue / math:LogOddsValue). Odds and log-odds are probability-scale transforms, not probabilities, and are held disjoint from math:ProbabilityValue by an OWL axiom; typing one as a probability conflates a lawful scale with the closed unit interval."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProbabilityEventOccurrentConflation
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Probability-Event Occurrent Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ProbabilityEvent (a measurable set of outcomes, the measure-theoretic sense) is also typed as a logic:Event (an occurrent — something that happens in time). The two are held disjoint by an OWL axiom, so a rain occurrence and the rain event-set in a forecast space are never conflated; a node carrying both types conflates the set-of-outcomes with the occurrence. Enforced by the OWL disjointness axiom and its paired SHACL shape (math:ProbabilityEventOccurrentDisjointShape) so the conflation is a queryable typed failure."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnframedProbabilityValue
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unframed Probability Value"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ProbabilityValue does not name its probability frame or model. A probability value is a framed quantity object, never a bare literal; one that does not name the frame or model it is a probability under is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ConfidenceAsProbability
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Confidence As Probability"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ProbabilityValue is inferred from a confidence score (logic:confidence) without an explicit declared mapping. The logic: probability/confidence boundary is enforced here, not eroded: a confidence annotation is never silently read as a probability, so a probability derived from confidence without a declared mapping is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteProbabilitySpace
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Probability Space"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ProbabilitySpace does not name all three components of the Kolmogorov triple — its sample space (math:sampleSpace), its event σ-algebra (math:eventSigmaAlgebra), and its probability measure (math:probabilityMeasure). Each component may be symbolic or generative, but none may be absent; the gate requires presence and structural completeness, never impossible enumeration."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnscopedRandomVariable
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unscoped Random Variable"@x-gmeow-english ;
    skos:definition "The failure raised when a math:RandomVariable does not declare its domain (math:randomVariableDomain) and codomain (math:randomVariableCodomain) together with a probability-space or distribution context (math:hasDistribution). A random variable is a scoped measurable map; one missing its frame or its context is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MissingDistributionParameterization
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Missing Distribution Parameterization"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Distribution does not name its family (math:distributionFamily, a math:DistributionFamily) or, being parametric, does not name its parameterization (math:distributionParameterization). Distribution parameterization is explicit and mandatory because many families have several conventional forms; a bare family label or a silent default parameterization is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DistributionParameterRoleCardinality
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Distribution Parameter Role Cardinality"@x-gmeow-english ;
    skos:definition "The failure raised when a math:Distribution does not supply each role required by its parameterization (math:requiresParameterRole) EXACTLY ONCE — a role left unfilled, or a role filled by two parameters. Each required role is supplied exactly once through math:parameterRole; any other cardinality is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:DistributionParameterConstraint
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Distribution Parameter Constraint"@x-gmeow-english ;
    skos:definition "The failure raised when a math:DistributionParameter's quantity violates the positivity (math:requiresPositiveValue) or dimensional (math:quantityDimension) constraint its role declares — a negative standard deviation, a variance carrying unsquared units. The parameter constraints are carried on the role and checked, so a mis-constrained parameter is a caught error, not a silent one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:UnconditionedAssertion
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unconditioned Assertion"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ConditionalProbability does not name its conditioning context (math:conditionalOn) or a math:ConditionalIndependenceAssertion does not name its conditioning set (math:independentGiven). A conditional or conditional-independence assertion always names what it is conditioned on; one that leaves its conditioning context implicit is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MissingProbabilityModelLowering
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Missing Probability Model Lowering"@x-gmeow-english ;
    skos:definition "The failure raised when a reasoning-facing dependency model referenced by a probabilistic reasoning request does not declare its logic: lowering (math:probabilityModelLowering into a logic: probability-model target with a logic:preservationKind). Absent a declared lowering the engine reports unsupported / not-evaluated rather than assuming independence; a reasoning-facing model with an undeclared lowering is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:IncompleteDependencyModel
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Dependency Model"@x-gmeow-english ;
    skos:definition "The failure raised when a dependency-model declaration is not structurally complete — a math:BayesianNetwork whose graph is not a DAG or whose conditional probability tables are incomplete, a math:JointProbabilityTable whose outcomes are not exhaustive or whose mass does not sum to one, a math:FactorGraph with infinitely many factors, a math:MarkovKernel lacking domain/codomain or kernel totality. A structurally incomplete model cannot fix a joint distribution and is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ExactPreservationViolated
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Exact Preservation Violated"@x-gmeow-english ;
    skos:definition "The failure raised when a probability-model lowering declares logic:ExactPreservation while its completeness gate does NOT hold — the preservation↔completeness overclaim. A 'conditional' lowering (a math:BayesianNetwork, math:FactorGraph, math:MarkovKernel, or math:JointProbabilityTable) is exact only when its completeness gate holds (DAG and CPT completeness; finite normalized factors; kernel totality; exhaustive outcomes summing to one); declaring exact preservation without that gate holding is this failure. It is DISTINCT from math:IncompleteDependencyModel (which reports the structural incompleteness itself, independent of any preservation claim) and from math:MissingProbabilityModelLowering (which reports the ABSENCE of a declared lowering, not a false exactness claim on a present one)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProjectionConfidenceAsProbability
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Projection Confidence As Probability"@x-gmeow-english ;
    skos:definition "The failure raised when a projection silently converts a confidence score to a probability. No projection may erode the logic: probability/confidence boundary: a projection that emits a confidence annotation as a probability without a declared mapping is ill-formed. The projection-side counterpart of math:ConfidenceAsProbability."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:ProjectionDroppedParameterization
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Projection Dropped Parameterization"@x-gmeow-english ;
    skos:definition "The failure raised when a projection silently drops a math:Distribution's parameterization — emitting a bare family label without its math:DistributionParameterization and roles, so which conventional form was meant is lost. A projection must declare such a drop as recorded loss rather than perform it silently; a silent drop is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:MissingPreservationKind
    a owl:Class ;
    logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Missing Preservation Kind"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ProjectionRecord declares no logic:preservationKind — the record has entered the loss ledger without saying whether its lowering is exact, sound-but-incomplete, or complete-but-unsound. Every math: projection reuses the logic: loss-ledger vocabulary VERBATIM (Principle 17): a projection with an undeclared preservation judgment cannot be queried alongside every other GMEOW lowering, so it is ill-formed. Mirrors lang:MissingPreservationKind one stratum over."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Reach for it as the typed violation object when a math:ProjectionRecord carries no logic:preservationKind at all."@x-gmeow-english ;
    gmeow:avoidWhen "Do not confuse it with math:ExactPreservationViolated (a preservation claim that is present but false); this failure is about an ABSENT preservation judgment, not a wrong one."@x-gmeow-english ;
    gmeow:howToUse "Detected natively when a math:ProjectionRecord declares no logic:preservationKind; declare one (logic:ExactPreservation, logic:SoundUnderApproximation, or logic:CompleteOverApproximation) to discharge it."@x-gmeow-english ;
    skos:example "exf:proj a math:ProjectionRecord ; math:projectionSource exf:someExpr ; math:projectionTargetName \"OWL annotation surface\" . # no logic:preservationKind -> math:MissingPreservationKind"@x-gmeow-english .

math:UndeclaredUnsupportedConstruct
    a owl:Class ;
    logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Undeclared Unsupported Construct"@x-gmeow-english ;
    skos:definition "The failure raised when a LOSSY math:ProjectionRecord (a declared logic:preservationKind other than logic:ExactPreservation) enumerates no logic:unsupportedConstruct — the record claims a completeness its own preservation kind denies. A lossy projection either drops nothing (and so should declare logic:ExactPreservation) or names everything it drops; silently declaring lossiness with no enumerated residue hides the loss from the ledger. Mirrors lang:UndeclaredUnsupportedConstruct one stratum over."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Reach for it as the typed violation object when a lossy math:ProjectionRecord (preservation kind other than logic:ExactPreservation) names no logic:unsupportedConstruct entry."@x-gmeow-english ;
    gmeow:avoidWhen "Do not raise it for a record declaring logic:ExactPreservation (nothing to enumerate) or for one that already lists at least one dropped construct."@x-gmeow-english ;
    gmeow:howToUse "Detected natively when a lossy math:ProjectionRecord names no logic:unsupportedConstruct; enumerate every construct the lowering drops to discharge it."@x-gmeow-english ;
    skos:example "exf:proj a math:ProjectionRecord ; logic:preservationKind logic:SoundUnderApproximation . # no logic:unsupportedConstruct -> math:UndeclaredUnsupportedConstruct"@x-gmeow-english .

math:UnrecordedProjectionLoss
    a owl:Class ;
    logic:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unrecorded Projection Loss"@x-gmeow-english ;
    skos:definition "The failure raised when a LOSSY math:ProjectionRecord whose math:projectionSource is a math:MathematicalExpression — a structured AST, not a bare display string — flattens that expression to its string-only external target (math:projectionTargetName) without recording the flattening among its logic:unsupportedConstruct entries. Collapsing an expression's argument-slot/operator/symbol structure to an opaque string is exactly the kind of loss the ledger exists to make queryable; a projection that performs the flattening silently, rather than naming it as dropped structure, is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Reach for it as the typed violation object when a lossy math:ProjectionRecord's math:projectionSource is a math:MathematicalExpression whose AST structure is not named among the record's logic:unsupportedConstruct entries."@x-gmeow-english ;
    gmeow:avoidWhen "Do not raise it for an exact (non-lossy) projection, nor for one whose source is not itself a math:MathematicalExpression (e.g. a bare math:Number or math:Distribution, covered by the sibling projection gates)."@x-gmeow-english ;
    gmeow:howToUse "Detected natively when a lossy math:ProjectionRecord's math:MathematicalExpression source's structural flattening is not named among its logic:unsupportedConstruct entries; record the flattened AST as dropped structure to discharge it."@x-gmeow-english ;
    skos:example "exf:proj a math:ProjectionRecord ; math:projectionSource exf:sumExpr ; logic:preservationKind logic:SoundUnderApproximation . # exf:sumExpr a math:MathematicalExpression, no logic:unsupportedConstruct naming it -> math:UnrecordedProjectionLoss"@x-gmeow-english .

# --- Projection loss carrier ------------------------------------------------ #
# The bundle-data carrier for a math: projection's lowering into an external target,
# reusing the logic: loss-ledger vocabulary VERBATIM (logic:preservationKind,
# logic:unsupportedConstruct — Principle 17, no math: near-synonym). The five
# projection-side failure classes above are join-requiring NATIVE gates over these
# records; the carrier deliberately takes no sh:targetClass shape and is referenced by
# no sh:class, exactly like the four lang: native projection gates.

math:ProjectionRecord
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Projection Record"@x-gmeow-english ;
    skos:definition "A record of a math: projection's lowering into an external target — the bundle-data carrier of its honest per-projection preservation judgment. It names the math: object it projects through math:projectionSource, the external target it lowers to through math:projectionTargetName, its logic:preservationKind, and — where lossy — the constructs it cannot carry through logic:unsupportedConstruct, reusing the logic: loss-ledger vocabulary VERBATIM (Principle 17, no math: near-synonym). A projection that converts a source confidence into a math:ProbabilityValue declares that conversion through math:projectsConfidenceAsProbability and licenses it with a math:declaredConfidenceMapping; a lossy projection that drops a math:Distribution's parameterization enumerates it as recorded loss rather than performing the drop silently; a lossy projection whose source is a math:MathematicalExpression enumerates its structural flattening rather than silently collapsing the AST to a string. The projection-side gates (math:ProjectionConfidenceAsProbability, math:ProjectionDroppedParameterization, math:MissingPreservationKind, math:UndeclaredUnsupportedConstruct, math:UnrecordedProjectionLoss) are join-requiring native checks over these records, carrying no SHACL target shape."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

math:projectionSource
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "projection source"@x-gmeow-english ;
    skos:definition "Relates a math:ProjectionRecord to the math: object it projects into an external target — a math:Distribution, a math:ProbabilityValue, or another math: object. Domain math:ProjectionRecord, range a math: object (stated in prose). The projection's honesty is judged against what this source carries: a parameterization on a source math:Distribution that the target cannot hold must be enumerated as dropped through logic:unsupportedConstruct."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:projectionTargetName
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "projection target name"@x-gmeow-english ;
    skos:definition "Names the external target a math:ProjectionRecord lowers to — the OWL annotation surface, the SciPy/Stan parameter form, and the like. Domain math:ProjectionRecord, range xsd:string (stated in prose). The target is the addressee of the loss judgment: what preservation kind and unsupported constructs mean is fixed relative to it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:projectsConfidenceAsProbability
    a owl:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "projects confidence as probability"@x-gmeow-english ;
    skos:definition "Declares that a math:ProjectionRecord converts a source confidence score (logic:confidence) into a math:ProbabilityValue in its target. Domain math:ProjectionRecord, range xsd:boolean (stated in prose). A projection declaring this conversion must license it with an explicit math:declaredConfidenceMapping; converting confidence to probability without one erodes the logic: probability/confidence boundary at the projection seam (math:ProjectionConfidenceAsProbability), the projection-side counterpart of math:ConfidenceAsProbability."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

math:declaredConfidenceMapping
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "declared confidence mapping"@x-gmeow-english ;
    skos:definition "Relates a math:ProjectionRecord to the explicit declared mapping that licenses its confidence→probability conversion. Domain math:ProjectionRecord, range the declared mapping object (stated in prose). A projection converting a confidence into a math:ProbabilityValue names one; a confidence-to-probability conversion with no declared mapping is ill-formed (math:ProjectionConfidenceAsProbability)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# Statistical inference — hypotheses, tests, p-values, and the paradigm result #
# families (STATISTICS-charter "Inference and results" + "Frequentist and      #
# Bayesian parity")                                                            #
#                                                                              #
# The two inference-paradigm result families (math:FrequentistResult,          #
# math:BayesianResult) are first-class and neither is privileged; they are held #
# disjoint (a result is not both frequentist and Bayesian) and the paradigm    #
# axis is a PARTIAL classification — only paradigm-exclusive kinds are placed   #
# under them, so a paradigm-neutral result object (an estimate, a residual) is  #
# never forced into either. A p-value is the worked frequentist result: an      #
# unambiguous object only when it carries its test, null hypothesis, test       #
# statistic, null distribution, and tail/sidedness.                            #
# =========================================================================== #

# --- The two inference-paradigm result families (held disjoint, partial) ---- #

math:FrequentistResult
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Frequentist Result"@x-gmeow-english ;
    skos:definition "A frequentist inference result: the family of result objects whose semantics rest on the behaviour of a procedure under repeated sampling — a p-value, a sampling distribution, a confidence interval, statistical power, and the Type I / Type II error rates. A subclass of math:MathematicalObject and one of the two inference-paradigm result families, held owl:disjointWith math:BayesianResult so a single result is never read as both frequentist and Bayesian. The paradigm axis is a PARTIAL classification: only paradigm-exclusive kinds are placed under it, so a paradigm-neutral object (a math:Estimate, a math:Residual) is left free of either family rather than forced into one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Use as the family for result objects whose semantics rest on procedure behaviour under repeated sampling: p-values, sampling distributions, confidence intervals, power, and error rates."@x-gmeow-english ;
    gmeow:avoidWhen "Do not place a paradigm-neutral object such as a math:Estimate or math:Residual under it; the axis is partial, only paradigm-exclusive kinds belong."@x-gmeow-english ;
    gmeow:howToUse "Type paradigm-exclusive frequentist results under it; it is held owl:disjointWith math:BayesianResult so no result is read as both."@x-gmeow-english ;
    skos:example "exf:p1 a math:PValue , math:FrequentistResult ."@x-gmeow-english ;
    skos:scopeNote "The repeated-sampling result family, disjoint from math:BayesianResult (posterior-based results); paradigm-neutral objects are placed under neither."@x-gmeow-english .

math:BayesianResult
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Bayesian Result"@x-gmeow-english ;
    skos:definition "A Bayesian inference result: the family of result objects whose semantics rest on a posterior obtained by updating a prior with a likelihood — a posterior distribution, a credible interval, a Bayes factor, a posterior probability, and the operational MCMC diagnostics. A subclass of math:MathematicalObject and one of the two inference-paradigm result families, held owl:disjointWith math:FrequentistResult so a single result is never read as both Bayesian and frequentist. The paradigm axis is a PARTIAL classification: only paradigm-exclusive kinds are placed under it, so a paradigm-neutral object (a math:Estimate, a math:Residual) is left free of either family rather than forced into one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Use as the family for result objects whose semantics rest on a posterior from updating a prior with a likelihood: credible intervals, Bayes factors, and posterior probabilities."@x-gmeow-english ;
    gmeow:avoidWhen "Do not force a paradigm-neutral object such as a math:PredictionInterval or math:EffectSize into it; the axis is partial, only paradigm-exclusive kinds belong."@x-gmeow-english ;
    gmeow:howToUse "Type paradigm-exclusive Bayesian results under it; it is held owl:disjointWith math:FrequentistResult so no result is read as both."@x-gmeow-english ;
    skos:example "exf:cri95 a math:CredibleInterval , math:BayesianResult ."@x-gmeow-english ;
    skos:scopeNote "The posterior-based result family, disjoint from math:FrequentistResult (repeated-sampling results); paradigm-neutral objects are placed under neither."@x-gmeow-english .

# --- Hypotheses, the test object, and the sampling distribution ------------- #

math:Hypothesis
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hypothesis"@x-gmeow-english ;
    skos:definition "A statistical hypothesis: a first-class claim about a population, a parameter, or a data-generating process that a math:HypothesisTest weighs — the object that makes 'what is being tested' inspectable rather than folded into a method name. A subclass of math:MathematicalObject; its two testing roles, the tested default (math:NullHypothesis) and its complement (math:AlternativeHypothesis), are its principal subclasses."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for a first-class claim about a population, parameter, or process that a test weighs, so what is being tested is inspectable."@x-gmeow-english ;
    gmeow:avoidWhen "Do not fold the hypothesis into a method name; an untyped claim cannot be named as the null a p-value is conditioned on."@x-gmeow-english ;
    gmeow:howToUse "Type the claim as a math:Hypothesis, using its subclasses math:NullHypothesis and math:AlternativeHypothesis for the two testing roles."@x-gmeow-english ;
    skos:example "exf:h0 a math:NullHypothesis , math:Hypothesis ."@x-gmeow-english ;
    skos:scopeNote "The tested claim itself, distinct from the math:HypothesisTest that weighs it and the math:PValue computed under its null role."@x-gmeow-english .

math:NullHypothesis
    a owl:Class ;
    rdfs:subClassOf math:Hypothesis ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Null Hypothesis"@x-gmeow-english ;
    skos:definition "A null hypothesis (H0): the tested default a math:HypothesisTest presumes and a p-value is computed under — the no-effect or no-difference claim whose sampling behaviour frames the test statistic. A subclass of math:Hypothesis, named by a test through math:nullHypothesis and by a math:PValue as the hypothesis its P(T ≥ t | H0) is conditioned on."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the tested default a test presumes and a p-value is computed under, the no-effect or no-difference claim."@x-gmeow-english ;
    gmeow:avoidWhen "Do not treat rejecting the null as proving the alternative true, or a large p-value as evidence FOR the null; the null merely frames the sampling behaviour."@x-gmeow-english ;
    gmeow:howToUse "Name it from a math:HypothesisTest or math:PValue through math:nullHypothesis; a p-value naming no null is ill-framed."@x-gmeow-english ;
    skos:example "exf:h0 a math:NullHypothesis . exf:tTest math:nullHypothesis exf:h0 ."@x-gmeow-english ;
    skos:scopeNote "The tested default H0, distinct from its complement math:AlternativeHypothesis and from the math:PValue whose extremity is measured under it."@x-gmeow-english .

math:AlternativeHypothesis
    a owl:Class ;
    rdfs:subClassOf math:Hypothesis ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Alternative Hypothesis"@x-gmeow-english ;
    skos:definition "An alternative hypothesis (H1): the complement of the null a math:HypothesisTest weighs the evidence toward — the effect-present claim whose direction fixes the test's math:alternativeSidedness. A subclass of math:Hypothesis, named by a test through math:alternativeHypothesis; its directionality (one-sided, two-sided, …) is carried on the p-value as sidedness, not left implicit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the complement of the null a test weighs the evidence toward, the effect-present claim whose direction fixes the p-value sidedness."@x-gmeow-english ;
    gmeow:avoidWhen "Do not leave the alternative direction implicit; whether it is one-sided or two-sided changes the p-value, so carry it on math:alternativeSidedness."@x-gmeow-english ;
    gmeow:howToUse "Name it from a math:HypothesisTest through math:alternativeHypothesis; its directionality is carried on the p-value as sidedness."@x-gmeow-english ;
    skos:example "exf:h1 a math:AlternativeHypothesis . exf:tTest math:alternativeHypothesis exf:h1 ."@x-gmeow-english ;
    skos:scopeNote "The effect-present claim H1, distinct from the tested default math:NullHypothesis and from the math:Sidedness value that records its direction."@x-gmeow-english .

math:HypothesisTest
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Hypothesis Test"@x-gmeow-english ;
    skos:definition "A hypothesis test: the object that binds a math:NullHypothesis (math:nullHypothesis) and a math:AlternativeHypothesis (math:alternativeHypothesis) and a test statistic (math:testStatistic), and PRODUCES a math:PValue (math:pValue) — the structured frame within which a p-value's P(T ≥ t | H0) is well-defined. A subclass of math:MathematicalObject; naming its null, its alternative, and its statistic as first-class objects is what keeps a test's meaning inspectable rather than folded into a procedure name."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one to bind a null, an alternative, and a test statistic and to produce a p-value, the frame within which a p-value is well-defined."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report a p-value with no test frame; a bare probability with no null, statistic, or tail is exactly the ambiguity this object exists to remove."@x-gmeow-english ;
    gmeow:howToUse "Bind math:nullHypothesis, math:alternativeHypothesis, and math:testStatistic, and produce a math:PValue through math:pValue."@x-gmeow-english ;
    skos:example "exf:tTest a math:HypothesisTest ; math:nullHypothesis exf:h0 ; math:testStatistic exf:tStat ; math:pValue exf:p1 ."@x-gmeow-english ;
    skos:scopeNote "The test frame, distinct from the math:PValue it produces and from the math:Hypothesis objects (null and alternative) it binds."@x-gmeow-english .

math:SamplingDistribution
    a owl:Class ;
    rdfs:subClassOf math:Distribution ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Sampling Distribution"@x-gmeow-english ;
    skos:definition "A sampling distribution: the distribution of a statistic under repeated sampling — the law the value of a test statistic would follow across replications of the study. A subclass of math:Distribution, so it names its math:distributionFamily and math:distributionParameterization like any distribution; it is the natural range of a p-value's math:nullDistribution, the distribution of the statistic UNDER the null against which the observed value is placed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the distribution of a statistic under repeated sampling, the law its value would follow across replications of the study."@x-gmeow-english ;
    gmeow:avoidWhen "Do not confuse the sampling distribution of a statistic with the population distribution of the data; the former is over replications, not over units."@x-gmeow-english ;
    gmeow:howToUse "Type it as a math:Distribution, naming its math:distributionFamily; it is the natural range of a p-value math:nullDistribution, the statistic distribution under the null."@x-gmeow-english ;
    skos:example "exf:tNull a math:SamplingDistribution . exf:p1 math:nullDistribution exf:tNull ."@x-gmeow-english ;
    skos:scopeNote "The distribution of a statistic over replications, distinct from the distribution of the data over units and from the math:PValue placed against it."@x-gmeow-english .

# --- The p-value: the worked frequentist result ----------------------------- #

math:PValue
    a owl:Class ;
    rdfs:subClassOf math:FrequentistResult ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "P-Value"@x-gmeow-english ;
    skos:definition "A p-value: P(T ≥ t | H0), the probability — framed by a null or sampling distribution — of a test statistic as or more extreme than the one observed, computed under the null hypothesis. A subclass of math:FrequentistResult; its magnitude is carried through math:pValue as a framed math:ProbabilityValue, never a bare literal. To be unambiguous it carries its test (its math:testStatistic, and/or the math:HypothesisTest whose math:pValue it is), its null hypothesis (math:nullHypothesis), its null distribution (math:nullDistribution), and its tail definition or sidedness (math:tailDefinition / math:alternativeSidedness). A p-value with a null and a statistic but no tail or sidedness is still ambiguous and ill-formed (math:IllFramedPValue), because whether the extremity is one-tailed, two-tailed, or a mid-p correction changes the value."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the probability, under the null, of a statistic as or more extreme than observed, carrying its full test frame so it is unambiguous."@x-gmeow-english ;
    gmeow:avoidWhen "Do not read a p-value as the probability the null is true, and do not report one with a null and statistic but no tail or sidedness; both are misuses this class guards against."@x-gmeow-english ;
    gmeow:howToUse "Carry its math:testStatistic or math:HypothesisTest, its math:nullHypothesis, its math:nullDistribution, and its math:tailDefinition or math:alternativeSidedness; its magnitude is a framed math:pValue."@x-gmeow-english ;
    skos:example "exf:p1 a math:PValue ; math:nullHypothesis exf:h0 ; math:nullDistribution exf:tNull ; math:alternativeSidedness math:twoSidedAlternative ."@x-gmeow-english ;
    skos:scopeNote "A frequentist tail probability under the null, distinct from a math:PosteriorProbability (P of the hypothesis given the data), which it is so often mistaken for."@x-gmeow-english .

# --- Frequentist operating characteristics ---------------------------------- #

math:StatisticalPower
    a owl:Class ;
    rdfs:subClassOf math:FrequentistResult ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Statistical Power"@x-gmeow-english ;
    skos:definition "Statistical power: 1 − β, the probability that a test correctly rejects the null when a specified alternative holds — the operating characteristic answering 'how likely is this test to detect the effect it is designed for'. A subclass of math:FrequentistResult; a frequentist quantity defined against the sampling behaviour of the test under the alternative, the complement of its math:TypeIIErrorRate."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the probability a test correctly rejects the null when a specified alternative holds, one minus beta, the test detection ability."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report power without a specified alternative and design; power is defined AGAINST an alternative, so a bare power figure is meaningless."@x-gmeow-english ;
    gmeow:howToUse "Type it as a math:FrequentistResult, the complement of the math:TypeIIErrorRate against the same alternative."@x-gmeow-english ;
    skos:example "exf:power80 a math:StatisticalPower ."@x-gmeow-english ;
    skos:scopeNote "The true-positive rate under an alternative, distinct from math:TypeIErrorRate (false-positive under the null) and the complement of math:TypeIIErrorRate."@x-gmeow-english .

math:TypeIErrorRate
    a owl:Class ;
    rdfs:subClassOf math:FrequentistResult ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Type I Error Rate"@x-gmeow-english ;
    skos:definition "The Type I error rate: α, the probability that a test rejects a true null — the false-positive rate a significance threshold controls. A subclass of math:FrequentistResult; a frequentist operating characteristic defined against the sampling behaviour of the test under the null, distinct from the observed p-value it bounds."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for alpha, the probability a test rejects a true null, the false-positive rate a significance threshold controls."@x-gmeow-english ;
    gmeow:avoidWhen "Do not confuse alpha with an observed p-value; alpha is a fixed operating characteristic under the null, not the value computed from the data."@x-gmeow-english ;
    gmeow:howToUse "Type it as a math:FrequentistResult defined against the sampling behaviour under the null, bounding the p-values it admits as significant."@x-gmeow-english ;
    skos:example "exf:alpha05 a math:TypeIErrorRate ."@x-gmeow-english ;
    skos:scopeNote "The false-positive rate under the null, distinct from the observed math:PValue it bounds and from math:TypeIIErrorRate (false-negative under the alternative)."@x-gmeow-english .

math:TypeIIErrorRate
    a owl:Class ;
    rdfs:subClassOf math:FrequentistResult ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Type II Error Rate"@x-gmeow-english ;
    skos:definition "The Type II error rate: β, the probability that a test fails to reject a false null under a specified alternative — the false-negative rate. A subclass of math:FrequentistResult; a frequentist operating characteristic defined against the sampling behaviour of the test under the alternative, the complement of math:StatisticalPower (1 − β)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for beta, the probability a test fails to reject a false null under a specified alternative, the false-negative rate."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report beta without the alternative it is defined against; like power, it is meaningless without a specified effect."@x-gmeow-english ;
    gmeow:howToUse "Type it as a math:FrequentistResult defined under the alternative, the complement of math:StatisticalPower, one minus beta."@x-gmeow-english ;
    skos:example "exf:beta20 a math:TypeIIErrorRate ."@x-gmeow-english ;
    skos:scopeNote "The false-negative rate under an alternative, complement of math:StatisticalPower, distinct from math:TypeIErrorRate (false-positive under the null)."@x-gmeow-english .

# --- Sidedness: the enumerated alternative-sidedness value type ------------- #

math:Sidedness
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Sidedness"@x-gmeow-english ;
    skos:definition "The sidedness of a p-value's alternative and tail: the enumerated value fixing HOW the extremity of the test statistic is measured — one of math:oneSidedAlternative, math:twoSidedAlternative, math:greaterAlternative, math:lessAlternative, math:exactTail, or math:midPTail. A closed value type carried through math:alternativeSidedness; the sidedness is part of what makes a p-value unambiguous, because the same statistic and null yield different values one-tailed, two-tailed, or under a mid-p correction. A value outside the six is not a lawful sidedness and marks the p-value ill-framed (math:IllFramedPValue)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Use the enumerated value to fix HOW the extremity of a test statistic is measured, part of what makes a p-value unambiguous."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use a value outside the six lawful individuals; an out-of-enum sidedness marks the p-value ill-framed."@x-gmeow-english ;
    gmeow:howToUse "Carry one of the six individuals on a math:PValue through math:alternativeSidedness."@x-gmeow-english ;
    skos:example "exf:p1 math:alternativeSidedness math:twoSidedAlternative ."@x-gmeow-english ;
    skos:scopeNote "A closed value type over tail measurement, distinct from math:tailDefinition (the object naming which tails) and from the math:AlternativeHypothesis whose direction it records."@x-gmeow-english .

math:oneSidedAlternative
    a owl:NamedIndividual , math:Sidedness ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "one-sided"@x-gmeow-english ;
    skos:definition "A one-sided alternative: the extremity is measured in a single, unspecified-here direction of the sampling distribution's tail."@x-gmeow-english ;
    gmeow:useWhen "Use when the extremity is measured in a single direction of the sampling distribution tail."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it when a departure in either direction should count against the null; that is math:twoSidedAlternative."@x-gmeow-english ;
    gmeow:howToUse "Carry it on a math:PValue through math:alternativeSidedness."@x-gmeow-english ;
    skos:example "exf:p1 math:alternativeSidedness math:oneSidedAlternative ."@x-gmeow-english ;
    skos:scopeNote "A single-direction tail measure, distinct from math:twoSidedAlternative (both tails) and from math:greaterAlternative and math:lessAlternative, which fix WHICH single tail."@x-gmeow-english .

math:twoSidedAlternative
    a owl:NamedIndividual , math:Sidedness ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "two-sided"@x-gmeow-english ;
    skos:definition "A two-sided alternative: the extremity is measured in both tails, so a departure in either direction counts against the null."@x-gmeow-english ;
    gmeow:useWhen "Use when a departure in either direction counts against the null, so extremity is measured in both tails."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it when only one direction is of interest; a one-sided test halves the tail and is math:oneSidedAlternative or its directional variants."@x-gmeow-english ;
    gmeow:howToUse "Carry it on a math:PValue through math:alternativeSidedness."@x-gmeow-english ;
    skos:example "exf:p1 math:alternativeSidedness math:twoSidedAlternative ."@x-gmeow-english ;
    skos:scopeNote "A both-tails measure, distinct from math:oneSidedAlternative and its directional forms math:greaterAlternative and math:lessAlternative."@x-gmeow-english .

math:greaterAlternative
    a owl:NamedIndividual , math:Sidedness ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "greater"@x-gmeow-english ;
    skos:definition "A one-sided 'greater' alternative: the extremity is measured in the upper tail (the parameter exceeds its null value)."@x-gmeow-english ;
    gmeow:useWhen "Use for a one-sided upper-tail alternative where the parameter exceeds its null value."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it for the lower-tail case; that is math:lessAlternative."@x-gmeow-english ;
    gmeow:howToUse "Carry it on a math:PValue through math:alternativeSidedness."@x-gmeow-english ;
    skos:example "exf:p1 math:alternativeSidedness math:greaterAlternative ."@x-gmeow-english ;
    skos:scopeNote "The upper-tail one-sided measure, distinct from math:lessAlternative (lower tail) and from the undirected math:oneSidedAlternative."@x-gmeow-english .

math:lessAlternative
    a owl:NamedIndividual , math:Sidedness ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "less"@x-gmeow-english ;
    skos:definition "A one-sided 'less' alternative: the extremity is measured in the lower tail (the parameter falls below its null value)."@x-gmeow-english ;
    gmeow:useWhen "Use for a one-sided lower-tail alternative where the parameter falls below its null value."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it for the upper-tail case; that is math:greaterAlternative."@x-gmeow-english ;
    gmeow:howToUse "Carry it on a math:PValue through math:alternativeSidedness."@x-gmeow-english ;
    skos:example "exf:p1 math:alternativeSidedness math:lessAlternative ."@x-gmeow-english ;
    skos:scopeNote "The lower-tail one-sided measure, distinct from math:greaterAlternative (upper tail) and from the undirected math:oneSidedAlternative."@x-gmeow-english .

math:exactTail
    a owl:NamedIndividual , math:Sidedness ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "exact"@x-gmeow-english ;
    skos:definition "An exact tail: the p-value uses the exact (typically discrete) tail probability rather than a continuous approximation."@x-gmeow-english ;
    gmeow:useWhen "Use when the p-value uses the exact, typically discrete, tail probability rather than a continuous approximation."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it when a mid-p correction is applied; that is math:midPTail, which counts half the observed-value probability."@x-gmeow-english ;
    gmeow:howToUse "Carry it on a math:PValue through math:alternativeSidedness for an exact discrete test."@x-gmeow-english ;
    skos:example "exf:p1 math:alternativeSidedness math:exactTail ."@x-gmeow-english ;
    skos:scopeNote "The exact discrete tail, distinct from math:midPTail (the mid-p correction) and from the direction values math:oneSidedAlternative and math:twoSidedAlternative."@x-gmeow-english .

math:midPTail
    a owl:NamedIndividual , math:Sidedness ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "mid-p"@x-gmeow-english ;
    skos:definition "A mid-p tail: the p-value uses the mid-p correction, counting half the probability of the observed value in the tail to reduce the conservativeness of an exact discrete test."@x-gmeow-english ;
    gmeow:useWhen "Use when the p-value uses the mid-p correction, counting half the probability of the observed value to reduce the conservativeness of an exact discrete test."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it when the full exact tail is intended; that is math:exactTail."@x-gmeow-english ;
    gmeow:howToUse "Carry it on a math:PValue through math:alternativeSidedness."@x-gmeow-english ;
    skos:example "exf:p1 math:alternativeSidedness math:midPTail ."@x-gmeow-english ;
    skos:scopeNote "The mid-p correction, distinct from the full math:exactTail it adjusts and from the direction values in the math:Sidedness enumeration."@x-gmeow-english .

# --- Inference object properties -------------------------------------------- #

math:nullHypothesis
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "null hypothesis"@x-gmeow-english ;
    skos:definition "Relates a math:HypothesisTest or a math:PValue to the math:NullHypothesis it presumes. Domain a math:HypothesisTest or math:PValue, range math:NullHypothesis (stated in prose). The tested default H0 a p-value is computed under; a p-value naming no null hypothesis is ill-framed (math:IllFramedPValue)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to relate a test or a p-value to the tested default it presumes, the H0 a p-value is computed under."@x-gmeow-english ;
    gmeow:avoidWhen "Do not point it at the alternative; the range is the null, and a p-value naming no null is ill-framed."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:HypothesisTest or math:PValue with range math:NullHypothesis."@x-gmeow-english ;
    skos:example "exf:tTest math:nullHypothesis exf:h0 ."@x-gmeow-english ;
    skos:scopeNote "Names the tested default, distinct from math:alternativeHypothesis (the complement) and from math:nullDistribution (the statistic law under that null)."@x-gmeow-english .

math:alternativeHypothesis
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "alternative hypothesis"@x-gmeow-english ;
    skos:definition "Relates a math:HypothesisTest to the math:AlternativeHypothesis it weighs the evidence toward. Domain math:HypothesisTest, range math:AlternativeHypothesis (stated in prose). The complement of the null; its directionality is carried on the p-value through math:alternativeSidedness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to relate a test to the complement of the null it weighs the evidence toward."@x-gmeow-english ;
    gmeow:avoidWhen "Do not carry the alternative direction here; whether it is one-sided or two-sided lives on the p-value math:alternativeSidedness, not on this edge."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:HypothesisTest with range math:AlternativeHypothesis."@x-gmeow-english ;
    skos:example "exf:tTest math:alternativeHypothesis exf:h1 ."@x-gmeow-english ;
    skos:scopeNote "Names the effect-present claim, distinct from math:nullHypothesis (the default) and from math:alternativeSidedness (the direction of that alternative)."@x-gmeow-english .

math:testStatistic
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "test statistic"@x-gmeow-english ;
    skos:definition "Relates a math:HypothesisTest or a math:PValue to the math:Statistic (a function of the data) whose observed value drives the test. Domain a math:HypothesisTest or math:PValue, range math:Statistic (stated in prose). The statistic t whose extremity under the null gives P(T ≥ t | H0); a p-value naming no test statistic is ill-framed (math:IllFramedPValue)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to relate a test or a p-value to the function of the data whose observed value drives the test."@x-gmeow-english ;
    gmeow:avoidWhen "Do not omit it on a p-value; the statistic t is what P of T at least t under the null is measured on, and a p-value naming no statistic is ill-framed."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:HypothesisTest or math:PValue with range math:Statistic."@x-gmeow-english ;
    skos:example "exf:tTest math:testStatistic exf:tStat ."@x-gmeow-english ;
    skos:scopeNote "Names the driving statistic, distinct from math:nullDistribution (its law under the null) and from math:pValue (the resulting probability)."@x-gmeow-english .

math:nullDistribution
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "null distribution"@x-gmeow-english ;
    skos:definition "Relates a math:PValue to the distribution of its test statistic UNDER the null — the frame against which the observed value's extremity is measured. Domain math:PValue, range a math:Distribution, typically a math:SamplingDistribution (stated in prose). A p-value naming no null distribution is ill-framed (math:IllFramedPValue)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to relate a p-value to the distribution of its statistic UNDER the null, the frame the observed extremity is measured against."@x-gmeow-english ;
    gmeow:avoidWhen "Do not point it at the population distribution of the data; the range is the statistic sampling law under the null, typically a math:SamplingDistribution."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:PValue with range a math:Distribution; a p-value naming no null distribution is ill-framed."@x-gmeow-english ;
    skos:example "exf:p1 math:nullDistribution exf:tNull ."@x-gmeow-english ;
    skos:scopeNote "The statistic law under the null, distinct from math:nullHypothesis (the claim) and from the population distribution of the data over units."@x-gmeow-english .

math:tailDefinition
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "tail definition"@x-gmeow-english ;
    skos:definition "Relates a math:PValue to the object defining which tail (or tails) of its null distribution the extremity is measured over. Domain math:PValue, range the tail-definition object (stated in prose). Together with math:alternativeSidedness it fixes how the extremity is counted; a p-value declaring neither a tail definition nor a sidedness is ill-framed (math:IllFramedPValue)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to relate a p-value to the object defining which tail or tails of its null distribution the extremity is measured over."@x-gmeow-english ;
    gmeow:avoidWhen "Do not leave both a tail definition and a sidedness off a p-value; declaring neither is ill-framed, because the tail choice changes the value."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:PValue with range the tail-definition object; together with math:alternativeSidedness it fixes how extremity is counted."@x-gmeow-english ;
    skos:example "exf:p1 math:tailDefinition exf:upperTail ."@x-gmeow-english ;
    skos:scopeNote "Names which tails are counted, distinct from math:alternativeSidedness (the enumerated one-sided or two-sided value) with which it jointly fixes extremity."@x-gmeow-english .

math:alternativeSidedness
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "alternative sidedness"@x-gmeow-english ;
    skos:definition "Relates a math:PValue to its math:Sidedness — the enumerated value (one of the six math:Sidedness individuals) fixing whether the extremity is one-sided, two-sided, greater, less, exact, or mid-p. Domain math:PValue, range math:Sidedness (stated in prose). A closed value carried by sh:in; a p-value declaring neither a sidedness nor a math:tailDefinition is ill-framed (math:IllFramedPValue), and a value outside the six is not a lawful sidedness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to relate a p-value to its enumerated sidedness value, fixing whether the extremity is one-sided, two-sided, greater, less, exact, or mid-p."@x-gmeow-english ;
    gmeow:avoidWhen "Do not carry a value outside the six math:Sidedness individuals; an out-of-enum sidedness is not lawful and marks the p-value ill-framed."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:PValue with range math:Sidedness, one of the six closed individuals carried by sh:in."@x-gmeow-english ;
    skos:example "exf:p1 math:alternativeSidedness math:twoSidedAlternative ."@x-gmeow-english ;
    skos:scopeNote "Carries the closed sidedness value, distinct from math:tailDefinition (the object naming which tails) with which it jointly determines extremity."@x-gmeow-english .

math:pValueAdjustment
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "p-value adjustment"@x-gmeow-english ;
    skos:definition "Relates a math:PValue to the multiplicity adjustment applied to it — a Bonferroni, Holm, or Benjamini–Hochberg correction. Domain math:PValue, range the adjustment object (stated in prose). Naming the adjustment as an object is what makes 'was this p-value corrected for multiplicity, and how' answerable rather than implicit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to relate a p-value to the multiplicity adjustment applied to it, a Bonferroni, Holm, or Benjamini-Hochberg correction."@x-gmeow-english ;
    gmeow:avoidWhen "Do not leave a corrected p-value with the correction implicit; whether and how it was adjusted for multiplicity should be an answerable object."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:PValue with range the adjustment object, scoped by the math:multipleComparisonFamily it is taken over."@x-gmeow-english ;
    skos:example "exf:p1 math:pValueAdjustment exf:holm ."@x-gmeow-english ;
    skos:scopeNote "Names the correction applied, distinct from math:multipleComparisonFamily (the set of comparisons the correction controls the error rate across)."@x-gmeow-english .

math:multipleComparisonFamily
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "multiple-comparison family"@x-gmeow-english ;
    skos:definition "Relates a math:PValue to the family of comparisons its multiplicity adjustment is taken over — the set of tests within which its error rate is controlled. Domain math:PValue, range the comparison-family object (stated in prose). The family scopes the adjustment: a correction is only meaningful relative to the family of comparisons it controls the error rate across."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to relate a p-value to the family of comparisons its multiplicity adjustment is taken over, the set within which its error rate is controlled."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report a correction without its family; an adjustment is meaningful only relative to the comparisons it controls the error rate across."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:PValue with range the comparison-family object that scopes its math:pValueAdjustment."@x-gmeow-english ;
    skos:example "exf:p1 math:multipleComparisonFamily exf:endpointFamily ."@x-gmeow-english ;
    skos:scopeNote "The scope of a correction, distinct from math:pValueAdjustment (the correction procedure itself) it gives meaning to."@x-gmeow-english .

math:pValue
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "p-value"@x-gmeow-english ;
    skos:definition "Relates a math:HypothesisTest or a math:PValue to the framed math:ProbabilityValue carrying its magnitude. Domain a math:HypothesisTest or math:PValue, range math:ProbabilityValue (stated in prose). The p-value's magnitude is a framed probability object in [0, 1] naming its frame or model, never a bare literal; a test names the p-value it produces through this edge, and a math:PValue carries its own magnitude through it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to carry the magnitude of a p-value as a framed probability in the unit interval, or to relate a test to the p-value it produces."@x-gmeow-english ;
    gmeow:avoidWhen "Do not carry the magnitude as a bare literal; a p-value magnitude is a framed math:ProbabilityValue naming its frame, never a raw number."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:HypothesisTest to name the p-value it produces, or on a math:PValue to carry its own magnitude, with range math:ProbabilityValue."@x-gmeow-english ;
    skos:example "exf:tTest math:pValue exf:p1 ."@x-gmeow-english ;
    skos:scopeNote "Carries a framed tail probability, distinct from math:confidenceLevel and math:credibleMass, which carry interval coverage or mass rather than a test extremity."@x-gmeow-english .

# --- Inference conformance-failure class ------------------------------------ #

math:IllFramedPValue
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Ill-Framed P-Value"@x-gmeow-english ;
    skos:definition "The failure raised when a math:PValue is ambiguous because it does not carry the frame that makes P(T ≥ t | H0) well-defined: it names no test (neither a math:testStatistic nor the math:HypothesisTest whose math:pValue it is), or no math:nullHypothesis, or no math:nullDistribution, or neither a math:tailDefinition nor a math:alternativeSidedness — or it carries an math:alternativeSidedness outside the six lawful math:Sidedness values. A p-value with a null and a statistic but no tail or sidedness is still ambiguous, because whether the extremity is one-tailed, two-tailed, or mid-p changes the value; such a p-value is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "This failure is raised for a p-value that lacks the frame making its tail probability well-defined, so consumers can reject it."@x-gmeow-english ;
    gmeow:avoidWhen "Do not treat a p-value with a null and a statistic but no tail or sidedness as complete; whether the extremity is one-tailed, two-tailed, or mid-p changes the value."@x-gmeow-english ;
    gmeow:howToUse "Detected when a math:PValue names no test, no null, no null distribution, or neither a math:tailDefinition nor a lawful math:alternativeSidedness; supply the frame to avoid it."@x-gmeow-english ;
    skos:example "exf:badP a math:IllFramedPValue ."@x-gmeow-english ;
    skos:scopeNote "The ambiguous-p-value finding, distinct from math:UnderspecifiedEstimate (an estimate with no target or act) and math:UnframedEffectSize (an uninterpretable magnitude)."@x-gmeow-english .

# =========================================================================== #
# Intervals, regions, effect size — the rest of the paradigm result layer      #
# (STATISTICS-charter "Inference and results" + "Frequentist and Bayesian       #
# parity")                                                                     #
#                                                                              #
# Uncertainty is not always a scalar interval. The paradigm-EXCLUSIVE interval  #
# and region kinds are placed under the two families: math:ConfidenceInterval   #
# and math:ConfidenceRegion ⊑ math:FrequentistResult (coverage under a sampling  #
# procedure), math:CredibleInterval and math:CredibleRegion ⊑ math:BayesianResult#
# (posterior mass), together with math:BayesFactor and math:PosteriorProbability.#
# The disjointness math:ConfidenceInterval ⊥ math:CredibleInterval is ENTAILED   #
# by the paradigm parents (CI ⊑ Frequentist, Credible ⊑ Bayesian, Frequentist ⊥  #
# Bayesian), so no redundant direct owl:disjointWith is minted; the conflation    #
# of the two is its own failure identity (math:IntervalKindConflation). The       #
# paradigm-NEUTRAL kinds — math:PredictionInterval, math:ToleranceInterval,       #
# math:EffectSize, and math:Prediction — are left under math:MathematicalObject,  #
# free of either family, because a prediction interval and a tolerance interval   #
# are computed in both paradigms and an effect size is a magnitude of a contrast  #
# either way.                                                                    #
# =========================================================================== #

# --- Frequentist interval and region kinds (⊑ math:FrequentistResult) -------- #

math:ConfidenceInterval
    a owl:Class ;
    rdfs:subClassOf math:FrequentistResult ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Confidence Interval"@x-gmeow-english ;
    skos:definition "A confidence interval: the frequentist interval estimate whose coverage is a property of the PROCEDURE under repeated sampling — an interval constructed so that, across replications of the study, a stated proportion of such intervals contain the true parameter. A subclass of math:FrequentistResult, so it is held owl:disjointWith the Bayesian math:CredibleInterval THROUGH the paradigm parents (a single node is never both — that conflation is math:IntervalKindConflation). It names its bounds through math:hasIntervalBound and its coverage through math:confidenceLevel (a framed math:ProbabilityValue over the sampling procedure); an interval missing its bounds or its level is ill-formed (math:IncompleteConfidenceInterval). It is NOT a statement of posterior probability that the parameter lies in the interval — that is the credible interval's semantics, which this class must never be read as."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for a frequentist interval whose coverage is a property of the PROCEDURE under repeated sampling."@x-gmeow-english ;
    gmeow:avoidWhen "Do not read it as the posterior probability that the parameter lies in the interval; that is a credible interval, and reading a confidence interval that way is the core misuse."@x-gmeow-english ;
    gmeow:howToUse "Name its bounds through math:hasIntervalBound and its coverage through math:confidenceLevel; missing either is math:IncompleteConfidenceInterval."@x-gmeow-english ;
    skos:example "exf:ci95 a math:ConfidenceInterval ; math:confidenceLevel exf:p95 ; math:hasIntervalBound exf:lo , exf:hi ."@x-gmeow-english ;
    skos:scopeNote "Procedure coverage under repeated sampling, held disjoint through paradigm parents from math:CredibleInterval (posterior mass); conflating them is math:IntervalKindConflation."@x-gmeow-english ;
    gmeow:enforcesFailureClass math:IncompleteConfidenceInterval .

math:ConfidenceRegion
    a owl:Class ;
    rdfs:subClassOf math:FrequentistResult ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Confidence Region"@x-gmeow-english ;
    skos:definition "A confidence region: the MULTIVARIATE generalization of a math:ConfidenceInterval — a region in parameter space whose frequentist coverage under repeated sampling is a stated proportion, for a vector-valued parameter (a joint region for two or more coefficients). A subclass of math:FrequentistResult, held owl:disjointWith the Bayesian math:CredibleRegion through the paradigm parents. Its coverage is a procedure property, carried through math:confidenceLevel, never a posterior mass; it is the region-valued sibling of the confidence interval, not a credible region."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the multivariate generalization of a confidence interval, a region in parameter space with stated frequentist coverage for a vector-valued parameter."@x-gmeow-english ;
    gmeow:avoidWhen "Do not read its coverage as a posterior mass; like the interval, the region coverage is a procedure property, not a credible region."@x-gmeow-english ;
    gmeow:howToUse "Carry its coverage through math:confidenceLevel; it is held disjoint from math:CredibleRegion through the paradigm parents."@x-gmeow-english ;
    skos:example "exf:cr95 a math:ConfidenceRegion ; math:confidenceLevel exf:p95 ."@x-gmeow-english ;
    skos:scopeNote "The region-valued confidence sibling, distinct from math:ConfidenceInterval (scalar) and from the Bayesian math:CredibleRegion (posterior mass)."@x-gmeow-english .

# --- Bayesian interval, region, and evidence kinds (⊑ math:BayesianResult) --- #

math:CredibleInterval
    a owl:Class ;
    rdfs:subClassOf math:BayesianResult ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Credible Interval"@x-gmeow-english ;
    skos:definition "A credible interval: the Bayesian interval estimate whose semantics rest on a POSTERIOR — an interval carrying a stated posterior probability mass that the parameter lies within it, given the prior, the likelihood, and the data. A subclass of math:BayesianResult, so it is held owl:disjointWith the frequentist math:ConfidenceInterval THROUGH the paradigm parents (a single node is never both — that conflation is math:IntervalKindConflation: they share the word 'interval' and nothing else, frequentist coverage versus posterior mass). It names its posterior context through math:hasPosterior (the math:PosteriorDistribution it summarizes), its bounds through math:hasIntervalBound, and its mass through math:credibleMass (a framed math:ProbabilityValue over that posterior); a credible interval naming no posterior or no credible mass is ill-formed (math:IncompleteCredibleInterval)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for a Bayesian interval carrying a stated posterior probability mass that the parameter lies within it, given prior, likelihood, and data."@x-gmeow-english ;
    gmeow:avoidWhen "Do not read its mass as a procedure coverage or mint one with no posterior; a credible interval naming no posterior or no mass is ill-formed."@x-gmeow-english ;
    gmeow:howToUse "Name its posterior through math:hasPosterior, its bounds through math:hasIntervalBound, and its mass through math:credibleMass; missing the posterior or mass is math:IncompleteCredibleInterval."@x-gmeow-english ;
    skos:example "exf:cri95 a math:CredibleInterval ; math:credibleMass exf:m95 ; math:hasIntervalBound exf:lo , exf:hi ."@x-gmeow-english ;
    skos:scopeNote "Posterior mass over a parameter, held disjoint through paradigm parents from math:ConfidenceInterval (procedure coverage); conflating them is math:IntervalKindConflation."@x-gmeow-english ;
    gmeow:enforcesFailureClass math:IncompleteCredibleInterval .

math:CredibleRegion
    a owl:Class ;
    rdfs:subClassOf math:BayesianResult ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Credible Region"@x-gmeow-english ;
    skos:definition "A credible region: the MULTIVARIATE generalization of a math:CredibleInterval — a region in parameter space carrying a stated posterior probability mass, for a vector-valued parameter (a joint highest-posterior-density region). A subclass of math:BayesianResult, held owl:disjointWith the frequentist math:ConfidenceRegion through the paradigm parents. Its mass is a posterior probability over the math:PosteriorDistribution it summarizes (math:hasPosterior, math:credibleMass), never a procedure's coverage; it is the region-valued sibling of the credible interval, not a confidence region."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the multivariate generalization of a credible interval, a region in parameter space carrying a stated posterior mass for a vector-valued parameter."@x-gmeow-english ;
    gmeow:avoidWhen "Do not read its mass as a procedure coverage; it is a posterior probability over the posterior distribution, not a confidence region."@x-gmeow-english ;
    gmeow:howToUse "Name its posterior through math:hasPosterior and its mass through math:credibleMass; it is held disjoint from math:ConfidenceRegion through the paradigm parents."@x-gmeow-english ;
    skos:example "exf:crReg95 a math:CredibleRegion ; math:credibleMass exf:m95 ."@x-gmeow-english ;
    skos:scopeNote "The region-valued credible sibling, distinct from math:CredibleInterval (scalar) and from the frequentist math:ConfidenceRegion (procedure coverage)."@x-gmeow-english .

math:BayesFactor
    a owl:Class ;
    rdfs:subClassOf math:BayesianResult ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Bayes Factor"@x-gmeow-english ;
    skos:definition "A Bayes factor: the ratio of the marginal likelihoods of two models (or hypotheses) under the data — the Bayesian measure of the evidence the data provide FOR one model OVER another, the update factor from prior odds to posterior odds. A subclass of math:BayesianResult, one of the paradigm-exclusive Bayesian result kinds held owl:disjointWith math:FrequentistResult; it is the Bayesian counterpart to a frequentist test's evidence summary, never a p-value, and is read as a ratio of evidences rather than a tail probability under a null."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the ratio of marginal likelihoods of two models under the data, the evidence FOR one model OVER another, the update from prior to posterior odds."@x-gmeow-english ;
    gmeow:avoidWhen "Do not read it as a p-value or a tail probability under a null; it is a ratio of evidences, not a significance measure."@x-gmeow-english ;
    gmeow:howToUse "Type it as a math:BayesianResult comparing two models or hypotheses."@x-gmeow-english ;
    skos:example "exf:bf10 a math:BayesFactor ."@x-gmeow-english ;
    skos:scopeNote "A ratio of model evidences, distinct from a math:PValue (a tail probability under one null) and from a math:PosteriorProbability (a probability of one hypothesis)."@x-gmeow-english .

math:PosteriorProbability
    a owl:Class ;
    rdfs:subClassOf math:BayesianResult ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Posterior Probability"@x-gmeow-english ;
    skos:definition "A posterior probability: the probability of a hypothesis or a parameter event AFTER the data, P(H | data) — the direct Bayesian answer a frequentist p-value is so often mistaken for. A subclass of math:BayesianResult, one of the paradigm-exclusive Bayesian result kinds held owl:disjointWith math:FrequentistResult; its magnitude is a framed math:ProbabilityValue over a posterior. It is a probability of the hypothesis given the data, the inverse of a p-value's P(data as extreme | null), and the two are never conflated."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the probability of a hypothesis or parameter event AFTER the data, P of H given data, the direct Bayesian answer."@x-gmeow-english ;
    gmeow:avoidWhen "Do not confuse it with a p-value, which is P of data as extreme given the null; the two are inverses and are never interchanged."@x-gmeow-english ;
    gmeow:howToUse "Type it as a math:BayesianResult whose magnitude is a framed math:ProbabilityValue over a posterior."@x-gmeow-english ;
    skos:example "exf:postH a math:PosteriorProbability ."@x-gmeow-english ;
    skos:scopeNote "P of the hypothesis given the data, the inverse of a math:PValue (P of the data given the null), which it is often mistaken for."@x-gmeow-english .

# --- Paradigm-neutral interval, effect-size, and prediction kinds ----------- #
# Left under math:MathematicalObject, NOT placed under either paradigm family,
# because they are computed in both frequentist and Bayesian analyses.

math:PredictionInterval
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Prediction Interval"@x-gmeow-english ;
    skos:definition "A prediction interval: an interval expected to contain a FUTURE observation (a new data point), not a fixed parameter — wider than a confidence interval because it carries the sampling uncertainty of a new draw on top of the estimation uncertainty. A subclass of math:MathematicalObject, deliberately left PARADIGM-NEUTRAL (under neither math:FrequentistResult nor math:BayesianResult) because a prediction interval is constructed in both paradigms — a frequentist prediction interval and a Bayesian posterior-predictive interval are the same interval kind under different frames — so forcing it into one family would misclassify the other. It names its bounds through math:hasIntervalBound and the target it predicts through math:predictionTarget."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for an interval expected to contain a FUTURE observation, wider than a confidence interval because it carries the uncertainty of a new draw."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it for a fixed parameter (a confidence interval) or for a population proportion (a tolerance interval); it bounds a single new data point."@x-gmeow-english ;
    gmeow:howToUse "Name its bounds through math:hasIntervalBound and the target it forecasts through math:predictionTarget; it is left paradigm-neutral because both paradigms construct it."@x-gmeow-english ;
    skos:example "exf:pi90 a math:PredictionInterval ; math:hasIntervalBound exf:lo , exf:hi ; math:predictionTarget exf:nextSale ."@x-gmeow-english ;
    skos:scopeNote "An interval for a future observation, distinct from math:ConfidenceInterval (a fixed parameter) and math:ToleranceInterval (a population proportion)."@x-gmeow-english .

math:ToleranceInterval
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Tolerance Interval"@x-gmeow-english ;
    skos:definition "A tolerance interval: an interval that, with a stated confidence, contains at least a stated PROPORTION of the population — the two-parameter uncertainty (a confidence level over a coverage proportion) distinct from both a confidence interval on a parameter and a prediction interval on a single future value. A subclass of math:MathematicalObject, deliberately left PARADIGM-NEUTRAL (under neither family) because tolerance intervals are constructed in both paradigms; it names its bounds through math:hasIntervalBound. Held apart from math:PredictionInterval (a single future observation) and math:ConfidenceInterval (a fixed parameter), because a proportion of the population is neither."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for an interval that, with stated confidence, contains at least a stated PROPORTION of the population, a two-parameter uncertainty."@x-gmeow-english ;
    gmeow:avoidWhen "Do not collapse it to a confidence interval on a parameter or a prediction interval on one future value; it covers a proportion of the population, neither of those."@x-gmeow-english ;
    gmeow:howToUse "Name its bounds through math:hasIntervalBound; it is left paradigm-neutral because both paradigms construct it."@x-gmeow-english ;
    skos:example "exf:tol99 a math:ToleranceInterval ; math:hasIntervalBound exf:lo , exf:hi ."@x-gmeow-english ;
    skos:scopeNote "An interval covering a population proportion, distinct from math:ConfidenceInterval (a parameter) and math:PredictionInterval (a single future value)."@x-gmeow-english .

math:EffectSize
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Effect Size"@x-gmeow-english ;
    skos:definition "An effect size: the standardized MAGNITUDE of a contrast — a Cohen's d, a correlation, an odds ratio, an R² — that answers 'how big is the effect' rather than 'is it distinguishable from zero'. A subclass of math:MathematicalObject, deliberately PARADIGM-NEUTRAL (under neither family) because an effect size is estimated in both paradigms. To be interpretable it identifies THREE things: the comparison it measures the magnitude of through math:effectSizeContrast — the SAME shared math:StatisticalContrast object an estimand targets through math:targetContrast, one modeled contrast, never a near-synonym — the math:MeasurementScale it is expressed on through math:effectSizeScale, and its reference frame through gmeow:hasReferenceFrame (the house frame predicate, the same edge a math:ProbabilityValue is framed by). An effect size missing its contrast, scale, or frame is an uninterpretable bare number (math:UnframedEffectSize)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the standardized MAGNITUDE of a contrast, answering how big the effect is rather than whether it is distinguishable from zero."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report an effect size as a bare number; missing its contrast, scale, or reference frame it is uninterpretable."@x-gmeow-english ;
    gmeow:howToUse "Identify its math:effectSizeContrast (the shared math:StatisticalContrast), its math:effectSizeScale, and its gmeow:hasReferenceFrame; missing any is math:UnframedEffectSize."@x-gmeow-english ;
    skos:example "exf:cohensD a math:EffectSize ; math:effectSizeContrast exf:treatVsControl ; math:effectSizeScale exf:sdScale ."@x-gmeow-english ;
    skos:scopeNote "The magnitude of an effect, distinct from a math:PValue (its distinguishability from zero) and from the math:StatisticalContrast whose size it measures."@x-gmeow-english ;
    gmeow:enforcesFailureClass math:UnframedEffectSize .

math:Prediction
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Prediction"@x-gmeow-english ;
    skos:definition "A prediction: a model's forecast value for the outcome at a given input — a point prediction, distinct from the math:PredictionInterval that bounds its uncertainty and from the math:Residual that is the gap between it and the observed value. A subclass of math:MathematicalObject, deliberately PARADIGM-NEUTRAL (models predict in both paradigms); it names what it predicts through math:predictionTarget. Held apart from math:Estimate (a value of a parameter or estimand) — a prediction is a value of the OUTCOME for a case, not of a parameter of the model."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for a model forecast value of the outcome at a given input, a point prediction."@x-gmeow-english ;
    gmeow:avoidWhen "Do not confuse it with a math:Estimate of a parameter or with the math:PredictionInterval bounding its uncertainty; a prediction is a value of the OUTCOME for a case."@x-gmeow-english ;
    gmeow:howToUse "Type it as paradigm-neutral and name what it forecasts through math:predictionTarget."@x-gmeow-english ;
    skos:example "exf:pred1 a math:Prediction ; math:predictionTarget exf:nextSale ."@x-gmeow-english ;
    skos:scopeNote "A point forecast of an outcome, distinct from a math:Estimate (a parameter value), a math:PredictionInterval (its uncertainty), and a math:Residual (the gap to the observed value)."@x-gmeow-english .

# --- Interval, effect-size, and prediction object properties ---------------- #

math:hasIntervalBound
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "has interval bound"@x-gmeow-english ;
    skos:definition "Relates an interval (a math:ConfidenceInterval, math:CredibleInterval, math:PredictionInterval, or math:ToleranceInterval) to one of its bounds — a lower or an upper endpoint of the interval. Domain an interval kind, range the bound object (stated in prose). A two-sided interval names its lower AND its upper bound (two math:hasIntervalBound edges); a confidence interval that does not name its bounds is ill-formed (math:IncompleteConfidenceInterval)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to name a lower or upper endpoint of an interval, so an interval carries the bounds that make it an interval estimate."@x-gmeow-english ;
    gmeow:avoidWhen "Do not leave a two-sided interval with fewer than its two bounds; a confidence interval with no bounds is math:IncompleteConfidenceInterval."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:ConfidenceInterval, math:CredibleInterval, math:PredictionInterval, or math:ToleranceInterval, once per endpoint."@x-gmeow-english ;
    skos:example "exf:ci95 math:hasIntervalBound exf:lo , exf:hi ."@x-gmeow-english ;
    skos:scopeNote "Names an endpoint object, distinct from math:confidenceLevel and math:credibleMass, which carry the coverage or mass the bounds enclose."@x-gmeow-english .

math:confidenceLevel
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "confidence level"@x-gmeow-english ;
    skos:definition "Relates a math:ConfidenceInterval (or math:ConfidenceRegion) to its coverage level — a framed math:ProbabilityValue (a 0.95, a 0.99) that is the proportion of such intervals, under repeated sampling, containing the true parameter. Domain a confidence interval or region, range math:ProbabilityValue (stated in prose). The coverage is a property of the PROCEDURE, never a posterior mass; a confidence interval naming no confidence level is ill-formed (math:IncompleteConfidenceInterval). Its counterpart on the Bayesian side is math:credibleMass, which the two must never be collapsed onto one another."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to carry the frequentist coverage of a confidence interval or region, the proportion of such intervals containing the true parameter under repeated sampling."@x-gmeow-english ;
    gmeow:avoidWhen "Do not carry it as a posterior mass or collapse it onto math:credibleMass; the coverage is a PROCEDURE property, not a posterior probability."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:ConfidenceInterval or math:ConfidenceRegion with range a framed math:ProbabilityValue; missing it is math:IncompleteConfidenceInterval."@x-gmeow-english ;
    skos:example "exf:ci95 math:confidenceLevel exf:p95 ."@x-gmeow-english ;
    skos:scopeNote "Procedure coverage, the frequentist counterpart of math:credibleMass (posterior mass), held strictly apart from it."@x-gmeow-english .

math:credibleMass
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "credible mass"@x-gmeow-english ;
    skos:definition "Relates a math:CredibleInterval (or math:CredibleRegion) to its posterior mass — a framed math:ProbabilityValue (a 0.95) that is the posterior probability, given prior and data, that the parameter lies within the interval. Domain a credible interval or region, range math:ProbabilityValue (stated in prose). The mass is a POSTERIOR probability over the math:PosteriorDistribution the interval summarizes (math:hasPosterior), never a procedure's coverage; a credible interval naming no credible mass is ill-formed (math:IncompleteCredibleInterval). Its frequentist counterpart is math:confidenceLevel, held strictly apart from it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to carry the posterior mass of a credible interval or region, the posterior probability that the parameter lies within it given prior and data."@x-gmeow-english ;
    gmeow:avoidWhen "Do not carry it as a procedure coverage or collapse it onto math:confidenceLevel; the mass is a POSTERIOR probability, not a sampling coverage."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:CredibleInterval or math:CredibleRegion with range a framed math:ProbabilityValue over the posterior; missing it is math:IncompleteCredibleInterval."@x-gmeow-english ;
    skos:example "exf:cri95 math:credibleMass exf:m95 ."@x-gmeow-english ;
    skos:scopeNote "Posterior mass, the Bayesian counterpart of math:confidenceLevel (procedure coverage), held strictly apart from it."@x-gmeow-english .

math:predictionTarget
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "prediction target"@x-gmeow-english ;
    skos:definition "Relates a math:Prediction or a math:PredictionInterval to the target it forecasts — the outcome, unit, or future observation the prediction speaks about. Domain a math:Prediction or math:PredictionInterval, range the target object (stated in prose). Naming the target is what keeps a prediction a forecast ABOUT something (a new case's outcome) rather than a bare number, and distinguishes it from an estimate of a parameter."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to name what a prediction or prediction interval forecasts, the outcome, unit, or future observation it speaks about."@x-gmeow-english ;
    gmeow:avoidWhen "Do not leave a prediction targetless; a forecast about nothing is a bare number, and this edge is what makes it about a case."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:Prediction or math:PredictionInterval with range the target object."@x-gmeow-english ;
    skos:example "exf:pi90 math:predictionTarget exf:nextSale ."@x-gmeow-english ;
    skos:scopeNote "Names the forecast subject, distinct from math:estimatesEstimand, which names the target of an estimate of a parameter rather than an outcome forecast."@x-gmeow-english .

math:effectSize
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "effect size"@x-gmeow-english ;
    skos:definition "Relates an inference result or a math:HypothesisTest to the math:EffectSize accompanying it — the standardized magnitude of the effect the result concerns, alongside its significance. Domain a result object or a math:HypothesisTest, range math:EffectSize (stated in prose). Naming the effect size as an object is what lets 'how big is the effect', not only 'is it significant', be answered — a test with a p-value but no effect size reports distinguishability without magnitude."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to attach an effect size to a result or test, so how big the effect is accompanies whether it is significant."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report a test with a p-value but no effect size; that reports distinguishability without magnitude, which this edge exists to complete."@x-gmeow-english ;
    gmeow:howToUse "Set it on a result object or a math:HypothesisTest with range math:EffectSize."@x-gmeow-english ;
    skos:example "exf:tTest math:effectSize exf:cohensD ."@x-gmeow-english ;
    skos:scopeNote "Attaches magnitude to a result, distinct from math:pValue (distinguishability) carried by the same test."@x-gmeow-english .

math:effectSizeContrast
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "effect-size contrast"@x-gmeow-english ;
    skos:definition "Relates a math:EffectSize to the math:StatisticalContrast whose magnitude it measures — the comparison between conditions (a difference, a ratio, an odds ratio) the effect size quantifies the size of. Domain math:EffectSize, range math:StatisticalContrast (stated in prose). This is the SAME shared math:StatisticalContrast object a math:Estimand targets through math:targetContrast — one modeled contrast referenced by both the estimand's target and the effect size's magnitude, never two near-synonym contrasts — so the effect size and the estimand talk about the same comparison. An effect size naming no contrast is uninterpretable (math:UnframedEffectSize)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to name the comparison whose magnitude an effect size measures, referencing the SHARED contrast an estimand also targets."@x-gmeow-english ;
    gmeow:avoidWhen "Do not mint a separate contrast for the effect size; use the same math:StatisticalContrast an estimand names through math:targetContrast so both agree."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:EffectSize with range math:StatisticalContrast; missing it is math:UnframedEffectSize."@x-gmeow-english ;
    skos:example "exf:cohensD math:effectSizeContrast exf:treatVsControl ."@x-gmeow-english ;
    skos:scopeNote "The effect-size side of the shared contrast, the same object as an estimand math:targetContrast, distinct from math:effectSizeScale (the standardization)."@x-gmeow-english .

math:effectSizeScale
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "effect-size scale"@x-gmeow-english ;
    skos:definition "Relates a math:EffectSize to the math:MeasurementScale it is expressed on — the standardization (a standard-deviation scale for a Cohen's d, a correlation scale, a log-odds scale for an odds ratio) that fixes how its magnitude is read. Domain math:EffectSize, range math:MeasurementScale (stated in prose). The same math:MeasurementScale first-class object the variables layer uses; an effect size naming no scale is a magnitude with no units of comparison, uninterpretable (math:UnframedEffectSize)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to name the scale an effect size is expressed on, the standardization that fixes how its magnitude is read."@x-gmeow-english ;
    gmeow:avoidWhen "Do not omit the scale; an effect size with no units of comparison is a magnitude with no meaning, which is math:UnframedEffectSize."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:EffectSize with range math:MeasurementScale, the same first-class scale object the variables layer uses."@x-gmeow-english ;
    skos:example "exf:cohensD math:effectSizeScale exf:sdScale ."@x-gmeow-english ;
    skos:scopeNote "The standardization of a magnitude, distinct from math:effectSizeContrast (the comparison measured) and from the effect size reference frame carried by gmeow:hasReferenceFrame."@x-gmeow-english .

# --- Interval and effect-size conformance-failure classes ------------------- #

math:IntervalKindConflation
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Interval-Kind Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when one resource is typed BOTH a math:ConfidenceInterval and a math:CredibleInterval — frequentist coverage under a sampling procedure conflated with Bayesian posterior mass. They share the word 'interval' and nothing else: a confidence interval's level is a property of the procedure, a credible interval's mass is a posterior probability, and the two are held owl:disjointWith through their paradigm parents (math:ConfidenceInterval ⊑ math:FrequentistResult, math:CredibleInterval ⊑ math:BayesianResult, math:FrequentistResult owl:disjointWith math:BayesianResult). The disjointness is thus ENTAILED rather than directly asserted; the native DL coherence gate forces any individual typed both to owl:Nothing, and the paired SHACL shape (math:IntervalKindConflationShape) surfaces the same conflation as a finding."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "This failure is raised when one resource is typed both a confidence interval and a credible interval, mixing procedure coverage with posterior mass."@x-gmeow-english ;
    gmeow:avoidWhen "Do not type a single node as both interval kinds; they share only the word interval, one a procedure property and the other a posterior probability."@x-gmeow-english ;
    gmeow:howToUse "Entailed through the disjoint paradigm parents so the DL gate forces any node typed both to owl:Nothing; math:IntervalKindConflationShape surfaces it as a finding."@x-gmeow-english ;
    skos:example "exf:mixedInterval a math:IntervalKindConflation ."@x-gmeow-english ;
    skos:scopeNote "The interval-paradigm conflation finding, distinct from math:IncompleteConfidenceInterval and math:IncompleteCredibleInterval, which flag missing structure rather than crossed paradigms."@x-gmeow-english .

math:IncompleteConfidenceInterval
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Confidence Interval"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ConfidenceInterval does not carry the structure that makes it an interval estimate — its bounds through math:hasIntervalBound (a two-sided interval names its lower AND upper endpoint) or its coverage through math:confidenceLevel (a framed math:ProbabilityValue over the sampling procedure). A confidence interval with no bounds, or with no confidence level, is not a coverage statement but a bare pair of numbers, and is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "This failure is raised when a confidence interval lacks the structure that makes it an interval estimate, its bounds or its coverage level."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report a confidence interval as a bare pair of numbers with no confidence level, or a level with no bounds; either omission is this failure."@x-gmeow-english ;
    gmeow:howToUse "Detected when a math:ConfidenceInterval names no math:hasIntervalBound or no math:confidenceLevel; supply both to avoid it."@x-gmeow-english ;
    skos:example "exf:badCi a math:IncompleteConfidenceInterval ."@x-gmeow-english ;
    skos:scopeNote "The missing-structure finding for a confidence interval, distinct from math:IntervalKindConflation (crossed paradigms) and math:IncompleteCredibleInterval (the Bayesian counterpart)."@x-gmeow-english .

math:IncompleteCredibleInterval
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Incomplete Credible Interval"@x-gmeow-english ;
    skos:definition "The failure raised when a math:CredibleInterval does not carry the structure that makes it a Bayesian interval estimate — its posterior context through math:hasPosterior (the math:PosteriorDistribution it summarizes) or its posterior mass through math:credibleMass (a framed math:ProbabilityValue over that posterior). A credible interval with no posterior, or with no credible mass, cannot state a posterior probability that the parameter lies within it, and is ill-formed."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "This failure is raised when a credible interval lacks the structure that makes it a Bayesian interval estimate, its posterior context or its mass."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report a credible interval with no posterior or no credible mass; without them it cannot state a posterior probability and is ill-formed."@x-gmeow-english ;
    gmeow:howToUse "Detected when a math:CredibleInterval names no math:hasPosterior or no math:credibleMass; supply both to avoid it."@x-gmeow-english ;
    skos:example "exf:badCri a math:IncompleteCredibleInterval ."@x-gmeow-english ;
    skos:scopeNote "The missing-structure finding for a credible interval, distinct from math:IntervalKindConflation (crossed paradigms) and math:IncompleteConfidenceInterval (the frequentist counterpart)."@x-gmeow-english .

math:UnframedEffectSize
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unframed Effect Size"@x-gmeow-english ;
    skos:definition "The failure raised when a math:EffectSize does not identify all three of the frame that makes its magnitude interpretable: the comparison it measures through math:effectSizeContrast (a math:StatisticalContrast), the scale it is expressed on through math:effectSizeScale (a math:MeasurementScale), and its reference frame through gmeow:hasReferenceFrame. An effect size missing any of the three is an uninterpretable bare number — a magnitude with no comparison, no units of comparison, or no frame it is expressed in."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "This failure is raised when an effect size does not identify all three of the frame that makes its magnitude interpretable."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report an effect size missing its contrast, its scale, or its reference frame; any one missing leaves an uninterpretable bare number."@x-gmeow-english ;
    gmeow:howToUse "Detected when a math:EffectSize lacks math:effectSizeContrast, math:effectSizeScale, or gmeow:hasReferenceFrame; supply all three to avoid it."@x-gmeow-english ;
    skos:example "exf:bareD a math:UnframedEffectSize ."@x-gmeow-english ;
    skos:scopeNote "The uninterpretable-magnitude finding, distinct from math:IllFramedPValue (an ambiguous p-value) and math:UnderspecifiedEstimate (an estimate with no target or act)."@x-gmeow-english .

# =========================================================================== #
# Diagnostics, model comparison, calibration, and design/integrity             #
# (STATISTICS-charter "Model comparison and calibration" + "Design and         #
# integrity")                                                                  #
#                                                                              #
# A math:ModelDiagnostic evaluates a fitted model: it names the math:FittedModel#
# it is a diagnostic FOR (math:diagnosticFor) and the method it applies         #
# (math:diagnosticMethod), so a diagnostic anchored to neither its model nor its#
# method is ill-formed (math:UnanchoredDiagnostic). Comparing and calibrating   #
# models is first-class: math:ModelComparison, math:InformationCriterion        #
# (AIC/BIC/WAIC/…), math:CrossValidationResult, and — the STATISTICAL sense of   #
# calibration — math:CalibrationDiagnostic (predicted probabilities vs observed  #
# frequencies: reliability curves, Brier decomposition, expected calibration    #
# error). That statistical sense must NEVER be conflated with the TOPOLOGICAL    #
# math:StabilityCalibrationRecord (a credence calibrated against a bottleneck    #
# stability bound over a math:PersistenceLifetime): they share the word and      #
# nothing else. math:CalibrationDiagnostic ⊑ math:ModelDiagnostic and            #
# math:StabilityCalibrationRecord ⊑ math:MathematicalObject BOTH descend from    #
# math:MathematicalObject, so their disjointness is NOT entailed by their        #
# parents — it is asserted directly (math:CalibrationDiagnostic owl:disjointWith #
# math:StabilityCalibrationRecord, in the disjointness block) and surfaced by    #
# the paired math:CalibrationSenseConflationShape (math:CalibrationSenseConflation#
# ). The design/integrity core — math:ExperimentalDesign, math:Randomization     #
# Scheme, and math:AnalysisPlan (with math:analysisPlanVersion, and named by an  #
# inference run through math:usedAnalysisPlan) — records how units were assigned #
# and which pre-specified plan a result claims to follow, so pre-registered      #
# versus post-hoc is data, not lost context.                                    #
# =========================================================================== #

# --- Model diagnostics, comparison, and calibration (⊑ math:MathematicalObject) #

math:ModelDiagnostic
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Model Diagnostic"@x-gmeow-english ;
    skos:definition "A model diagnostic: a first-class evaluation of a fitted model — a residual plot's summary, a Q–Q assessment, a heteroscedasticity or influence measure, a goodness-of-fit statistic. A subclass of math:MathematicalObject that names the math:FittedModel it evaluates through math:diagnosticFor and the diagnostic method it applies through math:diagnosticMethod, so 'what was checked, on which fit, by which method' is queryable rather than folded into a plot's caption. A diagnostic anchored to neither its fitted model nor its method is ill-formed (math:UnanchoredDiagnostic)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for a first-class evaluation of a fitted model, a residual summary, a Q-Q assessment, a heteroscedasticity or influence measure, or a goodness-of-fit statistic."@x-gmeow-english ;
    gmeow:avoidWhen "Do not leave a check buried in a plot caption; a diagnostic anchored to neither its fit nor its method is math:UnanchoredDiagnostic."@x-gmeow-english ;
    gmeow:howToUse "Name the math:FittedModel it evaluates through math:diagnosticFor and the method it applies through math:diagnosticMethod."@x-gmeow-english ;
    skos:example "exf:qqPlot a math:ModelDiagnostic ; math:diagnosticFor exf:olsFit ; math:diagnosticMethod exf:qqAssessment ."@x-gmeow-english ;
    skos:scopeNote "An evaluation of one fit, distinct from a math:ModelComparison (weighing several fits) and from the math:ModelAssumption it may check."@x-gmeow-english ;
    gmeow:enforcesFailureClass math:UnanchoredDiagnostic .

math:ModelComparison
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Model Comparison"@x-gmeow-english ;
    skos:definition "A model comparison: a first-class object weighing two or more fitted models against one another — a likelihood-ratio test, an information-criterion difference, a cross-validated score comparison, a Bayes-factor model choice. A subclass of math:MathematicalObject; it names the math:FittedModel objects it evaluates through math:diagnosticFor (the same anchoring edge a diagnostic uses to point at a fit), so 'which model, and how it compared' is an answerable object rather than an implicit preference. Making the comparison first-class is what keeps model selection auditable rather than read off a single reported number."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one to weigh two or more fitted models against one another, a likelihood-ratio test, an information-criterion difference, or a cross-validated score comparison."@x-gmeow-english ;
    gmeow:avoidWhen "Do not read model selection off a single reported number; an implicit preference is not an auditable comparison."@x-gmeow-english ;
    gmeow:howToUse "Name the math:FittedModel objects it evaluates through math:diagnosticFor, the same anchoring edge a diagnostic uses."@x-gmeow-english ;
    skos:example "exf:aicCompare a math:ModelComparison ; math:diagnosticFor exf:olsFit ."@x-gmeow-english ;
    skos:scopeNote "A weighing of several fits, distinct from a math:ModelDiagnostic (evaluating one fit) and from the math:InformationCriterion or math:CrossValidationResult scores it contrasts."@x-gmeow-english .

math:InformationCriterion
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Information Criterion"@x-gmeow-english ;
    skos:definition "An information criterion: a penalized-fit score for a fitted model that trades goodness-of-fit against complexity — an AIC, a BIC, a WAIC, a DIC, a leave-one-out score. A subclass of math:MathematicalObject naming the math:FittedModel it scores through math:diagnosticFor, so a criterion value is never a bare number detached from the fit it penalizes and the model comparison that reads it. It is the per-model score a math:ModelComparison contrasts, held as its own object rather than an attribute buried in a fit summary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for a penalized-fit score trading goodness-of-fit against complexity, an AIC, BIC, WAIC, DIC, or leave-one-out score."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report a criterion value detached from the fit it penalizes; a bare number invites comparison across incomparable models."@x-gmeow-english ;
    gmeow:howToUse "Name the math:FittedModel it scores through math:diagnosticFor; it is the per-model score a math:ModelComparison contrasts."@x-gmeow-english ;
    skos:example "exf:aicFit a math:InformationCriterion ; math:diagnosticFor exf:olsFit ."@x-gmeow-english ;
    skos:scopeNote "An in-sample penalized score, distinct from math:CrossValidationResult (a held-out score) and from the math:ModelComparison that reads either."@x-gmeow-english .

math:CrossValidationResult
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Cross-Validation Result"@x-gmeow-english ;
    skos:definition "A cross-validation result: the out-of-sample performance estimate a resampling scheme (k-fold, leave-one-out, repeated, nested) produces for a fitted model — a held-out score with its resampling structure, distinct from an in-sample fit statistic. A subclass of math:MathematicalObject naming the math:FittedModel it evaluates through math:diagnosticFor, so a validated score carries which fit it estimates the generalization of. It is the held-out counterpart to an in-sample math:InformationCriterion, and a math:ModelComparison may weigh either."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for an out-of-sample performance estimate a resampling scheme produces for a fitted model, a held-out score with its resampling structure."@x-gmeow-english ;
    gmeow:avoidWhen "Do not confuse a held-out score with an in-sample fit statistic; the whole point is generalization, not fit to the training data."@x-gmeow-english ;
    gmeow:howToUse "Name the math:FittedModel it evaluates through math:diagnosticFor; a math:ModelComparison may weigh it against an information criterion."@x-gmeow-english ;
    skos:example "exf:cv10 a math:CrossValidationResult ; math:diagnosticFor exf:olsFit ."@x-gmeow-english ;
    skos:scopeNote "A held-out generalization estimate, distinct from math:InformationCriterion (an in-sample penalized score) and from the math:ModelComparison that reads either."@x-gmeow-english .

math:CalibrationDiagnostic
    a owl:Class ;
    rdfs:subClassOf math:ModelDiagnostic ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Calibration Diagnostic"@x-gmeow-english ;
    skos:definition "A calibration diagnostic: the STATISTICAL sense of calibration — how well a fitted model's predicted probabilities match observed frequencies over held-out data, measured by a reliability curve, a Brier-score decomposition, or an expected-calibration-error binning. A subclass of math:ModelDiagnostic (a calibration diagnostic IS a model diagnostic), so it names the math:FittedModel whose probabilities it checks through math:diagnosticFor and the method it applies through math:diagnosticMethod. It is held owl:disjointWith math:StabilityCalibrationRecord — the TOPOLOGICAL sense, which calibrates a credence against a bottleneck stability bound over a math:PersistenceLifetime: the two share the word 'calibration' and nothing else, one calibrating a model's probabilities against data and the other a credence against a stability guarantee, so a consumer selects on the specific class, never on the shared token. Because both descend from math:MathematicalObject their disjointness is NOT entailed by their parents and is asserted directly; a node typed both is math:CalibrationSenseConflation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the STATISTICAL sense of calibration, how well a model predicted probabilities match observed frequencies over held-out data."@x-gmeow-english ;
    gmeow:avoidWhen "Do not use it for the topological calibration of a credence against a stability bound; that is math:StabilityCalibrationRecord, and typing a node both is a sense conflation."@x-gmeow-english ;
    gmeow:howToUse "As a math:ModelDiagnostic, name the math:FittedModel whose probabilities it checks through math:diagnosticFor and its method through math:diagnosticMethod, a reliability curve or expected-calibration-error binning."@x-gmeow-english ;
    skos:example "exf:reliability a math:CalibrationDiagnostic ; math:diagnosticFor exf:logitFit ; math:diagnosticMethod exf:eceBinning ."@x-gmeow-english ;
    skos:scopeNote "The statistical calibration sense (probabilities against frequencies), held disjoint from math:StabilityCalibrationRecord (a credence against a stability bound); crossing them is math:CalibrationSenseConflation."@x-gmeow-english ;
    gmeow:enforcesFailureClass math:CalibrationSenseConflation .

# --- Design and integrity (⊑ math:MathematicalObject) ----------------------- #

math:ExperimentalDesign
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Experimental Design"@x-gmeow-english ;
    skos:definition "An experimental design: the first-class record of how a study's units were structured and assigned — a completely randomized, block, factorial, crossover, or split-plot design. A subclass of math:MathematicalObject; together with the math:RandomizationScheme it names, it records how units were assigned to conditions, so the design is queryable structure rather than a phrase in a methods section. Naming the design as an object is what lets an analysis's validity conditions be checked against the assignment that actually produced the data."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the first-class record of how a study units were structured and assigned, a completely randomized, block, factorial, crossover, or split-plot design."@x-gmeow-english ;
    gmeow:avoidWhen "Do not leave the design as a phrase in a methods section; an implicit design cannot be checked against the analysis validity conditions."@x-gmeow-english ;
    gmeow:howToUse "Type it as a math:MathematicalObject and pair it with the math:RandomizationScheme naming how units were assigned to conditions."@x-gmeow-english ;
    skos:example "exf:rct1 a math:ExperimentalDesign ."@x-gmeow-english ;
    skos:scopeNote "The structure-and-assignment record, distinct from the math:RandomizationScheme (the assignment rule) it names and from the math:SurveyDesign of an observational sample."@x-gmeow-english .

math:RandomizationScheme
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Randomization Scheme"@x-gmeow-english ;
    skos:definition "A randomization scheme: the first-class rule by which units were assigned to conditions — simple, blocked, stratified, cluster, or adaptive randomization, with its allocation ratio and any constraints. A subclass of math:MathematicalObject naming the assignment mechanism a math:ExperimentalDesign uses, so how randomness entered the assignment is recorded structure rather than an implicit assumption. Holding the scheme as an object is what lets a design's exchangeability and its analysis's warrant be traced to the mechanism that generated the assignment."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the first-class rule by which units were assigned to conditions, simple, blocked, stratified, cluster, or adaptive randomization with its allocation ratio."@x-gmeow-english ;
    gmeow:avoidWhen "Do not leave the assignment mechanism as an implicit assumption; a design exchangeability and warrant trace to the mechanism that generated the assignment."@x-gmeow-english ;
    gmeow:howToUse "Name it as the assignment mechanism a math:ExperimentalDesign uses."@x-gmeow-english ;
    skos:example "exf:blockRandom a math:RandomizationScheme ."@x-gmeow-english ;
    skos:scopeNote "The assignment mechanism, distinct from the math:ExperimentalDesign that uses it and from the math:SamplingWeight or math:SurveyDesign of survey selection."@x-gmeow-english .

math:AnalysisPlan
    a owl:Class ;
    rdfs:subClassOf math:MathematicalObject ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Analysis Plan"@x-gmeow-english ;
    skos:definition "An analysis plan: the pre-specified plan a result claims to follow — the primary and secondary endpoints, the estimand, the model, and the decision rule fixed BEFORE the data were seen. A subclass of math:MathematicalObject carrying its version through math:analysisPlanVersion (a version literal or a version object) and named by the inference run that ran it through math:usedAnalysisPlan, so pre-registered versus post-hoc is data, not lost context. A result that names the plan and its version it followed is one whose analysis-was-pre-specified claim is auditable rather than asserted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "Mint one for the pre-specified plan a result claims to follow, its endpoints, estimand, model, and decision rule fixed before the data were seen."@x-gmeow-english ;
    gmeow:avoidWhen "Do not treat a post-hoc analysis as pre-specified; naming the plan and version is what makes the pre-registration claim auditable rather than asserted."@x-gmeow-english ;
    gmeow:howToUse "Carry its version through math:analysisPlanVersion and name it from the run through math:usedAnalysisPlan."@x-gmeow-english ;
    skos:example "exf:plan1 a math:AnalysisPlan ; math:analysisPlanVersion exf:v2 ."@x-gmeow-english ;
    skos:scopeNote "The pre-specified plan, distinct from the math:InferenceRun that follows it (math:usedAnalysisPlan) and from the math:ModelAssumption objects the model within it posits."@x-gmeow-english .

# --- Diagnostic, comparison, and design object properties ------------------- #

math:diagnosticFor
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "diagnostic for"@x-gmeow-english ;
    skos:definition "Relates a math:ModelDiagnostic (or the math:ModelComparison, math:InformationCriterion, math:CalibrationDiagnostic, and math:CrossValidationResult that specialize the diagnostic role over a fit) to the math:FittedModel it evaluates. Domain a model-evaluation object, range math:FittedModel (stated in prose). It is the anchoring edge that ties an evaluation to the fit it speaks about; a math:ModelDiagnostic naming no fitted model through it is ill-formed (math:UnanchoredDiagnostic). One shared edge for 'the fit this evaluation is about', never a near-synonym per diagnostic kind."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to anchor a model evaluation to the fit it speaks about, one shared edge for the-fit-this-evaluation-is-about."@x-gmeow-english ;
    gmeow:avoidWhen "Do not mint a near-synonym edge per diagnostic kind; comparison, criterion, calibration, and cross-validation all reuse this one anchor."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:ModelDiagnostic, math:ModelComparison, math:InformationCriterion, math:CalibrationDiagnostic, or math:CrossValidationResult with range math:FittedModel; a diagnostic naming no fit is math:UnanchoredDiagnostic."@x-gmeow-english ;
    skos:example "exf:qqPlot math:diagnosticFor exf:olsFit ."@x-gmeow-english ;
    skos:scopeNote "Anchors an evaluation to a fit, distinct from math:diagnosticMethod (the procedure applied) and from math:modelAssumption (a condition of the model itself)."@x-gmeow-english .

math:diagnosticMethod
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "diagnostic method"@x-gmeow-english ;
    skos:definition "Relates a math:ModelDiagnostic to the method it applies — a residual-analysis procedure, a goodness-of-fit test, an influence measure, a reliability-curve or expected-calibration-error binning for a math:CalibrationDiagnostic. Domain math:ModelDiagnostic, range the diagnostic method object (stated in prose). The method is a first-class object, not an opaque label, so a diagnostic's procedure is queryable alongside the fit it evaluates; a diagnostic naming no method is ill-formed (math:UnanchoredDiagnostic). Held apart from math:usesProofMethod (a proof's strategy) and math:estimator (an estimate's procedure): this is the method a diagnostic applies over a fit."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to name the method a diagnostic applies, a residual-analysis procedure, goodness-of-fit test, influence measure, or reliability-curve binning."@x-gmeow-english ;
    gmeow:avoidWhen "Do not leave the method an opaque label; a diagnostic naming no method is math:UnanchoredDiagnostic."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:ModelDiagnostic with range the method object."@x-gmeow-english ;
    skos:example "exf:qqPlot math:diagnosticMethod exf:qqAssessment ."@x-gmeow-english ;
    skos:scopeNote "The procedure a diagnostic applies over a fit, distinct from math:diagnosticFor (the fit anchored to), math:usesProofMethod (a proof strategy), and math:estimator (an estimate procedure)."@x-gmeow-english .

math:analysisPlanVersion
    a rdf:Property ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "analysis-plan version"@x-gmeow-english ;
    skos:definition "Relates a math:AnalysisPlan to its version — the identifier fixing WHICH revision of the pre-specified plan a result followed. Domain math:AnalysisPlan, range a version literal (a SemVer-like string or release label) or a version object (stated in prose). It is an rdf:Property, not an owl:ObjectProperty or owl:DatatypeProperty, precisely because its range spans both a datatype literal and an individual: neither DL property kind admits both, so the honest RDF supertype carries the version without a DL contradiction (mirroring math:totalMass). Naming the version is what distinguishes a plan followed pre-registration from a later-amended one, so pre-registered versus post-hoc is data."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to fix WHICH revision of a pre-specified plan a result followed, distinguishing a pre-registration from a later amendment."@x-gmeow-english ;
    gmeow:avoidWhen "Do not treat every plan as one version; without the version, pre-registered versus post-hoc is lost context rather than data."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:AnalysisPlan with range either a version literal or a version object; it is an rdf:Property because its range spans both, like math:totalMass."@x-gmeow-english ;
    skos:example "exf:plan1 math:analysisPlanVersion exf:v2 ."@x-gmeow-english ;
    skos:scopeNote "The plan revision identifier, distinct from the math:AnalysisPlan it versions and from the math:usedAnalysisPlan edge tying a run to that plan."@x-gmeow-english .

math:usedAnalysisPlan
    a owl:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "used analysis plan"@x-gmeow-english ;
    skos:definition "Relates a math:InferenceRun (or another analysis gmeow:Activity) to the math:AnalysisPlan it followed. Domain an inference or analysis process, range math:AnalysisPlan (stated in prose). It is the process-layer edge that lets a result's claim to follow a pre-specified plan be traced from the run to the plan and its math:analysisPlanVersion, so 'which plan, at which version, this analysis ran under' is queryable rather than asserted in prose."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:useWhen "Use to trace an inference run to the plan it followed, so which plan at which version an analysis ran under is queryable."@x-gmeow-english ;
    gmeow:avoidWhen "Do not assert pre-specification in prose; the traceable edge from run to plan is what makes the claim auditable."@x-gmeow-english ;
    gmeow:howToUse "Set it on a math:InferenceRun or another analysis gmeow:Activity with range math:AnalysisPlan."@x-gmeow-english ;
    skos:example "exf:run1 math:usedAnalysisPlan exf:plan1 ."@x-gmeow-english ;
    skos:scopeNote "The process-to-plan edge, distinct from math:analysisPlanVersion (the plan revision) reached through the plan it points at."@x-gmeow-english .

# --- Diagnostic and calibration conformance-failure classes ----------------- #

math:UnanchoredDiagnostic
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Unanchored Diagnostic"@x-gmeow-english ;
    skos:definition "The failure raised when a math:ModelDiagnostic does not anchor itself to what it evaluates and how — it names no math:FittedModel through math:diagnosticFor, or no method through math:diagnosticMethod. A diagnostic is an evaluation OF a fit BY a method; missing either its fitted model or its method, it is a floating number rather than a checked property of a model, and is ill-formed. Primary gate: the SHACL-Core requirement (math:UnanchoredDiagnosticShape) that a diagnostic name both its fitted model and its diagnostic method."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "This failure is raised for a diagnostic that does not anchor itself to what it evaluates and how, a floating number rather than a checked property."@x-gmeow-english ;
    gmeow:avoidWhen "Do not report a diagnostic naming no fitted model or no method; missing either, it is not a checked property of a model."@x-gmeow-english ;
    gmeow:howToUse "Detected by math:UnanchoredDiagnosticShape when a math:ModelDiagnostic names no math:diagnosticFor or no math:diagnosticMethod; supply both to avoid it."@x-gmeow-english ;
    skos:example "exf:floatingDiag a math:UnanchoredDiagnostic ."@x-gmeow-english ;
    skos:scopeNote "The unanchored-evaluation finding, distinct from math:CalibrationSenseConflation (a crossed calibration sense) and from a well-formed math:ModelDiagnostic."@x-gmeow-english .

math:CalibrationSenseConflation
    a owl:Class ;
    rdfs:subClassOf math:MathConformanceFailure ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Calibration-Sense Conflation"@x-gmeow-english ;
    skos:definition "The failure raised when one node is typed BOTH a math:CalibrationDiagnostic and a math:StabilityCalibrationRecord — the STATISTICAL sense of calibration (a model's predicted probabilities against observed frequencies) conflated with the TOPOLOGICAL sense (a credence calibrated against a bottleneck stability bound over a math:PersistenceLifetime). They share the word 'calibration' and nothing else. Because math:CalibrationDiagnostic ⊑ math:ModelDiagnostic ⊑ math:MathematicalObject and math:StabilityCalibrationRecord ⊑ math:MathematicalObject both descend from math:MathematicalObject, the disjointness is NOT entailed by their parents and is asserted DIRECTLY (math:CalibrationDiagnostic owl:disjointWith math:StabilityCalibrationRecord); the native DL coherence gate forces any individual typed both to owl:Nothing, and the paired SHACL shape (math:CalibrationSenseConflationShape) surfaces the same conflation as a finding so a consumer selects on the specific class, never on the shared token."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:useWhen "This failure is raised when one node is typed both a calibration diagnostic and a stability calibration record, mixing the statistical and topological senses of calibration."@x-gmeow-english ;
    gmeow:avoidWhen "Do not type a node as both calibration senses; they share only the word calibration, one a model probabilities against frequencies and the other a credence against a stability bound."@x-gmeow-english ;
    gmeow:howToUse "Asserted directly because both descend from math:MathematicalObject, so the DL gate forces a node typed both to owl:Nothing; math:CalibrationSenseConflationShape surfaces it as a finding."@x-gmeow-english ;
    skos:example "exf:mixedCalib a math:CalibrationSenseConflation ."@x-gmeow-english ;
    skos:scopeNote "The calibration-sense conflation finding, distinct from math:UnanchoredDiagnostic (a diagnostic with no fit or method) and from a well-formed math:CalibrationDiagnostic."@x-gmeow-english .

# =========================================================================== #
# Procedural constraints — projected to sh:SPARQLConstraint (the validation    #
# twin of the derivation surface). Each is a compact logic: constraint-sugar   #
# record carrying logic:formalizes, expanded by the frontend to a canonical    #
# logic:Constraint and lowered to a sh:SPARQLConstraint.                       #
# =========================================================================== #

# math:Norm — the inducing symmetric bilinear form must be positive-definite:
# ‖x‖ = √⟨x, x⟩ is a genuine norm only for a positive-definite form. A
# path-value fixed-value check: every value reached by math:inducedByForm must
# carry math:definiteness math:positiveDefinite.
math:NormPositiveDefiniteConstraint
    a logic:PathValueTypeConstraint ;
    logic:onClass math:Norm ;
    logic:valuePath math:inducedByForm ;
    logic:valuePredicate math:definiteness ;
    logic:valueObject math:positiveDefinite ;
    logic:formalizes math:NormPositiveDefiniteShape ;
    gmeow:enforcesFailureClass math:NonPositiveDefiniteNorm ;
    logic:message "A math:Norm's math:inducedByForm must be positive-definite (math:definiteness math:positiveDefinite); a norm resting on a non-positive-definite form is ill-formed (math:NonPositiveDefiniteNorm)." .

# math:GramMatrix positive-definiteness — a Gram matrix that math:representsForm a
# form declared math:positiveDefinite must itself carry math:definiteness
# math:positiveDefinite (the declarative twin). The DEEP enforcement is the native
# measure-and-dimension reasoned-graph gate, which — because SHACL/Datalog cannot
# compute an LDLᵀ factorization — is the SOLE positive-definiteness enforcement
# point: it fills the declared symmetric Gram from its exact math:RationalValue
# cells and certifies positive-definiteness by the exact-rational LDLᵀ pivots (all
# > 0 by Sylvester's criterion). A Gram authored positive-definite whose pivots
# refute it raises math:NonPositiveDefiniteNorm; the runtime affect-distance
# builtin trusts this certificate.
math:GramPositiveDefiniteConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/math> ;
    rdfs:label "Gram positive-definiteness constraint"@x-gmeow-english ;
    skos:definition "The closed-world integrity constraint that a math:GramMatrix representing a math:positiveDefinite form (math:representsForm a form whose math:definiteness is math:positiveDefinite) must itself declare math:definiteness math:positiveDefinite — the SHACL-projectable declarative twin. The exact positive-definiteness verdict is decided by the native measure-and-dimension reasoned-graph gate through the exact-rational LDLᵀ factorization (SHACL/Datalog cannot factor a matrix), which is the sole positive-definiteness enforcement point the runtime affect-distance builtin trusts; a Gram authored positive-definite whose LDLᵀ pivots refute it raises math:NonPositiveDefiniteNorm."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:enforcesFailureClass math:NonPositiveDefiniteNorm ;
    logic:severity "Violation" ;
    logic:message "A math:GramMatrix representing a positive-definite form must be positive-definite; the native measure-and-dimension reasoned gate certifies this by the exact-rational LDLᵀ factorization and raises math:NonPositiveDefiniteNorm when the pivots refute the authored positive-definiteness." ;
    logic:integrity math:gpdForall .
math:gpdForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "g" ] , [ logic:termIndex 1 ; logic:termVariable "f" ] ;
    logic:forall math:gpdImpl .
math:gpdImpl a logic:Formula ; logic:antecedent math:gpdGuard ; logic:consequent math:gpdConsequent .
math:gpdGuard a logic:Formula ; logic:and math:gpdType , math:gpdRepresents , math:gpdFormPd .
math:gpdType a logic:Formula ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] , [ logic:termIndex 1 ; logic:termIri math:GramMatrix ] .
math:gpdRepresents a logic:Formula ; logic:relation math:representsForm ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] , [ logic:termIndex 1 ; logic:termVariable "f" ] .
math:gpdFormPd a logic:Formula ; logic:relation math:definiteness ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "f" ] , [ logic:termIndex 1 ; logic:termIri math:positiveDefinite ] .
math:gpdConsequent a logic:Formula ; logic:relation math:definiteness ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "g" ] , [ logic:termIndex 1 ; logic:termIri math:positiveDefinite ] .

# math:LogicLoweringShape — any expression lowered to a logic:Formula through
# math:compilesToLogicFormula must declare its math:denotationKind and its
# math:logicLoweringPreservation; silent promotion is forbidden. A
# predicate-presence guarded implication (no target class — the trigger
# predicate is the range restriction, so the shape targets subjects of
# math:compilesToLogicFormula).
math:LogicLoweringDeclaredConstraint
    a logic:GuardedImplicationConstraint ;
    logic:trigger math:compilesToLogicFormula ;
    logic:requires math:denotationKind , math:logicLoweringPreservation ;
    logic:formalizes math:LogicLoweringShape ;
    gmeow:enforcesFailureClass math:UndeclaredLogicLowering ;
    logic:message "An expression lowered to a logic:Formula through math:compilesToLogicFormula must declare its math:denotationKind and its math:logicLoweringPreservation; silent promotion to a logical assertion is forbidden (math:UndeclaredLogicLowering)." .

# math:AnalyticProperty — every analytic-property individual MUST resolve to a real
# first-order logic:Formula or an honest logic:expressivenessBoundary through
# math:definingLaw; a bare analytic-property claim backed by no law is ill-formed
# (math:UnbackedAnalyticProperty). A class-guarded existence: every math:AnalyticProperty
# requires a math:definingLaw. Lowers to a sh:sparql constraint (shacl.SPARQLConstraintComponent).
math:AnalyticPropertyBackedConstraint
    a logic:GuardedImplicationConstraint ;
    logic:onClass math:AnalyticProperty ;
    logic:trigger rdf:type ;
    logic:triggerValue math:AnalyticProperty ;
    logic:requires math:definingLaw ;
    logic:formalizes math:AnalyticProperty ;
    gmeow:enforcesFailureClass math:UnbackedAnalyticProperty ;
    logic:message "A math:AnalyticProperty must resolve to a real first-order logic:Formula or an honest logic:expressivenessBoundary through math:definingLaw; an analytic-property claim backed by no law and no boundary is ill-formed (math:UnbackedAnalyticProperty)." .

