gmeow:MemoryBankTextlessConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "textless bank identity constraint"@x-gmeow-english ;
    skos:definition "A MemoryBank identity carries none of the revision, summary or appraisal payload text properties. Labels can name the bank without turning it into a revision."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency of the supplied memory record and source bindings."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this law proves access enforcement, authorship, digest computation or governed migration."@x-gmeow-english ;
    gmeow:howToUse "Retain the original record and evidence when reporting an intrinsic violation; do not manufacture missing inputs."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:MemoryBankTextlessConstraint logic:formalizes gmeow:MemoryBank ."@x-gmeow-english ;
    logic:formalizes gmeow:MemoryBank ;
    logic:message "A MemoryBank identity carries none of the revision, summary or appraisal payload text properties. Labels can name the bank without turning it into a revision." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation rdf:type ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                    [ logic:termIndex 1 ; logic:termIri gmeow:MemoryBank ] ] ;
            logic:consequent [ a logic:Formula ; logic:not [ a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "value" ] ;
                    logic:exists [ a logic:Formula ; logic:or
                        [ a logic:Formula ; logic:relation gmeow:memoryText ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "value" ] ],
                        [ a logic:Formula ; logic:relation gmeow:summaryText ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "value" ] ],
                        [ a logic:Formula ; logic:relation gmeow:summaryAnchor ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "value" ] ],
                        [ a logic:Formula ; logic:relation gmeow:distilledText ;
                            logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                                [ logic:termIndex 1 ; logic:termVariable "value" ] ] ] ] ] ] ] .

gmeow:MemoryBankRevisionTextConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/memory-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "bank revision text constraint"@x-gmeow-english ;
