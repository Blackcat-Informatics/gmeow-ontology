@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# gmeow:sliceDependsOn lists ONLY the slices this module's own axioms depend on.
# The pedagogy pointers do NOT belong in it: gmeow:usesExamplePath and
# gmeow:followsGuidePath are path STRINGS, and gmeow:usesTerm is an open
# documentation index (rdfs:range rdfs:Resource — "a guide may point at any
# documented term across any slice"). A recipe that indexes an extension's term
# asserts nothing about it — no subclass, domain, range, or constraint — so it is
# not a build dependency, and declaring one from this CORE slice would be a
# tier-forbidden crossing (Principle 16) with no semantics behind it.

<https://blackcatinformatics.ca/gmeow/slices/guides>
    a gmeow:Slice ;
    rdfs:label "guides"@x-gmeow-english ;
    skos:definition "The guides slice of the GMEOW ontology (core tier): GMEOW Guides Module — the pedagogy and adoption-guides surface. It models task-oriented adoption recipes (gmeow:Recipe) and curated learning paths (gmeow:LearningPath) as first-class individuals that sequence canonical examples, vocabulary terms, and follow-on reading for a developer adopting GMEOW. These curated guides were formerly hardcoded in the documentation tooling; dogfooding them here makes them authored-once GMEOW data that survives the retirement of that tooling. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/guides> ;
    dcterms:title "GMEOW Guides Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierCore ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/ai> ,
        <https://blackcatinformatics.ca/gmeow/slices/attestation> ,
        <https://blackcatinformatics.ca/gmeow/slices/contacts> ,
        <https://blackcatinformatics.ca/gmeow/slices/documents> ,
        <https://blackcatinformatics.ca/gmeow/slices/entities> ,
        <https://blackcatinformatics.ca/gmeow/slices/events> ,
        <https://blackcatinformatics.ca/gmeow/slices/evidence> ,
        <https://blackcatinformatics.ca/gmeow/slices/gts> ,
        <https://blackcatinformatics.ca/gmeow/slices/names> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/places> ,
        <https://blackcatinformatics.ca/gmeow/slices/provenance> ,
        <https://blackcatinformatics.ca/gmeow/slices/standpoint> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:sliceProfile "claims" ;
    gmeow:sliceConsumer "The documentation renderer (gmeow-docs) projects these recipes and learning paths into the recipes/, learning-paths/, and four-boxes/ pages of the ontology docs site, linking each guide to the term pages and example files it sequences; adoption tooling consumes them as the task-oriented entry points a developer follows when first modelling a person, a contested claim, web structured data, an offline GTS distribution, or a graph-RAG pipeline in GMEOW."@x-gmeow-english .
