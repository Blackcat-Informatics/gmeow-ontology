        ?card a gmeow:ModelCard .
        ?card gmeow:describesModel ?model .
        OPTIONAL { ?card gmeow:modelVersionTag ?vtag . }
        OPTIONAL { ?model rdfs:label ?mname . }
        FILTER NOT EXISTS { ?card gmeow:displayable false . }
    }
    UNION {
