@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix math:   <https://blackcatinformatics.ca/math/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix wd:     <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).
#
# Named constants and the number systems are anchored to Wikidata (the identity
# hub — CC0), and each named constant additionally carries its OEIS decimal-
# expansion locator (link-only, by reference; Principle 5 — every object IRI is a
# real external entity, curl-validated). A constant's Wikidata QID is its identity
# (skos:exactMatch); a number system's QID names the number-type concept, a close
# but not invertible match to the system individual (skos:closeMatch); an OEIS
# A-number locates the decimal digits of a constant, a related resource rather than
# its identity (skos:relatedMatch).

# --- Named constants → Wikidata (identity) --------------------------------- #

gmeow:eqMathPi a gmeow:TermEquivalence ;
    gmeow:alignSubject math:pi ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q167 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "pi" ;
    gmeow:comment "math:pi is the exact constant π; wd:Q167 (pi) is the same constant — the ratio of a circle's circumference to its diameter. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqMathEulerNumber a gmeow:TermEquivalence ;
    gmeow:alignSubject math:eulerNumber ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q82435 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "Euler's number" ;
    gmeow:comment "math:eulerNumber is the exact constant e; wd:Q82435 (Euler's number) is the same constant — the base of the natural logarithm. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

gmeow:eqMathEulerMascheroni a gmeow:TermEquivalence ;
    gmeow:alignSubject math:eulerMascheroni ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q273023 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "Euler–Mascheroni constant" ;
    gmeow:comment "math:eulerMascheroni is the exact constant γ; wd:Q273023 (Euler–Mascheroni constant) is the same constant — the limiting difference between the harmonic series and the natural logarithm. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

# --- Named constants → OEIS (decimal-expansion locator, by reference) ------ #

gmeow:eqMathPiOeis a gmeow:TermEquivalence ;
