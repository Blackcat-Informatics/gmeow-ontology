@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix dcterms: <http://purl.org/dc/terms/> .

gmeow:AggregationFunction
    a logic:AbstractIndividualType ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "Aggregation Function"@x-gmeow-english ;
    rdfs:subClassOf logic:QualityValue ;
    skos:definition "The kind of statistical aggregation applied to a spatial region — a value vocabulary (individuals, never subclasses)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:SpatialAggregation
    a logic:SubKind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "Spatial Aggregation"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Measurement ;
    skos:definition "A measurement that aggregates entities located within a spatial region, yielding one or more results such as a count, density, centroid, or average. The aggregation region is the observedFeature. Dimensioned numeric results use math:Quantity; results with an existing canonical carrier, such as gmeow:MonetaryAmount for currency-framed averages, retain that type. The actual computation is performed by the solver layer (Principle 12), not materialised as asserted triples in the OWL core."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:SpatialBin
    a logic:SubKind ,
        logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "Spatial Bin"@x-gmeow-english ;
    rdfs:subClassOf gmeow:Place ;
    skos:definition "A place that serves as a spatial bin in an aggregation grid — a generated region used to partition space for statistical summarisation. Its geometry defines the bin boundary; its aggregation result is a SpatialAggregation."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

gmeow:aggAverage
    a gmeow:AggregationFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "average"@x-gmeow-english ;
    skos:definition "The arithmetic mean of a numeric property over entities within the aggregation region."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:aggCentroid
    a gmeow:AggregationFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "centroid"@x-gmeow-english ;
    skos:definition "The geometric centre of the aggregation region or of the entities within it. Computed by the solver layer (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:aggCount
    a gmeow:AggregationFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "count"@x-gmeow-english ;
    skos:definition "The number of entities within the aggregation region."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:aggDensity
    a gmeow:AggregationFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "density"@x-gmeow-english ;
    skos:definition "The number of entities per unit area within the aggregation region. Computed by the solver layer (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:aggMaximum
    a gmeow:AggregationFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "maximum"@x-gmeow-english ;
    skos:definition "The largest value of a numeric property over entities within the aggregation region."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:aggMinimum
    a gmeow:AggregationFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "minimum"@x-gmeow-english ;
    skos:definition "The smallest value of a numeric property over entities within the aggregation region."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:aggSum
    a gmeow:AggregationFunction ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "sum"@x-gmeow-english ;
    skos:definition "The arithmetic sum of a numeric property over entities within the aggregation region."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:aggregationFunction
    a logic:ObjectProperty ;
    rdfs:domain gmeow:SpatialAggregation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "aggregation function"@x-gmeow-english ;
    rdfs:range gmeow:AggregationFunction ;
    skos:definition "The statistical function applied to the entities in the aggregation region — count, sum, average, density, minimum, maximum, or centroid."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:hasBin
    a logic:ObjectProperty ;
    rdfs:domain gmeow:SpatialAggregation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "has bin"@x-gmeow-english ;
    rdfs:range gmeow:SpatialBin ;
    skos:definition "Links a spatial aggregation to one of its constituent spatial bins. Non-functional: a bin may participate in multiple aggregations."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

gmeow:minimumPopulation
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:SpatialAggregation ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "minimum population"@x-gmeow-english ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:definition "The minimum population size (k) required for the aggregation result to be disclosed — the k-anonymity parameter. A result failing this check is suppressed at projection time (coarsen or withhold, Principle 10), never deleted."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

<https://blackcatinformatics.ca/gmeow/slices/aggregation>
    a logic:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Spatial aggregation and statistical summarisation over places — count, sum, average, density, centroid, and binning. Realises the Location-as-reference-frame design and the centroid shortcut cross-cutting aggregation concern.

Every aggregation is a gmeow:Measurement (the universal observation stack), so vantage, observedFeature, observationResult, confidence, granularity, and temporal scope are inherited without duplication (Principle 4). The aggregation region is the observedFeature. Dimensioned numeric results use math:Quantity; domain-specific results retain their canonical carrier (for example gmeow:MonetaryAmount for a currency-framed average), and multiple frame- or standpoint-indexed results may coexist. The actual arithmetic — counting, density computation, centroid calculation, binning — is performed by the solver layer (Principle 12), never materialised as asserted triples in the OWL core.

Privacy (k-anonymity, coarsening, suppression) is handled by the existing projection layer: gmeow:coarsenTo, gmeow:displayable false, and gmeow:hasSensitivity govern whether and at what granularity an aggregation result may be published (Principle 10). K-anonymity thresholds ("publish only if count >= K") remain a solver-layer computation (Principle 12)."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "GMEOW Spatial Aggregation Module"@x-gmeow-english ;
    skos:definition "The GMEOW Spatial Aggregation Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxConfigBox ,
        gmeow:boxTBox .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/SpatialAggregation> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/aggregationFunction> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/AggregationFunction> ] .
<https://blackcatinformatics.ca/gmeow/SpatialAggregation> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/minimumPopulation> ; logic:allValuesFrom <http://www.w3.org/2001/XMLSchema#nonNegativeInteger> ] .
<https://blackcatinformatics.ca/gmeow/SpatialAggregation> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/observationResult> ; logic:allValuesFrom logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/SpatialAggregation> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/observedFeature> ; logic:allValuesFrom <https://blackcatinformatics.ca/gmeow/Place> ] .
<https://blackcatinformatics.ca/gmeow/SpatialAggregation> logic:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/vantage> ; logic:allValuesFrom logic:Thing ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/SpatialAggregation> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/aggregationFunction" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/SpatialAggregation> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/observationResult" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/SpatialAggregation> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/observedFeature" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .
[ a <https://blackcatinformatics.ca/logic/ClosureEntry> ; <https://blackcatinformatics.ca/logic/onClass> <https://blackcatinformatics.ca/gmeow/SpatialAggregation> ; <https://blackcatinformatics.ca/logic/closureKey> "https://blackcatinformatics.ca/gmeow/vantage" ; <https://blackcatinformatics.ca/logic/closureValue> <https://blackcatinformatics.ca/logic/ClosedWorldClosure> ] .

# --- Wave B1 shape-drain: spatial-aggregation cardinality + result-type grounding ---
# gmeow:SpatialAggregationShape — exactly one vantage, one observed region, one aggregation
# function, one scalar result, and at most one minimum population.
gmeow:SpatialAggregation logic:subClassOf
    [ a logic:Restriction ; logic:onProperty gmeow:vantage ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:observedFeature ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:aggregationFunction ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:observationResult ; logic:maxQualifiedCardinality 1 ; logic:onClass logic:Thing ] ,
    [ a logic:Restriction ; logic:onProperty gmeow:minimumPopulation ; logic:maxQualifiedCardinality 1 ; logic:onDataRange xsd:nonNegativeInteger ] .

# The observationResult value is a math:Quantity (the sole quantity authority) or a
# gmeow:MonetaryAmount (domain-specific results retain their canonical carrier) — the value-class
# disjunction of the retired gmeow:SpatialAggregationShape sh:or, carried in the logic: canon (no
# single OWL antecedent reproduces a disjunctive value class on a path).
gmeow:SpatialAggregationResultTypeConstraint
    a logic:Constraint ;
    rdfs:label "Spatial aggregation result-type constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: a gmeow:SpatialAggregation yields a result that is a math:Quantity or a gmeow:MonetaryAmount."@x-gmeow-english ;
    logic:formalizes gmeow:SpatialAggregationShape ;
    logic:message "A SpatialAggregation result must be a math:Quantity or a gmeow:MonetaryAmount." ;
    logic:integrity logic:spaggForall .
logic:spaggForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] ;
    logic:forall logic:spaggImpl .
logic:spaggImpl a logic:Formula ; logic:antecedent logic:spaggGuard ; logic:consequent logic:spaggOr .
logic:spaggGuard a logic:Formula ; logic:and logic:spaggType , logic:spaggResult .
logic:spaggType a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:SpatialAggregation ] .
logic:spaggResult a logic:Formula ; logic:relation gmeow:observationResult ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "v" ] .
logic:spaggOr a logic:Formula ; logic:or logic:spaggQuantity , logic:spaggMonetary .
logic:spaggQuantity a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "v" ] , [ logic:termIndex 1 ; logic:termIri math:Quantity ] .
logic:spaggMonetary a logic:Formula ; logic:relation <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "v" ] , [ logic:termIndex 1 ; logic:termIri gmeow:MonetaryAmount ] .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects OWL FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:aggregationFunctionFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "aggregationFunction is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:aggregationFunction is functional: a spatial aggregation applies exactly one statistical function — count, sum, average, density, minimum, maximum, or centroid — so computing a different function over the same region is a different aggregation. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:aggregationFunction ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:aggregationFunction ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:aggregationFunction names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:aggregationFunction, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:aggregationFunction and nothing else. It is not a definition of gmeow:aggregationFunction (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:aggregationFunctionFunctionality logic:characterizes gmeow:aggregationFunction ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
gmeow:minimumPopulationFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/aggregation> ;
    rdfs:label "minimumPopulation is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:minimumPopulation is functional: a spatial aggregation carries exactly one k-anonymity threshold, the single minimum population size below which its result is suppressed at projection time. This record is not a definition of that term and never a shape: the obligation is reasoned from the record, not restated elsewhere."@x-gmeow-english ;
    logic:characterizes gmeow:minimumPopulation ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:minimumPopulation ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:minimumPopulation names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:minimumPopulation, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:minimumPopulation and nothing else. It is not a definition of gmeow:minimumPopulation (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:minimumPopulationFunctionality logic:characterizes gmeow:minimumPopulation ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
