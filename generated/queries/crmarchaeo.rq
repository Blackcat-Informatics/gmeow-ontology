# Projection: GMEOW → pure crmarchaeo. GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: the generic observational-activity semantics are narrowed to destructive excavation; non-excavation observational activities are filtered out; standpoint, confidence, temporal scope, and determinacy are dropped; only the physical-layer observation class survives; the feature is re-typed as a stratigraphic volume unit; non-stratigraphic features lose their original semantics; the generic GMEOW connectsTo spine is narrowed to CRMarchaeo physical relation (matrix above/below); the specific topological relation type is lost; GMEOW's frame-relative content, tuning systems, and declared losses have no LRMoo home; the notation-system reference frame and loss manifest are not part of LRMoo; performance-as-expression-creation flattens improvisation and standpoint-indexed participation claims; Music Ontology has no note-level model, no tuning frame, and a composition-first cultural bias; PON's annotation model presumes Western categories and has no tuning math; JAMS annotations are audio-time anchored, not score-anchored; vantage and theory frame are lost.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX crmarc: <http://www.cidoc-crm.org/crmarchaeo/>
PREFIX mo: <http://purl.org/ontology/mo/>
PREFIX jams: <http://w3id.org/polifonia/ontology/jams/>
PREFIX pon: <https://w3id.org/polifonia/ontology/>
PREFIX lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/>

CONSTRUCT {
    ?act a crmarc:A1_Excavation_Process_Unit .
    ?obs a crmarc:S4_Observation .
    ?feature a crmarc:A2_Stratigraphic_Volume_Unit .
    ?obs1 crmarc:AP11_has_physical_relation ?obs2 .
    ?work a lrmoo:F1_Work .
    ?expr a lrmoo:F2_Expression .
    ?perf a lrmoo:F31_Performance .
    ?work a mo:MusicalWork .
    ?work a pon:Work .
    ?claim a jams:Segment .
}
WHERE {
    {
        ?act a gmeow:ObservationalActivity .
        ?act gmeow:eventType gmeow:eventTypeExcavation .
        FILTER NOT EXISTS { ?act gmeow:displayable false . }
    }
    UNION {
        ?obs a gmeow:Observation .
        FILTER NOT EXISTS { ?obs gmeow:displayable false . }
    }
    UNION {
        ?obs a gmeow:Observation .
        ?obs gmeow:observedFeature ?feature .
        FILTER NOT EXISTS { ?obs gmeow:displayable false . }
    }
    UNION {
        ?obs1 a gmeow:Observation .
        ?obs2 a gmeow:Observation .
        ?obs1 gmeow:connectsTo ?obs2 .
        FILTER NOT EXISTS { ?obs1 gmeow:displayable false . }
        FILTER NOT EXISTS { ?obs2 gmeow:displayable false . }
    }
    UNION {
        ?work a gmeow:MusicalWork .
        FILTER NOT EXISTS { ?work gmeow:displayable false . }
    }
    UNION {
        ?expr a gmeow:Expression .
        FILTER NOT EXISTS { ?expr gmeow:displayable false . }
    }
    UNION {
        ?perf a gmeow:Event .
        ?perf gmeow:eventType gmeow:eventTypeMusicalPerformance .
        FILTER NOT EXISTS { ?perf gmeow:displayable false . }
    }
    UNION {
        ?claim a gmeow:MusicAnalysisClaim .
        ?claim gmeow:analysisProperty gmeow:analysisPropertySegment .
        FILTER NOT EXISTS { ?claim gmeow:displayable false . }
    }
}
