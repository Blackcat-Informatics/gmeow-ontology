gmeow:TableCellTableKindConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "documentary cell table scope"@x-gmeow-english ;
    skos:definition "A documentary cell belongs to a block explicitly classified as a table. The link does not classify either resource as a mathematical matrix."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency of the supplied source inventory."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this obligation executes a producer, parser, proof checker or table renderer."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact source evidence when a supplied structure violates the obligation; never repair it with invented defaults."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:TableCellTableKindConstraint logic:formalizes gmeow:cellOf ."@x-gmeow-english ;
    logic:formalizes gmeow:cellOf ;
    logic:message "A documentary cell belongs to a block explicitly classified as a table. The link does not classify either resource as a mathematical matrix." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "table" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation gmeow:cellOf ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                    [ logic:termIndex 1 ; logic:termVariable "table" ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation gmeow:segmentType ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "table" ],
                    [ logic:termIndex 1 ; logic:termIri gmeow:segmentTypeTable ] ] ] ] .

gmeow:TableCellIndexOriginConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "documentary cell index origin"@x-gmeow-english ;
    skos:definition "Each supplied cell coordinate pair has its table's explicit index origin, and neither coordinate precedes that origin. The source indices are not silently rebased."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency of the supplied source inventory."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this obligation executes a producer, parser, proof checker or table renderer."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact source evidence when a supplied structure violates the obligation; never repair it with invented defaults."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:TableCellIndexOriginConstraint logic:formalizes gmeow:cellOf ."@x-gmeow-english ;
    logic:formalizes gmeow:cellOf ;
    logic:message "Each supplied cell coordinate pair has its table's explicit index origin, and neither coordinate precedes that origin. The source indices are not silently rebased." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "table" ], [ logic:termIndex 2 ; logic:termVariable "row" ], [ logic:termIndex 3 ; logic:termVariable "column" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation gmeow:cellOf ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "table" ] ],
                [ a logic:Formula ; logic:relation gmeow:cellRow ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "row" ] ],
                [ a logic:Formula ; logic:relation gmeow:cellColumn ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "column" ] ] ] ;
            logic:consequent [ a logic:Formula ;
                logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "origin" ] ;
                logic:exists [ a logic:Formula ; logic:and
                    [ a logic:Formula ; logic:relation gmeow:tableIndexOrigin ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "table" ],
                            [ logic:termIndex 1 ; logic:termVariable "origin" ] ],
                    [ a logic:Formula ; logic:relation logic:termGreaterEqual ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "row" ],
                            [ logic:termIndex 1 ; logic:termVariable "origin" ] ],
                    [ a logic:Formula ; logic:relation logic:termGreaterEqual ;
                        logic:argument [ logic:termIndex 0 ; logic:termVariable "column" ],
                            [ logic:termIndex 1 ; logic:termVariable "origin" ] ] ] ] ] ] .

gmeow:TableCellCoordinateUniquenessConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "documentary table coordinate uniqueness"@x-gmeow-english ;
    skos:definition "Within one source table, a row and column pair identifies one documentary cell. The same coordinates in another table remain a different scope."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency of the supplied source inventory."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this obligation executes a producer, parser, proof checker or table renderer."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact source evidence when a supplied structure violates the obligation; never repair it with invented defaults."@x-gmeow-english ;
    skos:example "Retain this governing law: gmeow:TableCellCoordinateUniquenessConstraint logic:formalizes gmeow:cell ."@x-gmeow-english ;
    logic:formalizes gmeow:cell ;
    logic:message "Within one source table, a row and column pair identifies one documentary cell. The same coordinates in another table remain a different scope." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "first" ], [ logic:termIndex 2 ; logic:termVariable "second" ], [ logic:termIndex 3 ; logic:termVariable "row" ], [ logic:termIndex 4 ; logic:termVariable "column" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:and
                [ a logic:Formula ; logic:relation gmeow:cell ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "first" ] ],
                [ a logic:Formula ; logic:relation gmeow:cell ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ],
                        [ logic:termIndex 1 ; logic:termVariable "second" ] ],
                [ a logic:Formula ; logic:relation gmeow:cellRow ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "first" ],
                        [ logic:termIndex 1 ; logic:termVariable "row" ] ],
                [ a logic:Formula ; logic:relation gmeow:cellRow ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "second" ],
                        [ logic:termIndex 1 ; logic:termVariable "row" ] ],
                [ a logic:Formula ; logic:relation gmeow:cellColumn ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "first" ],
                        [ logic:termIndex 1 ; logic:termVariable "column" ] ],
                [ a logic:Formula ; logic:relation gmeow:cellColumn ;
                    logic:argument [ logic:termIndex 0 ; logic:termVariable "second" ],
                        [ logic:termIndex 1 ; logic:termVariable "column" ] ] ] ;
            logic:consequent [ a logic:Formula ; logic:relation logic:termEqual ;
                logic:argument [ logic:termIndex 0 ; logic:termVariable "first" ],
                    [ logic:termIndex 1 ; logic:termVariable "second" ] ] ] ] .

gmeow:FormalBlockKindPresentConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/reference-apparatus> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "printed formal block kind presence"@x-gmeow-english ;
    skos:definition "A block classified as formal exposition retains at least one source-attributed printed formal kind. The vocabulary remains open and the kind establishes no theorem or proof status."@x-gmeow-english ;
    gmeow:useWhen "Use to check intrinsic consistency of the supplied source inventory."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid claiming this obligation executes a producer, parser, proof checker or table renderer."@x-gmeow-english ;
    gmeow:howToUse "Retain the exact source evidence when a supplied structure violates the obligation; never repair it with invented defaults."@x-gmeow-english ;
