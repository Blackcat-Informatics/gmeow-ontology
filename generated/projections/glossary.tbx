      <termEntry id="c-d20618fc04d515f2">
        <langSet xml:lang="en">
          <tig>
            <term>A calculated record that names two distinct Clifford generators and verifies that reversing their geometric-product order negates the result.</term>
          </tig>
        </langSet>
        <langSet xml:lang="fr">
          <tig>
            <term>Un enregistrement calculé qui nomme deux générateurs distincts et vérifie que l'inversion de leur produit géométrique en change le signe.</term>
          </tig>
        </langSet>
        <langSet xml:lang="zh">
          <tig>
            <term>命名两个不同 Clifford 生成元并验证颠倒其几何乘积次序会使结果变号的计算记录。</term>
          </tig>
        </langSet>
      </termEntry>
