gmeow:sliceDependsOn gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:sliceProfile gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:sliceTier gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:tierCore gmeow:graphBoxRole gmeow:boxABox, gmeow:boxConfigBox .
gmeow:tierExtension gmeow:graphBoxRole gmeow:boxABox, gmeow:boxConfigBox .
gmeow:tierProfile gmeow:graphBoxRole gmeow:boxABox, gmeow:boxConfigBox .
gmeow:computedSliceDependency gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxTBox .
gmeow:computedProfileMembership gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:dependencyEvidence gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:dependencyStatus gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:termCoverage gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:GroundingSlice gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxTBox .
gmeow:Seam gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxTBox .
gmeow:SeamDirection gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxTBox .
gmeow:seamDirection gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:seamFromSlice gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:seamToSlice gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:seamCarryingTerm gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:seamOwningDoc gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:crossingCoverage gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxTBox .
gmeow:coveredEdgeFrom gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:coveredEdgeTo gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:coveringSeam gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:coveredTerm gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:GroundingDomain gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxTBox .
gmeow:groundingDomainOwner gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
gmeow:groundingConceptDomain gmeow:graphBoxRole gmeow:boxConfigBox, gmeow:boxRBox .
