# === PQ5 — three-state independence (marginal / conditional / not-modeled) = #

ex:cqThreeStateIndependence a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/three-state-independence.rq" ;
    gmeow:cqDataFile "tests/fixtures/independence-three-state.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Each candidate pair of facts reports its independence classification — marginal (a math:IndependenceAssertion), conditional-given (a math:ConditionalIndependenceAssertion), or the distinct third state 'not-modeled' (no assertion, surfaced by an OPTIONAL/COALESCE absence pattern) — together with the vantage holding it (gmeow:vantage) and the model it holds in (math:independenceHoldsInModel). Over the fixture the answer is exactly {(A,B) marginal, modeler, indepModel; (A,C) conditional-given, modeler, indepModel; (B,C) not-modeled (vantage/model unbound)}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqThreeStateIndependenceShape ;
    gmeow:cqExpectRow ex:rowIndepMarginal , ex:rowIndepConditional , ex:rowIndepNotModeled .

ex:cqThreeStateIndependenceShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "subject" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "other" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "classification" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ,
        [ logic:columnVariable "vantage" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingOptional ] ,
        [ logic:columnVariable "model" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingOptional ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowIndepMarginal a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "subject" ; gmeow:cellValueIri exf:eventA ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "other" ; gmeow:cellValueIri exf:eventB ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "classification" ; gmeow:cellValueLiteral "marginal" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vantage" ; gmeow:cellValueIri exf:modeler ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "model" ; gmeow:cellValueIri exf:indepModel ] .

ex:rowIndepConditional a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "subject" ; gmeow:cellValueIri exf:eventA ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "other" ; gmeow:cellValueIri exf:eventC ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "classification" ; gmeow:cellValueLiteral "conditional-given" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "vantage" ; gmeow:cellValueIri exf:modeler ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "model" ; gmeow:cellValueIri exf:indepModel ] .

ex:rowIndepNotModeled a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "subject" ; gmeow:cellValueIri exf:eventB ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "other" ; gmeow:cellValueIri exf:eventC ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "classification" ; gmeow:cellValueLiteral "not-modeled" ] .

# === PQ6 — probability model for a reasoning request + logic: lowering ===== #

ex:cqProbabilityModelLowering a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/probability-model-lowering-and-preservation.rq" ;
    gmeow:cqDataFile "tests/fixtures/probability-model-lowering.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A reasoning request declares its probability model through the LIVE A-box predicate logic:probabilityModel; the model (a math:BayesianNetwork) declares its formal logic: lowering (math:probabilityModelLowering) and preservation polarity (logic:preservationKind). Over the fixture the answer is exactly {bnQuery → sprinklerNet → logic:DependencyModel, logic:ExactPreservation}, proving the seam is live end-to-end via logic:probabilityModel." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqProbabilityModelLoweringShape ;
    gmeow:cqExpectRow ex:rowProbabilityModelLowering .

ex:cqProbabilityModelLoweringShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "request" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "model" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "logicTarget" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "preservationKind" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowProbabilityModelLowering a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "request" ; gmeow:cellValueIri exf:bnQuery ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "model" ; gmeow:cellValueIri exf:sprinklerNet ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "logicTarget" ; gmeow:cellValueIri logic:DependencyModel ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "preservationKind" ; gmeow:cellValueIri logic:ExactPreservation ] .

