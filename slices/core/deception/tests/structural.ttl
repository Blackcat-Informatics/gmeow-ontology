    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:eventTypeForgery a gmeow:EventType . }""" ;
    gmeow:saRationale "gmeow:eventTypeForgery MUST exist as a gmeow:EventType individual -- forgery is the fabrication subtype that mimics a specific genuine artifact via gmeow:counterpartOf (issue #216). Mirrors test_event_type_forgery_exists." .

