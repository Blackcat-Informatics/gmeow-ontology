#
# Declarative competency question for the events slice (crates/slicetest),
# migrated from test_competency_life_events_query. TBox subset over the
# asserted merged ontology (contains-check). The source also asserted a coarse
# len >= 25 floor the DSL has no operator for; the named life-event types are
# pinned and the loose floor is dropped (a faithful relaxation, never strengthened
# to an exact closed set). No Gap-1 universal.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/events/tests/> .

ex:cqLifeEvents a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/life-events.rq" ;
    gmeow:cqRationale "GMEOW must model life-event types as eventType VALUE individuals: birth, death, marriage, burial, census, adoption (among the full genealogical set)." ;
    gmeow:cqResultShape ex:cqLifeEventsShape ;
    gmeow:cqExpectRow ex:leBirth, ex:leDeath, ex:leMarriage, ex:leBurial, ex:leCensus, ex:leAdoption .

ex:cqLifeEventsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "eventType" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

ex:leBirth a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "eventType" ; gmeow:cellValueIri gmeow:eventTypeBirth ] .
ex:leDeath a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "eventType" ; gmeow:cellValueIri gmeow:eventTypeDeath ] .
ex:leMarriage a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "eventType" ; gmeow:cellValueIri gmeow:eventTypeMarriage ] .
ex:leBurial a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "eventType" ; gmeow:cellValueIri gmeow:eventTypeBurial ] .
ex:leCensus a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "eventType" ; gmeow:cellValueIri gmeow:eventTypeCensus ] .
ex:leAdoption a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "eventType" ; gmeow:cellValueIri gmeow:eventTypeAdoption ] .
