#
# Well-formed: a fitted model bound to its data (math:fittedToData) and its specification
# (math:modelFormula). Conforms to math:FittedModelShape and math:ModelFormulaShape.
# Bound by ex:ecFittedModelFitted.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:fit a math:FittedModel ;
    math:fittedToData ex:data ;
    math:modelFormula ex:formula .
ex:data a math:DatasetMatrix .
ex:formula a math:ModelFormula ;
    math:argumentSlot ex:slot0 .
ex:slot0 a math:ArgumentSlot ; math:slotIndex 0 ; math:slotExpression ex:respVar .
# A formula term is a FREE variable: its occurrence resolves to a declaration with a domain,
# which is what the math: expression grammar needs to scope it. Left bare it is
# math:UnscopedVariableOccurrence, and this fixture is meant to CONFORM.
ex:respVar a math:VariableExpression ; math:variableOccurrence ex:respVarOccurrence .
ex:respVarOccurrence a math:VariableOccurrence ; math:declaredVariable ex:respVarDeclaration .
ex:respVarDeclaration a math:FreeVariableDeclaration ;
    math:variableDomain ex:respVarDomain ;
    rdfs:label "the model response variable"@x-gmeow-english .
ex:respVarDomain a math:Set ;
    rdfs:label "the observed value set of the model response variable"@x-gmeow-english .
