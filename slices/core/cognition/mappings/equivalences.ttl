gmeow:eqCognition013 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:attendsTo ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q6501338 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata Q6501338 'attention' — entity-page verified 2026-06-18. Issue-supplied Q327954 resolved to 'torch' and was rejected." ;
    gmeow:sssomFile "gmeow-cognition.sssom.tsv" .

