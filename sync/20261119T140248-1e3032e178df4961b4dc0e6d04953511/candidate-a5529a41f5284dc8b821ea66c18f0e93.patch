+            Self::Inconclusive { reason } => Some(("NON_ENTAILMENT_NOT_DISCHARGED", reason)),
+            Self::Invalid { detail } => Some(("NON_ENTAILMENT_INVALID_DECLARATION", detail)),
+        }
+    }
