msgctxt "https://blackcatinformatics.ca/gmeow/bodyCause|http://www.w3.org/2000/01/rdf-schema#label"
msgid "body cause"
msgstr "cause d’arrêt du corps"

msgctxt "https://blackcatinformatics.ca/gmeow/bodyCause|http://www.w3.org/2004/02/skos/core#definition"
msgid "The runtime's exact source wording for why an attempt body stopped. It remains independent of the controlled attemptStop code, intention lifecycle and goal verdict."
msgstr "Formulation source exacte de l’environnement d’exécution expliquant l’arrêt du corps d’une tentative. Elle reste indépendante du code attemptStop, du cycle de l’intention et du verdict de but."

msgctxt "https://blackcatinformatics.ca/gmeow/bodyCause|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use when the source explicitly supplies this relation and its context."
msgstr "Utiliser lorsque la source fournit explicitement cette relation et son contexte."

msgctxt "https://blackcatinformatics.ca/gmeow/bodyCause|https://blackcatinformatics.ca/gmeow/avoidWhen"
msgid "Avoid inventing missing source bindings or inferring execution and success from this record alone."
msgstr "Éviter d’inventer des liens source absents ou de déduire exécution et réussite de ce seul enregistrement."

msgctxt "https://blackcatinformatics.ca/gmeow/bodyCause|https://blackcatinformatics.ca/gmeow/howToUse"
msgid "Retain actual source values, identities and attribution; preserve supplied wording, language and direction."
msgstr "Conserver valeurs, identités et attribution réelles de la source ; préserver formulation, langue et direction fournies."

msgctxt "https://blackcatinformatics.ca/gmeow/bodyCause|http://www.w3.org/2004/02/skos/core#scopeNote"
