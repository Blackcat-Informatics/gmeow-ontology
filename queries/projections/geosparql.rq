# Projection: GMEOW → pure geosparql. GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: precise WKT geometry coarsened to the enclosing region at gmeow:coarsenTo level (privacy generalization, P10); precise coordinates coarsened to the enclosing region at gmeow:coarsenTo level (privacy generalization, P10); orientation component dropped; GeoSPARQL 1.0/1.1 has no pose model; precise GeoJSON geometry coarsened to the enclosing region at gmeow:coarsenTo level (privacy generalization, P10); trajectory samples (LocationStates), temporal scope, reference frame, and interpolation method are dropped in pure GeoSPARQL; only the feature identity is retained. The sample geometries project separately via mapGeoPosePositionToWktPoint..
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>

CONSTRUCT {
    ?place a geo:Feature .
    ?place geo:hasGeometry ?g .
    ?g a geo:Geometry .
    ?g geo:asWKT ?wktTagged .
    ?place geo:hasGeometry ?coarseGeom .
    ?coarseGeom a geo:Geometry .
    ?coarseGeom geo:asWKT ?wktTagged .
    ?place geo:hasGeometry ?ptGeom .
    ?ptGeom a geo:Geometry .
    ?ptGeom geo:asWKT ?pointWkt .
    ?entity geo:hasGeometry ?ptGeom .
    ?place geo:sfWithin ?parent .
    ?parent geo:sfContains ?place .
    ?g geo:asGeoJSON ?gjTagged .
    ?coarseGeom geo:asGeoJSON ?gjTagged .
    ?traj a geo:Feature .
}
WHERE {
    {
        ?place a gmeow:Place .
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:hasGeometry ?g .
        ?g gmeow:asWKT ?wkt .
        BIND ( STRDT(STR(?wkt), geo:wktLiteral) AS ?wktTagged )
        FILTER NOT EXISTS { ?place gmeow:coarsenTo ?anyLvl . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:coarsenTo ?lvl .
        ?place gmeow:containedInPlace+ ?coarse .
        ?coarse gmeow:hasGranularity ?lvl .
        ?coarse gmeow:hasGeometry ?sourceGeom .
        ?sourceGeom gmeow:asWKT ?wkt .
        BIND ( IRI(CONCAT(STR(?place), "-geom-coarsened-wkt")) AS ?coarseGeom )
        BIND ( STRDT(STR(?wkt), geo:wktLiteral) AS ?wktTagged )
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:hasCoordinates ?c .
        ?c gmeow:latitude ?lat .
        ?c gmeow:longitude ?lon .
        BIND ( IRI(CONCAT(STR(?place), "-geom")) AS ?ptGeom )
        BIND ( STRDT(CONCAT("POINT(", STR(?lon), " ", STR(?lat), ")"), geo:wktLiteral) AS ?pointWkt )
        FILTER NOT EXISTS { ?place gmeow:coarsenTo ?anyLvl . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:coarsenTo ?lvl .
        ?place gmeow:containedInPlace+ ?coarse .
        ?coarse gmeow:hasGranularity ?lvl .
        ?coarse gmeow:hasCoordinates ?c .
        ?c gmeow:latitude ?lat .
        ?c gmeow:longitude ?lon .
        BIND ( IRI(CONCAT(STR(?place), "-geom-coarsened")) AS ?ptGeom )
        BIND ( STRDT(CONCAT("POINT(", STR(?lon), " ", STR(?lat), ")"), geo:wktLiteral) AS ?pointWkt )
    }
    UNION {
        ?entity gmeow:hasPose ?pose .
        ?pose gmeow:hasPosePosition ?c .
        ?c gmeow:latitude ?lat .
        ?c gmeow:longitude ?lon .
        BIND ( IRI(CONCAT(STR(?entity), "-pose-geom")) AS ?ptGeom )
        BIND ( STRDT(CONCAT("POINT(", STR(?lon), " ", STR(?lat), ")"), geo:wktLiteral) AS ?pointWkt )
        FILTER NOT EXISTS { ?entity gmeow:coarsenTo ?anyLvl . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:containedInPlace ?parent .
    }
    UNION {
        ?parent a gmeow:Place .
        ?parent gmeow:containsPlace ?place .
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:hasGeometry ?g .
        ?g gmeow:asGeoJSON ?gj .
        BIND ( STRDT(STR(?gj), geo:geoJSONLiteral) AS ?gjTagged )
        FILTER NOT EXISTS { ?place gmeow:coarsenTo ?anyLvl . }
    }
    UNION {
        ?place a gmeow:Place .
        ?place gmeow:coarsenTo ?lvl .
        ?place gmeow:containedInPlace+ ?coarse .
        ?coarse gmeow:hasGranularity ?lvl .
        ?coarse gmeow:hasGeometry ?sourceGeom .
        ?sourceGeom gmeow:asGeoJSON ?gj .
        BIND ( IRI(CONCAT(STR(?place), "-geom-coarsened-geojson")) AS ?coarseGeom )
        BIND ( STRDT(STR(?gj), geo:geoJSONLiteral) AS ?gjTagged )
    }
    UNION {
        ?traj a gmeow:Trajectory .
    }
}
