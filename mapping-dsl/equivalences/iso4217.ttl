@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv:  <https://w3id.org/semapv/vocab/> .

# Term equivalences for ISO 4217 currency codes — GMEOW authoring source.
# Compiled to mappings/gmeow-iso4217.sssom.tsv by `gmeow compile-mappings`.
# Each GMEOW currency ReferenceFrame individual is aligned to the FIBO
# ISO4217-CurrencyCodes module (the authoritative RDF representation of ISO 4217).

@prefix fibo-iso4217: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/ISO4217-CurrencyCodes/> .

gmeow:mapsetIso4217 a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-iso4217.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/iso4217" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "ISO 4217 currency code alignments. GMEOW currency ReferenceFrame individuals align to FIBO ISO4217-CurrencyCodes currency individuals." .

gmeow:eqIso4217001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:referenceFrameUSD ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject fibo-iso4217:USD ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "US Dollar" ;
    gmeow:sssomFile "gmeow-iso4217.sssom.tsv" .

gmeow:eqIso4217002 a gmeow:TermEquivalence ;
