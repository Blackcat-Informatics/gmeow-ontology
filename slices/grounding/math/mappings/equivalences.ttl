# --- Calculus binders → OpenMath content dictionaries ---------------------- #
#
# The binder operators lower to OpenMath CD symbols (align, don't spine —
# Principle 17). Full IRIs to the CD pages (calculus1, arith1) — all curl-
# validated HTTP 200; the OpenMath tensor1 CD 404s, so tensor fields align to
# Wikidata (above) rather than a dead OpenMath link.

gmeow:eqMathDiffBinderOm a gmeow:TermEquivalence ;
    gmeow:alignSubject math:differentiationBinder ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject <https://openmath.org/cd/calculus1.xhtml> ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:objectLabel "OpenMath calculus1#diff" ;
    gmeow:comment "math:differentiationBinder aligns to the diff symbol of the OpenMath calculus1 content dictionary. closeMatch, full IRI by reference to the CD page (curl-validated HTTP 200)." ;
    gmeow:sssomFile "gmeow-openmath.sssom.tsv" .

