@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix fno:     <https://w3id.org/function/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema:  <https://schema.org/> .

# FnO catalog of LANGUAGE TRANSFORMATIONS — transliteration, transcription and
# translation modelled as declarative functions. Unlike functions.fno.ttl (which
# describes GMEOW→external PROJECTION transforms), these are DOMAIN conversions:
# each names a system (Hepburn, Pinyin, ISO 233, IPA, …) and links it to the
# gmeow:TransliterationScheme value individual it realises, so a gmeow:romanization
# can record HOW it was derived (names module: gmeow:transliterationScheme). A
# consumable spec — NOT imported into the ontology and never reasoned over; the
# executable HOW (a real transliterator) is out of scope, intentionally pluggable.

<https://blackcatinformatics.ca/gmeow/mapping-dsl/transforms>
    a owl:Ontology ;
    rdfs:label "GMEOW language transformation functions (FnO)"@x-gmeow-english ;
    skos:definition "Hand-authored FnO catalog of language transformations — transliteration, transcription and translation as declarative functions, each realising a gmeow:TransliterationScheme value individual. A consumable spec layer beside the mapping DSL; never reasoned."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# --- Transliteration (script → script; reversible by design) ---------------- #

gmeow:fnRomanizeHepburn
    a fno:Function ;
    rdfs:label "Hepburn romanization (Japanese kana/kanji → Latin)"@x-gmeow-english ;
    dcterms:description "Transliterates Japanese (kana, with kanji readings) to the Latin script per the Hepburn system (山田太郎 → \"Yamada Tarō\"). Realises gmeow:schemeHepburn. Reversible for kana; lossy for kanji (requires readings)."@x-gmeow-english ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeHepburn .

gmeow:fnRomanizeKunrei
    a fno:Function ;
    rdfs:label "Kunrei-shiki romanization (Japanese → Latin)"@x-gmeow-english ;
    dcterms:description "Transliterates Japanese kana to Latin per the ISO 3602 Kunrei-shiki system (a systematic alternative to Hepburn). Realises gmeow:schemeKunreiShiki. Reversible."@x-gmeow-english ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeKunreiShiki .

gmeow:fnRomanizePinyin
    a fno:Function ;
    rdfs:label "Hanyu Pinyin romanization (Mandarin → Latin)"@x-gmeow-english ;
    dcterms:description "Transliterates Mandarin Chinese to the Latin script with tone marks per Hanyu Pinyin (北京 → \"Běijīng\"). Realises gmeow:schemePinyin. Lossy without readings; tone-mark variants exist."@x-gmeow-english ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemePinyin .

gmeow:fnRomanizeWadeGiles
    a fno:Function ;
    rdfs:label "Wade-Giles romanization (Mandarin → Latin)"@x-gmeow-english ;
    dcterms:description "Transliterates Mandarin to Latin per the older Wade-Giles system (北京 → \"Pei-ching\"). Realises gmeow:schemeWadeGiles."@x-gmeow-english ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeWadeGiles .

gmeow:fnRomanizeRevisedRomanization
    a fno:Function ;
    rdfs:label "Revised Romanization (Korean → Latin)"@x-gmeow-english ;
    dcterms:description "Transliterates Korean Hangul to Latin per the Revised Romanization of Korean (서울 → \"Seoul\"). Realises gmeow:schemeRevisedRomanization."@x-gmeow-english ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeRevisedRomanization .

gmeow:fnTransliterateISO233
    a fno:Function ;
    rdfs:label "ISO 233 transliteration (Arabic → Latin)"@x-gmeow-english ;
    dcterms:description "Transliterates Arabic script to Latin per ISO 233. Realises gmeow:schemeISO233. Reversible (character-level)."@x-gmeow-english ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeISO233 .

gmeow:fnTransliterateISO15919
    a fno:Function ;
    rdfs:label "ISO 15919 transliteration (Indic → Latin)"@x-gmeow-english ;
    dcterms:description "Transliterates Brahmic/Indic scripts to Latin per ISO 15919. Realises gmeow:schemeISO15919. Reversible."@x-gmeow-english ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTransliterated ) ;
    rdfs:seeAlso gmeow:schemeISO15919 .

# --- Transcription (→ phonetic representation; not reversible) --------------- #

gmeow:fnTranscribeIPA
    a fno:Function ;
    rdfs:label "IPA phonetic transcription"@x-gmeow-english ;
    dcterms:description "Transcribes spoken/written language to the International Phonetic Alphabet — a phonetic representation, not a script transliteration (\"Yamada\" → /jamada/). Realises gmeow:schemeIPA. NOT reversible (phonetic, language-specific)."@x-gmeow-english ;
    fno:expects ( gmeow:pSourceText ) ;
    fno:returns ( gmeow:oTranscribed ) ;
    rdfs:seeAlso gmeow:schemeIPA .

# --- Translation (language → language; meaning-preserving, lossy) ------------ #

gmeow:fnTranslate
    a fno:Function ;
    rdfs:label "translate (language → language)"@x-gmeow-english ;
    dcterms:description "Translates an expression from a source language to a target language, preserving meaning rather than form. A translation relates two CO-EQUAL expressions (neither subordinate); it is not a transliteration and never a name-of-a-person operation. Lossy and context-dependent; the source and target languages are gmeow:Language inputs."@x-gmeow-english ;
    fno:expects ( gmeow:pSourceText gmeow:pTargetLanguage ) ;
    fno:returns ( gmeow:oTranslated ) ;
    rdfs:seeAlso <https://www.wikidata.org/entity/Q7553> .

# --- Shared parameters / outputs (declarative; no bound executor) ----------- #

gmeow:pSourceText      a fno:Parameter ; fno:predicate gmeow:fullName ; fno:type rdfs:Literal ; fno:required true ;
    rdfs:label "source text"@x-gmeow-english ;
    skos:definition "The input literal to a language transformation — the text to transliterate, transcribe, or translate."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:pTargetLanguage  a fno:Parameter ; fno:predicate gmeow:targetLanguage ; fno:type gmeow:Language ; fno:required true ;
    rdfs:label "target language"@x-gmeow-english ;
    skos:definition "The first-class gmeow:Language the transformation targets."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:oTransliterated  a fno:Output ; fno:predicate gmeow:romanization ; fno:type rdfs:Literal ;
    rdfs:label "transliterated output"@x-gmeow-english ;
    skos:definition "The transliterated literal produced by a romanization/transliteration function; recorded as a gmeow:romanization."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:oTranscribed     a fno:Output ; fno:predicate gmeow:projectedTranscription ; fno:type rdfs:Literal ;
    rdfs:label "transcribed output"@x-gmeow-english ;
    skos:definition "The phonetic transcription literal produced by a transcription function (e.g. IPA)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:oTranslated      a fno:Output ; fno:predicate gmeow:projectedTranslation ; fno:type rdfs:Literal ;
    rdfs:label "translated output"@x-gmeow-english ;
    skos:definition "The translated literal produced by a translation function."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

# --- Projection-domain transforms (issue #263) ----------------------------- #

gmeow:fnSkillProficiencyToKnowsAbout
    a fno:Function ;
    rdfs:label "SkillProficiency → schema:knowsAbout/skills (lossy flatten)"@x-gmeow-english ;
    dcterms:description "Projects a reified gmeow:SkillProficiency relator to a flat schema:knowsAbout or schema:skills edge. Lossy: level, scale, interval, standpoint, and confidence are dropped."@x-gmeow-english ;
    fno:expects ( gmeow:pSkillProficiency ) ;
    fno:returns ( gmeow:oKnowsAbout ) ;
    rdfs:seeAlso gmeow:hasSkill .

gmeow:pSkillProficiency a fno:Parameter ; fno:predicate gmeow:hasSkill ; fno:type gmeow:Skill ; fno:required true ;
    rdfs:label "skill proficiency input"@x-gmeow-english ;
    skos:definition "The gmeow:Skill borne by a SkillProficiency, input to the knowsAbout projection."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:oKnowsAbout       a fno:Output ;     fno:predicate schema:knowsAbout ;     fno:type gmeow:Skill ;
    rdfs:label "knowsAbout output"@x-gmeow-english ;
    skos:definition "The schema:knowsAbout value emitted for a skill proficiency by the projection."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

# --- Music / pitch solver (issue #308) -------------------------------------- #
# Declarative function catalogue for the pitch frame layer.  These are specs;
# executable implementations (Python/Rust/Go solvers) are issue #319.

gmeow:fnRatioToCents
    a fno:Function ;
    rdfs:label "ratio → cents"@x-gmeow-english ;
    dcterms:description "Converts an exact integer-ratio interval to cents: 1200·log₂(numerator/denominator). The canonical value remains the ratio pair; cents is a lossy projection."@x-gmeow-english ;
    skos:definition "Converts an exact integer-ratio interval to cents: 1200·log₂(numerator/denominator). The canonical value remains the ratio pair; cents is a lossy projection."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    fno:expects ( gmeow:pRatioNumerator gmeow:pRatioDenominator ) ;
    fno:returns ( gmeow:oCents ) ;
    rdfs:seeAlso gmeow:centsFromOrigin .

gmeow:fnPitchToFrequency
    a fno:Function ;
    rdfs:label "pitch value + anchor → frequency (Hz)"@x-gmeow-english ;
    dcterms:description "Maps a frame-relative PitchValue to a physical frequency in Hz using a PitchAnchor. Hz is never asserted directly on a PitchValue; it is always reached through this solver (Principle 11)."@x-gmeow-english ;
    skos:definition "Maps a frame-relative PitchValue to a physical frequency in Hz using a PitchAnchor. Hz is never asserted directly on a PitchValue; it is always reached through this solver (Principle 11)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    fno:expects ( gmeow:pPitchValue gmeow:pPitchAnchor ) ;
    fno:returns ( gmeow:oFrequency ) ;
    rdfs:seeAlso gmeow:PitchAnchor .

gmeow:fnConvertTuning
    a fno:Function ;
    rdfs:label "convert pitch value to another tuning system"@x-gmeow-english ;
    dcterms:description "Projects a PitchValue expressed in one TuningSystem into another TuningSystem, returning a new PitchValue (possibly approximate). Notation letters are projections, not inputs."@x-gmeow-english ;
    skos:definition "Projects a PitchValue expressed in one TuningSystem into another TuningSystem, returning a new PitchValue (possibly approximate). Notation letters are projections, not inputs."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    fno:expects ( gmeow:pPitchValue gmeow:pTuningSystemTarget ) ;
    fno:returns ( gmeow:oPitchValue ) ;
    rdfs:seeAlso gmeow:hasTuningFrame .

gmeow:fnSpectrumToPitchCollection
    a fno:Function ;
    rdfs:label "spectrum → pitch collection"@x-gmeow-english ;
    dcterms:description "Derives a PitchCollection from a Spectrum via peak detection / fundamental estimation. The output is a standpoint-indexed projection of the spectral content (Principle 12)."@x-gmeow-english ;
    skos:definition "Derives a PitchCollection from a Spectrum via peak detection / fundamental estimation. The output is a standpoint-indexed projection of the spectral content (Principle 12)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> ;
    fno:expects ( gmeow:pSpectrum ) ;
    fno:returns ( gmeow:oPitchCollection ) ;
    rdfs:seeAlso gmeow:derivedFromSpectrum .

# Parameters / outputs (declarative; no bound executor)

gmeow:pRatioNumerator   a fno:Parameter ; fno:predicate gmeow:ratioNumerator ;   fno:type xsd:integer ;  fno:required true ;
    rdfs:label "ratio numerator input"@x-gmeow-english ;
    skos:definition "The numerator of the ratio supplied to a pitch solver function."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:pRatioDenominator a fno:Parameter ; fno:predicate gmeow:ratioDenominator ; fno:type xsd:integer ;  fno:required true ;
    rdfs:label "ratio denominator input"@x-gmeow-english ;
    skos:definition "The denominator of the ratio supplied to a pitch solver function."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:pPitchValue       a fno:Parameter ; fno:predicate gmeow:fnInputPitchValue ;       fno:type gmeow:PitchValue ;      fno:required true ;
    rdfs:label "pitch value input"@x-gmeow-english ;
    skos:definition "A frame-relative pitch value supplied to a pitch solver function."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:pPitchAnchor      a fno:Parameter ; fno:predicate gmeow:fnInputPitchAnchor ;      fno:type gmeow:PitchAnchor ;     fno:required true ;
    rdfs:label "pitch anchor input"@x-gmeow-english ;
    skos:definition "A PitchAnchor that supplies the tuning-system degree and frequency for a pitch-to-frequency conversion."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:pTuningSystemTarget a fno:Parameter ; fno:predicate gmeow:fnInputTuningSystem ;   fno:type gmeow:TuningSystem ;    fno:required true ;
    rdfs:label "target tuning system input"@x-gmeow-english ;
    skos:definition "The TuningSystem that a pitch value should be projected into."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:pSpectrum         a fno:Parameter ; fno:predicate gmeow:fnInputSpectrum ;         fno:type gmeow:Spectrum ;        fno:required true ;
    rdfs:label "spectrum input"@x-gmeow-english ;
    skos:definition "A Spectrum supplied to a spectral-to-pitch derivation function."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

gmeow:oCents            a fno:Output ; fno:predicate gmeow:fnOutputCents ;          fno:type xsd:decimal ;
    rdfs:label "cents output"@x-gmeow-english ;
    skos:definition "A logarithmic interval size in cents, produced by fnRatioToCents."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:oFrequency        a fno:Output ; fno:predicate gmeow:fnOutputFrequency ;      fno:type xsd:decimal ;
    rdfs:label "frequency output (Hz)"@x-gmeow-english ;
    skos:definition "A physical frequency in hertz, produced by fnPitchToFrequency."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:oPitchValue       a fno:Output ; fno:predicate gmeow:fnOutputPitchValue ;     fno:type gmeow:PitchValue ;
    rdfs:label "pitch value output"@x-gmeow-english ;
    skos:definition "A PitchValue produced by a conversion or derivation function."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:oPitchCollection  a fno:Output ; fno:predicate gmeow:fnOutputPitchCollection ; fno:type gmeow:PitchCollection ;
    rdfs:label "pitch collection output"@x-gmeow-english ;
    skos:definition "A PitchCollection produced by fnSpectrumToPitchCollection."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .

# Declarative argument-role properties for the music functions.

gmeow:fnInputPitchValue        a owl:AnnotationProperty ;
    rdfs:label "input pitch value"@x-gmeow-english ;
    skos:definition "FnO argument role: a pitch value input to a music solver function."@x-gmeow-english ;
    rdfs:range gmeow:PitchValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:fnInputPitchAnchor       a owl:AnnotationProperty ;
    rdfs:label "input pitch anchor"@x-gmeow-english ;
    skos:definition "FnO argument role: a pitch anchor input to a music solver function."@x-gmeow-english ;
    rdfs:range gmeow:PitchAnchor ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:fnInputTuningSystem      a owl:AnnotationProperty ;
    rdfs:label "input tuning system"@x-gmeow-english ;
    skos:definition "FnO argument role: a tuning system input to a music solver function."@x-gmeow-english ;
    rdfs:range gmeow:TuningSystem ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:fnInputSpectrum          a owl:AnnotationProperty ;
    rdfs:label "input spectrum"@x-gmeow-english ;
    skos:definition "FnO argument role: a spectrum input to a music solver function."@x-gmeow-english ;
    rdfs:range gmeow:Spectrum ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:fnOutputCents            a owl:AnnotationProperty ;
    rdfs:label "output cents"@x-gmeow-english ;
    skos:definition "FnO argument role: a cents output of a music solver function."@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:fnOutputFrequency        a owl:AnnotationProperty ;
    rdfs:label "output frequency"@x-gmeow-english ;
    skos:definition "FnO argument role: a frequency output of a music solver function."@x-gmeow-english ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:fnOutputPitchValue       a owl:AnnotationProperty ;
    rdfs:label "output pitch value"@x-gmeow-english ;
    skos:definition "FnO argument role: a pitch value output of a music solver function."@x-gmeow-english ;
    rdfs:range gmeow:PitchValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
gmeow:fnOutputPitchCollection  a owl:AnnotationProperty ;
    rdfs:label "output pitch collection"@x-gmeow-english ;
    skos:definition "FnO argument role: a pitch collection output of a music solver function."@x-gmeow-english ;
    rdfs:range gmeow:PitchCollection ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/mapping-dsl> .
