        sh:severity sh:Violation ;
        sh:message "A NarrativeTimeFrame must declare exactly one gmeow:narrativeTimeAxis (discourse time or story time) — a work and its fabula are two frames, not one frame with two moods." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/narrativeTimeAxis> ?v0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/NoPreferredClaimConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/NoPreferredClaimShape> ;
    sh:target [ a sh:SPARQLTarget ; sh:select """SELECT ?this WHERE { ?this ?p ?o . FILTER ( STRSTARTS(STR(?p), 'https://blackcatinformatics.ca/gmeow/primary') || STRSTARTS(STR(?p), 'https://blackcatinformatics.ca/gmeow/preferred') ) }""" ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "No claim may be marked preferred/primary; standpoint-indexed claims are co-equal — there is no single slot to win (Principle 9)." ;
        sh:select """SELECT $this WHERE { $this ?p ?o . FILTER ( ( STRSTARTS(STR(?p), 'https://blackcatinformatics.ca/gmeow/primary') ) || ( STRSTARTS(STR(?p), 'https://blackcatinformatics.ca/gmeow/preferred') ) ) }""" ;
    ] .

