        sh:message "A discourse-time frame anchors via gmeow:discourseTimeOf and a story-time frame via gmeow:storyTimeOf — never the other anchor." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/narrativeTimeAxis> <https://blackcatinformatics.ca/gmeow/axisDiscourseTime> . $this <https://blackcatinformatics.ca/gmeow/storyTimeOf> ?x . }""" ;
    ] .

