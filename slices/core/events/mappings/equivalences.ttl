# --------------------------------------------------------------------------- #
# Duration + recurrence — TIMEX3 DURATION / SET, OWL-Time Duration, schema.org,
# TEO. Tense/aspect (ISO-TimeML EVENT attributes) have no RDF target and are
# documented below as a value correspondence, not aligned by IRI.
# --------------------------------------------------------------------------- #

gmeow:eqEvents118 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Duration ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject time:Duration ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OWL-Time Duration (a length of time)" ;
    gmeow:sssomFile "gmeow-events.sssom.tsv" .

gmeow:eqEvents119 a gmeow:TermEquivalence ;
