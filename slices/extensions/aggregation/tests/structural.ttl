#
# Declarative structural assertions for the aggregation slice (#101) — the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_aggregation.py. Each assertion runs as a
# SPARQL ASK over the aggregation module graph (gmeow:scopeModule) under the
# native Rust harness (crates/slicetest).
#
# Aggregation is NOT yet #694-migrated, so class stereotypes remain gufo:
# (gufo:AbstractIndividualType, gufo:SubKind, gufo:QualityValue), not logic:.
#
# RETAINED in pytest (cross-slice subject):
#   test_contains_place_exists_and_is_inverse — gmeow:containsPlace and
#   gmeow:containedInPlace are defined in slices/core/places/module.ttl, not
#   here; a scopeModule cell would silently miss them.
#
# See dsl/tests/MIGRATION-LEDGER.md for the per-test pytest→DSL mapping.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/aggregation/tests/> .

# --- 1. SpatialAggregation is a subclass of Measurement (MUST) ---------------
ex:saSpatialAggregationIsMeasurement a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SpatialAggregation a owl:Class , gufo:SubKind ;
        rdfs:subClassOf gmeow:Measurement .
}""" ;
    gmeow:saRationale "gmeow:SpatialAggregation MUST be an owl:Class typed gufo:SubKind and a subclass of gmeow:Measurement — every aggregation reuses the universal observation stack without duplication (Principle 4, #101). Mirrors test_spatial_aggregation_is_measurement." .

# --- 2. SpatialBin is a subclass of Place (MUST) -----------------------------
ex:saSpatialBinIsPlace a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:SpatialBin a owl:Class , gufo:SubKind ;
        rdfs:subClassOf gmeow:Place .
}""" ;
    gmeow:saRationale "gmeow:SpatialBin MUST be an owl:Class typed gufo:SubKind and a subclass of gmeow:Place — bins are places that partition space for statistical summarisation (#101). Mirrors test_spatial_bin_is_place." .

# --- 3a. AggregationFunction is a value-vocabulary subclass of QualityValue (MUST) ---
ex:saAggregationFunctionIsValueVocab a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX gufo: <http://purl.org/nemo/gufo#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:AggregationFunction a owl:Class , gufo:AbstractIndividualType ;
        rdfs:subClassOf gufo:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:AggregationFunction MUST be an owl:Class typed gufo:AbstractIndividualType and a subclass of gufo:QualityValue — the aggregation kinds are an individuals-based value vocabulary, never subclasses (Principle 9, #101). Mirrors test_aggregation_function_is_value_not_subclass (positive half)." .

# --- 3b. The seven AggregationFunction seeds exist as individuals (MUST) -----
ex:saAggregationFunctionSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:aggCount   a gmeow:AggregationFunction .
    gmeow:aggSum     a gmeow:AggregationFunction .
    gmeow:aggAverage a gmeow:AggregationFunction .
    gmeow:aggDensity a gmeow:AggregationFunction .
    gmeow:aggCentroid a gmeow:AggregationFunction .
    gmeow:aggMinimum a gmeow:AggregationFunction .
    gmeow:aggMaximum a gmeow:AggregationFunction .
}""" ;
    gmeow:saRationale "All seven AggregationFunction seed individuals MUST exist — they are the closed enumeration of supported aggregation operations (#101). Mirrors test_aggregation_function_is_value_not_subclass (individual-existence half)." .

# --- 3c. No per-function subclasses exist (MUST-NOT) -------------------------
ex:saNoPerFunctionSubclasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?rejected { gmeow:CountAggregation gmeow:DensityAggregation gmeow:CentroidAggregation }
    ?rejected a owl:Class .
}""" ;
    gmeow:saRationale "Per-function subclasses (CountAggregation, DensityAggregation, CentroidAggregation) MUST NOT exist — aggregation kinds are individuals of AggregationFunction, never subclasses (Principle 9). Mirrors test_aggregation_function_is_value_not_subclass (rejected-subclass half)." .

# --- 4. aggregationFunction property is functional (MUST) --------------------
ex:saAggregationFunctionPropertyFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:aggregationFunction a owl:ObjectProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:SpatialAggregation ;
        rdfs:range gmeow:AggregationFunction .
}""" ;
    gmeow:saRationale "gmeow:aggregationFunction MUST be an owl:ObjectProperty and owl:FunctionalProperty with domain SpatialAggregation and range AggregationFunction — each aggregation uses exactly one statistical function (#101). Mirrors test_aggregation_function_property_is_functional." .

# --- 5a. hasBin is an object property (MUST) ---------------------------------
ex:saHasBinIsObjectProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasBin a owl:ObjectProperty ;
        rdfs:domain gmeow:SpatialAggregation ;
        rdfs:range gmeow:SpatialBin .
}""" ;
    gmeow:saRationale "gmeow:hasBin MUST be an owl:ObjectProperty with domain SpatialAggregation and range SpatialBin — links an aggregation to its constituent spatial bins (#101). Mirrors test_has_bin_is_non_functional (positive half)." .

# --- 5b. hasBin is NOT functional (MUST-NOT) ---------------------------------
ex:saHasBinNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasBin a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:hasBin MUST NOT be functional — a spatial aggregation spans multiple bins (#101). Mirrors test_has_bin_is_non_functional (negative half)." .

# --- 6. minimumPopulation datatype property shape (MUST) ---------------------
ex:saMinimumPopulationProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
ASK {
    gmeow:minimumPopulation a owl:DatatypeProperty , owl:FunctionalProperty ;
        rdfs:domain gmeow:SpatialAggregation ;
        rdfs:range xsd:nonNegativeInteger .
}""" ;
    gmeow:saRationale "gmeow:minimumPopulation MUST be an owl:DatatypeProperty and owl:FunctionalProperty with domain SpatialAggregation and range xsd:nonNegativeInteger — it carries the k-anonymity threshold (Principle 10, #101). Mirrors test_minimum_population_is_datatype." .

# --- 7a. aggregationFunction carries no property chain axiom (MUST-NOT) ------
ex:saAggregationFunctionNoChain a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:aggregationFunction owl:propertyChainAxiom ?chain . }""" ;
    gmeow:saRationale "gmeow:aggregationFunction MUST NOT carry a property chain axiom — aggregation computation stays in the solver layer (Principle 12). Mirrors test_no_unsafe_complex_property_chains (aggregationFunction half)." .

# --- 7b. hasBin carries no property chain axiom (MUST-NOT) ------------------
ex:saHasBinNoChain a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasBin owl:propertyChainAxiom ?chain . }""" ;
    gmeow:saRationale "gmeow:hasBin MUST NOT carry a property chain axiom — aggregation computation stays in the solver layer (Principle 12). Mirrors test_no_unsafe_complex_property_chains (hasBin half)." .
