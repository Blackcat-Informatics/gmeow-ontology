import json

from gmeow_models.accessibility import AccessibilityAssertion

# The same worked instance shown in the Turtle / JSON-LD tabs, validated
# against the ontology-derived model:
payload = json.loads("{\n  \"@context\": {},\n  \"@graph\": [\n    {\n      \"@id\": \"https://blackcatinformatics.ca/gmeow/example/subject\",\n      \"@type\": [\n        {\n          \"@id\": \"https://blackcatinformatics.ca/gmeow/AccessibilityAssertion\"\n        }\n      ],\n      \"https://blackcatinformatics.ca/gmeow/assertionFacet\": {\n        \"@id\": \"https://blackcatinformatics.ca/gmeow/example/...\"\n      },\n      \"https://blackcatinformatics.ca/gmeow/assertionPolarity\": {\n        \"@id\": \"https://blackcatinformatics.ca/gmeow/example/...\"\n      },\n      \"https://blackcatinformatics.ca/gmeow/assertionSubject\": {\n        \"@id\": \"https://blackcatinformatics.ca/gmeow/example/...\"\n      }\n    }\n  ]\n}")
obj = AccessibilityAssertion.model_validate(payload)
print(obj.model_dump(by_alias=True, exclude_none=True))
