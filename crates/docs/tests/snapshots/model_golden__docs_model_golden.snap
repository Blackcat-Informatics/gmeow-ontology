  "sample_competency": {
    "iri": "https://blackcatinformatics.ca/gmeow/examples/affect/tests/cqCompositeDecomposition",
    "rationale": "A named emotion is modeled UP, not minted: schadenfreude decomposes into a positive core-affect vector over another agent's misfortune with an other-directed agency structure. The query projects the per-axis readings that decompose the composite — answering 'is this schadenfreude a positive vector over another's misfortune?' directly from the data (positive valence AND other-directed negative agency).",
    "query_file": "slices/core/affect/queries/competency/composite-decomposition.rq",
    "query_text": "# Competency question 9: \"Which axis-vector and relations decompose a given named\n# emotion — is this 'schadenfreude' a positive vector over another's misfortune?\"\n# The composite's declared constituents are its core-affect vector cells (valence,\n# arousal) plus its differentiating appraisal relations (agency other-directed,\n# norm deserved). Modeling up, not minting: the decomposing axes are queryable.\n\nPREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>\n\nSELECT DISTINCT ?dimension WHERE {\n    gmeow:schadenfreudeComposite gmeow:affectiveConstituent ?constituent .\n    {\n        ?constituent gmeow:appraisalDimension ?dimension .\n    }\n    UNION\n    {\n        ?constituent gmeow:vectorComponent ?cell .\n        ?cell gmeow:appraisalDimension ?dimension .\n    }\n}\nORDER BY ?dimension\n",
    "exact_rows": null,
    "expected_row_count": null,
    "expected_rows": [
      {
        "cells": [
          {
            "var": "dimension",
            "value_iri": "https://blackcatinformatics.ca/gmeow/dimensionValence",
            "value_literal": null
          }
        ]
      },
      {
        "cells": [
          {
            "var": "dimension",
            "value_iri": "https://blackcatinformatics.ca/gmeow/dimensionAgency",
            "value_literal": null
          }
        ]
      }
    ],
