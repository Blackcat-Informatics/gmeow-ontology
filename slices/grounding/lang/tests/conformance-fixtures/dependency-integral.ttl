# Conforming fixture: two slots in one analysis, one depending on the other (lang:DependencyIntegrityShape).

@prefix lang: <https://blackcatinformatics.ca/lang/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:a1 a lang:Analysis .
ex:s0 a lang:FormSlot ; lang:inAnalysis ex:a1 ; lang:slotIndex 0 ; lang:slotForm ex:w0 ; lang:dependsOn ex:s1 .
ex:s1 a lang:FormSlot ; lang:inAnalysis ex:a1 ; lang:slotIndex 1 ; lang:slotForm ex:w1 .
ex:w0 a lang:Form ; lang:inSignSystem ex:english .
ex:w1 a lang:Form ; lang:inSignSystem ex:english .
