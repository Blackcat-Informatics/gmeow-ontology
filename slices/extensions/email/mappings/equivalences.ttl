# --------------------------------------------------------------------------- #
# Calendar invitation bridge alignments (issue #139)
# --------------------------------------------------------------------------- #

gmeow:eqEmail028 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:describesEvent ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject schema:about ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "schema:about is extremely broad; describesEvent is scoped to Event-bearing emails" ;
    gmeow:sssomFile "gmeow-email.sssom.tsv" .

gmeow:eqEmail029 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:calendarUid ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ical:uid ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "iCalendar UID — the persistent identifier of a calendar component" ;
    gmeow:sssomFile "gmeow-email.sssom.tsv" .

gmeow:eqEmail030 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:CalendarMethod ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject ical:method ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "iCalendar METHOD property — the value vocabulary corresponds to the property's value space, not a class equivalence" ;
    gmeow:sssomFile "gmeow-email.sssom.tsv" .

gmeow:eqEmail031 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasCalendarMethod ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject ical:method ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "iCalendar METHOD property on the calendar component" ;
    gmeow:sssomFile "gmeow-email.sssom.tsv" .

gmeow:eqEmail032 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:messageKindCalendarInvitation ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject ical:Vevent ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "the message carries an iCalendar VEVENT component" ;
    gmeow:sssomFile "gmeow-email.sssom.tsv" .

# --------------------------------------------------------------------------- #
# Mailing-list header terms (issue #131)
# --------------------------------------------------------------------------- #
# MailingList, hasMailingList, listSubscribe, listUnsubscribe, listPost,
# listHelp, listArchive, and listOwner are canonical — no maintained external
# RDF vocabulary covers RFC 2369 / RFC 2919 list headers. Schema.org has no
# mailing-list terms; NMO has no List-* coverage; SIOC has no list concepts.
# This follows the precedent of MessageKind, Mailbox hierarchy, and
# ContentTransferEncoding (all canonical in this slice).
# --------------------------------------------------------------------------- #
