    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The inequality atom of gmeow:DeterministicDigestConstraint (AC4/F4, deterministic digest): asserts ?d1 and ?d2 are distinct, the witness that closes the violation pattern."@x-gmeow-english ; logic:relation logic:termDistinct ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "d1" ] , [ logic:termIndex 1 ; logic:termVariable "d2" ] .

# F1 — a selected candidate at whole-set scope requires a discharged winner claim.
gmeow:SelectedCandidateRequiresConsensusConstraint
    a logic:Constraint ;
    rdfs:label "Selected candidate requires consensus constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC2/F1): a gmeow:ProjectionReceipt of ANY kind (especially listwise/scalarized, whose argmax emits one top pick) that binds a gmeow:selectedCandidate at whole-gmeow:CandidateSet scope is REJECTED unless a resource typed gmeow:PreferenceClaim asserts a global winner (gmeow:assertsGlobalWinner true), extends to a gmeow:ConsensusSection that gmeow:reconcilesObservation an observation whose gmeow:observationPrefers winner IS that selected candidate, and discharges a gmeow:DisagreementObstruction — closing both the 'argmax winner that never sets the flag' bypass AND the cross-candidate/cross-context leak (a discharged claim about a DIFFERENT candidate can never back this selection). A ∀→∃ formula, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:ProjectionReceipt ;
    logic:severity "Violation" ;
    logic:message "A gmeow:ProjectionReceipt binding a gmeow:selectedCandidate must be backed by a typed gmeow:PreferenceClaim that asserts a global winner, extends to a gmeow:ConsensusSection reconciling an observation that prefers THAT selected candidate, and discharges a gmeow:DisagreementObstruction (F1)." ;
    logic:integrity gmeow:srcForall .
gmeow:srcForall a logic:Formula ;
    rdfs:label "srcForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): binds ?this and requires ?this is a gmeow:ProjectionReceipt ∧ gmeow:srcSelects → ∃?claim,?sec,?g,?obs. gmeow:srcBody."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:srcImpl .
gmeow:srcImpl a logic:Formula ;
    rdfs:label "srcImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): when ?this is a gmeow:ProjectionReceipt ∧ ∃?cand. gmeow:selectedCandidate(?this, ?cand) holds, requires ∃?claim,?sec,?g,?obs. ?claim is a gmeow:PreferenceClaim ∧ gmeow:assertsGlobalWinner(?claim, 'true') ∧ gmeow:extendsToConsensusSection(?claim, ?sec) ∧ gmeow:dischargesDisagreement(?claim, ?g) ∧ gmeow:reconcilesObservation(?sec, ?obs) ∧ gmeow:observationPrefers(?obs, ?cand)."@x-gmeow-english ; logic:antecedent gmeow:srcGuard ; logic:consequent gmeow:srcExists .
gmeow:srcGuard a logic:Formula ;
    rdfs:label "srcGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): conjoins ?this is a gmeow:ProjectionReceipt ∧ ∃?cand. gmeow:selectedCandidate(?this, ?cand)."@x-gmeow-english ; logic:and gmeow:srcType , gmeow:srcSelects .
gmeow:srcType a logic:Formula ;
    rdfs:label "srcType (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): asserts ?this is a gmeow:ProjectionReceipt."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ProjectionReceipt ] .
gmeow:srcSelects a logic:Formula ;
    rdfs:label "srcSelects (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): quantifies ?cand and requires gmeow:selectedCandidate(?this, ?cand)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "cand" ] ;
    logic:exists gmeow:srcSelectsAtom .
gmeow:srcSelectsAtom a logic:Formula ;
    rdfs:label "srcSelectsAtom (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:selectedCandidate atom ('selected candidate') of gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): relates ?this, ?cand."@x-gmeow-english ; logic:relation gmeow:selectedCandidate ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "cand" ] .
gmeow:srcExists a logic:Formula ;
    rdfs:label "srcExists (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): quantifies ?claim, ?sec, ?g, ?obs and requires ?claim is a gmeow:PreferenceClaim ∧ gmeow:assertsGlobalWinner(?claim, 'true') ∧ gmeow:extendsToConsensusSection(?claim, ?sec) ∧ gmeow:dischargesDisagreement(?claim, ?g) ∧ gmeow:reconcilesObservation(?sec, ?obs) ∧ gmeow:observationPrefers(?obs, ?cand)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "claim" ] , [ logic:termIndex 1 ; logic:termVariable "sec" ] , [ logic:termIndex 2 ; logic:termVariable "g" ] , [ logic:termIndex 3 ; logic:termVariable "obs" ] ;
    logic:exists gmeow:srcBody .
# The consequent MUST bind the guard's selected ?cand: the backing claim's
# whole-base consensus section must reconcile an observation whose winner IS this
# receipt's selected candidate. Without srcReconciles + srcObsPrefersCand the ∃
# claim floats free of ?cand — any discharged winner-claim anywhere (about a
# different candidate / CandidateSet / ComparisonContext) would satisfy it,
# reopening the "hidden winner via a projection's top pick" bypass (Hard Rule 3).
gmeow:srcBody a logic:Formula ;
    rdfs:label "srcBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): conjoins ?claim is a gmeow:PreferenceClaim ∧ gmeow:assertsGlobalWinner(?claim, 'true') ∧ gmeow:extendsToConsensusSection(?claim, ?sec) ∧ gmeow:dischargesDisagreement(?claim, ?g) ∧ gmeow:reconcilesObservation(?sec, ?obs) ∧ gmeow:observationPrefers(?obs, ?cand)."@x-gmeow-english ; logic:and gmeow:srcClaimType , gmeow:srcAsserts , gmeow:srcExtends , gmeow:srcDischarge , gmeow:srcReconciles , gmeow:srcObsPrefersCand .
gmeow:srcReconciles a logic:Formula ;
    rdfs:label "srcReconciles (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:reconcilesObservation atom ('reconciles observation') of gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): relates ?sec, ?obs."@x-gmeow-english ; logic:relation gmeow:reconcilesObservation ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "sec" ] , [ logic:termIndex 1 ; logic:termVariable "obs" ] .
gmeow:srcObsPrefersCand a logic:Formula ;
    rdfs:label "srcObsPrefersCand (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:observationPrefers atom ('observation prefers') of gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): relates ?obs, ?cand."@x-gmeow-english ; logic:relation gmeow:observationPrefers ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "obs" ] , [ logic:termIndex 1 ; logic:termVariable "cand" ] .
gmeow:srcClaimType a logic:Formula ;
    rdfs:label "srcClaimType (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): asserts ?claim is a gmeow:PreferenceClaim."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ] , [ logic:termIndex 1 ; logic:termIri gmeow:PreferenceClaim ] .
gmeow:srcAsserts a logic:Formula ;
    rdfs:label "srcAsserts (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:assertsGlobalWinner atom ('asserts global winner') of gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): relates ?claim, 'true'."@x-gmeow-english ; logic:relation gmeow:assertsGlobalWinner ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ] , [ logic:termIndex 1 ; logic:termLiteral "true" ; logic:termLiteralDatatype xsd:boolean ] .
gmeow:srcExtends a logic:Formula ;
    rdfs:label "srcExtends (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:extendsToConsensusSection atom ('extends to consensus section') of gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): relates ?claim, ?sec."@x-gmeow-english ; logic:relation gmeow:extendsToConsensusSection ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ] , [ logic:termIndex 1 ; logic:termVariable "sec" ] .
gmeow:srcDischarge a logic:Formula ;
    rdfs:label "srcDischarge (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:dischargesDisagreement atom ('discharges disagreement') of gmeow:SelectedCandidateRequiresConsensusConstraint (AC2/F1, selected-candidate-requires-consensus): relates ?claim, ?g."@x-gmeow-english ; logic:relation gmeow:dischargesDisagreement ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ] , [ logic:termIndex 1 ; logic:termVariable "g" ] .

# DPO is derived-only: a canonical observation may not be derived from a DPO view.
gmeow:DpoNotCanonicalConstraint
    a logic:ForbiddenPatternConstraint ;
    rdfs:label "DPO not canonical constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world forbidden-pattern constraint (AC4): a gmeow:PreferenceObservation must NOT be gmeow:wasDerivedFrom a gmeow:DpoView — DPO is a derived consumer of the canonical preference, never its source. Because gmeow:DpoView ⊑ gmeow:ProjectionReceipt, a canonical observation sourced from any receipt-family DPO training view inverts the canonical→projection direction. Expands to ∀this. gmeow:DpoView(this) → ¬∃o. gmeow:preferenceObservationDerivedFrom(o,this)."@x-gmeow-english ;
    logic:onClass gmeow:DpoView ;
    logic:forbiddenPredicate gmeow:derivesCanonicalObservation ;
    logic:formalizes gmeow:DpoView ;
    logic:severity "Violation" ;
    logic:message "A gmeow:DpoView must not derive a canonical gmeow:PreferenceObservation (gmeow:derivesCanonicalObservation); DPO is derived-only, never the canonical source." .

gmeow:derivesCanonicalObservation
    a owl:ObjectProperty ;
    rdfs:domain gmeow:ProjectionReceipt ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "derives canonical observation"@x-gmeow-english ;
    rdfs:range gmeow:PreferenceObservation ;
    skos:definition "The FORBIDDEN edge a gmeow:DpoView must never carry: a derived projection sourcing a canonical gmeow:PreferenceObservation, inverting the canonical→projection direction (gmeow:DpoNotCanonicalConstraint). It exists only so the forbidden pattern has a named predicate to prohibit; a well-formed graph never asserts it."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# =========================================================================== #
# TASK 6 — Learning receipts + model-config deltas + geometric seam +          #
# lifecycle (AC5, AC6, geometry)                                               #
# =========================================================================== #

gmeow:PreferenceLearningEvent
    a logic:Event ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Preference Learning Event"@x-gmeow-english ;
    logic:subClassOf gmeow:LearningEvent ;
    skos:definition "A training/evaluation run that learns from preferences: a gmeow:LearningEvent (core) that consumes gmeow:ProjectionReceipts (typically a gmeow:DpoView) via a gmeow:ModelInvocation and produces a content-addressed gmeow:ModelConfigDelta. It REUSES the shipped learning-event and ai-invocation terms rather than minting a training vocabulary. It is NOT the gmeow:ModelConfigDelta it produces (the artifact) and NOT a gmeow:LifecycleReceipt (a promotion/rejection decision about the result)."@x-gmeow-english ;
    skos:example "ex:learn1 a gmeow:PreferenceLearningEvent ; gmeow:usedModel ex:opus ; gmeow:wasDerivedFrom ex:dpo1 ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating the run with the gmeow:ModelConfigDelta it produces and avoid folding a lifecycle decision (promotion/rejection) into it — that is a separate gmeow:LifecycleReceipt."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the training/eval run gmeow:PreferenceLearningEvent (⊑ gmeow:LearningEvent), link the projection receipts it consumes via the existing gmeow:wasDerivedFrom, its invocation via gmeow:usedModel, and the delta it produces via the existing gmeow:wasGeneratedBy on the delta."@x-gmeow-english ;
    gmeow:useWhen "Use for a training or evaluation run that learns from preference projection receipts and produces a model/config delta."@x-gmeow-english .

gmeow:ModelConfigDelta
    a logic:Kind ,
        owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Model Config Delta"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ,
        [ a owl:Restriction ; owl:onProperty gmeow:contentDigest ; owl:allValuesFrom rdfs:Literal ] ;
    skos:definition "The content-addressed record of a model/config change a preference learning run produced — its identity is the REUSED gmeow:contentDigest over the WHOLE identity tuple (AC5). Every leg is mandatory (gmeow:ModelConfigDeltaCompletenessConstraint): the base artifact (gmeow:deltaBaseArtifact, typed to the core gmeow:InformationObject — model-serving gmeow:ModelArtifact by reference), tokenizer (gmeow:deltaTokenizer), codebook (gmeow:deltaCodebook), dataset projection (gmeow:deltaDatasetProjection → own gmeow:ProjectionReceipt), selection query (gmeow:deltaSelectionQuery, stored-not-executed, Principle 12), prompt (gmeow:deltaPromptIdentity → ai gmeow:Prompt), rubric (gmeow:deltaRubricIdentity, typed to the core gmeow:SocialObject — norms gmeow:Rubric by reference), engine (gmeow:deltaEngine), optimizer (gmeow:deltaOptimizer), seed (gmeow:deltaSeed), and evaluation evidence (gmeow:deltaEvaluationEvidence → gmeow:EvidenceSpan). A delta missing any leg is not a reproducible identity. It is NOT the gmeow:PreferenceLearningEvent that produced it."@x-gmeow-english ;
    skos:example "ex:delta1 a gmeow:ModelConfigDelta ; gmeow:deltaBaseArtifact ex:baseCkpt ; gmeow:deltaTokenizer ex:tok1 ; gmeow:deltaCodebook ex:cb1 ; gmeow:deltaDatasetProjection ex:rec1 ; gmeow:deltaSelectionQuery ex:sq1 ; gmeow:deltaPromptIdentity ex:sysPrompt ; gmeow:deltaRubricIdentity ex:rubric1 ; gmeow:deltaEngine ex:eng1 ; gmeow:deltaOptimizer ex:opt1 ; gmeow:deltaSeed 42 ; gmeow:deltaEvaluationEvidence ex:span1 ; gmeow:contentDigest \"blake3:c0de…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid omitting any of the eleven legs (a partial delta is not a reproducible identity — gmeow:ModelConfigDeltaCompletenessConstraint) and avoid minting a separate delta id; the reused gmeow:contentDigest over the whole tuple IS the identity."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the change gmeow:ModelConfigDelta, fill ALL eleven legs (base artifact, tokenizer, codebook, dataset projection, selection query, prompt, rubric, engine, optimizer, seed, evaluation evidence), and content-address the whole tuple with the existing gmeow:contentDigest — that digest is the delta's identity."@x-gmeow-english ;
    gmeow:useWhen "Use for the content-addressed, fully-specified model/config change a preference learning run produced — the reproducible identity tuple AC5 requires."@x-gmeow-english .

gmeow:TokenizerContract
    a logic:Kind , owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Tokenizer Contract"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The tokenizer half of a model-config identity: the exact tokenization recipe (vocabulary, merges, special tokens, normalization) a gmeow:ModelConfigDelta is bound to — a bridge information object, minted here because it is own-slice model-config identity, not a norms/model-serving term. It is one leg of the delta's content-addressed tuple."@x-gmeow-english ;
    skos:example "ex:tok1 a gmeow:TokenizerContract ; gmeow:contentDigest \"blake3:70ke…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid folding tokenizer identity into the base artifact or the prompt; tokenization is a distinct, separately-addressed leg of the delta tuple."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the tokenization recipe gmeow:TokenizerContract, content-address it, and bind it to a delta via gmeow:deltaTokenizer."@x-gmeow-english ;
    gmeow:useWhen "Use for the exact tokenization recipe leg of a model-config delta identity tuple."@x-gmeow-english .

gmeow:CodebookContract
    a logic:Kind , owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Codebook Contract"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The codebook/quantization half of a model-config identity: the exact discrete-codebook or vector-quantization recipe a gmeow:ModelConfigDelta is bound to — an own-slice model-config identity bridge object. It is one leg of the delta's content-addressed tuple, distinct from the tokenizer (text→token) as the codebook is representation→code."@x-gmeow-english ;
    skos:example "ex:cb1 a gmeow:CodebookContract ; gmeow:contentDigest \"blake3:c0d3…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating the codebook with the tokenizer; the tokenizer maps text to tokens, the codebook maps representations to codes — distinct legs."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the codebook recipe gmeow:CodebookContract, content-address it, and bind it to a delta via gmeow:deltaCodebook."@x-gmeow-english ;
    gmeow:useWhen "Use for the exact codebook/quantization recipe leg of a model-config delta identity tuple."@x-gmeow-english .

gmeow:SelectionQuery
    a logic:Kind , owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Selection Query"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The STORED, not-executed (Principle 12) data-selection query a gmeow:ModelConfigDelta is bound to — the recipe for which training examples were selected, content-addressed as a claim the consumer executes, never run by the ontology. It is one leg of the delta's tuple. It is NOT the dataset projection it selects over (gmeow:deltaDatasetProjection): this names the selection recipe, that names the projected data."@x-gmeow-english ;
    skos:example "ex:sq1 a gmeow:SelectionQuery ; gmeow:contentDigest \"blake3:5e1e…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid executing the query in the ontology (it is stored, not executed — Principle 12) and avoid conflating it with the dataset projection it selects over."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the stored selection recipe gmeow:SelectionQuery, content-address it, and bind it to a delta via gmeow:deltaSelectionQuery; the consumer executes it, the ontology gates its content-addressing."@x-gmeow-english ;
    gmeow:useWhen "Use for the stored-not-executed data-selection query leg of a model-config delta identity tuple."@x-gmeow-english .

gmeow:EngineContract
    a logic:Kind , owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Engine Contract"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The inference/execution engine half of a model-config identity: the exact runtime, precision mode, and deterministic-execution settings a gmeow:ModelConfigDelta is bound to — an own-slice model-config identity bridge object. It is one leg of the delta's content-addressed tuple, distinct from the optimizer (training-time)."@x-gmeow-english ;
    skos:example "ex:eng1 a gmeow:EngineContract ; gmeow:contentDigest \"blake3:e491…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating the engine (execution runtime) with the optimizer (training algorithm); they are distinct legs."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the execution engine recipe gmeow:EngineContract, content-address it, and bind it to a delta via gmeow:deltaEngine."@x-gmeow-english ;
    gmeow:useWhen "Use for the inference/execution engine leg of a model-config delta identity tuple."@x-gmeow-english .

gmeow:OptimizerContract
    a logic:Kind , owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    rdfs:label "Optimizer Contract"@x-gmeow-english ;
    logic:subClassOf gmeow:InformationObject ;
    skos:definition "The optimizer half of a model-config identity: the exact training algorithm, hyperparameters, and schedule (e.g. the DPO objective and its β) a gmeow:ModelConfigDelta is bound to — an own-slice model-config identity bridge object. An optimizer view (like DPO) is itself a gmeow:ProjectionReceipt consumer, not the canonical preference. It is one leg of the delta's content-addressed tuple."@x-gmeow-english ;
    skos:example "ex:opt1 a gmeow:OptimizerContract ; gmeow:contentDigest \"blake3:0971…\" ."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid conflating the optimizer (training algorithm) with the engine (execution runtime) and avoid treating the optimizer's DPO view as the canonical preference."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    gmeow:howToUse "Type the training-algorithm recipe gmeow:OptimizerContract, content-address it, and bind it to a delta via gmeow:deltaOptimizer."@x-gmeow-english ;
    gmeow:useWhen "Use for the optimizer/training-algorithm leg of a model-config delta identity tuple."@x-gmeow-english .

# --- Delta legs (each existential targets a CORE superclass or own-slice term) --- #
gmeow:deltaBaseArtifact
    a owl:ObjectProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta base artifact"@x-gmeow-english ;
    rdfs:range gmeow:InformationObject ;
    skos:definition "Relates a gmeow:ModelConfigDelta to its base model artifact — typed to the core gmeow:InformationObject (model-serving gmeow:ModelArtifact ⊑ gmeow:InformationObject is reused only by-reference, never a range axiom — Principle 16). The checkpoint the delta is a change FROM; a mandatory leg of the identity tuple."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
gmeow:deltaTokenizer
    a owl:ObjectProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta tokenizer"@x-gmeow-english ;
    rdfs:range gmeow:TokenizerContract ;
    skos:definition "Relates a gmeow:ModelConfigDelta to its gmeow:TokenizerContract leg — the exact tokenization recipe folded into the delta's digest."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
gmeow:deltaCodebook
    a owl:ObjectProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta codebook"@x-gmeow-english ;
    rdfs:range gmeow:CodebookContract ;
    skos:definition "Relates a gmeow:ModelConfigDelta to its gmeow:CodebookContract leg — the exact codebook/quantization recipe folded into the delta's digest."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
gmeow:deltaDatasetProjection
    a owl:ObjectProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta dataset projection"@x-gmeow-english ;
    rdfs:range gmeow:ProjectionReceipt ;
    skos:definition "Relates a gmeow:ModelConfigDelta to the gmeow:ProjectionReceipt (own-slice) whose projected preference data the training consumed — the dataset leg, itself a lossy disclosed projection."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
gmeow:deltaSelectionQuery
    a owl:ObjectProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta selection query"@x-gmeow-english ;
    rdfs:range gmeow:SelectionQuery ;
    skos:definition "Relates a gmeow:ModelConfigDelta to its gmeow:SelectionQuery leg — the stored-not-executed data-selection recipe folded into the delta's digest (Principle 12)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
gmeow:deltaPromptIdentity
    a owl:ObjectProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta prompt identity"@x-gmeow-english ;
    rdfs:range gmeow:Prompt ;
    skos:definition "Relates a gmeow:ModelConfigDelta to the ai gmeow:Prompt (core) it is bound to — the exact prompt leg, REUSING the shipped ai prompt term rather than re-grounding one."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
gmeow:deltaRubricIdentity
    a owl:ObjectProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta rubric identity"@x-gmeow-english ;
    rdfs:range gmeow:SocialObject ;
    skos:definition "Relates a gmeow:ModelConfigDelta to its rubric leg — typed to the core gmeow:SocialObject (norms gmeow:Rubric ⊑ gmeow:SocialObject is reused only by-reference, never a range axiom — Principle 16). The evaluative frame the training optimized under."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
gmeow:deltaEngine
    a owl:ObjectProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta engine"@x-gmeow-english ;
    rdfs:range gmeow:EngineContract ;
    skos:definition "Relates a gmeow:ModelConfigDelta to its gmeow:EngineContract leg — the exact execution engine/precision settings folded into the delta's digest."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
gmeow:deltaOptimizer
    a owl:ObjectProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta optimizer"@x-gmeow-english ;
    rdfs:range gmeow:OptimizerContract ;
    skos:definition "Relates a gmeow:ModelConfigDelta to its gmeow:OptimizerContract leg — the exact training algorithm/hyperparameters folded into the delta's digest."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
gmeow:deltaSeed
    a owl:DatatypeProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta seed"@x-gmeow-english ;
    rdfs:range xsd:integer ;
    skos:definition "The random seed a gmeow:ModelConfigDelta is bound to — the reproducibility leg, folded into the delta's digest so a re-run with a different seed is a distinct delta."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .
gmeow:deltaEvaluationEvidence
    a owl:ObjectProperty ; rdfs:domain gmeow:ModelConfigDelta ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ; rdfs:label "delta evaluation evidence"@x-gmeow-english ;
    rdfs:range gmeow:EvidenceSpan ;
    skos:definition "Relates a gmeow:ModelConfigDelta to the gmeow:EvidenceSpan (core) grounding its evaluation — the evidence leg, REUSING the shipped evidence-span term so the delta's warrant is auditable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

# AC5 — a model-config delta binds ALL eleven legs (conjunction + closed-world).
gmeow:ModelConfigDeltaCompletenessConstraint
    a logic:Constraint ;
    rdfs:label "Model-config delta completeness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint (AC5): a gmeow:ModelConfigDelta MUST bind ALL eleven identity legs — base artifact, tokenizer, codebook, dataset projection, selection query, prompt, rubric, engine, optimizer, seed, and evaluation evidence — so its gmeow:contentDigest is over the whole tuple. A delta missing any leg is not a reproducible identity. A ∀→∃(∧×11) formula backed by a closed-world logic:ClosureEntry over the leg predicates, projected to a sh:SPARQLConstraint."@x-gmeow-english ;
    logic:formalizes gmeow:ModelConfigDelta ;
    logic:severity "Violation" ;
    logic:message "A gmeow:ModelConfigDelta must bind all eleven identity legs (base artifact, tokenizer, codebook, dataset projection, selection query, prompt, rubric, engine, optimizer, seed, evaluation evidence); a partial delta is not a reproducible identity (AC5)." ;
    logic:integrity gmeow:mcdForall .
gmeow:mcdForall a logic:Formula ;
    rdfs:label "mcdForall (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The top-level ∀ quantifier of gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): binds ?this and requires ?this is a gmeow:ModelConfigDelta → ∃?ba,?tk,?cb,?dp,?sq,?pr,?rb,?en,?op,?sd,?ev. gmeow:mcdBody."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] ;
    logic:forall gmeow:mcdImpl .
gmeow:mcdImpl a logic:Formula ;
    rdfs:label "mcdImpl (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The antecedent→consequent implication of gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): when ?this is a gmeow:ModelConfigDelta holds, requires ∃?ba,?tk,?cb,?dp,?sq,?pr,?rb,?en,?op,?sd,?ev. gmeow:deltaBaseArtifact(?this, ?ba) ∧ gmeow:deltaTokenizer(?this, ?tk) ∧ gmeow:deltaCodebook(?this, ?cb) ∧ gmeow:deltaDatasetProjection(?this, ?dp) ∧ gmeow:deltaSelectionQuery(?this, ?sq) ∧ gmeow:deltaPromptIdentity(?this, ?pr) ∧ gmeow:deltaRubricIdentity(?this, ?rb) ∧ gmeow:deltaEngine(?this, ?en) ∧ gmeow:deltaOptimizer(?this, ?op) ∧ gmeow:deltaSeed(?this, ?sd) ∧ gmeow:deltaEvaluationEvidence(?this, ?ev)."@x-gmeow-english ; logic:antecedent gmeow:mcdGuard ; logic:consequent gmeow:mcdExists .
gmeow:mcdGuard a logic:Formula ;
    rdfs:label "mcdGuard (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The type-guard atom of gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): asserts ?this is a gmeow:ModelConfigDelta."@x-gmeow-english ; logic:relation rdf:type ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termIri gmeow:ModelConfigDelta ] .
gmeow:mcdExists a logic:Formula ;
    rdfs:label "mcdExists (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The ∃ existential within gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): quantifies ?ba, ?tk, ?cb, ?dp, ?sq, ?pr, ?rb, ?en, ?op, ?sd, ?ev and requires gmeow:deltaBaseArtifact(?this, ?ba) ∧ gmeow:deltaTokenizer(?this, ?tk) ∧ gmeow:deltaCodebook(?this, ?cb) ∧ gmeow:deltaDatasetProjection(?this, ?dp) ∧ gmeow:deltaSelectionQuery(?this, ?sq) ∧ gmeow:deltaPromptIdentity(?this, ?pr) ∧ gmeow:deltaRubricIdentity(?this, ?rb) ∧ gmeow:deltaEngine(?this, ?en) ∧ gmeow:deltaOptimizer(?this, ?op) ∧ gmeow:deltaSeed(?this, ?sd) ∧ gmeow:deltaEvaluationEvidence(?this, ?ev)."@x-gmeow-english ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "ba" ] , [ logic:termIndex 1 ; logic:termVariable "tk" ] , [ logic:termIndex 2 ; logic:termVariable "cb" ] , [ logic:termIndex 3 ; logic:termVariable "dp" ] , [ logic:termIndex 4 ; logic:termVariable "sq" ] , [ logic:termIndex 5 ; logic:termVariable "pr" ] , [ logic:termIndex 6 ; logic:termVariable "rb" ] , [ logic:termIndex 7 ; logic:termVariable "en" ] , [ logic:termIndex 8 ; logic:termVariable "op" ] , [ logic:termIndex 9 ; logic:termVariable "sd" ] , [ logic:termIndex 10 ; logic:termVariable "ev" ] ;
    logic:exists gmeow:mcdBody .
gmeow:mcdBody a logic:Formula ;
    rdfs:label "mcdBody (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The conjunctive body within gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): conjoins gmeow:deltaBaseArtifact(?this, ?ba) ∧ gmeow:deltaTokenizer(?this, ?tk) ∧ gmeow:deltaCodebook(?this, ?cb) ∧ gmeow:deltaDatasetProjection(?this, ?dp) ∧ gmeow:deltaSelectionQuery(?this, ?sq) ∧ gmeow:deltaPromptIdentity(?this, ?pr) ∧ gmeow:deltaRubricIdentity(?this, ?rb) ∧ gmeow:deltaEngine(?this, ?en) ∧ gmeow:deltaOptimizer(?this, ?op) ∧ gmeow:deltaSeed(?this, ?sd) ∧ gmeow:deltaEvaluationEvidence(?this, ?ev)."@x-gmeow-english ;
    logic:and gmeow:mcdBA , gmeow:mcdTK , gmeow:mcdCB , gmeow:mcdDP , gmeow:mcdSQ , gmeow:mcdPR , gmeow:mcdRB , gmeow:mcdEN , gmeow:mcdOP , gmeow:mcdSD , gmeow:mcdEV .
gmeow:mcdBA a logic:Formula ;
    rdfs:label "mcdBA (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:deltaBaseArtifact atom ('delta base artifact') of gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): relates ?this, ?ba."@x-gmeow-english ; logic:relation gmeow:deltaBaseArtifact ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "ba" ] .
gmeow:mcdTK a logic:Formula ;
    rdfs:label "mcdTK (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:deltaTokenizer atom ('delta tokenizer') of gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): relates ?this, ?tk."@x-gmeow-english ; logic:relation gmeow:deltaTokenizer ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "tk" ] .
gmeow:mcdCB a logic:Formula ;
    rdfs:label "mcdCB (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:deltaCodebook atom ('delta codebook') of gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): relates ?this, ?cb."@x-gmeow-english ; logic:relation gmeow:deltaCodebook ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "cb" ] .
gmeow:mcdDP a logic:Formula ;
    rdfs:label "mcdDP (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:deltaDatasetProjection atom ('delta dataset projection') of gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): relates ?this, ?dp."@x-gmeow-english ; logic:relation gmeow:deltaDatasetProjection ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "dp" ] .
gmeow:mcdSQ a logic:Formula ;
    rdfs:label "mcdSQ (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:deltaSelectionQuery atom ('delta selection query') of gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): relates ?this, ?sq."@x-gmeow-english ; logic:relation gmeow:deltaSelectionQuery ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "sq" ] .
gmeow:mcdPR a logic:Formula ;
    rdfs:label "mcdPR (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:deltaPromptIdentity atom ('delta prompt identity') of gmeow:ModelConfigDeltaCompletenessConstraint (AC5, eleven-leg model-config-delta completeness): relates ?this, ?pr."@x-gmeow-english ; logic:relation gmeow:deltaPromptIdentity ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "pr" ] .
gmeow:mcdRB a logic:Formula ;
    rdfs:label "mcdRB (formula AST node)"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
