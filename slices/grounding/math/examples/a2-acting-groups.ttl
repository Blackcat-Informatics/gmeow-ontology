# SPDX-License-Identifier: CC-BY-4.0
#
# Three groups acting on one root system. The A2 root system has six roots in rank 2.
# Its Weyl group W(A2) is generated by the reflections and has order 6. Its full
# automorphism group also contains the map sending every root to its negative, which
# is not in W(A2), and has order 12. The rotations in W(A2) form a subgroup of order 3.
# Each of the three groups acts on the same six roots, so the target of an action does
# not say which group acts: every action descriptor names its own actor through
# math:actingGroup. Unlike E8, the Weyl group of A2 is a proper subgroup of the full
# automorphism group, so neither role may be read from the other.
#
# These descriptors declare the actor and the target only. They author no action law,
# witness or orbit data; the realized compatibility law is carried by exa:e8WeylAction
# in e8-symmetry.ttl.

@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix exag: <https://blackcatinformatics.ca/gmeow/examples/math/acting-groups/> .

# --- The root system ------------------------------------------------------- #

exag:a2Roots a math:RootSystem ;
    rdfs:label "the A2 root system (6 roots, rank 2)"@x-gmeow-english ;
    math:rootSystemRank 2 ;
    math:rootCount 6 ;
    math:cartanMatrix exag:a2Cartan ;
    math:weylGroup exag:a2Weyl .

exag:a2Cartan a math:CartanMatrix ;
    rdfs:label "the 2×2 A2 Cartan matrix"@x-gmeow-english .

# --- Three groups of symmetries of the roots ------------------------------- #
# A subgroup keeps the composition, identity and inverse of its ambient group, so the
# three groups share those resources and differ in their carriers.

exag:a2Automorphisms a math:AutomorphismGroup ;
    rdfs:label "Aut(A2) — the full automorphism group of the A2 roots (order 12)"@x-gmeow-english ;
    math:automorphismGroupOf exag:a2Roots ;
    math:underlyingSet exag:a2AutomorphismSet ;
    math:structureOperation exag:symmetryComposition ;
    math:identityElement exag:identitySymmetry ;
    math:inverseOperation exag:symmetryInverse ;
    math:satisfiesAxiom exag:compositionAssociativity , exag:compositionIdentity , exag:compositionInverse ;
    math:groupOrder 12 .

exag:a2Weyl a math:WeylGroup ;
    rdfs:label "W(A2) — the Weyl group of A2 (order 6)"@x-gmeow-english ;
    math:hasRootSystem exag:a2Roots ;
    math:normalSubgroupOf exag:a2Automorphisms ;
    math:underlyingSet exag:a2WeylSet ;
    math:structureOperation exag:symmetryComposition ;
    math:identityElement exag:identitySymmetry ;
    math:inverseOperation exag:symmetryInverse ;
    math:satisfiesAxiom exag:compositionAssociativity , exag:compositionIdentity , exag:compositionInverse ;
    math:groupOrder 6 .

exag:a2Rotations a math:Group ;
    rdfs:label "the rotation subgroup of W(A2) (order 3)"@x-gmeow-english ;
    math:normalSubgroupOf exag:a2Weyl ;
    math:underlyingSet exag:a2RotationSet ;
    math:structureOperation exag:symmetryComposition ;
    math:identityElement exag:identitySymmetry ;
    math:inverseOperation exag:symmetryInverse ;
    math:satisfiesAxiom exag:compositionAssociativity , exag:compositionIdentity , exag:compositionInverse ;
    math:groupOrder 3 .

exag:a2AutomorphismSet a math:Set ; rdfs:label "the twelve automorphisms of the A2 roots"@x-gmeow-english .
exag:a2WeylSet a math:Set ; rdfs:label "the six elements of W(A2)"@x-gmeow-english .
exag:a2RotationSet a math:Set ; rdfs:label "the three rotations in W(A2)"@x-gmeow-english .
exag:symmetryComposition a math:Operation ; rdfs:label "composition of root-system symmetries"@x-gmeow-english .
exag:symmetryInverse a math:Operation ; rdfs:label "s ↦ s⁻¹"@x-gmeow-english .
exag:identitySymmetry rdfs:label "the identity symmetry of the A2 roots"@x-gmeow-english .
exag:compositionAssociativity a math:Axiom ; rdfs:label "composition is associative"@x-gmeow-english .
exag:compositionIdentity a math:Axiom ; rdfs:label "the identity symmetry is a two-sided identity"@x-gmeow-english .
exag:compositionInverse a math:Axiom ; rdfs:label "every symmetry has a two-sided inverse"@x-gmeow-english .

# --- Three actions on the same target, each naming its own actor ----------- #

exag:a2AutomorphismAction a math:GroupAction ;
    rdfs:label "the action Aut(A2) ↷ roots"@x-gmeow-english ;
    math:actingGroup exag:a2Automorphisms ;
    math:actsOn exag:a2Roots .

exag:a2WeylAction a math:GroupAction ;
    rdfs:label "the Weyl action W(A2) ↷ roots"@x-gmeow-english ;
    math:actingGroup exag:a2Weyl ;
    math:actsOn exag:a2Roots .

exag:a2RotationAction a math:GroupAction ;
    rdfs:label "the action of the rotation subgroup of W(A2) on the roots"@x-gmeow-english ;
    math:actingGroup exag:a2Rotations ;
    math:actsOn exag:a2Roots .
