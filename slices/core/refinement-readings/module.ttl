# Scoped process-state readings.

gmeow:OpenItemReading
    a logic:Class, logic:SubKind ;
    logic:subClassOf gmeow:Refinement ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Open Item Reading"@x-gmeow-english ;
    skos:definition "A versioned process’s reading of a request or question awaiting an agent, limited to explicitly offered records. An open reading reports no linked settling act in that scope, never that the matter is unsettled in reality."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly scoped process reading with retained source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global absence, preference, diagnosis or source-subject endorsement from a process reading."@x-gmeow-english ;
    gmeow:howToUse "Retain the source, readingScope and versioned vantage; report supplied values without defaults and preserve earlier readings."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:reading a gmeow:OpenItemReading ."@x-gmeow-english .

gmeow:OpenItemKind
    a logic:Class, logic:AbstractIndividualType ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Open Item Kind"@x-gmeow-english ;
    skos:definition "An open vocabulary classifying the source item read as awaiting an agent. Request and question are seeded values, not subclasses or assertions that a request lifecycle was executed."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly scoped process reading with retained source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global absence, preference, diagnosis or source-subject endorsement from a process reading."@x-gmeow-english ;
    gmeow:howToUse "Retain the source, readingScope and versioned vantage; report supplied values without defaults and preserve earlier readings."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:kind a gmeow:OpenItemKind ."@x-gmeow-english .

gmeow:OpenItemState
    a logic:Class, logic:AbstractIndividualType ;
    logic:subClassOf logic:QualityValue ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Open Item State"@x-gmeow-english ;
    skos:definition "An open vocabulary for the refiner’s scoped reading of an item’s linked response or settlement. Missing state remains unknown; changing state creates a new reading rather than editing its source."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly scoped process reading with retained source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global absence, preference, diagnosis or source-subject endorsement from a process reading."@x-gmeow-english ;
    gmeow:howToUse "Retain the source, readingScope and versioned vantage; report supplied values without defaults and preserve earlier readings."@x-gmeow-english ;
    skos:example "Retain this attributed record: ex:state a gmeow:OpenItemState ."@x-gmeow-english .

gmeow:openItemRequest
    a gmeow:OpenItemKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/refinement-readings> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "request item"@x-gmeow-english ;
    skos:definition "The source is read as a request made of the awaited agent. This reading is distinct from the request act and any AttentionRequest lifecycle."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicitly scoped process reading with retained source evidence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring global absence, preference, diagnosis or source-subject endorsement from a process reading."@x-gmeow-english ;
