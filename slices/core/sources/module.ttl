@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .

gmeow:contentDigest
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "content digest"@x-gmeow-english ;
    logic:range [ a rdfs:Datatype ; logic:unionOf ( gmeow:blake3_256Digest gmeow:sha256Digest gmeow:md5Digest ) ] ;
    skos:definition "A supplied digest of an artifact's exact identified byte preimage, with algorithm identity carried by gmeow:blake3_256Digest, gmeow:sha256Digest or gmeow:md5Digest. The lexical form is bare lowercase hexadecimal: 64 digits for BLAKE3-256 and SHA-256, 32 for MD5. Domain-free and non-functional, so digests under several algorithms may coexist. A typed claim does not prove that the artifact was read or its bytes verified; scheme, history and canonical-model identifiers belong on their own identity properties."@x-gmeow-english ;
    skos:example "ex:report gmeow:contentDigest \"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\"^^gmeow:blake3_256Digest ."@x-gmeow-english ;
    skos:scopeNote "Typically asserted on a Manifestation, Item, SourceFile, Commit, or Distribution."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using a path, filename, or URL as identity (that is gmeow:sourceLocation, audit-only) and avoid making it functional — one artifact may legitimately carry digests under several algorithms."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    gmeow:howToUse "Retain each supplied digest's bare hexadecimal lexical form and algorithm datatype on the artifact whose exact byte preimage it identifies. Compare complete RDF terms; preserve several algorithms without coercing their values or relabeling Git, SWH or model identifiers as raw-byte hashes."@x-gmeow-english ;
    gmeow:useWhen "Use to retain a supplied algorithm-typed digest of an artifact's identified byte preimage for content comparison and provenance."@x-gmeow-english .

gmeow:sourceLocation
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "source location"@x-gmeow-english ;
    rdfs:range rdfs:Literal ;
    skos:definition "Where the source artifact came from — a file path, original filename, or URL. Provenance/audit only; carries no reliable identity."@x-gmeow-english ;
    skos:example "ex:report gmeow:sourceLocation \"/imports/2026/report.pdf\" ."@x-gmeow-english ;
    skos:scopeNote "Typically asserted on a Manifestation or Item."@x-gmeow-english ;
    gmeow:avoidForConsumer gmeow:consumerPublicSite ;
    gmeow:avoidWhen "Avoid relying on it for identity or deduplication (paths and URLs are unstable; use gmeow:contentDigest) and avoid treating it as the citation locator into the work (that is the Selector in the citations slice)."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Assert gmeow:sourceLocation on the Manifestation or Item alongside gmeow:contentDigest; read the location as audit trail and the digest as the authoritative identity."@x-gmeow-english ;
    gmeow:useWhen "Use to record where a source artifact came from — its file path, original filename, or URL — for provenance and audit."@x-gmeow-english .

gmeow:sourceModifiedAt
    a logic:DatatypeProperty ;
    rdfs:domain gmeow:CreativeWork ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "source modified at"@x-gmeow-english ;
    rdfs:range xsd:dateTime ;
    skos:definition "The last-modification time of the source artifact itself (e.g. a file mtime). A terminus-ante-quem on the recording of the claims this source carries — NOT valid-time (tenure) and NOT observation-time. Advisory and resettable; the reliable identity is gmeow:contentDigest. NOT functional: because a source is identified by its content digest, copies/syncs of the same bytes may legitimately report different modification times, which must coexist rather than force an inconsistency."@x-gmeow-english ;
    skos:example "ex:report gmeow:sourceModifiedAt \"2026-06-15T12:00:00Z\"^^xsd:dateTime ."@x-gmeow-english ;
    skos:scopeNote "Typically asserted on a Manifestation or Item."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid using it as valid-time/tenure or as observation-time (those are temporal-slice and observation constructs) and avoid treating it as identity — gmeow:contentDigest is the reliable identity; keep it non-functional so copies' differing mtimes coexist."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxRBox ;
    gmeow:howToUse "Assert gmeow:sourceModifiedAt on the Manifestation or Item; pair it with gmeow:recordedNoLaterThan so the carrier's mtime bounds the recording of its claims, and with gmeow:contentDigest for stable identity."@x-gmeow-english ;
    gmeow:useWhen "Use to record the last-modification time of a source artifact (a file mtime) as a terminus-ante-quem on when the claims it carries were recorded."@x-gmeow-english .


# === The canonical ingestion prescription (re-homed worked example) ===========
#
# A worked ingestion plan: six sequential acquisition-to-assessment steps. It is
# a logic:Plan carrying logic:prescriptionKindIngestion, its steps are
# logic:ActionSchema individuals, and their order is carried as binary
# logic:ControlFlowEdge flow edges rather than as a bespoke step-sequence
# property. It supersedes the earlier "source-packet bundle" idea.

gmeow:goalCanonicalIngestion
    a gmeow:Goal ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "canonical ingestion goal"@x-gmeow-english ;
    skos:definition "The success criterion of gmeow:planCanonicalIngestion: raw sources acquired, copied, OCR-extracted, and assessed into derived claims, unresolved leads, and a privacy posture — the canonical ingested state the plan's steps are arranged to reach."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:planCanonicalIngestion
    a logic:Plan ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "Canonical Ingestion Plan"@x-gmeow-english ;
    skos:definition "A worked-example ingestion plan of six sequential steps from raw-root acquisition to privacy-posture assessment. As a logic:Plan it carries its own success criterion: logic:planGoal gmeow:goalCanonicalIngestion and logic:planSuccessMode logic:StrongPlanSuccess, so every execution reaches the ingested state."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:planGoal gmeow:goalCanonicalIngestion ;
    logic:planSuccessMode logic:StrongPlanSuccess ;
    logic:prescriptionKind logic:prescriptionKindIngestion ;
    logic:planFlowEdge gmeow:ingestionEdgeRawRootToFileCopy ,
        gmeow:ingestionEdgeFileCopyToOcr ,
        gmeow:ingestionEdgeOcrToDerivedClaims ,
        gmeow:ingestionEdgeDerivedClaimsToUnresolvedLeads ,
        gmeow:ingestionEdgeUnresolvedLeadsToPrivacyPosture .

gmeow:ingestionRawRootArtifact
    a gmeow:Entity ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "raw root data source"@x-gmeow-english ;
    skos:definition "The raw root data source the canonical ingestion plan acquires and stages from — the unprocessed origin against which every later step's output is traceable."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:stepIngestionRawRoot
    a logic:TransactionStep ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "raw root acquisition"@x-gmeow-english ;
    skos:definition "Acquire the raw root data source. The first step of the canonical ingestion plan; every later step's output traces back to what it staged."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:stepIngestionFileCopy
    a logic:TransactionStep ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "file copy / staging"@x-gmeow-english ;
    skos:definition "Copy and stage files from the raw root into working storage, leaving the root untouched so the ingestion is repeatable against the same origin."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:stepIngestionOcrExtract
    a logic:TransactionStep ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "OCR text extraction"@x-gmeow-english ;
    skos:definition "Extract text from the staged files. The step whose capability may be absent, in which case the plan blocks with a capability-gap proposal rather than substituting a weaker parser."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:stepIngestionDerivedClaims
    a logic:TransactionStep ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "derived claims and events generation"@x-gmeow-english ;
    skos:definition "Generate derived claims and events from the extracted text. Its outputs are attributed claims, never asserted truths, so a later standpoint may defeat them."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ,
        gmeow:boxCBox .

gmeow:stepIngestionUnresolvedLeads
    a logic:TransactionStep ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "unresolved leads capture"@x-gmeow-english ;
    skos:definition "Record what the ingestion could not resolve. Load-bearing rather than incidental: an ingestion that silently drops what it failed to understand cannot be audited for completeness."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:stepIngestionPrivacyPosture
    a logic:TransactionStep ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "privacy posture assessment"@x-gmeow-english ;
    skos:definition "Assess the privacy posture of the ingested material. The final step of the canonical ingestion plan; its verdict governs how the derived claims may subsequently be surfaced."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .

gmeow:ingestionEdgeRawRootToFileCopy
    a logic:ControlFlowEdge ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "raw root then file copy"@x-gmeow-english ;
    skos:definition "The control-flow edge ordering raw-root acquisition before file staging in the canonical ingestion plan."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:flowFrom gmeow:stepIngestionRawRoot ;
    logic:flowTo gmeow:stepIngestionFileCopy .

gmeow:ingestionEdgeFileCopyToOcr
    a logic:ControlFlowEdge ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "file copy then OCR"@x-gmeow-english ;
    skos:definition "The control-flow edge ordering file staging before OCR extraction in the canonical ingestion plan."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:flowFrom gmeow:stepIngestionFileCopy ;
    logic:flowTo gmeow:stepIngestionOcrExtract .

gmeow:ingestionEdgeOcrToDerivedClaims
    a logic:ControlFlowEdge ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "OCR then derived claims"@x-gmeow-english ;
    skos:definition "The control-flow edge ordering OCR extraction before derived-claim generation in the canonical ingestion plan."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:flowFrom gmeow:stepIngestionOcrExtract ;
    logic:flowTo gmeow:stepIngestionDerivedClaims .

gmeow:ingestionEdgeDerivedClaimsToUnresolvedLeads
    a logic:ControlFlowEdge ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "derived claims then unresolved leads"@x-gmeow-english ;
    skos:definition "The control-flow edge ordering derived-claim generation before unresolved-lead capture in the canonical ingestion plan."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:flowFrom gmeow:stepIngestionDerivedClaims ;
    logic:flowTo gmeow:stepIngestionUnresolvedLeads .

gmeow:ingestionEdgeUnresolvedLeadsToPrivacyPosture
    a logic:ControlFlowEdge ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "unresolved leads then privacy posture"@x-gmeow-english ;
    skos:definition "The control-flow edge ordering unresolved-lead capture before privacy-posture assessment in the canonical ingestion plan."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:flowFrom gmeow:stepIngestionUnresolvedLeads ;
    logic:flowTo gmeow:stepIngestionPrivacyPosture .

<https://blackcatinformatics.ca/gmeow/slices/sources>
    a logic:Ontology ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment """Sources, citations, and the evidence layer — a cross-cutting facility
(reused by genealogy and every other slice) for evidence-based, source-cited claims.
Refactored in source/claim refactor: the anti-rigid Source Kind is retired; source-hood is mediated by
CitationAct or borne as SourceRole. The Citation locator is retired in favor of Selector
(in the citations module). Carrier metadata now applies to Manifestation/Item."""@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    rdfs:label "GMEOW Sources Module"@x-gmeow-english ;
    skos:definition "The GMEOW Sources Module — classes, properties, and individuals of the GMEOW super-vocabulary."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxCBox ,
        gmeow:boxConfigBox ,
        gmeow:boxTBox .

# Record intake: preserve source meaning and representation.
gmeow:encodedByteLength
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "encoded byte length"@x-gmeow-english ;
    skos:definition "The explicitly supplied size in bytes of this information object's particular encoded representation. It describes the same encoded artifact as its content digest, not a creative work's human-readable extent or a Unicode character count."@x-gmeow-english ;
    gmeow:useWhen "Use to retain the exact byte size reported for an encoded artifact."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring a byte length from text length, an abstract work or a different serialization."@x-gmeow-english ;
    gmeow:howToUse "Write the supplied nonNegativeInteger on the encoded artifact; keep distinct encodings on distinct artifact nodes."@x-gmeow-english ;
    skos:scopeNote "A size is metadata, not proof that bytes were read or a digest was verified. Attributed size claims may coexist."@x-gmeow-english ;
    skos:example "ex:artifact gmeow:encodedByteLength \"128\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
    logic:domain gmeow:InformationObject ; logic:range xsd:nonNegativeInteger .


# Explicit property-range validation; no required path on unrelated records.
[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/encodedByteLength" ; logic:closureValue logic:ClosedWorldClosure ] .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/contentDigest" ; logic:closureValue logic:ClosedWorldClosure ] .

gmeow:ContentDigestValueConstraint
    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/sources> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "supplied byte digest admission"@x-gmeow-english ;
    skos:definition "Every supplied byte digest on the selected properties retains an admitted algorithm datatype and its exact lowercase hexadecimal width, without a prefix. This check does not compute a digest or prove that source bytes were verified."@x-gmeow-english ;
    logic:formalizes gmeow:contentDigest ;
    logic:severity "Violation" ;
    logic:message "A supplied byte digest requires its admitted algorithm datatype and bare lowercase hexadecimal digits of the required width." ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation gmeow:contentDigest ; logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ] ;
            logic:consequent [ a logic:Formula ; logic:or [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:termSameComponent ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ], [ logic:termIndex 1 ; logic:termIri logic:componentDatatype ], [ logic:termIndex 2 ; logic:termIri gmeow:blake3_256Digest ], [ logic:termIndex 3 ; logic:termIri logic:componentWhole ] ], [ a logic:Formula ; logic:relation logic:termRegex ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ], [ logic:termIndex 1 ; logic:termLiteral "^[0-9a-f]{64}$" ] ] ], [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:termSameComponent ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ], [ logic:termIndex 1 ; logic:termIri logic:componentDatatype ], [ logic:termIndex 2 ; logic:termIri gmeow:sha256Digest ], [ logic:termIndex 3 ; logic:termIri logic:componentWhole ] ], [ a logic:Formula ; logic:relation logic:termRegex ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ], [ logic:termIndex 1 ; logic:termLiteral "^[0-9a-f]{64}$" ] ] ], [ a logic:Formula ; logic:and [ a logic:Formula ; logic:relation logic:termSameComponent ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ], [ logic:termIndex 1 ; logic:termIri logic:componentDatatype ], [ logic:termIndex 2 ; logic:termIri gmeow:md5Digest ], [ logic:termIndex 3 ; logic:termIri logic:componentWhole ] ], [ a logic:Formula ; logic:relation logic:termRegex ; logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ], [ logic:termIndex 1 ; logic:termLiteral "^[0-9a-f]{32}$" ] ] ] ] ] ] .
