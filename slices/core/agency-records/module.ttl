    logic:message "Each supplied episode-chain attachment and causing-fact reference has an actual rdf:reifies witness on that exact claim. Quotation neither asserts its proposition nor proves causality."@x-gmeow-english ;
    logic:integrity [ a logic:Formula ;
        logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "transitionReport" ] ;
        logic:forall [ a logic:Formula ;
            logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument [ logic:termIndex 0 ; logic:termVariable "transitionReport" ] , [ logic:termIndex 1 ; logic:termIri gmeow:EpisodeTransition ] ] ;
            logic:consequent [ a logic:Formula ; logic:and
                [ a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "q1Claim" ] ;
                    logic:forall [ a logic:Formula ;
                        logic:antecedent [ a logic:Formula ; logic:relation gmeow:episodeTransition ; logic:argument [ logic:termIndex 0 ; logic:termVariable "q1Claim" ] , [ logic:termIndex 1 ; logic:termVariable "transitionReport" ] ] ;
                        logic:consequent [ a logic:Formula ;
                            logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "q1Quote" ] ;
                            logic:exists [ a logic:Formula ; logic:relation rdf:reifies ; logic:argument [ logic:termIndex 0 ; logic:termVariable "q1Claim" ] , [ logic:termIndex 1 ; logic:termVariable "q1Quote" ] ] ] ] ] ,
                [ a logic:Formula ;
                    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "q2Claim" ] ;
                    logic:forall [ a logic:Formula ;
                        logic:antecedent [ a logic:Formula ; logic:relation gmeow:transitionCauseFact ; logic:argument [ logic:termIndex 0 ; logic:termVariable "transitionReport" ] , [ logic:termIndex 1 ; logic:termVariable "q2Claim" ] ] ;
                        logic:consequent [ a logic:Formula ;
                            logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "q2Quote" ] ;
                            logic:exists [ a logic:Formula ; logic:relation rdf:reifies ; logic:argument [ logic:termIndex 0 ; logic:termVariable "q2Claim" ] , [ logic:termIndex 1 ; logic:termVariable "q2Quote" ] ] ] ] ] ] ] ] .

