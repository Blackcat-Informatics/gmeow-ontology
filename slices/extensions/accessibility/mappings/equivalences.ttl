    gmeow:objectLabel "Products and technology for education" ;
    gmeow:comment "ICF e140 covers assistive products for learning and education, relevant to cognitive access."
|} .

gmeow:facetLifeSupport skos:closeMatch <http://hl7.org/fhir/sid/icf#e5> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:objectLabel "Services, systems and policies" ;
    gmeow:comment "ICF e5 covers services, systems and policies including health and medical services relevant to life-support access."
|} .

gmeow:facetClearance skos:closeMatch <http://hl7.org/fhir/sid/icf#d4> {|
    gmeow:sssomFile "gmeow-accessibility.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:objectLabel "Mobility" ;
    gmeow:comment "ICF d4 (Mobility) encompasses the spatial requirements for physical clearance."
|} .
