logic:antecedent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryRerankScore ] ],
[ a logic:Formula ;
logic:relation math:quantityValue ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ], [ logic:termIndex 1 ; logic:termVariable "value" ] ] ] ;
logic:consequent [ a logic:Formula ;
logic:relation logic:termIsFiniteNumeric ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "value" ] ] ] ] .

