# Conforming GMN fixture: a complete envelope. The gmeow:GmnEnvelope carries its full
# nine-field contract (the three dialect coordinates, the declared codebook identity, the
# boundary ring, the asserting standpoint, the generating activity, the byte-exact digest,
# and the losslessness judgment) so the derived gmeow:GmnEnvelope-shape validates with no findings.
# The gmeow:gmnCodebookDigest is the codebook's recomputed Merkle root (the SAME value the
# frozen gmn1-vectors manifest.ttl pins), so the native GMN codebook-digest gate passes. The
# judgment is a logic:Correspondence — the honest section/retraction verdict of the GMN-0 →
# GMN-1 crossing (mirroring gmeow:gmnCorrNormalToGmn), never a boolean lossless flag.

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

ex:archiveTeam a gmeow:Agent .
ex:gmnWriterRun a gmeow:Activity .

ex:corrEnvelope a logic:Correspondence ;
    logic:preservationKind logic:ExactPreservation ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:SectionRetraction ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true .

ex:envelopeComplete a gmeow:GmnEnvelope ;
    gmeow:gmnSchemaVersion "1" ;
    gmeow:gmnDictionaryVersion "3" ;
    gmeow:gmnGlyphTableVersion "2" ;
    gmeow:gmnCodebookDigest "blake3:26a68453ecfe47867551038b8b247e9f4b07b3815bd87979c401afb0f7edf5ce" ;
    gmeow:gmnSecurityRing gmeow:gmnRingTrusted ;
    gmeow:accordingTo ex:archiveTeam ;
    gmeow:wasGeneratedBy ex:gmnWriterRun ;
    gmeow:contentDigest "blake3:5f2acdc6e1a1e9f4f6b0e0a7c9d3b8a1c4e7f0a3b6d9c2e5f8a1b4d7c0e3f6a9" ;
    gmeow:gmnEnvelopeCorrespondence ex:corrEnvelope .
