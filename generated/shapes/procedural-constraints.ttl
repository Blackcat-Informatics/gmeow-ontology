        sh:message "A value marked gmeow:sensitivitySensitivePersonal should also carry gmeow:coarsenTo or gmeow:displayable false — the trigger for projection-time redaction (Principle 10). A source may legitimately publish the precise value under explicit consent." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/hasSensitivity> <https://blackcatinformatics.ca/gmeow/sensitivitySensitivePersonal> . FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/coarsenTo> ?lvl . } UNION { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SkillProficiencyScaleMatchConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/SkillProficiency> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/SkillProficiency> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "The skillProficiencyLevel's levelScale should match the relator's skillProficiencyScale." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/gmeow/SkillProficiency> . $this <https://blackcatinformatics.ca/gmeow/skillProficiencyLevel> ?level . ?level <https://blackcatinformatics.ca/gmeow/levelScale> ?expected . $this <https://blackcatinformatics.ca/gmeow/skillProficiencyScale> ?scale . FILTER ( ?scale != ?expected ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/StandpointCredenceLowerBoundConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StandpointCredenceRangeShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/standpointCredence> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "gmeow:standpointCredence must be an xsd:decimal in [0.0, 1.0] — a credence value outside this range is malformed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/standpointCredence> ?v . FILTER ( ?v < '0.0'^^<http://www.w3.org/2001/XMLSchema#decimal> ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/StandpointCredenceUpperBoundConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StandpointCredenceRangeShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/standpointCredence> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "gmeow:standpointCredence must be an xsd:decimal in [0.0, 1.0] — a credence value outside this range is malformed." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/standpointCredence> ?v . FILTER ( ?v > '1.0'^^<http://www.w3.org/2001/XMLSchema#decimal> ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/StyleGuideVoiceDigestConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StyleGuide> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/StyleGuide> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Every gmeow:voiceExemplifiedBy document must carry a gmeow:contentDigest (byte-perfect voice doctrine)." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/gmeow/StyleGuide> . $this <https://blackcatinformatics.ca/gmeow/voiceExemplifiedBy> ?doc . FILTER NOT EXISTS { ?doc <https://blackcatinformatics.ca/gmeow/contentDigest> ?dig . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/SupersededGenderIdentitySuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GenderIdentity> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/GenderIdentity> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A superseded identity facet (one with gmeow:validUntil) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/gmeow/GenderIdentity> . $this <https://blackcatinformatics.ca/gmeow/validUntil> ?u . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/TeachingSelfTeachConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Teaching> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Teaching> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:Teaching relation's gmeow:teacher and gmeow:learner must differ; a self-teaching relation is ill-formed." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/gmeow/Teaching> . $this <https://blackcatinformatics.ca/gmeow/teacher> ?a . $this <https://blackcatinformatics.ca/gmeow/learner> ?b . FILTER ( ?a = ?b ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/UsesScaleFunctionalConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/UsesScaleTargetShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/usesScale> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A holder binds at most one gmeow:usesScale, a ScoreScale — two scales make anchor containment and score interpretation ambiguous (closed-world functional)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/usesScale> ?a . $this <https://blackcatinformatics.ca/gmeow/usesScale> ?b . FILTER ( ?a != ?b ) }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/WithdrawnStandpointSuppressionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/StandpointTenure> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/StandpointTenure> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Warning ;
        sh:message "A withdrawn standpoint (a StandpointTenure whose interval has ended) should set gmeow:displayable false — suppressed from display, never deleted." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/gmeow/StandpointTenure> . $this <https://blackcatinformatics.ca/gmeow/duringInterval> ?iv . ?iv <https://blackcatinformatics.ca/gmeow/endedAtTime> ?end . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/displayable> 'false'^^<http://www.w3.org/2001/XMLSchema#boolean> . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/ConfidenceModelConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/ConfidenceNotProbabilityShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/lang/aboutReading> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A reading claim carries a logic:probability with no declared logic:probabilityModel." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/aboutReading> ?r . $this <https://blackcatinformatics.ca/logic/probability> ?p . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/logic/probabilityModel> ?m . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FeatureValueDispositionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/FeatureValue> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/FeatureValue> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:FeatureValue must be the lang:denotationTarget of some lang:Denotation; an undispositioned feature value is ill-formed." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/lang/FeatureValue> . FILTER NOT EXISTS { ?s a <https://blackcatinformatics.ca/lang/Denotation> . ?s <https://blackcatinformatics.ca/lang/denotationTarget> $this . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FlagshipScenarioFailureClassConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/FlagshipScenario> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/FlagshipScenario> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:FlagshipScenario's lang:enforcesFailureClass must transitively rdfs:subClassOf lang:LangConformanceFailure; a scenario that enforces a non-failure class is ill-formed." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/lang/FlagshipScenario> . $this <https://blackcatinformatics.ca/lang/enforcesFailureClass> ?v . FILTER NOT EXISTS { ?v <http://www.w3.org/2000/01/rdf-schema#subClassOf>+ <https://blackcatinformatics.ca/lang/LangConformanceFailure> . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FormSlotAcyclicDependencyConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/FormSlot> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/FormSlot> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:FormSlot may not depend on itself transitively along lang:dependsOn; a dependency cycle is ill-formed." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/lang/FormSlot> . $this <https://blackcatinformatics.ca/lang/dependsOn>+ $this . }""" ;
    ] .

<https://blackcatinformatics.ca/lang/FormSlotIndexUniquenessConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/ComposedForm> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/ComposedForm> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "No two distinct lang:formSlot cells of one lang:ComposedForm may share the same lang:slotIndex." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/lang/ComposedForm> . $this <https://blackcatinformatics.ca/lang/formSlot> ?s1 . $this <https://blackcatinformatics.ca/lang/formSlot> ?s2 . ?s1 <https://blackcatinformatics.ca/lang/slotIndex> ?i . ?s2 <https://blackcatinformatics.ca/lang/slotIndex> ?i . FILTER ( ?s1 != ?s2 ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnCodepointCanonicalConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnCodepointCanonicalShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:gmnCodepoints value must be canonical: space-separated U+XXXX groups of 4-6 uppercase hex digits." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?g . $this <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?v . FILTER ( !REGEX(STR(?v), '^U\\\\+[0-9A-F]{4,6}( U\\\\+[0-9A-F]{4,6})*$') ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnCompactionOverclaimConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/GmnCompaction> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/GmnCompaction> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A gmeow:GmnCompaction links a logic:Correspondence claiming mnemomorphic recoverability, exact preservation, or soundness under approximation; compaction is validation-only." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/gmeow/GmnCompaction> . $this ?link ?c . ?c a <https://blackcatinformatics.ca/logic/Correspondence> . { ?c <https://blackcatinformatics.ca/logic/mnemomorphic> 'true'^^<http://www.w3.org/2001/XMLSchema#boolean> . } UNION { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/ExactPreservation> . } UNION { ?c <https://blackcatinformatics.ca/logic/preservationKind> <https://blackcatinformatics.ca/logic/SoundUnderApproximation> . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnConfusableGlyphConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnConfusableGlyphShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/gmnConfusableWith> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Two distinct graphemes of the GMN script are a declared gmeow:gmnConfusableWith pair; the orthography's confusables blocklist forbids co-resident confusables." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/gmnConfusableWith> ?g2 . $this <https://blackcatinformatics.ca/lang/inScript> <https://blackcatinformatics.ca/gmeow/gmnScript> . ?g2 <https://blackcatinformatics.ca/lang/inScript> <https://blackcatinformatics.ca/gmeow/gmnScript> . FILTER ( $this != ?g2 ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnGlyphCollisionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnGlyphCollisionShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Two distinct graphemes of one script share an identical gmeow:gmnCodepoints value without both carrying a gmeow:gmnSigilScope; unscoped glyph collisions are forbidden." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?cp . $this <https://blackcatinformatics.ca/lang/inScript> ?s . ?g2 <https://blackcatinformatics.ca/gmeow/gmnCodepoints> ?cp . ?g2 <https://blackcatinformatics.ca/lang/inScript> ?s . FILTER ( $this != ?g2 ) FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/gmnSigilScope> ?sc1 . ?g2 <https://blackcatinformatics.ca/gmeow/gmnSigilScope> ?sc2 . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GmnVersionOverclaimConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/GmnVersionOverclaimShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/gmeow/gmnMigratesTo> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A GMN migration claims logic:mnemomorphic true over a stronger-than-additive version bump; the version machinery never claims more than its lineage discharges." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/gmnMigratesTo> ?vg . $this <https://blackcatinformatics.ca/gmeow/gmnMigratesTo> ?v . $this <https://blackcatinformatics.ca/lang/translationCorrespondence> ?c . ?c <https://blackcatinformatics.ca/logic/mnemomorphic> 'true'^^<http://www.w3.org/2001/XMLSchema#boolean> . ?m <https://blackcatinformatics.ca/gmeow/versionMember> ?v . ?m <https://blackcatinformatics.ca/gmeow/versionScale> ?sc . FILTER ( ?sc != <https://blackcatinformatics.ca/gmeow/scaleMinor> ) FILTER ( ?sc != <https://blackcatinformatics.ca/gmeow/scaleTrivial> ) }""" ;
    ] .

<https://blackcatinformatics.ca/lang/GraphemeRepertoireConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/Grapheme> ;
    sh:targetClass <https://blackcatinformatics.ca/lang/Grapheme> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A grapheme is not in the repertoire of the script it declares." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/lang/Grapheme> . $this <https://blackcatinformatics.ca/lang/inScript> ?s . FILTER NOT EXISTS { ?s <https://blackcatinformatics.ca/lang/hasGrapheme> $this . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/ReadingClaimVantageConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/ReadingClaimGroundedShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/lang/aboutReading> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A reading-correctness claim (a gmeow:Observation about a lang:Reading) must name its gmeow:vantage; an ungrounded reading claim is ill-formed (lang:UngroundedReadingClaim)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/aboutReading> ?t . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/gmeow/vantage> ?c0 . } }""" ;
    ] .

<https://blackcatinformatics.ca/lang/SlotFormNodeKindConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/lang/SlotFormStructuralShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/lang/slotForm> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A lang:slotForm value must be a resource (a blank node or IRI), never a literal." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/lang/slotForm> ?g . $this <https://blackcatinformatics.ca/lang/slotForm> ?v . FILTER ( !( isIRI(?v) || isBlank(?v) ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/logic/RationalValueNonZeroDenominatorConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/RationalValue> ;
    sh:targetClass <https://blackcatinformatics.ca/math/RationalValue> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:RationalValue must declare a non-zero math:denominator; a zero denominator is not a rational value (math:ZeroDenominator)." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/RationalValue> . $this <https://blackcatinformatics.ca/math/denominator> '0'^^<http://www.w3.org/2001/XMLSchema#integer> . }""" ;
    ] .

<https://blackcatinformatics.ca/logic/SatisfiedByBackedByEvaluationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/Goal> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Goal> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A conclusive gmeow:satisfiedBy edge must be backed by a vantage-scoped logic:GoalEvaluation (evaluatesGoal = this goal, evaluatedAgainst = the situation, satisfactionStatus = logic:Satisfied, goalEvaluationStatus = logic:GoalEvaluationCompleted). No backing evaluation under any vantage was found." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/gmeow/Goal> . $this <https://blackcatinformatics.ca/gmeow/satisfiedBy> ?situation . FILTER NOT EXISTS { ?eval <https://blackcatinformatics.ca/logic/evaluatesGoal> $this . ?eval <https://blackcatinformatics.ca/logic/evaluatedAgainst> ?situation . ?eval <https://blackcatinformatics.ca/logic/satisfactionStatus> <https://blackcatinformatics.ca/logic/Satisfied> . ?eval <https://blackcatinformatics.ca/logic/goalEvaluationStatus> <https://blackcatinformatics.ca/logic/GoalEvaluationCompleted> . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/ArgumentSlotIndexUniquenessConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/SlotIndexUniquenessShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/math/argumentSlot> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "No two distinct math:argumentSlot cells of the same parent may share the same math:slotIndex; a duplicate index makes operand order ambiguous." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/argumentSlot> ?g . $this <https://blackcatinformatics.ca/math/argumentSlot> ?s1 . $this <https://blackcatinformatics.ca/math/argumentSlot> ?s2 . ?s1 <https://blackcatinformatics.ca/math/slotIndex> ?i . ?s2 <https://blackcatinformatics.ca/math/slotIndex> ?i . FILTER ( ?s1 != ?s2 ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/ChartDimensionMatchConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/Chart> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Chart> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Chart's target coordinate space dimension does not equal its manifold's dimension (math:DimensionMismatch)." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/Chart> . ?m <https://blackcatinformatics.ca/math/hasChart> $this . ?m <https://blackcatinformatics.ca/math/manifoldDimension> ?md . $this <https://blackcatinformatics.ca/math/targetCoordinateSpace> ?t . ?t <https://blackcatinformatics.ca/math/spaceDimension> ?sd . FILTER ( ?md != ?sd ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/E8WeylOrderConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/RootSystem> ;
    sh:targetClass <https://blackcatinformatics.ca/math/RootSystem> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:RootSystem with the E8 fingerprint (math:rootCount 240, math:rootSystemRank 8) must declare a math:weylGroup of math:groupOrder 696729600 — the order of W(E8); a different order corrupts the flagship invariant and is rejected." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/RootSystem> . $this <https://blackcatinformatics.ca/math/rootCount> '240'^^<http://www.w3.org/2001/XMLSchema#integer> . $this <https://blackcatinformatics.ca/math/rootSystemRank> '8'^^<http://www.w3.org/2001/XMLSchema#integer> . $this <https://blackcatinformatics.ca/math/weylGroup> ?w . ?w <https://blackcatinformatics.ca/math/groupOrder> ?o . FILTER ( ?o != '696729600'^^<http://www.w3.org/2001/XMLSchema#integer> ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/FlagshipScenarioFailureClassConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/FlagshipScenario> ;
    sh:targetClass <https://blackcatinformatics.ca/math/FlagshipScenario> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:FlagshipScenario's math:enforcesFailureClass must transitively rdfs:subClassOf math:MathConformanceFailure; a scenario that enforces a non-failure class is ill-formed." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/FlagshipScenario> . $this <https://blackcatinformatics.ca/math/enforcesFailureClass> ?v . FILTER NOT EXISTS { ?v <http://www.w3.org/2000/01/rdf-schema#subClassOf>+ <https://blackcatinformatics.ca/math/MathConformanceFailure> . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/FormalVerificationResultGroundingConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/FormalVerificationResult> ;
    sh:targetClass <https://blackcatinformatics.ca/math/FormalVerificationResult> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:FormalVerificationResult must be the gmeow:observationResult of some observation; an ungrounded verification result is ill-formed." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/FormalVerificationResult> . FILTER NOT EXISTS { ?s <https://blackcatinformatics.ca/gmeow/observationResult> $this . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/GramMatrixSymmetryConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/GramMatrix> ;
    sh:targetClass <https://blackcatinformatics.ca/math/GramMatrix> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:GramMatrix must be symmetric: every math:MatrixEntry at (row, column) needs a transpose entry at (column, row) with the same math:entryValue; a missing or mismatched transpose entry is ill-formed (math:AsymmetricGramMatrix)." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/GramMatrix> . $this <https://blackcatinformatics.ca/math/hasEntry> ?entry . ?entry <https://blackcatinformatics.ca/math/atRow> ?row . ?entry <https://blackcatinformatics.ca/math/atColumn> ?col . ?entry <https://blackcatinformatics.ca/math/entryValue> ?val . ?val <https://blackcatinformatics.ca/math/numerator> ?vnum . ?val <https://blackcatinformatics.ca/math/denominator> ?vden . FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/hasEntry> ?mate . ?mate <https://blackcatinformatics.ca/math/atRow> ?col . ?mate <https://blackcatinformatics.ca/math/atColumn> ?row . ?mate <https://blackcatinformatics.ca/math/entryValue> ?mval . ?mval <https://blackcatinformatics.ca/math/numerator> ?vnum . ?mval <https://blackcatinformatics.ca/math/denominator> ?vden . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/LogicLoweringDeclaredConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/LogicLoweringShape> ;
    sh:targetSubjectsOf <https://blackcatinformatics.ca/math/compilesToLogicFormula> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An expression lowered to a logic:Formula through math:compilesToLogicFormula must declare its math:denotationKind and its math:logicLoweringPreservation; silent promotion to a logical assertion is forbidden (math:UndeclaredLogicLowering)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/math/compilesToLogicFormula> ?t . { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/denotationKind> ?c0 . } } UNION { FILTER NOT EXISTS { $this <https://blackcatinformatics.ca/math/logicLoweringPreservation> ?c1 . } } }""" ;
    ] .

<https://blackcatinformatics.ca/math/MetricSignatureDimensionConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/MetricSignature> ;
    sh:targetClass <https://blackcatinformatics.ca/math/MetricSignature> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:MetricSignature's math:signaturePositive plus math:signatureNegative does not equal its manifold's math:manifoldDimension (math:DimensionMismatch)." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/MetricSignature> . ?mt <https://blackcatinformatics.ca/math/metricSignature> $this . ?m <https://blackcatinformatics.ca/math/metricTensor> ?mt . ?m <https://blackcatinformatics.ca/math/manifoldDimension> ?md . $this <https://blackcatinformatics.ca/math/signaturePositive> ?p . $this <https://blackcatinformatics.ca/math/signatureNegative> ?q . BIND ( ( ?p + ?q ) AS ?s ) FILTER ( ?s != ?md ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/NormPositiveDefiniteConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/Norm> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Norm> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Norm's math:inducedByForm must be positive-definite (math:definiteness math:positiveDefinite); a norm resting on a non-positive-definite form is ill-formed (math:NonPositiveDefiniteNorm)." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/Norm> . $this <https://blackcatinformatics.ca/math/inducedByForm> ?v . FILTER NOT EXISTS { ?v <https://blackcatinformatics.ca/math/definiteness> <https://blackcatinformatics.ca/math/positiveDefinite> . } }""" ;
    ] .

<https://blackcatinformatics.ca/math/SetBuilderMemberConditionNodeKindConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/SetBuilderExpression> ;
    sh:targetClass <https://blackcatinformatics.ca/math/SetBuilderExpression> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:SetBuilderExpression must name its math:memberCondition as a resource denoting a logic: formula (a blank node or IRI), not an opaque literal string." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/SetBuilderExpression> . $this <https://blackcatinformatics.ca/math/memberCondition> ?v . FILTER ( !( isIRI(?v) || isBlank(?v) ) ) }""" ;
    ] .

<https://blackcatinformatics.ca/math/TheoremWarrantConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/math/Theorem> ;
    sh:targetClass <https://blackcatinformatics.ca/math/Theorem> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "A math:Theorem must be warranted by either an in-graph math:Proof (some resource math:provesStatement it) or a declared math:externalWarrant; a theorem asserted with neither is an unwarranted truth-bit claim (math:UngroundedTheoremClaim)." ;
        sh:select """SELECT $this WHERE { $this a <https://blackcatinformatics.ca/math/Theorem> . FILTER NOT EXISTS { { ?p <https://blackcatinformatics.ca/math/provesStatement> $this . } UNION { $this <https://blackcatinformatics.ca/math/externalWarrant> ?w . } } }""" ;
    ] .
