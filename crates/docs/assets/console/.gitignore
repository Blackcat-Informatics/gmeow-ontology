# npm install + pack artifacts for the published `@blackcatinformatics/gmeow-console`
# package. The console's own sources are all tracked; these are not.
/node_modules/
/*.tgz

# The engine payload `prepack.mjs` stages out of `gmeow-dev console-assemble` before the
# tarball is cut: the browser transport, the client-side BLAKE3, both wasm images, the
# integrity manifest and the `gmeow.gts` snapshot. A build product of the one producer,
# exactly like every other package's `pkg/` — never a checked-in second copy.
/pkg/

# The dev-only Playwright smoke lane's installed dependencies. `smoke/package.json` and
# `smoke/package-lock.json` ARE tracked (the lane is pinned); what `npm ci --prefix
# crates/docs/assets/console/smoke` unpacks under them is not. The rule above is anchored
# at THIS directory, so it does not reach the nested tree — this second rule does.
/smoke/node_modules/
