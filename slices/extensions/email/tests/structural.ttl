}""" ;
    gmeow:saRationale """gmeow:analysisInputBodyLine MUST be a DatatypeProperty on EmailMessage ranging over Literal.""" .

# --- Email part-like relations specialize the universal part spine (MUST) ----
ex:saEmailPartLikeRelationsSpecializeSpine a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:partOfThread  rdfs:subPropertyOf gmeow:partOf .
    gmeow:hasBodyPart   rdfs:subPropertyOf gmeow:hasPart .
    gmeow:hasAttachment rdfs:subPropertyOf gmeow:hasPart .
}""" ;
    gmeow:saRationale """gmeow:partOfThread MUST be rdfs:subPropertyOf gmeow:partOf; gmeow:hasBodyPart and gmeow:hasAttachment MUST be rdfs:subPropertyOf gmeow:hasPart -- email/conversation part-like relations specialize the universal spine.""" .
