msgstr "vérification par appréciation réflexive"

msgctxt "https://blackcatinformatics.ca/gmeow/verifierReflectiveAppraisal|http://www.w3.org/2004/02/skos/core#definition"
msgid "Verification requiring a cited Note containing the agent's reflective appraisal with actual noteContent and agent attribution. The appraisal remains a situated judgment rather than an external fact."
msgstr "Vérification exigeant une Note citée contenant l’appréciation réflexive de l’agent, son noteContent réel et son attribution. Cette appréciation reste un jugement situé plutôt qu’un fait externe."

msgctxt "https://blackcatinformatics.ca/gmeow/verifierReflectiveAppraisal|https://blackcatinformatics.ca/gmeow/useWhen"
