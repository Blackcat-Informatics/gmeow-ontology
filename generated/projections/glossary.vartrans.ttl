<http://example.org/lang/glossary-vartrans/form-tgt/600494300cf89ecf>
    a ontolex:Form ;
    ontolex:writtenRep "L’association d’alias de version 3 pour logic:Closed : `closed`, conservée sans changement depuis la version 2."@fr .

