@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix ical: <http://www.w3.org/2002/12/cal/icaltzd#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/projections/ical>
    a align:Alignment ;
    align:level "2EDOAL" ;
    align:map [
        a align:Cell ;
        align:entity1 [
            a edoal:Relation ;
            edoal:compose ( [
                a edoal:Relation ;
                edoal:inverse [
                    a edoal:Relation ;
                    edoal:uri gmeow:participationEvent ;
                ] ;
            ] [
                a edoal:Relation ;
                edoal:uri gmeow:participationParticipant ;
            ] ) ;
        ] ;
        align:entity2 [
            a edoal:Relation ;
            edoal:uri ical:attendee ;
        ] ;
        align:relation "<=" ;
        edoal:measure "0.8"^^xsd:double ;
        edoal:transformation [
            rdfs:seeAlso gmeow:fnParticipationToEventRole ;
        ] ;
        rdfs:label "Participation participant → iCalendar ATTENDEE"@en ;
    ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:compose ( [
                    a edoal:Relation ;
                    edoal:uri gmeow:eventType ;
                ] [
                    a edoal:Relation ;
                    edoal:uri rdfs:label ;
                ] ) ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri ical:summary ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.6"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnEventTypeToSummary ;
            ] ;
            rdfs:label "Event type label → iCalendar SUMMARY"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:hasParticipant ;
            ] ;
            align:entity2 [
                a edoal:Relation ;
                edoal:uri ical:attendee ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.8"^^xsd:double ;
            edoal:transformation [
                rdfs:seeAlso gmeow:fnParticipantToAttendee ;
            ] ;
            rdfs:label "hasParticipant → iCalendar ATTENDEE"@en ;
        ] ,
        [
            a align:Cell ;
            align:entity1 [
                a edoal:Relation ;
                edoal:uri gmeow:recurrenceRuleText ;
            ] ;
            align:entity2 [
                a edoal:Property ;
                edoal:uri ical:rrule ;
            ] ;
            align:relation "<=" ;
            edoal:measure "0.95"^^xsd:double ;
            rdfs:label "RecurrenceRule text → iCalendar RRULE"@en ;
        ] ;
    align:onto1 [
        a align:Ontology ;
        align:formalism [
            align:name "GMEOW" ;
        ] ;
    ] ;
    align:onto2 [
        a align:Ontology ;
        align:formalism [
            align:name "ical" ;
        ] ;
    ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow-dev sync --mode update --outputs generated` (mappings) from canonical mapping sources — DO NOT EDIT."@en ;
    rdfs:label "GMEOW → ical (EDOAL)"@en .
