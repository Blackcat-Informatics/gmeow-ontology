@prefix gmeow:  <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix wd:     <http://www.wikidata.org/entity/> .

# Term equivalences for the deception / falsehood / misinformation facility (#213) —
# GMEOW authoring source. Compiled to mappings/gmeow-deception.sssom.tsv by
# `gmeow compile-mappings`. All alignments are BY REFERENCE (Principle 5); GMEOW
# never imports an external axiom. See docs/deception.md.

gmeow:mapsetDeception a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/deception" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment """Deception / falsehood / misinformation alignments (#213).
        FORMAL GROUNDING: gmeow:heldStandpoint / gmeow:projectedStandpoint realise the divergence model of deception as standpoint-indexed claims; gmeow:bullshit is the Frankfurt modality integrated into the Standpoint-Logic value space.
        schema.org: ClaimReview is an attestation act (not a truth verdict); Rating is a lossy projection to VerificationResult.
        CRMinf: I6_Belief_Value aligns to gmeow:StandpointModality (including the bullshit modality); I1_Argumentation is referenced for the solver-layer argument-acceptability function.
        PROV-O: deception events are prov:Activity; standpoint claims are prov:Entity.
        Wikidata: wd:Q170028 (deception) aligns to gmeow:eventTypeDeception.
        AIF (Argument Interchange Format) is referenced in the solver layer (fnArgumentAcceptability) but not aligned via TermEquivalence because AIF lacks a stable, resolvable RDF namespace suitable for SSSOM rows.""" .

# schema.org — ClaimReview as attestation act (lossy projection).
gmeow:eqDeception001 a gmeow:TermEquivalence ;
    gmeow:alignSubject schema:ClaimReview ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject gmeow:Attestation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "schema:ClaimReview is a fact-checking act; in GMEOW it is an Attestation with attestationTypeFactCheck. The single-verdict model of ClaimReview is a lossy projection — GMEOW keeps every standpoint's assessment as a coexisting claim." ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

gmeow:eqDeception002 a gmeow:TermEquivalence ;
    gmeow:alignSubject schema:Rating ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject gmeow:VerificationResult ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "schema:Rating (the outcome of a ClaimReview) projects to gmeow:VerificationResult — a lossy downcast dropping the standpoint axis and confidence." ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

# PROV-O — deception events as activities, claims as entities.
gmeow:eqDeception003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Event ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject prov:Activity ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.4 ;
    gmeow:comment "a deception event is a provenance activity; the specific deception semantics are GMEOW-specific and not entailed by PROV-O" ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

gmeow:eqDeception004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:StandpointClaim ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject prov:Entity ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.4 ;
    gmeow:comment "a standpoint claim (held or projected) is a provenance entity attributed to its standpoint agent" ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

# CRMinf — belief value and argumentation.
gmeow:eqDeception005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:StandpointModality ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject crminf:I6_Belief_Value ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "GMEOW's StandpointModality (unequivocal/probable/conceivable/refuted/bullshit) spans and extends CRMinf's I6 Belief Value" ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

gmeow:eqDeception006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:deceptiveIntentClaim ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject crminf:I1_Argumentation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.4 ;
    gmeow:comment "an attribution of deceptive intent is an argumentation act in the CRMinf sense; acceptability is computed externally (Principle 12)" ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

# Wikidata — deception concept.
gmeow:eqDeception007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventTypeDeception ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q170028 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata 'deception' (Q170028) — the act of propagating beliefs that are not true" ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

# ---------------------------------------------------------------------------
# Issue #215 — Speech-act deception event types (Wikidata QIDs re-curled 2026-06-09).
# ---------------------------------------------------------------------------

gmeow:eqDeception008 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventTypeLie ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q4925193 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata 'lie' (Q4925193) — a false statement made with deliberate intent to deceive. GMEOW models this as eventTypeLie with held standpoint refuted and projected standpoint unequivocal." ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

# eventTypePaltering: no direct Wikidata item found (searched 2026-06-09).
# The concept was introduced in Rogers et al., JPSP 112(3), 2017, but no
# Wikidata entity currently represents it. No TermEquivalence row is asserted
# until a suitable item is identified.

# eventTypeOmission: no direct Wikidata item found (searched 2026-06-09).
# It is a form of deception by suppressing truth rather than asserting falsehood.
# Conceptually skos:broader wd:Q4925193 (lie) but the relationship is weak;
# no TermEquivalence row is asserted until a suitable item is identified.

gmeow:eqDeception010 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventTypeDistortion ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q12776523 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "Wikidata 'spin' (Q12776523) — a form of propaganda, achieved through providing an interpretation of an event or campaign to persuade public opinion. GMEOW generalises this to eventTypeDistortion covering all sharpening/re-framing deceptions." ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

gmeow:eqDeception011 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventTypeBullshit ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q2063516 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "Wikidata 'bullshit' (Q2063516) — the general vulgar term, not specifically Frankfurt's philosophical concept. Related rather than close match because the item is the broad term, not the indifference-to-truth modality." ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

gmeow:eqDeception012 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventTypeBullshit ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject wd:Q1760159 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Frankfurt's essay 'On Bullshit' (Q1760159) — the philosophical source of the bullshit modality. Related rather than close match because the item is a literary work, not the concept itself." ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

gmeow:eqDeception013 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:eventTypeSelfDeception ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q1602343 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Wikidata 'self-deception' (Q1602343) — the process of denying or rationalising away the relevance, significance, or importance of opposing evidence and logical argument." ;
    gmeow:sssomFile "gmeow-deception.sssom.tsv" .

# AIF (Argument Interchange Format) is referenced in the solver layer
# (fnArgumentAcceptability) but not aligned via TermEquivalence because AIF
# lacks a stable, resolvable RDF namespace suitable for SSSOM rows.
