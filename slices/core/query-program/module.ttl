logic:consequent [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "freshOwner" ] ;
logic:exists [ a logic:Formula ;
logic:and [ a logic:Formula ;
logic:relation rdf:type ;
logic:argument [ logic:termIndex 0 ; logic:termVariable "freshOwner" ], [ logic:termIndex 1 ; logic:termIri gmeow:QueryRerankAnswer ] ],
[ a logic:Formula ;
