# SPDX-License-Identifier: CC-BY-4.0
#
# Worked example for the BRIDGES charter — the three ingestion bridges in one dataset,
# each the mnemomorphic put leg of a logic:Correspondence (GMEOW is the source, the
# external artifact the view, the lift is the up-projection put — never a get run
# backward). Each bridge run is a gmeow:Activity that retains its source as a
# logic:loadBearing math:parseSource witness, carries the process-layer in-band witness
# through logic:instantiatesSchema / logic:instantiatesPlan, ties its produced math:
# codomain back through gmeow:wasGeneratedBy, and carries its law-spine on a
# logic:Correspondence (reused verbatim — no math: shadow). Because no get (down-
# projection) leg is authored yet, no correspondence claims a verified section; each sits
# honestly at the LossyLens rung.
#
# What separates the three at that rung is WHAT THE WITNESS HOLDS, because a mnemomorphism
# claim is a claim about retention, not about intent:
#   * the R and proof sources are TEXT, so their witnesses retain the source verbatim
#     (math:retainedSource) and their correspondences may assert logic:mnemomorphic true —
#     each is climbable to section the moment a get leg lands;
#   * the ONNX source is a blob-scale BINARY, held by reference (math:sourceDigest) under
#     the blob-by-reference doctrine. A digest identifies the artifact; it does not retain
#     it, so that correspondence asserts logic:mnemomorphic FALSE and may never climb to a
#     section/retraction rung on this witness alone (see math:sourceDigest's definition).
# Each witness also enumerates, through math:unmappedConstruct, what its lift did not carry
# — the lossy lens's residue made queryable rather than merely declared.
#
# Exercises all six competency questions:
#   Q1 from which R script (at what fidelity) a model was lifted, what it lost, what routed to logic:
#   Q2 the tensor computation graph + parameter space an ONNX model lifted into
#   Q3 the proof dependency DAG + its decomposition into sub-goals and steps
#   Q4 which ingests hard-failed as unliftable, with what diagnostic (see the counter-example fixtures)
#   Q5 which bridge results are held as observations, by which activity and vantage
#   Q6 which bridges round-trip losslessly (rung) and which drop what (residue)
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://example.org/math/> .

# =========================================================================== #
# (1) The R bridge (Q1, Q5, Q6) — lm(mpg ~ wt + hp, data=mtcars)              #
# =========================================================================== #

ex:rRun a math:RIngestRun ;
    rdfs:label "Lifting an R lm() call into the statistical codomain"@x-gmeow-english ;
    math:parseSource ex:rSrcWitness ;
    logic:instantiatesSchema ex:rBridgeSchema ;
    logic:instantiatesPlan ex:rBridgePlan ;
    math:ingestCorrespondence ex:rCorr .

# The retained in-band witness: the R source held VERBATIM, marked load-bearing so the put
# leg can recover the formula/data/coefficient sub-fragment by projecting along the witness
# rather than reconstructing a plausible script (never an opaque droppable string). The two
# IO/plotting calls have no image in math:, so they are named as residue — which is what
# makes this lens's declared loss queryable instead of merely asserted by its rung.
ex:rSrcWitness a math:MathematicalObject ;
    rdfs:label "lm(mpg ~ wt + hp, data = mtcars)"@x-gmeow-english ;
    math:retainedSource """fit <- lm(mpg ~ wt + hp, data = mtcars)
tidy_coefficients <- summary(fit)$coefficients
plot(fit, which = 1)
write.csv(tidy_coefficients, "coefficients.csv")""" ;
    math:unmappedConstruct "r-call: plot(...)" , "r-call: write.csv(...)" ;
    logic:loadBearing true .

ex:rBridgeSchema a logic:ActionSchema .
ex:rBridgePlan a logic:Plan .

# The lift's law-spine: the fit is non-injective (IO/plotting drop), so the assertable
# rung is a lossy lens; the retained witness (mnemomorphic true) makes it climbable to
# section on the recoverable formula/data/coefficient sub-fragment once a get leg lands.
ex:rCorr a logic:Correspondence ;
    logic:preservationKind logic:ValidationOnly ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:LossyLens ;
    logic:hasDeterminacy logic:Vague ;
    logic:mnemomorphic true .

# The model formula (the ~ is a binder over indexed argument slots, never a string).
ex:mpgFormula a math:ModelFormula ;
    rdfs:label "mpg ~ wt + hp"@x-gmeow-english ;
    math:argumentSlot ex:respSlot , ex:wtSlot , ex:hpSlot .
ex:respSlot a math:ArgumentSlot ; math:slotIndex 0 ; math:slotExpression ex:mpgVar .
ex:wtSlot   a math:ArgumentSlot ; math:slotIndex 1 ; math:slotExpression ex:wtVar .
ex:hpSlot   a math:ArgumentSlot ; math:slotIndex 2 ; math:slotExpression ex:hpVar .
# Each model variable is an OCCURRENCE resolving to its own free-variable declaration —
# a regression formula's terms are free, not bound, so they need the declaration the
# math: expression grammar resolves them through (a bare math:VariableExpression with no
# math:variableOccurrence is math:UnscopedVariableOccurrence).
ex:mpgVar a math:VariableExpression ; math:variableOccurrence ex:mpgOccurrence .
ex:wtVar  a math:VariableExpression ; math:variableOccurrence ex:wtOccurrence .
ex:hpVar  a math:VariableExpression ; math:variableOccurrence ex:hpOccurrence .

ex:mpgOccurrence a math:VariableOccurrence ; math:declaredVariable ex:mpgDeclaration .
ex:wtOccurrence  a math:VariableOccurrence ; math:declaredVariable ex:wtDeclaration .
ex:hpOccurrence  a math:VariableOccurrence ; math:declaredVariable ex:hpDeclaration .

ex:mpgDeclaration a math:FreeVariableDeclaration ;
    rdfs:label "mpg — the response"@x-gmeow-english .
ex:wtDeclaration a math:FreeVariableDeclaration ;
    rdfs:label "wt — weight, a predictor"@x-gmeow-english .
ex:hpDeclaration a math:FreeVariableDeclaration ;
    rdfs:label "hp — horsepower, a predictor"@x-gmeow-english .

# The data, held BY REFERENCE (never inlined).
ex:mtcarsMatrix a math:DatasetMatrix ;
    rdfs:label "mtcars data frame (by reference)"@x-gmeow-english ;
    gmeow:wasGeneratedBy ex:rRun .

# The fitted model (the lifted codomain), specified by the formula and bound to the data.
ex:mtcarsFit a math:FittedModel ;
    math:modelFormula ex:mpgFormula ;
    math:fittedToData ex:mtcarsMatrix ;
    gmeow:wasGeneratedBy ex:rRun .

# The broom tidy triple → estimates; the augment triple → residuals.
ex:wtEstimate a math:Estimate ;
    math:estimatesEstimand ex:wtEffect ;
    math:estimatedParameter ex:betaWt ;
    math:estimateValue ex:betaWtValue ;
    math:estimator ex:ols ;
    gmeow:wasGeneratedBy ex:rRun .
ex:wtEffect a math:MathematicalObject .
ex:betaWt a math:MathematicalObject .
ex:betaWtValue a math:Quantity ; math:hasDimension math:dimensionless .
ex:ols a math:MathematicalObject .

ex:obs1Residual a math:Residual ;
    math:residualOf ex:mtcarsFit ;
    gmeow:wasGeneratedBy ex:rRun .

# The computation (the fitting algorithm) routes to logic: (the math:/logic: split).
ex:fitComputation a math:MathematicalExpression ;
    math:compilesToLogicFormula ex:fitLogicFormula ;
    math:logicLoweringPreservation logic:SoundUnderApproximation ;
    math:denotationKind math:denotesProposition .
# A well-formed atomic logic: AST node. logic:FormulaConstructorConstraint requires EXACTLY
# ONE constructor from {and, antecedent, exists, forall, iff, not, or, relation}, so a bare
# `a logic:Formula` is malformed — it selects none.
ex:fitLogicFormula a logic:Formula ;
    logic:relation ex:fitComputes ;
    logic:argument ex:fitLogicArg .
ex:fitComputes a logic:Type .
ex:fitLogicArg a logic:TermCarrier ;
    logic:termIndex 0 ;
    logic:termIri ex:fitComputation .

# The held claim (Q5): the fit summary as a vantage-grounded observation.
ex:rFitClaim a gmeow:Observation ;
    gmeow:observedFeature ex:mtcarsFit ;
    gmeow:observationResult ex:rFitSummary ;
    gmeow:vantage ex:rEngine ;
    gmeow:wasGeneratedBy ex:rRun .
ex:rFitSummary a math:MathematicalObject .
ex:rEngine a gmeow:Standpoint .

# =========================================================================== #
# (2) The ONNX bridge (Q2, Q6) — a model graph as a tensor computation graph  #
# =========================================================================== #

ex:onnxRun a math:ONNXIngestRun ;
    rdfs:label "Lifting an ONNX model graph into its self-structure"@x-gmeow-english ;
    math:parseSource ex:onnxSource ;
    logic:instantiatesSchema ex:onnxBridgeSchema ;
    logic:instantiatesPlan ex:onnxBridgePlan ;
    math:ingestCorrespondence ex:onnxCorr .
# A blob-scale BINARY source: the model is held BY REFERENCE through its content digest and
# never inlined (the blob-by-reference doctrine — inlining the weight payload would put in
# the graph exactly the bytes the residue below says did not cross). A digest identifies the
# artifact; it does not retain it, which is why ex:onnxCorr asserts logic:mnemomorphic false.
ex:onnxSource a math:MathematicalObject ;
    rdfs:label "model.onnx (opset 18, by reference)"@x-gmeow-english ;
    math:sourceDigest "7978a9f31743d3c2" ;
    math:unmappedConstruct "onnx-field: initializer raw_data (weight payload)" ,
        "onnx-field: metadata_props" ;
    logic:loadBearing true .
ex:onnxBridgeSchema a logic:ActionSchema .
ex:onnxBridgePlan a logic:Plan .

# The graph STRUCTURE lifts faithfully from a crisp source, but the witness only REFERENCES
# the model (a digest, not the bytes), so the source is not recoverable by projecting along
# it: mnemomorphic is false, and this correspondence may not climb to a section/retraction
# rung. That is the honest reading of math:sourceDigest, not a weaker claim about ONNX.
ex:onnxCorr a logic:Correspondence ;
    logic:preservationKind logic:ValidationOnly ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:LossyLens ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic false .

# The lifted codomain: the tensor computation graph (the learning-charter self-structure object).
ex:selfGraph a math:TensorComputationGraph ;
    math:architectureOf ex:onnxNet ;
    math:computationNode ex:matmulNode ;
    gmeow:wasGeneratedBy ex:onnxRun .
ex:matmulNode a math:ApplicationExpression ;
    math:operator math:matrixProduct ;
    math:tensorOperation math:matrixProduct ;
    math:argumentSlot ex:onnxSlot0 , ex:onnxSlot1 .
ex:onnxSlot0 a math:ArgumentSlot ; math:slotIndex 0 ; math:slotExpression ex:onnxInExpr .
ex:onnxSlot1 a math:ArgumentSlot ; math:slotIndex 1 ; math:slotExpression ex:onnxWExpr .
ex:onnxInExpr a math:MathematicalExpression .
ex:onnxWExpr a math:MathematicalExpression .
ex:onnxNet a math:LearnedModel .

ex:onnxWeight a math:WeightTensor ;
    math:weightOf ex:onnxLayer ;
    math:inParameterSpace ex:onnxParams ;
    gmeow:wasGeneratedBy ex:onnxRun .
ex:onnxLayer a math:NeuralLayer .
ex:onnxParams a math:ParameterSpace ;
    math:parameterSpaceOf ex:onnxNet ;
    math:underlyingSet ex:onnxParamSet ;
    math:structureOperation ex:onnxParamAdd ;
    math:satisfiesAxiom ex:onnxParamAxiom .
ex:onnxParamSet a math:Set .
ex:onnxParamAdd a math:Operation .
ex:onnxParamAxiom a math:Axiom .

# =========================================================================== #
# (3) The proof-as-process bridge (Q3, Q5, Q6) — a proof dependency DAG       #
# =========================================================================== #

ex:proofRun a math:ProofIngestRun ;
    rdfs:label "Lifting a proof-assistant dependency DAG as a process"@x-gmeow-english ;
    math:parseSource ex:proofSource ;
    logic:instantiatesSchema ex:proofBridgeSchema ;
    logic:instantiatesPlan ex:proofBridgePlan ;
    math:ingestCorrespondence ex:proofCorr .
# A TEXT source, retained verbatim: the declaration lines the dependency DAG was read from.
# The tactic block that discharged each step has no image in the lifted DAG, so it is named
# as residue rather than silently dropped.
ex:proofSource a math:MathematicalObject ;
    rdfs:label "mathlib declaration graph for the Pythagorean theorem"@x-gmeow-english ;
    math:retainedSource """theorem pythagoras (t : RightTriangle) : t.c ^ 2 = t.a ^ 2 + t.b ^ 2
axiom euclid_parallel : ...
lemma similar_triangles (t : RightTriangle) : ratio t.a t.c = ratio t.h t.a""" ;
    math:unmappedConstruct "lean-block: tactic proof body" ;
    logic:loadBearing true .
ex:proofBridgeSchema a logic:ActionSchema .
ex:proofBridgePlan a logic:Plan .

ex:proofCorr a logic:Correspondence ;
    logic:preservationKind logic:ValidationOnly ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:LossyLens ;
    logic:hasDeterminacy logic:Crisp ;
    logic:mnemomorphic true .

# The lifted codomain: the dependency graph and the proof it underlies.
ex:pythagorasDAG a math:ProofDependencyGraph ;
    rdfs:label "Pythagorean theorem dependency DAG"@x-gmeow-english ;
    math:dependencyGraphOf ex:pythagorasProof ;
    gmeow:wasGeneratedBy ex:proofRun .
ex:pythagorasProof a math:Proof ;
    math:provesStatement ex:pythagorasStatement ;
    math:dependsOnAxiom ex:euclidParallelAxiom ;
    math:proofStep ex:similarTrianglesStep ;
    math:provesGoal ex:pythagorasGoal ;
    gmeow:wasGeneratedBy ex:proofRun .
ex:pythagorasStatement a math:MathematicalObject .
ex:euclidParallelAxiom a math:Axiom .
ex:similarTrianglesStep a math:ProofStep ;
    math:hasPremise ex:similarTrianglesLemma ;
    math:hasConclusion ex:ratioEquality ;
    math:usesInferenceRule ex:ruleSimilarityTransfer ;
    math:dependsOnAxiom ex:euclidParallelAxiom ;
    math:provesGoal ex:similarTrianglesGoal .
# The step-level licence: which rule fired here, distinct from the proof's overall
# math:usesProofMethod strategy.
ex:ruleSimilarityTransfer a math:Operation .
ex:similarTrianglesLemma a math:MathematicalObject .
ex:ratioEquality a math:MathematicalObject .

# Each lemma is a logic:GoalExpression sub-goal (kind logic:AchievementGoal — the target
# first obtains), reached through math:provesGoal. The kind is a VALUE, not a class.
ex:pythagorasGoal a logic:GoalExpression ;
    logic:goalExpressionKind logic:AchievementGoal ;
    logic:boundSituationType ex:pythagorasProvedSituation .
ex:similarTrianglesGoal a logic:GoalExpression ;
    logic:goalExpressionKind logic:AchievementGoal ;
    logic:boundSituationType ex:similarTrianglesProvedSituation .
ex:pythagorasProvedSituation a logic:Situation .
ex:similarTrianglesProvedSituation a logic:Situation .

# The QED verdict is a RESULT OBJECT (not an observation), grounded BY a separate
# observation whose vantage is the proof checker (Q5). Result / claim kept distinct.
ex:qedResult a math:FormalVerificationResult ;
    rdfs:label "Pythagorean theorem: verified"@x-gmeow-english ;
    gmeow:wasGeneratedBy ex:proofRun .
ex:qedObservation a gmeow:Observation ;
    gmeow:observedFeature ex:pythagorasProof ;
    gmeow:observationResult ex:qedResult ;
    gmeow:vantage ex:leanChecker ;
    gmeow:wasGeneratedBy ex:proofRun .
ex:leanChecker a gmeow:Standpoint .
