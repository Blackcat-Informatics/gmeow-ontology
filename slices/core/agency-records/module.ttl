    gmeow:avoidWhen "Avoid inferring corrupt artifact bytes, failed invocation or permission to execute a weaker fallback."@x-gmeow-english ;
    gmeow:howToUse "Keep the rejected receipt identity, source rule and actual rejection evidence separately from any later recomputation."@x-gmeow-english ;
    skos:scopeNote "A rejection report neither validates cache state nor triggers regeneration or tool execution."@x-gmeow-english ;
    skos:example "Classify this cache receipt rejection trace: ex:cacheReceiptRejected gmeow:eventType gmeow:eventTypeTraceCacheReceiptRejected ."@x-gmeow-english .


gmeow:eventTypeTraceBackgroundTerminalRecovered
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "background terminal recovery trace"@x-gmeow-english ;
    skos:definition "The source reports recovery of a background terminal under its runtime convention."@x-gmeow-english ;
    gmeow:useWhen "Use for an explicit terminal-recovery occurrence, preserving the actual terminal or process identity when known."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid equating recovered with restarted, successfully exited, completed work or a recovered model invocation."@x-gmeow-english ;
    gmeow:howToUse "Retain the source recovery evidence and any supplied session context without creating a new process identity."@x-gmeow-english ;
    skos:scopeNote "The marker starts, stops and recovers no terminal or model service."@x-gmeow-english ;
    skos:example "Classify this background terminal recovery trace: ex:backgroundTerminalRecovered gmeow:eventType gmeow:eventTypeTraceBackgroundTerminalRecovered ."@x-gmeow-english .


gmeow:eventTypeTraceReplyGateFired
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "reply gate firing trace"@x-gmeow-english ;
    skos:definition "The runtime reports that a gate holding back a reply fired."@x-gmeow-english ;
    gmeow:useWhen "Use for the explicit gate occurrence, retaining the source meaning of fired and its actual disposition when supplied."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring that a reply was released, blocked, approved or delivered solely from the word fired."@x-gmeow-english ;
    gmeow:howToUse "Classify the gate occurrence and retain the actual reply and source contract without imposing a universal gate policy."@x-gmeow-english ;
    skos:scopeNote "The event type is not an execution permit or a substitute for an approval record."@x-gmeow-english ;
    skos:example "Classify this reply gate firing trace: ex:replyGateFired gmeow:eventType gmeow:eventTypeTraceReplyGateFired ."@x-gmeow-english .


gmeow:eventTypeTraceDreamPhaseRoundCapReached
    a gmeow:EventType ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "dream phase round cap trace"@x-gmeow-english ;
    skos:definition "The runtime reports reaching its own round cap within a source-designated dream phase."@x-gmeow-english ;
    gmeow:useWhen "Use when the source explicitly reports the cap being reached, retaining the actual phase and configured bound when supplied."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inferring a numeric cap, a DreamReport recollection, successful completion or a required stop from this marker."@x-gmeow-english ;
    gmeow:howToUse "Keep the source runtime phase context separate from dream content and classify only the reported cap occurrence."@x-gmeow-english ;
    skos:scopeNote "This shared runtime-report value creates no core dependency on the dreaming extension and executes no phase controller."@x-gmeow-english ;
    skos:example "Classify this dream phase round cap trace: ex:dreamPhaseRoundCapReached gmeow:eventType gmeow:eventTypeTraceDreamPhaseRoundCapReached ."@x-gmeow-english .

# Source-attributed rationale and operation completion.

gmeow:receiptOperationComplete
    a logic:DatatypeProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "receipt operation complete as reported"@x-gmeow-english ;
    skos:definition "The producer-reported boolean that the operation represented by an ArtifactOperationReceipt completed or remained incomplete. It concerns that operation, independently of artifact content completeness, invocation outcome, goal satisfaction, receipt-document coverage and verification."@x-gmeow-english ;
    gmeow:useWhen "Use only for an explicitly supplied operation-completion bit on the actual artifact-operation receipt occurrence."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid defaulting an absent bit to false or true, deriving it from errors or outcomes, or moving it onto the artifact or a proof receipt."@x-gmeow-english ;
    gmeow:howToUse "Keep the supplied xsd:boolean on ArtifactOperationReceipt with its actual receiptOperation, receiptArtifact and containing attempt or ToolCall. Attribute the exact boolean statement to its reporting source; retain readArtifact for an actual read."@x-gmeow-english ;
    skos:scopeNote "The field is optional and nonfunctional: missing remains unknown and differently attributed true/false reports may coexist. A complete reported write can leave an unfinished artifact; neither value establishes success, rollback, read-back proof or complete receipt contents."@x-gmeow-english ;
    skos:example "An operation report keeps the supplied bit: ex:receipt gmeow:receiptOperationComplete true ."@x-gmeow-english ;
    logic:domain gmeow:ArtifactOperationReceipt ;
    logic:range xsd:boolean .

[ a logic:ClosureEntry ; logic:closureKey "https://blackcatinformatics.ca/gmeow/receiptOperationComplete" ; logic:closureValue logic:ClosedWorldClosure ] .

# Attributed moods and demand interactions.

gmeow:DemandKind
    a logic:AbstractIndividualType, logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Demand Kind"@x-gmeow-english ;
    skos:definition "An open vocabulary of interactions or provisions wanted by the bearer of a Desire."@x-gmeow-english ;
    gmeow:useWhen "Use to classify what is demanded while retaining the actual Desire and its Goal."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid treating a kind as an order, an obligation or an answering occurrence."@x-gmeow-english ;
    gmeow:howToUse "Define additional values individually and select them through demandKind on the wanting mode."@x-gmeow-english ;
    skos:scopeNote "The inventory is open and applies beyond simulated creatures; it creates no Creature class."@x-gmeow-english ;
    skos:example "Extend wanted kinds: ex:demandKindCompany a gmeow:DemandKind ."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:demandKind
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "demand kind"@x-gmeow-english ;
    skos:definition "The source-classified kind of interaction or provision wanted by an actual Desire’s bearer."@x-gmeow-english ;
    gmeow:useWhen "Use when the source identifies what a particular agent wants."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid attaching this field to a demand message, a response Event or the creature itself."@x-gmeow-english ;
    gmeow:howToUse "Keep the Desire’s actual intentBearer and intentionGoal, plus the exact kind claim’s reader and source."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional; a composite request may have several kinds without implying any answer or commitment."@x-gmeow-english ;
    skos:example "Classify the wanting: ex:cuddleWish gmeow:demandKind gmeow:demandKindCuddles ."@x-gmeow-english ;
    logic:domain gmeow:Desire ;
    logic:range gmeow:DemandKind .

gmeow:DemandResponse
    a logic:AbstractIndividualType, logic:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "Demand Response Kind"@x-gmeow-english ;
    skos:definition "An open vocabulary describing how an actual answering occurrence responded to a Desire."@x-gmeow-english ;
    gmeow:useWhen "Use to distinguish cuddling, offering a lap and petting as reported responses."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid confusing a response kind with the answer artifact or a successful satisfaction verdict."@x-gmeow-english ;
    gmeow:howToUse "Add source-defined response values without a closed enumeration; bind each answering Event to its exact Desire."@x-gmeow-english ;
    skos:scopeNote "Response kinds are independent of demand kinds; a demand for play need not receive play."@x-gmeow-english ;
    skos:example "Extend answer kinds: ex:responseKindSpokenReply a gmeow:DemandResponse ."@x-gmeow-english ;
    logic:subClassOf logic:QualityValue .

gmeow:demandResponse
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "demand response kind"@x-gmeow-english ;
    skos:definition "How a source reports that an actual Event answered the exact Desire named by answersDemand."@x-gmeow-english ;
    gmeow:useWhen "Use on the actual answering occurrence when its response kind is supplied."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid putting the response code on the Desire, report document or desired Goal."@x-gmeow-english ;
    gmeow:howToUse "Supply answersDemand with the actual Desire and retain the exact response claim’s source and standpoint."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional; reported response does not entail acceptance, pleasure, consent or goal satisfaction."@x-gmeow-english ;
    skos:example "Describe the answer: ex:cuddleAnswer gmeow:demandResponse gmeow:demandResponseCuddle ; gmeow:answersDemand ex:cuddleWish ."@x-gmeow-english ;
    logic:domain gmeow:Event ;
    logic:range gmeow:DemandResponse .

gmeow:answersDemand
    a logic:ObjectProperty ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxRBox ;
    rdfs:label "answers demand"@x-gmeow-english ;
    skos:definition "The exact actual Desire to which an answering Event responds, independently of whether that Desire was satisfied."@x-gmeow-english ;
    gmeow:useWhen "Use to preserve which wanting a response addressed when several similar demands exist."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid replacing this link with a matching category, an object-request revision or an inferred motive."@x-gmeow-english ;
    gmeow:howToUse "Identify the existing Desire with its actual bearer and Goal; retain supplied response evidence without fabricating a resolution record."@x-gmeow-english ;
    skos:scopeNote "Nonfunctional; an Event may answer several explicitly identified desires, with no latest-demand rule."@x-gmeow-english ;
    skos:example "Bind the exact wanting: ex:lapAnswer gmeow:answersDemand ex:lapWish ."@x-gmeow-english ;
    logic:domain gmeow:Event ;
    logic:range gmeow:Desire .

gmeow:demandKindAnnouncement
    a gmeow:DemandKind ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/agency-records> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    rdfs:label "announcement demand"@x-gmeow-english ;
    skos:definition "A Desire for an announcement to be made, with its content and intended speaker left to the source."@x-gmeow-english ;
    gmeow:useWhen "Use when the wanted interaction is explicitly an announcement."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid inventing announcement wording, an audience or who must speak."@x-gmeow-english ;
    gmeow:howToUse "Select on the actual Desire and retain any supplied announcement content separately."@x-gmeow-english ;
    skos:scopeNote "Wanting an announcement is neither an utterance occurrence nor proof of delivery."@x-gmeow-english ;
    skos:example "Record the announcement wish: ex:newsWish gmeow:demandKind gmeow:demandKindAnnouncement ."@x-gmeow-english .

