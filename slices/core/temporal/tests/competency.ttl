#
# Declarative competency question for the temporal slice (crates/slicetest),
# migrated from test_competency_temporal_provenance_clocks_query. TBox
# subset over the asserted merged ontology (contains-check). No Gap-1 universal.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/temporal/tests/> .

ex:cqTemporalProvenanceClocks a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "queries/competency/temporal-provenance-clocks.rq" ;
    gmeow:cqRationale "GMEOW must model the temporal-provenance clocks: validFrom, validUntil, assertedAt, recordedNoLaterThan." ;
    gmeow:cqResultShape ex:cqTemporalProvenanceClocksShape ;
    gmeow:cqExpectRow ex:tcValidFrom, ex:tcValidUntil, ex:tcAssertedAt, ex:tcRecordedNoLaterThan .

ex:cqTemporalProvenanceClocksShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "clock" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsContains .

ex:tcValidFrom a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "clock" ; gmeow:cellValueIri gmeow:validFrom ] .
ex:tcValidUntil a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "clock" ; gmeow:cellValueIri gmeow:validUntil ] .
ex:tcAssertedAt a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "clock" ; gmeow:cellValueIri gmeow:assertedAt ] .
ex:tcRecordedNoLaterThan a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "clock" ; gmeow:cellValueIri gmeow:recordedNoLaterThan ] .

# The week cycle: gmeow:DayOfWeek is a CLOSED value vocabulary (ISO 8601 closes it), so
# the class and all seven weekday individuals must be answerable from the asserted
# ontology alone. The closure is AUTHORED — gmeow:DayOfWeek logic:equivalentClass
# [ logic:oneOf ( … seven days … ) ] in slices/core/temporal/module.ttl — so the shape
# is logic:RowsExact, not logic:RowsContains: an eighth day-of-week individual added
# anywhere is a violation of the authored enumeration, and this question is the test
# surface that says so. Containment would only witness that the seven are PRESENT;
# exact membership witnesses that they are ALL there is.
ex:cqTemporalWeekCycleValues a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/temporal/queries/competency/week-cycle-values.rq" ;
    gmeow:cqRationale "A weekday is calendar STRUCTURE, not a located span: gmeow:DayOfWeek names a recurring position in the seven-day week cycle and its seven ISO-8601 individuals are the complete, closed membership. Both the opening-hours surface (gmeow:openingDay) and the calendar slice's recurrence machinery read these seven values, so the vocabulary lives beside gmeow:CalendarSystem and gmeow:PeriodType in temporal and must be queryable as a whole." ;
    gmeow:cqResultShape ex:cqTemporalWeekCycleValuesShape ;
    gmeow:cqExpectRow
        ex:twcMonday , ex:twcTuesday , ex:twcWednesday , ex:twcThursday ,
        ex:twcFriday , ex:twcSaturday , ex:twcSunday .

ex:cqTemporalWeekCycleValuesShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "dayClass" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "day" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:twcMonday a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dayClass" ; gmeow:cellValueIri gmeow:DayOfWeek ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "day" ; gmeow:cellValueIri gmeow:dayMonday ] .
ex:twcTuesday a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dayClass" ; gmeow:cellValueIri gmeow:DayOfWeek ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "day" ; gmeow:cellValueIri gmeow:dayTuesday ] .
ex:twcWednesday a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dayClass" ; gmeow:cellValueIri gmeow:DayOfWeek ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "day" ; gmeow:cellValueIri gmeow:dayWednesday ] .
ex:twcThursday a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dayClass" ; gmeow:cellValueIri gmeow:DayOfWeek ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "day" ; gmeow:cellValueIri gmeow:dayThursday ] .
ex:twcFriday a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dayClass" ; gmeow:cellValueIri gmeow:DayOfWeek ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "day" ; gmeow:cellValueIri gmeow:dayFriday ] .
ex:twcSaturday a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dayClass" ; gmeow:cellValueIri gmeow:DayOfWeek ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "day" ; gmeow:cellValueIri gmeow:daySaturday ] .
ex:twcSunday a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "dayClass" ; gmeow:cellValueIri gmeow:DayOfWeek ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "day" ; gmeow:cellValueIri gmeow:daySunday ] .
