    skos:example "Distinct source coordinates: ex:left gmeow:entryOrdinal \"0\"^^xsd:nonNegativeInteger ; gmeow:rerankInputPosition \"3\"^^xsd:nonNegativeInteger . ex:right gmeow:entryOrdinal \"1\"^^xsd:nonNegativeInteger ; gmeow:rerankInputPosition \"7\"^^xsd:nonNegativeInteger ."@x-gmeow-english ;
