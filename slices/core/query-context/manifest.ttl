@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/query-context>
    a gmeow:Slice ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-context> ;
    gmeow:sliceTier gmeow:tierCore ;
    rdfs:label "query context"@x-gmeow-english ;
    skos:definition "Query-result loss records and explicitly interpreted frame-composition descriptors, keeping result axes and context semantics distinct."@x-gmeow-english ;
    dcterms:title "GMEOW Query Context Module"@x-gmeow-english ;
    gmeow:sliceConsumer "Governed query stores and recall adapters retaining unavailable-input reports and explicit frame-composition semantics without silent capability degradation."@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceDependsOn <https://blackcatinformatics.ca/gmeow/slices/logic>,
        <https://blackcatinformatics.ca/gmeow/slices/kernel>,
        <https://blackcatinformatics.ca/gmeow/slices/standpoint>,
        <https://blackcatinformatics.ca/gmeow/slices/record-metadata>,
        <https://blackcatinformatics.ca/gmeow/slices/sources>,
        <https://blackcatinformatics.ca/gmeow/slices/provenance> .
