    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/preference> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "The gmeow:orderEdge atom ('order edge') of gmeow:RestrictionCoherenceConstraint (G2, sharpens-refinement coherence): relates ?os, ?es."@x-gmeow-english ; logic:relation gmeow:orderEdge ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "os" ] , [ logic:termIndex 1 ; logic:termVariable "es" ] .
