# Counter-example: a denotesLogicFormula denotation whose target is a logic:Type,
# not a logic:Formula (fires lang:DenotationKindMismatch / shacl.SPARQLConstraintComponent).

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <http://example.org/lang/> .

ex:english a lang:SignSystem .
ex:form a lang:WordForm ; lang:inSignSystem ex:english .
ex:t a logic:Type .

ex:d a lang:Denotation ;
    lang:denotedForm ex:form ;
    lang:denotationKind lang:denotesLogicFormula ;
    lang:denotationTarget ex:t ;
    lang:denotationContext ex:ctx ;
    logic:preservationKind logic:ExactPreservation .
