gmeow:mapOdrlOffer a gmeow:ProjectionMapping ;
    rdfs:label "License → odrl:Offer (+ assigner, target)"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "lic" ;
        gmeow:atom (
            [ gmeow:subjectVar "lic" ; gmeow:predicate rdf:type ; gmeow:objectValue gmeow:License ]
            [ gmeow:subjectVar "lic" ; gmeow:predicate gmeow:licensor ; gmeow:objectVar "licensor" ; gmeow:optional true ]
            [ gmeow:subjectVar "lic" ; gmeow:predicate gmeow:licensedWork ; gmeow:objectVar "lwork" ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:relation "<=" ;
        gmeow:lossyDrop "the licence's gmeow:licenseFamily / validFrom / validUntil / spdxLicenseId are dropped; only the ODRL offer skeleton survives" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "lic" ; gmeow:tPred rdf:type ; gmeow:tObjValue odrl:Offer ]
            [ gmeow:tSubj "lic" ; gmeow:tPred odrl:assigner ; gmeow:tObj "licensor" ]
            [ gmeow:tSubj "lic" ; gmeow:tPred odrl:target ; gmeow:tObj "lwork" ] ) ] .

# --- ODRL constraint algebra + deontic logic -------------------------------- #

gmeow:mapOdrlConstraint a gmeow:ProjectionMapping ;
    rdfs:label "Atomic constraint on a rule → odrl:constraint"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "r" ;
        gmeow:atom (
            [ gmeow:subjectVar "r" ; gmeow:predicate gmeow:ruleConstraint ; gmeow:objectVar "c" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:leftOperand ; gmeow:objectVar "lo" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:constraintOperator ; gmeow:objectVar "op" ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:rightOperand ; gmeow:objectVar "rv" ; gmeow:optional true ]
            [ gmeow:subjectVar "c" ; gmeow:predicate gmeow:rightOperandReference ; gmeow:objectVar "rr" ; gmeow:optional true ] ) ] ;
    gmeow:hasBinding [
        gmeow:profile "odrl" ; gmeow:relation "<=" ;
        gmeow:lossyDrop "ODRL logical-constraint boolean operators (and/or/xone) are not emitted; atomic-constraint shells and right operands project here, while left operands and comparison operators are rewritten by the exact value-table cells below" ;
        gmeow:templateAtoms (
            [ gmeow:tSubj "r" ; gmeow:tPred odrl:constraint ; gmeow:tObj "c" ]
            [ gmeow:tSubj "c" ; gmeow:tPred rdf:type ; gmeow:tObjValue odrl:Constraint ]
            [ gmeow:tSubj "c" ; gmeow:tPred odrl:rightOperand ; gmeow:tObj "rv" ]
            [ gmeow:tSubj "c" ; gmeow:tPred odrl:rightOperandReference ; gmeow:tObj "rr" ] ) ] .

gmeow:mapOdrlLeftOperandAbsolutePosition a gmeow:ProjectionMapping ;
