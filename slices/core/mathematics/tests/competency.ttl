#
# Declarative competency questions for the mathematics slice (crates/slicetest): the
# five bedrock questions the charter requires the term surface to answer. Each query
# runs over the merged ontology unioned with the shared fixture (gmeow:cqDataFile),
# and its expected rows are pinned exactly (logic:RowsExact). Boolean flags are
# projected as their string form (STR(...)) so the expected cell is a plain literal.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix wd:    <http://www.wikidata.org/entity/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/mathematics/tests/> .
@prefix exf:   <http://example.org/math/> .

# === Q1 — number system and exactness ====================================== #

ex:cqNumberSystemAndExactness a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/mathematics/queries/competency/number-system-and-exactness.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Each situated number reports the math:NumberSystem it belongs to and its exactness; over the fixture the answer is exactly {half → ℚ (exact), negFive → ℤ (exact)}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqNumberSystemShape ;
    gmeow:cqExpectRow ex:rowHalf , ex:rowNegFive .

ex:cqNumberSystemShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "number" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "system" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "exact" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowHalf a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "number" ; gmeow:cellValueIri exf:half ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "system" ; gmeow:cellValueIri math:rationalNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "exact" ; gmeow:cellValueLiteral "true" ] .

ex:rowNegFive a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "number" ; gmeow:cellValueIri exf:negFive ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "system" ; gmeow:cellValueIri math:integers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "exact" ; gmeow:cellValueLiteral "true" ] .

# === Q2 — set extent and condition ========================================= #

ex:cqSetExtentAndCondition a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/mathematics/queries/competency/set-extent-and-condition.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "An intensional math:SetBuilderExpression reports its math:memberCondition as the logic: formula that denotes it; over the fixture the answer is exactly {evenNumbers → evenFormula}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqSetExtentShape ;
    gmeow:cqExpectRow ex:rowEvenNumbers .

ex:cqSetExtentShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "set" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "condition" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowEvenNumbers a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "set" ; gmeow:cellValueIri exf:evenNumbers ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "condition" ; gmeow:cellValueIri exf:evenFormula ] .

# === Q3 — function domain, codomain, image, and inj/surj/bij ================ #

ex:cqFunctionFraming a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/mathematics/queries/competency/function-domain-codomain-image.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A function reports its domain, codomain, image, and its declared injective/surjective/bijective flags; over the fixture the answer is exactly the single function successor (ℕ → ℕ, image positives, injective, not surjective, not bijective)." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqFunctionShape ;
    gmeow:cqExpectRow ex:rowSuccessor .

ex:cqFunctionShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "function" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "domain" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "codomain" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "image" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "injective" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ,
        [ logic:columnVariable "surjective" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ,
        [ logic:columnVariable "bijective" ; logic:columnTermKind logic:TermKindLiteral ; logic:columnBinding logic:BindingRequired ; logic:columnDatatype xsd:string ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowSuccessor a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "function" ; gmeow:cellValueIri exf:successor ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "domain" ; gmeow:cellValueIri exf:naturalsSet ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "codomain" ; gmeow:cellValueIri exf:naturalsSet ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "image" ; gmeow:cellValueIri exf:positivesSet ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "injective" ; gmeow:cellValueLiteral "true" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "surjective" ; gmeow:cellValueLiteral "false" ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "bijective" ; gmeow:cellValueLiteral "false" ] .

# === Q4 — set cardinality ================================================== #

ex:cqSetCardinality a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/mathematics/queries/competency/set-cardinality.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "Each set reports its cardinality; over the fixture the answer is exactly {primesUnderTen → finite, allNaturals → ℵ₀}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqCardinalityShape ;
    gmeow:cqExpectRow ex:rowPrimes , ex:rowAllNaturals .

ex:cqCardinalityShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "set" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "cardinality" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowPrimes a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "set" ; gmeow:cellValueIri exf:primesUnderTen ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "cardinality" ; gmeow:cellValueIri math:cardinalityFinite ] .

ex:rowAllNaturals a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "set" ; gmeow:cellValueIri exf:allNaturals ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "cardinality" ; gmeow:cellValueIri math:alephNull ] .

# === Q5 — named constants and their anchors ================================ #

ex:cqNamedConstantsAndAnchors a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/core/mathematics/queries/competency/named-constants-and-anchors.rq" ;
    gmeow:cqDataFile "tests/fixtures/bedrock.ttl" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A named constant reports the external anchor reached through its gmeow:TermEquivalence alignment; over the fixture the answer is exactly {math:pi → wd:Q167}." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqConstantsShape ;
    gmeow:cqExpectRow ex:rowPiAnchor .

ex:cqConstantsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "constant" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "anchor" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:rowPiAnchor a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "constant" ; gmeow:cellValueIri math:pi ] ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "anchor" ; gmeow:cellValueIri wd:Q167 ] .
