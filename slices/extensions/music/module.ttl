    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    rdfs:label "sitar"@x-gmeow-english ;
    skos:definition "A plucked stringed instrument used in Hindustani classical music."@x-gmeow-english ;
