# --- Algebraic-structure classes → Wikidata (concept identity) ------------- #
# Each math: structure class denotes the same concept as its Wikidata item — a
# clean 1:1 identity (the class IS the concept "group", "ring", …), so
# skos:exactMatch at confidence 1.0. All QIDs curl-validated July 2026.

gmeow:eqMathAlgebraicStructure a gmeow:TermEquivalence ;
    gmeow:alignSubject math:AlgebraicStructure ;
    gmeow:alignPredicate skos:exactMatch ;
    gmeow:alignObject wd:Q205464 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:objectLabel "algebraic structure" ;
    gmeow:comment "math:AlgebraicStructure is a set equipped with operations satisfying axioms; wd:Q205464 (algebraic structure) is the same concept. Identity, so skos:exactMatch." ;
    gmeow:sssomFile "gmeow-wikidata.sssom.tsv" .

