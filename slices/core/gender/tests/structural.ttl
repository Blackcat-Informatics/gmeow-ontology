# --- 3d. hasGenderIdentity is NOT functional (MUST-NOT) ----------------------
ex:saHasGenderIdentityNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:hasGenderIdentity a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:hasGenderIdentity MUST NOT be functional — co-equal facets coexist (bigender/genderfluid). Mirrors test_value_properties_are_functional_facets_nonfunctional (negative half, hasGenderIdentity)." .

