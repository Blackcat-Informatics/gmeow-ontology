.stage/perf-logic-finish-merged-pipeline/raw/issue1757-current.json:340:      "viewerDidAuthor": true
.stage/perf-logic-finish-merged-pipeline/raw/issue1757-current.json:341:    },
.stage/perf-logic-finish-merged-pipeline/raw/issue1757-current.json:342:    {
.stage/perf-logic-finish-merged-pipeline/raw/issue1757-current.json:343:      "id": "IC_kwDOSwdn1s8AAAABWSm4oA",
.stage/perf-logic-finish-merged-pipeline/raw/issue1757-current.json:344:      "author": {
