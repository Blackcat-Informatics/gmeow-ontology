# Term equivalences for the classes domain — GMEOW authoring source.
# Compiled to mappings/gmeow-classes.sssom.tsv by `gmeow compile-mappings`.

gmeow:mapsetClasses a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/classes" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Canonical GMEOW class alignments to the surface vocabularies in the slice (the superset layer). schema.org is reference-only (linked, never imported)." .

gmeow:eqClasses001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Person ;
    gmeow:alignPredicate owl:equivalentClass ;
    gmeow:alignObject schema:Person ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 1.0 ;
    gmeow:comment "person" ;
    gmeow:sssomFile "gmeow-classes.sssom.tsv" .

gmeow:eqClasses002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Person ;
