@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix vc: <https://www.w3.org/2018/credentials#> .
@prefix did: <https://www.w3.org/ns/did#> .

# Term equivalences for the cross-cutting attestation layer — GMEOW authoring source.
# Compiled to mappings/gmeow-attestation.sssom.tsv by `gmeow compile-mappings`.
#
# REFUSALS / LOOSE MAPPINGS (documented in setComment):
# - in-toto / SLSA / DSSE: no stable public RDF vocabulary exists; mappings are
#   to conceptual types and are marked loose (skos:relatedMatch).
# - Sigstore / Rekor: no official RDF vocabulary; mapped loosely to Rekor entry
#   concepts.
# - SCITT: no public RDF vocabulary at time of writing; deferred.
# - C2PA: no RDF vocabulary; deferred.
# - RATS / EAT: no RDF vocabulary; deferred.
# - CAIP-2 / CAIP-10 / EIP-191 / EIP-712 / did:pkh: these are identifier schemes,
#   not RDF vocabularies; aligned as skos:closeMatch on identifier properties.
# - nanopublications: trusty URI pattern aligned loosely.

gmeow:mapsetAttestation a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/attestation" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Cross-cutting attestation alignments. PROV-O is the strongest RDF alignment (Activity, Entity, wasAttributedTo). W3C VC/DID is partially aligned where the RDF vocabulary is stable. Supply-chain formats (in-toto, SLSA, DSSE, Sigstore, SCITT, C2PA, RATS/EAT) and blockchain identifiers (CAIP, EIP) have no canonical RDF vocabularies; mappings are loose or refused and documented here." ;
    gmeow:setTrailer "# Loose / refused mappings (no canonical RDF vocabulary available):\n# gmeow:AttestationArtifact\tskos:relatedMatch\tin-toto:Statement\tsemapv:ManualMappingCuration\t0.5\tno stable in-toto RDF vocabulary\n# gmeow:AttestationArtifact\tskos:relatedMatch\tslsa:Provenance\tsemapv:ManualMappingCuration\t0.5\tno stable SLSA RDF vocabulary\n# gmeow:AttestationArtifact\tskos:relatedMatch\tdsse:Envelope\tsemapv:ManualMappingCuration\t0.5\tno stable DSSE RDF vocabulary\n# gmeow:TransparencyLogEntry\tskos:relatedMatch\trekor:Entry\tsemapv:ManualMappingCuration\t0.5\tno stable Rekor RDF vocabulary\n# gmeow:Attestation\tskos:relatedMatch\tscitt:SignedStatement\tsemapv:ManualMappingCuration\t0.5\tno public SCITT RDF vocabulary at time of writing\n# gmeow:AttestationArtifact\tskos:relatedMatch\tc2pa:Manifest\tsemapv:ManualMappingCuration\t0.5\tno C2PA RDF vocabulary\n# gmeow:AttestationArtifact\tskos:relatedMatch\trats:Evidence\tsemapv:ManualMappingCuration\t0.5\tno RATS/EAT RDF vocabulary\n# gmeow:AttestationArtifact\tskos:relatedMatch\tnanopub:Nanopublication\tsemapv:ManualMappingCuration\t0.5\tloose — nanopub RDF exists but the signed-graph pattern is implementation-specific\n# gmeow:BlockchainAccount\tskos:closeMatch\tdid:pkh\tsemapv:ManualMappingCuration\t0.7\tCAIP-10 / did:pkh alignment — identifier scheme, not RDF class" .

# --------------------------------------------------------------------------- #
# PROV-O
# --------------------------------------------------------------------------- #

gmeow:Attestation skos:closeMatch prov:Entity {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "An attestation is a kind of provenance entity — information object that participates in an activity and may be attributed to an agent"
|} .

gmeow:VerificationActivity skos:closeMatch prov:Activity {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9
|} .

gmeow:AttestationArtifact skos:closeMatch prov:Entity {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "An attestation artifact is a provenance entity"
|} .

gmeow:attester skos:closeMatch prov:wasAttributedTo {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "The attester is the agent to whom the attestation is attributed; directionality differs (attester is a direct property, wasAttributedTo is an annotation/derivation)"
|} .

gmeow:wasGeneratedBy skos:exactMatch prov:wasGeneratedBy {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:wasDerivedFrom skos:exactMatch prov:wasDerivedFrom {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

gmeow:wasAttributedTo skos:exactMatch prov:wasAttributedTo {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95
|} .

# --------------------------------------------------------------------------- #
# W3C Verifiable Credentials / DID
# --------------------------------------------------------------------------- #

gmeow:Attestation skos:closeMatch vc:VerifiableCredential {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "A VC is credential-like; Attestation is broader (includes non-credential envelopes such as SLSA, DSSE, transparency logs)"
|} .

gmeow:attester skos:closeMatch vc:issuer {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8
|} .

gmeow:attestedSubject skos:closeMatch vc:credentialSubject {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75
|} .

gmeow:issuedAt skos:closeMatch vc:issuanceDate {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85
|} .

gmeow:VerificationResult skos:closeMatch vc:VerifiablePresentation {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "A verification result is the outcome of checking a VC, not the presentation itself; loose mapping"
|} .

# --------------------------------------------------------------------------- #
# Web of Trust (WOT) — broader attestation pattern
# --------------------------------------------------------------------------- #

gmeow:Attestation skos:relatedMatch <http://xmlns.com/wot/0.1/Endorsement> {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "WoT Endorsement is a key-certification edge; Attestation is the broader envelope pattern. Certification (trust.ttl) is the closer match."
|} .

# --------------------------------------------------------------------------- #
# DQV — quality assessments consume attestation evidence
# --------------------------------------------------------------------------- #

gmeow:VerificationActivity skos:relatedMatch <http://www.w3.org/ns/dqv#QualityAssessment> {|
    gmeow:sssomFile "gmeow-attestation.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "Verification and quality assessment are distinct but related; quality may consume verification results as evidence"
|} .
