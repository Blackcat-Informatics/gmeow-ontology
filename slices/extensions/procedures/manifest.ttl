@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/procedures>
    a gmeow:Slice ;
    rdfs:label "procedures"@x-gmeow-english ;
    skos:definition "The procedures slice of the GMEOW ontology (extension tier): GMEOW Procedures Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/procedures> ;
    dcterms:title "GMEOW Procedures Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierExtension ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/events> ,
        <https://blackcatinformatics.ca/gmeow/slices/teleology> ;
    gmeow:sliceConsumer "The universal process/procedure/plan generalization for workflows and recipes."@x-gmeow-english.
