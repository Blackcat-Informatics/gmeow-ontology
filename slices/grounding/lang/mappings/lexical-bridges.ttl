    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly
|} .

# NIF and Web Annotation anchors --------------------------------------------

lang:SurfaceAnchor skos:closeMatch nif:OffsetBasedString {|
    a logic:GroundingCorrespondence ;
    gmeow:sssomFile "gmeow-lang-nif.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "A native anchor can be projected as a NIF offset-based string, subject to the selected offset unit and source text." ;
    logic:sourceEndpoint lang:SurfaceAnchor ;
    logic:targetEndpoint nif:OffsetBasedString ;
    logic:morphismClass logic:AffineCorrespondence ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:preservationKind logic:ValidationOnly
|} .

