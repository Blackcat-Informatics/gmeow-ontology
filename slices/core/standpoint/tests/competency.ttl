#
# Declarative competency questions for the standpoint slice, executed by the
# native Rust slice-test harness (crates/slicetest) over the merged ontology in
# the asserted lane, with the named example overlaid as instance data.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/standpoint/tests/> .
@prefix case:  <https://example.org/correction/> .

# "Which claims does the inspector's correction involve, and what does each say?"
# The answer holds BOTH the corrected claim and the claim that corrects it, each
# with its content: the worked example keeps the two retrievable together. The
# question runs without reasoning, so its filters see only an ASSERTED
# gmeow:displayable false or supersession in the example data; it cannot detect
# a supersession that an axiom would derive. That guard is the structural
# assertion that gmeow:correctsClaim is not a sub-property of gmeow:supersedes.
ex:cqCorrectionRetainsBothClaims a gmeow:CompetencyQuestion ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqDataFile "examples/correction-and-disagreement.ttl" ;
    gmeow:cqQuery """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX case: <https://example.org/correction/>
SELECT ?claim ?content WHERE {
    ?correction gmeow:correctsClaim ?corrected .
    ?link rdf:reifies <<( ?correction gmeow:correctsClaim ?corrected )>> ;
        gmeow:accordingTo case:inspectorView .
    ?claim a gmeow:ClaimToken ;
        gmeow:expresses ?content .
    FILTER ( ?claim = ?corrected || ?claim = ?correction )
    FILTER NOT EXISTS { ?claim gmeow:displayable false }
    FILTER NOT EXISTS { ?correction gmeow:supersedes ?corrected }
    FILTER NOT EXISTS { ?corrected gmeow:supersededBy ?correction }
}""" ;
    gmeow:cqRationale "A correction is a statement by the correcting standpoint and does not supersede or suppress the claim it corrects (Principles 9 and 10): asking for the claims of the inspector's correction returns the surveyor's corrected claim and the inspector's correcting claim together, each with its own content." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqCorrectionRetainsBothClaimsShape ;
    gmeow:cqExpectRow
        ex:cqCorrectionRowCorrected ,
        ex:cqCorrectionRowCorrecting .

ex:cqCorrectionRetainsBothClaimsShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "claim" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ,
        [ logic:columnVariable "content" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:cqCorrectionRowCorrected a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "claim" ; gmeow:cellValueIri case:blueClaim ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "content" ; gmeow:cellValueIri case:doorIsBlue ] .

ex:cqCorrectionRowCorrecting a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "claim" ; gmeow:cellValueIri case:redClaim ] ,
        [ a gmeow:ExpectedCell ; gmeow:cellVar "content" ; gmeow:cellValueIri case:doorIsRed ] .

# Cross-slice signature guard: an owner-scoped structural assertion cannot see
# the domains of supersedes or its inverse, so check their real merged sources.
ex:cqLifecyclePreservesCarrierSort a gmeow:CompetencyQuestion ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqQuery """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?relation { gmeow:succeedsClaim gmeow:correctsClaim gmeow:retractsClaim }
    VALUES ?forbidden { gmeow:Entity gmeow:ClaimToken gmeow:Activity }
    ?relation (rdfs:subPropertyOf|logic:subPropertyOf|owl:equivalentProperty|logic:equivalentProperty|^owl:equivalentProperty|^logic:equivalentProperty|owl:inverseOf|logic:inverseOf|^owl:inverseOf|^logic:inverseOf)* ?reachable .
    ?reachable ?slot ?bound .
    VALUES ?slot { rdfs:domain logic:domain rdfs:range logic:range }
    ?bound (rdfs:subClassOf|logic:subClassOf|owl:equivalentClass|logic:equivalentClass|^owl:equivalentClass|^logic:equivalentClass)* ?forbidden .
    FILTER (!(?relation = gmeow:retractsClaim && ?reachable = gmeow:retractsClaim &&
              (?slot = rdfs:domain || ?slot = logic:domain) &&
              ?bound = gmeow:Activity && ?forbidden = gmeow:Activity))
}""" ;
    gmeow:cqExpectAsk false ;
    gmeow:cqRationale "Follow the actual merged lifecycle signatures through superproperties, equivalences, inverses and class ancestry. A lifecycle relation must not turn a claim token into an Entity or turn a record or reifier into a ClaimToken or Activity. The withdrawal subject's explicit Activity domain is the sole intended exception; its target remains unrestricted. This is a schema-path guard, not a runtime closure over an overlaid example." .
