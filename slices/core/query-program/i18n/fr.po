msgid "A selected feedback body is an extensional set transformer: equal candidate input sets yield equal candidate output sets. Example declaration: gmeow:QueryFeedbackExtensionalityLaw rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ."
msgstr "Un corps de rétroaction sélectionné est un transformateur extensionnel d’ensembles : des entrées égales produisent des sorties égales. Exemple de déclaration : gmeow:QueryFeedbackExtensionalityLaw rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedEntryOwnerConstraint|http://www.w3.org/2000/01/rdf-schema#label"
msgid "Ranked entry owner constraint"
msgstr "Contrainte de propriétaire des entrées classées"

msgctxt "https://blackcatinformatics.ca/gmeow/RankedEntryOwnerConstraint|http://www.w3.org/2004/02/skos/core#definition"
msgid "Every ranked entry belongs to exactly one ranked-list occurrence; reusing a candidate in another list requires another entry."
msgstr "Chaque entrée appartient à exactement une occurrence de liste classée ; réutiliser un candidat dans une autre liste exige une autre entrée."

msgctxt "https://blackcatinformatics.ca/gmeow/RankedEntryOwnerConstraint|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for ranked entry owner constraint with explicit source bindings."
msgstr "Utiliser pour décrire contrainte de propriétaire des entrées classées avec des liens source explicites."

