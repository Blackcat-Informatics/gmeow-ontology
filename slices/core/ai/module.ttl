    logic:severity "Warning" ;
    logic:formalizes gmeow:StaleSourceShape ;
    logic:message "This claim's source was modified after the claim was asserted — the evidence may have drifted; re-verify (stale-source-claims.rq)." ;
    logic:integrity logic:stsForall .
logic:stsForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "span" ] , [ logic:termIndex 2 ; logic:termVariable "assertedAt" ] , [ logic:termIndex 3 ; logic:termVariable "chunk" ] , [ logic:termIndex 4 ; logic:termVariable "source" ] , [ logic:termIndex 5 ; logic:termVariable "srcMod" ] ;
    logic:forall logic:stsImpl .
logic:stsImpl a logic:Formula ; logic:antecedent logic:stsGuard ; logic:consequent logic:stsLe .
logic:stsGuard a logic:Formula ; logic:and logic:stsGrounded , logic:stsAsserted , logic:stsSpanChunk , logic:stsChunkOf , logic:stsSrcMod .
logic:stsGrounded a logic:Formula ; logic:relation gmeow:groundedIn ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "span" ] .
logic:stsAsserted a logic:Formula ; logic:relation gmeow:assertedAt ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "assertedAt" ] .
logic:stsSpanChunk a logic:Formula ; logic:relation gmeow:spanOfChunk ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "span" ] , [ logic:termIndex 1 ; logic:termVariable "chunk" ] .
logic:stsChunkOf a logic:Formula ; logic:relation gmeow:chunkOf ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "chunk" ] , [ logic:termIndex 1 ; logic:termVariable "source" ] .
logic:stsSrcMod a logic:Formula ; logic:relation gmeow:sourceModifiedAt ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "source" ] , [ logic:termIndex 1 ; logic:termVariable "srcMod" ] .
logic:stsLe a logic:Formula ; logic:relation logic:termLessEqual ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "srcMod" ] , [ logic:termIndex 1 ; logic:termVariable "assertedAt" ] .

# gmeow:GroundingSpanShape targets $this via a raw sh:SPARQLTarget select
# (every span reached through gmeow:groundedIn from a claim), not sh:targetClass
# or sh:targetSubjectsOf — a shape target no ChoiceGroup/Disjunctive sugar's
# logic:onClass can express. The check is authored as a raw logic:Formula
# integrity tree in the SpanEndAfterStart/StaleSource idiom: the guard atom
# gmeow:groundedIn(claim,this) and the four required-facet atoms share the
# outer forall's free variables (implicit join/existential-import), exactly
# mirroring how logic:stsForall above joins span → chunk → source without a
# nested sh:exists. It does not encode the shape's per-facet sh:maxCount 1
# ceiling (no procedural builtin tests upper cardinality here, matching every
# other migrated existence obligation in this file).
gmeow:GroundingSpanConstraint
    a logic:Constraint ;
    rdfs:label "Grounding span completeness constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    skos:definition "A closed-world integrity constraint: every span reached via gmeow:groundedIn from a claim (a grounding span) must be pinned into a chunk (gmeow:spanOfChunk), offset-located (gmeow:spanStart, gmeow:spanEnd), and polarity-classified (gmeow:supportPolarity) — evidence without recoverable, offset-located, polarity-classified bytes is a vibe, not grounding."@x-gmeow-english ;
    logic:formalizes gmeow:GroundingSpanShape ;
    logic:message "A grounding span (reached via gmeow:groundedIn) must carry gmeow:spanOfChunk, gmeow:spanStart, gmeow:spanEnd, and gmeow:supportPolarity." ;
    logic:integrity logic:gscForall .
logic:gscForall a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "claim" ] , [ logic:termIndex 2 ; logic:termVariable "chunk" ] , [ logic:termIndex 3 ; logic:termVariable "s" ] , [ logic:termIndex 4 ; logic:termVariable "e" ] , [ logic:termIndex 5 ; logic:termVariable "p" ] ;
    logic:forall logic:gscImpl .
logic:gscImpl a logic:Formula ; logic:antecedent logic:gscGuard ; logic:consequent logic:gscAnd .
logic:gscGuard a logic:Formula ; logic:relation gmeow:groundedIn ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "claim" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
logic:gscAnd a logic:Formula ; logic:and logic:gscChunk , logic:gscStart , logic:gscEnd , logic:gscPolarity .
logic:gscChunk a logic:Formula ; logic:relation gmeow:spanOfChunk ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "chunk" ] .
logic:gscStart a logic:Formula ; logic:relation gmeow:spanStart ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "s" ] .
logic:gscEnd a logic:Formula ; logic:relation gmeow:spanEnd ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "e" ] .
logic:gscPolarity a logic:Formula ; logic:relation gmeow:supportPolarity ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "p" ] .

# --- Shape-migration grounding (projected to generated/shapes/validation-shapes.ttl) ---
<https://blackcatinformatics.ca/gmeow/Chunk> rdfs:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/chunkOf> ; logic:someValuesFrom logic:Thing ] .
<https://blackcatinformatics.ca/gmeow/Chunk> rdfs:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/spanEnd> ; logic:someValuesFrom xsd:nonNegativeInteger ] .
<https://blackcatinformatics.ca/gmeow/Chunk> rdfs:subClassOf [ a logic:Restriction ; logic:onProperty <https://blackcatinformatics.ca/gmeow/spanStart> ; logic:someValuesFrom xsd:nonNegativeInteger ] .

# ── logic: assertion carriers for this slice's own terms ────────────────────────
# The canonical logic: carriers for the characteristics and integrity conditions of the
# terms THIS slice owns. Each record names one of this slice's own properties or classes
# through a logic: RBox predicate; the native coherence gate joins the record to enforce
# the condition, and the OWL grounding view projects OWL FunctionalProperty (and friends)
# from it. Authored here rather than in the logic slice because the fact asserted is a
# fact about this slice's own term, and a grounding slice never depends on a non-grounding
# slice (docs/GROUNDING.md, the tier rule): the logic: assertion vocabulary is CONSUMED
# here (gmeow:sliceDependsOn logic), never owned.
#   logic:PropertyCharacteristicAssertion — logic:characterizes names the property, logic:characteristicSort its characteristic.

gmeow:chunkOfFunctionality
    a logic:NamedIndividual ,
        logic:PropertyCharacteristicAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/ai> ;
    rdfs:label "chunkOf is functional"@x-gmeow-english ;
    skos:definition "Asserts on the canonical carrier that gmeow:chunkOf is functional: a chunk is cut from exactly one source information object, so its parthood seam carries a single whole and any re-segmentation produces fresh Chunk individuals rather than re-pointing an existing one at a second source."@x-gmeow-english ;
    logic:characterizes gmeow:chunkOf ;
    logic:characteristicSort logic:functionalProperty ;
    logic:formalizes gmeow:chunkOf ;
    gmeow:useWhen "Use when the native coherence gate must enforce that gmeow:chunkOf names exactly one value; this record is the canonical carrier the gate joins, so the obligation is reasoned rather than restated on a shape surface."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid this record when a second value would make the record ambiguous — retire the assertion instead of weakening it, and never mirror it as a hand-authored shape."@x-gmeow-english ;
    gmeow:howToUse "Read together with logic:characteristicSort: the pair (logic:characterizes gmeow:chunkOf, logic:characteristicSort logic:functionalProperty) is the whole obligation, and the OWL grounding view projects the matching characteristic from it."@x-gmeow-english ;
    skos:scopeNote "Scope: this record carries ONE integrity obligation about gmeow:chunkOf and nothing else. It is not a definition of gmeow:chunkOf (that lives on the term itself), not a shape, and not a second place to state the term's meaning — retire the record rather than broaden it."@x-gmeow-english ;
    skos:example "gmeow:chunkOfFunctionality logic:characterizes gmeow:chunkOf ."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxABox .
