gmeow:implSchemaOrg a fno:Implementation ;
    dcterms:format "application/sparql-query" ;
    rdfs:seeAlso <https://blackcatinformatics.ca/gmeow/queries/projections/schema-org.rq> .

[] a fno:Mapping ;
    rdfs:label "fnBirthEventToDate → schema-org (FnO mapping)"@en ;
    fno:function gmeow:fnBirthEventToDate ;
    fno:implementation gmeow:implSchemaOrg ;
    fno:parameterMapping [ a fnom:PropertyParameterMapping ;
            rdfs:label "paramEventTime ↦ ?bdate"@en ;
            fnom:functionParameter gmeow:paramEventTime ;
            fnom:implementationProperty "bdate" ] ;
    fno:returnMapping [ a fnom:DefaultReturnMapping ;
            rdfs:label "fnBirthEventToDate output ↦ ?bdate"@en ;
            fnom:functionOutput gmeow:outBirthEventToDate ;
            fnom:implementationProperty "bdate" ] .

[] a fno:Mapping ;
    rdfs:label "fnBirthEventToDate → vcard (FnO mapping)"@en ;
    fno:function gmeow:fnBirthEventToDate ;
    fno:implementation gmeow:implVcard ;
    fno:parameterMapping [ a fnom:PropertyParameterMapping ;
            rdfs:label "paramEventTime ↦ ?bdate"@en ;
            fnom:functionParameter gmeow:paramEventTime ;
            fnom:implementationProperty "bdate" ] ;
    fno:returnMapping [ a fnom:DefaultReturnMapping ;
            rdfs:label "fnBirthEventToDate output ↦ ?bdate"@en ;
            fnom:functionOutput gmeow:outBirthEventToDate ;
            fnom:implementationProperty "bdate" ] .

[] a fno:Mapping ;
    rdfs:label "fnComposeAddress → vcard (FnO mapping)"@en ;
    fno:function gmeow:fnComposeAddress ;
    fno:implementation gmeow:implVcard ;
    fno:parameterMapping [ a fnom:PropertyParameterMapping ;
            rdfs:label "paramAddressLocality ↦ ?locality"@en ;
            fnom:functionParameter gmeow:paramAddressLocality ;
            fnom:implementationProperty "locality" ],
        [ a fnom:PropertyParameterMapping ;
            rdfs:label "paramAddressRegion ↦ ?region"@en ;
            fnom:functionParameter gmeow:paramAddressRegion ;
            fnom:implementationProperty "region" ],
        [ a fnom:PropertyParameterMapping ;
            rdfs:label "paramCountryCode ↦ ?ccode"@en ;
            fnom:functionParameter gmeow:paramCountryCode ;
            fnom:implementationProperty "ccode" ],
        [ a fnom:PropertyParameterMapping ;
            rdfs:label "paramPostalCode ↦ ?pcode"@en ;
            fnom:functionParameter gmeow:paramPostalCode ;
            fnom:implementationProperty "pcode" ],
        [ a fnom:PropertyParameterMapping ;
            rdfs:label "paramStreetAddress ↦ ?street"@en ;
            fnom:functionParameter gmeow:paramStreetAddress ;
            fnom:implementationProperty "street" ] ;
    fno:returnMapping [ a fnom:DefaultReturnMapping ;
            rdfs:label "fnComposeAddress output ↦ ?label"@en ;
            fnom:functionOutput gmeow:outComposeAddress ;
            fnom:implementationProperty "label" ] .

