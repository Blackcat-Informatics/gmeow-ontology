    [ a owl:Restriction ; owl:onProperty gmeow:participationTechnique ; owl:maxQualifiedCardinality 1 ; owl:onClass owl:Thing ] .

gmeow:InstrumentConfiguration rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:configurationModification ; owl:minQualifiedCardinality 1 ; owl:onClass owl:Thing ] ,
