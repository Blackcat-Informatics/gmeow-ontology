@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/modules/entities>
    a owl:Ontology ;
    rdfs:label "GMEOW Entities Module"@en ;
    rdfs:comment "Person, organization, group and software-agent descriptions, plus naming (the FOAF / schema.org superset layer)."@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

gmeow:Person
    a owl:Class ;
    rdfs:subClassOf gmeow:Agent ;
    rdfs:label "Person"@en ;
    skos:definition "An individual human being, living or deceased."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Organization
    a owl:Class ;
    rdfs:subClassOf gmeow:Agent ;
    rdfs:label "Organization"@en ;
    skos:definition "A structured group of agents — a company, institution, association, or governmental body — able to act as a single agent."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Group
    a owl:Class ;
    rdfs:subClassOf gmeow:Entity, gufo:Collection ;
    rdfs:label "Group"@en ;
    skos:definition "A collection of agents treated as a unit without the formal structure of an organization."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:SoftwareAgent
    a owl:Class ;
    rdfs:subClassOf gmeow:Agent ;
    rdfs:label "Software Agent"@en ;
    skos:definition "A software process or autonomous program that acts on behalf of a person or organization."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# Naming (datatype properties).

gmeow:name
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:range rdfs:Literal ;
    rdfs:label "name"@en ;
    skos:definition "A name by which an entity is known, as a flat literal. A lossy convenience shortcut — NOT the entity's canonical or 'primary' name. An entity bears many co-equal names (across languages, scripts, and life stages); the first-class, structured, multi-culture model is gmeow:Appellation / gmeow:PersonName (names module). Language-tag the literal where applicable."@en ;
    skos:scopeNote "Flat projection of one of the co-equal gmeow:fullName values on a gmeow:Appellation; carries no precedence over an entity's other names."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:givenName
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Person ;
    rdfs:range rdfs:Literal ;
    rdfs:label "given name"@en ;
    skos:definition "A person's given (first) name, as a flat literal shortcut. The structured, culture-aware form is a typed gmeow:NamePart (gmeow:namePartGiven) on a gmeow:PersonName."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:familyName
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Person ;
    rdfs:range rdfs:Literal ;
    rdfs:label "family name"@en ;
    skos:definition "A person's family (last) name, as a flat literal shortcut. Optional — many naming systems have no family name (mononyms, patronymic systems). The structured form is a typed gmeow:NamePart (gmeow:namePartSurname) on a gmeow:PersonName."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
