#
# Structural assertions for the trace-finality records of the memory-records slice.
# Each assertion runs as a SPARQL ASK over the module graph (gmeow:scopeModule) or
# the module and its worked examples. The records state what a producer or recorder
# declared; none of these assertions, and no constraint of the slice, compares a
# time or a digest.

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/memory-records/tests/> .

ex:saTraceFinalityVocabulary a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ; gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:TraceWatermark (rdfs:subClassOf|logic:subClassOf) gmeow:InformationObject .
    gmeow:TraceMarkFrontier (rdfs:subClassOf|logic:subClassOf) gmeow:InformationObject .
    gmeow:TraceMarksGivenUp (rdfs:subClassOf|logic:subClassOf) gmeow:InformationObject .
    gmeow:traceFinalityLedger (rdfs:range|logic:range) gmeow:TracePacketLedger .
    gmeow:traceFinalityProducer (rdfs:range|logic:range) gmeow:Agent .
    gmeow:watermarkPacket (rdfs:domain|logic:domain) gmeow:TraceWatermark ; (rdfs:range|logic:range) gmeow:TracePacket .
    gmeow:frontierPoint (rdfs:domain|logic:domain) gmeow:TraceMarkFrontier ; (rdfs:range|logic:range) gmeow:TraceAnchor .
    gmeow:givenUpPacket (rdfs:domain|logic:domain) gmeow:TraceMarksGivenUp ; (rdfs:range|logic:range) gmeow:TraceAnchor .
    gmeow:givenUpReason (rdfs:domain|logic:domain) gmeow:TraceMarksGivenUp ; (rdfs:range|logic:range) rdfs:Literal .
}""" ;
    gmeow:saRationale "The three declarations are information records that reuse the recorded ledger, the recorded packet, the anchor key and the agent; the signature of each role is pinned so that a changed domain or range fails." .

ex:saTraceFinalityRequiredRoles a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ; gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:TraceWatermark logic:subClassOf [ logic:onProperty gmeow:traceFinalityLedger ; logic:allValuesFrom gmeow:TracePacketLedger ] ,
        [ logic:onProperty gmeow:traceFinalityProducer ; logic:allValuesFrom gmeow:Agent ] ,
        [ logic:onProperty gmeow:watermarkPacket ; logic:allValuesFrom gmeow:TracePacket ] .
    gmeow:TraceMarkFrontier logic:subClassOf [ logic:onProperty gmeow:traceFinalityLedger ; logic:allValuesFrom gmeow:TracePacketLedger ] ,
        [ logic:onProperty gmeow:traceFinalityProducer ; logic:allValuesFrom gmeow:Agent ] ,
        [ logic:onProperty gmeow:frontierPoint ; logic:allValuesFrom gmeow:TraceAnchor ] .
    gmeow:TraceMarksGivenUp logic:subClassOf [ logic:onProperty gmeow:givenUpReason ; logic:allValuesFrom rdfs:Literal ] .
    [] logic:onClass gmeow:TraceWatermark ; logic:closureKey "https://blackcatinformatics.ca/gmeow/traceFinalityLedger" .
    [] logic:onClass gmeow:TraceWatermark ; logic:closureKey "https://blackcatinformatics.ca/gmeow/traceFinalityProducer" .
    [] logic:onClass gmeow:TraceWatermark ; logic:closureKey "https://blackcatinformatics.ca/gmeow/watermarkPacket" .
    [] logic:onClass gmeow:TraceMarkFrontier ; logic:closureKey "https://blackcatinformatics.ca/gmeow/traceFinalityLedger" .
    [] logic:onClass gmeow:TraceMarkFrontier ; logic:closureKey "https://blackcatinformatics.ca/gmeow/traceFinalityProducer" .
    [] logic:onClass gmeow:TraceMarkFrontier ; logic:closureKey "https://blackcatinformatics.ca/gmeow/frontierPoint" .
    [] logic:onClass gmeow:TraceMarksGivenUp ; logic:closureKey "https://blackcatinformatics.ca/gmeow/givenUpReason" .
}""" ;
    gmeow:saRationale "A watermark and a frontier name their ledger and producer, a watermark its cut packet, a frontier its committed point, and a give-up its reason: each is an all-values restriction plus a closed-world required-path entry on that class. Dropping one entry fails the assertion." .

ex:saTraceFinalityNoComparison a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ; gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
ASK {
    VALUES ?term { gmeow:traceFinalityLedger gmeow:traceFinalityProducer gmeow:watermarkPacket gmeow:frontierPoint gmeow:givenUpPacket gmeow:givenUpReason }
    ?constraint a logic:Constraint ; logic:formalizes ?term ; logic:integrity ?root .
    ?root (logic:forall|logic:exists|logic:not|logic:and|logic:or|logic:antecedent|logic:consequent)* ?formula .
    ?formula logic:relation ?relation .
    FILTER(?relation NOT IN (rdf:type, gmeow:watermarkPacket, gmeow:frontierPoint, logic:termDistinct))
}""" ;
    gmeow:saRationale "No constraint on a finality role uses a relation other than the type test, the role being limited and term distinctness. In particular none compares a time or a digest, and none uses the numeric comparison, so a constraint added later that compares them fails this assertion." .

ex:saTraceFinalityDerivesNothing a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ; gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?p { gmeow:traceFinalityLedger gmeow:traceFinalityProducer gmeow:watermarkPacket gmeow:frontierPoint gmeow:givenUpPacket gmeow:givenUpReason }
    VALUES ?link { rdfs:subPropertyOf logic:subPropertyOf logic:inverseOf logic:equivalentProperty }
    { ?p ?link ?q }
    UNION { ?q ?link ?p }
    UNION { ?p logic:propertyChainAxiom ?chain }
    UNION { ?q logic:propertyChainAxiom ?chain . ?chain rdf:rest*/rdf:first ?p }
}""" ;
    gmeow:saRationale "No finality role is a sub-property, inverse, equivalent or chain of anything, or a member of a chain: nothing is derived from a watermark, frontier or give-up, so no marking, finality or discard eligibility follows from the records." .

ex:saTraceFinalityNoRuleBody a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ; gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
ASK {
    VALUES ?p { gmeow:traceFinalityLedger gmeow:traceFinalityProducer gmeow:watermarkPacket gmeow:frontierPoint gmeow:givenUpPacket gmeow:givenUpReason }
    ?rule a logic:Rule ; (logic:body|logic:negatedBody) ?atom .
    ?atom rdf:reifies <<( ?s ?p ?o )>> .
}""" ;
    gmeow:saRationale "No logic:Rule in the module has a positive or negated body atom on a finality role, so no rule authored here derives a statement from a watermark, frontier or give-up." .

ex:saTraceFinalityNoFormulaOutsideConstraint a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ; gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    VALUES ?p { gmeow:traceFinalityLedger gmeow:traceFinalityProducer gmeow:watermarkPacket gmeow:frontierPoint gmeow:givenUpPacket gmeow:givenUpReason }
    ?formula logic:relation ?p .
    FILTER NOT EXISTS {
        ?constraint a logic:Constraint ; logic:integrity ?root .
        ?root (logic:forall|logic:exists|logic:not|logic:and|logic:or|logic:antecedent|logic:consequent)* ?formula .
    }
}""" ;
    gmeow:saRationale "Every formula on a finality role is a node of a constraint's integrity tree, which validates and derives nothing; a law or definition on these roles elsewhere fails this assertion." .

ex:saTraceFinalitySingleValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ; gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:TraceWatermarkPacketUniqueConstraint a logic:Constraint ; logic:formalizes gmeow:watermarkPacket ; logic:integrity ?wForall .
    ?wForall logic:forall ?wImplies .
    ?wImplies logic:consequent ?wNot .
    ?wNot logic:not ?wExists .
    ?wExists logic:exists ?wBody .
    ?wBody logic:and ?wFirst , ?wSecond , ?wDistinct .
    ?wFirst logic:relation gmeow:watermarkPacket .
    ?wSecond logic:relation gmeow:watermarkPacket .
    ?wDistinct logic:relation logic:termDistinct .
    FILTER(?wFirst != ?wSecond)
    gmeow:TraceMarkFrontierPointUniqueConstraint a logic:Constraint ; logic:formalizes gmeow:frontierPoint ; logic:integrity ?fForall .
    ?fForall logic:forall ?fImplies .
    ?fImplies logic:consequent ?fNot .
    ?fNot logic:not ?fExists .
    ?fExists logic:exists ?fBody .
    ?fBody logic:and ?fFirst , ?fSecond , ?fDistinct .
    ?fFirst logic:relation gmeow:frontierPoint .
    ?fSecond logic:relation gmeow:frontierPoint .
    ?fDistinct logic:relation logic:termDistinct .
    FILTER(?fFirst != ?fSecond)
}""" ;
    gmeow:saRationale "One watermark names one cut packet and one frontier one committed point, each as a closed-world constraint that rejects two distinct values. The check is on term distinctness, not on order." .

ex:saTraceFinalityNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ; gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    VALUES ?p { gmeow:traceFinalityLedger gmeow:traceFinalityProducer gmeow:watermarkPacket gmeow:frontierPoint gmeow:givenUpPacket gmeow:givenUpReason }
    ?rec logic:characterizes ?p ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "A functional property would make a second cut packet or committed point the same individual as the first instead of reporting the declaration, so single-valuedness is a validation constraint and no functional characteristic may characterize a finality role." .

ex:saTraceFinalityExample a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ; gmeow:saScope gmeow:scopeModuleAndExamples ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX ex: <https://example.org/trace-finality/>
ASK {
    ex:cut a gmeow:TraceWatermark ; gmeow:traceFinalityLedger ex:ledger ; gmeow:traceFinalityProducer ex:memoryService ; gmeow:watermarkPacket ex:packetOne .
    ex:lateFrontier a gmeow:TraceMarkFrontier ; gmeow:traceFinalityLedger ex:ledger ; gmeow:traceFinalityProducer ex:lateDeriver ; gmeow:frontierPoint ex:pointKey .
    ex:lost a gmeow:TraceMarksGivenUp ; gmeow:givenUpPacket ex:packetTwo ; gmeow:givenUpReason ?reason .
    ex:ledger gmeow:tracePacket ex:packetOne , ex:packetTwo , ex:packetThree .
    FILTER NOT EXISTS { ?w a gmeow:TraceWatermark ; gmeow:watermarkPacket ?a , ?b . FILTER(?a != ?b) }
    FILTER NOT EXISTS { ?f a gmeow:TraceMarkFrontier ; gmeow:frontierPoint ?c , ?d . FILTER(?c != ?d) }
    FILTER NOT EXISTS { ?g a gmeow:TraceMarksGivenUp . FILTER NOT EXISTS { ?g gmeow:givenUpReason ?r } }
}""" ;
    gmeow:saRationale "Counter-example: the worked records name their ledger, producer, cut, committed point and reason, the cut and the point are single and every give-up carries a reason. Each negative clause is tied to the records, so deleting them fails the assertion." .
