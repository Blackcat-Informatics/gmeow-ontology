                            [ a logic:Formula ; logic:relation gmeow:transitionInterlude ; logic:argument [ logic:termIndex 0 ; logic:termVariable "i2SecondReport" ] , [ logic:termIndex 1 ; logic:termVariable "interludeOccurrence" ] ] ] ;
