msgid "request origin focus"
msgstr "请求来源焦点"

msgctxt "https://blackcatinformatics.ca/gmeow/originFocus|http://www.w3.org/2004/02/skos/core#definition"
msgid "The actual entity on which the agent's attention was focused when the request originated."
msgstr "请求产生时代理注意力所聚焦的实际实体。"

msgctxt "https://blackcatinformatics.ca/gmeow/originFocus|https://blackcatinformatics.ca/gmeow/useWhen"
msgid "Use for an explicitly attributed environment record with exact source identities."
msgstr "用于具有确切来源身份和明确归属的环境记录。"

