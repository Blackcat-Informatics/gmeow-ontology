#
# Well-formed: a math:GroupHomomorphism declaring its preserved operation and a
# preservation law that is a resource (denoting a logic: formula). Conforms to
# math:HomomorphismShape and math:PreservationLawShape. Bound by ex:ecHomomorphismLawful.
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix ex:    <http://example.org/math/> .

ex:lawfulHom a math:GroupHomomorphism ;
    math:preservedOperation ex:op ;
    math:preservationLaw ex:homLaw .

ex:op a math:Operation .
ex:homLaw a logic:Formula ;
    logic:relation ex:preservesOperationRelation ;
    logic:argument [ logic:termIndex 0 ; logic:termIri ex:lawfulHom ] , [ logic:termIndex 1 ; logic:termIri ex:op ] .
