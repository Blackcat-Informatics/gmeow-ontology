#
# Well-formed: a bridge run that retains its source witness (math:parseSource), carries the
# process-layer in-band witness (logic:instantiatesSchema / logic:instantiatesPlan), and
# carries its lift's law-spine on a logic:Correspondence (math:ingestCorrespondence), so its
# up-projection (put) leg is lawful. Conforms to math:IngestRunShape.
# Bound by ex:ecIngestRunGrounded.
@prefix math:  <https://blackcatinformatics.ca/math/> .
@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <http://example.org/math/> .

ex:run a math:RIngestRun ;
    math:parseSource ex:srcWitness ;
    logic:instantiatesSchema ex:schema ;
    logic:instantiatesPlan ex:plan ;
    math:ingestCorrespondence ex:corr .
ex:srcWitness a math:MathematicalObject ; logic:loadBearing true .
ex:schema a logic:ActionSchema ;
    logic:capability ex:parseCapability ;
    logic:precondition ex:sourceAvailable .
ex:plan a logic:Plan ;
    logic:planGoal ex:ingestGoal ;
    logic:planSuccessMode ex:allStepsSucceed .
ex:ingestGoal a gmeow:Goal .
ex:allStepsSucceed a logic:PlanSuccessMode .
ex:corr a logic:Correspondence ;
    logic:morphismClass logic:LossyLens ;
    logic:mnemomorphic true .
