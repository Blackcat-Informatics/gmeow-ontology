    gmeow:hasBinding [
        gmeow:profile "schema-org" ; gmeow:toPredicate schema:usageInfo ; gmeow:relation "=" ; gmeow:confidence 0.9 ; gmeow:mnemomorphic true ;
        gmeow:emitSssom true ; gmeow:sssomPredicate skos:exactMatch ;
        gmeow:sssomFile "gmeow-rights.sssom.tsv" ] .

gmeow:mapSchemaConditionsOfAccess a gmeow:ProjectionMapping ;
    rdfs:label "conditionsOfAccess → schema:conditionsOfAccess"@x-gmeow-english ;
    gmeow:hasMappingPattern [
        gmeow:anchor "ent" ; gmeow:value "coa" ;
        gmeow:atom ( [ gmeow:subjectVar "ent" ; gmeow:predicate gmeow:conditionsOfAccess ; gmeow:objectVar "coa" ] ) ;
