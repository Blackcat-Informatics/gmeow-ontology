# Counter-example: two distinct graphemes of the GMN script related by
# gmeow:gmnConfusableWith — Greek capital Alpha (U+0391) and Latin capital A (U+0041), a
# UTS #39 skeleton pair admitted into one inventory (fires lang:GmnConfusableGlyph via the
# sh:sparql of lang:GmnConfusableGlyphShape). Both graphemes are otherwise well-formed:
# grounded in the repertoire, canonical codepoints, DISTINCT codepoint values (so
# lang:GmnGlyphCollisionShape stays quiet).

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

gmeow:gmnScript lang:hasGrapheme ex:gGreekAlpha , ex:gLatinA .

ex:gGreekAlpha a lang:Grapheme ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+0391" ;
    gmeow:gmnConfusableWith ex:gLatinA .

ex:gLatinA a lang:Grapheme ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "U+0041" .
