# Counter-example: a grapheme in the GMN script whose gmeow:gmnCodepoints value is NOT the
# canonical "U+XXXX" spelling — "2291" drops the "U+" prefix (fires
# lang:GmnNonCanonicalCodepoint via the sh:pattern of lang:GmnCodepointCanonicalShape).
# The grapheme is otherwise well-formed: grounded in the script's repertoire (so
# lang:GraphemeGroundedShape stays quiet) and its codepoints are PRESENT (so the presence
# branch, lang:GmnScriptCodepointPresenceShape, stays quiet).

@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:    <http://example.org/lang/> .

gmeow:gmnScript lang:hasGrapheme ex:gBadSpelling .

ex:gBadSpelling a lang:Grapheme ;
    lang:inScript gmeow:gmnScript ;
    gmeow:gmnCodepoints "2291" .
