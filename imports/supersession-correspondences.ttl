#
# The lang:-graft supersession ledger, authored as logic:Correspondence nodes — the canonical
# rung carrier (Principle 17: SSSOM/EDOAL are its lossy projections). Each removed / deepened /
# grafted gmeow: term is recorded as a correspondence FROM the old term TO its lang:/logic:
# replacement, at its TRUE rung on the logic: law-spine. The rung is data, not prose: it is
# logic:morphismClass + logic:mnemomorphic + (for an injective rung) a logic:getLeg. These
# correspondences are extracted from the authored surface and run through assert_gates in the
# logic-compile stage, which enforces rung↔mnemomorphic consistency and the OVERCLAIM law — a
# lossy mapping that claimed logic:Isomorphism or logic:Equivalence reds the build. The
# Section-Retraction recoverability rung is backed by first-class logic:RecoveryCase formulae.
# The native executor instantiates each complete source pattern, runs get then put, and compares
# the recovered source graph; a structural inverse alone is never accepted as recovery evidence.
#
# Honesty note: two claims the earlier prose called "SECTION-RETRACTION" are in truth LOSSY —
# gmeow:WritingSystem drops writingSystemType/textDirection and gmeow:languageTag drops the
# data-tier tags, so neither recovers its source; both are recorded here as LossyLens as an
# honest authoring — a lossy mapping that instead claimed logic:Isomorphism or logic:Equivalence
# would red on the overclaim law.

@prefix logic: <https://blackcatinformatics.ca/logic/> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix lang:  <https://blackcatinformatics.ca/lang/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix sup:   <https://blackcatinformatics.ca/gmeow/supersession/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

<https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences>
    a owl:Ontology ;
    rdfs:label "GMEOW lang: graft supersession ledger"@x-gmeow-english ;
    skos:definition "The supersession ledger of the lang: grafting migration: every removed / deepened / grafted gmeow: term recorded as a logic:Correspondence FROM the old term (logic:supersededTerm) TO its lang:/logic: replacement (logic:supersedingTerm), at its true rung (logic:morphismClass) with its recoverability witness (logic:mnemomorphic). The rung is gate-enforced through assert_gates in the logic-compile stage, which reds an overclaim (a lossy mapping cannot claim logic:Isomorphism or logic:Equivalence) and enforces rung↔mnemomorphic consistency. Every strong crossing carries a first-class logic:RecoveryCase whose complete source graph is executed through get and put; the WritingSystem split carries a deliberately refuting case that proves its dropped type and direction facets. The ledger is queryable per migrated term, so the preservation rung is reasoned data, not prose."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    gmeow:graphBoxRole gmeow:boxConfigBox .

# =========================================================================== #
# language slice                                                              #
# =========================================================================== #

# --- Language ⊑ SignSystem: deepen / embedding (Isomorphism) --------------- #
sup:langLanguageSignSystem a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "supersession: gmeow:Language → lang:SignSystem"@x-gmeow-english ;
    skos:definition "The deepen graft: gmeow:Language is embedded as a specialization of lang:SignSystem (rdfs:subClassOf), a recoverable embedding — a language IS a sign system, distinguished by lang:SignSystemKind rather than a local class ladder. Isomorphism: the language kind embeds into the sign-system reference layer with no loss."@x-gmeow-english ;
    logic:supersededTerm gmeow:Language ;
    logic:supersedingTerm lang:SignSystem ;
    logic:correspondenceRelation logic:SubsumedBy ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "true"^^xsd:boolean ;
    logic:getLeg sup:langLanguageSignSystemGet ;
    logic:recoveryCase sup:langLanguageSignSystemRecovery ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langLanguageSignSystemGet gmeow:path sup:langLanguageSignSystemStep .
sup:langLanguageSignSystemRecovery a logic:RecoveryCase ;
    rdfs:label "Language to Sign System recovery case"@x-gmeow-english ;
    skos:definition "An executable recovery case that checks whether the Language-to-Sign-System correspondence recovers its complete source graph."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    logic:recoveryTransform sup:langLanguageSignSystemRecoveryFormula ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langLanguageSignSystemRecoveryFormula a logic:Formula ;
    rdfs:label "Language to Sign System recovery transform"@x-gmeow-english ;
    skos:definition "The source-to-view formula that maps Language membership to Sign System membership for executable recovery testing."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:quantifiedVariable [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ;
    logic:forall [ a logic:Formula ;
        logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri gmeow:Language ] ] ;
        logic:consequent [ a logic:Formula ; logic:relation rdf:type ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri lang:SignSystem ] ]
    ] .

# --- FormalLanguage → formalLanguageKind: collapse (SectionRetraction) ------ #
# The load-bearing claim: the two-way Formal/Programming distinction is recovered
# by two distinct lang:SignSystemKind individuals, so the class→kind collapse is a
# genuine Section-Retraction (put ∘ get = id) — NOT a lossy approximation.
sup:langFormalKind a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "supersession: gmeow:FormalLanguage → lang:formalLanguageKind"@x-gmeow-english ;
    skos:definition "The collapse graft: the removed gmeow:FormalLanguage class is recovered as the lang:SignSystemKind individual lang:formalLanguageKind — a sign system points at this kind through lang:signSystemKind. Section-Retraction: formal-language membership is recovered exactly (the kind value bijects with the old class), so the retraction discharges."@x-gmeow-english ;
    logic:supersededTerm gmeow:FormalLanguage ;
    logic:supersedingTerm lang:formalLanguageKind ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:SectionRetraction ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "true"^^xsd:boolean ;
    logic:getLeg sup:langFormalKindGet ;
    logic:recoveryCase sup:langFormalKindRecovery ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langFormalKindGet gmeow:path sup:langFormalKindStep .
sup:langFormalKindRecovery a logic:RecoveryCase ;
    rdfs:label "Formal Language kind recovery case"@x-gmeow-english ;
    skos:definition "An executable recovery case that checks whether the Formal Language kind collapse recovers its complete source graph."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    logic:recoveryTransform sup:langFormalKindRecoveryFormula ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langFormalKindRecoveryFormula a logic:Formula ;
    rdfs:label "Formal Language kind recovery transform"@x-gmeow-english ;
    skos:definition "The source-to-view formula that maps Formal Language membership to the formal-language kind for executable recovery testing."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:quantifiedVariable [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ;
    logic:forall [ a logic:Formula ;
        logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri gmeow:FormalLanguage ] ] ;
        logic:consequent [ a logic:Formula ; logic:relation lang:signSystemKind ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri lang:formalLanguageKind ] ]
    ] .

# --- ProgrammingLanguage → programmingLanguageKind: collapse (SectionRetraction)  #
# lang:programmingLanguageKind refines lang:formalLanguageKind via skos:broader, so the
# ProgrammingLanguage ⊑ FormalLanguage subsumption survives as a kind-individual broader
# edge — the two kind individuals recover the two-way distinction, discharging the section.
sup:langProgrammingKind a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "supersession: gmeow:ProgrammingLanguage → lang:programmingLanguageKind"@x-gmeow-english ;
    skos:definition "The collapse graft: the removed gmeow:ProgrammingLanguage class is recovered as lang:programmingLanguageKind, which refines lang:formalLanguageKind through skos:broader so the ProgrammingLanguage ⊑ FormalLanguage subsumption survives as a kind-individual broader edge. Section-Retraction: the two kind individuals bijectively recover the two-way distinction."@x-gmeow-english ;
    logic:supersededTerm gmeow:ProgrammingLanguage ;
    logic:supersedingTerm lang:programmingLanguageKind ;
    logic:correspondenceRelation logic:Subsumes ;
    logic:morphismClass logic:SectionRetraction ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "true"^^xsd:boolean ;
    logic:getLeg sup:langProgrammingKindGet ;
    logic:recoveryCase sup:langProgrammingKindRecovery ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langProgrammingKindGet gmeow:path sup:langProgrammingKindStep .
sup:langProgrammingKindRecovery a logic:RecoveryCase ;
    rdfs:label "Programming Language kind recovery case"@x-gmeow-english ;
    skos:definition "An executable recovery case that checks whether the Programming Language kind collapse recovers its complete source graph."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    logic:recoveryTransform sup:langProgrammingKindRecoveryFormula ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langProgrammingKindRecoveryFormula a logic:Formula ;
    rdfs:label "Programming Language kind recovery transform"@x-gmeow-english ;
    skos:definition "The source-to-view formula that maps Programming Language membership to the programming-language kind for executable recovery testing."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:quantifiedVariable [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ;
    logic:forall [ a logic:Formula ;
        logic:antecedent [ a logic:Formula ; logic:relation rdf:type ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri gmeow:ProgrammingLanguage ] ] ;
        logic:consequent [ a logic:Formula ; logic:relation lang:signSystemKind ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "entity" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri lang:programmingLanguageKind ] ]
    ] .

# --- WritingSystem → Script + Orthography: split (LossyLens, NOT a section) -- #
# The (script, orthography) pair recovers the repertoire + binding, but writingSystemType
# and textDirection have NO lang: home and are DROPPED — so this crossing cannot discharge a
# section (it does not recover its source). Honest rung: LossyLens, mnemomorphic false.
sup:langWritingSystemSplit a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "supersession: gmeow:WritingSystem → lang:Script + lang:Orthography"@x-gmeow-english ;
    skos:definition "The split graft: the removed gmeow:WritingSystem projects onto lang:Script (the character repertoire, ISO 15924 as skos:notation) and lang:Orthography (the sign-system→script binding). LossyLens, not a section: gmeow:writingSystemType (alphabet/abjad/…) and gmeow:textDirection (ltr/rtl/…), and the WritingSystemUsage role/period facets, have no lang: home and are DROPPED, so the crossing cannot recover its source."@x-gmeow-english ;
    logic:supersededTerm gmeow:WritingSystem ;
    logic:supersedingTerm lang:Script ;
    logic:correspondenceRelation logic:RelatedMatch ;
    logic:morphismClass logic:LossyLens ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "false"^^xsd:boolean ;
    logic:recoveryCase sup:langWritingSystemSplitRefutation ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langWritingSystemSplitRefutation a logic:RecoveryCase ;
    rdfs:label "Writing System split recovery refutation"@x-gmeow-english ;
    skos:definition "An executable counterexample showing that the Writing System split fails to recover the source type, kind, and text-direction graph."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    logic:recoveryTransform sup:langWritingSystemSplitRefutationFormula ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langWritingSystemSplitRefutationFormula a logic:Formula ;
    rdfs:label "Writing System split refutation transform"@x-gmeow-english ;
    skos:definition "The source-to-view formula whose source preserves Writing System kind and direction while its Script view drops those facets."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:quantifiedVariable
        [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "system" ] ,
        [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termVariable "kind" ] ,
        [ a logic:TermCarrier ; logic:termIndex 2 ; logic:termVariable "direction" ] ;
    logic:forall [ a logic:Formula ;
        logic:antecedent [ a logic:Formula ; logic:and
            [ a logic:Formula ; logic:relation rdf:type ; logic:argument
                [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "system" ] ,
                [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri gmeow:WritingSystem ] ] ,
            [ a logic:Formula ; logic:relation gmeow:writingSystemType ; logic:argument
                [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "system" ] ,
                [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termVariable "kind" ] ] ,
            [ a logic:Formula ; logic:relation gmeow:textDirection ; logic:argument
                [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "system" ] ,
                [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termVariable "direction" ] ]
        ] ;
        logic:consequent [ a logic:Formula ; logic:relation rdf:type ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "system" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri lang:Script ] ]
    ] .

# --- seed unification langEnglish/French/Mandarin → lang:english/french/mandarin (Isomorphism) #
sup:langEnglishUnify a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "supersession: gmeow:langEnglish → lang:english"@x-gmeow-english ;
    skos:definition "Identity unification: the removed seed individual gmeow:langEnglish is unified with the lang: sign system lang:english (same English language, one identity). The x-gmeow-english private-use tag rides lang:carrierTag on the carrier variety lang:gmeowEnglish; the lexvo/Wikidata alignments move onto lang:english. Isomorphism: full identity recovery."@x-gmeow-english ;
    logic:supersededTerm gmeow:langEnglish ;
    logic:supersedingTerm lang:english ;
    logic:correspondenceRelation logic:Equiv ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "true"^^xsd:boolean ;
    logic:getLeg sup:langEnglishUnifyGet ;
    logic:recoveryCase sup:langEnglishUnifyRecovery ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langEnglishUnifyGet gmeow:path sup:langEnglishUnifyStep .
sup:langEnglishUnifyRecovery a logic:RecoveryCase ;
    rdfs:label "English identity unification recovery case"@x-gmeow-english ;
    skos:definition "An executable recovery case that checks whether English identity unification recovers its complete source graph."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    logic:recoveryTransform sup:langEnglishUnifyRecoveryFormula ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langEnglishUnifyRecoveryFormula a logic:Formula ;
    rdfs:label "English identity unification recovery transform"@x-gmeow-english ;
    skos:definition "The source-to-view formula that replaces the superseded English identity with its canonical language identity for executable recovery testing."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    logic:quantifiedVariable [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "holder" ] ;
    logic:forall [ a logic:Formula ;
        logic:antecedent [ a logic:Formula ; logic:relation rdf:value ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "holder" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri gmeow:langEnglish ] ] ;
        logic:consequent [ a logic:Formula ; logic:relation rdf:value ; logic:argument
            [ a logic:TermCarrier ; logic:termIndex 0 ; logic:termVariable "holder" ] ,
            [ a logic:TermCarrier ; logic:termIndex 1 ; logic:termIri lang:english ] ]
    ] .

sup:langFrenchUnify a logic:Correspondence ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    rdfs:label "supersession: gmeow:langFrench → lang:french"@x-gmeow-english ;
    skos:definition "Identity unification: the removed seed individual gmeow:langFrench is unified with lang:french; the x-gmeow-french tag rides lang:carrierTag on lang:gmeowFrench. Isomorphism."@x-gmeow-english ;
    logic:supersededTerm gmeow:langFrench ;
    logic:supersedingTerm lang:french ;
    logic:correspondenceRelation logic:Equiv ;
    logic:morphismClass logic:Isomorphism ;
    logic:morphismKind logic:InstitutionMorphism ;
    logic:mnemomorphic "true"^^xsd:boolean ;
    logic:getLeg sup:langFrenchUnifyGet ;
    logic:recoveryCase sup:langFrenchUnifyRecovery ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langFrenchUnifyGet gmeow:path sup:langFrenchUnifyStep .
sup:langFrenchUnifyRecovery a logic:RecoveryCase ;
    rdfs:label "French identity unification recovery case"@x-gmeow-english ;
    skos:definition "An executable recovery case that checks whether French identity unification recovers its complete source graph."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/imports/supersession-correspondences> ;
    logic:recoveryTransform sup:langFrenchUnifyRecoveryFormula ;
    gmeow:graphBoxRole gmeow:boxABox .
sup:langFrenchUnifyRecoveryFormula a logic:Formula ;
    rdfs:label "French identity unification recovery transform"@x-gmeow-english ;
