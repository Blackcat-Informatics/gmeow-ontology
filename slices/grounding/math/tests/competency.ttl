    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "parent" ; gmeow:cellValueIri math:Hypothesis ] .

# === SATQ4 — the six lawful sidedness values ============================== #

ex:cqStatisticsSidednessValues a gmeow:CompetencyQuestion ;
    gmeow:cqQueryFile "slices/grounding/math/queries/competency/statistics-sidedness-values.rq" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "The math:Sidedness code list made enumerable: the tail/side a p-value declares is fixed by one of a CLOSED set of individuals (never a free literal), each asserted a math:Sidedness in module.ttl. Over the merged ontology the answer is exactly the six lawful values {math:oneSidedAlternative, math:twoSidedAlternative, math:greaterAlternative, math:lessAlternative, math:exactTail, math:midPTail}, each of kind math:Sidedness — the exact set the IllFramedPValue gate checks an math:alternativeSidedness against." ;
    gmeow:cqExactRows true ;
    gmeow:cqResultShape ex:cqStatisticsSidednessValuesShape ;
    gmeow:cqExpectRow ex:rowSideOne , ex:rowSideTwo , ex:rowSideGreater , ex:rowSideLess , ex:rowSideExact , ex:rowSideMidP .

