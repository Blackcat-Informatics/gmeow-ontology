        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/acceptsCurrency> ?cur . FILTER NOT EXISTS { ?cur <https://blackcatinformatics.ca/gmeow/frameRealm> <https://blackcatinformatics.ca/gmeow/frameRealmCurrency> . } }""" ;
    ] .

<https://blackcatinformatics.ca/gmeow/OrientationRepresentationConstraintProceduralConstraintShape>
    a sh:NodeShape ;
    logic:formalizes <https://blackcatinformatics.ca/gmeow/OrientationShape> ;
    sh:targetClass <https://blackcatinformatics.ca/gmeow/Orientation> ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "An Orientation must carry at least one of: a complete unit quaternion (x,y,z,w); complete Euler angles with eulerOrder (yaw,pitch,roll,order); a heading; a bearing; or a homogeneous coordinate matrix." ;
        sh:select """SELECT $this WHERE { FILTER NOT EXISTS { { $this <https://blackcatinformatics.ca/gmeow/quaternionX> ?qx . $this <https://blackcatinformatics.ca/gmeow/quaternionY> ?qy . $this <https://blackcatinformatics.ca/gmeow/quaternionZ> ?qz . $this <https://blackcatinformatics.ca/gmeow/quaternionW> ?qw . } UNION { $this <https://blackcatinformatics.ca/gmeow/yaw> ?yaw . $this <https://blackcatinformatics.ca/gmeow/pitch> ?pitch . $this <https://blackcatinformatics.ca/gmeow/roll> ?roll . $this <https://blackcatinformatics.ca/gmeow/eulerOrder> ?eord . } UNION { $this <https://blackcatinformatics.ca/gmeow/heading> ?h . } UNION { $this <https://blackcatinformatics.ca/gmeow/bearing> ?b . } UNION { $this <https://blackcatinformatics.ca/gmeow/hasCoordinateMatrix> ?m . } } }""" ;
    ] .

