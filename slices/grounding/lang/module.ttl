    gmeow:gmnDispositionBasis gmeow:gmnBasisConfusability ;
    gmeow:gmnDispositionRationale "Hyphen-minus is visually confusable with Unicode hyphen, mathematical minus, and soft hyphen; the `mb` key preserves an inspectable transport spelling." ;
    gmeow:gmnCandidateDenotation gmeow:gmnDenMorphemeBoundary ;
    gmeow:cites gmeow:leipzigWork ;
    gmeow:graphBoxRole gmeow:boxABox .

