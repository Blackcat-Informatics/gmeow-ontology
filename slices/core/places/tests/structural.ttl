    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:referenceFrameICRS a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmCelestial ;
        gmeow:hasMetricKind gmeow:metricGeodesic .
    gmeow:referenceFrameFK5 a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmCelestial ;
        gmeow:hasMetricKind gmeow:metricGeodesic .
    gmeow:referenceFrameGalactic a gmeow:ReferenceFrame ;
        gmeow:frameRealm gmeow:frameRealmCelestial ;
        gmeow:hasMetricKind gmeow:metricGeodesic .
}""" ;
    gmeow:saRationale "ICRS, FK5, and Galactic reference frames MUST exist with celestial realm and geodesic metric. Mirrors test_icrs_fk5_galactic_frames_exist." .

# --- 86. CelestialCoordinates has RA, Dec, epoch DatatypeProperties (MUST) ----
ex:saCelestialCoordsProperties a gmeow:StructuralAssertion ;
