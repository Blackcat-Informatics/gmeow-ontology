@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .

@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix mo: <http://purl.org/ontology/mo/> .
@prefix schema: <https://schema.org/> .
@prefix pon: <https://w3id.org/polifonia/ontology/> .
@prefix jams: <http://w3id.org/polifonia/ontology/jams/> .
@prefix lrmoo: <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix mbz: <https://musicbrainz.org/> .
@prefix chord: <http://purl.org/ontology/chord/> .
@prefix afo: <https://w3id.org/afo/onto/1.1#> .

# Music notation projection layer and maximal alignment.
# Compiled by `gmeow-dev sync --mode update --outputs generated` (mappings) to:
#   - mappings/gmeow-music.sssom.tsv (TermEquivalence rows)
#   - projections/functions.fno.ttl (ProjectionFunction declarations)
#   - projections/music-*.edoal.ttl (ProjectionMapping cells)
#   - queries/projections/music-*.rq (executable CONSTRUCT)

# --------------------------------------------------------------------------- #
# MAPPING SET HEADER
# --------------------------------------------------------------------------- #

gmeow:mapsetMusicNotation a gmeow:MappingSet ;
    rdfs:label "music notation projection mapping set"@x-gmeow-english ;
    skos:definition "Music-notation projection alignments to external music ontologies, symbolic encoding standards, and Wikidata. All bridges are by reference (Principle 5)."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/music> ;
    gmeow:sssomFile "gmeow-music.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/music" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Music-notation projection alignments to external music ontologies, symbolic encoding standards, and Wikidata. All bridges are by reference (Principle 5)." .

# --------------------------------------------------------------------------- #
# PROJECTED OUTPUT PREDICATES (DSL-layer, no ontology range)
# --------------------------------------------------------------------------- #

