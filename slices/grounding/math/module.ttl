math:e8A2 a logic:Formula ; logic:relation math:rootSystemRank ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termLiteral "8" ; logic:termLiteralDatatype xsd:integer ] .
math:e8A3 a logic:Formula ; logic:relation math:weylGroup ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "w" ] .
