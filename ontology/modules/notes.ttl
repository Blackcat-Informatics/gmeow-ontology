@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix gufo:    <http://purl.org/nemo/gufo#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/modules/notes>
    a owl:Ontology ;
    rdfs:label "GMEOW Notes & Annotation Module"@en ;
    rdfs:comment """First-class annotation and personal-knowledge-management layer — notes, highlights, bookmarks, comments, and the bidirectional backlink graph (the RDF gap GMEOW fills). Reuses, never duplicates: EvidenceSpan/Selector for anchored targets (#55), aboutness/Tagging for topics (#27), accordingTo for standpoint (#43), displayable for suppression (P10). Grounded in gUFO; aligned to W3C Web Annotation, schema.org, ActivityStreams, and SIOC by reference (P5)."""@en ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# EVIDENCE SPAN — generalized anchored target (coordinated with #55 Selector)
# =========================================================================== #

gmeow:EvidenceSpan
    a owl:Class, gufo:Category ;
    rdfs:subClassOf gmeow:InformationObject ;
    rdfs:label "Evidence Span"@en ;
    skos:definition "An anchored target span within a resource — a text quote, character position, fragment identifier, page, or generic locator. Generalized from the citation-selector model to serve both evidentiary claims (#54/#55) and annotation targets (#63). The selector properties (selectorTextQuote, selectorTextPosition, selectorPage, selectorLocator) are asserted on EvidenceSpan individuals and inherited by Selector instances. No second selector model is minted (Principle 4)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# NOTE — the content layer
# =========================================================================== #

gmeow:Note
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gmeow:InformationObject ;
    rdfs:label "Note"@en ;
    skos:definition "A piece of content in a personal or collective knowledge graph — an annotation body, a Zettelkasten card, a comment, or a standalone thought. Grounded as an information object whose authorship is mediated by Participation / wasAttributedTo, whose temporal scope is carried by the four clocks, and whose standpoint is indexed by accordingTo. Reuses isAbout and hasTag / Tagging for topic and tagging; does not mint parallel properties."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Note properties — flat-first, reify on demand
# --------------------------------------------------------------------------- #

gmeow:noteContent
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Note ;
    rdfs:range rdfs:Literal ;
    rdfs:label "note content"@en ;
    skos:definition "The textual or markdown content of a note. The flat 80% case; promote to a structured CreativeWork or a reified annotation when provenance, versioning, or multipart structure is needed."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:noteCreatedAt
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Note ;
    rdfs:range xsd:dateTime ;
    rdfs:label "note created at"@en ;
    skos:definition "The creation timestamp of a note — a lightweight four-clock shortcut. The heavy case uses a reified gmeow:Participation or prov:wasAttributedTo with full temporal scope."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:noteModifiedAt
    a owl:DatatypeProperty ;
    rdfs:domain gmeow:Note ;
    rdfs:range xsd:dateTime ;
    rdfs:label "note modified at"@en ;
    skos:definition "The last-modification timestamp of a note — a lightweight four-clock shortcut."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:noteAuthor
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Note ;
    rdfs:range gmeow:Agent ;
    rdfs:label "note author"@en ;
    skos:definition "The agent who authored a note — the flat 80% shortcut. Non-functional: a note may have multiple co-authors. Promote to a reified gmeow:Participation or prov:wasAttributedTo when the authorship act itself must carry period, confidence, or standpoint (Principle 9)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# ANNOTATION — the relator layer (W3C OA idiom in GMEOW form)
# =========================================================================== #

gmeow:Annotation
    a owl:Class, gufo:Kind ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Annotation"@en ;
    skos:definition "A reified binding of a body to a target with a motivation — the W3C Web Annotation idiom expressed as a gufo:Relator. Mediates annotationBody (the note or literal), annotationTarget (the annotated entity), and annotationMotivation (the purpose). A highlight is an Annotation with a target span but no body; a bookmark is an Annotation motivated by bookmarking. Standpoint, confidence, and suppression are carried by the relator's provenance layer (accordingTo, displayable) or by RDF-star annotations on the shortcut."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# --------------------------------------------------------------------------- #
# Annotation relator roles (functional per relator)
# --------------------------------------------------------------------------- #

gmeow:annotationBody
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Annotation ;
    rdfs:range gmeow:Note ;
    rdfs:label "annotation body"@en ;
    skos:definition "The note that serves as the body of an annotation — the content being attached. Functional per relator: one body per Annotation. Optional: a highlight or bookmark has no body."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:annotationTarget
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Annotation ;
    rdfs:range gmeow:Entity ;
    rdfs:label "annotation target"@en ;
    skos:definition "The entity that is annotated — the target of the annotation. Functional per relator: one target per Annotation."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:annotationTargetSpan
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Annotation ;
    rdfs:range gmeow:EvidenceSpan ;
    rdfs:label "annotation target span"@en ;
    skos:definition "An optional anchored span within the annotation target — a text quote, position, or fragment selector. Non-functional: an annotation may reference multiple spans (e.g. several disjoint highlights in the same document). Reuses EvidenceSpan and its selector properties; no second selector model is minted."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:annotationMotivation
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain gmeow:Annotation ;
    rdfs:range gmeow:AnnotationMotivation ;
    rdfs:label "annotation motivation"@en ;
    skos:definition "The motivation of an annotation — the purpose for which the body is attached to the target. Functional per relator: one motivation per Annotation. An open value vocabulary of individuals (Principle 9); no motivation is privileged as primary."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# SPECIALIZED ANNOTATION TYPES
# =========================================================================== #

gmeow:Highlight
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Annotation ;
    rdfs:label "Highlight"@en ;
    skos:definition "An annotation that marks an anchored span within a target and carries no body — a pure target+selector binding motivated by highlighting."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:Bookmark
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Annotation ;
    rdfs:label "Bookmark"@en ;
    skos:definition "An annotation that records a target resource for later retrieval, motivated by bookmarking. Typically has no body and no selector (the target entity itself is the bookmarked resource)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# COMMENT — threaded discussion (Note that replies)
# =========================================================================== #

gmeow:Comment
    a owl:Class, gufo:SubKind ;
    rdfs:subClassOf gmeow:Note ;
    rdfs:label "Comment"@en ;
    skos:definition "A note that replies to an annotation or another comment — a threaded discussion node. Threading is via commentParent (the annotation or comment being replied to) and transitive hasReply (all descendants in the thread). A top-level comment has no parent."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:commentParent
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Comment ;
    rdfs:range gmeow:Entity ;
    rdfs:label "comment parent"@en ;
    skos:definition "The annotation or comment that this comment replies to. Functional per comment: one parent per reply. Top-level comments omit this property. The range is gmeow:Entity (encompassing Annotation and Comment) so that a comment may reply to any annotatable entity without identity clash."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasDirectReply
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:commentParent ;
    rdfs:subPropertyOf gmeow:hasReply ;
    rdfs:domain gmeow:Entity ;
    rdfs:range gmeow:Comment ;
    rdfs:label "has direct reply"@en ;
    skos:definition "Relates an annotation or comment to its immediate reply comment. Non-transitive inverse of commentParent. HasReply is the transitive superproperty that reaches the full reply tree."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasReply
    a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain gmeow:Entity ;
    rdfs:range gmeow:Comment ;
    rdfs:label "has reply"@en ;
    skos:definition "Relates an annotation or comment to a reply comment. Transitive: the full reply tree is reachable. Superproperty of hasDirectReply. Intentionally kept free of OWL cardinality so that deep thread trees remain DL-regular (no cardinality explosion)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# BACKLINK GRAPH — bidirectional, first-class (the RDF / PKM gap)
# =========================================================================== #

gmeow:mentions
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Note ;
    rdfs:range gmeow:Entity ;
    rdfs:label "mentions"@en ;
    skos:definition "A note mentions another entity (typically another note or a resource) — the source of a directed backlink edge. Non-functional: a note may mention many entities. Kept cardinality-free for DL regularity; the inverse mentionedIn provides the backlink view."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:mentionedIn
    a owl:ObjectProperty ;
    owl:inverseOf gmeow:mentions ;
    rdfs:domain gmeow:Entity ;
    rdfs:range gmeow:Note ;
    rdfs:label "mentioned in"@en ;
    skos:definition "The inverse of mentions: an entity is mentioned in a note — the backlink view. Materialized by projection or inference, never hand-maintained."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:hasWikilink
    a owl:ObjectProperty ;
    rdfs:domain gmeow:Note ;
    rdfs:range gmeow:Note ;
    rdfs:label "has wikilink"@en ;
    skos:definition "A directed wikilink edge projected from mentions or relatedNote for Markdown / PKM round-trip. Not asserted in the canonical graph; materialized by the markdown projection (queries/projections/markdown.rq)."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:relatedNote
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain gmeow:Note ;
    rdfs:range gmeow:Note ;
    rdfs:label "related note"@en ;
    skos:definition "An undirected associative link between two notes — the semantic sibling of relatedTag, applied to the note graph. Symmetric. Optional: the note graph stays flat-first."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# OPEN VALUE VOCABULARY — AnnotationMotivation (individuals, Principle 9)
# =========================================================================== #

gmeow:AnnotationMotivation
    a owl:Class, gufo:AbstractIndividualType ;
    rdfs:subClassOf gufo:QualityValue ;
    rdfs:label "Annotation Motivation"@en ;
    skos:definition "The purpose for which an annotation is created — a VALUE vocabulary (individuals, never subclasses) aligned to the W3C Web Annotation motivation set. Co-equal: no motivation is primary or default. The set is open."@en ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

gmeow:motivationDescribing   a gmeow:AnnotationMotivation ; rdfs:label "describing"@en ;   skos:definition "The annotation describes the target."@en ;   rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:motivationCommenting   a gmeow:AnnotationMotivation ; rdfs:label "commenting"@en ;   skos:definition "The annotation comments on the target."@en ;   rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:motivationHighlighting a gmeow:AnnotationMotivation ; rdfs:label "highlighting"@en ; skos:definition "The annotation highlights a span within the target."@en ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:motivationBookmarking  a gmeow:AnnotationMotivation ; rdfs:label "bookmarking"@en ;  skos:definition "The annotation bookmarks the target for later retrieval."@en ; rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:motivationTagging      a gmeow:AnnotationMotivation ; rdfs:label "tagging"@en ;      skos:definition "The annotation tags the target with a label or topic."@en ;      rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:motivationLinking      a gmeow:AnnotationMotivation ; rdfs:label "linking"@en ;      skos:definition "The annotation links the target to another resource."@en ;      rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:motivationQuestioning  a gmeow:AnnotationMotivation ; rdfs:label "questioning"@en ;  skos:definition "The annotation poses a question about the target."@en ;  rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:motivationReplying     a gmeow:AnnotationMotivation ; rdfs:label "replying"@en ;     skos:definition "The annotation replies to another annotation or comment."@en ;     rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:motivationAssessing    a gmeow:AnnotationMotivation ; rdfs:label "assessing"@en ;    skos:definition "The annotation assesses or evaluates the target."@en ;    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .
gmeow:motivationModerating   a gmeow:AnnotationMotivation ; rdfs:label "moderating"@en ;   skos:definition "The annotation moderates or curates the target."@en ;   rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow> .

# =========================================================================== #
# AXIOMATIZED DOCTRINE — relator mediation for ELK visibility
# =========================================================================== #

gmeow:Annotation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:annotationTarget ;    owl:someValuesFrom gmeow:Entity ] ,
    [ a owl:Restriction ; owl:onProperty gmeow:annotationMotivation ; owl:someValuesFrom gmeow:AnnotationMotivation ] .

gmeow:Highlight rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty gmeow:annotationTargetSpan ; owl:someValuesFrom gmeow:EvidenceSpan ] .
