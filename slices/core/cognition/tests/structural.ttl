#
# Declarative structural assertions for the cognition slice --
# the slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT
# invariants formerly hand-written in tests/test_cognition.py. Each assertion
# runs as a SPARQL ASK over the cognition module graph (gmeow:scopeModule)
# under the native Rust slicetest harness (crates/slicetest).
#
# Cognition is migrated: class stereotypes are logic:
# (logic:Kind, logic:AbstractIndividualType, logic:QualityValue), not gufo:.
#
# RETAINED in pytest (not migratable here):
#   test_mental_moment_is_category_under_intrinsic_mode --
#     gmeow:MentalMoment is defined in slices/core/kernel/module.ttl;
#     a scopeModule cell over the cognition graph would silently miss it.
#   test_mental_moment_has_exactly_one_gufo_metaclass --
#     whole-graph dynamic sweep: iterates all MentalMoment/CognitiveState/
#     KnowledgeProficiency/KnowledgeLevel types and counts metaclass hits;
#     a finite-list ASK cannot faithfully encode the "exactly one" cardinality
#     check across an open metaclass set without narrowing the assertion.
#   test_intentional_mode_reparented_under_mental_moment --
#     gmeow:IntentionalMode is defined in slices/core/teleology/module.ttl;
#     a scopeModule cell would silently miss it (cross-slice subject).
#   test_proficiency_vocab_relocated_to_kernel --
#     gmeow:ProficiencyScale, gmeow:ProficiencyLevel, gmeow:ProficiencyModality
#     are defined in slices/core/kernel/module.ttl with
#     rdfs:isDefinedBy gmeow:slices/kernel; a scopeModule cell over the
#     cognition graph would silently miss them (cross-slice subjects).
#   test_wellformed_knowledge_proficiency_conforms --
#     SHACL validation call; ExampleConformance, not a structural TBox assertion.
#   test_malformed_knowledge_proficiency_is_flagged --
#     SHACL validation call with error-text assertions; ExampleConformance.
#   test_cognition_sssom_rows_include_expected_alignments --
#     load_mappings() read of gmeow-cognition.sssom.tsv; MAP-flag ledger check,
#     not a module-scoped TBox assertion.
#   test_cognition_sssom_includes_corrected_wikidata_qids --
#     load_mappings() read; MAP-flag ledger check.
#   test_cognition_sssom_includes_opencyc_knows_about --
#     load_mappings() read; MAP-flag ledger check.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/cognition/tests/> .

# --- 1. CognitiveState is a logic:Kind subclass of MentalMoment (MUST) --------
ex:saCognitiveStateIsKindUnderMentalMoment a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:CognitiveState a owl:Class , logic:Kind ;
        rdfs:subClassOf gmeow:MentalMoment .
}""" ;
    gmeow:saRationale "gmeow:CognitiveState MUST be an owl:Class typed logic:Kind and a subclass of gmeow:MentalMoment -- the knowing mode that grounds the knowledge spectrum lives under the kernel mental-moment umbrella (Principle 15)." .

# --- 2. KnowledgeProficiency is a logic:Kind subclass of logic:Relator (MUST) --
ex:saKnowledgeProficiencyIsKindRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:KnowledgeProficiency a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:KnowledgeProficiency MUST be an owl:Class typed logic:Kind and a subclass of logic:Relator -- the reified leveled depth-of-knowledge relator binding agent x subject x level x scale (mirrors gmeow:SkillProficiency)." .

# --- 3. The four KnowledgeProficiency role properties are ObjectProperties (MUST) ---
ex:saKnowledgeProficiencyRolesAreFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:knowledgeProficiencyAgent   a owl:ObjectProperty .
    gmeow:knowledgeProficiencySubject a owl:ObjectProperty .
    gmeow:knowledgeProficiencyLevel   a owl:ObjectProperty .
    gmeow:knowledgeProficiencyScale   a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:knowledgeProficiencyAgent, knowledgeProficiencySubject, knowledgeProficiencyLevel, and knowledgeProficiencyScale MUST all be owl:ObjectProperty -- each is constitutive of the relator (one value per role; their functionality is now carried by logic:PropertyCharacteristicAssertions, DL-enforced)." .

# --- 4. knowledgeProficiencyInterval is ObjectProperty but NOT functional -----
ex:saKnowledgeProficiencyIntervalIsOptional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:knowledgeProficiencyInterval a owl:ObjectProperty .
}""" ;
    gmeow:saRationale "gmeow:knowledgeProficiencyInterval MUST be an owl:ObjectProperty -- the temporal-scope player of the relator (close to record lapsed knowledge; Principle 10)." .

ex:saKnowledgeProficiencyIntervalNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:knowledgeProficiencyInterval a owl:FunctionalProperty .
}""" ;
    gmeow:saRationale "gmeow:knowledgeProficiencyInterval MUST NOT be owl:FunctionalProperty -- several temporal spans may attach to one relator (non-functional; the suppression-not-deletion doctrine, Principle 10)." .

# --- 5. KnowledgeProficiency carries someValuesFrom restrictions (MUST) -------
ex:saKnowledgeProficiencySomeValuesFromAgent a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    ?r a owl:Restriction ;
        owl:onProperty gmeow:knowledgeProficiencyAgent ;
        owl:someValuesFrom gmeow:Agent .
    gmeow:KnowledgeProficiency rdfs:subClassOf ?r .
}""" ;
    gmeow:saRationale "gmeow:KnowledgeProficiency MUST carry an owl:Restriction someValuesFrom gmeow:Agent on gmeow:knowledgeProficiencyAgent -- the agent arity slot is existentially typed." .

ex:saKnowledgeProficiencySomeValuesFromSubject a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    ?r a owl:Restriction ;
        owl:onProperty gmeow:knowledgeProficiencySubject ;
        owl:someValuesFrom gmeow:Entity .
    gmeow:KnowledgeProficiency rdfs:subClassOf ?r .
}""" ;
    gmeow:saRationale "gmeow:KnowledgeProficiency MUST carry an owl:Restriction someValuesFrom gmeow:Entity on gmeow:knowledgeProficiencySubject -- the subject arity slot is existentially typed." .

ex:saKnowledgeProficiencySomeValuesFromLevel a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    ?r a owl:Restriction ;
        owl:onProperty gmeow:knowledgeProficiencyLevel ;
        owl:someValuesFrom gmeow:KnowledgeLevel .
    gmeow:KnowledgeProficiency rdfs:subClassOf ?r .
}""" ;
    gmeow:saRationale "gmeow:KnowledgeProficiency MUST carry an owl:Restriction someValuesFrom gmeow:KnowledgeLevel on gmeow:knowledgeProficiencyLevel -- the depth-rung arity slot is existentially typed." .

ex:saKnowledgeProficiencySomeValuesFromScale a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    ?r a owl:Restriction ;
        owl:onProperty gmeow:knowledgeProficiencyScale ;
        owl:someValuesFrom gmeow:ProficiencyScale .
    gmeow:KnowledgeProficiency rdfs:subClassOf ?r .
}""" ;
    gmeow:saRationale "gmeow:KnowledgeProficiency MUST carry an owl:Restriction someValuesFrom gmeow:ProficiencyScale on gmeow:knowledgeProficiencyScale -- the framework arity slot is existentially typed." .

# --- 6. CognitiveState and KnowledgeProficiency are never linked (MUST-NOT) ---
ex:saCognitiveStateAndProficiencyNotDoubleTyped a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
ASK {
    { gmeow:KnowledgeProficiency rdfs:subClassOf gmeow:CognitiveState . }
    UNION
    { gmeow:CognitiveState rdfs:subClassOf gmeow:KnowledgeProficiency . }
    UNION
    { gmeow:KnowledgeProficiency rdf:type gmeow:CognitiveState . }
}""" ;
    gmeow:saRationale "gmeow:KnowledgeProficiency MUST NOT be axiomatically linked to gmeow:CognitiveState (no subclass or type relation in either direction) -- the mode and the relator are distinct individuals for the same knowing relation, never double-typed (Principle 12)." .

# --- 7. KnowledgeLevel is a logic:AbstractIndividualType under logic:QualityValue
ex:saKnowledgeLevelIsQualityValue a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:KnowledgeLevel a owl:Class , logic:AbstractIndividualType ;
        rdfs:subClassOf logic:QualityValue .
}""" ;
    gmeow:saRationale "gmeow:KnowledgeLevel MUST be an owl:Class typed logic:AbstractIndividualType and a subclass of logic:QualityValue -- the knowledge-depth axis is an open ordered value vocabulary (individuals, not subclasses; the kernel GranularityLevel pattern)." .

# --- 8. deeperThan is transitive with domain and range KnowledgeLevel (MUST) --
ex:saDeeperThanIsTransitiveOnLevelsOnly a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:deeperThan a owl:TransitiveProperty ;
        rdfs:domain gmeow:KnowledgeLevel ;
        rdfs:range gmeow:KnowledgeLevel .
}""" ;
    gmeow:saRationale "gmeow:deeperThan MUST be owl:TransitiveProperty with rdfs:domain and rdfs:range gmeow:KnowledgeLevel -- transitivity is deliberately scoped to levels only; KnowledgeProficiency relators are never ordered by it (the moreSevereThan / coarserThan precedent)." .

# --- 9. The four KnowledgeLevel seed individuals exist (MUST) -----------------
ex:saKnowledgeLevelSeedsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:knowledgeAware       a gmeow:KnowledgeLevel .
    gmeow:knowledgeKnowsAbout  a gmeow:KnowledgeLevel .
    gmeow:knowledgeUnderstands a gmeow:KnowledgeLevel .
    gmeow:knowledgeMastered    a gmeow:KnowledgeLevel .
}""" ;
    gmeow:saRationale "The four gmeow:KnowledgeLevel seed individuals (aware, knowsAbout, understands, mastered) MUST all exist -- they are the ordinal rungs of the knowledge-depth axis." .

# --- 10. The deeperThan ordinal chain is asserted (MUST) ----------------------
ex:saKnowledgeLevelOrdinalChain a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:knowledgeMastered    gmeow:deeperThan gmeow:knowledgeUnderstands .
    gmeow:knowledgeUnderstands gmeow:deeperThan gmeow:knowledgeKnowsAbout .
    gmeow:knowledgeKnowsAbout  gmeow:deeperThan gmeow:knowledgeAware .
}""" ;
    gmeow:saRationale "The three asserted gmeow:deeperThan chain steps (mastered > understands > knowsAbout > aware) MUST be present -- they seed the ordinal ladder; transitivity closes the full partial order." .

# --- 11. Flat spectrum properties pair with KnowledgeProficiency (MUST) ------
ex:saSpectrumPairsWithRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:isAwareOf  gmeow:pairsWith gmeow:KnowledgeProficiency .
    gmeow:knowsAbout gmeow:pairsWith gmeow:KnowledgeProficiency .
    gmeow:understands gmeow:pairsWith gmeow:KnowledgeProficiency .
    gmeow:hasMastered gmeow:pairsWith gmeow:KnowledgeProficiency .
}""" ;
    gmeow:saRationale "gmeow:isAwareOf, knowsAbout, understands, and hasMastered MUST all carry gmeow:pairsWith gmeow:KnowledgeProficiency -- the pairsWith link surfaces the reified promotion path in gmeow describe (Principle 15)." .

# --- 12. Attention / interest / memory relations exist with correct shape -----
ex:saAttentionRelationsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:attendsTo    a owl:ObjectProperty ;
        rdfs:domain gmeow:Agent ; rdfs:range gmeow:Entity .
    gmeow:interestedIn a owl:ObjectProperty ;
        rdfs:domain gmeow:Agent ; rdfs:range gmeow:Entity .
    gmeow:curiousAbout a owl:ObjectProperty ;
        rdfs:domain gmeow:Agent ; rdfs:range gmeow:Entity .
    gmeow:remembers    a owl:ObjectProperty ;
        rdfs:domain gmeow:Agent ; rdfs:range gmeow:Entity .
}""" ;
    gmeow:saRationale "gmeow:attendsTo, interestedIn, curiousAbout, and remembers MUST all be owl:ObjectProperty with rdfs:domain gmeow:Agent and rdfs:range gmeow:Entity -- the attentional/affective/objectual-memory quartet that constitutes the attention/interest layer." .

# --- 13. curiousAbout is a subproperty of interestedIn (MUST) ----------------
ex:saCuriousAboutSpecializesInterestedIn a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:curiousAbout rdfs:subPropertyOf gmeow:interestedIn .
}""" ;
    gmeow:saRationale "gmeow:curiousAbout MUST be rdfs:subPropertyOf gmeow:interestedIn -- curiosity is knowledge-seeking interest, so every curious agent is automatically interested." .

# --- 14. remembers is a subproperty of isAwareOf (MUST) ----------------------
ex:saRemembersSubpropertyIsAwareOf a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:remembers rdfs:subPropertyOf gmeow:isAwareOf .
}""" ;
    gmeow:saRationale "gmeow:remembers MUST be rdfs:subPropertyOf gmeow:isAwareOf -- remembering a subject entails awareness of it; objectual memory-of is the narrowest knowledge-spectrum level." .

# --- 15. remembers is NOT a subproperty of memoryOf (MUST-NOT) ---------------
ex:saRemembersNotSubpropertyMemoryOf a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:remembers rdfs:subPropertyOf gmeow:memoryOf .
}""" ;
    gmeow:saRationale "gmeow:remembers MUST NOT be axiomatised as rdfs:subPropertyOf gmeow:memoryOf -- the bridge to the ai:MemoryItem construct is documented prose, never an OWL coupling; cognition asserts no dependency on the ai slice (Principle 9)." .

# --- 16. Attention / interest are never subprops of hasGoal (MUST-NOT) -------
ex:saNoAxiomBridgeToTeleologyDesire a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?p { gmeow:attendsTo gmeow:interestedIn gmeow:curiousAbout }
    ?p rdfs:subPropertyOf gmeow:hasGoal .
}""" ;
    gmeow:saRationale "gmeow:attendsTo, interestedIn, and curiousAbout MUST NOT be axiomatised as rdfs:subPropertyOf gmeow:hasGoal -- attention/interest are attentional pulls, not teleological desires; the axes are orthogonal and the boundary is conceptual, enforced by review not axiom (Principle 9)." .

# --- 17. Flat spectrum properties pair with logic:CognitiveAssessment (MUST) --
ex:saSpectrumPairsWithAssessment a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    gmeow:isAwareOf  gmeow:pairsWith logic:CognitiveAssessment .
    gmeow:knowsAbout gmeow:pairsWith logic:CognitiveAssessment .
    gmeow:understands gmeow:pairsWith logic:CognitiveAssessment .
    gmeow:hasMastered gmeow:pairsWith logic:CognitiveAssessment .
}""" ;
    gmeow:saRationale "gmeow:isAwareOf, knowsAbout, understands, and hasMastered MUST all carry gmeow:pairsWith logic:CognitiveAssessment -- the ladder is a generated coarse view of the multidimensional assessment, and the pairsWith link surfaces that canonical construct in gmeow describe (Principle 15)." .
