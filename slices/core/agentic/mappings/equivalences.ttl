@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences (authored in-slice; source of alignment linkage).

gmeow:ToolCall skos:relatedMatch wd:Q62270 {|
    gmeow:sssomFile "gmeow-agentic.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "Wikidata 'remote procedure call' — the MECHANISM where GMEOW names the call EVENT; curl-validated 2026-06-12"
|} .

gmeow:ToolCall skos:relatedMatch schema:Action {|
    gmeow:sssomFile "gmeow-agentic.sssom.tsv" ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.6 ;
    gmeow:comment "schema.org Action: an agent acts via an instrument — ToolCall narrows to software tool invocation with verbatim payloads; schema:instrument is the projection seam for usedTool"
|} .
