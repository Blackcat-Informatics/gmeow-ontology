# =========================================================================== #
# === Enactment-kernel roster questions                                   === #
# =========================================================================== #
#
# The kernel's lifecycle axes are CLOSED value vocabularies, and its records are
# fixed carrier sets. Both are contracts, and both fail SILENTLY: a dropped axis
# position leaves a real situation with no name to record it under, and a dropped
# carrier leaves a record that reads as complete while omitting the one field the
# reader needed. Each question below pins its roster BY IRI under cqExactRows, so
# a rename, a quiet addition, or a silent removal fails on diff instead of
# surviving as a tidier-looking vocabulary. They share one result shape, because
# every one of them asks the same shape of question — name the complete roster —
# and only the roster differs.

ex:cqKernelRosterShape a logic:ResultShape ;
    logic:declaresColumn
        [ logic:columnVariable "term" ; logic:columnTermKind logic:TermKindIri ; logic:columnBinding logic:BindingRequired ] ;
    logic:shapeCardinality logic:RowsExact .

ex:cqStepStates a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX logic: <https://blackcatinformatics.ca/logic/> SELECT ?term WHERE { ?term a logic:StepState } ORDER BY ?term" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "A step lifecycle is eight positions, and the split between pending, ready and waiting carries the axis: pending means the step has not been reached, ready means it has been reached and may run, waiting means it has been reached and may not. A three-state todo/doing/done reading collapses those into one, and that collapse is exactly what makes a stalled enactment indistinguishable from an unstarted one. Skipped and cancelled are likewise separate terminal positions — a skipped step was decided about, a cancelled one was abandoned — so a roster that lost either would let an audit read a decision where none was made." ;
    gmeow:cqResultShape ex:cqKernelRosterShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:cqStepStatesRowStepCancelled , ex:cqStepStatesRowStepCompleted , ex:cqStepStatesRowStepFailed , ex:cqStepStatesRowStepPending , ex:cqStepStatesRowStepReady , ex:cqStepStatesRowStepRunning , ex:cqStepStatesRowStepSkipped , ex:cqStepStatesRowStepWaiting  .

ex:cqStepStatesRowStepCancelled a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:StepCancelled ] .
ex:cqStepStatesRowStepCompleted a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:StepCompleted ] .
ex:cqStepStatesRowStepFailed a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:StepFailed ] .
ex:cqStepStatesRowStepPending a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:StepPending ] .
ex:cqStepStatesRowStepReady a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:StepReady ] .
ex:cqStepStatesRowStepRunning a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:StepRunning ] .
ex:cqStepStatesRowStepSkipped a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:StepSkipped ] .
ex:cqStepStatesRowStepWaiting a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:StepWaiting ] .

ex:cqEnactmentStates a gmeow:CompetencyQuestion ;
    gmeow:cqQuery "PREFIX logic: <https://blackcatinformatics.ca/logic/> SELECT ?term WHERE { ?term a logic:EnactmentState } ORDER BY ?term" ;
    gmeow:cqReasoning gmeow:reasoningNone ;
    gmeow:cqRationale "An enactment as a whole occupies six positions, and they are not the step axis with a different label: paused is a position no step has, because pausing is something an operator does to the run rather than to any one of its steps. Cancelled and failed stay apart for the same reason they do on a step — cancellation is a decision and failure is an outcome — and an enactment that reported the two under one name would make every post-incident review start by guessing which had happened." ;
    gmeow:cqResultShape ex:cqKernelRosterShape ;
    gmeow:cqExactRows true ;
    gmeow:cqExpectRow ex:cqEnactmentStatesRowEnactmentCancelled , ex:cqEnactmentStatesRowEnactmentCompleted , ex:cqEnactmentStatesRowEnactmentFailed , ex:cqEnactmentStatesRowEnactmentPaused , ex:cqEnactmentStatesRowEnactmentPending , ex:cqEnactmentStatesRowEnactmentRunning  .

ex:cqEnactmentStatesRowEnactmentCancelled a gmeow:ExpectedRow ;
    gmeow:rowCell [ a gmeow:ExpectedCell ; gmeow:cellVar "term" ; gmeow:cellValueIri logic:EnactmentCancelled ] .
