    a logic:Constraint ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/query-program> ;
    gmeow:graphBoxRole gmeow:boxTBox ;
    rdfs:label "query order required keys law"@x-gmeow-english ;
    skos:definition "Every selected query-order policy contains a typed fused-score criterion and a typed source-subject-tie criterion. Optional leading keys never replace those required comparison coordinates."@x-gmeow-english ;
    gmeow:useWhen "Use to reject a partial prescription presented as a complete selected order definition."@x-gmeow-english ;
    gmeow:avoidWhen "Avoid manufacturing absent keys, treating empty criterion membership as a default policy or equating criterion existence with measured candidate values."@x-gmeow-english ;
    gmeow:howToUse "Require distinct fresh typed-and-linked existential witnesses for orderFusedScore and orderSubjectTie; kind uniqueness supplies one occurrence of each."@x-gmeow-english ;
    skos:scopeNote "Each witness must belong to the policy rather than merely exist elsewhere. Local coordinate restrictions independently require position, kind and explicit direction."@x-gmeow-english ;
    skos:example "A minimal complete collection: ex:policy gmeow:orderCriterion ex:scoreKey, ex:tieKey . ex:scoreKey gmeow:orderCriterionKind gmeow:orderFusedScore . ex:tieKey gmeow:orderCriterionKind gmeow:orderSubjectTie ."@x-gmeow-english ;
    logic:formalizes gmeow:QueryOrderPolicy ;
    logic:message "Every selected query-order policy contains a typed fused-score criterion and a typed source-subject-tie criterion. Optional leading keys never replace those required comparison coordinates." ;
