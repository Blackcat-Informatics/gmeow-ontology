+pub fn cfg_excludes_production(predicate: &str) -> Result<bool> {
+    let predicate = syn::parse_str(predicate).map_err(fail)?;
+    Ok(!CfgContext::from_rustc("", &[], true)?
+        .portable(&predicate)?
+        .yes)
+}
