    logic:argument [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "vp" ] .
math:lrvPosIn a logic:Formula ; logic:relation logic:termIn ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "vp" ] , [ logic:termIndex 1 ; logic:termIri math:PositiveInfinity ] .

# divergesToNegativeInfinity ⟹ ∃ v ( limitResultValue(this, v) ∧ v ∈ { math:NegativeInfinity } )
math:lrvNegInf a logic:Formula ; logic:antecedent math:lrvNegGuard ; logic:consequent math:lrvNegExists .
