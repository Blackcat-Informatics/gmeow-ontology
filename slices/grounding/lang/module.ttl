    a gmeow:GmnSymbolCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
    rdfs:label "GMN candidate: addition as +"@x-gmeow-english ;
    skos:definition "The audited adoption record for rendering binary math:Addition as + in @μ records."@x-gmeow-english ;
