@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/prov> a align:Alignment ;
    rdfs:label "GMEOW → prov (EDOAL)"@en ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "BuildActivity → prov:Activity"@en ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:BuildActivity ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri prov:Activity ] ;
            align:relation "<=" ;
            edoal:measure 9e-01 ],
        [ a align:Cell ;
            rdfs:label "BuildActivity eventTime → prov:endedAtTime"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:eventTime ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri prov:endedAtTime ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ],
        [ a align:Cell ;
            rdfs:label "buildOutput × build eventTime → prov:generatedAtTime on the output"@en ;
            align:entity1 [ a edoal:Relation ;
                    edoal:uri gmeow:buildOutput ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri prov:generatedAtTime ] ;
            align:relation "<=" ;
            edoal:measure 8.5e-01 ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "prov" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow regenerate` (mappings) from mapping-dsl/ — DO NOT EDIT."@en .
