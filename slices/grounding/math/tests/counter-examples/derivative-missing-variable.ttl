#
# Counter-example for math:DerivativeShape: a math:Derivative naming what it
# differentiates and its order but omitting math:withRespectToVariable (sh:minCount 1).
# Validation MUST emit shacl.MinCountConstraintComponent (math:UnderspecifiedDerivative).
# Bound by ex:ecDerivativeMissingVariable.
@prefix math: <https://blackcatinformatics.ca/math/> .
@prefix ex:   <http://example.org/math/> .

ex:ambiguousDerivative a math:Derivative ;
    math:operator math:differentiationBinder ;
    math:derivativeOf ex:someFn ;
    math:derivativeOrder 1 .

# A math:SymbolReference gives the differentiated operand a concrete expression form.
# This fixture also omits the bound declaration and body slots; the conformance manifest
# expects the derivative minimum-count finding without claiming it is the sole finding.
ex:someFn a math:SymbolReference ; math:hasMathematicalSymbol ex:someFnSymbol .
ex:someFnSymbol a math:MathematicalSymbol .
