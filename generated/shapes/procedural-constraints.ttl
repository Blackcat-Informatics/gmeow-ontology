        sh:message "A JournalEntry must have at least two postings (gmeow:journalEntryPostings)." ;
        sh:select """SELECT $this WHERE { $this <https://blackcatinformatics.ca/gmeow/journalEntryPostings> ?value . } GROUP BY $this HAVING ( COUNT(?value) < '2'^^<http://www.w3.org/2001/XMLSchema#integer> )""" ;
    ] .

