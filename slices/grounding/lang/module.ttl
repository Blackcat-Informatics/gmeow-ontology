# =========================================================================== #
# Unmarked-surface translation (#1194): a lang:TranslationUnit whose source or   #
# target is a lang:SurfaceForm realizing no analyzed form is honest only if that #
# surface is typed lang:UnanalyzedProse AND its carried logic:Correspondence     #
# carries the weakest preservation (logic:Unsupported / logic:ValidationOnly).   #
# The 4-way UNION of lang:UnmarkedSurfaceTranslationShape is authored here as     #
# four peer integrity constraints (source/target × prose-unmarked/overclaim),    #
# each formalizing the same shape term so its projected twin keys on             #
# lang:TranslationUnit. A strong crossing over an unmarked or unanalyzed surface  #
# is the fabrication risk each flags.                                            #
# =========================================================================== #

# Peer 1 — source surface realizes nothing yet is not typed lang:UnanalyzedProse.
lang:UnmarkedSourceProseConstraint
    a logic:Constraint ;
    rdfs:label "Unmarked source-surface prose constraint"@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lang> ;
