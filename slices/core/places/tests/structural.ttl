    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:trajectoryReferenceFrame a owl:FunctionalProperty . }""" ;
    gmeow:saRationale "gmeow:trajectoryReferenceFrame MUST be owl:FunctionalProperty. Mirrors test_trajectory_reference_frame_is_functional." .

# --- 55. stateOf is functional (MUST) -----------------------------------------
ex:saStateOfIsFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
