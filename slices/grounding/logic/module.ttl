# ── Conditional-range assertions (a discriminant value fixes a relatum's type) ────────
# The canonical carrier for a value-conditioned range integrity condition on a relator: on
# a target class, a discriminant property bound to a NAMED value forces the value bound by a
# second property to be an instance of a required type. OWL cannot state a value-conditioned
# range without nominals it deliberately keeps out of the DL profile; the native coherence
# gate joins logic:conditionalRangeTarget + selector/value + required type to raise a
# violation when the discriminant matches but the required type is absent, and the generated
# SHACL constraint surface is its projection.

logic:ConditionalRangeAssertion
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conditional range assertion"@x-gmeow-english ;
    skos:definition "A central record asserting that, on a target class, a focus node whose gmeow:-selector property carries a NAMED value must bind — through a second value property — an instance of a required type. It names the class with logic:conditionalRangeTarget, the discriminant property with logic:conditionalRangeSelector and its triggering value with logic:conditionalRangeSelectorValue, the constrained property with logic:conditionalRangeValue, and the demanded type with logic:conditionalRangeRequiredType; the native coherence gate joins them to raise a violation when the selector matches yet the value is not of the required type. Carries a logic:formalizes back-reference to the domain property whose prose it encodes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:conditionalRangeTarget
    a owl:ObjectProperty ;
    rdfs:domain logic:ConditionalRangeAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conditional range target"@x-gmeow-english ;
    skos:definition "Relates a logic:ConditionalRangeAssertion to the class whose focus nodes it constrains. Domain logic:ConditionalRangeAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:conditionalRangeSelector
    a owl:ObjectProperty ;
    rdfs:domain logic:ConditionalRangeAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conditional range selector"@x-gmeow-english ;
    skos:definition "Relates a logic:ConditionalRangeAssertion to the discriminant property whose value triggers the condition. Read together with logic:conditionalRangeSelectorValue. Domain logic:ConditionalRangeAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:conditionalRangeSelectorValue
    a owl:ObjectProperty ;
    rdfs:domain logic:ConditionalRangeAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conditional range selector value"@x-gmeow-english ;
    skos:definition "Relates a logic:ConditionalRangeAssertion to the named value of the discriminant property that triggers the required-type condition. Domain logic:ConditionalRangeAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:conditionalRangeValue
    a owl:ObjectProperty ;
    rdfs:domain logic:ConditionalRangeAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conditional range value"@x-gmeow-english ;
    skos:definition "Relates a logic:ConditionalRangeAssertion to the property whose bound value must satisfy the required type when the selector matches. Domain logic:ConditionalRangeAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:conditionalRangeRequiredType
    a owl:ObjectProperty ;
    rdfs:domain logic:ConditionalRangeAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "conditional range required type"@x-gmeow-english ;
    skos:definition "Relates a logic:ConditionalRangeAssertion to the class the constrained value must instantiate when the selector matches. Domain logic:ConditionalRangeAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:attackUndermineTargetsPremiseUse
    a owl:NamedIndividual ,
        logic:ConditionalRangeAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "an undermining attack targets a premise use"@x-gmeow-english ;
    skos:definition "Asserts that a gmeow:Attack whose gmeow:attackKind is gmeow:attackUndermine must aim its gmeow:attackTarget at a gmeow:PremiseUse — undermining is premise-directed. The native coherence gate raises a violation when the kind is undermine but the target is not a premise use."@x-gmeow-english ;
    logic:conditionalRangeTarget gmeow:Attack ;
    logic:conditionalRangeSelector gmeow:attackKind ;
    logic:conditionalRangeSelectorValue gmeow:attackUndermine ;
    logic:conditionalRangeValue gmeow:attackTarget ;
    logic:conditionalRangeRequiredType gmeow:PremiseUse ;
    logic:formalizes gmeow:attackKind .

logic:attackUndercutTargetsInferenceApplication
    a owl:NamedIndividual ,
        logic:ConditionalRangeAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "an undercutting attack targets an inference application"@x-gmeow-english ;
    skos:definition "Asserts that a gmeow:Attack whose gmeow:attackKind is gmeow:attackUndercut must aim its gmeow:attackTarget at a gmeow:InferenceApplication — undercutting attacks the warrant / inferential link. The native coherence gate raises a violation when the kind is undercut but the target is not an inference application."@x-gmeow-english ;
    logic:conditionalRangeTarget gmeow:Attack ;
    logic:conditionalRangeSelector gmeow:attackKind ;
    logic:conditionalRangeSelectorValue gmeow:attackUndercut ;
    logic:conditionalRangeValue gmeow:attackTarget ;
    logic:conditionalRangeRequiredType gmeow:InferenceApplication ;
    logic:formalizes gmeow:attackKind .

logic:attackRebutTargetsStandpointClaim
    a owl:NamedIndividual ,
        logic:ConditionalRangeAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "a rebutting attack targets a standpoint claim"@x-gmeow-english ;
    skos:definition "Asserts that a gmeow:Attack whose gmeow:attackKind is gmeow:attackRebut must aim its gmeow:attackTarget at a conclusion gmeow:StandpointClaim — rebutting attacks the conclusion. The native coherence gate raises a violation when the kind is rebut but the target is not a standpoint claim."@x-gmeow-english ;
    logic:conditionalRangeTarget gmeow:Attack ;
    logic:conditionalRangeSelector gmeow:attackKind ;
    logic:conditionalRangeSelectorValue gmeow:attackRebut ;
    logic:conditionalRangeValue gmeow:attackTarget ;
    logic:conditionalRangeRequiredType gmeow:StandpointClaim ;
    logic:formalizes gmeow:attackKind .

# ── Role-composition-exclusion assertions (a relator's two roles are not whole/part) ──
# The canonical carrier for a compositional irreflexivity on a relator: on a target class,
# the value bound by a WHOLE role must not stand as the value bound by a PART role reached
# from it through any of a set of composition properties. It names the class with
# logic:compositionExclusionTarget, the two roles with logic:compositionExclusionWhole /
# logic:compositionExclusionPart, and the composition steps with logic:compositionExclusionVia;
# the native coherence gate raises a violation when the part role coincides with a component of
# the whole role, and the generated SHACL constraint surface is its projection.

logic:RoleCompositionExclusionAssertion
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "role composition exclusion assertion"@x-gmeow-english ;
    skos:definition "A central record asserting that, on a target class, the value bound by a whole role must not also be — via any of a set of composition properties — the value bound by a part role on the same focus node: a relator whose one relatum composes the other is ill-formed (an argument does not attack its own component). It names the class with logic:compositionExclusionTarget, the whole and part roles with logic:compositionExclusionWhole and logic:compositionExclusionPart, and the composition steps with logic:compositionExclusionVia; the native coherence gate joins them to raise a violation. Carries a logic:formalizes back-reference to the domain property whose prose it encodes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:compositionExclusionTarget
    a owl:ObjectProperty ;
    rdfs:domain logic:RoleCompositionExclusionAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "composition exclusion target"@x-gmeow-english ;
    skos:definition "Relates a logic:RoleCompositionExclusionAssertion to the class whose focus nodes it constrains. Domain logic:RoleCompositionExclusionAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:compositionExclusionWhole
    a owl:ObjectProperty ;
    rdfs:domain logic:RoleCompositionExclusionAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "composition exclusion whole role"@x-gmeow-english ;
    skos:definition "Relates a logic:RoleCompositionExclusionAssertion to the role binding the WHOLE whose components the part role must not coincide with. Domain logic:RoleCompositionExclusionAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:compositionExclusionPart
    a owl:ObjectProperty ;
    rdfs:domain logic:RoleCompositionExclusionAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "composition exclusion part role"@x-gmeow-english ;
    skos:definition "Relates a logic:RoleCompositionExclusionAssertion to the role whose bound value must not be a component of the whole role's value. Domain logic:RoleCompositionExclusionAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:compositionExclusionVia
    a owl:ObjectProperty ;
    rdfs:domain logic:RoleCompositionExclusionAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "composition exclusion via"@x-gmeow-english ;
    skos:definition "Relates a logic:RoleCompositionExclusionAssertion to a composition property linking the whole role's value to a component. Each asserted value is one step the exclusion ranges over; the native coherence gate raises a violation when the part role coincides with a component reached through any of them. Domain logic:RoleCompositionExclusionAssertion; multi-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:attackComponentSelfExclusion
    a owl:NamedIndividual ,
        logic:RoleCompositionExclusionAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "an argument does not attack its own component"@x-gmeow-english ;
    skos:definition "Asserts that a gmeow:Attack's gmeow:attackSource (a gmeow:Argument) must not aim its gmeow:attackTarget at one of its own components — its conclusion (gmeow:argumentConclusion), a premise use (gmeow:hasPremiseUse), or an inference application (gmeow:hasInferenceApplication): an argument does not attack a part of itself. The native coherence gate raises a violation when the target is a component of the source."@x-gmeow-english ;
    logic:compositionExclusionTarget gmeow:Attack ;
    logic:compositionExclusionWhole gmeow:attackSource ;
    logic:compositionExclusionPart gmeow:attackTarget ;
    logic:compositionExclusionVia gmeow:argumentConclusion , gmeow:hasPremiseUse , gmeow:hasInferenceApplication ;
    logic:formalizes gmeow:attackSource .

# ── Mediated-property-requirement assertions (a mediated value must carry a property) ──
# The canonical carrier for a Principle-11-style requirement that the value a focus node
# reaches through a mediating property must itself declare a required property. It names the
# class with logic:mediatedRequirementTarget, the mediating property with
# logic:mediatedRequirementVia, and the required property with logic:mediatedRequirementProperty;
# the native coherence gate raises a violation when a mediated value lacks the required
# property, and the generated SHACL constraint surface is its projection.

logic:MediatedPropertyRequirementAssertion
    a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "mediated property requirement assertion"@x-gmeow-english ;
    skos:definition "A central record asserting that, on a target class, every value a focus node reaches through a mediating property must itself declare at least one value of a required property — the interval that scopes a situation must carry its temporal frame (Principle 11). It names the class with logic:mediatedRequirementTarget, the mediating property with logic:mediatedRequirementVia, and the demanded property with logic:mediatedRequirementProperty; the native coherence gate joins them to raise a violation when a mediated value lacks the required property. Carries a logic:formalizes back-reference to the domain property whose prose it encodes."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxTBox .

logic:mediatedRequirementTarget
    a owl:ObjectProperty ;
    rdfs:domain logic:MediatedPropertyRequirementAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "mediated requirement target"@x-gmeow-english ;
    skos:definition "Relates a logic:MediatedPropertyRequirementAssertion to the class whose focus nodes it constrains. Domain logic:MediatedPropertyRequirementAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:mediatedRequirementVia
    a owl:ObjectProperty ;
    rdfs:domain logic:MediatedPropertyRequirementAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "mediated requirement via"@x-gmeow-english ;
    skos:definition "Relates a logic:MediatedPropertyRequirementAssertion to the mediating property whose values must carry the required property. Domain logic:MediatedPropertyRequirementAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:mediatedRequirementProperty
    a owl:ObjectProperty ;
    rdfs:domain logic:MediatedPropertyRequirementAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "mediated requirement property"@x-gmeow-english ;
    skos:definition "Relates a logic:MediatedPropertyRequirementAssertion to the property each mediated value must declare at least once. Domain logic:MediatedPropertyRequirementAssertion; single-valued."@x-gmeow-english ;
    gmeow:graphBoxRole gmeow:boxRBox .

logic:inhabitationIntervalFrameRequirement
    a owl:NamedIndividual ,
        logic:MediatedPropertyRequirementAssertion ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "an inhabitation tenure's interval carries its temporal frame"@x-gmeow-english ;
    skos:definition "Asserts that every gmeow:TimeInterval a gmeow:InhabitationTenure scopes via gmeow:duringInterval must declare at least one gmeow:hasTemporalFrame — an interval asserted without its frame is ill-formed (Principle 11: the interval carries its frame). The native coherence gate raises a violation when a scoping interval lacks a frame."@x-gmeow-english ;
    logic:mediatedRequirementTarget gmeow:InhabitationTenure ;
    logic:mediatedRequirementVia gmeow:duringInterval ;
    logic:mediatedRequirementProperty gmeow:hasTemporalFrame ;
    logic:formalizes gmeow:hasTemporalFrame .

# ── A NET-NEW harvested integrity constraint (prose → enforced axiom) ─────────────
# The harvest mechanism run on a constraint that did NOT exist as an axiom before:
# the three mereological individuation kinds (logic:Collection, logic:FunctionalComplex,
# logic:Quantity) are pairwise disjoint. Their skos:definitions each contrast the
# three as distinct individuation modes (member count vs distinct functional roles
# vs constitution) — logic:FunctionalComplex's Definition literally says "Contrast
# logic:Collection (uniform members) and logic:Quantity (homogeneous stuff)" — yet
# none was asserted owl:disjointWith. This candidate harvests that prose into the
# pairwise owl:disjointWith axioms asserted above, which the native DL coherence
# gate reads directly: an individual typed into two of the three kinds is forced to
# owl:Nothing, so the harvested constraint is genuinely ENFORCED. Accepted through
# review with a positive case and a negative countermodel.

logic:cqFunctionalComplexKindDisjointHolds
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "individuation-kind disjointness holds"@x-gmeow-english ;
    skos:definition "The positive competency case the individuation-kind disjointness axioms must satisfy: an individual typed logic:FunctionalComplex and NOT also logic:Collection or logic:Quantity stays coherent — it is not forced to owl:Nothing — because a whole is individuated in exactly one of the three modes the prose contrasts."@x-gmeow-english .

logic:cqFunctionalComplexKindDisjointOverlapRejected
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "individuation-kind overlap is rejected"@x-gmeow-english ;
    skos:definition "The negative countermodel the individuation-kind disjointness axioms must respect: an individual typed BOTH logic:FunctionalComplex and logic:Collection is a violation — the native DL coherence gate forces it to owl:Nothing — so a whole individuated at once by distinct functional roles and by member count is not an admissible model. The boundary the harvested constraint enforces."@x-gmeow-english .

logic:candidateFunctionalComplexKindDisjoint
    a owl:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "individuation kinds are pairwise disjoint"@x-gmeow-english ;
    skos:definition "The net-new-enforcement formalization candidate that harvests the pairwise disjointness of the three mereological individuation kinds (logic:Collection, logic:FunctionalComplex, logic:Quantity) from their skos:definition prose into enforced owl:disjointWith integrity constraints: the demonstration that the harvest mechanism creates axioms that did NOT exist before, not merely a link to an already-typed one. None of the three was asserted owl:disjointWith on origin/main; the prose contrasts them as distinct individuation modes (logic:FunctionalComplex's Definition names both other kinds explicitly). Accepted through review (logic:reviewedBy logic:reviewerLogicFoundation) with a positive case (logic:cqFunctionalComplexKindDisjointHolds) and a negative countermodel (logic:cqFunctionalComplexKindDisjointOverlapRejected); its harvest back-link (logic:candidateFormalizes logic:FunctionalComplex, logic:candidateSourceField logic:ProseFieldDefinition) ties it to the exact prose, and logic:candidateSourceHash is the sha256 of that definition text so a later edit to the prose surfaces as drift. The native DL coherence gate reads the resulting owl:disjointWith directly, forcing a two-kind individual to owl:Nothing."@x-gmeow-english ;
    logic:candidateSourceHash "sha256:ae6ffde78c8d4cd93cdb0d06ee67fd15ab46573e7aa4f1fe5f2ee2dd209cb529"^^xsd:string ;
    logic:candidateExtractionProvenance "hand-harvested from the logic:FunctionalComplex skos:definition, which contrasts it against logic:Collection and logic:Quantity (design/LOGIC-FOUNDATION.md, §Typed formalization governance)"^^xsd:string ;
    logic:candidateScope "pairwise owl:disjointWith over the three mereological individuation kinds logic:Collection, logic:FunctionalComplex and logic:Quantity"^^xsd:string ;
    logic:candidateContract logic:StratifiedNAFProfile ;
    logic:candidateCategory logic:CategoryIntegrityConstraint ;
    logic:candidateLifecycle logic:CandidateAccepted ;
    logic:reviewedBy logic:reviewerLogicFoundation ;
    logic:candidatePositiveCase logic:cqFunctionalComplexKindDisjointHolds ;
    logic:candidateNegativeCase logic:cqFunctionalComplexKindDisjointOverlapRejected ;
    logic:candidateProjectionBehavior logic:SoundUnderApproximation ;
    logic:candidateSemanticRisk logic:RiskCoreContaminating ;
    logic:candidateFormalizes logic:FunctionalComplex ;
    logic:candidateSourceField logic:ProseFieldDefinition .

# ═══════════════════════════════════════════════════════════════════════════════
# THE FOUNDATIONAL PARTITION — governance for the top-class + occurrent + covering
# axioms
# ───────────────────────────────────────────────────────────────────────────────
# The foundational-partition axioms asserted above (top-sortal pairwise
# owl:disjointWith in the kernel; logic:Endurant ⊥ logic:Perdurant and
# logic:Event ⊥ logic:Situation here; the two class-covering logic:Formula
# disjunctions over gmeow:Entity and logic:Object) are each governed by a
# logic:FormalizationCandidate below, following the same harvest pattern as the central axioms
# (logic:candidateProperPartOfAsymmetric, logic:candidateFunctionalComplexKindDisjoint).
#
# Each candidate is accepted through review (logic:reviewedBy
# logic:reviewerLogicFoundation) and carries a positive/negative case pair. The
# harvest-linked ones (top-sortal disjointness, endurant/perdurant, and the
# deliberate social∩information overlap) tie back to the exact prose field they
# formalize via logic:candidateFormalizes + logic:candidateSourceField, and every
# logic:candidateSourceHash is the real sha256 of that source literal so a later
# prose edit surfaces as drift. Two candidates are NECESSARY-CONDITION coverings
# realized only in the OWL projection (owl:unionOf), disclosed in the loss ledger
# and NOT natively enforced (the monotone chase does not entail disjunctive
# covering); one candidate is a deliberate, reviewed NON-assertion of disjointness
# (logic:CategoryDeliberateOverlap) whose negative case is the countermodel that
# explains why the overlap must be preserved.

# ── 1. Top-sortal pairwise disjointness (net-new enforcement) ────────────────────
# The four kernel top sortals (gmeow:Agent, gmeow:InformationObject,
# gmeow:PhysicalObject, gmeow:SocialObject) are pairwise owl:disjointWith EXCEPT
# the deliberately-preserved SocialObject∩InformationObject overlap. gmeow:Agent ⊥
# gmeow:SocialObject is NET-NEW on this branch. The native DL coherence gate reads
# the owl:disjointWith directly: an individual typed into two disjoint top sortals
# is forced to owl:Nothing.

logic:cqTopSortalDisjointHolds
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "top-sortal disjointness holds"@x-gmeow-english ;
    skos:definition "The positive competency case the top-sortal disjointness axioms must satisfy: an individual typed into exactly one of the four kernel top sortals (gmeow:Agent, gmeow:InformationObject, gmeow:PhysicalObject, gmeow:SocialObject) stays coherent — it is not forced to owl:Nothing — because each thing is individuated under a single top sortal (save the deliberately-preserved social∩information overlap)."@x-gmeow-english .

logic:cqTopSortalDisjointClashRejected
    a owl:NamedIndividual ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "top-sortal clash is rejected"@x-gmeow-english ;
    skos:definition "The negative countermodel the top-sortal disjointness axioms must respect: an individual typed BOTH gmeow:Agent and gmeow:SocialObject is a violation — the native DL coherence gate forces it to owl:Nothing, because gmeow:Agent owl:disjointWith gmeow:SocialObject is asserted (net-new on this branch). A thing that both acts and bears responsibility yet exists purely by social convention is not an admissible model. The boundary the disjointness enforces."@x-gmeow-english .

logic:candidateTopSortalDisjoint
    a owl:NamedIndividual ,
        logic:FormalizationCandidate ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/logic> ;
    rdfs:label "top sortals are pairwise disjoint"@x-gmeow-english ;
