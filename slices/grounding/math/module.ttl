math:rieNot a logic:Formula ; logic:not math:rieExists .
math:rieExists a logic:Formula ;
    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "mt" ] , [ logic:termIndex 1 ; logic:termVariable "m" ] , [ logic:termIndex 2 ; logic:termVariable "q" ] ;
    logic:exists math:rieBody .
math:rieBody a logic:Formula ; logic:and math:rieA1 , math:rieA2 , math:rieA3 , math:rieA4 , math:rieA5 .
math:rieA1 a logic:Formula ; logic:relation math:metricSignature ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "mt" ] , [ logic:termIndex 1 ; logic:termVariable "this" ] .
math:rieA2 a logic:Formula ; logic:relation math:metricTensor ;
    logic:argument [ logic:termIndex 0 ; logic:termVariable "m" ] , [ logic:termIndex 1 ; logic:termVariable "mt" ] .
