#
# Declarative structural assertions for the events slice -- the
# slice-resident test-DSL twin of the asserted-TBox MUST / MUST-NOT invariants
# formerly hand-written in tests/test_events.py. Each assertion runs as a SPARQL
# ASK over the events module graph (gmeow:scopeModule) under the native Rust
# slicetest harness (crates/slicetest).
#
# Events IS migrated: class stereotypes are logic: (logic:Event, logic:Kind,
# logic:Relator, logic:AbstractIndividualType, logic:QualityValue), NOT gufo:.
#
# MIGRATED to declarative slicetest cells:
#   test_event_is_grounded_in_gufo_event -- the gmeow:Activity rdfs:subClassOf
#     gmeow:Event assertion moves to slices/core/provenance/tests/structural.ttl
#     because gmeow:Activity is defined there.
#   test_observational_activity_is_subclass_of_activity_and_event -- the
#     gmeow:ObservationalActivity rdfs:subClassOf gmeow:Activity assertion moves
#     to slices/core/events/tests/structural.ttl; Activity ⊑ Event stays in the
#     provenance slice.
#
# RETAINED here (not migratable to scopeModule cells):
#   test_former_event_types_are_individuals_not_classes -- dynamic sweep:
#     uses g.subjects(RDFS.subClassOf, GM.LifeEvent) over the whole merged graph
#     to catch any GMEOW-prefixed subclass resurrection; narrowing to the events
#     module would silently weaken the regression guard.
#   test_participation_mediation_axiom_present -- bnode walk: inspects
#     owl:Restriction blank nodes via g.objects() + g.items() to verify
#     someValuesFrom axioms; bnode list structure is not expressible as a
#     simple module-scoped ASK.
#   test_wellformed_participation_conforms -- SHACL validation call; ExampleConformance,
#     not a structural TBox assertion.
#   test_malformed_participation_is_flagged -- SHACL validation call with error-text
#     assertions; ExampleConformance, not a structural TBox assertion.
#   test_contested_event_claims_coexist_and_validate -- multi-file ABox fixture
#     loaded dynamically + SHACL validation + object sweep.
#   test_schema_role_projection_keys_by_role -- calls project_graph() on a
#     coverage fixture; generated-artifact projection check, not a TBox assertion.
#   test_schema_role_projection_suppresses_withdrawn_participation -- same as
#     above; displayable-false projection behaviour.
#   test_schema_fuzzy_time_projects_earliest_bound -- projection numeric check.
#   test_ical_vevent_interval_has_start_end_and_location -- projection check.
#   test_ical_vevent_point_has_start_only -- projection check.
#   test_ical_vevent_fuzzy_spans_the_bounds -- projection bound check.
#   test_ical_summary_is_the_event_type_label -- projection label check.
#   test_owl_time_projection_emits_pure_interval_relations -- calls project_graph()
#     and sweeps the output graph dynamically; projection check.
#   test_observational_activity_chain_on_was_associated_with -- bnode list walk:
#     inspects owl:propertyChainAxiom blank-node lists via g.objects() + g.items()
#     to verify the exact member order of generatedObservation + vantage.
#
# CROSS-SLICE migrated INTO this file (from tests/test_calendar.py):
#   test_organizer_and_attendee_roles_exist — gmeow:roleOrganizer and
#     gmeow:roleAttendee are defined in this events module, so the cell now lives
#     here as ex:saOrganizerAndAttendeeRolesExist.
#

@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix ex:    <https://blackcatinformatics.ca/gmeow/examples/events/tests/> .

# --- 1. Participation is a logic:Kind subclass of logic:Relator (MUST) ---------
ex:saParticipationIsKindRelator a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Participation a owl:Class , logic:Kind ;
        rdfs:subClassOf logic:Relator .
}""" ;
    gmeow:saRationale "gmeow:Participation MUST be an owl:Class typed logic:Kind and a subclass of logic:Relator -- the reified participation is a relator binding event, participant, and role." .

# --- 2. eventType is an ObjectProperty ranging over EventType, non-functional ---
ex:saEventTypePropertyShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:eventType a owl:ObjectProperty ;
        rdfs:range gmeow:EventType .
}""" ;
    gmeow:saRationale "gmeow:eventType MUST be an owl:ObjectProperty with rdfs:range gmeow:EventType -- type is a value, never a subclass (Principle 9)." .

# --- 3. eventType is NOT functional (MUST-NOT) ---------------------------------
ex:saEventTypeNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:eventType ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:eventType MUST NOT be owl:FunctionalProperty -- an occurrence may bear several types; competing standpoint-indexed type claims coexist (Principle 9)." .

# --- 4. participationRole is an ObjectProperty ranging over ParticipantRole ----
ex:saParticipationRolePropertyShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:participationRole a owl:ObjectProperty ;
        rdfs:range gmeow:ParticipantRole .
}""" ;
    gmeow:saRationale "gmeow:participationRole MUST be an owl:ObjectProperty with rdfs:range gmeow:ParticipantRole -- role is a value on a relator, never a subproperty (Principle 9)." .

# --- 5. Former role subproperties are not properties (MUST-NOT) ----------------
ex:saFormerRoleSubpropertiesGone a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p { gmeow:hasPrincipal gmeow:hasWitness gmeow:hasOfficiant }
    VALUES ?t { owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty }
    ?p a ?t .
}""" ;
    gmeow:saRationale "gmeow:hasPrincipal, gmeow:hasWitness, and gmeow:hasOfficiant MUST NOT exist as any property type -- the former genealogy subproperties were permanently refactored to ParticipantRole value individuals." .

# --- 6. Former role subproperties are not subPropertyOf hasParticipant ----------
ex:saFormerRolesNotSubproperties a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    VALUES ?p { gmeow:hasPrincipal gmeow:hasWitness gmeow:hasOfficiant }
    ?p rdfs:subPropertyOf gmeow:hasParticipant .
}""" ;
    gmeow:saRationale "gmeow:hasPrincipal, gmeow:hasWitness, and gmeow:hasOfficiant MUST NOT be subproperties of gmeow:hasParticipant -- the genealogy subproperty taxonomy is permanently gone (Principle 6)." .

# --- 7. Role value individuals exist (MUST) ------------------------------------
ex:saRoleValueIndividualsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:roleParticipantPrincipal a gmeow:ParticipantRole .
    gmeow:roleWitness              a gmeow:ParticipantRole .
    gmeow:roleOfficiant            a gmeow:ParticipantRole .
}""" ;
    gmeow:saRationale "The three former genealogy role subproperties MUST now exist as gmeow:ParticipantRole individuals." .

# --- 8. Former flat properties eventDate and eventPlace are gone (MUST-NOT) ----
ex:saFormerFlatPropertiesGone a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?p { gmeow:eventDate gmeow:eventPlace }
    VALUES ?t { owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty }
    ?p a ?t .
}""" ;
    gmeow:saRationale "gmeow:eventDate and gmeow:eventPlace MUST NOT exist as any property type -- the free-text flat properties were replaced by structured gmeow:eventTime, gmeow:eventInterval, and gmeow:eventLocation." .

# --- 9. Structured temporal replacement eventTime exists (MUST) ----------------
ex:saEventTimeIsDatatypeProperty a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:eventTime a owl:DatatypeProperty . }""" ;
    gmeow:saRationale "gmeow:eventTime MUST be an owl:DatatypeProperty -- the DL-clean xsd:dateTime replacement for the retired free-text gmeow:eventDate." .

# --- 10. eventLocation exists and ranges over Location (MUST) ------------------
ex:saEventLocationPropertyShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:eventLocation a owl:ObjectProperty ;
        rdfs:range gmeow:Location .
}""" ;
    gmeow:saRationale "gmeow:eventLocation MUST be an owl:ObjectProperty with rdfs:range gmeow:Location -- the structured replacement for the retired free-text gmeow:eventPlace." .

# --- 11. eventTrajectory shape and non-functional (MUST + MUST-NOT) ------------
ex:saEventTrajectoryShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:eventTrajectory a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:Trajectory .
}""" ;
    gmeow:saRationale "gmeow:eventTrajectory MUST be an owl:ObjectProperty with domain Event and range Trajectory -- competing trajectory claims coexist (Principle 9)." .

# --- 12. eventTrajectory is NOT functional (MUST-NOT) --------------------------
ex:saEventTrajectoryNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:eventTrajectory ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:eventTrajectory MUST NOT be owl:FunctionalProperty -- competing trajectory claims from different sources coexist." .

# --- 13. eventSpacetime shape and non-functional (MUST + MUST-NOT) -------------
ex:saEventSpacetimeShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:eventSpacetime a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:LocationState .
}""" ;
    gmeow:saRationale "gmeow:eventSpacetime MUST be an owl:ObjectProperty with domain Event and range LocationState -- reuses the 4D location-state facility (trajectory design)." .

# --- 14. eventSpacetime is NOT functional (MUST-NOT) ---------------------------
ex:saEventSpacetimeNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:eventSpacetime ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:eventSpacetime MUST NOT be owl:FunctionalProperty -- multiple spacetime slices may coexist for the same event." .

# --- 15. Spacetime/trajectory axes are orthogonal -- no subPropertyOf (MUST-NOT)
ex:saSpacetimeAxesOrthogonal a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?a { gmeow:eventSpacetime gmeow:eventTrajectory
                gmeow:eventLocation  gmeow:eventInterval }
    VALUES ?b { gmeow:eventSpacetime gmeow:eventTrajectory
                gmeow:eventLocation  gmeow:eventInterval }
    FILTER (?a != ?b)
    { ?a rdfs:subPropertyOf ?b } UNION
    { ?a owl:equivalentProperty ?b }
}""" ;
    gmeow:saRationale "No inferential bridge (subPropertyOf or equivalentProperty) MUST NOT exist between eventSpacetime, eventTrajectory, eventLocation, and eventInterval -- each is an independent assertion axis." .

# --- 16. eventType ranges over only EventType (MUST) --------------------------
ex:saEventTypeRangeExact a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:eventType rdfs:range gmeow:EventType . }""" ;
    gmeow:saRationale "gmeow:eventType MUST have rdfs:range gmeow:EventType (and only that range)." .

# --- 17. participationRole ranges over only ParticipantRole (MUST) -------------
ex:saParticipationRoleRangeExact a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:participationRole rdfs:range gmeow:ParticipantRole . }""" ;
    gmeow:saRationale "gmeow:participationRole MUST have rdfs:range gmeow:ParticipantRole." .

# --- 18. eventTime ranges over xsd:dateTime (MUST) ----------------------------
ex:saEventTimeRangeDateTime a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:eventTime rdfs:range xsd:dateTime . }""" ;
    gmeow:saRationale "gmeow:eventTime MUST have rdfs:range xsd:dateTime (DL-clean, never xsd:date)." .

# --- 19. eventTime does NOT range over xsd:date (MUST-NOT) --------------------
ex:saEventTimeNotRangeDate a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:eventTime rdfs:range xsd:date . }""" ;
    gmeow:saRationale "gmeow:eventTime MUST NOT range over xsd:date -- not in the OWL 2 datatype map (Principle 3)." .

# --- 20. earliestStart ranges over xsd:dateTime (MUST) ------------------------
ex:saEarliestStartRangeDateTime a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:earliestStart rdfs:range xsd:dateTime . }""" ;
    gmeow:saRationale "gmeow:earliestStart MUST have rdfs:range xsd:dateTime (DL-clean)." .

# --- 21. earliestStart does NOT range over xsd:date (MUST-NOT) ----------------
ex:saEarliestStartNotRangeDate a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:earliestStart rdfs:range xsd:date . }""" ;
    gmeow:saRationale "gmeow:earliestStart MUST NOT range over xsd:date (Principle 3)." .

# --- 22. latestEnd ranges over xsd:dateTime (MUST) ----------------------------
ex:saLatestEndRangeDateTime a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:latestEnd rdfs:range xsd:dateTime . }""" ;
    gmeow:saRationale "gmeow:latestEnd MUST have rdfs:range xsd:dateTime (DL-clean)." .

# --- 23. latestEnd does NOT range over xsd:date (MUST-NOT) --------------------
ex:saLatestEndNotRangeDate a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:latestEnd rdfs:range xsd:date . }""" ;
    gmeow:saRationale "gmeow:latestEnd MUST NOT range over xsd:date (Principle 3)." .

# --- 24. eventLocation ranges over Location (MUST) ----------------------------
ex:saEventLocationRangeLocation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:eventLocation rdfs:range gmeow:Location . }""" ;
    gmeow:saRationale "gmeow:eventLocation MUST have rdfs:range gmeow:Location." .

# --- 24b. The four axes range over EXACTLY their one space (MUST-NOT extra range) ---
# (test_axes_range_over_distinct_spaces asserts set(g.objects(prop, rdfs:range)) == {one}
#  — exact equality, so any SECOND range is forbidden. The four MUST cells above pin the
#  expected range; these MUST-NOT cells pin that there is no OTHER range.)
ex:saEventTypeRangeOnly a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:eventType rdfs:range ?r . FILTER(?r != gmeow:EventType) }""" ;
    gmeow:saRationale "gmeow:eventType MUST NOT carry any rdfs:range other than gmeow:EventType (the exact-range arm of the range-axis discipline)." .

ex:saParticipationRoleRangeOnly a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:participationRole rdfs:range ?r . FILTER(?r != gmeow:ParticipantRole) }""" ;
    gmeow:saRationale "gmeow:participationRole MUST NOT carry any rdfs:range other than gmeow:ParticipantRole (exact-range arm)." .

ex:saEventTimeRangeOnly a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:eventTime rdfs:range ?r . FILTER(?r != xsd:dateTime) }""" ;
    gmeow:saRationale "gmeow:eventTime MUST NOT carry any rdfs:range other than xsd:dateTime (exact-range arm; subsumes the never-xsd:date guard)." .

ex:saEventLocationRangeOnly a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:eventLocation rdfs:range ?r . FILTER(?r != gmeow:Location) }""" ;
    gmeow:saRationale "gmeow:eventLocation MUST NOT carry any rdfs:range other than gmeow:Location (exact-range arm)." .

# --- 25. Four event axes have no inferential bridge (MUST-NOT) ----------------
ex:saFourAxesOrthogonal a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?a { gmeow:eventType gmeow:participationRole
                gmeow:eventTime gmeow:eventLocation }
    VALUES ?b { gmeow:eventType gmeow:participationRole
                gmeow:eventTime gmeow:eventLocation }
    FILTER (?a != ?b)
    { ?a rdfs:subPropertyOf ?b } UNION
    { ?a owl:equivalentProperty ?b }
}""" ;
    gmeow:saRationale "No inferential bridge MUST NOT exist between eventType, participationRole, eventTime, and eventLocation -- four orthogonal independent axes." .

# --- 26. Participant role seed individuals exist (MUST) -----------------------
ex:saParticipantRoleSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:roleParticipantPrincipal a gmeow:ParticipantRole .
    gmeow:roleOrganizer            a gmeow:ParticipantRole .
    gmeow:roleAttendee             a gmeow:ParticipantRole .
    gmeow:rolePerformer            a gmeow:ParticipantRole .
    gmeow:roleOfficiant            a gmeow:ParticipantRole .
    gmeow:roleWitness              a gmeow:ParticipantRole .
    gmeow:roleVictim               a gmeow:ParticipantRole .
    gmeow:roleAgent                a gmeow:ParticipantRole .
    gmeow:roleBeneficiary          a gmeow:ParticipantRole .
}""" ;
    gmeow:saRationale "The nine core ParticipantRole seed individuals MUST be present as gmeow:ParticipantRole individuals (open vocabulary -- superset check)." .

# --- 27. Temporal precision seed individuals exist (MUST) ---------------------
ex:saTemporalPrecisionSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:precisionDay    a gmeow:TemporalPrecision .
    gmeow:precisionMonth  a gmeow:TemporalPrecision .
    gmeow:precisionYear   a gmeow:TemporalPrecision .
    gmeow:precisionDecade a gmeow:TemporalPrecision .
    gmeow:precisionCirca  a gmeow:TemporalPrecision .
}""" ;
    gmeow:saRationale "The five core TemporalPrecision seed individuals MUST be present (open vocabulary -- superset check)." .

# --- 28. subEventOf and hasSubEvent are transitive (MUST) ---------------------
ex:saSubEventMereologyTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:subEventOf  a owl:TransitiveProperty .
    gmeow:hasSubEvent a owl:TransitiveProperty .
}""" ;
    gmeow:saRationale "gmeow:subEventOf and gmeow:hasSubEvent MUST be owl:TransitiveProperty -- mereological part-of is transitive; the closure enables whole-event queries across nested hierarchies." .

# --- 29. subEventOf is NOT functional (MUST-NOT) ------------------------------
ex:saSubEventOfNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:subEventOf ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:subEventOf MUST NOT be owl:FunctionalProperty -- non-simple (transitive) properties are forbidden in OWL 2 DL cardinality/functional axioms (regularity)." .

# --- 30. No primary/preferred event terms exist (MUST-NOT) --------------------
ex:saNoPreferredPrimaryEventTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned {
        gmeow:primaryEventType gmeow:preferredEventType
        gmeow:primaryParticipant gmeow:preferredParticipant
        gmeow:primaryClaim gmeow:preferredRank
    }
    VALUES ?t { owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty owl:Class }
    ?banned a ?t .
}""" ;
    gmeow:saRationale "No primary*/preferred* selector for event type, participant, claim, or rank MUST NOT exist as any property or class -- co-equality (Principle 9)." .

# --- 31. All 13 Allen relations exist on Event (MUST) --------------------------
ex:saAllenRelationsExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:before        a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:after         a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:meets         a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:metBy         a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:overlaps      a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:overlappedBy  a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:starts        a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:startedBy     a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:during        a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:contains      a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:finishes      a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:finishedBy    a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
    gmeow:coincidesWith a owl:ObjectProperty ; rdfs:domain gmeow:Event ; rdfs:range gmeow:Event .
}""" ;
    gmeow:saRationale "All 13 Allen interval-algebra relations MUST be owl:ObjectProperty with domain and range gmeow:Event -- the full OWL-Time / TEO / ISO-TimeML interop surface." .

# --- 32. Transitive Allen relations are transitive (MUST) ---------------------
ex:saAllenTransitiveRelations a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:before        a owl:TransitiveProperty .
    gmeow:after         a owl:TransitiveProperty .
    gmeow:during        a owl:TransitiveProperty .
    gmeow:contains      a owl:TransitiveProperty .
    gmeow:coincidesWith a owl:TransitiveProperty .
}""" ;
    gmeow:saRationale "gmeow:before, after, during, contains, and coincidesWith MUST be owl:TransitiveProperty -- the Allen composition table rules." .

# --- 33. coincidesWith is symmetric (MUST) ------------------------------------
ex:saCoincidesWith_Symmetric a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:coincidesWith a owl:SymmetricProperty . }""" ;
    gmeow:saRationale "gmeow:coincidesWith MUST be owl:SymmetricProperty -- the Allen EQUALS relation is symmetric by definition (co-temporality)." .

# --- 34. Allen inverse pairs are declared (MUST) ------------------------------
ex:saAllenInversePairs a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    { { gmeow:before       owl:inverseOf gmeow:after        } UNION { gmeow:after        owl:inverseOf gmeow:before       } }
    { { gmeow:meets        owl:inverseOf gmeow:metBy        } UNION { gmeow:metBy        owl:inverseOf gmeow:meets        } }
    { { gmeow:overlaps     owl:inverseOf gmeow:overlappedBy } UNION { gmeow:overlappedBy owl:inverseOf gmeow:overlaps     } }
    { { gmeow:starts       owl:inverseOf gmeow:startedBy    } UNION { gmeow:startedBy    owl:inverseOf gmeow:starts       } }
    { { gmeow:during       owl:inverseOf gmeow:contains     } UNION { gmeow:contains     owl:inverseOf gmeow:during       } }
    { { gmeow:finishes     owl:inverseOf gmeow:finishedBy   } UNION { gmeow:finishedBy   owl:inverseOf gmeow:finishes     } }
}""" ;
    gmeow:saRationale "All six Allen inverse pairs (before/after, meets/metBy, overlaps/overlappedBy, starts/startedBy, during/contains, finishes/finishedBy) MUST be declared via owl:inverseOf (in either direction)." .

# --- 35. No Allen relation is functional (MUST-NOT) ---------------------------
ex:saAllenRelationsNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK {
    VALUES ?p {
        gmeow:before gmeow:after gmeow:meets gmeow:metBy
        gmeow:overlaps gmeow:overlappedBy gmeow:starts gmeow:startedBy
        gmeow:during gmeow:contains gmeow:finishes gmeow:finishedBy
        gmeow:coincidesWith
    }
    ?rec logic:characterizes ?p ; logic:characteristicSort logic:functionalProperty .
}""" ;
    gmeow:saRationale "No Allen relation MUST NOT be owl:FunctionalProperty -- non-simple (transitive or symmetric) properties violate OWL 2 DL regularity in cardinality axioms." .

# --- 36. Duration, durationValue, RecurrenceRule, hasRecurrenceRule (MUST) ----
ex:saDurationAndRecurrenceTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:Duration a owl:Class .
    gmeow:durationValue rdfs:range xsd:duration .
    gmeow:RecurrenceRule rdfs:subClassOf gmeow:InformationObject .
    gmeow:hasRecurrenceRule rdfs:domain gmeow:EventSeries .
}""" ;
    gmeow:saRationale "gmeow:Duration (class), gmeow:durationValue (xsd:duration range), gmeow:RecurrenceRule (subClassOf InformationObject), and gmeow:hasRecurrenceRule (domain EventSeries) MUST all be present." .

# --- 37. GrammaticalTense seed individuals exist (MUST) -----------------------
ex:saGrammaticalTenseSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:tensePast    a gmeow:GrammaticalTense .
    gmeow:tensePresent a gmeow:GrammaticalTense .
    gmeow:tenseFuture  a gmeow:GrammaticalTense .
    gmeow:tenseNone    a gmeow:GrammaticalTense .
}""" ;
    gmeow:saRationale "The four GrammaticalTense seed individuals MUST exist (ISO-TimeML @tense vocabulary)." .

# --- 38. GrammaticalAspect seed individuals exist (MUST) ----------------------
ex:saGrammaticalAspectSeeds a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:aspectPerfective  a gmeow:GrammaticalAspect .
    gmeow:aspectProgressive a gmeow:GrammaticalAspect .
    gmeow:aspectNone        a gmeow:GrammaticalAspect .
}""" ;
    gmeow:saRationale "The three core GrammaticalAspect seed individuals MUST exist (ISO-TimeML @aspect vocabulary)." .

# --- 39. eventTense not subPropertyOf eventTime (MUST-NOT) --------------------
ex:saEventTenseNotSubpropertyEventTime a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:eventTense rdfs:subPropertyOf gmeow:eventTime . }""" ;
    gmeow:saRationale "gmeow:eventTense MUST NOT be rdfs:subPropertyOf gmeow:eventTime -- tense is a linguistic-realization annotation axis, never inferred from temporal placement." .

# --- 40. eventAspect not subPropertyOf eventTime (MUST-NOT) -------------------
ex:saEventAspectNotSubpropertyEventTime a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:eventAspect rdfs:subPropertyOf gmeow:eventTime . }""" ;
    gmeow:saRationale "gmeow:eventAspect MUST NOT be rdfs:subPropertyOf gmeow:eventTime -- aspect is a linguistic-realization annotation axis, never inferred from temporal placement." .

# --- 41. ObservationalActivity is NOT a subclass of Observation (MUST-NOT) ----
ex:saObservationalActivityNotSubclassObservation a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:ObservationalActivity rdfs:subClassOf gmeow:Observation . }""" ;
    gmeow:saRationale "gmeow:ObservationalActivity MUST NOT be rdfs:subClassOf gmeow:Observation -- it is an Event/Activity, not an Observation (the taxonomic placement is the event stack, not the observation stack)." .

# --- 42. generatedObservation shape and DL-regularity (MUST + MUST-NOT) -------
ex:saGeneratedObservationShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:generatedObservation a owl:ObjectProperty ;
        rdfs:domain gmeow:ObservationalActivity ;
        rdfs:range gmeow:Observation .
}""" ;
    gmeow:saRationale "gmeow:generatedObservation MUST be an owl:ObjectProperty with domain ObservationalActivity and range Observation." .

# --- 43. generatedObservation is not transitive (MUST-NOT) --------------------
ex:saGeneratedObservationNotTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:generatedObservation a owl:TransitiveProperty . }""" ;
    gmeow:saRationale "gmeow:generatedObservation MUST NOT be owl:TransitiveProperty -- must be a simple property for OWL 2 DL regularity." .

# --- 44. generatedObservation is not symmetric (MUST-NOT) ---------------------
ex:saGeneratedObservationNotSymmetric a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:generatedObservation a owl:SymmetricProperty . }""" ;
    gmeow:saRationale "gmeow:generatedObservation MUST NOT be owl:SymmetricProperty -- activities generate observations, not vice versa." .

# --- 45. generatedObservation is not functional (MUST-NOT) --------------------
ex:saGeneratedObservationNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:generatedObservation ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:generatedObservation MUST NOT be owl:FunctionalProperty -- an observational activity may produce many observations." .

# --- 46. eventObservation shape and inverse of observationEvent (MUST) --------
ex:saEventObservationShape a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:eventObservation a owl:ObjectProperty ;
        rdfs:domain gmeow:Event ;
        rdfs:range gmeow:Observation .
    { gmeow:eventObservation owl:inverseOf gmeow:observationEvent } UNION
    { gmeow:observationEvent owl:inverseOf gmeow:eventObservation }
}""" ;
    gmeow:saRationale "gmeow:eventObservation MUST be an owl:ObjectProperty with domain Event, range Observation, and inverse of gmeow:observationEvent (in either direction)." .

# --- 47. eventObservation is not functional (MUST-NOT) ------------------------
ex:saEventObservationNotFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
ASK { ?rec logic:characterizes gmeow:eventObservation ; logic:characteristicSort logic:functionalProperty . }""" ;
    gmeow:saRationale "gmeow:eventObservation MUST NOT be owl:FunctionalProperty -- an event may have many observations; competing standpoint-indexed observations coexist (Principle 9)." .

# --- 48. Observational event type value individuals exist (MUST) ---------------
ex:saObservationalEventTypeIndividuals a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:eventTypeCensusActivity a gmeow:EventType .
    gmeow:eventTypeSurvey         a gmeow:EventType .
    gmeow:eventTypeExcavation     a gmeow:EventType .
    gmeow:eventTypeAudit          a gmeow:EventType .
    gmeow:eventTypeClinicalTrial  a gmeow:EventType .
}""" ;
    gmeow:saRationale "The five observational activity event type seed individuals MUST be present as gmeow:EventType values, not classes (Principle 9, anti-subclass guard)." .

# --- 49. Observational event types are NOT classes (MUST-NOT) -----------------
ex:saObservationalEventTypesNotClasses a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?et {
        gmeow:eventTypeCensusActivity gmeow:eventTypeSurvey
        gmeow:eventTypeExcavation     gmeow:eventTypeAudit
        gmeow:eventTypeClinicalTrial
    }
    ?et a owl:Class .
}""" ;
    gmeow:saRationale "The five observational event type individuals MUST NOT be typed owl:Class -- the anti-subclass guard for the observational types." .

# --- 50. eventTypeCensus still exists (MUST) ----------------------------------
ex:saEventTypeCensusExists a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK { gmeow:eventTypeCensus a gmeow:EventType . }""" ;
    gmeow:saRationale "gmeow:eventTypeCensus (person-enumeration-in-a-census) MUST still be present — backward-existence guard against the distinct gmeow:eventTypeCensusActivity." .

# --- 51. No primary/preferred observation or activity terms (MUST-NOT) --------
ex:saNoPreferredPrimaryObservationTerms a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    VALUES ?banned {
        gmeow:primaryObservation gmeow:preferredObservation
        gmeow:primaryActivity    gmeow:preferredActivity
    }
    VALUES ?t { owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty owl:Class }
    ?banned a ?t .
}""" ;
    gmeow:saRationale "No primary*/preferred* selector for observations or activities MUST NOT exist -- co-equality (Principle 9)." .

# --- 52. causalPartOf is transitive (MUST) ------------------------------------
ex:saCausalPartOfTransitive a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK { gmeow:causalPartOf a owl:TransitiveProperty . }""" ;
    gmeow:saRationale "gmeow:causalPartOf MUST be owl:TransitiveProperty -- causal contribution chains through nested occurrences (causal feedback loops are legal, so it is deliberately NOT asymmetric or irreflexive)." .

# --- 53. causalPartOf subPropertyOf subEventOf (causal subset-of temporal, MUST) ---
ex:saCausalPartOfSubEventOf a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:causalPartOf rdfs:subPropertyOf gmeow:subEventOf . }""" ;
    gmeow:saRationale "gmeow:causalPartOf MUST be rdfs:subPropertyOf gmeow:subEventOf -- every causal part is also a temporal sub-event of the same whole (causal subset-of temporal); the converse does not hold." .

# --- 54. causalPartOf grounds in logic:causalPartOf (foundation grounding, MUST) ---
ex:saCausalPartOfGroundsLogic a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:causalPartOf rdfs:subPropertyOf logic:causalPartOf . }""" ;
    gmeow:saRationale "gmeow:causalPartOf MUST be rdfs:subPropertyOf logic:causalPartOf -- the domain-level term grounds in the foundational logic layer so the foundation rules lift it to logic:temporalPartOf." .

# --- 55. hasCausalPart is the inverse of causalPartOf (MUST) -------------------
ex:saHasCausalPartInverse a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    { gmeow:hasCausalPart owl:inverseOf gmeow:causalPartOf } UNION
    { gmeow:causalPartOf owl:inverseOf gmeow:hasCausalPart }
}""" ;
    gmeow:saRationale "gmeow:hasCausalPart MUST be the owl:inverseOf gmeow:causalPartOf (in either direction) -- the whole-rooted causal-decomposition view of the part-rooted relation." .

# --- 56. causalPartOf is orthogonal to the temporal Allen during (MUST-NOT) ----
ex:saCausalPartOfNotDuring a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:mustNot ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK { gmeow:causalPartOf rdfs:subPropertyOf gmeow:during . }""" ;
    gmeow:saRationale "gmeow:causalPartOf MUST NOT be rdfs:subPropertyOf gmeow:during -- causal mereology is orthogonal to the TEMPORAL Allen DURING relation, which only orders extents and implies nothing causal." .

# --- 57. subEventOf specializes the universal partOf spine (MUST) ------------
ex:saSubEventOfSpecializesPartOf a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:subEventOf rdfs:subPropertyOf gmeow:partOf .
}""" ;
    gmeow:saRationale "gmeow:subEventOf MUST be rdfs:subPropertyOf gmeow:partOf -- event decomposition specializes the universal part-to-whole spine." .

# --- 58. hasSubEvent specializes the universal hasPart spine (MUST) ------------
ex:saHasSubEventSpecializesHasPart a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:hasSubEvent rdfs:subPropertyOf gmeow:hasPart .
}""" ;
    gmeow:saRationale "gmeow:hasSubEvent MUST be rdfs:subPropertyOf gmeow:hasPart -- whole-to-sub-event decomposition specializes the universal has-part spine." .

# --- 57. Organizer and attendee roles exist as ParticipantRole values (MUST) -
# Cross-slice: the calendar slice reuses these role individuals; they are
# defined in this events module, so the assertion belongs here.
ex:saOrganizerAndAttendeeRolesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:roleOrganizer a gmeow:ParticipantRole .
    gmeow:roleAttendee  a gmeow:ParticipantRole .
}""" ;
    gmeow:saRationale "gmeow:roleOrganizer and gmeow:roleAttendee MUST exist as gmeow:ParticipantRole individuals — the calendar slice reuses these event-defined role values (iCal ATTENDEE / ORGANIZER)." .

# --- 57. Creation event type individuals exist (MUST) -------------------------
# Migrated from tests/test_creative_works.py (cross-slice: subjects defined here).
ex:saCreationEventTypesExist a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
ASK {
    gmeow:eventTypeWorkConception a gmeow:EventType .
    gmeow:eventTypeExpressionCreation a gmeow:EventType .
    gmeow:eventTypeManifestationProduction a gmeow:EventType .
}""" ;
    gmeow:saRationale "gmeow:eventTypeWorkConception, gmeow:eventTypeExpressionCreation, and gmeow:eventTypeManifestationProduction MUST each be an individual of gmeow:EventType. These WEMI creation-event type values are defined in the events slice." .

# --- 58. ObservationalActivity is a subclass of Activity (MUST) ---------------
# Migrated from tests/test_events.py (cross-slice: subject defined here; Activity
# is defined in the provenance slice).
ex:saObservationalActivityIsSubclassOfActivity a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX logic: <https://blackcatinformatics.ca/logic/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
ASK {
    gmeow:ObservationalActivity a owl:Class , logic:Event ;
        rdfs:subClassOf gmeow:Activity .
}""" ;
    gmeow:saRationale "gmeow:ObservationalActivity MUST be an owl:Class typed logic:Event and a direct subclass of gmeow:Activity. The subject is defined in the events slice; gmeow:Activity itself is in the provenance slice, so this is a cross-slice structural assertion authored in the subject's owning slice." .
