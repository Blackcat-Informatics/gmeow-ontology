ASK {
    gmeow:hasCelestialCoordinates a owl:ObjectProperty ;
        rdfs:domain gmeow:CelestialLocation ;
        rdfs:range  gmeow:CelestialCoordinates .
}""" ;
    gmeow:saRationale "gmeow:hasCelestialCoordinates MUST be an owl:ObjectProperty with domain CelestialLocation and range CelestialCoordinates." .

# --- 88. ICRS binds hasReferencePosition and hasTimeScale (MUST) --------------
ex:saRefposAndTimescaleFunctional a gmeow:StructuralAssertion ;
    gmeow:saPolarity gmeow:must ;
    gmeow:saScope gmeow:scopeModule ;
    gmeow:saPattern """PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
ASK {
    gmeow:referenceFrameICRS gmeow:hasReferencePosition gmeow:refOriginBarycentric .
    gmeow:referenceFrameICRS gmeow:hasTimeScale         gmeow:timeScaleTDB .
}""" ;
    gmeow:saRationale "gmeow:referenceFrameICRS MUST be bound to refOriginBarycentric via hasReferencePosition and to timeScaleTDB via hasTimeScale (the functionality of hasReferencePosition/hasTimeScale is now carried by logic:PropertyCharacteristicAssertions, DL-enforced)." .

