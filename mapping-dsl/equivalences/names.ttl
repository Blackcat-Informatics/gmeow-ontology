# Pronoun linkage — Wikidata's 'personal pronoun set' model (verified live against
# the Wikidata API). closeMatch, not exactMatch: GMEOW carries the full five-form
# declension, Wikidata's P6553 values are lexemes. broadMatch to the grammatical
# 'pronoun' concept is a hint, never materialized by saturation.
gmeow:eqNames031 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:PronounSet ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wd:Q65067284 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Wikidata 'personal pronoun set' — third-person pronouns an individual wants used; its Sept-2025 RfC favours full five-form declension sets, converging on GMEOW's model" ;
    gmeow:sssomFile "gmeow-names.sssom.tsv" .

gmeow:eqNames032 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:hasPronounSet ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject wdt:P6553 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Wikidata 'personal pronoun' property (P6553); lossy — its values are lexemes, GMEOW's range is the full five-form PronounSet" ;
    gmeow:sssomFile "gmeow-names.sssom.tsv" .

gmeow:eqNames033 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:PronounSet ;
    gmeow:alignPredicate skos:broadMatch ;
    gmeow:alignObject wd:Q36224 ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.5 ;
    gmeow:comment "Wikidata 'pronoun' — broader grammatical category; a hint, not an equivalence" ;
    gmeow:sssomFile "gmeow-names.sssom.tsv" .
