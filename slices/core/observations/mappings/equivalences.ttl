@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix iso19156: <http://www.isotc211.org/iso19156/> .
@prefix crmarc: <http://www.cidoc-crm.org/crmarchaeo/> .
@prefix om: <http://www.wurvoc.org/vocabularies/om-1.8/> .
@prefix oboe: <http://ecoinformatics.org/oboe/oboe.1.2/oboe-core.owl#> .
@prefix pato: <http://purl.obolibrary.org/obo/PATO_> .
@prefix obi: <http://purl.obolibrary.org/obo/OBI_> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix obscore: <http://www.ivoa.net/rdf/ObsCore#> .
@prefix bbc: <http://www.bbc.co.uk/ontologies/news/> .
@prefix iptc: <http://iptc.org/std/NewsML-G2/> .
@prefix loinc: <http://loinc.org/rdf/> .
@prefix snomed: <http://snomed.info/id/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix fibo-fnd-acc-cur: <https://spec.edmcouncil.org/fibo/ontology/FND/Accounting/CurrencyAmount/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .

# Term equivalences for the observation domain — GMEOW authoring source.
# Compiled to mappings/gmeow-observations.sssom.tsv by `gmeow compile-mappings`.
# Aligns SOSA/SSN (W3C/OGC), PROV-O (W3C), CIDOC-CRM E13 (ISO 21127),
# O&M (ISO 19156), CRMarchaeo, OM (Ontology of Units of Measure), OBOE,
# PATO, OBI, and QB.

gmeow:mapsetObservations a gmeow:MappingSet ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" ;
    gmeow:setId "https://blackcatinformatics.ca/gmeow/mappings/observations" ;
    gmeow:license "https://creativecommons.org/licenses/by/4.0/" ;
    gmeow:setComment "Observation stack alignments: SOSA/SSN, PROV-O, CIDOC-CRM E13. The gmeow:vantage property has no direct SOSA counterpart (sosa:madeBySensor is device-centric, not standpoint-centric); the alignment is closeMatch with a note. math:Quantity and math:quantityValue are the sole quantity/value authorities; their SOSA, OM, IVOA, LOINC, and QUDT grounding correspondences are authored by the math slice in mappings/quantity-bridges.ttl, while this catalog owns observation qualifiers and domain roles. Added: StandpointClaim → sosa:Observation; Agent → sosa:Sensor (the observer/sensor/perceiver is a standpoint). Added (observation-spine bridge): IdentityFacet, NameUsage, RightsStatement, and KinRelationship → sosa:Observation (universal claim construct); facetSubject / facetVantage → sosa:hasFeatureOfInterest / sosa:madeBySensor. Added (stream-to-trajectory design): Stream → sosa:ObservationCollection; streamSample → sosa:hasMember; Agent → sosa:Platform; streamSensor → sosa:madeBySensor; streamInterval → sosa:phenomenonTime; Observation → sosa:Sampling. Added (spatial-measurement design): SpatialMeasurement and CoordinateObservation → sosa:Observation, iso19156:OM_Observation / OM_GeometryObservation, crmarc:S4_Observation; coordinateResult / geometryResult → sosa:hasResult. Added (sensory slice): Sensor → sosa:Sensor (precise alignment, superseding Agent broadMatch); SensorPlatform → sosa:Platform (precise alignment, superseding Agent relatedMatch); ObservableProperty → sosa:ObservableProperty; SensoryQuantity → sosa:Result; sensoryProperty → sosa:observedProperty; platformLocation → geo:location; Sensor → obi:device; observationMethod → oboe:Protocol / obi:assay; ObservableProperty → oboe:Characteristic / pato:quality; SensoryObservation → qb:Observation; unit → om:hasUnit.".

# --------------------------------------------------------------------------- #
# SOSA / SSN
# --------------------------------------------------------------------------- #

gmeow:eqObs001 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Observation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs002 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:observedFeature ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:hasFeatureOfInterest ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.95 ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs003 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:observationResult ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:hasResult ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs004 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:vantage ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:madeBySensor ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "SOSA is device-centric; gmeow:vantage covers human standpoints, organizations, and sensors alike. CloseMatch with a note." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs005 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:observationMethod ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:usedProcedure ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs006 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ObservationMethod ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Procedure ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs007 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Measurement ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "A Measurement is a kind of Observation; SOSA does not distinguish them." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs017 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:StandpointClaim ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "SOSA does not distinguish observation types; a standpoint claim is a kind of observation, and the standpoint-indexed statement realises sosa:Observation." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs018 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Agent ;
    gmeow:alignPredicate skos:broadMatch ;
    gmeow:alignObject sosa:Sensor ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "An agent acting as vantage/observer/perceiver IS a standpoint (Principle 9). sosa:Sensor is device-centric and narrower; the alignment bridges the SOSA sensor concept to the broader GMEOW agent-as-standpoint doctrine." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# Added (observation-spine bridge) — universal claim construct: all relator subclasses align to SOSA.
gmeow:eqObs020 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:IdentityFacet ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "SOSA does not distinguish observation types; an identity claim (gender, expression, orientation) is a kind of observation in the universal stack." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs021 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:NameUsage ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "SOSA does not distinguish observation types; a naming claim is a kind of observation in the universal stack." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs022 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:RightsStatement ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "SOSA does not distinguish observation types; a rights claim is a kind of observation in the universal stack." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs023 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:KinRelationship ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "SOSA does not distinguish observation types; a kinship claim is a kind of observation in the universal stack." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs024 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:facetSubject ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:hasFeatureOfInterest ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "facetSubject is the observedFeature of an identity claim; aligns to SOSA's feature of interest." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs025 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:facetVantage ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:madeBySensor ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "facetVantage is the asserting agent of an identity claim; aligns to SOSA's sensor (device-centric, broader via broadMatch on Agent)." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# Added (stream-to-trajectory design) — SOSA streaming alignments

gmeow:eqObs026 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Stream ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:ObservationCollection ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "SOSA has no first-class Stream; ObservationCollection is the closest grouping construct." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs027 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:streamSample ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:hasMember ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "Stream sample is a member of the observation collection." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .


gmeow:eqObs029 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:streamSensor ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:madeBySensor ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Per-stream vs per-observation sensor attribution." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs030 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Observation ;
    gmeow:alignPredicate skos:broadMatch ;
    gmeow:alignObject sosa:Sampling ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "A sampling act is a kind of observation; GMEOW models it through observationTypeSampling." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs031 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Agent ;
    gmeow:alignPredicate skos:relatedMatch ;
    gmeow:alignObject sosa:Platform ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "An agent hosting sensors can act as a platform (broader than the sosa:Sensor alignment in eqObs018)." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs032 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:streamInterval ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:phenomenonTime ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.7 ;
    gmeow:comment "Stream interval vs per-observation phenomenon time." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# --------------------------------------------------------------------------- #
# PROV-O
# --------------------------------------------------------------------------- #

gmeow:eqObs009 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Observation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:Entity ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "An Observation is a relator (gufo), but as a named individual it is also a prov:Entity that can be attributed, derived, and versioned." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs010 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:vantage ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:wasAttributedTo ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "prov:wasAttributedTo is a property, gmeow:vantage is a property; the alignment is on the semantic axis (who is responsible), not structural identity." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs011 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:observationResult ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject prov:generated ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "Inverse direction: prov:wasGeneratedBy links Entity to Activity; gmeow:observationResult links Observation to its result Entity. Semantic alignment, not structural identity." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# --------------------------------------------------------------------------- #
# CIDOC-CRM E13 Attribute Assignment
# --------------------------------------------------------------------------- #

gmeow:eqObs012 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Observation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject crm:E13_Attribute_Assignment ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "CIDOC-CRM E13 Attribute Assignment is the closest CRM class for an observation: it is both the activity of assigning an attribute and, in GMEOW terms, the observation that results from such an activity. The event perspective is aligned to gmeow:ObservationalActivity in the events mapping set." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs013 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:observedFeature ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject crm:P140_assigned_attribute_to ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs014 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:observationResult ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject crm:P141_assigned ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs015 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:vantage ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject crm:P14_carried_out_by ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.8 ;
    gmeow:comment "crm:P14 is event-centric; gmeow:vantage is relator-centric. Semantic alignment on 'who performed it'." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs016 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:observationMethod ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject crm:P33_used_specific_technique ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# --------------------------------------------------------------------------- #
# spatial-measurement design — SpatialMeasurement / CoordinateObservation alignments
# --------------------------------------------------------------------------- #

# SOSA

gmeow:eqObs033 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SpatialMeasurement ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "SOSA does not distinguish spatial measurement types; SpatialMeasurement is a kind of Observation." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs034 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:CoordinateObservation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "SOSA does not distinguish coordinate observation types; CoordinateObservation is a kind of Observation." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs035 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:coordinateResult ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:hasResult ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "coordinateResult is the GeoCoordinates-specific subproperty of observationResult; aligns to SOSA's generic hasResult." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs036 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:geometryResult ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:hasResult ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "geometryResult is the Geometry-specific subproperty of observationResult; aligns to SOSA's generic hasResult." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# O&M (ISO 19156)

gmeow:eqObs037 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SpatialMeasurement ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject iso19156:OM_Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "ISO 19156 O&M is the conceptual geographic standard that inspired SOSA/SSN. SpatialMeasurement aligns to the generic OM_Observation." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs038 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:CoordinateObservation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject iso19156:OM_GeometryObservation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "ISO 19156 O&M GeometryObservation is the closest O&M class for coordinate/geometry assignment." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# CRMarchaeo

gmeow:eqObs039 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:CoordinateObservation ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject crmarc:S4_Observation ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "CRMarchaeo S4 Observation covers stratigraphic and spatial observations in archaeological context." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# StandpointTenure observation design — StandpointClaim as Observation: claimModality maps to SOSA result.

gmeow:eqObs041 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:claimModality ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:hasResult ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.75 ;
    gmeow:comment "the modality result of a standpoint claim is the SOSA result of the observation (StandpointTenure observation design)";
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

# --------------------------------------------------------------------------- #
# sensory slice — Sensory module alignments (SOSA/SSN, OBOE, PATO, OBI, OM, QB)
# --------------------------------------------------------------------------- #

# SOSA/SSN — precise sensor / platform / observable property / result alignments

gmeow:eqObs042 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:Sensor ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Sensor ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "Precise alignment: a GMEOW Sensor is a more specific kind of Agent that acts as vantage in a SensoryObservation. Supersedes the broader Agent → sosa:Sensor broadMatch (eqObs018)." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs043 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SensorPlatform ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Platform ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "Precise alignment: a GMEOW SensorPlatform hosts sensors and is situated at a place. Supersedes the broader Agent → sosa:Platform relatedMatch (eqObs031)." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs044 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:ObservableProperty ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:ObservableProperty ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "A property that can be observed or measured by a sensor. GMEOW models it as a gufo:QualityValue vocabulary (individuals); SOSA as a class." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs045 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:SensoryQuantity ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:Result ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "sosa:Result is broader (any result); gmeow:SensoryQuantity is specifically a sensory-produced scalar numeric and specializes the sole math:Quantity authority.";
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs046 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:sensoryProperty ;
    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject sosa:observedProperty ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.9 ;
    gmeow:comment "The observable property that a sensory observation measures." ;
    gmeow:sssomFile "gmeow-observations.sssom.tsv" .

gmeow:eqObs047 a gmeow:TermEquivalence ;
    gmeow:alignSubject gmeow:platformLocation ;
