# Projection: GMEOW → pure bot. GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT.
# Lossy and directional by design; drops: the GMEOW containedInPlace subproperty and any standpoint/contestation on the containment are collapsed to a flat bot:hasStorey edge; the GMEOW containedInPlace subproperty and any standpoint/contestation on the containment are collapsed to a flat bot:hasSpace edge; direct building→room containment, skipping the intermediate storey; the flat edge loses the intermediate floor information.
PREFIX gmeow: <https://blackcatinformatics.ca/gmeow/>
PREFIX bot: <https://w3id.org/bot#>

CONSTRUCT {
    ?place a ?ptClass .
    ?building bot:hasStorey ?storey .
    ?storey bot:hasSpace ?space .
    ?building bot:hasSpace ?space .
}
WHERE {
    {
        ?place gmeow:placeType ?pt .
        VALUES ( ?pt ?ptClass ) {
            ( gmeow:placeTypeBuilding bot:Building )
            ( gmeow:placeTypeFloor bot:Storey )
            ( gmeow:placeTypeRoom bot:Space )
        }
    }
    UNION {
        ?storey a gmeow:Place .
        ?storey gmeow:placeType gmeow:placeTypeFloor .
        ?storey gmeow:containedInPlace ?building .
        ?building a gmeow:Place .
        ?building gmeow:placeType gmeow:placeTypeBuilding .
    }
    UNION {
        ?space a gmeow:Place .
        ?space gmeow:placeType gmeow:placeTypeRoom .
        ?space gmeow:containedInPlace ?storey .
        ?storey a gmeow:Place .
        ?storey gmeow:placeType gmeow:placeTypeFloor .
    }
    UNION {
        ?space a gmeow:Place .
        ?space gmeow:placeType gmeow:placeTypeRoom .
        ?space gmeow:containedInPlace ?building .
        ?building a gmeow:Place .
        ?building gmeow:placeType gmeow:placeTypeBuilding .
    }
}
