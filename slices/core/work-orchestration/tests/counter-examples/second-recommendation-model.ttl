#
# Fail-witness for ex:saNoSecondRecommendationModel: a local ranking class,
# which reintroduces the privileged winner the preference apparatus forbids.
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

gmeow:ActionRanking a owl:Class ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/work-orchestration> .
