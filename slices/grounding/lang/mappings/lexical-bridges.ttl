gmeow:eqLangAnchorSourceNif a gmeow:TermEquivalence, logic:GroundingCorrespondence ;
    gmeow:alignSubject lang:anchorSource ; gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject nif:referenceContext ;
    logic:sourceEndpoint lang:anchorSource ; logic:targetEndpoint nif:referenceContext ;
    gmeow:justification semapv:ManualMappingCuration ; gmeow:confidence 0.85 ;
    gmeow:sssomFile "gmeow-lang-nif.sssom.tsv" ;
    logic:morphismClass logic:AffineCorrespondence ; logic:morphismKind logic:InstitutionMorphism ;
