@prefix align: <http://knowledgeweb.semanticweb.org/heterogeneity/alignment#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix edoal: <http://ns.inria.org/edoal/1.0/#> .
@prefix gmeow: <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://blackcatinformatics.ca/gmeow/projections/intoto> a align:Alignment ;
    rdfs:label "GMEOW → intoto (EDOAL)"@x-gmeow-english ;
    align:level "2EDOAL" ;
    align:map [ a align:Cell ;
            rdfs:label "CryptographicSignature → intoto:signature"@x-gmeow-english ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:CryptographicSignature ] ;
            align:entity2 [ a edoal:Property ;
                    edoal:uri <https://in-toto.io/Statement/v1#signature> ] ;
            align:relation "<=" ;
            edoal:measure 6e-01 ],
        [ a align:Cell ;
            rdfs:label "Attestation → intoto:Statement"@x-gmeow-english ;
            align:entity1 [ a edoal:Class ;
                    edoal:uri gmeow:Attestation ] ;
            align:entity2 [ a edoal:Class ;
                    edoal:uri <https://in-toto.io/Statement/v1#Statement> ] ;
            align:relation "<=" ] ;
    align:onto1 [ a align:Ontology ;
            align:formalism [ align:name "GMEOW" ] ] ;
    align:onto2 [ a align:Ontology ;
            align:formalism [ align:name "intoto" ] ] ;
    dcterms:isPartOf <https://blackcatinformatics.ca/gmeow> ;
    rdfs:comment "GENERATED by `gmeow compile-mappings` from mapping-dsl/ — DO NOT EDIT."@x-gmeow-english .
