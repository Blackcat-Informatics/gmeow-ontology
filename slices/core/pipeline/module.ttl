# =========================================================================== #
# Fanout extraction rows (gmeow:fanoutExtracts) — the generated-path ↔          #
# carrier-representative map the superset gate reads as DATA (promoted from     #
# the former hard-coded superset.rs branches). The gate HARD-fails unless the  #
# rows are a bijection over the bundle's fanout / EDOAL reconstruction graphs. #
# =========================================================================== #

gmeow:pipeline-build gmeow:fanoutExtracts
    gmeow:fanout-briefs-authoring-packets ,
    gmeow:fanout-catalog-constraint-catalog ,
    gmeow:fanout-catalog-term-content-manifest ,
    gmeow:fanout-diagnostics-logic-compile ,
    gmeow:fanout-diagnostics-shacl ,
    gmeow:fanout-evals-scores ,
    gmeow:fanout-foundation-gufo ,
    gmeow:fanout-logic-correspondence-laws ,
    gmeow:fanout-logic-correspondence ,
    gmeow:fanout-logic-relational-core ,
    gmeow:fanout-logic-projection-report ,
    gmeow:fanout-logic-shape-grounding-ledger ,
    gmeow:fanout-projections-core-prefixes ,
    gmeow:fanout-projections-functions-fno ,
    gmeow:fanout-projections-glossary-vartrans ,
    gmeow:fanout-projections-list-functions-fno ,
    gmeow:fanout-quality-assessment ,
    gmeow:fanout-skos-surface ,
    gmeow:fanout-profiles ,
    gmeow:fanout-research-objects ,
    gmeow:fanout-edoal-projections ,
    gmeow:fanout-medium-dictionary-effect ,
    gmeow:fanout-medium-gmeow-core-v1 ,
    gmeow:fanout-medium-gmeow-lang-ast-v1 ,
    gmeow:fanout-medium-gmeow-logic-v1 ,
    gmeow:fanout-medium-gmeow-memory-compact-v1 ,
    gmeow:fanout-medium-gmeow-memory-hot-v1 ,
    gmeow:fanout-medium-gmeow-prooftrace-v1 .

gmeow:fanout-briefs-authoring-packets a gmeow:FanoutExtraction ;
    rdfs:label "fanout briefs authoring packets"@x-gmeow-english ;
    skos:definition "Fanout reconstruction row: the committed path generated/briefs/authoring-packets.nt is rebuilt from the shipped gmeow.gts as a RDF-fanout named-graph fold serialized as N-Triples. One row of the gmeow:fanoutExtracts path-to-representative bijection the superset gate enforces."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/pipeline> ;
    gmeow:graphBoxRole gmeow:boxABox ;
    gmeow:extractsPath "generated/briefs/authoring-packets.nt" ; gmeow:extractsMatch "exact" ;
    gmeow:extractsGraphFamily "rdf-fanout" ; gmeow:extractsForm "ntriples" .

