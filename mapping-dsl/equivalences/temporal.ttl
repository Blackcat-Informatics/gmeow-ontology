    gmeow:alignPredicate skos:closeMatch ;
    gmeow:alignObject time:TRS ;
    gmeow:justification semapv:ManualMappingCuration ;
    gmeow:confidence 0.85 ;
    gmeow:comment "OWL-Time Temporal Reference System when scale-only" ;
    gmeow:sssomFile "gmeow-temporal.sssom.tsv" .

gmeow:eqTemporal005 a gmeow:TermEquivalence ;
