@prefix gmeow:   <https://blackcatinformatics.ca/gmeow/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://blackcatinformatics.ca/gmeow/slices/lexicon>
    a gmeow:Slice ;
    rdfs:label "lexicon"@x-gmeow-english ;
    skos:definition "The lexicon slice of the GMEOW ontology (extension tier): GMEOW Lexicon Module. Anatomy, dependencies, and consumer are declared in this manifest; the manifest is the sole source of slice identity and tier."@x-gmeow-english ;
    rdfs:isDefinedBy <https://blackcatinformatics.ca/gmeow/slices/lexicon> ;
    dcterms:title "GMEOW Lexicon Module"@x-gmeow-english ;
    dcterms:creator "Blackcat Informatics® Inc." ;
    gmeow:sliceTier gmeow:tierExtension ;
    gmeow:sliceDependsOn
        <https://blackcatinformatics.ca/gmeow/slices/logic> ,
        <https://blackcatinformatics.ca/gmeow/slices/kernel> ,
        <https://blackcatinformatics.ca/gmeow/slices/documents> ,
        <https://blackcatinformatics.ca/gmeow/slices/language> ,
        <https://blackcatinformatics.ca/gmeow/slices/observations> ,
        <https://blackcatinformatics.ca/gmeow/slices/temporal> ;
    gmeow:sliceConsumer "Lexical items and attestations for the language family; archaeological readings."@x-gmeow-english .
