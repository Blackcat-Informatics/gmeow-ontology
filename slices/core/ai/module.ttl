    logic:quantifiedVariable [ logic:termIndex 0 ; logic:termVariable "this" ] , [ logic:termIndex 1 ; logic:termVariable "span" ] , [ logic:termIndex 2 ; logic:termVariable "assertedAt" ] , [ logic:termIndex 3 ; logic:termVariable "chunk" ] , [ logic:termIndex 4 ; logic:termVariable "source" ] , [ logic:termIndex 5 ; logic:termVariable "srcMod" ] ;
    logic:forall logic:stsImpl .
